// SPDX-License-Identifier: Apache-2.0
; specs/lab/lab_t27b_run.t27 -- the decisions of one t27b lab run and of its loop that are not about a spec: whether a
; run settles its commit, which lane requests run, what the loop asks the judge, how the ratchet process is read, and
; what the index of runs says after a publish (issue #11042, epic #11040).
; --
; The oracle is contrib/railway/t27b-lab/lab.py, imported unedited: run_done, admitted (run with master's real judge,
; `t27c corpus-receipt admit`, and with git's answers replaced by the text in the case), the two statements of main()
; that ask the judge for the next step and read its answer (taken out of lab.py's own source and run), ratchet (with the
; checker's process replaced by the case's exit code, stderr and stdout) and publish (its files in a scratch directory,
; a series of runs for two commits). The tables at the end hold every case and its answer; 0 differences.
; --
; PORTED, lab.py name -> here:
;   run_done                       lt_run_done
;   admitted                       lt_admit (the judge is verified/corpus_receipt.t27's request_verdict and request_exit,
;                                  called here instead of as a process), lt_facts, lt_has_word, lt_age_u32
;   main(), the judge's schedule   lt_schedule_facts, lt_schedule_next
;   ratchet(doc, log), the process lt_step_kind, lt_step_ok, lt_step_error (the checker's verdict is read in
;                                  lab_t27b_ratchet.t27)
;   publish                        lt_index_publish, lt_run_path
; LEFT OUT, and why: the HTTP server, the clone and the checkout, the build and run steps, the receipt and ddc steps and
; every `run()` (they start processes or serve files: the runtime, #11040 L3). Nothing here names a host: a lab that is a
; job run by any node (#11043) asks the same questions.
; --
; admitted() asks each request in the order they were written. A request the judge drops (exit 1) is deleted and does
; not count among the waiting; every other one does, so the ninth request not dropped is refused as the queue is full.
; An age below zero (a clock that stepped back) reads as expired, as the judge does.
; WHERE THE SPEC DIFFERS FROM THE PYTHON: the output of the checker is taken to be json.dumps(indent=1)'s layout, which
; is what t27b.py writes; compact JSON is not read (lt_step_kind then says it is unparsable). The index is rewritten from
; the layout json.dumps(indent=1) wrote, and the sha is the hex text git gives, which needs no escape.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module LabT27bRun;

use lab::text::{LAB_NO, lab_line_end, lab_line_next, lab_strip_from, lab_strip_to, lab_has_lit, lab_same_span, lab_cut_chars, lab_space_len, lab_put_span, lab_put_lit, lab_put_count};
use lab::lab_t27b_text::{lx_put_idec, lx_out_is};
use tri::lab::receipt::{span_is, line_is, key_at, value_from, value_to, results_at};
use verified::corpus_receipt::request_verdict;
use verified::corpus_receipt::request_exit;

// ---- run_done: does a published run settle its commit ----

/// Where the closing line of the object that opens at v (a `{` that ends its line) in indent `ind` starts; t.len when none does.
pub fn lt_close_at(t : string, v : usize, ind : usize) -> usize {
    var k : usize = lab_line_end(t, v) + 1;
    while (k < t.len) {
        const e : usize = lab_line_end(t, k);
        if (line_is(t, k, e, ind, "}")) { return k; }
        k = lab_line_next(t, e);
    }
    return t.len;
}

/// run_done(doc): a run whose checkout failed measured nothing, and the next poll tries its commit again. True
/// unless the run document says `"ok": false` for steps.checkout. A document with no steps, no checkout or no
/// text at all settles its commit (it is read as `{}`).
pub fn lt_run_done(doc : string) -> bool {
    const sv : usize = key_at(doc, 0, results_at(doc), 1, "steps");
    if (sv >= doc.len) { return true; }
    if (doc[sv] != 123) { return true; }
    if (sv + 1 < doc.len and doc[sv + 1] == 125) { return true; }
    const from : usize = lab_line_end(doc, sv) + 1;
    const cv : usize = key_at(doc, from, lt_close_at(doc, sv, 1), 2, "checkout");
    if (cv >= doc.len) { return true; }
    if (doc[cv] != 123) { return true; }
    if (cv + 1 < doc.len and doc[cv + 1] == 125) { return true; }
    const ov : usize = key_at(doc, lab_line_end(doc, cv) + 1, lt_close_at(doc, cv, 2), 3, "ok");
    if (ov >= doc.len or doc[ov] == 34) { return true; }
    return span_is(doc, value_from(doc, ov), value_to(doc, ov), "false") == false;
}

// ---- admitted: which lane requests the lab runs ----
; A request is a file in the lab's requests directory, named by a commit's sha. admitted() takes them oldest
; first, asks the judge (master's t27c, specs/verified/corpus_receipt.t27 request_verdict) about each with the
; facts `age,waiting,known` and keeps the answer: exit 1 drops the request (it is deleted), exit 0 admits it, any
; other exit leaves it waiting; every request not dropped counts in `waiting` for the ones after it. `known` is
; whether the name is one of the words of what git said (the heads of origin, the fetch, master's first-parent
; line). The judge is asked here as a function (request_verdict and request_exit), not as a process.

/// `name in text.split()`: is name one of the words of text.
pub fn lt_has_word(text : string, name : string) -> bool {
    var i : usize = 0;
    while (i < text.len) {
        const n : usize = lab_space_len(text, i, text.len);
        if (n > 0) {
            i = i + n;
        } else {
            var e : usize = i;
            while (e < text.len and lab_space_len(text, e, text.len) == 0) {
                e = e + 1;
            }
            if (lab_same_span(text, i, e, name, 0, name.len)) { return true; }
            i = e;
        }
    }
    return false;
}

/// An age as the judge reads it: a request from the future (a clock that stepped back) or older than u32 is expired.
pub fn lt_age_u32(age : i64) -> u32 {
    if (age < 0 or age > 4294967295) { return 4294967295; }
    return age as u32;
}

/// The facts line the judge is given: `age,waiting,known` with known as 0 or 1.
pub fn lt_facts(age : i64, waiting : usize, known : bool, out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = lx_put_idec(out, cap, w, age);
    x = lab_put_lit(out, cap, x, ",");
    x = lab_put_count(out, cap, x, waiting as u64);
    if (known) { return lab_put_lit(out, cap, x, ",1"); }
    return lab_put_lit(out, cap, x, ",0");
}

/// The start of line k of text (lines as splitlines gives them); t.len when there is no such line.
pub fn lt_line_start(t : string, k : usize) -> usize {
    var at : usize = 0;
    var n : usize = 0;
    while (at < t.len) {
        if (n == k) { return at; }
        at = lab_line_next(t, lab_line_end(t, at));
        n = n + 1;
    }
    return t.len;
}

/// What admitted() does with n requests whose names are the lines of names (in the order the directory lists
/// them): keys[i] is when request i was written (its order), ages[i] how many seconds ago it was, known the text
/// git printed. act[i] gets 0 for a request that runs, 1 for one that is dropped, 2 for one that waits;
/// adm gets the indexes of the requests that run, oldest first; ord is room for n words. The judge's facts
/// lines are written at facts[cur[0]..] (cur[0] moves on), one per request asked about, oldest first. Returns
/// how many requests run.
pub fn lt_admit(names : string, keys : []const u64, ages : []const i64, n : usize, known : string, ord : []u32, act : []u8, adm : []u32, facts : []u8, fcap : usize, cur : []usize) -> usize {
    var m : usize = 0;
    var i : usize = 0;
    while (i < n) {
        var j : usize = m;
        while (j > 0 and keys[ord[j - 1] as usize] > keys[i]) {
            ord[j] = ord[j - 1];
            j = j - 1;
        }
        ord[j] = i as u32;
        m = m + 1;
        i = i + 1;
    }
    var waiting : usize = 0;
    var run : usize = 0;
    var k : usize = 0;
    while (k < n) {
        const q : usize = ord[k] as usize;
        const s : usize = lt_line_start(names, q);
        const e : usize = lab_line_end(names, s);
        const on_origin : bool = lt_has_word(known, names[s..e]);
        cur[0] = lt_facts(ages[q], waiting, on_origin, facts, fcap, cur[0]);
        cur[0] = lab_put_lit(facts, fcap, cur[0], "\n");
        const code : u8 = request_exit(request_verdict(names[s..e], lt_age_u32(ages[q]), waiting as u32, on_origin));
        if (code == 1) {
            act[q] = 1;
        } else {
            waiting = waiting + 1;
            if (code == 0) {
                act[q] = 0;
                adm[run] = q as u32;
                run = run + 1;
            } else {
                act[q] = 2;
            }
        }
        k = k + 1;
    }
    return run;
}

// ---- the loop's two lines about the judge ----

/// The facts the lab hands the judge's `schedule`: `moved,ready,count` with moved as 0 or 1 and count the word the judge gave last time.
pub fn lt_schedule_facts(moved : bool, ready : u64, count : string, out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = w;
    if (moved) {
        x = lab_put_lit(out, cap, x, "1,");
    } else {
        x = lab_put_lit(out, cap, x, "0,");
    }
    x = lab_put_count(out, cap, x, ready);
    x = lab_put_lit(out, cap, x, ",");
    return lab_put_lit(out, cap, x, count);
}

pub const LT_NEXT_MASTER : u8 = 0;
pub const LT_NEXT_REQUEST : u8 = 1;
pub const LT_NEXT_IDLE : u8 = 2;
pub const LT_NEXT_OTHER : u8 = 3;
pub const LT_NEXT_ERROR : u8 = 4;

/// `nxt, count = (judge's words if there is a judge else []) or ("MASTER", "0")`: the step the judge names, and
/// in sp[0], sp[1] where its count word is in stdout (LAB_NO for the default "0"). LT_NEXT_ERROR when the judge
/// printed one word or more than two (the unpacking raises and the loop reports an error); LT_NEXT_OTHER for a
/// first word that is none of MASTER, REQUEST and IDLE (the loop then runs nothing and does not sleep).
pub fn lt_schedule_next(stdout : string, judge_exists : bool, sp : []usize) -> u8 {
    sp[0] = LAB_NO;
    sp[1] = LAB_NO;
    if (judge_exists == false) { return LT_NEXT_MASTER; }
    var words : usize = 0;
    var wf : [2]usize = [0, 0];
    var we : [2]usize = [0, 0];
    var i : usize = 0;
    while (i < stdout.len) {
        const n : usize = lab_space_len(stdout, i, stdout.len);
        if (n > 0) {
            i = i + n;
        } else {
            var e : usize = i;
            while (e < stdout.len and lab_space_len(stdout, e, stdout.len) == 0) {
                e = e + 1;
            }
            if (words < 2) {
                wf[words] = i;
                we[words] = e;
            }
            words = words + 1;
            i = e;
        }
    }
    if (words == 0) { return LT_NEXT_MASTER; }
    if (words != 2) { return LT_NEXT_ERROR; }
    sp[0] = wf[1];
    sp[1] = we[1];
    if (lab_same_span(stdout, wf[0], we[0], "MASTER", 0, 6)) { return LT_NEXT_MASTER; }
    if (lab_same_span(stdout, wf[0], we[0], "REQUEST", 0, 7)) { return LT_NEXT_REQUEST; }
    if (lab_same_span(stdout, wf[0], we[0], "IDLE", 0, 4)) { return LT_NEXT_IDLE; }
    return LT_NEXT_OTHER;
}

// ---- the ratchet step of a run ----
; lab.py's ratchet(doc, log) runs the commit's own checker (`scripts/tri_loop/t27b.py ratchet --json`) and
; records what happened. The checker's verdict is read in lab_t27b_ratchet.t27; what is decided here is how the
; lab reads the process.

pub const LT_STEP_NO_FILES : u8 = 0;
pub const LT_STEP_NOT_RUN : u8 = 1;
pub const LT_STEP_NO_RATCHET : u8 = 2;
pub const LT_STEP_UNPARSABLE : u8 = 3;
pub const LT_STEP_JUDGED : u8 = 4;

/// What `ok` is in the step's record: false, true, or null.
pub const LT_OK_FALSE : u8 = 0;
pub const LT_OK_TRUE : u8 = 1;
pub const LT_OK_NULL : u8 = 2;

/// Is stdout the checker's JSON: an object in json.dumps(indent=1)'s layout with a `verdict` at the top.
pub fn lt_checker_json(stdout : string) -> bool {
    var at : usize = 0;
    while (at < stdout.len and (stdout[at] == 32 or stdout[at] == 10 or stdout[at] == 9 or stdout[at] == 13)) {
        at = at + 1;
    }
    if (at >= stdout.len or stdout[at] != 123) { return false; }
    return key_at(stdout, 0, stdout.len, 1, "verdict") <= stdout.len;
}

/// The verdict word of the checker's JSON: where it starts and ends in sp; false when there is none that is text.
pub fn lt_checker_verdict(stdout : string, sp : []usize) -> bool {
    const v : usize = key_at(stdout, 0, stdout.len, 1, "verdict");
    if (v >= stdout.len or stdout[v] != 34) { return false; }
    sp[0] = value_from(stdout, v);
    sp[1] = value_to(stdout, v);
    return true;
}

/// How the lab reads the process: files_ok is that the commit has the checker and the ledger, ran that the process
/// started and ended, rc its exit code.
pub fn lt_step_kind(files_ok : bool, ran : bool, rc : i32, stderr : string, stdout : string) -> u8 {
    if (files_ok == false) { return LT_STEP_NO_FILES; }
    if (ran == false) { return LT_STEP_NOT_RUN; }
    if (rc == 2 and lab_has_lit(stderr, 0, stderr.len, "invalid choice")) { return LT_STEP_NO_RATCHET; }
    if (lt_checker_json(stdout) == false) { return LT_STEP_UNPARSABLE; }
    return LT_STEP_JUDGED;
}

/// The step's `ok`: null when the commit has no checker or ledger or its checker has no ratchet (never green),
/// false when the process did not run or said nothing readable, and for a judged run true only for exit 0 and the
/// verdict green.
pub fn lt_step_ok(kind : u8, rc : i32, stdout : string) -> u8 {
    if (kind == LT_STEP_NO_FILES or kind == LT_STEP_NO_RATCHET) { return LT_OK_NULL; }
    if (kind != LT_STEP_JUDGED) { return LT_OK_FALSE; }
    var sp : [2]usize = undefined;
    if (rc == 0 and lt_checker_verdict(stdout, &sp)) {
        if (span_is(stdout, sp[0], sp[1], "green")) { return LT_OK_TRUE; }
    }
    return LT_OK_FALSE;
}

/// The step's `error` for output that is not the checker's JSON: stderr stripped, or stdout stripped when stderr is
/// empty after it, cut at 300 characters.
pub fn lt_step_error(stderr : string, stdout : string, out : []u8, cap : usize, w : usize) -> usize {
    var t : string = stderr;
    if (lab_strip_from(stderr, 0, stderr.len) == stderr.len) { t = stdout; }
    const a : usize = lab_strip_from(t, 0, t.len);
    const b : usize = lab_strip_to(t, a, t.len);
    return lab_put_span(out, cap, w, t, a, lab_cut_chars(t, a, b, 300));
}

// ---- where a run is published ----

/// The path of a run's files: /runs/SHA + .json (0), .log (1) or .receipt.json (2).
pub fn lt_run_path(sha : string, kind : u8, out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = lab_put_lit(out, cap, w, "/runs/");
    x = lab_put_lit(out, cap, x, sha);
    if (kind == 1) { return lab_put_lit(out, cap, x, ".log"); }
    if (kind == 2) { return lab_put_lit(out, cap, x, ".receipt.json"); }
    return lab_put_lit(out, cap, x, ".json");
}

// ---- publish: the index of the runs ----
; publish() writes the run, then reads runs/index.json, drops the entries of the same commit, puts a new entry first
; and writes the list back with json.dumps(indent=1). The entry is the commit, the run's ref, started, finished,
; its summary and the paths of its two files. The old index is read in the layout it was written in (one object a
; line group at indent 1, its keys at indent 2); the sha is taken as the hex text git gives, which needs no escape.

/// The value of a top-level key of the run document as written, without its trailing comma: sp[0], sp[1].
pub fn lt_doc_raw(doc : string, key : string, sp : []usize) -> bool {
    const v : usize = key_at(doc, 0, results_at(doc), 1, key);
    if (v >= doc.len) { return false; }
    var e : usize = lab_line_end(doc, v);
    if (e > v and doc[e - 1] == 44) { e = e - 1; }
    sp[0] = v;
    sp[1] = e;
    return true;
}

/// publish's index after it, written at w: the new entry of run document doc for commit sha, then the entries of
/// old that are not of sha, in their order. LAB_NO when the document has no ref, started or finished.
pub fn lt_index_publish(old : string, doc : string, sha : string, out : []u8, cap : usize, w : usize) -> usize {
    var rf : [2]usize = undefined;
    var st : [2]usize = undefined;
    var fi : [2]usize = undefined;
    if (lt_doc_raw(doc, "ref", &rf) == false or lt_doc_raw(doc, "started", &st) == false or lt_doc_raw(doc, "finished", &fi) == false) { return LAB_NO; }
    var x : usize = lab_put_lit(out, cap, w, "[\n {\n  \"commit\": \"");
    x = lab_put_lit(out, cap, x, sha);
    x = lab_put_lit(out, cap, x, "\",\n  \"ref\": ");
    x = lab_put_span(out, cap, x, doc, rf[0], rf[1]);
    x = lab_put_lit(out, cap, x, ",\n  \"started\": ");
    x = lab_put_span(out, cap, x, doc, st[0], st[1]);
    x = lab_put_lit(out, cap, x, ",\n  \"finished\": ");
    x = lab_put_span(out, cap, x, doc, fi[0], fi[1]);
    x = lab_put_lit(out, cap, x, ",\n  \"summary\": ");
    const sv : usize = key_at(doc, 0, results_at(doc), 1, "summary");
    if (sv >= doc.len) {
        x = lab_put_lit(out, cap, x, "null");
    } else {
        if (doc[sv] == 123 and sv + 1 < doc.len and doc[sv + 1] != 125) {
            x = lab_put_lit(out, cap, x, "{\n");
            var k : usize = lab_line_end(doc, sv) + 1;
            const stop : usize = lt_close_at(doc, sv, 1);
            while (k < stop) {
                const e : usize = lab_line_end(doc, k);
                x = lab_put_lit(out, cap, x, " ");
                x = lab_put_span(out, cap, x, doc, k, e);
                x = lab_put_lit(out, cap, x, "\n");
                k = lab_line_next(doc, e);
            }
            x = lab_put_lit(out, cap, x, "  }");
        } else {
            var sp : [2]usize = undefined;
            lt_doc_raw(doc, "summary", &sp);
            x = lab_put_span(out, cap, x, doc, sp[0], sp[1]);
        }
    }
    x = lab_put_lit(out, cap, x, ",\n  \"json\": \"/runs/");
    x = lab_put_lit(out, cap, x, sha);
    x = lab_put_lit(out, cap, x, ".json\",\n  \"log\": \"/runs/");
    x = lab_put_lit(out, cap, x, sha);
    x = lab_put_lit(out, cap, x, ".log\"\n }");
    var at : usize = 0;
    while (at < old.len) {
        const e : usize = lab_line_end(old, at);
        if (line_is(old, at, e, 1, "{")) {
            const close : usize = lt_close_at(old, at, 1);
            const cv : usize = key_at(old, at, close, 2, "commit");
            var same : bool = false;
            if (cv < old.len and old[cv] == 34) { same = lab_same_span(old, value_from(old, cv), value_to(old, cv), sha, 0, sha.len); }
            if (same == false and close < old.len) {
                x = lab_put_lit(out, cap, x, ",\n");
                x = lab_put_span(out, cap, x, old, at, close + 2);
            }
            at = lab_line_next(old, lab_line_end(old, close));
        } else {
            at = lab_line_next(old, e);
        }
    }
    return lab_put_lit(out, cap, x, "\n]\n");
}

// ---- tests ----

pub const LT_SHA_A : string = "5f308712519557028d680357280bcc941e0ec222";
pub const LT_SHA_B : string = "6a7b774d1f5685088d70cc8f1e3ba7d902921751";

test a_failed_checkout_is_the_only_run_that_asks_for_another_try {
    assert lt_run_done("") == true;
    assert lt_run_done("{\n \"commit\": \"c\"\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {}\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {}\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"ok\": true\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"ok\": false\n  }\n }\n}\n") == false;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"error\": \"git fetch failed\",\n   \"ok\": false,\n   \"seconds\": 3.0\n  }\n }\n}\n") == false;
    assert lt_run_done("{\n \"steps\": {\n  \"build_t27c\": {\n   \"ok\": false\n  },\n  \"checkout\": {\n   \"ok\": true\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"build_t27c\": {\n   \"ok\": true\n  },\n  \"checkout\": {\n   \"ok\": false\n  }\n }\n}\n") == false;
}

test only_the_json_false_of_the_checkout_counts_not_a_word_a_null_or_another_key {
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"ok\": null\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"ok\": \"false\"\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"ok\": 0\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"okay\": false\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"ok\": false,\n \"steps\": {\n  \"checkout\": {\n   \"ok\": true\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"checkout\": {\n   \"detail\": {\n    \"ok\": false\n   },\n   \"ok\": true\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"steps\": {\n  \"x\": {\n   \"checkout\": {\n    \"ok\": false\n   }\n  }\n }\n}\n") == true;
    assert lt_run_done("{\n \"image\": {\n  \"steps\": {\n   \"checkout\": {\n    \"ok\": false\n   }\n  }\n },\n \"steps\": {}\n}\n") == true;
}

test the_words_of_what_git_said_are_the_words_split_on_any_space {
    assert lt_has_word("a b c", "b") == true;
    assert lt_has_word("a b c", "d") == false;
    assert lt_has_word("a\tb\nc", "c") == true;
    assert lt_has_word("sha\trefs/heads/x\n", "sha") == true;
    assert lt_has_word("sha\trefs/heads/x\n", "refs/heads/x") == true;
    assert lt_has_word("abc", "ab") == false;
    assert lt_has_word("ab", "abc") == false;
    assert lt_has_word("", "a") == false;
    assert lt_has_word("a", "") == false;
    assert lt_has_word("a\xc2\xa0b", "b") == true;
    assert lt_has_word("a\xc2\xa0b", "a\xc2\xa0b") == false;
    assert lt_has_word("a\x0bb", "b") == true;
}

test an_age_from_the_future_or_beyond_u32_is_expired {
    assert lt_age_u32(0) == 0;
    assert lt_age_u32(7200) == 7200;
    assert lt_age_u32(4294967295) == 4294967295;
    assert lt_age_u32(4294967296) == 4294967295;
    assert lt_age_u32(-1) == 4294967295;
    assert lt_age_u32(-100000) == 4294967295;
    var out : [64]u8 = undefined;
    assert lx_out_is(&out, lt_facts(5, 0, true, &out, 64, 0), "5,0,1") == true;
    assert lx_out_is(&out, lt_facts(-5, 3, false, &out, 64, 0), "-5,3,0") == true;
    assert lx_out_is(&out, lt_facts(0, 12, true, &out, 64, 0), "0,12,1") == true;
}

test requests_run_oldest_first_and_a_dropped_one_does_not_count_as_waiting {
    var keys : [3]u64 = [30, 10, 20];
    var ages : [3]i64 = [100, 300, 200];
    var ord : [3]u32 = undefined;
    var act : [3]u8 = undefined;
    var adm : [3]u32 = undefined;
    var facts : [256]u8 = undefined;
    var cur : [1]usize = [0];
    const names : string = "5f308712519557028d680357280bcc941e0ec222\nHEAD\n6a7b774d1f5685088d70cc8f1e3ba7d902921751";
    const known : string = "5f308712519557028d680357280bcc941e0ec222\n6a7b774d1f5685088d70cc8f1e3ba7d902921751\n";
    const n : usize = lt_admit(names, &keys, &ages, 3, known, &ord, &act, &adm, &facts, 256, &cur);
    assert n == 2;
    assert act[0] == 0;
    assert act[1] == 1;
    assert act[2] == 0;
    assert adm[0] == 2;
    assert adm[1] == 0;
    assert lx_out_is(&facts, cur[0], "300,0,0\n200,0,1\n100,1,1\n") == true;
}

test a_request_not_yet_on_origin_waits_and_one_in_the_future_is_dropped {
    var keys : [3]u64 = [3, 2, 1];
    var ages : [3]i64 = [10, 20, -5];
    var ord : [3]u32 = undefined;
    var act : [3]u8 = undefined;
    var adm : [3]u32 = undefined;
    var facts : [256]u8 = undefined;
    var cur : [1]usize = [0];
    const names : string = "5f308712519557028d680357280bcc941e0ec222\n6a7b774d1f5685088d70cc8f1e3ba7d902921751\n0123456789012345678901234567890123456789";
    const n : usize = lt_admit(names, &keys, &ages, 3, "", &ord, &act, &adm, &facts, 256, &cur);
    assert n == 0;
    assert act[0] == 2;
    assert act[1] == 2;
    assert act[2] == 1;
    assert lx_out_is(&facts, cur[0], "-5,0,0\n20,0,0\n10,1,0\n") == true;
}

test the_ninth_waiting_request_is_refused_as_the_queue_is_full {
    var keys : [10]u64 = undefined;
    var ages : [10]i64 = undefined;
    var ord : [10]u32 = undefined;
    var act : [10]u8 = undefined;
    var adm : [10]u32 = undefined;
    var facts : [1024]u8 = undefined;
    var cur : [1]usize = [0];
    var names : [410]u8 = undefined;
    var w : usize = 0;
    var k : usize = 0;
    while (k < 10) {
        keys[k] = (100 - k) as u64;
        ages[k] = k as i64;
        w = lab_put_lit(&names, 410, w, "000000000000000000000000000000000000000");
        w = lab_put_count(&names, 410, w, k as u64);
        if (k < 9) { w = lab_put_lit(&names, 410, w, "\n"); }
        k = k + 1;
    }
    assert w == 409;
    const n : usize = lt_admit(names[0..w], &keys, &ages, 10, names[0..w], &ord, &act, &adm, &facts, 1024, &cur);
    assert n == 8;
    assert act[0] == 1;
    assert act[1] == 1;
    k = 2;
    while (k < 10) {
        assert act[k] == 0;
        k = k + 1;
    }
    assert adm[0] == 9;
    assert adm[7] == 2;
}

test requests_written_at_the_same_moment_are_asked_in_the_order_they_are_listed {
    var keys : [2]u64 = [7, 7];
    var ages : [2]i64 = [50, 50];
    var ord : [2]u32 = undefined;
    var act : [2]u8 = undefined;
    var adm : [2]u32 = undefined;
    var facts : [128]u8 = undefined;
    var cur : [1]usize = [0];
    const names : string = "5f308712519557028d680357280bcc941e0ec222\n6a7b774d1f5685088d70cc8f1e3ba7d902921751";
    const known : string = "6a7b774d1f5685088d70cc8f1e3ba7d902921751";
    assert lt_admit(names, &keys, &ages, 2, known, &ord, &act, &adm, &facts, 128, &cur) == 1;
    assert ord[0] == 0;
    assert ord[1] == 1;
    assert act[0] == 2;
    assert act[1] == 0;
    assert adm[0] == 1;
    assert lx_out_is(&facts, cur[0], "50,0,0\n50,1,1\n") == true;
}

test the_schedule_texts_are_the_loops {
    var out : [64]u8 = undefined;
    var sp : [2]usize = undefined;
    assert lx_out_is(&out, lt_schedule_facts(true, 2, "-", &out, 64, 0), "1,2,-") == true;
    assert lx_out_is(&out, lt_schedule_facts(false, 0, "COUNT", &out, 64, 0), "0,0,COUNT") == true;
    assert lt_schedule_next("MASTER 0\n", true, &sp) == LT_NEXT_MASTER;
    assert lt_schedule_next("REQUEST 3\n", true, &sp) == LT_NEXT_REQUEST;
    assert sp[1] - sp[0] == 1;
    assert lt_schedule_next("IDLE 0", true, &sp) == LT_NEXT_IDLE;
    assert lt_schedule_next("OTHER 0", true, &sp) == LT_NEXT_OTHER;
    assert lt_schedule_next("", true, &sp) == LT_NEXT_MASTER;
    assert sp[0] == LAB_NO;
    assert lt_schedule_next("REQUEST 3", false, &sp) == LT_NEXT_MASTER;
    assert sp[0] == LAB_NO;
    assert lt_schedule_next("ONE", true, &sp) == LT_NEXT_ERROR;
    assert lt_schedule_next("A B C", true, &sp) == LT_NEXT_ERROR;
    assert lt_schedule_next("master 1", true, &sp) == LT_NEXT_OTHER;
}

test the_ratchet_step_is_skipped_when_the_commit_has_no_ratchet_and_never_green_then {
    const green : string = "{\n \"verdict\": \"green\",\n \"counts\": {}\n}";
    const red : string = "{\n \"verdict\": \"red\"\n}";
    assert lt_step_kind(false, true, 0, "", green) == LT_STEP_NO_FILES;
    assert lt_step_kind(true, false, 0, "", green) == LT_STEP_NOT_RUN;
    assert lt_step_kind(true, true, 2, "error: invalid choice: 'ratchet'", "") == LT_STEP_NO_RATCHET;
    assert lt_step_kind(true, true, 1, "error: invalid choice: 'ratchet'", "") == LT_STEP_UNPARSABLE;
    assert lt_step_kind(true, true, 2, "something else", "") == LT_STEP_UNPARSABLE;
    assert lt_step_kind(true, true, 0, "", green) == LT_STEP_JUDGED;
    assert lt_step_kind(true, true, 1, "", red) == LT_STEP_JUDGED;
    assert lt_step_kind(true, true, 0, "", "{broken") == LT_STEP_UNPARSABLE;
    assert lt_step_ok(LT_STEP_NO_FILES, 0, green) == LT_OK_NULL;
    assert lt_step_ok(LT_STEP_NO_RATCHET, 2, "") == LT_OK_NULL;
    assert lt_step_ok(LT_STEP_NOT_RUN, 0, "") == LT_OK_FALSE;
    assert lt_step_ok(LT_STEP_UNPARSABLE, 0, "") == LT_OK_FALSE;
    assert lt_step_ok(LT_STEP_JUDGED, 0, green) == LT_OK_TRUE;
    assert lt_step_ok(LT_STEP_JUDGED, 1, green) == LT_OK_FALSE;
    assert lt_step_ok(LT_STEP_JUDGED, 0, red) == LT_OK_FALSE;
    assert lt_step_ok(LT_STEP_JUDGED, 1, red) == LT_OK_FALSE;
}

test the_step_error_is_stderr_or_else_stdout_stripped_and_cut_at_300 {
    var out : [2048]u8 = undefined;
    var b : [1024]u8 = undefined;
    assert lx_out_is(&out, lt_step_error("  boom \n", "ignored", &out, 2048, 0), "boom") == true;
    assert lx_out_is(&out, lt_step_error("  \n", "  from stdout \n", &out, 2048, 0), "from stdout") == true;
    assert lx_out_is(&out, lt_step_error("", "", &out, 2048, 0), "") == true;
    var n : usize = 0;
    var k : usize = 0;
    while (k < 400) {
        n = lab_put_lit(&b, 1024, n, "\xc3\xa9");
        k = k + 1;
    }
    assert lt_step_error(b[0..n], "", &out, 2048, 0) == 600;
    assert out[599] == 169;
}

test a_run_is_published_under_its_sha_and_the_index_keeps_one_entry_per_commit {
    var out : [2048]u8 = undefined;
    var p : [64]u8 = undefined;
    assert lx_out_is(&p, lt_run_path("abc", 0, &p, 64, 0), "/runs/abc.json") == true;
    assert lx_out_is(&p, lt_run_path("abc", 1, &p, 64, 0), "/runs/abc.log") == true;
    assert lx_out_is(&p, lt_run_path("abc", 2, &p, 64, 0), "/runs/abc.receipt.json") == true;
    const doc : string = "{\n \"ref\": \"master\",\n \"started\": \"t1\",\n \"finished\": \"t2\",\n \"summary\": null,\n \"results\": []\n}\n";
    const first : string = "[\n {\n  \"commit\": \"a1\",\n  \"ref\": \"master\",\n  \"started\": \"t1\",\n  \"finished\": \"t2\",\n  \"summary\": null,\n  \"json\": \"/runs/a1.json\",\n  \"log\": \"/runs/a1.log\"\n }\n]\n";
    var w : usize = lt_index_publish("", doc, "a1", &out, 2048, 0);
    assert lx_out_is(&out, w, first) == true;
    const doc2 : string = "{\n \"ref\": \"request\",\n \"started\": \"t3\",\n \"finished\": \"t4\",\n \"summary\": {\n  \"files\": 3\n },\n \"results\": []\n}\n";
    const second : string = "[\n {\n  \"commit\": \"b2\",\n  \"ref\": \"request\",\n  \"started\": \"t3\",\n  \"finished\": \"t4\",\n  \"summary\": {\n   \"files\": 3\n  },\n  \"json\": \"/runs/b2.json\",\n  \"log\": \"/runs/b2.log\"\n },\n {\n  \"commit\": \"a1\",\n  \"ref\": \"master\",\n  \"started\": \"t1\",\n  \"finished\": \"t2\",\n  \"summary\": null,\n  \"json\": \"/runs/a1.json\",\n  \"log\": \"/runs/a1.log\"\n }\n]\n";
    w = lt_index_publish(first, doc2, "b2", &out, 2048, 0);
    assert lx_out_is(&out, w, second) == true;
    const third : string = "[\n {\n  \"commit\": \"a1\",\n  \"ref\": \"master\",\n  \"started\": \"t1\",\n  \"finished\": \"t2\",\n  \"summary\": null,\n  \"json\": \"/runs/a1.json\",\n  \"log\": \"/runs/a1.log\"\n },\n {\n  \"commit\": \"b2\",\n  \"ref\": \"request\",\n  \"started\": \"t3\",\n  \"finished\": \"t4\",\n  \"summary\": {\n   \"files\": 3\n  },\n  \"json\": \"/runs/b2.json\",\n  \"log\": \"/runs/b2.log\"\n }\n]\n";
    w = lt_index_publish(second, doc, "a1", &out, 2048, 0);
    assert lx_out_is(&out, w, third) == true;
    assert lt_index_publish(second, "{\n \"ref\": \"x\"\n}\n", "c", &out, 2048, 0) == LAB_NO;
    assert lt_index_publish("", "", "c", &out, 2048, 0) == LAB_NO;
}

