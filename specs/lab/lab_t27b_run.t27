test run_done_equals_the_pythons_on_every_document {
    var i : usize = 0;
    while (i < RD_N) {
        assert lt_run_done(RD_DOC[i]) == (RD_DONE[i] == 1);
        i = i + 1;
    }
}

test the_admitted_requests_equal_the_pythons_on_every_directory {
    var keys : [16]u64 = undefined;
    var ages : [16]i64 = undefined;
    var ord : [16]u32 = undefined;
    var act : [16]u8 = undefined;
    var adm : [16]u32 = undefined;
    var facts : [2048]u8 = undefined;
    var cur : [1]usize = [0];
    var i : usize = 0;
    while (i < AD_N) {
        const n : usize = AD_OFF[i + 1] - AD_OFF[i];
        var j : usize = 0;
        while (j < n) {
            ages[j] = AD_AGES[AD_OFF[i] + j];
            keys[j] = (AD_NOW - (ages[j] as u64)) * 1000000000;
            j = j + 1;
        }
        cur[0] = 0;
        const r : usize = lt_admit(AD_NAMES[i], &keys, &ages, n, AD_KNOWN[i], &ord, &act, &adm, &facts, 2048, &cur);
        assert r == AD_NADM[i];
        j = 0;
        while (j < n) {
            assert act[j] == AD_ACT[AD_OFF[i] + j];
            j = j + 1;
        }
        var k : usize = 0;
        while (k < r) {
            assert adm[k] == AD_ADM[AD_AOFF[i] + k];
            k = k + 1;
        }
        assert lx_out_is(&facts, cur[0], AD_FACTS[i]) == true;
        i = i + 1;
    }
}

test the_schedule_facts_and_the_judges_answer_equal_the_pythons {
    var out : [256]u8 = undefined;
    var sp : [2]usize = undefined;
    var i : usize = 0;
    while (i < SF_N) {
        const w : usize = lt_schedule_facts(SF_MOVED[i] == 1, SF_READY[i], SF_COUNT[i], &out, 256, 0);
        assert lx_out_is(&out, w, SF_TEXT[i]) == true;
        i = i + 1;
    }
    var j : usize = 0;
    while (j < SN_N) {
        const nx : u8 = lt_schedule_next(SN_OUT[j], SN_JUDGE[j] == 1, &sp);
        assert nx == SN_NEXT[j];
        if (nx != LT_NEXT_ERROR) {
            if (sp[0] == LAB_NO) {
                assert lx_out_is("0", 1, SN_COUNT[j]) == true;
            } else {
                assert lab_same_span(SN_OUT[j], sp[0], sp[1], SN_COUNT[j], 0, SN_COUNT[j].len) == true;
            }
        }
        j = j + 1;
    }
}

test the_ratchet_step_is_read_as_the_pythons_ratchet_reads_it {
    var out : [1024]u8 = undefined;
    var i : usize = 0;
    while (i < RT_N) {
        const kind : u8 = lt_step_kind(RT_FILES[i] == 1, RT_RAN[i] == 1, RT_RC[i], RT_ERR[i], RT_OUT[i]);
        assert kind == RT_KIND[i];
        assert lt_step_ok(kind, RT_RC[i], RT_OUT[i]) == RT_OK[i];
        if (kind == LT_STEP_UNPARSABLE) {
            const w : usize = lt_step_error(RT_ERR[i], RT_OUT[i], &out, 1024, 0);
            assert lx_out_is(&out, w, RT_TEXT[i]) == true;
        }
        i = i + 1;
    }
}

test the_index_after_a_publish_equals_the_pythons_on_every_run {
    var out : [8192]u8 = undefined;
    var i : usize = 0;
    while (i < PB_N) {
        var old : string = "";
        if (PB_FIRST[i] == 0) { old = PB_NEW[i - 1]; }
        const w : usize = lt_index_publish(old, PB_DOC[i], PB_SHA[i], &out, 8192, 0);
        assert lx_out_is(&out, w, PB_NEW[i]) == true;
        i = i + 1;
    }
}
