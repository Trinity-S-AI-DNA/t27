// SPDX-License-Identifier: Apache-2.0
; specs/lab/paths.t27 -- which names and which GET paths the t27c lab accepts (gHashTag/t27#11041, epic #11040)
; The t27c lab (infra/t27c-lab/lab.py) serves its runs over plain HTTP GET and takes work from two kinds of name: a
; 40-hex commit sha and a branch name. Every decision about what may be read, fetched or queued is one of five
; patterns, and each is ported here exactly, the Python function is the oracle:
;   SHA_RE        ^[0-9a-f]{40}$                              lab_is_sha
;   BRANCH_RE     ^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$         lab_is_branch
;   checkout()    BRANCH_RE and ".." not in b                 lab_branch_fetchable  (the refspec guard)
;   enqueue()     SHA_RE or (BRANCH_RE and ".." not in ref)   lab_ref_enqueueable
;   take_requests SHA_RE, else BRANCH_RE and the ref is a head  lab_request_kind
;   safe_path()   the four routes a GET may read              lab_path_parts, lab_path_write
;   do_GET        /health, /, a file, or 404                  lab_route, lab_path_is_json
; THE `$` OF PYTHON. In `re` a `$` without MULTILINE matches at the end of the text AND just before a newline that ends
; it. So `SHA_RE.match(sha + "\n")` and `BRANCH_RE.match("main\n")` are matches, and so is every route below with one
; LF after its last byte; the path a route returns carries no LF (it is built from the captured groups). This file does
; the same, and tests it (the oracle is the specification here): the one extra LF is accepted and a second is not. In
; the lab no such text reaches these functions today (a git ref has no control byte, an HTTP request line ends at its
; LF), so it is a property of the port, not a hole.
; The routes (path with its query, from the first `?`, cut off):
;   /latest.json                                   -> latest.json                (exact; no LF accepted)
;   /runs/<sha>.json                               -> runs/<sha>.json
;   /runs/<sha>/<gate>.<log|json>   gate [a-z-]{1,40}  -> runs/<sha>/<gate>.<ext>
;   /seals/<sha>.<json|patch>                      -> runs/<sha>/seals.<ext>    (#9080)
; Anything else, any upper-case sha or gate, any `..`, any other extension, is no route. do_GET answers /health and
; /health/ (the whole path, a query makes it a 404), / (the banner), a route whose file exists, and 404 otherwise.
; The glue that serves the files and queues a request is thin; this file holds the decisions, and names no host: whatever runs
; the lab (one machine, or any node that takes a lab job, #11043) asks these functions what a name or a path is.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module LabPaths;

use tri::lab::receipt::span_is;
use lab::text::LAB_NO;
use lab::text::lab_has_lit;
use lab::text::lab_lit_at;
use lab::text::lab_find_byte;
use lab::text::lab_put_lit;
use lab::text::lab_put_span;

pub const LAB_SHA_LEN : usize = 40;
/// BRANCH_RE: one leading letter or digit and at most 199 more of [A-Za-z0-9._/-].
pub const LAB_BRANCH_MAX : usize = 200;
/// A gate's file name in a route: [a-z-]{1,40}.
pub const LAB_GATE_MAX : usize = 40;

/// What a request name is (take_requests).
pub const LAB_REQ_NONE : u8 = 0;
pub const LAB_REQ_SHA : u8 = 1;
pub const LAB_REQ_BRANCH : u8 = 2;

/// What a GET path is (safe_path).
pub const LAB_P_NONE : u8 = 0;
pub const LAB_P_LATEST : u8 = 1;
pub const LAB_P_RUN : u8 = 2;
pub const LAB_P_GATE : u8 = 3;
pub const LAB_P_SEAL : u8 = 4;

/// What do_GET does with a path.
pub const LAB_R_NOT_FOUND : u8 = 0;
pub const LAB_R_HEALTH : u8 = 1;
pub const LAB_R_ROOT : u8 = 2;
pub const LAB_R_FILE : u8 = 3;

/// Is the byte a lower-case hex digit?
pub fn lab_is_hex(c: u8) -> bool {
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102);
}

/// The end of text[from..to] without the one LF that Python's `$` lets a match leave behind it.
pub fn lab_dollar_end(t: string, from: usize, to: usize) -> usize {
    if (to > from and t[to - 1] == 10) { return to - 1; }
    return to;
}

/// SHA_RE.match on text[from..to]: exactly 40 lower-case hex digits, then the end or one LF.
pub fn lab_is_sha(t: string, from: usize, to: usize) -> bool {
    const e : usize = lab_dollar_end(t, from, to);
    if (e - from != LAB_SHA_LEN) { return false; }
    var k : usize = from;
    while (k < e) {
        if (lab_is_hex(t[k]) == false) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is the byte one of [A-Za-z0-9]?
pub fn lab_is_alnum(c: u8) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122);
}

/// BRANCH_RE.match on text[from..to]: a letter or digit, then up to 199 of [A-Za-z0-9._/-], then the end or one LF.
pub fn lab_is_branch(t: string, from: usize, to: usize) -> bool {
    const e : usize = lab_dollar_end(t, from, to);
    if (e <= from or e - from > LAB_BRANCH_MAX) { return false; }
    if (lab_is_alnum(t[from]) == false) { return false; }
    var k : usize = from + 1;
    while (k < e) {
        const c : u8 = t[k];
        if (lab_is_alnum(c) == false and c != 46 and c != 95 and c != 47 and c != 45) { return false; }
        k = k + 1;
    }
    return true;
}

/// checkout(): a branch the lab puts into a refspec: BRANCH_RE and no `..` anywhere in it.
pub fn lab_branch_fetchable(t: string, from: usize, to: usize) -> bool {
    return lab_is_branch(t, from, to) and lab_has_lit(t, from, to, "..") == false;
}

/// enqueue(): a request the lab drops into its queue: a sha, or a branch with no `..` in it.
pub fn lab_ref_enqueueable(t: string, from: usize, to: usize) -> bool {
    return lab_is_sha(t, from, to) or lab_branch_fetchable(t, from, to);
}

/// take_requests(): a sha is a request for that commit; a branch is one only when it is a head of the repository
/// (in_heads), and then without the `..` rule; everything else is dropped.
pub fn lab_request_kind(t: string, from: usize, to: usize, in_heads: bool) -> u8 {
    if (lab_is_sha(t, from, to)) { return LAB_REQ_SHA; }
    if (lab_is_branch(t, from, to) and in_heads) { return LAB_REQ_BRANCH; }
    return LAB_REQ_NONE;
}

/// Where a route's last byte may be followed by nothing or by the one LF.
pub fn lab_route_end_ok(t: string, q: usize, n: usize) -> bool {
    return q == n or (q + 1 == n and t[q] == 10);
}

/// The parts of a route: its kind, the sha, the gate name or the file word, and the extension. Offsets into the path.
pub struct LabPathParts { kind: u8, sha_from: usize, name_from: usize, name_to: usize, ext_from: usize, ext_to: usize }

fn lab_no_parts() -> LabPathParts {
    return LabPathParts { kind: LAB_P_NONE, sha_from: 0, name_from: 0, name_to: 0, ext_from: 0, ext_to: 0 };
}

/// Is text[from..from + 40] 40 lower-case hex digits?
pub fn lab_hex40_at(t: string, from: usize, n: usize) -> bool {
    if (from + LAB_SHA_LEN > n) { return false; }
    var k : usize = 0;
    while (k < LAB_SHA_LEN) {
        if (lab_is_hex(t[from + k]) == false) { return false; }
        k = k + 1;
    }
    return true;
}

/// safe_path(): which route the path is and where its parts are. The query (from the first `?`) is cut off first.
pub fn lab_path_parts(path: string) -> LabPathParts {
    var n : usize = path.len;
    const qm : usize = lab_find_byte(path, 0, n, 63);
    if (qm != LAB_NO) { n = qm; }
    if (span_is(path, 0, n, "/latest.json")) {
        return LabPathParts { kind: LAB_P_LATEST, sha_from: 0, name_from: 1, name_to: 7, ext_from: 8, ext_to: 12 };
    }
    if (lab_lit_at(path, 0, n, "/runs/") and lab_hex40_at(path, 6, n)) {
        const a : usize = 6 + LAB_SHA_LEN;
        if (lab_lit_at(path, a, n, ".json") and lab_route_end_ok(path, a + 5, n)) {
            return LabPathParts { kind: LAB_P_RUN, sha_from: 6, name_from: 0, name_to: 0, ext_from: a + 1, ext_to: a + 5 };
        }
        if (lab_lit_at(path, a, n, "/")) {
            var q : usize = a + 1;
            while (q < n and ((path[q] >= 97 and path[q] <= 122) or path[q] == 45)) {
                q = q + 1;
            }
            if (q > a + 1 and q - (a + 1) <= LAB_GATE_MAX and lab_lit_at(path, q, n, ".")) {
                if (lab_lit_at(path, q + 1, n, "log") and lab_route_end_ok(path, q + 4, n)) {
                    return LabPathParts { kind: LAB_P_GATE, sha_from: 6, name_from: a + 1, name_to: q, ext_from: q + 1, ext_to: q + 4 };
                }
                if (lab_lit_at(path, q + 1, n, "json") and lab_route_end_ok(path, q + 5, n)) {
                    return LabPathParts { kind: LAB_P_GATE, sha_from: 6, name_from: a + 1, name_to: q, ext_from: q + 1, ext_to: q + 5 };
                }
            }
        }
    }
    if (lab_lit_at(path, 0, n, "/seals/") and lab_hex40_at(path, 7, n)) {
        const b : usize = 7 + LAB_SHA_LEN;
        if (lab_lit_at(path, b, n, ".json") and lab_route_end_ok(path, b + 5, n)) {
            return LabPathParts { kind: LAB_P_SEAL, sha_from: 7, name_from: 0, name_to: 0, ext_from: b + 1, ext_to: b + 5 };
        }
        if (lab_lit_at(path, b, n, ".patch") and lab_route_end_ok(path, b + 6, n)) {
            return LabPathParts { kind: LAB_P_SEAL, sha_from: 7, name_from: 0, name_to: 0, ext_from: b + 1, ext_to: b + 6 };
        }
    }
    return lab_no_parts();
}

/// safe_path(): the kind of route; LAB_P_NONE for a path nothing may read.
pub fn lab_path_kind(path: string) -> u8 {
    return lab_path_parts(path).kind;
}

/// safe_path(): write the file under www a route reads (runs/<sha>.json, ...) into dst at w, clipped at cap; the new
/// cursor. A path that is no route writes nothing.
pub fn lab_path_write(path: string, dst: []u8, cap: usize, w: usize) -> usize {
    const p : LabPathParts = lab_path_parts(path);
    if (p.kind == LAB_P_NONE) { return w; }
    if (p.kind == LAB_P_LATEST) { return lab_put_lit(dst, cap, w, "latest.json"); }
    var x : usize = lab_put_lit(dst, cap, w, "runs/");
    x = lab_put_span(dst, cap, x, path, p.sha_from, p.sha_from + LAB_SHA_LEN);
    if (p.kind == LAB_P_RUN) { return lab_put_span(dst, cap, lab_put_lit(dst, cap, x, "."), path, p.ext_from, p.ext_to); }
    if (p.kind == LAB_P_GATE) {
        x = lab_put_span(dst, cap, lab_put_lit(dst, cap, x, "/"), path, p.name_from, p.name_to);
    } else {
        x = lab_put_lit(dst, cap, x, "/seals");
    }
    return lab_put_span(dst, cap, lab_put_lit(dst, cap, x, "."), path, p.ext_from, p.ext_to);
}

/// do_GET: the content type is application/json when the file the route reads ends in .json, else text/plain.
pub fn lab_path_is_json(path: string) -> bool {
    const p : LabPathParts = lab_path_parts(path);
    if (p.kind == LAB_P_NONE) { return false; }
    return span_is(path, p.ext_from, p.ext_to, "json");
}

/// do_GET: what the request line asks for. /health and /health/ are the whole path, a query makes it no health check.
pub fn lab_route(path: string) -> u8 {
    if (span_is(path, 0, path.len, "/health") or span_is(path, 0, path.len, "/health/")) { return LAB_R_HEALTH; }
    if (span_is(path, 0, path.len, "/")) { return LAB_R_ROOT; }
    if (lab_path_kind(path) != LAB_P_NONE) { return LAB_R_FILE; }
    return LAB_R_NOT_FOUND;
}

// ---- tests ----
// The oracle is infra/t27c-lab/lab.py. Every case below is its answer (Python 3.14.6), pinned: first the asserts of its
// self_check(), one to one, then tables of inputs run through its own functions (SHA_RE, BRANCH_RE, safe_path, do_GET's
// routing, enqueue's and take_requests' guards).

fn lab_test_sha(s: string) -> bool {
    return lab_is_sha(s, 0, s.len);
}

fn lab_test_branch(s: string) -> bool {
    return lab_is_branch(s, 0, s.len);
}

fn lab_test_fetchable(s: string) -> bool {
    return lab_branch_fetchable(s, 0, s.len);
}

fn lab_test_enqueueable(s: string) -> bool {
    return lab_ref_enqueueable(s, 0, s.len);
}

fn lab_test_request(s: string, in_heads: bool) -> u8 {
    return lab_request_kind(s, 0, s.len, in_heads);
}

/// The kind, the file the route reads and its content type, all three, for one path.
fn lab_test_path(path: string, kind: u8, rel: string, json: bool) -> bool {
    var out : [128]u8 = undefined;
    const w : usize = lab_path_write(path, &out, 128, 0);
    if (w != rel.len or span_is(&out, 0, w, rel) == false) { return false; }
    return lab_path_kind(path) == kind and lab_path_is_json(path) == json;
}

// <<< pinned table: paths_self_check
test lab_py_self_check_safe_path_reads_the_four_routes {
    assert lab_test_path("/latest.json", LAB_P_LATEST, "latest.json", true);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json", LAB_P_RUN, "runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json", true);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/suite.log", LAB_P_GATE, "runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/suite.log", false);
    assert lab_test_path("/seals/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.patch", LAB_P_SEAL, "runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/seals.patch", false);
}

test lab_py_self_check_safe_path_refuses_the_wrong_extension_and_every_traversal {
    assert lab_test_path("/seals/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.log", LAB_P_NONE, "", false);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.patch", LAB_P_NONE, "", false);
    assert lab_test_path("/../etc/passwd", LAB_P_NONE, "", false);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/../../x.log", LAB_P_NONE, "", false);
    assert lab_test_path("/runs/abc.json", LAB_P_NONE, "", false);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/Suite.log", LAB_P_NONE, "", false);
    assert lab_test_path("/data/src/.git/config", LAB_P_NONE, "", false);
}

test lab_py_self_check_branch_re {
    assert lab_test_branch("claude/t27c-match-tail-expr") == true;
    assert lab_test_branch("-x") == false;
    assert lab_test_branch("a b") == false;
}

// >>> pinned table: paths_self_check
// <<< pinned table: paths_sha
// SHA_RE.match(s): 40 lower-case hex digits; Python's $ also lets one LF follow.
test lab_py_table_sha_re {
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_sha("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb") == true;
    assert lab_test_sha("0123456789abcdef0123456789abcdef01234567") == true;
    assert lab_test_sha("ffffffffffffffffffffffffffffffffffffffff") == true;
    assert lab_test_sha("0000000000000000000000000000000000000000") == true;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("") == false;
    assert lab_test_sha("a") == false;
    assert lab_test_sha("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaag") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaG") == false;
    assert lab_test_sha("gggggggggggggggggggggggggggggggggggggggg") == false;
    assert lab_test_sha(" aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaa aaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == false;
    assert lab_test_sha("\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("\n") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax") == false;
    assert lab_test_sha("xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-") == false;
    assert lab_test_sha("master") == false;
    assert lab_test_sha("HEAD") == false;
    assert lab_test_sha("9999999999999999999999999999999999999999") == true;
    assert lab_test_sha("abcdefabcdefabcdefabcdefabcdefabcdefabcd") == true;
    assert lab_test_sha("abcdefabcdefabcdefabcdefabcdefabcdefabc") == false;
    assert lab_test_sha("abcdefgabcdefgabcdefgabcdefgabcdefgabcde") == false;
}

// >>> pinned table: paths_sha
// <<< pinned table: paths_branch
// BRANCH_RE.match(b); checkout()'s guard (BRANCH_RE and no ..); enqueue()'s rule (a sha, or that guard).
test lab_py_table_branch_re {
    assert lab_test_branch("master") == true;
    assert lab_test_branch("main") == true;
    assert lab_test_branch("claude/t27c-x") == true;
    assert lab_test_branch("claude/lab-l1-t27c-11041") == true;
    assert lab_test_branch("a") == true;
    assert lab_test_branch("A") == true;
    assert lab_test_branch("0") == true;
    assert lab_test_branch("9z") == true;
    assert lab_test_branch("a.b") == true;
    assert lab_test_branch("a_b") == true;
    assert lab_test_branch("a-b") == true;
    assert lab_test_branch("a/b") == true;
    assert lab_test_branch("-x") == false;
    assert lab_test_branch(".x") == false;
    assert lab_test_branch("_x") == false;
    assert lab_test_branch("/x") == false;
    assert lab_test_branch("x/") == true;
    assert lab_test_branch("x.") == true;
    assert lab_test_branch("x..y") == true;
    assert lab_test_branch("x/../y") == true;
    assert lab_test_branch("..") == false;
    assert lab_test_branch("a..") == true;
    assert lab_test_branch("..a") == false;
    assert lab_test_branch("a/..") == true;
    assert lab_test_branch("a b") == false;
    assert lab_test_branch(" a") == false;
    assert lab_test_branch("a ") == false;
    assert lab_test_branch("a\tb") == false;
    assert lab_test_branch("a\n") == true;
    assert lab_test_branch("a\n\n") == false;
    assert lab_test_branch("\na") == false;
    assert lab_test_branch("a\nb") == false;
    assert lab_test_branch("") == false;
    assert lab_test_branch("\n") == false;
    assert lab_test_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == false;
    assert lab_test_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_branch("a-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------") == true;
    assert lab_test_branch("a--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------") == false;
    assert lab_test_branch("refs/heads/master") == true;
    assert lab_test_branch("refs/pull/1/head") == true;
    assert lab_test_branch("feature#1") == false;
    assert lab_test_branch("a+b") == false;
    assert lab_test_branch("a:b") == false;
    assert lab_test_branch("a~1") == false;
    assert lab_test_branch("a^") == false;
    assert lab_test_branch("a?") == false;
    assert lab_test_branch("a*") == false;
    assert lab_test_branch("a[0]") == false;
    assert lab_test_branch("a@b") == false;
    assert lab_test_branch("a,b") == false;
    assert lab_test_branch("a;b") == false;
    assert lab_test_branch("a$b") == false;
    assert lab_test_branch("a%b") == false;
    assert lab_test_branch("a\\b") == false;
    assert lab_test_branch("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") == true;
    assert lab_test_branch("ab12cd") == true;
    assert lab_test_branch("Release/1.2.3") == true;
    assert lab_test_branch("v1.0-rc.1") == true;
    assert lab_test_branch("t27c") == true;
    assert lab_test_branch("t27c-lab") == true;
    assert lab_test_branch("claude/t27c-*") == false;
}

test lab_py_table_checkout_guard {
    assert lab_test_fetchable("master") == true;
    assert lab_test_fetchable("main") == true;
    assert lab_test_fetchable("claude/t27c-x") == true;
    assert lab_test_fetchable("claude/lab-l1-t27c-11041") == true;
    assert lab_test_fetchable("a") == true;
    assert lab_test_fetchable("A") == true;
    assert lab_test_fetchable("0") == true;
    assert lab_test_fetchable("9z") == true;
    assert lab_test_fetchable("a.b") == true;
    assert lab_test_fetchable("a_b") == true;
    assert lab_test_fetchable("a-b") == true;
    assert lab_test_fetchable("a/b") == true;
    assert lab_test_fetchable("-x") == false;
    assert lab_test_fetchable(".x") == false;
    assert lab_test_fetchable("_x") == false;
    assert lab_test_fetchable("/x") == false;
    assert lab_test_fetchable("x/") == true;
    assert lab_test_fetchable("x.") == true;
    assert lab_test_fetchable("x..y") == false;
    assert lab_test_fetchable("x/../y") == false;
    assert lab_test_fetchable("..") == false;
    assert lab_test_fetchable("a..") == false;
    assert lab_test_fetchable("..a") == false;
    assert lab_test_fetchable("a/..") == false;
    assert lab_test_fetchable("a b") == false;
    assert lab_test_fetchable(" a") == false;
    assert lab_test_fetchable("a ") == false;
    assert lab_test_fetchable("a\tb") == false;
    assert lab_test_fetchable("a\n") == true;
    assert lab_test_fetchable("a\n\n") == false;
    assert lab_test_fetchable("\na") == false;
    assert lab_test_fetchable("a\nb") == false;
    assert lab_test_fetchable("") == false;
    assert lab_test_fetchable("\n") == false;
    assert lab_test_fetchable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_fetchable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_fetchable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_fetchable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
