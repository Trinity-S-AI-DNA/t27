    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/build.txt", LAB_P_NONE, "", false);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/misread.log", LAB_P_GATE, "runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/misread.log", false);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/misread.json", LAB_P_GATE, "runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/misread.json", true);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/misread.txt", LAB_P_NONE, "", false);
}

// >>> pinned table: paths_routes
// <<< pinned table: paths_http
// do_GET: /health and /health/ whole, / the banner, a route (its file may still be missing: 404), else 404.
test lab_py_table_routing {
    assert lab_route("/health") == LAB_R_HEALTH;
    assert lab_route("/health/") == LAB_R_HEALTH;
    assert lab_route("/health//") == LAB_R_NOT_FOUND;
    assert lab_route("/health?x") == LAB_R_NOT_FOUND;
    assert lab_route("/health/?x") == LAB_R_NOT_FOUND;
    assert lab_route("/Health") == LAB_R_NOT_FOUND;
    assert lab_route("/healthz") == LAB_R_NOT_FOUND;
    assert lab_route("/heal") == LAB_R_NOT_FOUND;
    assert lab_route("health") == LAB_R_NOT_FOUND;
    assert lab_route("/") == LAB_R_ROOT;
    assert lab_route("//") == LAB_R_NOT_FOUND;
    assert lab_route("/?") == LAB_R_NOT_FOUND;
    assert lab_route("/?x=1") == LAB_R_NOT_FOUND;
    assert lab_route("/ ") == LAB_R_NOT_FOUND;
    assert lab_route("/index.html") == LAB_R_NOT_FOUND;
    assert lab_route("/latest.json") == LAB_R_FILE;
    assert lab_route("/latest.json?x") == LAB_R_FILE;
    assert lab_route("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json") == LAB_R_FILE;
    assert lab_route("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/suite.log") == LAB_R_FILE;
    assert lab_route("/seals/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.patch") == LAB_R_FILE;
    assert lab_route("/seals/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.log") == LAB_R_NOT_FOUND;
    assert lab_route("/runs/") == LAB_R_NOT_FOUND;
    assert lab_route("") == LAB_R_NOT_FOUND;
    assert lab_route("/a") == LAB_R_NOT_FOUND;
    assert lab_route("/runs/x.json") == LAB_R_NOT_FOUND;
    assert lab_route("/health\n") == LAB_R_NOT_FOUND;
    assert lab_route("/\n") == LAB_R_NOT_FOUND;
    assert lab_route("/health/\n") == LAB_R_NOT_FOUND;
}

// >>> pinned table: paths_http

// Scenario (the oracle is the specification): Python's `$` lets ONE newline follow a match. A sha, a branch and a route all
// accept it and a second one is no match; /latest.json is compared whole, so it takes none; the route written carries no newline.
test the_one_newline_a_dollar_lets_through {
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_sha("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n") == false;
    assert lab_test_branch("master\n") == true;
    assert lab_test_branch("master\n\n") == false;
    assert lab_test_branch("\n") == false;
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json\n", LAB_P_RUN, "runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json", true);
    assert lab_test_path("/runs/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json\n\n", LAB_P_NONE, "", false);
    assert lab_test_path("/latest.json\n", LAB_P_NONE, "", false);
    assert lab_dollar_end("ab\n", 0, 3) == 2;
    assert lab_dollar_end("ab\n\n", 0, 4) == 3;
    assert lab_dollar_end("ab", 0, 2) == 2;
    assert lab_dollar_end("", 0, 0) == 0;
}

// Scenario: the parts of a route are offsets into the path, and the query is cut off before anything is read.
test the_parts_of_a_route_are_offsets_into_the_path {
    const g : string = "/runs/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/suite.log?x=1";
    const p : LabPathParts = lab_path_parts(g);
    assert p.kind == LAB_P_GATE and p.sha_from == 6 and p.name_from == 47 and p.name_to == 52 and p.ext_from == 53 and p.ext_to == 56;
    const s : LabPathParts = lab_path_parts("/seals/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.patch");
    assert s.kind == LAB_P_SEAL and s.sha_from == 7 and s.ext_from == 48 and s.ext_to == 53;
    const l : LabPathParts = lab_path_parts("/latest.json?x");
    assert l.kind == LAB_P_LATEST and l.ext_from == 8 and l.ext_to == 12;
    assert lab_path_parts("/latest.json?x").kind == lab_path_parts("/latest.json").kind;
    assert lab_path_parts("/runs/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.json?/../x").kind == LAB_P_RUN;
    assert lab_path_parts("/runs/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/../x.log").kind == LAB_P_NONE;
    assert LAB_SHA_LEN == 40 and LAB_BRANCH_MAX == 200 and LAB_GATE_MAX == 40;
}
