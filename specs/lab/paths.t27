    assert lab_test_fetchable("a-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------") == true;
    assert lab_test_fetchable("a--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------") == false;
    assert lab_test_fetchable("refs/heads/master") == true;
    assert lab_test_fetchable("refs/pull/1/head") == true;
    assert lab_test_fetchable("feature#1") == false;
    assert lab_test_fetchable("a+b") == false;
    assert lab_test_fetchable("a:b") == false;
    assert lab_test_fetchable("a~1") == false;
    assert lab_test_fetchable("a^") == false;
    assert lab_test_fetchable("a?") == false;
    assert lab_test_fetchable("a*") == false;
    assert lab_test_fetchable("a[0]") == false;
    assert lab_test_fetchable("a@b") == false;
    assert lab_test_fetchable("a,b") == false;
    assert lab_test_fetchable("a;b") == false;
    assert lab_test_fetchable("a$b") == false;
    assert lab_test_fetchable("a%b") == false;
    assert lab_test_fetchable("a\\b") == false;
    assert lab_test_fetchable("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") == true;
    assert lab_test_fetchable("ab12cd") == true;
    assert lab_test_fetchable("Release/1.2.3") == true;
    assert lab_test_fetchable("v1.0-rc.1") == true;
    assert lab_test_fetchable("t27c") == true;
    assert lab_test_fetchable("t27c-lab") == true;
    assert lab_test_fetchable("claude/t27c-*") == false;
}

test lab_py_table_enqueue_rule {
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_enqueueable("0123456789abcdef0123456789abcdef01234567") == true;
    assert lab_test_enqueueable("0000000000000000000000000000000000000000") == true;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_enqueueable("") == false;
    assert lab_test_enqueueable("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") == true;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaag") == true;
    assert lab_test_enqueueable("gggggggggggggggggggggggggggggggggggggggg") == true;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ") == false;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t") == false;
    assert lab_test_enqueueable("xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-") == true;
    assert lab_test_enqueueable("HEAD") == true;
    assert lab_test_enqueueable("abcdefabcdefabcdefabcdefabcdefabcdefabcd") == true;
    assert lab_test_enqueueable("abcdefgabcdefgabcdefgabcdefgabcdefgabcde") == true;
    assert lab_test_enqueueable("main") == true;
    assert lab_test_enqueueable("claude/lab-l1-t27c-11041") == true;
    assert lab_test_enqueueable("A") == true;
    assert lab_test_enqueueable("9z") == true;
    assert lab_test_enqueueable("a_b") == true;
    assert lab_test_enqueueable("a/b") == true;
    assert lab_test_enqueueable(".x") == false;
    assert lab_test_enqueueable("/x") == false;
    assert lab_test_enqueueable("x.") == true;
    assert lab_test_enqueueable("x/../y") == false;
    assert lab_test_enqueueable("a..") == false;
    assert lab_test_enqueueable("a/..") == false;
    assert lab_test_enqueueable(" a") == false;
    assert lab_test_enqueueable("a\tb") == false;
    assert lab_test_enqueueable("a\n\n") == false;
    assert lab_test_enqueueable("a\nb") == false;
    assert lab_test_enqueueable("\n") == false;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == false;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n") == true;
    assert lab_test_enqueueable("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") == true;
    assert lab_test_enqueueable("a--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------") == false;
    assert lab_test_enqueueable("refs/pull/1/head") == true;
    assert lab_test_enqueueable("a+b") == false;
    assert lab_test_enqueueable("a~1") == false;
    assert lab_test_enqueueable("a?") == false;
    assert lab_test_enqueueable("a[0]") == false;
    assert lab_test_enqueueable("a,b") == false;
    assert lab_test_enqueueable("a$b") == false;
    assert lab_test_enqueueable("a\\b") == false;
    assert lab_test_enqueueable("ab12cd") == true;
    assert lab_test_enqueueable("v1.0-rc.1") == true;
    assert lab_test_enqueueable("t27c-lab") == true;
}

test lab_py_table_take_requests_kind {
    assert lab_test_request("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", true) == LAB_REQ_SHA;
    assert lab_test_request("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", false) == LAB_REQ_SHA;
    assert lab_test_request("0000000000000000000000000000000000000000", true) == LAB_REQ_SHA;
    assert lab_test_request("0000000000000000000000000000000000000000", false) == LAB_REQ_SHA;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", true) == LAB_REQ_BRANCH;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", false) == LAB_REQ_NONE;
    assert lab_test_request("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", true) == LAB_REQ_BRANCH;
    assert lab_test_request("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaG", true) == LAB_REQ_BRANCH;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaG", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ", true) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n", true) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaa", true) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaa", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax", true) == LAB_REQ_BRANCH;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-", true) == LAB_REQ_BRANCH;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-", false) == LAB_REQ_NONE;
    assert lab_test_request("9999999999999999999999999999999999999999", true) == LAB_REQ_SHA;
    assert lab_test_request("9999999999999999999999999999999999999999", false) == LAB_REQ_SHA;
    assert lab_test_request("abcdefgabcdefgabcdefgabcdefgabcdefgabcde", true) == LAB_REQ_BRANCH;
    assert lab_test_request("abcdefgabcdefgabcdefgabcdefgabcdefgabcde", false) == LAB_REQ_NONE;
    assert lab_test_request("claude/t27c-x", true) == LAB_REQ_BRANCH;
    assert lab_test_request("claude/t27c-x", false) == LAB_REQ_NONE;
    assert lab_test_request("A", true) == LAB_REQ_BRANCH;
    assert lab_test_request("A", false) == LAB_REQ_NONE;
    assert lab_test_request("a.b", true) == LAB_REQ_BRANCH;
    assert lab_test_request("a.b", false) == LAB_REQ_NONE;
    assert lab_test_request("a/b", true) == LAB_REQ_BRANCH;
    assert lab_test_request("a/b", false) == LAB_REQ_NONE;
    assert lab_test_request("_x", true) == LAB_REQ_NONE;
    assert lab_test_request("_x", false) == LAB_REQ_NONE;
    assert lab_test_request("x.", true) == LAB_REQ_BRANCH;
    assert lab_test_request("x.", false) == LAB_REQ_NONE;
    assert lab_test_request("..", true) == LAB_REQ_NONE;
    assert lab_test_request("..", false) == LAB_REQ_NONE;
    assert lab_test_request("a/..", true) == LAB_REQ_BRANCH;
    assert lab_test_request("a/..", false) == LAB_REQ_NONE;
    assert lab_test_request("a ", true) == LAB_REQ_NONE;
    assert lab_test_request("a ", false) == LAB_REQ_NONE;
    assert lab_test_request("a\n\n", true) == LAB_REQ_NONE;
    assert lab_test_request("a\n\n", false) == LAB_REQ_NONE;
    assert lab_test_request("", true) == LAB_REQ_NONE;
    assert lab_test_request("", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", true) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", false) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", true) == LAB_REQ_NONE;
    assert lab_test_request("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", false) == LAB_REQ_NONE;
    assert lab_test_request("a--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------", true) == LAB_REQ_NONE;
    assert lab_test_request("a--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------", false) == LAB_REQ_NONE;
    assert lab_test_request("feature#1", true) == LAB_REQ_NONE;
    assert lab_test_request("feature#1", false) == LAB_REQ_NONE;
    assert lab_test_request("a~1", true) == LAB_REQ_NONE;
    assert lab_test_request("a~1", false) == LAB_REQ_NONE;
    assert lab_test_request("a*", true) == LAB_REQ_NONE;
    assert lab_test_request("a*", false) == LAB_REQ_NONE;
    assert lab_test_request("a,b", true) == LAB_REQ_NONE;
    assert lab_test_request("a,b", false) == LAB_REQ_NONE;
    assert lab_test_request("a%b", true) == LAB_REQ_NONE;
    assert lab_test_request("a%b", false) == LAB_REQ_NONE;
    assert lab_test_request("ab12cd", true) == LAB_REQ_BRANCH;
    assert lab_test_request("ab12cd", false) == LAB_REQ_NONE;
    assert lab_test_request("t27c", true) == LAB_REQ_BRANCH;
    assert lab_test_request("t27c", false) == LAB_REQ_NONE;
}

