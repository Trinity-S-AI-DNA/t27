    "{\n \"commit\": \"891a9087afcbc45ca68c87c07a2e4ff0ae5db00c\",\n \"results\": [\n  {\n   \"file\": \"specs/a/one.t27\",\n   \"t27b\": \"pass_vacuous\",\n   \"blockers\": [],\n   \"reference\": \"pass\"\n  }\n ]\n}\n",
    "{\n \"commit\": \"891a9087afcbc45ca68c87c07a2e4ff0ae5db00c\",\n \"results\": [\n  {\n   \"file\": \"specs/a/one.t27\",\n   \"t27b\": \"pass\",\n   \"asserts\": 7,\n   \"blockers\": [],\n   \"reference\": \"pass\"\n  }\n ]\n}\n",
