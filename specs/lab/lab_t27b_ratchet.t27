// SPDX-License-Identifier: Apache-2.0
; specs/lab/lab_t27b_ratchet.t27 -- the per-spec ratchet of a t27b lab run against the ledger (issue #11042, epic #11040).
; --
; lab.py's ratchet(doc, log) runs the checker of the commit it measured, scripts/tri_loop/t27b.py ratchet, and records
; its verdict. The decision is that checker's ratchet(): every ledger row against its spec's result in the run, every
; spec the reference passes that the ledger does not name, and the cap. Which finding a row gets was already a spec
; (specs/tri/t27b/steward.t27: entry_code, unlisted, over_cap, ratchet_is_red); this file reuses those by `use`, reads
; the run and the ledger as they are written, words the findings and counts them: what t27b.py did in Python.
; --
; The oracle is `python3 scripts/tri_loop/t27b.py ratchet --run RUN --ledger LEDGER`, run on every case of the table at
; the end of this file. For each case the table holds its exit code, its nine counts, the finding lines it printed and,
; for the first RA_FULL_N cases, its whole output with the summary line. 0 differences.
; --
; WHAT IS READ. The run is json.dumps(doc, indent=1) of lab.py's document: a result is an object at indent 2 of the
; `results` list and its keys are at indent 3 (reused from specs/tri/lab/receipt.t27, which reads the same layout);
; `blockers` is read for its first item, then `detail`. The ledger is scripts/tri_loop/t27b.py dump_ledger's layout (its
; header at indent 1, one row an object on one line); a row written by hand with other spacing is read if it stays one
; line. A string is read as Python's json reads it (escapes, surrogate pairs, UTF-8), compared and cut by characters.
; A value Python reads as false (nothing, null, "", false, 0, [], {}) is the verdict `missing`; any other word the rules
; have no code for makes the whole ratchet unreadable, as t27b_rules.py does (exit 2), but only when it is looked at:
; an overwritten duplicate row, or the t27b word of a spec nobody reads, is never examined.
; --
; WHAT A RESULT IS. lt_ratchet writes the finding lines and the summary line as `tri t27b ratchet` prints them, and sets
; res[0..9] to the counts in its order, res[9] to the status (LT_GREEN, LT_RED, LT_UNREADABLE), res[10] to why a ratchet
; was unreadable (LT_U_*: no results, no reference verdict, no ledger, a ledger row or header it does not read, a result
; it does not read, an unknown verdict word, a table wider than its buffer, a string with an invalid escape) and res[11]
; to the non-pass rows. work is 6 * cap_e + 6 * cap_r words.
; --
; WHERE THE SPEC DIFFERS FROM THE PYTHON. A result with no `file`, a first blocker that is not a string and a ledger that
; spreads a row over several lines make Python raise (exit 1 with a traceback, which lab.py records as ok false) or read
; them; here they are LT_UNREADABLE, never a guess. repr() of a reason is exact for ASCII and for the Unicode spaces and
; format marks listed in lt_put_repr; another non-printable character is written as it is. A non-integer cap is printed
; as written. A cap above 4294967295 wraps modulo 2**32, as ctypes does when t27b.py hands it to steward.t27.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module LabT27bRatchet;

use lab::text::{LAB_NO, lab_line_end, lab_line_next, lab_same_span, lab_char_len, lab_char_val, lab_put_char, lab_put_span, lab_put_lit, lab_put_count};
use lab::lab_t27b_text::{LX_BIG, lx_digits_end, lx_dec_value, lx_put_pad, lx_out_is};
use tri::lab::receipt::{span_is, line_is, key_at, value_from, value_to, results_at, next_object, object_end};
use lab::lab_t27b_report::{lr_word, lr_word_code, LR_UNKNOWN};
use tri::t27b::steward::is_pass;
use tri::t27b::steward::entry_code;
use tri::t27b::steward::unlisted;
use tri::t27b::steward::over_cap;
use tri::t27b::steward::ratchet_is_red;
use tri::t27b::ledger_steward::T_PASS_VACUOUS;
use tri::t27b::ledger_steward::T_MISSING;
use tri::t27b::ledger_steward::RC_VACUITY_MEASURED;
use tri::t27b::ledger_steward::RC_UNEXPECTED_FAILURE;
use tri::t27b::ledger_steward::RC_UNEXPECTED_PASS;
use tri::t27b::ledger_steward::RC_MOVED;
use tri::t27b::ledger_steward::RC_STALE;
use tri::t27b::ledger_steward::RC_UNJUDGED;
use tri::t27b::ledger_steward::RC_UNLISTED;
use tri::t27b::ledger_steward::RC_OVER_CAP;
use tri::t27b::ledger_steward::RC_BAD_REASON;

// ---- JSON text ----
; The run and the ledger are JSON that Python wrote. A string in them is read as Python's json reads it: an
; escape \" \\ \/ \b \f \n \r \t or \uXXXX (a high and a low surrogate together are one character), any
; other byte as UTF-8. A text with an invalid escape is not read, and neither is a lone surrogate.

pub fn lt_hex_val(c : u8) -> u32 {
    if (c >= 48 and c <= 57) { return (c - 48) as u32; }
    if (c >= 97 and c <= 102) { return (c - 87) as u32; }
    if (c >= 65 and c <= 70) { return (c - 55) as u32; }
    return 16;
}

/// The four hex digits at t[i..i+4] (inside t[..e]) as a number; 65536 when they are not four hex digits.
pub fn lt_u4(t : string, i : usize, e : usize) -> u32 {
    if (i + 4 > e) { return 65536; }
    var v : u32 = 0;
    var k : usize = 0;
    while (k < 4) {
        const d : u32 = lt_hex_val(t[i + k]);
        if (d == 16) { return 65536; }
        v = v * 16 + d;
        k = k + 1;
    }
    return v;
}

/// One character of the JSON string body t[i..e], packed as code point * 16 + the bytes it takes (at most 12).
/// 0 when the text at i is no character (an invalid escape, a lone surrogate): the reader refuses the text.
pub fn lt_char(t : string, i : usize, e : usize) -> u32 {
    const c : u8 = t[i];
    if (c != 92) {
        const n : usize = lab_char_len(t, i, e);
        return lab_char_val(t, i, e) * 16 + (n as u32);
    }
    if (i + 1 >= e) { return 0; }
    const d : u8 = t[i + 1];
    if (d == 34) { return 34 * 16 + 2; }
    if (d == 92) { return 92 * 16 + 2; }
    if (d == 47) { return 47 * 16 + 2; }
    if (d == 98) { return 8 * 16 + 2; }
    if (d == 102) { return 12 * 16 + 2; }
    if (d == 110) { return 10 * 16 + 2; }
    if (d == 114) { return 13 * 16 + 2; }
    if (d == 116) { return 9 * 16 + 2; }
    if (d != 117) { return 0; }
    const u : u32 = lt_u4(t, i + 2, e);
    if (u == 65536) { return 0; }
    if (u >= 56320 and u <= 57343) { return 0; }
    if (u >= 55296 and u <= 56319) {
        if (i + 12 > e or t[i + 6] != 92 or t[i + 7] != 117) { return 0; }
        const l : u32 = lt_u4(t, i + 8, e);
        if (l < 56320 or l > 57343) { return 0; }
        return (65536 + (u - 55296) * 1024 + (l - 56320)) * 16 + 12;
    }
    return u * 16 + 6;
}

/// Do the JSON string bodies t[a0..a1] and u[b0..b1] decode to the same characters.
pub fn lt_json_same(t : string, a0 : usize, a1 : usize, u : string, b0 : usize, b1 : usize) -> bool {
    var i : usize = a0;
    var j : usize = b0;
    while (i < a1 and j < b1) {
        const x : u32 = lt_char(t, i, a1);
        const y : u32 = lt_char(u, j, b1);
        if (x == 0 or y == 0) { return false; }
        if (x / 16 != y / 16) { return false; }
        i = i + ((x % 16) as usize);
        j = j + ((y % 16) as usize);
    }
    return i == a1 and j == b1;
}

/// Python's order of the decoded strings: -1, 0 or 1 by code point. 2 when a text is not readable.
pub fn lt_json_cmp(t : string, a0 : usize, a1 : usize, u : string, b0 : usize, b1 : usize) -> i32 {
    var i : usize = a0;
    var j : usize = b0;
    while (i < a1 and j < b1) {
        const x : u32 = lt_char(t, i, a1);
        const y : u32 = lt_char(u, j, b1);
        if (x == 0 or y == 0) { return 2; }
        if (x / 16 < y / 16) { return -1; }
        if (x / 16 > y / 16) { return 1; }
        i = i + ((x % 16) as usize);
        j = j + ((y % 16) as usize);
    }
    if (i < a1) { return 1; }
    if (j < b1) { return -1; }
    return 0;
}

/// Where the first n characters of the JSON string body t[a..b] end: Python's s[:n]. b when there are fewer;
/// LAB_NO when the text is not readable.
pub fn lt_json_cut(t : string, a : usize, b : usize, n : usize) -> usize {
    var i : usize = a;
    var seen : usize = 0;
    while (i < b and seen < n) {
        const x : u32 = lt_char(t, i, b);
        if (x == 0) { return LAB_NO; }
        i = i + ((x % 16) as usize);
        seen = seen + 1;
    }
    return i;
}

/// Is the JSON string body t[a..b] readable.
pub fn lt_json_ok(t : string, a : usize, b : usize) -> bool {
    return lt_json_cut(t, a, b, b - a + 1) != LAB_NO;
}

/// Writes the characters of the JSON string body t[a..b] as UTF-8 (what Python prints), at most n of them.
pub fn lt_put_json(out : []u8, cap : usize, w : usize, t : string, a : usize, b : usize, n : usize) -> usize {
    var x : usize = w;
    var i : usize = a;
    var seen : usize = 0;
    while (i < b and seen < n) {
        const c : u32 = lt_char(t, i, b);
        if (c == 0) { return x; }
        x = lab_put_char(out, cap, x, c / 16);
        i = i + ((c % 16) as usize);
        seen = seen + 1;
    }
    return x;
}

/// Python's repr of the string body t[a..b] (what `!r` writes in the finding for a bad reason): single quotes,
/// unless the text holds a single quote and no double quote; \\ \n \r \t and \xNN for the other ASCII
/// controls. A character above U+007E is written as it is, except the C1 controls, the no-break space and the
/// soft hyphen (\xNN) and the Unicode spaces and format marks (\uNNNN): the other non-printable ones are not told.
pub fn lt_put_repr(out : []u8, cap : usize, w : usize, t : string, a : usize, b : usize) -> usize {
    var has_s : bool = false;
    var has_d : bool = false;
    var i : usize = a;
    while (i < b) {
        const c : u32 = lt_char(t, i, b);
        if (c == 0) { return w; }
        if (c / 16 == 39) { has_s = true; }
        if (c / 16 == 34) { has_d = true; }
        i = i + ((c % 16) as usize);
    }
    var q : u8 = 39;
    if (has_s and has_d == false) { q = 34; }
    var x : usize = lab_put_char(out, cap, w, q as u32);
    i = a;
    while (i < b) {
        const c : u32 = lt_char(t, i, b);
        const cp : u32 = c / 16;
        i = i + ((c % 16) as usize);
        if (cp == 92) {
            x = lab_put_lit(out, cap, x, "\\\\");
        } else {
            if (cp == (q as u32)) {
                x = lab_put_lit(out, cap, x, "\\");
                x = lab_put_char(out, cap, x, cp);
            } else {
                if (cp == 10) {
                    x = lab_put_lit(out, cap, x, "\\n");
                } else {
                    if (cp == 13) {
                        x = lab_put_lit(out, cap, x, "\\r");
                    } else {
                        if (cp == 9) {
                            x = lab_put_lit(out, cap, x, "\\t");
                        } else {
                            if (cp < 32 or (cp >= 127 and cp <= 160) or cp == 173) {
                                x = lab_put_lit(out, cap, x, "\\x");
                                x = lt_put_hex2(out, cap, x, cp);
                            } else {
                                if ((cp >= 8192 and cp <= 8207) or (cp >= 8232 and cp <= 8239) or (cp >= 8287 and cp <= 8303) or cp == 12288 or cp == 65279) {
                                    x = lab_put_lit(out, cap, x, "\\u");
                                    x = lt_put_hex2(out, cap, x, cp / 256);
                                    x = lt_put_hex2(out, cap, x, cp % 256);
                                } else {
                                    x = lab_put_char(out, cap, x, cp);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return lab_put_char(out, cap, x, q as u32);
}

/// One lower-case hex digit of v (v < 16) as its byte.
pub fn lt_hex_char(v : u32) -> u32 {
    if (v < 10) { return 48 + v; }
    return 87 + v;
}

/// Writes v (v < 256) as two lower-case hex digits.
pub fn lt_put_hex2(out : []u8, cap : usize, w : usize, v : u32) -> usize {
    const x : usize = lab_put_char(out, cap, w, lt_hex_char((v / 16) % 16));
    return lab_put_char(out, cap, x, lt_hex_char(v % 16));
}

// ---- one-line JSON objects: a row of the ledger ----

pub fn lt_ws(c : u8) -> bool {
    return c == 32 or c == 9 or c == 13 or c == 10;
}

pub fn lt_skip(t : string, i : usize, e : usize) -> usize {
    var k : usize = i;
    while (k < e and lt_ws(t[k])) {
        k = k + 1;
    }
    return k;
}

/// The offset of the quote that ends the string whose body starts at s, within t[..e]; LAB_NO when it does not end.
pub fn lt_str_end(t : string, s : usize, e : usize) -> usize {
    var k : usize = s;
    while (k < e) {
        if (t[k] == 92) {
            k = k + 2;
        } else {
            if (t[k] == 34) { return k; }
            k = k + 1;
        }
    }
    return LAB_NO;
}

/// Where the value that starts at t[i] ends: past its closing quote for a string, else at the next comma or
/// closing brace outside any brackets. LAB_NO when it does not end.
pub fn lt_value_end(t : string, i : usize, e : usize) -> usize {
    if (t[i] == 34) {
        const q : usize = lt_str_end(t, i + 1, e);
        if (q == LAB_NO) { return LAB_NO; }
        return q + 1;
    }
    var depth : u32 = 0;
    var k : usize = i;
    while (k < e) {
        const c : u8 = t[k];
        if (c == 34) {
            const s : usize = lt_str_end(t, k + 1, e);
            if (s == LAB_NO) { return LAB_NO; }
            k = s + 1;
        } else {
            if (c == 91 or c == 123) {
                depth = depth + 1;
                k = k + 1;
            } else {
                if (c == 93 or c == 125) {
                    if (depth == 0) { return k; }
                    depth = depth - 1;
                    k = k + 1;
                } else {
                    if (c == 44 and depth == 0) { return k; }
                    k = k + 1;
                }
            }
        }
    }
    return k;
}

/// Reads the one-line JSON object t[ls..le] (a trailing comma is allowed) for key. When it is found, sp[0] and
/// sp[1] are its value (a string's body without quotes, any other value as written) and sp[2] is 1 for a string.
/// 0: no such key; 1: found, the last one if it comes twice; 2: the line is not an object this reader reads.
pub fn lt_obj(t : string, ls : usize, le : usize, key : string, sp : []usize) -> u8 {
    var i : usize = lt_skip(t, ls, le);
    if (i >= le or t[i] != 123) { return 2; }
    i = lt_skip(t, i + 1, le);
    var found : u8 = 0;
    if (i < le and t[i] == 125) {
        i = i + 1;
    } else {
        var more : bool = true;
        while (more) {
            if (i >= le or t[i] != 34) { return 2; }
            const ke : usize = lt_str_end(t, i + 1, le);
            if (ke == LAB_NO) { return 2; }
            const ks : usize = i + 1;
            i = lt_skip(t, ke + 1, le);
            if (i >= le or t[i] != 58) { return 2; }
            i = lt_skip(t, i + 1, le);
            if (i >= le) { return 2; }
            const ve : usize = lt_value_end(t, i, le);
            if (ve == LAB_NO) { return 2; }
            var vs : usize = i;
            var vt : usize = ve;
            var is_str : usize = 0;
            if (t[i] == 34) {
                vs = i + 1;
                vt = ve - 1;
                is_str = 1;
            } else {
                while (vt > vs and lt_ws(t[vt - 1])) {
                    vt = vt - 1;
                }
                if (vt == vs) { return 2; }
            }
            if (lab_same_span(t, ks, ke, key, 0, key.len)) {
                found = 1;
                sp[0] = vs;
                sp[1] = vt;
                sp[2] = is_str;
            }
            i = lt_skip(t, ve, le);
            if (i >= le) { return 2; }
            if (t[i] == 44) {
                i = lt_skip(t, i + 1, le);
            } else {
                if (t[i] != 125) { return 2; }
                i = i + 1;
                more = false;
            }
        }
    }
    i = lt_skip(t, i, le);
    if (i < le and t[i] == 44) { i = lt_skip(t, i + 1, le); }
    if (i != le) { return 2; }
    return found;
}

// ---- the ledger and the run ----

pub const LT_REASONS : [3]string = ["unimplemented", "reference-bug", "n/a"];
/// A finding's kind by steward.t27's code (index 0 is none).
pub const LT_KIND_NAMES : [10]string = ["", "VACUITY MEASURED", "UNEXPECTED FAILURE", "UNEXPECTED PASS", "MOVED", "STALE", "UNJUDGED", "UNLISTED", "OVER CAP", "BAD REASON"];
/// The order `tri t27b ratchet` counts its kinds in (KINDS in t27b.py), as steward.t27's codes.
pub const LT_REPORT_ORDER : [9]u8 = [2, 3, 7, 5, 8, 9, 4, 6, 1];
/// The width a kind is padded to in a finding line.
pub const LT_KIND_WIDTH : usize = 19;

/// Why a ratchet could not be read (res[10]): none, the run has no results, none of them has a reference verdict,
/// the ledger is empty, a ledger row or header is not in a layout this reads, a run result is not, a verdict word
/// the rules do not know, a table is wider than its buffer, a string with an invalid escape.
pub const LT_U_NONE : u32 = 0;
pub const LT_U_NO_RESULTS : u32 = 1;
pub const LT_U_NO_REFERENCE : u32 = 2;
pub const LT_U_NO_LEDGER : u32 = 3;
pub const LT_U_LEDGER : u32 = 4;
pub const LT_U_RUN : u32 = 5;
pub const LT_U_WORD : u32 = 6;
pub const LT_U_CAPACITY : u32 = 7;
pub const LT_U_TEXT : u32 = 8;

/// The status of a ratchet (res[9]): no finding is red, one is, or it could not be read.
pub const LT_GREEN : u32 = 0;
pub const LT_RED : u32 = 1;
pub const LT_UNREADABLE : u32 = 2;

/// The slot of a finding code in the report order.
pub fn lt_slot(code : u8) -> usize {
    var k : usize = 0;
    while (k < 9) {
        if (LT_REPORT_ORDER[k] == code) { return k; }
        k = k + 1;
    }
    return 9;
}

/// The verdict code of a JSON value of `t27b` or `reference`: T_MISSING for a value Python reads as false
/// (nothing, null, "", false, 0, [], {}), LR_UNKNOWN for a word steward.t27 has no code for.
pub fn lt_word_of(t : string, found : bool, a : usize, b : usize, is_str : bool) -> u8 {
    if (found == false) { return T_MISSING; }
    if (is_str) {
        if (a == b) { return T_MISSING; }
        return lr_word_code(t, a, b);
    }
    if (span_is(t, a, b, "null") or span_is(t, a, b, "false") or span_is(t, a, b, "0") or span_is(t, a, b, "0.0") or span_is(t, a, b, "[]") or span_is(t, a, b, "{}")) { return T_MISSING; }
    return LR_UNKNOWN;
}

/// A result's key at its own indent: sp[0], sp[1] the value (a string's body, else the value as written), sp[2] 1 for a string.
pub fn lt_run_val(run : string, o : usize, e : usize, key : string, sp : []usize) -> bool {
    const v : usize = key_at(run, o, e, 3, key);
    if (v > run.len) { return false; }
    sp[0] = value_from(run, v);
    sp[1] = value_to(run, v);
    sp[2] = 0;
    if (v < run.len and run[v] == 34) { sp[2] = 1; }
    return true;
}

/// The verdict code of key (`t27b` or `reference`) of the result t[o..e].
pub fn lt_run_word(run : string, o : usize, e : usize, key : string) -> u8 {
    var sp : [3]usize = undefined;
    const f : bool = lt_run_val(run, o, e, key, &sp);
    return lt_word_of(run, f, sp[0], sp[1], sp[2] == 1);
}

/// The first blocker of the result, or its detail when it has none: lab_run's `blockers[0] if blockers else
/// (detail or "")`. 1 with the string body in sp[0..2] (empty when there is none), 2 when the result has them
/// in a shape this does not read (a first blocker that is not a string, a detail that is not text).
pub fn lt_first_text(run : string, o : usize, e : usize, sp : []usize) -> u8 {
    const bv : usize = key_at(run, o, e, 3, "blockers");
    if (bv <= run.len) {
        if (bv < run.len and run[bv] == 91) {
            if (bv + 1 < run.len and run[bv + 1] == 93) {
                sp[0] = 0;
            } else {
                const nl : usize = lab_line_end(run, bv) + 1;
                var q : usize = nl;
                while (q < run.len and run[q] == 32) {
                    q = q + 1;
                }
                if (q - nl != 4 or q >= run.len or run[q] != 34) { return 2; }
                sp[0] = q + 1;
                sp[1] = value_to(run, q);
                return 1;
            }
        } else {
            if (span_is(run, value_from(run, bv), value_to(run, bv), "null") == false) { return 2; }
        }
    }
    sp[0] = 0;
    sp[1] = 0;
    var d : [3]usize = undefined;
    if (lt_run_val(run, o, e, "detail", &d) == false) { return 1; }
    if (d[2] == 1) {
        sp[0] = d[0];
        sp[1] = d[1];
        return 1;
    }
    if (span_is(run, d[0], d[1], "null") or span_is(run, d[0], d[1], "false") or span_is(run, d[0], d[1], "0") or span_is(run, d[0], d[1], "[]")) { return 1; }
    return 2;
}

/// How many ledger rows the lines from `at` hold (the entries array of dump_ledger's layout: one object a line).
/// ent is five words a row: the line's start and end, the path's start and end, and 1 while no later row has
/// the same path. LAB_NO when a row is not a one-line object with a string path, LAB_NO - 1 when there are more
/// than cap rows.
pub fn lt_collect_entries(ledger : string, ent : []u32, cap : usize) -> usize {
    var at : usize = 0;
    var start : usize = LAB_NO;
    while (at < ledger.len and start == LAB_NO) {
        const e : usize = lab_line_end(ledger, at);
        if (line_is(ledger, at, e, 1, "\"entries\": [")) { start = lab_line_next(ledger, e); }
        if (line_is(ledger, at, e, 1, "\"entries\": []")) { start = ledger.len; }
        at = lab_line_next(ledger, e);
    }
    if (start == LAB_NO) { return 0; }
    var n : usize = 0;
    var sp : [3]usize = undefined;
    var s : usize = start;
    var closed : bool = false;
    while (s < ledger.len and closed == false) {
        const e : usize = lab_line_end(ledger, s);
        if (line_is(ledger, s, e, 1, "]")) {
            closed = true;
        } else {
            if (lt_skip(ledger, s, e) < e) {
                if (lt_obj(ledger, s, e, "path", &sp) != 1 or sp[2] != 1) { return LAB_NO; }
                if (lt_json_ok(ledger, sp[0], sp[1]) == false) { return LAB_NO; }
                if (n >= cap) { return LAB_NO - 1; }
                var j : usize = 0;
                while (j < n) {
                    if (ent[5 * j + 4] == 1) {
                        if (lt_json_same(ledger, ent[5 * j + 2] as usize, ent[5 * j + 3] as usize, ledger, sp[0], sp[1])) { ent[5 * j + 4] = 0; }
                    }
                    j = j + 1;
                }
                ent[5 * n] = s as u32;
                ent[5 * n + 1] = e as u32;
                ent[5 * n + 2] = sp[0] as u32;
                ent[5 * n + 3] = sp[1] as u32;
                ent[5 * n + 4] = 1;
                n = n + 1;
            }
            s = lab_line_next(ledger, e);
        }
    }
    return n;
}

/// The results of the run: rt is five words each (the object's start and end, its file's start and end, 1 while
/// no later result has the same file). flag[0] is set when one has `"reference": "pass"`. LAB_NO when a result has
/// no file that reads, LAB_NO - 1 when there are more than cap.
pub fn lt_collect_results(run : string, rt : []u32, cap : usize, flag : []u32) -> usize {
    flag[0] = 0;
    var n : usize = 0;
    var o : usize = next_object(run, results_at(run));
    var sp : [3]usize = undefined;
    while (o < run.len) {
        const e : usize = object_end(run, o);
        const v : usize = key_at(run, o, e, 3, "file");
        if (v > run.len or run[v] != 34) { return LAB_NO; }
        const pf : usize = value_from(run, v);
        const pt : usize = value_to(run, v);
        if (lt_json_ok(run, pf, pt) == false) { return LAB_NO; }
        if (lt_run_val(run, o, e, "reference", &sp)) {
            if (sp[2] == 1 and span_is(run, sp[0], sp[1], "pass")) { flag[0] = 1; }
        }
        if (n >= cap) { return LAB_NO - 1; }
        var j : usize = 0;
        while (j < n) {
            if (rt[5 * j + 4] == 1) {
                if (lt_json_same(run, rt[5 * j + 2] as usize, rt[5 * j + 3] as usize, run, pf, pt)) { rt[5 * j + 4] = 0; }
            }
            j = j + 1;
        }
        rt[5 * n] = o as u32;
        rt[5 * n + 1] = e as u32;
        rt[5 * n + 2] = pf as u32;
        rt[5 * n + 3] = pt as u32;
        rt[5 * n + 4] = 1;
        n = n + 1;
        o = next_object(run, e);
    }
    return n;
}

/// The rows of tab (five words each, n of them) that still count, in the order of their paths: ord gets their
/// indexes; how many, or LAB_NO when a path is not readable.
pub fn lt_sort(t : string, tab : []const u32, n : usize, ord : []u32) -> usize {
    var m : usize = 0;
    var i : usize = 0;
    while (i < n) {
        if (tab[5 * i + 4] == 1) {
            var j : usize = m;
            var going : bool = true;
            while (going and j > 0) {
                const p : usize = ord[j - 1] as usize;
                const c : i32 = lt_json_cmp(t, tab[5 * p + 2] as usize, tab[5 * p + 3] as usize, t, tab[5 * i + 2] as usize, tab[5 * i + 3] as usize);
                if (c == 2) { return LAB_NO; }
                if (c > 0) {
                    ord[j] = ord[j - 1];
                    j = j - 1;
                } else {
                    going = false;
                }
            }
            ord[j] = i as u32;
            m = m + 1;
        }
        i = i + 1;
    }
    return m;
}

/// The row of tab (in the order ord, m rows) whose path is u[a..b]; LAB_NO when none is.
pub fn lt_find(t : string, tab : []const u32, ord : []const u32, m : usize, u : string, a : usize, b : usize) -> usize {
    var lo : usize = 0;
    var hi : usize = m;
    while (lo < hi) {
        const mid : usize = (lo + hi) / 2;
        const r : usize = ord[mid] as usize;
        const c : i32 = lt_json_cmp(t, tab[5 * r + 2] as usize, tab[5 * r + 3] as usize, u, a, b);
        if (c == 0) { return r; }
        if (c < 0) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return LAB_NO;
}

/// str() of a JSON value, at most n characters of it: None, True, False, a string's characters, a number as written.
pub fn lt_put_pystr(out : []u8, cap : usize, w : usize, t : string, found : bool, a : usize, b : usize, is_str : bool, n : usize) -> usize {
    if (found == false) { return lab_put_lit(out, cap, w, "None"); }
    if (is_str) { return lt_put_json(out, cap, w, t, a, b, n); }
    if (span_is(t, a, b, "null")) { return lab_put_lit(out, cap, w, "None"); }
    if (span_is(t, a, b, "true")) { return lab_put_lit(out, cap, w, "True"); }
    if (span_is(t, a, b, "false")) { return lab_put_lit(out, cap, w, "False"); }
    var e : usize = b;
    if (e - a > n) { e = a + n; }
    return lab_put_span(out, cap, w, t, a, e);
}

/// The head of a finding line: the kind padded to 19, a space, the path, a colon and a space.
pub fn lt_put_head(out : []u8, cap : usize, w : usize, code : u8, t : string, pf : usize, pt : usize) -> usize {
    var x : usize = lab_put_lit(out, cap, w, LT_KIND_NAMES[code as usize]);
    x = lx_put_pad(out, cap, x, LT_KIND_WIDTH - LT_KIND_NAMES[code as usize].len);
    x = lab_put_lit(out, cap, x, " ");
    x = lt_put_json(out, cap, x, t, pf, pt, LX_BIG as usize);
    return lab_put_lit(out, cap, x, ": ");
}

/// The `source` object of the ledger: sp[0] is where its keys start and sp[1] where its closing line starts.
/// 0: there is none, or it is null; 1: an object; 2: it is something else.
pub fn lt_source(ledger : string, sp : []usize) -> u8 {
    const v : usize = key_at(ledger, 0, ledger.len, 1, "source");
    if (v > ledger.len) { return 0; }
    if (v < ledger.len and ledger[v] == 123) {
        if (v + 1 < ledger.len and ledger[v + 1] == 125) {
            sp[0] = v;
            sp[1] = v;
            return 1;
        }
        const first : usize = lab_line_end(ledger, v) + 1;
        var k : usize = first;
        while (k < ledger.len) {
            const e : usize = lab_line_end(ledger, k);
            if (line_is(ledger, k, e, 1, "}")) {
                sp[0] = first;
                sp[1] = k;
                return 1;
            }
            k = lab_line_next(ledger, e);
        }
        return 2;
    }
    if (span_is(ledger, value_from(ledger, v), value_to(ledger, v), "null")) { return 0; }
    return 2;
}

/// Is the value of max_not_pass a cap: a whole number that is not negative (and not a boolean, a float or text).
pub fn lt_cap_has(t : string, found : bool, a : usize, b : usize, is_str : bool) -> bool {
    if (found == false or is_str or b <= a) { return false; }
    if (lx_digits_end(t, a, b) == b) { return true; }
    if (t[a] == 45 and b - a > 1 and lx_digits_end(t, a + 1, b) == b) { return lx_dec_value(t, a + 1, b) == 0; }
    return false;
}

/// Writes str(commit)[:9] for the key of a header: the first nine characters of a value, `None` when there is none.
pub fn lt_put_commit(out : []u8, cap : usize, w : usize, t : string, v : usize) -> usize {
    if (v > t.len) { return lab_put_lit(out, cap, w, "None"); }
    return lt_put_pystr(out, cap, w, t, true, value_from(t, v), value_to(t, v), v < t.len and t[v] == 34, 9);
}

/// Sets the answer to unreadable, with its reason; the text of the call is not valid then.
pub fn lt_fail(res : []u32, w : usize, why : u32) -> usize {
    res[9] = LT_UNREADABLE;
    res[10] = why;
    return w;
}

/// Writes the blocker of the result t[o..e] cut at 200 characters, from the span in sp (a first blocker or a detail).
pub fn lt_put_blocker(out : []u8, cap : usize, w : usize, run : string, sp : []const usize) -> usize {
    const cut : usize = lt_json_cut(run, sp[0], sp[1], 200);
    return lt_put_json(out, cap, w, run, sp[0], cut, 200);
}

/// The ratchet of a run against a ledger (`tri t27b ratchet`, ratchet() in scripts/tri_loop/t27b.py), read from the
/// run document and the ledger as Python wrote them. Findings are written at w, one line each, then the summary
/// line, exactly as the command prints them; the cursor after them is returned. res[0..9] are the counts per kind in
/// the command's order, res[9] the status (LT_GREEN, LT_RED, LT_UNREADABLE: then nothing is valid), res[10] the
/// reason it was unreadable, res[11] the number of non-pass rows. work holds the tables: 6 * cap_e + 6 * cap_r words,
/// room for cap_e ledger rows and cap_r run results.
pub fn lt_ratchet(run : string, ledger : string, work : []u32, cap_e : usize, cap_r : usize, out : []u8, cap : usize, w : usize, res : []u32) -> usize {
    var q : usize = 0;
    while (q < 12) {
        res[q] = 0;
        q = q + 1;
    }
    const ent : []u32 = work[0..5 * cap_e];
    const eord : []u32 = work[5 * cap_e..6 * cap_e];
    const rt : []u32 = work[6 * cap_e..6 * cap_e + 5 * cap_r];
    const rord : []u32 = work[6 * cap_e + 5 * cap_r..6 * cap_e + 6 * cap_r];
    var flag : [1]u32 = [0];
    const nr : usize = lt_collect_results(run, rt, cap_r, &flag);
    if (nr == LAB_NO) { return lt_fail(res, w, LT_U_RUN); }
    if (nr == LAB_NO - 1) { return lt_fail(res, w, LT_U_CAPACITY); }
    if (nr == 0) { return lt_fail(res, w, LT_U_NO_RESULTS); }
    if (flag[0] == 0) { return lt_fail(res, w, LT_U_NO_REFERENCE); }
    if (ledger.len == 0) { return lt_fail(res, w, LT_U_NO_LEDGER); }
    const ne : usize = lt_collect_entries(ledger, ent, cap_e);
    if (ne == LAB_NO) { return lt_fail(res, w, LT_U_LEDGER); }
    if (ne == LAB_NO - 1) { return lt_fail(res, w, LT_U_CAPACITY); }
    const me : usize = lt_sort(ledger, ent, ne, eord);
    const mr : usize = lt_sort(run, rt, nr, rord);
    if (me == LAB_NO or mr == LAB_NO) { return lt_fail(res, w, LT_U_TEXT); }
    var src : [2]usize = [0, 0];
    const sk : u8 = lt_source(ledger, &src);
    if (sk == 2) { return lt_fail(res, w, LT_U_LEDGER); }
    var counted : bool = true;
    var ledger_commit : usize = ledger.len + 1;
    if (sk == 1) {
        const av : usize = key_at(ledger, src[0], src[1], 2, "asserts_counted");
        if (av <= ledger.len) {
            if (span_is(ledger, value_from(ledger, av), value_to(ledger, av), "false")) { counted = false; }
        }
        ledger_commit = key_at(ledger, src[0], src[1], 2, "commit");
    }
    var x : usize = w;
    var sp : [3]usize = undefined;
    var bsp : [3]usize = undefined;
    var lsp : [3]usize = undefined;
    var i : usize = 0;
    while (i < me) {
        const ei : usize = eord[i] as usize;
        const ls : usize = ent[5 * ei] as usize;
        const le : usize = ent[5 * ei + 1] as usize;
        const pf : usize = ent[5 * ei + 2] as usize;
        const pt : usize = ent[5 * ei + 3] as usize;
        const tf : bool = lt_obj(ledger, ls, le, "t27b", &sp) == 1;
        const want : u8 = lt_word_of(ledger, tf, sp[0], sp[1], sp[2] == 1);
        if (want == LR_UNKNOWN) { return lt_fail(res, w, LT_U_WORD); }
        const rf : bool = lt_obj(ledger, ls, le, "reason", &lsp) == 1;
        if (is_pass(want) == false) {
            var good : bool = false;
            if (rf and lsp[2] == 1) {
                var r : usize = 0;
                while (r < 3) {
                    if (lab_same_span(ledger, lsp[0], lsp[1], LT_REASONS[r], 0, LT_REASONS[r].len)) { good = true; }
                    r = r + 1;
                }
            }
            if (good == false) {
                x = lt_put_head(out, cap, x, RC_BAD_REASON, ledger, pf, pt);
                x = lab_put_lit(out, cap, x, "reason ");
                if (rf and lsp[2] == 1) {
                    x = lt_put_repr(out, cap, x, ledger, lsp[0], lsp[1]);
                } else {
                    x = lt_put_pystr(out, cap, x, ledger, rf, lsp[0], lsp[1], false, LX_BIG as usize);
                }
                x = lab_put_lit(out, cap, x, " is not one of unimplemented, reference-bug, n/a\n");
                res[lt_slot(RC_BAD_REASON)] = res[lt_slot(RC_BAD_REASON)] + 1;
            }
        }
        const ri : usize = lt_find(run, rt, rord, mr, ledger, pf, pt);
        if (ri == LAB_NO) {
            x = lt_put_head(out, cap, x, RC_STALE, ledger, pf, pt);
            x = lab_put_lit(out, cap, x, "not in this run: the spec is gone or was renamed\n");
            res[lt_slot(RC_STALE)] = res[lt_slot(RC_STALE)] + 1;
        } else {
            const o : usize = rt[5 * ri] as usize;
            const e : usize = rt[5 * ri + 1] as usize;
            const ref_c : u8 = lt_run_word(run, o, e, "reference");
            const got : u8 = lt_run_word(run, o, e, "t27b");
            if (ref_c == LR_UNKNOWN or got == LR_UNKNOWN) { return lt_fail(res, w, LT_U_WORD); }
            var has_b : bool = false;
            if (is_pass(got) == false) {
                if (lt_first_text(run, o, e, &bsp) != 1) { return lt_fail(res, w, LT_U_RUN); }
                if (lt_json_cut(run, bsp[0], bsp[1], 200) == LAB_NO) { return lt_fail(res, w, LT_U_TEXT); }
                has_b = true;
            }
            const bf : bool = lt_obj(ledger, ls, le, "blocker", &lsp) == 1;
            var same : bool = false;
            if (has_b) {
                if (bf and lsp[2] == 1) { same = lt_json_same(run, bsp[0], lt_json_cut(run, bsp[0], bsp[1], 200), ledger, lsp[0], lsp[1]); }
            } else {
                same = bf == false or (lsp[2] == 0 and span_is(ledger, lsp[0], lsp[1], "null"));
            }
            const kind : u8 = entry_code(want, ref_c, got, counted, same);
            if (kind != 0) {
                x = lt_put_head(out, cap, x, kind, ledger, pf, pt);
                if (kind == RC_STALE) {
                    x = lab_put_lit(out, cap, x, "the reference does not pass it any more (");
                    x = lab_put_lit(out, cap, x, lr_word(ref_c));
                    x = lab_put_lit(out, cap, x, ": ");
                    var dsp : [3]usize = undefined;
                    if (lt_run_val(run, o, e, "reference_detail", &dsp)) {
                        if (dsp[2] == 1) {
                            x = lt_put_json(out, cap, x, run, dsp[0], dsp[1], 120);
                        } else {
                            if (span_is(run, dsp[0], dsp[1], "null") == false and span_is(run, dsp[0], dsp[1], "false") == false and span_is(run, dsp[0], dsp[1], "0") == false and span_is(run, dsp[0], dsp[1], "[]") == false) { return lt_fail(res, w, LT_U_RUN); }
                        }
                    }
                    x = lab_put_lit(out, cap, x, ")\n");
                }
                if (kind == RC_UNJUDGED) {
                    x = lab_put_lit(out, cap, x, "reference ");
                    x = lab_put_lit(out, cap, x, lr_word(ref_c));
                    x = lab_put_lit(out, cap, x, ": no verdict either way\n");
                }
                if (kind == RC_VACUITY_MEASURED) {
                    x = lab_put_lit(out, cap, x, "ledger pass was blessed before asserts were counted; this run counts 0 runtime asserts: bless to record pass_vacuous\n");
                }
                if (kind == RC_UNEXPECTED_FAILURE) {
                    x = lab_put_lit(out, cap, x, "ledger ");
                    x = lab_put_lit(out, cap, x, lr_word(want));
                    x = lab_put_lit(out, cap, x, ", now ");
                    if (got == T_PASS_VACUOUS) {
                        x = lab_put_lit(out, cap, x, "passes with 0 runtime asserts");
                    } else {
                        x = lab_put_lit(out, cap, x, lr_word(got));
                        x = lab_put_lit(out, cap, x, ": ");
                        x = lt_put_blocker(out, cap, x, run, &bsp);
                    }
                    x = lab_put_lit(out, cap, x, "\n");
                }
                if (kind == RC_UNEXPECTED_PASS) {
                    if (want == T_PASS_VACUOUS) {
                        x = lab_put_lit(out, cap, x, "ledger pass_vacuous, now a pass with ");
                        const af : bool = lt_run_val(run, o, e, "asserts", &sp);
                        x = lt_put_pystr(out, cap, x, run, af, sp[0], sp[1], sp[2] == 1, LX_BIG as usize);
                        x = lab_put_lit(out, cap, x, " runtime asserts\n");
                    } else {
                        x = lab_put_lit(out, cap, x, "ledger ");
                        x = lab_put_lit(out, cap, x, lr_word(want));
                        x = lab_put_lit(out, cap, x, " (");
                        x = lt_put_pystr(out, cap, x, ledger, bf, lsp[0], lsp[1], lsp[2] == 1, LX_BIG as usize);
                        x = lab_put_lit(out, cap, x, "), now ");
                        x = lab_put_lit(out, cap, x, lr_word(got));
                        x = lab_put_lit(out, cap, x, "\n");
                    }
                }
                if (kind == RC_MOVED) {
                    x = lab_put_lit(out, cap, x, lr_word(want));
                    x = lab_put_lit(out, cap, x, " (");
                    x = lt_put_pystr(out, cap, x, ledger, bf, lsp[0], lsp[1], lsp[2] == 1, LX_BIG as usize);
                    x = lab_put_lit(out, cap, x, ") -> ");
                    x = lab_put_lit(out, cap, x, lr_word(got));
                    x = lab_put_lit(out, cap, x, " (");
                    x = lt_put_blocker(out, cap, x, run, &bsp);
                    x = lab_put_lit(out, cap, x, ")\n");
                }
                res[lt_slot(kind)] = res[lt_slot(kind)] + 1;
            }
        }
        i = i + 1;
    }
    var j : usize = 0;
    while (j < mr) {
        const rj : usize = rord[j] as usize;
        const o2 : usize = rt[5 * rj] as usize;
        const e2 : usize = rt[5 * rj + 1] as usize;
        const ref2 : u8 = lt_run_word(run, o2, e2, "reference");
        if (ref2 == LR_UNKNOWN) { return lt_fail(res, w, LT_U_WORD); }
        const listed : bool = lt_find(ledger, ent, eord, me, run, rt[5 * rj + 2] as usize, rt[5 * rj + 3] as usize) != LAB_NO;
        if (unlisted(ref2, listed)) {
            const got2 : u8 = lt_run_word(run, o2, e2, "t27b");
            if (got2 == LR_UNKNOWN) { return lt_fail(res, w, LT_U_WORD); }
            x = lt_put_head(out, cap, x, RC_UNLISTED, run, rt[5 * rj + 2] as usize, rt[5 * rj + 3] as usize);
            x = lab_put_lit(out, cap, x, "the reference passes it and the ledger does not name it (t27b ");
            x = lab_put_lit(out, cap, x, lr_word(got2));
            if (is_pass(got2) == false) {
                if (lt_first_text(run, o2, e2, &bsp) != 1) { return lt_fail(res, w, LT_U_RUN); }
                const cut2 : usize = lt_json_cut(run, bsp[0], bsp[1], 200);
                if (cut2 == LAB_NO) { return lt_fail(res, w, LT_U_TEXT); }
                if (cut2 > bsp[0]) {
                    x = lab_put_lit(out, cap, x, ": ");
                    x = lt_put_blocker(out, cap, x, run, &bsp);
                }
            }
            x = lab_put_lit(out, cap, x, ")\n");
            res[lt_slot(RC_UNLISTED)] = res[lt_slot(RC_UNLISTED)] + 1;
        }
        j = j + 1;
    }
    var not_pass : u32 = 0;
    var m : usize = 0;
    while (m < me) {
        const mi : usize = eord[m] as usize;
        const tf2 : bool = lt_obj(ledger, ent[5 * mi] as usize, ent[5 * mi + 1] as usize, "t27b", &sp) == 1;
        if (is_pass(lt_word_of(ledger, tf2, sp[0], sp[1], sp[2] == 1)) == false) { not_pass = not_pass + 1; }
        m = m + 1;
    }
    res[11] = not_pass;
    const cf : usize = key_at(ledger, 0, ledger.len, 1, "max_not_pass");
    var cfound : bool = false;
    var ca : usize = 0;
    var cb : usize = 0;
    var cstr : bool = false;
    if (cf <= ledger.len) {
        cfound = true;
        ca = value_from(ledger, cf);
        cb = value_to(ledger, cf);
        cstr = cf < ledger.len and ledger[cf] == 34;
    }
    const has_cap : bool = lt_cap_has(ledger, cfound, ca, cb, cstr);
    var cap_v : u32 = 0;
    if (has_cap and cb > ca and ledger[ca] != 45) { cap_v = (lx_dec_value(ledger, ca, cb) % 4294967296) as u32; }
    if (over_cap(not_pass, cap_v, has_cap)) {
        x = lab_put_lit(out, cap, x, "OVER CAP");
        x = lx_put_pad(out, cap, x, LT_KIND_WIDTH - 8);
        x = lab_put_lit(out, cap, x, " -: ");
        x = lab_put_count(out, cap, x, not_pass as u64);
        x = lab_put_lit(out, cap, x, " non-pass entries, max_not_pass ");
        x = lt_put_pystr(out, cap, x, ledger, cfound, ca, cb, cstr, LX_BIG as usize);
        x = lab_put_lit(out, cap, x, "\n");
        res[lt_slot(RC_OVER_CAP)] = res[lt_slot(RC_OVER_CAP)] + 1;
    }
    var red : u32 = 0;
    var s : usize = 0;
    while (s < 9) {
        if (ratchet_is_red(LT_REPORT_ORDER[s])) { red = red + res[s]; }
        s = s + 1;
    }
    var status : u32 = LT_GREEN;
    if (red > 0) { status = LT_RED; }
    res[9] = status;
    x = lab_put_lit(out, cap, x, "tri t27b ratchet: ");
    if (red > 0) {
        x = lab_put_lit(out, cap, x, "red");
    } else {
        x = lab_put_lit(out, cap, x, "green");
    }
    x = lab_put_lit(out, cap, x, " -- run ");
    x = lt_put_commit(out, cap, x, run, key_at(run, 0, results_at(run), 1, "commit"));
    x = lab_put_lit(out, cap, x, " vs ledger ");
    if (ledger_commit > ledger.len) {
        x = lab_put_lit(out, cap, x, "None");
    } else {
        x = lt_put_commit(out, cap, x, ledger, ledger_commit);
    }
    x = lab_put_lit(out, cap, x, ": ");
    var c : usize = 0;
    while (c < 9) {
        x = lab_put_lit(out, cap, x, LT_KIND_NAMES[LT_REPORT_ORDER[c] as usize]);
        x = lab_put_lit(out, cap, x, " ");
        x = lab_put_count(out, cap, x, res[c] as u64);
        if (c < 8) { x = lab_put_lit(out, cap, x, ", "); }
        c = c + 1;
    }
    return lab_put_lit(out, cap, x, "\n");
}

// ---- tests ----

/// A run and a ledger small enough to read, in the layouts lab.py and dump_ledger write.
pub const LT_RUN : string = "{\n \"commit\": \"891a9087afcbc45ca68c87c07a2e4ff0ae5db00c\",\n \"results\": [\n  {\n   \"file\": \"specs/a.t27\",\n   \"t27b\": \"pass\",\n   \"blockers\": [],\n   \"reference\": \"pass\"\n  },\n  {\n   \"file\": \"specs/b.t27\",\n   \"t27b\": \"blocked\",\n   \"blockers\": [\n    \"ExprFoo\"\n   ],\n   \"reference\": \"pass\"\n  }\n ]\n}\n";
pub const LT_LEDGER : string = "{\n \"source\": {\n  \"commit\": \"2520ee1a5985688b0ec2fc5c0d8867d6add1a6a9\",\n  \"asserts_counted\": true\n },\n \"max_not_pass\": 1,\n \"entries\": [\n  {\"path\": \"specs/a.t27\", \"t27b\": \"pass\"},\n  {\"path\": \"specs/b.t27\", \"t27b\": \"blocked\", \"blocker\": \"ExprFoo\", \"reason\": \"unimplemented\"}\n ]\n}\n";
pub const LT_WORK : usize = 32;

test the_small_run_and_ledger_agree_and_the_summary_line_says_green {
    var work : [384]u32 = undefined;
    var out : [2048]u8 = undefined;
    var res : [12]u32 = undefined;
    const w : usize = lt_ratchet(LT_RUN, LT_LEDGER, &work, LT_WORK, LT_WORK, &out, 2048, 0, &res);
    assert res[9] == LT_GREEN;
    assert res[11] == 1;
    var k : usize = 0;
    while (k < 9) {
        assert res[k] == 0;
        k = k + 1;
    }
    assert lx_out_is(&out, w, "tri t27b ratchet: green -- run 891a9087a vs ledger 2520ee1a5: UNEXPECTED FAILURE 0, UNEXPECTED PASS 0, UNLISTED 0, STALE 0, OVER CAP 0, BAD REASON 0, MOVED 0, UNJUDGED 0, VACUITY MEASURED 0\n") == true;
}

test a_run_that_drops_a_pass_a_blocker_and_a_spec_is_red_with_one_line_each {
    var work : [384]u32 = undefined;
    var out : [2048]u8 = undefined;
    var res : [12]u32 = undefined;
    const run : string = "{\n \"commit\": \"c1\",\n \"results\": [\n  {\n   \"file\": \"specs/a.t27\",\n   \"t27b\": \"crash\",\n   \"blockers\": [\n    \"boom\"\n   ],\n   \"reference\": \"pass\"\n  },\n  {\n   \"file\": \"specs/b.t27\",\n   \"t27b\": \"blocked\",\n   \"blockers\": [\n    \"ExprBar\"\n   ],\n   \"reference\": \"pass\"\n  },\n  {\n   \"file\": \"specs/new.t27\",\n   \"t27b\": \"pass\",\n   \"blockers\": [],\n   \"reference\": \"pass\"\n  }\n ]\n}\n";
    const w : usize = lt_ratchet(run, LT_LEDGER, &work, LT_WORK, LT_WORK, &out, 2048, 0, &res);
    assert res[9] == LT_RED;
    assert res[0] == 1;
    assert res[2] == 1;
    assert res[6] == 1;
    assert lx_out_is(&out, w, "UNEXPECTED FAILURE  specs/a.t27: ledger pass, now crash: boom\nMOVED               specs/b.t27: blocked (ExprFoo) -> blocked (ExprBar)\nUNLISTED            specs/new.t27: the reference passes it and the ledger does not name it (t27b pass)\ntri t27b ratchet: red -- run c1 vs ledger 2520ee1a5: UNEXPECTED FAILURE 1, UNEXPECTED PASS 0, UNLISTED 1, STALE 0, OVER CAP 0, BAD REASON 0, MOVED 1, UNJUDGED 0, VACUITY MEASURED 0\n") == true;
}

test every_way_to_be_unreadable_has_its_own_reason_and_writes_nothing {
    var work : [384]u32 = undefined;
    var out : [2048]u8 = undefined;
    var res : [12]u32 = undefined;
    assert lt_ratchet("{\n \"commit\": \"c\"\n}\n", LT_LEDGER, &work, LT_WORK, LT_WORK, &out, 2048, 5, &res) == 5;
    assert res[9] == LT_UNREADABLE;
    assert res[10] == LT_U_RUN or res[10] == LT_U_NO_RESULTS;
    const noref : string = "{\n \"results\": [\n  {\n   \"file\": \"a\",\n   \"t27b\": \"pass\",\n   \"reference\": \"blocked\"\n  }\n ]\n}\n";
    assert lt_ratchet(noref, LT_LEDGER, &work, LT_WORK, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_NO_REFERENCE;
    assert lt_ratchet(LT_RUN, "", &work, LT_WORK, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_NO_LEDGER;
    assert lt_ratchet(LT_RUN, "{\n \"entries\": [\n  not an object\n ]\n}\n", &work, LT_WORK, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_LEDGER;
    assert lt_ratchet(LT_RUN, "{\n \"entries\": [\n  {\"t27b\": \"pass\"}\n ]\n}\n", &work, LT_WORK, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_LEDGER;
    assert lt_ratchet(LT_RUN, "{\n \"source\": 5,\n \"entries\": []\n}\n", &work, LT_WORK, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_LEDGER;
    const bad : string = "{\n \"entries\": [\n  {\"path\": \"specs/a.t27\", \"t27b\": \"bogus\"}\n ]\n}\n";
    assert lt_ratchet(LT_RUN, bad, &work, LT_WORK, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_WORD;
    const esc : string = "{\n \"entries\": [\n  {\"path\": \"specs/\\q.t27\", \"t27b\": \"pass\"}\n ]\n}\n";
    assert lt_ratchet(LT_RUN, esc, &work, LT_WORK, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_LEDGER;
}

test a_table_that_is_too_wide_for_its_buffer_is_refused_not_cut {
    var work : [384]u32 = undefined;
    var out : [2048]u8 = undefined;
    var res : [12]u32 = undefined;
    assert lt_ratchet(LT_RUN, LT_LEDGER, &work, 1, LT_WORK, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_CAPACITY;
    assert lt_ratchet(LT_RUN, LT_LEDGER, &work, LT_WORK, 1, &out, 2048, 0, &res) == 0;
    assert res[10] == LT_U_CAPACITY;
    assert lt_ratchet(LT_RUN, LT_LEDGER, &work, 2, 2, &out, 2048, 0, &res) > 0;
    assert res[9] == LT_GREEN;
}

test a_clipped_output_still_advances_the_cursor {
    var work : [384]u32 = undefined;
    var out : [16]u8 = undefined;
    var res : [12]u32 = undefined;
    const w : usize = lt_ratchet(LT_RUN, LT_LEDGER, &work, LT_WORK, LT_WORK, &out, 16, 0, &res);
    assert w == 190;
    assert res[9] == LT_GREEN;
}

test a_json_character_is_one_of_five_shapes_and_a_bad_escape_is_none {
    assert lt_char("a", 0, 1) == 97 * 16 + 1;
    assert lt_char("\\n", 0, 2) == 10 * 16 + 2;
    assert lt_char("\\t", 0, 2) == 9 * 16 + 2;
    assert lt_char("\\r", 0, 2) == 13 * 16 + 2;
    assert lt_char("\\b", 0, 2) == 8 * 16 + 2;
    assert lt_char("\\f", 0, 2) == 12 * 16 + 2;
    assert lt_char("\\\"", 0, 2) == 34 * 16 + 2;
    assert lt_char("\\\\", 0, 2) == 92 * 16 + 2;
    assert lt_char("\\/", 0, 2) == 47 * 16 + 2;
    assert lt_char("\\u0041", 0, 6) == 65 * 16 + 6;
    assert lt_char("\\u00e9", 0, 6) == 233 * 16 + 6;
    assert lt_char("\\u00E9", 0, 6) == 233 * 16 + 6;
    assert lt_char("\\ud83d\\ude00", 0, 12) == 128512 * 16 + 12;
    assert lt_char("\\q", 0, 2) == 0;
    assert lt_char("\\u12", 0, 4) == 0;
    assert lt_char("\\u12g4", 0, 6) == 0;
    assert lt_char("\\ud83d", 0, 6) == 0;
    assert lt_char("\\ud83dx", 0, 7) == 0;
    assert lt_char("\\ude00", 0, 6) == 0;
    assert lt_char("\\ud83d\\u0041", 0, 12) == 0;
    assert lt_char("\\", 0, 1) == 0;
    assert lt_char("\xc3\xa9", 0, 2) == 233 * 16 + 2;
    assert lt_char("\xe4\xb8\xad", 0, 3) == 20013 * 16 + 3;
}

test json_strings_compare_cut_and_write_as_python_strings {
    assert lt_json_same("a\\u0062c", 0, 8, "abc", 0, 3) == true;
    assert lt_json_same("ab", 0, 2, "abc", 0, 3) == false;
    assert lt_json_same("abc", 0, 3, "ab", 0, 2) == false;
    assert lt_json_same("\\q", 0, 2, "\\q", 0, 2) == false;
    assert lt_json_same("", 0, 0, "", 0, 0) == true;
    assert lt_json_cmp("a", 0, 1, "b", 0, 1) == -1;
    assert lt_json_cmp("\\u00e9", 0, 6, "z", 0, 1) == 1;
    assert lt_json_cmp("ab", 0, 2, "abc", 0, 3) == -1;
    assert lt_json_cmp("abc", 0, 3, "ab", 0, 2) == 1;
    assert lt_json_cmp("a\\u0062", 0, 7, "ab", 0, 2) == 0;
    assert lt_json_cmp("\\q", 0, 2, "a", 0, 1) == 2;
    assert lt_json_cut("abcdef", 0, 6, 3) == 3;
    assert lt_json_cut("abcdef", 0, 6, 9) == 6;
    assert lt_json_cut("a\\u00e9\\ud83d\\ude00z", 0, 21, 3) == 19;
    assert lt_json_cut("a\\u00e9\\ud83d\\ude00z", 0, 21, 2) == 7;
    assert lt_json_cut("\\q", 0, 2, 1) == LAB_NO;
    assert lt_json_ok("fine \\u00e9", 0, 11) == true;
    assert lt_json_ok("bad \\q", 0, 6) == false;
    var out : [64]u8 = undefined;
    assert lx_out_is(&out, lt_put_json(&out, 64, 0, "a\\u00e9\\n", 0, 9, 99), "a\xc3\xa9\n") == true;
    assert lx_out_is(&out, lt_put_json(&out, 64, 0, "abcdef", 0, 6, 4), "abcd") == true;
    assert lx_out_is(&out, lt_put_json(&out, 64, 0, "\\ud83d\\ude00", 0, 12, 99), "\xf0\x9f\x98\x80") == true;
}

test repr_chooses_its_quote_and_escapes_as_python_does {
    var out : [64]u8 = undefined;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "bogus", 0, 5), "'bogus'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "it's", 0, 4), "\"it's\"") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "say \\\"hi\\\"", 0, 10), "'say \"hi\"'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "it's \\\"both\\\"", 0, 13), "'it\\'s \"both\"'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "a\\\\b", 0, 4), "'a\\\\b'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "a\\nb\\tc\\r", 0, 9), "'a\\nb\\tc\\r'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "\\u0001", 0, 6), "'\\x01'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "\\u00a0", 0, 6), "'\\xa0'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "\\u2028", 0, 6), "'\\u2028'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "\\u00e9", 0, 6), "'\xc3\xa9'") == true;
    assert lx_out_is(&out, lt_put_repr(&out, 64, 0, "", 0, 0), "''") == true;
}

test a_one_line_object_is_read_for_its_last_key_and_a_bad_line_is_not_read {
    var sp : [3]usize = undefined;
    const row : string = "{\"path\": \"x\", \"t27b\": \"pass\", \"n\": [1, {\"k\": \"}\"}], \"z\": 7, \"t27b\": \"fail\"},";
    assert lt_obj(row, 0, row.len, "t27b", &sp) == 1;
    assert sp[2] == 1;
    assert lab_same_span(row, sp[0], sp[1], "fail", 0, 4) == true;
    assert lt_obj(row, 0, row.len, "z", &sp) == 1;
    assert sp[2] == 0;
    assert lab_same_span(row, sp[0], sp[1], "7", 0, 1) == true;
    assert lt_obj(row, 0, row.len, "n", &sp) == 1;
    assert lab_same_span(row, sp[0], sp[1], "[1, {\"k\": \"}\"}]", 0, 15) == true;
    assert lt_obj(row, 0, row.len, "missing", &sp) == 0;
    assert lt_obj("{ \"a\" : 1 , \"b\" : \"x y\" }", 0, 25, "b", &sp) == 1;
    assert lt_obj("{}", 0, 2, "a", &sp) == 0;
    assert lt_obj("{\"a\": 1}  ", 0, 10, "a", &sp) == 1;
    assert lt_obj("not an object", 0, 13, "a", &sp) == 2;
    assert lt_obj("{\"a\" 1}", 0, 7, "a", &sp) == 2;
    assert lt_obj("{\"a\": \"unterminated}", 0, 20, "a", &sp) == 2;
    assert lt_obj("{\"a\": 1", 0, 7, "a", &sp) == 2;
    assert lt_obj("{\"a\": 1} x", 0, 10, "a", &sp) == 2;
    assert lt_obj("{\"a\": }", 0, 7, "a", &sp) == 2;
    assert lt_obj("{a: 1}", 0, 6, "a", &sp) == 2;
    assert lt_obj("{\"a\": 1,}", 0, 9, "a", &sp) == 2;
}

test a_cap_is_a_whole_number_that_is_not_negative {
    assert lt_cap_has("127", true, 0, 3, false) == true;
    assert lt_cap_has("0", true, 0, 1, false) == true;
    assert lt_cap_has("-0", true, 0, 2, false) == true;
    assert lt_cap_has("-1", true, 0, 2, false) == false;
    assert lt_cap_has("1.5", true, 0, 3, false) == false;
    assert lt_cap_has("1e2", true, 0, 3, false) == false;
    assert lt_cap_has("true", true, 0, 4, false) == false;
    assert lt_cap_has("null", true, 0, 4, false) == false;
    assert lt_cap_has("127", true, 0, 3, true) == false;
    assert lt_cap_has("", true, 0, 0, false) == false;
    assert lt_cap_has("127", false, 0, 3, false) == false;
}

test a_duplicate_path_keeps_the_last_row_and_the_rows_sort_by_decoded_path {
    var ent : [40]u32 = undefined;
    var ord : [8]u32 = undefined;
    const led : string = "{\n \"entries\": [\n  {\"path\": \"b\", \"t27b\": \"pass\"},\n  {\"path\": \"a\", \"t27b\": \"pass\"},\n  {\"path\": \"\\u0062\", \"t27b\": \"blocked\"},\n  {\"path\": \"\\u00e9\", \"t27b\": \"pass\"}\n ]\n}\n";
    assert lt_collect_entries(led, &ent, 8) == 4;
    assert ent[4] == 0;
    assert ent[9] == 1;
    assert ent[14] == 1;
    assert ent[19] == 1;
    assert lt_sort(led, &ent, 4, &ord) == 3;
    assert ord[0] == 1;
    assert ord[1] == 2;
    assert ord[2] == 3;
    assert lt_find(led, &ent, &ord, 3, "a", 0, 1) == 1;
    assert lt_find(led, &ent, &ord, 3, "b", 0, 1) == 2;
    assert lt_find(led, &ent, &ord, 3, "\xc3\xa9", 0, 2) == 3;
    assert lt_find(led, &ent, &ord, 3, "\\u00e9", 0, 6) == 3;
    assert lt_find(led, &ent, &ord, 3, "zz", 0, 2) == LAB_NO;
    assert lt_collect_entries("{\n}\n", &ent, 8) == 0;
    assert lt_collect_entries("{\n \"entries\": []\n}\n", &ent, 8) == 0;
}

test the_results_of_a_run_are_found_by_their_own_file_key_not_a_nested_one {
    var rt : [20]u32 = undefined;
    var flag : [1]u32 = [0];
    const run : string = "{\n \"results\": [\n  {\n   \"file\": \"a\",\n   \"test_verdicts\": {\n    \"file\": true\n   },\n   \"reference\": \"pass\"\n  },\n  {\n   \"file\": \"b\",\n   \"reference\": \"fail\"\n  }\n ]\n}\n";
    assert lt_collect_results(run, &rt, 4, &flag) == 2;
    assert flag[0] == 1;
    assert lab_same_span(run, rt[2] as usize, rt[3] as usize, "a", 0, 1) == true;
    assert lab_same_span(run, rt[7] as usize, rt[8] as usize, "b", 0, 1) == true;
    assert lt_collect_results(run, &rt, 1, &flag) == LAB_NO - 1;
    const nofile : string = "{\n \"results\": [\n  {\n   \"t27b\": \"pass\"\n  }\n ]\n}\n";
    assert lt_collect_results(nofile, &rt, 4, &flag) == LAB_NO;
}

test a_verdict_value_that_python_reads_as_false_is_missing_and_one_it_does_not_know_is_unknown {
    assert lt_word_of("pass", true, 0, 4, true) == 0;
    assert lt_word_of("", true, 0, 0, true) == T_MISSING;
    assert lt_word_of("", false, 0, 0, false) == T_MISSING;
    assert lt_word_of("null", true, 0, 4, false) == T_MISSING;
    assert lt_word_of("false", true, 0, 5, false) == T_MISSING;
    assert lt_word_of("0", true, 0, 1, false) == T_MISSING;
    assert lt_word_of("[]", true, 0, 2, false) == T_MISSING;
    assert lt_word_of("{}", true, 0, 2, false) == T_MISSING;
    assert lt_word_of("true", true, 0, 4, false) == LR_UNKNOWN;
    assert lt_word_of("5", true, 0, 1, false) == LR_UNKNOWN;
    assert lt_word_of("bogus", true, 0, 5, true) == LR_UNKNOWN;
    assert lt_word_of("not run", true, 0, 7, true) == 9;
    assert lt_slot(2) == 0;
    assert lt_slot(1) == 8;
    assert lt_slot(9) == 5;
    assert lt_slot(0) == 9;
}

// BEGIN GENERATED
// The table below was computed by running scripts/tri_loop/t27b.py ratchet (the checker lab.py calls) on each run
// document and ledger: runs written with json.dumps(indent=1) as lab.py writes them, ledgers with the checker's own
// dump_ledger, a few rows written by hand the way a person edits the ledger. For every case: its exit code (0 green,
// 1 red, 2 unreadable), the nine counts, the finding lines the command printed, and for the first RA_FULL_N cases
// the whole output including the summary line. Each run and each ledger is written once; a case names its two.

pub const RA_N : usize = 125;
pub const RA_FULL_N : usize = 12;
pub const RA_RUNS : [70]string = [
    "{\n \"lab\": \"t27b-lab\",\n \"commit\": \"891a9087afcbc45ca68c87c07a2e4ff0ae5db00c\",\n \"finished\": \"2026-10-19T01:07:28Z\",\n \"results\": [\n  {\n   \"file\": \"specs/a/one.t27\",\n   \"t27b\": \"pass\",\n   \"blockers\": [],\n   \"reference\": \"pass\"\n  },\n  {\n   \"file\": \"specs/b/two.t27\",\n   \"t27b\": \"blocked\",\n   \"blockers\": [\n    \"ExprCall(undeclared fn)\"\n   ],\n   \"reference\": \"pass\"\n  }\n ]\n}\n",
    "{\n \"commit\": \"891a9087afcbc45ca68c87c07a2e4ff0ae5db00c\",\n \"results\": [\n  {\n   \"file\": \"specs/a/one.t27\",\n   \"t27b\": \"pass\",\n   \"blockers\": [],\n   \"reference\": \"pass\"\n  },\n  {\n   \"file\": \"specs/b/two.t27\",\n   \"t27b\": \"pass_vacuous\",\n   \"blockers\": [],\n   \"reference\": \"pass\"\n  },\n  {\n   \"file\": \"specs/c/three.t27\",\n   \"t27b\": \"blocked\",\n   \"blockers\": [\n    \"ExprCall(undeclared fn)\"\n   ],\n   \"reference\": \"pass\"\n  }\n ]\n}\n",
