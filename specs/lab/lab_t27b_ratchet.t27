test the_ratchet_equals_the_pythons_checker_on_every_case {
    var work : [768]u32 = undefined;
    var out : [16384]u8 = undefined;
    var res : [12]u32 = undefined;
    var i : usize = 0;
    while (i < RA_N) {
        const w : usize = lt_ratchet(RA_RUNS[RA_RUN_AT[i]], RA_LEDGERS[RA_LED_AT[i]], &work, 64, 64, &out, 16384, 0, &res);
        assert res[9] == RA_STATUS[i];
        if (RA_STATUS[i] != 2) {
            var k : usize = 0;
            while (k < 9) {
                assert res[k] == RA_COUNTS[9 * i + k];
                k = k + 1;
            }
            assert res[11] == RA_NOTPASS[i];
            assert lx_out_is(&out, RA_FIND[i].len, RA_FIND[i]) == true;
            assert out[w - 1] == 10;
            assert out[RA_FIND[i].len] == 116;
            if (i < RA_FULL_N) {
                assert lx_out_is(&out, w, RA_FULL[i]) == true;
            }
        }
        i = i + 1;
    }
}
