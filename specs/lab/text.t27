// SPDX-License-Identifier: Apache-2.0
; specs/lab/text.t27 -- the byte-text readers the lab specs (plan, paths, verdict, prune) share (gHashTag/t27#11041, epic #11040)
; The t27c lab (infra/t27c-lab/lab.py) reads text a person or a command wrote: `git ls-remote` output, a gate's log,
; a request path. Python's own text rules decide what counts as a line, as blank, and as a character, and the lab's
; verdicts rest on them: str.splitlines() breaks on ten characters (not only LF), str.strip() and the regex `\s`
; strip thirty (the Unicode spaces), and `[:300]` counts characters, not bytes. This file reads those rules off
; Python 3.14 (python3 -c, every code point checked) and holds them once, as functions of a byte text.
; The text is UTF-8 bytes (the lab decodes a command's output with errors=replace before it reads it). A string is
; `string`: `.len` and `t[i]` as a u8. A span is a `from`/`to` pair of offsets into one text; nothing is copied until a
; writer puts bytes into a caller's buffer, and a writer returns the new cursor, which still advances when the
; buffer is full (the claw write idiom), so a short buffer tells how long the output is.
; The break and space sets:
;   line breaks   LF  CR  CR LF  VT  FF  FS  GS  RS  U+0085 (C2 85)  U+2028 (E2 80 A8)  U+2029 (E2 80 A9)
;   spaces        HT LF VT FF CR FS GS RS US SP  U+0085 U+00A0 U+1680 U+2000..U+200A U+2028 U+2029 U+202F U+205F U+3000
; Hand-written is this file; the lab's own Python is the oracle until the cutover (#11040).
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module LabText;

use tri::lab::receipt::span_is;

/// "No such position."
pub const LAB_NO : usize = 4294967295;

/// The most digits of a count the lab reads; a longer run is not a count (Python would read it, the lab's logs do not carry one).
pub const LAB_DEC_DIGITS : usize = 18;
/// "Not a decimal count."
pub const LAB_DEC_BAD : u64 = 18446744073709551615;

/// The length in bytes of the line break that starts at i (str.splitlines): 0 when none does.
pub fn lab_break_len(t: string, i: usize) -> usize {
    if (i >= t.len) { return 0; }
    const c : u8 = t[i];
    if (c == 13) {
        if (i + 1 < t.len and t[i + 1] == 10) { return 2; }
        return 1;
    }
    if (c == 10 or c == 11 or c == 12 or c == 28 or c == 29 or c == 30) { return 1; }
    if (c == 194 and i + 1 < t.len and t[i + 1] == 133) { return 2; }
    if (c == 226 and i + 2 < t.len and t[i + 1] == 128 and (t[i + 2] == 168 or t[i + 2] == 169)) { return 3; }
    return 0;
}

/// The end of the line that starts at s: the offset of its break, or t.len.
pub fn lab_line_end(t: string, s: usize) -> usize {
    var k : usize = s;
    while (k < t.len and lab_break_len(t, k) == 0) {
        k = k + 1;
    }
    return k;
}

/// Where the next line starts, given the end e of this one: past its break. A text that ends in a break has no
/// empty last line, as in Python: the loop `while s < t.len` stops there.
pub fn lab_line_next(t: string, e: usize) -> usize {
    return e + lab_break_len(t, e);
}

/// The length in bytes of the space (str.isspace) that starts at i, not reading past end: 0 when none does.
pub fn lab_space_len(t: string, i: usize, end: usize) -> usize {
    if (i >= end or i >= t.len) { return 0; }
    const c : u8 = t[i];
    if (c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31)) { return 1; }
    if (c == 194 and i + 1 < end and i + 1 < t.len and (t[i + 1] == 133 or t[i + 1] == 160)) { return 2; }
    if (i + 2 >= end or i + 2 >= t.len) { return 0; }
    const d : u8 = t[i + 1];
    const e : u8 = t[i + 2];
    if (c == 225 and d == 154 and e == 128) { return 3; }
    if (c == 226 and d == 128 and ((e >= 128 and e <= 138) or e == 168 or e == 169 or e == 175)) { return 3; }
    if (c == 226 and d == 129 and e == 159) { return 3; }
    if (c == 227 and d == 128 and e == 128) { return 3; }
    return 0;
}

/// The length of the space that ends at i, not reading before lo: 0 when none does.
pub fn lab_space_before(t: string, lo: usize, i: usize) -> usize {
    var n : usize = 1;
    while (n <= 3 and i >= lo + n) {
        if (lab_space_len(t, i - n, i) == n) { return n; }
        n = n + 1;
    }
    return 0;
}

/// Where text[from..to] starts once its leading spaces are stripped (str.lstrip).
pub fn lab_strip_from(t: string, from: usize, to: usize) -> usize {
    var k : usize = from;
    while (k < to) {
        const n : usize = lab_space_len(t, k, to);
        if (n == 0) { return k; }
        k = k + n;
    }
    return k;
}

/// Where text[from..to] ends once its trailing spaces are stripped (str.rstrip).
pub fn lab_strip_to(t: string, from: usize, to: usize) -> usize {
    var k : usize = to;
    while (k > from) {
        const n : usize = lab_space_before(t, from, k);
        if (n == 0) { return k; }
        k = k - n;
    }
    return k;
}

/// Does text[from..to] hold anything but spaces? (`ln.strip()` is truthy.)
pub fn lab_has_text(t: string, from: usize, to: usize) -> bool {
    return lab_strip_from(t, from, to) < to;
}

/// The length in bytes of the character (UTF-8) that starts at i, clipped at end; a stray continuation byte is one.
pub fn lab_char_len(t: string, i: usize, end: usize) -> usize {
    if (i >= end or i >= t.len) { return 0; }
    const c : u8 = t[i];
    var n : usize = 1;
    if (c >= 192 and c < 224) { n = 2; }
    if (c >= 224 and c < 240) { n = 3; }
    if (c >= 240) { n = 4; }
    var k : usize = 1;
    while (k < n and i + k < end and i + k < t.len and t[i + k] >= 128 and t[i + k] < 192) {
        k = k + 1;
    }
    return k;
}

/// The code point of the character that starts at i (see lab_char_len); a broken sequence is its first byte.
pub fn lab_char_val(t: string, i: usize, end: usize) -> u32 {
    const n : usize = lab_char_len(t, i, end);
    const c : u32 = t[i] as u32;
    if (n <= 1) { return c; }
    var v : u32 = c;
    var want : usize = 4;
    if (c < 224) { want = 2; v = c - 192; }
    if (c >= 224 and c < 240) { want = 3; v = c - 224; }
    if (c >= 240) { v = c - 240; }
    if (n != want) { return c; }
    var k : usize = 1;
    while (k < n) {
        v = v * 64 + ((t[i + k] as u32) - 128);
        k = k + 1;
    }
    return v;
}

/// The UTF-8 bytes of code point cp into dst at w, clipped at cap; the new cursor.
pub fn lab_put_char(dst: []u8, cap: usize, w: usize, cp: u32) -> usize {
    var b : [4]u8 = undefined;
    var n : usize = 1;
    if (cp < 128) {
        b[0] = cp as u8;
    } else {
        if (cp < 2048) {
            b[0] = (192 + cp / 64) as u8;
            b[1] = (128 + cp % 64) as u8;
            n = 2;
        } else {
            if (cp < 65536) {
                b[0] = (224 + cp / 4096) as u8;
                b[1] = (128 + (cp / 64) % 64) as u8;
                b[2] = (128 + cp % 64) as u8;
                n = 3;
            } else {
                b[0] = (240 + cp / 262144) as u8;
                b[1] = (128 + (cp / 4096) % 64) as u8;
                b[2] = (128 + (cp / 64) % 64) as u8;
                b[3] = (128 + cp % 64) as u8;
                n = 4;
            }
        }
    }
    var k : usize = 0;
    while (k < n) {
        if (w + k < cap) { dst[w + k] = b[k]; }
        k = k + 1;
    }
    return w + n;
}

/// The end of text[from..to] cut to at most n characters (Python's `s[:n]`).
pub fn lab_cut_chars(t: string, from: usize, to: usize, n: usize) -> usize {
    var k : usize = from;
    var seen : usize = 0;
    while (k < to and seen < n) {
        k = k + lab_char_len(t, k, to);
        seen = seen + 1;
    }
    return k;
}

/// Does lit start at offset i of text, without reading past `to`?
pub fn lab_lit_at(t: string, i: usize, to: usize, lit: string) -> bool {
    if (to > t.len or i + lit.len > to) { return false; }
    return span_is(t, i, i + lit.len, lit);
}

/// Does text[from..to] hold lit anywhere (`lit in s`)? The empty literal is in every span.
pub fn lab_has_lit(t: string, from: usize, to: usize, lit: string) -> bool {
    var k : usize = from;
    while (k + lit.len <= to) {
        if (lab_lit_at(t, k, to, lit)) { return true; }
        k = k + 1;
    }
    return false;
}

/// Is text[a_from..a_to] byte for byte text[b_from..b_to] of the second text?
pub fn lab_same_span(a: string, a_from: usize, a_to: usize, b: string, b_from: usize, b_to: usize) -> bool {
    if (a_to < a_from or b_to < b_from or a_to - a_from != b_to - b_from) { return false; }
    var k : usize = 0;
    while (a_from + k < a_to) {
        if (a[a_from + k] != b[b_from + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is t[tf..tt] byte for byte one of the lines of the set text? (A sha is `in` a set of shas; lines as splitlines() cuts them.)
pub fn lab_set_has(set: string, t: string, tf: usize, tt: usize) -> bool {
    var s : usize = 0;
    while (s < set.len) {
        const e : usize = lab_line_end(set, s);
        if (lab_same_span(set, s, e, t, tf, tt)) { return true; }
        s = lab_line_next(set, e);
    }
    return false;
}

/// Where text[a_from..a_to] sorts against text[b_from..b_to]: -1, 0 or 1, byte by byte (UTF-8 bytes sort as code points, as
/// Python's str does), a prefix before the longer text.
pub fn lab_span_cmp(a: string, a_from: usize, a_to: usize, b: string, b_from: usize, b_to: usize) -> i32 {
    var k : usize = 0;
    while (a_from + k < a_to and b_from + k < b_to) {
        const x : u8 = a[a_from + k];
        const y : u8 = b[b_from + k];
        if (x < y) { return -1; }
        if (x > y) { return 1; }
        k = k + 1;
    }
    if (a_to - a_from < b_to - b_from) { return -1; }
    if (a_to - a_from > b_to - b_from) { return 1; }
    return 0;
}

/// The first offset in text[from..to] of the byte c, or LAB_NO.
pub fn lab_find_byte(t: string, from: usize, to: usize, c: u8) -> usize {
    var k : usize = from;
    while (k < to and k < t.len) {
        if (t[k] == c) { return k; }
        k = k + 1;
    }
    return LAB_NO;
}

/// Is text[from..to] one or more ASCII digits, at most LAB_DEC_DIGITS of them?
pub fn lab_is_count(t: string, from: usize, to: usize) -> bool {
    if (to <= from or to - from > LAB_DEC_DIGITS) { return false; }
    var k : usize = from;
    while (k < to) {
        if (t[k] < 48 or t[k] > 57) { return false; }
        k = k + 1;
    }
    return true;
}

/// The count text[from..to] holds, or LAB_DEC_BAD when it is not a count (lab_is_count).
pub fn lab_count_of(t: string, from: usize, to: usize) -> u64 {
    if (lab_is_count(t, from, to) == false) { return LAB_DEC_BAD; }
    var n : u64 = 0;
    var k : usize = from;
    while (k < to) {
        n = n * 10 + ((t[k] as u64) - 48);
        k = k + 1;
    }
    return n;
}

/// Copy text[from..to] into dst at w, clipped at cap; the new cursor, which advances by the whole span.
pub fn lab_put_span(dst: []u8, cap: usize, w: usize, t: string, from: usize, to: usize) -> usize {
    var k : usize = from;
    while (k < to) {
        if (w + (k - from) < cap) { dst[w + (k - from)] = t[k]; }
        k = k + 1;
    }
    return w + (to - from);
}

/// Copy the literal lit into dst at w, clipped at cap; the new cursor.
pub fn lab_put_lit(dst: []u8, cap: usize, w: usize, lit: string) -> usize {
    return lab_put_span(dst, cap, w, lit, 0, lit.len);
}

/// The decimal digits of v into dst at w, clipped at cap; the new cursor. (claw::text put_count takes a u32; a lab count is a u64.)
pub fn lab_put_count(dst: []u8, cap: usize, w: usize, v: u64) -> usize {
    var digits : [20]u8 = undefined;
    var n : usize = 0;
    var x : u64 = v;
    if (x == 0) {
        digits[0] = 48;
        n = 1;
    }
    while (x > 0) {
        digits[n] = 48 + ((x % 10) as u8);
        n = n + 1;
        x = x / 10;
    }
    var k : usize = 0;
    while (k < n) {
        if (w + k < cap) { dst[w + k] = digits[n - 1 - k]; }
        k = k + 1;
    }
    return w + n;
}

// ---- tests: the rules read off Python 3.14 ----

/// A buffer of four zero bytes holding the UTF-8 of cp; the spans are read against its whole length.
fn lab_test_encode(b: []u8, cp: u32) -> usize {
    b[0] = 0;
    b[1] = 0;
    b[2] = 0;
    b[3] = 0;
    return lab_put_char(b, 4, 0, cp);
}

test the_ten_characters_python_breaks_lines_on_break_and_no_other {
    // python3 -c: [hex(c) for c in range(0x110000) if len(('a'+chr(c)+'b').splitlines()) > 1]
    var b : [4]u8 = undefined;
    var cp : u32 = 0;
    var breaks : u32 = 0;
    while (cp < 12544) {
        const n : usize = lab_test_encode(&b, cp);
        const k : usize = lab_break_len(&b, 0);
        if (k > 0) {
            breaks = breaks + 1;
            // A break is the whole character, never a part of one (CR alone is CR, its LF is not in the buffer).
            assert k == n;
            assert cp == 10 or cp == 11 or cp == 12 or cp == 13 or cp == 28 or cp == 29 or cp == 30 or cp == 133 or cp == 8232 or cp == 8233;
        }
        cp = cp + 1;
    }
    assert breaks == 10;
}

test the_twenty_nine_characters_python_calls_a_space_are_spaces_and_no_other {
    // python3 -c: [hex(c) for c in range(0x110000) if chr(c).isspace()] -- the same set the regex \s matches
    var b : [4]u8 = undefined;
    var cp : u32 = 0;
    var spaces : u32 = 0;
    while (cp < 12544) {
        const n : usize = lab_test_encode(&b, cp);
        const k : usize = lab_space_len(&b, 0, 4);
        if (k > 0) {
            spaces = spaces + 1;
            assert k == n;
            assert lab_space_before(&b, 0, n) == n;
        } else {
            assert lab_space_before(&b, 0, n) == 0;
        }
        cp = cp + 1;
    }
    assert spaces == 29;
}

test a_character_round_trips_through_its_utf8_bytes {
    var b : [4]u8 = undefined;
    var cp : u32 = 0;
    while (cp < 70000) {
        const n : usize = lab_test_encode(&b, cp);
        assert lab_char_len(&b, 0, 4) == n;
        assert lab_char_val(&b, 0, 4) == cp;
        cp = cp + 997;
    }
    assert lab_test_encode(&b, 65) == 1;
    assert lab_test_encode(&b, 233) == 2;
    assert lab_test_encode(&b, 8364) == 3;
    assert lab_test_encode(&b, 128512) == 4;
}

test a_line_ends_at_its_first_break_and_the_next_starts_past_it {
    assert lab_line_end("ab\ncd", 0) == 2;
    assert lab_line_next("ab\ncd", 2) == 3;
    assert lab_line_end("ab\ncd", 3) == 5;
    assert lab_line_next("ab\ncd", 5) == 5;
    assert lab_line_end("", 0) == 0;
    assert lab_line_end("\n", 0) == 0;
    assert lab_line_next("\n", 0) == 1;
    assert lab_line_end("ab", 7) == 7;
    var crlf : [4]u8 = undefined;
    crlf[0] = 97;
    crlf[1] = 13;
    crlf[2] = 10;
    crlf[3] = 98;
    assert lab_break_len(&crlf, 1) == 2;
    assert lab_line_end(&crlf, 0) == 1;
    assert lab_line_next(&crlf, 1) == 3;
    var cr : [3]u8 = undefined;
    cr[0] = 97;
    cr[1] = 13;
    cr[2] = 98;
    assert lab_break_len(&cr, 1) == 1;
    assert lab_line_next(&cr, 1) == 2;
    var nel : [4]u8 = undefined;
    nel[0] = 97;
    nel[1] = 194;
    nel[2] = 133;
    nel[3] = 98;
    assert lab_line_end(&nel, 0) == 1;
    assert lab_line_next(&nel, 1) == 3;
    // The lead byte of U+0085 at the very end of the text is not a break: it has no second byte.
    var cut : [2]u8 = undefined;
    cut[0] = 97;
    cut[1] = 194;
    assert lab_break_len(&cut, 1) == 0;
    assert lab_line_end(&cut, 0) == 2;
}

test strip_takes_the_unicode_spaces_off_both_ends {
    assert lab_strip_from("  ab ", 0, 5) == 2;
    assert lab_strip_to("  ab ", 0, 5) == 4;
    assert lab_strip_from("   ", 0, 3) == 3;
    assert lab_strip_to("   ", 0, 3) == 0;
    assert lab_strip_from("ab", 0, 2) == 0;
    assert lab_strip_to("ab", 0, 2) == 2;
    assert lab_strip_to("a b", 0, 3) == 3;
    assert lab_has_text("  x ", 0, 4) == true;
    assert lab_has_text("    ", 0, 4) == false;
    assert lab_has_text("", 0, 0) == false;
    assert lab_has_text("a", 1, 1) == false;
    // U+00A0 and U+3000 are spaces for strip(), U+200B (zero width space) is not.
    var b : [10]u8 = undefined;
    b[0] = 194;
    b[1] = 160;
    b[2] = 120;
    b[3] = 227;
    b[4] = 128;
    b[5] = 128;
    b[6] = 226;
    b[7] = 128;
    b[8] = 139;
    b[9] = 32;
    assert lab_strip_from(&b, 0, 10) == 2;
    assert lab_strip_to(&b, 0, 10) == 9;
    assert lab_has_text(&b, 0, 2) == false;
    assert lab_has_text(&b, 6, 9) == true;
}

test the_cut_counts_characters_not_bytes {
    assert lab_cut_chars("abcdef", 0, 6, 3) == 3;
    assert lab_cut_chars("abcdef", 0, 6, 0) == 0;
    assert lab_cut_chars("abcdef", 0, 6, 99) == 6;
    assert lab_cut_chars("abcdef", 2, 6, 2) == 4;
    assert lab_cut_chars("", 0, 0, 5) == 0;
    var b : [7]u8 = undefined;
    b[0] = 97;
    b[1] = 195;
    b[2] = 169;
    b[3] = 226;
    b[4] = 130;
    b[5] = 172;
    b[6] = 98;
    assert lab_cut_chars(&b, 0, 7, 1) == 1;
    assert lab_cut_chars(&b, 0, 7, 2) == 3;
    assert lab_cut_chars(&b, 0, 7, 3) == 6;
    assert lab_cut_chars(&b, 0, 7, 4) == 7;
    // A cut never ends inside a character, even when `to` does: the character is clipped at `to`.
    assert lab_cut_chars(&b, 0, 5, 3) == 5;
}

test a_literal_is_found_at_an_offset_or_anywhere_in_a_span {
    assert lab_lit_at("abcdef", 2, 6, "cd") == true;
    assert lab_lit_at("abcdef", 2, 6, "ce") == false;
    assert lab_lit_at("abcdef", 4, 6, "efg") == false;
    assert lab_lit_at("abcdef", 4, 5, "ef") == false;
    assert lab_lit_at("abcdef", 0, 99, "a") == false;
    assert lab_has_lit("a pair(s) are silent", 0, 20, "pair(s) are silent") == true;
    assert lab_has_lit("a pair(s) are silent", 0, 19, "pair(s) are silent") == false;
    assert lab_has_lit("abc", 0, 3, "") == true;
    assert lab_has_lit("", 0, 0, "") == true;
    assert lab_has_lit("abc", 0, 3, "abcd") == false;
    assert lab_has_lit("abcabd", 1, 6, "abd") == true;
    assert lab_has_lit("abcabd", 1, 5, "abd") == false;
}

test two_spans_are_the_same_text_or_not {
    assert lab_same_span("abc", 0, 3, "xabc", 1, 4) == true;
    assert lab_same_span("abc", 0, 3, "xabd", 1, 4) == false;
    assert lab_same_span("abc", 0, 2, "abc", 0, 3) == false;
    assert lab_same_span("", 0, 0, "", 0, 0) == true;
    assert lab_same_span("abc", 2, 1, "abc", 2, 1) == false;
    assert lab_set_has("a\nbc\nd", "xbcx", 1, 3) == true;
    assert lab_set_has("a\nbc\nd", "xbcx", 1, 2) == false;
    assert lab_set_has("a\nbc\nd", "d", 0, 1) == true;
    assert lab_set_has("a\nbc\nd\n", "", 0, 0) == false;
    assert lab_set_has("a\n\nd", "", 0, 0) == true;
    assert lab_set_has("", "a", 0, 1) == false;
    assert lab_set_has("", "", 0, 0) == false;
    assert lab_span_cmp("abc", 0, 3, "abd", 0, 3) == -1;
    assert lab_span_cmp("abd", 0, 3, "abc", 0, 3) == 1;
    assert lab_span_cmp("abc", 0, 3, "xabc", 1, 4) == 0;
    assert lab_span_cmp("ab", 0, 2, "abc", 0, 3) == -1;
    assert lab_span_cmp("abc", 0, 3, "ab", 0, 2) == 1;
    assert lab_span_cmp("", 0, 0, "", 0, 0) == 0;
    assert lab_span_cmp("", 0, 0, "a", 0, 1) == -1;
    assert lab_span_cmp("B", 0, 1, "a", 0, 1) == -1;
    assert lab_find_byte("a\tb", 0, 3, 9) == 1;
    assert lab_find_byte("a\tb", 2, 3, 9) == LAB_NO;
    assert lab_find_byte("a\tb", 0, 1, 9) == LAB_NO;
    assert lab_find_byte("", 0, 0, 9) == LAB_NO;
}

test a_count_is_one_to_eighteen_ascii_digits {
    assert lab_count_of("12", 0, 2) == 12;
    assert lab_count_of("x007y", 1, 4) == 7;
    assert lab_count_of("0", 0, 1) == 0;
    assert lab_count_of("999999999999999999", 0, 18) == 999999999999999999;
    assert lab_count_of("1000000000000000000", 0, 19) == LAB_DEC_BAD;
    assert lab_count_of("", 0, 0) == LAB_DEC_BAD;
    assert lab_count_of("1a", 0, 2) == LAB_DEC_BAD;
    assert lab_count_of("-1", 0, 2) == LAB_DEC_BAD;
    assert lab_count_of(" 1", 0, 2) == LAB_DEC_BAD;
    assert lab_is_count("123", 0, 3) == true;
    assert lab_is_count("123", 0, 0) == false;
}

test the_writers_return_the_cursor_and_clip_at_the_cap {
    var out : [12]u8 = undefined;
    var w : usize = lab_put_lit(&out, 12, 0, "ab");
    assert w == 2;
    w = lab_put_span(&out, 12, w, "xxcdxx", 2, 4);
    assert w == 4;
    w = lab_put_count(&out, 12, w, 0);
    w = lab_put_count(&out, 12, w, 1050);
    w = lab_put_count(&out, 12, w, 18446744073709551615);
    assert w == 4 + 1 + 4 + 20;
    assert span_is(&out, 0, 12, "abcd01050184");
    var tiny : [3]u8 = undefined;
    // A full buffer drops the bytes but not the count: the caller reads the length it would need.
    assert lab_put_lit(&tiny, 3, 0, "abcdef") == 6;
    assert span_is(&tiny, 0, 3, "abc");
    assert lab_put_count(&tiny, 3, 2, 12345) == 7;
    assert lab_put_span(&tiny, 3, 9, "abc", 1, 3) == 11;
    var chars : [8]u8 = undefined;
    assert lab_put_char(&chars, 8, 0, 233) == 2;
    assert lab_put_char(&chars, 8, 2, 8364) == 5;
    assert lab_put_char(&chars, 8, 5, 128512) == 9;
    assert chars[0] == 195 and chars[1] == 169 and chars[2] == 226 and chars[4] == 172 and chars[5] == 240;
}
