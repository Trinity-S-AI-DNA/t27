// SPDX-License-Identifier: Apache-2.0
; specs/lab/plan.t27 -- which commits the t27c lab runs next, decided from `git ls-remote` (gHashTag/t27#11041, epic #11040)
; The t27c lab (infra/t27c-lab/lab.py) polls the repository's heads, keeps the branches its T27_WATCH globs match, and queues
; every commit it has not run and has not queued, one entry per commit with all the branches that point at it. This file is
; that decision as pure functions of text, one per Python function, the Python being the oracle until the cutover:
;   watched(branch, globs)           lab_watched      the index of the first glob a branch matches (fnmatch.fnmatchcase)
;   parse_heads(ls_remote)           lab_parse_heads  `git ls-remote --heads` text -> the heads, as text
;   plan(heads, globs, done, queued) lab_plan         the new work, in glob order then branch name
;   stale_dropped(queue, heads)      lab_stale_dropped  the queue minus commits no watched branch points at, unless asked for
;   "master" in item["branches"]     lab_item_has_branch  (run_item(): whether the seal refresh of a master commit is due)
; It names no host: the plan of the next gates is the same wherever they run (one lab, or any node that takes a lab job, #11043).
; THE TEXTS. A dict, a set and a list are text here, so a caller that holds none of Python's types (the runtime of #11040
; is generated from specs) passes what it read:
;   globs   the T27_WATCH text itself: globs separated by `,`, each stripped, an empty one dropped (the lab builds its list
;           that way, so a list the lab can hold is a text this reads; a glob has no comma in it). Its index is the position
;           among the non-empty ones.
;   heads   one head per line, `<branch> TAB <sha>`, in the order a dict holds them, a branch on one line only (a dict has a key
;           once). lab_parse_heads writes it; a branch name has no TAB or line break (git refuses them), so the text round-trips.
;   done, queued   a set of shas, one per line. A sha is in the set when a line is byte for byte that sha.
;   queue   one entry per line, `<sha>` or `<sha> TAB asked` (an entry someone asked for by hand).
;   plan    one item per line, `<sha> TAB <branch> TAB <branch> ...`, the branches in order.
; The writers return the new cursor of the caller's buffer and count a byte that does not fit without writing it. The
; plan is LAB_NO when a glob of the watch text is one this port refuses (below).
; FNMATCH. `fnmatch.fnmatchcase(name, glob)` is read off Python 3.14's translate(): `*` matches any run of characters
; (`/` and a line break too), `?` one character, `[seq]` one of the characters of seq, `[!seq]` any other, `a-z` a range,
; a `]` first in seq is itself, a `-` first or last is itself, an unclosed `[` is itself, and every other character is
; itself. A character is a code point, not a byte. Not ported: a range that runs backwards (`[z-a]`). Python turns it into
; a class that drops both ends, and a second range after it can change which ends; the lab's globs (`master`,
; `claude/t27c-*`) have none, so a glob with one is REFUSED (lab_fnmatch returns LAB_FN_REFUSED, lab_watched LAB_WATCH_BAD,
; lab_plan LAB_NO) rather than answered differently from Python. A refused glob is a configuration error to report.
; DICT ORDER AND DUPLICATES. A dict keeps a key where it first appeared and the value that came last, so a branch listed
; twice by ls-remote (git does not do it) is read once, in its first place, with its last sha. plan() does not depend on the
; order of its heads, only on which branch points at which sha.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module LabPlan;

use tri::lab::receipt::span_is;
use lab::text::LAB_NO;
use lab::text::lab_line_end;
use lab::text::lab_line_next;
use lab::text::lab_find_byte;
use lab::text::lab_strip_from;
use lab::text::lab_strip_to;
use lab::text::lab_char_len;
use lab::text::lab_char_val;
use lab::text::lab_same_span;
use lab::text::lab_set_has;
use lab::text::lab_span_cmp;
use lab::text::lab_lit_at;
use lab::text::lab_put_span;
use lab::text::lab_put_lit;
use lab::paths::lab_is_sha;

/// What a glob says of a name.
pub const LAB_FN_NO : u8 = 0;
pub const LAB_FN_YES : u8 = 1;
pub const LAB_FN_REFUSED : u8 = 2;

/// watched(): no glob matched.
pub const LAB_WATCH_NONE : usize = 4294967295;
/// watched(): a glob of the text is one this port refuses.
pub const LAB_WATCH_BAD : usize = 4294967294;

/// The prefix of a branch's ref in `git ls-remote --heads`.
pub const LAB_HEADS_PREFIX : string = "refs/heads/";

/// Where the class that opens at pat[p] (a `[`) closes: the offset of its `]`, or LAB_NO when the `[` is a plain character.
pub fn lab_class_close(pat: string, p: usize, pt: usize) -> usize {
    var j : usize = p + 1;
    if (j < pt and pat[j] == 33) { j = j + 1; }
    if (j < pt and pat[j] == 93) { j = j + 1; }
    while (j < pt and pat[j] != 93) {
        j = j + 1;
    }
    if (j >= pt) { return LAB_NO; }
    return j;
}

/// The offset where the characters of a class begin: past the `[` and a `!`.
pub fn lab_class_first(pat: string, p: usize) -> usize {
    if (pat[p + 1] == 33) { return p + 2; }
    return p + 1;
}

/// Does the class pat[p..j] hold a range that runs backwards (the first end above the last)?
pub fn lab_class_backwards(pat: string, p: usize, j: usize) -> bool {
    var k : usize = lab_class_first(pat, p);
    while (k < j) {
        const k1 : usize = k + lab_char_len(pat, k, j);
        if (k1 + 1 < j and pat[k1] == 45) {
            if (lab_char_val(pat, k, j) > lab_char_val(pat, k1 + 1, j)) { return true; }
            k = k1 + 1 + lab_char_len(pat, k1 + 1, j);
        } else {
            k = k1;
        }
    }
    return false;
}

/// Does the class pat[p..j] take the character whose code point is c? (A class with no backwards range.)
pub fn lab_class_takes(pat: string, p: usize, j: usize, c: u32) -> bool {
    var hit : bool = false;
    var k : usize = lab_class_first(pat, p);
    while (k < j) {
        const c0 : u32 = lab_char_val(pat, k, j);
        const k1 : usize = k + lab_char_len(pat, k, j);
        if (k1 + 1 < j and pat[k1] == 45) {
            const c1 : u32 = lab_char_val(pat, k1 + 1, j);
            if (c >= c0 and c <= c1) { hit = true; }
            k = k1 + 1 + lab_char_len(pat, k1 + 1, j);
        } else {
            if (c == c0) { hit = true; }
            k = k1;
        }
    }
    if (pat[p + 1] == 33) { return hit == false; }
    return hit;
}

/// Is every class of the glob pat[pf..pt] one this port reads?
pub fn lab_glob_ok(pat: string, pf: usize, pt: usize) -> bool {
    var p : usize = pf;
    while (p < pt) {
        var step : usize = lab_char_len(pat, p, pt);
        if (pat[p] == 91) {
            const j : usize = lab_class_close(pat, p, pt);
            if (j != LAB_NO) {
                if (lab_class_backwards(pat, p, j)) { return false; }
                step = j + 1 - p;
            }
        }
        p = p + step;
    }
    return true;
}

/// How many bytes of the glob the element at pat[p] takes when it matches the character at s[i]; 0 when it does not.
pub fn lab_glob_step(pat: string, p: usize, pt: usize, s: string, i: usize, st: usize) -> usize {
    const c : u8 = pat[p];
    if (c == 63) { return 1; }
    if (c == 91) {
        const j : usize = lab_class_close(pat, p, pt);
        if (j != LAB_NO) {
            if (lab_class_takes(pat, p, j, lab_char_val(s, i, st))) { return j + 1 - p; }
            return 0;
        }
    }
    const n : usize = lab_char_len(pat, p, pt);
    if (lab_char_len(s, i, st) == n and lab_same_span(pat, p, p + n, s, i, i + n)) { return n; }
    return 0;
}

/// Does the glob pat[pf..pt] match all of s[sf..st]? (A glob lab_glob_ok accepts.) `*` is tried at the earliest place first and
/// moved right only when what follows fails, which finds a match exactly when there is one.
pub fn lab_glob_match(pat: string, pf: usize, pt: usize, s: string, sf: usize, st: usize) -> bool {
    var p : usize = pf;
    var i : usize = sf;
    var star : usize = LAB_NO;
    var mark : usize = sf;
    var state : u8 = 0;
    while (state == 0) {
        if (p < pt and pat[p] == 42) {
            while (p < pt and pat[p] == 42) {
                p = p + 1;
            }
            star = p;
            mark = i;
        } else {
            var stepped : bool = false;
            if (p < pt and i < st) {
                const step : usize = lab_glob_step(pat, p, pt, s, i, st);
                if (step > 0) {
                    p = p + step;
                    i = i + lab_char_len(s, i, st);
                    stepped = true;
                }
            }
            if (stepped == false) {
                if (p == pt and i == st) {
                    state = 1;
                } else {
                    if (star != LAB_NO and mark < st) {
                        mark = mark + lab_char_len(s, mark, st);
                        i = mark;
                        p = star;
                    } else {
                        state = 2;
                    }
                }
            }
        }
    }
    return state == 1;
}

/// fnmatch.fnmatchcase(s[sf..st], pat[pf..pt]): YES, NO, or REFUSED for a glob this port does not read.
pub fn lab_fnmatch(pat: string, pf: usize, pt: usize, s: string, sf: usize, st: usize) -> u8 {
    if (lab_glob_ok(pat, pf, pt) == false) { return LAB_FN_REFUSED; }
    if (lab_glob_match(pat, pf, pt, s, sf, st)) { return LAB_FN_YES; }
    return LAB_FN_NO;
}

/// Does every glob of the watch text read? (None is refused.)
pub fn lab_watch_ok(watch: string) -> bool {
    var s : usize = 0;
    while (s <= watch.len) {
        var e : usize = lab_find_byte(watch, s, watch.len, 44);
        if (e == LAB_NO) { e = watch.len; }
        const f : usize = lab_strip_from(watch, s, e);
        const t : usize = lab_strip_to(watch, f, e);
        if (f < t and lab_glob_ok(watch, f, t) == false) { return false; }
        s = e + 1;
    }
    return true;
}

/// watched(branch, globs): the index of the first glob the branch matches, LAB_WATCH_NONE when none does, LAB_WATCH_BAD when a
/// glob it had to try is refused. The globs are the watch text; the branch is name[nf..nt].
pub fn lab_watched(name: string, nf: usize, nt: usize, watch: string) -> usize {
    var idx : usize = 0;
    var s : usize = 0;
    while (s <= watch.len) {
        var e : usize = lab_find_byte(watch, s, watch.len, 44);
        if (e == LAB_NO) { e = watch.len; }
        const f : usize = lab_strip_from(watch, s, e);
        const t : usize = lab_strip_to(watch, f, e);
        if (f < t) {
            const r : u8 = lab_fnmatch(watch, f, t, name, nf, nt);
            if (r == LAB_FN_YES) { return idx; }
            if (r == LAB_FN_REFUSED) { return LAB_WATCH_BAD; }
            idx = idx + 1;
        }
        s = e + 1;
    }
    return LAB_WATCH_NONE;
}

/// The offset in `ls` of the branch of the line ls[s..e] when it is a head, LAB_NO when the line is not one: exactly one TAB, a
/// 40-hex sha before it, and `refs/heads/` after it. The sha is ls[s..branch - 12], the branch is ls[branch..e].
pub fn lab_ls_branch(ls: string, s: usize, e: usize) -> usize {
    const tab : usize = lab_find_byte(ls, s, e, 9);
    if (tab == LAB_NO) { return LAB_NO; }
    if (lab_find_byte(ls, tab + 1, e, 9) != LAB_NO) { return LAB_NO; }
    if (lab_is_sha(ls, s, tab) == false) { return LAB_NO; }
    if (lab_lit_at(ls, tab + 1, e, LAB_HEADS_PREFIX) == false) { return LAB_NO; }
    return tab + 1 + LAB_HEADS_PREFIX.len;
}

/// parse_heads(ls_remote): the heads of `git ls-remote --heads` text, one `<branch> TAB <sha>` line each, as a dict holds them
/// (a branch in its first place with its last sha). Writes into dst at w, clipped at cap; the new cursor.
pub fn lab_parse_heads(ls: string, dst: []u8, cap: usize, w: usize) -> usize {
    var x : usize = w;
    var s : usize = 0;
    while (s < ls.len) {
        const e : usize = lab_line_end(ls, s);
        const b : usize = lab_ls_branch(ls, s, e);
        if (b != LAB_NO) {
            var first : bool = true;
            var last : usize = s;
            var le : usize = e;
            var k : usize = 0;
            while (k < ls.len) {
                const ke : usize = lab_line_end(ls, k);
                const kb : usize = lab_ls_branch(ls, k, ke);
                if (kb != LAB_NO and lab_same_span(ls, kb, ke, ls, b, e)) {
                    if (k < s) { first = false; }
                    if (k >= s) { last = k; le = ke; }
                }
                k = lab_line_next(ls, ke);
            }
            if (first) {
                const lb : usize = lab_ls_branch(ls, last, le);
                x = lab_put_span(dst, cap, x, ls, b, e);
                x = lab_put_lit(dst, cap, x, "\t");
                x = lab_put_span(dst, cap, x, ls, last, lb - 1 - LAB_HEADS_PREFIX.len);
                x = lab_put_lit(dst, cap, x, "\n");
            }
        }
        s = lab_line_next(ls, e);
    }
    return x;
}

/// The watch rank of the head on line heads[s..e] when it is new work: the branch is watched, its sha is neither done nor
/// queued. LAB_NO otherwise, or when the line has no TAB.
pub fn lab_head_rank(heads: string, s: usize, e: usize, watch: string, done: string, queued: string) -> usize {
    const tab : usize = lab_find_byte(heads, s, e, 9);
    if (tab == LAB_NO) { return LAB_NO; }
    const rank : usize = lab_watched(heads, s, tab, watch);
    if (rank == LAB_WATCH_NONE or rank == LAB_WATCH_BAD) { return LAB_NO; }
    if (lab_set_has(done, heads, tab + 1, e) or lab_set_has(queued, heads, tab + 1, e)) { return LAB_NO; }
    return rank;
}

/// The lowest watch rank among the new heads that point at the sha heads[sf..st]; LAB_NO when none is new work.
pub fn lab_group_rank(heads: string, sf: usize, st: usize, watch: string, done: string, queued: string) -> usize {
    var best : usize = LAB_NO;
    var s : usize = 0;
    while (s < heads.len) {
        const e : usize = lab_line_end(heads, s);
        const tab : usize = lab_find_byte(heads, s, e, 9);
        if (tab != LAB_NO and lab_same_span(heads, tab + 1, e, heads, sf, st)) {
            const r : usize = lab_head_rank(heads, s, e, watch, done, queued);
            if (r != LAB_NO and (best == LAB_NO or r < best)) { best = r; }
        }
        s = lab_line_next(heads, e);
    }
    return best;
}

/// Is the head on line heads[s..e] (new work) the one whose branch sorts first among the new heads of its sha?
pub fn lab_group_first(heads: string, s: usize, e: usize, watch: string, done: string, queued: string) -> bool {
    const tab : usize = lab_find_byte(heads, s, e, 9);
    var k : usize = 0;
    while (k < heads.len) {
        const ke : usize = lab_line_end(heads, k);
        const kt : usize = lab_find_byte(heads, k, ke, 9);
        if (kt != LAB_NO and k != s and lab_same_span(heads, kt + 1, ke, heads, tab + 1, e)) {
            if (lab_head_rank(heads, k, ke, watch, done, queued) != LAB_NO and lab_span_cmp(heads, k, kt, heads, s, tab) < 0) { return false; }
        }
        k = lab_line_next(heads, ke);
    }
    return true;
}

/// Does item (rank a, first branch on line a) come before item (rank b, line b) in the plan: the lower rank, then the lower branch?
pub fn lab_item_before(heads: string, a_rank: usize, a_s: usize, b_rank: usize, b_s: usize) -> bool {
    if (a_rank != b_rank) { return a_rank < b_rank; }
    const a_t : usize = lab_find_byte(heads, a_s, heads.len, 9);
    const b_t : usize = lab_find_byte(heads, b_s, heads.len, 9);
    return lab_span_cmp(heads, a_s, a_t, heads, b_s, b_t) < 0;
}

/// The line of the item that comes right after the one on line `last` (the first item when have_last is false): LAB_NO at the end.
pub fn lab_plan_next(heads: string, watch: string, done: string, queued: string, have_last: bool, last: usize) -> usize {
    var last_rank : usize = 0;
    if (have_last) {
        const lt : usize = lab_find_byte(heads, last, heads.len, 9);
        const le : usize = lab_line_end(heads, last);
        last_rank = lab_group_rank(heads, lt + 1, le, watch, done, queued);
    }
    var best : usize = LAB_NO;
    var best_rank : usize = 0;
    var s : usize = 0;
    while (s < heads.len) {
        const e : usize = lab_line_end(heads, s);
        if (lab_head_rank(heads, s, e, watch, done, queued) != LAB_NO and lab_group_first(heads, s, e, watch, done, queued)) {
            const tab : usize = lab_find_byte(heads, s, e, 9);
            const rank : usize = lab_group_rank(heads, tab + 1, e, watch, done, queued);
            var later : bool = true;
            if (have_last) { later = lab_item_before(heads, last_rank, last, rank, s); }
            if (later and (best == LAB_NO or lab_item_before(heads, rank, s, best_rank, best))) {
                best = s;
                best_rank = rank;
            }
        }
        s = lab_line_next(heads, e);
    }
    return best;
}

/// The line of the branch of the item (the sha heads[sf..st]) that follows the one on line `prev`, in branch order: LAB_NO at the end.
pub fn lab_item_branch_next(heads: string, sf: usize, st: usize, watch: string, done: string, queued: string, have_prev: bool, prev: usize) -> usize {
    var prev_t : usize = 0;
    if (have_prev) { prev_t = lab_find_byte(heads, prev, heads.len, 9); }
    var best : usize = LAB_NO;
    var best_t : usize = 0;
    var s : usize = 0;
    while (s < heads.len) {
        const e : usize = lab_line_end(heads, s);
        const tab : usize = lab_find_byte(heads, s, e, 9);
        if (tab != LAB_NO and lab_same_span(heads, tab + 1, e, heads, sf, st) and lab_head_rank(heads, s, e, watch, done, queued) != LAB_NO) {
            var after : bool = true;
            if (have_prev) { after = lab_span_cmp(heads, prev, prev_t, heads, s, tab) < 0; }
            if (after and (best == LAB_NO or lab_span_cmp(heads, s, tab, heads, best, best_t) < 0)) {
                best = s;
                best_t = tab;
            }
        }
        s = lab_line_next(heads, e);
    }
    return best;
}

/// plan(heads, globs, done, queued): one line per new commit, `<sha> TAB <branch> TAB <branch>...`, in watch order and then branch
/// order, into dst at w, clipped at cap; the new cursor. LAB_NO when the watch text has a glob this port refuses.
pub fn lab_plan(heads: string, watch: string, done: string, queued: string, dst: []u8, cap: usize, w: usize) -> usize {
    if (lab_watch_ok(watch) == false) { return LAB_NO; }
    var x : usize = w;
    var have : bool = false;
    var cur : usize = 0;
    while (true) {
        const s : usize = lab_plan_next(heads, watch, done, queued, have, cur);
        if (s == LAB_NO) { return x; }
        const e : usize = lab_line_end(heads, s);
        const tab : usize = lab_find_byte(heads, s, e, 9);
        x = lab_put_span(dst, cap, x, heads, tab + 1, e);
        var have_b : bool = false;
        var b : usize = 0;
        while (true) {
            const nb : usize = lab_item_branch_next(heads, tab + 1, e, watch, done, queued, have_b, b);
            if (nb == LAB_NO) { break; }
            const nt : usize = lab_find_byte(heads, nb, heads.len, 9);
            x = lab_put_lit(dst, cap, x, "\t");
            x = lab_put_span(dst, cap, x, heads, nb, nt);
            have_b = true;
            b = nb;
        }
        x = lab_put_lit(dst, cap, x, "\n");
        have = true;
        cur = s;
    }
    return x;
}

/// run_item(): `"master" in item["branches"]` for a plan line item[s..e] (`<sha> TAB <branch> TAB <branch>...`): is `branch` one of
/// the branches after the sha?
pub fn lab_item_has_branch(item: string, s: usize, e: usize, branch: string) -> bool {
    var f : usize = lab_find_byte(item, s, e, 9);
    while (f != LAB_NO and f < e) {
        var t : usize = lab_find_byte(item, f + 1, e, 9);
        if (t == LAB_NO) { t = e; }
        if (span_is(item, f + 1, t, branch)) { return true; }
        f = lab_find_byte(item, t, e, 9);
    }
    return false;
}

/// stale_dropped(queue, heads): the queue's lines whose sha some head points at, or that were asked for by hand (`<sha> TAB asked`),
/// in order, one per line, into dst at w, clipped at cap; the new cursor.
pub fn lab_stale_dropped(queue: string, heads: string, dst: []u8, cap: usize, w: usize) -> usize {
    var x : usize = w;
    var s : usize = 0;
    while (s < queue.len) {
        const e : usize = lab_line_end(queue, s);
        var sha_to : usize = lab_find_byte(queue, s, e, 9);
        var asked : bool = false;
        if (sha_to == LAB_NO) {
            sha_to = e;
        } else {
            asked = span_is(queue, sha_to + 1, e, "asked");
        }
        var live : bool = false;
        var h : usize = 0;
        while (h < heads.len and live == false) {
            const he : usize = lab_line_end(heads, h);
            const ht : usize = lab_find_byte(heads, h, he, 9);
            if (ht != LAB_NO and lab_same_span(heads, ht + 1, he, queue, s, sha_to)) { live = true; }
            h = lab_line_next(heads, he);
        }
        if (asked or live) {
            x = lab_put_span(dst, cap, x, queue, s, e);
            x = lab_put_lit(dst, cap, x, "\n");
        }
        s = lab_line_next(queue, e);
    }
    return x;
}

// ---- tests ----
// The oracle is infra/t27c-lab/lab.py. Every case below is its answer (Python 3.14.6), pinned: first the asserts of its
// self_check(), one to one, then tables of inputs run through its own functions (fnmatch.fnmatchcase as `watched` calls it,
// parse_heads, plan, stale_dropped).

/// The names the fnmatch rows are read against, one per line (the empty one is the empty line).
const LAB_TEST_NAMES : string = "master\nmain\nclaude/t27c-x\nclaude/t27c-\nclaude/lab\nclaude/a-b\nclaude/gen-zig-discard-call\na\nab\nabc\naxb\naxxb\nb\nx\nxx\n\n-\n]\n[\n[a\na]\n^\n\\\na\\b\nt27\nt270\nt27c\na/b/c\na/b\n/\n//\n a\na \n!\n!a\na-b\nc-e\ne\nd";

/// One glob against every name of LAB_TEST_NAMES: the answers as a row of 1 (match) and 0 (no match).
fn lab_test_fn_row(pat: string, want: string) -> bool {
    var s : usize = 0;
    var k : usize = 0;
    while (s < LAB_TEST_NAMES.len) {
        const e : usize = lab_line_end(LAB_TEST_NAMES, s);
        const r : u8 = lab_fnmatch(pat, 0, pat.len, LAB_TEST_NAMES, s, e);
        if (k >= want.len) { return false; }
        if (r == LAB_FN_YES and want[k] != 49) { return false; }
        if (r == LAB_FN_NO and want[k] != 48) { return false; }
        if (r == LAB_FN_REFUSED) { return false; }
        k = k + 1;
        s = lab_line_next(LAB_TEST_NAMES, e);
    }
    return k == want.len;
}

/// One watch text against every name: the index of the glob each matches as a digit, n for none.
fn lab_test_watch_row(watch: string, want: string) -> bool {
    var s : usize = 0;
    var k : usize = 0;
    while (s < LAB_TEST_NAMES.len) {
        const e : usize = lab_line_end(LAB_TEST_NAMES, s);
        const r : usize = lab_watched(LAB_TEST_NAMES, s, e, watch);
        if (k >= want.len) { return false; }
        if (r == LAB_WATCH_NONE and want[k] != 110) { return false; }
        if (r < 10 and want[k] != 48 + (r as u8)) { return false; }
        if (r != LAB_WATCH_NONE and r >= 10) { return false; }
        k = k + 1;
        s = lab_line_next(LAB_TEST_NAMES, e);
    }
    return k == want.len;
}

fn lab_test_watched(name: string, watch: string) -> usize {
    return lab_watched(name, 0, name.len, watch);
}

fn lab_test_heads(ls: string, want: string) -> bool {
    var out : [2048]u8 = undefined;
    const w : usize = lab_parse_heads(ls, &out, 2048, 0);
    return w == want.len and span_is(&out, 0, w, want);
}

fn lab_test_plan(heads: string, watch: string, done: string, queued: string, want: string) -> bool {
    var out : [2048]u8 = undefined;
    const w : usize = lab_plan(heads, watch, done, queued, &out, 2048, 0);
    return w == want.len and span_is(&out, 0, w, want);
}

fn lab_test_item_has(item: string, branch: string, want: bool) -> bool {
    return lab_item_has_branch(item, 0, item.len, branch) == want;
}

fn lab_test_stale(queue: string, heads: string, want: string) -> bool {
    var out : [2048]u8 = undefined;
    const w : usize = lab_stale_dropped(queue, heads, &out, 2048, 0);
    return w == want.len and span_is(&out, 0, w, want);
}

// <<< pinned table: plan_self_check
test lab_py_self_check_watched_is_the_index_of_the_first_glob {
    assert lab_test_watched("master", "master,claude/t27c-*") == 0;
    assert lab_test_watched("claude/t27c-match-tail-expr", "master,claude/t27c-*") == 1;
    assert lab_test_watched("claude/gen-zig-discard-call", "master,claude/t27c-*") == LAB_WATCH_NONE;
    assert lab_test_watched("refs/pull/1/head", "master,claude/t27c-*") == LAB_WATCH_NONE;
}

test lab_py_self_check_parse_heads_keeps_heads_with_a_sha_only {
    assert lab_test_heads("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/heads/master\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\trefs/heads/claude/t27c-x\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\trefs/pull/9/head\nnot-a-sha\trefs/heads/y\n", "master\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\nclaude/t27c-x\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n");
}

test lab_py_self_check_plan_groups_by_sha_in_glob_order {
    assert lab_test_plan("claude/t27c-x\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\nclaude/t27c-y\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\nmaster\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", "master,claude/t27c-*", "", "", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tmaster\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-x\tclaude/t27c-y\n");
    assert lab_test_plan("master\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\nclaude/t27c-x\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n", "master,claude/t27c-*", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n", "");
}

test lab_py_self_check_stale_dropped_keeps_live_and_asked_entries {
    assert lab_test_stale("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ncccccccccccccccccccccccccccccccccccccccc\ncccccccccccccccccccccccccccccccccccccccc\tasked\n", "master\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ncccccccccccccccccccccccccccccccccccccccc\tasked\n");
}

