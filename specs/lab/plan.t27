// run_item(): `"master" in item["branches"]` (and any other name) over the items of the plans above.
test lab_py_table_item_has_branch {
    assert lab_test_item_has("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tclaude/lab", "master", false);
    assert lab_test_item_has("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tclaude/lab", "claude/t27c-x", false);
    assert lab_test_item_has("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tclaude/lab", "mast", false);
    assert lab_test_item_has("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tclaude/lab", "", false);
    assert lab_test_item_has("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tclaude/lab", "master ", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-a", "master", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-a", "claude/t27c-x", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-a", "mast", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-a", "", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-a", "master ", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tmaster", "master", true);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tmaster", "claude/t27c-x", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tmaster", "mast", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tmaster", "", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tmaster", "master ", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tclaude/t27c-x\tfeature/a\trefs/pull/1/head", "master", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tclaude/t27c-x\tfeature/a\trefs/pull/1/head", "claude/t27c-x", true);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tclaude/t27c-x\tfeature/a\trefs/pull/1/head", "mast", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tclaude/t27c-x\tfeature/a\trefs/pull/1/head", "", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tclaude/t27c-x\tfeature/a\trefs/pull/1/head", "master ", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-y", "master", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-y", "claude/t27c-x", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-y", "mast", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-y", "", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-y", "master ", false);
    assert lab_test_item_has("dddddddddddddddddddddddddddddddddddddddd\tclaude/gen-zig", "master", false);
    assert lab_test_item_has("dddddddddddddddddddddddddddddddddddddddd\tclaude/gen-zig", "claude/t27c-x", false);
    assert lab_test_item_has("dddddddddddddddddddddddddddddddddddddddd\tclaude/gen-zig", "mast", false);
    assert lab_test_item_has("dddddddddddddddddddddddddddddddddddddddd\tclaude/gen-zig", "", false);
    assert lab_test_item_has("dddddddddddddddddddddddddddddddddddddddd\tclaude/gen-zig", "master ", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-b", "master", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-b", "claude/t27c-x", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-b", "mast", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-b", "", false);
    assert lab_test_item_has("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tclaude/t27c-b", "master ", false);
    assert lab_test_item_has("cccccccccccccccccccccccccccccccccccccccc\tclaude/t27c-y", "master", false);
    assert lab_test_item_has("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "master", false);
}

// >>> pinned table: plan_item_has

// Scenario: `*` and `?` cross `/` and a line break (the regex is DOTALL); `[!x]` takes them too. Checked on Python.
test the_star_and_the_question_mark_cross_slashes_and_line_breaks {
    assert lab_fnmatch("a?b", 0, 3, "a\nb", 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("a*", 0, 2, "a\nb", 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("*", 0, 1, "a\nb", 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("a[!x]b", 0, 6, "a\nb", 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("a?b", 0, 3, "a/b", 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("a[/]b", 0, 5, "a/b", 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("", 0, 0, "", 0, 0) == LAB_FN_YES;
    assert lab_fnmatch("", 0, 0, "a", 0, 1) == LAB_FN_NO;
    assert lab_fnmatch("?", 0, 1, "", 0, 0) == LAB_FN_NO;
}

// Scenario: a character is a code point. `?` takes all of e-acute (2 bytes), a euro sign (3) and a face (4); `??` does not take
// one; a class holds a character by its code point and a range reaches U+00FF but not U+0100. Checked on Python.
test a_character_is_a_code_point_not_a_byte {
    var eacute : [2]u8 = undefined;
    eacute[0] = 195;
    eacute[1] = 169;
    assert lab_fnmatch("?", 0, 1, &eacute, 0, 2) == LAB_FN_YES;
    assert lab_fnmatch("??", 0, 2, &eacute, 0, 2) == LAB_FN_NO;
    assert lab_fnmatch("*", 0, 1, &eacute, 0, 2) == LAB_FN_YES;
    var cls : [4]u8 = undefined;
    cls[0] = 91;
    cls[1] = 195;
    cls[2] = 169;
    cls[3] = 93;
    assert lab_fnmatch(&cls, 0, 4, &eacute, 0, 2) == LAB_FN_YES;
    assert lab_fnmatch(&cls, 0, 4, "e", 0, 1) == LAB_FN_NO;
    var neg : [5]u8 = undefined;
    neg[0] = 91;
    neg[1] = 33;
    neg[2] = 195;
    neg[3] = 169;
    neg[4] = 93;
    assert lab_fnmatch(&neg, 0, 5, &eacute, 0, 2) == LAB_FN_NO;
    assert lab_fnmatch(&neg, 0, 5, "e", 0, 1) == LAB_FN_YES;
    var euro : [3]u8 = undefined;
    euro[0] = 226;
    euro[1] = 130;
    euro[2] = 172;
    assert lab_fnmatch("?", 0, 1, &euro, 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("??", 0, 2, &euro, 0, 3) == LAB_FN_NO;
    var face : [4]u8 = undefined;
    face[0] = 240;
    face[1] = 159;
    face[2] = 152;
    face[3] = 128;
    assert lab_fnmatch("?", 0, 1, &face, 0, 4) == LAB_FN_YES;
    assert lab_fnmatch("*?", 0, 2, &face, 0, 4) == LAB_FN_YES;
    var rng : [6]u8 = undefined;
    rng[0] = 91;
    rng[1] = 97;
    rng[2] = 45;
    rng[3] = 195;
    rng[4] = 191;
    rng[5] = 93;
    assert lab_fnmatch(&rng, 0, 6, &eacute, 0, 2) == LAB_FN_YES;
    var a_grave : [2]u8 = undefined;
    a_grave[0] = 196;
    a_grave[1] = 128;
    assert lab_fnmatch(&rng, 0, 6, &a_grave, 0, 2) == LAB_FN_NO;
}

// Scenario (negative control, NOT Python): a range that runs backwards is refused, wherever it is and whatever the name is.
// Python gives such a class no members at all (`[z-a]` takes neither z nor a), and a second range after it can move which
// ends are dropped; the port refuses the glob rather than answer. A glob after the match is not tried, as in Python.
test a_backwards_range_is_refused_not_answered_differently {
    assert lab_fnmatch("[z-a]", 0, 5, "z", 0, 1) == LAB_FN_REFUSED;
    assert lab_fnmatch("[z-a]", 0, 5, "a", 0, 1) == LAB_FN_REFUSED;
    assert lab_fnmatch("[bz-a]", 0, 6, "b", 0, 1) == LAB_FN_REFUSED;
    assert lab_fnmatch("x[9-0]y", 0, 7, "x5y", 0, 3) == LAB_FN_REFUSED;
    assert lab_fnmatch("[!z-a]", 0, 6, "q", 0, 1) == LAB_FN_REFUSED;
    assert lab_fnmatch("a-z", 0, 3, "a-z", 0, 3) == LAB_FN_YES;
    assert lab_fnmatch("[a-a]", 0, 5, "a", 0, 1) == LAB_FN_YES;
    assert lab_fnmatch("[a-b-c]", 0, 7, "c", 0, 1) == LAB_FN_YES;
    assert lab_fnmatch("[a-]", 0, 4, "a", 0, 1) == LAB_FN_YES;
    assert lab_glob_ok("[z-a]", 0, 5) == false;
    assert lab_glob_ok("[a-z]", 0, 5) == true;
    assert lab_glob_ok("[z-a", 0, 4) == true;
    assert lab_watch_ok("master,[z-a]") == false;
    assert lab_watch_ok("master, ,claude/*") == true;
    assert lab_watched("master", 0, 6, "master,[z-a]") == 0;
    assert lab_watched("main", 0, 4, "master,[z-a]") == LAB_WATCH_BAD;
    assert lab_watched("main", 0, 4, "[z-a],main") == LAB_WATCH_BAD;
}

// Scenario: a writer reports the length it needs when the buffer is short, and writes what fits.
test a_short_buffer_still_gets_the_length {
    const h : string = "master\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n";
    var out : [8]u8 = undefined;
    assert lab_plan(h, "master", "", "", &out, 8, 0) == 48;
    assert span_is(&out, 0, 8, "aaaaaaaa");
    assert lab_plan(h, "master", "", "", &out, 8, 5) == 53;
    assert lab_plan(h, "[z-a]", "", "", &out, 8, 0) == LAB_NO;
    assert lab_parse_heads("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/heads/master\n", &out, 8, 0) == 48;
    assert lab_stale_dropped("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tasked\n", "", &out, 8, 0) == 47;
    assert lab_stale_dropped("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tasked\n", "", &out, 8, 3) == 50;
}

// Scenario: the watch text is cut at commas and stripped of Unicode spaces, as Python's strip() does (a no-break space is one).
test a_glob_is_stripped_of_unicode_spaces {
    var v : [10]u8 = undefined;
    v[0] = 194;
    v[1] = 160;
    v[2] = 109;
    v[3] = 97;
    v[4] = 115;
    v[5] = 116;
    v[6] = 101;
    v[7] = 114;
    v[8] = 194;
    v[9] = 160;
    assert lab_watched("master", 0, 6, &v) == 0;
    assert lab_watched("xx master yy", 3, 9, "master") == 0;
    assert lab_watched("xx master yy", 3, 8, "master") == LAB_WATCH_NONE;
}

// Scenario: a head line is `<sha> TAB refs/heads/<branch>`: the offset of the branch comes back, and a line that is not one is no head.
test the_branch_of_a_head_line_is_found_by_its_offset {
    const l : string = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/heads/claude/x";
    assert lab_ls_branch(l, 0, l.len) == 52;
    assert lab_ls_branch(l, 0, 51) == LAB_NO;
    assert lab_ls_branch(l, 0, 52) == 52;
    assert lab_ls_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/heads/", 0, 52) == 52;
    assert lab_ls_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/tags/v1", 0, 53) == LAB_NO;
    assert lab_ls_branch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/heads/x", 0, 51) == LAB_NO;
    assert lab_ls_branch("", 0, 0) == LAB_NO;
}
