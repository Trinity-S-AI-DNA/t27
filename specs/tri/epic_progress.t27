// SPDX-License-Identifier: Apache-2.0
// specs/tri/epic_progress.t27 -- Epic progress card: one .t27 format, one post per epic
// with percent, breakthroughs and blockers.
// Part of M5 milestone (milestone #9). Closes #12631.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::epic_progress;

pub const EPIC_PROGRESS_MAX_BLOCKERS : u32 = 10;

pub struct EpicProgress {
    epic_id: str,
    percent: u32,
    breakthroughs: str,
    blockers: str,
}

pub fn epic_progress_percent(p: EpicProgress) -> u32 {
    return p.percent;
}

pub fn epic_progress_complete(p: EpicProgress) -> bool {
    return p.percent == 100;
}

test "epic_progress_percent" {
    var p = EpicProgress { epic_id: "epic-1", percent: 42, breakthroughs: "none", blockers: "none" };
    assert(epic_progress_percent(p) == 42);
}

test "epic_progress_complete" {
    var complete = EpicProgress { epic_id: "epic-1", percent: 100, breakthroughs: "done", blockers: "none" };
    assert(epic_progress_complete(complete));
    var incomplete = EpicProgress { epic_id: "epic-2", percent: 50, breakthroughs: "some", blockers: "one" };
    assert(!epic_progress_complete(incomplete));
}

invariant epic_progress_percent_valid {
    var p = EpicProgress { epic_id: "test", percent: 50, breakthroughs: "x", blockers: "y" };
    assert epic_progress_percent(p) >= 0;
    assert epic_progress_percent(p) <= 100;
}