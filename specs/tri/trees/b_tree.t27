// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Split full child node during insertion | φ² + 1/φ² = 3 | TRINITY

module TriBTree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator, so nodes live in a fixed pool of
    // BT_CAP nodes addressed by index (BT_NIL = -1 is the null link) and init no
    // longer takes an allocator. The minimum degree t is clamped to 2..BT_MAX_T,
    // so a node holds at most 2t-1 <= BT_MAX_KEYS keys. The tree is a set: a key
    // already present is not stored twice.
    pub const BT_MAX_T : usize = 4;
    pub const BT_MAX_KEYS : usize = 7;
    pub const BT_MAX_CHILDREN : usize = 8;
    pub const BT_CAP : usize = 64;
    pub const BT_NIL : i32 = -1;

    pub const BTreeNode = struct {
        keys : [BT_MAX_KEYS]usize,
        children : [BT_MAX_CHILDREN]i32,
        leaf : bool,
        count : usize,
    };

    pub const BTree = struct {
        root : i32,
        t : usize,
        used : usize,
        nodes : [BT_CAP]BTreeNode,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // at(n) -> usize : pool index of a non-nil link
    fn at(n: i32) -> usize {
        return @as(usize, @intCast(n));
    }

    // init(min_degree: usize) -> BTree
    fn init(min_degree: usize) -> BTree {
        var tree : BTree = undefined;
        tree.root = BT_NIL;
        tree.used = 0;
        tree.t = min_degree;
        if (tree.t < 2) {
            tree.t = 2;
        }
        if (tree.t > BT_MAX_T) {
            tree.t = BT_MAX_T;
        }
        return tree;
    }

    // search(tree: *BTree, key: usize) -> bool
    fn search(tree: *BTree, key: usize) -> bool {
        var node = tree.root;
        while (node != BT_NIL) {
            const n = at(node);
            var i : usize = 0;
            while (i < tree.nodes[n].count and tree.nodes[n].keys[i] < key) {
                i = i + 1;
            }
            if (i < tree.nodes[n].count and tree.nodes[n].keys[i] == key) {
                return true;
            }
            if (tree.nodes[n].leaf) {
                return false;
            }
            node = tree.nodes[n].children[i];
        }
        return false;
    }

    // create_node(tree, leaf) -> i32 : an empty node, BT_NIL when the pool is full
    fn create_node(tree: *BTree, leaf: bool) -> i32 {
        if (tree.used >= BT_CAP) {
            return BT_NIL;
        }
        const idx = tree.used;
        tree.used = tree.used + 1;
        tree.nodes[idx].leaf = leaf;
        tree.nodes[idx].count = 0;
        return @as(i32, @intCast(idx));
    }

    // split_child(tree, x, i) : the full child x.children[i] becomes two nodes
    // and its median key moves up into x at position i
    fn split_child(tree: *BTree, x: i32, i: usize) -> void {
        const t = tree.t;
        const xi = at(x);
        const yi = at(tree.nodes[xi].children[i]);
        const z = create_node(tree, tree.nodes[yi].leaf);
        const zi = at(z);
        tree.nodes[zi].count = t - 1;
        var j : usize = 0;
        while (j < t - 1) {
            tree.nodes[zi].keys[j] = tree.nodes[yi].keys[j + t];
            j = j + 1;
        }
        if (!tree.nodes[yi].leaf) {
            j = 0;
            while (j < t) {
                tree.nodes[zi].children[j] = tree.nodes[yi].children[j + t];
                j = j + 1;
            }
        }
        const median = tree.nodes[yi].keys[t - 1];
        tree.nodes[yi].count = t - 1;
        j = tree.nodes[xi].count + 1;
        while (j > i + 1) {
            tree.nodes[xi].children[j] = tree.nodes[xi].children[j - 1];
            j = j - 1;
        }
        tree.nodes[xi].children[i + 1] = z;
        j = tree.nodes[xi].count;
        while (j > i) {
            tree.nodes[xi].keys[j] = tree.nodes[xi].keys[j - 1];
            j = j - 1;
        }
        tree.nodes[xi].keys[i] = median;
        tree.nodes[xi].count = tree.nodes[xi].count + 1;
    }

    // insert_nonfull(tree, x, key) : x has room for one more key
    fn insert_nonfull(tree: *BTree, x: i32, key: usize) -> void {
        const xi = at(x);
        var i = tree.nodes[xi].count;
        if (tree.nodes[xi].leaf) {
            while (i > 0 and tree.nodes[xi].keys[i - 1] > key) {
                tree.nodes[xi].keys[i] = tree.nodes[xi].keys[i - 1];
                i = i - 1;
            }
            tree.nodes[xi].keys[i] = key;
            tree.nodes[xi].count = tree.nodes[xi].count + 1;
            return;
        }
        while (i > 0 and tree.nodes[xi].keys[i - 1] > key) {
            i = i - 1;
        }
        if (tree.nodes[at(tree.nodes[xi].children[i])].count == 2 * tree.t - 1) {
            split_child(tree, x, i);
            if (tree.nodes[xi].keys[i] < key) {
                i = i + 1;
            }
        }
        insert_nonfull(tree, tree.nodes[xi].children[i], key);
    }

    // height(tree: *BTree) -> usize : levels from the root to a leaf, 0 when empty
    fn height(tree: *BTree) -> usize {
        var h : usize = 0;
        var node = tree.root;
        while (node != BT_NIL) {
            h = h + 1;
            if (tree.nodes[at(node)].leaf) {
                return h;
            }
            node = tree.nodes[at(node)].children[0];
        }
        return h;
    }

    // insert(tree: *BTree, key: usize) -> bool
    // True when the key is stored afterwards. False only when the node pool
    // cannot hold the splits this insert may need.
    fn insert(tree: *BTree, key: usize) -> bool {
        if (search(tree, key)) {
            return true;
        }
        if (tree.used + height(tree) + 1 > BT_CAP) {
            return false;
        }
        if (tree.root == BT_NIL) {
            tree.root = create_node(tree, true);
            tree.nodes[at(tree.root)].keys[0] = key;
            tree.nodes[at(tree.root)].count = 1;
            return true;
        }
        if (tree.nodes[at(tree.root)].count == 2 * tree.t - 1) {
            const s = create_node(tree, false);
            tree.nodes[at(s)].children[0] = tree.root;
            tree.root = s;
            split_child(tree, s, 0);
        }
        insert_nonfull(tree, tree.root, key);
        return true;
    }

    // deinit(tree: *BTree) -> void : empty the tree and release every node
    fn deinit(tree: *BTree) -> void {
        tree.root = BT_NIL;
        tree.used = 0;
    }

    // check_node(tree, n, lo, hi, is_root) -> i32
    // Leaf depth below n (a leaf is 1), or -1 when a B-tree rule is broken:
    // keys strictly increasing inside the bounds (lo, hi), t-1 <= count <= 2t-1
    // (the root may hold fewer), and every leaf at the same depth.
    fn check_node(tree: *BTree, n: i32, lo: i64, hi: i64, is_root: bool) -> i32 {
        const ni = at(n);
        const c = tree.nodes[ni].count;
        if (c > 2 * tree.t - 1) {
            return -1;
        }
        if (!is_root and c < tree.t - 1) {
            return -1;
        }
        if (is_root and c < 1) {
            return -1;
        }
        var prev = lo;
        var i : usize = 0;
        while (i < c) {
            const k = @as(i64, @intCast(tree.nodes[ni].keys[i]));
            if (k <= prev or k >= hi) {
                return -1;
            }
            prev = k;
            i = i + 1;
        }
        if (tree.nodes[ni].leaf) {
            return 1;
        }
        var depth : i32 = -2;
        i = 0;
        while (i <= c) {
            var child_lo = lo;
            var child_hi = hi;
            if (i > 0) {
                child_lo = @as(i64, @intCast(tree.nodes[ni].keys[i - 1]));
            }
            if (i < c) {
                child_hi = @as(i64, @intCast(tree.nodes[ni].keys[i]));
            }
            const d = check_node(tree, tree.nodes[ni].children[i], child_lo, child_hi, false);
            if (d < 0) {
                return -1;
            }
            if (depth == -2) {
                depth = d;
            }
            if (d != depth) {
                return -1;
            }
            i = i + 1;
        }
        return depth + 1;
    }

    // is_valid(tree: *BTree) -> bool : the B-tree rules hold
    fn is_valid(tree: *BTree) -> bool {
        if (tree.root == BT_NIL) {
            return true;
        }
        return check_node(tree, tree.root, -1, 1000000000, true) > 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_creates_tree {
        var tree = init(2);
        assert(tree.root == BT_NIL);
        assert(tree.t == 2);
        assert(is_valid(&tree));
    }

    test init_clamps_min_degree {
        const low = init(0);
        assert(low.t == 2);
        const high = init(100);
        assert(high.t == BT_MAX_T);
    }

    test search_finds_existing_key {
        var tree = init(2);
        assert(insert(&tree, 42));
        assert(search(&tree, 42) == true);
    }

    test search_does_not_find_nonexistent_key {
        var tree = init(2);
        assert(insert(&tree, 42));
        assert(search(&tree, 99) == false);
    }

    test search_on_empty_tree_finds_nothing {
        var tree = init(2);
        assert(search(&tree, 42) == false);
    }

    test insert_multiple_keys {
        var tree = init(2);
        assert(insert(&tree, 10));
        assert(insert(&tree, 20));
        assert(insert(&tree, 30));
        assert(search(&tree, 10) == true);
        assert(search(&tree, 20) == true);
        assert(search(&tree, 30) == true);
        assert(is_valid(&tree));
    }

    test insert_is_a_set {
        var tree = init(2);
        assert(insert(&tree, 5));
        assert(insert(&tree, 5));
        assert(tree.nodes[at(tree.root)].count == 1);
    }

    test splits_keep_tree_valid {
        // 40 ascending keys with t = 2 force repeated splits of full children.
        var tree = init(2);
        var k : usize = 1;
        while (k <= 40) {
            assert(insert(&tree, k));
            assert(is_valid(&tree));
            k = k + 1;
        }
        assert(height(&tree) > 2);
        k = 1;
        while (k <= 40) {
            assert(search(&tree, k));
            k = k + 1;
        }
        assert(!search(&tree, 41));
        assert(!search(&tree, 0));
    }

    test descending_and_wider_degree {
        var tree = init(4);
        var k : usize = 60;
        while (k >= 1) {
            assert(insert(&tree, k));
            k = k - 1;
        }
        assert(is_valid(&tree));
        assert(search(&tree, 1));
        assert(search(&tree, 60));
        assert(!search(&tree, 61));
        // A node of degree 4 holds up to 7 keys, so 60 keys fit in 3 levels.
        assert(height(&tree) <= 3);
    }

    test full_pool_rejects_insert {
        var tree = init(2);
        var k : usize = 1;
        var rejected = false;
        while (k <= 200 and !rejected) {
            if (!insert(&tree, k)) {
                rejected = true;
            }
            k = k + 1;
        }
        assert(rejected);
        assert(is_valid(&tree));
        assert(search(&tree, 1));
    }

    test deinit_cleans_up_tree {
        var tree = init(2);
        assert(insert(&tree, 42));
        deinit(&tree);
        assert(tree.root == BT_NIL);
        assert(tree.used == 0);
        assert(search(&tree, 42) == false);
    }
