// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Free tree | φ² + 1/φ² = 3 | TRINITY

module TriQuadtree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator, so the tree is a fixed pool of QT_NODES
    // nodes addressed by index (QT_NIL = -1 is the null link), each node holding
    // up to `capacity` points (clamped to 1..QT_MAX_PTS). A full node subdivides
    // into four quadrants and hands later points to them; when the pool cannot
    // supply four more nodes, insert returns false. A rectangle is closed: its
    // corner x, y and its far edges x + width, y + height belong to it. query
    // returns a slice of static storage, valid until the next call of query.
    pub const QT_NODES : usize = 64;
    pub const QT_MAX_PTS : usize = 8;
    pub const QT_OUT_CAP : usize = 512;
    pub const QT_NIL : i32 = -1;

    pub const Rect = struct {
        x : f64,
        y : f64,
        width : f64,
        height : f64,
    };

    pub const QuadNode = struct {
        boundary : Rect,
        children : [4]i32,
        px : [QT_MAX_PTS]f64,
        py : [QT_MAX_PTS]f64,
        count : usize,
        divided : bool,
    };

    pub const QuadTree = struct {
        root : i32,
        capacity : usize,
        size : usize,
        used : usize,
        nodes : [QT_NODES]QuadNode,
    };

    var QT_OUT : [QT_OUT_CAP][2]f64 = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // at(n) -> usize : pool index of a non-nil link
    fn at(n: i32) -> usize {
        return @as(usize, @intCast(n));
    }

    // rect_contains(r, x, y) -> bool
    fn rect_contains(r: Rect, x: f64, y: f64) -> bool {
        return x >= r.x and x <= r.x + r.width and y >= r.y and y <= r.y + r.height;
    }

    // rect_intersects(a, b) -> bool : the closed rectangles share a point
    fn rect_intersects(a: Rect, b: Rect) -> bool {
        if (b.x > a.x + a.width or b.x + b.width < a.x) {
            return false;
        }
        if (b.y > a.y + a.height or b.y + b.height < a.y) {
            return false;
        }
        return true;
    }

    // new_node(tree, boundary) -> i32 : an empty leaf, QT_NIL when the pool is full
    fn new_node(tree: *QuadTree, boundary: Rect) -> i32 {
        if (tree.used >= QT_NODES) {
            return QT_NIL;
        }
        const idx = tree.used;
        tree.used = tree.used + 1;
        tree.nodes[idx].boundary = boundary;
        tree.nodes[idx].count = 0;
        tree.nodes[idx].divided = false;
        var c : usize = 0;
        while (c < 4) {
            tree.nodes[idx].children[c] = QT_NIL;
            c = c + 1;
        }
        return @as(i32, @intCast(idx));
    }

    // init(boundary: Rect, capacity: usize) -> QuadTree
    fn init(boundary: Rect, capacity: usize) -> QuadTree {
        var qt : QuadTree = undefined;
        qt.used = 0;
        qt.size = 0;
        qt.capacity = capacity;
        if (qt.capacity < 1) {
            qt.capacity = 1;
        }
        if (qt.capacity > QT_MAX_PTS) {
            qt.capacity = QT_MAX_PTS;
        }
        qt.root = new_node(&qt, boundary);
        return qt;
    }

    // subdivide(tree, n) -> bool : give n its four quadrants, false when the pool is short
    fn subdivide(tree: *QuadTree, n: i32) -> bool {
        if (tree.used + 4 > QT_NODES) {
            return false;
        }
        const i = at(n);
        const b = tree.nodes[i].boundary;
        const hw = b.width / 2.0;
        const hh = b.height / 2.0;
        tree.nodes[i].children[0] = new_node(tree, Rect { x = b.x, y = b.y, width = hw, height = hh });
        tree.nodes[i].children[1] = new_node(tree, Rect { x = b.x + hw, y = b.y, width = hw, height = hh });
        tree.nodes[i].children[2] = new_node(tree, Rect { x = b.x, y = b.y + hh, width = hw, height = hh });
        tree.nodes[i].children[3] = new_node(tree, Rect { x = b.x + hw, y = b.y + hh, width = hw, height = hh });
        tree.nodes[i].divided = true;
        return true;
    }

    fn insert_at(tree: *QuadTree, n: i32, x: f64, y: f64) -> bool {
        const i = at(n);
        if (!rect_contains(tree.nodes[i].boundary, x, y)) {
            return false;
        }
        if (!tree.nodes[i].divided and tree.nodes[i].count < tree.capacity) {
            const c = tree.nodes[i].count;
            tree.nodes[i].px[c] = x;
            tree.nodes[i].py[c] = y;
            tree.nodes[i].count = c + 1;
            return true;
        }
        if (!tree.nodes[i].divided) {
            if (!subdivide(tree, n)) {
                return false;
            }
        }
        var q : usize = 0;
        while (q < 4) {
            if (insert_at(tree, tree.nodes[i].children[q], x, y)) {
                return true;
            }
            q = q + 1;
        }
        return false;
    }

    // insert(qt: *QuadTree, x: f64, y: f64) -> bool
    // False when the point is outside the boundary or the pool is exhausted.
    fn insert(qt: *QuadTree, x: f64, y: f64) -> bool {
        if (insert_at(qt, qt.root, x, y)) {
            qt.size = qt.size + 1;
            return true;
        }
        return false;
    }

    fn query_at(qt: *QuadTree, n: i32, range: Rect, found: *usize) -> void {
        if (n == QT_NIL) {
            return;
        }
        const i = at(n);
        if (!rect_intersects(qt.nodes[i].boundary, range)) {
            return;
        }
        var p : usize = 0;
        while (p < qt.nodes[i].count) {
            if (rect_contains(range, qt.nodes[i].px[p], qt.nodes[i].py[p]) and found.* < QT_OUT_CAP) {
                QT_OUT[found.*][0] = qt.nodes[i].px[p];
                QT_OUT[found.*][1] = qt.nodes[i].py[p];
                found.* = found.* + 1;
            }
            p = p + 1;
        }
        if (qt.nodes[i].divided) {
            var q : usize = 0;
            while (q < 4) {
                query_at(qt, qt.nodes[i].children[q], range, found);
                q = q + 1;
            }
        }
    }

    // query(qt: *QuadTree, range: Rect) -> [][2]f64 : every stored point inside range
    fn query(qt: *QuadTree, range: Rect) -> [][2]f64 {
        var found : usize = 0;
        query_at(qt, qt.root, range, &found);
        return QT_OUT[0..found];
    }

    // deinit(qt: *QuadTree) -> void : drop every node and point
    fn deinit(qt: *QuadTree) -> void {
        qt.root = QT_NIL;
        qt.size = 0;
        qt.used = 0;
    }

    // has_point(points, x, y) -> bool : helper for tests
    fn has_point(points: [][2]f64, x: f64, y: f64) -> bool {
        var i : usize = 0;
        while (i < points.len) {
            if (points[i][0] == x and points[i][1] == y) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var qt = init(Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 }, 4);
        assert(qt.root != QT_NIL);
        assert(qt.capacity == 4);
        assert(qt.size == 0);
        assert(qt.used == 1);
        assert(qt.nodes[at(qt.root)].boundary.width == 100.0);
        assert(qt.nodes[at(qt.root)].divided == false);
        // The capacity is clamped to what a node can hold.
        assert(init(Rect { x = 0.0, y = 0.0, width = 1.0, height = 1.0 }, 0).capacity == 1);
        assert(init(Rect { x = 0.0, y = 0.0, width = 1.0, height = 1.0 }, 99).capacity == QT_MAX_PTS);
    }

    test insert_basic_case {
        var qt = init(Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 }, 4);
        assert(insert(&qt, 10.0, 20.0));
        assert(qt.size == 1);
        assert(qt.nodes[at(qt.root)].count == 1);
        assert(qt.nodes[at(qt.root)].px[0] == 10.0);
        assert(qt.nodes[at(qt.root)].py[0] == 20.0);
        // A point outside the boundary is refused and not counted.
        assert(!insert(&qt, 150.0, 20.0));
        assert(!insert(&qt, 10.0, -0.5));
        assert(qt.size == 1);
        // The boundary is closed: its far corner is inside.
        assert(insert(&qt, 100.0, 100.0));
        assert(qt.size == 2);
    }

    test insert_subdivides_a_full_node {
        var qt = init(Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 }, 2);
        assert(insert(&qt, 10.0, 10.0));
        assert(insert(&qt, 90.0, 10.0));
        assert(!qt.nodes[at(qt.root)].divided);
        assert(insert(&qt, 10.0, 90.0));
        assert(qt.nodes[at(qt.root)].divided);
        assert(qt.used == 5);
        // The third point went to the south-west quadrant, the root kept two.
        assert(qt.nodes[at(qt.root)].count == 2);
        assert(qt.nodes[at(qt.nodes[at(qt.root)].children[2])].count == 1);
        assert(qt.size == 3);
    }

    test query_basic_case {
        var qt = init(Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 }, 2);
        // Query on an empty tree finds nothing.
        assert(query(&qt, Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 }).len == 0);
        assert(insert(&qt, 10.0, 10.0));
        assert(insert(&qt, 20.0, 15.0));
        assert(insert(&qt, 60.0, 60.0));
        assert(insert(&qt, 80.0, 90.0));
        assert(insert(&qt, 95.0, 5.0));
        const all = query(&qt, Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 });
        assert(all.len == 5);
        const part = query(&qt, Rect { x = 0.0, y = 0.0, width = 50.0, height = 50.0 });
        assert(part.len == 2);
        assert(has_point(part, 10.0, 10.0));
        assert(has_point(part, 20.0, 15.0));
        assert(!has_point(part, 60.0, 60.0));
        const none = query(&qt, Rect { x = 30.0, y = 30.0, width = 10.0, height = 10.0 });
        assert(none.len == 0);
    }

    test query_matches_a_scan_of_every_inserted_point {
        var qt = init(Rect { x = 0.0, y = 0.0, width = 64.0, height = 64.0 }, 3);
        var inserted : usize = 0;
        var inside : usize = 0;
        var i : usize = 0;
        while (i < 40) {
            const x = @as(f64, @floatFromInt((i * 7) % 64));
            const y = @as(f64, @floatFromInt((i * 13) % 64));
            assert(insert(&qt, x, y));
            inserted = inserted + 1;
            if (x >= 16.0 and x <= 47.0 and y >= 8.0 and y <= 39.0) {
                inside = inside + 1;
            }
            i = i + 1;
        }
        assert(qt.size == inserted);
        assert(query(&qt, Rect { x = 0.0, y = 0.0, width = 64.0, height = 64.0 }).len == 40);
        assert(query(&qt, Rect { x = 16.0, y = 8.0, width = 31.0, height = 31.0 }).len == inside);
    }

    test insert_fails_when_the_pool_is_exhausted {
        var qt = init(Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 }, 1);
        // The same spot over and over forces subdivision until the pool runs dry.
        var ok : usize = 0;
        var i : usize = 0;
        while (i < 100) {
            if (insert(&qt, 1.0, 1.0)) {
                ok = ok + 1;
            }
            i = i + 1;
        }
        assert(ok < 100);
        assert(ok > 0);
        assert(qt.size == ok);
        assert(qt.used <= QT_NODES);
    }

    test deinit_basic_case {
        var qt = init(Rect { x = 0.0, y = 0.0, width = 100.0, height = 100.0 }, 4);
        assert(insert(&qt, 10.0, 20.0));
        deinit(&qt);
        assert(qt.root == QT_NIL);
        assert(qt.size == 0);
        assert(qt.used == 0);
    }
