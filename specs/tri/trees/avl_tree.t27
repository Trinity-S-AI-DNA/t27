// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Left/right rotations to maintain balance | φ² + 1/φ² = 3 | TRINITY

module TriAvlTree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator and no nullable pointers, so the
    // tree is a fixed pool of AVL_CAP nodes addressed by index. AVL_NIL (-1) is
    // the null link. Deleted slots are chained through `left` into a free list.
    // Keys and values are i64 (the old spec was generic over K, V).
    pub const AVL_CAP : usize = 64;
    pub const AVL_NIL : i32 = -1;

    pub const AVLNode = struct {
        key : i64,
        value : i64,
        height : i32,
        left : i32,
        right : i32,
    };

    pub const AVLTree = struct {
        root : i32,
        size : usize,
        used : usize,
        free_head : i32,
        nodes : [AVL_CAP]AVLNode,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // at(n) -> usize : pool index of a non-nil link
    fn at(n: i32) -> usize {
        return @as(usize, @intCast(n));
    }

    // init() -> AVLTree
    fn init() -> AVLTree {
        var t : AVLTree = undefined;
        t.root = AVL_NIL;
        t.size = 0;
        t.used = 0;
        t.free_head = AVL_NIL;
        return t;
    }

    // node_height(tree, n) -> i32 : height of a subtree, 0 for nil
    fn node_height(tree: *AVLTree, n: i32) -> i32 {
        if (n == AVL_NIL) {
            return 0;
        }
        return tree.nodes[at(n)].height;
    }

    fn max_i32(a: i32, b: i32) -> i32 {
        if (a > b) {
            return a;
        }
        return b;
    }

    fn update_height(tree: *AVLTree, n: i32) -> void {
        const i = at(n);
        const lh = node_height(tree, tree.nodes[i].left);
        const rh = node_height(tree, tree.nodes[i].right);
        tree.nodes[i].height = max_i32(lh, rh) + 1;
    }

    // balance_factor(tree, n) -> i32 : height(left) - height(right)
    fn balance_factor(tree: *AVLTree, n: i32) -> i32 {
        if (n == AVL_NIL) {
            return 0;
        }
        const i = at(n);
        return node_height(tree, tree.nodes[i].left) - node_height(tree, tree.nodes[i].right);
    }

    // rotate_right(tree, y) -> i32 : new subtree root
    fn rotate_right(tree: *AVLTree, y: i32) -> i32 {
        const x = tree.nodes[at(y)].left;
        const t2 = tree.nodes[at(x)].right;
        tree.nodes[at(x)].right = y;
        tree.nodes[at(y)].left = t2;
        update_height(tree, y);
        update_height(tree, x);
        return x;
    }

    // rotate_left(tree, x) -> i32 : new subtree root
    fn rotate_left(tree: *AVLTree, x: i32) -> i32 {
        const y = tree.nodes[at(x)].right;
        const t2 = tree.nodes[at(y)].left;
        tree.nodes[at(y)].left = x;
        tree.nodes[at(x)].right = t2;
        update_height(tree, x);
        update_height(tree, y);
        return y;
    }

    // rebalance(tree, n) -> i32 : restore the AVL invariant at n
    fn rebalance(tree: *AVLTree, n: i32) -> i32 {
        update_height(tree, n);
        const bf = balance_factor(tree, n);
        if (bf > 1) {
            if (balance_factor(tree, tree.nodes[at(n)].left) < 0) {
                tree.nodes[at(n)].left = rotate_left(tree, tree.nodes[at(n)].left);
            }
            return rotate_right(tree, n);
        }
        if (bf < -1) {
            if (balance_factor(tree, tree.nodes[at(n)].right) > 0) {
                tree.nodes[at(n)].right = rotate_right(tree, tree.nodes[at(n)].right);
            }
            return rotate_left(tree, n);
        }
        return n;
    }

    // alloc_node(tree, key, value) -> i32 : AVL_NIL when the pool is full
    fn alloc_node(tree: *AVLTree, key: i64, value: i64) -> i32 {
        var idx : i32 = AVL_NIL;
        if (tree.free_head != AVL_NIL) {
            idx = tree.free_head;
            tree.free_head = tree.nodes[at(idx)].left;
        } else {
            if (tree.used >= AVL_CAP) {
                return AVL_NIL;
            }
            idx = @as(i32, @intCast(tree.used));
            tree.used = tree.used + 1;
        }
        tree.nodes[at(idx)] = AVLNode { key = key, value = value, height = 1, left = AVL_NIL, right = AVL_NIL };
        tree.size = tree.size + 1;
        return idx;
    }

    // free_node(tree, n) : return a slot to the free list
    fn free_node(tree: *AVLTree, n: i32) -> void {
        tree.nodes[at(n)].left = tree.free_head;
        tree.free_head = n;
        tree.size = tree.size - 1;
    }

    fn insert_at(tree: *AVLTree, n: i32, key: i64, value: i64) -> i32 {
        if (n == AVL_NIL) {
            return alloc_node(tree, key, value);
        }
        const i = at(n);
        if (key == tree.nodes[i].key) {
            tree.nodes[i].value = value;
            return n;
        }
        if (key < tree.nodes[i].key) {
            tree.nodes[i].left = insert_at(tree, tree.nodes[i].left, key, value);
        } else {
            tree.nodes[i].right = insert_at(tree, tree.nodes[i].right, key, value);
        }
        return rebalance(tree, n);
    }

    // insert(tree: *AVLTree, key: i64, value: i64) -> bool
    // Replaces the value of an existing key. Returns false only when the pool
    // is full and the key is new.
    fn insert(tree: *AVLTree, key: i64, value: i64) -> bool {
        const known = contains(tree, key);
        tree.root = insert_at(tree, tree.root, key, value);
        if (known) {
            return true;
        }
        return contains(tree, key);
    }

    // find(tree: *AVLTree, key: i64) -> ?i64
    fn find(tree: *AVLTree, key: i64) -> ?i64 {
        var current = tree.root;
        while (current != AVL_NIL) {
            const i = at(current);
            if (key == tree.nodes[i].key) {
                return tree.nodes[i].value;
            }
            if (key < tree.nodes[i].key) {
                current = tree.nodes[i].left;
            } else {
                current = tree.nodes[i].right;
            }
        }
        return null;
    }

    // contains(tree: *AVLTree, key: i64) -> bool
    fn contains(tree: *AVLTree, key: i64) -> bool {
        var current = tree.root;
        while (current != AVL_NIL) {
            const i = at(current);
            if (key == tree.nodes[i].key) {
                return true;
            }
            if (key < tree.nodes[i].key) {
                current = tree.nodes[i].left;
            } else {
                current = tree.nodes[i].right;
            }
        }
        return false;
    }

    // height(tree: *AVLTree) -> i32
    fn height(tree: *AVLTree) -> i32 {
        return node_height(tree, tree.root);
    }

    fn delete_at(tree: *AVLTree, n: i32, key: i64) -> i32 {
        if (n == AVL_NIL) {
            return AVL_NIL;
        }
        const i = at(n);
        if (key < tree.nodes[i].key) {
            tree.nodes[i].left = delete_at(tree, tree.nodes[i].left, key);
        } else {
            if (key > tree.nodes[i].key) {
                tree.nodes[i].right = delete_at(tree, tree.nodes[i].right, key);
            } else {
                const l = tree.nodes[i].left;
                const r = tree.nodes[i].right;
                if (l == AVL_NIL) {
                    free_node(tree, n);
                    return r;
                }
                if (r == AVL_NIL) {
                    free_node(tree, n);
                    return l;
                }
                // Two children: take the in-order successor (minimum of the right subtree).
                var s = r;
                while (tree.nodes[at(s)].left != AVL_NIL) {
                    s = tree.nodes[at(s)].left;
                }
                tree.nodes[i].key = tree.nodes[at(s)].key;
                tree.nodes[i].value = tree.nodes[at(s)].value;
                tree.nodes[i].right = delete_at(tree, r, tree.nodes[i].key);
            }
        }
        return rebalance(tree, n);
    }

    // delete(tree: *AVLTree, key: i64) -> bool
    fn delete(tree: *AVLTree, key: i64) -> bool {
        if (!contains(tree, key)) {
            return false;
        }
        tree.root = delete_at(tree, tree.root, key);
        return true;
    }

    // is_balanced_at(tree, n) -> bool : every node has |balance factor| <= 1
    fn is_balanced_at(tree: *AVLTree, n: i32) -> bool {
        if (n == AVL_NIL) {
            return true;
        }
        const bf = balance_factor(tree, n);
        if (bf > 1 or bf < -1) {
            return false;
        }
        if (!is_balanced_at(tree, tree.nodes[at(n)].left)) {
            return false;
        }
        return is_balanced_at(tree, tree.nodes[at(n)].right);
    }

    // is_balanced(tree: *AVLTree) -> bool
    fn is_balanced(tree: *AVLTree) -> bool {
        return is_balanced_at(tree, tree.root);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test "init_basic_case" {
        var tree = init();
        assert(tree.size == 0);
        assert(tree.root == AVL_NIL);
        assert(height(&tree) == 0);
    }

    test "insert_basic_case" {
        var tree = init();
        assert(insert(&tree, 42, 7));
        assert(tree.size == 1);
        assert(height(&tree) == 1);
        assert(contains(&tree, 42));
        // A repeated key replaces the value and does not grow the tree.
        assert(insert(&tree, 42, 9));
        assert(tree.size == 1);
    }

    test "insert_rotates_to_stay_balanced" {
        // Ascending keys degrade a plain BST to a list of 7; the AVL keeps height 3.
        var tree = init();
        var k : i64 = 1;
        while (k <= 7) {
            assert(insert(&tree, k, k * 10));
            k = k + 1;
        }
        assert(tree.size == 7);
        assert(height(&tree) == 3);
        assert(is_balanced(&tree));
        assert(tree.nodes[at(tree.root)].key == 4);
    }

    test "find_basic_case" {
        var tree = init();
        assert(find(&tree, 42) == null);
        assert(insert(&tree, 42, 7));
        assert(insert(&tree, 10, 1));
        assert(find(&tree, 42).? == 7);
        assert(find(&tree, 10).? == 1);
        assert(find(&tree, 99) == null);
    }

    test "delete_basic_case" {
        var tree = init();
        // Deleting from an empty tree finds nothing.
        assert(!delete(&tree, 42));
        assert(insert(&tree, 42, 7));
        assert(delete(&tree, 42));
        assert(tree.size == 0);
        assert(find(&tree, 42) == null);
        assert(!delete(&tree, 42));
    }

    test "delete_keeps_balance_and_order" {
        var tree = init();
        var k : i64 = 1;
        while (k <= 15) {
            assert(insert(&tree, k, k));
            k = k + 1;
        }
        assert(height(&tree) == 4);
        // Delete a node with two children (the root) and several leaves.
        assert(delete(&tree, 8));
        assert(delete(&tree, 1));
        assert(delete(&tree, 3));
        assert(tree.size == 12);
        assert(is_balanced(&tree));
        assert(find(&tree, 8) == null);
        assert(find(&tree, 9).? == 9);
        assert(find(&tree, 15).? == 15);
    }

    test "deleted_slot_is_reused" {
        var tree = init();
        assert(insert(&tree, 1, 1));
        assert(insert(&tree, 2, 2));
        const used = tree.used;
        assert(delete(&tree, 1));
        assert(insert(&tree, 3, 3));
        assert(tree.used == used);
        assert(tree.size == 2);
    }

    test "full_pool_rejects_new_key" {
        var tree = init();
        var k : i64 = 0;
        while (k < 64) {
            assert(insert(&tree, k, k));
            k = k + 1;
        }
        assert(tree.size == 64);
        assert(!insert(&tree, 1000, 1));
        assert(tree.size == 64);
        assert(is_balanced(&tree));
    }
