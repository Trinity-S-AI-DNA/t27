// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Answer sum queries in O(log n) | φ² + 1/φ² = 3 | TRINITY

module TriSegmentTree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator, so a tree borrows one of SEG_SLOTS
    // static buffers of 2 * SEG_MAX cells; init takes a free slot and deinit gives
    // it back. At most SEG_SLOTS trees are live at once, and a tree holds at most
    // SEG_MAX elements; a request beyond either limit yields the empty tree.
    // Layout (bottom-up tree): leaves at data[size + i], node i = data[2i] + data[2i+1],
    // node 1 is the root, data[0] is unused.
    pub const SEG_SLOTS : usize = 4;
    pub const SEG_MAX : usize = 1024;
    pub const SEG_NO_SLOT : usize = 4;

    pub const SegmentTree = struct {
        data : []i64,
        size : usize,
        slot : usize,
    };

    var SEG_POOL : [SEG_SLOTS][2 * SEG_MAX]i64 = undefined;
    var SEG_USED : [SEG_SLOTS]bool = [_]bool{ false, false, false, false };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // empty_tree() -> SegmentTree : holds no slot and no cells
    fn empty_tree() -> SegmentTree {
        return SegmentTree{ .data = SEG_POOL[0][0..0], .size = 0, .slot = SEG_NO_SLOT };
    }

    // init(values: []const i64) → SegmentTree
    fn init(values: []const i64) -> SegmentTree {
        const size = values.len;
        if (size > SEG_MAX) {
            return empty_tree();
        }
        var slot: usize = 0;
        while (slot < SEG_SLOTS and SEG_USED[slot]) : (slot += 1) {}
        if (slot >= SEG_SLOTS) {
            return empty_tree();
        }
        SEG_USED[slot] = true;
        const data = SEG_POOL[slot][0 .. size * 2];

        // Build the segment tree
        var i: usize = 0;
        while (i < size) : (i += 1) {
            data[size + i] = values[i];
        }
        if (size > 0) {
            data[0] = 0;
        }
        var node: usize = size;
        while (node > 1) {
            node = node - 1;
            data[node] = data[2 * node] + data[2 * node + 1];
        }

        return SegmentTree{ .data = data, .size = size, .slot = slot };
    }

    // query(tree: *SegmentTree, left: usize, right: usize) → i64 : sum of the elements left..=right
    fn query(tree: *SegmentTree, left: usize, right: usize) -> i64 {
        if (left > right or right >= tree.size) {
            return 0;
        }
        var result: i64 = 0;
        var left_idx = left + tree.size;
        var right_idx = right + tree.size;

        while (left_idx <= right_idx) {
            if (left_idx % 2 == 1) {
                result = result + tree.data[left_idx];
                left_idx = left_idx + 1;
            }
            if (right_idx % 2 == 0) {
                result = result + tree.data[right_idx];
                right_idx = right_idx - 1;
            }
            left_idx = left_idx / 2;
            right_idx = right_idx / 2;
        }

        return result;
    }

    // update(tree: *SegmentTree, index: usize, value: i64) → void
    fn update(tree: *SegmentTree, index: usize, value: i64) -> void {
        if (index >= tree.size) {
            return;
        }
        var i = index + tree.size;
        tree.data[i] = value;

        while (i > 1) {
            i = i / 2;
            tree.data[i] = tree.data[2 * i] + tree.data[2 * i + 1];
        }
    }

    // deinit(tree: *SegmentTree) → void : give the slot back; safe to call twice
    fn deinit(tree: *SegmentTree) -> void {
        if (tree.slot < SEG_SLOTS) {
            SEG_USED[tree.slot] = false;
        }
        tree.data = SEG_POOL[0][0..0];
        tree.size = 0;
        tree.slot = SEG_NO_SLOT;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var tree = init(&[_]i64{ 1, 2, 3, 4 });
        assert(tree.slot != SEG_NO_SLOT);
        assert(tree.size == 4);
        assert(tree.data[4] == 1);  // First leaf node
        assert(tree.data[7] == 4);
        // Internal nodes hold the sums of their children.
        assert(tree.data[3] == 7);
        assert(tree.data[2] == 3);
        assert(tree.data[1] == 10);
        deinit(&tree);
    }

    test query_basic_case {
        var tree = init(&[_]i64{ 1, 2, 3, 4 });
        const result = query(&tree, 0, 2);  // Query first 3 elements: 1 + 2 + 3 = 6
        assert(result == 6);
        deinit(&tree);
    }

    test update_basic_case {
        var tree = init(&[_]i64{ 1, 2, 3, 4 });
        update(&tree, 1, 5);  // Update index 1 to value 5
        assert(query(&tree, 0, 3) == 13);  // 1 + 5 + 3 + 4
        deinit(&tree);
    }

    test deinit_basic_case {
        var tree = init(&[_]i64{ 1, 2, 3, 4 });
        assert(query(&tree, 0, 3) == 10);
        deinit(&tree);
        assert(tree.size == 0);
        assert(tree.slot == SEG_NO_SLOT);
        // A second deinit changes nothing.
        deinit(&tree);
        assert(tree.size == 0);
    }

    test single_elements_and_inclusive_bounds {
        var tree = init(&[_]i64{ 5, -2, 7, 1, 9 });
        assert(query(&tree, 0, 0) == 5);
        assert(query(&tree, 1, 1) == -2);
        assert(query(&tree, 4, 4) == 9);
        assert(query(&tree, 1, 3) == 6);
        assert(query(&tree, 0, 4) == 20);
        deinit(&tree);
    }

    test odd_sizes_match_a_brute_force_sum {
        const values : [11]i64 = [_]i64{ 4, -1, 3, 8, -5, 2, 6, 0, 7, -3, 1 };
        var tree = init(&values);
        assert(tree.size == 11);
        var l: usize = 0;
        while (l < 11) {
            var r: usize = l;
            while (r < 11) {
                var want: i64 = 0;
                var k: usize = l;
                while (k <= r) {
                    want = want + values[k];
                    k = k + 1;
                }
                assert(query(&tree, l, r) == want);
                r = r + 1;
            }
            l = l + 1;
        }
        deinit(&tree);
    }

    test update_keeps_every_range_consistent {
        var vals : [7]i64 = [_]i64{ 1, 2, 3, 4, 5, 6, 7 };
        var tree = init(&vals);
        update(&tree, 6, 100);
        update(&tree, 0, -10);
        vals[6] = 100;
        vals[0] = -10;
        var l: usize = 0;
        while (l < 7) {
            var r: usize = l;
            while (r < 7) {
                var want: i64 = 0;
                var k: usize = l;
                while (k <= r) {
                    want = want + vals[k];
                    k = k + 1;
                }
                assert(query(&tree, l, r) == want);
                r = r + 1;
            }
            l = l + 1;
        }
        deinit(&tree);
    }

    test out_of_range_arguments_are_ignored {
        var tree = init(&[_]i64{ 1, 2, 3 });
        assert(query(&tree, 0, 3) == 0);
        assert(query(&tree, 2, 1) == 0);
        update(&tree, 3, 99);
        assert(query(&tree, 0, 2) == 6);
        deinit(&tree);
    }

    test one_element_and_empty_trees {
        var one = init(&[_]i64{ 42 });
        assert(query(&one, 0, 0) == 42);
        update(&one, 0, 8);
        assert(query(&one, 0, 0) == 8);
        deinit(&one);
        var none = init(&[_]i64{});
        assert(none.size == 0);
        assert(query(&none, 0, 0) == 0);
        deinit(&none);
    }

    test slots_are_limited_and_reused {
        var a = init(&[_]i64{ 1 });
        var b = init(&[_]i64{ 2 });
        var c = init(&[_]i64{ 3 });
        var d = init(&[_]i64{ 4 });
        // All four slots are taken: the next tree is the empty one.
        const e = init(&[_]i64{ 5 });
        assert(e.size == 0);
        assert(e.slot == SEG_NO_SLOT);
        // The trees do not share cells.
        assert(query(&a, 0, 0) == 1);
        assert(query(&d, 0, 0) == 4);
        deinit(&b);
        var again = init(&[_]i64{ 6, 7 });
        assert(again.slot != SEG_NO_SLOT);
        assert(query(&again, 0, 1) == 13);
        deinit(&a);
        deinit(&c);
        deinit(&d);
        deinit(&again);
    }
