// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Use least significant bit for navigation | φ² + 1/φ² = 3 | TRINITY

module TriFenwick;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator, so a tree borrows one of FEN_SLOTS
    // static buffers of FEN_MAX + 1 cells; init takes a free slot and deinit gives
    // it back. At most FEN_SLOTS trees are live at once, and a tree holds at most
    // FEN_MAX elements; a request beyond either limit yields the empty tree.
    pub const FEN_SLOTS : usize = 4;
    pub const FEN_MAX : usize = 1024;
    pub const FEN_NO_SLOT : usize = 4;

    pub const FenwickTree = struct {
        data : []i64,
        size : usize,
        slot : usize,
    };

    var FEN_POOL : [FEN_SLOTS][FEN_MAX + 1]i64 = undefined;
    var FEN_USED : [FEN_SLOTS]bool = [_]bool{ false, false, false, false };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn lowest_bit(i: usize) -> usize {
        return i & (~i + 1);  // i & (-i) kept inside usize
    }

    // empty_tree() -> FenwickTree : holds no slot and no cells
    fn empty_tree() -> FenwickTree {
        return FenwickTree{ .data = FEN_POOL[0][0..0], .size = 0, .slot = FEN_NO_SLOT };
    }

    // init(size: usize) -> FenwickTree
    fn init(size: usize) -> FenwickTree {
        if (size > FEN_MAX) {
            return empty_tree();
        }
        var slot: usize = 0;
        while (slot < FEN_SLOTS and FEN_USED[slot]) : (slot += 1) {}
        if (slot >= FEN_SLOTS) {
            return empty_tree();
        }
        FEN_USED[slot] = true;
        const data = FEN_POOL[slot][0 .. size + 1];
        var i: usize = 0;
        while (i < size + 1) : (i += 1) {
            data[i] = 0;
        }
        return FenwickTree{ .data = data, .size = size, .slot = slot };
    }

    // build(values: []const i64) -> FenwickTree
    fn build(values: []const i64) -> FenwickTree {
        var tree = init(values.len);
        if (tree.slot == FEN_NO_SLOT) {
            return tree;
        }
        var i: usize = 0;
        while (i < values.len) : (i += 1) {
            tree.data[i + 1] = values[i];
        }
        var j: usize = 1;
        while (j <= tree.size) : (j += 1) {
            const parent = j + lowest_bit(j);
            if (parent <= tree.size) {
                tree.data[parent] = tree.data[parent] + tree.data[j];
            }
        }
        return tree;
    }

    // query(tree: *FenwickTree, index: usize) → i64
    fn query(tree: *FenwickTree, index: usize) -> i64 {
        if (index >= tree.size) {
            return 0;
        }
        var i: usize = index + 1;
        var sum: i64 = 0;
        while (i > 0) : (i -= lowest_bit(i)) {
            sum = sum + tree.data[i];
        }
        return sum;
    }

    // range_query(tree: *FenwickTree, from: usize, to: usize) → i64
    fn range_query(tree: *FenwickTree, from: usize, to: usize) -> i64 {
        if (from > to || to >= tree.size) {
            return 0;
        }
        if (from == 0) {
            return query(tree, to);
        }
        return query(tree, to) - query(tree, from - 1);
    }

    // update(tree: *FenwickTree, index: usize, delta: i64) → void
    fn update(tree: *FenwickTree, index: usize, delta: i64) -> void {
        if (index >= tree.size) {
            return;
        }
        var i: usize = index + 1;
        while (i <= tree.size) : (i += lowest_bit(i)) {
            tree.data[i] = tree.data[i] + delta;
        }
    }

    // deinit(tree: *FenwickTree) -> void : give the slot back; safe to call twice
    fn deinit(tree: *FenwickTree) -> void {
        if (tree.slot < FEN_SLOTS) {
            FEN_USED[tree.slot] = false;
        }
        tree.data = FEN_POOL[0][0..0];
        tree.size = 0;
        tree.slot = FEN_NO_SLOT;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "lowest_bit_isolates_the_low_set_bit" {
        assert(lowest_bit(1) == 1);
        assert(lowest_bit(6) == 2);
        assert(lowest_bit(8) == 8);
        assert(lowest_bit(12) == 4);
    }

    test "init_allocates_size_plus_one_slots_all_zero" {
        var tree = init(5);
        assert(tree.data.len == 6);
        assert(tree.size == 5);
        assert(tree.data[0] == 0);
        assert(tree.data[1] == 0);
        assert(tree.data[2] == 0);
        assert(tree.data[3] == 0);
        assert(tree.data[4] == 0);
        assert(tree.data[5] == 0);
        deinit(&tree);
    }

    test "the_sentinel_slot_stays_zero_after_build" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(tree.data[0] == 0);
        deinit(&tree);
    }

    test "build_fills_the_tree_array_with_the_expected_partial_sums" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(tree.data.len == 9);
        assert(tree.data[0] == 0);
        assert(tree.data[1] == 3);
        assert(tree.data[2] == 5);
        assert(tree.data[3] == -1);
        assert(tree.data[4] == 10);
        assert(tree.data[5] == 5);
        assert(tree.data[6] == 9);
        assert(tree.data[7] == -3);
        assert(tree.data[8] == 19);
        deinit(&tree);
    }

    test "query_returns_the_inclusive_prefix_sum" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(query(&tree, 0) == 3);
        assert(query(&tree, 4) == 15);
        assert(query(&tree, 7) == 19);
        deinit(&tree);
    }

    test "query_at_index_zero_returns_the_first_element" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(query(&tree, 0) == 3);
        deinit(&tree);
    }

    test "query_past_the_last_index_returns_zero" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(query(&tree, 8) == 0);
        assert(query(&tree, 100) == 0);
        deinit(&tree);
    }

    test "range_query_is_inclusive_at_both_ends" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(range_query(&tree, 2, 5) == 14);
        deinit(&tree);
    }

    test "range_query_from_zero_equals_query" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(range_query(&tree, 0, 4) == query(&tree, 4));
        assert(range_query(&tree, 0, 7) == query(&tree, 7));
        deinit(&tree);
    }

    test "range_query_with_from_greater_than_to_returns_zero" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        assert(range_query(&tree, 5, 2) == 0);
        assert(range_query(&tree, 7, 3) == 0);
        deinit(&tree);
    }

    test "update_touches_three_slots_and_moves_every_prefix_past_it" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        update(&tree, 2, 4);
        assert(tree.data[3] == 3);
        assert(tree.data[4] == 14);
        assert(tree.data[8] == 23);
        assert(tree.data[5] == 5);
        assert(query(&tree, 4) == 19);
        deinit(&tree);
    }

    test "update_past_the_last_index_changes_nothing" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        const old_data = tree.data[8];
        update(&tree, 8, 10);
        assert(tree.data[8] == old_data);
        deinit(&tree);
    }

    test "deinit_leaves_an_empty_tree_and_is_idempotent" {
        var tree = build(&[_]i64{ 3, 2, -1, 6, 5, 4, -3, 3 });
        deinit(&tree);
        assert(tree.data.len == 0);
        assert(tree.size == 0);
        // Second deinit should be harmless
        deinit(&tree);
        assert(tree.data.len == 0);
        assert(tree.size == 0);
    }

    test "a_zero_sized_tree_answers_zero_to_everything" {
        var tree = init(0);
        assert(tree.data.len == 1);
        assert(tree.size == 0);
        assert(query(&tree, 0) == 0);
        assert(query(&tree, 100) == 0);
        assert(range_query(&tree, 0, 0) == 0);
        assert(range_query(&tree, 0, 100) == 0);
        assert(range_query(&tree, 100, 200) == 0);
        update(&tree, 0, 10);
        assert(query(&tree, 0) == 0);
        deinit(&tree);
    }
