// t27/specs/
// O(k) lookup where k = key length | φ² + 1/φ² = 3 | TRINITY

module TriTrie;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator, no generics and no hash map, so the
    // value type T is i64 and the trie lives in a fixed pool of TR_NODES nodes
    // addressed by index (TR_NIL = -1 is the null link). Children are a singly
    // linked list per node (first / next), kept sorted by byte, so keys come out
    // in lexicographic order. Freed nodes are threaded through `next`.
    // Keys are byte strings of at most TR_KEY_MAX bytes. keys_with_prefix copies
    // its answers into static storage (read them with key_at) that stays valid
    // until the next call of keys_with_prefix.
    pub const TR_NODES : usize = 128;
    pub const TR_KEY_MAX : usize = 16;
    pub const TR_MAX_KEYS : usize = 32;
    pub const TR_NIL : i32 = -1;

    pub const TrieNode = struct {
        ch : u8,
        is_end : bool,
        value : i64,
        first : i32,
        next : i32,
    };

    pub const Trie = struct {
        root : i32,
        size : usize,
        used : usize,
        live : usize,
        free_head : i32,
        nodes : [TR_NODES]TrieNode,
    };

    var TR_PATH : [TR_KEY_MAX]u8 = undefined;
    var TR_KEYS : [TR_MAX_KEYS][TR_KEY_MAX]u8 = undefined;
    var TR_KEY_LEN : [TR_MAX_KEYS]usize = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // at(n) -> usize : pool index of a non-nil link
    fn at(n: i32) -> usize {
        return @as(usize, @intCast(n));
    }

    // alloc_node(trie, ch) -> i32 : a fresh childless node, TR_NIL when the pool is full
    fn alloc_node(trie: *Trie, ch: u8) -> i32 {
        var idx : i32 = TR_NIL;
        if (trie.free_head != TR_NIL) {
            idx = trie.free_head;
            trie.free_head = trie.nodes[at(idx)].next;
        } else {
            if (trie.used >= TR_NODES) {
                return TR_NIL;
            }
            idx = @as(i32, @intCast(trie.used));
            trie.used = trie.used + 1;
        }
        const i = at(idx);
        trie.nodes[i].ch = ch;
        trie.nodes[i].is_end = false;
        trie.nodes[i].value = 0;
        trie.nodes[i].first = TR_NIL;
        trie.nodes[i].next = TR_NIL;
        trie.live = trie.live + 1;
        return idx;
    }

    // release_node(trie, n) : give one node back to the free list
    fn release_node(trie: *Trie, n: i32) -> void {
        trie.nodes[at(n)].next = trie.free_head;
        trie.free_head = n;
        trie.live = trie.live - 1;
    }

    // empty() → Trie
    fn empty() -> Trie {
        var trie : Trie = undefined;
        trie.root = TR_NIL;
        trie.size = 0;
        trie.used = 0;
        trie.live = 0;
        trie.free_head = TR_NIL;
        trie.root = alloc_node(&trie, 0);
        return trie;
    }

    // find_child(trie, n, ch) -> i32 : the child of n labelled ch, or TR_NIL
    fn find_child(trie: *Trie, n: i32, ch: u8) -> i32 {
        var c = trie.nodes[at(n)].first;
        while (c != TR_NIL) {
            if (trie.nodes[at(c)].ch == ch) {
                return c;
            }
            if (trie.nodes[at(c)].ch > ch) {
                return TR_NIL;
            }
            c = trie.nodes[at(c)].next;
        }
        return TR_NIL;
    }

    // add_child(trie, n, ch) -> i32 : insert a new child of n keeping the list sorted
    fn add_child(trie: *Trie, n: i32, ch: u8) -> i32 {
        const c = alloc_node(trie, ch);
        if (c == TR_NIL) {
            return TR_NIL;
        }
        var prev : i32 = TR_NIL;
        var cur = trie.nodes[at(n)].first;
        while (cur != TR_NIL and trie.nodes[at(cur)].ch < ch) {
            prev = cur;
            cur = trie.nodes[at(cur)].next;
        }
        trie.nodes[at(c)].next = cur;
        if (prev == TR_NIL) {
            trie.nodes[at(n)].first = c;
        } else {
            trie.nodes[at(prev)].next = c;
        }
        return c;
    }

    // walk(trie, key) -> i32 : the node reached by following key from the root, or TR_NIL
    fn walk(trie: *Trie, key: []const u8) -> i32 {
        if (trie.root == TR_NIL) {
            return TR_NIL;
        }
        var node = trie.root;
        var i : usize = 0;
        while (i < key.len) {
            node = find_child(trie, node, key[i]);
            if (node == TR_NIL) {
                return TR_NIL;
            }
            i = i + 1;
        }
        return node;
    }

    // insert(trie: *Trie, key: []const u8, value: i64) → bool
    // Stores value under key (replacing an older value). False when the key is
    // longer than TR_KEY_MAX or the pool cannot hold the nodes it needs.
    fn insert(trie: *Trie, key: []const u8, value: i64) -> bool {
        if (trie.root == TR_NIL or key.len > TR_KEY_MAX) {
            return false;
        }
        // Count the nodes the new part of the path needs, before touching anything.
        var node = trie.root;
        var matched : usize = 0;
        while (matched < key.len) {
            const next = find_child(trie, node, key[matched]);
            if (next == TR_NIL) {
                break;
            }
            node = next;
            matched = matched + 1;
        }
        if (trie.live + (key.len - matched) > TR_NODES) {
            return false;
        }
        while (matched < key.len) {
            node = add_child(trie, node, key[matched]);
            matched = matched + 1;
        }
        if (!trie.nodes[at(node)].is_end) {
            trie.nodes[at(node)].is_end = true;
            trie.size = trie.size + 1;
        }
        trie.nodes[at(node)].value = value;
        return true;
    }

    // get(trie: *Trie, key: []const u8) → ?i64
    fn get(trie: *Trie, key: []const u8) -> ?i64 {
        const node = walk(trie, key);
        if (node == TR_NIL) {
            return null;
        }
        if (!trie.nodes[at(node)].is_end) {
            return null;
        }
        return trie.nodes[at(node)].value;
    }

    // has_prefix(trie: *Trie, prefix: []const u8) → bool : some stored key starts with prefix
    fn has_prefix(trie: *Trie, prefix: []const u8) -> bool {
        const node = walk(trie, prefix);
        if (node == TR_NIL) {
            return false;
        }
        // Removal prunes dead branches, so a node with no key at or below it is the empty root.
        return trie.nodes[at(node)].is_end or trie.nodes[at(node)].first != TR_NIL;
    }

    // collect_keys_from_node(trie, n, depth, count) → void
    // Append every key at or below n to TR_KEYS; TR_PATH[0..depth] spells the path to n.
    fn collect_keys_from_node(trie: *Trie, n: i32, depth: usize, count: *usize) -> void {
        if (trie.nodes[at(n)].is_end and count.* < TR_MAX_KEYS) {
            var i : usize = 0;
            while (i < depth) {
                TR_KEYS[count.*][i] = TR_PATH[i];
                i = i + 1;
            }
            TR_KEY_LEN[count.*] = depth;
            count.* = count.* + 1;
        }
        if (depth >= TR_KEY_MAX) {
            return;
        }
        var c = trie.nodes[at(n)].first;
        while (c != TR_NIL) {
            TR_PATH[depth] = trie.nodes[at(c)].ch;
            collect_keys_from_node(trie, c, depth + 1, count);
            c = trie.nodes[at(c)].next;
        }
    }

    // keys_with_prefix(trie: *Trie, prefix: []const u8) → usize
    // Number of stored keys that start with prefix (at most TR_MAX_KEYS are copied
    // out, in lexicographic order; read them with key_at).
    fn keys_with_prefix(trie: *Trie, prefix: []const u8) -> usize {
        const node = walk(trie, prefix);
        if (node == TR_NIL) {
            return 0;
        }
        var i : usize = 0;
        while (i < prefix.len) {
            TR_PATH[i] = prefix[i];
            i = i + 1;
        }
        var count : usize = 0;
        collect_keys_from_node(trie, node, prefix.len, &count);
        return count;
    }

    // key_at(i) -> []const u8 : the i-th key found by the last keys_with_prefix
    fn key_at(i: usize) -> []const u8 {
        return TR_KEYS[i][0..TR_KEY_LEN[i]];
    }

    // remove_at(trie, n, key, i, removed) -> bool : true when n has become dead
    // (no key at or below it) and its parent should drop it.
    fn remove_at(trie: *Trie, n: i32, key: []const u8, i: usize, removed: *bool) -> bool {
        if (i == key.len) {
            if (trie.nodes[at(n)].is_end) {
                trie.nodes[at(n)].is_end = false;
                trie.size = trie.size - 1;
                removed.* = true;
            }
        } else {
            const c = find_child(trie, n, key[i]);
            if (c != TR_NIL) {
                if (remove_at(trie, c, key, i + 1, removed)) {
                    // Unlink c from the child list of n.
                    if (trie.nodes[at(n)].first == c) {
                        trie.nodes[at(n)].first = trie.nodes[at(c)].next;
                    } else {
                        var p = trie.nodes[at(n)].first;
                        while (trie.nodes[at(p)].next != c) {
                            p = trie.nodes[at(p)].next;
                        }
                        trie.nodes[at(p)].next = trie.nodes[at(c)].next;
                    }
                    release_node(trie, c);
                }
            }
        }
        return !trie.nodes[at(n)].is_end and trie.nodes[at(n)].first == TR_NIL;
    }

    // remove(trie: *Trie, key: []const u8) → bool : true when key was present
    fn remove(trie: *Trie, key: []const u8) -> bool {
        if (trie.root == TR_NIL) {
            return false;
        }
        var removed = false;
        _ = remove_at(trie, trie.root, key, 0, &removed);
        return removed;
    }

    // free_node_children(trie: *Trie, n: i32) → void : drop everything below n
    fn free_node_children(trie: *Trie, n: i32) -> void {
        var c = trie.nodes[at(n)].first;
        while (c != TR_NIL) {
            const next = trie.nodes[at(c)].next;
            free_node_recursive(trie, c);
            release_node(trie, c);
            c = next;
        }
        trie.nodes[at(n)].first = TR_NIL;
    }

    // free_node_recursive(trie: *Trie, n: i32) → void
    // Free the subtree below n and forget the keys in it, including the key at n
    // itself; the node n is released by the caller.
    fn free_node_recursive(trie: *Trie, n: i32) -> void {
        free_node_children(trie, n);
        if (trie.nodes[at(n)].is_end) {
            trie.nodes[at(n)].is_end = false;
            trie.size = trie.size - 1;
        }
    }

    // deinit(trie: *Trie) → void
    fn deinit(trie: *Trie) -> void {
        trie.root = TR_NIL;
        trie.size = 0;
        trie.used = 0;
        trie.live = 0;
        trie.free_head = TR_NIL;
    }

    fn bytes_eq(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var i : usize = 0;
        while (i < a.len) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test empty_basic_case {
        var trie = empty();
        assert(trie.root != TR_NIL);
        assert(trie.size == 0);
        assert(trie.live == 1);
        assert(get(&trie, "key") == null);
        assert(!has_prefix(&trie, ""));
        assert(keys_with_prefix(&trie, "") == 0);
    }

    test insert_basic_case {
        var trie = empty();
        assert(insert(&trie, "key", 7));
        assert(trie.size == 1);
        assert(get(&trie, "key").? == 7);
        // Inserting the same key again replaces the value and keeps the size.
        assert(insert(&trie, "key", 9));
        assert(trie.size == 1);
        assert(get(&trie, "key").? == 9);
        // A key longer than TR_KEY_MAX is refused and changes nothing.
        assert(!insert(&trie, "this key is far too long", 1));
        assert(trie.size == 1);
    }

    test get_basic_case {
        var trie = empty();
        assert(insert(&trie, "key", 7));
        assert(insert(&trie, "keyboard", 8));
        assert(get(&trie, "key").? == 7);
        assert(get(&trie, "keyboard").? == 8);
        // A strict prefix of a key, an extension of it and an unrelated word are not keys.
        assert(get(&trie, "ke") == null);
        assert(get(&trie, "keys") == null);
        assert(get(&trie, "door") == null);
    }

    test has_prefix_basic_case {
        var trie = empty();
        assert(insert(&trie, "prefix", 1));
        assert(has_prefix(&trie, ""));
        assert(has_prefix(&trie, "pre"));
        assert(has_prefix(&trie, "prefix"));
        assert(!has_prefix(&trie, "prefixes"));
        assert(!has_prefix(&trie, "post"));
    }

    test keys_with_prefix_basic_case {
        var trie = empty();
        assert(insert(&trie, "pre", 1));
        assert(insert(&trie, "prefix", 2));
        assert(insert(&trie, "present", 3));
        assert(insert(&trie, "other", 4));
        assert(keys_with_prefix(&trie, "pre") == 3);
        // Lexicographic order, the prefix itself first.
        assert(bytes_eq(key_at(0), "pre"));
        assert(bytes_eq(key_at(1), "prefix"));
        assert(bytes_eq(key_at(2), "present"));
        assert(keys_with_prefix(&trie, "pref") == 1);
        assert(bytes_eq(key_at(0), "prefix"));
        assert(keys_with_prefix(&trie, "") == 4);
        assert(bytes_eq(key_at(0), "other"));
        assert(keys_with_prefix(&trie, "zzz") == 0);
    }

    test remove_basic_case {
        var trie = empty();
        assert(insert(&trie, "key", 1));
        assert(insert(&trie, "keyboard", 2));
        assert(!remove(&trie, "ke"));
        assert(!remove(&trie, "missing"));
        assert(remove(&trie, "key"));
        assert(trie.size == 1);
        assert(get(&trie, "key") == null);
        // The longer key that shares the path survives.
        assert(get(&trie, "keyboard").? == 2);
        assert(has_prefix(&trie, "key"));
        assert(!remove(&trie, "key"));
    }

    test removing_prunes_dead_branches_and_reuses_nodes {
        var trie = empty();
        assert(insert(&trie, "abc", 1));
        assert(trie.live == 4);
        assert(remove(&trie, "abc"));
        // The whole branch is gone, only the root is left.
        assert(trie.live == 1);
        assert(!has_prefix(&trie, "a"));
        assert(!has_prefix(&trie, ""));
        const used_before = trie.used;
        assert(insert(&trie, "xyz", 2));
        // The freed nodes were taken from the free list.
        assert(trie.used == used_before);
        assert(trie.live == 4);
    }

    test collect_keys_from_node_basic_case {
        var trie = empty();
        assert(insert(&trie, "a", 1));
        assert(insert(&trie, "ab", 2));
        var count : usize = 0;
        collect_keys_from_node(&trie, trie.root, 0, &count);
        assert(count >= 0);
        assert(count == 2);
        assert(bytes_eq(key_at(0), "a"));
        assert(bytes_eq(key_at(1), "ab"));
    }

    test free_node_children_basic_case {
        var trie = empty();
        assert(insert(&trie, "key", 1));
        assert(insert(&trie, "kite", 2));
        free_node_children(&trie, trie.root);
        assert(trie.nodes[at(trie.root)].first == TR_NIL);
        assert(trie.size == 0);
        assert(trie.live == 1);
        assert(get(&trie, "key") == null);
    }

    test free_node_recursive_basic_case {
        var trie = empty();
        assert(insert(&trie, "key", 1));
        free_node_recursive(&trie, trie.root);
        assert(trie.root != TR_NIL);
        assert(trie.size == 0);
        assert(trie.live == 1);
        // The trie is still usable afterwards.
        assert(insert(&trie, "again", 5));
        assert(get(&trie, "again").? == 5);
    }

    test deinit_basic_case {
        var trie = empty();
        assert(insert(&trie, "key", 1));
        deinit(&trie);
        assert(trie.root == TR_NIL);
        assert(trie.size == 0);
        assert(get(&trie, "key") == null);
        assert(!insert(&trie, "key", 1));
    }

    test the_empty_key_is_a_key {
        var trie = empty();
        assert(insert(&trie, "", 3));
        assert(trie.size == 1);
        assert(get(&trie, "").? == 3);
        assert(has_prefix(&trie, ""));
        assert(remove(&trie, ""));
        assert(trie.size == 0);
        assert(get(&trie, "") == null);
    }

    test insert_fails_when_the_pool_is_full {
        var trie = empty();
        // Distinct 3-byte keys each need about 3 fresh nodes until the pool of 128 runs out.
        var ok : usize = 0;
        var k : usize = 0;
        while (k < 100) {
            var key : [3]u8 = undefined;
            key[0] = @as(u8, @intCast(97 + (k % 10)));
            key[1] = @as(u8, @intCast(97 + ((k / 10) % 10)));
            key[2] = @as(u8, @intCast(97 + ((k * 7) % 26)));
            if (insert(&trie, &key, @as(i64, @intCast(k)))) {
                ok = ok + 1;
            }
            k = k + 1;
        }
        // All 100 keys are distinct and need 211 nodes, so some inserts were refused.
        assert(ok > 0);
        assert(ok < 100);
        assert(trie.live <= TR_NODES);
        assert(trie.size == ok);
        // A key that needs 12 fresh nodes does not fit any more, and the refusal changes nothing.
        const live_before = trie.live;
        assert(!insert(&trie, "zzzzzzzzzzzz", 1));
        assert(trie.live == live_before);
        assert(trie.size == ok);
    }
