// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// 1) Root is black 2) Red children are black 3) Equal black depth to all leaves | φ² + 1/φ² = 3 | TRINITY

module TriRbTree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator and no nullable pointers, so the tree
    // is a fixed pool of RB_CAP nodes addressed by index; RB_NIL (-1) is the null
    // link and deleted slots are chained through `left` into a free list. Keys and
    // values are i64 (the old spec was generic over K, V and its tests used
    // strings). The balancing is left-leaning red-black (Sedgewick), which keeps
    // the three rules named above: a black root, no red node with a red child,
    // and the same number of black nodes on every path to a leaf. There are no
    // parent links; the recursion carries the path.
    pub const RB_CAP : usize = 64;
    pub const RB_NIL : i32 = -1;

    pub const Color = enum(u8) {
        RED,
        BLACK,
    };

    pub const RBNode = struct {
        key : i64,
        value : i64,
        color : Color,
        left : i32,
        right : i32,
    };

    pub const RBTree = struct {
        root : i32,
        size : usize,
        used : usize,
        free_head : i32,
        nodes : [RB_CAP]RBNode,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // at(n) -> usize : pool index of a non-nil link
    fn at(n: i32) -> usize {
        return @as(usize, @intCast(n));
    }

    // init() -> RBTree
    fn init() -> RBTree {
        var t : RBTree = undefined;
        t.root = RB_NIL;
        t.size = 0;
        t.used = 0;
        t.free_head = RB_NIL;
        return t;
    }

    // is_red(tree, n) -> bool : nil links are black
    fn is_red(tree: *RBTree, n: i32) -> bool {
        if (n == RB_NIL) {
            return false;
        }
        return tree.nodes[at(n)].color == Color.RED;
    }

    fn left_of(tree: *RBTree, n: i32) -> i32 {
        if (n == RB_NIL) {
            return RB_NIL;
        }
        return tree.nodes[at(n)].left;
    }

    fn right_of(tree: *RBTree, n: i32) -> i32 {
        if (n == RB_NIL) {
            return RB_NIL;
        }
        return tree.nodes[at(n)].right;
    }

    fn flip(c: Color) -> Color {
        if (c == Color.RED) {
            return Color.BLACK;
        }
        return Color.RED;
    }

    // rotate_left(tree, h) -> i32 : new subtree root
    fn rotate_left(tree: *RBTree, h: i32) -> i32 {
        const x = tree.nodes[at(h)].right;
        tree.nodes[at(h)].right = tree.nodes[at(x)].left;
        tree.nodes[at(x)].left = h;
        tree.nodes[at(x)].color = tree.nodes[at(h)].color;
        tree.nodes[at(h)].color = Color.RED;
        return x;
    }

    // rotate_right(tree, h) -> i32 : new subtree root
    fn rotate_right(tree: *RBTree, h: i32) -> i32 {
        const x = tree.nodes[at(h)].left;
        tree.nodes[at(h)].left = tree.nodes[at(x)].right;
        tree.nodes[at(x)].right = h;
        tree.nodes[at(x)].color = tree.nodes[at(h)].color;
        tree.nodes[at(h)].color = Color.RED;
        return x;
    }

    // flip_colors(tree, h) : h and both children change colour
    fn flip_colors(tree: *RBTree, h: i32) -> void {
        tree.nodes[at(h)].color = flip(tree.nodes[at(h)].color);
        const l = tree.nodes[at(h)].left;
        const r = tree.nodes[at(h)].right;
        tree.nodes[at(l)].color = flip(tree.nodes[at(l)].color);
        tree.nodes[at(r)].color = flip(tree.nodes[at(r)].color);
    }

    // fix_up(tree, h) -> i32 : restore the left-leaning invariants at h
    fn fix_up(tree: *RBTree, h0: i32) -> i32 {
        var h = h0;
        if (is_red(tree, right_of(tree, h)) and !is_red(tree, left_of(tree, h))) {
            h = rotate_left(tree, h);
        }
        if (is_red(tree, left_of(tree, h)) and is_red(tree, left_of(tree, left_of(tree, h)))) {
            h = rotate_right(tree, h);
        }
        if (is_red(tree, left_of(tree, h)) and is_red(tree, right_of(tree, h))) {
            flip_colors(tree, h);
        }
        return h;
    }

    // alloc_node(tree, key, value) -> i32 : a red node, RB_NIL when the pool is full
    fn alloc_node(tree: *RBTree, key: i64, value: i64) -> i32 {
        var idx : i32 = RB_NIL;
        if (tree.free_head != RB_NIL) {
            idx = tree.free_head;
            tree.free_head = tree.nodes[at(idx)].left;
        } else {
            if (tree.used >= RB_CAP) {
                return RB_NIL;
            }
            idx = @as(i32, @intCast(tree.used));
            tree.used = tree.used + 1;
        }
        tree.nodes[at(idx)] = RBNode { key = key, value = value, color = Color.RED, left = RB_NIL, right = RB_NIL };
        tree.size = tree.size + 1;
        return idx;
    }

    // free_node(tree, n) : return a slot to the free list
    fn free_node(tree: *RBTree, n: i32) -> void {
        tree.nodes[at(n)].left = tree.free_head;
        tree.free_head = n;
        tree.size = tree.size - 1;
    }

    fn insert_at(tree: *RBTree, h: i32, key: i64, value: i64) -> i32 {
        if (h == RB_NIL) {
            return alloc_node(tree, key, value);
        }
        const i = at(h);
        if (key == tree.nodes[i].key) {
            tree.nodes[i].value = value;
        } else {
            if (key < tree.nodes[i].key) {
                tree.nodes[i].left = insert_at(tree, tree.nodes[i].left, key, value);
            } else {
                tree.nodes[i].right = insert_at(tree, tree.nodes[i].right, key, value);
            }
        }
        return fix_up(tree, h);
    }

    // insert(tree: *RBTree, key: i64, value: i64) -> bool
    // Replaces the value of an existing key. Returns false only when the pool
    // is full and the key is new.
    fn insert(tree: *RBTree, key: i64, value: i64) -> bool {
        const known = contains(tree, key);
        tree.root = insert_at(tree, tree.root, key, value);
        if (tree.root != RB_NIL) {
            tree.nodes[at(tree.root)].color = Color.BLACK;
        }
        if (known) {
            return true;
        }
        return contains(tree, key);
    }

    // find(tree: *RBTree, key: i64) -> ?i64
    fn find(tree: *RBTree, key: i64) -> ?i64 {
        var current = tree.root;
        while (current != RB_NIL) {
            const i = at(current);
            if (key == tree.nodes[i].key) {
                return tree.nodes[i].value;
            }
            if (key < tree.nodes[i].key) {
                current = tree.nodes[i].left;
            } else {
                current = tree.nodes[i].right;
            }
        }
        return null;
    }

    // contains(tree: *RBTree, key: i64) -> bool
    fn contains(tree: *RBTree, key: i64) -> bool {
        var current = tree.root;
        while (current != RB_NIL) {
            const i = at(current);
            if (key == tree.nodes[i].key) {
                return true;
            }
            if (key < tree.nodes[i].key) {
                current = tree.nodes[i].left;
            } else {
                current = tree.nodes[i].right;
            }
        }
        return false;
    }

    // move_red_left(tree, h) -> i32 : make h.left or one of its children red
    fn move_red_left(tree: *RBTree, h0: i32) -> i32 {
        var h = h0;
        flip_colors(tree, h);
        if (is_red(tree, left_of(tree, tree.nodes[at(h)].right))) {
            tree.nodes[at(h)].right = rotate_right(tree, tree.nodes[at(h)].right);
            h = rotate_left(tree, h);
            flip_colors(tree, h);
        }
        return h;
    }

    // move_red_right(tree, h) -> i32 : make h.right or one of its children red
    fn move_red_right(tree: *RBTree, h0: i32) -> i32 {
        var h = h0;
        flip_colors(tree, h);
        if (is_red(tree, left_of(tree, tree.nodes[at(h)].left))) {
            h = rotate_right(tree, h);
            flip_colors(tree, h);
        }
        return h;
    }

    fn min_node(tree: *RBTree, h: i32) -> i32 {
        var x = h;
        while (tree.nodes[at(x)].left != RB_NIL) {
            x = tree.nodes[at(x)].left;
        }
        return x;
    }

    fn delete_min_at(tree: *RBTree, h0: i32) -> i32 {
        var h = h0;
        if (tree.nodes[at(h)].left == RB_NIL) {
            free_node(tree, h);
            return RB_NIL;
        }
        const l = tree.nodes[at(h)].left;
        if (!is_red(tree, l) and !is_red(tree, left_of(tree, l))) {
            h = move_red_left(tree, h);
        }
        tree.nodes[at(h)].left = delete_min_at(tree, tree.nodes[at(h)].left);
        return fix_up(tree, h);
    }

    fn delete_at(tree: *RBTree, h0: i32, key: i64) -> i32 {
        var h = h0;
        if (key < tree.nodes[at(h)].key) {
            const l = tree.nodes[at(h)].left;
            if (!is_red(tree, l) and !is_red(tree, left_of(tree, l))) {
                h = move_red_left(tree, h);
            }
            tree.nodes[at(h)].left = delete_at(tree, tree.nodes[at(h)].left, key);
        } else {
            if (is_red(tree, tree.nodes[at(h)].left)) {
                h = rotate_right(tree, h);
            }
            if (key == tree.nodes[at(h)].key and tree.nodes[at(h)].right == RB_NIL) {
                free_node(tree, h);
                return RB_NIL;
            }
            const r = tree.nodes[at(h)].right;
            if (!is_red(tree, r) and !is_red(tree, left_of(tree, r))) {
                h = move_red_right(tree, h);
            }
            if (key == tree.nodes[at(h)].key) {
                const m = min_node(tree, tree.nodes[at(h)].right);
                tree.nodes[at(h)].key = tree.nodes[at(m)].key;
                tree.nodes[at(h)].value = tree.nodes[at(m)].value;
                tree.nodes[at(h)].right = delete_min_at(tree, tree.nodes[at(h)].right);
            } else {
                tree.nodes[at(h)].right = delete_at(tree, tree.nodes[at(h)].right, key);
            }
        }
        return fix_up(tree, h);
    }

    // delete(tree: *RBTree, key: i64) -> bool
    fn delete(tree: *RBTree, key: i64) -> bool {
        if (!contains(tree, key)) {
            return false;
        }
        if (!is_red(tree, left_of(tree, tree.root)) and !is_red(tree, right_of(tree, tree.root))) {
            tree.nodes[at(tree.root)].color = Color.RED;
        }
        tree.root = delete_at(tree, tree.root, key);
        if (tree.root != RB_NIL) {
            tree.nodes[at(tree.root)].color = Color.BLACK;
        }
        return true;
    }

    // black_height_at(tree, n) -> i32 : black nodes on every path below n,
    // or -1 when two paths disagree or a red node has a red child
    fn black_height_at(tree: *RBTree, n: i32) -> i32 {
        if (n == RB_NIL) {
            return 1;
        }
        const l = tree.nodes[at(n)].left;
        const r = tree.nodes[at(n)].right;
        if (is_red(tree, n) and (is_red(tree, l) or is_red(tree, r))) {
            return -1;
        }
        const lh = black_height_at(tree, l);
        const rh = black_height_at(tree, r);
        if (lh < 0 or rh < 0 or lh != rh) {
            return -1;
        }
        if (is_red(tree, n)) {
            return lh;
        }
        return lh + 1;
    }

    // is_valid(tree: *RBTree) -> bool : the three red-black rules hold
    fn is_valid(tree: *RBTree) -> bool {
        if (tree.root == RB_NIL) {
            return true;
        }
        if (is_red(tree, tree.root)) {
            return false;
        }
        return black_height_at(tree, tree.root) > 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_creates_empty_tree {
        var tree = init();
        assert(tree.root == RB_NIL);
        assert(tree.size == 0);
        assert(is_valid(&tree));
    }

    test insert_adds_to_empty_tree {
        var tree = init();
        assert(insert(&tree, 1, 101));
        assert(tree.size == 1);
        assert(tree.root != RB_NIL);
        assert(find(&tree, 1).? == 101);
        // The root is black.
        assert(!is_red(&tree, tree.root));
    }

    test insert_multiple_nodes {
        var tree = init();
        assert(insert(&tree, 1, 101));
        assert(insert(&tree, 2, 102));
        assert(insert(&tree, 3, 103));
        assert(tree.size == 3);
        assert(find(&tree, 1).? == 101);
        assert(find(&tree, 2).? == 102);
        assert(find(&tree, 3).? == 103);
        assert(is_valid(&tree));
    }

    test insert_existing_key_replaces_value {
        var tree = init();
        assert(insert(&tree, 5, 1));
        assert(insert(&tree, 5, 2));
        assert(tree.size == 1);
        assert(find(&tree, 5).? == 2);
    }

    test find_existing_key {
        var tree = init();
        assert(insert(&tree, 1, 101));
        assert(insert(&tree, 2, 102));
        assert(find(&tree, 1).? == 101);
        assert(find(&tree, 2).? == 102);
    }

    test find_nonexistent_key {
        var tree = init();
        assert(insert(&tree, 1, 101));
        assert(find(&tree, 99) == null);
    }

    test delete_existing_key {
        var tree = init();
        assert(insert(&tree, 1, 101));
        assert(insert(&tree, 2, 102));
        assert(delete(&tree, 1) == true);
        assert(tree.size == 1);
        assert(find(&tree, 1) == null);
        assert(find(&tree, 2).? == 102);
        assert(is_valid(&tree));
    }

    test delete_nonexistent_key {
        var tree = init();
        assert(insert(&tree, 1, 101));
        assert(delete(&tree, 99) == false);
        assert(tree.size == 1);
    }

    test ascending_inserts_keep_rules {
        // A plain BST would be a list of 40; the red-black rules force a short tree.
        var tree = init();
        var k : i64 = 1;
        while (k <= 40) {
            assert(insert(&tree, k, k * 2));
            assert(is_valid(&tree));
            k = k + 1;
        }
        assert(tree.size == 40);
        k = 1;
        while (k <= 40) {
            assert(find(&tree, k).? == k * 2);
            k = k + 1;
        }
    }

    test deletes_keep_rules {
        var tree = init();
        var k : i64 = 1;
        while (k <= 30) {
            assert(insert(&tree, k, k));
            k = k + 1;
        }
        // Remove every third key, then the rest from the top, checking the rules each time.
        k = 3;
        while (k <= 30) {
            assert(delete(&tree, k));
            assert(is_valid(&tree));
            assert(find(&tree, k) == null);
            k = k + 3;
        }
        assert(tree.size == 20);
        assert(find(&tree, 4).? == 4);
        k = 30;
        while (k >= 1) {
            if (@rem(k, 3) != 0) {
                assert(delete(&tree, k));
                assert(is_valid(&tree));
            }
            k = k - 1;
        }
        assert(tree.size == 0);
        assert(tree.root == RB_NIL);
    }

    test deleted_slot_is_reused {
        var tree = init();
        assert(insert(&tree, 1, 1));
        assert(insert(&tree, 2, 2));
        const used = tree.used;
        assert(delete(&tree, 1));
        assert(insert(&tree, 3, 3));
        assert(tree.used == used);
        assert(tree.size == 2);
    }

    test full_pool_rejects_new_key {
        var tree = init();
        var k : i64 = 0;
        while (k < 64) {
            assert(insert(&tree, k, k));
            k = k + 1;
        }
        assert(tree.size == 64);
        assert(!insert(&tree, 1000, 1));
        assert(tree.size == 64);
        assert(is_valid(&tree));
    }
