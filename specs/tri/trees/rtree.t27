// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Spatial indexing | φ² + 1/φ² = 3 | TRINITY

module TriRtree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Rect = struct {
        x_min : f64,
        y_min : f64,
        x_max : f64,
        y_max : f64,
    };

    pub const RTreeNode = struct {
        rect : Rect,
        child1 : ?RTreeNode,
        child2 : ?RTreeNode,
        child3 : ?RTreeNode,
        child4 : ?RTreeNode,
        is_leaf : bool,
    };

    pub const RTree = struct {
        root : ?RTreeNode,
        max_entries : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(max_entries: usize) -> void
    fn init(max_entries: usize) -> RTree {
        RTree {
            root = null,
            max_entries = max_entries,
        }
    }

    // insert(tree: *RTree, rect: Rect) -> void
    fn insert(tree: *RTree, rect: Rect) -> void {
        if (tree.root == null) {
            // Create root node as leaf
            tree.root = RTreeNode {
                rect = rect,
                child1 = null,
                child2 = null,
                child3 = null,
                child4 = null,
                is_leaf = true,
            };
        } else {
            // Insert into the tree by adding to root's children
            let new_child = RTreeNode {
                rect = rect,
                child1 = null,
                child2 = null,
                child3 = null,
                child4 = null,
                is_leaf = true,
            };
            
            // Update root's bounding rectangle
            update_root_rect(tree.root);
        }
    }
    
    // Update root's rectangle to encompass all children
    fn update_root_rect(root: *RTreeNode) {
        if (root.child1 == null and root.child2 == null and 
            root.child3 == null and root.child4 == null) {
            return;
        }
        
        // Initialize with first available child's rectangle
        if (root.child1 != null) {
            root.rect = root.child1.rect;
        } else if (root.child2 != null) {
            root.rect = root.child2.rect;
        } else if (root.child3 != null) {
            root.rect = root.child3.rect;
        } else if (root.child4 != null) {
            root.rect = root.child4.rect;
        }
        
        // Expand to include all other children
        if (root.child2 != null) {
            root.rect.x_min = min(root.rect.x_min, root.child2.rect.x_min);
            root.rect.y_min = min(root.rect.y_min, root.child2.rect.y_min);
            root.rect.x_max = max(root.rect.x_max, root.child2.rect.x_max);
            root.rect.y_max = max(root.rect.y_max, root.child2.rect.y_max);
        }
        
        if (root.child3 != null) {
            root.rect.x_min = min(root.rect.x_min, root.child3.rect.x_min);
            root.rect.y_min = min(root.rect.y_min, root.child3.rect.y_min);
            root.rect.x_max = max(root.rect.x_max, root.child3.rect.x_max);
            root.rect.y_max = max(root.rect.y_max, root.child3.rect.y_max);
        }
        
        if (root.child4 != null) {
            root.rect.x_min = min(root.rect.x_min, root.child4.rect.x_min);
            root.rect.y_min = min(root.rect.y_min, root.child4.rect.y_min);
            root.rect.x_max = max(root.rect.x_max, root.child4.rect.x_max);
            root.rect.y_max = max(root.rect.y_max, root.child4.rect.y_max);
        }
    }

    // query(tree: RTree, search_rect: Rect) -> []Rect
    fn query(tree: RTree, search_rect: Rect) -> []Rect {
        if (tree.root == null) {
            return [];
        }
        
        let results = []Rect;
        query_node(tree.root, search_rect, &results);
        return results;
    }
    
    // Helper function for querying a node
    fn query_node(node: *RTreeNode, search_rect: Rect, results: *[]Rect) {
        // If the node's rectangle doesn't intersect the search rectangle, skip it
        if (!rect_intersects(node.rect, search_rect)) {
            return;
        }
        
        if (node.is_leaf) {
            // For leaf nodes, check each child rectangle
            if (node.child1 != null) {
                if (rect_intersects(node.child1.rect, search_rect)) {
                    results.append(node.child1.rect);
                }
            }
            
            if (node.child2 != null) {
                if (rect_intersects(node.child2.rect, search_rect)) {
                    results.append(node.child2.rect);
                }
            }
            
            if (node.child3 != null) {
                if (rect_intersects(node.child3.rect, search_rect)) {
                    results.append(node.child3.rect);
                }
            }
            
            if (node.child4 != null) {
                if (rect_intersects(node.child4.rect, search_rect)) {
                    results.append(node.child4.rect);
                }
            }
        } else {
            // For internal nodes, check children recursively
            if (node.child1 != null) {
                query_node(&node.child1, search_rect, results);
            }
            
            if (node.child2 != null) {
                query_node(&node.child2, search_rect, results);
            }
            
            if (node.child3 != null) {
                query_node(&node.child3, search_rect, results);
            }
            
            if (node.child4 != null) {
                query_node(&node.child4, search_rect, results);
            }
        }
    }
    
    // Helper function to check if two rectangles intersect
    fn rect_intersects(a: Rect, b: Rect) -> bool {
        return (a.x_min < b.x_max and a.x_max > b.x_min and 
                a.y_min < b.y_max and a.y_max > b.y_min);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case
        given input = 10_usize
        when result = init(input)
        then result.max_entries == 10
        then result.root == null

    test insert_basic_case
        given tree = &init(10_usize)
        given rect = Rect { x_min: 0.0, y_min: 0.0, x_max: 10.0, y_max: 10.0 }
        when result = insert(tree, rect)
        then result == undefined

    test query_basic_case
        given tree = init(10_usize)
        given search_rect = Rect { x_min: 0.0, y_min: 0.0, x_max: 10.0, y_max: 10.0 }
        when result = query(tree, search_rect)
        then result.len == 0