// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Spatial indexing | φ² + 1/φ² = 3 | TRINITY

module TriRtree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Memory model: t27c has no allocator, so nodes live in a fixed pool of
    // RT_NODES nodes addressed by index (RT_NIL = -1 is the null link). A node holds
    // up to max_entries entries (clamped to 2..RT_MAXE) plus one spare slot used
    // while it overflows; each entry is a rectangle and a link (a child node, or
    // for a leaf the sequence number of the inserted rectangle). The tree is
    // Guttman's R-tree: insert descends by least enlargement and an overflowing
    // node splits in two (quadratic seeds). Rectangles intersect when they share
    // interior area; rectangles that only touch do not. query returns a slice of
    // static storage, valid until the next call of query.
    pub const RT_NODES : usize = 64;
    pub const RT_MAXE : usize = 10;
    pub const RT_SLOTS : usize = 11;
    pub const RT_OUT_CAP : usize = 512;
    pub const RT_NIL : i32 = -1;

    pub const Rect = struct {
        x_min : f64,
        y_min : f64,
        x_max : f64,
        y_max : f64,
    };

    pub const RTreeNode = struct {
        rects : [RT_SLOTS]Rect,
        kids : [RT_SLOTS]i32,
        count : usize,
        is_leaf : bool,
    };

    pub const RTree = struct {
        root : i32,
        max_entries : usize,
        size : usize,
        used : usize,
        nodes : [RT_NODES]RTreeNode,
    };

    var RT_OUT : [RT_OUT_CAP]Rect = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // at(n) -> usize : pool index of a non-nil link
    fn at(n: i32) -> usize {
        return @as(usize, @intCast(n));
    }

    // init(max_entries: usize) -> RTree
    fn init(max_entries: usize) -> RTree {
        var tree : RTree = undefined;
        tree.root = RT_NIL;
        tree.size = 0;
        tree.used = 0;
        tree.max_entries = max_entries;
        if (tree.max_entries < 2) {
            tree.max_entries = 2;
        }
        if (tree.max_entries > RT_MAXE) {
            tree.max_entries = RT_MAXE;
        }
        return tree;
    }

    fn min_f(a: f64, b: f64) -> f64 {
        if (a < b) {
            return a;
        }
        return b;
    }

    fn max_f(a: f64, b: f64) -> f64 {
        if (a > b) {
            return a;
        }
        return b;
    }

    fn rect_area(r: Rect) -> f64 {
        return (r.x_max - r.x_min) * (r.y_max - r.y_min);
    }

    // rect_union(a, b) -> Rect : the smallest rectangle holding both
    fn rect_union(a: Rect, b: Rect) -> Rect {
        return Rect {
            x_min = min_f(a.x_min, b.x_min),
            y_min = min_f(a.y_min, b.y_min),
            x_max = max_f(a.x_max, b.x_max),
            y_max = max_f(a.y_max, b.y_max),
        };
    }

    // rect_intersects(a, b) -> bool : the rectangles share interior area
    fn rect_intersects(a: Rect, b: Rect) -> bool {
        return (a.x_min < b.x_max and a.x_max > b.x_min and
                a.y_min < b.y_max and a.y_max > b.y_min);
    }

    fn rect_eq(a: Rect, b: Rect) -> bool {
        return a.x_min == b.x_min and a.y_min == b.y_min and a.x_max == b.x_max and a.y_max == b.y_max;
    }

    // node_mbr(tree, n) -> Rect : bounding rectangle of the entries of node n
    fn node_mbr(tree: *RTree, n: i32) -> Rect {
        const i = at(n);
        var r = tree.nodes[i].rects[0];
        var e : usize = 1;
        while (e < tree.nodes[i].count) {
            r = rect_union(r, tree.nodes[i].rects[e]);
            e = e + 1;
        }
        return r;
    }

    // new_node(tree, leaf) -> i32 : an empty node, RT_NIL when the pool is full
    fn new_node(tree: *RTree, leaf: bool) -> i32 {
        if (tree.used >= RT_NODES) {
            return RT_NIL;
        }
        const idx = tree.used;
        tree.used = tree.used + 1;
        tree.nodes[idx].is_leaf = leaf;
        tree.nodes[idx].count = 0;
        return @as(i32, @intCast(idx));
    }

    // choose_child(tree, n, rect) -> usize : the entry needing least enlargement
    // (ties: the smaller rectangle)
    fn choose_child(tree: *RTree, n: i32, rect: Rect) -> usize {
        const i = at(n);
        var best : usize = 0;
        var best_grow : f64 = 1.0e308;
        var best_area : f64 = 1.0e308;
        var e : usize = 0;
        while (e < tree.nodes[i].count) {
            const r = tree.nodes[i].rects[e];
            const area = rect_area(r);
            const grow = rect_area(rect_union(r, rect)) - area;
            if (grow < best_grow or (grow == best_grow and area < best_area)) {
                best = e;
                best_grow = grow;
                best_area = area;
            }
            e = e + 1;
        }
        return best;
    }

    // split_node(tree, n) -> i32 : node n holds max_entries + 1 entries; keep one
    // group in n and return a new sibling holding the other
    fn split_node(tree: *RTree, n: i32) -> i32 {
        const i = at(n);
        const total = tree.nodes[i].count;
        var tr : [RT_SLOTS]Rect = undefined;
        var tk : [RT_SLOTS]i32 = undefined;
        var grp : [RT_SLOTS]u8 = undefined;
        var e : usize = 0;
        while (e < total) {
            tr[e] = tree.nodes[i].rects[e];
            tk[e] = tree.nodes[i].kids[e];
            grp[e] = 2;
            e = e + 1;
        }
        // Seeds: the pair that wastes the most area when covered together.
        var s1 : usize = 0;
        var s2 : usize = 1;
        var worst : f64 = -1.0e308;
        var a : usize = 0;
        while (a < total) {
            var b = a + 1;
            while (b < total) {
                const waste = rect_area(rect_union(tr[a], tr[b])) - rect_area(tr[a]) - rect_area(tr[b]);
                if (waste > worst) {
                    worst = waste;
                    s1 = a;
                    s2 = b;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        grp[s1] = 0;
        grp[s2] = 1;
        var ra = tr[s1];
        var rb = tr[s2];
        var na : usize = 1;
        var nb : usize = 1;
        var left = total - 2;
        const minfill = tree.max_entries / 2;
        e = 0;
        while (e < total) {
            if (grp[e] == 2) {
                var to_a = false;
                if (na + left == minfill) {
                    to_a = true;
                } else {
                    if (nb + left == minfill) {
                        to_a = false;
                    } else {
                        const ea = rect_area(rect_union(ra, tr[e])) - rect_area(ra);
                        const eb = rect_area(rect_union(rb, tr[e])) - rect_area(rb);
                        if (ea < eb) {
                            to_a = true;
                        } else {
                            if (ea == eb) {
                                to_a = na <= nb;
                            }
                        }
                    }
                }
                if (to_a) {
                    grp[e] = 0;
                    ra = rect_union(ra, tr[e]);
                    na = na + 1;
                } else {
                    grp[e] = 1;
                    rb = rect_union(rb, tr[e]);
                    nb = nb + 1;
                }
                left = left - 1;
            }
            e = e + 1;
        }
        const sib = new_node(tree, tree.nodes[i].is_leaf);
        const si = at(sib);
        tree.nodes[i].count = 0;
        e = 0;
        while (e < total) {
            if (grp[e] == 0) {
                const c = tree.nodes[i].count;
                tree.nodes[i].rects[c] = tr[e];
                tree.nodes[i].kids[c] = tk[e];
                tree.nodes[i].count = c + 1;
            } else {
                const c = tree.nodes[si].count;
                tree.nodes[si].rects[c] = tr[e];
                tree.nodes[si].kids[c] = tk[e];
                tree.nodes[si].count = c + 1;
            }
            e = e + 1;
        }
        return sib;
    }

    // insert_at(tree, n, rect, id) -> i32 : the sibling created when n split, else RT_NIL
    fn insert_at(tree: *RTree, n: i32, rect: Rect, id: i32) -> i32 {
        const i = at(n);
        if (tree.nodes[i].is_leaf) {
            const c = tree.nodes[i].count;
            tree.nodes[i].rects[c] = rect;
            tree.nodes[i].kids[c] = id;
            tree.nodes[i].count = c + 1;
        } else {
            const idx = choose_child(tree, n, rect);
            const child = tree.nodes[i].kids[idx];
            const sib = insert_at(tree, child, rect, id);
            tree.nodes[i].rects[idx] = node_mbr(tree, child);
            if (sib != RT_NIL) {
                const c = tree.nodes[i].count;
                tree.nodes[i].rects[c] = node_mbr(tree, sib);
                tree.nodes[i].kids[c] = sib;
                tree.nodes[i].count = c + 1;
            }
        }
        if (tree.nodes[i].count > tree.max_entries) {
            return split_node(tree, n);
        }
        return RT_NIL;
    }

    // height(tree: *RTree) -> usize : levels from the root to a leaf, 0 when empty
    fn height(tree: *RTree) -> usize {
        var h : usize = 0;
        var node = tree.root;
        while (node != RT_NIL) {
            h = h + 1;
            if (tree.nodes[at(node)].is_leaf) {
                return h;
            }
            node = tree.nodes[at(node)].kids[0];
        }
        return h;
    }

    // insert(tree: *RTree, rect: Rect) -> bool
    // False only when the node pool cannot hold the splits this insert may need.
    fn insert(tree: *RTree, rect: Rect) -> bool {
        if (tree.used + height(tree) + 1 > RT_NODES) {
            return false;
        }
        if (tree.root == RT_NIL) {
            tree.root = new_node(tree, true);
        }
        const sib = insert_at(tree, tree.root, rect, @as(i32, @intCast(tree.size)));
        if (sib != RT_NIL) {
            const top = new_node(tree, false);
            const ti = at(top);
            tree.nodes[ti].rects[0] = node_mbr(tree, tree.root);
            tree.nodes[ti].kids[0] = tree.root;
            tree.nodes[ti].rects[1] = node_mbr(tree, sib);
            tree.nodes[ti].kids[1] = sib;
            tree.nodes[ti].count = 2;
            tree.root = top;
        }
        tree.size = tree.size + 1;
        return true;
    }

    fn query_node(tree: *RTree, n: i32, search_rect: Rect, found: *usize) -> void {
        const i = at(n);
        var e : usize = 0;
        while (e < tree.nodes[i].count) {
            if (rect_intersects(tree.nodes[i].rects[e], search_rect)) {
                if (tree.nodes[i].is_leaf) {
                    if (found.* < RT_OUT_CAP) {
                        RT_OUT[found.*] = tree.nodes[i].rects[e];
                        found.* = found.* + 1;
                    }
                } else {
                    query_node(tree, tree.nodes[i].kids[e], search_rect, found);
                }
            }
            e = e + 1;
        }
    }

    // query(tree: *RTree, search_rect: Rect) -> []Rect : every stored rectangle that intersects search_rect
    fn query(tree: *RTree, search_rect: Rect) -> []Rect {
        var found : usize = 0;
        if (tree.root != RT_NIL) {
            query_node(tree, tree.root, search_rect, &found);
        }
        return RT_OUT[0..found];
    }

    // check_node(tree, n, is_root) -> i32
    // Leaf depth below n (a leaf is 1), or -1 when an R-tree rule is broken:
    // entry counts within min..max (the root may hold fewer), every parent entry
    // is exactly the bounding box of its child, and all leaves share one depth.
    fn check_node(tree: *RTree, n: i32, is_root: bool) -> i32 {
        const i = at(n);
        const c = tree.nodes[i].count;
        if (c > tree.max_entries or c < 1) {
            return -1;
        }
        if (!is_root and c < tree.max_entries / 2) {
            return -1;
        }
        if (is_root and !tree.nodes[i].is_leaf and c < 2) {
            return -1;
        }
        if (tree.nodes[i].is_leaf) {
            return 1;
        }
        var depth : i32 = -2;
        var e : usize = 0;
        while (e < c) {
            const child = tree.nodes[i].kids[e];
            if (!rect_eq(tree.nodes[i].rects[e], node_mbr(tree, child))) {
                return -1;
            }
            const d = check_node(tree, child, false);
            if (d < 0) {
                return -1;
            }
            if (depth == -2) {
                depth = d;
            }
            if (d != depth) {
                return -1;
            }
            e = e + 1;
        }
        return depth + 1;
    }

    // is_valid(tree: *RTree) -> bool
    fn is_valid(tree: *RTree) -> bool {
        if (tree.root == RT_NIL) {
            return true;
        }
        return check_node(tree, tree.root, true) > 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var tree = init(10);
        assert(tree.root == RT_NIL);
        assert(tree.max_entries == 10);
        assert(tree.size == 0);
        assert(is_valid(&tree));
        // The entry limit is clamped to what a node can hold.
        assert(init(0).max_entries == 2);
        assert(init(99).max_entries == RT_MAXE);
    }

    test insert_basic_case {
        var tree = init(10);
        const rect = Rect { x_min = 0.0, y_min = 0.0, x_max = 10.0, y_max = 10.0 };
        assert(insert(&tree, rect));
        assert(tree.size == 1);
        assert(tree.root != RT_NIL);
        assert(tree.nodes[at(tree.root)].is_leaf);
        assert(tree.nodes[at(tree.root)].count == 1);
        assert(rect_eq(node_mbr(&tree, tree.root), rect));
        assert(is_valid(&tree));
    }

    test query_basic_case {
        var tree = init(10);
        const search_rect = Rect { x_min = 0.0, y_min = 0.0, x_max = 10.0, y_max = 10.0 };
        // An empty tree answers nothing.
        assert(query(&tree, search_rect).len == 0);
        assert(insert(&tree, Rect { x_min = 1.0, y_min = 1.0, x_max = 2.0, y_max = 2.0 }));
        assert(insert(&tree, Rect { x_min = 20.0, y_min = 20.0, x_max = 30.0, y_max = 30.0 }));
        const result = query(&tree, search_rect);
        assert(result.len >= 0);
        assert(result.len == 1);
        assert(result[0].x_min == 1.0);
        assert(result[0].y_max == 2.0);
    }

    test rectangles_that_only_touch_do_not_intersect {
        var tree = init(4);
        assert(insert(&tree, Rect { x_min = 10.0, y_min = 0.0, x_max = 20.0, y_max = 10.0 }));
        assert(query(&tree, Rect { x_min = 0.0, y_min = 0.0, x_max = 10.0, y_max = 10.0 }).len == 0);
        assert(query(&tree, Rect { x_min = 0.0, y_min = 0.0, x_max = 10.5, y_max = 10.0 }).len == 1);
    }

    test overflow_splits_the_root {
        var tree = init(4);
        var k : usize = 0;
        while (k < 5) {
            const f = @as(f64, @floatFromInt(k)) * 10.0;
            assert(insert(&tree, Rect { x_min = f, y_min = 0.0, x_max = f + 5.0, y_max = 5.0 }));
            k = k + 1;
        }
        // Five rectangles do not fit one node of four: the root became internal.
        assert(!tree.nodes[at(tree.root)].is_leaf);
        assert(tree.nodes[at(tree.root)].count == 2);
        assert(height(&tree) == 2);
        assert(is_valid(&tree));
        assert(query(&tree, Rect { x_min = -1.0, y_min = -1.0, x_max = 100.0, y_max = 100.0 }).len == 5);
    }

    test many_inserts_keep_the_tree_valid_and_queries_exact {
        var tree = init(6);
        var inserted : usize = 0;
        var inside : usize = 0;
        var k : usize = 0;
        while (k < 120) {
            const x = @as(f64, @floatFromInt((k * 37) % 100));
            const y = @as(f64, @floatFromInt((k * 53) % 100));
            const r = Rect { x_min = x, y_min = y, x_max = x + 3.0, y_max = y + 2.0 };
            assert(insert(&tree, r));
            assert(is_valid(&tree));
            inserted = inserted + 1;
            if (rect_intersects(r, Rect { x_min = 20.0, y_min = 30.0, x_max = 60.0, y_max = 70.0 })) {
                inside = inside + 1;
            }
            k = k + 1;
        }
        assert(tree.size == inserted);
        assert(height(&tree) >= 3);
        assert(query(&tree, Rect { x_min = -1.0, y_min = -1.0, x_max = 200.0, y_max = 200.0 }).len == 120);
        assert(query(&tree, Rect { x_min = 20.0, y_min = 30.0, x_max = 60.0, y_max = 70.0 }).len == inside);
    }

    test insert_fails_when_the_pool_is_exhausted {
        var tree = init(2);
        var ok : usize = 0;
        var k : usize = 0;
        while (k < 200) {
            const x = @as(f64, @floatFromInt(k));
            if (insert(&tree, Rect { x_min = x, y_min = 0.0, x_max = x + 0.5, y_max = 1.0 })) {
                ok = ok + 1;
            }
            k = k + 1;
        }
        assert(ok < 200);
        assert(ok > 0);
        assert(tree.size == ok);
        assert(is_valid(&tree));
    }
