// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Operations return new trees | φ² + 1/φ² = 3 | TRINITY

module TriTree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Tree(T) = struct {
        is_leaf : bool,
        value : T,
        left : "Tree(T)",
        right : "Tree(T)",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // leaf(value: T) → void; T binds at the fn level (#11940 sub-slice 1) --
    // call sites pass the type explicitly: leaf(i64, 1)
    fn leaf(comptime T: type, value: T) -> Tree(T) {
        // Create a leaf tree with the given value
        let tree = Tree(T) {
            .is_leaf = true,
            .value = value,
            .left = undefined,
            .right = undefined,
        };
        return tree;
    }

    // branch(left: Tree(T)) → void
    fn branch(comptime T: type, left: Tree(T), right: Tree(T)) -> Tree(T) {
        // Create a branch tree with the given left and right subtrees
        let tree = Tree(T) {
            .is_leaf = false,
            .value = undefined,
            .left = left,
            .right = right,
        };
        return tree;
    }

    // is_leaf(tree: Tree(T)) → void
    fn is_leaf(comptime T: type, tree: Tree(T)) -> bool {
        // Return whether the tree is a leaf node
        return tree.is_leaf;
    }

    // height(tree: Tree(T)) → void
    fn height(comptime T: type, tree: Tree(T)) -> usize {
        // Return the height of the tree (number of edges from root to deepest leaf)
        if tree == undefined {
            return 0;
        }
        if tree.is_leaf {
            return 0;
        }
        let left_height = height(T, tree.left);
        let right_height = height(T, tree.right);
        return 1 + max(left_height, right_height);
    }

    // size(tree: Tree(T)) → void
    fn size(comptime T: type, tree: Tree(T)) -> usize {
        // Return the number of nodes in the tree
        if tree == undefined {
            return 0;
        }
        if tree.is_leaf {
            return 1;
        }
        let left_size = size(T, tree.left);
        let right_size = size(T, tree.right);
        return 1 + left_size + right_size;
    }

    // inorder(tree: Tree(T)) → void
    fn inorder(comptime T: type, tree: Tree(T)) -> []T {
        // Return the values of the tree in inorder traversal (left, root, right)
        if tree == undefined {
            return [];
        }
        if tree.is_leaf {
            return [tree.value];
        }
        let left_values = inorder(T, tree.left);
        let right_values = inorder(T, tree.right);
        return left_values + [tree.value] + right_values;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "leaf_basic_case"
        given input = 1
        when result = leaf(i64, input)
        then result.is_leaf == true
        then result.value == input

    test "branch_basic_case"
        given left = leaf(i64, 1)
        given right = leaf(i64, 2)
        when result = branch(i64, left, right)
        then result.is_leaf == false
        then result.left == left
        then result.right == right

    test "is_leaf_basic_case"
        given input = leaf(i64, 1)
        when result = is_leaf(i64, input)
        then result == true

    test "height_basic_case"
        given input = leaf(i64, 1)
        when result = height(i64, input)
        then result >= 0

    test "size_basic_case"
        given input = leaf(i64, 1)
        when result = size(i64, input)
        then result >= 1

    test "inorder_basic_case"
        given input = leaf(i64, 1)
        when result = inorder(i64, input)
        then len(result) >= 1

