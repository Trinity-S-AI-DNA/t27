// SPDX-License-Identifier: Apache-2.0
// specs/tri/tma.t27 -- tri tma check|deploy: size budget gate and atomic Mini
// App deploy.
// Part of M1 (milestone #5). Closes #13345.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::tma;

pub const TMA_SIZE_BUDGET_BYTES : u32 = 1024 * 1024;

pub struct TmaDeploy { size_bytes: u32, atomic: bool };

pub fn tma_within_budget(d: TmaDeploy) -> bool {
    return d.size_bytes <= TMA_SIZE_BUDGET_BYTES;
}

pub fn tma_atomic(d: TmaDeploy) -> bool {
    return d.atomic;
}

test "tma within budget" {
    assert(tma_within_budget(TmaDeploy { size_bytes: 500000, atomic: true }));
    assert(!tma_within_budget(TmaDeploy { size_bytes: 2000000, atomic: true }));
}

test "tma atomic" {
    assert(tma_atomic(TmaDeploy { size_bytes: 1000, atomic: true }));
    assert(!tma_atomic(TmaDeploy { size_bytes: 1000, atomic: false }));
}

invariant tma_budget_positive {
    assert TMA_SIZE_BUDGET_BYTES > 0;
}