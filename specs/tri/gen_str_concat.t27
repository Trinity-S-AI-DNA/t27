// SPDX-License-Identifier: Apache-2.0
// specs/tri/gen_str_concat.t27 -- gen-zig: runtime str concatenation (+ and
// ++) emitted verbatim, zig rejects pointer types.
// Part of M1 (milestone #5). Closes #13599.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::gen_str_concat;

pub const STR_CONCAT_VERBATIM : bool = true;

pub struct StrConcat { emitted_verbatim: bool, zig_rejects_pointer: bool };

pub fn str_concat_verbatim(s: StrConcat) -> bool {
    return s.emitted_verbatim;
}

test "str concat verbatim" {
    assert(str_concat_verbatim(StrConcat { emitted_verbatim: true, zig_rejects_pointer: true }));
    assert(!str_concat_verbatim(StrConcat { emitted_verbatim: false, zig_rejects_pointer: true }));
}

invariant str_concat_verbatim_default {
    assert STR_CONCAT_VERBATIM;
}