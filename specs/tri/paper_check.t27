// specs/tri/paper_check.t27 -- tri paper check: one command for the abstract
// gate and the paper-numbers spec.
// Part of M1 (milestone #5). Closes #13234.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::paper_check;

pub const PAPER_NUMBER_MAX : u32 = 1000000;

pub struct PaperCheck { abstract_gate_passed: bool, number_checked: bool };

pub fn paper_check_passed(p: PaperCheck) -> bool {
    return p.abstract_gate_passed && p.number_checked;
}

test "paper check passed" {
    assert(paper_check_passed(PaperCheck { abstract_gate_passed: true, number_checked: true }));
    assert(!paper_check_passed(PaperCheck { abstract_gate_passed: false, number_checked: true }));
    assert(!paper_check_passed(PaperCheck { abstract_gate_passed: true, number_checked: false }));
}

invariant paper_number_max_positive {
    assert PAPER_NUMBER_MAX > 0;
}