// SPDX-License-Identifier: Apache-2.0
// specs/tri/ladder.t27 -- T7 Ladder: t27-native serve loop so a merged ladder
// spec reaches the running server.
// Part of M1 (milestone #5). Closes #13039.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::ladder;

pub const LADDER_SERVE_LOOP : bool = true;

pub struct LadderSpec { merged: str, served: bool };

pub fn ladder_served(l: LadderSpec) -> bool {
    return l.served && l.merged != "";
}

test "ladder served" {
    assert(ladder_served(LadderSpec { merged: "#12345", served: true }));
    assert(!ladder_served(LadderSpec { merged: "", served: true }));
}

invariant ladder_serve_loop {
    assert LADDER_SERVE_LOOP;
}