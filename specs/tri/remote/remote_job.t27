// SPDX-License-Identifier: Apache-2.0
; specs/tri/remote/remote_job.t27 -- the command lines of `tri remote`: an analog reference job on a remote Docker host over SSH
; A golden SAR transient in ngspice with the IHP PSP103 models runs 35 to 65 minutes and loads the bench Mac (8 GB, disk near
; full). `tri remote` starts such a job on a Linux host that has Docker, lets the session watch it and fetches the result files
; (gHashTag/t27#11020, part of #10486). Every command line it ever sends is built here, as bytes, from a fixed template; the
; glue in cli/tri/src/main.rs (through `t27c gen-rust` in gen/rust/tri/remote/remote_job.rs) reads TRI_REMOTE_HOST,
; TRI_REMOTE_IMAGE and TRI_REMOTE_DECK_URL, calls the functions below, prints each line and runs it with no shell in between.
; -
; THE REQUEST is one TriRemoteReq: the action (op), the host, the image, the name (a deck path for `run`, a job id for every
; other action), the result file and the local directory of `fetch`, the golden deck's address, the thread count, the golden
; flag and the counter of the job id (seconds since the epoch). refusal() says why a request may not be sent (R_OK is 0);
; command(r, step) writes the argument vector of step number `step` of the request, one argument per line, each ended by a
; newline, and returns the byte count; 0 means there is no such step, and a refused request has none: every builder is its own
; gate, so a caller that forgets refusal() still sends nothing. shell_form() writes such a vector as one line a shell reads back
; the same way (an argument that is not plain is put in single quotes), for `--print`.
; -
; THE TEMPLATES (h = the host, I = the job id, D = the deck, IMG = the image). An ssh word is `ssh -o BatchMode=yes h <one remote
; command>`: the remote command is ONE argument, so the remote shell reads it, and `$HOME` is that host's home. BatchMode is on
; for every ssh and scp, so a missing key fails at once instead of asking for a password in a session nobody watches.
;   ping     ssh h true
;   run      1. ssh h mkdir -p $HOME/t27-jobs/I
;            2. scp D h:t27-jobs/I/deck.cir
;            3. ssh h docker run -d --name t27job-I -v $HOME/t27-jobs/I:/work IMG sh -c "cd /work && ngspice -b deck.cir > ngspice.log 2>&1"
;   run --golden: no scp; the container fetches the deck from TRI_REMOTE_DECK_URL (GPL-2.0, never committed), writes the
;            recipe into it and runs it: every /usr/local/share/OpenPDKs/IHP-Open-PDK becomes /opt/IHP-Open-PDK, and right
;            after the line `.control` come the six `pre_osdi /opt/osdi/<model>.osdi` lines (psp103, psp103_nqs, r3_cmc,
;            mosvar, cap_cmomi, cap_cmomf), `option klu` and `set num_threads=N` (N = 1..16). Nothing else of the deck changes.
;   status   ssh h docker ps -a --filter "name=^t27job-I$" --format "{{.Names}} {{.Status}}"
;   logs     ssh h docker logs --tail 40 t27job-I; tail -n 40 $HOME/t27-jobs/I/ngspice.log
;   stop     ssh h docker rm -f t27job-I
;   fetch    scp h:t27-jobs/I/FILE DIR/
; The job id of a run is the deck's file name without its last extension (a dot inside it becomes `_`, at most 40 bytes), a
; dash and the counter: rc_fixed.cir at counter 1760000000 is rc_fixed-1760000000. The container is t27job-I, the job's
; files are in $HOME/t27-jobs/I on the host, and `docker run` has no --rm, so a finished job still answers status and logs.
; -
; THE RULES. No command is passed through: only the templates above go out, with names that passed their rule.
;   safe_name  letters, digits, `_`, `-`, `.`; 1 to 64 bytes; not starting with `-` (an option) or `.` (`.`, `..`, hidden)
;   safe_id    safe_name without a dot: a job id, a container name, a directory, and the regular expression of `status`
;   safe_path  the bytes of safe_name and `/`; not starting with `-`; no `..`; at most 256; a deck's file name is a safe_name
;   host       letters, digits, `_-.@`; not starting with `-` or `@`, not ending with `@`, at most one `@`; at most 96
;   image      letters, digits, `_-.:/`; starting with a letter or digit; at most 128
;   deck url   `https://` and then letters, digits, `_-./`; at most 200
; Space, `;`, `$`, a backtick, a quote, a newline, a pipe, `&`, `<`, `>`, a glob byte and a backslash are in no rule. The host is
; never written in the repository: with TRI_REMOTE_HOST unset every action refuses and says so. Arguments an action does not use
; must be empty (a bad name given to `ping` is refused, not ignored). The thread count is read for `--golden` only.
; -
; WHAT A PASS SAYS. Each template's bytes are pinned, in the argument form and the shell form; every builder refuses a name
; with each of the bytes above, an unset or odd host, an odd image or deck address, and a thread count outside 1..16; the worst
; case of every template fits CMD_MAX. WHAT IT DOES NOT SAY. That a host answers or that ngspice finishes: no test here opens
; a connection. The golden recipe is the one #11020 gives; its bytes are pinned here, and the PR that added this file ran the
; script on a synthetic deck (not the real one) to see the rewrite it makes. The script is one sh -c string inside the ssh
; command and has no `$` in it, so the remote shell hands its sed and printf words to sh unchanged. The image must have curl,
; sed, printf and ngspice-47 with the OSDI models in /opt/osdi. The golden deck's address is TRI_REMOTE_DECK_URL, never written
; here: the deck is GPL-2.0 and stays at its owner's server.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriRemoteJob;

use tri::lab::receipt::span_is;

pub const HOST_VAR : str = "TRI_REMOTE_HOST";
pub const IMAGE_VAR : str = "TRI_REMOTE_IMAGE";
pub const URL_VAR : str = "TRI_REMOTE_DECK_URL";
pub const DEFAULT_IMAGE : str = "t27-ngspice:47-osdi";
pub const DEFAULT_THREADS : u64 = 8;
pub const THREADS_MIN : u64 = 1;
pub const THREADS_MAX : u64 = 16;
pub const NAME_MAX : usize = 64;
pub const STEM_MAX : usize = 40;
pub const PATH_MAX : usize = 256;
pub const HOST_MAX : usize = 96;
pub const IMAGE_MAX : usize = 128;
pub const URL_MAX : usize = 200;
// The room a command and its shell form are written into; the tests prove the worst case fits.
pub const CMD_MAX : usize = 2048;

// The actions, as `tri remote <action>` spells them.
pub const OP_NONE : u8 = 0;
pub const OP_PING : u8 = 1;
pub const OP_RUN : u8 = 2;
pub const OP_STATUS : u8 = 3;
pub const OP_LOGS : u8 = 4;
pub const OP_STOP : u8 = 5;
pub const OP_FETCH : u8 = 6;

// Why a request may not be sent.
pub const R_OK : u8 = 0;
pub const R_NO_ACTION : u8 = 1;
pub const R_NO_HOST : u8 = 2;
pub const R_BAD_HOST : u8 = 3;
pub const R_BAD_IMAGE : u8 = 4;
pub const R_NO_NAME : u8 = 5;
pub const R_BAD_NAME : u8 = 6;
pub const R_NO_FILE : u8 = 7;
pub const R_BAD_FILE : u8 = 8;
pub const R_BAD_DEST : u8 = 9;
pub const R_NO_URL : u8 = 10;
pub const R_BAD_URL : u8 = 11;
pub const R_BAD_THREADS : u8 = 12;
pub const R_UNEXPECTED : u8 = 13;
pub const REFUSALS : u8 = 14;

pub struct TriRemoteReq {
    op: u8,
    host: string,
    image: string,
    name: string,
    file: string,
    dest: string,
    url: string,
    threads: u64,
    counter: u64,
    golden: bool,
}

invariant the_numbers_are_the_words { assert OP_FETCH == 6 and R_UNEXPECTED == 13 and REFUSALS == 14 and THREADS_MAX == 16; }

// --- bytes ---------------------------------------------------------------------------------------

/// Is c a letter or a digit?
pub fn is_alnum(c: u8) -> bool {
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57);
}

/// The bytes the shell form leaves bare: letters, digits and _ @ % + = : , . / -
pub fn is_bare(c: u8) -> bool {
    return is_alnum(c) or c == 95 or c == 64 or c == 37 or c == 43 or c == 61 or c == 58 or c == 44 or c == 46 or c == 47 or c == 45;
}

/// Is text[from..to] a name: letters, digits, `_`, `-` and `.`, at most NAME_MAX, not starting with `-` or `.`?
pub fn name_span_ok(text: string, from: usize, to: usize) -> bool {
    if (to <= from or to - from > NAME_MAX) { return false; }
    if (text[from] == 45 or text[from] == 46) { return false; }
    var i : usize = from;
    while (i < to) {
        const c : u8 = text[i];
        if (is_alnum(c) == false and c != 95 and c != 45 and c != 46) { return false; }
        i = i + 1;
    }
    return true;
}

/// A name that may be written into a command.
pub fn safe_name(s: string) -> bool {
    return name_span_ok(s, 0, s.len);
}

/// A job id: a safe_name with no dot.
pub fn safe_id(s: string) -> bool {
    if (safe_name(s) == false) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] == 46) { return false; }
        i = i + 1;
    }
    return true;
}

/// A local path: the bytes of a name and `/`, at most PATH_MAX, not starting with `-`, never `..`.
pub fn safe_path(p: string) -> bool {
    if (p.len == 0 or p.len > PATH_MAX or p[0] == 45) { return false; }
    var i : usize = 0;
    while (i < p.len) {
        const c : u8 = p[i];
        if (is_alnum(c) == false and c != 95 and c != 45 and c != 46 and c != 47) { return false; }
        if (c == 46 and i + 1 < p.len and p[i + 1] == 46) { return false; }
        i = i + 1;
    }
    return true;
}

/// Where the last `/` of p ends: the index its file name starts at (0 when there is none).
pub fn base_start(p: string) -> usize {
    var b : usize = 0;
    var i : usize = 0;
    while (i < p.len) {
        if (p[i] == 47) { b = i + 1; }
        i = i + 1;
    }
    return b;
}

/// A deck on this machine: a safe_path whose file name is a safe_name.
pub fn safe_deck(p: string) -> bool {
    return safe_path(p) and name_span_ok(p, base_start(p), p.len);
}

/// A host: an ssh alias or user@host.
pub fn safe_host(h: string) -> bool {
    if (h.len == 0 or h.len > HOST_MAX or h[0] == 45 or h[0] == 64 or h[h.len - 1] == 64) { return false; }
    var ats : usize = 0;
    var i : usize = 0;
    while (i < h.len) {
        const c : u8 = h[i];
        if (c == 64) { ats = ats + 1; }
        if (is_alnum(c) == false and c != 95 and c != 45 and c != 46 and c != 64) { return false; }
        i = i + 1;
    }
    return ats <= 1;
}

/// A container image: letters, digits and `_-.:/`, starting with a letter or digit.
pub fn safe_image(s: string) -> bool {
    if (s.len == 0 or s.len > IMAGE_MAX or is_alnum(s[0]) == false) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        const c : u8 = s[i];
        if (is_alnum(c) == false and c != 95 and c != 45 and c != 46 and c != 58 and c != 47) { return false; }
        i = i + 1;
    }
    return true;
}

/// The address of the golden deck: `https://` and then letters, digits and `_-./`.
pub fn safe_url(s: string) -> bool {
    if (s.len <= 8 or s.len > URL_MAX or span_is(s, 0, 8, "https://") == false) { return false; }
    var i : usize = 8;
    while (i < s.len) {
        const c : u8 = s[i];
        if (is_alnum(c) == false and c != 95 and c != 45 and c != 46 and c != 47) { return false; }
        i = i + 1;
    }
    return true;
}

// --- the actions and the refusals ----------------------------------------------------------------

/// The action a word names, OP_NONE for any other word.
pub fn action_op(word: string) -> u8 {
    if (span_is(word, 0, word.len, "ping")) { return OP_PING; }
    if (span_is(word, 0, word.len, "run")) { return OP_RUN; }
    if (span_is(word, 0, word.len, "status")) { return OP_STATUS; }
    if (span_is(word, 0, word.len, "logs")) { return OP_LOGS; }
    if (span_is(word, 0, word.len, "stop")) { return OP_STOP; }
    if (span_is(word, 0, word.len, "fetch")) { return OP_FETCH; }
    return OP_NONE;
}

/// Why this request may not be sent, R_OK when it may. The first rule that fails decides.
pub fn refusal(r: TriRemoteReq) -> u8 {
    if (r.op == OP_NONE or r.op > OP_FETCH) { return R_NO_ACTION; }
    if (r.host.len == 0) { return R_NO_HOST; }
    if (safe_host(r.host) == false) { return R_BAD_HOST; }
    if (r.golden and r.op != OP_RUN) { return R_UNEXPECTED; }
    if (r.op == OP_PING and r.name.len > 0) { return R_UNEXPECTED; }
    if (r.op != OP_FETCH and (r.file.len > 0 or r.dest.len > 0)) { return R_UNEXPECTED; }
    if (r.op != OP_PING and r.name.len == 0) { return R_NO_NAME; }
    if (r.op == OP_RUN) {
        if (r.golden == false and safe_deck(r.name) == false) { return R_BAD_NAME; }
        if (r.golden and safe_name(r.name) == false) { return R_BAD_NAME; }
        if (safe_image(r.image) == false) { return R_BAD_IMAGE; }
        if (r.golden and r.url.len == 0) { return R_NO_URL; }
        if (r.golden and safe_url(r.url) == false) { return R_BAD_URL; }
        if (r.golden and (r.threads < THREADS_MIN or r.threads > THREADS_MAX)) { return R_BAD_THREADS; }
        return R_OK;
    }
    if (r.op != OP_PING and safe_id(r.name) == false) { return R_BAD_NAME; }
    if (r.op == OP_FETCH) {
        if (r.file.len == 0) { return R_NO_FILE; }
        if (safe_name(r.file) == false) { return R_BAD_FILE; }
        if (r.dest.len > 0 and safe_path(r.dest) == false) { return R_BAD_DEST; }
    }
    return R_OK;
}

/// The reason in words, for the line the CLI prints when it refuses.
pub fn refusal_text(code: u8) -> string {
    if (code == R_OK) { return "nothing is refused"; }
    if (code == R_NO_ACTION) { return "the action is one of: ping, run, status, logs, stop, fetch"; }
    if (code == R_NO_HOST) { return "TRI_REMOTE_HOST is not set: name the ssh host (an alias or user@host) there"; }
    if (code == R_BAD_HOST) { return "TRI_REMOTE_HOST is not an ssh alias or user@host: letters, digits and _-.@ only, not starting with - or @"; }
    if (code == R_BAD_IMAGE) { return "TRI_REMOTE_IMAGE is not an image name: letters, digits and _-.:/ only, starting with a letter or digit"; }
    if (code == R_NO_NAME) { return "this action needs a deck (run) or a job id (status, logs, stop, fetch)"; }
    if (code == R_BAD_NAME) { return "the deck or job id has a byte outside letters, digits and _-. (a deck path also has /), or starts with - or ., or is too long; a job id has no dot"; }
    if (code == R_NO_FILE) { return "fetch needs the name of a result file of the job"; }
    if (code == R_BAD_FILE) { return "the result file has a byte outside letters, digits and _-., or starts with - or ., or is too long"; }
    if (code == R_BAD_DEST) { return "the --to directory has a byte outside letters, digits and _-./, or starts with -, or has .."; }
    if (code == R_NO_URL) { return "--golden needs TRI_REMOTE_DECK_URL: the https address the container fetches the golden deck from"; }
    if (code == R_BAD_URL) { return "TRI_REMOTE_DECK_URL is not an https address of letters, digits and _-./ only"; }
    if (code == R_BAD_THREADS) { return "--threads is 1 to 16"; }
    return "this action does not take that argument";
}

// --- writing the commands ------------------------------------------------------------------------

/// Write one byte at w if it fits; the cursor keeps counting past the end.
pub fn emit_byte(out: []u8, w: usize, c: u8) -> usize {
    if (w < out.len) { out[w] = c; }
    return w + 1;
}

/// Write the bytes of s.
pub fn emit_str(out: []u8, w: usize, s: string) -> usize {
    var p : usize = w;
    var i : usize = 0;
    while (i < s.len) {
        p = emit_byte(out, p, s[i]);
        i = i + 1;
    }
    return p;
}

/// Write v in decimal.
pub fn emit_dec(out: []u8, w: usize, v: u64) -> usize {
    var div : u64 = 1;
    while (v / div >= 10) { div = div * 10; }
    var p : usize = w;
    while (div > 0) {
        p = emit_byte(out, p, 48 + ((v / div) % 10) as u8);
        div = div / 10;
    }
    return p;
}

/// A deck's stem: its file name without the last extension, a dot inside it written `_`, at most STEM_MAX bytes.
pub fn emit_stem(out: []u8, w: usize, deck: string) -> usize {
    const b : usize = base_start(deck);
    var e : usize = deck.len;
    var i : usize = b + 1;
    while (i < deck.len) {
        if (deck[i] == 46) { e = i; }
        i = i + 1;
    }
    var p : usize = w;
    var k : usize = b;
    while (k < e and k - b < STEM_MAX) {
        if (deck[k] == 46) {
            p = emit_byte(out, p, 95);
        } else {
            p = emit_byte(out, p, deck[k]);
        }
        k = k + 1;
    }
    return p;
}

/// The job id of the request: for a run, the stem of the deck, a dash and the counter; for every other action, the id given.
pub fn emit_id(out: []u8, w: usize, r: TriRemoteReq) -> usize {
    if (r.op != OP_RUN) { return emit_str(out, w, r.name); }
    var p : usize = emit_stem(out, w, r.name);
    p = emit_byte(out, p, 45);
    return emit_dec(out, p, r.counter);
}

/// The id of a run, written at the start of out: its length, 0 for any other action or a refused request.
pub fn job_id(r: TriRemoteReq, out: []u8) -> usize {
    if (r.op != OP_RUN or refusal(r) != R_OK) { return 0; }
    return emit_id(out, 0, r);
}

/// `ssh -o BatchMode=yes <host>`, one argument to a line.
pub fn emit_ssh(out: []u8, w: usize, host: string) -> usize {
    var p : usize = emit_str(out, w, "ssh\n-o\nBatchMode=yes\n");
    p = emit_str(out, p, host);
    return emit_byte(out, p, 10);
}

/// `scp -o BatchMode=yes`, one argument to a line.
pub fn emit_scp(out: []u8, w: usize) -> usize {
    return emit_str(out, w, "scp\n-o\nBatchMode=yes\n");
}

/// The room check: the byte count when it all fit, 0 when it did not (a count past the end).
pub fn fits(out: []u8, w: usize) -> usize {
    if (w > out.len) { return 0; }
    return w;
}

// What the container runs. The script is one `sh -c "..."` string inside the remote command: no `$` in it, and its own quotes
// are single, so the remote shell passes it to sh unchanged.
pub const SCRIPT_PLAIN : str = "cd /work && ngspice -b deck.cir > ngspice.log 2>&1";
pub const GOLDEN_FETCH : str = "cd /work && curl -sSfL -o top.spice ";
pub const GOLDEN_INSERT : str = " && printf 'pre_osdi /opt/osdi/psp103.osdi\\npre_osdi /opt/osdi/psp103_nqs.osdi\\npre_osdi /opt/osdi/r3_cmc.osdi\\npre_osdi /opt/osdi/mosvar.osdi\\npre_osdi /opt/osdi/cap_cmomi.osdi\\npre_osdi /opt/osdi/cap_cmomf.osdi\\noption klu\\nset num_threads=";
pub const GOLDEN_SPLICE : str = "\\n' > ins.txt && sed -e 's,/usr/local/share/OpenPDKs/IHP-Open-PDK,/opt/IHP-Open-PDK,g' -e '/^\\.control/r ins.txt' top.spice > run.spice && ngspice -b run.spice > ngspice.log 2>&1";

/// `ssh <host> docker run -d --name t27job-<id> -v $HOME/t27-jobs/<id>:/work <image> sh -c "` : everything up to the script.
pub fn emit_run_head(out: []u8, w: usize, r: TriRemoteReq) -> usize {
    var p : usize = emit_ssh(out, w, r.host);
    p = emit_str(out, p, "docker run -d --name t27job-");
    p = emit_id(out, p, r);
    p = emit_str(out, p, " -v $HOME/t27-jobs/");
    p = emit_id(out, p, r);
    p = emit_str(out, p, ":/work ");
    p = emit_str(out, p, r.image);
    return emit_str(out, p, " sh -c \"");
}

/// The script of a run: the deck staged as deck.cir, or the golden deck fetched and rewritten.
pub fn emit_script(out: []u8, w: usize, r: TriRemoteReq) -> usize {
    if (r.golden == false) { return emit_str(out, w, SCRIPT_PLAIN); }
    var p : usize = emit_str(out, w, GOLDEN_FETCH);
    p = emit_str(out, p, r.url);
    p = emit_str(out, p, GOLDEN_INSERT);
    p = emit_dec(out, p, r.threads);
    return emit_str(out, p, GOLDEN_SPLICE);
}

/// Step number `step` of the request as an argument vector, one argument to a line; the byte count, 0 when there is no such
/// step (a ping has 1, a plain run 3, a golden run 2, every other action 1) or the request is refused or the room is short.
pub fn command(r: TriRemoteReq, step: u8, out: []u8) -> usize {
    if (refusal(r) != R_OK) { return 0; }
    var w : usize = 0;
    if (r.op == OP_PING) {
        if (step != 0) { return 0; }
        w = emit_ssh(out, w, r.host);
        w = emit_str(out, w, "true\n");
        return fits(out, w);
    }
    if (r.op == OP_RUN) {
        var run_step : u8 = 2;
        if (r.golden) { run_step = 1; }
        if (step == 0) {
            w = emit_ssh(out, w, r.host);
            w = emit_str(out, w, "mkdir -p $HOME/t27-jobs/");
            w = emit_id(out, w, r);
            w = emit_byte(out, w, 10);
            return fits(out, w);
        }
        if (step == 1 and r.golden == false) {
            w = emit_scp(out, w);
            w = emit_str(out, w, r.name);
            w = emit_byte(out, w, 10);
            w = emit_str(out, w, r.host);
            w = emit_str(out, w, ":t27-jobs/");
            w = emit_id(out, w, r);
            w = emit_str(out, w, "/deck.cir\n");
            return fits(out, w);
        }
        if (step == run_step) {
            w = emit_run_head(out, w, r);
            w = emit_script(out, w, r);
            w = emit_str(out, w, "\"\n");
            return fits(out, w);
        }
        return 0;
    }
    if (step != 0) { return 0; }
    if (r.op == OP_FETCH) {
        w = emit_scp(out, w);
        w = emit_str(out, w, r.host);
        w = emit_str(out, w, ":t27-jobs/");
        w = emit_str(out, w, r.name);
        w = emit_byte(out, w, 47);
        w = emit_str(out, w, r.file);
        w = emit_byte(out, w, 10);
        if (r.dest.len == 0) {
            w = emit_byte(out, w, 46);
        } else {
            w = emit_str(out, w, r.dest);
        }
        w = emit_str(out, w, "/\n");
        return fits(out, w);
    }
    w = emit_ssh(out, w, r.host);
    if (r.op == OP_STATUS) {
        w = emit_str(out, w, "docker ps -a --filter \"name=^t27job-");
        w = emit_str(out, w, r.name);
        w = emit_str(out, w, "$\" --format \"{{.Names}} {{.Status}}\"\n");
        return fits(out, w);
    }
    if (r.op == OP_LOGS) {
        w = emit_str(out, w, "docker logs --tail 40 t27job-");
        w = emit_str(out, w, r.name);
        w = emit_str(out, w, "; tail -n 40 $HOME/t27-jobs/");
        w = emit_str(out, w, r.name);
        w = emit_str(out, w, "/ngspice.log\n");
        return fits(out, w);
    }
    w = emit_str(out, w, "docker rm -f t27job-");
    w = emit_str(out, w, r.name);
    w = emit_byte(out, w, 10);
    return fits(out, w);
}

/// One argument of argv[from..to] as a shell reads it back: bare when it is made of bare bytes, else in single quotes with
/// each single quote written '\''. An empty argument is ''.
pub fn emit_word(out: []u8, w: usize, argv: []const u8, from: usize, to: usize) -> usize {
    var bare : bool = to > from;
    var i : usize = from;
    while (i < to) {
        if (is_bare(argv[i]) == false) { bare = false; }
        i = i + 1;
    }
    var p : usize = w;
    if (bare == false) { p = emit_byte(out, p, 39); }
    i = from;
    while (i < to) {
        if (argv[i] == 39) {
            p = emit_str(out, p, "'\\''");
        } else {
            p = emit_byte(out, p, argv[i]);
        }
        i = i + 1;
    }
    if (bare == false) { p = emit_byte(out, p, 39); }
    return p;
}

/// The argument vector argv[0..n) (one argument to a line) as one line a shell reads back to the same arguments, for `--print`.
/// The byte count; 0 when it does not fit.
pub fn shell_form(argv: []const u8, n: usize, out: []u8) -> usize {
    var w : usize = 0;
    var s : usize = 0;
    while (s < n) {
        var e : usize = s;
        while (e < n and argv[e] != 10) { e = e + 1; }
        if (s > 0) { w = emit_byte(out, w, 32); }
        w = emit_word(out, w, argv, s, e);
        s = e + 1;
    }
    return fits(out, w);
}

// --- the tests -----------------------------------------------------------------------------------

pub const TEST_URL : str = "https://example.org/golden/top.spice";
pub const TEST_COUNTER : u64 = 1760000000;

/// A request of a non-golden action with the defaults of the CLI.
pub fn mk(op: u8, host: string, name: string, file: string, dest: string) -> TriRemoteReq {
    return TriRemoteReq { op: op, host: host, image: DEFAULT_IMAGE, name: name, file: file, dest: dest, url: TEST_URL, threads: DEFAULT_THREADS, counter: TEST_COUNTER, golden: false };
}

/// A golden run.
pub fn mk_golden(host: string, name: string, threads: u64) -> TriRemoteReq {
    return TriRemoteReq { op: OP_RUN, host: host, image: DEFAULT_IMAGE, name: name, file: "", dest: "", url: TEST_URL, threads: threads, counter: TEST_COUNTER, golden: true };
}

/// Is buf[0..n) byte for byte want?
pub fn buf_is(buf: []const u8, n: usize, want: string) -> bool {
    if (n != want.len or n > buf.len) { return false; }
    var k : usize = 0;
    while (k < n) {
        if (buf[k] != want[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Does step `step` of r write exactly `want`?
pub fn step_is(r: TriRemoteReq, step: u8, want: string, buf: []u8) -> bool {
    const n : usize = command(r, step, buf);
    return buf_is(buf, n, want);
}

/// Does buf[0..n) hold `want` somewhere?
pub fn buf_has(buf: []const u8, n: usize, want: string) -> bool {
    if (want.len == 0 or want.len > n or n > buf.len) { return false; }
    var at : usize = 0;
    while (at + want.len <= n) {
        var k : usize = 0;
        while (k < want.len and buf[at + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        at = at + 1;
    }
    return false;
}

/// Does the shell form of step `step` of r read exactly `want`?
pub fn shell_is(r: TriRemoteReq, step: u8, want: string, buf: []u8, line: []u8) -> bool {
    const n : usize = command(r, step, buf);
    const m : usize = shell_form(buf, n, line);
    return n > 0 and buf_is(line, m, want);
}

/// The request k of ten that carry `bad` in one slot: the deck, the golden name, the job id of status, of logs, of stop and of
/// fetch, the result file, the directory, the host, the image.
pub fn probe(k: u8, bad: string) -> TriRemoteReq {
    if (k == 0) { return mk(OP_RUN, "h", bad, "", ""); }
    if (k == 1) { return mk_golden("h", bad, 8); }
    if (k == 2) { return mk(OP_STATUS, "h", bad, "", ""); }
    if (k == 3) { return mk(OP_LOGS, "h", bad, "", ""); }
    if (k == 4) { return mk(OP_STOP, "h", bad, "", ""); }
    if (k == 5) { return mk(OP_FETCH, "h", bad, "f.raw", ""); }
    if (k == 6) { return mk(OP_FETCH, "h", "j-1", bad, ""); }
    if (k == 7) { return mk(OP_FETCH, "h", "j-1", "f.raw", bad); }
    if (k == 8) { return mk(OP_PING, bad, "", "", ""); }
    return TriRemoteReq { op: OP_RUN, host: "h", image: bad, name: "d.cir", file: "", dest: "", url: TEST_URL, threads: DEFAULT_THREADS, counter: TEST_COUNTER, golden: false };
}

/// Is r refused, with no command at any of its steps?
pub fn sends_nothing(r: TriRemoteReq, buf: []u8) -> bool {
    return refusal(r) != R_OK and command(r, 0, buf) == 0 and command(r, 1, buf) == 0 and command(r, 2, buf) == 0;
}

/// How many of the ten probes carrying `bad` send nothing.
pub fn refused_count(bad: string, buf: []u8) -> u32 {
    var n : u32 = 0;
    var k : u8 = 0;
    while (k < 10) {
        if (sends_nothing(probe(k, bad), buf)) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

pub const N64 : str = "0123456789012345678901234567890123456789012345678901234567890123";
pub const N65 : str = "01234567890123456789012345678901234567890123456789012345678901234";
pub const H96 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdef";
pub const H97 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefg";
pub const IMG128 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefgh";
pub const IMG129 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghi";
pub const URL200 : str = "https://abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijab";
pub const URL201 : str = "https://abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabc";
pub const PATH256 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdef";
pub const DECK256 : str = "abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij.cir";
pub const PATH257 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefg";

// Scenario: a name is letters, digits, `_`, `-` and `.`, 1 to 64 bytes, and neither an option (`-`) nor hidden (`.`).
test the_names_that_may_be_sent {
    assert safe_name("rc_fixed.cir") == true;
    assert safe_name("SAR_top_tb_tran.raw") == true;
    assert safe_name("ngspice.log") == true;
    assert safe_name("a") == true;
    assert safe_name("_x") == true;
    assert safe_name("x-1.2.3") == true;
    assert safe_name("9lives") == true;
    assert safe_name(N64) == true;
    assert safe_name(N65) == false;
    assert safe_name("") == false;
    assert safe_name("-x") == false;
    assert safe_name("-oProxyCommand") == false;
    assert safe_name(".") == false;
    assert safe_name("..") == false;
    assert safe_name(".hidden") == false;
    assert safe_name("a b") == false;
    assert safe_name("a/b") == false;
    assert safe_name("a:b") == false;
    assert safe_name("a@b") == false;
    assert N64.len == NAME_MAX and N65.len == NAME_MAX + 1;
}

// Scenario: a job id is a name without a dot; a path keeps its slashes and refuses `..`; a deck's file name is a name.
test an_id_has_no_dot_and_a_path_keeps_its_slashes {
    assert safe_id("rc_fixed-1760000000") == true;
    assert safe_id("sar_golden-1") == true;
    assert safe_id("rc.cir") == false;
    assert safe_id("..") == false;
    assert safe_id("-x") == false;
    assert safe_id("a/b") == false;
    assert safe_id("") == false;
    assert safe_id(N65) == false;
    assert safe_path("specs/analog/decks/rc_fixed.cir") == true;
    assert safe_path("/abs/dir/rc.cir") == true;
    assert safe_path("./out") == true;
    assert safe_path("out") == true;
    assert safe_path(PATH256) == true;
    assert safe_path(PATH257) == false;
    assert safe_path("") == false;
    assert safe_path("-x/y") == false;
    assert safe_path("../x") == false;
    assert safe_path("a/../b") == false;
    assert safe_path("a..b") == false;
    assert safe_path("a b/c") == false;
    assert safe_path("a:b/c") == false;
    assert safe_deck("specs/analog/decks/rc_fixed.cir") == true;
    assert safe_deck("rc_fixed.cir") == true;
    assert safe_deck("dir/") == false;
    assert safe_deck("dir//") == false;
    assert safe_deck("dir/.hidden") == false;
    assert safe_deck("dir/-x.cir") == false;
    assert safe_deck("-x.cir") == false;
    assert PATH256.len == PATH_MAX and PATH257.len == PATH_MAX + 1;
    assert base_start("a/b/c.cir") == 4;
    assert base_start("c.cir") == 0;
    assert base_start("a/") == 2;
}

// Scenario: a host is an ssh alias or user@host, and never an option.
test a_host_is_an_alias_or_user_at_host {
    assert safe_host("h") == true;
    assert safe_host("bench-12.example.org") == true;
    assert safe_host("user@h") == true;
    assert safe_host("u_1@h-2.example") == true;
    assert safe_host(H96) == true;
    assert safe_host(H97) == false;
    assert safe_host("") == false;
    assert safe_host("-v") == false;
    assert safe_host("-oProxyCommand=x") == false;
    assert safe_host("@h") == false;
    assert safe_host("u@") == false;
    assert safe_host("a@b@c") == false;
    assert safe_host("h h") == false;
    assert safe_host("h;x") == false;
    assert safe_host("h$(x)") == false;
    assert safe_host("h:22") == false;
    assert safe_host("h/x") == false;
    assert H96.len == HOST_MAX and H97.len == HOST_MAX + 1;
}

// Scenario: an image name and the golden deck's address are plain.
test an_image_and_a_deck_address_are_plain {
    assert safe_image(DEFAULT_IMAGE) == true;
    assert safe_image("registry.example.org/team/ngspice:47") == true;
    assert safe_image("a") == true;
    assert safe_image(IMG128) == true;
    assert safe_image(IMG129) == false;
    assert safe_image("") == false;
    assert safe_image("-x") == false;
    assert safe_image(".x") == false;
    assert safe_image("/x") == false;
    assert safe_image("a b") == false;
    assert safe_image("a;b") == false;
    assert safe_image("a$(b)") == false;
    assert safe_image("a@sha256") == false;
    assert safe_url(TEST_URL) == true;
    assert safe_url(URL200) == true;
    assert safe_url(URL201) == false;
    assert safe_url("") == false;
    assert safe_url("https://") == false;
    assert safe_url("http://example.org/top.spice") == false;
    assert safe_url("ftp://example.org/top.spice") == false;
    assert safe_url("example.org/top.spice") == false;
    assert safe_url("https://example.org/a b") == false;
    assert safe_url("https://example.org/a;b") == false;
    assert safe_url("https://example.org/a$(b)") == false;
    assert safe_url("https://example.org/a`b`") == false;
    assert safe_url("https://example.org/a'b") == false;
    assert safe_url("https://example.org/a\"b") == false;
    assert safe_url("https://example.org/a\nb") == false;
    assert safe_url("https://example.org/a?b=c") == false;
    assert safe_url("https://example.org/a&b") == false;
    assert IMG128.len == IMAGE_MAX and IMG129.len == IMAGE_MAX + 1 and URL200.len == URL_MAX and URL201.len == URL_MAX + 1;
}

// Scenario: the job id of a run is the deck's file name without its last extension, a dash and the counter.
test the_job_id_of_a_run {
    var buf : [2048]u8 = [0] ** 2048;
    const r : TriRemoteReq = mk(OP_RUN, "h", "rc_fixed.cir", "", "");
    assert buf_is(&buf, job_id(r, &buf), "rc_fixed-1760000000");
    assert buf_is(&buf, job_id(mk(OP_RUN, "h", "specs/analog/decks/rc_fixed.cir", "", ""), &buf), "rc_fixed-1760000000");
    assert buf_is(&buf, job_id(mk(OP_RUN, "h", "a.b.cir", "", ""), &buf), "a_b-1760000000");
    assert buf_is(&buf, job_id(mk(OP_RUN, "h", "deck", "", ""), &buf), "deck-1760000000");
    assert buf_is(&buf, job_id(mk(OP_RUN, "h", "/abs/dir.d/deck", "", ""), &buf), "deck-1760000000");
    assert buf_is(&buf, job_id(mk_golden("h", "sar_golden", 12), &buf), "sar_golden-1760000000");
    // the stem is cut at 40 bytes, the counter is not
    assert buf_is(&buf, job_id(mk(OP_RUN, "h", "0123456789012345678901234567890123456789012345.cir", "", ""), &buf), "0123456789012345678901234567890123456789-1760000000");
    // the counter in decimal, whatever its size
    const z : TriRemoteReq = TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "x.cir", file: "", dest: "", url: TEST_URL, threads: 8, counter: 0, golden: false };
    assert buf_is(&buf, job_id(z, &buf), "x-0");
    const t : TriRemoteReq = TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "x.cir", file: "", dest: "", url: TEST_URL, threads: 8, counter: 10, golden: false };
    assert buf_is(&buf, job_id(t, &buf), "x-10");
    const m : TriRemoteReq = TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "x.cir", file: "", dest: "", url: TEST_URL, threads: 8, counter: 18446744073709551615, golden: false };
    assert buf_is(&buf, job_id(m, &buf), "x-18446744073709551615");
    // only a run that may be sent has one
    assert job_id(mk(OP_STATUS, "h", "j-1", "", ""), &buf) == 0;
    assert job_id(mk(OP_RUN, "", "x.cir", "", ""), &buf) == 0;
    assert job_id(mk(OP_RUN, "h", "x y.cir", "", ""), &buf) == 0;
    assert safe_id("rc_fixed-1760000000") == true;
}

// Scenario: ping and run, every step's bytes pinned in the argument form and in the shell form.
test ping_and_run_pin_their_bytes {
    var buf : [2048]u8 = [0] ** 2048;
    var line : [2048]u8 = [0] ** 2048;
    const ping : TriRemoteReq = mk(OP_PING, "h", "", "", "");
    assert step_is(ping, 0, "ssh\n-o\nBatchMode=yes\nh\ntrue\n", &buf);
    assert shell_is(ping, 0, "ssh -o BatchMode=yes h true", &buf, &line);
    assert step_is(mk(OP_PING, "user@bench-1", "", "", ""), 0, "ssh\n-o\nBatchMode=yes\nuser@bench-1\ntrue\n", &buf);
    const run : TriRemoteReq = mk(OP_RUN, "h", "rc_fixed.cir", "", "");
    assert step_is(run, 0, "ssh\n-o\nBatchMode=yes\nh\nmkdir -p $HOME/t27-jobs/rc_fixed-1760000000\n", &buf);
    assert shell_is(run, 0, "ssh -o BatchMode=yes h 'mkdir -p $HOME/t27-jobs/rc_fixed-1760000000'", &buf, &line);
    assert step_is(run, 1, "scp\n-o\nBatchMode=yes\nrc_fixed.cir\nh:t27-jobs/rc_fixed-1760000000/deck.cir\n", &buf);
    assert shell_is(run, 1, "scp -o BatchMode=yes rc_fixed.cir h:t27-jobs/rc_fixed-1760000000/deck.cir", &buf, &line);
    assert step_is(run, 2, "ssh\n-o\nBatchMode=yes\nh\ndocker run -d --name t27job-rc_fixed-1760000000 -v $HOME/t27-jobs/rc_fixed-1760000000:/work t27-ngspice:47-osdi sh -c \"cd /work && ngspice -b deck.cir > ngspice.log 2>&1\"\n", &buf);
    assert shell_is(run, 2, "ssh -o BatchMode=yes h 'docker run -d --name t27job-rc_fixed-1760000000 -v $HOME/t27-jobs/rc_fixed-1760000000:/work t27-ngspice:47-osdi sh -c \"cd /work && ngspice -b deck.cir > ngspice.log 2>&1\"'", &buf, &line);
    // a deck path is sent as given; the id is its file name's; another image is another word
    const deep : TriRemoteReq = TriRemoteReq { op: OP_RUN, host: "h", image: "my/img:2", name: "specs/analog/decks/rc_fixed.cir", file: "", dest: "", url: TEST_URL, threads: 8, counter: 5, golden: false };
    assert step_is(deep, 1, "scp\n-o\nBatchMode=yes\nspecs/analog/decks/rc_fixed.cir\nh:t27-jobs/rc_fixed-5/deck.cir\n", &buf);
    assert step_is(deep, 2, "ssh\n-o\nBatchMode=yes\nh\ndocker run -d --name t27job-rc_fixed-5 -v $HOME/t27-jobs/rc_fixed-5:/work my/img:2 sh -c \"cd /work && ngspice -b deck.cir > ngspice.log 2>&1\"\n", &buf);
}

// Scenario: the golden run: no scp; the container fetches the deck, writes the recipe into it and runs it.
test the_golden_run_pins_its_bytes {
    var buf : [2048]u8 = [0] ** 2048;
    var line : [2048]u8 = [0] ** 2048;
    const g : TriRemoteReq = mk_golden("h", "sar_golden", 12);
    assert step_is(g, 0, "ssh\n-o\nBatchMode=yes\nh\nmkdir -p $HOME/t27-jobs/sar_golden-1760000000\n", &buf);
    assert step_is(g, 1, "ssh\n-o\nBatchMode=yes\nh\ndocker run -d --name t27job-sar_golden-1760000000 -v $HOME/t27-jobs/sar_golden-1760000000:/work t27-ngspice:47-osdi sh -c \"cd /work && curl -sSfL -o top.spice https://example.org/golden/top.spice && printf 'pre_osdi /opt/osdi/psp103.osdi\\npre_osdi /opt/osdi/psp103_nqs.osdi\\npre_osdi /opt/osdi/r3_cmc.osdi\\npre_osdi /opt/osdi/mosvar.osdi\\npre_osdi /opt/osdi/cap_cmomi.osdi\\npre_osdi /opt/osdi/cap_cmomf.osdi\\noption klu\\nset num_threads=12\\n' > ins.txt && sed -e 's,/usr/local/share/OpenPDKs/IHP-Open-PDK,/opt/IHP-Open-PDK,g' -e '/^\\.control/r ins.txt' top.spice > run.spice && ngspice -b run.spice > ngspice.log 2>&1\"\n", &buf);
    assert shell_is(g, 1, "ssh -o BatchMode=yes h 'docker run -d --name t27job-sar_golden-1760000000 -v $HOME/t27-jobs/sar_golden-1760000000:/work t27-ngspice:47-osdi sh -c \"cd /work && curl -sSfL -o top.spice https://example.org/golden/top.spice && printf '\\''pre_osdi /opt/osdi/psp103.osdi\\npre_osdi /opt/osdi/psp103_nqs.osdi\\npre_osdi /opt/osdi/r3_cmc.osdi\\npre_osdi /opt/osdi/mosvar.osdi\\npre_osdi /opt/osdi/cap_cmomi.osdi\\npre_osdi /opt/osdi/cap_cmomf.osdi\\noption klu\\nset num_threads=12\\n'\\'' > ins.txt && sed -e '\\''s,/usr/local/share/OpenPDKs/IHP-Open-PDK,/opt/IHP-Open-PDK,g'\\'' -e '\\''/^\\.control/r ins.txt'\\'' top.spice > run.spice && ngspice -b run.spice > ngspice.log 2>&1\"'", &buf, &line);
    // no scp step: step 2 of a golden run does not exist
    assert command(g, 2, &buf) == 0;
    // the thread count is written as given, in 1..16
    var n : usize = command(mk_golden("h", "g", 1), 1, &buf);
    assert buf_has(&buf, n, "set num_threads=1\\n'") == true;
    assert buf_has(&buf, n, "set num_threads=16") == false;
    n = command(mk_golden("h", "g", 16), 1, &buf);
    assert buf_has(&buf, n, "set num_threads=16\\n'") == true;
    assert buf_has(&buf, n, "set num_threads=1\\n'") == false;
    n = command(mk_golden("h", "g", 9), 1, &buf);
    assert buf_has(&buf, n, "set num_threads=9\\n'") == true;
    // the recipe's other words are in every golden command: six models, klu, the prefix rewrite, the insert after .control
    assert buf_has(&buf, n, "pre_osdi /opt/osdi/psp103.osdi") == true;
    assert buf_has(&buf, n, "pre_osdi /opt/osdi/psp103_nqs.osdi") == true;
    assert buf_has(&buf, n, "pre_osdi /opt/osdi/r3_cmc.osdi") == true;
    assert buf_has(&buf, n, "pre_osdi /opt/osdi/mosvar.osdi") == true;
    assert buf_has(&buf, n, "pre_osdi /opt/osdi/cap_cmomi.osdi") == true;
    assert buf_has(&buf, n, "pre_osdi /opt/osdi/cap_cmomf.osdi") == true;
    assert buf_has(&buf, n, "option klu") == true;
    assert buf_has(&buf, n, "s,/usr/local/share/OpenPDKs/IHP-Open-PDK,/opt/IHP-Open-PDK,g") == true;
    assert buf_has(&buf, n, "/^\\.control/r ins.txt") == true;
    // a plain run has none of it
    n = command(mk(OP_RUN, "h", "x.cir", "", ""), 2, &buf);
    assert buf_has(&buf, n, "pre_osdi") == false;
    assert buf_has(&buf, n, "curl") == false;
    assert buf_has(&buf, n, "sed") == false;
}

// Scenario: status, logs, stop and fetch.
test the_other_actions_pin_their_bytes {
    var buf : [2048]u8 = [0] ** 2048;
    var line : [2048]u8 = [0] ** 2048;
    const st : TriRemoteReq = mk(OP_STATUS, "h", "rc_fixed-1760000000", "", "");
    assert step_is(st, 0, "ssh\n-o\nBatchMode=yes\nh\ndocker ps -a --filter \"name=^t27job-rc_fixed-1760000000$\" --format \"{{.Names}} {{.Status}}\"\n", &buf);
    assert shell_is(st, 0, "ssh -o BatchMode=yes h 'docker ps -a --filter \"name=^t27job-rc_fixed-1760000000$\" --format \"{{.Names}} {{.Status}}\"'", &buf, &line);
    const lg : TriRemoteReq = mk(OP_LOGS, "h", "rc_fixed-1760000000", "", "");
    assert step_is(lg, 0, "ssh\n-o\nBatchMode=yes\nh\ndocker logs --tail 40 t27job-rc_fixed-1760000000; tail -n 40 $HOME/t27-jobs/rc_fixed-1760000000/ngspice.log\n", &buf);
    assert shell_is(lg, 0, "ssh -o BatchMode=yes h 'docker logs --tail 40 t27job-rc_fixed-1760000000; tail -n 40 $HOME/t27-jobs/rc_fixed-1760000000/ngspice.log'", &buf, &line);
    const sp : TriRemoteReq = mk(OP_STOP, "h", "rc_fixed-1760000000", "", "");
    assert step_is(sp, 0, "ssh\n-o\nBatchMode=yes\nh\ndocker rm -f t27job-rc_fixed-1760000000\n", &buf);
    assert shell_is(sp, 0, "ssh -o BatchMode=yes h 'docker rm -f t27job-rc_fixed-1760000000'", &buf, &line);
    const fe : TriRemoteReq = mk(OP_FETCH, "h", "rc_fixed-1760000000", "SAR_top_tb_tran.raw", "");
    assert step_is(fe, 0, "scp\n-o\nBatchMode=yes\nh:t27-jobs/rc_fixed-1760000000/SAR_top_tb_tran.raw\n./\n", &buf);
    assert shell_is(fe, 0, "scp -o BatchMode=yes h:t27-jobs/rc_fixed-1760000000/SAR_top_tb_tran.raw ./", &buf, &line);
    const to : TriRemoteReq = mk(OP_FETCH, "user@h", "rc_fixed-1760000000", "ngspice.log", "out/run1");
    assert step_is(to, 0, "scp\n-o\nBatchMode=yes\nuser@h:t27-jobs/rc_fixed-1760000000/ngspice.log\nout/run1/\n", &buf);
    assert shell_is(to, 0, "scp -o BatchMode=yes user@h:t27-jobs/rc_fixed-1760000000/ngspice.log out/run1/", &buf, &line);
}

// Scenario (negative control): every builder refuses a name with a byte no rule allows, in every slot that takes a name, and
// sends nothing at any step. The same table with a plain name refuses nothing, so the count measures the byte.
test every_builder_refuses_what_no_rule_allows {
    var buf : [2048]u8 = [0] ** 2048;
    assert refused_count("ok_1-2", &buf) == 0;
    assert refused_count("a b", &buf) == 10;
    assert refused_count("a;b", &buf) == 10;
    assert refused_count("a$(x)", &buf) == 10;
    assert refused_count("a$x", &buf) == 10;
    assert refused_count("a`x`", &buf) == 10;
    assert refused_count("a'b", &buf) == 10;
    assert refused_count("a\"b", &buf) == 10;
    assert refused_count("a\nb", &buf) == 10;
    assert refused_count("a\tb", &buf) == 10;
    assert refused_count("a|b", &buf) == 10;
    assert refused_count("a&b", &buf) == 10;
    assert refused_count("a&&b", &buf) == 10;
    assert refused_count("a>b", &buf) == 10;
    assert refused_count("a<b", &buf) == 10;
    assert refused_count("a*", &buf) == 10;
    assert refused_count("a?", &buf) == 10;
    assert refused_count("a\\b", &buf) == 10;
    assert refused_count("(a)", &buf) == 10;
    assert refused_count("{a}", &buf) == 10;
    assert refused_count("[a]", &buf) == 10;
    assert refused_count("a!", &buf) == 10;
    assert refused_count("a#b", &buf) == 10;
    assert refused_count("~a", &buf) == 10;
    assert refused_count("a%b", &buf) == 10;
    assert refused_count("a=b", &buf) == 10;
    assert refused_count("a,b", &buf) == 10;
    assert refused_count("a+b", &buf) == 10;
    assert refused_count("a^b", &buf) == 10;
    assert refused_count("-x", &buf) == 10;
    assert refused_count("-oProxyCommand", &buf) == 10;
    assert refused_count("rm -rf ~", &buf) == 10;
    assert refused_count("x;ssh evil true", &buf) == 10;
    // a slash is a path's byte and no other slot's; a dot is a name's and no id's
    assert sends_nothing(mk(OP_STATUS, "h", "a/b", "", ""), &buf);
    assert sends_nothing(mk(OP_FETCH, "h", "j-1", "a/b", ""), &buf);
    assert sends_nothing(mk_golden("h", "a/b", 8), &buf);
    assert sends_nothing(mk(OP_STATUS, "h", "rc.cir", "", ""), &buf);
    assert sends_nothing(mk(OP_STATUS, "h", "..", "", ""), &buf);
    assert sends_nothing(mk(OP_RUN, "h", "../deck.cir", "", ""), &buf);
    assert sends_nothing(mk(OP_RUN, "h", "dir/", "", ""), &buf);
    assert sends_nothing(mk(OP_FETCH, "h", "j-1", "f.raw", "../up"), &buf);
}

// Scenario: the host. With TRI_REMOTE_HOST unset (the empty host) every action refuses and says so, whatever else it carries.
test an_unset_host_refuses_every_action {
    var buf : [2048]u8 = [0] ** 2048;
    assert refusal(mk(OP_PING, "", "", "", "")) == R_NO_HOST;
    assert refusal(mk(OP_RUN, "", "rc_fixed.cir", "", "")) == R_NO_HOST;
    assert refusal(mk_golden("", "sar_golden", 12)) == R_NO_HOST;
    assert refusal(mk(OP_STATUS, "", "j-1", "", "")) == R_NO_HOST;
    assert refusal(mk(OP_LOGS, "", "j-1", "", "")) == R_NO_HOST;
    assert refusal(mk(OP_STOP, "", "j-1", "", "")) == R_NO_HOST;
    assert refusal(mk(OP_FETCH, "", "j-1", "f.raw", "")) == R_NO_HOST;
    assert refusal(mk(OP_RUN, "", "x y", "", "")) == R_NO_HOST;
    assert sends_nothing(mk(OP_PING, "", "", "", ""), &buf);
    assert sends_nothing(mk(OP_RUN, "", "rc_fixed.cir", "", ""), &buf);
    assert sends_nothing(mk(OP_FETCH, "", "j-1", "f.raw", ""), &buf);
    // the same requests with a host are fine
    assert refusal(mk(OP_PING, "h", "", "", "")) == R_OK;
    assert refusal(mk(OP_RUN, "h", "rc_fixed.cir", "", "")) == R_OK;
    assert refusal(mk_golden("h", "sar_golden", 12)) == R_OK;
    assert refusal(mk(OP_STATUS, "h", "j-1", "", "")) == R_OK;
    assert refusal(mk(OP_LOGS, "h", "j-1", "", "")) == R_OK;
    assert refusal(mk(OP_STOP, "h", "j-1", "", "")) == R_OK;
    assert refusal(mk(OP_FETCH, "h", "j-1", "f.raw", "")) == R_OK;
    // an odd host is not a host
    assert refusal(mk(OP_PING, "-oProxyCommand=x", "", "", "")) == R_BAD_HOST;
    assert refusal(mk(OP_PING, "h h", "", "", "")) == R_BAD_HOST;
    assert refusal(mk(OP_PING, "h;x", "", "", "")) == R_BAD_HOST;
    assert refusal(mk(OP_PING, "-v", "", "", "")) == R_BAD_HOST;
    assert sends_nothing(mk(OP_PING, "-v", "", "", ""), &buf);
}

// Scenario: the image and the golden deck's address, and the thread count (read for --golden only).
test the_image_the_address_and_the_threads {
    var buf : [2048]u8 = [0] ** 2048;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: "a b", name: "x.cir", file: "", dest: "", url: TEST_URL, threads: 8, counter: 1, golden: false }) == R_BAD_IMAGE;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: "", name: "x.cir", file: "", dest: "", url: TEST_URL, threads: 8, counter: 1, golden: false }) == R_BAD_IMAGE;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: "-x", name: "x.cir", file: "", dest: "", url: TEST_URL, threads: 8, counter: 1, golden: true }) == R_BAD_IMAGE;
    // the image only matters to a run
    assert refusal(TriRemoteReq { op: OP_STATUS, host: "h", image: "a b", name: "j-1", file: "", dest: "", url: "", threads: 0, counter: 1, golden: false }) == R_OK;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "g", file: "", dest: "", url: "", threads: 8, counter: 1, golden: true }) == R_NO_URL;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "g", file: "", dest: "", url: "http://example.org/t.spice", threads: 8, counter: 1, golden: true }) == R_BAD_URL;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "g", file: "", dest: "", url: "https://example.org/a;b", threads: 8, counter: 1, golden: true }) == R_BAD_URL;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "g", file: "", dest: "", url: "https://example.org/a$(b)", threads: 8, counter: 1, golden: true }) == R_BAD_URL;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "g", file: "", dest: "", url: "https://example.org/a\nb", threads: 8, counter: 1, golden: true }) == R_BAD_URL;
    // a plain run needs no address and sends no thread count
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "x.cir", file: "", dest: "", url: "", threads: 0, counter: 1, golden: false }) == R_OK;
    assert refusal(TriRemoteReq { op: OP_RUN, host: "h", image: DEFAULT_IMAGE, name: "x.cir", file: "", dest: "", url: "not a url", threads: 99, counter: 1, golden: false }) == R_OK;
    // the thread count of a golden run is 1 to 16
    assert refusal(mk_golden("h", "g", 0)) == R_BAD_THREADS;
    assert refusal(mk_golden("h", "g", 1)) == R_OK;
    assert refusal(mk_golden("h", "g", 8)) == R_OK;
    assert refusal(mk_golden("h", "g", 16)) == R_OK;
    assert refusal(mk_golden("h", "g", 17)) == R_BAD_THREADS;
    assert refusal(mk_golden("h", "g", 1000)) == R_BAD_THREADS;
    assert refusal(mk_golden("h", "g", 18446744073709551615)) == R_BAD_THREADS;
    assert sends_nothing(mk_golden("h", "g", 0), &buf);
    assert sends_nothing(mk_golden("h", "g", 17), &buf);
    assert THREADS_MIN == 1 and THREADS_MAX == 16 and DEFAULT_THREADS >= THREADS_MIN and DEFAULT_THREADS <= THREADS_MAX;
}

// Scenario: an argument the action does not use is refused, not ignored; a missing one is named.
test an_unused_argument_is_refused_and_a_missing_one_is_named {
    assert refusal(mk(OP_PING, "h", "a;b", "", "")) == R_UNEXPECTED;
    assert refusal(mk(OP_PING, "h", "j-1", "", "")) == R_UNEXPECTED;
    assert refusal(mk(OP_STATUS, "h", "j-1", "f.raw", "")) == R_UNEXPECTED;
    assert refusal(mk(OP_STATUS, "h", "j-1", "", "out")) == R_UNEXPECTED;
    assert refusal(mk(OP_RUN, "h", "x.cir", "f.raw", "")) == R_UNEXPECTED;
    assert refusal(mk(OP_STOP, "h", "j-1", "", "out")) == R_UNEXPECTED;
    assert refusal(TriRemoteReq { op: OP_STATUS, host: "h", image: DEFAULT_IMAGE, name: "j-1", file: "", dest: "", url: TEST_URL, threads: 8, counter: 1, golden: true }) == R_UNEXPECTED;
    assert refusal(mk(OP_RUN, "h", "", "", "")) == R_NO_NAME;
    assert refusal(mk_golden("h", "", 8)) == R_NO_NAME;
    assert refusal(mk(OP_STATUS, "h", "", "", "")) == R_NO_NAME;
    assert refusal(mk(OP_LOGS, "h", "", "", "")) == R_NO_NAME;
    assert refusal(mk(OP_STOP, "h", "", "", "")) == R_NO_NAME;
    assert refusal(mk(OP_FETCH, "h", "", "f.raw", "")) == R_NO_NAME;
    assert refusal(mk(OP_FETCH, "h", "j-1", "", "")) == R_NO_FILE;
    assert refusal(mk(OP_FETCH, "h", "j-1", "a b", "")) == R_BAD_FILE;
    assert refusal(mk(OP_FETCH, "h", "j-1", "../x", "")) == R_BAD_FILE;
    assert refusal(mk(OP_FETCH, "h", "j-1", "f.raw", "a b")) == R_BAD_DEST;
    assert refusal(mk(OP_FETCH, "h", "a b", "f.raw", "")) == R_BAD_NAME;
    assert refusal(mk(OP_RUN, "h", "a b.cir", "", "")) == R_BAD_NAME;
    assert refusal(mk(OP_RUN, "h", "a;b.cir", "", "")) == R_BAD_NAME;
    assert refusal(mk_golden("h", "a b", 8)) == R_BAD_NAME;
    assert refusal(mk(OP_NONE, "h", "", "", "")) == R_NO_ACTION;
    assert refusal(mk(7, "h", "", "", "")) == R_NO_ACTION;
    assert refusal(mk(255, "h", "", "", "")) == R_NO_ACTION;
}

// Scenario: the steps. A ping, a status, logs, stop and fetch have one; a plain run three; a golden run two. Past the last
// there is none.
test no_command_beyond_the_last_step {
    var buf : [2048]u8 = [0] ** 2048;
    assert command(mk(OP_PING, "h", "", "", ""), 0, &buf) > 0;
    assert command(mk(OP_PING, "h", "", "", ""), 1, &buf) == 0;
    assert command(mk(OP_RUN, "h", "x.cir", "", ""), 0, &buf) > 0;
    assert command(mk(OP_RUN, "h", "x.cir", "", ""), 1, &buf) > 0;
    assert command(mk(OP_RUN, "h", "x.cir", "", ""), 2, &buf) > 0;
    assert command(mk(OP_RUN, "h", "x.cir", "", ""), 3, &buf) == 0;
    assert command(mk(OP_RUN, "h", "x.cir", "", ""), 255, &buf) == 0;
    assert command(mk_golden("h", "g", 8), 0, &buf) > 0;
    assert command(mk_golden("h", "g", 8), 1, &buf) > 0;
    assert command(mk_golden("h", "g", 8), 2, &buf) == 0;
    assert command(mk(OP_STATUS, "h", "j-1", "", ""), 0, &buf) > 0;
    assert command(mk(OP_STATUS, "h", "j-1", "", ""), 1, &buf) == 0;
    assert command(mk(OP_LOGS, "h", "j-1", "", ""), 0, &buf) > 0;
    assert command(mk(OP_LOGS, "h", "j-1", "", ""), 1, &buf) == 0;
    assert command(mk(OP_STOP, "h", "j-1", "", ""), 0, &buf) > 0;
    assert command(mk(OP_STOP, "h", "j-1", "", ""), 1, &buf) == 0;
    assert command(mk(OP_FETCH, "h", "j-1", "f.raw", ""), 0, &buf) > 0;
    assert command(mk(OP_FETCH, "h", "j-1", "f.raw", ""), 1, &buf) == 0;
    // the room: a buffer too short gives no command, not a cut one
    var tiny : [16]u8 = [0] ** 16;
    assert command(mk(OP_PING, "h", "", "", ""), 0, &tiny) == 0;
    assert command(mk(OP_RUN, "h", "x.cir", "", ""), 2, &tiny) == 0;
}

// Scenario: the worst case of each template, the longest host, name, image, address and directory every rule lets through, fits
// CMD_MAX in the argument form and in the shell form.
test the_worst_case_fits {
    var buf : [2048]u8 = [0] ** 2048;
    var line : [2048]u8 = [0] ** 2048;
    assert CMD_MAX == 2048;
    const gold : TriRemoteReq = TriRemoteReq { op: OP_RUN, host: H96, image: IMG128, name: N64, file: "", dest: "", url: URL200, threads: 16, counter: 18446744073709551615, golden: true };
    assert refusal(gold) == R_OK;
    const n : usize = command(gold, 1, &buf);
    assert n > 0 and n < CMD_MAX;
    const m : usize = shell_form(&buf, n, &line);
    assert m > n and m < CMD_MAX;
    const deck : TriRemoteReq = TriRemoteReq { op: OP_RUN, host: H96, image: IMG128, name: DECK256, file: "", dest: "", url: "", threads: 0, counter: 18446744073709551615, golden: false };
    assert refusal(deck) == R_OK;
    assert command(deck, 0, &buf) > 0 and shell_form(&buf, command(deck, 0, &buf), &line) > 0;
    assert command(deck, 1, &buf) > 0 and shell_form(&buf, command(deck, 1, &buf), &line) > 0;
    assert command(deck, 2, &buf) > 0 and shell_form(&buf, command(deck, 2, &buf), &line) > 0;
    const fe : TriRemoteReq = TriRemoteReq { op: OP_FETCH, host: H96, image: "", name: N64, file: N64, dest: PATH256, url: "", threads: 0, counter: 0, golden: false };
    assert refusal(fe) == R_OK;
    assert command(fe, 0, &buf) > 0 and shell_form(&buf, command(fe, 0, &buf), &line) > 0;
    const lg : TriRemoteReq = TriRemoteReq { op: OP_LOGS, host: H96, image: "", name: N64, file: "", dest: "", url: "", threads: 0, counter: 0, golden: false };
    assert command(lg, 0, &buf) > 0 and shell_form(&buf, command(lg, 0, &buf), &line) > 0;
}

// Scenario: the shell form reads back to the same arguments: bare when plain, else in single quotes, a quote as '\''.
test the_shell_form_reads_back {
    var line : [64]u8 = [0] ** 64;
    const ping : string = "ssh\n-o\nBatchMode=yes\nh\ntrue\n";
    const two : string = "a\nb\n";
    const spaced : string = "a b\n";
    const home : string = "$HOME/x\n";
    const semi : string = "x;y\n";
    const apos : string = "it's\n";
    const lone : string = "'\n";
    const empty : string = "\n";
    const hole : string = "a\n\nb\n";
    const bare : string = "h:t27-jobs/x/deck.cir\n";
    const marks : string = "u@h:a,b+c%d=e\n";
    assert buf_is(&line, shell_form(two, two.len, &line), "a b");
    assert buf_is(&line, shell_form(ping, ping.len, &line), "ssh -o BatchMode=yes h true");
    assert buf_is(&line, shell_form(spaced, spaced.len, &line), "'a b'");
    assert buf_is(&line, shell_form(home, home.len, &line), "'$HOME/x'");
    assert buf_is(&line, shell_form(semi, semi.len, &line), "'x;y'");
    assert buf_is(&line, shell_form(apos, apos.len, &line), "'it'\\''s'");
    assert buf_is(&line, shell_form(lone, lone.len, &line), "''\\'''");
    assert buf_is(&line, shell_form(empty, empty.len, &line), "''");
    assert buf_is(&line, shell_form(hole, hole.len, &line), "a '' b");
    assert buf_is(&line, shell_form(bare, bare.len, &line), "h:t27-jobs/x/deck.cir");
    assert buf_is(&line, shell_form(marks, marks.len, &line), "u@h:a,b+c%d=e");
    assert shell_form(two, 0, &line) == 0;
    var tiny : [3]u8 = [0] ** 3;
    assert shell_form(apos, apos.len, &tiny) == 0;
}

// Scenario: every refusal has its own words, and every action its word.
test every_refusal_has_its_words {
    var a : u8 = 0;
    while (a < REFUSALS) {
        assert refusal_text(a).len > 10;
        var b : u8 = a + 1;
        while (b < REFUSALS) {
            assert span_is(refusal_text(a), 0, refusal_text(a).len, refusal_text(b)) == false;
            b = b + 1;
        }
        a = a + 1;
    }
    assert refusal_text(R_NO_HOST)[0] == 'T' and refusal_text(R_NO_HOST)[1] == 'R';
    assert action_op("ping") == OP_PING;
    assert action_op("run") == OP_RUN;
    assert action_op("status") == OP_STATUS;
    assert action_op("logs") == OP_LOGS;
    assert action_op("stop") == OP_STOP;
    assert action_op("fetch") == OP_FETCH;
    assert action_op("") == OP_NONE;
    assert action_op("Ping") == OP_NONE;
    assert action_op("ping ") == OP_NONE;
    assert action_op("pin") == OP_NONE;
    assert action_op("exec") == OP_NONE;
    assert action_op("run;ls") == OP_NONE;
}
