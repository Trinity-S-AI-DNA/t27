// SPDX-License-Identifier: Apache-2.0
// specs/tri/commands/pareto_commands.t27 -- new tri commands for the Pareto improvement loop:
//   tri pareto audit       list anomalies ranked by impact x frequency
//   tri pareto fix <n>     write the .t27 fix for anomaly n, with test/invariant/bench
//   tri pareto verify      t27c test + seal + corpus receipt compare vs master
//   tri pareto land        commit with L1 ref, push once per batch, open PR, merge when green
//   tri pareto beat        post the tick verdict to the hive feed
//   tri pareto self-heal   revert this tick's change if any check red past the window
//   tri experience save    save a learned lesson into a skill's Traps section (dedup)
// phi^2 + 1/phi^2 = 3 | TRINITY

module TriParetoCommands;

pub const KIND : str = "tri";
pub const ID : str = "t27/tri-pareto-commands";
pub const NAME : str = "TRI Pareto commands";
pub const SUMMARY_EN : str = "New tri commands for the continuous improvement loop: audit, fix, verify, land, beat, self-heal, experience save.";
pub const ENABLED : bool = true;

// ---- command ids ----
pub const CMD_AUDIT : u8 = 0;
pub const CMD_FIX : u8 = 1;
pub const CMD_VERIFY : u8 = 2;
pub const CMD_LAND : u8 = 3;
pub const CMD_BEAT : u8 = 4;
pub const CMD_SELF_HEAL : u8 = 5;
pub const CMD_EXPERIENCE_SAVE : u8 = 6;
pub const CMDS : u8 = 7;

// ---- is this command available on this host? All run locally; land needs gh. ----
pub fn cmd_available(c: u8, gh_logged_in: bool) -> bool {
    if (c == CMD_LAND) { return gh_logged_in; }
    return true;
}

test land_needs_gh_others_do_not {
    assert cmd_available(CMD_LAND, false) == false;
    assert cmd_available(CMD_LAND, true);
    assert cmd_available(CMD_AUDIT, false);
    assert cmd_available(CMD_VERIFY, false);
    assert cmd_available(CMD_EXPERIENCE_SAVE, false);
}

// ---- experience save: the lesson key ----
// The key of a text is its letters and digits, upper case folded to lower, every other ASCII byte dropped.
pub fn lesson_key_char(b: u8) -> bool {
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b >= 128;
}

pub fn lesson_key_len(text: str) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < text.len) {
        if (lesson_key_char(text[i])) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

test lesson_key_counts_alnum_and_high {
    assert lesson_key_len("A b-C!") == 3;
    assert lesson_key_len("   ") == 0;
    assert lesson_key_len("") == 0;
}

// ---- is a lesson a duplicate of an existing block: key substring or whole-key match? ----
pub fn lesson_duplicate(block_key: str, lesson_key: str, lesson_short: bool) -> bool {
    if (lesson_short) {
        return block_key.len == lesson_key.len and keys_equal(block_key, lesson_key);
    }
    return key_substring(block_key, lesson_key);
}

pub fn keys_equal(a: str, b: str) -> bool {
    if (a.len != b.len) { return false; }
    var i : u32 = 0;
    while (i < a.len) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

pub fn key_substring(hay: str, needle: str) -> bool {
    if (needle.len == 0) { return false; }
    if (needle.len > hay.len) { return false; }
    var i : u32 = 0;
    while (i + needle.len <= hay.len) {
        var m : u32 = 0;
        while (m < needle.len and hay[i + m] == needle[m]) { m = m + 1; }
        if (m == needle.len) { return true; }
        i = i + 1;
    }
    return false;
}

test duplicate_matches_substring_or_whole {
    assert lesson_duplicate("thezigcacheisnotwritable", "zigcache", false);
    assert lesson_duplicate("thezigcacheisnotwritable", "zigcache", true) == false;
    assert lesson_duplicate("zigcache", "zigcache", true);
    assert lesson_duplicate("abc", "abcd", false) == false;
    assert lesson_duplicate("abc", "", false) == false;
}

invariant commands_numbered {
    assert CMDS == 7;
}
