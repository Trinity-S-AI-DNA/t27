// specs/tri/t27b_test_issues.t27 -- t27b test issues: ledger pass_ct,
// discarded test total, DX floatFromInt, module-qualified imported fn.
// Part of M3 milestone (milestone #7). Closes #13213 #13101 #13106 #13103.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::t27b_test_issues;

pub const T27B_TEST_MAX_CHECKS : u32 = 16;

pub struct TestCheck { name: str, correct: bool };

pub fn test_check_correct(c: TestCheck) -> bool {
    return c.correct;
}

test "test_check_correct" {
    assert(test_check_correct(TestCheck { name: "pass_ct", correct: true }));
    assert(!test_check_correct(TestCheck { name: "discarded_total", correct: false }));
}

invariant t27b_test_max_checks_positive {
    assert T27B_TEST_MAX_CHECKS > 0;
}