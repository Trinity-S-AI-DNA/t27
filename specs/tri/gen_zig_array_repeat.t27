// SPDX-License-Identifier: Apache-2.0
// specs/tri/gen_zig_array_repeat.t27 -- t27c gen-zig: array repeat count
// emitted without parentheses.
// Part of M2 milestone (milestone #6). Closes #13311.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::gen_zig_array_repeat;

pub const GEN_ZIG_ARRAY_REPEAT_MAX : u32 = 1024;

pub struct ArrayRepeat { count: u32, parenthesized: bool };

pub fn array_repeat_parenthesized(a: ArrayRepeat) -> bool {
    return a.parenthesized;
}

test "array_repeat_parenthesized" {
    assert(array_repeat_parenthesized(ArrayRepeat { count: 5, parenthesized: true }));
    assert(!array_repeat_parenthesized(ArrayRepeat { count: 5, parenthesized: false }));
}

invariant gen_zig_array_repeat_max_positive {
    assert GEN_ZIG_ARRAY_REPEAT_MAX > 0;
}