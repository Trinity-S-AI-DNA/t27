// specs/tri/kanban.t27 -- EPIC: a kanban card opens its agent conversation --
// history, mobile sheet, A2A on the same thread.
// Part of M10 milestone (milestone #14). Closes #5388.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::kanban;

pub const KANBAN_MAX_CARDS : u32 = 256;

pub struct KanbanCard { id: str, lane: str };

pub fn kanban_card_id(c: KanbanCard) -> str {
    return c.id;
}

test "kanban_card_id" {
    assert(kanban_card_id(KanbanCard { id: "K-1", lane: "lane-1" }) == "K-1");
}

invariant kanban_max_cards_positive {
    assert KANBAN_MAX_CARDS > 0;
}