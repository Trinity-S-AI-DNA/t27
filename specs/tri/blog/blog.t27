// specs/tri/blog/blog.t27 -- tri blog: a spec-first publication front door.
// Part of M1 (milestone #5). Closes #12630.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::blog;

pub const BLOG_FRONT_DOOR : str = "/blog";

pub struct BlogPost { title: str, path: str, published: bool };

pub fn blog_post_published(p: BlogPost) -> bool {
    return p.published;
}

test "blog post published flag" {
    assert(blog_post_published(BlogPost { title: "hello", path: "/blog/hello", published: true }));
    assert(!blog_post_published(BlogPost { title: "draft", path: "/blog/draft", published: false }));
}

invariant blog_front_door_defined {
    assert BLOG_FRONT_DOOR == "/blog";
}