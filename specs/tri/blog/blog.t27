// SPDX-License-Identifier: Apache-2.0
// specs/tri/blog/blog.t27 -- the tri blog front door. It plans, drafts and checks
// a progress card. It is not a publisher. Social sends stay in
// specs/automation/blog-share.t27, and that desk still needs the owner's tap.
// Publish writes the site only when the owner passes --yes, and even then it
// does not post to a network. This change does not publish.
// The percent arithmetic is pinned to the same 70/149 = 47 vector as
// specs/blog/epic_progress.t27 card_percent. No cli/tri glue in this change.
// phi^2 + 1/phi^2 = 3 | TRINITY

module TriBlog {

    pub const ID : str = "tri-blog";
    pub const PUBLISHER : str = "specs/automation/blog-share.t27";
    pub const THIS_IS_A_PUBLISHER : bool = false;
    pub const SOCIAL_FROM_BLOG : bool = false;
    pub const RAN_PUBLISH : bool = false;
    pub const GLUE_WRITTEN : bool = false;
    pub const T27B_SLUG : str = "t27b-against-other-second-backends";
    pub const T27B_ON_SITE : bool = false;
    pub const SITE_PUBLISH_IS_MERGE : bool = false;

    pub const VERB_PLAN : u8 = 1;
    pub const VERB_DRAFT : u8 = 2;
    pub const VERB_CHECK : u8 = 3;
    pub const VERB_PUBLISH : u8 = 4;
    pub const VERB_COUNT : u8 = 4;

    pub const EXIT_OK : u8 = 0;
    pub const EXIT_REFUSED : u8 = 1;
    pub const EXIT_NOT_MEASURED : u8 = 3;

    fn verb_name(v: u8) -> str {
        if v == VERB_PLAN {
            return "plan";
        }
        if v == VERB_DRAFT {
            return "draft";
        }
        if v == VERB_CHECK {
            return "check";
        }
        if v == VERB_PUBLISH {
            return "publish";
        }
        return "";
    }

    // A countable source is a Progress block, else checkboxes, else sub-issues.
    fn plan_exit(has_block: bool, has_checks: bool, has_subs: bool) -> u8 {
        if has_block {
            return EXIT_OK;
        }
        if has_checks {
            return EXIT_OK;
        }
        if has_subs {
            return EXIT_OK;
        }
        return EXIT_NOT_MEASURED;
    }

    // Half-up integer percent. A zero total is not a number the card may print.
    fn percent_points(done: u32, total: u32) -> u32 {
        if total == 0 {
            return 0;
        }
        return (done * 100 + total / 2) / total;
    }

    fn plan_prints_number(has_source: bool, total: u32) -> bool {
        if !has_source {
            return false;
        }
        return total > 0;
    }

    fn date_follows(prev: u32, next: u32) -> bool {
        return next >= prev;
    }

    // A draft keeps a number only when a source line sits next to it.
    fn draft_keeps(has_source_line: bool) -> bool {
        return has_source_line;
    }

    fn check_passes(failing: u32, token_claim: bool, over_budget: bool) -> bool {
        if failing > 0 {
            return false;
        }
        if token_claim {
            return false;
        }
        if over_budget {
            return false;
        }
        return true;
    }

    fn value_claim_refused(mentions_tri_value: bool, mentions_xp: bool) -> bool {
        if mentions_tri_value {
            return true;
        }
        return mentions_xp;
    }

    // --yes writes the plan into the site tree. Without it, nothing is written.
    fn publish_exit(yes: bool) -> u8 {
        if yes {
            return EXIT_OK;
        }
        return EXIT_REFUSED;
    }

    fn publish_writes(yes: bool) -> bool {
        return yes;
    }

    fn publish_posts_social() -> bool {
        return SOCIAL_FROM_BLOG;
    }

    test "help lists plan, draft, check and publish" {
        assert(VERB_COUNT == 4);
        assert(verb_name(VERB_PLAN) == "plan");
        assert(verb_name(VERB_DRAFT) == "draft");
        assert(verb_name(VERB_CHECK) == "check");
        assert(verb_name(VERB_PUBLISH) == "publish");
        assert(verb_name(0) == "");
        assert(verb_name(5) == "");
        assert(!THIS_IS_A_PUBLISHER);
        assert(PUBLISHER == "specs/automation/blog-share.t27");
    }

    test "seventy of one hundred forty nine is forty seven percent" {
        assert(percent_points(70, 149) == 47);
        assert(percent_points(0, 10) == 0);
        assert(percent_points(10, 0) == 0);
        assert(plan_prints_number(true, 149));
        assert(!plan_prints_number(false, 149));
        assert(!plan_prints_number(true, 0));
    }

    test "no countable source is not measured" {
        assert(plan_exit(true, false, false) == 0);
        assert(plan_exit(false, true, false) == 0);
        assert(plan_exit(false, false, true) == 0);
        assert(plan_exit(false, false, false) == 3);
        assert(EXIT_NOT_MEASURED == 3);
        assert(EXIT_OK == 0);
    }

    test "dates move forward and a number without a source is refused" {
        assert(date_follows(20261026, 20261027));
        assert(date_follows(20261027, 20261027));
        assert(!date_follows(20261027, 20261026));
        assert(draft_keeps(true));
        assert(!draft_keeps(false));
    }

    test "check refuses a failure, a token claim and a caption over budget" {
        assert(check_passes(0, false, false));
        assert(!check_passes(1, false, false));
        assert(!check_passes(0, true, false));
        assert(!check_passes(0, false, true));
        assert(value_claim_refused(true, false));
        assert(value_claim_refused(false, true));
        assert(!value_claim_refused(false, false));
    }

    test "publish without yes writes nothing and never posts to a network" {
        assert(publish_exit(false) == 1);
        assert(!publish_writes(false));
        assert(publish_exit(true) == 0);
        assert(publish_writes(true));
        assert(!publish_posts_social());
        assert(!SOCIAL_FROM_BLOG);
        assert(!RAN_PUBLISH);
        assert(!GLUE_WRITTEN);
        assert(EXIT_REFUSED == 1);
    }

    test "the t27b progress post is not on the site, and a merge is not a publish" {
        assert(T27B_SLUG == "t27b-against-other-second-backends");
        assert(!T27B_ON_SITE);
        assert(!SITE_PUBLISH_IS_MERGE);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
