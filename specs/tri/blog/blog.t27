// SPDX-License-Identifier: Apache-2.0
// specs/tri/blog/blog.t27 -- the law of `tri blog` (Refs #12630).
//
// The subcommand has four verbs: plan, draft, check, publish. This file is
// the law. The cli/tri glue is not in this commit: a new Rust file is a new
// foreign file, and the issue asks for the owner-approved-foreign label
// before that glue lands. GLUE_LANDED stays false.
//
// publish never posts to a social network. Without --yes it writes nothing.
// A number with no source is "not measured", never 0.
// phi^2 + 1/phi^2 = 3 | TRINITY

module TriBlog;

pub const ID : str = "tri-blog";
pub const VERSION : u8 = 1;
pub const GLUE_LANDED : bool = false;
pub const POSTS_TO_SOCIAL : bool = false;

pub const EXIT_OK : u8 = 0;
pub const EXIT_REFUSED : u8 = 2;
pub const EXIT_NOT_MEASURED : u8 = 3;

pub const NOT_MEASURED : u32 = 1000;
pub const NOT_MEASURED_WORD : str = "not measured";

pub const VERB_PLAN : u8 = 1;
pub const VERB_DRAFT : u8 = 2;
pub const VERB_CHECK : u8 = 3;
pub const VERB_PUBLISH : u8 = 4;
pub const VERB_COUNT : u8 = 4;

pub const SRC_NONE : u8 = 0;
pub const SRC_BLOCK : u8 = 1;
pub const SRC_BOXES : u8 = 2;
pub const SRC_SUBS : u8 = 3;

// A progress block wins, then top-level checkboxes, then linked sub-issues.
fn progress_source(has_block: bool, has_boxes: bool, has_subs: bool) -> u8 {
    if has_block {
        return SRC_BLOCK;
    }
    if has_boxes {
        return SRC_BOXES;
    }
    if has_subs {
        return SRC_SUBS;
    }
    return SRC_NONE;
}

// Nearest percent. 70 / 149 = 47, the figure #12630 names for #12387.
// No source, or a zero total, is NOT_MEASURED, which is not 0.
fn card_points(has_source: bool, done: u32, total: u32) -> u32 {
    if !has_source {
        return NOT_MEASURED;
    }
    if total == 0 {
        return NOT_MEASURED;
    }
    return (done * 100 + total / 2) / total;
}

fn plan_exit(has_source: bool, done: u32, total: u32) -> u8 {
    if card_points(has_source, done, total) == NOT_MEASURED {
        return EXIT_NOT_MEASURED;
    }
    return EXIT_OK;
}

fn verb_known(verb: u8) -> bool {
    return verb >= VERB_PLAN && verb <= VERB_PUBLISH;
}

// A draft may store a number only when a source line sits next to it.
fn draft_accepts(has_source_line: bool) -> bool {
    return has_source_line;
}

fn dates_in_order(prev: u32, next: u32) -> bool {
    return prev < next;
}

// Without --yes, publish writes nothing and exits refused.
// With --yes, the law allows a write. It still does not post to a network.
fn publish_exit(yes: bool) -> u8 {
    if !yes {
        return EXIT_REFUSED;
    }
    return EXIT_OK;
}

fn publish_writes(yes: bool) -> bool {
    return yes;
}

fn publish_posts_social() -> bool {
    return POSTS_TO_SOCIAL;
}

test "seventy of one hundred forty nine rounds to forty seven" {
    assert(card_points(true, 70, 149) == 47);
    assert(plan_exit(true, 70, 149) == EXIT_OK);
    assert(card_points(false, 0, 149) == NOT_MEASURED);
    assert(card_points(false, 0, 149) != 0);
    assert(card_points(true, 0, 0) == NOT_MEASURED);
    assert(plan_exit(false, 70, 149) == EXIT_NOT_MEASURED);
    assert(plan_exit(true, 1, 0) == EXIT_NOT_MEASURED);
    assert(NOT_MEASURED_WORD == "not measured");
}

test "progress comes from a block, else checkboxes, else sub-issues" {
    assert(progress_source(true, true, true) == SRC_BLOCK);
    assert(progress_source(false, true, true) == SRC_BOXES);
    assert(progress_source(false, false, true) == SRC_SUBS);
    assert(progress_source(false, false, false) == SRC_NONE);
}

test "a draft refuses a number with no source, and dates move forward" {
    assert(draft_accepts(true));
    assert(!draft_accepts(false));
    assert(dates_in_order(20261026, 20261027));
    assert(!dates_in_order(20261027, 20261027));
    assert(!dates_in_order(20261028, 20261027));
}

test "publish without yes writes nothing and never posts" {
    assert(publish_exit(false) == EXIT_REFUSED);
    assert(!publish_writes(false));
    assert(publish_exit(true) == EXIT_OK);
    assert(publish_writes(true));
    assert(!publish_posts_social());
    assert(verb_known(VERB_PLAN));
    assert(verb_known(VERB_DRAFT));
    assert(verb_known(VERB_CHECK));
    assert(verb_known(VERB_PUBLISH));
    assert(!verb_known(0));
    assert(!verb_known(5));
    assert(VERB_COUNT == 4);
    assert(!GLUE_LANDED);
}
// phi^2 + 1/phi^2 = 3 | TRINITY
