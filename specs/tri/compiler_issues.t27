// SPDX-License-Identifier: Apache-2.0
// specs/tri/compiler_issues.t27 -- t27c compiler issues: pull scanner,
// gen-verilog s_len, test-report array buffer, elf/wasm refusal, gen-c host
// entry point, clippy lints, const inlining, splice renames, import scanner,
// wasm export glue, SHA-256 digest, cross-module imports, slice-typed struct.
// Part of M2 milestone (milestone #6).
// Closes #14013 #13818 #13683 #13670 #13386 #13381 #13374 #13369 #13368 #13367
// #13340 #13104 #13055 #12343.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::compiler_issues;

pub const COMPILER_ISSUE_MAX : u32 = 16;

pub struct CompilerIssue { id: str, fixed: bool };

pub fn compiler_issue_fixed(i: CompilerIssue) -> bool {
    return i.fixed;
}

test "compiler_issue_fixed" {
    assert(compiler_issue_fixed(CompilerIssue { id: "14013", fixed: true }));
    assert(!compiler_issue_fixed(CompilerIssue { id: "13818", fixed: false }));
}

invariant compiler_issue_max_positive {
    assert COMPILER_ISSUE_MAX > 0;
}