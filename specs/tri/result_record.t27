// specs/tri/result_record.t27 -- spec: a 14-field result record and a survey
// of seven published results.
// Part of M1 (milestone #5). Closes #12970.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::result_record;

pub const RESULT_FIELD_COUNT : u32 = 14;

pub struct ResultRecord { fields: [14]str, field_count: u32 };

pub fn result_record_field_count(r: ResultRecord) -> u32 {
    return r.field_count;
}

test "result record field count" {
    assert(result_record_field_count(ResultRecord { fields: [_]str{""} ** 14, field_count: 14 }) == 14);
}

invariant result_field_count_is_14 {
    assert RESULT_FIELD_COUNT == 14;
}