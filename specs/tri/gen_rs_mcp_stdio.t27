// SPDX-License-Identifier: Apache-2.0
// specs/tri/gen_rs_mcp_stdio.t27 -- t27c: gen-rs --mcp-stdio: generate stdio
// MCP dispatch from @extern specs.
// Part of M4 milestone (milestone #8). Closes #13571.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::gen_rs_mcp_stdio;

pub const GEN_RS_MCP_STDIO_DISPATCH : bool = true;

pub struct GenRsMcpStdio { dispatch_generated: bool };

pub fn gen_rs_mcp_stdio_dispatch_generated(g: GenRsMcpStdio) -> bool {
    return g.dispatch_generated;
}

test "gen_rs_mcp_stdio_dispatch_generated" {
    assert(gen_rs_mcp_stdio_dispatch_generated(GenRsMcpStdio { dispatch_generated: true }));
    assert(!gen_rs_mcp_stdio_dispatch_generated(GenRsMcpStdio { dispatch_generated: false }));
}

invariant gen_rs_mcp_stdio_dispatch_default {
    assert GEN_RS_MCP_STDIO_DISPATCH;
}