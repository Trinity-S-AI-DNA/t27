// specs/tri/frozen_hash_guard.t27 -- frozen-hash-guard.yml: hourly M5 guard.
// Part of M1 (milestone #5). Closes #12834.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::frozen_hash_guard;

pub const FROZEN_HASH_GUARD_HOURLY : bool = true;

pub struct FrozenHashGuard { hourly: bool, m5_guard: bool };

pub fn frozen_hash_guard_active(g: FrozenHashGuard) -> bool {
    return g.hourly && g.m5_guard;
}

test "frozen hash guard active" {
    assert(frozen_hash_guard_active(FrozenHashGuard { hourly: true, m5_guard: true }));
    assert(!frozen_hash_guard_active(FrozenHashGuard { hourly: true, m5_guard: false }));
}

invariant frozen_hash_guard_hourly_default {
    assert FROZEN_HASH_GUARD_HOURLY;
}