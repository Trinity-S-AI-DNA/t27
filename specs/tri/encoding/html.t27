// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// HTML5 subset | φ² + 1/φ² = 3 | TRINITY

module TriHtml;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const HtmlNode = struct {
        tag : "[]const u8",
        attributes : "?std.StringHashMap([]const u8)",
        children : "[]const HtmlNode",
        inner_text : "[]const u8",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Byte identity of tag: sum(code * position) over the tag name,
    // with position starting at 1. Same tag text → same code.
    fn tag_code(tag: []const u8) -> i64 {
        var sum : i64 = 0;
        var k : usize = 0;
        while (k < tag.len) {
            sum = sum + (tag[k] as i64) * ((k + 1) as i64);
            k = k + 1;
        }
        return sum;
    }

    // String equality without library calls.
    fn tag_eq(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var k : usize = 0;
        while (k < a.len) {
            if (a[k] != b[k]) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }

    // parse(html: []const u8) → i64
    // Walks the element tree of an HTML5 subset document:
    //   - opening tags must be closed in reverse order (well-formedness)
    //   - text content is allowed anywhere
    // Returns 0 when the document is not well-formed; otherwise a
    // checksum of the tree: root tag_code + elements * 10_000_000
    // + max_depth * 10_000.
    fn parse(html: []const u8) -> i64 {
        
        // Simple recursive-descent scan. States are represented by
        // nesting counters over a fixed tag stack of 32 entries.
        var tags : [32][]const u8 = undefined;
        var depth : usize = 0;
        var max_depth : usize = 0;
        var elements : usize = 0;
        var i : usize = 0;

        while (i < html.len) {
            if (html[i] == '<') {
                if (i + 1 >= html.len) {
                    return 0;
                }
                if (html[i + 1] == '/') {
                    // closing tag: </name>
                    i = i + 2;
                    var start = i;
                    while (i < html.len) {
                        if (html[i] == '>') {
                            break;
                        }
                        i = i + 1;
                    }
                    if (i >= html.len) {
                        return 0;
                    }
                    if (depth == 0) {
                        return 0;
                    }
                    if (!tag_eq(tags[depth - 1], html[start..i])) {
                        return 0;
                    }
                    depth = depth - 1;
                    i = i + 1;
                } else {
                    // opening tag: <name ...>
                    i = i + 1;
                    var start = i;
                    while (i < html.len) {
                        if (html[i] == '>' or html[i] == ' ' or html[i] == '/') {
                            break;
                        }
                        i = i + 1;
                    }
                    if (i >= html.len) {
                        return 0;
                    }
                    if (depth >= 32) {
                        return 0;
                    }
                    tags[depth] = html[start..i];
                    depth = depth + 1;
                    elements = elements + 1;
                    if (depth > max_depth) {
                        max_depth = depth;
                    }
                    if (html[i] == '>') {
                        i = i + 1;
                    }
                }
            } else {
                // text content: skip to next '<'
                while (i < html.len) {
                    if (html[i] == '<') {
                        break;
                    }
                    i = i + 1;
                }
            }
        }

        if (depth != 0) {
            // unclosed element(s) remain
            return 0;
        }
        if (elements == 0) {
            return 0;
        }

        return tag_code(tags[0]) + (elements as i64) * 10000000 + (max_depth as i64) * 10000;
    }

    // query_selector(node: HtmlNode, selector: []const u8) → bool
    // Depth-first search for any descendant (or self) whose tag
    // equals selector.
    fn query_selector(node: HtmlNode, selector: []const u8) -> bool {
        if (tag_eq(node.tag, selector)) {
            return true;
        }
        var k : usize = 0;
        while (k < node.children.len) {
            if (query_selector(node.children[k], selector)) {
                return true;
            }
            k = k + 1;
        }
        return false;
    }

    // default_input() → HtmlNode
    // The sample tree used by the behaviors: <div>hello
    // <span>world <b>!</b></span></div>
    fn default_input() -> HtmlNode {
        const b = HtmlNode{ .tag = "b", .attributes = null, .children = &.{}, .inner_text = "!" };
        const span = HtmlNode{ .tag = "span", .attributes = null, .children = &.{b}, .inner_text = "world" };
        const div = HtmlNode{ .tag = "div", .attributes = null, .children = &.{span}, .inner_text = "hello" };
        return div;
    }

    // Test drivers: BDD when-bindings call zero-argument helpers so
    // the sample tree reaches query_selector with a real value.
    fn selector_finds_span() -> bool {
        return query_selector(default_input(), "span");
    }

    fn selector_misses_table() -> bool {
        return query_selector(default_input(), "table");
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test parse_basic_case
        given input = "<div><span>world</span></div>"
        when result = parse(input)
        then result == 20020664

    test parse_rejects_unclosed
        given input = "<div>"
        when result = parse(input)
        then result == 0

    test parse_rejects_mismatched_close
        given input = "<div></span>"
        when result = parse(input)
        then result == 0

    test query_selector_basic_case
        when result = selector_finds_span()
        then result == true

    test query_selector_miss_case
        when result = selector_misses_table()
        then result == false

    test "parse_function"
        given html = "<html></html>"
        when result = parse(html)
        then result == 10010995
