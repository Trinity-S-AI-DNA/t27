// SPDX-License-Identifier: Apache-2.0
; specs/tri/oneoff_growth.t27 -- format constants and invariants for ONEOFF_GROWTH.
; The `tri oneoff` command (scripts/tri) generates the ONEOFF_GROWTH value for a branch.
; The consumer is specs/policy/own_language.t27 pub const ONEOFF_GROWTH.
; Eliminates manual computation errors when a PR adds hand-written foreign lines.
; Issue #14060. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module TriOneoffGrowth;

; ONEOFF_GROWTH encodes one or more git numstat entries for foreign files a PR
; is allowed to grow beyond the shrink clause. String format:
;   "<add>\t<del>\t<path>,...,$"
; Example (one file):  "8\t0\tscripts/tri,$"
; Example (two files): "2\t0\tlefthook.yml,8\t0\tscripts/tri,$"

; ASCII TAB (0x09) -- separates add, del, and path fields within each entry.
pub const FIELD_SEP : u8 = 9;

; ASCII ',' (0x2C) -- separates file entries in the ONEOFF_GROWTH string.
pub const ENTRY_SEP : u8 = 44;

; ASCII '$' (0x24) -- closes the ONEOFF_GROWTH string.
pub const TERMINATOR : u8 = 36;

; Minimum length of a valid single-file ONEOFF_GROWTH.
; Shortest example: "1\t0\tf,$" is 8 characters.
pub const MIN_VALUE_LEN : usize = 8;

; FILES (ONEOFF_GROWTH_FILES in own_language.t27) equals the number of ENTRY_SEP
; characters in the ONEOFF_GROWTH value.  tri oneoff prints both on stdout.

invariant field_sep_is_ascii_ht    { FIELD_SEP == 9 }
invariant entry_sep_is_ascii_comma { ENTRY_SEP == 44 }
invariant terminator_is_ascii_dollar { TERMINATOR == 36 }

; "1\t0\tf,$" is 8 bytes -- the shortest valid single-file ONEOFF_GROWTH.
test min_len_matches_shortest_example {
    assert MIN_VALUE_LEN == 8;
}

test separators_are_distinct {
    assert FIELD_SEP != ENTRY_SEP;
    assert FIELD_SEP != TERMINATOR;
    assert ENTRY_SEP != TERMINATOR;
}
