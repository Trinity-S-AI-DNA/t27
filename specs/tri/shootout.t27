// specs/tri/shootout.t27 -- spec(tri/shootout): baseline at a keyword use path.
// Part of M1 (milestone #5). Closes #13113.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::shootout;

pub const SHOOTOUT_KEYWORD_MAX : u32 = 64;

pub struct ShootoutBaseline { keyword: str, use_path: str, baseline_ns: u64 };

pub fn shootout_baseline_ns(b: ShootoutBaseline) -> u64 {
    return b.baseline_ns;
}

test "shootout baseline ns" {
    assert(shootout_baseline_ns(ShootoutBaseline { keyword: "use", use_path: "specs/foo.t27", baseline_ns: 1500 }) == 1500);
}

invariant shootout_keyword_max_positive {
    assert SHOOTOUT_KEYWORD_MAX > 0;
}