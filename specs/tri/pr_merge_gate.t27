// specs/tri/pr_merge_gate.t27 -- Safe PR merge gate: tri pr gate.
// Part of M1 (milestone #5). Closes #13189.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::pr_merge_gate;

pub const PR_MERGE_GATE_GREEN : bool = true;

pub struct PrMergeGate { green: bool, policy_compliant: bool };

pub fn pr_merge_gate_safe(g: PrMergeGate) -> bool {
    return g.green && g.policy_compliant;
}

test "pr merge gate safe" {
    assert(pr_merge_gate_safe(PrMergeGate { green: true, policy_compliant: true }));
    assert(!pr_merge_gate_safe(PrMergeGate { green: false, policy_compliant: true }));
}

invariant pr_merge_gate_green_default {
    assert PR_MERGE_GATE_GREEN;
}