// SPDX-License-Identifier: Apache-2.0
; specs/tri/mesh/mesh_graph.t27 -- the mesh: merge repositories' use-edges into ONE qualified graph, answer one
; shortest chain over it, refuse anything malformed (#11632, epic "tri git spec-only storage + Graph RAG mesh").
; Owner, 2026-10-22: tri git stores only .t27, and agents retrieve context through the graph of that web. This file
; is the first stage named in the epic: a pure spec, no database, no vector index, no network (epic FR-003).
; - THE MERGE: each stream is one repository's `t27c use-edges` text (importer TAB imported). Every endpoint is
;   qualified `repo::path`, so the same path in two repositories is two nodes; an identical qualified edge that is
;   already written is dropped (the mesh sync case: two snapshots of one repository).
; - THE QUERY: one shortest import chain through t27f::spec_deps::deps_why -- the traversal is NOT reimplemented
;   here (DRY: deps_why, deps_walk and every layer rule live in specs/t27f/spec_deps.t27 with 31 of 31 tests);
;   mx_why is the boundary the MCP twin will call, with the full qualified names already joined.
; - THE REFUSAL: validation runs BEFORE any byte is written, so a refused merge yields no partial graph. A bad line
;   is `importer TAB imported` violated: no tab, an empty side, or a second tab. A bad repository name is empty or
;   contains ':' or a tab (':' would blur the '::' qualifier).
; - DRY (recorded before writing, 2026-10-22): `t27c dupes --name` -- mx_merge, mx_line_ok, mx_why, mx_refusal,
;   mx_stream, mx_seen, line_ok: no function; repo_ok exists once (automation/kanban-card-chat.t27:349) and its
;   body is a GitHub name-length flag, not a byte scan, so mx_repo_ok is a different contract. Traversal comes from
;   spec_deps; byte writers are deps_put_span / deps_put_lit / deps_put_dec; same is ci::affected's, line_end is
;   policy::text_lines'. The edge source is the t27c resolver only -- the lab's Python copy "missed some in 86
;   specs" (contrib/railway/t27b-lab/lab.py comment), so no other parser may ever feed the mesh.
; - HONEST LIMITS. (1) The mesh is a UNION of per-repo graphs: cross-repo edges do not exist yet, and a test below
;   pins that two repositories do not reach each other -- the graph is honest about what it does not connect.
;   (2) No vector layer: retrieval by meaning arrives only when the exact graph is measured not to cover a query.
;   (3) The MCP twin and any `tri` entry are a separate lane (epic FR-004) with their own foreign-line payment;
;   this file adds no host code. (4) Visualization reuses t27f spec_graph_view / ui_plan; no renderer is added.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriMeshGraph;

use t27f::spec_deps::deps_why;
use t27f::spec_deps::deps_put_span;
use t27f::spec_deps::deps_put_lit;
use t27f::spec_deps::deps_put_dec;
use ci::affected::same;
use ci::affected::first_tab;
use ci::affected::put;
use policy::text_lines::line_end;

; --- 1. line and repository rules -------------------------------------------------------------------------

pub const MX_SEP : str = "::$";
pub const MX_NL : u8 = 10;
pub const MX_TAB : u8 = 9;
pub const MX_R_HEAD : str = "mesh: refused: $";
pub const MX_R_REPO_A : str = "repo of stream $";
pub const MX_R_REPO_B : str = " is empty or contains ':' or a tab$";
pub const MX_R_ST_A : str = "stream $";
pub const MX_R_ST_M : str = " line $";
pub const MX_R_ST_B : str = ": expected one tab with both sides$";

/// Is this edge line exactly `importer<TAB>imported` -- one tab, both sides non-empty?
/// The range excludes the newline; a missing tab, an empty side and a second tab all refuse.
pub fn mx_line_ok(s: []const u8, a: usize, b: usize) -> bool {
    const p : usize = first_tab(s, a, b);
    if (p <= a or p >= b) { return false; }
    if (p + 1 >= b) { return false; }
    return first_tab(s, p + 1, b) >= b;
}

/// Is this repository name safe to qualify with -- non-empty, no ':' (it would blur `::`), no tab, no newline?
pub fn mx_repo_ok(r: []const u8) -> bool {
    if (r.len == 0) { return false; }
    var i : usize = 0;
    while (i < r.len) {
        const c : u8 = r[i];
        if (c == 58 or c == 9 or c == 10) { return false; }
        i = i + 1;
    }
    return true;
}

; --- 2. the merge: validate everything, then write, dedup against what is already there -------------------

/// The qualified form of edge line e[a..b) with its single tab: `repo::importer<TAB>repo::imported`, then '\n'.
fn mx_emit(out: []u8, cap: usize, w0: usize, r: []const u8, e: []const u8, a: usize, b: usize) -> usize {
    const p : usize = first_tab(e, a, b);
    var w : usize = w0;
    w = deps_put_span(out, w, cap, r, 0, r.len);
    w = deps_put_lit(out, w, cap, MX_SEP);
    w = deps_put_span(out, w, cap, e, a, p);
    w = put(out, w, cap, MX_TAB);
    w = deps_put_span(out, w, cap, r, 0, r.len);
    w = deps_put_lit(out, w, cap, MX_SEP);
    w = deps_put_span(out, w, cap, e, p + 1, b);
    w = put(out, w, cap, MX_NL);
    return w;
}

/// Is the candidate line already among buf's lines? Ranges include the trailing newline on both sides.
fn mx_seen(buf: []const u8, upto: usize, cs: usize, ce: usize) -> bool {
    var i : usize = 0;
    while (i < upto) {
        const le : usize = line_end(buf, i, upto);
        if (le - i == (ce - 1) - cs and same(buf, i, le, buf, cs, ce - 1)) { return true; }
        i = le + 1;
    }
    return false;
}

/// Write one stream, qualifying every line with r and dropping an edge already written.
fn mx_stream(out: []u8, cap: usize, w0: usize, r: []const u8, e: []const u8) -> usize {
    var w : usize = w0;
    var i : usize = 0;
    while (i < e.len) {
        const le : usize = line_end(e, i, e.len);
        const s : usize = w;
        w = mx_emit(out, cap, s, r, e, i, le);
        if (mx_seen(out, s, s, w)) { w = s; }
        i = le + 1;
    }
    return w;
}

/// Merge stream 1 (repository r1) and stream 2 (repository r2) into out: every endpoint qualified, identical
/// qualified edges dropped, NOTHING written unless every line of both streams validates. Returns the byte count,
/// or cap + 1 when it does not fit. On refusal returns 0 and bad = {code, stream, line}: code 1 = repository of
/// that stream is invalid (line slot 0), code 2 = that 1-based line of that stream is not an edge line.
pub fn mx_merge(out: []u8, cap: usize, r1: []const u8, e1: []const u8, r2: []const u8, e2: []const u8, bad: []usize) -> usize {
    bad[0] = 0;
    bad[1] = 0;
    bad[2] = 0;
    if (mx_repo_ok(r1) == false) { bad[0] = 1; bad[1] = 1; return 0; }
    if (mx_repo_ok(r2) == false) { bad[0] = 1; bad[1] = 2; return 0; }
    var ln : usize = 1;
    var i : usize = 0;
    while (i < e1.len) {
        const le : usize = line_end(e1, i, e1.len);
        if (mx_line_ok(e1, i, le) == false) { bad[0] = 2; bad[1] = 1; bad[2] = ln; return 0; }
        ln = ln + 1;
        i = le + 1;
    }
    ln = 1;
    i = 0;
    while (i < e2.len) {
        const le : usize = line_end(e2, i, e2.len);
        if (mx_line_ok(e2, i, le) == false) { bad[0] = 2; bad[1] = 2; bad[2] = ln; return 0; }
        ln = ln + 1;
        i = le + 1;
    }
    var w : usize = 0;
    w = mx_stream(out, cap, w, r1, e1);
    w = mx_stream(out, cap, w, r2, e2);
    if (w > cap) { return cap + 1; }
    return w;
}

/// The words a refused merge prints: bad = {0, _, _} prints nothing.
pub fn mx_refusal(bad: []usize, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    if (bad[0] == 0) { return 0; }
    w = deps_put_lit(out, w, cap, MX_R_HEAD);
    if (bad[0] == 1) {
        w = deps_put_lit(out, w, cap, MX_R_REPO_A);
        w = deps_put_dec(out, w, cap, bad[1]);
        w = deps_put_lit(out, w, cap, MX_R_REPO_B);
        return w;
    }
    w = deps_put_lit(out, w, cap, MX_R_ST_A);
    w = deps_put_dec(out, w, cap, bad[1]);
    w = deps_put_lit(out, w, cap, MX_R_ST_M);
    w = deps_put_dec(out, w, cap, bad[2]);
    w = deps_put_lit(out, w, cap, MX_R_ST_B);
    return w;
}

; --- 3. the query: one chain over the merged graph, through spec_deps ------------------------------------

/// One shortest import chain from the full qualified name a to b over buf[0..n], into out[0..cap]: the boundary
/// the MCP twin calls. The walk, the layer rules and the refusal words are t27f::spec_deps::deps_why's own.
pub fn mx_why(buf: []const u8, n: usize, a: []const u8, b: []const u8, set: []u8, scap: usize, bounds: []usize, hs: []usize, he: []usize, out: []u8, cap: usize) -> usize {
    return deps_why(buf, n, a, 0, a.len, b, 0, b.len, set, scap, bounds, hs, he, out, cap);
}

; --- 4. tests --------------------------------------------------------------------------------------------

test a_line_is_ok_exactly_when_one_tab_separates_two_sides {
    assert mx_line_ok("specs/a.t27\tspecs/b.t27", 0, 23) == true;
    assert mx_line_ok("a\tb", 0, 3) == true;
    assert mx_line_ok("no-tab-here", 0, 11) == false;
    assert mx_line_ok("\tonly-right", 0, 11) == false;
    assert mx_line_ok("only-left\t", 0, 10) == false;
    assert mx_line_ok("a\tb\tc", 0, 5) == false;
    assert mx_line_ok("", 0, 0) == false;
    // the newline is outside the range: a good line stays good where line_end cut it
    assert mx_line_ok("a\tb\n", 0, 3) == true;
}

test a_repo_name_is_ok_exactly_when_it_never_blurs_the_separator {
    assert mx_repo_ok("t27") == true;
    assert mx_repo_ok("trinity") == true;
    assert mx_repo_ok("") == false;
    assert mx_repo_ok("a::b") == false;
    assert mx_repo_ok("a:b") == false;
    assert mx_repo_ok("a\tb") == false;
    assert mx_repo_ok("a\nb") == false;
}

test merge_qualifies_both_streams_and_keeps_one_edge_per_line {
    let mut out : [512]u8 = [0; 512];
    let mut bad : [3]usize = [0; 3];
    const e1 : []const u8 = "specs/a.t27\tspecs/b.t27\nspecs/b.t27\tspecs/c.t27\n";
    const e2 : []const u8 = "specs/a.t27\tspecs/b.t27\n";
    const w : usize = mx_merge(out[0..512], 512, "t27", e1, "t27", e2, bad[0..3]);
    assert bad[0] == 0;
    // the duplicate edge of stream 2 (same repo, same line) is dropped, the two of stream 1 kept
    const want : []const u8 = "t27::specs/a.t27\tt27::specs/b.t27\nt27::specs/b.t27\tt27::specs/c.t27\n";
    assert w == want.len;
    assert same(out[0..512], 0, w, want, 0, want.len) == true;
}

test two_repositories_keep_the_same_path_apart_and_never_dedup {
    let mut out : [512]u8 = [0; 512];
    let mut bad : [3]usize = [0; 3];
    const e : []const u8 = "specs/a.t27\tspecs/b.t27\n";
    const w : usize = mx_merge(out[0..512], 512, "t27", e, "trinity", e, bad[0..3]);
    assert bad[0] == 0;
    const want : []const u8 = "t27::specs/a.t27\tt27::specs/b.t27\ntrinity::specs/a.t27\ttrinity::specs/b.t27\n";
    assert w == want.len;
    assert same(out[0..512], 0, w, want, 0, want.len) == true;
}

test a_malformed_line_refuses_the_whole_merge_with_its_number_and_writes_nothing {
    let mut out : [512]u8 = [0; 512];
    let mut bad : [3]usize = [0; 3];
    const e1 : []const u8 = "specs/a.t27\tspecs/b.t27\n";
    const e2 : []const u8 = "specs/p.t27\tspecs/q.t27\nbroken line without tab\nspecs/q.t27\tspecs/r.t27\n";
    const w : usize = mx_merge(out[0..512], 512, "t27", e1, "trinity", e2, bad[0..3]);
    assert w == 0;
    assert bad[0] == 2;
    assert bad[1] == 2;
    assert bad[2] == 2;
    // nothing partial: the first line of stream 2 was valid, and it is NOT in out
    assert out[0] == 0;
    // and the same defect in stream 1 is reported against stream 1
    const w2 : usize = mx_merge(out[0..512], 512, "t27", e2, "trinity", e1, bad[0..3]);
    assert w2 == 0;
    assert bad[0] == 2;
    assert bad[1] == 1;
    assert bad[2] == 2;
}

test an_invalid_repository_refuses_before_any_line_is_read {
    let mut out : [512]u8 = [0; 512];
    let mut bad : [3]usize = [0; 3];
    const e : []const u8 = "a\tb\n";
    const w : usize = mx_merge(out[0..512], 512, "t27", e, "a::b", e, bad[0..3]);
    assert w == 0;
    assert bad[0] == 1;
    assert bad[1] == 2;
    assert bad[2] == 0;
    const w2 : usize = mx_merge(out[0..512], 512, "", e, "t27", e, bad[0..3]);
    assert w2 == 0;
    assert bad[0] == 1;
    assert bad[1] == 1;
}

test refusal_words_name_the_stream_and_the_line {
    let mut out : [256]u8 = [0; 256];
    let mut bad : [3]usize = [0; 3];
    bad[0] = 0;
    assert mx_refusal(bad[0..3], out[0..256], 256) == 0;
    bad[0] = 1;
    bad[1] = 2;
    bad[2] = 0;
    let n : usize = mx_refusal(bad[0..3], out[0..256], 256);
    const want : []const u8 = "mesh: refused: repo of stream 2 is empty or contains ':' or a tab";
    assert n == want.len;
    assert same(out[0..256], 0, n, want, 0, want.len) == true;
    bad[0] = 2;
    bad[1] = 2;
    bad[2] = 5;
    let m : usize = mx_refusal(bad[0..3], out[0..256], 256);
    const want2 : []const u8 = "mesh: refused: stream 2 line 5: expected one tab with both sides";
    assert m == want2.len;
    assert same(out[0..256], 0, m, want2, 0, want2.len) == true;
}

test why_walks_a_qualified_chain_inside_one_repository_of_the_mesh {
    let mut out : [512]u8 = [0; 512];
    let mut bad : [3]usize = [0; 3];
    const e1 : []const u8 = "specs/x.t27\tspecs/y.t27\nspecs/y.t27\tspecs/z.t27\n";
    const e2 : []const u8 = "specs/p.t27\tspecs/q.t27\n";
    const n : usize = mx_merge(out[0..512], 512, "t27", e1, "trinity", e2, bad[0..3]);
    assert n > 0;
    assert bad[0] == 0;
    let mut set : [512]u8 = [0; 512];
    let mut bounds : [35]usize = [0; 35];
    let mut hs : [35]usize = [0; 35];
    let mut he : [35]usize = [0; 35];
    let mut line : [512]u8 = [0; 512];
    const w : usize = mx_why(out[0..512], n, "t27::specs/x.t27", "t27::specs/z.t27", set[0..512], 512, bounds[0..35], hs[0..35], he[0..35], line[0..512], 512);
    const want : []const u8 = "why\tt27::specs/x.t27\tt27::specs/z.t27\thops=2\nedge\tt27::specs/x.t27\tt27::specs/y.t27\texact\nedge\tt27::specs/y.t27\tt27::specs/z.t27\texact\n";
    assert w == want.len;
    assert same(line[0..512], 0, w, want, 0, want.len) == true;
}

test negative_control_two_repositories_of_the_mesh_do_not_reach_each_other {
    // the mesh is a union: cross-repo edges do not exist yet (#11632 limit 1), and the graph says so
    let mut out : [512]u8 = [0; 512];
    let mut bad : [3]usize = [0; 3];
    const e1 : []const u8 = "specs/x.t27\tspecs/y.t27\n";
    const e2 : []const u8 = "specs/p.t27\tspecs/q.t27\n";
    const n : usize = mx_merge(out[0..512], 512, "t27", e1, "trinity", e2, bad[0..3]);
    assert n > 0;
    let mut set : [512]u8 = [0; 512];
    let mut bounds : [35]usize = [0; 35];
    let mut hs : [35]usize = [0; 35];
    let mut he : [35]usize = [0; 35];
    let mut line : [512]u8 = [0; 512];
    const w : usize = mx_why(out[0..512], n, "t27::specs/x.t27", "trinity::specs/q.t27", set[0..512], 512, bounds[0..35], hs[0..35], he[0..35], line[0..512], 512);
    const want : []const u8 = "why\tt27::specs/x.t27\ttrinity::specs/q.t27\tnone\n";
    assert w == want.len;
    assert same(line[0..512], 0, w, want, 0, want.len) == true;
}
