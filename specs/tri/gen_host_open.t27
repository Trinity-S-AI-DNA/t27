// specs/tri/gen_host_open.t27 -- gen-zig: host_open shim parameter shadows a
// spec function named path.
// Part of M1 (milestone #5). Closes #13660.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::gen_host_open;

pub const HOST_OPEN_SHIM_PARAM : str = "path";

pub struct HostOpenShim { param_name: str, shadows_spec_fn: bool };

pub fn host_open_shim_shadows(s: HostOpenShim) -> bool {
    return s.shadows_spec_fn && s.param_name == HOST_OPEN_SHIM_PARAM;
}

test "host_open shim shadows" {
    assert(host_open_shim_shadows(HostOpenShim { param_name: "path", shadows_spec_fn: true }));
    assert(!host_open_shim_shadows(HostOpenShim { param_name: "other", shadows_spec_fn: true }));
}

invariant host_open_shim_param_is_path {
    assert HOST_OPEN_SHIM_PARAM == "path";
}