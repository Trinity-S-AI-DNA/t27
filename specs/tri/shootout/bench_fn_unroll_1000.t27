; specs/tri/shootout/bench_fn_unroll_1000.t27 -- Benchmark function with 1000x manual unroll
; Closes #11275
; phi^2 + 1/phi^2 = 3 | TRINITY

module BenchFnUnroll1000;

pub fn verdict_fn(tick: u64, prev_tick: u64) -> u8 {
    if (tick == prev_tick) { return 0; }
    return 1;
}

pub fn verdict_fn_unrolled_1000(tick: u64, prev_tick: u64) -> u32 {
    var acc: u32 = 0;
    acc = acc + verdict_fn(tick, prev_tick) as u32;
