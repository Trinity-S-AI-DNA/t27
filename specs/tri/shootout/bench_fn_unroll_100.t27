; specs/tri/shootout/bench_fn_unroll_100.t27 -- Benchmark function with 100x manual unroll
; Calls verdict_fn 100 times to simulate compile-time unrolling effect
; Closes #11275
; phi^2 + 1/phi^2 = 3 | TRINITY

module BenchFnUnroll100;

pub fn verdict_fn(tick: u64, prev_tick: u64) -> u8 {
    if (tick == prev_tick) { return 0; }
    return 1;
}

pub fn verdict_fn_unrolled_100(tick: u64, prev_tick: u64) -> u8 {
    var acc: u8 = 0;
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    acc = acc + verdict_fn(tick, prev_tick);
    return acc % 2;
}

test verdict_fn_unrolled_100_returns_valid {
    var r = verdict_fn_unrolled_100(5, 4);
    assert(r == 0 or r == 1);
    var r2 = verdict_fn_unrolled_100(5, 5);
    assert(r2 == 0 or r2 == 1);
}
