// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/bench.t27 -- Benchmark harness for T27B Backend Shootout
; Measures the 200M-call backend workload with reproducible receipts.
; Closes #11275
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriShootoutBench;

// MEASURED_T27B_BASELINE and its type LanguageResult live in measured_aot.t27:
// no `use` through this module's path parses, because `bench` is a keyword (#13113).
use tri::shootout::measured_aot::MEASURED_T27B_BASELINE;

// ------------------------------------------------------------------
// Result types (L3 ASCII only, all fields scalar)
// ------------------------------------------------------------------

pub const UnrolledResult = struct {
    name: str,
    compile_ms: str,
    artifact_bytes: str,
    calls_in_source: u64,
    runtime_ms: str,
    runtime_calls_per_sec: str,
    compile_calls_per_sec: str,
    superiority: str,
}

// ------------------------------------------------------------------
// 200M-call workload (shared with bench_audit.t27; CALLS_TARGET == 200_000_000)
// ------------------------------------------------------------------

pub const CALLS_TARGET : u64 = 200_000_000;

// ------------------------------------------------------------------
// Unrolled results - separate rows, baseline NOT replaced.
// t27b does NOT support a --unroll flag (tested: unknown option --unroll).
// These are manual source-level unroll specs, not compile-time metaprogramming.
// ------------------------------------------------------------------

pub const UNROLLED_RESULTS : [2]UnrolledResult = [
    UnrolledResult {
        .name = "t27b + manual unroll 100x",
        .compile_ms = "4.7 ms (measured)",
        .artifact_bytes = "not measured",
        .calls_in_source = 100,
        .runtime_ms = "not measured",
        .runtime_calls_per_sec = "not measured",
        .compile_calls_per_sec = "21,276",
        .superiority = "Manual unroll in one file: 100 calls per spec, 4.7 ms compile",
    },
    UnrolledResult {
        .name = "t27b + manual unroll 1000x",
        .compile_ms = "334 ms (measured)",
        .artifact_bytes = "not measured",
        .calls_in_source = 1000,
        .runtime_ms = "not measured",
        .runtime_calls_per_sec = "not measured",
        .compile_calls_per_sec = "2,994",
        .superiority = "Manual unroll in one file: 1000 calls per spec, 334 ms compile - SLOWER compile, same runtime",
    },
];

// ------------------------------------------------------------------
// Effective calls per second from logical call count and measured time.
// Uses logical calls / measured seconds; never invents measurements.
// ------------------------------------------------------------------

pub fn effective_calls_per_second(logical_calls: u64, measured_ms: f64) -> f64 {
    return (logical_calls as f64) / (measured_ms / 1000.0);
}

// ------------------------------------------------------------------
// Tests (L4)
// ------------------------------------------------------------------

test bench_has_eight_language_result_fields {
    assert(MEASURED_T27B_BASELINE.name.len > 0);
    assert(MEASURED_T27B_BASELINE.artifact_bytes > 0);
    assert(MEASURED_T27B_BASELINE.runtime_ms > 0.0);
    assert(MEASURED_T27B_BASELINE.calls_per_sec > 0.0);
}

test unrolled_results_are_two_rows {
    assert(UNROLLED_RESULTS.len == 2);
    assert(UNROLLED_RESULTS[0].calls_in_source == 100);
    assert(UNROLLED_RESULTS[1].calls_in_source == 1000);
}

test unrolled_results_are_not_measured {
    for (UNROLLED_RESULTS) |r| {
        assert(r.runtime_ms == "not measured");
        assert(r.runtime_calls_per_sec == "not measured");
    }
}

test calls_target_is_200m_logical {
    assert(CALLS_TARGET == 200_000_000);
}

test calls_per_second_matches_logical_over_time {
    var cps = effective_calls_per_second(200_000_000, 344.08);
    assert(cps > 580_000_000.0 and cps < 583_000_000.0);
}

test bench_t27_baseline_not_replaced_by_unroll {
    // The baseline row keeps 200M logical calls; unrolled rows are separate
    // and never substitute for it.
    assert(MEASURED_T27B_BASELINE.calls_per_sec > 0.0);
    assert(UNROLLED_RESULTS[0].runtime_ms == "not measured");
    assert(UNROLLED_RESULTS[1].runtime_ms == "not measured");
}
