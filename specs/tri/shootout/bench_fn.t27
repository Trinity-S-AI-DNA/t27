; specs/tri/shootout/bench_fn.t27 -- Benchmark function for t27b unroll measurements
; Pure function with no side effects, suitable for compile-time unrolling
; Closes #11275
; phi^2 + 1/phi^2 = 3 | TRINITY

module BenchFn;

pub fn verdict_fn(tick: u64, prev_tick: u64) -> u8 {
    if (tick == prev_tick) { return 0; }
    return 1;
}

pub fn verdict_fn_accumulate(tick: u64, prev_tick: u64, acc: u64) -> u64 {
    if (tick == prev_tick) { return acc; }
    return acc + 1;
}

test verdict_fn_returns_zero_when_equal {
    assert(verdict_fn(5, 5) == 0);
    assert(verdict_fn(0, 0) == 0);
}

test verdict_fn_returns_one_when_different {
    assert(verdict_fn(5, 4) == 1);
    assert(verdict_fn(100, 99) == 1);
}

test verdict_fn_accumulate_increments {
    assert(verdict_fn_accumulate(5, 4, 0) == 1);
    assert(verdict_fn_accumulate(5, 4, 100) == 101);
    assert(verdict_fn_accumulate(5, 5, 100) == 100);
}
