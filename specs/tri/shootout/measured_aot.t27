// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/measured_aot.t27 -- the measured t27b AOT baseline row
; of the 200M-call shootout, and its one home.
; It lives here, not in bench.t27, because `bench` is a keyword: the line
; `use tri::shootout::bench::X;` drops `: : X ;` at parse (#11101), and no
; spelling of that path parses (#13113). bench.t27, codegen_audit.t27 and
; acceptance_matrix.t27 read the row through a `use` of this module.
; Refs #13113
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriShootoutMeasuredAot;

// ------------------------------------------------------------------
// Result type (L3 ASCII only, all fields scalar)
// ------------------------------------------------------------------

pub const LanguageResult = struct {
    name: str,
    compile_ms: f64,
    artifact_bytes: u64,
    runtime_ms: f64,
    calls_per_sec: f64,
    superiority: str,
}

// ------------------------------------------------------------------
// Measured baseline (t27b AOT, arm64 macOS, warm cache, median of 5 runs)
// Command: t27b build specs/tri/shootout/bench_audit.t27 -o /tmp/ba.o
//          then C runner calls verdict_benchmark_200m(5, 4) under clock_gettime.
// Machine: Apple M-series arm64, macOS. Tool: t27b 0.16.0 tree build.
// Cache: warm. Seed: 0 (deterministic loop).
// Receipts: .trinity/receipts/bench_200m_aot_run1..5.json (recorded at commit time).
// NOTE: this AOT figure (via t27b build object + C runner) differs from the older
// JIT figure (t27b test --time run phase ~690 ms). Both are recorded; AOT is
// the current baseline because it measures the shipped object.
// ------------------------------------------------------------------

pub const MEASURED_T27B_BASELINE : LanguageResult = LanguageResult {
    .name = "t27b build",
    .compile_ms = 0.00,
    .artifact_bytes = 600,
    .runtime_ms = 344.08,
    .calls_per_sec = 581253415.0,
    .superiority = "Baseline row (200M logical calls). NOT replaced by unrolled rows.",
}

// ------------------------------------------------------------------
// Tests (L4)
// ------------------------------------------------------------------

test measured_aot_row_gives_back_its_logical_calls {
    // calls per second times seconds is the 200M logical calls the row was
    // measured on: 581253415.0 * 0.34408 = 199997675.03, inside 0.01 percent.
    var calls = MEASURED_T27B_BASELINE.calls_per_sec * (MEASURED_T27B_BASELINE.runtime_ms / 1000.0);
    assert(calls > 199_980_000.0 and calls < 200_020_000.0);
}
