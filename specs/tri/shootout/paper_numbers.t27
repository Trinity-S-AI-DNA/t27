; axis_C.icount of gcc_O0 and clang_O2 for the 20 tier-1 specs, in axis_C.tier1 order
; (d_g22_test first, t27core last).
pub const C_ICOUNT_GCC_O0 : [20]u64 = [11534343300, 3998467485, 2689028516, 1953297379, 1161807174, 933084433, 704643885, 447913255, 420000168, 318768493, 57010505, 39987947, 31761744, 13054106, 8549402, 6631158, 5767001, 5514566, 5172631, 4227585];
