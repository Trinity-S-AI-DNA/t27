// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/paper_numbers.t27 -- every derived number the t27b paper prints, recomputed
; The draft paper (docs/arxiv-submission/t27b-backend-shootout/main.tex, PR #13226) prints
; ratios, shares and rates. Each one is derived from a raw value in
; docs/reports/t27b-bench-2026-10.md and its JSON, taken at commit 9a0f4c394 (REPORT_COMMIT of
; acceptance_matrix.t27). This spec holds the raw values once and recomputes every printed
; number from them, so a typo in the paper or a stale matrix cell fails a test instead of
; reaching a reviewer.
; It is not a second measurement and not a second matrix. The matrix holds cells and their
; status; this spec holds the arithmetic between the report and the printed text, and checks
; seven matrix cells against that arithmetic.
; Refs #13229
; phi^2 + 1/phi^2 = 3 | TRINITY
//
; Units. Compile latency is in microseconds, batch and corpus times in milliseconds, memory in
; thousandths of a MiB (5.26 MiB is 5260), sizes in kB, coverage in files. A printed ratio is
; stored times 100 (8.84x is 884); a JSON geomean times 10000; a matrix cell times 1000.
; Tier-2 instruction counts are in tens of instructions (1.73 million is 173000). Source sizes
; are lines of Rust (wc -l), and a JSON share is stored times 10000 (0.3586 is 3586).
//
; Tolerance. The report printed its ratios from unrounded geomeans and its raw values to three
; significant figures, so a ratio recomputed from the printed raw values can miss the printed
; ratio by about 1% (report section B, unprinted rows: 108 / 4.75 = 22.7 against 22.6).
; PAPER_PCT is that 1%. The matrix took its cells from the two-figure values in its own cell
; names (5.3 MiB over 27 MiB), so MATRIX_PCT is 3%. Coverage shares and roundings of a printed
; value are exact and use no tolerance.
//
; JSON trap. The JSON's ratio entries against zig_* and t27b_wrap average over n = 24 specs
; (tier 1 plus four tier-2 specs); the report's table and the paper use the tier-1 subset,
; n = 20 (3.17 against 3.62 for zig ReleaseSafe instructions). The gcc entries are n = 20 and
; are the only section C values below taken from the JSON; the others are the report's table.

module TriShootoutPaperNumbers;

use tri::shootout::acceptance_matrix::CELLS;

pub const PAPER_PCT : u64 = 1;
pub const MATRIX_PCT : u64 = 3;

// ------------------------------------------------------------------
// Arithmetic
// ------------------------------------------------------------------

/// num / den times scale, rounded half up.
pub fn ratio_scaled(num : u64, den : u64, scale : u64) -> u64 {
    return (num * scale + den / 2) / den;
}

/// v / step, rounded half up: drops decimal places from a scaled value.
pub fn round_div(v : u64, step : u64) -> u64 {
    return (v + step / 2) / step;
}

/// Whether a recomputed value is within pct percent of the printed one.
pub fn within_pct(recomputed : u64, printed : u64, pct : u64) -> bool {
    var diff : u64 = 0;
    if (recomputed > printed) {
        diff = recomputed - printed;
    } else {
        diff = printed - recomputed;
    }
    return diff * 100 <= printed * pct;
}

/// Whether num / den, scaled, agrees with a printed value at the paper's tolerance.
pub fn agrees(num : u64, den : u64, scale : u64, printed : u64) -> bool {
    return within_pct(ratio_scaled(num, den, scale), printed, PAPER_PCT);
}

/// Whether a matrix cell's milli value agrees with num / den at the matrix tolerance.
pub fn matrix_agrees(num : u64, den : u64, cell_milli : u64) -> bool {
    return within_pct(ratio_scaled(num, den, 1000), cell_milli, MATRIX_PCT);
}

/// Whether a value lies in [lo, hi].
pub fn in_band(v : u64, lo : u64, hi : u64) -> bool {
    return v >= lo and v <= hi;
}

/// x to the fourth power.
pub fn pow4(x : u64) -> u64 {
    return x * x * x * x;
}

/// Whether the geometric mean of four ratios, each stored times 1000, rounds to printed at
/// step (step 10: printed is the mean times 10, 10.1x is 101). The fourth power keeps the root
/// out of integer arithmetic: the mean rounds to printed / step exactly when
/// ((2 printed - 1) k)^4 <= r1 r2 r3 r4 < ((2 printed + 1) k)^4, with k = 500 / step.
pub fn geomean4_rounds_to(r1 : u64, r2 : u64, r3 : u64, r4 : u64, printed : u64, step : u64) -> bool {
    var k : u64 = 500 / step;
    var prod : u64 = r1 * r2 * r3 * r4;
    return prod >= pow4((2 * printed - 1) * k) and prod < pow4((2 * printed + 1) * k);
}

