// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/paper_numbers.t27 -- every derived number the t27b paper prints, recomputed
; The draft paper (docs/arxiv-submission/t27b-backend-shootout/main.tex, PR #13226) prints
; ratios, shares and rates. Each one is derived from a raw value in
; docs/reports/t27b-bench-2026-10.md and its JSON, taken at commit 9a0f4c394 (REPORT_COMMIT of
; acceptance_matrix.t27). This spec holds the raw values once and recomputes every printed
; number from them, so a typo in the paper or a stale matrix cell fails a test instead of
; reaching a reviewer.
; It is not a second measurement and not a second matrix. The matrix holds cells and their
; status; this spec holds the arithmetic between the report and the printed text, and checks
; seven matrix cells against that arithmetic.
; Refs #13229
; phi^2 + 1/phi^2 = 3 | TRINITY
//
; Units. Compile latency is in microseconds, batch and corpus times in milliseconds, memory in
; thousandths of a MiB (5.26 MiB is 5260), sizes in kB, coverage in files. A printed ratio is
; stored times 100 (8.84x is 884); a JSON geomean times 10000; a matrix cell times 1000.
//
; Tolerance. The report printed its ratios from unrounded geomeans and its raw values to three
; significant figures, so a ratio recomputed from the printed raw values can miss the printed
; ratio by about 1% (report section B, unprinted rows: 108 / 4.75 = 22.7 against 22.6).
; PAPER_PCT is that 1%. The matrix took its cells from the two-figure values in its own cell
; names (5.3 MiB over 27 MiB), so MATRIX_PCT is 3%. Coverage shares and roundings of a printed
; value are exact and use no tolerance.
//
; JSON trap. The JSON's ratio entries against zig_* and t27b_wrap average over n = 24 specs
; (tier 1 plus four tier-2 specs); the report's table and the paper use the tier-1 subset,
; n = 20 (3.17 against 3.62 for zig ReleaseSafe instructions). The gcc entries are n = 20 and
; are the only section C values below taken from the JSON; the others are the report's table.

module TriShootoutPaperNumbers;

use tri::shootout::acceptance_matrix::CELLS;

pub const PAPER_PCT : u64 = 1;
pub const MATRIX_PCT : u64 = 3;

// ------------------------------------------------------------------
// Arithmetic
// ------------------------------------------------------------------

/// num / den times scale, rounded half up.
pub fn ratio_scaled(num : u64, den : u64, scale : u64) -> u64 {
    return (num * scale + den / 2) / den;
}

/// v / step, rounded half up: drops decimal places from a scaled value.
pub fn round_div(v : u64, step : u64) -> u64 {
    return (v + step / 2) / step;
}

/// Whether a recomputed value is within pct percent of the printed one.
pub fn within_pct(recomputed : u64, printed : u64, pct : u64) -> bool {
    var diff : u64 = 0;
    if (recomputed > printed) {
        diff = recomputed - printed;
    } else {
        diff = printed - recomputed;
    }
    return diff * 100 <= printed * pct;
}

/// Whether num / den, scaled, agrees with a printed value at the paper's tolerance.
pub fn agrees(num : u64, den : u64, scale : u64, printed : u64) -> bool {
    return within_pct(ratio_scaled(num, den, scale), printed, PAPER_PCT);
}

/// Whether a matrix cell's milli value agrees with num / den at the matrix tolerance.
pub fn matrix_agrees(num : u64, den : u64, cell_milli : u64) -> bool {
    return within_pct(ratio_scaled(num, den, 1000), cell_milli, MATRIX_PCT);
}

/// Whether a value lies in [lo, hi].
pub fn in_band(v : u64, lo : u64, hi : u64) -> bool {
    return v >= lo and v <= hi;
}

// ------------------------------------------------------------------
// Section A: coverage, files passed out of the 1,311 the reference passes
// ------------------------------------------------------------------

pub const A_REF_PASS : u64 = 1311;
pub const A_T27B_PASS : u64 = 1296;
pub const A_ZIG_RF_PASS : u64 = 1306;
pub const A_GCC_O0_PASS : u64 = 581;
pub const A_GCC_O2_PASS : u64 = 578;
pub const A_CLANG_O0_PASS : u64 = 571;
pub const A_CLANG_O2_PASS : u64 = 622;

// Printed in the paper's coverage table and abstract, per mille (98.9% is 989)
pub const P_A_T27B : u64 = 989;
pub const P_A_ZIG_RF : u64 = 996;
pub const P_A_GCC_O0 : u64 = 443;
pub const P_A_GCC_O2 : u64 = 441;
pub const P_A_CLANG_O0 : u64 = 436;
pub const P_A_CLANG_O2 : u64 = 474;

// ------------------------------------------------------------------
// Section B: test-compile latency, geomean of warm medians over 18 specs, microseconds
// ------------------------------------------------------------------

pub const B_T27B_TEST_US : u64 = 4750;
pub const B_T27B_BUILD_US : u64 = 5110;
pub const B_GCC_O0_US : u64 = 42000;
pub const B_GCC_O2_US : u64 = 100000;
pub const B_CLANG_O0_US : u64 = 71100;
pub const B_CLANG_O2_US : u64 = 105000;
pub const B_ZIG_DEBUG_US : u64 = 3050000;
pub const B_ZIG_RF_US : u64 = 13808000;

// Printed in the paper's compile table, ratio x 100
pub const P_B_BUILD : u64 = 108;
pub const P_B_GCC_O0 : u64 = 884;
pub const P_B_GCC_O2 : u64 = 2100;
pub const P_B_CLANG_O0 : u64 = 1500;
pub const P_B_CLANG_O2 : u64 = 2210;
pub const P_B_ZIG_DEBUG : u64 = 64200;
pub const P_B_ZIG_RF : u64 = 290600;

// Batched: all 20 tier-1 specs in one zig test, against 20 t27b processes, milliseconds
pub const BATCH_ZIG_DEBUG_MS : u64 = 6210;
pub const BATCH_ZIG_RF_MS : u64 = 32900;
pub const BATCH_T27B_MS : u64 = 719;
pub const P_BATCH_DEBUG : u64 = 860;   // 8.6x
pub const P_BATCH_RF : u64 = 4600;     // 46x

// Throughput over the 567 files every pipeline passes, milliseconds in all
pub const CORPUS_FILES : u64 = 567;
pub const CORPUS_T27B_MS : u64 = 3100;
pub const CORPUS_GCC_O0_MS : u64 = 19900;
pub const P_CORPUS_T27B_FPS : u64 = 183;
pub const P_CORPUS_GCC_O0_FPS : u64 = 28;
pub const P_CORPUS_RATIO : u64 = 640;  // 6.4x

// ------------------------------------------------------------------
// Section C: t27b (trap) over each pipeline, tier 1
// ------------------------------------------------------------------

// From the JSON (n = 20), geomean x 10000
pub const C_JSON_INSN_GCC_O0 : u64 = 9082;
pub const C_JSON_INSN_GCC_O2 : u64 = 34260;
pub const C_JSON_TIME_GCC_O2 : u64 = 40530;
pub const C_JSON_SIZE_GCC_O2 : u64 = 18230;

// From the report's table (n = 20, Clang -O2 n = 9), ratio x 100
pub const C_RSAFE_INSN : u64 = 317;
pub const C_RSAFE_TIME : u64 = 341;
pub const C_RFAST_INSN : u64 = 447;
pub const C_RFAST_TIME : u64 = 414;
pub const C_RFAST_SIZE : u64 = 203;
pub const C_GCC_O2_INSN : u64 = 343;
pub const C_GCC_O2_TIME : u64 = 405;
pub const C_CLANG_O2_INSN : u64 = 350;
pub const C_CLANG_O2_TIME : u64 = 372;

// ------------------------------------------------------------------
// Section D: memory and size
// ------------------------------------------------------------------

pub const D_T27B_RSS : u64 = 5260;       // 5.26 MiB, median of t27b test-compile
pub const D_GCC_O0_RSS : u64 = 27100;    // 27.1 MiB, gcc -O0 to an object, the lowest rival
pub const D_T27B_EXE_KB : u64 = 3080;    // 3.08 MB x86_64 executable
pub const D_GCC_INSTALL_KB : u64 = 145000; // about 145 MB, gcc for aarch64 as installed

// ------------------------------------------------------------------
// Tests: section A
// ------------------------------------------------------------------

test coverage_shares_are_exact {
    assert(ratio_scaled(A_T27B_PASS, A_REF_PASS, 1000) == P_A_T27B);
    assert(ratio_scaled(A_ZIG_RF_PASS, A_REF_PASS, 1000) == P_A_ZIG_RF);
    assert(ratio_scaled(A_GCC_O0_PASS, A_REF_PASS, 1000) == P_A_GCC_O0);
    assert(ratio_scaled(A_GCC_O2_PASS, A_REF_PASS, 1000) == P_A_GCC_O2);
    assert(ratio_scaled(A_CLANG_O0_PASS, A_REF_PASS, 1000) == P_A_CLANG_O0);
    assert(ratio_scaled(A_CLANG_O2_PASS, A_REF_PASS, 1000) == P_A_CLANG_O2);
}

test files_behind_is_the_matrix_coverage_cell {
    assert(A_REF_PASS - A_T27B_PASS == 15);
    assert(CELLS[2].count == A_REF_PASS - A_T27B_PASS);
}

// ------------------------------------------------------------------
// Tests: section B
// ------------------------------------------------------------------

test compile_table_ratios_agree {
    assert(agrees(B_T27B_BUILD_US, B_T27B_TEST_US, 100, P_B_BUILD));
    assert(agrees(B_GCC_O0_US, B_T27B_TEST_US, 100, P_B_GCC_O0));
    assert(agrees(B_GCC_O2_US, B_T27B_TEST_US, 100, P_B_GCC_O2));
    assert(agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, P_B_CLANG_O0));
    assert(agrees(B_CLANG_O2_US, B_T27B_TEST_US, 100, P_B_CLANG_O2));
    assert(agrees(B_ZIG_DEBUG_US, B_T27B_TEST_US, 100, P_B_ZIG_DEBUG));
    assert(agrees(B_ZIG_RF_US, B_T27B_TEST_US, 100, P_B_ZIG_RF));
}

test abstract_compile_figures_round_from_the_table {
    assert(round_div(B_T27B_TEST_US, 100) == 48);     // 4.8 ms
    assert(round_div(P_B_GCC_O0, 10) == 88);          // 8.8x
    assert(agrees(B_ZIG_DEBUG_US, B_T27B_TEST_US, 100, 64000)); // about 640x
    assert(agrees(B_ZIG_RF_US, B_T27B_TEST_US, 100, 290000));   // about 2,900x
}

test blog_erratum_figures_agree {
    assert(agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, 1500)); // 15x below Clang -O0
    assert(agrees(B_CLANG_O2_US, B_T27B_TEST_US, 100, 2200)); // 22x below Clang -O2
}

test batched_gap_agrees {
    assert(round_div(BATCH_T27B_MS, 10) == 72);       // 0.72 s
    assert(agrees(BATCH_ZIG_DEBUG_MS, BATCH_T27B_MS, 100, P_BATCH_DEBUG));
    assert(agrees(BATCH_ZIG_RF_MS, BATCH_T27B_MS, 100, P_BATCH_RF));
}

test corpus_throughput_agrees {
    assert(ratio_scaled(CORPUS_FILES, CORPUS_T27B_MS, 1000) == P_CORPUS_T27B_FPS);
    assert(ratio_scaled(CORPUS_FILES, CORPUS_GCC_O0_MS, 1000) == P_CORPUS_GCC_O0_FPS);
    assert(agrees(CORPUS_GCC_O0_MS, CORPUS_T27B_MS, 100, P_CORPUS_RATIO));
}

// ------------------------------------------------------------------
// Tests: section C
// ------------------------------------------------------------------

test gcc_rows_round_from_the_json {
    assert(round_div(C_JSON_INSN_GCC_O0, 100) == 91);   // 0.91x, abstract and table
    assert(round_div(C_JSON_INSN_GCC_O2, 100) == C_GCC_O2_INSN);
    assert(round_div(C_JSON_TIME_GCC_O2, 100) == C_GCC_O2_TIME);
    assert(round_div(C_JSON_SIZE_GCC_O2, 100) == 182);
    assert(round_div(C_JSON_INSN_GCC_O2, 1000) == 34);  // 3.4x
    assert(round_div(C_JSON_TIME_GCC_O2, 1000) == 41);  // 4.1x: 4.053, not 4.05
    assert(round_div(C_JSON_SIZE_GCC_O2, 1000) == 18);  // 1.8x
}

test section_c_text_rounds_from_the_table {
    assert(round_div(C_RSAFE_INSN, 10) == 32);   // 3.2x
    assert(round_div(C_RSAFE_TIME, 10) == 34);   // 3.4x
    assert(round_div(C_CLANG_O2_INSN, 10) == 35); // 3.5x
    assert(round_div(C_CLANG_O2_TIME, 10) == 37); // 3.7x, abstract
}

test every_optimising_pipeline_is_3_to_5_times_better {
    assert(in_band(C_RSAFE_INSN, 300, 500) and in_band(C_RSAFE_TIME, 300, 500));
    assert(in_band(C_RFAST_INSN, 300, 500) and in_band(C_RFAST_TIME, 300, 500));
    assert(in_band(C_GCC_O2_INSN, 300, 500) and in_band(C_GCC_O2_TIME, 300, 500));
    assert(in_band(C_CLANG_O2_INSN, 300, 500) and in_band(C_CLANG_O2_TIME, 300, 500));
}

// ------------------------------------------------------------------
// Tests: section D
// ------------------------------------------------------------------

test abstract_memory_rounds_from_the_median {
    assert(round_div(D_T27B_RSS, 100) == 53);   // 5.3 MiB
}

// ------------------------------------------------------------------
// Tests: the matrix cells against the same arithmetic
// ------------------------------------------------------------------

test matrix_ratio_cells_agree {
    assert(matrix_agrees(B_T27B_TEST_US, B_GCC_O0_US, CELLS[3].t27b_milli));
    assert(matrix_agrees(CORPUS_T27B_MS, CORPUS_GCC_O0_MS, CELLS[4].t27b_milli));
    assert(matrix_agrees(D_T27B_RSS, D_GCC_O0_RSS, CELLS[5].t27b_milli));
    assert(matrix_agrees(D_T27B_EXE_KB, D_GCC_INSTALL_KB, CELLS[6].t27b_milli));
    assert(within_pct(C_RFAST_INSN * 10, CELLS[7].t27b_milli, MATRIX_PCT));
    assert(within_pct(C_RFAST_TIME * 10, CELLS[8].t27b_milli, MATRIX_PCT));
    assert(within_pct(C_RFAST_SIZE * 10, CELLS[10].t27b_milli, MATRIX_PCT));
}

; The RSS cell was taken from the rounded display values, not the medians. Both are recorded so
; that a re-taken cell shows which one it used.
test matrix_rss_cell_came_from_display_values {
    assert(ratio_scaled(5300, 27000, 1000) == CELLS[5].t27b_milli);
    assert(ratio_scaled(D_T27B_RSS, D_GCC_O0_RSS, 1000) != CELLS[5].t27b_milli);
}

// ------------------------------------------------------------------
// Negative controls: what the tolerance must refuse
// ------------------------------------------------------------------

test withdrawn_blog_figures_do_not_agree {
    assert(!agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, 7000));   // "70-100x faster than clang"
    assert(!agrees(B_CLANG_O2_US, B_T27B_TEST_US, 100, 7000));
    assert(!agrees(B_ZIG_RF_US, B_T27B_TEST_US, 100, 1000000));  // "10,000x slower compile"
}

test the_640x_is_not_the_batched_gap {
    assert(!agrees(BATCH_ZIG_DEBUG_MS, BATCH_T27B_MS, 100, P_B_ZIG_DEBUG));
    assert(!agrees(B_ZIG_DEBUG_US, B_T27B_TEST_US, 100, P_BATCH_DEBUG));
}

test a_one_digit_typo_is_refused {
    assert(!agrees(B_GCC_O0_US, B_T27B_TEST_US, 100, 984));      // 9.84 for 8.84
    assert(!agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, 1600));   // 16.0 for 15.0
    assert(ratio_scaled(A_T27B_PASS, A_REF_PASS, 1000) != 998);  // 99.8% for 98.9%
    assert(round_div(C_JSON_TIME_GCC_O2, 1000) != 40);
}

test the_json_zig_entries_are_not_tier_1 {
    // JSON icount/t27b_trap/zig_ReleaseSafe geomean 3.62 (n = 24) against the table's 3.17
    assert(!within_pct(362, C_RSAFE_INSN, PAPER_PCT));
}
