// ------------------------------------------------------------------
// Tests: section A
// ------------------------------------------------------------------

test coverage_shares_are_exact {
    assert(ratio_scaled(A_T27B_PASS, A_REF_PASS, 1000) == P_A_T27B);
    assert(ratio_scaled(A_ZIG_RF_PASS, A_REF_PASS, 1000) == P_A_ZIG_RF);
    assert(ratio_scaled(A_GCC_O0_PASS, A_REF_PASS, 1000) == P_A_GCC_O0);
    assert(ratio_scaled(A_GCC_O2_PASS, A_REF_PASS, 1000) == P_A_GCC_O2);
    assert(ratio_scaled(A_CLANG_O0_PASS, A_REF_PASS, 1000) == P_A_CLANG_O0);
    assert(ratio_scaled(A_CLANG_O2_PASS, A_REF_PASS, 1000) == P_A_CLANG_O2);
}

test files_behind_is_the_matrix_coverage_cell {
    assert(A_REF_PASS - A_T27B_PASS == 15);
    assert(CELLS[2].count == A_REF_PASS - A_T27B_PASS);
}

; Section 4 prints 100.0% for Zig Debug on aarch64.
test zig_debug_passes_the_whole_denominator {
    assert(ratio_scaled(A_ZIG_DEBUG_PASS, A_REF_PASS, 1000) == P_A_ZIG_DEBUG);
}

; The 15 files behind are 14 blocked plus 1 vacuous pass, and the listed blockers sum to 14.
test files_behind_split_from_the_crosstab {
    assert(A_X_PASS_PASS == A_T27B_PASS);
    assert(A_X_PASS_PASS + A_X_BLOCKED_PASS + A_X_VACUOUS_PASS == A_REF_PASS);
    assert(A_X_BLOCKED_PASS + A_X_VACUOUS_PASS == A_REF_PASS - A_T27B_PASS);
    assert(A_BLOCK_I128 + A_BLOCK_FRAME_ADDR + A_BLOCK_EMPTY_ARRAY + A_BLOCK_SINGLES == A_X_BLOCKED_PASS);
}

; "about a third of the corpus": gen-c compiles 662 of the 1,819 files with GCC (report: 36%).
test gen_c_covers_about_a_third {
    var compiled : u64 = A_GENC_GCC_PASS + A_GENC_GCC_FAIL + A_GENC_GCC_NOTESTS;
    assert(compiled == 662);
    assert(compiled + A_GENC_GCC_NOCOMPILE + A_GENC_GCC_NOGEN == A_CORPUS_ALL);
    assert(in_band(ratio_scaled(compiled, A_CORPUS_ALL, 1000), 300, 400));
    assert(round_div(ratio_scaled(compiled, A_CORPUS_ALL, 1000), 10) == 36);
}

// ------------------------------------------------------------------
// Tests: section B
// ------------------------------------------------------------------

test compile_table_ratios_agree {
    assert(agrees(B_T27B_BUILD_US, B_T27B_TEST_US, 100, P_B_BUILD));
    assert(agrees(B_GCC_O0_US, B_T27B_TEST_US, 100, P_B_GCC_O0));
    assert(agrees(B_GCC_O2_US, B_T27B_TEST_US, 100, P_B_GCC_O2));
    assert(agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, P_B_CLANG_O0));
    assert(agrees(B_CLANG_O2_US, B_T27B_TEST_US, 100, P_B_CLANG_O2));
    assert(agrees(B_ZIG_DEBUG_US, B_T27B_TEST_US, 100, P_B_ZIG_DEBUG));
    assert(agrees(B_ZIG_RF_US, B_T27B_TEST_US, 100, P_B_ZIG_RF));
}

test abstract_compile_figures_round_from_the_table {
    assert(round_div(B_T27B_TEST_US, 100) == 48);     // 4.8 ms
    assert(round_div(P_B_GCC_O0, 10) == 88);          // 8.8x
    assert(agrees(B_ZIG_DEBUG_US, B_T27B_TEST_US, 100, 64000)); // about 640x
    assert(agrees(B_ZIG_RF_US, B_T27B_TEST_US, 100, 290000));   // about 2,900x
}

test blog_erratum_figures_agree {
    assert(agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, 1500)); // 15x below Clang -O0
    assert(agrees(B_CLANG_O2_US, B_T27B_TEST_US, 100, 2200)); // 22x below Clang -O2
}

test batched_gap_agrees {
    assert(round_div(BATCH_T27B_MS, 10) == 72);       // 0.72 s
    assert(agrees(BATCH_ZIG_DEBUG_MS, BATCH_T27B_MS, 100, P_BATCH_DEBUG));
    assert(agrees(BATCH_ZIG_RF_MS, BATCH_T27B_MS, 100, P_BATCH_RF));
}

test corpus_throughput_agrees {
    assert(ratio_scaled(CORPUS_FILES, CORPUS_T27B_MS, 1000) == P_CORPUS_T27B_FPS);
    assert(ratio_scaled(CORPUS_FILES, CORPUS_GCC_O0_MS, 1000) == P_CORPUS_GCC_O0_FPS);
    assert(agrees(CORPUS_GCC_O0_MS, CORPUS_T27B_MS, 100, P_CORPUS_RATIO));
}

; The 19.9 s and 3.10 s inputs above are report prose (line 216); the JSON sums behind them
; are 2.543 + 17.37 = 19.913 s and 3.098 s, and give the same three printed figures.
test corpus_inputs_trace_to_the_json_sums {
    var gcc_pipeline : u64 = CORPUS_JSON_GEN_C_MS + CORPUS_JSON_GCC_O0_OBJ_MS;
    assert(gcc_pipeline == 19913);
    assert(round_div(gcc_pipeline, 100) == round_div(CORPUS_GCC_O0_MS, 100));
    assert(round_div(CORPUS_JSON_T27B_MS, 10) == round_div(CORPUS_T27B_MS, 10));
    assert(ratio_scaled(CORPUS_FILES, gcc_pipeline, 1000) == P_CORPUS_GCC_O0_FPS);
    assert(ratio_scaled(CORPUS_FILES, CORPUS_JSON_T27B_MS, 1000) == P_CORPUS_T27B_FPS);
    assert(agrees(gcc_pipeline, CORPUS_JSON_T27B_MS, 100, P_CORPUS_RATIO));
}

// ------------------------------------------------------------------
// Tests: section C
// ------------------------------------------------------------------

test gcc_rows_round_from_the_json {
    assert(round_div(C_JSON_INSN_GCC_O0, 100) == 91);   // 0.91x, abstract and table
    assert(round_div(C_JSON_INSN_GCC_O2, 100) == C_GCC_O2_INSN);
    assert(round_div(C_JSON_TIME_GCC_O2, 100) == C_GCC_O2_TIME);
    assert(round_div(C_JSON_SIZE_GCC_O2, 100) == 182);
    assert(round_div(C_JSON_INSN_GCC_O2, 1000) == 34);  // 3.4x
    assert(round_div(C_JSON_TIME_GCC_O2, 1000) == 41);  // 4.1x: 4.053, not 4.05
    assert(round_div(C_JSON_SIZE_GCC_O2, 1000) == 18);  // 1.8x
}

test section_c_text_rounds_from_the_table {
    assert(round_div(C_RSAFE_INSN, 10) == 32);   // 3.2x
    assert(round_div(C_RSAFE_TIME, 10) == 34);   // 3.4x
    assert(round_div(C_CLANG_O2_INSN, 10) == 35); // 3.5x
    assert(round_div(C_CLANG_O2_TIME, 10) == 37); // 3.7x, abstract
}

test every_optimising_pipeline_is_3_to_5_times_better {
    assert(in_band(C_RSAFE_INSN, 300, 500) and in_band(C_RSAFE_TIME, 300, 500));
    assert(in_band(C_RFAST_INSN, 300, 500) and in_band(C_RFAST_TIME, 300, 500));
    assert(in_band(C_GCC_O2_INSN, 300, 500) and in_band(C_GCC_O2_TIME, 300, 500));
    assert(in_band(C_CLANG_O2_INSN, 300, 500) and in_band(C_CLANG_O2_TIME, 300, 500));
}

; Tier 2: the geometric mean over the four specs of t27b trap over each Zig build. From the
; three-figure table values the means are 10.12 (ReleaseFast) and 6.99 (ReleaseSafe).
test tier_2_crypto_figures_round_from_the_table {
    assert(geomean4_rounds_to(
        ratio_scaled(T2_SHA256_TRAP, T2_SHA256_RFAST, 1000),
        ratio_scaled(T2_SHA512_TRAP, T2_SHA512_RFAST, 1000),
        ratio_scaled(T2_ED25519_TRAP, T2_ED25519_RFAST, 1000),
        ratio_scaled(T2_GF16_TRAP, T2_GF16_RFAST, 1000),
        P_T2_RFAST_INSN, 10));
    assert(geomean4_rounds_to(
        ratio_scaled(T2_SHA256_TRAP, T2_SHA256_RSAFE, 1000),
        ratio_scaled(T2_SHA512_TRAP, T2_SHA512_RSAFE, 1000),
        ratio_scaled(T2_ED25519_TRAP, T2_ED25519_RSAFE, 1000),
        ratio_scaled(T2_GF16_TRAP, T2_GF16_RSAFE, 1000),
        P_T2_RSAFE_INSN, 10));
    assert(round_div(P_T2_RFAST_INSN, 10) == 10);   // "10x on the crypto specifications"
}

// ------------------------------------------------------------------
// Tests: section D
// ------------------------------------------------------------------

test abstract_memory_rounds_from_the_median {
    assert(round_div(D_T27B_RSS, 100) == 53);   // 5.3 MiB
}

// ------------------------------------------------------------------
// Tests: section E
// ------------------------------------------------------------------

; The backend is the generated lines plus the hand-written ones; counting the front end adds
; the two bootstrap files t27b mounts. The JSON shares are exact at four places, and the paper
; prints them as whole percents.
test generated_shares_round_from_the_json {
    var backend : u64 = E_GEN_LINES + E_HAND_LINES;
    assert(E_FRONT_COMPILER + E_FRONT_RESOLVE == E_FRONT_LINES);
    assert(ratio_scaled(E_GEN_LINES, backend, 10000) == E_JSON_SHARE_BACKEND);
    assert(ratio_scaled(E_GEN_LINES, backend + E_FRONT_LINES, 10000) == E_JSON_SHARE_WITH_FRONT);
    assert(round_div(E_JSON_SHARE_BACKEND, 100) == P_E_SHARE_BACKEND);
    assert(round_div(E_JSON_SHARE_WITH_FRONT, 100) == P_E_SHARE_WITH_FRONT);
}

// ------------------------------------------------------------------
// Tests: the matrix cells against the same arithmetic
// ------------------------------------------------------------------

test matrix_ratio_cells_agree {
    assert(matrix_agrees(B_T27B_TEST_US, B_GCC_O0_US, CELLS[3].t27b_milli));
    assert(matrix_agrees(CORPUS_T27B_MS, CORPUS_GCC_O0_MS, CELLS[4].t27b_milli));
    assert(matrix_agrees(D_T27B_RSS, D_GCC_O0_RSS, CELLS[5].t27b_milli));
    assert(matrix_agrees(D_T27B_EXE_KB, D_GCC_INSTALL_KB, CELLS[6].t27b_milli));
    assert(within_pct(C_RFAST_INSN * 10, CELLS[7].t27b_milli, MATRIX_PCT));
    assert(within_pct(C_RFAST_TIME * 10, CELLS[8].t27b_milli, MATRIX_PCT));
    assert(within_pct(C_RFAST_SIZE * 10, CELLS[10].t27b_milli, MATRIX_PCT));
}

; The RSS cell was taken from the rounded display values, not the medians. Both are recorded so
; that a re-taken cell shows which one it used.
test matrix_rss_cell_came_from_display_values {
    assert(ratio_scaled(5300, 27000, 1000) == CELLS[5].t27b_milli);
    assert(ratio_scaled(D_T27B_RSS, D_GCC_O0_RSS, 1000) != CELLS[5].t27b_milli);
}

// ------------------------------------------------------------------
// Negative controls: what the tolerance must refuse
// ------------------------------------------------------------------

test withdrawn_blog_figures_do_not_agree {
    assert(!agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, 7000));   // "70-100x faster than clang"
    assert(!agrees(B_CLANG_O2_US, B_T27B_TEST_US, 100, 7000));
    assert(!agrees(B_ZIG_RF_US, B_T27B_TEST_US, 100, 1000000));  // "10,000x slower compile"
}

test the_640x_is_not_the_batched_gap {
    assert(!agrees(BATCH_ZIG_DEBUG_MS, BATCH_T27B_MS, 100, P_B_ZIG_DEBUG));
    assert(!agrees(B_ZIG_DEBUG_US, B_T27B_TEST_US, 100, P_BATCH_DEBUG));
}

test a_one_digit_typo_is_refused {
    assert(!agrees(B_GCC_O0_US, B_T27B_TEST_US, 100, 984));      // 9.84 for 8.84
    assert(!agrees(B_CLANG_O0_US, B_T27B_TEST_US, 100, 1600));   // 16.0 for 15.0
    assert(ratio_scaled(A_T27B_PASS, A_REF_PASS, 1000) != 998);  // 99.8% for 98.9%
    assert(round_div(C_JSON_TIME_GCC_O2, 1000) != 40);
}

test the_json_zig_entries_are_not_tier_1 {
    // JSON icount/t27b_trap/zig_ReleaseSafe geomean 3.62 (n = 24) against the table's 3.17
    assert(!within_pct(362, C_RSAFE_INSN, PAPER_PCT));
}

; The 10.1x is the trap column (the wrap column's mean is 8.76), is not a 10.2 typo, and is not
; tier 1's 4.5x carried over.
test the_crypto_figure_is_trap_tier_2_and_exact {
    var sha256 : u64 = ratio_scaled(T2_SHA256_TRAP, T2_SHA256_RFAST, 1000);
    var sha512 : u64 = ratio_scaled(T2_SHA512_TRAP, T2_SHA512_RFAST, 1000);
    var ed25519 : u64 = ratio_scaled(T2_ED25519_TRAP, T2_ED25519_RFAST, 1000);
    var gf16 : u64 = ratio_scaled(T2_GF16_TRAP, T2_GF16_RFAST, 1000);
    assert(!geomean4_rounds_to(
        ratio_scaled(T2_SHA256_WRAP, T2_SHA256_RFAST, 1000),
        ratio_scaled(T2_SHA512_WRAP, T2_SHA512_RFAST, 1000),
        ratio_scaled(T2_ED25519_WRAP, T2_ED25519_RFAST, 1000),
        ratio_scaled(T2_GF16_WRAP, T2_GF16_RFAST, 1000),
        P_T2_RFAST_INSN, 10));
    assert(!geomean4_rounds_to(sha256, sha512, ed25519, gf16, 102, 10));
    assert(!geomean4_rounds_to(sha256, sha512, ed25519, gf16, round_div(C_RFAST_INSN, 10), 10));
}

; The 36% divides by the whole backend, not by the hand-written lines alone (that gives 56%),
; and the 12% is the share with the front end, not the backend share relabelled.
test the_generated_shares_use_the_right_denominators {
    var backend : u64 = E_GEN_LINES + E_HAND_LINES;
    assert(round_div(ratio_scaled(E_GEN_LINES, E_HAND_LINES, 10000), 100) != P_E_SHARE_BACKEND);
    assert(round_div(ratio_scaled(E_GEN_LINES, backend, 10000), 100) != P_E_SHARE_WITH_FRONT);
    assert(round_div(ratio_scaled(E_GEN_LINES, E_FRONT_LINES, 10000), 100) != P_E_SHARE_WITH_FRONT);
}

; Section 4 controls: the blockers alone are not the 15, the 3 extra passes are not part of
; them, "about a third" is not a half and needs the 1,819-file corpus (over the 1,311
; denominator 662 is 50%), and one file short of 1,311 prints 99.9%, not 100.0%.
test the_section_4_splits_are_not_interchangeable {
    var compiled : u64 = A_GENC_GCC_PASS + A_GENC_GCC_FAIL + A_GENC_GCC_NOTESTS;
    assert(A_BLOCK_I128 + A_BLOCK_FRAME_ADDR + A_BLOCK_EMPTY_ARRAY + A_BLOCK_SINGLES != A_REF_PASS - A_T27B_PASS);
    assert(A_X_BLOCKED_PASS + A_X_VACUOUS_PASS + A_X_PASS_BLOCKED != A_REF_PASS - A_T27B_PASS);
    assert(!in_band(ratio_scaled(compiled, A_CORPUS_ALL, 1000), 450, 550));
    assert(!in_band(ratio_scaled(compiled, A_REF_PASS, 1000), 300, 400));
    assert(ratio_scaled(A_ZIG_DEBUG_PASS - 1, A_REF_PASS, 1000) != P_A_ZIG_DEBUG);
}

; Section 5 control: the gen-c + GCC -O0 pipeline is the generator plus the compile. The
; object compile alone (17.4 s) does not round to 19.9 s, does not give 6.4x over t27b
; (it gives 5.6x), and gives 33 files per second, not 28.
test the_gcc_pipeline_includes_the_generator {
    assert(round_div(CORPUS_JSON_GCC_O0_OBJ_MS, 100) != round_div(CORPUS_GCC_O0_MS, 100));
    assert(!agrees(CORPUS_JSON_GCC_O0_OBJ_MS, CORPUS_JSON_T27B_MS, 100, P_CORPUS_RATIO));
    assert(ratio_scaled(CORPUS_FILES, CORPUS_JSON_GCC_O0_OBJ_MS, 1000) != P_CORPUS_GCC_O0_FPS);
}
