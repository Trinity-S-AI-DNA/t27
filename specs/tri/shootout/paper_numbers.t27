/// How many of the first n specs have a[i] below permille thousandths of b[i].
pub fn count_below(a: []const u64, b: []const u64, n: usize, permille: u64) -> u64 {
    var c : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        if (a[i] * 1000 < b[i] * permille) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

; Table 4: the GCC -O0 and Clang -O0 rows round from the n = 20 JSON geomeans, so with the
; GCC -O2 row (gcc_rows_round_from_the_json) 9 of the 21 cells trace to the JSON.
test table4_o0_rows_round_from_the_json {
    assert(round_div(C_JSON_TIME_GCC_O0, 100) == C_GCC_O0_TIME);
    assert(round_div(C_JSON_SIZE_GCC_O0, 100) == C_GCC_O0_SIZE);
    assert(round_div(C_JSON_INSN_CLANG_O0, 100) == C_CLANG_O0_INSN);
    assert(round_div(C_JSON_TIME_CLANG_O0, 100) == C_CLANG_O0_TIME);
    assert(round_div(C_JSON_SIZE_CLANG_O0, 100) == C_CLANG_O0_SIZE);
}

; "beats only unoptimised LLVM output (Zig Debug, Clang -O0)": those two are the rows where
; t27b is ahead on all three columns; against GCC -O0 it is ahead on instructions only.
; "Its code is larger than every optimising build": every optimising row's size is above 1.
test table4_prose_claims_hold {
    assert(C_ZIG_DEBUG_INSN < 100 and C_ZIG_DEBUG_TIME < 100 and C_ZIG_DEBUG_SIZE < 100);
    assert(C_CLANG_O0_INSN < 100 and C_CLANG_O0_TIME < 100 and C_CLANG_O0_SIZE < 100);
    assert(round_div(C_JSON_INSN_GCC_O0, 100) < 100 and C_GCC_O0_TIME > 100 and C_GCC_O0_SIZE > 100);
    assert(C_RSAFE_SIZE > 100 and C_RFAST_SIZE > 100);
    assert(round_div(C_JSON_SIZE_GCC_O2, 100) > 100 and C_CLANG_O2_SIZE > 100);
}

; Clang -O2 evaluated the test at compile time on 11 of the 20 specs: on those it executed
; under 1% of GCC -O0's instructions. The other 9 are the n of the Clang -O2 row.
test clang_o2_folds_count_from_the_json {
    assert(count_below(&C_ICOUNT_CLANG_O2, &C_ICOUNT_GCC_O0, 20, 10) == P_C_CLANG_O2_FOLDED);
    assert(C_TIER1_N - P_C_CLANG_O2_FOLDED == C_CLANG_O2_N);
}

; The overflow-check cost is the t27b row of the report's table, trap over wrap: 1.12 and 1.24.
test overflow_check_cost_rounds_from_the_table {
    assert(C_WRAP_INSN - 100 == P_C_TRAP_INSN_PCT);
    assert(C_WRAP_TIME - 100 == P_C_TRAP_TIME_PCT);
}

; t27core: 544.2 ms under t27b trap against 65.74 ms under Zig Debug, while t27b executes
; fewer instructions (4.87 million against 7.53 million).
test t27core_slowdown_traces_to_the_json {
    assert(ratio_scaled(C_T27CORE_CMS_TRAP, C_T27CORE_CMS_ZIG_DEBUG, 10) == P_C_T27CORE_SLOWER);
    assert(C_T27CORE_INSN_TRAP < C_T27CORE_INSN_ZIG_DEBUG);
}

; The kernel is kernel_sieve (report section C): Zig ReleaseFast executes 43% fewer
; instructions than t27b trap and takes 25% longer (591.3 ms against 471.5 ms). One spec,
; emulated time.
test kernel_sieve_figures_trace_to_the_json {
    assert(ratio_scaled(C_SIEVE_INSN_TRAP - C_SIEVE_INSN_RFAST, C_SIEVE_INSN_TRAP, 100) == P_C_SIEVE_FEWER_PCT);
    assert(ratio_scaled(C_SIEVE_CMS_RFAST - C_SIEVE_CMS_TRAP, C_SIEVE_CMS_TRAP, 100) == P_C_SIEVE_LONGER_PCT);
}

; Section 6 controls. The 8.3x needs the JSON medians (the report prose's 544 ms over 66 ms
; prints 8.2x) and the trap column (wrap prints 7.3x). The kernel_sieve figures are against
; trap: against wrap they print 38% and 64%, and over the other base 75% and 20%. The fold
; count needs the 1% cut (5% gives 12, 0.5% gives 10). The 12% and 24% are the table's tier-1
; values: the JSON's n = 24 geomeans print 13% and 25%, and the size column prints 8%. The
; Clang -O2 row needs its 9-spec subset: the JSON's n = 20 geomean is 535x.
test the_section_6_figures_need_the_trap_column_and_the_1_percent_cut {
    assert(ratio_scaled(54400, 6600, 10) != P_C_T27CORE_SLOWER);
    assert(ratio_scaled(C_T27CORE_CMS_WRAP, C_T27CORE_CMS_ZIG_DEBUG, 10) != P_C_T27CORE_SLOWER);
    assert(ratio_scaled(C_SIEVE_INSN_WRAP - C_SIEVE_INSN_RFAST, C_SIEVE_INSN_WRAP, 100) != P_C_SIEVE_FEWER_PCT);
    assert(ratio_scaled(C_SIEVE_INSN_TRAP - C_SIEVE_INSN_RFAST, C_SIEVE_INSN_RFAST, 100) != P_C_SIEVE_FEWER_PCT);
    assert(ratio_scaled(C_SIEVE_CMS_RFAST - C_SIEVE_CMS_WRAP, C_SIEVE_CMS_WRAP, 100) != P_C_SIEVE_LONGER_PCT);
    assert(ratio_scaled(C_SIEVE_CMS_RFAST - C_SIEVE_CMS_TRAP, C_SIEVE_CMS_RFAST, 100) != P_C_SIEVE_LONGER_PCT);
    assert(count_below(&C_ICOUNT_CLANG_O2, &C_ICOUNT_GCC_O0, 20, 50) != P_C_CLANG_O2_FOLDED);
    assert(count_below(&C_ICOUNT_CLANG_O2, &C_ICOUNT_GCC_O0, 20, 5) != P_C_CLANG_O2_FOLDED);
    assert(round_div(C_JSON_WRAP_INSN_N24 - 10000, 100) != P_C_TRAP_INSN_PCT);
    assert(round_div(C_JSON_WRAP_TIME_N24 - 10000, 100) != P_C_TRAP_TIME_PCT);
    assert(C_WRAP_SIZE - 100 != P_C_TRAP_INSN_PCT and C_WRAP_SIZE - 100 != P_C_TRAP_TIME_PCT);
    assert(!within_pct(round_div(C_JSON_INSN_CLANG_O2_N20, 100), C_CLANG_O2_INSN, PAPER_PCT));
}

// ------------------------------------------------------------------
// Paper section 6: the wrap row and the Clang -O2 row, recomputed
// ------------------------------------------------------------------

; The per-spec raw values behind two rows that used to be COPIED, in axis_C.tier1 order
; (report JSON at 9a0f4c394): axis_C.icount of t27b_trap and t27b_wrap, the median of 5 of
; axis_C.runtime_ms in milliseconds for t27b_trap, t27b_wrap and clang_O2, and from sizes the
; t27b jit_image_bytes and clang_O2 object_text_all_bytes (all .text* of gen-c's object, the
; report's code-size rule). The geomean of per-spec ratios is the ratio of the geomeans, so
; each row is one product of n ratios checked against the printed value to the n-th power.

pub const C_ICOUNT_TRAP : [20]u64 = [8933874559, 4238693240, 2613751879, 1724036554, 1190417013, 944401265, 1308624309, 567356807, 420000203, 293603281, 40823080, 40200798, 29890521, 11185366, 9985766, 4265768, 1656009, 5614026, 3245909, 4868246];
pub const C_ICOUNT_WRAP : [20]u64 = [5788144599, 4169393584, 1789777117, 1460778364, 1091208738, 860799909, 1241515424, 522565490, 400000202, 268437418, 40460034, 38494113, 27764670, 9991294, 8042105, 3734011, 1547283, 5529518, 2985712, 4360994];
pub const C_RUN_MS_TRAP : [20]f64 = [4747.0, 2508.0, 1025.0, 1474.0, 471.5, 408.6, 483.3, 358.0, 359.0, 134.4, 31.36, 29.7, 21.33, 6.042, 7.358, 4.554, 3.607, 8.155, 4.762, 544.2];
pub const C_RUN_MS_WRAP : [20]f64 = [2467.0, 2622.0, 501.6, 1117.0, 361.3, 336.1, 443.5, 313.0, 328.5, 109.4, 35.62, 31.51, 13.63, 3.486, 5.636, 4.155, 3.409, 6.161, 4.344, 483.0];
pub const C_RUN_MS_CLANG_O2 : [20]f64 = [0.2171, 442.9, 133.1, 358.4, 341.0, 145.3, 0.166, 171.5, 0.178, 0.1905, 1.15, 26.47, 0.1629, 0.1844, 0.3552, 0.2046, 0.1787, 2.646, 0.234, 11.6];
pub const C_JIT_TRAP : [20]u64 = [2784, 21036, 2852, 580, 1412, 3156, 2380, 484, 628, 2972, 6072, 30100, 4484, 1740, 12072, 5804, 13952, 13452, 7328, 140868];
pub const C_JIT_WRAP : [20]u64 = [2624, 19980, 2500, 516, 1332, 2852, 2332, 436, 612, 2860, 5800, 28164, 3972, 1532, 10312, 5460, 13408, 12828, 6540, 131444];
pub const C_SIZE_CLANG_O2 : [20]u64 = [384, 10692, 1596, 320, 1320, 2052, 172, 152, 100, 332, 3044, 26600, 2364, 596, 4624, 1340, 5176, 9100, 2248, 176676];

; The 9 specs Clang -O2 did not fold: t27a, kernel_matmul, kernel_collatz, kernel_sieve,
; kernel_ternary, kernel_fib, isa_round_trip, fuzz, eth_rx.
pub const C_CLANG_O2_KEPT : [9]usize = [1, 2, 3, 4, 5, 7, 10, 11, 17];

/// x to the n-th power.
pub fn pow_n(x: f64, n: usize) -> f64 {
    var p : f64 = 1.0;
    var i : usize = 0;
    while (i < n) {
        p = p * x;
        i = i + 1;
    }
    return p;
}

/// Whether the geomean of n values whose product is prod rounds to printed / scale at step
/// step / scale: (P - s/2)^n <= prod < (P + s/2)^n.
pub fn geo_rounds_to(prod: f64, n: usize, printed: u64, step: u64, scale: u64) -> bool {
    const p : f64 = (printed as f64) / (scale as f64);
    const h : f64 = (step as f64) / (2.0 * (scale as f64));
    return pow_n(p - h, n) <= prod and prod < pow_n(p + h, n);
}

/// The product over the first n specs of a[i] / b[i].
pub fn prod_ratio_u64(a: []const u64, b: []const u64, n: usize) -> f64 {
    var p : f64 = 1.0;
    var i : usize = 0;
    while (i < n) {
        p = p * ((a[i] as f64) / (b[i] as f64));
        i = i + 1;
    }
    return p;
}

/// The product over the first n specs of a[i] / b[i], for values already in f64.
pub fn prod_ratio_f64(a: []const f64, b: []const f64, n: usize) -> f64 {
    var p : f64 = 1.0;
    var i : usize = 0;
    while (i < n) {
        p = p * (a[i] / b[i]);
        i = i + 1;
    }
    return p;
}

/// The product of a[k[j]] / b[k[j]] over the first m entries of k.
pub fn prod_ratio_u64_at(a: []const u64, b: []const u64, k: []const usize, m: usize) -> f64 {
    var p : f64 = 1.0;
    var j : usize = 0;
    while (j < m) {
        p = p * ((a[k[j]] as f64) / (b[k[j]] as f64));
        j = j + 1;
    }
    return p;
}

/// The product of a[k[j]] / b[k[j]] over the first m entries of k, for values in f64.
pub fn prod_ratio_f64_at(a: []const f64, b: []const f64, k: []const usize, m: usize) -> f64 {
    var p : f64 = 1.0;
    var j : usize = 0;
    while (j < m) {
        p = p * (a[k[j]] / b[k[j]]);
        j = j + 1;
    }
    return p;
}

/// Whether the first m entries of k rise strictly and each names a spec where a[k[j]] is at
/// least permille thousandths of b[k[j]]. With count_below giving n - m below the cut, this
/// makes k exactly the specs above it.
pub fn kept_not_below(a: []const u64, b: []const u64, k: []const usize, m: usize, permille: u64) -> bool {
    var ok : bool = true;
    var j : usize = 0;
    while (j < m) {
        if (a[k[j]] * 1000 < b[k[j]] * permille) {
            ok = false;
        }
        if (j > 0) {
            if (k[j] <= k[j - 1]) {
                ok = false;
            }
        }
        j = j + 1;
    }
    return ok;
}

; The wrap row at n = 20: trap over wrap is 1.1226 (instructions), 1.2396 (run time) and
; 1.0810 (code size), which print 1.12 / 1.24 / 1.08. The per-spec arrays agree with the
; scalar copies the section 6 tests use (kernel_sieve, t27core).
test wrap_row_recomputes_from_the_json_at_n20 {
    assert(C_ICOUNT_TRAP[4] == C_SIEVE_INSN_TRAP and C_ICOUNT_WRAP[4] == C_SIEVE_INSN_WRAP);
    assert(C_ICOUNT_TRAP[19] == C_T27CORE_INSN_TRAP);
    assert(geo_rounds_to(prod_ratio_u64(&C_ICOUNT_TRAP, &C_ICOUNT_WRAP, 20), 20, C_WRAP_INSN, 1, 100));
    assert(geo_rounds_to(prod_ratio_f64(&C_RUN_MS_TRAP, &C_RUN_MS_WRAP, 20), 20, C_WRAP_TIME, 1, 100));
    assert(geo_rounds_to(prod_ratio_u64(&C_JIT_TRAP, &C_JIT_WRAP, 20), 20, C_WRAP_SIZE, 1, 100));
}

; The Clang -O2 row at n = 9: the kept list is exactly the 9 specs above the 1% fold cut,
; and t27b trap over Clang -O2 is 3.5035 (instructions), 3.7226 (run time) and 1.6882 (code
; size), which print 3.50 / 3.72 / 1.69.
test clang_o2_row_recomputes_from_the_json_at_n9 {
    assert(kept_not_below(&C_ICOUNT_CLANG_O2, &C_ICOUNT_GCC_O0, &C_CLANG_O2_KEPT, 9, 10));
    assert(C_TIER1_N - count_below(&C_ICOUNT_CLANG_O2, &C_ICOUNT_GCC_O0, 20, 10) == 9);
    assert(geo_rounds_to(prod_ratio_u64_at(&C_ICOUNT_TRAP, &C_ICOUNT_CLANG_O2, &C_CLANG_O2_KEPT, 9), 9, C_CLANG_O2_INSN, 1, 100));
    assert(geo_rounds_to(prod_ratio_f64_at(&C_RUN_MS_TRAP, &C_RUN_MS_CLANG_O2, &C_CLANG_O2_KEPT, 9), 9, C_CLANG_O2_TIME, 1, 100));
    assert(geo_rounds_to(prod_ratio_u64_at(&C_JIT_TRAP, &C_SIZE_CLANG_O2, &C_CLANG_O2_KEPT, 9), 9, C_CLANG_O2_SIZE, 1, 100));
}

; Controls. The n = 24 JSON values (1.13, 1.25) do not come out of the 20 specs; the same
; products read as 24 specs give 1.10 and 1.07, not 1.12 and 1.08; all 20 specs, folded ones
; included, do not give 3.50; a cut at 100% of GCC -O0 refuses the kept list.
test the_recomputed_rows_need_n20_and_the_kept_nine {
    assert(!geo_rounds_to(prod_ratio_u64(&C_ICOUNT_TRAP, &C_ICOUNT_WRAP, 20), 20, 113, 1, 100));
    assert(!geo_rounds_to(prod_ratio_f64(&C_RUN_MS_TRAP, &C_RUN_MS_WRAP, 20), 20, 125, 1, 100));
    assert(!geo_rounds_to(prod_ratio_u64(&C_ICOUNT_TRAP, &C_ICOUNT_WRAP, 20), 24, C_WRAP_INSN, 1, 100));
    assert(!geo_rounds_to(prod_ratio_u64(&C_JIT_TRAP, &C_JIT_WRAP, 20), 24, C_WRAP_SIZE, 1, 100));
    assert(!geo_rounds_to(prod_ratio_u64(&C_ICOUNT_TRAP, &C_ICOUNT_CLANG_O2, 20), 20, C_CLANG_O2_INSN, 1, 100));
    assert(!kept_not_below(&C_ICOUNT_CLANG_O2, &C_ICOUNT_GCC_O0, &C_CLANG_O2_KEPT, 9, 1000));
}
