; specs/tri/shootout/bench_audit.t27 -- Benchmark function for codegen audit
; Runs verdict_fn 200M times in a loop to measure real runtime
; Closes #11275
; phi^2 + 1/phi^2 = 3 | TRINITY

module BenchAudit;

pub fn verdict_fn(tick: u64, prev_tick: u64) -> u64 {
    if (tick == prev_tick) { return 0; }
    return 1;
}

pub fn verdict_benchmark_200m(tick: u64, prev_tick: u64) -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    var cur_tick : u64 = tick;
    var cur_prev : u64 = prev_tick;
    while (i < CALLS_TARGET) {
        acc = acc + verdict_fn(cur_tick, cur_prev);
        cur_tick = cur_tick + 1;
        if (cur_tick > 1000) {
            cur_tick = 0;
            cur_prev = 1000;
        } else {
            cur_prev = cur_tick - 1;
        }
        i = i + 1;
    }
    return acc % 2;
}

pub const CALLS_TARGET : u64 = 200_000_000;

test verdict_benchmark_200m_returns_valid {
    var r = verdict_benchmark_200m(5, 4);
    assert(r == 0 or r == 1);
    var r2 = verdict_benchmark_200m(5, 5);
    assert(r2 == 0 or r2 == 1);
}
