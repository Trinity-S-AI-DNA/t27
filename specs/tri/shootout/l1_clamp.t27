// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/l1_clamp.t27 -- loss L1 of codegen_audit.t27 cut out on its own: the saturating wrap of
; the 200M heartbeat (bench_audit.t27 lines 21-27), with nothing else around it (Refs #12877).
; --
; Source shape, as bench_audit.t27 writes it inside its loop:
;     cur_tick = cur_tick + 1;
;     if (cur_tick > 1000) { cur_tick = 0; cur_prev = 1000; } else { cur_prev = cur_tick - 1; }
; t27b lowers that `if` to Stmt::If (cli/t27b/src/lower.rs, NodeKind::StmtIf) and codegen emits it as
; cmp / b.ls / two movz / b / subs / b.lo (cli/t27b/src/codegen.rs, Stmt::If). An `if` used as a value
; becomes ExprKind::Select, which codegen also emits with a branch and a jump: no path in t27b emits
; CSEL today, although specs/tri/t27b/a64.t27 encodes it.
; --
; These functions are the regression gate for the branchless form planned in
; specs/tri/t27b/ifconv_plan.t27: the tests below must give the same values before and after it. They pin
; the edges of the wrap: 1, the limit, the limit + 1, and the largest u64. wrap_prev(0) traps (0 - 1 is
; checked arithmetic) and must still trap after the change; an assert cannot state a trap, so that edge
; lives in the receipt .trinity/receipts/t27b-l1-clamp-2026-11-02/README.md.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriShootoutL1Clamp;

/// The tick after a wrap check: past 1000 it starts again at 0. One assignment, no else.
pub fn wrap_tick(t: u64) -> u64 {
    var tick : u64 = t;
    if (tick > 1000) {
        tick = 0;
    }
    return tick;
}

/// The previous tick: 1000 after a wrap, else t - 1. One assignment in each arm.
pub fn wrap_prev(t: u64) -> u64 {
    var prev : u64 = 0;
    if (t > 1000) {
        prev = 1000;
    } else {
        prev = t - 1;
    }
    return prev;
}

/// Both at once, as the benchmark writes it: two assignments in one arm, one in the other.
/// The result packs the pair as tick * 4096 + prev; no input overflows it (tick <= 1000 there).
pub fn wrap_pair(t: u64) -> u64 {
    var tick : u64 = t;
    var prev : u64 = 0;
    if (tick > 1000) {
        tick = 0;
        prev = 1000;
    } else {
        prev = tick - 1;
    }
    return tick * 4096 + prev;
}

test wrap_tick_keeps_every_tick_up_to_the_limit {
    assert(wrap_tick(0) == 0);
    assert(wrap_tick(1) == 1);
    assert(wrap_tick(999) == 999);
    assert(wrap_tick(1000) == 1000);
}

test wrap_tick_restarts_past_the_limit {
    assert(wrap_tick(1001) == 0);
    assert(wrap_tick(1002) == 0);
    assert(wrap_tick(18446744073709551615) == 0);
}

test wrap_prev_is_one_less_up_to_the_limit {
    assert(wrap_prev(1) == 0);
    assert(wrap_prev(2) == 1);
    assert(wrap_prev(1000) == 999);
}

test wrap_prev_is_the_limit_past_it {
    assert(wrap_prev(1001) == 1000);
    assert(wrap_prev(1002) == 1000);
    assert(wrap_prev(18446744073709551615) == 1000);
}

test wrap_pair_matches_its_two_halves {
    assert(wrap_pair(1) == 4096);
    assert(wrap_pair(1000) == 1000 * 4096 + 999);
    assert(wrap_pair(1001) == 1000);
    assert(wrap_pair(18446744073709551615) == 1000);
    // the halves agree with the single functions at the same edges
    assert(wrap_pair(500) == wrap_tick(500) * 4096 + wrap_prev(500));
    assert(wrap_pair(1001) == wrap_tick(1001) * 4096 + wrap_prev(1001));
}
