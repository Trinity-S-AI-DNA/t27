// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/bench_200m.t27 -- 200M-call verdict benchmark for t27b codegen audit
; Runs verdict_fn 200M times in a loop to measure real runtime
; Closes #11275
; phi^2 + 1/phi^2 = 3 | TRINITY

module Bench200m;

use tri::shootout::bench_fn

pub const CALLS_TARGET : u64 = 200_000_000

pub fn verdict_benchmark_200m(tick: u64, prev_tick: u64) -> u8 {
    var i : u64 = 0
    var acc : u64 = 0
    var cur_tick : u64 = tick
    var cur_prev : u64 = prev_tick
    while (i < CALLS_TARGET) {
        acc = acc + verdict_fn(cur_tick, cur_prev)
        cur_tick = cur_tick + 1
        if (cur_tick > 1000) {
            cur_tick = 0
        }
        cur_prev = cur_tick - 1
        i = i + 1
    }
    return acc % 2
}

test verdict_benchmark_200m_returns_valid {
    var r = verdict_benchmark_200m(5, 4)
    assert(r == 0 or r == 1)
}
