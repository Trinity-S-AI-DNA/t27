// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/inline_select.t27 -- witness for the select-shaped inline of t27b (Refs #12871).
; A callee of the shape `if (x OP y) { return a; } return b;` is lowered by cli/t27b/src/codegen.rs
; (try_inline) as cmp + cset/csel when specs/tri/t27b/inline.t27 says so: the call site is hot (inside a
; loop) or has constant arguments. The tests call each callee both ways (in a loop, with constants, and
; cold with variable arguments, which keeps the `bl`), so the inlined and the called form must agree.
; sel_two_stmts and sel_else are shapes the law refuses; they must still answer right through the call.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriShootoutInlineSelect;

/// The verdict shape of bench_audit.t27: 0 when equal, else 1 (cset, inverted condition).
pub fn sel_ne(tick: u64, prev: u64) -> u64 {
    if (tick == prev) { return 0; }
    return 1;
}

/// Constants other than 0/1: csel of two materialized constants.
pub fn sel_csel(a: u64, b: u64) -> u64 {
    if (a == b) { return 7; }
    return 9;
}

/// Operands swapped: the parameter order is not the argument order.
pub fn sel_swapped(tick: u64, prev: u64) -> u64 {
    if (prev == tick) { return 0; }
    return 1;
}

/// Equal gives 1, else 0 (cset on the condition itself).
pub fn sel_eq(a: u64, b: u64) -> u64 {
    if (a == b) { return 1; }
    return 0;
}

/// Parameter against an imm12 constant.
pub fn sel_imm(a: u64) -> u64 {
    if (a > 1000) { return 1; }
    return 0;
}

/// Unsigned less-than.
pub fn sel_ult(a: u64, b: u64) -> u64 {
    if (a < b) { return 1; }
    return 0;
}

/// Signed less-than on i64.
pub fn sel_slt(a: i64, b: i64) -> i64 {
    if (a < b) { return 1; }
    return 0;
}

/// Signed result with a negative constant: csel with 0 - 1 as a 64-bit word.
pub fn sel_neg(a: i64, b: i64) -> i64 {
    if (a < b) { return -1; }
    return 5;
}

/// Refused: two statements before the return.
pub fn sel_two_stmts(a: u64, b: u64) -> u64 {
    var t : u64 = a + 1;
    if (t == b) { return 0; }
    return 1;
}

/// Refused: an else arm.
pub fn sel_else(a: u64, b: u64) -> u64 {
    if (a == b) { return 3; } else { return 4; }
}

/// An identity used to put a call inside an argument.
pub fn ident(x: u64) -> u64 {
    return x;
}

/// Hot call sites: the callee is inlined inside the loop. Sums sel_ne(i, 5) for i in 0..10.
pub fn hot_ne() -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < 10) {
        acc = acc + sel_ne(i, 5);
        i = i + 1;
    }
    return acc;
}

/// Sums sel_csel(i, 3) for i in 0..6: one 7 and five 9s.
pub fn hot_csel() -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < 6) {
        acc = acc + sel_csel(i, 3);
        i = i + 1;
    }
    return acc;
}

/// Arguments that are expressions and a call: evaluated in order, then compared.
pub fn hot_expr_args() -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < 8) {
        acc = acc + sel_eq(i + 1, ident(i) * 2);
        i = i + 1;
    }
    return acc;
}

test verdict_shape_equal_gives_zero {
    assert(sel_ne(5, 5) == 0);
}

test verdict_shape_different_gives_one {
    assert(sel_ne(5, 4) == 1);
}

test verdict_shape_constant_arguments {
    assert(sel_ne(3, 3) == 0);
    assert(sel_ne(3, 2) == 1);
}

test csel_picks_the_right_constant {
    assert(sel_csel(2, 2) == 7);
    assert(sel_csel(2, 3) == 9);
    assert(sel_csel(0, 0) == 7);
}

test swapped_operands {
    assert(sel_swapped(5, 5) == 0);
    assert(sel_swapped(5, 4) == 1);
    assert(sel_swapped(4, 5) == 1);
}

test cset_without_inversion {
    assert(sel_eq(8, 8) == 1);
    assert(sel_eq(8, 9) == 0);
}

test param_against_immediate {
    assert(sel_imm(1000) == 0);
    assert(sel_imm(1001) == 1);
    assert(sel_imm(0) == 0);
}

test unsigned_less_than {
    assert(sel_ult(1, 2) == 1);
    assert(sel_ult(2, 1) == 0);
    assert(sel_ult(2, 2) == 0);
    assert(sel_ult(1, 18446744073709551615) == 1);
    assert(sel_ult(18446744073709551615, 1) == 0);
}

test signed_less_than_on_negative_values {
    assert(sel_slt(-1, 1) == 1);
    assert(sel_slt(1, -1) == 0);
    assert(sel_slt(-2, -1) == 1);
    assert(sel_slt(-1, -1) == 0);
}

test negative_constant_through_csel {
    assert(sel_neg(-3, 2) == -1);
    assert(sel_neg(2, -3) == 5);
}

test hot_loop_ne_matches_the_called_form {
    assert(hot_ne() == 9);
}

test hot_loop_csel_matches_the_called_form {
    assert(hot_csel() == 52);
}

test hot_loop_expression_arguments {
    assert(hot_expr_args() == 1);
}

test cold_variable_arguments_keep_the_call {
    var x : u64 = 5;
    var y : u64 = 5;
    assert(sel_ne(x, y) == 0);
    y = 4;
    assert(sel_ne(x, y) == 1);
}

test refused_two_statements_still_answers {
    assert(sel_two_stmts(4, 5) == 0);
    assert(sel_two_stmts(5, 5) == 1);
}

test refused_else_arm_still_answers {
    assert(sel_else(1, 1) == 3);
    assert(sel_else(1, 2) == 4);
}

test refused_shapes_in_a_hot_loop {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < 4) {
        acc = acc + sel_two_stmts(i, 2) + sel_else(i, 2);
        i = i + 1;
    }
    assert(acc == 18);
}
