// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/check_elide.t27 -- the shapes of specs/tri/t27b/check_elide_plan.t27 cut out on their own (Refs #12871).
; Accepted shapes, whose overflow trap t27b drops: (a) the induction increment `i = i + 1` under `while (i < n)` for
; u64, i64 and u8; (b) `x - k` after `x = x + c` in the same list, and in the else arm of the `if` that follows
; (the cur_prev of bench_audit.t27). Refused shapes, whose trap stays: i assigned twice, n assigned in the body,
; `i = i + 2`, an `<=` loop, `x - 2` after `x + 1`. Every test asserts a value, so a wrong elision shows as a
; changed result and a wrongly dropped trap on the edge of the type shows as a failed assert, not as a silence.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module CheckElide;

// ---- (a) accepted: the induction increment, one type each ----

pub fn count_u64(n: u64) -> u64 {
    var i : u64 = 0;
    var s : u64 = 0;
    while (i < n) {
        s = s + 2;
        i = i + 1;
    }
    return s;
}

pub fn count_i64(n: i64) -> i64 {
    var i : i64 = -3;
    while (i < n) {
        i = i + 1;
    }
    return i;
}

pub fn count_u8(n: u8) -> u8 {
    var i : u8 = 0;
    while (i < n) {
        i = i + 1;
    }
    return i;
}

// ---- (b) accepted: the decrement after the increment ----

pub fn prev_in_else(tick: u64) -> u64 {
    var cur : u64 = tick;
    var prev : u64 = 0;
    cur = cur + 1;
    if (cur > 1000) {
        cur = 0;
        prev = 1000;
    } else {
        prev = cur - 1;
    }
    return prev;
}

pub fn prev_same_list(x: u64) -> u64 {
    var y : u64 = x;
    y = y + 3;
    var r : u64 = y - 2;
    return r;
}

// ---- refused shapes: the trap stays ----

pub fn twice_u64(n: u64) -> u64 {
    var i : u64 = 0;
    while (i < n) {
        i = i + 1;
        if (i < n) {
            i = i + 1;
        }
    }
    return i;
}

pub fn limit_moves(n0: u64) -> u64 {
    var i : u64 = 0;
    var n : u64 = n0;
    while (i < n) {
        i = i + 1;
        if (i == 3) {
            n = 5;
        }
    }
    return i;
}

pub fn step_two(n: u64) -> u64 {
    var i : u64 = 0;
    while (i < n) {
        i = i + 2;
    }
    return i;
}

pub fn le_loop(n: u64) -> u64 {
    var i : u64 = 0;
    while (i <= n) {
        i = i + 1;
    }
    return i;
}

pub fn dec_two_after_one(x: u64) -> u64 {
    var y : u64 = x;
    y = y + 1;
    return y - 2;
}

// The only i = i + 1 sits in an inner while, so it runs up to three times per test of i < n and keeps its trap.
// nested_inc(255, 254) traps (254 -> 255 -> 256) and is not asserted: a test cannot catch a trap.
pub fn nested_inc(n: u8, start: u8) -> u8 {
    var i : u8 = start;
    var j : u8 = 0;
    while (i < n) {
        j = 0;
        while (j < 3) {
            i = i + 1;
            j = j + 1;
        }
    }
    return i;
}

// ---- (c) the accumulator bound: accepted shape, then the refused ones ----

pub fn flag(a: u64, b: u64) -> u64 {
    if (a == b) { return 0; }
    return 1;
}

pub fn acc_count(n: u64) -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < n) {
        acc = acc + flag(i, 3);
        i = i + 1;
    }
    return acc;
}

// A `continue` before `i = i + 1`: acc could outrun i, so the trap stays. acc_continue(99) loops for ever, never called.
pub fn acc_continue(n: u64) -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < n) {
        acc = acc + 1;
        if (n == 99) { continue; }
        i = i + 1;
    }
    return acc;
}

pub fn acc_addend_two(n: u64) -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < n) {
        acc = acc + 2;
        i = i + 1;
    }
    return acc;
}

pub fn acc_twice(n: u64) -> u64 {
    var i : u64 = 0;
    var acc : u64 = 0;
    while (i < n) {
        acc = acc + 1;
        if (i == 2) { acc = acc + 1; }
        i = i + 1;
    }
    return acc;
}

pub fn acc_ahead(n: u64) -> u64 {
    var i : u64 = 0;
    var acc : u64 = 1;
    while (i < n) {
        acc = acc + 1;
        i = i + 1;
    }
    return acc;
}

// ---- tests ----

test accumulator_counts_the_flags {
    assert(acc_count(0) == 0);
    assert(acc_count(3) == 3);
    assert(acc_count(5) == 4);
}

test refusal_accumulator_continue_before_increment {
    assert(acc_continue(0) == 0);
    assert(acc_continue(5) == 5);
}

test refusal_accumulator_addend_two {
    assert(acc_addend_two(5) == 10);
}

test refusal_accumulator_assigned_twice {
    assert(acc_twice(5) == 6);
    assert(acc_twice(2) == 2);
}

test refusal_accumulator_starts_above_i {
    assert(acc_ahead(5) == 6);
}


test refusal_increment_in_inner_while {
    assert(nested_inc(7, 0) == 9);
    assert(nested_inc(0, 0) == 0);
    assert(nested_inc(6, 0) == 6);
    assert(nested_inc(250, 100) == 250);
}

test induction_u64_counts {
    assert(count_u64(0) == 0);
    assert(count_u64(5) == 10);
    assert(count_u64(1000) == 2000);
}

test induction_i64_counts_from_negative {
    assert(count_i64(4) == 4);
    assert(count_i64(-3) == -3);
    assert(count_i64(-10) == -3);
}

test induction_u8_reaches_the_top_without_a_trap {
    // i < 255 gives i + 1 <= 255: the last add lands on MAX and must not trap.
    assert(count_u8(255) == 255);
    assert(count_u8(0) == 0);
    assert(count_u8(7) == 7);
}

test decrement_in_else_arm_of_the_following_if {
    assert(prev_in_else(0) == 0);
    assert(prev_in_else(5) == 5);
    assert(prev_in_else(999) == 999);
    assert(prev_in_else(1000) == 1000);
    assert(prev_in_else(5000) == 1000);
}

test decrement_in_the_same_list {
    assert(prev_same_list(0) == 1);
    assert(prev_same_list(10) == 11);
}

test refusal_i_assigned_twice {
    assert(twice_u64(5) == 5);
    assert(twice_u64(4) == 4);
    assert(twice_u64(0) == 0);
}

test refusal_limit_assigned_in_body {
    assert(limit_moves(10) == 5);
    assert(limit_moves(2) == 2);
}

test refusal_step_two {
    assert(step_two(5) == 6);
    assert(step_two(4) == 4);
}

test refusal_le_loop {
    assert(le_loop(3) == 4);
    assert(le_loop(0) == 1);
}

test refusal_decrement_two_after_increment_one {
    assert(dec_two_after_one(1) == 0);
    assert(dec_two_after_one(5) == 4);
}
