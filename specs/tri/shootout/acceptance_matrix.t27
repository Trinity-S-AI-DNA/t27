// SPDX-License-Identifier: Apache-2.0
; specs/tri/shootout/acceptance_matrix.t27 -- the one acceptance matrix for t27b
; "Gold" means winning every cell of this matrix against every rival named
; below, on evidence taken at the head being judged. Nothing else is gold.
; Refs #12877
; phi^2 + 1/phi^2 = 3 | TRINITY
//
; How to read a cell
; ------------------
; A cell is one axis, one metric kind and the strongest rival on it.
; `t27b_milli` is t27b's value divided by that rival's value, times 1000, for a
; metric where lower is better (time, bytes, memory). 1000 is parity. It is 0
; when the cell has no measurement. A cell is a WIN only at or below 1000.
//
; Every number below was taken from a receipt or a dated report and carries
; the commit it was taken at. None was taken at the head of this branch, so
; no cell has EV_CURRENT, and the matrix says so in a test.
//
; Emulated instruction counts and hardware time are different metric kinds
; and never share a cell.

module TriShootoutAcceptanceMatrix;

use tri::shootout::bench::MEASURED_T27B_BASELINE;
use benchmarks::kernel_f64loop::near;

// ------------------------------------------------------------------
// Axes (fixed until the task ends)
// ------------------------------------------------------------------

pub const AX_CORRECTNESS : u64 = 1;   // matches a semantic reference; every disagreement analysed
pub const AX_COMPILE_SPEED : u64 = 2; // single spec and batch
pub const AX_COMPILE_RSS : u64 = 3;   // peak RSS for the same work
pub const AX_SHIPPED_SIZE : u64 = 4;  // required components against required components
pub const AX_RESULT_SPEED : u64 = 5;  // native runs, same task and inputs
pub const AX_RESULT_SIZE : u64 = 6;   // executable and machine code, separately
pub const AX_PRACTICAL : u64 = 7;     // a working Linux executable on a named architecture
pub const AXIS_COUNT : u64 = 7;

// ------------------------------------------------------------------
// Metric kinds. QEMU counts and hardware time are never the same kind.
// ------------------------------------------------------------------

pub const MK_DISAGREEMENTS : u64 = 1; // tests whose verdict differs from the reference
pub const MK_WALL_MS : u64 = 2;       // host wall time of a compile process
pub const MK_RSS_BYTES : u64 = 3;     // peak resident set of a compile process
pub const MK_INSTALL_BYTES : u64 = 4; // bytes of everything a user must install
pub const MK_QEMU_INSN : u64 = 5;     // guest instructions executed under qemu (deterministic)
pub const MK_HW_TIME : u64 = 6;       // wall time on real hardware, no emulator
pub const MK_CODE_BYTES : u64 = 7;    // bytes of machine code for the spec's functions
pub const MK_EXE_BYTES : u64 = 8;     // bytes of a linked executable
pub const MK_ELF_RUNS : u64 = 9;      // a static aarch64-linux ELF that runs and prints the checked answer
pub const MK_QEMU_TIME : u64 = 10;    // wall time of a guest under qemu: emulated, neither of the two above
pub const MK_FILES_BEHIND : u64 = 11; // files the reference passes and t27b does not

/// A ratio metric: t27b's value over the rival's, lower is better.
pub fn is_ratio_metric(m : u64) -> bool {
    return m == MK_WALL_MS or m == MK_RSS_BYTES or m == MK_INSTALL_BYTES or m == MK_QEMU_INSN
        or m == MK_HW_TIME or m == MK_CODE_BYTES or m == MK_EXE_BYTES or m == MK_QEMU_TIME;
}

// ------------------------------------------------------------------
// Status and evidence
// ------------------------------------------------------------------

pub const ST_WIN : u64 = 1;
pub const ST_LOSS : u64 = 2;
pub const ST_NOT_MEASURED : u64 = 3;   // the capability exists, nobody ran the comparison
pub const ST_ABSENT : u64 = 4;         // t27b cannot do this yet
pub const ST_NOT_COMPARABLE : u64 = 5; // a number exists but the two sides do different work

pub const EV_NONE : u64 = 0;
pub const EV_REPORT_STALE : u64 = 1;  // a dated lab report at an older commit
pub const EV_RECEIPT_WEAK : u64 = 2;  // a receipt with known defects (listed below)
pub const EV_CURRENT : u64 = 3;       // a receipt taken at the head being judged

