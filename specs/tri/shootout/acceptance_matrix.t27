/// Intermediate milestone, not gold: emulated instructions within 2x gcc -O2.
pub const MILESTONE_GCC_O2_MILLI : u64 = 2000;
/// Today's emulated instructions against gcc -O2 (section C).
pub const INSN_VS_GCC_O2_MILLI : u64 = 3400;

pub fn cell_wins(milli : u64) -> bool {
    return milli > 0 and milli <= 1000;
}

pub fn milestone_met(milli_vs_gcc_o2 : u64) -> bool {
    return milli_vs_gcc_o2 > 0 and milli_vs_gcc_o2 <= MILESTONE_GCC_O2_MILLI;
}

/// Gold: every cell a WIN, every cell on evidence taken at the judged head.
pub fn is_gold() -> bool {
    var i : u64 = 0;
    while (i < CELLS.len) {
        if (CELLS[i].status != ST_WIN) {
            return false;
        }
        if (CELLS[i].evidence != EV_CURRENT) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn count_status(st : u64) -> u64 {
    var n : u64 = 0;
    var i : u64 = 0;
    while (i < CELLS.len) {
        if (CELLS[i].status == st) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn count_evidence(ev : u64) -> u64 {
    var n : u64 = 0;
    var i : u64 = 0;
    while (i < CELLS.len) {
        if (CELLS[i].evidence == ev) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn axis_has_cell(ax : u64) -> bool {
    var i : u64 = 0;
    while (i < CELLS.len) {
        if (CELLS[i].axis == ax) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ------------------------------------------------------------------
// The AOT receipt, read as data (.trinity/receipts/bench_200m_aot_run1..5.json)
// ------------------------------------------------------------------
//
; Defects found 2026-11-02, why the hardware cell is EV_RECEIPT_WEAK:
;   1. the summary and bench.t27 give the median as 344.08 ms; the median of the
;      five runs is 341.655 ms (a test recomputes it);
;   2. all five runs carry the same timestamp, 2026-10-31T11:00:00Z;
;   3. the command names bench_main.c, which is not in the repository;
;   4. the machine is "Apple M-series", the tool "t27b 0.16.0 tree build", no SHA;
;   5. compile_ms is 0.00 in every run.

pub const AOT_RUNS_MS : [5]f64 = [341.655, 338.016, 349.013, 344.084, 324.901];

/// The median of the five runs, by rank: the run with two below it and two above.
pub fn aot_median_ms() -> f64 {
    var i : u64 = 0;
    while (i < AOT_RUNS_MS.len) {
        var below : u64 = 0;
        var above : u64 = 0;
        var j : u64 = 0;
        while (j < AOT_RUNS_MS.len) {
            if (AOT_RUNS_MS[j] < AOT_RUNS_MS[i]) {
                below = below + 1;
            }
            if (AOT_RUNS_MS[j] > AOT_RUNS_MS[i]) {
                above = above + 1;
            }
            j = j + 1;
        }
        if (below == 2 and above == 2) {
            return AOT_RUNS_MS[i];
        }
        i = i + 1;
    }
    return 0.0;
}

pub fn aot_spread_ms() -> f64 {
    var lo : f64 = AOT_RUNS_MS[0];
    var hi : f64 = AOT_RUNS_MS[0];
    var i : u64 = 1;
    while (i < AOT_RUNS_MS.len) {
        if (AOT_RUNS_MS[i] < lo) {
            lo = AOT_RUNS_MS[i];
        }
        if (AOT_RUNS_MS[i] > hi) {
            hi = AOT_RUNS_MS[i];
        }
        i = i + 1;
    }
    return hi - lo;
}

/// STABLE or UNSTABLE, from a row's own spread and median. A row with no median is not called stable.
pub fn spread_status(spread_ms: f64, median_ms: f64) -> u8 {
    if (median_ms <= 0.0) { return ST_UNSTABLE; }
    if (spread_ms / median_ms * 100.0 > SPREAD_LIMIT_PCT) { return ST_UNSTABLE; }
    return ST_STABLE;
}

/// Whether a further series may be run. Only an UNSTABLE row gets one, and only while it has not had its
/// allowance. A stable row is never re-run, and no row is re-run a second time to find a quieter number.
pub fn may_run_extra_series(status: u8, extra_done: u64) -> bool {
    if (status != ST_UNSTABLE) { return false; }
    return extra_done < EXTRA_SERIES_MAX;
}

/// The spread of a row that has two series: the spread of their union, which can never be smaller than
/// either series' own. This is what forbids reporting the quieter series alone.
pub fn union_spread_ms(lo_a: f64, hi_a: f64, lo_b: f64, hi_b: f64) -> f64 {
    var lo : f64 = lo_a;
    var hi : f64 = hi_a;
    if (lo_b < lo) { lo = lo_b; }
    if (hi_b > hi) { hi = hi_b; }
    return hi - lo;
}

// ------------------------------------------------------------------
// Tests (L4)
// ------------------------------------------------------------------

test gold_is_not_claimed {
    assert(!is_gold());
}

test every_axis_has_a_cell {
    var ax : u64 = 1;
    while (ax <= AXIS_COUNT) {
        assert(axis_has_cell(ax));
        ax = ax + 1;
    }
}

test no_cell_is_on_evidence_from_this_head {
    assert(count_evidence(EV_CURRENT) == 0);
}

test the_cells_add_up {
    assert(count_status(ST_WIN) == 4);
    assert(count_status(ST_LOSS) == 5);
    assert(count_status(ST_NOT_MEASURED) == 1);
    assert(count_status(ST_ABSENT) == 2);
    assert(count_status(ST_NOT_COMPARABLE) == 1);
    assert(count_status(ST_WIN) + count_status(ST_LOSS) + count_status(ST_NOT_MEASURED) + count_status(ST_ABSENT) + count_status(ST_NOT_COMPARABLE) == CELLS.len);
}

test a_ratio_cell_agrees_with_its_status {
    var i : u64 = 0;
    while (i < CELLS.len) {
        var c : AcceptanceCell = CELLS[i];
        if (is_ratio_metric(c.metric)) {
            if (c.status == ST_WIN) {
                assert(cell_wins(c.t27b_milli));
            }
            if (c.status == ST_LOSS) {
                assert(c.t27b_milli > 1000);
            }
            assert(c.count == 0);
        } else {
            assert(c.t27b_milli == 0);
        }
        if (c.status == ST_NOT_MEASURED or c.status == ST_ABSENT) {
            assert(c.t27b_milli == 0);
            assert(c.count == 0);
        }
        i = i + 1;
    }
}

test nothing_unexplained_is_a_win {
    var i : u64 = 0;
    while (i < CELLS.len) {
        var c : AcceptanceCell = CELLS[i];
        assert(c.unexplained <= c.count);
        if (c.unexplained > 0) {
            assert(c.status != ST_WIN);
        }
        if (c.axis == AX_CORRECTNESS and c.status == ST_WIN) {
            assert(c.count == 0);
        }
        i = i + 1;
    }
}

test correctness_is_lost_today {
    // one WIN (the corpus) does not carry the axis: the fuzzer and coverage lose it.
    var win : u64 = 0;
    var loss : u64 = 0;
    var i : u64 = 0;
    while (i < CELLS.len) {
        if (CELLS[i].axis == AX_CORRECTNESS and CELLS[i].status == ST_WIN) {
            win = win + 1;
        }
        if (CELLS[i].axis == AX_CORRECTNESS and CELLS[i].status == ST_LOSS) {
            loss = loss + 1;
        }
        i = i + 1;
    }
    assert(win == 1);
    assert(loss == 2);
}

test no_win_or_loss_without_evidence {
    var i : u64 = 0;
    while (i < CELLS.len) {
        if (CELLS[i].status == ST_WIN or CELLS[i].status == ST_LOSS) {
            assert(CELLS[i].evidence != EV_NONE);
        }
        i = i + 1;
    }
}

test qemu_and_hardware_are_separate_cells {
    var insn : u64 = 0;
    var qtime : u64 = 0;
    var hw : u64 = 0;
    var i : u64 = 0;
    while (i < CELLS.len) {
        if (CELLS[i].axis == AX_RESULT_SPEED and CELLS[i].metric == MK_QEMU_INSN) {
            insn = insn + 1;
        }
        if (CELLS[i].axis == AX_RESULT_SPEED and CELLS[i].metric == MK_QEMU_TIME) {
            qtime = qtime + 1;
        }
        if (CELLS[i].axis == AX_RESULT_SPEED and CELLS[i].metric == MK_HW_TIME) {
            hw = hw + 1;
        }
        i = i + 1;
    }
    assert(insn == 1);
    assert(qtime == 1);
    assert(hw == 1);
    assert(MK_QEMU_INSN != MK_HW_TIME);
    assert(MK_QEMU_TIME != MK_HW_TIME);
}

test the_two_x_gcc_milestone_is_not_gold {
    // 1.9x gcc -O2 meets the milestone and still loses the cell.
    assert(milestone_met(1900));
    assert(!cell_wins(1900));
    // today's 3.4x gcc -O2 does not even meet the milestone.
    assert(!milestone_met(INSN_VS_GCC_O2_MILLI));
}

test the_rivals_are_fixed {
    assert(RIVALS.len == 7);
    assert(RULERS.len == 2);
    assert(RULERS[0].input_mode == IN_CONSTANT);
    assert(RULERS[1].input_mode == IN_SCALING_CHECK);
    assert(RULERS[1].input_mode != IN_RUNTIME);
    assert(RULERS[0].repeats == 5);
    assert(RULERS[1].repeats == 5);
}

test aot_receipt_median_is_not_the_reported_one {
    assert(near(aot_median_ms(), 341.655, 0.0005));
    assert(!near(MEASURED_T27B_BASELINE.runtime_ms, aot_median_ms(), 2.0));
}

test aot_receipt_spread_is_seven_percent {
    assert(near(aot_spread_ms(), 24.112, 0.0005));
    var pct : f64 = aot_spread_ms() / aot_median_ms() * 100.0;
    assert(pct > 7.0 and pct < 7.1);
}

test the_aot_receipt_row_is_unstable_not_re_run_away {
    // 7 percent over 5 percent: the row is reported UNSTABLE, with its conditions, and is not re-run
    // until it looks quiet.
    assert(spread_status(aot_spread_ms(), aot_median_ms()) == ST_UNSTABLE);
    // one further series, fixed in advance, and then no more
    assert(may_run_extra_series(ST_UNSTABLE, 0));
    assert(!may_run_extra_series(ST_UNSTABLE, 1));
    // a stable row is never re-run at all
    assert(!may_run_extra_series(ST_STABLE, 0));
}

test a_second_series_never_shrinks_a_row_s_spread {
    // the real recorded series of the AOT receipt
    var lo : f64 = 324.901;
    var hi : f64 = 349.013;
    // an imagined quieter second series of the same size
    var both : f64 = union_spread_ms(lo, hi, 341.0, 342.0);
    assert(near(both, aot_spread_ms(), 0.0005));
    assert(both > 1.0);
}

test the_limit_is_a_percent_of_the_median {
    assert(spread_status(5.0, 100.0) == ST_STABLE);
    assert(spread_status(5.01, 100.0) == ST_UNSTABLE);
    // a row with no median is not called stable
    assert(spread_status(0.0, 0.0) == ST_UNSTABLE);
}
