// ------------------------------------------------------------------
// The matrix
// ------------------------------------------------------------------
//
; A ratio cell (is_ratio_metric) carries t27b / rival x 1000 in t27b_milli: under
; 1000 is a WIN. A count cell carries the count in `count` and how many of those
; nobody has analysed in `unexplained`; a correctness cell with anything
; unexplained is never a WIN, because the axis criterion is "every disagreement
; analysed".

pub const AcceptanceCell = struct {
    axis : u64,
    name : str,
    metric : u64,
    rival : str,
    t27b_milli : u64,
    count : u64,
    unexplained : u64,
    status : u64,
    evidence : u64,
    source : str,
}

