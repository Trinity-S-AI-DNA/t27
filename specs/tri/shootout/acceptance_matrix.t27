// ------------------------------------------------------------------
// Task set: two rulers plus the tier-1 corpus
// ------------------------------------------------------------------

pub const IN_CONSTANT : u64 = 1;       // inputs are literals in the test
pub const IN_RUNTIME : u64 = 2;        // inputs arrive while the program runs
pub const IN_SCALING_CHECK : u64 = 3;  // literals, plus a check that work scales with them

pub const Ruler = struct {
    name : str,
    source : str,
    entry : str,
    input_mode : u64,
    expected : str,
    anti_fold : str,
    command : str,
    pin : str,
    repeats : u64,
    spread_rule : str,
    disasm : str,
}

/// What every run pins, for both rulers.
pub const PIN_RULE : str = "git rev-parse HEAD; sha256 and --version of t27b, t27c, zig, gcc, clang; uname -m; runner image name";
/// How a ruler's repeats are reported. A row is never re-run until it looks quiet: that rule picks the
/// convenient series and hides the earlier one, which is how a noisy machine comes to look fast.
pub const SPREAD_RULE : str = "keep every run, in order; report min, median, max and spread over ALL runs of ALL series of the row; a row whose spread exceeds SPREAD_LIMIT_PCT of its median is marked UNSTABLE and its conditions are recorded (load, thermal state, frequency, other jobs); at most EXTRA_SERIES_MAX further series of the same size, fixed in advance, may be run, and it is reported beside the first, never in place of it; no series is dropped, none is chosen, and a row is never re-run until its spread is small";

/// The spread above which a row is UNSTABLE, as a percent of its own median.
pub const SPREAD_LIMIT_PCT : f64 = 5.0;
/// How many further series of the same size an UNSTABLE row may be given. Both series are then reported.
pub const EXTRA_SERIES_MAX : u64 = 1;

pub const ST_STABLE : u8 = 0;
pub const ST_UNSTABLE : u8 = 1;

