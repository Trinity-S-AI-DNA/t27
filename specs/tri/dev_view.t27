// SPDX-License-Identifier: Apache-2.0
; specs/tri/dev_view.t27 -- which surface shows the course HUD after a `tri dev` iteration, and the
; rules for the one case where that surface is our own Remote Browser (the neko pod of
; 999-multibots-telegraf) instead of the Claude Browser pane. Refs gHashTag/t27#13251 (course v2).
; --
; Why. The owner wants to SEE the HUD frames after every iteration. Today the frames are served by a
; static server on 127.0.0.1:8027 and shown in the Browser pane. The owner then asked for our own
; browser to be part of that flow. Its code stays in 999 (only-t27 forbids moving TypeScript here); its
; rules live in this spec, and the host that starts the pod reads them from the gen.
; --
; The rules.
;   1. Viewer choice. The Browser pane is the default. The pod is used only when the Docker daemon
;      answers AND the owner has allowed heavy runs on the Mac. `tri dev` never starts the daemon: it
;      asks whether one answers, and a silent daemon means the pane.
;   2. The HUD address. The pane opens http://127.0.0.1:8027/hud_NN.png. The pod opens
;      http://host.docker.internal:8027/hud_NN.png, because 127.0.0.1 inside the pod is the pod itself,
;      not the Mac. NN is two decimal digits.
;   3. The CDP port is never published. Whoever reaches CDP reads every cookie in the profile. A dev pod
;      publishes only its viewer port 8080 and the one WebRTC mux port the viewer needs, every one of
;      them bound to the host loopback, and it mounts no profile volume.
;   4. One pod per dev session, named browser-<session>. A second start for the same session reuses
;      the running pod; more than one pod for a session is refused and reported, never added to.
;   5. Health. The pod answers on 8080 within 15 s. A pod that has not answered by then is reported
;      WAITING_RESOURCE (the Mac is short of something), never FAIL; FAIL is kept for a pod that did not
;      start at all. Until the pod is UP the pane keeps showing the HUD.
; --
; Host facts, read 2026-11-08 from 999-multibots-telegraf apps/vibee-editor/render/src/browser/pod-driver.ts:
;   - dockerDriver names a pod browser-<sessionId> (nameOf), as rule 4 does.
;   - It publishes the CDP bridge (CDP_BRIDGE_PORT 9223) on 127.0.0.1:0, publishes 8080 as 0:8080 (all
;     interfaces) and always mounts browser-profile-<id>. Each of the three breaks rule 3, so a dev pod
;     cannot be started through dockerDriver as it stands (dev_pod_may_use_docker_driver is false).
;   - The pod answers on 8080 about 9.5 s after start and costs about 743 MiB at rest (measured there
;     2026-09-20), which is why rule 5's 15 s holds with room.
;   - guard.ts has no loopback or private-host block, so the guard would not refuse host.docker.internal.
; --
; Claim status: rules and tests written 2026-11-08; no pod was started for this spec (Docker Desktop
; was not started on the Mac). That the pod reaches host.docker.internal:8027 is NOT verified
; (POD_REACHES_GATEWAY_VERIFIED is false) until a pod run on a machine allowed heavy work shows it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriDevView;

use tri::remote::remote_job::emit_byte;
use tri::remote::remote_job::emit_str;
use tri::remote::remote_job::emit_dec;
use tri::remote::remote_job::buf_is;
use tri::remote::remote_job::buf_has;
use tri::remote::remote_job::safe_name;

// ---- 1. Viewer choice ---------------------------------------------------------------------------

pub const VIEWER_PANE : u8 = 0;   // the Claude Browser pane
pub const VIEWER_POD : u8 = 1;    // the neko pod of 999-multibots-telegraf
pub const VIEWER_NONE : u8 = 9;   // not a viewer: an address for it is refused
pub const VIEWER_DEFAULT : u8 = VIEWER_PANE;

/// `tri dev` asks whether a Docker daemon answers; it never starts one.
pub const DEV_STARTS_DOCKER : bool = false;

/// Heavy runs on the Mac are the owner's to allow, nobody else's.
pub const HEAVY_OK_IS_OWNER_ONLY : bool = true;

/// The viewer for this iteration: the pod only when both gates are open.
pub fn viewer_for(docker_answers: bool, heavy_ok: bool) -> u8 {
    if (docker_answers and heavy_ok) { return VIEWER_POD; }
    return VIEWER_DEFAULT;
}

// ---- 2. The HUD address -------------------------------------------------------------------------

pub const HUD_PORT : u32 = 8027;
pub const HUD_HOST_PANE : string = "127.0.0.1";
pub const HUD_HOST_POD : string = "host.docker.internal";
pub const HUD_STEM : string = "/hud_";
pub const HUD_EXT : string = ".png";
pub const HUD_FRAME_MAX : u32 = 99;   // NN is two decimal digits
pub const HUD_URL_MAX : usize = 64;

/// Not verified: a pod reaching host.docker.internal:8027 has not been observed.
pub const POD_REACHES_GATEWAY_VERIFIED : bool = false;

/// Does an address on the host loopback reach the Mac from this viewer?
/// From the pane it does; from the pod it reaches the pod itself.
pub fn loopback_reaches_mac(viewer: u8) -> bool {
    return viewer == VIEWER_PANE;
}

/// The HUD address for frame NN as seen from `viewer`, written into out; 0 when refused.
pub fn hud_url(viewer: u8, frame: u32, out: []u8) -> usize {
    if (frame > HUD_FRAME_MAX) { return 0; }
    if (viewer != VIEWER_PANE and viewer != VIEWER_POD) { return 0; }
    var w : usize = emit_str(out, 0, "http://");
    if (viewer == VIEWER_POD) { w = emit_str(out, w, HUD_HOST_POD); }
    if (viewer == VIEWER_PANE) { w = emit_str(out, w, HUD_HOST_PANE); }
    w = emit_byte(out, w, 58);
    w = emit_dec(out, w, HUD_PORT as u64);
    w = emit_str(out, w, HUD_STEM);
    w = emit_byte(out, w, (48 + frame / 10) as u8);
    w = emit_byte(out, w, (48 + frame % 10) as u8);
    w = emit_str(out, w, HUD_EXT);
    return w;
}

// ---- 3. Published ports -------------------------------------------------------------------------

pub const POD_HTTP_PORT : u32 = 8080;
/// The host's CDP_BRIDGE_PORT (pod-driver.ts). If the host moves it, this moves with it.
pub const CDP_BRIDGE_PORT : u32 = 9223;
pub const PUBLISH_BIND : string = "127.0.0.1";
pub const DEV_POD_MOUNTS_PROFILE : bool = false;

// What dockerDriver does today (host facts above), each one against rule 3.
pub const DOCKER_DRIVER_PUBLISHES_CDP : bool = true;
pub const DOCKER_DRIVER_BINDS_8080_ALL_INTERFACES : bool = true;
pub const DOCKER_DRIVER_MOUNTS_PROFILE : bool = true;

/// A mux port the viewer may use: unprivileged, and neither the viewer nor the CDP port.
pub fn mux_ok(mux: u32) -> bool {
    if (mux < 1024 or mux > 65535) { return false; }
    return mux != POD_HTTP_PORT and mux != CDP_BRIDGE_PORT;
}

/// May a dev pod publish `port`, bound to the host loopback or not?
pub fn port_may_publish(port: u32, mux: u32, bind_loopback: bool) -> bool {
    if (bind_loopback == false) { return false; }
    if (port == CDP_BRIDGE_PORT) { return false; }
    if (port == POD_HTTP_PORT) { return true; }
    return port == mux and mux_ok(mux);
}

/// Can `tri dev` start its pod through dockerDriver as the driver stands today?
pub fn dev_pod_may_use_docker_driver() -> bool {
    if (DOCKER_DRIVER_PUBLISHES_CDP) { return false; }
    if (DOCKER_DRIVER_BINDS_8080_ALL_INTERFACES) { return false; }
    return DOCKER_DRIVER_MOUNTS_PROFILE == false;
}

// ---- 4. One pod per dev session -----------------------------------------------------------------

pub const POD_PREFIX : string = "browser-";
pub const POD_NAME_MAX : usize = 80;

pub const POD_START : u8 = 0;
pub const POD_REUSE : u8 = 1;
pub const POD_REFUSE : u8 = 2;

/// The pod name for a dev session, written into out; 0 when the session is not a safe name.
pub fn pod_name(session: string, out: []u8) -> usize {
    if (safe_name(session) == false) { return 0; }
    var w : usize = emit_str(out, 0, POD_PREFIX);
    w = emit_str(out, w, session);
    return w;
}

/// What a start does, given how many pods of this session are running.
pub fn pod_step(running_for_session: u32) -> u8 {
    if (running_for_session == 0) { return POD_START; }
    if (running_for_session == 1) { return POD_REUSE; }
    return POD_REFUSE;
}

// ---- 5. Health ----------------------------------------------------------------------------------

pub const HEALTH_DEADLINE_MS : u32 = 15000;
/// The host's measurement (pod-driver.ts, 2026-09-20): about 9.5 s to the first answer.
pub const POD_ANSWER_MEASURED_MS : u32 = 9500;

pub const H_UP : u8 = 0;
pub const H_STARTING : u8 = 1;
pub const H_WAITING_RESOURCE : u8 = 2;
pub const H_FAIL : u8 = 3;

/// The pod's health after elapsed_ms. FAIL only for a pod that did not start.
pub fn health(started: bool, answered: bool, elapsed_ms: u32) -> u8 {
    if (started == false) { return H_FAIL; }
    if (answered and elapsed_ms <= HEALTH_DEADLINE_MS) { return H_UP; }
    if (elapsed_ms >= HEALTH_DEADLINE_MS) { return H_WAITING_RESOURCE; }
    return H_STARTING;
}

/// The word a report prints for a health code.
pub fn health_word(h: u8) -> string {
    if (h == H_UP) { return "UP"; }
    if (h == H_STARTING) { return "STARTING"; }
    if (h == H_WAITING_RESOURCE) { return "WAITING_RESOURCE"; }
    return "FAIL";
}

/// Who shows the HUD right now: the pod only once it is chosen and UP, the pane otherwise.
pub fn viewer_now(docker_answers: bool, heavy_ok: bool, h: u8) -> u8 {
    if (viewer_for(docker_answers, heavy_ok) != VIEWER_POD) { return VIEWER_PANE; }
    if (h == H_UP) { return VIEWER_POD; }
    return VIEWER_PANE;
}

// ---- Tests --------------------------------------------------------------------------------------

test dev_view_pane_is_the_default {
    assert(VIEWER_DEFAULT == VIEWER_PANE);
    assert(viewer_for(false, false) == VIEWER_PANE);
    assert(viewer_for(true, true) == VIEWER_POD);
}

test dev_view_pod_needs_both_gates {
    // negative controls: one open gate is not enough
    assert(viewer_for(true, false) == VIEWER_PANE);
    assert(viewer_for(false, true) == VIEWER_PANE);
    assert(DEV_STARTS_DOCKER == false);
    assert(HEAVY_OK_IS_OWNER_ONLY);
}

test dev_view_pod_url_goes_through_the_docker_gateway {
    var out : [HUD_URL_MAX]u8 = [0] ** HUD_URL_MAX;
    var n : usize = hud_url(VIEWER_POD, 7, &out);
    assert(buf_is(&out, n, "http://host.docker.internal:8027/hud_07.png"));
    // negative control: the pod never gets the host loopback
    assert(buf_has(&out, n, "127.0.0.1") == false);
    assert(buf_has(&out, n, "localhost") == false);
    assert(loopback_reaches_mac(VIEWER_POD) == false);
    assert(POD_REACHES_GATEWAY_VERIFIED == false);
}

test dev_view_pane_url_stays_on_loopback {
    var out : [HUD_URL_MAX]u8 = [0] ** HUD_URL_MAX;
    var n : usize = hud_url(VIEWER_PANE, 27, &out);
    assert(buf_is(&out, n, "http://127.0.0.1:8027/hud_27.png"));
    assert(buf_has(&out, n, "host.docker.internal") == false);
    assert(loopback_reaches_mac(VIEWER_PANE));
    n = hud_url(VIEWER_PANE, 0, &out);
    assert(buf_is(&out, n, "http://127.0.0.1:8027/hud_00.png"));
}

test dev_view_hud_url_refuses_bad_input {
    var out : [HUD_URL_MAX]u8 = [0] ** HUD_URL_MAX;
    assert(hud_url(VIEWER_POD, 100, &out) == 0);
    assert(hud_url(VIEWER_NONE, 7, &out) == 0);
    assert(hud_url(VIEWER_PANE, HUD_FRAME_MAX, &out) > 0);
}

test dev_view_cdp_is_never_published {
    // negative controls: CDP is refused even on loopback and even as the mux port
    assert(port_may_publish(CDP_BRIDGE_PORT, 52000, true) == false);
    assert(port_may_publish(CDP_BRIDGE_PORT, CDP_BRIDGE_PORT, true) == false);
    assert(mux_ok(CDP_BRIDGE_PORT) == false);
    assert(port_may_publish(9222, 52000, true) == false);
    // the viewer and its mux are allowed, on loopback only
    assert(port_may_publish(POD_HTTP_PORT, 52000, true));
    assert(port_may_publish(52000, 52000, true));
    assert(port_may_publish(POD_HTTP_PORT, 52000, false) == false);
    assert(port_may_publish(52001, 52000, true) == false);
    assert(mux_ok(80) == false and mux_ok(POD_HTTP_PORT) == false and mux_ok(70000) == false);
}

test dev_view_docker_driver_breaks_rule_three_today {
    assert(dev_pod_may_use_docker_driver() == false);
    assert(DOCKER_DRIVER_PUBLISHES_CDP and DOCKER_DRIVER_MOUNTS_PROFILE);
    assert(DEV_POD_MOUNTS_PROFILE == false);
}

test dev_view_one_pod_per_session_named_browser_session {
    var out : [POD_NAME_MAX]u8 = [0] ** POD_NAME_MAX;
    var n : usize = pod_name("dev-13251", &out);
    assert(buf_is(&out, n, "browser-dev-13251"));
    var other : [POD_NAME_MAX]u8 = [0] ** POD_NAME_MAX;
    var m : usize = pod_name("dev-13252", &other);
    assert(buf_is(&other, m, "browser-dev-13251") == false);
    assert(pod_step(0) == POD_START);
    assert(pod_step(1) == POD_REUSE);
    // negative control: a second pod for the same session is refused, never added
    assert(pod_step(2) == POD_REFUSE);
    assert(pod_step(5) == POD_REFUSE);
}

test dev_view_pod_name_refuses_unsafe_sessions {
    var out : [POD_NAME_MAX]u8 = [0] ** POD_NAME_MAX;
    assert(pod_name("", &out) == 0);
    assert(pod_name("-x", &out) == 0);
    assert(pod_name("a b", &out) == 0);
    assert(pod_name("a/b", &out) == 0);
}

test dev_view_health_up_within_fifteen_seconds {
    assert(health(true, true, POD_ANSWER_MEASURED_MS) == H_UP);
    assert(health(true, true, HEALTH_DEADLINE_MS) == H_UP);
    assert(health(true, false, HEALTH_DEADLINE_MS - 1) == H_STARTING);
    assert(POD_ANSWER_MEASURED_MS < HEALTH_DEADLINE_MS);
}

test dev_view_health_timeout_is_waiting_resource_not_fail {
    assert(health(true, false, HEALTH_DEADLINE_MS) == H_WAITING_RESOURCE);
    assert(health(true, false, 60000) == H_WAITING_RESOURCE);
    assert(health(true, true, HEALTH_DEADLINE_MS + 1) == H_WAITING_RESOURCE);
    // negative control: a timeout is never FAIL; FAIL is a pod that did not start
    assert(health(true, false, 60000) != H_FAIL);
    assert(health(false, false, 0) == H_FAIL);
    assert(health_word(H_WAITING_RESOURCE) == "WAITING_RESOURCE");
    assert(health_word(H_FAIL) == "FAIL");
}

test dev_view_pane_shows_the_hud_until_the_pod_is_up {
    assert(viewer_now(true, true, H_UP) == VIEWER_POD);
    assert(viewer_now(true, true, H_STARTING) == VIEWER_PANE);
    assert(viewer_now(true, true, H_WAITING_RESOURCE) == VIEWER_PANE);
    assert(viewer_now(true, true, H_FAIL) == VIEWER_PANE);
    // negative control: an UP pod is not shown when a gate is closed
    assert(viewer_now(true, false, H_UP) == VIEWER_PANE);
    assert(viewer_now(false, true, H_UP) == VIEWER_PANE);
}

invariant dev_view_constants_hold {
    assert VIEWER_DEFAULT == VIEWER_PANE;
    assert POD_ANSWER_MEASURED_MS < HEALTH_DEADLINE_MS;
    assert HUD_PORT != POD_HTTP_PORT and CDP_BRIDGE_PORT != POD_HTTP_PORT;
}

// phi^2 + 1/phi^2 = 3 | TRINITY
