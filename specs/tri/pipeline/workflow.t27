// t27/specs/
// | | φ² + 1/φ² = 3 | TRINITY

module Workflow;
    use base::types;
    use math::constants;
    use tools::t27o::golden;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const WorkflowStep = struct {
        command : str,
        depends_on : [10]str,
        condition : str,
    };

    pub const Workflow = struct {
        version : str,
        steps : [5]WorkflowStep,
    };

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    pub fn workflow_step_new(command: str, depends_on: [10]str, condition: str) -> WorkflowStep {
        return WorkflowStep{
            .command = command,
            .depends_on = depends_on,
            .condition = condition,
        };
    }

    pub fn workflow_new(version: str, steps: [5]WorkflowStep) -> Workflow {
        return Workflow{
            .version = version,
            .steps = steps,
        };
    }

    pub fn workflow_step_get_command(step: WorkflowStep) -> str {
        return step.command;
    }

    pub fn workflow_get_version(workflow: Workflow) -> str {
        return workflow.version;
    }

    pub fn workflow_get_step_count(workflow: Workflow) -> i32 {
        return workflow.steps.len;
    }

    pub fn workflow_step_has_condition(step: WorkflowStep) -> bool {
        return step.condition.len > 0;
    }

    test "workflow_step_new_creates_step" {
        var dependencies: [10]str = undefined;
        dependencies[0] = "step1";
        dependencies[1] = "step2";
        
        const step = workflow_step_new("build", dependencies, "success");
        assert workflow_step_get_command(step) == "build";
        assert workflow_step_has_condition(step) == true;
    }

    test "workflow_new_creates_workflow" {
        var steps: [5]WorkflowStep = undefined;
        var deps: [10]str = undefined;
        deps[0] = "setup";
        
        steps[0] = workflow_step_new("setup", deps, "");
        
        const workflow = workflow_new("1.0.0", steps);
        assert workflow_get_version(workflow) == "1.0.0";
        assert workflow_get_step_count(workflow) == 5;
    }

    test "workflow_step_without_condition" {
        var dependencies: [10]str = undefined;
        
        const step = workflow_step_new("clean", dependencies, "");
        assert workflow_step_get_command(step) == "clean";
        assert workflow_step_has_condition(step) == false;
    }

    // ═══════════════════════════════════════════════════════════
    // Scan reports (issue #8997)
    // ═══════════════════════════════════════════════════════════
    // The scan mode of the t27o workflow emits one report per spec it evaluated
    // in a run; the Trinity App collects those reports through the workflow_run
    // webhook and renders them as the run's report and its golden coverage
    // badge. The report model lives here because this is the shape of the data
    // the pipeline hands the app. What makes a report golden is decided by the
    // golden criteria (specs/tools/t27o/golden.t27); this file only ever calls
    // them, never restates them (#8963).

    pub const ScanReport = struct {
        spec : str,
        mode : str,
        vectors_recorded : u32,
        vectors_passed : u32,
        tests_recorded : u32,
        tests_passed : u32,
        duplicates : u32,
        sealed : bool,
        attested : bool,
        attestation_run : u64,
        producing_run : u64,
    };

    // An empty report: the spec was listed for the run, but the scan has
    // recorded nothing for it yet.
    pub fn scan_report_new(spec: str, mode: str) -> ScanReport {
        return ScanReport{
            .spec = spec,
            .mode = mode,
            .vectors_recorded = 0,
            .vectors_passed = 0,
            .tests_recorded = 0,
            .tests_passed = 0,
            .duplicates = 0,
            .sealed = false,
            .attested = false,
            .attestation_run = 0,
            .producing_run = 0,
        };
    }

    // A recorded report: what the oracle measured for one spec in one run.
    pub fn scan_report_recorded(spec: str, mode: str, vectors_recorded: u32, vectors_passed: u32, tests_recorded: u32, tests_passed: u32, duplicates: u32, sealed: bool, attested: bool, attestation_run: u64, producing_run: u64) -> ScanReport {
        return ScanReport{
            .spec = spec,
            .mode = mode,
            .vectors_recorded = vectors_recorded,
            .vectors_passed = vectors_passed,
            .tests_recorded = tests_recorded,
            .tests_passed = tests_passed,
            .duplicates = duplicates,
            .sealed = sealed,
            .attested = attested,
            .attestation_run = attestation_run,
            .producing_run = producing_run,
        };
    }

    // The golden verdict for one report, asked from the criteria.
    pub fn scan_report_refusal(report: ScanReport) -> u32 {
        return golden::refusal(report.vectors_recorded, report.vectors_passed, report.tests_recorded, report.tests_passed, report.duplicates, report.sealed, report.attested, report.attestation_run, report.producing_run);
    }

    pub fn scan_report_verdict(report: ScanReport) -> str {
        return golden::refusal_name(scan_report_refusal(report));
    }

    pub fn scan_report_is_golden(report: ScanReport) -> bool {
        return golden::is_golden(report.vectors_recorded, report.vectors_passed, report.tests_recorded, report.tests_passed, report.duplicates, report.sealed, report.attested, report.attestation_run, report.producing_run);
    }

    // A report shaped like one that meets every golden criterion.
    pub fn scan_report_golden_like(spec: str, mode: str, run: u64) -> ScanReport {
        return scan_report_recorded(spec, mode, 12, 12, 3, 3, 0, true, true, run, run);
    }

    // A report shaped like one that has not met any criterion yet.
    pub fn scan_report_unmet_like(spec: str, mode: str) -> ScanReport {
        return scan_report_new(spec, mode);
    }

    // How many of the evaluated specs of one run are golden. A run's ledger
    // holds up to 8 reports; evaluated says how many slots carry this run's
    // reports, and only those slots are read.
    pub fn scan_reports_golden_count(reports: [8]ScanReport, evaluated: u32) -> u32 {
        var count: u32 = 0;
        var i: u32 = 0;
        while (i < evaluated) {
            if (scan_report_is_golden(reports[i])) { count += 1; }
            i += 1;
        }
        return count;
    }

    // The badge the app renders for the run: the floored percentage the
    // criteria define -- 5 of 8 evaluated reads 62, never 63; with nothing
    // evaluated the badge reads 0.
    pub fn scan_reports_badge(reports: [8]ScanReport, evaluated: u32) -> u32 {
        return golden::coverage_percent(scan_reports_golden_count(reports, evaluated), evaluated);
    }

    test "scan_report_recorded_carries_the_oracle_evidence" {
        const report = scan_report_recorded("specs/tools/mcp/trinity.t27", "golden", 12, 12, 3, 3, 0, true, true, 918273645011, 918273645011);
        assert report.spec == "specs/tools/mcp/trinity.t27";
        assert report.mode == "golden";
        assert report.vectors_recorded == 12;
        assert report.vectors_passed == 12;
        assert report.tests_recorded == 3;
        assert report.tests_passed == 3;
        assert report.duplicates == 0;
        assert report.sealed == true;
        assert report.attested == true;
        assert report.attestation_run == 918273645011;
        assert report.producing_run == 918273645011;
        assert scan_report_refusal(report) == golden::R_NONE;
        assert scan_report_verdict(report) == "golden";
        assert scan_report_is_golden(report) == true;
    }

    test "scan_report_without_evidence_refuses_as_no_evidence" {
        const report = scan_report_new("specs/tools/mcp/trinity.t27", "scan");
        assert report.vectors_recorded == 0;
        assert report.attested == false;
        assert scan_report_refusal(report) == golden::R_NO_EVIDENCE;
        assert scan_report_verdict(report) == "no recorded vector or translated test";
        assert scan_report_is_golden(report) == false;
    }

    test "scan_reports_badge_is_the_floored_percentage" {
        var reports: [8]ScanReport = undefined;
        reports[0] = scan_report_golden_like("specs/a.t27", "scan", 1001);
        reports[1] = scan_report_unmet_like("specs/b.t27", "scan");
        reports[2] = scan_report_golden_like("specs/c.t27", "scan", 1001);
        reports[3] = scan_report_unmet_like("specs/d.t27", "scan");
        reports[4] = scan_report_golden_like("specs/e.t27", "scan", 1001);
        reports[5] = scan_report_unmet_like("specs/f.t27", "scan");
        reports[6] = scan_report_golden_like("specs/g.t27", "scan", 1001);
        reports[7] = scan_report_golden_like("specs/h.t27", "scan", 1001);
        assert scan_reports_golden_count(reports, 8) == 5;
        assert scan_reports_badge(reports, 8) == 62;
    }

    test "scan_reports_badge_is_zero_without_reports" {
        var reports: [8]ScanReport = undefined;
        assert scan_reports_badge(reports, 0) == 0;
    }

    test "scan_reports_badge_reads_only_this_runs_slots" {
        var reports: [8]ScanReport = undefined;
        reports[0] = scan_report_golden_like("specs/a.t27", "scan", 1001);
        assert scan_reports_golden_count(reports, 1) == 1;
        assert scan_reports_badge(reports, 1) == 100;
    }

    test "scan_reports_badge_is_perfect_when_every_evaluated_spec_is_golden" {
        var reports: [8]ScanReport = undefined;
        var i: u32 = 0;
        while (i < 8) {
            reports[i] = scan_report_golden_like("specs/a.t27", "scan", 1001);
            i += 1;
        }
        assert scan_reports_golden_count(reports, 8) == 8;
        assert scan_reports_badge(reports, 8) == 100;
    }

    test "scan_reports_badge_floors_when_the_division_is_not_exact" {
        var reports: [8]ScanReport = undefined;
        reports[0] = scan_report_golden_like("specs/a.t27", "scan", 1001);
        reports[1] = scan_report_golden_like("specs/b.t27", "scan", 1001);
        reports[2] = scan_report_unmet_like("specs/c.t27", "scan");
        assert scan_reports_badge(reports, 3) == 66;
        assert scan_reports_badge(reports, 3) != 67;
    }

