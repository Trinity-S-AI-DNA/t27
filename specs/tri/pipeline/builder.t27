// t27/specs/
// O(1) amortized append | φ² + 1/φ² = 3 | TRINITY

module TriBuilder;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // A Builder appends u32 items into storage the caller owns: there is no allocator and no
    // generic parameter in this dialect, so capacity is the length of the storage slice and an
    // append past it is refused instead of growing.
    pub const Builder = struct {
        items : []u32,
        capacity : usize,
        len : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(storage) -> Builder: an empty builder over storage, capacity = storage.len
    fn init(storage: []u32) -> Builder {
        return Builder{
            items = storage,
            capacity = storage.len,
            len = 0,
        };
    }

    // empty() -> Builder: a builder with no storage, capacity 0
    fn empty() -> Builder {
        return Builder{
            items = @constCast(&[_]u32{}),
            capacity = 0,
            len = 0,
        };
    }

    // append(builder, item) -> bool: true when the item was stored, false when the builder is full
    fn append(builder: *Builder, item: u32) -> bool {
        if (builder.len >= builder.capacity) {
            return false;
        }
        builder.items[builder.len] = item;
        builder.len = builder.len + 1;
        return true;
    }

    // append_slice(builder, slice) -> bool: true when all of slice was stored, false (nothing stored)
    // when it does not fit
    fn append_slice(builder: *Builder, slice: []const u32) -> bool {
        const required_capacity = builder.len + slice.len;
        if (required_capacity > builder.capacity) {
            return false;
        }
        var i : usize = 0;
        while (i < slice.len) {
            builder.items[builder.len + i] = slice[i];
            i = i + 1;
        }
        builder.len = required_capacity;
        return true;
    }

    // len(builder) -> usize
    fn len(builder: Builder) -> usize {
        return builder.len;
    }

    // capacity(builder) -> usize
    fn capacity(builder: Builder) -> usize {
        return builder.capacity;
    }

    // finish(builder) -> []u32: the items appended so far
    fn finish(builder: Builder) -> []u32 {
        return builder.items[0..builder.len];
    }

    // reset(builder) -> void: forget the items, keep the capacity
    fn reset(builder: *Builder) -> void {
        builder.len = 0;
    }

    pub fn default_input() -> Builder(T) {
        return empty();
    
    pub fn default_input() -> Builder(T) {\n        return empty();\n    }
    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "init_creates_builder_with_capacity" {
        var storage : [10]u32 = [0] ** 10;
        const builder = init(&storage);
        assert(builder.capacity == 10);
        assert(builder.len == 0);
    }

    test "empty_creates_zero_capacity_builder" {
        const builder = empty();
        assert(builder.capacity == 0);
        assert(builder.len == 0);
        // (was `@as([]T, &.{})` compared with `items`; a slice type in `@as`
        // is lost by every backend, #5968. Empty means a length of zero.)
        assert(builder.items.len == 0);
    }

    test "append_adds_item_to_builder" {
        var storage : [4]u32 = [0] ** 4;
        var builder = init(&storage);
        const item : u32 = 42;
        assert(append(&builder, item));
        assert(builder.len == 1);
        assert(builder.items[0] == item);
    }

    test "append_slice_adds_multiple_items" {
        var storage : [8]u32 = [0] ** 8;
        var builder = init(&storage);
        var values : [3]u32 = [1, 2, 3];
        assert(append_slice(&builder, &values));
        assert(builder.len == 3);
        assert(builder.items[0] == 1);
        assert(builder.items[1] == 2);
        assert(builder.items[2] == 3);
    }

    test "len_returns_current_length" {
        var storage : [4]u32 = [0] ** 4;
        var builder = init(&storage);
        assert(len(builder) == 0);
        assert(append(&builder, 1));
        assert(len(builder) == 1);
        assert(append(&builder, 2));
        assert(len(builder) == 2);
    }

    test "capacity_returns_current_capacity" {
        var storage : [8]u32 = [0] ** 8;
        const builder = init(&storage);
        assert(capacity(builder) == 8);
    }

    test "finish_returns_slice_with_items" {
        var storage : [4]u32 = [0] ** 4;
        var builder = init(&storage);
        assert(append(&builder, 1));
        assert(append(&builder, 2));
        const result = finish(builder);
        assert(result.len == 2);
        assert(result[0] == 1);
        assert(result[1] == 2);
    }

    test "reset_clears_builder_length" {
        var storage : [4]u32 = [0] ** 4;
        var builder = init(&storage);
        assert(append(&builder, 1));
        assert(append(&builder, 2));
        reset(&builder);
        assert(builder.len == 0);
        assert(builder.capacity == 4);
    }

    test "append_refused_when_full" {
        var storage : [2]u32 = [0] ** 2;
        var builder = init(&storage);
        assert(append(&builder, 7));
        assert(append(&builder, 8));
        assert(!append(&builder, 9));
        assert(builder.len == 2);
        var values : [1]u32 = [5];
        assert(!append_slice(&builder, &values));
        assert(builder.len == 2);
    }
