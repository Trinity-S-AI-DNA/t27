// t27/specs/
// O(1) amortized append | φ² + 1/φ² = 3 | TRINITY

module TriBuilder;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Builder(T) = struct {
        items : []T,
        capacity : usize,
        len : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn empty(initial_capacity: usize) -> Builder(T) {
        return {
            items: [],
            capacity: initial_capacity,
            len: 0,
        };
    }

    fn append(builder: *Builder(T), item: T) {
        if (builder.len >= builder.capacity) {
            builder.capacity = builder.capacity == 0 ? 8 : builder.capacity * 2;
            builder.items = resize(builder.items, builder.capacity);
        }
        builder.items[builder.len] = item;
        builder.len += 1;
    }

    fn append_slice(builder: *Builder(T), slice: []T) {
        for (item in slice) {
            append(builder, item);
        }
    }

    fn len(builder: Builder(T)) -> usize {
        return builder.len;
    }

    fn capacity(builder: Builder(T)) -> usize {
        return builder.capacity;
    }

    fn finish(builder: Builder(T)) -> []T {
        return slice(builder.items, 0, builder.len);
    }

    fn reset(builder: *Builder(T)) {
        builder.len = 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test builder_basic_flow {
        var b = empty(2);
        append(&b, 10);
        append(&b, 20);
        append(&b, 30); // Trigger resize
        
        assert len(b) == 3;
        assert capacity(b) >= 3;
        assert finish(b) == [10, 20, 30];
    }

    test builder_zero_cap {
        var b = empty(0);
        append(&b, 1);
        assert len(b) == 1;
        assert capacity(b) == 8;
        assert finish(b) == [1];
    }

    test builder_slice_append {
        var b = empty(0);
        append_slice(&b, [1, 2, 3]);
        assert len(b) == 3;
        assert finish(b) == [1, 2, 3];
    }

    test builder_reset {
        var b = empty(4);
        append(&b, 1);
        reset(&b);
        assert len(b) == 0;
        append(&b, 2);
        assert finish(b) == [2];
    }
}
