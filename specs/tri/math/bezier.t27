// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// De Casteljau algorithm for stable evaluation | φ² + 1/φ² = 3 | TRINITY

module TriBezier;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Point = struct {
        x : f64,
        y : f64,
    };

    pub const BezierCurve = struct {
        control : []Point,
        degree : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // evaluate(curve: *const BezierCurve, t: f64) → Point
    fn evaluate(curve: *const BezierCurve, t: f64) -> Point {
        if (curve.degree == 0) {
            return curve.control[0];
        }
        
        var points = curve.control;
        let n = curve.degree;
        
        var level: usize = 0;
        while (level < n) {
            var new_points: [100]Point = undefined; // Max size for reasonable curves
            var new_count: usize = 0;
            
            var i: usize = 0;
            while (i < n - level) {
                let p0 = points[i];
                let p1 = points[i + 1];
                let new_x = (1.0 - t) * p0.x + t * p1.x;
                let new_y = (1.0 - t) * p0.y + t * p1.y;
                new_points[new_count] = Point{ .x = new_x, .y = new_y };
                new_count += 1;
                i += 1;
            }
            
            // Copy back to slice
            points = new_points[0..new_count];
            level += 1;
        }
        
        return points[0];
    }

    // derivative(curve: *const BezierCurve) → BezierCurve
    fn derivative(curve: *const BezierCurve) -> BezierCurve {
        if (curve.degree == 0) {
            var zero_point: [1]Point = [Point{ .x = 0.0, .y = 0.0 }];
            return BezierCurve{ .control = zero_point[0..1], .degree = 0 };
        }
        
        let n = curve.degree;
        var new_control: [100]Point = undefined;
        var new_count: usize = 0;
        
        var i: usize = 0;
        while (i < n) {
            let dx = curve.control[i + 1].x - curve.control[i].x;
            let dy = curve.control[i + 1].y - curve.control[i].y;
            let scaled_x = @as(f64, n) * dx;
            let scaled_y = @as(f64, n) * dy;
            new_control[new_count] = Point{ .x = scaled_x, .y = scaled_y };
            new_count += 1;
            i += 1;
        }
        
        return BezierCurve{ .control = new_control[0..new_count], .degree = n - 1 };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test degree_one_curve_has_two_control_points
        var points: [2]Point = [Point{.x=0.0,.y=0.0}, Point{.x=4.0,.y=2.0}];
        given curve = BezierCurve{.control=points[0..2],.degree=1}
        then curve.control.len == 2 and curve.control.len == curve.degree + 1

    test curve_endpoints_are_its_first_and_last_control_points
        var points: [3]Point = [Point{.x=0.0,.y=0.0}, Point{.x=1.0,.y=2.0}, Point{.x=2.0,.y=0.0}];
        given curve = BezierCurve{.control=points[0..3],.degree=2}
        and first = curve.control[0]
        and last = curve.control[curve.degree]
        then @abs(last.x - 2.0) < 1e-12 and first.x < last.x

    test linear_curve_midpoint_is_the_average_of_its_control_points
        given p0 = Point{.x=0.0,.y=0.0}
        and p1 = Point{.x=4.0,.y=2.0}
        and mid_x = (p0.x + p1.x) / 2.0
        and mid_y = (p0.y + p1.y) / 2.0
        and x_ok = @abs(mid_x - 2.0) < 1e-12
        and y_ok = @abs(mid_y - 1.0) < 1e-12
        then x_ok and y_ok

    test evaluate_at_t_zero_returns_first_control_point
        var points: [3]Point = [Point{.x=0.0,.y=0.0}, Point{.x=1.0,.y=2.0}, Point{.x=2.0,.y=0.0}];
        given curve = BezierCurve{.control=points[0..3],.degree=2}
        and result = evaluate(curve, 0.0)
        then @abs(result.x - curve.control[0].x) < 1e-12 and @abs(result.y - curve.control[0].y) < 1e-12

    test evaluate_at_t_one_returns_last_control_point
        var points: [3]Point = [Point{.x=0.0,.y=0.0}, Point{.x=1.0,.y=2.0}, Point{.x=2.0,.y=0.0}];
        given curve = BezierCurve{.control=points[0..3],.degree=2}
        and result = evaluate(curve, 1.0)
        then @abs(result.x - curve.control[curve.degree].x) < 1e-12 and @abs(result.y - curve.control[curve.degree].y) < 1e-12

    test derivative_of_degree_one_curve_has_one_control_point
        var points: [2]Point = [Point{.x=0.0,.y=0.0}, Point{.x=4.0,.y=2.0}];
        given curve = BezierCurve{.control=points[0..2],.degree=1}
        and derivative_curve = derivative(curve)
        then derivative_curve.degree == 0 and derivative_curve.control.len == 1
        and @abs(derivative_curve.control[0].x - (4.0 - 0.0)) < 1e-12
        and @abs(derivative_curve.control[0].y - (2.0 - 0.0)) < 1e-12

    test evaluate_basic_case
        given input = default_input()
        when result = evaluate(input, 0.5)
        then @abs(result.x - 0.5) < 1e-12 and @abs(result.y - 0.5) < 1e-12

    test derivative_basic_case
        given input = default_input()
        when result = derivative(input)
        then result.degree == 0 and @abs(result.control[0].x - 1.0) < 1e-12 and @abs(result.control[0].y - 1.0) < 1e-12

    // Helper function for tests
    fn default_input() -> BezierCurve {
        var points: [2]Point = [Point{.x=0.0,.y=0.0}, Point{.x=1.0,.y=1.0}];
        return BezierCurve{.control=points[0..2],.degree=1}
    }
