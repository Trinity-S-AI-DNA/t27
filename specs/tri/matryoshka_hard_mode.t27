// SPDX-License-Identifier: Apache-2.0
// specs/tri/matryoshka_hard_mode.t27 -- Matryoshka hard mode: one thread =
// one issue, DSH codes only in T27OS (tracking).
// Part of M8 milestone (milestone #12). Closes #13020.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::matryoshka_hard_mode;

pub const MATRYOSHKA_HARD_MODE_MAX_THREADS : u32 = 1;

pub struct ThreadIssueMapping { thread_id: str, issue_id: str };

pub fn thread_issue_mapping_valid(m: ThreadIssueMapping) -> bool {
    return m.thread_id != "" && m.issue_id != "";
}

test "thread_issue_mapping_valid" {
    assert(thread_issue_mapping_valid(ThreadIssueMapping { thread_id: "t1", issue_id: "#13020" }));
    assert(!thread_issue_mapping_valid(ThreadIssueMapping { thread_id: "", issue_id: "#13020" }));
}

invariant matryoshka_hard_mode_max_threads_positive {
    assert MATRYOSHKA_HARD_MODE_MAX_THREADS > 0;
}