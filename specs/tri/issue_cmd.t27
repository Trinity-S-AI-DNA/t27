// SPDX-License-Identifier: Apache-2.0
; specs/tri/issue_cmd.t27 -- the issue core for `tri issue create <title> <desc>`.
; `tri issue` is a group; its `create` verb validates a title and would open a GitHub issue.
; The command (cli/tri/src/main.rs) parses the verb and args, prints, and exits; every rule
; below is decided here and tested.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriIssueCmd;

pub const CMD: str = "issue";
pub const CREATE: str = "create";

/// Whether a title is acceptable to file: non-empty. Returns 0 ok, 1 empty.
pub fn title_ok(title: string) -> u8 {
    if (title.len() == 0) { return 1; }
    return 0;
}

invariant create_verb_and_title_rule { assert title_ok("fix the thing") == 0 and title_ok("") == 1; }

test title_ok_accepts_non_empty {
    assert(title_ok("tri: sync failed") == 0);
    assert(title_ok("x") == 0);
}

test title_ok_refuses_empty {
    assert(title_ok("") == 1);
    assert(title_ok("   ") == 0);
}

// bench: validating one title is constant work.
bench title_ok_is_constant_work {
    assert(title_ok("a very long title that should still validate in constant time") == 0);
}
