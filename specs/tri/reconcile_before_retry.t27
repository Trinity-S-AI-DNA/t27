// specs/tri/reconcile_before_retry.t27 -- spec: reconcile-before-retry and
// avoidance list for DSH tasks.
// Part of M8 milestone (milestone #12). Closes #13027.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::reconcile_before_retry;

pub const RECONCILE_BEFORE_RETRY_MAX_ATTEMPTS : u32 = 3;

pub struct RetryTask { retries: u32, reconciled: bool };

pub fn retry_task_should_retry(t: RetryTask) -> bool {
    return t.reconciled && t.retries < RECONCILE_BEFORE_RETRY_MAX_ATTEMPTS;
}

test "retry_task_should_retry" {
    assert(retry_task_should_retry(RetryTask { retries: 1, reconciled: true }));
    assert(!retry_task_should_retry(RetryTask { retries: 0, reconciled: false }));
    assert(!retry_task_should_retry(RetryTask { retries: 3, reconciled: true }));
}

invariant reconcile_before_retry_max_attempts_positive {
    assert RECONCILE_BEFORE_RETRY_MAX_ATTEMPTS > 0;
}