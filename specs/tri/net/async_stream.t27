// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Lazy evaluation | φ² + 1/φ² = 3 | TRINITY

module TriAsyncStream;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // t27 has no allocator and no function values, so a stream is a plain value:
    // a copy of up to ST_CAP source items, a read position and a short pipeline of
    // at most ST_STAGES stages. A stage is a data description of the function
    // (a MapOp or a Pred plus one i32 argument) instead of a closure. Nothing is
    // evaluated when a stage is added; items are computed one by one by next().
    pub const ST_CAP : usize = 32;
    pub const ST_STAGES : usize = 4;

    // Ready: nothing pulled yet. Pending: items were pulled and more may follow.
    // Done: the source is exhausted (or the pipeline was over-full).
    pub const StreamState = enum(u8) {
        Ready,
        Pending,
        Done,
    };

    // Map functions: Add -> x + arg, Mul -> x * arg, Neg -> -x.
    pub const MapOp = enum(u8) {
        Add,
        Mul,
        Neg,
    };

    // Predicates: IsEven, IsOdd, Greater -> x > arg, AtMost -> x <= arg.
    pub const Pred = enum(u8) {
        IsEven,
        IsOdd,
        Greater,
        AtMost,
    };

    pub const Stage = struct {
        is_filter : bool,
        map_op : MapOp,
        pred : Pred,
        arg : i32,
    };

    pub const Stream = struct {
        items : [ST_CAP]i32,
        len : usize,
        pos : usize,
        stages : [ST_STAGES]Stage,
        nstages : usize,
        state : StreamState,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // from(items: []const i32) → Stream : a Ready stream over a copy of the items
    // (only the first ST_CAP are kept)
    fn from(items: []const i32) -> Stream {
        var stream : Stream = undefined;
        stream.len = items.len;
        if (stream.len > ST_CAP) {
            stream.len = ST_CAP;
        }
        var i : usize = 0;
        while (i < stream.len) {
            stream.items[i] = items[i];
            i = i + 1;
        }
        stream.pos = 0;
        stream.nstages = 0;
        stream.state = StreamState.Ready;
        return stream;
    }

    // push_stage(stream, stage) → Stream : the stream with one more stage; a stream
    // whose pipeline is full is closed (Done) instead
    fn push_stage(stream: Stream, stage: Stage) -> Stream {
        var out = stream;
        if (out.nstages >= ST_STAGES) {
            out.state = StreamState.Done;
            return out;
        }
        out.stages[out.nstages] = stage;
        out.nstages = out.nstages + 1;
        return out;
    }

    // map(stream: Stream, op: MapOp, arg: i32) → Stream : lazily apply op to each item
    fn map(stream: Stream, op: MapOp, arg: i32) -> Stream {
        return push_stage(stream, Stage {
            is_filter = false,
            map_op = op,
            pred = Pred.IsEven,
            arg = arg,
        });
    }

    // filter(stream: Stream, predicate: Pred, arg: i32) → Stream : lazily keep items matching predicate
    fn filter(stream: Stream, predicate: Pred, arg: i32) -> Stream {
        return push_stage(stream, Stage {
            is_filter = true,
            map_op = MapOp.Add,
            pred = predicate,
            arg = arg,
        });
    }

    fn apply_map(op: MapOp, arg: i32, x: i32) -> i32 {
        if (op == MapOp.Add) {
            return x + arg;
        }
        if (op == MapOp.Mul) {
            return x * arg;
        }
        return 0 - x;
    }

    fn holds(p: Pred, arg: i32, x: i32) -> bool {
        if (p == Pred.IsEven) {
            return @rem(x, 2) == 0;
        }
        if (p == Pred.IsOdd) {
            return @rem(x, 2) != 0;
        }
        if (p == Pred.Greater) {
            return x > arg;
        }
        return x <= arg;
    }

    // next(stream: *Stream) → ?i32 : pull the next item through the pipeline, null when exhausted
    fn next(stream: *Stream) -> ?i32 {
        while (stream.state != StreamState.Done and stream.pos < stream.len) {
            var v = stream.items[stream.pos];
            stream.pos = stream.pos + 1;
            var keep = true;
            var s : usize = 0;
            while (s < stream.nstages and keep) {
                const st = stream.stages[s];
                if (st.is_filter) {
                    keep = holds(st.pred, st.arg, v);
                } else {
                    v = apply_map(st.map_op, st.arg, v);
                }
                s = s + 1;
            }
            if (keep) {
                stream.state = StreamState.Pending;
                return v;
            }
        }
        stream.state = StreamState.Done;
        return null;
    }

    // drain(stream: *Stream, out: []i32) → usize : pull items into out until it is full or the stream ends
    fn drain(stream: *Stream, out: []i32) -> usize {
        var n : usize = 0;
        while (n < out.len) {
            const item = next(stream);
            if (item == null) {
                return n;
            }
            out[n] = item.?;
            n = n + 1;
        }
        return n;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test from_basic_case {
        const stream = from(&[_]i32{ 1, 2, 3 });
        assert(stream.state == StreamState.Ready);
        assert(stream.len == 3);
        assert(stream.nstages == 0);
    }

    test from_generates_items {
        var stream = from(&[_]i32{ 1, 2, 3 });
        const item1 = next(&stream);
        const item2 = next(&stream);
        const item3 = next(&stream);
        const item4 = next(&stream);
        assert(item1.? == 1);
        assert(item2.? == 2);
        assert(item3.? == 3);
        assert(item4 == null);
        assert(stream.state == StreamState.Done);
    }

    test states_move_from_ready_through_pending_to_done {
        var stream = from(&[_]i32{ 7, 8 });
        assert(stream.state == StreamState.Ready);
        assert(next(&stream).? == 7);
        assert(stream.state == StreamState.Pending);
        assert(next(&stream).? == 8);
        assert(stream.state == StreamState.Pending);
        assert(next(&stream) == null);
        assert(stream.state == StreamState.Done);
        // A finished stream stays finished.
        assert(next(&stream) == null);
    }

    test map_is_lazy_and_applies_per_item {
        const base = from(&[_]i32{ 1, 2, 3 });
        var stream = map(base, MapOp.Mul, 10);
        // Adding the stage pulled nothing.
        assert(stream.pos == 0);
        assert(stream.state == StreamState.Ready);
        assert(next(&stream).? == 10);
        assert(stream.pos == 1);
        assert(next(&stream).? == 20);
        assert(next(&stream).? == 30);
        assert(next(&stream) == null);
    }

    test filter_keeps_only_matching_items {
        var evens = filter(from(&[_]i32{ 1, 2, 3, 4, 5, 6 }), Pred.IsEven, 0);
        var buf : [8]i32 = undefined;
        const n = drain(&evens, &buf);
        assert(n == 3);
        assert(buf[0] == 2);
        assert(buf[1] == 4);
        assert(buf[2] == 6);
    }

    test filter_with_a_predicate_nothing_satisfies_yields_nothing {
        var stream = filter(from(&[_]i32{ 1, 2, 3 }), Pred.Greater, 100);
        assert(next(&stream) == null);
        assert(stream.state == StreamState.Done);
    }

    test stages_run_in_the_order_they_were_added {
        // Add 1 first, then keep the evens: 1,2,3,4 -> 2,3,4,5 -> 2,4.
        var a = filter(map(from(&[_]i32{ 1, 2, 3, 4 }), MapOp.Add, 1), Pred.IsEven, 0);
        var buf : [8]i32 = undefined;
        assert(drain(&a, &buf) == 2);
        assert(buf[0] == 2);
        assert(buf[1] == 4);
        // Keep the evens first, then add 1: 1,2,3,4 -> 2,4 -> 3,5.
        var b = map(filter(from(&[_]i32{ 1, 2, 3, 4 }), Pred.IsEven, 0), MapOp.Add, 1);
        assert(drain(&b, &buf) == 2);
        assert(buf[0] == 3);
        assert(buf[1] == 5);
    }

    test negation_and_remaining_predicates {
        var s = filter(map(from(&[_]i32{ 1, -2, 3, -4 }), MapOp.Neg, 0), Pred.AtMost, 2);
        var buf : [8]i32 = undefined;
        // Negated: -1, 2, -3, 4; at most 2: -1, 2, -3.
        assert(drain(&s, &buf) == 3);
        assert(buf[0] == -1);
        assert(buf[1] == 2);
        assert(buf[2] == -3);
        var odd = filter(from(&[_]i32{ 1, 2, 3, 4, 5 }), Pred.IsOdd, 0);
        assert(drain(&odd, &buf) == 3);
        assert(buf[2] == 5);
    }

    test drain_stops_when_the_output_is_full {
        var stream = from(&[_]i32{ 1, 2, 3, 4, 5 });
        var small : [2]i32 = undefined;
        assert(drain(&stream, &small) == 2);
        assert(small[1] == 2);
        // The rest is still there.
        assert(next(&stream).? == 3);
    }

    test the_source_is_copied_and_capped {
        var items : [40]i32 = undefined;
        var i : usize = 0;
        while (i < 40) {
            items[i] = @as(i32, @intCast(i));
            i = i + 1;
        }
        var stream = from(&items);
        assert(stream.len == ST_CAP);
        // Changing the caller's array afterwards does not reach the stream.
        items[0] = 99;
        assert(next(&stream).? == 0);
    }

    test a_full_pipeline_closes_the_stream {
        var s = from(&[_]i32{ 1, 2, 3 });
        var k : usize = 0;
        while (k < ST_STAGES) {
            s = map(s, MapOp.Add, 1);
            k = k + 1;
        }
        assert(s.nstages == ST_STAGES);
        assert(s.state == StreamState.Ready);
        assert(next(&s).? == 5);
        var t = from(&[_]i32{ 1, 2, 3 });
        k = 0;
        while (k <= ST_STAGES) {
            t = map(t, MapOp.Add, 1);
            k = k + 1;
        }
        assert(t.state == StreamState.Done);
        assert(next(&t) == null);
    }
