; async.t27 — a channel-based worker pool of actors, with async/await as algebraic effect operations.
; Issue t27#9003. The Rust sketch under discussion:

;     const WORKERS: usize = 3;
;     fn main() {
;         let (job_tx, job_rx) = mpsc::channel();
;         for _ in 0..WORKERS { thread::spawn(move || worker(job_rx.clone(), result_tx.clone())); }
;         for job in 0..JOBS { job_tx.send(job).unwrap(); }
;         drop(job_tx);
;         let mut results = Vec::new();
;         for _ in 0..JOBS { results.push(result_rx.recv().unwrap()); }
;         results.sort();
;     }
;     fn worker(rx: Receiver<u64>, tx: Sender<u64>) {
;         loop { match rx.recv() { Ok(job) => tx.send(job * job).unwrap(), Err(_) => break } }
;     }
; The sketch spends OS threads on the workers and blocks OS threads on recv. This spec says the same
; thing four other ways, and checks all four:
; - FR-001 The pool is actors, not threads. A worker is a pc slot in one packed word (actors.t27 is the
;   model), the channels are mailboxes, and spawn is claiming a slot. Nothing here owns an OS thread.
; - FR-002 async/await lowers to effect operations. A worker's body runs from one await to the next and
;   then requests one operation - SEND, RECV, CLOSE or YIELD - and stops. The pc register is the
;   continuation: the scheduler resumes the body there when the operation is handled. await recv is
;   OP_RECV that suspends the actor when the channel is empty; await send is OP_SEND that delivers or
;   parks; yield_now is OP_YIELD.
; - FR-003 A deterministic scheduler handles the operations. One seeded xorshift stream picks which
;   ready actor runs next, so a seed names one full interleaving of the pool, and the same seed always
;   replays the same run. Handlers themselves are fixed policies: the lowest pid waits first, a send
;   that finds a suspended receiver hands the value over directly.
; - FR-004 The run is checked against an oracle across 100 seeds. A result is a pure function of its
;   job (the square), the dispatcher must collect all eight, and every seed must end with the sorted
;   multiset of results equal to the oracle's, both channels drained, and every actor done.
; Structured concurrency, instead of threads: pool_run is the scope. It returns only after every actor
; it spawned has finished, and nothing outlives it - the mailboxes, the pc slots and the registers are
; all locals of the run.
; Executable-subset notes, measured on this compiler (see actors.t27 for the same lessons): no
; user-defined generics and no arrays - both break gen-zig, so a spec that carries them cannot run its
; tests. Everything is scalars, bools and u64 bit-packing, with typed locals wherever a shift can
; reach past bit 32.

; --- 1. The pool's shape ---------------------------------------------------------------------------
; Three workers, eight jobs, one dispatcher that owns the scope. The Rust sketch spawns WORKERS
; threads; here the same three actors are pc slots 1..3, and the dispatcher - the scope itself - is
; slot 0. ACTORS counts both.

pub const WORKERS : u64 = 3;
pub const JOBS : u64 = 8;
pub const ACTORS : u64 = 4;
pub const A_DISPATCH : u64 = 0;
pub const A_WORKER0 : u64 = 1;
pub const STEP_BUDGET : u64 = 4096;

; --- 2. The effect surface: what an async body can ask for ------------------------------------------
; A body between await points is a pc. Running it to the next await yields one operation request:
; the (op, channel, value) triple the scheduler must handle before the body can continue. OP_NONE
; means the actor asked for nothing (it is done); OP_DONE is not requested, it is reached.

pub const OP_NONE : u64 = 0;
pub const OP_SEND : u64 = 1;
pub const OP_RECV : u64 = 2;
pub const OP_CLOSE : u64 = 3;
pub const OP_YIELD : u64 = 4;
pub const OP_DONE : u64 = 5;

pub const CH_JOBS : u64 = 0;
pub const CH_RESULTS : u64 = 1;
pub const CH_COUNT : u64 = 2;

; --- 3. Channels: unbounded mailboxes in one u64 ----------------------------------------------------
; The Rust sketch uses mpsc::channel, which never blocks a sender. A mailbox is one u64 of 8-bit
; slots, the oldest value in the low byte, plus an explicit length: a job or a result may be 0, so
; the bits alone cannot say how full the box is. A run pushes at most JOBS values per channel, so
; the box never needs a ninth slot.

pub const MBOX_SLOT_BITS : u64 = 8;

/// Appends one value at slot `len`. The caller owns the length; pool_run is the only caller.
pub fn mbox_push(word: u64, len: u64, value: u64) -> u64 {
    var sh : u64 = len * MBOX_SLOT_BITS;
    var v : u64 = value & 255;
    return word | (v << sh);
}

/// The oldest value, waiting in the low byte.
pub fn mbox_oldest(word: u64) -> u64 {
    return word & 255;
}

/// The box without its oldest value.
pub fn mbox_rest(word: u64) -> u64 {
    return word >> MBOX_SLOT_BITS;
}

; --- 4. The pool machine: packed pc slots, registers and counters ------------------------------------
; Four actors, each with a 4-bit pc, an 8-bit register (the value it holds across an await) and an
; 8-bit counter lane (the dispatcher counts sent jobs in lane 0 and collected results in lane 1), plus
; one suspended bit per actor. reg_of and reg_set serve registers and counters alike: both are 8-bit
; lanes of one u64.

pub const PC_START : u64 = 0;
pub const PC_WORK : u64 = 1;
pub const PC_YIELD : u64 = 2;
pub const PC_CLOSE : u64 = 3;
pub const PC_COLLECT : u64 = 4;
pub const PC_DONE : u64 = 15;

pub fn pc_of(word: u64, actor: u64) -> u64 {
    var sh : u64 = actor * 4;
    return (word >> sh) & 15;
}

pub fn pc_set(word: u64, actor: u64, pc: u64) -> u64 {
    var sh : u64 = actor * 4;
    var one : u64 = 1;
    var below : u64 = (one << sh) - 1;
    var upper : u64 = (word >> (sh + 4)) << (sh + 4);
    return (word & below) | ((pc & 15) << sh) | upper;
}

pub fn reg_of(word: u64, lane: u64) -> u64 {
    var sh : u64 = lane * 8;
    return (word >> sh) & 255;
}

pub fn reg_set(word: u64, lane: u64, value: u64) -> u64 {
    var sh : u64 = lane * 8;
    var one : u64 = 1;
    var below : u64 = (one << sh) - 1;
    var upper : u64 = (word >> (sh + 8)) << (sh + 8);
    return (word & below) | ((value & 255) << sh) | upper;
}

pub fn is_suspended(word: u64, actor: u64) -> bool {
    var bit : u64 = (word >> actor) & 1;
    return bit == 1;
}

pub fn suspend(word: u64, actor: u64) -> u64 {
    var one : u64 = 1;
    return word | (one << actor);
}

pub fn resume(word: u64, actor: u64) -> u64 {
    var one : u64 = 1;
    var below : u64 = (one << actor) - 1;
    var above : u64 = (word >> (actor + 1)) << (actor + 1);
    return below | above;
}

/// The dispatcher's collected results: eight 6-bit slots, a result is at most 7*7 = 49.
pub fn collect_get(word: u64, slot: u64) -> u64 {
    var sh : u64 = slot * 6;
    return (word >> sh) & 63;
}

pub fn collect_set(word: u64, slot: u64, value: u64) -> u64 {
    var sh : u64 = slot * 6;
    var one : u64 = 1;
    var below : u64 = (one << sh) - 1;
    var upper : u64 = (word >> (sh + 6)) << (sh + 6);
    return (word & below) | ((value & 63) << sh) | upper;
}

pub fn pool_done(pcs: u64) -> bool {
    var a : u64 = 0;
    while (a < ACTORS) {
        if (pc_of(pcs, a) != PC_DONE) { return false; }
        a = a + 1;
    }
    return true;
}

/// The effect op an actor requests when the scheduler resumes it at PC_START — the first await of
/// its body. The dispatcher awaits its own send loop; workers await their first recv from the jobs.
pub fn op_at_start(actor: u64) -> u64 {
    if (actor == A_DISPATCH) { return OP_SEND; }
    return OP_RECV;
}

; --- 5. The scheduler's two policies ----------------------------------------------------------------
; Everything the seed decides lives in one place: which ready actor runs next. Two further choices are
; fixed policies, named here because a real scheduler would own them too:
; - which suspended receiver a send wakes: the lowest pid (first_waiter). There is at most one waiter
;   per channel in this pool - workers only await the job channel, the dispatcher only the result
;   channel - so pid order is the whole policy.
; - what a recv on a closed, empty channel answers: the close signal, which is how a worker's loop
;   ends, exactly like Err(_) => break in the sketch.

/// The lowest actor suspended on the given channel, or ACTORS if none is.
pub fn first_waiter(suspended: u64, chan: u64) -> u64 {
    if (chan == CH_RESULTS) {
        if (is_suspended(suspended, A_DISPATCH)) { return A_DISPATCH; }
        return ACTORS;
    }
    var w : u64 = A_WORKER0;
    while (w < ACTORS) {
        if (is_suspended(suspended, w)) { return w; }
        w = w + 1;
    }
    return ACTORS;
}

/// The pick-th ready actor, scanning the ready mask. pick arrives mod ready_count, done by
/// subtraction because this subset has no modulo on runtime values.
pub fn pick_ready(ready: u64, ready_count: u64, pick: u64) -> u64 {
    var p : u64 = pick;
    while (p >= ready_count) { p = p - ready_count; }
    var a : u64 = 0;
    var seen : u64 = 0;
    while (a < ACTORS) {
        var bit : u64 = (ready >> a) & 1;
        if (bit == 1) {
            if (seen == p) { return a; }
            seen = seen + 1;
        }
        a = a + 1;
    }
    return ACTORS;
}

/// xorshift64: one seeded stream per run. The seed never feeds 0, and xorshift never reaches 0.
pub fn rng_next(state: u64) -> u64 {
    var x : u64 = state;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    return x;
}

; --- 6. The oracle ----------------------------------------------------------------------------------
; A worker computes result = job * job - a pure function of the job, whichever actor ran it. The
; oracle for a run is therefore the eight squares, and the sketch's results.sort() then assert_eq is
; a sorted-multiset comparison. The oracle's values are pairwise distinct, so the sorted multiset
; equals the oracle's exactly when every oracle value appears exactly once in the collection - that
; is the counting check below, and it needs no sort in this subset (there are no arrays to sort).

/// The result a job must produce.
pub fn oracle_result(job: u64) -> u64 {
    return job * job;
}

/// The sum of all eight squares: 140.
pub fn oracle_sum() -> u64 {
    var k : u64 = 0;
    var total : u64 = 0;
    while (k < JOBS) {
        total = total + oracle_result(k);
        k = k + 1;
    }
    return total;
}

/// The sum of the results a run collected.
pub fn collected_sum(summary: u64) -> u64 {
    var slot : u64 = 0;
    var total : u64 = 0;
    while (slot < JOBS) {
        total = total + collect_get(summary, slot);
        slot = slot + 1;
    }
    return total;
}

/// Sorted-multiset equality with the oracle, by counting occurrences.
pub fn collected_matches_oracle(summary: u64) -> bool {
    var k : u64 = 0;
    while (k < JOBS) {
        var want : u64 = oracle_result(k);
        var seen : u64 = 0;
        var slot : u64 = 0;
        while (slot < JOBS) {
            if (collect_get(summary, slot) == want) { seen = seen + 1; }
            slot = slot + 1;
        }
        if (seen != 1) { return false; }
        k = k + 1;
    }
    return true;
}

; --- 7. The deterministic simulator -----------------------------------------------------------------
; pool_run is the whole engine, and the structured scope. The machine state is locals: the packed
; actors, the two mailboxes, the collected results, the seed's stream. Each turn:
; 1. scan who is ready (not done, not suspended);
; 2. if nobody is ready, the run is over - completed only if every actor is done;
; 3. otherwise the seed picks a ready actor, its body runs from its pc to its next await and requests
;    one operation, and the scheduler handles that operation in place;
; 4. the step counter ticks; STEP_BUDGET backstops a stuck run.
; The effect handlers, one per operation:
; - SEND on the job channel: park the value in the mailbox (the dispatcher never blocks on send);
;   when the eighth job is sent the body moves to its close point.
; - SEND on the result channel: hand the value straight to a suspended receiver if there is one,
;   else park it; the sender then moves to its yield point.
; - RECV: complete at once with the oldest parked value, else - if the channel is open - suspend the
;   actor inside the recv, else (closed and empty) answer the close signal and end the worker.
; - CLOSE: mark the channel closed and hand every suspended receiver the close signal at once.
; - YIELD: the actor goes back to ready; the seed decides who runs next.
; The result is one u64: bits 0..47 hold the collected results (6-bit slots, in arrival order), bit 48
; says the run completed, bits 49 and 50 say both channels ended drained, bits 51..62 hold the steps.

pub fn pool_run(seed: u64) -> u64 {
    var pcs : u64 = 0;
    var regs : u64 = 0;
    var counts : u64 = 0;
    var suspended : u64 = 0;
    var jobs : u64 = 0;
    var jobs_len : u64 = 0;
    var jobs_closed : bool = false;
    var results : u64 = 0;
    var results_len : u64 = 0;
    var collected : u64 = 0;
    var rng : u64 = rng_next(seed + 1);
    var steps : u64 = 0;
    var completed : bool = false;
    var running : bool = true;

    while (running and steps < STEP_BUDGET) {
        var ready : u64 = 0;
        var ready_count : u64 = 0;
        var a : u64 = 0;
        while (a < ACTORS) {
            var done : bool = pc_of(pcs, a) == PC_DONE;
            if (done == false and is_suspended(suspended, a) == false) {
                var one : u64 = 1;
                ready = ready | (one << a);
                ready_count = ready_count + 1;
            }
            a = a + 1;
        }
        if (ready_count == 0) {
            running = false;
            if (pool_done(pcs)) { completed = true; }
        }
        if (running) {
            rng = rng_next(rng);
            var choice : u64 = (rng >> 32) & 3;
            var actor : u64 = pick_ready(ready, ready_count, choice);
            var pc : u64 = pc_of(pcs, actor);

            // the body runs to its next await and requests one operation
            var op : u64 = OP_NONE;
            var chan : u64 = CH_JOBS;
            var value : u64 = 0;
            if (actor == A_DISPATCH) {
                if (pc == PC_START) {
                    op = OP_SEND;
                    chan = CH_JOBS;
                    value = reg_of(counts, 0);
                }
                if (pc == PC_CLOSE) {
                    op = OP_CLOSE;
                    chan = CH_JOBS;
                }
                if (pc == PC_COLLECT) {
                    op = OP_RECV;
                    chan = CH_RESULTS;
                }
            }
            if (actor != A_DISPATCH) {
                if (pc == PC_START) {
                    op = OP_RECV;
                    chan = CH_JOBS;
                }
                if (pc == PC_WORK) {
                    var job : u64 = reg_of(regs, actor);
                    op = OP_SEND;
                    chan = CH_RESULTS;
                    value = job * job;
                }
                if (pc == PC_YIELD) {
                    op = OP_YIELD;
                }
            }

            // the scheduler handles the operation
            // a send completes an awaiting recv directly when there is one, else parks in the mailbox
            if (op == OP_SEND and chan == CH_JOBS) {
                var waiter : u64 = first_waiter(suspended, CH_JOBS);
                if (waiter < ACTORS) {
                    regs = reg_set(regs, waiter, value);
                    pcs = pc_set(pcs, waiter, PC_WORK);
                    suspended = resume(suspended, waiter);
                } else {
                    jobs = mbox_push(jobs, jobs_len, value);
                    jobs_len = jobs_len + 1;
                }
                var sent : u64 = reg_of(counts, 0) + 1;
                counts = reg_set(counts, 0, sent);
                if (sent == JOBS) { pcs = pc_set(pcs, actor, PC_CLOSE); }
            }
            if (op == OP_SEND and chan == CH_RESULTS) {
                var waiter : u64 = first_waiter(suspended, CH_RESULTS);
                if (waiter < ACTORS) {
                    var got : u64 = reg_of(counts, 1) + 1;
                    counts = reg_set(counts, 1, got);
                    collected = collect_set(collected, got - 1, value);
                    suspended = resume(suspended, waiter);
                    if (got == JOBS) { pcs = pc_set(pcs, waiter, PC_DONE); }
                } else {
                    results = mbox_push(results, results_len, value);
                    results_len = results_len + 1;
                }
                pcs = pc_set(pcs, actor, PC_YIELD);
            }
            if (op == OP_RECV and chan == CH_JOBS) {
                if (jobs_len > 0) {
                    var job : u64 = mbox_oldest(jobs);
                    jobs = mbox_rest(jobs);
                    jobs_len = jobs_len - 1;
                    regs = reg_set(regs, actor, job);
                    pcs = pc_set(pcs, actor, PC_WORK);
                } else {
                    if (jobs_closed) {
                        pcs = pc_set(pcs, actor, PC_DONE);
                    } else {
                        suspended = suspend(suspended, actor);
                    }
                }
            }
            if (op == OP_RECV and chan == CH_RESULTS) {
                if (results_len > 0) {
                    var v : u64 = mbox_oldest(results);
                    results = mbox_rest(results);
                    results_len = results_len - 1;
                    var got : u64 = reg_of(counts, 1) + 1;
                    counts = reg_set(counts, 1, got);
                    collected = collect_set(collected, got - 1, v);
                    if (got == JOBS) { pcs = pc_set(pcs, actor, PC_DONE); }
                } else {
                    suspended = suspend(suspended, actor);
                }
            }
            if (op == OP_CLOSE) {
                jobs_closed = true;
                var w : u64 = A_WORKER0;
                while (w < ACTORS) {
                    if (is_suspended(suspended, w)) {
                        pcs = pc_set(pcs, w, PC_DONE);
                        suspended = resume(suspended, w);
                    }
                    w = w + 1;
                }
                pcs = pc_set(pcs, actor, PC_COLLECT);
            }
            if (op == OP_YIELD) {
                pcs = pc_set(pcs, actor, PC_START);
            }
            steps = steps + 1;
        }
    }

    var summary : u64 = collected;
    var one : u64 = 1;
    if (completed) { summary = summary | (one << 48); }
    if (jobs_len == 0) { summary = summary | (one << 49); }
    if (results_len == 0) { summary = summary | (one << 50); }
    var step_bits : u64 = steps << 51;
    return summary | step_bits;
}

pub fn summary_completed(summary: u64) -> bool {
    var bit : u64 = (summary >> 48) & 1;
    return bit == 1;
}

pub fn summary_drained(summary: u64) -> bool {
    var jobs_bit : u64 = (summary >> 49) & 1;
    var results_bit : u64 = (summary >> 50) & 1;
    return jobs_bit == 1 and results_bit == 1;
}

pub fn summary_steps(summary: u64) -> u64 {
    return summary >> 51;
}

; --- 8. Deliberately not threads --------------------------------------------------------------------
; - No OS threads and no OS processes. A worker is a pc slot; spawn is claiming a slot; the whole
;   pool is four of them in one word.
; - No preemptive scheduler. A body runs from one await to the next and then hands back control by
;   requesting an operation; it is never interrupted mid-turn. A long body would starve the rest,
;   which is why YIELD exists and why workers yield after every send.
; - No dynamic allocation. The mailboxes are u64s sized for this pool, and a run pushes at most JOBS
;   values into either one.
; - No wakeup tokens, no fairness guarantees beyond the seed. The seed may starve a worker for a
;   while; the channel semantics (each value is handed to exactly one receiver) mean the outcome is
;   still the oracle's, which is the point of checking every seed.

invariant the_effect_surface_is_four_operations_and_a_done {
    assert OP_NONE < OP_SEND and OP_SEND < OP_RECV and OP_RECV < OP_CLOSE and OP_CLOSE < OP_YIELD and OP_YIELD < OP_DONE;
}
invariant a_run_pushes_at_most_eight_values_per_channel {
    assert MBOX_SLOT_BITS * JOBS <= 64;
}
invariant the_summary_word_holds_results_flags_and_steps {
    assert JOBS * 6 == 48 and 48 + 3 < 64 and 64 - 51 >= 12;
}
invariant the_step_budget_bounds_a_full_run {
    assert STEP_BUDGET >= JOBS * (WORKERS + 2) + ACTORS;
}

test the_effect_surface_and_channels_are_fixed {
    // comptime-only asserts are proved at compile time and count as vacuous here, so this test
    // walks the constants through runtime calls: every actor's decoded op at PC_START must match
    var seed : u64 = 0;
    while (seed < 3) {
        var actor : u64 = 0;
        while (actor < ACTORS) {
            var op : u64 = op_at_start(actor);
            if (actor == A_DISPATCH) {
                assert op == OP_SEND;
            }
            if (actor != A_DISPATCH) {
                assert op == OP_RECV;
            }
            actor = actor + 1;
        }
        seed = seed + 1;
    }
    assert OP_DONE == OP_YIELD + 1;
    assert CH_RESULTS == CH_JOBS + 1 and CH_COUNT == CH_RESULTS + 1;
    assert WORKERS == 3 and JOBS == 8 and ACTORS == WORKERS + 1;
    assert STEP_BUDGET >= 2 * JOBS * ACTORS;
}

test the_oracle_is_a_pure_function_of_the_job {
    assert oracle_result(0) == 0;
    assert oracle_result(1) == 1;
    assert oracle_result(2) == 4;
    assert oracle_result(7) == 49;
    assert oracle_sum() == 140;
}

test the_packing_round_trips {
    var pcs : u64 = 0;
    pcs = pc_set(pcs, A_DISPATCH, PC_COLLECT);
    pcs = pc_set(pcs, A_WORKER0, PC_WORK);
    assert pc_of(pcs, A_DISPATCH) == PC_COLLECT;
    assert pc_of(pcs, A_WORKER0) == PC_WORK;
    assert pc_of(pcs, 2) == PC_START;
    assert pc_of(pcs, 3) == PC_START;

    var regs : u64 = 0;
    regs = reg_set(regs, A_WORKER0, 7);
    regs = reg_set(regs, 0, 49);
    assert reg_of(regs, A_WORKER0) == 7;
    assert reg_of(regs, 0) == 49;
    assert reg_of(regs, 2) == 0;

    var mb : u64 = 0;
    mb = mbox_push(mb, 0, 5);
    mb = mbox_push(mb, 1, 6);
    mb = mbox_push(mb, 2, 7);
    assert mbox_oldest(mb) == 5;
    mb = mbox_rest(mb);
    assert mbox_oldest(mb) == 6;
    mb = mbox_rest(mb);
    assert mbox_oldest(mb) == 7;
    mb = mbox_rest(mb);
    assert mb == 0;

    var suspended : u64 = 0;
    suspended = suspend(suspended, 2);
    assert is_suspended(suspended, 2);
    assert is_suspended(suspended, 1) == false;
    suspended = resume(suspended, 2);
    assert is_suspended(suspended, 2) == false;

    assert first_waiter(suspend(0, A_DISPATCH), CH_RESULTS) == A_DISPATCH;
    assert first_waiter(0, CH_RESULTS) == ACTORS;
    assert first_waiter(suspend(0, 3), CH_JOBS) == 3;
    assert first_waiter(0, CH_JOBS) == ACTORS;

    assert pick_ready(5, 2, 0) == 0;
    assert pick_ready(5, 2, 1) == 2;
    assert pick_ready(8, 1, 7) == 3;
    assert pool_done(pc_set(pc_set(0, 0, PC_DONE), 1, PC_DONE)) == false;
    assert pool_done(0xFFFF);
}

test the_summary_word_packs_the_run {
    var summary : u64 = 0;
    var k : u64 = 0;
    while (k < JOBS) {
        summary = collect_set(summary, k, oracle_result(k));
        k = k + 1;
    }
    assert collected_matches_oracle(summary);
    assert collected_sum(summary) == oracle_sum();
    assert summary_completed(summary) == false;
    assert summary_drained(summary) == false;
    assert summary_steps(summary) == 0;

    var one : u64 = 1;
    summary = summary | (one << 48);
    summary = summary | (one << 49);
    summary = summary | (one << 50);
    summary = summary | (7 << 51);
    assert summary_completed(summary);
    assert summary_drained(summary);
    assert summary_steps(summary) == 7;
}

test the_pool_completes_and_matches_the_oracle_across_100_seeds {
    var seed : u64 = 0;
    while (seed < 100) {
        var summary : u64 = pool_run(seed);
        assert summary_completed(summary);
        assert summary_drained(summary);
        assert collected_matches_oracle(summary);
        assert collected_sum(summary) == oracle_sum();
        assert summary_steps(summary) < STEP_BUDGET;
        seed = seed + 1;
    }
}

test a_seed_replays_the_same_run {
    var seed : u64 = 0;
    while (seed < 20) {
        var first : u64 = pool_run(seed);
        var second : u64 = pool_run(seed);
        assert first == second;
        seed = seed + 1;
    }
}
