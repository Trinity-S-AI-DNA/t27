// t27/specs/
// Standard HTTP status codes | φ² + 1/φ² = 3 | TRINITY

module TriHttp;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const HttpMethod = enum(u8) {
        GET,
        POST,
        PUT,
        DELETE,
        PATCH,
        HEAD,
        OPTIONS,
    };

    pub const HttpStatus = struct {
        code : u16,
        reason : []const u8,
    };

    pub const Url = struct {
        scheme : ?[]const u8,
        host : ?[]const u8,
        port : ?u16,
        path : []const u8,
        query : ?[]const u8,
        fragment : ?[]const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Byte values used by the URL parser (t27c source has no portable char literal here).
    pub const B_SLASH : u8 = 47;
    pub const B_COLON : u8 = 58;
    pub const B_QUESTION : u8 = 63;
    pub const B_HASH : u8 = 35;
    pub const B_DIGIT_0 : u8 = 48;
    pub const B_DIGIT_9 : u8 = 57;
    pub const B_LBRACKET : u8 = 91;
    pub const B_RBRACKET : u8 = 93;

    // method_to_string(method: HttpMethod) → []const u8
    fn method_to_string(method: HttpMethod) -> []const u8 {
        return switch (method) {
            .GET => "GET",
            .POST => "POST",
            .PUT => "PUT",
            .DELETE => "DELETE",
            .PATCH => "PATCH",
            .HEAD => "HEAD",
            .OPTIONS => "OPTIONS",
        };
    }

    // class_status(code: u16) → HttpStatus : the generic status of a code with no entry of its own
    fn class_status(code: u16) -> HttpStatus {
        if (code >= 100 and code < 200) {
            return HttpStatus{ .code = code, .reason = "Informational" };
        }
        if (code >= 200 and code < 300) {
            return HttpStatus{ .code = code, .reason = "OK" };
        }
        if (code >= 300 and code < 400) {
            return HttpStatus{ .code = code, .reason = "Redirection" };
        }
        if (code >= 400 and code < 500) {
            return HttpStatus{ .code = code, .reason = "Client Error" };
        }
        if (code >= 500 and code < 600) {
            return HttpStatus{ .code = code, .reason = "Server Error" };
        }
        return HttpStatus{ .code = code, .reason = "Unknown" };
    }

    // status_from_code(code: u16) → HttpStatus
    fn status_from_code(code: u16) -> HttpStatus {
        return switch (code) {
            200 => HttpStatus{ .code = 200, .reason = "OK" },
            201 => HttpStatus{ .code = 201, .reason = "Created" },
            204 => HttpStatus{ .code = 204, .reason = "No Content" },
            301 => HttpStatus{ .code = 301, .reason = "Moved Permanently" },
            302 => HttpStatus{ .code = 302, .reason = "Found" },
            304 => HttpStatus{ .code = 304, .reason = "Not Modified" },
            400 => HttpStatus{ .code = 400, .reason = "Bad Request" },
            401 => HttpStatus{ .code = 401, .reason = "Unauthorized" },
            403 => HttpStatus{ .code = 403, .reason = "Forbidden" },
            404 => HttpStatus{ .code = 404, .reason = "Not Found" },
            405 => HttpStatus{ .code = 405, .reason = "Method Not Allowed" },
            409 => HttpStatus{ .code = 409, .reason = "Conflict" },
            429 => HttpStatus{ .code = 429, .reason = "Too Many Requests" },
            500 => HttpStatus{ .code = 500, .reason = "Internal Server Error" },
            502 => HttpStatus{ .code = 502, .reason = "Bad Gateway" },
            503 => HttpStatus{ .code = 503, .reason = "Service Unavailable" },
            504 => HttpStatus{ .code = 504, .reason = "Gateway Timeout" },
            else => class_status(code),
        };
    }

    // is_success(code: u16) → bool
    fn is_success(code: u16) -> bool {
        return code >= 200 and code < 300;
    }

    // is_redirect(code: u16) → bool
    fn is_redirect(code: u16) -> bool {
        return code >= 300 and code < 400;
    }

    // is_client_error(code: u16) → bool
    fn is_client_error(code: u16) -> bool {
        return code >= 400 and code < 500;
    }

    // is_server_error(code: u16) → bool
    fn is_server_error(code: u16) -> bool {
        return code >= 500 and code < 600;
    }

    // find_byte(s, b, from) → ?usize : index of the first b at or after from
    fn find_byte(s: []const u8, b: u8, from: usize) -> ?usize {
        var i = from;
        while (i < s.len) {
            if (s[i] == b) {
                return i;
            }
            i = i + 1;
        }
        return null;
    }

    // find_scheme_end(s) → ?usize : index of the first "://"
    fn find_scheme_end(s: []const u8) -> ?usize {
        var i : usize = 0;
        while (i + 3 <= s.len) {
            if (s[i] == B_COLON and s[i + 1] == B_SLASH and s[i + 2] == B_SLASH) {
                return i;
            }
            i = i + 1;
        }
        return null;
    }

    // parse_port(digits) → ?u16 : the decimal number, null when a byte is not a digit or it exceeds 65535
    fn parse_port(digits: []const u8) -> ?u16 {
        var value : u32 = 0;
        var i : usize = 0;
        while (i < digits.len) {
            if (digits[i] < B_DIGIT_0 or digits[i] > B_DIGIT_9) {
                return null;
            }
            value = value * 10 + @as(u32, digits[i] - B_DIGIT_0);
            if (value > 65535) {
                return null;
            }
            i = i + 1;
        }
        return @as(u16, @intCast(value));
    }

    // split_rest(result, rest) → void : fill path, query and fragment from "path?query#fragment"
    fn split_rest(result: *Url, rest: []const u8) -> void {
        const query_start = find_byte(rest, B_QUESTION, 0);
        const fragment_start = find_byte(rest, B_HASH, 0);

        if (fragment_start != null) {
            const frag_idx = fragment_start.?;
            result.fragment = rest[frag_idx + 1 .. rest.len];
            const before_fragment = rest[0..frag_idx];
            // A '?' after the '#' belongs to the fragment.
            if (query_start != null and query_start.? < frag_idx) {
                const query_idx = query_start.?;
                result.path = before_fragment[0..query_idx];
                result.query = before_fragment[query_idx + 1 .. before_fragment.len];
            } else {
                result.path = before_fragment;
            }
        } else {
            if (query_start != null) {
                const query_idx = query_start.?;
                result.path = rest[0..query_idx];
                result.query = rest[query_idx + 1 .. rest.len];
            } else {
                if (rest.len > 0) {
                    result.path = rest;
                }
            }
        }
    }

    // parse_url(url: []const u8) → ?Url
    // Splits a URL into its parts (slices of the input). Null when the port is not
    // a number in 0..65535. A missing path becomes "/" when there is no query and
    // no fragment either.
    fn parse_url(url: []const u8) -> ?Url {
        var result = Url{
            .scheme = null,
            .host = null,
            .port = null,
            .path = "/",
            .query = null,
            .fragment = null,
        };

        // Find scheme separator
        const scheme_end = find_scheme_end(url);
        if (scheme_end != null) {
            const end = scheme_end.?;
            result.scheme = url[0..end];
            // The authority runs from the end of the scheme to the first '/', '?' or '#'.
            const authority_start = end + 3;
            var authority_end_abs = url.len;
            var i = authority_start;
            while (i < url.len) {
                if (url[i] == B_SLASH or url[i] == B_QUESTION or url[i] == B_HASH) {
                    authority_end_abs = i;
                    break;
                }
                i = i + 1;
            }

            if (authority_end_abs > authority_start) {
                const authority = url[authority_start..authority_end_abs];

                // A bracketed IPv6 host keeps its colons: look for the port after the ']'.
                var search_from : usize = 0;
                if (authority[0] == B_LBRACKET) {
                    const close = find_byte(authority, B_RBRACKET, 0);
                    if (close != null) {
                        search_from = close.? + 1;
                    }
                }
                // Split host and port at the last ':'
                var port_separator : ?usize = null;
                var j = search_from;
                while (j < authority.len) {
                    if (authority[j] == B_COLON) {
                        port_separator = j;
                    }
                    j = j + 1;
                }
                result.host = authority;
                if (port_separator != null) {
                    const sep = port_separator.?;
                    const port_part = authority[sep + 1 .. authority.len];
                    if (port_part.len > 0 and port_part[0] >= B_DIGIT_0 and port_part[0] <= B_DIGIT_9) {
                        const port = parse_port(port_part);
                        if (port == null) {
                            return null;
                        }
                        result.host = authority[0..sep];
                        result.port = port;
                    }
                }
            }

            // Parse path, query, and fragment
            split_rest(&result, url[authority_end_abs..url.len]);
        } else {
            // No scheme - parse relative URL
            split_rest(&result, url);
        }

        return result;
    }

    fn bytes_eq(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var i : usize = 0;
        while (i < a.len) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test method_to_string_basic_case {
        assert(bytes_eq(method_to_string(HttpMethod.PUT), "PUT"));
        assert(bytes_eq(method_to_string(HttpMethod.DELETE), "DELETE"));
        assert(bytes_eq(method_to_string(HttpMethod.PATCH), "PATCH"));
        assert(bytes_eq(method_to_string(HttpMethod.HEAD), "HEAD"));
        assert(bytes_eq(method_to_string(HttpMethod.OPTIONS), "OPTIONS"));
    }

    test status_from_code_basic_case {
        const created = status_from_code(201);
        assert(created.code == 201);
        assert(bytes_eq(created.reason, "Created"));
        // Codes without an entry fall back to their class.
        assert(bytes_eq(status_from_code(150).reason, "Informational"));
        assert(bytes_eq(status_from_code(226).reason, "OK"));
        assert(bytes_eq(status_from_code(308).reason, "Redirection"));
        assert(bytes_eq(status_from_code(418).reason, "Client Error"));
        assert(bytes_eq(status_from_code(599).reason, "Server Error"));
        assert(bytes_eq(status_from_code(99).reason, "Unknown"));
        assert(status_from_code(418).code == 418);
    }

    test is_success_basic_case {
        assert(is_success(200));
        assert(!is_success(199));
        assert(!is_success(404));
    }

    test is_redirect_basic_case {
        assert(is_redirect(302));
        assert(!is_redirect(200));
        assert(!is_redirect(400));
    }

    test is_client_error_basic_case {
        assert(is_client_error(400));
        assert(is_client_error(499));
        assert(!is_client_error(399));
        assert(!is_client_error(500));
    }

    test is_server_error_basic_case {
        assert(is_server_error(503));
        assert(is_server_error(599));
        assert(!is_server_error(499));
        assert(!is_server_error(600));
    }

    test parse_url_basic_case {
        const result = parse_url("http://example.com/path");
        assert(result != null);
        const u = result.?;
        assert(bytes_eq(u.scheme.?, "http"));
        assert(bytes_eq(u.host.?, "example.com"));
        assert(u.port == null);
        assert(bytes_eq(u.path, "/path"));
        assert(u.query == null);
        assert(u.fragment == null);
    }

    // Additional tests for the implemented functions
    test method_to_string_get {
        const result = method_to_string(HttpMethod.GET);
        assert(bytes_eq(result, "GET"));
    }

    test method_to_string_post {
        const result = method_to_string(HttpMethod.POST);
        assert(bytes_eq(result, "POST"));
    }

    test status_from_code_404 {
        const result = status_from_code(404);
        assert(result.code == 404 and bytes_eq(result.reason, "Not Found"));
    }

    test status_from_code_200 {
        const result = status_from_code(200);
        assert(result.code == 200 and bytes_eq(result.reason, "OK"));
    }

    test is_success_200 {
        const result = is_success(200);
        assert(result == true);
    }

    test is_success_299 {
        const result = is_success(299);
        assert(result == true);
    }

    test is_success_300 {
        const result = is_success(300);
        assert(result == false);
    }

    test is_redirect_301 {
        const result = is_redirect(301);
        assert(result == true);
    }

    test is_redirect_300 {
        const result = is_redirect(300);
        assert(result == true);
    }

    test is_redirect_299 {
        const result = is_redirect(299);
        assert(result == false);
    }

    test is_client_error_404 {
        const result = is_client_error(404);
        assert(result == true);
    }

    test is_client_error_500 {
        const result = is_client_error(500);
        assert(result == false);
    }

    test is_server_error_500 {
        const result = is_server_error(500);
        assert(result == true);
    }

    test is_server_error_404 {
        const result = is_server_error(404);
        assert(result == false);
    }

    test parse_url_full {
        const parsed = parse_url("https://example.com:8443/a/b?x=1#frag");
        assert(parsed != null);
        const result = parsed.?;
        assert(bytes_eq(result.scheme.?, "https"));
        assert(bytes_eq(result.host.?, "example.com"));
        assert(result.port.? == 8443);
        assert(bytes_eq(result.path, "/a/b"));
        assert(bytes_eq(result.query.?, "x=1"));
        assert(bytes_eq(result.fragment.?, "frag"));
    }

    test parse_url_bare {
        const parsed = parse_url("/index.html");
        assert(parsed != null);
        const result = parsed.?;
        assert(result.scheme == null);
        assert(result.host == null);
        assert(result.port == null);
        assert(bytes_eq(result.path, "/index.html"));
        assert(result.query == null);
        assert(result.fragment == null);
    }

    test parse_url_without_a_path_defaults_to_the_root {
        const u = parse_url("http://example.com").?;
        assert(bytes_eq(u.host.?, "example.com"));
        assert(bytes_eq(u.path, "/"));
        const e = parse_url("").?;
        assert(bytes_eq(e.path, "/"));
    }

    test parse_url_query_and_fragment_edges {
        // A '?' after the '#' is part of the fragment.
        const a = parse_url("/p#f?not-a-query").?;
        assert(bytes_eq(a.path, "/p"));
        assert(a.query == null);
        assert(bytes_eq(a.fragment.?, "f?not-a-query"));
        const b = parse_url("/p?q=1").?;
        assert(bytes_eq(b.path, "/p"));
        assert(bytes_eq(b.query.?, "q=1"));
        assert(b.fragment == null);
        // The authority also ends at '?' and '#'.
        const c = parse_url("http://h?x=1").?;
        assert(bytes_eq(c.host.?, "h"));
        assert(bytes_eq(c.query.?, "x=1"));
        const d = parse_url("http://h#top").?;
        assert(bytes_eq(d.host.?, "h"));
        assert(bytes_eq(d.fragment.?, "top"));
    }

    test parse_url_ports {
        assert(parse_url("http://h:0/").?.port.? == 0);
        assert(parse_url("http://h:65535/").?.port.? == 65535);
        // A port out of range or with a non-digit makes the URL invalid.
        assert(parse_url("http://h:65536/") == null);
        assert(parse_url("http://h:80a/") == null);
        // An empty port after the colon is not a port: the colon stays in the host.
        const e = parse_url("http://h:/x").?;
        assert(e.port == null);
        assert(bytes_eq(e.host.?, "h:"));
        // A bracketed IPv6 host keeps its colons.
        const v6 = parse_url("http://[::1]:8080/p").?;
        assert(bytes_eq(v6.host.?, "[::1]"));
        assert(v6.port.? == 8080);
        const v6_no_port = parse_url("http://[::1]/p").?;
        assert(bytes_eq(v6_no_port.host.?, "[::1]"));
        assert(v6_no_port.port == null);
    }
