// SPDX-License-Identifier: Apache-2.0
// specs/tri/tri_land.t27 -- bug(tri-land): the stage step cannot execute —
// two commands in one argv; every lane's tri land stops there.
// Part of M4 milestone (milestone #8). Closes #13032.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::tri_land;

pub const TRI_LAND_MAX_ARGV : u32 = 1;

pub struct TriLand { argv_count: u32, executable: bool };

pub fn tri_land_executable(t: TriLand) -> bool {
    return t.executable && t.argv_count <= TRI_LAND_MAX_ARGV;
}

test "tri_land_executable" {
    assert(tri_land_executable(TriLand { argv_count: 1, executable: true }));
    assert(!tri_land_executable(TriLand { argv_count: 2, executable: true }));
}

invariant tri_land_max_argv_defined {
    assert TRI_LAND_MAX_ARGV == 1;
}