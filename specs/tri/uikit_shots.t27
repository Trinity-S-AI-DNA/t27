// SPDX-License-Identifier: Apache-2.0
; specs/tri/uikit_shots.t27 -- the UI Kit screenshot + visual-regression plan core for `tri uikit shots`.
; Screens and themes are small integer ids; shot index = screen * 2 + theme.
; Baselines live under target/shots/baseline/, never inside a lane worktree.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY
; Issue: #13812

module TriUikitShots;

pub const SCREEN_HEADER: u8 = 0;
pub const SCREEN_CC: u8 = 1;
pub const SCREEN_CC_NARROW: u8 = 2;
pub const SCREEN_CC_SELECT: u8 = 3;
pub const SCREEN_COUNT: u8 = 4;

pub const THEME_DARK: u8 = 0;
pub const THEME_LIGHT: u8 = 1;
pub const THEME_COUNT: u8 = 2;

/// Theme mask bits for a screen: 1 = Dark, 2 = Light, 3 = both.
pub const MASK_BOTH: u8 = 3;

/// Shot index for a screen and a theme.
pub fn shot_index(screen: u8, theme: u8) -> u8 {
    return screen * 2 + theme;
}

/// Number of shots in a plan: every screen times every theme.
pub fn shot_count(screens: u8) -> u8 {
    return screens * 2;
}

/// Shot name by index; "" for an index out of range.
pub fn shot_name(i: u8) -> string {
    if (i == 0) { return "header-dark"; }
    if (i == 1) { return "header-light"; }
    if (i == 2) { return "cc-dark"; }
    if (i == 3) { return "cc-light"; }
    if (i == 4) { return "cc-narrow-dark"; }
    if (i == 5) { return "cc-narrow-light"; }
    if (i == 6) { return "cc-select-dark"; }
    if (i == 7) { return "cc-select-light"; }
    return "";
}

/// Baseline path by index: target/shots/baseline/<shot>.png.
pub fn baseline_path(i: u8) -> string {
    if (i == 0) { return "target/shots/baseline/header-dark.png"; }
    if (i == 1) { return "target/shots/baseline/header-light.png"; }
    if (i == 2) { return "target/shots/baseline/cc-dark.png"; }
    if (i == 3) { return "target/shots/baseline/cc-light.png"; }
    if (i == 4) { return "target/shots/baseline/cc-narrow-dark.png"; }
    if (i == 5) { return "target/shots/baseline/cc-narrow-light.png"; }
    if (i == 6) { return "target/shots/baseline/cc-select-dark.png"; }
    if (i == 7) { return "target/shots/baseline/cc-select-light.png"; }
    return "";
}

/// Diff path by index: target/shots/vr-<shot>-diff.png.
pub fn diff_path(i: u8) -> string {
    if (i == 0) { return "target/shots/vr-header-dark-diff.png"; }
    if (i == 1) { return "target/shots/vr-header-light-diff.png"; }
    if (i == 2) { return "target/shots/vr-cc-dark-diff.png"; }
    if (i == 3) { return "target/shots/vr-cc-light-diff.png"; }
    if (i == 4) { return "target/shots/vr-cc-narrow-dark-diff.png"; }
    if (i == 5) { return "target/shots/vr-cc-narrow-light-diff.png"; }
    if (i == 6) { return "target/shots/vr-cc-select-dark-diff.png"; }
    if (i == 7) { return "target/shots/vr-cc-select-light-diff.png"; }
    return "";
}

/// A screen is plannable only with both themes. Returns 0 ok, 1 refused.
pub fn screen_ok(mask: u8) -> u8 {
    if (mask == 3) { return 0; }
    return 1;
}

/// A plan of four screens: 0 ok, 1 when any screen lacks a theme.
pub fn plan_ok(m0: u8, m1: u8, m2: u8, m3: u8) -> u8 {
    if (screen_ok(m0) == 1) { return 1; }
    if (screen_ok(m1) == 1) { return 1; }
    if (screen_ok(m2) == 1) { return 1; }
    if (screen_ok(m3) == 1) { return 1; }
    return 0;
}

invariant m0_plan_has_eight_shots { assert shot_count(SCREEN_COUNT) == 8 and shot_index(SCREEN_CC_SELECT, THEME_LIGHT) == 7; }

invariant m0_plan_names_unique {
    assert shot_name(0) != shot_name(1);
    assert shot_name(0) != shot_name(2);
    assert shot_name(0) != shot_name(3);
    assert shot_name(0) != shot_name(4);
    assert shot_name(0) != shot_name(5);
    assert shot_name(0) != shot_name(6);
    assert shot_name(0) != shot_name(7);
    assert shot_name(1) != shot_name(2);
    assert shot_name(1) != shot_name(3);
    assert shot_name(1) != shot_name(4);
    assert shot_name(1) != shot_name(5);
    assert shot_name(1) != shot_name(6);
    assert shot_name(1) != shot_name(7);
    assert shot_name(2) != shot_name(3);
    assert shot_name(2) != shot_name(4);
    assert shot_name(2) != shot_name(5);
    assert shot_name(2) != shot_name(6);
    assert shot_name(2) != shot_name(7);
    assert shot_name(3) != shot_name(4);
    assert shot_name(3) != shot_name(5);
    assert shot_name(3) != shot_name(6);
    assert shot_name(3) != shot_name(7);
    assert shot_name(4) != shot_name(5);
    assert shot_name(4) != shot_name(6);
    assert shot_name(4) != shot_name(7);
    assert shot_name(5) != shot_name(6);
    assert shot_name(5) != shot_name(7);
    assert shot_name(6) != shot_name(7);
}

invariant m0_plan_paths_follow_names {
    assert baseline_path(0) == "target/shots/baseline/header-dark.png" and diff_path(0) == "target/shots/vr-header-dark-diff.png";
    assert baseline_path(5) == "target/shots/baseline/cc-narrow-light.png" and diff_path(5) == "target/shots/vr-cc-narrow-light-diff.png";
    assert baseline_path(7) == "target/shots/baseline/cc-select-light.png" and diff_path(7) == "target/shots/vr-cc-select-light-diff.png";
}

// FR-001: ordered shot names, dark then light per screen, none repeated.
test fr001_shot_order_is_screen_then_theme {
    assert(shot_index(SCREEN_HEADER, THEME_DARK) == 0);
    assert(shot_index(SCREEN_HEADER, THEME_LIGHT) == 1);
    assert(shot_index(SCREEN_CC, THEME_DARK) == 2);
    assert(shot_index(SCREEN_CC_NARROW, THEME_DARK) == 4);
    assert(shot_index(SCREEN_CC_SELECT, THEME_DARK) == 6);
    assert(shot_name(shot_index(SCREEN_CC_NARROW, THEME_LIGHT)) == "cc-narrow-light");
    assert(shot_name(shot_index(SCREEN_CC, THEME_DARK)) == "cc-dark");
}

test fr001_out_of_range_index_is_empty {
    assert(shot_name(8) == "");
    assert(baseline_path(8) == "");
    assert(diff_path(8) == "");
}

// FR-002: baseline under target/shots/baseline/, diff vr-<shot>-diff.png, never a worktree path.
test fr002_paths_for_each_shot {
    assert(baseline_path(2) == "target/shots/baseline/cc-dark.png");
    assert(diff_path(2) == "target/shots/vr-cc-dark-diff.png");
    assert(baseline_path(6) == "target/shots/baseline/cc-select-dark.png");
    assert(diff_path(6) == "target/shots/vr-cc-select-dark-diff.png");
    assert(baseline_path(1) != diff_path(1));
}

// FR-003: a screen without both themes refuses the plan.
test fr003_refuses_screen_without_both_themes {
    assert(screen_ok(MASK_BOTH) == 0);
    assert(screen_ok(1) == 1);
    assert(screen_ok(2) == 1);
    assert(screen_ok(0) == 1);
    assert(plan_ok(3, 3, 3, 3) == 0);
    assert(plan_ok(3, 1, 3, 3) == 1);
    assert(plan_ok(3, 3, 3, 2) == 1);
}

// bench: planning is constant work.
bench plan_ok_is_constant_work {
    assert(plan_ok(3, 3, 3, 3) == 0);
}
