// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Tag effects for type safety | φ² + 1/φ² = 3 | TRINITY

module TriIo;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const IO(T) = struct {
        performed : bool,
        value : T,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // pure(value: T) → IO(T); T binds at the fn level (#11940 sub-slice 1) --
    // call sites pass the type explicitly: pure(i64, 7)
    fn pure(comptime T: type, value: T) -> IO(T) {
        return IO(T){ .performed = false, .value = value };
    }

    // map(io: IO(T), fn: fn(T) -> U) → IO(U)
    fn map(io: IO(i64), f: i64) -> IO(i64) {
        return IO(i64){ .performed = false, .value = add_one(io.value) };
    }

    // bind(io: IO(T), fn: fn(T) -> IO(U)) → IO(U)
    fn bind(io: IO(i64), f: i64) -> IO(i64) {
        add_one(io.value);
        io
    }

    // perform(io: IO(T)) → T
    fn perform(comptime T: type, io: IO(T)) -> T {
        io.value
    }

    // simple helper function
    fn add_one(x: i64) -> i64 {
        x + 1
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test pure_basic_case
        given input = 7
        when result = pure(i64, input)
        then result.value == input
        then result.performed == false

    // map and bind take `f` as a placeholder i64 and ignore it (map always adds one), and
    // t27 has no function literal to pass instead, so their functor laws are not testable
    // here yet. The three given/when/then blocks that tried were discarded by the parser.

    test perform_basic_case
        given input = 7
        when io = pure(i64, input)
        when result = perform(i64, io)
        then result == input