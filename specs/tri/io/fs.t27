// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Platform-aware paths | φ² + 1/φ² = 3 | TRINITY

// The draft did not compile: FileInfo.modified named an undeclared `Instant`, every
// field type was written as a quoted string, and the functions used an allocator,
// `++` on runtime slices, `?[]const u8` and `isize` indices into slices. All four
// tests asserted `result != undefined`/`!= ""` on `default_input()`, which is not
// defined anywhere, so none of them checked a path.
// - `modified` is a u64 timestamp (nanoseconds).
// - join and dirname write into a caller-provided buffer instead of allocating.
// - extension returns "" when there is no extension (the draft's null case: no dot, or
//   a dot in the last position); has_extension tells the two apart from a real one.
// - dirname of an absolute path keeps the leading "/" (the draft dropped it, so
//   "/usr/local" and "usr/local" both gave "usr").

module TriFs;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Path = struct {
        parts : []str,
        absolute : bool,
    };

    pub const FileInfo = struct {
        size : u64,
        is_dir : bool,
        is_file : bool,
        modified : u64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // base followed by suffix, parts copied into out; when out is too small the result
    // has no parts.
    fn join(base: Path, suffix: Path, out: []str) -> Path {
        const total = base.parts.len + suffix.parts.len;
        if (total > out.len) {
            return Path{ .parts = out[0 .. 0], .absolute = base.absolute };
        }
        var i : usize = 0;
        while (i < base.parts.len) {
            out[i] = base.parts[i];
            i = i + 1;
        }
        var j : usize = 0;
        while (j < suffix.parts.len) {
            out[i + j] = suffix.parts[j];
            j = j + 1;
        }
        return Path{ .parts = out[0 .. total], .absolute = base.absolute };
    }

    fn basename(path: Path) -> []const u8 {
        if (path.parts.len == 0) {
            return "";
        }
        return path.parts[path.parts.len - 1];
    }

    // all parts but the last, joined by "/" into out
    fn dirname(path: Path, out: []u8) -> []u8 {
        var n : usize = 0;
        if (path.parts.len == 0) {
            return out[0 .. 0];
        }
        if (path.absolute) {
            out[0] = '/';
            n = 1;
        }
        var i : usize = 0;
        while (i < path.parts.len - 1) {
            if (i > 0) {
                out[n] = '/';
                n = n + 1;
            }
            var k : usize = 0;
            while (k < path.parts[i].len) {
                out[n] = path.parts[i][k];
                n = n + 1;
                k = k + 1;
            }
            i = i + 1;
        }
        return out[0 .. n];
    }

    // text after the last dot of the last part; "" when there is no dot or it is last
    fn extension(path: Path) -> []const u8 {
        if (path.parts.len == 0) {
            return "";
        }
        const last_part = path.parts[path.parts.len - 1];
        var found : bool = false;
        var dot_pos : usize = 0;
        var i : usize = 0;
        while (i < last_part.len) {
            if (last_part[i] == '.') {
                found = true;
                dot_pos = i;
            }
            i = i + 1;
        }
        if (!found or dot_pos == last_part.len - 1) {
            return "";
        }
        return last_part[dot_pos + 1 .. last_part.len];
    }

    fn has_extension(path: Path) -> bool {
        return extension(path).len > 0;
    }

    // ═══════════════════════════════════════════════════════════
    // Helpers for the tests
    // ═══════════════════════════════════════════════════════════

    fn dirname_is(path: Path, expected: []const u8) -> bool {
        var buf : [64]u8 = undefined;
        return std.mem.eql(u8, dirname(path, &buf), expected);
    }

    fn join_is(base: Path, suffix: Path, expected_count: usize, expected_last: []const u8) -> bool {
        var out : [8][]const u8 = [""] ** 8;
        const joined = join(base, suffix, &out);
        if (joined.parts.len != expected_count) {
            return false;
        }
        return std.mem.eql(u8, basename(joined), expected_last);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // The draft's tests had no inputs (`default_input()` is undefined); each one now
    // builds a small path and checks the value the function returns.
    test join_basic_case {
        var a : [2][]const u8 = ["usr", "local"];
        var b : [2][]const u8 = ["bin", "t27c"];
        const base = Path{ .parts = &a, .absolute = true };
        const suffix = Path{ .parts = &b, .absolute = false };
        assert(join_is(base, suffix, 4, "t27c"));
        var out : [8][]const u8 = [""] ** 8;
        const joined = join(base, suffix, &out);
        assert(joined.absolute);
        assert(std.mem.eql(u8, joined.parts[0], "usr"));
        assert(std.mem.eql(u8, joined.parts[2], "bin"));
    }

    test join_too_small_buffer_gives_no_parts {
        var a : [2][]const u8 = ["usr", "local"];
        var b : [2][]const u8 = ["bin", "t27c"];
        const base = Path{ .parts = &a, .absolute = true };
        const suffix = Path{ .parts = &b, .absolute = false };
        var out : [3][]const u8 = [""] ** 3;
        const joined = join(base, suffix, &out);
        assert(joined.parts.len == 0);
    }

    test basename_basic_case {
        var a : [3][]const u8 = ["usr", "local", "t27.zig"];
        const p = Path{ .parts = &a, .absolute = true };
        assert(std.mem.eql(u8, basename(p), "t27.zig"));
        var none : [1][]const u8 = [""];
        const empty = Path{ .parts = none[0 .. 0], .absolute = false };
        assert(std.mem.eql(u8, basename(empty), ""));
    }

    test dirname_basic_case {
        var a : [3][]const u8 = ["usr", "local", "t27.zig"];
        const abs = Path{ .parts = &a, .absolute = true };
        const rel = Path{ .parts = &a, .absolute = false };
        assert(dirname_is(abs, "/usr/local"));
        assert(dirname_is(rel, "usr/local"));
        var one : [1][]const u8 = ["usr"];
        const root_child = Path{ .parts = &one, .absolute = true };
        const bare = Path{ .parts = &one, .absolute = false };
        assert(dirname_is(root_child, "/"));
        assert(dirname_is(bare, ""));
    }

    test extension_basic_case {
        var a : [2][]const u8 = ["src", "main.rs"];
        const p = Path{ .parts = &a, .absolute = false };
        assert(has_extension(p));
        assert(std.mem.eql(u8, extension(p), "rs"));
        var b : [1][]const u8 = ["Makefile"];
        const plain = Path{ .parts = &b, .absolute = false };
        assert(!has_extension(plain));
        var c : [1][]const u8 = ["trailing."];
        const dot_last = Path{ .parts = &c, .absolute = false };
        assert(!has_extension(dot_last));
        var d : [1][]const u8 = ["a.tar.gz"];
        const multi = Path{ .parts = &d, .absolute = false };
        assert(std.mem.eql(u8, extension(multi), "gz"));
    }
