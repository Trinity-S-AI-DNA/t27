// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Results don't end with separator (except root) | φ² + 1/φ² = 3 | TRINITY

// The draft built its results with std.ArrayList, an allocator and `for (x) |c, i|`
// captures, none of which the backend emits, and its path functions had four
// defects that the tests pin down:
// - basename and dirname started the last-separator search at 0, so a path with no
//   separator was cut after its first character ("t27c" -> "27c", dirname "/");
//   the search now remembers whether a separator was found at all.
// - basename of a path ending in a separator returned the whole path; the tests
//   (and the header: results don't end with a separator except the root) want "/".
// - normalize never wrote a separator between components, so "/usr//local" became
//   "/usrlocal"; it is now a component walk. A leading ".." of a relative path is
//   kept, since dropping it would change which file the path names.
// - ext and has_ext shadowed the functions they call.
// join and normalize write into a caller-provided buffer instead of allocating.
// The empty PathError enum is gone (nothing refers to it).

module TriFilesystem;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const FileInfo = struct {
        path : []const u8,
        size : u64,
        is_dir : bool,
        is_file : bool,
        modified : u64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // parts joined by "/", written into out
    fn join(parts: []str, out: []u8) -> []u8 {
        var n : usize = 0;
        var i : usize = 0;
        while (i < parts.len) {
            if (i > 0) {
                out[n] = '/';
                n = n + 1;
            }
            var k : usize = 0;
            while (k < parts[i].len) {
                out[n] = parts[i][k];
                n = n + 1;
                k = k + 1;
            }
            i = i + 1;
        }
        return out[0..n];
    }

    // index of the last '/', or the path length when there is none
    fn last_sep(path: []const u8) -> usize {
        var found : usize = path.len;
        var i : usize = 0;
        while (i < path.len) {
            if (path[i] == '/') {
                found = i;
            }
            i = i + 1;
        }
        return found;
    }

    fn basename(path: []const u8) -> []const u8 {
        if (path.len == 0) {
            return path;
        }
        const sep = last_sep(path);
        if (sep == path.len) {
            return path;
        }
        if (sep == path.len - 1) {
            return "/";
        }
        return path[sep + 1 .. path.len];
    }

    fn dirname(path: []const u8) -> []const u8 {
        if (path.len == 0) {
            return ".";
        }
        const sep = last_sep(path);
        if (sep == path.len) {
            return ".";
        }
        if (sep == 0) {
            return "/";
        }
        if (sep == path.len - 1) {
            const inner = last_sep(path[0 .. path.len - 1]);
            if (inner == path.len - 1 or inner == 0) {
                return "/";
            }
            return path[0 .. inner];
        }
        return path[0 .. sep];
    }

    fn ext(path: []const u8) -> []const u8 {
        const name = basename(path);
        if (name.len == 0) {
            return "";
        }
        var dot_pos : usize = 0;
        var i : usize = 0;
        while (i < name.len) {
            if (name[i] == '.') {
                dot_pos = i;
            }
            i = i + 1;
        }
        if (dot_pos == 0 or dot_pos == name.len - 1) {
            return "";
        }
        return name[dot_pos .. name.len];
    }

    fn has_ext(path: []const u8, suffix: []const u8) -> bool {
        return std.mem.eql(u8, ext(path), suffix);
    }

    fn is_absolute(path: []const u8) -> bool {
        return path.len > 0 and path[0] == '/';
    }

    // Lexical normalisation into out: drops empty and "." components, folds ".."
    // against the component before it (at the root it is dropped), "" becomes ".".
    fn normalize(path: []const u8, out: []u8) -> []u8 {
        var n : usize = 0;
        const rooted = is_absolute(path);
        if (rooted) {
            out[0] = '/';
            n = 1;
        }
        var floor : usize = n;
        var i : usize = 0;
        while (i < path.len) {
            var j : usize = i;
            while (j < path.len and path[j] != '/') {
                j = j + 1;
            }
            const comp = path[i .. j];
            if (comp.len == 0 or std.mem.eql(u8, comp, ".")) {
                // nothing to add
            } else if (std.mem.eql(u8, comp, "..")) {
                if (n > floor) {
                    while (n > floor and out[n - 1] != '/') {
                        n = n - 1;
                    }
                    if (n > floor) {
                        n = n - 1;
                    }
                } else if (!rooted) {
                    if (n > 0) {
                        out[n] = '/';
                        n = n + 1;
                    }
                    out[n] = '.';
                    out[n + 1] = '.';
                    n = n + 2;
                    floor = n;
                }
            } else {
                if (n > 0 and out[n - 1] != '/') {
                    out[n] = '/';
                    n = n + 1;
                }
                var k : usize = 0;
                while (k < comp.len) {
                    out[n] = comp[k];
                    n = n + 1;
                    k = k + 1;
                }
            }
            i = j + 1;
        }
        if (n == 0) {
            out[0] = '.';
            n = 1;
        }
        return out[0..n];
    }

    // ═══════════════════════════════════════════════════════════
    // Helpers for the tests
    // ═══════════════════════════════════════════════════════════

    fn norm_eq(path: []const u8, expected: []const u8) -> bool {
        var buf : [64]u8 = undefined;
        return std.mem.eql(u8, normalize(path, &buf), expected);
    }

    fn join_is(first: []const u8, second: []const u8, expected: []const u8) -> bool {
        var parts : [2][]const u8 = [first, second];
        var buf : [64]u8 = undefined;
        return std.mem.eql(u8, join(&parts, &buf), expected);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // The draft's *_basic_case tests only asserted `result != undefined` on an input that
    // does not exist; each one now checks the function's result on a small case.
    test join_basic_case
        given input = "a"
        when result = join_is(input, "b", "a/b")
        then result == true

    test basename_basic_case
        given input = "a/b"
        when result = basename(input)
        then std.mem.eql(u8, result, "b")

    test dirname_basic_case
        given input = "a/b"
        when result = dirname(input)
        then std.mem.eql(u8, result, "a")

    test ext_basic_case
        given input = "a/b.txt"
        when result = ext(input)
        then std.mem.eql(u8, result, ".txt")

    test has_ext_basic_case
        given input = "a/b.txt"
        when result = has_ext(input, ".txt")
        then result == true

    test is_absolute_basic_case
        given input = "/a"
        when result = is_absolute(input)
        then result == true

    test normalize_basic_case
        given input = "a/./b//c"
        when result = norm_eq(input, "a/b/c")
        then result == true

    test is_absolute_detects_absolute_paths
        given path = "/usr/local/bin"
        when result = is_absolute(path)
        then result == true

    test is_absolute_detects_relative_paths
        given path = "usr/local/bin"
        when result = is_absolute(path)
        then result == false

    test is_absolute_empty_path
        given path = ""
        when result = is_absolute(path)
        then result == false

    test basename_simple_path
        given path = "/usr/local/bin/t27c"
        when result = basename(path)
        then std.mem.eql(u8, result, "t27c")

    test basename_no_separator
        given path = "t27c"
        when result = basename(path)
        then std.mem.eql(u8, result, "t27c")

    test basename_root_path
        given path = "/"
        when result = basename(path)
        then std.mem.eql(u8, result, "/")

    test basename_trailing_separator
        given path = "/usr/local/bin/"
        when result = basename(path)
        then std.mem.eql(u8, result, "/")

    test dirname_simple_path
        given path = "/usr/local/bin/t27c"
        when result = dirname(path)
        then std.mem.eql(u8, result, "/usr/local/bin")

    test dirname_no_separator
        given path = "t27c"
        when result = dirname(path)
        then std.mem.eql(u8, result, ".")

    test dirname_root_path
        given path = "/"
        when result = dirname(path)
        then std.mem.eql(u8, result, "/")

    test dirname_single_level
        given path = "/t27c"
        when result = dirname(path)
        then std.mem.eql(u8, result, "/")

    test ext_with_extension
        given path = "/usr/local/bin/t27c.tar.gz"
        when result = ext(path)
        then std.mem.eql(u8, result, ".gz")

    test ext_no_extension
        given path = "/usr/local/bin/t27c"
        when result = ext(path)
        then std.mem.eql(u8, result, "")

    test ext_dotfile
        given path = "/usr/local/bin/.bashrc"
        when result = ext(path)
        then std.mem.eql(u8, result, "")

    test ext_multiple_dots
        given path = "/usr/local/bin/archive.tar.gz"
        when result = ext(path)
        then std.mem.eql(u8, result, ".gz")

    test has_ext_matches
        given path = "/usr/local/bin/t27c.tar.gz"
        when result = has_ext(path, ".gz")
        then result == true

    test has_ext_no_match
        given path = "/usr/local/bin/t27c.tar.gz"
        when result = has_ext(path, ".zip")
        then result == false

    test has_ext_no_extension
        given path = "/usr/local/bin/t27c"
        when result = has_ext(path, ".gz")
        then result == false

    test normalize_simple_path
        given path = "/usr/local/bin/t27c"
        when result = norm_eq(path, "/usr/local/bin/t27c")
        then result == true

    test normalize_remove_double_slashes
        given path = "/usr//local//bin/t27c"
        when result = norm_eq(path, "/usr/local/bin/t27c")
        then result == true

    test normalize_remove_current_dir
        given path = "/usr/./local/bin/t27c"
        when result = norm_eq(path, "/usr/local/bin/t27c")
        then result == true

    test normalize_parent_dir_simple
        given path = "/usr/local/../bin/t27c"
        when result = norm_eq(path, "/usr/bin/t27c")
        then result == true

    test normalize_parent_dir_root
        given path = "/usr/../local/bin/t27c"
        when result = norm_eq(path, "/local/bin/t27c")
        then result == true

    test normalize_parent_dir_escape_root
        given path = "/../../usr/local/bin/t27c"
        when result = norm_eq(path, "/usr/local/bin/t27c")
        then result == true

    test normalize_empty_path
        given path = ""
        when result = norm_eq(path, ".")
        then result == true

    test normalize_relative_path
        given path = "./usr/local/../bin/t27c"
        when result = norm_eq(path, "usr/bin/t27c")
        then result == true

    test join_reconstructs_path {
        var path = "/usr/local/bin/t27c";
        var parent = dirname(path);
        var base = basename(path);
        var parts : [2][]const u8 = [parent, base];
        var buf : [64]u8 = undefined;
        var result = join(&parts, &buf);
        assert(std.mem.eql(u8, result, path));
    }

    test relative_parent_dirs_are_kept {
        assert(norm_eq("../a", "../a"));
        assert(norm_eq("a/../../b", "../b"));
        assert(norm_eq("a/..", "."));
        assert(norm_eq("/", "/"));
    }

    test trailing_separator_paths {
        assert(std.mem.eql(u8, dirname("/usr/local/bin/"), "/usr/local"));
        assert(std.mem.eql(u8, dirname("/usr/"), "/"));
    }
