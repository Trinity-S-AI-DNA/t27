// SPDX-License-Identifier: Apache-2.0
// specs/tri/t27b_middle_end.t27 -- t27b middle-end passes: const-fold, DSE,
// CSE, LICM, strength reduction, better AArch64 ISel + peephole.
// Part of M3 milestone (milestone #7). Closes #12871 #13607.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::t27b_middle_end;

pub const T27B_MIDDLE_END_PASS_MAX : u32 = 8;

pub struct MiddleEndPass { name: str, enabled: bool };

pub fn middle_end_pass_enabled(p: MiddleEndPass) -> bool {
    return p.enabled;
}

test "middle_end_pass_enabled" {
    assert(middle_end_pass_enabled(MiddleEndPass { name: "const_fold", enabled: true }));
    assert(!middle_end_pass_enabled(MiddleEndPass { name: "licm", enabled: false }));
}

invariant t27b_middle_end_pass_max_positive {
    assert T27B_MIDDLE_END_PASS_MAX > 0;
}