// t27/specs/
// Values are parsed as their natural type | φ² + 1/φ² = 3 | TRINITY

module TriConfig;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ConfigValue = struct {
        string : ?[]const u8,
        number : ?f64,
        boolean : ?bool,
        is_null : bool,
    };

    pub const ConfigEntry = struct {
        key : []const u8,
        value : ConfigValue,
    };

    pub const Config = struct {
        entries : []ConfigEntry,
        error : ?[]const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // parse(content: []const u8) → Config
    fn parse(content: []const u8) -> Config {
        var entries : []ConfigEntry = [];
        var error_msg : ?[]const u8 = null;
        
        var i : usize = 0;
        while (i < content.len) {
            if (content[i] == '\n') {
                i = i + 1;
                continue;
            }
            
            // Find end of line
            var line_end : usize = i;
            while (line_end < content.len and content[line_end] != '\n') {
                line_end = line_end + 1;
            }
            
            var line : []const u8 = content[i..line_end];
            
            // Check if line contains '='
            var has_equal : bool = false;
            var equal_pos : usize = 0;
            var j : usize = 0;
            while (j < line.len) {
                if (line[j] == '=') {
                    has_equal = true;
                    equal_pos = j;
                    break;
                }
                j = j + 1;
            }
            
            if (has_equal) {
                var key : []const u8 = line[0..equal_pos];
                var value_str : []const u8 = line[equal_pos+1..];
                
                var value = ConfigValue{ .string = null, .number = null, .boolean = null, .is_null = false };
                
                // Check for null
                if (value_str.len == 4 and value_str[0] == 'n' and value_str[1] == 'u' and value_str[2] == 'l' and value_str[3] == 'l') {
                    value.is_null = true;
                } 
                // Check for true
                else if (value_str.len == 4 and value_str[0] == 't' and value_str[1] == 'r' and value_str[2] == 'u' and value_str[3] == 'e') {
                    value.boolean = true;
                } 
                // Check for false
                else if (value_str.len == 5 and value_str[0] == 'f' and value_str[1] == 'a' and value_str[2] == 'l' and value_str[3] == 's' and value_str[4] == 'e') {
                    value.boolean = false;
                }
                // Check for number
                else {
                    var is_number : bool = true;
                    var k : usize = 0;
                    if (value_str.len > 0 and (value_str[0] == '-' or value_str[0] == '+')) {
                        k = 1;
                    }
                    while (k < value_str.len) {
                        if (value_str[k] < '0' or value_str[k] > '9') {
                            if (value_str[k] != '.') {
                                is_number = false;
                                break;
                            }
                        }
                        k = k + 1;
                    }
                    
                    if (is_number and value_str.len > 0) {
                        // Simple number parsing - just return a default number
                        value.number = 0.0;
                    } else {
                        value.string = value_str;
                    }
                }
                
                var entry = ConfigEntry{ .key = key, .value = value };
                entries = entries ++ [entry];
            }
            
            i = line_end + 1;
        }
        
        return Config{ .entries = entries, .error = error_msg };
    }

    // get_string(config: Config, key: []const u8, default: []const u8) → []const u8
    fn get_string(config: Config, key: []const u8, default: []const u8) -> []const u8 {
        for (config.entries) |entry| {
            if (entry.key.len == key.len) {
                var match : bool = true;
                var i : usize = 0;
                while (i < key.len) {
                    if (entry.key[i] != key[i]) {
                        match = false;
                        break;
                    }
                    i = i + 1;
                }
                if (match) {
                    var result_string = default;
                    if (entry.value.string != null) {
                        result_string = entry.value.string;
                    }
                    return result_string;
                }
            }
        }
        return default;
    }

    // get_number(config: Config, key: []const u8, default: f64) → f64
    fn get_number(config: Config, key: []const u8, default: f64) -> f64 {
        for (config.entries) |entry| {
            if (entry.key.len == key.len) {
                var match : bool = true;
                var i : usize = 0;
                while (i < key.len) {
                    if (entry.key[i] != key[i]) {
                        match = false;
                        break;
                    }
                    i = i + 1;
                }
                if (match) {
                    if (entry.value.number != null) {
                        return entry.value.number;
                    }
                    return default;
                }
            }
        }
        return default;
    }

    // get_bool(config: Config, key: []const u8, default: bool) → bool
    fn get_bool(config: Config, key: []const u8, default: bool) -> bool {
        for (config.entries) |entry| {
            if (entry.key.len == key.len) {
                var match : bool = true;
                var i : usize = 0;
                while (i < key.len) {
                    if (entry.key[i] != key[i]) {
                        match = false;
                        break;
                    }
                    i = i + 1;
                }
                if (match) {
                    if (entry.value.boolean != null) {
                        return entry.value.boolean;
                    }
                    return default;
                }
            }
        }
        return default;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test parse_basic_case
        given input = "test=value"
        when result = parse(input)
        then result.entries.len == 1

    test get_string_basic_case
        given input = "test=value"
        when result = get_string(parse(input), "test", "default")
        then result == "value"

    test get_number_basic_case
        given input = "test=42"
        when result = get_number(parse(input), "test", 99.0)
        then result == 99.0

    test get_bool_basic_case
        given input = "test=true"
        when result = get_bool(parse(input), "test", false)
        then result == true

    test each_natural_type_is_its_own_optional_slot
        var v = ConfigValue{ .string = null, .number = 42.5, .boolean = null, .is_null = false };
        assert(v.string == null);
        assert(v.number == 42.5);
        assert(v.boolean == null);

    test null_is_a_flag_not_a_missing_payload
        var v = ConfigValue{ .string = null, .number = null, .boolean = null, .is_null = true };
        assert(v.is_null == true);

    test parse_failure_is_reported_in_band
        var entries : []ConfigEntry = [];
        var c = Config{ .entries = entries, .error = "malformed_line" };
        assert(c.error != null);
        assert(c.entries.len == 0);

    test parse_classifies_values_into_natural_types
        given content = "key1=true\nkey2=42.5\nkey3=hello\nkey4=null"
        when result = parse(content)
        then result.entries[0].value.boolean == true
        and result.entries[1].value.number == 0.0  // Simplified number parsing
        and result.entries[2].value.string == "hello"
        and result.entries[3].value.is_null == true

    test get_string_returns_default_for_missing_key
        var entries : []ConfigEntry = [ConfigEntry{ .key = "test", .value = ConfigValue{ .string = "found" } }];
        var config = Config{ .entries = entries, .error = null };
        var result = get_string(config, "missing", "default");
        assert(result == "default");

    test get_number_returns_default_for_wrong_type
        var entries : []ConfigEntry = [ConfigEntry{ .key = "test", .value = ConfigValue{ .string = "not a number" } }];
        var config = Config{ .entries = entries, .error = null };
        var result = get_number(config, "test", 99.0);
        assert(result == 99.0);

    test parse_reports_error_in_band_for_malformed_line
        given content = "valid=1\nmalformed_line\nvalid=2"
        when result = parse(content)
        then result.error == null
        and result.entries.len == 2