// t27/specs/
// Values are parsed as their natural type | φ² + 1/φ² = 3 | TRINITY

module TriConfig;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ConfigValue = struct {
        string : ?[]const u8,
        number : ?f64,
        boolean : ?bool,
        is_null : bool,
    };

    pub const ConfigEntry = struct {
        key : []const u8,
        value : ConfigValue,
    };

    pub const Config = struct {
        entries : []ConfigEntry,
        error : ?[]const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // The parsed entries live in one module-level table, so parse() needs no heap
    // allocation and no error union. The slice it returns is valid until the next
    // call to parse().
    const MAX_CONFIG_ENTRIES : usize = 64;
    var entry_storage : [64]ConfigEntry = undefined;

    fn is_space(c: u8) -> bool {
        return c == ' ' or c == '\t' or c == '\r';
    }

    // trim_slice(s) -> s without leading and trailing space, tab and carriage return
    fn trim_slice(s: []const u8) -> []const u8 {
        var start: usize = 0;
        var end: usize = s.len;
        while (start < end and is_space(s[start])) {
            start = start + 1;
        }
        while (end > start and is_space(s[end - 1])) {
            end = end - 1;
        }
        return s[start..end];
    }

    // is_number(s) -> true for an optional '-', digits, and an optional '.' followed by digits
    fn is_number(s: []const u8) -> bool {
        var i: usize = 0;
        if (s.len > 0 and s[0] == '-') {
            i = 1;
        }
        var digits: usize = 0;
        var dots: usize = 0;
        while (i < s.len) {
            if (s[i] >= '0' and s[i] <= '9') {
                digits = digits + 1;
            } else if (s[i] == '.') {
                dots = dots + 1;
            } else {
                return false;
            }
            i = i + 1;
        }
        return digits > 0 and dots <= 1;
    }

    // to_number(s) -> the value of a string for which is_number(s) holds
    fn to_number(s: []const u8) -> f64 {
        var i: usize = 0;
        var negative: bool = false;
        if (s.len > 0 and s[0] == '-') {
            negative = true;
            i = 1;
        }
        var whole: f64 = 0.0;
        var scale: f64 = 1.0;
        var after_dot: bool = false;
        while (i < s.len) {
            if (s[i] == '.') {
                after_dot = true;
            } else {
                var digit: f64 = @as(f64, @floatFromInt(s[i] - '0'));
                if (after_dot) {
                    scale = scale / 10.0;
                    whole = whole + digit * scale;
                } else {
                    whole = whole * 10.0 + digit;
                }
            }
            i = i + 1;
        }
        if (negative) {
            return 0.0 - whole;
        }
        return whole;
    }

    // parse(allocator: std.mem.Allocator, content: []const u8) -> Config
    // The allocator is accepted for API stability; the entries are kept in entry_storage.
    fn parse(allocator: std.mem.Allocator, content: []const u8) -> Config {
        var keep_allocator = allocator;
        var count: usize = 0;
        var pos: usize = 0;

        while (pos < content.len) {
            var line_end: usize = pos;
            while (line_end < content.len and content[line_end] != '\n') {
                line_end = line_end + 1;
            }
            var trimmed = trim_slice(content[pos..line_end]);
            pos = line_end + 1;

            if (trimmed.len == 0 or trimmed[0] == '#') {
                continue;
            }

            var eq_pos: usize = 0;
            while (eq_pos < trimmed.len and trimmed[eq_pos] != '=') {
                eq_pos = eq_pos + 1;
            }
            if (eq_pos == trimmed.len) {
                return Config{ .entries = entry_storage[0..count], .error = "Malformed config line: no = found" };
            }
            if (count >= MAX_CONFIG_ENTRIES) {
                return Config{ .entries = entry_storage[0..count], .error = "Too many config entries" };
            }

            var key = trim_slice(trimmed[0..eq_pos]);
            var value_str = trim_slice(trimmed[eq_pos + 1..trimmed.len]);

            var value = ConfigValue{ .string = null, .number = null, .boolean = null, .is_null = false };

            if (std.mem.eql(u8, value_str, "null")) {
                value.is_null = true;
            } else if (std.mem.eql(u8, value_str, "true")) {
                value.boolean = true;
            } else if (std.mem.eql(u8, value_str, "false")) {
                value.boolean = false;
            } else if (is_number(value_str)) {
                value.number = to_number(value_str);
            } else {
                value.string = value_str;
            }

            entry_storage[count] = ConfigEntry{ .key = key, .value = value };
            count = count + 1;
        }

        return Config{ .entries = entry_storage[0..count], .error = null };
    }

    // get_string(config: Config, key: []const u8, default: []const u8) -> []const u8
    fn get_string(config: Config, key: []const u8, default: []const u8) -> []const u8 {
        for (config.entries) |entry| {
            if (std.mem.eql(u8, entry.key, key)) {
                if (entry.value.string != null) {
                    return entry.value.string.?;
                }
                return default;
            }
        }
        return default;
    }

    // get_number(config: Config, key: []const u8, default: f64) -> f64
    fn get_number(config: Config, key: []const u8, default: f64) -> f64 {
        for (config.entries) |entry| {
            if (std.mem.eql(u8, entry.key, key)) {
                if (entry.value.number != null) {
                    return entry.value.number.?;
                }
                return default;
            }
        }
        return default;
    }

    // get_bool(config: Config, key: []const u8, default: bool) -> bool
    fn get_bool(config: Config, key: []const u8, default: bool) -> bool {
        for (config.entries) |entry| {
            if (std.mem.eql(u8, entry.key, key)) {
                if (entry.value.boolean != null) {
                    return entry.value.boolean.?;
                }
                return default;
            }
        }
        return default;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test parse_basic_case {
        var result = parse(std.testing.allocator, "name=trit");
        assert(result.error == null);
        assert(result.entries.len == 1);
        assert(result.entries[0].key == "name");
    }

    test get_string_basic_case {
        var result = parse(std.testing.allocator, "name=trit");
        assert(get_string(result, "name", "none") == "trit");
    }

    test get_number_basic_case {
        var result = parse(std.testing.allocator, "ratio=0.5");
        assert(get_number(result, "ratio", 1.0) == 0.5);
    }

    test get_bool_basic_case {
        var result = parse(std.testing.allocator, "on=true");
        assert(get_bool(result, "on", false) == true);
    }

    test each_natural_type_is_its_own_optional_slot {
        // A number fills its own slot and leaves the other two empty.
        var v = ConfigValue{ .string = null, .number = 42.5, .boolean = null, .is_null = false };
        assert(v.string == null);
        assert(v.number == 42.5);
        assert(v.boolean == null);
    }

    test null_is_a_flag_not_a_missing_payload {
        // null is carried by the is_null flag, not by leaving every payload slot empty.
        assert(@FieldType(ConfigValue, "is_null") == bool);
        var result = parse(std.testing.allocator, "gone=null");
        assert(result.entries[0].value.is_null == true);
        assert(result.entries[0].value.string == null);
        assert(result.entries[0].value.number == null);
        assert(result.entries[0].value.boolean == null);
    }

    test parse_failure_is_reported_in_band {
        // The error is a field of the result, next to the entries, not a separate channel.
        var none : [0]ConfigEntry = [];
        var c = Config{ .entries = &none, .error = "malformed_line" };
        assert(c.error != null);
        assert(c.entries.len == 0);
    }

    test parse_classifies_values_into_natural_types
        given content = "key1=true\nkey2=42.5\nkey3=hello\nkey4=null"
        when result = parse(std.testing.allocator, content)
        then result.entries[0].value.boolean == true
        and result.entries[1].value.number == 42.5
        and result.entries[2].value.string.? == "hello"
        and result.entries[3].value.is_null == true

    test get_string_returns_default_for_missing_key {
        var entries : [1]ConfigEntry = [ConfigEntry{ .key = "test", .value = ConfigValue{ .string = "found", .number = null, .boolean = null, .is_null = false } }];
        var config = Config{ .entries = &entries, .error = null };
        var result = get_string(config, "missing", "default");
        assert(result == "default");
    }

    test get_number_returns_default_for_wrong_type {
        var entries : [1]ConfigEntry = [ConfigEntry{ .key = "test", .value = ConfigValue{ .string = "not a number", .number = null, .boolean = null, .is_null = false } }];
        var config = Config{ .entries = &entries, .error = null };
        var result = get_number(config, "test", 99.0);
        assert(result == 99.0);
    }

    test parse_reports_error_in_band_for_malformed_line
        given content = "valid=1\nmalformed_line\nvalid=2"
        when result = parse(std.testing.allocator, content)
        then result.error != null
        and result.entries.len == 1

