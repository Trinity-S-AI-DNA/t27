// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Monotonic clock | φ² + 1/φ² = 3 | TRINITY

module TriTime;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Instant = struct {
        epoch_seconds : i64,
        nanos : u32,
    };

    pub const Duration = struct {
        seconds : i64,
        nanos : u32,
    };

    const NANOS_PER_SECOND : i64 = 1000000000;

    // format() builds its result in this module-level buffer, so it needs no heap
    // allocation and no error union. The slice is valid until the next call to format().
    var format_buffer : [64]u8 = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // total_nanos(instant) -> the instant as nanoseconds since its origin
    fn total_nanos(instant: Instant) -> i64 {
        return instant.epoch_seconds * NANOS_PER_SECOND + @as(i64, instant.nanos);
    }

    // instant_from_nanos(total) -> a normalized instant (nanos below one second)
    fn instant_from_nanos(total: i64) -> Instant {
        return Instant {
            .epoch_seconds = @divFloor(total, NANOS_PER_SECOND),
            .nanos = @as(u32, @intCast(@mod(total, NANOS_PER_SECOND))),
        };
    }

    // duration_from_nanos(total) -> a normalized duration (nanos below one second)
    fn duration_from_nanos(total: i64) -> Duration {
        return Duration {
            .seconds = @divFloor(total, NANOS_PER_SECOND),
            .nanos = @as(u32, @intCast(@mod(total, NANOS_PER_SECOND))),
        };
    }

    // now() -> Instant
    // Reads the Linux monotonic clock (CLOCK_MONOTONIC).
    fn now() -> Instant {
        var ts: std.os.linux.timespec = undefined;
        var rc = std.os.linux.clock_gettime(std.os.linux.CLOCK.MONOTONIC, &ts);
        if (rc != 0) {
            return Instant { .epoch_seconds = 0, .nanos = 0 };
        }
        return Instant {
            .epoch_seconds = @as(i64, @intCast(ts.sec)),
            .nanos = @as(u32, @intCast(ts.nsec)),
        };
    }

    // since_epoch(instant: Instant) -> Duration
    // The duration from the given instant to the present.
    fn since_epoch(instant: Instant) -> Duration {
        var current = now();
        return duration_from_nanos(total_nanos(current) - total_nanos(instant));
    }

    // add(instant: Instant, duration: Duration) -> Instant
    fn add(instant: Instant, duration: Duration) -> Instant {
        var total = total_nanos(instant) + duration.seconds * NANOS_PER_SECOND + @as(i64, duration.nanos);
        return instant_from_nanos(total);
    }

    // sub(a: Instant, b: Instant) -> Duration
    fn sub(a: Instant, b: Instant) -> Duration {
        return duration_from_nanos(total_nanos(a) - total_nanos(b));
    }

    // put_decimal(len, value, min_digits) -> the new length after writing value in decimal,
    // left-padded with zeros to at least min_digits digits
    fn put_decimal(len: usize, value: u64, min_digits: usize) -> usize {
        var digits: usize = 1;
        var rest: u64 = value / 10;
        while (rest > 0) {
            digits = digits + 1;
            rest = rest / 10;
        }
        var width: usize = digits;
        if (min_digits > width) {
            width = min_digits;
        }
        var v: u64 = value;
        var k: usize = 0;
        while (k < width) {
            format_buffer[len + width - 1 - k] = '0' + @as(u8, @intCast(v % 10));
            v = v / 10;
            k = k + 1;
        }
        return len + width;
    }

    // format(instant: Instant, fmt: []const u8, allocator: std.mem.Allocator) -> []u8
    // A basic ISO 8601 shape: 1970-01-01T00:00:<epoch seconds>.<nanos padded to 9 digits>Z
    // The fmt and allocator parameters are accepted for API stability.
    fn format(instant: Instant, fmt: []const u8, allocator: std.mem.Allocator) -> []u8 {
        var held_fmt = fmt;
        var held_allocator = allocator;
        var prefix = "1970-01-01T00:00:";
        var len: usize = 0;
        for (prefix) |c| {
            format_buffer[len] = c;
            len = len + 1;
        }
        if (instant.epoch_seconds < 0) {
            format_buffer[len] = '-';
            len = len + 1;
            len = put_decimal(len, @as(u64, @intCast(0 - instant.epoch_seconds)), 1);
        } else {
            len = put_decimal(len, @as(u64, @intCast(instant.epoch_seconds)), 1);
        }
        format_buffer[len] = '.';
        len = len + 1;
        len = put_decimal(len, @as(u64, instant.nanos), 9);
        format_buffer[len] = 'Z';
        len = len + 1;
        return format_buffer[0..len];
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "now_returns_valid_instant" {
        var instant = now();
        assert(instant.epoch_seconds >= 0);
        assert(instant.nanos < 1000000000);
        assert(instant.nanos >= 0);
    }

    test "since_epoch_calculates_duration" {
        var start = now();
        var duration = since_epoch(start);
        assert(duration.seconds >= 0);
        assert(duration.nanos < 1000000000);
        assert(duration.nanos >= 0);
    }

    test "add_instant_with_duration" {
        var base = Instant { .epoch_seconds = 1000, .nanos = 500000000 };
        var duration = Duration { .seconds = 10, .nanos = 500000000 };
        var result = add(base, duration);
        // 1000.5 s + 10.5 s = 1011.0 s: the half seconds carry into the seconds field
        assert(result.epoch_seconds == 1011);
        assert(result.nanos == 0);
    }

    test "sub_instants_returns_duration" {
        var instant1 = Instant { .epoch_seconds = 2000, .nanos = 750000000 };
        var instant2 = Instant { .epoch_seconds = 1000, .nanos = 250000000 };
        var duration = sub(instant1, instant2);
        assert(duration.seconds == 1000);
        assert(duration.nanos == 500000000);
    }

    test "format_instant_to_string" {
        var instant = Instant { .epoch_seconds = 1234567890, .nanos = 123456789 };
        var result = format(instant, "iso", std.testing.allocator);
        assert(result.len > 0);
        // Should contain the epoch seconds and nanos
        assert(std.mem.indexOf(u8, result, "1234567890") != null);
        assert(std.mem.indexOf(u8, result, "123456789") != null);
        assert(result == "1970-01-01T00:00:1234567890.123456789Z");
    }
