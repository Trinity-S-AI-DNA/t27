// t27/specs/
// Basic ASCII text processing | φ² + 1/φ² = 3 | TRINITY

module TriText;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const TextMetrics = struct {
        width : usize,
        height : usize,
        lines : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Results of word_wrap and indent are built in one module-level buffer, so neither
    // needs a heap allocation or an error union. A result is valid until the next call
    // to word_wrap or indent, and is cut at TEXT_BUFFER_SIZE bytes.
    const TEXT_BUFFER_SIZE : usize = 4096;
    var text_buffer : [4096]u8 = undefined;

    // put_byte(len, c) -> the new length after appending c to text_buffer (dropped when full)
    fn put_byte(len: usize, c: u8) -> usize {
        if (len >= TEXT_BUFFER_SIZE) {
            return len;
        }
        text_buffer[len] = c;
        return len + 1;
    }

    // put_slice(len, s) -> the new length after appending s to text_buffer
    fn put_slice(len: usize, s: []const u8) -> usize {
        var out_len: usize = len;
        for (s) |c| {
            out_len = put_byte(out_len, c);
        }
        return out_len;
    }

    fn is_blank_byte(c: u8) -> bool {
        return c == ' ' or c == '\t' or c == '\n' or c == '\r';
    }

    // word_wrap(allocator: std.mem.Allocator, text: []const u8, width: usize) -> []u8
    // Greedy wrap to width columns: accumulate words separated by single spaces,
    // break to a new line before the word that would exceed width, never split a word.
    // A word longer than width goes on its own line rather than being truncated.
    // Width of 0 returns a copy of the input rather than looping forever.
    fn word_wrap(allocator: std.mem.Allocator, text: []const u8, width: usize) -> []u8 {
        var held_allocator = allocator;
        var out_len: usize = 0;
        if (width == 0) {
            out_len = put_slice(0, text);
            return text_buffer[0..out_len];
        }

        var line_length: usize = 0;
        var i: usize = 0;

        while (i < text.len) {
            // Find end of current word
            var word_start: usize = i;
            while (i < text.len and !is_blank_byte(text[i])) {
                i = i + 1;
            }
            var word_end: usize = i;

            // Skip the whitespace after the word
            while (i < text.len and is_blank_byte(text[i])) {
                i = i + 1;
            }

            var word_len: usize = word_end - word_start;

            // Check if word fits on current line
            if (line_length > 0) {
                if (line_length + 1 + word_len <= width) {
                    out_len = put_byte(out_len, ' ');
                    line_length = line_length + 1;
                } else {
                    out_len = put_byte(out_len, '\n');
                    line_length = 0;
                }
            }

            // Add word to result
            out_len = put_slice(out_len, text[word_start..word_end]);
            line_length = line_length + word_len;
        }

        return text_buffer[0..out_len];
    }

    // count_words(text: []const u8) -> usize
    // Count the number of runs of non-whitespace bytes. Whitespace is space, tab,
    // newline and carriage return. Empty input is 0; leading, trailing and repeated
    // separators must not inflate the count, which means counting transitions into a word.
    fn count_words(text: []const u8) -> usize {
        if (text.len == 0) {
            return 0;
        }
        
        var count: usize = 0;
        var in_word: bool = false;
        
        for (text) |char| {
            if (char == ' ' or char == '\t' or char == '\n' or char == '\r') {
                in_word = false;
            } else {
                if (!in_word) {
                    count = count + 1;
                }
                in_word = true;
            }
        }
        
        return count;
    }

    // count_lines(text: []const u8) -> usize
    // Count the number of lines. Rule: "number of `\n` bytes, plus one if the text is
    // non-empty and does not end in `\n`", so "" is 0, "a" is 1, "a\n" is 1 and "a\nb" is 2.
    fn count_lines(text: []const u8) -> usize {
        if (text.len == 0) {
            return 0;
        }
        
        var line_count: usize = 0;
        
        for (text) |char| {
            if (char == '\n') {
                line_count = line_count + 1;
            }
        }
        
        // Add one if text is non-empty and doesn't end with newline
        if (text[text.len - 1] != '\n') {
            line_count = line_count + 1;
        }
        
        return line_count;
    }

    // indent(allocator: std.mem.Allocator, text: []const u8, spaces: usize) -> []u8
    // Prefix every line with `spaces` space characters, including the first, and
    // including lines after the final newline only if that trailing piece is non-empty.
    // Do not indent a blank line into a line of trailing whitespace: leave empty lines empty.
    fn indent(allocator: std.mem.Allocator, text: []const u8, spaces: usize) -> []u8 {
        var held_allocator = allocator;
        var out_len: usize = 0;
        var i: usize = 0;

        while (i < text.len) {
            // Find end of current line
            var line_end: usize = i;
            while (line_end < text.len and text[line_end] != '\n') {
                line_end = line_end + 1;
            }

            // Only a non-empty line gets indentation
            var line_len: usize = line_end - i;
            if (line_len > 0) {
                var k: usize = 0;
                while (k < spaces) {
                    out_len = put_byte(out_len, ' ');
                    k = k + 1;
                }
                out_len = put_slice(out_len, text[i..line_end]);
            }

            // Keep the newline if there is one
            if (line_end < text.len) {
                out_len = put_byte(out_len, '\n');
            }

            i = line_end + 1;
        }

        return text_buffer[0..out_len];
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test word_wrap_basic_case {
        var result = word_wrap(std.testing.allocator, "aaa bbb ccc", 7);
        assert(result == "aaa bbb\nccc");
    }

    test count_words_basic_case {
        var result = count_words("one two three");
        assert(result == 3);
    }

    test count_lines_basic_case {
        var result = count_lines("a\nb\nc");
        assert(result == 3);
    }

    test indent_basic_case {
        var result = indent(std.testing.allocator, "ab\ncd", 2);
        assert(result == "  ab\n  cd");
    }

    test count_words_empty_input
        given input = ""
        when result = count_words(input)
        then result == 0

    test count_words_with_separators
        given input = "  a   b  "
        when result = count_words(input)
        then result == 2

    test count_lines_simple_text
        given input = "a"
        when result = count_lines(input)
        then result == 1

    test count_lines_with_newline
        given input = "a\n"
        when result = count_lines(input)
        then result == 1

    test count_lines_multiple_lines
        given input = "a\nb"
        when result = count_lines(input)
        then result == 2

    test word_wrap_break_between_words {
        var result = word_wrap(std.testing.allocator, "aaa bbb", 5);
        assert(result == "aaa\nbbb");
    }

    test word_wrap_long_word_stays_whole {
        var result = word_wrap(std.testing.allocator, "abcdefgh ij", 4);
        assert(result == "abcdefgh\nij");
    }

    test word_wrap_zero_width_copies_input {
        var result = word_wrap(std.testing.allocator, "a b", 0);
        assert(result == "a b");
    }

    test indent_empty_line {
        var result = indent(std.testing.allocator, "", 2);
        assert(result == "");
    }

    test indent_leaves_blank_lines_empty {
        var result = indent(std.testing.allocator, "a\n\nb\n", 2);
        assert(result == "  a\n\n  b\n");
    }
