// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Xorshift64* PRNG algorithm | φ² + 1/φ² = 3 | TRINITY

module TriRandom;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Rng = struct {
        state : u64,
    };

    const XORSHIFT_MULTIPLIER : u64 = 2685821657736338717;
    const DEFAULT_SEED : u64 = 88172645463325252;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(seed: u64) → Rng
    fn init(seed: u64) -> Rng {
        var state : u64 = seed;
        if (state == 0) {
            state = DEFAULT_SEED;
        }
        return Rng { .state = state };
    }

    // next(rng: *Rng) → u64
    fn next(rng: *Rng) -> u64 {
        var x = rng.state;
        x = x ^ (x >> 12);
        x = x ^ (x << 25);
        x = x ^ (x >> 27);
        rng.state = x;
        return x *% XORSHIFT_MULTIPLIER;
    }

    // range(rng: *Rng, max: u64) → u64
    fn range(rng: *Rng, max: u64) -> u64 {
        if (max == 0) {
            return 0;
        }
        var value = next(rng);
        return value % max;
    }

    // range_inclusive(rng: *Rng, min: i64, max: i64) → i64
    fn range_inclusive(rng: *Rng, min: i64, max: i64) -> i64 {
        var range_size = max - min + 1;
        var value = range(rng, @as(u64, @intCast(range_size)));
        return @as(i64, @intCast(min)) + @as(i64, @intCast(value));
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "init_basic_case" {
        var rng = init(12345);
        assert(rng.state == 12345);
    }

    test "next_basic_case" {
        // Seed 1: x = 1, x ^= x >> 12 gives 1, x ^= x << 25 gives 33554433, x ^= x >> 27 keeps it.
        var rng = init(1);
        var first = next(&rng);
        assert(rng.state == 33554433);
        assert(first == 5180492295206395165);
    }

    test "range_basic_case" {
        var rng = init(42);
        var value = range(&rng, 10);
        assert(value < 10);
    }

    test "range_inclusive_basic_case" {
        var rng = init(42);
        var value = range_inclusive(&rng, 3, 7);
        assert(value >= 3);
        assert(value <= 7);
    }

    test "init_replaces_the_zero_seed"
        given rng = init(0)
        then rng.state != 0

    test "the_multiplier_is_the_star_in_xorshift64_star" {
        // Verify: the output stage multiplies by 2685821657736338717, which is
        // odd and therefore invertible modulo 2^64 -- it scrambles the bits
        // without ever mapping two states onto one output
        var multiplier : u64 = XORSHIFT_MULTIPLIER;
        var parity : u64 = multiplier % 2;
        assert(multiplier == 2685821657736338717);
        assert(parity == 1);
    }

    test "range_endpoints_bound_a_half_open_interval" {
        // Verify: range(max) spans max values and range_inclusive(lo, hi) spans one
        // more than hi - lo, which is the only difference between the two entry points
        var rng = init(7);
        var lo : i64 = 3;
        var hi : i64 = 7;
        var half_open : i64 = hi - lo;
        var inclusive : i64 = hi - lo + 1;
        assert(half_open == 4);
        assert(inclusive == 5);
        var seen_max : u64 = 0;
        var inc_min : i64 = hi;
        var inc_max : i64 = lo;
        var i : u32 = 0;
        while (i < 500) {
            var a = range(&rng, @as(u64, @intCast(half_open)));
            if (a > seen_max) {
                seen_max = a;
            }
            var b = range_inclusive(&rng, lo, hi);
            if (b < inc_min) {
                inc_min = b;
            }
            if (b > inc_max) {
                inc_max = b;
            }
            i = i + 1;
        }
        assert(seen_max == 3);
        assert(inc_min == 3);
        assert(inc_max == 7);
    }

    test "next_follows_xorshift64_star_algorithm" {
        var rng = init(1);
        var first = next(&rng);
        var second = next(&rng);
        assert(first == 5180492295206395165);
        assert(second == 12380297144915551517);
        assert(first != second);
    }

    test "range_returns_zero_for_max_zero" {
        var rng = init(42);
        var result = range(&rng, 0);
        assert(result == 0);
    }

    test "range_inclusive_handles_single_value_range" {
        var rng = init(42);
        var result = range_inclusive(&rng, 5, 5);
        assert(result == 5);
    }
