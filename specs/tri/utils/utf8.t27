// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Full Unicode support | φ² + 1/φ² = 3 | TRINITY

module TriUtf8;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Codepoint = struct {
        underlying : u21,
    };

    pub const Rune = struct {
        bytes : [4]u8,
        len : u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // decode(str: []const u8, index: usize) → Rune
    fn decode(str: []const u8, index: usize) -> Rune {
        var result: Rune = Rune { .bytes = [0, 0, 0, 0], .len = 0 };
        
        if (index >= str.len) {
            return result;
        }
        
        const first_byte = str[index];
        
        // Determine the number of bytes in this UTF-8 sequence
        if (first_byte & 0x80 == 0) {
            // 1-byte sequence (0xxxxxxx)
            result.bytes[0] = first_byte;
            result.len = 1;
        } else if ((first_byte & 0xE0) == 0xC0) {
            // 2-byte sequence (110xxxxx)
            if (index + 1 < str.len) {
                result.bytes[0] = first_byte;
                result.bytes[1] = str[index + 1];
                result.len = 2;
            }
        } else if ((first_byte & 0xF0) == 0xE0) {
            // 3-byte sequence (1110xxxx)
            if (index + 2 < str.len) {
                result.bytes[0] = first_byte;
                result.bytes[1] = str[index + 1];
                result.bytes[2] = str[index + 2];
                result.len = 3;
            }
        } else if ((first_byte & 0xF8) == 0xF0) {
            // 4-byte sequence (11110xxx)
            if (index + 3 < str.len) {
                result.bytes[0] = first_byte;
                result.bytes[1] = str[index + 1];
                result.bytes[2] = str[index + 2];
                result.bytes[3] = str[index + 3];
                result.len = 4;
            }
        }
        
        return result;
    }

    // The bytes of an encoded codepoint are built in this module-level buffer, so encode
    // needs no heap allocation and no error union. The slice is valid until the next call.
    var utf8_buffer : [4]u8 = undefined;

    // encode(codepoint: Codepoint, allocator: std.mem.Allocator) -> []u8
    // An invalid codepoint (above 0x10FFFF) encodes to an empty slice.
    fn encode(codepoint: Codepoint, allocator: std.mem.Allocator) -> []u8 {
        var held_allocator = allocator;
        const cp = codepoint.underlying;

        if (cp <= 0x7F) {
            // 1-byte sequence
            utf8_buffer[0] = @as(u8, @truncate(cp));
            return utf8_buffer[0..1];
        } else if (cp <= 0x7FF) {
            // 2-byte sequence
            utf8_buffer[0] = @as(u8, @truncate((cp >> 6) | 0xC0));
            utf8_buffer[1] = @as(u8, @truncate((cp & 0x3F) | 0x80));
            return utf8_buffer[0..2];
        } else if (cp <= 0xFFFF) {
            // 3-byte sequence
            utf8_buffer[0] = @as(u8, @truncate((cp >> 12) | 0xE0));
            utf8_buffer[1] = @as(u8, @truncate(((cp >> 6) & 0x3F) | 0x80));
            utf8_buffer[2] = @as(u8, @truncate((cp & 0x3F) | 0x80));
            return utf8_buffer[0..3];
        } else if (cp <= 0x10FFFF) {
            // 4-byte sequence
            utf8_buffer[0] = @as(u8, @truncate((cp >> 18) | 0xF0));
            utf8_buffer[1] = @as(u8, @truncate(((cp >> 12) & 0x3F) | 0x80));
            utf8_buffer[2] = @as(u8, @truncate(((cp >> 6) & 0x3F) | 0x80));
            utf8_buffer[3] = @as(u8, @truncate((cp & 0x3F) | 0x80));
            return utf8_buffer[0..4];
        }
        // Invalid Unicode codepoint
        return utf8_buffer[0..0];
    }

    // count_codepoints(str: []const u8) → usize
    fn count_codepoints(str: []const u8) -> usize {
        var count: usize = 0;
        var i: usize = 0;
        
        while (i < str.len) {
            const byte = str[i];
            
            // Check if this is a UTF-8 continuation byte
            if (byte & 0x80 == 0) {
                // 1-byte sequence
                count = count + 1;
                i = i + 1;
            } else if ((byte & 0xE0) == 0xC0) {
                // 2-byte sequence
                count = count + 1;
                i = i + 2;
            } else if ((byte & 0xF0) == 0xE0) {
                // 3-byte sequence
                count = count + 1;
                i = i + 3;
            } else if ((byte & 0xF8) == 0xF0) {
                // 4-byte sequence
                count = count + 1;
                i = i + 4;
            } else {
                // Invalid UTF-8 sequence, skip this byte
                i = i + 1;
            }
        }
        
        return count;
    }

    // validate(str: []const u8) → bool
    fn validate(str: []const u8) -> bool {
        var i: usize = 0;
        
        while (i < str.len) {
            const byte = str[i];
            
            if (byte & 0x80 == 0) {
                // 1-byte sequence (0xxxxxxx) - valid
                i = i + 1;
            } else if ((byte & 0xE0) == 0xC0) {
                // 2-byte sequence (110xxxxx)
                if (i + 1 >= str.len) {
                    return false; // Missing continuation byte
                }
                const cont1 = str[i + 1];
                if ((cont1 & 0xC0) != 0x80) {
                    return false; // Invalid continuation byte
                }
                i = i + 2;
            } else if ((byte & 0xF0) == 0xE0) {
                // 3-byte sequence (1110xxxx)
                if (i + 2 >= str.len) {
                    return false; // Missing continuation bytes
                }
                const cont1 = str[i + 1];
                const cont2 = str[i + 2];
                if ((cont1 & 0xC0) != 0x80 or (cont2 & 0xC0) != 0x80) {
                    return false; // Invalid continuation bytes
                }
                // Check for overlong encoding
                if (byte == 0xE0 and cont1 < 0xA0) {
                    return false; // Overlong 2-byte sequence
                }
                i = i + 3;
            } else if ((byte & 0xF8) == 0xF0) {
                // 4-byte sequence (11110xxx)
                if (i + 3 >= str.len) {
                    return false; // Missing continuation bytes
                }
                const cont1 = str[i + 1];
                const cont2 = str[i + 2];
                const cont3 = str[i + 3];
                if ((cont1 & 0xC0) != 0x80 or (cont2 & 0xC0) != 0x80 or (cont3 & 0xC0) != 0x80) {
                    return false; // Invalid continuation bytes
                }
                // Check for codepoints > 0x10FFFF
                if (byte > 0xF4) {
                    return false; // Codepoint too large
                }
                if (byte == 0xF4 and cont1 > 0x8F) {
                    return false; // Codepoint > 0x10FFFF
                }
                i = i + 4;
            } else {
                // Invalid UTF-8 start byte
                return false;
            }
        }
        
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test decode_basic_case {
        var result = decode("hello", 0);
        assert(result.len == 1);
        assert(result.bytes[0] == 'h');
    }

    test encode_basic_case {
        var input = Codepoint{ .underlying = 0x41 }; // 'A'
        var result = encode(input, std.testing.allocator);
        assert(result.len == 1);
        assert(result[0] == 0x41);
    }

    test count_codepoints_basic_case
        given input = "hello"
        when result = count_codepoints(input)
        then result == 5

    test validate_basic_case
        given input = "hello"
        when result = validate(input)
        then result == true

    test decode_multibyte_case {
        // "caf" followed by e-acute (0xC3 0xA9), written as bytes: the backend re-encodes
        // a non-ASCII string literal, which would change the bytes under test
        var input : [5]u8 = [99, 97, 102, 195, 169];
        var result = decode(input[0..5], 3); // the e-acute starts at index 3
        assert(result.len == 2);
        assert(result.bytes[0] == 195);
        assert(result.bytes[1] == 169);
    }

    test encode_multibyte_case {
        var input = Codepoint{ .underlying = 0xE9 }; // 'é'
        var result = encode(input, std.testing.allocator);
        assert(result.len == 2);
        assert(result[0] == 0xC3);
        assert(result[1] == 0xA9);
    }

    test count_codepoints_multibyte_case {
        // "caf" followed by e-acute (0xC3 0xA9): five bytes, four codepoints
        var input : [5]u8 = [99, 97, 102, 195, 169];
        var result = count_codepoints(input[0..5]);
        assert(result == 4);
    }

    test validate_invalid_case {
        // Two 0xFF bytes: never valid UTF-8
        var input : [2]u8 = [255, 255];
        var result = validate(input[0..2]);
        assert(result == false);
    }
