// SPDX-License-Identifier: Apache-2.0
// specs/tri/concierge_probe.t27 -- tri concierge probe, guard, claim: live
// checks of the GIVEL Mini App as a .t27 command table.
// Part of M7 milestone (milestone #11). Closes #13436.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::concierge_probe;

pub const CONCIERGE_PROBE_MAX_CHECKS : u32 = 16;

pub struct ProbeCheck { name: str, passed: bool };

pub fn probe_check_passed(p: ProbeCheck) -> bool {
    return p.passed;
}

test "probe_check_passed" {
    assert(probe_check_passed(ProbeCheck { name: "givel_mini_app", passed: true }));
    assert(!probe_check_passed(ProbeCheck { name: "givel_mini_app", passed: false }));
}

invariant concierge_probe_max_checks_positive {
    assert CONCIERGE_PROBE_MAX_CHECKS > 0;
}