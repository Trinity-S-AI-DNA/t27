// SPDX-License-Identifier: Apache-2.0
; specs/tri/mutate/speedup.t27 -- the Pareto acceleration rules of the mutation gate (Refs #10486)
; Owner rule 2026-10-27: three accelerations, formalized, in t27. Each removes the largest wait with
; the smallest risk (Pareto); each carries its risk and its mitigation as code the tests pin.
;   P1 DELTA GATE      a diff that touches only function F runs F's tests for iteration; the full
;                      spec gate runs once at landing. Saves 10-40 min per iteration.
;   P2 SKIP CONFIRM    when the first gate result equals the expected change and no critical path
;                      changed, the confirmation gate is skipped; the PR stays Refs-linked until it
;                      lands. Saves 40-50 min per landing.
;   P3 CLOCK RERUN     hung mutants are rerun once on an adjusted clock before they are called hung;
;                      a mutant that finished under the adjusted clock is SLOW, not HUNG. Saves about
;                      half the timeout wait. Results are always recorded against the clock used.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriMutateSpeedup;

// P1 decisions.
pub const P1_FULL_GATE : u8 = 0;
pub const P1_FUNCTION_ONLY : u8 = 1;

// P2 decisions.
pub const P2_RUN_CONFIRMATION : u8 = 0;
pub const P2_SKIP_CONFIRMATION : u8 = 1;

// P3 verdicts for a mutant that outlived the first clock.
pub const P3_HUNG : u8 = 0;
pub const P3_SLOW : u8 = 1;
pub const P3_HUNG_STILL : u8 = 2;

/// P1: one touched function iterates on its own tests only; anything wider runs the full gate.
pub fn p1_delta_gate(touched_functions: u64) -> u8 {
    if (touched_functions == 1) { return P1_FUNCTION_ONLY; }
    return P1_FULL_GATE;
}

/// P2: skip the confirmation gate only when the first gate matched and no critical path moved.
pub fn p2_landing(first_gate_matched: bool, critical_changed: bool) -> u8 {
    if (first_gate_matched and critical_changed == false) { return P2_SKIP_CONFIRMATION; }
    return P2_RUN_CONFIRMATION;
}

/// P3: a hung mutant gets one rerun on the adjusted clock. Finishing there is SLOW; hanging again is
/// HUNG_STILL; passing a check under either clock kills it before either verdict matters.
pub fn p3_clock_rerun(passed_check: bool, finished_on_rerun: bool) -> u8 {
    if (passed_check) { return P3_HUNG; }
    if (finished_on_rerun) { return P3_SLOW; }
    return P3_HUNG_STILL;
}

invariant p1_never_narrows_a_wide_diff { assert p1_delta_gate(0) == P1_FULL_GATE and p1_delta_gate(2) == P1_FULL_GATE; }
invariant p2_skips_only_on_match_without_critical { assert p2_landing(true, false) == P2_SKIP_CONFIRMATION and p2_landing(false, false) == P2_RUN_CONFIRMATION and p2_landing(true, true) == P2_RUN_CONFIRMATION; }
invariant p3_a_passed_check_is_not_slow { assert p3_clock_rerun(true, true) == P3_HUNG and p3_clock_rerun(false, true) == P3_SLOW and p3_clock_rerun(false, false) == P3_HUNG_STILL; }

// Negative control: the P1 narrowing must refuse to apply to anything but exactly one function --
// an empty diff and a two-function diff both take the full gate, never a narrower run.
test p1_refuses_to_narrow_a_wide_diff {
    assert p1_delta_gate(2) == P1_FULL_GATE;
    assert p1_delta_gate(0) == P1_FULL_GATE;
    assert p1_delta_gate(1) != P1_FULL_GATE;
}

// Scenario: P2 -- the clock wiring matched the expected 3 survivors, nothing critical moved.
test p2_matching_gate_lands_without_confirmation {
    assert p2_landing(true, false) == P2_SKIP_CONFIRMATION;
    // a mismatched gate, and a moved critical path, both confirm
    assert p2_landing(false, false) == P2_RUN_CONFIRMATION;
    assert p2_landing(true, true) == P2_RUN_CONFIRMATION;
}

// Scenario: P3 -- the census had 3 hung mutants; two finish on the adjusted clock, one hangs again.
test p3_rerun_separates_slow_from_hung {
    assert p3_clock_rerun(false, true) == P3_SLOW;
    assert p3_clock_rerun(false, false) == P3_HUNG_STILL;
    // a mutant that fails a check on the rerun is killed, whatever the clock said
    assert p3_clock_rerun(true, true) == P3_HUNG;
}
