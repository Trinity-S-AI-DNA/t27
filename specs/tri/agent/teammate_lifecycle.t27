// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Teammate roster lifecycle: ensure-reuse, config conflict, idempotent release | φ² + 1/φ² = 3 | TRINITY

module TriTeammateLifecycle;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Contract
    // ═══════════════════════════════════════════════════════════

    // Idempotent teammate lifecycle for a Team roster. A teammate is keyed by
    // a durable name; its immutable creation configuration is summarized by
    // one config fingerprint; every distinct incarnation of a name carries a
    // fresh generation id. The roster is a fixed-capacity table of slots.
    //
    // 1. Ensuring an absent name creates a fresh teammate (STATUS_CREATED).
    // 2. Ensuring an active name with the SAME config reuses the existing
    //    teammate (STATUS_REUSED); no duplicate member is created.
    // 3. Ensuring an active name with a DIFFERENT config is rejected
    //    (STATUS_CONFLICT); the roster is unchanged.
    // 4. Releasing an active teammate removes it (STATUS_RELEASED); releasing
    //    an absent name is a deterministic no-op (STATUS_ABSENT) that leaves
    //    the roster unchanged.
    // 5. A released name may be respawned as a FRESH teammate with a new
    //    generation; the removed instance is never resurrected.
    // 6. Invariants: active names stay unique, every active member carries a
    //    nonzero name and generation, and a full roster rejects new spawns.
    //
    // Member names on the real surface are lower-kebab-case strings; this
    // model maps each name 1:1 onto a small numeric token.

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ROSTER_CAP : usize = 4;

    // Slot occupancy flag (0 = free, 1 = used).
    pub const SLOT_FREE : u8 = 0;
    pub const SLOT_USED : u8 = 1;

    // No slot index; equals ROSTER_CAP, the first index past the table.
    pub const NO_SLOT : usize = 4;

    pub const Member = struct {
        used : u8,
        name : u8,
        config : u16,
        generation : u32,
    };

    pub const Roster = struct {
        members : [4]Member,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Status and fixture vocabulary
    // ═══════════════════════════════════════════════════════════

    pub const STATUS_CREATED : u8 = 0;
    pub const STATUS_REUSED : u8 = 1;
    pub const STATUS_CONFLICT : u8 = 2;
    pub const STATUS_RELEASED : u8 = 3;
    pub const STATUS_ABSENT : u8 = 4;
    pub const STATUS_FULL : u8 = 5;

    // Test fixtures: two distinct creation configs and two generations.
    pub const PROVIDER_A : u16 = 71;
    pub const PROVIDER_B : u16 = 131;
    pub const GEN_FIRST : u32 = 1;
    pub const GEN_SECOND : u32 = 2;

    // ═══════════════════════════════════════════════════════════
    // 4. Core Functions
    // ═══════════════════════════════════════════════════════════

    // free_member() → Member
    fn free_member() -> Member {
        return Member{ .used = SLOT_FREE, .name = 0, .config = 0, .generation = 0 };
    }

    // empty_roster() → Roster
    fn empty_roster() -> Roster {
        return Roster{ .members = [_]Member{ free_member(), free_member(), free_member(), free_member() } };
    }

    // active_slot(r: Roster, name: u8) → usize; NO_SLOT when the name has no active teammate.
    fn active_slot(r: Roster, name: u8) -> usize {
        var i: usize = 0;
        while (i < ROSTER_CAP) {
            if (r.members[i].used == SLOT_USED) {
                if (r.members[i].name == name) {
                    return i;
                }
            }
            i += 1;
        }
        return NO_SLOT;
    }

    // count_active(r: Roster) → usize
    fn count_active(r: Roster) -> usize {
        var n: usize = 0;
        var i: usize = 0;
        while (i < ROSTER_CAP) {
            if (r.members[i].used == SLOT_USED) {
                n += 1;
            }
            i += 1;
        }
        return n;
    }

    // names_unique(r: Roster) → bool; invariant: active names never collide.
    fn names_unique(r: Roster) -> bool {
        var i: usize = 0;
        while (i < ROSTER_CAP) {
            var j: usize = i + 1;
            while (j < ROSTER_CAP) {
                if (r.members[i].used == SLOT_USED) {
                    if (r.members[j].used == SLOT_USED) {
                        if (r.members[i].name == r.members[j].name) {
                            return false;
                        }
                    }
                }
                j += 1;
            }
            i += 1;
        }
        return true;
    }

    // roster_invariant(r: Roster) → bool; every active member carries a
    // nonzero name and generation, and active names stay unique.
    fn roster_invariant(r: Roster) -> bool {
        var i: usize = 0;
        while (i < ROSTER_CAP) {
            if (r.members[i].used == SLOT_USED) {
                if (r.members[i].name == 0) {
                    return false;
                }
                if (r.members[i].generation == 0) {
                    return false;
                }
            }
            i += 1;
        }
        return names_unique(r);
    }

    // ensure_status(r: Roster, name: u8, config: u16) → u8; the decision ensure must make.
    fn ensure_status(r: Roster, name: u8, config: u16) -> u8 {
        var slot: usize = active_slot(r, name);
        if (slot != NO_SLOT) {
            if (r.members[slot].config == config) {
                return STATUS_REUSED;
            }
            return STATUS_CONFLICT;
        }
        if (count_active(r) == ROSTER_CAP) {
            return STATUS_FULL;
        }
        return STATUS_CREATED;
    }

    // ensure_apply(r: Roster, name: u8, config: u16, gen: u32) → Roster;
    // reuse and conflict leave the roster unchanged; creation fills the
    // first free slot with a fresh generation.
    fn ensure_apply(r: Roster, name: u8, config: u16, gen: u32) -> Roster {
        var slot: usize = active_slot(r, name);
        if (slot != NO_SLOT) {
            return r;
        }
        var j: usize = 0;
        while (j < ROSTER_CAP) {
            if (r.members[j].used == SLOT_FREE) {
                var next: Roster = r;
                next.members[j] = Member{ .used = SLOT_USED, .name = name, .config = config, .generation = gen };
                return next;
            }
            j += 1;
        }
        return r;
    }

    // release_status(r: Roster, name: u8) → u8
    fn release_status(r: Roster, name: u8) -> u8 {
        var slot: usize = active_slot(r, name);
        if (slot == NO_SLOT) {
            return STATUS_ABSENT;
        }
        return STATUS_RELEASED;
    }

    // release_apply(r: Roster, name: u8) → Roster; removing an absent name is
    // a deterministic no-op; removing an active teammate frees its slot.
    fn release_apply(r: Roster, name: u8) -> Roster {
        var slot: usize = active_slot(r, name);
        if (slot == NO_SLOT) {
            return r;
        }
        var next: Roster = r;
        next.members[slot] = free_member();
        return next;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from the teammate lifecycle contract)
    // ═══════════════════════════════════════════════════════════

    test "empty_roster_has_no_active_members"
        given r0 = empty_roster()
        then count_active(r0) == 0 and active_slot(r0, 1) == NO_SLOT and roster_invariant(r0)

    test "first_spawn_creates_the_teammate"
        given r0 = empty_roster()
        when r1 = ensure_apply(r0, 1, PROVIDER_A, GEN_FIRST)
        then ensure_status(r0, 1, PROVIDER_A) == STATUS_CREATED and count_active(r1) == 1 and r1.members[0].name == 1 and r1.members[0].generation == GEN_FIRST and roster_invariant(r1)

    test "second_spawn_of_same_name_and_config_reuses_the_member"
        given r0 = empty_roster()
        and r1 = ensure_apply(r0, 1, PROVIDER_A, GEN_FIRST)
        and r2 = ensure_apply(r1, 1, PROVIDER_A, GEN_FIRST)
        then ensure_status(r1, 1, PROVIDER_A) == STATUS_REUSED and ensure_status(r0, 1, PROVIDER_A) == STATUS_CREATED and count_active(r2) == count_active(r1) and active_slot(r2, 1) == active_slot(r1, 1)

    test "spawn_with_same_name_and_different_config_is_rejected"
        given r0 = empty_roster()
        and r1 = ensure_apply(r0, 1, PROVIDER_A, GEN_FIRST)
        then ensure_status(r1, 1, PROVIDER_B) == STATUS_CONFLICT and count_active(ensure_apply(r1, 1, PROVIDER_B, GEN_FIRST)) == count_active(r1) and ensure_status(ensure_apply(r1, 1, PROVIDER_B, GEN_FIRST), 1, PROVIDER_A) == STATUS_REUSED

    test "second_release_of_a_released_name_is_a_deterministic_no_op"
        given r0 = empty_roster()
        and r1 = ensure_apply(r0, 2, PROVIDER_A, GEN_FIRST)
        and r2 = release_apply(r1, 2)
        and r3 = release_apply(r2, 2)
        then release_status(r1, 2) == STATUS_RELEASED and release_status(r2, 2) == STATUS_ABSENT and release_status(r3, 2) == STATUS_ABSENT and count_active(r2) == 0 and count_active(r3) == 0 and active_slot(r3, 2) == NO_SLOT

    test "respawn_after_release_creates_a_fresh_teammate"
        given r0 = empty_roster()
        and r1 = ensure_apply(r0, 2, PROVIDER_A, GEN_FIRST)
        and r2 = release_apply(r1, 2)
        and r3 = ensure_apply(r2, 2, PROVIDER_A, GEN_SECOND)
        then ensure_status(r2, 2, PROVIDER_A) == STATUS_CREATED and count_active(r3) == 1 and active_slot(r3, 2) != NO_SLOT and r3.members[active_slot(r3, 2)].generation == GEN_SECOND and roster_invariant(r3)

    test "full_roster_rejects_new_spawns"
        given r0 = empty_roster()
        and r1 = ensure_apply(r0, 1, PROVIDER_A, GEN_FIRST)
        and r2 = ensure_apply(r1, 2, PROVIDER_A, GEN_FIRST)
        and r3 = ensure_apply(r2, 3, PROVIDER_A, GEN_FIRST)
        and r4 = ensure_apply(r3, 4, PROVIDER_A, GEN_FIRST)
        then ensure_status(r4, 5, PROVIDER_A) == STATUS_FULL and count_active(ensure_apply(r4, 5, PROVIDER_A, GEN_FIRST)) == 4

    test "roster_count_and_uniqueness_hold_across_the_lifecycle"
        given r0 = empty_roster()
        and r1 = ensure_apply(r0, 1, PROVIDER_A, GEN_FIRST)
        and r2 = ensure_apply(r1, 2, PROVIDER_B, GEN_FIRST)
        and r3 = release_apply(r2, 1)
        and r4 = ensure_apply(r3, 3, PROVIDER_A, GEN_FIRST)
        and r5 = ensure_apply(r4, 3, PROVIDER_A, GEN_SECOND)
        then count_active(r2) == 2 and count_active(r3) == 1 and count_active(r4) == 2 and count_active(r5) == 2 and names_unique(r5) and roster_invariant(r5)
