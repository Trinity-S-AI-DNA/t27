// specs/tri/queue_health.t27 -- queue health report.
// Part of M1 (milestone #5). Closes #13832.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::queue_health;

pub const QUEUE_HEALTH_OK : bool = true;

pub struct QueueHealth { healthy: bool, pending: u32 };

pub fn queue_health_ok(q: QueueHealth) -> bool {
    return q.healthy;
}

test "queue health ok" {
    assert(queue_health_ok(QueueHealth { healthy: true, pending: 0 }));
    assert(!queue_health_ok(QueueHealth { healthy: false, pending: 5 }));
}

invariant queue_health_ok_default {
    assert QUEUE_HEALTH_OK;
}