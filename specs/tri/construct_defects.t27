// SPDX-License-Identifier: Apache-2.0
// specs/tri/construct_defects.t27 -- t27c: use splice renames a local binding
// that shares a name with a pulled pub fn.
// Part of M2 milestone (milestone #6). Closes #13368.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::construct_defects;

pub const CONSTRUCT_DEFECTS_MAX : u32 = 1024;

pub struct ConstructDefect { name: str, renamed: bool };

pub fn construct_defect_renamed(d: ConstructDefect) -> bool {
    return d.renamed;
}

test "construct_defect_renamed" {
    assert(construct_defect_renamed(ConstructDefect { name: "route", renamed: true }));
    assert(!construct_defect_renamed(ConstructDefect { name: "route", renamed: false }));
}

invariant construct_defects_max_positive {
    assert CONSTRUCT_DEFECTS_MAX > 0;
}