// SPDX-License-Identifier: Apache-2.0
; specs/tri/actors/claim_verbs.t27 -- the three words of the swarm claim protocol (gHashTag/t27#12654, P6
; of epic #12490). A lane says claim, heartbeat or release. This file maps each word to the message tag
; of specs/queen/claim_msg.t27 and says what the message ends in, and nothing else. It restates no rule:
; the tags, the lanes, the stale bound and every decision are claim_msg.t27's and are taken by `use`; the
; verb codes and the set of verbs that wait are specs/tri/trigit/verbs.t27's and are taken by `use` too.
; What is new here is only the word table (including `heartbeat`, which trigit spells `beat`) and the
; outcome word of each decision, so a command, a pane or a skill can print it.
; Words:
;   claim      take an issue          -> tag CM_TAG_CLAIM   (data lane)
;   heartbeat  renew a claim you hold -> tag CM_TAG_BEAT    (control lane); `beat` is the same word
;   release    give a claim up        -> tag CM_TAG_RELEASE (control lane)
; Anything else is no word of this protocol and ends in "unknown word"; a receiver drops it.
; Not here: the ref write, the issue comment, the clock. The trigit verb `release` still waits on the ref
; write (verbs.t27, waits); the message-level decision for release is live, and cv_waits says which of
; the two is meant. Design only, no balance changes and no payout. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriActorsClaimVerbs;

use queen::claim_msg::CM_TAG_CLAIM;
use queen::claim_msg::CM_TAG_BEAT;
use queen::claim_msg::CM_TAG_RELEASE;
use queen::claim_msg::CM_GRANTED;
use queen::claim_msg::CM_REFUSED;
use queen::claim_msg::CM_TAKEOVER;
use queen::claim_msg::CM_STALE;
use queen::claim_msg::cm_known_tag;
use queen::claim_msg::cm_lane_of;
use queen::claim_msg::cm_state;
use queen::claim_msg::cm_decide;
use queen::claim_msg::cm_beat_renews;
use queen::claim_msg::cm_release_valid;
use tri::trigit::verbs::TV_UNKNOWN;
use tri::trigit::verbs::TV_CLAIM;
use tri::trigit::verbs::TV_RELEASE;
use tri::trigit::verbs::TV_BEAT;
use tri::trigit::verbs::verb_of;
use tri::trigit::verbs::waits;

; --- 1. The words -----------------------------------------------------------------------------------

pub const CV_WORD_CLAIM : str = "claim";
pub const CV_WORD_HEARTBEAT : str = "heartbeat";
pub const CV_WORD_BEAT : str = "beat";
pub const CV_WORD_RELEASE : str = "release";

/// The message tag of a word: claim_msg.t27's CM_TAG_CLAIM, CM_TAG_BEAT or CM_TAG_RELEASE, and 0 (the
/// tag of nobody) for any other word, the empty word included. Words are exact, lower case, no trim.
pub fn cv_tag_of(word: string) -> u64 {
    if (word == CV_WORD_CLAIM) { return CM_TAG_CLAIM; }
    if (word == CV_WORD_HEARTBEAT) { return CM_TAG_BEAT; }
    if (word == CV_WORD_BEAT) { return CM_TAG_BEAT; }
    if (word == CV_WORD_RELEASE) { return CM_TAG_RELEASE; }
    return 0;
}

/// Whether a word is one of the protocol's words: its tag is a known claim tag.
pub fn cv_known(word: string) -> bool {
    return cm_known_tag(cv_tag_of(word));
}

/// The lane a word's message rides, claim_msg.t27's: claim on the data lane (0), heartbeat and release on
/// the control lane (1). An unknown word has no message; it reads as the data lane and is dropped.
pub fn cv_lane(word: string) -> u8 {
    return cm_lane_of(cv_tag_of(word));
}

/// The trigit verb code of a word, so the two tables cannot drift: claim, beat and release are verbs.t27's
/// TV_CLAIM, TV_BEAT and TV_RELEASE, `heartbeat` is TV_BEAT, anything else is TV_UNKNOWN.
pub fn cv_trigit_verb(word: string) -> u8 {
    if (word == CV_WORD_CLAIM) { return TV_CLAIM; }
    if (word == CV_WORD_HEARTBEAT) { return TV_BEAT; }
    if (word == CV_WORD_BEAT) { return TV_BEAT; }
    if (word == CV_WORD_RELEASE) { return TV_RELEASE; }
    return TV_UNKNOWN;
}

/// Whether the trigit verb of this word still waits on the ref write (verbs.t27 waits(): release does,
/// claim and beat do not). The message-level decision of cv_outcome is live whatever this says.
pub fn cv_waits(word: string) -> bool {
    return waits(cv_trigit_verb(word));
}

; --- 2. What a message ends in ----------------------------------------------------------------------

pub const CV_OUT_GRANTED : str = "granted";
pub const CV_OUT_REFUSED : str = "refused";
pub const CV_OUT_TAKEOVER : str = "takeover";
pub const CV_OUT_RENEWED : str = "renewed";
pub const CV_OUT_RELEASED : str = "released";
pub const CV_OUT_DROPPED : str = "dropped";
pub const CV_OUT_UNKNOWN : str = "unknown word";

/// The outcome word of a CLAIM: claim_msg.t27's cm_decide, named. GRANTED is the grant (a free claim or
/// the same holder), TAKEOVER a stale claim of another, REFUSED a live claim of another.
pub fn cv_claim_word(ref_exists: bool, comment_exists: bool, idle_minutes: u32, same_holder: bool) -> str {
    var d : u8 = cm_decide(ref_exists, comment_exists, idle_minutes, same_holder);
    if (d == CM_GRANTED) { return CV_OUT_GRANTED; }
    if (d == CM_TAKEOVER) { return CV_OUT_TAKEOVER; }
    return CV_OUT_REFUSED;
}

/// The outcome word of a message: the word picks the decision, the facts feed it. The facts are the same
/// four for every word (ref present, comment present, idle minutes, sender is the holder); a decision
/// takes the ones it needs and drops the rest.
/// - claim: granted, refused or takeover (cm_decide);
/// - heartbeat/beat: renewed when the sender holds the ref, else dropped (cm_beat_renews);
/// - release: released when cm_release_valid says so (the claim is stale when it is held and idle for
///   CM_STALE_MINUTES or more), else dropped;
/// - any other word: "unknown word".
pub fn cv_outcome(word: string, ref_exists: bool, comment_exists: bool, idle_minutes: u32, same_holder: bool) -> str {
    var tag : u64 = cv_tag_of(word);
    if (tag == CM_TAG_CLAIM) { return cv_claim_word(ref_exists, comment_exists, idle_minutes, same_holder); }
    if (tag == CM_TAG_BEAT) {
        if (cm_beat_renews(ref_exists, same_holder)) { return CV_OUT_RENEWED; }
        return CV_OUT_DROPPED;
    }
    if (tag == CM_TAG_RELEASE) {
        var stale : bool = cm_state(ref_exists, idle_minutes) == CM_STALE;
        if (cm_release_valid(ref_exists, same_holder, stale)) { return CV_OUT_RELEASED; }
        return CV_OUT_DROPPED;
    }
    return CV_OUT_UNKNOWN;
}

; --- 3. Tests ---------------------------------------------------------------------------------------

test the_three_words_map_to_the_three_claim_tags {
    assert cv_tag_of("claim") == CM_TAG_CLAIM;
    assert cv_tag_of("heartbeat") == CM_TAG_BEAT;
    assert cv_tag_of("beat") == CM_TAG_BEAT;
    assert cv_tag_of("release") == CM_TAG_RELEASE;
    assert cv_tag_of("claim") == 16;
    assert cv_tag_of("beat") == 17;
    assert cv_tag_of("release") == 18;
}

test no_other_word_is_a_word_of_the_protocol {
    assert cv_known("claim");
    assert cv_known("heartbeat");
    assert cv_known("beat");
    assert cv_known("release");
    assert cv_known("") == false;
    assert cv_known("Claim") == false;
    assert cv_known(" claim") == false;
    assert cv_known("claim ") == false;
    assert cv_known("hold") == false;
    assert cv_known("send") == false;
    assert cv_tag_of("") == 0;
    assert cv_tag_of("hold") == 0;
}

test a_claim_rides_the_data_lane_and_a_beat_or_release_the_control_lane {
    assert cv_lane("claim") == 0;
    assert cv_lane("heartbeat") == 1;
    assert cv_lane("beat") == 1;
    assert cv_lane("release") == 1;
    assert cv_lane("nothing") == 0;
}

test the_words_agree_with_the_trigit_verb_table {
    assert cv_trigit_verb("claim") == verb_of("claim");
    assert cv_trigit_verb("beat") == verb_of("beat");
    assert cv_trigit_verb("release") == verb_of("release");
    assert cv_trigit_verb("claim") == 1;
    assert cv_trigit_verb("release") == 3;
    assert cv_trigit_verb("beat") == 4;
}

test heartbeat_is_the_trigit_beat_and_trigit_has_no_such_word {
    assert cv_trigit_verb("heartbeat") == verb_of("beat");
    assert verb_of("heartbeat") == 0;
    assert cv_trigit_verb("heartbeat") != verb_of("heartbeat");
}

test an_unknown_word_is_the_unknown_verb {
    assert cv_trigit_verb("hold") == 0;
    assert cv_trigit_verb("") == 0;
    assert cv_trigit_verb("nothing") == verb_of("nothing");
}

test only_release_still_waits_on_the_ref_write_at_the_trigit_level {
    assert cv_waits("release");
    assert cv_waits("claim") == false;
    assert cv_waits("beat") == false;
    assert cv_waits("heartbeat") == false;
    assert cv_waits("hold") == false;
    assert cv_waits("") == false;
}

test a_free_issue_is_granted_to_the_first_claimant {
    assert cv_outcome("claim", false, false, 0, false) == "granted";
    assert cv_claim_word(false, false, 0, false) == CV_OUT_GRANTED;
}

test a_live_claim_of_another_is_refused_and_a_stale_one_taken_over {
    assert cv_outcome("claim", true, true, 0, false) == "refused";
    assert cv_outcome("claim", true, true, 359, false) == "refused";
    assert cv_outcome("claim", true, true, 360, false) == "takeover";
    assert cv_outcome("claim", true, false, 360, false) == "takeover";
    assert cv_outcome("claim", false, true, 359, false) == "refused";
}

test the_holder_who_claims_again_is_granted_at_any_age {
    assert cv_outcome("claim", true, true, 0, true) == "granted";
    assert cv_outcome("claim", true, true, 500, true) == "granted";
}

test a_heartbeat_renews_only_a_claim_its_sender_holds {
    assert cv_outcome("heartbeat", true, true, 10, true) == "renewed";
    assert cv_outcome("beat", true, true, 10, true) == "renewed";
    assert cv_outcome("heartbeat", true, true, 10, false) == "dropped";
    assert cv_outcome("heartbeat", false, true, 10, true) == "dropped";
    assert cv_outcome("heartbeat", false, false, 0, true) == "dropped";
}

test a_release_by_the_holder_takes_effect_and_by_a_stranger_only_when_stale {
    assert cv_outcome("release", true, true, 10, true) == "released";
    assert cv_outcome("release", true, true, 10, false) == "dropped";
    assert cv_outcome("release", true, true, 359, false) == "dropped";
    assert cv_outcome("release", true, true, 360, false) == "released";
}

test a_lone_comment_is_cleaned_up_only_by_its_own_holder {
    assert cv_outcome("release", false, true, 10, true) == "released";
    assert cv_outcome("release", false, true, 10, false) == "dropped";
    assert cv_outcome("release", false, true, 500, false) == "dropped";
}

test an_unknown_word_ends_in_unknown_word_whatever_the_facts {
    assert cv_outcome("hold", true, true, 0, true) == "unknown word";
    assert cv_outcome("", false, false, 0, false) == "unknown word";
    assert cv_outcome("Claim", false, false, 0, false) == "unknown word";
    assert cv_outcome("hold", true, true, 0, true) == CV_OUT_UNKNOWN;
}

test every_word_of_the_protocol_has_an_outcome_that_is_not_unknown {
    assert cv_outcome("claim", false, false, 0, false) != CV_OUT_UNKNOWN;
    assert cv_outcome("heartbeat", true, true, 0, true) != CV_OUT_UNKNOWN;
    assert cv_outcome("beat", false, false, 0, false) != CV_OUT_UNKNOWN;
    assert cv_outcome("release", false, false, 0, false) != CV_OUT_UNKNOWN;
}

test the_outcome_words_are_distinct_when_read_through_the_functions {
    assert cv_outcome("claim", false, false, 0, false) != cv_outcome("claim", true, true, 0, false);
    assert cv_outcome("claim", true, true, 0, false) != cv_outcome("claim", true, true, 360, false);
    assert cv_outcome("claim", false, false, 0, false) != cv_outcome("claim", true, true, 360, false);
    assert cv_outcome("beat", true, true, 0, true) != cv_outcome("beat", false, false, 0, false);
    assert cv_outcome("release", true, true, 0, true) != cv_outcome("release", true, true, 0, false);
    assert cv_outcome("beat", true, true, 0, true) != cv_outcome("release", true, true, 0, true);
    assert cv_claim_word(true, true, 0, false) != cv_claim_word(false, false, 0, false);
}
