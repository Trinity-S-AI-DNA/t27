// SPDX-License-Identifier: Apache-2.0
; specs/tri/sync_cmd/sync_cmd.t27 -- the sync core for `tri sync [issues|prs|doc]`.
; `tri sync` is a group: `sync` syncs all GitHub entities to NotebookLM, `sync issues`
; and `sync prs` sync one kind each, `sync doc` syncs documentation. The command
; (cli/tri/src/main.rs) parses the verb and prints; every rule below is decided here.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriSyncCmd;

pub const CMD: str = "sync";
pub const ISSUES: str = "issues";
pub const PRS: str = "prs";
pub const DOC: str = "doc";

/// The number of entities a verb would sync; 0 until wired to live backends.
pub fn entity_count(kind: string) -> u64 {
    if (kind == ISSUES) { return 0; }
    if (kind == PRS) { return 0; }
    if (kind == DOC) { return 0; }
    return 0;
}

invariant verbs_known { assert ISSUES == "issues" and PRS == "prs" and DOC == "doc" and CMD == "sync"; }

test entity_count_knows_each_verb {
    assert(entity_count("issues") == 0);
    assert(entity_count("prs") == 0);
    assert(entity_count("doc") == 0);
    assert(entity_count("everything") == 0);
}

test cmd_constant_is_sync {
    assert(CMD == "sync");
}

// bench: classifying one verb is constant work.
bench entity_count_is_constant_work {
    assert(entity_count("issues") == 0 and entity_count("prs") == 0 and entity_count("doc") == 0);
}
