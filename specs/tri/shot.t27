// SPDX-License-Identifier: Apache-2.0
; specs/tri/shot.t27 -- still-frame shot plan, settle verdict and evidence row for the T27 OS window.
; Plan = launch environment (T27OS_PAGE, T27OS_THEME, T27OS_STILL) plus timing numbers; no key, no click.
; A hash is a u64 taken from the sha256 of one captured frame; a failed capture is the value 0.
; Capture 0 is the priming frame after the first wait; try k (k >= 1) compares capture k with capture k-1.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY
; Issue: #14011

module TriShot;

pub const FIRST_WAIT_SECS: u32 = 10;
pub const GAP_SECS: u32 = 3;
pub const CAP_TRIES: u32 = 6;
pub const THEME_DARK: u8 = 0;
pub const THEME_LIGHT: u8 = 1;
pub const STILL_ON: u8 = 1;
pub const PLAN_KEYS: u8 = 0;
pub const PLAN_CLICKS: u8 = 0;
pub const V_SETTLED: u8 = 0;
pub const V_UNSTABLE: u8 = 1;

/// Case index for a page and a theme: page * 2 + theme.
pub fn case_of(page: u8, theme: u8) -> u8 {
    return page * 2 + theme;
}

/// Page of a case index.
pub fn case_page(c: u8) -> u8 {
    return c / 2;
}

/// Theme of a case index.
pub fn case_theme(c: u8) -> u8 {
    return c % 2;
}

/// Launch environment value of T27OS_STILL for every case.
pub fn env_still() -> u8 {
    return STILL_ON;
}

/// Theme word for T27OS_THEME.
pub fn env_theme_word(theme: u8) -> string {
    if (theme == 0) { return "dark"; }
    if (theme == 1) { return "light"; }
    return "";
}

/// Seconds between launch and capture number k (k = 0 is the priming frame).
pub fn capture_time(k: u32) -> u32 {
    return FIRST_WAIT_SECS + GAP_SECS * k;
}

/// Longest wall time of one case: the cap on tries.
pub fn worst_case_secs() -> u32 {
    return capture_time(CAP_TRIES);
}

/// Smaller of two numbers.
pub fn min_u32(a: u32, b: u32) -> u32 {
    if (a < b) { return a; }
    return b;
}

/// First try k (1-based, at most cap) whose frame equals the previous one and is not a failed capture; 0 when none.
pub fn settle_at(h: []u64, n: u32, cap: u32) -> u32 {
    var k : u32 = 1;
    while (k < n) {
        if (k > cap) { return 0; }
        if (h[k] != 0) {
            if (h[k] == h[k - 1]) { return k; }
        }
        k = k + 1;
    }
    return 0;
}

/// Verdict: 0 settled, 1 unstable.
pub fn verdict(h: []u64, n: u32, cap: u32) -> u8 {
    if (settle_at(h, n, cap) > 0) { return V_SETTLED; }
    return V_UNSTABLE;
}

/// Tries spent: the settling try, else the cap or what was captured, whichever is smaller.
pub fn tries(h: []u64, n: u32, cap: u32) -> u32 {
    const s : u32 = settle_at(h, n, cap);
    if (s > 0) { return s; }
    if (n == 0) { return 0; }
    return min_u32(cap, n - 1);
}

/// Verdict word for the evidence row.
pub fn verdict_word(v: u8) -> string {
    if (v == 0) { return "settled"; }
    return "unstable";
}

/// Hash prefix shown in the evidence row: the top 32 bits.
pub fn hash_prefix(h: u64) -> u64 {
    return h / 4294967296;
}

/// Before/after column: 1 changed, 0 same, 2 when either side never produced a frame.
pub fn changed(before: u64, after: u64) -> u8 {
    if (before == 0) { return 2; }
    if (after == 0) { return 2; }
    if (before == after) { return 0; }
    return 1;
}

/// Changed column word.
pub fn changed_word(c: u8) -> string {
    if (c == 0) { return "same"; }
    if (c == 1) { return "changed"; }
    return "unknown";
}

/// Fill a recorded sequence: distinct frames, then the frame at index t repeats index t-1; failed (0 = none) is a failed capture.
pub fn fill_seq(h: []u64, t: u32, failed: u32) -> u32 {
    var j : u32 = 0;
    while (j < 8) {
        h[j] = 0;
        j = j + 1;
    }
    var k : u32 = 0;
    while (k < t) {
        h[k] = 1000 + k * 7;
        k = k + 1;
    }
    h[t] = h[t - 1];
    if (failed > 0) {
        h[failed] = 0;
    }
    return t + 1;
}

/// PR #14005 recorded tries, before the change, per case.
pub fn before_tries(c: u8) -> u32 {
    if (c == 0) { return 1; }
    if (c == 1) { return 1; }
    if (c == 2) { return 2; }
    if (c == 3) { return 1; }
    if (c == 4) { return 1; }
    if (c == 5) { return 1; }
    if (c == 6) { return 1; }
    if (c == 7) { return 2; }
    return 0;
}

/// PR #14005 recorded tries, after the change, per case.
pub fn after_tries(c: u8) -> u32 {
    if (c == 0) { return 2; }
    if (c == 1) { return 1; }
    if (c == 2) { return 3; }
    if (c == 3) { return 6; }
    if (c == 4) { return 1; }
    if (c == 5) { return 2; }
    if (c == 6) { return 3; }
    if (c == 7) { return 1; }
    return 0;
}

/// Replay one case from its recorded tries and return the tries the spec computes.
pub fn replay_tries(h: []u64, t: u32, failed: u32) -> u32 {
    const n : u32 = fill_seq(h, t, failed);
    return tries(h, n, CAP_TRIES);
}

// FR-001: plan names only the launch environment and timing numbers.
test fr001_plan_env_and_timing {
    assert(case_of(2, 1) == 5);
    assert(case_page(5) == 2);
    assert(case_theme(5) == 1);
    assert(env_theme_word(case_theme(4)) == "dark");
    assert(env_theme_word(case_theme(7)) == "light");
    assert(env_still() == 1);
    assert(capture_time(0) == 10);
    assert(capture_time(1) == 13);
    assert(worst_case_secs() == 28);
}

// FR-005: no key and no click.
test fr005_no_key_no_click {
    assert(PLAN_KEYS == 0);
    assert(PLAN_CLICKS == 0);
}

// FR-004: settle on try 1.
test fr004_settle_on_try_one {
    // fill loop instead of [0] ** 8: gen-zig defect #13960
    var h : [8]u64 = undefined;
    var z : usize = 0;
    while (z < 8) {
        h[z] = 0;
        z = z + 1;
    }
    const n : u32 = fill_seq(h[0..8], 1, 0);
    assert(n == 2);
    assert(verdict(h[0..8], n, 6) == 0);
    assert(tries(h[0..8], n, 6) == 1);
}

// FR-004: settle on the last allowed try.
test fr004_settle_on_last_try {
    var h : [8]u64 = undefined;
    var z : usize = 0;
    while (z < 8) {
        h[z] = 0;
        z = z + 1;
    }
    const n : u32 = fill_seq(h[0..8], 6, 0);
    assert(n == 7);
    assert(verdict(h[0..8], n, 6) == 0);
    assert(tries(h[0..8], n, 6) == 6);
    assert(verdict(h[0..8], n, 5) == 1);
    assert(tries(h[0..8], n, 5) == 5);
}

// FR-004: never settling reaches the cap.
test fr004_never_settles {
    var h : [8]u64 = undefined;
    var z : usize = 0;
    while (z < 8) {
        h[z] = 0;
        z = z + 1;
    }
    var k : u32 = 0;
    while (k < 8) {
        h[k] = 500 + k;
        k = k + 1;
    }
    assert(verdict(h[0..8], 8, 6) == 1);
    assert(settle_at(h[0..8], 8, 6) == 0);
    assert(tries(h[0..8], 8, 6) == 6);
    assert(tries(h[0..8], 3, 6) == 2);
}

// FR-004: a failed capture inside the sequence never counts as a settled pair.
test fr004_failed_capture_in_sequence {
    var h : [8]u64 = undefined;
    var z : usize = 0;
    while (z < 8) {
        h[z] = 0;
        z = z + 1;
    }
    h[0] = 7;
    h[1] = 0;
    h[2] = 0;
    h[3] = 9;
    h[4] = 9;
    assert(settle_at(h[0..8], 5, 6) == 4);
    assert(verdict(h[0..8], 5, 6) == 0);
    assert(tries(h[0..8], 5, 6) == 4);
    h[3] = 8;
    assert(verdict(h[0..8], 5, 6) == 1);
    assert(replay_tries(h[0..8], 6, 2) == 6);
}

// FR-003: the changed column.
test fr003_changed_column {
    assert(changed(5, 5) == 0);
    assert(changed(5, 6) == 1);
    assert(changed(0, 6) == 2);
    assert(changed(5, 0) == 2);
    assert(changed_word(changed(5, 6)) == "changed");
    assert(changed_word(changed(5, 5)) == "same");
    assert(changed_word(2) == "unknown");
    assert(verdict_word(0) == "settled");
    assert(verdict_word(1) == "unstable");
    assert(hash_prefix(4294967296 * 3 + 5) == 3);
}

// SC-002: the 8-case table of PR #14005 reproduced from recorded sequences.
test sc002_pr14005_table_before {
    var h : [8]u64 = undefined;
    var z : usize = 0;
    while (z < 8) {
        h[z] = 0;
        z = z + 1;
    }
    assert(replay_tries(h[0..8], before_tries(0), 0) == 1);
    assert(replay_tries(h[0..8], before_tries(1), 0) == 1);
    assert(replay_tries(h[0..8], before_tries(2), 0) == 2);
    assert(replay_tries(h[0..8], before_tries(3), 0) == 1);
    assert(replay_tries(h[0..8], before_tries(4), 0) == 1);
    assert(replay_tries(h[0..8], before_tries(5), 0) == 1);
    assert(replay_tries(h[0..8], before_tries(6), 0) == 1);
    assert(replay_tries(h[0..8], before_tries(7), 0) == 2);
}

test sc002_pr14005_table_after {
    var h : [8]u64 = undefined;
    var z : usize = 0;
    while (z < 8) {
        h[z] = 0;
        z = z + 1;
    }
    assert(replay_tries(h[0..8], after_tries(0), 0) == 2);
    assert(replay_tries(h[0..8], after_tries(1), 0) == 1);
    assert(replay_tries(h[0..8], after_tries(2), 0) == 3);
    assert(replay_tries(h[0..8], after_tries(3), 2) == 6);
    assert(replay_tries(h[0..8], after_tries(4), 0) == 1);
    assert(replay_tries(h[0..8], after_tries(5), 0) == 2);
    assert(replay_tries(h[0..8], after_tries(6), 0) == 3);
    assert(replay_tries(h[0..8], after_tries(7), 0) == 1);
}

// bench: settle scan is bounded by the cap.
bench settle_scan_is_bounded {
    var h : [8]u64 = undefined;
    var z : usize = 0;
    while (z < 8) {
        h[z] = 0;
        z = z + 1;
    }
    const n : u32 = fill_seq(h[0..8], 6, 0);
    assert(settle_at(h[0..8], n, 6) == 6);
}
