// --- the tests -----------------------------------------------------------------------------------
// Fixtures are the programs' real text, shortened: `t27c test-report` and `t27c seal --verify` as they print for a spec on master
// (2026-10-19), `tri types ratchet` as cli/tri/src/types_dup.rs prints it, `python3 tools/dupe_scan.py` as it printed on master
// c33aec9c1 (15 findings), and the sections the glue writes. The git and gh outputs are the shapes those programs print.

pub const T_BRANCH : str = "lane/tri-land-11068";
pub const T_SCRATCH : str = "/tmp/tri-land-1";
pub const T_TRI : str = "/opt/tri/tri";
pub const B100 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij";
pub const B101 : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghija";

/// The number on the first line of text that is `label` and a count.
pub fn cl(text: string, label: string) -> u64 {
    return count_line(text, 0, text.len, label);
}

/// A request for the tests, with CHANGES already stored.
pub fn req_of(changes: string, check: bool) -> TriLandReq {
    return TriLandReq { branch: T_BRANCH, issue: 11068, scratch: T_SCRATCH, t27c: "t27c", tri: T_TRI, changes: changes, check: check, plan: false, seals: false };
}

/// A request for the tests with the fields the rules are about.
pub fn req_on(branch: string, issue: u64, scratch: string, t27c: string, plan: bool) -> TriLandReq {
    return TriLandReq { branch: branch, issue: issue, scratch: scratch, t27c: t27c, tri: T_TRI, changes: "", check: false, plan: plan, seals: false };
}

pub fn slot_of(k: u8, n: u64) -> u64 {
    return (k as u64) * SLOT + n;
}

/// Does step k, entry n, of r write exactly `want`?
pub fn argv_is(r: TriLandReq, ev: string, k: u8, n: u64, want: string, buf: []u8) -> bool {
    const m : usize = step_argv(r, ev, k, n, buf);
    return m > 0 and buf_is(buf, m, want);
}

/// Does the argument vector argv[0..n) hold `want` as one whole argument?
pub fn has_arg(argv: []const u8, n: usize, want: string) -> bool {
    var s : usize = 0;
    while (s < n) {
        var e : usize = s;
        while (e < n and argv[e] != 10) { e = e + 1; }
        if (e - s == want.len) {
            var k : usize = 0;
            while (k < want.len and argv[s + k] == want[k]) { k = k + 1; }
            if (k == want.len) { return true; }
        }
        s = e + 1;
    }
    return false;
}

/// Does an argument of argv[0..n) start with `+`: a forced refspec?
pub fn has_plus(argv: []const u8, n: usize) -> bool {
    var s : usize = 0;
    while (s < n) {
        if (argv[s] == 43) { return true; }
        var e : usize = s;
        while (e < n and argv[e] != 10) { e = e + 1; }
        s = e + 1;
    }
    return false;
}

/// Is the first argument of argv[0..n) a program the command may start: git, gh, python3, t27c, t27b (beside t27c) or tri?
pub fn program_ok(argv: []const u8, n: usize, r: TriLandReq) -> bool {
    var e : usize = 0;
    while (e < n and argv[e] != 10) { e = e + 1; }
    var k : u8 = 0;
    while (k < 5) {
        var want : string = "git";
        if (k == 1) { want = "gh"; }
        if (k == 2) { want = "python3"; }
        if (k == 3) { want = r.t27c; }
        if (k == 4) { want = r.tri; }
        if (e == want.len) {
            var i : usize = 0;
            while (i < e and argv[i] == want[i]) { i = i + 1; }
            if (i == e) { return true; }
        }
        k = k + 1;
    }
    return is_t27b_program(argv, e, r);
}

/// Is argv[0..e) the t27b program of r: the directory of T27C, then `t27b` (see emit_t27b)?
pub fn is_t27b_program(argv: []const u8, e: usize, r: TriLandReq) -> bool {
    const n : usize = r.t27c.len;
    var head : usize = 0;
    if (n >= 4 and span_is(r.t27c, n - 4, n, "t27c")) { head = n - 4; }
    if (e != head + 4) { return false; }
    var i : usize = 0;
    while (i < head and argv[i] == r.t27c[i]) { i = i + 1; }
    if (i < head) { return false; }
    return argv[head] == 116 and argv[head + 1] == 50 and argv[head + 2] == 55 and argv[head + 3] == 98;
}

/// How many steps of r, for entry 0 and this evidence, write any argument vector at all?
pub fn steps_sent(r: TriLandReq, ev: string, buf: []u8) -> u32 {
    var c : u32 = 0;
    var k : u8 = 0;
    while (k < LAND_STEPS) {
        if (step_argv(r, ev, k, 0, buf) > 0) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// How many steps of r have `want` as a whole argument?
pub fn steps_with(r: TriLandReq, ev: string, want: string, buf: []u8) -> u32 {
    var c : u32 = 0;
    var k : u8 = 0;
    while (k < LAND_STEPS) {
        const n : usize = step_argv(r, ev, k, 0, buf);
        if (has_arg(buf, n, want)) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// How many steps of r push with a force flag or a plus refspec?
pub fn forced_pushes(r: TriLandReq, ev: string, buf: []u8) -> u32 {
    var c : u32 = 0;
    var k : u8 = 0;
    while (k < LAND_STEPS) {
        const n : usize = step_argv(r, ev, k, 0, buf);
        if (has_arg(buf, n, "push") and (has_arg(buf, n, "--force") or has_arg(buf, n, "-f") or has_arg(buf, n, "--force-with-lease") or has_arg(buf, n, "--mirror") or has_arg(buf, n, "--delete") or has_plus(buf, n))) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// How many steps of r start a program the command may not start?
pub fn strange_programs(r: TriLandReq, ev: string, buf: []u8) -> u32 {
    var c : u32 = 0;
    var k : u8 = 0;
    while (k < LAND_STEPS) {
        const n : usize = step_argv(r, ev, k, 0, buf);
        if (n > 0 and program_ok(buf, n, r) == false) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

// Scenario: the branch is a name that may be written into a command and is never master; the issue is a number.
test the_branch_and_the_issue_pass_a_rule {
    assert branch_ok("lane/tri-land-11068") == true;
    assert branch_ok("worktree-agent-a9333305bc5db3e6c") == true;
    assert branch_ok("feature_x.1") == true;
    assert branch_ok("a") == true;
    assert branch_ok("master2") == true;
    assert branch_ok(B100) == true;
    assert branch_ok(B101) == false;
    assert B100.len == BRANCH_MAX and B101.len == BRANCH_MAX + 1;
    assert branch_ok("") == false;
    assert branch_ok("master") == false;
    assert branch_ok("main") == false;
    assert branch_ok("HEAD") == false;
    assert is_trunk("master") == true and is_trunk("lane/master") == false;
    assert branch_ok("-x") == false;
    assert branch_ok("-oProxyCommand=x") == false;
    assert branch_ok("/lane/x") == false;
    assert branch_ok("lane/x/") == false;
    assert branch_ok("lane//x") == false;
    assert branch_ok(".x") == false;
    assert branch_ok("lane/.x") == false;
    assert branch_ok("lane/x.") == false;
    assert branch_ok("lane/x.lock") == false;
    assert branch_ok("a..b") == false;
    assert branch_ok("lane/../x") == false;
    assert branch_ok("a b") == false;
    assert branch_ok("a;b") == false;
    assert branch_ok("a$(b)") == false;
    assert branch_ok("a`b`") == false;
    assert branch_ok("a'b") == false;
    assert branch_ok("a\"b") == false;
    assert branch_ok("a\nb") == false;
    assert branch_ok("a|b") == false;
    assert branch_ok("a&b") == false;
    assert branch_ok("a>b") == false;
    assert branch_ok("a*b") == false;
    assert branch_ok("a?b") == false;
    assert branch_ok("a:b") == false;
    assert branch_ok("a~b") == false;
    assert branch_ok("a^b") == false;
    assert branch_ok("a@{b}") == false;
    assert branch_ok("a\\b") == false;
}

// Scenario: a request that fails a rule is refused with its code, and every step of it writes nothing.
test a_request_is_refused_before_any_step_runs {
    var buf : [4096]u8 = [0] ** 4096;
    assert request_refusal(req_of("", false)) == L_OK;
    assert request_refusal(req_on("master", 11068, T_SCRATCH, "t27c", false)) == L_BAD_BRANCH;
    assert request_refusal(req_on("lane/a b", 11068, T_SCRATCH, "t27c", false)) == L_BAD_BRANCH;
    assert request_refusal(req_on(T_BRANCH, 0, T_SCRATCH, "t27c", false)) == L_BAD_ISSUE;
    assert request_refusal(req_on(T_BRANCH, 1000000000, T_SCRATCH, "t27c", false)) == L_BAD_ISSUE;
    assert request_refusal(req_on(T_BRANCH, 999999999, T_SCRATCH, "t27c", false)) == L_OK;
    assert request_refusal(req_on(T_BRANCH, 1, T_SCRATCH, "t27c", false)) == L_OK;
    assert request_refusal(req_on(T_BRANCH, 0, T_SCRATCH, "t27c", true)) == L_OK;
    assert request_refusal(req_on(T_BRANCH, 11068, "/tmp/a b", "t27c", false)) == L_BAD_PATH;
    assert request_refusal(req_on(T_BRANCH, 11068, "", "t27c", false)) == L_BAD_PATH;
    assert request_refusal(req_on(T_BRANCH, 11068, T_SCRATCH, "-x", false)) == L_BAD_PATH;
    assert request_refusal(req_on(T_BRANCH, 11068, T_SCRATCH, "t27c;rm", false)) == L_BAD_PATH;
    assert request_refusal(req_on(T_BRANCH, 11068, T_SCRATCH, P256, false)) == L_OK;
    assert steps_sent(req_of("", false), "", &buf) == (LAND_STEPS as u32);
    assert steps_sent(req_on("master", 11068, T_SCRATCH, "t27c", false), "", &buf) == 0;
    assert steps_sent(req_on("a;b", 11068, T_SCRATCH, "t27c", false), "", &buf) == 0;
    assert steps_sent(req_on(T_BRANCH, 0, T_SCRATCH, "t27c", false), "", &buf) == 0;
    assert steps_sent(req_on(T_BRANCH, 11068, "/tmp/a b", "t27c", false), "", &buf) == 0;
    assert steps_sent(req_on(T_BRANCH, 0, T_SCRATCH, "t27c", true), "", &buf) == (LAND_STEPS as u32);
}

// Scenario: a spec with a failing test, a vacuous pass or no readable totals is TESTS_NOT_CLEAN, and is not sealed.
test the_test_report_totals_are_read_from_their_lines {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert tests_clean(EV_TESTS_CLEAN, 0) == true;
    assert tests_clean(EV_TESTS_FAIL, 0) == false;
    assert tests_clean(EV_TESTS_VAC, 0) == false;
    assert tests_clean(EV_TESTS_BLOCKED, 0) == false;
    assert tests_clean(EV_TESTS_UNKNOWN, 0) == false;
    assert tests_clean(EV_TESTS_OLD, 0) == false;
    assert tests_clean(EV_TESTS_NONE, 0) == false;
    assert tests_clean(EV_TESTS_NOTOTAL, 0) == false;
    assert tests_clean("", 0) == false;
    assert judge(r, EV_TESTS_CLEAN, L_TESTS, 0) == L_OK;
    assert judge(r, EV_TESTS_FAIL, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    assert judge(r, EV_TESTS_VAC, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    assert judge(r, EV_TESTS_BLOCKED, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    assert judge(r, EV_TESTS_UNKNOWN, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    assert judge(r, EV_TESTS_OLD, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    assert judge(r, EV_TESTS_NOTOTAL, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    const t : string = TXT_TR_CLEAN;
    assert cl(t, "tests") == 21;
    assert cl(t, "pass") == 21;
    assert cl(t, "FAIL") == 0;
    assert cl(t, "vacuous passes") == 0;
    assert cl(t, "invariants") == 3;
    assert cl(t, "rate") == ABSENT;
    // a failing test's own line is not the total
    assert cl("  FAIL  negz\n\n  tests       4\n  FAIL        1\n", "FAIL") == 1;
    assert cl("  FAIL  negz\n\n  tests       4\n  FAIL        1\n", "tests") == 4;
    assert cl("  FAIL  negz\n", "FAIL") == ABSENT;
    // the shapes that are not a total
    assert cl("  tests 5x\n", "tests") == ABSENT;
    assert cl("  tests\n", "tests") == ABSENT;
    assert cl("  testsuite 3\n", "tests") == ABSENT;
    assert cl("  vacuous passes  unknown  (x)\n", "vacuous passes") == ABSENT;
    assert cl("\ttests\t7\n", "tests") == 7;
    assert cl("tests 999999999999999999\n", "tests") == 999999999999999999;
    assert cl("tests 1000000000000000000\n", "tests") == ABSENT;
    assert cl("", "tests") == ABSENT;
    // only the lines of the span count
    assert count_line("tests 4\nFAIL 0\n", 0, 8, "FAIL") == ABSENT;
}

// Scenario: a seal is clean when the check says all hashes match, and not when it says verification failed.
test the_seal_text_is_read {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert seal_clean(EV_SEAL_MATCH, L_SEAL, 0) == true;
    assert seal_clean(EV_SEAL_BAD, L_SEAL, 0) == false;
    assert seal_clean(EV_RECHECK_MATCH, L_RECHECK, 0) == true;
    assert seal_clean(EV_RECHECK_BAD, L_RECHECK, 0) == false;
    assert seal_clean(EV_RECHECK_BOTH, L_RECHECK, 0) == false;
    assert seal_clean(EV_RECHECK_EMPTY, L_RECHECK, 0) == false;
    assert seal_clean(EV_RECHECK_MATCH, L_RECHECK, 2) == false;
    assert seal_clean("", L_RECHECK, 0) == false;
    assert judge(r, EV_RECHECK_MATCH, L_RECHECK, 0) == L_OK;
    assert judge(r, EV_RECHECK_BAD, L_RECHECK, 0) == L_SEAL_NOT_CLEAN;
    assert judge(r, EV_RECHECK_BOTH, L_RECHECK, 0) == L_SEAL_NOT_CLEAN;
    assert judge(r, EV_RECHECK_EMPTY, L_RECHECK, 0) == L_SEAL_NOT_CLEAN;
    // the first verify never decides: a seal that did not match is saved and checked again
    assert judge(r, EV_SEAL_BAD, L_SEAL, 0) == L_OK;
    assert judge(r, EV_SEAL_MATCH, L_SEAL, 0) == L_OK;
    assert applies(r, EV_SEAL_BAD, L_SAVE, 0) == true;
    assert applies(r, EV_SEAL_MATCH, L_SAVE, 0) == false;
    assert applies(r, "", L_SAVE, 0) == false;
}

// Scenario: the types ratchet is clean only with exit 0 and its own CLEAN line.
test the_ratchet_text_is_read {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert types_clean(EV_TYPES_OK) == true;
    assert types_clean(EV_TYPES_RED) == false;
    assert types_clean(EV_TYPES_EXIT) == false;
    assert types_clean(EV_TYPES_NOWORD) == false;
    assert types_clean("") == false;
    assert judge(r, EV_TYPES_OK, L_TYPES, 0) == L_OK;
    assert judge(r, EV_TYPES_RED, L_TYPES, 0) == L_TYPES_NOT_CLEAN;
    assert judge(r, EV_TYPES_EXIT, L_TYPES, 0) == L_TYPES_NOT_CLEAN;
    assert judge(r, EV_TYPES_NOWORD, L_TYPES, 0) == L_TYPES_NOT_CLEAN;
}

// Scenario: dupe_scan's two finding shapes each name one body.
test a_finding_names_the_body_it_is_about {
    const a : string = "::error::a body written under dec_len is now copied [2] time(s) and was in no ledger";
    const b : string = "::error::bytes_eq was copied [8, 3] and is now copied [9, 3]";
    assert is_finding(a, 0, a.len) == true and is_finding(b, 0, b.len) == true;
    assert finding_from(a, 0, a.len) == 30 and finding_to(a, 30, a.len) == 37;
    assert finding_from(b, 0, b.len) == 9 and finding_to(b, 9, b.len) == 17;
    assert span_is(a, 30, 37, "dec_len") and span_is(b, 9, 17, "bytes_eq");
    assert is_finding("duplicate bodies: 738 of 15523 in 218 group(s) across 2440 spec(s)", 0, 67) == false;
    assert is_finding("::error::", 0, 9) == false;
    assert is_finding("::error::x", 0, 10) == true;
    assert is_finding("  ::error::x", 0, 12) == false;
    assert findings(EV_DUP_SAME, body_from(EV_DUP_SAME, L_MASTER_DUPES, 0), body_to(EV_DUP_SAME, L_MASTER_DUPES, 0)) == 15;
    assert findings(EV_DUP_FIXED, body_from(EV_DUP_FIXED, L_DUPES, 0), body_to(EV_DUP_FIXED, L_DUPES, 0)) == 14;
    assert findings(EV_DUP_CLEAN, body_from(EV_DUP_CLEAN, L_DUPES, 0), body_to(EV_DUP_CLEAN, L_DUPES, 0)) == 0;
    // a name is a whole name: dec_len is listed, dec is not, and neither is a name that merely starts with a listed one
    const m : string = "::error::a body written under dec_len is now copied [2] time(s) and was in no ledger\n::error::dec was copied [1] and is now copied [2]\n::error::dec_len_2 was copied [1] and is now copied [2]\n";
    const e1 : usize = line_end(m, 0);
    const e2 : usize = line_end(m, e1 + 1);
    assert is_listed(m, 0, e1, 30, 37) == true;
    assert is_listed(m, 0, e1, e1 + 10, e1 + 13) == false;
    assert is_listed(m, 0, e1, e2 + 10, e2 + 19) == false;
    assert extra_name(EV_DUP_SAME) > EV_DUP_SAME.len;
}

// Scenario: the failing set of the branch must be a subset of master's: it may be smaller, it may not hold a new name.
test the_failing_set_must_be_a_subset_of_masters {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    // the 15 names master fails on, as the branch fails on them too, or on fewer
    assert dupes_ok(EV_DUP_SAME) == true;
    assert dupes_ok(EV_DUP_FIXED) == true;
    assert dupes_ok(EV_DUP_SOME) == true;
    assert dupes_ok(EV_DUP_CLEAN) == true;
    assert judge(r, EV_DUP_SAME, L_DUPES, 0) == L_OK;
    assert judge(r, EV_DUP_FIXED, L_DUPES, 0) == L_OK;
    assert judge(r, EV_DUP_SOME, L_DUPES, 0) == L_OK;
    assert judge(r, EV_DUP_CLEAN, L_DUPES, 0) == L_OK;
    // a new name, in either finding shape, on top of master's 15
    assert dupes_ok(EV_DUP_NEW) == false;
    assert dupes_ok(EV_DUP_NEWGROWN) == false;
    assert judge(r, EV_DUP_NEW, L_DUPES, 0) == L_DUPE_NOT_SUBSET;
    assert judge(r, EV_DUP_NEWGROWN, L_DUPES, 0) == L_DUPE_NOT_SUBSET;
    assert extra_name(EV_DUP_NEW) < EV_DUP_NEW.len and extra_name(EV_DUP_NEWGROWN) < EV_DUP_NEWGROWN.len;
    // what cannot be read is refused: a branch exit that is neither 0 nor 1, no finding on exit 1, a master scan that failed
    assert dupes_ok(EV_DUP_UNREAD) == false;
    assert dupes_ok(EV_DUP_NOFIND) == false;
    assert dupes_ok(EV_DUP_MASTER_BAD) == false;
    assert dupes_ok(EV_DUP_MASTER_FAIL) == false;
    assert judge(r, EV_DUP_UNREAD, L_DUPES, 0) == L_DUPE_NOT_SUBSET;
    assert judge(r, EV_DUP_NOFIND, L_DUPES, 0) == L_DUPE_NOT_SUBSET;
    assert judge(r, EV_DUP_MASTER_BAD, L_MASTER_DUPES, 0) == L_DUPE_NOT_SUBSET;
    assert judge(r, EV_DUP_SAME, L_MASTER_DUPES, 0) == L_OK;
    assert judge(r, EV_DUP_MASTER_CLEAN, L_MASTER_DUPES, 0) == L_OK;
    // master clean: every finding of the branch is new
    assert dupes_ok(EV_DUP_MASTER_CLEAN) == false;
    // the limit, written down: a group that grows under a name master already fails on is a name master has
    assert dupes_ok(EV_DUP_GROWN) == true;
}

// Scenario: the first new name is what the command prints after DUPE_NOT_SUBSET.
test the_new_name_is_named {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert buf_is(&buf, refusal_detail(r, EV_DUP_NEW, L_DUPES, 0, &buf), "emit_span");
    assert buf_is(&buf, refusal_detail(r, EV_DUP_NEWGROWN, L_DUPES, 0, &buf), "emit_dec");
    assert buf_is(&buf, refusal_detail(r, EV_DUP_UNREAD, L_DUPES, 0, &buf), "dupes");
    assert buf_is(&buf, refusal_detail(r, EV_TESTS_FAIL, L_TESTS, 0, &buf), "specs/tri/land/land.t27");
    assert buf_is(&buf, refusal_detail(r, EV_RECHECK_BAD, L_RECHECK, 2, &buf), "specs/tri/land/other.t27");
    assert buf_is(&buf, refusal_detail(r, EV_TYPES_RED, L_TYPES, 0, &buf), "types");
    assert buf_is(&buf, refusal_detail(r, EV_PUSH_REJECT, L_PUSH, 0, &buf), "push");
}

// Scenario: a merged pull request, or an open one with auto-merge on that the remote already holds in full, is ALREADY_LANDED.
test an_already_landed_branch_is_left_alone {
    const r : TriLandReq = req_of("", false);
    assert judge(r, EV_MERGED_YES, L_MERGED, 0) == L_ALREADY;
    assert judge(r, EV_MERGED_NONE, L_MERGED, 0) == L_OK;
    assert judge(r, EV_MERGED_FAIL, L_MERGED, 0) == L_STEP;
    assert judge(r, EV_OPEN_LANDED, L_OPEN, 0) == L_ALREADY;
    assert judge(r, EV_OPEN_NO_AUTO, L_OPEN, 0) == L_OK;
    assert judge(r, EV_OPEN_NOT_HELD, L_OPEN, 0) == L_OK;
    assert judge(r, EV_OPEN_NONE, L_OPEN, 0) == L_OK;
    assert judge(r, EV_OPEN_FAIL, L_OPEN, 0) == L_STEP;
    assert judge(r, EV_TIP_OK, L_TIP, 0) == L_OK;
    assert judge(r, EV_TIP_NO, L_TIP, 0) == L_NO_BRANCH;
    assert judge(r, EV_HEAD_BAD, L_TIP, 0) == L_NO_BRANCH;
    // the remote's exit is data: the branch may not be there yet
    assert judge(r, EV_OPEN_NOT_HELD, L_CONTAINS, 0) == L_OK;
    assert exit_code(L_ALREADY) == 0 and exit_code(L_LANDED) == 0 and exit_code(L_CHECKED) == 0;
    const nm : string = code_name(L_ALREADY);
    assert nm.len == 14 and span_is(nm, 0, 14, "ALREADY_LANDED");
}

// Scenario: a conflict with master prints CONFLICT and the files, and pushes nothing.
test a_conflict_names_its_files_and_stops {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of("", false);
    assert judge(r, EV_CONFLICT, L_CONFLICTS, 0) == L_CONFLICT;
    assert buf_is(&buf, refusal_detail(r, EV_CONFLICT, L_CONFLICTS, 0, &buf), "specs/x.t27 specs/y.t27");
    assert judge(r, EV_MERGE_FAILED, L_CONFLICTS, 0) == L_STEP;
    assert judge(r, EV_MERGE_CLEAN, L_CONFLICTS, 0) == L_OK;
    assert exit_code(L_CONFLICT) == L_CONFLICT and exit_code(L_CONFLICT) != 0;
    assert judge(r, EV_WORKTREE_FAIL, L_WORKTREE, 0) == L_STEP;
    assert judge(r, EV_WORKTREE_OK, L_WORKTREE, 0) == L_OK;
    assert judge(r, EV_MERGE_CLEAN, L_MERGE, 0) == L_OK;
}

// Scenario: the changed specs are the gate's targets; a spec path a shell would read is refused, not skipped.
test the_changes_are_the_specs_to_gate {
    assert judge(req_of(TXT_CH_TWO, false), EV_CHANGES_OK, L_CHANGES, 0) == L_OK;
    assert judge(req_of(TXT_CH_ONE, false), EV_CHANGES_OK, L_CHANGES, 0) == L_OK;
    assert judge(req_of(TXT_CH_DOCS, false), EV_CHANGES_OK, L_CHANGES, 0) == L_OK;
    assert judge(req_of(TXT_CH_TWO, false), EV_CHANGES_FAIL, L_CHANGES, 0) == L_STEP;
    assert judge(req_of("", false), EV_CHANGES_OK, L_CHANGES, 0) == L_STEP;
    assert judge(req_of(TXT_CH_BAD, false), EV_CHANGES_OK, L_CHANGES, 0) == L_STEP;
    assert is_target(TXT_CH_TWO, 0) == true and is_target(TXT_CH_TWO, 1) == false and is_target(TXT_CH_TWO, 2) == true;
    assert is_target(TXT_CH_DOCS, 0) == false and is_target(TXT_CH_DOCS, 1) == false;
    assert is_target(TXT_CH_BAD, 0) == false and is_spec(TXT_CH_BAD, 0) == true;
    assert slot_rows(req_of(TXT_CH_TWO, false), L_TESTS) == 3 and slot_rows(req_of(TXT_CH_TWO, false), L_TYPES) == 1;
    assert per_target(L_TESTS) and per_target(L_SEAL) and per_target(L_SAVE) and per_target(L_RECHECK);
    assert per_target(L_CHANGES) == false and per_target(L_TYPES) == false;
}

// Scenario: the steps before the merge, each as the argument vector it runs.
test the_steps_before_the_merge_pin_their_bytes {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of("", false);
    assert argv_is(r, "", L_FETCH, 0, "git\nfetch\n-q\norigin\nmaster\n", &buf);
    assert argv_is(r, "", L_MERGED, 0, "gh\npr\nlist\n--repo\ngHashTag/t27\n--head\nlane/tri-land-11068\n--state\nmerged\n--json\nnumber\n--jq\n.[] | .number\n", &buf);
    assert argv_is(r, "", L_TIP, 0, "git\nrev-parse\n--verify\n-q\nrefs/heads/lane/tri-land-11068\n", &buf);
    assert argv_is(r, "", L_FETCH_BRANCH, 0, "git\nfetch\n-q\norigin\nlane/tri-land-11068\n", &buf);
    assert argv_is(r, "", L_CONTAINS, 0, "git\nmerge-base\n--is-ancestor\nrefs/heads/lane/tri-land-11068\nrefs/remotes/origin/lane/tri-land-11068\n", &buf);
    assert argv_is(r, "", L_OPEN, 0, "gh\npr\nlist\n--repo\ngHashTag/t27\n--head\nlane/tri-land-11068\n--state\nopen\n--json\nnumber,autoMergeRequest\n--jq\n.[] | \"\\(.number) \\(.autoMergeRequest != null)\"\n", &buf);
    assert argv_is(r, "", L_WORKTREE, 0, "git\nworktree\nadd\n-q\n--detach\n/tmp/tri-land-1\norigin/master\n", &buf);
    assert argv_is(r, "", L_MASTER_DUPES, 0, "python3\ntools/dupe_scan.py\n", &buf);
    assert argv_is(r, "", L_CHECKOUT, 0, "git\ncheckout\n-q\n--detach\nrefs/heads/lane/tri-land-11068\n", &buf);
    assert argv_is(r, "", L_MERGE, 0, "git\nmerge\n--no-commit\n--no-ff\norigin/master\n", &buf);
    assert argv_is(r, "", L_CONFLICTS, 0, "git\ndiff\n--name-only\n--diff-filter=U\n", &buf);
    assert argv_is(r, "", L_CHANGES, 0, "git\ndiff\n--cached\n--name-status\n--no-renames\norigin/master\n", &buf);
    // another branch and another scratch directory change exactly those words
    assert argv_is(req_on("lane/x", 7, "/tmp/z", "t27c", false), "", L_TIP, 0, "git\nrev-parse\n--verify\n-q\nrefs/heads/lane/x\n", &buf);
    assert argv_is(req_on("lane/x", 7, "/tmp/z", "t27c", false), "", L_WORKTREE, 0, "git\nworktree\nadd\n-q\n--detach\n/tmp/z\norigin/master\n", &buf);
    // the steps that run before the scratch tree exists, and the last, run where the caller stands
    assert in_scratch(L_OPEN) == false and in_scratch(L_WORKTREE) == false and in_scratch(L_MASTER_DUPES) == true;
    assert in_scratch(L_AUTO_CHECK) == true and in_scratch(L_CLEAN) == false;
}

// Scenario: the gates, per spec and once, each as the argument vector it runs.
test the_gates_pin_their_bytes {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert argv_is(r, "", L_TESTS, 0, "t27c\ntest-report\nspecs/tri/land/land.t27\n--specs-dir\nspecs\n", &buf);
    assert argv_is(r, "", L_TESTS, 2, "t27c\ntest-report\nspecs/tri/land/other.t27\n--specs-dir\nspecs\n", &buf);
    assert argv_is(r, "", L_TESTS, 1, "t27c\ntest-report\n<spec>\n--specs-dir\nspecs\n", &buf);
    assert argv_is(r, "", L_SEAL, 0, "t27c\nseal\nspecs/tri/land/land.t27\n--verify\n", &buf);
    assert argv_is(r, "", L_SAVE, 2, "t27c\nseal\nspecs/tri/land/other.t27\n--save\n", &buf);
    assert argv_is(r, "", L_RECHECK, 2, "t27c\nseal\nspecs/tri/land/other.t27\n--verify\n", &buf);
    assert argv_is(r, "", L_TYPES, 0, "/opt/tri/tri\ntypes\nratchet\n", &buf);
    assert argv_is(r, "", L_DUPES, 0, "python3\ntools/dupe_scan.py\n", &buf);
    assert argv_is(req_on(T_BRANCH, 11068, T_SCRATCH, "/opt/t27c/t27c", false), "", L_TESTS, 0, "/opt/t27c/t27c\ntest-report\n<spec>\n--specs-dir\nspecs\n", &buf);
    assert argv_is(req_of(TXT_CH_ONE, false), "", L_SEAL, 0, "t27c\nseal\nspecs/tri/land/land.t27\n--verify\n", &buf);
}

// Scenario: the steps that land the branch, each as the argument vector it runs.
test the_landing_steps_pin_their_bytes {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert argv_is(r, "", L_STAGE, 0, "git\nadd\n.trinity/seals\n", &buf);
    assert argv_is(r, "", L_PENDING, 0, "git\ndiff\n--cached\n--quiet\n", &buf);
    assert argv_is(r, "", L_TITLE, 0, "git\nlog\n-1\n--no-merges\n--format=%s\n", &buf);
    assert argv_is(r, EV_TITLE, L_COMMIT, 0, "git\n-c\ncore.hooksPath=.githooks\ncommit\n-q\n-m\ntri land: land a lane branch (Closes #11068)\n-m\nMerge of master and the seals, by tri land (specs/tri/land/land.t27): the gates ran on the merged tree.\n", &buf);
    assert argv_is(r, EV_TITLE_BARE, L_COMMIT, 0, "git\n-c\ncore.hooksPath=.githooks\ncommit\n-q\n-m\ntri land: land a lane branch (Closes #11068)\n-m\nMerge of master and the seals, by tri land (specs/tri/land/land.t27): the gates ran on the merged tree.\n", &buf);
    assert argv_is(r, "", L_HEAD, 0, "git\nrev-parse\nHEAD\n", &buf);
    assert argv_is(r, "", L_PUSH, 0, "git\npush\norigin\nHEAD:refs/heads/lane/tri-land-11068\n", &buf);
    assert argv_is(r, "", L_REMOTE_HEAD, 0, "git\nls-remote\norigin\nrefs/heads/lane/tri-land-11068\n", &buf);
    var n : usize = step_argv(r, EV_TITLE, L_PR, 0, &buf);
    assert buf_has(&buf, n, "gh\npr\ncreate\n--repo\ngHashTag/t27\n--base\nmaster\n--head\nlane/tri-land-11068\n--title=tri land: land a lane branch (Closes #11068)\n--body=Closes #11068. Opened by tri land (specs/tri/land/land.t27): master merged,");
    assert buf_has(&buf, n, PR_BODY);
    assert buf[n - 1] == 10;
    assert argv_is(r, EV_PR_CREATED, L_AUTO, 0, "gh\npr\nmerge\n11111\n--repo\ngHashTag/t27\n--auto\n--squash\n", &buf);
    assert argv_is(r, EV_PR_OPEN, L_AUTO, 0, "gh\npr\nmerge\n123\n--repo\ngHashTag/t27\n--auto\n--squash\n", &buf);
    assert argv_is(r, "", L_AUTO, 0, "gh\npr\nmerge\n<pr>\n--repo\ngHashTag/t27\n--auto\n--squash\n", &buf);
    assert argv_is(r, EV_PR_CREATED, L_AUTO_CHECK, 0, "gh\npr\nview\n11111\n--repo\ngHashTag/t27\n--json\nautoMergeRequest\n--jq\n.autoMergeRequest != null\n", &buf);
    assert argv_is(r, "", L_CLEAN, 0, "git\nworktree\nremove\n--force\n/tmp/tri-land-1\n", &buf);
    // without an issue (a plan) the words are placeholders
    const p : TriLandReq = req_on(T_BRANCH, 0, T_SCRATCH, "t27c", true);
    n = step_argv(p, "", L_COMMIT, 0, &buf);
    assert buf_has(&buf, n, "-m\n<title> (Closes #<issue>)\n-m\n");
    assert step_argv(r, "", LAND_STEPS, 0, &buf) == 0;
}

// Scenario: nothing the command starts forces a push, writes master or runs a program other than git, gh, python3, t27c and tri.
test no_step_forces_a_push_or_writes_master {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert forced_pushes(r, "", &buf) == 0;
    assert forced_pushes(r, EV_RUN_G, &buf) == 0;
    assert steps_with(r, "", "push", &buf) == 1;
    assert steps_with(r, "", "HEAD:refs/heads/lane/tri-land-11068", &buf) == 1;
    assert steps_with(r, "", "HEAD:refs/heads/master", &buf) == 0;
    assert steps_with(r, "", "refs/heads/master", &buf) == 0;
    assert steps_with(r, "", "--force", &buf) == 1;
    assert steps_with(r, "", "-f", &buf) == 0;
    assert steps_with(r, "", "--force-with-lease", &buf) == 0;
    assert steps_with(r, "", "--no-verify", &buf) == 0;
    assert strange_programs(r, "", &buf) == 0;
    assert strange_programs(r, EV_RUN_G, &buf) == 0;
    // the control: the helpers do see a force flag, a plus refspec and a strange program
    var tb : [128]u8 = [0] ** 128;
    var m : usize = emit_str(&tb, 0, "git\npush\n--force\norigin\nHEAD:refs/heads/x\n");
    assert has_arg(&tb, m, "push") == true and has_arg(&tb, m, "--force") == true and has_arg(&tb, m, "--forc") == false and has_arg(&tb, m, "x") == false;
    assert has_plus(&tb, m) == false;
    m = emit_str(&tb, 0, "git\npush\norigin\n+HEAD:refs/heads/x\n");
    assert has_plus(&tb, m) == true;
    m = emit_str(&tb, 0, "sh\n-c\nx\n");
    assert program_ok(&tb, m, r) == false;
    m = emit_str(&tb, 0, "git\nx\n");
    assert program_ok(&tb, m, r) == true;
    m = emit_str(&tb, 0, "t27c\nx\n");
    assert program_ok(&tb, m, r) == true;
    m = emit_str(&tb, 0, "/opt/tri/tri\nx\n");
    assert program_ok(&tb, m, r) == true;
    m = emit_str(&tb, 0, "gitx\nx\n");
    assert program_ok(&tb, m, r) == false;
    // and a branch named master is refused before any of this
    assert steps_sent(req_on("master", 11068, T_SCRATCH, "t27c", false), "", &buf) == 0;
}

// Scenario: the slots run in a fixed order, and a slot is chosen only when every earlier one has a section.
test the_slots_run_in_a_fixed_order {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert next_slot(r, "") == slot_of(L_FETCH, 0);
    assert next_slot(r, EV_RUN_A) == slot_of(L_WORKTREE, 0);
    assert next_slot(r, EV_RUN_B) == slot_of(L_TESTS, 0);
    assert next_slot(r, EV_RUN_C) == slot_of(L_T27B, 0);
    // the second changed line is not a spec: its slots are skipped
    assert next_slot(r, EV_RUN_D) == slot_of(L_SAVE, 2);
    assert next_slot(r, EV_RUN_E) == slot_of(L_STAGE, 0);
    assert next_slot(r, EV_RUN_F) == slot_of(L_COMMIT, 0);
    // nothing pending: no commit
    assert next_slot(r, EV_RUN_F_CLEAN) == slot_of(L_HEAD, 0);
    assert next_slot(r, EV_RUN_G) == slot_of(L_PR, 0);
    // a pull request already open skips the creation; auto-merge already on skips its enabling
    assert next_slot(r, EV_RUN_G_OPEN) == slot_of(L_AUTO, 0);
    assert next_slot(r, EV_RUN_G_AUTO_ON) == slot_of(L_AUTO_CHECK, 0);
    // a part of a run: the first slot without a section, whatever follows it
    assert next_slot(r, EV_RUN_D_NO_SEAL) == slot_of(L_SEAL, 2);
    assert next_slot(r, EV_RUN_E_NO_DUPES) == slot_of(L_DUPES, 0);
    assert next_slot(r, EV_RUN_G_NO_REMOTE) == slot_of(L_REMOTE_HEAD, 0);
    assert exit_of(EV_RUN_G, L_PUSH, 0) == 0 and exit_of(EV_RUN_G, L_TESTS, 2) == 0 and exit_of(EV_RUN_G, L_TESTS, 1) == NO_EXIT;
}

// Scenario: --check runs the gates and then stops: no stage, commit, push, pull request or auto-merge.
test a_check_run_stops_after_the_gates {
    const c : TriLandReq = req_of(TXT_CH_TWO, true);
    assert next_slot(c, EV_RUN_E) == DONE;
    assert next_slot(c, EV_RUN_E_NO_DUPES) == slot_of(L_DUPES, 0);
    assert next_slot(c, EV_RUN_D) == slot_of(L_SAVE, 2);
    assert next_slot(c, EV_RUN_C) == slot_of(L_T27B, 0);
    assert next_slot(c, "") == slot_of(L_FETCH, 0);
    assert next_slot(req_of(TXT_CH_TWO, false), EV_RUN_E) != DONE;
    assert applies(c, EV_RUN_E, L_STAGE, 0) == false and applies(c, EV_RUN_E, L_PUSH, 0) == false and applies(c, EV_RUN_E, L_AUTO, 0) == false;
    assert applies(c, EV_RUN_E, L_TYPES, 0) == true and applies(c, EV_RUN_E, L_DUPES, 0) == true;
    const nm : string = code_name(L_CHECKED);
    assert nm.len == 7 and span_is(nm, 0, 7, "CHECKED");
}

// Scenario: auto-merge is never reached while any earlier slot has no section, and every gate that fails is a refusal with an exit.
test auto_merge_waits_for_every_gate {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    const auto : u64 = slot_of(L_AUTO, 0);
    assert next_slot(r, "") < auto;
    assert next_slot(r, EV_RUN_A) < auto and next_slot(r, EV_RUN_B) < auto and next_slot(r, EV_RUN_C) < auto;
    assert next_slot(r, EV_RUN_D) < auto and next_slot(r, EV_RUN_E) < auto and next_slot(r, EV_RUN_F) < auto;
    assert next_slot(r, EV_RUN_D_NO_SEAL) < auto and next_slot(r, EV_RUN_E_NO_DUPES) < auto and next_slot(r, EV_RUN_G_NO_REMOTE) < auto;
    assert next_slot(r, EV_RUN_G) < auto;
    // every gate that fails stops the run with a code that is not 0
    assert judge(r, EV_CONFLICT, L_CONFLICTS, 0) != L_OK and exit_code(judge(r, EV_CONFLICT, L_CONFLICTS, 0)) != 0;
    assert judge(r, EV_TESTS_FAIL, L_TESTS, 0) != L_OK and exit_code(judge(r, EV_TESTS_FAIL, L_TESTS, 0)) != 0;
    assert judge(r, EV_RECHECK_BAD, L_RECHECK, 0) != L_OK and exit_code(judge(r, EV_RECHECK_BAD, L_RECHECK, 0)) != 0;
    assert judge(r, EV_TYPES_RED, L_TYPES, 0) != L_OK and exit_code(judge(r, EV_TYPES_RED, L_TYPES, 0)) != 0;
    assert judge(r, EV_DUP_NEW, L_DUPES, 0) != L_OK and exit_code(judge(r, EV_DUP_NEW, L_DUPES, 0)) != 0;
    assert judge(r, EV_PUSH_OTHER, L_REMOTE_HEAD, 0) != L_OK and exit_code(judge(r, EV_PUSH_OTHER, L_REMOTE_HEAD, 0)) != 0;
    // the six named codes and the number each exits with
    assert judge(r, EV_CONFLICT, L_CONFLICTS, 0) == L_CONFLICT and judge(r, EV_TESTS_VAC, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    assert judge(r, EV_RECHECK_BAD, L_RECHECK, 0) == L_SEAL_NOT_CLEAN and judge(r, EV_TYPES_RED, L_TYPES, 0) == L_TYPES_NOT_CLEAN;
    assert judge(r, EV_DUP_NEW, L_DUPES, 0) == L_DUPE_NOT_SUBSET and judge(r, EV_PUSH_REJECT, L_PUSH, 0) == L_PUSH_NOT_CONFIRMED;
}

// Scenario: the push is confirmed by the remote naming the object HEAD named; a rejected push is never retried or forced.
test the_push_is_confirmed_by_the_remote_head {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert pushed(EV_PUSH_OK) == true;
    assert pushed(EV_PUSH_OTHER) == false;
    assert pushed(EV_PUSH_EMPTY) == false;
    assert pushed(EV_PUSH_REJECT) == false;
    assert pushed(EV_PUSH_LSFAIL) == false;
    assert pushed(EV_HEAD_BAD) == false;
    assert pushed("") == false;
    assert judge(r, EV_PUSH_OK, L_PUSH, 0) == L_OK;
    assert judge(r, EV_PUSH_OK, L_REMOTE_HEAD, 0) == L_OK;
    assert judge(r, EV_PUSH_OTHER, L_REMOTE_HEAD, 0) == L_PUSH_NOT_CONFIRMED;
    assert judge(r, EV_PUSH_EMPTY, L_REMOTE_HEAD, 0) == L_PUSH_NOT_CONFIRMED;
    assert judge(r, EV_PUSH_REJECT, L_PUSH, 0) == L_PUSH_NOT_CONFIRMED;
    assert judge(r, EV_PUSH_LSFAIL, L_REMOTE_HEAD, 0) == L_PUSH_NOT_CONFIRMED;
    assert judge(r, EV_PUSH_OK, L_HEAD, 0) == L_OK;
    assert judge(r, EV_HEAD_BAD, L_HEAD, 0) == L_STEP;
    const s40 : string = "0123456789abcdef0123456789abcdef01234567";
    const s41 : string = "0123456789abcdef0123456789abcdef012345678";
    const s39 : string = "0123456789abcdef0123456789abcdef0123456";
    const sg : string = "0123456789abcdef0123456789abcdef0123456g";
    const su : string = "0123456789ABCDEF0123456789abcdef01234567";
    const st : string = "0123456789abcdef0123456789abcdef01234567\trefs/heads/x";
    assert s40.len == 40 and sha_at(s40, 0, 40) == true;
    assert sha_at(st, 0, st.len) == true;
    assert sha_at(s39, 0, 39) == false;
    assert sha_at(sg, 0, 40) == false;
    assert sha_at(su, 0, 40) == false;
    assert sha_at(s41, 0, 41) == false;
}

// Scenario: the title carries `Closes #N` once, from the lane's own subject; the stage, pending, title and commit steps refuse a surprise.
test the_title_carries_the_issue {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert buf_is(&buf, emit_title(&buf, 0, EV_TITLE, 11068), "tri land: land a lane branch (Closes #11068)");
    assert buf_is(&buf, emit_title(&buf, 0, EV_TITLE_BARE, 11068), "tri land: land a lane branch (Closes #11068)");
    assert buf_is(&buf, emit_title(&buf, 0, EV_TITLE_OTHER, 11068), "tri land: land a lane branch (Closes #11000) (Closes #11068)");
    assert buf_is(&buf, emit_title(&buf, 0, EV_TITLE_EMPTY, 11068), "<title> (Closes #11068)");
    assert buf_is(&buf, emit_title(&buf, 0, "", 7), "<title> (Closes #7)");
    assert buf_is(&buf, emit_title(&buf, 0, "", 0), "<title> (Closes #<issue>)");
    const a : string = "a (Closes #11068)";
    const b : string = "Closes #5, Closes #6";
    const c : string = "Closes #";
    assert has_closes(a, 0, a.len, 11068) == true;
    assert has_closes(a, 0, a.len, 1106) == false;
    assert has_closes(a, 0, a.len, 110680) == false;
    assert has_closes(b, 0, b.len, 6) == true and has_closes(b, 0, b.len, 5) == true and has_closes(b, 0, b.len, 7) == false;
    assert has_closes(c, 0, c.len, 6) == false;
    assert has_closes("", 0, 0, 6) == false;
    assert judge(r, EV_TITLE, L_TITLE, 0) == L_OK;
    assert judge(r, EV_TITLE_EMPTY, L_TITLE, 0) == L_STEP;
    assert judge(r, EV_PENDING_YES, L_PENDING, 0) == L_OK;
    assert judge(r, EV_PENDING_NO, L_PENDING, 0) == L_OK;
    assert judge(r, EV_PENDING_FAIL, L_PENDING, 0) == L_STEP;
    assert judge(r, EV_PENDING_FAIL, L_COMMIT, 0) == L_STEP;
    assert judge(r, EV_PENDING_FAIL, L_STAGE, 0) == L_STEP;
}

// Scenario: the pull request is the open one, else the one just created; its auto-merge must be confirmed on.
test the_pull_request_number_is_read {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert lead_number(EV_OPEN_LANDED, L_OPEN) == 123;
    assert lead_number(EV_OPEN_NONE, L_OPEN) == 0;
    assert lead_number("", L_OPEN) == 0;
    assert open_auto(EV_OPEN_LANDED) == true and open_auto(EV_OPEN_NO_AUTO) == false and open_auto(EV_OPEN_NONE) == false and open_auto("") == false;
    assert created_number(EV_PR_CREATED) == 11111;
    assert created_number(EV_PR_NOURL) == 0;
    assert created_number("") == 0;
    assert pr_number(EV_PR_OPEN) == 123 and pr_number(EV_PR_CREATED) == 11111 and pr_number(EV_OPEN_NONE) == 0 and pr_number("") == 0;
    assert applies(r, EV_OPEN_NONE, L_PR, 0) == true and applies(r, EV_PR_OPEN, L_PR, 0) == false;
    assert applies(r, EV_OPEN_NONE, L_AUTO, 0) == true and applies(r, EV_OPEN_LANDED, L_AUTO, 0) == false;
    assert judge(r, EV_PR_CREATED, L_PR, 0) == L_OK;
    assert judge(r, EV_PR_FAIL, L_PR, 0) == L_STEP;
    assert judge(r, EV_PR_NOURL, L_PR, 0) == L_STEP;
    assert judge(r, EV_AUTO_FAIL, L_AUTO, 0) == L_AUTO_NOT_CONFIRMED;
    assert judge(r, EV_CHECK_TRUE, L_AUTO_CHECK, 0) == L_OK;
    assert judge(r, EV_CHECK_FALSE, L_AUTO_CHECK, 0) == L_AUTO_NOT_CONFIRMED;
    assert judge(r, EV_CHECK_FAIL, L_AUTO_CHECK, 0) == L_AUTO_NOT_CONFIRMED;
    assert judge(r, "", L_AUTO_CHECK, 0) == L_AUTO_NOT_CONFIRMED;
}

// Scenario: every outcome has a name, words and an exit; the six named codes are pinned.
test every_outcome_has_its_words {
    var c : u8 = 0;
    var named : u32 = 0;
    while (c < OUTCOMES) {
        const nm : string = code_name(c);
        const why : string = code_why(c);
        if (nm.len > 0 and why.len > 0 and span_is(nm, 0, nm.len, "UNKNOWN") == false) { named = named + 1; }
        c = c + 1;
    }
    assert named == (OUTCOMES as u32);
    assert span_is(code_name(L_CONFLICT), 0, 8, "CONFLICT");
    assert span_is(code_name(L_TESTS_NOT_CLEAN), 0, 15, "TESTS_NOT_CLEAN");
    assert span_is(code_name(L_SEAL_NOT_CLEAN), 0, 14, "SEAL_NOT_CLEAN");
    assert span_is(code_name(L_TYPES_NOT_CLEAN), 0, 15, "TYPES_NOT_CLEAN");
    assert span_is(code_name(L_DUPE_NOT_SUBSET), 0, 15, "DUPE_NOT_SUBSET");
    assert span_is(code_name(L_PUSH_NOT_CONFIRMED), 0, 18, "PUSH_NOT_CONFIRMED");
    assert span_is(code_name(OUTCOMES), 0, 7, "UNKNOWN");
    assert exit_code(L_OK) == 0 and exit_code(L_LANDED) == 0 and exit_code(L_BAD_BRANCH) == L_BAD_BRANCH and exit_code(L_AUTO_NOT_CONFIRMED) == 15;
    var k : u8 = 0;
    var steps : u32 = 0;
    while (k < LAND_STEPS) {
        const sn : string = step_name(k);
        if (sn.len > 0 and span_is(sn, 0, sn.len, "unknown") == false) { steps = steps + 1; }
        k = k + 1;
    }
    assert steps == (LAND_STEPS as u32);
    assert span_is(step_name(LAND_STEPS), 0, 7, "unknown");
}

// Scenario: the worst case of every step fits, and a room that is too short writes nothing.
test the_worst_case_fits {
    var buf : [4096]u8 = [0] ** 4096;
    var small : [16]u8 = [0] ** 16;
    var mid : [32]u8 = [0] ** 32;
    const r : TriLandReq = TriLandReq { branch: B100, issue: 999999999, scratch: P256, t27c: P256, tri: P256, changes: TXT_CH_TWO, check: false, plan: false, seals: false };
    assert request_refusal(r) == L_OK;
    assert steps_sent(r, "", &buf) == (LAND_STEPS as u32);
    assert steps_sent(r, EV_RUN_G, &buf) == (LAND_STEPS as u32);
    assert step_argv(r, "", L_PR, 0, &buf) > 0 and step_argv(r, "", L_PR, 0, &buf) < CMD_MAX;
    assert step_argv(r, "", L_COMMIT, 0, &buf) > 0 and step_argv(r, "", L_COMMIT, 0, &buf) < CMD_MAX;
    assert step_argv(r, "", L_CONTAINS, 0, &buf) > 0 and step_argv(r, "", L_WORKTREE, 0, &buf) > 0;
    assert step_argv(r, "", L_COMMIT, 0, &small) == 0;
    assert step_argv(r, "", L_FETCH, 0, &small) == 0;
    assert step_argv(r, "", L_FETCH, 0, &mid) == 27;
    assert step_argv(r, "", L_HEAD, 0, &mid) == 19;
    assert step_argv(r, "", L_PUSH, 0, &mid) == 0;
    assert P256.len == 256 and P257.len == 257 and request_refusal(req_on(T_BRANCH, 11068, P257, "t27c", false)) == L_BAD_PATH;
    assert CMD_MAX == 65536;
}

// Scenario: a section is written the way preflight's readers read it, so the glue's evidence and these fixtures are one shape.
test the_evidence_section_is_written_as_the_readers_read_it {
    var buf : [4096]u8 = [0] ** 4096;
    assert buf_is(&buf, emit_section(&buf, 0, L_CHANGES, 0, 0, TXT_CH_TWO), EV_CHANGES_OK);
    assert buf_is(&buf, emit_section(&buf, 0, L_MERGED, 0, 0, "11055\n"), EV_MERGED_YES);
    assert buf_is(&buf, emit_section(&buf, 0, L_MERGED, 0, 0, ""), EV_MERGED_NONE);
    assert buf_is(&buf, emit_section(&buf, 0, L_MERGED, 0, 1, "error connecting to api.github.com\n"), EV_MERGED_FAIL);
    assert buf_is(&buf, emit_section(&buf, 0, L_MERGE, 0, 128, "x"), "@@ preflight 9 0 128 1\nx\n");
    assert buf_is(&buf, emit_section(&buf, 0, L_CLEAN, 12, 255, "ab\n"), "@@ preflight 33 12 255 3\nab\n\n");
    // the readers find it, and a later section after an earlier one
    assert exit_of(EV_CHANGES_OK, L_CHANGES, 0) == 0 and body_from(EV_CHANGES_OK, L_CHANGES, 0) == 23;
    assert exit_of(EV_MERGED_FAIL, L_MERGED, 0) == 1 and exit_of(EV_MERGED_FAIL, L_MERGED, 1) == NO_EXIT and exit_of(EV_MERGED_FAIL, L_FETCH, 0) == NO_EXIT;
    assert exit_of(EV_CONFLICT, L_CONFLICTS, 0) == 0 and exit_of(EV_CONFLICT, L_MERGE, 0) == 1;
    assert exit_of(EV_TITLE, L_TITLE, 0) == 0 and exit_of(EV_TITLE, L_COMMIT, 0) == NO_EXIT;
}

// Scenario: the cleanup step is run when the scratch tree was made, never when it was not, and a plan always shows it.
test the_clean_step_runs_only_when_the_worktree_exists {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of("", false);
    assert step_argv(r, "", L_CLEAN, 0, &buf) > 0;
    assert step_argv(r, EV_WORKTREE_OK, L_CLEAN, 0, &buf) > 0;
    assert step_argv(r, EV_WORKTREE_FAIL, L_CLEAN, 0, &buf) == 0;
    assert step_argv(r, EV_MERGED_YES, L_CLEAN, 0, &buf) == 0;
    assert step_argv(r, EV_OPEN_LANDED, L_CLEAN, 0, &buf) == 0;
    assert step_argv(r, EV_RUN_A, L_CLEAN, 0, &buf) == 0;
    assert step_argv(r, EV_RUN_B, L_CLEAN, 0, &buf) > 0;
    // the next slot never names it
    assert next_slot(req_of(TXT_CH_TWO, false), EV_RUN_G_AUTO_ON) < slot_of(L_CLEAN, 0);
    assert in_scratch(L_CLEAN) == false;
}

// Scenario: a flaky TLS or DNS answer on a network step is run again; every other failure, a rejected push included, is final.
test only_a_flaky_network_answer_is_run_again {
    const tls : string = "Post \"https://api.github.com/graphql\": tls: failed to verify certificate: x509: certificate signed by unknown authority\n";
    const hs : string = "fatal: unable to access 'https://github.com/gHashTag/t27.git/': TLS handshake timeout\n";
    const dns : string = "fatal: unable to access 'https://github.com/x.git/': Could not resolve host: github.com\n";
    const nope : string = " ! [rejected]        HEAD -> lane/x (non-fast-forward)\n";
    assert transient(L_PR, 1, tls) == true and transient(L_PUSH, 128, hs) == true and transient(L_FETCH, 128, dns) == true;
    assert transient(L_MERGED, 1, tls) == true and transient(L_OPEN, 1, tls) == true and transient(L_AUTO, 1, tls) == true;
    assert transient(L_AUTO_CHECK, 1, tls) == true and transient(L_REMOTE_HEAD, 128, dns) == true and transient(L_FETCH_BRANCH, 128, hs) == true;
    // a run that succeeded, a failure of another kind, an empty answer
    assert transient(L_PR, 0, tls) == false;
    assert transient(L_PUSH, 1, nope) == false;
    assert transient(L_PR, 1, "") == false;
    assert transient(L_PR, 1, "GraphQL: Head sha can't be blank\n") == false;
    // a step that never leaves this machine is not run again, whatever it printed
    assert transient(L_MERGE, 1, tls) == false and transient(L_TESTS, 1, tls) == false and transient(L_COMMIT, 1, tls) == false;
    assert transient(L_CHECKOUT, 128, dns) == false and transient(L_WORKTREE, 1, hs) == false and transient(L_DUPES, 1, tls) == false;
    assert over_network(L_FETCH) and over_network(L_PUSH) and over_network(L_AUTO_CHECK) and over_network(L_TIP) == false and over_network(L_CLEAN) == false;
    assert RETRIES == 5;
}

// Scenario (#11225, FR-001, FR-004): `t27b test <spec> --check` is clean with exit 0 and no MISMATCH; a MISMATCH line, a non-zero exit
// or a t27b that cannot start is refused with T27B_NOT_CLEAN, and the refusal names the spec.
test the_t27b_run_is_clean_only_with_exit_0_and_no_mismatch {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    // the passing log
    assert t27b_clean(EV_T27B_OK, 0) == true;
    assert judge(r, EV_T27B_OK, L_T27B, 0) == L_OK;
    // the refusing logs: the JIT and the interpreter disagree (exit 4), a failing test (exit 1), no t27b to start (exit 127), the word with exit 0
    assert t27b_clean(EV_T27B_MISMATCH, 0) == false;
    assert t27b_clean(EV_T27B_FAIL, 0) == false;
    assert t27b_clean(EV_T27B_ABSENT, 0) == false;
    assert t27b_clean(EV_T27B_WORD, 0) == false;
    assert judge(r, EV_T27B_MISMATCH, L_T27B, 0) == L_T27B_NOT_CLEAN;
    assert judge(r, EV_T27B_FAIL, L_T27B, 0) == L_T27B_NOT_CLEAN;
    assert judge(r, EV_T27B_ABSENT, L_T27B, 0) == L_T27B_NOT_CLEAN;
    assert judge(r, EV_T27B_WORD, L_T27B, 0) == L_T27B_NOT_CLEAN;
    // a run that left no section did not pass
    assert t27b_clean(EV_T27B_OK, 2) == false and t27b_clean("", 0) == false;
    // the second changed spec is the one that mismatches, and the refusal names it
    assert judge(r, EV_T27B_SECOND, L_T27B, 0) == L_OK;
    assert judge(r, EV_T27B_SECOND, L_T27B, 2) == L_T27B_NOT_CLEAN;
    assert buf_is(&buf, refusal_detail(r, EV_T27B_SECOND, L_T27B, 2, &buf), "specs/tri/land/other.t27");
    assert buf_is(&buf, refusal_detail(r, EV_T27B_MISMATCH, L_T27B, 0, &buf), "specs/tri/land/land.t27");
    // the named code, its exit and its words
    assert exit_code(L_T27B_NOT_CLEAN) == 16 and exit_code(L_T27B_NOT_CLEAN) != 0 and L_T27B_NOT_CLEAN < OUTCOMES;
    const nm : string = code_name(L_T27B_NOT_CLEAN);
    assert nm.len == 14 and span_is(nm, 0, 14, "T27B_NOT_CLEAN");
    const why : string = code_why(L_T27B_NOT_CLEAN);
    assert why.len > 0 and find_in(why, 0, why.len, "MISMATCH") < why.len;
}

// Scenario (FR-001): the step is `t27b test <spec> --check --quiet`, run with the t27b that sits beside t27c.
test the_t27b_step_pins_its_bytes {
    var buf : [4096]u8 = [0] ** 4096;
    var tb : [64]u8 = [0] ** 64;
    var small : [16]u8 = [0] ** 16;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert argv_is(r, "", L_T27B, 0, "t27b\ntest\nspecs/tri/land/land.t27\n--check\n--quiet\n", &buf);
    assert argv_is(r, "", L_T27B, 2, "t27b\ntest\nspecs/tri/land/other.t27\n--check\n--quiet\n", &buf);
    assert argv_is(r, "", L_T27B, 1, "t27b\ntest\n<spec>\n--check\n--quiet\n", &buf);
    // t27b is the file beside t27c, else the bare name
    assert argv_is(req_on(T_BRANCH, 11068, T_SCRATCH, "/opt/t27c/t27c", false), "", L_T27B, 0, "/opt/t27c/t27b\ntest\n<spec>\n--check\n--quiet\n", &buf);
    assert argv_is(req_on(T_BRANCH, 11068, T_SCRATCH, "./target/release/t27c", false), "", L_T27B, 0, "./target/release/t27b\ntest\n<spec>\n--check\n--quiet\n", &buf);
    assert argv_is(req_on(T_BRANCH, 11068, T_SCRATCH, "mycc", false), "", L_T27B, 0, "t27b\ntest\n<spec>\n--check\n--quiet\n", &buf);
    var m : usize = emit_t27b(&tb, 0, req_on(T_BRANCH, 11068, T_SCRATCH, "/x/t27c", false));
    assert buf_is(&tb, m, "/x/t27b");
    m = emit_t27b(&tb, 0, req_on(T_BRANCH, 11068, T_SCRATCH, "t27c", false));
    assert buf_is(&tb, m, "t27b");
    // it is a program the command may start, and only that one
    assert strange_programs(r, "", &buf) == 0;
    assert strange_programs(req_on(T_BRANCH, 11068, T_SCRATCH, "/opt/t27c/t27c", false), "", &buf) == 0;
    assert steps_with(r, "", "--check", &buf) == 1 and steps_with(r, "", "test", &buf) == 1;
    m = emit_str(&tb, 0, "t27b\ntest\n");
    assert program_ok(&tb, m, r) == true;
    m = emit_str(&tb, 0, "t27d\ntest\n");
    assert program_ok(&tb, m, r) == false;
    m = emit_str(&tb, 0, "/opt/t27c/t27b\ntest\n");
    assert program_ok(&tb, m, req_on(T_BRANCH, 11068, T_SCRATCH, "/opt/t27c/t27c", false)) == true;
    assert program_ok(&tb, m, r) == false;
    // it runs on this machine in the scratch tree, and the worst case (a 256 byte T27C) fits
    assert in_scratch(L_T27B) == true and over_network(L_T27B) == false and transient(L_T27B, 1, "x509") == false;
    const w : TriLandReq = TriLandReq { branch: B100, issue: 999999999, scratch: P256, t27c: P256C, tri: P256, changes: TXT_CH_TWO, check: false, plan: false, seals: false };
    assert request_refusal(w) == L_OK and P256C.len == 256;
    assert step_argv(w, "", L_T27B, 0, &buf) > 256 and step_argv(w, "", L_T27B, 0, &buf) < CMD_MAX;
    assert step_argv(w, "", L_T27B, 0, &small) == 0;
}

// Scenario (FR-001): the t27b step is a slot of its own, after the tests of every changed spec and before any seal; a check run keeps it.
test the_t27b_step_runs_after_the_tests_and_before_the_seals {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert next_slot(r, EV_RUN_C) == slot_of(L_T27B, 0);
    assert next_slot(r, EV_RUN_T0) == slot_of(L_T27B, 2);
    assert next_slot(r, EV_RUN_T1) == slot_of(L_SEAL, 0);
    assert next_slot(req_of(TXT_CH_TWO, true), EV_RUN_C) == slot_of(L_T27B, 0);
    assert next_slot(req_of(TXT_CH_TWO, true), EV_RUN_T1) == slot_of(L_SEAL, 0);
    // the changed lines that are not specs have no slot of this step
    assert applies(r, "", L_T27B, 0) == true and applies(r, "", L_T27B, 1) == false and applies(r, "", L_T27B, 2) == true;
    assert applies(req_of(TXT_CH_DOCS, false), "", L_T27B, 0) == false;
    assert slot_rows(r, L_T27B) == 3 and per_target(L_T27B) == true;
    assert exit_of(EV_RUN_T1, L_T27B, 0) == 0 and exit_of(EV_RUN_T1, L_T27B, 2) == 0 and exit_of(EV_RUN_T1, L_T27B, 1) == NO_EXIT;
    // a mismatch is a refusal of its own, not the tests' code, and it comes before the seal that would follow
    assert judge(r, EV_T27B_MISMATCH, L_T27B, 0) == L_T27B_NOT_CLEAN and judge(r, EV_TESTS_FAIL, L_TESTS, 0) == L_TESTS_NOT_CLEAN;
    assert L_T27B_NOT_CLEAN != L_TESTS_NOT_CLEAN and L_TESTS < L_T27B and L_T27B < L_SEAL;
}

// Scenario (FR-003): every new step has its number, its name and an argument vector in the plan, with a placeholder where the
// evidence is not there yet; the numbers are the ones of the table in the header.
test the_new_steps_have_their_numbers_and_their_place_in_the_plan {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of("", false);
    assert L_TESTS == 12 and L_T27B == 13 and L_SEAL == 14 and L_SAVE == 15 and L_RECHECK == 16;
    assert L_IMPORTERS == 17 and L_ISEAL == 18 and L_ISAVE == 19 and L_IRECHECK == 20 and L_TYPES == 21 and L_DUPES == 22;
    assert L_STAGE == 23 and L_CLEAN == 33 and LAND_STEPS == 34;
    assert span_is(step_name(L_T27B), 0, 4, "t27b") and span_is(step_name(L_IMPORTERS), 0, 9, "importers");
    assert span_is(step_name(L_ISEAL), 0, 13, "importer-seal") and span_is(step_name(L_ISAVE), 0, 13, "importer-save");
    assert span_is(step_name(L_IRECHECK), 0, 16, "importer-recheck");
    // a plan has no changes and no evidence: every step writes a vector, the new ones with `<spec>`, `<module>` or `<importer>`
    assert steps_sent(r, "", &buf) == (LAND_STEPS as u32);
    assert argv_is(r, "", L_T27B, 0, "t27b\ntest\n<spec>\n--check\n--quiet\n", &buf);
    assert argv_is(r, "", L_IMPORTERS, 0, "git\ngrep\n-l\n-F\n-e\nuse <module>::\n--\nspecs\n", &buf);
    assert argv_is(r, "", L_ISEAL, 0, "t27c\nseal\n<importer>\n--verify\n", &buf);
    assert argv_is(r, "", L_ISAVE, 0, "t27c\nseal\n<importer>\n--save\n", &buf);
    assert argv_is(r, "", L_IRECHECK, 0, "t27c\nseal\n<importer>\n--verify\n", &buf);
    // the steps that follow keep their words under their new numbers
    assert argv_is(r, "", L_TYPES, 0, "/opt/tri/tri\ntypes\nratchet\n", &buf);
    assert argv_is(r, "", L_STAGE, 0, "git\nadd\n.trinity/seals\n", &buf);
    assert argv_is(r, "", L_CLEAN, 0, "git\nworktree\nremove\n--force\n/tmp/tri-land-1\n", &buf);
    assert in_scratch(L_IMPORTERS) == true and in_scratch(L_IRECHECK) == true and over_network(L_IMPORTERS) == false and over_network(L_ISEAL) == false;
}

// Scenario (FR-002, FR-004): one grep names every changed spec by its module and lists the specs that import any of them, once each;
// its output is read as paths and nothing else.
test the_importers_of_the_changed_specs_are_searched_for {
    var buf : [4096]u8 = [0] ** 4096;
    var tb : [64]u8 = [0] ** 64;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert argv_is(r, "", L_IMPORTERS, 0, "git\ngrep\n-l\n-F\n-e\nuse tri::land::land::\n-e\nuse tri::land::other::\n--\nspecs\n", &buf);
    assert argv_is(req_of(TXT_CH_ONE, false), "", L_IMPORTERS, 0, "git\ngrep\n-l\n-F\n-e\nuse tri::land::land::\n--\nspecs\n", &buf);
    assert argv_is(req_of(TXT_CH_KEYS, false), "", L_IMPORTERS, 0, "git\ngrep\n-l\n-F\n-e\nuse t27os::keys::\n-e\nuse t27os::keys_probe::\n--\nspecs\n", &buf);
    assert argv_is(req_of(TXT_CH_TOP, false), "", L_IMPORTERS, 0, "git\ngrep\n-l\n-F\n-e\nuse top::\n--\nspecs\n", &buf);
    var m : usize = emit_module(&tb, 0, TXT_CH_KEYS, 1);
    assert buf_is(&tb, m, "t27os::keys_probe");
    // a branch that changes no spec has nothing to search for, and a spec that is no target is not searched for
    assert has_target(TXT_CH_DOCS) == false and has_target(TXT_CH_TWO) == true and has_target("") == false;
    assert applies(req_of(TXT_CH_DOCS, false), "", L_IMPORTERS, 0) == false and applies(r, "", L_IMPORTERS, 0) == true;
    assert argv_is(req_of(TXT_CH_BAD, false), "", L_IMPORTERS, 0, "git\ngrep\n-l\n-F\n-e\nuse <module>::\n--\nspecs\n", &buf);
    // one step for all of them, run once, with a program the command may start
    assert slot_rows(r, L_IMPORTERS) == 1 and per_target(L_IMPORTERS) == false and per_importer(L_IMPORTERS) == false;
    assert steps_with(r, "", "grep", &buf) == 1 and strange_programs(r, "", &buf) == 0 and forced_pushes(r, "", &buf) == 0;
    // the output: exit 1 is no match, exit 128 or a stray line is not readable
    assert judge(r, EV_IMP_NONE, L_IMPORTERS, 0) == L_OK;
    assert judge(r, EV_IMP_THREE, L_IMPORTERS, 0) == L_OK;
    assert judge(r, EV_IMP_FAIL, L_IMPORTERS, 0) == L_STEP;
    assert judge(r, EV_IMP_STRAY, L_IMPORTERS, 0) == L_STEP;
    assert judge(r, EV_IMP_SPACE, L_IMPORTERS, 0) == L_STEP;
    assert importers_read(EV_IMP_NONE) == true and importers_read(EV_IMP_THREE) == true and importers_read(EV_IMP_STRAY) == false;
    // a path is specs/, bytes that need no quoting, .t27
    const a : string = "specs/a.t27";
    const b : string = "specs/.t27";
    const c : string = "docs/a.t27";
    const d : string = "specs/a.md";
    const e : string = "specs/a\"b.t27";
    const f : string = "specs/a\tb.t27";
    assert importer_line(a, 0, a.len) == true;
    assert importer_line(b, 0, b.len) == false and importer_line(c, 0, c.len) == false and importer_line(d, 0, d.len) == false;
    assert importer_line(e, 0, e.len) == false and importer_line(f, 0, f.len) == false;
    assert importer_line("", 0, 0) == false;
}

// Scenario (FR-002): the extra specs are the importers that are neither changed nor scratch, and the run can list them on one line.
test the_extra_specs_are_the_importers_that_are_not_changed {
    var buf : [4096]u8 = [0] ** 4096;
    var small : [16]u8 = [0] ** 16;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    assert body_from(EV_IMP_THREE, L_IMPORTERS, 0) == 23;
    // a.t27 starts at 23, other.t27 (a changed spec) at 45, b.t27 at 70, a scratch spec at 92
    assert importer_wanted(r, EV_IMP_THREE, 23) == true;
    assert importer_wanted(r, EV_IMP_THREE, 45) == false;
    assert importer_wanted(r, EV_IMP_THREE, 70) == true;
    assert importer_wanted(r, EV_IMP_THREE, 92) == false;
    // an offset that is not the start of a line, lies outside the output, or belongs to no importers' output
    assert importer_wanted(r, EV_IMP_THREE, 24) == false and importer_wanted(r, EV_IMP_THREE, 0) == false and importer_wanted(r, EV_IMP_THREE, 500) == false;
    assert importer_wanted(r, EV_IMP_NONE, 23) == false and importer_wanted(r, "", 0) == false;
    // the same line is an extra spec as soon as it is not a changed one
    assert importer_wanted(req_of(TXT_CH_ONE, false), EV_IMP_THREE, 45) == true;
    assert is_changed(r, EV_IMP_THREE, 45, 69) == true and is_changed(r, EV_IMP_THREE, 23, 44) == false and is_changed(r, EV_IMP_THREE, 45, 68) == false;
    // the run lists them
    assert buf_is(&buf, importer_names(r, EV_IMP_THREE, &buf), "specs/tri/users/a.t27 specs/tri/users/b.t27");
    assert buf_is(&buf, importer_names(req_of(TXT_CH_ONE, false), EV_IMP_THREE, &buf), "specs/tri/users/a.t27 specs/tri/land/other.t27 specs/tri/users/b.t27");
    assert importer_names(r, EV_IMP_NONE, &buf) == 0 and importer_names(r, "", &buf) == 0;
    assert importer_names(r, EV_IMP_THREE, &small) == 0;
}

// Scenario (FR-002, FR-004): an importer's seal is verified; one that did not match is saved and verified again, and a refusal there
// names it; one with no seal at all is left alone.
test an_importer_whose_seal_drifted_is_saved_and_checked_again {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    // the slots over the importers, in the order of the evidence
    assert next_importer(r, EV_IMP_THREE, L_ISEAL) == 23;
    assert next_importer(r, EV_IMP_A_OK, L_ISEAL) == 70;
    assert next_importer(r, EV_IMP_B_BAD, L_ISEAL) == ABSENT;
    assert next_importer(r, EV_IMP_A_OK, L_ISAVE) == ABSENT and next_importer(r, EV_IMP_A_OK, L_IRECHECK) == ABSENT;
    assert next_importer(r, EV_IMP_B_BAD, L_ISAVE) == 70 and next_importer(r, EV_IMP_B_BAD, L_IRECHECK) == ABSENT;
    assert next_importer(r, EV_IMP_B_SAVED, L_ISAVE) == ABSENT and next_importer(r, EV_IMP_B_SAVED, L_IRECHECK) == 70;
    assert next_importer(r, EV_IMP_B_MATCH, L_ISEAL) == ABSENT and next_importer(r, EV_IMP_B_MATCH, L_ISAVE) == ABSENT and next_importer(r, EV_IMP_B_MATCH, L_IRECHECK) == ABSENT;
    // an importer with no seal has nothing to verify and nothing to save
    assert unsealed(EV_IMP_B_NONE, L_ISEAL, 70) == true and unsealed(EV_IMP_B_BAD, L_ISEAL, 70) == false and unsealed(EV_IMP_A_OK, L_ISEAL, 23) == false;
    assert next_importer(r, EV_IMP_B_NONE, L_ISAVE) == ABSENT and next_importer(r, EV_IMP_B_NONE, L_ISEAL) == ABSENT;
    // the first verify never decides; the second does: a seal still drifting after the save is SEAL_NOT_CLEAN
    assert judge(r, EV_IMP_A_OK, L_ISEAL, 23) == L_OK;
    assert judge(r, EV_IMP_B_BAD, L_ISEAL, 70) == L_OK;
    assert judge(r, EV_IMP_B_NONE, L_ISEAL, 70) == L_OK;
    assert judge(r, EV_IMP_B_MATCH, L_IRECHECK, 70) == L_OK;
    assert judge(r, EV_IMP_B_STILL, L_IRECHECK, 70) == L_SEAL_NOT_CLEAN;
    assert exit_code(judge(r, EV_IMP_B_STILL, L_IRECHECK, 70)) == 11;
    assert buf_is(&buf, refusal_detail(r, EV_IMP_B_STILL, L_IRECHECK, 70, &buf), "specs/tri/users/b.t27");
    // the vectors name the importer; the save is the only write
    assert argv_is(r, EV_IMP_B_BAD, L_ISEAL, 23, "t27c\nseal\nspecs/tri/users/a.t27\n--verify\n", &buf);
    assert argv_is(r, EV_IMP_B_BAD, L_ISAVE, 70, "t27c\nseal\nspecs/tri/users/b.t27\n--save\n", &buf);
    assert argv_is(r, EV_IMP_B_SAVED, L_IRECHECK, 70, "t27c\nseal\nspecs/tri/users/b.t27\n--verify\n", &buf);
    assert argv_is(r, EV_IMP_B_BAD, L_ISEAL, 45, "t27c\nseal\n<importer>\n--verify\n", &buf);
    assert argv_is(r, EV_IMP_B_BAD, L_ISEAL, 92, "t27c\nseal\n<importer>\n--verify\n", &buf);
    // a changed importer is not run twice, as its own seal steps gated it
    assert applies(r, EV_IMP_THREE, L_ISEAL, 45) == false and applies(r, EV_IMP_THREE, L_ISEAL, 23) == true;
    assert applies(r, EV_IMP_B_BAD, L_ISAVE, 70) == true and applies(r, EV_IMP_A_OK, L_ISAVE, 23) == false;
    assert applies(r, EV_IMP_B_SAVED, L_IRECHECK, 70) == true and applies(r, EV_IMP_B_BAD, L_IRECHECK, 70) == false;
    assert per_importer(L_ISEAL) and per_importer(L_ISAVE) and per_importer(L_IRECHECK) and per_importer(L_TYPES) == false and slot_rows(r, L_ISEAL) == 0;
}

// Scenario (FR-002, FR-003): the importers are looked up after the seals of the changed specs and verified before the types ratchet; a
// check run keeps them; a slot's entry is the offset of its importer's line, and the glue's division gets it back.
test the_importers_are_verified_between_the_seals_and_the_types {
    const r : TriLandReq = req_of(TXT_CH_TWO, false);
    const c : TriLandReq = req_of(TXT_CH_TWO, true);
    const oi : u64 = (body_from(EV_RUN_I0, L_IMPORTERS, 0) as u64);
    const ob : u64 = oi + 47;
    assert next_slot(r, EV_RUN_R) == slot_of(L_IMPORTERS, 0);
    assert next_slot(r, EV_RUN_I0) == slot_of(L_ISEAL, oi);
    assert next_slot(r, EV_RUN_I1) == slot_of(L_TYPES, 0);
    assert next_slot(c, EV_RUN_R) == slot_of(L_IMPORTERS, 0);
    assert next_slot(c, EV_RUN_I0) == slot_of(L_ISEAL, oi);
    assert next_slot(c, EV_RUN_I1) == slot_of(L_TYPES, 0);
    // a branch whose grep found nothing goes straight on to the types
    assert exit_of(EV_RUN_E, L_IMPORTERS, 0) == 1 and next_slot(r, EV_RUN_E) == slot_of(L_STAGE, 0);
    assert slot_of(L_ISEAL, oi) / SLOT == (L_ISEAL as u64) and slot_of(L_ISEAL, oi) % SLOT == oi;
    // what the run left: the grep, the verify of both importers, the save and the second verify of the one that drifted
    assert exit_of(EV_RUN_I1, L_IMPORTERS, 0) == 0 and exit_of(EV_RUN_I1, L_ISEAL, oi) == 0 and exit_of(EV_RUN_I1, L_ISEAL, ob) == 1;
    assert exit_of(EV_RUN_I1, L_ISAVE, ob) == 0 and exit_of(EV_RUN_I1, L_IRECHECK, ob) == 0 and exit_of(EV_RUN_I1, L_ISAVE, oi) == NO_EXIT;
    assert importer_wanted(r, EV_RUN_I1, oi) == true and importer_wanted(r, EV_RUN_I1, ob) == true and importer_wanted(r, EV_RUN_I1, oi + 22) == false;
    // the slots stay below DONE with the widest entry the evidence can hold
    assert (LAND_STEPS as u64) * SLOT < DONE and SLOT > 100000000;
}

test seals_mode_re_saves_the_seals_of_the_changed_specs_and_their_importers_and_nothing_else {
    var buf : [4096]u8 = [0] ** 4096;
    const r : TriLandReq = TriLandReq { branch: "", issue: 0, scratch: T_SCRATCH, t27c: "t27c", tri: T_TRI, changes: TXT_CH_TWO, check: true, plan: false, seals: true };
    // no branch and no issue are asked for; a landing still asks for both
    assert request_refusal(r) == L_OK;
    assert request_refusal(req_on("", 0, T_SCRATCH, "t27c", false)) == L_BAD_BRANCH;
    // the changes are read from the working tree against the merge-base, not from a merge in a scratch worktree
    assert argv_is(r, "", L_CHANGES, 0, "git\ndiff\n--name-status\n--no-renames\n--merge-base\norigin/master\n", &buf);
    assert argv_is(req_of(TXT_CH_TWO, false), "", L_CHANGES, 0, "git\ndiff\n--cached\n--name-status\n--no-renames\norigin/master\n", &buf);
    assert cwd_scratch(r, L_SEAL) == false and cwd_scratch(r, L_IMPORTERS) == false and cwd_scratch(req_of(TXT_CH_TWO, false), L_SEAL) == true;
    // no merge, no tests, no types, no dupes, no push: only the changes, the seal steps and the importers' steps are wanted
    assert applies(r, EV_RUN_C, L_FETCH, 0) == false and applies(r, EV_RUN_C, L_MERGE, 0) == false and applies(r, EV_RUN_C, L_TESTS, 0) == false;
    assert applies(r, EV_RUN_C, L_T27B, 0) == false and applies(r, EV_RUN_C, L_TYPES, 0) == false and applies(r, EV_RUN_C, L_DUPES, 0) == false;
    assert applies(r, EV_RUN_C, L_PUSH, 0) == false and applies(r, EV_RUN_C, L_COMMIT, 0) == false;
    assert applies(r, EV_RUN_C, L_SEAL, 0) == true and applies(r, EV_RUN_C, L_IMPORTERS, 0) == true;
    // the order: changes, then each changed spec is verified, saved again when it drifted, verified again, and the run ends
    assert next_slot(r, "") == (L_CHANGES as u64) * SLOT;
    assert next_slot(r, EV_RUN_C) == (L_SEAL as u64) * SLOT;
    assert next_slot(r, EV_RUN_D) == (L_SAVE as u64) * SLOT + 2;
    assert next_slot(r, EV_RUN_E) == DONE;
    // a branch with no spec change is not an error here: there is nothing to seal
    assert judge(r, "@@ preflight 11 0 0 0\n\n", L_CHANGES, 0) == L_OK;
    assert judge(req_of("", false), "@@ preflight 11 0 0 0\n\n", L_CHANGES, 0) == L_STEP;
}
