// SPDX-License-Identifier: Apache-2.0
; specs/tri/land/land.t27 -- `tri land <branch> --issue <N>`: land one lane branch with the gates in a fixed order (#11068)
; On the night of 2026-10-19 every lane branch was landed by a throwaway shell script outside the repository: merge master,
; run the tests and look for vacuous passes, save and verify the seals, check the types ratchet and the dupe-scan subset,
; commit, push, open the pull request, enable auto-merge. That is a rule set and a pipeline, so it lives here, in .t27, and
; `tri land` (cli/tri/src/main.rs, through `t27c gen-rust` in gen/rust/tri/land/land.rs) is glue: it asks this spec which step
; runs next, runs that step as an argument vector with no shell, writes its output down as evidence and asks this spec to judge
; it. The first step that is judged a refusal stops everything, and the command prints the refusal's name.
; -
; WHAT WAS FOUND BEFORE THIS WAS WRITTEN (FR-004). `tri pr ready` (cli/tri/src/prcheck.rs) judges the checks of an OPEN pull
; request and, with --merge, merges it: it starts after this command ends. `tri pr landed` asks whether a MERGED pull request's
; content reached master: it starts after that. `tri pr preflight` (specs/tri/pr/preflight.t27) judges a branch before it
; becomes a pull request, on the same gates, but it never merges master, saves a seal, commits, pushes or opens anything, and its
; steps are `sh -c` strings. specs/claw/merge_judge.t27 and merge_lane.t27 decide what the SERVER-side merger merges and whether
; it is starved; specs/claw/push_gate.t27 decides whether a fix push is worth its place in the Actions queue. None of them lands
; a branch. So this spec reuses preflight's readers by `use` (the evidence sections, the changed-file list, line search), the
; receipt line readers, lanes' number reader and remote_job's byte writers and name rules, and adds only what no one had: the
; order of the steps, the readers of the five gate outputs the night's script read, the dupe-subset rule on names, and the
; refusal codes. specs/tri/test/report.t27 already reads `t27c test-report`, but a `use` path through `tri::test` stops at the
; keyword `test` (preflight says the same), so the three totals lines are read here again, by count_line, on the same text.
; -
; THE REQUEST is one TriLandReq: the branch, the issue number, the scratch directory of the worktree, the t27c and tri programs,
; the output of the CHANGES step once it has run (the glue stores it here), and two flags: check (stop before the commit) and
; plan (print the steps, run none). request_refusal() says why a request may not run (L_OK is 0).
; -
; THE STEPS, in this order, each one a slot (step, entry) ; entry n is the n-th line of CHANGES for a per-target step, and for a
; per-importer step (18 to 20) the offset in the evidence of the importer's line, which never moves, as the evidence only grows.
;   0  fetch          git fetch -q origin master
;   1  merged         gh pr list --repo R --head B --state merged  -> a number: ALREADY_LANDED
;   2  tip            git rev-parse --verify -q refs/heads/B       -> the branch's local tip (NO_BRANCH without it)
;   3  fetch_branch   git fetch -q origin B                        (its exit is data: the branch may not exist there yet)
;   4  contains       git merge-base --is-ancestor refs/heads/B refs/remotes/origin/B   (exit 0: the remote holds the tip)
;   5  open           gh pr list ... --state open -> `<n> <auto>`; an open PR with auto-merge on and the tip on the remote:
;                     ALREADY_LANDED, and nothing below runs
;   6  worktree       git worktree add -q --detach <scratch> origin/master     (the caller's checkout is never touched)
;   7  master_dupes   python3 tools/dupe_scan.py   on master's tree: the failing set the branch inherits
;   8  checkout       git checkout -q --detach refs/heads/B
;   9  merge          git merge --no-commit --no-ff origin/master
;  10  conflicts      git diff --name-only --diff-filter=U         -> any name: CONFLICT, with the names
;  11  changes        git diff --cached --name-status --no-renames origin/master    -> the specs to gate
;  12  tests    n     t27c test-report <spec> --specs-dir specs     -> TESTS_NOT_CLEAN
;  13  t27b     n     t27b test <spec> --check --quiet            the JIT against the interpreter (#11225)
;                     -> T27B_NOT_CLEAN on a line MISMATCH or a non-zero exit; t27b is the program next to t27c
;  14  seal     n     t27c seal <spec> --verify
;  15  save     n     t27c seal <spec> --save       only for a spec whose seal did not MATCH
;  16  recheck  n     t27c seal <spec> --verify     only after a save                        -> SEAL_NOT_CLEAN
;  17  importers      git grep -l -F -e "use <module>::" (one -e per changed spec) -- specs   (#11225)
;                     the specs that import a changed spec; <module> is the path without specs/ and .t27, `/` as `::`
;  18  imp_seal   i   t27c seal <importer> --verify    for each importer that is not itself changed (entry i: its line's offset)
;  19  imp_save   i   t27c seal <importer> --save      only for an importer whose seal did not MATCH and exists
;  20  imp_recheck i  t27c seal <importer> --verify    only after a save                        -> SEAL_NOT_CLEAN
;  21  types          tri types ratchet                                                      -> TYPES_NOT_CLEAN
;  22  dupes          python3 tools/dupe_scan.py                                             -> DUPE_NOT_SUBSET
;  --- check stops here ---
;  23  stage          git add .trinity/seals
;  24  pending        git diff --cached --quiet                   (exit 1: the merge or a seal changed something)
;  25  title          git log -1 --no-merges --format=%s          the lane's own last subject
;  26  commit         git -c core.hooksPath=.githooks commit -q -m <title> -m <what this is>     only when pending
;  27  head           git rev-parse HEAD
;  28  push           git push origin HEAD:refs/heads/B           never forced
;  29  remote_head    git ls-remote origin refs/heads/B           -> the same object as HEAD, else PUSH_NOT_CONFIRMED
;  30  pr             gh pr create ...                            only when no PR is open
;  31  auto           gh pr merge <n> --repo R --auto --squash    only when auto-merge is not on
;  32  auto_check     gh pr view <n> ... autoMergeRequest         -> true, else AUTO_NOT_CONFIRMED
;  33  clean          git worktree remove --force <scratch>       run by the glue at the end, on every path
; Steps 23 to 32 are not slots of a check run, and step 31 is reached only through the pass of steps 12 to 22 and 27 to 29: a
; slot is chosen only when every earlier slot has a section of evidence, and the glue stops at the first refusal, so auto-merge
; is never enabled unless every gate before it passed. The word `--force`, `-f` and a `+` refspec appear in no step, and the
; only write to a remote ref is `HEAD:refs/heads/B` with B a branch that is not master, main or HEAD (branch_ok): master is
; never written.
; -
; THE TWO GATES OF #11225. Step 13: `t27b test <spec> --check` runs the spec in the JIT and again in the reference interpreter
; and says MISMATCH when they disagree; a scratch array that is never written (`[3]usize = undefined`) passes the JIT and
; faults the interpreter (#11131), and only this step sees it. Steps 17 to 20: a spec that `use`s a changed spec can move its own
; seal (its generated code reads the changed one) without being touched (#11102), so verifying the seals of the changed specs
; alone is not enough; every importer, one level, is verified, and an importer whose seal drifted is saved and verified again as
; a changed spec is. An importer that has no seal (`Error: No saved seal found`) has nothing to verify and is left alone; an
; importer that is itself changed was gated by steps 14 to 16 and is not run twice. The importers' step is one grep for all
; changed specs, so a spec that imports two of them is listed once. `importer_names` writes the extra specs of a run, one line.
; -
; THE EVIDENCE is the one preflight reads: for each run `@@ preflight <step> <entry> <exit> <length>\n` and then the output
; (stdout and stderr) of exactly that length and a newline. emit_section() writes it, and the glue appends what it writes.
; -
; THE RULES (each one has a test below; the fixtures are the programs' real text, shortened).
;   tests_clean   `t27c test-report`: the totals lines `  tests       N`, `  FAIL        F` and `  vacuous passes  V of M  (...)` are
;                 all present, F == 0 and V == 0. A report with no totals (a BLOCKED spec), `vacuous passes unknown` or no such
;                 line at all (a t27c older than #6509) is not clean: nothing could be counted.
;   t27b_clean    `t27b test <spec> --check --quiet`: exit 0 and no `MISMATCH` anywhere in its output. A t27b that cannot be started
;                 (not next to t27c) exits 127 and is not clean.
;   seal_clean    `t27c seal --verify`: a line `all hashes MATCH` and no line `VERIFICATION FAILED`.
;   importers     `git grep -l`: exit 0 or 1 (1 is no match), and every line is a path under specs/ ending .t27; exit 2 or a stray
;                 line is STEP_FAILED. An importer is run when it is not under specs/scratch/ and is not itself a changed spec.
;   types_clean   `tri types ratchet`: exit 0 and a line `RATCHET: CLEAN`.
;   dupe subset   `python3 tools/dupe_scan.py` prints `::error::a body written under <name> is now copied [n] time(s) and was in
;                 no ledger` and `::error::<name> was copied [a] and is now copied [b]`. The failing set of the branch is the
;                 names on those lines; it must be a subset of master's. Exit 0 (no finding) passes; exit 1 with a finding that
;                 master's scan does not print under the same name is DUPE_NOT_SUBSET; any other exit, or exit 1 with no finding,
;                 is unreadable and refused. A branch that fixes an inherited dupe passes (a subset is not the same set).
;   already       a merged PR for the head branch, or an open one with auto-merge on whose branch the remote already holds in full.
;   push          exit 0, and `git ls-remote` names the object `git rev-parse HEAD` named.
;   transient     a network step that fails with `x509`, `TLS handshake timeout` or `Could not resolve host` (nothing was sent) is
;                 run again, at most 5 more times, 3 seconds apart; any other failure, a rejected push included, is final.
; -
; THE HONEST LIMITS. A pass says these rules hold on these fixtures; it does not say that git, gh, t27c or GitHub answer. No test
; here starts a program. (1) The dupe rule is on names, as the night's script was: a group that GROWS under a name master already
; fails is not caught here; `tri pr preflight` compares whole lines and does catch it. (2) A branch name reused for new work after
; its PR merged reads as ALREADY_LANDED: lane names are unique, use a new one. (3) The command lands the COMMITTED branch; an
; uncommitted change in the caller's checkout is not in it. (4) The push goes to origin's copy of the branch, so the caller's local
; branch is behind it by the merge and seal commit until `git pull --ff-only`; a new local commit on top of the old tip then meets a
; remote that has moved, and the push is refused (never forced). (5) The pull request body and the commit message are one line each.
; (6) The importers are the specs whose text holds `use <module>::`: one level, so a spec that reaches a changed one through two
; hops is not verified here; a comment that holds the text makes a spec an importer too, which costs one verify and nothing else.
; (7) t27b is the file named t27b in the directory of T27C (the bare name t27b when T27C is the bare name t27c): a build that has
; t27c and no t27b beside it is refused with T27B_NOT_CLEAN, not skipped. (8) The importers' grep names every changed spec in one
; argument vector of CMD_MAX bytes: a branch of more than about 1500 changed specs does not fit and the glue stops with `does not fit`.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriLand;

use tri::lab::receipt::line_end;
use tri::lab::receipt::span_is;
use tri::lanes::lanes::digits;
use tri::pr::preflight::NO_EXIT;
use tri::pr::preflight::entries;
use tri::pr::preflight::is_spec;
use tri::pr::preflight::is_target;
use tri::pr::preflight::path_safe;
use tri::pr::preflight::path_start;
use tri::pr::preflight::path_end;
use tri::pr::preflight::exit_of;
use tri::pr::preflight::body_from;
use tri::pr::preflight::body_to;
use tri::pr::preflight::has_line;
use tri::pr::preflight::find_in;
use tri::pr::preflight::digits_end;
use tri::pr::preflight::same;
use tri::remote::remote_job::emit_byte;
use tri::remote::remote_job::emit_str;
use tri::remote::remote_job::emit_dec;
use tri::remote::remote_job::fits;
use tri::remote::remote_job::safe_path;
use tri::remote::remote_job::buf_is;
use tri::remote::remote_job::buf_has;

pub const REPO : str = "gHashTag/t27";
pub const BRANCH_MAX : usize = 100;
pub const ISSUE_MAX : u64 = 999999999;
// The room one step's argument vector is written into; the tests prove the worst case fits. Every step but the importers' grep needs
// less than 4096; that one names every changed spec (about 40 bytes each), so the room holds a branch of some 1500 specs.
pub const CMD_MAX : usize = 65536;
// A slot is step * SLOT + entry; DONE says there is none left. A number is read to 18 digits, ABSENT is one more digit. The entry of
// a per-importer step is an offset in the evidence, so SLOT is wider than any evidence the glue can hold (LAND_STEPS * SLOT < DONE).
pub const SLOT : u64 = 1000000000;
pub const DONE : u64 = 99999999999;
pub const ABSENT : u64 = 1000000000000000000;
// How many more times a network step is run after a flaky TLS or DNS answer (transient).
pub const RETRIES : u64 = 5;

// The steps.
pub const L_FETCH : u8 = 0;
pub const L_MERGED : u8 = 1;
pub const L_TIP : u8 = 2;
pub const L_FETCH_BRANCH : u8 = 3;
pub const L_CONTAINS : u8 = 4;
pub const L_OPEN : u8 = 5;
pub const L_WORKTREE : u8 = 6;
pub const L_MASTER_DUPES : u8 = 7;
pub const L_CHECKOUT : u8 = 8;
pub const L_MERGE : u8 = 9;
pub const L_CONFLICTS : u8 = 10;
pub const L_CHANGES : u8 = 11;
pub const L_TESTS : u8 = 12;
pub const L_T27B : u8 = 13;
pub const L_SEAL : u8 = 14;
pub const L_SAVE : u8 = 15;
pub const L_RECHECK : u8 = 16;
pub const L_IMPORTERS : u8 = 17;
pub const L_ISEAL : u8 = 18;
pub const L_ISAVE : u8 = 19;
pub const L_IRECHECK : u8 = 20;
pub const L_TYPES : u8 = 21;
pub const L_DUPES : u8 = 22;
pub const L_STAGE : u8 = 23;
pub const L_PENDING : u8 = 24;
pub const L_TITLE : u8 = 25;
pub const L_COMMIT : u8 = 26;
pub const L_HEAD : u8 = 27;
pub const L_PUSH : u8 = 28;
pub const L_REMOTE_HEAD : u8 = 29;
pub const L_PR : u8 = 30;
pub const L_AUTO : u8 = 31;
pub const L_AUTO_CHECK : u8 = 32;
pub const L_CLEAN : u8 = 33;
pub const LAND_STEPS : u8 = 34;

// The outcomes. 0 says go on; 1 to 3 end the run well; every other code is a refusal and is the exit code of the command.
pub const L_OK : u8 = 0;
pub const L_ALREADY : u8 = 1;
pub const L_LANDED : u8 = 2;
pub const L_CHECKED : u8 = 3;
pub const L_BAD_BRANCH : u8 = 4;
pub const L_BAD_ISSUE : u8 = 5;
pub const L_BAD_PATH : u8 = 6;
pub const L_STEP : u8 = 7;
pub const L_NO_BRANCH : u8 = 8;
pub const L_CONFLICT : u8 = 9;
pub const L_TESTS_NOT_CLEAN : u8 = 10;
pub const L_SEAL_NOT_CLEAN : u8 = 11;
pub const L_TYPES_NOT_CLEAN : u8 = 12;
pub const L_DUPE_NOT_SUBSET : u8 = 13;
pub const L_PUSH_NOT_CONFIRMED : u8 = 14;
pub const L_AUTO_NOT_CONFIRMED : u8 = 15;
pub const L_T27B_NOT_CLEAN : u8 = 16;
pub const OUTCOMES : u8 = 17;

pub struct TriLandReq {
    branch: string,
    issue: u64,
    scratch: string,
    t27c: string,
    tri: string,
    changes: string,
    check: bool,
    plan: bool,
    // seals mode (`tri seals changed`): no branch, no network, no worktree; only the steps that read the changes and re-save the seals
    seals: bool,
}

invariant the_steps_and_outcomes_are_numbered { assert L_MERGED < L_OPEN and L_OPEN < L_WORKTREE and L_MERGE < L_CONFLICTS and L_CONFLICTS < L_CHANGES and L_CHANGES < L_TESTS and L_TESTS < L_T27B and L_T27B < L_SEAL and L_SEAL < L_SAVE and L_SAVE < L_RECHECK and L_RECHECK < L_IMPORTERS and L_IMPORTERS < L_ISEAL and L_ISEAL < L_ISAVE and L_ISAVE < L_IRECHECK and L_IRECHECK < L_TYPES and L_TYPES < L_DUPES and L_DUPES < L_STAGE and L_STAGE < L_COMMIT and L_COMMIT < L_PUSH and L_PUSH < L_REMOTE_HEAD and L_REMOTE_HEAD < L_PR and L_PR < L_AUTO and L_AUTO < L_AUTO_CHECK and L_AUTO_CHECK < L_CLEAN and L_CLEAN + 1 == LAND_STEPS and L_CHECKED < L_BAD_BRANCH and L_AUTO_NOT_CONFIRMED + 1 == L_T27B_NOT_CLEAN and L_T27B_NOT_CLEAN + 1 == OUTCOMES and (LAND_STEPS as u64) * SLOT < DONE; }

// --- the request ---------------------------------------------------------------------------------

/// Is b master, main or HEAD: a name the push must never write.
pub fn is_trunk(b: string) -> bool {
    return span_is(b, 0, b.len, "master") or span_is(b, 0, b.len, "main") or span_is(b, 0, b.len, "HEAD");
}

/// A branch that may be written into a command: remote_job's path bytes (letters, digits, `_-./`, no `..`, not starting with `-`),
/// at most BRANCH_MAX; not starting or ending with `/`, not ending with `.`, no empty or dotted component, not ending `.lock`;
/// and not master, main or HEAD.
pub fn branch_ok(b: string) -> bool {
    if (b.len > BRANCH_MAX or safe_path(b) == false or is_trunk(b)) { return false; }
    if (b[0] == 46 or b[0] == 47 or b[b.len - 1] == 47 or b[b.len - 1] == 46) { return false; }
    if (b.len >= 5 and span_is(b, b.len - 5, b.len, ".lock")) { return false; }
    var i : usize = 1;
    while (i < b.len) {
        if (b[i - 1] == 47 and (b[i] == 47 or b[i] == 46)) { return false; }
        i = i + 1;
    }
    return true;
}

/// Why this request may not run, L_OK when it may. The first rule that fails decides. A plan may leave the issue out.
pub fn request_refusal(r: TriLandReq) -> u8 {
    if (r.seals == false and branch_ok(r.branch) == false) { return L_BAD_BRANCH; }
    if (r.issue > ISSUE_MAX or (r.issue == 0 and r.plan == false and r.seals == false)) { return L_BAD_ISSUE; }
    if (safe_path(r.scratch) == false or safe_path(r.t27c) == false or safe_path(r.tri) == false) { return L_BAD_PATH; }
    return L_OK;
}

// --- reading the evidence ------------------------------------------------------------------------

/// The number of the first line of text[from..to] that is `label`, blanks and digits, then a blank or the end of the line;
/// ABSENT when no line is, or the number has more than 18 digits. A line `FAIL  negz` (a failing test) is not that line.
pub fn count_line(text: string, from: usize, to: usize, label: string) -> u64 {
    var at : usize = from;
    while (at < to) {
        var end : usize = line_end(text, at);
        if (end > to) { end = to; }
        var k : usize = at;
        while (k < end and (text[k] == 32 or text[k] == 9)) { k = k + 1; }
        if (k + label.len < end and span_is(text, k, k + label.len, label) and (text[k + label.len] == 32 or text[k + label.len] == 9)) {
            var d : usize = k + label.len;
            while (d < end and (text[d] == 32 or text[d] == 9)) { d = d + 1; }
            const e : usize = digits_end(text, d, end);
            if (e > d and (e == end or text[e] == 32 or text[e] == 9)) {
                if (e - d > 18) { return ABSENT; }
                return digits(text, d, e);
            }
        }
        at = end + 1;
    }
    return ABSENT;
}

/// Is the test report of entry n clean: the three totals are there, no test failed and no pass was vacuous?
pub fn tests_clean(ev: string, n: u64) -> bool {
    const f : usize = body_from(ev, L_TESTS, n);
    const t : usize = body_to(ev, L_TESTS, n);
    if (count_line(ev, f, t, "tests") == ABSENT) { return false; }
    return count_line(ev, f, t, "FAIL") == 0 and count_line(ev, f, t, "vacuous passes") == 0;
}

/// Is the output of step k, entry n, a seal verification that matched: `all hashes MATCH` and no `VERIFICATION FAILED`?
pub fn seal_clean(ev: string, k: u8, n: u64) -> bool {
    const f : usize = body_from(ev, k, n);
    const t : usize = body_to(ev, k, n);
    return has_line(ev, f, t, "all hashes MATCH") and has_line(ev, f, t, "VERIFICATION FAILED") == false;
}

/// Did step k, entry n, find no seal for its spec at all: a line `Error: No saved seal found`? Such a spec has nothing to verify.
pub fn unsealed(ev: string, k: u8, n: u64) -> bool {
    return has_line(ev, body_from(ev, k, n), body_to(ev, k, n), "Error: No saved seal found");
}

/// Is the t27b run of entry n clean: exit 0 and the word MISMATCH nowhere in its output? A JIT that agrees with the interpreter
/// prints no such word; one that does not exits 4 as well, and an interpreter fault (#11131) is a mismatch.
pub fn t27b_clean(ev: string, n: u64) -> bool {
    if (exit_of(ev, L_T27B, n) != 0) { return false; }
    return find_in(ev, body_from(ev, L_T27B, n), body_to(ev, L_T27B, n), "MISMATCH") > ev.len;
}

/// Is the types ratchet clean: exit 0 and a line `RATCHET: CLEAN`?
pub fn types_clean(ev: string) -> bool {
    return exit_of(ev, L_TYPES, 0) == 0 and has_line(ev, body_from(ev, L_TYPES, 0), body_to(ev, L_TYPES, 0), "RATCHET: CLEAN");
}

/// The digits that start the output of step k, 0 when it does not start with a number.
pub fn lead_number(ev: string, k: u8) -> u64 {
    const f : usize = body_from(ev, k, 0);
    const e : usize = digits_end(ev, f, body_to(ev, k, 0));
    if (e == f or e - f > 18) { return 0; }
    return digits(ev, f, e);
}

/// Does the open PR line `<n> <true|false>` say auto-merge is on?
pub fn open_auto(ev: string) -> bool {
    const f : usize = body_from(ev, L_OPEN, 0);
    const t : usize = body_to(ev, L_OPEN, 0);
    const e : usize = digits_end(ev, f, t);
    return e > f and e + 5 <= t and span_is(ev, e, e + 5, " true");
}

/// The number after the last `/pull/` in the output of `gh pr create`, 0 when there is none.
pub fn created_number(ev: string) -> u64 {
    const f : usize = body_from(ev, L_PR, 0);
    const t : usize = body_to(ev, L_PR, 0);
    var n : u64 = 0;
    var at : usize = find_in(ev, f, t, "/pull/");
    while (at < ev.len) {
        const e : usize = digits_end(ev, at + 6, t);
        if (e > at + 6 and e - at - 6 <= 18) { n = digits(ev, at + 6, e); }
        at = find_in(ev, at + 6, t, "/pull/");
    }
    return n;
}

/// The pull request the run works on: the open one, else the one it created; 0 when there is none.
pub fn pr_number(ev: string) -> u64 {
    const o : u64 = lead_number(ev, L_OPEN);
    if (o > 0) { return o; }
    return created_number(ev);
}

/// Does ev[from..to] start with a 40-digit object name that is followed by a blank, a tab, a newline or the end?
pub fn sha_at(ev: string, from: usize, to: usize) -> bool {
    if (from + 40 > to) { return false; }
    var i : usize = from;
    while (i < from + 40) {
        const c : u8 = ev[i];
        if (((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) == false) { return false; }
        i = i + 1;
    }
    return from + 40 == to or ev[from + 40] == 10 or ev[from + 40] == 9 or ev[from + 40] == 32;
}

/// Did the push reach the remote: exit 0, and `git ls-remote` names the object `git rev-parse HEAD` named?
pub fn pushed(ev: string) -> bool {
    const hf : usize = body_from(ev, L_HEAD, 0);
    const rf : usize = body_from(ev, L_REMOTE_HEAD, 0);
    if (exit_of(ev, L_PUSH, 0) != 0 or exit_of(ev, L_HEAD, 0) != 0 or exit_of(ev, L_REMOTE_HEAD, 0) != 0) { return false; }
    if (sha_at(ev, hf, body_to(ev, L_HEAD, 0)) == false or sha_at(ev, rf, body_to(ev, L_REMOTE_HEAD, 0)) == false) { return false; }
    return same(ev, hf, ev, rf, rf + 40);
}

// --- the importers: the specs that use a changed spec ---------------------------------------------------

/// Is ev[from..to] a path `git grep -l` prints for a spec: `specs/`, bytes that need no quoting, then `.t27`?
pub fn importer_line(ev: string, from: usize, to: usize) -> bool {
    if (to < from + 11 or span_is(ev, from, from + 6, "specs/") == false or span_is(ev, to - 4, to, ".t27") == false) { return false; }
    var i : usize = from;
    while (i < to) {
        if (ev[i] <= 32 or ev[i] >= 127 or ev[i] == 34 or ev[i] == 92) { return false; }
        i = i + 1;
    }
    return true;
}

/// Does the importers' output hold nothing but spec paths, one to a line? A stray line (a warning, an error) is not readable.
pub fn importers_read(ev: string) -> bool {
    const t : usize = body_to(ev, L_IMPORTERS, 0);
    var at : usize = body_from(ev, L_IMPORTERS, 0);
    while (at < t) {
        var end : usize = line_end(ev, at);
        if (end > t) { end = t; }
        if (end > at and importer_line(ev, at, end) == false) { return false; }
        at = end + 1;
    }
    return true;
}

/// Does the branch change a spec the per-target steps run on?
pub fn has_target(c: string) -> bool {
    const m : u64 = entries(c);
    var n : u64 = 0;
    while (n < m) {
        if (is_target(c, n)) { return true; }
        n = n + 1;
    }
    return false;
}

/// Is the spec path ev[from..to] one of the changed specs of r?
pub fn is_changed(r: TriLandReq, ev: string, from: usize, to: usize) -> bool {
    const m : u64 = entries(r.changes);
    var n : u64 = 0;
    while (n < m) {
        if (is_target(r.changes, n) and path_end(r.changes, n) - path_start(r.changes, n) == to - from) {
            if (same(ev, from, r.changes, path_start(r.changes, n), path_end(r.changes, n))) { return true; }
        }
        n = n + 1;
    }
    return false;
}

/// Is ev[n] the first byte of a line of the importers' output that this run verifies: a spec that is not under specs/scratch/ and
/// is not itself a changed spec (steps 14 to 16 gated that one)? The offset is the entry of the slots of steps 18 to 20.
pub fn importer_wanted(r: TriLandReq, ev: string, n: u64) -> bool {
    const f : usize = body_from(ev, L_IMPORTERS, 0);
    const t : usize = body_to(ev, L_IMPORTERS, 0);
    if (n < (f as u64) or n >= (t as u64)) { return false; }
    const at : usize = n as usize;
    if (at > f and ev[at - 1] != 10) { return false; }
    var end : usize = line_end(ev, at);
    if (end > t) { end = t; }
    if (importer_line(ev, at, end) == false or (end - at >= 14 and span_is(ev, at, at + 14, "specs/scratch/"))) { return false; }
    return is_changed(r, ev, at, end) == false;
}

/// The entry of the first importer that step k (L_ISEAL, L_ISAVE or L_IRECHECK) has still to run: the offset of its line, ABSENT
/// when there is none.
pub fn next_importer(r: TriLandReq, ev: string, k: u8) -> u64 {
    const t : usize = body_to(ev, L_IMPORTERS, 0);
    var at : usize = body_from(ev, L_IMPORTERS, 0);
    while (at < t) {
        var end : usize = line_end(ev, at);
        if (end > t) { end = t; }
        if (exit_of(ev, k, at as u64) == NO_EXIT and applies(r, ev, k, at as u64)) { return at as u64; }
        at = end + 1;
    }
    return ABSENT;
}

/// The extra specs of a run: the importers it verifies, on one line, a blank apart. The byte count, 0 when there are none.
pub fn importer_names(r: TriLandReq, ev: string, out: []u8) -> usize {
    const t : usize = body_to(ev, L_IMPORTERS, 0);
    var at : usize = body_from(ev, L_IMPORTERS, 0);
    var w : usize = 0;
    while (at < t) {
        var end : usize = line_end(ev, at);
        if (end > t) { end = t; }
        if (importer_wanted(r, ev, at as u64)) {
            if (w > 0) { w = emit_byte(out, w, 32); }
            w = emit_span(out, w, ev, at, end);
        }
        at = end + 1;
    }
    return fits(out, w);
}

// --- the dupe rule: the branch's failing names must be master's --------------------------------------

/// Is text[at..end] a finding of dupe_scan: a line that starts with `::error::` and has a name?
pub fn is_finding(text: string, at: usize, end: usize) -> bool {
    return end >= at + 10 and span_is(text, at, at + 9, "::error::");
}

/// Where the name of the finding at[..end] begins: after `::error::`, and after `a body written under ` when the line has it.
pub fn finding_from(text: string, at: usize, end: usize) -> usize {
    if (end >= at + 31 and span_is(text, at + 9, at + 30, "a body written under ")) { return at + 30; }
    return at + 9;
}

/// Where that name ends: at the first blank, or the end of the line.
pub fn finding_to(text: string, from: usize, end: usize) -> usize {
    var k : usize = from;
    while (k < end and text[k] != 32) { k = k + 1; }
    return k;
}

/// How many findings text[from..to] holds.
pub fn findings(text: string, from: usize, to: usize) -> u64 {
    var n : u64 = 0;
    var at : usize = from;
    while (at < to) {
        var end : usize = line_end(text, at);
        if (end > to) { end = to; }
        if (is_finding(text, at, end)) { n = n + 1; }
        at = end + 1;
    }
    return n;
}

/// Does a finding of ev[f..t] carry the name ev[nf..nt]?
pub fn is_listed(ev: string, f: usize, t: usize, nf: usize, nt: usize) -> bool {
    var at : usize = f;
    while (at < t) {
        var end : usize = line_end(ev, at);
        if (end > t) { end = t; }
        if (is_finding(ev, at, end)) {
            const mf : usize = finding_from(ev, at, end);
            const mt : usize = finding_to(ev, mf, end);
            if (mt - mf == nt - nf and same(ev, nf, ev, mf, mt)) { return true; }
        }
        at = end + 1;
    }
    return false;
}

/// The offset of the name of the first finding of the branch's scan that master's scan does not print; ev.len + 1 when every one
/// is printed there too (the failing set is a subset of master's).
pub fn extra_name(ev: string) -> usize {
    const f : usize = body_from(ev, L_DUPES, 0);
    const t : usize = body_to(ev, L_DUPES, 0);
    var at : usize = f;
    while (at < t) {
        var end : usize = line_end(ev, at);
        if (end > t) { end = t; }
        if (is_finding(ev, at, end)) {
            const nf : usize = finding_from(ev, at, end);
            const nt : usize = finding_to(ev, nf, end);
            if (is_listed(ev, body_from(ev, L_MASTER_DUPES, 0), body_to(ev, L_MASTER_DUPES, 0), nf, nt) == false) { return nf; }
        }
        at = end + 1;
    }
    return ev.len + 1;
}

/// Is the branch's dupe scan a pass: exit 0, or exit 1 with findings that all appear in master's scan?
pub fn dupes_ok(ev: string) -> bool {
    const x : u64 = exit_of(ev, L_DUPES, 0);
    if (x == 0) { return true; }
    if (x != 1 or exit_of(ev, L_MASTER_DUPES, 0) > 1) { return false; }
    if (findings(ev, body_from(ev, L_DUPES, 0), body_to(ev, L_DUPES, 0)) == 0) { return false; }
    return extra_name(ev) > ev.len;
}

// --- the steps: which slot is next ---------------------------------------------------------------

/// Does step k run once per line of CHANGES (a per-target step)?
pub fn per_target(k: u8) -> bool {
    return k >= L_TESTS and k <= L_RECHECK;
}

/// Does step k run once per importer of a changed spec (its entry is the offset of the importer's line in the evidence)?
pub fn per_importer(k: u8) -> bool {
    return k >= L_ISEAL and k <= L_IRECHECK;
}

/// How many slots step k has by number: one per CHANGES line for a per-target step, none for a per-importer step (next_importer
/// finds those in the evidence), else one.
pub fn slot_rows(r: TriLandReq, k: u8) -> u64 {
    if (per_target(k)) { return entries(r.changes); }
    if (per_importer(k)) { return 0; }
    return 1;
}

/// Is slot (k, n) wanted, given the evidence so far? A slot not wanted is skipped, never run.
pub fn applies(r: TriLandReq, ev: string, k: u8, n: u64) -> bool {
    // seals mode keeps the changes, the seal verify/save/recheck of each changed spec, and the same for its importers (#11402)
    if (r.seals and (k < L_CHANGES or k > L_IRECHECK or k == L_TESTS or k == L_T27B)) { return false; }
    if (k == L_TESTS or k == L_T27B or k == L_SEAL) { return is_target(r.changes, n); }
    if (k == L_SAVE) { return is_target(r.changes, n) and exit_of(ev, L_SEAL, n) != NO_EXIT and seal_clean(ev, L_SEAL, n) == false; }
    if (k == L_RECHECK) { return exit_of(ev, L_SAVE, n) != NO_EXIT; }
    if (k == L_IMPORTERS) { return has_target(r.changes); }
    if (k == L_ISEAL) { return importer_wanted(r, ev, n); }
    if (k == L_ISAVE) { return importer_wanted(r, ev, n) and exit_of(ev, L_ISEAL, n) != NO_EXIT and seal_clean(ev, L_ISEAL, n) == false and unsealed(ev, L_ISEAL, n) == false; }
    if (k == L_IRECHECK) { return exit_of(ev, L_ISAVE, n) != NO_EXIT; }
    if (k >= L_STAGE and r.check) { return false; }
    if (k == L_COMMIT) { return exit_of(ev, L_PENDING, 0) == 1; }
    if (k == L_PR) { return lead_number(ev, L_OPEN) == 0; }
    if (k == L_AUTO) { return open_auto(ev) == false; }
    return true;
}

/// The next slot to run: the first one in order that is wanted and has no section yet; DONE when there is none. It never names
/// L_CLEAN, which the glue runs by itself at the end.
pub fn next_slot(r: TriLandReq, ev: string) -> u64 {
    var k : u8 = 0;
    while (k < L_CLEAN) {
        const rows : u64 = slot_rows(r, k);
        var n : u64 = 0;
        while (n < rows) {
            if (applies(r, ev, k, n) and exit_of(ev, k, n) == NO_EXIT) { return (k as u64) * SLOT + n; }
            n = n + 1;
        }
        if (per_importer(k)) {
            const e : u64 = next_importer(r, ev, k);
            if (e != ABSENT) { return (k as u64) * SLOT + e; }
        }
        k = k + 1;
    }
    return DONE;
}

/// Does step k run in the scratch worktree? The steps before it, and the last, run where the caller stands.
pub fn in_scratch(k: u8) -> bool {
    return k >= L_MASTER_DUPES and k < L_CLEAN;
}

/// Where step k runs: the scratch worktree for the gates of a landing, the caller's checkout in seals mode.
pub fn cwd_scratch(r: TriLandReq, k: u8) -> bool {
    return r.seals == false and in_scratch(k);
}

/// Does step k talk to GitHub: a fetch, a gh call, the push, ls-remote?
pub fn over_network(k: u8) -> bool {
    return k == L_FETCH or k == L_MERGED or k == L_FETCH_BRANCH or k == L_OPEN or k == L_PUSH or k == L_REMOTE_HEAD or k == L_PR or k == L_AUTO or k == L_AUTO_CHECK;
}

/// Did step k fail the way a flaky TLS or DNS answer fails, before anything was sent: exit not 0 and a network step that printed
/// `x509`, `TLS handshake timeout` or `Could not resolve host`? The glue runs it again, at most RETRIES more times, 3 seconds apart.
/// Any other failure, a rejected push included, is final.
pub fn transient(k: u8, x: u64, text: string) -> bool {
    if (x == 0 or over_network(k) == false) { return false; }
    return find_in(text, 0, text.len, "x509") < text.len or find_in(text, 0, text.len, "TLS handshake timeout") < text.len or find_in(text, 0, text.len, "Could not resolve host") < text.len;
}

/// The step's name, as the command prints it.
pub fn step_name(k: u8) -> string {
    if (k == L_FETCH) { return "fetch"; }
    if (k == L_MERGED) { return "merged"; }
    if (k == L_TIP) { return "tip"; }
    if (k == L_FETCH_BRANCH) { return "fetch-branch"; }
    if (k == L_CONTAINS) { return "contains"; }
    if (k == L_OPEN) { return "open"; }
    if (k == L_WORKTREE) { return "worktree"; }
    if (k == L_MASTER_DUPES) { return "master-dupes"; }
    if (k == L_CHECKOUT) { return "checkout"; }
    if (k == L_MERGE) { return "merge"; }
    if (k == L_CONFLICTS) { return "conflicts"; }
    if (k == L_CHANGES) { return "changes"; }
    if (k == L_TESTS) { return "tests"; }
    if (k == L_T27B) { return "t27b"; }
    if (k == L_SEAL) { return "seal"; }
    if (k == L_SAVE) { return "seal-save"; }
    if (k == L_RECHECK) { return "seal-recheck"; }
    if (k == L_IMPORTERS) { return "importers"; }
    if (k == L_ISEAL) { return "importer-seal"; }
    if (k == L_ISAVE) { return "importer-save"; }
    if (k == L_IRECHECK) { return "importer-recheck"; }
    if (k == L_TYPES) { return "types"; }
    if (k == L_DUPES) { return "dupes"; }
    if (k == L_STAGE) { return "stage"; }
    if (k == L_PENDING) { return "pending"; }
    if (k == L_TITLE) { return "title"; }
    if (k == L_COMMIT) { return "commit"; }
    if (k == L_HEAD) { return "head"; }
    if (k == L_PUSH) { return "push"; }
    if (k == L_REMOTE_HEAD) { return "remote-head"; }
    if (k == L_PR) { return "pr"; }
    if (k == L_AUTO) { return "auto-merge"; }
    if (k == L_AUTO_CHECK) { return "auto-merge-check"; }
    if (k == L_CLEAN) { return "clean"; }
    return "unknown";
}

// --- the judgement of a step ---------------------------------------------------------------------

/// What the run that slot (k, n) just did means: L_OK to go on, L_ALREADY to stop well, any other code a refusal. The evidence
/// holds that run's section (and every earlier one); the glue has stored the CHANGES output in r.changes.
pub fn judge(r: TriLandReq, ev: string, k: u8, n: u64) -> u8 {
    const x : u64 = exit_of(ev, k, n);
    if (k == L_FETCH or k == L_WORKTREE or k == L_CHECKOUT or k == L_STAGE or k == L_COMMIT) {
        if (x != 0) { return L_STEP; }
        return L_OK;
    }
    if (k == L_MERGED) {
        if (x != 0) { return L_STEP; }
        if (lead_number(ev, L_MERGED) > 0) { return L_ALREADY; }
        return L_OK;
    }
    if (k == L_TIP) {
        if (x != 0 or sha_at(ev, body_from(ev, L_TIP, 0), body_to(ev, L_TIP, 0)) == false) { return L_NO_BRANCH; }
        return L_OK;
    }
    if (k == L_OPEN) {
        if (x != 0) { return L_STEP; }
        if (lead_number(ev, L_OPEN) > 0 and open_auto(ev) and exit_of(ev, L_CONTAINS, 0) == 0) { return L_ALREADY; }
        return L_OK;
    }
    if (k == L_MASTER_DUPES) {
        if (x > 1) { return L_DUPE_NOT_SUBSET; }
        return L_OK;
    }
    if (k == L_CONFLICTS) {
        if (x != 0) { return L_STEP; }
        if (body_from(ev, L_CONFLICTS, 0) < body_to(ev, L_CONFLICTS, 0)) { return L_CONFLICT; }
        if (exit_of(ev, L_MERGE, 0) != 0) { return L_STEP; }
        return L_OK;
    }
    if (k == L_CHANGES) {
        if (x != 0 or (entries(r.changes) == 0 and r.seals == false)) { return L_STEP; }
        var i : u64 = 0;
        while (i < entries(r.changes)) {
            if (is_spec(r.changes, i) and path_safe(r.changes, i) == false) { return L_STEP; }
            i = i + 1;
        }
        return L_OK;
    }
    if (k == L_TESTS) {
        if (tests_clean(ev, n)) { return L_OK; }
        return L_TESTS_NOT_CLEAN;
    }
    if (k == L_T27B) {
        if (t27b_clean(ev, n)) { return L_OK; }
        return L_T27B_NOT_CLEAN;
    }
    if (k == L_RECHECK or k == L_IRECHECK) {
        if (seal_clean(ev, k, n)) { return L_OK; }
        return L_SEAL_NOT_CLEAN;
    }
    if (k == L_IMPORTERS) {
        if (x > 1 or importers_read(ev) == false) { return L_STEP; }
        return L_OK;
    }
    if (k == L_TYPES) {
        if (types_clean(ev)) { return L_OK; }
        return L_TYPES_NOT_CLEAN;
    }
    if (k == L_DUPES) {
        if (dupes_ok(ev)) { return L_OK; }
        return L_DUPE_NOT_SUBSET;
    }
    if (k == L_PENDING) {
        if (x > 1) { return L_STEP; }
        return L_OK;
    }
    if (k == L_TITLE) {
        if (x != 0 or body_from(ev, L_TITLE, 0) >= body_to(ev, L_TITLE, 0)) { return L_STEP; }
        return L_OK;
    }
    if (k == L_HEAD) {
        if (x != 0 or sha_at(ev, body_from(ev, L_HEAD, 0), body_to(ev, L_HEAD, 0)) == false) { return L_STEP; }
        return L_OK;
    }
    if (k == L_PUSH) {
        if (x != 0) { return L_PUSH_NOT_CONFIRMED; }
        return L_OK;
    }
    if (k == L_REMOTE_HEAD) {
        if (pushed(ev)) { return L_OK; }
        return L_PUSH_NOT_CONFIRMED;
    }
    if (k == L_PR) {
        if (x != 0 or created_number(ev) == 0) { return L_STEP; }
        return L_OK;
    }
    if (k == L_AUTO) {
        if (x != 0) { return L_AUTO_NOT_CONFIRMED; }
        return L_OK;
    }
    if (k == L_AUTO_CHECK) {
        if (x == 0 and has_line(ev, body_from(ev, L_AUTO_CHECK, 0), body_to(ev, L_AUTO_CHECK, 0), "true")) { return L_OK; }
        return L_AUTO_NOT_CONFIRMED;
    }
    return L_OK;
}

/// The code the command exits with: 0 for a run that ended well, the code itself for a refusal.
pub fn exit_code(c: u8) -> u8 {
    if (c <= L_CHECKED) { return 0; }
    return c;
}

/// The code's name, as the command prints it.
pub fn code_name(c: u8) -> string {
    if (c == L_OK) { return "OK"; }
    if (c == L_ALREADY) { return "ALREADY_LANDED"; }
    if (c == L_LANDED) { return "LANDED"; }
    if (c == L_CHECKED) { return "CHECKED"; }
    if (c == L_BAD_BRANCH) { return "BAD_BRANCH"; }
    if (c == L_BAD_ISSUE) { return "BAD_ISSUE"; }
    if (c == L_BAD_PATH) { return "BAD_PATH"; }
    if (c == L_STEP) { return "STEP_FAILED"; }
    if (c == L_NO_BRANCH) { return "NO_BRANCH"; }
    if (c == L_CONFLICT) { return "CONFLICT"; }
    if (c == L_TESTS_NOT_CLEAN) { return "TESTS_NOT_CLEAN"; }
    if (c == L_SEAL_NOT_CLEAN) { return "SEAL_NOT_CLEAN"; }
    if (c == L_TYPES_NOT_CLEAN) { return "TYPES_NOT_CLEAN"; }
    if (c == L_DUPE_NOT_SUBSET) { return "DUPE_NOT_SUBSET"; }
    if (c == L_PUSH_NOT_CONFIRMED) { return "PUSH_NOT_CONFIRMED"; }
    if (c == L_AUTO_NOT_CONFIRMED) { return "AUTO_NOT_CONFIRMED"; }
    if (c == L_T27B_NOT_CLEAN) { return "T27B_NOT_CLEAN"; }
    return "UNKNOWN";
}

/// What the code means, in words.
pub fn code_why(c: u8) -> string {
    if (c == L_OK) { return "nothing is refused"; }
    if (c == L_ALREADY) { return "the branch is landed: nothing was changed"; }
    if (c == L_LANDED) { return "master merged, gates passed, head pushed, pull request open with auto-merge on; git pull --ff-only brings the merge and seal commit into your checkout"; }
    if (c == L_CHECKED) { return "master merged and every gate passed on the merged tree; nothing was committed, pushed or opened"; }
    if (c == L_BAD_BRANCH) { return "the branch has a byte outside letters, digits and _-./, starts or ends with a slash, a dash or a dot, has .. or .lock, or is master, main or HEAD"; }
    if (c == L_BAD_ISSUE) { return "--issue is a number from 1 to 999999999"; }
    if (c == L_BAD_PATH) { return "the scratch directory, T27C or this program has a byte outside letters, digits and _-./, or starts with -"; }
    if (c == L_STEP) { return "a step failed or printed nothing it should: nothing after it ran"; }
    if (c == L_NO_BRANCH) { return "this repository has no local branch of that name: git branch <name> origin/<name> first"; }
    if (c == L_CONFLICT) { return "the branch conflicts with master in the files named: resolve them on the branch, nothing was pushed"; }
    if (c == L_TESTS_NOT_CLEAN) { return "a spec has a failing test, a vacuous pass, or no readable totals: it was not sealed"; }
    if (c == L_SEAL_NOT_CLEAN) { return "the seal of a changed spec, or of a spec that imports one, does not match even after t27c seal --save"; }
    if (c == L_TYPES_NOT_CLEAN) { return "tri types ratchet is not CLEAN"; }
    if (c == L_DUPE_NOT_SUBSET) { return "dupe_scan fails on a name master does not fail on (or it could not be read): reuse the body that exists"; }
    if (c == L_PUSH_NOT_CONFIRMED) { return "origin does not hold the head that was pushed (never forced: pull the branch first if it has moved)"; }
    if (c == L_AUTO_NOT_CONFIRMED) { return "the pull request is open but auto-merge is not confirmed on"; }
    if (c == L_T27B_NOT_CLEAN) { return "t27b test --check printed MISMATCH (the JIT and the reference interpreter disagree) or exited non-zero for a spec, or t27b could not be started (it is looked for beside t27c): it was not sealed"; }
    return "unknown outcome";
}

// --- writing the commands ------------------------------------------------------------------------

/// Write the bytes of text[from..to].
pub fn emit_span(out: []u8, w: usize, text: string, from: usize, to: usize) -> usize {
    var p : usize = w;
    var i : usize = from;
    while (i < to and i < text.len) {
        p = emit_byte(out, p, text[i]);
        i = i + 1;
    }
    return p;
}

/// Write the issue number, or `<issue>` for a plan that has none.
pub fn emit_issue(out: []u8, w: usize, issue: u64) -> usize {
    if (issue == 0) { return emit_str(out, w, "<issue>"); }
    return emit_dec(out, w, issue);
}

/// Write the pull request number, or `<pr>` while there is none.
pub fn emit_pr(out: []u8, w: usize, ev: string) -> usize {
    const n : u64 = pr_number(ev);
    if (n == 0) { return emit_str(out, w, "<pr>"); }
    return emit_dec(out, w, n);
}

/// Write the spec path of CHANGES line n, or `<spec>` when it is not a target.
pub fn emit_spec(out: []u8, w: usize, r: TriLandReq, n: u64) -> usize {
    if (is_target(r.changes, n) == false) { return emit_str(out, w, "<spec>"); }
    return emit_span(out, w, r.changes, path_start(r.changes, n), path_end(r.changes, n));
}

/// Does ev[from..to] say `Closes #<n>`?
pub fn has_closes(ev: string, from: usize, to: usize, n: u64) -> bool {
    var at : usize = find_in(ev, from, to, "Closes #");
    while (at < ev.len) {
        const e : usize = digits_end(ev, at + 8, to);
        if (e > at + 8 and e - at - 8 <= 18 and digits(ev, at + 8, e) == n) { return true; }
        at = find_in(ev, at + 8, to, "Closes #");
    }
    return false;
}

/// Where the first line of the title step's output ends.
pub fn title_to(ev: string) -> usize {
    const e : usize = line_end(ev, body_from(ev, L_TITLE, 0));
    if (e < body_to(ev, L_TITLE, 0)) { return e; }
    return body_to(ev, L_TITLE, 0);
}

/// The title of the commit and of the pull request: the lane's own last subject, and ` (Closes #N)` after it when it has no
/// `Closes #N`; `<title>` while the subject is not known.
pub fn emit_title(out: []u8, w: usize, ev: string, issue: u64) -> usize {
    const f : usize = body_from(ev, L_TITLE, 0);
    const t : usize = title_to(ev);
    var p : usize = w;
    if (f >= t) { p = emit_str(out, p, "<title>"); } else { p = emit_span(out, p, ev, f, t); }
    if (has_closes(ev, f, t, issue)) { return p; }
    p = emit_str(out, p, " (Closes #");
    p = emit_issue(out, p, issue);
    return emit_byte(out, p, 41);
}

pub const COMMIT_BODY : str = "Merge of master and the seals, by tri land (specs/tri/land/land.t27): the gates ran on the merged tree.";
pub const PR_BODY : str = ". Opened by tri land (specs/tri/land/land.t27): master merged, then on the merged tree every changed spec has its tests clean with vacuous passes 0 and its seal MATCH, tri types ratchet is CLEAN and the dupe_scan failure set is a subset of master's.";

/// `gh pr list --repo R --head B --state <state> --json <json> --jq <jq>`, one argument to a line.
pub fn emit_list(out: []u8, w: usize, branch: string, state: string, json: string, jq: string) -> usize {
    var p : usize = emit_str(out, w, "gh\npr\nlist\n--repo\n");
    p = emit_str(out, p, REPO);
    p = emit_str(out, p, "\n--head\n");
    p = emit_str(out, p, branch);
    p = emit_str(out, p, "\n--state\n");
    p = emit_str(out, p, state);
    p = emit_str(out, p, "\n--json\n");
    p = emit_str(out, p, json);
    p = emit_str(out, p, "\n--jq\n");
    p = emit_str(out, p, jq);
    return emit_byte(out, p, 10);
}

/// `<program> <verb> <spec> <flags...>`: the t27c lines of a per-target step.
pub fn emit_t27c(out: []u8, w: usize, r: TriLandReq, n: u64, tail: string) -> usize {
    var p : usize = emit_str(out, w, r.t27c);
    p = emit_byte(out, p, 10);
    p = emit_str(out, p, tail);
    return emit_spec(out, p, r, n);
}

/// The t27b program: the file named t27b in the directory of T27C (`/x/t27c` gives `/x/t27b`), the bare name t27b when T27C does
/// not end in t27c.
pub fn emit_t27b(out: []u8, w: usize, r: TriLandReq) -> usize {
    const n : usize = r.t27c.len;
    var p : usize = w;
    if (n >= 4 and span_is(r.t27c, n - 4, n, "t27c")) { p = emit_span(out, p, r.t27c, 0, n - 4); }
    return emit_str(out, p, "t27b");
}

/// Write the module of the changed spec on CHANGES line n: its path without `specs/` and `.t27`, each `/` written `::`.
pub fn emit_module(out: []u8, w: usize, c: string, n: u64) -> usize {
    var p : usize = w;
    var i : usize = path_start(c, n) + 6;
    const e : usize = path_end(c, n) - 4;
    while (i < e) {
        if (c[i] == 47) { p = emit_str(out, p, "::"); } else { p = emit_byte(out, p, c[i]); }
        i = i + 1;
    }
    return p;
}

/// One `-e` and `use <module>::` for each changed spec the run gates, `use <module>::` itself while there is none (a plan).
pub fn emit_uses(out: []u8, w: usize, r: TriLandReq) -> usize {
    const m : u64 = entries(r.changes);
    var p : usize = w;
    var n : u64 = 0;
    while (n < m) {
        if (is_target(r.changes, n)) {
            p = emit_str(out, p, "-e\nuse ");
            p = emit_module(out, p, r.changes, n);
            p = emit_str(out, p, "::\n");
        }
        n = n + 1;
    }
    if (has_target(r.changes) == false) { p = emit_str(out, p, "-e\nuse <module>::\n"); }
    return p;
}

/// Write the spec path of the importer whose line starts at offset n of the evidence, `<importer>` when no importer the run
/// verifies starts there.
pub fn emit_importer(out: []u8, w: usize, r: TriLandReq, ev: string, n: u64) -> usize {
    if (importer_wanted(r, ev, n) == false) { return emit_str(out, w, "<importer>"); }
    return emit_span(out, w, ev, n as usize, line_end(ev, n as usize));
}

/// The argument vector of slot (k, n), one argument to a line, each ended by a newline; the byte count. 0 means there is nothing
/// to run: the request is refused, the step is not one, or the room is short. Evidence the step reads and does not have yet is
/// written as `<spec>`, `<title>`, `<pr>` or `<issue>`, so the same function prints the plan.
pub fn step_argv(r: TriLandReq, ev: string, k: u8, n: u64, out: []u8) -> usize {
    if (request_refusal(r) != L_OK) { return 0; }
    var w : usize = 0;
    if (k == L_FETCH) { w = emit_str(out, w, "git\nfetch\n-q\norigin\nmaster\n"); }
    if (k == L_MERGED) { w = emit_list(out, w, r.branch, "merged", "number", ".[] | .number"); }
    if (k == L_TIP) {
        w = emit_str(out, w, "git\nrev-parse\n--verify\n-q\nrefs/heads/");
        w = emit_str(out, w, r.branch);
        w = emit_byte(out, w, 10);
    }
    if (k == L_FETCH_BRANCH) {
        w = emit_str(out, w, "git\nfetch\n-q\norigin\n");
        w = emit_str(out, w, r.branch);
        w = emit_byte(out, w, 10);
    }
    if (k == L_CONTAINS) {
        w = emit_str(out, w, "git\nmerge-base\n--is-ancestor\nrefs/heads/");
        w = emit_str(out, w, r.branch);
        w = emit_str(out, w, "\nrefs/remotes/origin/");
        w = emit_str(out, w, r.branch);
        w = emit_byte(out, w, 10);
    }
    if (k == L_OPEN) { w = emit_list(out, w, r.branch, "open", "number,autoMergeRequest", ".[] | \"\\(.number) \\(.autoMergeRequest != null)\""); }
    if (k == L_WORKTREE) {
        w = emit_str(out, w, "git\nworktree\nadd\n-q\n--detach\n");
        w = emit_str(out, w, r.scratch);
        w = emit_str(out, w, "\norigin/master\n");
    }
    if (k == L_MASTER_DUPES or k == L_DUPES) { w = emit_str(out, w, "python3\ntools/dupe_scan.py\n"); }
    if (k == L_CHECKOUT) {
        w = emit_str(out, w, "git\ncheckout\n-q\n--detach\nrefs/heads/");
        w = emit_str(out, w, r.branch);
        w = emit_byte(out, w, 10);
    }
    if (k == L_MERGE) { w = emit_str(out, w, "git\nmerge\n--no-commit\n--no-ff\norigin/master\n"); }
    if (k == L_CONFLICTS) { w = emit_str(out, w, "git\ndiff\n--name-only\n--diff-filter=U\n"); }
    if (k == L_CHANGES and r.seals) { w = emit_str(out, w, "git\ndiff\n--name-status\n--no-renames\n--merge-base\norigin/master\n"); }
    if (k == L_CHANGES and r.seals == false) { w = emit_str(out, w, "git\ndiff\n--cached\n--name-status\n--no-renames\norigin/master\n"); }
    if (k == L_TESTS) {
        w = emit_t27c(out, w, r, n, "test-report\n");
        w = emit_str(out, w, "\n--specs-dir\nspecs\n");
    }
    if (k == L_T27B) {
        w = emit_t27b(out, w, r);
        w = emit_str(out, w, "\ntest\n");
        w = emit_spec(out, w, r, n);
        w = emit_str(out, w, "\n--check\n--quiet\n");
    }
    if (k == L_SEAL or k == L_RECHECK) {
        w = emit_t27c(out, w, r, n, "seal\n");
        w = emit_str(out, w, "\n--verify\n");
    }
    if (k == L_SAVE) {
        w = emit_t27c(out, w, r, n, "seal\n");
        w = emit_str(out, w, "\n--save\n");
    }
    if (k == L_IMPORTERS) {
        w = emit_str(out, w, "git\ngrep\n-l\n-F\n");
        w = emit_uses(out, w, r);
        w = emit_str(out, w, "--\nspecs\n");
    }
    if (k == L_ISEAL or k == L_ISAVE or k == L_IRECHECK) {
        w = emit_str(out, w, r.t27c);
        w = emit_str(out, w, "\nseal\n");
        w = emit_importer(out, w, r, ev, n);
        if (k == L_ISAVE) { w = emit_str(out, w, "\n--save\n"); } else { w = emit_str(out, w, "\n--verify\n"); }
    }
    if (k == L_TYPES) {
        w = emit_str(out, w, r.tri);
        w = emit_str(out, w, "\ntypes\nratchet\n");
    }
    if (k == L_STAGE) { w = emit_str(out, w, "git\nadd\n.trinity/seals\n"); }
    if (k == L_PENDING) { w = emit_str(out, w, "git\ndiff\n--cached\n--quiet\n"); }
    if (k == L_TITLE) { w = emit_str(out, w, "git\nlog\n-1\n--no-merges\n--format=%s\n"); }
    if (k == L_COMMIT) {
        w = emit_str(out, w, "git\n-c\ncore.hooksPath=.githooks\ncommit\n-q\n-m\n");
        w = emit_title(out, w, ev, r.issue);
        w = emit_str(out, w, "\n-m\n");
        w = emit_str(out, w, COMMIT_BODY);
        w = emit_byte(out, w, 10);
    }
    if (k == L_HEAD) { w = emit_str(out, w, "git\nrev-parse\nHEAD\n"); }
    if (k == L_PUSH) {
        w = emit_str(out, w, "git\npush\norigin\nHEAD:refs/heads/");
        w = emit_str(out, w, r.branch);
        w = emit_byte(out, w, 10);
    }
    if (k == L_REMOTE_HEAD) {
        w = emit_str(out, w, "git\nls-remote\norigin\nrefs/heads/");
        w = emit_str(out, w, r.branch);
        w = emit_byte(out, w, 10);
    }
    if (k == L_PR) {
        w = emit_str(out, w, "gh\npr\ncreate\n--repo\n");
        w = emit_str(out, w, REPO);
        w = emit_str(out, w, "\n--base\nmaster\n--head\n");
        w = emit_str(out, w, r.branch);
        w = emit_str(out, w, "\n--title=");
        w = emit_title(out, w, ev, r.issue);
        w = emit_str(out, w, "\n--body=Closes #");
        w = emit_issue(out, w, r.issue);
        w = emit_str(out, w, PR_BODY);
        w = emit_byte(out, w, 10);
    }
    if (k == L_AUTO) {
        w = emit_str(out, w, "gh\npr\nmerge\n");
        w = emit_pr(out, w, ev);
        w = emit_str(out, w, "\n--repo\n");
        w = emit_str(out, w, REPO);
        w = emit_str(out, w, "\n--auto\n--squash\n");
    }
    if (k == L_AUTO_CHECK) {
        w = emit_str(out, w, "gh\npr\nview\n");
        w = emit_pr(out, w, ev);
        w = emit_str(out, w, "\n--repo\n");
        w = emit_str(out, w, REPO);
        w = emit_str(out, w, "\n--json\nautoMergeRequest\n--jq\n.autoMergeRequest != null\n");
    }
    if (k == L_CLEAN) {
        if (ev.len > 0 and exit_of(ev, L_WORKTREE, 0) != 0) { return 0; }
        w = emit_str(out, w, "git\nworktree\nremove\n--force\n");
        w = emit_str(out, w, r.scratch);
        w = emit_byte(out, w, 10);
    }
    return fits(out, w);
}

/// One run as evidence: `@@ preflight <step> <entry> <exit> <length>\n`, the output, `\n`. The byte count.
pub fn emit_section(out: []u8, w: usize, k: u8, n: u64, x: u64, body: string) -> usize {
    var p : usize = emit_str(out, w, "@@ preflight ");
    p = emit_dec(out, p, k as u64);
    p = emit_byte(out, p, 32);
    p = emit_dec(out, p, n);
    p = emit_byte(out, p, 32);
    p = emit_dec(out, p, x);
    p = emit_byte(out, p, 32);
    p = emit_dec(out, p, body.len as u64);
    p = emit_byte(out, p, 10);
    p = emit_str(out, p, body);
    return emit_byte(out, p, 10);
}

/// What the command prints after a refusal's name: the files of a conflict, the spec of a gate that failed on one, the first
/// name dupe_scan fails on that master does not, else the step's name. The byte count.
pub fn refusal_detail(r: TriLandReq, ev: string, k: u8, n: u64, out: []u8) -> usize {
    var w : usize = 0;
    if (k == L_CONFLICTS) {
        var i : usize = body_from(ev, L_CONFLICTS, 0);
        const t : usize = body_to(ev, L_CONFLICTS, 0);
        while (i < t) {
            if (ev[i] == 10) {
                if (i + 1 < t) { w = emit_byte(out, w, 32); }
            } else {
                w = emit_byte(out, w, ev[i]);
            }
            i = i + 1;
        }
        return fits(out, w);
    }
    if (k == L_TESTS or k == L_T27B or k == L_RECHECK) {
        w = emit_span(out, w, r.changes, path_start(r.changes, n), path_end(r.changes, n));
        return fits(out, w);
    }
    if (k == L_IRECHECK) {
        w = emit_importer(out, w, r, ev, n);
        return fits(out, w);
    }
    const nf : usize = extra_name(ev);
    if (k == L_DUPES and nf < ev.len) {
        w = emit_span(out, w, ev, nf, finding_to(ev, nf, line_end(ev, nf)));
        return fits(out, w);
    }
    w = emit_str(out, w, step_name(k));
    return fits(out, w);
}

