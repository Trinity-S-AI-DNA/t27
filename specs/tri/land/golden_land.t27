// SPDX-License-Identifier: Apache-2.0
; specs/tri/land/golden_land.t27 -- `tri golden land | push | status`: the front door of the golden chain (#11275)
; Owner, 2026-10-20: remove the GitHub traffic jams; agents build with OUR git, and GitHub receives one batch per window.
; The law is specs/queen/golden_chain.t27 (links, golden head by compare-and-swap, CARRY, section 6 landing rule). This file has
; NO rule of its own about what lands or when it is pushed: it calls gc_land, when_to_push and the GC_* constants, and adds only
; what no one had: the order of the git commands, the readers of their output, and the words the command prints. `tri land`
; (specs/tri/land/land.t27) stays the GitHub leg for ONE branch; `tri golden push` runs it once, on a branch at the golden head.
; -
; THE HOST (cli/tri/src/main.rs, cmd_golden) is glue: it asks next_slot which step runs next, runs step_argv in step_cwd as an
; argument vector with no shell, appends the run to the evidence (the @@ preflight format of preflight.t27), asks judge, and at the
; end prints report. Same shape as `tri land`.
; -
; THE VERBS
;   land   [--plan]  read the queue, verify each link locally, land the ready ones on refs/golden/head by compare-and-swap.
;   push   [--plan] [--queued N] [--issue N]  when_to_push over the unpushed golden links; when due, `tri land` on a branch at
;                    the batch's last link (one pull request, auto-merge), then refs/golden/pushed moves to it.
;   status [--queued N]  head, queue, unpushed links, minutes since the last push, when the next push is due.
; THE QUEUE is the local branches named claude/evolve-* and the lines of .trinity/golden/queue (one branch per line, # comments).
; A LINK is one queued branch. Its five stage verdicts (golden_chain.t27 GC_SPEC..GC_RECEIPT), judged here from git's own output:
;   SPEC     the diff against the merge-base reads: 1 to GL_E_MAX paths, all of safe bytes.
;   GEN      a change under gen/ comes with a change to a spec (L2: gen/ is generated, never alone).
;   SEAL     `t27c seal <spec> --verify` in a worktree of the tip, for every spec the link adds or modifies: all hashes MATCH.
;   TEST     `t27b test <spec>` in the same worktree: exit 0, no failure, not a vacuous 0 passed.
;   RECEIPT  a commit message of the link carries `Closes #N` (L1).
; A link with no spec has nothing to seal or test: those two stages are REUSED (the verdict of nothing to judge).
; THE LANDING. gc_land says FORWARD, CARRIED, REGEN or a refusal per link. A link whose parent is the head lands as its own tip;
; a carried one is a new commit on the head with the tree of `git merge-tree --write-tree` (no worktree touched). Every landing
; is `git update-ref refs/golden/head <new> <old>`: git refuses when the head is not <old>, which is the compare-and-swap, and the
; command stops with HEAD_MOVED. With --plan the read-only steps run (merge-tree and commit-tree only add unreferenced objects)
; and every update-ref is printed, none run: the head is written by no plan.
; THE HONEST LIMITS. (1) Edits are whole files (no hunk regions): two links that edit one source file conflict. (2) Importers of a
; changed spec are not re-judged here: no import rows go to gc_land. (3) No verdict-reuse key is read: a stage is PASS or FAIL or
; the nothing-to-judge REUSED. (4) The queue is capped at GL_Q_MAX links per pass. (5) A conflict found by merge-tree stops the
; pass after the links that already landed; they stay landed (each landing was its own compare-and-swap).
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriGoldenLand;

use queen::golden_chain::gc_land;
use queen::golden_chain::when_to_push;
use queen::golden_chain::gc_golden;
use queen::golden_chain::GC_V_NONE;
use queen::golden_chain::GC_V_PASS;
use queen::golden_chain::GC_V_REUSED;
use queen::golden_chain::GC_V_FAIL;
use queen::golden_chain::GC_OUT_FORWARD;
use queen::golden_chain::GC_OUT_CARRIED;
use queen::golden_chain::GC_OUT_REGEN;
use queen::golden_chain::GC_OUT_REJUDGE;
use queen::golden_chain::GC_OUT_CONFLICT;
use queen::golden_chain::GC_OUT_NOT_GOLDEN;
use queen::golden_chain::GC_OUT_UNKNOWN_PARENT;
use queen::golden_chain::GC_EDIT_DERIVED;
use queen::golden_chain::GC_BATCH_MAX;
use queen::golden_chain::GC_WINDOW_MIN;
use queen::golden_chain::GC_CI_JAM;
use queen::golden_chain::GC_PUSH_NOTHING;
use queen::golden_chain::GC_PUSH_WAIT;
use queen::golden_chain::GC_PUSH_NOW;
use queen::golden_chain::GC_REF;
use queen::actors::EDIT_WHOLE;
use tri::lab::receipt::line_end;
use tri::lab::receipt::span_is;
use tri::lanes::lanes::digits;
use tri::pr::preflight::NO_EXIT;
use tri::pr::preflight::exit_of;
use tri::pr::preflight::body_from;
use tri::pr::preflight::body_to;
use tri::pr::preflight::find_in;
use tri::remote::remote_job::emit_byte;
use tri::remote::remote_job::emit_str;
use tri::remote::remote_job::emit_dec;
use tri::remote::remote_job::fits;
use tri::remote::remote_job::safe_path;
use tri::remote::remote_job::buf_is;
use tri::land::land::emit_section;

pub const GL_Q_MAX : usize = 16;
pub const GL_E_MAX : usize = 32;
pub const CMD_MAX : usize = 4096;
pub const SLOT : u64 = 100000;
pub const DONE : u64 = 99999999999;
pub const ABSENT : u64 = 1000000000000000000;
// A slot of a per-link step is link * TGT + line of the link's diff.
pub const TGT : u64 = 1000;
pub const GL_PUSHED : str = "refs/golden/pushed";
pub const GL_QUEUE_FILE : str = ".trinity/golden/queue";

// The steps. 0-3 once per run, 4-11 per link, 12-14 per landed link, 15-19 read the push state, 20-22 the push, 23 the host's.
pub const G_REFS : u8 = 0;
pub const G_FILE : u8 = 1;
pub const G_HEAD : u8 = 2;
pub const G_BASE : u8 = 3;
pub const G_TIP : u8 = 4;
pub const G_MB : u8 = 5;
pub const G_CHG : u8 = 6;
pub const G_LOG : u8 = 7;
pub const G_WT : u8 = 8;
pub const G_SEAL : u8 = 9;
pub const G_TEST : u8 = 10;
pub const G_RM : u8 = 11;
pub const G_MT : u8 = 12;
pub const G_CT : u8 = 13;
pub const G_CAS : u8 = 14;
pub const P_PUSHED : u8 = 15;
pub const P_AHEAD : u8 = 16;
pub const P_STAMP : u8 = 17;
pub const P_NOW : u8 = 18;
pub const P_QUEUED : u8 = 19;
pub const P_BRANCH : u8 = 20;
pub const P_LAND : u8 = 21;
pub const P_MARK : u8 = 22;
pub const G_PRUNE : u8 = 23;
pub const GL_STEPS : u8 = 24;

pub const V_LAND : u8 = 0;
pub const V_PUSH : u8 = 1;
pub const V_STATUS : u8 = 2;
pub const V_BAD : u8 = 3;

// What the command ends with.
pub const C_OK : u8 = 0;
pub const C_BAD_VERB : u8 = 1;
pub const C_BAD_ISSUE : u8 = 2;
pub const C_BAD_PATH : u8 = 3;
pub const C_NO_BASE : u8 = 4;
pub const C_MERGE : u8 = 5;
pub const C_STEP : u8 = 6;
pub const C_HEAD_MOVED : u8 = 7;
pub const C_LAND_REFUSED : u8 = 8;
pub const C_ODDS : u8 = 9;

pub struct GolReq {
    verb: u8,
    plan: bool,
    queued: u64,
    issue: u64,
    scratch: string,
    t27b: string,
    t27c: string,
    tri: string,
}

invariant the_steps_are_numbered_in_the_order_they_run {
    assert G_REFS < G_FILE and G_FILE < G_HEAD and G_HEAD < G_BASE and G_BASE < G_TIP and G_TIP < G_MB and G_MB < G_CHG;
    assert G_CHG < G_LOG and G_LOG < G_WT and G_WT < G_SEAL and G_SEAL < G_TEST and G_TEST < G_RM and G_RM < G_MT;
    assert G_MT < G_CT and G_CT < G_CAS and G_CAS < P_PUSHED and P_PUSHED < P_AHEAD and P_AHEAD < P_STAMP;
    assert P_STAMP < P_NOW and P_NOW < P_QUEUED and P_QUEUED < P_BRANCH and P_BRANCH < P_LAND and P_LAND < P_MARK;
    assert P_MARK + 1 == G_PRUNE and G_PRUNE + 1 == GL_STEPS;
    assert (GL_Q_MAX as u64) * TGT < SLOT;
}

// --- the request ---------------------------------------------------------------------------------

pub fn verb_of(a: string) -> u8 {
    if (span_is(a, 0, a.len, "land")) { return V_LAND; }
    if (span_is(a, 0, a.len, "push")) { return V_PUSH; }
    if (span_is(a, 0, a.len, "status")) { return V_STATUS; }
    return V_BAD;
}

/// Why a request may not run (C_OK says it may). A push that is not a plan opens a pull request, so it needs its issue (L1).
pub fn request_refusal(r: GolReq) -> u8 {
    if (r.verb >= V_BAD) { return C_BAD_VERB; }
    if (r.verb == V_PUSH and r.plan == false and (r.issue == 0 or r.issue > 999999999)) { return C_BAD_ISSUE; }
    if (safe_path(r.scratch) == false or safe_path(r.t27b) == false or safe_path(r.t27c) == false or safe_path(r.tri) == false) { return C_BAD_PATH; }
    return C_OK;
}

// --- reading the evidence ------------------------------------------------------------------------

pub fn ran(ev: string, k: u8, n: u64) -> bool {
    return exit_of(ev, k, n) != NO_EXIT;
}

pub fn is_hex(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 97 and b <= 102);
}

/// Did step k, entry n, exit 0 and print a 40-digit object name first?
pub fn sha_ok(ev: string, k: u8, n: u64) -> bool {
    if (exit_of(ev, k, n) != 0) { return false; }
    const f : usize = body_from(ev, k, n);
    if (body_to(ev, k, n) < f + 40) { return false; }
    var i : usize = 0;
    while (i < 40) {
        if (is_hex(ev[f + i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// The first 15 hex digits at ev[f..] as a number: the link's id for golden_chain.t27 (it only compares ids).
pub fn hex15(ev: string, f: usize) -> u64 {
    var v : u64 = 0;
    var i : usize = 0;
    while (i < 15) {
        var c : u8 = ev[f + i];
        var d : u64 = (c as u64) - 48;
        if (c >= 97) { d = (c as u64) - 87; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

pub fn id_of(ev: string, k: u8, n: u64) -> u64 {
    if (sha_ok(ev, k, n) == false) { return 0; }
    return hex15(ev, body_from(ev, k, n));
}

pub fn has_head(ev: string) -> bool {
    return sha_ok(ev, G_HEAD, 0);
}

/// Where the sha of the commit new links are judged against begins: the golden head, else master of origin.
pub fn cur0(ev: string) -> usize {
    if (has_head(ev)) { return body_from(ev, G_HEAD, 0); }
    return body_from(ev, G_BASE, 0);
}

pub fn starts(t: string, a: usize, b: usize, lit: string) -> bool {
    return b >= a + lit.len and span_is(t, a, a + lit.len, lit);
}

pub fn ends(t: string, a: usize, b: usize, lit: string) -> bool {
    return b >= a + lit.len and span_is(t, b - lit.len, b, lit);
}

// ---- the queue: refs first, then the file; a name is safe bytes, not a trunk, not twice ----------

pub fn name_byte(b: u8) -> bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 46 or b == 95 or b == 47 or b == 45;
}

pub fn name_ok(t: string, a: usize, b: usize) -> bool {
    if (b <= a or b - a > 100) { return false; }
    if (t[a] == 45 or t[a] == 46) { return false; }
    if (span_is(t, a, b, "master") or span_is(t, a, b, "main") or span_is(t, a, b, "HEAD")) { return false; }
    var k : usize = a;
    while (k < b) {
        if (name_byte(t[k]) == false) { return false; }
        if (k + 1 < b and t[k] == 46 and t[k + 1] == 46) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is the line ev[a..b] one of the lines of the body ev[f..t]?
pub fn line_in(ev: string, a: usize, b: usize, f: usize, t: usize) -> bool {
    var p : usize = f;
    while (p < t) {
        const e : usize = line_end(ev, p);
        if (e - p == b - a and span_is(ev, p, e, "") == false) {
            var k : usize = 0;
            while (k < b - a and ev[p + k] == ev[a + k]) { k = k + 1; }
            if (k == b - a) { return true; }
        }
        p = e + 1;
    }
    return false;
}

/// Where queue entry i begins in the evidence; ev.len when there is none.
pub fn q_start(ev: string, i: usize) -> usize {
    var c : usize = 0;
    var p : usize = body_from(ev, G_REFS, 0);
    const t : usize = body_to(ev, G_REFS, 0);
    while (p < t) {
        const e : usize = line_end(ev, p);
        if (name_ok(ev, p, e)) {
            if (c == i) { return p; }
            c = c + 1;
        }
        p = e + 1;
    }
    if (exit_of(ev, G_FILE, 0) != 0) { return ev.len; }
    p = body_from(ev, G_FILE, 0);
    const ft : usize = body_to(ev, G_FILE, 0);
    while (p < ft) {
        const e : usize = line_end(ev, p);
        if (name_ok(ev, p, e) and line_in(ev, p, e, body_from(ev, G_REFS, 0), t) == false) {
            if (c == i) { return p; }
            c = c + 1;
        }
        p = e + 1;
    }
    return ev.len;
}

pub fn q_count(ev: string) -> usize {
    var c : usize = 0;
    while (c < GL_Q_MAX and q_start(ev, c) < ev.len) { c = c + 1; }
    return c;
}

// ---- one link's diff: lines `S<TAB>path` ---------------------------------------------------------

pub fn ch_line(ev: string, n: u64, i: usize) -> usize {
    var p : usize = body_from(ev, G_CHG, n);
    const t : usize = body_to(ev, G_CHG, n);
    var c : usize = 0;
    while (p < t) {
        if (c == i) { return p; }
        p = line_end(ev, p) + 1;
        c = c + 1;
    }
    return ev.len;
}

pub fn ch_count(ev: string, n: u64) -> usize {
    var c : usize = 0;
    while (ch_line(ev, n, c) < ev.len) { c = c + 1; }
    return c;
}

pub fn path_ok(ev: string, ls: usize) -> bool {
    const e : usize = line_end(ev, ls);
    if (e < ls + 3 or ev[ls + 1] != 9) { return false; }
    if (ev[ls + 2] == 45) { return false; }
    var k : usize = ls + 2;
    while (k < e) {
        if (name_byte(ev[k]) == false and ev[k] != 43) { return false; }
        if (k + 1 < e and ev[k] == 46 and ev[k + 1] == 46) { return false; }
        k = k + 1;
    }
    return true;
}

/// A spec the link adds or modifies: a .t27 under specs/, scratch aside, of safe bytes.
pub fn is_target(ev: string, ls: usize) -> bool {
    if (ls >= ev.len) { return false; }
    const e : usize = line_end(ev, ls);
    if (ev[ls] != 65 and ev[ls] != 77) { return false; }
    return path_ok(ev, ls) and starts(ev, ls + 2, e, "specs/") and ends(ev, ls + 2, e, ".t27") and starts(ev, ls + 2, e, "specs/scratch/") == false;
}

pub fn is_derived(ev: string, ls: usize) -> bool {
    const e : usize = line_end(ev, ls);
    return starts(ev, ls + 2, e, "gen/") or starts(ev, ls + 2, e, ".trinity/seals/");
}

pub fn targets(ev: string, n: u64) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    const m : usize = ch_count(ev, n);
    while (i < m) {
        if (is_target(ev, ch_line(ev, n, i))) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// ---- the stage verdicts of link n ----------------------------------------------------------------

pub fn spec_ok(ev: string, n: u64) -> bool {
    if (sha_ok(ev, G_TIP, n) == false or sha_ok(ev, G_MB, n) == false or exit_of(ev, G_CHG, n) != 0) { return false; }
    const m : usize = ch_count(ev, n);
    if (m == 0 or m > GL_E_MAX) { return false; }
    var i : usize = 0;
    while (i < m) {
        if (path_ok(ev, ch_line(ev, n, i)) == false) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn gen_ok(ev: string, n: u64) -> bool {
    const m : usize = ch_count(ev, n);
    var derived : bool = false;
    var i : usize = 0;
    while (i < m) {
        const ls : usize = ch_line(ev, n, i);
        if (starts(ev, ls + 2, line_end(ev, ls), "gen/")) { derived = true; }
        i = i + 1;
    }
    return derived == false or targets(ev, n) > 0;
}

pub fn seal_clean(ev: string, n: u64) -> bool {
    const f : usize = body_from(ev, G_SEAL, n);
    const t : usize = body_to(ev, G_SEAL, n);
    return exit_of(ev, G_SEAL, n) == 0 and find_in(ev, f, t, "all hashes MATCH") <= t and find_in(ev, f, t, "VERIFICATION FAILED") > t;
}

pub fn test_clean(ev: string, n: u64) -> bool {
    const f : usize = body_from(ev, G_TEST, n);
    const t : usize = body_to(ev, G_TEST, n);
    return exit_of(ev, G_TEST, n) == 0 and find_in(ev, f, t, ", 0 failed") <= t and find_in(ev, f, t, ": 0 passed,") > t;
}

/// 0 when every target's section of step k ran and is clean; 1 when one has not run yet; 2 when one ran unclean.
pub fn all_targets(ev: string, link: u64, k: u8) -> u8 {
    const m : usize = ch_count(ev, link);
    var i : usize = 0;
    var open : bool = false;
    while (i < m) {
        if (is_target(ev, ch_line(ev, link, i))) {
            const n : u64 = link * TGT + (i as u64);
            if (ran(ev, k, n) == false) {
                open = true;
            } else {
                if (k == G_SEAL and seal_clean(ev, n) == false) { return 2; }
                if (k == G_TEST and test_clean(ev, n) == false) { return 2; }
            }
        }
        i = i + 1;
    }
    if (open) { return 1; }
    return 0;
}

pub fn verdict(ev: string, n: u64, st: u8) -> u8 {
    if (ran(ev, G_TIP, n) == false) { return GC_V_NONE; }
    if (st == 0) {
        if (spec_ok(ev, n)) { return GC_V_PASS; }
        return GC_V_FAIL;
    }
    if (verdict(ev, n, st - 1) != GC_V_PASS and verdict(ev, n, st - 1) != GC_V_REUSED) { return GC_V_NONE; }
    if (st == 1) {
        if (gen_ok(ev, n)) { return GC_V_PASS; }
        return GC_V_FAIL;
    }
    if (st == 2 or st == 3) {
        if (targets(ev, n) == 0) { return GC_V_REUSED; }
        var k : u8 = G_SEAL;
        if (st == 3) { k = G_TEST; }
        const a : u8 = all_targets(ev, n, k);
        if (a == 0) { return GC_V_PASS; }
        if (a == 2) { return GC_V_FAIL; }
        return GC_V_NONE;
    }
    if (ran(ev, G_LOG, n) == false) { return GC_V_NONE; }
    if (find_in(ev, body_from(ev, G_LOG, n), body_to(ev, G_LOG, n), "Closes #") <= body_to(ev, G_LOG, n)) { return GC_V_PASS; }
    return GC_V_FAIL;
}

// --- the pass: gc_land over the queue ---------------------------------------------------------------

pub fn path_hash(ev: string, a: usize, b: usize) -> u64 {
    var h : u64 = 7;
    var k : usize = a;
    while (k < b) {
        h = (h * 131 + (ev[k] as u64)) % 1000000000000037;
        k = k + 1;
    }
    return h;
}

/// Land the n queued links on the head (golden_chain.t27 gc_land). out[i] is what happened to link i, pos[i] its place in the
/// landing order (n when it did not land). Returns how many land.
pub fn plan(ev: string, n: usize, out: []u8, pos: []usize) -> usize {
    var id : [16]u64 = [0] ** 16;
    var parent : [16]u64 = [0] ** 16;
    var v : [80]u8 = [0] ** 80;
    var eo : [512]usize = [0] ** 512;
    var ep : [512]u64 = [0] ** 512;
    var ek : [512]u8 = [0] ** 512;
    var el : [512]u32 = [0] ** 512;
    var eh : [512]u32 = [0] ** 512;
    var io : [1]usize = [0] ** 1;
    var ip : [1]u64 = [0] ** 1;
    var m : usize = 0;
    var i : usize = 0;
    while (i < n) {
        id[i] = id_of(ev, G_TIP, i as u64);
        parent[i] = id_of(ev, G_MB, i as u64);
        var st : u8 = 0;
        while (st < 5) {
            v[i * 5 + (st as usize)] = verdict(ev, i as u64, st);
            st = st + 1;
        }
        var c : usize = ch_count(ev, i as u64);
        if (c > GL_E_MAX) { c = GL_E_MAX; }
        var j : usize = 0;
        while (j < c) {
            const ls : usize = ch_line(ev, i as u64, j);
            eo[m] = i;
            ep[m] = path_hash(ev, ls + 2, line_end(ev, ls));
            ek[m] = EDIT_WHOLE;
            if (is_derived(ev, ls)) { ek[m] = GC_EDIT_DERIVED; }
            m = m + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    var head : u64 = 0;
    if (cur0(ev) < ev.len) { head = hex15(ev, cur0(ev)); }
    return gc_land(n, &id, &parent, &v, m, &eo, &ep, &ek, &el, &eh, 0, &io, &ip, head, out, pos);
}

/// The link that lands r-th in a fresh pass over n links; n when none does. wo and wp hold the pass afterwards.
pub fn landing_at(ev: string, n: usize, r: usize, wo: []u8, wp: []usize) -> usize {
    const landed : usize = plan(ev, n, wo, wp);
    var j : usize = 0;
    while (j < n) {
        if (wp[j] == r and r < landed) { return j; }
        j = j + 1;
    }
    return n;
}

/// Where the sha of what the head becomes when link j lands begins: its own tip when it was FORWARD, else the commit made for it.
pub fn new_of(ev: string, j: u64, outcome: u8) -> usize {
    if (outcome == GC_OUT_FORWARD) { return body_from(ev, G_TIP, j); }
    return body_from(ev, G_CT, j);
}

/// Where the sha of the head link j lands on begins.
pub fn cur_for(ev: string, j: usize, wo: []u8, wp: []usize) -> usize {
    const n : usize = q_count(ev);
    const landed : usize = plan(ev, n, wo, wp);
    const at : usize = wp[j];
    if (at == 0 or at >= landed) { return cur0(ev); }
    const prev : usize = landing_at(ev, n, at - 1, wo, wp);
    return new_of(ev, prev as u64, wo[prev]);
}

// --- the push state ---------------------------------------------------------------------------------

pub fn lines_in(ev: string, f: usize, t: usize) -> usize {
    var c : usize = 0;
    var p : usize = f;
    while (p < t) {
        if (line_end(ev, p) > p) { c = c + 1; }
        p = line_end(ev, p) + 1;
    }
    return c;
}

pub fn ahead_count(ev: string) -> usize {
    return lines_in(ev, body_from(ev, P_AHEAD, 0), body_to(ev, P_AHEAD, 0));
}

pub fn batch_len(ev: string) -> usize {
    const a : usize = ahead_count(ev);
    if (a > GC_BATCH_MAX) { return GC_BATCH_MAX; }
    return a;
}

/// Minutes since refs/golden/pushed last moved; 100000 when it never did (a push is then due the moment there is a link).
pub fn minutes_since(ev: string) -> u32 {
    if (exit_of(ev, P_STAMP, 0) != 0 or exit_of(ev, P_NOW, 0) != 0) { return 100000; }
    const s : u64 = digits(ev, body_from(ev, P_STAMP, 0), line_end(ev, body_from(ev, P_STAMP, 0)));
    const t : u64 = digits(ev, body_from(ev, P_NOW, 0), line_end(ev, body_from(ev, P_NOW, 0)));
    if (s == 0 or t < s) { return 100000; }
    return ((t - s) / 60) as u32;
}

/// The Actions queue length: the number the caller passed, else the databaseId entries of `gh run list`, else 0.
pub fn queued_runs(r: GolReq, ev: string) -> u32 {
    if (r.queued != ABSENT) { return r.queued as u32; }
    if (exit_of(ev, P_QUEUED, 0) != 0) { return 0; }
    var c : u32 = 0;
    var p : usize = body_from(ev, P_QUEUED, 0);
    const t : usize = body_to(ev, P_QUEUED, 0);
    while (p < t) {
        const at : usize = find_in(ev, p, t, "databaseId");
        if (at > t) { return c; }
        c = c + 1;
        p = at + 10;
    }
    return c;
}

pub fn decision(r: GolReq, ev: string) -> u8 {
    return when_to_push(minutes_since(ev), batch_len(ev), queued_runs(r, ev));
}

/// Where the sha of the batch's last link begins: the batch_len-th line of the unpushed list, oldest first.
pub fn target_off(ev: string) -> usize {
    var p : usize = body_from(ev, P_AHEAD, 0);
    var c : usize = 1;
    while (c < batch_len(ev)) {
        p = line_end(ev, p) + 1;
        c = c + 1;
    }
    return p;
}

// --- which slot runs next ------------------------------------------------------------------------------

pub fn slot_of(k: u8, n: u64) -> u64 {
    return (k as u64) * SLOT + n;
}

pub fn wants_global(r: GolReq, ev: string, k: u8) -> bool {
    if (k == G_REFS or k == G_FILE) { return r.verb != V_PUSH; }
    if (k == G_HEAD or k == G_BASE) { return true; }
    if (r.verb == V_LAND) { return false; }
    if (has_head(ev) == false) { return false; }
    if (k == P_STAMP) { return sha_ok(ev, P_PUSHED, 0); }
    if (k == P_QUEUED) { return r.queued == ABSENT; }
    return true;
}

/// The next slot of link j's verification, or DONE.
pub fn link_slot(ev: string, j: u64) -> u64 {
    if (ran(ev, G_TIP, j) == false) { return slot_of(G_TIP, j); }
    if (sha_ok(ev, G_TIP, j) == false) { return DONE; }
    if (ran(ev, G_MB, j) == false) { return slot_of(G_MB, j); }
    if (sha_ok(ev, G_MB, j) == false) { return DONE; }
    if (ran(ev, G_CHG, j) == false) { return slot_of(G_CHG, j); }
    if (exit_of(ev, G_CHG, j) != 0) { return DONE; }
    if (ran(ev, G_LOG, j) == false) { return slot_of(G_LOG, j); }
    if (spec_ok(ev, j) == false or gen_ok(ev, j) == false or targets(ev, j) == 0) { return DONE; }
    if (ran(ev, G_WT, j) == false) { return slot_of(G_WT, j); }
    if (exit_of(ev, G_WT, j) == 0) {
        const m : usize = ch_count(ev, j);
        var i : usize = 0;
        while (i < m) {
            if (is_target(ev, ch_line(ev, j, i)) and ran(ev, G_SEAL, j * TGT + (i as u64)) == false) { return slot_of(G_SEAL, j * TGT + (i as u64)); }
            i = i + 1;
        }
        if (all_targets(ev, j, G_SEAL) == 0) {
            i = 0;
            while (i < m) {
                if (is_target(ev, ch_line(ev, j, i)) and ran(ev, G_TEST, j * TGT + (i as u64)) == false) { return slot_of(G_TEST, j * TGT + (i as u64)); }
                i = i + 1;
            }
        }
        if (ran(ev, G_RM, j) == false) { return slot_of(G_RM, j); }
    }
    return DONE;
}

/// The next slot to run: the first one in order that is wanted and has no section yet; DONE when there is none. It never names
/// G_PRUNE, which the host runs by itself at the end.
pub fn next_slot(r: GolReq, ev: string, wo: []u8, wp: []usize) -> u64 {
    var k : u8 = G_REFS;
    while (k <= G_BASE) {
        if (wants_global(r, ev, k) and ran(ev, k, 0) == false) { return slot_of(k, 0); }
        k = k + 1;
    }
    if (sha_ok(ev, G_BASE, 0) == false) { return DONE; }
    if (r.verb == V_LAND) {
        const n : usize = q_count(ev);
        var j : usize = 0;
        while (j < n) {
            const s : u64 = link_slot(ev, j as u64);
            if (s < DONE) { return s; }
            j = j + 1;
        }
        const landed : usize = plan(ev, n, wo, wp);
        var q : usize = 0;
        while (q < landed) {
            const l : usize = landing_at(ev, n, q, wo, wp);
            if (wo[l] != GC_OUT_FORWARD) {
                if (ran(ev, G_MT, l as u64) == false) { return slot_of(G_MT, l as u64); }
                if (sha_ok(ev, G_MT, l as u64) == false) { return DONE; }
                if (ran(ev, G_CT, l as u64) == false) { return slot_of(G_CT, l as u64); }
                if (sha_ok(ev, G_CT, l as u64) == false) { return DONE; }
            }
            if (r.plan == false and ran(ev, G_CAS, l as u64) == false) { return slot_of(G_CAS, l as u64); }
            if (r.plan == false and exit_of(ev, G_CAS, l as u64) != 0) { return DONE; }
            q = q + 1;
        }
        return DONE;
    }
    k = P_PUSHED;
    while (k <= P_QUEUED) {
        if (wants_global(r, ev, k) and ran(ev, k, 0) == false) { return slot_of(k, 0); }
        k = k + 1;
    }
    if (r.verb == V_PUSH and r.plan == false and decision(r, ev) == GC_PUSH_NOW) {
        k = P_BRANCH;
        while (k <= P_MARK) {
            if (ran(ev, k, 0) == false) { return slot_of(k, 0); }
            if (exit_of(ev, k, 0) != 0) { return DONE; }
            k = k + 1;
        }
    }
    return DONE;
}

/// What a finished run of slot (k, n) means for the rest: C_OK goes on, anything else stops the pass.
pub fn judge(r: GolReq, ev: string, k: u8, n: u64) -> u8 {
    const x : u64 = exit_of(ev, k, n);
    if (k == G_BASE and sha_ok(ev, G_BASE, 0) == false) { return C_NO_BASE; }
    if (k == G_MT and x != 0) { return C_MERGE; }
    if (k == G_CT and sha_ok(ev, G_CT, n) == false) { return C_STEP; }
    if (k == G_CAS and x != 0) { return C_HEAD_MOVED; }
    if (k == P_LAND and x != 0) { return C_LAND_REFUSED; }
    if ((k == P_BRANCH or k == P_MARK) and x != 0) { return C_STEP; }
    return C_OK;
}

pub fn in_scratch(k: u8) -> bool {
    return k == G_SEAL or k == G_TEST;
}

// --- the commands ------------------------------------------------------------------------------------

pub fn arg(out: []u8, w0: usize, s: string) -> usize {
    const w : usize = emit_str(out, w0, s);
    return emit_byte(out, w, 10);
}

pub fn put_span(out: []u8, w: usize, t: string, a: usize, b: usize) -> usize {
    var p : usize = w;
    var k : usize = a;
    while (k < b) {
        p = emit_byte(out, p, t[k]);
        k = k + 1;
    }
    return p;
}

pub fn arg_span(out: []u8, w0: usize, t: string, a: usize, b: usize) -> usize {
    const w : usize = put_span(out, w0, t, a, b);
    return emit_byte(out, w, 10);
}

pub fn sha_arg(out: []u8, w: usize, t: string, a: usize) -> usize {
    return arg_span(out, w, t, a, a + 40);
}

pub fn zero_arg(out: []u8, w: usize) -> usize {
    var p : usize = w;
    var k : usize = 0;
    while (k < 40) {
        p = emit_byte(out, p, 48);
        k = k + 1;
    }
    return emit_byte(out, p, 10);
}

pub fn git(out: []u8, w0: usize, a: string) -> usize {
    const w : usize = arg(out, w0, "git");
    return arg(out, w, a);
}

/// The worktree of link j: <scratch>/gl-<j>.
pub fn emit_wt(out: []u8, w0: usize, r: GolReq, j: u64) -> usize {
    var w : usize = emit_str(out, w0, r.scratch);
    w = emit_str(out, w, "/gl-");
    return emit_dec(out, w, j);
}

/// The directory step k, entry n, runs in; 0 bytes means the caller's own.
pub fn step_cwd(r: GolReq, k: u8, n: u64, out: []u8) -> usize {
    if (in_scratch(k) == false) { return 0; }
    const w : usize = emit_wt(out, 0, r, n / TGT);
    return fits(out, w);
}

/// The branch of the push: claude/golden-<10 hex of the last link of the batch>.
pub fn emit_push_branch(out: []u8, w: usize, ev: string) -> usize {
    var p : usize = emit_str(out, w, "claude/golden-");
    const f : usize = target_off(ev);
    var k : usize = 0;
    while (k < 10) {
        p = emit_byte(out, p, ev[f + k]);
        k = k + 1;
    }
    return p;
}

/// Does the evidence hold what step k, entry j, writes into its command? Asked before any byte is written.
pub fn args_ready(ev: string, k: u8, j: u64) -> bool {
    const cur : bool = has_head(ev) or sha_ok(ev, G_BASE, 0);
    if (k == G_TIP) { return q_start(ev, j as usize) < ev.len; }
    if (k == G_MB or k == G_MT) { return sha_ok(ev, G_TIP, j) and cur and (k == G_MB or sha_ok(ev, G_MB, j)); }
    if (k == G_CHG or k == G_LOG) { return sha_ok(ev, G_TIP, j) and sha_ok(ev, G_MB, j); }
    if (k == G_WT) { return sha_ok(ev, G_TIP, j); }
    if (k == G_CT) { return sha_ok(ev, G_MT, j) and q_start(ev, j as usize) < ev.len; }
    if (k == G_CAS) { return sha_ok(ev, G_TIP, j) and cur; }
    if (k == P_AHEAD) { return has_head(ev) and (sha_ok(ev, P_PUSHED, 0) or sha_ok(ev, G_BASE, 0)); }
    if (k == P_BRANCH or k == P_LAND or k == P_MARK) { return ahead_count(ev) > 0 and has_head(ev); }
    return true;
}

/// One step's argument vector, one argument per line, no shell. The byte count, 0 when it does not fit or the slot has no command.
pub fn step_argv(r: GolReq, ev: string, k: u8, n: u64, out: []u8, wo: []u8, wp: []usize) -> usize {
    var w : usize = 0;
    const j : u64 = n % SLOT;
    if (args_ready(ev, k, j) == false) { return 0; }
    if (k == G_REFS) {
        w = git(out, w, "for-each-ref");
        w = arg(out, w, "--format=%(refname:short)");
        w = arg(out, w, "refs/heads/claude/evolve-*");
    }
    if (k == G_FILE) {
        w = arg(out, w, "cat");
        w = arg(out, w, GL_QUEUE_FILE);
    }
    if (k == G_HEAD) {
        w = git(out, w, "rev-parse");
        w = arg(out, w, "--verify");
        w = arg(out, w, "-q");
        w = arg(out, w, GC_REF);
    }
    if (k == G_BASE) {
        w = git(out, w, "rev-parse");
        w = arg(out, w, "--verify");
        w = arg(out, w, "-q");
        w = arg(out, w, "refs/remotes/origin/master");
    }
    if (k == G_TIP) {
        const a : usize = q_start(ev, j as usize);
        if (a >= ev.len) { return 0; }
        w = git(out, w, "rev-parse");
        w = arg(out, w, "--verify");
        w = arg(out, w, "-q");
        w = emit_str(out, w, "refs/heads/");
        w = arg_span(out, w, ev, a, line_end(ev, a));
    }
    if (k == G_MB) {
        w = git(out, w, "merge-base");
        w = sha_arg(out, w, ev, body_from(ev, G_TIP, j));
        w = sha_arg(out, w, ev, cur0(ev));
    }
    if (k == G_CHG) {
        w = git(out, w, "diff");
        w = arg(out, w, "--name-status");
        w = arg(out, w, "--no-renames");
        w = sha_arg(out, w, ev, body_from(ev, G_MB, j));
        w = sha_arg(out, w, ev, body_from(ev, G_TIP, j));
    }
    if (k == G_LOG) {
        w = git(out, w, "log");
        w = arg(out, w, "--format=%B");
        w = put_span(out, w, ev, body_from(ev, G_MB, j), body_from(ev, G_MB, j) + 40);
        w = emit_str(out, w, "..");
        w = sha_arg(out, w, ev, body_from(ev, G_TIP, j));
    }
    if (k == G_WT) {
        w = git(out, w, "worktree");
        w = arg(out, w, "add");
        w = arg(out, w, "-q");
        w = arg(out, w, "--detach");
        w = emit_wt(out, w, r, j);
        w = emit_byte(out, w, 10);
        w = sha_arg(out, w, ev, body_from(ev, G_TIP, j));
    }
    if (k == G_SEAL or k == G_TEST) {
        const link : u64 = j / TGT;
        const ls : usize = ch_line(ev, link, (j % TGT) as usize);
        if (is_target(ev, ls) == false) { return 0; }
        if (k == G_SEAL) {
            w = arg(out, w, r.t27c);
            w = arg(out, w, "seal");
            w = arg_span(out, w, ev, ls + 2, line_end(ev, ls));
            w = arg(out, w, "--verify");
        } else {
            w = arg(out, w, r.t27b);
            w = arg(out, w, "test");
            w = arg_span(out, w, ev, ls + 2, line_end(ev, ls));
        }
    }
    if (k == G_RM) {
        w = git(out, w, "worktree");
        w = arg(out, w, "remove");
        w = arg(out, w, "--force");
        w = emit_wt(out, w, r, j);
        w = emit_byte(out, w, 10);
    }
    if (k == G_MT or k == G_CT or k == G_CAS) {
        const cur : usize = cur_for(ev, j as usize, wo, wp);
        if (k == G_MT) {
            w = git(out, w, "merge-tree");
            w = arg(out, w, "--write-tree");
            w = emit_str(out, w, "--merge-base=");
            w = sha_arg(out, w, ev, body_from(ev, G_MB, j));
            w = sha_arg(out, w, ev, cur);
            w = sha_arg(out, w, ev, body_from(ev, G_TIP, j));
        }
        if (k == G_CT) {
            w = git(out, w, "commit-tree");
            w = sha_arg(out, w, ev, body_from(ev, G_MT, j));
            w = arg(out, w, "-p");
            w = sha_arg(out, w, ev, cur);
            w = arg(out, w, "-m");
            w = emit_str(out, w, "golden: carry ");
            w = put_span(out, w, ev, q_start(ev, j as usize), line_end(ev, q_start(ev, j as usize)));
            if (r.issue > 0) {
                w = emit_str(out, w, " (Closes #");
                w = emit_dec(out, w, r.issue);
                w = emit_str(out, w, ")");
            }
            w = emit_byte(out, w, 10);
        }
        if (k == G_CAS) {
            const landed : usize = plan(ev, q_count(ev), wo, wp);
            w = git(out, w, "update-ref");
            w = arg(out, w, GC_REF);
            w = sha_arg(out, w, ev, new_of(ev, j, wo[j as usize]));
            if (wp[j as usize] == 0 and has_head(ev) == false) {
                w = zero_arg(out, w);
            } else {
                w = sha_arg(out, w, ev, cur);
            }
        }
    }
    if (k == P_PUSHED) {
        w = git(out, w, "rev-parse");
        w = arg(out, w, "--verify");
        w = arg(out, w, "-q");
        w = arg(out, w, GL_PUSHED);
    }
    if (k == P_AHEAD) {
        w = git(out, w, "rev-list");
        w = arg(out, w, "--first-parent");
        w = arg(out, w, "--reverse");
        if (sha_ok(ev, P_PUSHED, 0)) {
            w = put_span(out, w, ev, body_from(ev, P_PUSHED, 0), body_from(ev, P_PUSHED, 0) + 40);
        } else {
            w = put_span(out, w, ev, body_from(ev, G_BASE, 0), body_from(ev, G_BASE, 0) + 40);
        }
        w = emit_str(out, w, "..");
        w = sha_arg(out, w, ev, body_from(ev, G_HEAD, 0));
    }
    if (k == P_STAMP) {
        w = git(out, w, "reflog");
        w = arg(out, w, "show");
        w = arg(out, w, "--format=%ct");
        w = arg(out, w, "-n");
        w = arg(out, w, "1");
        w = arg(out, w, GL_PUSHED);
    }
    if (k == P_NOW) {
        w = arg(out, w, "date");
        w = arg(out, w, "+%s");
    }
    if (k == P_QUEUED) {
        w = arg(out, w, "gh");
        w = arg(out, w, "run");
        w = arg(out, w, "list");
        w = arg(out, w, "--status");
        w = arg(out, w, "queued");
        w = arg(out, w, "--limit");
        w = arg(out, w, "300");
        w = arg(out, w, "--json");
        w = arg(out, w, "databaseId");
    }
    if (k == P_BRANCH) {
        w = git(out, w, "branch");
        w = arg(out, w, "-f");
        w = emit_push_branch(out, w, ev);
        w = emit_byte(out, w, 10);
        w = sha_arg(out, w, ev, target_off(ev));
    }
    if (k == P_LAND) {
        w = arg(out, w, r.tri);
        w = arg(out, w, "land");
        w = emit_push_branch(out, w, ev);
        w = emit_byte(out, w, 10);
        w = arg(out, w, "--issue");
        w = emit_dec(out, w, r.issue);
        w = emit_byte(out, w, 10);
    }
    if (k == P_MARK) {
        w = git(out, w, "update-ref");
        w = arg(out, w, "--create-reflog");
        w = arg(out, w, GL_PUSHED);
        w = sha_arg(out, w, ev, target_off(ev));
        if (sha_ok(ev, P_PUSHED, 0)) {
            w = sha_arg(out, w, ev, body_from(ev, P_PUSHED, 0));
        } else {
            w = zero_arg(out, w);
        }
    }
    if (k == G_PRUNE) {
        w = git(out, w, "worktree");
        w = arg(out, w, "prune");
    }
    return fits(out, w);
}

// --- what the command prints ---------------------------------------------------------------------------

pub fn exit_code(c: u8) -> u8 {
    return c;
}

pub fn code_name(c: u8) -> string {
    if (c == C_OK) { return "OK"; }
    if (c == C_BAD_VERB) { return "BAD_VERB"; }
    if (c == C_BAD_ISSUE) { return "BAD_ISSUE"; }
    if (c == C_BAD_PATH) { return "BAD_PATH"; }
    if (c == C_NO_BASE) { return "NO_BASE"; }
    if (c == C_MERGE) { return "MERGE_CONFLICT"; }
    if (c == C_STEP) { return "STEP_FAILED"; }
    if (c == C_HEAD_MOVED) { return "HEAD_MOVED"; }
    if (c == C_LAND_REFUSED) { return "LAND_REFUSED"; }
    return "ODDS";
}

pub fn code_why(c: u8) -> string {
    if (c == C_OK) { return "done"; }
    if (c == C_BAD_VERB) { return "the verbs are land, push and status"; }
    if (c == C_BAD_ISSUE) { return "a push opens a pull request: pass --issue N (L1)"; }
    if (c == C_BAD_PATH) { return "a program or scratch path has bytes a command line should not carry"; }
    if (c == C_NO_BASE) { return "refs/remotes/origin/master is missing: git fetch origin master"; }
    if (c == C_MERGE) { return "git merge-tree met a conflict: the link goes back to its bee"; }
    if (c == C_STEP) { return "a git step failed; its output is the evidence"; }
    if (c == C_HEAD_MOVED) { return "refs/golden/head is not where this pass read it: nothing was forced, run it again"; }
    if (c == C_LAND_REFUSED) { return "tri land refused the batch branch; refs/golden/pushed did not move"; }
    return "unknown";
}

pub fn outcome_name(o: u8) -> string {
    if (o == GC_OUT_FORWARD) { return "FORWARD"; }
    if (o == GC_OUT_CARRIED) { return "CARRIED"; }
    if (o == GC_OUT_REGEN) { return "REGEN"; }
    if (o == GC_OUT_REJUDGE) { return "REJUDGE"; }
    if (o == GC_OUT_CONFLICT) { return "CONFLICT"; }
    if (o == GC_OUT_NOT_GOLDEN) { return "NOT_GOLDEN"; }
    return "UNKNOWN_PARENT";
}

pub fn verdict_letter(v: u8) -> u8 {
    if (v == GC_V_PASS) { return 112; }
    if (v == GC_V_REUSED) { return 114; }
    if (v == GC_V_FAIL) { return 102; }
    return 45;
}

/// Where the sha of step k begins when it printed one, else ev.len.
pub fn off_if(ev: string, k: u8, n: u64) -> usize {
    if (sha_ok(ev, k, n)) { return body_from(ev, k, n); }
    return ev.len;
}

pub fn put_sha12(out: []u8, w: usize, ev: string, a: usize) -> usize {
    if (a >= ev.len) { return emit_str(out, w, "none"); }
    return put_span(out, w, ev, a, a + 12);
}

/// The command a slot runs, on one line ("would run: ..."): the argument vector with blanks for its newlines.
pub fn put_cmd(out: []u8, w: usize, r: GolReq, ev: string, k: u8, n: u64, wo: []u8, wp: []usize, tmp: []u8) -> usize {
    const m : usize = step_argv(r, ev, k, n, tmp, wo, wp);
    var p : usize = emit_str(out, w, "  would run: ");
    var i : usize = 0;
    while (i + 1 < m) {
        if (tmp[i] == 10) { p = emit_byte(out, p, 32); } else { p = emit_byte(out, p, tmp[i]); }
        i = i + 1;
    }
    return emit_byte(out, p, 10);
}

pub fn report_land(r: GolReq, ev: string, out: []u8, wo: []u8, wp: []usize, tmp: []u8) -> usize {
    var w : usize = emit_str(out, 0, "golden head: ");
    w = put_sha12(out, w, ev, off_if(ev, G_HEAD, 0));
    if (has_head(ev) == false) {
        w = emit_str(out, w, " (base ");
        w = put_sha12(out, w, ev, off_if(ev, G_BASE, 0));
        w = emit_byte(out, w, 41);
    }
    const n : usize = q_count(ev);
    w = emit_byte(out, w, 10);
    w = emit_str(out, w, "queue: ");
    w = emit_dec(out, w, n as u64);
    w = emit_byte(out, w, 10);
    const landed : usize = plan(ev, n, wo, wp);
    var i : usize = 0;
    while (i < n) {
        w = put_span(out, w, ev, q_start(ev, i), line_end(ev, q_start(ev, i)));
        w = emit_byte(out, w, 32);
        var st : u8 = 0;
        while (st < 5) { w = emit_byte(out, w, verdict_letter(verdict(ev, i as u64, st))); st = st + 1; }
        w = emit_byte(out, w, 32);
        w = emit_str(out, w, outcome_name(wo[i]));
        w = emit_byte(out, w, 10);
        i = i + 1;
    }
    w = emit_str(out, w, "landed: ");
    w = emit_dec(out, w, landed as u64);
    w = emit_str(out, w, " of ");
    w = emit_dec(out, w, n as u64);
    w = emit_str(out, w, "\n");
    var q : usize = 0;
    while (q < landed) {
        const l : usize = landing_at(ev, n, q, wo, wp);
        if (r.plan) { w = put_cmd(out, w, r, ev, G_CAS, l as u64, wo, wp, tmp); }
        q = q + 1;
    }
    return w;
}

pub fn report_push(r: GolReq, ev: string, out: []u8, wo: []u8, wp: []usize, tmp: []u8) -> usize {
    var w : usize = emit_str(out, 0, "golden head: ");
    w = put_sha12(out, w, ev, off_if(ev, G_HEAD, 0));
    w = emit_str(out, w, "\npushed: ");
    w = put_sha12(out, w, ev, off_if(ev, P_PUSHED, 0));
    w = emit_str(out, w, "\nunpushed links: ");
    w = emit_dec(out, w, ahead_count(ev) as u64);
    w = emit_str(out, w, " (batch ");
    w = emit_dec(out, w, batch_len(ev) as u64);
    w = emit_str(out, w, ", cap 8)\nminutes since the last push: ");
    w = emit_dec(out, w, minutes_since(ev) as u64);
    w = emit_str(out, w, "\nactions queued: ");
    w = emit_dec(out, w, queued_runs(r, ev) as u64);
    w = emit_str(out, w, "\nnext push: ");
    const d : u8 = decision(r, ev);
    if (d == GC_PUSH_NOTHING) { w = emit_str(out, w, "NOTHING (no link is waiting)\n"); }
    if (d == GC_PUSH_NOW) { w = emit_str(out, w, "NOW\n"); }
    if (d == GC_PUSH_WAIT) {
        var window : u32 = GC_WINDOW_MIN;
        if (queued_runs(r, ev) >= GC_CI_JAM) { window = GC_WINDOW_MIN * 2; }
        w = emit_str(out, w, "WAIT ");
        w = emit_dec(out, w, (window - minutes_since(ev)) as u64);
        w = emit_str(out, w, " more minute(s)\n");
    }
    if (r.verb == V_PUSH and d == GC_PUSH_NOW) {
        var k : u8 = P_BRANCH;
        while (k <= P_MARK) {
            if (r.plan) { w = put_cmd(out, w, r, ev, k, 0, wo, wp, tmp); }
            k = k + 1;
        }
    }
    return w;
}

pub fn report_queue_status(ev: string, out: []u8, w0: usize) -> usize {
    var w : usize = emit_str(out, w0, "queue:");
    var i : usize = 0;
    while (i < q_count(ev)) {
        w = emit_byte(out, w, 32);
        w = put_span(out, w, ev, q_start(ev, i), line_end(ev, q_start(ev, i)));
        i = i + 1;
    }
    return emit_byte(out, w, 10);
}

/// The whole text the command prints at the end, then the refusal if there is one. The byte count (0 when it does not fit).
pub fn report(r: GolReq, ev: string, code: u8, out: []u8, wo: []u8, wp: []usize, tmp: []u8) -> usize {
    var w : usize = 0;
    if (code >= C_BAD_VERB and code <= C_NO_BASE) {
        w = emit_str(out, 0, "refused: ");
        w = emit_str(out, w, code_name(code));
        w = emit_str(out, w, ": ");
        w = emit_str(out, w, code_why(code));
        w = emit_byte(out, w, 10);
        return fits(out, w);
    }
    if (r.verb == V_LAND) { w = report_land(r, ev, out, wo, wp, tmp); }
    if (r.verb != V_LAND) { w = report_push(r, ev, out, wo, wp, tmp); }
    if (r.verb == V_STATUS) { w = report_queue_status(ev, out, w); }
    if (code != C_OK) {
        w = emit_str(out, w, "refused: ");
        w = emit_str(out, w, code_name(code));
        w = emit_str(out, w, ": ");
        w = emit_str(out, w, code_why(code));
        w = emit_byte(out, w, 10);
    }
    return fits(out, w);
}

