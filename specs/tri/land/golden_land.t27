const FS1 : str = "1111111111111111111111111111111111111111";
const FS7 : str = "1717171717171717171717171717171717171717";
const FS8 : str = "1818181818181818181818181818181818181818";
const FS9 : str = "1919191919191919191919191919191919191919";

// --- tests -----------------------------------------------------------------------------------------------

const T_ZERO : str = "0000000000000000000000000000000000000000";

pub fn rq(verb: u8, plan: bool, queued: u64) -> GolReq {
    return GolReq { verb: verb, plan: plan, queued: queued, issue: 11275, scratch: "/tmp/s", t27b: "t27b", t27c: "t27c", tri: "/tmp/tri" };
}

pub fn argv_is(r: GolReq, ev: string, k: u8, n: u64, want: string, buf: []u8, wo: []u8, wp: []usize) -> bool {
    const m : usize = step_argv(r, ev, k, n, buf, wo, wp);
    return m > 0 and buf_is(buf, m, want);
}

pub fn name_is(ev: string, i: usize, want: string) -> bool {
    return span_is(ev, q_start(ev, i), line_end(ev, q_start(ev, i)), want);
}

test the_verbs_and_the_request_are_checked_before_any_step {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    assert verb_of("land") == V_LAND and verb_of("push") == V_PUSH and verb_of("status") == V_STATUS;
    assert verb_of("pull") == V_BAD and verb_of("") == V_BAD;
    assert request_refusal(rq(V_LAND, false, ABSENT)) == C_OK;
    assert request_refusal(rq(V_BAD, false, ABSENT)) == C_BAD_VERB;
    const noissue : GolReq = GolReq { verb: V_PUSH, plan: false, queued: ABSENT, issue: 0, scratch: "/tmp/s", t27b: "t27b", t27c: "t27c", tri: "/tmp/tri" };
    assert request_refusal(noissue) == C_BAD_ISSUE;
    const planned : GolReq = GolReq { verb: V_PUSH, plan: true, queued: ABSENT, issue: 0, scratch: "/tmp/s", t27b: "t27b", t27c: "t27c", tri: "/tmp/tri" };
    assert request_refusal(planned) == C_OK;
    const badpath : GolReq = GolReq { verb: V_LAND, plan: true, queued: ABSENT, issue: 1, scratch: "/tmp/a b", t27b: "t27b", t27c: "t27c", tri: "/tmp/tri" };
    assert request_refusal(badpath) == C_BAD_PATH;
}

test the_queue_is_the_evolve_branches_then_the_file_without_trunks_comments_or_twins {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    assert q_count(EV_G) == 2;
    assert name_is(EV_G, 0, "claude/evolve-a") and name_is(EV_G, 1, "claude/evolve-b");
    // master, a leading dash, a comment, a blank line and a name already listed are not links
    assert q_count(EV_Q) == 2;
    assert name_is(EV_Q, 0, "claude/evolve-a") and name_is(EV_Q, 1, "lanes/extra");
    assert q_count("") == 0;
}

test the_slots_run_in_a_fixed_order_link_by_link {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    const r : GolReq = rq(V_LAND, false, ABSENT);
    assert next_slot(r, "", &wo, &wp) == slot_of(G_REFS, 0);
    assert next_slot(r, EV_Q, &wo, &wp) == slot_of(G_HEAD, 0);
    assert next_slot(r, EV_G, &wo, &wp) == slot_of(G_TIP, 0);
    assert next_slot(r, EV_TIP0, &wo, &wp) == slot_of(G_MB, 0);
    assert next_slot(r, EV_MB0, &wo, &wp) == slot_of(G_CHG, 0);
    assert next_slot(r, EV_CHG0, &wo, &wp) == slot_of(G_LOG, 0);
    assert next_slot(r, EV_LOG0, &wo, &wp) == slot_of(G_WT, 0);
    assert next_slot(r, EV_WT0, &wo, &wp) == slot_of(G_SEAL, 0);
    assert next_slot(r, EV_SEAL0, &wo, &wp) == slot_of(G_TEST, 0);
    assert next_slot(r, EV_TEST0, &wo, &wp) == slot_of(G_RM, 0);
    assert next_slot(r, EV_RM0, &wo, &wp) == slot_of(G_TIP, 1);
}

test the_landing_follows_the_verification_and_ends_when_every_landed_link_is_written {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    const r : GolReq = rq(V_LAND, false, ABSENT);
    assert next_slot(r, EV_V, &wo, &wp) == slot_of(G_CAS, 0);
    assert next_slot(r, EV_C0, &wo, &wp) == slot_of(G_MT, 1);
    assert next_slot(r, EV_M1, &wo, &wp) == slot_of(G_CT, 1);
    assert next_slot(r, EV_K1, &wo, &wp) == slot_of(G_CAS, 1);
    assert next_slot(r, EV_ALL, &wo, &wp) == DONE;
}

test a_plan_runs_the_read_only_steps_and_writes_no_head {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    const r : GolReq = rq(V_LAND, true, ABSENT);
    assert next_slot(r, EV_V, &wo, &wp) == slot_of(G_MT, 1);
    assert next_slot(r, EV_M1, &wo, &wp) == slot_of(G_CT, 1);
    assert next_slot(r, EV_PLAN_K1, &wo, &wp) == DONE;
    // a plan never names the compare-and-swap, whatever the evidence says
    assert next_slot(r, EV_ALL, &wo, &wp) == DONE;
}

test the_stage_verdicts_come_from_git_s_own_output {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    assert verdict(EV_V, 0, 0) == GC_V_PASS and verdict(EV_V, 0, 1) == GC_V_PASS and verdict(EV_V, 0, 2) == GC_V_PASS;
    assert verdict(EV_V, 0, 3) == GC_V_PASS and verdict(EV_V, 0, 4) == GC_V_PASS;
    // a failed seal: SEAL fails, and nothing after it is judged
    assert verdict(EV_SEALBAD, 0, 2) == GC_V_FAIL and verdict(EV_SEALBAD, 0, 3) == GC_V_NONE and verdict(EV_SEALBAD, 0, 4) == GC_V_NONE;
    // a vacuous pass (0 passed) is not a pass
    assert verdict(EV_VACUOUS, 0, 3) == GC_V_FAIL and verdict(EV_VACUOUS, 0, 2) == GC_V_PASS;
    // no Closes #N in the link's messages: RECEIPT fails (L1)
    assert verdict(EV_NOCLOSES, 0, 3) == GC_V_PASS and verdict(EV_NOCLOSES, 0, 4) == GC_V_FAIL;
    // a change to gen/ with no spec beside it: GEN fails (L2), and no worktree is made for it
    assert verdict(EV_GENONLY, 0, 0) == GC_V_PASS and verdict(EV_GENONLY, 0, 1) == GC_V_FAIL and verdict(EV_GENONLY, 0, 2) == GC_V_NONE;
    assert next_slot(rq(V_LAND, false, ABSENT), EV_GENONLY, &wo, &wp) == slot_of(G_TIP, 1);
    // a branch that is not there: nothing is judged
    assert verdict(EV_G, 0, 0) == GC_V_NONE;
    // a seal file under .trinity is a path; a dash first or a .. inside is not
    assert path_ok("M\t.trinity/seals/a.json\n", 0) == true;
    assert path_ok("M\t../x\n", 0) == false and path_ok("M\t-x\n", 0) == false and path_ok("M x\n", 0) == false;
}

test two_links_on_the_base_land_forward_then_carried {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var o : [16]u8 = [0] ** 16;
    var p : [16]usize = [0] ** 16;
    assert plan(EV_V, 2, &o, &p) == 2;
    assert o[0] == GC_OUT_FORWARD and o[1] == GC_OUT_CARRIED;
    assert p[0] == 0 and p[1] == 1;
    assert landing_at(EV_V, 2, 1, &o, &p) == 1 and landing_at(EV_V, 2, 5, &o, &p) == 2 and landing_at(EV_V, 2, 0, &o, &p) == 0;
}

test negative_control_a_link_that_is_not_golden_lands_nowhere_and_the_next_one_still_does {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var o : [16]u8 = [0] ** 16;
    var p : [16]usize = [0] ** 16;
    assert plan(EV_SEALBAD, 2, &o, &p) == 1;
    assert o[0] == GC_OUT_NOT_GOLDEN and o[1] == GC_OUT_FORWARD;
    assert next_slot(rq(V_LAND, false, ABSENT), EV_SEALBAD, &wo, &wp) == slot_of(G_CAS, 1);
    assert plan(EV_NOCLOSES, 2, &o, &p) == 1 and o[0] == GC_OUT_NOT_GOLDEN;
}

test negative_control_two_links_on_one_file_conflict_and_only_the_first_lands {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var o : [16]u8 = [0] ** 16;
    var p : [16]usize = [0] ** 16;
    assert plan(EV_CONF, 2, &o, &p) == 1;
    assert o[0] == GC_OUT_FORWARD and o[1] == GC_OUT_CONFLICT and p[1] == 2;
    assert next_slot(rq(V_LAND, false, ABSENT), EV_CONF, &wo, &wp) == slot_of(G_CAS, 0);
}

test negative_control_a_head_that_moved_under_a_link_lands_nothing {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var o : [16]u8 = [0] ** 16;
    var p : [16]usize = [0] ** 16;
    assert plan(EV_MOVED, 2, &o, &p) == 0;
    assert o[0] == GC_OUT_UNKNOWN_PARENT and o[1] == GC_OUT_UNKNOWN_PARENT;
    assert next_slot(rq(V_LAND, false, ABSENT), EV_MOVED, &wo, &wp) == DONE;
}

test the_compare_and_swap_is_refused_when_git_says_the_head_moved {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    const r : GolReq = rq(V_LAND, false, ABSENT);
    assert judge(r, "@@ preflight 14 0 128 0\n\n", G_CAS, 0) == C_HEAD_MOVED;
    assert judge(r, EV_C0, G_CAS, 0) == C_OK;
    assert judge(r, "@@ preflight 12 1 1 0\n\n", G_MT, 1) == C_MERGE;
    assert judge(r, EV_M1, G_MT, 1) == C_OK;
    assert judge(r, "@@ preflight 13 1 0 4\nnope\n", G_CT, 1) == C_STEP;
    assert judge(r, EV_K1, G_CT, 1) == C_OK;
    assert judge(r, EV_NOBASE, G_BASE, 0) == C_NO_BASE;
    assert judge(r, EV_G, G_BASE, 0) == C_OK;
    // the pass stops at a refused swap: nothing after it is asked
    assert next_slot(r, "@@ preflight 14 0 128 0\n\n", &wo, &wp) == slot_of(G_REFS, 0);
    assert next_slot(r, EV_NOBASE, &wo, &wp) == DONE;
}

test the_first_landing_creates_the_head_and_a_later_one_swaps_from_the_old_value {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var buf : [4096]u8 = [0] ** 4096;
    const r : GolReq = rq(V_LAND, false, ABSENT);
    const first : string = "git\nupdate-ref\nrefs/golden/head\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\n0000000000000000000000000000000000000000\n";
    assert argv_is(r, EV_V, G_CAS, 0, first, &buf, &wo, &wp);
    assert argv_is(r, EV_K1, G_CAS, 1, "git\nupdate-ref\nrefs/golden/head\ne5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\n", &buf, &wo, &wp);
    // the head exists: its value is the old value of the first swap
    assert argv_is(r, EV_HEADED, G_CAS, 0, "git\nupdate-ref\nrefs/golden/head\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\na1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\n", &buf, &wo, &wp);
}

test the_reading_and_verifying_steps_pin_their_bytes {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var buf : [4096]u8 = [0] ** 4096;
    const r : GolReq = rq(V_LAND, false, ABSENT);
    assert argv_is(r, "", G_REFS, 0, "git\nfor-each-ref\n--format=%(refname:short)\nrefs/heads/claude/evolve-*\n", &buf, &wo, &wp);
    assert argv_is(r, "", G_FILE, 0, "cat\n.trinity/golden/queue\n", &buf, &wo, &wp);
    assert argv_is(r, "", G_HEAD, 0, "git\nrev-parse\n--verify\n-q\nrefs/golden/head\n", &buf, &wo, &wp);
    assert argv_is(r, "", G_BASE, 0, "git\nrev-parse\n--verify\n-q\nrefs/remotes/origin/master\n", &buf, &wo, &wp);
    assert argv_is(r, EV_G, G_TIP, 1, "git\nrev-parse\n--verify\n-q\nrefs/heads/claude/evolve-b\n", &buf, &wo, &wp);
    assert argv_is(r, EV_TIP0, G_MB, 0, "git\nmerge-base\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\na1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\n", &buf, &wo, &wp);
    assert argv_is(r, EV_MB0, G_CHG, 0, "git\ndiff\n--name-status\n--no-renames\na1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\n", &buf, &wo, &wp);
    assert argv_is(r, EV_CHG0, G_LOG, 0, "git\nlog\n--format=%B\na1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1..b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\n", &buf, &wo, &wp);
    assert argv_is(r, EV_LOG0, G_WT, 0, "git\nworktree\nadd\n-q\n--detach\n/tmp/s/gl-0\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\n", &buf, &wo, &wp);
    assert argv_is(r, EV_WT0, G_SEAL, 0, "t27c\nseal\nspecs/x/a.t27\n--verify\n", &buf, &wo, &wp);
    assert argv_is(r, EV_SEAL0, G_TEST, 0, "t27b\ntest\nspecs/x/a.t27\n", &buf, &wo, &wp);
    assert argv_is(r, EV_TEST0, G_RM, 0, "git\nworktree\nremove\n--force\n/tmp/s/gl-0\n", &buf, &wo, &wp);
    // the seal and the test of link 1 run in link 1's worktree
    assert step_cwd(r, G_SEAL, 1000, &buf) == 11 and buf_is(&buf, 11, "/tmp/s/gl-1");
    assert step_cwd(r, G_TIP, 0, &buf) == 0;
}

test the_landing_steps_pin_their_bytes {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var buf : [4096]u8 = [0] ** 4096;
    const r : GolReq = rq(V_LAND, false, ABSENT);
    assert argv_is(r, EV_C0, G_MT, 1, "git\nmerge-tree\n--write-tree\n--merge-base=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\nc3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3\n", &buf, &wo, &wp);
    assert argv_is(r, EV_M1, G_CT, 1, "git\ncommit-tree\nf6f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6\n-p\nb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\n-m\ngolden: carry claude/evolve-b (Closes #11275)\n", &buf, &wo, &wp);
    // no word is a force, no step writes a branch of origin, and the head is written only by update-ref with an old value
    var k : u8 = 0;
    while (k < GL_STEPS) {
        const m : usize = step_argv(r, EV_K1, k, 1, &buf, &wo, &wp);
        assert buf_has_not(&buf, m, "git\npush\n");
        assert k == G_RM or buf_has_not(&buf, m, "--force");
        k = k + 1;
    }
}

pub fn buf_has_not(buf: []const u8, n: usize, want: string) -> bool {
    var at : usize = 0;
    while (at + want.len <= n) {
        var k : usize = 0;
        while (k < want.len and buf[at + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return false; }
        at = at + 1;
    }
    return true;
}

test the_push_state_is_read_from_git_s_output {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    const r : GolReq = rq(V_PUSH, false, 0);
    assert ahead_count(EV_P_TEN) == 10 and batch_len(EV_P_TEN) == GC_BATCH_MAX;
    assert ahead_count(EV_P_NONE) == 0 and batch_len(EV_P_NONE) == 0;
    assert minutes_since(EV_P_20) == 20 and minutes_since(EV_P_30) == 30;
    // a pushed ref that never moved: the push is due the moment a link waits
    assert minutes_since(EV_P_FIRST) == 100000;
    assert queued_runs(rq(V_PUSH, false, 250), EV_P_20) == 250;
    assert queued_runs(rq(V_PUSH, false, ABSENT), EV_P_GH) == 3;
    assert queued_runs(rq(V_PUSH, false, ABSENT), EV_P_20) == 0;
    assert decision(r, EV_P_FIRST) == GC_PUSH_NOW;
}

test nothing_ready_pushes_nothing_a_jam_doubles_the_window {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    // the rule is golden_chain.t27 when_to_push; this checks the host feeds it the right three numbers
    assert decision(rq(V_PUSH, false, 0), EV_P_NONE) == GC_PUSH_NOTHING;
    assert decision(rq(V_PUSH, false, 0), EV_P_20) == GC_PUSH_NOW;
    assert decision(rq(V_PUSH, false, 250), EV_P_20) == GC_PUSH_WAIT;
    assert decision(rq(V_PUSH, false, 250), EV_P_30) == GC_PUSH_NOW;
    assert decision(rq(V_PUSH, false, ABSENT), EV_P_GH) == GC_PUSH_NOW;
}

test the_push_runs_tri_land_once_on_a_branch_at_the_batch_s_last_link {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var buf : [4096]u8 = [0] ** 4096;
    const r : GolReq = rq(V_PUSH, false, 0);
    assert next_slot(r, "", &wo, &wp) == slot_of(G_HEAD, 0);
    assert next_slot(r, EV_P_FIRST, &wo, &wp) == slot_of(P_BRANCH, 0);
    assert next_slot(r, EV_P_BRANCHED, &wo, &wp) == slot_of(P_LAND, 0);
    assert next_slot(r, EV_P_LANDED, &wo, &wp) == slot_of(P_MARK, 0);
    // nothing waiting, or not yet due: no push
    assert next_slot(r, EV_P_NONE, &wo, &wp) == DONE;
    assert next_slot(rq(V_PUSH, false, 250), EV_P_20, &wo, &wp) == DONE;
    // a plan reads the state and runs none of the three
    assert next_slot(rq(V_PUSH, true, 0), EV_P_FIRST, &wo, &wp) == DONE;
    // the batch is the first eight links: the branch is cut at the eighth
    assert argv_is(r, EV_P_TEN, P_BRANCH, 0, "git\nbranch\n-f\nclaude/golden-1717171717\n1717171717171717171717171717171717171717\n", &buf, &wo, &wp);
    assert argv_is(r, EV_P_TEN, P_LAND, 0, "/tmp/tri\nland\nclaude/golden-1717171717\n--issue\n11275\n", &buf, &wo, &wp);
    assert argv_is(r, EV_P_FIRST, P_BRANCH, 0, "git\nbranch\n-f\nclaude/golden-1212121212\n1212121212121212121212121212121212121212\n", &buf, &wo, &wp);
}

test negative_control_a_refused_land_does_not_move_the_pushed_ref {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    const r : GolReq = rq(V_PUSH, false, 0);
    assert judge(r, EV_P_REFUSED, P_LAND, 0) == C_LAND_REFUSED;
    assert next_slot(r, EV_P_REFUSED, &wo, &wp) == DONE;
    assert judge(r, EV_P_LANDED, P_LAND, 0) == C_OK;
}

test the_push_state_steps_pin_their_bytes {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var buf : [4096]u8 = [0] ** 4096;
    const r : GolReq = rq(V_PUSH, false, ABSENT);
    assert argv_is(r, EV_P_FIRST, P_PUSHED, 0, "git\nrev-parse\n--verify\n-q\nrefs/golden/pushed\n", &buf, &wo, &wp);
    assert argv_is(r, EV_P_FIRST, P_AHEAD, 0, "git\nrev-list\n--first-parent\n--reverse\na1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1..d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4\n", &buf, &wo, &wp);
    assert argv_is(r, EV_P_20, P_AHEAD, 0, "git\nrev-list\n--first-parent\n--reverse\na1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1..d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4\n", &buf, &wo, &wp);
    assert argv_is(r, "", P_STAMP, 0, "git\nreflog\nshow\n--format=%ct\n-n\n1\nrefs/golden/pushed\n", &buf, &wo, &wp);
    assert argv_is(r, "", P_NOW, 0, "date\n+%s\n", &buf, &wo, &wp);
    assert argv_is(r, "", P_QUEUED, 0, "gh\nrun\nlist\n--status\nqueued\n--limit\n300\n--json\ndatabaseId\n", &buf, &wo, &wp);
    assert argv_is(r, EV_P_FIRST, P_MARK, 0, "git\nupdate-ref\n--create-reflog\nrefs/golden/pushed\n1212121212121212121212121212121212121212\n0000000000000000000000000000000000000000\n", &buf, &wo, &wp);
    assert argv_is(r, EV_P_20, P_MARK, 0, "git\nupdate-ref\n--create-reflog\nrefs/golden/pushed\n1212121212121212121212121212121212121212\na1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\n", &buf, &wo, &wp);
    assert argv_is(r, "", G_PRUNE, 0, "git\nworktree\nprune\n", &buf, &wo, &wp);
}

test the_report_says_what_a_plan_would_do {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var out : [2048]u8 = [0] ** 2048;
    const n : usize = report(rq(V_LAND, true, ABSENT), EV_PLAN_K1, C_OK, &out, &wo, &wp, &wt);
    const want : string = "golden head: none (base a1a1a1a1a1a1)\nqueue: 2\nclaude/evolve-a ppppp FORWARD\nclaude/evolve-b ppppp CARRIED\nlanded: 2 of 2\n  would run: git update-ref refs/golden/head b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2 0000000000000000000000000000000000000000\n  would run: git update-ref refs/golden/head e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5 b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\n";
    assert n == want.len and buf_is(&out, n, want);
    const m : usize = report(rq(V_LAND, false, ABSENT), EV_NOBASE, C_NO_BASE, &out, &wo, &wp, &wt);
    assert buf_is(&out, m, "refused: NO_BASE: refs/remotes/origin/master is missing: git fetch origin master\n");
}

test the_status_says_when_the_next_push_is_due {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var out : [2048]u8 = [0] ** 2048;
    const n : usize = report(rq(V_STATUS, false, 250), EV_P_20, C_OK, &out, &wo, &wp, &wt);
    const want : string = "golden head: d4d4d4d4d4d4\npushed: a1a1a1a1a1a1\nunpushed links: 3 (batch 3, cap 8)\nminutes since the last push: 20\nactions queued: 250\nnext push: WAIT 10 more minute(s)\nqueue:\n";
    assert n == want.len and buf_is(&out, n, want);
    const m : usize = report(rq(V_STATUS, false, 0), EV_P_NONE, C_OK, &out, &wo, &wp, &wt);
    assert buf_is(&out, 0, "") and m > 0;
}

test the_worst_case_fits {
    var wo : [16]u8 = [0] ** 16;
    var wp : [16]usize = [0] ** 16;
    var wt : [1024]u8 = [0] ** 1024;
    var buf : [4096]u8 = [0] ** 4096;
    const r : GolReq = GolReq { verb: V_LAND, plan: false, queued: ABSENT, issue: 999999999, scratch: "/tmp/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", t27b: "t27b", t27c: "t27c", tri: "/tmp/tri" };
    var k : u8 = 0;
    while (k < GL_STEPS) {
        const m : usize = step_argv(r, EV_K1, k, 1, &buf, &wo, &wp);
        assert m < 600;
        k = k + 1;
    }
    assert CMD_MAX == 4096;
}
