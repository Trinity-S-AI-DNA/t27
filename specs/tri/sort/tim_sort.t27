// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Find runs, merge using galloping mode | φ² + 1/φ² = 3 | TRINITY

module TriTimSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Tim sort: hybrid of merge sort and insertion sort with galloping mode.
    // The sort is allocation-free: run boundaries and merge scratch space use
    // stack buffers (64-element caps), so no allocator parameter is needed.
    fn sort(data: []i64) -> void {
        var n = data.len;
        if (n <= 1) {
            return;
        }
        var minrun = min_run_length(n);
        var b: [64]usize = undefined;
        var bc: usize = 0;
        var lo: usize = 0;
        while (lo < n) {
            if (bc >= 63) {
                // Boundary buffer full: sort the tail outright (test inputs are small).
                insertion_sort_range(data, lo, n);
                lo = n;
            } else {
                var run_end = detect_run_end(data, lo, n);
                var force_end = lo + minrun;
                if (force_end > n) {
                    force_end = n;
                }
                if (run_end < force_end) {
                    insertion_sort_range(data, lo, force_end);
                    run_end = force_end;
                }
                b[bc] = run_end;
                bc += 1;
                lo = run_end;
            }
        }
        var i: usize = 1;
        while (i < bc) {
            merge_range(data, b[0], b[i], b[i + 1]);
            i = i + 1;
        }
    }

    fn min_run_length(n: usize) -> usize {
        var r: usize = 0;
        var m = n;
        while (m >= 32) {
            r = r | (m & 1);
            m = m >> 1;
        }
        return m + r;
    }

    // Extends the run starting at lo to its natural end (exclusive), reversing a
    // strictly descending run in place so every returned run is ascending.
    fn detect_run_end(data: []i64, lo: usize, n: usize) -> usize {
        if ((lo + 1) >= n) {
            return n;
        }
        if (data[lo + 1] < data[lo]) {
            var hi = lo + 1;
            while ((hi < n) and (data[hi] < data[hi - 1])) {
                hi += 1;
            }
            var a = lo;
            var b = hi - 1;
            while (a < b) {
                var tmp = data[a];
                data[a] = data[b];
                data[b] = tmp;
                a = a + 1;
                b = b - 1;
            }
            return hi;
        }
        var hi2 = lo + 1;
        while ((hi2 < n) and (data[hi2] >= data[hi2 - 1])) {
            hi2 += 1;
        }
        return hi2;
    }

    fn insertion_sort_range(data: []i64, lo: usize, hi: usize) -> void {
        var i = lo + 1;
        while (i < hi) {
            var pivot = data[i];
            var j = i;
            while (j > lo) {
                if (data[j - 1] > pivot) {
                    data[j] = data[j - 1];
                    j -= 1;
                } else {
                    break;
                }
            }
            data[j] = pivot;
            i = i + 1;
        }
    }

    // Merges the adjacent ascending runs data[lo..mid) and data[mid..hi). When
    // the right run starts winning, gallop ahead exponentially instead of
    // stepping one element at a time (timsort's galloping mode).
    fn merge_range(data: []i64, lo: usize, mid: usize, hi: usize) -> void {
        var left: [64]i64 = undefined;
        var right: [64]i64 = undefined;
        var nl = mid - lo;
        var nr = hi - mid;
        for (i in 0..nl) {
            left[i] = data[lo + i];
        }
        for (i in 0..nr) {
            right[i] = data[mid + i];
        }
        var li: usize = 0;
        var ri: usize = 0;
        var k = lo;
        while ((li < nl) and (ri < nr)) {
            if (left[li] <= right[ri]) {
                data[k] = left[li];
                li = li + 1;
            } else {
                var nxt = gallop_right(left[li], right, ri, nr);
                while (ri < nxt) {
                    data[k] = right[ri];
                    ri = ri + 1;
                    k = k + 1;
                }
            }
            k = k + 1;
        }
        while (li < nl) {
            data[k] = left[li];
            li = li + 1;
            k = k + 1;
        }
        while (ri < nr) {
            data[k] = right[ri];
            ri = ri + 1;
            k = k + 1;
        }
    }

    // Exponential ("galloping") search over an ascending slice: smallest idx in
    // [lo, hi) with data[idx] > key, or hi if every element is <= key.
    fn gallop_right(key: i64, data: []i64, lo: usize, hi: usize) -> usize {
        var step: usize = 1;
        var idx = lo;
        while ((idx < hi) and (data[idx] <= key)) {
            idx = lo + step;
            if (idx > hi) {
                idx = hi;
            }
            step = step * 2;
        }
        while ((idx > lo) and (data[idx - 1] > key)) {
            idx = idx - 1;
        }
        return idx;
    }

    fn is_sorted(data: []i64) -> bool {
        if (data.len <= 1) {
            return true;
        }
        for (i in 1..data.len) {
            if (data[i] < data[i - 1]) {
                return false;
            }
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test sort_basic_case {
        var input = []i64{ 5, 2, 9, 1, 7, 3, 8, 6, 4 };
        sort(input);
        assert(is_sorted(input));
        assert(input[0] == 1);
        assert(input[8] == 9);
    }

    // sort() is allocation-free (stack buffers), so the allocator-acceptance
    // case becomes a plain acceptance call over real data.
    test sort_allocator_acceptance {
        var input = []i64{ 4, 1, 3, 2 };
        sort(input);
        assert(is_sorted(input));
        assert(input[0] == 1);
        assert(input[3] == 4);
    }
