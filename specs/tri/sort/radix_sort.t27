// t27/specs/
// Least significant digit first | φ² + 1/φ² = 3 | TRINITY

module TriRadixSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const RadixSorter = struct {
        base : "usize",
        max_digits : "usize",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Helper Functions
    // ═══════════════════════════════════════════════════════════

    // find_max(data: []usize) → usize
    fn find_max(data: []usize) -> usize {
        var max : usize = 0;
        for (i in 0..data.len()) {
            if (data[i] > max) {
                max = data[i];
            }
        }
        return max;
    }

    // counting_sort_by_digit(data: []usize, output: []usize, exp: usize) → void
    // Stable counting sort of data on the decimal digit selected by exp
    // (1, 10, 100, ...); output is a caller-provided buffer of data.len slots.
    fn counting_sort_by_digit(data: []usize, output: []usize, exp: usize) -> void {
        var count : [10]usize = [0] ** 10;

        // Store count of occurrences in count[]
        for (i in 0..data.len()) {
            let index = (data[i] / exp) % 10;
            count[index] += 1;
        }

        // Change count[i] so that count[i] contains actual
        // position of this digit in output[]
        for (i in 1..10) {
            count[i] += count[i - 1];
        }

        // Build the output array, walking backwards to keep the sort stable
        var i : usize = data.len();
        while (i > 0) {
            let index = (data[i - 1] / exp) % 10;
            output[count[index] - 1] = data[i - 1];
            count[index] -= 1;
            i -= 1;
        }

        // Copy the output array to data[]
        for (k in 0..data.len()) {
            data[k] = output[k];
        }
    }

    // radix_exchange(data: []usize, lo: usize, hi: usize, mask: usize) → void
    // In-place binary radix sort of data[lo..hi): split the range on the bit
    // given by mask (a power of two) by swapping from both ends, then recurse
    // on both halves with the next lower bit.
    fn radix_exchange(data: []usize, lo: usize, hi: usize, mask: usize) -> void {
        if (hi <= lo + 1 or mask == 0) {
            return;
        }
        var i : usize = lo;
        var j : usize = hi;
        while (i < j) {
            if ((data[i] / mask) % 2 == 0) {
                i = i + 1;
            } else {
                j = j - 1;
                let temp = data[i];
                data[i] = data[j];
                data[j] = temp;
            }
        }
        radix_exchange(data, lo, i, mask / 2);
        radix_exchange(data, i, hi, mask / 2);
    }

    // ═══════════════════════════════════════════════════════════
    // 4. Core Functions
    // ═══════════════════════════════════════════════════════════

    // sort(data: []usize, output: []usize) → void
    // LSD radix sort (base 10); output is a caller-provided buffer of
    // data.len slots that replaces the allocator of the original sketch.
    fn sort(data: []usize, output: []usize) -> void {
        if (data.len() <= 1) {
            return;
        }
        let max_value = find_max(data);
        var exp : usize = 1;

        while (max_value / exp > 0) {
            counting_sort_by_digit(data, output, exp);
            exp *= 10;
        }
    }

    // sort_in_place(data: []usize) → void
    // Needs no extra buffer: binary radix exchange from the top bit down.
    fn sort_in_place(data: []usize) -> void {
        if (data.len() <= 1) {
            return;
        }
        let max_value = find_max(data);
        var mask : usize = 1;
        while (mask * 2 <= max_value) {
            mask *= 2;
        }
        radix_exchange(data, 0, data.len(), mask);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test sort_basic_case {
        var input = []usize{42, 17, 99, 8, 23, 56, 31, 4};
        var buf = []usize{0, 0, 0, 0, 0, 0, 0, 0};
        sort(input, buf);
        assert(input[0] == 4);
        assert(input[1] == 8);
        assert(input[2] == 17);
        assert(input[3] == 23);
        assert(input[4] == 31);
        assert(input[5] == 42);
        assert(input[6] == 56);
        assert(input[7] == 99);
    }

    test sort_in_place_basic_case {
        var input = []usize{42, 17, 99, 8, 23, 56, 31, 4};
        sort_in_place(input);
        assert(input[0] == 4);
        assert(input[1] == 8);
        assert(input[2] == 17);
        assert(input[3] == 23);
        assert(input[4] == 31);
        assert(input[5] == 42);
        assert(input[6] == 56);
        assert(input[7] == 99);
    }

    // length after sorting: a runtime value, unlike input.len()
    fn sorted_len(data: []usize, output: []usize) -> usize {
        sort(data, output);
        return data.len();
    }

    fn sorted_in_place_len(data: []usize) -> usize {
        sort_in_place(data);
        return data.len();
    }

    test sort_empty_case {
        var input = []usize{};
        var buf = []usize{};
        assert(sorted_len(input, buf) == 0);
    }

    test sort_in_place_empty_case {
        var input = []usize{};
        assert(sorted_in_place_len(input) == 0);
    }

    test sort_single_element_case {
        var input = []usize{42};
        var buf = []usize{0};
        sort(input, buf);
        assert(input[0] == 42);
    }

    test sort_in_place_single_element_case {
        var input = []usize{42};
        sort_in_place(input);
        assert(input[0] == 42);
    }

    test sort_already_sorted_case {
        var input = []usize{1, 2, 3, 4, 5, 6, 7, 8};
        var buf = []usize{0, 0, 0, 0, 0, 0, 0, 0};
        sort(input, buf);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
        assert(input[5] == 6);
        assert(input[6] == 7);
        assert(input[7] == 8);
    }

    test sort_in_place_already_sorted_case {
        var input = []usize{1, 2, 3, 4, 5, 6, 7, 8};
        sort_in_place(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
        assert(input[5] == 6);
        assert(input[6] == 7);
        assert(input[7] == 8);
    }

    test sort_reverse_sorted_case {
        var input = []usize{8, 7, 6, 5, 4, 3, 2, 1};
        var buf = []usize{0, 0, 0, 0, 0, 0, 0, 0};
        sort(input, buf);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
        assert(input[5] == 6);
        assert(input[6] == 7);
        assert(input[7] == 8);
    }

    test sort_in_place_reverse_sorted_case {
        var input = []usize{8, 7, 6, 5, 4, 3, 2, 1};
        sort_in_place(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
        assert(input[5] == 6);
        assert(input[6] == 7);
        assert(input[7] == 8);
    }

    // duplicates and values spanning several digits
    test sort_with_duplicates_case {
        var input = []usize{305, 7, 305, 0, 1200, 7, 99};
        var buf = []usize{0, 0, 0, 0, 0, 0, 0};
        sort(input, buf);
        assert(input[0] == 0);
        assert(input[1] == 7);
        assert(input[2] == 7);
        assert(input[3] == 99);
        assert(input[4] == 305);
        assert(input[5] == 305);
        assert(input[6] == 1200);
    }

    test sort_in_place_with_duplicates_case {
        var input = []usize{305, 7, 305, 0, 1200, 7, 99};
        sort_in_place(input);
        assert(input[0] == 0);
        assert(input[1] == 7);
        assert(input[2] == 7);
        assert(input[3] == 99);
        assert(input[4] == 305);
        assert(input[5] == 305);
        assert(input[6] == 1200);
    }
