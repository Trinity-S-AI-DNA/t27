// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Use last element as pivot | φ² + 1/φ² = 3 | TRINITY

module TriQuickSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // swap(values: []i64, i: usize, j: usize) → void
    fn swap(values: []i64, i: usize, j: usize) -> void {
        let temp = values[i];
        values[i] = values[j];
        values[j] = temp;
    }

    // sort_range(values: []i64, lo: usize, hi: usize) → void
    // Sorts values[lo..hi) in place. The last element of the range is the
    // pivot (Lomuto partition); no sub-arrays are allocated.
    fn sort_range(values: []i64, lo: usize, hi: usize) -> void {
        if (hi <= lo + 1) {
            return;
        }

        let pivot = values[hi - 1];
        var store : usize = lo;
        for (i in lo..hi - 1) {
            if (values[i] <= pivot) {
                swap(values, i, store);
                store = store + 1;
            }
        }
        // Put the pivot between the two parts
        swap(values, store, hi - 1);

        // Recursively sort the parts on each side of the pivot
        sort_range(values, lo, store);
        sort_range(values, store + 1, hi);
    }

    // sort(values: []i64) → void
    fn sort(values: []i64) -> void {
        sort_range(values, 0, values.len());
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // length of the array after sorting it (a runtime value, unlike input.len())
    fn sorted_len(values: []i64) -> usize {
        sort(values);
        return values.len();
    }

    fn sorted_range_len(values: []i64) -> usize {
        sort_range(values, 0, values.len());
        return values.len();
    }

    test sort_empty_array {
        var input = []i64{};
        assert(sorted_len(input) == 0);
    }

    test sort_single_element {
        var input = []i64{42};
        sort(input);
        assert(input.len() == 1);
        assert(input[0] == 42);
    }

    test sort_already_sorted {
        var input = []i64{1, 2, 3, 4, 5};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
    }

    test sort_reverse_sorted {
        var input = []i64{5, 4, 3, 2, 1};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
    }

    test sort_random_order {
        var input = []i64{3, 1, 4, 1, 5, 9, 2, 6};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 1);
        assert(input[2] == 2);
        assert(input[3] == 3);
        assert(input[4] == 4);
        assert(input[5] == 5);
        assert(input[6] == 6);
        assert(input[7] == 9);
    }

    test sort_range_empty_array {
        var input = []i64{};
        assert(sorted_range_len(input) == 0);
    }

    test sort_range_single_element {
        var input = []i64{42};
        sort_range(input, 0, 1);
        assert(input[0] == 42);
    }

    // only the middle three slots are in the range; the ends stay put
    test sort_range_leaves_outside_untouched {
        var input = []i64{9, 5, 2, 4, 0};
        sort_range(input, 1, 4);
        assert(input[0] == 9);
        assert(input[1] == 2);
        assert(input[2] == 4);
        assert(input[3] == 5);
        assert(input[4] == 0);
    }

    test "sort function implementation" {
        var input = []i64{3, 1, 4, 1, 5};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 1);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
    }

    test "sort_range function implementation" {
        var input = []i64{5, 2, 4, 1, 3};
        sort_range(input, 0, 5);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
    }

    test "swap function swaps two elements" {
        var input = []i64{1, 2, 3, 4, 5};
        swap(input, 1, 3);
        assert(input[0] == 1);
        assert(input[1] == 4);
        assert(input[2] == 3);
        assert(input[3] == 2);
        assert(input[4] == 5);
    }
