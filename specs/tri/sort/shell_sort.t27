// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Sort elements at gap distance, reduce gap | φ² + 1/φ² = 3 | TRINITY

module TriShellSort;
    use base::types;
    use math::constants;

    // ══════════════════════════════════════════════════════════════
    // 3. Core Functions
    // ══════════════════════════════════════════════════════════════

    // sort(values: []i64) → void
    // T27 slices cannot grow, so the (3^k - 1)/2 gap sequence — 1, 4, 13, 40, ...
    // — is collected into a fixed 32-slot stack buffer before sorting.
    fn sort(values: []i64) -> void {
        var n = values.len;
        if (n <= 1) {
            return;
        }

        var gaps: [32]usize = undefined;
        var count: usize = 0;
        var gap: usize = 1;
        while (gap < n) {
            gaps[count] = gap;
            count += 1;
            gap = 3 * gap + 1;
        }

        // Start from the largest gap and work down to 1
        var gi = count;
        while (gi > 0) {
            gi -= 1;
            var g = gaps[gi];
            // Insertion sort for this gap
            var j = g;
            while (j < n) {
                var temp = values[j];
                var k = j;
                while (k >= g) {
                    if (values[k - g] > temp) {
                        values[k] = values[k - g];
                        k = k - g;
                    } else {
                        break;
                    }
                }
                values[k] = temp;
                j = j + 1;
            }
        }
    }

    fn is_sorted(values: []i64) -> bool {
        if (values.len <= 1) {
            return true;
        }
        for (i in 1..values.len) {
            if (values[i] < values[i - 1]) {
                return false;
            }
        }
        return true;
    }

    // ══════════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ══════════════════════════════════════════════════════════════

    // was: given input = default_input(), when result = sort(input),
    //      then result != undefined  (sort runs to completion and mutates in place)
    test sort_basic_case {
        var input = []i64{ 12, 34, 54, 2, 3 };
        sort(input);
        assert(is_sorted(input));
        assert(input[0] == 2);
    }

    // was: given input = [5, 2, 3, 1, 4], when sort(input), then input == [1, 2, 3, 4, 5]
    test sort_another_case {
        var input = []i64{ 5, 2, 3, 1, 4 };
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
        assert(is_sorted(input));
    }
