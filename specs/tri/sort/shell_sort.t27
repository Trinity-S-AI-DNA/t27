// t27/specs/
// Sort elements at gap distance, reduce gap | φ² + 1/φ² = 3 | TRINITY

module TriShellSort;
     use base::types;
     use math::constants;

     // ══════════════════════════════════════════════════════════════
     // 3. Core Functions
     // ══════════════════════════════════════════════════════════════

     // sort(values: []i64) → void
     fn sort(values: []i64) -> void {
         let n = values.len();
         if (n <= 1) {
             return;
         }

         // Largest gap of the sequence 1, 4, 13, 40, ... (gap' = 3 * gap + 1)
         // that is still below n; it is divided back down to 1 below.
         var gap : usize = 1;
         while (gap * 3 + 1 < n) {
             gap = gap * 3 + 1;
         }

         // Start from the largest gap and work down to 1
         while (gap > 0) {
             // Insertion sort for this gap
             for (j in gap..n) {
                 let temp = values[j];
                 var k = j;
                 while (k >= gap && values[k - gap] > temp) {
                     values[k] = values[k - gap];
                     k = k - gap;
                 }
                 values[k] = temp;
             }
             gap = (gap - 1) / 3;
         }
     }

     // ══════════════════════════════════════════════════════════════
     // TDD: Tests (from .tri behaviors)
     // ══════════════════════════════════════════════════════════════

     // 14 elements, so the gaps used are 13, 4 and 1
     test sort_basic_case {
         var input = []i64{9, -3, 14, 0, 5, 5, -8, 2, 7, 1, 12, -1, 6, 3};
         sort(input);
         assert(input[0] == -8);
         assert(input[1] == -3);
         assert(input[2] == -1);
         assert(input[3] == 0);
         assert(input[4] == 1);
         assert(input[5] == 2);
         assert(input[6] == 3);
         assert(input[7] == 5);
         assert(input[8] == 5);
         assert(input[9] == 6);
         assert(input[10] == 7);
         assert(input[11] == 9);
         assert(input[12] == 12);
         assert(input[13] == 14);
     }

     test sort_another_case {
         var input = []i64{5, 2, 3, 1, 4};
         sort(input);
         assert(input[0] == 1);
         assert(input[1] == 2);
         assert(input[2] == 3);
         assert(input[3] == 4);
         assert(input[4] == 5);
     }

     test sort_single_element {
         var input = []i64{42};
         sort(input);
         assert(input[0] == 42);
     }
