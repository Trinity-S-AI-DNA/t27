// t27/specs/
// Stable sort | φ² + 1/φ² = 3 | TRINITY

module TriSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SortOrder = enum(u8) {
        Ascending,
        Descending,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // sort(items: []i64) -> void
    // Stable ascending sort: insertion sort moves an element only past
    // strictly greater ones, so equal elements keep their order.
    fn sort(items: []i64) -> void {
        let n = items.len();
        if (n <= 1) {
            return;
        }
        for (i in 1..n) {
            let key = items[i];
            var j = i;
            while (j > 0 && items[j - 1] > key) {
                items[j] = items[j - 1];
                j = j - 1;
            }
            items[j] = key;
        }
    }

    // sort_by(items: []i64, order: SortOrder) -> void
    // Stable sort in the requested direction.
    fn sort_by(items: []i64, order: SortOrder) -> void {
        let n = items.len();
        if (n <= 1) {
            return;
        }
        for (i in 1..n) {
            let key = items[i];
            var j = i;
            if (order == SortOrder.Ascending) {
                while (j > 0 && items[j - 1] > key) {
                    items[j] = items[j - 1];
                    j = j - 1;
                }
            } else {
                while (j > 0 && items[j - 1] < key) {
                    items[j] = items[j - 1];
                    j = j - 1;
                }
            }
            items[j] = key;
        }
    }

    // Helper functions commented out for debugging
    // fn merge_sort(items: []T, order: SortOrder, allocator: std.mem.Allocator) void { /* ... */ }
    // fn merge_sort_by(items: []T, key_fn: fn(T) -> ?Order, allocator: std.mem.Allocator) void { /* ... */ }
    // fn merge(dest: []T, left: []const T, right: []const T, order: SortOrder, allocator: std.mem.Allocator) void { /* ... */ }
    // fn merge_by(dest: []T, left: []const T, right: []const T, key_fn: fn(T) -> ?Order, allocator: std.mem.Allocator) void { /* ... */ }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test sort_basic_case {
        var input = []i64{3, 1, 2, 1, -4, 7};
        sort(input);
        assert(input[0] == -4);
        assert(input[1] == 1);
        assert(input[2] == 1);
        assert(input[3] == 2);
        assert(input[4] == 3);
        assert(input[5] == 7);
    }

    test sort_by_basic_case {
        var input = []i64{3, 1, 2, 1, -4, 7};
        sort_by(input, SortOrder.Descending);
        assert(input[0] == 7);
        assert(input[1] == 3);
        assert(input[2] == 2);
        assert(input[3] == 1);
        assert(input[4] == 1);
        assert(input[5] == -4);
    }

    fn order_value(order: SortOrder) -> u8 {
        return @intFromEnum(order);
    }

    test sort_order_is_an_enum_whose_two_directions_are_alternatives {
        assert(order_value(SortOrder.Ascending) == 0);
        assert(order_value(SortOrder.Descending) == 1);
    }
