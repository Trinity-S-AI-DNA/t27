// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Build max heap, then extract max repeatedly | φ² + 1/φ² = 3 | TRINITY

module TriHeapSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // sort(values: []i64) → void
    fn sort(values: []i64) -> void {
        let n = values.len();
        if (n <= 1) {
            return;
        }

        // Build max heap. i counts down over the internal nodes n/2 - 1 .. 0;
        // the index is decremented first so the unsigned counter never
        // goes below zero.
        var i : usize = n / 2;
        while (i > 0) {
            i = i - 1;
            heapify(values, n, i);
        }

        // Extract elements from heap one by one
        i = n - 1;
        while (i > 0) {
            // Move current root to end
            let temp = values[0];
            values[0] = values[i];
            values[i] = temp;

            // Call heapify on the reduced heap
            heapify(values, i, 0);

            i = i - 1;
        }
    }

    // heapify(arr: []i64, heap_size: usize, root: usize) → void
    fn heapify(arr: []i64, heap_size: usize, root: usize) -> void {
        var largest = root;
        var left = 2 * root + 1;
        var right = 2 * root + 2;
        
        // If left child is larger than root
        if (left < heap_size and arr[left] > arr[largest]) {
            largest = left;
        }
        
        // If right child is larger than largest so far
        if (right < heap_size and arr[right] > arr[largest]) {
            largest = right;
        }
        
        // If largest is not root
        if (largest != root) {
            // Swap root with largest
            let temp = arr[root];
            arr[root] = arr[largest];
            arr[largest] = temp;
            
            // Recursively heapify the affected sub-tree
            heapify(arr, heap_size, largest);
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test sort_basic_case {
        var input = []i64{3, 1, 2, 1, -4, 7};
        sort(input);
        assert(input[0] == -4);
        assert(input[1] == 1);
        assert(input[2] == 1);
        assert(input[3] == 2);
        assert(input[4] == 3);
        assert(input[5] == 7);
    }

    // The old expectation [1, 2, 5, 1, 5, 6] is not even sorted: the sorted
    // permutation of (5, 2, 9, 1, 5, 6) is (1, 2, 5, 5, 6, 9).
    test sort_sorts_correctly {
        var input = []i64{5, 2, 9, 1, 5, 6};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 5);
        assert(input[3] == 5);
        assert(input[4] == 6);
        assert(input[5] == 9);
    }

    test sort_single_element {
        var input = []i64{42};
        sort(input);
        assert(input[0] == 42);
    }
