// SPDX-License-Identifier: Apache-2.0
; specs/tri/cooperate/framework.t27 -- the dispatcher of the three cooperation variants (Refs #10486)
; Owner rule 2026-10-27: three variants (A autonomous, B hybrid, C human-decided), all in t27, all
; accelerated by the Pareto rules of specs/tri/mutate/speedup.t27. This spec picks the variant and
; moves between them as the facts change; it decides nothing a variant already decides.
;   Selection. No humans reachable and standard quality -> A. Humans reachable and high quality ->
;   B. Anything else -> C, the safe default: it never decides on its own.
;   Meta-acceleration. After a run, the dispatcher moves along the measured facts, in one direction
;   at a time: a dry A run (nothing accepted in three cycles) climbs to B; a review wait over the
;   budget drops to C; a C batch whose packages all matched the gate climbs to B. The switches are
;   ordered A -> B -> C and C -> B -> A is refused: autonomy is earned by evidence, never assumed.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriCooperateFramework;

use tri::cooperate::variant_a;
use tri::cooperate::variant_b;
use tri::cooperate::variant_c;

// Human availability, as the caller reports it.
pub const FW_HUMANS_NONE : u8 = 0;
pub const FW_HUMANS_LIMITED : u8 = 1;
pub const FW_HUMANS_READY : u8 = 2;

// Quality requirement of the batch.
pub const FW_QUALITY_STANDARD : u8 = 0;
pub const FW_QUALITY_HIGH : u8 = 1;

// The chosen variant; the values name the spec that runs it.
pub const FW_VARIANT_A : u8 = 0;
pub const FW_VARIANT_B : u8 = 1;
pub const FW_VARIANT_C : u8 = 2;

pub const FW_KEEP : u8 = 0;
pub const FW_MOVE : u8 = 1;

/// The review wait budget of variant B, in minutes; over it, the batch drops to C. Measured, not
/// guessed: the acceptance demo of #10486 waited 40 minutes on one review.
pub const FW_REVIEW_BUDGET_MIN : u64 = 30;

/// Selection: A only when no human is reachable and the batch is standard; B when humans are
/// reachable and the batch is high quality; C is every other answer, the safe default.
pub fn select_variant(humans: u8, quality: u8) -> u8 {
    if (humans == FW_HUMANS_NONE and quality == FW_QUALITY_STANDARD) { return FW_VARIANT_A; }
    if (humans == FW_HUMANS_READY and quality == FW_QUALITY_HIGH) { return FW_VARIANT_B; }
    return FW_VARIANT_C;
}

/// One meta-move after a run. `dry_a` is variant A having accepted nothing in three cycles;
/// `review_wait_min` is the longest a B review waited; `c_matched` is a C batch whose every decision
/// matched the gate. Only A -> B and B -> C and C -> B exist; C never drops to A in one move.
pub fn meta_move(current: u8, dry_a: bool, review_wait_min: u64, c_matched: bool) -> u8 {
    if (current == FW_VARIANT_A and dry_a) { return FW_VARIANT_B; }
    if (current == FW_VARIANT_B and review_wait_min > FW_REVIEW_BUDGET_MIN) { return FW_VARIANT_C; }
    if (current == FW_VARIANT_C and c_matched) { return FW_VARIANT_B; }
    return current;
}

/// Does the meta-move change anything? A move to the same variant is not a move.
pub fn move_kind(before: u8, after: u8) -> u8 {
    if (before == after) { return FW_KEEP; }
    return FW_MOVE;
}

invariant f_a_only_fully_unattended_standard { assert select_variant(FW_HUMANS_NONE, FW_QUALITY_STANDARD) == FW_VARIANT_A and select_variant(FW_HUMANS_NONE, FW_QUALITY_HIGH) == FW_VARIANT_C and select_variant(FW_HUMANS_READY, FW_QUALITY_STANDARD) == FW_VARIANT_C; }
invariant f_b_needs_humans_and_high_quality { assert select_variant(FW_HUMANS_READY, FW_QUALITY_HIGH) == FW_VARIANT_B and select_variant(FW_HUMANS_LIMITED, FW_QUALITY_HIGH) == FW_VARIANT_C; }
invariant f_meta_never_drops_c_to_a { assert meta_move(FW_VARIANT_C, true, 0, false) == FW_VARIANT_C and meta_move(FW_VARIANT_C, true, 0, true) == FW_VARIANT_B; }
invariant f_a_dry_run_climbs_to_b { assert meta_move(FW_VARIANT_A, true, 0, false) == FW_VARIANT_B and meta_move(FW_VARIANT_A, false, 0, false) == FW_VARIANT_A; }
invariant f_a_review_over_budget_drops_to_c { assert meta_move(FW_VARIANT_B, false, FW_REVIEW_BUDGET_MIN, false) == FW_VARIANT_B and meta_move(FW_VARIANT_B, false, FW_REVIEW_BUDGET_MIN + 1, false) == FW_VARIANT_C; }

// Scenario: the analog loop ran overnight, no human reachable, standard batch -- it ran as A.
test f_selection_sends_the_overnight_loop_to_a {
    assert select_variant(FW_HUMANS_NONE, FW_QUALITY_STANDARD) == FW_VARIANT_A;
}

// Scenario: the acceptance demo of #10486 -- humans reachable, high quality, so B; the demo's review
// waited 40 minutes, over the 30-minute budget, so the next batch drops to C.
test f_the_acceptance_demo_route_is_b_then_c {
    assert select_variant(FW_HUMANS_READY, FW_QUALITY_HIGH) == FW_VARIANT_B;
    assert meta_move(FW_VARIANT_B, false, 40, false) == FW_VARIANT_C;
    assert move_kind(FW_VARIANT_B, FW_VARIANT_C) == FW_MOVE;
}

// Negative control: a C batch is refused a direct drop to A, however well it matched -- autonomy
// is earned one rung at a time, C -> B -> A, never C -> A in one move.
test f_is_refused_a_direct_move_from_c_to_a {
    assert meta_move(FW_VARIANT_C, true, 0, true) == FW_VARIANT_B;
    assert meta_move(FW_VARIANT_C, true, 0, true) != FW_VARIANT_A;
}
