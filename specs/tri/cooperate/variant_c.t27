// SPDX-License-Identifier: Apache-2.0
; specs/tri/cooperate/variant_c.t27 -- cooperation variant C: humans decide, the machine speeds (Refs #10486)
; Variant C keeps every accept/reject decision with a human. The machine takes all the waiting out:
; iteration runs under P1 and P3 (delta gate, clock rerun, specs/tri/mutate/speedup.t27), the decision
; package is built so the human sees one screen, and landing still goes through P2 once the human's
; decisions match what the gate expected. A decision may be APPROVE, REJECT or ESCALATE; ESCALATE
; sends the mutant back with a new package instead of deciding it, so nothing is accepted twice and
; nothing is lost. Imported names are used unqualified, the house style of seal_identity.t27.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriCooperateVariantC;

use tri::mutate::speedup;

// The human's three possible answers to a decision package.
pub const VC_APPROVE : u8 = 0;
pub const VC_REJECT : u8 = 1;
pub const VC_ESCALATE : u8 = 2;

// What the machine records after the answer.
pub const VC_APPLIED : u8 = 0;
pub const VC_RETURNED : u8 = 1;

// Package readiness: a package without every field is not shown to a human.
pub const VC_PACKAGE_INCOMPLETE : u8 = 0;
pub const VC_PACKAGE_READY : u8 = 1;

/// A decision package is shown only when all five of its fields carry a value.
pub fn package_ready(has_change: bool, has_risk: bool, has_impact: bool, has_visual: bool, has_alternatives: bool) -> u8 {
    if (has_change and has_risk and has_impact and has_visual and has_alternatives) { return VC_PACKAGE_READY; }
    return VC_PACKAGE_INCOMPLETE;
}

/// One human answer becomes one recorded outcome; ESCALATE returns the mutant for a new package.
pub fn apply_decision(decision: u8) -> u8 {
    if (decision == VC_APPROVE) { return VC_APPLIED; }
    if (decision == VC_REJECT) { return VC_APPLIED; }
    return VC_RETURNED;
}

/// Landing of variant C: with the decisions recorded and nothing critical moved, P2 skips the second
/// gate; anything else confirms in full before the merge.
pub fn landing(all_decided: bool, first_gate_matched: bool, critical_changed: bool) -> u8 {
    if (all_decided == false) { return P2_RUN_CONFIRMATION; }
    return p2_landing(first_gate_matched, critical_changed);
}

invariant c_an_incomplete_package_is_never_shown { assert package_ready(true, true, true, true, false) == VC_PACKAGE_INCOMPLETE and package_ready(true, true, true, true, true) == VC_PACKAGE_READY; }
invariant c_only_an_escalation_returns { assert apply_decision(VC_APPROVE) == VC_APPLIED and apply_decision(VC_REJECT) == VC_APPLIED and apply_decision(VC_ESCALATE) == VC_RETURNED; }
invariant c_undecided_landing_confirms { assert landing(false, true, false) == P2_RUN_CONFIRMATION and landing(true, true, false) == P2_SKIP_CONFIRMATION and landing(true, true, true) == P2_RUN_CONFIRMATION; }

// Scenario: the machine built the whole package, so the human sees one screen and decides once.
test c_complete_package_reaches_the_human {
    assert package_ready(true, true, true, true, true) == VC_PACKAGE_READY;
    assert apply_decision(VC_APPROVE) == VC_APPLIED;
}

// Negative control: a package with a missing field is refused a human -- it goes back to the
// builder instead, so no human ever decides on half a screen.
test c_is_refused_a_showing_of_an_incomplete_package {
    assert package_ready(true, true, false, true, true) == VC_PACKAGE_INCOMPLETE;
    assert apply_decision(VC_ESCALATE) == VC_RETURNED;
}

// Scenario: an escalation is not a rejection -- the mutant comes back with a rebuilt package.
test c_escalation_returns_without_deciding {
    assert apply_decision(VC_ESCALATE) == VC_RETURNED;
}
