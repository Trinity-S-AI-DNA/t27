// SPDX-License-Identifier: Apache-2.0
; specs/tri/cooperate/variant_a.t27 -- cooperation variant A: fully autonomous (Refs #10486)
; Owner rule 2026-10-27: all three cooperation variants, autonomous, in t27.
; Variant A decides every mutant verdict itself: a healthy mutant that touches no boundary and breaks
; no safety rule is accepted without a human; everything else is rejected with its reason recorded.
; Iteration runs under P1 (delta gate) and landing under P2 (skip confirmation), both from
; specs/tri/mutate/speedup.t27. The loop stops when three consecutive cycles accept nothing or when
; the work needs hardware this machine does not have -- the two blocked places of the analog loop.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriCooperateVariantA;

use tri::mutate::speedup;

// Verdicts of one mutant under variant A.
pub const VA_ACCEPTED : u8 = 0;
pub const VA_REJECTED_UNHEALTHY : u8 = 1;
pub const VA_REJECTED_BOUNDARY : u8 = 2;
pub const VA_REJECTED_SAFETY : u8 = 3;

// Stop conditions of the autonomous loop.
pub const VA_CONTINUE : u8 = 0;
pub const VA_STOP_DRY : u8 = 1;
pub const VA_STOP_HARDWARE : u8 = 2;

/// One mutant's verdict, decided with no human in the loop. Any failed guard rejects, reason first.
pub fn verify_mutant(healthy: bool, boundary_ok: bool, safety_ok: bool) -> u8 {
    if (healthy == false) { return VA_REJECTED_UNHEALTHY; }
    if (boundary_ok == false) { return VA_REJECTED_BOUNDARY; }
    if (safety_ok == false) { return VA_REJECTED_SAFETY; }
    return VA_ACCEPTED;
}

/// When does the autonomous loop stop? A dry cycle is a cycle that accepted nothing.
pub fn loop_stop(dry_cycles: u64, hardware_needed: bool) -> u8 {
    if (hardware_needed) { return VA_STOP_HARDWARE; }
    if (dry_cycles >= 3) { return VA_STOP_DRY; }
    return VA_CONTINUE;
}

/// Landing of variant A: P2 decides whether the confirmation gate runs at all.
pub fn landing(first_gate_matched: bool, critical_changed: bool) -> u8 {
    return speedup::p2_landing(first_gate_matched, critical_changed);
}

invariant a_accepts_only_a_clean_mutant { assert verify_mutant(false, true, true) == VA_REJECTED_UNHEALTHY and verify_mutant(true, false, true) == VA_REJECTED_BOUNDARY and verify_mutant(true, true, false) == VA_REJECTED_SAFETY and verify_mutant(true, true, true) == VA_ACCEPTED; }
invariant a_stops_on_hardware_before_three_dry { assert loop_stop(0, true) == VA_STOP_HARDWARE and loop_stop(3, false) == VA_STOP_DRY and loop_stop(2, false) == VA_CONTINUE; }
invariant a_lands_through_p2 { assert landing(true, false) == speedup::P2_SKIP_CONFIRMATION and landing(true, true) == speedup::P2_RUN_CONFIRMATION; }

// Scenario: the acceptance demo -- a healthy, boundary-clean, safety-clean mutant is accepted alone.
test a_clean_mutant_is_accepted_without_a_human {
    assert verify_mutant(true, true, true) == VA_ACCEPTED;
}

// Scenario: each broken guard is rejected, and the reason is the one the guard names.
test a_broken_guard_rejects_with_its_reason {
    assert verify_mutant(false, true, true) == VA_REJECTED_UNHEALTHY;
    assert verify_mutant(true, false, true) == VA_REJECTED_BOUNDARY;
    assert verify_mutant(true, true, false) == VA_REJECTED_SAFETY;
}

// Scenario: the loop ran three cycles accepting nothing -- it stops and reports a dry stop.
test a_dry_loop_stops_after_three_cycles {
    assert loop_stop(3, false) == VA_STOP_DRY;
    // hardware work (reference chain receipts, #12027) stops it at once
    assert loop_stop(0, true) == VA_STOP_HARDWARE;
}
