// SPDX-License-Identifier: Apache-2.0
; specs/tri/cooperate/variant_b.t27 -- cooperation variant B: hybrid with risk-based review (Refs #10486)
; Variant B classifies every mutant first. A LOW-risk mutant (no critical path, no boundary change) is
; decided exactly as variant A decides it, autonomously. A HIGH-risk mutant is never accepted by the
; machine: it waits for a human, and while any review waits, landing confirms fully -- P2's skip never
; fires over an open review. The risk line is the one the analog loop paid for: critical path and
; boundary, nothing else. Imported names are used unqualified, the house style of seal_identity.t27.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriCooperateVariantB;

use tri::cooperate::variant_a;
use tri::mutate::speedup;

// The risk line.
pub const VB_LOW_RISK : u8 = 0;
pub const VB_HIGH_RISK : u8 = 1;

// Verdicts: a LOW mutant gets variant A's verdicts; HIGH gets the review state.
pub const VB_ACCEPTED : u8 = 0;
pub const VB_REJECTED : u8 = 1;
pub const VB_AWAITING_REVIEW : u8 = 2;

// Landing decisions.
pub const VB_LAND : u8 = 0;
pub const VB_LAND_WITH_CONFIRMATION : u8 = 1;

/// The classification: critical path or boundary change makes HIGH, nothing else does.
pub fn classify(touches_critical: bool, changes_boundary: bool) -> u8 {
    if (touches_critical or changes_boundary) { return VB_HIGH_RISK; }
    return VB_LOW_RISK;
}

/// A LOW-risk mutant runs variant A's guards; a HIGH-risk mutant waits for a human, whatever its
/// guards say -- the human's word outranks the machine's on the HIGH side.
pub fn hybrid_verdict(low_risk: bool, healthy: bool, boundary_ok: bool, safety_ok: bool) -> u8 {
    if (low_risk == false) { return VB_AWAITING_REVIEW; }
    var a_verdict : u8 = verify_mutant(healthy, boundary_ok, safety_ok);
    if (a_verdict == VA_ACCEPTED) { return VB_ACCEPTED; }
    return VB_REJECTED;
}

/// Landing: P2 may skip confirmation only when the gate matched, nothing critical moved, and no
/// HIGH-risk mutant is still awaiting its human.
pub fn landing(first_gate_matched: bool, critical_changed: bool, reviews_pending: u64) -> u8 {
    if (reviews_pending > 0) { return VB_LAND_WITH_CONFIRMATION; }
    var p2 : u8 = p2_landing(first_gate_matched, critical_changed);
    if (p2 == P2_SKIP_CONFIRMATION) { return VB_LAND; }
    return VB_LAND_WITH_CONFIRMATION;
}

invariant b_critical_or_boundary_is_high { assert classify(true, false) == VB_HIGH_RISK and classify(false, true) == VB_HIGH_RISK and classify(false, false) == VB_LOW_RISK; }
invariant b_high_risk_never_accepts_itself { assert hybrid_verdict(false, true, true, true) == VB_AWAITING_REVIEW; }
invariant b_an_open_review_blocks_the_p2_skip { assert landing(true, false, 1) == VB_LAND_WITH_CONFIRMATION and landing(true, false, 0) == VB_LAND; }

// Scenario: a LOW-risk healthy mutant runs variant A's guards and is accepted with no human.
test b_low_risk_mutant_is_autonomous {
    assert classify(false, false) == VB_LOW_RISK;
    assert hybrid_verdict(true, true, true, true) == VB_ACCEPTED;
    assert hybrid_verdict(true, false, true, true) == VB_REJECTED;
}

// Scenario: the clock wiring touches the critical path -- HIGH, so it waits for its human.
test b_critical_change_waits_for_a_human {
    assert classify(true, false) == VB_HIGH_RISK;
    assert hybrid_verdict(false, true, true, true) == VB_AWAITING_REVIEW;
}

// Scenario: two HIGH mutants wait; the gate matched, but landing still confirms in full.
test b_pending_reviews_force_full_confirmation {
    assert landing(true, false, 2) == VB_LAND_WITH_CONFIRMATION;
    // the last review closed: P2 now skips the confirmation gate
    assert landing(true, false, 0) == VB_LAND;
}
