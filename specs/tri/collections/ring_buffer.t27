// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Wraps around when full | φ² + 1/φ² = 3 | TRINITY

module TriRing;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Ring(T) = struct {
        buffer : []T,
        head : usize,
        tail : usize,
        capacity : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // new(capacity: usize) → Ring(T); T binds at the fn level (#11940
    // sub-slice 1) -- call sites pass the type explicitly: new(u8, 4)
    fn new(comptime T: type, capacity: usize) -> Ring(T) {
        var buffer : []T = undefined;
        buffer = create_buffer(T, capacity);
        return Ring(T){
            .buffer = buffer,
            .head = 0,
            .tail = 0,
            .capacity = capacity,
        };
    }

    // push(ring: Ring(T)) → void
    fn push(comptime T: type, ring: Ring(T), value: T) -> bool {
        if is_full(T, ring) {
            return false;
        }
        ring.buffer[ring.tail] = value;
        ring.tail = (ring.tail + 1) % ring.capacity;
        return true;
    }

    // pop(ring: Ring(T)) → void
    fn pop(comptime T: type, ring: Ring(T)) -> Option(T) {
        if is_empty(T, ring) {
            return Option(T){ .none = {} };
        }
        var value : T = ring.buffer[ring.head];
        ring.head = (ring.head + 1) % ring.capacity;
        return Option(T){ .some = value };
    }

    // is_empty(ring: Ring(T)) → void
    fn is_empty(comptime T: type, ring: Ring(T)) -> bool {
        return ring.head == ring.tail;
    }

    // is_full(ring: Ring(T)) → void
    fn is_full(comptime T: type, ring: Ring(T)) -> bool {
        return (ring.tail + 1) % ring.capacity == ring.head;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test new_basic_case
        given input = default_input()
        when result = new(u8, input)
        then result != undefined

    test push_basic_case
        given input = default_input()
        when result = push(u8, input, 1)
        then result != undefined

    test pop_basic_case
        given input = default_input()
        when result = pop(u8, input)
        then result != undefined

    test is_empty_basic_case
        given input = default_input()
        when result = is_empty(u8, input)
        then result != undefined

    test is_full_basic_case
        given input = default_input()
        when result = is_full(u8, input)
        then result != undefined

    test new_creates_ring_with_correct_capacity
        given capacity = 4
        and ring = new(u8, capacity)
        then ring.capacity == capacity and ring.buffer.len == capacity

    test push_advances_tail_and_returns_true_when_not_full
        given storage = [_]u8{ 0, 0, 0, 0 }
        and ring = Ring(u8){ .buffer = @constCast(&storage), .head = 0, .tail = 0, .capacity = 4 }
        when success = push(u8, ring, 42)
        then success == true and ring.tail == 1

    test pop_removes_head_and_advances_head_when_not_empty
        given storage = [_]u8{ 42, 0, 0, 0 }
        and ring = Ring(u8){ .buffer = @constCast(&storage), .head = 0, .tail = 1, .capacity = 4 }
        when result = pop(u8, ring)
        then result.some == 42 and ring.head == 1

    test is_true_when_head_equals_tail
        given storage = [_]u8{ 0, 0, 0, 0 }
        and ring = Ring(u8){ .buffer = @constCast(&storage), .head = 2, .tail = 2, .capacity = 4 }
        when result = is_empty(u8, ring)
        then result == true

    test is_full_when_tail_plus_one_mod_capacity_equals_head
        given storage = [_]u8{ 0, 0, 0, 0 }
        and ring = Ring(u8){ .buffer = @constCast(&storage), .head = 0, .tail = 3, .capacity = 4 }
        when result = is_full(u8, ring)
        then result == true

    test occupancy_is_tail_minus_head_modulo_capacity
        given storage = [_]u8{ 0, 0, 0, 0 }
        and ring = Ring(u8){ .buffer = @constCast(&storage), .head = 3, .tail = 1, .capacity = 4 }
        when used = (ring.tail + ring.capacity - ring.head) % ring.capacity
        then used == 2 and used < ring.capacity

    test a_fresh_ring_has_head_and_tail_at_the_same_slot
        given ring = new(u8, 4)
        then ring.head == 0 and ring.tail == 0

    test a_full_ring_and_an_empty_ring_both_show_head_equal_to_tail
        given storage = [_]u8{ 0, 0, 0, 0 }
        and empty_ring = Ring(u8){ .buffer = @constCast(&storage), .head = 0, .tail = 0, .capacity = 4 }
        and full_ring = Ring(u8){ .buffer = @constCast(&storage), .head = 0, .tail = 3, .capacity = 4 }
        when empty_result = is_empty(u8, empty_ring)
        and full_result = is_full(u8, full_ring)
        then empty_result == true and full_result == true

    test push_returns_false_when_ring_is_full
        given storage = [_]u8{ 1, 2, 3, 0 }
        and ring = Ring(u8){ .buffer = @constCast(&storage), .head = 0, .tail = 3, .capacity = 4 }
        when result = push(u8, ring, 4)
        then result == false

    test pop_returns_none_when_ring_is_empty
        given storage = [_]u8{ 0, 0, 0, 0 }
        and ring = Ring(u8){ .buffer = @constCast(&storage), .head = 0, .tail = 0, .capacity = 4 }
        when result = pop(u8, ring)
        then result == Option(u8){ .none = {} }

    test push_and_pop_maintain_correct_state
        given ring = new(u8, 3)
        and push1 = push(u8, ring, 1)
        and push2 = push(u8, ring, 2)
        and pop1 = pop(u8, ring)
        and pop2 = pop(u8, ring)
        then push1 == true and push2 == true and pop1.some == 1 and pop2.some == 2 and is_empty(u8, ring) == true

    test wrap_around_behavior
        given ring = new(u8, 3)
        and push1 = push(u8, ring, 1)
        and push2 = push(u8, ring, 2)
        and push3 = push(u8, ring, 3)
        and push4 = push(u8, ring, 4)
        and pop1 = pop(u8, ring)
        and pop2 = pop(u8, ring)
        then push1 == true and push2 == true and push3 == true and push4 == false and pop1.some == 1 and pop2.some == 2 and ring.head == 2 and ring.tail == 0