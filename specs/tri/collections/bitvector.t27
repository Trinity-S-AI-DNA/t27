// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Fixed capacity: caller-provided word storage | φ² + 1/φ² = 3 | TRINITY

module TriBitvector;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const BitVector = struct {
        bits : []u64,
        length : usize,
    };

    const WORD_BITS : usize = 64;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // empty(storage) → BitVector; zero bits stored, the storage is the caller's
    fn empty(storage: []u64) -> BitVector {
        return BitVector{ .bits = storage, .length = 0 };
    }

    // with_capacity(bits, storage) → BitVector; spans exactly (bits + 63) / 64 words
    // of the storage, all zeroed. The storage must be at least that long.
    fn with_capacity(bits: usize, storage: []u64) -> BitVector {
        const word_capacity : usize = (bits + WORD_BITS - 1) / WORD_BITS;
        var i : usize = 0;
        while (i < word_capacity) {
            storage[i] = 0;
            i = i + 1;
        }
        return BitVector{ .bits = storage[0..word_capacity], .length = 0 };
    }

    // push(bv: *BitVector, bit: bool) → bool (false = no room, unchanged)
    fn push(bv: *BitVector, bit: bool) -> bool {
        const word_index : usize = bv.length / WORD_BITS;
        const bit_offset : u32 = (bv.length % WORD_BITS) as u32;
        if (word_index >= bv.bits.len) {
            return false;
        }
        if (bit) {
            bv.bits[word_index] = bv.bits[word_index] | ((1 as u64) << bit_offset);
        } else {
            bv.bits[word_index] = bv.bits[word_index] & ~((1 as u64) << bit_offset);
        }
        bv.length = bv.length + 1;
        return true;
    }

    // pop(bv: *BitVector) → ?bool
    fn pop(bv: *BitVector) -> ?bool {
        if (bv.length == 0) {
            return null;
        }
        bv.length = bv.length - 1;
        const word_index : usize = bv.length / WORD_BITS;
        const bit_offset : u32 = (bv.length % WORD_BITS) as u32;
        const bit : u64 = (bv.bits[word_index] >> bit_offset) & 1;
        return bit == 1;
    }

    // get(bv: BitVector, index: usize) → bool (false past the end)
    fn get(bv: BitVector, index: usize) -> bool {
        if (index >= bv.length) { return false; }
        const word_index : usize = index / WORD_BITS;
        const bit_offset : u32 = (index % WORD_BITS) as u32;
        const word : u64 = bv.bits[word_index];
        const bit : u64 = (word >> bit_offset) & 1;
        return bit == 1;
    }

    // set(bv: *BitVector, index: usize, value: bool) → void (no-op past the end)
    fn set(bv: *BitVector, index: usize, value: bool) -> void {
        if (index >= bv.length) { return; }
        const word_index : usize = index / WORD_BITS;
        const bit_offset : u32 = (index % WORD_BITS) as u32;
        if (value) {
            bv.bits[word_index] = bv.bits[word_index] | ((1 as u64) << bit_offset);
        } else {
            bv.bits[word_index] = bv.bits[word_index] & ~((1 as u64) << bit_offset);
        }
    }

    // len(bv: BitVector) → usize
    fn len(bv: BitVector) -> usize {
        return bv.length;
    }

    // append(bv: *BitVector, other: BitVector) → bool (false = no room, unchanged)
    fn append(bv: *BitVector, other: BitVector) -> bool {
        if (bv.length + other.length > bv.bits.len * WORD_BITS) {
            return false;
        }
        var i : usize = 0;
        while (i < other.length) {
            const ok = push(bv, get(other, i));
            assert(ok);
            i = i + 1;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (storage is caller-provided)
    // ═══════════════════════════════════════════════════════════

    test empty_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(bv.length == 0);
        assert(len(bv) == 0);
    }

    test with_capacity_basic_case {
        var words : [3]u64 = [0] ** 3;
        var bv = with_capacity(64, &words);
        assert(bv.length == 0);
        assert(bv.bits.len == 1);
    }

    test push_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        const ok = push(&bv, true);
        assert(ok);
        assert(bv.length == 1);
        assert(bv.bits[0] == 1);
    }

    test pop_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(push(&bv, true));
        const bit = pop(&bv);
        assert(bit == true);
        assert(bv.length == 0);
    }

    test get_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(push(&bv, true));
        assert(get(bv, 0) == true);
        assert(get(bv, 1) == false);
    }

    test set_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(push(&bv, false));
        set(&bv, 0, true);
        assert(get(bv, 0) == true);
    }

    test len_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(len(bv) == 0);
        assert(push(&bv, true));
        assert(len(bv) == 1);
    }

    test append_basic_case {
        var words1 : [1]u64 = [0] ** 1;
        var words2 : [1]u64 = [0] ** 1;
        var bv1 = empty(&words1);
        var bv2 = empty(&words2);
        assert(push(&bv2, true));
        const ok = append(&bv1, bv2);
        assert(ok);
        assert(len(bv1) == 1);
        assert(get(bv1, 0) == true);
    }

    test word_capacity_covers_the_bit_length {
        // Verify: `bits` is measured in machine words and `length` in bits, so
        // the backing slice must span at least `length` bits
        var words : [2]u64 = [0] ** 2;
        const bv = BitVector{ .bits = &words, .length = 65 };
        const capacity : usize = bv.bits.len * WORD_BITS;
        assert(capacity >= bv.length);
        assert(bv.length > WORD_BITS);
    }

    test bit_index_maps_to_word_and_offset {
        // Verify: the addressing get/set must implement -- bit i lives in word
        // i / WORD_BITS at offset i % WORD_BITS, counting from the least
        // significant bit. Word 1 holds 0b10, so bit WORD_BITS + 1 reads back
        // set and bit WORD_BITS does not.
        var words : [2]u64 = [0, 2];
        const bv = BitVector{ .bits = &words, .length = WORD_BITS + 2 };
        const idx : usize = WORD_BITS + 1;
        const word : u64 = bv.bits[idx / WORD_BITS];
        const shift : u32 = (idx % WORD_BITS) as u32;
        const bit : u64 = (word >> shift) & 1;
        const neighbour : u64 = word & 1;
        assert(bit == 1);
        assert(neighbour == 0);
        assert(get(bv, idx) == true);
        assert(get(bv, WORD_BITS) == false);
    }

    test empty_returns_zero_length {
        var words : [1]u64 = [0] ** 1;
        const bv = empty(&words);
        assert(bv.length == 0);
        assert(bv.bits.len == 1);
    }

    test with_capacity_calculates_correct_word_count {
        var words : [4]u64 = [0] ** 4;
        const bv = with_capacity(65, &words);
        assert(bv.length == 0);
        assert(bv.bits.len == (65 + WORD_BITS - 1) / WORD_BITS);
        assert(bv.bits.len == 2);
    }

    test push_increases_length_and_sets_bit {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(push(&bv, true));
        assert(push(&bv, false));
        assert(bv.length == 2);
        assert(get(bv, 0) == true);
        assert(get(bv, 1) == false);
    }

    test push_crosses_a_word_boundary {
        var words : [2]u64 = [0] ** 2;
        var bv = empty(&words);
        var k : usize = 0;
        while (k < 65) {
            assert(push(&bv, k == 64));
            k = k + 1;
        }
        assert(bv.length == 65);
        assert(get(bv, 63) == false);
        assert(get(bv, 64) == true);
    }

    test push_refuses_when_full {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        var k : usize = 0;
        while (k < 64) {
            assert(push(&bv, true));
            k = k + 1;
        }
        assert(push(&bv, true) == false);
        assert(bv.length == 64);
    }

    test pop_decreases_length_and_returns_correct_bit {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(push(&bv, true));
        assert(push(&bv, false));
        const bit = pop(&bv);
        assert(bv.length == 1);
        assert(bit == false);
        assert(get(bv, 0) == true);
    }

    test pop_returns_null_on_empty_vector {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        const bit = pop(&bv);
        assert(bit == null);
    }

    test get_reads_the_bit_at_word_offset {
        var words : [2]u64 = [0, 2];
        const bv = BitVector{ .bits = &words, .length = 66 };
        const bit = get(bv, 65);
        const neighbour = get(bv, 64);
        assert(bit == true);
        assert(neighbour == false);
    }

    test set_modifies_bit_in_place {
        var words : [1]u64 = [0] ** 1;
        var bv = BitVector{ .bits = &words, .length = 3 };
        set(&bv, 0, true);
        set(&bv, 1, false);
        set(&bv, 2, true);
        assert(get(bv, 0) == true);
        assert(get(bv, 1) == false);
        assert(get(bv, 2) == true);
    }

    test len_returns_correct_bit_count {
        var words : [1]u64 = [0] ** 1;
        var bv = empty(&words);
        assert(push(&bv, true));
        assert(push(&bv, false));
        assert(push(&bv, true));
        assert(len(bv) == 3);
    }

    test appends_all_bits_from_other_vector {
        var words1 : [1]u64 = [0] ** 1;
        var words2 : [1]u64 = [0] ** 1;
        var bv1 = empty(&words1);
        var bv2 = empty(&words2);
        assert(push(&bv1, true));
        assert(push(&bv1, false));
        assert(push(&bv2, false));
        assert(push(&bv2, true));
        assert(append(&bv1, bv2));
        assert(len(bv1) == 4);
        assert(get(bv1, 0) == true);
        assert(get(bv1, 1) == false);
        assert(get(bv1, 2) == false);
        assert(get(bv1, 3) == true);
    }

    test append_refuses_when_it_would_overflow {
        var words1 : [1]u64 = [0] ** 1;
        var words2 : [1]u64 = [0] ** 1;
        var bv1 = with_capacity(64, &words1);
        var bv2 = with_capacity(64, &words2);
        var k : usize = 0;
        while (k < 40) {
            assert(push(&bv1, true));
            assert(push(&bv2, true));
            k = k + 1;
        }
        assert(append(&bv1, bv2) == false);
        assert(len(bv1) == 40);
    }
