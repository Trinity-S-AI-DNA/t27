// t27/specs/tri/collections/
// Locks sub-slice 1 of #11940 in the corpus: fn-level comptime type params.
// Before the slice, `fn identity(comptime T: type, value: T)` parsed as three
// garbage parameters and gen-zig emitted `fn identity(@"comptime": T,
// @"type": , value: T) T`; a struct literal attached to a generic call
// (`Box(T){ ... }`) was dropped, leaving `return Box(T);` -- a bare type.
// The caller passes the type explicitly; inference is the recorded follow-up.
// Satisfies the generic-fn contract | phi^2 + 1/phi^2 = 3 | TRINITY

module TriBoxFn;

pub const Box(T) = struct {
    kept : bool,
    item : T,
};

fn put(comptime T: type, value: T) -> Box(T) {
    return Box(T){ .kept = true, .item = value };
}

fn get(comptime T: type, b: Box(T)) -> T {
    return b.item;
}

fn one(comptime T: type) -> i64 {
    return 1;
}

test "put_then_get_round_trips_i64" {
    var b = put(i64, 42);
    assert(b.kept == true);
    var v = get(i64, b);
    assert(v == 42);
}

test "put_works_for_f64" {
    var b = put(f64, 2.5);
    assert(b.item == 2.5);
}

test "type_param_used_only_by_signature" {
    assert(one(u8) == 1);
}
