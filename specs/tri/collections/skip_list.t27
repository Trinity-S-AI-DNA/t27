// t27/specs/
// Random level selection (seeded xorshift) over caller-provided storage | φ² + 1/φ² = 3 | TRINITY

module TriSkipList;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Nodes live in caller-provided arrays and link by index (-1 = no node). Node 0
    // is the head sentinel. The forward link of node n at level l is stored at
    // forward[n * max_level + l], so `forward` must hold values.len * max_level
    // entries and max_level must not exceed MAX_LEVELS.
    const MAX_LEVELS : usize = 8;

    pub const SkipList = struct {
        values : []i64,
        forward : []i64,
        max_level : usize,
        level : usize,
        count : usize,
        rng : u64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(max_level, values, forward) → SkipList; level starts at 1, only the head exists
    fn init(max_level: usize, values: []i64, forward: []i64) -> SkipList {
        var levels : usize = max_level;
        if (levels > MAX_LEVELS) { levels = MAX_LEVELS; }
        if (levels < 1) { levels = 1; }
        var i : usize = 0;
        while (i < forward.len) {
            forward[i] = -1;
            i = i + 1;
        }
        return SkipList{
            .values = values,
            .forward = forward,
            .max_level = levels,
            .level = 1,
            .count = 1,
            .rng = 88172645463325252,
        };
    }

    // fwd(list, node, lvl) → index of the next node at that level, or -1
    fn fwd(list: SkipList, node: usize, lvl: usize) -> i64 {
        return list.forward[node * list.max_level + lvl];
    }

    // set_fwd(list, node, lvl, to) → void
    fn set_fwd(list: *SkipList, node: usize, lvl: usize, to: i64) -> void {
        list.forward[node * list.max_level + lvl] = to;
    }

    // random_level(list) → usize in 1..max_level; each extra level has probability 1/2
    fn random_level(list: *SkipList) -> usize {
        var level : usize = 1;
        while (level < list.max_level) {
            var x : u64 = list.rng;
            x = x ^ (x << 13);
            x = x ^ (x >> 7);
            x = x ^ (x << 17);
            list.rng = x;
            if ((x & 1) == 0) {
                break;
            }
            level = level + 1;
        }
        return level;
    }

    // insert(list: *SkipList, value: i64) → bool (false = storage full, unchanged)
    fn insert(list: *SkipList, value: i64) -> bool {
        if (list.count >= list.values.len) {
            return false;
        }
        // Find the predecessor of the insertion point on every level
        var update : [8]i64 = [0] ** 8;
        var cur : usize = 0;
        var lvl : usize = list.level;
        while (lvl > 0) {
            lvl = lvl - 1;
            var nxt : i64 = fwd(list.*, cur, lvl);
            while (nxt >= 0 and list.values[nxt as usize] < value) {
                cur = nxt as usize;
                nxt = fwd(list.*, cur, lvl);
            }
            update[lvl] = cur as i64;
        }
        // Generate random level for the new node
        const new_level : usize = random_level(list);
        var up : usize = list.level;
        while (up < new_level) {
            update[up] = 0;
            up = up + 1;
        }
        if (new_level > list.level) {
            list.level = new_level;
        }
        // Splice the new node in on levels 0..new_level
        const node : usize = list.count;
        list.count = list.count + 1;
        list.values[node] = value;
        var l : usize = 0;
        while (l < new_level) {
            const pred : usize = update[l] as usize;
            set_fwd(list, node, l, fwd(list.*, pred, l));
            set_fwd(list, pred, l, node as i64);
            l = l + 1;
        }
        return true;
    }

    // search(list: SkipList, value: i64) → bool
    fn search(list: SkipList, value: i64) -> bool {
        var cur : usize = 0;
        var lvl : usize = list.level;
        while (lvl > 0) {
            lvl = lvl - 1;
            var nxt : i64 = fwd(list, cur, lvl);
            while (nxt >= 0 and list.values[nxt as usize] < value) {
                cur = nxt as usize;
                nxt = fwd(list, cur, lvl);
            }
        }
        // Check the candidate at level 0
        const cand : i64 = fwd(list, cur, 0);
        return cand >= 0 and list.values[cand as usize] == value;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (storage: 16 nodes, 4 levels)
    // ═══════════════════════════════════════════════════════════

    test init_creates_valid_skip_list {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        const result = init(4, &vals, &fw);
        assert(result.max_level == 4);
        assert(result.level == 1);
        assert(result.count == 1);
        assert(fwd(result, 0, 0) == -1);
    }

    test insert_adds_element_to_empty_list {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        var list = init(4, &vals, &fw);
        const result = insert(&list, 42);
        assert(result);
        assert(search(list, 42) == true);
        assert(list.count == 2);
    }

    test search_finds_existing_element {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        var list = init(4, &vals, &fw);
        assert(insert(&list, 42));
        const result = search(list, 42);
        assert(result == true);
    }

    test search_returns_false_for_nonexistent_element {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        var list = init(4, &vals, &fw);
        assert(insert(&list, 42));
        const result = search(list, 99);
        assert(result == false);
    }

    test insert_multiple_elements {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        var list = init(4, &vals, &fw);
        assert(insert(&list, 10));
        assert(insert(&list, 20));
        assert(insert(&list, 30));
        assert(search(list, 10) == true);
        assert(search(list, 20) == true);
        assert(search(list, 30) == true);
        assert(search(list, 25) == false);
    }

    test search_returns_false_when_list_empty {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        var list = init(4, &vals, &fw);
        const result = search(list, 42);
        assert(result == false);
    }

    test level_zero_chain_is_sorted_whatever_the_insert_order {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        var list = init(4, &vals, &fw);
        assert(insert(&list, 50));
        assert(insert(&list, 10));
        assert(insert(&list, 40));
        assert(insert(&list, 20));
        assert(insert(&list, 30));
        var cur : i64 = fwd(list, 0, 0);
        var expected : i64 = 10;
        var seen : usize = 0;
        while (cur >= 0) {
            assert(list.values[cur as usize] == expected);
            expected = expected + 10;
            seen = seen + 1;
            cur = fwd(list, cur as usize, 0);
        }
        assert(seen == 5);
    }

    test many_inserts_stay_searchable_and_level_is_bounded {
        var vals : [16]i64 = [0] ** 16;
        var fw : [64]i64 = [0] ** 64;
        var list = init(4, &vals, &fw);
        var k : i64 = 15;
        while (k > 0) {
            assert(insert(&list, k));
            k = k - 1;
        }
        k = 1;
        while (k <= 15) {
            assert(search(list, k));
            k = k + 1;
        }
        assert(search(list, 16) == false);
        assert(list.level >= 1);
        assert(list.level <= 4);
    }

    test insert_refuses_when_storage_full {
        var vals : [3]i64 = [0] ** 3;
        var fw : [12]i64 = [0] ** 12;
        var list = init(4, &vals, &fw);
        assert(insert(&list, 1));
        assert(insert(&list, 2));
        assert(insert(&list, 3) == false);
        assert(search(list, 3) == false);
    }
