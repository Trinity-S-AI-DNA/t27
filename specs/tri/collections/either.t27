// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Either represents tagged union | φ² + 1/φ² = 3 | TRINITY

module TriEither;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Either(L, R) = struct {
        is_left : bool,
        left : L,
        right : R,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // left(value: L) → Either(L, R); L and R bind at the fn level (#11940
    // sub-slice 1) -- call sites pass both types explicitly: left(i64, i64, 7)
    fn left(comptime L: type, comptime R: type, value: L) -> Either(L, R) {
        return Either(L, R){ .is_left = true, .left = value, .right = undefined };
    }

    // right(value: R) → Either(L, R)
    fn right(comptime L: type, comptime R: type, value: R) -> Either(L, R) {
        return Either(L, R){ .is_left = false, .right = value, .left = undefined };
    }

    // is_left(either: Either(L, R)) → bool
    fn is_left(comptime L: type, comptime R: type, either: Either(L, R)) -> bool {
        return either.is_left;
    }

    // is_right(either: Either(L, R)) → bool
    fn is_right(comptime L: type, comptime R: type, either: Either(L, R)) -> bool {
        return either.is_left == false;
    }

    // unwrap(either: Either(L, R)) → R
    fn unwrap(comptime L: type, comptime R: type, either: Either(L, R)) -> R {
        if (either.is_left) {
            // Left Either has no right value to unwrap
            return undefined;
        }
        return either.right;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "left_sets_the_left_tag" {
        var e = left(i64, i64, 7);
        assert(is_left(i64, i64, e) == true);
        assert(is_right(i64, i64, e) == false);
    }

    test "left_sets_left_value_and_undefined_right" {
        var e = left(i64, i64, 42);
        assert(is_left(i64, i64, e) == true);
        // Note: We can't directly access e.left in tests as per the issue
        // But we can verify the behavior through unwrap
    }

    test "right_sets_the_right_tag" {
        var e = right(i64, i64, 7);
        assert(is_left(i64, i64, e) == false);
        assert(is_right(i64, i64, e) == true);
    }

    test "right_sets_right_value_and_undefined_left" {
        var e = right(i64, i64, 42);
        assert(is_right(i64, i64, e) == true);
        assert(unwrap(i64, i64, e) == 42);
    }

    test "is_left_returns_true_for_left_either" {
        var e = left(i64, i64, 123);
        assert(is_left(i64, i64, e) == true);
    }

    test "is_left_returns_false_for_right_either" {
        var e = right(i64, i64, 456);
        assert(is_left(i64, i64, e) == false);
    }

    test "is_right_returns_false_for_left_either" {
        var e = left(i64, i64, 123);
        assert(is_right(i64, i64, e) == false);
    }

    test "is_right_returns_true_for_right_either" {
        var e = right(i64, i64, 456);
        assert(is_right(i64, i64, e) == true);
    }

    test "unwrap_returns_right_payload_for_right_either" {
        var e = right(i64, i64, 42);
        assert(unwrap(i64, i64, e) == 42);
    }

    test "unwrap_of_a_left_either_keeps_it_tagged_left" {
        // The original assertion was `result == undefined`, which Zig rejects
        // ("use of undefined value causes illegal behavior"): the payload of
        // the missing side is unobservable. What IS observable is the tag.
        var e = left(i64, i64, 42);
        var result = unwrap(i64, i64, e);
        assert(is_left(i64, i64, e) == true);
    }

    test "inspectors_do_not_mutate_either" {
        var e = left(i64, i64, 123);
        var original_is_left = is_left(i64, i64, e);
        var original_is_right = is_right(i64, i64, e);
        
        // Call inspectors again
        assert(is_left(i64, i64, e) == original_is_left);
        assert(is_right(i64, i64, e) == original_is_right);
    }

    test "left_and_right_are_inverses" {
        var value = 42;
        var e1 = left(i64, i64, value);
        var e2 = right(i64, i64, value);
        
        // They should have opposite tags
        assert(is_left(i64, i64, e1) == true);
        assert(is_right(i64, i64, e1) == false);
        assert(is_left(i64, i64, e2) == false);
        assert(is_right(i64, i64, e2) == true);
    }

    test "unwrap_round_trip_for_right_either" {
        var original = 42;
        var e = right(u32, u32, original);
        assert(unwrap(u32, u32, e) == original);
    }

    test "both_insectors_never_agree" {
        var e = left(i64, i64, 42);
        assert(is_left(i64, i64, e) != is_right(i64, i64, e));
        
        var f = right(i64, i64, 42);
        assert(is_left(i64, i64, f) != is_right(i64, i64, f));
    }

    test "constructors_and_inspectors_preserve_invariants" {
        var left_either = left(i64, i64, 42);
        var right_either = right(i64, i64, 42);
        
        // Left invariant: is_left(left(v)) is true, is_right(left(v)) is false
        assert(is_left(i64, i64, left_either) == true);
        assert(is_right(i64, i64, left_either) == false);
        
        // Right invariant: is_right(right(v)) is true, is_left(right(v)) is false
        assert(is_right(i64, i64, right_either) == true);
        assert(is_left(i64, i64, right_either) == false);
    }
