// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Satisfies monad laws | φ² + 1/φ² = 3 | TRINITY

module TriMaybe;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Maybe(T) = struct {
        computed : bool,
        value : T,
    };

    // Function-typed parameters are spelled through named aliases: the
    // parameter grammar has no inline `fn(...)` type. Zig order, no arrow.
    // MaybeBindFn is fn(i64) -> Maybe(i64); MaybeMapFn is fn(i64) -> i64.
    // APPROXIMATION (#11940 sub-slice 2, still open): the aliases are not
    // generic. ADR-008 accepts a parameterised const only when it names a
    // struct, so `pub const MaybeBindFn(T) = fn(T) Maybe(T);` is rejected.
    // Since #12000 landed fn-level comptime type params, bind/map take the
    // function type as an explicit `comptime F: type` argument, so the tie
    // between f and the caller's T is expressed AT THE CALL SITE
    // (bind(i64, MaybeBindFnI64, m, f)) rather than by the alias. The i64
    // instantiations below are the ones this module's own tests exercise.
    pub const MaybeBindFnI64 = fn(i64) Maybe(i64);
    pub const MaybeMapFnI64 = fn(i64) i64;
    // DEFECT (recorded, #11940 remainder): a const-qualified type cannot be
    // passed as an explicit type argument. Inline `pure([]const u8, "")` is a
    // parse error (KwConst is a keyword token in expression position), and
    // the alias route garbles emission: `pub const Str = []const u8;` emits
    // as `pub const Str = .{};` followed by a stray `const u8;`. The
    // string instantiation of pure therefore waits on the compiler; the
    // empty-value law is covered at bool below.

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Helper for creating absent Maybe values. T binds at the fn level
    // (#11940 sub-slice 1): call sites pass the type explicitly.
    fn nothing(comptime T: type) -> Maybe(T) {
        return Maybe(T){ .computed = false, .value = undefined };
    }

    // pure(value: T) → Maybe(T)
    fn pure(comptime T: type, value: T) -> Maybe(T) {
        // The unit: always present, carries the value through unchanged
        return Maybe(T){ .computed = true, .value = value };
    }

    // bind(maybe: Maybe(T), f: fn(T) -> Maybe(T)) → Maybe(T)
    // F carries f's function type; the caller names it through an alias.
    fn bind(comptime T: type, comptime F: type, maybe: Maybe(T), f: F) -> Maybe(T) {
        // The sequencer: short-circuits on absence, chains computations on presence
        if (maybe.computed == false) {
            return nothing(T);
        }
        return f(maybe.value);
    }

    // map(maybe: Maybe(T), f: fn(T) -> T) → Maybe(T)
    fn map(comptime T: type, comptime F: type, maybe: Maybe(T), f: F) -> Maybe(T) {
        // Apply a plain function under the wrapper: absent in, absent out
        if (maybe.computed == false) {
            return nothing(T);
        }
        // map(m, f) equals bind(m, x -> pure(f(x)))
        return Maybe(T){ .computed = true, .value = f(maybe.value) };
    }

    // join(nested: Maybe(Maybe(T))) → Maybe(T)
    fn join(comptime T: type, nested: Maybe(Maybe(T))) -> Maybe(T) {
        // Collapse exactly one layer: absent outer yields absent, present outer yields inner
        if (nested.computed == false) {
            return nothing(T);
        }
        return nested.value;
    }

    // Test helpers. The tests originally passed anonymous closures
    // (`fn(x: i64) -> ... { ... }`) inline; t27 has no closure literals, so
    // each closure is a named function with the identical body. A generic fn
    // is not a value in Zig, so `pure` itself cannot be passed to bind;
    // pure_i64 is its i64 instantiation.
    fn double_then_pure(x: i64) -> Maybe(i64) {
        return pure(i64, x * 2);
    }

    fn always_nothing(x: i64) -> Maybe(i64) {
        return nothing(i64);
    }

    fn pure_i64(x: i64) -> Maybe(i64) {
        return pure(i64, x);
    }

    fn double_i64(x: i64) -> i64 {
        return x * 2;
    }

    fn add_ten_i64(x: i64) -> i64 {
        return x + 10;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "pure_marks_its_result_computed" {
        var m = pure(i64, 7);
        assert(m.computed == true);
        assert(m.value == 7);
    }

    test "pure_of_zero_is_still_present" {
        var m = pure(i64, 0);
        assert(m.computed == true);
        assert(m.value == 0);
    }

    test "pure_of_false_is_still_present" {
        // The string version (pure of "" is still present) is the recorded
        // defect above: []const u8 cannot be passed as a type argument yet.
        var m = pure(bool, false);
        assert(m.computed == true);
        assert(m.value == false);
    }

    test "bind_on_an_absent_maybe_short_circuits" {
        var absent = Maybe(i64){ .computed = false, .value = undefined };
        var out = bind(i64, MaybeBindFnI64, absent, pure_i64);
        assert(out.computed == false);
    }

    test "bind_on_present_maybe_returns_function_result" {
        var present = pure(i64, 42);
        var out = bind(i64, MaybeBindFnI64, present, double_then_pure);
        assert(out.computed == true);
        assert(out.value == 84);
    }

    test "bind_preserves_absence_from_function" {
        var present = pure(i64, 42);
        var out = bind(i64, MaybeBindFnI64, present, always_nothing);
        assert(out.computed == false);
    }

    test "bind_right_identity_present" {
        var m = pure(i64, 42);
        var out = bind(i64, MaybeBindFnI64, m, pure_i64);
        assert(out.computed == true);
        assert(out.value == 42);
    }

    test "bind_right_identity_absent" {
        var absent = Maybe(i64){ .computed = false, .value = undefined };
        var out = bind(i64, MaybeBindFnI64, absent, pure_i64);
        assert(out.computed == false);
    }

    test "map_on_an_absent_maybe_stays_absent" {
        var absent = Maybe(i64){ .computed = false, .value = undefined };
        var out = map(i64, MaybeMapFnI64, absent, double_i64);
        assert(out.computed == false);
    }

    test "map_on_present_maybe_applies_function_once" {
        var present = pure(i64, 21);
        var out = map(i64, MaybeMapFnI64, present, double_i64);
        assert(out.computed == true);
        assert(out.value == 42);
    }

    test "map_keeps_computed_true" {
        var present = pure(i64, -5);
        var out = map(i64, MaybeMapFnI64, present, add_ten_i64);
        assert(out.computed == true);
        assert(out.value == 5);
    }

    test "join_of_present_outer_with_present_inner_yields_inner" {
        var inner = pure(i64, 42);
        var nested = pure(Maybe(i64), inner);
        var result = join(i64, nested);
        assert(result.computed == true);
        assert(result.value == 42);
    }

    test "join_of_absent_outer_is_absent" {
        var nested = Maybe(Maybe(i64)){ .computed = false, .value = undefined };
        var result = join(i64, nested);
        assert(result.computed == false);
    }

    test "join_of_present_outer_with_absent_inner_is_absent" {
        var inner = Maybe(i64){ .computed = false, .value = undefined };
        var nested = pure(Maybe(i64), inner);
        var result = join(i64, nested);
        assert(result.computed == false);
    }
