// t27/specs/
// When at capacity, remove least recently used item (i64 -> i64, node pool, recency list) | φ² + 1/φ² = 3 | TRINITY

module TriLruCache;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Doubly linked recency list over a caller-provided node pool. Links are pool
    // indices (NIL = -1); `head` is the most recently used node, `tail` the least.
    // Lookup is a scan over the used nodes (the original HashMap is not modelled).
    const NIL : i64 = -1;

    pub const Node = struct {
        key : i64,
        value : i64,
        prev : i64,
        next : i64,
        used : bool,
    };

    pub const LRUCache = struct {
        capacity : usize,
        size : usize,
        head : i64,
        tail : i64,
        nodes : []Node,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // blank() → Node; an unused pool slot
    fn blank() -> Node {
        return Node{ .key = 0, .value = 0, .prev = -1, .next = -1, .used = false };
    }

    // init(capacity, pool) → LRUCache; capacity is clamped to the pool length
    fn init(capacity: usize, pool: []Node) -> LRUCache {
        var cap : usize = capacity;
        if (cap > pool.len) { cap = pool.len; }
        var i : usize = 0;
        while (i < pool.len) {
            pool[i] = blank();
            i = i + 1;
        }
        return LRUCache{ .capacity = cap, .size = 0, .head = -1, .tail = -1, .nodes = pool };
    }

    // find(cache, key) → pool index of the key, or NIL
    fn find(cache: LRUCache, key: i64) -> i64 {
        var i : usize = 0;
        while (i < cache.nodes.len) {
            if (cache.nodes[i].used and cache.nodes[i].key == key) {
                return i as i64;
            }
            i = i + 1;
        }
        return -1;
    }

    // unlink(cache, n) → void; detach node n from the recency list
    fn unlink(cache: *LRUCache, n: i64) -> void {
        const u : usize = n as usize;
        const p : i64 = cache.nodes[u].prev;
        const q : i64 = cache.nodes[u].next;
        if (p >= 0) {
            cache.nodes[p as usize].next = q;
        } else {
            cache.head = q;
        }
        if (q >= 0) {
            cache.nodes[q as usize].prev = p;
        } else {
            cache.tail = p;
        }
        cache.nodes[u].prev = -1;
        cache.nodes[u].next = -1;
    }

    // link_front(cache, n) → void; make node n the most recently used
    fn link_front(cache: *LRUCache, n: i64) -> void {
        const u : usize = n as usize;
        cache.nodes[u].prev = -1;
        cache.nodes[u].next = cache.head;
        if (cache.head >= 0) {
            cache.nodes[cache.head as usize].prev = n;
        }
        cache.head = n;
        if (cache.tail < 0) {
            cache.tail = n;
        }
    }

    // get(cache: *LRUCache, key: i64) → ?i64; a hit moves the node to the front
    fn get(cache: *LRUCache, key: i64) -> ?i64 {
        const n : i64 = find(cache.*, key);
        if (n < 0) {
            return null;
        }
        if (n != cache.head) {
            unlink(cache, n);
            link_front(cache, n);
        }
        return cache.nodes[n as usize].value;
    }

    // put(cache: *LRUCache, key: i64, value: i64) → void
    fn put(cache: *LRUCache, key: i64, value: i64) -> void {
        if (cache.capacity == 0) {
            return;
        }
        // If key already exists, update value and move to front
        const existing : i64 = find(cache.*, key);
        if (existing >= 0) {
            cache.nodes[existing as usize].value = value;
            if (existing != cache.head) {
                unlink(cache, existing);
                link_front(cache, existing);
            }
            return;
        }
        // If cache is at capacity, remove tail (least recently used)
        if (cache.size >= cache.capacity and cache.tail >= 0) {
            const victim : i64 = cache.tail;
            unlink(cache, victim);
            cache.nodes[victim as usize] = blank();
            cache.size = cache.size - 1;
        }
        // Take a free pool slot for the new node and add it to the front
        var slot : i64 = -1;
        var i : usize = 0;
        while (i < cache.nodes.len and slot < 0) {
            if (cache.nodes[i].used == false) {
                slot = i as i64;
            }
            i = i + 1;
        }
        if (slot < 0) {
            return;
        }
        cache.nodes[slot as usize] = Node{ .key = key, .value = value, .prev = -1, .next = -1, .used = true };
        link_front(cache, slot);
        cache.size = cache.size + 1;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (pool of 4 nodes)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var pool : [4]Node = [blank()] ** 4;
        const cache = init(2, &pool);
        assert(cache.capacity == 2);
        assert(cache.size == 0);
        assert(cache.head == NIL);
        assert(cache.tail == NIL);
    }

    test get_basic_case {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(2, &pool);
        put(&cache, 1, 11);
        const hit = get(&cache, 1);
        const miss = get(&cache, 2);
        assert(hit == 11);
        assert(miss == null);
    }

    test put_basic_case {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(2, &pool);
        put(&cache, 1, 11);
        assert(cache.size == 1);
        assert(cache.head != NIL);
        assert(cache.head == cache.tail);
        assert(cache.nodes[cache.head as usize].key == 1);
    }

    test init_creates_cache {
        var pool : [4]Node = [blank()] ** 4;
        const cache = init(3, &pool);
        assert(cache.capacity == 3);
        assert(cache.size == 0);
    }

    test get_retrieves_existing_value {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(2, &pool);
        put(&cache, 1, 11);
        const value = get(&cache, 1);
        assert(value == 11);
    }

    test get_returns_null_for_nonexistent_key {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(2, &pool);
        const value = get(&cache, 404);
        assert(value == null);
    }

    test put_updates_existing_value {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(2, &pool);
        put(&cache, 1, 11);
        put(&cache, 1, 99);
        const value = get(&cache, 1);
        assert(value == 99);
        assert(cache.size == 1);
    }

    test put_evicts_oldest_when_at_capacity {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(2, &pool);
        put(&cache, 1, 11);
        put(&cache, 2, 22);
        put(&cache, 3, 33);
        const value1 = get(&cache, 1);
        const value2 = get(&cache, 2);
        const value3 = get(&cache, 3);
        assert(value1 == null);
        assert(value2 == 22);
        assert(value3 == 33);
        assert(cache.size == 2);
    }

    test get_moves_node_to_front {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(3, &pool);
        put(&cache, 1, 11);
        put(&cache, 2, 22);
        put(&cache, 3, 33);
        assert(cache.nodes[cache.head as usize].key == 3);
        assert(cache.nodes[cache.tail as usize].key == 1);
        assert(get(&cache, 1) == 11);
        assert(cache.nodes[cache.head as usize].key == 1);
        assert(cache.nodes[cache.tail as usize].key == 2);
    }

    test get_refreshes_recency_before_eviction {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(2, &pool);
        put(&cache, 1, 11);
        put(&cache, 2, 22);
        assert(get(&cache, 1) == 11);
        put(&cache, 3, 33);
        assert(get(&cache, 2) == null);
        assert(get(&cache, 1) == 11);
        assert(get(&cache, 3) == 33);
    }

    test zero_capacity_stores_nothing {
        var pool : [4]Node = [blank()] ** 4;
        var cache = init(0, &pool);
        put(&cache, 1, 11);
        assert(cache.size == 0);
        assert(get(&cache, 1) == null);
    }
