// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Evicts least recently used (i64 -> i64, caller-provided storage) | φ² + 1/φ² = 3 | TRINITY

module TriLru;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Entries are kept in recency order inside the caller's arrays: index 0 is the
    // least recently used entry, index size - 1 the most recently used one.
    pub const LRU = struct {
        capacity : usize,
        size : usize,
        keys : []i64,
        vals : []i64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(capacity, keys, vals) → LRU; capacity is clamped to the storage length
    fn init(capacity: usize, keys: []i64, vals: []i64) -> LRU {
        var cap : usize = capacity;
        if (cap > keys.len) { cap = keys.len; }
        if (cap > vals.len) { cap = vals.len; }
        return LRU{ .capacity = cap, .size = 0, .keys = keys, .vals = vals };
    }

    // find(cache, key) → index of the key, or -1
    fn find(cache: LRU, key: i64) -> i64 {
        var i : usize = 0;
        while (i < cache.size) {
            if (cache.keys[i] == key) {
                return i as i64;
            }
            i = i + 1;
        }
        return -1;
    }

    // touch(cache, index) → void; move the entry to the most-recent end
    fn touch(cache: *LRU, index: usize) -> void {
        const k : i64 = cache.keys[index];
        const v : i64 = cache.vals[index];
        var i : usize = index;
        while (i + 1 < cache.size) {
            cache.keys[i] = cache.keys[i + 1];
            cache.vals[i] = cache.vals[i + 1];
            i = i + 1;
        }
        cache.keys[cache.size - 1] = k;
        cache.vals[cache.size - 1] = v;
    }

    // get(cache: *LRU, key: i64) → ?i64; a hit marks the key most recently used
    fn get(cache: *LRU, key: i64) -> ?i64 {
        const at : i64 = find(cache.*, key);
        if (at < 0) {
            return null;
        }
        touch(cache, at as usize);
        return cache.vals[cache.size - 1];
    }

    // put(cache: *LRU, key: i64, value: i64) → void
    fn put(cache: *LRU, key: i64, value: i64) -> void {
        if (cache.capacity == 0) {
            return;
        }
        const at : i64 = find(cache.*, key);
        if (at >= 0) {
            // Key exists: update the value and mark it most recently used
            cache.vals[at as usize] = value;
            touch(cache, at as usize);
            return;
        }
        if (cache.size >= cache.capacity) {
            // Evict the least recently used entry (index 0)
            var i : usize = 0;
            while (i + 1 < cache.size) {
                cache.keys[i] = cache.keys[i + 1];
                cache.vals[i] = cache.vals[i + 1];
                i = i + 1;
            }
            cache.size = cache.size - 1;
        }
        cache.keys[cache.size] = key;
        cache.vals[cache.size] = value;
        cache.size = cache.size + 1;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        const cache = init(3, &ks, &vs);
        assert(cache.capacity == 3);
        assert(cache.size == 0);
    }

    test init_clamps_capacity_to_storage {
        var ks : [2]i64 = [0] ** 2;
        var vs : [2]i64 = [0] ** 2;
        const cache = init(9, &ks, &vs);
        assert(cache.capacity == 2);
    }

    test get_basic_case {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        var cache = init(2, &ks, &vs);
        put(&cache, 1, 11);
        const hit = get(&cache, 1);
        const miss = get(&cache, 2);
        assert(hit == 11);
        assert(miss == null);
    }

    test put_basic_case {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        var cache = init(2, &ks, &vs);
        put(&cache, 1, 11);
        assert(cache.size == 1);
        assert(cache.keys[0] == 1);
        assert(cache.vals[0] == 11);
    }

    test put_updates_existing_value {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        var cache = init(2, &ks, &vs);
        put(&cache, 1, 11);
        put(&cache, 1, 99);
        assert(cache.size == 1);
        assert(get(&cache, 1) == 99);
    }

    test put_evicts_least_recently_used_when_at_capacity {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        var cache = init(2, &ks, &vs);
        put(&cache, 1, 11);
        put(&cache, 2, 22);
        put(&cache, 3, 33);
        assert(cache.size == 2);
        assert(get(&cache, 1) == null);
        assert(get(&cache, 2) == 22);
        assert(get(&cache, 3) == 33);
    }

    test get_refreshes_recency {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        var cache = init(2, &ks, &vs);
        put(&cache, 1, 11);
        put(&cache, 2, 22);
        assert(get(&cache, 1) == 11);
        put(&cache, 3, 33);
        assert(get(&cache, 2) == null);
        assert(get(&cache, 1) == 11);
        assert(get(&cache, 3) == 33);
    }

    test put_existing_key_refreshes_recency {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        var cache = init(2, &ks, &vs);
        put(&cache, 1, 11);
        put(&cache, 2, 22);
        put(&cache, 1, 12);
        put(&cache, 3, 33);
        assert(get(&cache, 2) == null);
        assert(get(&cache, 1) == 12);
    }

    test zero_capacity_stores_nothing {
        var ks : [4]i64 = [0] ** 4;
        var vs : [4]i64 = [0] ** 4;
        var cache = init(0, &ks, &vs);
        put(&cache, 1, 11);
        assert(cache.size == 0);
        assert(get(&cache, 1) == null);
    }
