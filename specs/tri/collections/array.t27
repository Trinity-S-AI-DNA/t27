// t27/specs/
// ArrayView provides zero-copy access (u8 elements, caller-provided output buffers) | φ² + 1/φ² = 3 | TRINITY

module TriArray;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ArrayView = struct {
        items : []const u8,
        len : usize,
    };

    pub const SliceRange = struct {
        start : usize,
        end : usize,
        step : i64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // slice(arr: []const u8, start: usize, end: usize) → []const u8
    fn slice(arr: []const u8, start: usize, end: usize) -> []const u8 {
        return arr[start..end];
    }

    // slice_from(arr: []const u8, start: usize) → []const u8
    fn slice_from(arr: []const u8, start: usize) -> []const u8 {
        return arr[start..arr.len];
    }

    // is_empty(arr: []const u8) → bool
    fn is_empty(arr: []const u8) -> bool {
        return arr.len == 0;
    }

    // first(arr: []const u8) → ?u8; null for an empty array
    fn first(arr: []const u8) -> ?u8 {
        if (is_empty(arr)) {
            return null;
        }
        return arr[0];
    }

    // last(arr: []const u8) → ?u8; null for an empty array
    fn last(arr: []const u8) -> ?u8 {
        if (is_empty(arr)) {
            return null;
        }
        return arr[arr.len - 1];
    }

    // index_of(arr: []const u8, item: u8) → ?usize
    fn index_of(arr: []const u8, item: u8) -> ?usize {
        var i : usize = 0;
        while (i < arr.len) {
            if (arr[i] == item) {
                return i;
            }
            i = i + 1;
        }
        return null;
    }

    // contains(arr: []const u8, item: u8) → bool
    fn contains(arr: []const u8, item: u8) -> bool {
        return index_of(arr, item) != null;
    }

    // equal(a, b) → bool; element-wise comparison of two arrays
    fn equal(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) { return false; }
        var i : usize = 0;
        while (i < a.len) {
            if (a[i] != b[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    // reverse(arr: []const u8, out: []u8) → []u8; out must hold arr.len items,
    // the result is the used prefix of out
    fn reverse(arr: []const u8, out: []u8) -> []u8 {
        var i : usize = 0;
        while (i < arr.len) {
            out[i] = arr[arr.len - 1 - i];
            i = i + 1;
        }
        return out[0..arr.len];
    }

    // concat(a: []const u8, b: []const u8, out: []u8) → []u8; out must hold
    // a.len + b.len items, the result is the used prefix of out
    fn concat(a: []const u8, b: []const u8, out: []u8) -> []u8 {
        var i : usize = 0;
        while (i < a.len) {
            out[i] = a[i];
            i = i + 1;
        }
        var j : usize = 0;
        while (j < b.len) {
            out[a.len + j] = b[j];
            j = j + 1;
        }
        return out[0..a.len + b.len];
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "slice_basic_case" {
        var data : [5]u8 = [0, 1, 2, 3, 4];
        const result = slice(&data, 0, 2);
        assert(result.len == 2);
        assert(result[1] == 1);
    }

    test "slice_from_basic_case" {
        var data : [5]u8 = [0, 1, 2, 3, 4];
        const result = slice_from(&data, 4);
        assert(result.len == 1);
        assert(result[0] == 4);
    }

    test "first_basic_case" {
        var data : [3]u8 = [7, 8, 9];
        const result = first(&data);
        assert(result == 7);
    }

    test "last_basic_case" {
        var data : [3]u8 = [7, 8, 9];
        const result = last(&data);
        assert(result == 9);
    }

    test "is_empty_basic_case" {
        var data : [3]u8 = [7, 8, 9];
        assert(is_empty(&data) == false);
        assert(is_empty(data[0..0]) == true);
    }

    test "contains_basic_case" {
        var data : [3]u8 = [7, 8, 9];
        assert(contains(&data, 8) == true);
        assert(contains(&data, 1) == false);
    }

    test "index_of_basic_case" {
        var data : [3]u8 = [7, 8, 9];
        assert(index_of(&data, 9) == 2);
        assert(index_of(&data, 1) == null);
    }

    test "reverse_basic_case" {
        var data : [3]u8 = [7, 8, 9];
        var out : [3]u8 = [0] ** 3;
        const result = reverse(&data, &out);
        assert(result.len == 3);
        assert(result[0] == 9);
        assert(result[2] == 7);
    }

    test "concat_basic_case" {
        var a : [1]u8 = [1];
        var b : [2]u8 = [2, 3];
        var out : [3]u8 = [0] ** 3;
        const result = concat(&a, &b, &out);
        assert(result.len == 3);
        assert(result[0] == 1);
        assert(result[2] == 3);
    }

    test slice_range_start_is_inclusive_and_end_is_exclusive {
        // Verify: the field pair matches Zig's own slice syntax, so a range of
        // 1..4 over five elements selects three of them starting at index 1
        var data : [5]u8 = [0, 1, 2, 3, 4];
        var expected : [3]u8 = [1, 2, 3];
        const window = slice(&data, 1, 4);
        assert(window.len == 3);
        assert(equal(window, &expected));
    }

    test an_empty_slice_range_has_equal_bounds {
        // Verify: start == end selects nothing, which is how is_empty distinguishes
        // an empty view from a one-element one
        var data : [3]u8 = [0, 1, 2];
        const window = slice(&data, 2, 2);
        assert(window.len == 0);
        assert(is_empty(window) == true);
    }

    test slice_from_returns_elements_from_start_to_end {
        var data : [5]u8 = [0, 1, 2, 3, 4];
        var expected : [2]u8 = [3, 4];
        const window = slice_from(&data, 3);
        assert(window.len == 2);
        assert(equal(window, &expected));
    }

    test slice_from_with_start_at_len_returns_empty {
        var data : [3]u8 = [0, 1, 2];
        const window = slice_from(&data, 3);
        assert(window.len == 0);
    }

    test first_returns_first_element {
        var data : [3]u8 = [10, 20, 30];
        const element = first(&data);
        assert(element == 10);
    }

    test first_on_empty_array_is_undefined {
        // An empty array has no first element: the optional is null
        var data : [3]u8 = [10, 20, 30];
        const element = first(data[0..0]);
        assert(element == null);
    }

    test last_returns_last_element {
        var data : [3]u8 = [10, 20, 30];
        const element = last(&data);
        assert(element == 30);
    }

    test last_on_empty_array_is_undefined {
        // An empty array has no last element: the optional is null
        var data : [3]u8 = [10, 20, 30];
        const element = last(data[0..0]);
        assert(element == null);
    }

    test is_empty_returns_true_for_empty_array {
        var data : [3]u8 = [1, 2, 3];
        const empty = is_empty(data[0..0]);
        assert(empty == true);
    }

    test is_empty_returns_false_for_non_empty_array {
        var data : [3]u8 = [1, 2, 3];
        const empty = is_empty(&data);
        assert(empty == false);
    }

    test contains_returns_true_when_item_is_present {
        var data : [5]u8 = [1, 2, 3, 4, 5];
        const found = contains(&data, 3);
        assert(found == true);
    }

    test contains_returns_false_when_item_is_absent {
        var data : [5]u8 = [1, 2, 3, 4, 5];
        const found = contains(&data, 9);
        assert(found == false);
    }

    test index_of_returns_index_when_item_is_present {
        var data : [5]u8 = [1, 2, 3, 4, 5];
        const found = index_of(&data, 3);
        assert(found == 2);
    }

    test index_of_returns_null_when_the_item_is_absent {
        var data : [3]u8 = [1, 2, 3];
        const found = index_of(&data, 9);
        assert(found == null);
    }

    test reverse_returns_reversed_array {
        var data : [4]u8 = [1, 2, 3, 4];
        var out : [4]u8 = [0] ** 4;
        var expected : [4]u8 = [4, 3, 2, 1];
        const reversed = reverse(&data, &out);
        assert(reversed.len == 4);
        assert(equal(reversed, &expected));
    }

    test concat_combines_two_arrays {
        // The original asserted combined.len == 6 next to a four-element expected
        // array; two arrays of two elements combine to four.
        var a : [2]u8 = [1, 2];
        var b : [2]u8 = [3, 4];
        var out : [4]u8 = [0] ** 4;
        var expected : [4]u8 = [1, 2, 3, 4];
        const combined = concat(&a, &b, &out);
        assert(combined.len == 4);
        assert(equal(combined, &expected));
    }

    test concat_with_empty_arrays {
        var a : [1]u8 = [0];
        var b : [1]u8 = [0];
        var out : [2]u8 = [0] ** 2;
        const combined = concat(a[0..0], b[0..0], &out);
        assert(combined.len == 0);
    }
