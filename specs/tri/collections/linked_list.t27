// t27/specs/
// Index-linked doubly linked list over a caller-provided node pool | φ² + 1/φ² = 3 | TRINITY

module TriLinkedList;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Nodes live in a caller-provided pool and link by pool index; NIL (-1) is the
    // null link. A node is free when `used` is false.
    const NIL : i64 = -1;

    pub const ListNode = struct {
        value : i64,
        prev : i64,
        next : i64,
        used : bool,
    };

    pub const LinkedList = struct {
        nodes : []ListNode,
        head : i64,
        tail : i64,
        length : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // blank() → ListNode; an unused pool slot
    fn blank() -> ListNode {
        return ListNode{ .value = 0, .prev = -1, .next = -1, .used = false };
    }

    // init(pool) → LinkedList; the caller owns the pool, every slot becomes free
    fn init(pool: []ListNode) -> LinkedList {
        var i : usize = 0;
        while (i < pool.len) {
            pool[i] = blank();
            i = i + 1;
        }
        return LinkedList{ .nodes = pool, .head = -1, .tail = -1, .length = 0 };
    }

    // alloc_slot(list) → index of a free pool slot, or NIL when the pool is full
    fn alloc_slot(list: *LinkedList) -> i64 {
        var i : usize = 0;
        while (i < list.nodes.len) {
            if (list.nodes[i].used == false) {
                return i as i64;
            }
            i = i + 1;
        }
        return -1;
    }

    // append(list: *LinkedList, value: i64) → bool (false = pool full, list unchanged)
    fn append(list: *LinkedList, value: i64) -> bool {
        const slot : i64 = alloc_slot(list);
        if (slot < 0) {
            return false;
        }
        const s : usize = slot as usize;
        list.nodes[s] = ListNode{ .value = value, .prev = list.tail, .next = -1, .used = true };
        if (list.tail >= 0) {
            list.nodes[list.tail as usize].next = slot;
        } else {
            // List was empty, set head too
            list.head = slot;
        }
        list.tail = slot;
        list.length = list.length + 1;
        return true;
    }

    // prepend(list: *LinkedList, value: i64) → bool (false = pool full, list unchanged)
    fn prepend(list: *LinkedList, value: i64) -> bool {
        const slot : i64 = alloc_slot(list);
        if (slot < 0) {
            return false;
        }
        const s : usize = slot as usize;
        list.nodes[s] = ListNode{ .value = value, .prev = -1, .next = list.head, .used = true };
        if (list.head >= 0) {
            list.nodes[list.head as usize].prev = slot;
        } else {
            // List was empty, set tail too
            list.tail = slot;
        }
        list.head = slot;
        list.length = list.length + 1;
        return true;
    }

    // remove(list: *LinkedList, value: i64) → bool
    fn remove(list: *LinkedList, value: i64) -> bool {
        // Find first node with matching value
        var current : i64 = list.head;
        while (current >= 0) {
            const c : usize = current as usize;
            if (list.nodes[c].value == value) {
                const p : i64 = list.nodes[c].prev;
                const n : i64 = list.nodes[c].next;
                if (p >= 0) {
                    list.nodes[p as usize].next = n;
                } else {
                    // Removing head node
                    list.head = n;
                }
                if (n >= 0) {
                    list.nodes[n as usize].prev = p;
                } else {
                    // Removing tail node
                    list.tail = p;
                }
                // Return the slot to the pool
                list.nodes[c] = blank();
                list.length = list.length - 1;
                return true;
            }
            current = list.nodes[c].next;
        }
        // No node with matching value found
        return false;
    }

    // deinit(list: *LinkedList) → void
    fn deinit(list: *LinkedList) -> void {
        // Free every node of the chain; leave head NIL, tail NIL, length 0
        var current : i64 = list.head;
        while (current >= 0) {
            const c : usize = current as usize;
            const next : i64 = list.nodes[c].next; // Capture next before freeing current
            list.nodes[c] = blank();
            current = next;
        }
        list.head = -1;
        list.tail = -1;
        list.length = 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (pool of 8 nodes; links are pool indices, NIL = -1)
    // ═══════════════════════════════════════════════════════════

    test init_creates_empty_list {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(list.head == NIL);
        assert(list.tail == NIL);
        assert(list.length == 0);
    }

    test append_to_empty_list_sets_both_ends {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(list.length == 1);
        assert(list.head != NIL);
        assert(list.head == list.tail);
        assert(list.nodes[list.head as usize].prev == NIL);
        assert(list.nodes[list.head as usize].next == NIL);
    }

    test append_to_nonempty_list_adds_to_tail {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(append(&list, 20));
        assert(list.length == 2);
        assert(list.head != NIL);
        assert(list.tail != NIL);
        assert(list.nodes[list.head as usize].next == list.tail);
        assert(list.nodes[list.tail as usize].prev == list.head);
    }

    test prepend_to_empty_list_sets_both_ends {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(prepend(&list, 10));
        assert(list.length == 1);
        assert(list.head != NIL);
        assert(list.head == list.tail);
        assert(list.nodes[list.head as usize].prev == NIL);
        assert(list.nodes[list.head as usize].next == NIL);
    }

    test prepend_to_nonempty_list_adds_to_head {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(prepend(&list, 20));
        assert(prepend(&list, 10));
        assert(list.length == 2);
        assert(list.head != NIL);
        assert(list.tail != NIL);
        assert(list.nodes[list.head as usize].next == list.tail);
        assert(list.nodes[list.tail as usize].prev == list.head);
        assert(list.nodes[list.head as usize].value == 10);
        assert(list.nodes[list.tail as usize].value == 20);
    }

    test remove_from_empty_list_does_nothing {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        const result = remove(&list, 10);
        assert(result == false);
        assert(list.length == 0);
        assert(list.head == NIL);
        assert(list.tail == NIL);
    }

    test remove_head_from_single_node_list {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(append(&list, 20));  // Add another node to make it non-empty
        const result = remove(&list, 10);
        assert(result == true);
        assert(list.length == 1);
        assert(list.head != NIL);
        assert(list.nodes[list.head as usize].next == NIL);
        assert(list.nodes[list.head as usize].prev == NIL);
        assert(list.head == list.tail);
        assert(list.nodes[list.head as usize].value == 20);
    }

    test remove_from_nonempty_list {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(append(&list, 20));
        assert(append(&list, 30));
        const result = remove(&list, 20);
        assert(result == true);
        assert(list.length == 2);
        assert(list.head != NIL);
        assert(list.tail != NIL);
        assert(list.nodes[list.head as usize].value == 10);
        assert(list.nodes[list.tail as usize].value == 30);
        assert(list.nodes[list.head as usize].next == list.tail);
        assert(list.nodes[list.tail as usize].prev == list.head);
    }

    test deinit_empty_list_does_nothing {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(list.length == 1);
        deinit(&list);
        assert(list.length == 0);
        assert(list.head == NIL);
        assert(list.tail == NIL);
    }

    test deinit_nonempty_list_frees_all_nodes {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(append(&list, 20));
        assert(append(&list, 30));
        deinit(&list);
        assert(list.length == 0);
        assert(list.head == NIL);
        assert(list.tail == NIL);
        assert(list.nodes[0].used == false);
        assert(list.nodes[1].used == false);
        assert(list.nodes[2].used == false);
    }

    // Tests for updated function signatures
    test append_with_value_adds_correct_value {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 42));
        assert(list.length == 1);
        assert(list.head != NIL);
        assert(list.nodes[list.head as usize].value == 42);
        assert(list.head == list.tail);
    }

    test prepend_with_value_adds_correct_value {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(prepend(&list, 42));
        assert(list.length == 1);
        assert(list.head != NIL);
        assert(list.nodes[list.head as usize].value == 42);
        assert(list.head == list.tail);
    }

    test remove_existing_value_returns_true {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(append(&list, 20));
        assert(append(&list, 30));
        const result = remove(&list, 20);
        assert(result == true);
        assert(list.length == 2);
        assert(list.nodes[list.head as usize].value == 10);
        assert(list.nodes[list.tail as usize].value == 30);
    }

    test remove_nonexisting_value_returns_false {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(append(&list, 20));
        const result = remove(&list, 99);
        assert(result == false);
        assert(list.length == 2);
        assert(list.nodes[list.head as usize].value == 10);
        assert(list.nodes[list.tail as usize].value == 20);
    }

    // Tests for each implemented function
    test init_function_creates_empty_list {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(list.head == NIL);
        assert(list.tail == NIL);
        assert(list.length == 0);
        assert(list.nodes.len == 8);
    }

    test append_function_adds_value_to_list {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 42));
        assert(list.length == 1);
        assert(list.head != NIL);
        assert(list.nodes[list.head as usize].value == 42);
        assert(list.head == list.tail);
    }

    test prepend_function_adds_value_to_list {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(prepend(&list, 42));
        assert(list.length == 1);
        assert(list.head != NIL);
        assert(list.nodes[list.head as usize].value == 42);
        assert(list.head == list.tail);
    }

    test remove_function_removes_value_and_returns_true {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        assert(append(&list, 20));
        const result = remove(&list, 10);
        assert(result == true);
        assert(list.length == 1);
        assert(list.nodes[list.head as usize].value == 20);
    }

    test deinit_function_clears_list {
        var pool : [8]ListNode = [blank()] ** 8;
        var list = init(&pool);
        assert(append(&list, 10));
        deinit(&list);
        assert(list.length == 0);
        assert(list.head == NIL);
        assert(list.tail == NIL);
    }

    test append_refuses_when_pool_full {
        var pool : [2]ListNode = [blank()] ** 2;
        var list = init(&pool);
        assert(append(&list, 1));
        assert(prepend(&list, 0));
        assert(append(&list, 2) == false);
        assert(prepend(&list, 3) == false);
        assert(list.length == 2);
    }

    test removed_slot_is_reused {
        var pool : [2]ListNode = [blank()] ** 2;
        var list = init(&pool);
        assert(append(&list, 1));
        assert(append(&list, 2));
        assert(remove(&list, 1));
        assert(append(&list, 3));
        assert(list.length == 2);
        assert(list.nodes[list.head as usize].value == 2);
        assert(list.nodes[list.tail as usize].value == 3);
    }
