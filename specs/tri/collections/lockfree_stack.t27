// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Pop value (sequential model of a Treiber stack over a node pool) | φ² + 1/φ² = 3 | TRINITY

module TriLockfreeStack;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Sequential model of a Treiber stack: nodes live in a caller-provided pool and
    // link by pool index (NIL = -1), `head` is the only mutable entry point. The
    // compare-and-swap of a concurrent version is not modelled here; this spec
    // fixes the push/pop linking order that a CAS loop would publish.
    const NIL : i64 = -1;

    pub const LFNode = struct {
        value : i64,
        next : i64,
        used : bool,
    };

    pub const LockFreeStack = struct {
        nodes : []LFNode,
        head : i64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // blank() → LFNode; an unused pool slot
    fn blank() -> LFNode {
        return LFNode{ .value = 0, .next = -1, .used = false };
    }

    // init(pool) → LockFreeStack; the caller owns the pool, every slot becomes free
    fn init(pool: []LFNode) -> LockFreeStack {
        var i : usize = 0;
        while (i < pool.len) {
            pool[i] = blank();
            i = i + 1;
        }
        return LockFreeStack{ .nodes = pool, .head = -1 };
    }

    // push(s: *LockFreeStack, value: i64) → bool (false = pool full, stack unchanged)
    fn push(s: *LockFreeStack, value: i64) -> bool {
        var i : usize = 0;
        while (i < s.nodes.len) {
            if (s.nodes[i].used == false) {
                s.nodes[i] = LFNode{ .value = value, .next = s.head, .used = true };
                s.head = i as i64;
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // pop(s: *LockFreeStack) → bool (false = stack was empty)
    fn pop(s: *LockFreeStack) -> bool {
        if (s.head < 0) {
            return false;
        }
        const h : usize = s.head as usize;
        const next : i64 = s.nodes[h].next;
        s.nodes[h] = blank();
        s.head = next;
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (pool of 4 nodes)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(stack.head == NIL);
        assert(stack.nodes.len == 4);
    }

    test push_basic_case {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        const ok = push(&stack, 7);
        assert(ok);
        assert(stack.head != NIL);
    }

    test pop_basic_case {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(push(&stack, 7));
        const ok = pop(&stack);
        assert(ok);
        assert(stack.head == NIL);
    }

    test init_returns_valid_stack {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(stack.head == NIL);
        assert(stack.nodes[0].used == false);
    }

    test push_adds_node_to_stack {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(push(&stack, 42));
        assert(stack.head != NIL);
        assert(stack.nodes[stack.head as usize].value == 42);
        assert(stack.nodes[stack.head as usize].next == NIL);
    }

    test push_links_new_node_above_old_head {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(push(&stack, 1));
        const first : i64 = stack.head;
        assert(push(&stack, 2));
        assert(stack.head != first);
        assert(stack.nodes[stack.head as usize].value == 2);
        assert(stack.nodes[stack.head as usize].next == first);
    }

    test pop_removes_node_from_stack {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(push(&stack, 42));
        assert(pop(&stack));
        assert(stack.head == NIL);
    }

    test pop_restores_previous_head {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(push(&stack, 1));
        assert(push(&stack, 2));
        assert(pop(&stack));
        assert(stack.nodes[stack.head as usize].value == 1);
    }

    test pop_on_empty_stack_returns_false {
        var pool : [4]LFNode = [blank()] ** 4;
        var stack = init(&pool);
        assert(pop(&stack) == false);
        assert(stack.head == NIL);
    }

    test push_refuses_when_pool_full {
        var pool : [2]LFNode = [blank()] ** 2;
        var stack = init(&pool);
        assert(push(&stack, 1));
        assert(push(&stack, 2));
        assert(push(&stack, 3) == false);
        assert(stack.nodes[stack.head as usize].value == 2);
    }
