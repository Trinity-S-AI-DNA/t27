// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Combines multiple types | φ² + 1/φ² = 3 | TRINITY

module TriTuple;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Tuple2(A, B) = struct {
        first : A,
        second : B,
    };

    pub const Tuple3(A, B, C) = struct {
        first : A,
        second : B,
        third : C,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // pair(a: A, b: B) → Tuple2(A, B); A and B bind at the fn level (#11940
    // sub-slice 1) -- call sites pass both types explicitly: pair(i64, f64, 1, 2.5)
    fn pair(comptime A: type, comptime B: type, a: A, b: B) -> Tuple2(A, B) {
        return Tuple2(A, B){ .first = a, .second = b };
    }

    // triple(a: A, b: B, c: C) → Tuple3(A, B, C)
    fn triple(comptime A: type, comptime B: type, comptime C: type, a: A, b: B, c: C) -> Tuple3(A, B, C) {
        return Tuple3(A, B, C){ .first = a, .second = b, .third = c };
    }

    // fst(pair: Tuple2(A, B)) → A
    fn fst(comptime A: type, comptime B: type, pair: Tuple2(A, B)) -> A {
        return pair.first;
    }

    // snd(pair: Tuple2(A, B)) → B
    fn snd(comptime A: type, comptime B: type, pair: Tuple2(A, B)) -> B {
        return pair.second;
    }

    // swap(t: Tuple2(A, B)) → Tuple2(B, A)
    fn swap(comptime A: type, comptime B: type, t: Tuple2(A, B)) -> Tuple2(B, A) {
        return Tuple2(B, A){ .first = t.second, .second = t.first };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "pair_puts_its_arguments_in_declaration_order" {
        const t = pair(i64, i64, 1, 2);
        assert(t.first == 1);
        assert(t.second == 2);
    }

    test "triple_puts_all_three_arguments_in_first_second_third_order" {
        const t = triple(i64, i64, i64, 10, 20, 30);
        assert(t.first == 10);
        assert(t.second == 20);
        assert(t.third == 30);
    }

    test "fst_returns_the_first_component_of_a_pair" {
        const t = pair(i64, i64, 100, 200);
        assert(fst(i64, i64, t) == 100);
    }

    test "snd_returns_the_second_component_of_a_pair" {
        const t = pair(i64, i64, 100, 200);
        assert(snd(i64, i64, t) == 200);
    }

    test "fst_projection_law_fst_pair_a_b_equals_a" {
        const a = 5;
        const b = 10;
        assert(fst(i64, i64, pair(i64, i64, a, b)) == a);
    }

    test "snd_projection_law_snd_pair_a_b_equals_b" {
        const a = 5;
        const b = 10;
        assert(snd(i64, i64, pair(i64, i64, a, b)) == b);
    }

    test "rebuilding_a_pair_from_its_projections_is_the_identity" {
        const t = pair(i64, i64, 15, 25);
        const again = pair(i64, i64, fst(i64, i64, t), snd(i64, i64, t));
        assert(again.first == t.first);
        assert(again.second == t.second);
    }

    test "order_matters_pair_1_2_differs_from_pair_2_1" {
        const t1 = pair(i64, i64, 1, 2);
        const t2 = pair(i64, i64, 2, 1);
        assert(t1.first != t2.first);
        assert(t1.second != t2.second);
    }

    test "swapping_twice_is_the_identity" {
        const t = pair(i64, i64, 10, 20);
        const swapped = swap(i64, i64, t);
        const swapped_back = swap(i64, i64, swapped);
        assert(swapped_back.first == t.first);
        assert(swapped_back.second == t.second);
    }