// t27/specs/
// Min-priority queue over caller-provided storage (binary heap) | φ² + 1/φ² = 3 | TRINITY

module TriPriorityQueue;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // A binary min-heap: the stored i64 is its own priority and the smallest value
    // is dequeued first. data[0..size] is the heap; the rest of data is spare room.
    pub const PriorityQueue = struct {
        data : []i64,
        size : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(storage) → PriorityQueue; the caller owns the storage
    fn init(storage: []i64) -> PriorityQueue {
        return PriorityQueue{ .data = storage, .size = 0 };
    }

    // enqueue(pq: *PriorityQueue, value: i64) → bool (false = full, unchanged)
    fn enqueue(pq: *PriorityQueue, value: i64) -> bool {
        if (pq.size >= pq.data.len) {
            return false;
        }
        // Sift the new value up from the first free slot
        var i : usize = pq.size;
        pq.size = pq.size + 1;
        while (i > 0) {
            const parent : usize = (i - 1) / 2;
            if (pq.data[parent] <= value) {
                break;
            }
            pq.data[i] = pq.data[parent];
            i = parent;
        }
        pq.data[i] = value;
        return true;
    }

    // dequeue(pq: *PriorityQueue) → ?i64; removes and returns the smallest value
    fn dequeue(pq: *PriorityQueue) -> ?i64 {
        if (pq.size == 0) {
            return null;
        }
        const top : i64 = pq.data[0];
        pq.size = pq.size - 1;
        if (pq.size > 0) {
            // Sift the last value down from the root
            const last : i64 = pq.data[pq.size];
            var i : usize = 0;
            while (true) {
                var child : usize = 2 * i + 1;
                if (child >= pq.size) {
                    break;
                }
                if (child + 1 < pq.size and pq.data[child + 1] < pq.data[child]) {
                    child = child + 1;
                }
                if (last <= pq.data[child]) {
                    break;
                }
                pq.data[i] = pq.data[child];
                i = child;
            }
            pq.data[i] = last;
        }
        return top;
    }

    // peek(pq: PriorityQueue) → ?i64; the smallest value, left in place
    fn peek(pq: PriorityQueue) -> ?i64 {
        if (pq.size == 0) {
            return null;
        }
        return pq.data[0];
    }

    // is_empty(pq: PriorityQueue) → bool
    fn is_empty(pq: PriorityQueue) -> bool {
        return pq.size == 0;
    }

    // deinit(pq: *PriorityQueue) → void
    // The storage belongs to the caller; the queue only forgets it.
    fn deinit(pq: *PriorityQueue) -> void {
        pq.data = pq.data[0..0];
        pq.size = 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var storage : [8]i64 = [0] ** 8;
        const pq = init(&storage);
        assert(pq.size == 0);
        assert(pq.data.len == 8);
    }

    test enqueue_basic_case {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        const ok = enqueue(&pq, 5);
        assert(ok);
        assert(pq.size == 1);
        assert(peek(pq) == 5);
    }

    test dequeue_basic_case {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        assert(enqueue(&pq, 5));
        const top = dequeue(&pq);
        assert(top == 5);
        assert(pq.size == 0);
    }

    test peek_basic_case {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        assert(peek(pq) == null);
        assert(enqueue(&pq, 9));
        assert(enqueue(&pq, 4));
        assert(peek(pq) == 4);
        assert(pq.size == 2);
    }

    test is_empty_basic_case {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        assert(is_empty(pq) == true);
        assert(enqueue(&pq, 1));
        assert(is_empty(pq) == false);
    }

    test deinit_basic_case {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        assert(enqueue(&pq, 1));
        deinit(&pq);
        assert(pq.size == 0);
        assert(pq.data.len == 0);
    }

    test dequeue_returns_values_in_priority_order {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        assert(enqueue(&pq, 30));
        assert(enqueue(&pq, 10));
        assert(enqueue(&pq, 50));
        assert(enqueue(&pq, 20));
        assert(enqueue(&pq, 40));
        assert(dequeue(&pq) == 10);
        assert(dequeue(&pq) == 20);
        assert(dequeue(&pq) == 30);
        assert(dequeue(&pq) == 40);
        assert(dequeue(&pq) == 50);
        assert(is_empty(pq));
    }

    test dequeue_on_empty_queue_returns_null {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        assert(dequeue(&pq) == null);
        assert(pq.size == 0);
    }

    test duplicates_are_all_returned {
        var storage : [8]i64 = [0] ** 8;
        var pq = init(&storage);
        assert(enqueue(&pq, 2));
        assert(enqueue(&pq, 2));
        assert(enqueue(&pq, 1));
        assert(dequeue(&pq) == 1);
        assert(dequeue(&pq) == 2);
        assert(dequeue(&pq) == 2);
        assert(dequeue(&pq) == null);
    }

    test enqueue_refuses_when_full {
        var storage : [2]i64 = [0] ** 2;
        var pq = init(&storage);
        assert(enqueue(&pq, 1));
        assert(enqueue(&pq, 2));
        assert(enqueue(&pq, 3) == false);
        assert(pq.size == 2);
    }
