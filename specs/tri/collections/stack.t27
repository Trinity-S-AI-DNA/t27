// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Last-in-first-out ordering (i64 items, caller-provided storage) | φ² + 1/φ² = 3 | TRINITY

module TriStack;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // items is the caller's storage; items[0..size] holds the stack, bottom first.
    pub const Stack = struct {
        items : []i64,
        size : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // empty(storage) → Stack
    fn empty(storage: []i64) -> Stack {
        return Stack{ .items = storage, .size = 0 };
    }

    // push(stack: *Stack, value: i64) → bool (false = storage full, unchanged)
    fn push(stack: *Stack, value: i64) -> bool {
        if (stack.size >= stack.items.len) {
            return false;
        }
        stack.items[stack.size] = value;
        stack.size = stack.size + 1;
        return true;
    }

    // pop(stack: *Stack) → ?i64
    fn pop(stack: *Stack) -> ?i64 {
        if (stack.size == 0) {
            return null;
        }
        stack.size = stack.size - 1;
        return stack.items[stack.size];
    }

    // peek(stack: Stack) → ?i64
    fn peek(stack: Stack) -> ?i64 {
        if (stack.size == 0) {
            return null;
        }
        return stack.items[stack.size - 1];
    }

    // is_empty(stack: Stack) → bool
    fn is_empty(stack: Stack) -> bool {
        return stack.size == 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test empty_stack_has_length_zero_and_is_empty {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(is_empty(stack) == true);
        assert(stack.size == 0);
    }

    test is_empty_returns_false_after_one_push {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(push(&stack, 42));
        assert(is_empty(stack) == false);
    }

    test push_puts_value_on_top_and_grows_length_by_one {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(push(&stack, 10));
        assert(stack.size == 1);
        assert(peek(stack) == 10);
    }

    test two_pushes_come_back_in_lifo_order {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(push(&stack, 1));
        assert(push(&stack, 2));
        assert(peek(stack) == 2);
        assert(pop(&stack) == 2);
        assert(peek(stack) == 1);
    }

    test peek_returns_top_without_changing_length {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(push(&stack, 5));
        const original_length = stack.size;
        const top_value = peek(stack);
        assert(top_value == 5);
        assert(stack.size == original_length);
    }

    test peek_on_empty_stack_returns_null {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(peek(stack) == null);
    }

    test pop_on_empty_stack_returns_null_and_leaves_stack_empty {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(pop(&stack) == null);
        assert(is_empty(stack) == true);
        assert(stack.size == 0);
    }

    test popping_only_element_returns_stack_to_empty {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(push(&stack, 99));
        assert(pop(&stack) == 99);
        assert(is_empty(stack) == true);
        assert(stack.size == 0);
    }

    test push_pop_cycle_preserves_original_length {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(push(&stack, 7));
        const original_length = stack.size;
        assert(pop(&stack) == 7);
        assert(stack.size == original_length - 1);
        assert(stack.size == 0);
    }

    test multiple_push_pop_operations_work_correctly {
        var storage : [8]i64 = [0] ** 8;
        var stack = empty(&storage);
        assert(push(&stack, 1));
        assert(push(&stack, 2));
        assert(push(&stack, 3));
        assert(pop(&stack) == 3);
        assert(pop(&stack) == 2);
        assert(pop(&stack) == 1);
        assert(is_empty(stack) == true);
    }

    test push_refuses_when_storage_full {
        var storage : [2]i64 = [0] ** 2;
        var stack = empty(&storage);
        assert(push(&stack, 1));
        assert(push(&stack, 2));
        assert(push(&stack, 3) == false);
        assert(stack.size == 2);
        assert(peek(stack) == 2);
    }
