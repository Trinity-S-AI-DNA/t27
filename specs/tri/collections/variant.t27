module TriVariant;

// A tag name paired with an i64 payload (the generic T of the original, fixed to i64).
pub const Variant = struct {
    pub tag : []const u8,
    pub value : i64,
};

// tag_equals(a, b) → bool; byte-wise comparison of two tag names
fn tag_equals(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn make(tag: []const u8, value: i64) Variant {
    return Variant{ .tag = tag, .value = value };
}

pub fn get_tag(variant: Variant) []const u8 {
    return variant.tag;
}

// match(variant, tag, otherwise) → the payload when the variant carries `tag`,
// otherwise the `otherwise` value. (The original took a handler Map that no type
// in this module defines; selecting by tag is what a handler lookup reduces to.)
pub fn match(variant: Variant, tag: []const u8, otherwise: i64) i64 {
    if (tag_equals(variant.tag, tag)) {
        return variant.value;
    }
    return otherwise;
}

test "make_basic_case" {
    const v = make("circle", 7);
    assert(v.value == 7);
    assert(v.tag.len == 6);
    assert(tag_equals(v.tag, "circle"));
}

test "get_tag_basic_case" {
    const v = make("square", 4);
    const t = get_tag(v);
    assert(tag_equals(t, "square"));
    assert(tag_equals(t, "circle") == false);
}

test "match_basic_case" {
    const v = make("circle", 7);
    assert(match(v, "circle", -1) == 7);
    assert(match(v, "square", -1) == -1);
}

test "tag_equals_distinguishes_prefixes_and_lengths" {
    assert(tag_equals("ab", "ab"));
    assert(tag_equals("ab", "abc") == false);
    assert(tag_equals("ab", "ac") == false);
    assert(tag_equals("", ""));
}
