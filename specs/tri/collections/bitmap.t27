// t27/specs/
// Uses 64-bit words for efficiency (caller-provided storage) | φ² + 1/φ² = 3 | TRINITY

module TriBitmap;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Bitmap = struct {
        bits : []u64,
        capacity : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(capacity, storage) -> Bitmap; storage must hold (capacity + 63) / 64 words
    fn init(capacity: usize, storage: []u64) -> Bitmap {
        var i : usize = 0;
        while (i < storage.len) {
            storage[i] = 0;
            i = i + 1;
        }
        return Bitmap{ .bits = storage, .capacity = capacity };
    }

    // get(bitmap: Bitmap, index: usize) -> bool
    fn get(bitmap: Bitmap, index: usize) -> bool {
        if (index >= bitmap.capacity) { return false; }
        const word_index : usize = index / 64;
        const bit_index : u32 = (index % 64) as u32;
        const word : u64 = bitmap.bits[word_index];
        return (word & ((1 as u64) << bit_index)) != 0;
    }

    // set(bitmap: *Bitmap, index: usize) -> void
    fn set(bitmap: *Bitmap, index: usize) -> void {
        const word_index : usize = index / 64;
        const bit_index : u32 = (index % 64) as u32;
        bitmap.bits[word_index] = bitmap.bits[word_index] | ((1 as u64) << bit_index);
    }

    // clear(bitmap: *Bitmap, index: usize) -> void
    fn clear(bitmap: *Bitmap, index: usize) -> void {
        const word_index : usize = index / 64;
        const bit_index : u32 = (index % 64) as u32;
        bitmap.bits[word_index] = bitmap.bits[word_index] & ~((1 as u64) << bit_index);
    }

    // flip(bitmap: *Bitmap, index: usize) -> void
    fn flip(bitmap: *Bitmap, index: usize) -> void {
        const word_index : usize = index / 64;
        const bit_index : u32 = (index % 64) as u32;
        bitmap.bits[word_index] = bitmap.bits[word_index] ^ ((1 as u64) << bit_index);
    }

    // set_all(bitmap: *Bitmap) -> void; bits at or above capacity stay clear
    fn set_all(bitmap: *Bitmap) -> void {
        var w : usize = 0;
        while (w < bitmap.capacity / 64) {
            bitmap.bits[w] = ~(0 as u64);
            w = w + 1;
        }
        const remaining_bits : u32 = (bitmap.capacity % 64) as u32;
        if (remaining_bits > 0) {
            const mask : u64 = ((1 as u64) << remaining_bits) - 1;
            bitmap.bits[bitmap.capacity / 64] = mask;
        }
    }

    // clear_all(bitmap: *Bitmap) -> void
    fn clear_all(bitmap: *Bitmap) -> void {
        var w : usize = 0;
        while (w < (bitmap.capacity + 63) / 64) {
            bitmap.bits[w] = 0;
            w = w + 1;
        }
    }

    // count(bitmap: Bitmap) -> usize
    fn count(bitmap: Bitmap) -> usize {
        var total : usize = 0;
        var idx : usize = 0;
        while (idx < bitmap.capacity) {
            if (get(bitmap, idx)) {
                total = total + 1;
            }
            idx = idx + 1;
        }
        return total;
    }

    // find_first(bitmap: Bitmap) -> ?usize
    fn find_first(bitmap: Bitmap) -> ?usize {
        var idx : usize = 0;
        while (idx < bitmap.capacity) {
            if (get(bitmap, idx)) {
                return idx;
            }
            idx = idx + 1;
        }
        return null;
    }

    // find_last(bitmap: Bitmap) -> ?usize
    fn find_last(bitmap: Bitmap) -> ?usize {
        var idx : usize = bitmap.capacity;
        while (idx > 0) {
            idx = idx - 1;
            if (get(bitmap, idx)) {
                return idx;
            }
        }
        return null;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors); storage is caller-provided
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        assert(bitmap.capacity == 64);
        assert(bitmap.bits.len == 1);
        assert(count(bitmap) == 0);
    }

    test get_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        const result = get(bitmap, 0);
        assert(result == false);
    }

    test set_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        set(&bitmap, 0);
        assert(get(bitmap, 0) == true);
        assert(get(bitmap, 1) == false);
    }

    test clear_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        set(&bitmap, 0);
        assert(get(bitmap, 0) == true);
        clear(&bitmap, 0);
        assert(get(bitmap, 0) == false);
    }

    test flip_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        flip(&bitmap, 0);
        assert(get(bitmap, 0) == true);
    }

    test set_all_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        set_all(&bitmap);
        assert(get(bitmap, 0) == true);
        assert(get(bitmap, 63) == true);
        assert(count(bitmap) == 64);
    }

    test clear_all_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        set_all(&bitmap);
        assert(get(bitmap, 0) == true);
        clear_all(&bitmap);
        assert(get(bitmap, 0) == false);
        assert(get(bitmap, 63) == false);
    }

    test count_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        const result = count(bitmap);
        assert(result == 0);
    }

    test find_first_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        const result = find_first(bitmap);
        assert(result == null);
    }

    test find_last_basic_case {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        const result = find_last(bitmap);
        assert(result == null);
    }

    test init_edge_cases {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(1, &words);
        assert(bitmap.capacity == 1);
        set(&bitmap, 0);
        assert(count(bitmap) == 1);
        assert(get(bitmap, 1) == false);
    }

    test get_multiple_bits {
        var words : [2]u64 = [0] ** 2;
        var bitmap = init(128, &words);
        set(&bitmap, 0);
        set(&bitmap, 63);
        set(&bitmap, 64);
        set(&bitmap, 127);
        assert(get(bitmap, 0) == true);
        assert(get(bitmap, 63) == true);
        assert(get(bitmap, 64) == true);
        assert(get(bitmap, 127) == true);
        assert(get(bitmap, 1) == false);
    }

    test set_and_clear_interaction {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        set(&bitmap, 0);
        set(&bitmap, 1);
        clear(&bitmap, 0);
        assert(get(bitmap, 0) == false);
        assert(get(bitmap, 1) == true);
    }

    test flip_toggle_behavior {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        flip(&bitmap, 0);
        assert(get(bitmap, 0) == true);
        flip(&bitmap, 0);
        assert(get(bitmap, 0) == false);
    }

    test set_all_and_clear_all {
        var words : [2]u64 = [0] ** 2;
        var bitmap = init(96, &words);
        set_all(&bitmap);
        assert(count(bitmap) == 96);
        clear_all(&bitmap);
        assert(count(bitmap) == 0);
    }

    test count_partial_words {
        var words : [2]u64 = [0] ** 2;
        var bitmap = init(96, &words);
        set(&bitmap, 0);
        set(&bitmap, 1);
        set(&bitmap, 64);
        set(&bitmap, 65);
        set(&bitmap, 95);
        assert(count(bitmap) == 5);
    }

    test find_first_set_bit {
        var words : [2]u64 = [0] ** 2;
        var bitmap = init(128, &words);
        set(&bitmap, 5);
        set(&bitmap, 10);
        set(&bitmap, 127);
        assert(find_first(bitmap) == 5);
    }

    test find_last_set_bit {
        var words : [2]u64 = [0] ** 2;
        var bitmap = init(128, &words);
        set(&bitmap, 5);
        set(&bitmap, 10);
        set(&bitmap, 127);
        assert(find_last(bitmap) == 127);
    }

    test find_first_no_bits_set {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        const result = find_first(bitmap);
        assert(result == null);
    }

    test find_last_no_bits_set {
        var words : [1]u64 = [0] ** 1;
        var bitmap = init(64, &words);
        const result = find_last(bitmap);
        assert(result == null);
    }

    test find_first_middle_bit {
        var words : [2]u64 = [0] ** 2;
        var bitmap = init(128, &words);
        set(&bitmap, 32);
        set(&bitmap, 33);
        assert(find_first(bitmap) == 32);
    }

    test find_last_middle_bit {
        var words : [2]u64 = [0] ** 2;
        var bitmap = init(128, &words);
        set(&bitmap, 32);
        set(&bitmap, 33);
        assert(find_last(bitmap) == 33);
    }
