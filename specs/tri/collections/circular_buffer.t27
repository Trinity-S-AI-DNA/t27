// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Free buffer | φ² + 1/φ² = 3 | TRINITY

module TriCircularBuffer;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // The caller provides the storage (a slice of i64); no allocator is needed.
    pub const CircularBuffer = struct {
        data : []i64,
        head : usize,
        tail : usize,
        capacity : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(storage: []i64) → CircularBuffer
    // One slot is kept free to tell full from empty, so the buffer holds
    // capacity - 1 values.
    fn init(storage: []i64) -> CircularBuffer {
        return CircularBuffer{
            .data = storage,
            .head = 0,
            .tail = 0,
            .capacity = storage.len,
        };
    }

    // write(buf: *CircularBuffer, value: i64) → bool
    // false (and nothing written) when the buffer is full
    fn write(buf: *CircularBuffer, value: i64) -> bool {
        // Check if buffer is full
        if ((buf.tail + 1) % buf.capacity == buf.head) {
            return false;
        }

        // Write the value at tail position
        buf.data[buf.tail] = value;

        // Advance tail (with wrap-around)
        buf.tail = (buf.tail + 1) % buf.capacity;
        return true;
    }

    // read(buf: *CircularBuffer) → i64
    fn read(buf: *CircularBuffer) -> i64 {
        // Check if buffer is empty
        if (buf.head == buf.tail) {
            @panic("Attempted to read from empty circular buffer");
        }

        // Read the value at head position
        const value: i64 = buf.data[buf.head];

        // Advance head (with wrap-around)
        buf.head = (buf.head + 1) % buf.capacity;

        return value;
    }

    // is_empty(buf: *CircularBuffer) → bool
    fn is_empty(buf: *CircularBuffer) -> bool {
        return buf.head == buf.tail;
    }

    // deinit(buf: *CircularBuffer) → void
    // The storage belongs to the caller; the buffer only forgets it.
    fn deinit(buf: *CircularBuffer) -> void {
        buf.data = buf.data[0..0];
        buf.head = 0;
        buf.tail = 0;
        buf.capacity = 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var storage : [10]i64 = [0] ** 10;
        const result = init(&storage);
        assert(result.data.len == 10);
        assert(result.head == 0);
        assert(result.tail == 0);
        assert(result.capacity == 10);
    }

    test write_basic_case {
        var storage : [5]i64 = [0] ** 5;
        var buffer = init(&storage);
        assert(write(&buffer, 42));
        assert(buffer.data[0] == 42);
        assert(buffer.head == 0);
        assert(buffer.tail == 1);
    }

    test read_basic_case {
        var storage : [5]i64 = [0] ** 5;
        var buffer = init(&storage);
        assert(write(&buffer, 42));
        const read_result = read(&buffer);
        assert(read_result == 42);
        assert(buffer.head == 1);
        assert(buffer.tail == 1);
    }

    test is_empty_basic_case {
        var storage : [5]i64 = [0] ** 5;
        var buffer = init(&storage);
        const empty_result1 = is_empty(&buffer);
        assert(write(&buffer, 42));
        const empty_result2 = is_empty(&buffer);
        const read_result = read(&buffer);
        const empty_result3 = is_empty(&buffer);
        assert(empty_result1 == true);
        assert(empty_result2 == false);
        assert(empty_result3 == true);
        assert(read_result == 42);
    }

    test deinit_basic_case {
        var storage : [5]i64 = [0] ** 5;
        var buffer = init(&storage);
        assert(write(&buffer, 42));
        assert(buffer.tail == 1);
        deinit(&buffer);
        assert(buffer.capacity == 0);
        assert(buffer.head == 0);
        assert(buffer.tail == 0);
        assert(buffer.data.len == 0);
    }

    test write_refuses_when_full {
        var storage : [3]i64 = [0] ** 3;
        var buffer = init(&storage);
        assert(write(&buffer, 1));
        assert(write(&buffer, 2));
        assert(!write(&buffer, 3));
        assert(read(&buffer) == 1);
        assert(write(&buffer, 3));
        assert(read(&buffer) == 2);
        assert(read(&buffer) == 3);
        assert(is_empty(&buffer));
    }
