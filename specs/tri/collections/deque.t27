// t27/specs/
// Free deque | φ² + 1/φ² = 3 | TRINITY

module TriDeque;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Deque = struct {
        data : []i64,
        front : usize,
        back : usize,
        size : usize,
        capacity : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(storage) → Deque; the caller owns the storage, capacity = storage.len
    fn init(storage: []i64) -> Deque {
        return Deque{ .data = storage, .front = 0, .back = 0, .size = 0, .capacity = storage.len };
    }

    // push_front(deque: *Deque, value: i64) → bool (false = full, deque unchanged)
    fn push_front(deque: *Deque, value: i64) -> bool {
        if (deque.size >= deque.capacity) {
            return false;
        }
        deque.front = (deque.front + deque.capacity - 1) % deque.capacity;
        deque.data[deque.front] = value;
        deque.size = deque.size + 1;
        return true;
    }

    // push_back(deque: *Deque, value: i64) → bool (false = full, deque unchanged)
    fn push_back(deque: *Deque, value: i64) -> bool {
        if (deque.size >= deque.capacity) {
            return false;
        }
        deque.data[deque.back] = value;
        deque.back = (deque.back + 1) % deque.capacity;
        deque.size = deque.size + 1;
        return true;
    }

    // pop_front(deque: *Deque) → i64
    fn pop_front(deque: *Deque) -> i64 {
        if (deque.size == 0) {
            return 0; // Default value for empty deque
        }
        const value : i64 = deque.data[deque.front];
        deque.front = (deque.front + 1) % deque.capacity;
        deque.size = deque.size - 1;
        return value;
    }

    // pop_back(deque: *Deque) → i64
    fn pop_back(deque: *Deque) -> i64 {
        if (deque.size == 0) {
            return 0; // Default value for empty deque
        }
        deque.back = (deque.back + deque.capacity - 1) % deque.capacity;
        const value : i64 = deque.data[deque.back];
        deque.size = deque.size - 1;
        return value;
    }

    // deinit(deque: *Deque) → void
    // The storage belongs to the caller; the deque only forgets it.
    fn deinit(deque: *Deque) -> void {
        deque.data = deque.data[0..0];
        deque.front = 0;
        deque.back = 0;
        deque.size = 0;
        deque.capacity = 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (storage is caller-provided, capacity 16)
    // ═══════════════════════════════════════════════════════════

    test init_returns_valid_deque {
        var storage : [16]i64 = [0] ** 16;
        var result = init(&storage);
        assert(result.data.len == 16);
        assert(result.capacity == 16);
        assert(result.size == 0);
        assert(result.front == 0);
        assert(result.back == 0);
    }

    test push_front_adds_value_to_front {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        const result = push_front(&deque, 42);
        assert(result);
        assert(deque.size == 1);
        assert(deque.data[deque.front] == 42);
    }

    test push_back_adds_value_to_back {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        const result = push_back(&deque, 24);
        assert(result);
        assert(deque.size == 1);
        assert(deque.data[deque.back - 1] == 24);
    }

    test push_front_multiple_maintains_order {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        assert(push_front(&deque, 3));
        assert(push_front(&deque, 2));
        assert(push_front(&deque, 1));
        assert(deque.size == 3);
        assert(deque.data[deque.front] == 1);
        assert(deque.data[(deque.front + 1) % deque.capacity] == 2);
        assert(deque.data[(deque.front + 2) % deque.capacity] == 3);
    }

    test push_back_multiple_maintains_order {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        assert(push_back(&deque, 10));
        assert(push_back(&deque, 20));
        assert(push_back(&deque, 30));
        assert(deque.size == 3);
        assert(deque.data[deque.back - 3] == 10);
        assert(deque.data[deque.back - 2] == 20);
        assert(deque.data[deque.back - 1] == 30);
    }

    test pop_front_removes_and_returns_front_value {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        assert(push_front(&deque, 100));
        assert(push_front(&deque, 200));
        const result = pop_front(&deque);
        assert(result == 200);
        assert(deque.size == 1);
        assert(deque.data[deque.front] == 100);
    }

    test pop_back_removes_and_returns_back_value {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        assert(push_back(&deque, 500));
        assert(push_back(&deque, 600));
        const result = pop_back(&deque);
        assert(result == 600);
        assert(deque.size == 1);
        assert(deque.data[deque.back - 1] == 500);
    }

    test pop_front_from_empty_deque {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        const result = pop_front(&deque);
        assert(result == 0);
        assert(deque.size == 0);
    }

    test pop_back_from_empty_deque {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        const result = pop_back(&deque);
        assert(result == 0);
        assert(deque.size == 0);
    }

    test fifo_behavior_with_push_front_pop_back {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        assert(push_front(&deque, 1));
        assert(push_front(&deque, 2));
        assert(push_front(&deque, 3));
        const result1 = pop_back(&deque);
        const result2 = pop_back(&deque);
        const result3 = pop_back(&deque);
        assert(result1 == 1);
        assert(result2 == 2);
        assert(result3 == 3);
        assert(deque.size == 0);
    }

    test fifo_behavior_with_push_back_pop_front {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        assert(push_back(&deque, 10));
        assert(push_back(&deque, 20));
        assert(push_back(&deque, 30));
        const result1 = pop_front(&deque);
        const result2 = pop_front(&deque);
        const result3 = pop_front(&deque);
        assert(result1 == 10);
        assert(result2 == 20);
        assert(result3 == 30);
        assert(deque.size == 0);
    }

    test deinit_frees_memory {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        assert(push_front(&deque, 123));
        assert(deque.size == 1);
        deinit(&deque);
        assert(deque.size == 0);
        assert(deque.capacity == 0);
        assert(deque.data.len == 0);
    }

    test overflow_on_push_front_full_deque {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        var k : i64 = 1;
        while (k <= 16) {
            assert(push_front(&deque, k));
            k = k + 1;
        }
        assert(deque.size == 16);
        const result = push_front(&deque, 17);
        assert(result == false);
        assert(deque.size == 16);
    }

    test overflow_on_push_back_full_deque {
        var storage : [16]i64 = [0] ** 16;
        var deque = init(&storage);
        var k : i64 = 1;
        while (k <= 16) {
            assert(push_back(&deque, k));
            k = k + 1;
        }
        assert(deque.size == 16);
        const result = push_back(&deque, 17);
        assert(result == false);
        assert(deque.size == 16);
    }

    test wraps_around_in_both_directions {
        var storage : [4]i64 = [0] ** 4;
        var deque = init(&storage);
        assert(push_front(&deque, 1));
        assert(deque.front == 3);
        assert(push_back(&deque, 2));
        assert(pop_back(&deque) == 2);
        assert(pop_back(&deque) == 1);
        assert(deque.size == 0);
    }
