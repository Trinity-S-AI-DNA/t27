// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Forces checking error case | φ² + 1/φ² = 3 | TRINITY

module TriResult;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // The error type parameter is named Err, not E: the use-resolved source
    // inlines math::constants' Euler number `const E : f64 = 2.718...`, and
    // Zig rejects a type parameter that shadows a file-level declaration.
    // This collision was result.t27's own first defect, ahead of the generic
    // scoping one.
    pub const Result(T, Err) = struct {
        is_ok : bool,
        value : T,
        // Named `err`, not `error`: `error` is a Zig keyword and the emitter
        // writes field names verbatim, so the old name never compiled. The
        // unquoted-keyword emitter gap is recorded in the PR.
        err : Err,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // ok(value: T) → Result(T, Err); T and Err bind at the fn level (#11940
    // sub-slice 1) -- call sites pass both types: ok(i64, i64, 7)
    fn ok(comptime T: type, comptime Err: type, value: T) -> Result(T, Err) {
        return Result(T, Err){ .is_ok = true, .value = value, .err = undefined };
    }

    // err(error: Err) → Result(T, Err)
    fn err(comptime T: type, comptime Err: type, err_value: Err) -> Result(T, Err) {
        return Result(T, Err){ .is_ok = false, .err = err_value, .value = undefined };
    }

    // unwrap_or(result: Result(T, Err), fallback: T) → T
    fn unwrap_or(comptime T: type, comptime Err: type, result: Result(T, Err), fallback: T) -> T {
        if (result.is_ok) {
            return result.value;
        } else {
            return fallback;
        }
    }

    // is_error(result: Result(T, Err)) → bool
    fn is_error(comptime T: type, comptime Err: type, result: Result(T, Err)) -> bool {
        return !result.is_ok;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "ok_sets_is_ok_true_and_carries_the_value" {
        var r = ok(i64, i64, 7);
        assert(r.is_ok == true);
        assert(r.value == 7);
    }

    test "ok_result_is_not_an_error" {
        // The old body asserted `r.err == undefined`, which Zig rejects
        // (comparing against undefined is illegal behavior); the observable
        // fact of an unset err on an ok result is is_error == false.
        var r = ok(i64, i64, 42);
        assert(is_error(i64, i64, r) == false);
    }

    test "err_sets_is_ok_false_and_carries_the_error" {
        // i64 error code: the string payload version needs []const u8 as an
        // explicit type argument, which the grammar cannot pass yet (the
        // defect recorded in maybe.t27).
        var r = err(i64, i64, 99);
        assert(r.is_ok == false);
        assert(r.err == 99);
    }

    test "err_result_is_an_error" {
        var r = err(i64, i64, 99);
        assert(is_error(i64, i64, r) == true);
    }

    test "unwrap_or_returns_the_value_on_ok_result" {
        var r = ok(i64, i64, 123);
        assert(is_error(i64, i64, r) == false);
        assert(unwrap_or(i64, i64, r, 456) == 123);
    }

    test "unwrap_or_returns_the_fallback_on_error_result" {
        var r = err(i64, i64, 1);
        assert(is_error(i64, i64, r) == true);
        assert(unwrap_or(i64, i64, r, 789) == 789);
    }

    test "is_error_returns_false_on_ok_result" {
        var r = ok(i64, i64, 1);
        assert(is_error(i64, i64, r) == false);
    }

    test "is_error_returns_true_on_error_result" {
        var r = err(i64, i64, 1);
        assert(is_error(i64, i64, r) == true);
    }

    test "unwrap_or_fallback_differs_from_carried_value" {
        var r = ok(i64, i64, 100);
        assert(unwrap_or(i64, i64, r, 200) == 100);
        assert(unwrap_or(i64, i64, r, 200) != 200);
    }

    test "unwrap_or_error_payload_never_returned" {
        var r = err(i64, i64, 1);
        assert(unwrap_or(i64, i64, r, 2) == 2);
        assert(unwrap_or(i64, i64, r, 2) != 1);
    }

