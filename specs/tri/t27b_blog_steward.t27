// SPDX-License-Identifier: Apache-2.0
// specs/tri/t27b_blog_steward.t27 -- t27b blog steward: continuous loop card,
// progress post written in t27 on t27.ai.
// Part of M3 milestone (milestone #7). Closes #12869 #12868 #12867 #12866.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::t27b_blog_steward;

pub const T27B_BLOG_STEWARD_MAX_POSTS : u32 = 23;

pub struct BlogPost { title: str, on_t27_ai: bool };

pub fn blog_post_on_t27_ai(p: BlogPost) -> bool {
    return p.on_t27_ai;
}

test "blog_post_on_t27_ai" {
    assert(blog_post_on_t27_ai(BlogPost { title: "progress", on_t27_ai: true }));
    assert(!blog_post_on_t27_ai(BlogPost { title: "draft", on_t27_ai: false }));
}

invariant t27b_blog_steward_max_posts_positive {
    assert T27B_BLOG_STEWARD_MAX_POSTS > 0;
}