// SPDX-License-Identifier: Apache-2.0
; specs/tri/search_cmd/search_cmd.t27 -- the search core for `tri search <query>`.
; `tri search` scans a haystack for a needle and reports the first index (haystack's
; length when absent). The command itself (cli/tri/src/main.rs) reads args, prints,
; and exits; every rule below is decided here and tested.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriSearchCmd;

pub const CMD: str = "search";

/// The first index at which `needle` occurs in `haystack`, or `haystack.len` when
/// `needle` is empty or not found. A pure byte scan, no allocation.
pub fn find(haystack: string, needle: string) -> usize {
    let h : usize = haystack.len();
    let n : usize = needle.len();
    if (n == 0) { return 0; }
    if (n > h) { return h; }
    var i : usize = 0;
    while (i + n <= h) {
        var k : usize = 0;
        var ok : bool = true;
        while (k < n and ok) {
            if (haystack.as_bytes()[(i + k) as usize] != needle.as_bytes()[(k) as usize]) {
                ok = false;
            }
            k = k + 1;
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return h;
}

/// Whether `needle` occurs in `haystack` at all.
pub fn contains(haystack: string, needle: string) -> bool {
    return find(haystack, needle) != haystack.len();
}

invariant find_of_needle_at_start_is_zero { assert find("abc", "a") == 0 and find("", "") == 0 and contains("abc", "b") == true and contains("abc", "z") == false; }

test find_reports_first_occurrence {
    assert(find("hello world", "world") == 6);
    assert(find("aaaa", "aa") == 0);
    assert(find("abcdef", "z") == 6);
    assert(find("abc", "") == 0);
}

test contains_matches_find {
    assert(contains("hello world", "world") == true);
    assert(contains("hello world", "xyz") == false);
    assert(contains("", "") == true);
}

// bench: worst-case scan of a haystack with no match touches every byte once.
bench find_scans_every_byte_on_miss {
    assert(find("aaaaaaaaab", "c") == 10);
}
