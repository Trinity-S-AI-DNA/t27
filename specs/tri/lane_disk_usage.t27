// specs/tri/lane_disk_usage.t27 -- Reduce lane disk usage with a shared Git
// object store (trigit M1).
// Part of M4 milestone (milestone #8). Closes #12878.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::lane_disk_usage;

pub const LANE_DISK_USAGE_SHARED_OBJECT_STORE : bool = true;

pub struct LaneDisk { shared_object_store: bool, lanes_count: u32 };

pub fn lane_disk_usage_reduced(d: LaneDisk) -> bool {
    return d.shared_object_store;
}

test "lane_disk_usage_reduced" {
    assert(lane_disk_usage_reduced(LaneDisk { shared_object_store: true, lanes_count: 5 }));
    assert(!lane_disk_usage_reduced(LaneDisk { shared_object_store: false, lanes_count: 5 }));
}

invariant lane_disk_usage_shared_object_store_default {
    assert LANE_DISK_USAGE_SHARED_OBJECT_STORE;
}