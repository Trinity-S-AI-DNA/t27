// SPDX-License-Identifier: Apache-2.0
// specs/tri/splice.t27 -- splice: fn-local consts crossing module boundaries
// (train_hslm MAT_V/MAT_DOWN).
// Part of M1 (milestone #5). Closes #13067.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::splice;

pub const SPLICE_MODULE_BOUNDARY : bool = true;

pub struct Splice { fn_local_const: bool, crosses_boundary: bool };

pub fn splice_crosses_boundary(s: Splice) -> bool {
    return s.fn_local_const && s.crosses_boundary;
}

test "splice crosses boundary" {
    assert(splice_crosses_boundary(Splice { fn_local_const: true, crosses_boundary: true }));
    assert(!splice_crosses_boundary(Splice { fn_local_const: true, crosses_boundary: false }));
}

invariant splice_module_boundary_default {
    assert SPLICE_MODULE_BOUNDARY;
}