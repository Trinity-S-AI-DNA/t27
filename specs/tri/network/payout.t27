// SPDX-License-Identifier: Apache-2.0
; specs/tri/network/payout.t27 -- every rule of `tri payout`: the AUTHOR_ROYALTY table of one epoch,
; from git history and the public lab receipts, by specs/network/attribution.t27 and
; specs/network/usage.t27. Issue #8716 (see #8604, #8605, #8612; network MVP, see #8613); the author's
; own signature (F_AUTHOR_SIGNED) and the held shares of DISPUTED authors, issue #8789; the agent table,
; the email fallback and the signed claims of specs/network/identity.t27, issue #8649.
; Accounting only: nothing moves here, and credits are non-transferable (specs/verified/payout.t27).
; --
; The command (cli/tri/src/payout.rs, through `t27c gen-rust` in gen/rust/tri/network/payout.rs) is
; glue: it runs git, curl and `t27c corpus-receipt compare`, walks their output with the functions
; below, keeps the tables and prints what they return. Every decision is here or in the specs this
; file uses, and none of theirs is restated: weight_of, credited_to, usage_of, usage_counts,
; royalty_usage and BP_TOTAL are called as they are.
; --
; The facts, and where each comes from:
; - The epoch. An epoch is one UTC day: unix time / EPOCH_SECONDS (2026-10-10 is 20736). Its commits
;   are HEAD's first-parent commits whose committer time falls in it (`git log --first-parent
;   --format='%H %ct'`), newest first. A receipt carries no time of its own, so it counts in its
;   commit's epoch: git binds the time to the sha, and anyone recomputes the same day.
; - Receipts. For each of those commits, each lab's runs/<sha>.receipt.json (LAB_COUNT labs, in
;   lab_url order). `t27c corpus-receipt compare R R` checks one the way it checks any pair: its key
;   registered under .trinity/keys, its signature, its leaves rehashing to its signed roots; exit
;   LANE_EQUIVALENT is all three. receipt_auth turns that, and whether the receipt names the commit it
;   was fetched for, into the usage row's auth bits. No challenge is given, so a receipt that counts
;   is LEVEL_AUTHOR. Its key_id, nonce and input leaves are read below; usage.t27 decides whether it
;   counts. The corpus is every spec path a counting receipt's input leaves name, in byte order.
; - Attribution, at the epoch's newest commit A: per corpus spec, `git blame --first-parent
;   --porcelain A -- <spec>`. Each line of the spec alive at A is a line of the commit blame gives it
;   (a first-parent commit: the merge that landed it); a line that opens a test, invariant or bench
;   block is also one test. The agent rule reads each commit's author name and message (`git log
;   --first-parent --format=%x01%H%n%an%n%B`; the glue splits the log at the %x01). GitHub's
;   `commit.verification.verified` and the author's account id are read from API_COMMITS<sha>, and
;   only for a commit that declares no agent (needs_github): an agent's row is POOL_ID's whatever
;   GitHub says. The author signed it when GitHub verified it AND the commit's committer is its author
;   (`commit.committer.email` equals `commit.author.email`) and not GitHub's web-flow (WEB_FLOW_EMAIL):
;   web-flow signs every squash and merge made on github.com, so its signature confirms no author
;   (attribution.t27 F_AUTHOR_SIGNED). The seal bit: A's first counting receipt gives the spec the
;   reference verdict `pass` (its verdict leaf), the `t27c test-report` run the seal guards.
; - The pool: --pool, DEFAULT_POOL credits unless given.
; --
; The rules:
; - A spec's table holds its blame rows, one per commit. Rows credited to one id with the same seal
;   bit share a slot (table_slot): attribution.t27 adds such rows up anyway, so no weight moves; a
;   merge that would pass a clamp is refused. A spec whose slots run out is no verdict, never a guess.
; - Usage splits by commit: usage.t27 compares rows only within one commit, so usage_of over all the
;   epoch's receipts is the sum of usage_of over each commit's receipts alone, and the glue sums one
;   small table per commit (a test below). A spec's reads are bit 0 of a table queried for spec 0.
; - An id's claim is the sum over specs of royalty_usage(usage) x weight_of (claim_add); the total
;   is the sum of royalty_usage(usage) x BP_TOTAL over every spec, the ones no person wrote included
;   (total_add); a person's share is floor(pool x claim / total), usage.t27's rule. share_floor
;   computes it exactly for any total up to SPLIT_MAX, where royalty_floor needs a total below 2^31;
;   the two agree wherever both apply (a test). Only a CONFIRMED author is paid (attribution.t27
;   payable): never POOL_ID, NO_AUTHOR or a DISPUTED author's held id, whose share stays in the pool,
;   held, until the author confirms. What is not paid stays in the pool.
; - The digests, both printed: SHA-256 of the facts text and of the table text. The facts text is one
;   line per fact, in the order the glue reads them:
;     epoch <N> pool <P> head <sha of A>
;     receipt <commit> <lab> <key_id> <auth> <nonce bytes> <input_root>
;     row <spec path> <commit> <author id> <lines> <tests> <flags>
;   One row per author of the commit, each with its author_part of the lines and tests. The table
;   text is the printed rows in id order, `<id> <login> claim <c> share <s>` (a held id:
;   `<id> <login> held claim <c> held <h>`, h = held_of), then `held total <H>` and `pool left <l>`
;   (the held total is in it). Anyone with git, the public receipts and GitHub's API recomputes both.
; - Exit: OK with a table; UNREAD when the epoch has no commit, no receipt counts, a GitHub answer
;   could not be read, a spec's table is full, or the total passes SPLIT_MAX.
; --
; The layouts read: a receipt is lab.py's `json.dumps(indent=1, sort_keys=True)` (top-level keys at
; one space, a leaf list at two, its leaves at three, a leaf's TAB written as JSON's two-byte `\t`);
; GitHub's REST answer is indented two spaces per level. Any other layout reads as nothing: a receipt
; with no key, no leaves and no commit, an answer with no sha -- never a guess (fail closed).
; The honest limits: GitHub's verification and the account ids are facts given, not checked here. The
; seal bit is the reference verdict at A, not `t27c seal --verify` at each commit. An agent commit
; that omits its trailer reads as its signer's (attribution.t27). A path holding `\t` would misread.
; The original commits (#8816): a blamed commit web-flow committed (needs_pull) is a squash, so its
; rows are its pull request's own authors: the pull request whose merge_commit_sha is the commit
; (API_COMMITS<sha>COMMIT_PULLS), its commits (API_PULLS<n>PULL_COMMITS, one answer, gh_base 2 per
; item), and the human Co-authored-by trailers of those commits and of the squash message. Each
; distinct author is one row, in that order (author_join): flags from the author's own commits only,
; so F_AUTHOR_SIGNED needs every one of them signed by its author; every agent is one author, POOL_ID.
; A trailer's account is its no-reply id, else GitHub's lookup of its email (API_AUTHOR), else
; NO_AUTHOR (held unclaimed). The squash's committer and the merger are never rows. When the pull
; request names no author, or there is no pull request, the squash's own row stands (DISPUTED).
; Limits: a pull request's first 100 commits are read.
; The identity table (#8649, specs/network/identity.t27):
; - The agent rule's names are its agent table (agent_name), and an account an agent row cites is an
;   agent's (account_agent): its own commits and a co-author GitHub links to it go to POOL_ID.
; - An author email GitHub links to no account names the account the table binds it to
;   (commit_author, co_author), else NO_AUTHOR (held unclaimed, never paid to a guess). GitHub's link
;   always wins where there is one.
; - The claims: every file under CLAIMS_DIR at REV, read as one text (`git grep -h -e '' REV --
;   CLAIMS_DIR`). A commit a verified claim of its author lists gets F_CLAIMED (row_flags_in): its row
;   is CONFIRMED. The claim must name the account the commit's author email names, and never an
;   agent's commit. Claims are read at REV, not at A, so a claim made later releases what an older
;   epoch held; the flags in the facts text show which rows it confirmed.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriNetworkPayout;

use network::usage;
use network::attribution;
use network::identity;
use tri::lab::receipt;

/// Where GitHub answers for one commit: append its full sha.
pub const API_COMMITS : str = "https://api.github.com/repos/gHashTag/t27/commits/";

/// The glue keeps each answer gh_read accepts as $TMPDIR/GH_CACHE/<sha> and reads it from there next
/// time: an answer for one commit does not change, and a run asks GitHub about up to ~900 commits (one
/// shared token has 5000 calls an hour). An answer that does not read is never kept, and a kept file
/// that does not read is asked for again.
pub const GH_CACHE : str = "tri-payout-github";

/// The labs whose receipts are read, in order. Lab 0 is LAB_URL of specs/tri/lab/receipt.t27; the glue
/// appends RUNS, the sha and RECEIPT_EXT.
pub const LAB_COUNT : u32 = 2;
pub const LAB2_URL : str = "https://t27b-lab-2-production.up.railway.app/";

/// One epoch is one UTC day.
pub const EPOCH_SECONDS : u64 = 86400;

/// The pool split when --pool is not given, in credits.
pub const DEFAULT_POOL : u64 = 1000000;

/// What the commits are read from, and the two git log formats the glue asks for.
pub const REV : str = "HEAD";
pub const LOG_EPOCH : str = "--format=%H %ct";
pub const LOG_FACTS : str = "--format=%x01%H%n%an%n%B";

/// How many `git blame` the glue runs at once. Speed only: the facts and the table do not depend on it.
pub const BLAME_JOBS : usize = 16;

/// The label of POOL_ID's row and of what stays in the pool.
pub const POOL_LABEL : str = "pool";

/// share_floor is exact for any total up to this (2^63 - 1); a larger total is no verdict.
pub const SPLIT_MAX : u64 = 9223372036854775807;

/// What dec() returns for text that is not a decimal number.
pub const NOT_A_NUMBER : u64 = 18446744073709551615;

/// The two leaf lists the glue walks: 0 the input leaves (what the run read), 1 the verdict leaves.
pub const LIST_INPUT : u32 = 0;
pub const LIST_VERDICT : u32 = 1;

/// The exits: 0 a table, 2 no verdict (the numbering of specs/tri/lab/receipt.t27).
pub const PAY_OK : u8 = 0;
pub const PAY_UNREAD : u8 = 2;

/// A Co-Authored-By trailer, lower case: the rule compares any case.
pub const TRAILER : str = "co-authored-by:";

/// The committer email of every squash and merge made on github.com: GitHub's web-flow key signs them.
pub const WEB_FLOW_EMAIL : str = "noreply@github.com";

/// The original commits behind a squash (#8816). GitHub lists the pull requests a commit landed by at
/// API_COMMITS, the sha, COMMIT_PULLS; a pull request's own commits (up to 100) at API_PULLS, its number,
/// PULL_COMMITS. The account behind a co-author's email is the author of the newest commit GitHub
/// links to it: API_AUTHOR, with the email given as `author` (curl -G --data-urlencode).
pub const COMMIT_PULLS : str = "/pulls";
pub const API_PULLS : str = "https://api.github.com/repos/gHashTag/t27/pulls/";
pub const PULL_COMMITS : str = "/commits?per_page=100";
pub const API_AUTHOR : str = "https://api.github.com/repos/gHashTag/t27/commits?per_page=1";

/// The cache names of those answers, kept the way GH_CACHE keeps a commit's: <sha>CACHE_PULLS,
/// CACHE_PULL<number>, and CACHE_AUTHOR<SHA-256 of the email, hex> (an email is never a path).
pub const CACHE_PULLS : str = ".pulls";
pub const CACHE_PULL : str = "pull-";
pub const CACHE_AUTHOR : str = "author-";

/// GitHub's no-reply email that names the account: <id>+<login>NOREPLY_DOMAIN.
pub const NOREPLY_DOMAIN : str = "@users.noreply.github.com";

/// The table's labels: a held id is `<login of held_author(id)> HELD_LABEL`, and UNCLAIMED_LABEL stands
/// for the login when there is none (a held id with no account, an id whose login was never read).
pub const HELD_LABEL : str = "held";
pub const UNCLAIMED_LABEL : str = "unclaimed";

invariant the_exits_and_lists_are_numbered { assert PAY_OK == 0 and PAY_UNREAD == 2 and LIST_INPUT == 0 and LIST_VERDICT == 1 and LAB_COUNT == 2 and LAB_COUNT <= USAGE_ROWS; }

/// The base URL of lab k.
pub fn lab_url(k: u32) -> string {
    if (k == 0) { return LAB_URL; }
    return LAB2_URL;
}

/// The epoch of a unix time.
pub fn epoch_of(t: u64) -> u64 {
    return t / EPOCH_SECONDS;
}

/// Is text[at..at + 40] a full sha: 40 lowercase hex digits?
pub fn is_sha(text: string, at: usize) -> bool {
    if (at + 40 > text.len) { return false; }
    var k : usize = 0;
    while (k < 40) {
        const c : u8 = text[at + k];
        if ((c < 48 or c > 57) and (c < 97 or c > 102)) { return false; }
        k = k + 1;
    }
    return true;
}

/// The decimal number text[from..to]; NOT_A_NUMBER when it is empty, longer than 19 digits or not digits.
pub fn dec(text: string, from: usize, to: usize) -> u64 {
    if (to <= from or to - from > 19 or to > text.len) { return NOT_A_NUMBER; }
    var n : u64 = 0;
    var i : usize = from;
    while (i < to) {
        if (text[i] < 48 or text[i] > 57) { return NOT_A_NUMBER; }
        n = n * 10 + ((text[i] as u64) - 48);
        i = i + 1;
    }
    return n;
}

/// The hex number text[from..to], at most 16 digits; 0 when it is empty, longer, or not hex.
pub fn hex_u64(text: string, from: usize, to: usize) -> u64 {
    if (to <= from or to - from > 16 or to > text.len) { return 0; }
    var n : u64 = 0;
    var i : usize = from;
    while (i < to) {
        const d : u32 = hex_digit_value(text[i] as u32);
        if (d == HEX_NOT_A_DIGIT) { return 0; }
        n = n * 16 + (d as u64);
        i = i + 1;
    }
    return n;
}

/// Is the `%H %ct` line one of the epoch's commits: a sha, one space, a committer time in `epoch`?
pub fn in_epoch(line: string, epoch: u64) -> bool {
    if (line.len < 42 or is_sha(line, 0) == false or line[40] != 32) { return false; }
    const t : u64 = dec(line, 41, line.len);
    if (t == NOT_A_NUMBER) { return false; }
    return epoch_of(t) == epoch;
}

// --- A receipt ---------------------------------------------------------------------------------

/// Where the receipt's top-level value of `key` starts and ends (past the quotes of a string).
pub fn rc_from(t: string, key: string) -> usize {
    return value_from(t, key_at(t, 0, t.len, 1, key));
}

pub fn rc_to(t: string, key: string) -> usize {
    return value_to(t, key_at(t, 0, t.len, 1, key));
}

/// Is the receipt's top-level `key` exactly lit?
pub fn rc_is(t: string, key: string, lit: string) -> bool {
    return span_is(t, rc_from(t, key), rc_to(t, key), lit);
}

/// The receipt's key id as a number (usage.t27's key column); 0 when it cannot be read.
pub fn rc_key(t: string) -> u64 {
    return hex_u64(t, rc_from(t, "key_id"), rc_to(t, "key_id"));
}

/// The receipt's nonce in bytes: 0 for null or no nonce, else half its hex digits, at most 255.
pub fn rc_nonce_bytes(t: string) -> u8 {
    const f : usize = rc_from(t, "nonce");
    const e : usize = rc_to(t, "nonce");
    if (e <= f or span_is(t, f, e, "null")) { return 0; }
    if ((e - f) / 2 > 255) { return 255; }
    return ((e - f) / 2) as u8;
}

/// The name of leaf list k.
pub fn rc_list(k: u32) -> string {
    if (k == LIST_INPUT) { return "input"; }
    return "verdict";
}

/// The offset of the first leaf of list k (the line after `  "<name>": [` at indent 2); t.len when
/// the receipt has no such list, or an empty one.
pub fn rc_list_at(t: string, k: u32) -> usize {
    var at : usize = 0;
    while (at < t.len) {
        const end : usize = line_end(t, at);
        if (line_is(t, at, end, 2, "\"input\": [") and k == LIST_INPUT) { return end + 1; }
        if (line_is(t, at, end, 2, "\"verdict\": [") and k == LIST_VERDICT) { return end + 1; }
        at = end + 1;
    }
    return t.len;
}

/// Is the line at `at` a leaf: three spaces, then a string? A list ends at its first line that is not.
pub fn rc_is_leaf(t: string, at: usize) -> bool {
    if (at + 4 > t.len) { return false; }
    return t[at] == 32 and t[at + 1] == 32 and t[at + 2] == 32 and t[at + 3] == 34;
}

/// The end of a leaf's text: before its closing quote and the ',' after it.
pub fn leaf_end(t: string, at: usize) -> usize {
    var e : usize = line_end(t, at);
    if (e > at and t[e - 1] == 44) { e = e - 1; }
    if (e > at + 4 and t[e - 1] == 34) { e = e - 1; }
    return e;
}

/// Is t[p..p + 2] the two bytes `\t`, JSON's escape of a TAB?
pub fn is_tab_escape(t: string, p: usize, end: usize) -> bool {
    return p + 1 < end and t[p] == 92 and t[p + 1] == 116;
}

/// Where field k of the leaf at `at` starts: fields are split at `\t`, field 0 is the path. The leaf's
/// end when it has fewer fields.
pub fn leaf_field_from(t: string, at: usize, k: u32) -> usize {
    const end : usize = leaf_end(t, at);
    var p : usize = at + 4;
    var n : u32 = 0;
    while (n < k) {
        while (p + 1 < end and is_tab_escape(t, p, end) == false) { p = p + 1; }
        if (p + 1 >= end) { return end; }
        p = p + 2;
        n = n + 1;
    }
    if (p > end) { return end; }
    return p;
}

/// Where field k ends: at the next `\t`, or at the leaf's end.
pub fn leaf_field_to(t: string, at: usize, k: u32) -> usize {
    const end : usize = leaf_end(t, at);
    var p : usize = leaf_field_from(t, at, k);
    while (p + 1 < end and is_tab_escape(t, p, end) == false) { p = p + 1; }
    if (is_tab_escape(t, p, end)) { return p; }
    return end;
}

/// Is the leaf at `at` of list k kept: every input leaf (the run read that spec); a verdict leaf when its
/// reference verdict, field 2, is `pass` (the seal bit).
pub fn leaf_kept(t: string, at: usize, k: u32) -> bool {
    if (k == LIST_INPUT) { return true; }
    return span_is(t, leaf_field_from(t, at, 2), leaf_field_to(t, at, 2), "pass");
}

/// The auth bits (usage.t27's U_*) of a receipt's row: signed, key registered and signature valid when
/// `t27c corpus-receipt compare R R` exits LANE_EQUIVALENT and the receipt names the commit it was
/// fetched for; none otherwise. No challenge is given.
pub fn receipt_auth(cmp_rc: i32, names_commit: bool) -> u8 {
    if (names_commit == false) { return 0; }
    if (cmp_rc != (LANE_EQUIVALENT as i32)) { return 0; }
    return U_SIGNED | U_KEY_REGISTERED | U_SIGNATURE_VALID;
}

// --- git blame --porcelain ---------------------------------------------------------------------

/// Is the porcelain line t[at..end] a line header: a sha, a space, then the line numbers?
pub fn bl_header(t: string, at: usize, end: usize) -> bool {
    return end >= at + 41 and is_sha(t, at) and t[at + 40] == 32;
}

/// Is it one line of the spec: a TAB, then the line's text?
pub fn bl_line(t: string, at: usize, end: usize) -> bool {
    return end > at and t[at] == 9;
}

/// Is r[from..to] at least lit long and does it start with lit?
pub fn prefix_is(r: string, from: usize, to: usize, lit: string) -> bool {
    return to >= from + lit.len and span_is(r, from, from + lit.len, lit);
}

/// Does the spec line t[at..end] (a TAB first) open a test, invariant or bench block: the word at
/// column 0, then a space?
pub fn bl_test(t: string, at: usize, end: usize) -> bool {
    if (bl_line(t, at, end) == false) { return false; }
    return prefix_is(t, at + 1, end, "test ") or prefix_is(t, at + 1, end, "invariant ") or prefix_is(t, at + 1, end, "bench ");
}

// --- the agent rule ----------------------------------------------------------------------------

pub fn lower(c: u8) -> u8 {
    if (c >= 65 and c <= 90) { return c + 32; }
    return c;
}

// An agent's name is one of specs/network/identity.t27's agent table (agent_name, there), each row
// with the commit or the account that shows it.

/// Does the message line r[at..end] open with a Co-Authored-By trailer, in any case?
pub fn trailer_at(r: string, at: usize, end: usize) -> bool {
    if (end < at + TRAILER.len) { return false; }
    var k : usize = 0;
    while (k < TRAILER.len) {
        if (lower(r[at + k]) != TRAILER[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is the message line r[at..end] a Co-Authored-By trailer (any case) that names an agent? The name runs
/// from past the colon and its spaces to the `<` of the address (or the line's end), less trailing blanks.
pub fn trailer_agent(r: string, at: usize, end: usize) -> bool {
    if (trailer_at(r, at, end) == false) { return false; }
    var f : usize = at + TRAILER.len;
    while (f < end and r[f] == 32) { f = f + 1; }
    var e : usize = f;
    while (e < end and r[e] != 60) { e = e + 1; }
    while (e > f and (r[e - 1] == 32 or r[e - 1] == 13)) { e = e - 1; }
    return agent_name(r, f, e);
}

/// Does the commit record r (`%H%n%an%n%B`: the sha, the author's name, the message) declare an agent:
/// the author's name is an agent's, or a trailer line names one?
pub fn agent_record(r: string) -> bool {
    const l1 : usize = line_end(r, 0);
    if (l1 >= r.len) { return false; }
    const l2 : usize = line_end(r, l1 + 1);
    if (agent_name(r, l1 + 1, l2)) { return true; }
    var at : usize = l2 + 1;
    while (at < r.len) {
        const e : usize = line_end(r, at);
        if (trailer_agent(r, at, e)) { return true; }
        at = e + 1;
    }
    return false;
}

// --- GitHub's answer for one commit ------------------------------------------------------------

/// Does a row need GitHub's answer at all? Only a commit that declares no agent.
pub fn needs_github(agent: bool) -> bool {
    return agent == false;
}

/// The indent of the line where the answer's first object opens: 0 for one commit's answer, 2 for one
/// item of a list or for a list answer (whose first item is then the one read). Every key below is read
/// at this base plus its own level.
pub fn gh_base(t: string) -> usize {
    var k : usize = 0;
    while (k < t.len and t[k] != 123) { k = k + 1; }
    var s : usize = k;
    while (s > 0 and t[s - 1] != 10) { s = s - 1; }
    return k - s;
}

/// Was the answer read: does its top-level `sha` (indent base + 2) name the commit asked for?
pub fn gh_read(t: string, sha: string) -> bool {
    const v : usize = key_at(t, 0, t.len, gh_base(t) + 2, "sha");
    return span_is(t, value_from(t, v), value_to(t, v), sha);
}

/// Is a needed answer missing? Then the epoch has no verdict.
pub fn gh_unread(t: string, sha: string, agent: bool) -> bool {
    return needs_github(agent) and gh_read(t, sha) == false;
}

/// Did GitHub verify the signature: the `verified` (base + 6) that follows `verification` (base + 4)?
pub fn gh_verified(t: string) -> bool {
    const b : usize = gh_base(t);
    const v : usize = key_at(t, 0, t.len, b + 4, "verification");
    if (v > t.len) { return false; }
    const w : usize = key_at(t, line_end(t, v) + 1, t.len, b + 6, "verified");
    return span_is(t, value_from(t, w), value_to(t, w), "true");
}

/// Where the top-level `author` object opens (base + 2, value `{`); t.len + 1 when it is null or absent.
pub fn gh_author_at(t: string) -> usize {
    const a : usize = key_at(t, 0, t.len, gh_base(t) + 2, "author");
    if (a >= t.len or t[a] != 123) { return t.len + 1; }
    return a;
}

/// The author's account id (the object's `id`, base + 4); NO_AUTHOR when there is none.
pub fn gh_author(t: string) -> u64 {
    const a : usize = gh_author_at(t);
    if (a > t.len) { return NO_AUTHOR; }
    const i : usize = key_at(t, line_end(t, a) + 1, t.len, gh_base(t) + 4, "id");
    const n : u64 = dec(t, value_from(t, i), value_to(t, i));
    if (n == NOT_A_NUMBER) { return NO_AUTHOR; }
    return n;
}

/// Where the author's login starts and ends (base + 4); an empty span when there is none.
pub fn gh_login_from(t: string) -> usize {
    const a : usize = gh_author_at(t);
    if (a > t.len) { return t.len; }
    return value_from(t, key_at(t, line_end(t, a) + 1, t.len, gh_base(t) + 4, "login"));
}

pub fn gh_login_to(t: string) -> usize {
    const a : usize = gh_author_at(t);
    if (a > t.len) { return t.len; }
    return value_to(t, key_at(t, line_end(t, a) + 1, t.len, gh_base(t) + 4, "login"));
}

/// Is the author a bot account: its login ends `[bot]`?
pub fn gh_agent(t: string) -> bool {
    const f : usize = gh_login_from(t);
    const e : usize = gh_login_to(t);
    return e >= f + 5 and span_is(t, e - 5, e, "[bot]");
}

/// The line that closes the block opened on the line at `at`: the first later line that is `ind`
/// spaces and `}` (a ',' after it allowed); t.len when there is none.
pub fn gh_block_end(t: string, at: usize, ind: usize) -> usize {
    var k : usize = line_end(t, at) + 1;
    while (k < t.len) {
        const e : usize = line_end(t, k);
        if (line_is(t, k, e, ind, "}")) { return k; }
        k = e + 1;
    }
    return t.len;
}

/// Where the git commit object (`commit`, base + 2) opens; t.len + 1 when it is absent or not an object.
pub fn gh_commit_at(t: string) -> usize {
    const c : usize = key_at(t, 0, t.len, gh_base(t) + 2, "commit");
    if (c >= t.len or t[c] != 123) { return t.len + 1; }
    return c;
}

/// Where the git commit's `which` person (`author` or `committer`, base + 4) opens inside the answer's
/// `commit` object; t.len + 1 when either is absent or not an object.
pub fn gh_person_at(t: string, which: string) -> usize {
    const c : usize = gh_commit_at(t);
    if (c > t.len) { return t.len + 1; }
    const stop : usize = gh_block_end(t, c, gh_base(t) + 2);
    const p : usize = key_at(t, line_end(t, c) + 1, stop, gh_base(t) + 4, which);
    if (p >= stop or p >= t.len or t[p] != 123) { return t.len + 1; }
    return p;
}

/// Where that person's `key` (`email` or `name`, base + 6) starts and ends; an empty span when there
/// is none.
pub fn gh_field_from(t: string, which: string, key: string) -> usize {
    const p : usize = gh_person_at(t, which);
    if (p > t.len) { return t.len; }
    return value_from(t, key_at(t, line_end(t, p) + 1, gh_block_end(t, p, gh_base(t) + 4), gh_base(t) + 6, key));
}

pub fn gh_field_to(t: string, which: string, key: string) -> usize {
    const p : usize = gh_person_at(t, which);
    if (p > t.len) { return t.len; }
    return value_to(t, key_at(t, line_end(t, p) + 1, gh_block_end(t, p, gh_base(t) + 4), gh_base(t) + 6, key));
}

pub fn gh_email_from(t: string, which: string) -> usize {
    return gh_field_from(t, which, "email");
}

pub fn gh_email_to(t: string, which: string) -> usize {
    return gh_field_to(t, which, "email");
}

/// Where the git commit's message (base + 4, one JSON string: a line break is the two bytes `\n`)
/// starts and ends; an empty span when there is none.
pub fn gh_message_from(t: string) -> usize {
    const c : usize = gh_commit_at(t);
    if (c > t.len) { return t.len; }
    return value_from(t, key_at(t, line_end(t, c) + 1, gh_block_end(t, c, gh_base(t) + 2), gh_base(t) + 4, "message"));
}

pub fn gh_message_to(t: string) -> usize {
    const c : usize = gh_commit_at(t);
    if (c > t.len) { return t.len; }
    return value_to(t, key_at(t, line_end(t, c) + 1, gh_block_end(t, c, gh_base(t) + 2), gh_base(t) + 4, "message"));
}

/// Are t[a0..a1] and t[b0..b1] the same bytes?
pub fn same_text(t: string, a0: usize, a1: usize, b0: usize, b1: usize) -> bool {
    if (a1 < a0 or b1 < b0 or a1 - a0 != b1 - b0) { return false; }
    var k : usize = 0;
    while (k < a1 - a0) {
        if (t[a0 + k] != t[b0 + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Did the author sign the commit with a key of their own: GitHub verified it, and its committer is
/// its author (one email, not empty) and not GitHub's web-flow.
pub fn gh_author_signed(t: string) -> bool {
    if (gh_verified(t) == false) { return false; }
    const af : usize = gh_email_from(t, "author");
    const at : usize = gh_email_to(t, "author");
    const cf : usize = gh_email_from(t, "committer");
    const ct : usize = gh_email_to(t, "committer");
    if (at <= af or ct <= cf) { return false; }
    if (span_is(t, cf, ct, WEB_FLOW_EMAIL)) { return false; }
    return same_text(t, af, at, cf, ct);
}

/// Where the answer's top-level `sha` starts and ends.
pub fn gh_sha_from(t: string) -> usize {
    return value_from(t, key_at(t, 0, t.len, gh_base(t) + 2, "sha"));
}

pub fn gh_sha_to(t: string) -> usize {
    return value_to(t, key_at(t, 0, t.len, gh_base(t) + 2, "sha"));
}

/// The account a commit's author email names: GitHub's link, else the identity table's (an email
/// GitHub links to no one); NO_AUTHOR when neither names one.
pub fn commit_author_in(tab: IdentityTable, t: string) -> u64 {
    const a : u64 = gh_author(t);
    if (a != NO_AUTHOR) { return a; }
    return email_account(tab, t, gh_email_from(t, "author"), gh_email_to(t, "author"));
}

pub fn commit_author(t: string) -> u64 {
    return commit_author_in(identity_table(), t);
}

/// Is the commit's account an agent's: a bot login, or an account the agent table cites?
pub fn gh_agent_account(t: string) -> bool {
    return gh_agent(t) or account_agent(gh_author(t));
}

/// A row's flags (attribution.t27's F_*): GitHub verified it; the commit or its account is an agent's;
/// the spec's seal bit at A; the author signed it with a key of their own; a verified claim in
/// `claims` of the account the author email names lists it (never an agent's commit).
pub fn row_flags_in(tab: IdentityTable, gh: string, agent: bool, green: bool, claims: string) -> u8 {
    var f : u8 = 0;
    const ag : bool = agent or gh_agent_account(gh);
    if (gh_verified(gh)) { f = f | F_VERIFIED; }
    if (ag) { f = f | F_AGENT; }
    if (green) { f = f | F_SEAL_GREEN; }
    if (gh_author_signed(gh)) { f = f | F_AUTHOR_SIGNED; }
    if (claims.len > 0 and claim_confirms(tab, claims, gh, gh_sha_from(gh), gh_sha_to(gh), commit_author_in(tab, gh), ag)) { f = f | F_CLAIMED; }
    return f;
}

pub fn row_flags(gh: string, agent: bool, green: bool, claims: string) -> u8 {
    return row_flags_in(identity_table(), gh, agent, green, claims);
}

// --- the original commits behind a squash (#8816) ----------------------------------------------

/// Was web-flow its committer: a squash or merge made on github.com, whose signature names no author?
pub fn gh_squash(t: string) -> bool {
    return span_is(t, gh_email_from(t, "committer"), gh_email_to(t, "committer"), WEB_FLOW_EMAIL);
}

/// Does a row need the original commits: a person's commit that web-flow committed? Its rows are then
/// the pull request's own authors, never the squash's.
pub fn needs_pull(t: string, agent: bool) -> bool {
    return needs_github(agent) and gh_squash(t);
}

/// Was a list answer read whole: `[` first and `]` last (one '\n' after it allowed)? A cut answer is not.
pub fn gh_list_read(t: string) -> bool {
    if (t.len < 2 or t[0] != 91) { return false; }
    if (t[t.len - 1] == 93) { return true; }
    return t[t.len - 1] == 10 and t[t.len - 2] == 93;
}

/// Where the next item of a list answer opens (a line of two spaces and `{`) at or after the line
/// start `at`; t.len when there is none.
pub fn gh_item_at(t: string, at: usize) -> usize {
    var k : usize = at;
    while (k < t.len) {
        const e : usize = line_end(t, k);
        if (line_is(t, k, e, 2, "{")) { return k; }
        k = e + 1;
    }
    return t.len;
}

/// Where the item that opens at `at` ends: past the '\n' of its closing line. The glue reads
/// t[at..gh_item_end(t, at)] as one answer (gh_base 2).
pub fn gh_item_end(t: string, at: usize) -> usize {
    const e : usize = line_end(t, gh_block_end(t, at, 2));
    if (e >= t.len) { return t.len; }
    return e + 1;
}

/// The number of the pull request that landed `sha`: the item of GitHub's pulls answer whose
/// merge_commit_sha is sha; NOT_A_NUMBER when none is (a commit made on github.com without one).
pub fn gh_pull_number(t: string, sha: string) -> u64 {
    var i : usize = gh_item_at(t, 0);
    while (i < t.len) {
        const e : usize = gh_item_end(t, i);
        const m : usize = key_at(t, i, e, 4, "merge_commit_sha");
        if (m < e and span_is(t, value_from(t, m), value_to(t, m), sha)) {
            const v : usize = key_at(t, i, e, 4, "number");
            return dec(t, value_from(t, v), value_to(t, v));
        }
        i = gh_item_at(t, e);
    }
    return NOT_A_NUMBER;
}

/// Is an original commit an agent's: its git author's name is an agent's, or its account is a bot or
/// one the agent table cites?
pub fn orig_agent(t: string) -> bool {
    return agent_name(t, gh_field_from(t, "author", "name"), gh_field_to(t, "author", "name")) or gh_agent_account(t);
}

/// The author an original commit names: POOL_ID for an agent's (one author for every agent), else
/// the account its email names (commit_author; NO_AUTHOR when none: held unclaimed).
pub fn orig_author(t: string) -> u64 {
    if (orig_agent(t)) { return POOL_ID; }
    return commit_author(t);
}

/// An author's flags after one more of the commit's facts about them. An own original commit (own)
/// keeps verified, signed and green only when every own commit has them, and agent when any has it:
/// a part is CONFIRMED only when all of that author's commits in the pull request are their own,
/// signed. A trailer that names an author already counted changes nothing.
pub fn author_join(prev: u8, f: u8, own: bool) -> u8 {
    if (own == false) { return prev; }
    var j : u8 = ((prev & f) & (F_VERIFIED | F_SEAL_GREEN | F_AUTHOR_SIGNED | F_CLAIMED)) | ((prev | f) & F_AGENT);
    // one commit signed, another claimed: both confirmed, so the part is (attribution.t27 own_confirmed)
    if (own_confirmed(prev) and own_confirmed(f) and own_confirmed(j) == false) { j = j | F_CLAIMED; }
    return j;
}

/// Where the next Co-Authored-By trailer (any case) of a message in t[at..to] starts: at a line start,
/// after a raw '\n' (git log) or JSON's two bytes `\n` (GitHub's answer); `to` when there is none.
pub fn co_next(t: string, at: usize, to: usize) -> usize {
    var p : usize = at;
    while (p < to) {
        if (p > 0 and (t[p - 1] == 10 or (p >= 2 and t[p - 2] == 92 and t[p - 1] == 110)) and trailer_at(t, p, to)) { return p; }
        p = p + 1;
    }
    return to;
}

/// Where the trailer at p ends: its line's raw '\n' or '\r', or a JSON `\n` or `\r`; `to` at the end.
pub fn co_end(t: string, p: usize, to: usize) -> usize {
    var q : usize = p;
    while (q < to) {
        if (t[q] == 10 or t[q] == 13) { return q; }
        if (t[q] == 92 and q + 1 < to and (t[q + 1] == 110 or t[q + 1] == 114)) { return q; }
        q = q + 1;
    }
    return to;
}

/// Where the trailer's email (between `<` and `>`) starts and ends in t[p..q]; empty when it has none.
pub fn co_mail_from(t: string, p: usize, q: usize) -> usize {
    var k : usize = p;
    while (k < q and t[k] != 60) { k = k + 1; }
    if (k >= q) { return q; }
    return k + 1;
}

pub fn co_mail_to(t: string, p: usize, q: usize) -> usize {
    var k : usize = co_mail_from(t, p, q);
    while (k < q and t[k] != 62) { k = k + 1; }
    if (k >= q) { return q; }
    return k;
}

/// The account id an email t[f..e] names by itself: <id>+<login>NOREPLY_DOMAIN; NO_AUTHOR otherwise.
pub fn noreply_id(t: string, f: usize, e: usize) -> u64 {
    if (e < f + NOREPLY_DOMAIN.len + 3 or span_is(t, e - NOREPLY_DOMAIN.len, e, NOREPLY_DOMAIN) == false) { return NO_AUTHOR; }
    var k : usize = f;
    while (k < e and t[k] != 43) { k = k + 1; }
    const n : u64 = dec(t, f, k);
    if (k >= e or account_known(n) == false) { return NO_AUTHOR; }
    return n;
}

/// Does the trailer t[p..q] need GitHub to name its account: a person's, with an email that is not the
/// no-reply form with an id?
pub fn co_lookup(t: string, p: usize, q: usize) -> bool {
    const f : usize = co_mail_from(t, p, q);
    const e : usize = co_mail_to(t, p, q);
    return trailer_agent(t, p, q) == false and e > f and noreply_id(t, f, e) == NO_AUTHOR;
}

/// Is the trailer t[p..q] an agent's: its name is in the agent table, or GitHub's lookup answer `a`
/// links its email to an account the table cites?
pub fn co_agent(t: string, p: usize, q: usize, a: string) -> bool {
    return trailer_agent(t, p, q) or account_agent(gh_author(a));
}

/// The author the trailer t[p..q] names: POOL_ID for an agent; the id of a no-reply email; else the
/// account of GitHub's lookup answer `a` (API_AUTHOR); else the account the identity table binds the
/// email to; NO_AUTHOR when none does (held unclaimed, never a guess).
pub fn co_author(t: string, p: usize, q: usize, a: string) -> u64 {
    if (co_agent(t, p, q, a)) { return POOL_ID; }
    const f : usize = co_mail_from(t, p, q);
    const e : usize = co_mail_to(t, p, q);
    const n : u64 = noreply_id(t, f, e);
    if (n != NO_AUTHOR) { return n; }
    const g : u64 = gh_author(a);
    if (g != NO_AUTHOR) { return g; }
    return email_account(identity_table(), t, f, e);
}

/// A trailer author's flags: agent for an agent (co_agent), and the spec's seal bit; never signed nor
/// claimed, since a trailer commits nothing (a co-author is CONFIRMED only by an own commit).
pub fn co_flags(t: string, p: usize, q: usize, a: string, green: bool) -> u8 {
    var f : u8 = 0;
    if (co_agent(t, p, q, a)) { f = f | F_AGENT; }
    if (green) { f = f | F_SEAL_GREEN; }
    return f;
}

/// The table's login for an id with no login read: the pool's label for POOL_ID, the identity table's
/// name for an account it knows, else UNCLAIMED_LABEL.
pub fn login_fallback(id: u64) -> string {
    if (id == POOL_ID) { return POOL_LABEL; }
    const tab : IdentityTable = identity_table();
    const p : u32 = account_part(tab, id);
    if (p < ID_ROWS) { return tab.name[p]; }
    return UNCLAIMED_LABEL;
}

/// The id whose login labels a table row: the author a held id is held for, else the id itself.
pub fn label_id(id: u64) -> u64 {
    if (is_held(id)) { return held_author(id); }
    return id;
}

// --- a spec's table ----------------------------------------------------------------------------

/// Where a row (author, flags f, lines l, tests n) goes in a spec's table, filled from slot 0: the slot
/// already credited to the same id with the same seal bit, else the first empty one. ATTR_ROWS when the
/// table is full or the merged counts would pass a clamp: no verdict.
pub fn table_slot(specs: [16]u32, authors: [16]u64, lines: [16]u64, tests: [16]u64, flags: [16]u8, author: u64, f: u8, l: u64, n: u64) -> u32 {
    const c : u64 = credited_to(author, f);
    var i : u32 = 0;
    while (i < ATTR_ROWS) {
        if (specs[i] == NO_SPEC) {
            if (l > LINES_MAX or n > TESTS_MAX) { return ATTR_ROWS; }
            return i;
        }
        if (credited_to(authors[i], flags[i]) == c and attr_flag(flags[i], F_SEAL_GREEN) == attr_flag(f, F_SEAL_GREEN)) {
            if (lines[i] + l > LINES_MAX or tests[i] + n > TESTS_MAX) { return ATTR_ROWS; }
            return i;
        }
        i = i + 1;
    }
    return ATTR_ROWS;
}

// --- the split ---------------------------------------------------------------------------------

/// An id's claim after one more spec: usage x the id's weight in it.
pub fn claim_add(acc: u64, usage: u64, weight: u64) -> u64 {
    return acc + royalty_usage(usage) * weight;
}

/// The total claim after one more spec: its usage x BP_TOTAL, whoever wrote it.
pub fn total_add(acc: u64, usage: u64) -> u64 {
    return acc + royalty_usage(usage) * BP_TOTAL;
}

/// floor(x * y / c) for x < c, y <= c, c <= SPLIT_MAX: the bits of y high first, keeping the quotient
/// and the remainder of x * (the bits so far). The remainder stays below c, so 2r and r + x never
/// wrap, and the quotient never passes x.
pub fn mul_div_small(x: u64, y: u64, c: u64) -> u64 {
    var q : u64 = 0;
    var r : u64 = 0;
    var k : u32 = 64;
    while (k > 0) {
        k = k - 1;
        q = q * 2;
        r = r * 2;
        if (r >= c) {
            r = r - c;
            q = q + 1;
        }
        if (((y >> (k as u64)) & 1) == 1) {
            r = r + x;
            if (r >= c) {
                r = r - c;
                q = q + 1;
            }
        }
    }
    return q;
}

/// floor(pool x claim / total), exact for every u64 pool and every total up to SPLIT_MAX:
/// pool = q x total + r, so it is q x claim + floor(r x claim / total). 0 when the total is 0 or too
/// large, or the claim is more than the total.
pub fn share_floor(pool: u64, claim: u64, total: u64) -> u64 {
    if (total == 0 or total > SPLIT_MAX or claim > total) { return 0; }
    const q : u64 = pool / total;
    const r : u64 = pool - q * total;
    return q * claim + mul_div_small(r, claim, total);
}

/// A credited id's share of the epoch's pool. Only a CONFIRMED author's account is paid; POOL_ID,
/// NO_AUTHOR and a DISPUTED author's held id never are.
pub fn share_of(pool: u64, claim: u64, total: u64, id: u64) -> u64 {
    if (payable(id) == false) { return 0; }
    return share_floor(pool, claim, total);
}

/// What the epoch holds, unpaid, for the DISPUTED author behind a held id: the share the id would get.
pub fn held_of(pool: u64, claim: u64, total: u64, id: u64) -> u64 {
    if (is_held(id) == false) { return 0; }
    return share_floor(pool, claim, total);
}

/// The exit: no verdict when the epoch has no commit, no receipt counts, a GitHub answer could not be
/// read, a spec's table is full, or the total passes SPLIT_MAX.
pub fn pay_exit(commits: u64, counting: u64, unread: u64, full: u64, total: u64) -> u8 {
    if (commits == 0 or counting == 0 or unread > 0 or full > 0 or total > SPLIT_MAX) { return PAY_UNREAD; }
    return PAY_OK;
}

pub fn pay_why(x: u8) -> string {
    if (x == PAY_OK) { return "exit 0: the epoch's AUTHOR_ROYALTY split; the inputs digest names the facts it ran on"; }
    return "exit 2: no verdict -- the epoch has no commit or no counting receipt, a GitHub answer was not read, or a spec's table is full";
}

; --- Fixtures ----------------------------------------------------------------------------------

// A receipt, shortened, laid out as lab.py writes it: three input leaves, one output leaf, three
// verdict leaves (t27b TAB reference), no nonce. The commit, key and roots are master 6a8e44b5f's.
const RECEIPT : string = "{\n \"commit\": \"6a8e44b5f2a7718924ac378579d2d6aa4c73d8e4\",\n \"input_root\": \"cb6314866fd90700d464fc7f160236a93389358f8a1e417807ad1fe7664a1f1b\",\n \"key_id\": \"a05db80f53c317f6\",\n \"kind\": \"t27-corpus-receipt-v1\",\n \"leaves\": {\n  \"input\": [\n   \"specs/a/b_c.t27\\t702d0ffd\",\n   \"specs/network/usage.t27\\t92ed936b\",\n   \"specs/tri/lab/receipt.t27\\t5133a2b2\"\n  ],\n  \"output\": [\n   \"specs/a/b_c.t27\\t6f5d156a\"\n  ],\n  \"verdict\": [\n   \"specs/a/b_c.t27\\tpass\\tpass\",\n   \"specs/network/usage.t27\\tpass_vacuous\\tpass\",\n   \"specs/tri/lab/receipt.t27\\tblocked\\tfail\"\n  ]\n },\n \"nonce\": null,\n \"output_root\": \"1cd614064daf94d7\",\n \"signature\": \"1a325cd930605\",\n \"totals\": {\n  \"files\": 3\n },\n \"verdict_root\": \"0478edbb0b56de65\"\n}\n";

// The same receipt's head with a 40-digit nonce (a lab request's challenge) and an empty output list.
const RECEIPT_NONCE : string = "{\n \"commit\": \"6a8e44b5f2a7718924ac378579d2d6aa4c73d8e4\",\n \"key_id\": \"fed03daa6459a7fa\",\n \"leaves\": {\n  \"input\": [],\n  \"output\": [],\n  \"verdict\": []\n },\n \"nonce\": \"0123456789abcdef0123456789abcdef01234567\"\n}\n";

// git blame --first-parent --porcelain of a four-line spec: two commits, the first header of each with
// its extra lines (a `previous` line holds a sha too), and one test block.
const BLAME : string = "36136f09263ac21c7290821de70fa0fb07dcb98b 1 1 2\nauthor Vasilev Dmitrii\nauthor-mail <admin@t27.ai>\nsummary specs: types (#8703)\nfilename specs/x.t27\n\tmodule X;\n36136f09263ac21c7290821de70fa0fb07dcb98b 2 2\n\ttest one_is_one {\n6a8e44b5f2a7718924ac378579d2d6aa4c73d8e4 3 3 2\nauthor Claude\nprevious 1111111111111111111111111111111111111111 specs/x.t27\nfilename specs/x.t27\n\t    assert 1 == 1;\n6a8e44b5f2a7718924ac378579d2d6aa4c73d8e4 4 4\n\t}\n";

