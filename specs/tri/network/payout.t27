// Scenario: an epoch is a UTC day, and only a well-formed `%H %ct` line of that day is in it.
test an_epoch_is_one_utc_day {
    assert epoch_of(1791651662) == 20736;
    assert epoch_of(1791590400) == 20736;
    assert epoch_of(1791590399) == 20735;
    assert in_epoch("36136f09263ac21c7290821de70fa0fb07dcb98b 1791651662", 20736);
    assert in_epoch("36136f09263ac21c7290821de70fa0fb07dcb98b 1791651662", 20737) == false;
    assert in_epoch("36136f09263ac21c7290821de70fa0fb07dcb98b 1791590399", 20736) == false;
    assert in_epoch("36136f09263ac21c7290821de70fa0fb07dcb98b x791651662", 20736) == false;
    assert in_epoch("36136F09263AC21C7290821DE70FA0FB07DCB98B 1791651662", 20736) == false;
    assert in_epoch("36136f09263ac21c7290821de70fa0fb07dcb98b", 0) == false;
    assert in_epoch("", 0) == false;
    assert dec("1791651662", 0, 10) == 1791651662;
    assert dec("", 0, 0) == NOT_A_NUMBER;
    assert dec("12345678901234567890", 0, 20) == NOT_A_NUMBER;
    assert hex_u64("a05db80f53c317f6", 0, 16) == 11555594594871875574;
    assert hex_u64("36136f09263ac21c7290", 0, 16) == 3896580187692384796;
    assert hex_u64("xyz", 0, 3) == 0;
}

// Scenario: a receipt's commit, key, nonce and leaves are read from its own top-level keys and lists,
// field by field, and each list ends at its closing line.
test a_receipt_is_read_key_by_key_and_leaf_by_leaf {
    assert rc_is(RECEIPT, "commit", "6a8e44b5f2a7718924ac378579d2d6aa4c73d8e4");
    assert rc_is(RECEIPT, "commit", "36136f09263ac21c7290821de70fa0fb07dcb98b") == false;
    assert rc_is(RECEIPT, "key_id", "a05db80f53c317f6");
    assert rc_key(RECEIPT) == 11555594594871875574;
    assert rc_is(RECEIPT, "input_root", "cb6314866fd90700d464fc7f160236a93389358f8a1e417807ad1fe7664a1f1b");
    assert rc_nonce_bytes(RECEIPT) == 0;
    assert rc_nonce_bytes(RECEIPT_NONCE) == 20;
    assert rc_nonce_bytes("") == 0;
    var at : usize = rc_list_at(RECEIPT, LIST_INPUT);
    assert rc_is_leaf(RECEIPT, at);
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 0), leaf_field_to(RECEIPT, at, 0), "specs/a/b_c.t27");
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 1), leaf_field_to(RECEIPT, at, 1), "702d0ffd");
    at = line_end(RECEIPT, at) + 1;
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 0), leaf_field_to(RECEIPT, at, 0), "specs/network/usage.t27");
    at = line_end(RECEIPT, at) + 1;
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 0), leaf_field_to(RECEIPT, at, 0), "specs/tri/lab/receipt.t27");
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 1), leaf_field_to(RECEIPT, at, 1), "5133a2b2");
    assert leaf_kept(RECEIPT, at, LIST_INPUT);
    at = line_end(RECEIPT, at) + 1;
    assert rc_is_leaf(RECEIPT, at) == false;
    // an empty list and no list have no leaves
    assert rc_is_leaf(RECEIPT_NONCE, rc_list_at(RECEIPT_NONCE, LIST_INPUT)) == false;
    assert rc_list_at("", LIST_INPUT) == 0;
    assert rc_is_leaf("", 0) == false;
}

// Scenario: the seal bit is the reference verdict, field 2 of a verdict leaf: pass, pass again under a
// vacuous t27b, not under a failing reference.
test the_seal_bit_is_the_reference_verdict {
    var at : usize = rc_list_at(RECEIPT, LIST_VERDICT);
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 1), leaf_field_to(RECEIPT, at, 1), "pass");
    assert leaf_kept(RECEIPT, at, LIST_VERDICT);
    at = line_end(RECEIPT, at) + 1;
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 1), leaf_field_to(RECEIPT, at, 1), "pass_vacuous");
    assert leaf_kept(RECEIPT, at, LIST_VERDICT);
    at = line_end(RECEIPT, at) + 1;
    assert span_is(RECEIPT, leaf_field_from(RECEIPT, at, 2), leaf_field_to(RECEIPT, at, 2), "fail");
    assert leaf_kept(RECEIPT, at, LIST_VERDICT) == false;
    // a field a leaf does not have is empty
    assert leaf_field_from(RECEIPT, at, 3) == leaf_field_to(RECEIPT, at, 3);
    at = line_end(RECEIPT, at) + 1;
    assert rc_is_leaf(RECEIPT, at) == false;
}

// Scenario: a receipt counts only when compare authenticated it and it names its own commit; then it is
// LEVEL_AUTHOR under usage.t27's rules.
test a_receipt_counts_only_when_compare_accepts_it {
    assert receipt_auth(0, true) == 7;
    assert receipt_auth(0, false) == 0;
    assert receipt_auth(2, true) == 0;
    assert receipt_auth(1, true) == 0;
    assert receipt_auth(-1, true) == 0;
    assert usage_counts(hex_u64("6a8e44b5f2a7718924ac", 0, 16), receipt_auth(0, true), 0);
    assert usage_level(receipt_auth(0, true), 20) == LEVEL_AUTHOR;
    assert usage_counts(hex_u64("6a8e44b5f2a7718924ac", 0, 16), receipt_auth(2, true), 0) == false;
}

// Scenario: blame's porcelain gives each spec line to the commit of the header before it; a `previous`
// line is not a header, and only a block word at column 0 is a test.
test blame_lines_and_tests_go_to_their_commits {
    var at : usize = 0;
    var cur : usize = BLAME.len;
    var a_lines : u64 = 0;
    var a_tests : u64 = 0;
    var b_lines : u64 = 0;
    var b_tests : u64 = 0;
    var headers : u64 = 0;
    while (at < BLAME.len) {
        const e : usize = line_end(BLAME, at);
        if (bl_header(BLAME, at, e)) {
            cur = at;
            headers = headers + 1;
        }
        if (bl_line(BLAME, at, e)) {
            if (span_is(BLAME, cur, cur + 40, "36136f09263ac21c7290821de70fa0fb07dcb98b")) {
                a_lines = a_lines + 1;
                if (bl_test(BLAME, at, e)) { a_tests = a_tests + 1; }
            } else {
                b_lines = b_lines + 1;
                if (bl_test(BLAME, at, e)) { b_tests = b_tests + 1; }
            }
        }
        at = e + 1;
    }
    assert headers == 4;
    assert a_lines == 2 and a_tests == 1;
    assert b_lines == 2 and b_tests == 0;
    assert bl_test("\tinvariant x { }", 0, 15);
    assert bl_test("\tbench b {", 0, 10);
    assert bl_test("\ttests are not a block", 0, 22) == false;
    assert bl_test("\t    test indented {", 0, 20) == false;
    assert bl_test("test x {", 0, 8) == false;
}

// Scenario: an agent is declared by the author's name or by a trailer, in any case; a person named in a
// trailer, or an agent named in prose, declares nothing.
test the_agent_rule_reads_the_author_and_the_trailers {
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\nspecs: x (#2)\n\nbody\n\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>\n");
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\nbee: w\n\nCO-AUTHORED-BY:   Trinity Bee <bee@t27.ai>\r\n");
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\nq\n\nCo-authored-by: queen-publisher[bot] <q@t27.ai>");
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\nlab\n\nCo-authored-by: lab <lab@t27.ai>\n");
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\na\n\nCo-authored-by: Agent <agent@t27.ai>\n");
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\ngithub-actions[bot]\nchore: z\n");
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\nfix: y\n\nCo-Authored-By: Dmitrii Fedorov <dmitrii.f@t27.ai>\n") == false;
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\nnote: Co-authored-by: Claude is prose here\n") == false;
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nDmitrii Fedorov\nplain\n") == false;
    assert agent_record("") == false;
    assert agent_name("laboratory", 0, 10) == false;
    assert agent_name("x[bot]", 0, 6);
}

// Scenario: GitHub's answer is read at its own levels: the top-level sha, the verification flag, the
// top-level author's id and login -- never the commit's author object or a file entry.
test githubs_answer_is_read_at_its_own_levels {
    assert gh_read(GH, "36136f09263ac21c7290821de70fa0fb07dcb98b");
    assert gh_read(GH, "6a8e44b5f2a7718924ac378579d2d6aa4c73d8e4") == false;
    assert gh_read("", "36136f09263ac21c7290821de70fa0fb07dcb98b") == false;
    assert gh_verified(GH);
    assert gh_author(GH) == 6774813;
    assert span_is(GH, gh_login_from(GH), gh_login_to(GH), "gHashTag");
    assert gh_agent(GH) == false;
    // a squash GitHub's web-flow signed: verified, but not by its author
    assert span_is(GH, gh_email_from(GH, "committer"), gh_email_to(GH, "committer"), WEB_FLOW_EMAIL);
    assert span_is(GH, gh_email_from(GH, "author"), gh_email_to(GH, "author"), "admin@t27.ai");
    assert gh_author_signed(GH) == false;
    assert row_flags(GH, false, true, "") == 5;
    assert row_flags(GH, true, false, "") == 3;
    assert gh_verified(GH_UNSIGNED) == false;
    assert gh_author(GH_UNSIGNED) == NO_AUTHOR;
    assert gh_login_from(GH_UNSIGNED) == gh_login_to(GH_UNSIGNED);
    assert row_flags(GH_UNSIGNED, false, true, "") == 4;
    assert gh_agent(GH_BOT);
    assert row_flags(GH_BOT, false, false, "") == 3;
    assert credited_to(gh_author(GH_BOT), row_flags(GH_BOT, false, false, "")) == POOL_ID;
    // the squash's author is kept and held (DISPUTED); a commit its author signed is CONFIRMED
    assert credited_to(gh_author(GH), row_flags(GH, false, true, "")) == held_id(6774813);
    assert gh_author_signed(GH_SELF);
    assert row_flags(GH_SELF, false, true, "") == 13;
    assert credited_to(gh_author(GH_SELF), row_flags(GH_SELF, false, true, "")) == 6774813;
    // a commit a maintainer merged and signed: the row is the author's (101), held; the merger (202)
    // is never its author, and its signature confirms no one
    assert gh_author_signed(GH_MERGER) == false;
    assert gh_author_signed(GH_WEB_SELF) == false;
    assert gh_verified(GH_WEB_SELF);
    assert row_flags(GH_MERGER, false, true, "") == 5;
    assert gh_author(GH_MERGER) == 101;
    assert credited_to(gh_author(GH_MERGER), row_flags(GH_MERGER, false, true, "")) == held_id(101);
    // an unsigned commit with no account is held unclaimed, never given to the pool
    assert gh_author_signed(GH_UNSIGNED) == false and gh_author_signed(GH_BOT) == false and gh_author_signed("") == false;
    assert credited_to(gh_author(GH_UNSIGNED), row_flags(GH_UNSIGNED, false, true, "")) == held_id(NO_AUTHOR);
    // an agent's row needs no answer; a person's row with no answer is no verdict
    assert gh_unread("", "36136f09263ac21c7290821de70fa0fb07dcb98b", true) == false;
    assert gh_unread("", "36136f09263ac21c7290821de70fa0fb07dcb98b", false);
    assert gh_unread(GH, "36136f09263ac21c7290821de70fa0fb07dcb98b", false) == false;
    assert gh_verified("") == false and gh_author("") == NO_AUTHOR and row_flags("", false, false, "") == 0;
}

// Scenario: merging rows credited to one id changes no weight. The four rows of attribution.t27's spec 1
// go into three slots, and the merged table weighs exactly as the worked example says.
test merged_rows_weigh_as_the_rows_they_merge {
    assert table_slot(S1_SPEC, S1_AUTHOR, S1_LINES, S1_TESTS, S1_FLAGS, 303, 13, 30, 0) == 0;
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 303, 13, 30, 0) == 0;
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 505, 13, 1, 0) == 3;
    // carol's web-flow squash is held for carol: another id than her signed rows
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 303, 5, 30, 0) == 3;
    // another unsigned row of alice with the same seal bit joins her held row; a red one does not, and
    // an agent row is the pool's, not alice's
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 101, 4, 1, 0) == 2;
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 101, 0, 1, 0) == 3;
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 900, 7, 1, 0) == 3;
    // a merge past a clamp is refused
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 303, 13, LINES_MAX, 0) == ATTR_ROWS;
    assert table_slot(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 505, 5, 0, TESTS_MAX + 1) == ATTR_ROWS;
    // a full table has no slot for a new id
    assert table_slot(AE_SPEC, AE_AUTHOR, AE_LINES, AE_TESTS, AE_FLAGS, 505, 5, 1, 0) == ATTR_ROWS;
    var k : u32 = 0;
    while (k < 8) {
        const w : u64 = weight_of(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 0, AX_IDS[k]);
        assert w == weight_of(S1_SPEC, S1_AUTHOR, S1_LINES, S1_TESTS, S1_FLAGS, 0, AX_IDS[k]);
        assert w == AX_W1[k];
        k = k + 1;
    }
    assert weights_sum(M1_SPEC, M1_AUTHOR, M1_LINES, M1_TESTS, M1_FLAGS, 0) == BP_TOTAL;
}

// Scenario: usage splits by commit and by spec. The sum of usage_of over each commit's receipts alone is
// usage_of over all five, for every spec; a spec asked as bit 0 counts as its own bit does.
test usage_is_the_sum_of_one_table_per_commit {
    var s : u32 = 0;
    while (s < USAGE_SPECS) {
        const a : u64 = usage_of(C1_COMMIT, C1_KEY, C1_EPOCH, C1_AUTH, C1_NONCE, C1_READS, s, 7);
        const b : u64 = usage_of(C2_COMMIT, C2_KEY, C2_EPOCH, C2_AUTH, C2_NONCE, C2_READS, s, 7);
        assert a + b == usage_of(UX_COMMIT, UX_KEY, UX_EPOCH, UX_AUTH, UX_NONCE, UX_READS, s, 7);
        assert a + b == UX_USAGE[s];
        s = s + 1;
    }
    assert usage_of(UX_COMMIT, UX_KEY, UX_EPOCH, UX_AUTH, UX_NONCE, B1_READS, 0, 7) == UX_USAGE[1];
    assert usage_of(UX_COMMIT, UX_KEY, UX_EPOCH, UX_AUTH, UX_NONCE, B2_READS, 0, 7) == UX_USAGE[2];
}

// Scenario: the split folded spec by spec is usage.t27's split: the same claims, the same total, and
// the shares of its worked example (a pool of 1000: 375, 258, 283; dave's 50 held; POOL_ID paid
// nothing).
test the_split_spec_by_spec_is_usage_t27s_split {
    var total : u64 = 0;
    var s : u32 = 0;
    while (s < USAGE_SPECS) {
        total = total_add(total, UX_USAGE[s]);
        s = s + 1;
    }
    assert total == royalty_total(UX_USAGE);
    assert total == 60000;
    var k : u32 = 0;
    var paid : u64 = 0;
    var held : u64 = 0;
    while (k < 7) {
        var claim : u64 = 0;
        var t : u32 = 0;
        while (t < USAGE_SPECS) {
            claim = claim_add(claim, UX_USAGE[t], weight_of(UA_SPEC, UA_AUTHOR, UA_LINES, UA_TESTS, UA_FLAGS, t, UA_IDS[k]));
            t = t + 1;
        }
        assert claim == UA_CLAIM[k];
        assert claim == royalty_claim(UX_USAGE, UA_SPEC, UA_AUTHOR, UA_LINES, UA_TESTS, UA_FLAGS, UA_IDS[k]);
        const share : u64 = share_of(1000, claim, total, UA_IDS[k]);
        assert share == UA_SHARE[k];
        assert share == royalty_share(1000, UX_USAGE, UA_SPEC, UA_AUTHOR, UA_LINES, UA_TESTS, UA_FLAGS, UA_IDS[k]);
        paid = paid + share;
        held = held + held_of(1000, claim, total, UA_IDS[k]);
        k = k + 1;
    }
    assert paid == 916;
    assert held == 50;
    assert held == royalty_held_total(1000, UX_USAGE, UA_SPEC, UA_AUTHOR, UA_LINES, UA_TESTS, UA_FLAGS);
    assert share_of(1000, 2000, 60000, POOL_ID) == 0;
    assert share_of(1000, 2000, 60000, NO_AUTHOR) == 0;
    // a held id is credited a claim and paid nothing; what it would get is what is held
    assert share_of(1000, 3000, 60000, held_id(404)) == 0;
    assert held_of(1000, 3000, 60000, held_id(404)) == 50;
    assert held_of(1000, 3000, 60000, 404) == 0 and held_of(1000, 2000, 60000, POOL_ID) == 0;
}

// Scenario: share_floor is royalty_floor wherever royalty_floor's range holds, and stays exact past it.
test share_floor_is_exact_past_royalty_floors_range {
    assert share_floor(1000, 22500, 60000) == royalty_floor(1000, 22500, 60000);
    assert share_floor(18446744073709551615, 1, 3) == royalty_floor(18446744073709551615, 1, 3);
    assert share_floor(18446744073709551615, 2147483647, 2147483647) == 18446744073709551615;
    assert share_floor(123456789, 1234567, 2147483646) == royalty_floor(123456789, 1234567, 2147483646);
    // a total of 2^40, half of it claimed, of the whole u64 range: (2^64 - 1) / 2, rounded down
    assert share_floor(18446744073709551615, 549755813888, 1099511627776) == 9223372036854775807;
    // 2^63 - 1 claimed of SPLIT_MAX: the whole pool
    assert share_floor(18446744073709551615, SPLIT_MAX, SPLIT_MAX) == 18446744073709551615;
    assert share_floor(1000000, 1, SPLIT_MAX) == 0;
    assert share_floor(1000, 0, 60000) == 0;
    assert share_floor(1000, 60001, 60000) == 0;
    assert share_floor(1000, 1, 0) == 0;
    assert share_floor(1000, 1, SPLIT_MAX + 1) == 0;
    assert mul_div_small(2, 3, 7) == 0;
    assert mul_div_small(6, 7, 7) == 6;
    assert mul_div_small(4294967295, 4294967296, 4294967297) == 4294967294;
}

// Scenario: the exit is a table only with commits, a counting receipt, every answer read, no full table
// and a total in range.
test the_exit_is_no_verdict_unless_every_fact_was_read {
    assert pay_exit(12, 20, 0, 0, 60000) == PAY_OK;
    assert pay_exit(0, 0, 0, 0, 0) == PAY_UNREAD;
    assert pay_exit(12, 0, 0, 0, 0) == PAY_UNREAD;
    assert pay_exit(12, 20, 1, 0, 60000) == PAY_UNREAD;
    assert pay_exit(12, 20, 0, 1, 60000) == PAY_UNREAD;
    assert pay_exit(12, 20, 0, 0, SPLIT_MAX + 1) == PAY_UNREAD;
    assert span_is(pay_why(PAY_OK), 0, 6, "exit 0");
    assert span_is(pay_why(PAY_UNREAD), 0, 6, "exit 2");
    assert span_is(lab_url(0), 0, LAB_URL.len, LAB_URL);
    assert span_is(lab_url(1), 0, LAB2_URL.len, LAB2_URL);
    // the glue appends lab receipt.t27's RUNS, the sha and RECEIPT_EXT to lab_url(k)
    assert span_is(RUNS, 0, 5, "runs/") and span_is(RECEIPT_EXT, 0, 13, ".receipt.json");
    assert span_is(GH_CACHE, 0, 17, "tri-payout-github");
    assert span_is(rc_list(LIST_INPUT), 0, 5, "input");
    assert span_is(rc_list(LIST_VERDICT), 0, 7, "verdict");
}

// Scenario: a squash web-flow committed is read through its pull request. The pulls answer names the
// one whose merge_commit_sha is the commit; its commits are three items at base 2: A gHashTag's own,
// unsigned (held), B his own, signed (CONFIRMED alone), C Claude's under the `claude` account (the
// pool). His part is CONFIRMED only when all his commits are signed.
test the_original_commits_behind_a_squash_are_its_rows {
    assert gh_squash(GH) and needs_pull(GH, false);
    assert needs_pull(GH, true) == false and needs_pull(GH_SELF, false) == false and needs_pull("", false) == false;
    assert gh_list_read(PULLS) and gh_list_read("[]\n") and gh_list_read("[\n  {") == false and gh_list_read("") == false;
    assert gh_pull_number(PULLS, "36136f09263ac21c7290821de70fa0fb07dcb98b") == 8818;
    assert gh_pull_number(PULLS, "6a8e44b5f2a7718924ac378579d2d6aa4c73d8e4") == 8817;
    assert gh_pull_number(PULLS, "1111111111111111111111111111111111111111") == NOT_A_NUMBER;
    assert gh_pull_number("[]\n", "36136f09263ac21c7290821de70fa0fb07dcb98b") == NOT_A_NUMBER;
    const a : usize = gh_item_at(PC, 0);
    const b : usize = gh_item_at(PC, gh_item_end(PC, a));
    const c : usize = gh_item_at(PC, gh_item_end(PC, b));
    assert a == 2 and b > a and c > b and c < PC.len and gh_item_at(PC, gh_item_end(PC, c)) == PC.len;
    assert gh_item_end(PC, b) - b == PC_B.len + 1 and gh_item_end(PC, c) - c == PC_C.len;
    assert gh_base(PC) == 2 and gh_base(PC_A) == 2 and gh_base(GH) == 0 and gh_base("") == 0;
    assert gh_author(PC) == 6774813 and gh_author(PC_C) == 81847;
    assert gh_read(PC_B, "2222222222222222222222222222222222222222");
    assert orig_agent(PC_A) == false and orig_author(PC_A) == 6774813;
    assert row_flags(PC_A, orig_agent(PC_A), true, "") == 4;
    assert credited_to(orig_author(PC_A), row_flags(PC_A, false, true, "")) == held_id(6774813);
    assert gh_author_signed(PC_B) and row_flags(PC_B, orig_agent(PC_B), true, "") == 13;
    assert orig_agent(PC_C) and orig_author(PC_C) == POOL_ID and row_flags(PC_C, true, true, "") == 6;
    assert author_join(13, 4, true) == 4 and author_join(13, 13, true) == 13;
    assert author_join(4, 6, true) == 6 and author_join(13, 4, false) == 13;
    assert author_part(7, 3, 0) == 3 and author_part(7, 3, 1) == 2 and author_part(7, 3, 2) == 2;
}

// Scenario: co-authors come from the trailers, raw (git log) or JSON-escaped (GitHub's message). A
// no-reply email names its account; any other email is GitHub's lookup; an agent is the pool; prose
// that mentions a trailer is none. A trailer is never signed.
test co_authors_are_read_from_the_trailers {
    const f : usize = gh_message_from(PC_A);
    const e : usize = gh_message_to(PC_A);
    assert span_is(PC_A, f, f + 6, "fix: x") and PC_A[e] == 34;
    const p : usize = co_next(PC_A, f, e);
    const q : usize = co_end(PC_A, p, e);
    assert p > f and p < q and q < e;
    assert co_lookup(PC_A, p, q) == false and co_author(PC_A, p, q, "") == 256009718;
    assert co_flags(PC_A, p, q, "", true) == 4;
    const p2 : usize = co_next(PC_A, q, e);
    const q2 : usize = co_end(PC_A, p2, e);
    assert p2 > q and q2 == e;
    assert co_author(PC_A, p2, q2, "") == POOL_ID and co_flags(PC_A, p2, q2, "", false) == F_AGENT;
    assert co_lookup(PC_A, p2, q2) == false and co_next(PC_A, q2, e) == e;
    const rp : usize = co_next(RECORD_CO, 0, RECORD_CO.len);
    const rq : usize = co_end(RECORD_CO, rp, RECORD_CO.len);
    assert rp < rq and co_lookup(RECORD_CO, rp, rq);
    assert span_is(RECORD_CO, co_mail_from(RECORD_CO, rp, rq), co_mail_to(RECORD_CO, rp, rq), "dmitrii.f@t27.ai");
    assert co_author(RECORD_CO, rp, rq, LOOKUP) == 256009718;
    assert span_is(LOOKUP, gh_login_from(LOOKUP), gh_login_to(LOOKUP), "dmitrii-f-t27");
    // GitHub links the email to no one: the identity table's binding names Dmitrii Fedorov's account
    assert co_author(RECORD_CO, rp, rq, "[\n\n]\n") == 256009718 and co_author(RECORD_CO, rp, rq, "") == 256009718;
    // an email neither GitHub nor the table links stays unclaimed
    const up : usize = co_next(RECORD_UNKNOWN, 0, RECORD_UNKNOWN.len);
    const uq : usize = co_end(RECORD_UNKNOWN, up, RECORD_UNKNOWN.len);
    assert co_lookup(RECORD_UNKNOWN, up, uq) and co_author(RECORD_UNKNOWN, up, uq, "[\n\n]\n") == NO_AUTHOR;
    assert credited_to(co_author(RECORD_UNKNOWN, up, uq, ""), co_flags(RECORD_UNKNOWN, up, uq, "", true)) == held_id(NO_AUTHOR);
    assert co_next(PROSE_CO, 0, PROSE_CO.len) == PROSE_CO.len;
    assert noreply_id("6774813+gHashTag@users.noreply.github.com", 0, 41) == 6774813;
    assert noreply_id("playra@users.noreply.github.com", 0, 31) == NO_AUTHOR;
    assert noreply_id("x+y@example.org", 0, 15) == NO_AUTHOR;
    assert span_is(login_fallback(POOL_ID), 0, 4, "pool") and span_is(login_fallback(held_id(NO_AUTHOR)), 0, 9, "unclaimed");
    assert label_id(held_id(6774813)) == 6774813 and label_id(6774813) == 6774813 and label_id(POOL_ID) == POOL_ID;
    assert label_id(held_id(NO_AUTHOR)) == NO_AUTHOR and is_held(held_id(NO_AUTHOR));
    assert span_is(CACHE_PULLS, 0, 6, ".pulls") and span_is(COMMIT_PULLS, 0, 6, "/pulls") and span_is(HELD_LABEL, 0, 4, "held");
}

// Scenario (#8649): "Perplexity Computer" is an agent by its name and by its account, so its commits and
// its trailers go to the pool; an author email GitHub links to no one names the account the identity
// table binds it to, held for that author, never unclaimed.
test perplexity_computer_is_an_agent_and_a_bound_email_names_its_account {
    assert orig_agent(PX) and orig_author(PX) == POOL_ID;
    assert row_flags(PX, orig_agent(PX), true, "") == 6;
    assert credited_to(orig_author(PX), row_flags(PX, orig_agent(PX), true, "")) == POOL_ID;
    assert orig_agent(PX_RENAMED) and orig_author(PX_RENAMED) == POOL_ID and row_flags(PX_RENAMED, false, false, "") == 2;
    const f : usize = gh_message_from(PX);
    const e : usize = gh_message_to(PX);
    const p : usize = co_next(PX, f, e);
    const q : usize = co_end(PX, p, e);
    assert p < q and co_agent(PX, p, q, "") and co_author(PX, p, q, "") == POOL_ID and co_flags(PX, p, q, "", true) == 6;
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nPerplexity Computer\nfeat: x\n");
    assert agent_record("36136f09263ac21c7290821de70fa0fb07dcb98b\nVasilev Dmitrii\nfeat: y (#1051)\n\nCo-authored-by: Perplexity Computer <computer@perplexity.ai>\n");
    // a lookup that links a person's email to the agent's account makes that co-author the pool's too
    assert co_agent(RECORD_UNKNOWN, co_next(RECORD_UNKNOWN, 0, RECORD_UNKNOWN.len), co_end(RECORD_UNKNOWN, co_next(RECORD_UNKNOWN, 0, RECORD_UNKNOWN.len), RECORD_UNKNOWN.len), PX);
    assert gh_agent_account(GH) == false and gh_agent_account(GH_BOT) and gh_agent_account(PX);
    assert commit_author(GH_FEDOROV) == 256009718 and commit_author(GH_UNSIGNED) == NO_AUTHOR and commit_author(GH) == 6774813;
    assert credited_to(commit_author(GH_FEDOROV), row_flags(GH_FEDOROV, false, true, "")) == held_id(256009718);
    assert span_is(login_fallback(256009718), 0, 13, "dmitrii-f-t27") and span_is(login_fallback(276406286), 0, 14, "AgentMedia1942");
    assert span_is(login_fallback(101), 0, 9, "unclaimed");
}

// Scenario (#8649): ONE signed claim of alice (identity.t27's fixture table and claim, real Ed25519)
// turns her old commit that a merger's key signed -- held for her -- into a CONFIRMED row, paid to her.
// The same claim lists an agent's commit and a commit with no account: neither changes. bob's key on
// her claim confirms nothing.
test a_signed_claim_confirms_an_old_commit_of_its_own_author {
    const tab : IdentityTable = fixture_table();
    assert row_flags_in(tab, GH_MERGER, false, true, "") == 5;
    assert commit_author_in(tab, GH_MERGER) == 101;
    const fl : u8 = row_flags_in(tab, GH_MERGER, false, true, FX_CLAIM);
    assert fl == 21 and row_status(101, fl) == ST_CONFIRMED and credited_to(101, fl) == 101 and payable(101);
    assert row_flags_in(tab, GH_BOT, false, false, FX_CLAIM) == 3;
    assert row_flags_in(tab, GH_UNSIGNED, false, true, FX_CLAIM) == 4;
    assert row_flags_in(tab, GH_MERGER, false, true, FX_CLAIM_BOB) == 5;
    // the network's own table binds no signing key yet: the claim confirms nothing there
    assert row_flags(GH_MERGER, false, true, FX_CLAIM) == 5;
    // a part with one signed and one claimed commit is CONFIRMED; one unconfirmed commit keeps it held
    assert author_join(13, 20, true) == 20 and row_status(101, author_join(13, 20, true)) == ST_CONFIRMED;
    assert author_join(20, 4, true) == 4 and author_join(13, 4, true) == 4 and author_join(20, 6, true) == 6;
    assert NO_AUTHOR == ID_NO_ACCOUNT and ACCOUNT_MAX == ID_ACCOUNT_MAX;
}
