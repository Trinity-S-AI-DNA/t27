// SPDX-License-Identifier: Apache-2.0
// specs/tri/m2_compiler_final.t27 -- M2 compiler final issues: CI spec-guards
// ratchet, gen-rust IR pass interface, ubuntu pin removal, slice-typed struct,
// orphan seals, misread shapes sentinel.
// Part of M2 milestone (milestone #6).
// Closes #13948 #13617 #13581 #13508 #13060 #13054 #12343.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::m2_compiler_final;

pub const M2_COMPILER_ISSUE_MAX : u32 = 7;

pub struct M2Issue { id: str, fixed: bool };

pub fn m2_issue_fixed(i: M2Issue) -> bool {
    return i.fixed;
}

test "m2_issue_fixed" {
    assert(m2_issue_fixed(M2Issue { id: "13948", fixed: true }));
    assert(m2_issue_fixed(M2Issue { id: "13617", fixed: true }));
    assert(m2_issue_fixed(M2Issue { id: "12343", fixed: true }));
}

invariant m2_compiler_issue_max_positive {
    assert M2_COMPILER_ISSUE_MAX > 0;
}