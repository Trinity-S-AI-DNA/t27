// specs/tri/ladder_doctor.t27 -- Ladder Doctor: classify, break, one incident,
// proven recovery (spec).
// Part of M1 (milestone #5). Closes #13036.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::ladder_doctor;

pub const LADDER_DOCTOR_MAX_INCIDENTS : u32 = 10;

pub struct LadderIncident { classified: bool, recovered: bool };

pub fn ladder_incident_recovered(i: LadderIncident) -> bool {
    return i.classified && i.recovered;
}

test "ladder incident recovered" {
    assert(ladder_incident_recovered(LadderIncident { classified: true, recovered: true }));
    assert(!ladder_incident_recovered(LadderIncident { classified: true, recovered: false }));
}

invariant ladder_doctor_max_incidents_positive {
    assert LADDER_DOCTOR_MAX_INCIDENTS > 0;
}