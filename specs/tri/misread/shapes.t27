// SPDX-License-Identifier: Apache-2.0
; specs/tri/misread/shapes.t27 -- the shapes `tri misread` reads in generated code: the lines of t27c's
; Rust and C output that are the wreckage of a spec the compiler read wrongly. Ported from the
; hand-written detectors of cli/tri/src/misread.rs (#8967 pays for the `tri t27o` glue with them); that
; file keeps the corpus walk, the controls and the report, and reads these through `t27c gen-rust`
; (gen/rust/tri/misread/shapes.rs).
; --
; Each detector is anchored on the whole line, not on a substring: `pub f: ,` inside a comment or a string
; would otherwise count, and a census that counts prose is the defect this repository names most often.
; A line is trimmed as Rust's str::trim trims it, and a name and a word are read as misread.rs read them:
; tri::t27b::type_text's trim_lo / trim_hi, ws_at and ident, used here, not written again.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriMisreadShapes;

use tri::t27b::type_text;

/// No field: field_type_at's answer for a line that is not one.
pub const NO_FIELD : usize = 18446744073709551615;

/// Where the type of the field `pub <name>: <type>` starts (past its first `:`) when the trimmed line is
/// such a field and its name an identifier; NO_FIELD when it is not.
pub fn field_type_at(line: []const u8) -> usize {
    const a : usize = type_text::trim_lo(line, 0, line.len);
    const b : usize = type_text::trim_hi(line, a, line.len);
    if (b < a + 4 or line[a] != 112 or line[a + 1] != 117 or line[a + 2] != 98 or line[a + 3] != 32) { return NO_FIELD; }
    var c : usize = a + 4;
    while (c < b and line[c] != 58) { c += 1; }
    if (c >= b) { return NO_FIELD; }
    const na : usize = type_text::trim_lo(line, a + 4, c);
    if (!type_text::ident(line[na .. type_text::trim_hi(line, na, c)])) { return NO_FIELD; }
    return c + 1;
}

/// An integer literal: one optional `-`, then ASCII digits (the sign does not make it a type).
pub fn int_literal(s: []const u8, a: usize, b: usize) -> bool {
    var i : usize = a;
    if (i < b and s[i] == 45) { i += 1; }
    if (i >= b) { return false; }
    while (i < b) {
        if (!type_text::digit(s[i])) { return false; }
        i += 1;
    }
    return true;
}

/// `pub f: ,` -- a field of generated Rust whose type slot is empty.
pub fn rust_empty_type(line: []const u8) -> bool {
    const t : usize = field_type_at(line);
    if (t == NO_FIELD) { return false; }
    return type_text::trimmed_is(line[t .. line.len], ",");
}

/// `pub bad: 0,` -- a field whose type is an integer literal: accepted by `parse`, refused by `typecheck`
/// since #3225, and unparseable as Rust.
pub fn rust_literal_type(line: []const u8) -> bool {
    const t : usize = field_type_at(line);
    if (t == NO_FIELD) { return false; }
    const ta : usize = type_text::trim_lo(line, t, line.len);
    var tb : usize = type_text::trim_hi(line, ta, line.len);
    while (tb > ta and line[tb - 1] == 44) { tb -= 1; }
    return int_literal(line, ta, type_text::trim_hi(line, ta, tb));
}

/// `Vec<>` anywhere in the line: the element type was dropped on the way in.
pub fn rust_empty_generic(line: []const u8) -> bool {
    var i : usize = 0;
    while (i + 5 <= line.len) {
        if (line[i] == 86 and line[i + 1] == 101 and line[i + 2] == 99 and line[i + 3] == 60 and line[i + 4] == 62) { return true; }
        i += 1;
    }
    return false;
}

/// A field whose TYPE holds a bare colon. A Rust type never does: a path spells its separator `::`, and
/// no other type syntax admits a lone `:`. The shape does not say which wreck made it: a field swallowed
/// by the one before it (an inline `#` comment eats the rest of the line and the next declaration, so
/// `pub id: U8command:String..`), or a map type the emitter cannot spell (`Vec<str:str>`). The detector
/// reports the shape and leaves the cause to whoever reads the spec. Every `::` is skipped first, left to
/// right, so a path type is never reported.
pub fn rust_colon_in_type(line: []const u8) -> bool {
    const t : usize = field_type_at(line);
    if (t == NO_FIELD) { return false; }
    var i : usize = t;
    while (i < line.len) {
        if (line[i] == 58 and i + 1 < line.len and line[i + 1] == 58) {
            i += 2;
        } else if (line[i] == 58) {
            return true;
        } else {
            i += 1;
        }
    }
    return false;
}

/// The C half: `0 field;` -- exactly two words once the trailing `;`s are gone, a literal where a type
/// specifier must stand and then a name. Three words are a declaration with a qualifier, not this.
pub fn c_literal_type(line: []const u8) -> bool {
    const a : usize = type_text::trim_lo(line, 0, line.len);
    var b : usize = type_text::trim_hi(line, a, line.len);
    while (b > a and line[b - 1] == 59) { b -= 1; }
    var e1 : usize = a;
    while (e1 < b and type_text::ws_at(line, e1, b) == 0) { e1 += 1; }
    const w2 : usize = type_text::trim_lo(line, e1, b);
    var e2 : usize = w2;
    while (e2 < b and type_text::ws_at(line, e2, b) == 0) { e2 += 1; }
    if (e1 == a or e2 == w2 or type_text::trim_lo(line, e2, b) != b) { return false; }
    return int_literal(line, a, e1) and type_text::ident(line[w2 .. e2]);
}

// ---------------------------------------------------------------- tests (misread.rs's, ported)

test an_empty_type_slot_is_found {
    assert(rust_empty_type("    pub variants: ,"));
    assert(rust_empty_type("pub f: ,"));
}

test a_real_field_is_not_an_empty_type_slot {
    assert(!rust_empty_type("    pub kind: u8,"));
    assert(!rust_empty_type("    pub name: String,"));
    assert(!rust_empty_type("// pub f: ,"));
}

test a_literal_in_type_position_is_found_with_either_sign {
    assert(rust_literal_type("    pub success: 0,"));
    assert(rust_literal_type("    pub offset: -1,"));
}

test a_numeric_looking_type_name_is_not_a_literal {
    assert(!rust_literal_type("    pub v: u8,"));
    assert(!rust_literal_type("    pub v: i32,"));
    assert(!rust_literal_type("    pub v: f64,"));
}

test the_c_half_needs_exactly_a_literal_and_a_name {
    assert(c_literal_type("    0 bad;"));
    assert(!c_literal_type("    int32_t good;"));
    assert(!c_literal_type("    const int x;"));
    assert(c_literal_type("-1 x ;;"));
}

test a_bare_colon_in_a_type_is_found_whatever_wrecked_it {
    assert(rust_colon_in_type("    pub a: Floatb:String,"));
    assert(rust_colon_in_type("    pub env: Vec<str:str>,"));
    assert(rust_colon_in_type("    pub z: a:::b,"));
}

test a_path_type_is_not_a_bare_colon {
    assert(!rust_colon_in_type("    pub a: std::mem::Allocator,"));
    assert(!rust_colon_in_type("    pub v: Vec<HashMap<K, V>>,"));
    assert(!rust_colon_in_type("    pub p: *mut (),"));
}

test an_empty_generic_is_found_anywhere_in_the_line {
    assert(rust_empty_generic("    pub adj: Vec<>,"));
    assert(!rust_empty_generic("    pub adj: Vec<u8>,"));
    assert(field_type_at("pub 9x: u8,") == NO_FIELD and field_type_at("pubx: u8,") == NO_FIELD);
}
