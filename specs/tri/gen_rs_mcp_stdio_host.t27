// SPDX-License-Identifier: Apache-2.0
// specs/tri/tri/gen_rs_mcp_stdio_host.t27 -- t27c gen-c: no host entry point
// (argv, stdin, env); x86_64 tools need a hand C main.
// Part of M2 milestone (milestone #6). Closes #13386.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::gen_rs_mcp_stdio_host;

pub const GEN_RS_MCP_STDIO_HOST_MAX_ARGS : u32 = 256;

pub struct GenRsMcpStdioHost { host_entry_point: str };

pub fn gen_rs_mcp_stdio_host_entry_point(h: GenRsMcpStdioHost) -> str {
    return h.host_entry_point;
}

test "gen_rs_mcp_stdio_host_entry_point" {
    assert(gen_rs_mcp_stdio_host_entry_point(GenRsMcpStdioHost { host_entry_point: "main" }) == "main");
}

invariant gen_rs_mcp_stdio_host_max_args_positive {
    assert GEN_RS_MCP_STDIO_HOST_MAX_ARGS > 0;
}