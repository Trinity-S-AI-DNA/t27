// specs/tri/archive_finished_work.t27 -- Archive for finished work in the
// unified task view.
// Part of M4 milestone (milestone #8). Closes #12974.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::archive_finished_work;

pub const ARCHIVE_MAX_WORK_ITEMS : u32 = 1000;

pub struct WorkItem { id: str, finished: bool, archived: bool };

pub fn work_item_archived(w: WorkItem) -> bool {
    return w.finished && w.archived;
}

test "work_item_archived" {
    assert(work_item_archived(WorkItem { id: "item-1", finished: true, archived: true }));
    assert(!work_item_archived(WorkItem { id: "item-2", finished: true, archived: false }));
}

invariant archive_max_work_items_positive {
    assert ARCHIVE_MAX_WORK_ITEMS > 0;
}