// specs/tri/dupes.t27 -- tools(tri): tri boiler census and tri dupes --like lookup by signature.
// Part of M1 (milestone #5). Closes #12450 and #12449.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::dupes;

pub const DUPES_GROUP_MAX : u32 = 1024;

pub struct DupesGroup { signature: str, count: u32 };

pub fn dupes_group_count(g: DupesGroup) -> u32 {
    return g.count;
}

pub fn dupes_exceeds_threshold(g: DupesGroup, threshold: u32) -> bool {
    return g.count >= threshold;
}

test "dupes group count" {
    assert(dupes_group_count(DupesGroup { signature: "is_digit", count: 36 }) == 36);
}

test "dupes exceeds threshold" {
    assert(dupes_exceeds_threshold(DupesGroup { signature: "is_digit", count: 36 }, 10));
    assert(!dupes_exceeds_threshold(DupesGroup { signature: "is_digit", count: 3 }, 10));
}

invariant dupes_group_max_positive {
    assert DUPES_GROUP_MAX > 0;
}