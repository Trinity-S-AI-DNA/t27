// SPDX-License-Identifier: Apache-2.0
// specs/tri/agent_work_report.t27 -- Agent-work report spec: thread rows and
// the done / total percent rule.
// Part of M1 (milestone #5). Closes #13019.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::agent_work_report;

pub const WORK_REPORT_PERCENT_MAX : u32 = 100;

pub struct WorkReport { done: u32, total: u32 };

pub fn work_report_percent(r: WorkReport) -> u32 {
    if (r.total == 0) { return 0; }
    return r.done * 100 / r.total;
}

test "work report percent" {
    assert(work_report_percent(WorkReport { done: 50, total: 100 }) == 50);
    assert(work_report_percent(WorkReport { done: 0, total: 100 }) == 0);
    assert(work_report_percent(WorkReport { done: 100, total: 100 }) == 100);
}

invariant work_report_percent_max {
    assert WORK_REPORT_PERCENT_MAX == 100;
}