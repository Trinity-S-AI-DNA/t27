// specs/tri/plan_claims_leases.t27 -- t27 plan: claims and leases.
// Part of M4 milestone (milestone #8). Closes #13488.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::plan_claims_leases;

pub const PLAN_CLAIMS_MAX_LEASES : u32 = 16;

pub struct ClaimLease { claim_id: str, lease_held: bool };

pub fn claim_lease_held(c: ClaimLease) -> bool {
    return c.lease_held;
}

test "claim_lease_held" {
    assert(claim_lease_held(ClaimLease { claim_id: "claim-1", lease_held: true }));
    assert(!claim_lease_held(ClaimLease { claim_id: "claim-2", lease_held: false }));
}

invariant plan_claims_max_leases_positive {
    assert PLAN_CLAIMS_MAX_LEASES > 0;
}