// specs/tri/health.t27 -- tri: wire health, mount generated cards, drop unused commands.
// Part of M1 (milestone #5). Closes #13512.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::health;

pub const HEALTH_CHECK_MAX : u32 = 64;

pub struct HealthCheck { name: str, ok: bool, latency_ms: u32 };

pub fn health_check_ok(h: HealthCheck) -> bool {
    return h.ok;
}

pub fn health_check_latency(h: HealthCheck) -> u32 {
    return h.latency_ms;
}

test "health check ok" {
    assert(health_check_ok(HealthCheck { name: "db", ok: true, latency_ms: 5 }));
    assert(!health_check_ok(HealthCheck { name: "db", ok: false, latency_ms: 5 }));
}

test "health check latency" {
    assert(health_check_latency(HealthCheck { name: "db", ok: true, latency_ms: 42 }) == 42);
}

invariant health_has_name {
    var h = HealthCheck { name: "n", ok: true, latency_ms: 0 };
    assert h.name == "n";
}