// specs/tri/loop_lesson.t27 -- loop(lesson): lesson kinds and an extract rule,
// triggered at cycle end.
// Part of M1 (milestone #5). Closes #13322.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::loop_lesson;

pub const LESSON_KIND_MAX : u32 = 16;

pub struct LoopLesson { kind: str, extract_rule: bool, cycle_end: bool };

pub fn loop_lesson_extract(l: LoopLesson) -> bool {
    return l.extract_rule && l.cycle_end;
}

test "loop lesson extract" {
    assert(loop_lesson_extract(LoopLesson { kind: "extract", extract_rule: true, cycle_end: true }));
    assert(!loop_lesson_extract(LoopLesson { kind: "extract", extract_rule: false, cycle_end: true }));
}

invariant lesson_kind_max_positive {
    assert LESSON_KIND_MAX > 0;
}