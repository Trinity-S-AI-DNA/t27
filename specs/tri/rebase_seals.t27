// SPDX-License-Identifier: Apache-2.0
; specs/tri/rebase_seals.t27 -- auto-resolve seal JSON rebase conflicts.
; Issue #14063. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module TriRebaseSeals;

pub const OK        : u8 = 0;
pub const ERR_REAL  : u8 = 1;
pub const ERR_FIELD : u8 = 2;

pub const MUTABLE_FIELD   : str = "\"sealed_at\"";
pub const MARKER_HEAD     : str = "<<<<<<< ";
pub const MARKER_MID      : str = "=======";
pub const MARKER_TAIL     : str = ">>>>>>> ";
pub const MARKER_HEAD_LEN : usize = 8;
pub const MARKER_MID_LEN  : usize = 7;
pub const MARKER_TAIL_LEN : usize = 8;

invariant mutable_field_starts_with_quote { MUTABLE_FIELD[0] == 34; }
invariant marker_head_len_matches { MARKER_HEAD_LEN == 8; }
invariant marker_mid_len_matches  { MARKER_MID_LEN == 7; }
invariant marker_tail_len_matches { MARKER_TAIL_LEN == 8; }

; find returns the start index of needle in hay[from..to], or to if absent.
pub fn find(hay: []const u8, from: usize, to: usize,
            needle: []const u8, nlen: usize) -> usize {
    if nlen == 0 { return from; }
    if from + nlen > to { return to; }
    var i : usize = from;
    while i + nlen <= to {
        var j : usize = 0;
        var ok : bool = true;
        while j < nlen {
            if hay[i + j] != needle[j] { ok = false; break; }
            j = j + 1;
        }
        if ok { return i; }
        i = i + 1;
    }
    return to;
}

; skip_line advances past newline n times from pos.
pub fn skip_line(buf: []const u8, pos: usize, n: usize) -> usize {
    var p : usize = pos;
    var k : usize = 0;
    while k < n {
        while p < buf.len and buf[p] != 10 { p = p + 1; }
        if p < buf.len { p = p + 1; }
        k = k + 1;
    }
    return p;
}

; range_eq returns true iff buf[as..ae] byte-equals buf[bs..be].
pub fn range_eq(buf: []const u8, as: usize, ae: usize,
                bs: usize, be: usize) -> bool {
    if ae - as != be - bs { return false; }
    var i : usize = 0;
    while i < ae - as {
        if buf[as + i] != buf[bs + i] { return false; }
        i = i + 1;
    }
    return true;
}

; field_val_start finds the start of the value for JSON key in buf[from..to].
pub fn field_val_start(buf: []const u8, from: usize, to: usize,
                       key: []const u8, klen: usize) -> usize {
    var pos : usize = find(buf, from, to, key, klen);
    if pos == to { return to; }
    pos = pos + klen;
    while pos < to and buf[pos] != 58 { pos = pos + 1; }
    if pos >= to { return to; }
    pos = pos + 1;
    while pos < to and (buf[pos] == 32 or buf[pos] == 34) { pos = pos + 1; }
    return pos;
}

; field_val_end returns the end of the value starting at vs (past the opening quote).
pub fn field_val_end(buf: []const u8, vs: usize, to: usize) -> usize {
    var p : usize = vs;
    while p < to and buf[p] != 34 and buf[p] != 10 { p = p + 1; }
    return p;
}

; is_timestamp_only_conflict returns true iff the buffer has exactly one conflict
; block where the only differing field is sealed_at.
pub fn is_timestamp_only_conflict(buf: []const u8, n: usize) -> bool {
    var h0 : usize = find(buf, 0, n, MARKER_HEAD, MARKER_HEAD_LEN);
    if h0 == n { return false; }
    var m0 : usize = find(buf, h0, n, MARKER_MID, MARKER_MID_LEN);
    if m0 == n { return false; }
    var t0 : usize = find(buf, m0, n, MARKER_TAIL, MARKER_TAIL_LEN);
    if t0 == n { return false; }
    var after_tail : usize = skip_line(buf, t0, 1);
    var h1 : usize = find(buf, after_tail, n, MARKER_HEAD, MARKER_HEAD_LEN);
    if h1 != n { return false; }
    var hs : usize = skip_line(buf, h0, 1);
    var he : usize = m0;
    var ts : usize = skip_line(buf, m0, 1);
    var te : usize = t0;
    var hv : usize = field_val_start(buf, hs, he, MUTABLE_FIELD, 11);
    if hv == he { return false; }
    var hve : usize = field_val_end(buf, hv, he);
    var tv : usize = field_val_start(buf, ts, te, MUTABLE_FIELD, 11);
    if tv == te { return false; }
    var tve : usize = field_val_end(buf, tv, te);
    if range_eq(buf, hv, hve, tv, tve) { return false; }
    var i_h : usize = hs;
    var i_t : usize = ts;
    while i_h < he and i_t < te {
        if i_h >= hv and i_h < hve { i_h = hve; }
        if i_t >= tv and i_t < tve { i_t = tve; }
        if i_h >= he or i_t >= te { break; }
        if buf[i_h] != buf[i_t] { return false; }
        i_h = i_h + 1;
        i_t = i_t + 1;
    }
    return true;
}

test timestamp_only_conflict_detected {
    const src : str =
        "{\n<<<<<<< HEAD\n  \"sealed_at\": \"2026-11-16T08:00:00Z\",\n=======\n  \"sealed_at\": \"2026-11-15T07:59:08Z\",\n>>>>>>> master\n  \"spec_hash\": \"sha256:abc\"\n}\n";
    assert is_timestamp_only_conflict(src, src.len) == true;
}

test real_conflict_rejected {
    const src : str =
        "<<<<<<< HEAD\n  \"spec_hash\": \"sha256:aaa\",\n=======\n  \"spec_hash\": \"sha256:bbb\",\n>>>>>>> master\n";
    assert is_timestamp_only_conflict(src, src.len) == false;
}

test no_conflict_returns_false {
    const src : str = "{ \"sealed_at\": \"2026-01-01T00:00:00Z\" }\n";
    assert is_timestamp_only_conflict(src, src.len) == false;
}

test find_absent_returns_to {
    const hay : str = "hello world";
    assert find(hay, 0, hay.len, "xyz", 3) == hay.len;
}

test range_eq_cases {
    const s : str = "abcabc";
    assert range_eq(s, 0, 3, 3, 6) == true;
    assert range_eq(s, 0, 3, 1, 4) == false;
}
