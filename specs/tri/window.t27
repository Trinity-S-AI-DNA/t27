// specs/tri/window.t27 -- tri window: wire the generated .t27 spec.
// Part of M1 (milestone #5). Closes #13509.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::window;

pub const WINDOW_SPEC_PATH : str = "specs/t27os/glass_window.t27";

pub struct WindowSpec { path: str, generated: bool };

pub fn window_spec_path(w: WindowSpec) -> str {
    return w.path;
}

pub fn window_is_generated(w: WindowSpec) -> bool {
    return w.generated;
}

test "window spec path" {
    var w = WindowSpec { path: "specs/t27os/glass_window.t27", generated: true };
    assert(window_spec_path(w) == "specs/t27os/glass_window.t27");
}

test "window is generated flag" {
    assert(window_is_generated(WindowSpec { path: "x", generated: true }));
    assert(!window_is_generated(WindowSpec { path: "x", generated: false }));
}

invariant window_has_path {
    var w = WindowSpec { path: "p", generated: false };
    assert w.path == "p";
}