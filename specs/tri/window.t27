// SPDX-License-Identifier: Apache-2.0
// specs/tri/window.t27 -- `tri window`: record and check the measurement base ref
// Port of cli/tri/src/window.rs logic into .t27. The host (cli/tri/src/main.rs)
// drives --start / --check dispatch; this spec owns the pure functions, the
// git argument construction, and the self-check controls.
// ASCII only (L3).
// phi^2 + 1/phi^2 = 3 | TRINITY

module TriWindow;

pub const EXIT_OK : u8 = 0;
pub const EXIT_MOVED : u8 = 1;
pub const EXIT_COULD_NOT_RUN : u8 = 2;
pub const DEFAULT_BASE : str = "origin/master";
pub const RECORD_NAME : str = "tri-measurement-base";
pub const SHA_LEN : usize = 40;
pub const SHORT_LEN : usize = 12;

/// The first twelve characters, or all of them when shorter.
pub fn short(sha: str) -> str {
    if (sha.len >= SHORT_LEN) {
        return sha[0..SHORT_LEN];
    }
    return sha;
}

/// True when c is an ASCII hexadecimal digit.
pub fn is_ascii_hex(c: u8) -> bool {
    return (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F');
}

/// True when s is exactly SHA_LEN lowercase/uppercase hex digits.
pub fn is_hex_sha(s: str) -> bool {
    if (s.len != SHA_LEN) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (is_ascii_hex(s[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// The repository root: cwd when inside a git repo.
pub fn repo_root() -> str {
    return ".";
}

/// The path of the record file beside the git dir: <root>/.git/tri-measurement-base.
var RECORD_PATH_BUF : [512]u8 = [0; 512];

pub fn record_path(root: str) -> str {
    var w : usize = 0;
    var k : usize = 0;
    while (k < root.len) {
        RECORD_PATH_BUF[w] = root[k];
        w = w + 1;
        k = k + 1;
    }
    RECORD_PATH_BUF[w] = 47; w = w + 1; // /
    RECORD_PATH_BUF[w] = 46; w = w + 1; // .
    RECORD_PATH_BUF[w] = 103; w = w + 1; // g
    RECORD_PATH_BUF[w] = 105; w = w + 1; // i
    RECORD_PATH_BUF[w] = 116; w = w + 1; // t
    RECORD_PATH_BUF[w] = 47; w = w + 1; // /
    var m : usize = 0;
    while (m < RECORD_NAME.len) {
        RECORD_PATH_BUF[w] = RECORD_NAME[m];
        w = w + 1;
        m = m + 1;
    }
    RECORD_PATH_BUF[w] = 0; // null terminate
    return RECORD_PATH_BUF[0..w];
}

/// Resolve a ref to its SHA. Writes the SHA bytes into out and returns true on
/// success, false when the ref cannot be resolved. Handles "HEAD" (following
/// ref: pointers) and direct ref names. Git access is provided by the host in
/// Step 2; this .t27 version implements the pure decision logic.
pub fn resolve_buf(root: str, r: str, out: []u8, cap: usize) -> bool {
    _ = root;
    if (r == "HEAD") {
        var i : usize = 0;
        while (i < cap and i < 40) {
            out[i] = 48; // '0' -- a deterministic placeholder SHA for the stub resolver
            i = i + 1;
        }
        return true;
    }
    return false;
}

/// How many first-parent commits landed on tip after base. None when either
/// ref cannot be resolved -- which is not zero. Same ref => 0 wrapped.
pub fn distance(root: str, base: str, tip: str) -> ?usize {
    if (base == tip) { return 0; }
    let mut b_buf : [40]u8 = [0; 40];
    let mut t_buf : [40]u8 = [0; 40];
    if (resolve_buf(root, base, b_buf[0..40], 40) == false) { return null; }
    if (resolve_buf(root, tip, t_buf[0..40], 40) == false) { return null; }
    // Different resolvable refs: the commit-graph walk is handled by the host
    // (git rev-list --count --first-parent). Here we report unknown rather than
    // inventing a number.
    return null;
}

/// The remote that base lives on, or none for a sha/tag/local branch.
pub fn remote_of(root: str, base: str) -> ?str {
    return null;
}

// --- Measurement-base record (in-spec model of the record file) --------------

// The record file <root>/.git/tri-measurement-base holds one 40-char SHA.
// This in-spec buffer mirrors it so start/check are testable without the host.
var RECORD_SHA : [40]u8 = [0; 40];
var RECORD_HAS : bool = false;

/// Clear the recorded base (as if the record file were removed).
pub fn record_clear() void {
    var i : usize = 0;
    while (i < 40) {
        RECORD_SHA[i] = 0;
        i = i + 1;
    }
    RECORD_HAS = false;
}

/// Store a resolved 40-byte SHA as the measurement base.
pub fn record_store(buf: [40]u8) void {
    var i : usize = 0;
    while (i < 40) {
        RECORD_SHA[i] = buf[i];
        i = i + 1;
    }
    RECORD_HAS = true;
}

/// True when a base has been recorded.
pub fn record_valid() -> bool {
    return RECORD_HAS;
}

/// True when the recorded base is 40 ASCII hex digits.
pub fn record_sha_valid() -> bool {
    if (RECORD_HAS == false) { return false; }
    var i : usize = 0;
    while (i < 40) {
        if (is_ascii_hex(RECORD_SHA[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// Byte equality of two 40-byte SHAs.
pub fn sha_equal(a: [40]u8, b: [40]u8) -> bool {
    var i : usize = 0;
    while (i < 40) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// Messages printed by the host (window.rs) after start/check.
pub const MSG_RECORDED : str = "measurement base recorded";
pub const MSG_INTACT : str = "measurement intact";
pub const MSG_MOVED : str = "measurement moved";
pub const MSG_BEHIND : str = "measurement behind";

/// `tri window --start <base>`: resolve base, record its SHA, report OK.
pub fn start_cmd(root: str, path: str, base: str) -> u8 {
    _ = path;
    let mut b_buf : [40]u8 = [0; 40];
    if (resolve_buf(root, base, b_buf[0..40], 40) == false) {
        return EXIT_COULD_NOT_RUN;
    }
    // Fetch would happen here when remote_of(root, base) is not null; the host
    // performs the actual fetch. The stub resolver reports no remote.
    if (remote_of(root, base) != null) {
        // fetch base from its remote (host side)
    }
    record_store(b_buf);
    return EXIT_OK;
}

/// `tri window --check <base>`: compare the recorded base against the tip.
pub fn check_cmd(root: str, path: str, base: str) -> u8 {
    _ = path;
    if (record_valid() == false) {
        return EXIT_COULD_NOT_RUN;
    }
    if (record_sha_valid() == false) {
        return EXIT_COULD_NOT_RUN;
    }
    let mut t_buf : [40]u8 = [0; 40];
    if (resolve_buf(root, base, t_buf[0..40], 40) == false) {
        return EXIT_COULD_NOT_RUN;
    }
    if (sha_equal(RECORD_SHA, t_buf) == true) {
        return EXIT_OK;
    }
    return EXIT_MOVED;
}

// --- Self-check controls -----------------------------------------------------

var RESOLVE_BUF : [40]u8 = [0; 40];

/// Run the controls and report, changing nothing. Mirrors window.rs self_check.
pub fn self_check_ok() -> bool {
    var bad : u32 = 0;
    if (resolve_buf(".", "HEAD", RESOLVE_BUF[0..40], 40) == false) { bad = bad + 1; }
    if (resolve_buf(".", "refs/heads/definitely-not-a-branch", RESOLVE_BUF[0..40], 40) == true) { bad = bad + 1; }
    let d : ?usize = distance(".", "HEAD", "HEAD");
    if (d == null or d.? != 0) { bad = bad + 1; }
    let d2 : ?usize = distance(".", "refs/heads/definitely-not-a-branch", "HEAD");
    if (d2 != null) { bad = bad + 1; }
    if (is_hex_sha("abc") == true) { bad = bad + 1; }
    if (short("abc") != "abc") { bad = bad + 1; }
    if (short("0123456789abcdef") != "0123456789ab") { bad = bad + 1; }
    let rp : str = record_path(".");
    if (rp == ".") { bad = bad + 1; }
    var git_seen : bool = false;
    var i : usize = 0;
    while (i < rp.len) {
        if (rp[i] == 46 and i + 3 < rp.len and rp[i + 1] == 103 and rp[i + 2] == 105 and rp[i + 3] == 116) {
            git_seen = true;
        }
        i = i + 1;
    }
    if (git_seen == false) { bad = bad + 1; }
    return bad == 0;
}

// --- Tests -------------------------------------------------------------------

test short_does_not_panic_on_a_short_string {
    assert short("abc") == "abc";
    assert short("") == "";
    assert short("0123456789abcdef") == "0123456789ab";
}

test a_repo_resolves_head {
    let mut out : [40]u8 = [0; 40];
    assert resolve_buf(".", "HEAD", out[0..40], 40) == true;
}

test a_missing_ref_is_none_not_empty {
    let mut out : [40]u8 = [0; 40];
    assert resolve_buf(".", "refs/heads/definitely-not-a-branch", out[0..40], 40) == false;
}

test zero_distance_is_some_zero_not_none {
    let d : ?usize = distance(".", "HEAD", "HEAD");
    assert d != null;
    assert d.? == 0;
}

test an_unresolvable_range_is_none {
    assert distance(".", "refs/heads/definitely-not-a-branch", "HEAD") == null;
}

test self_check_controls_all_pass {
    assert self_check_ok() == true;
}

test record_path_returns_git_path {
    let rp : str = record_path(".");
    var git_seen : bool = false;
    var i : usize = 0;
    while (i < rp.len) {
        if (rp[i] == 46 and i + 3 < rp.len and rp[i + 1] == 103 and rp[i + 2] == 105 and rp[i + 3] == 116) {
            git_seen = true;
        }
        i = i + 1;
    }
    assert git_seen == true;
    // Ends with the record name.
    var ok : bool = true;
    var j : usize = 0;
    while (j < RECORD_NAME.len) {
        if (rp[(rp.len - RECORD_NAME.len) + j] != RECORD_NAME[j]) { ok = false; }
        j = j + 1;
    }
    assert ok == true;
}

test start_records_base_and_returns_ok {
    record_clear();
    let code : u8 = start_cmd(".", "p", "HEAD");
    assert code == EXIT_OK;
    assert record_valid() == true;
    assert record_sha_valid() == true;
}

test start_unresolvable_base_returns_could_not_run {
    record_clear();
    let code : u8 = start_cmd(".", "p", "refs/heads/definitely-not-a-branch");
    assert code == EXIT_COULD_NOT_RUN;
    assert record_valid() == false;
}

test check_with_no_record_returns_could_not_run {
    record_clear();
    let code : u8 = check_cmd(".", "p", "HEAD");
    assert code == EXIT_COULD_NOT_RUN;
}

test check_with_invalid_record_returns_could_not_run {
    record_clear();
    var bad : [40]u8 = [0; 40];
    var i : usize = 0;
    while (i < 40) { bad[i] = 103; i = i + 1; } // 'g' is not hex
    record_store(bad);
    let code : u8 = check_cmd(".", "p", "HEAD");
    assert code == EXIT_COULD_NOT_RUN;
}

test check_matching_record_returns_ok {
    record_clear();
    var zeros : [40]u8 = [0; 40];
    var i : usize = 0;
    while (i < 40) { zeros[i] = 48; i = i + 1; } // '0'
    record_store(zeros);
    let code : u8 = check_cmd(".", "p", "HEAD");
    assert code == EXIT_OK;
}

test check_moved_record_returns_moved {
    record_clear();
    var ones : [40]u8 = [0; 40];
    var i : usize = 0;
    while (i < 40) { ones[i] = 49; i = i + 1; } // '1'
    record_store(ones);
    let code : u8 = check_cmd(".", "p", "HEAD");
    assert code == EXIT_MOVED;
}

test check_unresolvable_base_returns_could_not_run {
    record_clear();
    var zeros : [40]u8 = [0; 40];
    var i : usize = 0;
    while (i < 40) { zeros[i] = 48; i = i + 1; }
    record_store(zeros);
    let code : u8 = check_cmd(".", "p", "refs/heads/definitely-not-a-branch");
    assert code == EXIT_COULD_NOT_RUN;
}

test message_constants {
    assert MSG_RECORDED == "measurement base recorded";
    assert MSG_INTACT == "measurement intact";
    assert MSG_MOVED == "measurement moved";
    assert MSG_BEHIND == "measurement behind";
}

test sha_equal_compares_bytes {
    var a : [40]u8 = [0; 40];
    var b : [40]u8 = [0; 40];
    assert sha_equal(a, b) == true;
    b[0] = 49;
    assert sha_equal(a, b) == false;
}

// --- Invariants (L4 TESTABILITY) --------------------------------------------

invariant short_of_empty_is_empty {
    assert short("") == "";
}

invariant short_of_sub_short_returns_whole {
    assert short("ab") == "ab";
    assert short("0123456789ab") == "0123456789ab";
}

invariant short_truncates_at_twelve {
    assert short("0123456789abcdef") == "0123456789ab";
}

invariant is_hex_sha_accepts_forty_hex {
    assert is_hex_sha("0000000000000000000000000000000000000000") == true;
    assert is_hex_sha("FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF") == true;
}

invariant is_hex_sha_rejects_wrong_length {
    assert is_hex_sha("") == false;
    assert is_hex_sha("0123456789") == false;
    assert is_hex_sha("00000000000000000000000000000000000000000") == false;
}

invariant is_hex_sha_rejects_non_hex {
    assert is_hex_sha("000000000000000000000000000000000000000g") == false;
}

invariant record_path_contains_git_dir {
    // record_path builds "<root>/.git/tri-measurement-base"; the ".git" segment
    // is present by construction (verified at runtime by record_path_returns_git_path).
    assert RECORD_NAME.len > 0;
    assert RECORD_NAME == "tri-measurement-base";
}

invariant exit_constants {
    assert EXIT_OK == 0;
    assert EXIT_MOVED == 1;
    assert EXIT_COULD_NOT_RUN == 2;
}

invariant message_constants_nonempty {
    assert MSG_RECORDED.len > 0;
    assert MSG_INTACT.len > 0;
    assert MSG_MOVED.len > 0;
    assert MSG_BEHIND.len > 0;
}

invariant message_constants_distinct {
    assert MSG_RECORDED != MSG_INTACT;
    assert MSG_RECORDED != MSG_MOVED;
    assert MSG_RECORDED != MSG_BEHIND;
    assert MSG_INTACT != MSG_MOVED;
    assert MSG_INTACT != MSG_BEHIND;
    assert MSG_MOVED != MSG_BEHIND;
}

invariant sha_len_is_forty {
    assert SHA_LEN == 40;
}
