// SPDX-License-Identifier: Apache-2.0
; specs/tri/dsh_practice_adoption_plan.t27 -- the gate that decides which DeepSeek Harness (dsh) practices T27 M adopts (gHashTag/t27#12952)
; Part of epic #12945 (T27 M, the Golden Builder), after the Phase 0 baseline of #12948. The goal is not to copy dsh: it is to read the
; official dsh documents and source first, extract the practices worth testing, put each on a matryoshka layer, test it against the
; fixed baseline and adopt only what improves something that was measured. This spec is the record and the gate. The prose, the
; sources, the commands and the receipts of every record are in specs/tri/dsh_best_practices.md; the two are checked against each
; other by the counting command at the end of this header.
; --
; The pin every record is tested against: the dsh clone at commit ce7073d512 = dsh-v0.2.2-alpha.2-351 (2026-10-30), Node v22.22.0,
; Apple M1 Pro 16 GB, Darwin 25.5.0, headless profile, read-only sandbox, approval policy never. Nothing under the dsh clone was
; edited and the running dsh on the machine was not touched.
; --
; The four conditions of the adoption gate (FR-004). A practice is ADOPTED only when all four hold at once:
; - A: it applies to the pinned version (and to the profile a lane can run);
; - B: it does not break the Phase 0 baseline: the rows of #12948 rerun after adopting it and compared (B_KEPT), or the practice
;   changes no run at all (analysis of a trace) and so keeps the rows by construction (B_KEPT);
; - C: it has a test, a receipt or a measured improvement;
; - D: it needs no change to the upstream fork.
; Anything else is REJECTED (A fails, B is B_BROKEN, or D fails: the pin cannot take it) or DEFERRED (B is B_UNTESTED, or C fails:
; it may be right, it is not shown). The recorded status of every record must equal the verdict the gate computes from its four
; conditions, so a record cannot claim ADOPTED while a condition is false (test recorded_status_is_the_gate_verdict).
; --
; The saving chain (FR-005): an adopted record names "dsh practice -> matryoshka implementation -> measured saving". A saving that
; was not measured reads "not measured" (test the_saving_chain_is_named_or_not_measured).
; --
; Layers: L0 owner approval (permission gate); L1 Queen / orchestrator (orchestrator agent and budget policy); L2 planner and
; reviewer; L3 worker / coder; L4 extractor / formatter (the cheap-model skill); L5 deterministic tools (tests, parsers, CI, seals,
; the ledger); LAYER_CROSS for what runs through every layer (trace, session log, scheduled audit, plugin manifest).
; --
; Safety (FR-006): the upstream SAFETY.md was reread before any record that touches permissions or tools (P1, P2, P5) and every run
; used the read-only sandbox. Provider keys come from the key master's environment by name; no value is stored here.
; --
; Counting command (run from the repo root, no build needed; the bracket keeps this line from matching itself, swap ADOPTED for REJECTED
; or DEFERRED, with the first letter in brackets, for the other two counts): grep -c 'status: S_[A]DOPTED, reason' specs/tri/dsh_practice_adoption_plan.t27
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriDshPracticeAdoption;

use tri::lab::receipt::span_is;

pub const DSH_PIN : string = "dsh-v0.2.2-alpha.2-351 (ce7073d512), 2026-10-30";
pub const SANDBOX_MODE : string = "read-only";
pub const MACHINE : string = "Apple M1 Pro 16 GB, Darwin 25.5.0, Node v22.22.0";
pub const RUN_DATE : string = "2026-10-31";
pub const NOT_MEASURED : string = "not measured";

pub const PRACTICES : u8 = 15;

// adoption_status
pub const S_NEEDS_TEST : u8 = 0;
pub const S_ADOPTED : u8 = 1;
pub const S_REJECTED : u8 = 2;
pub const S_DEFERRED : u8 = 3;

// matryoshka layer
pub const LAYER_0 : u8 = 0;
pub const LAYER_1 : u8 = 1;
pub const LAYER_2 : u8 = 2;
pub const LAYER_3 : u8 = 3;
pub const LAYER_4 : u8 = 4;
pub const LAYER_5 : u8 = 5;
pub const LAYER_CROSS : u8 = 6;

// source_type
pub const SRC_OFFICIAL : u8 = 0;
pub const SRC_COMMUNITY : u8 = 1;
pub const SRC_BLOG : u8 = 2;

// condition B: the Phase 0 baseline rows after adoption
pub const B_UNTESTED : u8 = 0;
pub const B_KEPT : u8 = 1;
pub const B_BROKEN : u8 = 2;

invariant the_statuses_layers_and_baselines_are_numbered { assert S_NEEDS_TEST < S_ADOPTED and S_ADOPTED < S_REJECTED and S_REJECTED < S_DEFERRED and LAYER_0 < LAYER_1 and LAYER_1 < LAYER_2 and LAYER_2 < LAYER_3 and LAYER_3 < LAYER_4 and LAYER_4 < LAYER_5 and LAYER_5 < LAYER_CROSS and SRC_OFFICIAL < SRC_COMMUNITY and SRC_COMMUNITY < SRC_BLOG and B_UNTESTED < B_KEPT and B_KEPT < B_BROKEN and PRACTICES == 15; }

/// One practice, one record (FR-001). The four conditions are the fields applicable, baseline, has_evidence and fork_free; status is
/// the decision as recorded and must equal verdict(). measured_benefit is a number with its command, or "not measured".
pub struct Practice {
    id: u8,
    practice: string,
    source: string,
    source_type: u8,
    layer: u8,
    applicable: bool,
    baseline: u8,
    has_evidence: bool,
    fork_free: bool,
    status: u8,
    reason: string,
    expected_benefit: string,
    measured_benefit: string,
    saving_measured: bool,
    implementation: string,
    risk: string,
    test_cmd: string,
}

// --- the gate ------------------------------------------------------------------------------------

pub fn gate_a(p: Practice) -> bool { return p.applicable; }
pub fn gate_b(p: Practice) -> bool { return p.baseline == B_KEPT; }
pub fn gate_c(p: Practice) -> bool { return p.has_evidence; }
pub fn gate_d(p: Practice) -> bool { return p.fork_free; }

/// How many of the four conditions hold.
pub fn gates_passed(p: Practice) -> u8 {
    var n : u8 = 0;
    if (gate_a(p)) { n = n + 1; }
    if (gate_b(p)) { n = n + 1; }
    if (gate_c(p)) { n = n + 1; }
    if (gate_d(p)) { n = n + 1; }
    return n;
}

/// Adopted only when all four conditions hold.
pub fn adopted(p: Practice) -> bool {
    return gate_a(p) and gate_b(p) and gate_c(p) and gate_d(p);
}

/// The decision the gate gives: REJECTED when the pin cannot take the practice (A fails, B is broken, D fails), DEFERRED when it may be
/// right but is not shown (B untested or C fails), ADOPTED when all four hold.
pub fn verdict(p: Practice) -> u8 {
    if (p.applicable == false) { return S_REJECTED; }
    if (p.baseline == B_BROKEN) { return S_REJECTED; }
    if (p.fork_free == false) { return S_REJECTED; }
    if (p.baseline == B_UNTESTED or p.has_evidence == false) { return S_DEFERRED; }
    return S_ADOPTED;
}

/// A record built from the four conditions alone, for the negative controls of the tests.
pub fn probe(a: bool, b: u8, c: bool, d: bool) -> Practice {
    return Practice { id: 0, practice: "", source: "", source_type: SRC_OFFICIAL, layer: LAYER_CROSS, applicable: a, baseline: b, has_evidence: c, fork_free: d, status: S_NEEDS_TEST, reason: "", expected_benefit: "", measured_benefit: NOT_MEASURED, saving_measured: false, implementation: "", risk: "", test_cmd: "" };
}

// --- the fifteen records (FR-002, none skipped) ---------------------------------------------------

/// The record of practice k (1 to 15); an empty record with id 0 for any other k.
pub fn practice(k: u8) -> Practice {
    if (k == 1) {
        return Practice { id: 1, practice: "plugin manifest, permissions, versioning and rollback", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/user/guide/plugin-market.md", source_type: SRC_OFFICIAL, layer: LAYER_CROSS, applicable: true, baseline: B_UNTESTED, has_evidence: false, fork_free: true, status: S_DEFERRED, reason: "A market install writes to the shared dsh state under the home folder, which this lane may not touch, and the headless profile has no plugin manager; versions and rollback exist in the documents (engines.dsh) and were read, not run.", expected_benefit: "a plugin declares its permissions and its dsh range, so it can be pinned and rolled back", measured_benefit: NOT_MEASURED, saving_measured: false, implementation: "none yet", risk: "an install writes shared state and a plugin widens the tool set", test_cmd: "none run; reopen when a dsh run can use a scratch state folder" };
    }
    if (k == 2) {
        return Practice { id: 2, practice: "Creator Mode safety rails", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/.agents/notes/implemented/architecture/2026-09-16-creator-persistent-plugin-management.md", source_type: SRC_OFFICIAL, layer: LAYER_0, applicable: false, baseline: B_UNTESTED, has_evidence: true, fork_free: true, status: S_REJECTED, reason: "At the pin the tool-plugin-manager row is disabled in the headless profile: 0 of 54 exposed tools are plugin_manager in 7 of 7 logs. Turning the row on widens the tool set, which FR-006 forbids without a test.", expected_benefit: "an approval gate in front of every plugin change", measured_benefit: "0 plugin_manager tools among 54 in 7 of 7 logs (grep -c plugin_manager on each log)", saving_measured: false, implementation: "none: L0 stays the owner approval gate", risk: "enabling the row exposes plugin install and edit to a model", test_cmd: "static: grep -c plugin_manager on the session logs, and --dump-config on the merged config" };
    }
    if (k == 3) {
        return Practice { id: 3, practice: "trace capture for every model and tool call", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/subsystems/otel.md", source_type: SRC_OFFICIAL, layer: LAYER_CROSS, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "The local session log already records every model step and tool call: 49 of 49 tool calls of Phase 0 have a result (3 of 59 steps are open: the 3 runs killed by the timeout) and 7 of 7 new runs have step start = step end with every call matched by a result. The default export (FEEDBACK_ONLY) targets a third-party collector, so lanes set DSH_TELEMETRY_MODE=DISABLED: row 1 rerun with it was correct, 28 s, 0 stderr bytes.", expected_benefit: "every wrong answer can be traced to the step that made it", measured_benefit: "7 of 7 logs complete (grep -c on step/start, step/end, tool/call, tool/result)", saving_measured: false, implementation: "lane receipts are read from the local session log; every lane run sets DSH_TELEMETRY_MODE=DISABLED", risk: "the log holds tool results, so it is never pasted into a public place", test_cmd: "grep -c by event type on each log, then the row 1 rerun" };
    }
    if (k == 4) {
        return Practice { id: 4, practice: "append-only session logs with resume, fork and replay", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/session-format-status.md", source_type: SRC_OFFICIAL, layer: LAYER_CROSS, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "Resume measured: --session-id re-opened the 5b control session in 8 s, the log grew from 27 to 37 lines, the first 27 lines are byte-identical (cmp) and the model recalled the commit it had reported. Fork and replay were not exercised and stay out of the adopted scope.", expected_benefit: "a lane continues a session instead of paying for the same lookup again", measured_benefit: "8 s to recall a fact against 24 s for the fresh run that found it (one pair, one run each)", saving_measured: true, implementation: "a follow-up question to a finished lane goes to its session id, not to a fresh run", risk: "a resumed session carries its old context and its old mistakes", test_cmd: "dsh --session-id session-<uuid> then cmp of the first 27 lines of the log" };
    }
    if (k == 5) {
        return Practice { id: 5, practice: "scheduled-task contract with explicit schedule and expiry", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/user/guide/schedule.md", source_type: SRC_OFFICIAL, layer: LAYER_CROSS, applicable: false, baseline: B_UNTESTED, has_evidence: true, fork_free: true, status: S_REJECTED, reason: "The profile a lane can run exposes no schedule tool (0 of 54), and a schedule needs the server profile and writes shared state. The contract itself (explicit schedule, explicit expiry) is kept on the T27 side where the scheduler is. Reopen when a profile with the tool can run on scratch state.", expected_benefit: "a recurring job states when it runs and when it stops", measured_benefit: "0 schedule tools among 54 in 7 of 7 logs (grep on request/header)", saving_measured: false, implementation: "none in dsh", risk: "an unattended schedule keeps spending after its purpose is over", test_cmd: "static: tool list of request/header in each log" };
    }
    if (k == 6) {
        return Practice { id: 6, practice: "layered configuration: bundle, profile, user patch, runtime kept apart from deploy-time patches", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/user/develop/basic/config.md", source_type: SRC_OFFICIAL, layer: LAYER_1, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "Measured with --dump-config: a flat-key patch on an existing row changes only that key (provider and model), while a patch of providers REPLACES the whole map (24 lines vanished) and must restate apiKeyEnv, a name only. Rows 1, 4b and 5b rerun with the routing layer stay correct. Rule: layer 2 carries flat routing keys only and never restates providers.", expected_benefit: "a lane changes the model with one small patch and cannot lose the provider rows", measured_benefit: "dump diff: flat patch 2 changed keys, providers patch 24 lines removed (diff of --dump-config outputs)", saving_measured: false, implementation: "layer 1 is the Phase 0 overlay, layer 2 a routing-only patch, both repeatable --patch flags", risk: "restating providers silently drops the local model row", test_cmd: "--dump-config before and after each layer, then the three task rows" };
    }
    if (k == 7) {
        return Practice { id: 7, practice: "pinned dsh version, model id, prompt SHA and tool version", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/cli-help.md", source_type: SRC_OFFICIAL, layer: LAYER_5, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "dsh records none of version, prompt SHA or tool version in the log (0 hits), so the receipts derive them: the clone commit and tag, the requested model id from request/header, and the prompt SHA from the system/message text. The prompt SHA was stable in 7 of 7 runs per model name.", expected_benefit: "a number can be tied to the exact version, model and prompt that produced it", measured_benefit: "prompt SHA 49193094cc5e in 4 of 4 runs (glm-5.3-flash), 0fa5ab930ff6 in 3 of 3 (glm-4.5-flash)", saving_measured: false, implementation: "every receipt row names the pin, the requested and served model and the prompt SHA", risk: "the SHA covers the system text only, not the tool schemas", test_cmd: "grep the system/message text then shasum -a 256, on each log" };
    }
    if (k == 8) {
        return Practice { id: 8, practice: "prompts as versioned code with owner, changelog and review", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/subsystems/system-prompt.md", source_type: SRC_OFFICIAL, layer: LAYER_2, applicable: true, baseline: B_UNTESTED, has_evidence: true, fork_free: true, status: S_DEFERRED, reason: "The dsh system prompt is built per model (two SHAs for two model names) and is not a file the T27 side owns, so owner, changelog and review have nothing to attach to at the pin. Only the SHA stability was measured; no run used an owner-reviewed prompt file.", expected_benefit: "a prompt change is a reviewed change with a recorded cause", measured_benefit: NOT_MEASURED, saving_measured: false, implementation: "none yet: needs a prompt file the T27 side owns that a patch can point to", risk: "an unreviewed prompt change moves every result", test_cmd: "SHA stability only (see practice 7)" };
    }
    if (k == 9) {
        return Practice { id: 9, practice: "a fast eval gate per tick and a slower deep eval nightly or before a release", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/BENCHMARK.md", source_type: SRC_OFFICIAL, layer: LAYER_5, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "Two tiers were timed on this machine: the fast gate (the merged config dump and the spec check) and the deep gate (the three task rows rerun). The rows are not cheap enough to run every tick, the check is.", expected_benefit: "a tick finds a broken config in seconds and only a release pays for the deep rerun", measured_benefit: "fast gate 0.41 s config dump plus 0.02 s spec check (3 runs of t27c check, 0.016 to 0.017 s), deep gate 106 s (18 + 60 + 28 s, layered rows 5b, 4b, 1)", saving_measured: true, implementation: "per tick: dsh --dump-config and t27c check; before a release: the three task rows with the receipts of the md", risk: "the fast gate cannot see a wrong answer, only a broken file", test_cmd: "time of --dump-config and of t27c check, wall time of the three layered rows" };
    }
    if (k == 10) {
        return Practice { id: 10, practice: "failure-trace review instead of aggregate scores alone", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/postmortem/README.md", source_type: SRC_OFFICIAL, layer: LAYER_2, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "Two of the 7 new runs exit 0 with a bad outcome that only the trace shows: the 4b control stopped after one sentence with no tool call, and the 4b layered run called all 27 MCP tools including 7 Telegram tools (all errored) with no approval event. An exit-code or pass-rate gate passes both. In Phase 0 the exit code was 0 on 6 of 9 runs and the answer correct on 4 of 9.", expected_benefit: "a wrong or unsafe run is caught before its number is trusted", measured_benefit: "2 of 7 new runs exit 0 with a bad trace (grep -c tool/call by log, rc of each run)", saving_measured: false, implementation: "a lane report reads the trace of every failing or odd run before it reports a time", risk: "reading traces costs reviewer time and holds tool results", test_cmd: "event counts per log and the rc of each run" };
    }
    if (k == 11) {
        return Practice { id: 11, practice: "token, cost and latency accounting per agent step", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/subsystems/token-meter.md", source_type: SRC_OFFICIAL, layer: LAYER_1, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "Usage (input, output, cache read tokens) is on 16 of 16 assistant messages in the 7 new logs and every event has a time, so tokens and latency per step come from the log. Money cost is not measured: the ladder carries no price field.", expected_benefit: "the cost of a step is read, not guessed, and a budget policy can cut a run", measured_benefit: "usage on 16 of 16 assistant messages (grep -c inputTokens on assistant/message)", saving_measured: false, implementation: "the receipts table sums inputTokens and outputTokens per run; wall time is the run time including boot", risk: "inputTokens excludes cache reads, so two runs are compared only by the same rule", test_cmd: "grep -c on assistant/message with inputTokens, per log" };
    }
    if (k == 12) {
        return Practice { id: 12, practice: "model routing with explicit escalation", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/subsystems/subagent.md", source_type: SRC_OFFICIAL, layer: LAYER_1, applicable: true, baseline: B_KEPT, has_evidence: false, fork_free: true, status: S_DEFERRED, reason: "The routing layer works (practice 6) but there is nothing to measure: 4 of 4 runs that asked for glm-5.3-flash were served by glm-4.5-flash, so the cheap rung and the default are the same model and the spread between runs is run-to-run noise. Escalation after a failure was not exercised.", expected_benefit: "a cheap rung does the bounded steps and a stronger one is called only after a failure", measured_benefit: NOT_MEASURED, saving_measured: false, implementation: "the routing layer of practice 6, once the ladder serves two different models", risk: "an escalation rule that never fires costs nothing and proves nothing", test_cmd: "same task on two rungs with different served models (responseModel)" };
    }
    if (k == 13) {
        return Practice { id: 13, practice: "context compaction without loss of task-critical facts", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/subsystems/compaction.md", source_type: SRC_OFFICIAL, layer: LAYER_3, applicable: true, baseline: B_UNTESTED, has_evidence: true, fork_free: true, status: S_DEFERRED, reason: "With a 20000 token window compaction fired (8 starts, 6 summaries, 4 prunes of tool results) and the final answer was correct, but the summary lost the tool results and the model called both tools again: 4 calls for a 2 call task, 142 s. The declared window of the ladder is 1000000, so compaction would not fire before a provider overflow. The rows of Phase 0 were not rerun under a compaction policy.", expected_benefit: "a long lane keeps its goal and its facts after the window is cut", measured_benefit: "4 tool calls for 2 needed, 142 s, answer correct (compaction/prune and compaction/summary events)", saving_measured: false, implementation: "none yet: needs a summary check that task facts survive without a re-fetch", risk: "a lossy summary is repaired by extra tool calls, which costs time and tokens", test_cmd: "window layer with contextWindow 20000 and thresholdRatio 0.5 on a two-tool task" };
    }
    if (k == 14) {
        return Practice { id: 14, practice: "provider fallback with provenance", source: "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/subsystems/llm-streaming.md", source_type: SRC_OFFICIAL, layer: LAYER_4, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "Provenance is native: request/header holds the requested provider and model, and replayState.response.responseModel holds the served model only when it differs. 4 of 4 runs asking for glm-5.3-flash were served by glm-4.5-flash, and 10 of 10 Phase 0 sessions that asked for glm-5.3-flash were served by another model (glm-4.5-flash in 9, glm-4.7-flash in 1), so the model id in the request header is the requested one. The fallback itself is the ladder of the T27 side, dsh only retries per route; no fork change.", expected_benefit: "a receipt names the model that answered, not the one that was asked", measured_benefit: "served model differs from the requested one in 4 of 4 runs asking glm-5.3-flash, 0 of 3 asking glm-4.5-flash (grep responseModel)", saving_measured: false, implementation: "every receipt row carries requested and served model", risk: "responseModel is absent when the two are equal, so absence must be read as equal", test_cmd: "grep responseModel on each log, against request/header" };
    }
    if (k == 15) {
        return Practice { id: 15, practice: "a structured failure taxonomy (Model or Harness?, arXiv 2607.28802)", source: "https://arxiv.org/abs/2607.28802", source_type: SRC_COMMUNITY, layer: LAYER_2, applicable: true, baseline: B_KEPT, has_evidence: true, fork_free: true, status: S_ADOPTED, reason: "The Phase 0 failure table classifies 12 of 12 rows by fault side (model, harness, environment, benchmark). One row (F12, a model request with no event until the kill) could not be told apart as provider or harness from the events available, so the taxonomy needs a fifth value, undetermined. The 41 modes of the paper are deferred, none was tested.", expected_benefit: "a failure is sent to the layer that can fix it", measured_benefit: "12 of 12 Phase 0 failure rows carry a fault side, 1 undetermined (rows F1 to F12 of the Phase 0 report)", saving_measured: false, implementation: "lane reports use four fault sides and undetermined; the 41 modes are not adopted", risk: "a coarse side can hide that a harness fault made a model look wrong", test_cmd: "the Phase 0 failure rows classified one by one" };
    }
    return probe(false, B_UNTESTED, false, false);
}

// --- counting ------------------------------------------------------------------------------------

/// How many of the 15 records carry the recorded status s.
pub fn count_status(s: u8) -> u8 {
    var n : u8 = 0;
    var k : u8 = 1;
    while (k <= PRACTICES) {
        if (practice(k).status == s) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

/// How many of the 15 records have a gate verdict equal to the recorded status.
pub fn agreeing() -> u8 {
    var n : u8 = 0;
    var k : u8 = 1;
    while (k <= PRACTICES) {
        const p = practice(k);
        if (verdict(p) == p.status) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

// --- tests ---------------------------------------------------------------------------------------

test the_gate_decides_from_the_four_conditions {
    assert verdict(probe(true, B_KEPT, true, true)) == S_ADOPTED;
    assert adopted(probe(true, B_KEPT, true, true));
    assert gates_passed(probe(true, B_KEPT, true, true)) == 4;
    assert verdict(probe(false, B_KEPT, true, true)) == S_REJECTED;
    assert verdict(probe(true, B_BROKEN, true, true)) == S_REJECTED;
    assert verdict(probe(true, B_KEPT, true, false)) == S_REJECTED;
    assert verdict(probe(true, B_UNTESTED, true, true)) == S_DEFERRED;
    assert verdict(probe(true, B_KEPT, false, true)) == S_DEFERRED;
    assert adopted(probe(false, B_KEPT, true, true)) == false;
    assert adopted(probe(true, B_UNTESTED, true, true)) == false;
    assert adopted(probe(true, B_BROKEN, true, true)) == false;
    assert adopted(probe(true, B_KEPT, false, true)) == false;
    assert adopted(probe(true, B_KEPT, true, false)) == false;
    assert gates_passed(probe(false, B_UNTESTED, false, false)) == 0;
    assert gates_passed(probe(false, B_UNTESTED, false, true)) == 1;
    assert gates_passed(probe(true, B_KEPT, false, true)) == 3;
}

test an_unapplicable_practice_is_rejected_whatever_else_holds {
    assert verdict(probe(false, B_KEPT, true, true)) == S_REJECTED;
    assert verdict(probe(false, B_UNTESTED, false, true)) == S_REJECTED;
    assert verdict(probe(false, B_BROKEN, true, true)) == S_REJECTED;
}

test fifteen_records_none_skipped_each_with_its_fields {
    var k : u8 = 1;
    while (k <= PRACTICES) {
        const p = practice(k);
        assert p.id == k;
        assert p.practice.len > 0;
        assert p.source.len > 0;
        assert p.reason.len > 0;
        assert p.expected_benefit.len > 0;
        assert p.measured_benefit.len > 0;
        assert p.implementation.len > 0;
        assert p.risk.len > 0;
        assert p.test_cmd.len > 0;
        assert p.layer <= LAYER_CROSS;
        assert p.source_type <= SRC_BLOG;
        assert span_is(p.source, 0, 8, "https://");
        k = k + 1;
    }
    assert practice(0).id == 0;
    assert practice(16).id == 0;
}

test recorded_status_is_the_gate_verdict {
    var k : u8 = 1;
    while (k <= PRACTICES) {
        const p = practice(k);
        assert verdict(p) == p.status;
        assert (p.status == S_ADOPTED) == adopted(p);
        assert p.status != S_NEEDS_TEST;
        k = k + 1;
    }
    assert agreeing() == PRACTICES;
}

test the_counts_are_nine_adopted_two_rejected_four_deferred {
    assert count_status(S_ADOPTED) == 9;
    assert count_status(S_REJECTED) == 2;
    assert count_status(S_DEFERRED) == 4;
    assert count_status(S_NEEDS_TEST) == 0;
    assert count_status(S_ADOPTED) + count_status(S_REJECTED) + count_status(S_DEFERRED) == PRACTICES;
}

test an_adopted_record_passes_all_four_conditions_and_names_its_saving_chain {
    var k : u8 = 1;
    while (k <= PRACTICES) {
        const p = practice(k);
        if (p.status == S_ADOPTED) {
            assert gates_passed(p) == 4;
            assert p.implementation.len > 0;
            assert p.baseline == B_KEPT;
        }
        k = k + 1;
    }
}

test the_saving_chain_is_named_or_not_measured {
    var k : u8 = 1;
    while (k <= PRACTICES) {
        const p = practice(k);
        if (p.saving_measured == false) {
            assert p.status != S_ADOPTED or p.measured_benefit.len > 0;
        }
        if (p.saving_measured) {
            assert p.measured_benefit.len > 0;
            assert span_is(p.measured_benefit, 0, 12, NOT_MEASURED) == false;
        }
        if (span_is(p.measured_benefit, 0, 12, NOT_MEASURED)) {
            assert p.saving_measured == false;
        }
        k = k + 1;
    }
    assert NOT_MEASURED.len == 12;
}

test the_practices_that_touch_permissions_or_tools_are_not_adopted {
    assert practice(1).status != S_ADOPTED;
    assert practice(2).status != S_ADOPTED;
    assert practice(5).status != S_ADOPTED;
    assert practice(2).layer == LAYER_0;
}

test the_layer_map_covers_every_layer_and_the_cross_cutting_set {
    var seen : [7]u8 = [0] ** 7;
    var k : u8 = 1;
    while (k <= PRACTICES) {
        seen[practice(k).layer as usize] = 1;
        k = k + 1;
    }
    assert seen[0] == 1;
    assert seen[1] == 1;
    assert seen[2] == 1;
    assert seen[3] == 1;
    assert seen[4] == 1;
    assert seen[5] == 1;
    assert seen[6] == 1;
}

test the_pin_and_the_sandbox_of_every_run_are_recorded {
    assert DSH_PIN.len > 0;
    assert span_is(DSH_PIN, 0, 4, "dsh-");
    assert span_is(SANDBOX_MODE, 0, 9, "read-only");
    assert MACHINE.len > 0;
    assert span_is(RUN_DATE, 0, 4, "2026");
}
