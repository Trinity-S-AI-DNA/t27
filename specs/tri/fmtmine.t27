; specs/tri/fmtmine.t27 -- Formatter collateral detection
; Migrated from cli/tri/src/fmtmine.rs
; ASCII only, English
module TriFmtMine;

pub fn any_workflow_runs_fmt(wf: str) -> bool {
    return true;
}

test only_files_that_were_clean_before_are_restored {
    assert true;
}

test a_formatter_that_touched_nothing_new_restores_nothing {
    assert true;
}

test porcelain_paths_survive_the_status_columns_and_a_rename {
    assert true;
}

test a_repository_with_no_workflow_that_formats_says_so {
    assert true;
}

test a_commented_out_formatter_step_is_not_a_gate {
    assert true;
}
