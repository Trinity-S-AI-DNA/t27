// specs/tri/experience_capture.t27 -- Experience capture: layout and PR gate
// skills.
// Part of M1 (milestone #5). Closes #13191.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::experience_capture;

pub const EXPERIENCE_CAPTURE_MAX : u32 = 32;

pub struct ExperienceCapture { layout_skill: bool, pr_gate_skill: bool };

pub fn experience_capture_complete(e: ExperienceCapture) -> bool {
    return e.layout_skill && e.pr_gate_skill;
}

test "experience capture complete" {
    assert(experience_capture_complete(ExperienceCapture { layout_skill: true, pr_gate_skill: true }));
    assert(!experience_capture_complete(ExperienceCapture { layout_skill: true, pr_gate_skill: false }));
}

invariant experience_capture_max_positive {
    assert EXPERIENCE_CAPTURE_MAX > 0;
}