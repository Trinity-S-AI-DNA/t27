// SPDX-License-Identifier: Apache-2.0
; specs/tri/fmt_source.t27 -- `t27c fmt`, lossless. Issue #10365 (the formatter half of the TRI CLAW
; suggestion review, specs/claw/suggest.t27, #10286).
; Owner order 2026-10-18: make `t27c fmt` comment-preserving and exact; today it drops every `;`
; comment and rewrites `i += 1` as `i = 1`, so a suggestion built from it would propose deleting the
; comments of a spec.
; --
; Why not a better AST printer. The old printer rebuilt the file from the parse tree, and the tree
; keeps no comments and no compound assignment. Fixing that means teaching the parser to carry both
; and the printer to place them: a large change, and each gap loses text silently. This file takes the
; other road: it never rebuilds anything. It normalises the WHITESPACE of the source and copies every
; other byte through unchanged, so a comment, an operator, a literal and a string cannot be lost
; because nothing here looks at them.
; --
; The four rules, each pinned by a test:
; 1. A leading tab on a line becomes four spaces (a space stays a space).
; 2. Trailing spaces, tabs and carriage returns are dropped from every line.
; 3. Blank lines at the end of the file are dropped, and the last line ends with exactly one newline.
; 4. Everything else, including blank lines inside the file, comment lines and the text of a line after
;    its indent, is copied byte for byte.
; Line k of the output is line k of the input for every line the output has: nothing is merged or
; split, so a driver can compare the two files line by line (specs/claw/suggest_feed.t27 does).
; --
; The exactness check. fmt_exact compares the NON-whitespace bytes of the source and of the output,
; in order. The formatter is correct only when that stream is identical; `t27c fmt` prints nothing and
; fails when it is not, so a bug here can refuse to format but cannot damage a file.
; The honest limit: this is a whitespace normaliser, not a style engine. It does not re-indent by brace
; depth, wrap long lines or reorder anything; a spec that is badly indented but has no tabs and no
; trailing space is already "formatted" by these rules.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module TriFmtSource;

/// Spaces a leading tab expands to.
pub const TAB_WIDTH : usize = 4;

fn put_byte(dst : []u8, cap : usize, w : usize, b : u8) -> usize {
    if (w < cap) { dst[w] = b; }
    return w + 1;
}

/// A byte the formatter may add, drop or move: space, tab, newline, carriage return.
pub fn is_space(b : u8) -> bool {
    return b == ' ' or b == '\t' or b == '\n' or b == 13;
}

/// End of the line that starts at s: the index of its newline, or n when it has none.
fn line_stop(src : []const u8, n : usize, s : usize) -> usize {
    var i : usize = s;
    while (i < n) {
        if (src[i] == '\n') { return i; }
        i += 1;
    }
    return n;
}

/// End of src[s..e) after its trailing spaces, tabs and carriage returns are dropped.
fn trim_end(src : []const u8, s : usize, e : usize) -> usize {
    var x : usize = e;
    while (x > s) {
        const b : u8 = src[x - 1];
        if (b != ' ' and b != '\t' and b != 13) { return x; }
        x -= 1;
    }
    return x;
}

/// Normalise src[0..n) into out[0..cap). Returns the bytes the output needs; when that exceeds
/// cap the buffer holds a clipped result the caller must not use.
pub fn fmt_source(src : []const u8, n : usize, out : []u8, cap : usize) -> usize {
    var w : usize = 0;
    var pending : usize = 0;
    var ls : usize = 0;
    while (ls < n) {
        const le : usize = line_stop(src, n, ls);
        const ee : usize = trim_end(src, ls, le);
        if (ee == ls) {
            pending += 1;
        } else {
            while (pending > 0) {
                w = put_byte(out, cap, w, '\n');
                pending -= 1;
            }
            var i : usize = ls;
            while (i < ee and (src[i] == ' ' or src[i] == '\t')) {
                if (src[i] == '\t') {
                    w = put_byte(out, cap, w, ' ');
                    w = put_byte(out, cap, w, ' ');
                    w = put_byte(out, cap, w, ' ');
                    w = put_byte(out, cap, w, ' ');
                } else {
                    w = put_byte(out, cap, w, ' ');
                }
                i += 1;
            }
            while (i < ee) {
                w = put_byte(out, cap, w, src[i]);
                i += 1;
            }
            w = put_byte(out, cap, w, '\n');
        }
        ls = le + 1;
    }
    return w;
}

/// Index of the next byte at or after p that is not whitespace; n when there is none.
fn next_solid(t : []const u8, n : usize, p : usize) -> usize {
    var i : usize = p;
    while (i < n) {
        if (is_space(t[i]) == false) { return i; }
        i += 1;
    }
    return n;
}

/// Whether a[0..an) and b[0..bn) hold the same non-whitespace bytes in the same order.
pub fn fmt_exact(a : []const u8, an : usize, b : []const u8, bn : usize) -> bool {
    var i : usize = next_solid(a, an, 0);
    var j : usize = next_solid(b, bn, 0);
    while (i < an and j < bn) {
        if (a[i] != b[j]) { return false; }
        i = next_solid(a, an, i + 1);
        j = next_solid(b, bn, j + 1);
    }
    return i >= an and j >= bn;
}

/// Whether the formatted text fits cap and keeps every non-whitespace byte: the only case in which
/// `t27c fmt` may print it.
pub fn fmt_accept(src : []const u8, n : usize, out : []const u8, m : usize, cap : usize) -> bool {
    if (m > cap) { return false; }
    return fmt_exact(src, n, out, m);
}

test a_comment_survives {
    var out : [128]u8 = undefined;
    const src : str = "; keep me\nfn f() {\n    ; and me\n    x = 1;\n}\n";
    const m : usize = fmt_source(src, src.len, &out, 128);
    assert m == src.len;
    for i in 0..m { assert out[i] == src[i]; }
}

test a_compound_assignment_survives {
    var out : [64]u8 = undefined;
    const src : str = "    i += 1;\n    j -= 2;\n    k *= 3;\n";
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert m == src.len;
    for i in 0..m { assert out[i] == src[i]; }
}

test a_leading_tab_becomes_four_spaces {
    var out : [64]u8 = undefined;
    const src : str = "\tx = 1;\n\t\ty = 2;\n";
    const want : str = "    x = 1;\n        y = 2;\n";
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert m == want.len;
    for i in 0..m { assert out[i] == want[i]; }
}

test a_tab_after_the_indent_is_kept {
    var out : [64]u8 = undefined;
    const src : str = "  a\tb;\n";
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert m == src.len;
    for i in 0..m { assert out[i] == src[i]; }
}

test trailing_space_and_tab_are_dropped {
    var out : [64]u8 = undefined;
    const src : str = "a = 1;  \nb = 2;\t\nc = 3;\n";
    const want : str = "a = 1;\nb = 2;\nc = 3;\n";
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert m == want.len;
    for i in 0..m { assert out[i] == want[i]; }
}

test a_carriage_return_before_the_newline_is_dropped {
    // "a;" CR LF "b;" CR LF, built byte by byte: the CR is byte 13.
    var src : [8]u8 = undefined;
    src[0] = 'a'; src[1] = ';'; src[2] = 13; src[3] = '\n';
    src[4] = 'b'; src[5] = ';'; src[6] = 13; src[7] = '\n';
    var out : [16]u8 = undefined;
    const m : usize = fmt_source(&src, 8, &out, 16);
    assert m == 6;
    assert out[0] == 'a';
    assert out[1] == ';';
    assert out[2] == '\n';
    assert out[3] == 'b';
    assert out[4] == ';';
    assert out[5] == '\n';
}

test a_missing_final_newline_is_added {
    var out : [64]u8 = undefined;
    const src : str = "a = 1;\nb = 2;";
    const want : str = "a = 1;\nb = 2;\n";
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert m == want.len;
    for i in 0..m { assert out[i] == want[i]; }
}

test blank_lines_at_the_end_are_dropped_and_inner_ones_kept {
    var out : [64]u8 = undefined;
    const src : str = "a;\n\n\nb;\n  \n\n";
    const want : str = "a;\n\n\nb;\n";
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert m == want.len;
    for i in 0..m { assert out[i] == want[i]; }
}

test blank_lines_at_the_start_are_kept {
    var out : [64]u8 = undefined;
    const src : str = "\n\na;\n";
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert m == src.len;
    for i in 0..m { assert out[i] == src[i]; }
}

test an_empty_or_blank_file_formats_to_nothing {
    var out : [16]u8 = undefined;
    assert fmt_source("", 0, &out, 16) == 0;
    assert fmt_source("  \n\t\n\n", 5, &out, 16) == 0;
}

test formatting_twice_changes_nothing {
    var a : [128]u8 = undefined;
    var b : [128]u8 = undefined;
    const src : str = "\tfn f() {  \n\t\t; c  \n\n\n\t\tx += 1;\t\n\t}\n\n";
    const m : usize = fmt_source(src, src.len, &a, 128);
    const k : usize = fmt_source(&a, m, &b, 128);
    assert k == m;
    for i in 0..m { assert a[i] == b[i]; }
}

test an_overflowing_result_reports_the_bytes_it_needs {
    var out : [4]u8 = undefined;
    const src : str = "\t\tabcdef\n";
    const m : usize = fmt_source(src, src.len, &out, 4);
    assert m == 15;
    assert fmt_accept(src, src.len, &out, m, 4) == false;
}

test exactness_ignores_only_whitespace {
    assert fmt_exact("a  b\n", 5, "a b", 3) == true;
    assert fmt_exact("a b", 3, "ab", 2) == true;
    assert fmt_exact("a b", 3, "a c", 3) == false;
    assert fmt_exact("a b", 3, "a", 1) == false;
    assert fmt_exact("a", 1, "a b", 3) == false;
    assert fmt_exact("; x\n", 4, "x\n", 2) == false;
    assert fmt_exact("i += 1", 6, "i = 1", 5) == false;
    assert fmt_exact("", 0, "  \n", 3) == true;
}

test a_dropped_comment_is_refused {
    var out : [64]u8 = undefined;
    const src : str = "; note\nx = 1;\n";
    const lossy : str = "x = 1;\n";
    assert fmt_accept(src, src.len, lossy, lossy.len, 64) == false;
    const m : usize = fmt_source(src, src.len, &out, 64);
    assert fmt_accept(src, src.len, &out, m, 64) == true;
}

test the_output_of_every_sample_is_exact {
    var out : [256]u8 = undefined;
    var samples : [4]str = ["\ta;  \n\n\n", "; c\n\tb += 1; ; trailing\n", "x \ny\t\n", "no newline"];
    for i in 0..4 {
        const m : usize = fmt_source(samples[i], samples[i].len, &out, 256);
        assert fmt_accept(samples[i], samples[i].len, &out, m, 256) == true;
    }
}
