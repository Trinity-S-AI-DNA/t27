// SPDX-License-Identifier: Apache-2.0
// specs/tri/loop/gen_c_builtins_probe.t27
// Regression probe for the gen-c lowering defects filed under #5980 and fixed
// 2026-11-03 (lane laneA, Pareto option 2). Three classes bit the r4 pilot
// (specs/igla/coder/pilot_train_step.t27, evidence
// /Users/playra/igla-coder-gpu/r4_fresh_process/RECEIPT.md):
//   1. `.len` on a slice reached C verbatim; this probe holds the FIXED half
//      of that class -- a `.len` on a name whose declared type carries the
//      length (param `[N]T`, local `[N]T`), which lowers to that compile-time
//      length. The UNSIZED `[]T` half stays open (#3464): its ABI is a bare
//      pointer and this rule must not invent a length that is not there.
//   2. Zig-spelled builtins passed through verbatim: @abs, @floatFromInt,
//      @intFromFloat, @mod, @divTrunc, @bitCast -- each has one arm now.
//   3. An identifier named after a C keyword (`short`) was emitted
//      unmangled and clang answered "expected identifier".
// BEFORE the fix, `t27c gen-c` on this file emitted `@abs(x)` verbatim and
// `uint8_t short[3]`; after it, `t27_abs(x)` and `uint8_t t27_short[3]`.
// The checks run under t27b too, so the SAME text pins the semantics on both
// backends: @mod floors (sign of the divisor), @divTrunc truncates toward
// zero, @intFromFloat truncates toward zero, @bitCast is bit-identical.

pub const N : usize = 4;

/// A module-level const fixture array (the pilot's X_IN16 pattern).
const FIXTURE : [N]f64 = [0.25, -0.5, 0.75, -1.0];

/// @abs on an array element, @floatFromInt on its index (both spellings the
/// pilot uses under @as).
fn probe_abs_scaled(x: [N]f64) -> f64 {
    var i: usize = 0;
    var s: f64 = 0.0;
    while (i < x.len) {
        s = s + @abs(x[i]) * @as(f64, @floatFromInt(i));
        i = i + 1;
    }
    return s;
}

/// @intFromFloat truncates toward zero (the quantize path of the pilot).
fn probe_trunc(x: f64) -> i64 {
    var r: i64 = @intFromFloat(x);
    return r;
}

/// @mod floors: the result takes the DIVISOR's sign (@mod(-3, 2) == 1),
/// unlike C's % which truncates (@mod must not lower to plain %).
fn probe_mod(a: i64) -> i64 {
    return @mod(a, 2);
}

/// @divTrunc truncates toward zero: @divTrunc(-3, 2) == -1, C's own / for
/// integers.
fn probe_div(a: i64) -> i64 {
    return @divTrunc(a, 2);
}

/// @bitCast f64 <-> u64, both directions (the checkpoint checksum path).
fn probe_bits(x: f64) -> u64 {
    return @bitCast(x);
}

fn probe_unbits(b: u64) -> f64 {
    return @bitCast(b);
}

/// A SIZED-array param: the length is part of the type, so `.len` has the
/// type's own compile-time answer (class 1, ABI-carrying half).
fn probe_len_param(x: [N]f64) -> usize {
    var i: usize = 0;
    var c: usize = 0;
    while (i < x.len) { c = c + 1; i = i + 1; }
    return c;
}

/// A module CONST array passed INTO a sized param (the pilot forward calls
/// pass fixture consts like &X_IN16), and read-only use inside.
fn probe_const_param(x: [N]f64) -> f64 {
    return x[0];
}

/// The length of a sized array, measured the way every loop in the pilot
/// measures it -- and the keyword-named local of class 3 beside it.
fn probe_len_and_short() -> usize {
    var short: [3]u8 = undefined;
    short[0] = 7;
    var buf: [N]f64 = undefined;
    buf[0] = 1.0;
    var i: usize = 0;
    var c: usize = 0;
    while (i < buf.len) { c = c + 1; i = i + 1; }
    c = c + short.len;
    return c;
}

test probe_builtins_hold {
    var x: [N]f64 = undefined;
    x[0] = 1.0; x[1] = -2.0; x[2] = 3.0; x[3] = -4.0;
    // |1|*0 + |2|*1 + |3|*2 + |4|*3
    assert probe_abs_scaled(x) == 20.0;
    assert probe_trunc(-2.75) == -2;
    assert probe_mod(-3) == 1;
    assert probe_mod(4) == 0;
    assert probe_div(-3) == -1;
    assert probe_div(7) == 3;
    assert probe_bits(1.0) == 0x3FF0000000000000;
    assert probe_unbits(0x3FF0000000000000) == 1.0;
    assert probe_len_and_short() == 7;
    assert probe_len_param(x) == 4;
    assert probe_const_param(x) == 1.0;
    assert probe_const_param(FIXTURE) == 0.25;
    assert N == 4;
}
