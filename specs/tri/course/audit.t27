// SPDX-License-Identifier: Apache-2.0
// specs/tri/course/audit.t27 -- the law of `tri course audit`: a lesson may not state a
// bench fact that the bench board's spec contradicts.
//
// WHY. The t27.ai FPGA course (gHashTag/trinity apps/website/specs/course/course.t27,
// audited at trinity origin/main ca7ec465e5) drifted from fpga/HARDWARE_SSOT.md:
//   lesson 1  "Our bench chip is an AMD Artix-7 XC7A200T" and the task "find LUT_TOTAL":
//             true die, but the board is not named, and LUT_TOTAL in wukong_v1.t27 is the
//             logic-cell figure (215,360), not a LUT count (134,600; specs/boards/ax7203.t27).
//   lesson 3  "the XC7A200T on our board has 676 solder balls": the bench AX7203 carries the
//             FBG484, 484 balls. 676 is the Wukong's FGG676, which the pin-map widget draws.
// Nothing in the course build caught it: the generator checks that every lesson compiles
// and that every widget is used once, not that a sentence is true of the bench.
//
// THE CHECK. A drift rule is a pair (trigger, required). When a lesson string contains the
// trigger, it must also contain the required words, which name the context that makes the
// trigger true. Each rule below is one drift that happened, so the rule set grows only from
// evidence. A rule never edits a lesson; it names it.
//
// VERDICT, as exit codes: 0 every lesson passes every rule; 1 at least one violation, each
// printed as "<lesson> <rule id> <trigger>"; 2 the course spec could not be read or parsed,
// so nothing was checked (never a pass).
//
// GLUE: deferred. `tri course audit <course.t27>` needs a host reader for the LESSON_TEXTS
// and LESSON_TASKS arrays; the tri CLI is Rust and changing it needs the owner's
// owner-approved-foreign label. Until then this module is run by its own tests, which hold
// the audited strings verbatim.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module tri_course_audit;

pub const EXIT_PASS : u8 = 0;
pub const EXIT_DRIFT : u8 = 1;
pub const EXIT_UNREAD : u8 = 2;

pub const RULE_COUNT : u32 = 3;
pub const RULE_IDS : [3]str = ["board-named", "lut-is-not-cell", "package-named"];
pub const RULE_TRIGGERS : [3]str = ["bench chip", "LUT_TOTAL", "676"];
pub const RULE_REQUIRED : [3]str = ["AX7203", "logic cell", "FGG676"];

// Does `hay` contain `needle`? An empty needle is contained everywhere.
pub fn contains(hay: str, needle: str) -> bool {
    var found : bool = false;
    if needle.len == 0 {
        found = true;
    }
    var i : u32 = 0;
    while !found and i + needle.len <= hay.len {
        var m : u32 = 0;
        var ok : bool = true;
        while ok and m < needle.len {
            if hay[i + m] != needle[m] {
                ok = false;
            }
            m = m + 1;
        }
        if ok {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

// One rule on one lesson string: holds when the trigger is absent or the context is present.
pub fn rule_holds(text: str, trigger: str, required: str) -> bool {
    return !contains(text, trigger) or contains(text, required);
}

// How many of the rules a lesson string breaks.
pub fn violations(text: str) -> u32 {
    var n : u32 = 0;
    var r : u32 = 0;
    while r < RULE_COUNT {
        if !rule_holds(text, RULE_TRIGGERS[r], RULE_REQUIRED[r]) {
            n = n + 1;
        }
        r = r + 1;
    }
    return n;
}

// The exit code for a whole course: `readable` is false when the host could not parse it.
pub fn verdict(total_violations: u32, readable: bool) -> u8 {
    var v : u8 = EXIT_PASS;
    if !readable {
        v = EXIT_UNREAD;
    } else if total_violations > 0 {
        v = EXIT_DRIFT;
    }
    return v;
}

test contains_finds_and_misses {
    assert contains("xc7a200tfbg484-2", "fbg484");
    assert contains("abc", "");
    assert !contains("ab", "abc");
    assert !contains("FBG484", "fbg484");
}

test the_audited_lesson_1_text_is_drift {
    assert violations("Configuring the grid builds a circuit. Our bench chip is an AMD Artix-7 XC7A200T. The skyline draws one routed design on that die.") == 1;
}

test the_audited_lesson_1_task_is_drift {
    assert violations("In the spec frame of our bench board, find LUT_TOTAL, then the invariant on DSP48E1_TOTAL") == 1;
}

test the_audited_lesson_3_text_is_drift {
    assert violations("A chip sits in a package: the XC7A200T on our board has 676 solder balls under it.") == 1;
}

test the_corrected_wording_passes {
    assert violations("Our bench chip is an AMD Artix-7 XC7A200T on an ALINX AX7203 board, in the 484-ball FBG484 package.") == 0;
    assert violations("Find LUT6_TOTAL, then LOGIC_CELLS: AMD counts a logic cell as 1.6 LUT6, so the two differ.") == 0;
    assert violations("The map draws the same die in the 676-ball FGG676 package of the Wukong board; ours is the 484-ball FBG484.") == 0;
}

test a_lesson_without_a_trigger_is_untouched {
    assert violations("Type 1.618 and read the exponent and mantissa bits; then type 0.1 and look at the error.") == 0;
}

test the_verdict_never_passes_an_unread_course {
    assert verdict(0, true) == EXIT_PASS;
    assert verdict(3, true) == EXIT_DRIFT;
    // Negative control: zero violations of an unread course is not a pass.
    assert verdict(0, false) == EXIT_UNREAD;
    assert verdict(5, false) == EXIT_UNREAD;
}

test every_rule_has_an_id_a_trigger_and_a_context {
    var r : u32 = 0;
    while r < RULE_COUNT {
        assert RULE_IDS[r].len > 0;
        assert RULE_TRIGGERS[r].len > 0;
        assert RULE_REQUIRED[r].len > 0;
        assert !contains(RULE_TRIGGERS[r], RULE_REQUIRED[r]);
        r = r + 1;
    }
}
