// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Free graph memory | φ² + 1/φ² = 3 | TRINITY

module TriGraphBfs;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Fixed-capacity storage: at most 16 vertices with at most 16 neighbours each. The
    // backend has no allocation, so rows live in module-level buffers and Graph.adj is a
    // slice of row slices over them. Only one graph is live at a time: init resets them.
    pub const Graph = struct {
        adj : [][]usize,
        allocator : std.mem.Allocator,
    };

    // order lists the vertices in the order they were visited; distance[v] is the number of
    // edges from the start to v, or maxInt(usize) when v was not reached. Both slices stay
    // valid until the next traverse call.
    pub const BFSResult = struct {
        order : []usize,
        distance : []usize,
        allocator : std.mem.Allocator,
    };

    var adj_storage : [256]usize = undefined;
    var rows_buffer : [16][]usize = undefined;
    var order_buffer : [16]usize = undefined;
    var distance_buffer : [16]usize = undefined;
    var visited_buffer : [16]bool = undefined;
    var queue_buffer : [16]usize = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(allocator: std.mem.Allocator, vertex_count: usize) -> Graph
    // Every vertex starts with an empty row.
    fn init(allocator: std.mem.Allocator, vertex_count: usize) -> Graph {
        var i: usize = 0;
        while (i < vertex_count) {
            rows_buffer[i] = adj_storage[i * 16 .. i * 16];
            i = i + 1;
        }
        return Graph {
            .adj = rows_buffer[0..vertex_count],
            .allocator = allocator,
        };
    }

    // add_row_entry(graph, vertex, neighbor): append neighbor to the row of vertex
    fn add_row_entry(graph: *Graph, vertex: usize, neighbor: usize) -> void {
        var len = graph.adj[vertex].len;
        if (len < 16) {
            adj_storage[vertex * 16 + len] = neighbor;
            graph.adj[vertex] = adj_storage[vertex * 16 .. vertex * 16 + len + 1];
        }
    }

    // add_edge(graph: *Graph, from: usize, to: usize) -> void : undirected edge
    fn add_edge(graph: *Graph, from: usize, to: usize) -> void {
        add_row_entry(graph, from, to);
        add_row_entry(graph, to, from);
    }

    // traverse(graph: *Graph, start: usize, allocator: std.mem.Allocator) -> BFSResult
    fn traverse(graph: *Graph, start: usize, allocator: std.mem.Allocator) -> BFSResult {
        var n = graph.adj.len;
        var i: usize = 0;
        while (i < n) {
            visited_buffer[i] = false;
            distance_buffer[i] = std.math.maxInt(usize);
            i = i + 1;
        }

        var head: usize = 0;
        var tail: usize = 0;
        visited_buffer[start] = true;
        distance_buffer[start] = 0;
        queue_buffer[tail] = start;
        tail = tail + 1;

        var index: usize = 0;
        while (head < tail) {
            var current = queue_buffer[head];
            head = head + 1;
            order_buffer[index] = current;
            index = index + 1;

            var k: usize = 0;
            while (k < graph.adj[current].len) {
                var neighbor = graph.adj[current][k];
                if (!visited_buffer[neighbor]) {
                    visited_buffer[neighbor] = true;
                    distance_buffer[neighbor] = distance_buffer[current] + 1;
                    queue_buffer[tail] = neighbor;
                    tail = tail + 1;
                }
                k = k + 1;
            }
        }

        return BFSResult {
            .order = order_buffer[0..index],
            .distance = distance_buffer[0..n],
            .allocator = allocator,
        };
    }

    // deinit(graph: *Graph) -> void
    // The rows are module-level storage, so there is nothing to free: the graph is emptied.
    fn deinit(graph: *Graph) -> void {
        graph.adj = rows_buffer[0..0];
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var g = init(std.testing.allocator, 4);
        assert(g.adj.len == 4);
        assert(g.adj[3].len == 0);
    }

    test add_edge_basic_case {
        var g = init(std.testing.allocator, 2);
        add_edge(&g, 0, 1);
        assert(g.adj[0].len == 1);
        assert(g.adj[0][0] == 1);
        assert(g.adj[1][0] == 0);
    }

    test traverse_basic_case {
        var g = init(std.testing.allocator, 2);
        add_edge(&g, 0, 1);
        var result = traverse(&g, 0, std.testing.allocator);
        assert(result.order.len == 2);
        assert(result.distance[1] == 1);
    }

    test deinit_basic_case {
        var g = init(std.testing.allocator, 2);
        deinit(&g);
        assert(g.adj.len == 0);
    }

    test adjacency_has_one_row_per_vertex {
        var g = init(std.testing.allocator, 3);
        assert(g.adj.len == 3);
    }

    test an_isolated_vertex_has_an_empty_row {
        var g = init(std.testing.allocator, 1);
        assert(g.adj[0].len == 0);
    }

    test an_undirected_edge_appears_in_both_endpoints_rows {
        var g = init(std.testing.allocator, 2);
        add_edge(&g, 0, 1);
        assert(g.adj[0].len == 1);
        assert(g.adj[1].len == 1);
    }

    test the_degree_sum_is_twice_the_edge_count {
        // Verify: the handshake lemma on the path 0 - 1 - 2 -- two edges, so the
        // row lengths add up to four
        var g = init(std.testing.allocator, 3);
        add_edge(&g, 0, 1);
        add_edge(&g, 1, 2);
        var degree_sum = g.adj[0].len + g.adj[1].len + g.adj[2].len;
        assert(degree_sum == 4);
    }

    test bfs_result_holds_one_distance_per_vertex_and_starts_at_zero {
        var g = init(std.testing.allocator, 3);
        add_edge(&g, 0, 1);
        add_edge(&g, 1, 2);
        var result = traverse(&g, 0, std.testing.allocator);
        assert(result.order.len == result.distance.len);
        assert(result.distance[0] == 0);
    }

    test bfs_distances_never_jump_by_more_than_one {
        var g = init(std.testing.allocator, 3);
        add_edge(&g, 0, 1);
        add_edge(&g, 1, 2);
        var result = traverse(&g, 0, std.testing.allocator);
        // The largest step between consecutively visited vertices
        var max_jump: usize = 0;
        var i: usize = 0;
        while (i + 1 < result.order.len) {
            var current_dist = result.distance[result.order[i]];
            var next_dist = result.distance[result.order[i + 1]];
            var jump = if (next_dist > current_dist) next_dist - current_dist else 0;
            if (jump > max_jump) {
                max_jump = jump;
            }
            i = i + 1;
        }
        assert(result.order.len == 3);
        assert(max_jump <= 1);
    }

    test init_creates_correct_graph_structure {
        var g = init(std.testing.allocator, 3);
        assert(g.adj.len == 3);
    }

    test add_edge_builds_path_correctly {
        var g = init(std.testing.allocator, 3);
        add_edge(&g, 0, 1);
        add_edge(&g, 1, 2);
        assert(g.adj[0].len == 1);
        assert(g.adj[1].len == 2);
        assert(g.adj[2].len == 1);
    }

    test traverse_produces_correct_order_and_distance {
        var g = init(std.testing.allocator, 3);
        add_edge(&g, 0, 1);
        add_edge(&g, 1, 2);
        var result = traverse(&g, 0, std.testing.allocator);
        assert(result.order.len == result.distance.len);
        assert(result.distance[0] == 0);
        assert(result.order[0] == 0);
        assert(result.order[1] == 1);
        assert(result.order[2] == 2);
        assert(result.distance[1] == 1);
        assert(result.distance[2] == 2);
    }

    test deinit_ownership_rule {
        // The graph owns its rows: after deinit it holds no vertices
        var g = init(std.testing.allocator, 2);
        add_edge(&g, 0, 1);
        assert(g.adj.len == 2);
        deinit(&g);
        assert(g.adj.len == 0);
    }
