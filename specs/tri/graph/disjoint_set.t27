// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Attach shorter tree under taller tree root | φ² + 1/φ² = 3 | TRINITY

module TriDisjointSet;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const DisjointSet = struct {
        parent : []usize,
        rank : []usize,
        count : usize,
    };

    // Module-level backing buffer for DisjointSet allocation
    var backing_parent : [1000]usize = undefined;
    var backing_rank : [1000]usize = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(size: usize) → DisjointSet
    fn init(size: usize) -> DisjointSet {
        // Initialize the singleton forest over size elements
        // parent[i] == i for every i, rank[i] == 0, count == size
        // Using module-level backing buffer to avoid allocator field
        var i : usize = 0;
        while (i < size) {
            backing_parent[i] = i;
            backing_rank[i] = 0;
            i = i + 1;
        }
        return DisjointSet{
            .parent = backing_parent[0..size],
            .rank = backing_rank[0..size],
            .count = size,
        };
    }

    // find(ds: *DisjointSet, x: usize) → usize
    fn find(ds: *DisjointSet, x: usize) -> usize {
        // Return the root of x with path compression
        var root = x;
        while (ds.parent[root] != root) {
            root = ds.parent[root];
        }
        
        // Path compression: make every node on the path point to root
        var current = x;
        while (ds.parent[current] != root) {
            var next = ds.parent[current];
            ds.parent[current] = root;
            current = next;
        }
        
        return root;
    }

    // union(ds: *DisjointSet, x: usize, y: usize) → void
    fn union(ds: *DisjointSet, x: usize, y: usize) -> void {
        // Find roots of both elements
        var root_x = find(ds, x);
        var root_y = find(ds, y);
        
        // If already in the same component, do nothing
        if (root_x == root_y) {
            return;
        }
        
        // Attach shorter tree under taller tree root
        if (ds.rank[root_x] < ds.rank[root_y]) {
            ds.parent[root_x] = root_y;
        } else if (ds.rank[root_x] > ds.rank[root_y]) {
            ds.parent[root_y] = root_x;
        } else {
            // Same rank: attach one to the other and increment the surviving rank
            ds.parent[root_y] = root_x;
            ds.rank[root_x] = ds.rank[root_x] + 1;
        }
        
        // Decrement count by exactly 1 on a real merge
        ds.count = ds.count - 1;
    }

    // connected(ds: *const DisjointSet, x: usize, y: usize) → bool
    fn connected(ds: *const DisjointSet, x: usize, y: usize) -> bool {
        // Return true when x and y share a root (read-only)
        var root_x = x;
        while (ds.parent[root_x] != root_x) {
            root_x = ds.parent[root_x];
        }
        
        var root_y = y;
        while (ds.parent[root_y] != root_y) {
            root_y = ds.parent[root_y];
        }
        
        return root_x == root_y;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case {
        var ds = init(3);
        assert(ds.count == 3);
        assert(ds.parent.len == 3);
        assert(ds.parent[2] == 2);
    }

    test find_basic_case {
        var ds = init(3);
        assert(find(&ds, 0) == 0);
        assert(find(&ds, 2) == 2);
    }

    test union_basic_case {
        var ds = init(3);
        union(&ds, 0, 1);
        assert(ds.count == 2);
        assert(find(&ds, 1) == find(&ds, 0));
        assert(find(&ds, 2) == 2);
    }

    test connected_basic_case {
        var ds = init(3);
        assert(connected(&ds, 0, 0));
        assert(!connected(&ds, 0, 1));
    }

    test parent_and_rank_are_parallel_arrays_over_the_same_elements {
        // One slot per element in each: index i is element i in both. No
        // allocator is stored, so init(size) borrows its backing memory.
        var ds = init(4);
        assert(ds.parent.len == 4);
        assert(ds.rank.len == ds.parent.len);
        assert(ds.parent[3] == 3);
        assert(ds.rank[3] == 0);
    }

    test one_union_drops_the_component_count_by_exactly_one {
        // Attaching element 1 under root 0 leaves three components, not four,
        // and the taller root's rank goes up while the absorbed one keeps its.
        var ds = init(4);
        union(&ds, 0, 1);
        assert(ds.parent[1] == 0);
        assert(ds.rank[0] == 1);
        assert(ds.count == ds.parent.len - 1);
        assert(ds.count >= 1);
    }

    test init_creates_singleton_forest {
        var ds = init(4);
        assert(ds.parent[0] == 0);
        assert(ds.parent[1] == 1);
        assert(ds.parent[2] == 2);
        assert(ds.parent[3] == 3);
        assert(ds.rank[0] == 0);
        assert(ds.rank[1] == 0);
        assert(ds.rank[2] == 0);
        assert(ds.rank[3] == 0);
        assert(ds.count == 4);
    }

    test find_with_path_compression {
        var ds = init(4);
        union(&ds, 0, 1);
        union(&ds, 1, 2);
        // Before compression: 0 <- 1 <- 2, 3 <- 3
        assert(find(&ds, 2) == 0);
        assert(ds.parent[2] == 0);
        assert(ds.parent[1] == 0);
    }

    test union_of_two_already_joined_elements_is_a_no_op {
        var ds = init(4);
        union(&ds, 0, 1);
        var before = ds.count;
        union(&ds, 0, 1);
        assert(ds.count == before);
    }

    test connected_returns_true_for_same_component {
        var ds = init(4);
        union(&ds, 0, 1);
        union(&ds, 2, 3);
        assert(connected(&ds, 0, 1) == true);
        assert(connected(&ds, 1, 0) == true);
        assert(connected(&ds, 2, 3) == true);
        assert(connected(&ds, 0, 2) == false);
        assert(connected(&ds, 1, 3) == false);
    }

    test connected_read_only_does_not_mutate {
        // Build 1 under 0 (rank 1), then query across components. The query
        // must leave every parent and rank exactly as it found it.
        var ds = init(4);
        union(&ds, 0, 1);
        var ignored = connected(&ds, 1, 2);
        assert(ds.parent[0] == 0);
        assert(ds.parent[1] == 0);
        assert(ds.parent[2] == 2);
        assert(ds.parent[3] == 3);
        assert(ds.rank[0] == 1);
        assert(ds.rank[1] == 0);
        assert(ds.rank[2] == 0);
        assert(ds.rank[3] == 0);
    }
