// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Find MST using Prim's algorithm | φ² + 1/φ² = 3 | TRINITY

module TriPrimsMst;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Edge type for graph edges with weights
    pub const Edge = struct {
        from : usize,
        to : usize,
        weight : i64,
    };

    // Undirected weighted graph as a row-major adjacency matrix: weights[a * node_count + b]
    // holds the weight of the edge between a and b, or a negative number when there is none.
    // At most 16 nodes.
    pub const Graph = struct {
        node_count : usize,
        weights : []i64,
    };

    // The tree Prim's algorithm grew from node 0. On a disconnected graph it spans only the
    // component of node 0. The edges slice stays valid until the next mst call.
    pub const MSTResult = struct {
        edges : []Edge,
        total_weight : i64,
    };

    var weight_buffer : [256]i64 = undefined;
    var edge_buffer : [16]Edge = undefined;
    var visited_buffer : [16]bool = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // new_graph(node_count: usize) -> Graph : a graph with node_count nodes and no edges
    fn new_graph(node_count: usize) -> Graph {
        var cells = node_count * node_count;
        var i: usize = 0;
        while (i < cells) {
            weight_buffer[i] = -1;
            i = i + 1;
        }
        return Graph {
            .node_count = node_count,
            .weights = weight_buffer[0..cells],
        };
    }

    // add_edge(graph: *Graph, a: usize, b: usize, weight: i64) -> void : undirected edge
    fn add_edge(graph: *Graph, a: usize, b: usize, weight: i64) -> void {
        graph.weights[a * graph.node_count + b] = weight;
        graph.weights[b * graph.node_count + a] = weight;
    }

    // mst(graph: *Graph) -> MSTResult : Prim's algorithm for the Minimum Spanning Tree
    fn mst(graph: *Graph) -> MSTResult {
        var n = graph.node_count;
        var edge_count: usize = 0;
        var total_weight: i64 = 0;

        if (n > 0) {
            var i: usize = 0;
            while (i < n) {
                visited_buffer[i] = false;
                i = i + 1;
            }
            // Start with node 0
            visited_buffer[0] = true;

            var growing = true;
            while (growing and edge_count < n - 1) {
                var found = false;
                var min_weight: i64 = 0;
                var min_from: usize = 0;
                var min_to: usize = 0;

                // Find the minimum weight edge from a visited node to an unvisited one
                var a: usize = 0;
                while (a < n) {
                    if (visited_buffer[a]) {
                        var b: usize = 0;
                        while (b < n) {
                            var w = graph.weights[a * n + b];
                            if (w >= 0 and !visited_buffer[b] and (!found or w < min_weight)) {
                                found = true;
                                min_weight = w;
                                min_from = a;
                                min_to = b;
                            }
                            b = b + 1;
                        }
                    }
                    a = a + 1;
                }

                if (found) {
                    edge_buffer[edge_count] = Edge { .from = min_from, .to = min_to, .weight = min_weight };
                    visited_buffer[min_to] = true;
                    total_weight = total_weight + min_weight;
                    edge_count = edge_count + 1;
                } else {
                    // The graph is disconnected: nothing more to reach
                    growing = false;
                }
            }
        }

        return MSTResult {
            .edges = edge_buffer[0..edge_count],
            .total_weight = total_weight,
        };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test mst_basic_case {
        // 0-1 (1), 0-2 (4), 1-2 (2), 1-3 (6), 2-3 (3): the tree is 0-1, 1-2, 2-3
        var g = new_graph(4);
        add_edge(&g, 0, 1, 1);
        add_edge(&g, 0, 2, 4);
        add_edge(&g, 1, 2, 2);
        add_edge(&g, 1, 3, 6);
        add_edge(&g, 2, 3, 3);
        var result = mst(&g);
        assert(result.edges.len == 3);
        assert(result.total_weight == 6);
        assert(result.edges[0].from == 0);
        assert(result.edges[0].to == 1);
        assert(result.edges[1].from == 1);
        assert(result.edges[1].to == 2);
        assert(result.edges[2].from == 2);
        assert(result.edges[2].to == 3);
    }

    test mst_empty_graph {
        var g = new_graph(0);
        var result = mst(&g);
        assert(result.edges.len == 0);
        assert(result.total_weight == 0);
    }

    test mst_disconnected_graph_spans_only_the_first_component {
        // Node 3 has no edges, so the tree covers nodes 0, 1, 2 only
        var g = new_graph(4);
        add_edge(&g, 0, 1, 5);
        add_edge(&g, 1, 2, 7);
        var result = mst(&g);
        assert(result.edges.len == 2);
        assert(result.total_weight == 12);
    }
