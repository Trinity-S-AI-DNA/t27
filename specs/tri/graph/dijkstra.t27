// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Find shortest paths from start to all vertices | φ² + 1/φ² = 3 | TRINITY

module TriDijkstra;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Weighted directed graph as a row-major adjacency matrix: weights[from * node_count + to]
    // holds the edge weight, or a negative number when there is no edge. At most 16 nodes.
    pub const Graph = struct {
        node_count : usize,
        weights : []i64,
    };

    // distance[v] is the length of the shortest path from the source, or INFINITY when v is
    // unreachable. parent[v] is the previous node on that path; the source and unreachable
    // nodes have parent == node_count. Both slices stay valid until the next shortest_path call.
    pub const DijkstraResult = struct {
        distance : []i64,
        parent : []usize,
    };

    pub const INFINITY : i64 = 1000000000;

    var weight_buffer : [256]i64 = undefined;
    var distance_buffer : [16]i64 = undefined;
    var parent_buffer : [16]usize = undefined;
    var done_buffer : [16]bool = undefined;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // new_graph(node_count: usize) -> Graph : a graph with node_count nodes and no edges
    fn new_graph(node_count: usize) -> Graph {
        var cells = node_count * node_count;
        var i: usize = 0;
        while (i < cells) {
            weight_buffer[i] = -1;
            i = i + 1;
        }
        return Graph {
            .node_count = node_count,
            .weights = weight_buffer[0..cells],
        };
    }

    // add_edge(graph: *Graph, from: usize, to: usize, weight: i64) -> void : directed edge
    fn add_edge(graph: *Graph, from: usize, to: usize, weight: i64) -> void {
        graph.weights[from * graph.node_count + to] = weight;
    }

    // shortest_path(graph: *Graph, source: usize) -> DijkstraResult
    fn shortest_path(graph: *Graph, source: usize) -> DijkstraResult {
        var n = graph.node_count;
        var i: usize = 0;
        while (i < n) {
            distance_buffer[i] = INFINITY;
            parent_buffer[i] = n;
            done_buffer[i] = false;
            i = i + 1;
        }
        distance_buffer[source] = 0;

        var round: usize = 0;
        while (round < n) {
            // Pick the unfinished node with the smallest tentative distance
            var best: usize = n;
            var best_distance: i64 = INFINITY;
            var u: usize = 0;
            while (u < n) {
                if (!done_buffer[u] and distance_buffer[u] < best_distance) {
                    best = u;
                    best_distance = distance_buffer[u];
                }
                u = u + 1;
            }
            if (best == n) {
                // Everything left is unreachable
                round = n;
            } else {
                done_buffer[best] = true;
                // Relax the edges leaving best
                var v: usize = 0;
                while (v < n) {
                    var w = graph.weights[best * n + v];
                    if (w >= 0 and !done_buffer[v] and best_distance + w < distance_buffer[v]) {
                        distance_buffer[v] = best_distance + w;
                        parent_buffer[v] = best;
                    }
                    v = v + 1;
                }
                round = round + 1;
            }
        }

        return DijkstraResult {
            .distance = distance_buffer[0..n],
            .parent = parent_buffer[0..n],
        };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test shortest_path_basic_case {
        // 0 -> 1 (4), 0 -> 2 (1), 2 -> 1 (2), 1 -> 3 (1), 2 -> 3 (5); node 4 has no edges
        var g = new_graph(5);
        add_edge(&g, 0, 1, 4);
        add_edge(&g, 0, 2, 1);
        add_edge(&g, 2, 1, 2);
        add_edge(&g, 1, 3, 1);
        add_edge(&g, 2, 3, 5);
        var result = shortest_path(&g, 0);
        assert(result.distance.len == 5);
        assert(result.distance[0] == 0);
        assert(result.distance[2] == 1);
        assert(result.distance[1] == 3);
        assert(result.distance[3] == 4);
        assert(result.distance[4] == INFINITY);
        assert(result.parent[1] == 2);
        assert(result.parent[3] == 1);
        assert(result.parent[2] == 0);
        assert(result.parent[0] == 5);
        assert(result.parent[4] == 5);
    }
