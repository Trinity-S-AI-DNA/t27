// SPDX-License-Identifier: Apache-2.0
// specs/tri/status.t27 -- the `tri status` command: PHI LOOP status report
// Reads .trinity/state/active-skill.json, .trinity/cells/registry.json,
// .trinity/state/queen-health.json and `git rev-parse --short HEAD`;
// prints a one-page report. The glue reads the files and runs git;
// this spec defines the output format, verdict codes and string constants.
// ASCII only (L3); phi^2 + 1/phi^2 = 3 | TRINITY

module tri_status;

// --- paths -----------------------------------------------------------------

pub const STATE_DIR : str = ".trinity/state";
pub const CELLS_DIR : str = ".trinity/cells";
pub const ACTIVE_SKILL : str = "active-skill.json";
pub const REGISTRY : str = "registry.json";
pub const QUEEN_HEALTH : str = "queen-health.json";
pub const GIT_SHORT : str = "git rev-parse --short HEAD";

// --- output ----------------------------------------------------------------

pub const HEADER : str = "=== PHI LOOP STATUS ===";
pub const SKILL_ACTIVE : str = "active";
pub const SKILL_NONE : str = "none";
pub const SKILL_UNKNOWN : str = "?";

// --- verdict codes ---------------------------------------------------------

pub const V_OK : u32 = 0;
pub const V_UNREAD : u32 = 1;
pub const EXIT_OK : u32 = 0;
pub const EXIT_UNREAD : u32 = 2;

// --- string helpers --------------------------------------------------------

/// Byte-wise equality of two strings.
pub fn str_eq(a: string, b: string) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// --- format output (no string concatenation; glue assembles) --------------

pub fn format_header() -> string {
    return HEADER;
}

pub fn format_git_prefix() -> string {
    return "git: ";
}

pub fn format_git_unknown() -> string {
    return "git: unknown";
}

pub fn format_skill_none() -> string {
    return "skill: none";
}

pub fn format_skill_active_prefix() -> string {
    return "skill: ";
}

// --- verdicts -------------------------------------------------------------

pub fn verdict_ok() -> u32 {
    return V_OK;
}

pub fn verdict_unread() -> u32 {
    return V_UNREAD;
}

// --- tests ----------------------------------------------------------------

test format_header_constant {
    assert str_eq(format_header(), "=== PHI LOOP STATUS ===");
}

test format_git_prefix_constant {
    assert str_eq(format_git_prefix(), "git: ");
}

test format_git_unknown_constant {
    assert str_eq(format_git_unknown(), "git: unknown");
}

test format_skill_none_constant {
    assert str_eq(format_skill_none(), "skill: none");
}

test format_skill_active_prefix_constant {
    assert str_eq(format_skill_active_prefix(), "skill: ");
}

// --- invariants -----------------------------------------------------------

invariant exit_codes_are_numbered {
    assert EXIT_OK == 0;
    assert EXIT_UNREAD > EXIT_OK;
}

invariant verdicts_are_numbered {
    assert V_OK == 0;
    assert V_UNREAD > V_OK;
}

invariant skill_constants_distinct {
    assert str_eq(SKILL_ACTIVE, SKILL_NONE) == false;
    assert str_eq(SKILL_NONE, SKILL_UNKNOWN) == false;
}
