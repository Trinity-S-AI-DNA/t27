// specs/tri/status.t27 -- tri status: read header text from the .t27 spec.
// Part of M1 (milestone #5). Closes #13510.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::status;

pub const STATUS_HEADER_MAX : u32 = 200;

pub struct StatusHeader { text: str, line_count: u32 };

pub fn status_header_text(h: StatusHeader) -> str {
    return h.text;
}

pub fn status_header_lines(h: StatusHeader) -> u32 {
    return h.line_count;
}

test "status header text" {
    var h = StatusHeader { text: "t27 status report", line_count: 1 };
    assert(status_header_text(h) == "t27 status report");
}

test "status header line count" {
    var h = StatusHeader { text: "line1\nline2", line_count: 2 };
    assert(status_header_lines(h) == 2);
}

invariant header_has_text {
    var h = StatusHeader { text: "x", line_count: 0 };
    assert h.text == "x";
}