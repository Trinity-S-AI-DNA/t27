// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Fast exponentiation mod n | φ² + 1/φ² = 3 | TRINITY

module TriRsa;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const RSAKeyPair = struct {
        pub_e : u64,
        pub_n : u64,
        priv_d : u64,
        priv_n : u64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn mod_exp(base: u64, exp: u64, mod_n: u64) -> u64 {
        var res = 1;
        var b = base % mod_n;
        var e = exp;
        while (e > 0) {
            if (e % 2 == 1) res = (res * b) % mod_n;
            b = (b * b) % mod_n;
            e = e / 2;
        }
        return res;
    }

    fn mod_inverse(e: u64, phi: u64) -> u64 {
        var m0 = phi;
        var y = 0;
        var x = 1;
        if (phi == 1) return 0;
        
        var a = e;
        var b = phi;
        while (a > 1) {
            if (b == 0) break;
            var q = a / b;
            var t = b;
            b = a % b;
            a = t;
            t = y;
            y = x - q * y;
            x = t;
        }
        if (x < 0) x += m0;
        return x;
    }

    fn generate(p: u64, q: u64, e: u64) -> RSAKeyPair {
        const n = p * q;
        const phi = (p - 1) * (q - 1);
        const d = mod_inverse(e, phi);
        return { pub_e: e, pub_n: n, priv_d: d, priv_n: n };
    }

    fn encrypt(message: u64, pub_e: u64, pub_n: u64) -> u64 {
        return mod_exp(message, pub_e, pub_n);
    }

    fn decrypt(ciphertext: u64, priv_d: u64, priv_n: u64) -> u64 {
        return mod_exp(ciphertext, priv_d, priv_n);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test rsa_standard_flow {
        // p=61, q=53 -> n=3233, phi=3120
        // e=17, d=2753
        const keys = generate(61, 53, 17);
        const message = 65;
        const encrypted = encrypt(message, keys.pub_e, keys.pub_n);
        const decrypted = decrypt(encrypted, keys.priv_d, keys.priv_n);
        assert decrypted == message;
    }

    test rsa_identity {
        const keys = generate(61, 53, 17);
        const message = 1;
        const encrypted = encrypt(message, keys.pub_e, keys.pub_n);
        assert encrypted == 1;
    }
}
