// t27/specs/
// Merkle-Damgard construction with 64-byte blocks | φ² + 1/φ² = 3 | TRINITY

module TriSha256;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SHA256 = struct {
        state : [8]U32,
        buffer : [64]U8,
        count : u64,
    };

    pub const IV : [8]U32 = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ];

    pub const K : [64]U32 = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x980786ca, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xca62c1d6, 0xf1e826de, 0x8b23f443,
        0x952a2b3b, 0x35312212, 0x4a1484ca, 0x4a1484ca, 0x5cb0a9dc, 0x76f988da, 0x980786ca, 0xa831c66d,
        0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xca62c1d6, 0xf1e826de, 0x8b23f443, 0x952a2b3b, 0x35312212,
        0x4a1484ca, 0x4a1484ca, 0x5cb0a9dc, 0x76f988da, 0x980786ca, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xca62c1d6, 0xf1e826de, 0x8b23f443, 0x952a2b3b, 0x35312212, 0x4a1484ca, 0x4a1484ca
    ];

    // ═══════════════════════════════════════════════════════════
    // 3. Helper Macros (Compression Functions)
    // ═══════════════════════════════════════════════════════════

    fn rotr(x: U32, n: U32) -> U32 { return (x >> n) | (x << (32 - n)); }
    fn shr(x: U32, n: U32) -> U32 { return x >> n; }
    fn ch(x, y, z: U32) -> U32 { return (x & y) ^ (~x & z); }
    fn maj(x, y, z: U32) -> U32 { return (x & y) ^ (x & z) ^ (y & z); }
    fn sigma0(x: U32) -> U32 { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
    fn sigma1(x: U32) -> U32 { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }
    fn gamma0(x: U32) -> U32 { return rotr(x, 7) ^ rotr(x, 18) ^ shr(x, 3); }
    fn gamma1(x: U32) -> U32 { return rotr(x, 17) ^ rotr(x, 19) ^ shr(x, 10); }

    // ═══════════════════════════════════════════════════════════
    // 4. Core Implementation
    // ═══════════════════════════════════════════════════════════

    fn compress(sha: *SHA256, block: []const u8) -> void {
        var w : [64]U32;
        // Pre-process block into w
        for (i in 0..16) {
            w[i] = (block[i*4] << 24) | (block[i*4+1] << 16) | (block[i*4+2] << 8) | block[i*4+3];
        }
        for (i in 16..64) {
            w[i] = gamma1(w[i-2]) + w[i-7] + gamma0(w[i-15]) + w[i-16];
        }

        var a = sha.state[0];
        var b = sha.state[1];
        var c = sha.state[2];
        var d = sha.state[3];
        var e = sha.state[4];
        var f = sha.state[5];
        var g = sha.state[6];
        var h = sha.state[7];

        for (i in 0..64) {
            const t1 = h + sigma1(e) + ch(e, f, g) + K[i] + w[i];
            const t2 = sigma0(a) + maj(a, b, c);
            h = g; g = f; f = e;
            e = d + t1;
            d = c; c = b; b = a;
            a = t1 + t2;
        }

        sha.state[0] += a; sha.state[1] += b; sha.state[2] += c; sha.state[3] += d;
        sha.state[4] += e; sha.state[5] += f; sha.state[6] += g; sha.state[7] += h;
    }

    fn init() -> SHA256 {
        return { state: IV, buffer: [0]*64, count: 0 };
    }

    fn update(sha: *SHA256, data: []const u8) -> void {
        var offset = 0;
        while (offset < data.len) {
            var space = 64 - sha.buffer.len;
            var take = min(space, data.len - offset);
            sha.buffer.push(data[offset..offset+take]);
            offset += take;
            if (sha.buffer.len == 64) {
                compress(sha, sha.buffer);
                sha.buffer = [];
            }
        }
        sha.count += data.len * 8;
    }

    fn final(sha: *SHA256) -> [8]U32 {
        var bit_len = sha.count;
        update(sha, [0x80]);
        while ((sha.buffer.len + 8) % 64 != 0) {
            update(sha, [0x00]);
        }
        // Append length in bits as 64-bit big-endian
        var len_bytes : [8]u8;
        for (i in 0..8) { len_bytes[i] = (bit_len >> ((7-i)*8)) & 0xFF; }
        update(sha, len_bytes);
        return sha.state;
    }

    fn hash(data: []const u8) -> [8]U32 {
        var sha = init();
        update(&sha, data);
        return final(&sha);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test hash_empty {
        assert hash("") == [
            0xe3b0c442, 0x98fc1c14, 0x9afbf4c8, 0x996fb924,
            0x27ae41e4, 0x649b934c, 0xa495991b, 0x7852b855
        ];
    }

    test hash_abc {
        assert hash("abc") == [
            0xba7816bf, 0x8f01cfea, 0x414140de, 0x5dae2223,
            0xb00361a3, 0x96177a9c, 0xb410ff61, 0xf20015ad
        ];
    }
}
