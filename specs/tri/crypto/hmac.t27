// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Key padded to 64 bytes with ipad/opad | φ² + 1/φ² = 3 | TRINITY

module TriHmac;
    use base::types;
    use math::constants;
    use tri::crypto::sha256;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const HMAC = struct {
        state : sha256::SHA256,
        opad : [64]U8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn init(key: []const u8) -> HMAC {
        var prepared_key : [64]U8 = [0] * 64;
        
        if (key.len > 64) {
            const h = sha256::hash(key);
            prepared_key = bytes_from_u32(h); 
        } else {
            for (i in 0..key.len) { prepared_key[i] = key[i]; }
        }

        var ipad : [64]U8;
        var opad : [64]U8;
        for (i in 0..64) {
            ipad[i] = prepared_key[i] ^ 0x36;
            opad[i] = prepared_key[i] ^ 0x5c;
        }

        var sha = sha256::init();
        sha256::update(&sha, ipad);

        return {
            state: sha,
            opad: opad
        };
    }

    fn update(hmac: *HMAC, data: []const u8) -> void {
        sha256::update(&hmac.state, data);
    }

    fn final(hmac: *HMAC) -> [8]U32 {
        const inner_hash = sha256::final(&hmac.state);
        
        var outer_sha = sha256::init();
        sha256::update(&outer_sha, hmac.opad);
        sha256::update(&outer_sha, bytes_from_u32(inner_hash));
        
        return sha256::final(&outer_sha);
    }

    fn hmac_sha256(key: []const u8, data: []const u8) -> [8]U32 {
        var hmac = init(key);
        update(&hmac, data);
        return final(&hmac);
    }

    fn bytes_from_u32(data: [8]U32) -> [32]U8 {
        var res : [32]U8 = [0] * 32;
        for (i in 0..8) {
            const val = data[i];
            res[i*4] = (val >> 24) & 0xFF;
            res[i*4+1] = (val >> 16) & 0xFF;
            res[i*4+2] = (val >> 8) & 0xFF;
            res[i*4+3] = val & 0xFF;
        }
        return res;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ════════════════════════════════════════════════════════════
    test hmac_rfc4231 {
        assert hmac_sha256("key", "The quick brown fox jumps over the lazy dog") == [
            0xf7bc83f4, 0x30538424, 0x823dc402, 0xffc5995a,
            0x36347f51, 0x36d934d4, 0x92594675, 0x40b6750d
        ];
    }
}
