// t27/specs/
// Every byte becomes 2 chars | φ² + 1/φ² = 3 | TRINITY

module TriHex;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Hex = struct {
        uppercase : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn lower_case() -> Hex {
        return { uppercase: false };
    }

    fn upper_case() -> Hex {
        return { uppercase: true };
    }

    fn encode(data: []const u8, codec: Hex) -> string {
        const chars = "0123456789abcdef";
        const upper_chars = "0123456789ABCDEF";
        var result = "";
        
        for (b in data) {
            const high = b >> 4;
            const low = b & 0x0F;
            const set = codec.uppercase ? upper_chars : chars;
            result += set[high];
            result += set[low];
        }
        return result;
    }

    fn decode(input: string) -> []const u8 {
        var result = [];
        for (i in 0..input.len step 2) {
            const high = hex_to_int(input[i]);
            const low = hex_to_int(input[i+1]);
            result.push((high << 4) | low);
        }
        return result;
    }

    fn hex_to_int(c: char) -> u8 {
        if (c >= '0' && c <= '9') return c - '0';
        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
        return 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test encode_lower {
        assert encode([0xDE, 0xAD, 0xBE, 0xEF], lower_case()) == "deadbeef";
    }

    test encode_upper {
        assert encode([0xDE, 0xAD, 0xBE, 0xEF], upper_case()) == "DEADBEEF";
    }

    test decode_basic {
        assert decode("deadbeef") == [0xDE, 0xAD, 0xBE, 0xEF];
    }

    test decode_mixed_case {
        assert decode("DeAdBeEf") == [0xDE, 0xAD, 0xBE, 0xEF];
    }
}
