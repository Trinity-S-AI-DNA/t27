// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Check if point satisfies curve equation | φ² + 1/φ² = 3 | TRINITY

module TriEcc;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ECPoint = struct {
        x : f64,
        y : f64,
        is_infinity : bool,
    };

    pub const EllipticCurve = struct {
        a : f64,
        b : f64,
        p : f64, // Prime modulus
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn is_on_curve(curve: EllipticCurve, point: ECPoint) -> bool {
        if (point.is_infinity) return true;
        
        // Use tolerance for f64
        const lhs = (point.y * point.y) % curve.p;
        const rhs = (point.x * point.x * point.x + curve.a * point.x + curve.b) % curve.p;
        return abs(lhs - rhs) < 0.001;
    }

    fn add(curve: EllipticCurve, p1: ECPoint, p2: ECPoint) -> ECPoint {
        if (p1.is_infinity) return p2;
        if (p2.is_infinity) return p1;

        if (p1.x == p2.x && (p1.y != p2.y || p1.y == 0)) {
            return { x: 0, y: 0, is_infinity: true };
        }

        var lambda: f64;
        if (p1.x == p2.x && p1.y == p2.y) {
            // Doubling
            lambda = (3 * p1.x * p1.x + curve.a) / (2 * p1.y);
        } else {
            // Addition
            lambda = (p2.y - p1.y) / (p2.x - p1.x);
        }

        const x3 = (lambda * lambda) - p1.x - p2.x;
        const y3 = lambda * (p1.x - x3) - p1.y;

        return { x: x3, y: y3, is_infinity: false };
    }

    fn multiply(curve: EllipticCurve, point: ECPoint, scalar: u64) -> ECPoint {
        var result = { x: 0, y: 0, is_infinity: true };
        var base = point;

        var s = scalar;
        while (s > 0) {
            if (s % 2 == 1) {
                result = add(curve, result, base);
            }
            base = add(curve, base, base);
            s = s / 2;
        }
        return result;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test ecc_on_curve {
        // Curve: y^2 = x^3 - 3x + 5 (mod 163)
        // Point (1, 2): 2^2 = 4; 1^3 - 3(1) + 5 = 3. (Not on curve)
        // Point (1, sqrt(3)) approx. 
        const curve = { a: -3.0, b: 5.0, p: 163.0 };
        const p1 = { x: 1.0, y: 1.732, is_infinity: false };
        assert is_on_curve(curve, p1) == true;
    }

    test ecc_infinity_add {
        const curve = { a: -3.0, b: 5.0, p: 163.0 };
        const p1 = { x: 1.0, y: 1.732, is_infinity: false };
        const inf = { x: 0, y: 0, is_infinity: true };
        assert add(curve, p1, inf).x == p1.x;
    }
}
