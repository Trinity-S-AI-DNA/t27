// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// RFC 4648 compliant | φ² + 1/φ² = 3 | TRINITY

module TriBase32;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Base32 = struct {
        alphabet : string,
        padding : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn standard() -> Base32 {
        return { 
            alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", 
            padding: true 
        };
    }

    fn encode(data: []const u8, codec: Base32) -> string {
        var result = "";
        var buffer = 0;
        var bits_left = 0;
        
        for (b in data) {
            buffer = (buffer << 8) | b;
            bits_left += 8;
            while (bits_left >= 5) {
                result += codec.alphabet[(buffer >> (bits_left - 5)) & 0x1F];
                bits_left -= 5;
            }
            buffer &= (1 << bits_left) - 1;
        }
        
        if (bits_left > 0) {
            result += codec.alphabet[(buffer << (5 - bits_left)) & 0x1F];
        }
        
        if (codec.padding) {
            while (result.len % 8 != 0) {
                result += "=";
            }
        }
        
        return result;
    }

    fn decode(input: string, codec: Base32) -> []const u8 {
        var result = [];
        var buffer = 0;
        var bits_left = 0;
        const map = build_alphabet_map(codec.alphabet);
        
        for (c in input) {
            if (c == '=') break;
            const val = map[c];
            buffer = (buffer << 5) | val;
            bits_left += 5;
            if (bits_left >= 8) {
                result.push((buffer >> (bits_left - 8)) & 0xFF);
                bits_left -= 8;
            }
            buffer &= (1 << bits_left) - 1;
        }
        return result;
    }

    fn build_alphabet_map(alphabet: string) -> Map<char, u8> {
        var map = Map<char, u8>();
        for (i in 0..alphabet.len) {
            map[alphabet[i]] = i;
        }
        return map;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test base32_standard {
        const b32 = standard();
        // "Hello" (0x48 0x65 0x6c 0x6c 0x6f)
        // Bin: 01001000 01100101 01101100 01101100 01101111
        // 5-bit: 01001(9) 00001(1) 10010(18) 10110(22) 11000(24) 11011(27) 00011(3) 01111(15)
        // Alpha: J B S W Y 3 D P
        assert encode([0x48, 0x65, 0x6c, 0x6c, 0x6f], b32) == "JBSWY3DP";
        assert decode("JBSWY3DP", b32) == [0x48, 0x65, 0x6c, 0x6c, 0x6f];
    }

    test base32_padding {
        const b32 = standard();
        // "f" (0x66) -> 01100110
        // 5-bit: 01100(12) 11000(24)
        // Alpha: M Y
        assert encode([0x66], b32) == "MY======";
    }
}
