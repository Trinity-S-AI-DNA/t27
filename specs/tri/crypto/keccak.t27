// SPDX-License-Identifier: Apache-2.0
// specs/tri/crypto/keccak.t27 -- tri/crypto: Keccak-256 (Ethereum, original padding) in pure t27.
// Part of M1 (milestone #5). Closes #13332.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::crypto::keccak;

pub const KECCAK256_RATE : u32 = 136;
pub const KECCAK256_CAPACITY : u32 = 1600 - 136;
pub const KECCAK256_OUTPUT : u32 = 32;

pub struct KeccakState { lanes: [25]u64 };

pub fn keccak256_output_size() -> u32 {
    return KECCAK256_OUTPUT;
}

test "keccak256 output size is 32" {
    assert(keccak256_output_size() == 32);
}

test "keccak256 rate plus capacity is 1600" {
    assert(KECCAK256_RATE + KECCAK256_CAPACITY == 1600);
}

invariant keccak_output_size_is_thirty_two {
    assert KECCAK256_OUTPUT == 32;
}