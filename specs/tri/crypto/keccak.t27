// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/crypto/keccak.t27
// Keccak-256 with the original Keccak padding, as Ethereum uses it (not
// FIPS 202 SHA3-256) | phi^2 + 1/phi^2 = 3 | TRINITY
//
// Owner request 2026-11-07: T27 OS should sign in with a web3 wallet, with
// everything local and no server of ours. Checking an Ethereum personal_sign
// signature needs Keccak-256 twice: the EIP-191 digest of the signed text,
// and the address (the low 20 bytes of Keccak-256 of the recovered public
// key). This spec is step 1 of that work (upstream issue #13332, tracking
// issue #13331). Refs #13332.
//
// kec_keccak256 is Keccak-f[1600] (24 rounds over 25 little-endian u64
// lanes), rate 136 bytes, capacity 512 bits. Padding is the original
// Keccak pad10*1 with domain byte 0x01: 0x01 at byte len % 136 of the last
// block and 0x80 or-ed into byte 135, so the two coincide as 0x81 when the
// message leaves one byte free. FIPS 202 SHA3-256 differs only by using
// 0x06 instead of 0x01, so the two digests of the same input differ; a test
// guards that. Lane i holds state word x + 5 y with i = x + 5 y.
//
// Dialect follows specs/tri/crypto/sha512.t27: no unary operators, NOT x is
// written x ^ KEC_ALL (#6549), the rotate is a shift pair, and sums that
// may wrap are not needed here. A rotate by 0 is not a shift pair, so the
// one zero offset (lane 0) is skipped.
//
// Not constant time: every input is public (a message to be signed and a
// public key). Pure: no extern declarations, no state kept between calls, ASCII only.
//
// Sources (downloaded 2026-11-08 where a SHA-256 is given; nothing downloaded was run):
//   - Keccak team round-3 known answers (original padding, NOT
//     ShortMsgKAT_SHA3-256): https://keccak.team/obsolete/KeccakKAT-3.zip
//     (zip SHA-256 af92d22d23527a0d168a6bbe70b28c840a43bba5bcea828a6d9a5e7ad79378ce),
//     member KeccakKAT/ShortMsgKAT_256.txt
//     (SHA-256 741862f92342010311504202d7b304955fa28aa03a752633a5e83f971f014851).
//     The rows Len = 8, 1072, 1080, 1088, 1096 and 2040 are copied
//     verbatim (Msg and MD, upper case as in the file); the Len = 0 row
//     (Msg = 00, a message of zero bits) is written as the empty string
//     with its MD in lower case.
//   - Round constants, rotation offsets and the lane permutation: the
//     Keccak reference, "The Keccak reference", version 3.0, January 14,
//     2011 (Bertoni, Daemen, Peeters, Van Assche),
//     https://keccak.team/files/Keccak-reference-3.0.pdf
//     (SHA-256 834e74ed4b917b43a5f9cee932166161e09246a0cb90544539a0c81a04d748a5):
//     section 1.2 gives the round constants by a formula (an LFSR) and
//     prints no table of them; section 2.3.3 is pi; section 2.3.4 is rho
//     with its offsets in Table 2.1.
//   - Keccak specifications summary, https://keccak.team/keccak_specs_summary.html
//     (SHA-256 902d1d352e5d7184dcd2752f1779c886624b61f5099db61e04da115a83b1b966):
//     Table 1 is the 24 round constants in hex, Table 2 the rotation offsets.
//     The constants were also checked by a pure Python implementation
//     (kept outside the repository) that reproduces all 256 byte-aligned
//     rows of ShortMsgKAT_256.txt.
//   - Ethereum Yellow Paper, https://ethereum.github.io/yellowpaper/paper.pdf
//     (SHA-256 d67c009c5d5a0542c8288aee3c4d470b3e2dbe6e664f72f00011543608477fa9)
//     defines KEC as Keccak-256 and uses KEC(()) for the empty string. It
//     does not print the hex digits; they are the Len = 0 row above.
//   - SHA3-256 of the empty string a7ffc6f8...8434a (FIPS 202, confirmed
//     with python3 hashlib.sha3_256) is the guard value in test 6.
//   - Public key of the generator G of secp256k1 (SEC 2 v2 section 2.4.1,
//     https://www.secg.org/sec2-v2.pdf, SHA-256
//     87b8f3703364ed5b21ba8582e411cc0cbf477bcaa3f4f45e0d6580d1c00d9952)
//     hashes to the Ethereum address
//     0x7e5f4552091a69125d5dfcb7b8c2659029395bdf, the address of private
//     key 1 that every Ethereum tool lists.
//   - 'abc' (616263): digest from the Python implementation above.
//   - The 300 'a' bytes and 136 zero bytes digests come from the Python
//     implementation above (multi-block and exact-rate-multiple cases).

module TriKeccak;
    use base::types;

    // ===========================================================
    // 1. Constants
    // ===========================================================

    // Keccak specifications summary, Table 1: the 24 round constants (reference 3.0
    // section 1.2 gives the formula)
    pub const KEC_RC : [24]u64 = [
        0x0000000000000001, 0x0000000000008082,
        0x800000000000808a, 0x8000000080008000,
        0x000000000000808b, 0x0000000080000001,
        0x8000000080008081, 0x8000000000008009,
        0x000000000000008a, 0x0000000000000088,
        0x0000000080008009, 0x000000008000000a,
        0x000000008000808b, 0x800000000000008b,
        0x8000000000008089, 0x8000000000008003,
        0x8000000000008002, 0x8000000000000080,
        0x000000000000800a, 0x800000008000000a,
        0x8000000080008081, 0x8000000000008080,
        0x0000000080000001, 0x8000000080008008,
    ];

    // Keccak reference 3.0 section 2.3.4 (rho), Table 2.1: rotation offset of lane
    // i = x + 5 y
    pub const KEC_ROT : [25]u64 = [
        0, 1, 62, 28, 27,
        36, 44, 6, 55, 20,
        3, 10, 43, 25, 39,
        41, 45, 15, 21, 8,
        18, 2, 61, 56, 14,
    ];

    // Keccak reference 3.0 section 2.3.3 (pi): lane i = x + 5 y moves to
    // lane y + 5 ((2 x + 3 y) mod 5)
    pub const KEC_PI : [25]usize = [
        0, 10, 20, 5, 15,
        16, 1, 11, 21, 6,
        7, 17, 2, 12, 22,
        23, 8, 18, 3, 13,
        14, 24, 9, 19, 4,
    ];

    // all 64 bits set: x ^ KEC_ALL is NOT x
    pub const KEC_ALL : u64 = 18446744073709551615;

    // bytes absorbed per permutation: (1600 - 2 * 256) / 8
    pub const KEC_RATE : usize = 136;

    // ===========================================================
    // 2. Types
    // ===========================================================

    pub const KecState = struct {
        lanes : [25]u64,
    };

    // ===========================================================
    // 3. Core Functions
    // ===========================================================

    // x rotated left by 0 < n < 64
    fn kec_rotl(x: u64, n: u64) -> u64 {
        return (x << n) | (x >> (64 - n));
    }

    // one Keccak-f[1600] permutation: 24 rounds of theta, rho, pi, chi, iota
    fn kec_permute(ks: *KecState) -> void {
        var round : usize = 0;
        while (round < 24) {
            var c : [5]u64 = [0] ** 5;
            var x : usize = 0;
            while (x < 5) {
                c[x] = ks.lanes[x] ^ ks.lanes[x + 5] ^ ks.lanes[x + 10] ^ ks.lanes[x + 15] ^ ks.lanes[x + 20];
                x = x + 1;
            }
            var b : [25]u64 = [0] ** 25;
            var i : usize = 0;
            while (i < 25) {
                const d = c[(i % 5 + 4) % 5] ^ kec_rotl(c[(i % 5 + 1) % 5], 1);
                var lane = ks.lanes[i] ^ d;
                if (KEC_ROT[i] != 0) {
                    lane = kec_rotl(lane, KEC_ROT[i]);
                }
                b[KEC_PI[i]] = lane;
                i = i + 1;
            }
            var y : usize = 0;
            while (y < 25) {
                x = 0;
                while (x < 5) {
                    ks.lanes[y + x] = b[y + x] ^ ((b[y + (x + 1) % 5] ^ KEC_ALL) & b[y + (x + 2) % 5]);
                    x = x + 1;
                }
                y = y + 5;
            }
            ks.lanes[0] = ks.lanes[0] ^ KEC_RC[round];
            round = round + 1;
        }
    }

    // xor the 136 bytes blk[0 .. 136] into lanes 0 .. 16, little-endian
    fn kec_absorb(ks: *KecState, blk: []const u8, off: usize) -> void {
        var i : usize = 0;
        while (i < 17) {
            var word : u64 = 0;
            var b : usize = 0;
            while (b < 8) {
                word = word | ((blk[off + 8 * i + b] as u64) << (8 * (b as u64)));
                b = b + 1;
            }
            ks.lanes[i] = ks.lanes[i] ^ word;
            i = i + 1;
        }
    }

    // Keccak-256 (original padding) of data
    pub fn kec_keccak256(data: []const u8) -> [32]u8 {
        var ks = KecState{ .lanes = [0] ** 25 };
        var pos : usize = 0;
        while (data.len - pos >= KEC_RATE) {
            kec_absorb(&ks, data, pos);
            kec_permute(&ks);
            pos = pos + KEC_RATE;
        }
        // last block: the rest, 0x01 after it, 0x80 or-ed into byte 135
        var last : [136]u8 = [0] ** 136;
        const rest = data.len - pos;
        var k : usize = 0;
        while (k < rest) {
            last[k] = data[pos + k];
            k = k + 1;
        }
        last[rest] = 1;
        last[135] = last[135] | 128;
        kec_absorb(&ks, last[0 .. 136], 0);
        kec_permute(&ks);
        var out : [32]u8 = [0] ** 32;
        var i : usize = 0;
        while (i < 32) {
            out[i] = ((ks.lanes[i / 8] >> (8 * ((i % 8) as u64))) & 255) as u8;
            i = i + 1;
        }
        return out;
    }

    pub fn kec_same32(a: [32]u8, b: [32]u8) -> bool {
        var diff : u8 = 0;
        var i : usize = 0;
        while (i < 32) {
            diff = diff | (a[i] ^ b[i]);
            i = i + 1;
        }
        return diff == 0;
    }

    // ===========================================================
    // TDD: Tests
    // ===========================================================

    // value of a hex digit of either case (digits are '0'..'9', 'A'..'F', 'a'..'f')
    fn kec_nibble(c: u8) -> u8 {
        var v : u8 = c - 48;
        if (c >= 65) {
            v = c - 55;
        }
        if (c >= 97) {
            v = c - 87;
        }
        return v;
    }

    // up to 255 bytes from hex of either case; the caller slices [0 .. len / 2]
    fn kec_unhex(s: []const u8) -> [256]u8 {
        var o : [256]u8 = [0] ** 256;
        var i : usize = 0;
        while (2 * i < s.len) {
            o[i] = kec_nibble(s[2 * i]) * 16 + kec_nibble(s[2 * i + 1]);
            i = i + 1;
        }
        return o;
    }

    fn kec_hex32(s: []const u8) -> [32]u8 {
        var o : [32]u8 = [0] ** 32;
        var i : usize = 0;
        while (i < 32) {
            o[i] = kec_nibble(s[2 * i]) * 16 + kec_nibble(s[2 * i + 1]);
            i = i + 1;
        }
        return o;
    }

    // Keccak-256 of the message in msg_hex equals the digest in md_hex
    fn kec_kat(msg_hex: []const u8, md_hex: []const u8) -> bool {
        const m = kec_unhex(msg_hex);
        return kec_same32(kec_keccak256(m[0 .. msg_hex.len / 2]), kec_hex32(md_hex));
    }

    // the 64 bytes Gx || Gy of the secp256k1 generator, SEC 2 v2 2.4.1
    fn kec_generator_xy() -> [256]u8 {
        return kec_unhex("79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8");
    }

    // the last 20 bytes of the digest of Gx || Gy equal the address hex
    fn kec_address_of_g() -> bool {
        const g = kec_generator_xy();
        const d = kec_keccak256(g[0 .. 64]);
        const want = kec_hex32("0000000000000000000000007e5f4552091a69125d5dfcb7b8c2659029395bdf");
        var i : usize = 12;
        while (i < 32) {
            if (d[i] != want[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // n copies of byte v, hashed
    fn kec_repeat(v: u8, n: usize) -> [32]u8 {
        var x : [300]u8 = [0] ** 300;
        var i : usize = 0;
        while (i < n) {
            x[i] = v;
            i = i + 1;
        }
        return kec_slice(x, n);
    }

    fn kec_slice(x: [300]u8, n: usize) -> [32]u8 {
        return kec_keccak256(x[0 .. n]);
    }

    fn kec_same_ok() -> bool {
        const a = kec_hex32("c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470");
        var b = kec_hex32("c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470");
        const same_first = kec_same32(a, b);
        b[31] = b[31] ^ 1;
        const differ_last = kec_same32(a, b) == false;
        b[31] = b[31] ^ 1;
        b[0] = b[0] ^ 128;
        const differ_first = kec_same32(a, b) == false;
        return same_first and differ_last and differ_first;
    }

    // test 1 (Len = 0 of the round-3 file and the Yellow Paper KEC(()))
    test empty_string
        given result = kec_kat("", "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470")
        when expected = true
        then result == expected

    test abc
        given result = kec_kat("616263", "4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45")
        when expected = true
        then result == expected

    test kat_len_8_one_byte
        given result = kec_kat("CC", "EEAD6DBFC7340A56CAEDC044696A168870549A6A7F6F56961E84A54BD9970B8A")
        when expected = true
        then result == expected

    test kat_len_1072_134_bytes_one_short_of_a_block
        given result = kec_kat("77EE804B9F3295AB2362798B72B0A1B2D3291DCEB8139896355830F34B3B328561531F8079B79A6E9980705150866402FDC176C05897E359A6CB1A7AB067383EB497182A7E5AEF7038E4C96D133B2782917417E391535B5E1B51F47D8ED7E4D4025FE98DC87B9C1622614BFF3D1029E68E372DE719803857CA52067CDDAAD958951CB2068CC6",
                "FE71D01C2EE50E054D6B07147EF62954FDE7E6959D6EEBA68E3C94107EB0084D")
        when expected = true
        then result == expected

    test kat_len_1080_135_bytes_pad_byte_0x81
        given result = kec_kat("B771D5CEF5D1A41A93D15643D7181D2A2EF0A8E84D91812F20ED21F147BEF732BF3A60EF4067C3734B85BC8CD471780F10DC9E8291B58339A677B960218F71E793F2797AEA349406512829065D37BB55EA796FA4F56FD8896B49B2CD19B43215AD967C712B24E5032D065232E02C127409D2ED4146B9D75D763D52DB98D949D3B0FED6A8052FBB",
                "BD6F5492582A7C1B116304DE28314DF9FFFE95B0DA11AF52FE9440A717A34859")
        when expected = true
        then result == expected

    test kat_len_1088_136_bytes_exact_block
        given result = kec_kat("B32D95B0B9AAD2A8816DE6D06D1F86008505BD8C14124F6E9A163B5A2ADE55F835D0EC3880EF50700D3B25E42CC0AF050CCD1BE5E555B23087E04D7BF9813622780C7313A1954F8740B6EE2D3F71F768DD417F520482BD3A08D4F222B4EE9DBD015447B33507DD50F3AB4247C5DE9A8ABD62A8DECEA01E3B87C8B927F5B08BEB37674C6F8E380C04",
                "E717A7769448ABBE5FEF8187954A88AC56DED1D22E63940AB80D029585A21921")
        when expected = true
        then result == expected

    test kat_len_1096_137_bytes_second_block
        given result = kec_kat("04410E31082A47584B406F051398A6ABE74E4DA59BB6F85E6B49E8A1F7F2CA00DFBA5462C2CD2BFDE8B64FB21D70C083F11318B56A52D03B81CAC5EEC29EB31BD0078B6156786DA3D6D8C33098C5C47BB67AC64DB14165AF65B44544D806DDE5F487D5373C7F9792C299E9686B7E5821E7C8E2458315B996B5677D926DAC57B3F22DA873C601016A0D",
                "A95D50B50B4545F0947441DF74A1E9D74622EB3BAA49C1BBFC3A0CCE6619C1AA")
        when expected = true
        then result == expected

    test kat_len_2040_255_bytes
        given result = kec_kat("",
                "348FB774ADC970A16B1105669442625E6ADAA8257A89EFFDB5A802F161B862EA")
        when expected = true
        then result == expected

    // test 5: Ethereum address of private key 1, from the public key
    test generator_public_key_gives_address_of_key_1
        given result = kec_address_of_g()
        when expected = true
        then result == expected

    // test 6: FIPS 202 SHA3-256("") is a different value (domain byte 0x06)
    test differs_from_fips_202_sha3_256
        given result = kec_same32(kec_keccak256(""), kec_hex32("a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"))
        when expected = false
        then result == expected

    // multi-block (300 bytes, three permutations) and 136 zero bytes (the
    // empty last block), digests from the Python implementation
    test multi_block_digests_from_the_python_oracle
        given result = kec_same32(kec_repeat(97, 300), kec_hex32("5b7e0e47a96f32a88b4f14ca177982790807c40e1a105742ba0fc1babe1ef826")) and kec_same32(kec_repeat(0, 136), kec_hex32("3a5912a7c5faa06ee4fe906253e339467a9ce87d533c65be3c15cb231cdb25f9"))
        when expected = true
        then result == expected

    test same32_compares_every_byte
        given result = kec_same_ok()
        when expected = true
        then result == expected
