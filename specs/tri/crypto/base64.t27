// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// RFC 4648 compliant | φ² + 1/φ² = 3 | TRINITY

module TriBase64;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Base64 = struct {
        alphabet : []const u8,
        padding : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // standard() → Base64
    // RFC 4648 section 4 alphabet (64 characters), padded with '='
    fn standard() -> Base64 {
        return Base64 {
            .alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/",
            .padding = true,
        };
    }

    // url_safe() → Base64
    // RFC 4648 section 5 alphabet, no padding
    fn url_safe() -> Base64 {
        return Base64 {
            .alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_",
            .padding = false,
        };
    }

    // Marker returned by decode for input that is not valid base64 or does not fit.
    const DECODE_INVALID : usize = 0xFFFFFFFF;

    // encoded_length(codec: Base64, input_len: usize) -> usize
    // Number of characters encode writes for input_len bytes
    fn encoded_length(codec: Base64, input_len: usize) -> usize {
        if (codec.padding) {
            return (input_len + 2) / 3 * 4;
        }
        return (input_len * 8 + 5) / 6;
    }

    // encode(codec: Base64, input: []const u8, output: []u8) -> usize
    // Encode input into output. Returns the number of characters written, or 0 when
    // output is shorter than encoded_length. The caller owns the buffer, so the
    // function cannot fail on allocation.
    fn encode(codec: Base64, input: []const u8, output: []u8) -> usize {
        if (output.len < encoded_length(codec, input.len)) {
            return 0;
        }

        var written : usize = 0;
        var buf : u32 = 0;
        var bits : u32 = 0;
        var i : usize = 0;
        while (i < input.len) {
            buf = (buf << 8) | (input[i] as u32);
            bits = bits + 8;
            while (bits >= 6) {
                bits = bits - 6;
                output[written] = codec.alphabet[(buf >> bits) & 0x3F];
                written = written + 1;
            }
            buf = buf & 0x3F;
            i = i + 1;
        }

        if (bits > 0) {
            output[written] = codec.alphabet[(buf << (6 - bits)) & 0x3F];
            written = written + 1;
        }

        if (codec.padding) {
            while (written % 4 != 0) {
                output[written] = 61;  // '='
                written = written + 1;
            }
        }

        return written;
    }

    // decoded_length(input: []const u8) -> usize
    // Number of bytes decode writes: padding ends the data
    fn decoded_length(input: []const u8) -> usize {
        var chars : usize = 0;
        while (chars < input.len and input[chars] != 61) {
            chars = chars + 1;
        }
        return chars * 6 / 8;
    }

    // decode(codec: Base64, input: []const u8, output: []u8) -> usize
    // Decode input into output. Padding ends the data. Returns the number of bytes
    // written, or DECODE_INVALID for a character outside the alphabet or a short output.
    fn decode(codec: Base64, input: []const u8, output: []u8) -> usize {
        var written : usize = 0;
        var buf : u32 = 0;
        var bits : u32 = 0;
        var i : usize = 0;
        while (i < input.len) {
            const c = input[i];
            if (c == 61) {
                break;
            }

            var value : u32 = 0xFFFF;
            var k : usize = 0;
            while (k < codec.alphabet.len) {
                if (codec.alphabet[k] == c) {
                    value = k as u32;
                }
                k = k + 1;
            }
            if (value == 0xFFFF) {
                return DECODE_INVALID;
            }

            buf = (buf << 6) | value;
            bits = bits + 6;
            if (bits >= 8) {
                bits = bits - 8;
                if (written >= output.len) {
                    return DECODE_INVALID;
                }
                output[written] = ((buf >> bits) & 0xFF) as u8;
                written = written + 1;
                buf = buf & 0xFF;
            }
            i = i + 1;
        }

        return written;
    }

    // same_text(buf: []const u8, n: usize, expected: []const u8) -> bool
    // True when the first n bytes of buf equal expected
    fn same_text(buf: []const u8, n: usize, expected: []const u8) -> bool {
        if (n != expected.len or n > buf.len) {
            return false;
        }
        var i : usize = 0;
        while (i < n) {
            if (buf[i] != expected[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (RFC 4648 section 10 test vectors)
    // ═══════════════════════════════════════════════════════════

    test standard_alphabet_has_64_characters
        given codec = standard()
        and   url = url_safe()
        then codec.alphabet.len == 64 and codec.padding == true
        then url.alphabet.len == 64 and url.padding == false

    test encode_foobar
        given codec = standard()
        and   input = "foobar"
        and   out = []u8{0, 0, 0, 0, 0, 0, 0, 0}
        and   n = encode(codec, input, out)
        and   ok = same_text(out, n, "Zm9vYmFy")
        then n == 8
        then ok == true

    test encode_f_padded
        given codec = standard()
        and   input = "f"
        and   out = []u8{0, 0, 0, 0}
        and   n = encode(codec, input, out)
        and   ok = same_text(out, n, "Zg==")
        then n == 4
        then ok == true

    test encode_fo_padded
        given codec = standard()
        and   input = "fo"
        and   out = []u8{0, 0, 0, 0}
        and   n = encode(codec, input, out)
        and   ok = same_text(out, n, "Zm8=")
        then n == 4
        then ok == true

    test encode_fooba_padded
        given codec = standard()
        and   input = "fooba"
        and   out = []u8{0, 0, 0, 0, 0, 0, 0, 0}
        and   n = encode(codec, input, out)
        and   ok = same_text(out, n, "Zm9vYmE=")
        then n == 8
        then ok == true

    test encode_empty
        given codec = standard()
        and   input = ""
        and   out = []u8{0, 0, 0, 0}
        and   n = encode(codec, input, out)
        then n == 0

    test encode_standard_uses_plus_and_slash
        given codec = standard()
        and   input = []u8{251, 255}
        and   out = []u8{0, 0, 0, 0}
        and   n = encode(codec, input, out)
        and   ok = same_text(out, n, "+/8=")
        then n == 4
        then ok == true

    test encode_url_safe_uses_dash_and_underscore
        given codec = url_safe()
        and   input = []u8{251, 255}
        and   out = []u8{0, 0, 0}
        and   n = encode(codec, input, out)
        and   ok = same_text(out, n, "-_8")
        then n == 3
        then ok == true

    test encode_short_output_refused
        given codec = standard()
        and   input = "foobar"
        and   out = []u8{0, 0, 0, 0}
        and   n = encode(codec, input, out)
        then n == 0

    test decode_foobar
        given codec = standard()
        and   input = "Zm9vYmFy"
        and   out = []u8{0, 0, 0, 0, 0, 0}
        and   n = decode(codec, input, out)
        and   ok = same_text(out, n, "foobar")
        then n == 6
        then ok == true

    test decode_padded
        given codec = standard()
        and   input = "Zm9vYg=="
        and   out = []u8{0, 0, 0, 0}
        and   n = decode(codec, input, out)
        and   ok = same_text(out, n, "foob")
        then n == 4
        then ok == true

    test decode_rejects_bad_character
        given codec = standard()
        and   input = "Zm9*"
        and   out = []u8{0, 0, 0, 0}
        and   n = decode(codec, input, out)
        then n == DECODE_INVALID

    test decoded_length_counts_data_bytes
        given a = decoded_length("Zm9vYg==")
        and   b = decoded_length("Zm9vYmFy")
        and   c = decoded_length("")
        then a == 4 and b == 6 and c == 0

    test roundtrip_hello
        given codec = standard()
        and   input = "Hello"
        and   enc = []u8{0, 0, 0, 0, 0, 0, 0, 0}
        and   m = encode(codec, input, enc)
        and   dec = []u8{0, 0, 0, 0, 0}
        and   n = decode(codec, enc, dec)
        and   ok = same_text(dec, n, "Hello")
        and   enc_ok = same_text(enc, m, "SGVsbG8=")
        then n == 5
        then ok == true
        then enc_ok == true
