// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// RFC 4648 compliant | φ² + 1/φ² = 3 | TRINITY

module TriBase64;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Base64 = struct {
        alphabet : string,
        padding : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn standard() -> Base64 {
        return { 
            alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", 
            padding: true 
        };
    }

    fn url_safe() -> Base64 {
        return { 
            alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", 
            padding: false 
        };
    }

    fn encode(data: []const u8, codec: Base64) -> string {
        var result = "";
        var i = 0;
        while (i < data.len) {
            const b1 = data[i];
            const b2 = (i + 1 < data.len) ? data[i+1] : 0;
            const b3 = (i + 2 < data.len) ? data[i+2] : 0;

            result += codec.alphabet[(b1 >> 2)];
            result += codec.alphabet[((b1 & 0x03) << 4) | (b2 >> 4)];
            
            if (i + 1 < data.len) {
                result += codec.alphabet[((b2 & 0x0F) << 2) | (b3 >> 6)];
            } else if (codec.padding) {
                result += "=";
            }

            if (i + 2 < data.len) {
                result += codec.alphabet[b3 & 0x3F];
            } else if (codec.padding) {
                result += "=";
            }
            i += 3;
        }
        return result;
    }

    fn decode(input: string, codec: Base64) -> []const u8 {
        var result = [];
        var i = 0;
        const map = build_alphabet_map(codec.alphabet);
        
        while (i < input.len) {
            const v1 = map[input[i]];
            const v2 = map[input[i+1]];
            const v3 = (i + 2 < input.len && input[i+2] != '=') ? map[input[i+2]] : 0;
            const v4 = (i + 3 < input.len && input[i+3] != '=') ? map[input[i+3]] : 0;

            result.push((v1 << 2) | (v2 >> 4));
            if (v3 != 0 || (i + 2 < input.len && input[i+2] != '=')) {
                result.push(((v2 & 0x0F) << 4) | (v3 >> 2));
            }
            if (v4 != 0 || (i + 3 < input.len && input[i+3] != '=')) {
                result.push(((v3 & 0x03) << 6) | v4);
            }
            i += 4;
        }
        return result;
    }

    fn encoded_length(data: []const u8, codec: Base64) -> u64 {
        const n = data.len;
        if (!codec.padding) return ((n * 8 + 5) / 6);
        return ((n + 2) / 3) * 4;
    }

    fn decoded_length(input: string, codec: Base64) -> u64 {
        const n = input.len;
        if (!codec.padding) return (n * 6 / 8);
        var padding = 0;
        if (n > 0 && input[n-1] == '=') padding++;
        if (n > 1 && input[n-2] == '=') padding++;
        return (n * 3 / 4) - padding;
    }

    fn build_alphabet_map(alphabet: string) -> Map<char, u8> {
        var map = Map<char, u8>();
        for (i in 0..alphabet.len) {
            map[alphabet[i]] = i;
        }
        return map;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test base64_standard {
        const b64 = standard();
        assert encode([0x48, 0x65, 0x6c, 0x6c, 0x6f], b64) == "SGVsbG8=";
        assert decode("SGVsbG8=", b64) == [0x48, 0x65, 0x6c, 0x6c, 0x6f];
    }

    test base64_url_safe {
        const b64 = url_safe();
        assert encode([0x48, 0x65, 0x6c, 0x6c, 0x6f], b64) == "SGVsbG8";
        assert decode("SGVsbG8", b64) == [0x48, 0x65, 0x6c, 0x6c, 0x6f];
    }

    test base64_empty {
        assert encode([], standard()) == "";
        assert decode("", standard()) == [];
    }
}
