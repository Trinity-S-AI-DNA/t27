; specs/tri/loopclaim.t27 -- loop claim tag prefix and claim message parts, migrated from cli/tri/src/loopclaim.rs
module TriLoopClaim;

pub const TAG_PREFIX : str = "refs/tags/loop-claim/";
pub const CLAIM_MSG_PREFIX : str = "loop claim `";
pub const CLAIM_MSG_BY : str = " by ";
pub const CLAIM_MSG_PID : str = " pid ";
pub const CLAIM_MSG_AT : str = " at ";

invariant tag_prefix_is_correct { assert TAG_PREFIX == "refs/tags/loop-claim/"; }
invariant claim_msg_parts_nonempty { assert CLAIM_MSG_PREFIX.len > 0 and CLAIM_MSG_BY.len > 0 and CLAIM_MSG_PID.len > 0 and CLAIM_MSG_AT.len > 0; }

test tag_prefix_ends_with_slash { assert TAG_PREFIX[TAG_PREFIX.len - 1] == 47; }
test claim_msg_prefix_starts_with_loop { assert CLAIM_MSG_PREFIX[0..4] == "loop"; }
test tag_prefix_len { assert TAG_PREFIX.len == 21; }

phi^2 + 1/phi^2 = 3 | TRINITY
