// SPDX-License-Identifier: Apache-2.0
// specs/tri/boilerplate_loop.t27 -- boilerplate and spaghetti ratchet in .t27.
// A std layer (std::text, std::mem), migration of copied helpers onto it, a
// ratchet that sees renamed clones, and a claim protocol so several agents
// never do one row.
// Part of [EPIC] boilerplate and spaghetti in .t27 (#12444). Closes #12444.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::boilerplate_loop {

    pub const MODULE : str = "boilerplate_loop";
    pub const SURFACE : str = "boilerplate";

    // ---- Std layer ---------------------------------------------------------
    pub struct StdLayer {
        has_text : bool,
        has_mem : bool,
        has_signmag : bool,
    };

    pub fn std_layer_complete(l: StdLayer) -> bool {
        return l.has_text && l.has_mem && l.has_signmag;
    }

    // ---- Duplicate-body ratchet -------------------------------------------
    // The ratchet is blind to renamed clones; alpha-renaming-proof body key
    // makes renamed clones count.
    pub fn body_key_alpha_proof(renamed: bool, same_body: bool) -> bool {
        return same_body && !renamed;
    }

    pub fn duplicate_detected(group_count: u32, threshold: u32) -> bool {
        return group_count >= threshold;
    }

    // ---- Claim protocol ----------------------------------------------------
    pub struct Claim {
        issue : str,
        agent : str,
        branch : str,
        stale_hours : u32,
    };

    pub fn claim_stale(c: Claim) -> bool {
        return c.stale_hours >= 6;
    }

    pub fn claim_takeover_allowed(c: Claim, takeover_posted: bool) -> bool {
        return claim_stale(c) && takeover_posted;
    }

    // ---- Tests ------------------------------------------------------------
    test "std layer has text, mem and signmag" {
        assert(std_layer_complete(StdLayer {
            has_text: true, has_mem: true, has_signmag: true
        }));
        assert(!std_layer_complete(StdLayer {
            has_text: true, has_mem: false, has_signmag: true
        }));
    }

    test "alpha-renaming-proof body key: renamed clones count as duplicates" {
        assert(body_key_alpha_proof(false, true));
        assert(!body_key_alpha_proof(true, true));
        assert(!body_key_alpha_proof(false, false));
    }

    test "duplicate group exceeds threshold" {
        assert(duplicate_detected(100, 10));
        assert(!duplicate_detected(5, 10));
    }

    test "claim stale after 6 hours without edit" {
        assert(claim_stale(Claim {
            issue: "#1", agent: "agent-a", branch: "claude/a-1", stale_hours: 6
        }));
        assert(!claim_stale(Claim {
            issue: "#1", agent: "agent-a", branch: "claude/a-1", stale_hours: 5
        }));
        assert(claim_takeover_allowed(Claim {
            issue: "#1", agent: "agent-a", branch: "claude/a-1", stale_hours: 7
        }, true));
        assert(!claim_takeover_allowed(Claim {
            issue: "#1", agent: "agent-a", branch: "claude/a-1", stale_hours: 7
        }, false));
    }

    invariant std_layer_requires_all_three {
        assert std_layer_complete(StdLayer {
            has_text: true, has_mem: true, has_signmag: true
        });
    }

    invariant claim_stale_at_six_hours {
        assert claim_stale(Claim {
            issue: "#1", agent: "a", branch: "b", stale_hours: 6
        });
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
