; specs/tri/gendet.t27 -- determinism check contract for tri emit determinism.
; Migrated from cli/tri/src/gendet.rs, Pareto incremental migration.
; ASCII only, English.

module TriGenDet;

pub const BACKEND_CMD_0 : str = "gen-c";
pub const BACKEND_CMD_1 : str = "gen-rust";
pub const BACKEND_CMD_2 : str = "gen";
pub const BACKEND_CMD_3 : str = "gen-verilog";

pub const BACKEND_LABEL_0 : str = "C";
pub const BACKEND_LABEL_1 : str = "Rust";
pub const BACKEND_LABEL_2 : str = "Zig";
pub const BACKEND_LABEL_3 : str = "Verilog";

pub fn runs_ok(runs : usize) -> bool {
    return runs >= 2;
}

pub fn backend_is_known(name : str) -> bool {
    return name == BACKEND_CMD_0 or name == BACKEND_CMD_1 or name == BACKEND_CMD_2 or name == BACKEND_CMD_3;
}

test one_run_cannot_disagree_with_itself {
    assert runs_ok(1) == false;
    assert runs_ok(0) == false;
    assert runs_ok(2) == true;
    assert runs_ok(3) == true;
}

test an_unknown_backend_is_refused {
    assert backend_is_known("gen-cobol") == false;
    assert backend_is_known("gen-c") == true;
    assert backend_is_known("gen-rust") == true;
}

test every_backend_has_distinct_subcommand_and_label {
    assert BACKEND_CMD_0 != BACKEND_CMD_1;
    assert BACKEND_CMD_0 != BACKEND_CMD_2;
    assert BACKEND_CMD_0 != BACKEND_CMD_3;
    assert BACKEND_CMD_1 != BACKEND_CMD_2;
    assert BACKEND_CMD_1 != BACKEND_CMD_3;
    assert BACKEND_CMD_2 != BACKEND_CMD_3;
    assert BACKEND_LABEL_0 != BACKEND_LABEL_1;
    assert BACKEND_LABEL_0 != BACKEND_LABEL_2;
    assert BACKEND_LABEL_0 != BACKEND_LABEL_3;
    assert BACKEND_LABEL_1 != BACKEND_LABEL_2;
    assert BACKEND_LABEL_1 != BACKEND_LABEL_3;
    assert BACKEND_LABEL_2 != BACKEND_LABEL_3;
}

test the_four_emitters_are_all_listed {
    assert backend_is_known("gen-c");
    assert backend_is_known("gen-rust");
    assert backend_is_known("gen");
    assert backend_is_known("gen-verilog");
}

invariant backend_count_is_four {
    assert backend_is_known("gen-c");
    assert backend_is_known("gen-rust");
    assert backend_is_known("gen");
    assert backend_is_known("gen-verilog");
    assert backend_is_known("gen-cobol") == false;
}
