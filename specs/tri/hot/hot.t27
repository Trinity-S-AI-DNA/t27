// specs/tri/hot/hot.t27 -- Hot reload budgets and verdicts
// Part of gHashTag/t27#8870

module TriHot;

// Budgets about 4x the measurement at load ~7
pub const FRONTIER_WARM_BUDGET_MS : int = 5000;
pub const SILICON_REUSE_BUDGET_MS : int = 2000;

// Hot verdict: OK, OVER or SKIPPED
// A path that cannot run here reads SKIPPED, never OK
pub fn hot_verdict(ran: bool, ms: int, budget: int) -> string {
    if ran {
        if ms <= budget {
            return "OK";
        } else {
            return "OVER";
        }
    } else {
        return "SKIPPED";
    }
}

// Hot exit: the run fails only on an OVER
pub fn hot_exit(over: string) -> int {
    if over == "OVER" {
        return 1;
    } else {
        return 0;
    }
}

// Tests for hot_verdict and hot_exit
test hot_verdict_tests {
    // Test OK case
    assert hot_verdict(true, 1000, 5000) == "OK";
    
    // Test OVER case
    assert hot_verdict(true, 6000, 5000) == "OVER";
    
    // Test SKIPPED case
    assert hot_verdict(false, 1000, 5000) == "SKIPPED";
}

test hot_exit_tests {
    // Test non-over case (should exit 0)
    assert hot_exit("OK") == 0;
    assert hot_exit("SKIPPED") == 0;
    assert hot_exit("OVER") == 1;
}