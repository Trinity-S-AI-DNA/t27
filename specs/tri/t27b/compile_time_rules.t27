; specs/tri/t27b/compile_time_rules.t27 -- Executable contract for compile-time
; optimization rules in the T27B backend.
; Research rationale and narrative live in docs/tri/t27b/compile_time_optimizations.md.
; phi^2 + 1/phi^2 = 3 | TRINITY

module CompileTimeRules;

// ============================================================
// Optimization rules (executable contract)
// ============================================================

pub const AGGRESSIVE_INLINING_ENABLED = true;
pub const DEAD_CODE_ELIMINATION_ENABLED = true;
pub const CONSTANT_FOLDING_ENABLED = true;
pub const COMPILE_TIME_METAPROGRAMMING_ENABLED = true;
pub const BRANCHLESS_ARM64_ENABLED = true;
pub const SIMD_NEON_ENABLED = true;

// Optimization level names
pub const OPT_LEVEL_O0 = "O0";
pub const OPT_LEVEL_O1 = "O1";
pub const OPT_LEVEL_O2 = "O2";
pub const OPT_LEVEL_O3 = "O3";

pub const DEFAULT_OPTIMIZATION_LEVEL = "O2";

// ============================================================
// Rule validation functions
// ============================================================

pub fn is_inlining_enabled() -> bool {
    return AGGRESSIVE_INLINING_ENABLED;
}

pub fn is_dce_enabled() -> bool {
    return DEAD_CODE_ELIMINATION_ENABLED;
}

pub fn is_constant_folding_enabled() -> bool {
    return CONSTANT_FOLDING_ENABLED;
}

pub fn is_compile_time_metaprogramming_enabled() -> bool {
    return COMPILE_TIME_METAPROGRAMMING_ENABLED;
}

pub fn is_branchless_arm64_enabled() -> bool {
    return BRANCHLESS_ARM64_ENABLED;
}

pub fn is_simd_neon_enabled() -> bool {
    return SIMD_NEON_ENABLED;
}

pub fn is_valid_optimization_level(level: str) -> bool {
    if (level == OPT_LEVEL_O0) { return true; }
    if (level == OPT_LEVEL_O1) { return true; }
    if (level == OPT_LEVEL_O2) { return true; }
    if (level == OPT_LEVEL_O3) { return true; }
    return false;
}

pub fn default_optimization_level() -> str {
    return DEFAULT_OPTIMIZATION_LEVEL;
}

// ============================================================
// Tests (L4)
// ============================================================

test inlining_enabled_by_default {
    assert(is_inlining_enabled() == true);
}

test dce_enabled_by_default {
    assert(is_dce_enabled() == true);
}

test constant_folding_enabled_by_default {
    assert(is_constant_folding_enabled() == true);
}

test compile_time_metaprogramming_enabled_by_default {
    assert(is_compile_time_metaprogramming_enabled() == true);
}

test branchless_arm64_enabled_by_default {
    assert(is_branchless_arm64_enabled() == true);
}

test simd_neon_enabled_by_default {
    assert(is_simd_neon_enabled() == true);
}

test valid_optimization_levels {
    assert(is_valid_optimization_level("O0") == true);
    assert(is_valid_optimization_level("O1") == true);
    assert(is_valid_optimization_level("O2") == true);
    assert(is_valid_optimization_level("O3") == true);
}

test invalid_optimization_level_rejected {
    assert(is_valid_optimization_level("O9") == false);
    assert(is_valid_optimization_level("debug") == false);
    assert(is_valid_optimization_level("") == false);
}

test default_optimization_level_is_valid {
    assert(default_optimization_level() == "O2");
    assert(is_valid_optimization_level(default_optimization_level()) == true);
}
