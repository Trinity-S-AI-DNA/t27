// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/loop_peel_first_iter_plan.t27 -- when t27b may peel the first
; iteration of a loop to prove a clamped counter's in-loop increment safe
; (Refs #12871 #13453; golden_spec.t27 addendum 2026-11-15).
; phi^2 + 1/phi^2 = 3 | TRINITY
; 
; THE PROBLEM. In specs/tri/shootout/bench_audit.t27 `verdict_benchmark_200m`
; the hot loop keeps one checked `adds + b.hs` pair on
; `cur_tick = cur_tick + 1`. The counter is clamped:
; `if (cur_tick > 1000) { cur_tick = 0; ... }`. But cur_tick starts from a
; PARAMETER, so the first-iteration add overflows iff tick == u64::MAX and the
; trap is real: no elide rule may drop it. GCC's 10-word loop relies on
; signed overflow being undefined behaviour in C; t27b's checked u64 does not
; have that liberty.
; 
; THE RULE. Peel one iteration. The peeled copy keeps its check (any start
; value stays handled); after the peeled iteration the clamp gives the
; invariant `x <= B` at the loop head (either the reset ran, or the guard
; failed so x was already <= B), so every in-loop `x + c` is provably safe
; and relaxes to the wrapping op. Cost: one cloned body in the prologue, off
; the hot loop. Gain: the `adds + b.hs` pair becomes one `add`.
; 
; ACCEPTED SHAPE (all of):
; - x is assigned exactly twice in the loop body: the checked increment
;   `x = x + c` and the reset `x = LOW` under the guard `x > B`;
; - c, B, LOW are constants with max(B, LOW) + c <= MAX (checked in exact
;   u64; a wrap-around bound is refused, not wrapped);
; - the increment and the reset sit at the top level of the body (not in an
;   inner while);
; - x never escapes (no reference or address leaves the function).
; The peeled copy is the ORIGINAL body (checks kept); only the in-loop body
; relaxes x's increment. `continue` and `break` inside the body are refused
; at M0: the peel keeps the pre-loop `if (cond)` guard, but a `continue` in
; the cloned body would jump into a loop that is no longer there.
; 
; REFUSED (negative controls, each its own test): no reset; a second or
; missing assignment of x; the reset guard not `>`; constants whose bound
; plus c overflows; x escaping; the shape inside an inner while; a body with
; `continue` or `break`.
; 
; THE GLUE in cli/t27b/src/lower.rs collects the facts, emits the peeled
; `if (cond) { body; step }` before the loop, and relaxes only the in-loop
; increment; it decides nothing. Gen: gen/rust/tri/t27b/loop_peel_first_iter_plan.rs.
; ASCII only (L3).

module T27bLoopPeelFirstIterPlan;

// CmpOp number of `>` (cli/t27b/src/ir.rs: Eq 0, Ne 1, Lt 2, Le 3, Gt 4, Ge 5).
pub const CMP_GT : u8 = 4;

pub const U64_MAX : u64 = 18446744073709551615;

/// Whether the constants leave headroom: the largest value x can take at an
/// in-loop increment (max(B, LOW)) plus c must not wrap.
pub fn bounds_fit(c: u64, bound_b: u64, low: u64) -> bool {
    var top : u64 = bound_b;
    if (low > bound_b) { top = low; }
    if (c > U64_MAX - top) { return false; }
    return true;
}

/// Whether the shape peels. assigns_of_x counts the loop-body assignments of
/// x (the increment and the reset; exactly 2). increment_checked: the add is
/// still the checked op (never already relaxed). reset_present: the body has
/// the `if (x > B) { x = LOW }` arm at the top level. has_jump: the body
/// contains `continue` or `break`.
pub fn peel_ok(assigns_of_x: u32, increment_checked: bool, c: u64, guard_gt: bool, reset_present: bool, bounds_fit: bool, inner_loop: bool, escapes: bool, has_jump: bool) -> bool {
    if (assigns_of_x != 2) { return false; }
    if (increment_checked == false) { return false; }
    if (guard_gt == false) { return false; }
    if (reset_present == false) { return false; }
    if (bounds_fit == false) { return false; }
    if (inner_loop) { return false; }
    if (escapes) { return false; }
    if (has_jump) { return false; }
    return true;
}

// --- Tests: the bench_audit witness, then every refusal on its own -------

test accepts_the_bench_audit_shape {
    // cur_tick = cur_tick + 1; if (cur_tick > 1000) { cur_tick = 0; }
    assert(peel_ok(2, true, 1, true, true, bounds_fit(1, 1000, 0), false, false, false));
}

test accepts_a_low_above_the_bound {
    assert(peel_ok(2, true, 2, true, true, bounds_fit(2, 10, 20), false, false, false));
}

test refuses_without_a_reset {
    assert(peel_ok(1, true, 1, true, true, bounds_fit(1, 1000, 0), false, false, false) == false);
}

test refuses_a_third_assignment {
    assert(peel_ok(3, true, 1, true, true, bounds_fit(1, 1000, 0), false, false, false) == false);
}

test refuses_an_unchecked_increment {
    assert(peel_ok(2, false, 1, true, true, bounds_fit(1, 1000, 0), false, false, false) == false);
}

test refuses_a_non_gt_guard {
    // `if (x >= B)` admits x == B - 1 at the head after a skipped reset only
    // through paths the analysis does not track: refused at M0.
    assert(peel_ok(2, true, 1, false, true, bounds_fit(1, 1000, 0), false, false, false) == false);
}

test refuses_wrapping_bounds {
    // max(B, LOW) + c would wrap: the invariant says nothing past MAX.
    assert(bounds_fit(2, U64_MAX, 0) == false);
    assert(peel_ok(2, true, 2, true, true, bounds_fit(2, U64_MAX, 0), false, false, false) == false);
}

test refuses_an_inner_loop_shape {
    assert(peel_ok(2, true, 1, true, true, bounds_fit(1, 1000, 0), true, false, false) == false);
}

test refuses_an_escaped_x {
    assert(peel_ok(2, true, 1, true, true, bounds_fit(1, 1000, 0), false, true, false) == false);
}

test refuses_a_body_with_jump {
    assert(peel_ok(2, true, 1, true, true, bounds_fit(1, 1000, 0), false, false, true) == false);
}
