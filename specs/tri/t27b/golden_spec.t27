// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/golden_spec.t27 -- t27b AArch64 optimization GOLDEN SPEC
; Documents every optimization opportunity identified in the bench_audit hot loop (#12871)
; with their implementation status, word savings, and pass prerequisites.
; This is the single source of truth for "all possible t27b optimizations" in t27 GOLDEN SPEC.
; phi^2 + 1/phi^2 = 3 | TRINITY
; Refs #12871 #13421

module T27bGoldenSpec;

; ======== WORD BUDGET ANALYSIS ========
//
; Witness function: BenchAudit.verdict_benchmark_200m (specs/tri/shootout/bench_audit.t27).
; Loop body (one iteration, AArch64 words):
;
;   NAIVE (no optimizations):
;     adds  acc, acc, verdict_fn_result     ; 1
;     b.hs  overflow_trap                   ; 1
;     adds  cur_tick, cur_tick, #1          ; 1 -- raw increment
;     b.hs  overflow_trap                   ; 1
;     cmp   cur_tick, #1001                 ; 1 -- if branch
;     b.lo  else_label                      ; 1
;     movz  cur_tick, #0                    ; 1
;     movz  cur_prev, #1000                 ; 1
;     b     end_if                          ; 1
;     sub   cur_prev, cur_tick, #1          ; 1 -- else arm
;     adds  i, i, #1                        ; 1 -- loop counter
;     b.hs  overflow_trap                   ; 1
;     cmp   i, #CALLS_TARGET               ; 1
;     b.lt  loop_top                        ; 1
;   Total naive: ~20 words  (verdict_fn not yet inlined, cset+add separate)
;
;   AFTER check_elide rules (a)+(b)+(c), merged PRs #13397 #13403:
;     cset  tmp, ne             ; verdict_fn inlined, cset before acc add: 1
;     add   acc, acc, tmp       ; 1   (was adds+b.hs: saved 1 word by rule a)
;     add   cur_tick, cur_tick, #1  ; 1  (was adds+b.hs: saved 1 word by rule a)
;     cmp   cur_tick, #1001     ; 1
;     b.lo  else_label          ; 1
;     movz  cur_tick, #0        ; 1
;     movz  cur_prev, #1000     ; 1
;     b     end_if              ; 1
;     sub   cur_prev, cur_tick, #1  ; 1
;     add   i, i, #1            ; 1  (was adds+b.hs: saved 1 word)
;     cmp   i, CALLS_TARGET     ; 1  (may be movz+cmp = 2, but limit is imm12-encodable: 1)
;     b.lt  loop_top            ; 1
;   Total after check_elide: ~14 words
;
;   AFTER cinc peephole (cset+add -> csinc), merged PR #13415:
;     csinc acc, acc, acc, eq   ; 1  (replaces cset + add: saved 1 word)
;     add   cur_tick, cur_tick, #1  ; 1
;     cmp   cur_tick, #1001     ; 1
;     b.lo  else_label          ; 1
;     movz  cur_tick, #0        ; 1
;     movz  cur_prev, #1000     ; 1
;     b     end_if              ; 1
;     sub   cur_prev, cur_tick, #1  ; 1
;     add   i, i, #1            ; 1
;     cmp   i, CALLS_TARGET     ; 1
;     b.lt  loop_top            ; 1
;   Total after cinc: 11-13 words  (exact count depends on CALLS_TARGET encoding)
;   Measured by subagent after PR #13415: 13 words.  gcc -O2: 10 words.
;
;   AFTER if-conversion (csel, merged PR #13383, ifconv_plan.t27, codegen.rs ifconv()):
;     csinc acc, acc, acc, eq   ; 1
;     add   cur_tick, cur_tick, #1  ; 1
;     sub   tmp, cur_tick, #1   ; 1  pre-compute else output (safe: guard=[1001..max], trap={0})
;     cmp   cur_tick, #1001     ; 1
;     csel  cur_tick, xzr, cur_tick, hs  ; 1
;     movz  tmp2, #1000         ; 1
;     csel  cur_prev, tmp2, tmp, hs  ; 1
;     add   i, i, #1            ; 1
;     cmp   i, CALLS_TARGET     ; 1
;     b.lt  loop_top            ; 1
;   10-11 words (saves 2 from the branch+movz+b elimination; fires when guard var is Reg-resident).
;
;   AFTER countdown_plan (countdown transform, merged this PR Refs #13421):
;     ; init: movz cnt, CALLS_TARGET   (once, before loop)
;     csinc acc, acc, acc, eq   ; 1
;     add   cur_tick, cur_tick, #1  ; 1
;     sub   tmp, cur_tick, #1   ; 1
;     cmp   cur_tick, #1001     ; 1
;     csel  cur_tick, xzr, cur_tick, hs  ; 1
;     movz  tmp2, #1000         ; 1
;     csel  cur_prev, tmp2, tmp, hs  ; 1
;     subs  cnt, cnt, #1        ; 1  replaces add i + cmp + b.lt
;     b.ne  loop_top            ; 1
;   Projected: 9 words (saves 1 word from the loop control).
;   GCC -O2 produces 10 words; the extra cmp+movk for CALLS_TARGET may explain the
;   remaining 1-word gap at gcc's level.
; ========================================

; --- STATUS TABLE ---
; Optimization         Spec                           PR       Words saved  Status
; (a) induction elide  check_elide_plan.t27 rule a    #13397   1            MERGED
; (b) decrement elide  check_elide_plan.t27 rule b    #13397   1            MERGED
; (c) accumulator elide check_elide_plan.t27 rule c   #13403   1            MERGED
; cinc peephole        cinc_peephole_plan.t27          #13415   1            MERGED
; if-conversion        ifconv_plan.t27 (codegen.rs)    #13383   2            MERGED
; count-down           countdown_plan.t27 (lower.rs)  #13421   1            MERGED
; ----------------------------------------

; The golden_spec module exposes one invariant: the total declared word savings
; from all MERGED optimizations is exactly 6 (check_elide x3, cinc, if_convert x2).
pub fn merged_word_savings() -> u32 {
    return 6;  ; check_elide(a) + check_elide(b) + check_elide(c) + cinc + if_convert(2) = 6
}

pub fn proposed_word_savings() -> u32 {
    return 1;  ; countdown(1)
}

pub fn total_identified_savings() -> u32 {
    return merged_word_savings() + proposed_word_savings();
}

test total_savings_is_seven {
    assert(total_identified_savings() == 7);
}

test merged_savings_is_six {
    assert(merged_word_savings() == 6);
}

test proposed_savings_is_one {
    assert(proposed_word_savings() == 1);
}
