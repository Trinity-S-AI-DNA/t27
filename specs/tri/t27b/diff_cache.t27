// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/diff_cache.t27 -- the reuse law of the t27b differential
; suite's verdict (epic #8095 "verdict reuse", the cargo-test side; the
; reference-cache side is verdict_key.t27). The suite feeds seeded random IR
; programs to the JIT and the interpreter and compares them trap-for-trap. Its
; verdict is a pure function of what it runs and what runs it, so while the
; key matches, the stored verdict may be served and the rerun skipped.
; --
; The key: FNV-1a 64 over, in order, KEY_SCHEMA and four parts, each itself an
; FNV-1a 64 the glue computes (verdict_key.t27's fnv_u64):
;   harness  the bytes of cli/t27b/tests/differential.rs itself
;   backend  the bytes that built the codegen under test (the t27b crate
;            sources, as the glue hashes them; a build with any difference is
;            a different part and never matches)
;   knobs    T27B_DIFF_CASES, T27B_DIFF_SEED, T27B_DIFF_ONE, T27B_DIFF_TRACE,
;            hashed in a fixed order
;   host     the arch-os the suite runs on, so a verdict that depends on the
;            machine is never served on another one
; --
; What is kept. Only an all-programs-pass verdict is written; a run with any
; mismatch stores nothing (the failure names the seed to replay, not a
; reusable fact). A row of another schema never matches, because the schema
; is the first word hashed.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bDiffCache;

use tri::t27b::verdict_key;
use tri::t27b::blockers;

/// The version of the key layout; 1 is this file. A row of another layout never matches.
pub const KEY_SCHEMA : u64 = 1;

/// The suite's verdict over one run: how many programs mismatched.
pub const VERDICT_PASS : u32 = 0;
pub const VERDICT_MISMATCH : u32 = 1;

/// The key of one diff-cache row, from the four parts and the schema.
pub fn suite_key(harness: u64, backend: u64, knobs: u64, host: u64) -> u64 {
    var h : u64 = verdict_key::fnv_u64(blockers::FNV_OFFSET, KEY_SCHEMA);
    h = verdict_key::fnv_u64(h, harness);
    h = verdict_key::fnv_u64(h, backend);
    h = verdict_key::fnv_u64(h, knobs);
    h = verdict_key::fnv_u64(h, host);
    return h;
}

/// May the stored verdict be served for this run: every part equal, schema included.
pub fn may_reuse(stored: u64, current: u64) -> bool {
    return stored == current;
}

/// What may be written. A run with mismatches stores nothing: the replay
/// instruction names the seed, and a failure is not a reusable fact.
pub fn keep_verdict(failures: u32) -> bool {
    return failures == VERDICT_PASS;
}

/// The glue's fall-back: a row it cannot authenticate is a miss, never a hit.
pub fn hit_or_miss(row_bytes_ok: bool, row_key: u64, current: u64) -> bool {
    if (row_bytes_ok == false) {
        return false;
    }
    return may_reuse(row_key, current);
}

test the_schema_is_hashed_first_so_rows_of_other_layouts_never_match {
    var h1 : u64 = suite_key(1, 2, 3, 4);
    var h2 : u64 = verdict_key::fnv_u64(verdict_key::fnv_u64(verdict_key::fnv_u64(verdict_key::fnv_u64(verdict_key::fnv_u64(blockers::FNV_OFFSET, KEY_SCHEMA), 1), 2), 3), 4);
    assert h1 == h2;
    assert h1 != verdict_key::fnv_u64(blockers::FNV_OFFSET, verdict_key::KEY_SCHEMA);
}
test reuse_requires_the_whole_key_to_match {
    assert may_reuse(12345, 12345);
    assert may_reuse(12345, 12346) == false;
    assert may_reuse(0, 0);
    assert may_reuse(1, 0) == false;
}
test only_an_all_pass_verdict_is_kept {
    assert keep_verdict(VERDICT_PASS);
    assert keep_verdict(1) == false;
    assert keep_verdict(7) == false;
    assert keep_verdict(VERDICT_MISMATCH) == false;
}
test an_unauthenticatable_row_is_a_miss {
    assert hit_or_miss(true, 555, 555);
    assert hit_or_miss(true, 555, 556) == false;
    assert hit_or_miss(false, 555, 555) == false;
    assert hit_or_miss(false, 0, 0) == false;
}
test the_parts_order_is_fixed_so_a_permuted_key_is_another_key {
    var abc : u64 = suite_key(1, 2, 3, 4);
    var bac : u64 = suite_key(2, 1, 3, 4);
    var abcd : u64 = suite_key(1, 2, 3, 5);
    assert abc != bac;
    assert abc != abcd;
}
