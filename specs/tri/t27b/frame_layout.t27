// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/frame_layout.t27 -- the register-class and frame-layout law of
; t27b AArch64 codegen. One home for every register number, frame constant,
; offset and probe rule the codegen touches, tested here (L4). The Rust glue in
; cli/t27b/src/codegen.rs re-uses these through `t27c gen-rust`
; (gen/rust/tri/t27b/frame_layout.rs) instead of restating them (DRY); the
; emitter stays plumbing.
; Classes (ARMv8 general registers x0..x30): x0-x7 arguments and result; x8
; operation scratch; x9-x15 the expression temp stack; x16/x17 scratch for
; spilled temps and materialised constants; x18 the Apple platform register,
; never touched; x19-x28 variable homes (callee saved); x29/x30 frame pointer
; and link register; x31 is sp.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bFrameLayout;

; ---- register classes
pub const X0 : u32 = 0;
pub const ARG_COUNT : u32 = 8;
pub const SCRATCH : u32 = 8;
pub const TEMP_BASE : u32 = 9;
pub const TEMP_COUNT : u32 = 7;
pub const SPILL_A : u32 = 16;
pub const SPILL_B : u32 = 17;
pub const PLATFORM : u32 = 18;
pub const HOME_BASE : u32 = 19;
pub const HOME_COUNT : u32 = 10;
pub const FP : u32 = 29;
pub const LR : u32 = 30;
pub const SLOT_BYTES : u32 = 8;

; ---- frame constants
; ldr/str unsigned-offset reach from sp.
pub const MAX_SLOT_BYTES : u32 = 32760;
; Largest frame the prologue allocates in one step. Kept below the stack guard
; size, so such a frame never reaches past the guard page without touching it.
pub const MAX_UNPROBED_FRAME : u32 = 16384;
; One step of a probed frame: the smallest page size t27b runs on (#7367).
pub const PROBE_STEP : u32 = 4096;
; Largest aggregate area of one frame: each slot is then at most two SUB words
; below x29 (a64.t27 sub_const: SUB_CONST_REACH 16777216 - 16).
pub const MAX_AGG_BYTES : u32 = 16777200;

pub fn temp_reg(i: u32) -> u32 {
    return TEMP_BASE + i;
}
pub fn home_reg(i: u32) -> u32 {
    return HOME_BASE + i;
}
pub fn is_arg(r: u32) -> bool {
    return r < ARG_COUNT;
}
pub fn is_temp(r: u32) -> bool {
    return (r >= TEMP_BASE) and (r < TEMP_BASE + TEMP_COUNT);
}
pub fn is_spill_scratch(r: u32) -> bool {
    return (r == SPILL_A) or (r == SPILL_B);
}
pub fn is_home(r: u32) -> bool {
    return (r >= HOME_BASE) and (r < HOME_BASE + HOME_COUNT);
}

; ---- frame facts
pub const FrameFacts = struct {
    has_call: bool,
    saves_callee: bool,
    has_var_slots: bool,
    has_temp_slots: bool,
    has_agg: bool,
    uses_lr: bool,
    has_stack_params: bool,
};

; A function with any of these needs a frame (prologue, epilogue, and sp-based
; slot addressing); otherwise it is frameless and every `b ret` becomes `ret`.
pub fn needs_frame(facts: FrameFacts) -> bool {
    if (facts.has_call) { return true; }
    if (facts.saves_callee) { return true; }
    if (facts.has_var_slots) { return true; }
    if (facts.has_temp_slots) { return true; }
    if (facts.has_agg) { return true; }
    if (facts.uses_lr) { return true; }
    if (facts.has_stack_params) { return true; }
    return false;
}

; The frame holds, from sp upward: variable slots, saved callee-saved
; registers, temp slots; the aggregate area sits directly below x29. The byte
; count is 16-aligned so sp stays 16-aligned (AAPCS64).
pub const FrameSizes = struct {
    nbytes: u32,
    frame_bytes: u32,
};
pub fn frame_bytes_of(var_slots: u32, saved_callee: u32, temp_slots: u32, agg_bytes: u32) -> FrameSizes {
    let nbytes = SLOT_BYTES * (var_slots + saved_callee + temp_slots);
    let aligned = ((nbytes + 15) / 16) * 16;
    return FrameSizes { nbytes: nbytes, frame_bytes: aligned + agg_bytes };
}

; temp_base sits above every variable slot and saved callee-saved register.
pub fn temp_base_of(var_slots: u32, saved_callee: u32) -> u32 {
    return SLOT_BYTES * (var_slots + saved_callee);
}
; The byte offset of temp i from sp.
pub fn slot_of_temp(temp_base: u32, i: u32) -> u32 {
    return temp_base + SLOT_BYTES * i;
}
pub fn slot_ok(off: u32) -> bool {
    return off <= MAX_SLOT_BYTES;
}
; An i128 home takes i128_plan HOME_WORDS words of frame, laid out first.
pub fn i128_home_slots(count: u32) -> u32 {
    return count * 2;
}

; ---- stack probing (#7367)
; A frame larger than MAX_UNPROBED_FRAME is allocated in PROBE_STEP steps:
; lower sp one page at a time, touch each new page, top down, so the guard
; page below the stack faults instead of being stepped over.
pub fn needs_probe(frame_bytes: u32) -> bool {
    return frame_bytes > MAX_UNPROBED_FRAME;
}
; Whole pages the probe loop walks: `mov x16, #pages*4096`.
pub fn probe_pages(frame_bytes: u32) -> u32 {
    return frame_bytes / PROBE_STEP;
}
; The tail below the last whole page, allocated with one SUB and one touch.
pub fn probe_rest(frame_bytes: u32) -> u32 {
    return frame_bytes - probe_pages(frame_bytes) * PROBE_STEP;
}

test register_classes_partition_x0_to_x30_around_an_untouched_x18 {
    assert X0 == 0;
    assert is_arg(0);
    assert is_arg(7);
    assert is_arg(8) == false;
    assert SCRATCH == 8;
    assert temp_reg(0) == 9;
    assert temp_reg(6) == 15;
    assert is_temp(9);
    assert is_temp(15);
    assert is_temp(8) == false;
    assert is_temp(16) == false;
    assert is_spill_scratch(16);
    assert is_spill_scratch(17);
    assert is_spill_scratch(18) == false;
    assert is_arg(PLATFORM) == false;
    assert is_temp(PLATFORM) == false;
    assert is_home(PLATFORM) == false;
    assert home_reg(0) == 19;
    assert home_reg(9) == 28;
    assert is_home(19);
    assert is_home(28);
    assert is_home(18) == false;
    assert is_home(29) == false;
    assert FP == 29;
    assert LR == 30;
    assert HOME_COUNT == 10;
    assert TEMP_COUNT == 7;
}
test frame_offsets_sit_above_slots_and_saved_registers {
    assert temp_base_of(0, 0) == 0;
    assert temp_base_of(3, 2) == 40;
    assert slot_of_temp(40, 0) == 40;
    assert slot_of_temp(40, 5) == 80;
    assert slot_ok(0);
    assert slot_ok(MAX_SLOT_BYTES);
    assert slot_ok(MAX_SLOT_BYTES + 1) == false;
    assert i128_home_slots(1) == 2;
    assert i128_home_slots(3) == 6;
}
test the_frame_byte_count_is_sixteen_aligned_plus_the_aggregate_area {
    assert frame_bytes_of(0, 0, 0, 0).nbytes == 0;
    assert frame_bytes_of(0, 0, 0, 0).frame_bytes == 0;
    assert frame_bytes_of(1, 0, 0, 0).nbytes == 8;
    assert frame_bytes_of(1, 0, 0, 0).frame_bytes == 16;
    assert frame_bytes_of(2, 3, 4, 0).nbytes == 72;
    assert frame_bytes_of(2, 3, 4, 0).frame_bytes == 80;
    assert frame_bytes_of(0, 0, 0, 8).frame_bytes == 8;
    assert frame_bytes_of(1, 1, 1, 40).frame_bytes == 72;
}
test a_frame_is_needed_exactly_when_one_of_its_facts_holds {
    assert needs_frame(FrameFacts { has_call: false, saves_callee: false, has_var_slots: false, has_temp_slots: false, has_agg: false, uses_lr: false, has_stack_params: false }) == false;
    assert needs_frame(FrameFacts { has_call: true, saves_callee: false, has_var_slots: false, has_temp_slots: false, has_agg: false, uses_lr: false, has_stack_params: false });
    assert needs_frame(FrameFacts { has_call: false, saves_callee: true, has_var_slots: false, has_temp_slots: false, has_agg: false, uses_lr: false, has_stack_params: false });
    assert needs_frame(FrameFacts { has_call: false, saves_callee: false, has_var_slots: true, has_temp_slots: false, has_agg: false, uses_lr: false, has_stack_params: false });
    assert needs_frame(FrameFacts { has_call: false, saves_callee: false, has_var_slots: false, has_temp_slots: true, has_agg: false, uses_lr: false, has_stack_params: false });
    assert needs_frame(FrameFacts { has_call: false, saves_callee: false, has_var_slots: false, has_temp_slots: false, has_agg: true, uses_lr: false, has_stack_params: false });
    assert needs_frame(FrameFacts { has_call: false, saves_callee: false, has_var_slots: false, has_temp_slots: false, has_agg: false, uses_lr: true, has_stack_params: false });
    assert needs_frame(FrameFacts { has_call: false, saves_callee: false, has_var_slots: false, has_temp_slots: false, has_agg: false, uses_lr: false, has_stack_params: true });
}
test the_probe_law_walks_whole_pages_and_a_touched_rest {
    assert needs_probe(MAX_UNPROBED_FRAME) == false;
    assert needs_probe(MAX_UNPROBED_FRAME + 1);
    assert probe_pages(MAX_UNPROBED_FRAME + 1) == 4;
    assert probe_rest(MAX_UNPROBED_FRAME + 1) == 1;
    assert probe_pages(20480) == 5;
    assert probe_rest(20480) == 0;
    assert probe_pages(65536) == 16;
    assert probe_rest(65536) == 0;
    assert probe_pages(16385) == 4;
    assert probe_rest(16385) == 1;
}
test the_aggregate_budget_is_two_sub_words_below_x29 {
    // a64.t27 sub_const: SUB_CONST_REACH (16777216) - 16.
    assert MAX_AGG_BYTES == 16777200;
    assert MAX_AGG_BYTES > MAX_SLOT_BYTES;
}
