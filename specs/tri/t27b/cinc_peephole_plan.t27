// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/cinc_peephole_plan.t27 -- cset + add -> cinc peephole for the bench_audit hot loop (Refs #12871).
; (cinc peephole) When the last instruction emitted is `cset rd, cond` (csinc rd, ZR, ZR, invert(cond))
; and the current is `add x, x, rd` (AddW, sf=true, d==rx, ry==rd, rd not ZR), replace both with
; `csinc x, x, x, invert(cond)` (= cinc x, x, cond). Sound: cset gives 0 or 1; add x,x,rd adds 0 or 1;
; cinc x,x,cond increments x iff cond -- identical result. Rd must not alias x (rd != rx) so the cset
; value is fresh. This module exposes one decision fn; the glue in cli/t27b/src/codegen.rs collects
; the structural facts and applies the rewrite. Gen: gen/rust/tri/t27b/cinc_peephole_plan.rs.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bCincPeepholePlan;

/// Whether the cset + add pair may be rewritten as cinc.
/// sf: the add is 64-bit (x registers). op_is_addw: the add is AddW (plain, not checked).
/// d_eq_rx: add destination equals the left operand (accumulator form). ry_is_cset: the add's right
/// operand came directly from a cset. cset_sf: the cset is 64-bit. rd_ne_rx: the cset destination
/// does not alias the accumulator (the cset value is fresh).
pub fn cinc_ok(sf: bool, op_is_addw: bool, d_eq_rx: bool, ry_is_cset: bool, cset_sf: bool, rd_ne_rx: bool) -> bool {
    return sf && op_is_addw && d_eq_rx && ry_is_cset && cset_sf && rd_ne_rx;
}

// ----------------------------------------------------------------------------------------------------------
// Tests
// ----------------------------------------------------------------------------------------------------------

test accept_all_true {
    assert(cinc_ok(true, true, true, true, true, true));
}

test refuse_sf_false {
    assert(!cinc_ok(false, true, true, true, true, true));
}

test refuse_op_is_adds {
    // checked add (AddW = false when checked=true means op_is_addw=false)
    assert(!cinc_ok(true, false, true, true, true, true));
}

test refuse_d_ne_rx {
    // destination does not equal left operand
    assert(!cinc_ok(true, true, false, true, true, true));
}

test refuse_ry_not_cset {
    // right operand was not from a cset
    assert(!cinc_ok(true, true, true, false, true, true));
}

test refuse_rd_eq_rx {
    // cset target aliases the accumulator
    assert(!cinc_ok(true, true, true, true, true, false));
}

test refuse_cset_sf_false {
    // cset was 32-bit
    assert(!cinc_ok(true, true, true, true, false, true));
}
