// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/licm_body_const_plan.t27 -- Safety predicate for LICM body-constant hoisting
; Extends loop_limits (codegen.rs) to collect loop-invariant constants from loop BODY Assign
; statements, not just from While conditions.
; Witness shape: bench_audit `movz tmp2, #1000` inside the while loop body --
;   the constant 1000 is used in `csel cur_prev, tmp2, tmp, hs` and never changed in the loop.
; Planned implementation: extend cli/t27b/src/codegen.rs fn loop_limits() to also walk
;   Stmt::Assign rhs for ExprKind::Const values that appear in the loop body.
; Gen: (no generated output -- this spec is documentation only)
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY
; Refs #13421 #12871

module T27bLicmBodyConstPlan;

; AArch64 shape (before -- movz inside loop body):
;   loop_top:
;     ...
;     movz  tmp2, #1000       ; loop-invariant: emitted every iteration
;     csel  cur_prev, tmp2, tmp, hs
;     subs  cnt, cnt, #1
;     b.ne  loop_top
; 
; AArch64 shape (after -- movz hoisted before loop):
;     movz  r1000, #1000       ; once, in function prologue (hoist list)
;   loop_top:
;     ...
;     csel  cur_prev, r1000, tmp, hs  ; r1000 already live
;     subs  cnt, cnt, #1
;     b.ne  loop_top
; 
; Net saving: 1 word per loop iteration for each hoistable body constant.
; Implementation: extend loop_limits(ss, out) to match Stmt::Assign with
;   ExprKind::Const on the rhs, subject to the safety conditions below.
; --

; Whether a constant in a loop body Assign is safe to hoist before the loop.
; 
; Parameters:
;   const_is_pure       : the value is a compile-time constant (not an env var or call)
;   not_mutated_in_loop : no Assign in the loop body changes the value of the constant
;                         (trivially true for numeric literals; must check for named consts)
;   no_side_effect_on_hoist : hoisting the constant emit does not change program semantics
;                              (always true for movz/movk of an immediate)
;   register_available  : the codegen allocator has a register to hold the hoisted value
;                         without spilling (conservative: only hoist when depth < threshold)
pub fn licm_body_const_ok(
    const_is_pure: bool,
    not_mutated_in_loop: bool,
    no_side_effect_on_hoist: bool,
    register_available: bool
) -> bool {
    if (!const_is_pure) { return false; }
    if (!not_mutated_in_loop) { return false; }
    if (!no_side_effect_on_hoist) { return false; }
    if (!register_available) { return false; }
    return true;
}

; ---- tests ----

test licm_body_const_accepts_bench_audit_1000 {
    ; `movz tmp2, #1000` inside the loop body: pure literal, never reassigned in loop,
    ; no side effect to hoist a movz, and a spare register is available.
    assert(licm_body_const_ok(true, true, true, true));
}

test licm_body_const_refuses_impure_const {
    ; A value that depends on a function call is not a compile-time constant.
    assert(!licm_body_const_ok(false, true, true, true));
}

test licm_body_const_refuses_mutated_const {
    ; If the loop body re-assigns the variable holding the constant, the hoist is wrong.
    assert(!licm_body_const_ok(true, false, true, true));
}

test licm_body_const_refuses_no_register {
    ; When the register pressure is too high, do not hoist (spill cost > loop iteration gain).
    assert(!licm_body_const_ok(true, true, true, false));
}
