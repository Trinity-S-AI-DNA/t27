// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/zig_struct_head.t27 -- the head and the close of a rendered
; Zig struct declaration (gHashTag/t27#11912, the wasm32 audit epic #11840).
; A parameterised const struct (`pub const Box(T) = struct { .. }`) is a GENERIC
; type: Zig has no generic structs, and the idiom is a function returning the
; struct with each parameter a comptime type -- the call sites (`Box(u8)`)
; already render as calls, so they compose unchanged. A plain const struct
; keeps the const form. The params arrive newline-joined (one name per line);
; the fns write into a caller buffer at an offset and return the new offset --
; the verbs.t27 contract. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bZigStructHead;

use tri::trigit::verbs::put_s;

pub const GENERIC_TAIL : str = "    };\n}";
pub const PLAIN_TAIL : str = "};";

/// A params list is generic when at least one parameter name is present.
pub fn is_generic(params: []const u8) -> bool {
    return params.len > 0;
}

fn is_nl(b: u8) -> bool { return b == 10; }

/// The declaration head into out at at: `fn <name>(comptime p: type, ..)
/// type {\n    return struct {\n` for a generic one, `const <name> = struct {\n`
/// for a plain one. The baked indentation matches one indent level.
pub fn struct_head(out: []u8, at: usize, cap: usize, name: []const u8, params: []const u8) -> usize {
    var n : usize = at;
    if is_generic(params) {
        n = put_s(out, n, cap, "fn ");
        n = put_s(out, n, cap, name);
        n = put_s(out, n, cap, "(comptime ");
        var i : usize = 0;
        var first : bool = true;
        while (i < params.len) {
            var j : usize = i;
            while (j < params.len and is_nl(params[j]) == false) { j = j + 1; }
            if first == false { n = put_s(out, n, cap, ", comptime "); }
            n = put_s(out, n, cap, params[i..j]);
            n = put_s(out, n, cap, ": type");
            first = false;
            i = j + 1;
        }
        n = put_s(out, n, cap, ") type {\n    return struct {\n");
        return n;
    }
    n = put_s(out, n, cap, "const ");
    n = put_s(out, n, cap, name);
    n = put_s(out, n, cap, " = struct {\n");
    return n;
}

/// The declaration close: the struct's `};` and, for a generic one, the
/// function's `}` -- the indentation baked to match the head.
pub fn struct_tail(params: []const u8) -> []const u8 {
    if is_generic(params) { return GENERIC_TAIL; }
    return PLAIN_TAIL;
}

test generic_head_wraps_the_name_in_a_comptime_fn {
    var buf : [128]u8 = undefined;
    const n : usize = struct_head(buf[0..128], 0, 128, "Box", "T");
    const want : str = "fn Box(comptime T: type) type {\n    return struct {\n";
    assert n == want.len;
    var i : usize = 0;
    var same : bool = true;
    while (i < n) { if (buf[i] != @as(u8, want[i])) { same = false; } i = i + 1; }
    assert same;
}

test two_parameters_join_with_comma_space {
    var buf : [128]u8 = undefined;
    const n : usize = struct_head(buf[0..128], 0, 128, "Pair", "K\nV");
    const want : str = "fn Pair(comptime K: type, comptime V: type) type {\n    return struct {\n";
    assert n == want.len;
    var i : usize = 0;
    var same : bool = true;
    while (i < n) { if (buf[i] != @as(u8, want[i])) { same = false; } i = i + 1; }
    assert same;
}

test plain_head_is_the_const_form_and_the_tail_matches {
    var buf : [128]u8 = undefined;
    assert struct_head(buf[0..128], 0, 128, "Plain", "") == 23;
    var i : usize = 0;
    var same : bool = true;
    const want : str = "const Plain = struct {\n";
    while (i < 23) { if (buf[i] != @as(u8, want[i])) { same = false; } i = i + 1; }
    assert same;
    assert struct_tail("") == "};";
    assert struct_tail("T") == "    };\n}";
}
