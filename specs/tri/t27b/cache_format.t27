// SPDX-License-Identifier: Apache-2.0
// specs/tri/t27b/cache_format.t27 -- the pure formatting decisions of one
// reference-cache row and one Reference verdict, ported from
// cli/t27b/src/blockers.rs so the hand-written Rust only does I/O.
//
// Everything here is a PURE function over byte arrays; no file access, no
// process, no allocation of the caller's buffers beyond what the caller hands
// in. The tag constants mirror the `Reference` enum discriminants in
// blockers.rs (Pass=0, Blocked=1, Fail=2, Timeout=3); the Rust glue maps the
// enum to these bytes.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27bCacheFormat;

pub const TAG_PASS : u8 = 0;
pub const TAG_BLOCKED : u8 = 1;
pub const TAG_FAIL : u8 = 2;
pub const TAG_TIMEOUT : u8 = 3;

/// A timeout verdict is never cached (#6443): it says how busy the machine
/// was, not what the spec does.
pub fn cacheable(tag: u8) -> bool {
    return tag != TAG_TIMEOUT;
}

/// Only a Pass counts as passing.
pub fn passes(tag: u8) -> bool {
    return tag == TAG_PASS;
}

fn is_esc(src: []const u8, i: usize, a: u8, b: u8, c: u8) -> bool {
    if (i + 2 >= src.len) { return false; }
    if (src[i] != a) { return false; }
    if (src[i + 1] != b) { return false; }
    if (src[i + 2] != c) { return false; }
    return true;
}

/// The inverse of text_escape's name escaping, byte-identical to the old
/// Rust `n.replace("%3B", ";").replace("%09", "\t").replace("%0A", "\n")
/// .replace("%0D", "\r").replace("%25", "%")`. The specific codes are
/// decoded before %25 so a percent that was itself escaped is never
/// double-decoded. Returns the number of bytes written to `out`.
pub fn unescape_name(src: []const u8, out: []u8) -> usize {
    var o : usize = 0;
    var i : usize = 0;
    while (i < src.len) {
        if (is_esc(src, i, 37, 51, 66)) { out[o] = 59; i = i + 3; }
        else if (is_esc(src, i, 37, 48, 57)) { out[o] = 9; i = i + 3; }
        else if (is_esc(src, i, 37, 48, 65)) { out[o] = 10; i = i + 3; }
        else if (is_esc(src, i, 37, 48, 68)) { out[o] = 13; i = i + 3; }
        else if (is_esc(src, i, 37, 50, 53)) { out[o] = 37; i = i + 3; }
        else { out[o] = src[i]; i = i + 1; }
        o = o + 1;
    }
    return o;
}

test cacheable_timeout_is_false_and_the_rest_are_true {
    assert cacheable(TAG_TIMEOUT) == false;
    assert cacheable(TAG_PASS);
    assert cacheable(TAG_BLOCKED);
    assert cacheable(TAG_FAIL);
}

test passes_is_exactly_pass {
    assert passes(TAG_PASS);
    assert passes(TAG_BLOCKED) == false;
    assert passes(TAG_FAIL) == false;
    assert passes(TAG_TIMEOUT) == false;
}

test unescape_name_round_trips_the_escape_alphabet {
    var out : [64]u8 = undefined;
    var n : usize = unescape_name("%3B%09%0A%0D%25", out[0..]);
    assert n == 5;
    assert out[0] == 59; assert out[1] == 9; assert out[2] == 10; assert out[3] == 13; assert out[4] == 37;
}

test unescape_name_is_identity_for_safe_names {
    var out : [64]u8 = undefined;
    const n : usize = unescape_name("axi4_tb", out[0..]);
    assert n == 7;
    assert same(out[0..n], "axi4_tb");
}

test unescape_name_never_double_decodes_a_percent {
    // "%253B" must become "%3B" (the % is unescaped last), not ";".
    var out : [64]u8 = undefined;
    const n : usize = unescape_name("%253B", out[0..]);
    assert n == 3;
    assert same(out[0..n], "%3B");
}

fn same(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}
