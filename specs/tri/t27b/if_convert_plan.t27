// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/if_convert_plan.t27 -- Safety predicate for AArch64 if-conversion
; Converts `if (c) { x = a; y = b; } else { y = d; }` → `cmp; csel x; csel y`, saving 2 words.
; Witness shape: bench_audit `if (cur_tick > 1000) { cur_tick=0; cur_prev=1000; } else { cur_prev=cur_tick-1; }`.
; Refused today: requires CFG-level analysis not yet present in lower.rs --
;   (i) pre-computing both branch outputs before the cmp, and
;   (ii) detecting that neither branch has memory writes or calls (side-effect-free).
; The glue in cli/t27b/src/lower.rs calls this module once per If node; it decides nothing.
; Gen: gen/rust/tri/t27b/if_convert_plan.rs
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY
; Refs #13421 #12871

module T27bIfConvertPlan;

; AArch64 shape (before -- 7 words for the bench_audit pattern):
;   cmp  cur_tick, #1001
;   b.lo else_label
;   movz cur_tick, #0
;   movz cur_prev, #1000
;   b    end_label
;   sub  cur_prev, cur_tick, #1    ; else branch
;
; AArch64 shape (after -- 5 words):
;   sub  tmp, cur_tick, #1         ; pre-compute else output for cur_prev
;   cmp  cur_tick, #1001
;   csel cur_tick, xzr, cur_tick, hs
;   movz tmp2, #1000
;   csel cur_prev, tmp2, tmp, hs
;
; Net saving: 2 words per converted if-then-else.
; Implementation prerequisite: SSA-style pre-computation inserted before the branch,
; live-variable analysis to find which variables are live across the branch.
; --

; Whether the if-then-else block satisfies the safety conditions for if-conversion.
;
; Parameters:
;   both_sides_assign_same_set : every lhs in the true branch also appears (or is dead) in the else branch
;   side_effect_free           : neither branch contains a function call or memory write
;   single_assign_per_var      : each variable appears on the lhs at most once in each branch
;   no_cross_read              : the else branch does not read a variable that the true branch writes
;                                before the read (SSA safe; pre-computation can be hoisted)
;   no_loop_carry              : the assigned variables are not carried across a loop back-edge
;                                from outside this if (prevents incorrect if-conversion inside a loop
;                                when the else path would observe a stale pre-computed value)
pub fn if_convert_ok(
    both_sides_assign_same_set: bool,
    side_effect_free: bool,
    single_assign_per_var: bool,
    no_cross_read: bool,
    no_loop_carry: bool
) -> bool {
    if (!side_effect_free) { return false; }
    if (!both_sides_assign_same_set) { return false; }
    if (!single_assign_per_var) { return false; }
    if (!no_cross_read) { return false; }
    if (!no_loop_carry) { return false; }
    return true;
}

; ---- tests ----

test if_convert_accepts_bench_audit_pattern {
    ; cur_tick > 1000: both sides assign cur_prev; true side also assigns cur_tick.
    ; cur_tick is dead on the else path (else doesn't read the pre-cmp cur_tick after the cmp --
    ; the sub is hoisted before the cmp, so no_cross_read holds).
    assert(if_convert_ok(true, true, true, true, true));
}

test if_convert_refuses_call_in_branch {
    ; A function call in either branch may have observable side effects.
    assert(!if_convert_ok(true, false, true, true, true));
}

test if_convert_refuses_unmatched_lhs_set {
    ; If the true branch writes x and the else branch does not, the csel for x
    ; must supply the else value -- but if x is not known live-out, it is unsafe to guess.
    assert(!if_convert_ok(false, true, true, true, true));
}

test if_convert_refuses_double_assign_in_branch {
    ; e.g., `x = f(); x = x + 1;` in the true arm -- two csel cannot model this.
    assert(!if_convert_ok(true, true, false, true, true));
}

test if_convert_refuses_cross_read {
    ; true branch writes x, else branch reads x (original) and writes y = x - 1.
    ; Pre-computing y before the cmp is incorrect once x is overwritten by the csel.
    assert(!if_convert_ok(true, true, true, false, true));
}

test if_convert_refuses_loop_carry {
    ; If the variable assigned in the if is a loop-carried value that feeds the
    ; next iteration's condition, the pre-computation must not cross the back-edge.
    assert(!if_convert_ok(true, true, true, true, false));
}
