// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/verilog_plan.t27 -- the typed-local slice of the t27b Verilog path plan (issue #8812,
; under the self-host epic #5980). The Verilog path itself is #8796 (upstream PR #8820 carries its full
; plan); this file holds the slice of its decisions that issue #8812 unblocks, and pins the gen-rust
; emission rules cli/t27b may rely on. Everything on this path reaches cli/t27b only through
; `t27c gen-rust`, and two defects in that emitter degraded the typed locals of exactly this path:
; a `[]const u8` local was typed `&'static str` instead of `&[u8]`, so a slice could not bind to it
; and it mismatched every `&[u8]` that expected it; and a widening local (`u8` into `usize`) was
; emitted without its cast. Upstream works around both: it never binds a sliced byte range to a local
; and writes `k as usize` by hand. This branch fixes the emitter instead (bootstrap/src/compiler.rs,
; outside this file's boundary, named here for the record), so this file uses the constructs directly
; and carries no workaround.
; --
; Decisions, as t27 source for cli/t27b:
; - A typed `[]const u8` local is emitted `&[u8]`, by the same rule as `[]const u8` parameters: in a
;   file that slices bytes, the type map carries the local as bytes and both emission copies (gen_fn
;   and gen_rust_stmt; a fix applied to only one of the two is not applied) write `&[u8]`. A string
;   literal bound to such a local is written as a byte literal `b"..."`, and a byte range
;   `s[a .. b]` over a `[]const u8` is written `&s[(a) as usize .. (b) as usize]`, so it binds.
; - A local whose declared type is wider than its initializer's (a `u8` read into a `usize`) is
;   emitted with the explicit cast, `k as usize`; the source writes the widening plain and the
;   emitter carries it.
; - These rules are pinned by the code and tests below, which use no workaround: the byte-slice
;   local, the byte-literal local and the widening local all appear as written.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bVerilogPlan;

// ----------------------------------------------------------------------------------------------------------
// The #8812 slice: typed locals reach cli/t27b compiled and correct. Each function exercises one of
// the two fixed emission rules on the constructs cli/t27b's glue uses (kind labels keyed by a u8 node
// kind; header tags sliced out of a byte buffer).
// ----------------------------------------------------------------------------------------------------------

/// The kind label for node kind k, widened at the source level: the source writes `k` into a
/// `usize` local and gen-rust emits `k as usize` (#8812, defect 2).
pub fn label_of(k: u8) -> str {
    const ki : usize = k;
    if (ki == 0) { return "module"; }
    if (ki == 1) { return "use"; }
    if (ki == 2) { return "const"; }
    return "node";
}

/// The first n bytes of a spec header, bound to a typed local: gen-rust types the local `&[u8]`
/// (#8812, defect 1), so the range binds and the result flows to other `&[u8]` takers.
pub fn head_of(s: []const u8, n: usize) -> []const u8 {
    const head : []const u8 = s[0 .. n];
    return head;
}

/// A byte-literal local: a string literal bound to a typed `[]const u8` local is written
/// `b"T27B"` and typed `&[u8]` (#8812, defect 1).
pub fn tag() -> []const u8 {
    const tag : []const u8 = "T27B";
    return tag;
}

/// A tag check over sliced locals: both the literal local and the slice local are `&[u8]`,
/// and the widening of the index bound is emitted as a cast.
pub fn tag_is(s: []const u8) -> bool {
    const tag : []const u8 = "T27B";
    const head : []const u8 = s[0 .. 4];
    return head == tag;
}

// ----------------------------------------------------------------------------------------------------------
// Refusals. One per fixed defect, so a regression in the emitter is named by the path that breaks.
// ----------------------------------------------------------------------------------------------------------

pub const WHAT_NO_STR_BACKING : str = "typed []const u8 locals";
pub const WHY_NO_STR_BACKING : str = "#8812: gen-rust emitted &'static str for them; it now types them &[u8]";

pub const WHAT_NO_UNCAST_WIDENING : str = "widening typed locals";
pub const WHY_NO_UNCAST_WIDENING : str = "#8812: gen-rust left the widening uncast; it now writes k as usize";

pub fn what_no_str_backing() -> str {
    return WHAT_NO_STR_BACKING;
}

pub fn why_no_str_backing() -> str {
    return WHY_NO_STR_BACKING;
}

pub fn what_no_uncast_widening() -> str {
    return WHAT_NO_UNCAST_WIDENING;
}

pub fn why_no_uncast_widening() -> str {
    return WHY_NO_UNCAST_WIDENING;
}

// ----------------------------------------------------------------------------------------------------------
// Tests. Each assert compiles only when the corresponding emission rule holds: the byte locals bind
// and compare as `&[u8]`, and the widened index reaches the slice as `usize`.
// ----------------------------------------------------------------------------------------------------------

test typed_slice_local {
    assert(head_of("T27B", 4) == "T27B");
    assert(head_of("T27B", 2) == "T2");
    assert(tag() == "T27B");
    assert(tag_is("T27B"));
    assert(!tag_is("T27C"));
}

test typed_widening_local {
    assert(label_of(0) == "module");
    assert(label_of(2) == "const");
    assert(label_of(255) == "node");
}
