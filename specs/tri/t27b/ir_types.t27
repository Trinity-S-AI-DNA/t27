// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/ir_types.t27 -- the type table of the t27b IR (ladder step 5
; of #13132). A `Ty` value reaches this law as a KIND code: bool=0, u8=1,
; u16=2, u32=3, u64=4, i8=5, i16=6, i32=7, i64=8, ptr=9, f32=10, f64=11,
; i128=12, an odd unsigned 100+n, an odd signed 200+n (`usize` lowers to u64
; and `isize` to i64 before it gets here). An odd kind always travels with its
; own width n, and the parser (cli/t27b/src/ir.rs `odd_width`) admits only
; 1..=31 except 8 and 16 -- those are the plain u8/u16/i8/i16 kinds. The
; facts the table owns:
; * bits: the memory width, what a load or store of the type moves. A bool is
;   8 (stored as a 0/1 byte value), a ptr is 64 (a 64-bit address into a frame
;   slot or the read-only data image -- never a value of the language: the
;   lowering makes it for aggregates, passes it as a hidden parameter, and
;   only ever offsets and loads it), an i128 is 128, and an odd uN/iN is n.
; * signed: the i-kinds and i128; a ptr is not signed, a bool is not.
; * is64: the value occupies a full 64-bit X register (bits == 64).
; * is_float: f32 and f64 only -- IEEE-754, a value carried as its bit
;   pattern (the whole X register for f64, canonical zero-extended like a u32
;   for f32), arithmetic in D/S registers, AAPCS64 in d0-d7 / s0-s7.
; * is_int: everything but bool, ptr, f32, f64 (i128 included).
; * is_odd: the odd uN/iN only -- no 8/16-bit load or extend instruction is
;   exactly their canonical form (uN zero-extended, iN sign-extended in its W
;   register, stored in the bytes Zig gives it, `@sizeOf(u21) == 4`).
; * name: the spelling each kind prints under, from the same table
;   `from_name` parses.
; The consumer (cli/t27b/src/ir.rs) keeps only the kind mapping (`fn law`);
; every method here is a one-line call into this generated module. The f64 /
; f32 bit-pattern helpers and the min/max/fits/wrap bounds stay their own
; laws (eval_arith.t27); this spec is the table.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bIrTypes;

/// The base of an odd unsigned kind (100 + n, n in 1..=31 except 8 and 16).
pub const ODD_UNSIGNED : u32 = 100;
/// The base of an odd signed kind (200 + n, n in 1..=31 except 8 and 16).
pub const ODD_SIGNED : u32 = 200;

/// Memory width in bits: a load or store of the type moves this many bytes'
/// worth. A bool reports 8 (it is stored as a 0/1 byte value), a ptr 64, an
/// i128 128, an odd uN/iN its own n.
pub fn ty_bits(kind: u32, n: u32) -> u32 {
    if (kind == 0) { return 8; }
    if (kind == 1 or kind == 5) { return 8; }
    if (kind == 2 or kind == 6) { return 16; }
    if (kind == 3 or kind == 7 or kind == 10) { return 32; }
    if (kind == 4 or kind == 8 or kind == 9 or kind == 11) { return 64; }
    if (kind == 12) { return 128; }
    if (kind >= ODD_UNSIGNED and kind < ODD_SIGNED) { return n; }
    if (kind >= ODD_SIGNED) { return n; }
    return 0;
}

/// The type is signed: i8, i16, i32, i64, an odd iN, i128. A ptr is not.
pub fn ty_signed(kind: u32) -> bool {
    if (kind == 5) { return true; }
    if (kind == 6) { return true; }
    if (kind == 7) { return true; }
    if (kind == 8) { return true; }
    if (kind == 12) { return true; }
    if (kind >= ODD_SIGNED) { return true; }
    return false;
}

/// True when the value occupies a full 64-bit X register (bits == 64): u64,
/// i64, ptr, f64.
pub fn ty_is64(kind: u32) -> bool {
    if (kind == 4) { return true; }
    if (kind == 8) { return true; }
    if (kind == 9) { return true; }
    if (kind == 11) { return true; }
    return false;
}

/// The type is IEEE-754 floating point: f32 or f64.
pub fn ty_is_float(kind: u32) -> bool {
    if (kind == 10) { return true; }
    if (kind == 11) { return true; }
    return false;
}

/// The type is an integer: everything but bool, ptr, f32, f64 (i128 and the
/// odd uN/iN included).
pub fn ty_is_int(kind: u32) -> bool {
    if (kind == 0) { return false; }
    if (kind == 9) { return false; }
    if (kind == 10) { return false; }
    if (kind == 11) { return false; }
    return true;
}

/// An odd width (uN / iN, 1..=31 except 8 and 16): no 8/16-bit load or extend
/// instruction is exactly its canonical form.
pub fn ty_is_odd(kind: u32) -> bool {
    return kind >= ODD_UNSIGNED;
}

/// The spelling of the type, the same words `from_name` parses.
pub fn ty_name(kind: u32, n: u32) -> str {
    if (kind == 0) { return "bool"; }
    if (kind == 1) { return "u8"; }
    if (kind == 2) { return "u16"; }
    if (kind == 3) { return "u32"; }
    if (kind == 4) { return "u64"; }
    if (kind == 5) { return "i8"; }
    if (kind == 6) { return "i16"; }
    if (kind == 7) { return "i32"; }
    if (kind == 8) { return "i64"; }
    if (kind == 9) { return "ptr"; }
    if (kind == 10) { return "f32"; }
    if (kind == 11) { return "f64"; }
    if (kind == 12) { return "i128"; }
    if (kind < ODD_SIGNED) { return odd_name(false, n); }
    return odd_name(true, n);
}

/// `uN` / `iN` spelled out, for every odd width the parser admits.
fn odd_name(signed: bool, n: u32) -> str {
    if (n == 1) { if (signed) { return "i1"; } return "u1"; }
    if (n == 2) { if (signed) { return "i2"; } return "u2"; }
    if (n == 3) { if (signed) { return "i3"; } return "u3"; }
    if (n == 4) { if (signed) { return "i4"; } return "u4"; }
    if (n == 5) { if (signed) { return "i5"; } return "u5"; }
    if (n == 6) { if (signed) { return "i6"; } return "u6"; }
    if (n == 7) { if (signed) { return "i7"; } return "u7"; }
    if (n == 9) { if (signed) { return "i9"; } return "u9"; }
    if (n == 10) { if (signed) { return "i10"; } return "u10"; }
    if (n == 11) { if (signed) { return "i11"; } return "u11"; }
    if (n == 12) { if (signed) { return "i12"; } return "u12"; }
    if (n == 13) { if (signed) { return "i13"; } return "u13"; }
    if (n == 14) { if (signed) { return "i14"; } return "u14"; }
    if (n == 15) { if (signed) { return "i15"; } return "u15"; }
    if (n == 17) { if (signed) { return "i17"; } return "u17"; }
    if (n == 18) { if (signed) { return "i18"; } return "u18"; }
    if (n == 19) { if (signed) { return "i19"; } return "u19"; }
    if (n == 20) { if (signed) { return "i20"; } return "u20"; }
    if (n == 21) { if (signed) { return "i21"; } return "u21"; }
    if (n == 22) { if (signed) { return "i22"; } return "u22"; }
    if (n == 23) { if (signed) { return "i23"; } return "u23"; }
    if (n == 24) { if (signed) { return "i24"; } return "u24"; }
    if (n == 25) { if (signed) { return "i25"; } return "u25"; }
    if (n == 26) { if (signed) { return "i26"; } return "u26"; }
    if (n == 27) { if (signed) { return "i27"; } return "u27"; }
    if (n == 28) { if (signed) { return "i28"; } return "u28"; }
    if (n == 29) { if (signed) { return "i29"; } return "u29"; }
    if (n == 30) { if (signed) { return "i30"; } return "u30"; }
    if (n == 31) { if (signed) { return "i31"; } return "u31"; }
    return "u?";
}

// ----------------------------------------------------------------------------------------------------------
// Tests: every arm of the Rust table, mirrored. The kind codes 1..=12 stand
// for u8..i128 in order; an odd kind is always exercised with its matching n.
// ----------------------------------------------------------------------------------------------------------

test the_fixed_kinds_report_their_memory_width {
    assert ty_bits(0, 0) == 8;
    assert ty_bits(1, 0) == 8;
    assert ty_bits(5, 0) == 8;
    assert ty_bits(2, 0) == 16;
    assert ty_bits(6, 0) == 16;
    assert ty_bits(3, 0) == 32;
    assert ty_bits(7, 0) == 32;
    assert ty_bits(10, 0) == 32;
    assert ty_bits(4, 0) == 64;
    assert ty_bits(8, 0) == 64;
    assert ty_bits(9, 0) == 64;
    assert ty_bits(11, 0) == 64;
    assert ty_bits(12, 0) == 128;
    assert ty_bits(99, 0) == 0;
}

test a_ptr_is_signed_like_nothing_and_the_i_kinds_are_signed {
    assert ty_signed(5);
    assert ty_signed(6);
    assert ty_signed(7);
    assert ty_signed(8);
    assert ty_signed(12);
    assert ty_signed(0) == false;
    assert ty_signed(1) == false;
    assert ty_signed(2) == false;
    assert ty_signed(3) == false;
    assert ty_signed(4) == false;
    assert ty_signed(9) == false;
    assert ty_signed(10) == false;
    assert ty_signed(11) == false;
}

test is64_means_a_full_x_register_and_f32_stays_in_a_w {
    assert ty_is64(4);
    assert ty_is64(8);
    assert ty_is64(9);
    assert ty_is64(11);
    assert ty_is64(0) == false;
    assert ty_is64(1) == false;
    assert ty_is64(2) == false;
    assert ty_is64(3) == false;
    assert ty_is64(5) == false;
    assert ty_is64(6) == false;
    assert ty_is64(7) == false;
    assert ty_is64(10) == false;
    assert ty_is64(12) == false;
}

test only_f32_and_f64_are_floats_and_i128_is_an_int {
    assert ty_is_float(10);
    assert ty_is_float(11);
    assert ty_is_float(0) == false;
    assert ty_is_float(9) == false;
    assert ty_is_float(12) == false;
    assert ty_is_int(0) == false;
    assert ty_is_int(9) == false;
    assert ty_is_int(10) == false;
    assert ty_is_int(11) == false;
    assert ty_is_int(1);
    assert ty_is_int(2);
    assert ty_is_int(3);
    assert ty_is_int(4);
    assert ty_is_int(5);
    assert ty_is_int(6);
    assert ty_is_int(7);
    assert ty_is_int(8);
    assert ty_is_int(12);
}

test only_the_odd_u_n_and_i_n_kinds_are_odd {
    assert ty_is_odd(ODD_UNSIGNED + 1);
    assert ty_is_odd(ODD_UNSIGNED + 21);
    assert ty_is_odd(ODD_SIGNED + 1);
    assert ty_is_odd(ODD_SIGNED + 31);
    assert ty_is_odd(0) == false;
    assert ty_is_odd(1) == false;
    assert ty_is_odd(4) == false;
    assert ty_is_odd(9) == false;
    assert ty_is_odd(12) == false;
}

test every_odd_width_reports_its_own_bits_and_class {
    var n : u32 = 1;
    while (n <= 31) {
        if (n != 8 and n != 16) {
            assert ty_bits(ODD_UNSIGNED + n, n) == n;
            assert ty_bits(ODD_SIGNED + n, n) == n;
            assert ty_is_odd(ODD_UNSIGNED + n);
            assert ty_is_odd(ODD_SIGNED + n);
            assert ty_is64(ODD_UNSIGNED + n) == false;
            assert ty_is64(ODD_SIGNED + n) == false;
            assert ty_is_float(ODD_UNSIGNED + n) == false;
            assert ty_is_float(ODD_SIGNED + n) == false;
            assert ty_is_int(ODD_UNSIGNED + n);
            assert ty_is_int(ODD_SIGNED + n);
            assert ty_signed(ODD_UNSIGNED + n) == false;
            assert ty_signed(ODD_SIGNED + n);
        }
        n = n + 1;
    }
}

test the_fixed_kinds_spell_their_names {
    assert std.mem.eql(u8, ty_name(0, 0), "bool");
    assert std.mem.eql(u8, ty_name(1, 0), "u8");
    assert std.mem.eql(u8, ty_name(2, 0), "u16");
    assert std.mem.eql(u8, ty_name(3, 0), "u32");
    assert std.mem.eql(u8, ty_name(4, 0), "u64");
    assert std.mem.eql(u8, ty_name(5, 0), "i8");
    assert std.mem.eql(u8, ty_name(6, 0), "i16");
    assert std.mem.eql(u8, ty_name(7, 0), "i32");
    assert std.mem.eql(u8, ty_name(8, 0), "i64");
    assert std.mem.eql(u8, ty_name(9, 0), "ptr");
    assert std.mem.eql(u8, ty_name(10, 0), "f32");
    assert std.mem.eql(u8, ty_name(11, 0), "f64");
    assert std.mem.eql(u8, ty_name(12, 0), "i128");
}

test every_odd_width_spells_its_name {
    var n : u32 = 1;
    while (n <= 31) {
        if (n != 8 and n != 16) {
            assert std.mem.eql(u8, ty_name(ODD_UNSIGNED + n, n), odd_name(false, n));
            assert std.mem.eql(u8, ty_name(ODD_SIGNED + n, n), odd_name(true, n));
        }
        n = n + 1;
    }
    assert std.mem.eql(u8, ty_name(ODD_UNSIGNED + 21, 21), "u21");
    assert std.mem.eql(u8, ty_name(ODD_SIGNED + 4, 4), "i4");
    assert std.mem.eql(u8, ty_name(ODD_UNSIGNED + 31, 31), "u31");
    assert std.mem.eql(u8, ty_name(ODD_SIGNED + 30, 30), "i30");
}
