// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/home_plan.t27 -- which home a variable takes in t27b's frame
; plan (cli/t27b/src/codegen.rs assign_homes; port epic #6198). Drafted as the
; rehearsal of the deletion-credits entry HOME_PLAN_LEAF (issue #13132).
; --
; The pools, in the order the plan takes them. A leaf fn (no call) keeps its
; parameters in their argument registers and homes the rest into the free
; argument registers nint..8 first, then the callee-saved registers, then the
; frame slots. A fn with a call skips the caller pool: its argument registers
; die at the call, so every home comes from the callee-saved registers and the
; slots. A parameter whose argument register is a home on its own (an integer
; in x0-x7, never an i128 pair) is already homed and takes nothing.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bHomePlan;

/// The kind of a home, packed in the high word of next_home's verdict.
pub const HOME_CALLER : u64 = 0;
pub const HOME_CALLEE : u64 = 1;
pub const HOME_SLOT : u64 = 2;

/// True when an argument register is its parameter's home on its own.
pub fn param_keeps_arg_reg(is_fp: bool, k: u64, is_i128: bool) -> bool {
    return !is_fp and k < 8 and !is_i128;
}

/// The caller pool (the free argument registers nint..8) is not empty yet.
pub fn caller_pool_has(nint: u64, taken: u64) -> bool {
    return (nint + taken) < 8;
}

/// The callee-saved pool is not empty yet.
pub fn callee_pool_has(len: u64, taken: u64) -> bool {
    return taken < len;
}

/// The next home: the caller pool first, then the callee-saved registers,
/// then the frame slots. The low word carries a HOME_SLOT's slot index.
pub fn next_home(caller_ok: bool, callee_ok: bool, slot: u64) -> u64 {
    if caller_ok { return HOME_CALLER << 32; }
    if callee_ok { return HOME_CALLEE << 32; }
    return (HOME_SLOT << 32) | slot;
}

test a_leaf_takes_the_free_argument_registers_first {
    assert(next_home(true, true, 0) == (HOME_CALLER << 32));
    assert(caller_pool_has(3, 4));
    assert(!caller_pool_has(3, 5));
    assert(!caller_pool_has(8, 0));
}

test a_fn_with_a_call_skips_the_caller_pool {
    assert(next_home(false, true, 0) == (HOME_CALLEE << 32));
    assert(next_home(false, false, 7) == ((HOME_SLOT << 32) | 7));
}

test the_low_word_carries_the_slot_index {
    var h : u64 = next_home(false, false, 5);
    assert((h >> 32) == HOME_SLOT);
    assert((h & 0xFFFFFFFF) == 5);
}

test an_integer_parameter_register_below_x8_is_its_own_home {
    assert(param_keeps_arg_reg(false, 0, false));
    assert(param_keeps_arg_reg(false, 7, false));
    assert(!param_keeps_arg_reg(false, 8, false));
    assert(!param_keeps_arg_reg(true, 0, false));
    assert(!param_keeps_arg_reg(false, 0, true));
}
