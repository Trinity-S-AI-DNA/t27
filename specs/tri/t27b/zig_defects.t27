// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/zig_defects.t27 -- Zig-side defect detection functions that were hand-written Rust in
; cli/t27b/src/lower.rs (port epic #6198, issue #8592). These functions detect defects that the reference
; would hit, from node kinds and names only. The functions are:
;   - cse_hoist_defect: detects when t27c's optimizer hoists a common subexpression over a local above its declaration
;   - zig_mutates: detects if Zig counts `var name` as mutated anywhere in a given set of nodes
; --
; The functions reach cli/t27b only through `t27c gen-rust` (gen/rust/tri/t27b/zig_defects.rs, mounted as zd).
; The rest of lower.rs is I/O and stays glue: it calls these functions and handles the results.
; --
; cse_hoist_defect takes a function node in byte format and returns the name of the first CSE read that
; is not among the function's parameters, or None if no such read exists. This detects when t27c's Zig
; backend writes every `_cse*` temporary the optimizer made at the very top of the fn body, and one that
; reads a local of the body then names it before its declaration: "use of undeclared identifier".
; --
; zig_mutates takes a slice of nodes and a name, and returns true if Zig counts `var name` as mutated
; anywhere in the nodes. This uses the existing aw::zig_mutates function from ast_walk.t27.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bZigDefects;

use tri::t27b::ast_walk;
use tri::t27b::ast_scan;

/// The value a scan writes for a node it collects.
pub const MARK : u8 = 1;

/// Does the function node contain a CSE read that is not among its parameters?
/// Returns the name of the first such read found, or None if no defect exists.
/// This detects when t27c's optimizer hoists a common subexpression over a local above its declaration.
pub fn cse_hoist_defect(nodes: []const u8, text: []const u8) -> ?[]const u8 {
    // Mark all CSE reads in the function's children
    var marks: [1000]u8 = undefined; // Large enough for typical functions
    for (i in 0..marks.len) { marks[i] = 0; }
    
    // Get the function's children (the function body)
    const fn_children_start = ast_walk::end(nodes, 0); // Skip the function node itself
    const fn_children_end = ast_walk::end(nodes, 0); // Should be the end of the function's subtree
    
    // Mark CSE reads in the function body
    ast_scan::cse_reads(nodes, text, marks[0..marks.len]);
    
    // Find the first marked node that is not a function parameter
    var i: usize = fn_children_start;
    while (i < fn_children_end) {
        if (marks[i] == MARK) {
            const node_name = ast_walk::text(nodes, text, i, ast_walk::F_NAME);
            if (node_name.len > 0) {
                // Check if this name is not among the function's parameters
                const param_count = ast_walk::children_count(nodes, 0); // Function node's children are parameters
                var j: usize = 1; // Start from first child (first parameter)
                var is_param = false;
                while (j <= param_count and !is_param) {
                    const param_node = ast_walk::child_at(nodes, 0, j);
                    if (param_node >= 0) {
                        const param_name = ast_walk::text(nodes, text, @intCast(param_node), ast_walk::F_NAME);
                        if (param_name.len > 0 and std.mem.eql(u8, node_name, param_name)) {
                            is_param = true;
                        }
                    }
                    j = j + 1;
                }
                
                // If not a parameter, return this name
                if (!is_param) {
                    return node_name;
                }
            }
        }
        i = ast_walk::end(nodes, i);
    }
    
    // No defect found
    return null;
}

/// Does Zig count `var name` as mutated anywhere in the nodes?
/// This uses the existing aw::zig_mutates function from ast_walk.t27.
/// Errs toward yes: a yes refuses nothing.
pub fn zig_mutates(nodes: []const u8, text: []const u8, name: []const u8) -> bool {
    return ast_walk::zig_mutates(nodes, text, name);
}

// ------------------------------------------------------------------ tests

test cse_hoist_defect_no_defect {
    // Function with no CSE reads or parameters
    // This represents: fn f() { }
    // Function node at position 0, no children
    const nodes: []const u8 = &[_]u8{
        0x06, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, // K_FN_DECL, end=1
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_NAME: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_VALUE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_TYPE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_FIELD: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_SIZE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_KIND: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_OP: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_RET: empty
    };
    const text: []const u8 = "";
    assert cse_hoist_defect(nodes, text) == null;
}

test cse_hoist_defect_with_defect {
    // Function with a CSE read that is not a parameter
    // This represents: fn f() { _cse0 = x; } where x is not a parameter
    // Function node at 0, CSE assignment at 1, identifier at 2
    const nodes: []const u8 = &[_]u8{
        0x06, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, // K_FN_DECL, end=3
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_NAME: "f"
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_VALUE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_TYPE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_FIELD: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_SIZE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_KIND: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_OP: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_RET: empty
        // Assignment node (K_STMT_ASSIGN)
        0x27, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, // K_STMT_ASSIGN, end=2
        0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_NAME: "_cse0"
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_VALUE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_TYPE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_FIELD: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_SIZE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_KIND: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_OP: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_RET: empty
        // Identifier node (K_EXPR_IDENTIFIER)
        0x11, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, // K_EXPR_IDENTIFIER, end=1
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_NAME: "x"
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_VALUE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_TYPE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_FIELD: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_SIZE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_KIND: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_OP: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_RET: empty
    };
    const text: []const u8 = "fx";
    // The CSE read "_cse0" should be detected as a defect since "x" is not a parameter
    const result = cse_hoist_defect(nodes, text);
    assert result != null;
    assert std.mem.eql(u8, result.?, "_cse0");
}

test zig_mutates_no_mutation {
    // Nodes with no mutation of "x"
    const nodes: []const u8 = &[_]u8{
        0x11, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, // K_EXPR_IDENTIFIER, end=1
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_NAME: "y"
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_VALUE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_TYPE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_FIELD: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_SIZE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_KIND: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_OP: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_RET: empty
    };
    const text: []const u8 = "y";
    assert !zig_mutates(nodes, text, "x"); // "x" is not mutated
}

test zig_mutates_with_mutation {
    // Nodes with mutation of "x"
    const nodes: []const u8 = &[_]u8{
        0x28, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, // K_STMT_ASSIGN, end=1
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_NAME: "x"
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_VALUE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_TYPE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_FIELD: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_SIZE: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_KIND: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_OP: empty
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // F_RET: empty
    };
    const text: []const u8 = "x";
    assert zig_mutates(nodes, text, "x"); // "x" is mutated
}