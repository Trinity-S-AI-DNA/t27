// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/lazy_sig_plan.t27 -- which signature types t27b refuses only where the reference would resolve
; them: `anytype` and the many-item pointer `[*]T` on a fn nothing analyzed reaches (t27b coverage epic #6063;
; written in t27 under the port epic #6198). The decision reaches cli/t27b through `t27c gen-rust`
; (gen/rust/tri/t27b/lazy_sig_plan.rs); the Rust glue in cli/t27b/src/lower.rs (`signature`) asks it about each
; parameter or result type it refused, and a yes counts like a struct that failed its layout (`unresolved_sig`):
; on a fn no test, invariant or constant reaches, the refusal is withdrawn and the fn has no body.
; --
; What the reference does (zig 0.16.0, `t27c test-report` on the t27c lab; pinned by
; specs/tri/t27b/conformance/lazy_signature.t27): t27c's Zig backend prints `f: anytype` and `?[*]Issue` as
; written. Zig analyzes a fn lazily, so a fn nothing analyzed names is parsed and checked by AstGen but its
; parameter and result types are never resolved, and a fn with an `anytype` parameter is never instantiated. Its
; body may call a method no type has (`f.write_str(s)`): Sema never sees it. The corpus has this shape in
; trios-scarab-types SR-00 and SR-02 (`Term_fmt(self, f: anytype)`), trios-cli gh.t27
; (`GhClient_list_agent_issues(..) -> ?[*]AgentIssue`) and the route stubs of queen-public-agents.t27.
; What AstGen still refuses in every fn, analyzed or not, keeps its refusal: an undeclared name, so the element
; type of `[*]T` must be one Zig reads here (elem_spelled) and every name a withdrawn body uses must be declared in
; the fn or the file or be one `zig_knows`; and `anytype` anywhere but a parameter, which does not parse. The
; name check reads expressions only (names, calls, struct literals), not the type text of a local's annotation.
; Not covered: a fn a test reaches. There Zig instantiates `anytype` per call (the parameter no instance reads is
; another lane) and lays out `[*]T`; both keep their refusals here.
; --
; The body (t27o epic #10879, #10897). Sema type-checks only what an analyzed declaration uses, so the body of a fn
; nothing analyzed reaches is parsed and name-checked by AstGen but never type-checked: `return Gw;` for a unit struct `Gw` (Zig: "expected type 'spec.Gw', found 'type'"),
; a list t27b cannot type, a builtin it lacks, all compile when no test calls the fn. `body_plan` asks about each
; refusal t27b recorded in such a body: UNRESOLVED withdraws it and the body lowers to the stub trap no test
; reaches; KEEP is a refusal AstGen makes in every fn (a name declared nowhere, a break outside a loop, a shadowed
; name, two `else` prongs). It subsumes the per-construct stubs that stood here for `try`, `return undefined`, `&` of
; a repeated literal and `-> undefined`; a reached fn keeps every refusal (pinned by conformance/lazy_signature.t27).
; --
; The constant (t27o epic #10879, #10899, #10903). A module-level `const` is as lazy as a fn: Zig resolves it only when
; something analyzed names it, so `pub const ALLOWED : [][]const u8 = ["gfternary"];` (Zig: "type '[][]const u8' does
; not support array initialization syntax" the moment it is read) and `pub const REGION : Region = Region_new(..);`
; (t27b cannot call a fn at compile time) compile while nothing reaches them, and the reference passes the file. ast_shape.t27's `analyzed` now
; marks the constants a test, an invariant or a reached fn or constant mentions, and a constant outside it that t27b
; refuses is judged by `const_plan`: the body rule, but an annotation Zig cannot read in this file keeps the refusal. The
; refusal comes back, with a body's, when AstGen refuses the file anyway (`withdrawn_come_back`). A constant a test
; reaches keeps it (pinned by conformance/lazy_const.t27: t27c passes the call-initialised struct constant, which Zig
; evaluates at compile time, and refuses the slice; t27b refuses both, the first a counted remainder).
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bLazySigPlan;

use tri::t27b::literal_plan; // ends_with; no name here is also one of literal_plan's

// The answer.
pub const KEEP : u8 = 0;
pub const UNRESOLVED : u8 = 1;

// Bytes the glue's type text is read by.
const QUESTION : u8 = 63;
const OPEN : u8 = 91;
const STAR : u8 = 42;
const CLOSE : u8 = 93;
const CLOSE_PAREN : u8 = 41;
const SPACE : u8 = 32;
const AT : u8 = 64;
const LOWER_U : u8 = 117;
const LOWER_I : u8 = 105;
const DIGIT_0 : u8 = 48;
const DIGIT_9 : u8 = 57;

/// Does `t` begin with `word`?
fn begins(t: []const u8, word: []const u8) -> bool {
    if (word.len > t.len) { return false; }
    var k : usize = 0;
    while (k < word.len) {
        if (t[k] != word[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Where the element type of a many-item pointer begins in `t`: after any leading `?`, `[*]`, and an optional
/// `const ` qualifier. 0 when `t` is not a many-item pointer or has no element.
pub fn many_item_elem(t: []const u8) -> usize {
    var at : usize = 0;
    while (at < t.len and t[at] == QUESTION) {
        at = at + 1;
    }
    if (t.len < at + 4) { return 0; }
    if (t[at] != OPEN or t[at + 1] != STAR or t[at + 2] != CLOSE) { return 0; }
    at = at + 3;
    while (at < t.len and t[at] == SPACE) {
        at = at + 1;
    }
    if (begins(t[at .. t.len], "const ")) { at = at + 6; }
    if (at == t.len) { return 0; }
    return at;
}

/// `t` is exactly the keyword `anytype`.
pub fn is_anytype(t: []const u8) -> bool {
    return t.len == 7 and begins(t, "anytype");
}

/// Is `t` exactly `comptime_int`? An extern module's integer Verilog parameter is declared so
/// (specs/tri/t27b/verilog_plan.t27, #8796); Zig resolves it, and refuses it on a run-time parameter, only when
/// the fn is analyzed, and nothing analyzed calls an extern.
pub fn is_comptime_int(t: []const u8) -> bool {
    return t.len == 12 and begins(t, "comptime_int");
}

/// Is `t` exactly `undefined`? t27c prints a port's `-> undefined` stub as `fn f() undefined { undefined; }`
/// (#6315); Zig refuses that result type ("expected type 'type', found '@TypeOf(undefined)'") once a fn is analyzed.
pub fn is_undefined(t: []const u8) -> bool {
    return t.len == 9 and begins(t, "undefined");
}

/// The decision for one signature type t27b refused. param: it is a parameter's type, the only place `anytype`
/// parses. elem_spelled: for `[*]T`, T is a type Zig reads in this file. UNRESOLVED: Zig resolves the type only
/// when the fn is analyzed.
pub fn plan(t: []const u8, param: bool, elem_spelled: bool) -> u8 {
    if (is_anytype(t) or is_comptime_int(t)) {
        if (param) { return UNRESOLVED; }
        return KEEP;
    }
    if (is_undefined(t)) {
        if (param) { return KEEP; }
        return UNRESOLVED;
    }
    if (many_item_elem(t) != 0 and elem_spelled) { return UNRESOLVED; }
    return KEEP;
}

/// `t` is a Zig integer type `uN` or `iN`, N from 0 to 65535 with no leading zero.
fn int_type(t: []const u8) -> bool {
    if (t.len < 2 or t.len > 6) { return false; }
    if (t[0] != LOWER_U and t[0] != LOWER_I) { return false; }
    if (t.len > 2 and t[1] == DIGIT_0) { return false; }
    var bits : u32 = 0;
    var i : usize = 1;
    while (i < t.len) {
        if (t[i] < DIGIT_0 or t[i] > DIGIT_9) { return false; }
        bits = bits * 10 + ((t[i] - DIGIT_0) as u32);
        i = i + 1;
    }
    return bits <= 65535;
}

/// `name` is one of the space-separated words of `list`.
fn listed(name: []const u8, list: []const u8) -> bool {
    var start : usize = 0;
    var i : usize = 0;
    while (i <= list.len) {
        if (i == list.len or list[i] == SPACE) {
            if (i - start == name.len and begins(list[start .. i], name)) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

/// `name` is one Zig resolves with no declaration in this file: a builtin (`@name`), a primitive type or value,
/// `_`, `std` (t27c's prelude imports it), and `assert` / `assert_eq` (t27c prints both through its prelude).
/// The glue asks this about every name the body of a withdrawn fn uses that the fn and the file do not declare:
/// AstGen resolves those in every fn, so a body naming anything else keeps its fn's refusal.
pub fn zig_knows(name: []const u8) -> bool {
    if (name.len == 0) { return false; }
    if (name[0] == AT) { return true; }
    if (int_type(name)) { return true; }
    return listed(name, "_ std assert assert_eq true false null undefined void bool noreturn type anyerror anyopaque anytype comptime_int comptime_float usize isize f16 f32 f64 f80 f128");
}

/// `zig_knows`, in a module whose Zig has the prelude or not. t27c writes `const std = @import("std");` and
/// `__t27_assert_fail`, which `assert` and `assert_eq` print through, only into a module with a test or an
/// invariant (`has_tests` in compiler.rs); in any other `std` and `assert` are undeclared and AstGen refuses the
/// fn that names them, analyzed or not (`t27c test-report`: "use of undeclared identifier 'std'").
pub fn zig_knows_in(name: []const u8, prelude: bool) -> bool {
    if (!prelude and listed(name, "std assert assert_eq")) { return false; }
    return zig_knows(name);
}

/// `name` (with its `@`) is a builtin Zig 0.16 has. AstGen refuses any other (`@stdout`: "invalid builtin function") in
/// every fn, analyzed or not. t27b lacks some of these (`@floatCast`, `@max` on mixed operands); a fn nothing analyzed
/// reaches may call them, so those are withdrawn, and a name outside the list is kept.
pub fn zig_builtin(name: []const u8) -> bool {
    return listed(name, "@abs @addrSpaceCast @addWithOverflow @alignCast @alignOf @as @atomicLoad @atomicRmw @atomicStore @bitCast @bitOffsetOf @bitReverse @bitSizeOf @branchHint @breakpoint @byteSwap @call @cDefine @cImport @cInclude @ceil @clz @cmpxchgStrong @cmpxchgWeak @compileError @compileLog @constCast @cos @ctz @cUndef @cVaArg @cVaCopy @cVaEnd @cVaStart @disableInstrumentation @disableIntrinsics @divExact @divFloor @divTrunc @embedFile @Enum @EnumLiteral @enumFromInt @errorFromInt @errorName @errorReturnTrace @errSetCast @exp @exp2 @export @extern @field @fieldParentPtr @FieldType @floatCast @floatFromInt @floor @Fn @frameAddress @hasDecl @hasField @import @inComptime @Int @intCast @intFromBool @intFromEnum @intFromError @intFromFloat @intFromPtr @log @log10 @log2 @max @memcpy @memmove @memset @min @mod @mulAdd @mulWithOverflow @offsetOf @panic @Pointer @popCount @prefetch @ptrCast @ptrFromInt @reduce @rem @returnAddress @round @select @setEvalBranchQuota @setFloatMode @setRuntimeSafety @shlExact @shlWithOverflow @shrExact @shuffle @sin @sizeOf @splat @sqrt @src @Struct @subWithOverflow @tagName @tan @This @trap @trunc @truncate @Tuple @Type @typeInfo @typeName @TypeOf @Union @unionInit @Vector @volatileCast @wasmMemoryGrow @wasmMemorySize @workGroupId @workGroupSize @workItemId");
}

/// The decision for one refusal t27b recorded while lowering the body of a fn nothing analyzed reaches. construct
/// and detail: the refusal's name and words. UNRESOLVED: Zig meets the construct only in Sema, which never runs on
/// this body, so the refusal is withdrawn. KEEP: AstGen or the parser refuses it in every fn (each pinned against
/// `t27c test-report` on a fn no test reaches): `break` outside a loop; a local that shadows a module var; two
/// `else` prongs; a builtin Zig has not (`@stdout`); a char prong, a char or string literal Zig cannot read; a struct field set twice; `_ = p;` of a
/// parameter the fn uses; and the spellings t27c prints verbatim that Zig cannot parse (a tuple, a map type, a
/// tuple assignment, an array literal kept as text).
pub fn body_plan(construct: []const u8, detail: []const u8) -> u8 {
    if (begins(construct, "ExprCall(@")) {
        var e : usize = 9;
        while (e < construct.len and construct[e] != CLOSE_PAREN) { e = e + 1; }
        if (!zig_builtin(construct[9 .. e])) { return KEEP; }
    }
    if (begins(construct, "StmtBreak") or begins(construct, "StmtContinue")) { return KEEP; }
    if (begins(construct, "StmtLocal(shadows") or begins(construct, "StmtLocal(destructure")) { return KEEP; }
    if (begins(construct, "StmtAssign(discard") or begins(construct, "StmtAssign(tuple")) { return KEEP; }
    if (begins(construct, "ExprSwitch(two else") or begins(construct, "ExprSwitch(char prong")) { return KEEP; }
    if (begins(construct, "ExprLiteral(char") or begins(construct, "ExprLiteral(string") or begins(construct, "ExprLiteral(literal")) { return KEEP; }
    if (begins(construct, "ExprArrayLiteral(text") or begins(construct, "ExprTuple")) { return KEEP; }
    if (begins(construct, "type (tuple") or begins(construct, "type [K:V")) { return KEEP; }
    if (begins(construct, "ExprStructLit") and ends_with(detail, "initialised twice")) { return KEEP; }
    return UNRESOLVED;
}

/// The decision for one refusal t27b recorded while lowering a module constant nothing analyzed reaches (`analyzed`).
/// The constant is as lazy as a body, so `body_plan` decides; `spelled` is whether its annotation, if it has one, is a
/// type Zig reads in this file: AstGen resolves the type of a declaration whether or not it is analyzed, so a type
/// declared nowhere (`pub const X : Missing = ..;`) keeps the refusal, as does a constant with no value, which does not parse.
pub fn const_plan(construct: []const u8, detail: []const u8, spelled: bool) -> u8 {
    if (!spelled) { return KEEP; }
    if (begins(construct, "ConstDecl") and ends_with(detail, "has no value")) { return KEEP; }
    return body_plan(construct, detail);
}

/// Whether the refusals withdrawn from unreached bodies come back, after every body is lowered: AstGen refuses the
/// whole file, whichever fn it reads, when some fn names something declared nowhere (names_missing), or when the
/// module has no test and no invariant (bare) yet t27c printed a string `==` as `std.mem.eql` (eql_used), `std`
/// being written only where a test or an invariant is (`zig_knows_in`).
pub fn withdrawn_come_back(names_missing: bool, bare: bool, eql_used: bool) -> bool {
    return names_missing or (bare and eql_used);
}

// ----------------------------------------------------------------------------------------------------------
// Tests: the corpus shapes, then what keeps its refusal.
// ----------------------------------------------------------------------------------------------------------

test anytype_parameters_are_resolved_lazily {
    // SR-00's `Term_fmt(self: Term, f: anytype)`, identity.t27's `isNotFoundError(err: anytype)`.
    assert(is_anytype("anytype"));
    assert(plan("anytype", true, false) == UNRESOLVED);
    assert(plan("anytype", true, true) == UNRESOLVED);
}

test comptime_int_parameters_are_resolved_lazily {
    // verilog_prim.t27's `BSCANE2(JTAG_CHAIN: comptime_int, ...)`, an extern no test calls.
    assert(is_comptime_int("comptime_int"));
    assert(plan("comptime_int", true, false) == UNRESOLVED);
    assert(plan("comptime_int", false, false) == KEEP);
    assert(!is_comptime_int("comptime_ints") and !is_comptime_int("comptime_float") and !is_comptime_int(""));
}

test anytype_outside_a_parameter_keeps_its_refusal {
    // `fn f() anytype` does not parse in Zig, so the reference refuses the file.
    assert(plan("anytype", false, false) == KEEP);
    assert(plan("anytype", false, true) == KEEP);
    assert(!is_anytype("anytypes"));
    assert(!is_anytype("anytyp"));
    assert(!is_anytype("?anytype"));
    assert(!is_anytype(""));
}

test many_item_pointers_find_their_element {
    // gh.t27's `?[*]AgentIssue`: the element starts after `?[*]`.
    assert(many_item_elem("?[*]AgentIssue") == 4);
    assert(many_item_elem("[*]u8") == 3);
    assert(many_item_elem("[*]const u8") == 9);
    assert(many_item_elem("??[*] const Issue") == 12);
    assert(many_item_elem("[*]T") == 3);
    assert(many_item_elem("?[*]T") == 4);
    assert(many_item_elem("[*]") == 0);
    assert(many_item_elem("?[*]") == 0);
    assert(many_item_elem("[*]con") == 3);
    assert(many_item_elem("[*] ") == 0);
    assert(many_item_elem("[*]const ") == 0);
    assert(many_item_elem("[]u8") == 0);
    assert(many_item_elem("[4]u8") == 0);
    assert(many_item_elem("*u8") == 0);
    assert(many_item_elem("") == 0);
}

test a_many_item_pointer_to_a_type_zig_reads_is_resolved_lazily {
    assert(plan("?[*]AgentIssue", false, true) == UNRESOLVED);
    assert(plan("[*]const u8", true, true) == UNRESOLVED);
}

test an_element_zig_cannot_name_keeps_its_refusal {
    // AstGen resolves every name in the file, analyzed or not: `[*]Missing` fails there.
    assert(plan("?[*]Missing", false, false) == KEEP);
    assert(plan("[*]Missing", true, false) == KEEP);
}

test every_other_type_keeps_its_refusal {
    assert(plan("?void", true, true) == KEEP);
    assert(plan("std.StringHashMap(Entry)", false, true) == KEEP);
    assert(plan("[K:V]", true, true) == KEEP);
    assert(plan("", true, true) == KEEP);
    assert(KEEP != UNRESOLVED);
}

test names_zig_resolves_without_a_declaration {
    // SR-00's withdrawn `Term_fmt` uses `_`; ports call `std.mem.eql`, `@intCast` and `assert`.
    assert(zig_knows("_"));
    assert(zig_knows("std"));
    assert(zig_knows("@intCast"));
    assert(zig_knows("assert"));
    assert(zig_knows("null"));
    assert(zig_knows("f128"));
    assert(zig_knows("u8"));
    assert(zig_knows("u9"));
    assert(zig_knows("i65535"));
    assert(zig_knows("u0"));
}

test any_other_name_needs_a_declaration {
    // `undeclared_thing()` in a withdrawn body: Zig's AstGen refuses the file.
    assert(!zig_knows("undeclared_thing"));
    assert(!zig_knows(""));
    assert(!zig_knows("u65536"));
    assert(!zig_knows("u08"));
    assert(!zig_knows("u"));
    assert(!zig_knows("x8"));
    assert(!zig_knows("u8x"));
    assert(!zig_knows("std2"));
    assert(!zig_knows("st"));
    assert(!zig_knows("print"));
}

test an_undefined_result_is_resolved_lazily {
    // A port's `fn f() undefined { undefined; }` (#6315): the type is read once the fn is analyzed.
    assert(is_undefined("undefined"));
    assert(plan("undefined", false, false) == UNRESOLVED);
    assert(plan("undefined", true, false) == KEEP);
    assert(!is_undefined("undefine") and !is_undefined("undefineds") and !is_undefined("?undefined") and !is_undefined(""));
}

test sema_level_refusals_in_an_unreached_body_are_withdrawn {
    // t27o: a unit struct used as a value (`return Gw;`), a list t27b cannot type, a builtin it lacks, a mismatch.
    assert(body_plan("ExprIdentifier(undeclared)", "unknown name `Gw`") == UNRESOLVED);
    assert(body_plan("ExprArrayLiteral", "array literal with no result type") == UNRESOLVED);
    assert(body_plan("type mismatch", "expected u8, found u32") == UNRESOLVED);
    assert(body_plan("ExprCall(@floatFromInt)", "") == UNRESOLVED);
    assert(body_plan("ExprCall(@floatCast)", "") == UNRESOLVED);
    assert(body_plan("ExprCall(@max)", "") == UNRESOLVED);
    assert(body_plan("ExprUnary(try) in a fn", "") == UNRESOLVED);
    assert(body_plan("ExprReturn(undefined)", "") == UNRESOLVED);
    assert(body_plan("ExprCall(unresolved fn)", "") == UNRESOLVED);
    assert(body_plan("StmtLocal", "`var x` initialised with an untyped integer needs a type") == UNRESOLVED);
    assert(body_plan("StmtAssign", "assignment through a constant") == UNRESOLVED);
    assert(body_plan("ExprStructLit", "missing field `y` of `Pt`") == UNRESOLVED);
    assert(body_plan("ExprStructLit", "`Duo` is u8, not a struct") == UNRESOLVED);
    assert(body_plan("ExprFieldAccess", "`Pt` has no field `zzz`") == UNRESOLVED);
    assert(body_plan("ExprLiteral(null)", "") == UNRESOLVED);
    assert(body_plan("ExprLiteral(float literal)", "") == UNRESOLVED);
    assert(body_plan("ExprIndex(tuple)", "") == UNRESOLVED);
    assert(body_plan("type [N]T", "") == UNRESOLVED);
}

test astgen_level_refusals_in_an_unreached_body_keep_their_refusal {
    // Scope and syntax rules AstGen applies to every fn.
    assert(body_plan("StmtBreak", "outside a loop") == KEEP);
    assert(body_plan("StmtContinue", "outside a loop") == KEEP);
    assert(body_plan("StmtLocal(shadows module var)", "") == KEEP);
    assert(body_plan("StmtAssign(discard)", "") == KEEP);
    assert(body_plan("ExprSwitch(two else prongs)", "") == KEEP);
    assert(body_plan("ExprStructLit", "field `x` initialised twice") == KEEP);
    // A literal Zig's lexer cannot read (`'\\0'` is no escape there); a null or a float t27b cannot type is Sema's.
    assert(body_plan("ExprLiteral(char escape)", "") == KEEP);
    assert(body_plan("ExprLiteral(char byte)", "") == KEEP);
    assert(body_plan("ExprLiteral(char literal)", "") == KEEP);
    assert(body_plan("ExprLiteral(string literal)", "") == KEEP);
    assert(body_plan("ExprLiteral(literal)", "") == KEEP);
    // A builtin Zig does not have (check_graph_law8.t27's `@stdout`: "invalid builtin function").
    assert(body_plan("ExprCall(@stdout)", "call to `@stdout`") == KEEP);
    assert(body_plan("ExprCall(@noSuch)", "") == KEEP);
    // A spelling t27c prints verbatim and Zig cannot parse.
    assert(body_plan("ExprSwitch(char prong)", "") == KEEP);
    assert(body_plan("type (tuple)", "`(u32, u32)`") == KEEP);
    assert(body_plan("type [K:V]", "") == KEEP);
    assert(body_plan("ExprTuple", "") == KEEP);
    assert(body_plan("StmtAssign(tuple)", "") == KEEP);
    assert(body_plan("StmtLocal(destructure)", "") == KEEP);
    assert(body_plan("ExprArrayLiteral(text element)", "") == KEEP);
    assert(body_plan("ExprArrayLiteral(text form)", "") == KEEP);
}

test sema_level_refusals_in_a_constant_nothing_reaches_are_withdrawn {
    // catalog_gate.t27's `ALLOWED : [][]const u8`, addrmap.t27's `REGION_BRAM : MemRegion = MemRegion_new(..)`,
    // capflags.t27's `FULL_CAPABILITIES : CapFlags = CapFlags_all()`.
    assert(const_plan("ConstDecl(slice)", "`ALLOWED` is a module-level slice", true) == UNRESOLVED);
    assert(const_plan("ConstDecl(slice)", "slice in a module-level constant", true) == UNRESOLVED);
    assert(const_plan("ConstDecl", "`MemRegion` constant is not a compile-time value", true) == UNRESOLVED);
    assert(const_plan("ConstDecl", "struct or array constant is not a compile-time value", true) == UNRESOLVED);
    assert(const_plan("ConstDecl", "enum field is not a compile-time value", true) == UNRESOLVED);
    assert(const_plan("ConstDecl", "struct field is not a compile-time value", true) == UNRESOLVED);
    assert(const_plan("ConstDecl", "`X` is not a compile-time integer or bool", true) == UNRESOLVED);
    assert(const_plan("ExprArrayLiteral", "array literal with no result type", true) == UNRESOLVED);
    assert(const_plan("type mismatch", "expected u8, found u32", true) == UNRESOLVED);
}

test an_annotation_zig_cannot_read_keeps_a_constants_refusal {
    // `pub const X : Missing = ..;` and `[]Missing`: AstGen refuses the type whatever reaches the constant.
    assert(const_plan("ConstDecl(slice)", "`X` is a module-level slice", false) == KEEP);
    assert(const_plan("ConstDecl", "`Missing` constant is not a compile-time value", false) == KEEP);
    assert(const_plan("type (undeclared)", "`Missing`", false) == KEEP);
}

test a_constant_with_no_value_or_a_spelling_astgen_refuses_keeps_its_refusal {
    // The same KEEP classes as a body's: they are AstGen's, whatever reaches the constant.
    assert(const_plan("ConstDecl", "`X` has no value", true) == KEEP);
    assert(const_plan("ExprLiteral(char escape)", "", true) == KEEP);
    assert(const_plan("ExprLiteral(string literal)", "", true) == KEEP);
    assert(const_plan("ExprArrayLiteral(text form)", "`[4]`: elements kept as text", true) == KEEP);
    assert(const_plan("type (tuple)", "`(u32, u32)`", true) == KEEP);
    assert(const_plan("ExprStructLit", "field `x` initialised twice", true) == KEEP);
    assert(const_plan("ExprCall(@noSuch)", "", true) == KEEP);
}

test the_withdrawn_refusals_come_back_when_astgen_refuses_the_file {
    // A name declared nowhere in any fn (the glue's check), whatever fn t27b withdrew.
    assert(withdrawn_come_back(true, false, false));
    assert(withdrawn_come_back(true, true, true));
    // trios-algorithm-arena SR-ALG-00: no test, and a string `==` printed as `std.mem.eql`, with no `std` import.
    assert(withdrawn_come_back(false, true, true));
    // A module with a test has `std`; with no string comparison there is nothing to print.
    assert(!withdrawn_come_back(false, false, true));
    assert(!withdrawn_come_back(false, true, false));
    assert(!withdrawn_come_back(false, false, false));
}

test the_end_of_a_text_is_found {
    assert(ends_with("field `x` initialised twice", "initialised twice"));
    assert(ends_with("abc", "abc") and ends_with("abc", "c") and ends_with("abc", ""));
    assert(!ends_with("abc", "abcd") and !ends_with("", "a") and !ends_with("initialised twice now", "initialised twice"));
}

test the_prelude_names_exist_only_in_a_module_with_a_test {
    // trios-algorithm-arena SR-ALG-00: a body naming `std.mem.eql` in a module with no test block, which t27c
    // prints without the `std` import.
    assert(zig_knows_in("std", true));
    assert(zig_knows_in("assert", true));
    assert(zig_knows_in("assert_eq", true));
    assert(!zig_knows_in("std", false));
    assert(!zig_knows_in("assert", false));
    assert(!zig_knows_in("assert_eq", false));
    // Builtins, primitive types and values need no prelude.
    assert(zig_knows_in("@intCast", false));
    assert(zig_knows_in("u8", false));
    assert(zig_knows_in("undefined", false));
    assert(!zig_knows_in("std2", true));
    assert(!zig_knows_in("print", true));
}

test zig_has_these_builtins {
    assert(zig_builtin("@floatFromInt") and zig_builtin("@floatCast") and zig_builtin("@max") and zig_builtin("@TypeOf"));
    assert(zig_builtin("@intCast") and zig_builtin("@This") and zig_builtin("@workItemId") and zig_builtin("@abs"));
    assert(!zig_builtin("@stdout") and !zig_builtin("floatCast") and !zig_builtin("@") and !zig_builtin(""));
    assert(!zig_builtin("@floatCas") and !zig_builtin("@floatCasts") and !zig_builtin("@Max"));
}
