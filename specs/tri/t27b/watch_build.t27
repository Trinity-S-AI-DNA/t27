// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/watch_build.t27 -- when `t27b watch` rebuilds a native object. Issue gHashTag/t27#10859,
; epic #10863 (T27F developer tools in t27b and t27c, sped up by t27c seal).
; --
; Why. A T27 OS window swaps itself when its binary changes (specs/t27os/hot_reload.t27); what was left was
; running `t27b build` by hand after every save. `t27b watch <file.t27> -o <out.o>` builds once, then
; rebuilds the object after every settled save to the spec or to any spec in its `use` closure.
; --
; Nothing is decided twice. The poll interval and the idle look are specs/verified/watch.t27 (a look stats
; the files the last build read and builds nothing when no stat moved, #8821); the debounce is
; specs/t27f/hot.t27 (an editor save is two or three file events: a burst is ready after HOT_DEBOUNCE_MS
; of quiet, or HOT_MAX_WAIT_MS after its first event). This spec adds only what is specific to an object:
; - when a build starts: on the first look, or when a stat moved and the burst is ready;
; - how long the loop sleeps: the poll interval, or what is left of the debounce while a burst is open;
; - the object is written to `<out>` + WATCH_TMP_SUFFIX and renamed over `<out>` only when the build
;   succeeded, so a hot-reloading app never maps a half-written object and a type error keeps the old one;
; - `--then` runs exactly once per successful build, never after a failed one, and its exit code never
;   stops the watch.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bWatchBuild;

use verified::watch::WATCH_POLL_MS;
use verified::watch::watch_walk;
use t27f::hot::HOT_DEBOUNCE_MS;
use t27f::hot::HOT_MAX_WAIT_MS;
use t27f::hot::hot_wait_ms;
use t27f::hot::hot_ready;

/// The build writes here, next to the object, and is renamed over it on success.
pub const WATCH_TMP_SUFFIX : str = ".watch-tmp";

/// Build on this look. `pending` is true while a stat moved since the last build; quiet_ms is the time
/// since the last look that saw a stat move, waited_ms the time since the first one did.
pub fn watch_build_now(first_look: bool, pending: bool, quiet_ms: u32, waited_ms: u32) -> bool {
    return watch_walk(first_look, pending and hot_ready(quiet_ms, waited_ms));
}

/// Milliseconds to sleep before the next look: what is left of the debounce while a burst is open,
/// otherwise the poll interval.
pub fn watch_sleep_ms(pending: bool, quiet_ms: u32, waited_ms: u32) -> u32 {
    if (pending) {
        const left : u32 = hot_wait_ms(quiet_ms, waited_ms);
        if (left > 0) { return left; }
        return 1;
    }
    return WATCH_POLL_MS;
}

/// Rename the temporary object over the output: only after a successful build.
pub fn watch_publish(build_ok: bool) -> bool {
    return build_ok;
}

/// Run the `--then` command: once per successful build, when one was given.
pub fn watch_run_then(build_ok: bool, has_then: bool) -> bool {
    return build_ok and has_then;
}

test the_first_look_always_builds {
    assert watch_build_now(true, false, 0, 0);
    assert watch_build_now(true, true, 0, 0);
}

test an_idle_look_builds_nothing {
    assert watch_build_now(false, false, 0, 0) == false;
    assert watch_build_now(false, false, 100000, 100000) == false;
    assert watch_sleep_ms(false, 0, 0) == WATCH_POLL_MS;
}

test a_save_builds_after_the_debounce {
    // just seen: wait out the quiet window
    assert watch_build_now(false, true, 0, 0) == false;
    assert watch_sleep_ms(true, 0, 0) == HOT_DEBOUNCE_MS;
    // quiet long enough
    assert watch_build_now(false, true, HOT_DEBOUNCE_MS, HOT_DEBOUNCE_MS);
    // a burst that never goes quiet still builds at the maximum wait
    assert watch_build_now(false, true, 0, HOT_MAX_WAIT_MS);
}

test the_sleep_never_spins_on_zero {
    assert watch_sleep_ms(true, HOT_DEBOUNCE_MS, HOT_MAX_WAIT_MS) == 1;
}

test a_failed_build_keeps_the_object_and_skips_then {
    assert watch_publish(false) == false;
    assert watch_run_then(false, true) == false;
    assert watch_publish(true);
    assert watch_run_then(true, true);
    assert watch_run_then(true, false) == false;
}

test a_save_is_rebuilt_within_one_poll_and_the_debounce {
    // the 700 ms criterion of #10859 is WATCH_POLL_MS + HOT_MAX_WAIT_MS + the build
    assert watch_sleep_ms(false, 0, 0) + HOT_MAX_WAIT_MS <= 560;
}
