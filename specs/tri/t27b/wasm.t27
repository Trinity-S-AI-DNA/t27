// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/wasm.t27 -- the WASM32 MODULE FORMAT, as law, for the epic gHashTag/t27#11840
; (t27b emits wasm32). This is the ground floor the backend mounts: the unsigned and signed LEB128
; encoders, the section framing (id byte, uleb length, body), the module preamble (magic and version),
; and a minimal type-section entry. Floor 2 mounts on it: the value-type bytes (i32 0x7F, i64 0x7E,
; f32 0x7D, f64 0x7C), the name-to-valtype map (fail closed: an unknown name writes nothing and the
; offset stands), the full functype entry, and the code-section entry (size, locals count, body).
; Floor 4 (the constant-leaf emitter's law, ported from the working reference
; cli/t27b/src/wasm32_emitter.rs, PR #11942) adds the export-section id and entry, the bare section
; header, and the remaining constant instructions i64.const/f32.const/f64.const.
; CORRECTED 2026-10-24: the floor-2 table carried f32 = 0x43 and f64 = 0x44 -- those are the
; f32.const/f64.const OPCODES, not value types. The binary format's value types are f32 0x7D and
; f64 0x7C; a functype carrying 0x43 where the f32 value type belongs is refused by every standard
; runtime. The working reference emitter (which Node's WebAssembly instantiates 100/100 in the
; equality gate) is the evidence this fix is checked against.
; Floor 3 makes the pieces composable into a REAL minimal module: one locals group (uleb count plus
; the valtype byte, through the same fail-closed map), one function-section entry (the uleb type
; index), the vector prefix, the whole code-section frame (the vector count, then the joined
; size-prefixed entries), and the instruction floor (local.get 0x20, local.set 0x21, i32.const 0x41,
; i32.add 0x6A, end 0x0B). The capstone test composes the whole minimal module -- preamble, type
; section, function section, code section -- and pins every byte.
; Floor 6 mounts the surface a calling emitter needs, and is the honest merge of PR #11941
; onto master's floors 4-5: what that branch carried that master had not taken -- export_section
; (the in-place framing twin of code_section), call 0x10 and the control family (block 0x02,
; loop 0x03 and if 0x04 opening the void blocktype 0x40, else 0x05, br 0x0C, br_if 0x0D,
; return 0x0F), and the i64 stack floor (i64.add 0x7C, local.tee 0x22, drop 0x1A) -- renumbered
; from the branch's "floor 4" to floor 6. What master already had (the export entry and section
; id, the constant-leaf law, i32 arithmetic) is not duplicated. The floor-6 capstone composes
; the first TWO-function module: an exported wrapper whose body is one call to a callee that
; adds two i64 constants -- 48 bytes, every one pinned.
; Floor 7 (the emit() composer, ported from cli/t27b/src/wasm32_emitter.rs, PR #11983, port epic
; #6198) answers the #9103 gap the way macho.t27 does: no slice of slices, but a DESCRIPTOR RECORD
; AREA -- 24 bytes per fn (name offset and length into a names blob, parameter count, result
; valtype byte, body offset and length into a bodies blob) -- plus one compose path that assembles
; the whole module (preamble, type, function, export, code) through the floor-1..5 law fns above.
; The capstone tests pin the live-scalar closure byte for byte: the 87-byte two-fn module
; (arrival_frame + latency_ms, the build Node's WebAssembly verified on the emitter branch) and
; the 117-byte trio (paints_due joined, Node-verified 2026-10-24).;
; Floor 8 (the REFUSAL WALK, the task plan's floor 7 before the composer took the
; number) ports the other half of cli/t27b/src/wasm32_emitter.rs (the held
; reference on lane/ma-params @ 5170be77b, PR #11983, port epic #6198): WHICH pub
; fns the module refuses and the exact construct and detail words each refusal
; carries -- byte-stable, the phrasing the corpus parses out of the refusal
; line. The walk: a test or private fn is skipped (no refusal); a pub fn
; without a return refuses (void pub fn); the M-A path (no parameters) refuses
; an uncarried return (ptr return / i128 return) before a non-constant body
; (fn body); the M-B path refuses an off-carrier parameter (fn parameters)
; before the return (ptr/i128 return, then fn return type) before the body --
; an expression tree walks Const, then Var (a var at or beyond the parameter
; count is a local variable), then Arith (an operator outside + - * / is an
; arithmetic op, checked before the operands, lhs before rhs), anything else an
; expression kind; the select pattern's shape facts refuse as fn body and its
; condition as if condition (two phrasings); any other body is fn body. An
; empty export set refuses at the module level: construct module, fn
; (module), line 0. The refusal line is `unsupported construct <construct> at
; line <line> (fn <func>: <detail>)` -- EmitError::message's exact shape.

; Every fn writes into a caller buffer at an offset and returns the new offset -- the same contract
; as the Mach-O port (specs/tri/t27b/macho.t27) -- so the emitter composes sections without an
; intermediate allocation. The tests pin the canonical LEB128 vectors, the exact preamble bytes, the
; functype bytes, the code-entry size math and the 26-byte minimal module; nothing here reads,
; allocates or executes -- format law only.
; Sources: the WebAssembly binary format (magic 00 61 73 6D, version 01 00 00 00; a section is one id
; byte followed by the uleb128 body length followed by the body; a functype is 0x60 then the parameter
; count, the value types, the result count, the value types; a value type is one byte, i32 0x7F,
; i64 0x7E, f32 0x7D, f64 0x7C; a code entry is the uleb size of what follows it, then the locals
; vector, then the expression, whose last byte is the 0x0B end opcode; the type and function section
; bodies are vectors -- a uleb count then the entries -- and the code section body is the uleb entry
; count then the joined code entries; the export section body is a vector of entries, an entry
; the uleb name length, the name bytes, the kind byte and the uleb index; an instruction is one
; opcode byte, i32.const followed by the sleb128 immediate, local.get, local.set, call, br, br_if
; and local.tee followed by the uleb immediate, and block, loop and if open with the void
; blocktype byte 0x40).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27bWasm;

// The module magic and version bytes, emitted first.
pub const MAGIC0 : u8 = 0x00;
pub const MAGIC1 : u8 = 0x61;
pub const MAGIC2 : u8 = 0x73;
pub const MAGIC3 : u8 = 0x6D;
pub const VERSION1 : u8 = 0x01;

// Section ids this floor names (the emitter extends the table as slices land).
pub const SEC_TYPE : u8 = 1;
pub const SEC_FUNC : u8 = 3;
pub const SEC_EXPORT : u8 = 7;
pub const SEC_CODE : u8 = 10;

// The functype prefix byte: a function type with a parameter vector and a result vector.
pub const FUNCTYPE : u8 = 0x60;

// The value-type bytes, one byte each; the numeric types this floor names.
// These are NOT the const opcodes: f32 carries 0x7D and f64 0x7C as value
// types, while the CONST INSTRUCTIONS carry 0x43 and 0x44 (see OP_F32_CONST,
// OP_F64_CONST below). The two families differ by design; the corrected table
// is pinned against the reference emitter's accepted modules.
pub const VT_I32 : u8 = 0x7F;
pub const VT_I64 : u8 = 0x7E;
pub const VT_F32 : u8 = 0x7D;
pub const VT_F64 : u8 = 0x7C;

// The instruction opcodes this floor names (the emitter extends the table as
// instruction slices land).
pub const OP_LOCAL_GET : u8 = 0x20;
pub const OP_LOCAL_SET : u8 = 0x21;
pub const OP_I32_CONST : u8 = 0x41;
pub const OP_I64_CONST : u8 = 0x42;
pub const OP_F32_CONST : u8 = 0x43;
pub const OP_F64_CONST : u8 = 0x44;
pub const OP_I32_ADD : u8 = 0x6A;
pub const OP_I32_SUB : u8 = 0x6B;
pub const OP_I32_MUL : u8 = 0x6C;
pub const OP_I32_DIV_U : u8 = 0x6E;
pub const OP_I32_EQZ : u8 = 0x45;
pub const OP_SELECT : u8 = 0x1B;
pub const OP_END : u8 = 0x0B;

// Floor 6 (PR #11941's unique content, renumbered from its "floor 4" onto
// master's floors 4-5): the export kind byte export_entry writes, the void
// blocktype, and the call, control and i64 stack opcodes.
pub const KIND_FUNC : u8 = 0x00;
pub const BLOCK_VOID : u8 = 0x40;
pub const OP_CALL : u8 = 0x10;
pub const OP_BLOCK : u8 = 0x02;
pub const OP_LOOP : u8 = 0x03;
pub const OP_IF : u8 = 0x04;
pub const OP_ELSE : u8 = 0x05;
pub const OP_BR : u8 = 0x0C;
pub const OP_BR_IF : u8 = 0x0D;
pub const OP_RETURN : u8 = 0x0F;
pub const OP_DROP : u8 = 0x1A;
pub const OP_LOCAL_TEE : u8 = 0x22;
pub const OP_I64_ADD : u8 = 0x7C;

/// Unsigned LEB128 of v into out at at; returns the new offset. The low 7 bits
/// go out first with the continuation bit set while anything remains above them.
pub fn uleb(out: []u8, at: usize, v: u64) -> usize {
    var n : usize = at;
    var x : u64 = v;
    while (x >= 0x80) {
        out[n] = @intCast((x & 0x7F) | 0x80);
        n = n + 1;
        x = x >> 7;
    }
    out[n] = @intCast(x);
    return n + 1;
}

/// Signed LEB128 of v into out at at; returns the new offset. Chunks of 7 go out
/// low first, the continuation bit set while the sign bit of the chunk is not yet
/// the sign of v; the last chunk carries the sign and no continuation.
pub fn sleb(out: []u8, at: usize, v: i64) -> usize {
    var n : usize = at;
    var more : bool = true;
    while (more) {
        var b : u8 = @intCast(v & 0x7F);
        v = v >> 7;
        if ((v == 0 and (b & 0x40) == 0) or (v == -1 and (b & 0x40) != 0)) {
            more = false;
        } else {
            b = b | 0x80;
        }
        out[n] = b;
        n = n + 1;
    }
    return n;
}

/// The byte length of uleb(v) -- the pure half of the encoder, for callers
/// that must know a size before they write it (code_entry, code_section).
pub fn uleb_len(v: u64) -> usize {
    var n : usize = 1;
    var x : u64 = v >> 7;
    while (x > 0) {
        n = n + 1;
        x = x >> 7;
    }
    return n;
}

/// The module preamble: magic and version, 8 bytes, always the same.
pub fn module_preamble(out: []u8, at: usize) -> usize {
    out[at] = MAGIC0;
    out[at + 1] = MAGIC1;
    out[at + 2] = MAGIC2;
    out[at + 3] = MAGIC3;
    out[at + 4] = VERSION1;
    out[at + 5] = 0;
    out[at + 6] = 0;
    out[at + 7] = 0;
    return at + 8;
}

/// One section: the id byte, the uleb128 body length, then the body. Returns the
/// new offset. The body is built first by the caller, so the length is known.
pub fn section(out: []u8, at: usize, id: u8, body: []const u8) -> usize {
    out[at] = id;
    var n : usize = uleb(out, at + 1, body.len as u64);
    var i : usize = 0;
    while (i < body.len) {
        out[n] = body[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// One functype entry for a type section: 0x60, the parameter count, the result
/// count -- the value-type bytes themselves are valtype and functype_full below.
pub fn functype_counts(out: []u8, at: usize, params: u32, results: u32) -> usize {
    out[at] = FUNCTYPE;
    var n : usize = uleb(out, at + 1, params as u64);
    return uleb(out, n, results as u64);
}

/// The value-type byte for a type name: "i32", "i64", "f32" or "f64", or 0
/// for any other name -- no legal value-type byte is 0, so 0 is the
/// fail-closed answer valtype and local_group both read. The byte map lives
/// here and nowhere else.
pub fn valtype_byte(name: []const u8) -> u8 {
    if (name.len == 3 and name[0] == 'i' and name[1] == '3' and name[2] == '2') {
        return VT_I32;
    }
    if (name.len == 3 and name[0] == 'i' and name[1] == '6' and name[2] == '4') {
        return VT_I64;
    }
    if (name.len == 3 and name[0] == 'f' and name[1] == '3' and name[2] == '2') {
        return VT_F32;
    }
    if (name.len == 3 and name[0] == 'f' and name[1] == '6' and name[2] == '4') {
        return VT_F64;
    }
    return 0;
}

/// The value-type byte for a type name: "i32", "i64", "f32" or "f64". Fail
/// closed: any other name writes nothing and returns at unchanged.
pub fn valtype(out: []u8, at: usize, name: []const u8) -> usize {
    var vt : u8 = valtype_byte(name);
    if (vt == 0) {
        return at;
    }
    out[at] = vt;
    return at + 1;
}

/// One full functype entry: 0x60, the uleb parameter count, one valtype byte per
/// parameter, the uleb result count, one valtype byte per result. The params and
/// results slices carry the bytes themselves, one per type, as valtype mapped
/// them -- t27 has no slice of slices (#9103), so the name-to-byte mapping stays
/// at the valtype boundary and this fn speaks bytes only.
pub fn functype_full(out: []u8, at: usize, params: []const u8, results: []const u8) -> usize {
    out[at] = FUNCTYPE;
    var n : usize = uleb(out, at + 1, params.len as u64);
    var i : usize = 0;
    while (i < params.len) {
        out[n] = params[i];
        n = n + 1;
        i = i + 1;
    }
    n = uleb(out, n, results.len as u64);
    i = 0;
    while (i < results.len) {
        out[n] = results[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// One code-section entry: the uleb size, then the uleb locals-group count, then
/// the body. The size covers everything after itself and nothing else: the bytes
/// of uleb(locals_n) plus the body bytes. The body carries the local groups (a
/// uleb count and a valtype byte per group), the instructions and the 0x0B end
/// byte -- the entry adds no byte of its own after the body.
pub fn code_entry(out: []u8, at: usize, locals_n: u32, body: []const u8) -> usize {
    var size : u64 = (uleb_len(locals_n as u64) + body.len) as u64;
    var n : usize = uleb(out, at, size);
    n = uleb(out, n, locals_n as u64);
    var i : usize = 0;
    while (i < body.len) {
        out[n] = body[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// One locals group for a code-entry body: the uleb count, then the valtype
/// byte of the group's type. The byte comes through the existing valtype map --
/// the name is probed against it first -- and the group fails closed the same
/// way: an unknown name writes nothing and the offset stands.
pub fn local_group(out: []u8, at: usize, count: u32, valtype_name: []const u8) -> usize {
    var vt : u8 = valtype_byte(valtype_name);
    if (vt == 0) {
        return at;
    }
    var n : usize = uleb(out, at, count as u64);
    out[n] = vt;
    return n + 1;
}

/// One function-section entry: the uleb type index. The function section body
/// is a vector of these -- vec_prefix(functions) then one entry per function.
pub fn func_entry(out: []u8, at: usize, type_index: u32) -> usize {
    return uleb(out, at, type_index as u64);
}

/// The vector prefix: the uleb count that opens a vector body (the type, the
/// function and the code section bodies are all vectors). The callers append
/// the entries themselves -- t27 has no fn pointers to pass an encoder.
pub fn vec_prefix(out: []u8, at: usize, count: u32) -> usize {
    return uleb(out, at, count as u64);
}

/// The code section: section(SEC_CODE, vec_prefix(count) + entries_joined),
/// composed in place -- the emitter contract allows no intermediate
/// allocation. The body length (the prefix bytes plus the joined entries) is
/// known before anything moves, so the body is written at its final address
/// (after the id byte and the uleb body length) and framed last. The entries
/// arrive pre-joined, one after another, each already a size-prefixed
/// code_entry; this fn adds the vector count and the section frame and
/// nothing else. entries_joined must not lie inside the section's own byte
/// range -- build it in the caller's scratch, as the tests do.
pub fn code_section(out: []u8, at: usize, count: u32, entries_joined: []const u8) -> usize {
    var body_len : u64 = (uleb_len(count as u64) + entries_joined.len) as u64;
    var hl : usize = uleb_len(body_len);
    out[at] = SEC_CODE;
    var k : usize = uleb(out, at + 1, body_len);
    var n : usize = vec_prefix(out, at + 1 + hl, count);
    var i : usize = 0;
    while (i < entries_joined.len) {
        out[n] = entries_joined[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// i32.const: the opcode 0x41, then the sleb128 immediate (floor 1's sleb).
pub fn i32_const(out: []u8, at: usize, v: i32) -> usize {
    out[at] = OP_I32_CONST;
    return sleb(out, at + 1, v as i64);
}

/// local.get: the opcode 0x20, then the uleb local index.
pub fn local_get(out: []u8, at: usize, idx: u32) -> usize {
    out[at] = OP_LOCAL_GET;
    return uleb(out, at + 1, idx as u64);
}

/// local.set: the opcode 0x21, then the uleb local index.
pub fn local_set(out: []u8, at: usize, idx: u32) -> usize {
    out[at] = OP_LOCAL_SET;
    return uleb(out, at + 1, idx as u64);
}

/// i32.add: the opcode 0x6A, no immediate.
pub fn i32_add(out: []u8, at: usize) -> usize {
    out[at] = OP_I32_ADD;
    return at + 1;
}

/// end: the opcode 0x0B -- the last byte of every expression and code entry.
pub fn end(out: []u8, at: usize) -> usize {
    out[at] = OP_END;
    return at + 1;
}

// -- Floor 4: the constant-leaf emitter's law (epic #11840 M-A), ported from
// the working reference emitter -- every vector below is one its battery or
// unit tests pinned against Node's WebAssembly. --

/// i64.const: the opcode 0x42, then the sleb128 immediate. A u64 constant at
/// or above 2^63 crosses as the same bit pattern read signed -- the caller
/// wraps it before calling, the varint has no other valid encoding.
pub fn i64_const(out: []u8, at: usize, v: i64) -> usize {
    out[at] = OP_I64_CONST;
    return sleb(out, at + 1, v);
}

/// f32.const: the opcode 0x43, then the four IEEE-754 bytes, little-endian.
pub fn f32_const(out: []u8, at: usize, bits: u32) -> usize {
    out[at] = OP_F32_CONST;
    out[at + 1] = @intCast(bits & 0xFF);
    out[at + 2] = @intCast((bits >> 8) & 0xFF);
    out[at + 3] = @intCast((bits >> 16) & 0xFF);
    out[at + 4] = @intCast((bits >> 24) & 0xFF);
    return at + 5;
}

/// f64.const: the opcode 0x44, then the eight IEEE-754 bytes, little-endian.
pub fn f64_const(out: []u8, at: usize, bits: u64) -> usize {
    out[at] = OP_F64_CONST;
    var i : usize = 0;
    while (i < 8) {
        out[at + 1 + i] = @intCast((bits >> (8 * i)) & 0xFF);
        i = i + 1;
    }
    return at + 9;
}

/// The section header alone: the id byte, then the uleb128 body length -- the
/// framing of `section` without the copy, for a caller whose payload already
/// lives where it belongs and rides after the header.
pub fn section_header(out: []u8, at: usize, id: u8, body_len: u64) -> usize {
    out[at] = id;
    return uleb(out, at + 1, body_len);
}

/// One export-section entry: the uleb name length, the name bytes, the kind
/// byte 0x00 (func), the uleb function index. The index is the FUNCTION
/// index (the position in the function section), not the type index.
pub fn export_entry(out: []u8, at: usize, name: []const u8, index: u32) -> usize {
    var n : usize = uleb(out, at, name.len as u64);
    var i : usize = 0;
    while (i < name.len) {
        out[n] = name[i];
        n = n + 1;
        i = i + 1;
    }
    out[n] = 0x00;
    return uleb(out, n + 1, index as u64);
}

test uleb_canonical_vectors {
    var buf : [8]u8 = undefined;
    assert uleb(buf[0..8], 0, 0) == 1 and buf[0] == 0x00;
    assert uleb(buf[0..8], 0, 127) == 1 and buf[0] == 0x7F;
    // the textbook vector: 624485 encodes E5 8E 26
    assert uleb(buf[0..8], 0, 624485) == 3 and buf[0] == 0xE5 and buf[1] == 0x8E and buf[2] == 0x26;
    // 128 needs a continuation: 80 01
    assert uleb(buf[0..8], 0, 128) == 2 and buf[0] == 0x80 and buf[1] == 0x01;
}

test sleb_canonical_vectors {
    var buf : [8]u8 = undefined;
    assert sleb(buf[0..8], 0, -1) == 1 and buf[0] == 0x7F;
    assert sleb(buf[0..8], 0, 64) == 2 and buf[0] == 0xC0 and buf[1] == 0x00;
    assert sleb(buf[0..8], 0, 63) == 1 and buf[0] == 0x3F;
    assert sleb(buf[0..8], 0, -64) == 1 and buf[0] == 0x40;
    // the reference emitter's vectors (cli/t27b/src/wasm32_emitter.rs,
    // leb128_signed_edges), ported with the fix
    assert sleb(buf[0..8], 0, 0) == 1 and buf[0] == 0x00;
    assert sleb(buf[0..8], 0, 1) == 1 and buf[0] == 0x01;
    assert sleb(buf[0..8], 0, 42) == 1 and buf[0] == 0x2A;
    assert sleb(buf[0..8], 0, -65) == 2 and buf[0] == 0xBF and buf[1] == 0x7F;
    assert sleb(buf[0..8], 0, -123456) == 3 and buf[0] == 0xC0 and buf[1] == 0xBB and buf[2] == 0x78;
}

test module_preamble_is_magic_and_version_one {
    var buf : [8]u8 = undefined;
    assert module_preamble(buf[0..8], 0) == 8;
    assert buf[0] == 0x00 and buf[1] == 0x61 and buf[2] == 0x73 and buf[3] == 0x6D;
    assert buf[4] == 0x01 and buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x00;
}

test section_frames_id_length_body_and_functype_counts {
    var body : [3]u8 = [7, 8, 9];
    var buf : [136]u8 = undefined;
    const n : usize = section(buf[0..136], 0, SEC_TYPE, body[0..3]);
    assert n == 5;
    assert buf[0] == SEC_TYPE and buf[1] == 0x03;
    assert buf[2] == 7 and buf[3] == 8 and buf[4] == 9;
    // the counts: functype prefix, then uleb of each count
    const m : usize = functype_counts(buf[0..136], 0, 1, 1);
    assert m == 3 and buf[0] == 0x60 and buf[1] == 0x01 and buf[2] == 0x01;
    // a body of 130 bytes takes a two-byte uleb length: id, 82 01, then the body
    var big : [130]u8 = undefined;
    var i : usize = 0;
    while (i < 130) { big[i] = 0; i = i + 1; }
    const w : usize = section(buf[0..136], 0, SEC_FUNC, big[0..130]);
    assert w == 133 and buf[1] == 0x82 and buf[2] == 0x01;
}

test valtype_names_map_to_bytes_and_fail_closed {
    var buf : [8]u8 = undefined;
    var i : usize = 0;
    while (i < 8) { buf[i] = 0xAA; i = i + 1; }
    assert VT_I32 == 0x7F and VT_I64 == 0x7E and VT_F32 == 0x7D and VT_F64 == 0x7C;
    // the const-opcode family is a different family: 0x43/0x44 are f32.const/f64.const,
    // never the value-type bytes of f32/f64
    assert OP_F32_CONST == 0x43 and OP_F64_CONST == 0x44;
    assert VT_F32 != OP_F32_CONST and VT_F64 != OP_F64_CONST;
    assert valtype(buf[0..8], 0, "i32") == 1 and buf[0] == 0x7F;
    assert valtype(buf[0..8], 0, "i64") == 1 and buf[0] == 0x7E;
    assert valtype(buf[0..8], 0, "f32") == 1 and buf[0] == 0x7D;
    assert valtype(buf[0..8], 0, "f64") == 1 and buf[0] == 0x7C;
    // fail closed: an unknown name, a wrong-length name -- nothing written, at stands
    assert valtype(buf[0..8], 5, "v128") == 5 and buf[5] == 0xAA;
    assert valtype(buf[0..8], 5, "i8") == 5 and buf[5] == 0xAA;
    assert valtype(buf[0..8], 5, buf[3..3]) == 5 and buf[5] == 0xAA;
}

test functype_full_pins_the_valtype_bytes {
    var buf : [16]u8 = undefined;
    // (i32) -> (i32): 60 01 7F 01 7F
    var p : [1]u8 = [VT_I32];
    var r : [1]u8 = [VT_I32];
    const n : usize = functype_full(buf[0..16], 0, p[0..1], r[0..1]);
    assert n == 5;
    assert buf[0] == 0x60 and buf[1] == 0x01 and buf[2] == 0x7F and buf[3] == 0x01 and buf[4] == 0x7F;
    // (i32, i32) -> (): 60 02 7F 7F 00 -- an empty result vector is the count 00
    var p2 : [2]u8 = [VT_I32, VT_I32];
    var e : [1]u8 = [0];
    const m : usize = functype_full(buf[0..16], 0, p2[0..2], e[0..0]);
    assert m == 5;
    assert buf[0] == 0x60 and buf[1] == 0x02 and buf[2] == 0x7F and buf[3] == 0x7F and buf[4] == 0x00;
}

test code_entry_frames_locals_body_and_end {
    var buf : [8]u8 = undefined;
    // zero local groups, the body is the 0x0B end alone: size 02, locals 00, end 0B
    var body : [1]u8 = [0x0B];
    const n : usize = code_entry(buf[0..8], 0, 0, body[0..1]);
    assert n == 3;
    assert buf[0] == 0x02 and buf[1] == 0x00 and buf[2] == 0x0B;
    // one local group of two i32 locals: the count 01, the group 02 7F, the end 0B,
    // and the size byte 04 covering all three -- nothing more, nothing less
    var g : [3]u8 = [0x02, 0x7F, 0x0B];
    const m : usize = code_entry(buf[0..8], 0, 1, g[0..3]);
    assert m == 5;
    assert buf[0] == 0x04 and buf[1] == 0x01 and buf[2] == 0x02 and buf[3] == 0x7F and buf[4] == 0x0B;
}

test code_entry_size_is_honest_past_one_twenty_seven {
    // 130 body bytes plus the one locals-count byte = size 131, a two-byte uleb: 83 01
    var body : [130]u8 = undefined;
    var i : usize = 0;
    while (i < 130) { body[i] = 0; i = i + 1; }
    var buf : [133]u8 = undefined;
    const n : usize = code_entry(buf[0..133], 0, 0, body[0..130]);
    assert n == 133;
    assert buf[0] == 0x83 and buf[1] == 0x01 and buf[2] == 0x00 and buf[132] == 0;
}

test local_group_pins_count_then_valtype_and_fails_closed {
    var buf : [8]u8 = undefined;
    var i : usize = 0;
    while (i < 8) { buf[i] = 0xAA; i = i + 1; }
    // two i32 locals: the uleb count 02, then the valtype byte 7F
    const a : usize = local_group(buf[0..8], 0, 2, "i32");
    assert a == 2 and buf[0] == 0x02 and buf[1] == 0x7F;
    // zero locals of i64: the count 00, then 7E
    const b : usize = local_group(buf[0..8], 0, 0, "i64");
    assert b == 2 and buf[0] == 0x00 and buf[1] == 0x7E;
    // a count past 127 still lands the valtype byte after the two-byte uleb
    const c : usize = local_group(buf[0..8], 0, 200, "f32");
    assert c == 3 and buf[0] == 0xC8 and buf[1] == 0x01 and buf[2] == VT_F32;
    // fail closed: an unknown name writes nothing and the offset stands
    const d : usize = local_group(buf[0..8], 5, 1, "v128");
    assert d == 5 and buf[5] == 0xAA;
}

test func_entry_and_vec_prefix_are_the_uleb_vector_pieces {
    var buf : [8]u8 = undefined;
    assert vec_prefix(buf[0..8], 0, 0) == 1 and buf[0] == 0x00;
    assert vec_prefix(buf[0..8], 0, 1) == 1 and buf[0] == 0x01;
    assert vec_prefix(buf[0..8], 0, 200) == 2 and buf[0] == 0xC8 and buf[1] == 0x01;
    // a function-section entry is the uleb type index, nothing else
    assert func_entry(buf[0..8], 0, 0) == 1 and buf[0] == 0x00;
    assert func_entry(buf[0..8], 0, 7) == 1 and buf[0] == 0x07;
    assert func_entry(buf[0..8], 0, 200) == 2 and buf[0] == 0xC8 and buf[1] == 0x01;
}

test code_section_frames_the_entry_vector {
    var buf : [32]u8 = undefined;
    // one pre-built entry -- size 04, locals 00, i32.const 42, end -- under the frame:
    // the id 0A, the body length 06, the vector count 01, then the entry untouched
    var one : [5]u8 = [0x04, 0x00, 0x41, 0x2A, 0x0B];
    const n : usize = code_section(buf[0..32], 0, 1, one[0..5]);
    assert n == 8;
    assert buf[0] == 0x0A and buf[1] == 0x06 and buf[2] == 0x01;
    assert buf[3] == 0x04 and buf[4] == 0x00 and buf[5] == 0x41 and buf[6] == 0x2A and buf[7] == 0x0B;
    // two entries joined; the body is the count 02 plus eight bytes = 9
    var two : [8]u8 = [0x02, 0x00, 0x0B, 0x04, 0x00, 0x41, 0x2A, 0x0B];
    const m : usize = code_section(buf[0..32], 0, 2, two[0..8]);
    assert m == 11;
    assert buf[0] == 0x0A and buf[1] == 0x09 and buf[2] == 0x02;
    assert buf[3] == 0x02 and buf[4] == 0x00 and buf[5] == 0x0B;
    assert buf[6] == 0x04 and buf[7] == 0x00 and buf[8] == 0x41 and buf[9] == 0x2A and buf[10] == 0x0B;
}

test instruction_floor_pins_the_opcode_bytes {
    var buf : [8]u8 = undefined;
    assert OP_LOCAL_GET == 0x20 and OP_LOCAL_SET == 0x21 and OP_I32_CONST == 0x41;
    assert OP_I32_ADD == 0x6A and OP_END == 0x0B;
    // i32.const 42: the opcode, then the one-byte sleb (42 carries no 0x40 sign bit)
    const a : usize = i32_const(buf[0..8], 0, 42);
    assert a == 2 and buf[0] == 0x41 and buf[1] == 0x2A;
    const b : usize = i32_const(buf[0..8], 0, -1);
    assert b == 2 and buf[0] == 0x41 and buf[1] == 0x7F;
    // 64 does not fit one sleb byte: C0 00 (floor 1's vector)
    const c : usize = i32_const(buf[0..8], 0, 64);
    assert c == 3 and buf[0] == 0x41 and buf[1] == 0xC0 and buf[2] == 0x00;
    // -123456: the textbook signed vector C0 BB 78
    const d : usize = i32_const(buf[0..8], 0, -123456);
    assert d == 4 and buf[0] == 0x41 and buf[1] == 0xC0 and buf[2] == 0xBB and buf[3] == 0x78;
    // local.get and local.set carry the uleb local index
    const g : usize = local_get(buf[0..8], 0, 0);
    assert g == 2 and buf[0] == 0x20 and buf[1] == 0x00;
    const g2 : usize = local_get(buf[0..8], 0, 128);
    assert g2 == 3 and buf[0] == 0x20 and buf[1] == 0x80 and buf[2] == 0x01;
    const s : usize = local_set(buf[0..8], 0, 1);
    assert s == 2 and buf[0] == 0x21 and buf[1] == 0x01;
    const s2 : usize = local_set(buf[0..8], 0, 128);
    assert s2 == 3 and buf[0] == 0x21 and buf[1] == 0x80 and buf[2] == 0x01;
    // the bare opcodes
    assert i32_add(buf[0..8], 0) == 1 and buf[0] == 0x6A;
    assert end(buf[0..8], 0) == 1 and buf[0] == 0x0B;
}

test expression_composes_the_instruction_floor {
    var buf : [8]u8 = undefined;
    var n : usize = i32_const(buf[0..8], 0, 7);
    n = local_set(buf[0..8], n, 0);
    n = local_get(buf[0..8], n, 0);
    n = i32_add(buf[0..8], n);
    n = end(buf[0..8], n);
    assert n == 8;
    assert buf[0] == 0x41 and buf[1] == 0x07;
    assert buf[2] == 0x21 and buf[3] == 0x00;
    assert buf[4] == 0x20 and buf[5] == 0x00;
    assert buf[6] == 0x6A and buf[7] == 0x0B;
}

test whole_module_minimal_pins_every_byte {
    var buf : [64]u8 = undefined;
    // the type section body: one functype () -> ()
    var type_body : [8]u8 = undefined;
    var tb_n : usize = vec_prefix(type_body[0..8], 0, 1);
    tb_n = functype_counts(type_body[0..8], tb_n, 0, 0);
    // the function section body: one function, type index 0
    var func_body : [4]u8 = undefined;
    var fb_n : usize = vec_prefix(func_body[0..4], 0, 1);
    fb_n = func_entry(func_body[0..4], fb_n, 0);
    // the one code entry: zero local groups, the expression i32.const 42, end
    var expr : [8]u8 = undefined;
    var ex_n : usize = i32_const(expr[0..8], 0, 42);
    ex_n = end(expr[0..8], ex_n);
    var entry : [8]u8 = undefined;
    var ce_n : usize = code_entry(entry[0..8], 0, 0, expr[0..ex_n]);
    // compose: preamble, type section, function section, code section
    var n : usize = module_preamble(buf[0..64], 0);
    n = section(buf[0..64], n, SEC_TYPE, type_body[0..tb_n]);
    n = section(buf[0..64], n, SEC_FUNC, func_body[0..fb_n]);
    n = code_section(buf[0..64], n, 1, entry[0..ce_n]);
    // 8 preamble + 6 type + 4 function + 8 code = 26 bytes, every one pinned
    assert n == 26;
    assert buf[0] == 0x00 and buf[1] == 0x61 and buf[2] == 0x73 and buf[3] == 0x6D;
    assert buf[4] == 0x01 and buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x00;
    assert buf[8] == 0x01 and buf[9] == 0x04 and buf[10] == 0x01 and buf[11] == 0x60;
    assert buf[12] == 0x00 and buf[13] == 0x00;
    assert buf[14] == 0x03 and buf[15] == 0x02 and buf[16] == 0x01 and buf[17] == 0x00;
    assert buf[18] == 0x0A and buf[19] == 0x06 and buf[20] == 0x01 and buf[21] == 0x04;
    assert buf[22] == 0x00 and buf[23] == 0x41 and buf[24] == 0x2A and buf[25] == 0x0B;
}

test whole_module_with_result_composes_valid_shape {
    // the same module with the functype () -> (i32): the type section entry is
    // 60 00 01 7F, the body 01 60 00 01 7F, the section 01 05 ... -- this is
    // the byte shape wasm validation accepts (the stack is empty at end)
    var buf : [64]u8 = undefined;
    var type_body : [8]u8 = undefined;
    var empty : [1]u8 = [0];
    var r_i32 : [1]u8 = [VT_I32];
    var tb_n : usize = vec_prefix(type_body[0..8], 0, 1);
    tb_n = functype_full(type_body[0..8], tb_n, empty[0..0], r_i32[0..1]);
    var func_body : [4]u8 = undefined;
    var fb_n : usize = vec_prefix(func_body[0..4], 0, 1);
    fb_n = func_entry(func_body[0..4], fb_n, 0);
    var expr : [8]u8 = undefined;
    var ex_n : usize = i32_const(expr[0..8], 0, 42);
    ex_n = end(expr[0..8], ex_n);
    var entry : [8]u8 = undefined;
    var ce_n : usize = code_entry(entry[0..8], 0, 0, expr[0..ex_n]);
    var n : usize = module_preamble(buf[0..64], 0);
    n = section(buf[0..64], n, SEC_TYPE, type_body[0..tb_n]);
    n = section(buf[0..64], n, SEC_FUNC, func_body[0..fb_n]);
    n = code_section(buf[0..64], n, 1, entry[0..ce_n]);
    // 8 preamble + 7 type + 4 function + 8 code = 27 bytes
    assert n == 27;
    assert buf[0] == 0x00 and buf[1] == 0x61 and buf[2] == 0x73 and buf[3] == 0x6D;
    assert buf[4] == 0x01 and buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x00;
    assert buf[8] == 0x01 and buf[9] == 0x05 and buf[10] == 0x01 and buf[11] == 0x60;
    assert buf[12] == 0x00 and buf[13] == 0x01 and buf[14] == 0x7F;
    assert buf[15] == 0x03 and buf[16] == 0x02 and buf[17] == 0x01 and buf[18] == 0x00;
    assert buf[19] == 0x0A and buf[20] == 0x06 and buf[21] == 0x01 and buf[22] == 0x04;
    assert buf[23] == 0x00 and buf[24] == 0x41 and buf[25] == 0x2A and buf[26] == 0x0B;
}

// -- Floor 4 tests: every vector here is one the working reference emitter
// (cli/t27b/src/wasm32_emitter.rs, PR #11942) pinned in Rust and Node's
// WebAssembly instantiated 100/100 (tests/wasm32_equality.rs). --

test i64_const_pins_the_0x42_opcode_and_sleb_immediate {
    var buf : [8]u8 = undefined;
    // the reference's i64_uses_the_i64_const_opcode_and_signed_leb: i64.const -7 is 42 79
    const a : usize = i64_const(buf[0..8], 0, -7);
    assert a == 2 and buf[0] == 0x42 and buf[1] == 0x79;
    const b : usize = i64_const(buf[0..8], 0, 42);
    assert b == 2 and buf[0] == 0x42 and buf[1] == 0x2A;
    const c : usize = i64_const(buf[0..8], 0, 0);
    assert c == 2 and buf[0] == 0x42 and buf[1] == 0x00;
    const d : usize = i64_const(buf[0..8], 0, -1);
    assert d == 2 and buf[0] == 0x42 and buf[1] == 0x7F;
    // a value past one sleb byte: 64 takes C0 00 after the opcode
    const e : usize = i64_const(buf[0..8], 0, 64);
    assert e == 3 and buf[0] == 0x42 and buf[1] == 0xC0 and buf[2] == 0x00;
}

test f32_const_writes_the_le_bit_pattern {
    var buf : [8]u8 = undefined;
    // 1.0f32 = 0x3F800000, little-endian: 43 00 00 80 3F
    const a : usize = f32_const(buf[0..8], 0, 0x3F800000);
    assert a == 5;
    assert buf[0] == 0x43 and buf[1] == 0x00 and buf[2] == 0x00 and buf[3] == 0x80 and buf[4] == 0x3F;
    // 2.0f32 = 0x40000000
    const b : usize = f32_const(buf[0..8], 0, 0x40000000);
    assert b == 5;
    assert buf[0] == 0x43 and buf[1] == 0x00 and buf[2] == 0x00 and buf[3] == 0x00 and buf[4] == 0x40;
    // -0.5f32 = 0xBF000000 -- the reference's every_scalar_return_type case
    const c : usize = f32_const(buf[0..8], 0, 0xBF000000);
    assert c == 5;
    assert buf[0] == 0x43 and buf[1] == 0x00 and buf[2] == 0x00 and buf[3] == 0x00 and buf[4] == 0xBF;
}

test f64_const_writes_the_le_bit_pattern {
    var buf : [16]u8 = undefined;
    var i : usize = 0;
    while (i < 16) { buf[i] = 0xAA; i = i + 1; }
    // 3.5f64 = 0x400C000000000000, little-endian: 44 then 00 00 00 00 00 00 0C 40
    const a : usize = f64_const(buf[0..16], 0, 0x400C000000000000);
    assert a == 9;
    assert buf[0] == 0x44;
    assert buf[1] == 0x00 and buf[2] == 0x00 and buf[3] == 0x00 and buf[4] == 0x00;
    assert buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x0C and buf[8] == 0x40;
    // nothing past the ninth byte moved
    assert buf[9] == 0xAA;
    // 1.5f64 = 0x3FF8000000000000 -- the mantissa top nibble rides byte 6 (0xF8)
    const b : usize = f64_const(buf[0..16], 0, 0x3FF8000000000000);
    assert b == 9;
    assert buf[7] == 0xF8 and buf[8] == 0x3F;
}

test uleb_len_and_valtype_byte_are_the_pure_halves {
    assert uleb_len(0) == 1 and uleb_len(127) == 1;
    assert uleb_len(128) == 2 and uleb_len(16383) == 2;
    assert uleb_len(16384) == 3 and uleb_len(624485) == 3;
    assert valtype_byte("i32") == VT_I32 and valtype_byte("i64") == VT_I64;
    assert valtype_byte("f32") == VT_F32 and valtype_byte("f64") == VT_F64;
    assert valtype_byte("v128") == 0 and valtype_byte("i8") == 0 and valtype_byte("") == 0;
}

test section_header_frames_id_and_length_alone {
    var buf : [8]u8 = undefined;
    var i : usize = 0;
    while (i < 8) { buf[i] = 0xAA; i = i + 1; }
    const a : usize = section_header(buf[0..8], 0, SEC_EXPORT, 14);
    assert a == 2 and buf[0] == 0x07 and buf[1] == 0x0E and buf[2] == 0xAA;
    // a 130-byte body takes the two-byte uleb: 82 01
    const b : usize = section_header(buf[0..8], 0, SEC_TYPE, 130);
    assert b == 3 and buf[0] == 0x01 and buf[1] == 0x82 and buf[2] == 0x01;
}

test export_entry_pins_name_kind_and_function_index {
    var buf : [16]u8 = undefined;
    var i : usize = 0;
    while (i < 16) { buf[i] = 0xAA; i = i + 1; }
    // "f1" at function index 1: 02 66 31 00 01
    const a : usize = export_entry(buf[0..16], 0, "f1", 1);
    assert a == 5;
    assert buf[0] == 0x02 and buf[1] == 0x66 and buf[2] == 0x31 and buf[3] == 0x00 and buf[4] == 0x01;
    // "the_answer" (10 bytes) at index 0: 0A <name> 00 00 -- the reference's export
    const b : usize = export_entry(buf[0..16], 0, "the_answer", 0);
    assert b == 13;
    assert buf[0] == 0x0A and buf[1] == 0x74 and buf[2] == 0x68 and buf[3] == 0x65 and buf[4] == 0x5F;
    assert buf[5] == 0x61 and buf[6] == 0x6E and buf[7] == 0x73 and buf[8] == 0x77 and buf[9] == 0x65;
    assert buf[10] == 0x72 and buf[11] == 0x00 and buf[12] == 0x00;
}

test whole_module_exporting_the_answer_pins_all_43_bytes {
    // The reference's one_i32_fn_is_the_exact_module: `pub fn the_answer() -> i32
    // { return 42; }`, byte for byte, composed through the floor fns.
    var buf : [48]u8 = undefined;
    var i : usize = 0;
    while (i < 48) { buf[i] = 0xAA; i = i + 1; }
    // type section body: one () -> i32
    var tb : [8]u8 = undefined;
    var empty : [1]u8 = [0];
    var r : [1]u8 = [VT_I32];
    var tn : usize = vec_prefix(tb[0..8], 0, 1);
    tn = functype_full(tb[0..8], tn, empty[0..0], r[0..1]);
    // function section body: one fn of type 0
    var fb : [4]u8 = undefined;
    var fn_n : usize = vec_prefix(fb[0..4], 0, 1);
    fn_n = func_entry(fb[0..4], fn_n, 0);
    // export section body: the_answer, kind func, index 0
    var eb : [16]u8 = undefined;
    var en : usize = vec_prefix(eb[0..16], 0, 1);
    en = export_entry(eb[0..16], en, "the_answer", 0);
    // the one code entry: locals 0, i32.const 42, end
    var x : [8]u8 = undefined;
    var xn : usize = i32_const(x[0..8], 0, 42);
    xn = end(x[0..8], xn);
    var entry : [8]u8 = undefined;
    var ce : usize = code_entry(entry[0..8], 0, 0, x[0..xn]);
    // compose
    var n : usize = module_preamble(buf[0..48], 0);
    n = section(buf[0..48], n, SEC_TYPE, tb[0..tn]);
    n = section(buf[0..48], n, SEC_FUNC, fb[0..fn_n]);
    n = section(buf[0..48], n, SEC_EXPORT, eb[0..en]);
    n = code_section(buf[0..48], n, 1, entry[0..ce]);
    assert n == 43;
    assert buf[0] == 0x00 and buf[1] == 0x61 and buf[2] == 0x73 and buf[3] == 0x6D;
    assert buf[4] == 0x01 and buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x00;
    assert buf[8] == 0x01 and buf[9] == 0x05 and buf[10] == 0x01 and buf[11] == 0x60;
    assert buf[12] == 0x00 and buf[13] == 0x01 and buf[14] == 0x7F;
    assert buf[15] == 0x03 and buf[16] == 0x02 and buf[17] == 0x01 and buf[18] == 0x00;
    assert buf[19] == 0x07 and buf[20] == 0x0E and buf[21] == 0x01;
    assert buf[22] == 0x0A and buf[23] == 0x74 and buf[24] == 0x68 and buf[25] == 0x65;
    assert buf[26] == 0x5F and buf[27] == 0x61 and buf[28] == 0x6E and buf[29] == 0x73;
    assert buf[30] == 0x77 and buf[31] == 0x65 and buf[32] == 0x72;
    assert buf[33] == 0x00 and buf[34] == 0x00;
    assert buf[35] == 0x0A and buf[36] == 0x06 and buf[37] == 0x01 and buf[38] == 0x04;
    assert buf[39] == 0x00 and buf[40] == 0x41 and buf[41] == 0x2A and buf[42] == 0x0B;
}

test whole_module_two_exports_i64_and_f64_composes {
    // two constant leaves -- big() -> i64 (-7) and f1() -> f64 (3.5) -- through
    // the same composition: 8 preamble + 11 type + 5 function + 14 export + 20 code
    var buf : [64]u8 = undefined;
    var tb : [12]u8 = undefined;
    var empty : [1]u8 = [0];
    var r0 : [1]u8 = [VT_I64];
    var r1 : [1]u8 = [VT_F64];
    var tn : usize = vec_prefix(tb[0..12], 0, 2);
    tn = functype_full(tb[0..12], tn, empty[0..0], r0[0..1]);
    tn = functype_full(tb[0..12], tn, empty[0..0], r1[0..1]);
    var fb : [4]u8 = undefined;
    var fn_n : usize = vec_prefix(fb[0..4], 0, 2);
    fn_n = func_entry(fb[0..4], fn_n, 0);
    fn_n = func_entry(fb[0..4], fn_n, 1);
    var eb : [16]u8 = undefined;
    var en : usize = vec_prefix(eb[0..16], 0, 2);
    en = export_entry(eb[0..16], en, "big", 0);
    en = export_entry(eb[0..16], en, "f1", 1);
    var x0 : [8]u8 = undefined;
    var x0n : usize = i64_const(x0[0..8], 0, -7);
    x0n = end(x0[0..8], x0n);
    var x1 : [16]u8 = undefined;
    var x1n : usize = f64_const(x1[0..16], 0, 0x400C000000000000);
    x1n = end(x1[0..16], x1n);
    var e0 : [8]u8 = undefined;
    var e0n : usize = code_entry(e0[0..8], 0, 0, x0[0..x0n]);
    var e1 : [16]u8 = undefined;
    var e1n : usize = code_entry(e1[0..16], 0, 0, x1[0..x1n]);
    var j : [24]u8 = undefined;
    var jn : usize = 0;
    var i : usize = 0;
    while (i < e0n) { j[jn] = e0[i]; jn = jn + 1; i = i + 1; }
    i = 0;
    while (i < e1n) { j[jn] = e1[i]; jn = jn + 1; i = i + 1; }
    var n : usize = module_preamble(buf[0..64], 0);
    n = section(buf[0..64], n, SEC_TYPE, tb[0..tn]);
    n = section(buf[0..64], n, SEC_FUNC, fb[0..fn_n]);
    n = section(buf[0..64], n, SEC_EXPORT, eb[0..en]);
    n = code_section(buf[0..64], n, 2, j[0..jn]);
    assert n == 58;
    assert buf[8] == 0x01 and buf[9] == 0x09 and buf[10] == 0x02;
    assert buf[13] == 0x01 and buf[14] == VT_I64 and buf[18] == VT_F64;
    assert buf[19] == 0x03 and buf[20] == 0x03 and buf[21] == 0x02 and buf[22] == 0x00 and buf[23] == 0x01;
    assert buf[24] == 0x07 and buf[25] == 0x0C and buf[26] == 0x02;
    assert buf[27] == 0x03 and buf[28] == 0x62 and buf[29] == 0x69 and buf[30] == 0x67;
    assert buf[31] == 0x00 and buf[32] == 0x00;
    assert buf[33] == 0x02 and buf[34] == 0x66 and buf[35] == 0x31 and buf[36] == 0x00 and buf[37] == 0x01;
    assert buf[38] == 0x0A and buf[39] == 0x12 and buf[40] == 0x02;
    // entry 0: size 04, locals 00, i64.const -7, end
    assert buf[41] == 0x04 and buf[42] == 0x00 and buf[43] == 0x42 and buf[44] == 0x79 and buf[45] == 0x0B;
    // entry 1: size 0B, locals 00, f64.const 3.5 (LE), end
    assert buf[46] == 0x0B and buf[47] == 0x00 and buf[48] == 0x44;
    assert buf[49] == 0x00 and buf[50] == 0x00 and buf[51] == 0x00 and buf[52] == 0x00;
    assert buf[53] == 0x00 and buf[54] == 0x00 and buf[55] == 0x0C and buf[56] == 0x40;
}


// -- Floor 5: the arithmetic floor the live-closure scalar trio lowers to
// (epic #11840 M-B; live_mode's arrival_frame/latency_ms/paints_due). Same
// house rule as floor 4: every vector is pinned, composition before grammar. --

/// i32.sub: the opcode 0x6B, no immediate; pops rhs then lhs.
pub fn i32_sub(out: []u8, at: usize) -> usize {
    out[at] = OP_I32_SUB;
    return at + 1;
}

/// i32.mul: the opcode 0x6C, no immediate.
pub fn i32_mul(out: []u8, at: usize) -> usize {
    out[at] = OP_I32_MUL;
    return at + 1;
}

/// i32.div_u: the opcode 0x6E, unsigned division; pops rhs then lhs.
pub fn i32_div_u(out: []u8, at: usize) -> usize {
    out[at] = OP_I32_DIV_U;
    return at + 1;
}

/// i32.eqz: the opcode 0x45; zero means true, one byte, no immediate.
pub fn i32_eqz(out: []u8, at: usize) -> usize {
    out[at] = OP_I32_EQZ;
    return at + 1;
}

/// select: the opcode 0x1B; pops the condition, then the false value, then
/// the true value -- the branch-free way a scalar law answers a comparison.
pub fn select(out: []u8, at: usize) -> usize {
    out[at] = OP_SELECT;
    return at + 1;
}

test arithmetic_floor_pins_the_opcode_bytes {
    var b : [8]u8 = undefined;
    assert i32_sub(b[0..8], 0) == 1 and b[0] == 0x6B;
    assert i32_mul(b[0..8], 0) == 1 and b[0] == 0x6C;
    assert i32_div_u(b[0..8], 0) == 1 and b[0] == 0x6E;
    assert i32_eqz(b[0..8], 0) == 1 and b[0] == 0x45;
    assert select(b[0..8], 0) == 1 and b[0] == 0x1B;
}

test param_functype_composes_two_i32_params {
    // (param i32 i32) (result i32): 0x60, vec(2) = i32 i32, vec(1) = i32 --
    // the functype every live-closure scalar export carries.
    var b : [12]u8 = undefined;
    var ps : [2]u8 = [VT_I32, VT_I32];
    var rs : [1]u8 = [VT_I32];
    var n : usize = functype_full(b[0..12], 0, ps[0..2], rs[0..1]);
    assert n == 6;
    assert b[0] == 0x60;
    assert b[1] == 0x02 and b[2] == VT_I32 and b[3] == VT_I32;
    assert b[4] == 0x01 and b[5] == VT_I32;
}

test composes_the_latency_window_body {
    // latency_ms's shape: (painted - emitted + 1) * 16 as a stack program --
    // local.get 1, local.get 0, sub, const 1, add, const 16, mul, end.
    var b : [16]u8 = undefined;
    var n : usize = local_get(b[0..16], 0, 1);
    n = local_get(b[0..16], n, 0);
    n = i32_sub(b[0..16], n);
    n = i32_const(b[0..16], n, 1);
    n = i32_add(b[0..16], n);
    n = i32_const(b[0..16], n, 16);
    n = i32_mul(b[0..16], n);
    n = end(b[0..16], n);
    assert n == 12;
    assert b[0] == 0x20 and b[1] == 0x01;
    assert b[2] == 0x20 and b[3] == 0x00;
    assert b[4] == 0x6B;
    assert b[5] == 0x41 and b[6] == 0x01;
    assert b[7] == 0x6A;
    assert b[8] == 0x41 and b[9] == 0x10;
    assert b[10] == 0x6C;
    assert b[11] == 0x0B;
}

test composes_the_one_paint_window_body {
    // paints_due's shape: select over eqz -- 0 when pending is 0, else 1.
    var b : [8]u8 = undefined;
    var n : usize = i32_const(b[0..8], 0, 0);
    n = i32_const(b[0..8], n, 1);
    n = local_get(b[0..8], n, 0);
    n = i32_eqz(b[0..8], n);
    n = select(b[0..8], n);
    assert n == 8;
    assert b[0] == 0x41 and b[1] == 0x00;
    assert b[2] == 0x41 and b[3] == 0x01;
    assert b[4] == 0x20 and b[5] == 0x00;
    assert b[6] == 0x45;
    assert b[7] == 0x1B;
}


// -- Floor 6: the call/control and i64 stack floor (epic #11840). This is the
// honest merge of PR #11941 onto master's floors 4-5: the fns and vectors that
// branch carried which master had not taken -- export_section framing, the
// call/control family, i64.add, local.tee, drop -- renumbered from the
// branch's "floor 4" to floor 6. Same house rule: every vector pinned,
// composition before grammar. --

/// The export section: section(SEC_EXPORT, vec_prefix(count) + entries_joined),
/// composed in place like the code section -- the body is written at its final
/// address (after the id byte and the uleb body length) and framed last. The
/// entries arrive pre-joined, one after another, each already an export_entry;
/// this fn adds the vector count and the section frame and nothing else.
/// entries_joined must not lie inside the section's own byte range -- build it
/// in the caller's scratch, as the tests do.
pub fn export_section(out: []u8, at: usize, count: u32, entries_joined: []const u8) -> usize {
    var vtmp : [5]u8 = undefined;
    var vl : usize = uleb(vtmp[0..5], 0, count as u64);
    var body_len : u64 = (vl as u64) + (entries_joined.len as u64);
    var htmp : [5]u8 = undefined;
    var hl : usize = uleb(htmp[0..5], 0, body_len);
    var n : usize = vec_prefix(out, at + 1 + hl, count);
    var i : usize = 0;
    while (i < entries_joined.len) {
        out[n] = entries_joined[i];
        n = n + 1;
        i = i + 1;
    }
    out[at] = SEC_EXPORT;
    var k : usize = 0;
    while (k < hl) {
        out[at + 1 + k] = htmp[k];
        k = k + 1;
    }
    return n;
}

/// call: the opcode 0x10, then the uleb function index.
pub fn call(out: []u8, at: usize, func_index: u32) -> usize {
    out[at] = OP_CALL;
    return uleb(out, at + 1, func_index as u64);
}

/// block: the opcode 0x02, then the void blocktype 0x40 -- this floor emits
/// void blocks only, the emitter adds typed blocks when a slice needs them.
pub fn block(out: []u8, at: usize) -> usize {
    out[at] = OP_BLOCK;
    out[at + 1] = BLOCK_VOID;
    return at + 2;
}

/// loop: the opcode 0x03, then the void blocktype 0x40.
pub fn loop(out: []u8, at: usize) -> usize {
    out[at] = OP_LOOP;
    out[at + 1] = BLOCK_VOID;
    return at + 2;
}

/// br: the opcode 0x0C, then the uleb branch depth.
pub fn br(out: []u8, at: usize, depth: u32) -> usize {
    out[at] = OP_BR;
    return uleb(out, at + 1, depth as u64);
}

/// br_if: the opcode 0x0D, then the uleb branch depth (the i32 condition is
/// the emitter's business -- it lies on the stack under this instruction).
pub fn br_if(out: []u8, at: usize, depth: u32) -> usize {
    out[at] = OP_BR_IF;
    return uleb(out, at + 1, depth as u64);
}

/// if: the opcode 0x04, then the void blocktype 0x40. Named if_ -- the bare
/// word is the language's keyword.
pub fn if_(out: []u8, at: usize) -> usize {
    out[at] = OP_IF;
    out[at + 1] = BLOCK_VOID;
    return at + 2;
}

/// else: the opcode 0x05, no immediate. Named else_ for the keyword.
pub fn else_(out: []u8, at: usize) -> usize {
    out[at] = OP_ELSE;
    return at + 1;
}

/// return: the opcode 0x0F, no immediate. Named return_ for the keyword.
pub fn return_(out: []u8, at: usize) -> usize {
    out[at] = OP_RETURN;
    return at + 1;
}

/// i64.add: the opcode 0x7C, no immediate.
pub fn i64_add(out: []u8, at: usize) -> usize {
    out[at] = OP_I64_ADD;
    return at + 1;
}

/// local.tee: the opcode 0x22, then the uleb local index -- it stores and
/// leaves the value, the pair local.set then local.get would emit.
pub fn local_tee(out: []u8, at: usize, idx: u32) -> usize {
    out[at] = OP_LOCAL_TEE;
    return uleb(out, at + 1, idx as u64);
}

/// drop: the opcode 0x1A, no immediate. Named drop_ for the keyword.
pub fn drop_(out: []u8, at: usize) -> usize {
    out[at] = OP_DROP;
    return at + 1;
}

test export_section_frames_the_entry_vector_in_place {
    var buf : [32]u8 = undefined;
    assert SEC_EXPORT == 7 and KIND_FUNC == 0x00;
    // an entry past a one-byte index: export_entry("f", 200) = 01 66 00 C8 01
    var scratch : [8]u8 = undefined;
    var sn : usize = export_entry(scratch[0..8], 0, "f", 200);
    assert sn == 5;
    assert scratch[0] == 0x01 and scratch[1] == 0x66 and scratch[2] == 0x00;
    assert scratch[3] == 0xC8 and scratch[4] == 0x01;
    // the section frame: one joined "answer" entry under the id 07, the body
    // length 0A (the count byte 01 plus the nine entry bytes)
    var one : [9]u8 = [0x06, 0x61, 0x6E, 0x73, 0x77, 0x65, 0x72, 0x00, 0x00];
    const w : usize = export_section(buf[0..32], 0, 1, one[0..9]);
    assert w == 12;
    assert buf[0] == 0x07 and buf[1] == 0x0A and buf[2] == 0x01;
    assert buf[3] == 0x06;
    assert buf[4] == 0x61 and buf[5] == 0x6E and buf[6] == 0x73;
    assert buf[7] == 0x77 and buf[8] == 0x65 and buf[9] == 0x72;
    assert buf[10] == 0x00 and buf[11] == 0x00;
    // two entries joined: the count 02, the body eight bytes, the frame 07 09;
    // the section ends at offset 11: id + length + count + eight entry bytes
    var two : [8]u8 = [0x01, 0x61, 0x00, 0x00, 0x01, 0x62, 0x00, 0x01];
    const t : usize = export_section(buf[0..32], 0, 2, two[0..8]);
    assert t == 11;
    assert buf[0] == 0x07 and buf[1] == 0x09 and buf[2] == 0x02;
    assert buf[3] == 0x01 and buf[4] == 0x61 and buf[5] == 0x00 and buf[6] == 0x00;
    assert buf[7] == 0x01 and buf[8] == 0x62 and buf[9] == 0x00 and buf[10] == 0x01;
}

test call_and_control_flow_pins_the_opcode_bytes {
    var buf : [8]u8 = undefined;
    assert OP_CALL == 0x10 and OP_BLOCK == 0x02 and OP_LOOP == 0x03;
    assert OP_IF == 0x04 and OP_ELSE == 0x05 and OP_BR == 0x0C and OP_BR_IF == 0x0D;
    assert OP_RETURN == 0x0F and BLOCK_VOID == 0x40;
    // call carries the uleb function index
    const c : usize = call(buf[0..8], 0, 0);
    assert c == 2 and buf[0] == 0x10 and buf[1] == 0x00;
    const c2 : usize = call(buf[0..8], 0, 7);
    assert c2 == 2 and buf[0] == 0x10 and buf[1] == 0x07;
    const c3 : usize = call(buf[0..8], 0, 200);
    assert c3 == 3 and buf[0] == 0x10 and buf[1] == 0xC8 and buf[2] == 0x01;
    // block, loop and if open with the void blocktype byte
    const b : usize = block(buf[0..8], 0);
    assert b == 2 and buf[0] == 0x02 and buf[1] == 0x40;
    const l : usize = loop(buf[0..8], 0);
    assert l == 2 and buf[0] == 0x03 and buf[1] == 0x40;
    const i : usize = if_(buf[0..8], 0);
    assert i == 2 and buf[0] == 0x04 and buf[1] == 0x40;
    // br and br_if carry the uleb depth
    const r : usize = br(buf[0..8], 0, 0);
    assert r == 2 and buf[0] == 0x0C and buf[1] == 0x00;
    const r2 : usize = br(buf[0..8], 0, 2);
    assert r2 == 2 and buf[0] == 0x0C and buf[1] == 0x02;
    const r3 : usize = br(buf[0..8], 0, 128);
    assert r3 == 3 and buf[0] == 0x0C and buf[1] == 0x80 and buf[2] == 0x01;
    const bi : usize = br_if(buf[0..8], 0, 1);
    assert bi == 2 and buf[0] == 0x0D and buf[1] == 0x01;
    // the bare opcodes
    assert else_(buf[0..8], 0) == 1 and buf[0] == 0x05;
    assert return_(buf[0..8], 0) == 1 and buf[0] == 0x0F;
}

test tee_drop_and_i64_add_pin_the_opcodes_and_the_wide_immediates {
    var buf : [8]u8 = undefined;
    assert OP_I64_ADD == 0x7C and OP_LOCAL_TEE == 0x22 and OP_DROP == 0x1A;
    // the two i64.const vectors master's floor-4 test does not pin:
    // -123456 is the textbook four-byte C0 BB 78 ...
    const d : usize = i64_const(buf[0..8], 0, -123456);
    assert d == 4 and buf[0] == 0x42 and buf[1] == 0xC0 and buf[2] == 0xBB and buf[3] == 0x78;
    // ... and 2^32 -- a value past 32 bits, the reason the width exists --
    // is the six-byte 80 80 80 80 10
    const e : usize = i64_const(buf[0..8], 0, 4294967296);
    assert e == 6 and buf[0] == 0x42 and buf[1] == 0x80 and buf[2] == 0x80;
    assert buf[3] == 0x80 and buf[4] == 0x80 and buf[5] == 0x10;
    // local.tee carries the uleb index; i64.add and drop are bare
    const t : usize = local_tee(buf[0..8], 0, 0);
    assert t == 2 and buf[0] == 0x22 and buf[1] == 0x00;
    const t2 : usize = local_tee(buf[0..8], 0, 128);
    assert t2 == 3 and buf[0] == 0x22 and buf[1] == 0x80 and buf[2] == 0x01;
    assert i64_add(buf[0..8], 0) == 1 and buf[0] == 0x7C;
    assert drop_(buf[0..8], 0) == 1 and buf[0] == 0x1A;
}

test i64_and_control_expressions_compose {
    var buf : [16]u8 = undefined;
    // i64.add of two locals: i64.const 1, local.set 0, i64.const 2, local.set 1,
    // local.get 0, local.get 1, i64.add, end -- fourteen bytes
    var n : usize = i64_const(buf[0..16], 0, 1);
    n = local_set(buf[0..16], n, 0);
    n = i64_const(buf[0..16], n, 2);
    n = local_set(buf[0..16], n, 1);
    n = local_get(buf[0..16], n, 0);
    n = local_get(buf[0..16], n, 1);
    n = i64_add(buf[0..16], n);
    n = end(buf[0..16], n);
    assert n == 14;
    assert buf[0] == 0x42 and buf[1] == 0x01 and buf[2] == 0x21 and buf[3] == 0x00;
    assert buf[4] == 0x42 and buf[5] == 0x02 and buf[6] == 0x21 and buf[7] == 0x01;
    assert buf[8] == 0x20 and buf[9] == 0x00 and buf[10] == 0x20 and buf[11] == 0x01;
    assert buf[12] == 0x7C and buf[13] == 0x0B;
    // tee and drop: local.get 0, i64.const 7, i64.add, local.tee 0, drop, end
    var m : usize = local_get(buf[0..16], 0, 0);
    m = i64_const(buf[0..16], m, 7);
    m = i64_add(buf[0..16], m);
    m = local_tee(buf[0..16], m, 0);
    m = drop_(buf[0..16], m);
    m = end(buf[0..16], m);
    assert m == 9;
    assert buf[0] == 0x20 and buf[1] == 0x00 and buf[2] == 0x42 and buf[3] == 0x07;
    assert buf[4] == 0x7C and buf[5] == 0x22 and buf[6] == 0x00 and buf[7] == 0x1A;
    assert buf[8] == 0x0B;
    // control: block, i32.const 1, br_if 0, call 7, end, end -- ten bytes
    var k : usize = block(buf[0..16], 0);
    k = i32_const(buf[0..16], k, 1);
    k = br_if(buf[0..16], k, 0);
    k = call(buf[0..16], k, 7);
    k = end(buf[0..16], k);
    k = end(buf[0..16], k);
    assert k == 10;
    assert buf[0] == 0x02 and buf[1] == 0x40 and buf[2] == 0x41 and buf[3] == 0x01;
    assert buf[4] == 0x0D and buf[5] == 0x00 and buf[6] == 0x10 and buf[7] == 0x07;
    assert buf[8] == 0x0B and buf[9] == 0x0B;
}

test whole_module_calling_an_i64_callee_pins_every_byte {
    // The floor-6 capstone, in place of PR #11941's one-export 39-byte module
    // (master's floor-4 capstone already pins that composition): the first
    // TWO-function module -- the callee adds two i64 constants, the exported
    // wrapper's body is one call to it. Sections in ascending id order.
    //   fn0: () -> i64 { i64.const 20 + i64.const 22 }
    //   fn1: () -> i64 { call 0 }          exported as "answer" (index 1)
    var buf : [64]u8 = undefined;
    // the type section body: one functype () -> (i64), both fns share it
    var type_body : [8]u8 = undefined;
    var empty : [1]u8 = [0];
    var r_i64 : [1]u8 = [VT_I64];
    var tb_n : usize = vec_prefix(type_body[0..8], 0, 1);
    tb_n = functype_full(type_body[0..8], tb_n, empty[0..0], r_i64[0..1]);
    // the function section body: two functions, both type index 0
    var func_body : [4]u8 = undefined;
    var fb_n : usize = vec_prefix(func_body[0..4], 0, 2);
    fb_n = func_entry(func_body[0..4], fb_n, 0);
    fb_n = func_entry(func_body[0..4], fb_n, 0);
    // the export section body: one export, the name "answer", index 1
    var export_body : [16]u8 = undefined;
    var eb_n : usize = vec_prefix(export_body[0..16], 0, 1);
    eb_n = export_entry(export_body[0..16], eb_n, "answer", 1);
    // code entry 0: zero local groups, i64.const 20, i64.const 22, i64.add, end
    var expr0 : [8]u8 = undefined;
    var e0_n : usize = i64_const(expr0[0..8], 0, 20);
    e0_n = i64_const(expr0[0..8], e0_n, 22);
    e0_n = i64_add(expr0[0..8], e0_n);
    e0_n = end(expr0[0..8], e0_n);
    var entry0 : [8]u8 = undefined;
    var ce0 : usize = code_entry(entry0[0..8], 0, 0, expr0[0..e0_n]);
    // code entry 1: zero local groups, call 0, end
    var expr1 : [4]u8 = undefined;
    var e1_n : usize = call(expr1[0..4], 0, 0);
    e1_n = end(expr1[0..4], e1_n);
    var entry1 : [8]u8 = undefined;
    var ce1 : usize = code_entry(entry1[0..8], 0, 0, expr1[0..e1_n]);
    // join the two entries in the caller's scratch, as code_section demands
    var joined : [16]u8 = undefined;
    var jn : usize = 0;
    var i : usize = 0;
    while (i < ce0) { joined[jn] = entry0[i]; jn = jn + 1; i = i + 1; }
    i = 0;
    while (i < ce1) { joined[jn] = entry1[i]; jn = jn + 1; i = i + 1; }
    // compose: preamble, type, function, export, code
    var n : usize = module_preamble(buf[0..64], 0);
    n = section(buf[0..64], n, SEC_TYPE, type_body[0..tb_n]);
    n = section(buf[0..64], n, SEC_FUNC, func_body[0..fb_n]);
    n = section(buf[0..64], n, SEC_EXPORT, export_body[0..eb_n]);
    n = code_section(buf[0..64], n, 2, joined[0..jn]);
    // 8 preamble + 7 type + 5 function + 12 export + 16 code = 48 bytes
    assert n == 48;
    assert buf[0] == 0x00 and buf[1] == 0x61 and buf[2] == 0x73 and buf[3] == 0x6D;
    assert buf[4] == 0x01 and buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x00;
    // the type section: 01 05 01 60 00 01 7E
    assert buf[8] == 0x01 and buf[9] == 0x05 and buf[10] == 0x01 and buf[11] == 0x60;
    assert buf[12] == 0x00 and buf[13] == 0x01 and buf[14] == 0x7E;
    // the function section: 03 03 02 00 00
    assert buf[15] == 0x03 and buf[16] == 0x03 and buf[17] == 0x02 and buf[18] == 0x00;
    assert buf[19] == 0x00;
    // the export section: 07 0A 01 06 61 6E 73 77 65 72 00 01
    assert buf[20] == 0x07 and buf[21] == 0x0A and buf[22] == 0x01 and buf[23] == 0x06;
    assert buf[24] == 0x61 and buf[25] == 0x6E and buf[26] == 0x73 and buf[27] == 0x77;
    assert buf[28] == 0x65 and buf[29] == 0x72 and buf[30] == 0x00 and buf[31] == 0x01;
    // the code section: 0A 0E 02, then entry 0 (07 00 42 14 42 16 7C 0B)
    // and entry 1 (04 00 10 00 0B)
    assert buf[32] == 0x0A and buf[33] == 0x0E and buf[34] == 0x02;
    assert buf[35] == 0x07 and buf[36] == 0x00 and buf[37] == 0x42 and buf[38] == 0x14;
    assert buf[39] == 0x42 and buf[40] == 0x16 and buf[41] == 0x7C and buf[42] == 0x0B;
    assert buf[43] == 0x04 and buf[44] == 0x00 and buf[45] == 0x10 and buf[46] == 0x00;
    assert buf[47] == 0x0B;
}

// -- Floor 7: the emit() composer (port epic #6198, ported from the working
// reference cli/t27b/src/wasm32_emitter.rs, PR #11983). t27 has no slice of
// slices (#9103), so the export set arrives as a DESCRIPTOR RECORD AREA -- the
// macho.t27 pattern: two blobs (names, bodies) plus one fixed-stride record
// per fn. The compose path assembles preamble + type + function + export +
// code sections through the floor-1..5 law fns and nothing else. --

/// One fn descriptor: 24 bytes, six little-endian u32 words.
pub const DESC_ROW : usize = 24;

/// The parameter-count bound of a descriptor: the i32-carrier params scratch
/// the type-section builder fills is this wide. The M-B law carries scalar
/// exports (the live-closure trio tops out at two parameters); a descriptor
/// beyond the bound fails closed below, exactly as the emitter refuses the
/// fn by name.
pub const MAX_DESC_PARAMS : usize = 32;

/// The u32 at byte `at` of a table, little-endian (the macho.t27 reader shape).
pub fn get_u32le(t: []const u8, at: usize) -> u32 {
    var v : u32 = t[at] as u32;
    v = v | ((t[at + 1] as u32) << 8);
    v = v | ((t[at + 2] as u32) << 16);
    v = v | ((t[at + 3] as u32) << 24);
    return v;
}

/// One u32 into out at at, little-endian; returns the new offset.
pub fn put_u32le(out: []u8, at: usize, v: u32) -> usize {
    out[at] = @intCast(v & 0xFF);
    out[at + 1] = @intCast((v >> 8) & 0xFF);
    out[at + 2] = @intCast((v >> 16) & 0xFF);
    out[at + 3] = @intCast((v >> 24) & 0xFF);
    return at + 4;
}

/// One fn descriptor into out at at: where its export name lives in the names
/// blob (offset, length), how many i32-carrier parameters it takes, its result
/// valtype byte, and where its lowered body lives in the bodies blob (offset,
/// length). Returns at + DESC_ROW; the caller strides records back to back.
pub fn desc_put(out: []u8, at: usize, name_off: u32, name_len: u32, nparams: u32, result: u8, body_off: u32, body_len: u32) -> usize {
    var n : usize = put_u32le(out, at, name_off);
    n = put_u32le(out, n, name_len);
    n = put_u32le(out, n, nparams);
    n = put_u32le(out, n, result as u32);
    n = put_u32le(out, n, body_off);
    return put_u32le(out, n, body_len);
}

/// How many fn descriptors the area holds; a partial row is no record at all.
pub fn desc_count(descs: []const u8) -> usize {
    return descs.len / DESC_ROW;
}

/// Fn i's export name: offset into the names blob.
pub fn desc_name_off(descs: []const u8, i: usize) -> u32 {
    return get_u32le(descs, DESC_ROW * i);
}

/// Fn i's export name length.
pub fn desc_name_len(descs: []const u8, i: usize) -> u32 {
    return get_u32le(descs, DESC_ROW * i + 4);
}

/// Fn i's parameter count (all on the i32 carrier).
pub fn desc_nparams(descs: []const u8, i: usize) -> u32 {
    return get_u32le(descs, DESC_ROW * i + 8);
}

/// Fn i's result valtype byte.
pub fn desc_result(descs: []const u8, i: usize) -> u8 {
    return @intCast(get_u32le(descs, DESC_ROW * i + 12) & 0xFF);
}

/// Fn i's lowered body: offset into the bodies blob.
pub fn desc_body_off(descs: []const u8, i: usize) -> u32 {
    return get_u32le(descs, DESC_ROW * i + 16);
}

/// Fn i's lowered body length -- the instruction program WITH its trailing
/// 0x0B end byte, locals always the zero-group count 0x00 (code_entry writes
/// that byte itself).
pub fn desc_body_len(descs: []const u8, i: usize) -> u32 {
    return get_u32le(descs, DESC_ROW * i + 20);
}

/// True when every descriptor is on the law: whole rows only, names and
/// bodies inside their blobs, a legal valtype result, and a parameter count
/// the params scratch holds. The composer and every section builder fail
/// closed (write nothing, return 0) unless this holds.
pub fn descs_ok(names: []const u8, descs: []const u8, bodies: []const u8) -> bool {
    if (descs.len % DESC_ROW != 0) { return false; }
    var i : usize = 0;
    while (i < desc_count(descs)) {
        if (desc_name_off(descs, i) + desc_name_len(descs, i) > names.len as u32) { return false; }
        if (desc_body_off(descs, i) + desc_body_len(descs, i) > bodies.len as u32) { return false; }
        var r : u8 = desc_result(descs, i);
        if (r != VT_I32 and r != VT_I64 and r != VT_F32 and r != VT_F64) { return false; }
        if (desc_nparams(descs, i) as usize > MAX_DESC_PARAMS) { return false; }
        i = i + 1;
    }
    return true;
}

/// Copies src to out at at; the position after it.
pub fn copy_bytes(out: []u8, at: usize, src: []const u8) -> usize {
    var i : usize = 0;
    while (i < src.len) {
        out[at + i] = src[i];
        i = i + 1;
    }
    return at + src.len;
}

/// The type-section body over the descriptors: vec_prefix(count), then one
/// functype_full per fn -- its own parameter vector of i32-carrier bytes and
/// its own result byte. One type per fn, no dedup: exactly the emitter's walk.
pub fn type_body(out: []u8, names: []const u8, descs: []const u8, bodies: []const u8) -> usize {
    if (!descs_ok(names, descs, bodies)) { return 0; }
    var k : usize = desc_count(descs);
    var n : usize = vec_prefix(out, 0, k as u32);
    var i : usize = 0;
    while (i < k) {
        var ps : [MAX_DESC_PARAMS]u8 = undefined;
        var np : usize = desc_nparams(descs, i) as usize;
        var j : usize = 0;
        while (j < np) {
            ps[j] = VT_I32;
            j = j + 1;
        }
        var rs : [1]u8 = undefined;
        rs[0] = desc_result(descs, i);
        n = functype_full(out, n, ps[0..np], rs[0..1]);
        i = i + 1;
    }
    return n;
}

/// The function-section body: vec_prefix(count), then one func_entry per fn --
/// fn i has type index i (the type section carries one type per fn).
pub fn func_body(out: []u8, names: []const u8, descs: []const u8, bodies: []const u8) -> usize {
    if (!descs_ok(names, descs, bodies)) { return 0; }
    var k : usize = desc_count(descs);
    var n : usize = vec_prefix(out, 0, k as u32);
    var i : usize = 0;
    while (i < k) {
        n = func_entry(out, n, i as u32);
        i = i + 1;
    }
    return n;
}

/// The export-section body: vec_prefix(count), then one export_entry per fn
/// under its own name at function index i.
pub fn export_body(out: []u8, names: []const u8, descs: []const u8, bodies: []const u8) -> usize {
    if (!descs_ok(names, descs, bodies)) { return 0; }
    var k : usize = desc_count(descs);
    var n : usize = vec_prefix(out, 0, k as u32);
    var i : usize = 0;
    while (i < k) {
        var a : usize = desc_name_off(descs, i) as usize;
        var b : usize = a + desc_name_len(descs, i) as usize;
        n = export_entry(out, n, names[a..b], i as u32);
        i = i + 1;
    }
    return n;
}

/// The joined, size-prefixed code entries (code_section's entries_joined, no
/// vector count -- code_section writes that): one code_entry per fn, locals
/// zero groups, over the fn's lowered body straight from the blob.
pub fn code_entries(out: []u8, names: []const u8, descs: []const u8, bodies: []const u8) -> usize {
    if (!descs_ok(names, descs, bodies)) { return 0; }
    var k : usize = desc_count(descs);
    var n : usize = 0;
    var i : usize = 0;
    while (i < k) {
        var a : usize = desc_body_off(descs, i) as usize;
        var b : usize = a + desc_body_len(descs, i) as usize;
        n = code_entry(out, n, 0, bodies[a..b]);
        i = i + 1;
    }
    return n;
}

/// The whole module: preamble, then the type, function, export and code
/// sections, each body built in the caller's scratch and framed through the
/// law fns -- the emit() composer with per-fn descriptors instead of a
/// Vec<(index, Ty, nparams, Body)>. Returns the module's end offset, or 0
/// (nothing written) when the descriptors are off the law or the set is
/// empty -- the emitter refuses the empty module by name, and so does this.
pub fn compose_module(out: []u8, names: []const u8, descs: []const u8, bodies: []const u8, scratch: []u8) -> usize {
    if (!descs_ok(names, descs, bodies)) { return 0; }
    var k : usize = desc_count(descs);
    if (k == 0) { return 0; }
    var n : usize = module_preamble(out, 0);
    var sn : usize = type_body(scratch, names, descs, bodies);
    n = section(out, n, SEC_TYPE, scratch[0..sn]);
    sn = func_body(scratch, names, descs, bodies);
    n = section(out, n, SEC_FUNC, scratch[0..sn]);
    sn = export_body(scratch, names, descs, bodies);
    n = section(out, n, SEC_EXPORT, scratch[0..sn]);
    sn = code_entries(scratch, names, descs, bodies);
    n = code_section(out, n, k as u32, scratch[0..sn]);
    return n;
}

test desc_put_and_the_accessors_round_trip {
    var d : [48]u8 = undefined;
    var dn : usize = desc_put(d[0..48], 0, 3, 13, 1, VT_I32, 7, 9);
    dn = desc_put(d[0..48], dn, 16, 10, 2, VT_I64, 16, 12);
    assert dn == 48 and desc_count(d[0..48]) == 2;
    // the first record, read back word by word
    assert desc_name_off(d[0..48], 0) == 3 and desc_name_len(d[0..48], 0) == 13;
    assert desc_nparams(d[0..48], 0) == 1 and desc_result(d[0..48], 0) == VT_I32;
    assert desc_body_off(d[0..48], 0) == 7 and desc_body_len(d[0..48], 0) == 9;
    // the second record sits one row down -- a stride confusion is caught here
    assert desc_name_off(d[0..48], 1) == 16 and desc_nparams(d[0..48], 1) == 2;
    assert desc_result(d[0..48], 1) == VT_I64 and desc_body_len(d[0..48], 1) == 12;
    // the bytes ARE little-endian u32s: record 0's name_off 3 is 03 00 00 00
    assert d[0] == 0x03 and d[1] == 0x00 and d[2] == 0x00 and d[3] == 0x00;
    // word 3 carries the valtype byte 0x7F in its low byte only
    assert d[12] == 0x7F and d[13] == 0x00 and d[14] == 0x00 and d[15] == 0x00;
}

test desc_count_reads_whole_rows_only {
    var d : [72]u8 = undefined;
    var i : usize = 0;
    while (i < 72) { d[i] = 0; i = i + 1; }
    assert desc_count(d[0..72]) == 3;
    assert desc_count(d[0..71]) == 2;
    assert desc_count(d[0..24]) == 1;
    assert desc_count(d[0..0]) == 0;
    assert descs_ok(d[0..71], d[0..71], d[0..71]) == false;
}

test descs_ok_gates_the_blob_bounds {
    var names : [6]u8 = undefined;
    var i : usize = 0;
    while (i < 6) { names[i] = 0x61; i = i + 1; }
    var bodies : [4]u8 = undefined;
    i = 0;
    while (i < 4) { bodies[i] = 0x0B; i = i + 1; }
    var d : [24]u8 = undefined;
    var w : usize = desc_put(d[0..24], 0, 0, 6, 0, VT_I32, 0, 4);
    assert w == 24;
    assert descs_ok(names[0..6], d[0..24], bodies[0..4]) == true;
    // a name run past the names blob
    w = desc_put(d[0..24], 0, 0, 7, 0, VT_I32, 0, 4);
    assert descs_ok(names[0..6], d[0..24], bodies[0..4]) == false;
    // a body run past the bodies blob
    w = desc_put(d[0..24], 0, 0, 6, 0, VT_I32, 0, 5);
    assert descs_ok(names[0..6], d[0..24], bodies[0..4]) == false;
    // a result byte no valtype maps to
    w = desc_put(d[0..24], 0, 0, 6, 0, 0x43, 0, 4);
    assert descs_ok(names[0..6], d[0..24], bodies[0..4]) == false;
    // more parameters than the scratch holds
    w = desc_put(d[0..24], 0, 0, 6, 33, VT_I32, 0, 4);
    assert descs_ok(names[0..6], d[0..24], bodies[0..4]) == false;
    // 32 parameters is inside the law
    w = desc_put(d[0..24], 0, 0, 6, 32, VT_I32, 0, 4);
    assert descs_ok(names[0..6], d[0..24], bodies[0..4]) == true;
}

test type_body_pins_the_trio_functypes {
    // one row per fn: (name_off, name_len, nparams, VT_I32, body_off, body_len)
    var d : [72]u8 = undefined;
    desc_put(d[0..72], 0, 0, 13, 1, VT_I32, 0, 9);
    desc_put(d[0..72], DESC_ROW, 13, 10, 1, VT_I32, 9, 9);
    desc_put(d[0..72], 2 * DESC_ROW, 23, 10, 2, VT_I32, 18, 12);
    // the blobs only need to cover the runs the descriptors name
    var names : [33]u8 = undefined;
    var bodies : [30]u8 = undefined;
    var i : usize = 0;
    while (i < 33) { names[i] = 0x61; i = i + 1; }
    i = 0;
    while (i < 30) { bodies[i] = 0x0B; i = i + 1; }
    var out : [24]u8 = undefined;
    const n : usize = type_body(out[0..24], names[0..33], d[0..72], bodies[0..30]);
    assert n == 17;
    // vec count 3, then (i32)->(i32), (i32)->(i32), (i32,i32)->(i32)
    assert out[0] == 0x03;
    assert out[1] == 0x60 and out[2] == 0x01 and out[3] == VT_I32 and out[4] == 0x01 and out[5] == VT_I32;
    assert out[6] == 0x60 and out[7] == 0x01 and out[8] == VT_I32 and out[9] == 0x01 and out[10] == VT_I32;
    assert out[11] == 0x60 and out[12] == 0x02 and out[13] == VT_I32 and out[14] == VT_I32;
    assert out[15] == 0x01 and out[16] == VT_I32;
}

test func_body_and_export_body_pin_the_trio {
    var d : [72]u8 = undefined;
    desc_put(d[0..72], 0, 0, 13, 1, VT_I32, 0, 9);
    desc_put(d[0..72], DESC_ROW, 13, 10, 1, VT_I32, 9, 9);
    desc_put(d[0..72], 2 * DESC_ROW, 23, 10, 2, VT_I32, 18, 12);
    // names blob: arrival_frame paints_due latency_ms, 33 bytes back to back
    var names : [33]u8 = undefined;
    var nn : usize = copy_bytes(names[0..33], 0, "arrival_frame");
    nn = copy_bytes(names[0..33], nn, "paints_due");
    nn = copy_bytes(names[0..33], nn, "latency_ms");
    assert nn == 33;
    var bodies : [30]u8 = undefined;
    var i : usize = 0;
    while (i < 30) { bodies[i] = 0x0B; i = i + 1; }
    // the function section body: count 3, type index i for fn i
    var fb : [8]u8 = undefined;
    const fn3 : usize = func_body(fb[0..8], names[0..33], d[0..72], bodies[0..30]);
    assert fn3 == 4;
    assert fb[0] == 0x03 and fb[1] == 0x00 and fb[2] == 0x01 and fb[3] == 0x02;
    // the export section body: count 3, then name/kind/index per fn -- 43 bytes
    var eb : [48]u8 = undefined;
    const en : usize = export_body(eb[0..48], names[0..33], d[0..72], bodies[0..30]);
    assert en == 43;
    assert eb[0] == 0x03;
    // arrival_frame (13), kind func, index 0
    assert eb[1] == 0x0D and eb[2] == 'a' and eb[14] == 'e' and eb[15] == 0x00 and eb[16] == 0x00;
    // paints_due (10), kind func, index 1
    assert eb[17] == 0x0A and eb[18] == 'p' and eb[27] == 'e' and eb[28] == 0x00 and eb[29] == 0x01;
    // latency_ms (10), kind func, index 2
    assert eb[30] == 0x0A and eb[31] == 'l' and eb[40] == 's' and eb[41] == 0x00 and eb[42] == 0x02;
}

test code_entries_pin_the_trio_bodies {
    var d : [72]u8 = undefined;
    desc_put(d[0..72], 0, 0, 13, 1, VT_I32, 0, 9);
    desc_put(d[0..72], DESC_ROW, 13, 10, 1, VT_I32, 9, 9);
    desc_put(d[0..72], 2 * DESC_ROW, 23, 10, 2, VT_I32, 18, 12);
    var names : [33]u8 = undefined;
    var i : usize = 0;
    while (i < 33) { names[i] = 0x61; i = i + 1; }
    // the bodies blob: three lowered programs, each with its end byte
    var bodies : [30]u8 = undefined;
    var s : [16]u8 = undefined;
    var z : usize = local_get(s[0..16], 0, 0);
    z = i32_const(s[0..16], z, 16);
    z = i32_div_u(s[0..16], z);
    z = i32_const(s[0..16], z, 1);
    z = i32_add(s[0..16], z);
    z = end(s[0..16], z);
    var bn : usize = copy_bytes(bodies[0..30], 0, s[0..z]);
    assert bn == 9;
    z = i32_const(s[0..16], 0, 0);
    z = i32_const(s[0..16], z, 1);
    z = local_get(s[0..16], z, 0);
    z = i32_eqz(s[0..16], z);
    z = select(s[0..16], z);
    z = end(s[0..16], z);
    bn = copy_bytes(bodies[0..30], bn, s[0..z]);
    assert bn == 18;
    z = local_get(s[0..16], 0, 1);
    z = local_get(s[0..16], z, 0);
    z = i32_sub(s[0..16], z);
    z = i32_const(s[0..16], z, 1);
    z = i32_add(s[0..16], z);
    z = i32_const(s[0..16], z, 16);
    z = i32_mul(s[0..16], z);
    z = end(s[0..16], z);
    bn = copy_bytes(bodies[0..30], bn, s[0..z]);
    assert bn == 30;
    // the joined entries: 11 + 11 + 14 = 36 bytes, no vector count
    var out : [40]u8 = undefined;
    const n : usize = code_entries(out[0..40], names[0..33], d[0..72], bodies[0..30]);
    assert n == 36;
    // arrival_frame: size 0A, locals 00, get 0, const 16, div_u, const 1, add, end
    assert out[0] == 0x0A and out[1] == 0x00 and out[2] == 0x20 and out[3] == 0x00;
    assert out[4] == 0x41 and out[5] == 0x10 and out[6] == 0x6E and out[7] == 0x41;
    assert out[8] == 0x01 and out[9] == 0x6A and out[10] == 0x0B;
    // paints_due: size 0A, locals 00, const 0, const 1, get 0, eqz, select, end
    assert out[11] == 0x0A and out[12] == 0x00 and out[13] == 0x41 and out[14] == 0x00;
    assert out[15] == 0x41 and out[16] == 0x01 and out[17] == 0x20 and out[18] == 0x00;
    assert out[19] == 0x45 and out[20] == 0x1B and out[21] == 0x0B;
    // latency_ms: size 0D, locals 00, get 1, get 0, sub, const 1, add, const 16, mul, end
    assert out[22] == 0x0D and out[23] == 0x00 and out[24] == 0x20 and out[25] == 0x01;
    assert out[26] == 0x20 and out[27] == 0x00 and out[28] == 0x6B and out[29] == 0x41;
    assert out[30] == 0x01 and out[31] == 0x6A and out[32] == 0x41 and out[33] == 0x10;
    assert out[34] == 0x6C and out[35] == 0x0B;
}

test compose_module_pins_the_87_byte_live_scalar_duo {
    // The live-scalar closure as Node's WebAssembly verified it on the emitter
    // branch: arrival_frame + latency_ms, the 87-byte two-fn module, every
    // byte pinned. (Node, 2026-10-24: arrival_frame(33)=3, latency_ms(2,7)=96.)
    var names : [23]u8 = undefined;
    var nn : usize = copy_bytes(names[0..23], 0, "arrival_frame");
    nn = copy_bytes(names[0..23], nn, "latency_ms");
    assert nn == 23;
    var bodies : [21]u8 = undefined;
    var s : [16]u8 = undefined;
    var z : usize = local_get(s[0..16], 0, 0);
    z = i32_const(s[0..16], z, 16);
    z = i32_div_u(s[0..16], z);
    z = i32_const(s[0..16], z, 1);
    z = i32_add(s[0..16], z);
    z = end(s[0..16], z);
    var bn : usize = copy_bytes(bodies[0..21], 0, s[0..z]);
    assert bn == 9;
    z = local_get(s[0..16], 0, 1);
    z = local_get(s[0..16], z, 0);
    z = i32_sub(s[0..16], z);
    z = i32_const(s[0..16], z, 1);
    z = i32_add(s[0..16], z);
    z = i32_const(s[0..16], z, 16);
    z = i32_mul(s[0..16], z);
    z = end(s[0..16], z);
    bn = copy_bytes(bodies[0..21], bn, s[0..z]);
    assert bn == 21;
    var d : [48]u8 = undefined;
    desc_put(d[0..48], 0, 0, 13, 1, VT_I32, 0, 9);
    desc_put(d[0..48], DESC_ROW, 13, 10, 2, VT_I32, 9, 12);
    var buf : [96]u8 = undefined;
    var scratch : [64]u8 = undefined;
    const n : usize = compose_module(buf[0..96], names[0..23], d[0..48], bodies[0..21], scratch[0..64]);
    assert n == 87;
    // preamble: magic and version
    assert buf[0] == 0x00 and buf[1] == 0x61 and buf[2] == 0x73 and buf[3] == 0x6D;
    assert buf[4] == 0x01 and buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x00;
    // type section: 12-byte body -- count 2, (i32)->(i32), (i32,i32)->(i32)
    assert buf[8] == 0x01 and buf[9] == 0x0C and buf[10] == 0x02;
    assert buf[11] == 0x60 and buf[12] == 0x01 and buf[13] == VT_I32 and buf[14] == 0x01 and buf[15] == VT_I32;
    assert buf[16] == 0x60 and buf[17] == 0x02 and buf[18] == VT_I32 and buf[19] == VT_I32;
    assert buf[20] == 0x01 and buf[21] == VT_I32;
    // function section: count 2, types 0 and 1
    assert buf[22] == 0x03 and buf[23] == 0x03 and buf[24] == 0x02 and buf[25] == 0x00 and buf[26] == 0x01;
    // export section: 30-byte body -- count 2, both names, kind func
    assert buf[27] == 0x07 and buf[28] == 0x1E and buf[29] == 0x02;
    assert buf[30] == 0x0D and buf[31] == 'a' and buf[43] == 'e' and buf[44] == 0x00 and buf[45] == 0x00;
    assert buf[46] == 0x0A and buf[47] == 'l' and buf[56] == 's' and buf[57] == 0x00 and buf[58] == 0x01;
    // code section: 26-byte body -- count 2, the two size-prefixed entries
    assert buf[59] == 0x0A and buf[60] == 0x1A and buf[61] == 0x02;
    assert buf[62] == 0x0A and buf[63] == 0x00 and buf[64] == 0x20 and buf[65] == 0x00;
    assert buf[66] == 0x41 and buf[67] == 0x10 and buf[68] == 0x6E and buf[69] == 0x41;
    assert buf[70] == 0x01 and buf[71] == 0x6A and buf[72] == 0x0B;
    assert buf[73] == 0x0D and buf[74] == 0x00 and buf[75] == 0x20 and buf[76] == 0x01;
    assert buf[77] == 0x20 and buf[78] == 0x00 and buf[79] == 0x6B and buf[80] == 0x41;
    assert buf[81] == 0x01 and buf[82] == 0x6A and buf[83] == 0x41 and buf[84] == 0x10;
    assert buf[85] == 0x6C and buf[86] == 0x0B;
}

test compose_module_pins_the_117_byte_live_scalar_trio {
    // The full closure with paints_due (the select pattern): 117 bytes, every
    // one pinned. Node's WebAssembly instantiated this exact shape 2026-10-24
    // (arrival_frame(16)=2, paints_due(0)=0, paints_due(5)=1, latency_ms(2,7)=96).
    var names : [33]u8 = undefined;
    var nn : usize = copy_bytes(names[0..33], 0, "arrival_frame");
    nn = copy_bytes(names[0..33], nn, "paints_due");
    nn = copy_bytes(names[0..33], nn, "latency_ms");
    var bodies : [30]u8 = undefined;
    var s : [16]u8 = undefined;
    var z : usize = local_get(s[0..16], 0, 0);
    z = i32_const(s[0..16], z, 16);
    z = i32_div_u(s[0..16], z);
    z = i32_const(s[0..16], z, 1);
    z = i32_add(s[0..16], z);
    z = end(s[0..16], z);
    var bn : usize = copy_bytes(bodies[0..30], 0, s[0..z]);
    z = i32_const(s[0..16], 0, 0);
    z = i32_const(s[0..16], z, 1);
    z = local_get(s[0..16], z, 0);
    z = i32_eqz(s[0..16], z);
    z = select(s[0..16], z);
    z = end(s[0..16], z);
    bn = copy_bytes(bodies[0..30], bn, s[0..z]);
    z = local_get(s[0..16], 0, 1);
    z = local_get(s[0..16], z, 0);
    z = i32_sub(s[0..16], z);
    z = i32_const(s[0..16], z, 1);
    z = i32_add(s[0..16], z);
    z = i32_const(s[0..16], z, 16);
    z = i32_mul(s[0..16], z);
    z = end(s[0..16], z);
    bn = copy_bytes(bodies[0..30], bn, s[0..z]);
    assert bn == 30;
    var d : [72]u8 = undefined;
    desc_put(d[0..72], 0, 0, 13, 1, VT_I32, 0, 9);
    desc_put(d[0..72], DESC_ROW, 13, 10, 1, VT_I32, 9, 9);
    desc_put(d[0..72], 2 * DESC_ROW, 23, 10, 2, VT_I32, 18, 12);
    var buf : [128]u8 = undefined;
    var scratch : [64]u8 = undefined;
    const n : usize = compose_module(buf[0..128], names[0..33], d[0..72], bodies[0..30], scratch[0..64]);
    assert n == 117;
    // preamble
    assert buf[0] == 0x00 and buf[1] == 0x61 and buf[2] == 0x73 and buf[3] == 0x6D;
    assert buf[4] == 0x01 and buf[5] == 0x00 and buf[6] == 0x00 and buf[7] == 0x00;
    // type section: 17-byte body, three functypes
    assert buf[8] == 0x01 and buf[9] == 0x11 and buf[10] == 0x03;
    assert buf[11] == 0x60 and buf[12] == 0x01 and buf[13] == VT_I32 and buf[14] == 0x01 and buf[15] == VT_I32;
    assert buf[16] == 0x60 and buf[17] == 0x01 and buf[18] == VT_I32 and buf[19] == 0x01 and buf[20] == VT_I32;
    assert buf[21] == 0x60 and buf[22] == 0x02 and buf[23] == VT_I32 and buf[24] == VT_I32;
    assert buf[25] == 0x01 and buf[26] == VT_I32;
    // function section: count 3, type indices 0 1 2
    assert buf[27] == 0x03 and buf[28] == 0x04 and buf[29] == 0x03;
    assert buf[30] == 0x00 and buf[31] == 0x01 and buf[32] == 0x02;
    // export section: 43-byte body, three names
    assert buf[33] == 0x07 and buf[34] == 0x2B and buf[35] == 0x03;
    assert buf[36] == 0x0D and buf[37] == 'a' and buf[49] == 'e' and buf[50] == 0x00 and buf[51] == 0x00;
    assert buf[52] == 0x0A and buf[53] == 'p' and buf[62] == 'e' and buf[63] == 0x00 and buf[64] == 0x01;
    assert buf[65] == 0x0A and buf[66] == 'l' and buf[75] == 's' and buf[76] == 0x00 and buf[77] == 0x02;
    // code section: 37-byte body, count 3
    assert buf[78] == 0x0A and buf[79] == 0x25 and buf[80] == 0x03;
    // arrival_frame entry: size 0A, locals 00, the 8-byte program, end
    assert buf[81] == 0x0A and buf[82] == 0x00 and buf[83] == 0x20 and buf[84] == 0x00;
    assert buf[85] == 0x41 and buf[86] == 0x10 and buf[87] == 0x6E and buf[88] == 0x41;
    assert buf[89] == 0x01 and buf[90] == 0x6A and buf[91] == 0x0B;
    // paints_due entry: size 0A, locals 00, the select program, end
    assert buf[92] == 0x0A and buf[93] == 0x00 and buf[94] == 0x41 and buf[95] == 0x00;
    assert buf[96] == 0x41 and buf[97] == 0x01 and buf[98] == 0x20 and buf[99] == 0x00;
    assert buf[100] == 0x45 and buf[101] == 0x1B and buf[102] == 0x0B;
    // latency_ms entry: size 0D, locals 00, the 11-byte program, end
    assert buf[103] == 0x0D and buf[104] == 0x00 and buf[105] == 0x20 and buf[106] == 0x01;
    assert buf[107] == 0x20 and buf[108] == 0x00 and buf[109] == 0x6B and buf[110] == 0x41;
    assert buf[111] == 0x01 and buf[112] == 0x6A and buf[113] == 0x41 and buf[114] == 0x10;
    assert buf[115] == 0x6C and buf[116] == 0x0B;
}

test compose_module_fails_closed {
    var names : [5]u8 = undefined;
    var i : usize = 0;
    while (i < 5) { names[i] = 0x61; i = i + 1; }
    var bodies : [3]u8 = undefined;
    i = 0;
    while (i < 3) { bodies[i] = 0x0B; i = i + 1; }
    var buf : [16]u8 = undefined;
    var scratch : [16]u8 = undefined;
    i = 0;
    while (i < 16) { buf[i] = 0xAA; i = i + 1; }
    // an empty descriptor set is the module the emitter refuses by name
    var none : [1]u8 = [0];
    assert compose_module(buf[0..16], names[0..5], none[0..0], bodies[0..3], scratch[0..16]) == 0;
    // a descriptor off the law: nothing written, the buffer stands
    var bad : [24]u8 = undefined;
    desc_put(bad[0..24], 0, 0, 9, 0, VT_I32, 0, 3);
    assert compose_module(buf[0..16], names[0..5], bad[0..24], bodies[0..3], scratch[0..16]) == 0;
    assert buf[0] == 0xAA and buf[15] == 0xAA;
    // a partial row is no record set at all
    desc_put(bad[0..24], 0, 0, 5, 0, VT_I32, 0, 3);
    assert descs_ok(names[0..5], bad[0..23], bodies[0..3]) == false;
    assert compose_module(buf[0..16], names[0..5], bad[0..23], bodies[0..3], scratch[0..16]) == 0;
}
// -- Floor 8: the REFUSAL WALK (ported from cli/t27b/src/wasm32_emitter.rs on
// lane/ma-params @ 5170be77b, port epic #6198, tracking #11983). The byte law
// above says how a supported fn becomes bytes; this floor says WHICH pub fns
// the module REFUSES, in the emitter's exact walk order, with the construct
// and detail words the corpus parses out of the refusal line -- byte-stable,
// never silently dropped. The walk: a test or private fn is skipped (not an
// export, no refusal); a pub fn without a return refuses (void pub fn); the
// M-A path (no parameters) refuses an uncarried return (ptr return / i128
// return) before a non-constant body (fn body); the M-B path refuses a
// parameter off the i32 carrier (fn parameters) before the return (ptr/i128
// return, then fn return type) before the body: an expression tree walks
// Const, then Var (a var at or beyond the parameter count is a local
// variable), then Arith (an operator outside + - * / is an arithmetic op,
// checked before the operands, lhs before rhs), everything else an expression
// kind; the select pattern refuses its shape facts as fn body, its condition
// as if condition (two phrasings); any other body is fn body. A program whose
// export set is empty refuses at the module level: construct module, fn
// (module), line 0. The refusal line itself is
// `unsupported construct <construct> at line <line> (fn <func>: <detail>)` --
// the exact phrasing of EmitError::message, which the CLI prints and corpus
// parses. --

// The refusal codes, in walk order. 0 is the only non-refusal.
pub const REF_OK : u8 = 0;
/// A test or private fn: not in the export walk at all -- no refusal fires.
pub const REF_SKIP : u8 = 1;
pub const REF_VOID_PUB_FN : u8 = 2;
pub const REF_PTR_RETURN : u8 = 3;
pub const REF_I128_RETURN : u8 = 4;
pub const REF_FN_BODY_CONST : u8 = 5;
pub const REF_FN_PARAMETERS : u8 = 6;
pub const REF_FN_RETURN_TYPE : u8 = 7;
pub const REF_LOCAL_VARIABLE : u8 = 8;
pub const REF_ARITHMETIC_OP : u8 = 9;
pub const REF_EXPRESSION_KIND : u8 = 10;
pub const REF_FN_BODY_SELECT : u8 = 11;
pub const REF_IF_CONDITION_CMP : u8 = 12;
pub const REF_IF_CONDITION_SHAPE : u8 = 13;
pub const REF_MODULE : u8 = 14;

// The body shapes the walk names, as the glue sees the statement list.
pub const BS_CONST_RETURN : u8 = 0;
pub const BS_RETURN_EXPR : u8 = 1;
pub const BS_SELECT : u8 = 2;
pub const BS_OTHER : u8 = 3;

// The expression kinds lower_stack carries; every other kind refuses.
pub const EK_CONST : u8 = 0;
pub const EK_VAR : u8 = 1;
pub const EK_ARITH : u8 = 2;

// The four operators the i32 stack floor lowers (the ArithOp numbers of
// specs/tri/t27b/arith_op.t27; DivW and everything beyond the four refuses).
pub const WOP_ADD : u8 = 0;
pub const WOP_SUB : u8 = 1;
pub const WOP_MUL : u8 = 2;
pub const WOP_DIV : u8 = 6;

/// The module-level refusal's fn name: the whole module.
pub fn module_func() -> str {
    return "(module)";
}

/// The module-level refusal's line: 0 (no fn of the program owns it).
pub fn module_line() -> u32 {
    return 0;
}

/// The wasm carrier of a scalar type name -- the emitter's `valtype` rule.
/// The law's name map first (i32/i64/f32/f64); then u64 rides the i64 carrier
/// beside i64; ptr and i128 are not carried (0); everything else (bool, the
/// <=32-bit ints, the odd widths uN/iN) rides the i32 carrier.
pub fn carrier(name: []const u8) -> u8 {
    var b : u8 = valtype_byte(name);
    if (b != 0) { return b; }
    if (name.len == 3 and name[0] == 'u' and name[1] == '6' and name[2] == '4') { return VT_I64; }
    if (name.len == 3 and name[0] == 'p' and name[1] == 't' and name[2] == 'r') { return 0; }
    if (name.len == 4 and name[0] == 'i' and name[1] == '1' and name[2] == '2' and name[3] == '8') { return 0; }
    return VT_I32;
}

/// True when the type crosses the wasm boundary (the emitter's `carries`).
pub fn carries(name: []const u8) -> bool {
    return carrier(name) != 0;
}

/// The Rust Debug spelling of an ArithOp number (ir.rs's variant names, the
/// numbering of arith_op.t27) -- what `{:?}` prints into the arithmetic-op
/// refusal's detail.
pub fn arith_debug_name(op: u8) -> str {
    if (op == 0) { return "Add"; }
    if (op == 1) { return "Sub"; }
    if (op == 2) { return "Mul"; }
    if (op == 3) { return "AddW"; }
    if (op == 4) { return "SubW"; }
    if (op == 5) { return "MulW"; }
    if (op == 6) { return "Div"; }
    if (op == 7) { return "DivW"; }
    if (op == 8) { return "Rem"; }
    if (op == 9) { return "And"; }
    if (op == 10) { return "Or"; }
    if (op == 11) { return "Xor"; }
    if (op == 12) { return "Shl"; }
    if (op == 13) { return "Shr"; }
    if (op == 14) { return "ShlW"; }
    return "ShrW";
}

/// The construct name a refusal code carries -- the exact words the corpus
/// keys on. REF_SKIP and an unknown code name nothing (fail closed).
pub fn refusal_construct(code: u8) -> str {
    if (code == REF_VOID_PUB_FN) { return "void pub fn"; }
    if (code == REF_PTR_RETURN) { return "ptr return"; }
    if (code == REF_I128_RETURN) { return "i128 return"; }
    if (code == REF_FN_BODY_CONST or code == REF_FN_BODY_SELECT) { return "fn body"; }
    if (code == REF_FN_PARAMETERS) { return "fn parameters"; }
    if (code == REF_FN_RETURN_TYPE) { return "fn return type"; }
    if (code == REF_LOCAL_VARIABLE) { return "local variable"; }
    if (code == REF_ARITHMETIC_OP) { return "arithmetic op"; }
    if (code == REF_EXPRESSION_KIND) { return "expression kind"; }
    if (code == REF_IF_CONDITION_CMP or code == REF_IF_CONDITION_SHAPE) { return "if condition"; }
    if (code == REF_MODULE) { return "module"; }
    return "";
}

/// The fixed detail phrasings (the refusals whose words carry no type name).
/// The dynamic ones -- ptr/i128 return, fn parameters, fn return type,
/// arithmetic op -- compose through their writers below. Fail closed.
pub fn refusal_detail(code: u8) -> str {
    if (code == REF_VOID_PUB_FN) { return "the wasm32 emitter exports fns that return a scalar"; }
    if (code == REF_FN_BODY_CONST) { return "the wasm32 emitter lowers a single `return <const>;` body only"; }
    if (code == REF_LOCAL_VARIABLE) { return "the wasm32 emitter reads the fn's parameters only"; }
    if (code == REF_EXPRESSION_KIND) { return "the wasm32 emitter lowers parameters, i32 constants and + - * / only"; }
    if (code == REF_FN_BODY_SELECT) { return "the wasm32 emitter lowers `return <expr>;` or `if (<param> == 0) { return <const>; } return <const>;` only"; }
    if (code == REF_IF_CONDITION_CMP) { return "the wasm32 emitter compares a parameter against 0 (eqz, the law's comparison floor) only"; }
    if (code == REF_IF_CONDITION_SHAPE) { return "the wasm32 emitter compares a parameter against 0 only (`== 0`, eqz's exact shape)"; }
    if (code == REF_MODULE) { return "no pub fn whose body the wasm32 emitter lowers (a constant leaf, or an expression over i32 parameters and constants)"; }
    return "";
}

/// The uncarried-return detail: the type name in backticks.
pub fn uncarried_return_detail(out: []u8, at: usize, ty: []const u8) -> usize {
    var n : usize = copy_bytes(out, at, "the wasm32 emitter exports scalar returns, `");
    n = copy_bytes(out, n, ty);
    return copy_bytes(out, n, "` here");
}

/// The fn-parameters detail: the offending parameter's type in backticks.
pub fn i32_params_detail(out: []u8, at: usize, ty: []const u8) -> usize {
    var n : usize = copy_bytes(out, at, "the wasm32 emitter carries i32 parameters, `");
    n = copy_bytes(out, n, ty);
    return copy_bytes(out, n, "` here");
}

/// The fn-return-type detail: the return type in backticks.
pub fn i32_results_detail(out: []u8, at: usize, ty: []const u8) -> usize {
    var n : usize = copy_bytes(out, at, "the wasm32 emitter carries i32 results here, `");
    n = copy_bytes(out, n, ty);
    return copy_bytes(out, n, "` instead");
}

/// The arithmetic-op detail: the operator's Debug name in backticks.
pub fn arith_op_detail(out: []u8, at: usize, op: u8) -> usize {
    var n : usize = copy_bytes(out, at, "the wasm32 emitter lowers + - * / on the i32 carrier, `");
    n = copy_bytes(out, n, arith_debug_name(op));
    return copy_bytes(out, n, "` here");
}

/// Decimal digits of v, no padding (the message's `at line N`).
pub fn u32_dec_len(v: u32) -> usize {
    var n : usize = 1;
    var x : u32 = v;
    while (x >= 10) { x = x / 10; n = n + 1; }
    return n;
}

/// v as decimal ascii into out at at; returns the new offset.
pub fn put_u32_dec(out: []u8, at: usize, v: u32) -> usize {
    var n : usize = u32_dec_len(v);
    var x : u32 = v;
    var i : usize = n;
    while (i > 0) {
        i = i - 1;
        out[at + i] = @intCast(0x30 + (x % 10));
        x = x / 10;
    }
    return at + n;
}

/// The refusal line -- EmitError::message's exact shape, the phrasing the CLI
/// prints and the corpus parses: `unsupported construct <construct> at line
/// <line> (fn <func>: <detail>)`.
pub fn refusal_message(out: []u8, at: usize, construct: []const u8, line: u32, func: []const u8, detail: []const u8) -> usize {
    var n : usize = copy_bytes(out, at, "unsupported construct ");
    n = copy_bytes(out, n, construct);
    n = copy_bytes(out, n, " at line ");
    n = put_u32_dec(out, n, line);
    n = copy_bytes(out, n, " (fn ");
    n = copy_bytes(out, n, func);
    n = copy_bytes(out, n, ": ");
    n = copy_bytes(out, n, detail);
    return copy_bytes(out, n, ")");
}

/// A var at or beyond the parameter count is a local the emitter never lowers.
pub fn refused_local_variable(var_idx: u32, nparams: u32) -> bool {
    return var_idx >= nparams;
}

/// An operator outside + - * / refuses (DivW included: only Div lowers).
pub fn refused_arithmetic_op(op: u8) -> bool {
    return op != WOP_ADD and op != WOP_SUB and op != WOP_MUL and op != WOP_DIV;
}

/// An expression kind outside Const/Var/Arith refuses.
pub fn refused_expression_kind(kind: u8) -> bool {
    return kind != EK_CONST and kind != EK_VAR and kind != EK_ARITH;
}

/// One expression node's refusal, in lower_stack's order: the kind first
/// (Const carries, Var checks its index against the parameter count, anything
/// else is an expression kind); under Arith the operator is checked BEFORE
/// the operands, and the left operand before the right (the emitter's postfix
/// walk). lhs_r and rhs_r are this fn's results for the operands.
pub fn expr_refusal(kind: u8, var_idx: u32, op: u8, nparams: u32, lhs_r: u8, rhs_r: u8) -> u8 {
    if (kind == EK_CONST) { return REF_OK; }
    if (kind == EK_VAR) {
        if (refused_local_variable(var_idx, nparams)) { return REF_LOCAL_VARIABLE; }
        return REF_OK;
    }
    if (kind == EK_ARITH) {
        if (refused_arithmetic_op(op)) { return REF_ARITHMETIC_OP; }
        if (lhs_r != REF_OK) { return lhs_r; }
        return rhs_r;
    }
    return REF_EXPRESSION_KIND;
}

/// The select pattern's body facts, in the emitter's check order: an else
/// arm, a then arm that is not one `return <const>;`, or non-constant arms
/// refuse as fn body; a condition that is not `==` refuses as if condition
/// (the comparison phrasing), a condition that is not `<param> == 0` up to
/// spelling as if condition (the shape phrasing); a parameter index at or
/// beyond the count refuses as fn body.
pub fn select_refusal(els_len: usize, then_ok: bool, arms_const: bool, cond_eq: bool, cond_shape: bool, pv: u32, nparams: u32) -> u8 {
    if (els_len != 0) { return REF_FN_BODY_SELECT; }
    if (!then_ok) { return REF_FN_BODY_SELECT; }
    if (!arms_const) { return REF_FN_BODY_SELECT; }
    if (!cond_eq) { return REF_IF_CONDITION_CMP; }
    if (!cond_shape) { return REF_IF_CONDITION_SHAPE; }
    if (refused_local_variable(pv, nparams)) { return REF_FN_BODY_SELECT; }
    return REF_OK;
}

/// One pub fn's refusal, in emit()'s exact walk order. body_r is the body's
/// own walk result (expr_refusal for BS_RETURN_EXPR, select_refusal for
/// BS_SELECT) -- the shape decides whether it is reached.
pub fn fn_refusal(is_test: bool, is_pub: bool, has_ret: bool, ret_name: []const u8, nparams: u32, params_all_i32: bool, body_shape: u8, body_r: u8) -> u8 {
    if (is_test or !is_pub) { return REF_SKIP; }
    if (!has_ret) { return REF_VOID_PUB_FN; }
    if (nparams == 0) {
        if (carrier(ret_name) == 0) {
            if (ret_name.len == 3 and ret_name[0] == 'p' and ret_name[1] == 't' and ret_name[2] == 'r') { return REF_PTR_RETURN; }
            return REF_I128_RETURN;
        }
        if (body_shape != BS_CONST_RETURN) { return REF_FN_BODY_CONST; }
        return REF_OK;
    }
    if (!params_all_i32) { return REF_FN_PARAMETERS; }
    var c : u8 = carrier(ret_name);
    if (c == 0) {
        if (ret_name.len == 3 and ret_name[0] == 'p' and ret_name[1] == 't' and ret_name[2] == 'r') { return REF_PTR_RETURN; }
        return REF_I128_RETURN;
    }
    if (c != VT_I32) { return REF_FN_RETURN_TYPE; }
    if (body_shape == BS_RETURN_EXPR or body_shape == BS_SELECT) { return body_r; }
    return REF_FN_BODY_SELECT;
}

/// The module-level refusal: an export set that came out empty.
pub fn refused_module(exports: usize) -> bool {
    return exports == 0;
}


test carrier_is_the_emitter_valtype_rule {
    // the law's own map answers first
    assert carrier("i32") == VT_I32 and carrier("i64") == VT_I64;
    assert carrier("f32") == VT_F32 and carrier("f64") == VT_F64;
    // u64 rides the i64 carrier beside i64
    assert carrier("u64") == VT_I64;
    // bool, the <=32-bit ints and the odd widths ride the i32 carrier
    assert carrier("bool") == VT_I32 and carrier("u8") == VT_I32 and carrier("u16") == VT_I32;
    assert carrier("u32") == VT_I32 and carrier("i8") == VT_I32 and carrier("i16") == VT_I32;
    assert carrier("u21") == VT_I32 and carrier("i24") == VT_I32;
    // ptr and i128 do not cross
    assert carrier("ptr") == 0 and carrier("i128") == 0;
    // carries is the carrier decision as a boolean
    assert carries("u64") and carries("bool") and carries("f64");
    assert !carries("ptr") and !carries("i128");
}

test arith_debug_names_are_the_rust_variant_spellings {
    assert std.mem.eql(u8, arith_debug_name(0), "Add");
    assert std.mem.eql(u8, arith_debug_name(6), "Div");
    assert std.mem.eql(u8, arith_debug_name(7), "DivW");
    assert std.mem.eql(u8, arith_debug_name(8), "Rem");
    assert std.mem.eql(u8, arith_debug_name(11), "Xor");
    assert std.mem.eql(u8, arith_debug_name(15), "ShrW");
}

test refusal_constructs_name_the_exact_words {
    assert std.mem.eql(u8, refusal_construct(REF_VOID_PUB_FN), "void pub fn");
    assert std.mem.eql(u8, refusal_construct(REF_PTR_RETURN), "ptr return");
    assert std.mem.eql(u8, refusal_construct(REF_I128_RETURN), "i128 return");
    assert std.mem.eql(u8, refusal_construct(REF_FN_BODY_CONST), "fn body");
    assert std.mem.eql(u8, refusal_construct(REF_FN_BODY_SELECT), "fn body");
    assert std.mem.eql(u8, refusal_construct(REF_FN_PARAMETERS), "fn parameters");
    assert std.mem.eql(u8, refusal_construct(REF_FN_RETURN_TYPE), "fn return type");
    assert std.mem.eql(u8, refusal_construct(REF_LOCAL_VARIABLE), "local variable");
    assert std.mem.eql(u8, refusal_construct(REF_ARITHMETIC_OP), "arithmetic op");
    assert std.mem.eql(u8, refusal_construct(REF_EXPRESSION_KIND), "expression kind");
    assert std.mem.eql(u8, refusal_construct(REF_IF_CONDITION_CMP), "if condition");
    assert std.mem.eql(u8, refusal_construct(REF_IF_CONDITION_SHAPE), "if condition");
    assert std.mem.eql(u8, refusal_construct(REF_MODULE), "module");
    // negative control: no two families share a construct name, and the
    // non-refusals name nothing (fail closed)
    assert !std.mem.eql(u8, refusal_construct(REF_VOID_PUB_FN), "expression kind");
    assert !std.mem.eql(u8, refusal_construct(REF_LOCAL_VARIABLE), "fn body");
    assert std.mem.eql(u8, refusal_construct(REF_SKIP), "");
    assert std.mem.eql(u8, refusal_construct(200), "");
}

test fixed_refusal_details_are_byte_stable {
    assert std.mem.eql(u8, refusal_detail(REF_VOID_PUB_FN), "the wasm32 emitter exports fns that return a scalar");
    assert std.mem.eql(u8, refusal_detail(REF_FN_BODY_CONST), "the wasm32 emitter lowers a single `return <const>;` body only");
    assert std.mem.eql(u8, refusal_detail(REF_LOCAL_VARIABLE), "the wasm32 emitter reads the fn's parameters only");
    assert std.mem.eql(u8, refusal_detail(REF_EXPRESSION_KIND), "the wasm32 emitter lowers parameters, i32 constants and + - * / only");
    assert std.mem.eql(u8, refusal_detail(REF_FN_BODY_SELECT), "the wasm32 emitter lowers `return <expr>;` or `if (<param> == 0) { return <const>; } return <const>;` only");
    assert std.mem.eql(u8, refusal_detail(REF_IF_CONDITION_CMP), "the wasm32 emitter compares a parameter against 0 (eqz, the law's comparison floor) only");
    assert std.mem.eql(u8, refusal_detail(REF_IF_CONDITION_SHAPE), "the wasm32 emitter compares a parameter against 0 only (`== 0`, eqz's exact shape)");
    assert std.mem.eql(u8, refusal_detail(REF_MODULE), "no pub fn whose body the wasm32 emitter lowers (a constant leaf, or an expression over i32 parameters and constants)");
    // the dynamic details own no fixed phrasing (fail closed)
    assert std.mem.eql(u8, refusal_detail(REF_PTR_RETURN), "");
    assert std.mem.eql(u8, refusal_detail(REF_FN_PARAMETERS), "");
    assert std.mem.eql(u8, refusal_detail(REF_FN_RETURN_TYPE), "");
    assert std.mem.eql(u8, refusal_detail(REF_ARITHMETIC_OP), "");
}

test dynamic_details_compose_the_name_in_backticks {
    var d : [96]u8 = undefined;
    var n : usize = uncarried_return_detail(d[0..96], 0, "ptr");
    assert std.mem.eql(u8, d[0..n], "the wasm32 emitter exports scalar returns, `ptr` here");
    n = uncarried_return_detail(d[0..96], 0, "i128");
    assert std.mem.eql(u8, d[0..n], "the wasm32 emitter exports scalar returns, `i128` here");
    n = i32_params_detail(d[0..96], 0, "u64");
    assert std.mem.eql(u8, d[0..n], "the wasm32 emitter carries i32 parameters, `u64` here");
    n = i32_results_detail(d[0..96], 0, "f64");
    assert std.mem.eql(u8, d[0..n], "the wasm32 emitter carries i32 results here, `f64` instead");
    n = arith_op_detail(d[0..96], 0, 8);
    assert std.mem.eql(u8, d[0..n], "the wasm32 emitter lowers + - * / on the i32 carrier, `Rem` here");
    n = arith_op_detail(d[0..96], 0, 13);
    assert std.mem.eql(u8, d[0..n], "the wasm32 emitter lowers + - * / on the i32 carrier, `Shr` here");
}

test the_seven_refusal_rows_message_shape {
    // Each row composes construct + detail through this floor's fns and pins
    // the FULL refusal line -- EmitError::message's exact bytes, the line the
    // corpus parses. Rows 1-7 are the seven refusal families; the tail rows
    // pin the remaining constructs' phrasings.
    var m : [200]u8 = undefined;
    var d : [128]u8 = undefined;
    var n : usize = 0;
    // 1: void pub fn
    n = refusal_message(m[0..200], 0, refusal_construct(REF_VOID_PUB_FN), 3, "f", refusal_detail(REF_VOID_PUB_FN));
    assert std.mem.eql(u8, m[0..n], "unsupported construct void pub fn at line 3 (fn f: the wasm32 emitter exports fns that return a scalar)");
    // 2: ptr return / i128 return
    n = refusal_message(m[0..200], 0, refusal_construct(REF_PTR_RETURN), 4, "g", d[0..uncarried_return_detail(d[0..128], 0, "ptr")]);
    assert std.mem.eql(u8, m[0..n], "unsupported construct ptr return at line 4 (fn g: the wasm32 emitter exports scalar returns, `ptr` here)");
    n = refusal_message(m[0..200], 0, refusal_construct(REF_I128_RETURN), 5, "h", d[0..uncarried_return_detail(d[0..128], 0, "i128")]);
    assert std.mem.eql(u8, m[0..n], "unsupported construct i128 return at line 5 (fn h: the wasm32 emitter exports scalar returns, `i128` here)");
    // 3: fn body (both phrasings)
    n = refusal_message(m[0..200], 0, refusal_construct(REF_FN_BODY_CONST), 6, "i", refusal_detail(REF_FN_BODY_CONST));
    assert std.mem.eql(u8, m[0..n], "unsupported construct fn body at line 6 (fn i: the wasm32 emitter lowers a single `return <const>;` body only)");
    n = refusal_message(m[0..200], 0, refusal_construct(REF_FN_BODY_SELECT), 7, "j", refusal_detail(REF_FN_BODY_SELECT));
    assert std.mem.eql(u8, m[0..n], "unsupported construct fn body at line 7 (fn j: the wasm32 emitter lowers `return <expr>;` or `if (<param> == 0) { return <const>; } return <const>;` only)");
    // 4: expression kind
    n = refusal_message(m[0..200], 0, refusal_construct(REF_EXPRESSION_KIND), 8, "k", refusal_detail(REF_EXPRESSION_KIND));
    assert std.mem.eql(u8, m[0..n], "unsupported construct expression kind at line 8 (fn k: the wasm32 emitter lowers parameters, i32 constants and + - * / only)");
    // 5: arithmetic op
    n = refusal_message(m[0..200], 0, refusal_construct(REF_ARITHMETIC_OP), 9, "l", d[0..arith_op_detail(d[0..128], 0, 8)]);
    assert std.mem.eql(u8, m[0..n], "unsupported construct arithmetic op at line 9 (fn l: the wasm32 emitter lowers + - * / on the i32 carrier, `Rem` here)");
    // 6: local variable
    n = refusal_message(m[0..200], 0, refusal_construct(REF_LOCAL_VARIABLE), 10, "m", refusal_detail(REF_LOCAL_VARIABLE));
    assert std.mem.eql(u8, m[0..n], "unsupported construct local variable at line 10 (fn m: the wasm32 emitter reads the fn's parameters only)");
    // 7: module (the whole module, line 0)
    n = refusal_message(m[0..200], 0, refusal_construct(REF_MODULE), module_line(), module_func(), refusal_detail(REF_MODULE));
    assert std.mem.eql(u8, m[0..n], "unsupported construct module at line 0 (fn (module): no pub fn whose body the wasm32 emitter lowers (a constant leaf, or an expression over i32 parameters and constants))");
    // the remaining constructs
    n = refusal_message(m[0..200], 0, refusal_construct(REF_FN_PARAMETERS), 11, "n", d[0..i32_params_detail(d[0..128], 0, "u64")]);
    assert std.mem.eql(u8, m[0..n], "unsupported construct fn parameters at line 11 (fn n: the wasm32 emitter carries i32 parameters, `u64` here)");
    n = refusal_message(m[0..200], 0, refusal_construct(REF_FN_RETURN_TYPE), 12, "o", d[0..i32_results_detail(d[0..128], 0, "f64")]);
    assert std.mem.eql(u8, m[0..n], "unsupported construct fn return type at line 12 (fn o: the wasm32 emitter carries i32 results here, `f64` instead)");
    n = refusal_message(m[0..200], 0, refusal_construct(REF_IF_CONDITION_CMP), 13, "p", refusal_detail(REF_IF_CONDITION_CMP));
    assert std.mem.eql(u8, m[0..n], "unsupported construct if condition at line 13 (fn p: the wasm32 emitter compares a parameter against 0 (eqz, the law's comparison floor) only)");
    n = refusal_message(m[0..200], 0, refusal_construct(REF_IF_CONDITION_SHAPE), 14, "q", refusal_detail(REF_IF_CONDITION_SHAPE));
    assert std.mem.eql(u8, m[0..n], "unsupported construct if condition at line 14 (fn q: the wasm32 emitter compares a parameter against 0 only (`== 0`, eqz's exact shape))");
    // the decimal writer the line count rides on
    assert u32_dec_len(0) == 1 and u32_dec_len(9) == 1 and u32_dec_len(10) == 2;
    assert u32_dec_len(1234) == 4;
}

test expr_refusal_walks_lower_stack_order {
    // Const carries
    assert expr_refusal(EK_CONST, 0, 0, 0, REF_OK, REF_OK) == REF_OK;
    // Var inside the parameter count carries; at or beyond it refuses
    assert expr_refusal(EK_VAR, 0, 0, 1, REF_OK, REF_OK) == REF_OK;
    assert expr_refusal(EK_VAR, 1, 0, 1, REF_OK, REF_OK) == REF_LOCAL_VARIABLE;
    assert expr_refusal(EK_VAR, 0, 0, 0, REF_OK, REF_OK) == REF_LOCAL_VARIABLE;
    // the operator refuses before the operands are walked (Rem, DivW)
    assert expr_refusal(EK_ARITH, 0, 8, 1, REF_EXPRESSION_KIND, REF_OK) == REF_ARITHMETIC_OP;
    assert expr_refusal(EK_ARITH, 0, 7, 1, REF_OK, REF_OK) == REF_ARITHMETIC_OP;
    // the four carried operators pass; lhs before rhs
    assert expr_refusal(EK_ARITH, 0, 0, 1, REF_LOCAL_VARIABLE, REF_EXPRESSION_KIND) == REF_LOCAL_VARIABLE;
    assert expr_refusal(EK_ARITH, 0, 1, 1, REF_OK, REF_EXPRESSION_KIND) == REF_EXPRESSION_KIND;
    assert expr_refusal(EK_ARITH, 0, 2, 1, REF_OK, REF_OK) == REF_OK;
    assert expr_refusal(EK_ARITH, 0, 6, 1, REF_OK, REF_OK) == REF_OK;
    // any other kind is an expression kind
    assert expr_refusal(7, 0, 0, 1, REF_OK, REF_OK) == REF_EXPRESSION_KIND;
    // refused_arithmetic_op is the four-operator rule alone
    assert !refused_arithmetic_op(0) and !refused_arithmetic_op(1);
    assert !refused_arithmetic_op(2) and !refused_arithmetic_op(6);
    assert refused_arithmetic_op(7) and refused_arithmetic_op(8);
    assert refused_expression_kind(0) == false;
    assert refused_expression_kind(3) == true;
}

test select_refusal_walks_the_pattern_facts_in_order {
    // else arm, then arm, arms: fn body, before the condition facts
    assert select_refusal(1, true, true, true, true, 0, 1) == REF_FN_BODY_SELECT;
    assert select_refusal(0, false, true, false, true, 0, 1) == REF_FN_BODY_SELECT;
    assert select_refusal(0, true, false, false, false, 0, 1) == REF_FN_BODY_SELECT;
    // the condition: not == is the comparison phrasing, == but not the
    // var-against-0 shape is the shape phrasing
    assert select_refusal(0, true, true, false, false, 0, 1) == REF_IF_CONDITION_CMP;
    assert select_refusal(0, true, true, true, false, 0, 1) == REF_IF_CONDITION_SHAPE;
    // a condition parameter at or beyond the count is a fn body refusal
    assert select_refusal(0, true, true, true, true, 1, 1) == REF_FN_BODY_SELECT;
    // the emitable pattern
    assert select_refusal(0, true, true, true, true, 0, 1) == REF_OK;
}

test fn_refusal_walks_the_emitter_order {
    // a test or a private fn is skipped: no refusal, not an export
    assert fn_refusal(true, true, true, "i32", 0, true, BS_CONST_RETURN, REF_OK) == REF_SKIP;
    assert fn_refusal(false, false, true, "ptr", 0, false, BS_OTHER, REF_OK) == REF_SKIP;
    // void refuses before any return fact is read
    assert fn_refusal(false, true, false, "ptr", 2, false, BS_OTHER, REF_OK) == REF_VOID_PUB_FN;
    // M-A: an uncarried return refuses before the body; ptr vs i128 by name
    assert fn_refusal(false, true, true, "ptr", 0, true, BS_OTHER, REF_OK) == REF_PTR_RETURN;
    assert fn_refusal(false, true, true, "i128", 0, true, BS_CONST_RETURN, REF_OK) == REF_I128_RETURN;
    // M-A: a non-constant body refuses
    assert fn_refusal(false, true, true, "i32", 0, true, BS_OTHER, REF_OK) == REF_FN_BODY_CONST;
    // M-A: a constant leaf of ANY carried scalar is emitable (f64 included)
    assert fn_refusal(false, true, true, "f64", 0, true, BS_CONST_RETURN, REF_OK) == REF_OK;
    // M-B: a parameter off the i32 carrier refuses before the return facts
    assert fn_refusal(false, true, true, "ptr", 2, false, BS_OTHER, REF_OK) == REF_FN_PARAMETERS;
    // M-B: the uncarried return, then the non-i32 return, then the body
    assert fn_refusal(false, true, true, "ptr", 1, true, BS_OTHER, REF_OK) == REF_PTR_RETURN;
    assert fn_refusal(false, true, true, "f64", 1, true, BS_RETURN_EXPR, REF_LOCAL_VARIABLE) == REF_FN_RETURN_TYPE;
    assert fn_refusal(false, true, true, "i32", 1, true, BS_RETURN_EXPR, REF_LOCAL_VARIABLE) == REF_LOCAL_VARIABLE;
    assert fn_refusal(false, true, true, "i32", 1, true, BS_SELECT, REF_IF_CONDITION_SHAPE) == REF_IF_CONDITION_SHAPE;
    // M-B: any other body is a fn body refusal, the body walk never reached
    assert fn_refusal(false, true, true, "i32", 1, true, BS_OTHER, REF_OK) == REF_FN_BODY_SELECT;
    // M-B: a u32 return rides the i32 carrier and a clean expr body emits
    assert fn_refusal(false, true, true, "u32", 2, true, BS_RETURN_EXPR, REF_OK) == REF_OK;
    // the module-level refusal fires on the empty export set only
    assert refused_module(0);
    assert !refused_module(1) and !refused_module(3);
}
