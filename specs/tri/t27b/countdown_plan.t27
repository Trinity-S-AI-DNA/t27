// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/countdown_plan.t27 -- Safety predicate for AArch64 count-down loop transformation
; Converts `while (i < N) { ...; i = i + 1; }` (i starts at 0) to count down from N,
; replacing `add i,i,#1; cmp i,N; b.lt` with `subs cnt,cnt,#1; b.ne`, saving 1 word per iteration.
; Witness shape: bench_audit outer `while (i < CALLS_TARGET) { ...; i = i + 1; }`.
; Implemented in cli/t27b/src/lower.rs (this PR, Refs #13421, MERGED).
; The lower.rs transform walks the preceding Assign statements to find init=0,
; flips the step Add->SubW, and rewrites the cond from Cmp(Lt,i,N) to Var(i).
; Gen: (no generated output -- safety predicate is called inline in lower.rs)
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY
; Refs #13421 #12871

module T27bCountdownPlan;

; AArch64 shape (before -- 3 words for loop control):
;   add  i, i, #1
;   cmp  i, N          ; N loaded from immediate or register
;   b.lt loop_top
//
; AArch64 shape (after -- 2 words for loop control):
;   ; init: mov cnt, N  (once, before the loop)
;   ; body: ...
;   subs cnt, cnt, #1
;   b.ne loop_top
;
; Net saving: 1 word per loop iteration (the `cmp` instruction is eliminated because
; `subs` sets the Z flag: cnt becomes 0 exactly when all N iterations are done).
;
; Implementation prerequisite:
;   (a) `init_is_zero`  : the loop variable `i` is assigned 0 before the While node.
;       lower.rs sees only the While node, not the preceding Assign; a new pre-pass must
;       link the init assignment to its While consumer.
;   (b) `body_reads_only_for_index` : the body never reads `i` for a purpose other than
;       array indexing or comparison against the limit; reading `i` as a value that feeds
;       the loop-down counter would produce a wrong result after the direction change.
;   (c) `limit_is_const` : N must be a compile-time constant or a loop-invariant variable
;       whose value is known at loop entry; a mutable N makes the initial `mov cnt, N` wrong.
; --

; Whether the while loop is a safe candidate for count-down conversion.
;
; Parameters:
;   strict_lt          : condition is `<` (not `<=`); `<=` changes the off-by-one
;   init_is_zero       : loop variable was assigned 0 immediately before the While node
;   limit_is_const     : upper bound N is a compile-time constant or loop-invariant variable
;   step_is_one        : the increment is exactly 1 (a step of 2 would need subs cnt,cnt,#2)
;   body_reads_only_for_index : body does not use the induction variable as a data value
pub fn countdown_ok(
    strict_lt: bool,
    init_is_zero: bool,
    limit_is_const: bool,
    step_is_one: bool,
    body_reads_only_for_index: bool
) -> bool {
    if (!strict_lt) { return false; }
    if (!init_is_zero) { return false; }
    if (!limit_is_const) { return false; }
    if (!step_is_one) { return false; }
    if (!body_reads_only_for_index) { return false; }
    return true;
}

; ---- tests ----

test countdown_accepts_bench_audit_pattern {
    ; while (i < CALLS_TARGET) with i=0 before the loop, constant limit, step 1.
    ; Body only reads `i` to test i < CALLS_TARGET; never uses i as an index or value.
    assert(countdown_ok(true, true, true, true, true));
}

test countdown_refuses_le_condition {
    ; `while (i <= N)` runs N+1 times; count down from N to -1 wraps unsigned.
    assert(!countdown_ok(false, true, true, true, true));
}

test countdown_refuses_nonzero_init {
    ; `i = 5; while (i < N)` -- count-down must start at N - 5, not N.
    ; The init-site analysis is not yet wired into lower.rs.
    assert(!countdown_ok(true, false, true, true, true));
}

test countdown_refuses_mutable_limit {
    ; `while (i < n)` where `n` is modified in the loop body:
    ; the initial `mov cnt, n` captures a stale value.
    assert(!countdown_ok(true, true, false, true, true));
}

test countdown_refuses_step_two {
    ; A step of 2 would work but requires a separate rule (subs cnt,cnt,#2).
    assert(!countdown_ok(true, true, true, false, true));
}

test countdown_refuses_body_reads_i_as_value {
    ; If the body computes `result = result + i` the value of i is part of the output.
    ; After transformation i is replaced by the countdown counter which decrements;
    ; the original value of i is not directly available without an extra subtraction.
    assert(!countdown_ok(true, true, true, true, false));
}
