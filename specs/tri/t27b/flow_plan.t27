// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/flow_plan.t27 -- how a statement list ends, as t27b codegen reads it (Refs #12871).
; cli/t27b/src/codegen.rs maps the LAST statement of a list to a kind constant below and recurses
; into the arms of an `if`; the decision itself lives here.
;   ends_in_jump_kind: the list ends in return, break or continue (no fall-through code follows).
;   falls_through: control may reach the end of the list. Conservative: false only when it
;   certainly cannot (last stmt a return, or an `if` whose both arms cannot fall through).
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bFlowPlan;

pub const SK_NONE : u8 = 0;
pub const SK_RETURN : u8 = 1;
pub const SK_BREAK : u8 = 2;
pub const SK_CONTINUE : u8 = 3;
pub const SK_IF : u8 = 4;
pub const SK_OTHER : u8 = 5;

pub fn ends_in_jump_kind(kind: u8) -> bool {
    return (kind == SK_RETURN) or (kind == SK_BREAK) or (kind == SK_CONTINUE);
}

pub fn falls_through(kind: u8, then_falls: bool, els_empty: bool, els_falls: bool) -> bool {
    if (kind == SK_RETURN) { return false; }
    if (kind == SK_IF) { return then_falls or els_empty or els_falls; }
    return true;
}

test jump_kinds_are_return_break_continue {
    assert ends_in_jump_kind(SK_RETURN);
    assert ends_in_jump_kind(SK_BREAK);
    assert ends_in_jump_kind(SK_CONTINUE);
    assert ends_in_jump_kind(SK_IF) == false;
    assert ends_in_jump_kind(SK_OTHER) == false;
    assert ends_in_jump_kind(SK_NONE) == false;
}
test return_never_falls_through {
    assert falls_through(SK_RETURN, true, true, true) == false;
    assert falls_through(SK_RETURN, false, false, false) == false;
}
test plain_kinds_fall_through {
    assert falls_through(SK_NONE, false, false, false);
    assert falls_through(SK_BREAK, false, false, false);
    assert falls_through(SK_CONTINUE, false, false, false);
    assert falls_through(SK_OTHER, false, false, false);
}
test an_if_falls_through_unless_both_arms_cannot {
    assert falls_through(SK_IF, true, false, false);
    assert falls_through(SK_IF, false, true, false);
    assert falls_through(SK_IF, false, false, true);
    assert falls_through(SK_IF, false, false, false) == false;
    assert falls_through(SK_IF, true, true, true);
}
