// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/libm.t27 -- the float routines t27b runs for a Zig math builtin or a `std.math` fn,
; written in t27 (issues #7391, #7217, #7791, #7819, #7822, #7923, #7823 and #8677, t27b coverage epic #6063:
; ExprCall(@exp), ExprCall(@log), std.math.nan, isNan, isPositiveInf, isNegativeInf, @floor, @ceil, @round, @trunc,
; @rem, @log, @log2, @log10 and std.math.pow of an f32, and std.math.inf, std.math.log1p, @round and @cos of an f64).
; `t27c test-report` runs `zig test` without libc, so a run-time `@exp(x)` is a call into Zig's
; compiler_rt: `exp` for an f64 and `expf` for an f32, both ports of the FreeBSD/musl fdlibm code.
; A run-time `@log(x)` of an f64 is compiler_rt's `log`, a port of musl's table-driven log.c.
; None is correctly rounded, so "close to e^x" is not the reference's answer: t27b must return
; the same bits. The `t27b_libm_*` fns below are those algorithms step for step, with the same
; constants and tables, the same operation order and the same final rounding.
; t27b splices these fns and tables into a program that uses `@exp` or `@log`, renamed to
; `__t27b_libm_*`, and lowers `@exp(x)` of an f64 or an f32 to a call of `__t27b_libm_exp` or
; `__t27b_libm_expf`, and `@log(x)` of an f64 to `__t27b_libm_log`. When it does that, and what it
; refuses instead, is specs/tri/t27b/libm_plan.t27.
; Three departures in form, none in value:
; - fdlibm reads the high word of x (`hx`) to pick a branch. Every such test here is the same
;   comparison on |x|: `hx > H` holds exactly when |x| is at least the double whose high word is H + 1.
; - `scalbn(y, k)` is a product of exact powers of two. Only the last multiply can round, and it
;   rounds to nearest even, which is what Zig's `ldexp` does for every y this code produces.
; - musl's log splits x = z * 2^k by subtracting a bit pattern from x's bits. Here z and k come
;   from multiplying by exact powers of two, which gives the same z and k, and the table index
;   (bits 45..51 of that difference) is the same affine function of z, computed exactly.
; `std.math.nan`, `isNan`, `isPositiveInf` and `isNegativeInf` (#7791) are Zig 0.16's std/math/float.zig,
; isnan.zig and isinf.zig, a line each: the canonical quiet NaN by its bits, `x != x`, `x == inf`, `x == -inf`.
; `std.math.inf` (#7923) is +inf by its bits; `std.math.log1p` of an f64 is std/math/log1p.zig's `log1p_64`
; (musl's log1p.c) and `@round` of an f64 compiler_rt's `round`, both step for step; `std.math.log(T, std.math.e,
; x)` is `@log(x)` in std/math/log.zig and calls `log` above.
; A run-time `@cos(x)` of an f64 (#8677) is compiler_rt's `cos`, musl's cos.c with its kernels and its argument reduction
; (`rem_pio2`, and Payne-Hanek `rem_pio2_large` past 2^20 * pi/2), step for step; see the comment above `t27b_libm_kcos`.
; A `@exp` or `@log` of a literal (a comptime_float) is refused: Zig may fold it at 128-bit precision.
; The tests check the routines against Zig's `@exp` and `@log` on run-time operands: equal on every
; point of each sweep, under the reference; and against fixed values for both. A call Zig folds at
; compile time (a `const` operand, an unrolled loop, an invariant) gives the same bits.
; The ports are the ones of draft PRs #7426 (exp, expf) and #7466 (log), unchanged but for the names
; of log's tables (`t27b_libm_log_*`, so the prefix rename covers them); the compile-time tests and
; the invariants are new.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bLibm;

// 2^j for -1022 <= j <= 1023: every partial product is an exact power of two.
fn t27b_libm_pow2(t27b_j: i32) -> f64 {
    var t27b_p: f64 = 1.0;
    var t27b_n: i32 = t27b_j;
    while (t27b_n >= 64) {
        t27b_p = t27b_p * 18446744073709551616.0;
        t27b_n = t27b_n - 64;
    }
    while (t27b_n > 0) {
        t27b_p = t27b_p * 2.0;
        t27b_n = t27b_n - 1;
    }
    while (t27b_n <= -64) {
        t27b_p = t27b_p * 5.421010862427522e-20;
        t27b_n = t27b_n + 64;
    }
    while (t27b_n < 0) {
        t27b_p = t27b_p * 0.5;
        t27b_n = t27b_n + 1;
    }
    return t27b_p;
}

// y * 2^k for -1075 <= k <= 1024 and 0.5 < y < 2, rounded once.
fn t27b_libm_scalbn(t27b_y: f64, t27b_k: i32) -> f64 {
    if (t27b_k > 1023) {
        return t27b_y * 8.98846567431158e307 * t27b_libm_pow2(t27b_k - 1023);
    }
    if (t27b_k < -1022) {
        return t27b_y * t27b_libm_pow2(t27b_k + 64) * 5.421010862427522e-20;
    }
    return t27b_y * t27b_libm_pow2(t27b_k);
}

// compiler_rt `exp` (f64).
fn t27b_libm_exp(t27b_x: f64) -> f64 {
    if (t27b_x != t27b_x) {
        return t27b_x;
    }
    if (t27b_x > 709.782712893384) {
        return t27b_x * 8.98846567431158e307;
    }
    if (t27b_x < -745.1332191019411) {
        return 0.0;
    }
    var t27b_a: f64 = t27b_x;
    if (t27b_x < 0.0) {
        t27b_a = -t27b_x;
    }
    var t27b_r: f64 = t27b_x;
    var t27b_hi: f64 = t27b_x;
    var t27b_lo: f64 = 0.0;
    var t27b_k: i32 = 0;
    if (t27b_a >= 0.3465735912322998) {
        if (t27b_a >= 1.0397214889526367) {
            var t27b_h: f64 = 0.5;
            if (t27b_x < 0.0) {
                t27b_h = -0.5;
            }
            t27b_k = @intFromFloat(1.4426950408889634 * t27b_x + t27b_h);
        } else {
            t27b_k = 1;
            if (t27b_x < 0.0) {
                t27b_k = -1;
            }
        }
        const t27b_dk: f64 = @floatFromInt(t27b_k);
        t27b_hi = t27b_x - t27b_dk * 0.6931471803691238;
        t27b_lo = t27b_dk * 1.9082149292705877e-10;
        t27b_r = t27b_hi - t27b_lo;
    } else if (t27b_a < 3.725293851175593e-9) {
        return 1.0 + t27b_x;
    }
    const t27b_xx: f64 = t27b_r * t27b_r;
    const t27b_c: f64 = t27b_r - t27b_xx * (0.16666666666666602 + t27b_xx * (-0.0027777777777015593 + t27b_xx * (6.613756321437934e-05 + t27b_xx * (-1.6533902205465252e-06 + t27b_xx * 4.1381367970572385e-08))));
    const t27b_y: f64 = 1.0 + (t27b_r * t27b_c / (2.0 - t27b_c) - t27b_lo + t27b_hi);
    if (t27b_k == 0) {
        return t27b_y;
    }
    return t27b_libm_scalbn(t27b_y, t27b_k);
}

// 2^j for -126 <= j <= 127, in single precision.
fn t27b_libm_pow2f(t27b_j: i32) -> f32 {
    var t27b_p: f32 = 1.0;
    var t27b_n: i32 = t27b_j;
    while (t27b_n >= 64) {
        t27b_p = t27b_p * 18446744073709551616.0;
        t27b_n = t27b_n - 64;
    }
    while (t27b_n > 0) {
        t27b_p = t27b_p * 2.0;
        t27b_n = t27b_n - 1;
    }
    while (t27b_n <= -64) {
        t27b_p = t27b_p * 5.421010862427522e-20;
        t27b_n = t27b_n + 64;
    }
    while (t27b_n < 0) {
        t27b_p = t27b_p * 0.5;
        t27b_n = t27b_n + 1;
    }
    return t27b_p;
}

// y * 2^k for -150 <= k <= 128 and 0.5 < y < 2, rounded once.
fn t27b_libm_scalbnf(t27b_y: f32, t27b_k: i32) -> f32 {
    if (t27b_k > 127) {
        return t27b_y * 1.7014118346046923e38 * t27b_libm_pow2f(t27b_k - 127);
    }
    if (t27b_k < -126) {
        return t27b_y * t27b_libm_pow2f(t27b_k + 64) * 5.421010862427522e-20;
    }
    return t27b_y * t27b_libm_pow2f(t27b_k);
}

// compiler_rt `expf` (f32).
fn t27b_libm_expf(t27b_x: f32) -> f32 {
    if (t27b_x != t27b_x) {
        return t27b_x;
    }
    if (t27b_x >= 88.72283935546875) {
        return t27b_x * 1.7014118346046923e38;
    }
    if (t27b_x <= -103.97208404541015625) {
        return 0.0;
    }
    var t27b_a: f32 = t27b_x;
    if (t27b_x < 0.0) {
        t27b_a = -t27b_x;
    }
    var t27b_r: f32 = t27b_x;
    var t27b_hi: f32 = t27b_x;
    var t27b_lo: f32 = 0.0;
    var t27b_k: i32 = 0;
    if (t27b_a > 0.3465735912322998046875) {
        if (t27b_a > 1.0397207736968994140625) {
            var t27b_h: f32 = 0.5;
            if (t27b_x < 0.0) {
                t27b_h = -0.5;
            }
            t27b_k = @intFromFloat(1.44269502162933349609375 * t27b_x + t27b_h);
        } else {
            t27b_k = 1;
            if (t27b_x < 0.0) {
                t27b_k = -1;
            }
        }
        const t27b_fk: f32 = @floatFromInt(t27b_k);
        t27b_hi = t27b_x - t27b_fk * 0.693145751953125;
        t27b_lo = t27b_fk * 1.428606765330187045037746429443359375e-6;
        t27b_r = t27b_hi - t27b_lo;
    } else if (t27b_a <= 0.0001220703125) {
        return 1.0 + t27b_x;
    }
    const t27b_xx: f32 = t27b_r * t27b_r;
    const t27b_c: f32 = t27b_r - t27b_xx * (0.16666625440120697021484375 + t27b_xx * -0.00276673329062759876251220703125);
    const t27b_y: f32 = 1.0 + (t27b_r * t27b_c / (2.0 - t27b_c) - t27b_lo + t27b_hi);
    if (t27b_k == 0) {
        return t27b_y;
    }
    return t27b_libm_scalbnf(t27b_y, t27b_k);
}

