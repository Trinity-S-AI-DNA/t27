// compiler_rt `log` (f64): musl's log.c, the 128-entry table version, step for step.
// The tables are musl's `__log_data` (invc, logc, chi, clo), printed as shortest round-trip decimals.
fn t27b_libm_log(t27b_x: f64) -> f64 {
    // musl: LO <= ix < HI, the band around 1 that skips the table.
    if (t27b_x >= 0.9375 and t27b_x < 1.064697265625) {
        if (t27b_x == 1.0) {
            return 0.0;
        }
        const t27b_r: f64 = t27b_x - 1.0;
        const t27b_r2: f64 = t27b_r * t27b_r;
        const t27b_r3: f64 = t27b_r * t27b_r2;
        const t27b_y: f64 = t27b_r3 * (0.3333333333333352 + t27b_r * -0.24999999999998432 + t27b_r2 * 0.19999999999320328 + t27b_r3 * (-0.16666666669929706 + t27b_r * 0.14285715076560868 + t27b_r2 * -0.12499997863982555 + t27b_r3 * (0.11110712032936046 + t27b_r * -0.10000486757818193 + t27b_r2 * 0.09181994006195467 + t27b_r3 * -0.08328363062289341)));
        var t27b_w: f64 = t27b_r * 134217728.0;
        const t27b_rhi: f64 = t27b_r + t27b_w - t27b_w;
        const t27b_rlo: f64 = t27b_r - t27b_rhi;
        t27b_w = t27b_rhi * t27b_rhi * -0.5;
        const t27b_hi: f64 = t27b_r + t27b_w;
        const t27b_lo: f64 = t27b_r - t27b_hi + t27b_w + -0.5 * t27b_rlo * (t27b_rhi + t27b_r);
        return t27b_y + t27b_lo + t27b_hi;
    }
    if (t27b_x == 0.0) {
        return -1.0 / (t27b_x * t27b_x);
    }
    if (t27b_x > 1.7976931348623157e308) {
        return t27b_x;
    }
    if (t27b_x != t27b_x or t27b_x < 0.0) {
        const t27b_d: f64 = t27b_x - t27b_x;
        return t27b_d / t27b_d;
    }
    // x = z * 2^k with z in [0.6875, 1.375): musl's `ix - 0x3fe6000000000000` split, by exact scaling.
    var t27b_z: f64 = t27b_x;
    var t27b_k: i32 = 0;
    if (t27b_z < 2.2250738585072014e-308) {
        t27b_z = t27b_z * 4503599627370496.0;
        t27b_k = -52;
    }
    while (t27b_z >= 18446744073709551616.0) {
        t27b_z = t27b_z * 5.421010862427522e-20;
        t27b_k = t27b_k + 64;
    }
    while (t27b_z >= 1.375) {
        t27b_z = t27b_z * 0.5;
        t27b_k = t27b_k + 1;
    }
    while (t27b_z < 5.421010862427522e-20) {
        t27b_z = t27b_z * 18446744073709551616.0;
        t27b_k = t27b_k - 64;
    }
    while (t27b_z < 0.6875) {
        t27b_z = t27b_z * 2.0;
        t27b_k = t27b_k - 1;
    }
    // The table index: bits 45..51 of `iz - 0x3fe6000000000000`.
    var t27b_i: usize = 0;
    if (t27b_z < 1.0) {
        t27b_i = @intFromFloat((t27b_z * 2.0 - 1.375) * 128.0);
    } else {
        t27b_i = @intFromFloat((t27b_z - 0.375) * 128.0);
    }
    const t27b_r: f64 = (t27b_z - t27b_libm_log_chi[t27b_i] - t27b_libm_log_clo[t27b_i]) * t27b_libm_log_invc[t27b_i];
    const t27b_kd: f64 = @floatFromInt(t27b_k);
    const t27b_w: f64 = t27b_kd * 0.6931471805598903 + t27b_libm_log_logc[t27b_i];
    const t27b_hi: f64 = t27b_w + t27b_r;
    const t27b_lo: f64 = t27b_w - t27b_hi + t27b_r + t27b_kd * 5.497923018708371e-14;
    const t27b_r2: f64 = t27b_r * t27b_r;
    return t27b_lo + t27b_r2 * -0.5000000000000001 + t27b_r * t27b_r2 * (0.33333333331825593 + t27b_r * -0.2499999999622955 + t27b_r2 * (0.20000304511814496 + t27b_r * -0.16667054827627667)) + t27b_hi;
}

// The bits of the canonical quiet NaN (exponent all ones, the top fraction bit set) and of +inf (exponent
// all ones, fraction zero), std/math/float.zig's `nan` and `inf`. Measured on the t27c lab: std.math.nan(f64)
// is 0x7FF8000000000000 and std.math.nan(f32) 0x7FC00000. Module-level, so t27c's optimizer never puts the
// literal itself in a `@bitCast`, which Zig refuses (specs/tri/t27b/bit_cast_plan.t27).
const t27b_libm_qnan64: u64 = 0x7FF8000000000000;
const t27b_libm_qnan32: u32 = 0x7FC00000;
const t27b_libm_inf64: u64 = 0x7FF0000000000000;
const t27b_libm_inf32: u32 = 0x7F800000;

// std.math.nan(f64) and std.math.nan(f32).
fn t27b_libm_nan() -> f64 {
    return @bitCast(t27b_libm_qnan64);
}

fn t27b_libm_nanf() -> f32 {
    return @bitCast(t27b_libm_qnan32);
}

// std.math.isNan (std/math/isnan.zig): `x != x`.
fn t27b_libm_isnan(t27b_x: f64) -> bool {
    return t27b_x != t27b_x;
}

fn t27b_libm_isnanf(t27b_x: f32) -> bool {
    return t27b_x != t27b_x;
}

// std.math.isPositiveInf and isNegativeInf (std/math/isinf.zig): `x == math.inf(T)` and `x == -math.inf(T)`.
fn t27b_libm_isposinf(t27b_x: f64) -> bool {
    const t27b_inf: f64 = @bitCast(t27b_libm_inf64);
    return t27b_x == t27b_inf;
}

fn t27b_libm_isposinff(t27b_x: f32) -> bool {
    const t27b_inf: f32 = @bitCast(t27b_libm_inf32);
    return t27b_x == t27b_inf;
}

fn t27b_libm_isneginf(t27b_x: f64) -> bool {
    const t27b_inf: f64 = @bitCast(t27b_libm_inf64);
    return t27b_x == -t27b_inf;
}

fn t27b_libm_isneginff(t27b_x: f32) -> bool {
    const t27b_inf: f32 = @bitCast(t27b_libm_inf32);
    return t27b_x == -t27b_inf;
}

// The f32 rounding builtins and `@rem` (#7819, for specs/numeric/gf16.t27). Measured on the t27c lab (zig 0.16.0,
// x86_64 Debug, a CPU with SSE4.1): `@floor`, `@ceil` and `@trunc` of an f32 are `roundss`, exact, and a signalling
// NaN comes back quieted (0x7F800001 gives 0x7FC00001), as aarch64's frintm / frintp / frintz give it. `@round` is a
// call of compiler_rt `roundf`, which returns a NaN as it is; `@rem` is compiler_rt `fmodf`. The ports below are
// compiler_rt's (floor_ceil.zig, round.zig, trunc.zig, fmod.zig: musl's floorf.c, ceilf.c, roundf.c, truncf.c,
// fmodf.c), step for step on the bits, with one change: `floorf`, `ceilf` and `truncf` quiet a NaN (`x + x`, which
// keeps its sign and payload), as the instruction does. compiler_rt shifts bits out at the top (`u << 1 == 0`,
// `ux << 9`); those tests read the same bits through a mask here.
const t27b_libm_frac32: u32 = 0x007FFFFF;
const t27b_libm_ones32: u32 = 0xFFFFFFFF;
const t27b_libm_negzero32: u32 = 0x80000000;

// compiler_rt `floorf` (`impl(f32, .floor, x)`).
fn t27b_libm_floorf(t27b_x: f32) -> f32 {
    if (t27b_x != t27b_x) {
        return t27b_x + t27b_x;
    }
    var t27b_u: u32 = @bitCast(t27b_x);
    const t27b_be: i32 = @intCast((t27b_u >> 23) & 0xFF);
    const t27b_e: i32 = t27b_be - 127;
    if (t27b_e >= 23) {
        return t27b_x;
    }
    if (t27b_e >= 0) {
        const t27b_m: u32 = t27b_libm_frac32 >> t27b_e;
        if ((t27b_u & t27b_m) == 0) {
            return t27b_x;
        }
        if ((t27b_u >> 31) == 1) {
            t27b_u = t27b_u + t27b_m;
        }
        return @bitCast(t27b_u & (t27b_libm_ones32 ^ t27b_m));
    }
    if ((t27b_u >> 31) == 0) {
        return 0.0;
    }
    if ((t27b_u & 0x7FFFFFFF) != 0) {
        return -1.0;
    }
    return t27b_x;
}

// compiler_rt `ceilf` (`impl(f32, .ceil, x)`).
fn t27b_libm_ceilf(t27b_x: f32) -> f32 {
    if (t27b_x != t27b_x) {
        return t27b_x + t27b_x;
    }
    var t27b_u: u32 = @bitCast(t27b_x);
    const t27b_be: i32 = @intCast((t27b_u >> 23) & 0xFF);
    const t27b_e: i32 = t27b_be - 127;
    if (t27b_e >= 23) {
        return t27b_x;
    }
    if (t27b_e >= 0) {
        const t27b_m: u32 = t27b_libm_frac32 >> t27b_e;
        if ((t27b_u & t27b_m) == 0) {
            return t27b_x;
        }
        if ((t27b_u >> 31) == 0) {
            t27b_u = t27b_u + t27b_m;
        }
        return @bitCast(t27b_u & (t27b_libm_ones32 ^ t27b_m));
    }
    if ((t27b_u >> 31) != 0) {
        return @bitCast(t27b_libm_negzero32);
    }
    if ((t27b_u & 0x7FFFFFFF) != 0) {
        return 1.0;
    }
    return t27b_x;
}

// compiler_rt `roundf`: half away from zero. `f32_toint` is 1 / floatEps(f32) = 2^23.
fn t27b_libm_roundf(t27b_x0: f32) -> f32 {
    var t27b_x: f32 = t27b_x0;
    const t27b_u: u32 = @bitCast(t27b_x0);
    const t27b_e: u32 = (t27b_u >> 23) & 0xFF;
    if (t27b_e >= 150) {
        return t27b_x;
    }
    if ((t27b_u >> 31) != 0) {
        t27b_x = -t27b_x;
    }
    if (t27b_e < 126) {
        return 0.0 * t27b_x0;
    }
    var t27b_y: f32 = t27b_x + 8388608.0 - 8388608.0 - t27b_x;
    if (t27b_y > 0.5) {
        t27b_y = t27b_y + t27b_x - 1.0;
    } else if (t27b_y <= -0.5) {
        t27b_y = t27b_y + t27b_x + 1.0;
    } else {
        t27b_y = t27b_y + t27b_x;
    }
    if ((t27b_u >> 31) != 0) {
        return -t27b_y;
    }
    return t27b_y;
}

// compiler_rt `truncf`.
fn t27b_libm_truncf(t27b_x: f32) -> f32 {
    if (t27b_x != t27b_x) {
        return t27b_x + t27b_x;
    }
    const t27b_u: u32 = @bitCast(t27b_x);
    const t27b_be: i32 = @intCast((t27b_u >> 23) & 0xFF);
    var t27b_e: i32 = t27b_be - 127 + 9;
    if (t27b_e >= 32) {
        return t27b_x;
    }
    if (t27b_e < 9) {
        t27b_e = 1;
    }
    const t27b_m: u32 = t27b_libm_ones32 >> t27b_e;
    if ((t27b_u & t27b_m) == 0) {
        return t27b_x;
    }
    return @bitCast(t27b_u & (t27b_libm_ones32 ^ t27b_m));
}

// compiler_rt `fmodf` (`generic_fmod(f32, x, y)`): the remainder of x / y truncated toward zero, exact, with the sign
// of x. compiler_rt's `i = ux -% uy; if (i >> 31 == 0)` is `ux >= uy` here: both are below 2^25 at that point.
fn t27b_libm_fmodf(t27b_x: f32, t27b_y: f32) -> f32 {
    var t27b_ux: u32 = @bitCast(t27b_x);
    var t27b_uy: u32 = @bitCast(t27b_y);
    var t27b_ex: i32 = @intCast((t27b_ux >> 23) & 0xFF);
    var t27b_ey: i32 = @intCast((t27b_uy >> 23) & 0xFF);
    const t27b_sx: u32 = t27b_ux & 0x80000000;
    if ((t27b_uy & 0x7FFFFFFF) == 0 or t27b_y != t27b_y or t27b_ex == 255) {
        return (t27b_x * t27b_y) / (t27b_x * t27b_y);
    }
    if ((t27b_ux & 0x7FFFFFFF) <= (t27b_uy & 0x7FFFFFFF)) {
        if ((t27b_ux & 0x7FFFFFFF) == (t27b_uy & 0x7FFFFFFF)) {
            return 0.0 * t27b_x;
        }
        return t27b_x;
    }
    if (t27b_ex == 0) {
        var t27b_i: u32 = (t27b_ux & t27b_libm_frac32) << 9;
        while ((t27b_i >> 31) == 0) {
            t27b_ex = t27b_ex - 1;
            t27b_i = t27b_i << 1;
        }
        t27b_ux = (t27b_ux & t27b_libm_frac32) << (1 - t27b_ex);
    } else {
        t27b_ux = (t27b_ux & t27b_libm_frac32) | 0x00800000;
    }
    if (t27b_ey == 0) {
        var t27b_j: u32 = (t27b_uy & t27b_libm_frac32) << 9;
        while ((t27b_j >> 31) == 0) {
            t27b_ey = t27b_ey - 1;
            t27b_j = t27b_j << 1;
        }
        t27b_uy = (t27b_uy & t27b_libm_frac32) << (1 - t27b_ey);
    } else {
        t27b_uy = (t27b_uy & t27b_libm_frac32) | 0x00800000;
    }
    while (t27b_ex > t27b_ey) {
        if (t27b_ux >= t27b_uy) {
            if (t27b_ux == t27b_uy) {
                return 0.0 * t27b_x;
            }
            t27b_ux = t27b_ux - t27b_uy;
        }
        t27b_ux = t27b_ux << 1;
        t27b_ex = t27b_ex - 1;
    }
    if (t27b_ux >= t27b_uy) {
        if (t27b_ux == t27b_uy) {
            return 0.0 * t27b_x;
        }
        t27b_ux = t27b_ux - t27b_uy;
    }
    while ((t27b_ux >> 23) == 0) {
        t27b_ux = t27b_ux << 1;
        t27b_ex = t27b_ex - 1;
    }
    if (t27b_ex > 0) {
        const t27b_eu: u32 = @intCast(t27b_ex);
        t27b_ux = (t27b_ux - 0x00800000) | (t27b_eu << 23);
    } else {
        t27b_ux = t27b_ux >> (1 - t27b_ex);
    }
    return @bitCast(t27b_ux | t27b_sx);
}

// std.math.inf(f64) and std.math.inf(f32) (std/math/float.zig): every exponent bit set, a zero fraction.
fn t27b_libm_inf() -> f64 {
    return @bitCast(t27b_libm_inf64);
}

fn t27b_libm_inff() -> f32 {
    return @bitCast(t27b_libm_inf32);
}

// compiler_rt `round` (f64): half away from zero. `f64_toint` is 1 / floatEps(f64) = 2^52.
fn t27b_libm_round(t27b_x0: f64) -> f64 {
    var t27b_x: f64 = t27b_x0;
    const t27b_u: u64 = @bitCast(t27b_x0);
    const t27b_e: u64 = (t27b_u >> 52) & 0x7FF;
    if (t27b_e >= 1075) {
        return t27b_x;
    }
    if ((t27b_u >> 63) != 0) {
        t27b_x = -t27b_x;
    }
    if (t27b_e < 1022) {
        return 0.0 * t27b_x0;
    }
    var t27b_y: f64 = t27b_x + 4503599627370496.0 - 4503599627370496.0 - t27b_x;
    if (t27b_y > 0.5) {
        t27b_y = t27b_y + t27b_x - 1.0;
    } else if (t27b_y <= -0.5) {
        t27b_y = t27b_y + t27b_x + 1.0;
    } else {
        t27b_y = t27b_y + t27b_x;
    }
    if ((t27b_u >> 63) != 0) {
        return -t27b_y;
    }
    return t27b_y;
}

// std.math.log1p (f64): Zig's std/math/log1p.zig `log1p_64` (musl's log1p.c), step for step.
fn t27b_libm_log1p(t27b_x: f64) -> f64 {
    const t27b_ix: u64 = @bitCast(t27b_x);
    const t27b_hx: u32 = @intCast(t27b_ix >> 32);
    var t27b_k: i32 = 1;
    var t27b_c: f64 = 0.0;
    var t27b_f: f64 = 0.0;
    if (t27b_hx < 0x3FDA827A or (t27b_hx >> 31) != 0) {
        if (t27b_hx >= 0xBFF00000) {
            if (t27b_x == -1.0) {
                const t27b_inf: f64 = @bitCast(t27b_libm_inf64);
                return -t27b_inf;
            }
            const t27b_nan: f64 = @bitCast(t27b_libm_qnan64);
            return t27b_nan;
        }
        if ((t27b_hx << 1) < 0x79400000) {
            return t27b_x;
        }
        if (t27b_hx <= 0xBFD2BEC4) {
            t27b_k = 0;
            t27b_c = 0.0;
            t27b_f = t27b_x;
        }
    } else if (t27b_hx >= 0x7FF00000) {
        return t27b_x;
    }
    if (t27b_k != 0) {
        const t27b_uf: f64 = 1.0 + t27b_x;
        const t27b_hu: u64 = @bitCast(t27b_uf);
        var t27b_iu: u32 = @intCast(t27b_hu >> 32);
        t27b_iu = t27b_iu + 0x95F62;
        const t27b_e: i32 = @intCast(t27b_iu >> 20);
        t27b_k = t27b_e - 0x3FF;
        if (t27b_k < 54) {
            if (t27b_k >= 2) {
                t27b_c = 1.0 - (t27b_uf - t27b_x);
            } else {
                t27b_c = t27b_x - (t27b_uf - 1.0);
            }
            t27b_c = t27b_c / t27b_uf;
        } else {
            t27b_c = 0.0;
        }
        t27b_iu = (t27b_iu & 0x000FFFFF) + 0x3FE6A09E;
        const t27b_iq: u64 = (@as(u64, t27b_iu) << 32) | (t27b_hu & 0xFFFFFFFF);
        const t27b_fq: f64 = @bitCast(t27b_iq);
        t27b_f = t27b_fq - 1.0;
    }
    const t27b_hfsq: f64 = 0.5 * t27b_f * t27b_f;
    const t27b_s: f64 = t27b_f / (2.0 + t27b_f);
    const t27b_z: f64 = t27b_s * t27b_s;
    const t27b_w: f64 = t27b_z * t27b_z;
    const t27b_t1: f64 = t27b_w * (0.3999999999940942 + t27b_w * (0.22222198432149784 + t27b_w * 0.15313837699209373));
    const t27b_t2: f64 = t27b_z * (0.6666666666666735 + t27b_w * (0.2857142874366239 + t27b_w * (0.1818357216161805 + t27b_w * 0.14798198605116586)));
    const t27b_r: f64 = t27b_t2 + t27b_t1;
    const t27b_dk: f64 = @floatFromInt(t27b_k);
    return t27b_s * (t27b_hfsq + t27b_r) + (t27b_dk * 1.9082149292705877e-10 + t27b_c) - t27b_hfsq + t27b_f + t27b_dk * 0.6931471803691238;
}

// compiler_rt `logf`, `log2f` and `log10f` (log.zig, log2.zig, log10.zig; musl's logf.c, log2f.c, log10f.c, the
// fdlibm ones, not the table-driven f64 `log` above), for `@log`, `@log2` and `@log10` of an f32 (#7822). Step for
// step on the bits: x = (1 + f) * 2^k with 1 + f in [sqrt(2)/2, sqrt(2)), s = f / (2 + f), and a polynomial in s^2.
// The constants are their f32 values written as exact decimals (Lg1 = 0xaaaaaa.0p-24 and so on), so Zig and t27b
// read the same bits. compiler_rt's `want_float_exceptions` is true on x86_64 and aarch64: a zero gives
// `-1 / (x * x)`, a negative `(x - x) / 0.0`, and +inf or a NaN comes back as it is. `ix << 1 == 0` is read through
// a mask here.
fn t27b_libm_logf(t27b_x0: f32) -> f32 {
    var t27b_x: f32 = t27b_x0;
    var t27b_ix: u32 = @bitCast(t27b_x0);
    var t27b_k: i32 = 0;
    if (t27b_ix < 0x00800000 or (t27b_ix >> 31) != 0) {
        if ((t27b_ix & 0x7FFFFFFF) == 0) {
            return -1.0 / (t27b_x * t27b_x);
        }
        if ((t27b_ix >> 31) != 0) {
            return (t27b_x - t27b_x) / 0.0;
        }
        t27b_k = t27b_k - 25;
        t27b_x = t27b_x * 33554432.0;
        t27b_ix = @bitCast(t27b_x);
    } else if (t27b_ix >= 0x7F800000) {
        return t27b_x;
    } else if (t27b_ix == 0x3F800000) {
        return 0.0;
    }
    t27b_ix = t27b_ix + (0x3F800000 - 0x3F3504F3);
    const t27b_kx: i32 = @intCast(t27b_ix >> 23);
    t27b_k = t27b_k + t27b_kx - 127;
    t27b_ix = (t27b_ix & 0x007FFFFF) + 0x3F3504F3;
    t27b_x = @bitCast(t27b_ix);
    const t27b_f: f32 = t27b_x - 1.0;
    const t27b_s: f32 = t27b_f / (2.0 + t27b_f);
    const t27b_z: f32 = t27b_s * t27b_s;
    const t27b_w: f32 = t27b_z * t27b_z;
    const t27b_t1: f32 = t27b_w * (0.4000097215175628662109375 + t27b_w * 0.2427907884120941162109375);
    const t27b_t2: f32 = t27b_z * (0.66666662693023681640625 + t27b_w * 0.284987866878509521484375);
    const t27b_r: f32 = t27b_t2 + t27b_t1;
    const t27b_hfsq: f32 = 0.5 * t27b_f * t27b_f;
    const t27b_dk: f32 = @floatFromInt(t27b_k);
    return t27b_s * (t27b_hfsq + t27b_r) + t27b_dk * 0.0000090580006144591607153415679931640625 - t27b_hfsq + t27b_f + t27b_dk * 0.69313812255859375;
}

// compiler_rt `log2f`: hi is f - hfsq with its low 12 bits cleared, lo the rest, each times 1/ln2 split in two.
fn t27b_libm_log2f(t27b_x0: f32) -> f32 {
    var t27b_x: f32 = t27b_x0;
    var t27b_ix: u32 = @bitCast(t27b_x0);
    var t27b_k: i32 = 0;
    if (t27b_ix < 0x00800000 or (t27b_ix >> 31) != 0) {
        if ((t27b_ix & 0x7FFFFFFF) == 0) {
            return -1.0 / (t27b_x * t27b_x);
        }
        if ((t27b_ix >> 31) != 0) {
            return (t27b_x - t27b_x) / 0.0;
        }
        t27b_k = t27b_k - 25;
        t27b_x = t27b_x * 33554432.0;
        t27b_ix = @bitCast(t27b_x);
    } else if (t27b_ix >= 0x7F800000) {
        return t27b_x;
    } else if (t27b_ix == 0x3F800000) {
        return 0.0;
    }
    t27b_ix = t27b_ix + (0x3F800000 - 0x3F3504F3);
    const t27b_kx: i32 = @intCast(t27b_ix >> 23);
    t27b_k = t27b_k + t27b_kx - 127;
    t27b_ix = (t27b_ix & 0x007FFFFF) + 0x3F3504F3;
    t27b_x = @bitCast(t27b_ix);
    const t27b_f: f32 = t27b_x - 1.0;
    const t27b_s: f32 = t27b_f / (2.0 + t27b_f);
    const t27b_z: f32 = t27b_s * t27b_s;
    const t27b_w: f32 = t27b_z * t27b_z;
    const t27b_t1: f32 = t27b_w * (0.4000097215175628662109375 + t27b_w * 0.2427907884120941162109375);
    const t27b_t2: f32 = t27b_z * (0.66666662693023681640625 + t27b_w * 0.284987866878509521484375);
    const t27b_r: f32 = t27b_t2 + t27b_t1;
    const t27b_hfsq: f32 = 0.5 * t27b_f * t27b_f;
    const t27b_hu: u32 = @bitCast(t27b_f - t27b_hfsq);
    const t27b_hi: f32 = @bitCast(t27b_hu & 0xFFFFF000);
    const t27b_lo: f32 = t27b_f - t27b_hi - t27b_hfsq + t27b_s * (t27b_hfsq + t27b_r);
    const t27b_dk: f32 = @floatFromInt(t27b_k);
    return (t27b_lo + t27b_hi) * -0.0001760528539307415485382080078125 + t27b_lo * 1.44287109375 + t27b_hi * 1.44287109375 + t27b_dk;
}

// compiler_rt `log10f`: the same hi and lo, times 1/ln10 split in two, plus k * log10(2) split in two.
fn t27b_libm_log10f(t27b_x0: f32) -> f32 {
    var t27b_x: f32 = t27b_x0;
    var t27b_ix: u32 = @bitCast(t27b_x0);
    var t27b_k: i32 = 0;
    if (t27b_ix < 0x00800000 or (t27b_ix >> 31) != 0) {
        if ((t27b_ix & 0x7FFFFFFF) == 0) {
            return -1.0 / (t27b_x * t27b_x);
        }
        if ((t27b_ix >> 31) != 0) {
            return (t27b_x - t27b_x) / 0.0;
        }
        t27b_k = t27b_k - 25;
        t27b_x = t27b_x * 33554432.0;
        t27b_ix = @bitCast(t27b_x);
    } else if (t27b_ix >= 0x7F800000) {
        return t27b_x;
    } else if (t27b_ix == 0x3F800000) {
        return 0.0;
    }
    t27b_ix = t27b_ix + (0x3F800000 - 0x3F3504F3);
    const t27b_kx: i32 = @intCast(t27b_ix >> 23);
    t27b_k = t27b_k + t27b_kx - 127;
    t27b_ix = (t27b_ix & 0x007FFFFF) + 0x3F3504F3;
    t27b_x = @bitCast(t27b_ix);
    const t27b_f: f32 = t27b_x - 1.0;
    const t27b_s: f32 = t27b_f / (2.0 + t27b_f);
    const t27b_z: f32 = t27b_s * t27b_s;
    const t27b_w: f32 = t27b_z * t27b_z;
    const t27b_t1: f32 = t27b_w * (0.4000097215175628662109375 + t27b_w * 0.2427907884120941162109375);
    const t27b_t2: f32 = t27b_z * (0.66666662693023681640625 + t27b_w * 0.284987866878509521484375);
    const t27b_r: f32 = t27b_t2 + t27b_t1;
    const t27b_hfsq: f32 = 0.5 * t27b_f * t27b_f;
    const t27b_hu: u32 = @bitCast(t27b_f - t27b_hfsq);
    const t27b_hi: f32 = @bitCast(t27b_hu & 0xFFFFF000);
    const t27b_lo: f32 = t27b_f - t27b_hi - t27b_hfsq + t27b_s * (t27b_hfsq + t27b_r);
    const t27b_dk: f32 = @floatFromInt(t27b_k);
    return t27b_dk * 0.00000079034151667656260542571544647216796875 + (t27b_lo + t27b_hi) * -0.00003168997136526741087436676025390625 + t27b_lo * 0.434326171875 + t27b_hi * 0.434326171875 + t27b_dk * 0.301029205322265625;
}

// `std.math.pow(f32, x, y)` (#7823, for specs/numeric/gf16.t27) is not compiler_rt: it is Zig 0.16's std/math/pow.zig,
// a port of Go's math.Pow, with what it calls. Ported here step for step: `math.frexp` and `math.ldexp` (`scalbn`) of
// an f32 on the bits, `isOddInteger` of an f64 (its `math.modf` is an f64 `@trunc`, ported below from compiler_rt
// `trunc`), `math.copysign`, and the ports above for `@exp` and `@log` of an f32 (`expf`, `logf`), `@trunc` of an f32
// (`truncf`) and `math.nan`. `@sqrt` stays the IEEE square root t27b already has. Zig's `@clz` and `@ctz` are read
// here through a loop and a mask; `frexp` returns a struct, here two fns of one decomposition.
const t27b_libm_ones64: u64 = 0xFFFFFFFFFFFFFFFF;

// compiler_rt `trunc` (f64), as `truncf` above: `@trunc` of an f64 is `roundsd` on the t27c lab, so a NaN is quieted.
fn t27b_libm_trunc(t27b_x: f64) -> f64 {
    if (t27b_x != t27b_x) {
        return t27b_x + t27b_x;
    }
    const t27b_u: u64 = @bitCast(t27b_x);
    const t27b_be: i32 = @intCast((t27b_u >> 52) & 0x7FF);
    var t27b_e: i32 = t27b_be - 1023 + 12;
    if (t27b_e >= 64) {
        return t27b_x;
    }
    if (t27b_e < 12) {
        t27b_e = 1;
    }
    const t27b_m: u64 = t27b_libm_ones64 >> t27b_e;
    if ((t27b_u & t27b_m) == 0) {
        return t27b_x;
    }
    return @bitCast(t27b_u & (t27b_libm_ones64 ^ t27b_m));
}

// compiler_rt `floor` and `ceil` (f64) for specs/t27f/token_floor.t27 (#10405), as `floorf` and `ceilf` above, on
// 64 bits: `@floor` and `@ceil` of an f64 are `roundsd` on the t27c lab, so a NaN is quieted, as frintm and frintp
// quiet it. conformance/libm_rounding.t27 holds them to Zig's builtins on every exponent.
const t27b_libm_frac64: u64 = 0x000FFFFFFFFFFFFF;
const t27b_libm_negzero64: u64 = 0x8000000000000000;

fn t27b_libm_floor(t27b_x: f64) -> f64 {
    if (t27b_x != t27b_x) {
        return t27b_x + t27b_x;
    }
    var t27b_u: u64 = @bitCast(t27b_x);
    const t27b_be: i32 = @intCast((t27b_u >> 52) & 0x7FF);
    const t27b_e: i32 = t27b_be - 1023;
    if (t27b_e >= 52) {
        return t27b_x;
    }
    if (t27b_e >= 0) {
        const t27b_m: u64 = t27b_libm_frac64 >> t27b_e;
        if ((t27b_u & t27b_m) == 0) {
            return t27b_x;
        }
        if ((t27b_u >> 63) == 1) {
            t27b_u = t27b_u + t27b_m;
        }
        return @bitCast(t27b_u & (t27b_libm_ones64 ^ t27b_m));
    }
    if ((t27b_u >> 63) == 0) {
        return 0.0;
    }
    if ((t27b_u & 0x7FFFFFFFFFFFFFFF) != 0) {
        return -1.0;
    }
    return t27b_x;
}

fn t27b_libm_ceil(t27b_x: f64) -> f64 {
    if (t27b_x != t27b_x) {
        return t27b_x + t27b_x;
    }
    var t27b_u: u64 = @bitCast(t27b_x);
    const t27b_be: i32 = @intCast((t27b_u >> 52) & 0x7FF);
    const t27b_e: i32 = t27b_be - 1023;
    if (t27b_e >= 52) {
        return t27b_x;
    }
    if (t27b_e >= 0) {
        const t27b_m: u64 = t27b_libm_frac64 >> t27b_e;
        if ((t27b_u & t27b_m) == 0) {
            return t27b_x;
        }
        if ((t27b_u >> 63) == 0) {
            t27b_u = t27b_u + t27b_m;
        }
        return @bitCast(t27b_u & (t27b_libm_ones64 ^ t27b_m));
    }
    if ((t27b_u >> 63) != 0) {
        return @bitCast(t27b_libm_negzero64);
    }
    if ((t27b_u & 0x7FFFFFFFFFFFFFFF) != 0) {
        return 1.0;
    }
    return t27b_x;
}

// `@mod` of two i64 (#10405, specs/t27f/reel_particles.t27's `lcg`): Zig's floored remainder, the sign of the
// divisor. Zig 0.16 Debug panics unless the divisor is positive; a zero divisor traps in `@rem` already. The
// truncated remainder is moved up by the divisor when it is negative, which cannot overflow: -b < r < 0.
fn t27b_libm_mod(t27b_a: i64, t27b_b: i64) -> i64 {
    if (t27b_b < 0) {
        @panic("remainder division by zero or negative value");
    }
    const t27b_r: i64 = @rem(t27b_a, t27b_b);
    if (t27b_r < 0) {
        return t27b_r + t27b_b;
    }
    return t27b_r;
}

// pow.zig `isOddInteger`: |x| >= 2^53 is even; else `math.modf(x)` has no fraction and an odd integer part.
fn t27b_libm_is_odd_integer(t27b_x: f64) -> bool {
    if (@abs(t27b_x) >= 9007199254740992.0) {
        return false;
    }
    const t27b_ip: f64 = t27b_libm_trunc(t27b_x);
    const t27b_fp: f64 = t27b_x - t27b_ip;
    const t27b_i: i64 = @intFromFloat(t27b_ip);
    return t27b_fp == 0.0 and (t27b_i & 1) == 1;
}

// `@clz` of a u32, and of a u23 (frexp's subnormal fraction).
fn t27b_libm_clz32(t27b_v: u32) -> u32 {
    var t27b_n: u32 = 0;
    var t27b_b: u32 = 0x80000000;
    while (t27b_b != 0 and (t27b_v & t27b_b) == 0) {
        t27b_n = t27b_n + 1;
        t27b_b = t27b_b >> 1;
    }
    return t27b_n;
}

// `math.frexp` of an f32 (frexp.zig): x = significand * 2^exponent with |significand| in [0.5, 1); +-0 and +-inf
// have exponent 0 and themselves as significand. These two fns are its two fields; pow never asks it of a NaN.
fn t27b_libm_frexpf_exp(t27b_x: f32) -> i32 {
    const t27b_v: u32 = @bitCast(t27b_x);
    const t27b_m: u32 = t27b_v & 0x007FFFFF;
    const t27b_e: i32 = @intCast((t27b_v >> 23) & 0xFF);
    if (t27b_e == 0) {
        if (t27b_m != 0) {
            const t27b_offset: i32 = @intCast(t27b_libm_clz32(t27b_m) - 9);
            return -126 - t27b_offset;
        }
        return 0;
    }
    if (t27b_e == 255) {
        return 0;
    }
    return t27b_e - 126;
}

fn t27b_libm_frexpf_sig(t27b_x: f32) -> f32 {
    const t27b_v: u32 = @bitCast(t27b_x);
    const t27b_m: u32 = t27b_v & 0x007FFFFF;
    const t27b_e: u32 = (t27b_v >> 23) & 0xFF;
    if (t27b_e == 0) {
        if (t27b_m != 0) {
            const t27b_shift: u32 = t27b_libm_clz32(t27b_m) - 8;
            return @bitCast((t27b_v & 0x80000000) | 0x3F000000 | ((t27b_m << t27b_shift) & 0x007FFFFF));
        }
        return t27b_x;
    }
    if (t27b_e == 255) {
        return t27b_x;
    }
    return @bitCast((t27b_v & 0x807FFFFF) | 0x3F000000);
}

// `math.ldexp` of an f32 (ldexp.zig), which `math.scalbn` is: x * 2^n, with a subnormal result rounded to nearest,
// ties to even, on the bits. `repr << 1` and the shifts of a subnormal read the same bits through a mask here.
fn t27b_libm_ldexpf(t27b_x: f32, t27b_n: i32) -> f32 {
    const t27b_repr: u32 = @bitCast(t27b_x);
    const t27b_sign: u32 = t27b_repr & 0x80000000;
    if (t27b_x != t27b_x or (t27b_repr & 0x7F800000) == 0x7F800000) {
        return t27b_x;
    }
    var t27b_exponent: i32 = @intCast((t27b_repr & 0x7FFFFFFF) >> 23);
    if (t27b_exponent == 0) {
        const t27b_lz: i32 = @intCast(t27b_libm_clz32((t27b_repr & 0x7FFFFFFF) << 1));
        t27b_exponent = t27b_exponent + 8 - t27b_lz;
    }
    if (t27b_n >= 0) {
        if (t27b_n > 254 - t27b_exponent) {
            return @bitCast(t27b_libm_inf32 | t27b_sign);
        }
        if (t27b_exponent + t27b_n <= 0) {
            return @bitCast(((t27b_repr & 0x7FFFFFFF) << t27b_n) | t27b_sign);
        }
        if (t27b_exponent <= 0) {
            const t27b_ne: u32 = @intCast(t27b_n + t27b_exponent);
            const t27b_frac: u32 = ((t27b_repr & 0x7FFFFFFF) << (1 - t27b_exponent)) & 0x007FFFFF;
            return @bitCast((t27b_ne << 23) | t27b_frac | t27b_sign);
        }
        const t27b_nu: u32 = @intCast(t27b_n);
        return @bitCast(t27b_repr + (t27b_nu << 23));
    }
    if (t27b_n <= 0 - t27b_exponent) {
        if (t27b_n < 0 - (23 + t27b_exponent)) {
            return @bitCast(t27b_sign);
        }
        var t27b_s: i32 = 0 - t27b_n;
        if (1 - (t27b_exponent + t27b_n) < t27b_s) {
            t27b_s = 1 - (t27b_exponent + t27b_n);
        }
        const t27b_shift: u32 = @intCast(t27b_s);
        const t27b_low: u32 = t27b_libm_ones32 >> (32 - t27b_shift);
        const t27b_half: u32 = t27b_low ^ (t27b_low >> 1);
        var t27b_result: u32 = t27b_repr & 0x007FFFFF;
        if (t27b_exponent > 0) {
            t27b_result = t27b_result | 0x00800000;
        }
        t27b_result = t27b_result >> (t27b_shift - 1);
        t27b_result = (t27b_result + 1) >> 1;
        if ((t27b_repr & t27b_low) == t27b_half) {
            t27b_result = t27b_result & 0xFFFFFFFE;
        }
        return @bitCast(t27b_result | t27b_sign);
    }
    const t27b_nn: u32 = @intCast(0 - t27b_n);
    return @bitCast(t27b_repr - (t27b_nn << 23));
}

// `std.math.pow(f32, x, y)` (pow.zig).
fn t27b_libm_powf(t27b_x: f32, t27b_y: f32) -> f32 {
    if (t27b_y == 0.0 or t27b_x == 1.0) {
        return 1.0;
    }
    if (t27b_x != t27b_x or t27b_y != t27b_y) {
        return t27b_libm_nanf();
    }
    if (t27b_y == 1.0) {
        return t27b_x;
    }
    const t27b_inf: f32 = @bitCast(t27b_libm_inf32);
    const t27b_yd: f64 = t27b_y;
    if (t27b_x == 0.0) {
        if (t27b_y < 0.0) {
            if (t27b_libm_is_odd_integer(t27b_yd)) {
                const t27b_xb: u32 = @bitCast(t27b_x);
                return @bitCast(t27b_libm_inf32 | (t27b_xb & 0x80000000));
            }
            return t27b_inf;
        }
        if (t27b_libm_is_odd_integer(t27b_yd)) {
            return t27b_x;
        }
        return 0.0;
    }
    const t27b_yb: u32 = @bitCast(t27b_y);
    if ((t27b_yb & 0x7FFFFFFF) == t27b_libm_inf32) {
        if (t27b_x == -1.0) {
            return 1.0;
        }
        if ((@abs(t27b_x) < 1.0) == t27b_libm_isposinff(t27b_y)) {
            return 0.0;
        }
        return t27b_inf;
    }
    const t27b_xb2: u32 = @bitCast(t27b_x);
    if ((t27b_xb2 & 0x7FFFFFFF) == t27b_libm_inf32) {
        if (t27b_libm_isneginff(t27b_x)) {
            return t27b_libm_powf(1.0 / t27b_x, -t27b_y);
        }
        if (t27b_y < 0.0) {
            return 0.0;
        }
        if (t27b_y > 0.0) {
            return t27b_inf;
        }
    }
    if (t27b_y == 0.5) {
        return @sqrt(t27b_x);
    }
    if (t27b_y == -0.5) {
        return 1.0 / @sqrt(t27b_x);
    }
    const t27b_ay: f32 = @abs(t27b_y);
    var t27b_yi: f32 = t27b_libm_truncf(t27b_ay);
    var t27b_yf: f32 = t27b_ay - t27b_yi;
    if (t27b_yf != 0.0 and t27b_x < 0.0) {
        return t27b_libm_nanf();
    }
    if (t27b_yi >= 2147483648.0) {
        return t27b_libm_expf(t27b_y * t27b_libm_logf(@abs(t27b_x)));
    }
    var t27b_a1: f32 = 1.0;
    var t27b_ae: i32 = 0;
    if (t27b_yf != 0.0) {
        if (t27b_yf > 0.5) {
            t27b_yf = t27b_yf - 1.0;
            t27b_yi = t27b_yi + 1.0;
        }
        t27b_a1 = t27b_libm_expf(t27b_yf * t27b_libm_logf(t27b_x));
    }
    var t27b_xe: i32 = t27b_libm_frexpf_exp(t27b_x);
    var t27b_x1: f32 = t27b_libm_frexpf_sig(t27b_x);
    var t27b_i: i32 = @intFromFloat(t27b_yi);
    while (t27b_i != 0) {
        if (t27b_xe < -512 or 512 < t27b_xe) {
            t27b_ae = t27b_ae + t27b_xe;
            break;
        }
        if ((t27b_i & 1) == 1) {
            t27b_a1 = t27b_a1 * t27b_x1;
            t27b_ae = t27b_ae + t27b_xe;
        }
        t27b_x1 = t27b_x1 * t27b_x1;
        t27b_xe = t27b_xe * 2;
        if (t27b_x1 < 0.5) {
            t27b_x1 = t27b_x1 + t27b_x1;
            t27b_xe = t27b_xe - 1;
        }
        t27b_i = t27b_i >> 1;
    }
    if (t27b_y < 0.0) {
        t27b_a1 = 1.0 / t27b_a1;
        t27b_ae = 0 - t27b_ae;
    }
    return t27b_libm_ldexpf(t27b_a1, t27b_ae);
}

// compiler_rt `cos` (f64), for `@cos` of an f64 (#8677, specs/math/constants.t27): Zig 0.16's lib/compiler_rt/cos.zig,
// trig.zig (`cos`, `sin`), rem_pio2.zig and rem_pio2_large.zig, which are musl's cos.c, __cos.c, __sin.c, __rem_pio2.c
// and __rem_pio2_large.c. Step for step on the bits, with the same constants, the same operation order and the
// same branches. x = n * pi/2 + (y0 + y1) with |y0 + y1| <= pi/4, then a degree-14 cos or a degree-13 sin kernel by
// n mod 4. `rem_pio2` reduces |x| <= 9pi/4 with one multiple of pi/2, |x| < 2^20 * pi/2 by Cody-Waite (`medium`,
// one to three rounds), and anything larger by Payne-Hanek (`rem_pio2_large`, the f64 path, prec 1: the first 66
// entries of 2/pi in 24-bit chunks, which is all a double needs). Departures in form, none in value:
// - Zig writes `2 * pio2_1t` with comptime_float operands, folded at 128-bit precision; each such product is
//   written here as the f64 Zig rounds it to (measured on the t27c lab: it is also the double product C gives).
// - `rem_pio2` and `rem_pio2_large` return n and y[0], y[1] as a tuple instead of through a pointer, and
//   `rem_pio2_large` takes x[0..nx) as three values.
// - `math.scalbn(z, q0)` is a product with t27b_libm_pow2(q0): every scale here is a power of two between 2^-507
//   and 2^507 and every result a normal double, so it is exact, as ldexp is. `@floor(z * 0.125)` with
//   0 <= z < 2^52 is a truncation through an i64. `@divFloor(e0 - 3, 24)` is taken only when e0 >= 3, where it is
//   a plain quotient (below, jv is clamped to 0 either way).
// - The C `goto recompute` loop is a `while` on a flag; the index loops run on usize, a downward one over
//   i = jz - d with d counting up, over the same indices in the same order.
// - `medium` names the values of its later rounds once each (see there).
// The kernels. trig.zig `cos(x, y)`: cos(x + y) for |x| <= pi/4, y the tail of x.
fn t27b_libm_kcos(t27b_x: f64, t27b_y: f64) -> f64 {
    const t27b_z: f64 = t27b_x * t27b_x;
    const t27b_zs: f64 = t27b_z * t27b_z;
    const t27b_r: f64 = t27b_z * (0.0416666666666666 + t27b_z * (-0.001388888888887411 + t27b_z * 0.00002480158728947673)) + t27b_zs * t27b_zs * (-2.7557314351390663e-07 + t27b_z * (2.087572321298175e-09 + t27b_z * -1.1359647557788195e-11));
    const t27b_hz: f64 = 0.5 * t27b_z;
    const t27b_w: f64 = 1.0 - t27b_hz;
    return t27b_w + (((1.0 - t27b_w) - t27b_hz) + (t27b_z * t27b_r - t27b_x * t27b_y));
}

// trig.zig `sin(x, y, iy)`: sin(x + y) for |x| <= pi/4; iy == 0 when y is 0.
fn t27b_libm_ksin(t27b_x: f64, t27b_y: f64, t27b_iy: i32) -> f64 {
    const t27b_z: f64 = t27b_x * t27b_x;
    const t27b_w: f64 = t27b_z * t27b_z;
    const t27b_r: f64 = 0.00833333333332249 + t27b_z * (-0.0001984126982985795 + t27b_z * 2.7557313707070068e-06) + t27b_z * t27b_w * (-2.5050760253406863e-08 + t27b_z * 1.58969099521155e-10);
    const t27b_v: f64 = t27b_z * t27b_x;
    if (t27b_iy == 0) {
        return t27b_x + t27b_v * (-0.16666666666666632 + t27b_z * t27b_r);
    }
    return t27b_x - ((t27b_z * (0.5 * t27b_y - t27b_v * t27b_r) - t27b_y) - t27b_v * -0.16666666666666632);
}

// rem_pio2.zig `medium`: Cody-Waite with pi/2 in three 33-bit parts (pio2_1 = 1.5707963267341256, pio2_1t,
// pio2_2, pio2_2t, pio2_3, pio2_3t), for |x| < 2^20 * pi/2. ix is the high word of |x|. `x * invpio2 + toint - toint`
// is rint(x * 2/pi), toint = 1.5 * 2^52.
// The rounds after the first name each new value once (t2, r2, ...) where Zig reassigns t, r and w: t27c's Zig
// backend hoists an expression a later statement repeats to the top of the fn (its CSE pass), so no statement
// here repeats an earlier one's right-hand side.
fn t27b_libm_rem_pio2_medium(t27b_ix: u32, t27b_x: f64) -> (i32, f64, f64) {
    var t27b_nf: f64 = t27b_x * 0.6366197723675814 + 6755399441055744.0 - 6755399441055744.0;
    var t27b_n: i32 = @intFromFloat(t27b_nf);
    var t27b_r: f64 = t27b_x - t27b_nf * 1.5707963267341256;
    var t27b_w: f64 = t27b_nf * 6.077100506506192e-11;
    // Matters with directed rounding.
    if (t27b_r - t27b_w < -0.7853981633974483) {
        const t27b_dn: f64 = t27b_nf - 1.0;
        t27b_n = t27b_n - 1;
        t27b_nf = t27b_dn;
        t27b_r = t27b_x - t27b_dn * 1.5707963267341256;
        t27b_w = t27b_dn * 6.077100506506192e-11;
    } else if (t27b_r - t27b_w > 0.7853981633974483) {
        const t27b_up: f64 = t27b_nf + 1.0;
        t27b_n = t27b_n + 1;
        t27b_nf = t27b_up;
        t27b_r = t27b_x - t27b_up * 1.5707963267341256;
        t27b_w = t27b_up * 6.077100506506192e-11;
    }
    var t27b_y0: f64 = t27b_r - t27b_w;
    const t27b_u0: u64 = @bitCast(t27b_y0);
    const t27b_ey0: i32 = @intCast((t27b_u0 >> 52) & 0x7FF);
    const t27b_ex: i32 = @intCast(t27b_ix >> 20);
    if (t27b_ex - t27b_ey0 > 16) {
        // 2nd round, good to 118 bits
        const t27b_t2: f64 = t27b_r;
        const t27b_v2: f64 = t27b_nf * 6.077100506303966e-11;
        const t27b_r2: f64 = t27b_t2 - t27b_v2;
        const t27b_w2: f64 = t27b_nf * 2.0222662487959506e-21 - ((t27b_t2 - t27b_r2) - t27b_v2);
        t27b_r = t27b_r2;
        t27b_w = t27b_w2;
        t27b_y0 = t27b_r2 - t27b_w2;
        const t27b_u2: u64 = @bitCast(t27b_y0);
        const t27b_ey2: i32 = @intCast((t27b_u2 >> 52) & 0x7FF);
        if (t27b_ex - t27b_ey2 > 49) {
            // 3rd round, good to 151 bits, covers all cases
            const t27b_t3: f64 = t27b_r2;
            const t27b_v3: f64 = t27b_nf * 2.0222662487111665e-21;
            const t27b_r3: f64 = t27b_t3 - t27b_v3;
            const t27b_w3: f64 = t27b_nf * 8.4784276603689e-32 - ((t27b_t3 - t27b_r3) - t27b_v3);
            t27b_r = t27b_r3;
            t27b_w = t27b_w3;
            t27b_y0 = t27b_r3 - t27b_w3;
        }
    }
    const t27b_y1: f64 = (t27b_r - t27b_y0) - t27b_w;
    return (t27b_n, t27b_y0, t27b_y1);
}

// rem_pio2_large.zig `ipio2`: 2/pi in 24-bit chunks, ipio2[i] * 2^(-24 * (i + 1)). musl keeps the first 66 for a
// double (e0 <= 1000, jk = 4); the rest of Zig's 690 serve f80 and f128.
const t27b_libm_ipio2: [66]i32 = [
    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62,
    0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A,
    0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41,
    0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
    0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5,
    0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08,
    0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880,
    0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B,
];

// rem_pio2_large.zig `PIo2`: pi/2 cut into 24-bit chunks (0x3FF921FB40000000, 0x3E74442D00000000, ...).
const t27b_libm_pio2_parts: [8]f64 = [
    1.570796251296997, 7.549789415861596e-08, 5.390302529957765e-15, 3.282003415807913e-22,
    1.270655753080676e-29, 1.2293330898111133e-36, 2.7337005381646456e-44, 2.1674168387780482e-51,
];

// rem_pio2_large.zig `rem_pio2_large(x, y, e0, nx, 1)`: x[0..nx) are the 24-bit pieces of |x| (x[0] * 2^e0 matches
// |x| to 24 bits); returns n mod 8 and y[0], y[1] with |x| = n * pi/2 + y[0] + y[1]. jk = init_jk[1] = 4, jp = jk.
fn t27b_libm_rem_pio2_large(t27b_x0: f64, t27b_x1: f64, t27b_x2: f64, t27b_e0: i32, t27b_nx: i32) -> (i32, f64, f64) {
    var t27b_x: [3]f64 = undefined;
    t27b_x[0] = t27b_x0;
    t27b_x[1] = t27b_x1;
    t27b_x[2] = t27b_x2;
    var t27b_iq: [20]i32 = undefined;
    var t27b_f: [20]f64 = undefined;
    var t27b_fq: [20]f64 = undefined;
    var t27b_q: [20]f64 = undefined;
    const t27b_jk: usize = 4;
    const t27b_jp: usize = 4;
    // jx, jv and q0; note that 3 > q0.
    const t27b_jx: usize = @intCast(t27b_nx - 1);
    var t27b_jv: usize = 0;
    if (t27b_e0 >= 3) {
        const t27b_e3: usize = @intCast(t27b_e0 - 3);
        t27b_jv = t27b_e3 / 24;
    }
    const t27b_jvi: i32 = @intCast(t27b_jv);
    var t27b_q0: i32 = t27b_e0 - 24 * (t27b_jvi + 1);
    // f[0..jx+jk], f[i] = ipio2[jv - jx + i], 0 below the table.
    var t27b_i: usize = 0;
    var t27b_j: usize = 0;
    while (t27b_i <= t27b_jx + t27b_jk) {
        if (t27b_jv + t27b_i < t27b_jx) {
            t27b_f[t27b_i] = 0.0;
        } else {
            const t27b_c: f64 = @floatFromInt(t27b_libm_ipio2[t27b_jv + t27b_i - t27b_jx]);
            t27b_f[t27b_i] = t27b_c;
        }
        t27b_i = t27b_i + 1;
    }
    // q[0..jk].
    var t27b_fw: f64 = 0.0;
    t27b_i = 0;
    while (t27b_i <= t27b_jk) {
        t27b_fw = 0.0;
        t27b_j = 0;
        while (t27b_j <= t27b_jx) {
            t27b_fw = t27b_fw + t27b_x[t27b_j] * t27b_f[t27b_jx + t27b_i - t27b_j];
            t27b_j = t27b_j + 1;
        }
        t27b_q[t27b_i] = t27b_fw;
        t27b_i = t27b_i + 1;
    }
    var t27b_jz: usize = t27b_jk;
    var t27b_z: f64 = 0.0;
    var t27b_n: i32 = 0;
    var t27b_ih: i32 = 0;
    var t27b_again: bool = true;
    while (t27b_again) {
        // Distill q[] into iq[] reversingly.
        t27b_i = 0;
        t27b_j = t27b_jz;
        t27b_z = t27b_q[t27b_jz];
        while (t27b_j > 0) {
            const t27b_hi: i32 = @intFromFloat(5.9604644775390625e-08 * t27b_z);
            t27b_fw = @floatFromInt(t27b_hi);
            const t27b_lo: i32 = @intFromFloat(t27b_z - 16777216.0 * t27b_fw);
            t27b_iq[t27b_i] = t27b_lo;
            t27b_z = t27b_q[t27b_j - 1] + t27b_fw;
            t27b_i = t27b_i + 1;
            t27b_j = t27b_j - 1;
        }
        // n: the integer part mod 8.
        t27b_z = t27b_z * t27b_libm_pow2(t27b_q0);
        const t27b_eighth: i64 = @intFromFloat(t27b_z * 0.125);
        const t27b_fl: f64 = @floatFromInt(t27b_eighth);
        t27b_z = t27b_z - 8.0 * t27b_fl;
        t27b_n = @intFromFloat(t27b_z);
        const t27b_nf: f64 = @floatFromInt(t27b_n);
        t27b_z = t27b_z - t27b_nf;
        t27b_ih = 0;
        if (t27b_q0 > 0) {
            // iq[jz - 1] holds bits of n.
            const t27b_top: i32 = t27b_iq[t27b_jz - 1] >> (24 - t27b_q0);
            t27b_n = t27b_n + t27b_top;
            t27b_iq[t27b_jz - 1] = t27b_iq[t27b_jz - 1] - (t27b_top << (24 - t27b_q0));
            t27b_ih = t27b_iq[t27b_jz - 1] >> (23 - t27b_q0);
        } else if (t27b_q0 == 0) {
            t27b_ih = t27b_iq[t27b_jz - 1] >> 23;
        } else if (t27b_z >= 0.5) {
            t27b_ih = 2;
        }
        if (t27b_ih > 0) {
            // q > 0.5: n + 1, and q becomes 1 - q.
            t27b_n = t27b_n + 1;
            var t27b_carry: i32 = 0;
            t27b_i = 0;
            while (t27b_i < t27b_jz) {
                const t27b_v: i32 = t27b_iq[t27b_i];
                if (t27b_carry == 0) {
                    if (t27b_v != 0) {
                        t27b_carry = 1;
                        t27b_iq[t27b_i] = 0x1000000 - t27b_v;
                    }
                } else {
                    t27b_iq[t27b_i] = 0xFFFFFF - t27b_v;
                }
                t27b_i = t27b_i + 1;
            }
            // q0 > 0 is 1 or 2 (Zig's `else => unreachable`).
            if (t27b_q0 == 1) {
                t27b_iq[t27b_jz - 1] = t27b_iq[t27b_jz - 1] & 0x7FFFFF;
            }
            if (t27b_q0 == 2) {
                t27b_iq[t27b_jz - 1] = t27b_iq[t27b_jz - 1] & 0x3FFFFF;
            }
            if (t27b_ih == 2) {
                t27b_z = 1.0 - t27b_z;
                if (t27b_carry != 0) {
                    t27b_z = t27b_z - t27b_libm_pow2(t27b_q0);
                }
            }
        }
        // Recompute with more terms of 2/pi when the fraction cancelled to zero.
        t27b_again = false;
        if (t27b_z == 0.0) {
            var t27b_acc: i32 = 0;
            t27b_i = t27b_jz;
            while (t27b_i > t27b_jk) {
                t27b_i = t27b_i - 1;
                t27b_acc = t27b_acc | t27b_iq[t27b_i];
            }
            if (t27b_acc == 0) {
                var t27b_k: usize = 1;
                while (t27b_iq[t27b_jk - t27b_k] == 0) {
                    t27b_k = t27b_k + 1;
                }
                t27b_i = t27b_jz + 1;
                while (t27b_i <= t27b_jz + t27b_k) {
                    const t27b_c2: f64 = @floatFromInt(t27b_libm_ipio2[t27b_jv + t27b_i]);
                    t27b_f[t27b_jx + t27b_i] = t27b_c2;
                    t27b_fw = 0.0;
                    t27b_j = 0;
                    while (t27b_j <= t27b_jx) {
                        t27b_fw = t27b_fw + t27b_x[t27b_j] * t27b_f[t27b_jx + t27b_i - t27b_j];
                        t27b_j = t27b_j + 1;
                    }
                    t27b_q[t27b_i] = t27b_fw;
                    t27b_i = t27b_i + 1;
                }
                t27b_jz = t27b_jz + t27b_k;
                t27b_again = true;
            }
        }
    }
    // Chop off zero terms, or break z into 24-bit pieces.
    if (t27b_z == 0.0) {
        t27b_jz = t27b_jz - 1;
        t27b_q0 = t27b_q0 - 24;
        while (t27b_iq[t27b_jz] == 0) {
            t27b_jz = t27b_jz - 1;
            t27b_q0 = t27b_q0 - 24;
        }
    } else {
        t27b_z = t27b_z * t27b_libm_pow2(0 - t27b_q0);
        if (t27b_z >= 16777216.0) {
            const t27b_hi2: i32 = @intFromFloat(5.9604644775390625e-08 * t27b_z);
            t27b_fw = @floatFromInt(t27b_hi2);
            const t27b_lo2: i32 = @intFromFloat(t27b_z - 16777216.0 * t27b_fw);
            t27b_iq[t27b_jz] = t27b_lo2;
            t27b_jz = t27b_jz + 1;
            t27b_q0 = t27b_q0 + 24;
            t27b_iq[t27b_jz] = t27b_hi2;
        } else {
            const t27b_lo3: i32 = @intFromFloat(t27b_z);
            t27b_iq[t27b_jz] = t27b_lo3;
        }
    }
    // The integer chunks as floating-point values, i = jz down to 0 (as the three loops below: d counts up,
    // i = jz - d).
    t27b_fw = t27b_libm_pow2(t27b_q0);
    var t27b_d: usize = 0;
    while (t27b_d <= t27b_jz) {
        const t27b_ci: usize = t27b_jz - t27b_d;
        const t27b_iqf: f64 = @floatFromInt(t27b_iq[t27b_ci]);
        t27b_q[t27b_ci] = t27b_fw * t27b_iqf;
        t27b_fw = t27b_fw * 5.9604644775390625e-08;
        t27b_d = t27b_d + 1;
    }
    // PIo2[0..jp] * q[jz..0].
    t27b_d = 0;
    while (t27b_d <= t27b_jz) {
        const t27b_pi: usize = t27b_jz - t27b_d;
        t27b_fw = 0.0;
        var t27b_k2: usize = 0;
        while (t27b_k2 <= t27b_jp and t27b_k2 <= t27b_jz - t27b_pi) {
            t27b_fw = t27b_fw + t27b_libm_pio2_parts[t27b_k2] * t27b_q[t27b_pi + t27b_k2];
            t27b_k2 = t27b_k2 + 1;
        }
        t27b_fq[t27b_jz - t27b_pi] = t27b_fw;
        t27b_d = t27b_d + 1;
    }
    // Compress fq[] into y[0], y[1] (prec 1).
    t27b_fw = 0.0;
    t27b_d = 0;
    while (t27b_d <= t27b_jz) {
        t27b_fw = t27b_fw + t27b_fq[t27b_jz - t27b_d];
        t27b_d = t27b_d + 1;
    }
    var t27b_y0: f64 = t27b_fw;
    if (t27b_ih != 0) {
        t27b_y0 = -t27b_fw;
    }
    t27b_fw = t27b_fq[0] - t27b_fw;
    t27b_i = 1;
    while (t27b_i <= t27b_jz) {
        t27b_fw = t27b_fw + t27b_fq[t27b_i];
        t27b_i = t27b_i + 1;
    }
    var t27b_y1: f64 = t27b_fw;
    if (t27b_ih != 0) {
        t27b_y1 = -t27b_fw;
    }
    return (t27b_n & 7, t27b_y0, t27b_y1);
}

// rem_pio2.zig `rem_pio2`: n and y[0] + y[1] = x - n * pi/2, for |x| > pi/4 (the caller handles the rest). Multiples
// of pio2_1 are exact; of pio2_1t, the f64 Zig folds `k * pio2_1t` to.
fn t27b_libm_rem_pio2(t27b_x: f64) -> (i32, f64, f64) {
    const t27b_u: u64 = @bitCast(t27b_x);
    const t27b_sign: bool = (t27b_u >> 63) != 0;
    const t27b_ix: u32 = @intCast((t27b_u >> 32) & 0x7FFFFFFF);
    if (t27b_ix <= 0x400F6A7A) {
        // |x| ~<= 5pi/4; |x| ~= pi/2 or 2pi/2 is medium's.
        if ((t27b_ix & 0xFFFFF) == 0x921FB) {
            return t27b_libm_rem_pio2_medium(t27b_ix, t27b_x);
        }
        if (t27b_ix <= 0x4002D97C) {
            // |x| ~<= 3pi/4
            if (!t27b_sign) {
                const t27b_z1: f64 = t27b_x - 1.5707963267341256;
                const t27b_a1: f64 = t27b_z1 - 6.077100506506192e-11;
                return (1, t27b_a1, (t27b_z1 - t27b_a1) - 6.077100506506192e-11);
            }
            const t27b_z2: f64 = t27b_x + 1.5707963267341256;
            const t27b_a2: f64 = t27b_z2 + 6.077100506506192e-11;
            return (-1, t27b_a2, (t27b_z2 - t27b_a2) + 6.077100506506192e-11);
        }
        if (!t27b_sign) {
            const t27b_z3: f64 = t27b_x - 3.1415926534682512;
            const t27b_a3: f64 = t27b_z3 - 1.2154201013012384e-10;
            return (2, t27b_a3, (t27b_z3 - t27b_a3) - 1.2154201013012384e-10);
        }
        const t27b_z4: f64 = t27b_x + 3.1415926534682512;
        const t27b_a4: f64 = t27b_z4 + 1.2154201013012384e-10;
        return (-2, t27b_a4, (t27b_z4 - t27b_a4) + 1.2154201013012384e-10);
    }
    if (t27b_ix <= 0x401C463B) {
        // |x| ~<= 9pi/4
        if (t27b_ix <= 0x4015FDBC) {
            // |x| ~<= 7pi/4; |x| ~= 3pi/2 is medium's.
            if (t27b_ix == 0x4012D97C) {
                return t27b_libm_rem_pio2_medium(t27b_ix, t27b_x);
            }
            if (!t27b_sign) {
                const t27b_z5: f64 = t27b_x - 4.712388980202377;
                const t27b_a5: f64 = t27b_z5 - 1.8231301519518578e-10;
                return (3, t27b_a5, (t27b_z5 - t27b_a5) - 1.8231301519518578e-10);
            }
            const t27b_z6: f64 = t27b_x + 4.712388980202377;
            const t27b_a6: f64 = t27b_z6 + 1.8231301519518578e-10;
            return (-3, t27b_a6, (t27b_z6 - t27b_a6) + 1.8231301519518578e-10);
        }
        // |x| ~= 4pi/2 is medium's.
        if (t27b_ix == 0x401921FB) {
            return t27b_libm_rem_pio2_medium(t27b_ix, t27b_x);
        }
        if (!t27b_sign) {
            const t27b_z7: f64 = t27b_x - 6.2831853069365025;
            const t27b_a7: f64 = t27b_z7 - 2.430840202602477e-10;
            return (4, t27b_a7, (t27b_z7 - t27b_a7) - 2.430840202602477e-10);
        }
        const t27b_z8: f64 = t27b_x + 6.2831853069365025;
        const t27b_a8: f64 = t27b_z8 + 2.430840202602477e-10;
        return (-4, t27b_a8, (t27b_z8 - t27b_a8) + 2.430840202602477e-10);
    }
    if (t27b_ix < 0x413921FB) {
        // |x| ~< 2^20 * (pi/2), medium size
        return t27b_libm_rem_pio2_medium(t27b_ix, t27b_x);
    }
    if (t27b_ix >= 0x7FF00000) {
        // inf or NaN
        const t27b_d: f64 = t27b_x - t27b_x;
        return (0, t27b_d, t27b_d);
    }
    // z = scalbn(|x|, -ilogb(x) + 23), cut into three 24-bit pieces; the zero ones at the end are skipped.
    const t27b_zu: u64 = (t27b_u & 0x000FFFFFFFFFFFFF) | 0x4160000000000000;
    var t27b_z: f64 = @bitCast(t27b_zu);
    const t27b_i0: i32 = @intFromFloat(t27b_z);
    const t27b_tx0: f64 = @floatFromInt(t27b_i0);
    t27b_z = (t27b_z - t27b_tx0) * 16777216.0;
    const t27b_i1: i32 = @intFromFloat(t27b_z);
    const t27b_tx1: f64 = @floatFromInt(t27b_i1);
    t27b_z = (t27b_z - t27b_tx1) * 16777216.0;
    var t27b_nx: i32 = 3;
    if (t27b_z == 0.0) {
        t27b_nx = 2;
        if (t27b_tx1 == 0.0) {
            t27b_nx = 1;
        }
    }
    const t27b_ex: i32 = @intCast(t27b_ix >> 20);
    let (t27b_n, t27b_y0, t27b_y1) = t27b_libm_rem_pio2_large(t27b_tx0, t27b_tx1, t27b_z, t27b_ex - 1046, t27b_nx);
    if (t27b_sign) {
        return (0 - t27b_n, -t27b_y0, -t27b_y1);
    }
    return (t27b_n, t27b_y0, t27b_y1);
}

// compiler_rt `cos` (f64). |x| < 2^-27 * sqrt(2) is 1 (Zig's `x + 0x1p120` only raises inexact); inf and NaN give
// x - x; otherwise cos or -sin, -cos, sin of the reduced argument by n mod 4.
fn t27b_libm_cos(t27b_x: f64) -> f64 {
    const t27b_u: u64 = @bitCast(t27b_x);
    const t27b_ix: u32 = @intCast((t27b_u >> 32) & 0x7FFFFFFF);
    if (t27b_ix <= 0x3FE921FB) {
        // |x| ~< pi/4
        if (t27b_ix < 0x3E46A09E) {
            return 1.0;
        }
        return t27b_libm_kcos(t27b_x, 0.0);
    }
    if (t27b_ix >= 0x7FF00000) {
        return t27b_x - t27b_x;
    }
    let (t27b_n, t27b_y0, t27b_y1) = t27b_libm_rem_pio2(t27b_x);
    const t27b_q: i32 = t27b_n & 3;
    if (t27b_q == 0) {
        return t27b_libm_kcos(t27b_y0, t27b_y1);
    }
    if (t27b_q == 1) {
        return -t27b_libm_ksin(t27b_y0, t27b_y1, 1);
    }
    if (t27b_q == 2) {
        return -t27b_libm_kcos(t27b_y0, t27b_y1);
    }
    return t27b_libm_ksin(t27b_y0, t27b_y1, 1);
}

// ---------------------------------------------------------------- tests

fn exp_of(x: f64) -> f64 {
    return @exp(x);
}

fn exp_of_neg(x: f64) -> f64 {
    return @exp(-x);
}

fn expf_of(x: f32) -> f32 {
    return @exp(x);
}

fn sigmoid(x: f32) -> f32 {
    return 1.0 / (1.0 + @exp(-x));
}

// Points of `x = start + i * step` for `0 <= i < n` where the routine and `@exp` differ.
fn sweep_misses(start: f64, step: f64, n: u32) -> u32 {
    var misses: u32 = 0;
    var i: u32 = 0;
    while (i < n) {
        const x: f64 = start + @as(f64, @floatFromInt(i)) * step;
        if (t27b_libm_exp(x) != @exp(x)) {
            misses = misses + 1;
        }
        i = i + 1;
    }
    return misses;
}

fn sweep_misses_f32(start: f32, step: f32, n: u32) -> u32 {
    var misses: u32 = 0;
    var i: u32 = 0;
    while (i < n) {
        const x: f32 = start + @as(f32, @floatFromInt(i)) * step;
        if (t27b_libm_expf(x) != @exp(x)) {
            misses = misses + 1;
        }
        i = i + 1;
    }
    return misses;
}

// softmax over a run-time array: `@exp` of an indexed operand.
fn softmax_first(a: f64, b: f64, c: f64) -> f64 {
    var xs: [3]f64 = undefined;
    xs[0] = a;
    xs[1] = b;
    xs[2] = c;
    var ys: [3]f64 = undefined;
    var s: f64 = 0.0;
    var i: usize = 0;
    while (i < 3) {
        ys[i] = @exp(xs[i] - c);
        s = s + ys[i];
        i = i + 1;
    }
    return ys[0] / s;
}

test exp_agrees_with_compiler_rt_over_the_whole_range {
    assert(sweep_misses(-750.0, 0.2924, 5000) == 0);
}

test exp_agrees_near_zero_and_in_the_reduction_bands {
    assert(sweep_misses(-1.2, 0.0004938, 5000) == 0);
    assert(sweep_misses(-0.000000004, 0.0000000000016, 5000) == 0);
}

test exp_agrees_where_the_result_is_subnormal_or_huge {
    assert(sweep_misses(-745.2, 0.0076, 5000) == 0);
    assert(sweep_misses(700.0, 0.00196, 5000) == 0);
}

test expf_agrees_with_compiler_rt_over_the_whole_range {
    assert(sweep_misses_f32(-104.5, 0.0388, 5000) == 0);
    assert(sweep_misses_f32(-1.2, 0.0004938, 5000) == 0);
}

test exp_gives_the_reference_bits {
    // One ulp above e rounded to nearest (2.718281828459045): compiler_rt's
    // answer, not the correctly rounded one.
    assert(exp_of(1.0) == 2.7182818284590455);
    assert(exp_of(-1.0) == 0.36787944117144233);
    assert(exp_of(0.5) == 1.6487212707001282);
    assert(exp_of(10.0) == 22026.465794806718);
    assert(exp_of(0.0) == 1.0);
    assert(exp_of_neg(2.0) == 0.1353352832366127);
    assert(exp_of(709.0) == 8.218407461554972e307);
}

test exp_at_the_ends_of_the_range {
    assert(exp_of(-745.0) == 5.0e-324);
    assert(exp_of(-746.0) == 0.0);
    assert(exp_of(710.0) > 1.7976931348623157e308);
    assert(exp_of(-1000.0) == 0.0);
    const inf: f64 = exp_of(1000.0);
    assert(exp_of(inf) == inf);
    assert(exp_of(-inf) == 0.0);
    const nan: f64 = inf - inf;
    const e: f64 = exp_of(nan);
    assert(e != e);
}

test expf_and_a_sigmoid {
    assert(expf_of(1.0) == 2.7182817);
    assert(expf_of(-1.0) == 0.36787945);
    assert(expf_of(-104.0) == 0.0);
    assert(expf_of(89.0) > 3.4028234e38);
    assert(sigmoid(0.0) == 0.5);
    assert(sigmoid(2.0) == 0.880797);
}

// Zig folds a `@exp` of a typed operand it knows at compile time with the compiler's own exp, which in
// Zig 0.16 is compiler_rt's code: the same bits as the call at run time (specs/tri/t27b/libm_plan.t27).
// t27b calls the routine for each of these. t27c unrolls the range loop below into literal steps.
const EXP_HALF : f64 = 0.5;

fn exp_sum_of_steps() -> f64 {
    var s: f64 = 0.0;
    for i in 0..3 {
        s = s + @exp(@as(f64, @floatFromInt(i)));
    }
    return s;
}

test exp_of_a_compile_time_operand_has_the_run_time_bits {
    const one: f64 = 1.0;
    assert(@exp(one) == 2.7182818284590455);
    assert(@exp(EXP_HALF) == exp_of(0.5));
    const minus: f64 = -2.0;
    assert(@exp(minus) == exp_of_neg(2.0));
    const onef: f32 = 1.0;
    assert(@exp(onef) == expf_of(1.0));
    assert(exp_sum_of_steps() == exp_of(0.0) + exp_of(1.0) + exp_of(2.0));
}

invariant exp_folded_at_compile_time_is_compiler_rt: exp_of(1.0) == 2.7182818284590455;

test softmax_of_indexed_operands {
    const p = softmax_first(1.0, 2.0, 3.0);
    assert(p == 0.09003057317038046);
}

fn log_of(x: f64) -> f64 {
    return @log(x);
}

// Points of `x = start * step^i` for `0 <= i < n` where the routine and `@log` differ.
fn log_geo_misses(start: f64, step: f64, n: u32) -> u32 {
    var misses: u32 = 0;
    var x: f64 = start;
    var i: u32 = 0;
    while (i < n) {
        if (t27b_libm_log(x) != @log(x)) {
            misses = misses + 1;
        }
        x = x * step;
        i = i + 1;
    }
    return misses;
}

// Points of `x = start + i * step` for `0 <= i < n` where the routine and `@log` differ.
fn log_lin_misses(start: f64, step: f64, n: u32) -> u32 {
    var misses: u32 = 0;
    var i: u32 = 0;
    while (i < n) {
        const x: f64 = start + @as(f64, @floatFromInt(i)) * step;
        if (t27b_libm_log(x) != @log(x)) {
            misses = misses + 1;
        }
        i = i + 1;
    }
    return misses;
}

// Cross entropy of one-hot targets, as specs/port/trinity/src/tri/gen_cross_entropy.t27 writes it.
fn cross_entropy(p0: f64, p1: f64, t0: f64, t1: f64) -> f64 {
    var ps: [2]f64 = undefined;
    ps[0] = p0;
    ps[1] = p1;
    var ts: [2]f64 = undefined;
    ts[0] = t0;
    ts[1] = t1;
    var loss: f64 = 0.0;
    var i: usize = 0;
    while (i < 2) {
        loss = loss - ts[i] * @log(ps[i] + 0.0000000001);
        i = i + 1;
    }
    return loss;
}

test log_agrees_with_compiler_rt_from_the_least_subnormal_up {
    assert(log_geo_misses(4.9406564584124654e-324, 1.1994, 8000) == 0);
    assert(log_geo_misses(1.0e-310, 1.0953, 8000) == 0);
}

test log_agrees_around_one_and_across_the_table {
    assert(log_lin_misses(0.93, 0.00001775, 8000) == 0);
    assert(log_lin_misses(0.5, 0.00015575, 8000) == 0);
    assert(log_lin_misses(1.0e300, 9.25e303, 8000) == 0);
}

test log_gives_the_reference_bits {
    assert(log_of(2.0) == 0.6931471805599453);
    assert(log_of(0.5) == -0.6931471805599453);
    assert(log_of(10.0) == 2.302585092994046);
    assert(log_of(3.0) == 1.0986122886681098);
    assert(log_of(0.95) == -0.05129329438755058);
    assert(log_of(1.05) == 0.04879016416943205);
    assert(log_of(1.0) == 0.0);
    assert(log_of(5.0e-324) == -744.4400719213812);
    assert(log_of(1.0e-300) == -690.7755278982137);
    assert(log_of(1.7976931348623157e308) == 709.782712893384);
}

test log_at_zero_infinity_and_nan {
    const z: f64 = log_of(1.0) * 0.0;
    assert(log_of(z) < -1.7976931348623157e308);
    const inf: f64 = 1.0 / z;
    assert(log_of(inf) == inf);
    const n: f64 = log_of(-2.0);
    assert(n != n);
    const nan: f64 = inf - inf;
    const m: f64 = log_of(nan);
    assert(m != m);
    // The port's own special cases, called directly.
    assert(t27b_libm_log(z) == log_of(z));
    assert(t27b_libm_log(inf) == inf);
    assert(t27b_libm_log(1.0) == 0.0);
    const pn: f64 = t27b_libm_log(-2.0);
    assert(pn != pn);
    const pm: f64 = t27b_libm_log(nan);
    assert(pm != pm);
}

// Points where one ulp of a polynomial coefficient (A0) or of a table entry (invc[0]) changes the
// result, found by a search of 30 million points for #7217: the sweeps above step over them.
test log_agrees_where_one_ulp_of_a_constant_shows {
    assert(t27b_libm_log(0.710994125) == log_of(0.710994125));
    assert(t27b_libm_log(0.7785005) == log_of(0.7785005));
    assert(t27b_libm_log(0.68751635) == log_of(0.68751635));
    assert(t27b_libm_log(0.687522425) == log_of(0.687522425));
    assert(log_of(0.710994125) == -0.3410911122228803);
    assert(log_of(0.68751635) == -0.3746696679060118);
}

// A `@log` Zig folds at compile time gives the run-time bits too (specs/tri/t27b/libm_plan.t27).
const LOG_TWO : f64 = 2.0;

test log_of_a_compile_time_operand_has_the_run_time_bits {
    const two: f64 = 2.0;
    assert(@log(two) == 0.6931471805599453);
    assert(@log(LOG_TWO) == log_of(2.0));
    const least: f64 = 5.0e-324;
    assert(@log(least) == log_of(5.0e-324));
    const near_one: f64 = 0.95;
    assert(@log(near_one) == log_of(0.95));
}

// `@log` of a float literal (#10405, specs/t27f/token_floor.t27's `@log(10.0)`): Zig folds a comptime_float
// with compiler_rt `logq`, which is `log` of the operand cast to f64, so the folded value is an f64's exact decimal.
// An f128-precise fold would differ from it in the 17th digit; these decimals are the f64 results to the last digit.
test log_of_a_literal_is_the_f64_routine_s {
    assert(@log(10.0) == 2.30258509299404590109361379290930926799774169921875);
    assert(@log(2.0) == 0.69314718055994528622676398299518041312694549560546875);
    assert(@log(3.0) == 1.0986122886681097821082175869378261268138885498046875);
    assert(@log(0.95) == -0.05129329438755057812837634401148534379899501800537109375);
    assert(@log(0.710994125) == -0.341091112222880299409411009037285111844539642333984375);
    assert(@log(10.0) == log_of(10.0));
    assert(@log(2.0) == log_of(2.0));
    assert(@log(0.5) == log_of(0.5));
    assert(@log(1.0) == 0.0);
    assert(@log(1.05) == log_of(1.05));
    assert(@log(0.7785005) == log_of(0.7785005));
    assert(@log(1.0e-300) == log_of(1.0e-300));
    assert(@log(1.0e300) == log_of(1.0e300));
    assert(@log(2.718281828459045) == log_of(2.718281828459045));
    // As token_floor writes it: a typed operand over a literal's.
    const x: f64 = 1234.5;
    assert(@log(x) / @log(10.0) == log_of(1234.5) / log_of(10.0));
}

invariant log_folded_at_compile_time_is_compiler_rt: log_of(10.0) == 2.302585092994046;

test cross_entropy_of_a_one_hot_target {
    assert(cross_entropy(0.5, 0.5, 1.0, 0.0) == 0.6931471803599453);
    assert(cross_entropy(1.0, 0.0, 1.0, 0.0) < 0.00001);
}

// std.math.nan, isNan, isPositiveInf and isNegativeInf against the routines, on the bit patterns where they
// part: the quiet and the signalling NaN of either sign, the infinities, the largest finite, the zeros.
fn bits_of_f32(x: f32) -> u32 {
    const b: u32 = @bitCast(x);
    return b;
}

fn bits_of_f64(x: f64) -> u64 {
    const b: u64 = @bitCast(x);
    return b;
}

fn f32_of(b: u32) -> f32 {
    const x: f32 = @bitCast(b);
    return x;
}

fn f64_of(b: u64) -> f64 {
    const x: f64 = @bitCast(b);
    return x;
}

// How many of the f32 points the four routines and Zig's std.math classify differently.
fn std_math_misses_f32() -> u32 {
    var pts: [9]u32 = undefined;
    pts[0] = 0x7FC00000;
    pts[1] = 0xFFC00000;
    pts[2] = 0x7F800001;
    pts[3] = 0xFF800001;
    pts[4] = 0x7F800000;
    pts[5] = 0xFF800000;
    pts[6] = 0x7F7FFFFF;
    pts[7] = 0x80000000;
    pts[8] = 0x00000001;
    var misses: u32 = 0;
    var i: usize = 0;
    while (i < 9) {
        const x: f32 = f32_of(pts[i]);
        if (t27b_libm_isnanf(x) != std.math.isNan(x)) { misses = misses + 1; }
        if (t27b_libm_isposinff(x) != std.math.isPositiveInf(x)) { misses = misses + 1; }
        if (t27b_libm_isneginff(x) != std.math.isNegativeInf(x)) { misses = misses + 1; }
        i = i + 1;
    }
    return misses;
}

fn std_math_misses_f64() -> u32 {
    var pts: [7]u64 = undefined;
    pts[0] = 0x7FF8000000000000;
    pts[1] = 0xFFF8000000000000;
    pts[2] = 0x7FF0000000000001;
    pts[3] = 0x7FF0000000000000;
    pts[4] = 0xFFF0000000000000;
    pts[5] = 0x7FEFFFFFFFFFFFFF;
    pts[6] = 0x8000000000000000;
    var misses: u32 = 0;
    var i: usize = 0;
    while (i < 7) {
        const x: f64 = f64_of(pts[i]);
        if (t27b_libm_isnan(x) != std.math.isNan(x)) { misses = misses + 1; }
        if (t27b_libm_isposinf(x) != std.math.isPositiveInf(x)) { misses = misses + 1; }
        if (t27b_libm_isneginf(x) != std.math.isNegativeInf(x)) { misses = misses + 1; }
        i = i + 1;
    }
    return misses;
}

test std_math_nan_is_the_canonical_quiet_nan {
    assert(bits_of_f32(std.math.nan(f32)) == 0x7FC00000);
    assert(bits_of_f64(std.math.nan(f64)) == 0x7FF8000000000000);
    assert(bits_of_f32(t27b_libm_nanf()) == 0x7FC00000);
    assert(bits_of_f64(t27b_libm_nan()) == 0x7FF8000000000000);
    assert(bits_of_f32(-std.math.nan(f32)) == 0xFFC00000);
    const n: f32 = std.math.nan(f32);
    assert(n != n);
}

test the_nan_and_inf_predicates_are_zig_s {
    assert(std_math_misses_f32() == 0);
    assert(std_math_misses_f64() == 0);
    assert(std.math.isNan(f32_of(0x7F800001)));
    assert(!std.math.isNan(f32_of(0x7F800000)));
    assert(std.math.isPositiveInf(f32_of(0x7F800000)));
    assert(!std.math.isPositiveInf(f32_of(0xFF800000)));
    assert(std.math.isNegativeInf(f64_of(0xFFF0000000000000)));
    assert(!std.math.isNegativeInf(f64_of(0xFFF8000000000000)));
    assert(t27b_libm_isnanf(f32_of(0xFF800001)));
    assert(!t27b_libm_isposinff(f32_of(0x7F7FFFFF)));
    assert(t27b_libm_isneginff(f32_of(0xFF800000)));
    assert(t27b_libm_isposinf(f64_of(0x7FF0000000000000)));
    assert(!t27b_libm_isnan(f64_of(0x8000000000000000)));
}

// #7923: `std.math.inf` by its bits, `std.math.log(f64, std.math.e, x)` against `@log(x)`, and the edges of `round`
// and `log1p`; conformance/libm_std_math.t27 sweeps `round` and `log1p` against Zig's `@round` and
// `std.math.log1p` (here they would spend the interpreter fuel the checks of this file need).
test round_halves_away_from_zero {
    assert(t27b_libm_round(2.5) == 3.0);
    assert(t27b_libm_round(-2.5) == -3.0);
    assert(t27b_libm_round(0.49999999999999994) == 0.0);
    assert(bits_of_f64(t27b_libm_round(-0.2)) == 0x8000000000000000);
    assert(t27b_libm_round(t27b_libm_inf()) == t27b_libm_inf());
    const n: f64 = t27b_libm_round(t27b_libm_nan());
    assert(n != n);
}

test log1p_at_minus_one_infinity_zero_and_below {
    assert(t27b_libm_log1p(-1.0) == -t27b_libm_inf());
    assert(t27b_libm_log1p(t27b_libm_inf()) == t27b_libm_inf());
    const n: f64 = t27b_libm_log1p(-2.0);
    assert(n != n);
    assert(bits_of_f64(t27b_libm_log1p(0.0)) == 0);
    assert(bits_of_f64(t27b_libm_log1p(-0.0)) == 0x8000000000000000);
    const one: f64 = 1.0;
    assert(t27b_libm_log1p(one) == std.math.log1p(one));
    assert(t27b_libm_log1p(one) == 0.6931471805599453);
}

test inf_and_log_base_e_are_zig_s {
    assert(bits_of_f32(t27b_libm_inff()) == 0x7F800000);
    assert(bits_of_f64(t27b_libm_inf()) == 0x7FF0000000000000);
    assert(bits_of_f32(std.math.inf(f32)) == 0x7F800000);
    assert(bits_of_f64(std.math.inf(f64)) == 0x7FF0000000000000);
    assert(bits_of_f32(-std.math.inf(f32)) == 0xFF800000);
    const x: f64 = 7.5;
    assert(std.math.log(f64, std.math.e, x) == @log(x));
    assert(std.math.log(f64, std.math.e, x) == t27b_libm_log(x));
}

// #8677: `cos` against Zig's run-time `@cos` (compiler_rt `cos`) on sweeps through every branch, under the reference,
// and fixed bits for both, printed by Zig 0.16 on the t27c lab (Debug, no libc). The sweeps are sized so this file's
// `t27b test --check` still finishes inside its interpreter budget (specs/tri/t27b/check_budget.t27); the
// differential run on the lab for #8677 compared several thousand points more, bit for bit.
fn cos_of(x: f64) -> f64 {
    return @cos(x);
}

// Points of `x = start + i * step` for `0 <= i < n` where the routine and `@cos` differ.
fn cos_lin_misses(start: f64, step: f64, n: u32) -> u32 {
    var misses: u32 = 0;
    var i: u32 = 0;
    while (i < n) {
        const x: f64 = start + @as(f64, @floatFromInt(i)) * step;
        if (t27b_libm_cos(x) != @cos(x)) {
            misses = misses + 1;
        }
        i = i + 1;
    }
    return misses;
}

// Points of `x = start * step^i`, and of -x, for `0 <= i < n` where the routine and `@cos` differ.
fn cos_geo_misses(start: f64, step: f64, n: u32) -> u32 {
    var misses: u32 = 0;
    var x: f64 = start;
    var i: u32 = 0;
    while (i < n) {
        if (t27b_libm_cos(x) != @cos(x)) {
            misses = misses + 1;
        }
        if (t27b_libm_cos(-x) != @cos(-x)) {
            misses = misses + 1;
        }
        x = x * step;
        i = i + 1;
    }
    return misses;
}

// |x| <= 9pi/4 (7.07): the kernel band, rem_pio2's multiples one to four of pi/2, and medium at pi/2, pi, 3pi/2, 2pi.
test cos_agrees_with_compiler_rt_up_to_nine_quarters_of_pi {
    assert(cos_lin_misses(-7.1, 0.0142, 1000) == 0);
}

// 7 <= |x| < 2^20 * pi/2 (1647099.3): `medium`, one to three rounds.
test cos_agrees_with_compiler_rt_in_the_medium_range {
    assert(cos_geo_misses(7.0, 1.0314, 400) == 0);
}

// |x| >= 2^20 * pi/2, up to 1.4e304: `rem_pio2_large`.
test cos_agrees_with_compiler_rt_on_large_arguments {
    assert(cos_geo_misses(1647100.0, 14.0, 260) == 0);
}

test cos_gives_the_reference_bits {
    assert(t27b_libm_cos(1.0) == 0.5403023058681398);
    assert(t27b_libm_cos(1.0e7) == -0.9072703861817396);
    assert(t27b_libm_cos(0.0) == 1.0);
    assert(t27b_libm_cos(-0.0) == 1.0);
    assert(t27b_libm_cos(-1.0) == 0.5403023058681398);
    assert(t27b_libm_cos(-1.0e7) == -0.9072703861817396);
    assert(t27b_libm_cos(0.5) == 0.8775825618903728);
    assert(t27b_libm_cos(2.0) == -0.4161468365471424);
    assert(t27b_libm_cos(-2.0) == -0.4161468365471424);
    assert(t27b_libm_cos(3.0) == -0.9899924966004454);
    assert(t27b_libm_cos(4.0) == -0.6536436208636119);
    assert(t27b_libm_cos(5.0) == 0.28366218546322625);
    assert(t27b_libm_cos(6.0) == 0.960170286650366);
    assert(t27b_libm_cos(-6.0) == 0.960170286650366);
    assert(t27b_libm_cos(7.0) == 0.7539022543433046);
    assert(t27b_libm_cos(100.0) == 0.8623188722876839);
    assert(t27b_libm_cos(0.6283185307179586) == 0.8090169943749475);
    assert(bits_of_f64(t27b_libm_cos(1.0)) == 0x3FE14A280FB5068C);
    assert(bits_of_f64(t27b_libm_cos(1.0e7)) == 0xBFED085BE7A8F4A1);
}

test cos_near_multiples_of_half_pi {
    assert(t27b_libm_cos(0.7853981633974483) == 0.7071067811865476);
    assert(t27b_libm_cos(-0.7853981633974483) == 0.7071067811865476);
    assert(t27b_libm_cos(1.5707963267948966) == 6.123233995736766e-17);
    assert(t27b_libm_cos(2.356194490192345) == -0.7071067811865475);
    assert(t27b_libm_cos(3.141592653589793) == -1.0);
    assert(t27b_libm_cos(-3.141592653589793) == -1.0);
    assert(t27b_libm_cos(4.71238898038469) == -1.8369701987210297e-16);
    assert(t27b_libm_cos(6.283185307179586) == 1.0);
}

// 2^20 * pi/2 is 1647099.3...: 1647099.0 is `medium`'s, 1647100.0 and up `rem_pio2_large`'s.
test cos_of_a_large_argument_takes_rem_pio2_large {
    assert(t27b_libm_cos(1048576.0) == 0.943808393901312);
    assert(t27b_libm_cos(1647099.0) == 0.9463124973290988);
    assert(t27b_libm_cos(1647100.0) == 0.7833030468809974);
    assert(t27b_libm_cos(1.0e10) == 0.873119622676856);
    assert(t27b_libm_cos(1.0e15) == -0.5131937377869702);
    assert(t27b_libm_cos(1.0e22) == 0.523214785395139);
    assert(t27b_libm_cos(-1.0e22) == 0.523214785395139);
    assert(t27b_libm_cos(1.0e100) == 0.9247242387519338);
    assert(t27b_libm_cos(1.0e300) == -0.5753861119575491);
    assert(t27b_libm_cos(-1.0e300) == -0.5753861119575491);
    assert(t27b_libm_cos(1.7976931348623157e308) == -0.9999876894265599);
    // 6381956970095103 * 2^797, the double nearest a multiple of pi/2.
    assert(bits_of_f64(t27b_libm_cos(f64_of(0x7506AC5B262CA1FF))) == 0xBC214AE72E6BA22F);
}

test cos_of_tiny_nan_and_infinity {
    assert(t27b_libm_cos(1.0e-8) == 1.0);
    assert(t27b_libm_cos(1.0e-300) == 1.0);
    assert(t27b_libm_cos(5.0e-324) == 1.0);
    assert(t27b_libm_cos(-5.0e-324) == 1.0);
    const inf: f64 = t27b_libm_inf();
    const a: f64 = t27b_libm_cos(inf);
    assert(a != a);
    const b: f64 = t27b_libm_cos(-inf);
    assert(b != b);
    const c: f64 = t27b_libm_cos(t27b_libm_nan());
    assert(c != c);
    const d: f64 = cos_of(-inf);
    assert(d != d);
}

// `@cos` of a typed f64 calls the routine, folded or not (specs/tri/t27b/libm_plan.t27).
test cos_by_the_builtin {
    const one: f64 = 1.0;
    assert(@cos(one) == 0.5403023058681398);
    assert(cos_of(1.0e7) == -0.9072703861817396);
    assert(cos_of(0.0) == 1.0);
    assert(cos_of(-1.0e22) == t27b_libm_cos(1.0e22));
    assert(cos_of(1647100.0) == t27b_libm_cos(1647100.0));
}

invariant cos_folded_at_compile_time_is_compiler_rt: cos_of(1.0) == 0.5403023058681398;
