; specs/tri/t27b/conformance/signed_modulo_untyped_local.t27 -- signed % on untyped/typed locals
; (gHashTag/t27#9048). Every test here should be refused by t27b with a typed error during type checking.
; t27b must detect signed % operations and refuse them with a typed diagnostic, matching the reference compiler.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceSignedModuloUntypedLocal;

// Test 1: signed % on typed local (should be refused)
fn typed_modulo_refusal() -> i32 {
    let x = 10;  // untyped local, inferred as i32
    let y = x % 3;  // signed % on untyped local - should be refused
    return y;
}

// Test 2: signed % on explicitly typed local (should be refused)
fn explicitly_typed_modulo_refusal() -> i32 {
    let x: i32 = 10;  // explicitly typed i32
    let y = x % 3;  // signed % on typed i32 - should be refused
    return y;
}

// Test 3: signed % on negative untyped local (should be refused)
fn negative_untyped_modulo_refusal() -> i32 {
    let x = -10;  // untyped local, inferred as i32
    let y = x % 3;  // signed % on negative untyped local - should be refused
    return y;
}

// Test 4: signed % on negative typed local (should be refused)
fn negative_typed_modulo_refusal() -> i32 {
    let x: i32 = -10;  // explicitly typed i32
    let y = x % 3;  // signed % on negative typed i32 - should be refused
    return y;
}

// Test 5: signed % in expression (should be refused)
fn expression_modulo_refusal() -> i32 {
    let a = 20;
    let b = 7;
    let c = (a + b) % 5;  // signed % in expression - should be refused
    return c;
}

// Test 6: signed % on function parameter (should be refused)
fn param_modulo_refusal(a: i32) -> i32 {
    let result = a % 2;  // signed % on typed parameter - should be refused
    return result;
}

// Tests to verify the refusal behavior
test typed_modulo_should_be_refused {
    // This test should not run because the function should be refused during type checking
    let _ = typed_modulo_refusal();
}

test explicitly_typed_modulo_should_be_refused {
    // This test should not run because the function should be refused during type checking
    let _ = explicitly_typed_modulo_refusal();
}