// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/elf_object.t27 -- what `t27b build --elf` (specs/tri/t27b/elf.t27, issue #8947)
; must turn into an aarch64 Linux object that the GNU toolchain links and runs. Every test here passes
; `t27c test-report`, and t27b must give the same verdict on each.
; Covered, one part each: a value returned (`answer`); calls between fns, the callee not exported to C
; by name only (`twice`, `add3`); read-only data, a string and an array, so the second blob's relocation
; carries a non-zero addend (`letter`, `prime`); module-level vars of two sizes, reached through the
; address table in .data (`bump`, `toggle`). Each `exit_*` takes no parameter and returns a small code,
; so a linker can stand it in for `main` (`-Wl,--defsym=main=exit_calls`) and the exit status checks
; the part: 42, 16, 114, 41.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceElfObject;

const GREETING : str = "hello, elf";

const PRIMES : [6]u32 = [2, 3, 5, 7, 11, 13];

var flag : u8 = 1;

var counter : i64 = 40;

pub fn answer() -> i32 {
    return 42;
}

fn twice(x: i32) -> i32 {
    return x + x;
}

pub fn add3(a: i32, b: i32, c: i32) -> i32 {
    return twice(a) + b * c;
}

pub fn letter(i: usize) -> u8 {
    return GREETING[i];
}

pub fn prime(i: usize) -> u32 {
    return PRIMES[i];
}

pub fn bump() -> i64 {
    counter = counter + 1;
    return counter;
}

pub fn toggle() -> u8 {
    flag = 1 - flag;
    return flag;
}

pub fn exit_calls() -> i32 {
    return add3(5, 2, 3);
}

pub fn exit_data() -> i32 {
    return (letter(7) as i32) + (prime(5) as i32);
}

pub fn exit_global() -> i32 {
    return bump() as i32;
}

test a_value_is_returned {
    assert answer() == 42;
}

test calls_between_fns {
    assert twice(21) == 42;
    assert add3(5, 2, 3) == 16;
    assert add3(1, 2, 3) == 8;
    assert exit_calls() == 16;
}

test string_and_array_data {
    assert letter(0) == 104;
    assert letter(7) == 101;
    assert prime(0) == 2;
    assert prime(5) == 13;
    assert exit_data() == 114;
}

test module_vars_change {
    assert bump() == 41;
    assert bump() == 42;
    assert toggle() == 0;
    assert toggle() == 1;
}

test a_module_var_starts_from_its_initial_value {
    assert exit_global() == 41;
}
