// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/bare_libm.t27 -- the bare math names the reference's Zig backend rewrites
; to a builtin (`exp(`, `log(`, `floor(`, `ceil(`, `round(`, `min(`, `max(`), as the reference runs them
; (issue #9065, epic #6063; bare `abs`/`sqrt` are conformance/bare_abs.t27's). Every test here passes
; `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; t27c's Zig backend prints a bare `exp(x)` as Zig's `@exp(x)`, a bare `tanh(x)` as Zig's
; `std.math.tanh(x)`, and the rest of `libm_plan.t27`'s `bare_target` the same way, unless the spec
; declares a fn of that name. The operand decides the routine: an f32 `exp` is compiler_rt's `expf`, an
; f64 one its `exp` (libm_plan.t27).
; A typed value, never a bare literal: Zig types `exp(1.0)` from the result location, so libm_plan.t27
; refuses a literal operand (REFUSE_LITERAL) and t27b does not model that. The tests below pass a typed
; `const` or a parameter, where the two backends agree on the type.
; `tanh` and an f32 `sin`/`cos` are not here: the reference runs Zig's `std.math.tanh(x)` and compiler_rt's
; `sinf`/`cosf`, which libm.t27 has not ported yet -- the bare name reaches the planned call, which
; refuses it by name instead of calling it an undeclared fn (#9065, next lane).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceBareLibm;

const TOL64 : f64 = 1.0e-12;
const TOL32 : f32 = 1.0e-5;

// A `fn` of one of the bare names wins over the rewrite, as the reference's `declared_fns` guard does.
fn max(a: f64, b: f64) -> f64 {
    return 99.0;
}

fn within64(a: f64, b: f64) -> bool {
    return @abs(a - b) <= TOL64;
}

fn within32(a: f32, b: f32) -> bool {
    return @abs(a - b) <= TOL32;
}

fn exp64(x: f64) -> f64 {
    return exp(x);
}

fn exp32(x: f32) -> f32 {
    return exp(x);
}

fn log64(x: f64) -> f64 {
    return log(x);
}

fn log32(x: f32) -> f32 {
    return log(x);
}

fn floor32(x: f32) -> f32 {
    return floor(x);
}

fn ceil64(x: f64) -> f64 {
    return ceil(x);
}

fn round32(x: f32) -> f32 {
    return round(x);
}

fn smaller(a: f32, b: f32) -> f32 {
    return min(a, b);
}

fn larger(a: f64, b: f64) -> f64 {
    return max(a, b);
}

test exp_of_a_typed_f64_is_e_at_one {
    const one : f64 = 1.0;
    const zero : f64 = 0.0;
    assert(within64(exp64(one), 2.718281828459045));
    assert(within64(exp64(zero), 1.0));
    assert(exp64(zero) == 1.0);
}

test exp_of_a_typed_f32_is_e_at_one {
    const one : f32 = 1.0;
    const zero : f32 = 0.0;
    assert(within32(exp32(one), 2.7182817));
    assert(exp32(zero) == 1.0);
    assert(exp32(one) > 2.7);
}

test exp_grows_and_stays_positive {
    const a : f64 = -1.0;
    const b : f64 = 1.0;
    assert(exp64(a) > 0.0);
    assert(exp64(b) > exp64(a));
    assert(within64(exp64(a), 0.36787944117144233));
}

test log_of_a_typed_f64_and_f32_is_e_at_the_value {
    const e64 : f64 = 2.718281828459045;
    const e32 : f32 = 2.7182817;
    const one64 : f64 = 1.0;
    assert(within64(log64(e64), 1.0));
    assert(log64(one64) == 0.0);
    assert(within32(log32(e32), 1.0));
}

test log_is_the_inverse_of_exp_on_a_typed_value {
    const x : f64 = 0.75;
    assert(within64(log64(exp64(x)), x));
}

test floor_ceil_and_round_of_a_typed_value {
    const a : f32 = 2.75;
    const b : f32 = -2.75;
    const c : f64 = 3.5;
    assert(floor32(a) == 2.0);
    assert(round32(a) == 3.0);
    assert(ceil64(c) == 4.0);
    assert(floor32(b) == -3.0);
    assert(round32(b) == -3.0);
}

test min_and_max_of_two_typed_values {
    const a : f32 = 1.5;
    const b : f32 = 2.5;
    const c : f64 = -1.0;
    const d : f64 = 4.0;
    assert(smaller(a, b) == a);
    assert(smaller(b, a) == a);
    // A `fn max` is declared above, so the reference calls it: the rewrite is only for an undeclared name.
    assert(larger(c, d) == 99.0);
    assert(larger(d, c) == 99.0);
}
