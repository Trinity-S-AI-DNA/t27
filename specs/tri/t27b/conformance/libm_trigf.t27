// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/libm_trigf.t27 -- `@sin` and `@cos` of an f32 against specs/tri/t27b/libm.t27's
; ports of compiler_rt `sinf` and `cosf` (gHashTag/t27#11788: the ports sat unwired behind the plan's
; REFUSE_NO_F32, and rem_pio2f's large branch still passed pointers to the ported rem_pio2_large -- the
; file refused to lower until glass_window.t27 pulled it in). Every test here passes `t27c test-report`;
; t27b must give the same verdict on each, or refuse the file.
; Under the reference each sweep holds a port (`use tri::t27b::libm;` brings it in) to Zig's builtin, bit
; for bit: `t27c test-report` runs `zig test` without libc, so a run-time `@sin` of an f32 is a call of
; compiler_rt `sinf`. Under t27b the builtin is a call of the same port under t27b's reserved name, so the
; sweeps hold t27b's run of the port to itself, and the fixed bits below hold it to the reference's.
; The bits are compared, not the values, so a signed zero counts. sin and cos of an infinity or a NaN are
; NaNs whose payloads are the platform's, so those are held to "is a NaN" per side, not to bits.
; The fixed bits were extracted from this repository's own reference (zig 0.16, `zig test` on the generated
; module, the assert_eq prelude printing the found word) on 2026-10-23, the same machine class the corpus
; seals run on.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceLibmTrigf;

use tri::t27b::libm;

// The bits where a port and its builtin differ: 0 for `@sin`, 1 for `@cos`.
fn tf_one(op: u32, x: f32) -> u32 {
    if (op == 0) { return bits_of_f32(t27b_libm_sinf(x)) ^ bits_of_f32(@sin(x)); }
    return bits_of_f32(t27b_libm_cosf(x)) ^ bits_of_f32(@cos(x));
}

// Points of the bit patterns start, start + step, .. (n of them) where a port and its builtin differ, over
// the two builtins.
fn tf_misses(start: u32, step: u32, n: u32) -> u32 {
    var misses: u32 = 0;
    var b: u32 = start;
    var i: u32 = 0;
    while (i < n) {
        const x: f32 = f32_of(b);
        var op: u32 = 0;
        while (op < 2) {
            if (tf_one(op, x) != 0) {
                misses = misses + 1;
            }
            op = op + 1;
        }
        b = b + step;
        i = i + 1;
    }
    return misses;
}

fn sinf_of(x: f32) -> f32 {
    return @sin(x);
}

fn cosf_of(x: f32) -> f32 {
    return @cos(x);
}

test trigf_family_agrees_with_zig_on_every_exponent {
    // Both signs, every exponent. Rem_pio2f's medium band and its large branch both sit in here.
    assert(tf_misses(0x00000001, 716851, 3000) == 0);
    assert(tf_misses(0x80000001, 716851, 2990) == 0);
}

test trigf_family_agrees_near_one_and_across_the_kernel_bands {
    // 0.5 .. 2 across the pi/4 bands of sindf/cosdf, then rem_pio2f's large branch past 2^28*(pi/2).
    assert(tf_misses(0x3F000000, 5591, 3000) == 0);
    assert(tf_misses(0x4DC90FDB, 28785, 300) == 0);
}

test trigf_family_gives_the_reference_bits {
    // Extracted from the reference on 2026-10-23 (see the header). None is correctly rounded: sin(0.7)
    // is half an ulp from the nearest.
    assert(bits_of_f32(sinf_of(0.7)) == 0x3F24EB73);
    assert(bits_of_f32(cosf_of(0.7)) == 0x3F43CCB3);
    assert(bits_of_f32(sinf_of(7.0)) == 0x3F283046);
    assert(bits_of_f32(cosf_of(100.0)) == 0x3F5CC0EE);
    // rem_pio2f's large branch (|x| >= 2^28*(pi/2), ~4.2e8)
    assert(bits_of_f32(sinf_of(4.2e8)) == 0x3F14A3E6);
    assert(bits_of_f32(sinf_of(1.0e9)) == 0x3F0BBC65);
    assert(bits_of_f32(cosf_of(1.0e9)) == 0x3F567FC6);
    assert(bits_of_f32(sinf_of(-1.0e9)) == 0xBF0BBC65);
    assert(bits_of_f32(cosf_of(-1.0e9)) == 0x3F567FC6);
    assert(bits_of_f32(sinf_of(3.0e38)) == 0x3F5FF9C4);
    assert(bits_of_f32(cosf_of(3.0e38)) == 0xBEF7F57C);
}

test trigf_family_at_zero_and_signed_zero {
    // sin(+-0) is +-0, cos(+-0) is 1 -- the one place a sign shows in the bits
    assert(bits_of_f32(t27b_libm_sinf(f32_of(0x00000000))) == 0x00000000);
    assert(bits_of_f32(t27b_libm_sinf(f32_of(0x80000000))) == 0x80000000);
    assert(bits_of_f32(t27b_libm_cosf(f32_of(0x00000000))) == 0x3F800000);
    assert(bits_of_f32(t27b_libm_cosf(f32_of(0x80000000))) == 0x3F800000);
    assert(tf_one(0, f32_of(0x00000000)) == 0);
    assert(tf_one(1, f32_of(0x80000000)) == 0);
}

test trigf_family_at_infinity_and_nan_is_a_nan {
    // The payloads are the platform's; each side is held to "is a NaN" on its own
    const a: f32 = t27b_libm_sinf(f32_of(0x7F800000));
    assert(a != a);
    const b: f32 = t27b_libm_cosf(f32_of(0xFF800000));
    assert(b != b);
    const c: f32 = sinf_of(f32_of(0x7FC00123));
    assert(c != c);
    const d: f32 = cosf_of(f32_of(0x7F800001));
    assert(d != d);
}
