// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/array_const_index.t27 -- module-level fixed-size array constants and indexing with i32
; Tests the constructs that t27b currently rejects:
; 1. Module-level [N]T constants used as values
; 2. Indexing [N]T arrays with i32 arguments (not just usize)
; Every test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceArrayConstIndex;

pub const NAMES : [5]str = ["Alice", "Bob", "Carol", "David", "Eve"];
pub const VALUES : [3]u16 = [10, 20, 30];
pub const SCORES : [4]i32 = [100, 200, 300, 400];

/// Get a name by index with i32 parameter
fn get_name(index: i32) -> str {
    return NAMES[index];
}

/// Get a value by index with i32 parameter  
fn get_value(index: i32) -> u16 {
    return VALUES[index];
}

/// Get a score by index with i32 parameter
fn get_score(index: i32) -> i32 {
    return SCORES[index];
}

/// Test in-range indexing with positive i32
test in_range_positive_index {
    assert(get_name(0) == "Alice");
    assert(get_name(2) == "Carol");
    assert(get_name(4) == "Eve");
    assert(get_value(1) == 20);
    assert(get_score(3) == 400);
}

/// Test in-range indexing with negative i32 (should work for valid negative indices)
test in_range_negative_index {
    assert(get_name(-1) == "Eve");  // Last element
    assert(get_name(-3) == "Carol");  // Third from last
    assert(get_value(-1) == 30);  // Last element
    assert(get_score(-2) == 300);  // Second from last
}

/// Test out-of-range positive index (should trap)
test out_of_range_positive_index {
    // This should trap - index 5 is out of bounds for array of length 5
    const result = get_name(5);
}

/// Test out-of-range negative index (should trap)  
test out_of_range_negative_index {
    // This should trap - index -6 is out of bounds for array of length 5
    const result = get_name(-6);
}

/// Test zero index
test zero_index {
    assert(get_name(0) == "Alice");
    assert(get_value(0) == 10);
    assert(get_score(0) == 100);
}

/// Test array length property
test array_length {
    assert(NAMES.len == 5);
    assert(VALUES.len == 3);
    assert(SCORES.len == 4);
}