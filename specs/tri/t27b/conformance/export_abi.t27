// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/export_abi.t27 -- which signatures `t27b build` actually exports, and so the only
; doorway an importer written in `.t27` can use to be called from the compiler's Rust side (gHashTag/t27#8972).
; The rule is REFUSED_NOTE in specs/tri/t27b/elf.t27: a fn that takes or returns a struct, a str, a slice, an
; array or an optional, or takes more than 8 parameters, is not exported. An enum and scalars are exported.
; The point of the file: the importer contract in specs/tri/t27b/ir_importer.t27 passes structs and an optional
; in its signatures, so NONE of its five mapping fns reached the object. A scalar doorway does reach it.
; Measured 2026-10-31, arm64 macOS, t27b 0.16.0 tree build:
;   t27b build specs/tri/t27b/conformance/export_abi.t27 -o ea.o
;     -> one note, for `ea_pair_sum` (#8972); exit 0
;   nm ea.o | grep " T "         -> _ea_door, _ea_format_bit
;   object 536 bytes; build real 0.01 s, 0.00 s, 0.00 s over three runs
; A C caller linked against that object and ran it:
;   ea_door(100, 20, 3, Mir) == 124, ea_door(7, 0, 0, Zir) == 9, ea_format_bit(LlvmIr) == 0
; so the doorway is not a symbol that merely exists: three words and an enum cross it, one word comes back.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceExportAbi;

/// The format tag an importer is told to read: an enum, which the backend does export.
pub const EaFormat = enum(u32) {
    LlvmIr = 0,
    Mir = 1,
    Zir = 2,
};

/// Two words. The backend refuses a fn that takes this, so it is never the doorway.
pub const EaPair = struct {
    lo: u64,
    hi: u64,
};

/// Scalars and an enum only: the doorway an importer needs. Buffer, length, output and the format, one word back.
pub fn ea_door(buf: usize, len: usize, out: usize, fmt: EaFormat) -> u64 {
    return (buf + len + out + ea_format_bit(fmt)) as u64;
}

/// An enum in and a scalar out: the control, exported before this file existed.
pub fn ea_format_bit(fmt: EaFormat) -> u64 {
    return @intFromEnum(fmt) as u64;
}

/// A struct parameter: the case #8972 refuses, kept so the test suite records it rather than memory.
pub fn ea_pair_sum(p: EaPair) -> u64 {
    return p.lo + p.hi;
}

test the_door_keeps_every_word {
    assert_eq(ea_door(1, 2, 4, EaFormat.LlvmIr), 7);
    assert_eq(ea_door(10, 20, 40, EaFormat.Mir), 71);
    assert_eq(ea_format_bit(EaFormat.Zir), 2);
}

test a_struct_crosses_the_door_only_inside_the_module {
    const p: EaPair = EaPair { lo: 3, hi: 4 };
    assert_eq(ea_pair_sum(p), 7);
    assert_eq(p.lo + 1, 4);
}
