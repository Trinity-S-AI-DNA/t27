// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/rem_int.t27 -- `@rem` of two integers, as the reference runs it (gHashTag/t27#8627,
; t27b coverage epic #6063: ExprCall(@rem) in specs/math/constants.t27). Every test here passes
; `t27c test-report`; t27b must give the same verdict on each, or refuse the file. gen-zig prints `@rem` as written.
; - `@rem(a, b)` is the truncated remainder: the sign of the dividend, and `@divTrunc(a, b) * b + @rem(a, b) == a`,
;   of signed and unsigned operands, with a literal beside a typed integer taking that integer's type.
; - `@mod(a, b)` is the floored remainder (#10405): the sign of the divisor, so 0 <= @mod(a, b) < b, of an
;   i64 (a call of specs/tri/t27b/libm.t27's `t27b_libm_mod`) and of an unsigned integer (`%`), with
;   specs/t27f/reel_particles.t27's `lcg` as written. A narrower signed `@mod` (#10423: i32, i16, i8, i7) widens to
;   that i64 routine and narrows back, as specs/tri/t27b/libm_plan.t27 says; its extremes are here, and
;   reel_particles_mux's `millis` and arena_heap's power-of-two test as written.
; Not here (it fails the test, so no passing spec can hold it): a run-time zero divisor, or `@mod`'s negative one,
; which is a safety panic in Zig and a DivZero trap (a panic for `@mod`) in t27b
; (specs/tri/t27b/libm_plan.t27 lowers `@rem` as t27b's `%`).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceRemInt;

fn ri_rem(a: i32, b: i32) -> i32 {
    return @rem(a, b);
}

fn ri_rem2(a: i64) -> i64 {
    return @rem(a, 2);
}

fn ri_urem(a: u32, b: u32) -> u32 {
    return @rem(a, b);
}

fn ri_rem_byte(a: i8, b: i8) -> i8 {
    return @rem(a, b);
}

test rem_takes_the_sign_of_the_dividend {
    assert ri_rem(7, 3) == 1;
    assert ri_rem(-7, 3) == -1;
    assert ri_rem(7, -3) == 1;
    assert ri_rem(-7, -3) == -1;
    assert ri_rem(6, 3) == 0;
    assert ri_rem(-6, 3) == 0;
    assert ri_rem(2, 5) == 2;
    assert ri_rem(-2, 5) == -2;
}

test rem_and_div_trunc_rebuild_the_dividend {
    var a : i32 = -17;
    while (a <= 17) {
        assert @divTrunc(a, 5) * 5 + ri_rem(a, 5) == a;
        assert @divTrunc(a, -4) * (0 - 4) + ri_rem(a, -4) == a;
        a = a + 1;
    }
}

test a_literal_divisor_takes_the_dividend_s_type {
    assert ri_rem2(5) == 1;
    assert ri_rem2(-5) == -1;
    assert ri_rem2(4) == 0;
    assert ri_rem2(9223372036854775807) == 1;
}

test unsigned_and_narrow_operands {
    assert ri_urem(4000000000, 7) == 3;
    assert ri_urem(5, 9) == 5;
    assert ri_rem_byte(-128, 3) == -2;
    assert ri_rem_byte(127, -10) == 7;
}

fn ri_mod(a: i64, b: i64) -> i64 {
    return @mod(a, b);
}

fn ri_umod(a: u32, b: u32) -> u32 {
    return @mod(a, b);
}

// specs/t27f/reel_particles.t27's `lcg`, as written.
fn ri_lcg(seed: i64) -> i64 {
    return @mod(seed * 1103515245 + 12345, 2147483648);
}

test mod_takes_the_sign_of_the_divisor {
    assert ri_mod(7, 3) == 1;
    assert ri_mod(-7, 3) == 2;
    assert ri_mod(-6, 3) == 0;
    assert ri_mod(6, 3) == 0;
    assert ri_mod(2, 5) == 2;
    assert ri_mod(-2, 5) == 3;
    assert ri_mod(0, 7) == 0;
    assert ri_mod(-1, 2147483648) == 2147483647;
    assert ri_mod(-2147483649, 2147483648) == 2147483647;
    assert ri_mod(9223372036854775807, 2) == 1;
    assert ri_mod(-9223372036854775807, 2) == 1;
    var a : i64 = -23;
    while (a <= 23) {
        const m : i64 = ri_mod(a, 6);
        assert m >= 0;
        assert m < 6;
        assert @rem(a - m, 6) == 0;
        a = a + 1;
    }
}

test mod_of_unsigned_and_the_lcg {
    assert ri_umod(4000000000, 7) == 3;
    assert ri_umod(5, 9) == 5;
    assert ri_lcg(0) == 12345;
    assert ri_lcg(1) == 1103527590;
    assert ri_lcg(-1) == 1043980748;
    var s : i64 = 42;
    var i : i64 = 0;
    while (i < 40) {
        s = ri_lcg(s);
        assert s >= 0;
        assert s < 2147483648;
        i = i + 1;
    }
}

fn ri_mod32(a: i32, b: i32) -> i32 {
    return @mod(a, b);
}

fn ri_mod16(a: i16, b: i16) -> i16 {
    return @mod(a, b);
}

fn ri_mod8(a: i8, b: i8) -> i8 {
    return @mod(a, b);
}

fn ri_mod7(a: i7, b: i7) -> i7 {
    return @mod(a, b);
}

// specs/t27f/reel_particles_mux.t27's `millis`, as written.
fn ri_millis(ms: i32) -> u32 {
    return @as(u32, @intCast(@mod(ms, 1000)));
}

// specs/ml/arena_heap.t27's `is_pow2`, as written.
fn ri_is_pow2(n: i32) -> bool {
    if (n < 1) {
        return false;
    }
    var m : i32 = n;
    while (m > 1) {
        if (@mod(m, 2) != 0) {
            return false;
        }
        m = @divTrunc(m, 2);
    }
    return true;
}

test a_narrow_signed_mod_takes_the_sign_of_the_divisor {
    assert ri_mod32(7, 3) == 1;
    assert ri_mod32(-7, 3) == 2;
    assert ri_mod32(-6, 3) == 0;
    assert ri_mod32(0, 7) == 0;
    assert ri_mod32(-1, 2147483647) == 2147483646;
    assert ri_mod32(-2147483648, 2147483647) == 2147483646;
    assert ri_mod32(-2147483648, 3) == 1;
    assert ri_mod32(2147483647, 2) == 1;
    assert ri_mod32(2147483647, 2147483647) == 0;
    assert ri_mod16(-32768, 7) == 6;
    assert ri_mod16(-5, 32767) == 32762;
    assert ri_mod16(32767, 10) == 7;
    assert ri_mod8(-128, 3) == 1;
    assert ri_mod8(-128, 127) == 126;
    assert ri_mod8(127, 10) == 7;
    assert ri_mod8(-1, 127) == 126;
    assert ri_mod7(-64, 5) == 1;
    assert ri_mod7(-1, 63) == 62;
    assert ri_mod7(63, 2) == 1;
    var a : i32 = -23;
    while (a <= 23) {
        const m : i32 = ri_mod32(a, 6);
        assert m >= 0;
        assert m < 6;
        assert @rem(a - m, 6) == 0;
        assert ri_mod32(a, 6) == @as(i32, @intCast(ri_mod(a, 6)));
        a = a + 1;
    }
}

test the_i32_mods_of_the_corpus_as_written {
    assert ri_millis(1234) == 234;
    assert ri_millis(-1) == 999;
    assert ri_millis(-1000) == 0;
    assert ri_millis(0) == 0;
    assert ri_millis(2147483647) == 647;
    assert ri_is_pow2(1);
    assert ri_is_pow2(64);
    assert ri_is_pow2(1073741824);
    assert !ri_is_pow2(0);
    assert !ri_is_pow2(-8);
    assert !ri_is_pow2(96);
    assert !ri_is_pow2(2147483647);
}
