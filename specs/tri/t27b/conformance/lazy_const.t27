// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/lazy_const.t27 -- module constants no test reaches, as the reference runs them (t27o epic
; #10879, #10899 and #10903). Every test here passes `t27c test-report`; t27b must give the same verdict on each, or
; refuse the file. The plan is specs/tri/t27b/lazy_sig_plan.t27 (`const_plan`), the reach is ast_shape.t27's `analyzed`.
; Zig resolves a module-level constant only when something analyzed names it. `LAZY_ALLOWED` is a slice written as
; the array literal t27o writes (catalog_gate.t27's `ALLOWED`; Zig: "type '[][]const u8' does not support array
; initialization syntax" once it is read), `LAZY_BRAM` and `LAZY_CSR` are struct constants initialised by a call
; (addrmap.t27's `REGION_BRAM`; t27b cannot call a fn at compile time), and `LAZY_BOTH` names the second one. Only a
; fn no test calls names a constant, so none of them is analyzed and the file compiles.
; Not here (the reference cannot compile it, or t27b cannot yet): a test that names `LAZY_ALLOWED`, directly or through
; `lazy_allowed_count`, which makes Zig read the slice; a test that names `LAZY_BRAM`, which Zig evaluates at compile
; time and passes, so t27b refuses it by name (`ConstDecl`, a counted remainder: the reached form needs a compile-time
; call); a constant whose type or initializer names something declared nowhere, which AstGen refuses in every file.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceLazyConst;

struct LazyRegion {
    base: u64,
    size: u64,
}

fn lazy_region_new(base: u64, size: u64) -> LazyRegion {
    return LazyRegion{ base: base, size: size };
}

fn lazy_region_end(r: LazyRegion) -> u64 {
    return r.base + r.size;
}

fn lazy_region_overlaps(a: LazyRegion, b: LazyRegion) -> bool {
    return a.base < lazy_region_end(b) and b.base < lazy_region_end(a);
}

pub const LAZY_ALLOWED : [][]const u8 = ["alpha", "beta"];

pub const LAZY_BRAM : LazyRegion = lazy_region_new(0, 0x100000);

pub const LAZY_CSR : LazyRegion = lazy_region_new(0x40000000, 0x1000);

pub const LAZY_BOTH : LazyRegion = LAZY_CSR;

fn lazy_allowed_count() -> usize {
    return LAZY_ALLOWED.len;
}

fn lazy_bram_end() -> u64 {
    return lazy_region_end(LAZY_BRAM);
}

test a_region_ends_where_its_size_runs_out {
    const r = lazy_region_new(0x1000, 0x100);
    assert(lazy_region_end(r) == 0x1100);
}

test overlapping_regions_are_found {
    const a = lazy_region_new(0x1000, 0x100);
    const b = lazy_region_new(0x1050, 0x100);
    const c = lazy_region_new(0x2000, 0x100);
    assert(lazy_region_overlaps(a, b));
    assert(!lazy_region_overlaps(a, c));
}
