// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/verilog_odd_cast.t27 -- a cast into an odd unsigned width (gHashTag/t27#10072).
; t27c's parser refused `x as u3` and `x as u12` until uN, 1 <= N <= 64, was decided in
; specs/compiler/int_type_names.t27. `t27b verilog` lowers a narrowing cast through t27_uW and a widening one
; as a zero fill (verilog_plan.t27, "Widths"); the reference truncates with Zig's @truncate. Each test below
; passes in the reference, in t27b and in the generated test bench:
; - the 8-sample moving average the Build-A-Chip-Bench proxy run needed (epic #10066): u12 samples, a sum
;   formed in 32 bits, and `as u12` back to the sample width;
; - `as u3` keeps the low three bits of a byte, `as u1` the low bit;
; - a cast out of u12 into u16 is a zero fill, and one into u8 keeps the low byte;
; - the same narrowing inside on_clock, in the module.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceVerilogOddCast;

pub fn avg8(a: u12, b: u12, c: u12, d: u12, e: u12, f: u12, g: u12, h: u12) -> u12 {
    return (((a as u32) + (b as u32) + (c as u32) + (d as u32) + (e as u32) + (f as u32) + (g as u32) + (h as u32)) >> 3) as u12;
}

pub fn low3(x: u8) -> u3 {
    return x as u3;
}

pub fn low_bit(x: u8) -> u1 {
    return x as u1;
}

pub fn wide(x: u12) -> u16 {
    return x as u16;
}

pub fn low_byte(x: u12) -> u8 {
    return x as u8;
}

pub var out : u12 = 0;

fn on_clock(x: u16) {
    out = (x >> 2) as u12;
}

test the_average_comes_back_as_u12 {
    assert_eq(avg8(8, 8, 8, 8, 8, 8, 8, 8), 8);
    assert_eq(avg8(4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095), 4095);
    assert_eq(avg8(16, 0, 0, 0, 0, 0, 0, 0), 2);
    assert_eq(avg8(1, 2, 3, 4, 5, 6, 7, 8), 4);
}

test a_narrowing_keeps_the_low_bits {
    assert_eq(low3(13), 5);
    assert_eq(low3(255), 7);
    assert_eq(low3(8), 0);
    assert_eq(low_bit(6), 0);
    assert_eq(low_bit(7), 1);
    assert_eq(low_byte(4095), 255);
    assert_eq(low_byte(300), 44);
}

test a_widening_is_a_zero_fill {
    assert_eq(wide(4095), 4095);
    assert_eq(wide(0), 0);
}

test the_module_narrows_at_its_width {
    out = 0;
    on_clock(65535);
    assert_eq(out, 4095);
    on_clock(400);
    assert_eq(out, 100);
}
