// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/verilog_signed_clock.t27 -- a clocked module with signed ports and registers
; (gHashTag/t27#11326): an `i8` input, two `i16` outputs, a sum that mixes the two widths, a signed compare, an
; arithmetic shift and a negated literal. The test bench drives the module's clock and compares its outputs.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceVerilogSignedClock;

pub var acc : i16 = 0;
pub var low : i16 = 0;
pub var half : i16 = 0;

// Every var is read before it is written, so the test's order and the clock edge agree: the sum is a local.
fn on_clock(d: i8) {
    const s : i16 = acc + d;
    acc = s;
    if (s < 0) {
        low = s;
    }
    half = s >> 1;
}

test the_accumulator_keeps_its_sign {
    on_clock(5);
    assert_eq(acc, 5);
    assert_eq(low, 0);
    on_clock(-8);
    assert_eq(acc, -3);
    assert_eq(low, -3);
    assert_eq(half, -2);
    on_clock(100);
    assert_eq(acc, 97);
    assert_eq(low, -3);
    assert_eq(half, 48);
}

test a_sum_past_the_range_of_the_input_stays_in_sixteen_bits {
    on_clock(127);
    on_clock(127);
    on_clock(127);
    assert_eq(acc, 381);
    on_clock(-128);
    on_clock(-128);
    on_clock(-128);
    on_clock(-128);
    assert_eq(acc, -131);
    assert_eq(low, -131);
    assert_eq(half, -66);
}
