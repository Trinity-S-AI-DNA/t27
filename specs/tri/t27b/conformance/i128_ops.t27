// SPDX-License-Identifier: Apache-2.0
; i128_ops.t27 -- conformance spec for t27b (epic #6063, stage 3 of #7915's run-time i128, #8913)
; What specs/tri/t27b/eval_arith.t27 asks of an i128 at run time, and the edges around it: parameters in
; AAPCS64 register pairs (the next even pair, a register skipped after an odd count, four pairs filling x0 to
; x7, a leaf and a caller), a struct field of 16 bytes built in a literal, returned by value, passed by
; reference and assigned, `+%`, `-%` and `*%` at both ends, `@rem` with operands of each sign (minInt % -1 is
; 0), `&`, `|` and `^`, `<<` and `>>` by a run-time amount below 64, at 64 and above it, a constant amount, a
; checked cast to u32 and to u64, and literals of 2^63 and 2^64 - 1 as arguments. Every test passes `t27c
; test-report`; t27b must give the same verdict on each, interpreter and JIT alike, or refuse the file. The
; traps (a zero divisor of `@rem`, a shift amount of 128 or more, a cast out of range) fail a test by design,
; so they are in cli/t27b/tests/i128_traps.t27.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceI128Ops;

pub const I128_MAX : i128 = 170141183460469231731687303715884105727;
pub const I128_MIN : i128 = 0 - 170141183460469231731687303715884105727 - 1;
pub const TWO_64 : i128 = 18446744073709551616;
pub const U64_MAX : i128 = 18446744073709551615;

/// A byte, then an i128 at offset 16: 32 bytes, aligned to 16.
pub const IoBox = struct {
    tag : u8,
    v : i128,
};

/// Four pairs: x0:x1, x2:x3, x4:x5 and x6:x7. A leaf.
fn io_four(a: i128, b: i128, c: i128, d: i128) -> i128 {
    return a - b + c - d;
}

/// A byte in x0, then x in x2:x3 (x1 skipped), n in x4, y in x6:x7 (x5 skipped).
fn io_mix(k: u8, x: i128, n: u32, y: i128) -> i128 {
    const wk : i128 = @intCast(k);
    const wn : i128 = @intCast(n);
    return x * wk + y * wn;
}

/// Three scalars in x0 to x2, then x in x4:x5 (x3 skipped); it calls, so its pair is saved in its frame.
fn io_after_three(a: u32, b: u32, c: u32, x: i128) -> i128 {
    const s : i128 = @intCast(a + b + c);
    return io_four(x, s, x, s) +% io_mix(1, x, 0, s);
}

/// The sum 1 + 2 + .. + n onto acc, recursively: a pair passed down and returned up.
fn io_sum_to(n: u32, acc: i128) -> i128 {
    if (n == 0) { return acc; }
    const w : i128 = @intCast(n);
    return io_sum_to(n - 1, acc + w);
}

fn io_box(tag: u8, v: i128) -> IoBox {
    return IoBox{ .tag = tag, .v = v };
}

/// A struct passed by reference: its field loaded with one ldp.
fn io_field(b: IoBox) -> i128 {
    return b.v;
}

fn io_add_w(a: i128, b: i128) -> i128 {
    return a +% b;
}

fn io_sub_w(a: i128, b: i128) -> i128 {
    return a -% b;
}

fn io_mul_w(a: i128, b: i128) -> i128 {
    return a *% b;
}

fn io_rem(a: i128, b: i128) -> i128 {
    return @rem(a, b);
}

fn io_and(a: i128, b: i128) -> i128 {
    return a & b;
}

fn io_or(a: i128, b: i128) -> i128 {
    return a | b;
}

fn io_xor(a: i128, b: i128) -> i128 {
    return a ^ b;
}

fn io_shl(a: i128, n: u32) -> i128 {
    return a << n;
}

fn io_shr(a: i128, n: u32) -> i128 {
    return a >> n;
}

/// A constant amount: Zig checks it at compile time, t27b's wrapping shift takes it as it is.
fn io_shl_three(a: i128) -> i128 {
    return a << 3;
}

fn io_low(a: i128) -> u32 {
    return a as u32;
}

fn io_word(a: i128) -> u64 {
    return a as u64;
}

test parameters_take_the_next_even_pair {
    assert(io_four(10, 3, TWO_64, 1) == TWO_64 + 6);
    assert(io_four(I128_MAX, 1, I128_MIN, 0 - 1) == 0 - 1);
    assert(io_mix(3, TWO_64, 2, 0 - 5) == 55340232221128654838);
    assert(io_mix(0, I128_MAX, 1, I128_MIN) == I128_MIN);
    assert(io_after_three(1, 2, 3, TWO_64) == 55340232221128654836);
    assert(io_sum_to(100, 0) == 5050);
    assert(io_sum_to(10, I128_MAX - 55) == I128_MAX);
}

test literals_of_two_to_the_63_and_two_to_the_64_minus_one_are_arguments {
    assert(io_add_w(9223372036854775808, 9223372036854775808) == TWO_64);
    assert(io_add_w(18446744073709551615, 1) == TWO_64);
    assert(io_sub_w(18446744073709551615, 9223372036854775808) == 9223372036854775807);
    assert(io_shl(9223372036854775808, 1) == TWO_64);
    assert(io_word(18446744073709551615) == 18446744073709551615);
}

test a_struct_field_is_sixteen_bytes {
    const b : IoBox = io_box(7, I128_MIN);
    assert(b.tag == 7);
    assert(b.v == I128_MIN);
    assert(io_field(b) == I128_MIN);
    var c : IoBox = io_box(9, 0 - 52);
    c.v = c.v -% 1;
    assert(c.v == 0 - 53);
    c.v = I128_MAX;
    assert(io_field(c) + 0 == I128_MAX);
    assert(c.tag == 9);
}

test wrapping_add_sub_mul_at_both_ends {
    assert(io_add_w(I128_MAX, 1) == I128_MIN);
    assert(io_add_w(I128_MIN, 0 - 1) == I128_MAX);
    assert(io_sub_w(I128_MIN, 1) == I128_MAX);
    assert(io_sub_w(0, I128_MIN) == I128_MIN);
    assert(io_mul_w(U64_MAX, U64_MAX) == 0 - 36893488147419103231);
    assert(io_mul_w(TWO_64, TWO_64) == 0);
    assert(io_mul_w(I128_MIN, 0 - 1) == I128_MIN);
    assert(io_mul_w(0 - 3, 7) == 0 - 21);
    assert(io_mul_w(I128_MAX, I128_MAX) == 1);
}

test the_remainder_takes_the_dividends_sign {
    assert(io_rem(7, 2) == 1);
    assert(io_rem(0 - 7, 2) == 0 - 1);
    assert(io_rem(7, 0 - 2) == 1);
    assert(io_rem(0 - 7, 0 - 2) == 0 - 1);
    assert(io_rem(I128_MIN, 0 - 1) == 0);
    assert(io_rem(I128_MIN, 3) == 0 - 2);
    assert(io_rem(I128_MAX, 10) == 7);
    assert(io_rem(I128_MAX, TWO_64) == U64_MAX);
    assert(io_rem(I128_MAX, U64_MAX) == 9223372036854775807);
}

test bitwise_operators_act_on_both_words {
    assert(io_and(0 - 1, TWO_64) == TWO_64);
    assert(io_and(I128_MIN, I128_MAX) == 0);
    assert(io_or(TWO_64, 9223372036854775808) == 27670116110564327424);
    assert(io_xor(0 - 1, I128_MAX) == I128_MIN);
    assert(io_xor(TWO_64 + 5, 5) == TWO_64);
}

test shifts_below_at_and_past_sixty_four {
    assert(io_shl(1, 0) == 1);
    assert(io_shl(1, 63) == 9223372036854775808);
    assert(io_shl(1, 64) == TWO_64);
    assert(io_shl(3, 127) == I128_MIN);
    assert(io_shl(U64_MAX, 64) == 0 - TWO_64);
    assert(io_shl(0 - 1, 100) == 0 - 1267650600228229401496703205376);
    assert(io_shr(0 - 7, 1) == 0 - 4);
    assert(io_shr(I128_MIN, 127) == 0 - 1);
    assert(io_shr(I128_MAX, 64) == 9223372036854775807);
    assert(io_shr(TWO_64 + 1, 1) == 9223372036854775808);
    assert(io_shr(I128_MIN, 65) == 0 - 4611686018427387904);
    assert(io_shr(1, 127) == 0);
    assert(io_shl_three(TWO_64) == 147573952589676412928);
}

test a_checked_cast_keeps_the_value {
    assert(io_low(4294967295) == 4294967295);
    assert(io_low(0) == 0);
    assert(io_word(U64_MAX) == 18446744073709551615);
    assert(io_word(TWO_64 - 2) == 18446744073709551614);
}
