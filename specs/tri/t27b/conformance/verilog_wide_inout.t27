// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/verilog_wide_inout.t27 -- the shape of the LiteDRAM core for `t27b verilog`
; (gHashTag/t27#10170, option A): an extern whose data ports are 256 bits wide and whose DDR3 data bus is a pin
; the module passes through. The emitter's widths stop at 64 (verilog_plan.t27's MAX_WIDTH), and it had no inout
; port, so no top around the core could be written in t27 at all.
; The source form (specs/tri/t27b/verilog_plan.t27):
; - a LANE SET: extern parameters wdata__0 .. wdata__3 of one type, adjacent and numbered from 0, are ONE port
;   `.wdata({wdata__3, wdata__2, wdata__1, wdata__0})`, lane 0 in the low bits; result fields rdata__0 ..
;   rdata__3 likewise, each lane its own wire core__rdata__N;
; - an INOUT: a `pub const` whose value is `undefined` is an `inout wire` port of the module, and may only be
;   handed by name to an instance's port of its own type;
; - on_clock's parameter `core_rdata__2` is the instance core's output rdata__2, not a port.
; The 256 and the 32 are LiteDRAM's native port and the AX7203's DDR3 bus (2x MT41J256M16).
; The reference never calls the extern: Zig analyses a declaration only when a test reaches it, so the tests
; below drive on_clock with the lanes the core would give.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceVerilogWideInout;

/// The outputs of the core this design reads: four 64-bit lanes of read data and a ready.
pub struct WideCoreOut { rdata__0: u64, rdata__1: u64, rdata__2: u64, rdata__3: u64, ready: bool }

/// A core with a 256-bit write port (four lanes), a 32-bit bidirectional data bus and a write enable.
pub fn WIDE_CORE(DATA_WIDTH: comptime_int, dq: u32, wdata__0: u64, wdata__1: u64, wdata__2: u64, wdata__3: u64, we: bool) -> WideCoreOut {}

/// The DDR3 data bus: a pin of this module, passed through to the core.
pub const ddr3_dq : u32 = undefined;

pub var beat : u64 = 0;
pub var sum : u64 = 0;

const core : WideCoreOut = WIDE_CORE(256, ddr3_dq, beat, beat + 1, beat + 2, beat + 3, true);

// Every var is read before it is written, so the test's order and the clock edge agree.
fn on_clock(core_rdata__0: u64, core_rdata__1: u64, core_rdata__2: u64, core_rdata__3: u64, core_ready: bool) {
    if (core_ready) { sum = sum ^ core_rdata__0 ^ core_rdata__1 ^ core_rdata__2 ^ core_rdata__3; }
    beat = beat + 4;
}

test a_ready_beat_folds_all_four_lanes {
    beat = 0;
    sum = 0;
    on_clock(1, 2, 4, 8, true);
    assert_eq(sum, 15);
    assert_eq(beat, 4);
}

test a_beat_that_is_not_ready_folds_nothing {
    beat = 8;
    sum = 5;
    on_clock(1, 2, 4, 8, false);
    assert_eq(sum, 5);
    assert_eq(beat, 12);
}

test each_lane_lands_in_the_sum_once {
    sum = 0;
    on_clock(256, 0, 0, 0, true);
    on_clock(0, 0, 0, 256, true);
    assert_eq(sum, 0);
    on_clock(0, 0, 65536, 0, true);
    assert_eq(sum, 65536);
}
