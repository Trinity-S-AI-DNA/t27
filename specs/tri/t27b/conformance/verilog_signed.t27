// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/verilog_signed.t27 -- `t27b verilog` lowers signed integers, constant tables, constant
; division, shifts and casts bit-exactly (gHashTag/t27#11326). The cockpit's petal menu hit test is the reason:
; it runs on i64 milli-units, reads two 108-entry coordinate tables and divides by constants. Each test runs
; natively (`t27b test`) and in the generated test bench (`iverilog -g2012 -DT27B_TESTBENCH`); the two agree on
; every assert, and the sweeps compare a division by a constant (a multiply-shift in Verilog) with the same
; division by a parameter (Verilog's own `/`), over every operand of the width:
; - a signed compare, a negation, an unsigned operand that meets a wider signed one;
; - an arithmetic shift right;
; - a widening @as that fills with the sign, one that fills with zeros, a narrowing one;
; - / and % by 9, 4 and 1000 on i32 (truncating toward zero) and u16, by a constant of 20 bits on i64;
; - a table read, with a negative element, and a loop over a table;
; - a library of pure fns: every pub fn is also a module of its own.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceVerilogSigned;

pub const TAB : [6]i16 = [100, 200, 300, 400, 500, 600];
pub const SK : [4]i8 = [-3, 0, 5, -128];
pub const BIG : i64 = 596000;

pub fn neg(x: i32) -> i32 {
    return 0 - x;
}

pub fn neg8(x: i8) -> i8 {
    return 0 - x;
}

pub fn lt(a: i32, b: i32) -> bool {
    return a < b;
}

pub fn lt_mixed(a: i32, b: u8) -> bool {
    return a < b;
}

pub fn sar(a: i32, k: u32) -> i32 {
    return a >> k;
}

pub fn widen_signed(a: i8) -> i32 {
    return @as(i32, a);
}

pub fn widen_unsigned(a: u8) -> i32 {
    return @as(i32, a);
}

pub fn narrow(a: i32) -> i8 {
    return @as(i8, @intCast(a));
}

pub fn div9(a: i32) -> i32 {
    return a / 9;
}

pub fn rem9(a: i32) -> i32 {
    return a % 9;
}

pub fn div4(a: i32) -> i32 {
    return a / 4;
}

pub fn rem4(a: i32) -> i32 {
    return a % 4;
}

pub fn div_by(a: i32, d: i32) -> i32 {
    return a / d;
}

pub fn rem_by(a: i32, d: i32) -> i32 {
    return a % d;
}

pub fn udiv9(a: u16) -> u16 {
    return a / 9;
}

pub fn urem9(a: u16) -> u16 {
    return a % 9;
}

pub fn udiv1000(a: u16) -> u16 {
    return a / 1000;
}

pub fn urem8(a: u16) -> u16 {
    return a % 8;
}

pub fn udiv_by(a: u16, d: u16) -> u16 {
    return a / d;
}

pub fn urem_by(a: u16, d: u16) -> u16 {
    return a % d;
}

pub fn scaled(a: i64) -> i64 {
    return a * 1000000 / BIG;
}

pub fn scaled_by(a: i64, d: i64) -> i64 {
    return a * 1000000 / d;
}

pub fn tab_at(i: u32) -> i16 {
    return TAB[i];
}

pub fn sk_at(i: u32) -> i8 {
    return SK[i];
}

pub fn tab_sum() -> i32 {
    var s : i32 = 0;
    var k : u32 = 0;
    while (k < 6) {
        s = s + TAB[k];
        k = k + 1;
    }
    return s;
}

test a_signed_compare_sees_the_sign {
    const m5 : i32 = neg(5);
    assert m5 < 0;
    assert lt(m5, 2);
    assert !lt(2, m5);
    assert lt(neg(7), neg(3));
    assert lt_mixed(m5, 0);
    assert !lt_mixed(3, 3);
    assert lt_mixed(3, 200);
    assert neg8(100) < 0;
    assert_eq(neg8(neg8(100)), 100);
}

test a_signed_shift_right_keeps_the_sign {
    assert_eq(sar(neg(8), 1), neg(4));
    assert_eq(sar(neg(1), 31), neg(1));
    assert_eq(sar(100, 3), 12);
    assert_eq(sar(neg(9), 1), neg(5));
}

test a_widening_cast_fills_with_the_sign_or_with_zeros {
    assert_eq(widen_signed(neg8(5)), neg(5));
    assert_eq(widen_signed(127), 127);
    assert_eq(widen_unsigned(200), 200);
    assert_eq(widen_unsigned(255), 255);
    assert_eq(narrow(neg(5)), neg8(5));
    assert_eq(narrow(127), 127);
}

test division_by_a_constant_truncates_toward_zero {
    assert_eq(div9(17), 1);
    assert_eq(rem9(17), 8);
    assert_eq(div9(neg(17)), neg(1));
    assert_eq(rem9(neg(17)), neg(8));
    assert_eq(div4(neg(17)), neg(4));
    assert_eq(rem4(neg(17)), neg(1));
    assert_eq(div4(17), 4);
    assert_eq(rem4(17), 1);
    const lowest : i32 = neg(2147483647) - 1;
    assert_eq(div9(lowest), neg(238609294));
    assert_eq(rem9(lowest), neg(2));
    assert_eq(div4(lowest), neg(536870912));
    assert_eq(rem4(lowest), 0);
    assert_eq(div9(2147483647), 238609294);
    assert_eq(rem9(2147483647), 1);
}

test every_16_bit_unsigned_divides_as_by_a_parameter {
    var x : u32 = 0;
    var bad : u32 = 0;
    while (x < 65536) {
        const a : u16 = @as(u16, @intCast(x));
        if (udiv9(a) != udiv_by(a, 9)) { bad = bad + 1; }
        if (urem9(a) != urem_by(a, 9)) { bad = bad + 1; }
        if (udiv1000(a) != udiv_by(a, 1000)) { bad = bad + 1; }
        if (urem8(a) != urem_by(a, 8)) { bad = bad + 1; }
        x = x + 1;
    }
    assert bad == 0;
}

test every_16_bit_signed_divides_as_by_a_parameter {
    var x : i32 = 0;
    var bad : u32 = 0;
    while (x < 65536) {
        const a : i32 = x - 32768;
        if (div9(a) != div_by(a, 9)) { bad = bad + 1; }
        if (rem9(a) != rem_by(a, 9)) { bad = bad + 1; }
        if (div4(a) != div_by(a, 4)) { bad = bad + 1; }
        if (rem4(a) != rem_by(a, 4)) { bad = bad + 1; }
        x = x + 1;
    }
    assert bad == 0;
}

test a_64_bit_scale_by_a_20_bit_constant_is_the_division {
    assert_eq(scaled(596000), 1000000);
    assert_eq(scaled(1), 1);
    assert_eq(scaled(neg64(596000)), neg64(1000000));
    assert_eq(scaled(123456789), scaled_by(123456789, 596000));
    assert_eq(scaled(neg64(987654321)), scaled_by(neg64(987654321), 596000));
    assert_eq(scaled(9000000000), scaled_by(9000000000, 596000));
}

pub fn neg64(x: i64) -> i64 {
    return 0 - x;
}

test a_table_is_read_by_index_and_by_loop {
    assert_eq(tab_at(0), 100);
    assert_eq(tab_at(5), 600);
    assert_eq(tab_sum(), 2100);
    assert_eq(sk_at(0), neg8(3));
    assert_eq(sk_at(1), 0);
    assert_eq(sk_at(2), 5);
    assert_eq(sk_at(3), neg8(127) - 1);
}
