// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/verilog_pin_attrs.t27 -- pin attributes for `t27b verilog` (gHashTag/t27#10170):
; a board top names the package pin and I/O standard of each port in its own spec, and t27b writes them as
; Verilog attributes on the port, which yosys keeps and nextpnr-xilinx reads. No constraint file is written
; by hand.
; The source form (specs/tri/t27b/verilog_plan.t27, PIN ATTRIBUTE): a const whose value is a string literal
; and whose name is a port's name, `_`, then LOC, IOSTANDARD, SLEW or IN_TERM. Here each kind of port carries
; one: the implicit clk, an on_clock parameter (btn), and a pub var (led).
; The pins are an example, not a board's pinout.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceVerilogPinAttrs;

const rst_n : bool = true;
const en : bool = true;

const clk_LOC : str = "R4";
const clk_IOSTANDARD : str = "LVCMOS33";
const btn_LOC : str = "J21";
const btn_IOSTANDARD : str = "LVCMOS33";
const led_LOC : str = "B13";
const led_IOSTANDARD : str = "LVCMOS33";
const led_SLEW : str = "SLOW";

pub var led : bool = false;
var presses : u8 = 0;

// Every var is read before it is written, so the test's order and the clock edge agree.
fn on_clock(btn: bool) {
    if (btn) {
        presses = presses + 1;
        led = !led;
    }
}

test a_press_toggles_the_led {
    led = false;
    presses = 0;
    on_clock(true);
    assert led;
    assert_eq(presses, 1);
}

test no_press_leaves_the_led {
    led = true;
    presses = 3;
    on_clock(false);
    assert led;
    assert_eq(presses, 3);
}

test two_presses_bring_the_led_back {
    led = false;
    presses = 0;
    on_clock(true);
    on_clock(true);
    assert !led;
    assert_eq(presses, 2);
}
