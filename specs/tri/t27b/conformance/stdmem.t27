// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/stdmem.t27 -- `std.mem.trim`, `std.mem.indexOf`,
; `std.mem.indexOfScalar`, `std.math.approxEqAbs` and `@sqrt` of a comptime float, as the
; reference runs them
; (gHashTag/t27#8965, the last lane of #6063, for the bogatyrs spec-structure port).
; Every test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse
; the file. gen-zig prints all of these as written, so the reference is Zig 0.16's own std,
; measured on the t27b lab (Debug, x86_64) and read from the lab's Zig sources:
; - trim (mem.zig:1202) is membership at both ends: trim("abc", "cba") is empty, an empty cutset
;   trims nothing, inner bytes stay.
; - indexOf (mem.zig's indexOfPos) is the first index of the substring or null, an empty needle
;   found at 0, a longer one never; compared with null as the corpus reads it.
; - indexOfScalar (mem.zig:1216, `findScalar`) is the first index of the byte or null; `:lead`
;   gives 0, `::` gives 0, `a:b:c` gives 1.
; - approxEqAbs (math.zig:76) answers true for equal values first (infinities at any tolerance,
;   ±0 against 0), false for a NaN operand, else `@abs(x - y) <= tolerance` -- inclusive.
; - `@sqrt` of a comptime float is Zig's binary128 fold, rounded once to f64; on the lab it
;   matched the hardware square root on every one of a 214-literal sweep (0.25 to 99, k/128 for
;   k in 1..200, and 0.1), and preserved the sign of -0.0.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceStdmem;

fn smc_has_key(line: []const u8, key: []const u8) -> bool {
    var trimmed = std.mem.trim(u8, line, " \t\r");
    var colon_idx = std.mem.indexOfScalar(u8, trimmed, ':');
    if (colon_idx != null and colon_idx.? > 0) {
        var found = std.mem.trim(u8, trimmed[0..colon_idx.?], " ");
        return std.mem.eql(u8, found, key);
    }
    return false;
}

fn smc_structure_ok(text: []const u8) -> bool {
    var has_name = false;
    var has_version = false;
    var has_language = false;
    var has_module = false;
    var line_ptr: usize = 0;
    while (line_ptr < text.len) {
        var line_end: usize = line_ptr;
        while (line_end < text.len and text[line_end] != '\n') {
            line_end += 1;
        }
        var line = text[line_ptr..line_end];
        line_ptr = line_end + 1;
        var trimmed = std.mem.trim(u8, line, " \t\r");
        if (trimmed.len == 0 or trimmed[0] == '#') continue;
        if (smc_has_key(line, "name")) has_name = true;
        if (smc_has_key(line, "version")) has_version = true;
        if (smc_has_key(line, "language")) has_language = true;
        if (smc_has_key(line, "module")) has_module = true;
    }
    return has_name and has_version and has_language and has_module;
}

test structure_reads_the_four_keys {
    const valid = "name: test_spec\nversion: 1.0.0\nlanguage: zig\nmodule: test_spec";
    const result = smc_structure_ok(valid);
    assert(result == true);
}

test structure_survives_whitespace_and_comments {
    const messy = "  name  :  test_spec  \nversion:\"1.0.0\"\n  language:zig\nmodule:test_spec";
    const result = smc_structure_ok(messy);
    assert(result == true);
    const commented = "# nothing but a comment\n  name : x\nversion: 1\nlanguage: zig\nmodule: x";
    assert(smc_structure_ok(commented) == true);
}

test structure_rejects_a_missing_key {
    const no_module = "name: test_spec\nversion: 1.0.0\nlanguage: zig";
    assert(smc_structure_ok(no_module) == false);
}

test trim_membership_not_prefix {
    assert(std.mem.eql(u8, std.mem.trim(u8, "  abc\t", " \t\r"), "abc"));
    assert(std.mem.eql(u8, std.mem.trim(u8, "abc", "cba"), ""));
    assert(std.mem.eql(u8, std.mem.trim(u8, "a", ""), "a"));
    assert(std.mem.eql(u8, std.mem.trim(u8, "  name  :  test_spec  ", " "), "name  :  test_spec"));
    assert(std.mem.trim(u8, "  abc\t", " \t\r").len == 3);
}

test indexOf_first_or_null {
    assert(std.mem.indexOf(u8, "name: v", "name") != null);
    assert(std.mem.indexOf(u8, "name: v", "v:") == null);
    var found = std.mem.indexOf(u8, "a b c", "b");
    assert(found != null);
    assert(found.? == 2);
    assert(std.mem.indexOf(u8, "abc", "") != null);
    assert(std.mem.indexOf(u8, "", "abc") == null);
}

test indexOfScalar_first_or_null {
    var idx = std.mem.indexOfScalar(u8, "name: v", ':');
    assert(idx != null);
    assert(idx.? == 4);
    assert(std.mem.indexOfScalar(u8, ":lead", ':').? == 0);
    assert(std.mem.indexOfScalar(u8, "a:b:c", ':').? == 1);
    assert(std.mem.indexOfScalar(u8, "no colon here", ':') == null);
    assert(std.mem.indexOfScalar(u8, "", ':') == null);
}

test approxEqAbs_equal_first_then_inclusive {
    assert(std.math.approxEqAbs(f64, 3.0, 3.0, 0.0) == true);
    assert(std.math.approxEqAbs(f64, 0.0, 0.5, 0.5) == true);
    assert(std.math.approxEqAbs(f64, 3.0, 3.0001, 0.0001) == false);
    assert(std.math.approxEqAbs(f64, 3.0, 3.0000999, 0.0001) == true);
    assert(std.math.approxEqAbs(f64, std.math.nan(f64), 1.0, 1.0) == false);
    assert(std.math.approxEqAbs(f64, std.math.inf(f64), std.math.inf(f64), 0.0) == true);
    assert(std.math.approxEqAbs(f64, 0.0, -0.0, 0.0) == true);
}

test phi_constant_sqrt_fold {
    const phi: f64 = (1.0 + @sqrt(5.0)) / 2.0;
    const pb: u64 = @bitCast(phi);
    assert(pb == 0x3ff9e3779b97f4a8);
    const identity = phi * phi + 1.0 / (phi * phi);
    assert(std.math.approxEqAbs(f64, 3.0, identity, 0.0001));
}

test sqrt_fold_zero_signs_and_sweep_shape {
    // `@bitCast` needs a typed operand: Zig cannot bitcast a comptime_float,
    // which has no size, so the fold goes through an f64 local first. The last
    // check rides a runtime call: Zig folds an assert of comptime-known truth
    // away entirely, and the test would count vacuous with only const folds.
    const z: f64 = @sqrt(0.0);
    const pz: u64 = @bitCast(z);
    assert(pz == 0x0);
    const nz: f64 = @sqrt(-0.0);
    const nb: u64 = @bitCast(nz);
    assert(nb == 0x8000000000000000);
    const two: f64 = @sqrt(4.0);
    const tb: u64 = @bitCast(two);
    assert(tb == 0x4000000000000000);
    const half: f64 = @sqrt(0.25);
    assert(std.math.approxEqAbs(f64, 0.5, half, 0.0));
}
