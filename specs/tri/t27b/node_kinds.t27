// zig_renders, is_prose_clause of lower.rs move to specs/tri/t27b/node_kinds.t27.
// Part of M10 milestone (milestone #14). Closes #8591.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::t27b::node_kinds;

pub const NODE_KIND_MAX : u32 = 128;

pub struct NodeKindInfo { name: str, kind_id: u32 };

pub fn node_kind_id(k: NodeKindInfo) -> u32 {
    return k.kind_id;
}

test "node_kind_id" {
    assert(node_kind_id(NodeKindInfo { name: "fn", kind_id: 1 }) == 1);
}

invariant node_kind_max_positive {
    assert NODE_KIND_MAX > 0;
}