; SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/node_kinds.t27 -- Node-kind labels and the small kind
; predicates t27b's lowering asks about.
; --
; Ported verbatim from cli/t27b/src/lower.rs (issue #8591). `kind_name` maps a
; flat kind byte to the exact Rust Debug name of the matching NodeKind variant,
; the name t27b prints verbatim in diagnostics and stderr fences. `int_lit_width`
; decides the width t27c's Zig backend pins on an untyped `var` set to a bare
; integer literal, as Zig refuses a `var` of type comptime_int. `zig_renders`
; decides which node kinds t27c's `gen_expr` prints anything for. `is_prose_clause`
; decides which clauses the front-end kept only as verbatim text. The `WIDTHS`
; lookup that turns `int_lit_width`'s width byte into a suffix name stays in
; cli/t27b/src/lower.rs, beside the other flat-to-Node glue. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bNodeKinds;

use tri::t27b::ast_walk; // K_ constants, renders
use tri::t27b::source_text; // WIDTH_NONE, lit_width, prose_label
use tri::t27b::type_text; // same

/// The exact Debug name of each NodeKind variant, in K_ order.
pub const KIND_NAMES : [35]str = ["Module", "UseDecl", "ConstDecl", "EnumDecl", "EnumVariant", "StructDecl", "FnDecl", "InvariantBlock", "TestBlock", "BenchBlock", "ExprLiteral", "ExprIdentifier", "ExprEnumValue", "ExprCall", "ExprFieldAccess", "ExprSwitch", "ExprBinary", "ExprUnary", "ExprReturn", "ExprIndex", "ExprIf", "ExprStructLit", "ExprArrayLiteral", "ExprTuple", "ExprCast", "ExprRange", "StmtLocal", "StmtAssign", "StmtIf", "StmtWhile", "StmtFor", "StmtForRange", "StmtBreak", "StmtContinue", "StmtExpr"];

/// The kind's exact Debug name (`ExprStructLit`), the name t27b prints
/// verbatim in diagnostics and stderr fences.
pub fn kind_name(k: u8) -> str {
    return KIND_NAMES[k];
}

/// The width t27c's Zig backend pins on an untyped `var` set to a bare
/// integer literal, as Zig refuses a `var` of type comptime_int: the byte of
/// the literal's suffix width, or `WIDTH_NONE` when the node is not an
/// integer literal at all, or is a string literal, whose `var` Zig accepts
/// untyped (`-1`, `0.0`, `0o7` stay `WIDTH_NONE` too, and Zig refuses them).
/// Callers turn the byte into the suffix name through `WIDTHS`.
pub fn int_lit_width(kind: u8, extra_kind: []const u8, extra_type: []const u8, value: []const u8) -> u8 {
    if (kind != K_EXPR_LITERAL) {
        return WIDTH_NONE;
    }
    if (same(extra_kind, "string")) {
        return WIDTH_NONE;
    }
    return lit_width(extra_type, value);
}

/// The node kinds t27c's `gen_expr` prints anything for; every other kind (a
/// statement) renders as the empty string.
pub fn zig_renders(k: u8) -> bool {
    return renders(k);
}

/// A clause the front-end kept only as verbatim text: a childless StmtExpr
/// named `<word>:` (`measure:`, `target:`), its text in `value`.
pub fn is_prose_clause(kind: u8, n_children: usize, name: []const u8) -> bool {
    return (kind == K_STMT_EXPR) and (n_children == 0) and prose_label(name);
}

test kind_name_names_every_kind {
    assert kind_name(K_MODULE) == "Module";
    assert kind_name(K_EXPR_LITERAL) == "ExprLiteral";
    assert kind_name(K_EXPR_STRUCT_LIT) == "ExprStructLit";
    assert kind_name(K_EXPR_SWITCH) == "ExprSwitch";
    assert kind_name(K_STMT_IF) == "StmtIf";
    assert kind_name(K_STMT_EXPR) == "StmtExpr";
}

test int_lit_width_pinned_widths {
    assert int_lit_width(K_EXPR_LITERAL, "int", "", "1") == WIDTH_U32;
    assert int_lit_width(K_EXPR_LITERAL, "int", "", "123456789012345678901") == WIDTH_U64;
    assert int_lit_width(K_EXPR_LITERAL, "int", "i32", "1") == 8;
    assert int_lit_width(K_EXPR_LITERAL, "int", "", "-1") == WIDTH_NONE;
    assert int_lit_width(K_EXPR_LITERAL, "int", "", "0.0") == WIDTH_NONE;
    assert int_lit_width(K_EXPR_LITERAL, "int", "", "0o7") == WIDTH_NONE;
    assert int_lit_width(K_EXPR_LITERAL, "string", "u8", "text") == WIDTH_NONE;
    assert int_lit_width(K_STMT_IF, "", "", "") == WIDTH_NONE;
}

test zig_renders_matches_kind {
    assert zig_renders(K_MODULE) == false;
    assert zig_renders(K_STMT_IF) == false;
    assert zig_renders(K_STMT_EXPR) == false;
    assert zig_renders(K_EXPR_CALL) == true;
    assert zig_renders(K_EXPR_STRUCT_LIT) == true;
}

test is_prose_clause_kept_verbatim {
    assert is_prose_clause(K_STMT_EXPR, 0, "measure:") == true;
    assert is_prose_clause(K_STMT_EXPR, 0, "target:") == true;
    assert is_prose_clause(K_STMT_EXPR, 0, "measure") == false;
    assert is_prose_clause(K_STMT_EXPR, 0, ":") == false;
    assert is_prose_clause(K_STMT_EXPR, 1, "measure:") == false;
    assert is_prose_clause(K_STMT_IF, 0, "measure:") == false;
}
