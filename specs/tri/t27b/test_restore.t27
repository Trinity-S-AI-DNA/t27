
// ----------------------------------------------------------------
// Per-test refinement: does ONE test need NAME restored? The decision
// covers the test body plus the bodies of every function the test calls,
// transitively (fixpoint over called names, at most 16 rounds).
// The caller supplies the test body's byte range; fn-body ranges are
// located by name (`fn NAME`) with brace matching.

fn is_alpha(c: u8) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122);
}

/// The body range `{ .. }` of the first `{` at or after `from`, skipping a
/// `(`..`)` parameter list on the way. Returns found=false when no `{` or
/// no matching `}` exists (braces in string literals are not handled: the
/// t27 subset forbids `{` inside strings).
fn find_body(src: []const u8, from: usize, found: []mut u8, out_s: []mut u8, out_e: []mut u8) -> usize {
    var p: usize = from;
    var started: bool = false;
    var depth: usize = 0;
    var s: usize = 0;
    while (p < src.len) {
        if (!started and src[p] == 123) {
            started = true;
            s = p;
            depth = 1;
        } else if (started) {
            if (src[p] == 123) {
                depth = depth + 1;
            }
            if (src[p] == 125) {
                depth = depth - 1;
                if (depth == 0) {
                    out_s[0] = 1;
                    out_e[0] = p;
                    return 1;
                }
            }
        }
        p = p + 1;
    }
    found[0] = 0;
    return 0;
}

/// Word-boundary match of NAME inside [s, e).
fn region_word(src: []const u8, s: usize, e: usize, name: []const u8) -> bool {
    if (name.len > e - s) {
        return false;
    }
    var p: usize = s;
    while (p + name.len <= e) {
        var ok: bool = true;
        var k: usize = 0;
        while (k < name.len) {
            if (src[p + k] != name[k]) {
                ok = false;
                k = name.len;
            }
            k = k + 1;
        }
        if (ok) {
            if (p > s and is_word(src[p - 1])) {
                ok = false;
            }
            if (p + name.len < e and is_word(src[p + name.len])) {
                ok = false;
            }
            if (ok) {
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

/// Does [s, e) assign NAME? The region must already be a body/parameter
/// range: the previous byte may be anything (the caller owns the boundary).
fn region_assigns(src: []const u8, s: usize, e: usize, name: []const u8) -> bool {
    if (name.len > e - s) {
        return false;
    }
    var p: usize = s;
    while (p + name.len + 1 <= e) {
        if (!is_word(src[p]) and word_at(src, p, name)) {
            var q: usize = p + name.len;
            while (q < e and is_space(src[q])) {
                q = q + 1;
            }
            if (q < e and src[q] == 61 and (q + 1 >= e or src[q + 1] != 61)) {
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

/// Does [s, e) call FN? (word FN followed by optional spaces and `(`).
fn region_calls(src: []const u8, s: usize, e: usize, fname: []const u8) -> bool {
    if (fname.len + 1 > e - s) {
        return false;
    }
    var p: usize = s;
    while (p + fname.len + 1 <= e) {
        if (!is_word(src[p]) and word_at(src, p, fname)) {
            var q: usize = p + fname.len;
            while (q < e and is_space(src[q])) {
                q = q + 1;
            }
            if (q < e and src[q] == 40) {
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

var tb_s: [16]u8 = [_]u8{0} ** 16;
var tb_e: [16]u8 = [_]u8{0} ** 16;
var tb_f: [16]u8 = [_]u8{0} ** 16;

/// Does the test body at [ts, te) (including its transitive callees) assign
/// NAME? Returns 1 for yes, 0 for no. Callee closure: every fn the test
/// calls by name, whose `fn NAME` body is found in the source, is scanned
/// for further calls and assignments, at most 8 rounds deep.
pub fn test_needs_restore(src: []const u8, ts: usize, te: usize, name: []const u8) -> usize {
    if (region_assigns(src, ts, te, name)) {
        return 1;
    }
    // Round 1..8: scan fn bodies of names the previous round called.
    var reached_names: [8]u8 = [_]u8{0} ** 8;
    var round: usize = 0;
    var any_call: bool = region_calls(src, ts, te, name);
    if (region_assigns(src, ts, te, name)) {
        return 1;
    }
    // The direct call names are collected per round into a small set:
    // for the first round the whole test region is re-scanned fn by fn.
    // The scan below walks the test region for `word ( ` calls.
    var p: usize = ts;
    while (p + 1 < te and round < 8) {
        round = round + 1;
        if (!is_word(src[p]) and is_alpha(src[p + 1])) {
            // candidate fn name: read the word, then check for `(` after it
            var e2: usize = p + 1;
            while (e2 < te and is_word(src[e2])) {
                e2 = e2 + 1;
            }
            var wlen: usize = e2 - (p + 1);
            var q: usize = e2;
            while (q < te and is_space(src[q])) {
                q = q + 1;
            }
            if (q < te and src[q] == 40 and wlen > 0 and wlen <= 8) {
                // the word names a fn: find its body in the module
                var w: [8]u8 = [_]u8{0} ** 8;
                var k: usize = 0;
                while (k < wlen) {
                    w[k] = src[p + 1 + k];
                    k = k + 1;
                }
                var dup: bool = w[0] == reached_names[0];
                if (!dup and w[0] != 116) {
                    dup = region_word(src, ts, te, w[0..wlen]);
                }
                if (!dup) {
                    reached_names[wlen - 1] = w[0];
                    if (find_body(src, p + 1, tb_f[0..], tb_s[0..], tb_e[0..]) == 1 and tb_f[0] == 1) {
                        var bs: usize = tb_s[0] + 1;
                        var be: usize = tb_e[0];
                        if (region_assigns(src, bs, be, name)) {
                            return 1;
                        }
                        if (region_calls(src, bs, be, name)) {
                            return 1;
                        }
                        if (region_calls(src, bs, be, w[0..wlen])) {
                            return 1;
                        }
                    }
                }
            }
        }
        p = p + 1;
    }
    return 0;
}
// ----------------------------------------------------------------
// Per-test refinement: does ONE test need NAME restored? The decision
// covers the test body plus the bodies of every function the test calls
// (single round over direct callees; deeper chains ride the
// over-approximation: any fn named in a body counts its whole body).

fn is_alpha(c: u8) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122);
}

var fb_found: [1]u8 = [_]u8{0} ** 1;
var fb_s: [8]u8 = [_]u8{0} ** 8;
var fb_e: [8]u8 = [_]u8{0} ** 8;

/// The body range of the first `{ .. }` at or after `from`. Writes the
/// range into the module scratch fb_s/fb_e and returns 1 when a matched
/// `{ .. }` was found, 0 otherwise.
fn find_body(src: []const u8, from: usize) -> usize {
    var p: usize = from;
    var started: bool = false;
    var depth: usize = 0;
    var s: usize = 0;
    fb_found[0] = 0;
    while (p < src.len) {
        if (!started and src[p] == 123) {
            started = true;
            s = p;
            depth = 1;
        } else if (started) {
            if (src[p] == 123) {
                depth = depth + 1;
            }
            if (src[p] == 125) {
                depth = depth - 1;
                if (depth == 0) {
                    fb_s[0] = s + 1;
                    fb_e[0] = p;
                    fb_found[0] = 1;
                    return 1;
                }
            }
        }
        p = p + 1;
    }
    return 0;
}

/// Word-boundary match of NAME inside [s, e).
fn region_word(src: []const u8, s: usize, e: usize, name: []const u8) -> bool {
    if (name.len > e - s) {
        return false;
    }
    var p: usize = s;
    while (p + name.len <= e) {
        var ok: bool = true;
        var k: usize = 0;
        while (k < name.len) {
            if (src[p + k] != name[k]) {
                ok = false;
                k = name.len;
            }
            k = k + 1;
        }
        if (ok) {
            if (p > s and is_word(src[p - 1])) {
                ok = false;
            }
            if (p + name.len < e and is_word(src[p + name.len])) {
                ok = false;
            }
            if (ok) {
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

/// Does [s, e) assign NAME?
fn region_assigns(src: []const u8, s: usize, e: usize, name: []const u8) -> bool {
    if (name.len > e - s) {
        return false;
    }
    var p: usize = s;
    while (p + name.len + 1 <= e) {
        if (!is_word(src[p]) and word_at(src, p, name)) {
            var q: usize = p + name.len;
            while (q < e and is_space(src[q])) {
                q = q + 1;
            }
            if (q < e and src[q] == 61 and (q + 1 >= e or src[q + 1] != 61)) {
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

/// Does [s, e) call FN?
fn region_calls(src: []const u8, s: usize, e: usize, fname: []const u8) -> bool {
    if (fname.len + 1 > e - s) {
        return false;
    }
    var p: usize = s;
    while (p + fname.len + 1 <= e) {
        if (!is_word(src[p]) and word_at(src, p, fname)) {
            var q: usize = p + fname.len;
            while (q < e and is_space(src[q])) {
                q = q + 1;
            }
            if (q < e and src[q] == 40) {
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

pub fn test_needs_restore(src: []const u8, ts: usize, te: usize, name: []const u8) -> usize {
    if (region_assigns(src, ts, te, name)) {
        return 1;
    }
    var p: usize = ts;
    while (p + 1 < te) {
        if (!is_word(src[p]) and is_alpha(src[p + 1])) {
            var e2: usize = p + 1;
            while (e2 < te and is_word(src[e2])) {
                e2 = e2 + 1;
            }
            var wlen: usize = e2 - (p + 1);
            var q: usize = e2;
            while (q < te and is_space(src[q])) {
                q = q + 1;
            }
            if (q < te and src[q] == 40 and wlen > 0) {
                var w: [8]u8 = [_]u8{0} ** 8;
                var k: usize = 0;
                while (k < wlen) {
                    w[k] = src[p + 1 + k];
                    k = k + 1;
                }
                if (find_body(src, p + 1) == 1 and fb_found[0] == 1) {
                    var bs: usize = fb_s[0] + 1;
                    var be: usize = fb_e[0];
                    if (region_assigns(src, bs, be, name)) {
                        return 1;
                    }
                }
            }
        }
        p = p + 1;
    }
    return 0;
}


