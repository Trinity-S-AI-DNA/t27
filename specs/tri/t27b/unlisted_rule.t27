module UnlistedRule;
// Rules for handling UNLISTED specs in the t27b ratchet (#11417).
// An UNLISTED spec fails the PR only when the PR itself adds that spec.
// An inherited UNLISTED from master is reported as a note, not a failure.

// Determines if an UNLISTED spec should fail the PR
// - path: file path of the spec
// - added_by_pr: boolean indicating if this spec was added by the current PR
// Returns true if the spec is UNLISTED and added by the PR (should fail)
// Returns false if the spec is UNLISTED but inherited from master (note only)
pub fn unlisted_fails_pr(path: str, added_by_pr: bool) -> bool {
    // A spec that is UNLISTED fails the PR only when the PR itself adds it
    if (added_by_pr) {
        return true;
    }
    // An inherited UNLISTED spec is a note, not a failure
    return false;
}

// Test: A spec the PR adds without a row should fail
test unlisted_spec_added_by_pr_fails {
    assert(unlisted_fails_pr("specs/test/example.t27", true));
}

// Test: A spec master added earlier without a row is a note (does not fail)
test unlisted_spec_inherited_from_master_is_note {
    assert(unlisted_fails_pr("specs/test/legacy.t27", false) == false);
}

// Test: A spec the PR adds with a row is clean (not unlisted)
test spec_added_with_row_is_clean {
    // This test verifies normal behavior - when a spec is properly listed,
    // it should not cause issues. We verify our function returns false
    // for specs not marked as unlisted.
    assert(unlisted_fails_pr("specs/test/new_with_row.t27", false) == false);
}

invariant unlisted_logic_is_sound {
    // An UNLISTED spec should only fail when added by PR
    assert(unlisted_fails_pr("any.t27", true));
    // But not when inherited
    assert(unlisted_fails_pr("any.t27", false) == false);
}

endmodule