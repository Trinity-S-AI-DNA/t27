// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/build_record.t27 -- when the t27b native object is built again, and what its build record holds.
; Issue gHashTag/t27#11038 / #10860. Part of the epic "T27F developer tools in t27b and t27c, sped up by t27c seal".
; --
; Why. t27b produces the AArch64 native object (.o or .o.gz) that runs t27 OS.
; Every `t27b build` parses, lowers and encodes the whole closure, even when the save changed only a comment.
; t27c already knows when that happens: `t27c seal --save` records the spec hash and the four generated-code hashes
; (`gen_hash_*`), `specs/verified/reuse.t27` says when a sealed artifact may be reused (every part recorded and equal;
; MISSING never means SAME), and `specs/verified/watch.t27` watch_skip says a spec whose source moved but whose generated code
; did not cannot change its verdict (#10237). This spec applies the same rule to the native object: `t27b build` (and every
; rebuild of `t27b watch`) writes a build record next to the object, and skips the build when the record says nothing
; that feeds the object changed.
; --
; The rule. Build again only when an input changed, else REUSE and run nothing:
;   the closure   the source hash of every spec in the `use` closure, the root included;
;                 the identity of the `t27b` binary (sha256);
;                 the flags that change the bytes (`--elf`/`--macho`, `--overflow`).
;   the binary    the sha256 of the output binary before it is written;
;   the glue      any hand-written input that affects the bytes.
; The reasons are ordered; the first that holds is the one printed.
; --
; Seals. A root whose seal is missing, or whose seal records another spec hash than the file now has, is
; refused: the build never turns an unsealed or unchecked spec into an artifact (`t27c seal --save` first).
; --
; The record. One text file `<out>.build` next to the object whose non-`#` lines are `<sha256>  <name>`, readable
; by `shasum -a 256 -c`, as in `specs/t27f/build.t27`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bBuild;

/// The record's file name, next to the output it describes.
pub const BUILD_RECORD : str = "<out>.build";

/// Bumped by hand when the record's keys or the build's composition change.
pub const BUILD_RECORD_VERSION : u32 = 1;

/// The spec the object is generated from. The root spec that `t27b build` is called from.
pub const BUILD_ROOT_SPEC : str = "root";

/// The directory of the specs, under the repository root.
pub const BUILD_SPEC_DIR : str = "specs/tri/";

/// The hand glue, an input that sits next to the outputs.
pub const BUILD_GLUE : str = "";

/// The generated files, in the order the record lists them. The binary is last: it is what the others build.
pub const BUILD_OUTPUTS : str = "root_spec.bin";

/// The flags that change the bytes.
pub const BUILD_ELF_MACHO : str = "--elf --macho";
pub const BUILD_OVERFLOW : str = "--overflow";

/// The zig command identity (sha256 of the t27b binary).
pub const BUILD_ZIG : str = "t27b binary";

/// The record's input keys, `# <key> <value>` lines.
pub const KEY_CLOSURE : str = "# closure ";
pub const KEY_BINARY : str = "# binary ";
pub const KEY_ZIG_ID : str = "# zig ";
pub const KEY_FLAGS : str = "# flags ";

/// What `t27c seal --verify` says when there is no seal to verify (it exits 1 for that and for a stale seal).
pub const BUILD_NO_SEAL : str = "No saved seal found";

/// Why the build runs again, or REUSE.
pub const BUILD_REUSE : u32 = 0;
pub const BUILD_NO_RECORD : u32 = 1;
pub const BUILD_CLOSURE : u32 = 2;
pub const BUILD_BINARY_CHANGED : u32 = 3;
pub const BUILD_ZIG_CHANGED : u32 = 4;
pub const BUILD_FLAGS_CHANGED : u32 = 5;
pub const BUILD_GLUE_CHANGED : u32 = 6;

/// The words `tri t27b` prints for each code above, in code order (space separated).
pub const BUILD_REASON_WORDS : str = "REUSE no-record closure binary zig flags glue";
pub const SEAL_WORDS : str = "ok missing stale";
pub const FILE_WORDS : str = "ok missing changed";

/// A root's seal: usable, missing, or recording another spec hash than the file has.
pub const SEAL_OK : u32 = 0;
pub const SEAL_MISSING : u32 = 1;
pub const SEAL_STALE : u32 = 2;

/// One file of a record against the file: `file_found`, and `sha_same` when the file's sha256 is the record's.
pub fn build_file(file_found: bool, sha_same: bool) -> u32 {
    if (file_found == false) { return FILE_MISSING; }
    if (sha_same == false) { return FILE_DRIFT; }
    return FILE_OK;
}

/// The exit code of `tri t27b check`: 1 as soon as one file drifted or is missing.
pub fn build_check_exit(files_off: u32) -> u32 {
    if (files_off > 0) { return 1; }
    return 0;
}

/// The build reason, ordered priority: first change wins.
pub fn build_reason(has_record: bool, closure_same: bool, binary_same: bool, zig_same: bool, flags_same: bool, glue_same: bool, outputs_same: bool) -> u32 {
    if (has_record == false) { return BUILD_NO_RECORD; }
    if (closure_same == false) { return BUILD_CLOSURE; }
    if (binary_same == false) { return BUILD_BINARY_CHANGED; }
    if (zig_same == false) { return BUILD_ZIG_CHANGED; }
    if (flags_same == false) { return BUILD_FLAGS_CHANGED; }
    if (glue_same == false) { return BUILD_GLUE_CHANGED; }
    if (outputs_same == false) { return BUILD_OUTPUT_CHANGED; }
    return BUILD_REUSE;
}

test build_reuses_only_when_every_input_is_the_same {
    assert build_reason(true, true, true, true, true, true, true) == 0;
    assert build_reason(false, true, true, true, true, true, true) == 1;
    assert build_reason(true, false, true, true, true, true, true) == 2;
    assert build_reason(true, true, false, true, true, true, true) == 3;
    assert build_reason(true, true, true, false, true, true, true) == 4;
    assert build_reason(true, true, true, true, false, true, true) == 5;
    assert build_reason(true, true, true, true, true, false, true) == 6;
    assert build_reason(true, true, true, true, true, true, false) == 7;
}

test build_reason_names_the_first_change {
    // several inputs changed: the earlier reason wins, so the printed reason does not depend on the order checked
    assert build_reason(true, false, false, false, false, false, false) == 2;
    assert build_reason(true, true, false, false, true, true, true) == 3;
    assert build_reason(true, true, true, true, false, false, false) == 5;
    assert build_reason(true, true, true, true, true, false, false) == 6;
    assert build_reason(true, true, true, true, true, true, false) == 7;
    // no record: nothing else can be judged
    assert build_reason(false, false, false, false, false, false, false) == 1;
}

test build_refuses_a_root_without_a_current_seal {
    assert build_seal(true, true) == 0;
    assert build_seal(false, false) == 1;
    assert build_seal(true, false) == 2;
    // a missing seal stays missing even if the exit code looked like a match
    assert build_seal(false, true) == 1;
}

test build_check_names_the_drift {
    assert build_file(true, true) == 0;
    assert build_file(false, true) == 1;
    assert build_file(true, false) == 2;
    assert build_file(false, false) == 1;
}

test build_check_exit_is_one_on_any_drift {
    assert build_check_exit(0) == 0;
    assert build_check_exit(1) == 1;
    assert build_check_exit(11) == 1;
}

invariant the_record_shape_never_moves_silently {
    assert BUILD_RECORD_VERSION >= 1;
    assert BUILD_REUSE == 0;
    assert SEAL_OK == 0;
    assert FILE_OK == 0;
    assert BUILD_NO_RECORD != BUILD_CLOSURE;
    assert BUILD_BINARY_CHANGED != BUILD_ZIG_CHANGED;
    assert BUILD_ZIG_CHANGED != BUILD_FLAGS_CHANGED;
    assert BUILD_FLAGS_CHANGED != BUILD_GLUE_CHANGED;
    assert SEAL_MISSING != SEAL_STALE;
    assert FILE_MISSING != FILE_DRIFT;
}