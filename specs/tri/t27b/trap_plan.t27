// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/trap_plan.t27 -- the trap-stub law of t27b AArch64 codegen
; (ladder step 4 of #13132). Every check branches to an out-of-line stub at
; the end of the function. A JIT stub records what the shared `trap_common`
; routine of the JIT image reads back: the site number in x1, and for an
; assert_eq the two operands ahead of it -- x8 takes the rhs, x2 the lhs,
; x3 a copy of the rhs -- a fixed ABI sequence whose register choice is the
; law, not a per-call decision. An object-file stub is `brk #kind`; the
; kinds are TrapKind's, and two checks of one kind share one stub (dedup by
; kind; a JIT stub is deduped by site the same way). The emitter
; (cli/t27b/src/codegen.rs) keeps the bookkeeping -- the maps, the labels,
; the emits; the choices below are the spec's.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bTrapPlan;

/// Does the stub of a `site` record the site (JIT: the stub loads it into x1
/// and jumps to trap_common), rather than being a plain `brk #kind` (object
/// file)? TrapStyle decides: Jit records; Brk and Elf do not.
pub fn stub_records_site(jit: bool) -> bool {
    return jit;
}

/// The destination register of the assert_eq stub's operand moves, in emit
/// order: the ABI the JIT's trap_common reads -- slot 0 is x8 (the rhs),
/// slot 1 is x2 (the lhs), slot 2 is x3 (a copy of the rhs); the site
/// number goes into x1 after them.
pub fn assert_eq_dst(slot: u64) -> u64 {
    if (slot == 0) { return 8; }
    if (slot == 1) { return 2; }
    if (slot == 2) { return 3; }
    return 0;
}

/// How many operand moves the assert_eq stub emits ahead of the site number.
pub const ASSERT_EQ_MOVES : u64 = 3;

/// The reach, in words, of an unconditional A64 `b`/`bl`: the 26-bit
/// immediate is sign-extended and scaled by 4 bytes, so the word offset must
/// fit in [-2^25, 2^25). The trap branch to `trap_common` and every in-module
/// `bl` ask this before their word is patched.
pub fn branch_reaches(off: i64) -> bool {
    return off >= -(1 << 25) and off < (1 << 25);
}

test a_jit_stub_records_the_site_and_an_object_stub_is_brk {
    assert stub_records_site(true);
    assert stub_records_site(false) == false;
}
test the_assert_eq_abi_is_x8_rhs_x2_lhs_x3_copy {
    assert assert_eq_dst(0) == 8;
    assert assert_eq_dst(1) == 2;
    assert assert_eq_dst(2) == 3;
    assert assert_eq_dst(3) == 0;
    assert assert_eq_dst(9) == 0;
    assert ASSERT_EQ_MOVES == 3;
}
test an_unconditional_branch_reaches_its_26_bit_field {
    assert branch_reaches(0);
    assert branch_reaches(1);
    assert branch_reaches((1 << 25) - 1);
    assert branch_reaches(-(1 << 25));
    assert branch_reaches(1 << 25) == false;
    assert branch_reaches(-(1 << 25) - 1) == false;
    assert branch_reaches(1 << 24);
    assert branch_reaches(-(1 << 20));
}
