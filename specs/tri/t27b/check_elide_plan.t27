// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/check_elide_plan.t27 -- when t27b may drop the overflow trap of a checked `+` or `-` (Refs #12871).
; The AArch64 backend keeps `adds` + `b.hs` on a checked add and `subs` + `b.lo` on a checked sub. In
; specs/tri/shootout/bench_audit.t27 `verdict_benchmark_200m` the hot loop is 16 words for t27b against 10 for
; gcc -O2 (t27os lab run 42571382087, asm leg), and two of those traps provably cannot fire. Removing them keeps
; the semantics exactly: the op is rewritten to the wrapping op (ArithOp::AddW / SubW), whose result equals the
; checked result whenever the checked op does not trap.
; --
; (a) Induction increment. In `while (i < n) { ...; i = i + 1; }` with i and n of one integer type, n a constant
;     or never assigned in the loop, i assigned exactly once in the loop (that `i = i + 1`, constant 1 only,
;     nested if arms and the continue expression included, but not an inner while) and i never passed by reference or address: at the
;     add, i < n <= MAX, so i + 1 <= MAX and the add cannot overflow. Refused: `<=`, a step of 2 or more, a
;     second assignment to i, n assigned in the loop, mixed types, an escaped i.
; (b) Decrement after a successful increment. After the checked `x = x + c` (constant c >= 1) the value satisfies
;     x >= MIN + c, so a later `x - k` with constant 1 <= k <= c cannot underflow, provided nothing between the
;     two assigns x. Conservative: the use sits in the same statement list after the increment, or at the top
;     level of an arm of the `if` that directly follows it, before any assignment to x in that arm. Nothing
;     across a loop back edge. Witness: bench_audit `cur_prev = cur_tick - 1` in the else arm after
;     `cur_tick = cur_tick + 1`.
;
; (c) Accumulator bound. In a loop whose induction i is accepted by (a), an `acc = acc + e` with acc and i of one
;     integer type, both starting from integer constants with acc0 <= i0 (assigned just before the loop), acc
;     assigned exactly once in the loop (not inside an inner while; a nested if arm is fine, an add that sometimes
;     does not run keeps the bound), e at most the step of i (a compare result or a select of the constants 0 and 1,
;     so at most 1), acc never passed by reference or address, and i's `i = i + 1` run on every iteration (in the
;     continue expression, or at the top level of a body with no `continue`): at the loop head acc <= i. At the add
;     acc <= i < n <= MAX, so acc + e <= i + 1 <= n <= MAX and the add cannot overflow; at the next head
;     i' = i + 1 >= acc + e, so the bound holds again (induction on the iteration count). Refused: i not accepted by
;     (a), a conditional or skipped increment of i, acc0 > i0, a second assignment to acc, an addend above the step,
;     the add in an inner while, mixed types, an escaped acc. Witness: bench_audit `acc = acc + verdict_fn(..)`.
;     The `cur_tick + 1` of the same loop stays checked: cur_tick starts from a parameter, no bound applies.
; The glue in cli/t27b/src/lower.rs collects the facts and rewrites the sites this module accepts; it
; decides nothing. The witness shapes are specs/tri/shootout/check_elide.t27. Gen: gen/rust/tri/t27b/check_elide_plan.rs.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bCheckElidePlan;

// The CmpOp number of `<` (cli/t27b/src/ir.rs: Eq 0, Ne 1, Lt 2, Le 3, Gt 4, Ge 5).
pub const CMP_LT : u8 = 2;

// Where the use sits relative to the increment.
pub const POS_NONE : u8 = 0;      // not related: a loop body, a later block, another statement
pub const POS_SAME_LIST : u8 = 1; // the same statement list, after the increment
pub const POS_IF_ARM : u8 = 2;    // the top level of an arm of the if that directly follows the increment

// ----------------------------------------------------------------------------------------------------------
// (a) the induction increment
// ----------------------------------------------------------------------------------------------------------

/// Whether the loop condition is `i < n` over one type and n cannot move during the loop.
pub fn bound_holds(cmp: u8, same_ty: bool, limit_fixed: bool) -> bool {
    if (cmp != CMP_LT) { return false; }
    if (!same_ty) { return false; }
    return limit_fixed;
}

/// Whether the loop's `i = i + step` is proven not to overflow. nested_loop: the add sits in an inner while,
/// so it runs many times per test of `i < n` and the bound says nothing about it.
pub fn induction_elides(cmp: u8, same_ty: bool, limit_fixed: bool, assigns_of_i: u32, step: u64, escapes: bool, nested_loop: bool) -> bool {
    if (!bound_holds(cmp, same_ty, limit_fixed)) { return false; }
    if (assigns_of_i != 1) { return false; }
    if (escapes) { return false; }
    if (nested_loop) { return false; }
    return step == 1;
}

// ----------------------------------------------------------------------------------------------------------
// (b) the decrement after a successful increment
// ----------------------------------------------------------------------------------------------------------

/// Whether the use position is one the rule covers.
pub fn pos_ok(pos: u8) -> bool {
    return pos == POS_SAME_LIST or pos == POS_IF_ARM;
}

/// Whether `x - k` is proven not to underflow after the checked `x = x + c`.
pub fn decrement_elides(c: u64, k: u64, pos: u8, assigned_between: bool) -> bool {
    if (c == 0) { return false; }
    if (k == 0) { return false; }
    if (k > c) { return false; }
    if (assigned_between) { return false; }
    return pos_ok(pos);
}

// ----------------------------------------------------------------------------------------------------------
// (c) the accumulator bound
// ----------------------------------------------------------------------------------------------------------

/// Whether `acc = acc + e` is proven not to overflow under a loop that (a) accepts. i_inc_every_iteration: the
/// increment of i runs on every iteration (continue expression, or top level of a body without `continue`).
/// acc0_le_i0: both start from constants and acc0 <= i0. addend_max: the largest value e can take.
pub fn accumulator_elides(i_elides: bool, i_inc_every_iteration: bool, acc0_le_i0: bool, assigns_of_acc: u32, addend_max: u64, i_step: u64, same_ty: bool, escapes: bool, nested_loop: bool) -> bool {
    if (!i_elides) { return false; }
    if (!i_inc_every_iteration) { return false; }
    if (!acc0_le_i0) { return false; }
    if (assigns_of_acc != 1) { return false; }
    if (nested_loop) { return false; }
    if (!same_ty) { return false; }
    if (escapes) { return false; }
    if (i_step != 1) { return false; }
    return addend_max <= i_step;
}

// ----------------------------------------------------------------------------------------------------------
// Tests: the two witnesses of bench_audit, then every condition refused on its own.
// ----------------------------------------------------------------------------------------------------------

test induction_accepts_i_lt_n_step_one {
    // bench_audit: while (i < CALLS_TARGET) { ...; i = i + 1; }
    assert(induction_elides(2, true, true, 1, 1, false, false));
}

test induction_refuses_le_loop {
    // i <= n: i can equal MAX at the add.
    assert(!induction_elides(3, true, true, 1, 1, false, false));
}

test induction_refuses_step_two {
    assert(!induction_elides(2, true, true, 1, 2, false, false));
}

test induction_refuses_second_assignment_to_i {
    assert(!induction_elides(2, true, true, 2, 1, false, false));
    assert(!induction_elides(2, true, true, 0, 1, false, false));
}

test induction_refuses_limit_assigned_in_body {
    assert(!induction_elides(2, true, false, 1, 1, false, false));
}

test induction_refuses_mixed_types {
    assert(!induction_elides(2, false, true, 1, 1, false, false));
}

test induction_refuses_escaped_i {
    assert(!induction_elides(2, true, true, 1, 1, true, false));
}

test induction_refuses_increment_in_inner_while {
    // i < n holds once per outer iteration, the inner add runs many times: i can reach MAX and pass it.
    assert(!induction_elides(2, true, true, 1, 1, false, true));
}

test induction_refuses_greater_and_equal_compares {
    assert(!induction_elides(4, true, true, 1, 1, false, false));
    assert(!induction_elides(0, true, true, 1, 1, false, false));
    assert(!bound_holds(5, true, true));
}

test decrement_accepts_the_witness {
    // cur_tick = cur_tick + 1; if (...) {...} else { cur_prev = cur_tick - 1; }
    assert(decrement_elides(1, 1, POS_IF_ARM, false));
    assert(decrement_elides(1, 1, POS_SAME_LIST, false));
}

test decrement_accepts_k_up_to_c {
    assert(decrement_elides(5, 5, POS_SAME_LIST, false));
    assert(decrement_elides(5, 1, POS_IF_ARM, false));
}

test decrement_refuses_k_above_c {
    // x + 1 then x - 2: x can be MIN + 1, and x - 2 underflows.
    assert(!decrement_elides(1, 2, POS_SAME_LIST, false));
}

test decrement_refuses_zero_constants {
    assert(!decrement_elides(0, 1, POS_SAME_LIST, false));
    assert(!decrement_elides(1, 0, POS_SAME_LIST, false));
}

test decrement_refuses_assignment_between {
    assert(!decrement_elides(1, 1, POS_SAME_LIST, true));
}

test decrement_refuses_other_positions {
    // a loop back edge, a nested block, anything not tied to the increment
    assert(!decrement_elides(1, 1, POS_NONE, false));
    assert(!decrement_elides(1, 1, 3, false));
}

test pos_ok_names_the_two_covered_positions {
    assert(pos_ok(POS_SAME_LIST));
    assert(pos_ok(POS_IF_ARM));
    assert(!pos_ok(POS_NONE));
}

test accumulator_accepts_the_bench_shape {
    // bench_audit: i = 0, acc = 0, acc = acc + verdict_fn(..) with a result of 0 or 1, i = i + 1 at the top level.
    assert(accumulator_elides(true, true, true, 1, 1, 1, true, false, false));
    assert(accumulator_elides(true, true, true, 1, 0, 1, true, false, false));
}

test accumulator_refuses_i_not_elided {
    assert(!accumulator_elides(false, true, true, 1, 1, 1, true, false, false));
}

test accumulator_refuses_skipped_or_conditional_increment {
    // a `continue` before `i = i + 1`, or the increment in an if arm: acc can outrun i.
    assert(!accumulator_elides(true, false, true, 1, 1, 1, true, false, false));
}

test accumulator_refuses_start_above_i {
    assert(!accumulator_elides(true, true, false, 1, 1, 1, true, false, false));
}

test accumulator_refuses_two_or_no_assignments {
    assert(!accumulator_elides(true, true, true, 2, 1, 1, true, false, false));
    assert(!accumulator_elides(true, true, true, 0, 1, 1, true, false, false));
}

test accumulator_refuses_addend_two {
    assert(!accumulator_elides(true, true, true, 1, 2, 1, true, false, false));
}

test accumulator_refuses_step_two {
    assert(!accumulator_elides(true, true, true, 1, 1, 2, true, false, false));
}

test accumulator_refuses_inner_loop {
    assert(!accumulator_elides(true, true, true, 1, 1, 1, true, false, true));
}

test accumulator_refuses_escaped_acc {
    assert(!accumulator_elides(true, true, true, 1, 1, 1, true, true, false));
}

test accumulator_refuses_mixed_types {
    assert(!accumulator_elides(true, true, true, 1, 1, 1, false, false, false));
}
