// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/check_elide_plan.t27 -- when t27b may drop the overflow trap of a checked `+` or `-` (Refs #12871).
; The AArch64 backend keeps `adds` + `b.hs` on a checked add and `subs` + `b.lo` on a checked sub. In
; specs/tri/shootout/bench_audit.t27 `verdict_benchmark_200m` the hot loop is 16 words for t27b against 10 for
; gcc -O2 (t27os lab run 42571382087, asm leg), and two of those traps provably cannot fire. Removing them keeps
; the semantics exactly: the op is rewritten to the wrapping op (ArithOp::AddW / SubW), whose result equals the
; checked result whenever the checked op does not trap.
; --
; (a) Induction increment. In `while (i < n) { ...; i = i + 1; }` with i and n of one integer type, n a constant
;     or never assigned in the loop, i assigned exactly once in the loop (that `i = i + 1`, constant 1 only,
;     nested blocks and the continue expression included) and i never passed by reference or address: at the
;     add, i < n <= MAX, so i + 1 <= MAX and the add cannot overflow. Refused: `<=`, a step of 2 or more, a
;     second assignment to i, n assigned in the loop, mixed types, an escaped i.
; (b) Decrement after a successful increment. After the checked `x = x + c` (constant c >= 1) the value satisfies
;     x >= MIN + c, so a later `x - k` with constant 1 <= k <= c cannot underflow, provided nothing between the
;     two assigns x. Conservative: the use sits in the same statement list after the increment, or at the top
;     level of an arm of the `if` that directly follows it, before any assignment to x in that arm. Nothing
;     across a loop back edge. Witness: bench_audit `cur_prev = cur_tick - 1` in the else arm after
;     `cur_tick = cur_tick + 1`.
; The glue in cli/t27b/src/lower/elide.rs collects the facts and rewrites the sites this module accepts; it
; decides nothing. The witness shapes are specs/tri/shootout/check_elide.t27. Gen: gen/rust/tri/t27b/check_elide_plan.rs.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bCheckElidePlan;

// The CmpOp number of `<` (cli/t27b/src/ir.rs: Eq 0, Ne 1, Lt 2, Le 3, Gt 4, Ge 5).
pub const CMP_LT : u8 = 2;

// Where the use sits relative to the increment.
pub const POS_NONE : u8 = 0;      // not related: a loop body, a later block, another statement
pub const POS_SAME_LIST : u8 = 1; // the same statement list, after the increment
pub const POS_IF_ARM : u8 = 2;    // the top level of an arm of the if that directly follows the increment

// ----------------------------------------------------------------------------------------------------------
// (a) the induction increment
// ----------------------------------------------------------------------------------------------------------

/// Whether the loop condition is `i < n` over one type and n cannot move during the loop.
pub fn bound_holds(cmp: u8, same_ty: bool, limit_fixed: bool) -> bool {
    if (cmp != CMP_LT) { return false; }
    if (!same_ty) { return false; }
    return limit_fixed;
}

/// Whether the loop's `i = i + step` is proven not to overflow.
pub fn induction_elides(cmp: u8, same_ty: bool, limit_fixed: bool, assigns_of_i: u32, step: u64, escapes: bool) -> bool {
    if (!bound_holds(cmp, same_ty, limit_fixed)) { return false; }
    if (assigns_of_i != 1) { return false; }
    if (escapes) { return false; }
    return step == 1;
}

// ----------------------------------------------------------------------------------------------------------
// (b) the decrement after a successful increment
// ----------------------------------------------------------------------------------------------------------

/// Whether the use position is one the rule covers.
pub fn pos_ok(pos: u8) -> bool {
    return pos == POS_SAME_LIST or pos == POS_IF_ARM;
}

/// Whether `x - k` is proven not to underflow after the checked `x = x + c`.
pub fn decrement_elides(c: u64, k: u64, pos: u8, assigned_between: bool) -> bool {
    if (c == 0) { return false; }
    if (k == 0) { return false; }
    if (k > c) { return false; }
    if (assigned_between) { return false; }
    return pos_ok(pos);
}

// ----------------------------------------------------------------------------------------------------------
// Tests: the two witnesses of bench_audit, then every condition refused on its own.
// ----------------------------------------------------------------------------------------------------------

test induction_accepts_i_lt_n_step_one {
    // bench_audit: while (i < CALLS_TARGET) { ...; i = i + 1; }
    assert(induction_elides(2, true, true, 1, 1, false));
}

test induction_refuses_le_loop {
    // i <= n: i can equal MAX at the add.
    assert(!induction_elides(3, true, true, 1, 1, false));
}

test induction_refuses_step_two {
    assert(!induction_elides(2, true, true, 1, 2, false));
}

test induction_refuses_second_assignment_to_i {
    assert(!induction_elides(2, true, true, 2, 1, false));
    assert(!induction_elides(2, true, true, 0, 1, false));
}

test induction_refuses_limit_assigned_in_body {
    assert(!induction_elides(2, true, false, 1, 1, false));
}

test induction_refuses_mixed_types {
    assert(!induction_elides(2, false, true, 1, 1, false));
}

test induction_refuses_escaped_i {
    assert(!induction_elides(2, true, true, 1, 1, true));
}

test induction_refuses_greater_and_equal_compares {
    assert(!induction_elides(4, true, true, 1, 1, false));
    assert(!induction_elides(0, true, true, 1, 1, false));
    assert(!bound_holds(5, true, true));
}

test decrement_accepts_the_witness {
    // cur_tick = cur_tick + 1; if (...) {...} else { cur_prev = cur_tick - 1; }
    assert(decrement_elides(1, 1, POS_IF_ARM, false));
    assert(decrement_elides(1, 1, POS_SAME_LIST, false));
}

test decrement_accepts_k_up_to_c {
    assert(decrement_elides(5, 5, POS_SAME_LIST, false));
    assert(decrement_elides(5, 1, POS_IF_ARM, false));
}

test decrement_refuses_k_above_c {
    // x + 1 then x - 2: x can be MIN + 1, and x - 2 underflows.
    assert(!decrement_elides(1, 2, POS_SAME_LIST, false));
}

test decrement_refuses_zero_constants {
    assert(!decrement_elides(0, 1, POS_SAME_LIST, false));
    assert(!decrement_elides(1, 0, POS_SAME_LIST, false));
}

test decrement_refuses_assignment_between {
    assert(!decrement_elides(1, 1, POS_SAME_LIST, true));
}

test decrement_refuses_other_positions {
    // a loop back edge, a nested block, anything not tied to the increment
    assert(!decrement_elides(1, 1, POS_NONE, false));
    assert(!decrement_elides(1, 1, 3, false));
}

test pos_ok_names_the_two_covered_positions {
    assert(pos_ok(POS_SAME_LIST));
    assert(pos_ok(POS_IF_ARM));
    assert(!pos_ok(POS_NONE));
}
