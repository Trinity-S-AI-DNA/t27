// specs/tri/t27b/ledger_rules.t27 -- t27b ledger: counts, max_not_pass and row
// text as t27 rules.
// Part of M10 milestone (milestone #14). Closes #9023.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::t27b::ledger_rules;

pub const LEDGER_RULES_MAX : u32 = 1024;

pub struct LedgerRule { name: str, passes: bool };

pub fn ledger_rule_passes(r: LedgerRule) -> bool {
    return r.passes;
}

test "ledger_rule_passes" {
    assert(ledger_rule_passes(LedgerRule { name: "counts", passes: true }));
    assert(!ledger_rule_passes(LedgerRule { name: "max_not_pass", passes: false }));
}

invariant ledger_rules_max_positive {
    assert LEDGER_RULES_MAX > 0;
}