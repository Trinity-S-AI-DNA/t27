// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/inline.t27 -- pure-function inlining decision for t27b codegen.
; The decision lives here, in t27, so every inline/reject is auditable,
; versioned, and tested. The Rust glue in cli/t27b collects facts about
; callee and call site, calls \`should_inline_call\`, and records the receipt.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bInline;

// Budgets
pub const INLINE_MAX_STMTS : u32 = 24;
pub const INLINE_MAX_CALLER_GROWTH : u32 = 10;
pub const INLINE_MAX_DEPTH : u8 = 2;

// Callee facts
pub const CalleeFacts = struct {
    is_test: bool,
    is_invariant: bool,
    ret_is_none: bool,
    body_stmts: u32,
    has_nested_call: bool,
    has_store: bool,
    has_copy: bool,
    has_assert: bool,
};

// Call-site facts
pub const CallSiteFacts = struct {
    inside_loop: bool,
    constant_args: bool,
    call_depth: u8,
    caller_size: u32,
    result_used: bool,
};

// Inline decision result
pub const InlineVerdict = enum(u8) {
    Inline = 0,
    Reject = 1,
};

pub const InlineReason = enum(u8) {
    PureSmallHotLoop = 0,
    ConstantArgsNotHot = 1,
    TestCallee = 2,
    InvariantCallee = 3,
    VoidCallee = 4,
    BodyTooLarge = 5,
    NestedCall = 6,
    Store = 7,
    Copy = 8,
    Assert = 9,
    OverDepth = 10,
    ColdNoConstants = 11,
    OverGrowthBudget = 12,
};

pub const InlineDecision = struct {
    verdict: InlineVerdict,
    reason: InlineReason,
};

pub fn should_inline_call(callee: CalleeFacts, site: CallSiteFacts) -> InlineDecision {
    if (callee.is_test) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.TestCallee }; }
    if (callee.is_invariant) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.InvariantCallee }; }
    if (callee.ret_is_none) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.VoidCallee }; }
    if (callee.body_stmts > INLINE_MAX_STMTS) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.BodyTooLarge }; }
    if (callee.has_nested_call) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.NestedCall }; }
    if (callee.has_store) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.Store }; }
    if (callee.has_copy) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.Copy }; }
    if (callee.has_assert) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.Assert }; }
    if (site.call_depth >= INLINE_MAX_DEPTH) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.OverDepth }; }
    if ((site.inside_loop == false) and (site.constant_args == false)) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.ColdNoConstants }; }
    if (callee.body_stmts > INLINE_MAX_CALLER_GROWTH) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.OverGrowthBudget }; }
    return InlineDecision { verdict: InlineVerdict.Inline, reason: InlineReason.PureSmallHotLoop };
}
