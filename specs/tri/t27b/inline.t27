    assert d.reason == InlineReason.Assert;
}

test should_inline_refuses_over_stmt_budget {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: INLINE_MAX_STMTS + 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        inside_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    const d = should_inline_call(callee, site);
    assert d.verdict == InlineVerdict.Reject;
    assert d.reason == InlineReason.BodyTooLarge;
}

test should_inline_accepts_at_stmt_budget {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: INLINE_MAX_CALLER_GROWTH,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        inside_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    const d = should_inline_call(callee, site);
    assert d.verdict == InlineVerdict.Inline;
    assert d.reason == InlineReason.PureSmallHotLoop;
}

test should_inline_refuses_over_growth_budget {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: INLINE_MAX_CALLER_GROWTH + 1,
