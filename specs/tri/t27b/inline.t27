// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/inline.t27 -- pure-function inlining decision for t27b codegen.
; The decision lives here, in t27, so every inline/reject is auditable,
; versioned, and tested. The Rust glue in cli/t27b collects facts about
; callee and call site, calls `should_inline_call`, and records the receipt.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bInline;

// ============================================================
// Budgets
// ============================================================

/// Maximum IR statements of an inlined callee's body.
pub const INLINE_MAX_STMTS : u32 = 24;

/// Maximum instructions the caller may grow by one inline.
pub const INLINE_MAX_CALLER_GROWTH : u32 = 10;

/// Maximum inline depth. Recursive calls are rejected.
pub const INLINE_MAX_DEPTH : u8 = 2;

// ============================================================
// Callee facts: what the caller reports about the callee
// ============================================================

pub const CalleeFacts = struct {
    is_test: bool,
    is_invariant: bool,
    ret_is_none: bool,
    body_stmts: u32,
    has_nested_call: bool,
    has_store: bool,
    has_copy: bool,
    has_assert: bool,
};

// ============================================================
// Call-site facts: context of the call
// ============================================================

pub const CallSiteFacts = struct {
    inside_loop: bool,
    constant_args: bool,
    call_depth: u8,
    caller_size: u32,
    result_used: bool,
};

// ============================================================
// Inline decision result
// ============================================================

/// The decision: inline or reject.
pub const InlineVerdict = enum(u8) {
    Inline = 0,
    Reject = 1,
};

/// Why the decision was made: mirrors the spec's refusal conditions.
pub const InlineReason = enum(u8) {
    PureSmallHotLoop = 0,    // callee pure, small, site hot
    ConstantArgsNotHot = 1,  // callee pure, small, args constant
    TestCallee = 2,          // callee is a test
    InvariantCallee = 3,     // callee is an invariant
    VoidCallee = 4,          // callee returns void
    BodyTooLarge = 5,        // body exceeds INLINE_MAX_STMTS
    NestedCall = 6,          // callee calls another fn
    Store = 7,               // callee has store
    Copy = 8,                // callee has copy
    Assert = 9,              // callee has assert
    OverDepth = 10,          // call depth limit exceeded
    ColdNoConstants = 11,    // not hot and no constant args
    OverGrowthBudget = 12,   // caller growth exceeds budget
};

/// One decision: verdict + reason. Generated from should_inline_call;
/// Rust must not recompute the reason.
pub const InlineDecision = struct {
    verdict: InlineVerdict,
    reason: InlineReason,
};

// ============================================================
// The inline decision
// ============================================================

/// Is `callee` inlinable at call site `site`?
/// Returns verdict + reason. Everything else decided by spec.
pub fn should_inline_call(callee: CalleeFacts, site: CallSiteFacts) -> InlineDecision {
    if (callee.is_test) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.TestCallee }; }
    if (callee.is_invariant) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.InvariantCallee }; }
    if (callee.ret_is_none) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.VoidCallee }; }
    if (callee.body_stmts > INLINE_MAX_STMTS) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.BodyTooLarge }; }
    if (callee.has_nested_call) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.NestedCall }; }
    if (callee.has_store) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.Store }; }
    if (callee.has_copy) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.Copy }; }
    if (callee.has_assert) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.Assert }; }
    if (site.call_depth >= INLINE_MAX_DEPTH) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.OverDepth }; }
    if ((site.inside_loop == false) and (site.constant_args == false)) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.ColdNoConstants }; }
    if (callee.body_stmts > INLINE_MAX_CALLER_GROWTH) { return InlineDecision { verdict: InlineVerdict.Reject, reason: InlineReason.OverGrowthBudget }; }
    return InlineDecision { verdict: InlineVerdict.Inline, reason: InlineReason.PureSmallHotLoop };
}

// ============================================================
// Tests
// ============================================================

test should_inline_accepts_pure_small_hot_call {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 3,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        inside_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 10,
        result_used: true,
    };
    const d = should_inline_call(callee, site);
    assert d.verdict == InlineVerdict.Inline;
    assert d.reason == InlineReason.PureSmallHotLoop;
}

test should_inline_accepts_constant_args_not_hot {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 5,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        inside_loop: false,
        constant_args: true,
        call_depth: 0,
        caller_size: 10,
        result_used: true,
    };
    const d = should_inline_call(callee, site);
    assert d.verdict == InlineVerdict.Inline;
    assert d.reason == InlineReason.PureSmallHotLoop;
}

test should_inline_refuses_test_callee {
    const callee = CalleeFacts {
        is_test: true,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        inside_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    const d = should_inline_call(callee, site);
    assert d.verdict == InlineVerdict.Reject;
    assert d.reason == InlineReason.TestCallee;
}

test should_inline_refuses_void_callee {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: true,
        body_stmts: 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        inside_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    const d = should_inline_call(callee, site);
    assert d.verdict == InlineVerdict.Reject;
    assert d.reason == InlineReason.VoidCallee;
}

