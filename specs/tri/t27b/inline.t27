test should_inline_refuses_cold_no_constants {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    var site = CallSiteFacts {
        hot_loop: false,
        constant_args: false,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
