// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/inline.t27 -- pure-function inlining decision for t27b codegen.
; The decision lives here, in t27, so every inline/reject is auditable,
; versioned, and tested. The Rust glue in cli/t27b collects facts about
; callee and call site, calls `should_inline_call`, and records the receipt.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bInline;

// ============================================================
// Budgets
// ============================================================

/// Maximum IR statements of an inlined callee's body.
pub const INLINE_MAX_STMTS : u32 = 24;

/// Maximum instructions the caller may grow by one inline.
pub const INLINE_MAX_CALLER_GROWTH : u32 = 64;

/// Maximum inline depth. Recursive calls are rejected.
pub const INLINE_MAX_DEPTH : u8 = 2;

// ============================================================
// Callee facts: what the caller reports about the callee
// ============================================================

pub const CalleeFacts = struct {
    is_test: bool,
    is_invariant: bool,
    ret_is_none: bool,
    body_stmts: u32,
    has_nested_call: bool,
    has_store: bool,
    has_copy: bool,
    has_assert: bool,
};

// ============================================================
// Call-site facts: context of the call
// ============================================================

pub const CallSiteFacts = struct {
    hot_loop: bool,
    constant_args: bool,
    call_depth: u8,
    caller_size: u32,
    result_used: bool,
};

// ============================================================
// The inline decision
// ============================================================

/// Is `callee` inlinable at call site `site`?
///
/// Rule:
///   callee is pure, value-returning, within stmt budget;
///   site is hot or has constant arguments;
///   caller growth stays within budget;
///   depth is bounded.
///
/// Side-effect-free only. Nothing outside this rule may inline.
pub fn should_inline_call(callee: CalleeFacts, site: CallSiteFacts) -> bool {
    if (callee.is_test) { return false; }
    if (callee.is_invariant) { return false; }
    if (callee.ret_is_none) { return false; }
    if (callee.body_stmts > INLINE_MAX_STMTS) { return false; }
    if (callee.has_nested_call) { return false; }
    if (callee.has_store) { return false; }
    if (callee.has_copy) { return false; }
    if (callee.has_assert) { return false; }
    if (site.call_depth >= INLINE_MAX_DEPTH) { return false; }
    if ((site.hot_loop == false) and (site.constant_args == false)) { return false; }
    // Estimated caller growth: callee body statements minus the call itself.
    const growth : u32 = callee.body_stmts;
    if (growth > INLINE_MAX_CALLER_GROWTH) { return false; }
    return true;
}

// ============================================================
// Decision receipt: recorded for every call site
// ============================================================

pub const InlineDecision = enum(u32) {
    Inline = 0,
    Reject = 1,
};

pub const InlineReceipt = struct {
    callee_id: u32,
    call_site_id: u32,
    decision: InlineDecision,
    reason: str,
    callee_stmts: u32,
    estimated_caller_growth: u32,
    depth: u8,
};

// ============================================================
// Invariants (L4)
// ============================================================

invariant should_inline_refuses_side_effects {
    // Any callee with a side effect must not inline.
    const bad = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 1,
        has_nested_call: false,
        has_store: true,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        hot_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    assert should_inline_call(bad, site) == false;
}

invariant should_inline_refuses_over_depth {
    // Depth at or above the bound is rejected even for a perfect callee.
    const good = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const deep = CallSiteFacts {
        hot_loop: true,
        constant_args: true,
        call_depth: INLINE_MAX_DEPTH,
        caller_size: 0,
        result_used: true,
    };
    assert should_inline_call(good, deep) == false;
}

invariant should_inline_refuses_cold_small_callee {
    // Not hot and no constant args: reject even a tiny pure callee.
    const good = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const cold = CallSiteFacts {
        hot_loop: false,
        constant_args: false,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    assert should_inline_call(good, cold) == false;
}

// ============================================================
// Tests
// ============================================================

test should_inline_accepts_pure_small_hot_call {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 3,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        hot_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 10,
        result_used: true,
    };
    assert should_inline_call(callee, site) == true;
}

test should_inline_accepts_constant_args_not_hot {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 5,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        hot_loop: false,
        constant_args: true,
        call_depth: 0,
        caller_size: 10,
        result_used: true,
    };
    assert should_inline_call(callee, site) == true;
}

test should_inline_refuses_test_callee {
