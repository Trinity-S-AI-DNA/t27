}

test should_inline_refuses_assert {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: true,
    };
    const site = CallSiteFacts {
        inside_loop: true,
