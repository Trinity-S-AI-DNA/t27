    assert should_inline_call(callee, site) == false;
}

// ============================================================
// Select-shaped callee: compare + cset/csel instead of a call
// ============================================================
//
// A callee whose whole body is `if (x OP y) { return a; } return b;` with
// integer constants a, b is a select of two constants on one compare. The
// glue reports the facts of that shape; this law decides whether t27b may
// emit `cmp; cset|csel` in place of `bl`. Soundness rests on refusals:
// only 64-bit integer parameters, return and compare (no float, no i128,
// no narrow type whose compare would need an extension), operands that are
// a parameter or an imm12 constant, and the existing should_inline_call
// verdict, which the glue also requires.

/// Operand kinds the glue reports.
pub const SK_OTHER : u8 = 0;
pub const SK_PARAM : u8 = 1;
pub const SK_IMM : u8 = 2;

/// Largest compare immediate plus one (cmp imm12).
pub const SELECT_IMM_LIMIT : u64 = 4096;

/// Result forms.
pub const SF_CSET : u32 = 1;
pub const SF_CSET_INV : u32 = 2;
pub const SF_CSEL : u32 = 3;

/// Is an operand a parameter of the callee or an imm12 constant?
pub fn select_operand_ok(kind: u8, val: u64, nparams: u32) -> bool {
    if (kind == SK_PARAM) { return val < nparams; }
    if (kind == SK_IMM) { return val < SELECT_IMM_LIMIT; }
    return false;
}

/// May the callee be lowered as compare + cset/csel?
/// shape_ok: body is exactly [If{cmp, then:[Return(Const)], else: empty}, Return(Const)].
pub fn select_shape_ok(shape_ok: bool, lk: u8, lv: u64, rk: u8, rv: u64, nparams: u32, params_64: bool, ret_64: bool, cmp_64: bool) -> bool {
    if (shape_ok == false) { return false; }
    if (params_64 == false) { return false; }
    if (ret_64 == false) { return false; }
    if (cmp_64 == false) { return false; }
    if (select_operand_ok(lk, lv, nparams) == false) { return false; }
    if (select_operand_ok(rk, rv, nparams) == false) { return false; }
    // Two constants would be a folded compare, not a select of arguments.
    if ((lk == SK_IMM) and (rk == SK_IMM)) { return false; }
    return true;
}

/// Result form of `cond ? a : b` over 64-bit words.
pub fn select_form(a: u64, b: u64) -> u32 {
    if ((a == 1) and (b == 0)) { return SF_CSET; }
    if ((a == 0) and (b == 1)) { return SF_CSET_INV; }
    return SF_CSEL;
}

test select_accepts_param_vs_param {
    assert select_shape_ok(true, SK_PARAM, 0, SK_PARAM, 1, 2, true, true, true) == true;
}

test select_accepts_param_vs_imm {
    assert select_shape_ok(true, SK_PARAM, 0, SK_IMM, 4095, 1, true, true, true) == true;
}

test select_accepts_imm_vs_param {
    assert select_shape_ok(true, SK_IMM, 0, SK_PARAM, 0, 1, true, true, true) == true;
}

test select_refuses_other_shape {
    assert select_shape_ok(false, SK_PARAM, 0, SK_PARAM, 1, 2, true, true, true) == false;
}

test select_refuses_narrow_or_float_param {
    assert select_shape_ok(true, SK_PARAM, 0, SK_PARAM, 1, 2, false, true, true) == false;
}

test select_refuses_narrow_or_float_return {
    assert select_shape_ok(true, SK_PARAM, 0, SK_PARAM, 1, 2, true, false, true) == false;
}

test select_refuses_narrow_or_float_compare {
    assert select_shape_ok(true, SK_PARAM, 0, SK_PARAM, 1, 2, true, true, false) == false;
}

test select_refuses_param_out_of_range {
    assert select_shape_ok(true, SK_PARAM, 0, SK_PARAM, 2, 2, true, true, true) == false;
}

test select_refuses_imm_over_imm12 {
    assert select_shape_ok(true, SK_PARAM, 0, SK_IMM, 4096, 1, true, true, true) == false;
}

test select_refuses_other_operand {
    assert select_shape_ok(true, SK_OTHER, 0, SK_PARAM, 0, 1, true, true, true) == false;
}

test select_refuses_two_constants {
    assert select_shape_ok(true, SK_IMM, 1, SK_IMM, 2, 1, true, true, true) == false;
}

test select_form_one_zero_is_cset {
    assert select_form(1, 0) == SF_CSET;
}

test select_form_zero_one_is_inverted_cset {
    assert select_form(0, 1) == SF_CSET_INV;
}

test select_form_other_constants_are_csel {
    assert select_form(7, 9) == SF_CSEL;
    assert select_form(1, 1) == SF_CSEL;
    assert select_form(0, 0) == SF_CSEL;
    assert select_form(0, 2) == SF_CSEL;
}

