test should_inline_refuses_over_stmt_budget {
    var callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: INLINE_MAX_STMTS + 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        hot_loop: true,
        constant_args: true,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    assert should_inline_call(callee, site) == false;
}

test should_inline_accepts_at_stmt_budget {
    var callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: INLINE_MAX_STMTS,
        has_nested_call: false,
