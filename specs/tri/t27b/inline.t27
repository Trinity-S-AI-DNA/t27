test should_inline_refuses_cold_no_constants {
    const callee = CalleeFacts {
        is_test: false,
        is_invariant: false,
        ret_is_none: false,
        body_stmts: 1,
        has_nested_call: false,
        has_store: false,
        has_copy: false,
        has_assert: false,
    };
    const site = CallSiteFacts {
        inside_loop: false,
        constant_args: false,
        call_depth: 0,
        caller_size: 0,
        result_used: true,
    };
    const d = should_inline_call(callee, site);
    assert d.verdict == InlineVerdict.Reject;
    assert d.reason == InlineReason.ColdNoConstants;
}

