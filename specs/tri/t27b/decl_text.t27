// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/decl_text.t27 -- declaration text utilities for t27b (port epic #6198, issue #8590).
; These functions were hand-written Rust in cli/t27b/src/lower.rs (`decl_line`, `parse_int`) and are now
; implemented in t27 with thin glue in the generated Rust code.
; --
; Functions:
; - decl_line: finds the line number of a declaration in source text
; - parse_int: parses an integer literal from source text
; Both functions filter out "NO" values and return Option<T>.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bDeclText;

use tri::t27b::source_text;

/// Line (1-based) of the declaration of `name` in source text `s`.
/// Returns None if the declaration is not found (NO_LINE).
pub fn decl_line(s: []const u8, name: []const u8) -> ?u32 {
    const line = source_text::decl_line(s, name);
    if (line == source_text::NO_LINE) {
        return null;
    }
    return line;
}

/// Parse an integer literal from text `s`.
/// Returns None if the text is not a valid integer (NO_INT).
pub fn parse_int(s: []const u8) -> ?i128 {
    const value = source_text::parse_int(s);
    if (value == source_text::NO_INT) {
        return null;
    }
    return value;
}

// ----------------------------------------------------------------------------------------------------------
// Tests
// ----------------------------------------------------------------------------------------------------------

test decl_line_finds_const_declaration {
    const src = "const x = 42;\nconst y = 100;";
    assert decl_line(src, "x") == 1;
    assert decl_line(src, "y") == 2;
    assert decl_line(src, "nonexistent") == null;
}

test decl_line_finds_pub_const_declaration {
    const src = "pub const x = 42;\npub const y = 100;";
    assert decl_line(src, "x") == 1;
    assert decl_line(src, "y") == 2;
    assert decl_line(src, "nonexistent") == null;
}

test decl_line_finds_enum_declaration {
    const src = "enum Color { Red, Green, Blue }\nenum Status { Active, Inactive };";
    assert decl_line(src, "Color") == 1;
    assert decl_line(src, "Status") == 2;
    assert decl_line(src, "nonexistent") == null;
}

test decl_line_finds_pub_enum_declaration {
    const src = "pub enum Color { Red, Green, Blue }\npub enum Status { Active, Inactive };";
    assert decl_line(src, "Color") == 1;
    assert decl_line(src, "Status") == 2;
    assert decl_line(src, "nonexistent") == null;
}

test parse_int_decimal {
    assert parse_int("42") == 42;
    assert parse_int("0") == 0;
    assert parse_int("1234567890") == 1234567890;
    assert parse_int("nonexistent") == null;
}

test parse_int_hex {
    assert parse_int("0x10") == 16;
    assert parse_int("0xFF") == 255;
    assert parse_int("0x0") == 0;
    assert parse_int("0xabc") == 2748;
    assert parse_int("0xxyz") == null;
}

test parse_int_binary {
    assert parse_int("0b1010") == 10;
    assert parse_int("0b1") == 1;
    assert parse_int("0b0") == 0;
    assert parse_int("0b102") == null;
}

test parse_int_octal {
    assert parse_int("0o755") == 493;
    assert parse_int("0o0") == 0;
    assert parse_int("0o777") == 511;
    assert parse_int("0o788") == null;
}

test parse_int_with_underscores {
    assert parse_int("1_000_000") == 1000000;
    assert parse_int("0xFF_FF") == 65535;
    assert parse_int("1_000") == 1000;
    assert parse_int("_1000") == null;
}

test parse_int_with_plus {
    assert parse_int("+42") == 42;
    assert parse_int("+0x10") == 16;
    assert parse_int("++42") == null;
    assert parse_int("+") == null;
}

test parse_int_empty_string {
    assert parse_int("") == null;
}

test parse_int_too_large {
    // This should return null if the value exceeds i128::MAX
    const large_num = "170141183460469231731687303715884105728"; // i128::MAX + 1
    assert parse_int(large_num) == null;
}