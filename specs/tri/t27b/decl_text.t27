// lower.rs move to specs/tri/t27b/decl_text.t27.
// Part of M10 milestone (milestone #14). Closes #8590.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tri::t27b::decl_text;

pub const DECL_TEXT_MAX : u32 = 1024;

pub struct DeclText { name: str, text: str };

pub fn decl_text_name(d: DeclText) -> str {
    return d.name;
}

test "decl_text_name" {
    assert(decl_text_name(DeclText { name: "foo", text: "bar" }) == "foo");
}

invariant decl_text_max_positive {
    assert DECL_TEXT_MAX > 0;
}