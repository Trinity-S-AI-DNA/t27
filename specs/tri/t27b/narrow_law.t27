// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/narrow_law.t27 -- the canonical-form extension law of t27b
; AArch64 codegen. A narrow type lives in the low bits of its register in
; canonical form: u8/u16/bool zero-extended (uxtb/uxth), i8/i16 sign-extended
; (sxtb/sxth), the upper 32 bits undefined; a 32-bit-or-wider type needs no
; extension instruction. The codes are a64.t27's Ext encoding (Uxtb 0, Uxth 1,
; Sxtb 4, Sxth 5), so the glue maps the generated number mechanically; the
; CHOICE is the spec's.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bNarrowLaw;

; a64.t27 Ext: Uxtb = 0, Uxth = 1, Uxtw = 2, Uxtx = 3, Sxtb = 4, Sxth = 5, Sxtw = 6, Sxtx = 7.
pub const EXT_NONE : u32 = 255;
pub const EXT_UXTB : u32 = 0;
pub const EXT_UXTH : u32 = 1;
pub const EXT_SXTB : u32 = 4;
pub const EXT_SXTH : u32 = 5;

; The extension for a type of `bits` bits, `signed`, `boolean`; odd widths
; (u1..u31 other than 8 and 16) never take a narrow extension, they normalise
; by their own re-normalisation path in the emitter.
pub fn narrow_ext(bits: u32, signed: bool, boolean: bool) -> u32 {
    if (boolean) { return EXT_UXTB; }
    if (bits == 8) {
        if (signed) { return EXT_SXTB; }
        return EXT_UXTB;
    }
    if (bits == 16) {
        if (signed) { return EXT_SXTH; }
        return EXT_UXTH;
    }
    return EXT_NONE;
}

test narrow_unsigned_zero_extends_and_narrow_signed_sign_extends {
    assert narrow_ext(1, false, true) == EXT_UXTB;
    assert narrow_ext(8, false, false) == EXT_UXTB;
    assert narrow_ext(16, false, false) == EXT_UXTH;
    assert narrow_ext(8, true, false) == EXT_SXTB;
    assert narrow_ext(16, true, false) == EXT_SXTH;
}
test wide_foreign_and_odd_kinds_need_no_extension {
    assert narrow_ext(32, false, false) == EXT_NONE;
    assert narrow_ext(64, true, false) == EXT_NONE;
    assert narrow_ext(128, true, false) == EXT_NONE;
    assert narrow_ext(64, false, false) == EXT_NONE;
    assert narrow_ext(24, false, false) == EXT_NONE;
    assert narrow_ext(8, false, false) != EXT_NONE;
}
test the_codes_are_a64s_ext_encoding {
    assert EXT_UXTB == 0;
    assert EXT_UXTH == 1;
    assert EXT_SXTB == 4;
    assert EXT_SXTH == 5;
    assert EXT_NONE == 255;
    assert EXT_UXTB != EXT_SXTB;
}
