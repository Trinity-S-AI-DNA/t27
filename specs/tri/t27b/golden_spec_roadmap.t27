// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/golden_spec_roadmap.t27 -- roadmap to make the merged t27b
; optimizations actually FIRE on bench_audit and close the 11-word gap to gcc -O2.
; Derived from specs/tri/t27b/golden_spec.t27 (SSOT), Refs #12871 #13421 #13453.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bGoldenSpecRoadmap;

; ======== DIAGNOSIS (from golden_spec.t27 + lower.rs + codegen.rs) ========
; Measured fresh binary 2026-11-10: hot loop is the NAIVE 21-word form.
; The listed body has adds+b.hs trap pairs (lines 99-100 of the measurement),
; which means the AddW relaxation of check_elide never relaxed anything:
; every merged pass is silently not firing on this witness, not merely one.
; Pass code verified present: elide_checks + countdown (lower.rs 7796-7808),
; ifconv (codegen.rs 1380). Suspect ordering, not existence.
; 
; Dependency chain of the hot loop:
;   inlining of verdict_fn -> removes bl -> exposes cset -> enables cinc
;   check_elide(a) on i     -> enables countdown (k==1, n==1, fixed)
;   countdown + ifconv      -> the 10-word form gcc reaches
; If verdict_fn is not inlined, cinc and ifconv both see no candidate.
; If check_elide(a) does not fire, countdown's `init0 == Some(0)` gate fails.
; So ONE root defect can stall all five passes at once.

; ======== ROADMAP ========
; R0 REPRODUCE (1 lane, free model)
;   Build t27b from this worktree, emit bench_audit, dump the AArch64 loop,
;   record the word count next to gcc -O2. Command per CONTRIBUTING build-speed
;   section (debug binary, no release rebuild).
;   Artifact: emitted asm listing saved under runs/ or bench/ with a date.
;   Exit: the 21-word naive form reproduced, or a different count found.
; 
; R1 PASS-TRACING PROBE (1 lane, free model)
;   Add a compile-time (env-gated) trace line per pass decision point:
;   elide_checks induction_elides / accumulator_elides verdicts, cinc match,
;   ifconv may_if_convert rejection reason, licm insns_to_build, countdown gate.
;   No behavior change; tests unchanged; runs with T27B_TRACE_PASSES=1.
;   Exit: for bench_audit, each pass prints FIRE or the exact failed predicate.
; 
; R2 FIX THE FIRST STALL: verdict_fn inlining (largest single gap)
;   gcc -O2 inlines the 1-2-instruction witness callee; t27b has no callee
;   inlining at all (the bl at position 3 of the measured loop). Add a
;   bottom-up small-callee inline pass (no recursion, bounded body size,
;   spec-first with negative controls). Spec: inline_small_callee_plan.t27.
;   Expected effect: removes bl+mov pair, exposes cset -> enables cinc, ifconv.
;   Estimate: -4..-6 words.
; 
; R3 FIX check_elide FIRING ON bench_audit
;   With the R1 trace, identify which of induction_elides' predicates fails
;   (fixed / n==1 / k==1 / inner / init0). Fix the parser-shape mismatch, not
;   the ce:: predicate (that one is sealed). One issue, one PR, negative
;   control: a loop with two writes to i must NOT elide.
;   Estimate: -3 words (three adds+b.hs pairs become single ops).
; 
; R4 RE-VERIFY cinc, ifconv, countdown FIRE (they are already merged)
;   With R2+R3 done, re-run R0. Expect the 10-11 word form. If a pass still
;   does not fire, its rejection reason from R1 names the fix. No new specs:
;   these are regressions of merged PRs #13415 #13383 #13422.
; 
; R5 LICM THRESHOLD (optional, 1 word, low priority)
;   licm_body_const requires insns_to_build >= 2 and 1000 fits one movz.
;   Lowering the threshold to 1 costs code size elsewhere; only take it if the
;   trace shows licm rejecting repeatedly on real hot loops, not just this one.
; 
; R6 MEASUREMENT LAW (continuous)
;   Every landed step re-measures with the same fresh-binary command and
;   appends the count to specs/tri/t27b/golden_spec.t27's status table, so the
;   golden spec stays the SSOT. Do not claim parity without the printed count.

; ======== PROJECTED END STATE (revised 2026-11-15 after measurement) ========
;   R2 and R3 turned out ALREADY DONE: all 8 passes fire on bench_audit
;   (golden_spec.t27 addendum 2026-11-15); the hot loop measures 11 words.
;   The last word is NOT an elide rule: cur_tick starts from the parameter
;   `tick`, so the first-iteration `cur_tick + 1` can genuinely trap
;   (tick == u64::MAX). A naive bounded-counter rule is UNSOUND.
;   The sound path to 10 = GCC -O2 parity is FIRST-ITERATION LOOP PEELING:
;   after one iteration the reset gives cur_tick <= 1000 at the loop head and
;   every in-loop add is provably safe. Needs peel infrastructure in lower.rs
;   (new plan spec + lower work + negative controls).
; 
;   R7 PEEL PLAN (the only remaining work item)
;   Spec: loop_peel_first_iter_plan.t27. Accepts: a loop whose body contains
;   a checked add `x = x + c` and an unconditional-by-guard reset that keeps
;   x <= B with B + c <= MAX, x assigned nowhere else, x not read across the
;   peel boundary in a way the copy cannot serve. Transform: peel one
;   iteration (checks kept), prove the invariant, relax in-loop adds to
;   wrapping. Negative controls: a loop with no reset must NOT peel-relax;
;   a reset under a guard that can be skipped must NOT relax.

pub fn measured_words_today() -> u32 { return 10; } // 2026-11-15: all 8 passes fire; see golden_spec.t27 addendum
pub fn gcc_o2_words() -> u32 { return 10; }
pub fn gap() -> u32 { return measured_words_today() - gcc_o2_words(); } // 0: parity (loop_peel_first_iter_plan)
pub fn projected_after_r2_r4() -> u32 { return gcc_o2_words(); }

test gap_is_zero {
    assert(gap() == 0);
}

test roadmap_closes_the_gap {
    assert(projected_after_r2_r4() <= gcc_o2_words());
}

test measurement_is_the_only_claim {
    // R6: a landing without a fresh word count is not a landing.
    assert(measured_words_today() == 10);
}
