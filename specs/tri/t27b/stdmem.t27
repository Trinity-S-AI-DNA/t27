// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/stdmem.t27 -- the std routines t27b runs for `std.mem.trim`, `std.mem.indexOfScalar`
; and `std.math.approxEqAbs`, written in t27 (issue #8965, the last lane of the t27b coverage epic
; #6063, for specs/port/trinity/src/phi-engine/vibeec_original/bogatyrs_spec_structure.t27; written
; in t27 under the port epic #6198).
; gen-zig prints these calls as written, so the reference runs Zig 0.16's own std for them. t27b
; has no Zig std, so it splices these fns into a program that uses one of them, renamed from PORT
; to HELPER (specs/tri/t27b/stdmem_plan.t27 decides when), and lowers the call to a call of the
; routine -- the same contract as specs/tri/t27b/libm.t27's routines.
; --
; The semantics are Zig 0.16's lib/std, measured on the t27b lab (Debug, x86_64, the backend
; `t27c test-report` builds with) and read from the lab's Zig sources:
;   - `std.mem.trim` (mem.zig:1202): two loops; while the first remaining byte is one of the
;     cutset's, advance; while the last remaining byte is one of the cutset's, retreat; the slice
;     between them. Membership, not a prefix: trim("abc", "cba") is empty. An empty cutset trims
;     nothing; a string of only cutset bytes trims to empty; inner bytes stay.
;   - `std.mem.indexOfScalar` is mem.zig:1216's `findScalar`: the first index of the byte from 0,
;     or null when the slice does not hold it; an empty slice holds nothing.
;   - `std.math.approxEqAbs` (math.zig:76): `x == y` first (so equal infinities answer true at any
;     tolerance, and either NaN answers false), then `@abs(x - y) <= tolerance` -- inclusive: a
;     difference exactly at the tolerance is inside. A negative tolerance is an assert, which in
;     Debug is a panic before the comparison.
; --
; Every measured row below is pinned by a test: the ten trim cases, the eleven find cases, the
; sixteen approx cases, and the corpus shape end to end (the four keys the bogatyrs checker reads
; out of a spec text).
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bStdmem;

// std.mem.trim (mem.zig:1202): membership at both ends, then the slice between.
fn t27b_stdmem_trim(slice: str, values_to_strip: str) -> str {
    var begin: usize = 0;
    var end: usize = slice.len;
    while (begin < end and t27b_stdmem_find(values_to_strip, slice[begin]) != null) {
        begin = begin + 1;
    }
    while (end > begin and t27b_stdmem_find(values_to_strip, slice[end - 1]) != null) {
        end = end - 1;
    }
    return slice[begin..end];
}

// std.mem.indexOfScalar, which is mem.zig:1216's findScalar: the first index of `value`, or null.
fn t27b_stdmem_find(slice: str, value: u8) -> ?usize {
    var i: usize = 0;
    while (i < slice.len) {
        if (slice[i] == value) {
            return i;
        }
        i = i + 1;
    }
    return null;
}

// std.mem.indexOf (mem.zig's indexOfPos, measured: the index of the first occurrence, a longer
// needle never found, an empty one always found at 0): the search `!= null` / `== null` reads.
fn t27b_stdmem_index_of(hay: str, needle: str) -> ?usize {
    if (needle.len > hay.len) {
        return null;
    }
    var i: usize = 0;
    while (i + needle.len <= hay.len) {
        var j: usize = 0;
        while (j < needle.len) {
            if (hay[i + j] != needle[j]) {
                break;
            }
            j = j + 1;
        }
        if (j == needle.len) {
            return i;
        }
        i = i + 1;
    }
    return null;
}

// std.math.approxEqAbs of f64 (math.zig:76): equal first (so inf matches inf and NaN matches
// nothing), then the inclusive absolute-difference test. The negative-tolerance assert of Zig's
// Debug build is the same panic here.
fn t27b_stdmem_approx_eq_abs(x: f64, y: f64, tolerance: f64) -> bool {
    if (tolerance < 0.0) {
        @panic("std.math.approxEqAbs: tolerance must be >= 0");
    }
    if (x == y) {
        return true;
    }
    if (x != x or y != y) {
        return false;
    }
    return @abs(x - y) <= tolerance;
}

test trim_ten_measured_cases {
    assert(t27b_stdmem_trim("  abc\t", " \t\r") == "abc");
    assert(t27b_stdmem_trim("  abc\t", " \t\r").len == 3);
    assert(t27b_stdmem_trim("xxxabcx", "x") == "abc");
    assert(t27b_stdmem_trim("", " x") == "");
    assert(t27b_stdmem_trim("  ", " ") == "");
    assert(t27b_stdmem_trim("a", "") == "a");
    assert(t27b_stdmem_trim("  name  :  test_spec  ", " ") == "name  :  test_spec");
    assert(t27b_stdmem_trim("abc", "cba") == "");
    assert(t27b_stdmem_trim("abcba", "ab") == "c");
    assert(t27b_stdmem_trim(" \t\r version:1.0\t ", " \t\r") == "version:1.0");
    assert(t27b_stdmem_trim("::x::", ":") == "x");
}

test find_eleven_measured_cases {
    assert(t27b_stdmem_find("name: v", ':') == 4);
    assert(t27b_stdmem_find(":lead", ':') == 0);
    assert(t27b_stdmem_find("no colon here", ':') == null);
    assert(t27b_stdmem_find("", ':') == null);
    assert(t27b_stdmem_find("a:b:c", ':') == 1);
    assert(t27b_stdmem_find("::", ':') == 0);
    assert(t27b_stdmem_find("tail:", ':') == 4);
    assert(t27b_stdmem_find("abc", 'a') == 0);
    assert(t27b_stdmem_find("abc", 'c') == 2);
    assert(t27b_stdmem_find("abc", 'z') == null);
    var found = t27b_stdmem_find("name: v", ':');
    assert(found != null);
    assert(found.? == 4);
}

test index_of_eight_measured_cases {
    assert(t27b_stdmem_index_of("name: v", "name").? == 0);
    assert(t27b_stdmem_index_of("name: v", ": ").? == 4);
    assert(t27b_stdmem_index_of("name: v", "v:") == null);
    assert(t27b_stdmem_index_of("aaa", "aa").? == 0);
    assert(t27b_stdmem_index_of("", "").? == 0);
    assert(t27b_stdmem_index_of("x", "").? == 0);
    assert(t27b_stdmem_index_of("", "x") == null);
    assert(t27b_stdmem_index_of("short", "shorter than hay") == null);
}

test approx_sixteen_measured_cases {
    assert(t27b_stdmem_approx_eq_abs(3.0, 3.0, 0.0) == true);
    assert(t27b_stdmem_approx_eq_abs(3.0, 3.0001, 0.0001) == false);
    assert(t27b_stdmem_approx_eq_abs(3.0, 3.0001001, 0.0001) == false);
    assert(t27b_stdmem_approx_eq_abs(3.0, 3.0000999, 0.0001) == true);
    assert(t27b_stdmem_approx_eq_abs(0.0, 0.5, 0.5) == true);
    assert(t27b_stdmem_approx_eq_abs(std.math.nan(f64), 1.0, 1.0) == false);
    assert(t27b_stdmem_approx_eq_abs(1.0, std.math.nan(f64), 1.0) == false);
    assert(t27b_stdmem_approx_eq_abs(0.0, -0.0, 0.0) == true);
    assert(t27b_stdmem_approx_eq_abs(std.math.inf(f64), std.math.inf(f64), 1.0) == true);
    assert(t27b_stdmem_approx_eq_abs(std.math.inf(f64), -std.math.inf(f64), 1.0) == false);
    assert(t27b_stdmem_approx_eq_abs(std.math.inf(f64), std.math.inf(f64), 0.0) == true);
    assert(t27b_stdmem_approx_eq_abs(-std.math.inf(f64), -std.math.inf(f64), 0.0) == true);
    assert(t27b_stdmem_approx_eq_abs(-1.0, 1.0, 2.0) == true);
    assert(t27b_stdmem_approx_eq_abs(-1.0, 1.0, 1.9999999999999998) == false);
    assert(t27b_stdmem_approx_eq_abs(3.0, 3.0, 0.0001) == true);
    assert(t27b_stdmem_approx_eq_abs(1.618033988749895, 1.6180339887498648, 0.0001) == true);
}

; The corpus shape, end to end: the four keys the bogatyrs spec-structure checker reads out of a
; spec text (the strings of its seven structure tests, one of them verbatim).
fn t27b_stdmem_has_key(line: str, key: str) -> bool {
    var trimmed = t27b_stdmem_trim(line, " \t\r");
    var colon = t27b_stdmem_find(trimmed, ':');
    if (colon != null and colon.? > 0) {
        var found = t27b_stdmem_trim(trimmed[0..colon.?], " ");
        return found == key;
    }
    return false;
}

test corpus_shape_reads_the_four_keys {
    var text = "  name  :  test_spec  \nversion:\"1.0.0\"\n  language:zig\nmodule:test_spec";
    assert(t27b_stdmem_has_key("  name  :  test_spec  ", "name"));
    assert(t27b_stdmem_has_key("version:\"1.0.0\"", "version"));
    assert(t27b_stdmem_has_key("  language:zig", "language"));
    assert(t27b_stdmem_has_key("module:test_spec", "module"));
    assert(t27b_stdmem_has_key("# a comment line", "name") == false);
    assert(t27b_stdmem_has_key("no colon here", "name") == false);
    assert(t27b_stdmem_has_key(": leading colon", "name") == false);
    assert(t27b_stdmem_has_key("  ", "name") == false);
}
