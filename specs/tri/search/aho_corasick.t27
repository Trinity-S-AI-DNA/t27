// t27/specs/
// Aho-Corasick string matching algorithm | φ² + 1/φ² = 3 | TRINITY

module TriAhoCorasick;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // The trie lives in a fixed pool of 64 nodes, addressed by index, instead
    // of heap nodes linked by pointers (there is no allocator in this
    // dialect). Node 0 is the root. next[node * 256 + byte] is the child of
    // node on that byte, 0 meaning "no child" (the root is never a child).
    // fail[node] is the failure link; is_end[node] tells that a pattern ends
    // at node; hits[node] counts the patterns that end at node or at any node
    // on its failure chain, so one lookup tells whether a text position
    // matches. A pattern that does not fit in the pool is not inserted.
    //
    // The pattern list was a `[][]const u8` (a slice of sub-slices of the
    // comma-separated input). The Verilog backend cannot lower a 2-D array of
    // slices, so the list is kept as the source string plus start/end offsets:
    // pattern k is source[pattern_start[k]..pattern_end[k]] (see pattern_at),
    // for k < pattern_count, at most 256 patterns as in the original build.
    pub const ACAutomaton = struct {
        node_count : usize,
        next : [16384]usize,
        fail : [64]usize,
        is_end : [64]bool,
        hits : [64]usize,
        source : []const u8,
        pattern_start : [256]usize,
        pattern_end : [256]usize,
        pattern_count : usize,
    };

    pub const Match = struct {
        start : usize,
        end : usize,
        pattern : []const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // build(patterns: []const u8) → ACAutomaton
    // patterns is a comma-separated list; empty entries are ignored.
    fn build(patterns: []const u8) -> ACAutomaton {
        // Parse comma-separated patterns
        // (stored as start/end offsets into `patterns`, see ACAutomaton)
        var pattern_start : [256]usize = [0] ** 256;
        var pattern_end : [256]usize = [0] ** 256;
        var pattern_count : usize = 0;

        if (patterns.len > 0) {
            var start : usize = 0;
            for (i in 0..patterns.len) {
                if (patterns[i] == ',') {
                    pattern_start[pattern_count] = start;
                    pattern_end[pattern_count] = i;
                    pattern_count += 1;
                    start = i + 1;
                }
            }
            // Add last pattern
            pattern_start[pattern_count] = start;
            pattern_end[pattern_count] = patterns.len;
            pattern_count += 1;
        }

        var ac = ACAutomaton{
            .node_count = 1,
            .next = [0] ** 16384,
            .fail = [0] ** 64,
            .is_end = [false] ** 64,
            .hits = [0] ** 64,
            .source = patterns,
            .pattern_start = pattern_start,
            .pattern_end = pattern_end,
            .pattern_count = pattern_count,
        };

        // Insert patterns into the trie
        for (k in 0..pattern_count) {
            let len = pattern_end[k] - pattern_start[k];
            // an empty entry would mark the root; the pool must have room
            // for the worst case of len new nodes
            if (len > 0 and ac.node_count + len <= 64) {
                var node : usize = 0;
                for (j in 0..len) {
                    let index = patterns[pattern_start[k] + j] as usize;
                    if (ac.next[node * 256 + index] == 0) {
                        ac.next[node * 256 + index] = ac.node_count;
                        ac.node_count += 1;
                    }
                    node = ac.next[node * 256 + index];
                }
                ac.is_end[node] = true;
            }
        }

        // Build failure links using BFS
        var queue : [64]usize = [0] ** 64;
        var queue_size : usize = 0;

        // Initialize root's children: their failure link is the root
        for (c in 0..256) {
            let child = ac.next[c];
            if (child != 0) {
                ac.fail[child] = 0;
                queue[queue_size] = child;
                queue_size += 1;
            }
        }

        // Build failure links for the other nodes, shallowest first, so the
        // failure target of a node is already finished when the node is
        var level : usize = 0;
        while (level < queue_size) {
            let current_node = queue[level];
            level += 1;

            // patterns ending here, or at a node on the failure chain
            var own : usize = 0;
            if (ac.is_end[current_node]) {
                own = 1;
            }
            ac.hits[current_node] = own + ac.hits[ac.fail[current_node]];

            for (m in 0..256) {
                let child = ac.next[current_node * 256 + m];
                if (child != 0) {
                    var fail_node = ac.fail[current_node];
                    while (fail_node != 0 and ac.next[fail_node * 256 + m] == 0) {
                        fail_node = ac.fail[fail_node];
                    }
                    ac.fail[child] = ac.next[fail_node * 256 + m];
                    queue[queue_size] = child;
                    queue_size += 1;
                }
            }
        }

        return ac;
    }

    // pattern_at(ac: *ACAutomaton, k: usize) -> []const u8
    // The k-th parsed pattern (what `ac.patterns[k]` was before).
    fn pattern_at(ac: *ACAutomaton, k: usize) -> []const u8 {
        return ac.source[ac.pattern_start[k]..ac.pattern_end[k]];
    }

    // search(ac: *ACAutomaton, text: []const u8, starts: []usize, ends: []usize) → usize
    // Finds every occurrence of every pattern in text, overlapping ones
    // included. Occurrence number n is text[starts[n]..=ends[n]] (an inclusive
    // end, as in Match.end); occurrences are reported in order of their end,
    // longest pattern first on a tie. starts and ends are caller-provided
    // buffers of equal length that replace the returned []Match: only the
    // occurrences that fit are written, but the return value is the total
    // number of occurrences.
    fn search(ac: *ACAutomaton, text: []const u8, starts: []usize, ends: []usize) -> usize {
        var total : usize = 0;
        var current : usize = 0;

        for (i in 0..text.len) {
            let index = text[i] as usize;

            // Traverse failure links until we find a matching child
            while (current != 0 and ac.next[current * 256 + index] == 0) {
                current = ac.fail[current];
            }
            // from the root a byte with no child simply stays at the root
            current = ac.next[current * 256 + index];

            // Check for matches along the failure chain, longest first
            var temp = current;
            while (ac.hits[temp] > 0) {
                if (ac.is_end[temp]) {
                    if (total < starts.len and total < ends.len) {
                        starts[total] = i + 1 - depth_of(ac, temp);
                        ends[total] = i;
                    }
                    total += 1;
                }
                temp = ac.fail[temp];
            }
        }

        return total;
    }

    // depth_of(ac: *ACAutomaton, node: usize) → usize
    // Length of the path from the root to node, which is the length of the
    // pattern that ends there. Walks the trie from the root by searching the
    // parent of node, which is small (at most 64 nodes).
    fn depth_of(ac: *ACAutomaton, node: usize) -> usize {
        var depth : usize = 0;
        var at = node;
        while (at != 0) {
            var parent : usize = 0;
            for (p in 0..ac.node_count) {
                for (c in 0..256) {
                    if (ac.next[p * 256 + c] == at) {
                        parent = p;
                    }
                }
            }
            at = parent;
            depth += 1;
        }
        return depth;
    }

    // deinit(ac: *ACAutomaton) → void
    // Nothing is heap-allocated; deinit empties the automaton so a stale
    // one cannot be searched by mistake (match reports false afterwards).
    fn deinit(ac: *ACAutomaton) -> void {
        ac.node_count = 0;
        ac.pattern_count = 0;
        for (i in 0..16384) {
            ac.next[i] = 0;
        }
    }

    // match(ac: *ACAutomaton) → bool
    // Validates the automaton structure: it has a root, and the root's
    // failure link is the root itself.
    fn match(ac: *ACAutomaton) -> bool {
        return ac.node_count >= 1 and ac.fail[0] == 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test build_basic_case {
        var automaton = build("he");
        // root plus one node per byte of "he"
        assert(automaton.node_count == 3);
        assert(automaton.pattern_count == 1);
        assert(match(&automaton) == true);
    }

    // "ushers" holds she (1..3), he (2..3) and hers (2..5). The original test
    // expected 2, counting only "he" and "she" and forgetting "hers", which
    // is also a pattern of the list and also occurs in the text.
    test search_basic_case {
        var ac = build("he,she,his,hers");
        var starts = []usize{0, 0, 0, 0};
        var ends = []usize{0, 0, 0, 0};
        let n = search(&ac, "ushers", starts, ends);
        assert(n == 3);
        assert(starts[0] == 1);
        assert(ends[0] == 3);
        assert(starts[1] == 2);
        assert(ends[1] == 3);
        assert(starts[2] == 2);
        assert(ends[2] == 5);
    }

    test deinit_basic_case {
        var ac = build("he,she,his,hers");
        assert(match(&ac) == true);
        deinit(&ac);
        assert(match(&ac) == false);
        assert(ac.pattern_count == 0);
    }

    test match_basic_case {
        var ac = build("abc");
        assert(match(&ac) == true);
        assert(ac.fail[0] == 0);
    }

    test build_with_empty_patterns {
        var automaton = build("");
        // only the root, no pattern
        assert(automaton.node_count == 1);
        assert(automaton.pattern_count == 0);
        assert(match(&automaton) == true);
    }

    test search_with_empty_text {
        var ac = build("test");
        var starts = []usize{0, 0};
        var ends = []usize{0, 0};
        assert(search(&ac, "", starts, ends) == 0);
    }

    test search_multiple_patterns {
        var ac = build("cat,bat,rat");
        var starts = []usize{0, 0, 0, 0};
        var ends = []usize{0, 0, 0, 0};
        let n = search(&ac, "the cat and the bat and the rat", starts, ends);
        assert(n == 3);
        assert(starts[0] == 4);
        assert(starts[1] == 16);
        assert(starts[2] == 28);
    }

    // aa at 0, 1, 2 and aaa at 0, 1: five occurrences in all
    test overlapping_patterns {
        var ac = build("aa,aaa");
        var starts = []usize{0, 0, 0, 0, 0, 0};
        var ends = []usize{0, 0, 0, 0, 0, 0};
        assert(search(&ac, "aaaa", starts, ends) == 5);
    }

    test single_character_patterns {
        var ac = build("a,b,c");
        var starts = []usize{0, 0, 0, 0};
        var ends = []usize{0, 0, 0, 0};
        let n = search(&ac, "abc", starts, ends);
        assert(n == 3);
        assert(starts[0] == 0);
        assert(starts[1] == 1);
        assert(starts[2] == 2);
    }

    test long_text_short_patterns {
        var ac = build("the");
        var starts = []usize{0, 0, 0, 0};
        var ends = []usize{0, 0, 0, 0};
        let n = search(&ac, "the quick brown fox jumps over the lazy dog", starts, ends);
        assert(n == 2);
        assert(starts[0] == 0);
        assert(starts[1] == 31);
    }

    // a count larger than the buffers is still reported in full
    test search_counts_beyond_the_buffers {
        var ac = build("a");
        var starts = []usize{0, 0};
        var ends = []usize{0, 0};
        assert(search(&ac, "aaaaa", starts, ends) == 5);
        assert(starts[1] == 1);
    }
