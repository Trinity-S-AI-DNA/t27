// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// O(n + m) time where n=text length, m=pattern length | φ² + 1/φ² = 3 | TRINITY

module TriKmp;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const KMPPrefix = struct {
        table : []usize,
        pattern : []const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // build_prefix(pattern: []const u8, table: []usize) → void
    // Fills table[0..m) with the prefix function of the pattern: table[k] is
    // the length of the longest proper prefix of pattern[0..=k] that is also
    // its suffix. The caller provides table with pattern.len slots.
    fn build_prefix(pattern: []const u8, table: []usize) -> void {
        let m = pattern.len;
        if (m == 0) {
            return;
        }
        table[0] = 0;
        var matched : usize = 0;
        for (j in 1..m) {
            while (matched > 0 and pattern[matched] != pattern[j]) {
                matched = table[matched - 1];
            }
            if (pattern[matched] == pattern[j]) {
                matched = matched + 1;
            }
            table[j] = matched;
        }
    }

    // search(text: []const u8, pattern: []const u8, table: []usize) → i64
    // Index of the first occurrence of pattern in text, or -1 when absent.
    // table is the caller-provided buffer for the prefix function
    // (pattern.len slots). An empty pattern matches at index 0.
    fn search(text: []const u8, pattern: []const u8, table: []usize) -> i64 {
        let m = pattern.len;
        if (m == 0) {
            return 0;
        }
        build_prefix(pattern, table);
        var matched : usize = 0;
        for (i in 0..text.len) {
            while (matched > 0 and pattern[matched] != text[i]) {
                matched = table[matched - 1];
            }
            if (pattern[matched] == text[i]) {
                matched = matched + 1;
            }
            if (matched == m) {
                return (i + 1 - m) as i64;
            }
        }
        return -1;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // "abacab" -> 0 0 1 0 1 2
    test build_prefix_basic_case {
        var table = []usize{0, 0, 0, 0, 0, 0};
        build_prefix("abacab", table);
        assert(table[0] == 0);
        assert(table[1] == 0);
        assert(table[2] == 1);
        assert(table[3] == 0);
        assert(table[4] == 1);
        assert(table[5] == 2);
    }

    // "aaaa" -> 0 1 2 3
    test build_prefix_repeated_byte {
        var table = []usize{9, 9, 9, 9};
        build_prefix("aaaa", table);
        assert(table[0] == 0);
        assert(table[1] == 1);
        assert(table[2] == 2);
        assert(table[3] == 3);
    }

    test search_basic_case {
        var table = []usize{0, 0, 0, 0, 0, 0, 0};
        assert(search("here is a simple example", "example", table) == 17);
    }

    // the pattern overlaps itself, so a restart after a partial match matters
    test search_overlapping_prefix {
        var table = []usize{0, 0, 0, 0, 0, 0};
        assert(search("aabaabaaab", "aabaaa", table) == 3);
        assert(search("abababc", "ababc", table) == 2);
    }

    test search_absent_pattern {
        var table = []usize{0, 0, 0};
        assert(search("aaaaaa", "aab", table) == -1);
        assert(search("", "a", table) == -1);
    }

    test search_empty_pattern {
        var table = []usize{};
        assert(search("abc", "", table) == 0);
    }
