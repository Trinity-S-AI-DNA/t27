// t27/specs/
// Check exhaustiveness at compile time when possible | φ² + 1/φ² = 3 | TRINITY

module SearchMatch;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Match = struct {
        matched : bool,
        captures : []MatchCapture,
    };

    pub const MatchCapture = struct {
        value : []const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // match_literal(input: []const u8) → bool
    // A literal pattern is valid when it is not empty.
    fn match_literal(input: []const u8) -> bool {
        return input.len > 0;
    }

    // match_type(type_name: []const u8) → bool
    // A type pattern is valid when the type name is not empty.
    fn match_type(type_name: []const u8) -> bool {
        return type_name.len > 0;
    }

    // exhaustive(cases: [][]const u8) → bool
    // A case list can be exhaustive only when it is not empty.
    fn exhaustive(cases: [][]const u8) -> bool {
        return cases.len > 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "match_literal_basic_case" {
        assert(match_literal("abc") == true);
        assert(match_literal("") == false);
    }

    test "match_type_basic_case" {
        assert(match_type("i64") == true);
        assert(match_type("") == false);
    }

    test "exhaustive_basic_case" {
        var cases : [2]str = ["red", "green"];
        var none : [0]str = [];
        assert(exhaustive(&cases) == true);
        assert(exhaustive(&none) == false);
    }
