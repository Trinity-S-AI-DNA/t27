// t27/specs/
// Skip sections of text using bad character rule | φ² + 1/φ² = 3 | TRINITY

module TriBoyerMoore;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const BMBadChar = struct {
        table : [256]usize,
        pattern_len : "usize",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // build_bad_char(pattern: []const u8) → BMBadChar
    // Bad character table (Horspool form): for a text byte c aligned with the
    // last pattern byte, table[c] is how far the pattern may move right.
    // Bytes absent from pattern[0..m-1) shift by the whole pattern length.
    fn build_bad_char(pattern: []const u8) -> BMBadChar {
        let m = pattern.len;
        var bad_char = BMBadChar {
            .table = [0] ** 256,
            .pattern_len = m,
        };

        // Every byte shifts by the full pattern length by default
        for (i in 0..256) {
            bad_char.table[i] = m;
        }

        // The last occurrence of each byte (the final pattern byte excluded)
        // gives the distance from that occurrence to the pattern end
        if (m > 1) {
            for (k in 0..m - 1) {
                let char_val = pattern[k] as usize;
                bad_char.table[char_val] = m - 1 - k;
            }
        }

        return bad_char;
    }

    // search(text: []const u8, pattern: []const u8) → i64
    // Index of the first occurrence of pattern in text, or -1 when absent.
    // An empty pattern matches at index 0.
    fn search(text: []const u8, pattern: []const u8) -> i64 {
        let m = pattern.len;
        let n = text.len;
        if (m == 0) {
            return 0;
        }
        if (m > n) {
            return -1;
        }

        let bad_char = build_bad_char(pattern);
        var pos : usize = 0;
        while (pos + m <= n) {
            // Compare from the last pattern byte backwards
            var k : usize = m;
            while (k > 0 and pattern[k - 1] == text[pos + k - 1]) {
                k = k - 1;
            }
            if (k == 0) {
                return pos as i64;
            }
            let last = text[pos + m - 1] as usize;
            pos = pos + bad_char.table[last];
        }
        return -1;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // pattern "abcab" (m = 5): a -> 1, b -> 3, c -> 2, anything else -> 5
    test build_bad_char_basic_case {
        let result = build_bad_char("abcab");
        assert(result.pattern_len == 5);
        assert(result.table[97] == 1);
        assert(result.table[98] == 3);
        assert(result.table[99] == 2);
        assert(result.table[122] == 5);
    }

    test build_bad_char_single_byte_pattern {
        let result = build_bad_char("x");
        assert(result.pattern_len == 1);
        assert(result.table[120] == 1);
        assert(result.table[97] == 1);
    }

    test search_basic_case {
        assert(search("here is a simple example", "example") == 17);
    }

    test search_finds_first_occurrence {
        assert(search("abcabcabc", "cab") == 2);
        assert(search("abc", "abc") == 0);
    }

    test search_absent_pattern {
        assert(search("here is a simple example", "exampled") == -1);
        assert(search("aaaaaa", "ab") == -1);
        assert(search("", "a") == -1);
    }

    test search_empty_pattern {
        assert(search("abc", "") == 0);
    }
