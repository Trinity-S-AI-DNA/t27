// t27/specs/
// May return true for items not added (false positive), never false negative | φ² + 1/φ² = 3 | TRINITY

module TriBloomFilter;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const BloomFilter = struct {
        bits : []bool,
        hash_count : usize,
        size : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Helper Functions
    // ═══════════════════════════════════════════════════════════

    // Simple hash function for bloom filter. The running value is reduced
    // modulo size at every step, so it stays below size and cannot overflow.
    fn hash_function(data: []const u8, seed: usize, size: usize) -> usize {
        var hash : usize = 0;
        for (i in 0..data.len) {
            hash = (hash * 31 + (data[i] as usize)) % size;
        }
        return (hash + seed * 7) % size;
    }

    // ═══════════════════════════════════════════════════════════
    // 4. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(bits: []bool, hash_count: usize) → BloomFilter
    // The bit array is caller-provided storage (the filter has bits.len bits);
    // init clears it.
    fn init(bits: []bool, hash_count: usize) -> BloomFilter {
        for (i in 0..bits.len) {
            bits[i] = false;
        }
        return BloomFilter { .bits = bits, .hash_count = hash_count, .size = bits.len };
    }

    // add(filter: *BloomFilter, item: []const u8) → void
    fn add(filter: *BloomFilter, item: []const u8) -> void {
        for (i in 0..filter.hash_count) {
            let hash = hash_function(item, i, filter.size);
            filter.bits[hash] = true;
        }
    }

    // contains(filter: *const BloomFilter, item: []const u8) → bool
    fn contains(filter: *const BloomFilter, item: []const u8) -> bool {
        for (i in 0..filter.hash_count) {
            let hash = hash_function(item, i, filter.size);
            if (!filter.bits[hash]) {
                return false;
            }
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "init_basic_case" {
        var storage : [100]bool = [true] ** 100;
        let result = init(&storage, 3);
        assert(result.size == 100);
        assert(result.hash_count == 3);
        assert(result.bits.len == 100);
        // init clears the storage it was given
        assert(result.bits[0] == false);
        assert(result.bits[99] == false);
    }

    test "add_basic_case" {
        var storage : [100]bool = [false] ** 100;
        var filter = init(&storage, 3);
        add(&filter, "test_item");
        assert(contains(&filter, "test_item") == true);
        assert(hash_function("test_item", 0, 100) < 100);
        assert(filter.bits[hash_function("test_item", 0, 100)] == true);
    }

    test "contains_basic_case" {
        var storage : [100]bool = [false] ** 100;
        var filter = init(&storage, 3);
        add(&filter, "test_item");
        assert(contains(&filter, "test_item") == true);
    }

    // nothing added yet: no item can be present
    test "contains_on_empty_filter" {
        var storage : [100]bool = [false] ** 100;
        var filter = init(&storage, 3);
        assert(contains(&filter, "test_item") == false);
        assert(contains(&filter, "") == false);
    }

    // never a false negative: every added item is found
    test "no_false_negatives" {
        var storage : [64]bool = [false] ** 64;
        var filter = init(&storage, 2);
        add(&filter, "alpha");
        add(&filter, "beta");
        add(&filter, "gamma");
        assert(contains(&filter, "alpha") == true);
        assert(contains(&filter, "beta") == true);
        assert(contains(&filter, "gamma") == true);
    }

    test "hash_function_is_deterministic_and_seeded" {
        assert(hash_function("abc", 0, 1000) == hash_function("abc", 0, 1000));
        // 'a' = 97, 'b' = 98, 'c' = 99: 97 -> (97 * 31 + 98) % 1000 = 105 -> (105 * 31 + 99) % 1000 = 354;
        // a seed of 2 adds 2 * 7 = 14
        assert(hash_function("abc", 0, 1000) == 354);
        assert(hash_function("abc", 2, 1000) == 368);
    }
