// t27/specs/
// O(log n) binary search | φ² + 1/φ² = 3 | TRINITY

module TriSearch;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SearchResult = struct {
        index : "?usize",
        found : "bool",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // binary(sorted: []const i64, target: i64) → SearchResult
    fn binary(sorted: []const i64, target: i64) -> SearchResult {
        // Binary search implementation
        var left : usize = 0;
        var right = sorted.len;
        
        while (left < right) {
            let mid = left + (right - left) / 2;
            if (sorted[mid] == target) {
                return SearchResult { .index = mid, .found = true };
            } else if (sorted[mid] < target) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }
        
        return SearchResult { .index = null, .found = false };
    }

    // linear(items: []const i64, target: i64) → SearchResult
    fn linear(items: []const i64, target: i64) -> SearchResult {
        // Linear search implementation
        var i : usize = 0;
        while (i < items.len) {
            if (items[i] == target) {
                return SearchResult { .index = i, .found = true };
            }
            i = i + 1;
        }
        
        return SearchResult { .index = null, .found = false };
    }

    // lower_bound(sorted: []const i64, value: i64) → usize
    fn lower_bound(sorted: []const i64, value: i64) -> usize {
        // Lower bound implementation - returns first index where element >= value
        var left : usize = 0;
        var right = sorted.len;
        
        while (left < right) {
            let mid = left + (right - left) / 2;
            if (sorted[mid] < value) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }
        
        return left;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "binary_basic_case" {
        var input = []i64{1, 2, 3, 4, 5};
        let result = binary(input, 3);
        assert(result.found == true);
        assert(result.index == 2);
    }

    test "binary_absent_target" {
        var input = []i64{1, 2, 3, 4, 5};
        let result = binary(input, 6);
        assert(result.found == false);
        assert(result.index == null);
    }

    test "linear_basic_case" {
        var input = []i64{10, 20, 30, 40, 50};
        let result = linear(input, 30);
        assert(result.found == true);
        assert(result.index == 2);
    }

    test "linear_absent_target" {
        var input = []i64{10, 20, 30, 40, 50};
        let result = linear(input, 35);
        assert(result.found == false);
        assert(result.index == null);
    }

    test "lower_bound_basic_case" {
        var input = []i64{1, 3, 5, 7, 9};
        let result = lower_bound(input, 4);
        assert(result == 2);
    }

    test "lower_bound_edges" {
        var input = []i64{1, 3, 5, 7, 9};
        assert(lower_bound(input, 0) == 0);
        assert(lower_bound(input, 9) == 4);
        assert(lower_bound(input, 10) == 5);
    }
