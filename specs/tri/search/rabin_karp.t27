// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// O(1) hash update when sliding window | φ² + 1/φ² = 3 | TRINITY

module TriRabinKarp;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const RKState = struct {
        pattern_hash : u64,
        pattern_len : usize,
        pattern : []const u8,
        base : u64,
        modulus : u64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(pattern: []const u8) -> RKState
    fn init(pattern: []const u8) -> RKState {
        let pattern_len = pattern.len;
        // base 256 (ASCII character set), modulus 101 (a prime)

        // Compute initial hash of pattern
        var pattern_hash : u64 = 0;
        for (i in 0..pattern_len) {
            pattern_hash = (pattern_hash * 256 + (pattern[i] as u64)) % 101;
        }

        return RKState {
            .pattern_hash = pattern_hash,
            .pattern_len = pattern_len,
            .pattern = pattern,
            .base = 256,
            .modulus = 101,
        };
    }

    // search(state: *RKState, text: []const u8, out: []usize) -> usize
    // Writes the start index of every occurrence of the pattern in text to
    // out (in increasing order, at most out.len of them) and returns how many
    // it wrote. out is a caller-provided buffer replacing the returned slice.
    fn search(state: *RKState, text: []const u8, out: []usize) -> usize {
        let text_len = text.len;
        let pattern_len = state.pattern_len;
        let base = state.base;
        let modulus = state.modulus;

        // Handle edge cases
        if (pattern_len == 0 or text_len < pattern_len) {
            return 0;
        }

        var count : usize = 0;
        var text_hash : u64 = 0;

        // Compute initial hash of first window in text
        for (i in 0..pattern_len) {
            text_hash = (text_hash * base + (text[i] as u64)) % modulus;
        }

        // Precompute base^(pattern_len-1) % modulus for rolling hash
        var power : u64 = 1;
        var k : usize = 1;
        while (k < pattern_len) {
            power = (power * base) % modulus;
            k = k + 1;
        }

        // Slide the window through the text
        for (i in 0..text_len - pattern_len + 1) {
            // Check if hashes match
            if (text_hash == state.pattern_hash) {
                // Verify character by character to avoid hash collisions
                var match_found = true;
                for (j in 0..pattern_len) {
                    if (text[i + j] != state.pattern[j]) {
                        match_found = false;
                    }
                }
                if (match_found and count < out.len) {
                    out[count] = i;
                    count = count + 1;
                }
            }

            // Compute hash for next window if not at the end. The outgoing
            // byte is subtracted modulo the modulus so the value stays
            // unsigned.
            if (i < text_len - pattern_len) {
                let outgoing = ((text[i] as u64) * power) % modulus;
                text_hash = (text_hash + modulus - outgoing) % modulus;
                text_hash = (text_hash * base + (text[i + pattern_len] as u64)) % modulus;
            }
        }

        return count;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "init_basic_case" {
        let state = init("hello");
        assert(state.pattern_hash != 0);
        assert(state.pattern_len == 5);
        assert(state.base == 256);
        assert(state.modulus == 101);
    }

    test "search_basic_case" {
        var state = init("abc");
        var out = []usize{0, 0, 0, 0};
        let n = search(&state, "abcabcabc", out);
        assert(n == 3);
        assert(out[0] == 0);
        assert(out[1] == 3);
        assert(out[2] == 6);
    }

    test "search_no_match" {
        var state = init("xyz");
        var out = []usize{0, 0, 0, 0};
        assert(search(&state, "abcdef", out) == 0);
    }

    test "search_partial_match" {
        var state = init("abc");
        var out = []usize{0, 0, 0, 0};
        let n = search(&state, "abxabc", out);
        assert(n == 1);
        assert(out[0] == 3);
    }

    test "search_empty_pattern" {
        var state = init("");
        var out = []usize{0, 0, 0, 0};
        assert(search(&state, "anything", out) == 0);
    }

    test "search_empty_text" {
        var state = init("pattern");
        var out = []usize{0, 0, 0, 0};
        assert(search(&state, "", out) == 0);
    }

    // overlapping occurrences are all reported
    test "search_overlapping_matches" {
        var state = init("aa");
        var out = []usize{0, 0, 0, 0};
        let n = search(&state, "aaaa", out);
        assert(n == 3);
        assert(out[0] == 0);
        assert(out[1] == 1);
        assert(out[2] == 2);
    }
