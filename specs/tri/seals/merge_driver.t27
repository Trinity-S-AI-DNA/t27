// SPDX-License-Identifier: Apache-2.0
; specs/tri/seals/merge_driver.t27 -- the git merge driver for .trinity/seals/*.json: `tri seals merge-driver %O %A %B %P` (#11402)
; Owner, 2026-10-20: "do everything to speed up on all axes". A seal file is one spec's record; two branches that each re-sealed the
; same spec (a new t27c, a rebase) conflict on its hashes and the person or agent merges JSON by hand. The hashes of a seal are not
; a text to merge: they are recomputed by `t27c seal <spec> --save`, which `tri land` and `tri seals changed` already do after the merge.
; -
; WHICH FILES   A path .trinity/seals/<name>.json (no ".." in it, safe bytes only). Any other path is not ours: the driver exits 1 and
;               git keeps its conflict.
; WHAT IT DOES  It cannot recompute during the merge: git merges the seal files before the specs they seal (.trinity sorts before
;               specs), so the spec in the tree is not the merged spec yet. It therefore only decides whether the conflict is a
;               re-seal of the same spec on both sides. If so it keeps OUR side in the file (git's %A) and exits 0: the textual
;               conflict is gone, the content is stale on purpose, and the NEXT command recomputes it with the pinned t27c on the
;               merged tree: `tri seals changed`.
; RESOLVED      means: exit 0, our side written, and both sides name the same spec_path. A seal that names two different specs, a
;               side without a spec_path or a spec_hash (not a seal), or a side holding a conflict marker is NOT resolved: exit 1.
; WIRING        .gitattributes: `.trinity/seals/*.json merge=trinity-seal`; git needs the driver line once per clone:
;                   git config merge.trinity-seal.driver "tri seals merge-driver %O %A %B %P"
;               Without that line git ignores the attribute and merges as text, so nothing breaks where it is not installed.
; The command (cli/tri/src/seals.rs, through gen/rust/tri/seals/merge_driver.rs) is argv glue: it reads the files %A and %B, asks
; `decide` and exits with the answer.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriSealsMergeDriver;

use tri::lab::receipt::span_is;
use tri::pr::preflight::find_in;

pub const DRV_RESOLVED : u8 = 0;
pub const DRV_CONFLICT : u8 = 1;

pub const SEAL_PREFIX : str = ".trinity/seals/";
pub const KEY_SPEC : str = "\"spec_path\": \"";

/// Is p a seal path: .trinity/seals/<name>.json, safe bytes, no "..", no further slash?
pub fn path_ok(p: string) -> bool {
    if (p.len < 26 or span_is(p, 0, 15, SEAL_PREFIX) == false or span_is(p, p.len - 5, p.len, ".json") == false) { return false; }
    var i : usize = 15;
    while (i < p.len) {
        if (p[i] <= 32 or p[i] >= 127 or p[i] == 34 or p[i] == 92 or p[i] == 47) { return false; }
        if (i + 1 < p.len and p[i] == 46 and p[i + 1] == 46) { return false; }
        i = i + 1;
    }
    return true;
}

/// Offset of the first byte of the spec_path value of a seal, text.len + 1 when there is none.
pub fn spec_from(t: string) -> usize {
    const k : usize = find_in(t, 0, t.len, KEY_SPEC);
    if (k > t.len) { return t.len + 1; }
    return k + KEY_SPEC.len;
}

/// Offset of the quote that ends the spec_path value, text.len + 1 when it does not end.
pub fn spec_to(t: string) -> usize {
    const f : usize = spec_from(t);
    if (f > t.len) { return t.len + 1; }
    var i : usize = f;
    while (i < t.len) {
        if (t[i] == 34) { return i; }
        if (t[i] == 10) { return t.len + 1; }
        i = i + 1;
    }
    return t.len + 1;
}

/// Is t one seal record: an object with a spec_path and a spec_hash and no conflict marker?
pub fn is_seal(t: string) -> bool {
    if (spec_to(t) > t.len or spec_to(t) == spec_from(t)) { return false; }
    if (find_in(t, 0, t.len, "\"spec_hash\"") > t.len) { return false; }
    if (find_in(t, 0, t.len, "<<<<<<<") <= t.len or find_in(t, 0, t.len, ">>>>>>>") <= t.len) { return false; }
    return true;
}

/// Do the two seals name the same spec?
pub fn same_spec(a: string, b: string) -> bool {
    if (is_seal(a) == false or is_seal(b) == false) { return false; }
    const n : usize = spec_to(a) - spec_from(a);
    if (spec_to(b) - spec_from(b) != n) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (a[spec_from(a) + i] != b[spec_from(b) + i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// The verdict for the file p whose two sides are ours and theirs: DRV_RESOLVED (keep ours, recompute next) or DRV_CONFLICT.
pub fn decide(p: string, ours: string, theirs: string) -> u8 {
    if (path_ok(p) and same_spec(ours, theirs)) { return DRV_RESOLVED; }
    return DRV_CONFLICT;
}

/// What the command prints for a verdict.
pub fn say(d: u8) -> string {
    if (d == DRV_RESOLVED) { return "kept our side; run `tri seals changed` to recompute the seal on the merged tree"; }
    return "not a re-seal of one spec on both sides: the conflict stays";
}

const S_A : str = "{\n  \"gen_hash_c\": \"sha256:aa\",\n  \"module\": \"QueenLotus\",\n  \"spec_hash\": \"sha256:11\",\n  \"spec_path\": \"specs/queen/lotus.t27\"\n}\n";
const S_B : str = "{\n  \"gen_hash_c\": \"sha256:bb\",\n  \"module\": \"QueenLotus\",\n  \"spec_hash\": \"sha256:22\",\n  \"spec_path\": \"specs/queen/lotus.t27\"\n}\n";
const S_OTHER : str = "{\n  \"module\": \"X\",\n  \"spec_hash\": \"sha256:33\",\n  \"spec_path\": \"specs/queen/other.t27\"\n}\n";
const S_MARKED : str = "{\n<<<<<<< ours\n  \"spec_hash\": \"sha256:11\",\n  \"spec_path\": \"specs/queen/lotus.t27\"\n}\n";
const S_NOPATH : str = "{\n  \"spec_hash\": \"sha256:44\"\n}\n";
const S_EMPTY : str = "";
const P_OK : str = ".trinity/seals/queen_QueenLotus.json";

test two_re_seals_of_one_spec_keep_our_side_and_leave_the_recompute_to_the_next_command {
    assert path_ok(P_OK) and span_is(P_OK, 0, 15, SEAL_PREFIX);
    assert is_seal(S_A) and is_seal(S_B);
    assert same_spec(S_A, S_B);
    assert decide(P_OK, S_A, S_B) == DRV_RESOLVED and decide(P_OK, S_B, S_A) == DRV_RESOLVED;
    const m : string = say(DRV_RESOLVED);
    assert find_in(m, 0, m.len, "tri seals changed") <= m.len;
}

test negative_control_two_different_specs_a_marker_a_missing_key_or_a_foreign_path_stay_conflicts {
    assert decide(P_OK, S_A, S_OTHER) == DRV_CONFLICT;
    assert decide(P_OK, S_A, S_MARKED) == DRV_CONFLICT and decide(P_OK, S_MARKED, S_MARKED) == DRV_CONFLICT;
    assert decide(P_OK, S_A, S_NOPATH) == DRV_CONFLICT and decide(P_OK, S_EMPTY, S_EMPTY) == DRV_CONFLICT;
    assert decide("specs/queen/lotus.t27", S_A, S_B) == DRV_CONFLICT;
    assert decide(".trinity/seals/../x.json", S_A, S_B) == DRV_CONFLICT;
    assert decide(".trinity/seals/a/b.json", S_A, S_B) == DRV_CONFLICT;
    assert decide(".trinity/seals/.json", S_A, S_B) == DRV_CONFLICT;
    assert decide(".trinity/seals/a b.json", S_A, S_B) == DRV_CONFLICT;
    assert span_is(say(DRV_CONFLICT), 0, 3, "not");
}
