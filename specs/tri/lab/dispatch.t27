// SPDX-License-Identifier: Apache-2.0
; specs/tri/lab/dispatch.t27 -- the argv law for dispatching the T27 OS lab (gHashTag/t27#11840's
; verification loop; the surface is Trinity-S-AI-DNA/t27os specs/os/lab.t27, the executor its
; .github/workflows/lab.yml). One decision per fn, the verbs.t27 argv pattern: every builder writes
; the argv words into a caller buffer and returns how many words it wrote; ZERO words means REFUSED
; the host runs nothing. Fail-closed rules: no sha, a non-hex challenge, or an empty spec list is
; a refusal -- a dispatch without a challenge cannot be verified, and a dispatch without specs
; verifies nothing. The m6 flag is the caller's honesty: true spends the ffmpeg download that dies
; on its CDN ~40% of the time (t27os#10).
; The host glue (cli/tri/src, TRI CLAW for the t27os-side yaml) runs these words; this spec holds
; only the decisions. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module TriLabDispatch;

pub const REPO : str = "Trinity-S-AI-DNA/t27os";
pub const WORKFLOW : str = "lab.yml";

pub const A_DISPATCH : u8 = 0;
pub const A_REFUSE : u8 = 1;

fn digit(b: u8) -> bool { return b >= 48 and b <= 57; }
fn hexlower(b: u8) -> bool { return digit(b) or (b >= 97 and b <= 102); }

/// A challenge is 32 lowercase hex bytes (the sha256 of a requester's secret).
pub fn challenge_ok(c: []const u8) -> bool {
    if (c.len != 32) { return false; }
    var i : usize = 0;
    while (i < 32) {
        if (hexlower(c[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// A sha is 7 to 40 lowercase hex bytes (full or abbreviated).
pub fn sha_ok(s: []const u8) -> bool {
    if (s.len < 7 or s.len > 40) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (hexlower(s[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// The dispatch argv, one word per line in out (the verbs.t27 contract: the
/// host glue splits on the newlines), written within cap; returns the new
/// offset. The exact words gh runs:
///   gh / workflow / run / lab.yml / --repo / Trinity-S-AI-DNA/t27os
///   / -f / sha=<sha> / -f / challenge=<ch> / -f / specs=<specs> / -f / m6=false
/// The m6=false is the law, not a default: the M6 ffmpeg download dies on its
/// CDN ~40% of the time (t27os#10) and a verification dispatch never needs
/// the 900-frame render. The reviewer pair caught the first draft validating
/// the challenge and then not emitting it (#11853 review).
pub fn put_s(out: []u8, w: usize, cap: usize, s: []const u8) -> usize {
    var i : usize = 0;
    var n : usize = w;
    while (i < s.len and n < cap) { out[n] = s[i]; n = n + 1; i = i + 1; }
    return n;
}

pub fn dispatch_argv(out: []u8, cap: usize, sha: []const u8, ch: []const u8, specs: []const u8) -> usize {
    if (sha_ok(sha) == false or challenge_ok(ch) == false or specs.len == 0) { return 0; }
    var w : usize = put_s(out, 0, cap, "gh\nworkflow\nrun\nlab.yml\n--repo\n");
    w = put_s(out, w, cap, REPO);
    w = put_s(out, w, cap, "\n-f\nsha=");
    w = put_s(out, w, cap, sha);
    w = put_s(out, w, cap, "\n-f\nchallenge=");
    w = put_s(out, w, cap, ch);
    w = put_s(out, w, cap, "\n-f\nspecs=");
    w = put_s(out, w, cap, specs);
    w = put_s(out, w, cap, "\n-f\nm6=false\n");
    return w;
}

/// Why a dispatch refused, one line for the operator; empty for the OK cases.
pub fn refusal(sha: []const u8, ch: []const u8, specs: []const u8) -> []const u8 {
    if (sha_ok(sha) == false) { return "sha: 7..40 lowercase hex expected"; }
    if (challenge_ok(ch) == false) { return "challenge: exactly 32 lowercase hex expected"; }
    if (specs.len == 0) { return "specs: an empty list verifies nothing"; }
    return "";
}

test the_dispatch_command_is_exact {
    // the reviewer pair's demand: assert the CONTENTS, not a count -- these are
    // the exact words gh runs, newlines and all
    var buf : [256]u8 = undefined;
    const n : usize = dispatch_argv(buf[0..256], 256, "a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27");
    assert n > 0;
    const want : str = "gh\nworkflow\nrun\nlab.yml\n--repo\nTrinity-S-AI-DNA/t27os\n-f\nsha=a1b2c3d\n-f\nchallenge=a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4\n-f\nspecs=specs/a.t27\n-f\nm6=false\n";
    var i : usize = 0;
    var same : bool = n == want.len;
    while (same and i < n) { if (buf[i] != @as(u8, want[i])) { same = false; } i = i + 1; }
    assert same;
}

test a_dispatch_refuses_closed_fail {
    var buf : [256]u8 = undefined;
    assert dispatch_argv(buf[0..256], 256, "", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27") == 0;
    assert dispatch_argv(buf[0..256], 256, "abc", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27") == 0;
    assert dispatch_argv(buf[0..256], 256, "a1b2c3d", "A1B2C3D4A1B2C3D4A1B2C3D4A1B2C3D4", "specs/a.t27") == 0;
    assert dispatch_argv(buf[0..256], 256, "a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d", "specs/a.t27") == 0;
    assert dispatch_argv(buf[0..256], 256, "a1b2c3d", "", "specs/a.t27") == 0;
}
