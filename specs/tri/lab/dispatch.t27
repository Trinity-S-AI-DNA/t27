// SPDX-License-Identifier: Apache-2.0
; specs/tri/lab/dispatch.t27 -- the argv law for dispatching the T27 OS lab (gHashTag/t27#11840's
; verification loop; the surface is Trinity-S-AI-DNA/t27os specs/os/lab.t27, the executor its
; .github/workflows/lab.yml). One decision per fn, the verbs.t27 argv pattern: every builder writes
; the argv words, one per line, into a caller buffer and returns the bytes written; ZERO means REFUSED
; the host runs nothing. Fail-closed rules: no sha, a non-hex challenge, or an empty spec list is
; a refusal -- a dispatch without a challenge cannot be verified, and a dispatch without specs
; verifies nothing. The m6 flag is the caller's honesty: true spends the ffmpeg download that dies
; on its CDN ~40% of the time (t27os#10).
; The host glue (cli/tri/src, TRI CLAW for the t27os-side yaml) runs these words; this spec holds
; only the decisions. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module TriLabDispatch;

use tri::trigit::verbs::put_s;

pub const REPO : str = "Trinity-S-AI-DNA/t27os";
pub const WORKFLOW : str = "lab.yml";

pub const A_DISPATCH : u8 = 0;
pub const A_REFUSE : u8 = 1;

fn digit(b: u8) -> bool { return b >= 48 and b <= 57; }
fn hexlower(b: u8) -> bool { return digit(b) or (b >= 97 and b <= 102); }

/// A challenge is 32 lowercase hex bytes (the sha256 of a requester's secret).
pub fn challenge_ok(c: []const u8) -> bool {
    if (c.len != 32) { return false; }
    var i : usize = 0;
    while (i < 32) {
        if (hexlower(c[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// A sha is 7 to 40 lowercase hex bytes (full or abbreviated).
pub fn sha_ok(s: []const u8) -> bool {
    if (s.len < 7 or s.len > 40) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (hexlower(s[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// The dispatch argv, one word per line (the verbs.t27 pattern: the host splits lines into the
; argument vector): gh workflow run lab.yml --repo REPO -f sha=.. -f challenge=.. -f specs=..
; -f m6=false -f wasm=false. Returns the bytes written; 0 = refused, and so is a buffer too small
; for the whole vector (a truncated argv would dispatch a different run than the one decided).
; m6 and wasm are pinned false: m6 defaults true on the workflow and its frame render kills the
; receipt on any head that predates specs/t27f/frame_render.t27 (t27os#10, night tick 6).
; The specs text is passed through UNVALIDATED: the lab names what it checks, and its own
; BLOCKED gate (t27os#9) is the verdict on a bad path.
pub fn dispatch_argv(out: []u8, cap: usize, sha: []const u8, ch: []const u8, specs: []const u8) -> usize {
    if (sha_ok(sha) == false) { return 0; }
    if (challenge_ok(ch) == false) { return 0; }
    if (specs.len == 0) { return 0; }
    var w : usize = 0;
    w = put_s(out, w, cap, "gh\nworkflow\nrun\n");
    w = put_s(out, w, cap, WORKFLOW);
    w = put_s(out, w, cap, "\n--repo\n");
    w = put_s(out, w, cap, REPO);
    w = put_s(out, w, cap, "\n-f\nsha=");
    w = put_s(out, w, cap, sha);
    w = put_s(out, w, cap, "\n-f\nchallenge=");
    w = put_s(out, w, cap, ch);
    w = put_s(out, w, cap, "\n-f\nspecs=");
    w = put_s(out, w, cap, specs);
    w = put_s(out, w, cap, "\n-f\nm6=false\n-f\nwasm=false\n");
    if (w >= cap) { return 0; }
    return w;
}

/// Why a dispatch refused, one line for the operator; empty for the OK cases.
pub fn refusal(sha: []const u8, ch: []const u8, specs: []const u8) -> []const u8 {
    if (sha_ok(sha) == false) { return "sha: 7..40 lowercase hex expected"; }
    if (challenge_ok(ch) == false) { return "challenge: exactly 32 lowercase hex expected"; }
    if (specs.len == 0) { return "specs: an empty list verifies nothing"; }
    return "";
}

test a_dispatch_needs_a_real_sha_a_32_hex_challenge_and_specs {
    var out : [256]u8 = undefined;
    assert dispatch_argv(out[0..256], 256, "", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27") == 0;
    assert dispatch_argv(out[0..256], 256, "abc", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27") == 0;
    assert dispatch_argv(out[0..256], 256, "a1b2c3d", "SHORT", "specs/a.t27") == 0;
    assert dispatch_argv(out[0..256], 256, "a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "") == 0;
}

test the_argv_carries_every_key_the_lab_reads {
    ; the 2026-10-23 version wrote 9 words and its test counted them: the challenge, the sha= and
    ; specs= keys and m6=false never reached the vector. These asserts read the bytes.
    var out : [256]u8 = undefined;
    let n : usize = dispatch_argv(out[0..256], 256, "a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27");
    assert n == 162;
    assert out[0..n] == "gh\nworkflow\nrun\nlab.yml\n--repo\nTrinity-S-AI-DNA/t27os\n-f\nsha=a1b2c3d\n-f\nchallenge=a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4\n-f\nspecs=specs/a.t27\n-f\nm6=false\n-f\nwasm=false\n";
}

test a_buffer_too_small_for_the_whole_vector_refuses {
    var out : [256]u8 = undefined;
    assert dispatch_argv(out[0..256], 40, "a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27") == 0;
    assert dispatch_argv(out[0..256], 163, "a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27") == 162;
}

test the_refusal_names_the_first_bad_input {
    assert refusal("zz", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27") == "sha: 7..40 lowercase hex expected";
    assert refusal("a1b2c3d", "oops", "specs/a.t27") == "challenge: exactly 32 lowercase hex expected";
    assert refusal("a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "") == "specs: an empty list verifies nothing";
    assert refusal("a1b2c3d", "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/a.t27").len == 0;
}
