// SPDX-License-Identifier: Apache-2.0
; specs/crons/trinity-queue-health-report.t27 -- cron github-actions/t27/queue-health-report
; The card of .github/workflows/queue-health-report.yml: hourly one-screen truth
; about the open PR queue -- counts by merge state, armed auto-merges, drafts and
; opt-outs -- written into one issue. Read-only: it merges nothing, arms nothing;
; the drain (github-actions/t27/pr-queue-drain) is the one that acts. Companion
; issue carries the live report. phi^2 + 1/phi^2 = 3 | TRINITY

module cron_trinity_queue_health_report;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/queue-health-report";
pub const NAME : str = "Queue Health Report";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/queue-health-report.yml";
pub const SUMMARY_EN : str = "Hourly read-only report of the open PR queue -- counts by merge state, armed auto-merges, drafts, opt-outs -- written into one issue body.";
pub const SCHEDULE : str = "7 * * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "gh-based shell steps; no named skill invocation in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "github-actions-dispatch";

test id_is_host_repo_and_slug {
    assert HOST == "github-actions" or HOST == "inngest" or HOST == "railway-cron" or HOST == "timer" or HOST == "launchd";
    var i : usize = 0;
    while (i < HOST.len) {
        assert ID[i] == HOST[i];
        i = i + 1;
    }
    assert ID[HOST.len] == '/';
    var r : usize = 0;
    while (r < REPO.len) {
        assert ID[HOST.len + 1 + r] == REPO[r];
        r = r + 1;
    }
    assert ID[HOST.len + 1 + REPO.len] == '/';
    var s : usize = HOST.len + REPO.len + 2;
    while (s < ID.len) {
        assert ID[s] != '/' and ID[s] != ' ';
        s = s + 1;
    }
}

test vocabularies_and_the_control_link {
    assert KIND == "cron";
    assert ON_FAILURE == "issue" or ON_FAILURE == "log" or ON_FAILURE == "unknown";
    assert CONTROL == "github-actions-dispatch" or CONTROL == "railway-dashboard" or CONTROL == "inngest-dashboard" or CONTROL == "code-only";
    assert RUNS.len > 0 or RUNS_NOTE.len > 0;
}

test schedule_is_a_five_field_cron_expression {
    assert SCHEDULE[0] != ' ';
    assert SCHEDULE[SCHEDULE.len - 1] != ' ';
    var spaces : u32 = 0;
    var i : usize = 0;
    while (i < SCHEDULE.len) {
        const c : u8 = SCHEDULE[i];
        if (c == ' ') {
            spaces = spaces + 1;
            assert SCHEDULE[i + 1] != ' ';
        } else {
            assert (c >= '0' and c <= '9') or c == '*' or c == '/' or c == ',' or c == '-';
        }
        i = i + 1;
    }
    assert spaces == 4;
}

test the_workflow_file_is_the_slug {
    const DIR : str = ".github/workflows/";
    const at : usize = HOST.len + REPO.len + 2;
    assert SERVICE.len == DIR.len + (ID.len - at) + 4;
    var p : usize = 0;
    while (p < DIR.len) {
        assert SERVICE[p] == DIR[p];
        p = p + 1;
    }
    var k : usize = 0;
    while (k < ID.len - at) {
        assert SERVICE[DIR.len + k] == ID[at + k];
        k = k + 1;
    }
    assert SERVICE[SERVICE.len - 4] == '.';
    assert SERVICE[SERVICE.len - 3] == 'y';
    assert SERVICE[SERVICE.len - 2] == 'm';
    assert SERVICE[SERVICE.len - 1] == 'l';
}
