; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_999_multibots_telegraf_woody_select;

pub const KIND : str = "cron";
pub const ID : str = "timer/999-multibots-telegraf/woody_select";
pub const NAME : str = "woody_select";
pub const HOST : str = "timer";
pub const REPO : str = "999-multibots-telegraf";
pub const SERVICE : str = "src/cron/woody_select.ts#L1";
pub const SUMMARY_EN : str = "Polls Telegram for new messages from @WoodySelect_bot and dispatches them to the handler.";
pub const SCHEDULE : str = "*/1 * * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

test woody_select_cron_constants {
    assert KIND == "cron";
    assert ENABLED == true;
    assert TZ == "UTC";
    assert HOST == "timer";
    assert ON_FAILURE == "log";
    assert ID == "timer/999-multibots-telegraf/woody_select";
    assert NAME == "woody_select";
}

