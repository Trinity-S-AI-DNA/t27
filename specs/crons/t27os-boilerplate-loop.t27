// SPDX-License-Identifier: Apache-2.0
// specs/crons/t27os-boilerplate-loop.t27 -- the T27 OS boilerplate loop: once an hour on the owner's
// Mac, one bounded tick against copied helpers in .t27 -- take the next unclaimed row of epic
// gHashTag/t27#12444, claim it, migrate one batch of specs onto the std layer (std::text, std::mem,
// std::signmag), show equal test counts before and after, seal, lower the duplicate-bodies ledger
// only by a deletions-only bless, write what was done into the claim comment and the epic Dashboard.
// Owner, 2026-10-25 (translated): "study the boilerplate and spaghetti in .t27, make an epic, create
// a cron in T27 OS, fix the weak spots by the Pareto rule, keep the experience in skills so a new cron
// cycle does not break past work, let several agents work without conflicts, and write in which task
// is in progress and what is already done".
// The tick engine is the Claude desktop scheduled task `boilerplate-loop` (a prompt, no plist and no
// script: only-t27), so it fires while the desktop app is open and catches up on the next launch.
// The tick's law is the skill boilerplate-loop (.claude/skills/boilerplate-loop/SKILL.md); the claim
// protocol is in the epic body. This card is the contract the page and the Queen read.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27os_boilerplate_loop;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/t27os-boilerplate-loop";
pub const NAME : str = "T27 OS boilerplate loop";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "claude-desktop-task/boilerplate-loop";
pub const SUMMARY_EN : str = "One bounded tick an hour against copied helpers in .t27: claim the next row of epic t27#12444, migrate one batch onto the std layer with equal test counts, seal, bless the ratchet only on deletions, record the claim and the Dashboard.";
pub const SCHEDULE : str = "17 * * * *";
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [1]str = ["boilerplate-loop"];
pub const RUNS_NOTE : str = "the loop is its own skill: the tick recipe and the self-corrections are .claude/skills/boilerplate-loop/SKILL.md, the claim protocol is in the body of t27#12444";
pub const ENABLED : bool = true;
pub const NOTE : str = "spec-only by construction (the Mac is not scanned); the engine is a Claude desktop scheduled task, not a launchd plist, so it runs while the app is open; the tick forbids force-push and --no-verify, takes a claim before any edit, and runs no sweep or build on the Mac";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "code-only";

// ---- CLAIM-STEP: what `tri loop claim boiler-<n>` answered (exit code) ----
// Exit 0 means the row is ours, exit 1 means another session holds it, exit 2 means the claim could
// not be attempted at all (no network, no ssh) which is not the same as a refusal. Measured
// 2026-10-25: with the network down, `tri loop claim` printed "HELD -- a claim this checkout cannot
// read" and exited 1 for two rows nobody held; a tick that read exit 1 as "taken" skipped free rows.
// So 1 is "take another row" only while the network answers, and 2 is never read as ownership.

/// 0 take the row, 1 take another row, 2 could not be attempted: say so, hold nothing.
pub fn claim_action(exit_code: u32) -> u32 {
    if (exit_code == 0) { return 0; } // CLAIM_TAKE
    if (exit_code == 1) { return 1; } // CLAIM_OTHER
    return 2; // CLAIM_UNKNOWN: any other exit is "could not attempt", never ownership
}

/// A claim with no edit for STALE_HOURS (6) hours and no push on its branch for as long is stale: another
/// agent may post TAKEOVER and take the row. Ages are in seconds; a stamp of 0 reads as never.
pub fn claim_is_stale(now: u64, last_edit: u64, last_push: u64) -> bool {
    const STALE_S : u64 = 21600;
    if (last_edit == 0 and last_push == 0) { return true; }
    var newest : u64 = last_edit;
    if (last_push > newest) { newest = last_push; }
    if (now < newest) { return false; } // a clock that went back reads fresh
    return now - newest >= STALE_S;
}

/// A tick migrates at most BATCH_MAX (10) specs; more is split into a second tick.
pub fn batch_ok(n_specs: u32) -> bool {
    return n_specs <= 10;
}

/// The test-count rule of the loop: a migrated spec keeps its passes, adds no failures, and never
/// turns a pass into a vacuous run. A drop is a revert, not a finding.
pub fn counts_equal(pass_before: u32, pass_after: u32, fail_after: u32, vacuous_after: bool) -> bool {
    if (vacuous_after) { return false; }
    if (fail_after != 0) { return false; }
    return pass_after >= pass_before;
}

test the_card_names_the_engine_and_the_cadence {
    assert KIND == "cron" and ENABLED;
    assert ID == "launchd/mac/t27os-boilerplate-loop";
    assert SCHEDULE == "17 * * * *" and TZ == "Asia/Bangkok";
    assert HOST == "launchd" and CONTROL == "code-only" and ON_FAILURE == "issue";
}

test the_required_schema_fields_are_the_generators {
    assert KIND.len > 0 and RUNS.len == 1 and RUNS_NOTE.len > 0;
    assert RUNS[0] == "boilerplate-loop";
}

test exit_zero_takes_the_row_and_exit_one_takes_another {
    const CLAIM_TAKE : u32 = 0;
    const CLAIM_OTHER : u32 = 1;
    assert claim_action(0) == CLAIM_TAKE;
    assert claim_action(1) == CLAIM_OTHER;
}

test any_other_exit_is_never_read_as_ownership {
    const CLAIM_UNKNOWN : u32 = 2;
    assert claim_action(2) == CLAIM_UNKNOWN;
    assert claim_action(127) == CLAIM_UNKNOWN;
    assert claim_action(255) == CLAIM_UNKNOWN;
}

test a_claim_edited_five_hours_ago_is_not_stale {
    assert claim_is_stale(100000, 100000 - 18000, 0) == false;
    assert claim_is_stale(100000, 0, 100000 - 18000) == false;
}

test a_claim_untouched_for_six_hours_is_stale {
    assert claim_is_stale(100000, 100000 - 21600, 100000 - 21600);
    assert claim_is_stale(100000, 100000 - 21599, 0) == false;
}

test a_recent_push_keeps_a_claim_with_an_old_comment_alive {
    assert claim_is_stale(100000, 100000 - 30000, 100000 - 60) == false;
}

test a_claim_with_no_stamp_at_all_is_stale_and_a_clock_that_went_back_is_fresh {
    assert claim_is_stale(100000, 0, 0);
    assert claim_is_stale(100, 200, 0) == false;
}

test a_batch_is_ten_specs_at_most {
    assert batch_ok(0) and batch_ok(10);
    assert batch_ok(11) == false;
}

test a_migration_that_loses_a_pass_is_a_revert {
    assert counts_equal(7, 7, 0, false);
    assert counts_equal(7, 9, 0, false);
    assert counts_equal(7, 6, 0, false) == false;
}

test a_failure_or_a_vacuous_run_is_never_equal {
    assert counts_equal(7, 7, 1, false) == false;
    assert counts_equal(7, 7, 0, true) == false;
    assert counts_equal(0, 0, 0, true) == false;
}
