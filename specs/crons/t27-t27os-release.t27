// SPDX-License-Identifier: Apache-2.0
// specs/crons/t27-t27os-release.t27 -- the T27 OS release leg: a macOS runner builds the app and the
// toolchain from one master commit and publishes the release, when the owner dispatches it and types yes.
// The leg is dispatch-only: it has no schedule, so SCHEDULE is "" and SCHEDULE_NOTE says why. The
// owner's --yes of `tri t27os publish` is the owner_yes input of the dispatch (default no); the job
// refuses to start without it and without a master ref, and the agent never types it (owner,
// 2026-10-25: "I will give --yes there"). The workflow text and its law are NOT restated here:
// they live in specs/t27os/release_leg.t27 (RELEASE_WORKFLOW_YAML, workflow_ok, leg_may_run), and
// the release steps live in specs/t27os/release.t27 (plan_text, publish_text, publish_allowed). The
// card names them and adds nothing of its own.
// Why a leg: the Mac refuses heavy builds (mac-no-heavy.py), so the build and the publish run on the
// macos-14 runner the t27os.yml gate already uses.
// Self-critical state, 2026-10-25: nothing was built or published by this card. The workflow file
// .github/workflows/t27os-release.yml lands in the same PR as this card (a foreign file: the owner
// granted owner-approved-foreign for it, the PR deletes scripts/gen_w868.py to stay net zero, and
// gate-topology classifies it), so the card is ENABLED = true. Merging it publishes nothing: only the
// owner's dispatch with yes typed does. The release it would cut is 0.2.0 (issue #12479), which waits
// for #12373, #12393, #12333 and #11801 to reach master and for the release.t27 version bump. Last
// release: t27os-v0.1.3-b4466 (2026-10-20). ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27_t27os_release;

use t27os::release_leg::workflow_ok;
use t27os::release_leg::leg_may_run;
use t27os::release_leg::RELEASE_WORKFLOW_YAML;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/t27os-release";
pub const NAME : str = "T27 OS release leg";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/t27os-release.yml";
pub const SUMMARY_EN : str = "On the owner's dispatch with yes typed: build the T27 OS app and toolchain from one master commit on a macOS runner and publish the release and the t27os-latest pointer (tri t27os publish --yes).";
pub const SCHEDULE : str = "";
pub const SCHEDULE_NOTE : str = "workflow_dispatch only; it has no schedule, the owner starts it and types yes in owner_yes";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source; the steps are specs/t27os/release.t27 and the leg law is specs/t27os/release_leg.t27";
pub const ENABLED : bool = true;
pub const NOTE : str = "enabled with .github/workflows/t27os-release.yml (owner-approved-foreign); merging publishes nothing, the owner's dispatch with yes does; release 0.2.0 is issue #12479";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

test the_card_is_dispatch_only_and_enabled_with_its_workflow {
    assert KIND == "cron";
    assert ID == "github-actions/t27/t27os-release";
    assert HOST == "github-actions";
    assert SCHEDULE.len == 0;
    assert SCHEDULE_NOTE.len > 0;
    assert CONTROL == "github-actions-dispatch";
    assert SERVICE == ".github/workflows/t27os-release.yml";
    assert ENABLED == true;
}

test the_card_serves_the_leg_law_and_never_the_owners_yes {
    // the text the card points at passes the law it points at
    assert workflow_ok(RELEASE_WORKFLOW_YAML);
    // only the owner's dispatch on master publishes; no yes, no leg
    assert leg_may_run(true, true, true) == true;
    assert leg_may_run(true, false, true) == false;
    assert leg_may_run(false, true, true) == false;
    assert leg_may_run(true, true, false) == false;
}
