module DiskGuardRetention;
pub const KEEP_FULL_RUNS : u32 = 3;
pub fn keep_full(run: u32, newest: u32) -> bool {
    return newest >= KEEP_FULL_RUNS and run > newest - KEEP_FULL_RUNS;
}
test last_three_kept {
    assert keep_full(3, 3) == true;
    assert keep_full(4, 4) == true;
    assert keep_full(2, 4) == true;
    assert keep_full(1, 4) == false;
}
endmodule
