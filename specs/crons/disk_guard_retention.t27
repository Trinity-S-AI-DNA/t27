// SPDX-License-Identifier: Apache-2.0
; specs/crons/disk_guard_retention.t27 -- DISK-GUARD-02 session-history retention
; The rule for DSH/OpenCode history: an ACTIVE session is never touched; a
; COMPLETED session is first exported/archived and verified, and its original is
; deleted only after BOTH a restore check and the owner's explicit approval. A
; deletion that skips the archive or the approval is out of policy. The short
; experience index and receipts are always kept. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module DiskGuardRetention;

// A session-history record is in exactly one state.
pub const STATE_ACTIVE : u8 = 0;
pub const STATE_COMPLETED : u8 = 1;
pub const STATE_ARCHIVED : u8 = 2;
pub const STATE_DELETED : u8 = 3;

// How long a completed session is retained before archival is considered.
pub const RETENTION_DAYS : u8 = 30;

/// The ONLY path to deletion. Three facts must all hold, otherwise the answer
/// is "keep". An active record is never deletable, a completed-but-unarchived
/// record is never deletable, and even an archived record needs a verified
/// restore plus the owner's word. This is a gate, not a timer: RETENTION_DAYS
/// alone never deletes anything.
pub fn deletable(state: u8, archived_ok: bool, owner_ok: bool) -> bool {
    if (state == STATE_ACTIVE) { return false; }
    if (state == STATE_DELETED) { return false; }
    return state == STATE_ARCHIVED and archived_ok and owner_ok;
}

/// The short experience index and receipts survive even a deletion; they are
/// not session history. A "keep" of them is unconditional.
pub const KEEP_INDEX_AND_RECEIPTS : bool = true;

test active_is_never_deletable {
    assert deletable(STATE_ACTIVE, true, true) == false;
}

test completed_but_unarchived_is_never_deletable {
    assert deletable(STATE_COMPLETED, true, true) == false;
    assert deletable(STATE_COMPLETED, false, true) == false;
}

test archived_needs_restore_and_owner {
    assert deletable(STATE_ARCHIVED, false, true) == false;   // restore not verified
    assert deletable(STATE_ARCHIVED, true, false) == false;   // owner not approved
    assert deletable(STATE_ARCHIVED, true, true) == true;     // both gates passed
}

test deleted_stays_deleted {
    assert deletable(STATE_DELETED, true, true) == false;
}

test the_index_and_receipts_are_always_kept {
    assert KEEP_INDEX_AND_RECEIPTS == true;
}

test retention_alone_never_deletes {
    // A completed record, however old, is not deletable without archive+approval.
    assert RETENTION_DAYS == 30;
    assert deletable(STATE_COMPLETED, true, true) == false;
}
