// SPDX-License-Identifier: Apache-2.0
; specs/crons/t27os-queen-feed.t27 -- cron github-actions/t27os/queen-feed
; Source of truth for the job card on t27.ai (#/crons?cron=github-actions/t27os/queen-feed).
; The schedule was read from t27os:.github/workflows/queen-feed.yml (the workflow this
; card names; issue gHashTag/t27#12384).
; Architecture: T27OS is a batch executor, so the feed is PULL, not PUSH. Every 15
; minutes the workflow exports the Queen's recent actor events -- today the honest seed,
; specs/queen/actor_events.t27's 24-event REPLAY (the first 24 columns of
; specs/t27f/work_graph_fixture.t27) -- as runs/queen-feed.json in format
; t27f-queen-feed-v1, published to the t27os runs/ directory by the same mechanism as
; the lab receipts. The live page (trinity apps/website/public/t27f/live/t27f_live.js)
; fetches that static file on its existing poll and feeds the events down its own
; tick() path; when the live bus comes online it replaces this seed, not the card.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27os_queen_feed;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27os/queen-feed";
pub const NAME : str = "T27OS Queen feed";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27os";
pub const SERVICE : str = ".github/workflows/queen-feed.yml";
pub const SUMMARY_EN : str = "Batch-exports the Queen's recent actor events every 15 minutes as runs/queen-feed.json (format t27f-queen-feed-v1) in the t27os runs/ directory; the live page pulls the static file.";
pub const SCHEDULE : str = "*/15 * * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";
pub const NOTE : str = "Batch-pull, not push (t27#12384): T27OS is a batch executor, so the feed is a static runs/queen-feed.json (format t27f-queen-feed-v1) re-exported on schedule, seeded from specs/queen/actor_events.t27's 24-event REPLAY while the live bus is offline; the page's recorded-log fallback still stands.";

/// Whether hay holds needle as a contiguous substring.
fn contains(hay: str, needle: str) -> bool {
    if (needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var hit : bool = true;
        var k : usize = 0;
        while (k < needle.len) {
            if (hay[i + k] != needle[k]) { hit = false; }
            k = k + 1;
        }
        if (hit) { return true; }
        i = i + 1;
    }
    return false;
}

; The card held to the schema of specs/crons/README.md: ID is <host>/<repo>/<slug>; HOST,
; ON_FAILURE and CONTROL come from fixed vocabularies; RUNS, the control link, is empty unless
; the source evidently invokes a skill, and RUNS_NOTE then says why.
test id_is_host_repo_and_slug {
    // HOST is one of the five hosts the README names.
    assert HOST == "github-actions" or HOST == "inngest" or HOST == "railway-cron" or HOST == "timer" or HOST == "launchd";
    // ID opens with HOST, a `/`, REPO and a `/`.
    var i : usize = 0;
    while (i < HOST.len) {
        assert ID[i] == HOST[i];
        i = i + 1;
    }
    assert ID[HOST.len] == '/';
    var r : usize = 0;
    while (r < REPO.len) {
        assert ID[HOST.len + 1 + r] == REPO[r];
        r = r + 1;
    }
    assert ID[HOST.len + 1 + REPO.len] == '/';
    // The slug after it is one path segment, not empty.
    assert ID.len > HOST.len + REPO.len + 2;
    var s : usize = HOST.len + REPO.len + 2;
    while (s < ID.len) {
        assert ID[s] != '/' and ID[s] != ' ';
        s = s + 1;
    }
}
test vocabularies_and_the_control_link {
    assert KIND == "cron";
    assert ON_FAILURE == "issue" or ON_FAILURE == "log" or ON_FAILURE == "unknown";
    assert CONTROL == "github-actions-dispatch" or CONTROL == "railway-dashboard" or CONTROL == "inngest-dashboard" or CONTROL == "code-only";
    // An empty RUNS carries its reason in RUNS_NOTE.
    assert RUNS.len > 0 or RUNS_NOTE.len > 0;
}
test schedule_is_a_five_field_cron_expression {
    // Five fields with one space between each, made of digits and `* / , -`.
    assert SCHEDULE[0] != ' ';
    assert SCHEDULE[SCHEDULE.len - 1] != ' ';
    var spaces : u32 = 0;
    var i : usize = 0;
    while (i < SCHEDULE.len) {
        const c : u8 = SCHEDULE[i];
        if (c == ' ') {
            spaces = spaces + 1;
            assert SCHEDULE[i + 1] != ' ';
        } else {
            assert (c >= '0' and c <= '9') or c == '*' or c == '/' or c == ',' or c == '-';
        }
        i = i + 1;
    }
    assert spaces == 4;
}
test the_workflow_file_is_the_slug {
    // SERVICE is the workflow file, `.github/workflows/<slug>.yml`.
    const DIR : str = ".github/workflows/";
    const at : usize = HOST.len + REPO.len + 2;
    assert SERVICE.len == DIR.len + (ID.len - at) + 4;
    var p : usize = 0;
    while (p < DIR.len) {
        assert SERVICE[p] == DIR[p];
        p = p + 1;
    }
    var k : usize = 0;
    while (k < ID.len - at) {
        assert SERVICE[DIR.len + k] == ID[at + k];
        k = k + 1;
    }
    assert SERVICE[SERVICE.len - 4] == '.';
    assert SERVICE[SERVICE.len - 3] == 'y';
    assert SERVICE[SERVICE.len - 2] == 'm';
    assert SERVICE[SERVICE.len - 1] == 'l';
}
test the_card_names_the_batch_pull_architecture {
    // NOTE carries the issue and the batch-pull shape: a scheduled re-export of a
    // static JSON file in the feed format, never a push endpoint.
    assert NOTE.len > 0;
    assert contains(NOTE, "t27#12384");
    assert contains(NOTE, "t27f-queen-feed-v1");
}
