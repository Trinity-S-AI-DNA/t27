// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-t27c-stable-rebuild.t27 -- cron launchd/t27/t27c-stable-rebuild
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/t27/t27c-stable-rebuild).
; The schedule was read from the draft of ~/Library/LaunchAgents/ai.t27.t27c-stable-rebuild.plist, 2026-11-02.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; phi^2 + 1/phi^2 = 3 | TRINITY
; Issue: #8220

module cron_mac_t27c_stable_rebuild;

pub const KIND : str = "cron";
pub const ID : str = "launchd/t27/t27c-stable-rebuild";
pub const NAME : str = "Stable t27c rebuild";
pub const HOST : str = "launchd";
pub const REPO : str = "t27";
pub const SERVICE : str = "ai.t27.t27c-stable-rebuild";
pub const SUMMARY_EN : str = "Rebuilds the bootstrap compiler hourly into the one stable binary every lane reads: cd bootstrap && CARGO_TARGET_DIR=~/.cache/t27/target cargo build -p t27c && cp ~/.cache/t27/target/debug/t27c ~/.cache/t27/bin/t27c";
pub const SCHEDULE : str = "0 * * * *";
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";
pub const NOTE : str = "Build measured 26 s dev profile on this Mac (2026-11-02, filing lane); cargo exits faster on an unchanged tree. A dirty bootstrap tree refuses to build by design (FROZEN_HASH), and the failure lands in the job's err log.";

test mac_t27c_stable_rebuild_test {
    assert KIND == "cron";
    assert ENABLED == true;
    assert HOST == "launchd";
    assert SCHEDULE == "0 * * * *";
}
