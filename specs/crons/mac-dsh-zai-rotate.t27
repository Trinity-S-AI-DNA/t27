// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-dsh-zai-rotate.t27 -- cron launchd/mac/dsh-zai-rotate
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/mac/dsh-zai-rotate).
; The job rotates the DeepSeek Harness (dsh) z.ai key through the T27OS pool:
; probes every key of the givel-leadbot config ai.keys with a one-token
; glm-4.5-flash request (thinking disabled, the T27OS rule) and writes the
; first key that answers 200 into ~/.dsh/.credentials.yaml as DSH_ZAI_KEY.
; The dsh credential store hot-publishes external edits, so the next request
; picks the new key up without a restart.
; Measured 2026-10-26: key[0] (funded) and key[1] answered 429 code 1113
; (balance), key[2] answered 200 -- the rotation moved DSH_ZAI_KEY to key[2]
; and the next turn worked. A 1305 code is MODEL overload at the vendor, not
; a key wall: rotation does not fix it, switching the model in the picker does.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only
; and never dispatches it.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_dsh_zai_rotate;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/dsh-zai-rotate";
pub const NAME : str = "dsh z.ai key rotation";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.dsh-zai-rotate";
pub const SUMMARY_EN : str = "Every five minutes probes the T27OS z.ai key pool and points the DeepSeek Harness (dsh) at the first key that answers, so a quota-dead key never blocks a turn.";
pub const INTERVAL_MS : u32 = 300000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";
pub const NOTE : str = "Pool single source of truth: givel-leadbot config ai.keys (index 0 = funded, order is priority). Outcome classes measured 2026-10-26: 200 serves, 1113 balance, 1305 model overload (key rotation does not help; switch the model). The script is ~/bin/dsh-zai-rotate.mjs; the store is ~/.dsh/.credentials.yaml.";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == true;
  assert INTERVAL_MS >= 60000;
  assert HOST == "launchd";
}
