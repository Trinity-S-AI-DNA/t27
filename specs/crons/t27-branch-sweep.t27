; specs/crons/t27-branch-sweep.t27 -- the weekly branch sweep as law.
; Procedure, measured 2026-10-26 (6391 -> 678 branches): classify every remote
; branch -- OPEN-PR HEADS ARE SKIPPED, tips younger than 24 h are SKIPPED
; (in-flight agent work), tips whose commit is an ancestor of master are
; CONTAINED (delete, nothing orphaned), the rest are ORPHANS (record branch +
; tip SHA + differing-file count in a tracking issue, THEN delete -- the SHA
; is the recovery pointer). The record precedes every deletion; a sweep that
; deletes without a record is the defect this card exists to prevent.

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/branch-sweep";
pub const NAME : str = "weekly branch sweep";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/branch-sweep.yml";
pub const SUMMARY_EN : str = "Weekly sweep: classify remote branches (skip open-PR heads and tips <24h old), record orphans with their tip SHA in a tracking issue, then delete contained and recorded branches. KeepAlive: none.";
pub const SCHEDULE : str = "0 6 * * 1";
pub const TZ : str = "UTC";
pub const ENABLED : bool = false;
pub const NOTE : str = "ENABLED=false: the card is the law; the host workflow wiring lands as an owner-approved-foreign follow-up. First sweep record: issue #1453 (1453 contained, 4466 orphans, 31 protected, 5305 deleted).";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

pub fn sweep_verdict(is_open_head: bool, age_s: u64, is_ancestor: bool) -> u8 {
    if (is_open_head) { return 0; }
    if (age_s < 86400) { return 1; }
    if (is_ancestor) { return 2; }
    return 3;
}

test sweep_verdict_skips_the_live_and_records_the_rest {
    const SKIP_OPEN : u8 = 0;
    const SKIP_YOUNG : u8 = 1;
    const DELETE_CONTAINED : u8 = 2;
    const RECORD_THEN_DELETE : u8 = 3;
    assert sweep_verdict(true, 999999, true) == SKIP_OPEN;
    assert sweep_verdict(false, 3600, true) == SKIP_YOUNG;
    assert sweep_verdict(false, 999999999, true) == DELETE_CONTAINED;
    assert sweep_verdict(false, 999999999, false) == RECORD_THEN_DELETE;
}
