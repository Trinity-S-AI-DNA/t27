// SPDX-License-Identifier: Apache-2.0
; specs/crons/t27-differential-oracle.t27 -- cron github-actions/t27/differential-oracle
; Nightly differential run of the 28 specs/ml/** specs that are blocked on t27b (#9065) against
; the t27c reference, recording the per-spec diff so a fix attempt is judged in minutes. Part of
; epic #6488 and issue #9065.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27_differential_oracle;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/differential-oracle";
pub const NAME : str = "Differential oracle (ml specs)";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/differential-oracle.yml";
pub const SUMMARY_EN : str = "Runs the 28 blocked ml specs through t27b and t27c nightly and records the per-spec diff, feeding issue #9065.";
pub const SCHEDULE : str = "0 3 * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == true;
  assert NAME == "Differential oracle (ml specs)";
  assert HOST == "github-actions";
  assert ON_FAILURE == "issue";
}