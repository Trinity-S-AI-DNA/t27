// specs/crons/t27os-night-loop.t27 -- the T27 OS improvement loop (t27os#3): every 15 minutes on the
// owner's Mac, one bounded tick -- take the top open task of the t27os board by Pareto, claim it in the
// swarm refs, do one unit, land or hand off, write the beat to the hive feed, never break a past merge.
// The tick engine lives on the Mac outside any repository (REPO mac): a claude -p run with the tick
// prompt and a state file at ~/.t27os/loop/state.json (LRU idempotency: one task per tick, a task done
// is never retaken). Owner, 2026-10-23, before sleeping: "create the cron, work autonomously without
// stopping, do not break past work, self-critical, auto-fix and merge when green, write .t27".
// ON_FAILURE issue: the tick posts its own failure to Trinity-S-AI-DNA/t27os#3 as a comment.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

KIND = "cron"
ID = "launchd/t27/t27os-night-loop"
NAME = "T27 OS night loop"
HOST = "launchd"
REPO = "mac"
SERVICE = "ai.t27.t27os-night-loop"
SUMMARY_EN = "One bounded improvement tick of T27 OS every 15 minutes: Pareto-pick from the t27os board, claim, implement in .t27, verify both compilers, land green or hand off, beat the hive feed."
INTERVAL_MS = 900000
TZ = "Asia/Bangkok"
ENABLED = true
ON_FAILURE = "issue"
CONTROL = "code-only"
NOTE = "spec-only by construction (launchd is not scanned); first tick 2026-10-23 night; the tick prompt forbids force-push, --no-verify and history rewrites, and requires a swarm claim before any code."
