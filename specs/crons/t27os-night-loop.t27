// specs/crons/t27os-night-loop.t27 -- the T27 OS improvement loop (t27os#3): every 5 minutes on the
// owner's Mac, one bounded tick -- take the top open task of the t27os board by Pareto, claim it in the
// swarm refs, do one unit, land or hand off, write the beat to the hive feed, never break a past merge.
// The tick engine lives on the Mac outside any repository (REPO mac): a claude -p run with the tick
// prompt and a state file at ~/.t27os/loop/state.json (lane discipline: done is never retaken,
// inprogress carries a two-hour lease, blocked needs a new angle). Owner, 2026-10-23, before sleeping:
// "create the cron, work autonomously without stopping, do not break past work, self-critical,
// auto-fix and merge when green, write .t27, verify the T27 OS UI works".
// ON_FAILURE issue: the tick posts its own failure to Trinity-S-AI-DNA/t27os#3 as a comment.
// The steps the tick executes, as law: BOARD-GUARD-STEP (first: the permanent board
// Trinity-S-AI-DNA/t27os#3 is OPEN -- its body orders "close tasks and PRs, not the epic"; a closed
// board is always a finding, graded worse with tasks unchecked, and the tick reopens it before
// anything else; the verdict is board_verdict below. A merge note that says Closes #3 is refused by
// merge_note_verdict: t27os#17 said "Closes #3 partial" and GitHub's keyword close swallowed the
// word "partial" -- the board auto-closed 2026-10-23 23:13Z, reopened by hand the same night),
// AUDIT-STEP (the wasm32 mine grep -> gHashTag/t27#11840),
// PR-GATE-STEP (dispatch the T27 OS lab per open PR specs/t27os head, one run in flight, the rest
// queued, the queue walked by queue_verdict; read receipts back from runs/), MERGE-STEP (after PR-GATE, one merge per tick, lowest first:
// an armed MERGEABLE PR or the loop's own CLEAN night/ PR with a lab receipt; merge_step_verdict), UI-HEALTH-STEP (the app process alive and the hive feed
// fresh, else rebuild and relaunch; the verdict is ui_health below, a DOWN app's repair is ui_down_action), SWEEP-STEP (every 6th tick, own merged lanes only, t27os#8),
// TASK-PICK-STEP (after the PR gate, before the claim; the law is night_take.t27 may_retake),
// RECEIPT-COMMENT-STEP (a receipt comment carries the disclosure footer; the law is disclosure.t27),
// RECEIPTS (a returned receipt is read through receipt_result.t27 RESULT_READ_CMD and branched by
// receipt_branch; MERGE-STEP's receipt input is that branch reading pass, never the file's existence),
// SYNC-STEP (the t27-owned-name grep over t27os; the law is t27os sync_gate.t27, the gate file skipped),
// RETROSPECTIVE (every 4th tick, one proposal to change this card).
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

use t27os::disclosure::footer_verdict;
use t27os::disclosure::DISC_OK;
use t27os::disclosure::N_KIND_COUNT;
use t27os::keysync::contains;
use t27os::receipt_result::receipt_branch;
use t27os::receipt_result::RB_PASS;
use t27os::receipt_result::RB_FAIL;
use t27os::receipt_result::RB_UNTYPED;
use t27os::receipt_result::RESULT_READ_CMD;
use claw::recipes::str_eq;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/t27os-night-loop";
pub const NAME : str = "T27 OS night loop";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.t27os-night-loop";
pub const SUMMARY_EN : str = "One bounded improvement tick of T27 OS every 5 minutes: Pareto-pick from the t27os board, claim, implement in .t27, verify both compilers, land green or hand off, beat the hive feed, check the UI health.";
pub const INTERVAL_MS : u32 = 300000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [1]str = ["t27os-night-loop"];
pub const RUNS_NOTE : str = "the loop is its own skill: the tick prompt is the law the card launches, and the take rule is specs/t27os/night_take.t27";
pub const ENABLED : bool = true;
pub const NOTE : str = "spec-only by construction (launchd is not scanned); first tick 2026-10-23 night; the tick prompt forbids force-push, --no-verify and history rewrites, requires a swarm claim before any code, and carries the lab law: verification dispatches the T27 OS lab (Trinity-S-AI-DNA/t27os lab.yml), never an external service";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "code-only";

// ---- UI-HEALTH-STEP: one verdict per tick (t27#11887) ----
// The hive feed job (S/Z rows) runs only while the HIVE page is open: glass_window.t27 hive_tick
// asks agent_parts.t27 page_feed_due, which is false for a closed page. The always-on heartbeat
// is the publish job; its result is ~/.t27os/hive/publish.txt as "<epoch> <exit>", every
// DV_PUBLISH_S = 300 s (devices.t27). So publish.txt is read first, and a stale Z is a finding
// only while the HIVE page is open. Measured 2026-10-23: Z frozen at 15:45Z for 3 h with the
// page closed while publish.txt said 18:51Z exit 0 -- eight ticks posted a false finding.
// Its verdict constants live in the tests below, not at top level (the trinity generator's
// schema for specs/crons/ fails a card on any top-level const beyond its own set): UI_OK 0,
// UI_DOWN 1, UI_PUBLISH_FAIL 2, UI_PUBLISH_STALE 3, UI_FEED_STALE 4; devices.t27: a heartbeat
// older than UI_PUBLISH_MAX_S 1800 (30 min) means OFFLINE; the tick law: a Z row older than
// UI_FEED_MAX_S 3600 (one hour), with the HIVE page open, is a finding.

/// Age of a stamp; a clock that went back (stamp in the future) reads as fresh, a missing stamp (0) as infinitely old.
pub fn ui_age(now: u64, at: u64) -> u64 {
    if (at == 0) { return 0xFFFFFFFFFFFFFFFF; }
    if (now < at) { return 0; }
    return now - at;
}

/// The verdict of UI-HEALTH-STEP. alive: the T27OS process exists. pub_at, pub_exit: publish.txt.
/// hive_open: the HIVE page is the open page. z_at: the epoch of the feed's Z row (0 if none).
pub fn ui_health(alive: bool, now: u64, pub_at: u64, pub_exit: u32, hive_open: bool, z_at: u64) -> u32 {
    if (alive == false) { return 1; } // UI_DOWN
    if (ui_age(now, pub_at) > 1800) { return 3; } // UI_PUBLISH_MAX_S; UI_PUBLISH_STALE
    if (pub_exit != 0) { return 2; } // UI_PUBLISH_FAIL
    if (hive_open and ui_age(now, z_at) > 3600) { return 4; } // UI_FEED_MAX_S; UI_FEED_STALE
    return 0; // UI_OK
}

/// Only these verdicts are posted on t27os#3; OK is a silent pass and DOWN is repaired (rebuild, relaunch) first.
pub fn ui_is_finding(verdict: u32) -> bool {
    return verdict == 2 or verdict == 3 or verdict == 4; // UI_PUBLISH_FAIL, UI_PUBLISH_STALE, UI_FEED_STALE
}

// ---- UI_DOWN repair: rebuild, one standing request, or hold (tick-156 retro) ----
// A cron tick on the Mac may not run make t27os: mac-no-heavy.py refuses the cargo build. Measured
// ticks 150-156 (2026-10-25): the launch trap was fixed by #12176 (de7c038e2d), each tick retried
// the rebuild, each was refused, and ticks 154 and 155 posted the same request twice. So a DOWN
// app with no build right is one standing request naming the master sha to build at, re-posted only
// when master gains a new specs/t27os/ fix after that sha; otherwise the tick holds silent.

// UI_DOWN repair actions, test-local below: UI_ACT_REBUILD 0, UI_ACT_REQUEST 1, UI_ACT_HOLD 2.

/// can_build: this tick may run make t27os. requested: a standing rebuild request is on t27os#3.
/// new_fix: master holds a specs/t27os/ commit newer than the sha that request names.
pub fn ui_down_action(can_build: bool, requested: bool, new_fix: bool) -> u32 {
    if (can_build) { return 0; } // UI_ACT_REBUILD
    if (requested == false or new_fix) { return 1; } // UI_ACT_REQUEST
    return 2; // UI_ACT_HOLD
}

test a_tick_that_may_build_rebuilds {
    const UI_ACT_REBUILD : u32 = 0;
    assert ui_down_action(true, false, false) == UI_ACT_REBUILD;
    assert ui_down_action(true, true, false) == UI_ACT_REBUILD;
    assert ui_down_action(true, true, true) == UI_ACT_REBUILD;
}

test a_refused_build_posts_one_request_then_holds {
    const UI_ACT_REQUEST : u32 = 1;
    const UI_ACT_HOLD : u32 = 2;
    // tick 154: no request yet -> request; tick 155: request stands, master unchanged -> hold
    assert ui_down_action(false, false, false) == UI_ACT_REQUEST;
    assert ui_down_action(false, true, false) == UI_ACT_HOLD;
}

test a_new_t27os_fix_on_master_renews_the_request {
    const UI_ACT_REBUILD : u32 = 0;
    const UI_ACT_REQUEST : u32 = 1;
    const UI_ACT_HOLD : u32 = 2;
    assert ui_down_action(false, true, true) == UI_ACT_REQUEST;
    assert ui_down_action(false, false, true) == UI_ACT_REQUEST;
    assert UI_ACT_REBUILD != UI_ACT_REQUEST and UI_ACT_REQUEST != UI_ACT_HOLD;
}

test a_closed_hive_page_with_an_old_z_row_is_healthy {
    // the 2026-10-23 night: Z 1792770319 (15:45Z), publish 1792781485 exit 0, now 1792782518
    const UI_OK : u32 = 0;
    assert ui_health(true, 1792782518, 1792781485, 0, false, 1792770319) == UI_OK;
    assert ui_is_finding(UI_OK) == false;
}

test the_same_old_z_row_with_the_page_open_is_a_finding {
    const UI_FEED_STALE : u32 = 4;
    const UI_OK : u32 = 0;
    assert ui_health(true, 1792782518, 1792781485, 0, true, 1792770319) == UI_FEED_STALE;
    assert ui_health(true, 1792782518, 1792781485, 0, true, 1792782000) == UI_OK;
    assert ui_is_finding(UI_FEED_STALE);
}

test a_dead_app_wins_over_every_other_signal {
    const UI_DOWN : u32 = 1;
    const UI_OK : u32 = 0;
    assert ui_health(false, 1792782518, 1792781485, 0, false, 1792782000) == UI_DOWN;
    assert ui_health(false, 1792782518, 0, 1, true, 0) == UI_DOWN;
    assert ui_is_finding(UI_DOWN) == false;
}

test the_publish_heartbeat_is_judged_first {
    const UI_PUBLISH_STALE : u32 = 3;
    const UI_PUBLISH_FAIL : u32 = 2;
    const UI_OK : u32 = 0;
    assert ui_health(true, 10000, 10000 - 1801, 0, false, 0) == UI_PUBLISH_STALE;
    assert ui_health(true, 10000, 10000 - 1800, 0, false, 0) == UI_OK;
    assert ui_health(true, 10000, 0, 0, false, 9999) == UI_PUBLISH_STALE;
    assert ui_health(true, 10000, 9900, 128, false, 9999) == UI_PUBLISH_FAIL;
    assert ui_is_finding(UI_PUBLISH_FAIL) and ui_is_finding(UI_PUBLISH_STALE);
}

test a_clock_that_went_back_reads_fresh {
    const UI_OK : u32 = 0;
    assert ui_age(100, 200) == 0;
    assert ui_age(200, 100) == 100;
    assert ui_health(true, 100, 200, 0, true, 300) == UI_OK;
}

test the_card_names_the_engine_and_the_cadence {
    assert ID == "launchd/mac/t27os-night-loop";
    assert INTERVAL_MS == 300000 and TZ == "Asia/Bangkok";
    assert HOST == "launchd" and CONTROL == "code-only";
    assert KIND == "cron" and ENABLED;
}

test the_required_schema_fields_are_the_generators {
    // the trinity generator's CRON_REQUIRED: KIND, RUNS, RUNS_NOTE -- the fields
    // whose absence fails the site build (measured: the untyped pre-fix card
    // broke t27b itself at StmtAssign at top level)
    assert KIND.len > 0 and RUNS.len == 1 and RUNS_NOTE.len > 0;
    assert RUNS[0] == "t27os-night-loop";
}

// ---- SWEEP-STEP: lane hygiene as a tick step (Trinity-S-AI-DNA/t27os#8) ----
// The verdict per worktree is NOT restated here: it is worktree_keep.t27 lane_sweep_verdict
// (merged into origin/master AND clean AND no live refs/swarm/claims/<N> -> release; unknown
// keeps). This card says only when the step runs, which trees it may touch, and how much per
// tick. Owner law (CLAUDE.md, forbidden list): no permanent deletion of anything that is not
// your own merged lane tree -- so a dead lane of another actor is counted in the beat, never removed.
// Measured 2026-10-23: 206 worktrees, 3 dead, 27 dirty (kept), the rest clean-but-unmerged (kept).

// SWEEP-STEP constants, test-local below: SWEEP_EVERY 6 (30 min at INTERVAL_MS),
// SWEEP_MAX_REMOVE 8, SWEEP_OWN_PREFIX "night-", SWEEP_BEAT "G|hygiene|",
// SWEEP_LAW "specs/queen/worktree_keep.t27 lane_sweep_verdict".

pub fn sweep_due(tick_n: u64) -> bool {
    return tick_n > 0 and tick_n % 6 == 0; // SWEEP_EVERY
}

/// own_lane: the worktree is one of this loop's lanes. release: lane_sweep_verdict said release.
/// removed: removals already done this tick.
pub fn sweep_remove(own_lane: bool, release: bool, removed: u32) -> bool {
    if (own_lane == false) { return false; }
    if (removed >= 8) { return false; } // SWEEP_MAX_REMOVE
    return release;
}

test the_sweep_runs_every_sixth_tick_and_never_on_tick_zero {
    assert sweep_due(0) == false;
    assert sweep_due(6) and sweep_due(24);
    assert sweep_due(22) == false and sweep_due(23) == false;
}

test only_an_own_released_lane_is_removed_and_at_most_eight_per_tick {
    assert sweep_remove(true, true, 0);
    assert sweep_remove(true, true, 7);
    assert sweep_remove(true, true, 8) == false;
    assert sweep_remove(true, false, 0) == false;
    // another actor's dead lane: counted, never removed
    assert sweep_remove(false, true, 0) == false;
}

test the_sweep_names_its_law_and_its_beat {
    const SWEEP_MAX_REMOVE : u32 = 8;
    const SWEEP_OWN_PREFIX : str = "night-";
    const SWEEP_BEAT : str = "G|hygiene|";
    const SWEEP_LAW : str = "specs/queen/worktree_keep.t27 lane_sweep_verdict";
    assert SWEEP_OWN_PREFIX == "night-" and SWEEP_BEAT == "G|hygiene|";
    assert SWEEP_LAW.len > 0 and SWEEP_MAX_REMOVE == 8;
}

// ---- STALE-DRAFT-STEP: a parked night draft is rebuilt on master, not queued (t27#12105) ----
// The tick-124 retrospective: #11916 sat 27 hours as a draft behind the #11903 reseal batch, its
// base far behind master; rebuilt on master as one commit with lab seal=true it took 5 minutes and
// landed as #12104. A draft whose only open item is a seal batch is not waiting on anything the
// batch gives it: the lab's seal=true leg reseals on the new base. So the step rebuilds it --
// one per tick (one lab run in flight), and only the loop's own night/ drafts: another actor's
// lane is that actor's to rebase.

// STALE-DRAFT-STEP constants, test-local below: SD_WAIT 0, SD_REBUILD 1, SD_NOT_OURS 2,
// SD_STALE_S 43200 (a base older than this, 12 h, behind master is stale; the #11916 base was
// 27 h behind), SD_MAX_PER_TICK 1 (each rebuild dispatches the lab, one run in flight),
// SD_BRANCH_PREFIX "night/".

/// night_branch: the head branch starts SD_BRANCH_PREFIX. draft: the PR is a draft. seal_only: its
/// only open item is a seal batch. behind_s: how far its base is behind master, in seconds.
/// rebuilt: rebuilds already done this tick.
pub fn stale_draft_verdict(night_branch: bool, draft: bool, seal_only: bool, behind_s: u64, rebuilt: u32) -> u32 {
    if (night_branch == false or draft == false) { return 2; } // SD_NOT_OURS
    if (seal_only == false) { return 0; } // SD_WAIT
    if (behind_s <= 43200) { return 0; } // SD_STALE_S; SD_WAIT
    if (rebuilt >= 1) { return 0; } // SD_MAX_PER_TICK; SD_WAIT
    return 1; // SD_REBUILD
}

test the_11916_case_is_rebuilt_on_master {
    const SD_REBUILD : u32 = 1;
    // night/124 draft, open item = the #11903 seal batch, base 27 h behind
    assert stale_draft_verdict(true, true, true, 97200, 0) == SD_REBUILD;
}

test an_eleven_hour_old_base_still_waits {
    const SD_WAIT : u32 = 0;
    const SD_REBUILD : u32 = 1;
    const SD_STALE_S : u64 = 43200;
    assert stale_draft_verdict(true, true, true, 39600, 0) == SD_WAIT;
    // exactly 12 h is not yet stale
    assert stale_draft_verdict(true, true, true, SD_STALE_S, 0) == SD_WAIT;
    assert stale_draft_verdict(true, true, true, SD_STALE_S + 1, 0) == SD_REBUILD;
}

test negative_control_another_lane_or_a_ready_pr_is_never_rebuilt {
    const SD_NOT_OURS : u32 = 2;
    // lane/analog-* of another actor, stale and seal-only: still not ours
    assert stale_draft_verdict(false, true, true, 97200, 0) == SD_NOT_OURS;
    // a night PR already undrafted is left to MERGE-STEP and GitHub
    assert stale_draft_verdict(true, false, true, 97200, 0) == SD_NOT_OURS;
}

test a_draft_with_a_real_red_waits_for_its_repair {
    const SD_WAIT : u32 = 0;
    assert stale_draft_verdict(true, true, false, 97200, 0) == SD_WAIT;
}

test at_most_one_rebuild_per_tick {
    const SD_WAIT : u32 = 0;
    const SD_MAX_PER_TICK : u32 = 1;
    const SD_BRANCH_PREFIX : str = "night/";
    assert stale_draft_verdict(true, true, true, 97200, 1) == SD_WAIT;
    assert SD_MAX_PER_TICK == 1 and SD_BRANCH_PREFIX == "night/";
}

// ---- QUEUE-STEP: which pending_dispatch pair goes to the lab next (t27#12412) ----
// The tick-188 retrospective: the lab runs one job at a time, and on 2026-10-25 run 40189566608
// sat queued 40 minutes while three pairs waited in pending_dispatch. One of them, #12399 at
// 79ecce273c, was superseded by a newer head (3dca4a0f0c) before it was ever sent; and the loop's
// own night/ drafts (#12397, #12402), which block the tick's own landing, waited behind foreign
// heads. So before every dispatch the tick walks pending_dispatch through this verdict: a
// superseded sha is dropped at once (even while the slot is busy, so the queue never carries
// dead heads), a busy slot holds everything else, and a foreign pair holds while one of the
// loop's own pairs still waits.

// QUEUE-STEP constants, test-local below: QV_DROP 0, QV_HOLD 1, QV_SEND 2.

/// superseded: a newer head of the same PR exists. slot_busy: a lab run is queued or in progress.
/// ours: the pair is the loop's own (a night/ PR or a master reseal task the loop holds).
/// ours_waiting: some other pair of the loop's own still waits in pending_dispatch.
pub fn queue_verdict(superseded: bool, slot_busy: bool, ours: bool, ours_waiting: bool) -> u32 {
    if (superseded) { return 0; } // QV_DROP
    if (slot_busy) { return 1; } // QV_HOLD
    if (ours == false and ours_waiting) { return 1; } // QV_HOLD
    return 2; // QV_SEND
}

test the_12399_superseded_head_is_dropped_even_while_the_slot_is_busy {
    const QV_DROP : u32 = 0;
    // #12399 queued at 79ecce273c, head moved to 3dca4a0f0c, run 40189566608 in progress
    assert queue_verdict(true, true, false, true) == QV_DROP;
    assert queue_verdict(true, false, true, false) == QV_DROP;
}

test a_busy_slot_holds_every_live_pair {
    const QV_HOLD : u32 = 1;
    assert queue_verdict(false, true, true, false) == QV_HOLD;
    assert queue_verdict(false, true, false, false) == QV_HOLD;
}

test the_loops_own_pair_goes_before_a_foreign_head {
    const QV_HOLD : u32 = 1;
    const QV_SEND : u32 = 2;
    // #12402 (night/189) waits: the foreign #12399 head holds, #12402 itself is sent
    assert queue_verdict(false, false, false, true) == QV_HOLD;
    assert queue_verdict(false, false, true, true) == QV_SEND;
}

test negative_control_a_foreign_pair_is_sent_once_no_own_pair_waits {
    const QV_SEND : u32 = 2;
    assert queue_verdict(false, false, false, false) == QV_SEND;
    assert queue_verdict(false, false, true, false) == QV_SEND;
}

// ---- MERGE-STEP: armed PRs and the loop's own green night PRs, one per tick (t27#12111) ----
// The tick-128 retrospective: the prompt's MERGE-STEP read only armed PRs, so #12106 -- a night/ PR,
// lab-green on both legs -- sat about 25 minutes CLEAN and unarmed, and tick 127 found nothing armed
// and stopped. The loop's own night/ PR with a lab receipt for its head is as ready as an armed one.
// Still one merge per tick, lowest number first (the CI queue starves when master moves in big
// steps); DIRTY is its owner's to rebase; BLOCKED/queued armed PRs stay with GitHub auto-merge;
// another actor's unarmed lane and any draft are never merged by the loop.

// MERGE-STEP constants, test-local below: MS_WAIT 0, MS_MERGE 1, MS_SKIP_DIRTY 2,
// MS_LEAVE_GITHUB 3, MS_NOT_OURS 4, MS_MAX_PER_TICK 1.

/// armed: auto-merge is on. night_branch: the head starts SD_BRANCH_PREFIX. draft: the PR is a draft.
/// clean: mergeStateStatus is CLEAN or MERGEABLE. dirty: it is DIRTY. receipt: a lab receipt exists
/// for the head sha. lower_ready: a lower-numbered PR already got MS_MERGE this tick. merged: merges
/// done this tick.
pub fn merge_step_verdict(armed: bool, night_branch: bool, draft: bool, clean: bool, dirty: bool, receipt: bool, lower_ready: bool, merged: u32) -> u32 {
    if (draft) { return 4; } // MS_NOT_OURS
    if (armed == false and night_branch == false) { return 4; } // MS_NOT_OURS
    if (dirty) { return 2; } // MS_SKIP_DIRTY
    if (clean == false) {
        if (armed) { return 3; } // MS_LEAVE_GITHUB
        return 0; // MS_WAIT
    }
    if (armed == false and receipt == false) { return 0; } // MS_WAIT
    if (lower_ready or merged >= 1) { return 0; } // MS_MAX_PER_TICK; MS_WAIT
    return 1; // MS_MERGE
}

test the_12106_case_is_merged_by_the_tick {
    const MS_MERGE : u32 = 1;
    // night/126 PR, unarmed, CLEAN, lab 36/36 both legs on its head
    assert merge_step_verdict(false, true, false, true, false, true, false, 0) == MS_MERGE;
}

test an_armed_mergeable_pr_is_still_merged {
    const MS_MERGE : u32 = 1;
    assert merge_step_verdict(true, false, false, true, false, false, false, 0) == MS_MERGE;
}

test negative_control_another_actors_clean_unarmed_lane_is_not_ours {
    const MS_NOT_OURS : u32 = 4;
    // lane/analog-adc-mutants-12096 (#12108): CLEAN, unarmed, not night/
    assert merge_step_verdict(false, false, false, true, false, true, false, 0) == MS_NOT_OURS;
    // a night draft is STALE-DRAFT-STEP's, never merged here
    assert merge_step_verdict(false, true, true, true, false, true, false, 0) == MS_NOT_OURS;
}

test a_night_pr_without_a_receipt_or_still_running_waits {
    const MS_WAIT : u32 = 0;
    assert merge_step_verdict(false, true, false, true, false, false, false, 0) == MS_WAIT;
    // #12107 at tick 129: UNSTABLE, one check pending
    assert merge_step_verdict(false, true, false, false, false, true, false, 0) == MS_WAIT;
}

test dirty_is_skipped_and_blocked_armed_is_left_to_github {
    const MS_SKIP_DIRTY : u32 = 2;
    const MS_LEAVE_GITHUB : u32 = 3;
    assert merge_step_verdict(true, false, false, false, true, false, false, 0) == MS_SKIP_DIRTY;
    assert merge_step_verdict(false, true, false, false, true, true, false, 0) == MS_SKIP_DIRTY;
    assert merge_step_verdict(true, false, false, false, false, false, false, 0) == MS_LEAVE_GITHUB;
}

test one_merge_per_tick_lowest_number_first {
    const MS_WAIT : u32 = 0;
    const MS_MAX_PER_TICK : u32 = 1;
    // a higher-numbered candidate waits when a lower one is already chosen, or one merge is done
    assert merge_step_verdict(false, true, false, true, false, true, true, 0) == MS_WAIT;
    assert merge_step_verdict(true, false, false, true, false, false, false, 1) == MS_WAIT;
    assert MS_MAX_PER_TICK == 1;
}

// ---- LAND-STEP reference: a local Refs #N (t27#11873) ----
// The L1 gates (check-linked-issue, Check L1 TRACEABILITY) match
// (Closes|Fixes|Resolves|Refs|Updates)\s*#[0-9]+ in every non-merge commit message. A cross-repo
// reference such as "Refs Trinity-S-AI-DNA/t27os#8" does not match, and a pushed commit cannot be
// repaired without a force-push (forbidden): three night PRs went red that way on 2026-10-23.
// So step (5) LAND refuses to commit or open a PR unless the text carries a local reference.
// The tracking issue is test-local below: L1_TRACKING 11873.

/// Does text[0 .. at] end with lit?
pub fn nl_ends_with(text: []const u8, at: usize, lit: string) -> bool {
    if (at < lit.len or at > text.len) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (text[at - lit.len + k] != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is there a "#<digit>" whose prefix, after skipping whitespace back, ends with an L1 verb?
pub fn l1_local_ref(text: []const u8) -> bool {
    var i : usize = 0;
    while (i + 1 < text.len) {
        if (text[i] == 35 and text[i + 1] >= 48 and text[i + 1] <= 57) {
            var j : usize = i;
            while (j > 0 and (text[j - 1] == 32 or text[j - 1] == 9 or text[j - 1] == 10)) { j = j - 1; }
            if (nl_ends_with(text, j, "Refs") or nl_ends_with(text, j, "Closes") or nl_ends_with(text, j, "Fixes")
                or nl_ends_with(text, j, "Resolves") or nl_ends_with(text, j, "Updates")) { return true; }
        }
        i = i + 1;
    }
    return false;
}

test a_cross_repo_only_reference_is_refused {
    assert l1_local_ref("spec(os): sweep step (Refs Trinity-S-AI-DNA/t27os#8)") == false;
    assert l1_local_ref("no reference at all") == false;
    assert l1_local_ref("Refs #") == false;
    // a bare hash without a verb is not a reference either
    assert l1_local_ref("see #11873") == false;
}

test a_local_reference_passes_next_to_the_cross_repo_one {
    const L1_TRACKING : u32 = 11873;
    assert l1_local_ref("spec(os): sweep step (Refs #11873, Trinity-S-AI-DNA/t27os#8)");
    assert l1_local_ref("Closes #5");
    assert l1_local_ref("Refs\n#11873");
    assert L1_TRACKING == 11873;
}

// ---- TASK-PICK-STEP: the take rule is night_take.t27 (t27#11956) ----
// The rule that decides what a tick may take -- done never, a foreign claim ref never, blocked only
// with a new angle, a stale in-progress lease back to the pool, a leg-only remainder never, a task
// blocked twice on one credential handed to a request -- and the Pareto pick among the takeable ones
// live in specs/t27os/night_take.t27. This card does NOT restate them, the lease length included:
// it says only which function is the law and where the step sits. The pick runs after the PR gate
// (SELF-CRITICAL: a red night PR is repaired before new work) and before the claim (step 2).
// Measured 2026-10-24: retake entries older than two hours were judged by prompt prose for 55 ticks,
// because no step of this card pointed at may_retake (t27#11892 landed the law, not the pointer).

// (the 55-tick drift measured 2026-10-24). The step's constants are test-local below:
// L1_PICK 11956, PICK_LAW "specs/t27os/night_take.t27 may_retake",
// PICK_RANK_LAW "specs/t27os/night_take.t27 pick".

/// Inequality on str, card-local: `!=` on []const u8 does not lower (#5980), and a `==` inside a
/// function body lowers raw while a test assert lowers to std.mem.eql -- so the negation goes
/// through recipes.t27's length-and-byte walker, the same route disclosure.t27 uses.
pub fn str_differs(a: str, b: str) -> bool {
    return str_eq(a, b) == false;
}

/// May the tick run its pick? Only once the PR gate ran this tick and no own night PR is red.
pub fn pick_may_run(pr_gate_done: bool, own_red_prs: u32) -> bool {
    if (pr_gate_done == false) { return false; }
    return own_red_prs == 0;
}

test the_pick_waits_for_the_pr_gate_and_for_every_red_repair {
    assert pick_may_run(true, 0);
    assert pick_may_run(false, 0) == false;
    assert pick_may_run(true, 1) == false;
    assert pick_may_run(true, 16) == false;
}

test the_pick_step_points_at_the_retake_law {
    const L1_PICK : u32 = 11956;
    const PICK_LAW : str = "specs/t27os/night_take.t27 may_retake";
    const PICK_RANK_LAW : str = "specs/t27os/night_take.t27 pick";
    assert PICK_LAW == "specs/t27os/night_take.t27 may_retake";
    assert PICK_RANK_LAW == "specs/t27os/night_take.t27 pick";
    assert L1_PICK == 11956;
}

test negative_control_the_pre_retake_rule_is_not_the_step_law {
    const PICK_LAW : str = "specs/t27os/night_take.t27 may_retake";
    const PICK_RANK_LAW : str = "specs/t27os/night_take.t27 pick";
    // may_take ignores the two-hour lease: naming it here would bring back the 55-tick drift
    // (the `!=` lowering on str is still open on #5980; these two asserts read as str_differs)
    assert str_differs(PICK_LAW, "specs/t27os/night_take.t27 may_take");
    assert str_differs(PICK_LAW, PICK_RANK_LAW);
    assert pick_may_run(false, 1) == false;
}

// ---- SELF-CRITICAL: an own night PR already on master is closed, not repaired (t27#12396) ----
// The tick-184 retrospective: night PR #12362 sat about 2 h waiting on red CI (8 stale seals and a
// diff.t27 typecheck) while origin/master already carried the same bytes (b0887aba5b, 672aaca7d3).
// A PR whose touched files all equal origin/master has nothing left to land, red or green, so the
// duplicate check is judged BEFORE the red check. Only the loop's own night/ PRs: another actor's
// PR is that actor's to close.

// SELF-CRITICAL constants, test-local below: DR_NONE 0, DR_REPAIR 1, DR_CLOSE_DUP 2, DR_NOT_OURS 3.

/// own_night: the head branch starts "night/". red: a required check failed on the head.
/// differing: touched files whose bytes differ from origin/master (git diff origin/master...head
/// limited to the PR's files, counted).
pub fn dup_repair_verdict(own_night: bool, red: bool, differing: u32) -> u32 {
    if (own_night == false) { return 3; } // DR_NOT_OURS
    if (differing == 0) { return 2; } // DR_CLOSE_DUP
    if (red) { return 1; } // DR_REPAIR
    return 0; // DR_NONE
}

test the_12362_case_is_closed_as_a_duplicate {
    const DR_CLOSE_DUP : u32 = 2;
    // red on 8 stale seals + a typecheck, every touched file already equal to origin/master
    assert dup_repair_verdict(true, true, 0) == DR_CLOSE_DUP;
    // a green duplicate is closed too: merging it would land an empty diff
    assert dup_repair_verdict(true, false, 0) == DR_CLOSE_DUP;
}

test a_red_night_pr_with_real_bytes_is_repaired {
    const DR_REPAIR : u32 = 1;
    assert dup_repair_verdict(true, true, 1) == DR_REPAIR;
    assert dup_repair_verdict(true, true, 12) == DR_REPAIR;
}

test a_green_night_pr_with_real_bytes_is_left_to_merge_step {
    const DR_NONE : u32 = 0;
    assert dup_repair_verdict(true, false, 1) == DR_NONE;
}

test negative_control_another_actors_duplicate_is_not_closed_by_the_tick {
    const DR_NOT_OURS : u32 = 3;
    const DR_CLOSE_DUP : u32 = 2;
    assert dup_repair_verdict(false, true, 0) == DR_NOT_OURS;
    assert dup_repair_verdict(false, false, 0) == DR_NOT_OURS;
    assert dup_repair_verdict(false, true, 0) != DR_CLOSE_DUP;
}

// ---- RECEIPT-COMMENT-STEP: the footer is disclosure.t27 footer_verdict (t27#11958) ----
// When a receipt comes back, the tick comments its pass and fail lines on the PR and the task issue.
// Those lines are numbers T27 OS publishes about itself (t27os#20), so each comment ends with the
// five-line footer of specs/t27os/disclosure.t27, filled from what the tick already holds:
//   reader: the receipt's t27c build stamp and the spec list it was asked to measure;
//   judge:  t27c test-report (vacuous and blocked counted, never passed);
//   n:      the run count in words ("n=1 run"), never a CI from one run;
//   cost:   the wall-clock from the state's dispatched_at to the receipt's utc;
//   repro:  the exact gh workflow run lab.yml line with sha, challenge and specs.
// This card does NOT restate the field rules or the verdict codes: footer_verdict is the law, and a
// comment it does not judge DISC_OK is not posted. Read 2026-10-24 from the loop state: the receipt
// comments through tick 56 carried pass/fail lines and no footer -- none said its cost or its n.
// The step's constants are test-local below: L1_FOOTER 11958,
// FOOTER_LAW "specs/t27os/disclosure.t27 footer_verdict".

/// The wall-clock cost in seconds, from dispatch to receipt; 0 when the receipt reads older than
/// its dispatch (a clock that went back), which the tick then reports as an unknown cost.
pub fn receipt_wall_s(dispatched_at: u64, receipt_utc: u64) -> u64 {
    if (receipt_utc < dispatched_at) { return 0; }
    return receipt_utc - dispatched_at;
}

/// May the tick post this receipt comment? Only when its footer is judged DISC_OK, n stated as a count.
pub fn receipt_comment_may_post(reader: str, judge: str, n_text: str, cost: str, repro: str, runs: u32) -> bool {
    return footer_verdict(reader, judge, n_text, cost, repro, runs, N_KIND_COUNT) == DISC_OK;
}

test a_receipt_comment_with_its_full_footer_is_posted {
    // tick 56: runs/e8fb02547e7ab42eb474b71f560927d00109b6c9.c43e7ef1.json, dispatched 05:23:58Z
    assert receipt_comment_may_post("t27c build stamp of the receipt; specs crons/t27os-night-loop, t27os/night_take",
                                    "t27c test-report; vacuous and blocked counted, never passed",
                                    "n=1 run",
                                    "250 s wall-clock, dispatch to receipt",
                                    "gh workflow run lab.yml --repo Trinity-S-AI-DNA/t27os -f sha=e8fb02547e7a -f challenge=<hex> -f specs=<paths>",
                                    1);
    assert receipt_wall_s(1000, 1250) == 250;
}

test negative_control_a_comment_without_cost_or_run_is_not_posted {
    assert receipt_comment_may_post("t27c build", "t27c test-report", "n=1 run", "", "gh workflow run lab.yml", 1) == false;
    assert receipt_comment_may_post("t27c build", "t27c test-report", "n=1 run", "TBD", "gh workflow run lab.yml", 1) == false;
    assert receipt_comment_may_post("t27c build", "t27c test-report", "n=0", "0 s", "gh workflow run lab.yml", 0) == false;
    assert receipt_wall_s(1250, 1000) == 0;
}

test the_footer_step_points_at_the_disclosure_law {
    const L1_FOOTER : u32 = 11958;
    const FOOTER_LAW : str = "specs/t27os/disclosure.t27 footer_verdict";
    assert FOOTER_LAW == "specs/t27os/disclosure.t27 footer_verdict";
    assert L1_FOOTER == 11958;
}

// ---- RECEIPTS: the read is receipt_result.t27 receipt_branch (t27os#18, t27#11954) ----
// A returned receipt is read through ONE command, RESULT_READ_CMD with the receipt path appended,
// and the tick branches on receipt_branch of what it printed: pass, fail, or untyped. This card does
// NOT restate the jq read or the branch order: receipt_result.t27 is the law. What the card adds is
// where the answer goes. MERGE-STEP's receipt input is receipt_merges below, so a receipt that exists
// but reads false or untyped (written before t27os#34, or a run that typed nothing) does not make a
// night PR ready. Measured 2026-10-24 on the loop state: ticks 1-134 read the display rows
// pass=N FAIL=N by eye, and a receipt file's existence alone counted as merge_step_verdict receipt.
// The step's constants are test-local below: L1_RECEIPTS 11954,
// RECEIPTS_LAW "specs/t27os/receipt_result.t27 receipt_branch".

/// MERGE-STEP's receipt input: the typed result read pass, nothing else.
pub fn receipt_merges(answer: []const u8) -> bool {
    return receipt_branch(answer) == RB_PASS;
}

/// Does the tick comment pass and fail lines? A typed answer, either way; an untyped one is reported
/// as untyped, never by parsing the display rows.
pub fn receipt_typed(answer: []const u8) -> bool {
    return receipt_branch(answer) != RB_UNTYPED;
}

test a_typed_pass_is_the_merge_steps_receipt {
    // tick 135: runs/dbfb695e30*.json printed true through RESULT_READ_CMD
    assert receipt_merges("true");
    assert receipt_merges("true\n");
    assert receipt_typed("true");
    assert receipt_typed("false");
}

test negative_control_an_existing_but_untyped_or_failed_receipt_does_not_merge {
    // tick 135: the pre-#34 receipt of 8f28c2d849 printed untyped
    assert receipt_merges("untyped") == false;
    assert receipt_merges("false") == false;
    assert receipt_merges("") == false;
    assert receipt_merges("null") == false;
    assert receipt_typed("untyped") == false;
    assert receipt_typed("") == false;
    assert receipt_branch("false") == RB_FAIL;
}

test the_receipts_step_points_at_the_result_law {
    const L1_RECEIPTS : u32 = 11954;
    const RECEIPTS_LAW : str = "specs/t27os/receipt_result.t27 receipt_branch";
    assert RECEIPTS_LAW == "specs/t27os/receipt_result.t27 receipt_branch";
    assert contains(RESULT_READ_CMD, ".result.ok");
    assert L1_RECEIPTS == 11954;
}

// ---- PROMPT-DRIFT: the launched prompt names every step of this card (t27os#3) ----
// RUNS_NOTE says the tick prompt is the law this card launches, but the prompt lives in
// ~/.t27os/loop/tick.sh, outside any repository, and is edited by hand. Read 2026-10-24 at tick 80:
// its step headings were AUDIT-STEP, PR-GATE-STEP, TICK, RECEIPTS, RETROSPECTIVE, UI-HEALTH-STEP,
// SYNC-STEP, SELF-CRITICAL -- SWEEP-STEP, TASK-PICK-STEP and RECEIPT-COMMENT-STEP were law here and
// absent there (the feed holds one G|hygiene beat since #11888; ticks 66, 72, 78 did not sweep),
// and its UI step read the Z row while UI-HEALTH-STEP above reads publish.txt first.
// SYNC-STEP (t27os#6) is in the prompt and joins this list; its body is t27#11981.
// BOARD-GUARD-STEP (#11979) runs first, so it is step 0. Read again at tick 102: the prompt had gained
// MERGE-STEP and still named none of BOARD-GUARD-STEP, SWEEP-STEP, TASK-PICK-STEP, RECEIPT-COMMENT-STEP
// nor publish.txt -- the drift grew from 4 to 5 in 22 ticks with no gate on the launched text.
// The verdict is a count of law steps the prompt does not name; 0 is the only launchable prompt.
// The section's constants are test-local below: STEP_COUNT 9, UI_FIRST_SOURCE "publish.txt",
// plus the two recorded prompts PROMPT_TICK80 and PROMPT_TICK102.

/// The i-th step of this card, in tick order; "" past the end.
pub fn law_step(i: u32) -> str {
    if (i == 0) { return "BOARD-GUARD-STEP"; }
    if (i == 1) { return "AUDIT-STEP"; }
    if (i == 2) { return "PR-GATE-STEP"; }
    if (i == 3) { return "UI-HEALTH-STEP"; }
    if (i == 4) { return "SYNC-STEP"; }
    if (i == 5) { return "SWEEP-STEP"; }
    if (i == 6) { return "TASK-PICK-STEP"; }
    if (i == 7) { return "RECEIPT-COMMENT-STEP"; }
    if (i == 8) { return "RETROSPECTIVE"; }
    return "";
}

/// How many law steps the prompt does not name, plus 1 when it does not name UI_FIRST_SOURCE
/// ("publish.txt", the UI step's first source; a prompt that omits it reads the Z row).
pub fn prompt_drift(prompt: str) -> u32 {
    var missing : u32 = 0;
    var i : u32 = 0;
    while (i < 9) { // STEP_COUNT
        if (contains(prompt, law_step(i)) == false) { missing = missing + 1; }
        i = i + 1;
    }
    if (contains(prompt, "publish.txt") == false) { missing = missing + 1; } // UI_FIRST_SOURCE
    return missing;
}

/// The first law step the prompt does not name; STEP_COUNT (9) when it names them all.
pub fn first_missing_step(prompt: str) -> u32 {
    var i : u32 = 0;
    while (i < 9) { // STEP_COUNT
        if (contains(prompt, law_step(i)) == false) { return i; }
        i = i + 1;
    }
    return 9; // STEP_COUNT
}

pub fn prompt_may_launch(prompt: str) -> bool {
    return prompt_drift(prompt) == 0;
}

test the_tick80_prompt_drifts_by_four_steps_and_the_ui_source {
    // the tick-80 prompt, reduced to its step headings and its UI sentence (tick.sh line 11 onward)
    const PROMPT_TICK80 : str = "AUDIT-STEP (every tick, cheap) PR-GATE-STEP (every tick) TICK: RECEIPTS: RETROSPECTIVE: UI-HEALTH-STEP (every tick): check the hive feed Z row is younger than one hour SYNC-STEP (every tick) SELF-CRITICAL:";
    assert prompt_drift(PROMPT_TICK80) == 5;
    assert first_missing_step(PROMPT_TICK80) == 0;
    assert law_step(0) == "BOARD-GUARD-STEP";
    assert law_step(5) == "SWEEP-STEP";
    assert prompt_may_launch(PROMPT_TICK80) == false;
}

test the_tick102_prompt_still_drifts_merge_step_is_not_a_law_step {
    // the tick-102 prompt, reduced the same way: MERGE-STEP added, the four missing steps still missing
    const PROMPT_TICK102 : str = "AUDIT-STEP (every tick, cheap) PR-GATE-STEP (every tick) MERGE-STEP (every tick, after PR-GATE) TICK: RECEIPTS: RETROSPECTIVE: UI-HEALTH-STEP (every tick): check the hive feed's Z row is younger than one hour SYNC-STEP (every tick) SELF-CRITICAL:";
    // the tick-80 prompt again, for the drift-equality assert below
    const PROMPT_TICK80 : str = "AUDIT-STEP (every tick, cheap) PR-GATE-STEP (every tick) TICK: RECEIPTS: RETROSPECTIVE: UI-HEALTH-STEP (every tick): check the hive feed Z row is younger than one hour SYNC-STEP (every tick) SELF-CRITICAL:";
    assert prompt_drift(PROMPT_TICK102) == 5;
    assert first_missing_step(PROMPT_TICK102) == 0;
    assert prompt_may_launch(PROMPT_TICK102) == false;
    // the prompt-only MERGE-STEP does not lower the count: drift is law steps the prompt lacks
    assert prompt_drift(PROMPT_TICK102) == prompt_drift(PROMPT_TICK80);
}

test a_prompt_naming_every_step_and_publish_txt_may_launch {
    const STEP_COUNT : u32 = 9;
    assert prompt_drift("BOARD-GUARD-STEP AUDIT-STEP PR-GATE-STEP UI-HEALTH-STEP (read publish.txt first) SYNC-STEP SWEEP-STEP TASK-PICK-STEP RECEIPT-COMMENT-STEP RETROSPECTIVE") == 0;
    assert first_missing_step("BOARD-GUARD-STEP AUDIT-STEP PR-GATE-STEP UI-HEALTH-STEP SYNC-STEP SWEEP-STEP TASK-PICK-STEP RECEIPT-COMMENT-STEP RETROSPECTIVE") == STEP_COUNT;
    assert prompt_may_launch("RETROSPECTIVE RECEIPT-COMMENT-STEP TASK-PICK-STEP SWEEP-STEP SYNC-STEP publish.txt UI-HEALTH-STEP PR-GATE-STEP AUDIT-STEP BOARD-GUARD-STEP");
}

test negative_control_one_dropped_step_or_an_empty_prompt_is_drift {
    const STEP_COUNT : u32 = 9;
    assert prompt_drift("BOARD-GUARD-STEP AUDIT-STEP PR-GATE-STEP UI-HEALTH-STEP publish.txt SWEEP-STEP TASK-PICK-STEP RECEIPT-COMMENT-STEP RETROSPECTIVE") == 1;
    assert first_missing_step("BOARD-GUARD-STEP AUDIT-STEP PR-GATE-STEP UI-HEALTH-STEP publish.txt SWEEP-STEP TASK-PICK-STEP RECEIPT-COMMENT-STEP RETROSPECTIVE") == 4;
    // dropping only the new first step is drift too
    assert first_missing_step("AUDIT-STEP PR-GATE-STEP UI-HEALTH-STEP publish.txt SYNC-STEP SWEEP-STEP TASK-PICK-STEP RECEIPT-COMMENT-STEP RETROSPECTIVE") == 0;
    assert prompt_drift("") == STEP_COUNT + 1;
    assert first_missing_step("") == 0;
    // a heading that only shares a prefix is not the step: RECEIPTS is not RECEIPT-COMMENT-STEP
    assert prompt_drift("RECEIPTS SWEEP TASK-PICK") == STEP_COUNT + 1;
    assert law_step(STEP_COUNT) == "";
}

// ---- BOARD-GUARD-STEP: the permanent board is never a closed issue (t27os#3) ----
// The board's own body orders it: "PERMANENT DASHBOARD -- NEVER CLOSE THIS ISSUE ... close tasks
// and PRs, not the epic". GitHub auto-close on a merge to the default branch parses the keyword
// only, so t27os#17's "Closes #3 partial" closed the board at 23:13:40Z on 2026-10-23 with tasks
// unchecked -- the word "partial" carries no weight, and no post-merge CI can tell an intended
// partial from a full close. The step runs first every tick: a closed board is a finding, the
// reopen happens before the claim, and the grade records whether unchecked tasks were left in it.

// BOARD-GUARD-STEP constants, test-local below: DASH_OK 0, DASH_CLOSED 1, DASH_CLOSED_UNDONE 2,
// MERGE_NOTE_LAW "close tasks and PRs, not the epic -- a note to t27os#3 says Updates, never
// Closes" (the badge law, as the gate string-scan reads it: any "Closes #3" against t27os#3 is
// refused), NOTE_OK 0, NOTE_REFUSES_CLOSE 1 (the pre-merge note-scan verdicts).

/// The verdict on the permanent board's state at tick start. closed: the issue state; unchecked:
/// how many of the board's own checkboxes are empty (0 does not mean complete, it means the
/// checkbox list is clean -- a closed board with a clean list is still a finding, never "done").
pub fn board_verdict(closed: bool, unchecked: u32) -> u32 {
    if (closed == false) { return 0; } // DASH_OK
    if (unchecked > 0) { return 2; } // DASH_CLOSED_UNDONE
    return 1; // DASH_CLOSED
}

/// Every closed-board verdict is visible; OK stays silent.
pub fn board_is_finding(verdict: u32) -> bool {
    return verdict != 0; // DASH_OK
}

/// A finding reopens the board before any other step runs (the claim never proceeds on a closed board).
pub fn board_reopens(verdict: u32) -> bool {
    return board_is_finding(verdict);
}

/// The pre-merge refusal of a note that would auto-close the board by keyword.
pub fn merge_note_verdict(closes_board: bool) -> u32 {
    if (closes_board) { return 1; } // NOTE_REFUSES_CLOSE
    return 0; // NOTE_OK
}

test a_closed_board_is_a_finding_even_with_a_clean_checklist {
    const DASH_CLOSED : u32 = 1;
    assert board_verdict(true, 0) == DASH_CLOSED;
    assert board_is_finding(DASH_CLOSED);
}

test closed_with_unchecked_tasks_is_the_worse_grade {
    const DASH_CLOSED_UNDONE : u32 = 2;
    assert board_verdict(true, 4) == DASH_CLOSED_UNDONE;
    assert board_is_finding(DASH_CLOSED_UNDONE);
    assert board_reopens(DASH_CLOSED_UNDONE);
}

test an_open_board_is_silent_and_never_reopens {
    const DASH_OK : u32 = 0;
    assert board_verdict(false, 3) == DASH_OK;
    assert board_is_finding(DASH_OK) == false;
    assert board_reopens(DASH_OK) == false;
}

test every_closed_board_verdict_reopens_before_any_claim {
    const DASH_CLOSED : u32 = 1;
    const DASH_CLOSED_UNDONE : u32 = 2;
    assert board_reopens(DASH_CLOSED);
    assert board_reopens(DASH_CLOSED_UNDONE);
}

test a_note_that_closes_the_board_is_refused_whatever_else_it_says {
    const NOTE_REFUSES_CLOSE : u32 = 1;
    const NOTE_OK : u32 = 0;
    assert merge_note_verdict(true) == NOTE_REFUSES_CLOSE;
    assert merge_note_verdict(false) == NOTE_OK;
}

test the_board_law_names_the_keyword_incident {
    const MERGE_NOTE_LAW : str = "close tasks and PRs, not the epic -- a note to t27os#3 says Updates, never Closes";
    assert MERGE_NOTE_LAW == "close tasks and PRs, not the epic -- a note to t27os#3 says Updates, never Closes";
}

// ---- SYNC-STEP: the copy verdict is t27os sync_gate.t27 verdict_of (t27#11980) ----
// Every tick greps the t27os tree for the t27-owned names (t27os#6): a hit that is not a pointer to
// the owner spec is a copied invariant, a defect. Which line is a copy is decided in ONE home,
// Trinity-S-AI-DNA/t27os specs/os/sync_gate.t27 verdict_of; this card does NOT restate the owned
// names or the comment/string rules. It says one thing the gate cannot say about itself: the gate's
// own spec holds every owned name as data (OWNED_NAMES) and in its test lines, so the step skips
// that one file. Measured tick 67, 2026-10-24T08:20Z, t27os master: every hit of the step's grep
// was in specs/os/sync_gate.t27, 0 elsewhere -- read literally, the step filed the gate every tick.
// The step's constants are test-local below: L1_SYNC 11980,
// SYNC_LAW "Trinity-S-AI-DNA/t27os:specs/os/sync_gate.t27 verdict_of"; the gate file the step
// skips is specs/os/sync_gate.t27 (SYNC_GATE_SELF in the tests).

/// Does SYNC-STEP judge the hits in this file? Every spec but the gate's own, by exact
/// repo-relative path (the grep prints paths from the tree root).
pub fn sync_scans(path: str) -> bool {
    return str_differs(path, "specs/os/sync_gate.t27"); // SYNC_GATE_SELF
}

test the_sync_step_skips_only_the_gates_own_spec {
    assert sync_scans("specs/os/sync_gate.t27") == false;
    assert sync_scans("specs/os/home.t27");
    assert sync_scans("specs/os/cards.t27");
}

test negative_control_a_same_named_file_elsewhere_is_still_scanned {
    assert sync_scans("specs/cards/sync_gate.t27");
    assert sync_scans("specs/os/sync_gate.t27.bak");
    assert sync_scans("");
}

test the_sync_step_points_at_the_gate_law {
    const L1_SYNC : u32 = 11980;
    const SYNC_LAW : str = "Trinity-S-AI-DNA/t27os:specs/os/sync_gate.t27 verdict_of";
    assert SYNC_LAW == "Trinity-S-AI-DNA/t27os:specs/os/sync_gate.t27 verdict_of";
    assert L1_SYNC == 11980;
}

// ---- SELF-CRITICAL-STEP: a close records where content lives (2026-10-26) ----
// Closing an own night PR whose diff is already on master leaves a comment
// naming the branch and every delta file that is NOT on master ('-' when
// there are none) -- measured from the tree diff, never guessed. A close
// never orphans content silently: the 2026-10-26 morning closed rel-face-ledger
// as empty-diff while its fpga leftovers lived only on the branch, unread.

pub fn close_note_orphans(orphan_files: []const u8) -> u8 {
    if (orphan_files.len == 0) { return 0; }
    return 1;
}

test close_note_flags_only_real_orphans {
    const CLOSE_CLEAN : u8 = 0;
    const CLOSE_ORPHANS : u8 = 1;
    assert close_note_orphans("") == CLOSE_CLEAN;
    assert close_note_orphans("fpga/tools/load_sram.sh") == CLOSE_ORPHANS;
}
