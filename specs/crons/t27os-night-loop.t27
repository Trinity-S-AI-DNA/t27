// specs/crons/t27os-night-loop.t27 -- the T27 OS improvement loop (t27os#3): every 5 minutes on the
// owner's Mac, one bounded tick -- take the top open task of the t27os board by Pareto, claim it in the
// swarm refs, do one unit, land or hand off, write the beat to the hive feed, never break a past merge.
// The tick engine lives on the Mac outside any repository (REPO mac): a claude -p run with the tick
// prompt and a state file at ~/.t27os/loop/state.json (lane discipline: done is never retaken,
// inprogress carries a two-hour lease, blocked needs a new angle). Owner, 2026-10-23, before sleeping:
// "create the cron, work autonomously without stopping, do not break past work, self-critical,
// auto-fix and merge when green, write .t27, verify the T27 OS UI works".
// ON_FAILURE issue: the tick posts its own failure to Trinity-S-AI-DNA/t27os#3 as a comment.
// The steps the tick executes, as law: AUDIT-STEP (the wasm32 mine grep -> gHashTag/t27#11840),
// PR-GATE-STEP (dispatch the T27 OS lab per open PR specs/t27os head, one run in flight, the rest
// queued; read receipts back from runs/), UI-HEALTH-STEP (the app process alive and the hive feed
// fresh, else rebuild and relaunch; the verdict is ui_health below), SWEEP-STEP (every 6th tick, own merged lanes only, t27os#8),
// RETROSPECTIVE (every 4th tick, one proposal to change this card).
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/t27os-night-loop";
pub const NAME : str = "T27 OS night loop";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.t27os-night-loop";
pub const SUMMARY_EN : str = "One bounded improvement tick of T27 OS every 5 minutes: Pareto-pick from the t27os board, claim, implement in .t27, verify both compilers, land green or hand off, beat the hive feed, check the UI health.";
pub const INTERVAL_MS : u32 = 300000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [1]str = ["t27os-night-loop"];
pub const RUNS_NOTE : str = "the loop is its own skill: the tick prompt is the law the card launches, and the take rule is specs/t27os/night_take.t27";
pub const ENABLED : bool = true;
pub const NOTE : str = "spec-only by construction (launchd is not scanned); first tick 2026-10-23 night; the tick prompt forbids force-push, --no-verify and history rewrites, requires a swarm claim before any code, and carries the lab law: verification dispatches the T27 OS lab (Trinity-S-AI-DNA/t27os lab.yml), never an external service";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "code-only";

// ---- UI-HEALTH-STEP: one verdict per tick (t27#11887) ----
// The hive feed job (S/Z rows) runs only while the HIVE page is open: glass_window.t27 hive_tick
// asks agent_parts.t27 page_feed_due, which is false for a closed page. The always-on heartbeat
// is the publish job; its result is ~/.t27os/hive/publish.txt as "<epoch> <exit>", every
// DV_PUBLISH_S = 300 s (devices.t27). So publish.txt is read first, and a stale Z is a finding
// only while the HIVE page is open. Measured 2026-10-23: Z frozen at 15:45Z for 3 h with the
// page closed while publish.txt said 18:51Z exit 0 -- eight ticks posted a false finding.

pub const UI_OK : u32 = 0;
pub const UI_DOWN : u32 = 1;
pub const UI_PUBLISH_FAIL : u32 = 2;
pub const UI_PUBLISH_STALE : u32 = 3;
pub const UI_FEED_STALE : u32 = 4;
/// devices.t27: a heartbeat older than 30 minutes means OFFLINE.
pub const UI_PUBLISH_MAX_S : u64 = 1800;
/// The tick law: a Z row older than one hour, with the HIVE page open, is a finding.
pub const UI_FEED_MAX_S : u64 = 3600;

/// Age of a stamp; a clock that went back (stamp in the future) reads as fresh, a missing stamp (0) as infinitely old.
pub fn ui_age(now: u64, at: u64) -> u64 {
    if (at == 0) { return 0xFFFFFFFFFFFFFFFF; }
    if (now < at) { return 0; }
    return now - at;
}

/// The verdict of UI-HEALTH-STEP. alive: the T27OS process exists. pub_at, pub_exit: publish.txt.
/// hive_open: the HIVE page is the open page. z_at: the epoch of the feed's Z row (0 if none).
pub fn ui_health(alive: bool, now: u64, pub_at: u64, pub_exit: u32, hive_open: bool, z_at: u64) -> u32 {
    if (alive == false) { return UI_DOWN; }
    if (ui_age(now, pub_at) > UI_PUBLISH_MAX_S) { return UI_PUBLISH_STALE; }
    if (pub_exit != 0) { return UI_PUBLISH_FAIL; }
    if (hive_open and ui_age(now, z_at) > UI_FEED_MAX_S) { return UI_FEED_STALE; }
    return UI_OK;
}

/// Only these verdicts are posted on t27os#3; OK is a silent pass and DOWN is repaired (rebuild, relaunch) first.
pub fn ui_is_finding(verdict: u32) -> bool {
    return verdict == UI_PUBLISH_FAIL or verdict == UI_PUBLISH_STALE or verdict == UI_FEED_STALE;
}

test a_closed_hive_page_with_an_old_z_row_is_healthy {
    // the 2026-10-23 night: Z 1792770319 (15:45Z), publish 1792781485 exit 0, now 1792782518
    assert ui_health(true, 1792782518, 1792781485, 0, false, 1792770319) == UI_OK;
    assert ui_is_finding(UI_OK) == false;
}

test the_same_old_z_row_with_the_page_open_is_a_finding {
    assert ui_health(true, 1792782518, 1792781485, 0, true, 1792770319) == UI_FEED_STALE;
    assert ui_health(true, 1792782518, 1792781485, 0, true, 1792782000) == UI_OK;
    assert ui_is_finding(UI_FEED_STALE);
}

test a_dead_app_wins_over_every_other_signal {
    assert ui_health(false, 1792782518, 1792781485, 0, false, 1792782000) == UI_DOWN;
    assert ui_health(false, 1792782518, 0, 1, true, 0) == UI_DOWN;
    assert ui_is_finding(UI_DOWN) == false;
}

test the_publish_heartbeat_is_judged_first {
    assert ui_health(true, 10000, 10000 - 1801, 0, false, 0) == UI_PUBLISH_STALE;
    assert ui_health(true, 10000, 10000 - 1800, 0, false, 0) == UI_OK;
    assert ui_health(true, 10000, 0, 0, false, 9999) == UI_PUBLISH_STALE;
    assert ui_health(true, 10000, 9900, 128, false, 9999) == UI_PUBLISH_FAIL;
    assert ui_is_finding(UI_PUBLISH_FAIL) and ui_is_finding(UI_PUBLISH_STALE);
}

test a_clock_that_went_back_reads_fresh {
    assert ui_age(100, 200) == 0;
    assert ui_age(200, 100) == 100;
    assert ui_health(true, 100, 200, 0, true, 300) == UI_OK;
}

test the_card_names_the_engine_and_the_cadence {
    assert ID == "launchd/mac/t27os-night-loop";
    assert INTERVAL_MS == 300000 and TZ == "Asia/Bangkok";
    assert HOST == "launchd" and CONTROL == "code-only";
    assert KIND == "cron" and ENABLED;
}

test the_required_schema_fields_are_the_generators {
    // the trinity generator's CRON_REQUIRED: KIND, RUNS, RUNS_NOTE -- the fields
    // whose absence fails the site build (measured: the untyped pre-fix card
    // broke t27b itself at StmtAssign at top level)
    assert KIND.len > 0 and RUNS.len == 1 and RUNS_NOTE.len > 0;
    assert RUNS[0] == "t27os-night-loop";
}

// ---- SWEEP-STEP: lane hygiene as a tick step (Trinity-S-AI-DNA/t27os#8) ----
// The verdict per worktree is NOT restated here: it is worktree_keep.t27 lane_sweep_verdict
// (merged into origin/master AND clean AND no live refs/swarm/claims/<N> -> release; unknown
// keeps). This card says only when the step runs, which trees it may touch, and how much per
// tick. Owner law (CLAUDE.md, forbidden list): no permanent deletion of anything that is not
// your own merged lane tree -- so a dead lane of another actor is counted in the beat, never removed.
// Measured 2026-10-23: 206 worktrees, 3 dead, 27 dirty (kept), the rest clean-but-unmerged (kept).

/// Every 6th tick (30 min at INTERVAL_MS): a sweep reads ~200 worktrees, too slow for every tick.
pub const SWEEP_EVERY : u64 = 6;
/// At most this many removals per tick, so the step stays inside the 25-minute tick budget.
pub const SWEEP_MAX_REMOVE : u32 = 8;
/// The night loop's own lanes live under ~/t27-lanes/ with this prefix; nothing else is its own.
pub const SWEEP_OWN_PREFIX : str = "night-";
/// The beat written to ~/.t27os/hive/feed.txt after a sweep: G|hygiene|<removed>.
pub const SWEEP_BEAT : str = "G|hygiene|";
pub const SWEEP_LAW : str = "specs/queen/worktree_keep.t27 lane_sweep_verdict";

pub fn sweep_due(tick_n: u64) -> bool {
    return tick_n > 0 and tick_n % SWEEP_EVERY == 0;
}

/// own_lane: the worktree is one of this loop's lanes. release: lane_sweep_verdict said release.
/// removed: removals already done this tick.
pub fn sweep_remove(own_lane: bool, release: bool, removed: u32) -> bool {
    if (own_lane == false) { return false; }
    if (removed >= SWEEP_MAX_REMOVE) { return false; }
    return release;
}

test the_sweep_runs_every_sixth_tick_and_never_on_tick_zero {
    assert sweep_due(0) == false;
    assert sweep_due(6) and sweep_due(24);
    assert sweep_due(22) == false and sweep_due(23) == false;
}

test only_an_own_released_lane_is_removed_and_at_most_eight_per_tick {
    assert sweep_remove(true, true, 0);
    assert sweep_remove(true, true, 7);
    assert sweep_remove(true, true, 8) == false;
    assert sweep_remove(true, false, 0) == false;
    // another actor's dead lane: counted, never removed
    assert sweep_remove(false, true, 0) == false;
}

test the_sweep_names_its_law_and_its_beat {
    assert SWEEP_OWN_PREFIX == "night-" and SWEEP_BEAT == "G|hygiene|";
    assert SWEEP_LAW.len > 0 and SWEEP_MAX_REMOVE == 8;
}
