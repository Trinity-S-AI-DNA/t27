// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-dsh-head-election.t27 -- cron launchd/mac/dsh-head-election
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/mac/dsh-head-election).
; The dsh head election tick (specs/t27os/dsh_head_election.t27): every 15
; minutes probes both rungs turn-sized (100 tokens), feeds the streaks to the
; election law, and flips the dsh default head only after FLIP_STREAK wins of
; the challenger over a dead incumbent. Hysteresis: no flapping.
; ENABLED is FALSE on purpose: the card precedes the glue. The election glue
// (the gen-c binary of dsh_head_election.t27 plus the probe/state wrapper on
; the Mac node) has not landed yet; flip ENABLED the day it does.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_dsh_head_election;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/dsh-head-election";
pub const NAME : str = "dsh head election";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.dsh-head-election";
pub const SUMMARY_EN : str = "Every fifteen minutes probes both dsh rungs turn-sized and elects the default head by the hysteresis law (flip only after 3 consecutive challenger wins over a dead incumbent).";
pub const INTERVAL_MS : u32 = 900000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = false;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";
pub const NOTE : str = "Glue pending on purpose (card-first): the election binary lowers from specs/t27os/dsh_head_election.t27; the node wrapper and the state file land with it. Until then the dsh head is set manually (currently ollama/gemma4:31b-cloud since 2026-10-27).";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == false;
  assert INTERVAL_MS >= 60000;
  assert HOST == "launchd";
}
