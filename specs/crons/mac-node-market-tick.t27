// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-node-market-tick.t27 -- cron launchd/mac/node-market-tick
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/mac/node-market-tick).
; The node market's runner tick on the owner's Mac (specs/t27os/node_runner.t27 is
; the tick law, specs/t27os/node_pilot.t27 the enrolled fleet, specs/t27os/node_market.t27
; the consent laws). One tick claims at most one job: a 32-hex challenge plus at
; least one spec, a contributed key under its daily cap, and a receipt-verified
; settle that pays 0 mTRI without verification.
; ENABLED is TRUE: the glue landed 2026-10-27 -- node_runner_tick_argv.t27
; lowers to gen/c/t27os/node_runner_tick_argv.c, the ai.t27.node-market-tick
; launchd job runs the 900 s tick, evidence lands under
; ~/.t27os/node-market/jobs/<challenge>/. Payout still reads 0 mTRI by law
; until a signed receipt, two independent verifications, and the owner's node
; registration (settle_bridge.t27 step 0) exist -- that is the design, not a gap.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_node_market_tick;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/node-market-tick";
pub const NAME : str = "node market runner tick";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.node-market-tick";
pub const SUMMARY_EN : str = "Every fifteen minutes the consenting node market's runner tick claims at most one job (32-hex challenge, at least one spec, contributed keys under their daily caps) and settles only against verified receipts.";
pub const INTERVAL_MS : u32 = 900000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";
pub const NOTE : str = "Glue landed 2026-10-27: ai.t27.node-market-tick runs the 900 s tick, the tick words lower from node_runner_tick_argv.t27 (gen/c/t27os/node_runner_tick_argv.c), evidence under ~/.t27os/node-market/jobs/. Payout reads 0 mTRI by law until a signed receipt, two independent verifications, and the owner's node registration (settle_bridge.t27 step 0).";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == true;
  assert INTERVAL_MS >= 60000;
  assert HOST == "launchd";
}
