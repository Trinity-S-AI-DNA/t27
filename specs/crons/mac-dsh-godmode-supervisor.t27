// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-dsh-godmode-supervisor.t27 -- cron launchd/mac/dsh-godmode-supervisor
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/mac/dsh-godmode-supervisor).
; --
; THE RULE (owner, 2026-10-31): DSH orchestrates subagents; each subagent gets a small context; the
; results return to DSH, which logs what worked and improves its own templates; Claude Code decides
; and reviews, never executes. The ladder to GODMODE has four phases: the base visual (window +
; recorded log + tap ring + petals), this supervisor, the migration of the adopted dsh practices into
; .t27, and GODMODE itself (Claude Code = review only; DSH, its subagents and the cron = execution;
; T27 OS = the native environment).
; --
; THE TICK. Every INTERVAL_MS the supervisor reads the go file, the phase ladder and the lane
; register, then does at most one thing: dispatches one item to DSH as a headless run with at most
; GM_MAX_SUBAGENTS subagents, each briefed with at most GM_MAX_CONTEXT_LINES lines, bounded by
; GM_TICK_MAX_SECONDS and GM_TICK_MAX_TOKENS; or holds, when the phase's file has another writer; or
; reports, when DSH is not alive (it never restarts the live server). A subagent silent for
; GM_STALL_SECONDS is F12 (the stall measured under t27#12948): stopped and logged, never retried in
; a loop. Every tick appends one row to GM_TICK_LOG.
; --
; THE STOP-COCK. The go file is the owner's switch: absent means no tick, and removing it is the
; whole rollback, because a tick never merges and never writes to master: every change it produces
; is a draft PR. The owner gave the go on 2026-10-31 with a 30-minute cadence (GM_OWNER_GO), and the
; go file exists on the Mac. ENABLED stays FALSE until the tick program exists and the launchd job is
; loaded: a Mac builds nothing, so the gen-c binary of this spec and its host driver (one headless
; dsh run) come from a T27 OS pane or CI, and a job pointing at a missing program would log a
; failure every tick. The PR that loads the job flips ENABLED.
; --
; Purity: every function is a pure function of its arguments; no clock, no network.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_dsh_godmode_supervisor;

// ---- the card ----

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/dsh-godmode-supervisor";
pub const NAME : str = "dsh GODMODE supervisor";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.dsh-godmode-supervisor";
pub const SUMMARY_EN : str = "Every thirty minutes reads the go file and the phase ladder, then dispatches at most one bounded item to DSH as a headless run of small-context subagents, logs the tick, and holds or reports instead of touching a file another lane writes or restarting the live DSH server.";
pub const INTERVAL_MS : u32 = 1800000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation: the tick is the gen-c binary of this spec driving one headless dsh run; not built yet, so no job is loaded";
pub const ENABLED : bool = false;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";
pub const NOTE : str = "Owner go 2026-10-31, cadence 30 min (INTERVAL_MS), default caps accepted; the go file exists on the Mac. ENABLED flips in the PR that loads the launchd job, which waits for the tick program: the gen-c of this spec and its host driver are built in a T27 OS pane or CI, never on the Mac. Until then no tick fires.";

// ---- the ladder ----

pub const GM_PHASES : u32 = 4;
/// The next phase when every phase is done: the tick reports and stops.
pub const GM_ALL_DONE : u32 = 255;
pub const GM_P_BASE : u32 = 0;
pub const GM_P_SUPERVISOR : u32 = 1;
pub const GM_P_MIGRATE : u32 = 2;
pub const GM_P_GODMODE : u32 = 3;

pub const GM_PHASE_NAMES : [4]str = [
    "base visual: window + recorded log + tap ring + 2-3 petals, labeled recorded, not live",
    "supervisor: this card, its gen-c tick and the launchd job, started on the owner's go",
    "migration: every adopted dsh practice becomes a .t27 template, routing rule or lesson",
    "GODMODE: Claude Code reviews only; DSH, its subagents and the cron execute; T27 OS hosts",
];

/// Who holds each phase today. The base is in the lane queen-band-lane (another writer of
/// specs/t27os/glass_window.t27), so a tick holds on it; the rest are unowned until a tick takes them.
pub const GM_PHASE_OWNERS : [4]str = [
    "lane queen-band-lane on claude/queen-band-graph-2-972650 (another writer)",
    "unowned",
    "unowned",
    "unowned",
];

/// Which phases are done: none at the card's birth; each phase's landing PR flips its own flag.
pub const GM_PHASE_DONE : [4]u8 = [0, 0, 0, 0];

// ---- the caps (proposed defaults; the owner may lower any of them) ----

pub const GM_TICK_MAX_SECONDS : u32 = 600;
pub const GM_TICK_MAX_TOKENS : u32 = 40000;
pub const GM_MAX_SUBAGENTS : u32 = 3;
pub const GM_MAX_CONTEXT_LINES : u32 = 200;
pub const GM_ITEMS_PER_TICK : u32 = 1;
/// A subagent silent this long is F12: stop it and log, do not retry.
pub const GM_STALL_SECONDS : u32 = 200;
/// Free disk below this many GiB means no tick (the Mac rule of 2026-10-25).
pub const GM_MIN_FREE_GB : u32 = 6;
/// A one-minute load average at or above this means no tick.
pub const GM_MAX_LOAD : u32 = 40;

// ---- the switches ----

/// The owner's switch, relative to the home directory: present means go, absent means no tick.
pub const GM_GO_FILE : str = ".dsh/godmode.go";
/// Where every tick appends one row: tick, phase, action, model, tool calls, tokens, seconds, outcome.
pub const GM_TICK_LOG : str = ".dsh/godmode/ticks.jsonl";
/// A tick never merges: merges stay by hand, on the owner's word, for the PR's own session.
pub const GM_MAY_MERGE : bool = false;
/// The owner's go, recorded the day it came; the cadence it picked is INTERVAL_MS.
pub const GM_OWNER_GO : str = "2026-10-31: go, cadence 30 min, default caps";

// ---- the migration source ----

/// Where the migration backlog lives: the adoption plan is the one home of the practice count and of
/// each practice's status. The glue reads count_status(S_ADOPTED) and PRACTICES from that spec's own
/// generated code and hands the two numbers to gm_migrate_items; this card copies neither number.
pub const GM_MIGRATE_SOURCE : str = "specs/tri/dsh_practice_adoption_plan.t27";
/// The status a practice must hold to be a migration item.
pub const GM_MIGRATE_STATUS : str = "S_ADOPTED";

// ---- actions ----

pub const GM_A_HOLD : u32 = 0;
pub const GM_A_RUN : u32 = 1;
pub const GM_A_REPORT : u32 = 2;

// ---- readers ----

/// The first phase not done. The ladder is strict: a later phase never starts before an earlier one.
pub fn gm_next_phase(done : []const u8) -> u32 {
    var i : u32 = 0;
    while (i < GM_PHASES) {
        if (done[i as usize] == 0) { return i; }
        i = i + 1;
    }
    return GM_ALL_DONE;
}

/// Whether a tick may run at all: the go file is present, the card is enabled, DSH answers, and the
/// disk and the load are inside the Mac rule.
pub fn gm_tick_may_run(go : bool, enabled : bool, dsh_alive : bool, free_gb : u32, load : u32) -> bool {
    return go and enabled and dsh_alive and free_gb >= GM_MIN_FREE_GB and load < GM_MAX_LOAD;
}

/// What the tick does for the phase: reports when the ladder is done or DSH is not alive (it never
/// restarts the server), holds when another writer owns the phase, runs otherwise.
pub fn gm_action(phase : u32, other_writer : bool, dsh_alive : bool) -> u32 {
    if (phase == GM_ALL_DONE) { return GM_A_REPORT; }
    if (dsh_alive == false) { return GM_A_REPORT; }
    if (other_writer) { return GM_A_HOLD; }
    return GM_A_RUN;
}

/// Whether a run stayed inside every cap.
pub fn gm_within_budget(seconds : u32, tokens : u32, subagents : u32, items : u32) -> bool {
    return seconds <= GM_TICK_MAX_SECONDS and tokens <= GM_TICK_MAX_TOKENS
        and subagents <= GM_MAX_SUBAGENTS and items <= GM_ITEMS_PER_TICK;
}

/// Whether a subagent brief is small enough to hand out.
pub fn gm_context_ok(lines : u32) -> bool { return lines >= 1 and lines <= GM_MAX_CONTEXT_LINES; }

/// Whether a silent subagent is F12: stop and log, never retry.
pub fn gm_stalled(silent_seconds : u32) -> bool { return silent_seconds >= GM_STALL_SECONDS; }

/// The migration backlog: the adopted practices the glue read from GM_MIGRATE_SOURCE, bounded by the
/// practice count read from the same place (a count above the total is a misread, clamped).
pub fn gm_migrate_items(adopted : u32, practices : u32) -> u32 {
    if (adopted > practices) { return practices; }
    return adopted;
}

/// Whether GODMODE is reached: the three earlier phases are done and, over the last window of ticks,
/// Claude Code executed nothing (it only reviewed).
pub fn gm_godmode_reached(done : []const u8, claude_exec_ticks : u32) -> bool {
    return done[0] == 1 and done[1] == 1 and done[2] == 1 and claude_exec_ticks == 0;
}

// ---- tests ----

test the_card_records_the_owners_go_and_stays_off_until_the_job_is_loaded {
    assert(KIND == "cron");
    assert(HOST == "launchd");
    // the go of 2026-10-31 picked 30 minutes; ENABLED flips only in the PR that loads the launchd job
    assert(GM_OWNER_GO.len > 10);
    assert(INTERVAL_MS == 1800000);
    assert(ENABLED == false);
    assert(CONTROL == "code-only");
    assert(GM_MAY_MERGE == false);
}

test no_go_file_means_no_tick_whatever_else_is_true {
    assert(gm_tick_may_run(false, true, true, 100, 1) == false);
    assert(gm_tick_may_run(true, false, true, 100, 1) == false);
    assert(gm_tick_may_run(true, true, false, 100, 1) == false);
    assert(gm_tick_may_run(true, true, true, GM_MIN_FREE_GB - 1, 1) == false);
    assert(gm_tick_may_run(true, true, true, 100, GM_MAX_LOAD) == false);
    assert(gm_tick_may_run(true, true, true, GM_MIN_FREE_GB, GM_MAX_LOAD - 1));
}

test the_ladder_is_strict_and_the_base_is_first {
    var done : [4]u8 = [0, 0, 0, 0];
    assert(gm_next_phase(done[0..4]) == GM_P_BASE);
    done[1] = 1;
    // a later phase done out of order does not move the ladder past the undone base
    assert(gm_next_phase(done[0..4]) == GM_P_BASE);
    done[0] = 1;
    assert(gm_next_phase(done[0..4]) == GM_P_MIGRATE);
    done[2] = 1;
    assert(gm_next_phase(done[0..4]) == GM_P_GODMODE);
    done[3] = 1;
    assert(gm_next_phase(done[0..4]) == GM_ALL_DONE);
}

test the_card_at_rest_holds_on_the_base_because_a_lane_writes_it {
    assert(gm_next_phase(GM_PHASE_DONE[0..4]) == GM_P_BASE);
    // the label "unowned" is the only 7-byte owner label, so a longer one names a writer
    assert(GM_PHASE_OWNERS[GM_P_BASE as usize].len > 7);
    assert(gm_action(GM_P_BASE, true, true) == GM_A_HOLD);
}

test a_dead_dsh_is_reported_never_restarted_and_a_free_phase_runs {
    assert(gm_action(GM_P_SUPERVISOR, false, false) == GM_A_REPORT);
    assert(gm_action(GM_P_SUPERVISOR, true, false) == GM_A_REPORT);
    assert(gm_action(GM_P_SUPERVISOR, false, true) == GM_A_RUN);
    assert(gm_action(GM_ALL_DONE, false, true) == GM_A_REPORT);
}

test every_cap_binds_and_one_item_per_tick {
    assert(gm_within_budget(GM_TICK_MAX_SECONDS, GM_TICK_MAX_TOKENS, GM_MAX_SUBAGENTS, 1));
    assert(gm_within_budget(GM_TICK_MAX_SECONDS + 1, 1, 1, 1) == false);
    assert(gm_within_budget(1, GM_TICK_MAX_TOKENS + 1, 1, 1) == false);
    assert(gm_within_budget(1, 1, GM_MAX_SUBAGENTS + 1, 1) == false);
    assert(gm_within_budget(1, 1, 1, 2) == false);
}

test a_subagent_brief_is_small_and_a_silent_one_is_f12 {
    assert(gm_context_ok(GM_MAX_CONTEXT_LINES));
    assert(gm_context_ok(GM_MAX_CONTEXT_LINES + 1) == false);
    assert(gm_context_ok(0) == false);
    assert(gm_stalled(GM_STALL_SECONDS));
    assert(gm_stalled(GM_STALL_SECONDS - 1) == false);
}

test the_migration_backlog_is_read_from_the_adoption_plan_and_bounded_by_it {
    // the numbers below are shapes, not the plan's counts: those live only in GM_MIGRATE_SOURCE
    assert(gm_migrate_items(3, 5) == 3);
    assert(gm_migrate_items(7, 5) == 5);
    assert(gm_migrate_items(0, 5) == 0);
    assert(gm_migrate_items(5, 5) == 5);
    assert(GM_MIGRATE_SOURCE.len > 10);
    assert(GM_MIGRATE_STATUS.len > 0);
}

test godmode_needs_the_three_phases_and_zero_claude_execution {
    var done : [4]u8 = [1, 1, 1, 0];
    assert(gm_godmode_reached(done[0..4], 0));
    assert(gm_godmode_reached(done[0..4], 1) == false);
    done[2] = 0;
    assert(gm_godmode_reached(done[0..4], 0) == false);
}

test every_phase_is_named_and_owned {
    var i : u32 = 0;
    while (i < GM_PHASES) {
        assert(GM_PHASE_NAMES[i as usize].len >= 20);
        assert(GM_PHASE_OWNERS[i as usize].len >= 7);
        i = i + 1;
    }
}
