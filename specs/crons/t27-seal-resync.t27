; specs/crons/t27-seal-resync.t27 -- the seal resync executor as law.
; The seal-coverage gate prescribes one repair for gen-drift: re-seal the specs it
; names with the CURRENT compiler. Only CI builds that compiler (the heavy build is
; forbidden on the owner's Mac), so the executor is a dispatch-only job of the same
# workflow (.github/workflows/seal-coverage.yml, job `resync`), filed as #12733.

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/seal-resync";
pub const NAME : str = "seal resync on dispatch";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/seal-coverage.yml";
pub const SUMMARY_EN : str = "On dispatch: run the seal-coverage check, re-seal exactly the specs it names with CI's compiler, run tri seals sync-twins, and open one PR carrying only the refreshed seals. The baseline is never touched.";
pub const SCHEDULE : str = "";
pub const ENABLED : bool = true;
pub const NOTE : str = "Measured 2026-10-27: master's coverage red is gen-drift -- 64 specs on CI, and a stale local compiler flags 237 verilog hashes CI does not, so the Mac must not write these seals. The resync job opens the batch PR; merging it turns the gate green for master and for every PR waiting on it.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

; --- The repair rule --------------------------------------------------------------------------

/// What the gate's verdict allows. R_BASELINE is refused outright: gen-drift is repaired by
/// resealing, never by recording the drift as accepted debt.
pub const R_NONE : u8 = 0;
pub const R_RESEAL : u8 = 1;
pub const R_BASELINE : u8 = 2;

/// A named verdict repairs by resealing when it is plain staleness (the spec changed after
/// sealing) or gen-drift (the spec hashes the same but a gen hash moved). Everything else --
/// dangling, phantom, no spec_path -- keeps its own repair and is not a resync item.
pub fn repair(verdict : u8) -> u8 {
    if (verdict == R_RESEAL) { return R_RESEAL; }
    return R_NONE;
}

test the_repair_reseals_only_resync_items {
    assert repair(R_RESEAL) == R_RESEAL;
    assert repair(R_NONE) == R_NONE;
    assert repair(R_BASELINE) == R_NONE;
}

test the_batch_changes_nothing_but_seals {
    const ONLY_SEALS : u8 = 1;
    const ALSO_CODE : u8 = 2;
    let batch : u8 = ONLY_SEALS;
    assert batch == ONLY_SEALS;
    assert batch != ALSO_CODE;
}
