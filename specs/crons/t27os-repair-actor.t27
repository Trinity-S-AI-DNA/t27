// SPDX-License-Identifier: Apache-2.0
// specs/crons/t27os-repair-actor.t27 -- the T27 OS master repair actor: every 30 minutes on
// the owner's Mac (launchd ai.t27.repair-actor, StartInterval 1800 s, script
// /Users/playra/t27os-lab/repair_actor.py outside any repository, REPO mac), one bounded
// pass: fetch master, run the local gates, and on any red, the guard first, then repair,
// PR and squash-merge, so the port-train wave cannot leave master red between human waves.
// THE LAW this actor executes is NOT restated here: the gate list, the trigger rule and the
// gate commands live in specs/t27os/labs.t27 (GATE_WIDTHS..GATE_EMIT_BITEXACT with
// GATE_COUNT = 9, repair_needed, gates_green, GATE_COMMANDS, gate_command) -- the card names
// them and adds exactly one decision of its own, the active-lane guard below. The actor runs
// those nine plus one more local gate (tools/check_specs_generate.py) that labs.t27 does not
// count; the nine are the law, the tenth is the actor's own addition, said here so the card
// never overstates the law it serves.
// THE ACTIVE-LANE GUARD (the card's one new decision, 2026-10-24): a master red may already
// belong to a live lane (a lane/* branch committing on the same files, or an open PR fixing
// it) -- repairing then would double-work that lane and race it. So BEFORE any repair the
// actor asks lane_active_on_region, the named predicate below (implemented verbatim in
// repair_actor.py): a lane/* branch with a commit inside the 2 h window whose files touch the
// failing region, or an open lane PR whose files fix it, or an unparseable failing region
// while any lane signal is live (an unknown region reads as occupied -- the conservative
// side of the guard is SKIP, never repair). When the guard fires, the actor repairs nothing
// and writes the skip to the hive feed instead; the guard runs before repair_may_run says
// yes, never after.
// FEED: one line per run, "G|tick|repair-actor|<RFC3339 UTC>|<one-line result>" appended to
// /Users/playra/.t27os/hive/feed.txt (feed grammar specs/t27os/devices.t27): a green pass, a
// guard skip and a repair all land as a line, so T27 OS can see the actor tick.
// HOST launchd per the specs/crons/README.md launchd section (StartInterval N -> INTERVAL_MS
// N*1000, no SCHEDULE, CONTROL code-only, ID launchd/<repo>/<label without ai.t27.>), the
// shape of the t27os-night-loop card. The trinity generator knows the launchd host (HOSTS in
// apps/website/scripts/agents-from-specs.mjs, verified 2026-10-25); a launchd card is
// spec-only by construction and its "run now" is disabled there. Nothing outside the Mac can
// see the plist fire, so this card and the feed line it mandates are the only witnesses a
// remote reader has; "did it run" is answered by launchctl print
// gui/$(id -u)/ai.t27.repair-actor and the feed, never by the page.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27os_repair_actor;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/repair-actor";
pub const NAME : str = "T27 OS repair actor";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.repair-actor";
pub const SUMMARY_EN : str = "Runs the master repair cycle every 30 minutes: fetch, the nine local gates of specs/t27os/labs.t27, and on any red, the active-lane guard first, then repair, PR and squash-merge; every run writes one line to the hive feed.";
pub const INTERVAL_MS : u32 = 1800000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const NOTE : str = "the law is specs/t27os/labs.t27 (repair_needed, gates_green, gate_command); the guard lane_active_on_region runs before any repair; dry runs set REPAIR_ACTOR_DRYRUN=1 and repair nothing; spec-only by construction (launchd is not scanned by the code manifest); the actor also runs check_specs_generate.py as a tenth gate labs.t27 does not count";
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

// ---- the active-lane guard: never double-work a live lane ----------------

/// May the actor NOT repair? fresh_lane: a lane/* branch committed inside the window.
/// region_named: the red gate output named files at all. region_hit: those files intersect
/// the lane's fresh files. open_lane_pr: an open PR with a lane/* head exists. pr_hit: such
/// a PR's files intersect the region. When the region cannot be parsed, any live lane signal
/// reads as occupied; when the region is known, only a lane signal ON it blocks, so a stale
/// unrelated lane cannot freeze repairs forever. The window is 2 h (the measured lane
/// cadence; LANE_WINDOW_H = 2.0 in repair_actor.py).
pub fn lane_active_on_region(fresh_lane: bool, region_named: bool, region_hit: bool,
                             open_lane_pr: bool, pr_hit: bool) -> bool {
    if (region_named == false) {
        return fresh_lane or open_lane_pr;
    }
    return region_hit or pr_hit;
}

/// The whole repair decision, guard first: green means nothing to do, a fired guard means
/// skip with a feed note, and only reds plus a clear guard allow the repair cycle to run.
pub fn repair_may_run(reds: u32, lane_active: bool) -> bool {
    if (reds == 0) { return false; }
    return lane_active == false;
}

test the_guard_skips_a_fresh_lane_on_the_failing_region {
    // lane committed in the window and its files intersect the red output
    assert lane_active_on_region(true, true, true, false, false);
    // an open lane PR whose files fix the region blocks without any fresh lane
    assert lane_active_on_region(false, true, false, true, true);
}

test negative_control_a_fresh_lane_off_the_region_does_not_block {
    // the guard is a region guard, not "any lane anywhere freezes repairs":
    // a named region, a fresh lane that never touched it, and lane PRs whose
    // files do not fix it -- the repair may run
    assert lane_active_on_region(true, true, false, true, false) == false;
    // no lane signal at all
    assert lane_active_on_region(false, true, false, false, false) == false;
}

test an_unreadable_region_reads_as_occupied_on_any_lane_signal {
    assert lane_active_on_region(true, false, false, false, false);
    assert lane_active_on_region(false, false, false, true, false);
    assert lane_active_on_region(false, false, false, false, false) == false;
}

test the_guard_runs_before_any_repair {
    // greens: nothing to do whatever the guard says
    assert repair_may_run(0, false) == false;
    assert repair_may_run(0, true) == false;
    // reds plus a fired guard: skip
    assert repair_may_run(2, true) == false;
    // reds plus a clear guard: the repair cycle runs
    assert repair_may_run(2, false);
    assert repair_may_run(9, false);
}

test the_card_names_the_law_the_guard_and_the_cadence {
    const LAW : str = "specs/t27os/labs.t27 gate_command";
    const TRIGGER : str = "specs/t27os/labs.t27 repair_needed";
    const GUARD : str = "lane_active_on_region";
    const GUARD_WINDOW_S : u64 = 7200;
    const TRACKING : u32 = 11797;
    assert LAW == "specs/t27os/labs.t27 gate_command";
    assert TRIGGER == "specs/t27os/labs.t27 repair_needed";
    assert GUARD == "lane_active_on_region";
    assert GUARD_WINDOW_S == 7200;
    assert TRACKING == 11797;
    // 30 minutes as 30 * 60 * 1000, and no interval under one minute makes sense here
    assert INTERVAL_MS == 1800000 and INTERVAL_MS / 60000 == 30;
    assert HOST == "launchd" and CONTROL == "code-only" and ENABLED;
}

test the_feed_beat_matches_the_hive_line_shape {
    // the row the actor appends per run; the grammar is specs/t27os/devices.t27
    const BEAT : str = "G|tick|repair-actor|";
    assert BEAT == "G|tick|repair-actor|";
}

test the_required_schema_fields_are_the_generators {
    // the trinity generator's CRON_REQUIRED plus the launchd rule: exactly one of
    // SCHEDULE and INTERVAL_MS -- this card carries INTERVAL_MS and no SCHEDULE
    assert KIND == "cron" and ENABLED;
    assert RUNS.len == 0 and RUNS_NOTE.len > 0;
    assert ON_FAILURE == "issue" or ON_FAILURE == "log" or ON_FAILURE == "unknown";
    assert ID == "launchd/mac/repair-actor";
    assert SERVICE == "ai.t27.repair-actor";
    assert REPO == "mac";
}
