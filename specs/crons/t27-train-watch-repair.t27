; specs/crons/t27-train-watch-repair.t27 -- the executor of the stale-armed
; repair law (specs/crons/t27-train-watch.t27, stale_arm_repair): on schedule,
; every armed PR that went stale ONCE gets its branch updated from master and
; its checks rerun, still armed; a PR stale TWICE is left to its author with
; the how-to (specs/blog/EPIC_ENTRY_HOWTO.md carries the same discipline).
; The first execution needs the owner-approved-foreign label for its workflow
; file (#12167 is the precedent); until then this card is the law and the
; one-command manual:
;   gh pr update-branch N && gh pr merge N --squash --auto

module cron_t27_train_watch_repair;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/train-watch-repair";
pub const NAME : str = "stale-armed repair";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/stale-arm-repair.yml";
pub const SUMMARY_EN : str = "Every hour: armed PRs gone stale once get their branch updated from master and their checks rerun, still armed; twice-stale goes to the author. Executes the stale_arm_repair law.";
pub const SCHEDULE : str = "0 * * * *";
pub const TZ : str = "UTC";
pub const ENABLED : bool = false;
pub const NOTE : str = "ENABLED=false: the executor workflow needs the owner-approved-foreign label (#12167 is the precedent). Until then the one-command manual above IS the execution; the law it executes is stale_arm_repair in specs/crons/t27-train-watch.t27.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

test the_card_executes_the_law {
    assert HOST == "github-actions";
    assert ID == "github-actions/t27/train-watch-repair";
    assert ENABLED == false;
}
