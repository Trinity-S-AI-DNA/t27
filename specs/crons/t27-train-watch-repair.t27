; specs/crons/t27-train-watch-repair.t27 -- the executor of the stale-armed
; repair law (specs/crons/t27-train-watch.t27, stale_arm_repair): on schedule,
; every armed PR that went stale ONCE gets its branch updated from master and
; its checks rerun, still armed; a PR stale TWICE is left to its author with
; the how-to (specs/blog/EPIC_ENTRY_HOWTO.md carries the same discipline).
; The first execution needs the owner-approved-foreign label for its workflow
; file (#12167 is the precedent); until then this card is the law and the
; one-command manual:
;   gh pr update-branch N && gh pr merge N --squash --auto

module cron_t27_train_watch_repair;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/train-watch-repair";
pub const NAME : str = "stale-armed repair";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/stale-arm-repair.yml";
pub const SUMMARY_EN : str = "Every hour: armed PRs gone stale once get their branch updated from master and their checks rerun, still armed; twice-stale goes to the author. Executes the stale_arm_repair law.";
pub const SCHEDULE : str = "0 * * * *";
pub const TZ : str = "UTC";
pub const ENABLED : bool = true;
pub const NOTE : str = "ENABLED=true since 2026-10-27: the executor workflow landed paid by the superseded scripts/check-conflicts.sh deletion (the #12713 payment pattern); the stale_arm_repair law it runs is specs/crons/t27-train-watch.t27.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

test the_card_executes_the_law {
    assert HOST == "github-actions";
    assert ID == "github-actions/t27/train-watch-repair";
    assert ENABLED == true;
}

; HOW A WORKFLOW FILE LANDS (the #12713 pattern, proven twice on 2026-10-27):
; a new hand-written .yml is pure addition, and no entry or label lifts the
; foreign-line budget -- so the addition is PAID: port a superseded foreign
; script to .t27 and DELETE it, or delete dead foreign worth at least the
; addition, in the SAME pull request (net <= 0). The exceptions entry goes in
; FIRST (its own PR, the owner's approval quoted), because the CI gate reads
; the base's copy and a branch cannot list itself. Paid: #12713 (queue health
; report paid by the compare_gamma_candidates port), #12846 (this executor
; paid by the check-conflicts.sh deletion).
; THE DIRTY BRANCH (2026-10-27, proven live on #12814 and #12791): a DIRTY PR
; whose conflict is MECHANICAL gets the rebase repair, never a local merge.
; A merge commit built on a branch makes the pre-commit gate read the WHOLE
; incoming master diff as added foreign lines, which can never pass ("no
; exception and no label lifts this limit"); a rebase replays one commit at
; a time and each replayed diff is the branch's own lines. The push is
; --force-with-lease (a refusal is the guard working), then re-arm.
; Ownership line: owner-authored branches repair automatically under the
; standing MERGE_ALL delegation; other authors' branches get the recipe in a
; PR comment -- no force-push to someone else's branch without a mandate.

pub const DIRTY_OWNER_AUTO : u8 = 0;
pub const DIRTY_RECIPE_TO_AUTHOR : u8 = 1;

pub fn dirty_repair(author_is_owner: bool, mechanical: bool) -> u8 {
    if (!mechanical) { return DIRTY_RECIPE_TO_AUTHOR; }
    if (author_is_owner) { return DIRTY_OWNER_AUTO; }
    return DIRTY_RECIPE_TO_AUTHOR;
}

; Conflict classes and their resolutions, as paid for today:
; - SEAL: .trinity/seals/*.json -- both sides sealing the SAME spec_hash
;   describe identical content; the newer sealed_at wins, which is master's
;   side (--ours during a rebase). Divergent spec_hash is real content.
; - HASH_FILE: bootstrap/stage0/FROZEN_HASH -- recompute from the merged
;   source, never pick a side.
; - LOG: append-only shared logs (.trinity/experience.md,
;   specs/blog/epic_progress.t27) -- union toward master's newer entries;
;   the rebased branch keeps its own unique entries elsewhere.
; - CONTENT: a real divergence -- author's hands, never auto.

pub const CONFLICT_SEAL : u8 = 0;
pub const CONFLICT_HASH_FILE : u8 = 1;
pub const CONFLICT_LOG : u8 = 2;
pub const CONFLICT_CONTENT : u8 = 3;

pub const RESOLVE_TAKE_MASTER : u8 = 0;
pub const RESOLVE_RECOMPUTE : u8 = 1;
pub const RESOLVE_UNION : u8 = 2;
pub const RESOLVE_AUTHOR : u8 = 3;

pub fn conflict_resolution(kind: u8, same_content: bool) -> u8 {
    if (kind == CONFLICT_CONTENT) { return RESOLVE_AUTHOR; }
    if (kind == CONFLICT_SEAL) {
        if (same_content) { return RESOLVE_TAKE_MASTER; }
        return RESOLVE_AUTHOR;
    }
    if (kind == CONFLICT_HASH_FILE) { return RESOLVE_RECOMPUTE; }
    if (kind == CONFLICT_LOG) { return RESOLVE_UNION; }
    return RESOLVE_AUTHOR;
}

test owner_repairs_mechanical_dirt_others_get_the_recipe {
    const AUTO : u8 = 0;
    const RECIPE : u8 = 1;
    assert dirty_repair(true, true) == AUTO;
    assert dirty_repair(false, true) == RECIPE;
    assert dirty_repair(true, false) == RECIPE;
    assert dirty_repair(false, false) == RECIPE;
}

test conflict_resolutions_match_the_live_run {
    const MASTER : u8 = 0;
    const RECOMPUTE : u8 = 1;
    const UNION : u8 = 2;
    const AUTHOR : u8 = 3;
    const SEAL : u8 = 0;
    const HASH : u8 = 1;
    const LOG : u8 = 2;
    const CONTENT : u8 = 3;
    assert conflict_resolution(SEAL, true) == MASTER;
    assert conflict_resolution(SEAL, false) == AUTHOR;
    assert conflict_resolution(HASH, true) == RECOMPUTE;
    assert conflict_resolution(LOG, true) == UNION;
    assert conflict_resolution(CONTENT, true) == AUTHOR;
}
