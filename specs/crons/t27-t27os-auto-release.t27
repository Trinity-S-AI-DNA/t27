; specs/crons/t27-t27os-auto-release.t27 -- the release-on-merge card as law.
; Owner request 2026-10-26 (Pareto variant 1 on #12479): a merge that touched specs/t27os/
; should ship itself -- today the scanner and the dispatcher sit on master 29 commits past the
; published build. The card decides WHEN a release is due and WHAT may publish; the heavy build
; and the workflow wiring land as an owner-approved-foreign follow-up (the same wall as #11894),
; so ENABLED=false until then. The publish gate below composes the post-publish verify law:
; nothing uploads unless the verify answered ok.
 
; The design of the job (dispatch-only, no wall-clock schedule): after each merge that touched
; specs/t27os/, the runner checks the release due-rule, runs `tri t27os release --plan`, builds,
; verifies, and publishes -- in that order, stopping at the first gate.

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/t27os-auto-release";
pub const NAME : str = "t27os release on merge";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/t27os-release.yml";
pub const SUMMARY_EN : str = "After each merge that touched specs/t27os/: run the release plan, build the app and the toolchain from one commit, run the post-publish verify, then publish and point t27os-latest at the new manifest. Dispatch-only; no wall-clock schedule.";
pub const SCHEDULE : str = "";
pub const ENABLED : bool = false;
pub const NOTE : str = "ENABLED=false: the card is the law; the host workflow file (t27os-release.yml, also carried by PR #11894) needs the own-language decision first. When it lands: b7554+ carries the access scanner (#12663) and the dispatcher (#12662), already 29 commits past the published 0.2.0-b7553.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";


; --- The due-rule -------------------------------------------------------------------------------

; The ok verdict of the post-publish verify law: specs/t27os/release_verify.t27 V_OK. The card
; stays self-contained (the site's vendored wasm typechecks it without cross-spec uses).
pub const VERIFY_OK : u8 = 0;

; The verdict of the due-rule:

; The verdict of the due-rule:
pub const R_IDLE : u8 = 0;
pub const R_RELEASE_DUE : u8 = 1;
pub const R_BUSY : u8 = 2;

/// A release is due when OS specs moved past the published build and the tree is quiet. A busy
; pane server or a dirty tree postpones it (R_BUSY): the swap rule of release.t27 refuses to
; cut over under load, and a release built from a dirty tree is not the commit it claims.
pub fn release_due(specs_moved: bool, panes_busy: bool, tree_dirty: bool) -> u8 {
    if (panes_busy or tree_dirty) { return R_BUSY; }
    if (specs_moved) { return R_RELEASE_DUE; }
    return R_IDLE;
}

; --- The publish gate ---------------------------------------------------------------------------

/// Nothing uploads unless the post-publish verify answered ok (specs/t27os/release_verify.t27).
; The verify composes manifest_check, the all-row sums agreement and the six-asset set.
pub fn publish_allowed(verify_verdict: u8) -> bool {
    return verify_verdict == VERIFY_OK;
}

test the_due_rule_releases_only_when_quiet_and_moved {
    const IDLE : u8 = 0;
    const DUE : u8 = 1;
    const BUSY : u8 = 2;
    assert release_due(true, false, false) == DUE;
    assert release_due(false, false, false) == IDLE;
    assert release_due(true, true, false) == BUSY;
    assert release_due(true, false, true) == BUSY;
}

test publish_needs_the_verify_ok {
    assert publish_allowed(0);
    assert publish_allowed(1) == false;
    assert publish_allowed(2) == false;
    assert publish_allowed(3) == false;
}
