// specs/crons/t27os-lab-loop.t27 -- the T27 OS lab loop: every 15 minutes the executor
// in Trinity-S-AI-DNA/t27os (.github/workflows/lab.yml) checks out t27 master, builds t27c,
// runs the core spec set's test-reports, renders the 900-frame export schedule through
// frame_render + ffmpeg, and publishes a challenge-bound receipt plus queen-live.mp4 into
// t27os runs/. The contract is t27os specs/os/lab.t27 (surface) and t27 specs/t27os/labs.t27
// (the lab actor law); the migration from Railway is t27#11781; the settle bridge that turns
// verified receipts into mTRI is t27#11789.
// Self-critical state, 2026-10-23: five challenge-verified receipts; the first receipt
// reproduced by the requester (the two-verification bar of a useful run); ffmpeg 6.1.1 on the
// runner; the mp4 proof in run 39970371982's log (sha256 2a00668d..., 328428 bytes).

module cron_t27os_lab_loop;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27os/lab";
pub const NAME : str = "T27 OS lab loop";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27os";
pub const SERVICE : str = ".github/workflows/lab.yml";
pub const SUMMARY_EN : str = "Every 15 minutes: build t27c from master, test-report the core spec set, render the 900-frame export schedule, encode queen-live.mp4, publish the challenge-bound receipt into t27os runs/.";
pub const SCHEDULE : str = "*/15 * * * *";
pub const TZ : str = "UTC";
pub const RUNS : [1]str = ["t27os-lab-loop"];
pub const RUNS_NOTE : str = "the loop is its own skill: the lab contract is t27os specs/os/lab.t27, the actor law is t27 specs/t27os/labs.t27";
pub const ENABLED : bool = true;
pub const NOTE : str = "replaced the Railway lab drive-in (t27#11781); receipts are challenge-bound; the settle bridge to mTRI is t27#11789";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

// the cadence the owner set: a full pass every quarter hour, day and night
pub const SCHEDULE_MINUTES : u32 = 15;

test the_loop_runs_every_quarter_hour_and_is_enabled {
    assert SCHEDULE_MINUTES == 15;
    assert ENABLED;
    assert HOST == "github-actions";
}
