// specs/crons/t27-t27f-closure-lab.t27 -- the T27F live-closure lab watch: every
// hour, dispatch the T27 OS lab (Trinity-S-AI-DNA/t27os, .github/workflows/lab.yml,
// workflow_dispatch) with the full seven-spec closure of the /t27f/live/ page and
// read the challenge-verified receipt back from t27os runs/. The lab's own 15-minute
// schedule covers three of the seven (work_graph, live_mode, hud are in its default
// set); this card adds the four it does not run (display_list, live_stream, scene,
// motion) so a closure drift is caught by the next tick, not by the next wave.
// First receipt of this shape: runs/63040712e.8b794369.json, 54/54 tests, 0 FAIL,
// 0 vacuous (2026-10-24T07:44:46Z). Failures name Trinity-S-AI-DNA/trinity#1717.
// The wasm the page waits for is t27#11840 M-B (parameter-carrying scalar exports);
// the requirements are posted on trinity#1717. ASCII only (L3).
// phi^2 + 1/phi^2 = 3 | TRINITY

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/t27f-closure-lab";
pub const NAME : str = "T27F closure lab watch";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27os";
pub const SERVICE : str = ".github/workflows/lab.yml";
pub const SUMMARY_EN : str = "Hourly dispatch of the T27 OS lab over the full seven-spec /t27f/live/ closure (work_graph, hud, live_mode, display_list, live_stream, scene, motion); the challenge-verified receipt lands in t27os runs/ and a FAIL names trinity#1717.";
pub const SCHEDULE : str = "23 * * * *";
pub const TZ : str = "UTC";
pub const RUNS : [1]str = ["t27os-lab"];
pub const RUNS_NOTE : str = "the dispatched lab.yml runs t27c test-report per named spec; no skill invocation beyond the lab itself";
pub const ENABLED : bool = true;
pub const NOTE : str = "dispatch: gh workflow run lab.yml --repo Trinity-S-AI-DNA/t27os -f sha=<t27 master> -f challenge=<hex> -f specs='specs/t27f/work_graph.t27 specs/t27f/hud.t27 specs/t27f/live_mode.t27 specs/t27f/display_list.t27 specs/t27f/live_stream.t27 specs/t27f/scene.t27 specs/t27f/motion.t27'; receipt: t27os runs/<sha>.<sha256(challenge)[:8]>.json -- keep the challenge until the receipt is read; m6=false wasm=false for the watch tick. The lab's own 15m schedule (HOST github-actions, this SERVICE) covers its default set; this card is the full-closure hourly. Whether the Queen holds this card's dispatch pin is answered by GET /queen/scheduler, never by this card.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";
