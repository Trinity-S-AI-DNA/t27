// SPDX-License-Identifier: Apache-2.0
; specs/crons/t27-sieve-gate.t27 -- cron github-actions/t27/sieve-gate
; Nightly gate for the compiler sieve: run the sieve's own tests and the reproducible-build
; tests, and fail the run if a FALSE cell reappears or a test goes vacuous. The sieve spec
; (specs/compiler/theory/sieve.t27) and reproducible.t27 are the source of truth; this card only
; schedules them. Part of epic #6488.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27_sieve_gate;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/sieve-gate";
pub const NAME : str = "Compiler sieve gate";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/sieve-gate.yml";
pub const SUMMARY_EN : str = "Runs the compiler sieve tests nightly and fails on any FALSE cell or vacuous pass, so epic #6488 cannot regress silently.";
pub const SCHEDULE : str = "0 2 * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == true;
  assert NAME == "Compiler sieve gate";
  assert HOST == "github-actions";
  assert ON_FAILURE == "issue";
}