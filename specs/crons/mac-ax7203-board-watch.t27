// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-ax7203-board-watch.t27 -- cron launchd/trinity-fpga/ax7203-board-watch
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/trinity-fpga/ax7203-board-watch).
; The schedule was read from ~/Library/LaunchAgents/ai.t27.ax7203-board-watch.plist on 2026-10-23.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; The tick is the AX7203 board loop's audit with --heal: it hunts key leaks, stale locks,
; uncommitted board records, unpushed commits, ledger stamp drift and spec drift, and
; self-heals a stale lock. Tooling recovered 2026-10-23 from the fire-31 keep blobs
; (trinity-fpga artifacts/model_inputs/blobs) after the /tmp snapshot died with a reboot;
; the tools now live durably in ~/t27os-lab/toolsrc (board.py 214191 B, tri 147143 B,
; fpga_bench.py 23667 B, SKILL.md 36188 B, LESSONS.md 48655 B -- sha256 verified
; against the stash MANIFEST.tsv). Exit 2 = anomalies found (the expected floor:
; uncommitted board logs and unpushed commits on the trinity-fpga checkout).
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_ax7203_board_watch;

pub const KIND : str = "cron";
pub const ID : str = "launchd/trinity-fpga/ax7203-board-watch";
pub const NAME : str = "AX7203 board watch";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.ax7203-board-watch";
pub const SUMMARY_EN : str = "Every 15 minutes audits the AX7203 board loop for anomalies (key leaks, stale locks, uncommitted board records, unpushed commits, ledger stamp drift, spec drift) and self-heals a stale lock.";
pub const INTERVAL_MS : u32 = 900000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source; the tick is board.py audit --heal itself";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

test mac_ax7203_board_watch_test {
    assert KIND == "cron";
    assert ENABLED == true;
    assert INTERVAL_MS == 900000;
    assert HOST == "launchd";
    assert ON_FAILURE == "log";
}
