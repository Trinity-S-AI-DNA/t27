// SPDX-License-Identifier: Apache-2.0
; specs/crons/general_conductor.t27 -- cron t27os/general-conductor
; Source of truth for the job card on t27.ai (#/crons?cron=t27os/general-conductor).
; --
; THE GENERAL CONDUCTOR (v2, issue #13021): A pure card-first cron that gives orders through DSH, repairs
; the Claude Code -> DSH -> T27OS chain when a rule is broken, finds models (NVIDIA keys and OpenCode), finds
; more work to keep agents from idle, and thinks about scale as proposals only. The card stays OFF until the
; owner's go (the go file is absent on 2026-11-01). DSH headless fails at boot (credentials file), NVIDIA
; through DSH is not wired; NVIDIA keys reach models only through OpenCode panes. The chain legs never
; say "healthy" unless measured. Work discovery returns "no feed" when the source is empty, never invented.
; The cron never codes directly, bypasses DSH, starts cron without owner go, or touches seal drift without
; owner go. All scaling is proposals; merging a PR stays on the owner's word. The matryoshka status shows
; today's facts: Claude Code decides and reviews; DSH headless fails, web profile works; T27OS pane leg
; works; NVIDIA through DSH not wired.
; --
; THE TICK. Every INTERVAL_MS the conductor: (1) reads the go file and decides to stay off if absent;
; (2) runs five duties in order, each with caps; (3) logs the tick report with chain status and requests
; out. Every action is bounded by per-tick caps, never exceeds GC_MAX_SECONDS per duty, and fails fast.
; The conductor never auto-merges or auto-starts cron; all scaling proposals ask the owner to decide.
; --
; THE GO FILE. The owner's switch: present means go, absent means no tick. Removing it stops everything.
; The go file path is relative to the home directory.ENABLED flips only in the PR that loads the cron job.
; --
; Purity: every function is a pure function of its arguments; no clock, no network. ASCII only (L3).
; phi^2 + 1/phi² = 3 | TRINITY

module cron_general_conductor;

// ---- the card ----

pub const KIND : str = "cron";
pub const ID : str = "t27os/general-conductor";
pub const NAME : str = "General conductor";
pub const HOST : str = "t27os";
pub const REPO : str = "t27os";
pub const SERVICE : str = "ai.t27.general-conductor";
pub const SUMMARY_EN : str = "Every 15 minutes orders through DSH, repairs the Claude Code -> DSH -> T27OS chain, finds models and work, thinks about scale as proposals only; stays OFF until owner go.";
pub const INTERVAL_MS : u32 = 900000;
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation: the tick is the gen-c binary of this spec driving one DSH headless run";
pub const ENABLED : bool = false;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";
pub const NOTE : str = "Owner go not yet given (2026-11-01); the go file is absent. ENABLED flips in the PR that loads the cron job, which waits for the tick program: the gen-c of this spec is built in a T27 OS pane or CI, never on the Mac. The conductor stays OFF until the owner creates the go file.";

// ---- the duties (u8 consts 1..5) ----

/// Duty 1: Check that the Claude Code -> DSH -> T27OS chain is intact
pub const GC_DUTY_CHECK_MATRYOSHKA_HEALTH : u8 = 1;
/// Duty 2: Dispatch tasks through DSH
pub const GC_DUTY_DISPATCH_TASKS : u8 = 2;
/// Duty 3: Discover models (NVIDIA keys and OpenCode)
pub const GC_DUTY_DISCOVER_MODELS : u8 = 3;
/// Duty 4: Find more work to keep agents from idle
pub const GC_DUTY_FIND_MORE_WORK : u8 = 4;
/// Duty 5: Think about scale as proposals only
pub const GC_DUTY_SCALE_THINKING : u8 = 5;

// ---- the forbidden actions (u8 consts 1..4) ----

/// Forbidden action 1: Direct coding (bypass DSH)
pub const GC_FORBIDDEN_DIRECT_CODING : u8 = 1;
/// Forbidden action 2: Bypassing DSH
pub const GC_FORBIDDEN_BYPASSING_DSH : u8 = 2;
/// Forbidden action 3: Starting cron without owner go
pub const GC_FORBIDDEN_START_CRON_WITHOUT_GO : u8 = 3;
/// Forbidden action 4: Touching seal drift without owner go
pub const GC_FORBIDDEN_TOUCH_SEAL_DRIFT_WITHOUT_GO : u8 = 4;

/// Returns false for any forbidden action or unknown value
pub fn action_allowed(kind: u8) -> bool {
    return kind != GC_FORBIDDEN_DIRECT_CODING
        && kind != GC_FORBIDDEN_BYPASSING_DSH
        && kind != GC_FORBIDDEN_START_CRON_WITHOUT_GO
        && kind != GC_FORBIDDEN_TOUCH_SEAL_DRIFT_WITHOUT_GO;
}

// ---- model registry template ----

/// Model registry status codes
pub const GC_STATUS_WIRED : u8 = 1;
pub const GC_STATUS_NOT_WIRED : u8 = 2;
pub const GC_STATUS_NOT_PROBED : u8 = 3;

/// Model registry field names
pub const GC_MODEL_NAME : str = "model_name";
pub const GC_MODEL_PROVIDER : str = "provider";
pub const GC_MODEL_ROUTE : str = "route";
pub const GC_MODEL_STATUS : str = "wired_status";
pub const GC_MODEL_PROBE : str = "probe_status";
pub const GC_MODEL_COST_TIER : str = "cost_tier";
pub const GC_MODEL_DATA_CLASS : str = "data_class";

/// Example registry rows: one NVIDIA-through-DSH (not wired), one NVIDIA-through-OpenCode, one free OpenCode (not probed)
pub const GC_EXAMPLE_NVIDIA_DSH : str = "model_name: nvidia-4090, provider: NVIDIA, route: DSH, wired_status: 2, probe_status: 1, cost_tier: paid, data_class: premium";
pub const GC_EXAMPLE_NVIDIA_OPENCODE : str = "model_name: nvidia-4090, provider: NVIDIA, route: OpenCode, wired_status: 1, probe_status: 1, cost_tier: paid, data_class: premium";
pub const GC_EXAMPLE_OPENCODE_FREE : str = "model_name: glm-4.5-flash, provider: OpenRouter, route: OpenCode, wired_status: 2, probe_status: 3, cost_tier: free, data_class: base";

/// Model switching is a proposal only
pub const GC_MAY_SWITCH_MODEL : bool = false;

// ---- work discovery template ----

/// Work discovery field names
pub const GC_WORK_ISSUE : str = "issue_number";
pub const GC_WORK_TITLE : str = "title";
pub const GC_WORK_SOURCE : str = "source";
pub const GC_WORK_BOUNDARY : str = "boundary_path";
pub const GC_WORK_IMPACT : str = "visual_core_impact";
pub const GC_WORK_PARALLEL : str = "parallel_safe_flag";

/// Work discovery with no source writes "no feed"
pub const GC_EXAMPLE_NO_FEED : str = "issue_number: 0, title: empty, source: no feed, boundary_path: none, impact: none, parallel: false";

// ---- chain legs (dated status consts) ----

pub const GC_LEG_CLAUDE_CODE : str = "Claude Code = decides and reviews (2026-11-01)";
pub const GC_LEG_DSH : str = "DSH = headless fails at boot, web profile works (2026-11-01)";
pub const GC_LEG_T27OS : str = "T27OS = pane leg works (2026-11-01)";
pub const GC_LEG_NVIDIA_DSH : str = "NVIDIA through DSH = not wired (2026-11-01)";

// ---- the switches ----

/// The owner's switch, relative to the home directory: present means go, absent means no tick
pub const GC_GO_FILE : str = ".dsh/general-conductor.go";
/// A tick never merges: merges stay by hand, on the owner's word, for the PR's own session
pub const GC_MAY_MERGE : bool = false;
/// The conductor never starts a cron without the owner's go
pub const GC_MAY_START_CRON : bool = false;
/// The conductor never codes directly
pub const GC_MAY_CODE : bool = false;

// ---- per-tick caps ----

pub const GC_MAX_TICKS_PER_HOUR : u32 = 4;
pub const GC_MAX_SECONDS_PER_DUTY : u32 = 300;
pub const GC_MAX_CONTEXT_LINES : u32 = 1000;

// ---- the tick report template ends with ----

/// Requests out: who, what, sent when, default, due
pub const GC_REQUESTS_OUT : str = "Requests out: (who, what, sent when, default, due)";

// ---- tests ----

test gc_enabled_false {
  assert ENABLED == false;
}

test gc_go_file {
  assert GC_GO_FILE == ".dsh/general-conductor.go";
}

test gc_duties {
  assert GC_DUTY_CHECK_MATRYOSHKA_HEALTH == 1;
  assert GC_DUTY_DISPATCH_TASKS == 2;
  assert GC_DUTY_DISCOVER_MODELS == 3;
  assert GC_DUTY_FIND_MORE_WORK == 4;
  assert GC_DUTY_SCALE_THINKING == 5;
}

test gc_forbidden_actions {
  assert action_allowed(GC_FORBIDDEN_DIRECT_CODING) == false;
  assert action_allowed(GC_FORBIDDEN_BYPASSING_DSH) == false;
  assert action_allowed(GC_FORBIDDEN_START_CRON_WITHOUT_GO) == false;
  assert action_allowed(GC_FORBIDDEN_TOUCH_SEAL_DRIFT_WITHOUT_GO) == false;
  assert action_allowed(99) == false; // unknown action
}

test gc_model_status {
  assert GC_STATUS_WIRED == 1;
  assert GC_STATUS_NOT_WIRED == 2;
  assert GC_STATUS_NOT_PROBED == 3;
}

test gc_registry_fields {
  assert GC_MODEL_NAME == "model_name";
  assert GC_MODEL_PROVIDER == "provider";
  assert GC_MODEL_ROUTE == "route";
  assert GC_MODEL_STATUS == "wired_status";
  assert GC_MODEL_PROBE == "probe_status";
  assert GC_MODEL_COST_TIER == "cost_tier";
  assert GC_MODEL_DATA_CLASS == "data_class";
}

test gc_work_fields {
  assert GC_WORK_ISSUE == "issue_number";
  assert GC_WORK_TITLE == "title";
  assert GC_WORK_SOURCE == "source";
  assert GC_WORK_BOUNDARY == "boundary_path";
  assert GC_WORK_IMPACT == "visual_core_impact";
  assert GC_WORK_PARALLEL == "parallel_safe_flag";
}

test gc_chain_legs {
  assert GC_LEG_CLAUDE_CODE == "Claude Code = decides and reviews (2026-11-01)";
  assert GC_LEG_DSH == "DSH = headless fails at boot, web profile works (2026-11-01)";
  assert GC_LEG_T27OS == "T27OS = pane leg works (2026-11-01)";
  assert GC_LEG_NVIDIA_DSH == "NVIDIA through DSH = not wired (2026-11-01)";
}

test gc_switches {
  assert GC_MAY_MERGE == false;
  assert GC_MAY_START_CRON == false;
  assert GC_MAY_CODE == false;
  assert GC_MAY_SWITCH_MODEL == false;
}

test gc_requests_out {
  assert GC_REQUESTS_OUT == "Requests out: (who, what, sent when, default, due)";
}

// ---- host-gap comment block ----
;
; Host-gap: What a real tick program still needs:
; - The actual go file check and absence fallback (keep ENABLED false until present)
; - Five bounded duty implementations with timeout per duty (never exceed GC_MAX_SECONDS_PER_DUTY)
; - DSH dispatch integration for task ordering
; - Model registry probe status tracking (keys.t27 and opencode_free.t27 are the sources)
; - Work discovery feed integration (return "no feed" when empty)
; - Chain leg measurement when new facts arrive
; - Tick report logging with timestamp and outcome
; - All scaling output as proposals only (no action without owner go)