module DiskGuard;
pub const DF_MIN_GIB : u64 = 5;
pub const SWAP_MAX_MB : u64 = 4096;
pub fn df_ok(free_gib_x10_1: u64, free_gib_x10_2: u64) -> bool {
    if (free_gib_x10_1 < 54) { return false; }
    if (free_gib_x10_2 < free_gib_x10_1) { return false; }
    return true;
}
pub fn swap_ok(swap_used_mb: u64) -> bool {
    return swap_used_mb < SWAP_MAX_MB;
}
pub fn guard_go(df1: u64, df2: u64, swap_mb: u64) -> bool {
    if (!df_ok(df1, df2)) { return false; }
    if (!swap_ok(swap_mb)) { return false; }
    return true;
}
test df_ok_passes_when_stable_and_above {
    assert df_ok(110, 110) == true;
    assert df_ok(110, 109) == false;
    assert df_ok(54, 54) == true;
    assert df_ok(53, 53) == false;
}
test swap_ok_passes_below_4096 {
    assert swap_ok(4001) == true;
    assert swap_ok(4095) == true;
    assert swap_ok(4096) == false;
    assert swap_ok(5000) == false;
}
test guard_go_requires_all {
    assert guard_go(110, 110, 4001) == true;
    assert guard_go(110, 109, 4001) == false;
    assert guard_go(110, 110, 4096) == false;
    assert guard_go(53, 54, 4001) == false;
}
endmodule
