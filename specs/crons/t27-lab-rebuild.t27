// SPDX-License-Identifier: Apache-2.0
; specs/crons/t27-lab-rebuild.t27 -- cron github-actions/t27/lab-rebuild
; Pareto variant 1 of epic #6488: after a push to master, rebuild t27c on both Railway labs and
; post the two sha256 values so a C9-class issue can close without manual SSH. The card is
; declared here; the SSH secret that actually drives the rebuild is owner-provided (request out).
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27_lab_rebuild;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/lab-rebuild";
pub const NAME : str = "Lab rebuild (t27c)";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/lab-rebuild.yml";
pub const SUMMARY_EN : str = "Rebuilds t27c on both Railway labs after a master push and records the sha256, closing C9-class issues without manual SSH.";
pub const SCHEDULE : str = "0 1 * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";
pub const NOTE : str = "Requires an owner-provided SSH secret; disabled in practice until that secret exists.";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == true;
  assert NAME == "Lab rebuild (t27c)";
  assert HOST == "github-actions";
  assert ON_FAILURE == "issue";
}