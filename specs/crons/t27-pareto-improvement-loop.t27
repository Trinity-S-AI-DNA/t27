// SPDX-License-Identifier: Apache-2.0
// specs/crons/t27-pareto-improvement-loop.t27 -- the 15-minute continuous improvement cycle.
// Every tick: audit the swarm state, find weak points by Pareto, fix the top one in .t27,
// verify locally with real receipts, land green through the merge train, write the beat to the hive,
// and never break a past merge. Self-healing: any tick that red-checks rolls back its own change
// before the next tick starts. All logic in .t27; no foreign edits.
// phi^2 + 1/phi^2 = 3 | TRINITY

module CronParetoImprovementLoop;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/t27-pareto-improvement-loop";
pub const NAME : str = "Pareto improvement loop";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.pareto-improvement-loop";
pub const SUMMARY_EN : str = "Fifteen-minute tick: audit swarm state, Pareto-rank weak points, fix the top one in .t27, verify with receipts, land green, beat the hive feed, never break past work.";
pub const INTERVAL_MS : u32 = 900000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [1]str = ["t27-pareto-improvement-loop"];
pub const RUNS_NOTE : str = "the tick prompt is the law; every step below is a .t27 spec with tests; auto-fix is on and merges only when green.";
pub const ENABLED : bool = true;
pub const NOTE : str = "spec-only (launchd not scanned); first tick after merge into master; foreign edits net-negative (<=40 lines/file, <=80/PR); no --no-verify / LEFTHOOK=0; L1 commit bodies carry Closes|Fixes|Resolves|Refs|Updates #N.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "code-only";

// ---- The seven steps of every tick, in order ----
// 1 AUDIT  -- read the swarm ledger, lanes, PRs, seals, receipts; list anomalies (refs below).
// 2 PARETO -- rank anomalies by impact x frequency; the top one is this tick's target.
// 3 FIX    -- write the fix as a .t27 spec (or extend an existing one), with test/invariant/bench.
// 4 VERIFY -- t27c test + seal on the branch; real corpus receipt compare vs master.
// 5 LAND   -- commit with L1 reference, push once per batch, open PR, merge when green.
// 6 BEAT   -- post the tick's verdict (pass/fail/cost/n/repro footer) to the hive feed.
// 7 SELF-HEAL-- if this tick's change red-checks anything, revert it before the next tick.

pub const STEP_AUDIT : u8 = 0;
pub const STEP_PARETO : u8 = 1;
pub const STEP_FIX : u8 = 2;
pub const STEP_VERIFY : u8 = 3;
pub const STEP_LAND : u8 = 4;
pub const STEP_BEAT : u8 = 5;
pub const STEP_SELF_HEAL : u8 = 6;
pub const STEPS : u8 = 7;

// ---- Pareto thresholds ----
// A weak point matters when impact >= 80% of the max impact seen, or frequency >= 2 per day.
pub const PARETO_IMPACT_FLOOR : u32 = 80;
pub const PARETO_FREQ_FLOOR : u32 = 2;

// ---- Self-healing: rollback window ----
// A tick's change must stay green for ROLLBACK_WINDOW ticks, else it is reverted.
pub const ROLLBACK_WINDOW : u64 = 3;

// ---- verdict codes ----
pub const V_PASS : u8 = 0;
pub const V_FAIL : u8 = 1;
pub const V_SKIP : u8 = 2;
pub const V_ROLLED_BACK : u8 = 3;

/// May this tick start a fix? Only when the PR gate ran and no own PR is red (night_take law).
pub fn fix_may_start(pr_gate_done: bool, own_red_prs: u32) -> bool {
    if (pr_gate_done == false) { return false; }
    return own_red_prs == 0;
}

test fix_start_waits_for_gate_and_repairs {
    assert fix_may_start(true, 0);
    assert fix_may_start(false, 0) == false;
    assert fix_may_start(true, 1) == false;
}

/// Is an anomaly Pareto-ranked: its impact is at least the floor, or its frequency meets the floor?
pub fn pareto_ranked(impact: u32, frequency: u32) -> bool {
    return impact >= PARETO_IMPACT_FLOOR or frequency >= PARETO_FREQ_FLOOR;
}

test pareto_ranking_uses_both_floors {
    assert pareto_ranked(80, 0);
    assert pareto_ranked(79, 2);
    assert pareto_ranked(50, 1) == false;
}

/// Does this tick's change break anything: any red check in the evidence?
pub fn broke_anything(red_checks: u32) -> bool {
    return red_checks > 0;
}

test rollback_when_any_check_red {
    assert broke_anything(0) == false;
    assert broke_anything(1);
    assert broke_anything(13);
}

/// Has a change stayed green long enough to keep (not roll back)?
pub fn keep_change(ticks_since: u64) -> bool {
    return ticks_since >= ROLLBACK_WINDOW;
}

test keep_change_after_window {
    assert keep_change(0) == false;
    assert keep_change(2) == false;
    assert keep_change(3);
}

/// The verdict name for reporting.
pub fn verdict_name(v: u8) -> string {
    if (v == V_PASS) { return "PASS"; }
    if (v == V_FAIL) { return "FAIL"; }
    if (v == V_SKIP) { return "SKIP"; }
    return "ROLLED_BACK";
}

test verdicts_have_names {
    assert verdict_name(V_PASS).len > 0;
    assert verdict_name(V_ROLLED_BACK).len > 0;
    assert verdict_name(99).len > 0;
}

invariant pareto_floors_are_sane {
    assert PARETO_IMPACT_FLOOR > 0 and PARETO_IMPACT_FLOOR <= 100;
    assert PARETO_FREQ_FLOOR > 0;
    assert ROLLBACK_WINDOW > 0;
    assert STEPS == 7;
}
