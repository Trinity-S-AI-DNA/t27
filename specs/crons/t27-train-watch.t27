; specs/crons/t27-train-watch.t27 -- the merge train's queue as a verdict.
; The night of 2026-10-26 held 502 queued Actions runs behind 16 in flight and
; nobody noticed until a session measured it by hand (issue #12606). This card
; makes the queue a per-tick verdict: WATCH at 100 queued, STORM at 300, with
; the armed-PR count as the demand side. Host wiring lands as an
; owner-approved-foreign follow-up; until then the card is the law and the
; thresholds are the ones measured that night.

module cron_t27_train_watch;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27/train-watch";
pub const NAME : str = "merge train queue watch";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27";
pub const SERVICE : str = ".github/workflows/train-watch.yml";
pub const SUMMARY_EN : str = "Every 30 minutes: read the Actions queue (queued and in-flight run counts) and the armed open-PR count; a queued count above 100 is a WATCH finding, above 300 is a STORM finding, posted to the train epic's Dashboard.";
pub const SCHEDULE : str = "*/30 * * * *";
pub const TZ : str = "UTC";
pub const ENABLED : bool = false;
pub const NOTE : str = "ENABLED=false: the host workflow wiring lands as an owner-approved-foreign follow-up. Thresholds measured 2026-10-26: 502 queued / 16 in flight during the merge-burst night (issue #12606); 22 queued by morning.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

pub fn queue_watch(queued: u32, in_flight: u32) -> u8 {
    if queued > 300 {
        return 2;
    }
    if queued > 100 {
        return 1;
    }
    if in_flight == 0 && queued > 0 {
        return 1;
    }
    return 0;
}

test the_night_storm_is_a_storm_finding {
    const OK : u8 = 0;
    const WATCH : u8 = 1;
    const STORM : u8 = 2;
    assert queue_watch(502, 16) == STORM;
    assert queue_watch(406, 16) == STORM;
    assert queue_watch(101, 16) == WATCH;
    assert queue_watch(22, 16) == OK;
    assert queue_watch(0, 0) == OK;
}

test a_stalled_queue_is_never_ok {
    const WATCH : u8 = 1;
    assert queue_watch(5, 0) == WATCH;
    assert queue_watch(1, 0) == WATCH;
}
