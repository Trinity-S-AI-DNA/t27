// SPDX-License-Identifier: Apache-2.0
; specs/crons/t27os-wave-loop-15m.t27 -- the continuous improvement wave loop (15 minutes).
; Every tick: investigate weak points, apply Pareto to fix the most important one, research
; competitors, write a decomposed plan, implement it all in .t27, write the closeout report,
; propose three cooperation variants for the next loop. Self-critical, anomaly search, self-healing;
; never breaks past work. Auto-fix and merge when green.
; Owner: "create the cron, work autonomously without stopping, do not break past work,
; self-critical, auto-fix and merge when green, write .t27, verify the T27 OS UI works".
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module CronT27osWaveLoop15m;

use t27os::disclosure::footer_verdict;
use t27os::disclosure::DISC_OK;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/t27os-wave-loop-15m";
pub const NAME : str = "T27 OS 15-minute wave loop";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.t27os-wave-loop-15m";
pub const SUMMARY_EN : str = "Every 15 minutes: investigate weak points, Pareto-fix the most important, research competitors, decompose a plan, implement all in .t27, closeout report, three cooperation variants for the next loop. Self-healing, never breaks past work, merges green.";
pub const INTERVAL_MS : u32 = 900000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [1]str = ["t27os-wave-loop-15m"];
pub const RUNS_NOTE : str = "the tick is the law of this card; each phase is a .t27 spec with its own tests; no foreign code in any phase.";
pub const ENABLED : bool = true;
pub const NOTE : str = "spec-only by construction (launchd is not scanned); the loop tracks its own tasks in GitHub issues, auto-fixes failures, and seals every .t27 it touches; the previous wave's artifacts are re-verified before each tick so nothing already merged is broken.";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "code-only";

// THE FIVE PHASES of one tick, in order. Each phase is a .t27 spec; a phase that refuses
// stops the tick and posts its refusal to the issue the tick tracks.
//
// PHASE 1 - investigate weak points: re-read the board, recent test baselines,
// and unlanded process-debt needles; rank candidates by user impact,
// reproducibility, isolation, and evidence achievable in this tick; pick ONE
; the smallest high-risk behavior.
//
// PHASE 2 - research competitors: 2-4 primary sources relevant to the chosen
; needle; evaluate threat level and Trinity's differentiation; record findings.
//
// PHASE 3 - decomposed plan: .claude/plans/wave-loop-{N}.md with three variants
; (A recommended, B implementation-heavy, C process/tooling).
//
// PHASE 4 - implement variant A: smallest reviewable .t27 diff, tests before
; code (strict TDD), run validation gates, seal each touched .t27.
//
// PHASE 5 - closeout report + cooperation variants: docs/reports/WAVE_LOOP_{N}_CLOSEOUT.md
; and docs/reports/FPGA_LOOP_COOPERATION_W{N+1}_YYYY-MM-DD.md; three variants for
; the next loop.

// Each phase's verdict is one of PASS / FAIL / REFUSED. A REFUSED phase stops the
// tick; a FAIL phase triggers auto-fix once (same phase, one bounded attempt), then
// hands off to the issue. A tick that lands green posts its receipt comment and beat
// to the hive feed, never force-pushes, never --no-verify, never rewrites history.

pub fn tick_verdict(phase_ok: bool) -> u8 {
    if (phase_ok) { return 0; }
    return 1;
}
