// SPDX-License-Identifier: Apache-2.0
; specs/crons/t27-own-model-board.t27 -- cron railway-cron/t27/own-model-board
; Source of truth for the job card on t27.ai (#/crons?cron=railway-cron/t27/own-model-board).
; The schedule lives on Railway service own-model-board in project igla-judge (the board's project,
; so the board's private port is reachable); the payload lives here, in gHashTag/t27 (#10321).
; What one fire does, in words: fetch master's gen/json/igla/own_model_board.json from
; raw.githubusercontent.com and POST it, unchanged, to http://board.railway.internal:8081/event.
; That file is `t27c gen-json specs/igla/own_model_board.t27`, held to its spec by spec-guards.yml
; (regenerate, then git diff --exit-code). So a spec change reaches the board at the next fire,
; and a board redeploy, which empties its live map, is repaired at the next fire too.
; The service is the public image curlimages/curl and holds no variable: the private port takes
; no token, and the public repository needs none.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_t27_own_model_board;

pub const KIND : str = "cron";
pub const ID : str = "railway-cron/t27/own-model-board";
pub const NAME : str = "own-model-board";
pub const HOST : str = "railway-cron";
pub const REPO : str = "t27";
pub const SERVICE : str = "own-model-board";
pub const SUMMARY_EN : str = "Reposts the own_model event (the 27-cell map of specs/igla/own_model.t27) to the IGLA board, from the JSON t27c generates on master.";
; Four fires a day: an event that has not changed only refreshes its receive time, and the
; board keeps the last 200 events, so a tighter period would crowd out every other job.
pub const SCHEDULE : str = "17 */6 * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "posts one board event; invokes no skill";
pub const ENABLED : bool = true;
pub const NOTE : str = "Railway project igla-judge, service own-model-board. The schedule is set on the service, not in a checkout; the payload is gen/json/igla/own_model_board.json on master.";
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "railway-dashboard";

; The card held to the schema of specs/crons/README.md: ID is <host>/<repo>/<slug>; HOST,
; ON_FAILURE and CONTROL come from fixed vocabularies; RUNS, the control link, is empty unless
; the source evidently invokes a skill, and RUNS_NOTE then says why.
test id_is_host_repo_and_slug {
    // HOST is one of the five hosts the README names.
    assert HOST == "github-actions" or HOST == "inngest" or HOST == "railway-cron" or HOST == "timer" or HOST == "launchd";
    // ID opens with HOST, a `/`, REPO and a `/`.
    var i : usize = 0;
    while (i < HOST.len) {
        assert ID[i] == HOST[i];
        i = i + 1;
    }
    assert ID[HOST.len] == '/';
    var r : usize = 0;
    while (r < REPO.len) {
        assert ID[HOST.len + 1 + r] == REPO[r];
        r = r + 1;
    }
    assert ID[HOST.len + 1 + REPO.len] == '/';
    // The slug after it is one path segment, not empty, and names the Railway service.
    assert ID.len == HOST.len + REPO.len + 2 + SERVICE.len;
    var s : usize = 0;
    while (s < SERVICE.len) {
        assert ID[HOST.len + REPO.len + 2 + s] == SERVICE[s];
        assert SERVICE[s] != '/' and SERVICE[s] != ' ';
        s = s + 1;
    }
}
test vocabularies_and_the_control_link {
    assert KIND == "cron";
    assert ON_FAILURE == "issue" or ON_FAILURE == "log" or ON_FAILURE == "unknown";
    assert CONTROL == "github-actions-dispatch" or CONTROL == "railway-dashboard" or CONTROL == "inngest-dashboard" or CONTROL == "code-only";
    // An empty RUNS carries its reason in RUNS_NOTE.
    assert RUNS.len > 0 or RUNS_NOTE.len > 0;
}
test the_schedule_is_four_fires_a_day {
    // Five fields separated by single spaces, no blank field.
    var spaces : usize = 0;
    var k : usize = 0;
    while (k < SCHEDULE.len) {
        if (SCHEDULE[k] == ' ') {
            spaces = spaces + 1;
            assert k > 0 and k + 1 < SCHEDULE.len and SCHEDULE[k + 1] != ' ';
        }
        k = k + 1;
    }
    assert spaces == 4;
    // A fixed minute, not `*`: one fire per matching hour. Hour field `*/6`: four a day.
    assert SCHEDULE[0] >= '0' and SCHEDULE[0] <= '9';
    assert SCHEDULE[3] == '*' and SCHEDULE[4] == '/' and SCHEDULE[5] == '6';
    assert TZ == "UTC";
    assert ENABLED;
}
