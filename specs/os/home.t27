// SPDX-License-Identifier: Apache-2.0
; T27 OS home -- what the operating surface is made of, and where each part is owned.
; The home screen is the T27F petal menu: gHashTag/t27 specs/t27f/petal_menu.t27 (module
; T27fPetalMenu), reached through frontend.t27 intent I_OS_HOME -> surface SF_PETAL_MENU. That spec
; owns the 27 quads, the realms, the fills, the fit, the hit test and the open/back state. This
; module does not copy any of them; it names the parts, the targets that run them, and the boot
; order, so a reader of this repository knows where to go. Epic: gHashTag/t27#10782.
; Targets: the trios macOS app (QueenUILib host, milestone M2) and the AX7203 FPGA board
; (milestones M4-M7). A target is "planned" until its milestone lands; nothing here claims more.

module T27osHome;

pub const HOME_SURFACE : str = "petal_menu";
pub const HOME_SPEC : str = "gHashTag/t27:specs/t27f/petal_menu.t27";
pub const HOME_INTENT : str = "I_OS_HOME";
pub const EPIC : str = "gHashTag/t27#10782";

pub const TARGET_TRIOS : u32 = 0;      // macOS, QueenUILib draws generated code from the spec
pub const TARGET_AX7203 : u32 = 1;     // FPGA, gen-verilog of hit test, fills and state
pub const TARGET_COUNT : u32 = 2;
pub const TARGET_NAMES : str = "trios,ax7203";

pub const TS_PLANNED : u8 = 0;
pub const TS_RUNS : u8 = 1;
pub const TARGET_STATUS : [2]u8 = [0, 0];

pub const BOOT_POWER : u32 = 0;        // board or app starts
pub const BOOT_HOME : u32 = 1;         // the 27-petal triangle, no petal open
pub const BOOT_MENU : u32 = 2;         // a petal's card menu is open
pub const BOOT_COUNT : u32 = 3;

pub fn target_ok(t: u32) -> bool {
    return t < TARGET_COUNT;
}

; --- the card grid (L7): one card spec per petal card, each pointing at its law home ---
; The grid lives here; the card specs live in specs/os/cards/ and name their widget's law home
; (repo + path) and its live URL. A card enters the grid only when its law home exists on the
; master sha the card pins (issue gHashTag/t27#11780).

pub const CARD_COUNT : u32 = 3;
; card 0: the T27F work-graph view, behind petal 12 (MATERIYA / MAP)
pub const CARD0_SPEC : str = "specs/os/cards/graph_card.t27";
pub const CARD0_PETAL : u32 = 12;
; card 1: the Queen's automation surface (crons), behind petal 7 (RAZUM / HIVE)
pub const CARD1_SPEC : str = "specs/os/cards/crons_card.t27";
pub const CARD1_PETAL : u32 = 7;
; card 2: the Queen live screen (DARK: the loader page has not shipped, M3 in flight), petal 7
pub const CARD2_SPEC : str = "specs/os/cards/live_card.t27";
pub const CARD2_PETAL : u32 = 7;

/// A target may be said to run T27 OS only when its milestone has landed.
pub fn runs(t: u32) -> bool {
    if (target_ok(t) == false) {
        return false;
    }
    return TARGET_STATUS[t] == TS_RUNS;
}

/// Boot order: power lands on home; a tap opens a menu; back returns home.
pub fn next(stage: u32, tapped: bool, back: bool) -> u32 {
    if (stage == BOOT_POWER) {
        return BOOT_HOME;
    }
    if (stage == BOOT_HOME and tapped) {
        return BOOT_MENU;
    }
    if (stage == BOOT_MENU and back) {
        return BOOT_HOME;
    }
    return stage;
}

test power_lands_on_home_and_a_tap_opens_a_menu {
    assert next(BOOT_POWER, false, false) == BOOT_HOME;
    assert next(BOOT_HOME, false, false) == BOOT_HOME;
    assert next(BOOT_HOME, true, false) == BOOT_MENU;
    assert next(BOOT_MENU, true, false) == BOOT_MENU;
    assert next(BOOT_MENU, false, true) == BOOT_HOME;
}

test no_target_is_claimed_to_run_before_its_milestone {
    var t : u32 = 0;
    while (t < TARGET_COUNT) {
        assert runs(t) == false;
        t = t + 1;
    }
    assert runs(TARGET_COUNT) == false;
}
