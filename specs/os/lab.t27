// specs/os/lab.t27 -- the lab SURFACE of T27 OS: the executor workflow, the receipt directory,
// and the legacy host state. The LAB'S OPERATING LAW lives in t27 (SSOT rule, 2026-10-23):
// specs/t27os/labs.t27 owns the run sequence (fetch -> build -> corpus -> ... -> publish) as an
// actor; t27c corpus-receipt owns receipt signing and the challenge discipline; the payout law
// owns the money. This file names the surface pieces that live HERE and points at every law;
// it states no rule of its own.
//
// SURFACE FACTS (measured 2026-10-23):
//   executor   .github/workflows/lab.yml in THIS repo -- workflow_dispatch(sha, challenge,
//              specs); checks out t27 at the sha, builds t27c, runs t27c test-report per spec,
//              writes one receipt per run. First receipt: runs/8f28c2d849.048f7f45.json
//              (2026-10-23T11:15:52Z, challenge-verified by the requester; work_graph 9/9,
//              actors 37/37, export_video 6/6; reproduced by the requester, so the
//              two-verification bar of a useful run is met).
//   publisher  runs/ in THIS repository, committed by the workflow itself.
//   legacy     the Railway lab serves reads only (t27b-lab-production.up.railway.app); its
//              write side died with the expired railway token, and labs.t27 keeps it as a
//              remote fallback per its own FR-005.
//
// NOT CLAIMED: no second NODE has reproduced a receipt yet (the requester's re-run is one of
// the two verifications); no $TRI has moved (the payout law sets amounts and schedules); the
// M3/M6 measurement runs have not been dispatched yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_lab_surface;

pub const ID : str = "t27os-lab-surface";
pub const VERSION : u8 = 3;

// the laws this surface calls; every rule lives at its pointer
pub const LAB_LAW : str = "t27:specs/t27os/labs.t27";
pub const RECEIPT_SIGNING : str = "t27c corpus-receipt";
pub const PAYOUT_LAW : str = "t27:specs/verified/payout.t27";
pub const WALLET_LAW : str = "t27:specs/automation/token-wallet.t27";
pub const PAYOUT_UNIT : str = "TRI";

// the surface pieces that live HERE
pub const WORKFLOW : str = ".github/workflows/lab.yml";
pub const RECEIPT_DIR : str = "runs";
pub const FIRST_RECEIPT : str = "runs/8f28c2d849.048f7f45.json";

// the legacy host, reads only
pub const LEGACY_HOST : str = "t27b-lab-production.up.railway.app";

// --- shape checks (t27os#13) ---
// The two invariants that stood here asserted a constant equals the literal it was defined
// with, which cannot fail. These check the SHAPE every law pointer and receipt name must have,
// each with negative controls, so a typo, a non-t27 law path or the empty-sha receipt name a
// scheduled run would write (t27os#11) is caught. What they cannot see: whether the file
// exists -- t27c tests have no file system; existence was checked by hand on 2026-10-23
// (all three law pointers resolve on t27 master; FIRST_RECEIPT is in runs/).

pub const LAW_PREFIX : str = "t27:specs/";
pub const LAW_SUFFIX : str = ".t27";
pub const RECEIPT_SUFFIX : str = ".json";
pub const SHA_MIN : u32 = 7;       // shortest git abbreviation a receipt name may carry
pub const SHA_MAX : u32 = 40;      // a full sha-1
pub const CHALLENGE_HEX : u32 = 8; // the challenge prefix in every receipt name

fn starts_with(s: str, p: str) -> bool {
    if (p.len > s.len) { return false; }
    var i : u32 = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn ends_with(s: str, p: str) -> bool {
    if (p.len > s.len) { return false; }
    const off : u32 = s.len - p.len;
    var i : u32 = 0;
    while (i < p.len) {
        if (s[off + i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn is_hex(c: u8) -> bool {
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102);
}

/// A law pointer names a .t27 spec under specs/ in the t27 repo: "t27:specs/<path>.t27".
pub fn is_law_pointer(p: str) -> bool {
    if (p.len <= LAW_PREFIX.len + LAW_SUFFIX.len) { return false; }
    return starts_with(p, LAW_PREFIX) and ends_with(p, LAW_SUFFIX);
}

/// A receipt name is runs/<sha, 7..40 lowercase hex>.<challenge, 8 lowercase hex>.json.
pub fn is_receipt_path(p: str) -> bool {
    const head : u32 = RECEIPT_DIR.len + 1;
    if (p.len < head + SHA_MIN + 1 + CHALLENGE_HEX + RECEIPT_SUFFIX.len) { return false; }
    if (starts_with(p, RECEIPT_DIR) == false) { return false; }
    if (p[RECEIPT_DIR.len] != 47) { return false; }
    if (ends_with(p, RECEIPT_SUFFIX) == false) { return false; }
    var i : u32 = head;
    while (i < p.len and is_hex(p[i])) { i = i + 1; }
    const sha_len : u32 = i - head;
    if (sha_len < SHA_MIN or sha_len > SHA_MAX) { return false; }
    if (i >= p.len) { return false; }
    if (p[i] != 46) { return false; }
    i = i + 1;
    const c0 : u32 = i;
    while (i < p.len and is_hex(p[i])) { i = i + 1; }
    if (i - c0 != CHALLENGE_HEX) { return false; }
    return i + RECEIPT_SUFFIX.len == p.len;
}

test every_law_this_surface_calls_is_a_t27_spec_pointer {
    assert is_law_pointer(LAB_LAW);
    assert is_law_pointer(PAYOUT_LAW);
    assert is_law_pointer(WALLET_LAW);
    // negative controls: a bare path, a non-t27 file, a prefix with no spec name
    assert is_law_pointer("specs/t27os/labs.t27") == false;
    assert is_law_pointer("t27:specs/t27os/labs.rs") == false;
    assert is_law_pointer("t27:specs/.t27") == false;
}

test the_laws_are_three_distinct_homes {
    // one rule, one home: two pointers at one file would be one law named twice
    assert LAB_LAW != PAYOUT_LAW;
    assert LAB_LAW != WALLET_LAW;
    assert PAYOUT_LAW != WALLET_LAW;
}

test the_first_receipt_has_the_receipt_shape {
    assert is_receipt_path(FIRST_RECEIPT);
    assert is_receipt_path("runs/629c2b9ca7afc3d1ad5672bde32ff91b54990df5.352b10b0.json");
    // negative controls: the empty-sha dotfile a scheduled run would write (t27os#11), a
    // 6-hex sha, a 7-hex challenge, uppercase hex, a wrong directory, a trailing byte
    assert is_receipt_path("runs/.048f7f45.json") == false;
    assert is_receipt_path("runs/8f28c2.048f7f45.json") == false;
    assert is_receipt_path("runs/8f28c2d849.048f7f4.json") == false;
    assert is_receipt_path("runs/8F28C2D849.048f7f45.json") == false;
    assert is_receipt_path("run/8f28c2d849.048f7f45.json") == false;
    assert is_receipt_path("runs/8f28c2d849.048f7f45.jsonx") == false;
}

test the_executor_is_a_github_workflow {
    assert starts_with(WORKFLOW, ".github/workflows/");
    assert ends_with(WORKFLOW, ".yml");
    assert starts_with("lab.yml", ".github/workflows/") == false;
}
