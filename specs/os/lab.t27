// specs/os/lab.t27 -- the T27 OS lab: the run drive-in and receipt publisher, WITHOUT Railway.
//
// WHY: the old lab (t27b-lab-production.up.railway.app) took run requests over an ssh alias and
// published receipts at /runs/<sha>.json. On 2026-10-23 the railway token on the owner's machine
// expired (36-byte stale token; `railway login` needs an interactive browser), which made the
// lab's write-side unreachable from the one machine that drives the loop. The owner's call the
// same day: replace Railway with T27 OS. This spec is the contract of that replacement; the
// executor is GitHub Actions under the `github-actions` HOST the cron vocabulary already has
// (specs/crons/README.md), and the receipts publish into THIS repository (runs/), so both sides
// of the channel are ours and neither needs a Railway login.
//
// THE CONTRACT (what a run is):
//   request   a run is named by the master sha it tests plus a challenge the requester keeps
//             (the same discipline AGENTS.md prescribes for corpus receipts: a challenge you
//             wrote is the only one you trust).
//   executor  a github-actions dispatch (workflow_dispatch, input: sha, challenge, spec list)
//             checks out t27 at that sha, builds t27c, runs the named specs' test-reports, and
//             writes one receipt per run.
//   receipt   runs/<sha>.<challenge8>.json: the sha, the challenge hash, per-spec test counts
//             (tests/pass/FAIL/vacuous), the t27c build stamp, and the UTC time. Machine-checkable,
//             no prose required.
//   trust     a receipt proves something only together with the challenge the requester kept;
//             a published receipt without your challenge proves nothing (the lesson the
//             corpus-receipt protocol already paid for).
//
// DECENTRALIZED EXECUTORS. github-actions is the FIRST executor, not the only one. A lab node is
// anything that can build t27c at a given sha and publish a receipt shaped by this contract --
// a second GitHub runner, a contributor's machine, a board on a shelf. The network is open by
// construction: the receipt format is the membership test, and the challenge discipline is the
// trust test. A node that publishes receipts nobody can reproduce loses the only currency a lab
// has, which is being believed.
//
// $TRI FOR USEFUL WORK. The payout law already exists and is not copied here: t27's
// specs/verified/payout.t27 (VerifiedPayout) is the law of what a verified payout is, and
// specs/automation/token-wallet.t27 holds the wallet. The wiring this contract adds:
//   a receipt whose challenge verifies AND whose counts reproduce (a second node, or the
//   requester, re-runs and matches) is USEFUL WORK; each such verified run is one VerifiedPayout
//   row for the node that published it, paid in $TRI by the wallet law. The AMOUNT lives in the
//   payout law, never here. A receipt that cannot be reproduced pays nothing; a node faking
//   counts publishes its own permanent refutation, since every run names its sha and stamp.
//
// NOT CLAIMED: no runner ran before 2026-10-23 (the first dispatch is the proof this contract
// is executable); no performance claim vs the Railway lab; the old lab keeps serving reads
// until cutover; the $TRI amounts and the payout schedule are the payout law's to set.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_lab;

pub const ID : str = "t27os-lab";
pub const VERSION : u8 = 1;

// the executor HOST, in the cron vocabulary's spelling (specs/crons/README.md) -- the first of many
pub const HOST : str = "github-actions";

// the receipt publisher: this repository, this directory
pub const RECEIPT_REPO : str = "Trinity-S-AI-DNA/t27os";
pub const RECEIPT_DIR : str = "runs";

// $TRI for useful work: the payout law homes (pointer, never a copy)
pub const PAYOUT_LAW : str = "t27:specs/verified/payout.t27";
pub const WALLET_LAW : str = "t27:specs/automation/token-wallet.t27";
pub const PAYOUT_UNIT : str = "TRI";

// what earns a payout: a receipt whose challenge verifies and whose counts reproduce
pub const USEFUL_RUN_VERIFICATIONS_MIN : u8 = 2;

// the old lab this replaces, kept for reads until cutover
pub const LEGACY_HOST : str = "t27b-lab-production.up.railway.app";
pub const LEGACY_AUTH_STATE : str = "railway token expired 2026-10-23, login is interactive";

invariant receipt_names_its_sha_and_challenge {
    // a receipt without both names is unreadable by the only parties that matter
    assert RECEIPT_DIR == "runs";
}

invariant no_railway_in_the_drive_in {
    // the executor and the publisher are both ours; Railway remains read-only legacy only
    assert HOST == "github-actions";
}

invariant payouts_point_at_the_law_and_never_set_amounts {
    // this contract wires the pipe; the payout law owns the money
    assert PAYOUT_UNIT == "TRI";
}
