// specs/os/architecture.t27 -- the unified T27 OS / Queen / HIVE / Bee map, as one spec.
// Everything here is a pointer: the law lives once in Trinity-S-AI-DNA/t27, the server in trios,
// the Inngest Queen in the BrowserOS trios fork, the site in trinity. This file names the home of
// each layer and its verified state; it copies none of them. Verified by an independent local
// agent run on 2026-10-23 (see receipts/architecture_verification_2026_10_23.t27).
//
// THE LAYERS (repo -- path -- state on 2026-10-23):
//   law, actor model   t27 specs/queen/actors.t27        37/37 tests, 0 vacuous
//   law, hive drawing  t27 specs/queen/hive.t27          5/5 tests (10 HIVE kinds)
//   law, task machine  t27 specs/queen/dispatch.t27     13/13 tests
//   law, bees+events   t27 specs/queen/ (49 specs: control, reviewer, actor_events, holds,
//                      jobs, priority, replay/golden_chain_history, ...)
//   law, OS menu       t27 specs/t27f/petal_menu.t27    epic t27#10782 (OPEN)
//   OS home            t27os specs/os/home.t27          rules by pointer, 7 layers L1-L7
//   orchestrator       trios backend/ on dev            backend migration COMPLETE; bee lanes on
//                       bee/* branches; actors-next, actors-next-2, ci/queen-workflows
//   Inngest Queen      BrowserOS/trios trios/agent-server/apps   serves cards from a pinned t27 sha
//   site               trinity apps/website             QueenBrowser/Chat/Watch, CronExplorer
//
// WHAT WORKS (measured 2026-10-23, master 89d05acac): the Queen's law passes 55 tests green
// (37+5+13, zero vacuous); t27c parse / test-report / seal run locally end to end; T27F Live
// M0-M2 + M4 (live_mode, #11787) + M6 (export_video, #11753) on master; M3's hud.t27 landed
// (#11784), a11y_mirror in flight in the owner's lane, the loader tracked as trinity#1717;
// the lab runs on THIS repo's executor: five challenge-verified receipts under runs/, ffmpeg
// 6.1.1 present on the runner (the M6 encoder prerequisite), the first receipt reproduced by
// the requester (the two-verification bar met); the L7 grid is OPEN with three cards
// (graph 200, crons 200, live DARK 404 -- stated in the card); the trios backend migration
// is complete.
//
// HONEST GAPS, each with its home:
//   1  STALE TOOLCHAINS FAIL SILENTLY. The codegen class this used to describe is FIXED on
//      master (1df7383ad, #11012: the splice reads a name inside a pulled declaration in that
//      declaration's module). Residue, tracked in t27#11779: a pre-#11012 binary BLOCKs a spec
//      that is green on master (measured: lesson_reel 30/30 on current, BLOCKED on stale), and
//      BLOCKED passes every current merge gate. Proposals live in #11779.
//   2  AGENTS.md says the Queen server lives on trios branches queen and queen-runners. Both
//      EXIST (verified after paginating all 547 branches -- a single per_page=100 query shows
//      only the first 100 alphabetically and hides them). The doc is not wrong about the
//      branches; it may still lag the backend migration.
//   3  The OS home had one commit and no widget cards behind the petals (L7 empty in the MVP);
//      Swift TriangleLogo in trinity still disagrees with the spec (28 screens for 27 petals,
//      settings unreachable) -- epic #10782's body, OPEN.
//   4  The FPGA leg (AX7203) of "trios to FPGA" is not started.
//   5  T27F Live: M4 has its issue (#11778); M3 (60 fps) and M6 (900-frame MP4) lab
//      measurements are unmeasured. The lab is LEAVING RAILWAY (owner call 2026-10-23): the
//      contract is landed in this repo at specs/os/lab.t27 -- executor github-actions,
//      receipts published here under runs/ -- and the migration is tracked in t27#11781.
//      Until the executor workflow lands, the old Railway lab serves reads only (its write
//      side died with the expired railway token; login is interactive).
//
// NOT CLAIMED: no runtime numbers for the Queen server here (the round clock is measured by the
// tri game-round family against the server clock, not in this file); no FPGA claim of any kind.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_architecture;

pub const ID : str = "t27os-architecture";
pub const VERIFIED_AT : str = "2026-10-23";
// the t27 master the receipt (receipts/architecture_verification_2026_10_23.t27, 10:00Z) ran
// on; the 89d05acac in WHAT WORKS above is a later re-measure the same day, not this receipt
pub const MASTER_SHA : str = "4e96f3a43";

// the three laws the receipt ran, as one number a machine can re-check
pub const QUEEN_LAW_TESTS : u32 = 55;
pub const ACTORS_TESTS : u32 = 37;
pub const HIVE_TESTS : u32 = 5;
pub const DISPATCH_TESTS : u32 = 13;

invariant the_law_counts_add_up {
    assert ACTORS_TESTS + HIVE_TESTS + DISPATCH_TESTS == QUEEN_LAW_TESTS;
}

// One home per rule: t27os points (this file), t27 owns (specs/queen, specs/t27f). That is a
// property of the module's contents, not of a value, so no assert here can witness it; the
// `assert true` that stood here (t27os#13) counted as a passing check while checking nothing.

fn is_hex(c: u8) -> bool {
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102);
}

/// A git abbreviation as t27c bakes it in: 7..40 lowercase hex characters.
pub fn is_short_sha(s: str) -> bool {
    if (s.len < 7 or s.len > 40) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (is_hex(s[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// An ISO calendar date, YYYY-MM-DD, month 01..12 and day 01..31.
pub fn is_iso_date(s: str) -> bool {
    if (s.len != 10 or s[4] != 45 or s[7] != 45) { return false; }
    var i : usize = 0;
    while (i < 10) {
        if (i != 4 and i != 7 and (s[i] < 48 or s[i] > 57)) { return false; }
        i = i + 1;
    }
    const m : u32 = @as(u32, s[5] - 48) * 10 + @as(u32, s[6] - 48);
    const d : u32 = @as(u32, s[8] - 48) * 10 + @as(u32, s[9] - 48);
    return m >= 1 and m <= 12 and d >= 1 and d <= 31;
}

test the_receipt_pins_a_real_sha_and_date {
    assert is_short_sha(MASTER_SHA);
    assert is_iso_date(VERIFIED_AT);
    // negative controls: a 6-hex abbreviation, uppercase, a non-hex byte; a 13th month, a
    // day 00, a slash date
    assert is_short_sha("4e96f3") == false;
    assert is_short_sha("4E96F3A43") == false;
    assert is_short_sha("4e96f3a4g") == false;
    assert is_iso_date("2026-13-23") == false;
    assert is_iso_date("2026-10-00") == false;
    assert is_iso_date("2026/10/23") == false;
}
