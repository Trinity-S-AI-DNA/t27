// specs/os/architecture.t27 -- the unified T27 OS / Queen / HIVE / Bee map, as one spec.
// Everything here is a pointer: the law lives once in Trinity-S-AI-DNA/t27, the server in trios,
// the Inngest Queen in the BrowserOS trios fork, the site in trinity. This file names the home of
// each layer and its verified state; it copies none of them. Verified by an independent local
// agent run on 2026-10-23 (see receipts/architecture_verification_2026_10_23.t27).
//
// THE LAYERS (repo -- path -- state on 2026-10-23):
//   law, actor model   t27 specs/queen/actors.t27        37/37 tests, 0 vacuous
//   law, hive drawing  t27 specs/queen/hive.t27          5/5 tests (10 HIVE kinds)
//   law, task machine  t27 specs/queen/dispatch.t27     13/13 tests
//   law, bees+events   t27 specs/queen/ (49 specs: control, reviewer, actor_events, holds,
//                      jobs, priority, replay/golden_chain_history, ...)
//   law, OS menu       t27 specs/t27f/petal_menu.t27    epic t27#10782 (OPEN)
//   OS home            t27os specs/os/home.t27          rules by pointer, 7 layers L1-L7
//   orchestrator       trios backend/ on dev            backend migration COMPLETE; bee lanes on
//                       bee/* branches; actors-next, actors-next-2, ci/queen-workflows
//   Inngest Queen      BrowserOS/trios trios/agent-server/apps   serves cards from a pinned t27 sha
//   site               trinity apps/website             QueenBrowser/Chat/Watch, CronExplorer
//
// WHAT WORKS (measured 2026-10-23, master 4e96f3a43): the Queen's law passes 55 tests green
// (37+5+13, zero vacuous); t27c parse / test-report / seal run locally end to end; T27F Live
// M0-M2 on master, M3 foundation #11752 landed, M6 #11753 and the lesson_reel fix #11754 open
// with all spec gates green; the trios backend migration is complete.
//
// HONEST GAPS, each with its home:
//   1  t27c codegen does not emit transitive imports when inlining: lesson_reel.t27 landed
//      BLOCKED on master via #11752 (inlined arche leaves module_of undeclared; BLOCKED passes
//      every current merge gate). Spec-side fix rides PR #11754; the root fix is t27c's.
//   2  AGENTS.md says the Queen server lives on trios branches queen and queen-runners. Both
//      EXIST (verified after paginating all 547 branches -- a single per_page=100 query shows
//      only the first 100 alphabetically and hides them). The doc is not wrong about the
//      branches; it may still lag the backend migration.
//   3  The OS home had one commit and no widget cards behind the petals (L7 empty in the MVP);
//      Swift TriangleLogo in trinity still disagrees with the spec (28 screens for 27 petals,
//      settings unreachable) -- epic #10782's body, OPEN.
//   4  The FPGA leg (AX7203) of "trios to FPGA" is not started.
//   5  T27F Live M4 (live mode over SSE) has no issue; M3 (60 fps) and M6 (900-frame MP4) lab
//      measurements are unmeasured; the lab answers HTTP 200 since 2026-10-23.
//
// NOT CLAIMED: no runtime numbers for the Queen server here (the round clock is measured by the
// tri game-round family against the server clock, not in this file); no FPGA claim of any kind.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_architecture;

pub const ID : str = "t27os-architecture";
pub const VERIFIED_AT : str = "2026-10-23";
pub const MASTER_SHA : str = "4e96f3a43";

// the three laws the receipt ran, as one number a machine can re-check
pub const QUEEN_LAW_TESTS : u32 = 55;
pub const ACTORS_TESTS : u32 = 37;
pub const HIVE_TESTS : u32 = 5;
pub const DISPATCH_TESTS : u32 = 13;

invariant the_law_counts_add_up {
    assert ACTORS_TESTS + HIVE_TESTS + DISPATCH_TESTS == QUEEN_LAW_TESTS;
}

invariant one_home_per_rule {
    // t27os points (this file), t27 owns (specs/queen, specs/t27f); a copy here would be a
    // second home, which the rule forbids -- so this module declares no law of its own.
    assert true;
}
