// SPDX-License-Identifier: Apache-2.0
// specs/os/sync_gate.t27 -- the sync gate of T27 OS: the two trees couple by REFERENCE, never by
// VALUE (issue Trinity-S-AI-DNA/t27os#6). This tree (t27os) and its owner tree (gHashTag/t27) are
// coupled at one point: specs/os/home.t27 names the owner spec by path and intent -- HOME_SPEC =
// "gHashTag/t27:specs/t27f/petal_menu.t27" -- and every card names its law home the same way. The
// petal count, the realm names, the letter registry, the agent cap numbers and the mailbox cap are
// OWNED there (t27:specs/t27f/petal_menu.t27, t27:specs/t27os/kernel.t27, t27:specs/t27os/evolve.t27,
// t27:specs/queen/actors.t27). A constant copied into this tree is a DEFECT, not a fork: the owner
// moves, the copy does not, and the two trees disagree forever after.
//
// THE LAW, mechanical: no spec in this tree may hold an owned NAME in code. A comment naming the
// owner is the pointer pattern and is fine; a string naming the owner path is the pointer itself
// and is fine; an owned name standing in code -- declared (const/fn) or merely used -- is a copy
// and is a defect. The night tick carries SYNC-STEP: the grep
//     grep -rn "PETAL_COUNT|agent_cap|TOOL_LETTER" specs/
// over the live tree, any non-comment hit filed the tick it appears. The functions below are the
// same decision as code, so the law is testable and the verdict is not a matter of grep quoting.
//
// THE BASELINE (measured 2026-10-24 night, t27os master d52bd59): 0 owned names in code anywhere
// in this tree. The inventory below embeds every declaration line of this tree's seven spec files
// (91 lines) and the tests assert the scan of all of them finds zero copies. When the tree changes,
// the tick regenerates the inventory from the live files before it trusts a clean verdict: a future
// copy enters the refreshed inventory and the test in
// the_trees_declaration_inventory_holds_zero_copies fails naming the line.
//
// HONEST SCOPE: this spec polices NAMES. A bare owned VALUE in code (the cards restate the owner's
// petal / realm-size placement as a division) is the value-fingerprint layer of the same gate,
// drafted on PR #15 and named on #6 by tick 18; it is tracked there, not here.
//
// The classifiers are pure: they take the bytes of one line, so the night tick can run them over
// any file's text and this spec can test them on lines lifted from real files.
// ASCII only (L3).
// phi^2 + 1/phi^2 = 3 | TRINITY

module T27osSyncGate;

pub const ID : str = "t27os-sync-gate";
pub const ISSUE : str = "Trinity-S-AI-DNA/t27os#6";

// --- the rule, as data: where the coupling lives, and who owns what ---
pub const POINTER_SPEC : str = "specs/os/home.t27";
pub const POINTER_NAME : str = "HOME_SPEC";
pub const OWNER_PETALS : str = "t27:specs/t27f/petal_menu.t27";
pub const OWNER_KERNEL : str = "t27:specs/t27os/kernel.t27";
pub const OWNER_EVOLVE : str = "t27:specs/t27os/evolve.t27";
pub const OWNER_ACTORS : str = "t27:specs/queen/actors.t27";
pub const OWNER_PETALS_PATH : str = "specs/t27f/petal_menu.t27";

// the owned NAMES, one home each, |-separated. case-sensitive exact words, like the tick's grep.
// owner of the first ten: OWNER_PETALS; of agent_cap, LANE_MB, LANE_HARD_MAX: OWNER_KERNEL;
// of EV_MAX_AGENTS: OWNER_EVOLVE; of MAILBOX_CAP: OWNER_ACTORS. TOOL_LETTER is the tick's watched
// name for the owner's letter registry (not yet declared there; a hit means someone declared it
// here first, which the rule forbids all the same).
pub const OWNED_NAMES : str = "PETAL_COUNT|PETALS_PER_REALM|REALM_COUNT|PETAL_NONE|PETAL_LETTERS|WORLD_NAMES|REALM_NAMES|REALM_RAZUM|REALM_MATERIYA|REALM_DUKH|agent_cap|LANE_MB|LANE_HARD_MAX|EV_MAX_AGENTS|MAILBOX_CAP|TOOL_LETTER";
pub const OWNED_COUNT : u32 = 16;

// --- verdicts ---
pub const V_OK : u8 = 0;          // prose, string, pointer, or code that owns no owned name
pub const V_COPY_DECL : u8 = 1;   // code declares an owned name (const or fn)
pub const V_COPY_USE : u8 = 2;    // code uses an owned name it does not declare

pub const NO_LINE : u32 = 0;      // first_copy_line's "the text is clean"

fn is_digit(c : u8) -> bool {
    return c >= '0' and c <= '9';
}

fn is_word(c : u8) -> bool {
    return is_digit(c) or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_';
}

fn is_space(c : u8) -> bool {
    return c == ' ' or c == '\t' or c == '\r';
}

/// The end of the code part of b[s..e): the first "//" outside a string literal, or e.
pub fn code_end(b : str, s : usize, e : usize) -> usize {
    var i : usize = s;
    var quoted : bool = false;
    while (i < e) {
        if (b[i] == '"') {
            quoted = quoted == false;
        } else if (quoted == false and b[i] == '/' and i + 1 < e and b[i + 1] == '/') {
            return i;
        }
        i += 1;
    }
    return e;
}

/// A line whose first non-space byte opens a comment (; or //), or a blank line, carries no code.
pub fn is_prose(b : str, s : usize, e : usize) -> bool {
    var i : usize = s;
    while (i < e and is_space(b[i])) { i += 1; }
    if (i == e) { return true; }
    if (b[i] == ';') { return true; }
    return code_end(b, i, e) == i;
}

/// Is b[p..q) one of the |-separated names of list, byte for byte?
pub fn name_in_list(b : str, p : usize, q : usize, list : str) -> bool {
    var f : usize = 0;
    while (f < list.len) {
        var g : usize = f;
        while (g < list.len and list[g] != '|') { g += 1; }
        if (g - f == q - p) {
            var k : usize = 0;
            var same : bool = true;
            while (k < q - p) {
                if (b[p + k] != list[f + k]) { same = false; }
                k += 1;
            }
            if (same) { return true; }
        }
        f = g + 1;
    }
    return false;
}

/// Does needle occur anywhere in hay? Byte scan, for checking a pointer names its owner path.
pub fn contains(hay : str, needle : str) -> bool {
    if (needle.len == 0) { return true; }
    if (needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var k : usize = 0;
        var same : bool = true;
        while (k < needle.len) {
            if (hay[i + k] != needle[k]) { same = false; }
            k += 1;
        }
        if (same) { return true; }
        i += 1;
    }
    return false;
}

/// Is the word ending just before b[p) -- spaces skipped -- the const or fn keyword? That is
/// what makes an owned name at p a DECLARATION ("pub const PETAL_COUNT ..."), while an operator
/// or a comma before it ("< PETAL_COUNT") leaves it a use.
fn preceded_by_decl_keyword(b : str, p : usize, s : usize) -> bool {
    var q : usize = p;
    while (q > s and is_space(b[q - 1])) { q -= 1; }
    if (q == s or is_word(b[q - 1]) == false) { return false; }
    var w : usize = q;
    while (w > s and is_word(b[w - 1])) { w -= 1; }
    // the word stands at b[w..q)
    if (q - w == 5 and b[w] == 'c' and b[w + 1] == 'o' and b[w + 2] == 'n' and b[w + 3] == 's' and b[w + 4] == 't') { return true; }
    if (q - w == 2 and b[w] == 'f' and b[w + 1] == 'n') { return true; }
    return false;
}

/// The verdict on the code bytes b[s..e): does any owned name stand there as a whole word,
/// outside string literals? A name preceded by const or fn is a declaration, any other standing
/// is a use. Both are copies; the label is for the report.
pub fn code_verdict(b : str, s : usize, e : usize) -> u8 {
    const c : usize = code_end(b, s, e);
    var i : usize = s;
    var quoted : bool = false;
    while (i < c) {
        if (b[i] == '"') {
            quoted = quoted == false;
            i += 1;
        } else if (quoted == false and is_word(b[i]) and (i == s or is_word(b[i - 1]) == false)) {
            var j : usize = i;
            while (j < c and is_word(b[j])) { j += 1; }
            if (name_in_list(b, i, j, OWNED_NAMES)) {
                if (preceded_by_decl_keyword(b, i, s)) { return V_COPY_DECL; }
                return V_COPY_USE;
            }
            i = j;
        } else {
            i += 1;
        }
    }
    return V_OK;
}

/// The verdict on one line of source bytes b[s..e).
pub fn line_verdict(b : str, s : usize, e : usize) -> u8 {
    if (is_prose(b, s, e)) { return V_OK; }
    return code_verdict(b, s, e);
}

fn verdict_of(b : str) -> u8 {
    return line_verdict(b, 0, b.len);
}

/// How many lines of the text b hold an owned name in code.
pub fn copies(b : str) -> u32 {
    var n : u32 = 0;
    var s : usize = 0;
    while (s < b.len) {
        var e : usize = s;
        while (e < b.len and b[e] != '\n') { e += 1; }
        if (line_verdict(b, s, e) != V_OK) { n += 1; }
        s = e + 1;
    }
    return n;
}

/// The 1-based number of the first line of b that holds an owned name in code, or NO_LINE.
pub fn first_copy_line(b : str) -> u32 {
    var line : u32 = 1;
    var s : usize = 0;
    while (s < b.len) {
        var e : usize = s;
        while (e < b.len and b[e] != '\n') { e += 1; }
        if (line_verdict(b, s, e) != V_OK) { return line; }
        line += 1;
        s = e + 1;
    }
    return NO_LINE;
}

/// How many lines the text b holds.
pub fn line_count(b : str) -> u32 {
    var n : u32 = 1;
    var i : usize = 0;
    while (i < b.len) {
        if (b[i] == '\n') { n += 1; }
        i += 1;
    }
    return n;
}

// --- the tree's declaration inventory, lifted 2026-10-24 from t27os master d52bd59 ---
// Every line of this tree's seven spec files that declares a const or a fn, byte for byte,
// joined by newlines. The tick regenerates these from the live files before it trusts a clean
// verdict; the counts are part of the baseline, so a refresh that changes the census is visible.

