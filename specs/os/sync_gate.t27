pub const RECEIPT_LINES : str = "pub const ID : str = \"t27os-receipt-architecture-2026-10-23\";\npub const CLAIMS_TOTAL : u32 = 11;\npub const CLAIMS_CONFIRMED : u32 = 10;\npub const CLAIMS_REFUTED : u32 = 1;\npub const TRIOS_BRANCHES_SEEN_ON_ONE_PAGE : u32 = 100;\npub const TRIOS_BRANCHES_TOTAL : u32 = 547;";

pub const BASELINE_FILES : u32 = 7;
pub const BASELINE_LINES : u32 = 91;

// The pointer comments: every line of this tree that names an owned constant, lifted byte for
// byte. They are the allowance made real -- the cards READ from the owner law and say so in
// prose. Comments carry no copy.
pub const POINTER_COMMENT_LINES : str = "// pinned below: WORLD_NAMES index 12 is \"MAP\", and the law places a petal with petal / 9, so\n// 12 / 9 == 1 == REALM_MATERIYA (the middle ring, petals 9-17). The graph page is the map of the\n// pinned below: WORLD_NAMES index 7 is \"HIVE\", and the law places a petal with petal / 9, so\n// 7 / 9 == 0 == REALM_RAZUM (the outer ring, petals 0-8). The semantic fit: a cron is the Queen's\n// (petal 7 is H) and WORLD_NAMES index 7 is \"HIVE\"; the law places a petal with petal / 9, so\n// 7 / 9 == 0 == REALM_RAZUM (the outer ring, petals 0-8, the Archetypal agents A-I). WHY HIVE and";

invariant the_coupling_is_by_reference {
    // the one coupling point names the owner spec by path, and this spec says so -- the string
    // equalities hold at comptime (t27c: compiling IS the check; t27b re-checks at runtime).
    // The loop-based halves of the rule -- the owner path containment and the scan of the
    // pointer spec -- live in the_pointer_lines_couple_by_reference, because a comptime loop
    // busts the branch quota.
    assert POINTER_NAME == "HOME_SPEC";
    assert POINTER_SPEC == "specs/os/home.t27";
    assert OWNER_PETALS == "t27:specs/t27f/petal_menu.t27";
}

fn list_count(list : str) -> u32 {
    var n : u32 = 1;
    var i : usize = 0;
    while (i < list.len) {
        if (list[i] == '|') { n += 1; }
        i += 1;
    }
    return n;
}

test the_owned_registry_round_trips {
    assert list_count(OWNED_NAMES) == OWNED_COUNT;
    // the tick's three watched names are all registered
    assert name_in_list("PETAL_COUNT", 0, 11, OWNED_NAMES);
    assert name_in_list("agent_cap", 0, 9, OWNED_NAMES);
    assert name_in_list("TOOL_LETTER", 0, 11, OWNED_NAMES);
    assert name_in_list("MAILBOX_CAP", 0, 11, OWNED_NAMES);
    assert name_in_list("LANE_HARD_MAX", 0, 13, OWNED_NAMES);
    // near-names are not owned: whole word, byte exact, case sensitive -- like the tick's grep
    assert name_in_list("PETAL", 0, 5, OWNED_NAMES) == false;
    assert name_in_list("PETAL_LETTER", 0, 12, OWNED_NAMES) == false;
    assert name_in_list("PETAL_COUNT_SHOWN", 0, 17, OWNED_NAMES) == false;
    assert name_in_list("AGENT_CAP", 0, 9, OWNED_NAMES) == false;
    assert name_in_list("TOOL_LETTERS", 0, 12, OWNED_NAMES) == false;
}

test comments_strings_and_blanks_carry_no_copy {
    // the tree's own pointer comments, lifted from the cards' headers
    assert verdict_of("// pinned below: WORLD_NAMES index 7 is \"HIVE\", and the law places a petal with petal / 9, so") == V_OK;
    assert verdict_of("// 7 / 9 == 0 == REALM_RAZUM (the outer ring, petals 0-8). The semantic fit: a cron is the Queen's") == V_OK;
    // a ; comment from home.t27's card grid
    assert verdict_of("; card 0: the T27F work-graph view, behind petal 12 (MATERIYA / MAP)") == V_OK;
    // this gate's own registry: the owned names stand inside a string, as data
    assert verdict_of("pub const OWNED_NAMES : str = \"PETAL_COUNT|PETALS_PER_REALM|agent_cap|TOOL_LETTER\";") == V_OK;
    // blanks
    assert verdict_of("") == V_OK;
    assert verdict_of("   ") == V_OK;
    assert copies(POINTER_COMMENT_LINES) == 0;
}

test the_pointer_lines_couple_by_reference {
    // home.t27's coupling point, lifted byte for byte: the string names the owner spec
    const home_pointer : str = "pub const HOME_SPEC : str = \"gHashTag/t27:specs/t27f/petal_menu.t27\";";
    assert verdict_of(home_pointer) == V_OK;
    assert contains(home_pointer, OWNER_PETALS_PATH);
    // the pointer constants themselves hold the paths (the loop half of the invariant)
    assert contains(OWNER_PETALS, OWNER_PETALS_PATH);
    assert copies(POINTER_SPEC) == 0;
    // a card's law home, and an in-tree card pointer, lifted from the live files
    assert verdict_of("pub const LAW_HOME : str = \"gHashTag/t27:specs/t27f/spec_graph_view.t27\";") == V_OK;
    assert verdict_of("pub const CARD0_SPEC : str = \"specs/os/cards/graph_card.t27\";") == V_OK;
}

test a_code_mention_of_an_owned_name_is_a_copy {
    // declarations, the shapes a copier actually writes
    assert verdict_of("pub const PETAL_COUNT : u32 = 27;") == V_COPY_DECL;
    assert verdict_of("pub const TOOL_LETTER : str = \"A\";") == V_COPY_DECL;
    assert verdict_of("pub const EV_MAX_AGENTS : u32 = 3;  // mirrors evolve.t27") == V_COPY_DECL;
    assert verdict_of("pub fn agent_cap(mem_bytes: u64) -> u32 {") == V_COPY_DECL;
    // uses: owner code pasted into a body
    assert verdict_of("    return p < PETAL_COUNT;") == V_COPY_USE;
    assert verdict_of("    assert agent_cap(m, f, c, l, b) == 3;") == V_COPY_USE;
    // a declaration outranks nothing: either way the line is a copy
    assert verdict_of("pub const PETAL_COUNT : u32 = 27; // see petal_menu.t27") == V_COPY_DECL;
}

test whole_word_and_case_boundaries_hold {
    // a name that merely contains an owned one is its own name
    assert verdict_of("pub const PETAL_COUNT_SHOWN : u32 = 4;") == V_OK;
    assert verdict_of("pub const MY_PETAL_COUNT : u32 = 4;") == V_OK;
    assert verdict_of("pub const PETAL_LETTER : str = \"H\";") == V_OK;
    // the tick's grep is case-sensitive and so is the gate
    assert verdict_of("pub const AGENT_CAP : u32 = 4;") == V_OK;
    // the same bytes flip once they stand in code, not prose
    assert verdict_of("pub const X : u32 = 1; // PETAL_COUNT") == V_OK;
    assert verdict_of("pub const PETAL_COUNT : u32 = 27;") == V_COPY_DECL;
    // a // inside a string does not end the code, so a name after it is still seen
    assert verdict_of("pub const U : str = \"http://x\"; pub const PETAL_COUNT : u32 = 27;") == V_COPY_DECL;
}

test the_trees_declaration_inventory_holds_zero_copies {
    // the acceptance: the tree, as measured 2026-10-24 night, holds ZERO owned names in code
    assert copies(ARCH_LINES) == 0;
    assert copies(HOME_LINES) == 0;
    assert copies(LAB_LINES) == 0;
    assert copies(GRAPH_LINES) == 0;
    assert copies(CRONS_LINES) == 0;
    assert copies(LIVE_LINES) == 0;
    assert copies(RECEIPT_LINES) == 0;
    // the census is the whole inventory: 91 declaration lines over 7 files
    assert line_count(ARCH_LINES) == 7;
    assert line_count(HOME_LINES) == 25;
    assert line_count(LAB_LINES) == 10;
    assert line_count(GRAPH_LINES) == 13;
    assert line_count(CRONS_LINES) == 14;
    assert line_count(LIVE_LINES) == 16;
    assert line_count(RECEIPT_LINES) == 6;
    var total : u32 = 0;
    total += copies(ARCH_LINES);
    total += copies(HOME_LINES);
    total += copies(LAB_LINES);
    total += copies(GRAPH_LINES);
    total += copies(CRONS_LINES);
    total += copies(LIVE_LINES);
    total += copies(RECEIPT_LINES);
    assert total == 0;
    assert BASELINE_LINES == 7 + 25 + 10 + 13 + 14 + 16 + 6;
    assert BASELINE_FILES == 7;
}

test the_gate_names_the_line_of_a_future_copy {
    // a future home.t27 that grows a copy: the gate counts it and names the line
    const future : str = "pub const HOME_SURFACE : str = \"petal_menu\";\npub const HOME_SPEC : str = \"gHashTag/t27:specs/t27f/petal_menu.t27\";\npub const PETAL_COUNT : u32 = 27;\npub const BOOT_HOME : u32 = 1;";
    assert copies(future) == 1;
    assert first_copy_line(future) == 3;
    // the copy stands out even when the file stays mostly pointers
    const clean : str = "pub const HOME_SPEC : str = \"gHashTag/t27:specs/t27f/petal_menu.t27\";\npub const EPIC : str = \"gHashTag/t27#10782\";";
    assert copies(clean) == 0;
    assert first_copy_line(clean) == NO_LINE;
    // and the first of several is the one named
    const two : str = "pub const A : u32 = 1;\npub const MAILBOX_CAP : u32 = 256;\npub const LANE_MB : u32 = 900;";
    assert first_copy_line(two) == 2;
}

test the_gate_applies_to_itself {
    // this spec names every owned constant -- inside strings and comments, which is the only
    // place the rule allows. its own real lines must scan clean:
    assert verdict_of("pub const OWNED_NAMES : str = \"PETAL_COUNT|PETALS_PER_REALM|REALM_COUNT|PETAL_NONE|PETAL_LETTERS|WORLD_NAMES|REALM_NAMES|REALM_RAZUM|REALM_MATERIYA|REALM_DUKH|agent_cap|LANE_MB|LANE_HARD_MAX|EV_MAX_AGENTS|MAILBOX_CAP|TOOL_LETTER\";") == V_OK;
    assert verdict_of("pub const OWNER_PETALS : str = \"t27:specs/t27f/petal_menu.t27\";") == V_OK;
    // the negative-control lines above are strings here too, so the whole file could be scanned
    // by the same law it states -- the self-application the pointer pattern lives by
    assert verdict_of("pub const V_COPY_DECL : u8 = 1;   // code declares an owned name (const or fn)") == V_OK;
    assert copies(POINTER_COMMENT_LINES) == 0;
}
