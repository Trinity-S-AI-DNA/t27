// SPDX-License-Identifier: Apache-2.0
// specs/os/cards/crons_card.t27 -- the SECOND card of the T27 OS petal menu: the crons page,
// the Queen's automation surface. Card for gHashTag/t27#11780 (L7 of the T27 OS epic
// gHashTag/t27#10782); the grid it joins is specs/os/home.t27. A card is a POINTER, not a copy:
// it names the widget that already exists, where its law lives, and where it runs. FR-001: this
// file names the law homes and the live URL and restates NO rule of the widget -- the card
// schema, the hosts and the scheduler contract belong to the law, and nothing here copies them.
//
// WHICH PETAL: petal 7, letter H, world HIVE, realm RAZUM. Read from the petal-menu law that
// home.t27 names (gHashTag/t27 specs/t27f/petal_menu.t27, module T27fPetalMenu) at the master sha
// pinned below: WORLD_NAMES index 7 is "HIVE", and the law places a petal with petal / 9, so
// 7 / 9 == 0 == REALM_RAZUM (the outer ring, petals 0-8). The semantic fit: a cron is the Queen's
// agents' RECURRING work -- the watchdogs, reviewer bees and improvement loops that run on a
// schedule while nobody taps anything -- and that scheduled swarm is exactly what the hive is.
// QUEEN (petal 16) names the Queen herself, not her agents' recurring work, and sits in the next
// realm; JOBS (petal 9) is likewise across the ring. HIVE is the one RAZUM world that IS the
// automation surface's population.
//
// VERIFICATION FACTS, measured 2026-10-23T11:53Z, not assumed:
//   - the law homes exist on gHashTag/t27 master a059416c55833a89e68ac675dd9c416a4b5bff91:
//     git ls-tree origin/master names BOTH specs/automation/inngest-queen-scheduler.t27 (the
//     scheduler contract: every cron and skill card of the repository as one Inngest app the
//     Queen's runtime serves) and specs/crons/README.md (the cron card schema: one file per
//     scheduled job, the source of truth for the job card on t27.ai).
//   - the live URL answered HTTP 200 when curled today:
//     curl -s -o /dev/null -w "%{http_code}" https://app.t27.ai/game/crons  ->  200
//     and the queen surface answered 200 too: curl https://t27.ai/#/queen -> 200.
//   - the grid (specs/os/home.t27) holds CARD_COUNT = 1 today -- card 0 is graph_card.t27, petal
//     12. This card is card 1; the parent adds its grid entry (this file must not edit home.t27).
// A card whose law moved or whose URL went dark must be re-measured and re-pointed, not believed.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_card_crons;

pub const ID : str = "t27os-card-crons";

pub const CARD_INDEX : u32 = 1;         // card 0 is the graph card (specs/os/cards/graph_card.t27)

pub const PETAL : u32 = 7;              // letter H, world HIVE
pub const PETAL_LETTER : str = "H";
pub const PETAL_WORLD : str = "HIVE";
pub const REALM : u32 = 0;              // RAZUM, the outer ring, petals 0-8
pub const REALM_NAME : str = "RAZUM";

pub const LAW_REPO : str = "Trinity-S-AI-DNA/t27";
pub const LAW_HOME : str = "Trinity-S-AI-DNA/t27:specs/automation/inngest-queen-scheduler.t27";
pub const LAW_HOME_SCHEMA : str = "Trinity-S-AI-DNA/t27:specs/crons/README.md";
pub const LAW_SHA : str = "a059416c55833a89e68ac675dd9c416a4b5bff91";

pub const LIVE_URL : str = "https://app.t27.ai/game/crons";
pub const LIVE_HTTP_STATUS : u32 = 200; // measured 2026-10-23T11:53Z, curl
pub const VERIFIED_AT : str = "2026-10-23";

/// The realm placement is the petal-menu law's own rule (petal / 9) applied to this card's petal:
/// petal 7 lands in the outer ring. Edit PETAL to a petal outside RAZUM and this refuses.
invariant the_card_sits_behind_the_hive_petal_of_razum {
    assert PETAL == 7;
    assert PETAL / 9 == REALM;
    assert PETAL >= 0 and PETAL <= 8;
    assert REALM_NAME == "RAZUM";
}

/// FR-001, pinned: the card names exactly the law paths that were verified to exist on the cited
/// master sha. Edit a path and the card stops compiling -- a moved law must be re-verified first.
invariant the_law_homes_are_pinned_to_the_verified_master_sha {
    assert LAW_REPO == "Trinity-S-AI-DNA/t27";
    assert LAW_HOME == "Trinity-S-AI-DNA/t27:specs/automation/inngest-queen-scheduler.t27";
    assert LAW_HOME_SCHEMA == "Trinity-S-AI-DNA/t27:specs/crons/README.md";
    assert LAW_SHA == "a059416c55833a89e68ac675dd9c416a4b5bff91";
}

/// The URL is the crons page, and it was LIVE (HTTP 200) when this card was written. A dark URL
/// must be re-measured and the status corrected here before the card may claim the widget runs.
invariant the_live_url_is_the_crons_page_and_it_answered_200 {
    assert LIVE_URL == "https://app.t27.ai/game/crons";
    assert LIVE_HTTP_STATUS == 200;
    assert VERIFIED_AT == "2026-10-23";
}

/// The grid position: this is the second card. Card 0 is the graph card behind petal 12; this
/// card may never claim slot 0 or a petal another card already holds.
invariant the_card_is_the_second_entry_of_the_grid {
    assert CARD_INDEX == 1;
    assert PETAL != 12;
}

test the_pointer_facts_carry_the_card_identity {
    assert ID == "t27os-card-crons";
    assert CARD_INDEX == 1;
    assert PETAL_LETTER == "H";
    assert PETAL_WORLD == "HIVE";
    assert REALM == 0;
}
