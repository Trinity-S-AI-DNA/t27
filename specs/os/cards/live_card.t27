// SPDX-License-Identifier: Apache-2.0
// specs/os/cards/live_card.t27 -- the THIRD card of the T27 OS petal menu: the T27F Live page,
// the Queen live screen. Card for gHashTag/t27#11780 (L7 of the T27 OS epic gHashTag/t27#10782);
// the grid it joins is specs/os/home.t27. A card is a POINTER, not a copy: it names the widget
// that already exists, where its law lives, and where it runs. FR-001: this file names the law
// home and the live URL and restates NO rule of the widget -- the SSE wire, the coalescing, the
// HUD scene and the work graph belong to the law, and nothing here copies them.
//
// WHICH PETAL: petal 7, letter H, world HIVE, realm RAZUM. Read from the petal-menu law that
// home.t27 names (gHashTag/t27 specs/t27f/petal_menu.t27, module T27fPetalMenu) at the master sha
// pinned below: the law numbers the petals by the 27 agent letters, so petal p is letter p + 1
// (petal 7 is H) and WORLD_NAMES index 7 is "HIVE"; the law places a petal with petal / 9, so
// 7 / 9 == 0 == REALM_RAZUM (the outer ring, petals 0-8, the Archetypal agents A-I). WHY HIVE and
// not QUEEN: the live screen is the view OF the agents at work, and HIVE names exactly that --
// the swarm under the Queen. The Queen's own petal is 16 (world QUEEN), which is realm MATERIYA,
// outside RAZUM and out of scope for this card's placement; the screen watches the hive, so it
// sits behind the hive petal.
//
// VERIFICATION FACTS, measured 2026-10-23T11:54Z, not assumed:
//   - the law home exists on gHashTag/t27 master a059416c55833a89e68ac675dd9c416a4b5bff91:
//     git ls-tree origin/master names specs/t27f/live_mode.t27 (M4 of T27F Live, issue
//     gHashTag/t27#11778: live mode over SSE, one event the next painted frame),
//     specs/t27f/live_stream.t27 (the SSE wire: sequence numbers, keyframes, resume),
//     specs/t27f/hud.t27 (M3, issue gHashTag/t27#10262, foundation gHashTag/t27#11752: the HUD
//     as a pure function of the work graph) and specs/t27f/work_graph.t27 (the graph they share).
//   - the live URL is DARK: curl -s -o /dev/null -w "%{http_code}" -L https://t27.ai/t27f/live/
//     answered 404 (the same without -L, so it is no redirect artifact). The loader page has not
//     shipped -- the M3/M4 loader landing is tracked in gHashTag/trinity. FR-002 is about the LAW
//     home, not the page: the law exists on the cited sha, so the card may point; and the card
//     says the page is dark out loud (LIVE_STATE) instead of hiding it, because a pointer to a
//     dark URL that stays silent is a card that lies.
//
// A card whose law moved must be re-measured and re-pointed; a card whose page went dark must
// have LIVE_HTTP_STATUS and LIVE_STATE re-measured and corrected -- never deleted.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_card_live;

pub const ID : str = "t27os-card-live";

pub const CARD_INDEX : u32 = 2;         // third card of gHashTag/t27#11780

pub const PETAL : u32 = 7;              // letter H, world HIVE
pub const PETAL_LETTER : str = "H";
pub const PETAL_WORLD : str = "HIVE";
pub const REALM : u32 = 0;              // RAZUM, the outer ring, petals 0-8
pub const REALM_NAME : str = "RAZUM";

pub const LAW_REPO : str = "Trinity-S-AI-DNA/t27";
pub const LAW_HOME : str = "Trinity-S-AI-DNA/t27:specs/t27f/live_mode.t27";
pub const LAW_HOME_STREAM : str = "Trinity-S-AI-DNA/t27:specs/t27f/live_stream.t27";
pub const LAW_HOME_HUD : str = "Trinity-S-AI-DNA/t27:specs/t27f/hud.t27";
pub const LAW_SHA : str = "a059416c55833a89e68ac675dd9c416a4b5bff91";

pub const LIVE_URL : str = "https://t27.ai/t27f/live/";
pub const LIVE_HTTP_STATUS : u32 = 404; // measured 2026-10-23T11:54Z, curl -L and no-redirect
pub const LIVE_STATE : str = "dark: the loader page has not shipped (M3 in flight)";
pub const VERIFIED_AT : str = "2026-10-23";

// --- facts that can independently be false (t27os#13) ---
// The checks that stood here asserted each constant equals the literal it was defined with,
// which cannot fail (the corpus's vacuous class, T730). These relate two facts, or check a
// fact's shape, each with negative controls. What they cannot see: whether the law file exists
// on LAW_SHA or what the URL answers today -- t27c tests have no file system or network; those
// were measured by hand (header above) and must be re-measured, not believed. The helpers mirror
// specs/os/lab.t27 starts_with/ends_with because t27os specs compile standalone on the lab.

fn starts_with(s: str, p: str) -> bool {
    if (p.len > s.len) { return false; }
    var i : usize = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn ends_with(s: str, p: str) -> bool {
    if (p.len > s.len) { return false; }
    const off : usize = s.len - p.len;
    var i : usize = 0;
    while (i < p.len) {
        if (s[off + i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// A full git sha: exactly 40 lowercase hex digits.
pub fn is_sha40(s: str) -> bool {
    if (s.len != 40) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        const c : u8 = s[i];
        if ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) { i = i + 1; } else { return false; }
    }
    return true;
}

/// A law home is "<repo>:specs/<path>.t27" in the card's own LAW_REPO.
pub fn is_law_home_in(home: str, repo: str) -> bool {
    if (home.len <= repo.len + 11) { return false; }
    if (starts_with(home, repo) == false) { return false; }
    if (home[repo.len] != 58) { return false; }
    var i : usize = 0;
    const p : str = "specs/";
    while (i < p.len) {
        if (home[repo.len + 1 + i] != p[i]) { return false; }
        i = i + 1;
    }
    return ends_with(home, ".t27");
}

/// An HTTP answer that means the page runs: 2xx only (a 3xx was followed by curl -L).
pub fn answered(status: u32) -> bool {
    return status >= 200 and status < 300;
}

/// YYYY-MM-DD with digits where digits belong and dashes at 4 and 7.
pub fn is_iso_date(d: str) -> bool {
    if (d.len != 10) { return false; }
    var i : usize = 0;
    while (i < 10) {
        const c : u8 = d[i];
        if (i == 4 or i == 7) {
            if (c != 45) { return false; }
        } else {
            if (c < 48 or c > 57) { return false; }
        }
        i = i + 1;
    }
    return true;
}

test the_helpers_refuse_the_wrong_shapes {
    assert is_sha40("A059416C55833A89E68AC675DD9C416A4B5BFF91") == false;
    assert is_sha40("a059416c55833a89e68ac675dd9c416a4b5bff9") == false;
    assert is_sha40("g059416c55833a89e68ac675dd9c416a4b5bff91") == false;
    assert is_law_home_in("gHashTag/t27:specs/t27f/x.rs", "gHashTag/t27") == false;
    assert is_law_home_in("gHashTag/t27x:specs/t27f/x.t27", "gHashTag/t27") == false;
    assert is_law_home_in("gHashTag/t27:docs/x.t27", "gHashTag/t27") == false;
    assert is_law_home_in("gHashTag/t27:specs/.t27", "gHashTag/t27") == false;
    assert answered(404) == false;
    assert answered(301) == false;
    assert answered(500) == false;
    assert is_iso_date("2026-1-23") == false;
    assert is_iso_date("23-10-2026") == false;
    assert is_iso_date("2026/10/23") == false;
}

/// The realm placement is the petal-menu law's own rule (petal / 9) applied to this card's petal.
/// Edit PETAL or REALM alone and this refuses; the two facts must move together.
test the_petal_lands_in_the_realm_the_card_names {
    assert PETAL < 27;
    assert PETAL / 9 == REALM;
    assert PETAL_LETTER.len == 1;
    // negative control: the neighbouring ring would not match
    assert (PETAL + 9) / 9 != REALM;
}

/// FR-001: all three law homes are distinct .t27 specs under specs/ of LAW_REPO, on a full sha.
test the_law_homes_are_t27_specs_in_the_law_repo {
    assert is_law_home_in(LAW_HOME, LAW_REPO);
    assert is_law_home_in(LAW_HOME_STREAM, LAW_REPO);
    assert is_law_home_in(LAW_HOME_HUD, LAW_REPO);
    assert LAW_HOME != LAW_HOME_STREAM;
    assert LAW_HOME != LAW_HOME_HUD;
    assert LAW_HOME_STREAM != LAW_HOME_HUD;
    assert is_sha40(LAW_SHA);
    assert starts_with(ID, "t27os-card-");
}

/// The dark state is stated, not hidden: the number and the sentence must agree. A non-2xx status
/// needs a LIVE_STATE that says "dark"; a 2xx with a "dark" sentence would be a lie the other way.
/// Re-measure and move both together, never delete.
test the_dark_status_and_the_dark_sentence_agree {
    assert answered(LIVE_HTTP_STATUS) == false;
    assert starts_with(LIVE_STATE, "dark");
    assert starts_with(LIVE_URL, "https://");
    assert is_iso_date(VERIFIED_AT);
}
