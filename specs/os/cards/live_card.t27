// SPDX-License-Identifier: Apache-2.0
// specs/os/cards/live_card.t27 -- the THIRD card of the T27 OS petal menu: the T27F Live page,
// the Queen live screen. Card for gHashTag/t27#11780 (L7 of the T27 OS epic gHashTag/t27#10782);
// the grid it joins is specs/os/home.t27. A card is a POINTER, not a copy: it names the widget
// that already exists, where its law lives, and where it runs. FR-001: this file names the law
// home and the live URL and restates NO rule of the widget -- the SSE wire, the coalescing, the
// HUD scene and the work graph belong to the law, and nothing here copies them.
//
// WHICH PETAL: petal 7, letter H, world HIVE, realm RAZUM. Read from the petal-menu law that
// home.t27 names (gHashTag/t27 specs/t27f/petal_menu.t27, module T27fPetalMenu) at the master sha
// pinned below: the law numbers the petals by the 27 agent letters, so petal p is letter p + 1
// (petal 7 is H) and WORLD_NAMES index 7 is "HIVE"; the law places a petal with petal / 9, so
// 7 / 9 == 0 == REALM_RAZUM (the outer ring, petals 0-8, the Archetypal agents A-I). WHY HIVE and
// not QUEEN: the live screen is the view OF the agents at work, and HIVE names exactly that --
// the swarm under the Queen. The Queen's own petal is 16 (world QUEEN), which is realm MATERIYA,
// outside RAZUM and out of scope for this card's placement; the screen watches the hive, so it
// sits behind the hive petal.
//
// VERIFICATION FACTS, measured 2026-10-23T11:54Z, not assumed:
//   - the law home exists on gHashTag/t27 master a059416c55833a89e68ac675dd9c416a4b5bff91:
//     git ls-tree origin/master names specs/t27f/live_mode.t27 (M4 of T27F Live, issue
//     gHashTag/t27#11778: live mode over SSE, one event the next painted frame),
//     specs/t27f/live_stream.t27 (the SSE wire: sequence numbers, keyframes, resume),
//     specs/t27f/hud.t27 (M3, issue gHashTag/t27#10262, foundation gHashTag/t27#11752: the HUD
//     as a pure function of the work graph) and specs/t27f/work_graph.t27 (the graph they share).
//   - the live URL is DARK: curl -s -o /dev/null -w "%{http_code}" -L https://t27.ai/t27f/live/
//     answered 404 (the same without -L, so it is no redirect artifact). The loader page has not
//     shipped -- the M3/M4 loader landing is tracked in gHashTag/trinity. FR-002 is about the LAW
//     home, not the page: the law exists on the cited sha, so the card may point; and the card
//     says the page is dark out loud (LIVE_STATE) instead of hiding it, because a pointer to a
//     dark URL that stays silent is a card that lies.
//
// A card whose law moved must be re-measured and re-pointed; a card whose page went dark must
// have LIVE_HTTP_STATUS and LIVE_STATE re-measured and corrected -- never deleted.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_card_live;

pub const ID : str = "t27os-card-live";

pub const CARD_INDEX : u32 = 2;         // third card of gHashTag/t27#11780

pub const PETAL : u32 = 7;              // letter H, world HIVE
pub const PETAL_LETTER : str = "H";
pub const PETAL_WORLD : str = "HIVE";
pub const REALM : u32 = 0;              // RAZUM, the outer ring, petals 0-8
pub const REALM_NAME : str = "RAZUM";

pub const LAW_REPO : str = "Trinity-S-AI-DNA/t27";
pub const LAW_HOME : str = "Trinity-S-AI-DNA/t27:specs/t27f/live_mode.t27";
pub const LAW_HOME_STREAM : str = "Trinity-S-AI-DNA/t27:specs/t27f/live_stream.t27";
pub const LAW_HOME_HUD : str = "Trinity-S-AI-DNA/t27:specs/t27f/hud.t27";
pub const LAW_SHA : str = "a059416c55833a89e68ac675dd9c416a4b5bff91";

pub const LIVE_URL : str = "https://t27.ai/t27f/live/";
pub const LIVE_HTTP_STATUS : u32 = 404; // measured 2026-10-23T11:54Z, curl -L and no-redirect
pub const LIVE_STATE : str = "dark: the loader page has not shipped (M3 in flight)";
pub const VERIFIED_AT : str = "2026-10-23";

/// The realm placement is the petal-menu law's own rule (petal / 9) applied to this card's petal:
/// petal 7 lands in the outer ring. Edit PETAL to a petal outside RAZUM and this refuses.
invariant the_card_sits_behind_the_hive_petal_of_razum {
    assert PETAL == 7;
    assert PETAL / 9 == REALM;
    assert PETAL < 9;
    assert REALM_NAME == "RAZUM";
    assert PETAL_WORLD == "HIVE";
}

/// FR-001, pinned: the card names exactly the law paths that were verified to exist on the cited
/// master sha. Edit a path and the card stops compiling -- a moved law must be re-verified first.
invariant the_law_home_is_pinned_to_the_verified_master_sha {
    assert LAW_REPO == "Trinity-S-AI-DNA/t27";
    assert LAW_HOME == "Trinity-S-AI-DNA/t27:specs/t27f/live_mode.t27";
    assert LAW_HOME_STREAM == "Trinity-S-AI-DNA/t27:specs/t27f/live_stream.t27";
    assert LAW_HOME_HUD == "Trinity-S-AI-DNA/t27:specs/t27f/hud.t27";
    assert LAW_SHA == "a059416c55833a89e68ac675dd9c416a4b5bff91";
}

/// The dark state is stated, not hidden. The page answered 404 when this card was written and the
/// card records both halves: the number, and the sentence that names the loader as the missing
/// piece. A 200 here without the loader shipped would be a lie the other way -- both must move
/// together, re-measured, never deleted.
invariant the_dark_state_is_stated_not_hidden {
    assert LIVE_URL == "https://t27.ai/t27f/live/";
    assert LIVE_HTTP_STATUS == 404;
    assert LIVE_HTTP_STATUS != 200;
    assert LIVE_STATE == "dark: the loader page has not shipped (M3 in flight)";
    assert VERIFIED_AT == "2026-10-23";
}

/// The card is the third of the #11780 cards and keeps its identity.
invariant the_card_is_the_third_card_of_the_issue {
    assert CARD_INDEX == 2;
    assert ID == "t27os-card-live";
}

test the_pointer_facts_carry_the_card_identity {
    assert ID == "t27os-card-live";
    assert PETAL_LETTER == "H";
    assert PETAL_WORLD == "HIVE";
    assert REALM == 0;
    assert CARD_INDEX == 2;
}
