// SPDX-License-Identifier: Apache-2.0
// specs/os/cards/graph_card.t27 -- the FIRST card of the T27 OS petal menu: the work-graph page.
// Card for gHashTag/t27#11780 (L7 of the T27 OS epic gHashTag/t27#10782); the grid it joins is
// specs/os/home.t27. A card is a POINTER, not a copy: it names the widget that already exists,
// where its law lives, and where it runs. FR-001: this file names the law home and the live URL
// and restates NO rule of the widget -- the layout, the colours, the node and edge rules belong
// to the law, and nothing here copies them.
//
// WHICH PETAL: petal 12, letter M, world MAP, realm MATERIYA. Read from the petal-menu law that
// home.t27 names (gHashTag/t27 specs/t27f/petal_menu.t27, module T27fPetalMenu) at the master sha
// pinned below: WORLD_NAMES index 12 is "MAP", and the law places a petal with petal / 9, so
// 12 / 9 == 1 == REALM_MATERIYA (the middle ring, petals 9-17). The graph page is the map of the
// spec corpus, which is why it sits behind MAP.
//
// VERIFICATION FACTS, measured 2026-10-23T11:32Z, not assumed:
//   - the law home exists on gHashTag/t27 master a059416c55833a89e68ac675dd9c416a4b5bff91:
//     git ls-tree origin/master names BOTH specs/t27f/spec_graph_view.t27 (the T27F graph view:
//     a deterministic layout of a spec graph) and specs/t27f/spec_graph.t27 (the graph it lays
//     out); `git show` of the view file opens with its own header confirming what it is.
//   - the live URL answered HTTP 200 when curled today:
//     curl -s -o /dev/null -w "%{http_code}" -L https://t27.ai/t27f/graph/  ->  200
//     and the page's own <title> names the law: "T27F graph view of a .t27 spec".
// A card whose law moved or whose URL went dark must be re-measured and re-pointed, not believed.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_card_graph;

pub const ID : str = "t27os-card-graph";

pub const PETAL : u32 = 12;             // letter M, world MAP
pub const PETAL_LETTER : str = "M";
pub const PETAL_WORLD : str = "MAP";
pub const REALM : u32 = 1;              // MATERIYA, the middle ring, petals 9-17
pub const REALM_NAME : str = "MATERIYA";

pub const LAW_REPO : str = "gHashTag/t27";
pub const LAW_HOME : str = "gHashTag/t27:specs/t27f/spec_graph_view.t27";
pub const LAW_HOME_GRAPH : str = "gHashTag/t27:specs/t27f/spec_graph.t27";
pub const LAW_SHA : str = "a059416c55833a89e68ac675dd9c416a4b5bff91";

pub const LIVE_URL : str = "https://t27.ai/t27f/graph/";
pub const LIVE_HTTP_STATUS : u32 = 200; // measured 2026-10-23T11:32Z, curl -L
pub const VERIFIED_AT : str = "2026-10-23";

// --- facts that can independently be false (t27os#13) ---
// The checks that stood here asserted each constant equals the literal it was defined with,
// which cannot fail (the corpus's vacuous class, T730). These relate two facts, or check a
// fact's shape, each with negative controls. What they cannot see: whether the law file exists
// on LAW_SHA or what the URL answers today -- t27c tests have no file system or network; those
// were measured by hand (header above) and must be re-measured, not believed. The helpers mirror
// specs/os/lab.t27 starts_with/ends_with because t27os specs compile standalone on the lab.

fn starts_with(s: str, p: str) -> bool {
    if (p.len > s.len) { return false; }
    var i : usize = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn ends_with(s: str, p: str) -> bool {
    if (p.len > s.len) { return false; }
    const off : usize = s.len - p.len;
    var i : usize = 0;
    while (i < p.len) {
        if (s[off + i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// A full git sha: exactly 40 lowercase hex digits.
pub fn is_sha40(s: str) -> bool {
    if (s.len != 40) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        const c : u8 = s[i];
        if ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) { i = i + 1; } else { return false; }
    }
    return true;
}

/// A law home is "<repo>:specs/<path>.t27" in the card's own LAW_REPO.
pub fn is_law_home_in(home: str, repo: str) -> bool {
    if (home.len <= repo.len + 11) { return false; }
    if (starts_with(home, repo) == false) { return false; }
    if (home[repo.len] != 58) { return false; }
    var i : usize = 0;
    const p : str = "specs/";
    while (i < p.len) {
        if (home[repo.len + 1 + i] != p[i]) { return false; }
        i = i + 1;
    }
    return ends_with(home, ".t27");
}

/// An HTTP answer that means the page runs: 2xx only (a 3xx was followed by curl -L).
pub fn answered(status: u32) -> bool {
    return status >= 200 and status < 300;
}

/// YYYY-MM-DD with digits where digits belong and dashes at 4 and 7.
pub fn is_iso_date(d: str) -> bool {
    if (d.len != 10) { return false; }
    var i : usize = 0;
    while (i < 10) {
        const c : u8 = d[i];
        if (i == 4 or i == 7) {
            if (c != 45) { return false; }
        } else {
            if (c < 48 or c > 57) { return false; }
        }
        i = i + 1;
    }
    return true;
}

test the_helpers_refuse_the_wrong_shapes {
    assert is_sha40("A059416C55833A89E68AC675DD9C416A4B5BFF91") == false;
    assert is_sha40("a059416c55833a89e68ac675dd9c416a4b5bff9") == false;
    assert is_sha40("g059416c55833a89e68ac675dd9c416a4b5bff91") == false;
    assert is_law_home_in("gHashTag/t27:specs/t27f/x.rs", "gHashTag/t27") == false;
    assert is_law_home_in("gHashTag/t27x:specs/t27f/x.t27", "gHashTag/t27") == false;
    assert is_law_home_in("gHashTag/t27:docs/x.t27", "gHashTag/t27") == false;
    assert is_law_home_in("gHashTag/t27:specs/.t27", "gHashTag/t27") == false;
    assert answered(404) == false;
    assert answered(301) == false;
    assert answered(500) == false;
    assert is_iso_date("2026-1-23") == false;
    assert is_iso_date("23-10-2026") == false;
    assert is_iso_date("2026/10/23") == false;
}

/// The realm placement is the petal-menu law's own rule (petal / 9) applied to this card's petal.
/// Edit PETAL or REALM alone and this refuses; the two facts must move together.
test the_petal_lands_in_the_realm_the_card_names {
    assert PETAL < 27;
    assert PETAL / 9 == REALM;
    assert PETAL_LETTER.len == 1;
    // negative control: the neighbouring ring would not match
    assert (PETAL + 9) / 9 != REALM;
}

/// FR-001: both law homes sit under specs/ of the card's own LAW_REPO, as .t27 files, and the
/// sha they were verified on is a full sha -- a short or mistyped pin is refused.
test the_law_homes_are_t27_specs_in_the_law_repo {
    assert is_law_home_in(LAW_HOME, LAW_REPO);
    assert is_law_home_in(LAW_HOME_GRAPH, LAW_REPO);
    assert LAW_HOME != LAW_HOME_GRAPH;
    assert is_sha40(LAW_SHA);
    assert starts_with(ID, "t27os-card-");
}

/// The card claims the widget runs, so the measured status must be a 2xx; a dark page must be
/// re-measured and carried as dark (see live_card.t27), never claimed here.
test the_measured_status_backs_the_live_claim {
    assert answered(LIVE_HTTP_STATUS);
    assert starts_with(LIVE_URL, "https://");
    assert ends_with(LIVE_URL, "/");
    assert is_iso_date(VERIFIED_AT);
}
