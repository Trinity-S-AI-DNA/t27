// SPDX-License-Identifier: Apache-2.0
// specs/os/cards/graph_card.t27 -- the FIRST card of the T27 OS petal menu: the work-graph page.
// Card for gHashTag/t27#11780 (L7 of the T27 OS epic gHashTag/t27#10782); the grid it joins is
// specs/os/home.t27. A card is a POINTER, not a copy: it names the widget that already exists,
// where its law lives, and where it runs. FR-001: this file names the law home and the live URL
// and restates NO rule of the widget -- the layout, the colours, the node and edge rules belong
// to the law, and nothing here copies them.
//
// WHICH PETAL: petal 12, letter M, world MAP, realm MATERIYA. Read from the petal-menu law that
// home.t27 names (gHashTag/t27 specs/t27f/petal_menu.t27, module T27fPetalMenu) at the master sha
// pinned below: WORLD_NAMES index 12 is "MAP", and the law places a petal with petal / 9, so
// 12 / 9 == 1 == REALM_MATERIYA (the middle ring, petals 9-17). The graph page is the map of the
// spec corpus, which is why it sits behind MAP.
//
// VERIFICATION FACTS, measured 2026-10-23T11:32Z, not assumed:
//   - the law home exists on gHashTag/t27 master a059416c55833a89e68ac675dd9c416a4b5bff91:
//     git ls-tree origin/master names BOTH specs/t27f/spec_graph_view.t27 (the T27F graph view:
//     a deterministic layout of a spec graph) and specs/t27f/spec_graph.t27 (the graph it lays
//     out); `git show` of the view file opens with its own header confirming what it is.
//   - the live URL answered HTTP 200 when curled today:
//     curl -s -o /dev/null -w "%{http_code}" -L https://t27.ai/t27f/graph/  ->  200
//     and the page's own <title> names the law: "T27F graph view of a .t27 spec".
// A card whose law moved or whose URL went dark must be re-measured and re-pointed, not believed.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os_card_graph;

pub const ID : str = "t27os-card-graph";

pub const PETAL : u32 = 12;             // letter M, world MAP
pub const PETAL_LETTER : str = "M";
pub const PETAL_WORLD : str = "MAP";
pub const REALM : u32 = 1;              // MATERIYA, the middle ring, petals 9-17
pub const REALM_NAME : str = "MATERIYA";

pub const LAW_REPO : str = "gHashTag/t27";
pub const LAW_HOME : str = "gHashTag/t27:specs/t27f/spec_graph_view.t27";
pub const LAW_HOME_GRAPH : str = "gHashTag/t27:specs/t27f/spec_graph.t27";
pub const LAW_SHA : str = "a059416c55833a89e68ac675dd9c416a4b5bff91";

pub const LIVE_URL : str = "https://t27.ai/t27f/graph/";
pub const LIVE_HTTP_STATUS : u32 = 200; // measured 2026-10-23T11:32Z, curl -L
pub const VERIFIED_AT : str = "2026-10-23";

/// The realm placement is the petal-menu law's own rule (petal / 9) applied to this card's petal:
/// petal 12 lands in the middle ring. Edit PETAL to a petal outside MATERIYA and this refuses.
invariant the_card_sits_behind_the_map_petal_of_materiya {
    assert PETAL == 12;
    assert PETAL / 9 == REALM;
    assert PETAL >= 9 and PETAL <= 17;
    assert REALM_NAME == "MATERIYA";
}

/// FR-001, pinned: the card names exactly the law paths that were verified to exist on the cited
/// master sha. Edit a path and the card stops compiling -- a moved law must be re-verified first.
invariant the_law_home_is_pinned_to_the_verified_master_sha {
    assert LAW_REPO == "gHashTag/t27";
    assert LAW_HOME == "gHashTag/t27:specs/t27f/spec_graph_view.t27";
    assert LAW_HOME_GRAPH == "gHashTag/t27:specs/t27f/spec_graph.t27";
    assert LAW_SHA == "a059416c55833a89e68ac675dd9c416a4b5bff91";
}

/// The URL is the graph page, and it was LIVE (HTTP 200) when this card was written. A dark URL
/// must be re-measured and the status corrected here before the card may claim the widget runs.
invariant the_live_url_is_the_graph_page_and_it_answered_200 {
    assert LIVE_URL == "https://t27.ai/t27f/graph/";
    assert LIVE_HTTP_STATUS == 200;
    assert VERIFIED_AT == "2026-10-23";
}

test the_pointer_facts_carry_the_card_identity {
    assert ID == "t27os-card-graph";
    assert PETAL_LETTER == "M";
    assert PETAL_WORLD == "MAP";
    assert REALM == 1;
}
