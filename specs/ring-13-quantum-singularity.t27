// Performance benchmark
bench enhanced_chat_performance {
    const iterations: u32 = 100;
    const start_time: u64 = @as(u64, @intCast(@time()));

    // Benchmark message creation
    for (var i: u32 = 0; i < iterations; i += 1) {
        const message: EnhancedMessage = create_message(
            MessageType.UserInput,
            @concat("Test message ", @toString(i)),
            "benchmark_session",
            "benchmark_user",
            ["test"]
        );
    }

    const end_time: u64 = @as(u64, @intCast(@time()));
    const duration: u64 = end_time - start_time;

    log_message(@concat("📊 Performance benchmark: ", @toString(iterations), " messages in ", @toString(duration), "ms"));

    // Assert reasonable performance
    assert duration / iterations < 100;  // Less than 100ms per message

    record_experience("Enhanced chat performance benchmark completed");
}