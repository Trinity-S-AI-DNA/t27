// SPDX-License-Identifier: Apache-2.0
; specs/golden/golden_spiral.t27 — Golden Spiral: visual identity of Trinity
; Brand layer, part of GOLDEN OPERATING SYSTEM
; Closes #12913
; phi^2 + 1/phi^2 = 3 | TRINITY

module GoldenSpiral;

pub const SPIRAL_NAME : str = "Golden Spiral";
pub const SPIRAL_LAYER : str = "IDENTITY";
pub const SPIRAL_ROLE : str = "Visual identity of the Golden Series: 27-petal logo, formulas orbiting on a golden spiral at golden angle 360/φ² degrees.";
pub const SPIRAL_STATUS : str = "brand, not a scientific layer";

pub const GOLDEN_ANGLE : str = "360 / φ² degrees";
pub const PETAL_COUNT : u32 = 27;

pub const VISUAL_ELEMENTS : [str] = [
    "27-petal logo in the centre.",
    "Owner's formulas floating around as in zero gravity, drifting outward on a golden spiral.",
    "Formulas pushed aside softly by the pointer.",
    "Black ground, matte glass, formulas in white at reading size.",
    "Clicking a formula opens its card: expression, predicted and measured value, deviation, source (CODATA or PDG), and the paper.",
];

pub const MOTION_LAW : str = "Spiral radius, angular speed, drift, pointer push and limits live in one .t27 spec with tests; no hand-written animation logic in TS, Swift or Verilog.";

pub const CALMNESS_RULE : str = "Formulas never cover the logo or petals' hit areas, never overlap each other, and slow down near the pointer instead of fleeing; respect reduced-motion settings.";

; ----------------------------------------------------------------
; Tests
; ----------------------------------------------------------------

test spiral_has_role {
    assert(SPIRAL_ROLE.len > 0);
};

test petal_count_is_27 {
    assert(PETAL_COUNT == 27);
};

test golden_angle_exists {
    assert(GOLDEN_ANGLE.len > 0);
};

test visual_elements_exist {
    assert(VISUAL_ELEMENTS.len == 5);
};
