// SPDX-License-Identifier: Apache-2.0
; specs/golden/series.t27 — THE GOLDEN SERIES manifest
; Two-layer architecture: GOLDEN TRIAD (scientific articles) + GOLDEN OPERATING SYSTEM (engineering mechanisms)
; Closes #12913
; phi^2 + 1/phi^2 = 3 | TRINITY

module GoldenSeries;

; ----------------------------------------------------------------
; Series identity
; ----------------------------------------------------------------

pub const SERIES_NAME : str = "THE GOLDEN SERIES";
pub const SERIES_SUBTITLE : str = "Trinity S³AI / t27";
pub const SERIES_THESIS : str = "One numeric and specification chain from mathematics to bit-exact silicon.";
pub const SERIES_SYMBOL : str = "φ² + 1/φ² = 3";
pub const SERIES_PRINCIPLE : str = "No claim without a receipt.";

; ----------------------------------------------------------------
; Layer taxonomy
; ----------------------------------------------------------------

pub const Layer = enum(u8) {
    NUMBERS,
    VERIFICATION,
    EXECUTION,
    INTEGRITY,
    OPERATIONS,
    PUBLICATION,
    IDENTITY,
}

pub const GoldenSystem = struct {
    name : str,
    layer : Layer,
    role : str,
    status : str,   // "scientific-article" | "engineering-mechanism" | "brand"
    anchor : str,   // arxiv URL or repo path or internal spec
}

pub const GOLDEN_SYSTEM : [8]GoldenSystem = [
    GoldenSystem {
        .name = "GoldenFloat",
        .layer = Layer.NUMBERS,
        .role = "One phi-derived rule for the GF4–GF1024 floating-point family.",
        .status = "scientific-article",
        .anchor = "https://arxiv.org/abs/2606.05017",
    },
    GoldenSystem {
        .name = "Golden Ruler",
        .layer = Layer.VERIFICATION,
        .role = "Bit-exact conformance vectors across numeric formats.",
        .status = "scientific-article",
        .anchor = "https://arxiv.org/abs/2606.09686",
    },
    GoldenSystem {
        .name = "GOLDEN CHAIN",
        .layer = Layer.EXECUTION,
        .role = "One `.t27` contract becomes sealed software, tests, Zig/C/Verilog artifacts, and reproducible FPGA evidence.",
        .status = "scientific-article",
        .anchor = "specs/golden/article3_golden_chain.t27",
    },
    GoldenSystem {
        .name = "Golden Invariant",
        .layer = Layer.INTEGRITY,
        .role = "φ² + 1/φ² = 3 as a SHA-256 fingerprint of the numeric core.",
        .status = "engineering-mechanism",
        .anchor = "specs/golden/golden_invariant.t27",
    },
    GoldenSystem {
        .name = "Golden Oracle",
        .layer = Layer.VERIFICATION,
        .role = "Bit-for-bit referee for decoders and hardware number paths.",
        .status = "engineering-mechanism",
        .anchor = "specs/golden/golden_oracle.t27",
    },
    GoldenSystem {
        .name = "Golden Head",
        .layer = Layer.OPERATIONS,
        .role = "Canonical local head before GitHub mirroring (refs/golden/head).",
        .status = "engineering-mechanism",
        .anchor = "specs/golden/golden_head.t27",
    },
    GoldenSystem {
        .name = "Golden Foundry",
        .layer = Layer.PUBLICATION,
        .role = "Measured results with explicit limits and denominators.",
        .status = "engineering-mechanism",
        .anchor = "specs/golden/golden_foundry.t27",
    },
    GoldenSystem {
        .name = "Golden Spiral",
        .layer = Layer.IDENTITY,
        .role = "The 27-petal visual language of Trinity on t27.ai.",
        .status = "brand",
        .anchor = "specs/golden/golden_spiral.t27"
    }
]

pub const SERIES_GRAPH : str = "GoldenFloat → Golden Ruler → GOLDEN CHAIN   numbers → verification → silicon evidence";

; ----------------------------------------------------------------
; Triad (scientific articles)
; ----------------------------------------------------------------

pub const GOLDEN_TRIAD : [3]str = [
    "GoldenFloat — Numbers",
    "Golden Ruler — Verification",
    "GOLDEN CHAIN — Execution"
]

pub const TRIAD_FORMULA : str = "GoldenFloat defines the number. Golden Ruler proves the number. GOLDEN CHAIN executes the number. Golden Invariant remembers it.";

; ----------------------------------------------------------------
; Mandatory blocks per article
; ----------------------------------------------------------------

pub const MANDATORY_BLOCKS : [7]str = [
    "Series header: THE GOLDEN SERIES — Article N of 3",
    "One-line claim: what is proven.",
    "Receipts: SHA-256, commit, tests, board/DNA, dates.",
    "Limits: what the result does not establish.",
    "Golden invariant: φ² + 1/φ² = 3.",
    "Series graph: GoldenFloat → Golden Ruler → GOLDEN CHAIN.",
    "Golden invariant: φ² + 1/φ² = 3."
]

; ----------------------------------------------------------------
; Tests
; ----------------------------------------------------------------

test series_has_eight_members {
    assert(GOLDEN_SYSTEM.len == 8);
}

test triad_has_three_articles {
    assert(GOLDEN_TRIAD.len == 3);
}

test each_member_has_anchor {
    for (GOLDEN_SYSTEM) |g| {
        assert(g.anchor.len > 0);
        assert(g.role.len > 0);
        assert(g.status.len > 0);
    }
}

test golden_invariant_is_phi {
    assert(SERIES_SYMBOL == "φ² + 1/φ² = 3");
}

test series_graph_is_directional {
    assert(SERIES_GRAPH.len > 0);
}
