// SPDX-License-Identifier: Apache-2.0
; specs/golden/golden_head.t27 — Golden Head: canonical local head before GitHub mirroring
; Engineering mechanism, part of GOLDEN OPERATING SYSTEM
; Closes #12913
; phi^2 + 1/phi^2 = 3 | TRINITY

module GoldenHead;

pub const HEAD_NAME : str = "Golden Head";
pub const HEAD_LAYER : str = "OPERATIONS";
pub const HEAD_ROLE : str = "Canonical local head of the repository before GitHub becomes a mirror and window, not the source of truth.";
pub const HEAD_STATUS : str = "engineering-mechanism, operational";

pub const HEAD_REF : str = "refs/golden/head";
pub const HEAD_MECHANISM : str = "compare-and-swap landing on local golden head, then batched push to GitHub";

pub const DESCRIPTION : str = [
    "Work lands first on the local golden head via compare-and-swap.",
    "GitHub receives one batched push per 15-minute window, not one per commit.",
    "GitHub is a mirror and a window, not the truth.",
];

pub const ACCELERATION_REASON : str = "A plain push restarts every required check at the back of an Actions queue of 800-900 runs. Golden Head judges change by verdicts locally and talks to GitHub once per batch.";

; ----------------------------------------------------------------
; Tests
; ----------------------------------------------------------------

test head_ref_is_golden_head {
    assert(HEAD_REF == "refs/golden/head");
};

test head_has_role {
    assert(HEAD_ROLE.len > 0);
};

test mechanism_has_three_points {
    assert(DESCRIPTION.len == 3);
};

test acceleration_reason_exists {
    assert(ACCELERATION_REASON.len > 0);
};
