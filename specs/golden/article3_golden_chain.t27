// SPDX-License-Identifier: Apache-2.0
; specs/golden/article3_golden_chain.t27 — GOLDEN CHAIN: Article 3 of THE GOLDEN SERIES
; Execution layer: one `.t27` contract to sealed silicon evidence
; Closes #12913
; phi^2 + 1/phi^2 = 3 | TRINITY

module GoldenChain;

pub const ARTICLE_NUMBER : u32 = 3;
pub const ARTICLE_NAME : str = "GOLDEN CHAIN: From Numeric Contracts to Bit-Exact Silicon";
pub const ARTICLE_SUBTITLE : str = "The Golden Execution Layer";
pub const SERIES_HEADER : str = "THE GOLDEN SERIES — Article 3 of 3";

pub const ONE_LINE_CLAIM : str = "One `.t27` contract becomes sealed software, Verilog, tests, and reproducible silicon evidence.";

pub const CHAIN_STEPS : [str] = [
    ".t27 specification",
    "→ parse / typecheck",
    "→ conformance vectors",
    "→ SHA-256 seal",
    "→ Zig / C / Verilog artifacts",
    "→ tests and differential verification",
    "→ FPGA synthesis and board receipts",
    "→ Tiny Tapeout reproducibility manifest",
];

pub const SERIES_GRAPH : str = "GoldenFloat → Golden Ruler → GOLDEN CHAIN   numbers → verification → silicon evidence";

pub const RELATIONSHIP_TO_SERIES : str = [
    "GoldenFloat defines the numeric contract: one closed rule for GF4–GF1024 formats.",
    "Golden Ruler defines the verification contract: bit-exact conformance vectors across numeric formats.",
    "GOLDEN CHAIN defines the execution contract: one `.t27` specification becomes sealed artifacts, generated code, tests, RTL, and reproducible silicon evidence.",
];

pub const MANDATORY_BLOCKS : [str] = [
    "1. Industrial Problem",
    "2. Golden Layer",
    "3. Formal Definition",
    "4. Artifacts and Receipts",
    "5. Verification Protocol",
    "6. What Is Proven",
    "7. What Is Not Proven",
    "8. Pareto Roadmap",
    "9. Relationship to the Golden Series",
    "10. Manifesto",
];

pub const MANIFESTO : str = [
    "One numeric rule.",
    "One conformance ruler.",
    "One executable contract.",
    "One chain of receipts.",
    "",
    "No silent divergence.",
    "No hand-editing generated code.",
    "No claim without a receipt.",
    "No silicon claim without a reproducible path.",
];

pub const CONSTITUTIONAL_RULE : str = "No hand-editing generated code. Ever.";

pub const NON_GOALS : [str] = [
    "No claim of fabricated silicon until a die exists.",
    "No claim of model-accuracy superiority without measured evidence.",
    "No manual edits to generated artifacts.",
    "No merge without an issue, PR, seals, conformance checks, and CI.",
];

; ----------------------------------------------------------------
; Tests
; ----------------------------------------------------------------

test article_is_three {
    assert(ARTICLE_NUMBER == 3);
};

test claim_exists {
    assert(ONE_LINE_CLAIM.len > 0);
};

test chain_has_eight_steps {
    assert(CHAIN_STEPS.len == 8);
};

test series_graph_exists {
    assert(SERIES_GRAPH.len > 0);
};

test relationship_has_three_points {
    assert(RELATIONSHIP_TO_SERIES.len == 3);
};

test manifesto_has_nine_lines {
    assert(MANIFESTO.len == 9);
};

test constitutional_rule_exists {
    assert(CONSTITUTIONAL_RULE.len > 0);
};

test non_goals_has_four_items {
    assert(NON_GOALS.len == 4);
};
