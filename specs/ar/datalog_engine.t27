// SPDX-License-Identifier: Apache-2.0
// spec: DatalogEngine
// Datalog reasoning engine for neuro-symbolic AI

use base::types;

spec DatalogEngine {
    // #8980: the spec did not compile (no Trit / ProofTrace in scope, dynamic
    // `push`, tuple returns, unbounded mutual recursion). It is now self-contained:
    //   Trit        -> i8 (-1 False, 0 Unknown, +1 True)
    //   [Fact] etc. -> fixed arrays plus a count (MAX_FACTS, MAX_RULES, ...)
    //   args        -> [MAX_ARGS]string plus nargs
    //   tuples      -> ApplyResult / struct returns
    //   ProofTrace  -> the step operations and outputs, MAX_STEPS bounded
    //   recursion   -> query and apply_rule carry a depth, capped at MAX_DEPTH
    //                  (a rule whose body is its own head used to recurse forever)

    // Maximum number of steps allowed in a proof trace
    const MAX_STEPS: u32 = 10
    // Room for MAX_STEPS plus overflow probes
    const STEP_CAP: u32 = 16

    // Fixed capacities
    const MAX_ARGS: u32 = 3
    const MAX_BODY: u32 = 3
    const MAX_FACTS: u32 = 16
    const MAX_RULES: u32 = 4
    const MAX_ANSWERS: u32 = 16
    // Deepest chain of rule bodies that query will follow
    const MAX_DEPTH: u32 = 4

    // K3 values (AND is min, OR is max)
    const K_FALSE: i8 = -1
    const K_UNKNOWN: i8 = 0
    const K_TRUE: i8 = 1

    // Byte-wise string equality
    fn str_eq(a: string, b: string) -> bool {
        if a.len != b.len {
            return false
        }
        let mut i: usize = 0;
        while i < a.len {
            if a[i] != b[i] {
                return false
            }
            i = i + 1;
        }
        return true
    }

    // Proof trace: the operation and output of each recorded step
    struct ProofTrace {
        ops: [STEP_CAP]string,
        outputs: [STEP_CAP]i8,
        count: u32,
        verified: bool
    }

    fn new_proof_trace() -> ProofTrace {
        return ProofTrace {
            ops: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
            outputs: [0; STEP_CAP],
            count: 0,
            verified: false
        }
    }

    // A full buffer leaves the trace unchanged
    fn add_step(trace: ProofTrace, operation: string, output: i8) -> ProofTrace {
        if trace.count >= STEP_CAP {
            return trace
        }
        let mut new_ops = trace.ops;
        let mut new_outputs = trace.outputs;
        new_ops[trace.count] = operation;
        new_outputs[trace.count] = output;
        return ProofTrace {
            ops: new_ops,
            outputs: new_outputs,
            count: trace.count + 1,
            verified: trace.verified
        }
    }

    fn finalize_trace(trace: ProofTrace) -> ProofTrace {
        return ProofTrace {
            ops: trace.ops,
            outputs: trace.outputs,
            count: trace.count,
            verified: true
        }
    }

    // A trace is valid when it is non-empty and within MAX_STEPS
    fn verify_trace(trace: ProofTrace) -> bool {
        return trace.count > 0 && trace.count <= MAX_STEPS
    }

    // Datalog fact structure
    struct Fact {
        predicate: string,
        args: [MAX_ARGS]string,
        nargs: u32,
        truth_value: i8
    }

    fn no_args() -> [MAX_ARGS]string {
        return ["", "", ""]
    }

    fn blank_fact() -> Fact {
        return Fact { predicate: "", args: no_args(), nargs: 0, truth_value: K_UNKNOWN }
    }

    fn fact0(predicate: string, truth_value: i8) -> Fact {
        return Fact { predicate: predicate, args: no_args(), nargs: 0, truth_value: truth_value }
    }

    fn fact1(predicate: string, a: string, truth_value: i8) -> Fact {
        return Fact { predicate: predicate, args: [a, "", ""], nargs: 1, truth_value: truth_value }
    }

    fn fact2(predicate: string, a: string, b: string, truth_value: i8) -> Fact {
        return Fact { predicate: predicate, args: [a, b, ""], nargs: 2, truth_value: truth_value }
    }

    // Datalog rule structure (head :- body)
    struct Rule {
        head: Fact,
        body: [MAX_BODY]Fact,
        nbody: u32
    }

    fn blank_body() -> [MAX_BODY]Fact {
        let mut slots: [MAX_BODY]Fact = undefined;
        let mut k: u32 = 0;
        while k < MAX_BODY {
            slots[k] = blank_fact();
            k = k + 1;
        }
        return slots
    }

    fn blank_rule() -> Rule {
        return Rule { head: blank_fact(), body: blank_body(), nbody: 0 }
    }

    fn rule1(head: Fact, b0: Fact) -> Rule {
        let mut body = blank_body();
        body[0] = b0;
        return Rule { head: head, body: body, nbody: 1 }
    }

    fn rule2(head: Fact, b0: Fact, b1: Fact) -> Rule {
        let mut body = blank_body();
        body[0] = b0;
        body[1] = b1;
        return Rule { head: head, body: body, nbody: 2 }
    }

    // Datalog database
    struct Database {
        facts: [MAX_FACTS]Fact,
        nfacts: u32,
        rules: [MAX_RULES]Rule,
        nrules: u32
    }

    // Query result
    struct QueryResult {
        answers: [MAX_ANSWERS]Fact,
        nanswers: u32,
        proof_trace: ProofTrace,
        complete: bool
    }

    // Result of apply_rule (a tuple in the Rust-like original)
    struct ApplyResult {
        derived: Fact,
        trace: ProofTrace
    }

    // Create empty database
    fn new_database() -> Database {
        let mut fact_slots: [MAX_FACTS]Fact = undefined;
        let mut i: u32 = 0;
        while i < MAX_FACTS {
            fact_slots[i] = blank_fact();
            i = i + 1;
        }
        let mut rule_slots: [MAX_RULES]Rule = undefined;
        let mut j: u32 = 0;
        while j < MAX_RULES {
            rule_slots[j] = blank_rule();
            j = j + 1;
        }
        return Database {
            facts: fact_slots,
            nfacts: 0,
            rules: rule_slots,
            nrules: 0
        }
    }

    // Add fact to database (a full database is returned unchanged)
    fn add_fact(db: Database, fact: Fact) -> Database {
        if db.nfacts >= MAX_FACTS {
            return db
        }
        let mut new_facts = db.facts;
        new_facts[db.nfacts] = fact;
        return Database {
            facts: new_facts,
            nfacts: db.nfacts + 1,
            rules: db.rules,
            nrules: db.nrules
        }
    }

    // Add rule to database (a full database is returned unchanged)
    fn add_rule(db: Database, rule: Rule) -> Database {
        if db.nrules >= MAX_RULES {
            return db
        }
        let mut new_rules = db.rules;
        new_rules[db.nrules] = rule;
        return Database {
            facts: db.facts,
            nfacts: db.nfacts,
            rules: new_rules,
            nrules: db.nrules + 1
        }
    }

    fn empty_result(trace: ProofTrace) -> QueryResult {
        let mut slots: [MAX_ANSWERS]Fact = undefined;
        let mut i: u32 = 0;
        while i < MAX_ANSWERS {
            slots[i] = blank_fact();
            i = i + 1;
        }
        return QueryResult {
            answers: slots,
            nanswers: 0,
            proof_trace: trace,
            complete: false
        }
    }

    // Query database for matching facts
    fn query(db: Database, q: Fact) -> QueryResult {
        return query_at(db, q, 0)
    }

    // query with the rule-body depth reached so far; past MAX_DEPTH there are no answers
    fn query_at(db: Database, q: Fact, depth: u32) -> QueryResult {
        let mut trace = new_proof_trace();
        let mut result = empty_result(trace);
        if depth > MAX_DEPTH {
            return result
        }
        let mut answers = result.answers;
        let mut n: u32 = 0;

        // Direct fact lookup
        let mut i: u32 = 0;
        while i < db.nfacts {
            let fact = db.facts[i];
            if facts_match(fact, q) {
                if n < MAX_ANSWERS {
                    answers[n] = fact;
                    n = n + 1;
                }
                trace = add_step(trace, "fact_match", fact.truth_value);
            }
            i = i + 1;
        }

        // Rule-based reasoning (bounded by MAX_DEPTH and MAX_STEPS)
        let mut r: u32 = 0;
        while r < db.nrules {
            let rule = db.rules[r];
            if rule_heads_match(rule.head, q) {
                let applied = apply_rule_at(db, rule, trace, depth);
                trace = applied.trace;
                if applied.derived.truth_value != K_FALSE {
                    if n < MAX_ANSWERS {
                        answers[n] = applied.derived;
                        n = n + 1;
                    }
                }
            }
            r = r + 1;
        }

        trace = finalize_trace(trace);

        return QueryResult {
            answers: answers,
            nanswers: n,
            proof_trace: trace,
            complete: verify_trace(trace)
        }
    }

    // Check if two facts match (same predicate, compatible args)
    fn facts_match(a: Fact, b: Fact) -> bool {
        if !str_eq(a.predicate, b.predicate) {
            return false
        }
        if a.nargs != b.nargs {
            return false
        }
        return true
    }

    // Check if rule head matches query
    fn rule_heads_match(head: Fact, q: Fact) -> bool {
        return str_eq(head.predicate, q.predicate) && head.nargs == q.nargs
    }

    // Apply rule to derive new fact
    fn apply_rule(db: Database, rule: Rule, trace: ProofTrace) -> ApplyResult {
        return apply_rule_at(db, rule, trace, 0)
    }

    fn apply_rule_at(db: Database, rule: Rule, trace: ProofTrace, depth: u32) -> ApplyResult {
        let mut current_trace = trace;

        // Check if all body facts are true
        let mut all_body_true = K_TRUE;
        let mut b: u32 = 0;
        while b < rule.nbody && all_body_true == K_TRUE {
            let result = query_at(db, rule.body[b], depth + 1);
            if result.nanswers == 0 {
                all_body_true = K_FALSE;
                current_trace = add_step(current_trace, "rule_body_false", K_FALSE);
            } else {
                let mut a: u32 = 0;
                while a < result.nanswers {
                    current_trace = add_step(current_trace, "rule_body_check", result.answers[a].truth_value);
                    a = a + 1;
                }
            }
            b = b + 1;
        }

        let mut derived_truth = K_FALSE;
        if all_body_true == K_TRUE {
            derived_truth = rule.head.truth_value;
        }

        let derived = Fact {
            predicate: rule.head.predicate,
            args: rule.head.args,
            nargs: rule.head.nargs,
            truth_value: derived_truth
        };

        current_trace = add_step(current_trace, "rule_derived", derived_truth);
        return ApplyResult { derived: derived, trace: current_trace }
    }

    // Bottom-up evaluation (forward chaining)
    fn eval_bottom_up(db: Database) -> Database {
        let mut result_db = db;
        let mut iteration: u32 = 0;

        while iteration < MAX_STEPS {
            iteration = iteration + 1;

            let mut derived_facts: [MAX_RULES]Fact = undefined;
            let mut nderived: u32 = 0;

            let mut r: u32 = 0;
            while r < result_db.nrules {
                let applied = apply_rule(result_db, result_db.rules[r], new_proof_trace());
                if applied.derived.truth_value != K_FALSE && !fact_in_db(result_db, applied.derived) {
                    derived_facts[nderived] = applied.derived;
                    nderived = nderived + 1;
                }
                r = r + 1;
            }

            if nderived == 0 {
                break  // Fixed point reached
            }

            let mut d: u32 = 0;
            while d < nderived {
                result_db = add_fact(result_db, derived_facts[d]);
                d = d + 1;
            }
        }

        return result_db
    }

    // Check if fact exists in database
    fn fact_in_db(db: Database, fact: Fact) -> bool {
        let mut i: u32 = 0;
        while i < db.nfacts {
            let existing = db.facts[i];
            if facts_match(existing, fact) && existing.truth_value == fact.truth_value {
                return true
            }
            i = i + 1;
        }
        return false
    }

    // Top-down evaluation (backward chaining)
    fn eval_top_down(db: Database, q: Fact) -> QueryResult {
        return query(db, q)
    }

    // Fixture: parent(alice, bob), parent(bob, carol)
    fn family_db() -> Database {
        let mut db = new_database();
        db = add_fact(db, fact2("parent", "alice", "bob", K_TRUE));
        db = add_fact(db, fact2("parent", "bob", "carol", K_TRUE));
        return db
    }

    // Fixture: grandparent(alice, carol) :- parent(alice, x), parent(x, carol)
    fn grandparent_rule() -> Rule {
        return rule2(
            fact2("grandparent", "alice", "carol", K_TRUE),
            fact2("parent", "alice", "x", K_TRUE),
            fact2("parent", "x", "carol", K_TRUE)
        )
    }

    // INVARIANTS

    // Database monotonicity (facts only added)
    invariant database_monotonicity {
        @setEvalBranchQuota(200000);
        let db = new_database();
        let db2 = add_fact(db, fact0("p", K_TRUE));
        assert db2.nfacts >= db.nfacts;
        assert db2.nfacts == 1
    }

    // Query returns valid proof trace
    invariant query_returns_valid_trace {
        @setEvalBranchQuota(200000);
        let mut db = new_database();
        let fact = fact0("test", K_TRUE);
        db = add_fact(db, fact);
        let result = query(db, fact);
        assert result.complete;
        assert result.nanswers == 1
    }

    // Bottom-up evaluation terminates: with no rules it is the identity, and a
    // self-feeding rule still stops at the fixed point instead of looping
    invariant bottom_up_terminates {
        @setEvalBranchQuota(2000000);
        let empty = eval_bottom_up(new_database());
        assert empty.nfacts == 0;
        assert empty.nrules == 0;
        let mut db = family_db();
        db = add_rule(db, rule1(fact2("parent", "x", "y", K_TRUE), fact2("parent", "alice", "bob", K_TRUE)));
        let result = eval_bottom_up(db);
        assert result.nfacts == db.nfacts
    }

    // TESTS

    test new_database_creates_empty {
        let db = new_database();
        assert db.nfacts == 0;
        assert db.nrules == 0
    }

    test add_fact_increments_count {
        let mut db = new_database();
        let fact = fact2("parent", "alice", "bob", K_TRUE);
        db = add_fact(db, fact);
        assert db.nfacts == 1;
        assert str_eq(db.facts[0].predicate, "parent")
    }

    test add_rule_increments_count {
        let mut db = new_database();
        let head = fact2("grandparent", "a", "b", K_UNKNOWN);
        let rule = rule1(head, fact2("parent", "a", "x", K_TRUE));
        db = add_rule(db, rule);
        assert db.nrules == 1;
        assert db.rules[0].nbody == 1
    }

    test query_finds_matching_fact {
        let mut db = new_database();
        let fact = fact2("parent", "alice", "bob", K_TRUE);
        db = add_fact(db, fact);
        let query_fact = fact2("parent", "alice", "bob", K_TRUE);
        let result = query(db, query_fact);
        assert result.nanswers == 1;
        assert result.answers[0].truth_value == K_TRUE
    }

    test query_returns_empty_for_no_match {
        let mut db = new_database();
        let fact = fact2("parent", "alice", "bob", K_TRUE);
        db = add_fact(db, fact);
        let query_fact = fact2("child", "bob", "alice", K_TRUE);
        let result = query(db, query_fact);
        assert result.nanswers == 0
    }

    test facts_match_same_predicate {
        let a = fact1("p", "x", K_TRUE);
        let b = fact1("p", "y", K_TRUE);
        assert facts_match(a, b)
    }

    test facts_match_different_predicate {
        let a = fact1("p", "x", K_TRUE);
        let b = fact1("q", "x", K_TRUE);
        assert !facts_match(a, b)
    }

    test rule_heads_match_same_predicate {
        let head = fact2("grandparent", "a", "b", K_TRUE);
        let q = fact2("grandparent", "x", "y", K_TRUE);
        assert rule_heads_match(head, q)
    }

    test fact_in_db_finds_existing {
        let mut db = new_database();
        let fact = fact1("p", "x", K_TRUE);
        db = add_fact(db, fact);
        assert fact_in_db(db, fact)
    }

    test fact_in_db_returns_false_for_missing {
        let db = new_database();
        let fact = fact1("p", "x", K_TRUE);
        assert !fact_in_db(db, fact)
    }

    test eval_bottom_up_derives_new_facts {
        // parent(alice, bob) ^ parent(bob, carol) -> grandparent(alice, carol)
        let mut db = family_db();
        db = add_rule(db, grandparent_rule());

        let result = eval_bottom_up(db);
        assert result.nfacts >= 3;  // 2 original + 1 derived
        assert str_eq(result.facts[2].predicate, "grandparent");
        assert result.facts[2].truth_value == K_TRUE
    }

    test eval_top_down_returns_results {
        let mut db = new_database();
        db = add_fact(db, fact2("parent", "alice", "bob", K_TRUE));
        let query_fact = fact2("parent", "alice", "bob", K_TRUE);
        let result = eval_top_down(db, query_fact);
        assert result.nanswers == 1
    }

    test query_proof_trace_within_bounds {
        let mut db = new_database();
        db = add_fact(db, fact1("p", "x", K_TRUE));
        let query_fact = fact1("p", "x", K_TRUE);
        let result = query(db, query_fact);
        assert result.proof_trace.count <= MAX_STEPS;
        assert result.proof_trace.count == 1
    }

    test query_derives_answer_through_rule {
        let mut db = family_db();
        db = add_rule(db, grandparent_rule());
        let result = query(db, fact2("grandparent", "alice", "carol", K_TRUE));
        assert result.nanswers == 1;
        assert result.answers[0].truth_value == K_TRUE;
        assert result.complete
    }

    test query_skips_rule_with_false_body {
        let mut db = family_db();
        db = add_rule(db, rule1(fact2("likes", "a", "b", K_TRUE), fact2("friend", "a", "b", K_TRUE)));
        let result = query(db, fact2("likes", "a", "b", K_TRUE));
        assert result.nanswers == 0;
        assert result.proof_trace.count == 2
    }

    test query_follows_a_self_recursive_rule_to_its_depth_bound {
        let mut db = new_database();
        db = add_rule(db, rule1(fact1("p", "x", K_TRUE), fact1("p", "x", K_TRUE)));
        let result = query(db, fact1("p", "x", K_TRUE));
        assert result.nanswers == 0
    }

    // BENCHMARKS

    bench query_latency {
        // Target: <5us for simple lookup
    }

    bench add_fact_latency {
        // Target: <1us per fact
    }

    bench eval_bottom_up_latency {
        // Target: <100us for 10-rule database
    }

    bench eval_top_down_latency {
        // Target: <10us for single derivation
    }

    bench memory_per_fact {
        // Target: <100 bytes per fact
    }
}
