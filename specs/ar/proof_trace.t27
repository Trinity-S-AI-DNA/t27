// SPDX-License-Identifier: Apache-2.0
// spec: ProofTrace
// Bounded proof trace mechanism for explainable neuro-symbolic reasoning

use base::types;

spec ProofTrace {
    // #8980: the spec did not compile (no Trit type, no now(), no format/join/
    // contains, dynamic `push`, tuple returns). It is now self-contained:
    //   Trit      -> i8 (-1 False, 0 Unknown, +1 True; K_NULL marks a missing output)
    //   steps     -> a fixed buffer of STEP_CAP steps plus a count (the bench note
    //                says "fixed 10-step buffer"; the extra room lets the overflow
    //                checks record MAX_STEPS + 1 steps)
    //   now()     -> a logical clock: start_timestamp 0, one tick per recorded step
    //   string    -> Text, a fixed byte buffer + length filled by text_append_*
    //   tuple     -> VerifyResult { valid, message }
    //   counters  -> u32 (indices into fixed arrays)

    // Maximum number of steps allowed in proof trace
    // requirement: <=10 steps
    const MAX_STEPS: u32 = 10

    // Room for MAX_STEPS plus overflow probes
    const STEP_CAP: u32 = 16

    // Capacity of a Text buffer (verify messages and formatted traces)
    const TEXT_CAP: u32 = 1024

    // K3 values (same encoding as ternary_logic: AND is min, OR is max)
    const K_FALSE: i8 = -1
    const K_UNKNOWN: i8 = 0
    const K_TRUE: i8 = 1
    // Not a K3 value: marks a step whose output was never produced
    const K_NULL: i8 = 2

    // Text buffers (stand-in for string building with format!)
    struct Text {
        bytes: [TEXT_CAP]u8,
        len: u32
    }

    fn text_empty() -> Text {
        return Text { bytes: [0; TEXT_CAP], len: 0 }
    }

    // Bytes past TEXT_CAP are dropped
    fn text_append_byte(t: *Text, b: u8) -> void {
        if t.len < TEXT_CAP {
            t.bytes[t.len] = b;
            t.len = t.len + 1;
        }
    }

    fn text_append_str(t: *Text, s: string) -> void {
        let mut i: usize = 0;
        while i < s.len {
            text_append_byte(t, s[i]);
            i = i + 1;
        }
    }

    fn text_of(s: string) -> Text {
        let mut t = text_empty();
        text_append_str(&t, s);
        return t
    }

    // Decimal digits of v, the `{}` of a u32
    fn text_append_u32(t: *Text, v: u32) -> void {
        if v == 0 {
            text_append_byte(t, 48);
        } else {
            let mut digits: [10]u8 = [0; 10];
            let mut count: u32 = 0;
            let mut n: u32 = v;
            while n > 0 {
                digits[count] = (48 + n % 10) as u8;
                count = count + 1;
                n = n / 10;
            }
            while count > 0 {
                count = count - 1;
                text_append_byte(t, digits[count]);
            }
        }
    }

    // Two fraction digits of ticks / 1000, the `{:.2f}` of ticks as microseconds
    fn text_append_fixed2(t: *Text, ticks: u32) -> void {
        let mut whole: u32 = ticks / 1000;
        let mut hundredths: u32 = ((ticks % 1000) + 5) / 10;
        if hundredths >= 100 {
            whole = whole + 1;
            hundredths = hundredths - 100;
        }
        text_append_u32(t, whole);
        text_append_byte(t, 46);
        text_append_byte(t, (48 + hundredths / 10) as u8);
        text_append_byte(t, (48 + hundredths % 10) as u8);
    }

    // Does `hay` contain `needle` as a substring
    fn contains(hay: Text, needle: Text) -> bool {
        if needle.len > hay.len {
            return false
        }
        let mut start: u32 = 0;
        while start + needle.len <= hay.len {
            let mut k: u32 = 0;
            let mut same = true;
            while k < needle.len {
                if hay.bytes[start + k] != needle.bytes[k] {
                    same = false;
                }
                k = k + 1;
            }
            if same {
                return true
            }
            start = start + 1;
        }
        return false
    }

    // Byte-wise string equality
    fn str_eq(a: string, b: string) -> bool {
        if a.len != b.len {
            return false
        }
        let mut i: usize = 0;
        while i < a.len {
            if a[i] != b[i] {
                return false
            }
            i = i + 1;
        }
        return true
    }

    // Proof step structure
    struct ProofStep {
        step_id: u32,
        operation: string,
        inputs: [i8],
        output: i8,
        timestamp: u32
    }

    // Complete proof trace
    struct ProofTrace {
        steps: [STEP_CAP]ProofStep,
        count: u32,
        start_timestamp: u32,
        end_timestamp: u32,
        verified: bool
    }

    // Result of verify_trace (a tuple in the Rust-like original)
    struct VerifyResult {
        valid: bool,
        message: Text
    }

    fn empty_step() -> ProofStep {
        return ProofStep { step_id: 0, operation: "", inputs: [], output: K_UNKNOWN, timestamp: 0 }
    }

    // Logical clock: one tick per recorded step
    fn now(trace: ProofTrace) -> u32 {
        return trace.start_timestamp + trace.count
    }

    // Create new proof trace
    fn new_proof_trace() -> ProofTrace {
        let mut slots: [STEP_CAP]ProofStep = undefined;
        let mut k: u32 = 0;
        while k < STEP_CAP {
            slots[k] = empty_step();
            k = k + 1;
        }
        return ProofTrace {
            steps: slots,
            count: 0,
            start_timestamp: 0,
            end_timestamp: 0,
            verified: false
        }
    }

    // Add a step to proof trace (a full buffer leaves the trace unchanged)
    fn add_step(trace: ProofTrace, operation: string, inputs: [i8], output: i8) -> ProofTrace {
        if trace.count >= STEP_CAP {
            return trace
        }
        let step = ProofStep {
            step_id: trace.count,
            operation: operation,
            inputs: inputs,
            output: output,
            timestamp: now(trace) - trace.start_timestamp
        };
        let mut new_steps = trace.steps;
        new_steps[trace.count] = step;
        return ProofTrace {
            steps: new_steps,
            count: trace.count + 1,
            start_timestamp: trace.start_timestamp,
            end_timestamp: trace.end_timestamp,
            verified: trace.verified
        }
    }

    // Verify proof trace is within bounds
    fn verify_trace(trace: ProofTrace) -> VerifyResult {
        let step_count = trace.count;
        let mut message = text_empty();

        if step_count > MAX_STEPS {
            text_append_str(&message, "Proof trace exceeded ");
            text_append_u32(&message, step_count);
            text_append_str(&message, " steps (max: ");
            text_append_u32(&message, MAX_STEPS);
            text_append_str(&message, ")");
            return VerifyResult { valid: false, message: message }
        }

        if step_count == 0 {
            return VerifyResult { valid: false, message: text_of("Empty proof trace") }
        }

        // Check each step has valid output
        let mut i: u32 = 0;
        while i < step_count {
            let step = trace.steps[i];
            if step.output == K_NULL {
                text_append_str(&message, "Step ");
                text_append_u32(&message, step.step_id);
                text_append_str(&message, " has NULL output");
                return VerifyResult { valid: false, message: message }
            }
            i = i + 1;
        }

        text_append_str(&message, "Valid: ");
        text_append_u32(&message, step_count);
        text_append_str(&message, " steps (<=");
        text_append_u32(&message, MAX_STEPS);
        text_append_str(&message, ")");
        return VerifyResult { valid: true, message: message }
    }

    // Get proof trace length
    fn trace_length(trace: ProofTrace) -> u32 {
        return trace.count
    }

    // Check if trace is at maximum capacity
    fn is_at_capacity(trace: ProofTrace) -> bool {
        return trace.count >= MAX_STEPS
    }

    // Finalize and verify trace
    fn finalize_trace(trace: ProofTrace) -> ProofTrace {
        return ProofTrace {
            steps: trace.steps,
            count: trace.count,
            start_timestamp: trace.start_timestamp,
            end_timestamp: now(trace),
            verified: true
        }
    }

    // Convert Trit to string representation
    fn trit_to_string(t: i8) -> string {
        if t == K_TRUE {
            return "T"
        } else if t == K_UNKNOWN {
            return "U"
        } else if t == K_FALSE {
            return "F"
        } else {
            return "?"
        }
    }

    // Format trace as human-readable text
    fn format_trace(trace: ProofTrace) -> Text {
        let mut out = text_of("=== Proof Trace ===");

        let mut i: u32 = 0;
        while i < trace.count {
            let step = trace.steps[i];
            text_append_str(&out, "\n");
            text_append_u32(&out, step.step_id + 1);
            text_append_str(&out, ". ");
            text_append_str(&out, step.operation);
            text_append_str(&out, "(");
            let mut k: usize = 0;
            while k < step.inputs.len {
                if k > 0 {
                    text_append_str(&out, ", ");
                }
                text_append_str(&out, trit_to_string(step.inputs[k]));
                k = k + 1;
            }
            text_append_str(&out, ") = ");
            text_append_str(&out, trit_to_string(step.output));
            text_append_str(&out, " (");
            text_append_fixed2(&out, step.timestamp);
            text_append_str(&out, "us)");
            i = i + 1;
        }

        text_append_str(&out, "\n\nTotal: ");
        text_append_u32(&out, trace.count);
        text_append_str(&out, " steps, verified: ");
        if trace.verified {
            text_append_str(&out, "true");
        } else {
            text_append_str(&out, "false");
        }
        return out
    }

    // INVARIANTS

    // MAX_STEPS is positive
    invariant max_steps_positive {
        assert MAX_STEPS > 0
    }

    // Trace verification catches overflow
    invariant trace_verification_catches_overflow {
        @setEvalBranchQuota(200000);
        let large_trace = new_proof_trace();
        let mut trace = large_trace;
        let mut i: u32 = 0;
        while i < MAX_STEPS + 1 {
            trace = add_step(trace, "dummy", [K_TRUE], K_TRUE);
            i = i + 1;
        }
        let result = verify_trace(trace);
        assert !result.valid
    }

    // Empty trace verification fails
    invariant empty_trace_fails {
        @setEvalBranchQuota(200000);
        let empty_trace = new_proof_trace();
        let result = verify_trace(empty_trace);
        assert !result.valid
    }

    // Valid trace verification passes
    invariant valid_trace_passes {
        @setEvalBranchQuota(200000);
        let mut trace = new_proof_trace();
        trace = add_step(trace, "k3_and", [K_TRUE, K_TRUE], K_TRUE);
        trace = add_step(trace, "k3_or", [K_TRUE, K_FALSE], K_TRUE);
        let result = verify_trace(trace);
        assert result.valid
    }

    // Trace length invariant
    invariant trace_length_equals_steps {
        @setEvalBranchQuota(200000);
        let mut trace = new_proof_trace();
        trace = add_step(trace, "op1", [K_TRUE], K_TRUE);
        trace = add_step(trace, "op2", [K_FALSE], K_FALSE);
        trace = add_step(trace, "op3", [K_UNKNOWN], K_UNKNOWN);
        assert trace_length(trace) == 3
    }

    // Finalization sets verified flag
    invariant finalization_sets_verified {
        @setEvalBranchQuota(200000);
        let mut trace = new_proof_trace();
        trace = add_step(trace, "op", [K_TRUE], K_TRUE);
        let finalized = finalize_trace(trace);
        assert finalized.verified
    }

    // TESTS

    test new_proof_trace_creates_empty {
        let trace = new_proof_trace();
        assert trace.count == 0;
        assert !trace.verified;
    }

    test add_step_increments_count {
        let mut trace = new_proof_trace();
        trace = add_step(trace, "k3_and", [K_TRUE, K_TRUE], K_TRUE);
        trace = add_step(trace, "k3_or", [K_TRUE, K_FALSE], K_TRUE);
        assert trace.count == 2;
    }

    test verify_trace_valid_small {
        let mut trace = new_proof_trace();
        trace = add_step(trace, "k3_and", [K_TRUE, K_TRUE], K_TRUE);
        trace = add_step(trace, "k3_or", [K_TRUE, K_FALSE], K_TRUE);
        let result = verify_trace(trace);
        assert result.valid;
        assert contains(result.message, text_of("Valid:"))
    }

    test verify_trace_fails_at_max_plus_one {
        let mut trace = new_proof_trace();
        let mut i: u32 = 0;
        while i < MAX_STEPS + 1 {
            trace = add_step(trace, "dummy", [K_TRUE], K_TRUE);
            i = i + 1;
        }
        let result = verify_trace(trace);
        assert !result.valid;
        // The message reports the actual step count, MAX_STEPS + 1. The original
        // looked for "exceeded {MAX_STEPS} steps" ("exceeded 10 steps"), which the
        // message "Proof trace exceeded 11 steps (max: 10)" cannot contain.
        let mut needle = text_of("exceeded ");
        text_append_u32(&needle, MAX_STEPS + 1);
        text_append_str(&needle, " steps");
        assert contains(result.message, needle)
    }

    test verify_trace_accepts_max_steps {
        let mut trace = new_proof_trace();
        let mut i: u32 = 0;
        while i < MAX_STEPS {
            trace = add_step(trace, "op", [K_TRUE], K_TRUE);
            i = i + 1;
        }
        let result = verify_trace(trace);
        assert result.valid
    }

    test trace_length_reports_correct {
        let mut trace = new_proof_trace();
        trace = add_step(trace, "op1", [K_TRUE], K_TRUE);
        trace = add_step(trace, "op2", [K_FALSE], K_FALSE);
        trace = add_step(trace, "op3", [K_UNKNOWN], K_UNKNOWN);
        trace = add_step(trace, "op4", [K_TRUE], K_FALSE);
        assert trace_length(trace) == 4
    }

    test is_at_capacity_detects_limit {
        let mut trace = new_proof_trace();
        let mut i: u32 = 0;
        while i < MAX_STEPS {
            trace = add_step(trace, "op", [K_TRUE], K_TRUE);
            i = i + 1;
        }
        assert is_at_capacity(trace)
    }

    test is_at_capacity_false_when_not_full {
        let mut trace = new_proof_trace();
        trace = add_step(trace, "op", [K_TRUE], K_TRUE);
        assert !is_at_capacity(trace)
    }

    test finalize_trace_sets_verified {
        let mut trace = new_proof_trace();
        trace = add_step(trace, "op", [K_TRUE], K_TRUE);
        let finalized = finalize_trace(trace);
        assert finalized.verified;
        assert finalized.count == trace.count
    }

    test format_trace_produces_readable_output {
        let mut trace = new_proof_trace();
        trace = add_step(trace, "k3_and", [K_TRUE, K_TRUE], K_TRUE);
        trace = add_step(trace, "k3_or", [K_TRUE, K_FALSE], K_TRUE);
        let formatted = format_trace(trace);
        assert contains(formatted, text_of("1. k3_and(T, T) = T"));
        assert contains(formatted, text_of("2. k3_or(T, F) = T"));
        assert contains(formatted, text_of("Total: 2 steps"))
    }

    test trit_to_string_converts_values {
        assert str_eq(trit_to_string(K_TRUE), "T");
        assert str_eq(trit_to_string(K_UNKNOWN), "U");
        assert str_eq(trit_to_string(K_FALSE), "F")
    }

    test proof_trace_with_actual_reasoning {
        // Simulate a real reasoning chain with bounded steps
        let mut trace = new_proof_trace();

        // Step 1: Input symptoms
        trace = add_step(trace, "input_symptom", [K_TRUE], K_TRUE);

        // Step 2: Apply rule 1
        trace = add_step(trace, "k3_and", [K_TRUE, K_TRUE], K_TRUE);

        // Step 3: Apply rule 2
        trace = add_step(trace, "k3_or", [K_TRUE, K_UNKNOWN], K_TRUE);

        // Step 4: Final conclusion
        trace = add_step(trace, "conclusion", [K_TRUE], K_TRUE);

        let result = verify_trace(trace);
        assert result.valid;
        assert trace.count == 4
    }

    // BENCHMARKS

    bench add_step_latency {
        // Target: <0.5μs per step
    }

    bench verify_trace_latency {
        // Target: <1μs for verification
    }

    bench format_trace_latency {
        // Target: <5μs for string formatting
    }

    bench trace_memory_usage {
        // Target: O(1) per trace (fixed 10-step buffer)
    }
}
