// SPDX-License-Identifier: Apache-2.0
// spec: TernaryLogic
// K3 Kleene ternary logic operations for neuro-symbolic reasoning

spec TernaryLogic {
    // K3 ternary values: True, Unknown, False
    // A Trit is an i8 holding -1 (False), 0 (Unknown) or +1 (True), so Kleene
    // AND is the minimum, OR the maximum and NOT the negation (#8980: the
    // generated Zig had no Trit type and no Trit.min/max/not).

    // K3 constant values
    const K_FALSE: i8 = -1
    const K_UNKNOWN: i8 = 0
    const K_TRUE: i8 = 1

    // The whole K3 domain, for the exhaustive invariants and tests
    const K3_VALUES: [3]i8 = [K_FALSE, K_UNKNOWN, K_TRUE]

    // Static pool backing the arrays that resolve and apply_restraint return
    // (t27 has no heap): a bump allocator that wraps when full.
    var trit_pool: [256]i8 = undefined
    var trit_pool_used: usize = 0

    fn pool_take(n: usize) -> usize {
        if trit_pool_used + n > 256 {
            trit_pool_used = 0;
        }
        let start: usize = trit_pool_used;
        trit_pool_used = trit_pool_used + n;
        return start
    }

    // A K3 value is designated (holds) only when it is True
    fn holds(t: i8) -> bool {
        return t == K_TRUE
    }

    // Basic K3 operations

    // AND operation: K3 AND truth table
    // T AND T = T, T AND F = F, F AND ? = F, T AND ? = ?, ? AND ? = ?
    fn k3_and(a: i8, b: i8) -> i8 {
        if a < b {
            return a
        }
        return b
    }

    // OR operation: K3 OR truth table
    // T OR T = T, T OR F = T, F OR ? = ?, ? OR ? = ?
    fn k3_or(a: i8, b: i8) -> i8 {
        if a > b {
            return a
        }
        return b
    }

    // NOT operation: K3 negation
    // NOT T = F, NOT F = T, NOT ? = ?
    fn k3_not(a: i8) -> i8 {
        return 0 - a
    }

    // IMPLIES operation: K3 implication (NOT a OR b)
    fn k3_implies(a: i8, b: i8) -> i8 {
        return k3_or(k3_not(a), b)
    }

    // EQUIV operation: K3 logical equivalence ((a -> b) AND (b -> a))
    fn k3_equiv(a: i8, b: i8) -> i8 {
        let ab = k3_implies(a, b);
        let ba = k3_implies(b, a);
        return k3_and(ab, ba)
    }

    // Rule structure for logical inference
    struct Rule {
        antecedent: i8,
        consequent: i8
    }

    // Forward chaining: apply rule to fact
    // If fact matches rule antecedent, derive consequent
    fn forward_chain(rule: Rule, fact: i8) -> i8 {
        let fact_matches = k3_equiv(fact, rule.antecedent);
        return k3_and(fact_matches, rule.consequent)
    }

    // Backward chaining: find support for goal from rules
    fn backward_chain(goal: i8, rules: []const Rule) -> i8 {
        let mut result = K_UNKNOWN;
        for rule in rules {
            let consequent_matches = k3_equiv(rule.consequent, goal);
            let support = k3_and(consequent_matches, rule.antecedent);
            result = k3_or(result, support);
        }
        return result
    }

    // Resolution operator for clause combination
    // Resolve two clauses by finding complementary literals
    fn resolve(clause_a: []const i8, clause_b: []const i8) -> []i8 {
        let n: usize = clause_a.len;
        let start: usize = pool_take(n);
        let mut i: usize = 0;
        while i < n {
            let a = clause_a[i];
            let b = clause_b[i];
            // T/F complementary -> unknown, otherwise OR
            let mut resolved = k3_or(a, b);
            if a == K_TRUE and b == K_FALSE {
                resolved = K_UNKNOWN;
            }
            if a == K_FALSE and b == K_TRUE {
                resolved = K_UNKNOWN;
            }
            trit_pool[start + i] = resolved;
            i = i + 1;
        }
        return trit_pool[start..start + n]
    }

    // Restraint check: bounded rationality
    // Unknown values trigger restraint mechanism
    fn is_restraint(t: i8) -> bool {
        return t == K_UNKNOWN
    }

    // Apply restraint to values
    fn apply_restraint(values: []const i8) -> []i8 {
        let n: usize = values.len;
        let start: usize = pool_take(n);
        let mut i: usize = 0;
        while i < n {
            let t = values[i];
            let mut transformed = t;  // Preserve known values
            if is_restraint(t) {
                transformed = K_FALSE;  // Restraint: unknown becomes false
            }
            trit_pool[start + i] = transformed;
            i = i + 1;
        }
        return trit_pool[start..start + n]
    }

    // INVARIANTS - Must hold for all operations
    // The K3 domain is finite, so each quantified invariant is checked on all
    // 3 (or 27) combinations of values.

    // K3 AND is commutative
    invariant k3_and_commutative {
        for a in K3_VALUES {
            for b in K3_VALUES {
                assert k3_and(a, b) == k3_and(b, a)
            }
        }
    }

    // K3 OR is commutative
    invariant k3_or_commutative {
        for a in K3_VALUES {
            for b in K3_VALUES {
                assert k3_or(a, b) == k3_or(b, a)
            }
        }
    }

    // K3 AND is associatave
    invariant k3_and_associative {
        for a in K3_VALUES {
            for b in K3_VALUES {
                for c in K3_VALUES {
                    assert k3_and(k3_and(a, b), c) == k3_and(a, k3_and(b, c))
                }
            }
        }
    }

    // K3 OR is associatave
    invariant k3_or_associative {
        for a in K3_VALUES {
            for b in K3_VALUES {
                for c in K3_VALUES {
                    assert k3_or(k3_or(a, b), c) == k3_or(a, k3_or(b, c))
                }
            }
        }
    }

    // K3 AND identity element
    invariant k3_and_identity {
        for a in K3_VALUES {
            assert k3_and(a, K_TRUE) == a
        }
    }

    // K3 OR identity element
    invariant k3_or_identity {
        for a in K3_VALUES {
            assert k3_or(a, K_FALSE) == a
        }
    }

    // K3 AND annihilator
    invariant k3_and_annihilator {
        for a in K3_VALUES {
            assert k3_and(a, K_FALSE) == K_FALSE
        }
    }

    // K3 OR annihilator
    invariant k3_or_annihilator {
        for a in K3_VALUES {
            assert k3_or(a, K_TRUE) == K_TRUE
        }
    }

    // Double negation
    invariant k3_double_negation {
        for a in K3_VALUES {
            assert k3_not(k3_not(a)) == a
        }
    }

    // Idempotency of AND
    invariant k3_idempotent_and {
        for a in K3_VALUES {
            assert k3_and(a, a) == a
        }
    }

    // Idempotency of OR
    invariant k3_idempotent_or {
        for a in K3_VALUES {
            assert k3_or(a, a) == a
        }
    }

    // K3 implies transitivity.
    // The original `k3_and(a->b, b->c) <= a->c` is not a K3 theorem (a = T,
    // b = ?, c = F gives ? <= F). Kleene transitivity is about truth: when both
    // premises hold (are T), the conclusion holds.
    invariant k3_implies_transitivity {
        for a in K3_VALUES {
            for b in K3_VALUES {
                for c in K3_VALUES {
                    if holds(k3_and(k3_implies(a, b), k3_implies(b, c))) {
                        assert holds(k3_implies(a, c))
                    }
                }
            }
        }
    }

    // K3 equiv reflexive: T and F are equivalent to themselves; ? <-> ? is ?
    // (Kleene), not T, so the original `assert k3_equiv(a, a)` held only for
    // the two definite values.
    invariant k3_equiv_reflexive {
        for a in K3_VALUES {
            if a == K_UNKNOWN {
                assert k3_equiv(a, a) == K_UNKNOWN
            } else {
                assert holds(k3_equiv(a, a))
            }
        }
    }

    // K3 equiv symmetric
    invariant k3_equiv_symmetric {
        for a in K3_VALUES {
            for b in K3_VALUES {
                assert k3_equiv(a, b) == k3_equiv(b, a)
            }
        }
    }

    // Restraint preserves type
    invariant restraint_preserves_type {
        assert is_restraint(K_UNKNOWN);
        assert !is_restraint(K_TRUE);
        assert !is_restraint(K_FALSE);
    }

    // TESTS - Verification of K3 logic

    test k3_and_truth_table {
        // Test all 9 combinations of K3 AND
        assert k3_and(K_TRUE, K_TRUE) == K_TRUE;
        assert k3_and(K_TRUE, K_UNKNOWN) == K_UNKNOWN;
        assert k3_and(K_TRUE, K_FALSE) == K_FALSE;
        assert k3_and(K_UNKNOWN, K_TRUE) == K_UNKNOWN;
        assert k3_and(K_UNKNOWN, K_UNKNOWN) == K_UNKNOWN;
        assert k3_and(K_UNKNOWN, K_FALSE) == K_FALSE;
        assert k3_and(K_FALSE, K_TRUE) == K_FALSE;
        assert k3_and(K_FALSE, K_UNKNOWN) == K_FALSE;
        assert k3_and(K_FALSE, K_FALSE) == K_FALSE;
    }

    test k3_or_truth_table {
        // Test all 9 combinations of K3 OR
        assert k3_or(K_TRUE, K_TRUE) == K_TRUE;
        assert k3_or(K_TRUE, K_UNKNOWN) == K_TRUE;
        assert k3_or(K_TRUE, K_FALSE) == K_TRUE;
        assert k3_or(K_UNKNOWN, K_TRUE) == K_TRUE;
        assert k3_or(K_UNKNOWN, K_UNKNOWN) == K_UNKNOWN;
        assert k3_or(K_UNKNOWN, K_FALSE) == K_UNKNOWN;
        assert k3_or(K_FALSE, K_TRUE) == K_TRUE;
        assert k3_or(K_FALSE, K_UNKNOWN) == K_UNKNOWN;
        assert k3_or(K_FALSE, K_FALSE) == K_FALSE;
    }

    test k3_not_truth_table {
        // Test K3 NOT
        assert k3_not(K_TRUE) == K_FALSE;
        assert k3_not(K_UNKNOWN) == K_UNKNOWN;
        assert k3_not(K_FALSE) == K_TRUE;
    }

    test k3_no_tautology_or_not_false {
        // T OR NOT F = T OR T = T. The original asserted `!= T`, contradicting
        // its own comment: a definite value does give T; the failure of the
        // law of excluded middle is only at ?.
        assert k3_or(K_TRUE, k3_not(K_FALSE)) == K_TRUE
    }

    test k3_no_tautology_or_not_true {
        // T OR NOT T = T OR F = T. The original comment said "?" and asserted
        // `!= T`, but T OR F is T in K3.
        assert k3_or(K_TRUE, k3_not(K_TRUE)) == K_TRUE
    }

    test k3_no_tautology_or_not_unknown_violation {
        // ? OR NOT ? = ? OR ? = ? (no tautology in K3: excluded middle fails)
        assert k3_or(K_UNKNOWN, k3_not(K_UNKNOWN)) == K_UNKNOWN
    }

    test k3_no_tautology_exists_violating_value {
        // a OR NOT a is ? exactly when a is ?, and T for the definite values;
        // the original asserted ? for every a, which is false for T and F.
        for a in K3_VALUES {
            let result = k3_or(a, k3_not(a));
            if a == K_UNKNOWN {
                assert result == K_UNKNOWN;
            } else {
                assert result == K_TRUE;
            }
        }
    }

    test k3_no_tautology_all_values_tested {
        // Verify all values tested above: the domain has exactly 3 values and
        // a OR NOT a is T for 2 of them and ? for 1.
        let mut count: u32 = 0;
        let mut definite: u32 = 0;
        let mut unknown: u32 = 0;
        for a in K3_VALUES {
            count = count + 1;
            let result = k3_or(a, k3_not(a));
            if result == K_TRUE {
                definite = definite + 1;
            }
            if result == K_UNKNOWN {
                unknown = unknown + 1;
            }
        }
        assert count == 3;
        assert definite == 2;
        assert unknown == 1;
    }

    test k3_restraint_from_no_tautology {
        // Restraint mechanism depends on K_UNKNOWN handling: excluded middle
        // is not true for every value, so it is not a tautology.
        let mut is_tautology = true;
        for a in K3_VALUES {
            let result = k3_or(a, k3_not(a));
            if result != K_TRUE {
                is_tautology = false;
            }
        }
        assert !is_tautology;
    }

    test k3_implication_ex_falso {
        // F -> anything is T in Kleene logic (NOT F OR x = T OR x = T); the
        // original comment and expected value (?) were wrong.
        let result = k3_implies(K_FALSE, K_TRUE);
        assert result == K_TRUE;
        assert k3_implies(K_FALSE, K_UNKNOWN) == K_TRUE;
        assert k3_implies(K_FALSE, K_FALSE) == K_TRUE;
    }

    test k3_implication_when_antecedent_true {
        // T -> x = x (if consequent true, result true)
        assert k3_implies(K_TRUE, K_TRUE) == K_TRUE;
        assert k3_implies(K_TRUE, K_UNKNOWN) == K_UNKNOWN;
        assert k3_implies(K_TRUE, K_FALSE) == K_FALSE;
    }

    test k3_implication_when_consequent_true {
        // x -> T = T (if consequent true, result true)
        assert k3_implies(K_TRUE, K_TRUE) == K_TRUE;
        assert k3_implies(K_UNKNOWN, K_TRUE) == K_TRUE;
        assert k3_implies(K_FALSE, K_TRUE) == K_TRUE;
    }

    test k3_implication_with_unknown {
        // ? -> ? = ? (unknown implies unknown)
        assert k3_implies(K_UNKNOWN, K_UNKNOWN) == K_UNKNOWN;
    }

    test k3_equiv_reflexive {
        // a <-> a: T for the definite values, ? for ? (Kleene)
        assert holds(k3_equiv(K_TRUE, K_TRUE));
        assert k3_equiv(K_UNKNOWN, K_UNKNOWN) == K_UNKNOWN;
        assert holds(k3_equiv(K_FALSE, K_FALSE));
    }

    test k3_equiv_symmetric {
        // a <-> b = b <-> a
        assert k3_equiv(K_TRUE, K_UNKNOWN) == k3_equiv(K_UNKNOWN, K_TRUE);
    }

    test k3_equiv_transitive {
        // (a <-> b) AND (b <-> c) -> (a <-> c), for a = T, b = ?, c = F:
        // ab = ?, bc = ?, ac = F, so the premise is ? and the implication is ?
        // (the premise is not T, so transitivity is not violated). The original
        // asserted that the implication holds (T), which the arithmetic denies.
        let ab = k3_equiv(K_TRUE, K_UNKNOWN);
        let bc = k3_equiv(K_UNKNOWN, K_FALSE);
        let ac = k3_equiv(K_TRUE, K_FALSE);
        let lhs = k3_and(ab, bc);
        assert ab == K_UNKNOWN;
        assert bc == K_UNKNOWN;
        assert ac == K_FALSE;
        assert k3_implies(lhs, ac) == K_UNKNOWN;
    }

    test k3_equiv_when_both_true {
        // T <-> T = T
        assert k3_equiv(K_TRUE, K_TRUE) == K_TRUE;
    }

    test k3_equiv_when_both_false {
        // F <-> F = T
        assert k3_equiv(K_FALSE, K_FALSE) == K_TRUE;
    }

    test k3_equiv_when_opposite {
        // T <-> F = F
        assert k3_equiv(K_TRUE, K_FALSE) == K_FALSE;
    }

    test forward_chain_modus_ponens_true {
        // Rule: P -> Q, Fact: P, Derive: Q
        let rule = Rule {antecedent: K_TRUE, consequent: K_UNKNOWN};
        let fact = K_TRUE;
        let result = forward_chain(rule, fact);
        assert result == K_UNKNOWN;
    }

    test forward_chain_modus_ponens_false_consequent {
        // Rule: P -> F, Fact: P, Derive: F
        let rule = Rule {antecedent: K_TRUE, consequent: K_FALSE};
        let fact = K_TRUE;
        let result = forward_chain(rule, fact);
        assert result == K_FALSE;
    }

    test forward_chain_with_unknown_fact {
        // Rule: P -> Q, Fact: ?, Derive: ?
        let rule = Rule {antecedent: K_TRUE, consequent: K_UNKNOWN};
        let fact = K_UNKNOWN;
        let result = forward_chain(rule, fact);
        assert result == K_UNKNOWN;
    }

    test forward_chain_no_match {
        // Rule: P -> Q, Fact: F, Derive: ?
        let rule = Rule {antecedent: K_TRUE, consequent: K_UNKNOWN};
        let fact = K_FALSE;
        let result = forward_chain(rule, fact);
        assert result == K_FALSE;
    }

    test backward_chain_finds_support {
        // Goal: Q, Rules: [P -> Q, R -> Q], Find: P or R
        let rules = [
            Rule {antecedent: K_TRUE, consequent: K_UNKNOWN},
            Rule {antecedent: K_FALSE, consequent: K_UNKNOWN}
        ];
        let goal = K_UNKNOWN;
        let result = backward_chain(goal, rules);
        assert result == K_UNKNOWN;
    }

    test backward_chain_no_support {
        // Goal: Q, Rules: [P -> R, R -> S], Find: ?
        let rules = [
            Rule {antecedent: K_TRUE, consequent: K_FALSE},
            Rule {antecedent: K_FALSE, consequent: K_TRUE}
        ];
        let goal = K_UNKNOWN;
        let result = backward_chain(goal, rules);
        assert result == K_UNKNOWN;
    }

    test backward_chain_multiple_rules {
        // Multiple rules supporting same goal
        let rules = [
            Rule {antecedent: K_TRUE, consequent: K_UNKNOWN},
            Rule {antecedent: K_FALSE, consequent: K_UNKNOWN}
        ];
        let goal = K_UNKNOWN;
        let result = backward_chain(goal, rules);
        assert result == K_UNKNOWN;
    }

    test resolve_complementary_literals {
        // Resolve (T) and (F) -> (?)
        let a = [K_TRUE];
        let b = [K_FALSE];
        let result = resolve(a, b);
        assert result[0] == K_UNKNOWN;
    }

    test resolve_non_complementary {
        // Resolve (T) and (T) -> (T)
        let a = [K_TRUE];
        let b = [K_TRUE];
        let result = resolve(a, b);
        assert result[0] == K_TRUE;
    }

    test is_restraint_true_for_unknown {
        assert is_restraint(K_UNKNOWN);
    }

    test is_restraint_false_for_false {
        assert !is_restraint(K_FALSE);
    }

    test is_restraint_false_for_true {
        assert !is_restraint(K_TRUE);
    }

    test apply_restraint_replaces_unknown {
        let values = [K_TRUE, K_UNKNOWN, K_FALSE];
        let result = apply_restraint(values);
        assert result.len == 3;
        assert result[0] == K_TRUE;
        assert result[1] == K_FALSE;
        assert result[2] == K_FALSE;
    }

    test apply_restraint_preserves_known {
        let values = [K_TRUE, K_FALSE];
        let result = apply_restraint(values);
        assert result.len == 2;
        assert result[0] == K_TRUE;
        assert result[1] == K_FALSE;
    }

    // BENCHMARKS - Performance metrics

    bench k3_and_latency {
        // Target: <1us on XC7A100T
    }

    bench k3_or_latency {
        // Target: <1us on XC7A100T
    }

    bench k3_not_latency {
        // Target: <1us on XC7A100T
    }

    bench k3_implies_latency {
        // Target: <2us (two operations)
    }

    bench k3_equiv_latency {
        // Target: <3us (three operations)
    }

    bench forward_chain_latency {
        // Target: <2us
    }

    bench backward_chain_latency {
        // Target: <5us (iterative)
    }

    bench resolve_latency {
        // Target: <3us
    }

    bench apply_restraint_latency {
        // Target: <1us
    }
}
