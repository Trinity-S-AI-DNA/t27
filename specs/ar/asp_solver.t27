// SPDX-License-Identifier: Apache-2.0
// spec: AspSolver
// Answer Set Programming solver for neuro-symbolic reasoning
// Decision on Stmt.forLoop: Add a second constructor to express non-lowerable constructs required by this spec.

spec AspSolver {
    // #8980: the spec did not compile (no ProofTrace in scope, dynamic `push`,
    // `null` struct, `range`, `format`, slice `==`). It is now self-contained:
    //   [Literal] etc. -> fixed arrays plus a count (MAX_LITS, MAX_CLAUSES, ...)
    //   args           -> [MAX_LARGS]string plus nargs
    //   [AnswerSet]    -> SolveResult { answers, count, steps, trace_len }
    //   ProofTrace     -> trace_len, the number of recorded solver steps
    //   subsets        -> generate_combinations became combination_count (2^n)
    //                     and combination_at (subset number `mask`), so 2^n
    //                     subsets are never materialised; find_stable_model
    //                     walks them in the original ascending order
    // Two logic fixes, both forced by the spec's own tests:
    //   literals_match returned false when the negations were EQUAL (the
    //     opposite of its comment and of literals_match_exact)
    //   is_derivable treated every clause as a rule for any literal (so p was
    //     "derivable" as not_p from the fact p); a clause now derives `lit` only
    //     when it contains `lit`, the rest of the clause being the body

    // Maximum ASP derivation steps (bounded for explainability)
    const MAX_ASP_STEPS: u32 = 10

    // Fixed capacities
    const MAX_LARGS: u32 = 2
    const MAX_LITS: u32 = 16
    const MAX_CLAUSE_LITS: u32 = 4
    const MAX_CLAUSES: u32 = 16
    const MAX_ANSWERS: u32 = 4

    // Names p0 .. p15 (stand-in for format("p{}", i))
    const NAME_TABLE: [16]string = ["p0", "p1", "p2", "p3", "p4", "p5", "p6", "p7", "p8", "p9", "p10", "p11", "p12", "p13", "p14", "p15"]

    // Byte-wise string equality
    fn str_eq(a: string, b: string) -> bool {
        if a.len != b.len {
            return false
        }
        let mut i: usize = 0;
        while i < a.len {
            if a[i] != b[i] {
                return false
            }
            i = i + 1;
        }
        return true
    }

    // ASP literal structure
    struct Literal {
        name: string,
        is_negated: bool,
        args: [MAX_LARGS]string,
        nargs: u32
    }

    fn lit0(name: string, is_negated: bool) -> Literal {
        return Literal { name: name, is_negated: is_negated, args: ["", ""], nargs: 0 }
    }

    fn lit1(name: string, is_negated: bool, a: string) -> Literal {
        return Literal { name: name, is_negated: is_negated, args: [a, ""], nargs: 1 }
    }

    // A set of literals (a model or a candidate)
    struct LitList {
        items: [MAX_LITS]Literal,
        count: u32
    }

    fn lits_empty() -> LitList {
        let mut slots: [MAX_LITS]Literal = undefined;
        let mut k: u32 = 0;
        while k < MAX_LITS {
            slots[k] = lit0("", false);
            k = k + 1;
        }
        return LitList { items: slots, count: 0 }
    }

    fn lits_push(list: LitList, lit: Literal) -> LitList {
        if list.count >= MAX_LITS {
            return list
        }
        let mut items = list.items;
        items[list.count] = lit;
        return LitList { items: items, count: list.count + 1 }
    }

    fn lits1(a: Literal) -> LitList {
        return lits_push(lits_empty(), a)
    }

    fn lits2(a: Literal, b: Literal) -> LitList {
        return lits_push(lits_push(lits_empty(), a), b)
    }

    // ASP clause structure
    struct Clause {
        lits: [MAX_CLAUSE_LITS]Literal,
        count: u32
    }

    fn clause_empty() -> Clause {
        let mut slots: [MAX_CLAUSE_LITS]Literal = undefined;
        let mut k: u32 = 0;
        while k < MAX_CLAUSE_LITS {
            slots[k] = lit0("", false);
            k = k + 1;
        }
        return Clause { lits: slots, count: 0 }
    }

    fn clause1(a: Literal) -> Clause {
        let mut c = clause_empty();
        c.lits[0] = a;
        c.count = 1;
        return c
    }

    fn clause2(a: Literal, b: Literal) -> Clause {
        let mut c = clause_empty();
        c.lits[0] = a;
        c.lits[1] = b;
        c.count = 2;
        return c
    }

    // ASP program (set of clauses)
    struct Program {
        clauses: [MAX_CLAUSES]Clause,
        nclauses: u32,
        constraints: [MAX_CLAUSES]Clause,
        nconstraints: u32
    }

    // Answer set (stable model)
    struct AnswerSet {
        literals: LitList,
        proven: bool,
        cost: i32
    }

    fn blank_answer() -> AnswerSet {
        return AnswerSet { literals: lits_empty(), proven: false, cost: 0 }
    }

    // Result of solve (an array of answer sets in the Rust-like original)
    struct SolveResult {
        answers: [MAX_ANSWERS]AnswerSet,
        count: u32,
        steps: u32,
        trace_len: u32
    }

    // Create empty ASP program
    fn new_program() -> Program {
        let mut cl: [MAX_CLAUSES]Clause = undefined;
        let mut co: [MAX_CLAUSES]Clause = undefined;
        let mut k: u32 = 0;
        while k < MAX_CLAUSES {
            cl[k] = clause_empty();
            co[k] = clause_empty();
            k = k + 1;
        }
        return Program {
            clauses: cl,
            nclauses: 0,
            constraints: co,
            nconstraints: 0
        }
    }

    // Add clause to program (a full program is returned unchanged)
    fn add_clause(prog: Program, clause: Clause) -> Program {
        if prog.nclauses >= MAX_CLAUSES {
            return prog
        }
        let mut new_clauses = prog.clauses;
        new_clauses[prog.nclauses] = clause;
        return Program {
            clauses: new_clauses,
            nclauses: prog.nclauses + 1,
            constraints: prog.constraints,
            nconstraints: prog.nconstraints
        }
    }

    // Add constraint to program (a full program is returned unchanged)
    fn add_constraint(prog: Program, constraint: Clause) -> Program {
        if prog.nconstraints >= MAX_CLAUSES {
            return prog
        }
        let mut new_constraints = prog.constraints;
        new_constraints[prog.nconstraints] = constraint;
        return Program {
            clauses: prog.clauses,
            nclauses: prog.nclauses,
            constraints: new_constraints,
            nconstraints: prog.nconstraints + 1
        }
    }

    // Solve ASP program (find stable models)
    fn solve(prog: Program) -> SolveResult {
        let mut answers: [MAX_ANSWERS]AnswerSet = undefined;
        let mut a: u32 = 0;
        while a < MAX_ANSWERS {
            answers[a] = blank_answer();
            a = a + 1;
        }
        let mut found: u32 = 0;
        let mut trace_len: u32 = 0;

        // Bottom-up grounding and solving
        let mut step: u32 = 0;
        while step < MAX_ASP_STEPS {
            step = step + 1;

            // Find candidate model
            let candidate = find_stable_model(prog);
            if !candidate.proven {
                break
            }

            trace_len = trace_len + 1;  // asp_grounding

            // Verify stability
            let is_stable = verify_stability(prog, candidate);
            if is_stable {
                trace_len = trace_len + 2;  // asp_stability_verified, asp_answer_found
                answers[found] = candidate;
                found = found + 1;
                break
            }

            trace_len = trace_len + 1;  // asp_next_model
        }

        return SolveResult { answers: answers, count: found, steps: step, trace_len: trace_len }
    }

    // Find stable model through grounded reasoning
    fn find_stable_model(prog: Program) -> AnswerSet {
        // Try every subset of the program's literals (bounded: 2^MAX_LITS)
        let all_lits = extract_all_literals(prog);
        let total = combination_count(all_lits.count);

        let mut mask: u32 = 0;
        while mask < total {
            let candidate = combination_at(all_lits, mask);
            if satisfies_clauses(prog, candidate) && satisfies_constraints(prog, candidate) {
                let answer = AnswerSet { literals: candidate, proven: true, cost: 0 };
                return AnswerSet { literals: candidate, proven: true, cost: calculate_cost(answer) }
            }
            mask = mask + 1;
        }

        return blank_answer()
    }

    // Extract all literals from program
    fn extract_all_literals(prog: Program) -> LitList {
        let mut lits = lits_empty();

        let mut c: u32 = 0;
        while c < prog.nclauses {
            let clause = prog.clauses[c];
            let mut i: u32 = 0;
            while i < clause.count {
                if !literal_in_list(lits, clause.lits[i]) {
                    lits = lits_push(lits, clause.lits[i]);
                }
                i = i + 1;
            }
            c = c + 1;
        }

        let mut d: u32 = 0;
        while d < prog.nconstraints {
            let clause = prog.constraints[d];
            let mut i: u32 = 0;
            while i < clause.count {
                if !literal_in_list(lits, clause.lits[i]) {
                    lits = lits_push(lits, clause.lits[i]);
                }
                i = i + 1;
            }
            d = d + 1;
        }

        return lits
    }

    // Number of subsets of n literals: 2^n
    fn combination_count(n: u32) -> u32 {
        let mut total: u32 = 1;
        let mut k: u32 = 0;
        while k < n {
            total = total * 2;
            k = k + 1;
        }
        return total
    }

    // The subset of `literals` selected by the bits of `mask` (bit j keeps literal j)
    fn combination_at(literals: LitList, mask: u32) -> LitList {
        let mut combo = lits_empty();
        let mut rest: u32 = mask;
        let mut j: u32 = 0;
        while j < literals.count {
            if rest % 2 == 1 {
                combo = lits_push(combo, literals.items[j]);
            }
            rest = rest / 2;
            j = j + 1;
        }
        return combo
    }

    // Check if literal is in list (same name and arguments)
    fn literal_in_list(list: LitList, lit: Literal) -> bool {
        let mut i: u32 = 0;
        while i < list.count {
            let l = list.items[i];
            if str_eq(l.name, lit.name) && same_args(l, lit) {
                return true
            }
            i = i + 1;
        }
        return false
    }

    fn same_args(a: Literal, b: Literal) -> bool {
        if a.nargs != b.nargs {
            return false
        }
        let mut i: u32 = 0;
        while i < a.nargs {
            if !str_eq(a.args[i], b.args[i]) {
                return false
            }
            i = i + 1;
        }
        return true
    }

    // Check if candidate satisfies all clauses
    fn satisfies_clauses(prog: Program, candidate: LitList) -> bool {
        let mut c: u32 = 0;
        while c < prog.nclauses {
            if !satisfies_clause(prog.clauses[c], candidate) {
                return false
            }
            c = c + 1;
        }
        return true
    }

    // Check if candidate satisfies all constraints
    fn satisfies_constraints(prog: Program, candidate: LitList) -> bool {
        let mut c: u32 = 0;
        while c < prog.nconstraints {
            // Constraints must be false (no violation)
            if satisfies_clause(prog.constraints[c], candidate) {
                return false
            }
            c = c + 1;
        }
        return true
    }

    // Is a literal matching `lit` in the model
    fn model_has(model: LitList, lit: Literal) -> bool {
        let mut m: u32 = 0;
        while m < model.count {
            if literals_match(lit, model.items[m]) {
                return true
            }
            m = m + 1;
        }
        return false
    }

    // Check if clause is satisfied by candidate model
    fn satisfies_clause(clause: Clause, model: LitList) -> bool {
        let mut i: u32 = 0;
        while i < clause.count {
            if !model_has(model, clause.lits[i]) {
                return false
            }
            i = i + 1;
        }
        return true
    }

    // Check if two literals match (same atom and same sign)
    fn literals_match(a: Literal, b: Literal) -> bool {
        if !str_eq(a.name, b.name) {
            return false
        }
        if !same_args(a, b) {
            return false
        }

        // The signs must agree (the original returned false when they were equal)
        if a.is_negated != b.is_negated {
            return false
        }

        return true
    }

    // Verify stability of answer set
    fn verify_stability(prog: Program, answer: AnswerSet) -> bool {
        let model_literals = answer.literals;

        // Check each literal in model
        let mut i: u32 = 0;
        while i < model_literals.count {
            // If lit is in model, its negation should NOT be derivable
            let neg_lit = negate_literal(model_literals.items[i]);

            if is_derivable(prog, neg_lit, model_literals) {
                return false
            }
            i = i + 1;
        }

        return true
    }

    // Negate a literal
    fn negate_literal(lit: Literal) -> Literal {
        return Literal {
            name: lit.name,
            is_negated: !lit.is_negated,
            args: lit.args,
            nargs: lit.nargs
        }
    }

    // Check if literal is derivable from program and model
    fn is_derivable(prog: Program, lit: Literal, model: LitList) -> bool {
        // Check if lit is in model
        if model_has(model, lit) {
            return true
        }

        // Check if derivable through grounding: a clause containing lit is a
        // rule for lit, the other literals of the clause being its body
        let mut c: u32 = 0;
        while c < prog.nclauses {
            let clause = prog.clauses[c];
            let mut has_head = false;
            let mut all_body_true = true;

            let mut i: u32 = 0;
            while i < clause.count {
                let clause_lit = clause.lits[i];
                if literals_match(clause_lit, lit) {
                    has_head = true;
                } else if !model_has(model, clause_lit) {
                    // Body literal missing from the model
                    all_body_true = false;
                }
                i = i + 1;
            }

            if has_head && all_body_true {
                return true
            }
            c = c + 1;
        }

        return false
    }

    // Calculate cost of answer set
    fn calculate_cost(answer: AnswerSet) -> i32 {
        let mut cost: i32 = 0;
        let mut i: u32 = 0;
        while i < answer.literals.count {
            // Prefer positive literals
            if answer.literals.items[i].is_negated {
                cost = cost + 1;
            }
            i = i + 1;
        }
        return cost
    }

    // NAF (Negation as Failure) operator
    fn naf(prog: Program, lit: Literal) -> bool {
        // NAF returns true if lit is NOT derivable
        return !is_derivable(prog, lit, lits_empty())
    }

    // INVARIANTS

    // Stable model satisfies all clauses
    invariant stable_model_satisfies_clauses {
        @setEvalBranchQuota(2000000);
        let mut prog = new_program();
        let first = clause1(lit0("p", false));
        prog = add_clause(prog, first);

        let model = AnswerSet {
            literals: lits1(lit0("p", false)),
            proven: true,
            cost: 0
        };

        assert satisfies_clauses(prog, model.literals)
    }

    // NAF is dual of derivability
    invariant naf_dual_derivability {
        @setEvalBranchQuota(2000000);
        let mut prog = new_program();
        let clause = clause1(lit0("p", false));
        prog = add_clause(prog, clause);

        let lit = lit0("p", false);

        let derivable = is_derivable(prog, lit, lits_empty());
        let not_derivable = naf(prog, lit);

        assert derivable != not_derivable
    }

    // Cost of model is minimal for positive literals
    invariant minimal_positive_cost {
        @setEvalBranchQuota(2000000);
        let model = AnswerSet {
            literals: lits1(lit0("p", false)),
            proven: true,
            cost: 0
        };

        let alt_model = AnswerSet {
            literals: lits1(lit0("p", false)),
            proven: true,
            cost: 1
        };

        assert calculate_cost(model) <= calculate_cost(alt_model)
    }

    // Max ASP steps bound enforced
    invariant max_asp_steps_enforced {
        @setEvalBranchQuota(2000000000);
        let mut prog = new_program();
        // Add many clauses to require derivation
        let mut i: u32 = 0;
        while i < MAX_ASP_STEPS + 5 {
            let lit = lit0(NAME_TABLE[i], false);
            let clause = clause1(lit);
            prog = add_clause(prog, clause);
            i = i + 1;
        }

        let result = solve(prog);
        // Should find solution within MAX_ASP_STEPS
        assert result.steps <= MAX_ASP_STEPS;
        assert result.count == 1;
        assert result.answers[0].literals.count == MAX_ASP_STEPS + 5
    }

    // TESTS

    test new_program_creates_empty {
        let prog = new_program();
        assert prog.nclauses == 0;
        assert prog.nconstraints == 0
    }

    test add_clause_increments_count {
        let mut prog = new_program();
        let clause = clause1(lit0("p", false));
        prog = add_clause(prog, clause);
        assert prog.nclauses == 1
    }

    test add_constraint_increments_count {
        let mut prog = new_program();
        let constraint = clause1(lit0("p", false));
        prog = add_constraint(prog, constraint);
        assert prog.nconstraints == 1
    }

    test solve_finds_stable_model {
        let mut prog = new_program();
        let clause = clause1(lit0("p", false));
        prog = add_clause(prog, clause);
        let answers = solve(prog);
        assert answers.count >= 1;
        assert answers.answers[0].proven
    }

    test verify_stability_accepts_valid {
        let mut prog = new_program();
        let clause = clause1(lit0("p", false));
        prog = add_clause(prog, clause);

        let model = AnswerSet {
            literals: lits1(lit0("p", false)),
            proven: true,
            cost: 0
        };

        assert verify_stability(prog, model)
    }

    test verify_stability_rejects_unstable {
        let mut prog = new_program();
        let first = clause1(lit0("p", false));
        prog = add_clause(prog, first);
        // Add clause that forces both p and not_p to be true (unstable)
        let second = clause2(lit0("p", false), lit0("p", true));
        prog = add_clause(prog, second);

        let model = AnswerSet {
            literals: lits1(lit0("p", false)),
            proven: true,
            cost: 0
        };

        assert !verify_stability(prog, model)
    }

    test satisfies_clause_true_for_true_literal {
        let clause = clause1(lit0("p", false));
        let model = lits1(lit0("p", false));
        assert satisfies_clause(clause, model)
    }

    test satisfies_clause_false_for_missing_literal {
        let clause = clause1(lit0("p", false));
        let model = lits_empty();
        assert !satisfies_clause(clause, model)
    }

    test satisfies_clause_handles_negation {
        let clause = clause1(lit0("p", true));
        let model = lits1(lit0("p", true));
        assert satisfies_clause(clause, model)
    }

    test naf_returns_false_for_derivable {
        let mut prog = new_program();
        let clause = clause1(lit0("p", false));
        prog = add_clause(prog, clause);

        let lit = lit0("p", false);
        assert !naf(prog, lit)
    }

    test naf_returns_true_for_non_derivable {
        let prog = new_program();
        let lit = lit0("p", false);
        assert naf(prog, lit)  // p is not derivable
    }

    test calculate_cost_prefers_positive {
        let model1 = AnswerSet {
            literals: lits1(lit0("p", false)),
            proven: true,
            cost: 0
        };

        let model2 = AnswerSet {
            literals: lits1(lit0("p", true)),
            proven: true,
            cost: 1
        };

        assert calculate_cost(model1) < calculate_cost(model2)
    }

    test generate_combinations_creates_all_subsets {
        let lits = lits1(lit0("a", false));
        assert combination_count(lits.count) == 2;  // {}, {a}
        assert combination_at(lits, 0).count == 0;
        assert combination_at(lits, 1).count == 1
    }

    test generate_combinations_two_literals {
        let lits = lits2(lit0("a", false), lit0("b", false));
        assert combination_count(lits.count) == 4;  // {}, {a}, {b}, {a,b}
        assert combination_at(lits, 0).count == 0;
        assert combination_at(lits, 1).count == 1;
        assert combination_at(lits, 2).count == 1;
        assert str_eq(combination_at(lits, 2).items[0].name, "b");
        assert combination_at(lits, 3).count == 2
    }

    test literals_match_exact {
        let a = lit1("p", false, "x");
        let b = lit1("p", false, "x");
        assert literals_match(a, b)
    }

    test literals_match_different_name {
        let a = lit1("p", false, "x");
        let b = lit1("q", false, "x");
        assert !literals_match(a, b)
    }

    test literals_match_different_negation {
        let a = lit0("p", false);
        let b = lit0("p", true);
        assert !literals_match(a, b)
    }

    // BENCHMARKS

    bench solve_latency {
        // Target: <50μs for simple 2-literal program
    }

    bench grounding_latency {
        // Target: <10μs per clause
    }

    bench stability_check_latency {
        // Target: <20μs for verification
    }

    bench naf_latency {
        // Target: <15μs for NAF operator
    }
}
