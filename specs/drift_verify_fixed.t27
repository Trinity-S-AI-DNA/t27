spec dsh_config_drift_verify {
    config_drift_verify_skill {
        ; T27_DSH_CONFIG_DRIFT_VERIFY:
        ; Compare effective config with declared baseline as READ_ONLY skill
        ; Phase complete: Issue
        ; Phase 2: Spec

        
        name: "dsh-config-drift-verify"
        purpose: "Compare effective config with declared baseline"
        automation_level: "READ_ONLY"
        inputs: {
            effective_config: config_map {
                version: string
                timestamp: datetime
                sections: list<config_section> [
                    {
                        name: string
                        key_values: map<string, config_value> {
                            key: string
                            value: any
                            type: "string|number|boolean|object|array"
                            source: "default|override|environment|runtime"
                            validation: validation_result {
                                valid: bool
                                rules_applied: list<string>
                                error_message: string
                            }
                        }
                        metadata: map<string, any> {
                            source_path: string
                            last_modified: datetime
                            access_permissions: string
                            checksum: string
                        }
                    }
                ]
                config_hash: string
                signature: string
            }
            declared_baseline: config_map {
                version: string
                timestamp: datetime
                sections: list<config_section> [
                    {
                        name: string
                        key_values: map<string, config_value> {
                            key: string
                            value: any
                            type: "string|number|boolean|object|array"
                            source: "default|override|environment|runtime"
                            validation: validation_result {
                                valid: bool
                                rules_applied: list<string>
                                error_message: string
                            }
                        }
                        metadata: map<string, any> {
                            source_path: string
                            last_modified: datetime
                            access_permissions: string
                            checksum: string
                        }
                    }
                ]
                config_hash: string
                signature: string
            }
        }
        outputs: {
            drift_result: config_drift {
                comparison_timestamp: datetime
                effective_config_hash: string
                baseline_config_hash: string
                drift_detected: bool
                drift_severity: "none|low|medium|high|critical"
                sections_compared: int
                changed_sections: list<section_drift> [
                    {
                        section_name: string
                        baseline_values: map<string, config_value>
                        current_values: map<string, config_value>
                        changes: list<key_change> [
                            {
                                key: string
                                baseline_value: any
                                current_value: any
                                change_type: "added|removed|modified|type_changed"
                                severity: "low|medium|high"
                                impact: "functional|performance|security|operational"
                                justification_required: bool
                                approved_by: string
                            }
                        ]
                        unauthorized_changes: list<unauthorized_change> [
                            {
                                key: string
                                change_type: string
                                severity: string
                                business_rule: string
                                violation_description: string
                            }
                        ]
                    }
                ]
                security_impact: security_impact {
                    vulnerabilities_introduced: int
                            compliance_violations: list<string>
                            risk_score: float
                            recommendations: list<string>
                        }
                        performance_impact: performance_impact {
                            degradation_expected: bool
                            performance_change_percentage: float
                            affected_components: list<string>
                        }
                        summary: string
                        corrective_actions: list<string>
                        rollback_required: bool
                        baseline_version: string
                        current_version: string
                    }
                    exit_code: int
                }
                checks: [
                    "config_equals_baseline",
                    "no_unauthorized_changes"
                ]
                remediation: "config_revert"
            }

            test_skill config_validation {
                ; Verify: Input configurations are validated
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_invalid_config_map(),
                    declared_baseline: create_valid_config_map()
                })
                then executed.exit_code == 400
                then executed.outputs.drift_result.drift_detected == false
                then executed.outputs.drift_result.summary contains "invalid configuration"
            }

            test_skill hash_comparison {
                ; Verify: Configuration hashes are compared correctly
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_matching_config_map(),
                    declared_baseline: create_matching_config_map()
                })
                then executed.exit_code == 200
                then executed.outputs.drift_result.drift_detected == false
                then executed.outputs.drift_result.drift_severity == "none"
                then executed.outputs.drift_result.effective_config_hash == executed.outputs.drift_result.baseline_config_hash
            }

            test_skill drift_detection {
                ; Verify: Configuration drift is detected
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_modified_config_map(),
                    declared_baseline: create_baseline_config_map()
                })
                then executed.exit_code == 200
                then executed.outputs.drift_result.drift_detected == true
                then len(executed.outputs.drift_result.changed_sections) > 0
                then executed.outputs.drift_result.severity != "none"
            }

            test_skill unauthorized_change_detection {
                ; Verify: Unauthorized changes are detected
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_unauthorized_config_map(),
                    declared_baseline: create_baseline_config_map()
                })
                then executed.exit_code == 403
                then len(executed.outputs.drift_result.changed_sections[0].unauthorized_changes) > 0
                then executed.outputs.drift_result.drift_severity == "critical"
                then executed.outputs.drift_result.summary contains "unauthorized changes"
            }

            test_skill change_type_classification {
                ; Verify: Change types are classified correctly
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_multi_type_change_config_map(),
                    declared_baseline: create_baseline_config_map()
                })
                then executed.exit_code == 200
                then len(executed.outputs.drift_result.changed_sections[0].changes) >= 3
                then all_change_types_present(executed.outputs.drift_result.changed_sections[0].changes)
            }

            test_skill impact_assessment {
                ; Verify: Security and performance impacts are assessed
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_security_impact_config_map(),
                    declared_baseline: create_baseline_config_map()
                })
                then executed.exit_code == 200
                then executed.outputs.drift_result.security_impact.vulnerabilities_introduced > 0
                then executed.outputs.drift_result.security_impact.risk_score > 0.5
                then len(executed.outputs.drift_result.security_impact.recommendations) > 0
            }

            test_skill rollback_recommendation {
                ; Verify: Rollback requirement is determined correctly
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_critical_change_config_map(),
                    declared_baseline: create_baseline_config_map()
                })
                then executed.exit_code == 403
                then executed.outputs.drift_result.rollback_required == true
                then executed.outputs.drift_result.corrective_actions contains "immediate rollback"
            }

            test_skill baseline_version_tracking {
                ; Verify: Baseline versions are tracked
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_versioned_config_map("2.0.0"),
                    declared_baseline: create_baseline_config_map("1.0.0")
                })
                then executed.exit_code == 200
                then executed.outputs.drift_result.baseline_version == "1.0.0"
                then executed.outputs.drift_result.current_version == "2.0.0"
                then executed.outputs.drift_result.summary contains "version upgrade"
            }

            test_skill comprehensive_drift_report {
                ; Verify: Comprehensive drift reporting works
                given verify = create_config_drift_verify_skill()
                when executed = execute_skill(verify, { 
                    effective_config: create_complex_drift_config_map(),
                    declared_baseline: create_baseline_config_map()
                })
                then executed.exit_code == 200
                then len(executed.outputs.drift_result.changed_sections) >= 2
                then len(executed.outputs.drift_result.corrective_actions) > 0
                then executed.outputs.drift_result.summary != ""
            }

            invariant drift_schema_validity {
                ; Config drift outputs must conform to schema
                assert forall drift: config_drift,
                    drift.comparison_timestamp != "" and
                    drift.effective_config_hash != "" and
                    drift.baseline_config_hash != "" and
                    drift.drift_detected in [true, false] and
                    drift.drift_severity in ["none", "low", "medium", "high", "critical"] and
                    drift.sections_compared >= 0 and
                    len(drift.changed_sections) >= 0
            }

            invariant change_type_classification {
                ; Change types must be valid
                assert forall change: key_change,
                    change.change_type in ["added", "removed", "modified", "type_changed"] and
                    change.severity in ["low", "medium", "high"] and
                    change.impact in ["functional", "performance", "security", "operational"] and
                    change.justification_required in [true, false] and
                    change.key != ""
            }

            invariant severity_consistency {
                ; Drift severity must be consistent with changes
                assert forall drift: config_drift,
                    if drift.drift_detected == false then
                        drift.drift_severity == "none"
                    else if any unauthorized_changes in drift.changed_sections then
                        drift.drift_severity == "critical"
                    else if any high_severity_changes in drift.changed_sections then
                        drift.drift_severity in ["high", "critical"]
                    else if any medium_severity_changes in drift.changed_sections then
                        drift.drift_severity in ["medium", "high"]
                    else
                        drift.drift_severity in ["low", "medium"]
            }

            invariant impact_assessment_logic {
                ; Security impact assessment must be consistent
                assert forall drift: config_drift,
                    drift.security_impact.vulnerabilities_introduced >= 0 and
                    drift.security_impact.risk_score >= 0.0 and drift.security_impact.risk_score <= 1.0 and
                    (drift.security_impact.vulnerabilities_introduced > 0 implies 
                     drift.security_impact.risk_score > 0.0)
            }

            config_integrity_validation {
                ; All configurations must be structurally valid
                assert forall config: config_map,
                    config.version != "" and
                    config.timestamp != "" and
                    config.config_hash != "" and
                    len(config.sections) > 0 and
                    forall section: config_section in config.sections,
                        section.name != "" and
                        section.key_values.exists and
                        section.metadata.exists
            }

            ; Bench for config drift verification performance
            bench config_drift_verify_latency {
                ; Measure: Time to complete config drift verification
                target: < 100ms on typical hardware
                iterations: 1000
                setup: create_test_config_environment()
                measure: execute_config_drift_verify_skill(setup)
            }
        }