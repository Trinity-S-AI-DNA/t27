// SPDX-License-Identifier: Apache-2.0
; specs/ml/coding_eval/task_bank.t27 -- the FROZEN held-out .t27 coding eval for IGLA CODER
; (GOAL IGLA_CODER_WORKING_MODEL_END_TO_END_V1 step 2). 30 tasks, each a small pure function.
; 
; FREEZE RULES (no silent edits after any generation has been scored):
;   - a task fix is a VERSION bump: tasks_version := tasks_version + 1, and the baseline AND
;     candidate are re-scored on the same version; the old hash is recorded in the receipt;
;   - eval tasks, their reference solutions and near-copies never enter training/replay data;
;   - pass@1: exactly ONE generation per task, greedy (the model's documented deterministic
;     mode), no best-of-N selection.
; 
; SCORING LEVELS (all recorded per task):
;   decode_ok      the output decodes to bytes at all
;   parse_ok       the composed spec parses (t27c parse)
;   compile_ok     the composed spec compiles (t27c gen + zig build-exe of tests)
;   test_pass      every reference test in the composed spec passes (t27c test-report)
;   full_pass      parse_ok AND compile_ok AND test_pass
; pass@1 = full_pass count over the 30 tasks.
; 
; COMPOSED SPEC SHAPE the model must produce (stated in every prompt):
;   // SPDX-License-Identifier: Apache-2.0
;   module coding_eval_gen;
;   pub fn NAME(SIG) RET { ... }
; The harness concatenates the model's file with the reference test block of the task and runs
; t27c test-report on the composed file. Isolation: generation and scoring run with no network,
; no production credentials; the composed file is written under specs/ml/coding_eval/gen/ only.

module coding_eval_task_bank;

pub const TASKS_VERSION : u64 = 1;
pub const TASK_COUNT : u64 = 30;

pub const TASK_01_NAME : str = "add8";
pub const TASK_01_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn add8(a: i8, b: i8) i8 that returns the sum of a and b.";
pub const TASK_01_CHECK : str = "test add8_works { assert add8(2, 3) == 5; assert add8(-1, 1) == 0; assert add8(-5, -6) == -11; }";

pub const TASK_02_NAME : str = "sub8";
pub const TASK_02_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn sub8(a: i8, b: i8) i8 that returns a minus b.";
pub const TASK_02_CHECK : str = "test sub8_works { assert sub8(7, 2) == 5; assert sub8(2, 7) == -5; assert sub8(0, 0) == 0; }";

pub const TASK_03_NAME : str = "double8";
pub const TASK_03_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn double8(a: i8) i8 that returns a plus a.";
pub const TASK_03_CHECK : str = "test double8_works { assert double8(3) == 6; assert double8(-4) == -8; assert double8(0) == 0; }";

pub const TASK_04_NAME : str = "negate8";
pub const TASK_04_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn negate8(a: i8) i8 that returns the negation of a (0-a).";
pub const TASK_04_CHECK : str = "test negate8_works { assert negate8(5) == -5; assert negate8(-7) == 7; assert negate8(0) == 0; }";

pub const TASK_05_NAME : str = "square8";
pub const TASK_05_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn square8(a: i8) i8 that returns a times a. Tests only use -11..11 so the result fits i8.";
pub const TASK_05_CHECK : str = "test square8_works { assert square8(3) == 9; assert square8(-3) == 9; assert square8(0) == 0; assert square8(10) == 100; }";

pub const TASK_06_NAME : str = "is_even8";
pub const TASK_06_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn is_even8(a: i8) bool that returns true when a is even.";
pub const TASK_06_CHECK : str = "test is_even8_works { assert is_even8(4); assert !is_even8(5); assert is_even8(0); assert is_even8(-6); }";

pub const TASK_07_NAME : str = "is_positive8";
pub const TASK_07_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn is_positive8(a: i8) bool that returns true only when a is greater than 0.";
pub const TASK_07_CHECK : str = "test is_positive8_works { assert is_positive8(1); assert !is_positive8(0); assert !is_positive8(-3); }";

pub const TASK_08_NAME : str = "max8";
pub const TASK_08_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn max8(a: i8, b: i8) i8 that returns the larger of a and b (a when equal).";
pub const TASK_08_CHECK : str = "test max8_works { assert max8(3, 7) == 7; assert max8(7, 3) == 7; assert max8(-2, -9) == -2; assert max8(4, 4) == 4; }";

pub const TASK_09_NAME : str = "min8";
pub const TASK_09_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn min8(a: i8, b: i8) i8 that returns the smaller of a and b (a when equal).";
pub const TASK_09_CHECK : str = "test min8_works { assert min8(3, 7) == 3; assert min8(-2, -9) == -9; assert min8(5, 5) == 5; }";

pub const TASK_10_NAME : str = "abs8";
pub const TASK_10_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn abs8(a: i8) i8 that returns the absolute value of a. Tests only use -100..100 and never -128.";
pub const TASK_10_CHECK : str = "test abs8_works { assert abs8(5) == 5; assert abs8(-5) == 5; assert abs8(0) == 0; }";

pub const TASK_11_NAME : str = "sign8";
pub const TASK_11_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn sign8(a: i8) i8 that returns -1 when a is negative, 1 when a is positive, 0 when a is zero.";
pub const TASK_11_CHECK : str = "test sign8_works { assert sign8(-9) == -1; assert sign8(9) == 1; assert sign8(0) == 0; }";

pub const TASK_12_NAME : str = "is_zero8";
pub const TASK_12_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn is_zero8(a: i8) bool that returns true only when a equals 0.";
pub const TASK_12_CHECK : str = "test is_zero8_works { assert is_zero8(0); assert !is_zero8(1); assert !is_zero8(-1); }";

pub const TASK_13_NAME : str = "or_b";
pub const TASK_13_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn or_b(a: bool, b: bool) bool that returns the logical or of a and b.";
pub const TASK_13_CHECK : str = "test or_b_works { assert or_b(false, true); assert or_b(true, false); assert !or_b(false, false); assert or_b(true, true); }";

pub const TASK_14_NAME : str = "and_b";
pub const TASK_14_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn and_b(a: bool, b: bool) bool that returns the logical and of a and b.";
pub const TASK_14_CHECK : str = "test and_b_works { assert and_b(true, true); assert !and_b(true, false); assert !and_b(false, false); }";

pub const TASK_15_NAME : str = "not_b";
pub const TASK_15_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn not_b(a: bool) bool that returns the logical negation of a.";
pub const TASK_15_CHECK : str = "test not_b_works { assert not_b(false); assert !not_b(true); }";

pub const TASK_16_NAME : str = "xor_b";
pub const TASK_16_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn xor_b(a: bool, b: bool) bool that returns true exactly when a and b differ.";
pub const TASK_16_CHECK : str = "test xor_b_works { assert xor_b(true, false); assert xor_b(false, true); assert !xor_b(true, true); assert !xor_b(false, false); }";

pub const TASK_17_NAME : str = "max3_8";
pub const TASK_17_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn max3_8(a: i8, b: i8, c: i8) i8 that returns the largest of the three values.";
pub const TASK_17_CHECK : str = "test max3_8_works { assert max3_8(1, 2, 3) == 3; assert max3_8(9, 2, 3) == 9; assert max3_8(-1, -2, -3) == -1; }";

pub const TASK_18_NAME : str = "within8";
pub const TASK_18_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn within8(x: i8, lo: i8, hi: i8) bool that returns true when lo <= x and x <= hi.";
pub const TASK_18_CHECK : str = "test within8_works { assert within8(5, 1, 10); assert within8(1, 1, 10); assert within8(10, 1, 10); assert !within8(11, 1, 10); assert !within8(0, 1, 10); }";

pub const TASK_19_NAME : str = "sum_to8";
pub const TASK_19_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn sum_to8(n: i8) i8 that returns 1+2+...+n for n in 0..20 (0 for n <= 0). A while loop may be used.";
pub const TASK_19_CHECK : str = "test sum_to8_works { assert sum_to8(0) == 0; assert sum_to8(1) == 1; assert sum_to8(5) == 15; assert sum_to8(10) == 55; assert sum_to8(-3) == 0; }";

pub const TASK_20_NAME : str = "inc8";
pub const TASK_20_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn inc8(a: i8) i8 that returns a plus 1.";
pub const TASK_20_CHECK : str = "test inc8_works { assert inc8(0) == 1; assert inc8(-1) == 0; assert inc8(41) == 42; }";

pub const TASK_21_NAME : str = "dec8";
pub const TASK_21_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn dec8(a: i8) i8 that returns a minus 1.";
pub const TASK_21_CHECK : str = "test dec8_works { assert dec8(1) == 0; assert dec8(0) == -1; assert dec8(-41) == -42; }";

pub const TASK_22_NAME : str = "clamp0_100";
pub const TASK_22_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn clamp0_100(a: i8) i8 that returns a clamped into 0..100 (0 below, 100 above).";
pub const TASK_22_CHECK : str = "test clamp0_100_works { assert clamp0_100(-5) == 0; assert clamp0_100(42) == 42; assert clamp0_100(120) == 100; assert clamp0_100(0) == 0; assert clamp0_100(100) == 100; }";

pub const TASK_23_NAME : str = "mod2_8";
pub const TASK_23_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn mod2_8(a: i8) i8 that returns the remainder of a divided by 2 (0 or 1 for even/odd non-negative; tests use 0..99 only).";
pub const TASK_23_CHECK : str = "test mod2_8_works { assert mod2_8(0) == 0; assert mod2_8(1) == 1; assert mod2_8(6) == 0; assert mod2_8(9) == 1; }";

pub const TASK_24_NAME : str = "u8_max";
pub const TASK_24_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn u8_max(a: u8, b: u8) u8 that returns the larger of the two unsigned bytes.";
pub const TASK_24_CHECK : str = "test u8_max_works { assert u8_max(3, 7) == 7; assert u8_max(200, 1) == 200; assert u8_max(0, 0) == 0; }";

pub const TASK_25_NAME : str = "u8_min";
pub const TASK_25_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn u8_min(a: u8, b: u8) u8 that returns the smaller of the two unsigned bytes.";
pub const TASK_25_CHECK : str = "test u8_min_works { assert u8_min(3, 7) == 3; assert u8_min(200, 1) == 1; assert u8_min(9, 9) == 9; }";

pub const TASK_26_NAME : str = "is_leap_word";
pub const TASK_26_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn is_leap_word(y: i32) bool that returns true when the year y is a leap year: divisible by 4, except centuries not divisible by 400.";
pub const TASK_26_CHECK : str = "test is_leap_word_works { assert is_leap_word(2000); assert is_leap_word(2024); assert !is_leap_word(1900); assert !is_leap_word(2023); }";

pub const TASK_27_NAME : str = "tri_sign";
pub const TASK_27_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn tri_sign(a: i32) i32 that returns -5 when a is negative, 5 when a is positive, 0 when a is zero.";
pub const TASK_27_CHECK : str = "test tri_sign_works { assert tri_sign(-100) == -5; assert tri_sign(7) == 5; assert tri_sign(0) == 0; }";

pub const TASK_28_NAME : str = "half_even8";
pub const TASK_28_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn half_even8(a: i8) i8 that returns a divided by 2 using integer division for even a in 0..100 (tests use even values only).";
pub const TASK_28_CHECK : str = "test half_even8_works { assert half_even8(4) == 2; assert half_even8(0) == 0; assert half_even8(100) == 50; }";

pub const TASK_29_NAME : str = "biggest_word";
pub const TASK_29_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn biggest_word(a: i32, b: i32) i32 that returns the larger of the two 32-bit integers (a when equal).";
pub const TASK_29_CHECK : str = "test biggest_word_works { assert biggest_word(1, 2) == 2; assert biggest_word(-9, -3) == -3; assert biggest_word(500000, 499999) == 500000; }";

pub const TASK_30_NAME : str = "nonneg8";
pub const TASK_30_PROMPT : str = "Write a complete .t27 file. First line: // SPDX-License-Identifier: Apache-2.0. Second line: module coding_eval_gen; Then define: pub fn nonneg8(a: i8) bool that returns true when a is 0 or positive.";
pub const TASK_30_CHECK : str = "test nonneg8_works { assert nonneg8(0); assert nonneg8(9); assert !nonneg8(-1); }";

; The frozen reference-test block count, pinned so a silent task removal moves the gate.
pub const CHECK_COUNT : u64 = 30;

pub fn bank_is_complete() -> bool {
    return CHECK_COUNT == TASK_COUNT;
}

pub fn tasks_version_is_frozen_v1() -> bool {
    return TASKS_VERSION == 1;
}

pub fn bank_size_reported() -> u64 {
    return TASK_COUNT;
}

test the_bank_freezes_thirty_tasks_v1 {
    assert bank_is_complete();
    assert tasks_version_is_frozen_v1();
    assert bank_size_reported() == 30;
}
