// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/transformer/norm.t27
// Layer Normalization with φ-optimized β/γ | φ² + 1/φ² = 3 | TRINITY

module LayerNorm;
    use base::types;
    use math::constants;
    use numeric::gf16;

    // The arithmetic below is done on f64 values. A GF16 value is a 16-bit
    // pattern (u16) that has no arithmetic of its own, so the tensors of this
    // module hold f64 and the GF16 format stays at the storage boundary.
    // Every tensor lives in a buffer the caller provides (the dialect has no
    // allocator); a returned slice is a view of one of those buffers.

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    // Phi-based constants for numerical stability
    const PHI : f64 = 1.618033988749895;
    const INV_PHI_SQUARED : f64 = 1.0 / (PHI * PHI); // ≈ 0.381966
    const PHI_EPSILON : f64 = 1e-5 / PHI; // ≈ 6.18e-6, phi-optimized epsilon

    // Default epsilon for numerical stability
    const DEFAULT_EPSILON : f64 = 1e-5;

    // Strand partition constants
    const STRAND_I_START : u32 = 0;
    const STRAND_I_END : u32 = 64;
    const STRAND_II_START : u32 = 64;
    const STRAND_II_END : u32 = 128;
    const STRAND_III_START : u32 = 128;
    const STRAND_III_END : u32 = 192;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const NormConfig = struct {
        hidden_size : u32,      // Size of the hidden dimension
        eps : f64,              // Epsilon for numerical stability
        elementwise_affine : bool, // Whether to use learnable β and γ
        use_phi_init : bool,    // Whether to use phi-based initialization
        strand_mode : bool,     // Enable strand partitioning
    };

    pub const NormState = struct {
        gamma : []f64,          // Learnable scale parameter (γ)
        beta : []f64,           // Learnable shift parameter (β)
        mean : []f64,           // Running mean (for inference)
        variance : []f64,       // Running variance (for inference)
        is_training : bool,     // Training/inference mode flag
        momentum : f64,         // Momentum for running statistics
        affine : bool,          // Copy of config.elementwise_affine
    };

    pub const NormGradients = struct {
        d_gamma : []f64,        // Gradient wrt γ
        d_beta : []f64,         // Gradient wrt β
        d_input : []f64,        // Gradient wrt the layer input
    };

    pub const Strand = struct {
        id : u32,               // Strand ID: 0 (I), 1 (II), 2 (III)
        start : u32,            // Start index in hidden dimension
        end : u32,              // End index in hidden dimension
        gamma : []f64,          // Strand-local γ
        beta : []f64,           // Strand-local β
        phi_gamma_offset : f64, // Phi-based offset for this strand
        phi_beta_offset : f64,  // Phi-based offset for this strand
    };

    pub const ForwardResult = struct {
        output : []f64,         // Normalized output
        mean : f64,             // Computed mean (for backward)
        variance : f64,         // Computed variance (for backward)
        centered : []f64,       // Input - mean (for backward)
        normalized : []f64,     // Centered / sqrt(var + eps) (for backward)
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // compute_mean(x: []f64) → f64 : μ = (1/n) * Σ x_i
    fn compute_mean(x: []f64) -> f64 {
        if (x.len() == 0) {
            return 0.0;
        }
        var total : f64 = 0.0;
        for (i in 0..x.len()) {
            total += x[i];
        }
        return total / @as(f64, @floatFromInt(x.len()));
    }

    // compute_variance(x: []f64, mean: f64) → f64 : σ² = (1/n) * Σ (x_i - μ)²
    fn compute_variance(x: []f64, mean: f64) -> f64 {
        if (x.len() == 0) {
            return 0.0;
        }
        var total : f64 = 0.0;
        for (i in 0..x.len()) {
            let d = x[i] - mean;
            total += d * d;
        }
        return total / @as(f64, @floatFromInt(x.len()));
    }

    // sum_array(x: []f64) → f64
    fn sum_array(x: []f64) -> f64 {
        var total : f64 = 0.0;
        for (i in 0..x.len()) {
            total += x[i];
        }
        return total;
    }

    // is_finite(x: f64) → bool : false for NaN and for both infinities
    fn is_finite(x: f64) -> bool {
        return x - x == 0.0;
    }

    // all_finite(x: []f64) → bool
    fn all_finite(x: []f64) -> bool {
        for (i in 0..x.len()) {
            if (is_finite(x[i]) == false) {
                return false;
            }
        }
        return true;
    }

    // all_zero(x: []f64) → bool
    fn all_zero(x: []f64) -> bool {
        for (i in 0..x.len()) {
            if (x[i] != 0.0) {
                return false;
            }
        }
        return true;
    }

    // all_positive(x: []f64) → bool
    fn all_positive(x: []f64) -> bool {
        for (i in 0..x.len()) {
            if (x[i] <= 0.0) {
                return false;
            }
        }
        return true;
    }

    // init(config, gamma, beta, mean, variance) → NormState
    // Initializes layer norm state with phi-optimized parameters. The four
    // buffers must hold at least config.hidden_size values each.
    fn init(config: NormConfig, gamma: []f64, beta: []f64, mean: []f64, variance: []f64) -> NormState {
        let n = config.hidden_size as usize;

        for (i in 0..n) {
            mean[i] = 0.0;
            variance[i] = 0.0;
            if (config.use_phi_init) {
                gamma[i] = 1.0 + @as(f64, @floatFromInt(i % 3)) * INV_PHI_SQUARED * 0.1;
                beta[i] = @as(f64, @floatFromInt(i % 3)) * PHI * 0.01;
            } else {
                gamma[i] = 1.0;
                beta[i] = 0.0;
            }
        }

        return NormState{
            .gamma = gamma[0..n],
            .beta = beta[0..n],
            .mean = mean[0..n],
            .variance = variance[0..n],
            .is_training = true,
            .momentum = 0.1,
            .affine = config.elementwise_affine,
        };
    }

    // forward(state, input, output, centered, normalized) → ForwardResult
    // Computes layer normalization: output = γ * (x - μ) / √(σ² + ε) + β
    // (just x̂ when the state is not affine). The three buffers must hold at
    // least input.len() values.
    fn forward(state: NormState, input: []f64, output: []f64, centered: []f64, normalized: []f64) -> ForwardResult {
        let n = input.len();

        // 1. Compute mean: μ = (1/n) * Σ x_i
        let mean = compute_mean(input);

        // 2. Compute variance: σ² = (1/n) * Σ (x_i - μ)²
        let variance = compute_variance(input, mean);

        // 3. Normalize: x̂ = (x - μ) / √(σ² + ε)
        let std_dev = @sqrt(variance + DEFAULT_EPSILON);

        for (i in 0..n) {
            centered[i] = input[i] - mean;
            normalized[i] = centered[i] / std_dev;
            if (state.affine) {
                output[i] = state.gamma[i] * normalized[i] + state.beta[i];
            } else {
                output[i] = normalized[i];
            }
        }

        return ForwardResult{
            .output = output[0..n],
            .mean = mean,
            .variance = variance,
            .centered = centered[0..n],
            .normalized = normalized[0..n],
        };
    }

    // forward_strand(strand, input, output, centered, normalized) → ForwardResult
    // Strand-local forward pass for parallel processing. The three buffers
    // must hold at least strand.end - strand.start values.
    fn forward_strand(strand: Strand, input: []f64, output: []f64, centered: []f64, normalized: []f64) -> ForwardResult {
        let lo = strand.start as usize;
        let hi = strand.end as usize;
        let n = hi - lo;

        // Strand-local view of the input
        let strand_input = input[lo..hi];

        // 1. Compute mean: μ = (1/n) * Σ x_i
        let mean = compute_mean(strand_input);

        // 2. Compute variance: σ² = (1/n) * Σ (x_i - μ)²
        let variance = compute_variance(strand_input, mean);

        // 3. Normalize: x̂ = (x - μ) / √(σ² + ε)
        let std_dev = @sqrt(variance + PHI_EPSILON);

        for (i in 0..n) {
            centered[i] = strand_input[i] - mean;
            normalized[i] = centered[i] / std_dev;

            // Apply phi-optimized gamma and beta
            let effective_gamma = strand.gamma[i] + strand.phi_gamma_offset;
            let effective_beta = strand.beta[i] + strand.phi_beta_offset;
            output[i] = effective_gamma * normalized[i] + effective_beta;
        }

        return ForwardResult{
            .output = output[0..n],
            .mean = mean,
            .variance = variance,
            .centered = centered[0..n],
            .normalized = normalized[0..n],
        };
    }

    // backward(state, result, grad_output, d_gamma, d_beta, d_input) → NormGradients
    // Computes gradients for backpropagation. A state that is not affine has
    // no learnable parameters, so its parameter gradients are zero.
    fn backward(state: NormState, result: ForwardResult, grad_output: []f64, d_gamma: []f64, d_beta: []f64, d_input: []f64) -> NormGradients {
        let n = grad_output.len();
        let nf = @as(f64, @floatFromInt(n));
        let std_dev = @sqrt(result.variance + DEFAULT_EPSILON);

        // Σ grad_output and Σ (grad_output * normalized)
        var sum_grad_output : f64 = 0.0;
        var sum_grad_output_normalized : f64 = 0.0;
        for (i in 0..n) {
            sum_grad_output += grad_output[i];
            sum_grad_output_normalized += grad_output[i] * result.normalized[i];
        }

        for (i in 0..n) {
            // d_γ = grad_output * normalized, d_β = grad_output
            if (state.affine) {
                d_gamma[i] = grad_output[i] * result.normalized[i];
                d_beta[i] = grad_output[i];
            } else {
                d_gamma[i] = 0.0;
                d_beta[i] = 0.0;
            }

            // d_x using the full gradient formula
            let term1 = nf * grad_output[i];
            let term2 = sum_grad_output;
            let term3 = result.normalized[i] * sum_grad_output_normalized;
            d_input[i] = (state.gamma[i] / std_dev) * (term1 - term2 - term3) / nf;
        }

        return NormGradients{
            .d_gamma = d_gamma[0..n],
            .d_beta = d_beta[0..n],
            .d_input = d_input[0..n],
        };
    }

    // backward_strand(strand, result, grad_output, d_gamma, d_beta, d_input) → NormGradients
    // Strand-local backward pass.
    fn backward_strand(strand: Strand, result: ForwardResult, grad_output: []f64, d_gamma: []f64, d_beta: []f64, d_input: []f64) -> NormGradients {
        let lo = strand.start as usize;
        let hi = strand.end as usize;
        let n = hi - lo;
        let nf = @as(f64, @floatFromInt(n));
        let std_dev = @sqrt(result.variance + PHI_EPSILON);

        // Strand-local view of grad_output
        let strand_grad_output = grad_output[lo..hi];

        var sum_grad_output : f64 = 0.0;
        var sum_grad_output_normalized : f64 = 0.0;
        for (i in 0..n) {
            sum_grad_output += strand_grad_output[i];
            sum_grad_output_normalized += strand_grad_output[i] * result.normalized[i];
        }

        for (i in 0..n) {
            d_gamma[i] = strand_grad_output[i] * result.normalized[i];
            d_beta[i] = strand_grad_output[i];

            let term1 = nf * strand_grad_output[i];
            let term2 = sum_grad_output;
            let term3 = result.normalized[i] * sum_grad_output_normalized;
            d_input[i] = (strand.gamma[i] / std_dev) * (term1 - term2 - term3) / nf;
        }

        return NormGradients{
            .d_gamma = d_gamma[0..n],
            .d_beta = d_beta[0..n],
            .d_input = d_input[0..n],
        };
    }

    // update(state, grads, lr, new_gamma, new_beta) → NormState
    // Updates learnable parameters using computed gradients.
    fn update(state: NormState, grads: NormGradients, lr: f64, new_gamma: []f64, new_beta: []f64) -> NormState {
        let n = state.gamma.len();

        for (i in 0..n) {
            new_gamma[i] = state.gamma[i] - lr * grads.d_gamma[i];
            new_beta[i] = state.beta[i] - lr * grads.d_beta[i];
        }

        return NormState{
            .gamma = new_gamma[0..n],
            .beta = new_beta[0..n],
            .mean = state.mean,
            .variance = state.variance,
            .is_training = state.is_training,
            .momentum = state.momentum,
            .affine = state.affine,
        };
    }

    // normalize_vector(x: []f64, eps: f64, out: []f64) → []f64
    // Utility function to normalize a vector without affine transform.
    fn normalize_vector(x: []f64, eps: f64, out: []f64) -> []f64 {
        let n = x.len();
        let mean = compute_mean(x);
        let variance = compute_variance(x, mean);
        let std_dev = @sqrt(variance + eps);

        for (i in 0..n) {
            out[i] = (x[i] - mean) / std_dev;
        }

        return out[0..n];
    }

    // ═══════════════════════════════════════════════════════════
    // 4. Phi-Optimized Functions
    // ═══════════════════════════════════════════════════════════

    // phi_init_gamma(hidden_size: u32, out: []f64) → []f64
    // Initialize γ with phi-based pattern.
    fn phi_init_gamma(hidden_size: u32, out: []f64) -> []f64 {
        let n = hidden_size as usize;

        for (i in 0..n) {
            out[i] = 1.0 + @as(f64, @floatFromInt(i % 3)) * INV_PHI_SQUARED * 0.1;
        }

        return out[0..n];
    }

    // phi_init_beta(hidden_size: u32, out: []f64) → []f64
    // Initialize β with phi-based pattern.
    fn phi_init_beta(hidden_size: u32, out: []f64) -> []f64 {
        let n = hidden_size as usize;

        for (i in 0..n) {
            out[i] = @as(f64, @floatFromInt(i % 3)) * PHI * 0.01;
        }

        return out[0..n];
    }

    // phi_normalize(x: f64, mean: f64, variance: f64) -> f64
    // Phi-optimized normalization with reduced numerical error.
    fn phi_normalize(x: f64, mean: f64, variance: f64) -> f64 {
        return (x - mean) / @sqrt(variance + PHI_EPSILON);
    }

    // create_strands(hidden_size, gamma, beta) → [3]Strand
    // Create 3 strands for parallel processing.
    fn create_strands(hidden_size: u32, gamma: []f64, beta: []f64) -> [3]Strand {
        let strand_size = hidden_size / 3;
        var strands : [3]Strand = undefined;

        // Strand I: [0, hidden_size/3)
        strands[0] = Strand{
            .id = 0,
            .start = 0,
            .end = strand_size,
            .gamma = gamma[0..(strand_size as usize)],
            .beta = beta[0..(strand_size as usize)],
            .phi_gamma_offset = 0.0,
            .phi_beta_offset = 0.0,
        };

        // Strand II: [hidden_size/3, 2*hidden_size/3)
        strands[1] = Strand{
            .id = 1,
            .start = strand_size,
            .end = 2 * strand_size,
            .gamma = gamma[(strand_size as usize)..((2 * strand_size) as usize)],
            .beta = beta[(strand_size as usize)..((2 * strand_size) as usize)],
            .phi_gamma_offset = INV_PHI_SQUARED * 0.1,
            .phi_beta_offset = INV_PHI_SQUARED * 0.1,
        };

        // Strand III: [2*hidden_size/3, hidden_size)
        strands[2] = Strand{
            .id = 2,
            .start = 2 * strand_size,
            .end = hidden_size,
            .gamma = gamma[((2 * strand_size) as usize)..(hidden_size as usize)],
            .beta = beta[((2 * strand_size) as usize)..(hidden_size as usize)],
            .phi_gamma_offset = 2.0 * INV_PHI_SQUARED * 0.1,
            .phi_beta_offset = 2.0 * INV_PHI_SQUARED * 0.1,
        };

        return strands;
    }

    // Runtime views of the constants, so that a test about a constant
    // asserts at run time rather than at compile time.
    fn phi_value() -> f64 {
        return PHI;
    }
    fn inv_phi_squared_value() -> f64 {
        return INV_PHI_SQUARED;
    }
    fn phi_epsilon_value() -> f64 {
        return PHI_EPSILON;
    }
    fn default_epsilon_value() -> f64 {
        return DEFAULT_EPSILON;
    }

    // fill_test_input(out: []f64) : deterministic input in [-6, 6], period 64
    fn fill_test_input(out: []f64) -> void {
        for (i in 0..out.len()) {
            out[i] = @as(f64, @floatFromInt(((i % 64) * 7) % 13)) - 6.0;
        }
    }

    fn abs_diff(a: f64, b: f64) -> f64 {
        return @abs(a - b);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════
    test init_creates_correct_dimensions {
        var g : [128]f64 = [0.0] ** 128;
        var b : [128]f64 = [0.0] ** 128;
        var m : [128]f64 = [0.0] ** 128;
        var v : [128]f64 = [0.0] ** 128;
        var config = NormConfig{ .hidden_size = 128, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        assert(state.gamma.len() == 128);
        assert(state.beta.len() == 128);
        assert(state.gamma[127] == 1.0);
        assert(state.beta[127] == 0.0);
    }

    test init_with_phi_init_creates_patterned_gamma {
        var g : [9]f64 = [0.0] ** 9;
        var b : [9]f64 = [0.0] ** 9;
        var m : [9]f64 = [0.0] ** 9;
        var v : [9]f64 = [0.0] ** 9;
        var config = NormConfig{ .hidden_size = 9, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = true, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        assert(abs_diff(state.gamma[0], 1.0) < 1e-9);
        assert(abs_diff(state.gamma[1], 1.0 + inv_phi_squared_value() * 0.1) < 1e-9);
        assert(abs_diff(state.gamma[2], 1.0 + 2.0 * inv_phi_squared_value() * 0.1) < 1e-9);
        assert(abs_diff(state.gamma[3], 1.0) < 1e-9);
        assert(abs_diff(state.gamma[8], 1.0 + 2.0 * inv_phi_squared_value() * 0.1) < 1e-9);
    }

    test init_with_phi_init_creates_patterned_beta {
        var g : [9]f64 = [0.0] ** 9;
        var b : [9]f64 = [0.0] ** 9;
        var m : [9]f64 = [0.0] ** 9;
        var v : [9]f64 = [0.0] ** 9;
        var config = NormConfig{ .hidden_size = 9, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = true, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        assert(abs_diff(state.beta[0], 0.0) < 1e-9);
        assert(abs_diff(state.beta[1], phi_value() * 0.01) < 1e-9);
        assert(abs_diff(state.beta[2], 2.0 * phi_value() * 0.01) < 1e-9);
        assert(abs_diff(state.beta[5], 2.0 * phi_value() * 0.01) < 1e-9);
    }

    test forward_normalizes_to_unit_variance {
        var g : [4]f64 = [0.0] ** 4;
        var b : [4]f64 = [0.0] ** 4;
        var m : [4]f64 = [0.0] ** 4;
        var v : [4]f64 = [0.0] ** 4;
        var o : [4]f64 = [0.0] ** 4;
        var c : [4]f64 = [0.0] ** 4;
        var nz : [4]f64 = [0.0] ** 4;
        var config = NormConfig{ .hidden_size = 4, .eps = 1e-5, .elementwise_affine = false, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        var input = []f64{ 1.0, 2.0, 3.0, 4.0 };
        var result = forward(state, input, &o, &c, &nz);
        let nmean = compute_mean(result.normalized);
        assert(abs_diff(compute_variance(result.normalized, nmean), 1.0) < 1e-4);
        assert(abs_diff(result.mean, 2.5) < 1e-12);
        assert(abs_diff(result.variance, 1.25) < 1e-12);
    }

    test forward_centers_to_zero_mean {
        var g : [4]f64 = [0.0] ** 4;
        var b : [4]f64 = [0.0] ** 4;
        var m : [4]f64 = [0.0] ** 4;
        var v : [4]f64 = [0.0] ** 4;
        var o : [4]f64 = [0.0] ** 4;
        var c : [4]f64 = [0.0] ** 4;
        var nz : [4]f64 = [0.0] ** 4;
        var config = NormConfig{ .hidden_size = 4, .eps = 1e-5, .elementwise_affine = false, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        var input = []f64{ 1.0, 2.0, 3.0, 4.0 };
        var result = forward(state, input, &o, &c, &nz);
        assert(abs_diff(compute_mean(result.normalized), 0.0) < 1e-6);
        assert(abs_diff(compute_mean(result.centered), 0.0) < 1e-6);
        assert(result.normalized[0] < 0.0);
        assert(result.normalized[3] > 0.0);
    }

    test forward_with_affine_applies_gamma_and_beta {
        var g : [2]f64 = [0.0] ** 2;
        var b : [2]f64 = [0.0] ** 2;
        var m : [2]f64 = [0.0] ** 2;
        var v : [2]f64 = [0.0] ** 2;
        var o : [2]f64 = [0.0] ** 2;
        var c : [2]f64 = [0.0] ** 2;
        var nz : [2]f64 = [0.0] ** 2;
        var config = NormConfig{ .hidden_size = 2, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        state.gamma[0] = 2.0;
        state.gamma[1] = 3.0;
        state.beta[0] = 1.0;
        state.beta[1] = -1.0;
        var input = []f64{ 0.0, 0.0 };
        var result = forward(state, input, &o, &c, &nz);
        assert(abs_diff(result.output[0], 1.0) < 1e-9); // 2.0 * 0 + 1.0
        assert(abs_diff(result.output[1], -1.0) < 1e-9); // 3.0 * 0 - 1.0
    }

    test forward_with_constant_input {
        var g : [4]f64 = [0.0] ** 4;
        var b : [4]f64 = [0.0] ** 4;
        var m : [4]f64 = [0.0] ** 4;
        var v : [4]f64 = [0.0] ** 4;
        var o : [4]f64 = [0.0] ** 4;
        var c : [4]f64 = [0.0] ** 4;
        var nz : [4]f64 = [0.0] ** 4;
        var config = NormConfig{ .hidden_size = 4, .eps = 1e-5, .elementwise_affine = false, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        var input = []f64{ 5.0, 5.0, 5.0, 5.0 };
        var result = forward(state, input, &o, &c, &nz);
        assert(result.variance == 0.0);
        assert(result.mean == 5.0);
        assert(all_zero(result.normalized));
    }

    test backward_computes_correct_gradients {
        var g : [2]f64 = [0.0] ** 2;
        var b : [2]f64 = [0.0] ** 2;
        var m : [2]f64 = [0.0] ** 2;
        var v : [2]f64 = [0.0] ** 2;
        var o : [2]f64 = [0.0] ** 2;
        var c : [2]f64 = [0.0] ** 2;
        var nz : [2]f64 = [0.0] ** 2;
        var dg : [2]f64 = [0.0] ** 2;
        var db : [2]f64 = [0.0] ** 2;
        var di : [2]f64 = [0.0] ** 2;
        var config = NormConfig{ .hidden_size = 2, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        var input = []f64{ 1.0, -1.0 };
        var forward_result = forward(state, input, &o, &c, &nz);
        var grad_output = []f64{ 1.0, 1.0 };
        var grads = backward(state, forward_result, grad_output, &dg, &db, &di);
        assert(grads.d_beta.len() == 2);
        assert(grads.d_gamma.len() == 2);
        assert(grads.d_input.len() == 2);
        // d_beta = grad_output; d_gamma = grad_output * normalized = +-1/sqrt(1 + eps)
        assert(abs_diff(grads.d_beta[0], 1.0) < 1e-12);
        assert(abs_diff(grads.d_beta[1], 1.0) < 1e-12);
        assert(abs_diff(grads.d_gamma[0], 1.0) < 1e-4);
        assert(abs_diff(grads.d_gamma[1], -1.0) < 1e-4);
        // A constant upstream gradient is removed by the normalization.
        assert(abs_diff(grads.d_input[0], 0.0) < 1e-9);
        assert(abs_diff(grads.d_input[1], 0.0) < 1e-9);
    }

    test backward_with_affine_false_has_zero_parameter_gradients {
        var g : [4]f64 = [0.0] ** 4;
        var b : [4]f64 = [0.0] ** 4;
        var m : [4]f64 = [0.0] ** 4;
        var v : [4]f64 = [0.0] ** 4;
        var o : [4]f64 = [0.0] ** 4;
        var c : [4]f64 = [0.0] ** 4;
        var nz : [4]f64 = [0.0] ** 4;
        var dg : [4]f64 = [7.0] ** 4;
        var db : [4]f64 = [7.0] ** 4;
        var di : [4]f64 = [7.0] ** 4;
        var config = NormConfig{ .hidden_size = 4, .eps = 1e-5, .elementwise_affine = false, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        var input = []f64{ 1.0, 2.0, 3.0, 4.0 };
        var forward_result = forward(state, input, &o, &c, &nz);
        var grad_output = []f64{ 1.0, 1.0, 1.0, 1.0 };
        var grads = backward(state, forward_result, grad_output, &dg, &db, &di);
        assert(grads.d_gamma.len() == 4);
        assert(all_zero(grads.d_gamma));
        assert(all_zero(grads.d_beta));
        assert(abs_diff(grads.d_input[2], 0.0) < 1e-9);
    }

    test strand_forward_processes_correct_range {
        var g : [192]f64 = [0.0] ** 192;
        var b : [192]f64 = [0.0] ** 192;
        var m : [192]f64 = [0.0] ** 192;
        var v : [192]f64 = [0.0] ** 192;
        var o : [64]f64 = [0.0] ** 64;
        var c : [64]f64 = [0.0] ** 64;
        var nz : [64]f64 = [0.0] ** 64;
        var input : [192]f64 = [0.0] ** 192;
        var config = NormConfig{ .hidden_size = 192, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = true, .strand_mode = true };
        var state = init(config, &g, &b, &m, &v);
        fill_test_input(&input);
        var strands = create_strands(192, state.gamma, state.beta);
        var result = forward_strand(strands[0], &input, &o, &c, &nz);
        assert(result.output.len() == 64);
        assert(strands[0].id == 0);
        assert(all_finite(result.output));
        // the strand mean is the mean of input[0..64]
        assert(abs_diff(result.mean, compute_mean(input[0..64])) < 1e-12);
    }

    // The original test asserted that the three strands reproduce the standard
    // forward over all 192 values. That cannot hold: strand II and III add the
    // phi offsets (1/phi^2 * 0.1 and twice that) to gamma and beta, so their
    // outputs differ from the standard ones by offset * (normalized + 1).
    // With an input whose three strands have identical statistics, strand I
    // must equal the standard output and strands II and III must differ from
    // it by exactly that offset term.
    test strand_mode_equivalent_to_standard {
        var g : [192]f64 = [0.0] ** 192;
        var b : [192]f64 = [0.0] ** 192;
        var m : [192]f64 = [0.0] ** 192;
        var v : [192]f64 = [0.0] ** 192;
        var o : [192]f64 = [0.0] ** 192;
        var c : [192]f64 = [0.0] ** 192;
        var nz : [192]f64 = [0.0] ** 192;
        var so : [64]f64 = [0.0] ** 64;
        var sc : [64]f64 = [0.0] ** 64;
        var sn : [64]f64 = [0.0] ** 64;
        var input : [192]f64 = [0.0] ** 192;
        var config = NormConfig{ .hidden_size = 192, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        fill_test_input(&input);
        var standard = forward(state, &input, &o, &c, &nz);

        var strands = create_strands(192, state.gamma, state.beta);
        var worst : f64 = 0.0;
        var worst_offset : f64 = 0.0;
        var k : usize = 0;
        while (k < 3) {
            var strand_result = forward_strand(strands[k], &input, &so, &sc, &sn);
            let off = strands[k].phi_gamma_offset;
            var i : usize = 0;
            while (i < 64) {
                let d = strand_result.output[i] - standard.output[k * 64 + i];
                let expected = off * (strand_result.normalized[i] + 1.0);
                let e = @abs(d - expected);
                if (e > worst_offset) {
                    worst_offset = e;
                }
                if (k == 0) {
                    let e0 = @abs(d);
                    if (e0 > worst) {
                        worst = e0;
                    }
                }
                i += 1;
            }
            k += 1;
        }
        assert(worst < 1e-4); // strand I equals the standard output
        assert(worst_offset < 1e-4); // strands II and III differ by the phi offset only
        assert(strands[1].phi_gamma_offset > 0.0);
        assert(strands[2].phi_gamma_offset > strands[1].phi_gamma_offset);
    }

    // The original input x == mean made both sides exactly 0, so
    // "phi_result != standard" was false by arithmetic. x is one above the
    // mean here, so the two epsilons give two different finite numbers.
    test phi_normalize_reduces_numerical_error {
        var x : f64 = 1000001.0;
        var mean : f64 = 1000000.0;
        var variance : f64 = 1e-10;
        var standard = (x - mean) / @sqrt(variance + 1e-5);
        var phi_result = phi_normalize(x, mean, variance);
        assert(is_finite(phi_result));
        assert(phi_result != standard);
        // the smaller phi epsilon gives the larger normalized value
        assert(phi_result > standard);
        assert(abs_diff(standard, 316.2262) < 1e-3);
    }

    test update_modifies_parameters_correctly {
        var g : [2]f64 = [0.0] ** 2;
        var b : [2]f64 = [0.0] ** 2;
        var m : [2]f64 = [0.0] ** 2;
        var v : [2]f64 = [0.0] ** 2;
        var ng : [2]f64 = [0.0] ** 2;
        var nb : [2]f64 = [0.0] ** 2;
        var config = NormConfig{ .hidden_size = 2, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = false, .strand_mode = false };
        var state = init(config, &g, &b, &m, &v);
        state.gamma[0] = 1.0;
        state.beta[0] = 0.0;
        var dg : [2]f64 = [0.1, 0.2];
        var db : [2]f64 = [0.3, 0.4];
        var grads = NormGradients{ .d_gamma = &dg, .d_beta = &db, .d_input = &.{} };
        var new_state = update(state, grads, 0.01, &ng, &nb);
        assert(abs_diff(new_state.gamma[0], 1.0 - 0.001) < 1e-12);
        assert(abs_diff(new_state.beta[0], -0.003) < 1e-12);
        assert(abs_diff(new_state.gamma[1], 1.0 - 0.002) < 1e-12);
        assert(abs_diff(new_state.beta[1], -0.004) < 1e-12);
    }

