    test phi_epsilon_is_smaller_than_default {
        assert(phi_epsilon_value() < default_epsilon_value());
        assert(phi_epsilon_value() > 0.0);
    }

    test strand_partitions_are_disjoint {
        var g : [192]f64 = [0.0] ** 192;
        var b : [192]f64 = [0.0] ** 192;
        var m : [192]f64 = [0.0] ** 192;
        var v : [192]f64 = [0.0] ** 192;
        var config = NormConfig{ .hidden_size = 192, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = false, .strand_mode = true };
        var state = init(config, &g, &b, &m, &v);
        var strands = create_strands(192, state.gamma, state.beta);
        assert(strands[0].end == strands[1].start);
        assert(strands[1].end == strands[2].start);
        assert(strands[0].end == 64);
        assert(strands[1].end == 128);
    }

    test strand_partitions_cover_full_range {
        var g : [192]f64 = [0.0] ** 192;
        var b : [192]f64 = [0.0] ** 192;
        var m : [192]f64 = [0.0] ** 192;
        var v : [192]f64 = [0.0] ** 192;
        var config = NormConfig{ .hidden_size = 192, .eps = 1e-5, .elementwise_affine = true, .use_phi_init = false, .strand_mode = true };
        var state = init(config, &g, &b, &m, &v);
        var strands = create_strands(192, state.gamma, state.beta);
        assert(strands[0].start == 0);
        assert(strands[2].end == 192);
        assert(strands[0].gamma.len() == 64);
        assert(strands[2].gamma.len() == 64);
    }

    test phi_constraint_squared {
        assert(abs_diff(phi_value() * phi_value(), phi_value() + 1.0) < 1e-9);
    }

    test phi_constraint_reciprocal_sum {
        assert(abs_diff(phi_value() * phi_value() + 1.0 / (phi_value() * phi_value()), 3.0) < 1e-9);
    }

    test inv_phi_squared_is_correct {
        assert(abs_diff(inv_phi_squared_value(), 1.0 / (phi_value() * phi_value())) < 1e-9);
    }

