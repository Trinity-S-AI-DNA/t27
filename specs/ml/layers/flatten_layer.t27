// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Vectorization operation | φ² + 1/φ² = 3 | TRINITY

// #8980: written with `range`, `make` and `len`, which no spec declares; the tests
// asserted `result != undefined` and the invariants `true`. Flatten now copies a
// row-major tensor into a caller's buffer of calc_output_size(shape) elements.

module Flatten;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const MAX_DIMS : u32 = 8;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const FlattenConfig = struct {
        input_shape : []u32,
    };

    pub const InputTensor = struct {
        dims : []u32,
        data : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // calc_output_size(dims) = product of the dims (row-major element count)
    fn calc_output_size(input_dims: []const u32) -> u32 {
        var total_size : u32 = 1;
        var i : usize = 0;
        while (i < input_dims.len) {
            total_size = total_size * input_dims[i];
            i = i + 1;
        }
        return total_size;
    }

    // forward: output[k] = input[k] for k < calc_output_size(shape). A row-major tensor's
    // memory already is its flattening, so flatten is a copy; returns the element count.
    fn forward(input: []const f32, input_shape: []const u32, output: []f32) -> u32 {
        const n = calc_output_size(input_shape);
        var k : usize = 0;
        while (k < n) {
            output[k] = input[k];
            k = k + 1;
        }
        return n;
    }

    // a 2 x 3 x 4 tensor
    fn shape_size() -> u32 {
        const dims : [3]u32 = [2, 3, 4];
        return calc_output_size(&dims);
    }

    // Element (i, j) of a 2 x 3 tensor whose value is 10 i + j, read from the flat output
    fn flat_at(i: usize, j: usize) -> f32 {
        const dims : [2]u32 = [2, 3];
        const input : [6]f32 = [0.0, 1.0, 2.0, 10.0, 11.0, 12.0];
        var output : [6]f32 = [-1.0] ** 6;
        _ = forward(&input, &dims, &output);
        return output[i * 3 + j];
    }

    fn flat_count() -> u32 {
        const dims : [2]u32 = [2, 3];
        const input : [6]f32 = [0.0, 1.0, 2.0, 10.0, 11.0, 12.0];
        var output : [6]f32 = [-1.0] ** 6;
        return forward(&input, &dims, &output);
    }

    fn valid_input() -> u32 {
        return shape_size();
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test calc_output_size_basic_case
        given result = shape_size()
        then result == 24

    // Row-major: (i, j) lands at i * cols + j
    test forward_basic_case
        given count = flat_count()
        when last = flat_at(1, 2)
        then count == 6 and last == 12.0 and flat_at(0, 0) == 0.0 and flat_at(1, 0) == 10.0

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // len(input_dims) >= 1, <= MAX_DIMS: an 8-dim shape of 1s has one element
    invariant flatten_constraint_0
        assert MAX_DIMS >= 1

    invariant flatten_constraint_1
        assert MAX_DIMS == 8

    // name: flatten_formula -- the size is the product of the dims
    invariant flatten_constraint_2
        assert valid_input() == 2 * 3 * 4

    // "Goodfellow et al. (2016) - Deep Learning": flatten keeps every element
    invariant flatten_constraint_3
        assert flat_count() == 6

    // "Used in CNN -> Flatten -> Dense -> Classification": the flat order is row-major
    invariant flatten_constraint_4
        assert flat_at(0, 2) == 2.0 and flat_at(1, 1) == 11.0
