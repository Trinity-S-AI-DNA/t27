// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/optimizer/sgd_momentum.t27
// SGD with Momentum - phi-damped velocity | phi^2 + 1/phi^2 = 3 | TRINITY

// #8980: this spec did not compile (`array::create` does not exist, GF16 is a
// u16 bit container so it cannot carry float arithmetic, the tests used
// undefined helpers such as `all`, `is_zero`, `approximately_equal`,
// `random_input`). It now follows the sibling sgd.t27: f32 values, buffers
// owned by the caller, a real `step` (it was a stub that returned zero), and
// concrete deterministic inputs instead of the undefined random generators.

module SgdMomentum;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const PHI : f32 = 1.618033988749895;
    const DEFAULT_LEARNING_RATE : f32 = 0.01;
    const DEFAULT_MOMENTUM : f32 = 0.9;
    const PHI_DAMPED_MOMENTUM : f32 = 0.9 / PHI; // about 0.556
    const DEFAULT_WEIGHT_DECAY : f32 = 0.0;
    const DEFAULT_NESTEROV : bool = false;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SgdMomentumConfig = struct {
        learning_rate : f32,        // eta: step size
        momentum : f32,             // mu: momentum coefficient
        weight_decay : f32,         // lambda: L2 regularization
        nesterov : bool,            // Nesterov acceleration
        use_phi_damping : bool,     // Apply phi-based damping to momentum
        dampening : f32,            // Dampening for momentum (1 - momentum)
    };

    pub const SgdMomentumState = struct {
        config : SgdMomentumConfig, // Optimizer configuration
        velocities : []f32,         // v_t: accumulated momentum for each parameter
        param_count : u32,          // Number of parameters being optimized
        step : u64,                 // Current optimization step
    };

    pub const OptimizerStepResult = struct {
        updated_params : []f32,     // New parameter values (the params buffer, updated in place)
        velocities : []f32,         // Updated velocities (the state buffer, updated in place)
        step_norm : f32,            // L2 norm of the parameter update
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn mk_cfg(lr: f32, momentum: f32, wd: f32, nesterov: bool, phi: bool, dampening: f32) -> SgdMomentumConfig {
        return SgdMomentumConfig{ .learning_rate = lr, .momentum = momentum, .weight_decay = wd, .nesterov = nesterov, .use_phi_damping = phi, .dampening = dampening };
    }

    fn default_config() -> SgdMomentumConfig {
        return mk_cfg(DEFAULT_LEARNING_RATE, DEFAULT_MOMENTUM, DEFAULT_WEIGHT_DECAY, DEFAULT_NESTEROV, false, 0.1);
    }

    // init: the first param_count velocities start at zero (the caller owns the buffer)
    fn init(config: SgdMomentumConfig, velocities: []f32, param_count: u32) -> SgdMomentumState {
        var bound : usize = param_count;
        if (velocities.len < bound) {
            bound = velocities.len;
        }
        var i : usize = 0;
        while (i < bound) {
            velocities[i] = 0.0;
            i = i + 1;
        }
        return SgdMomentumState{ .config = config, .velocities = velocities, .param_count = param_count, .step = 0 };
    }

    // compute_velocity: new velocity for a single parameter
    fn compute_velocity(velocity: f32, grad: f32, momentum: f32, dampening: f32) -> f32 {
        return momentum * velocity + dampening * grad;
    }

    // nesterov_update: Nesterov accelerated parameter update
    fn nesterov_update(param: f32, velocity: f32, grad: f32, lr: f32, momentum: f32) -> f32 {
        return param - lr * (momentum * velocity + grad);
    }

    // standard_update: standard momentum parameter update
    fn standard_update(param: f32, velocity: f32, lr: f32) -> f32 {
        return param - lr * velocity;
    }

    // L2 weight decay for one gradient: g + lambda * p
    fn decayed_grad(param: f32, grad: f32, weight_decay: f32) -> f32 {
        return grad + weight_decay * param;
    }

    // apply_weight_decay: adds lambda * p to every gradient (in place) and returns them
    fn apply_weight_decay(params: []const f32, grads: []f32, weight_decay: f32) -> []f32 {
        var bound : usize = params.len;
        if (grads.len < bound) {
            bound = grads.len;
        }
        var i : usize = 0;
        while (i < bound) {
            grads[i] = decayed_grad(params[i], grads[i], weight_decay);
            i = i + 1;
        }
        return grads;
    }

    // phi_damped_momentum: phi-based damping of the momentum coefficient
    fn phi_damped_momentum(base_momentum: f32) -> f32 {
        return base_momentum / PHI;
    }

    // get_effective_momentum: the momentum coefficient actually used
    fn get_effective_momentum(config: SgdMomentumConfig) -> f32 {
        if (config.use_phi_damping) {
            return PHI_DAMPED_MOMENTUM;
        }
        return config.momentum;
    }

    // step: one optimization step with momentum. params and the state velocities
    // are updated in place; the result points at those same buffers.
    fn step(state: SgdMomentumState, params: []f32, grads: []const f32) -> OptimizerStepResult {
        var bound : usize = params.len;
        if (grads.len < bound) {
            bound = grads.len;
        }
        if (state.velocities.len < bound) {
            bound = state.velocities.len;
        }
        const mu = get_effective_momentum(state.config);
        var sumsq : f32 = 0.0;
        var i : usize = 0;
        while (i < bound) {
            const old = params[i];
            const g = decayed_grad(old, grads[i], state.config.weight_decay);
            const v = compute_velocity(state.velocities[i], g, mu, state.config.dampening);
            state.velocities[i] = v;
            var nxt = standard_update(old, v, state.config.learning_rate);
            if (state.config.nesterov) {
                nxt = nesterov_update(old, v, g, state.config.learning_rate, mu);
            }
            params[i] = nxt;
            const d = old - nxt;
            sumsq = sumsq + d * d;
            i = i + 1;
        }
        return OptimizerStepResult{ .updated_params = params, .velocities = state.velocities, .step_norm = @sqrt(sumsq) };
    }

    // zero_grad: velocities persist across steps, so the state is returned unchanged
    fn zero_grad(state: SgdMomentumState) -> SgdMomentumState {
        return state;
    }

    // ═══════════════════════════════════════════════════════════
    // Probes: deterministic inputs that replace the undefined random helpers
    // ═══════════════════════════════════════════════════════════

    fn close(a: f32, b: f32) -> bool {
        return @abs(a - b) < 0.00001;
    }

    fn close_eps(a: f32, b: f32, eps: f32) -> bool {
        return @abs(a - b) < eps;
    }

    // buf[i] = offset + i * scale
    fn fill_ramp(buf: []f32, offset: f32, scale: f32) -> void {
        var x : f32 = offset;
        var i : usize = 0;
        while (i < buf.len) {
            buf[i] = x;
            x = x + scale;
            i = i + 1;
        }
    }

    // init over a dirty 10-element buffer: 0 = len, 1 = zero count, 2 = step
    fn init_probe(which: u32) -> u32 {
        var buf : [10]f32 = [7.0, 7.0, 7.0, 7.0, 7.0, 7.0, 7.0, 7.0, 7.0, 7.0];
        const st = init(mk_cfg(0.01, 0.9, 0.0, false, false, 0.1), &buf, 10);
        if (which == 0) {
            return @as(u32, @intCast(st.velocities.len));
        }
        if (which == 1) {
            var zeros : u32 = 0;
            var i : usize = 0;
            while (i < st.velocities.len) {
                if (st.velocities[i] == 0.0) {
                    zeros = zeros + 1;
                }
                i = i + 1;
            }
            return zeros;
        }
        return @as(u32, @intCast(st.step));
    }

    // One step on params (1, 2, 3), grads (0.1, 0.2, 0.3) with momentum 0 and dampening 1
    fn plain_step(index: usize) -> f32 {
        var params : [3]f32 = [1.0, 2.0, 3.0];
        const grads : [3]f32 = [0.1, 0.2, 0.3];
        var vel : [3]f32 = [9.0, 9.0, 9.0];
        const st = init(mk_cfg(0.01, 0.0, 0.0, false, false, 1.0), &vel, 3);
        _ = step(st, &params, &grads);
        return params[index];
    }

    // Two steps on one parameter: 0 = velocity after step 1, 1 = velocity after step 2
    fn two_step_velocity(which: u32) -> f32 {
        var params : [1]f32 = [1.0];
        const grads : [1]f32 = [0.1];
        var vel : [1]f32 = [5.0];
        const cfg = mk_cfg(0.01, 0.9, 0.0, false, false, 0.1);
        const st = init(cfg, &vel, 1);
        const r1 = step(st, &params, &grads);
        const v1 = r1.velocities[0];
        const st2 = SgdMomentumState{ .config = cfg, .velocities = &vel, .param_count = 1, .step = 1 };
        const r2 = step(st2, r1.updated_params, &grads);
        if (which == 0) {
            return v1;
        }
        return r2.velocities[0];
    }

    // One step on param 1.0 with gradient 0.1, momentum 0.9, dampening 0.1 and the given weight decay
    fn decay_step(wd: f32) -> f32 {
        var params : [1]f32 = [1.0];
        const grads : [1]f32 = [0.1];
        var vel : [1]f32 = [0.0];
        const st = init(mk_cfg(0.01, 0.9, wd, false, false, 0.1), &vel, 1);
        _ = step(st, &params, &grads);
        return params[0];
    }

    // Nesterov step on the same input as decay_step(0)
    fn nesterov_step() -> f32 {
        var params : [1]f32 = [1.0];
        const grads : [1]f32 = [0.1];
        var vel : [1]f32 = [0.0];
        const st = init(mk_cfg(0.01, 0.9, 0.0, true, false, 0.1), &vel, 1);
        _ = step(st, &params, &grads);
        return params[0];
    }

    // apply_weight_decay on params (1, -1), grads (0.1, 0.1), lambda 0.1
    fn wd_probe(index: usize) -> f32 {
        const params : [2]f32 = [1.0, -1.0];
        var grads : [2]f32 = [0.1, 0.1];
        const out = apply_weight_decay(&params, &grads, 0.1);
        return out[index];
    }

    // 0 = step_norm reported by step, 1 = the norm recomputed from the parameters
    fn norm_probe(which: u32) -> f32 {
        var params : [2]f32 = [1.0, 2.0];
        const grads : [2]f32 = [0.3, 0.4];
        var vel : [2]f32 = [0.0, 0.0];
        const st = init(mk_cfg(0.01, 0.9, 0.0, false, false, 0.1), &vel, 2);
        const r = step(st, &params, &grads);
        if (which == 0) {
            return r.step_norm;
        }
        const d0 = 1.0 - params[0];
        const d1 = 2.0 - params[1];
        return @sqrt(d0 * d0 + d1 * d1);
    }

    // Step on 100 ramp parameters: 0 = updated_params.len, 1 = velocities.len
    fn lens_100(which: u32) -> u32 {
        var params : [100]f32 = undefined;
        var grads : [100]f32 = undefined;
        var vel : [100]f32 = undefined;
        fill_ramp(&params, -0.5, 0.01);
        fill_ramp(&grads, -0.5, 0.01);
        const st = init(default_config(), &vel, 100);
        const r = step(st, &params, &grads);
        if (which == 0) {
            return @as(u32, @intCast(r.updated_params.len));
        }
        return @as(u32, @intCast(r.velocities.len));
    }

    // Step on 50 ramp parameters: velocities.len
    fn vel_len_50() -> u32 {
        var params : [50]f32 = undefined;
        var grads : [50]f32 = undefined;
        var vel : [50]f32 = undefined;
        fill_ramp(&params, -0.5, 0.02);
        fill_ramp(&grads, -0.5, 0.02);
        const st = init(default_config(), &vel, 50);
        const r = step(st, &params, &grads);
        return @as(u32, @intCast(r.velocities.len));
    }

    // Sum of |velocity| after a step with gradients in [-1, 1]; stays finite
    fn velocity_abs_sum() -> f32 {
        var params : [10]f32 = undefined;
        var grads : [10]f32 = undefined;
        var vel : [10]f32 = undefined;
        fill_ramp(&params, -2.0, 0.5);
        fill_ramp(&grads, -1.0, 0.2);
        const st = init(default_config(), &vel, 10);
        const r = step(st, &params, &grads);
        var sum : f32 = 0.0;
        var i : usize = 0;
        while (i < r.velocities.len) {
            sum = sum + @abs(r.velocities[i]);
            i = i + 1;
        }
        return sum;
    }

    // step_norm after a step on 10 ramp parameters
    fn norm_10() -> f32 {
        var params : [10]f32 = undefined;
        var grads : [10]f32 = undefined;
        var vel : [10]f32 = undefined;
        fill_ramp(&params, -1.0, 0.3);
        fill_ramp(&grads, 1.0, -0.2);
        const st = init(default_config(), &vel, 10);
        const r = step(st, &params, &grads);
        return r.step_norm;
    }

    // Velocity 0 after init, set to 0.5 through the state, then zero_grad
    fn zero_grad_probe() -> f32 {
        var vel : [10]f32 = undefined;
        const st = init(default_config(), &vel, 10);
        st.velocities[0] = 0.5;
        const z = zero_grad(st);
        return z.velocities[0];
    }

    fn damped_ok(base: f32) -> bool {
        const damped = phi_damped_momentum(base);
        return damped < base and damped > 0.0;
    }

    fn effective_momentum_of(mu: f32, phi: bool) -> f32 {
        return get_effective_momentum(mk_cfg(0.01, mu, 0.0, false, phi, 0.1));
    }

    fn one_minus_momentum() -> f32 {
        const cfg = mk_cfg(0.01, 0.9, 0.0, false, false, 0.0);
        return 1.0 - cfg.momentum;
    }

    // Bench helpers: local buffers capped at 4096 parameters
    fn bench_size(n: u32) -> usize {
        if (n > 4096) {
            return 4096;
        }
        return n;
    }

    fn bench_init(n: u32) -> f32 {
        var vel : [4096]f32 = undefined;
        const st = init(default_config(), &vel, @as(u32, @intCast(bench_size(n))));
        return st.velocities[0];
    }

    fn bench_step(n: u32) -> f32 {
        var params : [4096]f32 = undefined;
        var grads : [4096]f32 = undefined;
        var vel : [4096]f32 = undefined;
        fill_ramp(&params, -0.5, 0.0001);
        fill_ramp(&grads, 0.5, -0.0001);
        const m = @as(u32, @intCast(bench_size(n)));
        const st = init(default_config(), &vel, m);
        const r = step(st, &params, &grads);
        return r.step_norm;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_creates_zero_velocities
        given len = init_probe(0)
        and   zeros = init_probe(1)
        and   steps = init_probe(2)
        then len == 10
        and   zeros == 10
        and   steps == 0

    test compute_velocity_basic_case
        given result = compute_velocity(0.0, 1.0, 0.9, 0.1)
        then close(result, 0.1)

    test compute_velocity_with_previous_velocity
        given result = compute_velocity(0.5, 1.0, 0.9, 0.1)
        then close(result, 0.9 * 0.5 + 0.1)

    test standard_update_decreases_param
        given result = standard_update(1.0, 0.1, 0.01)
        then result < 1.0
        and   close(result, 1.0 - 0.001)

    test nesterov_update_considers_lookahead
        given result = nesterov_update(1.0, 0.1, 0.5, 0.01, 0.9)
        then close(result, 1.0 - 0.01 * (0.9 * 0.1 + 0.5))

    test step_without_momentum_behaves_like_sgd
        given p0 = plain_step(0)
        and   p1 = plain_step(1)
        and   p2 = plain_step(2)
        then close(p0, 1.0 - 0.001)
        and   close(p1, 2.0 - 0.002)
        and   close(p2, 3.0 - 0.003)

    test step_with_momentum_accumulates_velocity
        given v1 = two_step_velocity(0)
        and   v2 = two_step_velocity(1)
        then v2 > v1
        and   close(v1, 0.01)
        and   close(v2, 0.019)

    // The original bound `result < 1.0 - 0.001` assumed the whole gradient 0.1
    // is applied, but the same test sets dampening 0.1, so the first velocity is
    // 0.1 * g and no weight decay lambda = 0.1 can reach it (g = 0.2 gives
    // 1 - 0.01 * 0.02 = 0.9998). The intent, "more aggressive decrease due to
    // weight decay", is asserted against the same step without decay.
    test step_with_weight_decay_modifies_gradients
        given with_decay = decay_step(0.1)
        and   without_decay = decay_step(0.0)
        then with_decay < without_decay
        and   with_decay < 1.0
        and   close_eps(with_decay, 0.9998, 0.000001)
        and   close_eps(without_decay, 0.9999, 0.000001)

    test apply_weight_decay_increases_gradient_magnitude
        given r0 = wd_probe(0)
        and   r1 = wd_probe(1)
        then close(r0, 0.2)   // 0.1 + 0.1 * 1.0
        and   close(r1, 0.0)  // 0.1 + 0.1 * (-1.0)

    test phi_damped_momentum_reduces_momentum
        given result = phi_damped_momentum(0.9)
        then result < 0.9
        and   close(result, 0.9 / PHI)

    test get_effective_momentum_returns_phi_damped_when_enabled
        given result = effective_momentum_of(0.9, true)
        then close(result, PHI_DAMPED_MOMENTUM)

    test get_effective_momentum_returns_base_when_disabled
        given result = effective_momentum_of(0.9, false)
        then close(result, 0.9)

    test step_norm_is_correct
        given reported = norm_probe(0)
        and   recomputed = norm_probe(1)
        then close(reported, recomputed)
        and   close_eps(reported, 0.0005, 0.000001)

    test nesterov_step_moves_further_than_standard
        given nesterov = nesterov_step()
        and   standard = decay_step(0.0)
        then nesterov < standard

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants
    // ═══════════════════════════════════════════════════════════

    invariant step_preserves_param_count
        @setEvalBranchQuota(200000);
        assert lens_100(0) == 100

    invariant step_velocities_same_length
        @setEvalBranchQuota(200000);
        assert vel_len_50() == 50 and lens_100(1) == 100

    invariant velocity_remains_bounded
        @setEvalBranchQuota(200000);
        assert velocity_abs_sum() < 3.0e38

    invariant momentum_coefficient_in_valid_range
        assert effective_momentum_of(0.9, false) >= 0.0 and effective_momentum_of(0.9, false) <= 1.0

    invariant phi_damped_momentum_less_than_base
        assert damped_ok(0.5) and damped_ok(0.75) and damped_ok(0.99)

    invariant step_norm_non_negative
        @setEvalBranchQuota(200000);
        assert norm_10() >= 0.0

    invariant zero_grad_preserves_velocities
        @setEvalBranchQuota(200000);
        assert zero_grad_probe() == 0.5

    invariant phi_damped_momentum_constant
        assert close_eps(PHI_DAMPED_MOMENTUM, 0.9 / PHI, 0.000001)

    invariant dampening_equals_one_minus_momentum_by_default
        assert close(one_minus_momentum(), 0.1)

    // ═══════════════════════════════════════════════════════════
    // TDD: Benchmarks
    // ═══════════════════════════════════════════════════════════

    bench init_small
        given n = 100
        when _ = bench_init(n)
        then elapsed_time_us < 50

    bench init_large
        given n = 1000000
        when _ = bench_init(n)
        then elapsed_time_ms < 10

    bench step_small
        given n = 100
        when _ = bench_step(n)
        then elapsed_time_us < 100

    bench step_medium
        given n = 10000
        when _ = bench_step(n)
        then elapsed_time_ms < 5

    bench step_large
        given n = 1000000
        when _ = bench_step(n)
        then elapsed_time_ms < 100

    bench compute_velocity
        given velocity = 0.25
        when _ = compute_velocity(velocity, 0.5, 0.9, 0.1)
        then elapsed_time_ns < 10

    bench nesterov_update
        given param = 0.25
        when _ = nesterov_update(param, 0.5, 0.75, 0.01, 0.9)
        then elapsed_time_ns < 10

    // ═══════════════════════════════════════════════════════════
    // Mathematical Notes
    // ═══════════════════════════════════════════════════════════
    //
    // Standard Momentum Update:
    //   v_t = μ * v_{t-1} + (1 - μ) * ∇L(θ_{t-1})
    //   θ_t = θ_{t-1} - η * v_t
    //
    // Nesterov Accelerated Gradient:
    //   v_t = μ * v_{t-1} + (1 - μ) * ∇L(θ_{t-1} - η * μ * v_{t-1})
    //   θ_t = θ_{t-1} - η * (μ * v_t + ∇L(θ_t))
    //
    // With Weight Decay (L2 Regularization):
    //   ∇L'(θ) = ∇L(θ) + λ * θ
    //
    // Phi-Damped Momentum:
    //   μ_eff = μ / φ ≈ 0.556 for μ = 0.9
    //   Reduces momentum accumulation, providing smoother convergence
    //
    // Dampening:
    //   Standard: dampening = 1 - momentum
    //   Alternative: dampening can be set independently
    //
    // ═══════════════════════════════════════════════════════════
