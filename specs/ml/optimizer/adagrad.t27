// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Sum of squared gradients | φ² + 1/φ² = 3 | TRINITY

// #8980: written with `range`, `len` and `+=` on a struct literal, so it never
// compiled; init_state returned an empty accumulator, and weight_decay was never
// read. init_state now zeroes a caller's buffer (t27 does not allocate here), and
// update is Duchi et al.: G += g^2; p -= lr g / (sqrt(G) + eps), with
// g = grad + wd p.

module Adagrad;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_LR : f32 = 0.01;
    const DEFAULT_EPSILON : f32 = 1e-8;
    const DEFAULT_WEIGHT_DECAY : f32 = 0.0;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const AdagradConfig = struct {
        learning_rate : f32,
        epsilon : f32,
        weight_decay : f32,
    };

    pub const AdagradState = struct {
        sum_squared_grad : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // The accumulator is the first num_params entries of `buffer`, zeroed
    fn init_state(buffer: []f32, num_params: u32) -> AdagradState {
        var i : usize = 0;
        while (i < num_params) {
            buffer[i] = 0.0;
            i = i + 1;
        }
        return AdagradState{ .sum_squared_grad = buffer[0..num_params] };
    }

    fn update(params: []f32, grads: []const f32, state: AdagradState, config: AdagradConfig) -> AdagradState {
        var i : usize = 0;
        while (i < params.len) {
            const g = grads[i] + config.weight_decay * params[i];
            state.sum_squared_grad[i] = state.sum_squared_grad[i] + g * g;
            const adaptive_lr = config.learning_rate / (sqrt(state.sum_squared_grad[i]) + config.epsilon);
            params[i] = params[i] - adaptive_lr * g;
            i = i + 1;
        }
        return state;
    }

    fn cfg(lr: f32) -> AdagradConfig {
        return AdagradConfig{ .learning_rate = lr, .epsilon = DEFAULT_EPSILON, .weight_decay = DEFAULT_WEIGHT_DECAY };
    }

    fn state_len(num_params: u32) -> usize {
        var buffer : [8]f32 = [9.0] ** 8;
        return init_state(&buffer, num_params).sum_squared_grad.len;
    }

    // which: 0 = accumulator, 1 = parameter, after `steps` identical steps
    fn after_steps(steps: u32, which: u8, index: usize) -> f32 {
        var params : [3]f32 = [1.0, 2.0, 3.0];
        const grads : [3]f32 = [0.1, 0.2, 0.3];
        var buffer : [3]f32 = [9.0] ** 3;
        var state = init_state(&buffer, 3);
        var n : u32 = 0;
        while (n < steps) {
            state = update(&params, &grads, state, cfg(DEFAULT_LR));
            n = n + 1;
        }
        if (which == 0) {
            return state.sum_squared_grad[index];
        }
        return params[index];
    }

    // Minimise (x - 3)^2 from 0 with lr 1
    fn descend(steps: u32) -> f32 {
        var params : [1]f32 = [0.0];
        var buffer : [1]f32 = [0.0];
        var state = init_state(&buffer, 1);
        var n : u32 = 0;
        while (n < steps) {
            const grads : [1]f32 = [2.0 * (params[0] - 3.0)];
            state = update(&params, &grads, state, cfg(1.0));
            n = n + 1;
        }
        return params[0];
    }

    fn valid_input() -> f32 {
        return DEFAULT_LR;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_state_returns_correct_size
        given num_params = 5
        when size = state_len(num_params)
        then size == num_params

    test update_accumulates_gradients_properly
        given g0 = after_steps(1, 0, 0)
        when g2 = after_steps(1, 0, 2)
        then @abs(g0 - 0.01) < 0.0000001 and @abs(after_steps(1, 0, 1) - 0.04) < 0.0000001 and @abs(g2 - 0.09) < 0.0000001

    // The first step moves every parameter by lr: g / sqrt(g^2) = 1
    test update_first_step_is_lr_per_parameter
        given p0 = after_steps(1, 1, 0)
        when p2 = after_steps(1, 1, 2)
        then @abs(p0 - 0.99) < 0.000001 and @abs(p2 - 2.99) < 0.000001

    // A constant gradient: step n moves by lr / sqrt(n), so steps shrink
    test update_steps_shrink_as_squares_accumulate
        given first = 1.0 - after_steps(1, 1, 0)
        when fourth = after_steps(3, 1, 0) - after_steps(4, 1, 0)
        then @abs(fourth - first / 2.0) < 0.00001

    test update_descends_a_quadratic
        given result = descend(500)
        then @abs(result - 3.0) < 0.001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // learning_rate > 0
    invariant adagrad_constraint_0
        assert valid_input() > 0.0

    // epsilon > 0
    invariant adagrad_constraint_1
        assert DEFAULT_EPSILON > 0.0

    // name: adagrad_update -- the parameter moves against the gradient
    invariant adagrad_constraint_2
        assert after_steps(1, 1, 1) < 2.0

    // name: accumulated_gradients -- G only grows
    invariant adagrad_constraint_3
        assert after_steps(2, 0, 0) > after_steps(1, 0, 0)

    // "Duchi et al. (2011) - Adaptive Subgradient Methods for Online Learning and Stochastic
    // Optimization": the per-coordinate step is lr whatever the gradient's scale
    invariant adagrad_constraint_4
        assert @abs((1.0 - after_steps(1, 1, 0)) - (3.0 - after_steps(1, 1, 2))) < 0.000001

    // "Goodfellow et al. (2016) - Deep Learning (Chapter 8)": the accumulator is a sum of squares
    invariant adagrad_constraint_5
        assert after_steps(2, 0, 1) > 0.079 and after_steps(2, 0, 1) < 0.081
