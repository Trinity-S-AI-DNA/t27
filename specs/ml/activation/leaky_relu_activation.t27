// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Piecewise derivative | φ² + 1/φ² = 3 | TRINITY

// #8980: forward_batch called `alloc` and `range`, which no spec declares, and the
// invariants asserted `true`. forward_batch now writes into a caller's buffer, and
// each invariant checks the property its comment names.

module LeakyRelu;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_ALPHA : f32 = 0.01;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const LeakyReLUConfig = struct {
        alpha : f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(x: f32, alpha: f32) → f32
    fn forward(x: f32, alpha: f32) -> f32 {
        if x > 0.0 {
            return x;
        } else {
            return alpha * x;
        }
    }

    // forward_batch: output[i] = max(x, alpha x) for 0 < alpha < 1, the branch-free form of forward
    fn forward_batch(input: []const f32, alpha: f32, output: []f32) -> void {
        var i : usize = 0;
        while (i < input.len) {
            output[i] = @max(input[i], alpha * input[i]);
            i = i + 1;
        }
    }

    // forward_batch on three inputs; true when the output is (e0, e1, e2)
    fn batch_is(a: f32, b: f32, c: f32, alpha: f32, e0: f32, e1: f32, e2: f32) -> bool {
        const input : [3]f32 = [a, b, c];
        var output : [3]f32 = [0.0] ** 3;
        forward_batch(&input, alpha, &output);
        return @abs(output[0] - e0) < 0.0000001 and @abs(output[1] - e1) < 0.0000001 and @abs(output[2] - e2) < 0.0000001;
    }

    fn valid_input() -> f32 {
        return -3.0;
    }

    // derivative(x: f32, alpha: f32) → f32
    fn derivative(x: f32, alpha: f32) -> f32 {
        if x > 0.0 {
            return 1.0;
        } else {
            return alpha;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test forward_positive_input
        given x = 5.0, alpha = 0.01
        when result = forward(x, alpha)
        then result == 5.0

    // In f32, 0.01 * -5 is one unit in the last place away from the literal -0.05,
    // so `==` failed on rounding, not on the formula; compared within 1e-7.
    test forward_negative_input
        given x = -5.0, alpha = 0.01
        when result = forward(x, alpha)
        then @abs(result - (-0.05)) < 0.0000001

    test forward_zero_input
        given x = 0.0, alpha = 0.01
        when result = forward(x, alpha)
        then result == 0.0

    test forward_batch_positive_inputs
        given alpha = 0.01
        when result = batch_is(1.0, 2.0, 3.0, alpha, 1.0, 2.0, 3.0)
        then result

    test forward_batch_negative_inputs
        given alpha = 0.01
        when result = batch_is(-1.0, -2.0, -3.0, alpha, -0.01, -0.02, -0.03)
        then result

    test forward_batch_mixed_inputs
        given alpha = 0.01
        when result = batch_is(-1.0, 0.0, 1.0, alpha, -0.01, 0.0, 1.0)
        then result

    test derivative_positive_input
        given x = 5.0, alpha = 0.01
        when result = derivative(x, alpha)
        then result == 1.0

    test derivative_negative_input
        given x = -5.0, alpha = 0.01
        when result = derivative(x, alpha)
        then result == 0.01

    test derivative_zero_input
        given x = 0.0, alpha = 0.01
        when result = derivative(x, alpha)
        then result == 0.01

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // 0 < alpha < 1 (typically 0.01-0.1)
    invariant leaky_relu_constraint_0
        assert DEFAULT_ALPHA > 0.0 and DEFAULT_ALPHA < 1.0

    // name: leaky_relu_formula -- alpha * x left of zero
    invariant leaky_relu_constraint_1
        assert forward(valid_input(), DEFAULT_ALPHA) == DEFAULT_ALPHA * valid_input()

    // name: derivative -- alpha left of zero, 1 right of it
    invariant leaky_relu_constraint_2
        assert derivative(valid_input(), DEFAULT_ALPHA) == DEFAULT_ALPHA and derivative(-valid_input(), DEFAULT_ALPHA) == 1.0

    // "Maas et al. (2013) - Rectifier Nonlinearities Improve Neural Network Acoustic Models":
    // the leak keeps the gradient alive where ReLU's is zero
    invariant leaky_relu_constraint_3
        assert derivative(valid_input(), DEFAULT_ALPHA) > 0.0
