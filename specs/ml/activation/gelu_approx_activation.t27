// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Exact GELU using error function | φ² + 1/φ² = 3 | TRINITY

// #8980: `math::tanh` named a module this spec never imports, and forward_batch
// wrote into an empty slice. It now works in place on the slice it is given.

module GeluApprox;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const SQRT_2_OVER_PI : f32 = 0.7978845608;
    const TANH_COEF : f32 = 0.044715;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const GELUApproxConfig = struct {
        none : void,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(x: f32) → f32
    fn forward(x: f32) -> f32 {
        // GELU approximation: 0.5 * x * (1 + tanh(√(2/π) * (x + 0.044715 * x³)))
        let x_cubed = x * x * x;
        let inner = x + TANH_COEF * x_cubed;
        let tanh_arg = SQRT_2_OVER_PI * inner;
        let tanh_val = tanh(tanh_arg);
        let result = 0.5 * x * (1.0 + tanh_val);
        return result;
    }

    // forward_batch: GELU applied to each element IN PLACE; returns the same slice
    fn forward_batch(input: []f32) -> []f32 {
        var i : usize = 0;
        while (i < input.len) {
            input[i] = forward(input[i]);
            i = i + 1;
        }
        return input;
    }

    // derivative(x: f32) → f32
    fn derivative(x: f32) -> f32 {
        // Derivative of GELU approximation
        let x_cubed = x * x * x;
        let inner = x + TANH_COEF * x_cubed;
        let tanh_arg = SQRT_2_OVER_PI * inner;
        let tanh_val = tanh(tanh_arg);
        let sech_squared = 1.0 - tanh_val * tanh_val;
        
        let term1 = 0.5 * (1.0 + tanh_val);
        let derivative_inner = SQRT_2_OVER_PI * (1.0 + 3.0 * TANH_COEF * x * x);
        let term2 = 0.5 * x * sech_squared * derivative_inner;
        
        let result = term1 + term2;
        return result;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test forward_zero_input
        given input = 0.0
        when result = forward(input)
        then result == 0.0

    test forward_positive_input
        given input = 1.0
        when result = forward(input)
        then result > 0.0 and result < 1.0

    test forward_negative_input
        given input = -1.0
        when result = forward(input)
        then result < 0.0 and result > -1.0

    test forward_batch_empty {
        var input: [0]f32 = [];
        var result = forward_batch(&input);
        assert(result.len == 0);
    }

    test forward_batch_single_element {
        var input: [1]f32 = [0.0];
        var result = forward_batch(&input);
        assert(result.len == 1);
        assert(result[0] == 0.0);
    }

    test forward_batch_multiple_elements {
        var input: [3]f32 = [1.0, -1.0, 0.5];
        var result = forward_batch(&input);
        assert(result.len == 3);
        assert(result[0] > 0.0);
        assert(result[1] < 0.0);
        assert(result[2] > 0.0);
    }

    test derivative_zero_input
        given input = 0.0
        when result = derivative(input)
        then result > 0.0 and result < 1.0

    test derivative_positive_input
        given input = 1.0
        when result = derivative(input)
        then result > 0.0 and result < 1.5

    // #8980: this test said `result > 0.0`, and that is false. GELU dips below zero
    // left of the origin, so its slope there is negative: d/dx at -1 is -0.0829641
    // here (exact GELU: Phi(-1) - phi(-1) = -0.0833155). It never ran, so nobody saw.
    test derivative_negative_input
        given input = -1.0
        when result = derivative(input)
        then result < 0.0 and result > -1.0 and @abs(result - (-0.0829641)) < 0.000001 and @abs(derivative(1.0) - 1.0829641) < 0.000001

    test "forward_basic"
        given input = 0.5
        when result = forward(input)
        then result >= 0.0

    test "forward_batch_basic" {
        var input: [2]f32 = [1.0, -0.5];
        var result = forward_batch(&input);
        assert(result.len == 2);
    }

    test "derivative_basic"
        given input = 2.0
        when result = derivative(input)
        then result >= 0.0

