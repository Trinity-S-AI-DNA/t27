// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Minimum distance for negative pairs | φ² + 1/φ² = 3 | TRINITY

// #8980: forward measured |anchor[i]| against a hard-coded margin, discarded the
// result, and called `math::abs` / `math::pow` / `@intToFloat`, which do not
// exist; the tests asserted `result != undefined`. It is now the contrastive loss
// of Hadsell, Chopra and LeCun (2006) over pairs of embeddings:
//   L = mean over pairs of 0.5 (y D^2 + (1 - y) max(0, margin - D)^2),
// where D = ||a - b||, y = 1 for a similar pair and 0 for a dissimilar one.

module ContrastiveLoss;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ContrastiveLossConfig = struct {
        margin : f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Euclidean distance between pair p of a and b (each `dim` wide, row-major)
    fn pair_distance(a: []const f32, b: []const f32, p: usize, dim: usize) -> f32 {
        var sum : f32 = 0.0;
        var k : usize = 0;
        while (k < dim) {
            const d = a[p * dim + k] - b[p * dim + k];
            sum = sum + d * d;
            k = k + 1;
        }
        return sqrt(sum);
    }

    fn forward(anchor: []const f32, other: []const f32, similar: []const bool, dim: usize, config: ContrastiveLossConfig) -> f32 {
        var loss_sum : f32 = 0.0;
        var p : usize = 0;
        while (p < similar.len) {
            const d = pair_distance(anchor, other, p, dim);
            if (similar[p]) {
                loss_sum = loss_sum + 0.5 * d * d;
            } else {
                const gap = @max(config.margin - d, 0.0);
                loss_sum = loss_sum + 0.5 * gap * gap;
            }
            p = p + 1;
        }
        return loss_sum / @as(f32, @floatFromInt(similar.len));
    }

    // One pair of 3-vectors: anchor = input, other = 0, margin 5
    fn one_pair(x: f32, y: f32, z: f32, similar: bool) -> f32 {
        const anchor : [3]f32 = [x, y, z];
        const other : [3]f32 = [0.0, 0.0, 0.0];
        const labels : [1]bool = [similar];
        return forward(&anchor, &other, &labels, 3, ContrastiveLossConfig{ .margin = 5.0 });
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // D = sqrt(14): a similar pair costs D^2 / 2 = 7; a dissimilar one (5 - 3.7417)^2 / 2 = 0.7917
    test forward_basic_case
        given pulled = one_pair(1.0, 2.0, 3.0, true)
        when pushed = one_pair(1.0, 2.0, 3.0, false)
        then @abs(pulled - 7.0) < 0.00001 and @abs(pushed - 0.7917131) < 0.00001

    // Identical points: no cost if similar, the full margin^2 / 2 if not
    test forward_zero_input
        given pulled = one_pair(0.0, 0.0, 0.0, true)
        when pushed = one_pair(0.0, 0.0, 0.0, false)
        then pulled == 0.0 and pushed == 12.5

    // The sign of the difference does not matter, and a dissimilar pair past the margin costs 0
    test forward_negative_values
        given pulled = one_pair(-1.0, -2.0, -3.0, true)
        when far = one_pair(-3.0, -4.0, -5.0, false)
        then @abs(pulled - one_pair(1.0, 2.0, 3.0, true)) < 0.00001 and far == 0.0

    invariant contrastive_loss_is_zero_for_a_matched_pair
        assert one_pair(0.0, 0.0, 0.0, true) == 0.0
