// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Bidirectional LSTM output concatenation | φ² + 1/φ² = 3 | TRINITY

// #8980: forward_direction returned the constant [1, 2, 3, 4, 5] and forward
// returned constants, typed with an undeclared `Str`; the tests checked those
// constants were defined. A BiLSTM now runs one LSTM over the sequence forward and
// another backward. Gate W is hidden x (input + hidden) on [x; h], and step t
// outputs [h_fwd(t); h_bwd(t)], so each step sees both its past and its future.

module Bilstm;
    use base::types;
    use math::constants;
    use ml::recurrent::lstm_cell;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_INPUT_SIZE : u32 = 256;
    const DEFAULT_HIDDEN_SIZE : u32 = 256;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const BiLSTMConfig = struct {
        input_size : u32,
        hidden_size : u32,
        use_cell_state : bool,
    };

    pub const LSTMParams = struct {
        w_i : []f32,
        w_f : []f32,
        w_o : []f32,
        w_c : []f32,
        b_i : []f32,
        b_f : []f32,
        b_o : []f32,
        b_c : []f32,
    };

    pub const LSTMCellState = struct {
        h : []f32,
        c : []f32,
    };

    pub const BiLSTMOutput = struct {
        h : []f32,
        c : []f32,
        h_fwd_final : []f32,
        h_bwd_final : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn sigmoid(z: f32) -> f32 {
        return 1.0 / (1.0 + exp(-z));
    }

    // A gate's pre-activation is lstm_cell's `gate` (W[u] . [x; h] + b[u]), reused, not copied
    fn lstm_cfg(config: BiLSTMConfig) -> LSTMConfig {
        return LSTMConfig{ .input_size = config.input_size, .hidden_size = config.hidden_size };
    }

    // Runs the LSTM over `steps` inputs (steps x input_size), in order or reversed, from
    // h = c = 0. Row t of h_out is the state after reading input t. h and c are scratch of
    // hidden_size floats each; h_new must not alias h.
    fn forward_direction(inputs: []const f32, steps: usize, reverse: bool, params: LSTMParams, config: BiLSTMConfig, h_out: []f32, h: []f32, c: []f32, h_new: []f32) -> void {
        const n_in : usize = config.input_size;
        const n_h : usize = config.hidden_size;
        var k : usize = 0;
        while (k < n_h) {
            h[k] = 0.0;
            c[k] = 0.0;
            k = k + 1;
        }
        var n : usize = 0;
        while (n < steps) {
            var t = n;
            if (reverse) {
                t = steps - 1 - n;
            }
            const x = inputs[t * n_in .. (t + 1) * n_in];
            var u : usize = 0;
            while (u < n_h) {
                const ig = sigmoid(gate(params.w_i, params.b_i, x, h, u, lstm_cfg(config)));
                const fg = sigmoid(gate(params.w_f, params.b_f, x, h, u, lstm_cfg(config)));
                const og = sigmoid(gate(params.w_o, params.b_o, x, h, u, lstm_cfg(config)));
                const gg = tanh(gate(params.w_c, params.b_c, x, h, u, lstm_cfg(config)));
                c[u] = fg * c[u] + ig * gg;
                h_new[u] = og * tanh(c[u]);
                u = u + 1;
            }
            u = 0;
            while (u < n_h) {
                h[u] = h_new[u];
                h_out[t * n_h + u] = h_new[u];
                u = u + 1;
            }
            n = n + 1;
        }
    }

    // out row t = [h_fwd(t); h_bwd(t)] (steps x 2 hidden). scratch holds 5 * hidden_size + 2 *
    // steps * hidden_size floats.
    fn forward(inputs: []const f32, steps: usize, fwd: LSTMParams, bwd: LSTMParams, config: BiLSTMConfig, out: []f32, scratch: []f32) -> void {
        const n_h : usize = config.hidden_size;
        const h_f = scratch[5 * n_h .. 5 * n_h + steps * n_h];
        const h_b = scratch[5 * n_h + steps * n_h .. 5 * n_h + 2 * steps * n_h];
        forward_direction(inputs, steps, false, fwd, config, h_f, scratch[0..n_h], scratch[n_h .. 2 * n_h], scratch[2 * n_h .. 3 * n_h]);
        forward_direction(inputs, steps, true, bwd, config, h_b, scratch[0..n_h], scratch[n_h .. 2 * n_h], scratch[2 * n_h .. 3 * n_h]);
        var t : usize = 0;
        while (t < steps) {
            var u : usize = 0;
            while (u < n_h) {
                out[t * 2 * n_h + u] = h_f[t * n_h + u];
                out[t * 2 * n_h + n_h + u] = h_b[t * n_h + u];
                u = u + 1;
            }
            t = t + 1;
        }
    }

    // input 1, hidden 1: each W is 1 x 2 = (w_x, w_h), each b 1
    fn cfg() -> BiLSTMConfig {
        return BiLSTMConfig{ .input_size = 1, .hidden_size = 1, .use_cell_state = true };
    }

    fn params_of(w: []f32) -> LSTMParams {
        return LSTMParams{ .w_i = w[0..2], .w_f = w[2..4], .w_o = w[4..6], .w_c = w[6..8], .b_i = w[8..9], .b_f = w[9..10], .b_o = w[10..11], .b_c = w[11..12] };
    }

    fn fill_params(w: []f32) -> void {
        const v : [12]f32 = [0.5, 0.1, 0.3, -0.2, 0.4, 0.2, 0.9, 0.5, 0.0, 1.0, 0.0, 0.0];
        var k : usize = 0;
        while (k < 12) {
            w[k] = v[k];
            k = k + 1;
        }
    }

    // h of one direction after each step of the sequence (a, b, c)
    fn direction_at(a: f32, b: f32, c: f32, reverse: bool, t: usize) -> f32 {
        var w : [12]f32 = undefined;
        fill_params(&w);
        const inputs : [3]f32 = [a, b, c];
        var h_out : [3]f32 = [9.0] ** 3;
        var h : [1]f32 = undefined;
        var cs : [1]f32 = undefined;
        var h_new : [1]f32 = undefined;
        forward_direction(&inputs, 3, reverse, params_of(&w), cfg(), &h_out, &h, &cs, &h_new);
        return h_out[t];
    }

    // out[index] of the BiLSTM on (a, b, c), both directions with the same weights
    fn bi_at(a: f32, b: f32, c: f32, index: usize) -> f32 {
        var w : [12]f32 = undefined;
        fill_params(&w);
        const inputs : [3]f32 = [a, b, c];
        var out : [6]f32 = [9.0] ** 6;
        var scratch : [11]f32 = undefined;
        forward(&inputs, 3, params_of(&w), params_of(&w), cfg(), &out, &scratch);
        return out[index];
    }

    fn valid_input() -> f32 {
        return bi_at(1.0, 0.0, -1.0, 0);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // The forward pass at step 0 sees only input 0; the backward pass at step 2 sees only
    // input 2, so for the same weights they agree when those inputs agree
    test forward_direction_basic_case
        given first = direction_at(1.0, 2.0, 3.0, false, 0)
        when last_reversed = direction_at(3.0, 2.0, 1.0, true, 2)
        then first > 0.0 and first < 1.0 and @abs(first - last_reversed) < 0.000001 and direction_at(1.0, 2.0, 3.0, false, 2) != first

    // Each step's output is [h_fwd; h_bwd]: step 0 holds the forward state after input 0
    // and the backward state after the whole sequence
    test forward_basic_case
        given h_fwd0 = bi_at(1.0, 2.0, 3.0, 0)
        when h_bwd0 = bi_at(1.0, 2.0, 3.0, 1)
        then h_fwd0 == direction_at(1.0, 2.0, 3.0, false, 0) and h_bwd0 == direction_at(1.0, 2.0, 3.0, true, 0) and h_fwd0 != h_bwd0

    // Reversing the sequence swaps the two halves (same weights both ways)
    test forward_is_symmetric_under_reversal
        given fwd_last = bi_at(1.0, 2.0, 3.0, 4)
        when bwd_first_reversed = bi_at(3.0, 2.0, 1.0, 1)
        then @abs(fwd_last - bwd_first_reversed) < 0.000001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // input_size >= 1
    invariant bilstm_constraint_0
        assert cfg().input_size >= 1 and DEFAULT_INPUT_SIZE >= 1

    // hidden_size >= 1
    invariant bilstm_constraint_1
        assert cfg().hidden_size >= 1 and DEFAULT_HIDDEN_SIZE >= 1

    // name: bilstm_output -- each step outputs 2 * hidden_size numbers
    // (the values are checked by the tests: a comptime run exceeds Zig's branch quota)
    invariant bilstm_constraint_2
        assert DEFAULT_HIDDEN_SIZE * 2 == 512

    // "Schuster & Paliwal (1997) - Bidirectional Recurrent Neural Networks": checked by the
    // test backward_half_sees_the_future
    invariant bilstm_constraint_3
        assert cfg().hidden_size * 2 == 2

    // "Graves et al. (2013) - Speech Recognition with Deep Recurrent Neural Networks": the two
    // halves are concatenated per step; checked by the test halves_are_concatenated
    invariant bilstm_constraint_4
        assert cfg().input_size == 1

    test backward_half_sees_the_future
        given bwd = bi_at(1.0, 2.0, 3.0, 1)
        when fwd = bi_at(1.0, 2.0, 3.0, 0)
        then bwd != bi_at(1.0, 2.0, -3.0, 1) and fwd == bi_at(1.0, 2.0, -3.0, 0) and valid_input() > -1.0 and valid_input() < 1.0

    test halves_are_concatenated
        given last = bi_at(1.0, 2.0, 3.0, 5)
        then last == direction_at(1.0, 2.0, 3.0, true, 2) and bi_at(1.0, 2.0, 3.0, 4) == direction_at(1.0, 2.0, 3.0, false, 2)
