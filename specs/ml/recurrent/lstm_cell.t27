// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Short-term memory exposed to next layer | φ² + 1/φ² = 3 | TRINITY

// #8980: written against an undeclared `math::` library (concatenate, dot,
// sigmoid, fill, random_uniform_array), so it never compiled; the tests asserted
// `result != undefined` and the invariants `true`. This is the concatenated form
// of the LSTM: each gate's W is hidden x (input + hidden) acting on [x; h]. init
// fills the weights deterministically within +-1/sqrt(input + hidden) and sets the
// forget bias to 1. (specs/ml/recurrent/lstm_single.t27 is the split form with
// separate W_x and W_h, and checks the backward pass.)

module Lstm;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const LSTM_DEFAULT_HIDDEN : u32 = 128;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const LSTMConfig = struct {
        input_size : u32,
        hidden_size : u32,
    };

    pub const LSTMState = struct {
        h : []f32,
        c : []f32,
    };

    pub const LSTMWeights = struct {
        Wf : []f32,
        bf : []f32,
        Wi : []f32,
        bi : []f32,
        Wo : []f32,
        bo : []f32,
        Wg : []f32,
        bg : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn sigmoid(z: f32) -> f32 {
        return 1.0 / (1.0 + exp(-z));
    }

    // W[u] . [x; h] + b[u]
    fn gate(w: []const f32, b: []const f32, x: []const f32, h: []const f32, u: usize, config: LSTMConfig) -> f32 {
        const width : usize = config.input_size + config.hidden_size;
        var z : f32 = b[u];
        var j : usize = 0;
        while (j < config.input_size) {
            z = z + w[u * width + j] * x[j];
            j = j + 1;
        }
        var k : usize = 0;
        while (k < config.hidden_size) {
            z = z + w[u * width + config.input_size + k] * h[k];
            k = k + 1;
        }
        return z;
    }

    // f, i, o = sigmoid, g = tanh; c' = f c + i g; h' = o tanh(c')
    fn forward(input: []const f32, state_prev: LSTMState, weights: LSTMWeights, state_next: LSTMState, config: LSTMConfig) -> void {
        var u : usize = 0;
        while (u < config.hidden_size) {
            const f = sigmoid(gate(weights.Wf, weights.bf, input, state_prev.h, u, config));
            const i = sigmoid(gate(weights.Wi, weights.bi, input, state_prev.h, u, config));
            const o = sigmoid(gate(weights.Wo, weights.bo, input, state_prev.h, u, config));
            const g = tanh(gate(weights.Wg, weights.bg, input, state_prev.h, u, config));
            state_next.c[u] = f * state_prev.c[u] + i * g;
            state_next.h[u] = o * tanh(state_next.c[u]);
            u = u + 1;
        }
    }

    fn uniform(w: []f32, scale: f32, salt: usize) -> void {
        var k : usize = 0;
        while (k < w.len) {
            const h : u32 = @as(u32, @intCast(((k + salt) * 2654435761) % 1000));
            w[k] = (@as(f32, @floatFromInt(h)) / 500.0 - 1.0) * scale;
            k = k + 1;
        }
    }

    fn fill(v: []f32, value: f32) -> void {
        var k : usize = 0;
        while (k < v.len) {
            v[k] = value;
            k = k + 1;
        }
    }

    // Xavier-style uniform weights in [-1, 1) / sqrt(input + hidden); forget bias 1, other biases 0
    fn init(weights: LSTMWeights, config: LSTMConfig) -> void {
        const scale : f32 = 1.0 / sqrt(@as(f32, @floatFromInt(config.input_size + config.hidden_size)));
        uniform(weights.Wf, scale, 1);
        uniform(weights.Wi, scale, 2);
        uniform(weights.Wo, scale, 3);
        uniform(weights.Wg, scale, 4);
        fill(weights.bf, 1.0);
        fill(weights.bi, 0.0);
        fill(weights.bo, 0.0);
        fill(weights.bg, 0.0);
    }

    // input 2, hidden 2: each W is 2 x 4 (8 numbers), each b 2; all 40 live in one buffer
    fn cfg() -> LSTMConfig {
        return LSTMConfig{ .input_size = 2, .hidden_size = 2 };
    }

    fn weights_of(w: []f32) -> LSTMWeights {
        return LSTMWeights{ .Wf = w[0..8], .bf = w[8..10], .Wi = w[10..18], .bi = w[18..20], .Wo = w[20..28], .bo = w[28..30], .Wg = w[30..38], .bg = w[38..40] };
    }

    // One step from h = 0, c = (c0, 0) with every weight 0 and gate biases (bf, bi, bo, bg);
    // which: 0 = h'_0, 1 = c'_0
    fn bias_step(bf: f32, bi: f32, bo: f32, bg: f32, c0: f32, which: u8) -> f32 {
        var w : [40]f32 = [0.0] ** 40;
        fill(w[8..10], bf);
        fill(w[18..20], bi);
        fill(w[28..30], bo);
        fill(w[38..40], bg);
        const x : [2]f32 = [1.0, -1.0];
        var h : [2]f32 = [0.0, 0.0];
        var c : [2]f32 = [c0, 0.0];
        var h2 : [2]f32 = [9.0] ** 2;
        var c2 : [2]f32 = [9.0] ** 2;
        forward(&x, LSTMState{ .h = &h, .c = &c }, weights_of(&w), LSTMState{ .h = &h2, .c = &c2 }, cfg());
        if (which == 0) {
            return h2[0];
        }
        return c2[0];
    }

    // The cell after `steps` steps of x = 0 with the forget gate wide open (bf = 20) and the
    // input gate shut (bi = -20), starting from c = 0.75
    fn carry(steps: u32) -> f32 {
        var w : [40]f32 = [0.0] ** 40;
        fill(w[8..10], 20.0);
        fill(w[18..20], -20.0);
        const x : [2]f32 = [0.0, 0.0];
        var h : [2]f32 = [0.0, 0.0];
        var c : [2]f32 = [0.75, 0.75];
        var h2 : [2]f32 = [0.0, 0.0];
        var c2 : [2]f32 = [0.0, 0.0];
        var n : u32 = 0;
        while (n < steps) {
            forward(&x, LSTMState{ .h = &h, .c = &c }, weights_of(&w), LSTMState{ .h = &h2, .c = &c2 }, cfg());
            h = h2;
            c = c2;
            n = n + 1;
        }
        return c[0];
    }

    // which: 0 = bf[1], 1 = bi[0], 2 = largest |W|, 3 = Wf[0] != Wi[0]
    fn init_probe(which: u8) -> f32 {
        var w : [40]f32 = [9.0] ** 40;
        init(weights_of(&w), cfg());
        if (which == 0) {
            return w[9];
        }
        if (which == 1) {
            return w[18];
        }
        if (which == 2) {
            var largest : f32 = 0.0;
            var k : usize = 0;
            while (k < 40) {
                if (k < 8 or (k >= 10 and k < 18) or (k >= 20 and k < 28) or (k >= 30 and k < 38)) {
                    largest = @max(largest, @abs(w[k]));
                }
                k = k + 1;
            }
            return largest;
        }
        if (w[0] != w[10]) {
            return 1.0;
        }
        return 0.0;
    }

    // Length of one weight slice of the fixture: 0..3 = Wf, Wi, Wo, Wg; 4..7 = bf, bi, bo, bg
    fn weights_of_len(which: u8) -> usize {
        var w : [40]f32 = [0.0] ** 40;
        const ws = weights_of(&w);
        if (which == 0) {
            return ws.Wf.len;
        }
        if (which == 1) {
            return ws.Wi.len;
        }
        if (which == 2) {
            return ws.Wo.len;
        }
        if (which == 3) {
            return ws.Wg.len;
        }
        if (which == 4) {
            return ws.bf.len;
        }
        if (which == 5) {
            return ws.bi.len;
        }
        if (which == 6) {
            return ws.bo.len;
        }
        return ws.bg.len;
    }

    fn valid_input() -> u32 {
        return cfg().input_size + cfg().hidden_size;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // All weights and biases 0: f = i = o = 0.5, g = 0, so c' = 0.5 c and h' = 0.5 tanh(c')
    test "forward_basic_case"
        given c_new = bias_step(0.0, 0.0, 0.0, 0.0, 0.6, 1)
        when h_new = bias_step(0.0, 0.0, 0.0, 0.0, 0.6, 0)
        then @abs(c_new - 0.3) < 0.000001 and @abs(h_new - 0.5 * tanh(c_new)) < 0.000001

    // An open input gate writes g into the cell: bf = -20, bi = 20, bg = 20 gives c' = 1
    test "forward_input_gate_writes_the_cell"
        given c_new = bias_step(-20.0, 20.0, 20.0, 20.0, 0.6, 1)
        when h_new = bias_step(-20.0, 20.0, 20.0, 20.0, 0.6, 0)
        then @abs(c_new - 1.0) < 0.000001 and @abs(h_new - 0.7615942) < 0.000001

    test "init_basic_case"
        given forget_bias = init_probe(0)
        when largest = init_probe(2)
        then forget_bias == 1.0 and init_probe(1) == 0.0 and largest > 0.0 and largest <= 0.5 and init_probe(3) == 1.0

    // The cell is a linear highway: with the forget gate open it carries 0.75 across 100 steps
    test "forward_carries_the_cell_across_100_steps"
        given after = carry(100)
        then @abs(after - 0.75) < 0.0001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // input_size > 0
    invariant lstm_constraint_0
        assert cfg().input_size > 0

    // hidden_size > 0
    invariant lstm_constraint_1
        assert cfg().hidden_size > 0 and LSTM_DEFAULT_HIDDEN > 0

    // Wf.size() == (input_size + hidden_size) * hidden_size
    invariant lstm_constraint_2
        assert valid_input() * cfg().hidden_size == 8

    // Wi.size() == (input_size + hidden_size) * hidden_size
    invariant lstm_constraint_3
        assert weights_of_len(1) == 8

    // Wo.size() == (input_size + hidden_size) * hidden_size
    invariant lstm_constraint_4
        assert weights_of_len(2) == 8

    // Wg.size() == (input_size + hidden_size) * hidden_size
    invariant lstm_constraint_5
        assert weights_of_len(3) == 8

    // bf.size() == hidden_size
    invariant lstm_constraint_6
        assert weights_of_len(4) == 2

    // bi.size() == hidden_size
    invariant lstm_constraint_7
        assert weights_of_len(5) == 2

    // bo.size() == hidden_size
    invariant lstm_constraint_8
        assert weights_of_len(6) == 2

    // bg.size() == hidden_size
    invariant lstm_constraint_9
        assert weights_of_len(7) == 2

    // "LSTM should learn long-term dependencies (>100 time steps)": the cell does not decay
    // when the forget gate is open (the test above runs 100 steps)
    invariant lstm_constraint_10
        assert carry(3) > 0.7499

    // "Forget gate bias initialization to 1.0 improves convergence"
    invariant lstm_constraint_11
        assert init_probe(0) == 1.0

    // "Cell state acts as linear information highway": c' is linear in c
    invariant lstm_constraint_12
        assert @abs(bias_step(0.0, 0.0, 0.0, 0.0, 0.8, 1) - 2.0 * bias_step(0.0, 0.0, 0.0, 0.0, 0.4, 1)) < 0.000001
