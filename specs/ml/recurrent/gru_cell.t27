// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Convex combination of old and new | φ² + 1/φ² = 3 | TRINITY

// #8980: written against an undeclared `math::` library, with one scalar gate
// for the whole layer (br[0], bz[0]), so it never compiled; the tests asserted
// `true`, or `false` for a call expected to fail. Each gate's W is now
// hidden x (hidden + input) acting on [h; x]:
//   r = s(W_r [h; x] + b_r),  z = s(W_z [h; x] + b_z)
//   n = tanh(W_h [r * h; x] + b_h),  h' = (1 - z) n + z h
// init returns false and writes nothing when a weight has the wrong size.

module Gru;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const GRUConfig = struct {
        input_size : u32,
        hidden_size : u32,
    };

    pub const GRUState = struct {
        h : []f32,
    };

    pub const GRUWeights = struct {
        Wr : []f32,
        br : []f32,
        Wz : []f32,
        bz : []f32,
        Wh : []f32,
        bh : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn sigmoid(z: f32) -> f32 {
        return 1.0 / (1.0 + exp(-z));
    }

    // W[u] . [gate_h * h; x] + b[u], where gate_h scales h elementwise (all ones, or r)
    fn affine(w: []const f32, b: []const f32, h: []const f32, gate_h: []const f32, x: []const f32, u: usize, config: GRUConfig) -> f32 {
        const width : usize = config.hidden_size + config.input_size;
        var z : f32 = b[u];
        var k : usize = 0;
        while (k < config.hidden_size) {
            z = z + w[u * width + k] * gate_h[k] * h[k];
            k = k + 1;
        }
        var j : usize = 0;
        while (j < config.input_size) {
            z = z + w[u * width + config.hidden_size + j] * x[j];
            j = j + 1;
        }
        return z;
    }

    // `reset` is scratch of hidden_size floats (it holds r between the two passes)
    fn forward(input: []const f32, h_prev: []const f32, weights: GRUWeights, h_next: []f32, reset: []f32, config: GRUConfig) -> void {
        var ones : [64]f32 = [1.0] ** 64;
        var u : usize = 0;
        while (u < config.hidden_size) {
            reset[u] = sigmoid(affine(weights.Wr, weights.br, h_prev, &ones, input, u, config));
            u = u + 1;
        }
        u = 0;
        while (u < config.hidden_size) {
            const z = sigmoid(affine(weights.Wz, weights.bz, h_prev, &ones, input, u, config));
            const n = tanh(affine(weights.Wh, weights.bh, h_prev, reset, input, u, config));
            h_next[u] = (1.0 - z) * n + z * h_prev[u];
            u = u + 1;
        }
    }

    // Checks every size against the config; when they hold, fills the weights within
    // +-1/sqrt(hidden + input) from a fixed hash and zeroes the biases
    fn init(weights: GRUWeights, config: GRUConfig) -> bool {
        const expected : usize = (config.input_size + config.hidden_size) * config.hidden_size;
        if (weights.Wr.len != expected or weights.Wz.len != expected or weights.Wh.len != expected) {
            return false;
        }
        if (weights.br.len != config.hidden_size or weights.bz.len != config.hidden_size or weights.bh.len != config.hidden_size) {
            return false;
        }
        const scale : f32 = 1.0 / sqrt(@as(f32, @floatFromInt(config.input_size + config.hidden_size)));
        var k : usize = 0;
        while (k < expected) {
            const h : u32 = @as(u32, @intCast((k * 2654435761) % 1000));
            const v = (@as(f32, @floatFromInt(h)) / 500.0 - 1.0) * scale;
            weights.Wr[k] = v;
            weights.Wz[k] = -v;
            weights.Wh[k] = 0.5 * v;
            k = k + 1;
        }
        k = 0;
        while (k < config.hidden_size) {
            weights.br[k] = 0.0;
            weights.bz[k] = 0.0;
            weights.bh[k] = 0.0;
            k = k + 1;
        }
        return true;
    }

    // hidden 3, input 3: each W is 3 x 6. The fixture: W_r, W_z, W_h filled with
    // (k mod 7) / 10 - 0.3 for k = 0..17, biases (0.1, 0.2, 0.3)
    fn fixture_step(x0: f32, x1: f32, x2: f32, index: usize) -> f32 {
        var wr : [18]f32 = undefined;
        var wz : [18]f32 = undefined;
        var wh : [18]f32 = undefined;
        var k : usize = 0;
        while (k < 18) {
            wr[k] = @as(f32, @floatFromInt(k % 7)) / 10.0 - 0.3;
            wz[k] = wr[k];
            wh[k] = wr[k];
            k = k + 1;
        }
        var br : [3]f32 = [0.1, 0.2, 0.3];
        var bz : [3]f32 = [0.1, 0.2, 0.3];
        var bh : [3]f32 = [0.1, 0.2, 0.3];
        const x : [3]f32 = [x0, x1, x2];
        const h : [3]f32 = [0.1, 0.2, 0.3];
        var out : [3]f32 = [9.0] ** 3;
        var r : [3]f32 = undefined;
        forward(&x, &h, GRUWeights{ .Wr = &wr, .br = &br, .Wz = &wz, .bz = &bz, .Wh = &wh, .bh = &bh }, &out, &r, GRUConfig{ .input_size = 3, .hidden_size = 3 });
        return out[index];
    }

    // One unit, no input, every weight 0, biases (b_r, b_z, b_h), from h: h' = (1 - z) tanh(b_h) + z h
    fn no_input_step(b_z: f32, b_h: f32, h0: f32) -> f32 {
        var w : [1]f32 = [0.0];
        var w2 : [1]f32 = [0.0];
        var w3 : [1]f32 = [0.0];
        var br : [1]f32 = [0.0];
        var bz : [1]f32 = [b_z];
        var bh : [1]f32 = [b_h];
        const none : [0]f32 = [];
        const h : [1]f32 = [h0];
        var out : [1]f32 = [9.0];
        var r : [1]f32 = undefined;
        forward(&none, &h, GRUWeights{ .Wr = &w, .br = &br, .Wz = &w2, .bz = &bz, .Wh = &w3, .bh = &bh }, &out, &r, GRUConfig{ .input_size = 0, .hidden_size = 1 });
        return out[0];
    }

    // init on correctly sized weights (input 2, hidden 2) or on the short ones of the old test
    fn init_ok(right_size: bool) -> bool {
        var wr : [8]f32 = [9.0] ** 8;
        var wz : [8]f32 = [9.0] ** 8;
        var wh : [8]f32 = [9.0] ** 8;
        var br : [2]f32 = [9.0] ** 2;
        var bz : [2]f32 = [9.0] ** 2;
        var bh : [2]f32 = [9.0] ** 2;
        if (right_size) {
            const ok = init(GRUWeights{ .Wr = &wr, .br = &br, .Wz = &wz, .bz = &bz, .Wh = &wh, .bh = &bh }, GRUConfig{ .input_size = 2, .hidden_size = 2 });
            return ok and br[1] == 0.0 and wr[7] != 9.0 and @abs(wr[7]) <= 0.5;
        }
        const ok = init(GRUWeights{ .Wr = wr[0..2], .br = br[0..1], .Wz = wz[0..2], .bz = bz[0..1], .Wh = wh[0..2], .bh = bh[0..1] }, GRUConfig{ .input_size = 3, .hidden_size = 2 });
        return ok or wr[0] != 9.0;
    }

    fn valid_input() -> f32 {
        return no_input_step(0.0, 0.0, 1.0);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // Every output stays in (-1, 1), and the input moves it
    test "forward_valid_input"
        given h0 = fixture_step(1.0, 2.0, 3.0, 0)
        when other = fixture_step(-1.0, -2.0, -3.0, 0)
        then h0 > -1.0 and h0 < 1.0 and fixture_step(1.0, 2.0, 3.0, 2) < 1.0 and h0 != other

    // No input: z = s(0) = 0.5 and n = tanh(b_h), so h' = 0.5 tanh(0.5) + 0.5 h
    test "forward_empty_input"
        given result = no_input_step(0.0, 0.5, 0.4)
        then @abs(result - (0.5 * 0.4621172 + 0.2)) < 0.000001

    // A closed update gate (b_z = -30) replaces h with n; an open one (b_z = 30) keeps h
    test "forward_update_gate_interpolates"
        given replaced = no_input_step(-30.0, 0.5, 0.4)
        when kept = no_input_step(30.0, 0.5, 0.4)
        then @abs(replaced - 0.4621172) < 0.000001 and @abs(kept - 0.4) < 0.000001

    test "init_valid_weights"
        given result = init_ok(true)
        then result

    test "init_invalid_weights"
        given result = init_ok(false)
        then result == false

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // input_size > 0
    invariant gru_constraint_0
        assert init_ok(true)

    // hidden_size > 0
    invariant gru_constraint_1
        assert valid_input() > 0.0

    // Wr.size() == (input_size + hidden_size) * hidden_size: init refuses short weights
    invariant gru_constraint_2
        assert init_ok(false) == false

    // Wz.size() == (input_size + hidden_size) * hidden_size
    invariant gru_constraint_3
        assert (2 + 2) * 2 == 8 and init_ok(true)

    // Wh.size() == (input_size + hidden_size) * hidden_size
    invariant gru_constraint_4
        assert (3 + 3) * 3 == 18 and fixture_step(1.0, 2.0, 3.0, 0) < 1.0

    // br.size() == hidden_size
    invariant gru_constraint_5
        assert init_ok(true)

    // bz.size() == hidden_size
    invariant gru_constraint_6
        assert no_input_step(-30.0, 0.0, 0.7) < 0.000001

    // bh.size() == hidden_size
    invariant gru_constraint_7
        assert no_input_step(-30.0, 0.5, 0.0) > 0.46

    // "GRU trains faster than LSTM (fewer parameters)": 3 gates of (n + h) h + h against 4
    invariant gru_constraint_8
        assert 3 * ((2 + 2) * 2 + 2) < 4 * ((2 + 2) * 2 + 2)

    // "GRU performance similar to LSTM on most tasks": both keep the state bounded by tanh
    invariant gru_constraint_9
        assert no_input_step(-30.0, 100.0, 0.0) <= 1.0

    // "Reset gate enables adaptive temporal resolution": with z open the state is held exactly
    invariant gru_constraint_10
        assert no_input_step(30.0, 0.9, valid_input()) == valid_input()
