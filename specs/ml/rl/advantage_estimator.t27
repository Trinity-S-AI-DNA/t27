// Module for computing advantage estimation in reinforcement learning
// Contains functions for temporal difference residuals, GAE, returns, and advantage normalization
// #8980: every function was a TODO that returned 0 or an empty slice, and the empty slice
// does not coerce to []f32, so nothing compiled. Each now computes its formula and writes
// into a caller's buffer, returning the n elements it wrote.

module Advantage {
    // Compute Temporal Difference (TD) residual
    // delta = reward + gamma * next_value * (1 - done) - value
    pub fn compute_td_residual(reward: f32, value: f32, next_value: f32, gamma: f32, done: bool) -> f32 {
        if (done) {
            return reward - value;
        }
        return reward + gamma * next_value - value;
    }

    // Generalized Advantage Estimation (Schulman et al., 2016), walked backwards:
    //   A_t = delta_t + gamma * lambda * (1 - done_t) * A_{t+1}
    // The value after the last step is taken as 0 (the episode is cut there).
    pub fn compute_gae(rewards: []const f32, values: []const f32, dones: []const bool, gamma: f32, lambda_: f32, out: []f32) -> []f32 {
        const n = rewards.len;
        var running : f32 = 0.0;
        var k : usize = 0;
        while (k < n) {
            const t = n - 1 - k;
            var next_value : f32 = 0.0;
            if (t + 1 < n) {
                next_value = values[t + 1];
            }
            if (dones[t]) {
                running = 0.0;
            }
            running = compute_td_residual(rewards[t], values[t], next_value, gamma, dones[t]) + gamma * lambda_ * running;
            out[t] = running;
            k = k + 1;
        }
        return out[0..n];
    }

    // Discounted returns, walked backwards from last_value: G_t = r_t + gamma * (1 - done_t) * G_{t+1}
    pub fn compute_returns(rewards: []const f32, dones: []const bool, last_value: f32, gamma: f32, out: []f32) -> []f32 {
        const n = rewards.len;
        var running : f32 = last_value;
        var k : usize = 0;
        while (k < n) {
            const t = n - 1 - k;
            if (dones[t]) {
                running = 0.0;
            }
            running = rewards[t] + gamma * running;
            out[t] = running;
            k = k + 1;
        }
        return out[0..n];
    }

    // (a - mean) / (std + 1e-8), population std
    pub fn normalize_advantages(advantages: []const f32, out: []f32) -> []f32 {
        const n = advantages.len;
        if (n == 0) {
            return out[0..0];
        }
        var mean : f32 = 0.0;
        var k : usize = 0;
        while (k < n) {
            mean = mean + advantages[k];
            k = k + 1;
        }
        mean = mean / @as(f32, @floatFromInt(n));
        var variance : f32 = 0.0;
        k = 0;
        while (k < n) {
            variance = variance + (advantages[k] - mean) * (advantages[k] - mean);
            k = k + 1;
        }
        const sd = sqrt(variance / @as(f32, @floatFromInt(n)));
        k = 0;
        while (k < n) {
            out[k] = (advantages[k] - mean) / (sd + 0.00000001);
            k = k + 1;
        }
        return out[0..n];
    }

    // Test for compute_td_residual function
    test "test_compute_td_residual_basic" {
        // Test basic TD residual calculation
        const reward: f32 = 1.0;
        const value: f32 = 0.5;
        const next_value: f32 = 0.7;
        const gamma: f32 = 0.99;
        const done: bool = false;
        
        const result = compute_td_residual(reward, value, next_value, gamma, done);
        // Expected: 1.0 + 0.99 * 0.7 * (1 - 0) - 0.5 = 1.0 + 0.693 - 0.5 = 1.193
        try std.testing.expect(result > 1.19 and result < 1.20);
    }

    test "test_compute_td_residual_done" {
        // Test TD residual when episode is done
        const reward: f32 = 1.0;
        const value: f32 = 0.5;
        const next_value: f32 = 0.7;
        const gamma: f32 = 0.99;
        const done: bool = true;
        
        const result = compute_td_residual(reward, value, next_value, gamma, done);
        // When done, next_value should not be used
        // Expected: 1.0 + 0.99 * 0.7 * (1 - 1) - 0.5 = 1.0 + 0 - 0.5 = 0.5
        try std.testing.expect(result > 0.49 and result < 0.51);
    }

    test "test_compute_gae_basic" {
        // Test basic GAE calculation
        const rewards: []const f32 = &[_]f32{1.0, 2.0, 3.0};
        const values: []const f32 = &[_]f32{0.5, 0.7, 0.9};
        const dones: []const bool = &[_]bool{false, false, false};
        const gamma: f32 = 0.99;
        const lambda_: f32 = 0.95;
        
        var out: [3]f32 = [_]f32{9.0} ** 3;
        const result = compute_gae(rewards, values, dones, gamma, lambda_, &out);
        // Should return array of advantages: deltas (2.193, 2.191, 2.1) folded back with 0.9405
        try std.testing.expect(result.len == 3);
        try std.testing.expect(@abs(result[2] - 2.1) < 0.000001);
        try std.testing.expect(@abs(result[1] - 4.16605) < 0.00001);
        try std.testing.expect(@abs(result[0] - 5.11117) < 0.00001);
    }

    test "test_compute_returns_basic" {
        // Test basic returns calculation
        const rewards: []const f32 = &[_]f32{1.0, 2.0, 3.0};
        const dones: []const bool = &[_]bool{false, false, false};
        const last_value: f32 = 0.5;
        const gamma: f32 = 0.99;
        
        var out: [3]f32 = [_]f32{9.0} ** 3;
        const result = compute_returns(rewards, dones, last_value, gamma, &out);
        // Should return array of returns: 3 + 0.99 * 0.5 = 3.495, then 5.46005, 6.4054495
        try std.testing.expect(result.len == 3);
        try std.testing.expect(@abs(result[2] - 3.495) < 0.000001);
        try std.testing.expect(@abs(result[0] - 6.4054495) < 0.00001);
    }

    test "test_normalize_advantages_basic" {
        // Test advantage normalization
        const advantages: []const f32 = &[_]f32{1.0, -1.0, 2.0, -2.0, 0.5, -0.5};
        
        var out: [6]f32 = [_]f32{9.0} ** 6;
        const result = normalize_advantages(advantages, &out);
        // Should return normalized advantages: mean 0, std 1.3229, so 1.0 -> 0.7559289
        try std.testing.expect(result.len == 6);
        try std.testing.expect(@abs(result[0] - 0.7559289) < 0.000001);
        try std.testing.expect(@abs(result[2] + result[3]) < 0.000001);
    }

    test "test_compute_td_residual_edge_cases" {
        // Test edge cases for TD residual
        const reward: f32 = 0.0;
        const value: f32 = 0.0;
        const next_value: f32 = 0.0;
        const gamma: f32 = 1.0;
        const done: bool = false;
        
        const result = compute_td_residual(reward, value, next_value, gamma, done);
        try std.testing.expect(result == 0.0);
    }

    test "test_compute_gae_single_step" {
        // Test GAE with single step
        const rewards: []const f32 = &[_]f32{1.0};
        const values: []const f32 = &[_]f32{0.5};
        const dones: []const bool = &[_]bool{false};
        const gamma: f32 = 0.99;
        const lambda_: f32 = 0.95;
        
        var out: [1]f32 = [_]f32{9.0};
        const result = compute_gae(rewards, values, dones, gamma, lambda_, &out);
        try std.testing.expect(result.len == 1);
        try std.testing.expect(@abs(result[0] - 0.5) < 0.000001);
    }

    test "test_compute_returns_single_step" {
        // Test returns with single step
        const rewards: []const f32 = &[_]f32{1.0};
        const dones: []const bool = &[_]bool{false};
        const last_value: f32 = 0.5;
        const gamma: f32 = 0.99;
        
        var out: [1]f32 = [_]f32{9.0};
        const result = compute_returns(rewards, dones, last_value, gamma, &out);
        try std.testing.expect(result.len == 1);
        try std.testing.expect(@abs(result[0] - 1.495) < 0.000001);
    }

    test "test_normalize_advantages_empty" {
        // Test normalization with empty array
        const advantages: []const f32 = &[_]f32{};
        
        var out: [1]f32 = [_]f32{9.0};
        const result = normalize_advantages(advantages, &out);
        try std.testing.expect(result.len == 0);
        try std.testing.expect(out[0] == 9.0);
    }
}