// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Polyak averaging formula | φ² + 1/φ² = 3 | TRINITY

// #8980: an empty enum, `for i in 0..source.length`, and tests asserting
// `result != undefined`, so nothing compiled. should_update also ignored the
// method: a soft (Polyak) target updates every step, a hard one every update_freq
// steps.

module DqnTarget;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_TAU : f32 = 0.005;
    const DEFAULT_UPDATE_FREQ : u32 = 1000;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const UpdateMethod = enum(u8) {
        Hard,
        Soft,
    };

    pub const TargetUpdateConfig = struct {
        method : UpdateMethod,
        tau : f32,
        update_freq : u32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // target = source
    fn hard_update(source: []const f32, target: []f32) -> void {
        var i : usize = 0;
        while (i < source.len) {
            target[i] = source[i];
            i = i + 1;
        }
    }

    // Polyak averaging: target = tau * source + (1 - tau) * target
    fn soft_update(source: []const f32, target: []f32, tau: f32) -> void {
        var i : usize = 0;
        while (i < source.len) {
            target[i] = tau * source[i] + (1.0 - tau) * target[i];
            i = i + 1;
        }
    }

    // Soft: every step. Hard: every update_freq steps (step 0 excluded, nothing to copy yet).
    fn should_update(step: u32, config: TargetUpdateConfig) -> bool {
        if (config.method == UpdateMethod.Soft) {
            return true;
        }
        return step > 0 and step % config.update_freq == 0;
    }

    fn cfg(method: UpdateMethod) -> TargetUpdateConfig {
        return TargetUpdateConfig{ .method = method, .tau = DEFAULT_TAU, .update_freq = DEFAULT_UPDATE_FREQ };
    }

    // target[index] after one hard update from (1, 2, 3) onto (0, 0, 0)
    fn hard_at(index: usize) -> f32 {
        const source : [3]f32 = [1.0, 2.0, 3.0];
        var target : [3]f32 = [0.0] ** 3;
        hard_update(&source, &target);
        return target[index];
    }

    // target[0] after `steps` soft updates from source 1 onto target 0
    fn soft_after(steps: u32, tau: f32) -> f32 {
        const source : [1]f32 = [1.0];
        var target : [1]f32 = [0.0];
        var n : u32 = 0;
        while (n < steps) {
            soft_update(&source, &target, tau);
            n = n + 1;
        }
        return target[0];
    }

    fn valid_input() -> f32 {
        return DEFAULT_TAU;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test hard_update_basic_case
        given first = hard_at(0)
        when last = hard_at(2)
        then first == 1.0 and last == 3.0

    // One step moves tau of the way: 0.005; n steps leave (1 - tau)^n of the gap
    test soft_update_basic_case
        given one = soft_after(1, DEFAULT_TAU)
        when many = soft_after(1000, DEFAULT_TAU)
        then @abs(one - 0.005) < 0.0000001 and @abs(many - (1.0 - 0.0066540)) < 0.0001

    test should_update_basic_case
        given hard = should_update(1000, cfg(UpdateMethod.Hard))
        when early = should_update(999, cfg(UpdateMethod.Hard))
        then hard and !early and should_update(999, cfg(UpdateMethod.Soft)) and !should_update(0, cfg(UpdateMethod.Hard))

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // 0 <= tau <= 1
    invariant dqn_target_constraint_0
        assert valid_input() >= 0.0 and valid_input() <= 1.0

    // tau << 1 for stability (typically 0.001-0.01)
    invariant dqn_target_constraint_1
        assert valid_input() >= 0.001 and valid_input() <= 0.01

    // update_freq >= 1
    invariant dqn_target_constraint_2
        assert DEFAULT_UPDATE_FREQ >= 1

    // name: soft_update_equation -- tau = 1 is a hard update
    invariant dqn_target_constraint_3
        assert soft_after(1, 1.0) == 1.0

    // "Mnih et al. (2015) - Human-level control through deep RL": the hard copy every C steps
    invariant dqn_target_constraint_4
        assert hard_at(1) == 2.0

    // "Lillicrap et al. (2016) - Continuous control with DDPG (soft update)": tau = 0 never moves
    invariant dqn_target_constraint_5
        assert soft_after(3, 0.0) == 0.0
