// SPDX-License-Identifier: Apache-2.0
; specs/mcp/audit.t27 -- the audit-record law of the M0 MCP connector
; (#13583). Every M0 invocation, allow or refusal, leaves ONE record with all
; nine required fields; the record carries HASHES of arguments and output,
; never the arguments themselves, and there is no field a token could hide in
; (the args hash is computed with FNV-1a 64 over the caller's bytes; the
; caller passes only bytes it wants on the record). The gateway lowers this to
; its structured log; specs/mcp/policy.t27 refuses arguments that carry a
; secret before this spec is ever asked to hash them. L3/L4; gen-c string
; traps respected (explicit lengths, no .len, no ==, no NUL assumptions).
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpM0Audit;

pub const FIELD_COUNT : usize = 9;
pub const RECORD_CAP : usize = 512;
pub const APPROVAL_NONE : u8 = 0;
pub const APPROVAL_DRY_RUN : u8 = 1;
pub const APPROVAL_CONFIRMED : u8 = 2;
pub const RESULT_ALLOWED : u8 = 0;
pub const RESULT_DENIED : u8 = 1;
pub const RESULT_ERROR : u8 = 2;

; The dialect has no wrapping arithmetic (specs/numeric/sha256.t27), so the
; hash runs in u64 lanes masked to 32 bits: FNV-1a 32 -- a byte at 8 bits,
; a 32-bit state, a 25-bit prime, so no product can reach 2^63 and no step
; can trap. It is a POSITIONAL fingerprint, not a cryptographic one.
pub const H_MASK : u64 = 4294967295;
pub const H_PRIME : u64 = 16777619;
pub const H_SEED : u64 = 2166136261;

pub fn fnv1a32(s : str, slen : usize) -> u64 {
    var h : u64 = H_SEED;
    var i : usize = 0;
    while i < slen {
        h = h ^ (s[i] as u64);
        h = (h * H_PRIME) & H_MASK;
        i += 1;
    }
    return h;
}

pub fn put_str(out : []u8, cap : usize, w : usize, s : str, slen : usize) -> usize {
    var k : usize = 0;
    while k < slen {
        if w + k < cap {
            out[w + k] = s[k];
        }
        k += 1;
    }
    return w + slen;
}

pub fn put_u64(out : []u8, cap : usize, w : usize, v_in : u64) -> usize {
    var v : u64 = v_in;
    if v == 0 and w < cap {
        out[w] = '0';
        return w + 1;
    }
    var buf : [20]u8 = undefined;
    var n : usize = 0;
    while v > 0 {
        buf[n] = ('0' as u8) + (v % 10) as u8;
        n += 1;
        v = v / 10;
    }
    var k : usize = 0;
    while k < n {
        if w + k < cap {
            out[w + k] = buf[n - 1 - k];
        }
        k += 1;
    }
    return w + n;
}

pub fn put_u8(out : []u8, cap : usize, w : usize, v : u8) -> usize {
    if w < cap {
        out[w] = ('0' as u8) + v;
    }
    return w + 1;
}

; The nine fields, in order, tab-separated, one line:
; ts, actor, tool, args_sha, target, dry_run, approval, result, out_sha.
; ts is epoch seconds; dry_run/approval/result are single-digit codes; the
; two hashes are FNV-1a 64 decimal (positional, not cryptographic -- the
; tamper-evident seal of the LOG is a later ring; M0 pins the schema).
pub fn audit_encode(out : []u8, cap : usize,
                    ts : i64,
                    actor : str, actor_len : usize,
                    tool : str, tool_len : usize,
                    args_sha : u64,
                    target : str, target_len : usize,
                    dry_run : bool,
                    approval : u8,
                    result : u8,
                    out_sha : u64) -> usize {
    var w : usize = 0;
    w = put_u64(out, cap, w, ts as u64);
    w = put_str(out, cap, w, "\t", 1);
    w = put_str(out, cap, w, actor, actor_len);
    w = put_str(out, cap, w, "\t", 1);
    w = put_str(out, cap, w, tool, tool_len);
    w = put_str(out, cap, w, "\t", 1);
    w = put_u64(out, cap, w, args_sha);
    w = put_str(out, cap, w, "\t", 1);
    w = put_str(out, cap, w, target, target_len);
    w = put_str(out, cap, w, "\t", 1);
    if dry_run {
        w = put_u8(out, cap, w, 1);
    } else {
        w = put_u8(out, cap, w, 0);
    }
    w = put_str(out, cap, w, "\t", 1);
    w = put_u8(out, cap, w, approval);
    w = put_str(out, cap, w, "\t", 1);
    w = put_u8(out, cap, w, result);
    w = put_str(out, cap, w, "\t", 1);
    w = put_u64(out, cap, w, out_sha);
    w = put_str(out, cap, w, "\n", 1);
    return w;
}

pub fn field_count_of_record(rec : []u8, rlen : usize) -> usize {
    var n : usize = 1;
    var i : usize = 0;
    while i < rlen {
        if rec[i] == '\t' {
            n += 1;
        }
        i += 1;
    }
    return n;
}

; -- invariant: approval and result codes stay inside their tables.
invariant codes_are_in_range {
    assert APPROVAL_NONE <= APPROVAL_CONFIRMED;
    assert APPROVAL_CONFIRMED < 3;
    assert RESULT_ALLOWED < RESULT_DENIED;
    assert RESULT_DENIED < RESULT_ERROR;
    assert RESULT_ERROR < 3;
    assert FIELD_COUNT == 9;
}

; -- tests

test fnv1a64_is_stable_and_order_sensitive {
    assert fnv1a32("", 0) == H_SEED;
    assert fnv1a32("a", 1) == fnv1a32("a", 1);
    assert fnv1a32("ab", 2) != fnv1a32("ba", 2);
    assert fnv1a32("seal specs/mcp/a.t27", 19) != fnv1a32("seal specs/mcp/b.t27", 20);
}

test record_has_nine_tab_fields_and_one_line {
    var out : [RECORD_CAP]u8 = undefined;
    const n : usize = audit_encode(&out, RECORD_CAP,
        1762797315, "queen", 5, "t27.agent.stop", 14,
        fnv1a32("agent-42", 8), "agent-42", 8, true,
        APPROVAL_CONFIRMED, RESULT_ALLOWED, fnv1a32("ok", 2));
    assert n > 9;
    assert field_count_of_record(&out, n) == FIELD_COUNT;
    assert out[n - 1] == '\n';
}

test record_hashes_arguments_instead_of_carrying_them {
    var out : [RECORD_CAP]u8 = undefined;
    const args : str = "--token gho_SUPERSECRET";
    const n : usize = audit_encode(&out, RECORD_CAP,
        1762797315, "queen", 5, "t27.shell.run", 13,
        fnv1a32(args, 23), "t27c seal", 9, true,
        APPROVAL_DRY_RUN, RESULT_DENIED, 0);
    var i : usize = 0;
    var leaked : bool = false;
    while i < n {
        if out[i] == 'g' and i + 3 < n and out[i + 1] == 'h' and out[i + 2] == 'o' and out[i + 3] == '_' {
            leaked = true;
        }
        i += 1;
    }
    assert leaked == false;
    assert put_u64(&out, RECORD_CAP, 0, fnv1a32(args, 23)) > 0;
}

test every_required_field_is_present_in_order {
    var out : [RECORD_CAP]u8 = undefined;
    const n : usize = audit_encode(&out, RECORD_CAP,
        1, "bee", 3, "t27.status", 10, 7, "dsh", 3, false,
        APPROVAL_NONE, RESULT_ALLOWED, 9);
    assert field_count_of_record(&out, n) == 9;
    assert out[0] == 49;
    assert out[1] == 9;
    assert out[2] == 98;
    assert out[n - 2] == 57;
    assert out[n - 3] == 9;
    assert out[n - 1] == 10;
}

test a_short_buffer_never_writes_past_its_cap {
    var out : [8]u8 = undefined;
    const n : usize = audit_encode(&out, 8,
        1, "bee", 3, "t27.status", 10, 7, "dsh", 3, false,
        APPROVAL_NONE, RESULT_ALLOWED, 9);
    assert n > 8;
    assert field_count_of_record(&out, 8) < 9;
}
