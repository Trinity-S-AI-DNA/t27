// SPDX-License-Identifier: Apache-2.0
; specs/mcp/cdp_observer.t27 -- the CDP observer law of the M0 MCP connector
; (#13583). M0 OBSERVES ONLY: connect to a dedicated Chrome profile on
; 127.0.0.1, list targets, read the URL, capture a screenshot and an
; accessibility/DOM snapshot. No navigation, click or input exists in M0 --
; the method allowlist below IS the surface, and every CDP method outside it
; is refused before it reaches the browser (fail-closed). Measured
; 2026-11-10: the daily BrowserOS profile runs with no remote-debugging port;
; the observer therefore targets a dedicated profile the user starts on a
; loopback port (docs/mcp/m0-inventory.md). Method names are stored as fixed
; 28-byte records (name padded with underscore bytes), so the matcher never reads
; past a record and never depends on NUL termination.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpM0CdpObserver;

pub const METHOD_MAX : usize = 28;
pub const METHOD_COUNT : usize = 4;
pub const M_GET_TARGETS : usize = 0;
pub const M_SCREENSHOT : usize = 1;
pub const M_AX_TREE : usize = 2;
pub const M_READ_URL : usize = 3;

; The allowlist, 28 bytes per row, zero-padded. Nothing else reaches Chrome.
pub const METHODS : [112]u8 = [
    'T','a','r','g','e','t','.','g','e','t','T','a','r','g','e','t','s','_','_','_','_','_','_','_','_','_','_','_',
    'P','a','g','e','.','c','a','p','t','u','r','e','S','c','r','e','e','n','s','h','o','t','_','_','_','_','_','_',
    'A','c','c','e','s','s','i','b','i','l','i','t','y','.','g','e','t','F','u','l','l','A','X','T','r','e','e','_',
    'T','a','r','g','e','t','.','g','e','t','T','a','r','g','e','t','I','n','f','o','_','_','_','_','_','_','_','_'
];
pub const METHOD_NAME_LENS : [4]usize = [17, 22, 27, 20];
pub const METHOD_DOMAINS : [4]str = ["Target", "Page", "Accessibility", "Target"];

pub fn method_byte(row : usize, k : usize) -> u8 {
    return METHODS[row * METHOD_MAX + k];
}

pub fn method_len(idx : usize) -> usize {
    if idx >= METHOD_COUNT {
        return 0;
    }
    return METHOD_NAME_LENS[idx];
}

; The observer answers one question: may this CDP method run? domain_first is
; the byte at the start of the request's method name; everything not in the
; table is refused. A method name longer than any record is refused too.
pub fn cdp_gate(name : str, nlen : usize) -> u8 {
    if nlen == 0 or nlen > METHOD_MAX {
        return 2;
    }
    var r : usize = 0;
    while r < METHOD_COUNT {
        const l : usize = METHOD_NAME_LENS[r];
        if l == nlen {
            var k : usize = 0;
            var hit : bool = true;
            while k < nlen {
                if name[k] != method_byte(r, k) {
                    hit = false;
                }
                k += 1;
            }
            if hit {
                return 0;
            }
        }
        r += 1;
    }
    return 1;
}

; M0 forbids the write verbs outright, by name, even if a later ring widens
; the table: this function is the negative control the tests pin.
pub fn is_write_verb(name : str, nlen : usize) -> bool {
    if nlen >= 9 and name[0] == 'P' and name[1] == 'a' and name[2] == 'g' and name[3] == 'e' and name[4] == '.' {
        var k : usize = 5;
        var nav : bool = true;
        const navw : str = "navigate";
        while k < 13 {
            if name[k] != navw[k - 5] {
                nav = false;
            }
            k += 1;
        }
        if nav {
            return true;
        }
    }
    if nlen >= 11 and name[0] == 'I' and name[1] == 'n' and name[2] == 'p' and name[3] == 'u' and name[4] == 't' and name[5] == '.' {
        return true;
    }
    return false;
}

invariant method_table_aligned {
    var r : usize = 0;
    while (r < METHOD_COUNT) {
        const l : usize = METHOD_NAME_LENS[r];
        assert l > 0;
        assert l < METHOD_MAX;
        var k : usize = 0;
        while (k < l) {
            assert method_byte(r, k) != 0;
            k += 1;
        }
        assert method_byte(r, l) == 95;
        r += 1;
    }
}

; -- tests

test the_four_observer_methods_are_allowed {
    assert cdp_gate("Target.getTargets", 17) == 0;
    assert cdp_gate("Page.captureScreenshot________", 22) == 0;
    assert cdp_gate("Accessibility.getFullAXTree", 27) == 0;
    assert cdp_gate("Target.getTargetInfo", 20) == 0;
}

test everything_outside_the_table_is_refused {
    assert cdp_gate("Page.navigate", 13) == 1;
    assert cdp_gate("Input.dispatchMouseEvent", 24) == 1;
    assert cdp_gate("Runtime.evaluate", 16) == 1;
    assert cdp_gate("Emulation.setDeviceMetricsOverride", 34) == 2;
    assert cdp_gate("", 0) == 2;
    assert cdp_gate("Page.captureScreenshot________", 30) == 2;
}

test write_verbs_are_recognized_and_refused_by_the_gate {
    assert is_write_verb("Page.navigate", 13) == true;
    assert is_write_verb("Input.insertText", 16) == true;
    assert is_write_verb("Input.dispatchKeyEvent", 22) == true;
    assert is_write_verb("Page.captureScreenshot________", 22) == false;
    assert cdp_gate("Page.navigate", 13) != 0;
    assert cdp_gate("Input.insertText", 16) != 0;
}

test a_prefix_of_an_allowed_method_is_not_allowed {
    assert cdp_gate("Target.getTar", 13) == 1;
    assert cdp_gate("Page.capture", 12) == 1;
}
