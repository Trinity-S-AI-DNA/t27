// SPDX-License-Identifier: Apache-2.0
; specs/mcp/t27_dsh_mcp.t27 -- the M0 tool contract of the T27/DSH/CDP MCP
; connector (issue #13583). M0 is read-only observability plus bounded task
; coordination: nine tools, each with a risk class, and one gate function that
; decides whether an invocation may run. The gate is the LAW; the gateway
; process (a later ring) only lowers it. Facts the contract encodes are in
; docs/mcp/m0-inventory.md; the allowlists it consults live in
; specs/mcp/policy.t27; the record every invocation leaves is
; specs/mcp/audit.t27. Reuses the descriptor idea of
; specs/mcp/tool_registry.tri (ring 105-004) without a second registry.
; Risk classes: 0 low (read-only, no confirmation), 1 medium (bounded write,
; dry-run default), 2 high (write, dry-run default AND explicit confirmation).
; Verdicts: 0 allow, 1 deny_dry_run_required, 2 deny_confirmation_required,
; 3 deny_unknown_tool, 4 deny_not_allowlisted. Fail-closed: any input the gate
; cannot classify is a deny. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module McpM0Contract;

pub const TOOL_COUNT : usize = 9;
pub const RISK_LOW : u8 = 0;
pub const RISK_MEDIUM : u8 = 1;
pub const RISK_HIGH : u8 = 2;
pub const ALLOW : u8 = 0;
pub const DENY_DRY_RUN : u8 = 1;
pub const DENY_CONFIRM : u8 = 2;
pub const DENY_UNKNOWN : u8 = 3;
pub const DENY_SCOPE : u8 = 4;
pub const DRY_RUN_DEFAULT : bool = true;

; Tool ids, row i of NAMES, RISKS and WRITES describes the same tool.
; NAMES: t27.status, t27.agent.list, t27.task.create, t27.task.report,
; t27.agent.stop, t27.shell.run, browser.observe, browser.act, dsh.send.
pub const NAMES : [9]str = [
    "t27.status", "t27.agent.list", "t27.task.create", "t27.task.report",
    "t27.agent.stop", "t27.shell.run", "browser.observe", "browser.act",
    "dsh.send"
];
pub const RISKS : [9]u8 = [0, 0, 1, 0, 2, 2, 0, 2, 2];
pub const WRITES : [9]bool = [false, false, true, false, true, true, false, true, true];

; The tool table is aligned: a row's write flag follows from its risk class,
; and no low-risk tool writes.
invariant risk_implies_write {
    var i : usize = 0;
    while (i < TOOL_COUNT) {
        if RISKS[i] == RISK_LOW {
            assert WRITES[i] == false;
        } else {
            assert WRITES[i] == true;
        }
        i += 1;
    }
}

pub fn tool_index(name : str, len : usize) -> usize {
    var i : usize = 0;
    while i < TOOL_COUNT {
        if name_eq(name, len, NAMES[i], NAME_LENS[i]) {
            return i;
        }
        i = i + 1;
    }
    return TOOL_COUNT;
}

pub fn tool_risk(idx : usize) -> u8 {
    if idx >= TOOL_COUNT {
        return 255;
    }
    return RISKS[idx];
}

pub fn is_write_tool(idx : usize) -> bool {
    if idx >= TOOL_COUNT {
        return true;
    }
    return WRITES[idx];
}

; THE GATE. dry_run and confirmed are what the invocation carried; the policy
; scope bit is handed in by the caller after specs/mcp/policy.t27 had its say
; (true = the target passed the allowlists). The dry_run_default rule is a
; property of WRITE tools: a write invocation that does not carry dry_run
; explicitly is not an allow -- M0 answers DENY_DRY_RUN and the gateway runs
; it as dry-run instead.
pub fn gate(idx : usize, dry_run_explicit : bool, confirmed : bool, in_scope : bool) -> u8 {
    if idx >= TOOL_COUNT {
        return DENY_UNKNOWN;
    }
    if WRITES[idx] == false {
        return ALLOW;
    }
    if in_scope == false {
        return DENY_SCOPE;
    }
    if RISKS[idx] == RISK_HIGH {
        if confirmed == false {
            return DENY_CONFIRM;
        }
        if dry_run_explicit == false {
            return DENY_DRY_RUN;
        }
        return ALLOW;
    }
    if dry_run_explicit == false {
        return DENY_DRY_RUN;
    }
    return ALLOW;
}

pub const NAME_LENS : [9]usize = [10, 14, 15, 15, 13, 13, 15, 11, 8];

pub fn name_eq(a : str, alen : usize, b : str, blen : usize) -> bool {
    if alen != blen {
        return false;
    }
    var i : usize = 0;
    while i < alen {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

; -- tests

test all_nine_tools_are_discoverable {
    assert tool_index("t27.status", 10) == 0;
    assert tool_index("t27.agent.list", 14) == 1;
    assert tool_index("t27.task.create", 15) == 2;
    assert tool_index("t27.task.report", 15) == 3;
    assert tool_index("t27.agent.stop", 13) == 4;
    assert tool_index("t27.shell.run", 13) == 5;
    assert tool_index("browser.observe", 15) == 6;
    assert tool_index("browser.act", 11) == 7;
    assert tool_index("dsh.send", 8) == 8;
}

test unknown_tool_denies {
    assert tool_index("t27.statusx", 11) == TOOL_COUNT;
    assert gate(TOOL_COUNT, true, true, true) == DENY_UNKNOWN;
}

test read_only_tools_allow_without_confirmation {
    assert gate(0, false, false, false) == ALLOW;
    assert gate(1, false, false, false) == ALLOW;
    assert gate(3, false, false, false) == ALLOW;
    assert gate(6, false, false, false) == ALLOW;
}

test write_tools_require_scope_before_anything_else {
    assert gate(2, true, false, false) == DENY_SCOPE;
    assert gate(4, true, true, false) == DENY_SCOPE;
    assert gate(8, true, true, false) == DENY_SCOPE;
}

test high_risk_requires_confirmation_and_explicit_dry_run {
    assert gate(4, false, false, true) == DENY_CONFIRM;
    assert gate(4, true, false, true) == DENY_CONFIRM;
    assert gate(4, false, true, true) == DENY_DRY_RUN;
    assert gate(4, true, true, true) == ALLOW;
    assert gate(5, true, true, true) == ALLOW;
    assert gate(7, true, true, true) == ALLOW;
    assert gate(8, true, true, true) == ALLOW;
}

test medium_risk_is_dry_run_first_without_confirmation {
    assert gate(2, true, false, true) == ALLOW;
    assert gate(2, false, true, true) == DENY_DRY_RUN;
}
