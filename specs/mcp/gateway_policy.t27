// specs/mcp/gateway_policy.t27 -- M1 gateway policy law for the read-only MCP
// gateway. Sealed M0 specs plus M1 gateway policy and log contract laws.
// Part of M1 milestone (milestone #5). Refs #13616.
// phi^2 + 1/phi^2 = 3 | TRINITY

module mcp::gateway_policy;

pub const GATEWAY_READ_ONLY : bool = true;
pub const GATEWAY_TOOLS_COUNT : u32 = 10;

pub struct GatewayPolicy { read_only: bool, tool_count: u32 };

pub fn gateway_policy_read_only(p: GatewayPolicy) -> bool {
    return p.read_only;
}

pub fn gateway_policy_tool_count_ok(p: GatewayPolicy) -> bool {
    return p.tool_count == GATEWAY_TOOLS_COUNT;
}

test "gateway policy is read only" {
    assert(gateway_policy_read_only(GatewayPolicy { read_only: true, tool_count: 10 }));
    assert(!gateway_policy_read_only(GatewayPolicy { read_only: false, tool_count: 10 }));
}

test "gateway policy tool count" {
    assert(gateway_policy_tool_count_ok(GatewayPolicy { read_only: true, tool_count: 10 }));
    assert(!gateway_policy_tool_count_ok(GatewayPolicy { read_only: true, tool_count: 9 }));
}

invariant gateway_read_only_default {
    assert GATEWAY_READ_ONLY;
}

invariant gateway_tools_count_is_ten {
    assert GATEWAY_TOOLS_COUNT == 10;
}