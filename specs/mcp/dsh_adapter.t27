// SPDX-License-Identifier: Apache-2.0
; specs/mcp/dsh_adapter.t27 -- the DSH adapter law of the M0 MCP connector
; (#13583). The adapter speaks to the DeepSeek Harness endpoint (measured
; 2026-11-10: http://127.0.0.1:3081, auth-gated -- docs/mcp/m0-inventory.md)
; and supports five operations: health check, agent list, task create, task
; report, agent stop. This spec is the REQUEST law: it builds the exact body
; of each call and decides whether the call may leave. The token NEVER enters
; a body: the caller reads it from the environment (T27_DSH_TOKEN) and puts
; it in the transport header only, outside every buffer this spec touches.
; Operation codes: 0 health, 1 agent_list, 2 task_create, 3 task_report,
; 4 agent_stop. Verdicts mirror the contract gate: 0 send, 1 needs_dry_run,
; 2 needs_confirmation, 3 unknown_op, 4 out_of_scope.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpM0DshAdapter;

pub const OP_COUNT : usize = 5;
pub const OP_HEALTH : u8 = 0;
pub const OP_AGENT_LIST : u8 = 1;
pub const OP_TASK_CREATE : u8 = 2;
pub const OP_TASK_REPORT : u8 = 3;
pub const OP_AGENT_STOP : u8 = 4;
pub const SEND : u8 = 0;
pub const NEEDS_DRY_RUN : u8 = 1;
pub const NEEDS_CONFIRMATION : u8 = 2;
pub const UNKNOWN_OP : u8 = 3;
pub const OUT_OF_SCOPE : u8 = 4;
pub const WRITE_OPS : [5]bool = [false, false, true, false, true];

; The authorization gate for one DSH call. token_present must come from the
; caller's environment check; a call without a token never leaves. Write
; operations take the contract path (dry_run explicit, confirmation for stop).
pub fn dsh_gate(op : usize, dry_run_explicit : bool, confirmed : bool,
                token_present : bool) -> u8 {
    if op >= OP_COUNT {
        return UNKNOWN_OP;
    }
    if token_present == false {
        return OUT_OF_SCOPE;
    }
    if WRITE_OPS[op] == false {
        return SEND;
    }
    if op == OP_AGENT_STOP and confirmed == false {
        return NEEDS_CONFIRMATION;
    }
    if dry_run_explicit == false {
        return NEEDS_DRY_RUN;
    }
    return SEND;
}

; Bodies are JSON built byte by byte. agent_list/health carry an empty object;
; task_create carries the bounded task fields; agent_stop names the target.
pub fn body_health(out : []u8, cap : usize) -> usize {
    return put_lit(out, cap, 0, "{}", 2);
}

pub fn body_agent_list(out : []u8, cap : usize) -> usize {
    return put_lit(out, cap, 0, "{}", 2);
}

pub fn body_task_create(out : []u8, cap : usize, task_id : str, id_len : usize,
                        spec_path : str, sp_len : usize, dry_run : bool) -> usize {
    var w : usize = 0;
    w = put_lit(out, cap, w, "{\"task_id\":\"", 12);
    w = put_lit(out, cap, w, task_id, id_len);
    w = put_lit(out, cap, w, "\",\"spec\":\"", 10);
    w = put_lit(out, cap, w, spec_path, sp_len);
    w = put_lit(out, cap, w, "\",\"dry_run\":", 12);
    if dry_run {
        w = put_lit(out, cap, w, "true", 4);
    } else {
        w = put_lit(out, cap, w, "false", 5);
    }
    w = put_lit(out, cap, w, "}", 1);
    return w;
}

pub fn body_task_report(out : []u8, cap : usize, task_id : str, id_len : usize) -> usize {
    var w : usize = 0;
    w = put_lit(out, cap, w, "{\"task_id\":\"", 12);
    w = put_lit(out, cap, w, task_id, id_len);
    w = put_lit(out, cap, w, "\"}", 2);
    return w;
}

pub fn body_agent_stop(out : []u8, cap : usize, agent_id : str, a_len : usize) -> usize {
    var w : usize = 0;
    w = put_lit(out, cap, w, "{\"agent_id\":\"", 13);
    w = put_lit(out, cap, w, agent_id, a_len);
    w = put_lit(out, cap, w, "\"}", 2);
    return w;
}

pub fn put_lit(out : []u8, cap : usize, w : usize, s : str, slen : usize) -> usize {
    var k : usize = 0;
    while k < slen {
        if w + k < cap {
            out[w + k] = s[k];
        }
        k += 1;
    }
    return w + slen;
}

invariant write_ops_match_contract {
    var i : usize = 0;
    while (i < OP_COUNT) {
        if i == OP_AGENT_STOP or i == OP_TASK_CREATE {
            assert WRITE_OPS[i] == true;
        } else {
            assert WRITE_OPS[i] == false;
        }
        i += 1;
    }
}

; -- tests

test reads_send_with_a_token_and_never_without {
    assert dsh_gate(OP_HEALTH, false, false, true) == SEND;
    assert dsh_gate(OP_AGENT_LIST, false, false, true) == SEND;
    assert dsh_gate(OP_TASK_REPORT, false, false, true) == SEND;
    assert dsh_gate(OP_HEALTH, false, false, false) == OUT_OF_SCOPE;
}

test stop_requires_confirmation_then_explicit_dry_run {
    assert dsh_gate(OP_AGENT_STOP, true, false, true) == NEEDS_CONFIRMATION;
    assert dsh_gate(OP_AGENT_STOP, false, true, true) == NEEDS_DRY_RUN;
    assert dsh_gate(OP_AGENT_STOP, true, true, true) == SEND;
}

test task_create_is_dry_run_first_without_confirmation {
    assert dsh_gate(OP_TASK_CREATE, true, false, true) == SEND;
    assert dsh_gate(OP_TASK_CREATE, false, true, true) == NEEDS_DRY_RUN;
}

test unknown_operations_are_refused {
    assert dsh_gate(5, true, true, true) == UNKNOWN_OP;
    assert dsh_gate(255, true, true, true) == UNKNOWN_OP;
}

test bodies_are_exact_and_carry_no_token {
    var out : [256]u8 = undefined;
    var n : usize = body_health(&out, 256);
    assert n == 2;
    assert out[0] == 123 and out[1] == 125;
    n = body_task_create(&out, 256, "m0-1", 4, "specs/mcp/a.t27", 15, true);
    assert n == 58;
    assert out[12] == 109;
    n = body_agent_stop(&out, 256, "agent-42", 8);
    assert n == 23;
    n = body_task_report(&out, 256, "m0-1", 4);
    assert n == 18;
    var i : usize = 0;
    var leaked : bool = false;
    while i < n {
        if out[i] == 116 and out[i + 1] == 111 and out[i + 2] == 107 and out[i + 3] == 101 and out[i + 4] == 110 {
            leaked = true;
        }
        i += 1;
    }
    assert leaked == false;
}

test a_short_body_buffer_is_clipped_but_counted {
    var out : [8]u8 = undefined;
    const n : usize = body_task_create(&out, 8, "m0-1", 4, "specs/mcp/a.t27", 15, true);
    assert n == 58;
    assert out[0] == 123;
}
