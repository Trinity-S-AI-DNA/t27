// SPDX-License-Identifier: Apache-2.0
// specs/mcp/log_contract.t27 -- M1 log contract law for the MCP gateway audit
// log (.trinity/gateway-audit.log). Sealed M0 specs plus M1 gateway policy
// and log contract laws.
// Part of M1 milestone (milestone #5). Refs #13616.
// phi^2 + 1/phi^2 = 3 | TRINITY

module mcp::log_contract;

pub const AUDIT_LOG_PATH : str = ".trinity/gateway-audit.log";

pub struct AuditLogEntry { event_id: str, redacted: bool };

pub fn audit_log_entry_redacted(e: AuditLogEntry) -> bool {
    return e.redacted;
}

pub fn audit_log_path_defined() -> bool {
    return AUDIT_LOG_PATH == ".trinity/gateway-audit.log";
}

test "audit log entry redacted" {
    assert(audit_log_entry_redacted(AuditLogEntry { event_id: "e1", redacted: true }));
    assert(!audit_log_entry_redacted(AuditLogEntry { event_id: "e2", redacted: false }));
}

test "audit log path defined" {
    assert(audit_log_path_defined());
}

invariant audit_log_path_is_defined {
    assert AUDIT_LOG_PATH == ".trinity/gateway-audit.log";
}