// SPDX-License-Identifier: Apache-2.0
; specs/mcp/policy.t27 -- the allowlist law of the M0 MCP connector (#13583).
; Deny by default: every check below answers false when it cannot PROVE the
; input in scope, so an unknown repo, branch, path, command, host or port is a
; refusal, never a pass. The caller feeds the verdict into the gate of
; specs/mcp/t27_dsh_mcp.t27 (the in_scope bit); every invocation is still
; audited by specs/mcp/audit.t27, refusals included. Facts measured on
; 2026-11-10 are in docs/mcp/m0-inventory.md. Only t27 / L3 / L4 apply.
; Byte mechanics follow the gen-c traps (AGENTS.md): explicit lengths
; everywhere, no .len on str, no == on str, no NUL assumptions.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpM0Policy;

pub const POLICY_VERSION : u8 = 1;

; -- path allowlist: prefixes an M0 write may touch. Nothing else exists.
pub const PATH_PREFIX_COUNT : usize = 3;
pub const PATH_PREFIXES : [3]str = ["specs/mcp/", "docs/mcp/", "tests/"];
pub const PATH_PREFIX_LENS : [3]usize = [10, 9, 6];

; -- branch allowlist: agent lane branches only. Master and golden refs are
; never a write target through M0.
pub const BRANCH_PREFIX_COUNT : usize = 2;
pub const BRANCH_PREFIXES : [2]str = ["lane/", "claude/"];
pub const BRANCH_PREFIX_LENS : [2]usize = [5, 7];

; -- command allowlist: the FIRST WORD of a t27.shell.run invocation, then a
; deny-scan over the whole line for privilege and destruction markers.
pub const COMMAND_COUNT : usize = 3;
pub const COMMANDS : [3]str = ["t27c", "tri", "status"];
pub const COMMAND_LENS : [3]usize = [4, 3, 6];

; -- egress allowlist: loopback only. DSH GUI (measured 127.0.0.1:3081) and a
; dedicated CDP profile port; anything off 127.0.0.1 is refused.
pub const HOST_LOCALHOST : str = "127.0.0.1";
pub const HOST_LOCALHOST_LEN : usize = 9;
pub const PORT_DSH : u16 = 3081;
pub const PORT_CDP_MIN : u16 = 9222;
pub const PORT_CDP_MAX : u16 = 9332;

pub fn starts_with(s : str, slen : usize, p : str, plen : usize) -> bool {
    if slen < plen {
        return false;
    }
    var i : usize = 0;
    while i < plen {
        if s[i] != p[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn contains(s : str, slen : usize, p : str, plen : usize) -> bool {
    if slen < plen {
        return false;
    }
    var i : usize = 0;
    while i + plen <= slen {
        var j : usize = 0;
        var hit : bool = true;
        while j < plen {
            if s[i + j] != p[j] {
                hit = false;
            }
            j += 1;
        }
        if hit {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn path_allowed(path : str, plen : usize) -> bool {
    var i : usize = 0;
    while i < PATH_PREFIX_COUNT {
        if starts_with(path, plen, PATH_PREFIXES[i], PATH_PREFIX_LENS[i]) {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn branch_allowed(branch : str, blen : usize) -> bool {
    var i : usize = 0;
    while i < BRANCH_PREFIX_COUNT {
        if starts_with(branch, blen, BRANCH_PREFIXES[i], BRANCH_PREFIX_LENS[i]) {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn command_allowed(cmd : str, clen : usize) -> bool {
    if contains(cmd, clen, "sudo", 4) or contains(cmd, clen, "su ", 3) {
        return false;
    }
    if contains(cmd, clen, "rm -rf", 6) or contains(cmd, clen, ">", 1) {
        return false;
    }
    if contains(cmd, clen, "gho_", 4) or contains(cmd, clen, "ghp_", 4) {
        return false;
    }
    var i : usize = 0;
    while i < COMMAND_COUNT {
        if starts_with(cmd, clen, COMMANDS[i], COMMAND_LENS[i]) {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn egress_allowed(host : str, hlen : usize, port : u16) -> bool {
    if starts_with(host, hlen, HOST_LOCALHOST, HOST_LOCALHOST_LEN) == false {
        return false;
    }
    if port == PORT_DSH {
        return true;
    }
    if port >= PORT_CDP_MIN and port <= PORT_CDP_MAX {
        return true;
    }
    return false;
}

; A secret that reached a tool argument is denied outright: the audit log
; hashes arguments, but an argument that CARRIES a token must never exist.
pub fn args_secret_free(args : str, alen : usize) -> bool {
    if contains(args, alen, "gho_", 4) {
        return false;
    }
    if contains(args, alen, "ghp_", 4) {
        return false;
    }
    if contains(args, alen, "xoxb", 4) {
        return false;
    }
    if contains(args, alen, "BEGIN PRIVATE KEY", 17) {
        return false;
    }
    return true;
}

; -- invariant: the prefix tables stay aligned (row i: name and length).

invariant path_table_aligned {
    var i : usize = 0;
    while (i < PATH_PREFIX_COUNT) {
        const p : str = PATH_PREFIXES[i];
        const l : usize = PATH_PREFIX_LENS[i];
        var j : usize = 0;
        var nz : bool = false;
        while (j < l) {
            if p[j] != 0 {
                nz = true;
            }
            j += 1;
        }
        assert nz;
        i += 1;
    }
}

; -- tests

test in_scope_paths_pass_and_everything_else_denies {
    assert path_allowed("specs/mcp/policy.t27", 20) == true;
    assert path_allowed("docs/mcp/m0-inventory.md", 23) == true;
    assert path_allowed("tests/mcp_contract.t27", 22) == true;
    assert path_allowed("specs/queen/golden_chain.t27", 27) == false;
    assert path_allowed("bootstrap/src/compiler.rs", 24) == false;
    assert path_allowed("../etc/passwd", 13) == false;
    assert path_allowed("", 0) == false;
}

test lane_branches_pass_master_denies {
    assert branch_allowed("lane/mcp-m0", 11) == true;
    assert branch_allowed("claude/evolve-x", 15) == true;
    assert branch_allowed("master", 6) == false;
    assert branch_allowed("refs/golden/head", 16) == false;
    assert branch_allowed("lane", 4) == false;
}

test shell_commands_are_allowlisted_and_danger_scanned {
    assert command_allowed("t27c seal specs/mcp/policy.t27", 29) == true;
    assert command_allowed("tri test", 8) == true;
    assert command_allowed("status", 6) == true;
    assert command_allowed("sudo rm -rf /", 13) == false;
    assert command_allowed("curl evil.example", 17) == false;
    assert command_allowed("rm -rf ~/t27", 12) == false;
    assert command_allowed("git push origin master", 22) == false;
    assert command_allowed("t27c seal --save > log", 22) == false;
}

test egress_is_loopback_with_named_ports_only {
    assert egress_allowed("127.0.0.1", 9, 3081) == true;
    assert egress_allowed("127.0.0.1", 9, 9222) == true;
    assert egress_allowed("127.0.0.1", 9, 9332) == true;
    assert egress_allowed("127.0.0.1", 9, 8080) == false;
    assert egress_allowed("api.github.com", 14, 443) == false;
    assert egress_allowed("0.0.0.0", 7, 3081) == false;
    assert egress_allowed("localhost", 9, 3081) == false;
}

test arguments_carrying_tokens_are_refused {
    assert args_secret_free("seal specs/mcp/a.t27", 20) == true;
    assert args_secret_free("--token gho_ABCDEF", 18) == false;
    assert args_secret_free("ghp_SHORT", 9) == false;
    assert args_secret_free("xoxb-1234", 9) == false;
    assert args_secret_free("key: BEGIN PRIVATE KEY", 22) == false;
}
