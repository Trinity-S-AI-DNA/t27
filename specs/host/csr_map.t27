// SPDX-License-Identifier: Apache-2.0
; specs/host/csr_map.t27 -- the BitNet AXI-Lite CSR address map of the host driver: the byte offset of every
; register, the bit positions and masks of CTRL, STATUS and the IRQ registers, and the table of the twelve
; offsets in slave decode order (Closes #11235, the second golden port of step 4 of #9000).
; --
; This spec replaces the hand-written bootstrap/src/host/csr_map.rs (214 lines, 71 of them #[cfg(test)]).
; The file was converted by `tri t27o` (rules: specs/tools/t27o/rust_convert.t27) after three of its tests were
; rewritten with index loops and a bit test (windows(2) and is_power_of_two are not in the subset), and it was
; read by eye. Its 10 Rust #[test]s are the 10 `test` blocks below that carry their names. `t27c gen-rust`
; lowers this spec to bootstrap/gen/rust/host/csr_map.rs, which bootstrap/src/host/mod.rs mounts by #[path]
; as module `csr_map`; bootstrap/src/host/driver.rs and dma.rs say `use super::csr_map` and are unchanged.
; Never hand-edit the generated copy.
; --
; What the register map mirrors: the register decode of the Wave 36d emitter, bootstrap/src/bitnet_axi.rs.
; All offsets are byte addresses; the underlying slave decodes s_axi_awaddr[5:2] (word-aligned, step 4).
; --
;   0x00  CTRL              RW    [0] = start pulse
;   0x04  STATUS            RO    [0] busy, [1] done, [2] error
;   0x08  IRQ_EN            RW    [0] inference_done, [1] dma_done, [2] error
;   0x0C  IRQ_STAT          RO    sticky latch, READ-TO-CLEAR via the upstream `status_read` pulse (W57);
;                                 the AXI slave has no write case for this offset, so writes are dropped
;   0x10  NUM_LAYERS        RW    layer count
;   0x14  NEURONS           RW    neurons per layer
;   0x18  CHUNKS            RW    chunks per neuron
;   0x1C  THRESHOLD         RW    signed threshold (16-bit, zero-extended)
;   0x20  WEIGHT_ADDR_LO    RW    DDR base address, low 32 bits
;   0x24  WEIGHT_ADDR_HI    RW    DDR base address, high 32 bits
;   0x28  DMA_CTRL          RW    DMA control (Wave 39, the driver's dma.rs)
;   0x2C  DMA_STAT          RW    DMA status
; --
; Unmapped reads return 0xDEADBEEF (per the W36d emitter). All transactions are 32-bit aligned; the slave only
; honours word accesses. The bit positions of STATUS follow the W36d / W36f / W36e wiring, those of the IRQ
; registers the W36f `interrupt_controller`.
; --
; Rules, each pinned by a test below:
; R1 (word aligned). Every offset of CSR_OFFSETS is a multiple of 4, they increase strictly, and each is 4 above
;    the one before; so the table is 0x00, 0x04, .. 0x2C and CSR_COUNT is 12.
; R2 (masks). Every mask is 1 shifted left by its bit position; the three STATUS masks are single bits and
;    IRQ_ALL_MASK is the union of the three IRQ masks, three bits set.
; R3 (the table). CSR_OFFSETS lists the named offsets in slave decode order.
; --
; What the lowering changes, stated here so that nobody reads it as a surprise: the `///` doc comments of the
; hand file stay in this spec and do not reach the generated Rust; 0xDEAD_BEEF is written 0xDEADBEEF (the same
; value); the type [u32; CSR_COUNT] is written [u32; CSR_COUNT as usize] (the same type, [u32; 12]); the ten
; tests are no longer `cargo test` tests of the t27c binary but `test` blocks run by t27b and t27c test-report.
; All 30 `pub const`s keep their names, types and values; a side-by-side run of the old and the new file
; compares every one of them (see the pull request).
; --
; The test named `negative_control_..` plants two faults: a table with a pair of offsets swapped, which the
; ordering test would refuse, and masks that overlap, which the single-bit test would refuse. The `oracle_*`
; tests are the values the hand file held when it was compiled with rustc and printed; they are kept so that
; the value of every register offset, bit position and mask of the deleted file stays on record.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module HostCsrMap;

use tools::t27o::rust_std;

/// Byte offset of the control register.
pub const CTRL : u32 = 0x00;

/// Byte offset of the status register.
pub const STATUS : u32 = 0x04;

/// Byte offset of the IRQ-enable register.
pub const IRQ_EN : u32 = 0x08;

/// Byte offset of the IRQ-status (sticky latch) register.
pub const IRQ_STAT : u32 = 0x0C;

/// Byte offset of the layer-count register.
pub const NUM_LAYERS : u32 = 0x10;

/// Byte offset of the neurons-per-layer register.
pub const NEURONS : u32 = 0x14;

/// Byte offset of the chunks-per-neuron register.
pub const CHUNKS : u32 = 0x18;

/// Byte offset of the signed-threshold register.
pub const THRESHOLD : u32 = 0x1C;

/// Byte offset of the weight-base-address low half.
pub const WEIGHT_ADDR_LO : u32 = 0x20;

/// Byte offset of the weight-base-address high half.
pub const WEIGHT_ADDR_HI : u32 = 0x24;

/// Byte offset of the DMA control register.
pub const DMA_CTRL : u32 = 0x28;

/// Byte offset of the DMA status register.
pub const DMA_STAT : u32 = 0x2C;

/// Sentinel value returned by the W36d slave on unmapped reads.
pub const UNMAPPED_READ_VALUE : u32 = 0xDEADBEEF;

/// CTRL bit position for the engine-start pulse.
pub const CTRL_START_BIT : u32 = 0;

/// CTRL mask for the engine-start pulse.
pub const CTRL_START_MASK : u32 = 1 << CTRL_START_BIT;

/// STATUS bit position for `busy`.
pub const STATUS_BUSY_BIT : u32 = 0;

/// STATUS bit position for `done`.
pub const STATUS_DONE_BIT : u32 = 1;

/// STATUS bit position for `error`.
pub const STATUS_ERROR_BIT : u32 = 2;

/// STATUS mask for `busy`.
pub const STATUS_BUSY_MASK : u32 = 1 << STATUS_BUSY_BIT;

/// STATUS mask for `done`.
pub const STATUS_DONE_MASK : u32 = 1 << STATUS_DONE_BIT;

/// STATUS mask for `error`.
pub const STATUS_ERROR_MASK : u32 = 1 << STATUS_ERROR_BIT;

/// IRQ bit position for `inference_done`.
pub const IRQ_INFERENCE_DONE_BIT : u32 = 0;

/// IRQ bit position for `dma_done`.
pub const IRQ_DMA_DONE_BIT : u32 = 1;

/// IRQ bit position for `error`.
pub const IRQ_ERROR_BIT : u32 = 2;

/// IRQ mask for `inference_done`.
pub const IRQ_INFERENCE_DONE_MASK : u32 = 1 << IRQ_INFERENCE_DONE_BIT;

/// IRQ mask for `dma_done`.
pub const IRQ_DMA_DONE_MASK : u32 = 1 << IRQ_DMA_DONE_BIT;

/// IRQ mask for `error`.
pub const IRQ_ERROR_MASK : u32 = 1 << IRQ_ERROR_BIT;

/// Mask covering all three IRQ sources (`inference_done`, `dma_done`, `error`).
pub const IRQ_ALL_MASK : u32 = IRQ_INFERENCE_DONE_MASK | IRQ_DMA_DONE_MASK | IRQ_ERROR_MASK;

/// Total number of mapped CSR registers (12).
pub const CSR_COUNT : usize = 12;

/// Canonical CSR offsets, in slave decode order.
pub const CSR_OFFSETS : [CSR_COUNT]u32 = [CTRL, STATUS, IRQ_EN, IRQ_STAT, NUM_LAYERS, NEURONS, CHUNKS, THRESHOLD, WEIGHT_ADDR_LO, WEIGHT_ADDR_HI, DMA_CTRL, DMA_STAT];

test csr_offsets_are_word_aligned {
    for off in CSR_OFFSETS {
        assert(off % 4 == 0);
    }
}

test csr_offsets_strictly_increasing {
    var i = 1;
    while (i < CSR_COUNT) {
        assert(CSR_OFFSETS[i - 1] < CSR_OFFSETS[i]);
        i += 1;
    }
}

test csr_offsets_step_is_four {
    var i = 1;
    while (i < CSR_COUNT) {
        assert(CSR_OFFSETS[i] - CSR_OFFSETS[i - 1] == 4);
        i += 1;
    }
}

test csr_count_matches_emitter {
    assert(CSR_COUNT == 12);
    assert(CSR_OFFSETS.len == CSR_COUNT);
}

test unmapped_read_value_matches_emitter {
    assert(UNMAPPED_READ_VALUE == 0xDEADBEEF);
}

test ctrl_start_bit_is_zero {
    assert(CTRL_START_BIT == 0);
    assert(CTRL_START_MASK == 0x1);
}

test status_bits_distinct {
    assert(STATUS_BUSY_BIT != STATUS_DONE_BIT);
    assert(STATUS_DONE_BIT != STATUS_ERROR_BIT);
    assert(STATUS_BUSY_BIT != STATUS_ERROR_BIT);
}

test status_masks_are_powers_of_two {
    assert(STATUS_BUSY_MASK != 0 and (STATUS_BUSY_MASK & (STATUS_BUSY_MASK - 1)) == 0);
    assert(STATUS_DONE_MASK != 0 and (STATUS_DONE_MASK & (STATUS_DONE_MASK - 1)) == 0);
    assert(STATUS_ERROR_MASK != 0 and (STATUS_ERROR_MASK & (STATUS_ERROR_MASK - 1)) == 0);
}

test irq_all_mask_covers_three_sources {
    assert(rust_std::count_ones_u32(IRQ_ALL_MASK) == 3);
    assert(IRQ_ALL_MASK == (IRQ_INFERENCE_DONE_MASK | IRQ_DMA_DONE_MASK | IRQ_ERROR_MASK));
}

test csr_offsets_span_zero_to_0x2c {
    assert(CSR_OFFSETS[0] == 0x00);
    assert(CSR_OFFSETS[CSR_COUNT - 1] == 0x2C);
}

; --- Two faults planted: a swapped pair of offsets, and masks that overlap. -----------------------------

test negative_control_a_swapped_table_and_overlapping_masks_are_refused {
    // a table with its second and third offsets swapped fails both the ordering and the step rule
    const bad : [3]u32 = [0x00, 0x08, 0x04];
    assert(!(bad[0] < bad[1] and bad[1] < bad[2]));
    assert(bad[1] - bad[0] != 4);
    // the real masks do not overlap, and IRQ_ALL_MASK stops at bit 2
    assert((STATUS_BUSY_MASK & STATUS_DONE_MASK) == 0);
    assert((STATUS_DONE_MASK & STATUS_ERROR_MASK) == 0);
    assert((STATUS_BUSY_MASK & STATUS_ERROR_MASK) == 0);
    assert((IRQ_ALL_MASK & 0x8) == 0);
    assert(IRQ_ALL_MASK + 1 == 8);
}

; --- The values the hand file held when it was compiled with rustc and printed. -------------------------

test oracle_register_offsets {
    assert(CTRL == 0x00);
    assert(STATUS == 0x04);
    assert(IRQ_EN == 0x08);
    assert(IRQ_STAT == 0x0C);
    assert(NUM_LAYERS == 0x10);
    assert(NEURONS == 0x14);
    assert(CHUNKS == 0x18);
    assert(THRESHOLD == 0x1C);
    assert(WEIGHT_ADDR_LO == 0x20);
    assert(WEIGHT_ADDR_HI == 0x24);
    assert(DMA_CTRL == 0x28);
    assert(DMA_STAT == 0x2C);
}

test oracle_table_is_the_named_offsets_in_order {
    assert(CSR_OFFSETS[0] == CTRL);
    assert(CSR_OFFSETS[1] == STATUS);
    assert(CSR_OFFSETS[2] == IRQ_EN);
    assert(CSR_OFFSETS[3] == IRQ_STAT);
    assert(CSR_OFFSETS[4] == NUM_LAYERS);
    assert(CSR_OFFSETS[5] == NEURONS);
    assert(CSR_OFFSETS[6] == CHUNKS);
    assert(CSR_OFFSETS[7] == THRESHOLD);
    assert(CSR_OFFSETS[8] == WEIGHT_ADDR_LO);
    assert(CSR_OFFSETS[9] == WEIGHT_ADDR_HI);
    assert(CSR_OFFSETS[10] == DMA_CTRL);
    assert(CSR_OFFSETS[11] == DMA_STAT);
}

test oracle_bit_positions_and_masks {
    assert(CTRL_START_BIT == 0);
    assert(CTRL_START_MASK == 1);
    assert(STATUS_BUSY_BIT == 0);
    assert(STATUS_DONE_BIT == 1);
    assert(STATUS_ERROR_BIT == 2);
    assert(STATUS_BUSY_MASK == 1);
    assert(STATUS_DONE_MASK == 2);
    assert(STATUS_ERROR_MASK == 4);
    assert(IRQ_INFERENCE_DONE_BIT == 0);
    assert(IRQ_DMA_DONE_BIT == 1);
    assert(IRQ_ERROR_BIT == 2);
    assert(IRQ_INFERENCE_DONE_MASK == 1);
    assert(IRQ_DMA_DONE_MASK == 2);
    assert(IRQ_ERROR_MASK == 4);
    assert(IRQ_ALL_MASK == 7);
}
