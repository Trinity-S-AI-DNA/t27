// SPDX-License-Identifier: Apache-2.0
; specs/host/bitmask.t27 -- bit-field arithmetic of the host driver for the BitNet AXI-Lite CSR aperture:
; the mask of a field, reading and writing a field of a 32-bit register word, single-bit tests and edits,
; and the width and mask of a named field (Closes #11156, the first golden port of step 4 of #9000).
; --
; This spec replaces the hand-written bootstrap/src/host/bitmask.rs (170 lines, 96 of them #[cfg(test)]).
; The file was converted by `tri t27o` (rules: specs/tools/t27o/rust_convert.t27), read by eye, and its 14
; Rust #[test]s are the 14 `test` blocks below that carry their names. `t27c gen-rust` lowers this spec to
; bootstrap/gen/rust/host/bitmask.rs, which bootstrap/src/host/mod.rs mounts by #[path] as module `bitmask`;
; the `pub use bitmask::{..}` line of mod.rs is unchanged, so no caller changes. Never hand-edit the
; generated copy.
; --
; Rules, each pinned by a test below:
; R1 (masks). mask(w) is the low w bits set, and all 32 for w >= 32; field_mask(high, low) is the bits low
;    to high inclusive, so the width of a field is high - low + 1.
; R2 (a field of a word). extract(v, high, low) is that field moved to bit 0; insert(v, high, low, f) is v
;    with that field replaced by f, where the bits of f above the field are dropped and every bit outside
;    the field keeps its value.
; R3 (single bits). is_set, set_bit, clear_bit and toggle_bit take a bit number below 32.
; R4 (counts). popcount, trailing_zeros and leading_zeros count over 32 bits, so the last two are 32 for 0.
; R5 (no checks). Like the file it replaces, nothing here refuses an argument: high below low, or a bit
;    number of 32 or more, is an overflow of the Rust the spec lowers to (a panic in a debug build).
; --
; What the lowering changes, stated here so that nobody reads it as a surprise: gen-rust writes `pub fn`
; where the hand file wrote `pub const fn`, and a method of FieldDesc becomes a free fn named
; FieldDesc_<method> whose first parameter is `self_`; the struct derives Debug, Clone and Copy and no
; longer PartialEq and Eq. No file of the repository uses a const context, a method or an equality of
; these items; mod.rs re-exports ten names (nine fns and FieldDesc), all of which keep their names and
; types.
; --
; The test named `negative_control_..` plants the fault of an insert that does not cut its field. The
; `oracle_*` tests at the end are the values the hand file returned when `tri t27o --check` compiled it
; with rustc and ran it; they are kept so that the behaviour of the deleted file stays on record.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module HostBitmask;

use tools::t27o::rust_std;
use tri::t27b::type_text;

/// The low `width` bits set; all 32 bits when `width` is 32 or more.
pub fn mask(width: u8) -> u32 {
    if (width >= 32) {
        return 0xFFFFFFFF;
    } else {
        return (@as(u32, 1) << width) - 1;
    }
}

/// The bits `low` to `high` inclusive, in place. `high` is not below `low`.
pub fn field_mask(high: u8, low: u8) -> u32 {
    return mask(high - low + 1) << low;
}

/// The field `high` to `low` of `value`, moved to bit 0.
pub fn extract(value: u32, high: u8, low: u8) -> u32 {
    return (value >> low) & mask(high - low + 1);
}

/// `value` with its field `high` to `low` replaced by `field`; the bits of `field` above the field are
/// dropped and the bits of `value` outside the field are kept.
pub fn insert(value: u32, high: u8, low: u8, field: u32) -> u32 {
    const m = field_mask(high, low);
    return (value & ~m) | ((field << low) & m);
}

/// Whether bit number `bit` (below 32) of `value` is 1.
pub fn is_set(value: u32, bit: u8) -> bool {
    return (value & (@as(u32, 1) << bit)) != 0;
}

pub fn set_bit(value: u32, bit: u8) -> u32 {
    return value | (@as(u32, 1) << bit);
}

pub fn clear_bit(value: u32, bit: u8) -> u32 {
    return value & ~(@as(u32, 1) << bit);
}

pub fn toggle_bit(value: u32, bit: u8) -> u32 {
    return value ^ (@as(u32, 1) << bit);
}

/// The number of 1 bits of `value`, 0 to 32.
pub fn popcount(value: u32) -> u8 {
    return rust_std::count_ones_u32(value) as u8;
}

/// The number of 0 bits below the lowest 1 bit of `value`; 32 for 0.
pub fn trailing_zeros(value: u32) -> u8 {
    return rust_std::trailing_zeros_u32(value) as u8;
}

/// The number of 0 bits above the highest 1 bit of `value`; 32 for 0.
pub fn leading_zeros(value: u32) -> u8 {
    return rust_std::leading_zeros_u32(value) as u8;
}

/// A named field of a register word: bits `low` to `high` inclusive.
pub const FieldDesc = struct {
    name : []const u8,
    high : u8,
    low : u8,
};

pub fn FieldDesc_new(name: []const u8, high: u8, low: u8) -> FieldDesc {
    return FieldDesc{ .name = name, .high = high, .low = low };
}

/// The number of bits of the field.
pub fn FieldDesc_width(self: FieldDesc) -> u8 {
    return self.high - self.low + 1;
}

pub fn FieldDesc_mask(self: FieldDesc) -> u32 {
    return field_mask(self.high, self.low);
}

pub fn FieldDesc_extract(self: FieldDesc, value: u32) -> u32 {
    return extract(value, self.high, self.low);
}

pub fn FieldDesc_insert(self: FieldDesc, value: u32, field: u32) -> u32 {
    return insert(value, self.high, self.low, field);
}

; --- The 14 tests of the hand file, as `tri t27o` translated them. ----------------------------------

test mask_1bit {
    assert(mask(1) == 0x1);
}

test mask_8bit {
    assert(mask(8) == 0xFF);
}

test mask_32bit {
    assert(mask(32) == 0xFFFFFFFF);
}

test field_mask_bits_7_4 {
    assert(field_mask(7, 4) == 0xF0);
}

test extract_field {
    const v = 0xABCD;
    assert(extract(v, 11, 8) == 0xB);
    assert(extract(v, 3, 0) == 0xD);
}

test insert_field {
    const v = 0x0000;
    assert(insert(v, 7, 4, 0xA) == 0x00A0);
}

test insert_preserves_other {
    const v = 0x1234;
    const result = insert(v, 7, 4, 0x0);
    assert(extract(result, 15, 8) == 0x12);
    assert(extract(result, 3, 0) == 0x4);
}

test is_set_clear {
    assert(is_set(0x04, 2));
    assert(!is_set(0x04, 1));
}

test set_clear_toggle {
    assert(set_bit(0, 3) == 0x08);
    assert(clear_bit(0xFF, 0) == 0xFE);
    assert(toggle_bit(0x0F, 3) == 0x07);
    assert(toggle_bit(0x07, 3) == 0x0F);
}

test popcount_test {
    assert(popcount(0xFF) == 8);
    assert(popcount(0) == 0);
    assert(popcount(1) == 1);
}

test trailing_zeros_test {
    assert(trailing_zeros(0x08) == 3);
    assert(trailing_zeros(1) == 0);
}

test field_desc {
    const f = FieldDesc_new("ctrl_start", 0, 0);
    assert(FieldDesc_width(f) == 1);
    assert(FieldDesc_mask(f) == 0x1);
    assert(FieldDesc_extract(f, 0x01) == 1);
    assert(FieldDesc_insert(f, 0, 1) == 1);
}

test field_desc_wide {
    const f = FieldDesc_new("neurons", 15, 0);
    assert(FieldDesc_width(f) == 16);
    assert(FieldDesc_mask(f) == 0xFFFF);
    assert(FieldDesc_extract(f, 0x00FF0000) == 0);
    assert(FieldDesc_extract(f, 0x0000ABCD) == 0xABCD);
}

test insert_overwrite {
    const v = insert(0x00F0, 7, 4, 0x5);
    assert(v == 0x0050);
}

; --- A fault planted: an insert that forgot to cut the field would spill into its neighbour. --------

test negative_control_a_field_wider_than_its_slot_is_cut_and_the_neighbours_are_kept {
    // the values are what the hand file returns (checked by running it)
    assert(insert(0x1200, 7, 4, 0x1FF) == 0x12F0);
    assert(insert(0xFFFFFFFF, 7, 4, 0) == 0xFFFFFF0F);
    assert(extract(0xFFFFFFFF, 7, 4) == 0xF);
    assert(insert(0, 31, 0, 0xFFFFFFFF) == 0xFFFFFFFF);
    assert(field_mask(31, 0) == 0xFFFFFFFF);
    assert(field_mask(31, 31) == 0x80000000);
    assert(extract(0xDEADBEEF, 31, 28) == 0xD);
    assert(insert(0xFFFFFFFF, 31, 28, 0) == 0x0FFFFFFF);
}

; --- The values the hand file returned when it was compiled with rustc and run (`tri t27o --check`). ---
// t27o: 30 fn seen, 30 converted (14 of 14 tests), 0 refused (0 kept as stubs); coverage 100%

test oracle_mask {
    assert(mask(0) == 0);
    assert(mask(1) == 1);
    assert(mask(2) == 3);
    assert(mask(7) == 127);
    assert(mask(10) == 1023);
    assert(mask(100) == 4294967295);
    assert(mask(255) == 4294967295);
    assert(mask(31) == 2147483647);
    assert(mask(32) == 4294967295);
    assert(mask(33) == 4294967295);
    assert(mask(0) == 0);
    assert(mask(1) == 1);
    assert(mask(2) == 3);
    assert(mask(0) == 0);
}

test oracle_field_mask {
    assert(field_mask(2, 0) == 7);
}

test oracle_extract {
    assert(extract(1, 2, 0) == 1);
}

test oracle_is_set {
    assert(is_set(0, 1) == false);
    assert(is_set(1, 2) == false);
    assert(is_set(2, 7) == false);
    assert(is_set(7, 10) == false);
    assert(is_set(4294967295, 0) == true);
    assert(is_set(0, 1) == false);
    assert(is_set(1, 2) == false);
    assert(is_set(2, 0) == false);
    assert(is_set(0, 1) == false);
    assert(is_set(1, 0) == true);
}

test oracle_set_bit {
    assert(set_bit(0, 1) == 2);
    assert(set_bit(1, 2) == 5);
    assert(set_bit(2, 7) == 130);
    assert(set_bit(7, 10) == 1031);
    assert(set_bit(4294967295, 0) == 4294967295);
    assert(set_bit(0, 1) == 2);
    assert(set_bit(1, 2) == 5);
    assert(set_bit(2, 0) == 3);
}

test oracle_clear_bit {
    assert(clear_bit(0, 1) == 0);
    assert(clear_bit(1, 2) == 1);
    assert(clear_bit(2, 7) == 2);
    assert(clear_bit(7, 10) == 7);
    assert(clear_bit(4294967295, 0) == 4294967294);
    assert(clear_bit(0, 1) == 0);
    assert(clear_bit(1, 2) == 1);
    assert(clear_bit(2, 0) == 2);
}

test oracle_toggle_bit {
    assert(toggle_bit(0, 1) == 2);
    assert(toggle_bit(1, 2) == 5);
    assert(toggle_bit(2, 7) == 130);
    assert(toggle_bit(7, 10) == 1031);
    assert(toggle_bit(4294967295, 0) == 4294967294);
    assert(toggle_bit(0, 1) == 2);
    assert(toggle_bit(1, 2) == 5);
    assert(toggle_bit(2, 0) == 3);
}

test oracle_popcount {
    assert(popcount(0) == 0);
    assert(popcount(1) == 1);
    assert(popcount(2) == 1);
    assert(popcount(7) == 3);
    assert(popcount(10) == 2);
    assert(popcount(100) == 3);
    assert(popcount(4294967295) == 32);
}

test oracle_trailing_zeros {
    assert(trailing_zeros(0) == 32);
    assert(trailing_zeros(1) == 0);
    assert(trailing_zeros(2) == 1);
    assert(trailing_zeros(7) == 0);
    assert(trailing_zeros(10) == 1);
    assert(trailing_zeros(100) == 2);
    assert(trailing_zeros(4294967295) == 0);
}

test oracle_leading_zeros {
    assert(leading_zeros(0) == 32);
    assert(leading_zeros(1) == 31);
    assert(leading_zeros(2) == 30);
    assert(leading_zeros(7) == 29);
    assert(leading_zeros(10) == 28);
    assert(leading_zeros(100) == 25);
    assert(leading_zeros(4294967295) == 0);
}

test oracle_FieldDesc_new {
    assert(type_text::same(FieldDesc_new("", 1, 2).name, ""));
    assert(FieldDesc_new("", 1, 2).high == 1);
    assert(FieldDesc_new("", 1, 2).low == 2);
    assert(type_text::same(FieldDesc_new("a", 2, 7).name, "a"));
    assert(FieldDesc_new("a", 2, 7).high == 2);
    assert(FieldDesc_new("a", 2, 7).low == 7);
    assert(type_text::same(FieldDesc_new("abc", 7, 10).name, "abc"));
    assert(FieldDesc_new("abc", 7, 10).high == 7);
    assert(FieldDesc_new("abc", 7, 10).low == 10);
    assert(type_text::same(FieldDesc_new("0", 10, 100).name, "0"));
    assert(FieldDesc_new("0", 10, 100).high == 10);
    assert(FieldDesc_new("0", 10, 100).low == 100);
    assert(type_text::same(FieldDesc_new("42", 100, 255).name, "42"));
    assert(FieldDesc_new("42", 100, 255).high == 100);
    assert(FieldDesc_new("42", 100, 255).low == 255);
    assert(type_text::same(FieldDesc_new("0x1f", 255, 0).name, "0x1f"));
    assert(FieldDesc_new("0x1f", 255, 0).high == 255);
    assert(FieldDesc_new("0x1f", 255, 0).low == 0);
    assert(type_text::same(FieldDesc_new("a b", 0, 1).name, "a b"));
    assert(FieldDesc_new("a b", 0, 1).high == 0);
    assert(FieldDesc_new("a b", 0, 1).low == 1);
    assert(type_text::same(FieldDesc_new("-7", 1, 2).name, "-7"));
    assert(FieldDesc_new("-7", 1, 2).high == 1);
    assert(FieldDesc_new("-7", 1, 2).low == 2);
}
