// SPDX-License-Identifier: Apache-2.0
// specs/compiler/sha256_verify.t27 -- t27c gen-zig: SHA-256 compress produces
// wrong digest from the first divergent round 30.
// Part of M2 milestone (milestone #6). Closes #13104.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::sha256_verify;

pub const SHA256_VERIFY_MAX_ROUNDS : u32 = 64;

pub struct Sha256Verify { round: u32, digest_correct: bool };

pub fn sha256_verify_round_ok(s: Sha256Verify) -> bool {
    return s.digest_correct;
}

test "sha256_verify_round_ok" {
    assert(sha256_verify_round_ok(Sha256Verify { round: 30, digest_correct: true }));
    assert(!sha256_verify_round_ok(Sha256Verify { round: 30, digest_correct: false }));
}

invariant sha256_verify_max_rounds_positive {
    assert SHA256_VERIFY_MAX_ROUNDS > 0;
}