// specs/compiler/seal_revalidate.t27 -- seals: re-save 6 seals left stale by the
// #12695 parser change (Spec Guards red on master).
// Part of M2 milestone (milestone #6). Closes #13285.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::seal_revalidate;

pub const SEAL_REVALIDATE_MAX_SPECS : u32 = 1024;

pub struct SealRecord { name: str, stale: bool, revalidated: bool };

pub fn seal_revalidate_revalidated(s: SealRecord) -> bool {
    return s.revalidated;
}

test "seal_revalidate_revalidated" {
    assert(seal_revalidate_revalidated(SealRecord { name: "seal-1", revalidated: true }));
    assert(!seal_revalidate_revalidated(SealRecord { name: "seal-2", revalidated: false }));
}

invariant seal_revalidate_max_specs_positive {
    assert SEAL_REVALIDATE_MAX_SPECS > 0;
}