// SPDX-License-Identifier: Apache-2.0
; specs/compiler/hir_cost_models.t27 -- the cost models the bootstrap compiler prices designs by:
; timing ( combinational and register-to-register delay, slack, fmax ), power ( dynamic per resource
; kind and static draw ), routing ( wire length by fanout band, congestion ) and clock tree ( buffer
; count, level count ). Each is a few integer formulas over u32, except slack, which is i64.
; --
; The rules live here. `t27c gen-rust` lowers this spec to bootstrap/gen/rust/compiler/hir_cost_models.rs,
; which bootstrap/src/compiler.rs mounts by #[path] and calls, as it does verilog_names (#9115),
; cse_hoist (#8991) and int_type_names (#9093). Never hand-edit the generated copy.
; --
; Provenance: the thirteen bodies are t27o's conversion of the hand Rust they replace, the associated
; functions of TimingModel, PowerModel, RouteModel and CtsModel in bootstrap/src/compiler.rs, with no
; semantic change: same constants, same integer arithmetic, same range bands (match arms become
; ordered if chains over the same bands). The hand constants stay in bootstrap/src/compiler.rs
; (analyze_module and estimate_module still read them); the copies here exist so the bodies never
; hold a magic number, and cover every constant the thirteen bodies read.
; Nothing here is written twice.
; --
; The tests call each function by name. Their expected values are what the hand Rust returned on the
; lab (rustc release, the fn text copied verbatim): every branch arm, every band edge, the zero and
; near-max domains. Vectors stay inside the u32 domain the hand arithmetic never leaves: a vector
; large enough to wrap would test release-mode wraparound, not the model, and the models are only
; ever called with real design counts.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module HirCostModels;

; -- TimingModel --
pub const LUT_DELAY_PS : u32 = 100;
pub const ROUTING_DELAY_PS : u32 = 300;
pub const SETUP_TIME_PS : u32 = 200;

; -- PowerModel --
pub const LUT_POWER_UW_PER_MHZ : u32 = 10;
pub const FF_POWER_UW_PER_MHZ : u32 = 5;
pub const BRAM_POWER_UW_PER_MHZ : u32 = 50;
pub const DSP_POWER_UW_PER_MHZ : u32 = 100;
pub const STATIC_BASE_MW : u32 = 50;
pub const STATIC_PER_RESOURCE_UW : u32 = 100;

; -- RouteModel --
pub const LOCAL_WIRE_UM : u32 = 500;
pub const MEDIUM_WIRE_UM : u32 = 2000;
pub const LONG_WIRE_UM : u32 = 5000;

/// Per-resource timing: LUT stages carry the routing between them.
pub fn est_comb_delay(num_luts: u32) -> u32 {
    return num_luts * LUT_DELAY_PS + ROUTING_DELAY_PS;
}

/// Register-to-register timing: adds the setup window once per crossing.
pub fn est_reg_to_reg_delay(num_luts: u32) -> u32 {
    return num_luts * LUT_DELAY_PS + ROUTING_DELAY_PS + SETUP_TIME_PS;
}

/// Signed slack so late paths go negative instead of wrapping.
pub fn slack(delay_ps: u32, constraint_ps: u32) -> i64 {
    return constraint_ps as i64 - delay_ps as i64;
}

/// fmax in Hz from a delay in ps; a zero delay (no path) reports zero.
pub fn fmax_from_delay(delay_ps: u32) -> u32 {
    if (delay_ps == 0) {
        return 0;
    }
    return 1000000000 / delay_ps;
}

/// Dynamic LUT power in microwatts: uW/MHz * MHz * toggle / 1000 (uW->mW) / 100 (toggle percent).
pub fn est_lut_dynamic(num_luts: u32, clock_mhz: u32, toggle_rate: u32) -> u32 {
    return num_luts * LUT_POWER_UW_PER_MHZ * clock_mhz * toggle_rate / 1000 / 100;
}

/// Dynamic flip-flop power in microwatts, same shape as the LUT draw.
pub fn est_ff_dynamic(num_ffs: u32, clock_mhz: u32, toggle_rate: u32) -> u32 {
    return num_ffs * FF_POWER_UW_PER_MHZ * clock_mhz * toggle_rate / 1000 / 100;
}

/// Dynamic block-RAM power in microwatts, no toggle factor.
pub fn est_bram_dynamic(num_brams: u32, clock_mhz: u32) -> u32 {
    return num_brams * BRAM_POWER_UW_PER_MHZ * clock_mhz / 1000;
}

/// Dynamic DSP power in microwatts, no toggle factor.
pub fn est_dsp_dynamic(num_dsps: u32, clock_mhz: u32) -> u32 {
    return num_dsps * DSP_POWER_UW_PER_MHZ * clock_mhz / 1000;
}

/// Static draw in milliwatts: base plus per-resource microwatts folded into milliwatts.
pub fn est_static(total_resources: u32) -> u32 {
    return STATIC_BASE_MW + total_resources * STATIC_PER_RESOURCE_UW / 1000;
}

/// Wire length by fanout band: none, local, medium, long.
pub fn est_wire_length(fanout: u32) -> u32 {
    if (fanout == 0) {
        return 0;
    }
    if (fanout <= 4) {
        return LOCAL_WIRE_UM;
    }
    if (fanout <= 16) {
        return MEDIUM_WIRE_UM;
    }
    return LONG_WIRE_UM;
}

/// Congestion as nets per square millimetre; an empty die reports zero.
pub fn est_congestion(num_nets: u32, die_area_mm2: u32) -> u32 {
    if (die_area_mm2 == 0) {
        return 0;
    }
    return num_nets / die_area_mm2;
}

/// One buffer drives up to sixteen sinks; anything larger needs a first stage plus the remainder.
pub fn est_buffers_needed(num_sinks: u32) -> u32 {
    if (num_sinks <= 16) {
        return 1;
    }
    return num_sinks / 16 + 1;
}

/// Clock tree levels: one stage up to sixteen sinks, two up to 256, three above.
pub fn est_tree_levels(num_sinks: u32) -> u32 {
    if (num_sinks <= 16) {
        return 1;
    }
    if (num_sinks <= 256) {
        return 2;
    }
    return 3;
}

test est_comb_delay_counts_routing_once {
    assert est_comb_delay(0) == 300;
    assert est_comb_delay(1) == 400;
    assert est_comb_delay(16) == 1900;
    assert est_comb_delay(999) == 100200;
    assert est_comb_delay(42949669) == 4294967200;
}

test est_reg_to_reg_delay_adds_setup_window {
    assert est_reg_to_reg_delay(0) == 500;
    assert est_reg_to_reg_delay(1) == 600;
    assert est_reg_to_reg_delay(16) == 2100;
    assert est_reg_to_reg_delay(999) == 100400;
    assert est_reg_to_reg_delay(42949667) == 4294967200;
}

test slack_crosses_zero_in_signed_domain {
    assert slack(0, 0) == 0;
    assert slack(5000, 10000) == 5000;
    assert slack(15000, 10000) == -5000;
    assert slack(0, 4294967295) == 4294967295;
    assert slack(4294967295, 0) == -4294967295;
    assert slack(4294967295, 4294967295) == 0;
}

test fmax_from_delay_scales_inverse {
    assert fmax_from_delay(0) == 0;
    assert fmax_from_delay(1) == 1000000000;
    assert fmax_from_delay(2) == 500000000;
    assert fmax_from_delay(3) == 333333333;
    assert fmax_from_delay(500000000) == 2;
    assert fmax_from_delay(1000000000) == 1;
    assert fmax_from_delay(4294967295) == 0;
}

test est_lut_dynamic_folds_toggle_percent {
    assert est_lut_dynamic(0, 0, 0) == 0;
    assert est_lut_dynamic(1, 100, 100) == 1;
    assert est_lut_dynamic(10, 1, 1) == 0;
    assert est_lut_dynamic(1000, 100, 50) == 500;
    assert est_lut_dynamic(5000, 1000, 10) == 5000;
}

test est_ff_dynamic_folds_toggle_percent {
    assert est_ff_dynamic(0, 0, 0) == 0;
    assert est_ff_dynamic(1, 100, 100) == 0;
    assert est_ff_dynamic(1000, 100, 50) == 250;
    assert est_ff_dynamic(5000, 1000, 10) == 2500;
}

test est_bram_dynamic_divides_to_milliwatt_scale {
    assert est_bram_dynamic(0, 0) == 0;
    assert est_bram_dynamic(1, 100) == 5;
    assert est_bram_dynamic(1000, 1000) == 50000;
    assert est_bram_dynamic(85899, 1000) == 4294950;
}

test est_dsp_dynamic_divides_to_milliwatt_scale {
    assert est_dsp_dynamic(0, 0) == 0;
    assert est_dsp_dynamic(1, 100) == 10;
    assert est_dsp_dynamic(1000, 1000) == 100000;
    assert est_dsp_dynamic(42949, 1000) == 4294900;
}

test est_static_starts_at_base_and_folds_per_resource {
    assert est_static(0) == 50;
    assert est_static(1) == 50;
    assert est_static(10) == 51;
    assert est_static(1000) == 150;
    assert est_static(42949672) == 4295017;
}

test est_wire_length_bands_by_fanout {
    assert est_wire_length(0) == 0;
    assert est_wire_length(1) == 500;
    assert est_wire_length(4) == 500;
    assert est_wire_length(5) == 2000;
    assert est_wire_length(16) == 2000;
    assert est_wire_length(17) == 5000;
    assert est_wire_length(4294967295) == 5000;
}

test est_congestion_divides_nets_by_area {
    assert est_congestion(0, 0) == 0;
    assert est_congestion(100, 0) == 0;
    assert est_congestion(0, 10) == 0;
    assert est_congestion(9, 10) == 0;
    assert est_congestion(100, 10) == 10;
    assert est_congestion(4294967295, 1) == 4294967295;
}

test est_buffers_needed_packs_sixteen_per_stage {
    assert est_buffers_needed(0) == 1;
    assert est_buffers_needed(1) == 1;
    assert est_buffers_needed(15) == 1;
    assert est_buffers_needed(16) == 1;
    assert est_buffers_needed(17) == 2;
    assert est_buffers_needed(32) == 3;
    assert est_buffers_needed(4294967295) == 268435456;
}

test est_tree_levels_tops_out_at_three {
    assert est_tree_levels(0) == 1;
    assert est_tree_levels(1) == 1;
    assert est_tree_levels(16) == 1;
    assert est_tree_levels(17) == 2;
    assert est_tree_levels(256) == 2;
    assert est_tree_levels(257) == 3;
    assert est_tree_levels(4294967295) == 3;
}
