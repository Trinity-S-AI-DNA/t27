// SPDX-License-Identifier: Apache-2.0
// specs/compiler/slice_equality.t27 -- t27c: a slice-typed struct field makes
// same-named scalar comparisons emit std.mem.eql.
// Part of M2 milestone (milestone #6). Closes #12343.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::slice_equality;

pub const SLICE_EQUALITY_MAX_FIELDS : u32 = 1024;

pub struct SliceEqualityField { name: str, types_match: bool };

pub fn slice_equality_field_type_correct(f: SliceEqualityField) -> bool {
    return f.types_match;
}

test "slice_equality_field_type_correct" {
    assert(slice_equality_field_type_correct(SliceEqualityField { name: "field1", types_match: true }));
    assert(!slice_equality_field_type_correct(SliceEqualityField { name: "field2", types_match: false }));
}

invariant slice_equality_max_fields_positive {
    assert SLICE_EQUALITY_MAX_FIELDS > 0;
}