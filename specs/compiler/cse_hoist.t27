// SPDX-License-Identifier: Apache-2.0
; specs/compiler/cse_hoist.t27 -- when the optimizer may replace a repeated expression by a temp
; (common_subexpr_elim; issues #8197, #7703, #2629).
; --
; The rule lives here. `t27c gen-rust` lowers it to bootstrap/gen/rust/compiler/cse_hoist.rs, which
; bootstrap/src/compiler.rs mounts by #[path] and only asks. Never hand-edit the generated copy.
; This is the `no_hoisting_across_mutation` precondition that specs/compiler/optimizer.t27 names, made
; executable.
; --
; The pass reads the top-level statements of one function body, by index. An expression is SEEN at
; statement `seen_at` when it is the whole value of that statement: the initializer of a local, the right
; side of an assignment, a return. A later statement `use_at` that holds the same pure expression (names,
; literals, operators) may get a temp, computed RIGHT BEFORE `use_at` and read in place of the repeat.
; --
; What went wrong before, in gen-zig and gen-verilog:
; - The temp went to the top of the body (gen-zig) or after the leading locals (gen-verilog): above the
;   declaration of a local it reads (#8197, `const _cse1 = count + 1;` above `var count`), or after the
;   statement that reads it (gen-verilog wrote `q = _cse1;` and only then `_cse1 = x * y;`).
; - Nothing asked whether an operand changed between the two occurrences. The temp held the value from
;   before the change (#2629: after `x = 99;`, `q = x + 1` read the old x, and compiled), and a counter
;   bumped twice was bumped once (#8197, #7703).
; - The temp was rebuilt from the table key, and a nested key printed as `s & 65535 + ID:s >> LIT:16`
;   (#7703).
; --
; The rule: the repeat in `use_at` takes a temp only when no operand is TOUCHED in statements
; seen_at..use_at, both included. A statement touches an operand when it assigns to it, takes `&` of it,
; declares or captures its name, or calls anything: the pass cannot see what a call writes.
; Then every operand holds the value it had at `seen_at`, so:
; - the temp computed right before `use_at` has the value the repeat would have had;
; - every operand is declared before the temp, because a declaration inside the range is a touch;
; - the temp cannot trap where the source did not: the same values were computed, unconditionally, at
;   `seen_at`, a top-level statement that every path to `use_at` runs.
; The temp is a copy of the repeat itself, so no key text reaches a backend.
; phi^2 + 1/phi^2 = 3 | TRINITY

module CseHoist;

/// `last_touch` when no statement up to `use_at` touches an operand: all are parameters or constants.
pub const UNTOUCHED : i64 = -1;

/// May the repeat in top-level statement `use_at` be replaced by a temp computed right before it?
/// `seen_at` is the statement whose whole value the expression first was. `last_touch` is the last
/// statement up to and including `use_at` that touches one of its operands, or UNTOUCHED.
pub fn repeat_takes_temp(seen_at: i64, use_at: i64, last_touch: i64) -> bool {
    if (seen_at >= use_at) {
        return false;
    }
    return last_touch < seen_at;
}

test operands_nothing_touches_share_one_temp {
    // fn f(x: u32, y: u32) { var p = x * y; var q = x * y; }
    assert repeat_takes_temp(0, 1, UNTOUCHED);
    assert repeat_takes_temp(0, 5, UNTOUCHED);
}

test an_operand_declared_before_the_first_occurrence_is_ready {
    // var a = 1; var p = a * 2; var q = a * 2;  -- declaring a, statement 0, is the last touch
    assert repeat_takes_temp(1, 2, 0);
}

test a_reassignment_between_the_occurrences_refuses_the_temp {
    // #2629: var x = a; var p = x + 1; x = 99; var q = x + 1;
    assert !repeat_takes_temp(1, 3, 2);
}

test a_repeat_that_writes_its_own_operand_refuses_the_temp {
    // #8197: var count = 0; count = count + 1; count = count + 1;
    // #7703: var s = x; s = (s & 65535) + (s >> 16); s = (s & 65535) + (s >> 16);
    assert !repeat_takes_temp(1, 2, 2);
}

test a_declaration_between_the_occurrences_refuses_the_temp {
    // var p = x + 1; while (c) { var x = 5; q = x + 1; }  -- the inner declaration, statement 1, is a touch
    assert !repeat_takes_temp(0, 1, 1);
}

test a_statement_never_repeats_itself {
    assert !repeat_takes_temp(2, 2, UNTOUCHED);
    assert !repeat_takes_temp(3, 2, UNTOUCHED);
}
