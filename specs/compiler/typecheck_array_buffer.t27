// SPDX-License-Identifier: Apache-2.0
// specs/compiler/typecheck_array_buffer.t27 -- t27c: test-report fails on
// module-level array buffer ([0] ** N) while gen succeeds.
// Part of M2 milestone (milestone #6). Closes #13683.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::typecheck_array_buffer;

pub const TYPECHECK_ARRAY_BUFFER_MAX_SIZE : u32 = 65536;

pub struct TypecheckArrayBuffer { size: u32, typechecks_ok: bool };

pub fn typecheck_array_buffer_ok(t: TypecheckArrayBuffer) -> bool {
    return t.typechecks_ok;
}

test "typecheck_array_buffer_ok" {
    assert(typecheck_array_buffer_ok(TypecheckArrayBuffer { size: 1024, typechecks_ok: true }));
    assert(!typecheck_array_buffer_ok(TypecheckArrayBuffer { size: 1024, typechecks_ok: false }));
}

invariant typecheck_array_buffer_max_size_positive {
    assert TYPECHECK_ARRAY_BUFFER_MAX_SIZE > 0;
}