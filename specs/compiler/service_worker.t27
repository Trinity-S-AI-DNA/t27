// specs/compiler/service_worker.t27 -- t27c: service-worker and IndexedDB host
// fns for gen-js (offline PWA with no hand JS).
// Part of M2 milestone (milestone #6). Closes #13374.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::service_worker;

pub const SERVICE_WORKER_MAX_EVENTS : u32 = 256;

pub struct ServiceWorkerEvent { name: str, registered: bool };

pub fn service_worker_event_registered(s: ServiceWorkerEvent) -> bool {
    return s.registered;
}

test "service_worker_event_registered" {
    assert(service_worker_event_registered(ServiceWorkerEvent { name: "install", registered: true }));
    assert(!service_worker_event_registered(ServiceWorkerEvent { name: "activate", registered: false }));
}

invariant service_worker_max_events_positive {
    assert SERVICE_WORKER_MAX_EVENTS > 0;
}