// SPDX-License-Identifier: Apache-2.0
// specs/compiler/sha256_divergent_round.t27 -- t27c gen-zig: SHA-256 compress
// produces wrong digest from the first divergent round 30.
// Part of M2 milestone (milestone #6). Closes #13104.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::sha256_divergent_round;

pub const SHA256_DIVERGENT_ROUND_MAX : u32 = 64;

pub struct Sha256Round { round: u32, digest_correct: bool };

pub fn sha256_round_digest_correct(r: Sha256Round) -> bool {
    return r.digest_correct;
}

test "sha256_round_digest_correct" {
    assert(sha256_round_digest_correct(Sha256Round { round: 30, digest_correct: true }));
    assert(!sha256_round_digest_correct(Sha256Round { round: 30, digest_correct: false }));
}

invariant sha256_divergent_round_max_positive {
    assert SHA256_DIVERGENT_ROUND_MAX > 0;
}