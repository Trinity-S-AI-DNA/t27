// SPDX-License-Identifier: Apache-2.0
; specs/compiler/use_splice.t27 -- how the `use` splice reads a name that two imported modules declare
; (Closes #10556), and the two agreement rules it already had (`all_agree`, `alias_resolved`).
; --
; The splice (bootstrap/src/use_resolve.rs) pulls into the importer every declaration the importer names,
; then every declaration the pulled text names. It keys the declarations by bare name. When two imported
; modules declare one name differently it refused both, and that is right for a name the IMPORTER wrote:
; the choice is the author's. It is wrong for a name found INSIDE a pulled declaration. `admit` in
; service.t27 calls `name_ok`; the only `name_ok` its author can mean is the one in service.t27, and
; refusing both left the generated file calling a function it never declared (`t27c gen` still exited 0).
; --
; The rules, each pinned by a test below:
; R1 (scope). A name found inside a pulled declaration of module O is read in O's scope: the declaration O
;    makes, else the one declaration its direct imports make. `scope_index` answers; -1 is "no answer".
; R2 (only on ambiguity). The scope is consulted only for a name the whole closure cannot answer (one
;    declaration, declarations that agree, or an alias). A name with one answer anywhere keeps it, so a
;    spec that resolved yesterday generates the same bytes today.
; R3 (flat names). The output is one namespace, so two scoped copies of one name cannot both be called
;    `name_ok`. A scoped copy is named `<module path>__<name>` (`flat_name`) and every use of the name in the
;    texts of the module that means it is rewritten (`rename_ident`). A qualified reference the importer
;    writes (`beta::name_ok`) is read in beta's scope, so it takes the same flat name.
; R4 (the author's choice stays refused). A bare name the importer writes, declared differently by two
;    imported modules, is still UNRESOLVED: no scope applies to it.
; --
; `rename_ident` is a token rewrite, not a parse. It leaves comments, `;` prose lines, string and character
; literals, `.name` and `::name` (a member or a qualified path), `@name`, and a name in a declaration
; position (`name: T`, `name = v` inside a struct or an enum) alone; a declaration head after `const` or
; `type` is renamed. The Zig the specs lower to forbids a local or a parameter that shadows a top-level
; declaration, so inside a module's own texts a bare use of its declared name can only mean the declaration.
; --
; Also here: `same_decl` (the old `all_agree`/`normalised`/`without_comment`) and `alias_class` (the old
; `alias_target`), moved from use_resolve.rs so the hand Rust only shrinks. Their behaviour is the old one,
; line for line.
; `t27c gen-rust` lowers this spec to bootstrap/gen/rust/compiler/use_splice.rs, which use_resolve.rs
; mounts by #[path]. Never hand-edit the generated copy.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module UseSplice;

use tri::t27b::type_text;

pub const B_NL : u8 = 10;
pub const B_DQUOTE : u8 = 34;
pub const B_SQUOTE : u8 = 39;
pub const B_EQ : u8 = 61;
pub const B_AT : u8 = 64;
pub const B_BSLASH : u8 = 92;

/// A declaration longer than this once normalised and joined is no alias: `const X : T = module::X;` is a line.
pub const ALIAS_MAX : usize = 1024;

/// No such text, or no answer.
pub const NO : i32 = -1;

/// Appends one byte; the count goes on past `cap` so the caller learns the size it needs.
fn put(out: []u8, cap: usize, w: usize, b: u8) -> usize {
    if (w < cap) { out[w] = b; }
    return w + 1;
}

/// The end of the line that starts at s: its newline, or t.len.
fn line_end(t: []const u8, s: usize) -> usize {
    var i : usize = s;
    while (i < t.len and t[i] != B_NL) { i += 1; }
    return i;
}

/// Are a[alo .. ahi] and b[blo .. bhi] the same bytes?
pub fn same_span(a: []const u8, alo: usize, ahi: usize, b: []const u8, blo: usize, bhi: usize) -> bool {
    if (ahi - alo != bhi - blo) { return false; }
    var k : usize = 0;
    while (k < ahi - alo) {
        if (a[alo + k] != b[blo + k]) { return false; }
        k += 1;
    }
    return true;
}

/// Where the code of the line t[s .. e] ends: at its first `//` outside a quote, else at e. A quote opens at
/// a double or single quote byte and a backslash inside it skips the next byte.
fn code_end(t: []const u8, s: usize, e: usize) -> usize {
    var q : u8 = 0;
    var i : usize = s;
    while (i < e) {
        const c : u8 = t[i];
        if (q != 0) {
            if (c == B_BSLASH) {
                i += 1;
            } else if (c == q) {
                q = 0;
            }
        } else if (c == B_DQUOTE or c == B_SQUOTE) {
            q = c;
        } else if (c == type_text::B_SLASH and i + 1 < e and t[i + 1] == type_text::B_SLASH) {
            return i;
        }
        i += 1;
    }
    return e;
}

/// The next line of t at or after the line start p that has code left once its comment and its outer
/// whitespace are gone, as its two offsets packed in one i64; -1 when there is none.
fn norm_line(t: []const u8, p: usize) -> i64 {
    var s : usize = p;
    while (s < t.len) {
        const e : usize = line_end(t, s);
        const c : usize = code_end(t, s, e);
        const lo : usize = type_text::trim_lo(t, s, c);
        const hi : usize = type_text::trim_hi(t, lo, c);
        if (lo < hi) { return type_text::pack(lo, hi); }
        s = e + 1;
    }
    return -1;
}

fn lo_of(p: i64) -> usize {
    return @intCast(@divTrunc(p, type_text::HALF));
}

fn hi_of(p: i64) -> usize {
    return @intCast(p - @divTrunc(p, type_text::HALF) * type_text::HALF);
}

/// Do these two declarations say the same thing? Line by line with each line trimmed, comments dropped and
/// blank lines skipped, because the corpus writes two indentation conventions and annotates one copy of a
/// declaration and not the other (`pub const ONE : i8 = 1;      // Trit = +1`). Two declarations that agree
/// offer no choice, so a refusal between them costs the import for nothing.
pub fn same_decl(a: []const u8, b: []const u8) -> bool {
    var pa : usize = 0;
    var pb : usize = 0;
    var more : bool = true;
    while (more) {
        const la : i64 = norm_line(a, pa);
        const lb : i64 = norm_line(b, pb);
        if (la < 0 or lb < 0) { return la < 0 and lb < 0; }
        if (!same_span(a, lo_of(la), hi_of(la), b, lo_of(lb), hi_of(lb))) { return false; }
        pa = line_end(a, lo_of(la)) + 1;
        pb = line_end(b, lo_of(lb)) + 1;
    }
    return true;
}

/// Is this declaration (the text of the declaration called `name`) an alias, `const PHI : f64 = constants::PHI;`?
/// 0 when it is not one, 1 when it points at the module `stem`, 2 when it points at another module. An alias
/// is a pointer to the first definition, not a second opinion about it; its own text (`constants::PHI`) has
/// no meaning in the flat output, so the splice takes the target.
pub fn alias_class(text: []const u8, name: []const u8, stem: []const u8) -> u8 {
    var j : [1024]u8 = [0] ** 1024;
    var n : usize = 0;
    var line : i64 = norm_line(text, 0);
    while (line >= 0) {
        const lo : usize = lo_of(line);
        const hi : usize = hi_of(line);
        if (n + (hi - lo) + 1 > ALIAS_MAX) { return 0; }
        if (n > 0) {
            j[n] = type_text::B_SPACE;
            n += 1;
        }
        var k : usize = lo;
        while (k < hi) {
            j[n] = text[k];
            n += 1;
            k += 1;
        }
        line = norm_line(text, line_end(text, lo) + 1);
    }
    var eq : usize = 0;
    while (eq < n and j[eq] != B_EQ) { eq += 1; }
    if (eq >= n) { return 0; }
    const lo : usize = type_text::trim_lo(j[0 .. n], eq + 1, n);
    var hi : usize = type_text::trim_hi(j[0 .. n], lo, n);
    while (hi > lo and j[hi - 1] == type_text::B_SEMI) { hi -= 1; }
    hi = type_text::trim_hi(j[0 .. n], lo, hi);
    var c : usize = lo;
    while (c + 1 < hi and !(j[c] == type_text::B_COLON and j[c + 1] == type_text::B_COLON)) { c += 1; }
    if (c + 1 >= hi) { return 0; }
    const mh : usize = type_text::trim_hi(j[0 .. n], lo, c);
    const tl : usize = type_text::trim_lo(j[0 .. n], c + 2, hi);
    const th : usize = type_text::trim_hi(j[0 .. n], tl, hi);
    if (!same_span(j[0 .. n], tl, th, name, 0, name.len) or mh <= lo) { return 0; }
    var m : usize = lo;
    while (m < mh) {
        if (!type_text::word(j[m]) and j[m] != type_text::B_MINUS) { return 0; }
        m += 1;
    }
    if (same_span(j[0 .. n], lo, mh, stem, 0, stem.len)) { return 1; }
    return 2;
}

/// Does `list` (names one to a line) hold a line that is t[lo .. hi]?
fn has_line(list: []const u8, t: []const u8, lo: usize, hi: usize) -> bool {
    var s : usize = 0;
    while (s < list.len) {
        const e : usize = line_end(list, s);
        if (same_span(list, s, e, t, lo, hi)) { return true; }
        s = e + 1;
    }
    return false;
}

/// Does the qualified spelling q (`m::name` or `m.name`) name the module at path p[lo .. hi], whose stem is m?
fn names_module(p: []const u8, lo: usize, hi: usize, q: []const u8) -> bool {
    var e : usize = hi;
    if (e - lo >= 4 and type_text::starts(p, e - 4, e, ".t27")) { e -= 4; }
    var s : usize = e;
    while (s > lo and p[s - 1] != type_text::B_SLASH) { s -= 1; }
    const n : usize = e - s;
    if (q.len <= n or !same_span(q, 0, n, p, s, e)) { return false; }
    return q[n] == type_text::B_COLON or q[n] == type_text::B_DOT;
}

/// R1. `cands` lists, one to a line, the modules that declare a name no one answer covers; `ctx` says whose
/// text names it: "" for the importer's own text, `=m::name` for a qualified reference the importer writes
/// (the module m it names), else the path of the module whose pulled declaration names it; `imports` lists
/// the modules a module `ctx` imports. The index of the line of `cands` that the context means: the module
/// itself, else the one line `imports` also holds; -1 for none or for several, which stays UNRESOLVED.
pub fn scope_index(cands: []const u8, ctx: []const u8, imports: []const u8) -> i32 {
    if (ctx.len == 0) { return NO; }
    var k : i32 = 0;
    var hit : i32 = NO;
    var hits : u32 = 0;
    var s : usize = 0;
    while (s < cands.len) {
        const e : usize = line_end(cands, s);
        if (ctx[0] == B_EQ) {
            if (names_module(cands, s, e, ctx[1 .. ctx.len])) { return k; }
        } else {
            if (same_span(cands, s, e, ctx, 0, ctx.len)) { return k; }
            if (has_line(imports, cands, s, e)) {
                hit = k;
                hits += 1;
            }
        }
        k += 1;
        s = e + 1;
    }
    if (hits == 1) { return hit; }
    return NO;
}

/// Appends the flat name of `name` as `origin` declares it (R3): the origin path without `.t27`, every byte
/// that is not a letter, a digit or `_` turned into `_`, then `__` and the name.
fn put_flat(origin: []const u8, name: []const u8, out: []u8, cap: usize, at: usize) -> usize {
    var n : usize = origin.len;
    if (n >= 4 and type_text::starts(origin, n - 4, n, ".t27")) { n -= 4; }
    var w : usize = at;
    var i : usize = 0;
    while (i < n) {
        if (type_text::word(origin[i])) {
            w = put(out, cap, w, origin[i]);
        } else {
            w = put(out, cap, w, type_text::B_UNDERSCORE);
        }
        i += 1;
    }
    w = put(out, cap, w, type_text::B_UNDERSCORE);
    w = put(out, cap, w, type_text::B_UNDERSCORE);
    i = 0;
    while (i < name.len) {
        w = put(out, cap, w, name[i]);
        i += 1;
    }
    return w;
}

/// R3. The flat name of `name` as `origin` declares it, written to out[0 .. cap]; the result is the length it
/// needs.
pub fn flat_name(origin: []const u8, name: []const u8, out: []u8, cap: usize) -> usize {
    return put_flat(origin, name, out, cap, 0);
}

/// The first byte at or after p that is not a space or a tab; t.len when there is none.
fn skip_blank(t: []const u8, p: usize) -> usize {
    var i : usize = p;
    while (i < t.len and (t[i] == type_text::B_SPACE or t[i] == type_text::B_TAB)) { i += 1; }
    return i;
}

/// Is the word that ends just before p (blanks and newlines between) `const` or `type`: the keywords after
/// which a name is a declaration head, whatever follows it?
fn after_decl_keyword(t: []const u8, p: usize) -> bool {
    var e : usize = p;
    while (e > 0 and type_text::ws_before(t, 0, e) > 0) { e -= 1; }
    var s : usize = e;
    while (s > 0 and type_text::word(t[s - 1])) { s -= 1; }
    return type_text::starts(t, s, e, "const") and e - s == 5 or type_text::starts(t, s, e, "type") and e - s == 4;
}

/// Is the word t[i .. j] a use of the name, as opposed to a member (`.name`, `::name`, `@name`) or a name in a
/// declaration position (`name: T`, `name = v` after anything but `const` or `type`)?
fn is_use(t: []const u8, i: usize, j: usize) -> bool {
    if (i > 0 and (t[i - 1] == type_text::B_DOT or t[i - 1] == B_AT)) { return false; }
    if (i > 1 and t[i - 1] == type_text::B_COLON and t[i - 2] == type_text::B_COLON) { return false; }
    const k : usize = skip_blank(t, j);
    if (k >= t.len) { return true; }
    const single_colon : bool = t[k] == type_text::B_COLON and !(k + 1 < t.len and t[k + 1] == type_text::B_COLON);
    const single_eq : bool = t[k] == B_EQ and !(k + 1 < t.len and t[k + 1] == B_EQ);
    if (single_colon or single_eq) { return after_decl_keyword(t, i); }
    return true;
}

/// R3. `text` with every use of `name` renamed to its flat name as `origin` declares it, written to
/// out[0 .. cap]; the result is the length it needs. See the header for what is left alone.
pub fn rename_ident(text: []const u8, name: []const u8, origin: []const u8, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    var i : usize = 0;
    var bol : bool = true;
    while (i < text.len) {
        const c : u8 = text[i];
        if (c == B_NL) {
            w = put(out, cap, w, c);
            bol = true;
            i += 1;
        } else if (bol and (c == type_text::B_SPACE or c == type_text::B_TAB)) {
            w = put(out, cap, w, c);
            i += 1;
        } else if ((bol and c == type_text::B_SEMI) or (c == type_text::B_SLASH and i + 1 < text.len and text[i + 1] == type_text::B_SLASH)) {
            while (i < text.len and text[i] != B_NL) {
                w = put(out, cap, w, text[i]);
                i += 1;
            }
        } else if (c == B_DQUOTE or c == B_SQUOTE) {
            bol = false;
            w = put(out, cap, w, c);
            i += 1;
            while (i < text.len and text[i] != c and text[i] != B_NL) {
                if (text[i] == B_BSLASH and i + 1 < text.len) {
                    w = put(out, cap, w, text[i]);
                    i += 1;
                }
                w = put(out, cap, w, text[i]);
                i += 1;
            }
            if (i < text.len and text[i] == c) {
                w = put(out, cap, w, c);
                i += 1;
            }
        } else if (type_text::word(c)) {
            bol = false;
            var j : usize = i;
            while (j < text.len and type_text::word(text[j])) { j += 1; }
            if (same_span(text, i, j, name, 0, name.len) and is_use(text, i, j)) {
                w = put_flat(origin, name, out, cap, w);
            } else {
                var k : usize = i;
                while (k < j) {
                    w = put(out, cap, w, text[k]);
                    k += 1;
                }
            }
            i = j;
        } else {
            bol = false;
            w = put(out, cap, w, c);
            i += 1;
        }
    }
    return w;
}

test same_decl_ignores_indentation_comments_and_blank_lines {
    assert same_decl("pub const Trit = enum(i8) {\n    neg = -1,\n};", "pub const Trit = enum(i8) {\n    neg = -1,\n};");
    assert same_decl("pub const T = enum(i8) {\n    neg = -1,\n};", "    pub const T = enum(i8) {\n        neg = -1,\n    };");
    assert same_decl("pub const ONE : i8 = 1;", "pub const ONE : i8 = 1;      // Trit = +1");
    assert same_decl("pub const A = 1;", "\npub const A = 1;\n\n");
    assert same_decl("pub const A = 1;", "pub const A = 1;");
    assert same_decl("", "");
}

test same_decl_tells_a_real_difference {
    assert !same_decl("pub const PHI : f64 = 1.618033988749895;", "pub const PHI : f64 = 1.6180339887;");
    assert !same_decl("pub const E = enum(i8) {\n    a = 1,\n    b = 2,\n};", "pub const E = enum(i8) {\n    a = 1,\n};");
    assert !same_decl("pub const A = 1;", "");
    assert !same_decl("pub const A = 1;", "pub const A = 1;\npub const B = 2;");
}

test a_slash_inside_a_string_does_not_start_a_comment {
    assert same_decl("const U = \"http://x\"; // note", "const U = \"http://x\";");
    assert !same_decl("const U = \"http://x\";", "const U = \"http://y\";");
    assert !same_decl("const U = \"a\\\"//b\";", "const U = \"a\\\"//c\";");
}

test an_alias_names_its_target_module {
    assert alias_class("const PHI : f64 = constants::PHI;", "PHI", "constants") == 1;
    assert alias_class("pub const PHI : f64 = constants::PHI;   // re-export", "PHI", "constants") == 1;
    assert alias_class("const PHI : f64 =\n    constants::PHI;", "PHI", "constants") == 1;
    assert alias_class("const PHI : f64 = constants::PHI;", "PHI", "other") == 2;
    assert alias_class("const PHI : f64 = constants::PHI;", "PHI", "") == 2;
}

test a_value_is_not_an_alias {
    assert alias_class("const PHI : f64 = 1.618033988749895;", "PHI", "constants") == 0;
    assert alias_class("pub fn f(a: u8) -> u8 {\n    return a;\n}", "f", "x") == 0;
    assert alias_class("", "PHI", "constants") == 0;
}

test an_alias_to_a_different_name_is_not_an_alias_for_this_one {
    assert alias_class("const PHI : f64 = constants::PHI_INV;", "PHI", "constants") == 0;
    assert alias_class("const PHI : f64 = ::PHI;", "PHI", "constants") == 0;
    assert alias_class("const PHI : f64 = a b::PHI;", "PHI", "constants") == 0;
}

test the_scope_of_a_module_is_itself_then_its_imports {
    assert scope_index("m/a.t27\nm/b.t27", "m/a.t27", "") == 0;
    assert scope_index("m/a.t27\nm/b.t27", "m/b.t27", "") == 1;
    assert scope_index("m/a.t27\nm/b.t27", "m/c.t27", "m/b.t27\nm/x.t27") == 1;
    assert scope_index("m/a.t27\nm/b.t27", "m/c.t27", "m/x.t27\nm/a.t27") == 0;
    assert scope_index("m/a.t27\nm/b.t27", "m/a.t27", "m/b.t27") == 0;
}

test a_qualified_reference_means_the_module_it_names {
    assert scope_index("tri/crypto/sha256.t27\ntri/t27b/txt.t27", "=txt::same", "") == 1;
    assert scope_index("tri/crypto/sha256.t27\ntri/t27b/txt.t27", "=sha256.same", "") == 0;
    assert scope_index("tri/crypto/sha256.t27\ntri/t27b/txt.t27", "=xt::same", "") == -1;
    assert scope_index("tri/crypto/sha256.t27\ntri/t27b/txt.t27", "=txt", "") == -1;
    assert scope_index("tri/crypto/sha256.t27\ntri/t27b/txt.t27", "=hex::same", "tri/crypto/sha256.t27") == -1;
}

test the_importers_own_text_has_no_scope {
    assert scope_index("m/a.t27\nm/b.t27", "", "m/a.t27") == -1;
    assert scope_index("m/a.t27\nm/b.t27", "", "") == -1;
}

test a_module_that_imports_both_or_neither_has_no_answer {
    assert scope_index("m/a.t27\nm/b.t27", "m/c.t27", "m/a.t27\nm/b.t27") == -1;
    assert scope_index("m/a.t27\nm/b.t27", "m/c.t27", "") == -1;
    assert scope_index("m/a.t27\nm/b.t27", "m/c.t27", "m/x.t27") == -1;
    assert scope_index("", "m/c.t27", "m/c.t27") == -1;
}

test a_flat_name_carries_the_module_path {
    var out : [64]u8 = undefined;
    const m : usize = flat_name("t27mcp/service.t27", "name_ok", out[0 .. 64], 64);
    assert same_span(out[0 .. 64], 0, m, "t27mcp_service__name_ok", 0, 23);
    assert m == 23;
    const k : usize = flat_name("port/a-b/x.y.t27", "K", out[0 .. 64], 64);
    assert same_span(out[0 .. 64], 0, k, "port_a_b_x_y__K", 0, 15);
    assert k == 15;
}

test a_flat_name_reports_the_size_it_needs {
    var out : [4]u8 = undefined;
    assert flat_name("m/a.t27", "name_ok", out[0 .. 4], 4) == 12;
}

test rename_replaces_the_head_and_every_call {
    var out : [256]u8 = undefined;
    const src : str = "pub fn name_ok(n: u32) -> bool {\n    return n > 0;\n}\n\npub fn admit(n: u32) -> u32 {\n    if (name_ok(n) == false) { return 3; }\n    return name_ok(n) and 1;\n}\n";
    const want : str = "pub fn m_a__name_ok(n: u32) -> bool {\n    return n > 0;\n}\n\npub fn admit(n: u32) -> u32 {\n    if (m_a__name_ok(n) == false) { return 3; }\n    return m_a__name_ok(n) and 1;\n}\n";
    const m : usize = rename_ident(src, "name_ok", "m/a.t27", out[0 .. 256], 256);
    assert m == want.len;
    assert same_span(out[0 .. 256], 0, m, want, 0, want.len);
}

test rename_leaves_a_longer_word_a_member_a_comment_and_a_string_alone {
    var out : [256]u8 = undefined;
    const src : str = "fn f() {\n    // name_ok here\n    ; name_ok in prose\n    const s = \"name_ok\";\n    a.name_ok = name_ok_more + my_name_ok + @name_ok(1) + q::name_ok;\n    return name_ok;\n}\n";
    const want : str = "fn f() {\n    // name_ok here\n    ; name_ok in prose\n    const s = \"name_ok\";\n    a.name_ok = name_ok_more + my_name_ok + @name_ok(1) + q::name_ok;\n    return M__name_ok;\n}\n";
    const m : usize = rename_ident(src, "name_ok", "M.t27", out[0 .. 256], 256);
    assert m == want.len;
    assert same_span(out[0 .. 256], 0, m, want, 0, want.len);
}

test rename_leaves_a_field_a_parameter_and_a_variant_alone {
    var out : [256]u8 = undefined;
    const src : str = "pub const S = struct {\n    kind: u32,\n};\npub const E = enum(u8) {\n    kind = 1,\n};\nfn g(kind: u32) -> u32 { return kind; }\n";
    const want : str = "pub const S = struct {\n    kind: u32,\n};\npub const E = enum(u8) {\n    kind = 1,\n};\nfn g(kind: u32) -> u32 { return M__kind; }\n";
    const m : usize = rename_ident(src, "kind", "M.t27", out[0 .. 256], 256);
    assert m == want.len;
    assert same_span(out[0 .. 256], 0, m, want, 0, want.len);
}

test rename_renames_a_const_head_and_its_uses {
    var out : [128]u8 = undefined;
    const src : str = "pub const K : u8 = 3;\nconst J = K + 1;\ntype T = K;\n";
    const want : str = "pub const x__K : u8 = 3;\nconst J = x__K + 1;\ntype T = x__K;\n";
    const m : usize = rename_ident(src, "K", "x.t27", out[0 .. 128], 128);
    assert m == want.len;
    assert same_span(out[0 .. 128], 0, m, want, 0, want.len);
}

test rename_keeps_a_comparison_and_an_escaped_quote {
    var out : [128]u8 = undefined;
    const src : str = "fn h() { if (K == 1 or K != 2) { return \"a\\\"K\"; } }\n";
    const want : str = "fn h() { if (z__K == 1 or z__K != 2) { return \"a\\\"K\"; } }\n";
    const m : usize = rename_ident(src, "K", "z.t27", out[0 .. 128], 128);
    assert m == want.len;
    assert same_span(out[0 .. 128], 0, m, want, 0, want.len);
}

test rename_reports_the_size_it_needs {
    var out : [8]u8 = undefined;
    assert rename_ident("a(K) + K", "K", "m.t27", out[0 .. 8], 8) == 14;
}
