// SPDX-License-Identifier: Apache-2.0
// specs/compiler/gen_verilog_export.t27 -- t27c: emit the wasm export glue
// (export fn) so a spec reaches the browser with no hand Zig.
// Part of M2 milestone (milestone #6). Closes #13340.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::gen_verilog_export;

pub const GEN_VERILOG_EXPORT_MAX_FUNCTIONS : u32 = 256;

pub struct GenVerilogExport { name: str, exported: bool };

pub fn gen_verilog_export_exported(e: GenVerilogExport) -> bool {
    return e.exported;
}

test "gen_verilog_export_exported" {
    assert(gen_verilog_export_exported(GenVerilogExport { name: "export_fn_1", exported: true }));
    assert(!gen_verilog_export_exported(GenVerilogExport { name: "export_fn_2", exported: false }));
}

invariant gen_verilog_export_max_functions_positive {
    assert GEN_VERILOG_EXPORT_MAX_FUNCTIONS > 0;
}