// SPDX-License-Identifier: Apache-2.0
// specs/compiler/gen_verilog_struct_local.t27 -- gen-verilog: a struct-typed
// local declared with an untyped const inside a nested block lowers to unbound
// field names (82 -> 6 elaboration lines on wasm_module).
// Part of M2 milestone (milestone #6). Closes #12277.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::gen_verilog_struct_local;

pub struct Point { x: i32, y: i32 };

pub struct NestedBlock { p: Point, bound: bool };

pub fn nested_block_bound(n: NestedBlock) -> bool {
    return n.bound;
}

test "nested_block_bound" {
    assert(nested_block_bound(NestedBlock { p: Point { x: 1, y: 2 }, bound: true }));
    assert(!nested_block_bound(NestedBlock { p: Point { x: 1, y: 2 }, bound: false }));
}

invariant nested_block_bound_valid {
    var p = NestedBlock { p: Point { x: 1, y: 2 }, bound: true };
    assert(p.p.x == 1);
    assert(p.p.y == 2);
}