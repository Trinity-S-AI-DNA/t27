// SPDX-License-Identifier: Apache-2.0
; specs/compiler/zig_open_slice.t27 -- an OPEN-ENDED slice `a[lo..]` lowers to a Zig slice, not an index.
; --
; The defect (#8200, also #6250). The parser marks `a[lo..]` as a slice with no end child
; (`slice_open`), but the gen-zig emitter only knew the bounded form and fell through to plain
; indexing: `a[2..]` came out as `a[2]`, one element. A typed local then failed to compile, and a
; byte row handed to `std.debug.print("{s}", .{row[0..]})` reached Zig as `.{ row[0] }`, which zig 0.16
; refuses with "invalid format string 's' for type 'u8'". Found while streaming raw RGB frames from
; specs/t27f/reel_particles.t27 (#10308), whose workaround was to pass the whole array.
; --
; The rule. `a[lo..]` keeps its range and runs to the end; `a[lo..hi]` keeps both bounds.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ZigOpenSlice;

pub const ROW4 : [4]u8 = [1, 2, 3, 4];

pub fn tail_len(a: [4]u8) -> u32 {
    var t : []const u8 = a[2..];
    return t.len as u32;
}

pub fn tail_first(a: [4]u8) -> u8 {
    var t : []const u8 = a[1..];
    return t[0];
}

pub fn mid_sum(a: [4]u8) -> u32 {
    var t : []const u8 = a[1..3];
    var s : u32 = 0;
    for (t) |x| { s = s + (x as u32); }
    return s;
}

; The repro shape: a byte row printed with `{s}`. The tail from index 12 is empty, so the test prints
; nothing, but `{s}` only type-checks when the argument is a slice of bytes, never a single u8.
pub fn print_row_tail(from: usize) -> u32 {
    var row : [12]u8 = [72, 101, 108, 108, 111, 44, 32, 116, 50, 55, 33, 10];
    std.debug.print("{s}", .{row[from..]});
    var t : []const u8 = row[from..];
    return t.len as u32;
}

test an_open_slice_runs_to_the_end {
    assert tail_len(ROW4) == 2;
    assert tail_first(ROW4) == 2;
}

test a_bounded_slice_keeps_both_bounds {
    assert mid_sum(ROW4) == 5;
}

test an_open_byte_slice_formats_as_a_string {
    assert print_row_tail(12) == 0;
}
