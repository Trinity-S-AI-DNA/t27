// specs/compiler/splat_scalar.t27 -- ported from bootstrap/src/compiler.rs
// `splat_scalar` (the helper that unwraps a ONE-ELEMENT array-literal text to
// its scalar for the Zig `@splat` lowering: `.{ 9.0 }` -> `9.0`, `{ 48 }` ->
// `48`). Lowered by `t27c gen-rust`; never hand-edit the generated file.
// Refs #5980, #13625.
//
// The contract, byte-identical to the hand-written original: trim the input;
// if it starts with `.{` or `{` and ends with `}`, long enough to hold one
// element, take the trimmed middle; if that middle is non-empty and holds no
// TOP-LEVEL comma (a comma at bracket depth 0 -- elements may be calls with
// their own commas), the middle is the scalar; otherwise the trimmed input is
// returned unchanged. The result is written to the module scratch buffer
// `ss_out` and the returned length is the result length.

module SplatScalar;

const SS_MAX: i64 = 4096;

var ss_out: [4096]u8 = [_]u8{0} ** 4096;

fn is_space(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13;
}

fn trimmed_len(v: []const u8, start: usize, end: usize) -> usize {
    var s: usize = start;
    var e: usize = end;
    while (s < e and is_space(v[s])) {
        s = s + 1;
    }
    while (e > s and is_space(v[e - 1])) {
        e = e - 1;
    }
    ss_tmp_start = s;
    ss_tmp_end = e;
    return e - s;
}

var ss_tmp_start: usize = 0;
var ss_tmp_end: usize = 0;

// True when `v[start..end]` holds a comma at bracket depth 0.
fn has_top_level_comma(v: []const u8, start: usize, end: usize) -> bool {
    var depth: i64 = 0;
    var i: usize = start;
    while (i < end) {
        if (v[i] == 40 or v[i] == 91 or v[i] == 123) {
            depth = depth + 1;
        } else if (v[i] == 41 or v[i] == 93 or v[i] == 125) {
            depth = depth - 1;
        } else if (v[i] == 44 and depth == 0) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn copy_range(v: []const u8, start: usize, end: usize) -> usize {
    var w: usize = 0;
    var r: usize = start;
    while (r < end) {
        ss_out[w] = v[r];
        w = w + 1;
        r = r + 1;
    }
    return end - start;
}

pub fn splat_scalar_len(v: []const u8) -> usize {
    var s: usize = 0;
    var e: usize = v.len;
    while (s < e and is_space(v[s])) {
        s = s + 1;
    }
    while (e > s and is_space(v[e - 1])) {
        e = e - 1;
    }
    // Two candidate opens, longest first so `.{` wins over `{`. The length
    // gate comes FIRST: the open test indexes v[s] and v[s + 1].
    var open: usize = 0;
    while (open < 2) {
        var olen: usize = 1;
        if (open == 0) {
            olen = 2;
        }
        if ((e - s) > olen + 1 and v[e - 1] == 125) {
            var is_open: bool = false;
            if (open == 0) {
                is_open = (v[s] == 46) and (v[s + 1] == 123);
            } else {
                is_open = v[s] == 123;
            }
            if (is_open) {
                var n: usize = trimmed_len(v, s + olen, e - 1);
                if (n > 0 and !has_top_level_comma(v, ss_tmp_start, ss_tmp_end)) {
                    return copy_range(v, ss_tmp_start, ss_tmp_end);
                }
            }
        }
        open = open + 1;
    }
    return copy_range(v, s, e);
}

test unwraps_anonymous_one_element {
    var v: [9]u8 = [46, 123, 32, 57, 46, 48, 32, 125, 0];
    assert(splat_scalar_len(v[0..8]) == 3);
    assert(ss_out[0] == 57);
    assert(ss_out[2] == 48);
}

test unwraps_braced_one_element {
    var v: [6]u8 = [123, 52, 56, 125, 0, 0];
    assert(splat_scalar_len(v[0..4]) == 2);
    assert(ss_out[0] == 52);
    assert(ss_out[1] == 56);
}

test keeps_multi_element_tuple {
    var v: [7]u8 = [46, 123, 49, 44, 50, 125, 0];
    assert(splat_scalar_len(v[0..6]) == 6);
    assert(ss_out[0] == 46);
    assert(ss_out[5] == 125);
}

test keeps_call_element_with_its_own_comma {
    // `.{ f(1,2) }`: the comma sits at depth 1, so the element is kept whole.
    var v: [10]u8 = [46, 123, 102, 40, 49, 44, 50, 41, 32, 125];
    assert(splat_scalar_len(v[0..]) == 6);
    assert(ss_out[0] == 102);
    assert(ss_out[5] == 41);
}

test passes_plain_text_through_trimmed {
    var v: [5]u8 = [32, 57, 93, 32, 0];
    assert(splat_scalar_len(v[0..4]) == 2);
    assert(ss_out[0] == 57);
}

test empty_input_is_zero {
    var none: [1]u8 = [0];
    assert(splat_scalar_len(none[0..0]) == 0);
}
