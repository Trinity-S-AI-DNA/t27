// SPDX-License-Identifier: Apache-2.0
; specs/compiler/gen_text_fn_repro.t27 -- the repro for "t27c gen-text --fn" (t27#13011, step 2).
; --
; A page builder of the shape the widget pages need: a pure fn that fills a caller's buffer and returns
; the number of bytes it wrote, or OVER when they do not fit. page is the (out) form with a u32 return;
; page_cap is the (out, cap) form with a usize return.
; --
; The commands and what they must give (specs/compiler/gen_text.t27 holds the contract):
; - gen-text specs/compiler/gen_text_fn_repro.t27 --fn page -o /tmp/page.txt  exits 0 and the file holds
;   exactly the 37 bytes of tests/fixtures/gen_text_fn/page.txt (cmp says identical; a second run too);
; - the same with --fn page_cap writes the same bytes;
; - the same with --buf 16 exits non-zero, prints one line on stderr and writes no file (37 > 16);
; - --fn nope, or --fn copy_to (a signature that is not accepted), exit non-zero with one line.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module GenTextFnRepro;

pub const OVER : u32 = 4294967295;

pub const PAGE : str = "<!doctype html>\n<p>gen-text --fn</p>\n";

/// s into out from the front; its length, or OVER when it does not fit (nothing is written then).
pub fn copy_to(out: []u8, s: []const u8) -> u32 {
    if (s.len > out.len) { return OVER; }
    var i : usize = 0;
    while (i < s.len) {
        out[i] = s[i];
        i += 1;
    }
    return s.len as u32;
}

/// The (out) form, u32 return.
pub fn page(out: []u8) -> u32 {
    return copy_to(out, PAGE);
}

/// The (out, cap) form, usize return: only the first cap bytes of out may be used.
pub fn page_cap(out: []u8, cap: usize) -> usize {
    if (cap > out.len) { return OVER as usize; }
    return copy_to(out[0..cap], PAGE) as usize;
}

/// out[0..n] holds exactly the bytes of want.
fn same(out: []u8, n: usize, want: []const u8) -> bool {
    if (n != want.len) { return false; }
    var i : usize = n;
    while (i > 0) {
        i -= 1;
        if (out[i] != want[i]) { return false; }
    }
    return true;
}

/// The literal goes through a call so the asserts below run at run time, not at compile time.
fn text_of(s: []const u8) -> []const u8 {
    return s;
}

test the_page_is_the_expected_thirty_seven_bytes {
    const want = text_of("<!doctype html>\n<p>gen-text --fn</p>\n");
    var o : [64]u8 = [0] ** 64;
    const n : u32 = page(&o);
    assert(n == 37);
    assert(same(&o, n as usize, want));
    assert(o[36] == 10);
}

test a_buffer_that_is_too_small_gives_over_and_writes_nothing {
    var o : [16]u8 = [0] ** 16;
    assert(page(&o) == OVER);
    assert(o[0] == 0);
}

test the_cap_form_gives_the_same_bytes {
    var a : [64]u8 = [0] ** 64;
    var b : [64]u8 = [0] ** 64;
    const n : u32 = page(&a);
    const m : usize = page_cap(&b, 64);
    assert(m == n as usize);
    assert(same(&b, m, text_of("<!doctype html>\n<p>gen-text --fn</p>\n")));
}

test a_cap_below_the_page_gives_over {
    var o : [64]u8 = [0] ** 64;
    assert(page_cap(&o, 16) == 4294967295);
    assert(page_cap(&o, 36) == 4294967295);
    assert(page_cap(&o, 37) == 37);
}

test the_same_call_twice_gives_the_same_bytes {
    var a : [64]u8 = [0] ** 64;
    var b : [64]u8 = [0] ** 64;
    const n : u32 = page(&a);
    const m : u32 = page(&b);
    assert(n == m);
    assert(same(&a, n as usize, text_of("<!doctype html>\n<p>gen-text --fn</p>\n")));
    assert(same(&b, m as usize, text_of("<!doctype html>\n<p>gen-text --fn</p>\n")));
}
