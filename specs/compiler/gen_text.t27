// SPDX-License-Identifier: Apache-2.0
; specs/compiler/gen_text.t27 -- `t27c gen-text`: the bytes of a spec's str constant as a text file (t27#13011).
; --
; The gap (t27#13007): every gen-* subcommand lowers declarations into another language; none writes the
; bytes of a `str` constant. A Dockerfile, llms.txt or plist that a spec describes therefore had no way
; to reach a tracked file that L2 GENERATION could own.
; --
; The contract of `t27c gen-text <spec> --const NAME [-o PATH]` (FR-001):
; - the bytes of the str constant NAME are written unchanged: a lexeme char U+0000..U+00FF is the byte of
;   that value (string_escapes.t27), nothing is added and nothing is removed, no trailing newline;
; - without -o the file is gen/text/<spec path below specs/, without .t27>/NAME, for example
;   specs/scratch/gen_text_repro.t27 --const HELLO writes gen/text/scratch/gen_text_repro/HELLO;
; - the exit code is 0 after a write; a spec with no const NAME, or a const that is not a string literal,
;   exits non-zero and the message names the constant;
; - a spec path that cannot give a path under gen/text/ (absolute, or holding "..") has no default
;   path: the caller must pass -o. The default never escapes gen/text/.
; --
; The contract of "t27c gen-text <spec> --fn NAME [--buf N] [-o PATH]" (FR-004, step 2: the text is the
; output of a function instead of a constant):
; - the spec holds "pub fn NAME(out: []u8) -> u32" or "pub fn NAME(out: []u8, cap: usize) -> u32", with
;   usize accepted in place of u32 as the return type; it fills out from the front and returns the number
;   of bytes it wrote, or OVER (4294967295) when they do not fit;
; - the spec is compiled to Zig the way the spec-test runner compiles it, and a generated main (the
;   harness below) calls NAME with an N-byte buffer, N = 1048576 unless --buf says otherwise (cap, when
;   asked for, is N); the first n bytes it returned are written unchanged: nothing added, no newline;
; - n = OVER, or n above N, exits non-zero with one stderr line and writes NO file; a spec with no such
;   fn, or one with another signature, exits non-zero with one stderr line that names the fn;
; - without -o the file is the same gen/text/<spec stem>/NAME as for --const, and -o takes any path in
;   the working tree (missing directories are created);
; - the output is a function of the spec alone: nothing a pub fn of this shape can reach reads a clock,
;   a DOM, the network or a wasm host, so two runs write the same bytes (t27#13011 A1..A6).
; --
; What lives where: this spec holds the decisions (text_check, fn_check), the default path (default_path)
; and the text of the harness (harness); bootstrap/src/main.rs only reads the AST, calls them through
; bootstrap/gen/rust/compiler/gen_text.rs, runs the harness with the Zig compiler and writes the file.
; The repro is specs/compiler/gen_text_fn_repro.t27, its expected bytes are
; tests/fixtures/gen_text_fn/page.txt.
; --
; Not here: the L2 GENERATION tables in specs/policy/l2_generation.t27 (BACKENDS gains "text",
; SUBCOMMANDS gains "gen-text") are a protected file and land in their own commit with the owner's hand.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module CompilerGenText;

/// text_check() answers.
pub const TEXT_WRITE : u8 = 0;
pub const TEXT_NO_CONST : u8 = 1;
pub const TEXT_NOT_STR : u8 = 2;

/// Where a default output lands, and what is cut from the spec path to make its directory name.
pub const TEXT_DIR : str = "gen/text/";
pub const SPECS_DIR : str = "specs/";
pub const SPEC_EXT : str = ".t27";

/// found: the spec declares a const of that name. is_str: its value is a string literal.
pub fn text_check(found: bool, is_str: bool) -> u8 {
    if (!found) { return TEXT_NO_CONST; }
    if (!is_str) { return TEXT_NOT_STR; }
    return TEXT_WRITE;
}

/// s begins with p.
pub fn text_starts(s: []const u8, p: []const u8) -> bool {
    if (s.len < p.len) { return false; }
    var i : usize = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return false; }
        i += 1;
    }
    return true;
}

/// s ends with p.
pub fn text_ends(s: []const u8, p: []const u8) -> bool {
    if (s.len < p.len) { return false; }
    var i : usize = 0;
    while (i < p.len) {
        if (s[s.len - p.len + i] != p[i]) { return false; }
        i += 1;
    }
    return true;
}

/// s holds two dots in a row.
pub fn text_dotdot(s: []const u8) -> bool {
    var i : usize = 0;
    while (i + 1 < s.len) {
        if (s[i] == '.' and s[i + 1] == '.') { return true; }
        i += 1;
    }
    return false;
}

/// The length of p when s begins with it, else 0.
pub fn text_skip(s: []const u8, p: []const u8) -> usize {
    if (text_starts(s, p)) { return p.len; }
    return 0;
}

/// The length of s without the suffix p when it ends with it, else all of s.
pub fn text_cut(s: []const u8, p: []const u8) -> usize {
    if (text_ends(s, p)) { return s.len - p.len; }
    return s.len;
}

/// One byte at w if it fits; the new cursor (a byte that does not fit is counted, not written).
pub fn text_put(out: []u8, w: usize, c: u8) -> usize {
    if (w < out.len) { out[w] = c; }
    return w + 1;
}

/// The bytes of s; the new cursor.
pub fn text_puts(out: []u8, w: usize, s: []const u8) -> usize {
    var p : usize = w;
    var i : usize = 0;
    while (i < s.len) {
        p = text_put(out, p, s[i]);
        i += 1;
    }
    return p;
}

/// The default output path of gen-text for spec and const name, written to out. Returns its length
/// (more than out.len means it did not fit, nothing past out.len is written), or 0 when the spec path
/// gives no safe default: empty, absolute, holding "..", or with an empty stem.
pub fn default_path(spec: []const u8, name: []const u8, out: []u8) -> usize {
    if (spec.len == 0 or spec[0] == '/') { return 0; }
    if (text_dotdot(spec)) { return 0; }
    var i : usize = text_skip(spec, SPECS_DIR);
    const end : usize = text_cut(spec, SPEC_EXT);
    if (i >= end) { return 0; }
    var w : usize = text_puts(out, 0, TEXT_DIR);
    while (i < end) {
        w = text_put(out, w, spec[i]);
        i += 1;
    }
    w = text_put(out, w, '/');
    return text_puts(out, w, name);
}

/// fn_check() answers (they continue the TEXT_* numbers).
pub const FN_OK : u8 = 0;
pub const FN_MISSING : u8 = 3;
pub const FN_SIG : u8 = 4;

/// What a fn returns when its bytes do not fit, and the buffer --fn gives it unless --buf says otherwise.
pub const FN_OVER : u32 = 4294967295;
pub const DEFAULT_BUF : usize = 1048576;

/// a and b hold the same bytes.
pub fn text_eq(a: []const u8, b: []const u8) -> bool {
    return a.len == b.len and text_starts(a, b);
}

/// sig is the parameter types joined by "," and then "->" and the return type, as main.rs spells it.
pub fn fn_sig_ok(sig: []const u8) -> bool {
    return text_eq(sig, "[]u8->u32") or text_eq(sig, "[]u8->usize") or text_eq(sig, "[]u8,usize->u32") or text_eq(sig, "[]u8,usize->usize");
}

/// found: the spec declares a fn of that name. sig: see fn_sig_ok.
pub fn fn_check(found: bool, sig: []const u8) -> u8 {
    if (!found) { return FN_MISSING; }
    if (!fn_sig_ok(sig)) { return FN_SIG; }
    return FN_OK;
}

/// The fn takes cap as its second argument.
pub fn fn_has_cap(sig: []const u8) -> bool {
    return text_starts(sig, "[]u8,");
}

/// v in decimal; the new cursor.
pub fn text_dec(out: []u8, w: usize, v: usize) -> usize {
    var d : usize = 1;
    while (v / d >= 10) { d *= 10; }
    var p : usize = w;
    var r : usize = v;
    while (d > 0) {
        p = text_put(out, p, (48 + r / d) as u8);
        r = r % d;
        d = d / 10;
    }
    return p;
}

/// The harness: the main file that sits next to the spec's own Zig. It calls the fn with a global
/// buffer and prints the bytes to stdout, or prints one line to stderr and exits 3 when the fn answered
/// OVER or a length above the buffer. The newline of that line is {c}, so no backslash is needed.
pub const H_1 : str = "const std = @import(\"std\");\nconst spec = @import(\"spec.zig\");\n\nvar buf: [";
pub const H_2 : str = "]u8 = undefined;\n\npub fn main(init: std.process.Init.Minimal) void {\n    _ = init;\n    const n = spec.";
pub const H_3 : str = "(&buf";
pub const H_4 : str = ", buf.len";
pub const H_5 : str = ");\n    if (n == ";
pub const H_6 : str = " or n > buf.len) {\n        std.debug.print(\"gen-text: ";
pub const H_7 : str = " returned {d}, which is OVER or longer than the {d}-byte buffer{c}\", .{ n, buf.len, @as(u8, 10) });\n        std.process.exit(3);\n    }\n    var ob: [4096]u8 = undefined;\n    var w: std.Io.File.Writer = .initStreaming(.stdout(), std.Io.Threaded.global_single_threaded.io(), &ob);\n    w.interface.writeAll(buf[0..n]) catch std.process.exit(4);\n    w.interface.flush() catch std.process.exit(4);\n    std.process.exit(0);\n}\n";

/// The harness for fn name with a cap-byte buffer, written to out. cap_arg: the fn takes cap as well.
/// Returns its length (more than out.len means it did not fit, nothing past out.len is written).
pub fn harness(name: []const u8, cap: usize, cap_arg: bool, out: []u8) -> usize {
    var w : usize = text_puts(out, 0, H_1);
    w = text_dec(out, w, cap);
    w = text_puts(out, w, H_2);
    w = text_puts(out, w, name);
    w = text_puts(out, w, H_3);
    if (cap_arg) { w = text_puts(out, w, H_4); }
    w = text_puts(out, w, H_5);
    w = text_dec(out, w, FN_OVER as usize);
    w = text_puts(out, w, H_6);
    w = text_puts(out, w, name);
    return text_puts(out, w, H_7);
}

/// out[0..n] holds exactly the bytes of want.
fn text_same(out: []u8, n: usize, want: []const u8) -> bool {
    if (n != want.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (out[i] != want[i]) { return false; }
        i += 1;
    }
    return true;
}

/// The literal goes through a call so the asserts below run at run time, not at compile time.
fn text_of(s: []const u8) -> []const u8 {
    return s;
}

test a_declared_string_const_is_written {
    assert(text_check(true, true) == TEXT_WRITE);
}

test a_missing_const_is_refused {
    assert(text_check(false, false) == TEXT_NO_CONST);
    assert(text_check(false, true) == TEXT_NO_CONST);
}

test a_const_that_is_not_a_string_is_refused {
    assert(text_check(true, false) == TEXT_NOT_STR);
}

test the_verdicts_are_distinct {
    assert(TEXT_WRITE != TEXT_NO_CONST);
    assert(TEXT_WRITE != TEXT_NOT_STR);
    assert(TEXT_NO_CONST != TEXT_NOT_STR);
}

test the_repro_lands_under_gen_text {
    var buf : [128]u8 = [0] ** 128;
    const n : usize = default_path("specs/scratch/gen_text_repro.t27", "HELLO", &buf);
    assert(n == 37);
    assert(text_same(&buf, n, "gen/text/scratch/gen_text_repro/HELLO"));
}

test a_nested_spec_keeps_its_directories {
    var buf : [128]u8 = [0] ** 128;
    const n : usize = default_path("specs/docker/igla_train.t27", "D_HEAD", &buf);
    assert(text_same(&buf, n, "gen/text/docker/igla_train/D_HEAD"));
}

test a_path_outside_specs_is_kept_whole {
    var buf : [128]u8 = [0] ** 128;
    const n : usize = default_path("lab/a.t27", "X", &buf);
    assert(text_same(&buf, n, "gen/text/lab/a/X"));
}

test a_path_without_the_extension_is_kept {
    var buf : [128]u8 = [0] ** 128;
    const n : usize = default_path("specs/a/b", "X", &buf);
    assert(text_same(&buf, n, "gen/text/a/b/X"));
}

test an_absolute_path_has_no_default {
    var buf : [128]u8 = [0] ** 128;
    assert(default_path("/tmp/a.t27", "X", &buf) == 0);
    assert(buf[0] == 0);
}

test a_dotdot_path_has_no_default {
    var buf : [128]u8 = [0] ** 128;
    assert(default_path("specs/../a.t27", "X", &buf) == 0);
    assert(default_path("specs/a/..", "X", &buf) == 0);
}

test an_empty_stem_has_no_default {
    var buf : [128]u8 = [0] ** 128;
    assert(default_path("", "X", &buf) == 0);
    assert(default_path("specs/.t27", "X", &buf) == 0);
}

test a_short_buffer_is_counted_not_overrun {
    var buf : [8]u8 = [0] ** 8;
    const n : usize = default_path("specs/scratch/gen_text_repro.t27", "HELLO", &buf);
    assert(n == 37);
    assert(buf[0] == 103);
    assert(buf[7] == 116);
}

test a_trailing_newline_is_one_byte_of_the_text {
    const s = text_of("hello\n");
    assert(s.len == 6);
    assert(s[0] == 104);
    assert(s[5] == 10);
}

test a_hex_escape_is_one_byte_of_the_text {
    const s = text_of("a\x00\xff");
    assert(s.len == 3);
    assert(s[1] == 0);
    assert(s[2] == 255);
}

test the_suffix_helpers_agree {
    assert(text_starts("specs/x", "specs/"));
    assert(!text_starts("spec", "specs/"));
    assert(text_ends("a.t27", ".t27"));
    assert(!text_ends("t27", ".t27"));
    assert(text_skip("specs/x", "specs/") == 6);
    assert(text_skip("lab/x", "specs/") == 0);
    assert(text_cut("a.t27", ".t27") == 1);
    assert(text_cut("a", ".t27") == 1);
}

/// out[0..n] holds p somewhere.
fn text_has(out: []u8, n: usize, p: []const u8) -> bool {
    if (n < p.len) { return false; }
    var i : usize = 0;
    while (i + p.len <= n) {
        var j : usize = 0;
        var hit : bool = true;
        while (j < p.len) {
            if (out[i + j] != p[j]) { hit = false; }
            j += 1;
        }
        if (hit) { return true; }
        i += 1;
    }
    return false;
}

test a_fn_with_an_accepted_signature_is_run {
    assert(fn_check(true, "[]u8->u32") == FN_OK);
    assert(fn_check(true, "[]u8->usize") == FN_OK);
    assert(fn_check(true, "[]u8,usize->u32") == FN_OK);
    assert(fn_check(true, "[]u8,usize->usize") == FN_OK);
}

test a_missing_fn_is_refused {
    assert(fn_check(false, "") == FN_MISSING);
    assert(fn_check(false, "[]u8->u32") == FN_MISSING);
}

test another_signature_is_refused {
    assert(fn_check(true, "->u32") == FN_SIG);
    assert(fn_check(true, "u8->u32") == FN_SIG);
    assert(fn_check(true, "[]u8->u8") == FN_SIG);
    assert(fn_check(true, "[]u8->bool") == FN_SIG);
    assert(fn_check(true, "[]const u8->u32") == FN_SIG);
    assert(fn_check(true, "[]u8,u32->u32") == FN_SIG);
    assert(fn_check(true, "[]u8,usize,usize->u32") == FN_SIG);
    assert(fn_check(true, "[]u8->u32 ") == FN_SIG);
}

test the_fn_verdicts_are_distinct_from_the_const_ones {
    assert(FN_OK == TEXT_WRITE);
    assert(FN_MISSING != FN_SIG);
    assert(FN_MISSING != TEXT_NO_CONST);
    assert(FN_MISSING != TEXT_NOT_STR);
    assert(FN_SIG != TEXT_NO_CONST);
    assert(FN_SIG != TEXT_NOT_STR);
}

test the_cap_argument_is_read_from_the_signature {
    assert(fn_has_cap("[]u8,usize->u32"));
    assert(fn_has_cap("[]u8,usize->usize"));
    assert(!fn_has_cap("[]u8->u32"));
    assert(!fn_has_cap("[]u8->usize"));
}

test the_default_buffer_is_one_mebibyte_and_over_is_the_u32_maximum {
    assert(DEFAULT_BUF == 1048576);
    assert(FN_OVER == 4294967295);
}

test decimal_numbers_are_written_whole {
    var buf : [32]u8 = [0] ** 32;
    var n : usize = text_dec(&buf, 0, 0);
    assert(text_same(&buf, n, "0"));
    n = text_dec(&buf, 0, 7);
    assert(text_same(&buf, n, "7"));
    n = text_dec(&buf, 0, 1000);
    assert(text_same(&buf, n, "1000"));
    n = text_dec(&buf, 0, 1048576);
    assert(text_same(&buf, n, "1048576"));
    n = text_dec(&buf, 0, 4294967295);
    assert(text_same(&buf, n, "4294967295"));
}

test the_harness_calls_the_fn_with_the_buffer {
    var b : [2048]u8 = [0] ** 2048;
    const n : usize = harness("page", 16, false, &b);
    assert(n > 0 and n < 2048);
    assert(text_has(&b, n, "var buf: [16]u8 = undefined;"));
    assert(text_has(&b, n, "const n = spec.page(&buf);"));
    assert(text_has(&b, n, "if (n == 4294967295 or n > buf.len) {"));
    assert(text_has(&b, n, "std.debug.print(\"gen-text: page returned"));
    assert(text_has(&b, n, "std.process.exit(3);"));
}

test the_harness_passes_the_cap_when_the_fn_takes_one {
    var b : [2048]u8 = [0] ** 2048;
    const n : usize = harness("page_cap", 1000, true, &b);
    assert(text_has(&b, n, "var buf: [1000]u8 = undefined;"));
    assert(text_has(&b, n, "const n = spec.page_cap(&buf, buf.len);"));
}

test the_harness_writes_the_bytes_and_nothing_else {
    var b : [2048]u8 = [0] ** 2048;
    const n : usize = harness("page", 1048576, false, &b);
    assert(text_has(&b, n, "var buf: [1048576]u8 = undefined;"));
    assert(text_has(&b, n, "w.interface.writeAll(buf[0..n])"));
    assert(b[n - 1] == 10);
    assert(b[n - 2] == 125);
}

test a_short_harness_buffer_is_counted_not_overrun {
    var b : [8]u8 = [0] ** 8;
    const n : usize = harness("page", 16, false, &b);
    assert(n > 8);
    assert(b[0] == 99);
    assert(b[7] == 116);
}
