// specs/compiler/import_scanner.t27 -- t27c: import scanner counts words in ;
// and /// comments as identifier uses.
// Part of M2 milestone (milestone #6). Closes #13367.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::import_scanner;

pub const IMPORT_SCANNER_MAX_IMPORTS : u32 = 1024;

pub struct ImportLine { name: str, imported: bool };

pub fn import_line_imported(i: ImportLine) -> bool {
    return i.imported;
}

test "import_line_imported" {
    assert(import_line_imported(ImportLine { name: "module-a", imported: true }));
    assert(!import_line_imported(ImportLine { name: "module-b", imported: false }));
}

invariant import_scanner_max_imports_positive {
    assert IMPORT_SCANNER_MAX_IMPORTS > 0;
}