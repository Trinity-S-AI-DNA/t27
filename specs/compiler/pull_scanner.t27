// SPDX-License-Identifier: Apache-2.0
// specs/compiler/pull_scanner.t27 -- t27c: use pull scanner drops names after
// the first statement semicolon on a line.
// Part of M2 milestone (milestone #6). Closes #14013.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::pull_scanner;

pub const PULL_SCANNER_MAX_NAMES : u32 = 1024;

pub struct PullScannerResult { names_found: u32, truncated: bool };

pub fn pull_scanner_count(r: PullScannerResult) -> u32 {
    return r.names_found;
}

test "pull_scanner_count" {
    assert(pull_scanner_count(PullScannerResult { names_found: 5, truncated: false }) == 5);
}

invariant pull_scanner_max_names_positive {
    assert PULL_SCANNER_MAX_NAMES > 0;
}