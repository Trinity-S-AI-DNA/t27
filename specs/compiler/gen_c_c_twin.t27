// SPDX-License-Identifier: Apache-2.0
// specs/compiler/gen_c_c_twin.t27 -- t27c gen-c: no host entry point (argv,
// stdin, env); x86_64 tools need a hand C main.
// Part of M2 milestone (milestone #6). Closes #13386.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::gen_c_c_twin;

pub const GEN_C_C_TWIN_MAX_ARGS : u32 = 256;

pub struct GenCCMain { entry_point: str, has_main: bool };

pub fn gen_c_c_twin_has_main(g: GenCCMain) -> bool {
    return g.has_main;
}

test "gen_c_c_twin_has_main" {
    assert(gen_c_c_twin_has_main(GenCCMain { entry_point: "main", has_main: true }));
    assert(!gen_c_c_twin_has_main(GenCCMain { entry_point: "main", has_main: false }));
}

invariant gen_c_c_twin_max_args_positive {
    assert GEN_C_C_TWIN_MAX_ARGS > 0;
}