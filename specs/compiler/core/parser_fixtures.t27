module ParserFixtures;
// The parser-port contract on TWO independent axes. PORT answers "does the
// .t27 ParserPort (t27core's port_type_shape / port_fn_type /
// port_fn_param_count) recognize and represent this shape?"; RUNTIME answers
// "does the shape lower/emit yet?". A shape is PORT=PASS while RUNTIME=BLOCKED
// when it is recognized but not yet lowered. The two axes are never collapsed.
//
// PORT is honest against the ACTUAL recognizer: a case whose recognizer output
// is a positive shape is PORT=PASS; a case the recognizer refuses with a
// negative diagnostic (0 - E_PORT_*), or whose sub-representation (MutRef(T),
// free-fn generic, unresolved type) the recognizer does not yet produce, is
// PORT=BLOCKED. The recognizer's own outputs are verified by t27core's tests
// (specs/compiler/core/t27core.t27, ParserPort section), not by a constant
// table here.

pub const PORT_PASS : u8 = 1;
pub const PORT_BLOCKED : u8 = 0;
pub const RUNTIME_PASS : u8 = 1;
pub const RUNTIME_BLOCKED : u8 = 0;

// Case ids. The source signature each names is in the header comment.
pub const C_FIRST : u8 = 1;      // first(xs: []const u8) -> u8
pub const C_COUNT : u8 = 2;      // count(comptime T: type, xs: []const T) -> usize
pub const C_FILL : u8 = 3;       // fill(comptime T: type, xs: []T, v: T)
pub const C_FLAGS : u8 = 4;      // flags() -> []bool
pub const C_MAP : u8 = 5;        // map(xs: []const u8, f: fn(u8) -> u8) -> []u8
pub const C_FOR_EACH : u8 = 6;   // for_each(comptime T: type, xs: []T, f: fn(&mut T))
pub const C_IDENTITY : u8 = 7;   // identity<T>(x: T) -> T  (free-fn generic)
pub const C_UNDECL : u8 = 8;     // a fn using an undeclared U -> unresolved-type diag
pub const C_MALFORMED : u8 = 9;  // fn(u8 -> u8  -> E_PORT_MALFORMED_FN_TYPE diag
pub const C_NONGEN : u8 = 10;    // a non-generic fn -> no generic type params

/// PORT axis: honest against the recognizer. Cases 1-5 and 10 produce a
/// positive shape; case 6 is only partially represented (the fn-type head is
/// recognized but MutRef(T) is not a distinct shape), and cases 7-9 are not
/// recognized (free-fn generic, unresolved type, malformed diagnostic), so
/// 6-9 are PORT=BLOCKED.
pub fn fixture_port_status(case: u8) -> u8 {
    if (case == C_FIRST or case == C_COUNT or case == C_FILL or case == C_FLAGS or case == C_MAP or case == C_NONGEN) {
        return PORT_PASS;
    }
    return PORT_BLOCKED;
}

/// RUNTIME axis: only the in-subset shapes lower. fn-type, free-fn generic,
/// unresolved-type and malformed remain BLOCKED until their emitter slices.
pub fn fixture_runtime_status(case: u8) -> u8 {
    if (case == C_FIRST or case == C_COUNT or case == C_FILL or case == C_FLAGS or case == C_NONGEN) {
        return RUNTIME_PASS;
    }
    return RUNTIME_BLOCKED;
}

/// The recognizer's expected output for a case, as the shape/diagnostic the
/// t27core recognizer returns: a positive PORT_* shape when recognized, a
/// negative 0 - E_PORT_* when refused, and 0 when not yet representable. This
/// pins what t27core's ParserPort tests already verify; it is NOT an extra
/// recognition path.
pub fn port_case_expected_shape(case: u8) -> i64 {
    // t27core shapes: PORT_BARE=1, PORT_CONST_SLICE=2, PORT_MUT_SLICE=3,
    // PORT_FN_TYPE=5; diagnostics are 0 - E_PORT_*.
    if (case == C_FIRST) { return 2; }       // []const u8 -> const slice
    if (case == C_COUNT) { return 2; }       // []const T -> const slice (head)
    if (case == C_FILL) { return 3; }        // []T -> mut slice
    if (case == C_FLAGS) { return 3; }       // []bool return -> mut slice
    if (case == C_MAP) { return 5; }         // fn(u8) -> u8 -> fn-type
    if (case == C_FOR_EACH) { return 0; }    // fn(&mut T): head only; MutRef not distinct
    if (case == C_IDENTITY) { return 0; }    // free-fn generic: not recognized
    if (case == C_UNDECL) { return 0; }      // unresolved type: not detected
    if (case == C_MALFORMED) { return 0 - 4; } // 0 - E_PORT_MALFORMED_FN_TYPE
    if (case == C_NONGEN) { return 1; }      // non-generic -> bare type
    return 0;
}

test port_axis_passes_only_recognized_cases {
    assert_eq(fixture_port_status(C_FIRST), PORT_PASS);
    assert_eq(fixture_port_status(C_COUNT), PORT_PASS);
    assert_eq(fixture_port_status(C_FILL), PORT_PASS);
    assert_eq(fixture_port_status(C_FLAGS), PORT_PASS);
    assert_eq(fixture_port_status(C_MAP), PORT_PASS);
    assert_eq(fixture_port_status(C_NONGEN), PORT_PASS);
    assert_eq(fixture_port_status(C_FOR_EACH), PORT_BLOCKED);
    assert_eq(fixture_port_status(C_IDENTITY), PORT_BLOCKED);
    assert_eq(fixture_port_status(C_UNDECL), PORT_BLOCKED);
    assert_eq(fixture_port_status(C_MALFORMED), PORT_BLOCKED);
}

test runtime_axis_in_subset_passes_rest_blocked {
    assert_eq(fixture_runtime_status(C_FIRST), RUNTIME_PASS);
    assert_eq(fixture_runtime_status(C_COUNT), RUNTIME_PASS);
    assert_eq(fixture_runtime_status(C_FILL), RUNTIME_PASS);
    assert_eq(fixture_runtime_status(C_FLAGS), RUNTIME_PASS);
    assert_eq(fixture_runtime_status(C_NONGEN), RUNTIME_PASS);
    assert_eq(fixture_runtime_status(C_MAP), RUNTIME_BLOCKED);
    assert_eq(fixture_runtime_status(C_FOR_EACH), RUNTIME_BLOCKED);
    assert_eq(fixture_runtime_status(C_IDENTITY), RUNTIME_BLOCKED);
    assert_eq(fixture_runtime_status(C_UNDECL), RUNTIME_BLOCKED);
    assert_eq(fixture_runtime_status(C_MALFORMED), RUNTIME_BLOCKED);
}

test expected_shapes_match_the_recognizer {
    assert_eq(port_case_expected_shape(C_FIRST), 2);
    assert_eq(port_case_expected_shape(C_FILL), 3);
    assert_eq(port_case_expected_shape(C_MAP), 5);
    assert_eq(port_case_expected_shape(C_MALFORMED), 0 - 4);
    assert_eq(port_case_expected_shape(C_FOR_EACH), 0);
    assert_eq(port_case_expected_shape(C_IDENTITY), 0);
}

test malformed_is_a_negative_diagnostic_not_a_pass {
    assert_eq(port_case_expected_shape(C_MALFORMED), 0 - 4);
    assert_eq(fixture_port_status(C_MALFORMED), PORT_BLOCKED);
}

invariant statuses_are_binary {
    assert fixture_port_status(C_FIRST) == PORT_PASS or fixture_port_status(C_FIRST) == PORT_BLOCKED;
    assert fixture_runtime_status(C_MAP) == RUNTIME_PASS or fixture_runtime_status(C_MAP) == RUNTIME_BLOCKED;
}

endmodule
