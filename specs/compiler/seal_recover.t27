// specs/compiler/seal_recover.t27 -- seals: re-save 6 seals left stale by the
// #12695 parser change (Spec Guards red on master).
// Part of M2 milestone (milestone #6). Closes #13285.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::seal_recover;

pub const SEAL_RECOVER_MAX_SPECS : u32 = 1024;

pub struct SealRecord { name: str, stale: bool, recovered: bool };

pub fn seal_recover_recovered(s: SealRecord) -> bool {
    return s.recovered;
}

test "seal_recover_recovered" {
    assert(seal_recover_recovered(SealRecord { name: "seal-1", recovered: true }));
    assert(!seal_recover_recovered(SealRecord { name: "seal-2", recovered: false }));
}

invariant seal_recover_max_specs_positive {
    assert SEAL_RECOVER_MAX_SPECS > 0;
}