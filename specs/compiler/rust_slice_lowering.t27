// SPDX-License-Identifier: Apache-2.0
// specs/compiler/rust_slice_lowering.t27 (#11182): slice lengths and string elements in the Rust back end.
//
// `gen-rust` left `t.len` as written on a slice parameter whenever the file declared a struct field called `len`
// (E0615), and passed an element of a `[N]str` array to a `[]const u8` parameter as it was, an `&str` (E0308).
// The module below holds a `len` field AND every shape that used to break: a slice, written slice, array, string and
// string-field length, the free `len(x)` call, a `len` field read next to a slice length, and the elements of a `[N]str`
// constant, array field and function result passed on as bytes. `bootstrap/tests/backend_behaviour.rs` compiles its
// Rust with rustc; its `test` blocks run under Zig and t27b.
// ASCII only (L3)
// phi^2 + 1/phi^2 = 3 | TRINITY

module RustSliceLowering;

// A struct field called `len` makes the file's `x.len` ambiguous by name alone.
pub const LenCell = struct {
    len : usize,
    cap : usize,
};

pub const NameRow = struct {
    name : str,
    size : usize,
};

pub const NAMES : [3]str = ["a", "bb", "ccc"];

fn slice_len(t: []const u8) -> usize {
    return t.len;
}

fn first_or_zero(t: []i64) -> i64 {
    if (t.len == 0) {
        return 0;
    }
    return t[0];
}

fn written_len(t: []i64) -> usize {
    t[0] = 7;
    return t.len;
}

fn array_len(t: [4]i64) -> usize {
    return t.len;
}

fn free_len(t: []const u8) -> usize {
    return len(t);
}

fn cell_len(c: LenCell) -> usize {
    return c.len;
}

fn cell_below_slice(c: *LenCell, t: []const u8) -> bool {
    return c.len < t.len;
}

fn row_name_len(r: NameRow) -> usize {
    return r.name.len;
}

fn row_name_bytes(r: NameRow) -> usize {
    return slice_len(r.name);
}

fn name_bytes(i: usize) -> usize {
    return slice_len(NAMES[i]);
}

fn last_name_bytes() -> usize {
    return slice_len(NAMES[2]);
}

fn name_first_byte(i: usize) -> u8 {
    return NAMES[i][0];
}

test slice_lengths_next_to_a_len_field {
    var buf : [4]i64 = [5] ** 4;
    var cell = LenCell{ .len = 2, .cap = 9 };
    assert(slice_len("abc") == 3);
    assert(first_or_zero(&buf) == 5);
    assert(written_len(&buf) == 4);
    assert(buf[0] == 7);
    assert(array_len(buf) == 4);
    assert(free_len("hello") == 5);
    assert(cell_len(cell) == 2);
    assert(cell_below_slice(&cell, "abc") == true);
}

test string_elements_pass_on_as_bytes {
    const row = NameRow{ .name = "xyz", .size = 1 };
    assert(row_name_len(row) == 3);
    assert(row_name_bytes(row) == 3);
    assert(name_bytes(1) == 2);
    assert(last_name_bytes() == 3);
    assert(name_first_byte(2) == 99);
}

endmodule
