// SPDX-License-Identifier: Apache-2.0
// specs/compiler/typecheck_array_slice.t27 -- t27c: a slice-typed struct field
// makes same-named scalar comparisons emit std.mem.eql.
// Part of M2 milestone (milestone #6). Closes #12343.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::typecheck_array_slice;

pub const TYPECHECK_ARRAY_SLICE_MAX_FIELDS : u32 = 1024;

pub struct ArraySliceField { name: str, type_correct: bool };

pub fn array_slice_field_type_correct(a: ArraySliceField) -> bool {
    return a.type_correct;
}

test "array_slice_field_type_correct" {
    assert(array_slice_field_type_correct(ArraySliceField { name: "field1", type_correct: true }));
    assert(!array_slice_field_type_correct(ArraySliceField { name: "field2", type_correct: false }));
}

invariant array_slice_max_fields_positive {
    assert TYPECHECK_ARRAY_SLICE_MAX_FIELDS > 0;
}