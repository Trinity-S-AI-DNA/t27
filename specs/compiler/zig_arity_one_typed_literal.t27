// SPDX-License-Identifier: Apache-2.0
; specs/compiler/zig_arity_one_typed_literal.t27 -- a typed `[1]T{...}` literal keeps its element list.
; --
; The defect (#13285). #12695 taught the parser that a declared `[1]T` annotation turns a bracketed
; single element into a one-element list, so `[1]u32 = [20261026]` lowers to `.{ 20261026 }`. The new
; path fired on every `[1]`-annotated const whose value starts with `[`, including the typed literal
; `[1]u32{7,}`: it read the DIMENSION `1` as the element and dropped the `{...}` list. A scalar element
; became `.{ 1 }`, a struct element became a Zig error ("expected type 'spec.X', found 'comptime_int'").
; It broke four trios-chat specs (CR-CHAT-03 reinit_freshness, pcs_healing, external_psk_id_provenance;
; CR-CHAT-07 blind_signature_sender_token).
; --
; The rule. Only `[x];` -- a bracket group that ends the value -- is the one-element list. A bracket
; group followed by a type and braces is the dimension of a typed literal.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ZigArityOneTypedLiteral;

pub const ArityOneEntry = struct { a: u32, b: u32 };

pub const ONE_SCALAR: [1]u32 = [1]u32{7,};
pub const ONE_SCALAR_NO_COMMA: [1]u32 = [1]u32{9};
pub const ONE_STRUCT: [1]ArityOneEntry = [1]ArityOneEntry{
    ArityOneEntry{ .a = 3, .b = 4 },
};
pub const ONE_LIST: [1]u32 = [20261026];

pub fn scalar_at(i: u32) -> u32 {
    return ONE_SCALAR[i];
}

test a_typed_one_element_literal_keeps_its_scalar_element {
    assert ONE_SCALAR.len == 1;
    assert ONE_SCALAR[0] == 7;
    assert scalar_at(0) == 7;
    assert ONE_SCALAR_NO_COMMA[0] == 9;
}

test a_typed_one_element_literal_keeps_its_struct_element {
    assert ONE_STRUCT.len == 1;
    assert ONE_STRUCT[0].a == 3;
    assert ONE_STRUCT[0].b == 4;
}

test a_bare_single_element_with_a_one_annotation_is_still_a_list {
    assert ONE_LIST.len == 1;
    assert ONE_LIST[0] == 20261026;
}
