// SPDX-License-Identifier: Apache-2.0
// Regression (use_resolve module var) for the eval_hslm b4_s BLOCKED: defining
// module. A module-level `threadlocal var` used by a fn that an importing
// spec calls through the splice must be spliced WITH the fn, or the spliced
// build dies on `use of undeclared identifier` (specs/ml/eval_hslm.t27 vs
// specs/ml/train_hslm.t27's tr4_matmul + b4_q/b4_s/b4_wt, 2026-11-03).
module EmitterRegressionsUseResolveVarDef;

threadlocal var counter : i32 = 0;

pub fn bump() i32 {
    counter = counter + 1;
    return counter;
}

pub fn peek() i32 {
    return counter;
}

test bump_persists_in_this_module {
    assert bump() == 1;
    assert bump() == 2;
    assert peek() == 2;
}
