// Probe 2 (cross-module const) for t27#11777: defining module.
module EmitterRegressionsCrossConstDef;

pub const MAX_NODES : u32 = 42;

pub fn node_cap() u32 {
    return MAX_NODES;
}

test cap_works {
    assert node_cap() == 42;
}

test negative_control_max_nodes_not_zero { assert MAX_NODES != 0; }
