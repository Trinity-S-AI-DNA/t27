// SPDX-License-Identifier: Apache-2.0
// Regression (use_resolve module var) for the eval_hslm b4_s BLOCKED: consumer
// module. Before the fix the splice pulled `bump` but never declared the
// module-level `counter` it writes, so this file's build died on `use of
// undeclared identifier`. After the fix the var is spliced once and shared:
// two calls see one persistent counter.
module EmitterRegressionsUseResolveVarUse;

use compiler::emitter_regressions::use_resolve_var_def;

pub fn two_bumps_second_is_two() i32 {
    var first : i32 = use_resolve_var_def.bump();
    var second : i32 = use_resolve_var_def.bump();
    if (first == 1) {
        return second;
    }
    return 0 - 1;
}

test the_spliced_var_is_shared_across_calls {
    assert two_bumps_second_is_two() == 2;
}
