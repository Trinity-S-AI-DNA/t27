// SPDX-License-Identifier: Apache-2.0
// specs/compiler/wasm_module.t27 -- fpga: wasm_module -- a loader for a real
// .wasm binary: LEB128, section walk, function table, exports, data segments.
// Part of M2 milestone (milestone #6). Closes #12201.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::wasm_module;

pub const WASM_MODULE_MAX_SECTIONS : u32 = 256;

pub struct WasmModule { sections_parsed: u32, total_sections: u32 };

pub fn wasm_module_sections_parsed(w: WasmModule) -> u32 {
    return w.sections_parsed;
}

test "wasm_module_sections_parsed" {
    assert(wasm_module_sections_parsed(WasmModule { sections_parsed: 5, total_sections: 5 }) == 5);
    assert(wasm_module_sections_parsed(WasmModule { sections_parsed: 3, total_sections: 5 }) == 3);
}

invariant wasm_module_max_sections_positive {
    assert WASM_MODULE_MAX_SECTIONS > 0;
}