// SPDX-License-Identifier: Apache-2.0
// specs/compiler/gen_verilog_undefined_locals.t27 -- gen-verilog-for-simulation:
// undefined locals and missing keywords break elaboration.
// Part of M2 milestone (milestone #6). Closes #12179.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::gen_verilog_undefined_locals;

pub const GEN_VERILOG_UNDEFINED_LOCALS_MAX : u32 = 256;

pub struct UndefinedLocal { name: str, defined: bool };

pub fn undefined_local_defined(u: UndefinedLocal) -> bool {
    return u.defined;
}

test "undefined_local_defined" {
    assert(undefined_local_defined(UndefinedLocal { name: "local-1", defined: true }));
    assert(!undefined_local_defined(UndefinedLocal { name: "local-2", defined: false }));
}

invariant gen_verilog_undefined_locals_max_positive {
    assert GEN_VERILOG_UNDEFINED_LOCALS_MAX > 0;
}