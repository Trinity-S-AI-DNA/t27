// specs/compiler/claw_receipt_trace.t27 -- claw: trace -- a TRI CLAW fix earns
// TRI credit claims only through VerifiedPayout's rules.
// Part of M2 milestone (milestone #6). Closes #13581.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::receipt_trace;

pub const CLAW_RECEIPT_TRACE_MAX_EVENTS : u32 = 1024;

pub struct ReceiptTrace { id: str, accepted: bool };

pub fn receipt_trace_accepted(r: ReceiptTrace) -> bool {
    return r.accepted;
}

test "receipt_trace_accepted" {
    assert(receipt_trace_accepted(ReceiptTrace { id: "trace-1", accepted: true }));
    assert(!receipt_trace_accepted(ReceiptTrace { id: "trace-2", accepted: false }));
}

invariant receipt_trace_max_events_positive {
    assert CLAW_RECEIPT_TRACE_MAX_EVENTS > 0;
}