// specs/compiler/verbatim_char_literal.t27 -- fpga-lint: gen-verilog copies a
// t27 char literal verbatim, hdmi_grab.v:88 fails read_verilog on master since
// #10949.
// Part of M2 milestone (milestone #6). Closes #12171.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::verbatim_char_literal;

pub const VERBATIM_CHAR_LITERAL_MAX : u32 = 256;

pub struct VerbatimCharLiteral { char_value: str, emitted_verbatim: bool };

pub fn verbatim_char_literal_emitted_verbatim(v: VerbatimCharLiteral) -> bool {
    return v.emitted_verbatim;
}

test "verbatim_char_literal_emitted_verbatim" {
    assert(verbatim_char_literal_emitted_verbatim(VerbatimCharLiteral { char_value: 'A', emitted_verbatim: true }));
    assert(!verbatim_char_literal_emitted_verbatim(VerbatimCharLiteral { char_value: 'B', emitted_verbatim: false }));
}

invariant verbatim_char_literal_max_positive {
    assert VERBATIM_CHAR_LITERAL_MAX > 0;
}