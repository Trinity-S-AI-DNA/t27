; C by-value array wrappers keep repeat designators inside their array member.
; The repeat OPERATOR `[v] ** n` is covered below (#11181): a bare literal or name between the brackets is not told from
; an array dimension, reached gen-c as bracket text, and was written {0} -- every element zero, whatever v was.
module CArrayRepeatWrapper {
    const WIDTH: usize = 4;

    fn wrapped_at(value: u32, index: usize) -> u32 {
        var values: [u32; WIDTH] = [value; WIDTH];
        return values[index];
    }

    fn returned_values(value: u32) -> [u32; 4] {
        return [value; 4];
    }

    fn returned_at(value: u32, index: usize) -> u32 {
        var values: [u32; 4] = returned_values(value);
        return values[index];
    }

    fn plain_at(value: u32, index: usize) -> u32 {
        var values: [4]u32 = [value; 4];
        return values[index];
    }

    fn list_at(index: usize) -> u32 {
        var values: [u32; 4] = [10, 20, 30, 40];
        return values[index];
    }

    test wrapped_nonzero {
        assert(wrapped_at(7, 0) == 7, "first wrapped element");
        assert(wrapped_at(7, 3) == 7, "last wrapped element");
    }

    test returned_by_value {
        assert(returned_at(19, 0) == 19, "first returned element");
        assert(returned_at(19, 3) == 19, "last returned element");
    }

    // The repeat operator `[v] ** n` (#11181): module constant, local, struct field, every scalar type.
    const SEED : u32 = 9;
    const QUAD : usize = 4;
    const ONES : [3]u64 = [7] ** 3;

    pub const RepeatCells = struct {
        cells : [4]u16,
    };

    fn op_u8(i: usize) -> u8 { var a : [64]u8 = [5] ** 64; return a[i]; }
    fn op_u16(i: usize) -> u16 { var a : [4]u16 = [300] ** 4; return a[i]; }
    fn op_u32(i: usize) -> u32 { var a : [4]u32 = [70000] ** 4; return a[i]; }
    fn op_u64(i: usize) -> u64 { var a : [4]u64 = [7] ** 4; return a[i]; }
    fn op_i32(i: usize) -> i32 { var a : [4]i32 = [-3] ** 4; return a[i]; }
    fn op_f64(i: usize) -> f64 { var a : [4]f64 = [1.5] ** 4; return a[i]; }
    fn op_bool(i: usize) -> bool { var a : [4]bool = [true] ** 4; return a[i]; }
    fn op_hex(i: usize) -> u32 { var a : [4]u32 = [0xFF] ** 4; return a[i]; }
    fn op_one(i: usize) -> u32 { var a : [1]u32 = [41] ** 1; return a[i]; }
    fn op_big(i: usize) -> u8 { var a : [4096]u8 = [3] ** 4096; return a[i]; }
    fn op_named(i: usize) -> u32 { var a : [4]u32 = [SEED] ** QUAD; return a[i]; }
    fn op_cast(i: usize) -> u32 { var a : [4]u32 = [@as(u32, 11)] ** 4; return a[i]; }
    fn op_param(x: u32, i: usize) -> u32 { var a : [4]u32 = [x] ** 4; return a[i]; }
    fn op_const(i: usize) -> u64 { return ONES[i]; }
    fn op_nested(i: usize, j: usize) -> u32 { var a : [2][3]u32 = [[1] ** 3] ** 2; return a[i][j]; }
    fn op_field(i: usize) -> u16 { var r : RepeatCells = RepeatCells{ .cells = [9] ** 4 }; return r.cells[i]; }
    fn op_zero(i: usize) -> u32 { var a : [4]u32 = [0] ** 4; return a[i]; }

    test repeat_operator_fills_every_element {
        assert(op_u64(0) == 7, "u64 first");
        assert(op_u64(2) == 7, "u64 third (the issue probe)");
        assert(op_u64(3) == 7, "u64 last");
        assert(op_u8(63) == 5, "u8 over 64 elements");
        assert(op_u16(3) == 300, "u16");
        assert(op_u32(1) == 70000, "u32");
        assert(op_i32(3) == -3, "i32 negative");
        assert(op_f64(2) == 1.5, "f64");
        assert(op_bool(3), "bool");
        assert(op_hex(2) == 255, "hex literal");
        assert(op_one(0) == 41, "one element");
        assert(op_big(4095) == 3, "4096 elements");
    }

    test repeat_operator_in_every_context {
        assert(op_named(3) == 9, "named element, named count");
        assert(op_cast(3) == 11, "@as element");
        assert(op_param(13, 0) == 13, "parameter element");
        assert(op_param(13, 3) == 13, "parameter element, last");
        assert(op_const(0) == 7, "module constant, first");
        assert(op_const(2) == 7, "module constant, last");
        assert(op_nested(0, 0) == 1, "nested, first row");
        assert(op_nested(1, 2) == 1, "nested, last element");
        assert(op_field(3) == 9, "struct field");
    }

    test repeat_operator_of_zero_stays_zero {
        assert(op_zero(0) == 0, "zero first");
        assert(op_zero(3) == 0, "zero last");
    }

    test plain_and_list_controls {
        assert(plain_at(23, 3) == 23, "plain array repeat");
        assert(list_at(0) == 10, "first list element");
        assert(list_at(3) == 40, "last list element");
    }

    // A range slice `a[lo..hi]`, `a[lo..]`, `a[lo:hi]` is a slice, not an element (#11183). In C a slice is a pointer
    // (the length is lost where every `[]T` parameter loses it, #11183 D4), so it is the address of element `lo`:
    // it was written `a[(lo .. hi)]`, which is not C, and `a[lo]` (an element, silently) for the open and colon forms.
    fn head(s: []const u32) -> u32 { return s[0]; }
    fn second(s: []const u32) -> u32 { return s[1]; }
    fn ignores(s: []const u32) -> u32 { return 11; }
    fn slice_arg(lo: usize) -> u32 { var t : [6]u32 = [10, 20, 30, 40, 50, 60]; return head(t[lo..lo + 2]); }
    fn slice_open() -> u32 { var t : [6]u32 = [10, 20, 30, 40, 50, 60]; return head(t[4..]); }
    fn slice_colon() -> u32 { var t : [6]u32 = [10, 20, 30, 40, 50, 60]; return head(t[3:5]); }
    fn slice_local() -> u32 { var t : [6]u32 = [10, 20, 30, 40, 50, 60]; var s = t[1..4]; return s[1]; }
    fn slice_typed() -> u32 { var t : [6]u32 = [10, 20, 30, 40, 50, 60]; var s : []const u32 = t[2..5]; return s[1]; }
    fn slice_chain() -> u32 { var t : [6]u32 = [10, 20, 30, 40, 50, 60]; return head(t[1..5][1..3]); }
    fn slice_empty() -> u32 { var t : [6]u32 = [10, 20, 30, 40, 50, 60]; return ignores(t[0..0]); }
    fn slice_of_param(s: []const u32) -> u32 { return second(s[2..]); }
    fn slice_of_table() -> u32 { return head(TABLE[5..6]); }

    var TABLE : [6]u32 = [10, 20, 30, 40, 50, 60];

    test range_slice_starts_at_its_lower_bound {
        assert(slice_arg(0) == 10, "argument, names");
        assert(slice_arg(3) == 40, "argument, expression bound");
        assert(slice_open() == 50, "open end");
        assert(slice_colon() == 40, "colon spelling");
        assert(slice_local() == 30, "local, indexed");
        assert(slice_typed() == 40, "local with a declared slice type");
        assert(slice_chain() == 30, "slice of a slice");
        assert(slice_empty() == 11, "empty range");
        assert(slice_of_param(TABLE[0..6]) == 40, "slice of a slice parameter");
        assert(slice_of_table() == 60, "module constant");
    }
}
