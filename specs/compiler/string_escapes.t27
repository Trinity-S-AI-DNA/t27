// SPDX-License-Identifier: Apache-2.0
; specs/compiler/string_escapes.t27 -- pins the \xNN string escape (#10793).
; --
; The lexer lowers a backslash, x and exactly two hex digits to ONE byte of the literal. Before #10793
; "\xD0\x96" kept all eight characters, so a test written with \xNN failed at run time while the
; compiler said nothing (found in t27#10788: UTF-8 ideas for the Cyrillic idea factory).
; --
; How the byte survives each backend (bootstrap/src/compiler.rs):
; - the lexeme holds a byte as the char of the same value, U+0000..U+00FF;
; - Zig and Rust write it back as \xNN, C and Verilog as three-digit octal. A Rust str cannot hold a lone
;   byte above 0x7F, so non-ASCII text must be valid UTF-8 (written as \u{..}); anything else is a
;   compile_error! in the generated Rust.
; The tests below run through Zig (t27c test-report). The other backends are checked by the compiler's
; own unit tests and by the sweep of every spec that carries a string.
; --
; A backslash-x that is not followed by two hex digits is NOT an escape and keeps its four characters.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module StringEscapes;

    // The literal goes through a call so the asserts below run at run time, not at compile time.
    fn text_of(s: []const u8) -> []const u8 {
        return s;
    }

    // Zhe (U+0416) in UTF-8 is D0 96: two bytes, not eight characters.
    test zhe_is_two_bytes {
        const zhe = text_of("\xD0\x96");
        assert zhe.len == 2;
        assert zhe[0] == 208;
        assert zhe[1] == 150;
    }

    // The digits may be lower case, and one escape is one byte.
    test lower_case_digits {
        const lead = text_of("\xd0");
        assert lead.len == 1;
        assert lead[0] == 208;
    }

    // A hex digit right after the escape is plain text: "\xD0A" is the bytes 208 and 65.
    // (A C \x escape would swallow the A, which is why C uses octal.)
    test digit_after_escape_is_text {
        const mixed = text_of("\xD0A");
        assert mixed.len == 2;
        assert mixed[0] == 208;
        assert mixed[1] == 65;
    }

    // ESC [ 0 m: the ANSI reset sequence that specs/tri/utils/terminal.t27 used to spell as numbers.
    test ansi_reset_is_four_bytes {
        const reset = text_of("\x1b[0m");
        assert reset.len == 4;
        assert reset[0] == 27;
        assert reset[1] == 91;
        assert reset[2] == 48;
        assert reset[3] == 109;
    }

    // The ends of the byte range.
    test byte_range_ends {
        const ends = text_of("\x7f\xff");
        assert ends.len == 2;
        assert ends[0] == 127;
        assert ends[1] == 255;
    }

    // Not an escape: a non-hex digit, and fewer than two digits. The four characters stay.
    test malformed_escape_is_kept {
        const bad = text_of("\xZZ");
        assert bad.len == 4;
        assert bad[0] == 92;
        assert bad[1] == 120;
        assert bad[2] == 90;
        assert bad[3] == 90;
    }

    // The old escapes are unchanged.
    test old_escapes_unchanged {
        const old = text_of("a\nb\t\\\"");
        assert old.len == 6;
        assert old[1] == 10;
        assert old[3] == 9;
        assert old[4] == 92;
        assert old[5] == 34;
    }
