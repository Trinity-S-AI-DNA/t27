// specs/compiler/ubuntu_pin.t27 -- Remove the ubuntu-24.04 pin from the seven
// gen-c gate workflows once #13057 regenerates gen/c.
// Part of M2 milestone (milestone #6). Closes #13060.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::ubuntu_pin;

pub const UBUNTU_PIN_MAX_VERSION : u32 = 2604;

pub struct UbuntuPin { version: u32, unpinned: bool };

pub fn ubuntu_pin_unpinned(u: UbuntuPin) -> bool {
    return u.unpinned;
}

test "ubuntu_pin_unpinned" {
    assert(ubuntu_pin_unpinned(UbuntuPin { version: 2604, unpinned: true }));
    assert(!ubuntu_pin_unpinned(UbuntuPin { version: 2404, unpinned: false }));
}

invariant ubuntu_pin_max_positive {
    assert UBUNTU_PIN_MAX_VERSION > 0;
}