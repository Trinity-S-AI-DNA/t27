; specs/compiler/gen_text_repro.t27 -- the repro of t27#13011: t27c gen-text writes HELLO to gen/text/compiler/gen_text_repro/HELLO.
; HELLO is 6 bytes: hello and a newline, no more. ASCII only (L3)
; Not under specs/scratch/: that directory is gitignored and bootstrap/tests/icarus_lowerable.rs skips its 191 witness
; tests only while it holds no .t27 file, so one committed spec there turned them all into failures.
; phi^2 + 1/phi^2 = 3 | TRINITY

module GenTextRepro;

pub const HELLO : str = "hello\n";
pub const HELLO_LEN : usize = 6;

test hello_is_six_bytes { assert HELLO_LEN == 6; }
