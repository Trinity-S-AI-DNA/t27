// specs/compiler/rust_num_suffix.t27 -- ported from bootstrap/src/compiler.rs
// `strip_rust_num_suffix` (the helper that strips a Rust numeric width
// suffix: `0i32` -> `0`, `1.5f64` -> `1.5`, `7usize` -> `7`). Lowered by
// `t27c gen-rust`; never hand-edit the generated file. Refs #5980, #13591.
//
// The contract, byte-identical to the hand-written original: try the known
// Rust width suffixes; if the remainder ends with `_`, drop that underscore;
// if the rest (a leading `-` allowed) is a non-empty digit run that may
// contain `.` and `_`, return the remainder without the suffix; otherwise
// return the input unchanged. The result is written to the module scratch
// buffer `ns_out` and the returned length is the result length.

module RustNumSuffix;

const NS_MAX: i64 = 4096;

var ns_out: [4096]u8 = [_]u8{0} ** 4096;

fn eq_tail(v: []const u8, tlen: usize, t0: u8, t1: u8, t2: u8, t3: u8, t4: u8) -> bool {
    if (v.len < tlen) {
        return false;
    }
    var tail: [5]u8 = [t0, t1, t2, t3, t4];
    var i: usize = 0;
    while (i < tlen) {
        if (v[v.len - tlen + i] != tail[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn is_digit(c: u8) -> bool {
    return c >= 48 and c <= 57;
}

fn body_is_numeric(body: []const u8) -> bool {
    if (body.len == 0) {
        return false;
    }
    if (!is_digit(body[0])) {
        return false;
    }
    var i: usize = 0;
    while (i < body.len) {
        if (!is_digit(body[i]) and body[i] != 46 and body[i] != 95) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn rust_num_suffix_len(v: []const u8) -> usize {
    // The suffixes, longest first: `u128` before `u8`, so `7u128` does not
    // stop at `u8`; the hand-written original relied on the same order.
    var i: usize = 0;
    var tlen: usize = 0;
    var t0: u8 = 0;
    var t1: u8 = 0;
    var t2: u8 = 0;
    var t3: u8 = 0;
    var t4: u8 = 0;
    while (i < 13) {
        if (i == 0) { tlen = 4; t0 = 117; t1 = 49; t2 = 50; t3 = 56; t4 = 0; }
        else if (i == 1) { tlen = 5; t0 = 105; t1 = 115; t2 = 105; t3 = 122; t4 = 101; }
        else if (i == 2) { tlen = 4; t0 = 105; t1 = 49; t2 = 50; t3 = 56; t4 = 0; }
        else if (i == 3) { tlen = 3; t0 = 117; t1 = 54; t2 = 52; t3 = 0; t4 = 0; }
        else if (i == 4) { tlen = 3; t0 = 105; t1 = 54; t2 = 52; t3 = 0; t4 = 0; }
        else if (i == 5) { tlen = 3; t0 = 117; t1 = 51; t2 = 50; t3 = 0; t4 = 0; }
        else if (i == 6) { tlen = 3; t0 = 105; t1 = 51; t2 = 50; t3 = 0; t4 = 0; }
        else if (i == 7) { tlen = 3; t0 = 117; t1 = 49; t2 = 54; t3 = 0; t4 = 0; }
        else if (i == 8) { tlen = 3; t0 = 105; t1 = 49; t2 = 54; t3 = 0; t4 = 0; }
        else if (i == 9) { tlen = 3; t0 = 102; t1 = 54; t2 = 52; t3 = 0; t4 = 0; }
        else if (i == 10) { tlen = 3; t0 = 102; t1 = 51; t2 = 50; t3 = 0; t4 = 0; }
        else if (i == 11) { tlen = 2; t0 = 117; t1 = 56; t2 = 0; t3 = 0; t4 = 0; }
        else { tlen = 2; t0 = 105; t1 = 56; t2 = 0; t3 = 0; t4 = 0; }
        if (eq_tail(v, tlen, t0, t1, t2, t3, t4)) {
            var num_len: usize = v.len - tlen;
            if (num_len > 0 and v[num_len - 1] == 95) {
                num_len = num_len - 1;
            }
            var start: usize = 0;
            if (num_len > 0 and v[0] == 45) {
                start = 1;
            }
            if (body_is_numeric(v[start..num_len])) {
                var j: usize = 0;
                while (j < num_len) {
                    ns_out[j] = v[j];
                    j = j + 1;
                }
                return num_len;
            }
        }
        i = i + 1;
    }
    var j: usize = 0;
    while (j < v.len) {
        ns_out[j] = v[j];
        j = j + 1;
    }
    return v.len;
}

test strips_int_suffix {
    var full: [4]u8 = [48, 105, 51, 50];
    assert(rust_num_suffix_len(full[0..]) == 1);
    assert(ns_out[0] == 48);
}

test strips_float_suffix {
    var full: [6]u8 = [49, 46, 53, 102, 54, 52];
    assert(rust_num_suffix_len(full[0..]) == 3);
    assert(ns_out[0] == 49);
    assert(ns_out[1] == 46);
    assert(ns_out[2] == 53);
}

test leaves_plain_number_unchanged {
    var full: [2]u8 = [55, 56];
    assert(rust_num_suffix_len(full[0..]) == 2);
    assert(ns_out[0] == 55);
}

test suffix_requires_numeric_body {
    var full: [4]u8 = [120, 95, 117, 56];
    assert(rust_num_suffix_len(full[0..]) == 4);
    assert(ns_out[0] == 120);
}


const TB_MAX: i64 = 4096;

var tb_out: [4096]u8 = [_]u8{0} ** 4096;

fn is_space(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13;
}

fn is_ident(c: u8) -> bool {
    if (c >= 48 and c <= 57) {
        return true;
    }
    if (c >= 65 and c <= 90) {
        return true;
    }
    if (c >= 97 and c <= 122) {
        return true;
    }
    return c == 95;
}

// The FIRST character of a base name may not be a digit: `starts_with(|c|
// c.is_ascii_alphabetic() || c == '_')` in the hand-written original.
fn is_ident_start(c: u8) -> bool {
    if (c >= 65 and c <= 90) {
        return true;
    }
    if (c >= 97 and c <= 122) {
        return true;
    }
    return c == 95;
}

pub fn type_base_name_len(v: []const u8) -> usize {
    var start: usize = 0;
    var end: usize = v.len;
    var round: usize = 0;
    var changed: bool = true;
    while (changed and round < 32) {
        changed = false;
        round = round + 1;
        while (start < end and is_space(v[start])) {
            start = start + 1;
            changed = true;
        }
        while (end > start and is_space(v[end - 1])) {
            end = end - 1;
            changed = true;
        }
        while (start < end and (v[start] == 42 or v[start] == 38)) {
            start = start + 1;
            changed = true;
        }
        while (end > start and v[end - 1] == 63) {
            end = end - 1;
            changed = true;
        }
        if (end - start >= 6 and v[start] == 99 and v[start + 1] == 111 and v[start + 2] == 110 and v[start + 3] == 115 and v[start + 4] == 116 and v[start + 5] == 32) {
            start = start + 6;
            changed = true;
            while (start < end and is_space(v[start])) {
                start = start + 1;
            }
        }
        if (start < end and v[start] == 91) {
            var j: usize = start;
            var close: usize = end;
            while (j < end) {
                if (v[j] == 93) {
                    close = j;
                    j = end;
                } else {
                    j = j + 1;
                }
            }
            if (close < end) {
                start = close + 1;
                changed = true;
                while (start < end and is_space(v[start])) {
                    start = start + 1;
                }
            }
        }
    }
    var ok = end > start and is_ident_start(v[start]);
    if (ok) {
        var k: usize = start;
        while (k < end) {
            if (!is_ident(v[k])) {
                ok = false;
                k = end;
            }
            k = k + 1;
        }
    }
    if (!ok) {
        return 0;
    }
    var w: usize = 0;
    var r: usize = start;
    while (r < end) {
        tb_out[w] = v[r];
        w = w + 1;
        r = r + 1;
    }
    return end - start;
}

test peels_const_slice_to_base {
    var v: [9]u8 = [91, 93, 99, 111, 110, 115, 116, 32, 84];
    assert(type_base_name_len(v[0..]) == 1);
    assert(tb_out[0] == 84);
}

test peels_pointer_and_question {
    var v: [6]u8 = [42, 38, 84, 114, 105, 63];
    assert(type_base_name_len(v[0..]) == 3);
    assert(tb_out[0] == 84);
    assert(tb_out[2] == 105);
}

test trims_spaces_around {
    var v: [6]u8 = [32, 32, 84, 114, 105, 32];
    assert(type_base_name_len(v[0..]) == 3);
}

test refuses_digit_start_and_space_inside {
    var digits: [3]u8 = [49, 50, 51];
    assert(type_base_name_len(digits[0..]) == 0);
    var spaced: [7]u8 = [109, 117, 116, 32, 70, 111, 111];
    assert(type_base_name_len(spaced[0..]) == 0);
}

test empty_input_is_zero {
    var none: [1]u8 = [0];
    assert(type_base_name_len(none[0..0]) == 0);
}
