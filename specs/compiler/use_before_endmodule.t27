// SPDX-License-Identifier: Apache-2.0
; specs/compiler/use_before_endmodule.t27 -- regression for #13366: a spec that ends with `endmodule` and
; imports a function through `use` gets that function in its output.
; --
; The `use` splice appended the imported declarations after the last byte of the spec. The parser ends the
; file at `endmodule` (#6047) and refuses text after it, so the spliced source did not parse, t27c fell
; back to the source without the splice, and the Zig test leg answered "use of undeclared identifier"
; (t27os lab run 42584738885 on specs/t27os/research_card.t27, before #13406 dropped its `endmodule`).
; The splice now goes before the trailing `endmodule` (specs/compiler/use_splice.t27, R7, `tail_start`).
; Keep the `endmodule` at the bottom: it is the case under test.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module UseBeforeEndmodule;

use std::mem::bytes_eq;

/// Is `w` the word that closes a module?
pub fn closes_module(w: []const u8) -> bool {
    return bytes_eq(w, "endmodule");
}

test an_import_reaches_a_spec_that_ends_with_endmodule {
    assert closes_module("endmodule");
}

test the_imported_function_still_tells_a_difference {
    assert !closes_module("endmodules");
    assert !closes_module("module");
    assert !closes_module("");
}

test negative_control_a_prefix_is_not_the_word {
    assert !bytes_eq("endmodule", "endmod");
}

endmodule
