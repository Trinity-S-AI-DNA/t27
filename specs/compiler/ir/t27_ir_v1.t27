; --- Future work (not implemented here) --------------------------------
; 1. Shared-backend frontends: define and version the t27 IR contract;
;    implement restricted C, Rust, Zig, Go, and Python frontends that
;    lower to that contract; measure frontend, t27b-backend, and
;    end-to-end compilation separately.
; 2. Cross-language conformance: for each supported frontend, add paired
;    differential tests against native toolchains using identical inputs,
;    expected-output hashes, and declared runtime-check policy.
; 3. Target-emitter conformance: for gen-c, gen-rust, gen-zig, and
;    gen-verilog, add end-to-end compilation, execution, simulation, or
;    synthesis tests with pinned toolchains and expected output hashes.
; 4. Complete the Python emitter: lower function bodies and emit
;    executable Python functions, then add behavioural differential tests
;    against the t27c reference.
pub const FUTURE_FRONTENDS_DONE : u8 = 0;
pub const FUTURE_CROSSLANG_TESTS_DONE : u8 = 0;
pub const FUTURE_EMITTER_CONFORMANCE_DONE : u8 = 0;
pub const FUTURE_PYTHON_BODIES_DONE : u8 = 0;

; --- Normative rules. Implementation status stays 0. -------------------
; source: specs/compiler/ir/t27_ir_v1.t27
; One source. docs/ir/* are indexes. They are not a second grammar.
; Binary is optional and is not part of t27_ir_v1 until the textual
; contract is stable. A hash covers canonical bytes only, never an
; in-memory tree. Textual round-trip, once a serializer exists, is a
; serialization property, not a semantic round-trip of the source program.
; The functions below serialize, hash, and validate a minimal module.
; FORM_* stays 0: t27b still does not load this text.
; Hash is SHA-256 of the canonical bytes only, via specs/fpga/sha256.t27.
; A textual round trip is a serialization property of this text, not of C or Rust.
; Validation order, required when the tools exist:
; parse canonical text, structural validation, operation/type validation,
; semantic validation, canonical serialization, hash, t27b reader.
; An invariant failure must stop with a stable diagnostic name and must
; not be handed to t27b. The spec validator does that. The t27b reader
; of this contract is not connected.
pub const DOC_INDEX_MARKER : str = "source: specs/compiler/ir/t27_ir_v1.t27";
pub const RULE_TEXT_REQUIRED_BEFORE_BINARY : u8 = 1;
