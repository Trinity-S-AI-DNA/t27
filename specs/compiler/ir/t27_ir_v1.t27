test canonical_bytes_are_stable_and_normalized {
    var a : IrVerdict = canon_pair(0);
    var b : IrVerdict = canon_pair(1);
    assert a.status == CODE_OK;
    assert b.status == CODE_OK;
    assert a.n == b.n;
    assert a.backend_called == 0;
    assert b.backend_called == 0;
    assert same_bytes(a.raw[0..a.n], b.raw[0..b.n]);
    assert same_bytes(a.raw[0..a.n], "v1 fn add loc a i32 1 loc b i32 2 ret add");
    assert a.h0 == b.h0;
    var again : IrVerdict = validate(a.raw[0..a.n]);
    assert again.status == CODE_OK;
    assert same_bytes(again.raw[0..again.n], a.raw[0..a.n]);
}

test sha256_of_canonical_bytes_changes_when_one_byte_changes {
    var abc : [3]u8 = [0x61, 0x62, 0x63];
    var habc : [8]u32 = hash_canonical(abc[0..3]);
    assert habc[0] == 0xba7816bf;
    assert habc[7] == 0xf20015ad;
    var a : IrVerdict = canon_pair(0);
    var flipped : [80]u8 = a.raw;
    flipped[0] = flipped[0] + 1;
    var h1 : [8]u32 = hash_canonical(a.raw[0..a.n]);
    var h2 : [8]u32 = hash_canonical(flipped[0..a.n]);
    assert h1[0] == a.h0;
    assert h1[0] != h2[0];
}

test wrong_version_stops_before_backend {
    var v : IrVerdict = validate("v2 fn add loc a i32 1 loc b i32 2 ret add");
    assert v.status == CODE_VERSION;
    assert v.status != 0;
    assert v.backend_called == 0;
    assert reason(v.status) == DIAG_VERSION;
    assert v.at == 0;
}

fn reject(text: str, code: u8) -> bool {
    var v : IrVerdict = validate(text);
    if (v.status != code) { return false; }
    if (v.backend_called != 0) { return false; }
    if (v.status == 0) { return false; }
    return true;
}

test each_forbidden_construct_has_a_code_and_does_not_call_a_backend {
    assert reject("v1 fn add provenance", CODE_PROVENANCE);
    assert reason(CODE_PROVENANCE) == "IRV1_PROVENANCE";
    assert reject("v1 fn add loc a i32 loc b i32 1 ret add", CODE_UNINIT);
    assert reason(CODE_UNINIT) == "IRV1_UNINIT_READ";
    assert reject("v1 fn add race", CODE_RACE);
    assert reason(CODE_RACE) == "IRV1_DATA_RACE";
    assert reject("v1 fn add oob", CODE_OOB);
    assert reason(CODE_OOB) == "IRV1_OUT_OF_BOUNDS";
    assert reject("v1 fn add overflow_ub", CODE_OVERFLOW_UB);
    assert reason(CODE_OVERFLOW_UB) == "IRV1_SIGNED_OVERFLOW_UB";
    assert reject("v1 fn add goto", CODE_GOTO);
    assert reason(CODE_GOTO) == "IRV1_GOTO";
    assert reject("v1 fn add setjmp", CODE_SETJMP);
    assert reject("v1 fn add longjmp", CODE_SETJMP);
    assert reason(CODE_SETJMP) == "IRV1_SETJMP_LONGJMP";
    assert reject("v1 fn add variadic", CODE_VARIADIC);
    assert reason(CODE_VARIADIC) == "IRV1_VARIADIC";
    assert reject("v1 fn add struct", CODE_STRUCT);
    assert reason(CODE_STRUCT) == "IRV1_COMPLEX_STRUCT";
    assert reject("v1 fn add spawn", CODE_CONCURRENCY);
    assert reason(CODE_CONCURRENCY) == "IRV1_CONCURRENCY";
    assert reject("v1 fn add eval_order", CODE_EVAL_ORDER);
    assert reject("v1 fn add impl_defined", CODE_IMPL);
    assert reject("v1 fn add ptr", CODE_PTR);
    assert T27B_READER_CONNECTED == 0;
}
