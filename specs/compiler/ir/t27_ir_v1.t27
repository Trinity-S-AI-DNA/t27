pub const GEN_RUST_CONTOUR_DONE : u8 = 0;
pub const REVERSE_RUST_CONTOUR_DONE : u8 = 0;
pub const EMITTER_TIME_FOLDED_INTO_T27B : u8 = 0;
; Evidenced elsewhere for the t27 language only. Not the architectural
; formula, and not a claim about foreign frontends.
pub const T27_LANGUAGE_BACKEND_IS_NATIVE_JIT_ASM_VERILOG : u8 = 1;
pub const THAT_ROLE_IS_THE_ARCHITECTURAL_FORMULA : u8 = 0;
; Slogan. Future only. Not used until frontends exist.
pub const SLOGAN_IS_PRESENT_FACT : u8 = 0;
