; --- Executable minimal contract. Not a t27b reader. ----------------
; Canonical text, one module, fixed field order, single spaces:
;   v1 fn <name> loc <name> i32 <int> loc <name> i32 <int> ret <op>
; Locals are sorted by name. Whitespace in the input is not part of the bytes.
; SHA-256 covers only that byte string. The current one-block padder and
; test suite cover messages shorter than 56 bytes (the locked sample is
; 41 bytes) and do not yet exercise multi-block inputs. SHA-256 itself
; is not limited to one block. The backend_called flag is never set.

pub struct IrVerdict {
    status : u8,
    at : u16,
    backend_called : u8,
    n : u16,
    h0 : u32,
    raw : [80]u8,
}

pub struct Tok {
    at : u16,
    n : u8,
    next : u16,
}

fn blank_verdict() -> IrVerdict {
    var v : IrVerdict;
    v.status = CODE_STRUCTURAL;
    v.at = 0;
    v.backend_called = 0;
    v.n = 0;
    v.h0 = 0;
    var i : u8 = 0;
    while (i < 80) { v.raw[i] = 0; i = i + 1; }
    return v;
}

fn is_ws(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13;
}

fn skip_ws(text: []const u8, i: usize) -> usize {
    var j : usize = i;
    while (j < text.len and is_ws(text[j])) { j = j + 1; }
    return j;
}

fn read_tok(text: []const u8, i: usize, tok: []u8) -> Tok {
    var t : Tok;
    var j : usize = skip_ws(text, i);
    t.at = j as u16;
    var n : u8 = 0;
    while (j < text.len and is_ws(text[j]) == false) {
        if (n < 16) { tok[n] = text[j]; }
        if (n < 255) { n = n + 1; }
        j = j + 1;
    }
    t.n = n;
    t.next = j as u16;
    return t;
}

fn tok_is(tok: []const u8, n: u8, s: str) -> bool {
    if ((n as usize) != s.len) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (tok[i] != s[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn is_num(tok: []const u8, n: u8) -> bool {
    if (n == 0 or n > 9) { return false; }
    var i : u8 = 0;
    while (i < n) {
        if (tok[i] < 48 or tok[i] > 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn num_val(tok: []const u8, n: u8) -> u32 {
    var v : u32 = 0;
    var i : u8 = 0;
    while (i < n) {
        v = v * 10 + ((tok[i] - 48) as u32);
        i = i + 1;
    }
    return v;
}

fn copy_name(dst: []u8, tok: []const u8, n: u8) -> bool {
    if (n == 0 or n > 8) { return false; }
    var i : u8 = 0;
    while (i < n) { dst[i] = tok[i]; i = i + 1; }
    while (i < 8) { dst[i] = 0; i = i + 1; }
    return true;
}

fn name_gt(a: []const u8, an: u8, b: []const u8, bn: u8) -> bool {
    var i : u8 = 0;
    var n : u8 = an;
    if (bn < n) { n = bn; }
    while (i < n) {
        if (a[i] > b[i]) { return true; }
        if (a[i] < b[i]) { return false; }
        i = i + 1;
    }
    return an > bn;
}

fn forbidden_code(tok: []const u8, n: u8) -> u8 {
    if (tok_is(tok, n, "provenance")) { return CODE_PROVENANCE; }
    if (tok_is(tok, n, "uninit")) { return CODE_UNINIT; }
    if (tok_is(tok, n, "race")) { return CODE_RACE; }
    if (tok_is(tok, n, "oob")) { return CODE_OOB; }
    if (tok_is(tok, n, "overflow_ub")) { return CODE_OVERFLOW_UB; }
    if (tok_is(tok, n, "goto")) { return CODE_GOTO; }
    if (tok_is(tok, n, "setjmp")) { return CODE_SETJMP; }
    if (tok_is(tok, n, "longjmp")) { return CODE_SETJMP; }
    if (tok_is(tok, n, "variadic")) { return CODE_VARIADIC; }
    if (tok_is(tok, n, "struct")) { return CODE_STRUCT; }
    if (tok_is(tok, n, "spawn")) { return CODE_CONCURRENCY; }
    if (tok_is(tok, n, "thread")) { return CODE_CONCURRENCY; }
    if (tok_is(tok, n, "eval_order")) { return CODE_EVAL_ORDER; }
    if (tok_is(tok, n, "impl_defined")) { return CODE_IMPL; }
    if (tok_is(tok, n, "ptr")) { return CODE_PTR; }
    return 0;
}

fn version_kind(tok: []const u8, n: u8) -> u8 {
    if (tok_is(tok, n, "v1") or tok_is(tok, n, "t27_ir_v1")) { return 1; }
    if (n >= 2 and tok[0] == 118 and tok[1] >= 48 and tok[1] <= 57) { return 2; }
    if (n >= 3 and tok[0] == 116 and tok[1] == 50 and tok[2] == 55) { return 2; }
    return 0;
}

fn op_ok(tok: []const u8, n: u8) -> bool {
    if (tok_is(tok, n, "add")) { return true; }
    if (tok_is(tok, n, "sub")) { return true; }
    if (tok_is(tok, n, "mul")) { return true; }
    if (tok_is(tok, n, "div")) { return true; }
    return false;
}

pub fn reason(code: u8) -> str {
    if (code == CODE_OK) { return "OK"; }
    if (code == CODE_VERSION) { return DIAG_VERSION; }
    if (code == CODE_PROVENANCE) { return DIAG_PROVENANCE; }
    if (code == CODE_UNINIT) { return DIAG_UNINIT_READ; }
    if (code == CODE_RACE) { return DIAG_DATA_RACE; }
    if (code == CODE_OOB) { return DIAG_OUT_OF_BOUNDS; }
    if (code == CODE_OVERFLOW_UB) { return DIAG_SIGNED_OVERFLOW_UB; }
    if (code == CODE_GOTO) { return DIAG_GOTO; }
    if (code == CODE_SETJMP) { return DIAG_SETJMP_LONGJMP; }
    if (code == CODE_VARIADIC) { return DIAG_VARIADIC; }
    if (code == CODE_STRUCT) { return DIAG_COMPLEX_STRUCT; }
    if (code == CODE_CONCURRENCY) { return DIAG_CONCURRENCY; }
    if (code == CODE_EVAL_ORDER) { return DIAG_UNSPECIFIED_EVAL_ORDER; }
    if (code == CODE_IMPL) { return DIAG_IMPL_DEFINED; }
    if (code == CODE_PTR) { return DIAG_SCALAR_POINTER; }
    if (code == CODE_STRUCTURAL) { return DIAG_STRUCTURAL; }
    if (code == CODE_TYPE) { return DIAG_TYPE; }
    if (code == CODE_OP) { return DIAG_OP; }
    return DIAG_STRUCTURAL;
}

pub fn hash_canonical(msg: []const u8) -> [8]u32 {
    var block : [64]u8 = [0; 64];
    var i : usize = 0;
    while (i < msg.len and i < 55) { block[i] = msg[i]; i = i + 1; }
    block[msg.len] = 0x80;
    var bits : u32 = (msg.len as u32) * 8;
    block[63] = (bits & 255) as u8;
    block[62] = ((bits >> 8) & 255) as u8;
    return sha256_one_block(iv(), block);
}

fn put_name(buf: []u8, w: usize, name: []const u8, n: u8) -> usize {
    var i : u8 = 0;
    while (i < n) { buf[w + (i as usize)] = name[i]; i = i + 1; }
    return w + (n as usize);
}

fn emit_canon(fnm: []const u8, fnn: u8, a: []const u8, an: u8, ai: u32, b: []const u8, bn: u8, bi: u32, op: []const u8, opn: u8) -> IrVerdict {
    var v : IrVerdict = blank_verdict();
    var buf : [80]u8 = [0; 80];
    var w : usize = 0;
    w = put_bytes(buf[0..80], w, "v1 fn ");
    w = put_name(buf[0..80], w, fnm, fnn);
    w = put_bytes(buf[0..80], w, " loc ");
    w = put_name(buf[0..80], w, a, an);
    w = put_bytes(buf[0..80], w, " i32 ");
    w = put_dec(buf[0..80], w, ai as u64);
    w = put_bytes(buf[0..80], w, " loc ");
    w = put_name(buf[0..80], w, b, bn);
    w = put_bytes(buf[0..80], w, " i32 ");
    w = put_dec(buf[0..80], w, bi as u64);
    w = put_bytes(buf[0..80], w, " ret ");
    w = put_name(buf[0..80], w, op, opn);
    if (w >= 56) {
        v.status = CODE_STRUCTURAL;
        return v;
    }
    var i : usize = 0;
    while (i < w) { v.raw[i] = buf[i]; i = i + 1; }
    v.n = w as u16;
    var h : [8]u32 = hash_canonical(v.raw[0..w]);
    v.h0 = h[0];
    v.status = CODE_OK;
    v.backend_called = 0;
    return v;
}

pub fn validate(text: []const u8) -> IrVerdict {
    var v : IrVerdict = blank_verdict();
    var pos : usize = 0;
    var stage : u8 = 0;
    var fnm : [8]u8 = [0; 8];
    var fnn : u8 = 0;
    var a : [8]u8 = [0; 8];
    var an : u8 = 0;
    var ai : u32 = 0;
    var ap : u8 = 0;
    var b : [8]u8 = [0; 8];
    var bn : u8 = 0;
    var bi : u32 = 0;
    var bp : u8 = 0;
    var locs : u8 = 0;
    var saw_ret : u8 = 0;
    var op : [8]u8 = [0; 8];
    var opn : u8 = 0;
    var loc_at : u16 = 0;
    while (pos < text.len) {
        var tok : [16]u8 = [0; 16];
        var t : Tok = read_tok(text, pos, tok[0..16]);
        if (t.n == 0) { break; }
        if (t.n > 16) {
            v.status = CODE_STRUCTURAL;
            v.at = t.at;
            return v;
        }
        var bad : u8 = forbidden_code(tok[0..16], t.n);
        if (bad != 0) {
            v.status = bad;
            v.at = t.at;
            return v;
        }
        if (stage == 0) {
            var vk : u8 = version_kind(tok[0..16], t.n);
            if (vk == 2) { v.status = CODE_VERSION; v.at = t.at; return v; }
            if (vk != 1) { v.status = CODE_STRUCTURAL; v.at = t.at; return v; }
            stage = 1;
        } else if (stage == 1) {
            if (tok_is(tok[0..16], t.n, "fn") == false) { v.status = CODE_STRUCTURAL; v.at = t.at; return v; }
            stage = 2;
        } else if (stage == 2) {
            if (copy_name(fnm[0..8], tok[0..16], t.n) == false) { v.status = CODE_STRUCTURAL; v.at = t.at; return v; }
            fnn = t.n;
            stage = 3;
        } else if (stage == 4) {
            if (locs == 0) {
                if (copy_name(a[0..8], tok[0..16], t.n) == false) { v.status = CODE_STRUCTURAL; v.at = t.at; return v; }
                an = t.n;
            } else {
                if (copy_name(b[0..8], tok[0..16], t.n) == false) { v.status = CODE_STRUCTURAL; v.at = t.at; return v; }
                bn = t.n;
            }
            stage = 5;
        } else if (stage == 5) {
            if (tok_is(tok[0..16], t.n, "i32") == false) { v.status = CODE_TYPE; v.at = t.at; return v; }
            stage = 6;
        } else if (stage == 6) {
            if (is_num(tok[0..16], t.n) == false) {
                v.status = CODE_UNINIT;
                v.at = loc_at;
                return v;
            }
            if (locs == 0) { ai = num_val(tok[0..16], t.n); ap = 1; }
            else { bi = num_val(tok[0..16], t.n); bp = 1; }
            locs = locs + 1;
            stage = 3;
        } else if (tok_is(tok[0..16], t.n, "loc")) {
            if (locs >= 2 or saw_ret == 1) { v.status = CODE_STRUCTURAL; v.at = t.at; return v; }
            loc_at = t.at;
            stage = 4;
        } else if (tok_is(tok[0..16], t.n, "ret")) {
            if (saw_ret == 1) { v.status = CODE_STRUCTURAL; v.at = t.at; return v; }
            saw_ret = 1;
            stage = 7;
        } else if (stage == 7) {
            if (op_ok(tok[0..16], t.n) == false) { v.status = CODE_OP; v.at = t.at; return v; }
            if (copy_name(op[0..8], tok[0..16], t.n) == false) { v.status = CODE_OP; v.at = t.at; return v; }
            opn = t.n;
            stage = 8;
        } else {
            v.status = CODE_STRUCTURAL;
            v.at = t.at;
            return v;
        }
        pos = t.next as usize;
    }
    if (fnn == 0 or saw_ret == 0 or opn == 0 or locs != 2) {
        v.status = CODE_STRUCTURAL;
        return v;
    }
    if (ap == 0 or bp == 0) {
        v.status = CODE_UNINIT;
        return v;
    }
    var out : IrVerdict;
    if (name_gt(a[0..8], an, b[0..8], bn)) {
        out = emit_canon(fnm[0..8], fnn, b[0..8], bn, bi, a[0..8], an, ai, op[0..8], opn);
    } else {
        out = emit_canon(fnm[0..8], fnn, a[0..8], an, ai, b[0..8], bn, bi, op[0..8], opn);
    }
    out.backend_called = 0;
    return out;
}

pub fn canon_pair(swap: u8) -> IrVerdict {
    if (swap == 1) {
        return validate("v1 fn add loc b i32 2 loc a i32 1 ret add");
    }
    return validate("v1\nfn   add\nloc a i32 1\nloc b i32 2\nret add");
}

