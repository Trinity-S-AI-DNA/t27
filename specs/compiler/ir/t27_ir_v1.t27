; Conditional wording. Not current claims.
pub const CLAIM_AFTER_C : str = "t27b is a shared backend for t27 and a defined C subset: both frontends lower programs to the t27 IR contract, which t27b lowers to AArch64 object code.";
pub const CLAIM_AFTER_C_FRONTEND_IS_CURRENT : u8 = 0;
pub const CLAIM_AFTER_C_RUST_ZIG : str = "t27b is a shared backend for t27 and defined C, Rust, and Zig subsets.";
pub const CLAIM_AFTER_C_RUST_ZIG_IS_CURRENT : u8 = 0;

; --- Frontends. Plan only. None exist. ---------------------------------
; c2t27: scalar functions, arithmetic, branches, loops, fixed arrays.
; rust2t27: fn, integer/bool, if, loops, slices/arrays without borrow complexity.
; zig2t27: functions, integers, control flow, arrays.
; go2t27: functions, integers, control flow, arrays; no goroutines and no GC.
; py2t27: typed subset: functions, ints, bools, loops; no dynamic objects and no GC.
; Full Rust, Go, and Python (runtime, allocation, GC, async, traits, closures)
; are separate projects, not this backend experiment.
pub const FRONTEND_C_EXISTS : u8 = 0;
pub const FRONTEND_RUST_EXISTS : u8 = 0;
pub const FRONTEND_ZIG_EXISTS : u8 = 0;
pub const FRONTEND_GO_EXISTS : u8 = 0;
pub const FRONTEND_PYTHON_EXISTS : u8 = 0;
pub const T27B_PARSES_FOREIGN_SOURCE : u8 = 0;
pub const T27B_READS_T27_IR_V1 : u8 = 0;
pub const T27B_VALIDATES_T27_IR_V1 : u8 = 0;
pub const ZIG_ANY_FILE_TO_T27 : u8 = 0;
pub const ZIG_APPROXIMATE_TRANSLATION : u8 = 0;
pub const ZIG_SAME_SOURCE_TEXT_REQUIRED : u8 = 0;
