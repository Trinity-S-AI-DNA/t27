; --- C-subset MVP. First implementation target. Not done. --------------
; C subset -> c2t27 -> t27 IR -> t27b -> AArch64 object -> run -> checksum
; First support, when implemented: int, unsigned, bool; functions and
; calls; arithmetic and comparisons; if, while, for; local variables;
; fixed-size arrays.
; Scalar pointers are conditional on an AAPCS64 export, and are not in
; the first subset. Checked on master cli/t27b/src/ir.rs (be7934fe53):
; integer, bool, f32, and f64 scalars use AAPCS64 registers. Ty::Ptr is
; documented as never a value of the language. Lowering makes it for
; aggregates, hidden parameters, offsets, and loads. No external
; AAPCS64 contract for a C scalar pointer parameter was found, so
; pointers stay out until that contract exists.
; Explicitly out of the first subset: varargs, dynamic allocation,
; structs with complex layout, undefined behavior, concurrency,
; exceptions.
pub const C2T27_MVP_IMPLEMENTED : u8 = 0;
pub const C2T27_SCALAR_POINTERS_IN_MVP : u8 = 0;
pub const C2T27_SCALAR_POINTERS_CONDITIONAL_ON_AAPCS64 : u8 = 1;
pub const MVP_INCLUDES_VARARGS : u8 = 0;
pub const MVP_INCLUDES_ALLOC : u8 = 0;
pub const MVP_INCLUDES_COMPLEX_STRUCTS : u8 = 0;
pub const MVP_INCLUDES_UB : u8 = 0;
pub const MVP_INCLUDES_CONCURRENCY : u8 = 0;
pub const MVP_INCLUDES_EXCEPTIONS : u8 = 0;

; --- Measurement rules. No numbers are recorded here. ------------------
; Separate times: frontend, backend, total compile, object size, runtime,
; output checksum, dynamic instructions, declared runtime checks.
; end_to_end_compile_ms = frontend_ms + t27b_backend_ms + link_ms
; Link time, when a link exists, is its own row. It is not part of t27b build.
; On a source-to-source path, emitter time is its own row. It is not
; t27b backend time and it is not folded into t27b build.
; Unmeasured record for each future path: input test, expected output
; hash, frontend time, t27b or emitter time, end-to-end compile time,
; object or binary size, runtime, declared runtime-check policy,
; differential result against the native toolchain. Not measured.
; First benchmarks, names only, not measured:
;   int_add, loop_sum, fib_iterative, array_sum, fixed_filter.
; No floating point, SIMD, concurrency, allocation, or dynamic dispatch
; in that first set.
; Article table, empty until a frontend exists (every cell is "not measured"):
;   Pipeline | Frontend | Backend | Total compile | Object | Runtime | Output
;   C -> clang -O2          | not measured | ... | checksum column, not measured
;   C -> t27 IR -> t27b     | not measured | ... | checksum column, not measured
;   t27 -> t27b             | N/A          | not measured | ... | checksum, not measured
; IR source column, conceptual: C frontend -> t27 IR, versus t27 source -> t27 IR.
; Neither column has been measured.
pub const BENCH_INT_ADD_MEASURED : u8 = 0;
pub const BENCH_LOOP_SUM_MEASURED : u8 = 0;
pub const BENCH_FIB_ITERATIVE_MEASURED : u8 = 0;
pub const BENCH_ARRAY_SUM_MEASURED : u8 = 0;
pub const BENCH_FIXED_FILTER_MEASURED : u8 = 0;
pub const LINK_TIME_HIDDEN_IN_T27B_BUILD : u8 = 0;

