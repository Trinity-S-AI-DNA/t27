// specs/compiler/seal_stale.t27 -- seals: stale on master: 126 gen-drift and 9
// stale make coverage and spec-guards red.
// Part of M2 milestone (milestone #6). Closes #12972.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::seal_stale;

pub const SEAL_STALE_MAX_SPECS : u32 = 1024;

pub struct SealRecord { name: str, stale: bool };

pub fn seal_stale_is_stale(s: SealRecord) -> bool {
    return s.stale;
}

test "seal_stale_is_stale" {
    assert(seal_stale_is_stale(SealRecord { name: "seal-1", stale: true }));
    assert(!seal_stale_is_stale(SealRecord { name: "seal-2", stale: false }));
}

invariant seal_stale_max_specs_positive {
    assert SEAL_STALE_MAX_SPECS > 0;
}