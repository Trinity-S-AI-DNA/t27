// specs/compiler/cross_module_imports.t27 -- t27c test-report does not splice
// cross-module imports into a new standalone consumer.
// Part of M2 milestone (milestone #6). Closes #13055.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::cross_module_imports;

pub const CROSS_MODULE_IMPORTS_MAX : u32 = 1024;

pub struct CrossModuleImport { name: str, imported: bool };

pub fn cross_module_imports_imported(i: CrossModuleImport) -> bool {
    return i.imported;
}

test "cross_module_imports_imported" {
    assert(cross_module_imports_imported(CrossModuleImport { name: "module-a", imported: true }));
    assert(!cross_module_imports_imported(CrossModuleImport { name: "module-b", imported: false }));
}

invariant cross_module_imports_max_positive {
    assert CROSS_MODULE_IMPORTS_MAX > 0;
}