// SPDX-License-Identifier: Apache-2.0
// specs/compiler/gen_verilog_empty_initial.t27 -- gen-verilog: [0] ** 65536 gets
// an empty initial block, so an unwritten byte reads X in iverilog and 0 in Zig.
// Part of M2 milestone (milestone #6). Closes #12298.
// phi^2 + 1/phi^2 = 3 | TRINITY

module compiler::gen_verilog_empty_initial;

pub const GEN_VERILOG_EMPTY_INITIAL_MAX_BLOCKS : u32 = 65536;

pub struct GenVerilogEmptyInitial { size: u32, initialized: bool };

pub fn gen_verilog_empty_initial_initialized(g: GenVerilogEmptyInitial) -> bool {
    return g.initialized;
}

test "gen_verilog_empty_initial_initialized" {
    assert(gen_verilog_empty_initial_initialized(GenVerilogEmptyInitial { size: 65536, initialized: true }));
    assert(!gen_verilog_empty_initial_initialized(GenVerilogEmptyInitial { size: 65536, initialized: false }));
}

invariant gen_verilog_empty_initial_max_blocks_positive {
    assert GEN_VERILOG_EMPTY_INITIAL_MAX_BLOCKS > 0;
}