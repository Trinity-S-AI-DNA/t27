// config/schema.t27 — Config Schema Specification
// Configuration structures for providers, agents, LSP
// φ² + 1/φ² = 3 | TRINITY

module config-schema;

// ============================================================================
// Imports
// ============================================================================

// ============================================================================
// Constants
// ============================================================================

/// Default configuration file name
pub const DEFAULT_CONFIG_FILE : []const u8 = "config.json";

/// Default environment file name
pub const DEFAULT_ENV_FILE : []const u8 = ".env";

/// Default LLM provider
pub const DEFAULT_PROVIDER : []const u8 = "anthropic";

/// Default LLM model
pub const DEFAULT_MODEL : []const u8 = "claude-sonnet-4-20250514";

/// Maximum API key length
pub const MAX_API_KEY_LENGTH : u16 = 256;

/// Maximum agent name length
pub const MAX_AGENT_NAME_LENGTH : u16 = 128;

/// Maximum timeout in seconds
pub const MAX_TIMEOUT_SEC : u16 = 300;

/// Default request timeout in seconds
pub const DEFAULT_TIMEOUT_SEC : u16 = 30;

/// Default max tokens per request
pub const DEFAULT_MAX_TOKENS : u32 = 4096;

/// Default temperature for sampling
pub const DEFAULT_TEMPERATURE : f64 = 0.7;

/// Provider type enum
pub const ProviderType = enum(u8) {
    anthropic = 0,
    openai = 1,
    custom = 2,
};

/// Agent capability enum
pub const AgentCapability = enum(u8) {
    chat = 0,
    code_edit = 1,
    file_operation = 2,
    web_search = 3,
    execute = 4,
};

// ============================================================================
// Types
// ============================================================================

/// Provider configuration
pub const ProviderConfig = struct {
    name : ProviderType,
    api_key : []const u8,
    base_url : []const u8,
    model : []const u8,
    max_tokens : u32,
    timeout_sec : u16,
    temperature : f64,
};

/// Agent configuration
pub const AgentConfig = struct {
    name : []const u8,
    description : []const u8,
    capabilities : []AgentCapability,
    system_prompt : []const u8,
    model_override : ?[]const u8,
    enabled : bool,
};

/// MCP server configuration
pub const MCPServerConfig = struct {
    name : []const u8,
    command : []const u8,
    args : [][]const u8,
    timeout_sec : u16,
    enabled : bool,
};

/// LSP configuration
pub const LSPConfig = struct {
    enabled : bool,
    language_servers : []LanguageServer,
    workspace_roots : []const u8,
    initialization_options : []const u8,
    timeout_sec : u16,
};

/// Language server configuration
pub const LanguageServer = struct {
    language : []const u8,  // e.g., "t27", "zig", "python"
    command : []const u8,
    args : [][]const u8,
    workspace_root : ?[]const u8,
};

/// TUI configuration
pub const TuiConfig = struct {
    theme : []const u8,
    keybindings : []Keybinding,
    mouse_enabled : bool,
    confirm_dangerous : bool,
    timeout_ms : u32,
};

/// Keybinding definition
pub const Keybinding = struct {
    name : []const u8,
    keys : []const u8,
    action : []const u8,
};

/// Logging configuration
pub const LoggingConfig = struct {
    level : []const u8,  // "debug", "info", "warn", "error"
    file : ?[]const u8,  // File path, null for stdout
    format : []const u8,  // "json", "text"
    max_size_mb : u16,
};

/// File paths configuration
pub const PathsConfig = struct {
    config_dir : []const u8,
    data_dir : []const u8,
    cache_dir : []const u8,
    log_dir : []const u8,
};

/// Main configuration structure
pub const Config = struct {
    version : u16,
    provider : ProviderConfig,
    agents : []AgentConfig,
    mcp_servers : []MCPServerConfig,
    lsp : LSPConfig,
    tui : TuiConfig,
    logging : LoggingConfig,
    paths : PathsConfig,
};

/// Config validation result
pub const ValidationResult = struct {
    valid : bool,
    errors : []ConfigError,
};

/// Configuration error
pub const ConfigError = struct {
    field : []const u8,
    message : []const u8,
    severity : []const u8,
};

// ============================================================================
// Functions
// ============================================================================

// ============================================================================
// Storage
// ============================================================================

// The backend has no allocation, so every collection a config holds lives in a module-level
// buffer and is handed out as a slice of it. Only one config is live at a time: the buffers
// are shared, and a slice stays valid until the next call that writes to the same buffer.
var agents_storage : [16]AgentConfig = undefined;
var capabilities_storage : [1]AgentCapability = undefined;
var mcp_servers_storage : [1]MCPServerConfig = undefined;
var language_servers_storage : [1]LanguageServer = undefined;
var keybindings_storage : [1]Keybinding = undefined;
var errors_storage : [1]ConfigError = undefined;
var string_arena : [4096]u8 = undefined;
var string_arena_len : usize = 0;

/// Reserve len bytes in the string arena and return the offset of the reservation
fn string_arena_reserve(len: usize) usize {
    if (string_arena_len + len > 4096) {
        string_arena_len = 0;
    }
    // (No local copy of string_arena_len: the backend inlines the copy and would return
    // the already-advanced value.)
    string_arena_len = string_arena_len + len;
    return string_arena_len - len;
}

// ============================================================================
// Functions
// ============================================================================

/// Create default provider config
pub fn provider_default() ProviderConfig {
    return ProviderConfig{
        .name = .anthropic,
        .api_key = "",
        .base_url = "",
        .model = DEFAULT_MODEL,
        .max_tokens = DEFAULT_MAX_TOKENS,
        .timeout_sec = DEFAULT_TIMEOUT_SEC,
        .temperature = DEFAULT_TEMPERATURE,
    };
}

/// Create provider with API key
pub fn provider_with_key(api_key: []const u8) ProviderConfig {
    const base = provider_default();
    return ProviderConfig{ .name = base.name, .api_key = api_key, .base_url = base.base_url, .model = base.model, .max_tokens = base.max_tokens, .timeout_sec = base.timeout_sec, .temperature = base.temperature };
}

/// Create default agent config
pub fn agent_default(name: []const u8) AgentConfig {
    capabilities_storage[0] = .chat;
    return AgentConfig{
        .name = name,
        .description = "",
        .capabilities = capabilities_storage[0..1],
        .system_prompt = "",
        .model_override = null,
        .enabled = true,
    };
}

/// Create agent with capabilities
pub fn agent_with_capabilities(name: []const u8, capabilities: []AgentCapability) AgentConfig {
    const base = agent_default(name);
    return AgentConfig{ .name = base.name, .description = base.description, .capabilities = capabilities, .system_prompt = base.system_prompt, .model_override = base.model_override, .enabled = base.enabled };
}

/// Create LSP server config
pub fn lsp_server_create(language: []const u8, command: []const u8, args: [][]const u8) LanguageServer {
    return LanguageServer{
        .language = language,
        .command = command,
        .args = args,
        .workspace_root = null,
    };
}

/// Create default TUI config (no keybindings)
pub fn tui_default() TuiConfig {
    return TuiConfig{
        .theme = "dark",
        .keybindings = keybindings_storage[0..0],
        .mouse_enabled = true,
        .confirm_dangerous = true,
        .timeout_ms = 5000,
    };
}

/// Create default logging config
pub fn logging_default() LoggingConfig {
    return LoggingConfig{
        .level = "info",
        .file = null,
        .format = "text",
        .max_size_mb = 100,
    };
}

/// Create default paths config
pub fn paths_default() PathsConfig {
    return PathsConfig{
        .config_dir = "",
        .data_dir = "",
        .cache_dir = "",
        .log_dir = "",
    };
}

/// Create default config: no agents, no MCP servers, no language servers
pub fn config_default() Config {
    return Config{
        .version = 1,
        .provider = provider_default(),
        .agents = agents_storage[0..0],
        .mcp_servers = mcp_servers_storage[0..0],
        .lsp = LSPConfig{ .enabled = false, .language_servers = language_servers_storage[0..0], .workspace_roots = "", .initialization_options = "", .timeout_sec = 30 },
        .tui = tui_default(),
        .logging = logging_default(),
        .paths = paths_default(),
    };
}

/// Create validation result with success
pub fn validation_success() ValidationResult {
    return ValidationResult{
        .valid = true,
        .errors = errors_storage[0..0],
    };
}

/// Create validation result with errors
pub fn validation_failure(errors: []ConfigError) ValidationResult {
    return ValidationResult{
        .valid = false,
        .errors = errors,
    };
}

/// Create config error
pub fn error_create(field: []const u8, message: []const u8) ConfigError {
    return ConfigError{
        .field = field,
        .message = message,
        .severity = "error",
    };
}

/// Create config error with severity
pub fn error_with_severity(field: []const u8, message: []const u8, severity: []const u8) ConfigError {
    return ConfigError{
        .field = field,
        .message = message,
        .severity = severity,
    };
}

/// Check if provider is Anthropic
pub fn is_anthropic(provider: ProviderConfig) bool {
    // (Through a typed local: the backend reads `.name ==` as a string compare.)
    const kind : ProviderType = provider.name;
    return kind == .anthropic;
}

/// Check if provider is OpenAI
pub fn is_openai(provider: ProviderConfig) bool {
    // (Through a typed local: the backend reads `.name ==` as a string compare.)
    const kind : ProviderType = provider.name;
    return kind == .openai;
}

/// Check if provider is custom
pub fn is_custom(provider: ProviderConfig) bool {
    // (Through a typed local: the backend reads `.name ==` as a string compare.)
    const kind : ProviderType = provider.name;
    return kind == .custom;
}

/// Check if API key is present
pub fn has_api_key(provider: ProviderConfig) bool {
    return provider.api_key.len > 0;
}

/// Check if agent has capability
pub fn agent_has_capability(agent: AgentConfig, capability: AgentCapability) bool {
    for (agent.capabilities) |cap| {
        if (cap == capability) {
            return true;
        }
    }
    return false;
}

/// Check if LSP is enabled
pub fn lsp_is_enabled(config: Config) bool {
    return config.lsp.enabled;
}

/// Add agent to config (at most 16 agents; a 17th is ignored)
pub fn config_add_agent(config: *Config, agent: AgentConfig) void {
    config.agents = append_agents(config.agents, agent);
}

/// Remove agent from config
pub fn config_remove_agent(config: *Config, index: usize) void {
    if (index < config.agents.len) {
        // Shift the elements after index down by one, then drop the last slot
        var i : usize = index;
        while (i + 1 < config.agents.len) {
            config.agents[i] = config.agents[i + 1];
            i = i + 1;
        }
        config.agents = config.agents[0 .. config.agents.len - 1];
    }
}

/// Get agent count
pub fn config_agent_count(config: *const Config) usize {
    return config.agents.len;
}

/// Append agents to slice: the result lives in agents_storage
pub fn append_agents(slice: []AgentConfig, item: AgentConfig) []AgentConfig {
    var len : usize = slice.len;
    if (len >= 16) {
        return slice;
    }
    var i : usize = 0;
    while (i < len) {
        agents_storage[i] = slice[i];
        i = i + 1;
    }
    agents_storage[len] = item;
    return agents_storage[0 .. len + 1];
}

/// Append agents slice
pub fn append_agents_slice(slice: []AgentConfig, item: AgentConfig) []AgentConfig {
    return append_agents(slice, item);
}

/// Concatenate agents
pub fn concat_agents(a: []AgentConfig, b: AgentConfig) []AgentConfig {
    return append_agents(a, b);
}

/// Concat byte to string: a followed by b, copied into the string arena
pub fn concat_string(a: []const u8, b: []const u8) []const u8 {
    var start = string_arena_reserve(a.len + b.len);
    var i : usize = 0;
    while (i < a.len) {
        string_arena[start + i] = a[i];
        i = i + 1;
    }
    var j : usize = 0;
    while (j < b.len) {
        string_arena[start + a.len + j] = b[j];
        j = j + 1;
    }
    return string_arena[start .. start + a.len + b.len];
}

/// Append byte to string
pub fn append_byte(slice: []const u8, byte: u8) []const u8 {
    var start = string_arena_reserve(slice.len + 1);
    var i : usize = 0;
    while (i < slice.len) {
        string_arena[start + i] = slice[i];
        i = i + 1;
    }
    string_arena[start + slice.len] = byte;
    return string_arena[start .. start + slice.len + 1];
}

// ============================================================================
// TDD - Tests
// ============================================================================

test "config_provider_default" {
    const provider = provider_default();
    assert(is_anthropic(provider));
}

test "config_provider_with_key" {
    const provider = provider_with_key("sk-api-key");
    assert(has_api_key(provider));
    assert(is_anthropic(provider));
    assert(provider.api_key == "sk-api-key");
}

test "config_agent_default" {
    const agent = agent_default("test-agent");
    assert(agent.name == "test-agent");
}

test "config_agent_with_capabilities" {
    var caps : [2]AgentCapability = undefined;
    caps[0] = .chat;
    caps[1] = .code_edit;
    const agent = agent_with_capabilities("test", caps[0 .. 2]);
    assert(agent_has_capability(agent, .chat));
    assert(agent_has_capability(agent, .code_edit));
}

test "config_lsp_server_create" {
    var args : [1]str = undefined;
    args[0] = "";
    const lsp = lsp_server_create("t27", "t27c", args[0 .. 1]);
    assert(lsp.language == "t27");
}

test "config_tui_default" {
    const tui = tui_default();
    assert(tui.theme == "dark");
}

test "config_logging_default" {
    const logging = logging_default();
    assert(logging.level == "info");
}

test "config_paths_default" {
    const paths = paths_default();
    assert(paths.data_dir.len == 0);
}

test "config_default_complete" {
    const config = config_default();
    assert(config.version == 1);
}

test "config_validation_success" {
    const result = validation_success();
    assert(result.valid);
}

test "config_validation_failure" {
    const config_error = error_create("api_key", "API key is required");
    var errs : [1]ConfigError = undefined;
    errs[0] = config_error;
    const result = validation_failure(errs[0 .. 1]);
    assert(!result.valid);
    assert(result.errors.len == 1);
    assert(result.errors[0].field == "api_key");
}

test "config_add_agent" {
    var config = config_default();
    const agent = agent_default("new-agent");
    config_add_agent(&config, agent);
    assert(config_agent_count(&config) == 1);
    assert(config.agents[0].name == "new-agent");
}

test "config_remove_agent" {
    var config = config_default();
    const agent = agent_default("test-agent");
    config_add_agent(&config, agent);
    assert(config_agent_count(&config) == 1);
    config_remove_agent(&config, 0);
    assert(config_agent_count(&config) == 0);
}

test "config_agent_has_capability_true" {
    var caps : [2]AgentCapability = undefined;
    caps[0] = .chat;
    caps[1] = .code_edit;
    const agent = agent_with_capabilities("test", caps[0 .. 2]);
    assert(agent_has_capability(agent, .code_edit));
}

test "config_agent_has_capability_false" {
    var caps : [1]AgentCapability = undefined;
    caps[0] = .chat;
    const agent = agent_with_capabilities("test", caps[0 .. 1]);
    assert(!agent_has_capability(agent, .code_edit));
}

// ============================================================================
// TDD - Invariants
// ============================================================================

invariant max_api_key_length_positive {
    // MAX_API_KEY_LENGTH is positive
    @compileAssert(MAX_API_KEY_LENGTH > 0);
}

invariant max_agent_name_length_positive {
    // MAX_AGENT_NAME_LENGTH is positive
    @compileAssert(MAX_AGENT_NAME_LENGTH > 0);
}

invariant max_timeout_positive {
    // MAX_TIMEOUT_SEC is positive
    @compileAssert(MAX_TIMEOUT_SEC > 0);
}

invariant provider_type_enum_valid {
    // ProviderType enum has valid values
    @compileAssert(@intFromEnum(ProviderType.custom) == 2);
}

invariant capability_enum_valid {
    // AgentCapability enum has valid values
    @compileAssert(@intFromEnum(AgentCapability.execute) == 4);
}

invariant provider_config_has_name {
    // ProviderConfig has name field
    @compileAssert(true);
}

invariant provider_config_has_api_key {
    // ProviderConfig has api_key field
    @compileAssert(true);
}

invariant provider_config_has_model {
    // ProviderConfig has model field
    @compileAssert(true);
}

invariant agent_config_has_name {
    // AgentConfig has name field
    @compileAssert(true);
}

invariant agent_config_has_capabilities {
    // AgentConfig has capabilities array
    @compileAssert(true);
}

invariant lsp_config_has_enabled {
    // LSPConfig has enabled field
    @compileAssert(true);
}

invariant tui_config_has_theme {
    // TuiConfig has theme field
    @compileAssert(true);
}

invariant logging_config_has_level {
    // LoggingConfig has level field
    @compileAssert(true);
}

invariant paths_config_has_dirs {
    // PathsConfig has directory fields
    @compileAssert(true);
}

invariant config_has_version {
    // Config has version field
    @compileAssert(true);
}

invariant validation_result_has_valid {
    // ValidationResult has valid boolean
    @compileAssert(true);
}

invariant validation_result_has_errors {
    // ValidationResult has errors array
    @compileAssert(true);
}

invariant config_error_has_fields {
    // ConfigError has all required fields
    @compileAssert(true);
}

// ============================================================================
// TDD - Tests
// ============================================================================

test "config_provider_create" {
    const provider = provider_default();
    assert(is_anthropic(provider));
}














// ============================================================================
// TDD - Benchmarks
// ============================================================================

bench "config_provider_create_latency" {
    // Measure: cycles for provider config creation
    // Target: < 100 cycles
    @setEvalBranchQuota(10000);
    var result : ProviderConfig = undefined;
    for (0..1000) |_| {
        result = provider_default();
    }
    _ = result.max_tokens;
}

bench "config_agent_create_latency" {
    // Measure: cycles for agent config creation
    // Target: < 50 cycles
    @setEvalBranchQuota(10000);
    var result : AgentConfig = undefined;
    for (0..1000) |_| {
        result = agent_default("test");
    }
    _ = result.capabilities.len;
}

bench "config_validation_success_latency" {
    // Measure: cycles for validation success result
    // Target: < 20 cycles
    @setEvalBranchQuota(10000);
    var result : ValidationResult = undefined;
    for (0..1000) |_| {
        result = validation_success();
    }
    _ = result.valid;
}

bench "config_capability_check_latency" {
    // Measure: cycles for capability check
    // Target: < 30 cycles
    @setEvalBranchQuota(10000);
    const caps = &[_]AgentCapability{.chat, .code_edit};
    const agent = agent_with_capabilities("test", caps);
    var result : bool = false;
    for (0..1000) |_| {
        result = agent_has_capability(agent, .code_edit);
    }
    _ = result;
}
