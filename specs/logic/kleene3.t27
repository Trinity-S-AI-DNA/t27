// specs/logic/kleene3.t27 -- one Kleene conjunction for the two sieves.
// specs/compiler/theory/sieve.t27 and specs/t27f/sieve_design_law.t27 both
// encode FALSE/MISSING = 0, UNKNOWN/PARTIAL = 1, TRUE/PRESENT = 2, NA = 3,
// and NA never removes (it reads as TRUE/PRESENT). The min of the two
// adjusted values was copied; this module is that body, once.
// Refs #13499
// phi^2 + 1/phi^2 = 3 | TRINITY

module LogicKleene3;

pub const K_FALSE : u8 = 0;
pub const K_MID : u8 = 1;
pub const K_TRUE : u8 = 2;
pub const K_NA : u8 = 3;

pub fn kleene_as(v: u8) -> u8 {
    if (v == K_NA) { return K_TRUE; }
    return v;
}

pub fn kleene_and(a: u8, b: u8) -> u8 {
    var x : u8 = kleene_as(a);
    var y : u8 = kleene_as(b);
    if (x < y) { return x; }
    return y;
}

test kleene_and_keeps_the_lower_value {
    assert kleene_and(K_FALSE, K_TRUE) == K_FALSE;
    assert kleene_and(K_TRUE, K_MID) == K_MID;
    assert kleene_and(K_MID, K_MID) == K_MID;
    assert kleene_and(K_NA, K_FALSE) == K_FALSE;
    assert kleene_and(K_NA, K_TRUE) == K_TRUE;
    assert kleene_and(K_NA, K_NA) == K_TRUE;
}

invariant na_reads_as_true {
    assert kleene_as(K_NA) == K_TRUE;
    assert kleene_as(K_FALSE) == K_FALSE;
    assert kleene_as(K_MID) == K_MID;
    assert kleene_as(K_TRUE) == K_TRUE;
}
