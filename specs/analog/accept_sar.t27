pub const L_CLK_SLOW_HI_NS : f64 = 50.0;
pub const L_CLK_FAST_LO_NS : f64 = 0.02;
pub const L_CLK_FAST_HI_NS : f64 = 40.0;
pub const L_CLK_RATIO_MIN : f64 = 1.2;
pub const L_CLK_STOP_MAX_NS : f64 = 30.0;
pub const L_SAR_SPAN_LO_NS : f64 = 199.0;
pub const L_SAR_SPAN_HI_NS : f64 = 201.0;
pub const L_DAC_IDLE_LO_V : f64 = 0.7;
pub const L_DAC_IDLE_HI_V : f64 = 0.8;
pub const L_DAC_LEVEL_V : f64 = 0.05;
pub const L_TOP_CODE : u32 = 1430;
pub const L_TOP_PLATE : u32 = 617;
pub const L_NEG_VCM_LO_V : f64 = 0.7;
pub const L_NEG_VCM_HI_V : f64 = 0.8;
