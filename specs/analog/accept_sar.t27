pub const L_INT_STEP_LO_LSB : f64 = 60.0;
pub const L_INT_STEP_HI_LSB : f64 = 250.0;
pub const L_CORNER_INV_LO_PS : f64 = 62.0;
pub const L_CORNER_INV_HI_PS : f64 = 124.0;
pub const L_CORNER_CMP_LO_PS : f64 = 467.0;
pub const L_CORNER_CMP_HI_PS : f64 = 829.0;

; --- what the report measured (the positive controls: its own values must pass its own checks) ----------------------------
pub const R_INV_VTH_V : f64 = 0.69;
pub const R_INV_FALL_PS : f64 = 81.0;
pub const R_INV_RISE_PS : f64 = 100.0;
pub const R_TG_RON_OHM : f64 = 2440.0;
pub const R_TG_RON_WORST_OHM : f64 = 2780.0;
pub const R_TG_LEAK_NA : f64 = 0.29;
pub const R_DFF_C2Q_PS : f64 = 524.0;
pub const R_CMP_DT_PS : f64 = 607.0;
pub const R_SW_HOLD_A_V : f64 = 0.0 - 0.0016;
pub const R_SW_HOLD_B_V : f64 = 0.0 - 0.0017;
pub const R_CLK_SLOW_NS : f64 = 15.0;
pub const R_CLK_FAST_NS : f64 = 9.2;
pub const R_CLK_RATIO : f64 = 1.64;
pub const R_CLK_STOP_NS : f64 = 10.7;
pub const R_INT_FIRST_CODE : u32 = 510;
pub const R_INT_LAST_CODE : u32 = 1593;
pub const R_INT_IDEAL_FIRST : u32 = 517;
pub const R_INT_IDEAL_LAST : u32 = 1579;
pub const R_INT_ERR_LSB : f64 = 13.8;
pub const R_INT_STEP_LSB : f64 = 154.0;
pub const R_INT_IDEAL_STEP_LSB : f64 = 152.0;

; --- the verdict machinery ---------------------------------------------------------------------------------------
/// One row. `measured` is false when our model does not produce the quantity: the row is NOT MODELLED whatever `inside` says, so an unmeasured row is never a PASS.
pub fn as_verdict(measured: bool, inside: bool) -> u32 {
    if (!measured) { return AS_NM; }
    if (inside) { return AS_PASS; }
    return AS_FAIL;
}

/// A row that our model does not produce.
pub fn as_nm() -> u32 {
    return as_verdict(false, true);
}

/// The rows of one block, counted by verdict.
pub struct Blk { pass: u32, fail: u32, nm: u32 }

pub fn as_blk0() -> Blk {
    return Blk { pass: 0, fail: 0, nm: 0 };
}

/// The block with one more row of verdict v.
pub fn as_add(b: Blk, v: u32) -> Blk {
    var p : u32 = b.pass;
    var f : u32 = b.fail;
    var n : u32 = b.nm;
    if (v == AS_PASS) { p = p + 1; }
    if (v == AS_FAIL) { f = f + 1; }
    if (v == AS_NM) { n = n + 1; }
    return Blk { pass: p, fail: f, nm: n };
}

/// A block: FAIL when a row fails, PASS only when it has rows and every row passes, NOT MODELLED otherwise.
pub fn as_block_verdict(b: Blk) -> u32 {
    if (b.fail > 0) { return AS_FAIL; }
    if (b.nm > 0 or b.pass == 0) { return AS_NM; }
    return AS_PASS;
}

; --- the checks: one pure function per quantity of the report, the limit inside ---------------------------------------------
pub fn as_in(v: f64, lo: f64, hi: f64) -> bool {
    return v >= lo and v <= hi;
}

pub fn as_within(v: f64, tol: f64) -> bool {
    return fabs64(v) <= tol;
}

/// inverter: switching threshold 0.5 to 1.0 V.
pub fn as_chk_inv_vth(v: f64) -> bool {
    return as_in(v, L_INV_VTH_LO_V, L_INV_VTH_HI_V);
}

/// inverter: both delays into 20 fF, 1 to 500 ps.
pub fn as_chk_inv_delay(fall_ps: f64, rise_ps: f64) -> bool {
    return as_in(fall_ps, L_INV_DELAY_LO_PS, L_INV_DELAY_HI_PS) and as_in(rise_ps, L_INV_DELAY_LO_PS, L_INV_DELAY_HI_PS);
}

/// nand truth table (codes of sar_logic: SL_S1 for a 1, SL_S0 for a 0) for inputs 00, 01, 10, 11.
pub fn as_chk_nand(c00: usize, c01: usize, c10: usize, c11: usize) -> bool {
    return c00 == SL_S1 and c01 == SL_S1 and c10 == SL_S1 and c11 == SL_S0;
}

/// nor truth table for inputs 00, 01, 10, 11.
pub fn as_chk_nor(c00: usize, c01: usize, c10: usize, c11: usize) -> bool {
    return c00 == SL_S1 and c01 == SL_S0 and c10 == SL_S0 and c11 == SL_S0;
}

/// nand, nor: a 1 is 1.45 to 1.55 V, a 0 is within 50 mV of 0 V.
pub fn as_chk_gate_levels(one_v: f64, zero_v: f64) -> bool {
    return as_in(one_v, L_GATE_ONE_LO_V, L_GATE_ONE_HI_V) and as_within(zero_v, L_GATE_ZERO_V);
}

/// tgate: Ron at 0.75 V at most 30 kohm, the worst Ron over 0.1 to 1.4 V at most 50 kohm, the off leakage at most 1 nA.
pub fn as_chk_tgate(ron_ohm: f64, worst_ohm: f64, leak_na: f64) -> bool {
    return ron_ohm <= L_TG_RON_OHM and worst_ohm <= L_TG_RON_WORST_OHM and leak_na <= L_TG_LEAK_NA;
}

/// dff: edge capture, hold, set and reset all right.
pub fn as_chk_dff_behaviour(capture: bool, hold: bool, set: bool, reset: bool) -> bool {
    return capture and hold and set and reset;
}

/// dff: the levels of the eight observation points within 50 mV of their rail (the worst deviation).
pub fn as_chk_dff_levels(worst_dev_v: f64) -> bool {
    return as_within(worst_dev_v, L_DFF_LEVEL_V);
}

/// dff: clock-to-Q 1 to 3000 ps.
pub fn as_chk_dff_c2q(ps: f64) -> bool {
    return as_in(ps, L_DFF_C2Q_LO_PS, L_DFF_C2Q_HI_PS);
}

/// comparator: +2 mV makes dp win and -2 mV makes dn win (win_p, win_m are 1 where dp wins).
pub fn as_chk_cmp_sign(win_p: u32, win_m: u32) -> bool {
    return win_p == 1 and win_m == 0;
}

/// comparator: after the decision the winner is within 50 mV of 1.5 V and the loser within 50 mV of 0 V.
pub fn as_chk_cmp_levels(hi_v: f64, lo_v: f64) -> bool {
    return as_within(hi_v - 1.5, L_CMP_LEVEL_V) and as_within(lo_v, L_CMP_LEVEL_V);
}

/// comparator: in reset both outputs are within 50 mV of 0 V.
pub fn as_chk_cmp_reset(dp_v: f64, dn_v: f64) -> bool {
    return as_within(dp_v, L_CMP_LEVEL_V) and as_within(dn_v, L_CMP_LEVEL_V);
}

/// comparator: the decision time, 10 to 10000 ps.
pub fn as_chk_cmp_time(ps: f64) -> bool {
    return as_in(ps, L_CMP_DT_LO_PS, L_CMP_DT_HI_PS);
}

/// tracking switch: the tracking error at two input levels within 5 mV.
pub fn as_chk_sw_track(te_a_v: f64, te_b_v: f64) -> bool {
    return as_within(te_a_v, L_SW_TRACK_V) and as_within(te_b_v, L_SW_TRACK_V);
}

/// tracking switch: the hold step at two input levels within 30 mV.
pub fn as_chk_sw_hold(step_a_v: f64, step_b_v: f64) -> bool {
    return as_within(step_a_v, L_SW_HOLD_V) and as_within(step_b_v, L_SW_HOLD_V);
}

/// tracking switch: the droop during the hold within 5 mV.
pub fn as_chk_sw_droop(v: f64) -> bool {
    return as_within(v, L_SW_DROOP_V);
}

/// clock_gen: the slow delay (all trims 0), 0.05 to 50 ns.
pub fn as_chk_clk_slow(ns: f64) -> bool {
    return as_in(ns, L_CLK_SLOW_LO_NS, L_CLK_SLOW_HI_NS);
}

/// clock_gen: the fast delay (all trims 1), 0.02 to 40 ns.
pub fn as_chk_clk_fast(ns: f64) -> bool {
    return as_in(ns, L_CLK_FAST_LO_NS, L_CLK_FAST_HI_NS);
}

/// clock_gen: slow over fast at least 1.2.
pub fn as_chk_clk_ratio(r: f64) -> bool {
    return r >= L_CLK_RATIO_MIN;
}

/// clock_gen: the clock stops at most 30 ns after Valid.
pub fn as_chk_clk_stop(ns: f64) -> bool {
    return ns >= 0.0 and ns <= L_CLK_STOP_MAX_NS;
}

/// SAR_logic: one more CK output high per Valid edge, CK11 first, in order and held; exactly 1, 4 and 11 high after 1, 4 and 11 edges.
pub fn as_chk_sar_count(edge_ok: bool, hold_ok: bool, c1: u32, c4: u32, c11: u32) -> bool {
    return edge_ok and hold_ok and c1 == 1 and c4 == 4 and c11 == 11;
}

/// SAR_logic: CK11 to CK1 in 199 to 201 ns.
pub fn as_chk_sar_span(ns: f64) -> bool {
    return as_in(ns, L_SAR_SPAN_LO_NS, L_SAR_SPAN_HI_NS);
}

/// DAC_control: the bottom plate idles at VCM (0.7 to 0.8 V) and goes to 0 V after decision 1 and 1.5 V after decision 0, within 50 mV.
pub fn as_chk_dac_level(idle_v: f64, after1_v: f64, after0_v: f64) -> bool {
    return as_in(idle_v, L_DAC_IDLE_LO_V, L_DAC_IDLE_HI_V) and as_within(after1_v, L_DAC_LEVEL_V) and as_within(after0_v - 1.5, L_DAC_LEVEL_V);
}

/// DAC_control_top: the eleven bits latch in CK order to exactly code 1430, and the plate code is exactly 617.
pub fn as_chk_dac_top(code: u32, plate: u32) -> bool {
    return code == L_TOP_CODE and plate == L_TOP_PLATE;
}

/// neg_bottom_plate_logic: the idle level VCM within 0.7 to 0.8 V.
pub fn as_chk_neg_plate(vcm_v: f64) -> bool {
    return as_in(vcm_v, L_NEG_VCM_LO_V, L_NEG_VCM_HI_V);
}

/// integration: the worst code error within 64 LSB.
pub fn as_chk_int_err(lsb: f64) -> bool {
    return lsb <= L_INT_ERR_LSB;
}

/// integration: the smallest step between consecutive conversions 60 to 250 LSB.
pub fn as_chk_int_step(lsb: f64) -> bool {
    return as_in(lsb, L_INT_STEP_LO_LSB, L_INT_STEP_HI_LSB);
}

/// corners smoke suite: the SAR inverter delay 62 to 124 ps.
pub fn as_chk_corner_inv(ps: f64) -> bool {
    return as_in(ps, L_CORNER_INV_LO_PS, L_CORNER_INV_HI_PS);
}

/// corners smoke suite: the comparator decision 467 to 829 ps.
pub fn as_chk_corner_cmp(ps: f64) -> bool {
    return as_in(ps, L_CORNER_CMP_LO_PS, L_CORNER_CMP_HI_PS);
}

; --- measurements on our models ------------------------------------------------------------------------------------
/// The inverter's switching threshold in volts from the DC transfer of the tables tn, tp (49 points of 31.25 mV, the bisection of mos_psp103.t27's dc_out): the input at
/// which the output falls through Vdd / 2 (SC_VCM is 0.75 V in units of 2^-24 V). -0.03125 V, one step below zero, means the output never fell through it.
pub fn as_inv_vth_of(tn: []const u32, tp: []const u32) -> f64 {
    var model : [49]f64 = [0.0] ** 49;
    var k : u32 = 0;
    while (k < DC_POINTS) {
        model[k as usize] = (dc_out(tn, tp, k * DC_STEP)) as f64;
        k = k + 1;
    }
    return cross_idx(&model, (SC_VCM as f64), false, 0, 48) * 0.03125;
}

/// The comparator at +2 mV (win_p, the end levels, the decision time) and at -2 mV (win_m), 0.75 V common mode, current tables tn, tp. The decision time is in ps.
pub struct Cmp { win_p: u32, win_m: u32, hi_v: f64, lo_v: f64, dt_ps: f64 }

pub fn as_cmp(tn: []const u32, tp: []const u32) -> Cmp {
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const sa : u64 = sp_run(tn, tp, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    var wp : u32 = 0;
    if (sc_sign(&out)) { wp = 1; }
    const last : u32 = SC_N * SC_NN;
    const dp : f64 = ((out[(last + SC_DP) as usize]) as f64) / SC_UPV;
    const dn : f64 = ((out[(last + SC_DN) as usize]) as f64) / SC_UPV;
    const dt : f64 = sp_first(&out) * 0.1;
    const sb : u64 = sp_run(tn, tp, SC_H2, true, SC_K, &SC_DV_M, &out, &res);
    var wm : u32 = 0;
    if (sc_sign(&out)) { wm = 1; }
    return Cmp { win_p: wp, win_m: wm, hi_v: dp, lo_v: dn, dt_ps: dt };
}

/// The tracking switch's run for stimulus sel (0 to 2: DC at 0.2, 0.75, 1.3 V) with boost capacitor cb (SW_CB, or 0 for the negative control): the tracking error at the
/// end of the track phase, the step the falling clock makes and the droop of the hold, in volts.
pub struct Sw { te: f64, inj: f64, droop: f64 }

pub fn as_sw(sel: u32, cb: u32) -> Sw {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    sw_make_vin(sel, &vin);
    const s : u64 = sw_run(&t, &vin, cb, SW_K, &SW_DV_M, &out, &res, &nit);
    sw_widen(&out, &w);
    return Sw { te: sw_te(&w, &vin), inj: sw_inj(&w), droop: sw_droop(&w) };
}

/// The stimulus of the sequencer's netlist: the inputs at t = 0 with clks high (the reset) and the trim code (a, b, c), clks falling at SL_NG_CLKS_F, then npulse Valid
/// pulses of `high` ps every `period` ps from t0. The edges are sorted by time. ids is sar_clk's nets (vdd, vss, d, set, clks, valid, a, b, c, CK11 .. CK1, clkc).
pub fn as_stim(s_t: []usize, s_n: []usize, s_v: []usize, ids: []const usize, code: usize, t0: usize, period: usize, high: usize, npulse: usize) -> usize {
    var k : usize = 0;
    k = sl_put(s_t, s_n, s_v, k, 0, ids[0], 1);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[1], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[2], 1);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[3], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[6], (code / 4) % 2);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[7], (code / 2) % 2);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[8], code % 2);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[5], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[4], 1);
    k = sl_put(s_t, s_n, s_v, k, SL_NG_CLKS_F, ids[4], 0);
    var i : usize = 0;
    while (i < npulse) {
        k = sl_put(s_t, s_n, s_v, k, t0 + i * period, ids[5], 1);
        k = sl_put(s_t, s_n, s_v, k, t0 + i * period + high, ids[5], 0);
        i = i + 1;
    }
    return k;
}

/// Is CK11 .. CK(12 - n) high and the others low (the sequencer fills as a thermometer, it does not walk)?
pub fn as_thermo(ms: []const usize, ids: []const usize, n: usize) -> bool {
    var j : usize = 0;
    var ok : bool = true;
    while (j < 11) {
        const v : usize = ms[SL_VAL + ids[9 + j]];
        var want : usize = 0;
        if (j < n) { want = 1; }
        if (v != want) { ok = false; }
        j = j + 1;
    }
    return ok;
}

/// How many of CK11 .. CK1 are high.
pub fn as_high(ms: []const usize, ids: []const usize) -> u32 {
    var j : usize = 0;
    var c : u32 = 0;
    while (j < 11) {
        if (ms[SL_VAL + ids[9 + j]] == 1) { c = c + 1; }
        j = j + 1;
    }
    return c;
}

/// The sequencer driven by eleven Valid pulses of 10 ns every 20 ns (so CK11 to CK1 spans 200 ns): edge_ok, every CK output right 8 ns after each Valid rise (and all low
/// before the first); hold_ok, right 8 ns after each Valid fall; c1, c4, c11, how many are high after 1, 4 and 11 edges; span_ps, CK1's rise minus CK11's; c2q_ps, CK11's
/// rise after the first Valid rise (the first dff's clock-to-Q with D = VDD). With `swapped` the fifth dff has Set and Reset exchanged (the negative control).
pub struct SarRun { ok: bool, edge_ok: bool, hold_ok: bool, c1: u32, c4: u32, c11: u32, span_ps: usize, c2q_ps: usize }

pub fn as_sar_run(swapped: bool) -> SarRun {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5500]usize = [0] ** 5500;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    if (!sl_build(&src, &w, &out, &st, &gt, &ms, &ids, swapped)) {
        return SarRun { ok: false, edge_ok: false, hold_ok: false, c1: 0, c4: 0, c11: 0, span_ps: 0, c2q_ps: 0 };
    }
    const k : usize = as_stim(&s_t, &s_n, &s_v, &ids, 0, 80100, 20000, 10000, 11);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 80000);
    var edge_ok : bool = as_thermo(&ms, &ids, 0);
    var hold_ok : bool = true;
    var c1 : u32 = 0;
    var c4 : u32 = 0;
    var c11 : u32 = 0;
    var n : usize = 0;
    while (n < 11) {
        const tr : usize = 80100 + n * 20000;
        sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, tr + 8000);
        if (!as_thermo(&ms, &ids, n + 1)) { edge_ok = false; }
        const hi : u32 = as_high(&ms, &ids);
        if (n == 0) { c1 = hi; }
        if (n == 3) { c4 = hi; }
        if (n == 10) { c11 = hi; }
        sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, tr + 18000);
        if (!as_thermo(&ms, &ids, n + 1)) { hold_ok = false; }
        n = n + 1;
    }
    const t11 : usize = sl_edge(&ms, ids[9], 1, 1, SL_TMIN);
    const t1 : usize = sl_edge(&ms, ids[19], 1, 1, SL_TMIN);
    var span : usize = 0;
    var c2q : usize = 0;
    if (t11 != NONE and t1 != NONE) {
        span = t1 - t11;
        c2q = t11 - 80100;
    }
    return SarRun { ok: true, edge_ok: edge_ok, hold_ok: hold_ok, c1: c1, c4: c4, c11: c11, span_ps: span, c2q_ps: c2q };
}

/// The clock at the golden pace (Valid high 20.2 ns every 40 ns, trim code 000): slow_ps, the first clkc rise after clks falls; stop_ps, the last clkc fall after the
/// eleventh Valid rise (CK1 is high by then and the clock does not restart).
pub struct Clk { slow_ps: usize, stop_ps: usize }

pub fn as_clk_golden() -> Clk {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5500]usize = [0] ** 5500;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    if (!sl_build(&src, &w, &out, &st, &gt, &ms, &ids, false)) { return Clk { slow_ps: 0, stop_ps: 0 }; }
    const k : usize = as_stim(&s_t, &s_n, &s_v, &ids, 0, 80100, 40000, 20200, 11);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 540000);
    const r1 : usize = sl_edge(&ms, ids[20], 1, 1, SL_TMIN);
    const f11 : usize = sl_edge(&ms, ids[20], 0, 11, SL_TMIN);
    var slow : usize = 0;
    var stop : usize = 0;
    if (r1 != NONE) { slow = r1 - SL_NG_CLKS_F; }
    if (f11 != NONE) { stop = f11 - (80100 + 10 * 40000); }
    return Clk { slow_ps: slow, stop_ps: stop };
}

/// The delay from clks falling to clkc rising, ps, for the trim code (4 A + 2 B + C): 0 is the slow setting, 7 the fast one. 0 when the model could not be built.
pub fn as_clk_delay_ps(code: usize) -> usize {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5500]usize = [0] ** 5500;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    if (!sl_build(&src, &w, &out, &st, &gt, &ms, &ids, false)) { return 0; }
    const k : usize = as_stim(&s_t, &s_n, &s_v, &ids, code, 80100, 40000, 20200, 0);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 70000);
    const r1 : usize = sl_edge(&ms, ids[20], 1, 1, SL_TMIN);
    if (r1 == NONE) { return 0; }
    return r1 - SL_NG_CLKS_F;
}

/// Set and reset on the eleven dffs of the sequencer: all CK low after the reset and the clks fall; Set high while clks is low puts all eleven high (set_ok); they keep it
/// when Set is released (hold_ok); clks high resets them all (reset_ok). With `swapped` the fifth dff has Set and Reset exchanged (the negative control).
pub struct DffSr { ok: bool, set_ok: bool, hold_ok: bool, reset_ok: bool }

pub fn as_dff_set_reset(swapped: bool) -> DffSr {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5500]usize = [0] ** 5500;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    if (!sl_build(&src, &w, &out, &st, &gt, &ms, &ids, swapped)) {
        return DffSr { ok: false, set_ok: false, hold_ok: false, reset_ok: false };
    }
    var k : usize = as_stim(&s_t, &s_n, &s_v, &ids, 0, 80100, 40000, 20200, 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 40000, ids[3], 1);
    k = sl_put(&s_t, &s_n, &s_v, k, 50000, ids[3], 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 60000, ids[4], 1);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 35000);
    const before : u32 = as_high(&ms, &ids);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 45000);
    const during : u32 = as_high(&ms, &ids);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 55000);
    const after : u32 = as_high(&ms, &ids);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 70000);
    const reset : u32 = as_high(&ms, &ids);
    return DffSr { ok: true, set_ok: during == 11, hold_ok: after == 11, reset_ok: before == 0 and reset == 0 };
}

/// The converter on an 8-conversion ramp of the differential input from dv0 volts in steps of ddv, ideal sampling about 0.75 V, with DAC ratios k and comparator offset
/// word off: worst, the largest |code + 0.5 - ideal| in LSB (ideal = dv 1023 / 1.5 V + 1024, the bin centre of an ideal converter); step, the smallest difference between
/// consecutive codes; first and last, the codes of the first and last conversion.
pub struct Ramp { worst: f64, step: f64, first: u32, last: u32 }

pub fn as_ramp(k: []const u32, off: u32, dv0: f64, ddv: f64) -> Ramp {
    var worst : f64 = 0.0;
    var smallest : f64 = 100000.0;
    var first : u32 = 0;
    var last : u32 = 0;
    var prev : u32 = 0;
    var i : usize = 0;
    while (i < 8) {
        const dv : f64 = dv0 + ddv * (i as f64);
        const c : u32 = convert_sar(k, q_sm(0.75 + dv / 2.0), q_sm(0.75 - dv / 2.0), off);
        const x : f64 = dv * 1023.0 / 1.5 + 1024.0;
        const e : f64 = fabs64((c as f64) + 0.5 - x);
        if (e > worst) { worst = e; }
        if (i == 0) { first = c; }
        if (i == 7) { last = c; }
        if (i > 0) {
            var d : f64 = (c as f64) - (prev as f64);
            if (d < 0.0) { d = 0.0 - d; }
            if (d < smallest) { smallest = d; }
        }
        prev = c;
        i = i + 1;
    }
    return Ramp { worst: worst, step: smallest, first: first, last: last };
}

/// The ramp of the check as stated: -1 V to +1 V in 8 equal points, the model of sar_adc.t27 with its fitted top-plate parasitic and the measured offset.
pub fn as_ramp_literal() -> Ramp {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    return as_ramp(&kf, q_sm(off_late_v()), 0.0 - 1.0, 2.0 / 7.0);
}

/// The ramp rebuilt from the report's own numbers, context only: 8 equal points whose ideal codes run from 517 to 1579 (the report's ideal end codes; their spacing, 151.7
/// LSB, is the report's ideal step of 152). The input is inferred from those codes, not given by the report.
pub fn as_ramp_report_like() -> Ramp {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    return as_ramp(&kf, q_sm(off_late_v()), (517.5 - 1024.0) / 682.0, 1062.0 / 7.0 / 682.0);
}

; --- the blocks: every row measured on our model, or NOT MODELLED --------------------------------------------------------------
/// inverter: the switching threshold from the PSP103 log tables (PASS or FAIL by the number); the delays into 20 fF are not modelled.
pub fn as_blk_inverter() -> Blk {
    var b : Blk = as_blk0();
    b = as_add(b, as_verdict(true, as_chk_inv_vth(as_inv_vth_of(&TT_LG_N, &TT_LG_P))));
    b = as_add(b, as_nm());
    return b;
}

/// nand: the truth table of the gate-level model; the levels in volts are not modelled.
pub fn as_blk_nand() -> Blk {
    var b : Blk = as_blk0();
    b = as_add(b, as_verdict(true, as_chk_nand(sl_nand_code(0, 0), sl_nand_code(0, 1), sl_nand_code(1, 0), sl_nand_code(1, 1))));
    b = as_add(b, as_nm());
    return b;
}

/// nor: the truth table of the gate-level model (the third input of sar_logic's nor code passed as 0); the levels in volts are not modelled.
pub fn as_blk_nor() -> Blk {
    var b : Blk = as_blk0();
    b = as_add(b, as_verdict(true, as_chk_nor(sl_nor_code(0, 0, 0), sl_nor_code(0, 1, 0), sl_nor_code(1, 0, 0), sl_nor_code(1, 1, 0))));
    b = as_add(b, as_nm());
    return b;
}

/// tgate: Ron at 0.75 V, the worst Ron and the off leakage are not modelled.
pub fn as_blk_tgate() -> Blk {
    var b : Blk = as_blk0();
    b = as_add(b, as_nm());
    b = as_add(b, as_nm());
    b = as_add(b, as_nm());
    return b;
}

/// dff: capture and hold (the sequencer's thermometer at each Valid edge and between edges), set and reset (the Set pulse and the clks reset), the clock-to-Q of the first
/// stage; the levels in volts are not modelled.
pub fn as_blk_dff() -> Blk {
    var b : Blk = as_blk0();
    const r : SarRun = as_sar_run(false);
    const s : DffSr = as_dff_set_reset(false);
    b = as_add(b, as_verdict(r.ok and s.ok, as_chk_dff_behaviour(r.edge_ok, r.hold_ok and s.hold_ok, s.set_ok, s.reset_ok)));
    b = as_add(b, as_nm());
    b = as_add(b, as_verdict(r.ok, as_chk_dff_c2q((r.c2q_ps as f64))));
    return b;
}

/// dynamic_comparator: the sign at +-2 mV, the end levels, the decision time, all on the PSP103 50 C tables; the reset is not run.
pub fn as_blk_comparator() -> Blk {
    var b : Blk = as_blk0();
    const c : Cmp = as_cmp(&TT50_N, &TT50_P);
    b = as_add(b, as_verdict(true, as_chk_cmp_sign(c.win_p, c.win_m)));
    b = as_add(b, as_verdict(true, as_chk_cmp_levels(c.hi_v, c.lo_v)));
    b = as_add(b, as_nm());
    b = as_add(b, as_verdict(true, as_chk_cmp_time(c.dt_ps)));
    return b;
}

/// tracking_switch: the tracking error at 0.2 V and 1.3 V (3.93 pF); the hold step and the droop are not modelled.
pub fn as_blk_switch() -> Blk {
    var b : Blk = as_blk0();
    const lo : Sw = as_sw(0, SW_CB);
    const hi : Sw = as_sw(2, SW_CB);
    b = as_add(b, as_verdict(true, as_chk_sw_track(lo.te, hi.te)));
    b = as_add(b, as_nm());
    b = as_add(b, as_nm());
    return b;
}

/// clock_gen: the slow and fast delays, their ratio, the stop time.
pub fn as_blk_clock() -> Blk {
    var b : Blk = as_blk0();
    const g : Clk = as_clk_golden();
    const slow : f64 = (g.slow_ps as f64) / 1000.0;
    const fast : f64 = (as_clk_delay_ps(7) as f64) / 1000.0;
    b = as_add(b, as_verdict(g.slow_ps > 0, as_chk_clk_slow(slow)));
    b = as_add(b, as_verdict(fast > 0.0, as_chk_clk_fast(fast)));
    b = as_add(b, as_verdict(g.slow_ps > 0 and fast > 0.0, as_chk_clk_ratio(slow / fast)));
    b = as_add(b, as_verdict(g.stop_ps > 0, as_chk_clk_stop((g.stop_ps as f64) / 1000.0)));
    return b;
}

/// SAR_logic: the counts and the order, the CK11 to CK1 span.
pub fn as_blk_sar_logic() -> Blk {
    var b : Blk = as_blk0();
    const r : SarRun = as_sar_run(false);
    b = as_add(b, as_verdict(r.ok, as_chk_sar_count(r.edge_ok, r.hold_ok, r.c1, r.c4, r.c11)));
    b = as_add(b, as_verdict(r.ok and r.span_ps > 0, as_chk_sar_span((r.span_ps as f64) / 1000.0)));
    return b;
}

/// DAC_control: the plate levels are the DAC's input, not a result.
pub fn as_blk_dac_control() -> Blk {
    return as_add(as_blk0(), as_nm());
}

/// DAC_control_top: not a circuit in any spec.
pub fn as_blk_dac_top() -> Blk {
    return as_add(as_blk0(), as_nm());
}

/// neg_bottom_plate_logic: not a circuit in any spec.
pub fn as_blk_neg_plate() -> Blk {
    return as_add(as_blk0(), as_nm());
}

/// integration: the literal -1 V to +1 V ramp of 8 conversions on the behavioural converter.
pub fn as_blk_integration() -> Blk {
    var b : Blk = as_blk0();
    const r : Ramp = as_ramp_literal();
    b = as_add(b, as_verdict(true, as_chk_int_err(r.worst)));
    b = as_add(b, as_verdict(true, as_chk_int_step(r.step)));
    return b;
}

/// The 13 blocks counted by their verdict: .pass blocks PASS, .fail blocks FAIL, .nm blocks NOT MODELLED.
pub fn as_all_blocks() -> Blk {
    var t : Blk = as_blk0();
    t = as_add(t, as_block_verdict(as_blk_inverter()));
    t = as_add(t, as_block_verdict(as_blk_nand()));
    t = as_add(t, as_block_verdict(as_blk_nor()));
    t = as_add(t, as_block_verdict(as_blk_tgate()));
    t = as_add(t, as_block_verdict(as_blk_dff()));
    t = as_add(t, as_block_verdict(as_blk_comparator()));
    t = as_add(t, as_block_verdict(as_blk_switch()));
    t = as_add(t, as_block_verdict(as_blk_clock()));
    t = as_add(t, as_block_verdict(as_blk_sar_logic()));
    t = as_add(t, as_block_verdict(as_blk_dac_control()));
    t = as_add(t, as_block_verdict(as_blk_dac_top()));
    t = as_add(t, as_block_verdict(as_blk_neg_plate()));
    t = as_add(t, as_block_verdict(as_blk_integration()));
    return t;
}

; --- the tests -----------------------------------------------------------------------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test an_unmeasured_row_is_never_a_pass_and_a_block_is_a_pass_only_with_every_row_measured_and_inside {
    var yes : bool = true;
    var no : bool = false;
    assert_eq(as_verdict(no, yes), AS_NM);
    assert_eq(as_verdict(no, no), AS_NM);
    assert_eq(as_verdict(yes, yes), AS_PASS);
    assert_eq(as_verdict(yes, no), AS_FAIL);
    assert_eq(as_nm(), AS_NM);
    // a block: a failing row fails it, a row not modelled keeps it from passing, only measured passes pass it, and no rows is not a pass
    var pass_nm : Blk = as_add(as_add(as_blk0(), AS_PASS), AS_NM);
    assert_eq(pass_nm.pass, 1);
    assert_eq(pass_nm.nm, 1);
    assert_eq(as_block_verdict(pass_nm), AS_NM);
    assert_eq(as_block_verdict(as_add(pass_nm, AS_FAIL)), AS_FAIL);
    assert_eq(as_block_verdict(as_add(as_add(as_blk0(), AS_PASS), AS_PASS)), AS_PASS);
    assert_eq(as_block_verdict(as_blk0()), AS_NM);
    assert_eq(as_block_verdict(as_add(as_blk0(), AS_NM)), AS_NM);
    assert_eq(as_block_verdict(as_add(as_blk0(), AS_FAIL)), AS_FAIL);
    // the three verdicts are three different numbers
    assert(AS_PASS != AS_FAIL);
    assert(AS_FAIL != AS_NM);
    assert(AS_PASS != AS_NM);
}

test the_inverter_threshold_is_measured_on_the_psp103_log_tables_and_the_delays_into_20_ff_are_not_modelled {
    const lg : f64 = as_inv_vth_of(&TT_LG_N, &TT_LG_P);
    const li : f64 = as_inv_vth_of(&TT_N, &TT_P);
    // 0.68924 V on the log tables and 0.68925 V on the linear ones (ngspice's trip point is 0.689 V, mos_psp103.t27); the report's 0.69 V
    assert lg > 0.68920;
    assert lg < 0.68930;
    assert fabs64(lg - li) < 0.00001;
    assert fabs64(lg - R_INV_VTH_V) < 0.001;
    assert(as_chk_inv_vth(lg));
    // the check accepts the report's value and refuses a broken one on either side
    assert(as_chk_inv_vth(R_INV_VTH_V));
    var bad_lo : f64 = 0.4;
    var bad_hi : f64 = 1.2;
    assert(!as_chk_inv_vth(bad_lo));
    assert(!as_chk_inv_vth(bad_hi));
    // NEGATIVE CONTROL on the model: a PMOS that never conducts (a zero table in its slot) leaves the output low at every input but 0, so it never falls through Vdd / 2 and
    // the reader returns its no-crossing value, -0.03125 V (one sweep step below zero)
    var zero : [625]u32 = [0] ** 625;
    const dead : f64 = as_inv_vth_of(&TT_N, &zero);
    assert dead < 0.0;
    assert dead > 0.0 - 0.0313;
    assert(!as_chk_inv_vth(dead));
    // THE LIMIT OF THE CONTROL: the two tables in each other's slots move the trip point to 0.811 V, and the wide limit of 0.5 to 1.0 V accepts it (mos_psp103.t27 refuses it by
    // the DC transfer and the delays); the same holds for every corner's trip point
    const swapped : f64 = as_inv_vth_of(&TT_P, &TT_N);
    assert(swapped > 0.8105);
    assert(swapped < 0.8110);
    assert(as_chk_inv_vth(swapped));
    // the delay check: the report's 81 and 100 ps pass, a delay out of range on either side is refused, and either one alone is enough
    assert(as_chk_inv_delay(R_INV_FALL_PS, R_INV_RISE_PS));
    var fast : f64 = 0.5;
    var slow : f64 = 1340.0;
    assert(!as_chk_inv_delay(fast, R_INV_RISE_PS));
    assert(!as_chk_inv_delay(R_INV_FALL_PS, slow));
    // the block: one row PASS, one NOT MODELLED, so the block is NOT MODELLED
    const b : Blk = as_blk_inverter();
    assert_eq(b.pass, 1);
    assert_eq(b.fail, 0);
    assert_eq(b.nm, 1);
    assert_eq(as_block_verdict(b), AS_NM);
}

test the_nand_and_nor_truth_tables_are_measured_at_logic_level_and_the_levels_in_volts_are_not_modelled {
    assert(as_chk_nand(sl_nand_code(0, 0), sl_nand_code(0, 1), sl_nand_code(1, 0), sl_nand_code(1, 1)));
    assert(as_chk_nor(sl_nor_code(0, 0, 0), sl_nor_code(0, 1, 0), sl_nor_code(1, 0, 0), sl_nor_code(1, 1, 0)));
    // NEGATIVE CONTROL: each table is refused when it is the other gate's, and a single flipped row is refused
    assert(!as_chk_nand(sl_nor_code(0, 0, 0), sl_nor_code(0, 1, 0), sl_nor_code(1, 0, 0), sl_nor_code(1, 1, 0)));
    assert(!as_chk_nor(sl_nand_code(0, 0), sl_nand_code(0, 1), sl_nand_code(1, 0), sl_nand_code(1, 1)));
    var s0 : usize = SL_S0;
    var s1 : usize = SL_S1;
    assert(!as_chk_nand(s1, s1, s0, s0));
    assert(!as_chk_nor(s1, s0, s0, s1));
    // the levels check (the report: 1.5 V for a 1 and microvolts for a 0): the report's own values pass, a droop of the 1 or a leak of the 0 is refused
    var one : f64 = 1.5;
    var low : f64 = 0.000002;
    assert(as_chk_gate_levels(one, low));
    var sag : f64 = 1.2;
    var leak : f64 = 0.2;
    assert(!as_chk_gate_levels(sag, low));
    assert(!as_chk_gate_levels(one, leak));
    const bn : Blk = as_blk_nand();
    const br : Blk = as_blk_nor();
    assert_eq(bn.pass, 1);
    assert_eq(bn.nm, 1);
    assert_eq(br.pass, 1);
    assert_eq(br.nm, 1);
    assert_eq(as_block_verdict(bn), AS_NM);
    assert_eq(as_block_verdict(br), AS_NM);
}

test the_tgate_is_not_modelled_and_its_check_refuses_a_resistor_or_a_leak_out_of_range {
    assert(as_chk_tgate(R_TG_RON_OHM, R_TG_RON_WORST_OHM, R_TG_LEAK_NA));
    var high_r : f64 = 60000.0;
    var high_w : f64 = 90000.0;
    var leak : f64 = 5.0;
    assert(!as_chk_tgate(high_r, R_TG_RON_WORST_OHM, R_TG_LEAK_NA));
    assert(!as_chk_tgate(R_TG_RON_OHM, high_w, R_TG_LEAK_NA));
    assert(!as_chk_tgate(R_TG_RON_OHM, R_TG_RON_WORST_OHM, leak));
    const b : Blk = as_blk_tgate();
    assert_eq(b.pass, 0);
    assert_eq(b.fail, 0);
    assert_eq(b.nm, 3);
    assert_eq(as_block_verdict(b), AS_NM);
}

test the_dff_behaviour_and_clock_to_q_are_measured_at_gate_level_and_a_dff_with_set_and_reset_exchanged_fails_them {
    const r : SarRun = as_sar_run(false);
    const s : DffSr = as_dff_set_reset(false);
    assert(r.ok);
    assert(s.ok);
    // capture and hold: after each of the eleven Valid edges the CK outputs are a thermometer of that many, before the first all are low, and nothing moves between edges
    assert(r.edge_ok);
    assert(r.hold_ok);
    // set and reset: Set puts all eleven high, releasing it holds them, clks high clears them
    assert(s.set_ok);
    assert(s.hold_ok);
    assert(s.reset_ok);
    assert(as_chk_dff_behaviour(r.edge_ok, r.hold_ok and s.hold_ok, s.set_ok, s.reset_ok));
    // clock-to-Q of the first stage: 546 ps (ngspice's own Valid to CK11 is 550 ps, sar_logic.t27); the report's 524 ps; 1 to 3000 ps
    assert(r.c2q_ps > 540);
    assert(r.c2q_ps < 552);
    const c2q : f64 = (r.c2q_ps as f64);
    assert(as_chk_dff_c2q(c2q));
    assert(as_chk_dff_c2q(R_DFF_C2Q_PS));
    var early : f64 = 0.4;
    var late : f64 = 4000.0;
    assert(!as_chk_dff_c2q(early));
    assert(!as_chk_dff_c2q(late));
    // NEGATIVE CONTROL on the model: the fifth dff with Set and Reset exchanged. The set row loses CK7, the clks reset sets it instead of clearing it, the order is wrong
    const sw : SarRun = as_sar_run(true);
    const ss : DffSr = as_dff_set_reset(true);
    assert(sw.ok);
    assert(ss.ok);
    assert(!sw.edge_ok);
    assert(!ss.set_ok);
    assert(!ss.reset_ok);
    assert(!as_chk_dff_behaviour(sw.edge_ok, sw.hold_ok and ss.hold_ok, ss.set_ok, ss.reset_ok));
    // and a wrong row refuses the check one at a time
    var t : bool = true;
    var f : bool = false;
    assert(!as_chk_dff_behaviour(f, t, t, t));
    assert(!as_chk_dff_behaviour(t, f, t, t));
    assert(!as_chk_dff_behaviour(t, t, f, t));
    assert(!as_chk_dff_behaviour(t, t, t, f));
    // the levels: the gate-level model has none; a dff output 0.2 V off its rail is refused
    var rail : f64 = 0.001;
    var off : f64 = 0.2;
    assert(as_chk_dff_levels(rail));
    assert(!as_chk_dff_levels(off));
    const b : Blk = as_blk_dff();
    assert_eq(b.pass, 2);
    assert_eq(b.fail, 0);
    assert_eq(b.nm, 1);
    assert_eq(as_block_verdict(b), AS_NM);
}

test the_comparator_decides_the_right_way_to_the_rails_and_its_decision_time_is_refused_by_the_10_ps_lower_limit {
    const c : Cmp = as_cmp(&TT50_N, &TT50_P);
    // the sign at +-2 mV: dp wins at +2 mV and dn at -2 mV
    assert_eq(c.win_p, 1);
    assert_eq(c.win_m, 0);
    assert(as_chk_cmp_sign(c.win_p, c.win_m));
    // the end levels after 14 ps: the winner at 1.49996 V, the loser at 3.6 mV
    assert(c.hi_v > 1.4999);
    assert(c.hi_v < 1.5);
    assert(c.lo_v > 0.003);
    assert(c.lo_v < 0.004);
    assert(as_chk_cmp_levels(c.hi_v, c.lo_v));
    // THE DECISION TIME: 5.35 ps (53.50 steps of 0.1 ps after the clock's 50 % point, sar_comparator_psp.t27), below the 10 ps limit: FAIL, by 4.65 ps
    assert(c.dt_ps > 5.349);
    assert(c.dt_ps < 5.351);
    assert(!as_chk_cmp_time(c.dt_ps));
    assert(c.dt_ps < L_CMP_DT_LO_PS);
    // the same on the 27 C tables (the report's temperature): 5.12 ps, also refused
    const c27 : Cmp = as_cmp(&TT_N, &TT_P);
    assert(c27.dt_ps > 5.11);
    assert(c27.dt_ps < 5.13);
    assert(!as_chk_cmp_time(c27.dt_ps));
    assert_eq(c27.win_p, 1);
    assert_eq(c27.win_m, 0);
    // the check is not always-FAIL: the report's 607 ps passes, and so would ngspice's own 523 ps on the golden comparator with its charge; 20 ns and a missed decision (-0.1) are refused
    assert(as_chk_cmp_time(R_CMP_DT_PS));
    var ng : f64 = 523.032;
    var long : f64 = 20000.0;
    var none : f64 = 0.0 - 0.1;
    assert(as_chk_cmp_time(ng));
    assert(!as_chk_cmp_time(long));
    assert(!as_chk_cmp_time(none));
    // NEGATIVE CONTROL on the model, the sign: the inputs wired the wrong way round is the same run read with the roles exchanged, and the sign check refuses it
    assert(!as_chk_cmp_sign(c.win_m, c.win_p));
    // the levels check refuses a latch that stops half way, and a loser that does not fall
    var half_hi : f64 = 1.2;
    var half_lo : f64 = 0.3;
    assert(!as_chk_cmp_levels(half_hi, c.lo_v));
    assert(!as_chk_cmp_levels(c.hi_v, half_lo));
    // the reset row is not run: the report's reset level (0 V, within 50 mV) is checkable but nothing of ours is fed to it
    var z : f64 = 0.0;
    var up : f64 = 1.5;
    assert(as_chk_cmp_reset(z, z));
    assert(!as_chk_cmp_reset(up, z));
    const b : Blk = as_blk_comparator();
    assert_eq(b.pass, 2);
    assert_eq(b.fail, 1);
    assert_eq(b.nm, 1);
    assert_eq(as_block_verdict(b), AS_FAIL);
}

test the_tracking_error_is_measured_on_the_square_law_switch_and_the_hold_step_and_droop_are_not_modelled_because_it_has_no_charge_and_no_leak {
    const lo : Sw = as_sw(0, SW_CB);
    const hi : Sw = as_sw(2, SW_CB);
    const mid : Sw = as_sw(1, SW_CB);
    // the tracking error at the end of the track phase: 1.97 microvolts at 0.2 V and at 1.3 V (the fixed-point floor, ngspice has 0.03 and 0.05 uV), 5 mV allowed
    assert(lo.te < 0.0 - 0.0000019);
    assert(lo.te > 0.0 - 0.0000021);
    assert(hi.te < 0.0 - 0.0000019);
    assert(hi.te > 0.0 - 0.0000021);
    assert(as_chk_sw_track(lo.te, hi.te));
    // NEGATIVE CONTROL on the model: no boost capacitor, the switch is barely on, the tracking error is 25.4 mV
    const nocb : Sw = as_sw(1, 0);
    assert(nocb.te < 0.0 - 0.025);
    assert(nocb.te > 0.0 - 0.026);
    assert(!as_chk_sw_track(nocb.te, nocb.te));
    // the check accepts a tracking error of 1 uV (the report's "< 0.001 mV") and refuses 6 mV on either side
    var one_uv : f64 = 0.000001;
    var six : f64 = 0.006;
    assert(as_chk_sw_track(one_uv, one_uv));
    assert(!as_chk_sw_track(six, one_uv));
    assert(!as_chk_sw_track(one_uv, 0.0 - six));
    // WHY THE OTHER TWO ROWS ARE NOT MODELLED. The model returns a hold step of 0.18 uV and a droop of exactly 0: the square law has no gate capacitance and no leak, so there is
    // nothing in it that could step or droop. Those numbers sit far inside 30 mV and 5 mV and would "pass" by having no effect; the report's own -1.6 and -1.7 mV are what a
    // real switch's charge injection does, and the check accepts them and refuses 50 mV
    assert(fabs64(mid.inj) < 0.000001);
    assert(fabs64(mid.inj) > 0.0000001);
    assert(fabs64(mid.droop) < 0.000000001);
    assert(as_chk_sw_hold(R_SW_HOLD_A_V, R_SW_HOLD_B_V));
    var big : f64 = 0.05;
    assert(!as_chk_sw_hold(big, R_SW_HOLD_B_V));
    assert(!as_chk_sw_hold(R_SW_HOLD_A_V, 0.0 - big));
    assert(as_chk_sw_droop(one_uv));
    assert(!as_chk_sw_droop(six));
    const b : Blk = as_blk_switch();
    assert_eq(b.pass, 1);
    assert_eq(b.fail, 0);
    assert_eq(b.nm, 2);
    assert_eq(as_block_verdict(b), AS_NM);
}

test the_clock_generators_delays_ratio_and_stop_are_measured_on_the_gate_level_model_and_a_clock_that_ignores_its_trim_is_refused {
    const g : Clk = as_clk_golden();
    const slow : f64 = (g.slow_ps as f64) / 1000.0;
    const fast : f64 = (as_clk_delay_ps(7) as f64) / 1000.0;
    // slow (trim 000) 16.145 ns, ngspice 16.147 ns; fast (trim 111) 9.822 ns, ngspice 9.669 ns (sar_logic.t27's bound is 6 %); ratio 1.644, the report's 1.64
    assert(slow > 16.1);
    assert(slow < 16.2);
    assert(fast > 9.7);
    assert(fast < 9.9);
    assert(as_chk_clk_slow(slow));
    assert(as_chk_clk_fast(fast));
    const ratio : f64 = slow / fast;
    assert(ratio > 1.63);
    assert(ratio < 1.66);
    assert(as_chk_clk_ratio(ratio));
    // the stop: the clock's last fall comes 5.70 ns after the eleventh Valid rise (ngspice 5.81 ns); the report's 10.7 ns is a different definition, both are inside 30 ns
    const stop : f64 = (g.stop_ps as f64) / 1000.0;
    assert(stop > 5.6);
    assert(stop < 5.8);
    assert(as_chk_clk_stop(stop));
    assert(as_chk_clk_stop(R_CLK_STOP_NS));
    // the checks accept the report's values and refuse a delay out of range on either side
    assert(as_chk_clk_slow(R_CLK_SLOW_NS));
    assert(as_chk_clk_fast(R_CLK_FAST_NS));
    assert(as_chk_clk_ratio(R_CLK_RATIO));
    var tiny : f64 = 0.01;
    var huge : f64 = 60.0;
    assert(!as_chk_clk_slow(tiny));
    assert(!as_chk_clk_slow(huge));
    assert(!as_chk_clk_fast(tiny));
    assert(!as_chk_clk_fast(huge));
    var flat : f64 = 1.1;
    assert(!as_chk_clk_ratio(flat));
    var runaway : f64 = 31.0;
    var never : f64 = 0.0 - 1.0;
    assert(!as_chk_clk_stop(runaway));
    assert(!as_chk_clk_stop(never));
    // NEGATIVE CONTROL on the model: a clock that ignores its trim (code 0 read for the fast setting) has a ratio of exactly 1 and is refused
    const same : f64 = (as_clk_delay_ps(0) as f64) / 1000.0;
    assert(same > 16.1);
    assert(!as_chk_clk_ratio(slow / same));
    const b : Blk = as_blk_clock();
    assert_eq(b.pass, 4);
    assert_eq(b.fail, 0);
    assert_eq(b.nm, 0);
    assert_eq(as_block_verdict(b), AS_PASS);
}

test the_sar_logic_adds_one_output_per_valid_edge_ck11_first_and_spans_200_ns_and_a_swapped_dff_is_refused {
    const r : SarRun = as_sar_run(false);
    assert(r.ok);
    // one more CK high per Valid edge, CK11 first, the thermometer in order, held between edges; 1, 4 and 11 high after 1, 4 and 11 edges
    assert(r.edge_ok);
    assert(r.hold_ok);
    assert_eq(r.c1, 1);
    assert_eq(r.c4, 4);
    assert_eq(r.c11, 11);
    assert(as_chk_sar_count(r.edge_ok, r.hold_ok, r.c1, r.c4, r.c11));
    // CK11 to CK1 in 200.126 ns: ten Valid periods of 20 ns plus the 126 ps by which CK1's load makes it later than CK11
    assert(r.span_ps > 200100);
    assert(r.span_ps < 200150);
    const span : f64 = (r.span_ps as f64) / 1000.0;
    assert(as_chk_sar_span(span));
    // the check refuses a span out of range on either side, and a wrong count, one at a time
    var short : f64 = 198.0;
    var long : f64 = 202.0;
    assert(!as_chk_sar_span(short));
    assert(!as_chk_sar_span(long));
    var t : bool = true;
    assert(!as_chk_sar_count(t, t, 2, 4, 11));
    assert(!as_chk_sar_count(t, t, 1, 5, 11));
    assert(!as_chk_sar_count(t, t, 1, 4, 10));
    assert(!as_chk_sar_count(false, t, 1, 4, 11));
    assert(!as_chk_sar_count(t, false, 1, 4, 11));
    // NEGATIVE CONTROL on the model: the fifth dff with Set and Reset exchanged starts CK7 high, so two outputs are high after the first edge, five after the fourth, the
    // order is wrong, and the same check refuses the run
    const sw : SarRun = as_sar_run(true);
    assert(sw.ok);
    assert_eq(sw.c1, 2);
    assert_eq(sw.c4, 5);
    assert_eq(sw.c11, 11);
    assert(!sw.edge_ok);
    assert(!as_chk_sar_count(sw.edge_ok, sw.hold_ok, sw.c1, sw.c4, sw.c11));
    const b : Blk = as_blk_sar_logic();
    assert_eq(b.pass, 2);
    assert_eq(b.fail, 0);
    assert_eq(b.nm, 0);
    assert_eq(as_block_verdict(b), AS_PASS);
}

test the_dac_control_dac_control_top_and_neg_bottom_plate_logic_are_not_modelled_and_their_checks_refuse_a_swapped_plate_and_a_wrong_code {
    // DAC_control: the report's levels pass (0.75 V idle, 0 V after decision 1, 1.5 V after decision 0); the two decisions swapped, a plate stuck at the rail while idle, and a
    // half-way level are refused
    var vcm : f64 = 0.75;
    var rail_hi : f64 = 1.5;
    var rail_lo : f64 = 0.0;
    assert(as_chk_dac_level(vcm, rail_lo, rail_hi));
    assert(!as_chk_dac_level(vcm, rail_hi, rail_lo));
    assert(!as_chk_dac_level(rail_hi, rail_lo, rail_hi));
    var mid_lvl : f64 = 1.1;
    assert(!as_chk_dac_level(vcm, rail_lo, mid_lvl));
    // DAC_control_top: the report's code 1430 and plate code 617 pass; they are complements in 11 bits (1430 + 617 = 2047), so a wrong code, a wrong plate code and a code with two
    // bits swapped are refused
    var code : u32 = L_TOP_CODE;
    var plate : u32 = L_TOP_PLATE;
    assert_eq(code + plate, 2047);
    assert(as_chk_dac_top(code, plate));
    assert(!as_chk_dac_top(code, plate + 1));
    assert(!as_chk_dac_top(code + 1, plate));
    var swapped_bits : u32 = code ^ 6;
    assert(swapped_bits != code);
    assert(!as_chk_dac_top(swapped_bits, plate));
    assert(!as_chk_dac_top(plate, code));
    // neg_bottom_plate_logic: VCM within 0.7 to 0.8 V
    assert(as_chk_neg_plate(vcm));
    assert(!as_chk_neg_plate(rail_hi));
    assert(!as_chk_neg_plate(rail_lo));
    // none of the three blocks is fed a value of ours: each is one NOT MODELLED row, never a pass
    const b1 : Blk = as_blk_dac_control();
    const b2 : Blk = as_blk_dac_top();
    const b3 : Blk = as_blk_neg_plate();
    assert_eq(b1.pass + b2.pass + b3.pass, 0);
    assert_eq(b1.fail + b2.fail + b3.fail, 0);
    assert_eq(b1.nm + b2.nm + b3.nm, 3);
    assert_eq(as_block_verdict(b1), AS_NM);
    assert_eq(as_block_verdict(b2), AS_NM);
    assert_eq(as_block_verdict(b3), AS_NM);
}

test the_integration_ramp_is_measured_on_the_behavioural_converter_and_a_halved_msb_capacitor_is_refused {
    const r : Ramp = as_ramp_literal();
    // the literal ramp, -1 V to +1 V in 8 points of 285.7 mV: the worst error is 18.5 LSB (at +1 V: the converter's gain is 1.9 % high), the smallest step 198 LSB (ideal 195)
    assert(r.worst > 18.4);
    assert(r.worst < 18.6);
    assert(r.step > 197.5);
    assert(r.step < 198.5);
    assert_eq(r.first, 333);
    assert_eq(r.last, 1724);
    assert(as_chk_int_err(r.worst));
    assert(as_chk_int_step(r.step));
    // the checks accept the report's own numbers and refuse numbers out of range on either side
    assert(as_chk_int_err(R_INT_ERR_LSB));
    assert(as_chk_int_step(R_INT_STEP_LSB));
    var big : f64 = 100.0;
    var tiny : f64 = 40.0;
    var wide : f64 = 300.0;
    assert(!as_chk_int_err(big));
    assert(!as_chk_int_step(tiny));
    assert(!as_chk_int_step(wide));
    // NEGATIVE CONTROL on the model: the MSB capacitor halved (8 units instead of 16) gives a worst error of 237 LSB
    var bad : [10]u32 = UNITS;
    bad[9] = 8;
    const kb : [20]u32 = model_k(&bad, 1.0, CP_FIT);
    const rb : Ramp = as_ramp(&kb, q_sm(off_late_v()), 0.0 - 1.0, 2.0 / 7.0);
    assert(rb.worst > 236.0);
    assert(rb.worst < 238.0);
    assert(!as_chk_int_err(rb.worst));
    // a converter that is the ideal capacitors with no parasitic and no offset is the ideal quantizer: the worst error is the half LSB of the bin centre
    const k0 : [20]u32 = model_k(&UNITS, 1.0, 0.0);
    const ri : Ramp = as_ramp(&k0, 0, 0.0 - 1.0, 2.0 / 7.0);
    assert(ri.worst < 0.51);
    // CONTEXT, not a verdict: the ramp rebuilt from the report's ideal end codes (517 and 1579, spacing 151.7 LSB). Our model gives codes 512 and 1595 where the report has 510
    // and 1593, a worst error of 16.0 LSB where it has 13.8, and a smallest step of 154 LSB where it has 154 (ideal 152). The report's inputs are inferred, so these are four numbers
    // that agree to within a few LSB, not a check of the model against the report
    const rr : Ramp = as_ramp_report_like();
    assert_eq(rr.first, 512);
    assert_eq(rr.last, 1595);
    assert(rr.worst > 15.9);
    assert(rr.worst < 16.1);
    assert(rr.step > 153.5);
    assert(rr.step < 154.5);
    var d_first : u32 = rr.first - R_INT_FIRST_CODE;
    var d_last : u32 = rr.last - R_INT_LAST_CODE;
    assert(d_first <= 3);
    assert(d_last <= 3);
    assert(as_chk_int_err(rr.worst));
    assert(as_chk_int_step(rr.step));
    const b : Blk = as_blk_integration();
    assert_eq(b.pass, 2);
    assert_eq(b.fail, 0);
    assert_eq(b.nm, 0);
    assert_eq(as_block_verdict(b), AS_PASS);
}

test the_corners_smoke_suite_is_not_modelled_and_its_checks_refuse_a_delay_out_of_range {
    // the model has the inverter in five corners at 27 C and the comparator in tt at 27 C and 50 C, none at -40 or 125 C: the grid of the report cannot be run
    var inv_lo : f64 = 62.0;
    var inv_hi : f64 = 124.0;
    var cmp_lo : f64 = 467.0;
    var cmp_hi : f64 = 829.0;
    assert(as_chk_corner_inv(inv_lo));
    assert(as_chk_corner_inv(inv_hi));
    assert(as_chk_corner_cmp(cmp_lo));
    assert(as_chk_corner_cmp(cmp_hi));
    var fast : f64 = 40.0;
    var slow : f64 = 200.0;
    assert(!as_chk_corner_inv(fast));
    assert(!as_chk_corner_inv(slow));
    // the no-charge comparator's 5.35 ps is two orders of magnitude under the lower limit
    const c : Cmp = as_cmp(&TT50_N, &TT50_P);
    assert(!as_chk_corner_cmp(c.dt_ps));
    assert_eq(as_nm(), AS_NM);
}

test the_thirteen_blocks_count_3_pass_1_fail_and_9_not_modelled {
    // the blocks, one by one, each by the strict rule
    assert_eq(as_block_verdict(as_blk_inverter()), AS_NM);
    assert_eq(as_block_verdict(as_blk_nand()), AS_NM);
    assert_eq(as_block_verdict(as_blk_nor()), AS_NM);
    assert_eq(as_block_verdict(as_blk_tgate()), AS_NM);
    assert_eq(as_block_verdict(as_blk_dff()), AS_NM);
    assert_eq(as_block_verdict(as_blk_comparator()), AS_FAIL);
    assert_eq(as_block_verdict(as_blk_switch()), AS_NM);
    assert_eq(as_block_verdict(as_blk_clock()), AS_PASS);
    assert_eq(as_block_verdict(as_blk_sar_logic()), AS_PASS);
    assert_eq(as_block_verdict(as_blk_dac_control()), AS_NM);
    assert_eq(as_block_verdict(as_blk_dac_top()), AS_NM);
    assert_eq(as_block_verdict(as_blk_neg_plate()), AS_NM);
    assert_eq(as_block_verdict(as_blk_integration()), AS_PASS);
    // the counts over the 13 blocks, and they add up: nothing is counted twice and no block is left out
    const t : Blk = as_all_blocks();
    assert_eq(t.pass, 3);
    assert_eq(t.fail, 1);
    assert_eq(t.nm, 9);
    assert_eq(t.pass + t.fail + t.nm, AS_N_BLOCKS);
}
