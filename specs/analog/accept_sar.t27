pub const L_TG_LEAK_NA : f64 = 1.0;
pub const L_DFF_LEVEL_V : f64 = 0.05;
pub const L_DFF_C2Q_LO_PS : f64 = 1.0;
pub const L_DFF_C2Q_HI_PS : f64 = 3000.0;
pub const L_CMP_LEVEL_V : f64 = 0.05;
pub const L_CMP_DT_LO_PS : f64 = 10.0;
pub const L_CMP_DT_HI_PS : f64 = 10000.0;
