// SPDX-License-Identifier: Apache-2.0
; specs/analog/netlist_block_svg.t27 -- one netlist block drawn as an SVG still through the T27F netlist tokens. Refs #13665, epic #13650.
; Why. The census counts a block, the meaning rule classes it, the structure table plans its picture.
; Nothing drew it. This module is the first drawing: one block, one still, every mark taken from the
; plan and every colour and dash taken from the token schema, so the picture cannot say more than
; the census does.
; What this module is: nb_svg(block, theme, dst) writes the SVG text of block i of the reference deck
; (the 17 census rows of netlist_meaning) and main() reads "block theme" on stdin and prints it.
; --
; What is drawn, and its label:
; - the frame   one outline, DERIVED (the class is a rule's result), or a REFUSAL for no such block.
; - the pins    one dot per pin on the top edge, EXACT (the count is the .subckt line).
; - the body    one box per element line, EXACT: X = subcircuit instance (filled box), M = MOS device,
;               C = MIM capacitor, P = passive or source (outline boxes). A folded body is one box
;               with its exact count.
; - the caption the block name, its class and its counts.
; Colours are th_color(theme, role) of the role the token schema gives; no colour is written here.
; --
; NOT claimed: no net, wire or connectivity is drawn (the census row has none); items are in census
; order on a grid, not placed as a schematic; pin names are not shown; sizes are fixed numbers of
; this still, not a responsive layout; one deck only. Every private helper carries the nb_ prefix.
; HOST CALLS: std.c.read on stdin, std.c.write on stdout, std.c.exit (1 no input, 2 does not fit); link libc.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module analog_netlist_block_svg;

use analog::netlist_meaning::NM_BLOCKS;
use analog::netlist_meaning::NM_PINS;
use analog::netlist_meaning::NM_SUB;
use analog::netlist_meaning::NM_MOS;
use analog::netlist_meaning::NM_MIM;
use analog::netlist_meaning::NM_PASSIVE;
use analog::netlist_meaning::NM_CLASSES;
use analog::netlist_meaning::nm_block_class;
use analog::netlist_meaning::nm_block_lines;
use analog::netlist_structure::ns_frame;
use analog::netlist_structure::ns_folded;
use analog::netlist_structure::ns_shows_instances;
use analog::netlist_structure::ns_shows_devices;
use analog::netlist_structure::ns_block_items;
use t27f::netlist_tokens::NT_INSTANCE;
use t27f::netlist_tokens::NT_PIN;
use t27f::netlist_tokens::NT_DEVICE;
use t27f::netlist_tokens::NT_REFUSAL;
use t27f::netlist_tokens::NT_EXACT;
use t27f::netlist_tokens::NT_DERIVED;
use t27f::netlist_tokens::NT_UNKNOWN;
use t27f::netlist_tokens::NT_SOLID;
use t27f::netlist_tokens::NT_DASH_LONG;
use t27f::netlist_tokens::NT_DASH_SHORT;
use t27f::netlist_tokens::nt_fill;
use t27f::netlist_tokens::nt_stroke;
use t27f::netlist_tokens::nt_text;
use t27f::netlist_tokens::nt_dash;
use t27f::vf_theme::TH_BG;
use t27f::vf_theme::TH_THEMES;
use t27f::vf_theme::th_color;

pub const NB_W : usize = 1080;
pub const NB_COLS : usize = 8;
pub const NB_CELL_W : usize = 110;
pub const NB_CELL_H : usize = 56;
pub const NB_GAP : usize = 16;
pub const NB_PAD : usize = 40;
pub const NB_TOP : usize = 140;
pub const NB_OUT : usize = 65536;

var nb_out : [65536]u8 = undefined;
var nb_in : [64]u8 = undefined;

fn nb_text(dst: []u8, at: usize, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len and at + i < dst.len) {
        dst[at + i] = s[i];
        i = i + 1;
    }
    return at + i;
}

fn nb_num(dst: []u8, at: usize, v: usize) -> usize {
    var digits : [20]u8 = undefined;
    var n : usize = 0;
    var x : usize = v;
    if (x == 0) {
        digits[0] = 48;
        n = 1;
    }
    while (x > 0) {
        digits[n] = 48 + @as(u8, @intCast(x % 10));
        n = n + 1;
        x = x / 10;
    }
    var p : usize = at;
    while (n > 0 and p < dst.len) {
        n = n - 1;
        dst[p] = digits[n];
        p = p + 1;
    }
    return p;
}

; "#RRGGBB" of a theme role
fn nb_rgb(dst: []u8, at: usize, theme: u32, role: u32) -> usize {
    const c : u32 = th_color(theme, role);
    var p : usize = nb_text(dst, at, "#");
    var shift : u32 = 24;
    while (shift > 0 and p < dst.len) {
        shift = shift - 4;
        const d : u32 = (c >> @as(u5, @intCast(shift))) & 15;
        if (d < 10) {
            dst[p] = 48 + @as(u8, @intCast(d));
        } else {
            dst[p] = 55 + @as(u8, @intCast(d));
        }
        p = p + 1;
    }
    return p;
}

fn nb_dash(dst: []u8, at: usize, dash: u32) -> usize {
    if (dash == NT_SOLID) {
        return at;
    }
    if (dash == NT_DASH_LONG) {
        return nb_text(dst, at, " stroke-dasharray=\"10 6\"");
    }
    if (dash == NT_DASH_SHORT) {
        return nb_text(dst, at, " stroke-dasharray=\"4 4\"");
    }
    return nb_text(dst, at, " stroke-dasharray=\"1 5\"");
}

/// The name of census row i, as its .subckt line spells it; "?" for no such row.
pub fn nb_name(i: u32) -> []const u8 {
    if (i == 0) { return "top"; }
    if (i == 1) { return "tracking_switch"; }
    if (i == 2) { return "dynamic_comparator_top"; }
    if (i == 3) { return "sar_logic"; }
    if (i == 4) { return "clock_gen"; }
    if (i == 5) { return "dac_control_top"; }
    if (i == 6) { return "neg_bottom_plate_logic"; }
    if (i == 7) { return "diff_cap_dac"; }
    if (i == 8) { return "inverter"; }
    if (i == 9) { return "nand"; }
    if (i == 10) { return "dynamic_comparator"; }
    if (i == 11) { return "dff"; }
    if (i == 12) { return "nor3"; }
    if (i == 13) { return "delay_cell"; }
    if (i == 14) { return "dac_control"; }
    if (i == 15) { return "tgate"; }
    if (i == 16) { return "nor"; }
    return "?";
}

/// The name of a class; "?" out of range.
pub fn nb_class_name(class: u32) -> []const u8 {
    if (class == 0) { return "empty"; }
    if (class == 1) { return "top"; }
    if (class == 2) { return "leaf"; }
    if (class == 3) { return "array"; }
    if (class == 4) { return "composite"; }
    if (class == 5) { return "mixed"; }
    return "?";
}

fn nb_rows(items: usize) -> usize {
    if (items == 0) {
        return 1;
    }
    return (items + NB_COLS - 1) / NB_COLS;
}

/// The height of the still of a block that draws `items` body boxes.
pub fn nb_height(items: usize) -> usize {
    return NB_TOP + NB_PAD + nb_rows(items) * (NB_CELL_H + NB_GAP) + NB_PAD;
}

; one body box: slot k of the grid, token kind, a letter and a number (0 = no number), a count suffix
fn nb_item(dst: []u8, at: usize, theme: u32, k: usize, kind: u32, letter: []const u8, num: usize, times: usize) -> usize {
    const x : usize = 2 * NB_PAD + (k % NB_COLS) * (NB_CELL_W + NB_GAP);
    const y : usize = NB_TOP + NB_PAD + (k / NB_COLS) * (NB_CELL_H + NB_GAP);
    var p : usize = nb_text(dst, at, "<rect class=\"item\" x=\"");
    p = nb_num(dst, p, x);
    p = nb_text(dst, p, "\" y=\"");
    p = nb_num(dst, p, y);
    p = nb_text(dst, p, "\" width=\"");
    p = nb_num(dst, p, NB_CELL_W);
    p = nb_text(dst, p, "\" height=\"");
    p = nb_num(dst, p, NB_CELL_H);
    p = nb_text(dst, p, "\" rx=\"6\" stroke-width=\"2\" fill=\"");
    p = nb_rgb(dst, p, theme, nt_fill(kind, NT_EXACT));
    p = nb_text(dst, p, "\" stroke=\"");
    p = nb_rgb(dst, p, theme, nt_stroke(kind, NT_EXACT));
    p = nb_text(dst, p, "\"");
    p = nb_dash(dst, p, nt_dash(kind, NT_EXACT));
    p = nb_text(dst, p, "/>\n<text x=\"");
    p = nb_num(dst, p, x + NB_CELL_W / 2);
    p = nb_text(dst, p, "\" y=\"");
    p = nb_num(dst, p, y + NB_CELL_H / 2 + 6);
    p = nb_text(dst, p, "\" text-anchor=\"middle\" font-size=\"16\" fill=\"");
    p = nb_rgb(dst, p, theme, nt_text(kind, NT_EXACT));
    p = nb_text(dst, p, "\">");
    p = nb_text(dst, p, letter);
    if (num > 0) {
        p = nb_num(dst, p, num);
    }
    if (times > 0) {
        p = nb_text(dst, p, " x");
        p = nb_num(dst, p, times);
    }
    p = nb_text(dst, p, "</text>\n");
    return p;
}

; a run of n boxes of one kind, numbered 1..n, starting at grid slot k; returns the new write position
fn nb_run(dst: []u8, at: usize, theme: u32, k: usize, kind: u32, letter: []const u8, n: usize) -> usize {
    var p : usize = at;
    var j : usize = 0;
    while (j < n) {
        p = nb_item(dst, p, theme, k + j, kind, letter, j + 1, 0);
        j = j + 1;
    }
    return p;
}

/// The SVG still of census row `block` in `theme`; returns the bytes written (dst.len when it did not fit).
pub fn nb_svg(block: u32, theme: u32, dst: []u8) -> usize {
    var th : u32 = theme;
    if (th >= TH_THEMES) {
        th = 0;
    }
    var class : u32 = 0;
    var items : usize = 0;
    var pins : usize = 0;
    var sub : usize = 0;
    var mos : usize = 0;
    var mim : usize = 0;
    var pas : usize = 0;
    if (block < NM_BLOCKS) {
        class = nm_block_class(block);
        items = @as(usize, @intCast(ns_block_items(block)));
        pins = @as(usize, @intCast(NM_PINS[block]));
        sub = @as(usize, @intCast(NM_SUB[block]));
        mos = @as(usize, @intCast(NM_MOS[block]));
        mim = @as(usize, @intCast(NM_MIM[block]));
        pas = @as(usize, @intCast(NM_PASSIVE[block]));
    }
    const frame : u32 = ns_frame(class);
    var flabel : u32 = NT_DERIVED;
    if (frame == NT_REFUSAL) {
        flabel = NT_UNKNOWN;
    }
    const h : usize = nb_height(items);
    var p : usize = nb_text(dst, 0, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"");
    p = nb_num(dst, p, NB_W);
    p = nb_text(dst, p, "\" height=\"");
    p = nb_num(dst, p, h);
    p = nb_text(dst, p, "\" font-family=\"monospace\">\n<rect width=\"");
    p = nb_num(dst, p, NB_W);
    p = nb_text(dst, p, "\" height=\"");
    p = nb_num(dst, p, h);
    p = nb_text(dst, p, "\" fill=\"");
    p = nb_rgb(dst, p, th, TH_BG);
    p = nb_text(dst, p, "\"/>\n<text x=\"");
    p = nb_num(dst, p, NB_PAD);
    p = nb_text(dst, p, "\" y=\"56\" font-size=\"26\" font-weight=\"bold\" fill=\"");
    p = nb_rgb(dst, p, th, nt_text(NT_DEVICE, NT_EXACT));
    p = nb_text(dst, p, "\">");
    p = nb_text(dst, p, nb_name(block));
    p = nb_text(dst, p, "</text>\n<text x=\"");
    p = nb_num(dst, p, NB_PAD);
    p = nb_text(dst, p, "\" y=\"88\" font-size=\"16\" fill=\"");
    p = nb_rgb(dst, p, th, nt_text(frame, flabel));
    p = nb_text(dst, p, "\">class ");
    p = nb_text(dst, p, nb_class_name(class));
    p = nb_text(dst, p, " (derived)  pins ");
    p = nb_num(dst, p, pins);
    p = nb_text(dst, p, "  lines ");
    p = nb_num(dst, p, sub + mos + mim + pas);
    p = nb_text(dst, p, "  X ");
    p = nb_num(dst, p, sub);
    p = nb_text(dst, p, "  M ");
    p = nb_num(dst, p, mos);
    p = nb_text(dst, p, "  C ");
    p = nb_num(dst, p, mim);
    p = nb_text(dst, p, "  P ");
    p = nb_num(dst, p, pas);
    p = nb_text(dst, p, "</text>\n<rect class=\"frame\" x=\"");
    p = nb_num(dst, p, NB_PAD);
    p = nb_text(dst, p, "\" y=\"");
    p = nb_num(dst, p, NB_TOP);
    p = nb_text(dst, p, "\" width=\"");
    p = nb_num(dst, p, NB_W - 2 * NB_PAD);
    p = nb_text(dst, p, "\" height=\"");
    p = nb_num(dst, p, h - NB_TOP - NB_PAD);
    p = nb_text(dst, p, "\" rx=\"12\" stroke-width=\"2\" fill=\"");
    p = nb_rgb(dst, p, th, nt_fill(frame, flabel));
    p = nb_text(dst, p, "\" stroke=\"");
    p = nb_rgb(dst, p, th, nt_stroke(frame, flabel));
    p = nb_text(dst, p, "\"");
    p = nb_dash(dst, p, nt_dash(frame, flabel));
    p = nb_text(dst, p, "/>\n");
    var j : usize = 0;
    while (j < pins) {
        p = nb_text(dst, p, "<circle class=\"pin\" cx=\"");
        p = nb_num(dst, p, 2 * NB_PAD + (j * (NB_W - 4 * NB_PAD)) / pins);
        p = nb_text(dst, p, "\" cy=\"");
        p = nb_num(dst, p, NB_TOP);
        p = nb_text(dst, p, "\" r=\"5\" fill=\"");
        p = nb_rgb(dst, p, th, nt_fill(NT_PIN, NT_EXACT));
        p = nb_text(dst, p, "\"/>\n");
        j = j + 1;
    }
    if (block < NM_BLOCKS) {
        if (ns_folded(class)) {
            if (items > 0) {
                p = nb_item(dst, p, th, 0, NT_DEVICE, "C", 0, mos + mim + pas);
            }
        } else {
            var k : usize = 0;
            if (ns_shows_instances(class)) {
                p = nb_run(dst, p, th, k, NT_INSTANCE, "X", sub);
                k = k + sub;
            }
            if (ns_shows_devices(class)) {
                p = nb_run(dst, p, th, k, NT_DEVICE, "M", mos);
                k = k + mos;
                p = nb_run(dst, p, th, k, NT_DEVICE, "C", mim);
                k = k + mim;
                p = nb_run(dst, p, th, k, NT_DEVICE, "P", pas);
            }
        }
    }
    p = nb_text(dst, p, "</svg>\n");
    return p;
}

/// How many times `pat` occurs in s[0..n].
pub fn nb_count(s: []const u8, n: usize, pat: []const u8) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i + pat.len <= n) {
        var j : usize = 0;
        while (j < pat.len and s[i + j] == pat[j]) {
            j = j + 1;
        }
        if (j == pat.len) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// Read "block theme" (two decimal numbers) on stdin, write the SVG still to stdout.
pub fn main() -> void {
    var len : usize = 0;
    var r : isize = 1;
    while (r > 0 and len < 64) {
        r = std.c.read(0, nb_in[len..64].ptr, 64 - len);
        if (r > 0) {
            len += @as(usize, @intCast(r));
        }
    }
    if (len == 0) { std.c.exit(1); }
    var block : u32 = 0;
    var theme : u32 = 0;
    var field : u32 = 0;
    var i : usize = 0;
    while (i < len) {
        const ch : u8 = nb_in[i];
        if (ch >= 48 and ch <= 57) {
            if (field == 0) {
                block = block * 10 + @as(u32, ch - 48);
            } else {
                theme = theme * 10 + @as(u32, ch - 48);
            }
        } else {
            if (ch == 32) {
                field = 1;
            }
        }
        i = i + 1;
    }
    const n : usize = nb_svg(block, theme, &nb_out);
    if (n >= NB_OUT) { std.c.exit(2); }
    _ = std.c.write(1, nb_out[0..n].ptr, n);
}

test every_block_draws_its_planned_items_and_its_pins {
    var b : u32 = 0;
    while (b < NM_BLOCKS) {
        const n : usize = nb_svg(b, 0, &nb_out);
        assert n < NB_OUT;
        assert nb_count(&nb_out, n, "<rect class=\"item\"") == @as(usize, @intCast(ns_block_items(b)));
        assert nb_count(&nb_out, n, "<circle class=\"pin\"") == @as(usize, @intCast(NM_PINS[b]));
        assert nb_count(&nb_out, n, "<rect class=\"frame\"") == 1;
        assert nb_count(&nb_out, n, "</svg>") == 1;
        b = b + 1;
    }
}

test the_folded_array_is_one_box_with_its_exact_count {
    const n : usize = nb_svg(7, 0, &nb_out);
    assert nb_count(&nb_out, n, "<rect class=\"item\"") == 1;
    assert nb_count(&nb_out, n, ">C x63</text>") == 1;
    assert nb_count(&nb_out, n, "class array (derived)") == 1;
}

test the_inverter_is_two_mos_boxes_and_four_pins {
    const n : usize = nb_svg(8, 0, &nb_out);
    assert nb_count(&nb_out, n, ">inverter</text>") == 1;
    assert nb_count(&nb_out, n, ">M1</text>") == 1;
    assert nb_count(&nb_out, n, ">M2</text>") == 1;
    assert nb_count(&nb_out, n, ">X1</text>") == 0;
    assert nb_count(&nb_out, n, "<circle class=\"pin\"") == 4;
}

test the_frame_is_dashed_as_derived_and_items_are_solid {
    const n : usize = nb_svg(11, 0, &nb_out);
    assert nb_count(&nb_out, n, "stroke-dasharray=\"10 6\"") == 1;
    assert nb_count(&nb_out, n, "stroke-dasharray=\"4 4\"") == 0;
    assert nb_count(&nb_out, n, "stroke-dasharray=\"1 5\"") == 0;
    assert nb_count(&nb_out, n, ">X10</text>") == 1;
}

test no_such_block_is_a_dotted_refusal_with_nothing_inside {
    const n : usize = nb_svg(17, 0, &nb_out);
    assert nb_count(&nb_out, n, "<rect class=\"item\"") == 0;
    assert nb_count(&nb_out, n, "<circle class=\"pin\"") == 0;
    assert nb_count(&nb_out, n, "stroke-dasharray=\"1 5\"") == 1;
    assert nb_count(&nb_out, n, ">?</text>") == 1;
}

test both_themes_draw_the_same_marks {
    const a : usize = nb_svg(1, 0, &nb_out);
    const ia : usize = nb_count(&nb_out, a, "<rect class=\"item\"");
    const b : usize = nb_svg(1, 1, &nb_out);
    assert a == b;
    assert nb_count(&nb_out, b, "<rect class=\"item\"") == ia;
    assert ia == 19;
}
