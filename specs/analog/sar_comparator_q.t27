; --- the tests ----------------------------------------------------------------------------------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test the_units_the_clock_and_the_rest_state_are_as_stated {
    var dt : f64 = (SQ_DT_FS as f64);
    var cu : f64 = (SQ_CU_AF as f64);
    // dt / C_unit = 1.6 ps / 2 fF = 800 V/A, the ratio of sar_comparator.t27, so a current word is the current in IUNIT over 64 and a charge-table word (Q / 500 fF) is 250 words of this solver
    assert fabs64(dt / cu * 1000.0 - 800.0) < 0.000001;
    var qs : u64 = SQ_QS;
    var cua : u64 = (SQ_CU_AF as u64);
    assert_eq(qs * cua, 500000);
    var c4 : u64 = SQ_C4;
    assert_eq(c4 * cua, 4000);
    // the lumped capacitors of the square-law model, in these units, are sar_comparator.t27's SC_CAP in its 0.125 fF
    var n : usize = 0;
    while (n < 8) {
        var cm : u64 = SQ_CAP_M4B[n];
        var sc : u64 = (SC_CAP[n]) as u64;
        assert_eq(cm * cua, sc * 125);
        n = n + 1;
    }
    // the offset: ground is 0.5 V up the words, the supply 1.5 V above it, the top of the range 1 V above that
    var off : u32 = SQ_OFF;
    var vdd : u32 = SQ_VDD;
    var top : u32 = SQ_TOP;
    assert_eq(off, 8388608);
    assert_eq(vdd, off + VDD);
    assert_eq(top, vdd + 16777216);
    // the clock: low at step 0, high from step 1 (a step of the grid), and with a fall step it is low again from that step on
    assert_eq(sq_clk_at(0, 0), off);
    assert_eq(sq_clk_at(1, 0), vdd);
    assert_eq(sq_clk_at(2125, 0), vdd);
    assert_eq(sq_clk_at(1249, 1250), vdd);
    assert_eq(sq_clk_at(1250, 1250), off);
    assert_eq(sq_clk_at(2125, 1250), off);
    // the rest: the spec's, the supply on five nodes and ground on dp, dn and net1 one threshold below the higher input; or net1 at a word of its own
    var hh : u32 = 16777;
    var vp : u32 = off + SC_VCM + hh;
    var vn : u32 = off + SC_VCM - hh;
    var v : [8]u32 = [0] ** 8;
    sq_rest(vp, vn, 0, &v);
    assert_eq(v[0], vdd);
    assert_eq(v[1], vdd);
    assert_eq(v[2], vp - SC_VTH_U);
    assert_eq(v[3], vdd);
    assert_eq(v[4], vdd);
    assert_eq(v[5], off);
    assert_eq(v[6], off);
    assert_eq(v[7], vdd);
    sq_rest(vn, vp, 0, &v);
    assert_eq(v[2], vp - SC_VTH_U);
    var n1 : u32 = 20255453;
    sq_rest(vp, vn, n1, &v);
    assert_eq(v[2], n1);
    assert_eq(v[0], vdd);
    // the free start's word is ngspice's operating point of net1, 0.7073 V
    var nv : f64 = sq_volts(n1);
    assert fabs64(nv - NG_F_NET1_V) < 0.000001;
}

test the_source_charge_closure_is_exact_at_the_two_edges_and_the_extensions_and_the_slopes_are_the_charges_own {
    // The closure Qs = -(Qd + Qg) + the edges makes the source terminal's charge equal the drain's at Vds = 0 and zero at a gate drive of 0, exactly, for both devices, so that the charge
    // does not jump when the two ends of a channel exchange their parts (the NMOS tables are read as they are, the PMOS tables negated).
    var xs : [5]u32 = [0, 1000000, 5242880, 12582912, 25165824];
    var kind : u32 = 0;
    while (kind < 2) {
        const pm : bool = kind == 1;
        const tqd : []const u32 = sq_qd_tab(kind);
        const tqg : []const u32 = sq_qg_tab(kind);
        var i : usize = 0;
        while (i < 5) {
            const qd0 : u64 = sq_qt(tqd, xs[i], 0, 0, pm);
            const qg0 : u64 = sq_qt(tqg, xs[i], 0, 0, pm);
            const qs : u64 = sq_qsrc(qd0, qg0, qd0, qg0, sq_qt(tqd, 0, 0, 0, pm), sq_qt(tqg, 0, 0, 0, pm));
            assert_eq(qs, qd0);
            const qdy : u64 = sq_qt(tqd, 0, 0, xs[i], pm);
            const qgy : u64 = sq_qt(tqg, 0, 0, xs[i], pm);
            const qz : u64 = sq_qsrc(qdy, qgy, sq_qt(tqd, 0, 0, 0, pm), sq_qt(tqg, 0, 0, 0, pm), qdy, qgy);
            assert_eq(qz, 0);
            i = i + 1;
        }
        kind = kind + 1;
    }
    // the origin of both tables is the zero of the charge, and a gate drive of 1.5 V on an NMOS holds 7.4 fC of gate charge per um of width, three times a PMOS' ... of the opposite sign
    assert_eq(sq_qt(&TT_QG_N, 0, 0, 0, false), 0);
    assert_eq(sq_qt(&TT_QG_P, 0, 0, 0, true), 0);
    const gn : f64 = sq_wf(sq_qt(&TT_QG_N, VDD, 0, 0, false));
    const gp : f64 = sq_wf(sq_qt(&TT_QG_P, VDD, 0, 0, true));
    assert gn > 0.0;
    assert gp < 0.0;
    // THE EXTENSIONS. Beyond the supply the charge goes on with the slope of the last cell, below a gate drive of 0 with the slope of the first (a gate beyond a channel end, a node kicked over the
    // rail): a step of one cell (2^20 units) past the edge adds exactly the slope of the edge cell, on the gate axis above and below and on the Vds axis above.
    var cell : u32 = 1048576;
    var ypt : u32 = 7000000;
    const s_top : u64 = sq_slope(&TT_QG_N, VDD, ypt, 0, false);
    const q_top : u64 = sc_sadd(sq_qt(&TT_QG_N, VDD + cell, 0, ypt, false), sc_flip(sq_qt(&TT_QG_N, VDD, 0, ypt, false)));
    assert_eq(q_top, s_top);
    const s_bot : u64 = sq_slope(&TT_QG_N, 0, ypt, 0, false);
    const q_bot : u64 = sc_sadd(sq_qt(&TT_QG_N, 0, cell, ypt, false), sc_flip(sq_qt(&TT_QG_N, 0, 0, ypt, false)));
    assert_eq(q_bot, sc_flip(s_bot));
    const s_y : u64 = sq_slope(&TT_QD_P, 9000000, VDD, 1, true);
    const q_y : u64 = sc_sadd(sq_qt(&TT_QD_P, 9000000, 0, VDD + cell, true), sc_flip(sq_qt(&TT_QD_P, 9000000, 0, VDD, true)));
    assert_eq(q_y, s_y);
    assert sc_mag(s_top) > 0;
    assert sc_mag(s_bot) > 0;
    // THE SLOPE IS THE INTERPOLANT'S (FR-002 of M3c, for all four tables): inside a cell the charge moves by exactly slope * step / 2^20, to the 2 words of the two rounded reads
    var x0 : u32 = 2621440;
    var y0 : u32 = 3500000;
    var dx : u32 = 262144;
    var k : u32 = 0;
    var worst : f64 = 0.0;
    while (k < 4) {
        var tab : []const u32 = &TT_QD_N;
        var pmk : bool = false;
        if (k == 1) { tab = &TT_QG_N; }
        if (k == 2) { tab = &TT_QD_P; pmk = true; }
        if (k == 3) { tab = &TT_QG_P; pmk = true; }
        const sx : f64 = sq_wf(sq_slope(tab, x0, y0, 0, pmk));
        const dqx : f64 = sq_wf(sc_sadd(sq_qt(tab, x0 + dx, 0, y0, pmk), sc_flip(sq_qt(tab, x0, 0, y0, pmk))));
        const sy : f64 = sq_wf(sq_slope(tab, x0, y0, 1, pmk));
        const dqy : f64 = sq_wf(sc_sadd(sq_qt(tab, x0, 0, y0 + dx, pmk), sc_flip(sq_qt(tab, x0, 0, y0, pmk))));
        assert fabs64(dqx - sx / 4.0) <= 2.0;
        assert fabs64(dqy - sy / 4.0) <= 2.0;
        worst = worst + fabs64(sx) + fabs64(sy);
        k = k + 1;
    }
    // the slopes are not all zero: a charge table that did not move would pass the test above
    assert worst > 31000.0;
    assert worst < 31300.0;
}

test the_jacobian_is_the_derivative_of_the_residual_at_the_clock_edge_and_along_the_run {
    // The Jacobian of the Newton step against the central differences of its own residual over 1 mV of each node (the fraction of the diagonal of its row that the largest of the 64 entries
    // is off by), at the clock edge and at four states of the run. The current slopes are forward differences of the reads and the charge slopes the cells' own, so the bound is 2 percent,
    // not rounding.
    var out : [8008]u32 = [0] ** 8008;
    var res : [1000]u32 = [0] ** 1000;
    var hh : u32 = 16777;
    const s : u64 = sq_run(hh, false, SQ_K, 400, 0, 0, 0, &out, &res);
    var vp : u32 = SQ_OFF + SC_VCM + hh;
    var vn : u32 = SQ_OFF + SC_VCM - hh;
    var dl : u32 = 16384;
    var steps : [5]usize = [1, 10, 63, 150, 380];
    var worst : f64 = 0.0;
    var lo : f64 = 1.0;
    var i : usize = 0;
    while (i < 5) {
        const j : usize = steps[i];
        var v : [8]u32 = [0] ** 8;
        var v0 : [8]u32 = [0] ** 8;
        var n : usize = 0;
        while (n < 8) {
            v[n] = out[j * 8 + n];
            v0[n] = out[(j - 1) * 8 + n];
            n = n + 1;
        }
        var clk0 : u32 = SQ_VDD;
        if (j == 1) { clk0 = SQ_OFF; }
        const e : f64 = sq_jac_err(&v, &v0, clk0, SQ_VDD, vp, vn, 0, dl, false);
        if (e > worst) { worst = e; }
        if (e < lo) { lo = e; }
        i = i + 1;
    }
    assert worst < 0.02;
    assert worst > 0.012;
    // and it is not the identity of two copies of one function: even the best of the five states is off by a part in a thousand, the forward differences of the current and the chords of the cells
    assert lo > 0.001;
    // NEGATIVE CONTROL: the Jacobian read as its transpose is far from the slopes of the residual (the coupling of the eight nodes is not symmetric)
    var v1 : [8]u32 = [0] ** 8;
    var v10 : [8]u32 = [0] ** 8;
    var n2 : usize = 0;
    while (n2 < 8) {
        v1[n2] = out[63 * 8 + n2];
        v10[n2] = out[62 * 8 + n2];
        n2 = n2 + 1;
    }
    const wrong : f64 = sq_jac_err(&v1, &v10, SQ_VDD, SQ_VDD, vp, vn, 0, dl, true);
    assert wrong > 0.2;
}

test the_decision_time_at_plus_and_minus_2_mv_is_within_2_percent_of_ngspice_and_inside_the_reports_limit {
    // The short run, 438 steps of 1.6 ps from rest (the clock rises at step 1), the inputs 0.75 V +- 2 mV (h = 16777 units). THE DECISION TIME is the first output through 0.75 V counted from the
    // clock's 50 % point: 613.074 ps at +2 mV and 613.151 ps at -2 mV (the circuit is mirror-symmetric; the 0.08 ps is rounding), against ngspice-47's 602.537 ps on the golden comparator at 27 C
    // (the settled start), 603.316 ps on its backward Euler grid of the same 1.6 ps, and the external team's report 607 ps.
    var out : [3512]u32 = [0] ** 3512;
    var res : [438]u32 = [0] ** 438;
    var hh : u32 = 16777;
    const sp : u64 = sq_run(hh, false, SQ_K, SQ_NS, 0, 0, 0, &out, &res);
    const tp : f64 = sq_ps(sq_t_first(&out, SQ_NS));
    assert tp > 613.07;
    assert tp < 613.08;
    assert(sq_sign(&out, SQ_NS));
    var rmax : u32 = 0;
    var i : usize = 0;
    while (i < (SQ_NS as usize)) {
        if (res[i] > rmax) { rmax = res[i]; }
        i = i + 1;
    }
    // THE ARITHMETIC: the last Newton residual of all 438 steps is at most 706 units (42 uV), under the bound of 1600 (0.10 mV) the long run needs
    assert rmax <= 750;
    assert rmax > 700;
    const sm : u64 = sq_run(hh, true, SQ_K, SQ_NS, 0, 0, 0, &out, &res);
    const tm : f64 = sq_ps(sq_t_first(&out, SQ_NS));
    assert tm > 613.15;
    assert tm < 613.16;
    // NEGATIVE CONTROL, the sign: the inputs exchanged decide the other way
    assert(!sq_sign(&out, SQ_NS));
    assert fabs64(tm - tp) < 0.1;
    // THE GAP against ngspice, in percent: +1.749 and +1.762 against the trapezoidal run, +1.617 against the backward Euler run on the model's own grid, +1.001 against the report's 607 ps; the
    // bar is 10 percent
    const gp : f64 = sp_rel(tp, NG_S_FIRST_PS[0]);
    const gm : f64 = sp_rel(tm, NG_S_FIRST_PS[0]);
    assert gp > 0.0174;
    assert gp < 0.0176;
    assert gm > 0.0175;
    assert gm < 0.0177;
    const gb : f64 = sp_rel(tp, NG_BE_FIRST_PS[6]);
    assert gb > 0.0161;
    assert gb < 0.0163;
    const gr : f64 = sp_rel(tp, 607.0);
    assert gr > 0.0099;
    assert gr < 0.0101;
    assert gp < SQ_BAR;
    assert gm < SQ_BAR;
    // the report's lower limit is 10 ps and its upper 10 ns: the decision time is inside, 61 times the lower limit
    assert tp > 10.0;
    assert tp < 10000.0;
    assert tp > 60.0 * 10.0;
    // THE PINS: the order-sensitive fold of all 438 x 8 samples of each run; one changed word of a table, of the solver or of the run moves them
    assert_eq(sp, 6095366964604702313);
    assert_eq(sm, 8962847652799617542);
}

test the_decision_time_follows_ngspice_over_the_input_sweep_and_the_free_start_and_the_longer_inputs_stay_within_3_2_percent {
    // The input down to 1 unit (0.06 uV a side). ngspice's decision time rises from 602.5 ps at 2 mV to 610.15 ps at the limit (the logarithm of the input, saturating: the first output is the common-mode
    // rise of both), the model's from 613.1 to 629.1 ps; the gap grows from 1.75 to 3.10 percent and is the same sign at every input. Three inputs here, the others in the header.
    var out : [3512]u32 = [0] ** 3512;
    var res : [438]u32 = [0] ** 438;
    var hs : [3]u32 = [4194, 262, 1];
    var ng : [3]f64 = [NG_S_FIRST_PS[1], NG_S_FIRST_PS[3], NG_S_FIRST_PS[6]];
    var lo : [3]f64 = [0.02640, 0.03050, 0.03090];
    var hi : [3]f64 = [0.02660, 0.03070, 0.03110];
    var i : usize = 0;
    while (i < 3) {
        const s : u64 = sq_run(hs[i], false, SQ_K, SQ_NS, 0, 0, 0, &out, &res);
        const t : f64 = sq_ps(sq_t_first(&out, SQ_NS));
        const g : f64 = sp_rel(t, ng[i]);
        assert g > lo[i];
        assert g < hi[i];
        assert g < SQ_BAR;
        assert(sq_sign(&out, SQ_NS));
        i = i + 1;
    }
    // THE FREE START: net1 at the DC operating point of ngspice (0.7073 V, where the leakage of the pair and of the tail balance) instead of the spec's 0.401 V. The model moves by +1.8 ps, ngspice by +4.6 ps;
    // the model against ngspice's own free start is +1.27 percent (the report: 607 ps, ngspice 607.145 ps).
    var n1 : u32 = 20255453;
    var hh : u32 = 16777;
    const sf : u64 = sq_run(hh, false, SQ_K, SQ_NS, 0, n1, 0, &out, &res);
    const tf : f64 = sq_ps(sq_t_first(&out, SQ_NS));
    assert tf > 614.85;
    assert tf < 614.87;
    const gf : f64 = sp_rel(tf, NG_F_FIRST_PS[0]);
    assert gf > 0.0126;
    assert gf < 0.0128;
    assert gf < SQ_BAR;
    const gfr : f64 = sp_rel(tf, 607.0);
    assert gfr > 0.0129;
    assert gfr < 0.0130;
}

test the_long_run_reaches_the_rails_at_2_ns_and_the_reset_phase_at_3_4_ns_and_the_nodes_follow_ngspice_before_the_decision {
    // The long run: the +2 mV input, the clock falling at step 1250 (2 ns) and the run to step 2125 (3.4 ns, 1.4 ns into the reset). 2125 steps: the last Newton residual is at most 1545 units (0.09 mV)
    // at all of them, the clock-fall step included (the nodes are kicked to -0.28 V on ap, -0.40 V on n_clkc in one step, and the floor of the words is -0.5 V).
    var out : [17008]u32 = [0] ** 17008;
    var res : [2125]u32 = [0] ** 2125;
    var hh : u32 = 16777;
    const s : u64 = sq_run(hh, false, SQ_K, SQ_NL, 0, 0, SQ_JF, &out, &res);
    var rmax : u32 = 0;
    var i : usize = 0;
    while (i < (SQ_NL as usize)) {
        if (res[i] > rmax) { rmax = res[i]; }
        i = i + 1;
    }
    assert rmax <= 1600;
    assert rmax > 1500;
    // THE LEVELS the report asks for after the decision (winner within 50 mV of 1.5 V, loser within 50 mV of 0 V), read at step 1249 (2 ns after the start, the step before the clock falls): dp 1.49932 V,
    // dn 2.27 mV; ngspice at 2 ns after the clock's 50 % point: 1.49884 V and 2.283 mV (trapezoidal), 1.49883 V and 2.280 mV (backward Euler on the 1.6 ps grid). The gaps are 0.48 mV and 0.01 mV.
    const dp : f64 = sq_volts(out[1249 * 8 + 5]);
    const dn : f64 = sq_volts(out[1249 * 8 + 6]);
    assert dp > 1.4993;
    assert dp < 1.4994;
    assert dn > 0.00225;
    assert dn < 0.00227;
    const lv_dp : f64 = NG_NODES_TRAP[12 * 8 + 5];
    const lv_dn : f64 = NG_NODES_TRAP[12 * 8 + 6];
    assert fabs64(dp - lv_dp) > 0.00048;
    assert fabs64(dp - lv_dp) < 0.00050;
    assert fabs64(dn - lv_dn) < 0.00003;
    assert fabs64(dp - lv_dp) < SQ_BAR_LEVEL_V;
    assert fabs64(dn - lv_dn) < SQ_BAR_LEVEL_V;
    // THE RESET the report asks for (both outputs within 50 mV of 0 V): at step 2125 dp is 3.06 mV and dn -0.17 mV; ngspice at 3.4 ns, trapezoidal: 3.265 mV and -0.247 mV, backward Euler 3.346 mV and
    // -0.253 mV. The gaps are 0.21 mV and 0.08 mV. In between (the outputs falling through 1 V at 2.4 ns) the model is 30 to 60 mV off: the time of a falling edge, not a level.
    const rp : f64 = sq_volts(out[2125 * 8 + 5]);
    const rn : f64 = sq_volts(out[2125 * 8 + 6]);
    assert rp > 0.00307;
    assert rp < 0.00309;
    assert rn < 0.0 - 0.00016;
    assert rn > 0.0 - 0.00018;
    assert fabs64(rp - NG_RESET_TRAP[7 * 8 + 5]) < 0.00020;
    assert fabs64(rp - NG_RESET_TRAP[7 * 8 + 5]) > 0.00017;
    assert fabs64(rn - NG_RESET_TRAP[7 * 8 + 6]) < 0.00009;
    assert fabs64(rp - NG_RESET_TRAP[7 * 8 + 5]) < SQ_BAR_LEVEL_V;
    assert fabs64(rn - NG_RESET_TRAP[7 * 8 + 6]) < SQ_BAR_LEVEL_V;
    // THE RESOLUTION TIME (|dp - dn| through 0.75 V), not a row of the report: 1040.5 ps against ngspice's 1094.3 ps, 4.9 percent early. The regeneration of the model is faster than the circuit's by that; the
    // decision (the first output, before the regeneration) is not.
    const tr : f64 = sq_ps(sq_t_res(&out, SQ_NL));
    assert tr > 1040.6;
    assert tr < 1040.8;
    const gr : f64 = sp_rel(tr, NG_S_RES_PS[0]);
    assert gr < 0.0 - 0.0489;
    assert gr > 0.0 - 0.0491;
    // THE NODES at the 13 times of the rows (the eight nodes each) against ngspice on the model's own 1.6 ps grid: from 50 ps to 500 ps, with the decision still to come, the largest distance is 27.1 mV
    // (ap, an: the model discharges them 1 to 2 percent early), and 25.0 mV against the trapezoidal run; up to 1.5 ns, through the regeneration, 83.9 mV against the grid (the dp and dn of the resolution
    // edge, 4.9 percent early in time) and 88.6 mV against the trapezoidal run. The clock edge itself, the first row, is 80.9 mV off on ap (the kick is 0.2 V and the model has it 8 percent large).
    const e_pre : f64 = sq_node_err(&out, &NG_NODES_BE, &NG_NODE_T, 3, 10);
    assert e_pre > 0.0270;
    assert e_pre < 0.0272;
    const e_pre_t : f64 = sq_node_err(&out, &NG_NODES_TRAP, &NG_NODE_T, 3, 10);
    assert e_pre_t > 0.0249;
    assert e_pre_t < 0.0251;
    const e_all : f64 = sq_node_err(&out, &NG_NODES_BE, &NG_NODE_T, 1, 12);
    assert e_all > 0.0833;
    assert e_all < 0.0836;
    const e_all_t : f64 = sq_node_err(&out, &NG_NODES_TRAP, &NG_NODE_T, 1, 12);
    assert e_all_t > 0.0881;
    assert e_all_t < 0.0883;
    const e_edge : f64 = fabs64(sq_node_at(&out, 0.0, 0) - NG_NODES_BE[0]);
    assert e_edge > 0.0808;
    assert e_edge < 0.0810;
    assert_eq(s, 7506095865634310143);
}

test the_negative_controls_the_charge_removed_fails_and_so_do_the_wrong_closure_the_wrong_tables_and_too_few_newton_iterations {
    var out : [3512]u32 = [0] ** 3512;
    var res : [438]u32 = [0] ** 438;
    var hh : u32 = 16777;
    // CHARGE REMOVED (the devices' own charge off, the lumped capacitors of the square-law model on every node, 4, 4, 6, 2, 2, 4, 4, 2 fF): the decision comes at 5.40 ps, 111 times too fast (ngspice 602.5 ps),
    // below the report's 10 ps lower limit. It is the old 5.35 ps of the no-charge model at 0.1 ps, reached here at 1.6 ps. At this step the no-charge latch does not regenerate: both outputs end at 0.786 V,
    // 1.5 uV apart, so the 5.40 ps is the first output's common-mode rise and the control is a control of the time, not of the sign.
    const s1 : u64 = sq_run(hh, false, SQ_K, SQ_NS, SQ_M_NOCHARGE, 0, 0, &out, &res);
    const t1 : f64 = sq_ps(sq_t_first(&out, SQ_NS));
    assert t1 > 5.400;
    assert t1 < 5.402;
    assert t1 < 10.0;
    const e1 : f64 = sq_volts(out[(SQ_NS * SC_NN + SC_DP) as usize]) - sq_volts(out[(SQ_NS * SC_NN + SC_DN) as usize]);
    assert fabs64(e1) < 0.00001;
    assert sq_volts(out[(SQ_NS * SC_NN + SC_DP) as usize]) > 0.7859;
    assert sq_volts(out[(SQ_NS * SC_NN + SC_DP) as usize]) < 0.7860;
    assert sp_rel(t1, NG_S_FIRST_PS[0]) < 0.0 - 0.99;
    assert NG_S_FIRST_PS[0] / t1 > 111.0;
    assert NG_S_FIRST_PS[0] / t1 < 112.0;
    // BODY EFFECT REMOVED (the source-to-bulk voltage forced to 0, the 2-D read of the tables): 570.6 ps, 5.31 percent under ngspice where the model is 1.75 percent over, and inside the 10 percent bar:
    // the body effect is worth 7.5 percent of the decision time without it and a bar of 3 percent sees it, one of 10 does not.
    const s2 : u64 = sq_run(hh, false, SQ_K, SQ_NS, SQ_M_NOBODY, 0, 0, &out, &res);
    const t2 : f64 = sq_ps(sq_t_first(&out, SQ_NS));
    assert t2 > 570.55;
    assert t2 < 570.65;
    const g2 : f64 = sp_rel(t2, NG_S_FIRST_PS[0]);
    assert g2 < 0.0 - 0.0528;
    assert g2 > 0.0 - 0.0532;
    assert fabs64(g2) > 3.0 * 0.0175;
    // THE SOURCE CHARGE WITHOUT ITS CLOSURE (Qs = -(Qd + Qg), the bulk's charge dropped on the source node): the Newton step does not converge, the last residual is 1.88e6 units (0.11 V), and the time it
    // reads, 544 ps, is nothing: the closure of the two edges is what lets the system be solved
    const s3 : u64 = sq_run(hh, false, SQ_K, SQ_NS, SQ_M_NOCLOSURE, 0, 0, &out, &res);
    var r3 : u32 = 0;
    var i : usize = 0;
    while (i < (SQ_NS as usize)) {
        if (res[i] > r3) { r3 = res[i]; }
        i = i + 1;
    }
    assert r3 > 1800000;
    assert r3 < 2000000;
    // THE CHARGE TABLES IN THE WRONG SLOTS (the PMOS tables for the NMOS devices and the reverse): the run runs off the range, 4.27e9 units of residual
    const s4 : u64 = sq_run(hh, false, SQ_K, SQ_NS, SQ_M_SWAPQ, 0, 0, &out, &res);
    var r4 : u32 = 0;
    i = 0;
    while (i < (SQ_NS as usize)) {
        if (res[i] > r4) { r4 = res[i]; }
        i = i + 1;
    }
    assert r4 > 4000000000;
    // TOO FEW NEWTON ITERATIONS: K = 2 leaves 2.76e5 units (16 mV) at the clock edge and reads 612.99 ps, within 0.1 ps of the converged 613.07 ps: the time is right and the residual is 180 times the
    // bound, so it is the residual bound and not the time that refuses K = 2. K = 1 leaves 3.3e6 units and reads 614.16 ps.
    const s5 : u64 = sq_run(hh, false, 2, SQ_NS, 0, 0, 0, &out, &res);
    const t5 : f64 = sq_ps(sq_t_first(&out, SQ_NS));
    var r5 : u32 = 0;
    i = 0;
    while (i < (SQ_NS as usize)) {
        if (res[i] > r5) { r5 = res[i]; }
        i = i + 1;
    }
    assert r5 > 275000;
    assert r5 < 277000;
    assert r5 > 150 * 1600;
    assert fabs64(t5 - 613.074) < 0.15;
    assert s1 != s2;
    assert s2 != s3;
    assert s3 != s4;
    assert s4 != s5;
}

test the_reference_netlist_is_the_golden_comparator_the_settled_start_is_the_reports_and_the_scheme_error_is_a_tenth_of_a_percent {
    // THE NETLIST: the written-out comparator (sar_cmp_q_ref50.cir) at 50 C and the golden start gives the first output through 0.75 V 523.032, 528.006, 529.386 and 529.741 ps after the clock, the decision times
    // the golden subcircuit gave in sar_cmp_psp_real.cir (NG_RL_FIRST_PS of sar_comparator_psp.t27): to a femtosecond, so the netlist whose 27 C run the model is judged by is that circuit.
    var i : usize = 0;
    while (i < 4) {
        assert fabs64(NG_U50_FIRST_PS[i] - NG_RL_FIRST_PS[i]) < 0.0011;
        i = i + 1;
    }
    // THE START: the golden deck starts from its initial conditions with uic and a clock at 200 ps, and the nodes inside the devices, which start at 0 V, disturb the others for longer than the 200 ps (n_clkc is at
    // 1.30 V at the clock, dp and dn 0.62 V): its 27 C decision time is 508.1 ps. The settled start, the operating point with the eight nodes forced to the spec's rest, gives 602.5 ps at 27 C and 632.6 ps at 50 C;
    // the free start (net1 where it settles, 0.7073 V) 607.145 ps, which is the external team's report to 0.02 percent. The no-charge model's 5.35 ps was judged against the 523.0 ps of the disturbed start
    // (98 times too fast); against the settled start it is 118 times.
    assert NG_U_FIRST_PS[0] > 508.1;
    assert NG_U_FIRST_PS[0] < 508.2;
    assert NG_S50_FIRST_PS[0] > 632.5;
    assert NG_S50_FIRST_PS[0] < 632.6;
    assert NG_S50_FIRST_PS[0] / 5.35 > 118.0;
    assert NG_S50_FIRST_PS[0] / 5.35 < 118.4;
    assert sp_rel(NG_F_FIRST_PS[0], 607.0) > 0.0002;
    assert sp_rel(NG_F_FIRST_PS[0], 607.0) < 0.0003;
    assert sp_rel(NG_S_FIRST_PS[0], 607.0) < 0.0 - 0.0073;
    assert sp_rel(NG_S_FIRST_PS[0], 607.0) > 0.0 - 0.0074;
    assert NG_S_FIRST_PS[0] > 10.0;
    // THE SCHEME: ngspice's backward Euler on a fixed grid of 0.2, 0.4, 0.8 and 1.6 ps, against its converged trapezoidal run: the decision time is within 0.01, 0.02, 0.10 and 0.13 percent (+2 mV), within
    // 0.01, 0.02, 0.12 and 0.16 percent (+0.5 mV), so the model's one step of 1.6 ps is not an error of the scheme at the resolution of this comparison; the resolution time, 0.04 percent to 0.3 percent.
    var worst : f64 = 0.0;
    var w2 : f64 = 0.0;
    var k : usize = 0;
    while (k < 4) {
        const a : f64 = fabs64(sp_rel(NG_BE_FIRST_PS[2 * k], NG_S_FIRST_PS[0]));
        const b : f64 = fabs64(sp_rel(NG_BE_FIRST_PS[2 * k + 1], NG_S_FIRST_PS[1]));
        if (a > worst) { worst = a; }
        if (b > worst) { worst = b; }
        const c : f64 = fabs64(sp_rel(NG_BE_RES_PS[2 * k], NG_S_RES_PS[0]));
        if (c > w2) { w2 = c; }
        k = k + 1;
    }
    assert worst < 0.0017;
    assert worst > 0.0016;
    assert w2 < 0.0034;
    // the reference rows are ngspice's own numbers: on the settled start the 13 node rows of the trapezoidal run and of the 1.6 ps grid agree to 5 mV from 25 ps on (the edge itself, the first two rows, differ
    // by the time of the clock's 50 % point, 1.0 ps against 0.77)
    var worst_rows : f64 = 0.0;
    var r : usize = 2;
    while (r < 13) {
        var n : usize = 0;
        while (n < 8) {
            const d : f64 = fabs64(NG_NODES_TRAP[r * 8 + n] - NG_NODES_BE[r * 8 + n]);
            if (d > worst_rows) { worst_rows = d; }
            n = n + 1;
        }
        r = r + 1;
    }
    assert worst_rows < 0.005;
    assert worst_rows > 0.0045;
}

test the_crossing_search_takes_the_last_interval_and_a_sample_on_the_level_ends_a_crossing_but_does_not_start_one {
    // The real runs cross 0.75 V inside an interval that is not the last and on no sample, so only a hand-built waveform sees the bounds of sq_cross. Three rows of 8 words, all zero but the column SC_DP, which
    // is the one read; the level is the 0.75 V word, ground offset included.
    var out : [24]u32 = [0] ** 24;
    var lvl : u32 = SQ_OFF + SC_VCM;
    // THE LAST INTERVAL: rows [lvl-4, lvl+4], n = 1: half way through the only interval, 0.5 step = 2048 at SC_QB = 12 fractional bits. Kills `while (j <= n)` to `j < n` (line 530), which never looks at the
    // interval and says SC_NONE.
    out[5] = lvl - 4;
    out[13] = lvl + 4;
    const a : u32 = sq_cross(&out, SC_DP, 1, lvl);
    assert a == 2048;
    // A SAMPLE ON THE LEVEL DOES NOT START A CROSSING: rows [lvl+5, lvl, lvl+5], n = 2: the signal touches the level and goes back up, it never rises through it (the first interval falls, the second starts on the
    // level). Kills `y0 < lvl` to `y0 <= lvl` (line 533), which takes the second interval as a crossing at 1 step = 4096.
    out[5] = lvl + 5;
    out[13] = lvl;
    out[21] = lvl + 5;
    const b : u32 = sq_cross(&out, SC_DP, 2, lvl);
    assert b == SC_NONE;
    // A SAMPLE ON THE LEVEL ENDS A CROSSING: rows [lvl-4, lvl, lvl+4], n = 2: the first interval ends on the level, the crossing is at its end, 1 step = 4096. Kills `y1 >= lvl` to `y1 > lvl` (line 533), which
    // lets the first interval go and finds the second one starting on the level, so SC_NONE.
    out[5] = lvl - 4;
    out[13] = lvl;
    out[21] = lvl + 4;
    const c : u32 = sq_cross(&out, SC_DP, 2, lvl);
    assert c == 4096;
}

test the_decision_time_is_none_when_no_output_reaches_0_75_v_and_the_sign_of_equal_outputs_is_false {
    // sq_t_first: every other test calls it on a run that crosses, so its t is never SC_NONE and the guard on SC_NONE never fires.
    var out : [3512]u32 = [0] ** 3512;
    var res : [438]u32 = [0] ** 438;
    var hh : u32 = 16777;
    // THE EARLY RUN: the +2 mV input, the first 100 steps (160 ps), the outputs are far under 0.75 V (the first crossing is at 613 ps): no crossing, so SC_NONE. Kills the dropped `if (t == SC_NONE)` (line 549),
    // which would return SC_NONE less the half step 2048, 4294965247.
    const s : u64 = sq_run(hh, false, SQ_K, 100, 0, 0, 0, &out, &res);
    const t1 : u32 = sq_t_first(&out, 100);
    assert t1 == SC_NONE;
    // the same on a hand-built waveform: two rows of zeros, neither output near the level (kills the same mutant, without a run)
    var z : [16]u32 = [0] ** 16;
    const t2 : u32 = sq_t_first(&z, 1);
    assert t2 == SC_NONE;
    // POSITIVE CONTROL: the decision time is the first crossing less the half step; dp rises from 4 words under the level to 4 over it in the one interval, 2048, and the half step takes it to 0
    var lvl : u32 = SQ_OFF + SC_VCM;
    z[5] = lvl - 4;
    z[13] = lvl + 4;
    const t3 : u32 = sq_t_first(&z, 1);
    assert t3 == 0;
    // THE SIGN OF EQUAL OUTPUTS: dp = dn in the last row is not "VDP > VDN". Kills `dp > dn` to `dp >= dn` (line 555), which says true.
    z[13] = lvl;
    z[14] = lvl;
    const q1 : bool = sq_sign(&z, 1);
    assert(!q1);
    // POSITIVE CONTROLS: one word more on dp is true, one word more on dn is false
    z[13] = lvl + 1;
    const q2 : bool = sq_sign(&z, 1);
    assert(q2);
    z[13] = lvl - 1;
    const q3 : bool = sq_sign(&z, 1);
    assert(!q3);
    assert s != 0;
}

test the_resolution_time_search_takes_the_last_interval_and_a_difference_on_the_level_ends_a_crossing_but_does_not_start_one {
    // The same three cases as the crossing search, on |dp - dn| through SC_VCM (0.75 V, no ground offset: a difference has none). dn is 0 words, so |dp - dn| is dp, in the column SC_DP; the half step 2048 is
    // subtracted from the time, so each crossing is placed after it.
    var out : [24]u32 = [0] ** 24;
    var vcm : u32 = SC_VCM;
    // THE LAST INTERVAL: dp rows [VCM-8, VCM-4, VCM+4], n = 2: the crossing is half way through the last interval, 1 step + 0.5 step - 0.5 step = 4096. Kills `while (j <= n)` to `j < n` (line 561), which stops
    // before the last interval and says SC_NONE.
    out[5] = vcm - 8;
    out[13] = vcm - 4;
    out[21] = vcm + 4;
    const a : u32 = sq_t_res(&out, 2);
    assert a == 4096;
    // A DIFFERENCE ON THE LEVEL DOES NOT START A CROSSING: dp rows [VCM+5, VCM, VCM+5], n = 2: the difference touches the level and goes back up. Kills `y0 < SC_VCM` to `y0 <= SC_VCM` (line 564), which takes
    // the second interval as a crossing at 1 step - 0.5 step = 2048.
    out[5] = vcm + 5;
    out[13] = vcm;
    out[21] = vcm + 5;
    const b : u32 = sq_t_res(&out, 2);
    assert b == SC_NONE;
    // A DIFFERENCE ON THE LEVEL ENDS A CROSSING: dp rows [VCM-4, VCM, VCM+4], n = 2: the first interval ends on the level, 1 step - 0.5 step = 2048. Kills `y1 >= SC_VCM` to `y1 > SC_VCM` (line 564), which lets
    // the first interval go and finds the second one starting on the level, so SC_NONE.
    out[5] = vcm - 4;
    out[13] = vcm;
    out[21] = vcm + 4;
    const c : u32 = sq_t_res(&out, 2);
    assert c == 2048;
}

test the_resolution_time_reads_both_outputs_of_the_row_before_the_crossing_and_the_long_run_pins_it_to_the_word {
    // GROUP B, the start of the crossing interval. y0 of sq_t_res enters only the interpolation of the interval that crosses, so a real run needs a narrow pin to see a wrong y0. Hand-built first: three rows,
    // dp and dn both moving, |dp - dn| = VCM-80, VCM-40, VCM+40; the crossing is in the second interval (j = 2), where the indices (j-1)/SC_NN of the mutants differ from (j-1)*SC_NN.
    var out : [24]u32 = [0] ** 24;
    var vcm : u32 = SC_VCM;
    out[5] = vcm + 20;
    out[6] = 100;
    out[13] = vcm + 160;
    out[14] = 200;
    out[21] = vcm + 440;
    out[22] = 400;
    // y0 = VCM-40, y1 = VCM+40, frac = 40 / 80 of a step = 2048: 1 step + 0.5 step - 0.5 step = 4096.
    const h : u32 = sq_t_res(&out, 2);
    assert h == 4096;
    // The four mutants of line 562, by hand: dp[j-1] to dp[j] reads y0 = |dp2 - dn1| = VCM+240, not under the level, so SC_NONE; dp[(j-1)/SC_NN] reads dp0, y0 = |dp0 - dn1| = VCM-180, frac 180 / 220 =
    // 3351, time 4096 + 3351 - 2048 = 5399; dn[j-1] to dn[j] reads y0 = |dp1 - dn2| = VCM-240, frac 240 / 280 = 3510, time 5558; dn[(j-1)/SC_NN] reads dn0, y0 = |dp1 - dn0| = VCM+60, not under the level, SC_NONE.
    // All four differ from 4096 on this waveform.
    // THE LONG RUN pins the same function to the word: the +2 mV run with the clock falling at step 1250 (jf = 1250), the resolution time read to the integer, 2664251 = 650.452 steps = 1040.72 ps. The word was
    // read from the lab on the unmodified spec (the 10 low bits of sq_t_res less 2663936, probed one bit per test, then equality; the first 700 steps give the same word, the crossing is in step 651 at 0.952 of
    // its interval). A wrong y0 moves the crossing by a fraction of a step, which the 0.2 ps window of the long-run test above does not see; one word here does.
    var out2 : [17008]u32 = [0] ** 17008;
    var res2 : [2125]u32 = [0] ** 2125;
    var hh : u32 = 16777;
    const s : u64 = sq_run(hh, false, SQ_K, SQ_NL, 0, 0, SQ_JF, &out2, &res2);
    const tl : u32 = sq_t_res(&out2, SQ_NL);
    assert_eq(tl, 2664251);
    assert s != 0;
}
