// SPDX-License-Identifier: Apache-2.0
; specs/analog/sar_kick.t27 -- where the SAR ADC comparator's decision offset comes from: the clock edge kicks both top plates, and the N half's bottom plates are driven through one transmission gate more than the P half's
; M4e-offset of the SAR ADC milestone (#10888, sub-issue #10941, part of #10818, epic #10486). M4e (specs/analog/sar_adc.t27, #10854) matches 30 of 31 conversions of the golden deck only with two fitted
; numbers, a top-plate parasitic Cp and a comparator offset of +6.7 mV. M4b-psp (#10856) measured the golden latch itself: dynamic_comparator flips at 0 (+-0.12 uV) and
; dynamic_comparator_top at -0.153 mV, in the SAME sign convention as the converter's offset (the latch decides "above" when VDP - VDN + off > 0; off = +0.153 mV), so the latch is not
; the 6.7 mV. This file names the source, shows it with ngspice + PSP103 experiments that change one thing at a time, and carries the numbers measured on the netlist. It runs
; no solver: it is pinned data, the estimators that read it, and tests. sar_adc.t27 takes its offset from here instead of from a fit.
; -
; THE REFERENCE (every number below is ngspice-47 + the IHP SG13G2 PSP103 model of IHP-Open-PDK 21133f21, mos_tt and cap_typ, 50 C, the golden deck of uberWAVE wp2-parser/golden/top.spice,
; GPL-2.0, fetched at run time and never vendored, sha256 c5ad548a3e1a181f1b8e81e92ead2f630e14861a36b796169f4fec6b95746e23). The experiments are the decks specs/analog/decks/sar_off_*.cir:
; each is the golden top level re-wired (the deck's own subcircuits come from the run-time file SAR_GOLDEN_SUBCKTS) with ONE thing changed, named in its header. sar_off_base.cir changes
; nothing. They run either the golden sine (sar_amp 0.6, 1.1 us, the first two conversions) or a DC input of sar_dmv millivolts (sar_amp 0, 150 ns for the first decision, 480 ns for a
; whole conversion). The quantity read everywhere is D = V(VDP) - V(VDN) at the instant the comparator clock clkc crosses 0.1 V going up: before the clock edge has reached the comparator
; (D moves by less than 0.1 mV between clkc = 0.02 V and 0.2 V, and by at most 0.08 mV from 3 ns earlier for every decision from the fourth on), so it is the plates as the DAC left them.
; The decision is the bit the latch gives (the bottom plate Bit_10 settles to 0 V for "VDP above VDN"). The flip point is the D at which the decision changes; the offset is minus it.
; -
; THE RESULT. At the first decision of a conversion (all ten bottom plates idle) the golden comparator decides "above" while VDP is still 9.42 mV below VDN; at the last two decisions
; (nine and ten plates moved) 6.66 mV and 6.90 mV below. The latch itself is 0.15 mV of that. The rest, 9.3 mV at the first decision and 6.5 to 6.7 mV at the last, is the CLOCK EDGE'S
; KICKBACK read through two unequal plates: when clkc rises, the comparator's tail node falls from 0.64 V and the drains of the input pair fall from 1.5 V, and the gate-source and
; gate-drain capacitances of the 36-unit input devices (XM3, XM4) push charge into VDP and VDN. Both plates fall, by 22.7 mV (VDP) and 30.2 mV (VDN) at the instant clkc passes half of
; Vdd; the difference, 7.5 mV, is what the latch reads as "VDP above VDN by 7.5 mV" (its regeneration then needs about 2 mV more: the offset is 9.4 mV). Plates that held the charge
; stiffly would fall by 6.87 mV each and the same together. The N half falls more because its bottom plates sit behind one more transmission gate: Bit_k is driven by DAC_control's
; inverter, or held at VCM by its tgate x2, and the N half's Bit_k_n is neg_bottom_plate_logic's x11 (idle: Bit_k_n is Bit_k through x11, so VCM through two gates in series) or x15
; behind an inverter x12 (moved), so the N plates are softer at the nanosecond scale of the kick and VDN moves more. Row d4 tests exactly that: a resistor of one tgate's size added to
; the P half's plates makes the circuit symmetric and the offset falls to -0.9 mV.
; -
; THE EXPERIMENTS (first decision, DC input, flip point = the D between the two inputs that bracket it; offset = minus the bracket's middle, +- half the bracket). The table is also in
; specs/analog/decks/sar_off_base.cir. Moved-by is against the base row, its +- the two half brackets added. Cp is the first plate step (two directions averaged) in units of the 9 um cap_cmim.
;   row  candidate                              change (deck)                                      offset (mV)       moved by (mV)    dVDP / dVDN at clkc 0.75 V (mV)   Cp
;   0    base: the golden circuit               sar_off_base.cir                                   +9.42 +- 0.20     --               -22.7 / -30.2                     0.647
;   a    tracking switches                      sar_off_idealsw.cir: ideal 500 ohm switches        +9.19 +- 0.20     -0.23 +- 0.40    -23.0 / -30.6                     0.640
;   b    comparator kickback onto the plates    sar_off_nokick.cir: ideal buffers between the      +0.03 +- 0.15     -9.38 +- 0.35    -0.06 / -0.10                     0.621
;                                                plates and the comparator (55 fF stands in for its gates)
;   d1   N half's bottom-plate drive            sar_off_nplate.cir: N plates ideal (1.5 V - P)     -25.79 +- 0.50    -35.20 +- 0.70   -17.1 / +3.3                      0.582
;   d2   P half's bottom-plate drive            sar_off_pplate.cir: P plates ideal (1.5 V - N)     +43.87 +- 0.99    +34.45 +- 1.19   +11.1 / -24.9                     0.676
;   d3   both halves' bottom-plate drive        sar_off_plates.cir: both ideal, symmetric          +0.27 +- 0.25     -9.14 +- 0.45    -6.86 / -6.88                     0.582
;   d4   the extra tgate, given to the P half    sar_off_pseries.cir: 2592 ohm (a tgate's own, sar_off_ron.cir) -0.89 +- 0.25     -10.31 +- 0.45   -29.7 / -29.2                     0.690
;                                                between each P bottom plate and its Bit_k   (1300 ohm: +4.09 +- 0.25; 3900 ohm: -4.19 +- 1.00)
;   c    DAC settling when clkc fires           base sine run (22 decisions): D read 3 ns and 10 ns earlier than clkc = 0.1 V
;                                                under 0.1 mV (3 ns) from the fourth decision on, 0.26 mV at the second and third; 10 ns: under 0.31 mV from the fifth on
; THE TGATE (d4). sar_off_ron.cir measures the golden tgate conducting at VCM: 2592 ohm (the inverter's pmos 1880 ohm, nmos 1427 ohm at a rail). Joining each P bottom plate to its Bit_k
; node through a resistor of that size makes the P half's drive the same as the N half's (both halves' capacitors behind one resistor from the common Bit_k node, for an idle bit): the plates
; then fall by 29.7 and 29.2 mV and the offset falls from +9.42 to -0.89 +- 0.25 mV. It is nearly linear in the resistor, +9.42, +4.09, -0.89, -4.19 mV at 0, 1300, 2592, 3900 ohm, and crosses the
; latch's own +0.153 mV at 2320 ohm, 10.5 percent under the tgate's 2592: the extra transmission gate IS the asymmetry, to the accuracy of this reading (the series resistor is not
; exactly the N half's topology, and 0.9 mV is left over). The top-plate load Cp read from the first step grows with the resistor, 0.62, 0.69, 0.85, because the biggest plate settles
; slower: the gain depends on the drive too.
; Reading the table: the comparator's own kickback is the whole offset (b: 9.42 -> 0.03, a bracket that holds the latch's 0.153 mV); the tracking switches are not (a: the sample the
; switch leaves is the plates' starting point, not a decision threshold); and what turns the kick into a difference is the plates' drive (d3: with both halves driven by ideal sources the two
; plates fall by the same 6.87 mV and the offset is the latch's again, 0.27 +- 0.25 mV, a bracket that holds 0.153). With only one half ideal the kick is lopsided the other way and the offset
; is -25.8 mV (N ideal) or +43.9 mV (P ideal): the real circuit's +9.4 is the small difference between two soft plates, one softer than the other. DAC settling (c) moves the late decisions
; by under 0.1 mV: it is not the offset.
; The same on the late decisions, from the golden sine's first two conversions in each deck (decisions from the seventh on): the offset is 6.78 mV in the base deck (the mean of the last two
; decisions below), 6.95 +- 0.42 mV with ideal switches, +0.09 +- 0.60 mV with the kickback removed and -0.10 +- 0.31 mV with ideal plates.
; -
; THE LATE DECISIONS. The converter's codes are decided by the last decisions, and the offset there is not the first decision's. 26 DC conversions of the base deck (sar_amp 0, 480 ns,
; sar_dmv = 128.54 128.84 129.14 129.44 129.64 129.74 129.84 130.04 130.34 -195.91 -196.21 -196.51 -196.81 -196.95 -197.15 -197.35 -197.55 -197.75 -244.70 -245.70 -246.70 -247.70 275.71
; 276.71 277.71 278.71 mV, each chosen with the ideal converter model so that the decision at index 7, 8, 9 or 10 sees D within a few mV of its flip) and the sine's two conversions give 28
; decisions at each of the indices 7 .. 10. The flip is the threshold with the fewest decisions on the wrong side (late_thr below): decision 10 -6.895 mV +- 5 uV (one decision, on a
; different bit path, is outvoted), decision 9 -6.658 mV +- 0.043, decision 8 -7.095 mV +- 0.50, decision 7 -6.975 mV +- 0.50: offsets 6.90, 6.66, 7.10 and 6.98 mV. They agree within their
; brackets; the two narrow ones differ by 0.24 mV, and one threshold for both leaves three decisions on the wrong side (a test), so the offset depends on the decision at the 0.2 mV level
; (and on the bit path: decision 10's threshold lies between -7.06 and -6.85 mV). The model takes the mean of the two narrow ones, 6.776 mV (off_late_v), for every decision.
; -
; WHAT IS NOT DONE. The kick is explained (d4 identifies the extra tgate by its measured resistance) and not derived: it is measured. A circuit-level model of the plates' drive (the transmission gates' and inverters' on-resistances from M3b's current tables,
; the DAC's capacitors, a charge pulse from the comparator's gate capacitances from M3c's charge tables, solved by M1's linear step) would give dVDP and dVDN, and the six first-decision rows
; above are its targets; that is the follow-up, #10942. The top-plate parasitic Cp stays a fit in sar_adc.t27: the table's last column shows why it is not predicted here, the
; DAC's first step depends on the drive too, 0.58 to 0.85 units.
; -
; WHAT A PASS SAYS. The six first-decision flip brackets, the 22 decisions of the golden sine's first two conversions, the 26 DC conversions that bracket the late decisions, the three other
; decks' sine brackets and the kick numbers are pinned as read from the runs; the estimators give the offsets above from them; the offset follows the kick (its sign, its size, its
; disappearance when the plates are made symmetric or the comparator is isolated) and not the switch or the DAC's settling; a changed bracket, a pooled threshold or the latch alone is caught.
; WHAT IT DOES NOT SAY. Nothing about speed, power, noise, mismatch, another corner or another temperature. Nothing about the decks beyond the numbers pinned here: the decks are data and
; nothing in this file runs ngspice. The flip points are read at 0.1 V of clkc; the comparator's own decision instant is later. The late-decision brackets are from one deck, one sine and
; 26 DC inputs; the offset at the decisions from the fourth to the sixth is not bracketed (it follows the kick, which is alike from the sixth on within 1.8 mV, a test) and the first four
; are never near a threshold in the 31 conversions. The one-half-ideal rows are rough (their brackets are 1 to 2 mV wide). The wrapper decks' conversion 0 code is 1007 where the golden
; deck's own run (pinned in sar_adc.t27) gives 1006: that conversion's last decision sits 0.006 mV from its flip (D = -6.889 mV, flip -6.895 mV, in the pinned records), so a 0.01 mV
; difference between two simulations of the same circuit decides it.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogSarKick;

use analog::linear::{fabs64};

pub const KIND : str = "analog-cell";
pub const ID : str = "analog/sar_kick";
pub const REFERENCE : str = "uberWAVE wp2-parser/golden/top.spice (read at run time, GPL-2.0, not vendored); specs/analog/decks/sar_off_*.cir";

; --- the six experiments (first decision) ------------------------------------------------------------------------------------------
pub const NV : usize = 6;
pub const V_BASE : usize = 0;
pub const V_IDEALSW : usize = 1;
pub const V_NOKICK : usize = 2;
pub const V_PLATES : usize = 3;
pub const V_NPLATE : usize = 4;
pub const V_PPLATE : usize = 5;
/// The latch's own flip point with the NAND and the two inverters on its outputs, VDP - VDN in volts (M4b-psp, #10856: dp wins at -2540 units, dn at -2570 of 2^-24 V).
pub const LATCH_FLIP_V : f64 = -0.000153;

; --- BEGIN PINNED DATA (ngspice-47 + PSP103, the decks specs/analog/decks/sar_off_*.cir, read 2026-10-19) -----------------------------
/// The largest D1 (V) at which the first decision came out 0 (VDN above), per experiment: the flip point is above it.
pub const FLIP_LO : [6]f64 = [-0.0096150, -0.0093860, -0.0001810, -0.0005220, 0.0252870, -0.0448630];
/// The smallest D1 (V) at which it came out 1 (VDP above): the flip point is below it.
pub const FLIP_HI : [6]f64 = [-0.0092160, -0.0089850, 0.0001180, -0.0000220, 0.0262860, -0.0428750];
/// dVDP (V) from clkc = 0.1 V to clkc = 0.75 V at the input just below the flip.
pub const KICK_P : [6]f64 = [-0.0226940, -0.0230270, -0.0000640, -0.0068630, -0.0171100, 0.0110680];
/// dVDN (V), the same.
pub const KICK_N : [6]f64 = [-0.0301530, -0.0305600, -0.0001020, -0.0068760, 0.0033440, -0.0248710];
/// The change of D (V) from the first clkc = 0.1 V to the second, when the first decision was 0 (P plate raised by the biggest bit): the step of Bit_10.
pub const STEP_UP : [6]f64 = [0.7372650, 0.7373620, 0.7378990, 0.7373310, 0.7372860, 0.7372660];
/// The same magnitude when it was 1 (P plate lowered).
pub const STEP_DN : [6]f64 = [0.7344160, 0.7346230, 0.7349780, 0.7372960, 0.7373510, 0.7330860];
/// The tgate and the inverter on-resistances (ohm) the golden subcircuits have at the plates' bias, sar_off_ron.cir: a tgate conducting at VCM, the inverter's pmos and nmos at a rail.
pub const RON_TG : f64 = 2592.173;
pub const RON_INVP : f64 = 1880.425;
pub const RON_INVN : f64 = 1427.147;
; --- the P half's bottom plates behind a resistor (sar_off_pseries.cir, the first decision): the series resistance, the bracket of D1 (the largest D1 that gave 0, the smallest that gave 1), the kick ---
pub const NRS : usize = 3;
pub const RS_OHM : [3]f64 = [1300.0, 2592.0, 3900.0];
pub const RS_LO : [3]f64 = [-0.0043350, 0.0006450, 0.0031970];
pub const RS_HI : [3]f64 = [-0.0038370, 0.0011440, 0.0051900];
pub const RS_KICK_P : [3]f64 = [-0.0264350, -0.0297480, -0.0326900];
pub const RS_KICK_N : [3]f64 = [-0.0296700, -0.0292430, -0.0289480];
pub const RS_STEP_UP : [3]f64 = [0.7369840, 0.7351390, 0.7312310];
pub const RS_STEP_DN : [3]f64 = [0.7358230, 0.7345900, 0.7313190];
; --- END PINNED DATA ---------------------------------------------------------------------------------------------------------------

/// The middle of an experiment's flip bracket, V.
pub fn flip_mid(v: usize) -> f64 {
    return (FLIP_LO[v] + FLIP_HI[v]) / 2.0;
}

/// Half the bracket's width, V.
pub fn flip_half(v: usize) -> f64 {
    return (FLIP_HI[v] - FLIP_LO[v]) / 2.0;
}

/// The offset of an experiment's first decision: the comparator decides "above" when VDP - VDN + off > 0, so off = minus the flip point, V.
pub fn first_off(v: usize) -> f64 {
    return 0.0 - flip_mid(v);
}

/// What the clock edge did to VDP - VDN by clkc = 0.75 V (V): dVDP - dVDN.
pub fn kick_diff(v: usize) -> f64 {
    return KICK_P[v] - KICK_N[v];
}

/// The DAC's first plate step, the two directions averaged, V.
pub fn step_mean(v: usize) -> f64 {
    return (STEP_UP[v] + STEP_DN[v]) / 2.0;
}

/// The top-plate parasitic, in units of the 9 um cap_cmim, that gives that step with M4a's ratio: 1.5 V 512 / (1023 + 32 Cp).
pub fn cp_of_step(g: f64) -> f64 {
    return (768.0 / g - 1023.0) / 32.0;
}

/// The offset with the P half's plates behind the resistor RS_OHM[i], V.
pub fn rs_off(i: usize) -> f64 {
    return 0.0 - (RS_LO[i] + RS_HI[i]) / 2.0;
}

/// The series resistance (ohm) at which the offset falls to the latch's own, interpolated between the two points that bracket it (the base row is 0 ohm); minus 1 if none does.
pub fn rs_zero_ohm() -> f64 {
    const lat : f64 = 0.0 - LATCH_FLIP_V;
    var ra : f64 = 0.0;
    var oa : f64 = first_off(V_BASE);
    var i : usize = 0;
    while (i < NRS) {
        const ob : f64 = rs_off(i);
        if (oa > lat && ob <= lat) {
            return ra + (oa - lat) / (oa - ob) * (RS_OHM[i] - ra);
        }
        ra = RS_OHM[i];
        oa = ob;
        i = i + 1;
    }
    return 0.0 - 1.0;
}

