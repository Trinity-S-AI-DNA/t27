/// How many pinned decisions are at index `idx`.
pub fn late_count(idx: u32) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < NLD) {
        if (LD_IDX[i] == idx) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

; --- the late decisions: one threshold per decision index, from the decisions on its two sides ----------------------------------------------
/// Decisions at index `idx` that a latch with the threshold t would have decided the other way: a 0 above t, or a 1 at or below t.
pub fn late_errors(idx: u32, t: f64) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < NLD) {
        if (LD_IDX[i] == idx) {
            if (LD_BIT[i] == 0 && LD_D[i] > t) { n = n + 1; }
            if (LD_BIT[i] == 1 && LD_D[i] <= t) { n = n + 1; }
        }
        i = i + 1;
    }
    return n;
}

/// The search grid for a threshold: from -9 mV in steps of 5 uV, 1000 points.
pub const SCAN_LO : f64 = -0.009;
pub const SCAN_STEP : f64 = 0.000005;
pub const SCAN_N : usize = 1000;

/// A threshold: the middle and the half width of the first run of grid points with the fewest errors, and that fewest number of errors.
pub struct KickThr { mid: f64, half: f64, errors: u32 }

/// The threshold (VDP - VDN at which the latch flips, V) at decision `idx`: the grid points with the fewest disagreeing decisions, the first contiguous run of them.
pub fn late_thr(idx: u32) -> KickThr {
    var best : u32 = 1000000;
    var j : usize = 0;
    while (j < SCAN_N) {
        const e : u32 = late_errors(idx, SCAN_LO + SCAN_STEP * (j as f64));
        if (e < best) { best = e; }
        j = j + 1;
    }
    var first : usize = SCAN_N;
    var last : usize = 0;
    var done : bool = false;
    j = 0;
    while (j < SCAN_N) {
        const e : u32 = late_errors(idx, SCAN_LO + SCAN_STEP * (j as f64));
        if (e == best && !done) {
            if (first == SCAN_N) { first = j; }
            last = j;
        }
        if (e != best && first != SCAN_N) { done = true; }
        j = j + 1;
    }
    const mid : f64 = SCAN_LO + SCAN_STEP * (((first + last) as f64) / 2.0);
    const half : f64 = SCAN_STEP * (((last - first) as f64) / 2.0);
    return KickThr { mid: mid, half: half, errors: best };
}

/// The fewest disagreeing decisions one threshold can make for decisions 9 and 10 together.
pub fn pooled_min_errors() -> u32 {
    var best : u32 = 1000000;
    var j : usize = 0;
    while (j < SCAN_N) {
        const t : f64 = SCAN_LO + SCAN_STEP * (j as f64);
        const e : u32 = late_errors(9, t) + late_errors(10, t);
        if (e < best) { best = e; }
        j = j + 1;
    }
    return best;
}

/// The late offset the converter model uses, V: minus the mean of the thresholds of the two last decisions, the two the DC conversions bracket to 0.1 mV or better. The decision
/// before them (8, 7, ...) are bracketed to +-0.5 mV and agree with it; the first decision is 2.6 mV further out and cannot change a code of the 31 (sar_adc.t27 tests it).
pub fn off_late_v() -> f64 {
    return 0.0 - (late_thr(9).mid + late_thr(10).mid) / 2.0;
}

; --- the tests ------------------------------------------------------------------------------------------------------------------------------

test the_six_first_decision_flips_are_bracketed_and_the_golden_circuit_flips_9_4_mv_below_zero {
    var v : usize = 0;
    while (v < NV) {
        assert(FLIP_LO[v] < FLIP_HI[v]);
        assert(flip_half(v) < 0.0011);
        v = v + 1;
    }
    // the four rows that need a precise answer are bracketed to a quarter of a millivolt or less
    assert(flip_half(V_BASE) < 0.00026);
    assert(flip_half(V_IDEALSW) < 0.00026);
    assert(flip_half(V_NOKICK) < 0.00026);
    assert(flip_half(V_PLATES) < 0.00026);
    assert fabs64(first_off(V_BASE) - 0.0094155) < 0.000000001;
    assert fabs64(flip_half(V_BASE) - 0.0001995) < 0.000000001;
    // the latch is 0.153 mV of it: the base offset is more than 60 times the latch's
    assert(first_off(V_BASE) > 60.0 * (0.0 - LATCH_FLIP_V));
    // the latch alone cannot be the offset: the base bracket excludes the latch's flip point by more than 9 mV
    assert(!(FLIP_LO[V_BASE] < LATCH_FLIP_V && LATCH_FLIP_V < FLIP_HI[V_BASE]));
    assert(LATCH_FLIP_V - FLIP_HI[V_BASE] > 0.009);
}

test ideal_switches_do_not_move_the_offset_and_removing_the_comparator_kickback_removes_it {
    // (a) the two brackets overlap, and the middles are 0.23 mV apart
    assert(FLIP_LO[V_IDEALSW] < FLIP_HI[V_BASE]);
    assert(FLIP_LO[V_BASE] < FLIP_HI[V_IDEALSW]);
    assert(fabs64(first_off(V_IDEALSW) - first_off(V_BASE)) < 0.0003);
    // (b) the kickback removed: the offset drops by more than 9 mV, to a bracket that holds the latch's own flip point
    assert(first_off(V_BASE) - first_off(V_NOKICK) > 0.009);
    assert(FLIP_LO[V_NOKICK] < LATCH_FLIP_V);
    assert(LATCH_FLIP_V < FLIP_HI[V_NOKICK]);
    // and the plates no longer move at the clock edge but by the 0.06 and 0.10 mV the other loads give
    assert(fabs64(KICK_P[V_NOKICK]) < 0.0001);
    assert(fabs64(KICK_N[V_NOKICK]) < 0.00011);
    assert(fabs64(KICK_P[V_BASE]) > 200.0 * fabs64(KICK_P[V_NOKICK]));
}

test with_both_halfs_bottom_plates_driven_ideally_the_plates_fall_alike_and_the_offset_is_the_latchs {
    // both plates fall by 6.87 mV, the same to 0.02 mV: the charge the comparator's input devices push into a stiff top plate
    assert(fabs64(KICK_P[V_PLATES] - KICK_N[V_PLATES]) < 0.00002);
    assert(fabs64(KICK_P[V_PLATES] + 0.00687) < 0.00001);
    assert(kick_diff(V_PLATES) < 0.00002);
    assert(FLIP_LO[V_PLATES] < LATCH_FLIP_V);
    assert(LATCH_FLIP_V < FLIP_HI[V_PLATES]);
    assert(first_off(V_BASE) - first_off(V_PLATES) > 0.009);
    // the golden plates fall 3.3 (VDP) and 4.4 (VDN) times as far as stiff ones: they are soft at the nanosecond scale of the kick, and the N half is the softer
    const rp : f64 = KICK_P[V_BASE] / KICK_P[V_PLATES];
    const rn : f64 = KICK_N[V_BASE] / KICK_N[V_PLATES];
    assert(rp > 3.2);
    assert(rp < 3.4);
    assert(rn > 4.3);
    assert(rn < 4.5);
    assert(rn > rp);
    const r : f64 = KICK_N[V_BASE] / KICK_P[V_BASE];
    assert(r > 1.30);
    assert(r < 1.36);
}

test the_offset_follows_the_kick_in_sign_and_size_in_all_six_experiments {
    var v : usize = 0;
    while (v < NV) {
        const kd : f64 = kick_diff(v);
        const o : f64 = first_off(v);
        if (fabs64(kd) > 0.001) {
            assert((kd > 0.0 && o > 0.0) || (kd < 0.0 && o < 0.0));
            // the offset is larger than the kick by 1.7 to 8 mV: the latch needs a margin after the half-Vdd instant
            assert(fabs64(o) > fabs64(kd));
            assert(fabs64(o) < fabs64(kd) + 0.008);
        } else {
            assert(fabs64(o) < 0.0006);
        }
        v = v + 1;
    }
    assert(kick_diff(V_BASE) > 0.0074);
    assert(kick_diff(V_BASE) < 0.0075);
    // the order of the offsets is the order of the kicks: P ideal > golden > symmetric > N ideal
    assert(first_off(V_PPLATE) > first_off(V_BASE));
    assert(first_off(V_BASE) > first_off(V_PLATES));
    assert(first_off(V_PLATES) > first_off(V_NPLATE));
    assert(first_off(V_PPLATE) > 0.04);
    assert(first_off(V_NPLATE) < 0.0 - 0.025);
    // the swing between the two one-half-ideal rows, 69 mV, is the lopsidedness the golden circuit's 9.4 mV is a small part of
    assert(first_off(V_PPLATE) - first_off(V_NPLATE) > 0.069);
}

test the_dac_step_depends_on_the_drive_so_the_top_plate_parasitic_is_not_predicted_here {
    // the first plate step, two directions averaged, as a parasitic Cp in units of the 9 um cap_cmim: 0.58 .. 0.68, and 0.647 in the golden circuit
    assert fabs64(cp_of_step(step_mean(V_BASE)) - 0.647) < 0.001;
    assert fabs64(cp_of_step(step_mean(V_IDEALSW)) - 0.640) < 0.001;
    assert fabs64(cp_of_step(step_mean(V_PLATES)) - 0.582) < 0.001;
    var lo : f64 = 1000.0;
    var hi : f64 = 0.0 - 1000.0;
    var v : usize = 0;
    while (v < NV) {
        const c : f64 = cp_of_step(step_mean(v));
        if (c < lo) { lo = c; }
        if (c > hi) { hi = c; }
        v = v + 1;
    }
    assert(hi - lo > 0.09);
    // with ideal bottom plates the step is symmetric to 0.04 mV; the golden plates make it 2.85 mV different for a raised and a lowered P plate (the biggest plate has not settled)
    assert(fabs64(STEP_UP[V_PLATES] - STEP_DN[V_PLATES]) < 0.00005);
    assert(STEP_UP[V_BASE] - STEP_DN[V_BASE] > 0.0028);
    assert(STEP_UP[V_BASE] - STEP_DN[V_BASE] < 0.0029);
}

test the_last_two_decisions_are_bracketed_by_dc_conversions_and_their_offset_is_6_7_to_6_9_mv {
    const t10 : KickThr = late_thr(10);
    const t9 : KickThr = late_thr(9);
    // index 9: no decision disagrees with the threshold; it is -6.6575 mV, bracketed to 0.05 mV
    assert_eq(t9.errors, 0);
    assert fabs64(t9.mid + 0.0066575) < 0.000001;
    assert(t9.half < 0.00005);
    // index 10: one decision (a different bit path, -7.061 mV) disagrees; the rest bracket -6.895 mV to 5 uV
    assert_eq(t10.errors, 1);
    assert fabs64(t10.mid + 0.006895) < 0.000001;
    assert(t10.half < 0.00001);
    assert(t10.mid < t9.mid);
    // the model's late offset is their mean
    assert fabs64(off_late_v() - 0.0067762) < 0.0000001;
    assert(off_late_v() > 0.0 - t9.mid - 0.0002);
    assert(off_late_v() < 0.0 - t10.mid + 0.0002);
    // 44 times the latch's own 0.153 mV, 2.6 mV under the first decision's
    assert(off_late_v() > 40.0 * (0.0 - LATCH_FLIP_V));
    const gap : f64 = first_off(V_BASE) - off_late_v();
    assert(gap > 0.0026);
    assert(gap < 0.0028);
    // decisions 8 and 7: the brackets are +-0.5 mV and hold the same offset to within them
    const t8 : KickThr = late_thr(8);
    const t7 : KickThr = late_thr(7);
    assert_eq(t8.errors, 0);
    assert_eq(t7.errors, 0);
    assert(t8.half < 0.0006);
    assert(t7.half < 0.0006);
    assert(fabs64(t8.mid - (0.0 - off_late_v())) < t8.half + 0.0004);
    assert(fabs64(t7.mid - (0.0 - off_late_v())) < t7.half + 0.0004);
}

test one_threshold_for_decisions_9_and_10_together_disagrees_with_the_decisions {
    // the negative control: the offsets of the two last decisions differ by 0.24 mV, and pooling them leaves at least two decisions on the wrong side
    assert_eq(pooled_min_errors(), 3);
    assert_eq(late_errors(9, late_thr(10).mid), 2);
    assert_eq(late_errors(10, late_thr(9).mid), 4);
    // the records are what the two estimators read: 112 of them, four per run
    assert_eq(late_count(7) + late_count(8) + late_count(9) + late_count(10), 112);
    assert_eq(late_count(10), 28);
    // a latch with only its own flip point (-0.153 mV) would disagree with the 13 decisions at index 10 that came out 1 below it
    assert_eq(late_errors(10, LATCH_FLIP_V), 13);
}

test the_sine_runs_of_the_other_decks_agree_with_the_first_decision_rows {
    // the golden sine's first two conversions in each deck, decisions from index 6 on: the ideal switches leave the late offset where it was (6.945 mV against 6.775)
    var v : usize = 0;
    while (v < 3) {
        assert(NAT_LO[v] < NAT_HI[v]);
        v = v + 1;
    }
    const o_sw : f64 = 0.0 - (NAT_LO[0] + NAT_HI[0]) / 2.0;
    assert(fabs64(o_sw - off_late_v()) < 0.0003);
    assert fabs64(o_sw - 0.0069452) < 0.0000001;
    // the kickback removed, and the ideal plates: brackets of +-0.6 and +-0.3 mV that hold the latch's 0.153 mV
    assert(NAT_LO[1] < LATCH_FLIP_V);
    assert(LATCH_FLIP_V < NAT_HI[1]);
    assert(NAT_LO[2] < LATCH_FLIP_V);
    assert(LATCH_FLIP_V < NAT_HI[2]);
    assert(NAT_HI[1] - NAT_LO[1] < 0.0013);
    assert(NAT_HI[2] - NAT_LO[2] < 0.0007);
    // so on the late decisions too the offset is the kickback and nothing else: 6.8 mV to under 0.6 mV
    assert(off_late_v() - (0.0 - (NAT_LO[1] + NAT_HI[1]) / 2.0) > 0.006);
    assert(off_late_v() - (0.0 - (NAT_LO[2] + NAT_HI[2]) / 2.0) > 0.006);
}

test an_extra_transmission_gate_on_the_p_half_is_what_makes_the_kick_a_difference_and_a_resistor_of_its_size_removes_the_offset {
    // the golden tgate conducting at VCM is 2592 ohm, the inverter's pmos 1880 and nmos 1427 at a rail (sar_off_ron.cir)
    assert fabs64(RON_TG - 2592.173) < 0.001;
    assert(RON_INVP < RON_TG);
    assert(RON_INVN < RON_INVP);
    // the first decision's offset against the resistor between each P bottom plate and its Bit_k node: 9.42, 4.09, -0.89, -4.19 mV at 0, 1300, 2592, 3900 ohm, falling at each step
    var i : usize = 0;
    while (i < NRS) {
        assert(RS_LO[i] < RS_HI[i]);
        assert(RS_HI[i] - RS_LO[i] < 0.0021);
        i = i + 1;
    }
    assert(first_off(V_BASE) > rs_off(0));
    assert(rs_off(0) > rs_off(1));
    assert(rs_off(1) > rs_off(2));
    assert fabs64(rs_off(0) - 0.004086) < 0.000000001;
    assert fabs64(rs_off(1) + 0.0008945) < 0.000000001;
    // with a tgate's resistance the plates fall alike (29.7 and 29.2 mV against the golden 22.7 and 30.2) and the offset is under 1 mV
    assert fabs64(RS_KICK_P[1] - RS_KICK_N[1]) < 0.0007;
    assert(KICK_P[V_BASE] - RS_KICK_P[1] > 0.006);
    assert(fabs64(rs_off(1)) < 0.0011);
    // the P plate's kick grows with the resistor while the N plate's stays within 1.3 mV: the extra resistance is what softens the P plate
    assert(RS_KICK_P[0] < KICK_P[V_BASE]);
    assert(RS_KICK_P[1] < RS_KICK_P[0]);
    assert(RS_KICK_P[2] < RS_KICK_P[1]);
    assert(fabs64(RS_KICK_N[0] - KICK_N[V_BASE]) < 0.0006);
    assert(fabs64(RS_KICK_N[2] - KICK_N[V_BASE]) < 0.0013);
    // the offset crosses the latch's own at 2320 ohm: 10.5 percent under the tgate's 2592, so the extra tgate accounts for the asymmetry to about a tenth
    const r0 : f64 = rs_zero_ohm();
    assert fabs64(r0 - 2320.27) < 0.5;
    assert(r0 < RON_TG);
    assert(RON_TG / r0 < 1.13);
    assert(r0 / RON_TG > 0.88);
    // the top-plate load read from the first step grows with the resistor: 0.62, 0.69, 0.85 units
    const g0 : f64 = (RS_STEP_UP[0] + RS_STEP_DN[0]) / 2.0;
    const g2 : f64 = (RS_STEP_UP[2] + RS_STEP_DN[2]) / 2.0;
    assert fabs64(cp_of_step(g0) - 0.622) < 0.001;
    assert fabs64(cp_of_step(g2) - 0.851) < 0.001;
    assert(cp_of_step(g2) - cp_of_step(g0) > 0.2);
}

test the_dac_has_settled_where_it_matters_and_the_edge_kick_is_alike_from_the_sixth_decision_on {
    var i : usize = 0;
    while (i < NDEC) {
        const ix : u32 = DEC_IDX[i];
        // D read 3 ns earlier differs by under 0.1 mV from the fourth decision on, by at most 0.26 mV at the second and third
        if (ix >= 3) { assert(fabs64(DEC_BACK3[i]) < 0.0001); }
        if (ix == 1 || ix == 2) { assert(fabs64(DEC_BACK3[i]) < 0.00026); }
        // 10 ns earlier: under 0.31 mV from the fifth on; 1.8 mV and 2.7 mV for the two biggest plates after their move
        if (ix >= 4) { assert(fabs64(DEC_BACK10[i]) < 0.00031); }
        if (ix == 1 || ix == 2) { assert(fabs64(DEC_BACK10[i]) > 0.0017); }
        // the late decisions near zero: the edge has moved D by 4.5 to 6.3 mV by half of Vdd
        if (ix >= 6 && fabs64(DEC_D[i]) < 0.02) {
            assert(DEC_KICK[i] > 0.0044);
            assert(DEC_KICK[i] < 0.0063);
        }
        i = i + 1;
    }
    // the pinned late decisions at 7 .. 10 of the sine run are the first eight records
    assert_eq(DEC_IDX[7], LD_IDX[0]);
    assert_eq(DEC_IDX[10], LD_IDX[3]);
    assert fabs64(DEC_D[7] - LD_D[0]) < 0.00000001;
    assert fabs64(DEC_D[10] - LD_D[3]) < 0.00000001;
    assert fabs64(DEC_D[18] - LD_D[4]) < 0.00000001;
    assert fabs64(DEC_D[21] - LD_D[7]) < 0.00000001;
}

