; SPDX-License-Identifier: Apache-2.0
; netlist_card.t27 - a census block of a netlist as a T27F widget card (epic #13650).
; --
; The block is not drawn here. This spec only says WHAT the card holds, as a visual-factory
; object graph (specs/t27f/visual_factory_contract.t27): a card, a heading, a caption and badges.
; Where each node sits is decided by the factory layout (vf_card_fit), how it looks by the factory
; theme and the resolved tokens (vf_card_tok), and the pixels by the factory renderer (vf_card).
; This file holds no coordinate, no colour and no size of a node: only the viewport of the still.
; --
; The netlist widget set, and the factory kind each one is made of:
;   block container -> VF_CARD        label -> VF_TEXT
;   pin             -> VF_BADGE (the pin row, one badge with the exact pin count)
;   node            -> VF_BADGE (the body row, one badge per element kind with its exact count)
;   inverter, array, composite, mixed -> the same card composed for a block of that class
;   wire            -> refused: the census holds counts, not nets, so no wire can be drawn truthfully
; --
; Every count on a card is read from analog::netlist_meaning; a kind with count 0 gets no badge.
; Every private helper carries the nc_ prefix. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY
module analog_netlist_card;

use t27f::ui_plan::bit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_OK;
use t27f::visual_factory_contract::P_TEXT;
use t27f::visual_factory_contract::P_LABEL;
use t27f::visual_factory_contract::P_VARIANT;
use t27f::visual_factory_contract::P_TEST_ID;
use t27f::visual_factory_contract::DIR_ROW;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::DANGER;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_validate;
use t27f::vf_layout::VfLayout;
use t27f::vf_card_fit::vcf_overrides_w;
use t27f::vf_card_fit::vcf_text_px;
use t27f::vf_layout::vf_layout_m;
use t27f::vf_type::vt_text_width_q8;
use t27f::vf_type::VT_REGULAR;
use t27f::vf_card_fit::vcf_overflow_count;
use t27f::vf_card::VC_OK;
use t27f::vf_card::VC_NO_FOCUS;
use t27f::vf_card::VcStyle;
use t27f::vf_card::vc_render_s;
use t27f::vf_card_tok::VctMetrics;
use t27f::vf_card_tok::vct_metrics;
use t27f::vf_card_tok::vct_style;
use t27f::vf_theme::TH_T27;
use t27f::vf_theme::TH_PAPER;
use t27f::vf_snapshot::VfSnapshot;
use t27f::vf_snapshot::vf_snapshot;
use t27f::vf_snapshot::vf_snapshot_equal;
use t27f::vf_diff::vf_diff_count;
use analog::netlist_meaning::NM_BLOCKS;
use analog::netlist_meaning::NM_PINS;
use analog::netlist_meaning::NM_SUB;
use analog::netlist_meaning::NM_MOS;
use analog::netlist_meaning::NM_MIM;
use analog::netlist_meaning::NM_PASSIVE;
use analog::netlist_meaning::NM_EMPTY;
use analog::netlist_meaning::NM_ARRAY;
use analog::netlist_meaning::NM_COMPOSITE;
use analog::netlist_meaning::NM_MIXED;
use analog::netlist_meaning::nm_block_class;
use analog::netlist_meaning::nm_block_lines;
use analog::netlist_structure::ns_shows_instances;
use analog::netlist_structure::ns_shows_devices;
use analog::netlist_structure::ns_block_lost;
use analog::netlist_block_svg::nb_name;
use analog::netlist_block_svg::nb_class_name;

; the netlist widget set
pub const NCW_NODE : u32 = 0;
pub const NCW_PIN : u32 = 1;
pub const NCW_WIRE : u32 = 2;
pub const NCW_LABEL : u32 = 3;
pub const NCW_BLOCK : u32 = 4;
pub const NCW_INVERTER : u32 = 5;
pub const NCW_ARRAY : u32 = 6;
pub const NCW_COMPOSITE : u32 = 7;
pub const NCW_MIXED : u32 = 8;
pub const NCW_COUNT : u32 = 9;
; the answer for a widget the factory cannot make from the census
pub const NCW_REFUSED : u8 = 0;

; the element kinds of a body row, in card order
pub const NCK_INSTANCE : u32 = 0;
pub const NCK_MOS : u32 = 1;
pub const NCK_MIM : u32 = 2;
pub const NCK_PASSIVE : u32 = 3;
pub const NCK_COUNT : u32 = 4;

; the viewport of one still: the factory's phone width and a height every card fits (tested)
pub const NC_W : u32 = 375;
pub const NC_H : u32 = 300;
pub const NC_RGB : usize = 337500;
pub const NC_NO_NODE : u32 = 255;

; text of the cards: 18 cards (17 blocks and the refusal) x 8 slots x 24 bytes
pub const NC_SLOT : usize = 24;
pub const NC_SLOTS : usize = 8;
var NC_TXT : [3456]u8 = undefined;
var NC_A : [337500]u8 = undefined;
var NC_B : [337500]u8 = undefined;
var nc_in : [64]u8 = undefined;

; the factory kind a netlist widget is made of; NCW_REFUSED for a wire and for an unknown widget
pub fn nc_widget_kind(wd: u32) -> u8 {
    if wd == NCW_NODE {
        return VF_BADGE;
    }
    if wd == NCW_PIN {
        return VF_BADGE;
    }
    if wd == NCW_LABEL {
        return VF_TEXT;
    }
    if wd == NCW_BLOCK {
        return VF_CARD;
    }
    if wd == NCW_INVERTER {
        return VF_CARD;
    }
    if wd == NCW_ARRAY {
        return VF_CARD;
    }
    if wd == NCW_COMPOSITE {
        return VF_CARD;
    }
    if wd == NCW_MIXED {
        return VF_CARD;
    }
    return NCW_REFUSED;
}

; how many elements of kind k block i shows on its card: the census count when the picture plan
; of the block's class shows that kind, 0 otherwise and out of range
pub fn nc_kind_count(i: u32, k: u32) -> u32 {
    if i >= NM_BLOCKS {
        return 0;
    }
    let class : u32 = nm_block_class(i);
    if k == NCK_INSTANCE {
        if ns_shows_instances(class) {
            return NM_SUB[i];
        }
        return 0;
    }
    if ns_shows_devices(class) == false {
        return 0;
    }
    if k == NCK_MOS {
        return NM_MOS[i];
    }
    if k == NCK_MIM {
        return NM_MIM[i];
    }
    if k == NCK_PASSIVE {
        return NM_PASSIVE[i];
    }
    return 0;
}

; how many body badges block i gets: one per element kind present
pub fn nc_body_badges(i: u32) -> u32 {
    var n : u32 = 0;
    var k : u32 = 0;
    while k < NCK_COUNT {
        if nc_kind_count(i, k) > 0 {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

; the sum the body badges of block i state
pub fn nc_body_total(i: u32) -> u32 {
    var n : u32 = 0;
    var k : u32 = 0;
    while k < NCK_COUNT {
        n = n + nc_kind_count(i, k);
        k = k + 1;
    }
    return n;
}

fn nc_kind_word(k: u32) -> []const u8 {
    if (k == NCK_INSTANCE) { return "inst "; }
    if (k == NCK_MOS) { return "mos "; }
    if (k == NCK_MIM) { return "mim "; }
    if (k == NCK_PASSIVE) { return "passive "; }
    return "? ";
}

; write word, then n in decimal when num is set, then tail into slot s of card c; the text written
fn nc_txt(c: u32, s: u32, word: []const u8, num: bool, n: u32, tail: []const u8) -> []const u8 {
    const at : usize = (@as(usize, @intCast(c)) * NC_SLOTS + @as(usize, @intCast(s))) * NC_SLOT;
    var p : usize = 0;
    var j : usize = 0;
    while (j < word.len and p < NC_SLOT) {
        NC_TXT[at + p] = word[j];
        p = p + 1;
        j = j + 1;
    }
    if (num) {
        if (p > 0 and p < NC_SLOT and NC_TXT[at + p - 1] != 32) {
            NC_TXT[at + p] = 32;
            p = p + 1;
        }
        var digits : [10]u8 = undefined;
        var d : usize = 0;
        var x : u32 = n;
        if (x == 0) {
            digits[0] = 48;
            d = 1;
        }
        while (x > 0) {
            digits[d] = 48 + @as(u8, @intCast(x % 10));
            d = d + 1;
            x = x / 10;
        }
        while (d > 0 and p < NC_SLOT) {
            d = d - 1;
            NC_TXT[at + p] = digits[d];
            p = p + 1;
        }
    }
    j = 0;
    while (j < tail.len and p < NC_SLOT) {
        NC_TXT[at + p] = tail[j];
        p = p + 1;
        j = j + 1;
    }
    return NC_TXT[at .. at + p];
}

; the refusal card: an unknown block, or a block with no element line
fn nc_refusal(m: VctMetrics, width: u32) -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    var g0 : VfGraph = vf_add(g, VF_CARD, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), "netlist-block");
    var g1 : VfGraph = vf_add(g0, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "name");
    var g2 : VfGraph = vf_add(g1, VF_BADGE, 0, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "refusal");
    g2.viewport_w = width;
    g2.viewport_h = NC_H;
    g2.label[0] = "Netlist block";
    g2.direction[0] = DIR_COLUMN;
    g2.padding[0] = m.padding;
    g2.gap[0] = m.group_gap;
    g2.text[1] = "no such block";
    g2.text[2] = "refused";
    g2.variant[2] = DANGER;
    return g2;
}

; the card of census block i at a viewport width, spaced by the resolved tokens m.
; Nodes: 0 card, 1 name, 2 caption (class and element lines), 3 pin row, 4 pin badge, 5 body row,
; then one badge per element kind present. A block out of range or of class EMPTY is the refusal card;
; refused tokens give a blank graph
pub fn nc_graph_with(m: VctMetrics, i: u32, width: u32) -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    if m.status != 0 {
        return g;
    }
    if i >= NM_BLOCKS {
        return nc_refusal(m, width);
    }
    let class : u32 = nm_block_class(i);
    if class == NM_EMPTY {
        return nc_refusal(m, width);
    }
    var g0 : VfGraph = vf_add(g, VF_CARD, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), "netlist-block");
    var g1 : VfGraph = vf_add(g0, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "name");
    var g2 : VfGraph = vf_add(g1, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "class");
    var g3 : VfGraph = vf_add(g2, VF_STACK, 0, bit(P_TEST_ID), "pins");
    var g4 : VfGraph = vf_add(g3, VF_BADGE, 3, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "pin");
    var g5 : VfGraph = vf_add(g4, VF_STACK, 0, bit(P_TEST_ID), "body");
    g5.viewport_w = width;
    g5.viewport_h = NC_H;
    g5.label[0] = "Netlist block";
    g5.direction[0] = DIR_COLUMN;
    g5.padding[0] = m.padding;
    g5.gap[0] = m.group_gap;
    g5.text[1] = nc_txt(i, 0, nb_name(i), false, 0, "");
    g5.text[2] = nc_txt(i, 1, nb_class_name(class), true, nm_block_lines(i), " lines");
    g5.direction[3] = DIR_ROW;
    g5.gap[3] = m.action_gap;
    g5.text[4] = nc_txt(i, 2, "pins ", true, NM_PINS[i], "");
    g5.direction[5] = DIR_ROW;
    g5.gap[5] = m.action_gap;
    var k : u32 = 0;
    while k < NCK_COUNT {
        let n : u32 = nc_kind_count(i, k);
        if n > 0 {
            let at : u32 = g5.node_count as u32;
            g5 = vf_add(g5, VF_BADGE, 5, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), nc_kind_word(k));
            g5.text[at] = nc_txt(i, 3 + k, nc_kind_word(k), true, n, "");
        }
        k = k + 1;
    }
    return g5;
}

pub fn nc_graph(i: u32, width: u32) -> VfGraph {
    return nc_graph_with(vct_metrics(), i, width);
}

; the fitted layout: text nodes by their measured advance (vcf_overrides_w), and every badge by its own label --
; the pen offset st.pad_x on the left, the advance width of the label as the painter draws it (body size, regular),
; and the same st.pad_x on the right, so the padding is one token on both sides and the label stays on its fill
pub fn nc_layout(g: VfGraph, st: VcStyle) -> VfLayout {
    var ow : [16]u32 = vcf_overrides_w(g, st);
    var oh : [16]u32 = [0; 16];
    var i : u32 = 0;
    while i < g.node_count and i < 16 {
        if g.kind[i] == VF_BADGE {
            let q8 : u32 = vt_text_width_q8(g.text[i], vcf_text_px(g, i, st), VT_REGULAR);
            ow[i] = st.pad_x + (q8 + 255) / 256 + st.pad_x;
        }
        if g.kind[i] == VF_TEXT {
            let q8t : u32 = vt_text_width_q8(g.text[i], vcf_text_px(g, i, st), VT_REGULAR);
            let want : u32 = st.pad_x + (q8t + 255) / 256 + st.pad_x + 2;
            if want > ow[i] {
                ow[i] = want;
            }
            oh[i] = vcf_text_px(g, i, st) * 3 / 2;
        }
        i = i + 1;
    }
    return vf_layout_m(g, ow, oh);
}

; render block i in a theme into rgb (NC_W x NC_H x 3 bytes) through the factory: token metrics,
; fitted layout, card renderer. The factory's own result code
pub fn nc_render(i: u32, theme: u32, rgb: []u8) -> u32 {
    let m : VctMetrics = vct_metrics();
    let st : VcStyle = vct_style(m);
    let g : VfGraph = nc_graph_with(m, i, NC_W);
    let l : VfLayout = nc_layout(g, st);
    return vc_render_s(g, l, rgb, NC_W, NC_H, 100, theme, VC_NO_FOCUS, st);
}

; ---- measures on the painted frame (real pixels, not the layout) ----

; a measure that could not be taken (the node touches the frame edge, or has no room inside its outline)
pub const NC_UNMEASURED : u32 = 1000000;

; the ink of a node: how far the nearest painted pixel stands from each inner edge of the node's box
pub struct NcInk {
    any: bool,
    left: u32,
    top: u32,
    right: u32,
    bottom: u32,
}

; FNV-1a 32 of the first n bytes of a frame: the frame's identity for the stored baseline
pub fn nc_hash(a: []const u8, n: usize) -> u32 {
    var h : u32 = 2166136261;
    var i : usize = 0;
    while (i < n) {
        h = (h ^ @as(u32, a[i])) *% 16777619;
        i = i + 1;
    }
    return h;
}

; true when pixels p and q of a frame differ
fn nc_px_ne(a: []const u8, p: u32, q: u32) -> bool {
    var pa : usize = (p * 3) as usize;
    var qa : usize = (q * 3) as usize;
    if a[pa] != a[qa] {
        return true;
    }
    if a[pa + 1] != a[qa + 1] {
        return true;
    }
    if a[pa + 2] != a[qa + 2] {
        return true;
    }
    return false;
}

; how many pixels of the 1 px ring just outside node i's box differ from the ring's first pixel. The ring lies on the
; parent's background, so any count above 0 is paint (text) that left its node. NC_UNMEASURED when the box touches the frame edge
pub fn nc_ring_spill(a: []const u8, l: VfLayout, i: u32) -> u32 {
    if l.x[i] == 0 {
        return NC_UNMEASURED;
    }
    if l.y[i] == 0 {
        return NC_UNMEASURED;
    }
    if l.x[i] + l.w[i] >= NC_W {
        return NC_UNMEASURED;
    }
    if l.y[i] + l.h[i] >= NC_H {
        return NC_UNMEASURED;
    }
    let x0 : u32 = l.x[i] - 1;
    let y0 : u32 = l.y[i] - 1;
    let x1 : u32 = l.x[i] + l.w[i];
    let y1 : u32 = l.y[i] + l.h[i];
    let base : u32 = y0 * NC_W + x0;
    var n : u32 = 0;
    var x : u32 = x0;
    while x <= x1 {
        if nc_px_ne(a, y0 * NC_W + x, base) {
            n = n + 1;
        }
        if nc_px_ne(a, y1 * NC_W + x, base) {
            n = n + 1;
        }
        x = x + 1;
    }
    var y : u32 = y0 + 1;
    while y < y1 {
        if nc_px_ne(a, y * NC_W + x0, base) {
            n = n + 1;
        }
        if nc_px_ne(a, y * NC_W + x1, base) {
            n = n + 1;
        }
        y = y + 1;
    }
    return n;
}

; the ink box of node i inside its outline of bw pixels: every pixel that differs from the fill (read one pixel inside
; the left outline at mid height), as the distance from each inner edge. any is false when nothing is painted or the box is too small
pub fn nc_ink(a: []const u8, l: VfLayout, i: u32, bw: u32) -> NcInk {
    var k : NcInk = NcInk {
        any: false,
        left: 0,
        top: 0,
        right: 0,
        bottom: 0,
    };
    if l.w[i] < 2 * bw + 3 {
        return k;
    }
    if l.h[i] < 2 * bw + 3 {
        return k;
    }
    if l.x[i] + l.w[i] > NC_W {
        return k;
    }
    if l.y[i] + l.h[i] > NC_H {
        return k;
    }
    let ax : u32 = l.x[i] + bw;
    let ay : u32 = l.y[i] + bw;
    let bx : u32 = l.x[i] + l.w[i] - bw;
    let by : u32 = l.y[i] + l.h[i] - bw;
    let fill : u32 = (l.y[i] + l.h[i] / 2) * NC_W + ax + 1;
    var lo_x : u32 = bx;
    var hi_x : u32 = ax;
    var lo_y : u32 = by;
    var hi_y : u32 = ay;
    var y : u32 = ay;
    while y < by {
        var x : u32 = ax;
        while x < bx {
            if nc_px_ne(a, y * NC_W + x, fill) {
                k.any = true;
                if x < lo_x {
                    lo_x = x;
                }
                if x > hi_x {
                    hi_x = x;
                }
                if y < lo_y {
                    lo_y = y;
                }
                if y > hi_y {
                    hi_y = y;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if k.any {
        k.left = lo_x - ax;
        k.top = lo_y - ay;
        k.right = bx - 1 - hi_x;
        k.bottom = by - 1 - hi_y;
    }
    return k;
}

; the measures of one frame on stderr: the hash, the text nodes wider than their box, then per node its kind, box, ring spill and ink
fn nc_measure(block: u32, theme: u32) -> void {
    const m : VctMetrics = vct_metrics();
    const st : VcStyle = vct_style(m);
    const g : VfGraph = nc_graph_with(m, block, NC_W);
    const l : VfLayout = nc_layout(g, st);
    std.debug.print("frame b={d} t={d} hash={d} nodes={d} overflow={d} pad={d} padx={d} border={d}\n", .{ block, theme, nc_hash(&NC_A, NC_RGB), g.node_count, vcf_overflow_count(g, l, st), m.padding, st.pad_x, st.border });
    var i : u32 = 0;
    while (i < g.node_count) {
        const k : NcInk = nc_ink(&NC_A, l, i, st.border);
        std.debug.print("node b={d} t={d} n={d} kind={d} box={d},{d},{d},{d} spill={d} ink={d},{d},{d},{d} any={}\n", .{ block, theme, i, g.kind[i], l.x[i], l.y[i], l.w[i], l.h[i], nc_ring_spill(&NC_A, l, i), k.left, k.top, k.right, k.bottom, k.any });
        i = i + 1;
    }
}

; stdin "block theme" -> stdout one binary PPM (P6) of NC_W x NC_H; a third field ("block theme 1") prints the frame's
; measures on stderr in place of the PPM; exit 1 no input, 2 render refused
pub fn main() -> void {
    var len : usize = 0;
    var r : isize = 1;
    while (r > 0 and len < 64) {
        r = std.c.read(0, nc_in[len..64].ptr, 64 - len);
        if (r > 0) {
            len += @as(usize, @intCast(r));
        }
    }
    if (len == 0) { std.c.exit(1); }
    var block : u32 = 0;
    var theme : u32 = 0;
    var field : u32 = 0;
    var i : usize = 0;
    while (i < len) {
        const ch : u8 = nc_in[i];
        if (ch >= 48 and ch <= 57) {
            if (field == 0) {
                block = block * 10 + @as(u32, ch - 48);
            }
            if (field == 1) {
                theme = theme * 10 + @as(u32, ch - 48);
            }
        } else {
            if (ch == 32) {
                field = field + 1;
            }
        }
        i = i + 1;
    }
    if (nc_render(block, theme, &NC_A) != VC_OK) { std.c.exit(2); }
    if (field >= 2) {
        nc_measure(block, theme);
        return;
    }
    const head : []const u8 = "P6\n375 300\n255\n";
    _ = std.c.write(1, head.ptr, head.len);
    _ = std.c.write(1, @ptrCast(&NC_A), NC_RGB);
}

test the_widget_set_maps_to_factory_kinds_and_a_wire_is_refused {
    assert nc_widget_kind(NCW_BLOCK) == VF_CARD;
    assert nc_widget_kind(NCW_LABEL) == VF_TEXT;
    assert nc_widget_kind(NCW_PIN) == VF_BADGE;
    assert nc_widget_kind(NCW_NODE) == VF_BADGE;
    assert nc_widget_kind(NCW_INVERTER) == VF_CARD;
    assert nc_widget_kind(NCW_ARRAY) == VF_CARD;
    assert nc_widget_kind(NCW_COMPOSITE) == VF_CARD;
    assert nc_widget_kind(NCW_MIXED) == VF_CARD;
    // the census has no nets: a wire is refused, and so is a widget that does not exist
    assert nc_widget_kind(NCW_WIRE) == NCW_REFUSED;
    assert nc_widget_kind(NCW_COUNT) == NCW_REFUSED;
}

test every_block_is_a_valid_factory_graph {
    var b : u32 = 0;
    while b < NM_BLOCKS {
        let g : VfGraph = nc_graph(b, NC_W);
        assert vf_validate(g) == VF_OK;
        assert (g.node_count as u32) == 6 + nc_body_badges(b);
        assert g.kind[0] == VF_CARD;
        assert g.kind[4] == VF_BADGE;
        b = b + 1;
    }
    // the refusal card is a valid graph too, with one badge
    let rg : VfGraph = nc_graph(NM_BLOCKS, NC_W);
    assert vf_validate(rg) == VF_OK;
    assert (rg.node_count as u32) == 3;
    assert rg.variant[2] == DANGER;
}

test the_badges_state_every_element_line_of_the_census {
    var b : u32 = 0;
    var total : u32 = 0;
    while b < NM_BLOCKS {
        // nothing the plan shows is dropped: badge sums plus the plan's lost lines are the block's lines
        assert nc_body_total(b) + ns_block_lost(b) == nm_block_lines(b);
        assert ns_block_lost(b) == 0;
        total = total + nc_body_total(b);
        b = b + 1;
    }
    assert total == 247;
    // the inverter: 2 mos, 4 pins, one body badge
    assert nc_kind_count(8, NCK_MOS) == 2;
    assert nc_body_badges(8) == 1;
    // the array: one badge that states all 63 capacitors
    assert nm_block_class(7) == NM_ARRAY;
    assert nc_body_badges(7) == 1;
    assert nc_kind_count(7, NCK_MIM) == 63;
    // a composite shows instances only, a mixed block both
    assert nm_block_class(3) == NM_COMPOSITE;
    assert nc_body_badges(3) == 1;
    assert nc_kind_count(3, NCK_INSTANCE) == 11;
    assert nm_block_class(1) == NM_MIXED;
    assert nc_body_badges(1) == 4;
    // out of range states nothing
    assert nc_body_total(NM_BLOCKS) == 0;
}

test the_card_text_is_the_census {
    let g : VfGraph = nc_graph(8, NC_W);
    assert g.text[1] == "inverter";
    assert g.text[2] == "leaf 2 lines";
    assert g.text[4] == "pins 4";
    assert g.text[6] == "mos 2";
    let a : VfGraph = nc_graph(7, NC_W);
    assert a.text[1] == "diff_cap_dac";
    assert a.text[6] == "mim 63";
    // another block's card does not disturb this one's text
    assert g.text[1] == "inverter";
}

test every_block_renders_in_both_themes_and_fits_the_viewport {
    let st : VcStyle = vct_style(vct_metrics());
    var b : u32 = 0;
    while b <= NM_BLOCKS {
        let g : VfGraph = nc_graph(b, NC_W);
        let l : VfLayout = nc_layout(g, st);
        assert l.y[0] + l.h[0] <= NC_H;
        assert l.x[0] + l.w[0] <= NC_W;
        assert nc_render(b, TH_T27, &NC_A) == VC_OK;
        assert nc_render(b, TH_PAPER, &NC_B) == VC_OK;
        // the theme changes pixels
        assert vf_diff_count(&NC_A, &NC_B, NC_W, NC_H) > 0;
        b = b + 1;
    }
}

test the_render_is_deterministic_and_blocks_differ {
    // visual regression: the same block twice gives the same snapshot and 0 differing pixels
    assert vf_snapshot_equal(vf_snapshot(nc_graph(8, NC_W)), vf_snapshot(nc_graph(8, NC_W)));
    assert nc_render(8, TH_T27, &NC_A) == VC_OK;
    assert nc_render(8, TH_T27, &NC_B) == VC_OK;
    assert vf_diff_count(&NC_A, &NC_B, NC_W, NC_H) == 0;
    // negative control: another block is another snapshot and other pixels
    assert vf_snapshot_equal(vf_snapshot(nc_graph(8, NC_W)), vf_snapshot(nc_graph(9, NC_W))) == false;
    assert nc_render(9, TH_T27, &NC_B) == VC_OK;
    assert vf_diff_count(&NC_A, &NC_B, NC_W, NC_H) > 0;
}

; the widest difference allowed between the left and the right ink inset of a badge label: the side bearings of its
; first and last glyph, which the advance width carries and the ink does not
pub const NC_PAD_TOL : u32 = 2;

test every_badge_keeps_its_label_on_its_fill_with_one_padding_on_both_sides {
    let st : VcStyle = vct_style(vct_metrics());
    var seen : u32 = 0;
    var theme : u32 = 0;
    while theme < 2 {
        var b : u32 = 0;
        while b <= NM_BLOCKS {
            let g : VfGraph = nc_graph(b, NC_W);
            let l : VfLayout = nc_layout(g, st);
            assert nc_render(b, theme, &NC_A) == VC_OK;
            var i : u32 = 0;
            while i < g.node_count {
                if g.kind[i] == VF_TEXT {
                    assert nc_ring_spill(&NC_A, l, i) == 0;
                }
                if g.kind[i] == VF_BADGE {
                    // measured on the painted frame: nothing of the label on the ring outside the badge
                    assert nc_ring_spill(&NC_A, l, i) == 0;
                    let k : NcInk = nc_ink(&NC_A, l, i, st.border);
                    assert k.any;
                    assert k.left <= k.right + NC_PAD_TOL;
                    assert k.right <= k.left + NC_PAD_TOL;
                    // the badge stays inside its row
                    let p : u32 = g.parent[i] as u32;
                    assert l.x[i] >= l.x[p];
                    assert l.x[i] + l.w[i] <= l.x[p] + l.w[p];
                    seen = seen + 1;
                }
                i = i + 1;
            }
            b = b + 1;
        }
        theme = theme + 1;
    }
    // 42 badges per theme: 17 pin badges, 24 body badges, 1 refusal badge
    assert seen == 84;
}
