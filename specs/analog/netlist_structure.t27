// SPDX-License-Identifier: Apache-2.0
; specs/analog/netlist_structure.t27 -- how a classified netlist block is drawn. Refs epic #13650 (Wave B, structure).
; Why. The meaning rule gives every block one class. A view needs more than a class: which token
; kinds make up the block's picture, whether its body is drawn item by item or folded into one
; counted box, and which inference label each part carries. That choice must be one table, the
; same for every deck, so a block never gets a hand-picked picture.
; What this module is: the table from a class to its picture plan, in the token kinds and labels of
; specs/t27f/netlist_tokens.t27, checked on the 17 census rows of the reference deck.
; --
; The plan of a class:
; - frame      the token kind of the block itself: NT_BLOCK, or NT_REFUSAL for an empty block.
; - instances  the body shows its subcircuit instances as NT_INSTANCE items.
; - devices    the body shows its devices as NT_DEVICE items.
; - folded     the body is one counted box instead of one item per line (the repeated array).
; - label      the frame is DERIVED (its class comes from a rule); body items are EXACT (each is
;              one line of the deck); a refusal is UNKNOWN.
; --
; NOT claimed: no pixel, size or position is decided here; nets and pins are not planned (the census
; row carries a pin count only); a folded body is not expanded; the table is checked on one deck.
; Every private helper carries the ns_ prefix. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module analog_netlist_structure;

use analog::netlist_meaning::NM_EMPTY;
use analog::netlist_meaning::NM_TOP;
use analog::netlist_meaning::NM_LEAF;
use analog::netlist_meaning::NM_ARRAY;
use analog::netlist_meaning::NM_COMPOSITE;
use analog::netlist_meaning::NM_MIXED;
use analog::netlist_meaning::NM_CLASSES;
use analog::netlist_meaning::NM_BLOCKS;
use analog::netlist_meaning::NM_SUB;
use analog::netlist_meaning::NM_MOS;
use analog::netlist_meaning::NM_MIM;
use analog::netlist_meaning::NM_PASSIVE;
use analog::netlist_meaning::nm_block_class;
use t27f::netlist_tokens::NT_BLOCK;
use t27f::netlist_tokens::NT_INSTANCE;
use t27f::netlist_tokens::NT_DEVICE;
use t27f::netlist_tokens::NT_REFUSAL;
use t27f::netlist_tokens::NT_EXACT;
use t27f::netlist_tokens::NT_DERIVED;
use t27f::netlist_tokens::NT_UNKNOWN;
use t27f::netlist_tokens::NT_NONE;
use t27f::netlist_tokens::nt_look;

pub fn ns_frame(class: u32) -> u32 {
    if class >= NM_CLASSES {
        return NT_NONE;
    }
    if class == NM_EMPTY {
        return NT_REFUSAL;
    }
    return NT_BLOCK;
}

pub fn ns_frame_label(class: u32) -> u32 {
    let frame : u32 = ns_frame(class);
    if frame == NT_NONE {
        return NT_NONE;
    }
    return nt_look(frame, NT_DERIVED);
}

pub fn ns_shows_instances(class: u32) -> bool {
    if class == NM_TOP {
        return true;
    }
    if class == NM_COMPOSITE {
        return true;
    }
    return class == NM_MIXED;
}

pub fn ns_shows_devices(class: u32) -> bool {
    if class == NM_TOP {
        return true;
    }
    if class == NM_LEAF {
        return true;
    }
    if class == NM_ARRAY {
        return true;
    }
    return class == NM_MIXED;
}

pub fn ns_folded(class: u32) -> bool {
    return class == NM_ARRAY;
}

; the label of one body item: exact, because each item is one element line of the deck
pub fn ns_item_label(class: u32, kind: u32) -> u32 {
    if kind == NT_INSTANCE {
        if ns_shows_instances(class) {
            return nt_look(NT_INSTANCE, NT_EXACT);
        }
        return NT_NONE;
    }
    if kind == NT_DEVICE {
        if ns_shows_devices(class) {
            return nt_look(NT_DEVICE, NT_EXACT);
        }
        return NT_NONE;
    }
    return NT_NONE;
}

; how many body items block i draws: one per line, or 1 for a folded body
pub fn ns_block_items(i: u32) -> u32 {
    if i >= NM_BLOCKS {
        return 0;
    }
    let class : u32 = nm_block_class(i);
    var n : u32 = 0;
    if ns_shows_instances(class) {
        n = n + NM_SUB[i];
    }
    if ns_shows_devices(class) {
        n = n + NM_MOS[i] + NM_MIM[i] + NM_PASSIVE[i];
    }
    if ns_folded(class) {
        if n > 0 {
            return 1;
        }
    }
    return n;
}

; how many element lines of block i the plan leaves undrawn (must be 0 for every block)
pub fn ns_block_lost(i: u32) -> u32 {
    if i >= NM_BLOCKS {
        return 0;
    }
    let class : u32 = nm_block_class(i);
    var lost : u32 = 0;
    if !ns_shows_instances(class) {
        lost = lost + NM_SUB[i];
    }
    if !ns_shows_devices(class) {
        lost = lost + NM_MOS[i] + NM_MIM[i] + NM_PASSIVE[i];
    }
    return lost;
}

test every_class_has_a_frame_and_only_empty_is_a_refusal {
    assert ns_frame(NM_EMPTY) == NT_REFUSAL;
    assert ns_frame_label(NM_EMPTY) == NT_UNKNOWN;
    var c : u32 = 1;
    while c < NM_CLASSES {
        assert ns_frame(c) == NT_BLOCK;
        assert ns_frame_label(c) == NT_DERIVED;
        c = c + 1;
    }
    assert ns_frame(NM_CLASSES) == NT_NONE;
    assert ns_frame_label(NM_CLASSES) == NT_NONE;
}

test body_items_are_exact_and_absent_kinds_are_refused {
    assert ns_item_label(NM_LEAF, NT_DEVICE) == NT_EXACT;
    assert ns_item_label(NM_LEAF, NT_INSTANCE) == NT_NONE;
    assert ns_item_label(NM_COMPOSITE, NT_INSTANCE) == NT_EXACT;
    assert ns_item_label(NM_COMPOSITE, NT_DEVICE) == NT_NONE;
    assert ns_item_label(NM_MIXED, NT_INSTANCE) == NT_EXACT;
    assert ns_item_label(NM_MIXED, NT_DEVICE) == NT_EXACT;
    assert ns_item_label(NM_EMPTY, NT_DEVICE) == NT_NONE;
    assert ns_item_label(NM_TOP, NT_BLOCK) == NT_NONE;
}

test no_element_line_of_the_deck_is_left_undrawn {
    var lost : u32 = 0;
    var i : u32 = 0;
    while i < NM_BLOCKS {
        lost = lost + ns_block_lost(i);
        i = i + 1;
    }
    assert lost == 0;
    assert ns_block_lost(17) == 0;
}

test the_deck_draws_185_items_with_the_array_folded {
    var items : u32 = 0;
    var i : u32 = 0;
    while i < NM_BLOCKS {
        items = items + ns_block_items(i);
        i = i + 1;
    }
    assert items == 185;
    assert ns_block_items(7) == 1;
    assert ns_block_items(0) == 61;
    assert ns_block_items(8) == 2;
    assert ns_block_items(11) == 10;
    assert ns_block_items(17) == 0;
}

test only_the_array_class_folds {
    assert ns_folded(NM_ARRAY);
    assert !ns_folded(NM_TOP);
    assert !ns_folded(NM_LEAF);
    assert !ns_folded(NM_COMPOSITE);
    assert !ns_folded(NM_MIXED);
    assert !ns_folded(NM_EMPTY);
}
