.temp 50
.options reltol=1e-4
.tran 5p 654n 0 50p
.control
option klu
set num_threads=8
pre_osdi $IHP_OSDI/psp103.osdi
pre_osdi $IHP_OSDI/psp103_nqs.osdi
set numdgt=7
run
meas tran c016l_n1f4 when v(n1_c016l)=0.75 fall=4
meas tran c016l_n1r4 when v(n1_c016l)=0.75 rise=4
meas tran c016l_n1r5 when v(n1_c016l)=0.75 rise=5
meas tran c016l_n2r4 when v(n2_c016l)=0.75 rise=4
meas tran c016l_n2f4 when v(n2_c016l)=0.75 fall=4
meas tran c016l_n2f5 when v(n2_c016l)=0.75 fall=5
