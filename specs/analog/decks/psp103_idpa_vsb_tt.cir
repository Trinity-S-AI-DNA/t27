* the held-out currents: the bulks back where the sweeps found them do not matter, the held-out devices have their own bulk sources
echo BEGIN cen_n
dc VK 1 1000 1
let u = nint(i(VRDN) * 1e12)
print u
echo END cen_n
echo BEGIN cen_p
