* ---- slice 4: Vsb = 1 V (the NMOS bulk at -1 V, the PMOS bulk at 2.5 V). Plots dc17, dc18: the Vds = 0 columns; dc19, dc20: the grids.
alter VBN = -1
alter VBP = 2.5
alter VDN = 0
dc VGN 0 1.5 0.015625
let gzn = @n.xmn.nsg13_lv_nmos[gds]
let kk = vector(97)
let vgk = kk * 0.015625
let ovk = (vgk - 0.23 + abs(vgk - 0.23)) / 2
let sk = sqrt(0.03 * 0.03 + 0.65 * 0.65 * ovk * ovk)
let rk = nint(4096 / sk)
let sek = 4096 / rk
let an = gzn * sek
let zn = (an + 1.1641532182693481e-12 + abs(an - 1.1641532182693481e-12)) / 2
let l0n = nint(65536 / ln(2) * ln(zn / 1.1641532182693481e-12))
alter VDP = 1.5
dc VGP 1.5 0 -0.015625
let gzp = @n.xmp.nsg13_lv_pmos[gds]
let kk = vector(97)
let vgk = kk * 0.015625
let ovk = (vgk - 0.23 + abs(vgk - 0.23)) / 2
let sk = sqrt(0.03 * 0.03 + 0.65 * 0.65 * ovk * ovk)
let rk = nint(4096 / sk)
