meas tran d_nor3_b_1_f trig v(in) val=0.75 rise=1 targ v(y_nor3b_1) val=0.75 fall=1
meas tran d_nor3_c_1_r trig v(in) val=0.75 fall=1 targ v(y_nor3c_1) val=0.75 rise=1
meas tran d_nor3_c_1_f trig v(in) val=0.75 rise=1 targ v(y_nor3c_1) val=0.75 fall=1
meas tran d_nand_a_1_r trig v(in) val=0.75 fall=1 targ v(y_nanda_1) val=0.75 rise=1
meas tran d_nand_a_1_f trig v(in) val=0.75 rise=1 targ v(y_nanda_1) val=0.75 fall=1
meas tran d_nand_b_1_r trig v(in) val=0.75 fall=1 targ v(y_nandb_1) val=0.75 rise=1
meas tran d_nand_b_1_f trig v(in) val=0.75 rise=1 targ v(y_nandb_1) val=0.75 fall=1
meas tran d_tgp_1_r trig v(in) val=0.75 rise=1 targ v(y_tgp_1) val=0.75 rise=1
meas tran d_tgp_1_f trig v(in) val=0.75 fall=1 targ v(y_tgp_1) val=0.75 fall=1
meas tran d_tge_1_f trig v(ck) val=0.75 rise=1 targ v(y_tgef_1) val=0.75 fall=1
meas tran d_tge_1_r trig v(ckn) val=0.75 fall=1 targ v(y_tger_1) val=0.75 rise=1
meas tran d_inv_a_4_r trig v(in) val=0.75 fall=1 targ v(y_inv_4) val=0.75 rise=1
meas tran d_inv_a_4_f trig v(in) val=0.75 rise=1 targ v(y_inv_4) val=0.75 fall=1
meas tran d_nor_a_4_r trig v(in) val=0.75 fall=1 targ v(y_nora_4) val=0.75 rise=1
meas tran d_nor_a_4_f trig v(in) val=0.75 rise=1 targ v(y_nora_4) val=0.75 fall=1
meas tran d_nor_b_4_r trig v(in) val=0.75 fall=1 targ v(y_norb_4) val=0.75 rise=1
meas tran d_nor_b_4_f trig v(in) val=0.75 rise=1 targ v(y_norb_4) val=0.75 fall=1
