meas tran d_nor3_c_4_f trig v(in) val=0.75 rise=1 targ v(y_nor3c_4) val=0.75 fall=1
meas tran d_nand_a_4_r trig v(in) val=0.75 fall=1 targ v(y_nanda_4) val=0.75 rise=1
