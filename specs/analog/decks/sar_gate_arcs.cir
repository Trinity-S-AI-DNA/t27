meas tran d_tgp_4_f trig v(in) val=0.75 fall=1 targ v(y_tgp_4) val=0.75 fall=1
meas tran d_tge_4_f trig v(ck) val=0.75 rise=1 targ v(y_tgef_4) val=0.75 fall=1
meas tran d_tge_4_r trig v(ckn) val=0.75 fall=1 targ v(y_tger_4) val=0.75 rise=1
meas tran d_inv_a_16_r trig v(in) val=0.75 fall=1 targ v(y_inv_16) val=0.75 rise=1
meas tran d_inv_a_16_f trig v(in) val=0.75 rise=1 targ v(y_inv_16) val=0.75 fall=1
meas tran d_nor_a_16_r trig v(in) val=0.75 fall=1 targ v(y_nora_16) val=0.75 rise=1
meas tran d_nor_a_16_f trig v(in) val=0.75 rise=1 targ v(y_nora_16) val=0.75 fall=1
meas tran d_nor_b_16_r trig v(in) val=0.75 fall=1 targ v(y_norb_16) val=0.75 rise=1
meas tran d_nor_b_16_f trig v(in) val=0.75 rise=1 targ v(y_norb_16) val=0.75 fall=1
