; --- the accessors and the tests ------------------------------------------------------------------------

/// The fold of the first n entries of t after the state s. Order matters.
pub fn fold_arr(t: []const u32, n: usize, s: u64) -> u64 {
    var acc : u64 = s;
    var i : usize = 0;
    while (i < n) {
        acc = fold(acc, t[i]);
        i = i + 1;
    }
    return acc;
}

/// The NMOS table of corner c (CORNER_TT .. CORNER_SF); any other index gives the tt table.
pub fn table_n(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_N; }
    if (c == CORNER_SS) { return &SS_N; }
    if (c == CORNER_FS) { return &FS_N; }
    if (c == CORNER_SF) { return &SF_N; }
    return &TT_N;
}

/// The PMOS table of corner c.
pub fn table_p(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_P; }
    if (c == CORNER_SS) { return &SS_P; }
    if (c == CORNER_FS) { return &FS_P; }
    if (c == CORNER_SF) { return &SF_P; }
    return &TT_P;
}

/// The inverter's DC transfer of corner c, 49 points.
pub fn inv_dc(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_INV; }
    if (c == CORNER_SS) { return &SS_INV; }
    if (c == CORNER_FS) { return &FS_INV; }
    if (c == CORNER_SF) { return &SF_INV; }
    return &TT_INV;
}

/// The held-out NMOS currents in pA of corner c.
pub fn r2_n(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_R2_N; }
    if (c == CORNER_SS) { return &SS_R2_N; }
    if (c == CORNER_FS) { return &FS_R2_N; }
    if (c == CORNER_SF) { return &SF_R2_N; }
    return &TT_R2_N;
}

/// The held-out PMOS currents in pA of corner c.
pub fn r2_p(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_R2_P; }
    if (c == CORNER_SS) { return &SS_R2_P; }
    if (c == CORNER_FS) { return &FS_R2_P; }
    if (c == CORNER_SF) { return &SF_R2_P; }
    return &TT_R2_P;
}

/// How many held-out points corner c has.
pub fn r2_count(c: u32) -> u32 {
    if (c == CORNER_TT) { return R2_TT_COUNT; }
    return R2_OTHER_COUNT;
}

/// The NMOS drain-charge table of corner c (any other index gives the tt table).
pub fn qd_n(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_QD_N; }
    if (c == CORNER_SS) { return &SS_QD_N; }
    if (c == CORNER_FS) { return &FS_QD_N; }
    if (c == CORNER_SF) { return &SF_QD_N; }
    return &TT_QD_N;
}

/// The NMOS gate-charge table of corner c.
pub fn qg_n(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_QG_N; }
    if (c == CORNER_SS) { return &SS_QG_N; }
    if (c == CORNER_FS) { return &FS_QG_N; }
    if (c == CORNER_SF) { return &SF_QG_N; }
    return &TT_QG_N;
}

/// The PMOS drain-charge table of corner c (negated, see THE CHARGE TABLES).
pub fn qd_p(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_QD_P; }
    if (c == CORNER_SS) { return &SS_QD_P; }
    if (c == CORNER_FS) { return &FS_QD_P; }
    if (c == CORNER_SF) { return &SF_QD_P; }
    return &TT_QD_P;
}

/// The PMOS gate-charge table of corner c (negated).
pub fn qg_p(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_QG_P; }
    if (c == CORNER_SS) { return &SS_QG_P; }
    if (c == CORNER_FS) { return &FS_QG_P; }
    if (c == CORNER_SF) { return &SF_QG_P; }
    return &TT_QG_P;
}

/// The 401-sample 500 fF waveform of ngspice backward Euler in corner c.
pub fn inv500_be(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_INV500_BE; }
    if (c == CORNER_SS) { return &SS_INV500_BE; }
    if (c == CORNER_FS) { return &FS_INV500_BE; }
    if (c == CORNER_SF) { return &SF_INV500_BE; }
    return &INV500_BE;
}

/// ngspice's 0.75 V crossing time of the rising edge (tpLH, after step 0), in fs, in corner c.
pub fn inv500_tplh_fs(c: u32) -> u32 {
    if (c == CORNER_FF) { return FF_INV500_BE_TPLH_FS; }
    if (c == CORNER_SS) { return SS_INV500_BE_TPLH_FS; }
    if (c == CORNER_FS) { return FS_INV500_BE_TPLH_FS; }
    if (c == CORNER_SF) { return SF_INV500_BE_TPLH_FS; }
    return INV500_BE_TPLH_FS;
}

/// ngspice's 0.75 V crossing time of the falling edge (tpHL, after step 200), in fs, in corner c.
pub fn inv500_tphl_fs(c: u32) -> u32 {
    if (c == CORNER_FF) { return FF_INV500_BE_TPHL_FS; }
    if (c == CORNER_SS) { return SS_INV500_BE_TPHL_FS; }
    if (c == CORNER_FS) { return FS_INV500_BE_TPHL_FS; }
    if (c == CORNER_SF) { return SF_INV500_BE_TPHL_FS; }
    return INV500_BE_TPHL_FS;
}

/// The fold of corner c's four charge tables in the order qd_n, qg_n, qd_p, qg_p (the value its PIN_*_Q pins).
pub fn fold_q(c: u32) -> u64 {
    var s : u64 = fold_arr(qd_n(c), 625, 0);
    s = fold_arr(qg_n(c), 625, s);
    s = fold_arr(qd_p(c), 625, s);
    s = fold_arr(qg_p(c), 625, s);
    return s;
}

test the_five_corners_are_the_numbers_ngspice_printed {
    // A table is the NMOS table, the PMOS table and the inverter's transfer, in that order.
    var s : u64 = fold_arr(&TT_N, 625, 0);
    s = fold_arr(&TT_P, 625, s);
    s = fold_arr(&TT_INV, 49, s);
    assert_eq(s, PIN_TT);
    s = fold_arr(&FF_N, 625, 0);
    s = fold_arr(&FF_P, 625, s);
    s = fold_arr(&FF_INV, 49, s);
    assert_eq(s, PIN_FF);
    s = fold_arr(&SS_N, 625, 0);
    s = fold_arr(&SS_P, 625, s);
    s = fold_arr(&SS_INV, 49, s);
    assert_eq(s, PIN_SS);
    s = fold_arr(&FS_N, 625, 0);
    s = fold_arr(&FS_P, 625, s);
    s = fold_arr(&FS_INV, 49, s);
    assert_eq(s, PIN_FS);
    s = fold_arr(&SF_N, 625, 0);
    s = fold_arr(&SF_P, 625, s);
    s = fold_arr(&SF_INV, 49, s);
    assert_eq(s, PIN_SF);
}

// Negative control (#11061): one changed number is not the table ngspice printed, and the SS corner in the TT slots is not either.
test one_changed_number_and_the_wrong_corners_tables_are_caught_by_the_pins {
    var t : [625]u32 = [0] ** 625;
    var i : usize = 0;
    while (i < 625) {
        t[i] = TT_N[i];
        i = i + 1;
    }
    var s : u64 = fold_arr(&t, 625, 0);
    s = fold_arr(&TT_P, 625, s);
    s = fold_arr(&TT_INV, 49, s);
    assert_eq(s, PIN_TT);
    t[624] = t[624] - 1;
    s = fold_arr(&t, 625, 0);
    s = fold_arr(&TT_P, 625, s);
    s = fold_arr(&TT_INV, 49, s);
    assert s != PIN_TT;
    s = fold_arr(&SS_N, 625, 0);
    s = fold_arr(&SS_P, 625, s);
    s = fold_arr(&SS_INV, 49, s);
    assert s != PIN_TT;
    assert_eq(s, PIN_SS);
}

test the_held_out_and_transient_numbers_are_the_numbers_ngspice_printed {
    var s : u64 = fold_arr(&TT_R2_N, 1000, 0);
    s = fold_arr(&TT_R2_P, 1000, s);
    s = fold_arr(&TT_MID_N, 576, s);
    s = fold_arr(&TT_MID_P, 576, s);
    assert_eq(s, PIN_TT_HELD);
    s = fold_arr(&FF_R2_N, 200, 0);
    s = fold_arr(&FF_R2_P, 200, s);
    s = fold_arr(&SS_R2_N, 200, s);
    s = fold_arr(&SS_R2_P, 200, s);
    s = fold_arr(&FS_R2_N, 200, s);
    s = fold_arr(&FS_R2_P, 200, s);
    s = fold_arr(&SF_R2_N, 200, s);
    s = fold_arr(&SF_R2_P, 200, s);
    assert_eq(s, PIN_OTHER_HELD);
    s = fold_arr(&INV10_BE, 401, 0);
    s = fold_arr(&INV10_FINE, 401, s);
    assert_eq(s, PIN_TRAN);
    // A pin sees one changed number: the fold of the tt NMOS table with its last entry one lower is another word.
    var t : [625]u32 = [0] ** 625;
    var i : usize = 0;
    while (i < 625) {
        t[i] = TT_N[i];
        i = i + 1;
    }
    t[624] = t[624] - 1;
    assert fold_arr(&t, 625, 0) != fold_arr(&TT_N, 625, 0);
}

test the_accessors_return_their_own_corner_and_the_corners_differ {
    // The saturation corner of each table, Id(1.5 V, 1.5 V): the accessor returns the named table, and the corners are in the
    // order the foundry names them: ff above tt above ss for both devices.
    assert_eq(table_n(CORNER_TT)[624], TT_N[624]);
    assert_eq(table_n(CORNER_FF)[624], FF_N[624]);
    assert_eq(table_n(CORNER_SS)[624], SS_N[624]);
    assert_eq(table_n(CORNER_FS)[624], FS_N[624]);
    assert_eq(table_n(CORNER_SF)[624], SF_N[624]);
    assert_eq(table_p(CORNER_TT)[624], TT_P[624]);
    assert_eq(table_p(CORNER_FF)[624], FF_P[624]);
    assert_eq(table_p(CORNER_SS)[624], SS_P[624]);
    assert_eq(table_p(CORNER_FS)[624], FS_P[624]);
    assert_eq(table_p(CORNER_SF)[624], SF_P[624]);
    assert_eq(inv_dc(CORNER_SS)[48], SS_INV[48]);
    assert_eq(r2_n(CORNER_FS)[199], FS_R2_N[199]);
    assert_eq(r2_p(CORNER_SF)[0], SF_R2_P[0]);
    assert FF_N[624] > TT_N[624];
    assert TT_N[624] > SS_N[624];
    assert FF_P[624] > TT_P[624];
    assert TT_P[624] > SS_P[624];
    // fs is a fast NMOS with a slow PMOS, sf the reverse.
    assert FS_N[624] > TT_N[624];
    assert FS_P[624] < TT_P[624];
    assert SF_N[624] < TT_N[624];
    assert SF_P[624] > TT_P[624];
    assert_eq(r2_count(CORNER_TT), 1000);
    assert_eq(r2_count(CORNER_SF), 200);
    // The charge accessors (M3c, M3c-3) return their own corner's tables, at the saturation corner of the grid (1.5 V, 1.5 V).
    assert_eq(qd_n(CORNER_TT)[624], TT_QD_N[624]);
    assert_eq(qd_n(CORNER_FF)[624], FF_QD_N[624]);
    assert_eq(qd_n(CORNER_SS)[624], SS_QD_N[624]);
    assert_eq(qd_n(CORNER_FS)[624], FS_QD_N[624]);
    assert_eq(qd_n(CORNER_SF)[624], SF_QD_N[624]);
    assert_eq(qg_n(CORNER_FF)[624], FF_QG_N[624]);
    assert_eq(qg_n(CORNER_FS)[624], FS_QG_N[624]);
    assert_eq(qg_n(CORNER_SF)[624], SF_QG_N[624]);
    assert_eq(qd_p(CORNER_FF)[624], FF_QD_P[624]);
    assert_eq(qd_p(CORNER_FS)[624], FS_QD_P[624]);
    assert_eq(qd_p(CORNER_SF)[624], SF_QD_P[624]);
    assert_eq(qg_p(CORNER_FF)[624], FF_QG_P[624]);
    assert_eq(qg_p(CORNER_FS)[624], FS_QG_P[624]);
    assert_eq(qg_p(CORNER_SF)[624], SF_QG_P[624]);
    // The NMOS gate charge at (1.5 V, 1.5 V) is in the order of the NMOS's corner: ff 2274340, fs 2269859, tt 2265512, sf 2261436, ss 2257406.
    assert FF_QG_N[624] > FS_QG_N[624];
    assert FS_QG_N[624] > TT_QG_N[624];
    assert TT_QG_N[624] > SF_QG_N[624];
    assert SF_QG_N[624] > SS_QG_N[624];
}

test the_grid_and_the_units_of_the_numbers_are_consistent {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var cell_uv : u32 = CELL_UV;
    var vdd_mv : u32 = VDD_MV;
    var upv : u32 = UNITS_PER_V;
    var dtc : u32 = DTC_V_PER_A;
    // 24 cells of 62.5 mV are 1.5 V, and a cell is 2^20 units of 2^-24 V.
    assert_eq(24 * cell_uv, vdd_mv * 1000);
    assert_eq(upv / 16, 1048576);
    assert_eq(((cell_uv as u64) * (upv as u64)) / 1000000, 1048576);
    // The largest entry, Id(1.5 V, 1.5 V) of the tt NMOS, is 402.3 uA: 402.3e-6 * 200 * 2^24 = 1349912, below the 2^23 the
    // solver's u64 interpolation allows, and the PMOS 301.5 uA.
    assert_eq(TT_N[624], 1349912);
    assert_eq(TT_P[624], 1011527);
    assert TT_N[624] < 8388608;
    assert FF_N[624] < 8388608;
    assert_eq(dtc, 200);
    // The tt NMOS current at the corner, in A: within 1e-9 A of the 402.305 uA ngspice prints at Vgs = Vds = 1.5 V.
    const amps : f64 = (TT_N[624] as f64) / ((dtc as f64) * (upv as f64));
    const d : f64 = amps - 0.000402305;
    assert d * d < 0.000000001 * 0.000000001;
}

test the_charge_tables_are_the_numbers_ngspice_printed {
    // A corner's charge tables are qd_n, qg_n, qd_p, qg_p, in that order; the five corners have a pin each (M3c: tt and ss, M3c-3: ff, fs, sf).
    var s : u64 = fold_arr(&TT_QD_N, 625, 0);
    s = fold_arr(&TT_QG_N, 625, s);
    s = fold_arr(&TT_QD_P, 625, s);
    s = fold_arr(&TT_QG_P, 625, s);
    assert_eq(s, PIN_TT_Q);
    s = fold_arr(&SS_QD_N, 625, 0);
    s = fold_arr(&SS_QG_N, 625, s);
    s = fold_arr(&SS_QD_P, 625, s);
    s = fold_arr(&SS_QG_P, 625, s);
    assert_eq(s, PIN_SS_Q);
    // The accessors route to the same tables: fold_q reads them through qd_n, qg_n, qd_p, qg_p.
    assert_eq(fold_q(CORNER_TT), PIN_TT_Q);
    assert_eq(fold_q(CORNER_SS), PIN_SS_Q);
    assert_eq(fold_q(CORNER_FF), PIN_FF_Q);
    assert_eq(fold_q(CORNER_FS), PIN_FS_Q);
    assert_eq(fold_q(CORNER_SF), PIN_SF_Q);
    // No two corners have the same pin: the five tables are five different sets of words.
    assert PIN_TT_Q != PIN_SS_Q;
    assert PIN_FF_Q != PIN_TT_Q;
    assert PIN_FS_Q != PIN_SF_Q;
    assert PIN_FF_Q != PIN_FS_Q;
    assert PIN_SS_Q != PIN_SF_Q;
    // The fs tables in the sf slot are caught by the pin.
    var wrong : u64 = fold_arr(&FS_QD_N, 625, 0);
    wrong = fold_arr(&FS_QG_N, 625, wrong);
    wrong = fold_arr(&FS_QD_P, 625, wrong);
    wrong = fold_arr(&FS_QG_P, 625, wrong);
    assert wrong != PIN_SF_Q;
    assert_eq(wrong, PIN_FS_Q);
    // A pin sees one changed number.
    var t : [625]u32 = [0] ** 625;
    var i : usize = 0;
    while (i < 625) {
        t[i] = TT_QD_N[i];
        i = i + 1;
    }
    t[300] = t[300] + 1;
    assert fold_arr(&t, 625, 0) != fold_arr(&TT_QD_N, 625, 0);
}

test the_charge_tables_are_relative_to_the_origin_and_fit_the_reader {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var off : u32 = Q_OFFSET;
    var cref : u32 = C_REF_FF;
    assert_eq(cref, 500);
    assert_eq(off, 2097152);
    // Entry 0 is the grid origin (Vgs = Vds = 0), the charge relative to which every other entry is taken: exactly the offset, in every
    // corner. No entry of any corner is below 10^6 or above 4 * 10^6: the offset is large against the most negative charge (a few fC)
    // and small against the 2^23 the solver's u64 interpolation allows.
    var lo : u32 = off;
    var hi : u32 = off;
    var c : u32 = 0;
    while (c < 5) {
        assert_eq(qd_n(c)[0], off);
        assert_eq(qg_n(c)[0], off);
        assert_eq(qd_p(c)[0], off);
        assert_eq(qg_p(c)[0], off);
        var j : u32 = 0;
        while (j < 625) {
            const a : u32 = qd_n(c)[j as usize];
            const b : u32 = qg_n(c)[j as usize];
            const e : u32 = qd_p(c)[j as usize];
            const f : u32 = qg_p(c)[j as usize];
            assert a > 1000000;
            assert b > 1000000;
            assert e > 1000000;
            assert f > 1000000;
            assert a < 4000000;
            assert b < 4000000;
            assert e < 4000000;
            assert f < 4000000;
            if (a < lo) { lo = a; }
            if (b < lo) { lo = b; }
            if (e < lo) { lo = e; }
            if (f < lo) { lo = f; }
            if (a > hi) { hi = a; }
            if (b > hi) { hi = b; }
            if (e > hi) { hi = e; }
            if (f > hi) { hi = f; }
            j = j + 1;
        }
        c = c + 1;
    }
    // The most negative entry of the five corners is the ff PMOS drain charge (negated, at Vsg = 1.5 V, Vsd = 0): 1749386 - 2097152 =
    // -347766 units = -10.4 fC; the largest is the ff PMOS gate charge (negated) at (1.5 V, 1.5 V): 2840494 - 2097152 = 743342 units = 22 fC.
    // (Over tt alone they were 1769780 and 2802131.)
    assert_eq(lo, 1749386);
    assert_eq(hi, 2840494);
}

test the_gate_node_waveform_is_the_numbers_ngspice_printed {
    assert_eq(fold_arr(&GATE_BE, 401, 0), PIN_GATE_BE);
    // The numbers are read from a copy (a variable: an assert on a constant array word is folded by the compiler and counts as none).
    var t : [401]u32 = [0] ** 401;
    var j : usize = 0;
    while (j < 401) {
        t[j] = GATE_BE[j];
        j = j + 1;
    }
    // A pin sees one changed number.
    const pin : u64 = fold_arr(&t, 401, 0);
    assert_eq(pin, PIN_GATE_BE);
    t[100] = t[100] + 1;
    assert fold_arr(&t, 401, 0) != pin;
    t[100] = t[100] - 1;
    // At rest before step 0 the node is at its 0.75 V bias (12582912 units), ngspice's own word one unit above (the leak of the off PMOS).
    assert_eq(t[0], 12582913);
    // The node never leaves 0.59 .. 1.08 V (9991744 and 18127553 units): inside the 0 .. 1.5 V of the tables, with 0.59 V to spare below and 0.42 V above.
    var lo : u32 = t[0];
    var hi : u32 = t[0];
    var i : usize = 0;
    while (i < 401) {
        if (t[i] < lo) { lo = t[i]; }
        if (t[i] > hi) { hi = t[i]; }
        i = i + 1;
    }
    assert_eq(lo, 9991744);
    assert_eq(hi, 18127553);
    // The jump of charge: after step 0 the node is 0.154 V BELOW its rest although the PMOS is on and pushes it up (the gate edge took the charge off first).
    assert t[1] < t[0] - 2500000;
    assert t[1] > t[0] - 2600000;
    // It relaxes to the bias: after step 399 it is 12594868, 11955 units (0.71 mV) above the rest, the tail of the relaxation (time constant 0.35 ns = 70 steps).
    assert t[400] > t[0];
    assert t[400] < t[0] + 20000;
}

test the_500_fF_waveform_is_the_numbers_ngspice_printed {
    assert_eq(fold_arr(&INV500_BE, 401, 0), PIN_TRAN500);
    // M3c-3: the other four corners' waveforms, each its own ngspice run of its own corner, and the accessors that give them.
    assert_eq(fold_arr(&SS_INV500_BE, 401, 0), PIN_TRAN500_SS);
    assert_eq(fold_arr(&FF_INV500_BE, 401, 0), PIN_TRAN500_FF);
    assert_eq(fold_arr(&FS_INV500_BE, 401, 0), PIN_TRAN500_FS);
    assert_eq(fold_arr(&SF_INV500_BE, 401, 0), PIN_TRAN500_SF);
    assert_eq(fold_arr(inv500_be(CORNER_TT), 401, 0), PIN_TRAN500);
    assert_eq(fold_arr(inv500_be(CORNER_SS), 401, 0), PIN_TRAN500_SS);
    assert_eq(fold_arr(inv500_be(CORNER_FF), 401, 0), PIN_TRAN500_FF);
    assert_eq(fold_arr(inv500_be(CORNER_FS), 401, 0), PIN_TRAN500_FS);
    assert_eq(fold_arr(inv500_be(CORNER_SF), 401, 0), PIN_TRAN500_SF);
    // In every corner the circuit is at rest before step 0 and after step 399: the output goes down and comes back to the same word.
    // The rest is the corner's own (ngspice's: ss 3, sf 6, tt 11, fs 19, ff 37 units, all under 40 = 2.4 uV).
    var c : u32 = 0;
    while (c < 5) {
        const w : []const u32 = inv500_be(c);
        assert_eq(w[0], w[400]);
        assert w[0] < 40;
        assert w[1] > 600000;
        assert w[200] > 25165700;
        c = c + 1;
    }
    assert_eq(SS_INV500_BE[0], 3);
    assert_eq(SF_INV500_BE[0], 6);
    assert_eq(FS_INV500_BE[0], 19);
    assert_eq(FF_INV500_BE[0], 37);
    // The two 0.75 V crossing times (ngspice .meas, six digits, in fs) are in the order of the corners' drive: the rising edge is
    // fastest in ff and slowest in ss, the falling edge fastest in ff and slowest in ss, and the mixed corners follow their own device
    // (fs has the fast NMOS, so the fall is fast; sf has the fast PMOS, so the rise is fast), as the table of drive currents says.
    assert inv500_tplh_fs(CORNER_FF) < inv500_tplh_fs(CORNER_TT);
    assert inv500_tplh_fs(CORNER_TT) < inv500_tplh_fs(CORNER_SS);
    assert inv500_tphl_fs(CORNER_FF) < inv500_tphl_fs(CORNER_TT);
    assert inv500_tphl_fs(CORNER_TT) < inv500_tphl_fs(CORNER_SS);
    assert inv500_tplh_fs(CORNER_SF) < inv500_tplh_fs(CORNER_FS);
    assert inv500_tphl_fs(CORNER_FS) < inv500_tphl_fs(CORNER_SF);
    assert_eq(inv500_tplh_fs(CORNER_TT), 1443520);
    assert_eq(inv500_tphl_fs(CORNER_TT), 21118300);
    // The same circuit at rest as the 10 pF run (11 units, 0.66 uV), before step 0 and after step 399: the output goes down and comes back.
    assert_eq(INV500_BE[0], INV10_BE[0]);
    assert_eq(INV500_BE[400], INV10_BE[400]);
    // After step 0 the output has left the rail by 689206 units (41 mV): the PMOS charges 500 fF, and the gate edge couples charge in.
    assert_eq(INV500_BE[1], 689206);
    // A pin sees one changed number.
    var t : [401]u32 = [0] ** 401;
    var i : usize = 0;
    while (i < 401) {
        t[i] = INV500_BE[i];
        i = i + 1;
    }
    t[200] = t[200] + 1;
    assert fold_arr(&t, 401, 0) != fold_arr(&INV500_BE, 401, 0);
}

test the_log_domain_tables_are_the_numbers_ngspice_printed {
    // M3c-2 (#10881). The two tables, the tag word first, in the order N then P, and the 1000 + 1000 held-out currents: the pins see one changed number.
    var s : u64 = fold_arr(&TT_LG_N, 4851, 0);
    s = fold_arr(&TT_LG_P, 4851, s);
    assert_eq(s, PIN_TT_LG);
    var c : u64 = fold_arr(&TT_CEN_N, 1000, 0);
    c = fold_arr(&TT_CEN_P, 1000, c);
    assert_eq(c, PIN_TT_CEN);
    // The layout: the tag word, 97 * 49 words of log2(Id / F), 97 words of rv. The format constants agree with it and with the 1.5 V supply.
    var gn : u32 = LOG_NODES_G;
    var dn : u32 = LOG_NODES_D;
    var gstep : u32 = LOG_GRID_G_UV;
    var dstep : u32 = LOG_GRID_D_UV;
    assert_eq(gn * dn, 4753);
    assert_eq(1 + gn * dn + gn, 4851);
    assert_eq((gn - 1) * gstep, 1000 * VDD_MV);
    assert_eq((dn - 1) * dstep, 1000 * VDD_MV);
    assert_eq(LOG_FRAC_BITS, 16);
    assert_eq(LOG_FINE_BITS, 8);
    assert_eq(TT_LG_N[0], 4294967295);
    assert_eq(TT_LG_P[0], 4294967295);
    // Every log word is under 2^21 (the reader's u64 interpolation needs under 2^23): at most 1.91 M, 29.1 octaves over 1.164 pA, 0.65 mA of Id / F at Vds = 0; at
    // least 0.41 M (NMOS: 87 pA of off current) and 0.22 M (PMOS: 11 pA).
    var lo_n : u32 = TT_LG_N[1];
    var hi_n : u32 = TT_LG_N[1];
    var lo_p : u32 = TT_LG_P[1];
    var hi_p : u32 = TT_LG_P[1];
    var i : usize = 1;
    while (i <= 4753) {
        if (TT_LG_N[i] < lo_n) { lo_n = TT_LG_N[i]; }
        if (TT_LG_N[i] > hi_n) { hi_n = TT_LG_N[i]; }
        if (TT_LG_P[i] < lo_p) { lo_p = TT_LG_P[i]; }
        if (TT_LG_P[i] > hi_p) { hi_p = TT_LG_P[i]; }
        i = i + 1;
    }
    assert_eq(hi_n, 1906797);
    assert_eq(hi_p, 1875577);
    assert_eq(lo_n, 406768);
    assert_eq(lo_p, 215532);
    assert hi_n < 2097152;
    assert hi_p < 2097152;
    // The rv words (the last 97 of a table) follow their formula, rv = nint(4096 / s) with s^2 = 0.03^2 + (0.65 max(Vgs - 0.23, 0))^2: rv^2 s^2 = 4096^2 to the
    // rounding of rv (half a word, so 1 / rv in the square), for both tables alike, and they never rise with Vgs.
    var k : usize = 0;
    var steps : u32 = 0;
    while (k < 97) {
        const vg : f64 = ((k as f64) * (gstep as f64)) * 0.000001;
        var ov : f64 = vg - 0.23;
        if (ov < 0.0) { ov = 0.0; }
        const s2 : f64 = 0.0009 + 0.4225 * ov * ov;
        const rv : f64 = (TT_LG_N[4754 + k]) as f64;
        const dev : f64 = (rv * rv * s2) / 16777216.0 - 1.0;
        assert dev * dev * rv * rv < 1.21;
        assert_eq(TT_LG_N[4754 + k], TT_LG_P[4754 + k]);
        if (k > 0) {
            assert TT_LG_N[4754 + k] <= TT_LG_N[4754 + k - 1];
            steps = steps + 1;
        }
        k = k + 1;
    }
    assert_eq(steps, 96);
    assert_eq(TT_LG_N[4754], 136533);
    assert_eq(TT_LG_N[4850], 4959);
    // The held-out currents at cell centres: all positive, the smallest 86 pA (NMOS) and 12 pA (PMOS), the largest 396 uA and 297 uA.
    var cmin_n : u32 = TT_CEN_N[0];
    var cmax_n : u32 = TT_CEN_N[0];
    var cmin_p : u32 = TT_CEN_P[0];
    var cmax_p : u32 = TT_CEN_P[0];
    i = 0;
    while (i < 1000) {
        if (TT_CEN_N[i] < cmin_n) { cmin_n = TT_CEN_N[i]; }
        if (TT_CEN_N[i] > cmax_n) { cmax_n = TT_CEN_N[i]; }
        if (TT_CEN_P[i] < cmin_p) { cmin_p = TT_CEN_P[i]; }
        if (TT_CEN_P[i] > cmax_p) { cmax_p = TT_CEN_P[i]; }
        i = i + 1;
    }
    assert_eq(cmin_n, 86);
    assert_eq(cmin_p, 12);
    assert_eq(cmax_n, 396223503);
    assert_eq(cmax_p, 296828444);
    // The count constant, and a pin sees one changed number in a table of this size too.
    assert_eq(LOG_CEN_COUNT, 1000);
    var t : [4851]u32 = [0] ** 4851;
    i = 0;
    while (i < 4851) {
        t[i] = TT_LG_N[i];
        i = i + 1;
    }
    t[2000] = t[2000] + 1;
    assert fold_arr(&t, 4851, 0) != fold_arr(&TT_LG_N, 4851, 0);
}
