    if (c == CORNER_FF) { return &FF_LG_P; }
    if (c == CORNER_SS) { return &SS_LG_P; }
    if (c == CORNER_FS) { return &FS_LG_P; }
    if (c == CORNER_SF) { return &SF_LG_P; }
    return &TT_LG_P;
