    25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811,
    25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811, 25165811,
    25165811, 25165811, 25165811, 25165811, 24233230, 22906610, 21589340, 20282582, 18987794, 17707063, 16443187, 15199640, 13980956, 12792926,
