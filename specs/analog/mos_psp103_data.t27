pub const CORNER_FS : u32 = 3;
pub const CORNER_SF : u32 = 4;
/// The held-out R2 points: point k = 1..N is Vgs (Vsg) = 1.5 frac(k R2_A1), Vds (Vsd) = 1.5 frac(k R2_A2).
pub const R2_A1 : f64 = 0.7548776662466927;
pub const R2_A2 : f64 = 0.5698402909980532;
/// The R2 points given per corner: 1000 for tt, 200 for the others.
pub const R2_TT_COUNT : u32 = 1000;
pub const R2_OTHER_COUNT : u32 = 200;
/// The charge tables: an entry is Q / C_REF in units of 2^-24 V, relative to the grid origin, plus Q_OFFSET (so no entry is negative).
pub const C_REF_FF : u32 = 500;
pub const Q_OFFSET : u32 = 2097152;
/// The capacitances ngspice itself reports at the NMOS operating point Vgs = 0.9 V, Vds = 0.75 V, in aF (deck psp103_q_tt.cir, block op_n):
/// the channel capacitances cdd, cdg, cgg and, each apart, the gate-source and gate-drain overlaps and the drain junction.
