pub const PDK_COMMIT : str = "21133f219b1a6da10d803e345761e77415ceff40";
pub const TEMP_C : u32 = 27;
/// sg13_lv_nmos: W = 1.0 um, L = 0.45 um, ng = 1, m = 1. sg13_lv_pmos: W = 3.0 um, L = 0.45 um, ng = 1, m = 1.
pub const NMOS_W_NM : u32 = 1000;
pub const PMOS_W_NM : u32 = 3000;
pub const L_NM : u32 = 450;
