}

/// The PMOS gate-charge table of corner c (negated).
pub fn qg_p(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_QG_P; }
    if (c == CORNER_SS) { return &SS_QG_P; }
    if (c == CORNER_FS) { return &FS_QG_P; }
    if (c == CORNER_SF) { return &SF_QG_P; }
    return &TT_QG_P;
}

/// The 401-sample 500 fF waveform of ngspice backward Euler in corner c.
pub fn inv500_be(c: u32) -> []const u32 {
    if (c == CORNER_FF) { return &FF_INV500_BE; }
    if (c == CORNER_SS) { return &SS_INV500_BE; }
    if (c == CORNER_FS) { return &FS_INV500_BE; }
    if (c == CORNER_SF) { return &SF_INV500_BE; }
    return &INV500_BE;
}

/// ngspice's 0.75 V crossing time of the rising edge (tpLH, after step 0), in fs, in corner c.
pub fn inv500_tplh_fs(c: u32) -> u32 {
    if (c == CORNER_FF) { return FF_INV500_BE_TPLH_FS; }
    if (c == CORNER_SS) { return SS_INV500_BE_TPLH_FS; }
    if (c == CORNER_FS) { return FS_INV500_BE_TPLH_FS; }
    if (c == CORNER_SF) { return SF_INV500_BE_TPLH_FS; }
    return INV500_BE_TPLH_FS;
}

/// ngspice's 0.75 V crossing time of the falling edge (tpHL, after step 200), in fs, in corner c.
pub fn inv500_tphl_fs(c: u32) -> u32 {
    if (c == CORNER_FF) { return FF_INV500_BE_TPHL_FS; }
    if (c == CORNER_SS) { return SS_INV500_BE_TPHL_FS; }
    if (c == CORNER_FS) { return FS_INV500_BE_TPHL_FS; }
    if (c == CORNER_SF) { return SF_INV500_BE_TPHL_FS; }
    return INV500_BE_TPHL_FS;
}

/// The fold of corner c's four charge tables in the order qd_n, qg_n, qd_p, qg_p (the value its PIN_*_Q pins).
pub fn fold_q(c: u32) -> u64 {
    var s : u64 = fold_arr(qd_n(c), 625, 0);
    s = fold_arr(qg_n(c), 625, s);
    s = fold_arr(qd_p(c), 625, s);
    s = fold_arr(qg_p(c), 625, s);
    return s;
}

; --- the board's ROM view (M3d, issue #11208): the tt tables and the tt run, behind one clocked port ------------------
; specs/fpga/psp103_inv_ax7203.t27 runs the 500 fF inverter of specs/analog/mos_psp103.t27 on the AX7203 and reads these tables from block RAM. `t27c gen-verilog`
; carries a const array of its own module into Verilog as a memory with its initial contents, and carries nothing that came in by `use`: so the port is here, next
; to the arrays, and the board spec instantiates this module and imports the same arrays for its tests. `addr` selects a word of the four tt tables (node
; ix * 25 + iy), `idx` a sample of the run; each output is a register, the word of the address the port saw one clock earlier (a synchronous read).
; TT_RUN is not a number a deck printed. It is what the board's arithmetic gives: `run_fix_q` of mos_table.t27 on TT_N, TT_P, TT_QD_N, TT_QD_P with K_NEWTON = 3
; Newton iterations, from the DC rest value (3 units), the gate at Vdd before step 0, 400 steps of dt = 100 ps on 500 fF. The board spec recomputes it word for
; word; here it is pinned by the fold that spec pins as EXP_S_TT_Q.
/// The fold of TT_RUN: the S of the last line the board prints.
pub const PIN_TT_RUN : u64 = 0x215DC5EAC4C48576;

/// The 400 samples of the tt 500 fF inverter run, in units of 2^-24 V: the output after step 0 .. 399.
