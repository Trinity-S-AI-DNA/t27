// SPDX-License-Identifier: Apache-2.0
; specs/analog/mos_table.t27 -- a nonlinear analog cell: a CMOS inverter whose MOS currents are read from a table
; M3a of the analog emulation epic (#10486, issue #10515). M0 (specs/fpga/rc_filter_ax7203.t27) is the linear RC; this is
; the first cell with a device that is not a resistor. M3b (specs/analog/mos_psp103.t27, #10516) runs this same solver on
; tables made from the IHP SG13G2 PSP103 model, one NMOS and one PMOS table per corner; for that the solver takes the NMOS
; table and the PMOS table as two arguments (M3a passes the same table twice). Everything hand-written is this file.
; M3c (#10777) generalizes the step once more, with the drain-charge tables of the two devices: the `*_q` functions (gq_pos, gq_neg, gq_deriv,
; g_resid_q, newton_iter_q, inv_step_q, board_step_q, run_fix_q, and newton_iter_qf, run_tabf_q on the f64 side) take two more tables qn, qp
; and the gate of the previous step A0, and the current-only functions of M3a and M3b are those with the zero tables NOQ, so nothing is copied and
; every pinned number of this file is still a number of the charge path. A charge table is read and sloped like a current table (id_of, gds_cell),
; nondecreasing along Vds. The tests of the generalization are the last three: zero charge is the old path bit for bit; a plane of charge (no
; current) gives the closed form of the gate-edge kick and the load, for an NMOS-side and a PMOS-side charge; the mirror holds with the four tables
; swapped. mos_psp103.t27 runs it on the PSP103 tables.
; M3c-2 (#10881, part 3 of #10777) adds the weak-inversion-accurate current, THE LOG-DOMAIN READER below, as a generalization of the read and not a copy of it: `read_w` is the bilinear
; read of any uniform grid (id_of is its 24 x 24 cell case, bit for bit, a test), a log table is a slice with a tag word that `cur_of` and `cur_gds` tell from a linear one, and the
; Newton step, the charge path and M3a's pinned run are the same functions as before (`g_pos`, `g_neg` and `gq_deriv` read the current through `cur_of` / `cur_gds`).
; -
; THE LOG-DOMAIN READER, DESIGNED ON PAPER FIRST (M3c-2). The linear 25 x 25 table cannot give 1 % in weak inversion for two reasons that no finer read repairs: a word is 298 pA, so its
; rounding alone is 15 % of the 1 nA floor where 1 % allows 10 pA, and Id grows 6.5 .. 7 times per 62.5 mV cell, where a chord is 41 % above the exponential at the middle. So the table
; holds the LOG of the current and the reader takes an integer exp:
;   the table      lam = log2(Id / F) in 1/65536 of an octave (16 fraction bits: from 1 pA to 0.65 mA is under 2^21 words, the u64 blend needs under 2^23), in units of IUNIT = 2^-8 of a
;                  linear-table word = 1.164 pA. ln Id is nearly LINEAR in Vgs in weak inversion, so a chord of it is exact there. F = 1 - exp(-Vds / s(Vgs)) is the Vds factor of weak
;                  inversion, handled apart: Id is 0 at Vds = 0 (no log), and the first Vds cell is a 35 % chord error of Id on its own. The column Vds = 0 holds the limit of Id / F,
;                  s * gds0. s is a gate scale, 30 mV in weak inversion (the diffusion factor, exact) growing to 0.6 V in strong inversion (the channel is a resistor, F nearly linear): with
;                  one fixed s the first Vds cells are 5 % chords in strong inversion (Id / F = Vds / F grows 2.7 times over 2.4 s).
;   the exp        2^(lam / 2^16) = a shift by the integer part and 2^f from a 129-entry table (2^-(i/128) in Q24, linear between its entries, 3.7e-6 off). F = 1 - 2^-(x log2 e) from the
;                  same table, and below x = 1/16 the series x - x^2 / 2 + x^3 / 6: a difference of two table values has an absolute error of 62 / 2^24, a whole F at x = 1e-3.
;   the slope      d(F E) / dVds = F' E + F E ln2 d(lam) / dVds with F' = rv e^-x: read off the same words (FR-002), the cell's two differences of lam along Vds blended along Vgs, their
;                  positive and negative parts apart (a log word may fall with Vds), the sum floored at 0.
;   THE GRID. Error against grid and format, the worst relative error with a floor of 1e-9 A over every 7.8 mV lattice point that is not a node (a dense ngspice run of 193 x 193 points, a scratch
;   study that is not in the repo) and at the repo's held-out points, NMOS / PMOS:
;     the linear table, 62.5 mV x 62.5 mV, a chord on Id                            0.55 .. 0.73 (the issue's measure at the midpoints and R2 points: the baseline)
;     log(Id / F), F with a fixed 25.9 mV: 62.5 x 62.5 mV 44 %;  31.2 x 31.2 3.0 / 3.2 %;  15.6 x 15.6 mV 0.78 / 0.83 % (9409 words a device)
;     log(Id / F), F with s(Vgs):  62.5 x 62.5 mV 6.1 / 5.3 %;  31.2 x 31.2 1.5 %;  15.6 x 62.5 1.5 / 1.8 %;  15.6 x 31.2 mV 0.51 / 0.71 % (4753 + 97 words)  <- CHOSEN;  7.8 x 31.2 0.52 / 0.60 %
;   Along Vgs the curvature of ln Id near threshold sets 15.6 mV (31.2 mV gives 1.5 % at every Vds); along Vds 31.2 mV (62.5 mV gives 1.5 .. 1.8 %, the knee between triode and
;   saturation); 7.8 mV along Vgs gains 0.1 %, a finer Vds more than that only in the first cell. The tables and their format are in mos_psp103_data.t27, the deck psp103_idpa_tt.cir.
;   THE THREE ERRORS of the read, apart (mos_psp103.t27): arithmetic (the integer read against its f64 twin on the same words) at most 0.102 % with a floor of 1 nA, which is one or two
;   units of 1.164 pA at the floor's 859; table + model (against ngspice) 0.40 % / 0.53 % at the 1000 R2 points and 0.47 % / 0.71 % at 1000 centres of the grid's cells, 0.08 % /
;   0.09 % at the 576 midpoints (nodes of this grid: the rounding of the words only); discretization (the inverter's, ngspice backward Euler against converged) is not touched by the read.
; -
; THE CIRCUIT. The reference is mirekez/cpphdl, analog/examples/cmos_inverter: Vdd = 1.2 V, an NMOS from Y to ground and a
; PMOS from Y to Vdd, both gates on A, A = 0 V and then 1.2 V from 2 us, Y loaded by 10 pF, dt = 10 ns, stop at 4 us (400
; steps). cpphdl's MOS law (analog/include/solver.hpp) is the square law with beta = 1 mA/V^2 and Vth = 0.35 V:
;   ov = Vgs - Vth; below threshold I = 0; Vds < ov: I = beta (ov Vds - Vds^2 / 2); else I = beta ov^2 / 2.
; The law is symmetric in drain and source and the PMOS is the mirror (Vsg, Vsd for Vgs, Vds); here Vds is never negative,
; so the symmetry is not exercised. cpphdl's README reports Y rising toward 1.2 V, then falling to about 11.5 nV at 4 us,
; and requires |Y(4 us)| <= 1 mV.
; -
; THE DEVICE IS A TABLE. Id(Vgs, Vds) is stored on a uniform 25 x 25 grid over [0, 1.2] V x [0, 1.2] V, 0.05 V a cell, 24
; cells a side. 0.05 V divides both 1.2 V and 0.35 V, so Vdd and Vth are grid lines and the threshold kink is never
; inside a cell. Here one table serves both transistors: the NMOS reads it at (A, Y), the PMOS at (Vdd - A, Vdd - Y); the
; step functions take the NMOS table tn and the PMOS table tp as two slices, and every M3a test passes the same one twice
; (a symmetric pair, beta equal). The cell reads a table by bilinear interpolation. gm and gds are the slopes of that same
; interpolant (differences of the neighbouring entries, weighted), so the value and its derivative are one object. This
; one-node Newton uses gds only (A is an input); gm is built and tested for the cell with a second nonlinear node. The tests
; build the table from the analytic law, node by node, quantized; M3b builds two from PSP103 and changes nothing else.
; -
; THE UNITS. A voltage word counts units of 0.05 V / 2^20 = 47.68 nV, so one grid cell is exactly 2^20 units: the cell
; index of a voltage is a shift and the position inside the cell a mask, and the interpolation divides by 2^40, a shift.
; Vdd = 24 * 2^20 = 25165824 and Vth = 7 * 2^20, both exact. (M0 counts 2^-24 V = 59.6 nV; here the grid sets the unit,
; 1.25 times finer, and every division but Newton's becomes a shift.) A table entry is the current times
; dt / C, that is the voltage the node moves in one step, in the same unit. For this circuit dt / C = 10 ns / 10 pF =
; 1000 V/A = 1 V/mA, so an entry is also the current in units of 47.68 pA; a different dt or C is one constant at the
; moment the table is built. The largest entry, Id(1.2 V, 1.2 V) = 0.36125 mA, is 7575962 < 2^23.
; -
; THE STEP. Backward Euler at the one unknown node: C (y' - y0) / dt = Ip(y') - In(y'), which is
;   g(y) = y + In(A, y) - y0 - Ip(Vdd - A, Vdd - y) = 0     (volts of charge per step, all terms unsigned).
; Newton solves it with K = 3 iterations, K fixed in the spec, whatever the input: y <- y - g(y) / g'(y), with
; g'(y) = 1 + gds_n + gds_p in units of dt / C, the sum of the two cell slopes. The positive terms (y + In) and the
; negative terms (y0 + Ip) are two unsigned sums, g is their difference with a direction flag, and the update moves y
; toward the root, clamped to [0, Vdd] (the root is inside: g(0) <= 0 <= g(Vdd), and g' >= 1 because gds >= 0). The one
; division is q = round(|g| 2^20 / D) with D = 2^20 + the two cell slopes. The residual |g(y_K)| after the last
; iteration is computed at every step and bounded.
; -
; THE RUN. 400 steps from Y = 0: A = 0 V for steps 0..199 (0 .. 2 us), A = 1.2 V for steps 200..399, as M0 steps its
; source. Y(2 us) is the sample after step 199, Y(4 us) after step 399. S is an order-sensitive fold of all 400 samples.
; -
; THE THREE ERRORS, kept apart (W10):
;   arithmetic    the fixed-point run against an f64 run of the SAME iteration (same table values, same K, same clamps):
;                 largest |difference| 0.61 unit (29 nV), bound 0.7, asserted from both sides.
;   table         the f64 run of the table model against the analytic square law solved to convergence at the same dt:
;                 largest |difference| 0.428 mV, bound 0.45 mV, from both sides. Newton at K = 3 is already converged on
;                 the table (K = 3 and K = 12 agree to 1e-3 unit), so this is the table and not the iteration.
;   discretization the analytic run at dt against the analytic run at dt / 2: largest |difference| 27.2 mV (at the first
;                 rising edge, 40 ns in), bound 27.5 mV, from both sides. This is the biggest error here and it is the
;                 scheme's: backward Euler at dt = 10 ns on a node whose time constant is about 12 ns.
; THE REQUIREMENT. |Y(4 us)| is 0 units (0 V) in the fixed-point run and 8e-54 V in the analytic one; cpphdl requires
; <= 1 mV. Y(2 us) is 1.2 V in both (25165824 units; the analytic run is within 1e-6 V of it, measured 2e-16). Y
; reaches 1.2 V - 1 mV at step 12 and falls below 1 mV 12 steps after the edge.
; THE TABLE AGAINST THE LAW, at all 576 cell midpoints, the worst place for a chord: absolute error at most 3.13e-7 A
; (0.09 % of the 0.36 mA saturation current), which is beta h^2 / 8 = 3.125e-7 A for h = 0.05 V plus the table's own
; rounding (bound 3.2e-7, asserted from both sides). Relative error, with a floor of 1e-9 A on the law: at most 1.0000
; over all midpoints, and that is a limit of the method, not a defect of this table: in the first cell above Vth,
; where the law is ov^2 / 2 (Vds above the overdrive), a chord reads exactly twice the law at the midpoint, on any
; grid. From the second cell above Vth on the relative error is at most 0.2000 (bound 0.2002, from both sides). The
; slopes: gm and gds differ from the analytic derivatives at the midpoints by at most 0.0125 of dt / C (bound 0.0126).
; -
; THE NEGATIVE CONTROLS, each a test that passes by seeing the failure:
;   K = 1        the residual reaches 1199464 units (57 mV) against the bound of 2; K = 2 reaches 29760 (1.4 mV).
;   Vth = 0.30   a table built with the wrong threshold is 917504 units off the law at a node, 4.3e-5 A off at a
;                midpoint (bound 3.2e-7), 1.89 relative (bound 0.2002), and the inverter run is 46.6 mV from the law
;                (bound 0.45 mV).
; And one symmetry: the PMOS reads the table that the NMOS reads, mirrored, so the circuit run with A -> Vdd - A from
; Y = Vdd gives Vdd - Y at every step, bit for bit (a test).
; -
; THE HARDWARE. Everything from `gate_at` to `board_step`, and `fold`, takes and returns bool and unsigned words and has
; no float: it is what a board would run (`t27b verilog` refuses signed types). `fold` and `fabs64` are not written
; again: they come from M1 (`use analog::linear`, specs/analog/linear.t27), whose other names this file avoids (`step`,
; `residual`, `STEPS` became `board_step`, `g_resid`, `RUN_STEPS`). The tables are passed as slices. The f64 side (the law, the
; table builder, the f64 model of the iteration, the analytic run) is reached only by the tests. No board top and no
; clock are in this file; the cost of the division and of the table memory is for the board milestone (M3b is the tables).
; -
; WHAT A PASS SAYS. The cell reads a 25 x 25 table by exact-integer bilinear interpolation, solves backward Euler at
; the inverter's output node with a fixed three Newton iterations whose last residual is at most 1 unit (47.68 nV) at
; every one of 400 steps, ends the run at 0 V where cpphdl requires at most 1 mV, stays within 0.61 unit of the f64
; model of the same iteration, within 0.428 mV of the analytic square law solved to convergence, and differs from its
; own dt / 2 run by at most 27.2 mV; the 400 samples fold to the S pinned below. M3c-2: the same arithmetic reads any uniform grid and a table of log2(Id / F) with an integer exp
; (a table of 129 words and a shift), its slope off the same words, and is exact to a part in 1e5 of a closed-form current and slope (synthetic tables); the tests of mos_psp103.t27 hold it
; to ngspice at 1 %.
; WHAT IT DOES NOT SAY. Nothing about a transistor: the table is the square law, not PSP103 (M3b), and nothing here is a
; PDK corner; the log reader is exact on integer tables of known law and says nothing about any device by itself. No gm of a log table (it needs the slope of rv with Vgs: the
; Newton step here is scalar and uses gds only). Nothing about a board: no bitstream, no clock, no LUT, DSP or BRAM, no division cost, no UART line.
; Nothing about the continuous circuit: the 27 mV is the scheme at dt = 10 ns, and the table error adds to it. Nothing
; about a circuit with a second nonlinear node (the Newton here is scalar), a netlist (the reader is M2), a device
; with Vds < 0, or an input other than the two levels. Nothing about power or about speed against SPICE. cpphdl's
; own number (11.5 nV) was not re-run: it is quoted from its README.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogMosTable;

use analog::linear::{fold, fabs64};

pub const KIND : str = "analog-cell";
pub const ID : str = "analog/mos_table";
pub const REFERENCE : str = "mirekez/cpphdl analog/examples/cmos_inverter, analog/include/solver.hpp";

; --- the circuit --------------------------------------------------------------------------------
/// beta of both transistors, A/V^2.
pub const BETA : f64 = 0.001;
/// Threshold of both transistors, V.
pub const VTH_V : f64 = 0.35;
/// The deliberately wrong threshold of the negative control, V.
pub const VTH_WRONG_V : f64 = 0.30;
pub const VDD_V : f64 = 1.2;
pub const DT_NS : u32 = 10;
pub const C_PF : u32 = 10;
/// dt / C in V per A: 10 ns / 10 pF.
pub const STEP_V_PER_A : f64 = 1000.0;

; --- the grid and the units ---------------------------------------------------------------------
pub const CELL_BITS : u32 = 20;
/// One grid cell, 0.05 V, in voltage units: 2^20.
pub const CELL : u32 = 1048576;
pub const NCELL : u32 = 24;
pub const NODES : u32 = 25;
pub const TBL_LEN : usize = 625;
/// 24 cells = 1.2 V.
pub const VDD : u32 = 25165824;
/// 2^39: half of the interpolation's divisor 2^40, for rounding half up.
pub const HALF_Q : u64 = 549755813888;
/// Voltage units per volt: 20 cells * 2^20.
pub const UNITS_PER_V : f64 = 20971520.0;
pub const CELL_F : f64 = 1048576.0;
pub const VDD_F : f64 = 25165824.0;
/// The largest table entry, Id(1.2 V, 1.2 V) in table units.
pub const TBL_MAX : u32 = 7575962;

; --- the run ------------------------------------------------------------------------------------
pub const RUN_STEPS : u32 = 400;
/// The first step with A = Vdd: 2 us.
pub const EDGE_STEP : u32 = 200;
/// Newton iterations per step, fixed.
pub const K_NEWTON : u32 = 3;
/// The most the last residual may be, in units (95 nV).
pub const RES_BOUND : u32 = 2;
/// Iterations of the analytic reference's Newton (it needs fewer than 10).
pub const ANA_ITERS : u32 = 20;

; --- what the run must give, derived by the tests below -----------------------------------------------
pub const EXP_Y0 : u32 = 7570207;
pub const EXP_Y3 : u32 = 21437831;
pub const EXP_Y200 : u32 = 17595617;
pub const EXP_S : u64 = 0x703F6836B1F5B275;

; --- the hardware side: unsigned words only -----------------------------------------------------------

/// The gate voltage at step n: 0 V before 2 us, Vdd from then on.
pub fn gate_at(n: u32) -> u32 {
    if (n < EDGE_STEP) { return 0; }
    return VDD;
}

/// A voltage held to the table's range.
pub fn lim(v: u32) -> u32 {
    if (v > VDD) { return VDD; }
    return v;
}

/// The grid cell of a voltage; the top node belongs to the last cell.
pub fn cell_of(v: u32) -> u32 {
    const c : u32 = v >> CELL_BITS;
    if (c >= NCELL) { return NCELL - 1; }
    return c;
}

/// The table entry at node (cx, cy), cx along Vgs and cy along Vds, as a wide word.
pub fn node_at(t: []const u32, cx: u32, cy: u32) -> u64 {
    return (t[(cx * NODES + cy) as usize]) as u64;
}

/// a - b, or 0 when b is larger; a table of a law that does not decrease never needs the 0.
pub fn dpos(a: u64, b: u64) -> u64 {
    if (a >= b) { return a - b; }
    return 0;
}

/// The bilinear blend of four nodes: t00 at (0, 0), t10 at (1, 0), t01 at (0, 1), t11 at (1, 1), with fx, fy in [0, CELL]
/// the position inside the cell. In table units, rounded half up. The four weights add up to 2^40 exactly, so the sum
/// is at most TBL_MAX * 2^40 < 2^64. Scalars only: this is the arithmetic of one table read, apart from the memory.
pub fn blend(t00: u64, t10: u64, t01: u64, t11: u64, fx: u32, fy: u32) -> u32 {
    const wx1 : u64 = fx as u64;
    const wx0 : u64 = (CELL - fx) as u64;
    const lo : u64 = t00 * wx0 + t10 * wx1;
    const hi : u64 = t01 * wx0 + t11 * wx1;
    return ((lo * ((CELL - fy) as u64) + hi * (fy as u64) + HALF_Q) >> 40) as u32;
}

/// The linear blend of two cell differences d0 (at 0) and d1 (at 1) with the position f in [0, CELL], rounded half up.
pub fn blend1(d0: u64, d1: u64, f: u32) -> u32 {
    return ((d0 * ((CELL - f) as u64) + d1 * (f as u64) + ((CELL >> 1) as u64)) >> CELL_BITS) as u32;
}

/// The position of voltage v inside its cell, 0..CELL (CELL only at the top node).
pub fn frac_of(v: u32) -> u32 {
    return v - (cell_of(v) << CELL_BITS);
}

/// Id(vg, vd) by bilinear interpolation, in table units.
pub fn id_of(t: []const u32, vg: u32, vd: u32) -> u32 {
    const gv : u32 = lim(vg);
    const dv : u32 = lim(vd);
    const cx : u32 = cell_of(gv);
    const cy : u32 = cell_of(dv);
    return blend(node_at(t, cx, cy), node_at(t, cx + 1, cy), node_at(t, cx, cy + 1), node_at(t, cx + 1, cy + 1), frac_of(gv), frac_of(dv));
}

/// gds: how much Id moves across one cell of Vds, at (vg, vd), in table units per cell. Divided by CELL it is the slope
/// of the interpolant, d(Id dt/C) / dVds, a pure number.
pub fn gds_cell(t: []const u32, vg: u32, vd: u32) -> u32 {
    const gv : u32 = lim(vg);
    const dv : u32 = lim(vd);
    const cx : u32 = cell_of(gv);
    const cy : u32 = cell_of(dv);
    const d0 : u64 = dpos(node_at(t, cx, cy + 1), node_at(t, cx, cy));
    const d1 : u64 = dpos(node_at(t, cx + 1, cy + 1), node_at(t, cx + 1, cy));
    return blend1(d0, d1, frac_of(gv));
}

/// gm: how much Id moves across one cell of Vgs, at (vg, vd), in table units per cell.
pub fn gm_cell(t: []const u32, vg: u32, vd: u32) -> u32 {
    const gv : u32 = lim(vg);
    const dv : u32 = lim(vd);
    const cx : u32 = cell_of(gv);
    const cy : u32 = cell_of(dv);
    const d0 : u64 = dpos(node_at(t, cx + 1, cy), node_at(t, cx, cy));
    const d1 : u64 = dpos(node_at(t, cx + 1, cy + 1), node_at(t, cx, cy + 1));
    return blend1(d0, d1, frac_of(dv));
}

; --- the log-domain reader (M3c-2, #10881): the same table machinery on a grid of any cell size, and a current read in the log domain ----------
; The tables read above are 25 x 25 words of 2^20 units. The generalization is the read of ANY uniform grid (`cell_w`, `blend_w`, `read_w`: cell sizes 2^bits, node counts as
; arguments, the weights 2^bits, the rounding half of the shift), of which `id_of` is the 24 x 24 cell case (a test: every read agrees), and on top of it a current whose table
; holds log2(Id / F) instead of Id, with the Vds factor F and the exp of a small table and a shift. THE FORMAT is in the header and in mos_psp103_data.t27; here is the
; arithmetic, all unsigned words:
;   lam = the bilinear blend of the table's log words (16 fraction bits of an octave, under 2^21)  -- the same `blend` with 2^18 and 2^19 weights
;   rv  = the linear blend along Vgs of the two rv words of the cell: x = Vds * rv / 2^36 (Q24: x24 = (vd * rv + 2^11) >> 12)
;   F   = 1 - exp(-x) in Q24: below x = 1/16 the series x - x^2/2 + x^3/6, above it 1 - 2^-(x log2 e) from the table EXP2NEG (2^-(i/128) in Q24, linear in between, a shift for the
;         integer part)
;   E   = 2^(lam / 2^16) as an integer: 2^f from the same table (2 * 2^-(1 - f)), a shift for the integer part;  Id = E * F in IUNIT = 2^-8 of a linear-table word
; The word an inverter step wants is the rounded Id / 2^8. The slope is read off the same words (FR-002): d(F E)/dVds = F' E + F E ln2 d(lam)/dVds, with F' = rv e^-x and d(lam) the
; blend along Vgs of the cell's two differences along Vds, its positive and negative parts apart (a log word may fall with Vds), in the units of `gds_cell` (words per 2^20 units).

pub const LG_TAG : u32 = 4294967295;
/// The log tables' grid: 2^18 units (15.625 mV) along Vgs, 2^19 (31.25 mV) along Vds, 96 and 48 cells, 97 x 49 nodes.
pub const LG_GBITS : u32 = 18;
pub const LG_DBITS : u32 = 19;
pub const LG_NG : u32 = 96;
pub const LG_ND : u32 = 48;
/// Nodes along Vds, the log words in a table (97 * 49), the offset of the rv words (tag word, then the log words) and the table's length.
pub const LG_NODES_D : u32 = 49;
pub const LG_LAM_LEN : usize = 4753;
pub const LG_R_OFF : usize = 4754;
pub const LG_LEN : usize = 4851;
/// log2(e) and ln(2) in Q16.
pub const LOG2E_Q16 : u64 = 94548;
pub const LN2_Q16 : u64 = 45426;
/// 2^-(i/128) in Q24, i = 0 .. 128: 16777216 down to 8388608.
pub const EXP2NEG : [129]u32 = [
    16777216, 16686609, 16596492, 16506861, 16417715, 16329050, 16240863, 16153153, 16065917, 15979152,
    15892855, 15807025, 15721658, 15636752, 15552304, 15468313, 15384775, 15301688, 15219050, 15136859,
    15055111, 14973805, 14892937, 14812507, 14732511, 14652947, 14573813, 14495106, 14416824, 14338964,
    14261526, 14184505, 14107901, 14031710, 13955931, 13880561, 13805598, 13731039, 13656884, 13583129,
    13509772, 13436812, 13364245, 13292070, 13220286, 13148888, 13077877, 13007249, 12937002, 12867135,
    12797645, 12728530, 12659789, 12591419, 12523418, 12455784, 12388516, 12321610, 12255067, 12188882,
    12123055, 12057584, 11992466, 11927700, 11863283, 11799215, 11735492, 11672114, 11609078, 11546382,
    11484025, 11422004, 11360319, 11298967, 11237946, 11177254, 11116891, 11056853, 10997140, 10937749,
    10878679, 10819928, 10761494, 10703375, 10645571, 10588079, 10530897, 10474024, 10417458, 10361198,
    10305242, 10249587, 10194234, 10139179, 10084422, 10029960, 9975792, 9921917, 9868333, 9815039,
    9762032, 9709311, 9656875, 9604722, 9552851, 9501261, 9449948, 9398913, 9348154, 9297668,
    9247455, 9197514, 9147842, 9098438, 9049301, 9000430, 8951823, 8903477, 8855394, 8807569,
    8760003, 8712694, 8665641, 8618841, 8572295, 8525999, 8479954, 8434157, 8388608
];

/// The grid cell of a voltage on an axis of ncell cells of 2^bits units; the top node belongs to the last cell. `cell_of` is bits = 20, ncell = 24.
pub fn cell_w(v: u32, bits: u32, ncell: u32) -> u32 {
    const c : u32 = v >> bits;
    if (c >= ncell) { return ncell - 1; }
    return c;
}

/// The bilinear blend of four nodes with weights 2^bx along the first axis and 2^by along the second, rounded half up: `blend` is bx = by = 20. fx, fy in [0, 2^bx], [0, 2^by].
pub fn blend_w(t00: u64, t10: u64, t01: u64, t11: u64, fx: u32, fy: u32, bx: u32, by: u32) -> u32 {
    const wxu : u32 = 1 << bx;
    const wyu : u32 = 1 << by;
    const lo : u64 = t00 * ((wxu - fx) as u64) + t10 * (fx as u64);
    const hi : u64 = t01 * ((wxu - fx) as u64) + t11 * (fx as u64);
    return ((lo * ((wyu - fy) as u64) + hi * (fy as u64) + (((wxu as u64) * (wyu as u64)) >> 1)) >> (bx + by)) as u32;
}

/// The linear blend of two cell differences d0 (at 0) and d1 (at 1) with the position f in [0, 2^bits], rounded half up: `blend1` is bits = 20.
pub fn blend1_w(d0: u64, d1: u64, f: u32, bits: u32) -> u64 {
    const wu : u32 = 1 << bits;
    const half : u32 = wu >> 1;
    return (d0 * ((wu - f) as u64) + d1 * (f as u64) + (half as u64)) >> bits;
}

/// The bilinear read of a table of (ncg + 1) x (ncd + 1) nodes stored from index off, index off + ix * (ncd + 1) + iy, cells of 2^gb units along the first axis and 2^db along the
/// second. `id_of` is off = 0, gb = db = 20, ncg = ncd = 24 on a 625-word table.
pub fn read_w(t: []const u32, off: usize, vg: u32, vd: u32, gb: u32, db: u32, ncg: u32, ncd: u32) -> u32 {
    const gv : u32 = lim(vg);
    const dv : u32 = lim(vd);
    const cx : u32 = cell_w(gv, gb, ncg);
    const cy : u32 = cell_w(dv, db, ncd);
    const nd1 : usize = (ncd + 1) as usize;
    const i00 : usize = off + ((cx as usize) * nd1) + (cy as usize);
    return blend_w((t[i00]) as u64, (t[i00 + nd1]) as u64, (t[i00 + 1]) as u64, (t[i00 + nd1 + 1]) as u64, gv - (cx << gb), dv - (cy << db), gb, db);
}

/// 2^-g for g in [0, 1] given in Q24, in Q24, from EXP2NEG, linear between its entries (rounded half up). The chord of 2^-x over 1/128 is at most 3.7e-6 off.
pub fn exp2neg(g: u64) -> u64 {
    const i : u64 = g >> 17;
    if (i >= 128) { return (EXP2NEG[128]) as u64; }
    const j : u64 = g & 131071;
    const a : u64 = (EXP2NEG[i as usize]) as u64;
    const b : u64 = (EXP2NEG[(i + 1) as usize]) as u64;
    return a - (((a - b) * j + 65536) >> 17);
}

/// F = 1 - exp(-x) for x in Q24, in Q24: the series x - x^2 / 2 + x^3 / 6 below 1/16 (the term after it is under 2.6e-5 of F there, and a difference of two table values
/// would not hold F to a part in a thousand at x = 1e-3), 1 - 2^-(x log2 e) above, exactly 1 once the integer part of x log2 e reaches 25 (e^-x under 2^-25).
pub fn vds_factor(x24: u64) -> u64 {
    if (x24 < 1048576) { return vds_series(x24); }
    return 16777216 - exp_neg_tab(x24);
}

/// e^-x for x in Q24, in Q24: 1 - F below 1/16, the table value itself above (not 1 - F, whose error of 62 units would be most of e^-x for x above 8): the slope of F, F' = rv e^-x.
pub fn exp_neg_q24(x24: u64) -> u64 {
    if (x24 < 1048576) { return 16777216 - vds_series(x24); }
    return exp_neg_tab(x24);
}

/// The series of F: x - x^2 / 2 + x^3 / 6 in Q24 (x below 1/16).
pub fn vds_series(x24: u64) -> u64 {
    const x2 : u64 = (x24 * x24 + 8388608) >> 24;
    const x3 : u64 = (x2 * x24 + 8388608) >> 24;
    return x24 - (x2 >> 1) + x3 / 6;
}

/// e^-x from the table: 2^-(x log2 e), the fraction of the exponent from EXP2NEG, the integer part a shift; 0 once the integer part reaches 25.
pub fn exp_neg_tab(x24: u64) -> u64 {
    const y24 : u64 = (x24 * LOG2E_Q16 + 32768) >> 16;
    const k : u64 = y24 >> 24;
    if (k >= 25) { return 0; }
    return exp2neg(y24 & 16777215) >> k;
}

/// 2^(lam / 2^16) as an integer: 2^f = 2 * 2^-(1 - f) from the table, shifted by the integer part of lam / 2^16, rounded half up. lam is under 2^21.
pub fn exp2_lam(lam: u32) -> u64 {
    const k : u32 = lam >> 16;
    const f : u32 = lam & 65535;
    const m : u64 = 2 * exp2neg(((65536 - f) as u64) << 8);
    return ((m << k) + 8388608) >> 24;
}

/// rv at Vgs: the blend along Vgs of the two rv words of the cell, rounded half up. t is a log table (the tag word, the log words, the rv words).
pub fn lg_rv(t: []const u32, vg: u32) -> u64 {
    const gv : u32 = lim(vg);
    const cx : u32 = cell_w(gv, LG_GBITS, LG_NG);
    const r0 : u64 = (t[LG_R_OFF + (cx as usize)]) as u64;
    const r1 : u64 = (t[LG_R_OFF + (cx as usize) + 1]) as u64;
    return blend1_w(r0, r1, gv - (cx << LG_GBITS), LG_GBITS);
}

/// The log word of the table at (vg, vd): the blend of the four nodes, 16 fraction bits of an octave.
pub fn lg_lam(t: []const u32, vg: u32, vd: u32) -> u32 {
    return read_w(t, 1, vg, vd, LG_GBITS, LG_DBITS, LG_NG, LG_ND);
}

/// The current in IUNIT from a log word lam and an rv word at the drain voltage dv (units of 2^-24 V): F * 2^(lam / 2^16), both rounded. The common tail of `lg_fine` (lam read from
/// one table) and `lg_fine_vsb` (lam blended from two slices along the source-to-bulk axis), so the two cannot drift apart.
pub fn lg_cur(lam: u32, rv: u64, dv: u32) -> u64 {
    const x24 : u64 = (((dv as u64) * rv) + 2048) >> 12;
    return (exp2_lam(lam) * vds_factor(x24) + 8388608) >> 24;
}

/// Id(vg, vd) of a log table in IUNIT = 2^-8 of a linear-table word (1.164 pA): F * 2^(lam / 2^16), both rounded. The largest, 402 uA, is 3.5e8 under 2^29.
pub fn lg_fine(t: []const u32, vg: u32, vd: u32) -> u64 {
    const gv : u32 = lim(vg);
    const dv : u32 = lim(vd);
    return lg_cur(lg_lam(t, gv, dv), lg_rv(t, gv), dv);
}

; --- the source-to-bulk axis (M3e, #11283): the log table read as a function of three voltages -------------------------------------------------------------------------------------
; The 2-D tables have each bulk tied to its source, so they hold no body effect; a device whose bulk sits on a rail while its source moves (the transmission gate's two devices) is
; read at a source-to-bulk voltage Vsb > 0. The third axis is a stack of LG_NV + 1 = 7 log tables (the slices) at Vsb = k * 2^22 units = k * 0.25 V, k = 0 .. 6, each a legal log
; table of its own (tag word, 4753 log words, 97 rv words), the slice 0 being the 2-D table itself. The read of a point is the read of the two slices around its Vsb with the LOG
; WORD blended linearly between them (`blend1_w`, weights 2^22): the weak-inversion current is exponential in the threshold, and the threshold moves with Vsb nearly linearly over a
; slice, so the blend of the log word is the right one (a blend of the currents would be a chord of an exponential). At Vsb = 0 the weight of the second slice is 0 and the read is the
; 2-D read bit for bit (`blend1_w` with f = 0 returns d0: the rounding half is below the weight 2^22), a test. rv is a function of Vgs only, the same in every slice, and is read from
; the first slice of the pair. The slices of a device are the arguments, not a global, so that the tables of another corner or temperature can use the same read.
/// The Vsb axis: 2^22 units (0.25 V) per cell, 6 cells, 7 slices.
pub const LG_VBITS : u32 = 22;
pub const LG_NV : u32 = 6;

/// The cell of a source-to-bulk voltage on the axis (0 .. 5): the top slice's voltage belongs to the last cell; a voltage above the supply is the supply.
pub fn lg_vsb_cell(vsb: u32) -> u32 {
    return cell_w(lim(vsb), LG_VBITS, LG_NV);
}

/// The position of a source-to-bulk voltage in its cell, 0 .. 2^22 (2^22 only at the top of the axis).
pub fn lg_vsb_frac(vsb: u32) -> u32 {
    const v : u32 = lim(vsb);
    return v - (cell_w(v, LG_VBITS, LG_NV) << LG_VBITS);
}

/// Id(vg, vd) at a source-to-bulk voltage a fraction fz (0 .. 2^22) of the way from the slice ta to the slice tb: the log word of the two slices blended with weights 2^22, then the
/// same tail as `lg_fine`. fz = 0 is `lg_fine(ta, vg, vd)` exactly, fz = 2^22 is `lg_fine(tb, vg, vd)` exactly.
pub fn lg_fine_vsb(ta: []const u32, tb: []const u32, vg: u32, vd: u32, fz: u32) -> u64 {
    const gv : u32 = lim(vg);
    const dv : u32 = lim(vd);
    const la : u64 = (lg_lam(ta, gv, dv)) as u64;
    const lb : u64 = (lg_lam(tb, gv, dv)) as u64;
    return lg_cur(blend1_w(la, lb, fz, LG_VBITS) as u32, lg_rv(ta, gv), dv);
}

/// Id(vg, vd) of a log table in table units (words of 298 pA), rounded half up: what the Newton step adds.
pub fn id_log(t: []const u32, vg: u32, vd: u32) -> u32 {
    return ((lg_fine(t, vg, vd) + 128) >> 8) as u32;
}

/// gds of a log table at (vg, vd): how much Id moves across 2^20 units of Vds, in words, the slope of the same read: F' E + F E ln2 d(lam)/dVds (see above), floored at 0.
pub fn gds_log(t: []const u32, vg: u32, vd: u32) -> u32 {
    const gv : u32 = lim(vg);
    const dv : u32 = lim(vd);
    const cx : u32 = cell_w(gv, LG_GBITS, LG_NG);
    const cy : u32 = cell_w(dv, LG_DBITS, LG_ND);
    const r : u64 = lg_rv(t, gv);
    const f : u64 = vds_factor((((dv as u64) * r) + 2048) >> 12);
    const e : u64 = exp2_lam(lg_lam(t, gv, dv));
    const idf : u64 = (e * f + 8388608) >> 24;
    const term1 : u64 = (((r * exp_neg_q24((((dv as u64) * r) + 2048) >> 12)) >> 24) * e) >> 24;
    const nd1 : usize = (LG_NODES_D) as usize;
    const i00 : usize = 1 + ((cx as usize) * nd1) + (cy as usize);
    const a00 : u64 = (t[i00]) as u64;
    const a01 : u64 = (t[i00 + 1]) as u64;
    const a10 : u64 = (t[i00 + nd1]) as u64;
    const a11 : u64 = (t[i00 + nd1 + 1]) as u64;
    const fx : u32 = gv - (cx << LG_GBITS);
    const up : u64 = blend1_w(dpos(a01, a00), dpos(a11, a10), fx, LG_GBITS);
    const dn : u64 = blend1_w(dpos(a00, a01), dpos(a10, a11), fx, LG_GBITS);
    const t2p : u64 = (((idf * up) >> 16) * LN2_Q16) >> 23;
    const t2n : u64 = (((idf * dn) >> 16) * LN2_Q16) >> 23;
    return dpos(term1 + t2p, t2n) as u32;
}

/// The current of a device table at (vg, vd) in words: a log table (its first word is the tag) is read by `id_log`, any other table by `id_of`. Table words of the
/// linear tables are under 2^23, never the tag, so the old tables are read exactly as before.
pub fn cur_of(t: []const u32, vg: u32, vd: u32) -> u32 {
    if (t[0] == LG_TAG) { return id_log(t, vg, vd); }
    return id_of(t, vg, vd);
}

/// gds of a device table at (vg, vd) in words per 2^20 units: `gds_log` for a log table, `gds_cell` for any other.
pub fn cur_gds(t: []const u32, vg: u32, vd: u32) -> u32 {
    if (t[0] == LG_TAG) { return gds_log(t, vg, vd); }
    return gds_cell(t, vg, vd);
}

/// The positive terms of g at y: y + In(A, y).
pub fn g_pos(t: []const u32, y: u32, a: u32) -> u32 {
    return y + cur_of(t, a, y);
}

/// The negative terms of g at y: y0 + Ip(Vdd - A, Vdd - y). The PMOS reads the same table, mirrored.
pub fn g_neg(t: []const u32, y: u32, y0: u32, a: u32) -> u32 {
    return y0 + cur_of(t, VDD - a, VDD - y);
}

/// |p - n|.
pub fn mag_diff(p: u32, n: u32) -> u32 {
    if (p >= n) { return p - n; }
    return n - p;
}

/// A charge table of zeros: a device that stores no charge. Passed for qn and qp it turns the charge-aware functions below
/// (`*_q`) into the current-only ones of M3a and M3b, with every sum equal to what it was (a zero entry adds 0, a zero slope adds 0).
pub const NOQ : [625]u32 = [0] ** 625;

/// The positive terms of the charge-aware g at y: y + In(A, y) + qn(A, y) + qp(Vdd - A0, Vdd - y0). qn is the NMOS drain-charge
/// table and qp the PMOS drain-charge table, both in the units of the current tables (the charge over C, in units of 2^-24 V) and
/// both nondecreasing along the Vds axis (qp is stored negated, so that it grows with Vsd as qn grows with Vds). A0 is the gate of
/// the previous step. The node's charge is C y + Qn - Qp, and the backward Euler equation is
/// g(y) = (y - y0) + (qn(A, y) - qn(A0, y0)) - (qp(Vdd - A, Vdd - y) - qp(Vdd - A0, Vdd - y0)) + In - Ip = 0.
pub fn gq_pos(tn: []const u32, qn: []const u32, qp: []const u32, y: u32, y0: u32, a: u32, a0: u32) -> u32 {
    return g_pos(tn, y, a) + id_of(qn, a, y) + id_of(qp, VDD - a0, VDD - y0);
}

/// The negative terms of the charge-aware g at y: y0 + Ip(Vdd - A, Vdd - y) + qn(A0, y0) + qp(Vdd - A, Vdd - y).
pub fn gq_neg(tp: []const u32, qn: []const u32, qp: []const u32, y: u32, y0: u32, a: u32, a0: u32) -> u32 {
    return g_neg(tp, y, y0, a) + id_of(qn, a0, y0) + id_of(qp, VDD - a, VDD - y);
}

/// g'(y) in units of 2^20: one cell for the node's own C, plus the Vds slopes of the four tables, each read off its own table
/// (the value and its derivative are one object, FR-002).
pub fn gq_deriv(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, y: u32, a: u32) -> u64 {
    return (CELL as u64) + (cur_gds(tn, a, y) as u64) + (cur_gds(tp, VDD - a, VDD - y) as u64) + (gds_cell(qn, a, y) as u64) + (gds_cell(qp, VDD - a, VDD - y) as u64);
}

/// |g(y)| of the charge-aware equation, in units.
pub fn g_resid_q(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, y: u32, y0: u32, a: u32, a0: u32) -> u32 {
    return mag_diff(gq_pos(tn, qn, qp, y, y0, a, a0), gq_neg(tp, qn, qp, y, y0, a, a0));
}

/// |g(y)|, the residual of the backward Euler equation at y, in units. tn is the NMOS table, tp the PMOS table. No charge.
pub fn g_resid(tn: []const u32, tp: []const u32, y: u32, y0: u32, a: u32) -> u32 {
    return g_resid_q(tn, tp, &NOQ, &NOQ, y, y0, a, a);
}

/// round(g * 2^20 / d): the Newton move for a residual of magnitude g and a derivative of d / 2^20. d >= 2^20.
pub fn newton_move(g: u32, d: u64) -> u32 {
    return ((((g as u64) << CELL_BITS) + (d >> 1)) / d) as u32;
}

/// One Newton iteration of backward Euler at the output node: from y toward the root of g, clamped to [0, Vdd]. The NMOS
/// reads tn at (A, Y) and the PMOS reads tp at (Vdd - A, Vdd - Y); the drain charges read qn at (A, Y) and qp at (Vdd - A, Vdd - Y),
/// and the previous step's at (A0, y0) and (Vdd - A0, Vdd - y0). M3a passes one table twice, M3b (mos_psp103.t27) two, M3c adds
/// the charge tables.
pub fn newton_iter_q(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, y: u32, y0: u32, a: u32, a0: u32) -> u32 {
    const p : u32 = gq_pos(tn, qn, qp, y, y0, a, a0);
    const n : u32 = gq_neg(tp, qn, qp, y, y0, a, a0);
    const d : u64 = gq_deriv(tn, tp, qn, qp, y, a);
    if (p >= n) {
        const down : u32 = newton_move(p - n, d);
        if (down >= y) { return 0; }
        return y - down;
    }
    const up : u32 = newton_move(n - p, d);
    if (up >= VDD - y) { return VDD; }
    return y + up;
}

/// One Newton iteration without charge: `newton_iter_q` with the zero charge tables.
pub fn newton_iter(tn: []const u32, tp: []const u32, y: u32, y0: u32, a: u32) -> u32 {
    return newton_iter_q(tn, tp, &NOQ, &NOQ, y, y0, a, a);
}

/// One backward Euler step from y0 with the gate at a, coming from the gate a0: k Newton iterations.
pub fn inv_step_q(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, y0: u32, a: u32, a0: u32, k: u32) -> u32 {
    var y : u32 = y0;
    var i : u32 = 0;
    while (i < k) {
        y = newton_iter_q(tn, tp, qn, qp, y, y0, a, a0);
        i = i + 1;
    }
    return y;
}

/// One backward Euler step without charge: `inv_step_q` with the zero charge tables.
pub fn inv_step(tn: []const u32, tp: []const u32, y0: u32, a: u32, k: u32) -> u32 {
    return inv_step_q(tn, tp, &NOQ, &NOQ, y0, a, a, k);
}

/// The step the board runs, with charge: K_NEWTON iterations. The trip count is a constant, so the loop unrolls (`t27b verilog`
/// takes a `while` only with a static bound); inv_step_q above takes k as an argument so the tests can run K = 1 and K = 2.
pub fn board_step_q(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, y0: u32, a: u32, a0: u32) -> u32 {
    var y : u32 = y0;
    var i : u32 = 0;
    while (i < K_NEWTON) {
        y = newton_iter_q(tn, tp, qn, qp, y, y0, a, a0);
        i = i + 1;
    }
    return y;
}

/// The step the board runs without charge: `board_step_q` with the zero charge tables.
pub fn board_step(tn: []const u32, tp: []const u32, y0: u32, a: u32) -> u32 {
    return board_step_q(tn, tp, &NOQ, &NOQ, y0, a, a);
}

; --- the f64 side: references that only the tests reach -------------------------------------------------
; A module-level f64 fn is carried to Verilog only when the hardware reaches it; nothing below is reached by `step`.

/// The larger of two reals.
pub fn fmax64(a: f64, b: f64) -> f64 {
    if (a > b) { return a; }
    return b;
}

/// cpphdl's MOS law: the drain current in A for Vgs, Vds in V, with threshold vth.
pub fn law_amps(vgs: f64, vds: f64, vth: f64) -> f64 {
    const ov : f64 = vgs - vth;
    if (ov <= 0.0 or vds <= 0.0) { return 0.0; }
    if (vds < ov) { return BETA * (ov * vds - vds * vds / 2.0); }
    return BETA * ov * ov / 2.0;
}

/// dId/dVds of the law, A/V.
pub fn law_gds(vgs: f64, vds: f64, vth: f64) -> f64 {
    const ov : f64 = vgs - vth;
    if (ov <= 0.0 or vds <= 0.0) { return 0.0; }
    if (vds < ov) { return BETA * (ov - vds); }
    return 0.0;
}

/// dId/dVgs of the law, A/V.
pub fn law_gm(vgs: f64, vds: f64, vth: f64) -> f64 {
    const ov : f64 = vgs - vth;
    if (ov <= 0.0 or vds <= 0.0) { return 0.0; }
    if (vds < ov) { return BETA * vds; }
    return BETA * ov;
}

/// Fill the table from the law with threshold vth: entry (ix, iy) = round(Id(ix * 0.05 V, iy * 0.05 V) * dt/C), in units.
pub fn build_table(t: []u32, vth: f64) {
    var ix : u32 = 0;
    while (ix < NODES) {
        var iy : u32 = 0;
        while (iy < NODES) {
            const i : f64 = law_amps((ix as f64) / 20.0, (iy as f64) / 20.0, vth);
            t[(ix * NODES + iy) as usize] = (i * STEP_V_PER_A * UNITS_PER_V + 0.5) as u32;
            iy = iy + 1;
        }
        ix = ix + 1;
    }
}

/// The largest |entry - law| over the 625 nodes, in table units, against the law with the true threshold.
pub fn node_err(t: []const u32) -> f64 {
    var worst : f64 = 0.0;
    var ix : u32 = 0;
    while (ix < NODES) {
        var iy : u32 = 0;
        while (iy < NODES) {
            const want : f64 = law_amps((ix as f64) / 20.0, (iy as f64) / 20.0, VTH_V) * STEP_V_PER_A * UNITS_PER_V;
            worst = fmax64(worst, fabs64((t[(ix * NODES + iy) as usize] as f64) - want));
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    return worst;
}

pub struct MidStats { abs_a: f64, rel_all: f64, rel_hi: f64, gds_dev: f64, gm_dev: f64 }

/// The table against the law at the 576 cell midpoints: the largest absolute error in A; the largest relative error with
/// a floor of 1e-9 A on the law, over all midpoints and over the cells from the second above Vth on (cx >= 8); the
/// largest deviation of gds and gm from the law's derivatives, in units of dt/C.
pub fn mid_stats(t: []const u32) -> MidStats {
    var abs_a : f64 = 0.0;
    var rel_all : f64 = 0.0;
    var rel_hi : f64 = 0.0;
    var gds_dev : f64 = 0.0;
    var gm_dev : f64 = 0.0;
    var cx : u32 = 0;
    while (cx < NCELL) {
        var cy : u32 = 0;
        while (cy < NCELL) {
            const vg : u32 = cx * CELL + (CELL >> 1);
            const vd : u32 = cy * CELL + (CELL >> 1);
            const gf : f64 = (vg as f64) / UNITS_PER_V;
            const df : f64 = (vd as f64) / UNITS_PER_V;
            const law : f64 = law_amps(gf, df, VTH_V);
            const tab : f64 = (id_of(t, vg, vd) as f64) / (STEP_V_PER_A * UNITS_PER_V);
            const e : f64 = fabs64(tab - law);
            const r : f64 = e / fmax64(law, 0.000000001);
            abs_a = fmax64(abs_a, e);
            rel_all = fmax64(rel_all, r);
            if (cx >= 8) { rel_hi = fmax64(rel_hi, r); }
            gds_dev = fmax64(gds_dev, fabs64(((gds_cell(t, vg, vd) as f64) / CELL_F) - law_gds(gf, df, VTH_V) * STEP_V_PER_A));
            gm_dev = fmax64(gm_dev, fabs64(((gm_cell(t, vg, vd) as f64) / CELL_F) - law_gm(gf, df, VTH_V) * STEP_V_PER_A));
            cy = cy + 1;
        }
        cx = cx + 1;
    }
    return MidStats { abs_a: abs_a, rel_all: rel_all, rel_hi: rel_hi, gds_dev: gds_dev, gm_dev: gm_dev };
}

/// Is the table nondecreasing along both axes (a law with gm >= 0 and gds >= 0 gives one)?
pub fn monotone(t: []const u32) -> bool {
    var ok : bool = true;
    var ix : u32 = 0;
    while (ix < NODES - 1) {
        var iy : u32 = 0;
        while (iy < NODES - 1) {
            const here : u32 = t[(ix * NODES + iy) as usize];
            if (t[((ix + 1) * NODES + iy) as usize] < here) { ok = false; }
            if (t[(ix * NODES + iy + 1) as usize] < here) { ok = false; }
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    return ok;
}

/// Is the table nondecreasing along one axis over all 600 neighbouring pairs of that axis: ax 0 along the first index (Vgs), ax 1
/// along the second (Vds)? A drain charge table is nondecreasing along Vds (a capacitance is positive), a gate charge table along Vgs.
pub fn monotone_along(t: []const u32, ax: u32) -> bool {
    var ok : bool = true;
    var ix : u32 = 0;
    while (ix < NODES) {
        var iy : u32 = 0;
        while (iy < NODES) {
            const here : u32 = t[(ix * NODES + iy) as usize];
            if (ax == 0 and ix + 1 < NODES) {
                if (t[((ix + 1) * NODES + iy) as usize] < here) { ok = false; }
            }
            if (ax == 1 and iy + 1 < NODES) {
                if (t[(ix * NODES + iy + 1) as usize] < here) { ok = false; }
            }
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    return ok;
}

/// The gate of step n, mirrored (Vdd - A) when mirror is set.
pub fn gate_in(n: u32, mirror: bool) -> u32 {
    if (mirror) { return VDD - gate_at(n); }
    return gate_at(n);
}

/// The fixed-point run: 400 steps of `inv_step_q` with k iterations from Y = y_init, the gate mirrored (Vdd - A) when
/// mirror is set, the gate before step 0 at a_rest. out gets every Y, res the last residual of every step. Returns the fold of
/// the 400 samples.
pub fn run_fix_q(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, k: u32, y_init: u32, a_rest: u32, mirror: bool, out: []u32, res: []u32) -> u64 {
    var y : u32 = y_init;
    var s : u64 = 0;
    var n : u32 = 0;
    while (n < RUN_STEPS) {
        const a : u32 = gate_in(n, mirror);
        var a0 : u32 = a_rest;
        if (n > 0) { a0 = gate_in(n - 1, mirror); }
        const y0 : u32 = y;
        y = inv_step_q(tn, tp, qn, qp, y0, a, a0, k);
        res[n as usize] = g_resid_q(tn, tp, qn, qp, y, y0, a, a0);
        out[n as usize] = y;
        s = fold(s, y);
        n = n + 1;
    }
    return s;
}

/// The fixed-point run without charge: `run_fix_q` with the zero charge tables (the gate before step 0 does not matter then).
pub fn run_fix(tn: []const u32, tp: []const u32, k: u32, y_init: u32, mirror: bool, out: []u32, res: []u32) -> u64 {
    return run_fix_q(tn, tp, &NOQ, &NOQ, k, y_init, gate_in(0, mirror), mirror, out, res);
}

/// The largest residual of a run, in units.
pub fn max_of(r: []const u32) -> u32 {
    var m : u32 = 0;
    var n : u32 = 0;
    while (n < RUN_STEPS) {
        if (r[n as usize] > m) { m = r[n as usize]; }
        n = n + 1;
    }
    return m;
}

/// The cell of a real voltage in units (the f64 model's cell_of).
pub fn cellf(v: f64) -> u32 {
    var c : u32 = (v / CELL_F) as u32;
    if (c >= NCELL) { c = NCELL - 1; }
    return c;
}

pub fn nodef(t: []const u32, cx: u32, cy: u32) -> f64 {
    return (t[(cx * NODES + cy) as usize]) as f64;
}

/// id_of in real arithmetic on the same table values: no rounding.
pub fn idf(t: []const u32, vg: f64, vd: f64) -> f64 {
    const cx : u32 = cellf(vg);
    const cy : u32 = cellf(vd);
    const fx : f64 = vg - (cx as f64) * CELL_F;
    const fy : f64 = vd - (cy as f64) * CELL_F;
    const lo : f64 = nodef(t, cx, cy) * (CELL_F - fx) + nodef(t, cx + 1, cy) * fx;
    const hi : f64 = nodef(t, cx, cy + 1) * (CELL_F - fx) + nodef(t, cx + 1, cy + 1) * fx;
    return (lo * (CELL_F - fy) + hi * fy) / (CELL_F * CELL_F);
}

/// gds_cell in real arithmetic.
pub fn gdsf(t: []const u32, vg: f64, vd: f64) -> f64 {
    const cx : u32 = cellf(vg);
    const cy : u32 = cellf(vd);
    const fx : f64 = vg - (cx as f64) * CELL_F;
    const d0 : f64 = fmax64(nodef(t, cx, cy + 1) - nodef(t, cx, cy), 0.0);
    const d1 : f64 = fmax64(nodef(t, cx + 1, cy + 1) - nodef(t, cx + 1, cy), 0.0);
    return (d0 * (CELL_F - fx) + d1 * fx) / CELL_F;
}

/// newton_iter_q in real arithmetic: the same equation, the same slopes, the same clamp, no rounding.
pub fn newton_iter_qf(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, y: f64, y0: f64, a: f64, a0: f64) -> f64 {
    const p : f64 = y + idf(tn, a, y) + idf(qn, a, y) + idf(qp, VDD_F - a0, VDD_F - y0);
    const n : f64 = y0 + idf(tp, VDD_F - a, VDD_F - y) + idf(qn, a0, y0) + idf(qp, VDD_F - a, VDD_F - y);
    const d : f64 = CELL_F + gdsf(tn, a, y) + gdsf(tp, VDD_F - a, VDD_F - y) + gdsf(qn, a, y) + gdsf(qp, VDD_F - a, VDD_F - y);
    var z : f64 = y - (p - n) * CELL_F / d;
    if (z < 0.0) { z = 0.0; }
    if (z > VDD_F) { z = VDD_F; }
    return z;
}

/// newton_iter in real arithmetic, without charge.
pub fn newton_iter_f(tn: []const u32, tp: []const u32, y: f64, y0: f64, a: f64) -> f64 {
    return newton_iter_qf(tn, tp, &NOQ, &NOQ, y, y0, a, a);
}

/// The f64 model of the table run with charge: 400 steps of k real Newton iterations from y_init, the gate before step 0 at
/// a_rest, out in units.
pub fn run_tabf_q(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32, k: u32, y_init: f64, a_rest: u32, out: []f64) {
    var y : f64 = y_init;
    var n : u32 = 0;
    while (n < RUN_STEPS) {
        const a : f64 = (gate_at(n)) as f64;
        var a0 : f64 = a_rest as f64;
        if (n > 0) { a0 = (gate_at(n - 1)) as f64; }
        const y0 : f64 = y;
        var i : u32 = 0;
        while (i < k) {
            y = newton_iter_qf(tn, tp, qn, qp, y, y0, a, a0);
            i = i + 1;
        }
        out[n as usize] = y;
        n = n + 1;
    }
}

/// The f64 model of the table run without charge: `run_tabf_q` with the zero charge tables.
pub fn run_tabf(tn: []const u32, tp: []const u32, k: u32, y_init: f64, out: []f64) {
    run_tabf_q(tn, tp, &NOQ, &NOQ, k, y_init, gate_at(0), out);
}

/// The analytic reference: backward Euler of the inverter with cpphdl's law, Newton to convergence (ANA_ITERS). f scales
/// dt (1.0 is 10 ns, 0.5 is 5 ns); the gate steps at step edge. out gets Y in volts after each of nsteps steps.
pub fn run_ana(f: f64, nsteps: u32, edge: u32, out: []f64) {
    const k : f64 = STEP_V_PER_A * f;
    var y : f64 = 0.0;
    var n : u32 = 0;
    while (n < nsteps) {
        var a : f64 = 0.0;
        if (n >= edge) { a = VDD_V; }
        const y0 : f64 = y;
        var i : u32 = 0;
        while (i < ANA_ITERS) {
            const g : f64 = y - y0 - k * law_amps(VDD_V - a, VDD_V - y, VTH_V) + k * law_amps(a, y, VTH_V);
            const gp : f64 = 1.0 + k * law_gds(VDD_V - a, VDD_V - y, VTH_V) + k * law_gds(a, y, VTH_V);
            y = y - g / gp;
            if (y < 0.0) { y = 0.0; }
            if (y > VDD_V) { y = VDD_V; }
            i = i + 1;
        }
        out[n as usize] = y;
        n = n + 1;
    }
}

/// exp(x) in real arithmetic for the tests: x / 256 by the Taylor series to the 13th term, then squared eight times (relative error under 1e-13 for |x| < 40).
pub fn exp_f64(x: f64) -> f64 {
    const y : f64 = x / 256.0;
    var term : f64 = 1.0;
    var sum : f64 = 1.0;
    var i : u32 = 1;
    while (i < 14) {
        term = term * y / (i as f64);
        sum = sum + term;
        i = i + 1;
    }
    var k : u32 = 0;
    while (k < 8) {
        sum = sum * sum;
        k = k + 1;
    }
    return sum;
}

/// The cell of a real voltage on an axis of ncell cells of cell units (the f64 model's `cell_w`).
pub fn cellf_w(v: f64, cell: f64, ncell: u32) -> u32 {
    var c : u32 = (v / cell) as u32;
    if (c >= ncell) { c = ncell - 1; }
    return c;
}

/// `lg_fine` in real arithmetic on the same words: the bilinear blend of the log words and the linear blend of the rv words with no rounding, F = 1 - exp(-x) and 2^(lam / 2^16)
/// exact (`exp_f64`). Id in IUNIT, vg and vd in units. The integer read is checked against this: that is the arithmetic error, apart from the table's.
pub fn idf_log(t: []const u32, vg: f64, vd: f64) -> f64 {
    const gc : f64 = 262144.0;
    const dc : f64 = 524288.0;
    const cx : u32 = cellf_w(vg, gc, LG_NG);
    const cy : u32 = cellf_w(vd, dc, LG_ND);
    const fx : f64 = (vg - (cx as f64) * gc) / gc;
    const fy : f64 = (vd - (cy as f64) * dc) / dc;
    const nd1 : usize = (LG_NODES_D) as usize;
    const i00 : usize = 1 + (cx as usize) * nd1 + (cy as usize);
    const lo : f64 = (t[i00] as f64) * (1.0 - fx) + (t[i00 + nd1] as f64) * fx;
    const hi : f64 = (t[i00 + 1] as f64) * (1.0 - fx) + (t[i00 + nd1 + 1] as f64) * fx;
    const lam : f64 = lo * (1.0 - fy) + hi * fy;
    const r0 : f64 = (t[LG_R_OFF + (cx as usize)]) as f64;
    const r1 : f64 = (t[LG_R_OFF + (cx as usize) + 1]) as f64;
    const x : f64 = vd * (r0 * (1.0 - fx) + r1 * fx) / 68719476736.0;
    return (1.0 - exp_f64(0.0 - x)) * exp_f64(lam * 0.6931471805599453 / 65536.0);
}

; --- the tests ----------------------------------------------------------------------------------

test the_grid_and_the_units_are_exact {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var cell : u32 = CELL;
    var bits : u32 = CELL_BITS;
    var ncell : u32 = NCELL;
    var nodes : u32 = NODES;
    var vdd : u32 = VDD;
    var half : u64 = HALF_Q;
    var tmax : u32 = TBL_MAX;
    var upv : f64 = UNITS_PER_V;
    var cellf_ : f64 = CELL_F;
    var vddf : f64 = VDD_F;
    assert_eq(cell, 1 << bits);
    assert_eq(vdd, ncell * cell);
    assert_eq(nodes, ncell + 1);
    assert_eq(nodes * nodes, TBL_LEN as u32);
    assert_eq(half, 1 << 39);
    assert_eq(upv, 20.0 * cellf_);
    assert_eq(vddf, (vdd as f64));
    assert_eq(cellf_, (cell as f64));
    // 1.2 V is 24 cells and 0.35 V is 7, so both are grid lines and nothing is rounded.
    assert_eq(vddf / upv, VDD_V);
    assert_eq(7.0 * cellf_ / upv, VTH_V);
    // dt / C is 10 ns / 10 pF = 1000 V/A.
    const dtc : f64 = (DT_NS as f64) * 0.000000001 / ((C_PF as f64) * 0.000000000001) - STEP_V_PER_A;
    assert dtc * dtc < 0.000001 * 0.000001;
    // The widest product of the interpolation: TBL_MAX * 2^40 + the rounding half fits in a u64.
    assert tmax < 8388608;
    assert (tmax as u64) * 1099511627776 + half < 9223372036854775808;
}

test the_table_is_the_law_at_the_nodes {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    assert node_err(&t) <= 0.5 + 0.0000001;
    assert node_err(&t) > 0.3;
    assert(monotone(&t));
    assert_eq(t[624], TBL_MAX);
    assert_eq(t[0], 0);
    // Vgs on the threshold line (node 7) and below: no current. Vds = 0: no current.
    var ix : u32 = 0;
    var iy : u32 = 0;
    while (ix <= 7) {
        iy = 0;
        while (iy < NODES) {
            assert_eq(t[(ix * NODES + iy) as usize], 0);
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    ix = 0;
    while (ix < NODES) {
        assert_eq(t[(ix * NODES) as usize], 0);
        ix = ix + 1;
    }
    // Saturation is flat in Vds: Vgs = 0.55 V (node 11) has ov = 0.2 V, so Vds >= 0.2 V (node 4) gives one value.
    assert_eq(t[(11 * NODES + 4) as usize], t[(11 * NODES + 24) as usize]);
    assert t[(11 * NODES + 3) as usize] < t[(11 * NODES + 4) as usize];
}

test the_interpolation_is_exact_at_the_nodes_and_bilinear_inside {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var ix : u32 = 0;
    var iy : u32 = 0;
    while (ix < NODES) {
        iy = 0;
        while (iy < NODES) {
            assert_eq(id_of(&t, ix * CELL, iy * CELL), t[(ix * NODES + iy) as usize]);
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    // A cell centre is the mean of the four corners, rounded half up: cell (12, 4).
    const c4 : u32 = t[(12 * NODES + 4) as usize] + t[(13 * NODES + 4) as usize] + t[(12 * NODES + 5) as usize] + t[(13 * NODES + 5) as usize];
    assert_eq(id_of(&t, 12 * CELL + (CELL >> 1), 4 * CELL + (CELL >> 1)), (c4 + 2) / 4);
    // Along an edge it is linear in the position: a quarter of the way along Vds at Vgs = node 12.
    const e0 : u32 = t[(12 * NODES + 8) as usize];
    const e1 : u32 = t[(12 * NODES + 9) as usize];
    assert_eq(id_of(&t, 12 * CELL, 8 * CELL + (CELL >> 2)), (3 * e0 + e1 + 2) / 4);
    // The scalar arithmetic alone: the corners at the corners, the mean at the centre, one rounding in all.
    assert_eq(blend(100, 200, 300, 400, 0, 0), 100);
    assert_eq(blend(100, 200, 300, 400, CELL, 0), 200);
    assert_eq(blend(100, 200, 300, 400, 0, CELL), 300);
    assert_eq(blend(100, 200, 300, 400, CELL, CELL), 400);
    assert_eq(blend(100, 200, 300, 400, CELL >> 1, CELL >> 1), 250);
    assert_eq(blend(1, 0, 0, 0, CELL >> 1, CELL >> 1), 0);
    assert_eq(blend(2, 0, 0, 0, CELL >> 1, CELL >> 1), 1);
    assert_eq(blend1(10, 30, 0), 10);
    assert_eq(blend1(10, 30, CELL), 30);
    assert_eq(blend1(10, 30, CELL >> 1), 20);
    assert_eq(frac_of(VDD), CELL);
    assert_eq(frac_of(3 * CELL + 7), 7);
    // The step the board runs is inv_step at K_NEWTON, and the loop count is the only difference.
    assert_eq(board_step(&t, &t, 4000000, 0), inv_step(&t, &t, 4000000, 0, K_NEWTON));
    assert_eq(board_step(&t, &t, 4000000, VDD), inv_step(&t, &t, 4000000, VDD, K_NEWTON));
    assert_eq(board_step(&t, &t, VDD, 0), VDD);
    assert_eq(board_step(&t, &t, 0, VDD), 0);
    // Inputs past Vdd are held at the last node.
    assert_eq(id_of(&t, VDD + 5, VDD + 9), TBL_MAX);
    assert_eq(cell_of(VDD), NCELL - 1);
    assert_eq(cell_of(VDD - 1), NCELL - 1);
    assert_eq(cell_of(CELL - 1), 0);
    assert_eq(cell_of(CELL), 1);
}

test gm_and_gds_are_the_slopes_of_the_interpolant {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    // Across a whole cell of Vds the interpolant moves by exactly gds_cell (the two reads and the slope each round).
    var cy : u32 = 3;
    var dy : u32 = 0;
    var cx : u32 = 8;
    var dx : u32 = 0;
    var fx : u32 = 0;
    while (cx < 24) {
        fx = (cx * 977) % CELL;
        cy = 3;
        while (cy < 23) {
            dy = id_of(&t, cx * CELL + fx, (cy + 1) * CELL) - id_of(&t, cx * CELL + fx, cy * CELL);
            assert mag_diff(dy, gds_cell(&t, cx * CELL + fx, cy * CELL + 12345)) <= 2;
            dx = id_of(&t, (cx + 1) * CELL, cy * CELL + fx) - id_of(&t, cx * CELL, cy * CELL + fx);
            assert mag_diff(dx, gm_cell(&t, cx * CELL + 12345, cy * CELL + fx)) <= 2;
            cy = cy + 1;
        }
        cx = cx + 1;
    }
    // Spot values: saturation is flat in Vds (gds 0), gm is positive there, and below threshold both are 0.
    assert_eq(gds_cell(&t, 11 * CELL, 10 * CELL), 0);
    assert gm_cell(&t, 11 * CELL, 10 * CELL) > 0;
    assert_eq(gm_cell(&t, 3 * CELL, 10 * CELL), 0);
    assert_eq(gds_cell(&t, 3 * CELL, 10 * CELL), 0);
    // A table that decreased would be clamped at 0, not wrapped: dpos.
    assert_eq(dpos(5, 9), 0);
    assert_eq(dpos(9, 5), 4);
}

test the_table_against_the_law_at_the_cell_midpoints {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    const m : MidStats = mid_stats(&t);
    // Absolute: beta h^2 / 8 = 3.125e-7 A, from both sides.
    assert m.abs_a < 0.00000032;
    assert m.abs_a > 0.0000003;
    // Relative, floor 1e-9 A: all midpoints, a chord against a square reads twice the law in the first cell above Vth.
    assert m.rel_all < 1.0001;
    assert m.rel_all > 0.999;
    // From the second cell above Vth on.
    assert m.rel_hi < 0.2002;
    assert m.rel_hi > 0.19;
    // The slopes of the interpolant against the law's derivatives, in units of dt / C.
    assert m.gds_dev < 0.0126;
    assert m.gds_dev > 0.012;
    assert m.gm_dev < 0.0126;
    assert m.gm_dev > 0.012;
}

test the_first_steps_are_pinned_and_the_inverter_ends_at_zero {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    const s : u64 = run_fix(&t, &t, K_NEWTON, 0, false, &out, &res);
    assert_eq(out[0], EXP_Y0);
    assert_eq(out[3], EXP_Y3);
    assert_eq(out[199], VDD);
    assert_eq(out[200], EXP_Y200);
    assert_eq(out[399], 0);
    assert_eq(s, EXP_S);
    assert_eq(board_step(&t, &t, 0, 0), EXP_Y0);
    // cpphdl's requirement: |Y(4 us)| <= 1 mV, and Y(2 us) is 1.2 V.
    const y4 : f64 = (out[399] as f64) / UNITS_PER_V;
    assert y4 * y4 <= 0.001 * 0.001;
    const y2 : f64 = (out[199] as f64) / UNITS_PER_V;
    assert_eq(y2, VDD_V);
    // Y stays in [0, Vdd], rises while the input is low, falls once it is high.
    var n : u32 = 0;
    while (n < RUN_STEPS) {
        assert out[n as usize] <= VDD;
        if (n > 0 and n < EDGE_STEP) { assert out[n as usize] >= out[(n - 1) as usize]; }
        if (n > EDGE_STEP) { assert out[n as usize] <= out[(n - 1) as usize]; }
        n = n + 1;
    }
    // Y is within 1 mV of 1.2 V by step 12 and within 1 mV of 0 by step 212.
    const mv : f64 = 0.001 * UNITS_PER_V;
    assert ((VDD - out[11]) as f64) > mv;
    assert ((VDD - out[12]) as f64) <= mv;
    assert (out[211] as f64) > mv;
    assert (out[212] as f64) <= mv;
}

test the_last_residual_is_bounded_at_every_step {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    const s : u64 = run_fix(&t, &t, K_NEWTON, 0, false, &out, &res);
    var n : u32 = 0;
    var ones : u32 = 0;
    while (n < RUN_STEPS) {
        assert res[n as usize] <= RES_BOUND;
        if (res[n as usize] == 1) { ones = ones + 1; }
        n = n + 1;
    }
    // From both sides: the worst is exactly one unit (the rounding of the last move), so the bound is within a factor 2.
    assert_eq(max_of(&res), 1);
    assert_eq(ones, 22);
    assert_eq(s, EXP_S);
    // The residual is |g|: recompute it for the first step by hand from the pieces.
    const y1 : u32 = out[0];
    assert_eq(g_resid(&t, &t, y1, 0, 0), mag_diff(y1 + id_of(&t, 0, y1), id_of(&t, VDD, VDD - y1)));
}

test k1_is_the_negative_control_it_breaks_the_residual_bound {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    var res2 : [400]u32 = [0] ** 400;
    var out2 : [400]u32 = [0] ** 400;
    const s1 : u64 = run_fix(&t, &t, 1, 0, false, &out, &res);
    // One Newton iteration leaves 1199464 units (57 mV) of residual, 600000 times the bound.
    assert max_of(&res) > RES_BOUND;
    assert max_of(&res) > 1000000;
    assert max_of(&res) < 1300000;
    assert s1 != EXP_S;
    const s2 : u64 = run_fix(&t, &t, 2, 0, false, &out2, &res2);
    assert max_of(&res2) > RES_BOUND;
    assert_eq(max_of(&res2), 29760);
    assert s2 != EXP_S;
    // And the bound itself is not met by K = 1 anywhere near: the first rise step.
    assert res[1] > 1000000;
}

test the_mirrored_circuit_gives_the_mirrored_samples_bit_for_bit {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    var outm : [400]u32 = [0] ** 400;
    var resm : [400]u32 = [0] ** 400;
    const s : u64 = run_fix(&t, &t, K_NEWTON, 0, false, &out, &res);
    const sm : u64 = run_fix(&t, &t, K_NEWTON, VDD, true, &outm, &resm);
    var n : u32 = 0;
    while (n < RUN_STEPS) {
        assert_eq(outm[n as usize], VDD - out[n as usize]);
        assert_eq(resm[n as usize], res[n as usize]);
        n = n + 1;
    }
    assert s != sm;
    // The mirror of a single step, off the run: arbitrary y0 and gate.
    assert_eq(inv_step(&t, &t, VDD - 9000000, VDD - 5000000, 3), VDD - inv_step(&t, &t, 9000000, 5000000, 3));
    assert_eq(inv_step(&t, &t, VDD - 123456, VDD, 3), VDD - inv_step(&t, &t, 123456, 0, 3));
}

test two_different_tables_swap_with_the_mirror {
    // M3b gives the NMOS and the PMOS their own tables. The mirror of a circuit is the circuit with the two tables swapped:
    // A -> Vdd - A, Y -> Vdd - Y, tn <-> tp leaves g -> -g, so one step maps to the mirrored step bit for bit.
    var tn : [625]u32 = [0] ** 625;
    var tp : [625]u32 = [0] ** 625;
    build_table(&tn, VTH_V);
    build_table(&tp, VTH_WRONG_V);
    assert_eq(inv_step(&tn, &tp, VDD - 9000000, VDD - 5000000, 3), VDD - inv_step(&tp, &tn, 9000000, 5000000, 3));
    assert_eq(inv_step(&tn, &tp, VDD - 123456, VDD, 3), VDD - inv_step(&tp, &tn, 123456, 0, 3));
    assert_eq(g_resid(&tn, &tp, 12000000, 11000000, 20000000), g_resid(&tp, &tn, VDD - 12000000, VDD - 11000000, VDD - 20000000));
    // The two tables are two arguments, not one. At a gate of 0.30 V the NMOS conducts in neither table, so the PMOS table
    // alone decides the step: the same pair swapped, or the PMOS table replaced by the NMOS one, gives another step.
    assert inv_step(&tn, &tp, 9000000, 5000000, 3) != inv_step(&tp, &tn, 9000000, 5000000, 3);
    assert inv_step(&tn, &tn, 9000000, 5000000, 3) != inv_step(&tn, &tp, 9000000, 5000000, 3);
    assert_eq(board_step(&tn, &tp, 9000000, 5000000), inv_step(&tn, &tp, 9000000, 5000000, K_NEWTON));
}

test the_three_errors_arithmetic_table_discretization {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    var tabf : [400]f64 = [0.0] ** 400;
    var tab12 : [400]f64 = [0.0] ** 400;
    var ana : [400]f64 = [0.0] ** 400;
    var half : [800]f64 = [0.0] ** 800;
    const s : u64 = run_fix(&t, &t, K_NEWTON, 0, false, &out, &res);
    run_tabf(&t, &t, K_NEWTON, 0.0, &tabf);
    run_tabf(&t, &t, 12, 0.0, &tab12);
    run_ana(1.0, 400, 200, &ana);
    run_ana(0.5, 800, 400, &half);
    var arith : f64 = 0.0;
    var table : f64 = 0.0;
    var disc : f64 = 0.0;
    var lag : f64 = 0.0;
    var n : u32 = 0;
    while (n < RUN_STEPS) {
        const i : usize = n as usize;
        arith = fmax64(arith, fabs64((out[i] as f64) - tabf[i]));
        table = fmax64(table, fabs64(tabf[i] / UNITS_PER_V - ana[i]));
        disc = fmax64(disc, fabs64(ana[i] - half[2 * i + 1]));
        lag = fmax64(lag, fabs64(tabf[i] - tab12[i]));
        n = n + 1;
    }
    // Arithmetic: fixed point against the f64 model of the same iteration, in units (47.68 nV). Measured 0.610.
    assert arith < 0.7;
    assert arith > 0.5;
    // Table: the f64 table model against the analytic law solved to convergence, in volts. Measured 0.428 mV.
    assert table < 0.00045;
    assert table > 0.0004;
    // Newton at K = 3 is converged on the table: it equals K = 12 to far below a unit.
    assert lag < 0.001;
    // Discretization: dt against dt/2 on the analytic law, in volts. Measured 27.2 mV.
    assert disc < 0.0275;
    assert disc > 0.027;
    // The issue's scenario: Y at 2 us within 1 uV of the analytic run, Y at 4 us within 1 uV of it and under 1 mV.
    const d2 : f64 = (out[199] as f64) / UNITS_PER_V - ana[199];
    assert d2 * d2 < 0.000001 * 0.000001;
    const d4 : f64 = (out[399] as f64) / UNITS_PER_V - ana[399];
    assert d4 * d4 < 0.000001 * 0.000001;
    assert_eq(s, EXP_S);
}

test the_analytic_reference_is_a_converged_backward_euler {
    var ana : [400]f64 = [0.0] ** 400;
    run_ana(1.0, 400, 200, &ana);
    // Y(2 us) is Vdd, Y(4 us) is ~0 (cpphdl: 11.5 nV; this solver is converged, so it is below that).
    const d2 : f64 = ana[199] - VDD_V;
    assert d2 * d2 < 0.000000000001 * 0.000000000001;
    assert ana[399] * ana[399] < 0.001 * 0.001;
    // The first rise step by hand: Y1 solves y = k Ip(1.2 V, 1.2 V - y) in the saturation/linear mix.
    const k : f64 = STEP_V_PER_A;
    const y1 : f64 = ana[0];
    const g1 : f64 = y1 - k * law_amps(VDD_V, VDD_V - y1, VTH_V);
    assert g1 * g1 < 0.0000000001 * 0.0000000001;
    // The law's own checks: zero below threshold, the two regions meet at Vds = ov, symmetric drain/source not needed.
    assert_eq(law_amps(0.35, 1.0, VTH_V), 0.0);
    assert_eq(law_amps(1.2, 0.0, VTH_V), 0.0);
    const sat : f64 = law_amps(1.2, 0.85, VTH_V);
    const lin : f64 = law_amps(1.2, 0.8499999999, VTH_V);
    assert (sat - lin) * (sat - lin) < 0.000000001 * 0.000000001;
    const peak : f64 = law_amps(1.2, 1.2, VTH_V) - 0.00036125;
    assert peak * peak < 0.000000000000001 * 0.000000000000001;
}

test vth_030_is_the_negative_control_the_law_check_fails {
    var good : [625]u32 = [0] ** 625;
    var bad : [625]u32 = [0] ** 625;
    build_table(&good, VTH_V);
    build_table(&bad, VTH_WRONG_V);
    // At the nodes: the right table is within half a unit of the law, the wrong one is nowhere near.
    assert node_err(&good) <= 0.5 + 0.0000001;
    assert node_err(&bad) > 900000.0;
    // At the midpoints: past the absolute bound by a factor 100, past the relative bound by a factor 9.
    const mg : MidStats = mid_stats(&good);
    const mb : MidStats = mid_stats(&bad);
    assert mg.abs_a < 0.00000032;
    assert mb.abs_a > 0.00001;
    assert mg.rel_hi < 0.2002;
    assert mb.rel_hi > 1.0;
    // In the circuit: the inverter run on the wrong table leaves the analytic run by tens of mV (bound 0.45 mV).
    var outb : [400]u32 = [0] ** 400;
    var resb : [400]u32 = [0] ** 400;
    var ana : [400]f64 = [0.0] ** 400;
    const sb : u64 = run_fix(&bad, &bad, K_NEWTON, 0, false, &outb, &resb);
    run_ana(1.0, 400, 200, &ana);
    var worst : f64 = 0.0;
    var n : u32 = 0;
    while (n < RUN_STEPS) {
        worst = fmax64(worst, fabs64((outb[n as usize] as f64) / UNITS_PER_V - ana[n as usize]));
        n = n + 1;
    }
    assert worst > 0.04;
    assert worst < 0.05;
    assert worst > 90.0 * 0.00045;
    assert sb != EXP_S;
    // The circuit still ends where cpphdl needs it: the wrong threshold is caught by the law check, not by the endpoint.
    assert ((outb[399]) as f64) <= 0.001 * UNITS_PER_V;
}

test a_wrong_reading_of_the_table_is_caught {
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    // The table is not symmetric: reading it with the axes swapped gives another number at an off-diagonal point.
    assert id_of(&t, 12 * CELL, 5 * CELL) != id_of(&t, 5 * CELL, 12 * CELL);
    // Truncating the interpolation instead of rounding it moves a cell centre by the rounding half.
    const c : u32 = t[(12 * NODES + 4) as usize] + t[(13 * NODES + 4) as usize] + t[(12 * NODES + 5) as usize] + t[(13 * NODES + 5) as usize];
    assert (c % 4) >= 2;
    assert_eq(id_of(&t, 12 * CELL + (CELL >> 1), 4 * CELL + (CELL >> 1)), (c + 2) / 4);
    assert id_of(&t, 12 * CELL + (CELL >> 1), 4 * CELL + (CELL >> 1)) != c / 4;
    // The fold knows the order.
    assert fold(fold(0, 1), 2) != fold(fold(0, 2), 1);
    assert_eq(fold(0x8000000000000000, 0), 1);
}

test the_charge_path_with_zero_charge_tables_is_the_current_only_path_bit_for_bit {
    // M3c (#10777). The current-only functions are the charge-aware ones with the zero tables: not an equal run but the same
    // function, so every pinned M3a number above (EXP_S, the first steps) is also a number of the charge path. Spot checks on the
    // way, over several gates and states, K = 1 .. 3.
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var checked : u32 = 0;
    var y : u32 = 0;
    while (y < VDD) {
        var a : u32 = 0;
        while (a <= VDD) {
            assert_eq(newton_iter(&t, &t, y, VDD - y, a), newton_iter_q(&t, &t, &NOQ, &NOQ, y, VDD - y, a, VDD - a));
            assert_eq(inv_step(&t, &t, y, a, 2), inv_step_q(&t, &t, &NOQ, &NOQ, y, a, 0, 2));
            assert_eq(g_resid(&t, &t, y, 777, a), g_resid_q(&t, &t, &NOQ, &NOQ, y, 777, a, VDD));
            checked = checked + 1;
            a = a + 6 * CELL;
        }
        y = y + 5 * CELL + 12345;
    }
    assert checked > 20;
    assert_eq(board_step(&t, &t, 4000000, VDD), board_step_q(&t, &t, &NOQ, &NOQ, 4000000, VDD, 0));
    assert_eq(NOQ[0], 0);
    assert_eq(NOQ[624], 0);
}

test a_synthetic_plane_of_charge_gives_the_closed_form_feedthrough_and_load {
    // No device current (zero tables), a drain charge that is a plane: qn(ix, iy) = 4000000 - 100000 ix + 80000 iy per node, that is a
    // gate coupling of -K1/2^20 = -0.0954 and a drain capacitance of K2/2^20 = 0.0763 of the node's C. The backward Euler equation
    // (y - y0)(1 + K2') = K1' (A - A0) is linear, so the gate falling from Vdd to 0 kicks the node down by K1' Vdd / (1 + K2')
    // = 100000 * 24 / 1.0763 units, and a Newton step on a linear equation lands on it (within the rounding of the reads).
    var qn : [625]u32 = [0] ** 625;
    var ix : u32 = 0;
    while (ix < NODES) {
        var iy : u32 = 0;
        while (iy < NODES) {
            qn[(ix * NODES + iy) as usize] = 4000000 - 100000 * ix + 80000 * iy;
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    assert monotone_along(&qn, 1);
    assert monotone_along(&qn, 0) == false;
    const y0 : u32 = 20000000;
    const want : f64 = (y0 as f64) - 2400000.0 / (1.0 + 80000.0 / CELL_F);
    const got : u32 = inv_step_q(&NOQ, &NOQ, &qn, &NOQ, y0, 0, VDD, 3);
    assert fabs64((got as f64) - want) <= 3.0;
    assert got < y0 - 2000000;
    // The same plane as a PMOS charge (stored negated, so it grows with Vsd as qn grows with Vds): the equation is
    // (y - y0)(1 + P2') + P1' (A - A0) = 0 with the same numbers, the same kick.
    const gotp : u32 = inv_step_q(&NOQ, &NOQ, &NOQ, &qn, y0, 0, VDD, 3);
    assert fabs64((gotp as f64) - want) <= 3.0;
    // With the gate still, no current and any charge, the node does not move: charge conservation at rest.
    assert_eq(inv_step_q(&NOQ, &NOQ, &qn, &qn, y0, 5 * CELL, 5 * CELL, 3), y0);
    assert_eq(inv_step_q(&NOQ, &NOQ, &qn, &qn, y0, VDD, VDD, 3), y0);
    // The derivative is read off the same table: a plane's slope is its K2 per cell, one cell of Vds.
    assert_eq(gds_cell(&qn, 7 * CELL + 5, 9 * CELL + 77), 80000);
    // The f64 twin lands on the closed form too (two real Newton iterations).
    const g1 : f64 = newton_iter_qf(&NOQ, &NOQ, &qn, &NOQ, y0 as f64, y0 as f64, 0.0, CELL_F * 24.0);
    const g2 : f64 = newton_iter_qf(&NOQ, &NOQ, &qn, &NOQ, g1, y0 as f64, 0.0, CELL_F * 24.0);
    assert fabs64(g2 - want) <= 1.0;
}

test the_mirrored_circuit_with_charge_gives_the_mirrored_step_with_the_four_tables_swapped {
    // The mirror of the charge-aware equation: swap NMOS and PMOS (tn <-> tp and qn <-> qp, qp stored negated), A -> Vdd - A,
    // A0 -> Vdd - A0, y -> Vdd - y: the step is the mirror of the step, bit for bit. Two unlike current tables and two unlike
    // charge tables; the states include a gate edge.
    var tn : [625]u32 = [0] ** 625;
    var tp : [625]u32 = [0] ** 625;
    build_table(&tn, VTH_V);
    build_table(&tp, VTH_WRONG_V);
    var qn : [625]u32 = [0] ** 625;
    var qp : [625]u32 = [0] ** 625;
    var ix : u32 = 0;
    while (ix < NODES) {
        var iy : u32 = 0;
        while (iy < NODES) {
            qn[(ix * NODES + iy) as usize] = 4000000 - 90000 * ix + 70000 * iy + 1000 * ix * iy / 5;
            qp[(ix * NODES + iy) as usize] = 3000000 + 30000 * ix + 120000 * iy + 700 * iy * iy;
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    assert monotone_along(&qn, 1);
    assert monotone_along(&qp, 1);
    var checked : u32 = 0;
    var y0 : u32 = 3000000;
    while (y0 < VDD - 1000000) {
        var a0 : u32 = 0;
        while (a0 <= VDD) {
            var a : u32 = 0;
            while (a <= VDD) {
                const m : u32 = inv_step_q(&tp, &tn, &qp, &qn, VDD - y0, VDD - a, VDD - a0, 3);
                assert_eq(inv_step_q(&tn, &tp, &qn, &qp, y0, a, a0, 3), VDD - m);
                assert_eq(g_resid_q(&tn, &tp, &qn, &qp, y0 + 4321, y0, a, a0), g_resid_q(&tp, &tn, &qp, &qn, VDD - y0 - 4321, VDD - y0, VDD - a, VDD - a0));
                checked = checked + 1;
                a = a + 4 * CELL;
            }
            a0 = a0 + 12 * CELL;
        }
        y0 = y0 + 7 * CELL + 999;
    }
    assert checked > 50;
    // Not an identity of the code but of the equation: swapping only the current tables, or only the charge tables, is another step.
    assert inv_step_q(&tn, &tp, &qn, &qp, 9000000, 0, VDD, 3) != inv_step_q(&tp, &tn, &qn, &qp, 9000000, 0, VDD, 3);
    assert inv_step_q(&tn, &tp, &qn, &qp, 9000000, 0, VDD, 3) != inv_step_q(&tn, &tp, &qp, &qn, 9000000, 0, VDD, 3);
    // A step that sees no previous gate (A0 = A) differs from one coming from Vdd: the gate edge is in the charge.
    assert inv_step_q(&tn, &tp, &qn, &qp, 9000000, 0, VDD, 3) != inv_step_q(&tn, &tp, &qn, &qp, 9000000, 0, 0, 3);
}

test the_log_reader_generalizes_the_m3a_read_it_is_the_same_arithmetic_on_another_grid {
    // M3c-2 (#10881, FR-004). `read_w` is the read of any uniform grid; the 24 x 24 cells of 2^20 units are one case of it, and there it IS `id_of`: every point, bit for bit.
    var t : [625]u32 = [0] ** 625;
    build_table(&t, VTH_V);
    var checked : u32 = 0;
    var vg : u32 = 0;
    while (vg <= VDD + 7) {
        var vd : u32 = 3;
        while (vd <= VDD + 7) {
            assert_eq(read_w(&t, 0, vg, vd, 20, 20, 24, 24), id_of(&t, vg, vd));
            assert_eq(cur_of(&t, vg, vd), id_of(&t, vg, vd));
            assert_eq(cur_gds(&t, vg, vd), gds_cell(&t, vg, vd));
            checked = checked + 1;
            vd = vd + 1523417;
        }
        vg = vg + 1100003;
    }
    assert checked > 300;
    // The pieces: the cell, the blend of four nodes and the blend of two differences are the old ones when the weights are 2^20.
    var v : u32 = 0;
    while (v <= VDD + 9) {
        assert_eq(cell_w(v, 20, 24), cell_of(v));
        v = v + 777777;
    }
    assert_eq(cell_w(VDD, 20, 24), 23);
    assert_eq(cell_w(VDD, 18, 96), 95);
    assert_eq(cell_w(VDD, 19, 48), 47);
    var fx : u32 = 0;
    while (fx <= CELL) {
        var fy : u32 = 0;
        while (fy <= CELL) {
            assert_eq(blend_w(100, 20000, 300000, 4000000, fx, fy, 20, 20), blend(100, 20000, 300000, 4000000, fx, fy));
            assert_eq(blend_w(7, 0, 0, 0, fx, fy, 20, 20), blend(7, 0, 0, 0, fx, fy));
            fy = fy + 262144;
        }
        assert_eq(blend1_w(10, 3000000, fx, 20) as u32, blend1(10, 3000000, fx));
        fx = fx + 131071;
    }
    // On a grid of other cells the weights follow the cell: the corners at the corners, the mean at the centre.
    assert_eq(blend_w(100, 200, 300, 400, 0, 0, 18, 19), 100);
    assert_eq(blend_w(100, 200, 300, 400, 262144, 0, 18, 19), 200);
    assert_eq(blend_w(100, 200, 300, 400, 0, 524288, 18, 19), 300);
    assert_eq(blend_w(100, 200, 300, 400, 262144, 524288, 18, 19), 400);
    assert_eq(blend_w(100, 200, 300, 400, 131072, 262144, 18, 19), 250);
    assert_eq(blend_w(1, 0, 0, 0, 131072, 262144, 18, 19), 0);
    assert_eq(blend_w(2, 0, 0, 0, 131072, 262144, 18, 19), 1);
    assert_eq(blend1_w(10, 30, 131072, 18), 20);
    // A table with no tag is read as before: the first word of a linear table is below 2^23, never the tag.
    assert t[0] != LG_TAG;
    assert t[624] < 8388608;
}

test the_exp_is_a_table_and_a_shift_and_is_exact_to_the_rounding_of_the_table {
    // EXP2NEG is 2^-(i/128) in Q24, each entry the nearest integer (a sum of the table's exact values in real arithmetic).
    var i : u32 = 0;
    var worst : f64 = 0.0;
    while (i <= 128) {
        const want : f64 = 16777216.0 * exp_f64(0.0 - (i as f64) * 0.6931471805599453 / 128.0);
        worst = fmax64(worst, fabs64((EXP2NEG[i as usize] as f64) - want));
        i = i + 1;
    }
    assert worst < 0.5000001;
    assert worst > 0.4;
    assert_eq(EXP2NEG[0], 16777216);
    assert_eq(EXP2NEG[128], 8388608);
    // 2^f from the table and a shift: E = 2^(lam / 65536) to its rounding to an integer and the chord of the table (3.7e-6 relative).
    var lam : u32 = 0;
    var rel : f64 = 0.0;
    var absw : f64 = 0.0;
    var checked : u32 = 0;
    while (lam < 1900000) {
        const want : f64 = exp_f64((lam as f64) * 0.6931471805599453 / 65536.0);
        const got : f64 = (exp2_lam(lam)) as f64;
        absw = fmax64(absw, fabs64(got - want));
        if (want > 10000000.0) { rel = fmax64(rel, fabs64(got - want) / want); }
        checked = checked + 1;
        lam = lam + 7919;
    }
    assert checked > 200;
    assert absw < 1800.0;
    assert absw > 1700.0;
    assert rel < 0.0000038;
    assert rel > 0.0000030;
    assert_eq(exp2_lam(0), 1);
    assert_eq(exp2_lam(65536), 2);
    assert_eq(exp2_lam(65536 * 10), 1024);
    assert_eq(exp2_lam(65536 * 28), 268435456);
    // F = 1 - exp(-x): the series below 1/16 to a few units of Q24, the table above it to the chord (3.7e-6 of 1 = 62 units), and exactly 1 once e^-x is under 2^-25.
    var x24 : u32 = 1;
    var worst_lo : f64 = 0.0;
    var worst_hi : f64 = 0.0;
    var rel_lo : f64 = 0.0;
    while (x24 < 805306368) {
        const x : f64 = (x24 as f64) / 16777216.0;
        const want : f64 = 16777216.0 * (1.0 - exp_f64(0.0 - x));
        const got : f64 = (vds_factor(x24 as u64)) as f64;
        if (x24 < 1048576) {
            worst_lo = fmax64(worst_lo, fabs64(got - want));
            if (x24 > 16384) { rel_lo = fmax64(rel_lo, fabs64(got - want) / want); }
        } else {
            worst_hi = fmax64(worst_hi, fabs64(got - want));
        }
        x24 = x24 + 1 + x24 / 61;
    }
    assert worst_lo < 11.0;
    assert worst_lo > 10.0;
    assert rel_lo < 0.000037;
    assert rel_lo > 0.000035;
    assert worst_hi < 64.5;
    assert worst_hi > 63.5;
    assert_eq(vds_factor(0), 0);
    assert_eq(vds_factor(805306368) as u32, 16777216);
    // F is nondecreasing in x across the switch from the series to the table (a step back would be a negative conductance).
    var prev : u64 = 0;
    var steps : u32 = 0;
    x24 = 1040000;
    while (x24 < 1060000) {
        const f : u64 = vds_factor(x24 as u64);
        assert f >= prev;
        prev = f;
        x24 = x24 + 97;
        steps = steps + 1;
    }
    assert steps > 150;
}

test a_synthetic_log_table_gives_the_closed_form_value_and_slope {
    // Three log tables made of integers whose Id is a closed form: the log word is L0 + 8192 ix (the current grows 2^(8192 / 65536) = 9 % per node along Vgs) plus 0,
    // +16384 iy or -16384 iy (a factor 2^(+-1/4) per node along Vds), rv = 50000 (s = 82 mV). So Id(vg, vd) = (1 - exp(-vd rv / 2^36)) 2^(lam / 65536) in IUNIT with
    // lam = L0 + vg / 32 + c vd, c = 0, 1 / 32 or -1 / 32; and its slope is F' E + F E ln2 c / 65536 per unit of Vds.
    var tab : [4851]u32 = [0] ** 4851;
    var tabp : [4851]u32 = [0] ** 4851;
    var tabn : [4851]u32 = [0] ** 4851;
    var tabz : [4851]u32 = [0] ** 4851;
    tab[0] = LG_TAG;
    tabp[0] = LG_TAG;
    tabn[0] = LG_TAG;
    tabz[0] = LG_TAG;
    var ix : u32 = 0;
    while (ix < 97) {
        var iy : u32 = 0;
        while (iy < 49) {
            const at : usize = (1 + ix * 49 + iy) as usize;
            tab[at] = 700000 + 8192 * ix;
            tabp[at] = 400000 + 8192 * ix + 16384 * iy;
            tabn[at] = 1300000 + 8192 * ix - 16384 * iy;
            tabz[at] = 1700000 + 8192 * ix - 32768 * iy;
            iy = iy + 1;
        }
        tab[(4754 + ix) as usize] = 50000;
        tabp[(4754 + ix) as usize] = 50000;
        tabn[(4754 + ix) as usize] = 50000;
        tabz[(4754 + ix) as usize] = 50000;
        ix = ix + 1;
    }
    var v0 : f64 = 0.0;
    var vp : f64 = 0.0;
    var vn : f64 = 0.0;
    var s0 : f64 = 0.0;
    var sp : f64 = 0.0;
    var sn : f64 = 0.0;
    var checked : u32 = 0;
    var vg : u32 = 100000;
    while (vg < VDD) {
        var vd : u32 = 70000;
        while (vd < VDD) {
            const x : f64 = (vd as f64) * 50000.0 / 68719476736.0;
            const f : f64 = 1.0 - exp_f64(0.0 - x);
            const fp : f64 = 50000.0 / 68719476736.0 * exp_f64(0.0 - x);
            const lam0 : f64 = 700000.0 + (vg as f64) / 32.0;
            const lamp : f64 = 400000.0 + (vg as f64) / 32.0 + (vd as f64) / 32.0;
            const lamn : f64 = 1300000.0 + (vg as f64) / 32.0 - (vd as f64) / 32.0;
            const e0 : f64 = exp_f64(lam0 * 0.6931471805599453 / 65536.0);
            const ep : f64 = exp_f64(lamp * 0.6931471805599453 / 65536.0);
            const en : f64 = exp_f64(lamn * 0.6931471805599453 / 65536.0);
            // The value: the rounding to an integer (half) and a part in 1e5 of the value (the chord of the table's two exps).
            v0 = fmax64(v0, fabs64(((lg_fine(&tab, vg, vd)) as f64) - f * e0) - 0.00007 * f * e0);
            vp = fmax64(vp, fabs64(((lg_fine(&tabp, vg, vd)) as f64) - f * ep) - 0.00007 * f * ep);
            vn = fmax64(vn, fabs64(((lg_fine(&tabn, vg, vd)) as f64) - f * en) - 0.00007 * f * en);
            // The slope in words per 2^20 units: 2^20 / 2^8 = 4096 words per unit of IUNIT per unit of Vds. Two words and 0.4 % of it.
            const sl0 : f64 = fp * e0 * 4096.0;
            const slp : f64 = (fp * ep + f * ep * 0.6931471805599453 / 32.0 / 65536.0) * 4096.0;
            var sln : f64 = (fp * en - f * en * 0.6931471805599453 / 32.0 / 65536.0) * 4096.0;
            if (sln < 0.0) { sln = 0.0; }
            s0 = fmax64(s0, fabs64(((gds_log(&tab, vg, vd)) as f64) - sl0) - 0.004 * sl0);
            sp = fmax64(sp, fabs64(((gds_log(&tabp, vg, vd)) as f64) - slp) - 0.004 * slp);
            sn = fmax64(sn, fabs64(((gds_log(&tabn, vg, vd)) as f64) - sln) - 0.004 * sln);
            checked = checked + 1;
            vd = vd + 1700003;
        }
        vg = vg + 1300007;
    }
    assert checked > 100;
    assert v0 < 1.01;
    assert vp < 1.01;
    assert vn < 1.01;
    assert s0 < 2.0;
    assert sp < 2.0;
    assert sn < 2.0;
    // The Vds dependence of the log word is read: the current of the table that rises with Vds is not the current of the flat one, and where the log word falls so fast that the
    // slope of F E would be negative (a fall of 2^(-1/2) per node, ln2 / 16 of E per 2^20 units against F' E = rv e^-x E / 2^36 at x = 2.2) the slope is floored at 0, not wrapped.
    assert lg_fine(&tab, 12000000, 3000000) != lg_fine(&tabp, 12000000, 3000000);
    assert gds_log(&tab, 12000000, 3000000) > 0;
    assert gds_log(&tabp, 12000000, 3000000) > 0;
    assert_eq(gds_log(&tabz, 12000000, 3000000), 0);
    assert lg_fine(&tabz, 12000000, 3000000) > 0;
}

test the_source_to_bulk_read_blends_the_log_word_between_two_slices_and_is_the_2d_read_at_the_ends {
    // M3e (#11283). Two slices of one synthetic device: the log word of the first is L0 + 8192 ix, the second's is 65536 higher (a factor 2 in the current), rv = 50000 in both. So the
    // current at a fraction fz of the way is F 2^(lam / 65536) with lam = L0 + vg / 32 + fz / 64 (fz in units of 2^-22 of a slice: 65536 / 2^22 = 1 / 64).
    var ta : [4851]u32 = [0] ** 4851;
    var tb : [4851]u32 = [0] ** 4851;
    ta[0] = LG_TAG;
    tb[0] = LG_TAG;
    var ix : u32 = 0;
    while (ix < 97) {
        var iy : u32 = 0;
        while (iy < 49) {
            const at : usize = (1 + ix * 49 + iy) as usize;
            ta[at] = 700000 + 8192 * ix;
            tb[at] = 765536 + 8192 * ix;
            iy = iy + 1;
        }
        ta[(4754 + ix) as usize] = 50000;
        tb[(4754 + ix) as usize] = 50000;
        ix = ix + 1;
    }
    var full : u32 = 4194304;
    var half : u32 = 2097152;
    var worst : f64 = 0.0;
    var at_ends : u32 = 0;
    var rising : u32 = 0;
    var checked : u32 = 0;
    var vg : u32 = 100000;
    while (vg < VDD) {
        var vd : u32 = 70000;
        while (vd < VDD) {
            // the two ends are the 2-D reads of the slices, exactly
            if (lg_fine_vsb(&ta, &tb, vg, vd, 0) == lg_fine(&ta, vg, vd)) { at_ends = at_ends + 1; }
            if (lg_fine_vsb(&ta, &tb, vg, vd, full) == lg_fine(&tb, vg, vd)) { at_ends = at_ends + 1; }
            // the middle is the closed form: the rounding of an integer (half) and a part in 1e5 of the value
            const x : f64 = (vd as f64) * 50000.0 / 68719476736.0;
            const f : f64 = 1.0 - exp_f64(0.0 - x);
            const lamh : f64 = 700000.0 + (vg as f64) / 32.0 + 32768.0;
            const eh : f64 = exp_f64(lamh * 0.6931471805599453 / 65536.0);
            worst = fmax64(worst, fabs64(((lg_fine_vsb(&ta, &tb, vg, vd, half)) as f64) - f * eh) - 0.00007 * f * eh);
            // and the current rises with the fraction (the second slice is the higher)
            if (lg_fine_vsb(&ta, &tb, vg, vd, half) > lg_fine_vsb(&ta, &tb, vg, vd, 1048576)) { rising = rising + 1; }
            checked = checked + 1;
            vd = vd + 1700003;
        }
        vg = vg + 1300007;
    }
    assert checked > 100;
    assert_eq(at_ends, 2 * checked);
    assert_eq(rising, checked);
    assert worst < 1.01;
    // NEGATIVE CONTROL: the slices in each other's places read the other end (the second slice is twice the first), so a swap is seen at both ends
    assert lg_fine_vsb(&tb, &ta, 12000000, 3000000, 0) != lg_fine_vsb(&ta, &tb, 12000000, 3000000, 0);
    assert lg_fine_vsb(&tb, &ta, 12000000, 3000000, 0) > lg_fine_vsb(&ta, &tb, 12000000, 3000000, 0);
    // the cell and the position of a source-to-bulk voltage: 0.25 V = 2^22 units, the top of the axis is the end of the last cell, and a voltage above the supply is the supply
    var v0 : u32 = 0;
    var v1 : u32 = 4194303;
    var v2 : u32 = 4194304;
    var v3 : u32 = 10000000;
    var top : u32 = VDD;
    var over : u32 = VDD + 5;
    assert_eq(lg_vsb_cell(v0), 0);
    assert_eq(lg_vsb_frac(v0), 0);
    assert_eq(lg_vsb_cell(v1), 0);
    assert_eq(lg_vsb_frac(v1), 4194303);
    assert_eq(lg_vsb_cell(v2), 1);
    assert_eq(lg_vsb_frac(v2), 0);
    assert_eq(lg_vsb_cell(v3), 2);
    assert_eq(lg_vsb_frac(v3), 1611392);
    assert_eq(lg_vsb_cell(top), 5);
    assert_eq(lg_vsb_frac(top), 4194304);
    assert_eq(lg_vsb_cell(over), 5);
    assert_eq(lg_vsb_frac(over), 4194304);
}
