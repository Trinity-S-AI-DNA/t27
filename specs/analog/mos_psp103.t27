// SPDX-License-Identifier: Apache-2.0
; specs/analog/mos_psp103.t27 -- the CMOS inverter on the IHP SG13G2 PSP103 tables, per corner, judged by ngspice
; M3b of the analog emulation epic (#10486, issue #10516); M3c (#10777, sub-issue #10880) adds the terminal charge, THE CHARGE below. M3a (specs/analog/mos_table.t27) solved a CMOS inverter whose MOS currents
; were read from a table made of the square law. This file runs the same solver, unchanged but for taking the NMOS table and the
; PMOS table as two arguments, on tables made from the foundry's model: Id(Vgs, Vds) of sg13_lv_nmos (W 1.0 um) and sg13_lv_pmos
; (W 3.0 um), L 0.45 um, PSP 103.6 through ngspice-47 and the OSDI interface, IHP-Open-PDK commit 21133f219b1a6da10d803e345761e77415ceff40,
; 27 C, for the five corners mos_tt, mos_ff, mos_ss, mos_fs, mos_sf. The numbers are in specs/analog/mos_psp103_data.t27 (data and
; pins only) and were printed by the decks specs/analog/decks/psp103_*.cir; this file holds the functions that read them against
; ngspice and the tests. Nothing is copied from M3a: the table reader, the Newton step and the run are `use`d.
; -
; THE TABLES. 25 x 25 nodes, 24 cells of 62.5 mV over 0 .. 1.5 V on each axis, which is M3a's reader exactly: 24 cells of 2^20 units,
; a unit 2^-24 V (59.6 nV), Vdd = 25165824. An entry is Id * (dt / C) in units, dt / C = 200 V/A, so one unit is 0.298 nA; the largest
; entry (tt NMOS at 1.5 V, 1.5 V: 402.3 uA) is 1349912, under the 2^23 the u64 interpolation allows. gm and gds are the slopes of the
; interpolant, read off the same nodes as the value (FR-002; a test, for every cell of all ten tables). The PMOS table is Id(Vsg,
; Vsd) with source and bulk on the rail; the inverter's PMOS reads it at (Vdd - A, Vdd - Y), its NMOS reads the NMOS table at (A, Y).
; THE CIRCUIT. The inverter of the uberWAVE golden SAR deck (wp2-parser/golden/top.spice, GPL-2.0: read at run time, never vendored;
; this file holds the W, L and Vdd of its inverter, which are facts of the circuit): PMOS 3.0 um / 0.45 um, NMOS 1.0 um / 0.45 um, Vdd
; 1.5 V, a lumped load C on the output and nothing else. The gate is at Vdd and the output at rest; at step 0 the gate drops to 0 V
; (the output rises: tpLH) and at step 200 it returns to Vdd (the output falls: tpHL); 400 steps in all, M3a's `run_fix`. Two real
; circuits have the same table because they have the same dt / C: C = 10 pF with dt = 2 ns (the device capacitances, a few fF to some ten fF,
; are 0.2 % of the load) and C = 500 fF with dt = 100 ps (a few percent). The spec's model is dimensionless and runs the same 400 steps for both.
; The rest value is the DC solution of the tables with the gate at Vdd, by bisection (3 units; ngspice 11).
; -
; THE FIVE CORNERS AND THE INTERPOLATION ERROR. Held-out points are never nodes. For tt: the 576 cell midpoints (where a chord is
; worst) and 1000 points of the R2 low-discrepancy sequence, per device; for the other corners the first 200 R2 points. Against
; ngspice's current at the same point:
;   tt absolute      NMOS 6.51e-7 A (0.16 % of its 402 uA), PMOS 4.39e-7 A (0.15 % of 301 uA)           bounds 6.6e-7 / 4.5e-7, from both sides
;   tt relative, Id >= 100 uA   NMOS 0.56 %, PMOS 0.41 %  (221 and 157 of the 576 midpoints)          the proposed 1 % holds here
;   tt relative, Id >= 10 uA    4.3 % and 3.2 %;   Id >= 1 uA   21 % and 17 %
;   tt relative, floor 1e-9 A   0.55 .. 0.73 -- THE ISSUE'S PROPOSAL, 1 % WITH A FLOOR OF 1e-9 A, IS NOT MET and cannot be by
;                               a chord over a 62.5 mV cell: in weak inversion Id grows by a factor of about 6 per cell, where the
;                               chord at the midpoint is 43 % off, and below a few nA the rounding to 0.298 nA is a tenth of the
;                               current. The bound stated is what is measured (above); a finer grid or a log-domain interpolation
;                               would be needed for 1 % over the whole range.
;   ff, ss, fs, sf   absolute at most 5.7e-7 A (NMOS) and 4.4e-7 A (PMOS); relative for Id >= 100 uA at most 0.38 % and 0.26 %
; Every table is nondecreasing along both axes, zero at Vds = 0 (the gate leakage out of the drain, a few units, was held at 0 by
; the deck), has an off current of at most 10 units (3 nA) and its largest entry at (1.5 V, 1.5 V); the corners are in the foundry's order
; (ff above tt above ss in drive current for both devices; fs a fast NMOS with a slow PMOS, sf the reverse; their trip points
; run fs < ff < tt < ss < sf).
; -
; THE INVERTER'S DC TRANSFER, 49 points Vin = k * 31.25 mV, tables against ngspice, every corner. The worst |dVout| is at the steep
; part of the transfer (|slope| 9 .. 16 between neighbouring samples around Vin = 0.66 .. 0.69 V), where a 0.5 mV input error is a 5 mV
; output error: tt 5.5 mV (91938 units, bound 92500), the worst over the five corners 6.6 mV (fs, bound 112000 units). The trip point (the
; 0.75 V crossing) of the tables against ngspice's: tt 11 uV (bound 12.5 uV), ff 71 uV, ss 48 uV, fs 255 uV, sf 196 uV (bound 266 uV over all
; corners). ngspice's trip points: ff 0.680 V, tt 0.689 V, ss 0.700 V, fs 0.663 V, sf 0.718 V.
; -
; THE THREE ERRORS of the tt transient at 10 pF, kept apart (W10), the 400 samples against ngspice backward Euler on the same grid
; (psp103_inv_be.cir) and against ngspice converged (psp103_inv_fine.cir, steps of at most 20 ps):
;   arithmetic     the fixed-point run (K = 3) against the f64 run of the same iteration: 4.78 units (0.28 uV), no delay (< 1e-5 step).
;                  The last residual is at most 1 unit at every step (bound 2); K = 1 leaves 8586, K = 2 meets the bound.
;   table + model  the f64 model against ngspice backward Euler: 21402 units (1.28 mV, 0.085 % of Vdd), bound 21500; the delays
;                  are 0.142 % (tpLH) and 0.172 % (tpHL) shorter (37 ps and 34 ps), bound 0.18 %. This is the table (interpolation,
;                  rounding) PLUS the charge the table does not have: see the next paragraph, most of it is the charge.
;   discretization ngspice backward Euler at dt = 2 ns against ngspice converged: 242041 units (14.4 mV), the delays 0.51 % and
;                  0.66 % longer. It is the scheme's error, 11 times the model's on the waveform, and it does not depend on C.
; All three together, the fixed-point model against ngspice's converged run: tpLH 26.04 ns against 25.94 ns (0.37 %), tpHL
; 19.63 ns against 19.53 ns (0.51 %); the model's error and the scheme's partly cancel.
; THE MISSING CHARGE. At 500 fF and dt = 100 ps the model is 3.09 % and 3.63 % faster than ngspice backward Euler: PSP103's device
; capacitances (gate-drain overlap and channel, drain junctions) are now a few percent of the load and the table has none. The gap
; grows 21.8 and 21.1 times for a load 20 times smaller: it scales with 1 / C. So it is the capacitance, not the table, and nearly all of
; the 0.14 % and 0.17 % at 10 pF is the same missing charge. M3b tabulated current only; M3c tabulates the charge, next paragraph.
; -
; THE CHARGE (M3c, issue #10777). mos_psp103_data.t27 holds the DRAIN charge of each device on the same grid and corner, TT_QD_N and TT_QD_P (and
; the gate charge TT_QG_N, TT_QG_P, for the first circuit that has a gate node), and the same four for ss. specs/analog/decks/psp103_q_tt.cir and
; psp103_q_ss.cir print them: PSP103 reports no terminal charge, so the deck takes it from the terminal currents of one backward Euler step, which is
; what ngspice integrates, and prints the current tables in the same run (they are TT_N, TT_P, SS_N, SS_P byte for byte). One unit is the voltage a
; 500 fF node moves; the PMOS tables are negated so that every drain table grows with Vds. The solver is M3a's, generalized in mos_table.t27 (the
; `*_q` functions; the current-only ones are the same functions with zero charge tables, so M3a's pinned run is untouched). The output node holds
; C y + Qd_n - Qd_p, so the backward Euler step is
;   (y - y0) + (qn(A, y) - qn(A0, y0)) - (qp(Vdd - A, Vdd - y) - qp(Vdd - A0, Vdd - y0)) + In - Ip = 0
; with A0 the gate of the previous step: a gate edge is a jump of charge (the Miller kick), not a current. The Newton derivative adds the Vds slope of
; each charge table to the two current slopes, each read off its own table (FR-002; the slope is the interpolant's movement across the cell, a test).
; Against ngspice backward Euler on the same grid, tt, 500 fF, dt = 100 ps, 400 steps (the three errors apart):
;   table + model  tpLH 13.4379 steps against ngspice's 13.4352: 0.020 % (3.09 % without charge); tpHL 10.1826 against 10.1830: 0.0041 % (3.63 %).
;                  The waveform's worst of 401 samples is 6693 units (0.40 mV, 0.027 % of Vdd), 438317 (26 mV) without charge; after step 0 the
;                  fixed-point run is 27 units (1.6 uV) from ngspice's sample, after the falling edge 2566 (0.15 mV).
;   arithmetic     the fixed-point run against the f64 run of the same iteration: 4.03 units (0.24 uV), no delay (< 1e-5 step). The last Newton
;                  residual is at most 2 units at every step (the bound, reached); K = 1 leaves 11636.
;   discretization ngspice backward Euler at 100 ps against ngspice converged: the delays are 0.52 % and 0.67 % longer, which the charge does not
;                  touch. The model with charge is 0.54 % and 0.67 % from the converged run: now all of it is the scheme's.
; The tables never saw ngspice's own capacitance numbers, and agree with them: at Vgs = 0.9 V, Vds = 0.75 V the slopes of TT_QD_N and TT_QG_N are within
; 0.16 %, 0.29 % and 0.19 % of cdd + cjd + cgdol, -(cdg + cgdol) and cgg + cgsol + cgdol as ngspice reports them (the deck's op_n block).
; THE CHARGE'S NEGATIVE CONTROL. The ss charge tables in the tt run differ from tt's by 4.3 .. 5.3 % of their range, which moves the delays by only
; 0.13 % and 0.17 % (and the waveform by 24012 units, 1.4 mV): the issue's 1 % bar cannot see it, so the check holds 0.05 % and 6700 units, and refuses
; the ss charge by 2.5, 3.3 and 3.6 times. The charge missing (62 and 73 times over), the N and P charge tables in each other's slots (11 to 14
; times), and either device's charge alone fail too.
; THE WEAK INVERSION IS NOT MET (part 3 of #10777, follow-up #10881). 1 % with a floor of 1e-9 A at the midpoints and R2 points stays at the measured
; 0.55 .. 0.73, and a test says why no read of these tables can do it: a table word is 298 pA, so rounding alone is up to 149 pA, 15 % of the floor
; where 1 % allows 10 pA; and the NMOS current grows 6.5 .. 7 times per 62.5 mV cell, where a chord is more than 41 % above the exponential at the
; middle. The reader that meets it is a log-domain table in finer units with an integer exp, a different reader: #10881.
; -
; THE NEGATIVE CONTROLS, tests that pass by seeing the failure. `check_tt` holds a pair of tables to the tt bounds (Id at the 1000
; R2 points of each device, the DC transfer and the 10 pF transient against ngspice tt). The tt pair passes. The ss pair used where
; tt is expected fails every measure, by a factor of 36 to 830 over its bound: 59 uA at a held-out point, 283 mV of DC output, 10.3 mV of
; trip point, 112 mV of waveform, 6.5 % and 16 % of delay. Each of ff, fs and sf used as tt fails too. The pair in the wrong slots
; (PMOS table for the NMOS and the reverse) fails by factors of 100 to 10000. K = 1 breaks the residual bound by 4000. The charge has its own
; control, above.
; -
; THE HARDWARE. Everything the board would run is M3a's: `board_step` takes bool and unsigned words and no float, with the NMOS
; table and the PMOS table as two slices that a board would load at run time (a table is 625 words, each under 2^21): one bitstream per
; topology, not per corner. The functions in this file are all f64 or test-side: the held-out coordinates and statistics, the DC bisection
; (integer, but a test tool), the delay crossings and `check_tt`. No board top and no clock are in this file; no LUT, DSP, BRAM, Fmax or
; UART line is claimed.
; -
; WHAT A PASS SAYS. Ten tables from the foundry's PSP103 model (five corners, two devices, 25 x 25) are read by M3a's exact-integer
; bilinear interpolation with gm and gds from the same nodes; against ngspice they are within 6.6e-7 A (NMOS) and 4.5e-7 A (PMOS) at
; every tt held-out point and within 0.57 % where the current is at least 100 uA; the inverter built from the tt pair, solved by M3a's
; fixed three Newton iterations (last residual at most 1 unit), follows ngspice's backward Euler within 1.29 mV and 0.18 % of the delay
; at 10 pF, and ngspice's converged run within 0.37 % and 0.51 % of the delay; its DC transfer is within 5.5 mV and its trip point
; within 12 uV of ngspice's, and in every corner within 6.6 mV and 0.27 mV; and the ss pair, or any other, used as tt is refused. With the tt
; drain-charge tables (read by the same reader, their slopes from the same nodes) the 500 fF inverter follows ngspice's backward Euler on the same
; grid within 0.020 % and 0.0041 % of the two 50 % delays (the issue asked for 1 %) and 0.40 mV, three Newton iterations with a last residual of
; at most 2 units, and the ss charge tables used as tt are refused.
; WHAT IT DOES NOT SAY. That this is PSP103: it is a TABLE MODEL of it, bilinear, at 27 C, for two device sizes, no body effect (bulk at
; the source), no Vds < 0, no Vgs < 0 (the table's range is 0 .. 1.5 V), nothing about another W, L, m, temperature, the high-voltage
; devices, mismatch or Monte Carlo. That the relative-error proposal of the issue (1 %, floor 1e-9 A) is met: it is not (see above); the
; bound is the measured one (#10881). Charge: the drain charge of the tt and ss corners only (ff, fs, sf: #10882), for a 500 fF node and a
; 100 ps step; the gate charge is tabulated and no circuit here reads it; the source and bulk charge is not tabulated (the source and bulk are
; on the rails); the 10 pF run has no charge in it (its device capacitance is 0.2 % of the load). The transient is checked for tt only, on two
; circuits of one dt / C and one input (two levels, an ideal step); the other corners are checked on Id and on the DC transfer. Nothing about a board (no bitstream, BRAM, LUT, DSP,
; Fmax, UART line), nothing about power, and no speed claim against SPICE (`may_claim_speedup` in bench.t27 says no and stays no).
; The uberWAVE deck itself is not run here, only its inverter's sizes are used. ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogMosPsp103;

use analog::linear::{fabs64};
use analog::mos_table::{CELL, NCELL, NODES, VDD, K_NEWTON, RES_BOUND, RUN_STEPS, lim, id_of, gm_cell, gds_cell, mag_diff, monotone, monotone_along, fmax64, run_fix, run_fix_q, run_tabf, run_tabf_q, max_of, board_step, inv_step, inv_step_q, g_resid_q, NOQ};
use analog::mos_psp103_data::{R2_A1, R2_A2, R2_TT_COUNT, CORNER_FF, CORNER_SS, CORNER_FS, CORNER_SF, TT_N, TT_P, SS_N, SS_P, TT_INV, TT_MID_N, TT_MID_P, TT_R2_N, TT_R2_P, INV10_BE, INV10_FINE, INV10_FINE_TPLH_FS, INV10_FINE_TPHL_FS, INV500_BE_TPLH_FS, INV500_BE_TPHL_FS, INV500_FINE_TPLH_FS, INV500_FINE_TPHL_FS, INV500_BE, TT_QD_N, TT_QG_N, TT_QD_P, TT_QG_P, SS_QD_N, SS_QG_N, SS_QD_P, SS_QG_P, OP_CDD_AF, OP_CDG_AF, OP_CGG_AF, OP_CGSOL_AF, OP_CGDOL_AF, OP_CJD_AF, table_n, table_p, inv_dc, r2_n, r2_p, r2_count};

pub const KIND : str = "analog-cell-check";
pub const ID : str = "analog/mos_psp103";
pub const REFERENCE : str = "IHP-Open-PDK 21133f21 sg13_lv_nmos/pmos (PSP103) through ngspice-47; the numbers are in mos_psp103_data.t27";

; --- units and the two time scales ------------------------------------------------------------------
/// Voltage units per volt: 2^24. M3a's grid is 24 cells of 2^20 units, here 62.5 mV a cell, so VDD (24 cells) is 1.5 V.
pub const UPV : f64 = 16777216.0;
/// dt / C in V/A: a table entry is Id * DTC * UPV units.
pub const DTC : f64 = 200.0;
/// Half the supply, 0.75 V, in units: the level the delays are taken at.
pub const HALF : f64 = 12582912.0;
/// The inverter DC sweep: 49 points, Vin = k * 2^19 units = k * 31.25 mV.
pub const DC_POINTS : u32 = 49;
pub const DC_STEP : u32 = 524288;
/// The 10 pF run: dt = 2 ns, the edges at the start of step 0 (t = 2 ns) and of step 200 (t = 402 ns), all in fs.
pub const DT_10P_FS : u32 = 2000000;
pub const EDGE1_10P_FS : u32 = 2000000;
pub const EDGE2_10P_FS : u32 = 402000000;
/// The 500 fF run: dt = 100 ps, the edges at 100 ps and 20.1 ns.
pub const DT_500F_FS : u32 = 100000;
pub const EDGE1_500F_FS : u32 = 100000;
pub const EDGE2_500F_FS : u32 = 20100000;

; --- the bounds the tt check holds the tables to -------------------------------------------------------
/// Id at the held-out points, absolute, A.
pub const B_ID_ABS_A : f64 = 0.0000007;
/// Id at the held-out points, relative error over the points with Id >= 100 uA.
pub const B_ID_B4 : f64 = 0.0052;
/// The tt inverter's DC transfer against ngspice: the largest |dVout| in units (5.5 mV), and the shift of the trip point
/// (the 0.75 V crossing) in sweep steps of 31.25 mV (12.5 uV).
pub const B_DC_UNITS : f64 = 92500.0;
pub const B_DC_VM : f64 = 0.0004;
/// The tt transient at 10 pF against ngspice backward Euler on the same grid: the largest |dY| in units (1.29 mV), and the
/// relative difference of each 50 % delay.
pub const B_TR_UNITS : f64 = 21500.0;
pub const B_DELAY_REL : f64 = 0.0018;
/// The bounds of the DC transfer in every corner.
pub const B_DC_ALL_UNITS : f64 = 112000.0;
pub const B_DC_ALL_VM : f64 = 0.0085;

/// The 500 fF check, tt, against ngspice backward Euler on the same grid: each 50 % delay within 0.05 % (the model with its own charge is 0.020 %
/// and 0.0041 % off), the waveform within 6700 units (0.40 mV) at all 401 samples. The issue asks for 1 %; this is the bound the tests hold,
/// 20 times tighter, so that a wrong corner's charge (0.13 % and 0.17 %) is seen.
pub const B_Q_DELAY_REL : f64 = 0.0005;
pub const B_Q_WAVE_UNITS : f64 = 6700.0;
/// The issue's bar for the delays: 1 %.
pub const B_ISSUE_DELAY_REL : f64 = 0.01;
/// aF per (table unit per cell): a charge table's slope read as a capacitance. 500 fF * 2^-24 V per unit, over 62.5 mV (2^20 units a cell).
pub const AF_PER_UNIT_CELL : f64 = 0.476837158203125;

; --- what the tt run must give, derived by the tests below -----------------------------------------------
/// The fold of the 400 samples of the fixed-point tt run (K_NEWTON iterations, from the DC rest value).
pub const EXP_S_TT : u64 = 0xD9E25A3AAF1D8068;
/// The same with the tt drain-charge tables, the circuit at 500 fF / 100 ps, the gate at Vdd before step 0.
pub const EXP_S_TT_Q : u64 = 0x215DC5EAC4C48576;

; --- the held-out points ----------------------------------------------------------------------------

/// A current in A from a table word.
pub fn amps_of(units: f64) -> f64 {
    return units / (DTC * UPV);
}

/// The R2 coordinate k * a, fractional part, in units of 2^-24 V over 0 .. 1.5 V.
pub fn r2_units(k: u32, a: f64) -> u32 {
    const x : f64 = (k as f64) * a;
    const f : f64 = x - ((x as u32) as f64);
    return lim(((f * 1.5 * UPV) + 0.5) as u32);
}

/// Vgs (Vsg) of held-out point idx: kind 0 is the cell midpoints (idx = i * 24 + j, the middle of cell i along Vgs), kind 1
/// the R2 points (idx 0 is point k = 1).
pub fn pt_vg(kind: u32, idx: u32) -> u32 {
    if (kind == 0) { return (idx / NCELL) * CELL + (CELL >> 1); }
    return r2_units(idx + 1, R2_A1);
}

/// Vds (Vsd) of held-out point idx.
pub fn pt_vd(kind: u32, idx: u32) -> u32 {
    if (kind == 0) { return (idx % NCELL) * CELL + (CELL >> 1); }
    return r2_units(idx + 1, R2_A2);
}

pub struct Hold { abs_a: f64, rel9: f64, b6: f64, b5: f64, b4: f64, n6: u32, n5: u32, n4: u32 }

/// The table t against the ngspice currents ref_pa (pA) at the first n held-out points of a kind: the largest absolute error in
/// A; the largest relative error with a floor of 1e-9 A on the reference (the issue's measure); and the largest relative error
/// over the points whose reference current is at least 1e-6, 1e-5 and 1e-4 A, with the number of such points.
pub fn hold_stats(t: []const u32, ref_pa: []const u32, kind: u32, n: u32) -> Hold {
    var abs_a : f64 = 0.0;
    var rel9 : f64 = 0.0;
    var b6 : f64 = 0.0;
    var b5 : f64 = 0.0;
    var b4 : f64 = 0.0;
    var n6 : u32 = 0;
    var n5 : u32 = 0;
    var n4 : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        const tab : f64 = amps_of((id_of(t, pt_vg(kind, i), pt_vd(kind, i))) as f64);
        const want : f64 = ((ref_pa[i as usize]) as f64) * 0.000000000001;
        const e : f64 = fabs64(tab - want);
        abs_a = fmax64(abs_a, e);
        rel9 = fmax64(rel9, e / fmax64(want, 0.000000001));
        if (want >= 0.000001) { b6 = fmax64(b6, e / want); n6 = n6 + 1; }
        if (want >= 0.00001) { b5 = fmax64(b5, e / want); n5 = n5 + 1; }
        if (want >= 0.0001) { b4 = fmax64(b4, e / want); n4 = n4 + 1; }
        i = i + 1;
    }
    return Hold { abs_a: abs_a, rel9: rel9, b6: b6, b5: b5, b4: b4, n6: n6, n5: n5, n4: n4 };
}

; --- the inverter ---------------------------------------------------------------------------------

/// The DC output of the inverter for gate a: the largest y at which the NMOS current at (a, y) does not exceed the PMOS current
/// at (Vdd - a, Vdd - y). Bisection on the integer table reads: the NMOS current rises with y and the PMOS current falls.
pub fn dc_out(tn: []const u32, tp: []const u32, a: u32) -> u32 {
    var lo : u32 = 0;
    var hi : u32 = VDD;
    while (hi - lo > 1) {
        const mid : u32 = lo + ((hi - lo) >> 1);
        if (id_of(tn, a, mid) > id_of(tp, VDD - a, VDD - mid)) { hi = mid; } else { lo = mid; }
    }
    return lo;
}

/// A word slice as reals: dst[i] = src[i], i < n.
pub fn lift_u32(src: []const u32, n: u32, dst: []f64) {
    var i : u32 = 0;
    while (i < n) {
        dst[i as usize] = (src[i as usize]) as f64;
        i = i + 1;
    }
}

/// A run as a series: dst[0] = the rest value, dst[1 + k] = out[k] (the output after step k), k < 400.
pub fn shift_run(rest: f64, out: []const f64, dst: []f64) {
    dst[0] = rest;
    var i : u32 = 0;
    while (i < RUN_STEPS) {
        dst[(i + 1) as usize] = out[i as usize];
        i = i + 1;
    }
}

/// The first crossing of level by sig between index from and index to, by linear interpolation between neighbours, as a
/// fractional index; -1.0 when there is none. Rising: below level, then at or above; falling: above, then at or below.
pub fn cross_idx(sig: []const f64, level: f64, rising: bool, from: u32, to: u32) -> f64 {
    var i : u32 = from + 1;
    while (i <= to) {
        const a : f64 = sig[(i - 1) as usize];
        const b : f64 = sig[i as usize];
        if (rising and a < level and b >= level) { return ((i - 1) as f64) + (level - a) / (b - a); }
        if (rising == false and a > level and b <= level) { return ((i - 1) as f64) + (a - level) / (a - b); }
        i = i + 1;
    }
    return 0.0 - 1.0;
}

/// The largest |a[i] - b[i]|, i < n.
pub fn max_diff(a: []const f64, b: []const f64, n: u32) -> f64 {
    var m : f64 = 0.0;
    var i : u32 = 0;
    while (i < n) {
        m = fmax64(m, fabs64(a[i as usize] - b[i as usize]));
        i = i + 1;
    }
    return m;
}

/// The rising delay of a 401-point series in steps: the 0.75 V crossing after the edge at index 0.
pub fn delay_up(sig: []const f64) -> f64 {
    return cross_idx(sig, HALF, true, 0, 200);
}

/// The falling delay in steps: the 0.75 V crossing after the edge at index 200.
pub fn delay_dn(sig: []const f64) -> f64 {
    return cross_idx(sig, HALF, false, 200, 400) - 200.0;
}

/// A delay in steps from ngspice's absolute crossing time in fs, the edge time and the grid in fs.
pub fn steps_of_fs(cross_fs: u32, edge_fs: u32, dt_fs: u32) -> f64 {
    return ((cross_fs - edge_fs) as f64) / (dt_fs as f64);
}

/// |a - b| / b.
pub fn rel_gap(a: f64, b: f64) -> f64 {
    return fabs64(a - b) / b;
}

pub struct Dc { worst: f64, vm_model: f64, vm_ref: f64 }

/// The inverter's DC transfer from the tables against ngspice's refv (49 points): the largest |dVout| in units, and the trip
/// point (the 0.75 V crossing, in sweep steps) of each.
pub fn dc_check(tn: []const u32, tp: []const u32, refv: []const u32) -> Dc {
    var model : [49]f64 = [0.0] ** 49;
    var refd : [49]f64 = [0.0] ** 49;
    var worst : f64 = 0.0;
    var k : u32 = 0;
    while (k < DC_POINTS) {
        model[k as usize] = (dc_out(tn, tp, k * DC_STEP)) as f64;
        refd[k as usize] = (refv[k as usize]) as f64;
        worst = fmax64(worst, fabs64(model[k as usize] - refd[k as usize]));
        k = k + 1;
    }
    return Dc { worst: worst, vm_model: cross_idx(&model, HALF, false, 0, 48), vm_ref: cross_idx(&refd, HALF, false, 0, 48) };
}

pub struct Check { id_abs: f64, id_b4: f64, dc_worst: f64, dc_vm: f64, tr_max: f64, up_rel: f64, dn_rel: f64 }

/// The whole tt check for an NMOS table tn and a PMOS table tp: Id against the 1000 held-out R2 points of each device; the DC
/// transfer against ngspice tt; the f64 model of the 10 pF transient against ngspice tt backward Euler on the same grid.
pub fn check_tt(tn: []const u32, tp: []const u32) -> Check {
    const hn : Hold = hold_stats(tn, &TT_R2_N, 1, 1000);
    const hp : Hold = hold_stats(tp, &TT_R2_P, 1, 1000);
    const d : Dc = dc_check(tn, tp, &TT_INV);
    var outf : [400]f64 = [0.0] ** 400;
    var fl : [401]f64 = [0.0] ** 401;
    var be : [401]f64 = [0.0] ** 401;
    const rest : u32 = dc_out(tn, tp, VDD);
    run_tabf(tn, tp, K_NEWTON, rest as f64, &outf);
    shift_run(rest as f64, &outf, &fl);
    lift_u32(&INV10_BE, 401, &be);
    return Check { id_abs: fmax64(hn.abs_a, hp.abs_a), id_b4: fmax64(hn.b4, hp.b4), dc_worst: d.worst, dc_vm: fabs64(d.vm_model - d.vm_ref), tr_max: max_diff(&fl, &be, 401), up_rel: rel_gap(delay_up(&fl), delay_up(&be)), dn_rel: rel_gap(delay_dn(&fl), delay_dn(&be)) };
}

/// Is every measure of a check inside the tt bounds?
pub fn check_ok(id_abs: f64, id_b4: f64, dc_worst: f64, dc_vm: f64, tr_max: f64, up_rel: f64, dn_rel: f64) -> bool {
    if (id_abs > B_ID_ABS_A) { return false; }
    if (id_b4 > B_ID_B4) { return false; }
    if (dc_worst > B_DC_UNITS) { return false; }
    if (dc_vm > B_DC_VM) { return false; }
    if (tr_max > B_TR_UNITS) { return false; }
    if (up_rel > B_DELAY_REL) { return false; }
    if (dn_rel > B_DELAY_REL) { return false; }
    return true;
}

; --- the 500 fF check with charge (M3c) -------------------------------------------------------------

pub struct CheckQ { up_rel: f64, dn_rel: f64, wave: f64 }

/// The 500 fF check, M3c: the f64 model of the inverter built from the current tables tn, tp and the drain-charge tables qn, qp
/// (the gate before step 0 at Vdd) against ngspice's tt backward Euler at 500 fF and 100 ps on the same grid: the relative gap of
/// each 50 % delay to ngspice's own .meas crossing, and the largest |dY| of the 401 samples in units.
pub fn check_q(tn: []const u32, tp: []const u32, qn: []const u32, qp: []const u32) -> CheckQ {
    var outf : [400]f64 = [0.0] ** 400;
    var fl : [401]f64 = [0.0] ** 401;
    var be : [401]f64 = [0.0] ** 401;
    const rest : u32 = dc_out(tn, tp, VDD);
    run_tabf_q(tn, tp, qn, qp, K_NEWTON, rest as f64, VDD, &outf);
    shift_run(rest as f64, &outf, &fl);
    lift_u32(&INV500_BE, 401, &be);
    return CheckQ { up_rel: rel_gap(delay_up(&fl), steps_of_fs(INV500_BE_TPLH_FS, EDGE1_500F_FS, DT_500F_FS)), dn_rel: rel_gap(delay_dn(&fl), steps_of_fs(INV500_BE_TPHL_FS, EDGE2_500F_FS, DT_500F_FS)), wave: max_diff(&fl, &be, 401) };
}

/// Is every measure of a 500 fF check inside the bounds?
pub fn check_q_ok(up_rel: f64, dn_rel: f64, wave: f64) -> bool {
    if (up_rel > B_Q_DELAY_REL) { return false; }
    if (dn_rel > B_Q_DELAY_REL) { return false; }
    if (wave > B_Q_WAVE_UNITS) { return false; }
    return true;
}

/// How many of the 576 cells of a table have the interpolant's movement across the cell equal to the cell's slope, within the 2 units
/// of the two reads and the slope's rounding: ax 1 across a cell of Vds against `gds_cell`, ax 0 across a cell of Vgs against
/// `gm_cell`. For a table nondecreasing along that axis. The slope is read off the same nodes as the value (FR-002).
pub fn slope_cells_ok(t: []const u32, ax: u32) -> u32 {
    var ok : u32 = 0;
    var cx : u32 = 0;
    while (cx < NCELL) {
        const fx : u32 = (cx * 977 + 31) % CELL;
        var cy : u32 = 0;
        while (cy < NCELL) {
            const fy : u32 = (cy * 4093 + 17) % CELL;
            if (ax == 1) {
                const dy : u32 = id_of(t, cx * CELL + fx, (cy + 1) * CELL) - id_of(t, cx * CELL + fx, cy * CELL);
                if (mag_diff(dy, gds_cell(t, cx * CELL + fx, cy * CELL + 12345)) <= 2) { ok = ok + 1; }
            } else {
                const dx : u32 = id_of(t, (cx + 1) * CELL, cy * CELL + fy) - id_of(t, cx * CELL, cy * CELL + fy);
                if (mag_diff(dx, gm_cell(t, cx * CELL + 12345, cy * CELL + fy)) <= 2) { ok = ok + 1; }
            }
            cy = cy + 1;
        }
        cx = cx + 1;
    }
    return ok;
}

/// A charge table's slope across one cell as a capacitance in aF: the node values a (at the lower node) and b (at the upper), as the
/// signed difference b - a in table units (a charge table that falls with the axis gives a negative capacitance).
pub fn cap_af(a: u32, b: u32) -> f64 {
    return (((b as f64) - (a as f64)) * AF_PER_UNIT_CELL);
}

/// The largest |a[i] - b[i]| over the 625 entries of two tables, as a fraction of the range (largest minus smallest entry) of a.
pub fn table_gap_of_range(a: []const u32, b: []const u32) -> f64 {
    var lo : u32 = a[0];
    var hi : u32 = a[0];
    var gap : u32 = 0;
    var i : u32 = 0;
    while (i < 625) {
        const x : u32 = a[i as usize];
        const y : u32 = b[i as usize];
        if (x < lo) { lo = x; }
        if (x > hi) { hi = x; }
        const d : u32 = mag_diff(x, y);
        if (d > gap) { gap = d; }
        i = i + 1;
    }
    return (gap as f64) / ((hi - lo) as f64);
}

; --- the tests ----------------------------------------------------------------------------------

test the_units_the_grid_and_the_held_out_points_agree_with_m3a_and_the_decks {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var upv : f64 = UPV;
    var cell : u32 = CELL;
    var vdd : u32 = VDD;
    var half : f64 = HALF;
    var step : u32 = DC_STEP;
    var npts : u32 = DC_POINTS;
    var dtc : f64 = DTC;
    var ncell : u32 = NCELL;
    var nodes : u32 = NODES;
    assert_eq(cell, 1048576);
    assert_eq(vdd, ncell * cell);
    assert_eq(nodes, ncell + 1);
    assert_eq(step * 2, cell);
    assert_eq(npts, 2 * ncell + 1);
    assert_eq((vdd as f64) / upv, 1.5);
    assert_eq(half * 2.0, (vdd as f64));
    assert_eq((cell as f64) / upv, 0.0625);
    // A table word is 0.298 nA: 1 / (200 * 2^24) A.
    const one : f64 = amps_of(1.0) * dtc * upv - 1.0;
    assert one * one < 0.000000000001;
    assert amps_of(1.0) > 0.00000000029;
    assert amps_of(1.0) < 0.0000000003;
    // The deck prints the R2 points' coordinates; the spec computes them with the same two numbers and rounds to units
    // (59.6 nV), so they agree to a unit: points k = 1 and 2, Vgs and Vds.
    const a1 : f64 = (r2_units(1, R2_A1) as f64) / upv - 1.1323164994;
    const a2 : f64 = (r2_units(1, R2_A2) as f64) / upv - 0.8547604365;
    const b1 : f64 = (r2_units(2, R2_A1) as f64) / upv - 0.76463299875;
    const b2 : f64 = (r2_units(2, R2_A2) as f64) / upv - 0.20952087300;
    assert a1 * a1 < 0.00000006 * 0.00000006;
    assert a2 * a2 < 0.00000006 * 0.00000006;
    assert b1 * b1 < 0.00000006 * 0.00000006;
    assert b2 * b2 < 0.00000006 * 0.00000006;
    assert_eq(r2_units(1, R2_A1), 18997118);
    assert_eq(pt_vg(1, 0), 18997118);
    assert_eq(pt_vd(1, 0), 14340500);
    // Every R2 point is inside the table's range, and the midpoints are the middle of a cell.
    var k : u32 = 0;
    while (k < R2_TT_COUNT) {
        assert pt_vg(1, k) <= vdd;
        assert pt_vd(1, k) <= vdd;
        k = k + 1;
    }
    assert_eq(pt_vg(0, 25), cell + (cell >> 1));
    assert_eq(pt_vd(0, 25), cell + (cell >> 1));
    assert_eq(pt_vg(0, 575), 23 * cell + (cell >> 1));
    assert_eq(pt_vd(0, 24), cell >> 1);
}

test every_corner_has_monotone_tables_zero_at_vds_0_and_inside_the_u64_bound {
    var c : u32 = 0;
    var checked : u32 = 0;
    while (c < 5) {
        assert(monotone(table_n(c)));
        assert(monotone(table_p(c)));
        var ix : u32 = 0;
        while (ix < NODES) {
            // Vds = 0: no current (the gate leakage out of the drain, a few units, was held at 0 by the deck).
            assert_eq(table_n(c)[(ix * NODES) as usize], 0);
            assert_eq(table_p(c)[(ix * NODES) as usize], 0);
            ix = ix + 1;
        }
        // The off current (Vgs = 0, Vds = 1.5 V) is at most 10 units, 3 nA, in every corner.
        assert table_n(c)[24] <= 10;
        assert table_p(c)[24] <= 10;
        // The largest entry is the corner (1.5 V, 1.5 V): 342 .. 458 uA for the NMOS, 281 .. 330 uA for the PMOS, and inside the
        // 2^23 the u64 interpolation allows.
        assert table_n(c)[624] > 1100000;
        assert table_n(c)[624] < 1600000;
        assert table_p(c)[624] > 900000;
        assert table_p(c)[624] < 1150000;
        var j : u32 = 0;
        while (j < 625) {
            assert table_n(c)[j as usize] <= table_n(c)[624];
            assert table_p(c)[j as usize] <= table_p(c)[624];
            j = j + 1;
        }
        checked = checked + 1;
        c = c + 1;
    }
    assert_eq(checked, 5);
}

test gm_and_gds_come_from_the_same_table_in_every_corner {
    // FR-002. Across one whole cell of Vds the interpolant moves by exactly gds_cell, across one of Vgs by exactly gm_cell (the
    // two reads and the slope each round, so 2 units): the slope is read off the same nodes as the value. All 576 cells, both
    // devices, the five corners.
    var c : u32 = 0;
    var cells : u32 = 0;
    while (c < 5) {
        var dev : u32 = 0;
        while (dev < 2) {
            var cx : u32 = 0;
            while (cx < NCELL) {
                const fx : u32 = (cx * 977 + 31) % CELL;
                var cy : u32 = 0;
                while (cy < NCELL) {
                    const fy : u32 = (cy * 4093 + 17) % CELL;
                    if (dev == 0) {
                        const dy : u32 = id_of(table_n(c), cx * CELL + fx, (cy + 1) * CELL) - id_of(table_n(c), cx * CELL + fx, cy * CELL);
                        assert mag_diff(dy, gds_cell(table_n(c), cx * CELL + fx, cy * CELL + 12345)) <= 2;
                        const dx : u32 = id_of(table_n(c), (cx + 1) * CELL, cy * CELL + fy) - id_of(table_n(c), cx * CELL, cy * CELL + fy);
                        assert mag_diff(dx, gm_cell(table_n(c), cx * CELL + 12345, cy * CELL + fy)) <= 2;
                    } else {
                        const dy : u32 = id_of(table_p(c), cx * CELL + fx, (cy + 1) * CELL) - id_of(table_p(c), cx * CELL + fx, cy * CELL);
                        assert mag_diff(dy, gds_cell(table_p(c), cx * CELL + fx, cy * CELL + 12345)) <= 2;
                        const dx : u32 = id_of(table_p(c), (cx + 1) * CELL, cy * CELL + fy) - id_of(table_p(c), cx * CELL, cy * CELL + fy);
                        assert mag_diff(dx, gm_cell(table_p(c), cx * CELL + 12345, cy * CELL + fy)) <= 2;
                    }
                    cells = cells + 1;
                    cy = cy + 1;
                }
                cx = cx + 1;
            }
            dev = dev + 1;
        }
        // Spot values: strong inversion has gm, the triode region has gds, saturation is nearly flat in Vds (gds there is a
        // tenth of the triode value or less), and at Vgs = 62.5 mV, far below threshold, gm is a hundredth of that at 1.25 V.
        assert gm_cell(table_n(c), 20 * CELL, 10 * CELL) > 50000;
        assert gds_cell(table_n(c), 20 * CELL, CELL) > 50000;
        assert gds_cell(table_n(c), 20 * CELL, 22 * CELL) < gds_cell(table_n(c), 20 * CELL, CELL) / 10;
        assert gm_cell(table_n(c), CELL, 10 * CELL) < gm_cell(table_n(c), 20 * CELL, 10 * CELL) / 100;
        c = c + 1;
    }
    assert_eq(cells, 5760);
}

test the_tt_tables_at_the_held_out_points_against_ngspice {
    const mn : Hold = hold_stats(&TT_N, &TT_MID_N, 0, 576);
    const mp : Hold = hold_stats(&TT_P, &TT_MID_P, 0, 576);
    const rn : Hold = hold_stats(&TT_N, &TT_R2_N, 1, 1000);
    const rp : Hold = hold_stats(&TT_P, &TT_R2_P, 1, 1000);
    // Absolute error, A, over the 576 midpoints and the 1000 R2 points: the NMOS 6.51e-7 (0.16 % of its 402 uA), the PMOS
    // 4.39e-7 (0.15 % of 301 uA). Both sides.
    assert mn.abs_a < 0.00000066;
    assert mn.abs_a > 0.00000064;
    assert rn.abs_a < 0.00000066;
    assert rn.abs_a > 0.00000064;
    assert mp.abs_a < 0.00000045;
    assert mp.abs_a > 0.00000043;
    assert rp.abs_a < 0.00000045;
    assert rp.abs_a > 0.00000043;
    // Relative error where the current is at least 100 uA: 0.56 % (NMOS) and 0.41 % (PMOS), under the proposed 1 %.
    assert mn.b4 < 0.0057;
    assert mn.b4 > 0.0054;
    assert rn.b4 < 0.0049;
    assert rn.b4 > 0.0046;
    assert mp.b4 < 0.0042;
    assert mp.b4 > 0.0040;
    assert rp.b4 < 0.0040;
    assert rp.b4 > 0.0038;
    // At least 10 uA: 4.3 % and 3.2 %. At least 1 uA: 21 % and 17 %. The points are many enough to mean it.
    assert mn.b5 < 0.0430;
    assert mn.b5 > 0.0420;
    assert mp.b5 < 0.0320;
    assert mp.b5 > 0.0310;
    assert rn.b6 < 0.2100;
    assert rn.b6 > 0.2085;
    assert rp.b6 < 0.1675;
    assert rp.b6 > 0.1660;
    assert mn.n4 > 200;
    assert mp.n4 > 150;
    assert rn.n4 > 350;
    assert rp.n4 > 250;
    assert rn.n6 > 700;
    // The issue's measure, relative error with a floor of 1e-9 A, is 0.55 .. 0.73: the proposed 1 % is NOT met, and cannot be
    // by a chord over a 62.5 mV cell. In weak inversion Id grows a factor of about 6 per cell, where a chord at the midpoint
    // is 43 % off, and below a few nA the table's own rounding to 0.298 nA is a tenth of the current.
    assert mn.rel9 > 0.5;
    assert mn.rel9 < 0.6;
    assert rn.rel9 > 0.01;
    assert rn.rel9 < 0.7;
    assert rp.rel9 > 0.7;
    assert rp.rel9 < 0.75;
    assert mp.rel9 > 0.6;
    assert mp.rel9 < 0.65;
}

test the_other_four_corners_at_their_own_held_out_points {
    var c : u32 = 0;
    var worst_an : f64 = 0.0;
    var worst_ap : f64 = 0.0;
    var worst_bn : f64 = 0.0;
    var worst_bp : f64 = 0.0;
    var counted : u32 = 0;
    while (c < 5) {
        const hn : Hold = hold_stats(table_n(c), r2_n(c), 1, r2_count(c));
        const hp : Hold = hold_stats(table_p(c), r2_p(c), 1, r2_count(c));
        worst_an = fmax64(worst_an, hn.abs_a);
        worst_ap = fmax64(worst_ap, hp.abs_a);
        worst_bn = fmax64(worst_bn, hn.b4);
        worst_bp = fmax64(worst_bp, hp.b4);
        // Each corner has points above 100 uA to take the relative error over.
        assert hn.n4 >= 20;
        assert hp.n4 >= 20;
        assert hn.abs_a < 0.0000007;
        assert hp.abs_a < 0.00000045;
        assert hn.b4 < 0.0052;
        assert hp.b4 < 0.0042;
        counted = counted + 1;
        c = c + 1;
    }
    assert_eq(counted, 5);
    // The worst over the five corners, both sides: the same order as tt, which is the biggest by absolute error of the NMOS.
    assert worst_an < 0.00000066;
    assert worst_an > 0.00000064;
    assert worst_ap < 0.00000045;
    assert worst_ap > 0.00000043;
    assert worst_bn < 0.0050;
    assert worst_bn > 0.0046;
    assert worst_bp < 0.0041;
    assert worst_bp > 0.0037;
}

test the_inverter_dc_transfer_against_ngspice_in_every_corner {
    var c : u32 = 0;
    var worst : f64 = 0.0;
    var worst_vm : f64 = 0.0;
    var counted : u32 = 0;
    var last_vm : f64 = 0.0;
    while (c < 5) {
        const d : Dc = dc_check(table_n(c), table_p(c), inv_dc(c));
        const shift : f64 = fabs64(d.vm_model - d.vm_ref);
        worst = fmax64(worst, d.worst);
        worst_vm = fmax64(worst_vm, shift);
        assert d.worst < B_DC_ALL_UNITS;
        assert shift < B_DC_ALL_VM;
        // The trip point is a real crossing, between 20 and 24 sweep steps (0.625 .. 0.75 V).
        assert d.vm_ref > 20.0;
        assert d.vm_model > 20.0;
        assert d.vm_model < 24.0;
        counted = counted + 1;
        c = c + 1;
    }
    assert_eq(counted, 5);
    // Both sides.
    assert worst > 105000.0;
    assert worst_vm > 0.0078;
    // tt in detail: 5.5 mV at the worst place (the steep part, where a 0.3 mV input error is a 5 mV output error), the trip
    // point within 12 uV.
    const t : Dc = dc_check(&TT_N, &TT_P, &TT_INV);
    assert t.worst < B_DC_UNITS;
    assert t.worst > 91000.0;
    assert fabs64(t.vm_model - t.vm_ref) < B_DC_VM;
    assert fabs64(t.vm_model - t.vm_ref) > 0.0003;
    // The corners are where the foundry puts them: fs (fast NMOS) trips low, sf high, ss above tt and ff below.
    const ff : Dc = dc_check(table_n(CORNER_FF), table_p(CORNER_FF), inv_dc(CORNER_FF));
    const ss : Dc = dc_check(table_n(CORNER_SS), table_p(CORNER_SS), inv_dc(CORNER_SS));
    const fs : Dc = dc_check(table_n(CORNER_FS), table_p(CORNER_FS), inv_dc(CORNER_FS));
    const sf : Dc = dc_check(table_n(CORNER_SF), table_p(CORNER_SF), inv_dc(CORNER_SF));
    assert fs.vm_model < ff.vm_model;
    assert ff.vm_model < t.vm_model;
    assert t.vm_model < ss.vm_model;
    assert ss.vm_model < sf.vm_model;
    assert fs.vm_ref < ff.vm_ref;
    assert ff.vm_ref < t.vm_ref;
    assert t.vm_ref < ss.vm_ref;
    assert ss.vm_ref < sf.vm_ref;
}

test the_tt_inverter_transient_against_ngspice_and_the_three_errors {
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    var outf : [400]f64 = [0.0] ** 400;
    var out12 : [400]f64 = [0.0] ** 400;
    var tmp : [400]f64 = [0.0] ** 400;
    var fix : [401]f64 = [0.0] ** 401;
    var fl : [401]f64 = [0.0] ** 401;
    var be : [401]f64 = [0.0] ** 401;
    var fine : [401]f64 = [0.0] ** 401;
    const rest : u32 = dc_out(&TT_N, &TT_P, VDD);
    const s : u64 = run_fix(&TT_N, &TT_P, K_NEWTON, rest, false, &out, &res);
    run_tabf(&TT_N, &TT_P, K_NEWTON, rest as f64, &outf);
    run_tabf(&TT_N, &TT_P, 12, rest as f64, &out12);
    lift_u32(&out, 400, &tmp);
    shift_run(rest as f64, &tmp, &fix);
    shift_run(rest as f64, &outf, &fl);
    lift_u32(&INV10_BE, 401, &be);
    lift_u32(&INV10_FINE, 401, &fine);
    // The run: from the DC rest value (3 units, ngspice 11: both are zero to 0.7 uV), 400 steps, the fold pinned.
    assert_eq(rest, 3);
    assert_eq(s, EXP_S_TT);
    // Y(2 us-equivalent) is Vdd to 13 units (0.8 uV), and the run ends at the rest value again.
    assert VDD - out[199] <= 20;
    assert VDD - out[199] >= 5;
    assert out[399] < 10;
    assert out[399] > 0;
    // The residual of the last Newton iteration is at most 1 unit (59.6 nV) at every step; the bound is 2.
    assert max_of(&res) <= RES_BOUND;
    assert_eq(max_of(&res), 1);
    // K = 3 is converged on these tables: the f64 iteration at 3 and at 12 agree to far below a unit.
    var lag : f64 = 0.0;
    var i : u32 = 0;
    while (i < RUN_STEPS) {
        lag = fmax64(lag, fabs64(outf[i as usize] - out12[i as usize]));
        i = i + 1;
    }
    assert lag < 0.001;
    // THE THREE ERRORS, kept apart, in units of 59.6 nV.
    // arithmetic: the fixed-point run against the f64 run of the same iteration (same tables, same K): 4.78 units (0.28 uV).
    const arith : f64 = max_diff(&fix, &fl, 401);
    assert arith < 5.0;
    assert arith > 4.5;
    // table and model: the f64 model against ngspice backward Euler on the same grid: 21402 units (1.28 mV, 0.085 % of Vdd).
    const model : f64 = max_diff(&fl, &be, 401);
    assert model < B_TR_UNITS;
    assert model > 21300.0;
    // discretization: ngspice backward Euler at dt = 2 ns against ngspice converged: 242041 units (14.4 mV).
    const disc : f64 = max_diff(&be, &fine, 401);
    assert disc < 243000.0;
    assert disc > 241000.0;
    // The delays, in steps of 2 ns. Rising (the PMOS charges 10 pF to 0.75 V) and falling.
    const up_fix : f64 = delay_up(&fix);
    const dn_fix : f64 = delay_dn(&fix);
    const up_be : f64 = delay_up(&be);
    const dn_be : f64 = delay_dn(&be);
    const up_fine : f64 = delay_up(&fine);
    const dn_fine : f64 = delay_dn(&fine);
    // the arithmetic costs no delay: fixed point and f64 agree to a hundred-thousandth of a step.
    assert fabs64(up_fix - delay_up(&fl)) < 0.00001;
    assert fabs64(dn_fix - delay_dn(&fl)) < 0.00001;
    // table and model: 0.142 % and 0.172 % (37 ps and 34 ps), both sides, within the bound stated.
    assert rel_gap(up_fix, up_be) < B_DELAY_REL;
    assert rel_gap(dn_fix, dn_be) < B_DELAY_REL;
    assert rel_gap(up_fix, up_be) < 0.00145;
    assert rel_gap(up_fix, up_be) > 0.00139;
    assert rel_gap(dn_fix, dn_be) < 0.00175;
    assert rel_gap(dn_fix, dn_be) > 0.00168;
    // discretization: backward Euler at 2 ns is 0.51 % and 0.66 % longer than the converged run.
    assert rel_gap(up_be, up_fine) < 0.0052;
    assert rel_gap(up_be, up_fine) > 0.0050;
    assert rel_gap(dn_be, dn_fine) < 0.0067;
    assert rel_gap(dn_be, dn_fine) > 0.0065;
    assert up_be > up_fine;
    assert dn_be > dn_fine;
    // The converged delay as ngspice itself measures it (.meas, six digits), not read off the 2 ns samples: 25.9437 ns and
    // 19.527 ns. The 2 ns samples read it within 0.003 step, so the comparison above is fair.
    const up_meas : f64 = steps_of_fs(INV10_FINE_TPLH_FS, EDGE1_10P_FS, DT_10P_FS);
    const dn_meas : f64 = steps_of_fs(INV10_FINE_TPHL_FS, EDGE2_10P_FS, DT_10P_FS);
    assert fabs64(up_fine - up_meas) < 0.001;
    assert fabs64(dn_fine - dn_meas) < 0.004;
    // All three errors together, the fixed-point model against ngspice's converged run: 0.37 % and 0.51 % of the delay
    // (0.095 ns and 0.100 ns): the scheme's error and the model's partly cancel (the table model is faster, backward Euler slower).
    assert rel_gap(up_fix, up_meas) < 0.0037;
    assert rel_gap(up_fix, up_meas) > 0.0036;
    assert rel_gap(dn_fix, dn_meas) < 0.0052;
    assert rel_gap(dn_fix, dn_meas) > 0.0050;
    // In ns: 26.04 and 19.63 against ngspice's 25.94 and 19.53.
    assert up_fix * 2.0 > 26.0;
    assert up_fix * 2.0 < 26.1;
    assert dn_fix * 2.0 > 19.6;
    assert dn_fix * 2.0 < 19.7;
}

test the_missing_charge_shows_at_500_fF_and_the_gap_scales_with_one_over_c {
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    var tmp : [400]f64 = [0.0] ** 400;
    var fix : [401]f64 = [0.0] ** 401;
    var be : [401]f64 = [0.0] ** 401;
    const rest : u32 = dc_out(&TT_N, &TT_P, VDD);
    const s : u64 = run_fix(&TT_N, &TT_P, K_NEWTON, rest, false, &out, &res);
    lift_u32(&out, 400, &tmp);
    shift_run(rest as f64, &tmp, &fix);
    lift_u32(&INV10_BE, 401, &be);
    assert_eq(s, EXP_S_TT);
    // The same 400 steps, dimensionless, against the same circuit at 500 fF and 100 ps (dt / C = 200 V/A again).
    const up_be5 : f64 = steps_of_fs(INV500_BE_TPLH_FS, EDGE1_500F_FS, DT_500F_FS);
    const dn_be5 : f64 = steps_of_fs(INV500_BE_TPHL_FS, EDGE2_500F_FS, DT_500F_FS);
    const up_fine5 : f64 = steps_of_fs(INV500_FINE_TPLH_FS, EDGE1_500F_FS, DT_500F_FS);
    const dn_fine5 : f64 = steps_of_fs(INV500_FINE_TPHL_FS, EDGE2_500F_FS, DT_500F_FS);
    const up_fix : f64 = delay_up(&fix);
    const dn_fix : f64 = delay_dn(&fix);
    const g5u : f64 = rel_gap(up_fix, up_be5);
    const g5d : f64 = rel_gap(dn_fix, dn_be5);
    const g10u : f64 = rel_gap(up_fix, delay_up(&be));
    const g10d : f64 = rel_gap(dn_fix, delay_dn(&be));
    // At 500 fF the table model is 3.09 % and 3.63 % faster than ngspice: the device capacitances (gate-drain, drain
    // junctions: a few fF to some ten fF) are a few percent of the load, and the model has none.
    assert g5u < 0.0315;
    assert g5u > 0.0305;
    assert g5d < 0.0368;
    assert g5d > 0.0358;
    assert up_fix < up_be5;
    assert dn_fix < dn_be5;
    // The gap grows 21.8 and 21.1 times for a load 20 times smaller: it scales with 1 / C, so it is the capacitance and not the
    // table (which does not know C), and nearly all of the 0.14 % and 0.17 % at 10 pF is the same missing charge.
    assert g5u / g10u > 20.0;
    assert g5u / g10u < 23.0;
    assert g5d / g10d > 20.0;
    assert g5d / g10d < 22.5;
    // The scheme's own error does not depend on C: backward Euler is 0.52 % and 0.67 % longer than the converged run at
    // 500 fF as at 10 pF.
    assert rel_gap(up_be5, up_fine5) < 0.0054;
    assert rel_gap(up_be5, up_fine5) > 0.0050;
    assert rel_gap(dn_be5, dn_fine5) < 0.0069;
    assert rel_gap(dn_be5, dn_fine5) > 0.0065;
}

test the_ss_tables_used_where_tt_is_expected_fail_the_check {
    // THE NEGATIVE CONTROL. The check is the tt check: Id against ngspice tt at the held-out points, the DC transfer and the
    // 10 pF transient against ngspice tt. The tt tables pass it; the ss tables (a slower NMOS and PMOS, 15 % and 7 % less
    // current) fail it on every measure, by a factor of 36 to 830 over the bound.
    const g : Check = check_tt(&TT_N, &TT_P);
    assert check_ok(g.id_abs, g.id_b4, g.dc_worst, g.dc_vm, g.tr_max, g.up_rel, g.dn_rel);
    const b : Check = check_tt(&SS_N, &SS_P);
    assert check_ok(b.id_abs, b.id_b4, b.dc_worst, b.dc_vm, b.tr_max, b.up_rel, b.dn_rel) == false;
    assert b.id_abs > 50.0 * B_ID_ABS_A;
    assert b.id_b4 > 30.0 * B_ID_B4;
    assert b.dc_worst > 40.0 * B_DC_UNITS;
    assert b.dc_vm > 500.0 * B_DC_VM;
    assert b.tr_max > 70.0 * B_TR_UNITS;
    assert b.up_rel > 30.0 * B_DELAY_REL;
    assert b.dn_rel > 80.0 * B_DELAY_REL;
    // In engineering terms: 59 uA at a held-out point, 4.74e6 units (283 mV) of DC output, 0.33 sweep step (10.3 mV) of trip
    // point, 112 mV on the waveform, 6.5 % and 16 % of the delay.
    assert b.id_abs > 0.00005;
    assert b.dc_worst > 4000000.0;
    assert b.dc_vm > 0.3;
    assert b.tr_max > 1800000.0;
    assert b.up_rel > 0.06;
    assert b.dn_rel > 0.15;
    // Each other corner used as tt fails too (ff, fs, sf: a fast NMOS, a fast NMOS with a slow PMOS, the reverse).
    var c : u32 = 1;
    var refused : u32 = 0;
    while (c < 5) {
        const x : Check = check_tt(table_n(c), table_p(c));
        assert check_ok(x.id_abs, x.id_b4, x.dc_worst, x.dc_vm, x.tr_max, x.up_rel, x.dn_rel) == false;
        assert x.dc_vm > 100.0 * B_DC_VM;
        assert x.tr_max > 20.0 * B_TR_UNITS;
        refused = refused + 1;
        c = c + 1;
    }
    assert_eq(refused, 4);
}

test the_tables_in_the_wrong_slots_fail_the_check {
    // The PMOS table where the NMOS table belongs and the reverse: every measure is over its bound, most by a factor of 100 or
    // more (trip point 3.9 steps = 121 mV off, DC output 1.2 V off).
    const w : Check = check_tt(&TT_P, &TT_N);
    assert check_ok(w.id_abs, w.id_b4, w.dc_worst, w.dc_vm, w.tr_max, w.up_rel, w.dn_rel) == false;
    assert w.id_abs > 100.0 * B_ID_ABS_A;
    assert w.id_b4 > 100.0 * B_ID_B4;
    assert w.dc_worst > 200.0 * B_DC_UNITS;
    assert w.dc_vm > 3.0;
    assert w.tr_max > 150.0 * B_TR_UNITS;
    assert w.up_rel > 100.0 * B_DELAY_REL;
    assert w.dn_rel > 150.0 * B_DELAY_REL;
}

test one_newton_iteration_breaks_the_residual_bound_on_these_tables {
    // K = 1 leaves 8586 units (0.51 mV) of residual against the bound of 2; K = 2 already meets it (1 unit), and the board's
    // K = 3 has a margin. The run is the same one, from the DC rest value.
    var out1 : [400]u32 = [0] ** 400;
    var res1 : [400]u32 = [0] ** 400;
    var out2 : [400]u32 = [0] ** 400;
    var res2 : [400]u32 = [0] ** 400;
    var out3 : [400]u32 = [0] ** 400;
    var res3 : [400]u32 = [0] ** 400;
    const rest : u32 = dc_out(&TT_N, &TT_P, VDD);
    const s1 : u64 = run_fix(&TT_N, &TT_P, 1, rest, false, &out1, &res1);
    const s2 : u64 = run_fix(&TT_N, &TT_P, 2, rest, false, &out2, &res2);
    const s3 : u64 = run_fix(&TT_N, &TT_P, K_NEWTON, rest, false, &out3, &res3);
    assert max_of(&res1) > RES_BOUND;
    assert max_of(&res1) > 8000;
    assert max_of(&res1) < 9000;
    assert max_of(&res2) <= RES_BOUND;
    assert max_of(&res3) <= RES_BOUND;
    assert s1 != EXP_S_TT;
    assert s3 == EXP_S_TT;
    // The board step is the K_NEWTON loop of inv_step, with two tables now.
    assert_eq(board_step(&TT_N, &TT_P, 9000000, 5000000), inv_step(&TT_N, &TT_P, 9000000, 5000000, K_NEWTON));
    assert_eq(board_step(&TT_N, &TT_P, 9000000, VDD), inv_step(&TT_N, &TT_P, 9000000, VDD, K_NEWTON));
    assert board_step(&TT_N, &TT_P, 9000000, VDD) < 9000000;
    assert board_step(&TT_N, &TT_P, 9000000, 0) > 9000000;
    assert s2 != s1;
}

test the_charge_tables_are_capacitances_read_off_one_table_and_agree_with_ngspices_own_op_point {
    // THE SHAPE. A drain table grows with Vds and a gate table with Vgs (capacitances are positive), in both corners, for both
    // devices (the PMOS tables are stored negated, so they grow with Vsd and Vsg). And the other axis does NOT grow: the drain
    // charge falls as the gate rises (the gate-drain coupling, the Miller kick), the gate charge falls as the drain rises.
    assert(monotone_along(&TT_QD_N, 1));
    assert(monotone_along(&TT_QD_P, 1));
    assert(monotone_along(&TT_QG_N, 0));
    assert(monotone_along(&TT_QG_P, 0));
    assert(monotone_along(&SS_QD_N, 1));
    assert(monotone_along(&SS_QD_P, 1));
    assert(monotone_along(&SS_QG_N, 0));
    assert(monotone_along(&SS_QG_P, 0));
    assert(monotone_along(&TT_QD_N, 0) == false);
    assert(monotone_along(&TT_QD_P, 0) == false);
    assert(monotone_along(&TT_QG_N, 1) == false);
    assert(monotone_along(&TT_QG_P, 1) == false);
    // FR-002. The slope the Newton step uses is read off the same table as the charge: across every one of the 576 cells of each of
    // the eight tables the interpolant moves by exactly the cell's slope (to the 2 units of the reads), 4608 cell checks.
    assert_eq(slope_cells_ok(&TT_QD_N, 1), 576);
    assert_eq(slope_cells_ok(&TT_QD_P, 1), 576);
    assert_eq(slope_cells_ok(&TT_QG_N, 0), 576);
    assert_eq(slope_cells_ok(&TT_QG_P, 0), 576);
    assert_eq(slope_cells_ok(&SS_QD_N, 1), 576);
    assert_eq(slope_cells_ok(&SS_QD_P, 1), 576);
    assert_eq(slope_cells_ok(&SS_QG_N, 0), 576);
    assert_eq(slope_cells_ok(&SS_QG_P, 0), 576);
    // SIZES. The drain capacitance of the NMOS at zero bias is 1.01 fF (overlap and junction), its gate capacitance in strong inversion
    // 6.1 fF (the oxide, 0.45 um x 1 um), and the PMOS, three times as wide, 17 fF: a ratio of 2.8.
    const cdd0 : f64 = cap_af(TT_QD_N[0], TT_QD_N[1]);
    assert cdd0 > 1000.0;
    assert cdd0 < 1025.0;
    const cgn : f64 = cap_af(TT_QG_N[19 * 25 + 1], TT_QG_N[20 * 25 + 1]);
    const cgp : f64 = cap_af(TT_QG_P[19 * 25 + 1], TT_QG_P[20 * 25 + 1]);
    assert cgn > 6000.0;
    assert cgn < 6200.0;
    assert cgp / cgn > 2.7;
    assert cgp / cgn < 2.95;
    // AN INDEPENDENT CHECK against what ngspice reports itself. At the NMOS operating point Vgs = 0.9 V, Vds = 0.75 V the model gives
    // the channel capacitances cdd, cdg, cgg and, apart, the overlaps cgsol, cgdol and the junction cjd (aF, pasted from the deck's
    // op_n block). The drain terminal's capacitances are cdd + cjd + cgdol to the drain, -(cdg + cgdol) to the gate; the gate's own is
    // cgg + cgsol + cgdol. The tables were made from currents and never saw these numbers; their slopes at that point are within 1 %.
    const vg : u32 = 15099494;
    const vd : u32 = 12 * CELL;
    const sl : u32 = gds_cell(&TT_QD_N, vg, vd - 1000);
    const sh : u32 = gds_cell(&TT_QD_N, vg, vd + 1000);
    const cdd_t : f64 = ((sl + sh) as f64) * 0.5 * AF_PER_UNIT_CELL;
    const cdg_t : f64 = 0.0 - cap_af(TT_QD_N[14 * 25 + 12], TT_QD_N[15 * 25 + 12]);
    const cgg_t : f64 = cap_af(TT_QG_N[14 * 25 + 12], TT_QG_N[15 * 25 + 12]);
    const cdd_o : f64 = ((OP_CDD_AF + OP_CJD_AF + OP_CGDOL_AF) as f64);
    const cdg_o : f64 = ((OP_CDG_AF + OP_CGDOL_AF) as f64);
    const cgg_o : f64 = ((OP_CGG_AF + OP_CGSOL_AF + OP_CGDOL_AF) as f64);
    assert rel_gap(cdd_t, cdd_o) < 0.01;
    assert rel_gap(cdg_t, cdg_o) < 0.01;
    assert rel_gap(cgg_t, cgg_o) < 0.01;
    // 0.16 %, 0.29 %, 0.19 %: both sides.
    assert rel_gap(cdd_t, cdd_o) > 0.001;
    assert rel_gap(cdg_t, cdg_o) > 0.002;
    assert rel_gap(cgg_t, cgg_o) > 0.001;
    // NEGATIVE CONTROL: the ss table's gate-drain coupling at the same point is 2.6 % off tt's, which the 1 % sees.
    const cdg_s : f64 = 0.0 - cap_af(SS_QD_N[14 * 25 + 12], SS_QD_N[15 * 25 + 12]);
    assert rel_gap(cdg_s, cdg_o) > 0.02;
    assert rel_gap(cdg_s, cdg_o) < 0.03;
}

test the_tt_inverter_at_500_fF_with_charge_is_within_1_percent_and_within_the_measured_bounds_of_ngspice_backward_euler {
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    var outf : [400]f64 = [0.0] ** 400;
    var tmp : [400]f64 = [0.0] ** 400;
    var fix : [401]f64 = [0.0] ** 401;
    var fl : [401]f64 = [0.0] ** 401;
    var be : [401]f64 = [0.0] ** 401;
    const rest : u32 = dc_out(&TT_N, &TT_P, VDD);
    const s : u64 = run_fix_q(&TT_N, &TT_P, &TT_QD_N, &TT_QD_P, K_NEWTON, rest, VDD, false, &out, &res);
    run_tabf_q(&TT_N, &TT_P, &TT_QD_N, &TT_QD_P, K_NEWTON, rest as f64, VDD, &outf);
    lift_u32(&out, 400, &tmp);
    shift_run(rest as f64, &tmp, &fix);
    shift_run(rest as f64, &outf, &fl);
    lift_u32(&INV500_BE, 401, &be);
    const up_be5 : f64 = steps_of_fs(INV500_BE_TPLH_FS, EDGE1_500F_FS, DT_500F_FS);
    const dn_be5 : f64 = steps_of_fs(INV500_BE_TPHL_FS, EDGE2_500F_FS, DT_500F_FS);
    const up_fix : f64 = delay_up(&fix);
    const dn_fix : f64 = delay_dn(&fix);
    // The run: from the DC rest value (3 units), 400 steps, the fold pinned; the last Newton residual is at most 2 units (119 nV) at
    // every step, at the bound.
    assert_eq(rest, 3);
    assert_eq(s, EXP_S_TT_Q);
    assert max_of(&res) <= RES_BOUND;
    assert_eq(max_of(&res), 2);
    // THE ISSUE'S BAR: both 50 % delays within 1 % of ngspice backward Euler on the same grid (3.09 % and 3.63 % without charge).
    assert rel_gap(up_fix, up_be5) < B_ISSUE_DELAY_REL;
    assert rel_gap(dn_fix, dn_be5) < B_ISSUE_DELAY_REL;
    // What is measured, both sides: tpLH 13.4379 steps against ngspice's 13.4352 (0.020 %, 0.27 ps longer), tpHL 10.1826 against
    // 10.1830 (0.0041 %, 0.04 ps shorter).
    assert rel_gap(up_fix, up_be5) < 0.00021;
    assert rel_gap(up_fix, up_be5) > 0.00019;
    assert rel_gap(dn_fix, dn_be5) < 0.000044;
    assert rel_gap(dn_fix, dn_be5) > 0.000039;
    assert up_fix > up_be5;
    assert dn_fix < dn_be5;
    // ngspice's two reads of its own delay agree: the crossing read off the 100 ps samples and its .meas, to 0.0001 step (10 fs).
    assert fabs64(delay_up(&be) - up_be5) < 0.0001;
    assert fabs64(delay_dn(&be) - dn_be5) < 0.0001;
    // The waveform: the f64 model against ngspice's 401 samples, the largest |dY| is 6693 units (0.40 mV, 0.027 % of Vdd), bound 6700.
    const wave : f64 = max_diff(&fl, &be, 401);
    assert wave < B_Q_WAVE_UNITS;
    assert wave > 6680.0;
    // The two gate edges, where the charge does its work. After step 0 the output is 41 mV off the rail: the fixed-point run lands 27
    // units (1.6 uV) from ngspice's sample; after step 200 (the falling edge) 2566 units (0.15 mV).
    assert mag_diff(out[0], INV500_BE[1]) < 30;
    assert mag_diff(out[0], INV500_BE[1]) > 20;
    assert mag_diff(out[200], INV500_BE[201]) < 2600;
    assert mag_diff(out[200], INV500_BE[201]) > 2500;
    // ARITHMETIC: the fixed-point run against the f64 run of the same iteration, 4.03 units (0.24 uV), no delay (< 1e-5 step).
    const arith : f64 = max_diff(&fix, &fl, 401);
    assert arith < 4.1;
    assert arith > 3.95;
    assert fabs64(up_fix - delay_up(&fl)) < 0.00001;
    assert fabs64(dn_fix - delay_dn(&fl)) < 0.00001;
}

test the_three_errors_at_500_fF_kept_apart_and_what_the_charge_removed {
    const wq : CheckQ = check_q(&TT_N, &TT_P, &TT_QD_N, &TT_QD_P);
    const nq : CheckQ = check_q(&TT_N, &TT_P, &NOQ, &NOQ);
    // TABLE + MODEL (the f64 model against ngspice backward Euler on the same grid): with the charge 0.020 % and 0.0041 % of the
    // delay and 6693 units on the waveform; without it 3.09 % and 3.63 % and 438317 units (26 mV, 1.7 % of Vdd).
    assert wq.up_rel < 0.00021;
    assert wq.dn_rel < 0.000044;
    assert nq.up_rel > 0.0307;
    assert nq.up_rel < 0.0311;
    assert nq.dn_rel > 0.0361;
    assert nq.dn_rel < 0.0364;
    assert nq.wave > 438000.0;
    assert nq.wave < 438700.0;
    // The charge removes 99.4 % of the delay gap in tpLH and 99.9 % in tpHL, and 98.5 % of the waveform's.
    assert wq.up_rel * 100.0 < nq.up_rel;
    assert wq.dn_rel * 500.0 < nq.dn_rel;
    assert wq.wave * 60.0 < nq.wave;
    // DISCRETIZATION: ngspice backward Euler at 100 ps against ngspice converged at 500 fF, which the charge does not touch: the
    // delays are 0.52 % and 0.67 % longer, as at 10 pF.
    const up_be5 : f64 = steps_of_fs(INV500_BE_TPLH_FS, EDGE1_500F_FS, DT_500F_FS);
    const dn_be5 : f64 = steps_of_fs(INV500_BE_TPHL_FS, EDGE2_500F_FS, DT_500F_FS);
    const up_fine5 : f64 = steps_of_fs(INV500_FINE_TPLH_FS, EDGE1_500F_FS, DT_500F_FS);
    const dn_fine5 : f64 = steps_of_fs(INV500_FINE_TPHL_FS, EDGE2_500F_FS, DT_500F_FS);
    assert rel_gap(up_be5, up_fine5) > 0.0050;
    assert rel_gap(up_be5, up_fine5) < 0.0054;
    assert rel_gap(dn_be5, dn_fine5) > 0.0065;
    assert rel_gap(dn_be5, dn_fine5) < 0.0069;
    // All three together, the fixed-point model against ngspice's converged run: 0.54 % and 0.67 % of the delay; the discretization is
    // now the whole of it (ngspice's own scheme at 100 ps), and the model with charge follows that scheme to 0.02 %.
    var out : [400]u32 = [0] ** 400;
    var res : [400]u32 = [0] ** 400;
    var tmp : [400]f64 = [0.0] ** 400;
    var fix : [401]f64 = [0.0] ** 401;
    const rest : u32 = dc_out(&TT_N, &TT_P, VDD);
    const s : u64 = run_fix_q(&TT_N, &TT_P, &TT_QD_N, &TT_QD_P, K_NEWTON, rest, VDD, false, &out, &res);
    lift_u32(&out, 400, &tmp);
    shift_run(rest as f64, &tmp, &fix);
    assert rel_gap(delay_up(&fix), up_fine5) > 0.0053;
    assert rel_gap(delay_up(&fix), up_fine5) < 0.0056;
    assert rel_gap(delay_dn(&fix), dn_fine5) > 0.0065;
    assert rel_gap(delay_dn(&fix), dn_fine5) < 0.0069;
    // K = 1 breaks the residual bound with charge too (11636 units); K = 2 already meets it.
    var out1 : [400]u32 = [0] ** 400;
    var res1 : [400]u32 = [0] ** 400;
    const s1 : u64 = run_fix_q(&TT_N, &TT_P, &TT_QD_N, &TT_QD_P, 1, rest, VDD, false, &out1, &res1);
    assert max_of(&res1) > 10000;
    assert s1 != s;
}

test the_ss_charge_tables_in_the_tt_run_fail_the_500_fF_check_and_so_do_the_other_wrong_charges {
    // THE NEGATIVE CONTROL. The check is the tt 500 fF check: both delays and the waveform against ngspice tt backward Euler. The tt
    // current tables with the tt charge pass it; with the ss charge tables (the same tables of the slower corner, 4.3 .. 5.3 % smaller
    // in range) it fails every measure. The issue's bar of 1 % would not see the ss charge (0.13 % and 0.17 %): the check holds 0.05 %.
    const g : CheckQ = check_q(&TT_N, &TT_P, &TT_QD_N, &TT_QD_P);
    assert check_q_ok(g.up_rel, g.dn_rel, g.wave);
    const b : CheckQ = check_q(&TT_N, &TT_P, &SS_QD_N, &SS_QD_P);
    assert check_q_ok(b.up_rel, b.dn_rel, b.wave) == false;
    assert b.up_rel > 2.4 * B_Q_DELAY_REL;
    assert b.dn_rel > 3.2 * B_Q_DELAY_REL;
    assert b.wave > 3.5 * B_Q_WAVE_UNITS;
    // 0.127 % and 0.167 % of the delay (0.17 ps and 0.17 ps) and 24012 units (1.43 mV) of waveform, 6 .. 40 times the tt's own error.
    assert b.up_rel > 0.0012;
    assert b.up_rel < 0.0013;
    assert b.dn_rel > 0.0016;
    assert b.dn_rel < 0.0017;
    assert b.wave > 24000.0;
    assert b.wave < 24100.0;
    assert b.up_rel > 6.0 * g.up_rel;
    assert b.dn_rel > 40.0 * g.dn_rel;
    assert b.up_rel < B_ISSUE_DELAY_REL;
    assert b.dn_rel < B_ISSUE_DELAY_REL;
    // The charge missing altogether fails (3.09 % and 3.63 %), the NMOS and PMOS charge tables in each other's slots fail (0.59 %
    // and 0.57 %, 91415 units), and either device's charge alone is not enough (the NMOS's: 2.0 % and 2.9 %; the PMOS's: 1.0 % and 0.8 %).
    const nq : CheckQ = check_q(&TT_N, &TT_P, &NOQ, &NOQ);
    assert check_q_ok(nq.up_rel, nq.dn_rel, nq.wave) == false;
    assert nq.up_rel > 60.0 * B_Q_DELAY_REL;
    const sw : CheckQ = check_q(&TT_N, &TT_P, &TT_QD_P, &TT_QD_N);
    assert check_q_ok(sw.up_rel, sw.dn_rel, sw.wave) == false;
    assert sw.up_rel > 10.0 * B_Q_DELAY_REL;
    assert sw.dn_rel > 10.0 * B_Q_DELAY_REL;
    assert sw.wave > 13.0 * B_Q_WAVE_UNITS;
    const only_n : CheckQ = check_q(&TT_N, &TT_P, &TT_QD_N, &NOQ);
    assert check_q_ok(only_n.up_rel, only_n.dn_rel, only_n.wave) == false;
    assert only_n.up_rel > 30.0 * B_Q_DELAY_REL;
    const only_p : CheckQ = check_q(&TT_N, &TT_P, &NOQ, &TT_QD_P);
    assert check_q_ok(only_p.up_rel, only_p.dn_rel, only_p.wave) == false;
    assert only_p.up_rel > 15.0 * B_Q_DELAY_REL;
    // The other direction: the ss current tables with the tt charge fail the check too (the current error dominates).
    const wrong_i : CheckQ = check_q(&SS_N, &SS_P, &TT_QD_N, &TT_QD_P);
    assert check_q_ok(wrong_i.up_rel, wrong_i.dn_rel, wrong_i.wave) == false;
}

test the_issue_s_weak_inversion_one_percent_is_out_of_reach_of_a_chord_over_these_tables_and_why {
    // PART 3 OF #10777, the part that is a bound and not a fix. The issue proposes at most 1 % relative error with a floor of 1e-9 A at the
    // 576 midpoints and 1000 R2 points. M3b measured 0.55 .. 0.73 (test the_tt_tables_at_the_held_out_points_against_ngspice, above:
    // rel9 between 0.5 and 0.75). Two facts, both of the tables and not of the solver, say why no read of THESE tables can do better.
    // (a) ROUNDING. A table word is 298 pA; half a word, the rounding error of a node, is 149 pA, 15 % of the 1 nA floor, where the
    // criterion allows 10 pA. Below a few nA the table itself is 10 .. 100 % off before any interpolation.
    const half : f64 = amps_of(0.5);
    assert half > 0.00000000014;
    assert half < 0.00000000015;
    assert half / 0.000000001 > 0.14;
    assert half > 10.0 * (0.01 * 0.000000001);
    // (b) GROWTH. In weak inversion the NMOS current grows between 6.5 and 7 times per 62.5 mV cell (ngspice's own currents at three
    // neighbouring cell midpoints, Vds = 1.4 V, from 0.6 nA to 200 nA); a straight line between two nodes whose ratio is r is above the
    // exponential at the middle by (1 + r) / (2 sqrt(r)), and ((1 + r) / 2)^2 > 2 r means by more than 41 %.
    var i : u32 = 0;
    var checked : u32 = 0;
    while (i < 3) {
        const a : f64 = (TT_MID_N[(i * 24 + 20) as usize]) as f64;
        const b : f64 = (TT_MID_N[((i + 1) * 24 + 20) as usize]) as f64;
        const r : f64 = b / a;
        assert r > 6.5;
        assert r < 7.0;
        assert ((1.0 + r) * 0.5) * ((1.0 + r) * 0.5) > 2.0 * r;
        checked = checked + 1;
        i = i + 1;
    }
    assert_eq(checked, 3);
    // (c) WHAT WOULD DO IT. Tabulating the current in units of 0.3 pA would put 1 % of the floor at 33 words, but the largest word, 402 uA,
    // is then 1.3e9, and the reader's u64 interpolation needs every word under 2^23: the read would need 128-bit sums or a table in the log
    // domain (an integer exp). That is a different reader, not a finer grid: the next issue.
    var wide : f64 = 0.000402305 / 0.0000000000003;
    var bound : f64 = 8388608.0;
    assert wide > 100.0 * bound;
    // And on the grid there is no free lunch: the midpoint chord error of the issue's measure is above 0.5 for the NMOS and above 0.6
    // for the PMOS (0.51 .. 0.62 and 0.64 .. 0.73 over midpoints and R2 points).
    const mn : Hold = hold_stats(&TT_N, &TT_MID_N, 0, 576);
    const mp : Hold = hold_stats(&TT_P, &TT_MID_P, 0, 576);
    assert mn.rel9 > 0.5;
    assert mp.rel9 > 0.6;
    assert mn.rel9 > 50.0 * 0.01;
}

test the_ss_charge_tables_differ_from_tt_by_four_to_five_percent_of_range {
    // Why the negative control of the charge is the delay at 0.05 % and not a coarse count: the corners' charge tables are alike. The largest
    // |tt - ss| entry is 4.7 % (NMOS drain), 5.3 % (NMOS gate), 4.3 % (PMOS drain) and 4.6 % (PMOS gate) of the tt table's range, so
    // the delays move by 0.13 % and 0.17 %.
    const dn : f64 = table_gap_of_range(&TT_QD_N, &SS_QD_N);
    const gn : f64 = table_gap_of_range(&TT_QG_N, &SS_QG_N);
    const dp : f64 = table_gap_of_range(&TT_QD_P, &SS_QD_P);
    const gp : f64 = table_gap_of_range(&TT_QG_P, &SS_QG_P);
    assert dn > 0.046;
    assert dn < 0.048;
    assert gn > 0.052;
    assert gn < 0.054;
    assert dp > 0.043;
    assert dp < 0.044;
    assert gp > 0.045;
    assert gp < 0.047;
    // A table against itself is 0.
    assert table_gap_of_range(&TT_QD_N, &TT_QD_N) < 0.0000001;
}
