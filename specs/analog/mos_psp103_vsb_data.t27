; --- the accessors ---------------------------------------------------------------------------------------------------------------

/// The table of device dev (DEV_N, DEV_P) at the source-to-bulk voltage k * 0.25 V, k = 0 .. 6: the slice 0 is t0, the existing 2-D table the caller passes (TT_LG_N or TT_LG_P, or a
/// table of its own), the slices 1 .. 6 are the tables of this file. Any other k, or a dev that is neither, is t0.
pub fn vsb_tab(dev: u32, t0: []const u32, k: u32) -> []const u32 {
    if (dev == DEV_N) {
        if (k == 1) { return &VSB_N1; }
        if (k == 2) { return &VSB_N2; }
        if (k == 3) { return &VSB_N3; }
        if (k == 4) { return &VSB_N4; }
        if (k == 5) { return &VSB_N5; }
        if (k == 6) { return &VSB_N6; }
    }
    if (dev == DEV_P) {
        if (k == 1) { return &VSB_P1; }
        if (k == 2) { return &VSB_P2; }
        if (k == 3) { return &VSB_P3; }
        if (k == 4) { return &VSB_P4; }
        if (k == 5) { return &VSB_P5; }
        if (k == 6) { return &VSB_P6; }
    }
    return t0;
}

/// Id(vg, vd) of device dev at the source-to-bulk voltage vsb (units of 2^-24 V, 0 .. 1.5 V), in IUNIT = 1.164 pA: the two slices around vsb, the log word blended between them
/// (`lg_fine_vsb`). t0 is the slice 0. At vsb = 0 this is `lg_fine(t0, vg, vd)` exactly, and at a slice's own voltage it is `lg_fine` of that slice.
pub fn vsb_fine(dev: u32, t0: []const u32, vg: u32, vd: u32, vsb: u32) -> u64 {
    const j : u32 = lg_vsb_cell(vsb);
    return lg_fine_vsb(vsb_tab(dev, t0, j), vsb_tab(dev, t0, j + 1), vg, vd, lg_vsb_frac(vsb));
}

/// The held-out currents of device dev in pA.
pub fn vsb_cen(dev: u32) -> []const u32 {
    if (dev == DEV_P) { return &VSB_CEN_P; }
    return &VSB_CEN_N;
}

; --- the tests -----------------------------------------------------------------------------------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test the_vsb_slices_are_the_numbers_ngspice_printed_and_are_tables_of_the_format_the_2d_reader_reads {
    // the twelve slices, N then P, and the two held-out sets: the pins see one changed number
    var s : u64 = 0;
    var k : u32 = 1;
    while (k < 7) {
        s = fold_arr(vsb_tab(DEV_N, &TT_LG_N, k), 4851, s);
        k = k + 1;
    }
    k = 1;
    while (k < 7) {
        s = fold_arr(vsb_tab(DEV_P, &TT_LG_P, k), 4851, s);
        k = k + 1;
    }
    assert_eq(s, PIN_VSB_LG);
    var c : u64 = fold_arr(&VSB_CEN_N, 1000, 0);
    c = fold_arr(&VSB_CEN_P, 1000, c);
    assert_eq(c, PIN_VSB_CEN);
    // a pin sees one changed number in a table of this size too: the slice 3 of the NMOS with one word one higher is another word of the fold
    var t : [4851]u32 = [0] ** 4851;
    var i : usize = 0;
    while (i < 4851) {
        t[i] = VSB_N3[i];
        i = i + 1;
    }
    assert_eq(fold_arr(&t, 4851, 0), fold_arr(&VSB_N3, 4851, 0));
    t[2000] = t[2000] + 1;
    assert fold_arr(&t, 4851, 0) != fold_arr(&VSB_N3, 4851, 0);
    // the layout of a table of the 2-D reader: the tag word, 4753 log words under 2^21, and the 97 rv words, which are the same in every slice and in the existing tables (rv is a
    // function of Vgs only: the deck prints them for every slice and they are the same words)
    var nslice : u32 = VSB_NSLICE;
    var ncen : u32 = VSB_CEN_COUNT;
    var step : u32 = VSB_STEP_MV;
    assert_eq(nslice, 7);
    assert_eq(ncen, 1000);
    assert_eq(step * 6, 1500);
    var same_rv : u32 = 0;
    var tags : u32 = 0;
    var under : u32 = 0;
    k = 1;
    while (k < 7) {
        const tn : []const u32 = vsb_tab(DEV_N, &TT_LG_N, k);
        const tp : []const u32 = vsb_tab(DEV_P, &TT_LG_P, k);
        if (tn[0] == LG_TAG) { tags = tags + 1; }
        if (tp[0] == LG_TAG) { tags = tags + 1; }
        var r : usize = 0;
        while (r < 97) {
            if (tn[4754 + r] == TT_LG_N[4754 + r]) { same_rv = same_rv + 1; }
            if (tp[4754 + r] == TT_LG_P[4754 + r]) { same_rv = same_rv + 1; }
            r = r + 1;
        }
        i = 1;
        while (i <= 4753) {
            if (tn[i] < 2097152) { under = under + 1; }
            if (tp[i] < 2097152) { under = under + 1; }
            i = i + 1;
        }
        k = k + 1;
    }
    assert_eq(tags, 12);
    assert_eq(same_rv, 12 * 97);
    assert_eq(under, 12 * 4753);
    // the held-out currents: all positive, the smallest 2 pA (NMOS) and 1 pA (PMOS, at a high Vsb), the largest 372 uA and 271 uA
    var cmin_n : u32 = VSB_CEN_N[0];
    var cmax_n : u32 = VSB_CEN_N[0];
    var cmin_p : u32 = VSB_CEN_P[0];
    var cmax_p : u32 = VSB_CEN_P[0];
    i = 0;
    while (i < 1000) {
        if (VSB_CEN_N[i] < cmin_n) { cmin_n = VSB_CEN_N[i]; }
        if (VSB_CEN_N[i] > cmax_n) { cmax_n = VSB_CEN_N[i]; }
        if (VSB_CEN_P[i] < cmin_p) { cmin_p = VSB_CEN_P[i]; }
        if (VSB_CEN_P[i] > cmax_p) { cmax_p = VSB_CEN_P[i]; }
        i = i + 1;
    }
    assert_eq(cmin_n, 2);
    assert_eq(cmin_p, 1);
    assert_eq(cmax_n, 372420676);
    assert_eq(cmax_p, 270922404);
}

test the_current_of_both_devices_falls_with_the_source_to_bulk_voltage_at_every_node_above_a_quarter_volt_of_gate_drive_and_the_accessors_pick_the_right_slices {
    // The body effect raises the threshold, so at one (Vgs, Vds) the current falls as Vsb grows: the log word of slice k + 1 is at most that of slice k at every node with Vgs at or
    // above 0.25 V (ix >= 16), 81 * 49 nodes, six steps, both devices. Below it the PMOS off current is a floor and a junction leakage that rises with Vsb, and the table holds both
    // (a rise of up to 18180 words, a factor 2^0.28, at Vgs under 0.125 V), so the test does not claim the whole table.
    var viol : u32 = 0;
    var checked : u32 = 0;
    var dev : u32 = 0;
    while (dev < 2) {
        var t0 : []const u32 = &TT_LG_N;
        if (dev == DEV_P) { t0 = &TT_LG_P; }
        var k : u32 = 0;
        while (k < 6) {
            const a : []const u32 = vsb_tab(dev, t0, k);
            const b : []const u32 = vsb_tab(dev, t0, k + 1);
            var ix : usize = 16;
            while (ix < 97) {
                var iy : usize = 0;
                while (iy < 49) {
                    if (b[1 + ix * 49 + iy] > a[1 + ix * 49 + iy]) { viol = viol + 1; }
                    checked = checked + 1;
                    iy = iy + 1;
                }
                ix = ix + 1;
            }
            k = k + 1;
        }
        dev = dev + 1;
    }
    assert_eq(checked, 2 * 6 * 81 * 49);
    assert_eq(viol, 0);
    // how large the body effect is, at Vgs = 0.25 V (ix = 16), Vds = 1.5 V (iy = 48), weak inversion: the NMOS word falls from 1228960 at Vsb = 0 to 801411 at 1.5 V, a factor
    // 2^6.52 = 92 in the current, the PMOS from 940848 to 294870, a factor 2^9.85 = 922; in strong inversion (Vgs = 0.75 V, Vds = 1.5 V) a few percent per quarter volt
    assert_eq(TT_LG_N[1 + 16 * 49 + 48], 1228960);
    assert_eq(VSB_N6[1 + 16 * 49 + 48], 801411);
    assert_eq(TT_LG_P[1 + 16 * 49 + 48], 940848);
    assert_eq(VSB_P6[1 + 16 * 49 + 48], 294870);
    assert_eq(TT_LG_N[1 + 48 * 49 + 48], 1704014);
    assert_eq(VSB_N6[1 + 48 * 49 + 48], 1632007);
    // the accessors: the slice 0 is the table the caller passes (word for word, it is that table), the others are this file's tables, k outside 0 .. 6 and a device that is neither are the slice 0
    var w0 : u32 = vsb_tab(DEV_N, &TT_LG_N, 0)[2000];
    var w1 : u32 = vsb_tab(DEV_N, &TT_LG_N, 1)[2000];
    var w6 : u32 = vsb_tab(DEV_N, &TT_LG_N, 6)[2000];
    var w9 : u32 = vsb_tab(DEV_N, &TT_LG_N, 9)[2000];
    var wp : u32 = vsb_tab(DEV_P, &TT_LG_P, 6)[2000];
    var wx : u32 = vsb_tab(7, &TT_LG_N, 3)[2000];
    assert_eq(w0, TT_LG_N[2000]);
    assert_eq(w1, VSB_N1[2000]);
    assert_eq(w6, VSB_N6[2000]);
    assert_eq(w9, TT_LG_N[2000]);
    assert_eq(wp, VSB_P6[2000]);
    assert_eq(wx, TT_LG_N[2000]);
    assert w1 < w0;
    assert w6 < w1;
    assert wp < VSB_N6[2000];
    var h0 : usize = vsb_cen(DEV_N).len;
    assert_eq(h0, 1000);
    assert_eq(vsb_cen(DEV_N)[0], VSB_CEN_N[0]);
    assert_eq(vsb_cen(DEV_P)[999], VSB_CEN_P[999]);
}

test the_read_at_zero_source_to_bulk_voltage_is_the_2d_read_bit_for_bit_and_at_a_slice_it_is_the_read_of_that_slice_and_between_two_slices_it_lies_between_them {
    // FR-002. At Vsb = 0 the weight of the second slice is 0 and the read is the existing 2-D read of the table passed as the slice 0, to the word, at every point of a lattice of
    // 70 x 40 points over (Vgs, Vds), both devices; at the voltage of a slice (k * 2^22 units) it is the 2-D read of that slice; above the supply it is the top slice. Between two slices the
    // read of the current lies between the reads of the two (the log word is a blend, and the current is monotone in it).
    var at_zero : u32 = 0;
    var at_slice : u32 = 0;
    var above : u32 = 0;
    var between : u32 = 0;
    var total : u32 = 0;
    var dev : u32 = 0;
    while (dev < 2) {
        var t0 : []const u32 = &TT_LG_N;
        if (dev == DEV_P) { t0 = &TT_LG_P; }
        var vg : u32 = 20000;
        while (vg < 25165824) {
            var vd : u32 = 30000;
            while (vd < 25165824) {
                total = total + 1;
                if (vsb_fine(dev, t0, vg, vd, 0) == lg_fine(t0, vg, vd)) { at_zero = at_zero + 1; }
                var k : u32 = 1;
                var ok : bool = true;
                while (k < 7) {
                    if (vsb_fine(dev, t0, vg, vd, k << 22) != lg_fine(vsb_tab(dev, t0, k), vg, vd)) { ok = false; }
                    k = k + 1;
                }
                if (ok) { at_slice = at_slice + 1; }
                if (vsb_fine(dev, t0, vg, vd, 25165824 + 77) == lg_fine(vsb_tab(dev, t0, 6), vg, vd)) { above = above + 1; }
                // between slices 2 and 3 (0.5 V and 0.75 V) at 0.6 V: the current is not above the lower Vsb's and not below the higher's (the 0.25 V slices of one device fall with Vsb
                // at the nodes above 0.25 V of gate drive; elsewhere the order may flip, so the check is made where Vgs is at least 0.3 V)
                const lo : u64 = lg_fine(vsb_tab(dev, t0, 3), vg, vd);
                const hi : u64 = lg_fine(vsb_tab(dev, t0, 2), vg, vd);
                const mid : u64 = vsb_fine(dev, t0, vg, vd, 10066330);
                if (vg < 5033165) {
                    between = between + 1;
                } else {
                    if (mid >= lo and mid <= hi) { between = between + 1; }
                }
                vd = vd + 600011;
            }
            vg = vg + 360007;
        }
        dev = dev + 1;
    }
    assert total > 2000;
    assert_eq(at_zero, total);
    assert_eq(at_slice, total);
    assert_eq(above, total);
    assert_eq(between, total);
    // NEGATIVE CONTROL: the slices of the wrong device (the PMOS table as the slice 0 of an NMOS read) are not the 2-D read, so a mix-up of the devices is seen at Vsb = 0 and between
    assert vsb_fine(DEV_N, &TT_LG_P, 12000000, 3000000, 0) != lg_fine(&TT_LG_N, 12000000, 3000000);
    assert vsb_fine(DEV_N, &TT_LG_N, 12000000, 3000000, 6291456) != vsb_fine(DEV_P, &TT_LG_P, 12000000, 3000000, 6291456);
}
