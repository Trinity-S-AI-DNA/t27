; --- the hardware: unsigned words only ----------------------------------------------------------------------------
; Everything from bit_of to convert_k takes and returns bool and unsigned words and has no float. The step is M1's, called
; with a zero D matrix and the charge-transfer ratios of one plate as N, so a switch event is x' = x + rnd(N u) per node.

/// Bit j of a code (j = 0 is Bit_1, the LSB).
pub fn bit_of(code: u32, j: usize) -> bool {
    return ((code >> (j as u32)) & 1) == 1;
}

/// A plate leaves VCM for VDD when its bit is set and for 0 V when it is not: +VCM or -VCM.
pub fn plate_step(bit: bool) -> u32 {
    if (bit) { return VCM; }
    return NEG | VCM;
}

/// One switch event: plate j moves by u (a word), the two nodes move by M1's step with D = 0 and N = the plate's ratios in k.
pub fn event_k(k: []const u32, j: usize, u: u32, x: []const u32, out: []u32) {
    const nv : [2]u32 = [k[2 * j], k[2 * j + 1]];
    step(2, &ZD, &nv, x, u, out);
}

pub struct CdacNodes { l: u32, m: u32 }

/// The two node voltages after one code: from the sampled state, ten events, Bit_10 first (the SAR order), ratios k.
pub fn convert_k(k: []const u32, code: u32, vs: u32) -> CdacNodes {
    var x : [2]u32 = [vs, vs];
    var y : [2]u32 = [0, 0];
    var j : usize = PLATES;
    while (j > 0) {
        j = j - 1;
        event_k(k, j, plate_step(bit_of(code, j)), &x, &y);
        x[0] = y[0];
        x[1] = y[1];
    }
    return CdacNodes { l: x[0], m: x[1] };
}

/// The deck's DAC: convert_k with the stored ratios.
pub fn convert(code: u32, vs: u32) -> CdacNodes {
    return convert_k(&K_Q, code, vs);
}

; --- the f64 side: references that only the tests reach --------------------------------------------------------------

/// The units on one side of the bridge.
pub fn side_sum(units: []const u32, side: []const u8, which: u8) -> f64 {
    var s : f64 = 0.0;
    var j : usize = 0;
    while (j < PLATES) {
        if (side[j] == which) { s = s + (units[j] as f64); }
        j = j + 1;
    }
    return s;
}

/// The ratios by the matrix route: C = [[CL + Cb, -Cb], [-Cb, CM + Cb + Ct]] (dummy units to ground join CL, Ct = `top`, a parasitic
/// from the top plate Vout to ground, joins the Vout corner), C_b the column of the plate's units on its own node, K = C^-1 C_b by
/// the adjugate. Unit capacitance cancels. Layout as K_Q. M4e (#10818) added `top`: the converter of the golden deck loads the top
/// plate with more than the DAC (the 4 fF capacitors, the comparator input, the switch), which scales every Vout ratio.
pub fn derive_k_top(units: []const u32, side: []const u8, bridge: f64, dummy: f64, top: f64) -> [20]f64 {
    var k : [20]f64 = [0.0] ** 20;
    const cl : f64 = side_sum(units, side, SIDE_L) + dummy;
    const cm : f64 = side_sum(units, side, SIDE_M);
    const c00 : f64 = cl + bridge;
    const c11 : f64 = cm + top + bridge;
    const c01 : f64 = 0.0 - bridge;
    const det : f64 = c00 * c11 - c01 * c01;
    var j : usize = 0;
    while (j < PLATES) {
        const u : f64 = units[j] as f64;
        var b0 : f64 = 0.0;
        var b1 : f64 = 0.0;
        if (side[j] == SIDE_L) { b0 = u; } else { b1 = u; }
        k[2 * j] = (c11 * b0 - c01 * b1) / det;
        k[2 * j + 1] = (c00 * b1 - c01 * b0) / det;
        j = j + 1;
    }
    return k;
}

/// The deck's DAC with no parasitic on the top plate: derive_k_top with top = 0.
pub fn derive_k(units: []const u32, side: []const u8, bridge: f64, dummy: f64) -> [20]f64 {
    return derive_k_top(units, side, bridge, dummy, 0.0);
}

/// The same ratios by the closed form of the split array: with D = CL CM + Cb (CL + CM), a plate of u units on net1 moves
/// net1 by u (CM + Cb) / D and Vout by u Cb / D; a plate on Vout moves net1 by u Cb / D and Vout by u (CL + Cb) / D.
pub fn closed_k(units: []const u32, side: []const u8, bridge: f64, dummy: f64) -> [20]f64 {
    var k : [20]f64 = [0.0] ** 20;
    const cl : f64 = side_sum(units, side, SIDE_L) + dummy;
    const cm : f64 = side_sum(units, side, SIDE_M);
    const d : f64 = cl * cm + bridge * (cl + cm);
    var j : usize = 0;
    while (j < PLATES) {
        const u : f64 = units[j] as f64;
        if (side[j] == SIDE_L) {
            k[2 * j] = u * (cm + bridge) / d;
            k[2 * j + 1] = u * bridge / d;
        } else {
            k[2 * j] = u * bridge / d;
            k[2 * j + 1] = u * (cl + bridge) / d;
        }
        j = j + 1;
    }
    return k;
}

/// The bridge that makes the split array exactly binary: CL / (2^5 - 1) for a 5-bit LSB array of CL units.
pub fn ideal_bridge(cl: f64) -> f64 {
    return cl / 31.0;
}

/// Volts at one node (0 = net1, 1 = Vout) after a code, from the sampled vs: vs + sum_j K[2j + node] (+-VCM).
pub fn node_volts(k: []const f64, node: usize, code: u32, vs: f64) -> f64 {
    var v : f64 = vs;
    var j : usize = 0;
    while (j < PLATES) {
        if (bit_of(code, j)) { v = v + k[2 * j + node] * VCM_V; } else { v = v - k[2 * j + node] * VCM_V; }
        j = j + 1;
    }
    return v;
}

/// The integral nonlinearity of the transfer about the sample: the distance of Vout from the straight line through code 0 and code
/// 1023, in LSB of that line (its span / 1023). It is the part of the error that bends the staircase. It is zero exactly when every
/// weight is 2^(j - 1) times the first.
pub fn inl_lsb(k: []const f64, code: u32) -> f64 {
    const v0 : f64 = node_volts(k, 1, 0, 0.0);
    const lsb : f64 = (node_volts(k, 1, 1023, 0.0) - v0) / 1023.0;
    return (node_volts(k, 1, code, 0.0) - v0 - lsb * (code as f64)) / lsb;
}

/// The deviation from the nominal 10-bit DAC, V = VCM (2 c - 1023) / 1024 about the sampled voltage, in LSB = VDD / 1024.
/// It is the gain error: a straight line through code 511.5.
pub fn gain_lsb(k: []const f64, code: u32) -> f64 {
    const nominal : f64 = VCM_V * (((2 * code) as f64) - 1023.0) / 1024.0;
    return (node_volts(k, 1, code, 0.0) - nominal) * 1024.0 / VDD_V;
}

/// A new maximum must beat the old one by more than this, so the first code of a tie keeps the place (f64 noise is below it).
pub const TOL : f64 = 0.000000001;

/// The same for volts, where the differences are 1e-12.
pub const TOL_V : f64 = 0.0000000000000001;

pub struct CdacWorst { err: f64, at: u32 }

/// The largest |inl_lsb| over the 1024 codes and the first code that reaches it.
pub fn worst_inl(k: []const f64) -> CdacWorst {
    var w : CdacWorst = CdacWorst { err: 0.0, at: 0 };
    var c : u32 = 0;
    while (c < CODES) {
        const e : f64 = fabs64(inl_lsb(k, c));
        if (e > w.err + TOL) { w = CdacWorst { err: e, at: c }; }
        c = c + 1;
    }
    return w;
}

/// The largest |gain_lsb| over the 1024 codes and the first code that reaches it.
pub fn worst_gain(k: []const f64) -> CdacWorst {
    var w : CdacWorst = CdacWorst { err: 0.0, at: 0 };
    var c : u32 = 0;
    while (c < CODES) {
        const e : f64 = fabs64(gain_lsb(k, c));
        if (e > w.err + TOL) { w = CdacWorst { err: e, at: c }; }
        c = c + 1;
    }
    return w;
}

/// The largest |fixed point - f64| over the 1024 codes, in units of 2^-24 V, for one node (0 = net1, 1 = Vout): the arithmetic
/// error alone. kq are the words, kf the real ratios.
pub fn worst_arith(kq: []const u32, kf: []const f64, node: usize) -> CdacWorst {
    var w : CdacWorst = CdacWorst { err: 0.0, at: 0 };
    var c : u32 = 0;
    while (c < CODES) {
        const n : CdacNodes = convert_k(kq, c, VS_HALF);
        var word : u32 = n.m;
        if (node == 0) { word = n.l; }
        const e : f64 = fabs64(sm_f64(word) - node_volts(kf, node, c, VCM_V)) * SCALE;
        if (e > w.err + TOL) { w = CdacWorst { err: e, at: c }; }
        c = c + 1;
    }
    return w;
}

/// The largest |ngspice - f64 closed form| of Vout over the 1024 codes, in volts.
pub fn worst_ng_vs_f64(kf: []const f64) -> CdacWorst {
    var w : CdacWorst = CdacWorst { err: 0.0, at: 0 };
    var c : u32 = 0;
    while (c < CODES) {
        const e : f64 = fabs64(NG_HALF[c as usize] - node_volts(kf, 1, c, VCM_V));
        if (e > w.err + TOL_V) { w = CdacWorst { err: e, at: c }; }
        c = c + 1;
    }
    return w;
}

/// The largest |fixed point - ngspice| of Vout over the 1024 codes, in units of 2^-24 V.
pub fn worst_fixed_vs_ng(kq: []const u32) -> CdacWorst {
    var w : CdacWorst = CdacWorst { err: 0.0, at: 0 };
    var c : u32 = 0;
    while (c < CODES) {
        const e : f64 = fabs64(sm_f64(convert_k(kq, c, VS_HALF).m) - NG_HALF[c as usize]) * SCALE;
        if (e > w.err + TOL) { w = CdacWorst { err: e, at: c }; }
        c = c + 1;
    }
    return w;
}

/// An order-sensitive fold of both node words of every code, as M1 folds its states.
pub fn sweep_fold() -> u64 {
    var s : u64 = 0;
    var c : u32 = 0;
    while (c < CODES) {
        const n : CdacNodes = convert(c, VS_HALF);
        s = fold(s, n.m);
        s = fold(s, n.l);
        c = c + 1;
    }
    return s;
}

/// How many stored words differ from round(real * 2^24).
pub fn mismatches(kq: []const u32, kf: []const f64) -> usize {
    var bad : usize = 0;
    var i : usize = 0;
    while (i < 20) {
        if (q_sm(kf[i]) != kq[i]) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

/// Is every real ratio at least 1e-4 LSB away from a rounding tie?
pub fn ties_clear(kf: []const f64) -> bool {
    var ok : bool = true;
    var i : usize = 0;
    while (i < 20) {
        if (tie_gap(kf[i]) <= 0.0001) { ok = false; }
        i = i + 1;
    }
    return ok;
}

; --- the tests ------------------------------------------------------------------------------------------------------


test the_inventory_is_the_decks_63_units_in_two_arrays_of_31_and_one_bridge_unit {
    var j : usize = 0;
    var total : u32 = 0;
    var lsb : u32 = 0;
    var msb : u32 = 0;
    while (j < PLATES) {
        assert_eq(LINE_LAST[j] - LINE_FIRST[j] + 1, UNITS[j]);
        total = total + UNITS[j];
        if (SIDE[j] == SIDE_L) { lsb = lsb + UNITS[j]; } else { msb = msb + UNITS[j]; }
        j = j + 1;
    }
    assert_eq(lsb, 31);
    assert_eq(msb, 31);
    assert_eq(total + BRIDGE_UNITS, TOTAL_UNITS);
    // the lines run on without a gap inside each array, and the bridge is the line between the arrays
    j = 1;
    while (j < 5) {
        assert_eq(LINE_FIRST[j], LINE_LAST[j - 1] + 1);
        assert_eq(UNITS[j], 2 * UNITS[j - 1]);
        j = j + 1;
    }
    // Variables, not constants: an assert on a constant table element is folded by the compiler and counts as no assert at all (#12166).
    var last4 : u32 = LINE_LAST[4];
    var first5 : u32 = LINE_FIRST[5];
    assert_eq(BRIDGE_LINE, last4 + 1);
    assert_eq(first5, BRIDGE_LINE + 1);
    j = 6;
    while (j < 10) {
        assert_eq(LINE_FIRST[j], LINE_LAST[j - 1] + 1);
        assert_eq(UNITS[j], 2 * UNITS[j - 1]);
        j = j + 1;
    }
    var units0 : u32 = UNITS[0];
    var units5 : u32 = UNITS[5];
    var side4 : u8 = SIDE[4];
    var side5 : u8 = SIDE[5];
    var first0 : u32 = LINE_FIRST[0];
    var last9 : u32 = LINE_LAST[9];
    assert_eq(units0, 1);
    assert_eq(units5, 1);
    assert_eq(side4, SIDE_L);
    assert_eq(side5, SIDE_M);
    assert_eq(last9 - first0 + 1, 63);
    assert_eq(CODES, 1024);
    assert_eq(LSB * CODES, VDD);
    assert_eq(VCM * 2, VDD);
}

test the_matrix_route_and_the_closed_form_agree_and_the_deck_array_is_exactly_binary {
    const km : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 0.0);
    const kc : [20]f64 = closed_k(&UNITS, &SIDE, 1.0, 0.0);
    var worst : f64 = 0.0;
    var i : usize = 0;
    while (i < 20) {
        if (fabs64(km[i] - kc[i]) > worst) { worst = fabs64(km[i] - kc[i]); }
        i = i + 1;
    }
    assert worst < 0.000000000000001;
    // D = CL CM + Cb (CL + CM) = 31 * 31 + 62 = 1023; every Vout ratio is 2^(j - 1) / 1023, in both arrays
    var j : usize = 0;
    var sum_m : f64 = 0.0;
    var sum_l : f64 = 0.0;
    const one : u32 = 1;
    while (j < PLATES) {
        const pw : f64 = (one << (j as u32)) as f64;
        assert fabs64(km[2 * j + 1] * 1023.0 - pw) < 0.000000000001;
        sum_m = sum_m + km[2 * j + 1];
        sum_l = sum_l + km[2 * j];
        j = j + 1;
    }
    // net1 moves 32 times as far as Vout for a plate of its own array and 1 / 32 as far for a plate of the other
    assert fabs64(km[0] - 32.0 / 1023.0) < 0.000000000000001;
    assert fabs64(km[1] - 1.0 / 1023.0) < 0.000000000000001;
    assert fabs64(km[10] - 1.0 / 1023.0) < 0.000000000000001;
    assert fabs64(km[11] - 32.0 / 1023.0) < 0.000000000000001;
    // full scale: all ten plates together move Vout and net1 by exactly one plate swing
    assert fabs64(sum_m - 1.0) < 0.000000000000001;
    assert fabs64(sum_l - 1.0) < 0.000000000000001;
    // the capacitance the top plate sees: (CM + Cb) - Cb^2 / (CL + Cb) = 1023 / 32 units, not 32
    const ctop : f64 = 32.0 - 1.0 / 32.0;
    assert fabs64(ctop - 1023.0 / 32.0) < 0.000000000000001;
    assert fabs64(1.0 / ctop - 32.0 / 1023.0) < 0.000000000000001;
    // the ideal bridge is CL / 31: 1 unit for the deck's 31-unit array, 32/31 for an array that has a 32nd (dummy) unit
    assert fabs64(ideal_bridge(31.0) - 1.0) < 0.000000000000001;
    assert fabs64(ideal_bridge(32.0) - 32.0 / 31.0) < 0.000000000000001;
}

test the_stored_words_are_the_rounding_of_the_derived_ratios {
    const kf : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 0.0);
    assert_eq(mismatches(&K_Q, &kf), 0);
    assert(ties_clear(&kf));
    // the closest to a tie is 32 / 1023 * 2^24 = 524800.5005, which rounds up to 524801
    assert tie_gap(kf[0]) > 0.0004;
    assert tie_gap(kf[0]) < 0.0005;
    var kq0 : u32 = K_Q[0];
    assert_eq(kq0, 524801);
    // the words of each node add to exactly one plate swing (2^24)
    var i : usize = 0;
    var sl : u32 = 0;
    var sm : u32 = 0;
    while (i < PLATES) {
        sl = sl + K_Q[2 * i];
        sm = sm + K_Q[2 * i + 1];
        i = i + 1;
    }
    assert_eq(sl, 16777216);
    assert_eq(sm, 16777216);
}

test one_switch_event_is_m1s_step_with_a_zero_matrix {
    const x : [2]u32 = [VS_HALF, VS_HALF];
    var y : [2]u32 = [0, 0];
    // Bit_10 up: K * 0.75 is exact (K is a multiple of 8), net1 + 196800 and Vout + 6297606
    event_k(&K_Q, 9, VCM, &x, &y);
    assert_eq(y[0], VS_HALF + 196800);
    assert_eq(y[1], VS_HALF + 6297606);
    event_k(&K_Q, 9, NEG | VCM, &x, &y);
    assert_eq(y[0], VS_HALF - 196800);
    assert_eq(y[1], VS_HALF - 6297606);
    // a tie: Bit_3's net1 ratio 2099202 * 3 / 4 = 1574401.5 rounds away from zero, up and down
    event_k(&K_Q, 2, VCM, &x, &y);
    assert_eq(y[0], VS_HALF + 1574402);
    event_k(&K_Q, 2, NEG | VCM, &x, &y);
    assert_eq(y[0], VS_HALF - 1574402);
    // 524801 * 3 / 4 = 393600.75 rounds to 393601
    event_k(&K_Q, 0, VCM, &x, &y);
    assert_eq(y[0], VS_HALF + 393601);
    // a plate that does not move moves nothing
    event_k(&K_Q, 5, 0, &x, &y);
    assert_eq(y[0], VS_HALF);
    assert_eq(y[1], VS_HALF);
    // from a node at 0 V a downward event gives a negative word
    const z : [2]u32 = [0, 0];
    event_k(&K_Q, 9, NEG | VCM, &z, &y);
    assert_eq(y[1], NEG | 6297606);
    // the same numbers through M1's own step, called by name with D = 0 and Bit_10's ratios as N
    const nv : [2]u32 = [262400, 8396808];
    var w : [2]u32 = [0, 0];
    step(2, &ZD, &nv, &x, VCM, &w);
    assert_eq(w[0], VS_HALF + 196800);
    assert_eq(w[1], VS_HALF + 6297606);
    assert_eq(plate_step(true), VCM);
    assert_eq(plate_step(false), NEG | VCM);
    assert(bit_of(5, 0));
    assert(!bit_of(5, 1));
    assert(bit_of(5, 2));
}

test a_code_is_ten_events_whose_order_does_not_matter_and_whose_complement_mirrors_it {
    var c : u32 = 0;
    while (c < CODES) {
        const a : CdacNodes = convert(c, VS_HALF);
        // Bit_1 first instead of Bit_10 first: the same state, because each move is rounded alone
        var x : [2]u32 = [VS_HALF, VS_HALF];
        var y : [2]u32 = [0, 0];
        var j : usize = 0;
        while (j < PLATES) {
            event_k(&K_Q, j, plate_step(bit_of(c, j)), &x, &y);
            x[0] = y[0];
            x[1] = y[1];
            j = j + 1;
        }
        assert_eq(x[0], a.l);
        assert_eq(x[1], a.m);
        // the complement code moves every plate the other way by the same rounded amount: mirror image about the sample
        const b : CdacNodes = convert(1023 - c, VS_HALF);
        assert fabs64(sm_f64(a.m) + sm_f64(b.m) - 2.0 * VCM_V) < 0.000000000000001;
        assert fabs64(sm_f64(a.l) + sm_f64(b.l) - 2.0 * VCM_V) < 0.000000000000001;
        c = c + 1;
    }
    // the ends of the staircase: code 0 is one unit below 0 V (a negative word) and code 1023 one unit above 1.5 V, on both nodes:
    // ten rounded moves of 0.75 V that add up to a hair over the 0.75 V the sample can give
    const lo : CdacNodes = convert(0, VS_HALF);
    const hi : CdacNodes = convert(1023, VS_HALF);
    assert_eq(lo.m, NEG | 1);
    assert_eq(lo.l, NEG | 1);
    assert_eq(hi.m, VDD + 1);
    assert_eq(hi.l, VDD + 1);
}

test all_1024_codes_match_the_closed_form_within_the_arithmetic_error {
    const kf : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 0.0);
    // the closed form of the whole transfer: Vout = sample + VDD c / 1023 - VCM, by no matrix at all
    var c : u32 = 0;
    while (c < CODES) {
        const ex : f64 = VDD_V * (c as f64) / 1023.0;
        assert fabs64(node_volts(&kf, 1, c, VCM_V) - ex) < 0.00000000000001;
        c = c + 1;
    }
    // the arithmetic error alone, fixed point against the f64 sum of the same ten events, in units of 2^-24 V
    const a1 : CdacWorst = worst_arith(&K_Q, &kf, 1);
    const a0 : CdacWorst = worst_arith(&K_Q, &kf, 0);
    assert a1.err < 1.8;
    assert a1.err > 1.7;
    assert_eq(a1.at, 224);
    assert a0.err < 1.8;
    assert a0.err > 1.7;
    assert_eq(a0.at, 1016);
    // that is under one hundred-thousandth of the 10-bit half's LSB (24576 units)
    assert a1.err / LSB_F < 0.0001;
    assert a0.err / LSB_F < 0.0001;
}

test the_bridge_error_is_a_gain_term_of_half_an_lsb_and_the_staircase_is_straight {
    const kf : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 0.0);
    // shape: every weight is 2^(j - 1) times the first, so the staircase is straight
    const sh : CdacWorst = worst_inl(&kf);
    assert sh.err < 0.000000001;
    // gain: against the nominal 10-bit half (VDD / 1024 a code) the deck's Vout moves VDD c / 1023: (2 c - 1023) / 2046 LSB
    const ga : CdacWorst = worst_gain(&kf);
    assert ga.err < 0.50001;
    assert ga.err > 0.49999;
    assert_eq(ga.at, 0);
    assert gain_lsb(&kf, 0) < -0.49999;
    assert gain_lsb(&kf, 1023) > 0.49999;
    var c : u32 = 0;
    while (c < CODES) {
        const ex : f64 = (((2 * c) as f64) - 1023.0) / 2046.0;
        assert fabs64(gain_lsb(&kf, c) - ex) < 0.000000000001;
        c = c + 1;
    }
    // the gain error crosses zero in the middle of the staircase: codes 511 and 512 straddle it
    assert gain_lsb(&kf, 511) < 0.0;
    assert gain_lsb(&kf, 512) > 0.0;
    // the fixed-point converter shows the same line: its deviation from the nominal half, in LSB, is within 2e-4 of (2 c - 1023) / 2046
    c = 0;
    var worst : f64 = 0.0;
    while (c < CODES) {
        const m : CdacNodes = convert(c, VS_HALF);
        const nominal : f64 = VCM_V + VCM_V * (((2 * c) as f64) - 1023.0) / 1024.0;
        const dev : f64 = (sm_f64(m.m) - nominal) * 1024.0 / VDD_V;
        const e : f64 = fabs64(dev - (((2 * c) as f64) - 1023.0) / 2046.0);
        if (e > worst) { worst = e; }
        c = c + 1;
    }
    assert worst < 0.0002;
    // full scale: the top plate spans exactly VDD from code 0 to code 1023, a nominal 10-bit half spans 1023 / 1024 of it
    const span : f64 = node_volts(&kf, 1, 1023, 0.0) - node_volts(&kf, 1, 0, 0.0);
    assert fabs64(span - VDD_V) < 0.00000000000001;
}

test ngspice_with_ideal_capacitors_agrees_for_all_1024_codes {
    const kf : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 0.0);
    // ngspice against the f64 closed form: its own drift, 1.3e-12 V over the 10 us run, the largest at the last code
    const g : CdacWorst = worst_ng_vs_f64(&kf);
    assert g.err < 0.0000000000014;
    assert g.err > 0.0000000000012;
    assert_eq(g.at, 1023);
    // ngspice against the fixed-point converter, in units of 2^-24 V
    const f : CdacWorst = worst_fixed_vs_ng(&K_Q);
    assert f.err < 1.8;
    assert f.err > 1.7;
    assert_eq(f.at, 224);
    assert f.err / LSB_F < 0.0001;
    // and every one of the 1024 codes on its own, so a single bad code cannot hide behind the maximum
    var c : u32 = 0;
    while (c < CODES) {
        assert fabs64(NG_HALF[c as usize] - node_volts(&kf, 1, c, VCM_V)) < 0.0000000000014;
        assert fabs64(sm_f64(convert(c, VS_HALF).m) - NG_HALF[c as usize]) * SCALE < 1.8;
        c = c + 1;
    }
    // the table is the deck's: code 0 is 0 V, code 1023 is 1.5 V, and the single-bit codes are 1.5 V * 2^k / 1023
    assert fabs64(NG_HALF[0]) < 0.000000000001;
    assert fabs64(NG_HALF[1023] - VDD_V) < 0.000000000002;
    var k : u32 = 0;
    const one : u32 = 1;
    while (k < 10) {
        const code : u32 = one << k;
        assert fabs64(NG_HALF[code as usize] - VDD_V * (code as f64) / 1023.0) < 0.000000000002;
        k = k + 1;
    }
}

test the_differential_pair_spot_codes_agree_with_ngspice_and_the_closed_form {
    var i : usize = 0;
    while (i < 16) {
        const c : u32 = NG_SPOT[i];
        const p : CdacNodes = convert(c, VS_P);
        const n : CdacNodes = convert(1023 - c, VS_N);
        // each half against ngspice's float64 value, in units of 2^-24 V
        assert fabs64(sm_f64(p.m) - NG_DP[i]) * SCALE < 2.0;
        assert fabs64(sm_f64(n.m) - NG_DN[i]) * SCALE < 2.0;
        // the differential output, closed form: (sample P - sample N) + VDD (2 c - 1023) / 1023
        const ex : f64 = (VSP_V - VSN_V) + VDD_V * (((2 * c) as f64) - 1023.0) / 1023.0;
        assert fabs64((sm_f64(p.m) - sm_f64(n.m)) - ex) * SCALE < 4.0;
        assert fabs64((NG_DP[i] - NG_DN[i]) - ex) < 0.000000000003;
        // the N half is the P half mirrored: its move is the P move reversed, exactly, whatever the sample
        assert fabs64(sm_f64(p.m) + sm_f64(n.m) - (VSP_V + VSN_V)) < 0.000000000000001;
        i = i + 1;
    }
    // the spot list holds the ends, the single-bit codes, the middle and its two neighbours
    var spot0 : u32 = NG_SPOT[0];
    var spot15 : u32 = NG_SPOT[15];
    var spot9 : u32 = NG_SPOT[9];
    var spot10 : u32 = NG_SPOT[10];
    assert_eq(spot0, 0);
    assert_eq(spot15, 1023);
    assert_eq(spot9, 256);
    assert_eq(spot10, 512);
}

test the_fold_of_both_nodes_for_every_code_is_pinned {
    assert_eq(sweep_fold(), 0x7EB25FED224C52E8);
}

test one_capacitor_count_changed_breaks_the_stored_constants_and_the_ngspice_agreement {
    // Bit_8 with 3 units instead of 4: every stored word changes, the staircase bends by 28.9 LSB at code 128, ngspice is 42 mV off
    var bad : [10]u32 = UNITS;
    bad[7] = 3;
    const kb : [20]f64 = derive_k(&bad, &SIDE, 1.0, 0.0);
    assert_eq(mismatches(&K_Q, &kb), 20);
    const sh : CdacWorst = worst_inl(&kb);
    assert sh.err > 28.8;
    assert sh.err < 29.0;
    assert_eq(sh.at, 128);
    const g : CdacWorst = worst_ng_vs_f64(&kb);
    assert g.err > 0.042;
    assert g.err < 0.043;
    // the closed form follows the change too (the checker is not blind to it)
    const kc : [20]f64 = closed_k(&bad, &SIDE, 1.0, 0.0);
    assert fabs64(kb[15] - kc[15]) < 0.000000000000001;
    // a plate hung on the wrong array: Bit_6 on net1
    var ws : [10]u8 = SIDE;
    ws[5] = SIDE_L;
    const kw : [20]f64 = derive_k(&UNITS, &ws, 1.0, 0.0);
    assert(mismatches(&K_Q, &kw) > 0);
    // a bridge of two units
    const k2 : [20]f64 = derive_k(&UNITS, &SIDE, 2.0, 0.0);
    assert(mismatches(&K_Q, &k2) > 0);
    // and one unit fewer on the top plate's biggest plate
    var small : [10]u32 = UNITS;
    small[9] = 15;
    const k15 : [20]f64 = derive_k(&small, &SIDE, 1.0, 0.0);
    assert(mismatches(&K_Q, &k15) > 0);
}

test the_textbook_bridge_is_ideal_only_with_a_dummy_unit_and_the_deck_has_none {
    // the 32/31 unit bridge on the deck's 31-unit net1 array bends the staircase by 0.94 LSB (first at code 31, the first carry
    // of the MSB array); ngspice, which ran the deck's 1-unit bridge, is 1.37 mV from it
    const kt : [20]f64 = derive_k(&UNITS, &SIDE, 32.0 / 31.0, 0.0);
    const st : CdacWorst = worst_inl(&kt);
    assert st.err > 0.93;
    assert st.err < 0.94;
    assert_eq(st.at, 31);
    const gt : CdacWorst = worst_ng_vs_f64(&kt);
    assert gt.err > 0.0013;
    assert gt.err < 0.0015;
    assert_eq(gt.at, 31);
    // with the 32nd unit (a dummy to ground on net1) the same 32/31 bridge is exactly ideal: no bend, no gain error
    const kd : [20]f64 = derive_k(&UNITS, &SIDE, 32.0 / 31.0, 1.0);
    const sd : CdacWorst = worst_inl(&kd);
    const gd : CdacWorst = worst_gain(&kd);
    assert sd.err < 0.000000001;
    assert gd.err < 0.000000001;
    // and ngspice is 0.73 mV from that ideal DAC, which the deck does not build
    const ng_d : CdacWorst = worst_ng_vs_f64(&kd);
    assert ng_d.err > 0.0007;
    assert ng_d.err < 0.00075;
    // the deck's 1-unit bridge on the array with the dummy is not ideal: 0.91 LSB of bend and 0.93 LSB of gain error
    const kw : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 1.0);
    const sw : CdacWorst = worst_inl(&kw);
    const gw : CdacWorst = worst_gain(&kw);
    assert sw.err > 0.91;
    assert sw.err < 0.92;
    assert gw.err > 0.92;
    assert gw.err < 0.93;
    // the deck itself: no bend, half an LSB of gain error at the ends
    const kk : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 0.0);
    assert worst_inl(&kk).err < 0.000000001;
    assert worst_gain(&kk).err > 0.49999;
}

test a_parasitic_on_the_top_plate_scales_every_vout_ratio_and_keeps_the_staircase_straight {
    // Ct from Vout to ground joins the Vout corner of C: D' = CL (CM + Ct) + Cb (CL + CM + Ct) = 1023 + 32 Ct for the deck, so a
    // Vout ratio is 2^j / (1023 + 32 Ct): still binary (no bend), the whole staircase scaled by 1023 / (1023 + 32 Ct) (M4e, #10818)
    const k0 : [20]f64 = derive_k_top(&UNITS, &SIDE, 1.0, 0.0, 0.0);
    const kd : [20]f64 = derive_k(&UNITS, &SIDE, 1.0, 0.0);
    var i : usize = 0;
    while (i < 20) {
        assert fabs64(k0[i] - kd[i]) < 0.000000000000000001;
        i = i + 1;
    }
    const ct : f64 = 0.63;
    const kt : [20]f64 = derive_k_top(&UNITS, &SIDE, 1.0, 0.0, ct);
    const den : f64 = 1023.0 + 32.0 * ct;
    const one : u32 = 1;
    var j : usize = 0;
    while (j < PLATES) {
        const pw : f64 = (one << (j as u32)) as f64;
        assert fabs64(kt[2 * j + 1] - pw / den) < 0.000000000000001;
        // net1: a plate of its own array moves it 2^j (32 + Ct) / D', a plate of the other array 2^(j - 5) / D'
        if (j < 5) {
            assert fabs64(kt[2 * j] - pw * (32.0 + ct) / den) < 0.000000000000001;
        } else {
            assert fabs64(kt[2 * j] - pw / 32.0 / den) < 0.000000000000001;
        }
        j = j + 1;
    }
    assert worst_inl(&kt).err < 0.000000001;
    // the span from code 0 to code 1023 shrinks from VDD to VDD 1023 / (1023 + 32 Ct)
    const span : f64 = node_volts(&kt, 1, 1023, 0.0) - node_volts(&kt, 1, 0, 0.0);
    assert fabs64(span - VDD_V * 1023.0 / den) < 0.00000000000001;
    // a parasitic on the top plate is not a dummy unit: the dummy on net1 detunes the bridge and bends the staircase, Ct does not
    const kdm : [20]f64 = derive_k_top(&UNITS, &SIDE, 1.0, 0.63, 0.0);
    assert worst_inl(&kdm).err > 0.1;
}

; --- tests added for the mutation census of 2026-10-25 (issue 12098): they go at the end so the accepted line numbers hold -------

test the_closed_form_follows_a_bridge_of_two_units_and_a_dummy_unit {
    // CL = 31 + 1 dummy = 32, CM = 31, Cb = 2: D = 32 * 31 + 2 * (32 + 31) = 1118. A plate of u units on net1 moves net1 by
    // u (CM + Cb) / D = 33 u / 1118 and Vout by u Cb / D = 2 u / 1118; a plate of u units on Vout moves net1 by 2 u / 1118 and
    // Vout by u (CL + Cb) / D = 34 u / 1118. Every earlier test called closed_k with Cb = 1 and no dummy, where a multiplication by
    // the bridge, a division by it and a missing dummy all read the same.
    const kc : [20]f64 = closed_k(&UNITS, &SIDE, 2.0, 1.0);
    assert fabs64(kc[0] - 33.0 / 1118.0) < 0.00000000000001;
    assert fabs64(kc[1] - 2.0 / 1118.0) < 0.00000000000001;
    assert fabs64(kc[8] - 528.0 / 1118.0) < 0.00000000000001;
    assert fabs64(kc[9] - 32.0 / 1118.0) < 0.00000000000001;
    assert fabs64(kc[10] - 2.0 / 1118.0) < 0.00000000000001;
    assert fabs64(kc[11] - 34.0 / 1118.0) < 0.00000000000001;
    assert fabs64(kc[18] - 32.0 / 1118.0) < 0.00000000000001;
    assert fabs64(kc[19] - 544.0 / 1118.0) < 0.00000000000001;
    // the matrix route, which shares no line with the closed form, gives the same 20 ratios
    const kd : [20]f64 = derive_k(&UNITS, &SIDE, 2.0, 1.0);
    var i : usize = 0;
    while (i < 20) {
        assert fabs64(kc[i] - kd[i]) < 0.00000000000001;
        i = i + 1;
    }
}

test the_worst_gain_search_keeps_the_first_code_of_an_exact_tie {
    // Every Vout ratio is 2^30, so a code with n bits set sits at 0.75 * 2^30 * (2 n - 10) V: code 0 at -8053063680 V and code 1023
    // at +8053063680 V, whose gain errors are exact negatives of each other. At 5.5e12 LSB half an ulp is far above the 1e-9
    // tolerance, so `e > best + TOL` is false on the tie and the first code (0) keeps the place; `>=` would hand it to code 1023.
    var kb : [20]f64 = [0.0] ** 20;
    var i : usize = 0;
    while (i < 20) {
        kb[i] = 1073741824.0;
        i = i + 1;
    }
    assert node_volts(&kb, 1, 0, 0.0) == 0.0 - 8053063680.0;
    assert node_volts(&kb, 1, 1023, 0.0) == 8053063680.0;
    assert fabs64(gain_lsb(&kb, 0)) == fabs64(gain_lsb(&kb, 1023));
    const w : CdacWorst = worst_gain(&kb);
    assert_eq(w.at, 0);
    assert w.err > 5.4975e12;
    assert w.err < 5.4976e12;
    assert w.err + TOL == w.err;
}

test the_worst_inl_search_keeps_the_first_code_of_an_exact_tie {
    // Only the two top Vout ratios are set: w9 = 2^40 + 682 and w8 = -2^40. Code 0 is at -511.5 V and code 1023 at +511.5 V
    // (0.75 * 682 = 511.5), so the line through them has an LSB of exactly 1. Codes 511 and 512 then sit at -+(1.5 * 2^40 + 511)
    // from it: the same |INL| to the last bit, the first of them 511. At that size the 1e-9 tolerance is below half an ulp, so the
    // first code of the tie keeps the place; `>=` would hand it to code 512.
    var kb : [20]f64 = [0.0] ** 20;
    kb[17] = 0.0 - 1099511627776.0;
    kb[19] = 1099511627776.0 + 682.0;
    assert node_volts(&kb, 1, 0, 0.0) == 0.0 - 511.5;
    assert node_volts(&kb, 1, 1023, 0.0) == 511.5;
    assert fabs64(inl_lsb(&kb, 511)) == fabs64(inl_lsb(&kb, 512));
    const w : CdacWorst = worst_inl(&kb);
    assert_eq(w.at, 511);
    assert w.err > 1649267442174.5;
    assert w.err < 1649267442175.5;
    assert w.err + TOL == w.err;
}

test the_worst_arith_search_keeps_the_first_code_of_an_exact_tie_and_finds_no_worst_code_on_a_zero_grid {
    // Stored words of zero leave both nodes at the sampled 0.75 V for every code.
    var kz : [20]u32 = K_Q;
    var i : usize = 0;
    while (i < 20) {
        kz[i] = 0;
        i = i + 1;
    }
    assert_eq(convert_k(&kz, 0, VS_HALF).m, VS_HALF);
    assert_eq(convert_k(&kz, 1023, VS_HALF).l, VS_HALF);
    // against real ratios of zero as well the error is exactly 0 at every code: no code beats the 0 it starts from by more than the
    // tolerance, so the first code keeps the place and the worst is 0; `e > best - TOL` would take every code and end on 1023.
    const kf0 : [20]f64 = [0.0] ** 20;
    const z1 : CdacWorst = worst_arith(&kz, &kf0, 1);
    const z0 : CdacWorst = worst_arith(&kz, &kf0, 0);
    assert z1.err == 0.0;
    assert z0.err == 0.0;
    assert_eq(z1.at, 0);
    assert_eq(z0.at, 0);
    // real ratios of 2^30 on both nodes: code 0 and code 1023 are 8053063680 V under and over the 0.75 V of the words, the same error
    // to the last bit, 8053063680 * 2^24 raw units, where the tolerance is far below half an ulp. The first code keeps the place;
    // `>=` would hand it to code 1023.
    var kf : [20]f64 = [0.0] ** 20;
    i = 0;
    while (i < 20) {
        kf[i] = 1073741824.0;
        i = i + 1;
    }
    const t1 : CdacWorst = worst_arith(&kz, &kf, 1);
    const t0 : CdacWorst = worst_arith(&kz, &kf, 0);
    assert_eq(t1.at, 0);
    assert_eq(t0.at, 0);
    assert t1.err == 8053063680.0 * SCALE;
    assert t0.err == 8053063680.0 * SCALE;
    assert t1.err + TOL == t1.err;
}

test the_worst_search_against_ngspice_keeps_the_first_code_of_an_exact_tie {
    // Every Vout ratio 2^30 again. Code 0 is 8053063679.25 V under ngspice's -1.15e-14 V and code 1023 is 8053063680.75 V over its
    // 1.4999999999987 V: 8053063679.25 V both, because the ngspice values are far below half an ulp (4.8e-7) of a number that
    // size. The first code keeps the place; `>=` would hand it to code 1023.
    var kf : [20]f64 = [0.0] ** 20;
    var i : usize = 0;
    while (i < 20) {
        kf[i] = 1073741824.0;
        i = i + 1;
    }
    assert fabs64(NG_HALF[0] - node_volts(&kf, 1, 0, VCM_V)) == 8053063679.25;
    assert fabs64(NG_HALF[1023] - node_volts(&kf, 1, 1023, VCM_V)) == 8053063679.25;
    const w : CdacWorst = worst_ng_vs_f64(&kf);
    assert_eq(w.at, 0);
    assert w.err == 8053063679.25;
    assert w.err + TOL_V == w.err;
}

test the_rounding_tie_gate_reads_a_gap_of_one_ten_thousandth_as_the_edge_and_never_meets_it {
    // all-zero ratios are half an LSB from a tie
    var kf : [20]f64 = [0.0] ** 20;
    assert(ties_clear(&kf));
    // a ratio 0.00005 LSB under a tie (x = 1000.49995 LSB) is inside the gate, one 0.0002 under it is outside
    kf[7] = 1000.49995 / 16777216.0;
    assert(!ties_clear(&kf));
    kf[7] = 1000.4998 / 16777216.0;
    assert(ties_clear(&kf));
    // The gate never meets a gap of exactly 0.0001, so `<=` and `<` read the same on every input. x = |v| * 2^24; f = x - floor(x)
    // is a multiple of 2^-53 when it is at least 0.5 and of 2^-54 below that, and the gap |f - 0.5| (rounded to the grid of
    // [0.25, 0.5) when f is under 0.25) stays a multiple of 2^-54. The literal 0.0001 is not: scaled by 2^54 it has a fraction.
    const scaled : f64 = fabs64(0.0001) * 18014398509481984.0;
    const whole : f64 = ((fabs64(0.0001) * 18014398509481984.0) as u64) as f64;
    assert whole < scaled;
    assert scaled - whole > 0.19;
    assert scaled - whole < 0.2;
}
