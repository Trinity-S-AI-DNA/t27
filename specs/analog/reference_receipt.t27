// SPDX-License-Identifier: Apache-2.0
; specs/analog/reference_receipt.t27 -- the reference-chain receipt contract of TASK-R
; (issue #12027, requirements 1 and 2; the analog epic #10486). A reference receipt (a
; board or ngspice receipt that claims the pinned reference chain) carries six mandatory
; fields: the PDK pin commit, the ngspice version line, the OpenVAF commit or exact
; version that built the OSDI, the OSDI version string, the run date and host, and the
; deck file the run used. A field that is empty, a placeholder ("TBD", "?", "<commit>",
; "<version>", ...) or the fallback phrase "not recorded" is a MISSING field: the receipt
; is refused, not published with a gap. The ngspice major version must be the pinned 47.
; A receipt whose fields are all filled is a FILLED receipt; the reference chain is
; CONFIRMED only when a load test of the OSDI module (ngspice loading PSP103_module.include
; and exiting 0) is also seen. Filled without a load test is refused as not confirmed, not
; silently upgraded. Where the values come from: the OpenVAF identity is the full commit or
; exact version of the OpenVAF that built psp103.osdi (`openvaf --version` or the image
; build log -- one tool may print only a short version, so the SOURCE COMMAND is recorded
; beside the value and the value alone is not evidence of the build); the OSDI version is
; the string the OSDI module itself reports (`strings psp103.osdi | grep -i osdi`); the
; ngspice line is the first line of `ngspice -v`. Reading files and splitting headers into
; fields is the caller's work (the same boundary line disclosure.t27 draws); everything
; decided about the values is here. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogReferenceReceipt;

use claw::recipes::str_eq;
use t27os::disclosure::is_placeholder;

/// The six mandatory fields, in receipt order.
pub const FIELD_PDK_PIN : u8 = 0;
pub const FIELD_NGSPICE : u8 = 1;
pub const FIELD_OPENVAF : u8 = 2;
pub const FIELD_OSDI : u8 = 3;
pub const FIELD_RUN_STAMP : u8 = 4;
pub const FIELD_DECK : u8 = 5;
pub const FIELD_COUNT : u8 = 6;
/// No field is at fault.
pub const FIELD_NONE : u8 = 255;

/// The pinned ngspice major version of the analog receipts (#12027, the decks' headers).
pub const NGSPICE_PINNED_MAJOR : u32 = 47;

/// The verdict on one receipt.
pub const RR_OK : u8 = 0;
pub const RR_MISSING : u8 = 1;
pub const RR_PLACEHOLDER : u8 = 2;
pub const RR_NOT_PINNED_NGSPICE : u8 = 3;
pub const RR_NO_LOAD_TEST : u8 = 4;

/// A value that is not data: empty, the recorded fallback, a template placeholder, or a
/// prompt-style angle-bracket hole. The common placeholder list is disclosure.t27's
/// (reuse, not a copy); what is receipt-specific here: the empty string, the #12027
/// fallback "not recorded" (it documents an unanswered request, it is not a value), and
/// the unfilled template holes of the TASK-R header schema.
pub fn is_receipt_placeholder(v: str) -> bool {
    if (str_eq(v, "")) { return true; }
    if (is_placeholder(v)) { return true; }
    if (str_eq(v, "not recorded")) { return true; }
    if (str_eq(v, "<commit>")) { return true; }
    if (str_eq(v, "<version>")) { return true; }
    if (str_eq(v, "<command output>")) { return true; }
    return false;
}

/// 0 when the value is usable, else the RR_* reason it is not.
pub fn field_fault(v: str) -> u8 {
    if (is_receipt_placeholder(v)) { return RR_MISSING; }
    return RR_OK;
}

/// The first field at fault, in receipt order, or FIELD_NONE.
pub fn first_bad_field(pdk_pin: str, ngspice: str, openvaf: str, osdi: str, run_stamp: str, deck: str) -> u8 {
    if (field_fault(pdk_pin) != RR_OK) { return FIELD_PDK_PIN; }
    if (field_fault(ngspice) != RR_OK) { return FIELD_NGSPICE; }
    if (field_fault(openvaf) != RR_OK) { return FIELD_OPENVAF; }
    if (field_fault(osdi) != RR_OK) { return FIELD_OSDI; }
    if (field_fault(run_stamp) != RR_OK) { return FIELD_RUN_STAMP; }
    if (field_fault(deck) != RR_OK) { return FIELD_DECK; }
    return FIELD_NONE;
}

/// The verdict on one receipt. All six fields must be usable data, the ngspice major
/// version must be the pinned 47, and the reference chain is confirmed only when a load
/// test of the OSDI module was seen. load_test_seen is false when the run was never made
/// or its exit code was not 0: either way the chain is not confirmed.
pub fn receipt_verdict(pdk_pin: str, ngspice: str, openvaf: str, osdi: str, run_stamp: str, deck: str, ngspice_major: u32, load_test_seen: bool) -> u8 {
    var f : u8 = field_fault(pdk_pin);
    if (f != RR_OK) { return f; }
    f = field_fault(ngspice);
    if (f != RR_OK) { return f; }
    f = field_fault(openvaf);
    if (f != RR_OK) { return f; }
    f = field_fault(osdi);
    if (f != RR_OK) { return f; }
    f = field_fault(run_stamp);
    if (f != RR_OK) { return f; }
    f = field_fault(deck);
    if (f != RR_OK) { return f; }
    if (ngspice_major != NGSPICE_PINNED_MAJOR) { return RR_NOT_PINNED_NGSPICE; }
    if (load_test_seen == false) { return RR_NO_LOAD_TEST; }
    return RR_OK;
}

// The values below are FIXTURES: they exercise the field handling, they are NOT a real
// receipt and pin no measurement. Every fixture string carries the fixture_ prefix or is
// an explicitly broken variant of one.

test fixture_a_full_receipt_with_a_load_test_is_confirmed {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47 written by Holger Vogt", "fixture-openvaf-sha", "fixture-osdi-1.0", "2026-11-02T00:00Z fixture-host", "specs/analog/decks/accept_dff.cir", 47, true) == RR_OK;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir") == FIELD_NONE;
}

test fixture_a_missing_openvaf_commit_refuses_the_receipt {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 47, true) == RR_MISSING;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir") == FIELD_OPENVAF;
}

test fixture_a_missing_osdi_version_refuses_the_receipt {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "", "fixture-stamp", "fixture-deck.cir", 47, true) == RR_MISSING;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "", "fixture-stamp", "fixture-deck.cir") == FIELD_OSDI;
}

test fixture_template_placeholders_are_not_data {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "<commit>", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 47, true) == RR_MISSING;
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "<version>", "fixture-stamp", "fixture-deck.cir", 47, true) == RR_MISSING;
    assert is_receipt_placeholder("<command output>") == true;
    assert is_receipt_placeholder("openvaf 0.9.0 (build 1a2b3c)") == false;
    assert is_receipt_placeholder("TBD") == true;
    assert is_placeholder("TBD") == true;
}

test fixture_the_not_recorded_fallback_is_a_gap_not_a_value {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "not recorded", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 47, true) == RR_MISSING;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "not recorded", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir") == FIELD_OPENVAF;
}

test fixture_a_wrong_ngspice_major_refuses_the_receipt {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-44", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 44, true) == RR_NOT_PINNED_NGSPICE;
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 44, true) == RR_NOT_PINNED_NGSPICE;
}

test fixture_without_a_load_test_the_chain_is_not_confirmed {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 47, false) == RR_NO_LOAD_TEST;
}

test fixture_the_pdk_pin_may_not_be_a_placeholder {
    assert receipt_verdict("", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 47, true) == RR_MISSING;
    assert first_bad_field("?", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir") == FIELD_PDK_PIN;
}

test fixture_the_deck_and_run_stamp_fields_are_mandatory {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "", 47, true) == RR_MISSING;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "", "fixture-deck.cir") == FIELD_RUN_STAMP;
}

test fixture_the_first_bad_field_reports_the_earliest_fault_in_receipt_order {
    assert first_bad_field("", "", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir") == FIELD_PDK_PIN;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "", "<version>", "not recorded", "", "") == FIELD_NGSPICE;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "", "<version>", "", "") == FIELD_OPENVAF;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "", "not recorded", "") == FIELD_OSDI;
    assert first_bad_field("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "?", "-") == FIELD_RUN_STAMP;
}

test fixture_a_wrong_ngspice_major_does_not_mask_a_missing_field {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 46, true) == RR_MISSING;
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 48, false) == RR_MISSING;
}

test fixture_the_major_boundary_is_exactly_the_pinned_47 {
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 47, true) == RR_OK;
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 46, true) == RR_NOT_PINNED_NGSPICE;
    assert receipt_verdict("21133f219b1a6da10d803e345761e77415ceff40", "ngspice-47", "fixture-openvaf-sha", "fixture-osdi-1.0", "fixture-stamp", "fixture-deck.cir", 48, true) == RR_NOT_PINNED_NGSPICE;
}
