// SPDX-License-Identifier: Apache-2.0
; specs/analog/raw_writer.t27 -- analog waveforms as ngspice RAW files: the writer, and the reader that judges it
; M5 of the analog emulation epic (#10486, issue #10909), first slice. A trace the cells produce is written as the file
; ngspice's own `write` writes (ASCII or binary), so a designer opens it in uberWAVE or ngspice next to ngspice's traces.
; Everything hand-written is this file; `tri raw` only allocates buffers and writes the bytes this file produces.
; -
; THE FORMAT is read off ngspice-47, not from a manual: specs/analog/decks/raw_ref.cir writes one transient as ASCII and
; as binary, and both files are embedded below (SM_A0.., SM_H0..). Header, one line each: Title, Date, Command (optional),
; Plotname, "Flags: real", "No. Variables: N", "No. Points: P", "Variables:", N lines "<TAB>index<TAB>name<TAB>type", then
; "Values:" or "Binary:". An ASCII point is " index<TAB>v0" (a space, then the index in decimal, no padding), "<TAB>vj" for
; each other variable, each value on its own line, and an empty line; every value is C's "%.15e". A binary point is N
; little-endian f64. Three things the reference taught: the index has a single leading space at every width (" 9", " 10",
; " 100"); the Command: line is a command that ngspice EXECUTES when it loads the file ("misplaced Command: line", or
; "no such command available"), so the files written here carry none, and the Date line is a parameter only so that
; tests are deterministic; and `ngspice -r` pads the point count with spaces once the simulation ends, which the reader accepts.
; -
; THE NUMBERS. A "%.15e" value is 16 significant digits of the EXACT binary value, rounded to nearest, a tie to the even
; digit. f64 arithmetic cannot do that, so the digits come from the exact decimal expansion: |x| = m * 2^e becomes the
; integer m * 2^e (e >= 0) or m * 5^-e read with the point -e digits from the right, held in base-1e9 limbs (at most 767
; digits; 90 limbs are provided). The result equals Python's '%.15e' on 35 vectors, ties and carries and subnormals and
; the largest double included, and ngspice's own text on all 60 values of the reference. The f64 <-> bits pair is built
; from arithmetic as well (raw_to_bits, raw_from_bits; exact for every finite f64, checked against @bitCast in a test),
; because gen-rust prints @bitCast as written and rustc refuses it (#10920).
; -
; THE FILE. raw_write takes the variable table ("name<TAB>type<LF>" lines, the Variables: block without its indexes), the
; values time-major (point p, variable v is vals[p * nv + v]) and the Date line. Every writer returns the cursor in its
; output buffer and counts a byte that does not fit without writing it, so the length a file needs is known from a short
; buffer. raw_check is the reader that judges a file: header lines in order, the counts against the body, the body's shape.
; -
; THE TRACE. raw_cell_trace runs circuit 2 of specs/analog/linear.t27 (the series RLC, R = 100 Ohm, L = 10 uH, C = 1 nF,
; dt = 5 ns, IN = 1 V for 100 steps then 0 V) with that file's own words (step_row, vin_at, fold) and writes 201 points: point
; 0 at rest, then one point per update. The fold of every state word equals the RLC_EXP_S that linear.t27 pins, so the trace is
; that simulation and not a re-implementation. The variables carry the names ngspice gives the nodes of decks/rlc_fixed.cir
; (v(in), v(1), v(2), i(l1)); that deck's time axis is this one shifted by 42.5 ns, the instant its source turns on.
; -
; THE TESTS. (1) The ASCII file the writer makes for the 15-point, 4-variable reference equals ngspice's, byte for byte,
; Date line included (the date is the same parameter); so does the binary file. (2) The reader accepts ngspice's own two
; files and reads the binary values back bit for bit. (3) Negative controls: a header that says one point too many or too
; few, one variable too many or too few, a body with the wrong values per point, a wrong index, a broken value, a missing
; flags line or mode line, a binary file one byte short or long: each is refused with its own reason. (4) The RLC trace
; passes the reader in both modes, its binary decodes exactly, and a trace with one stored constant's sign flipped is
; not the pinned simulation.
; -
; WHAT A PASS SAYS. The writer reproduces ngspice-47's own bytes for the reference transient, in both modes, and its
; %.15e is the C library's on the vectors above. The reader refuses the lies listed. The RLC trace is the cell's pinned simulation.
; WHAT IT DOES NOT SAY. That ngspice or uberWAVE loads the file: no test here runs either; the PR that adds this file shows
; `load` and `print` in ngspice and uberWAVE's wp2-parser (GPL-2.0, fetched and built for the check, never vendored) reading it.
; Nothing about a complex-valued file (AC), a file of several plots, or any header line beyond the ones above. A negative zero
; is written as zero, because arithmetic cannot see its sign; a NaN or an infinity is written as "nan", "inf", "-inf" in ASCII
; and as its canonical pattern in binary (which raw_from_bits reads back as 0). The ASCII file holds 16 significant digits, so a
; reader gets each value to better than 1e-15 relative (4.4e-16 measured on the RLC trace); the binary file is exact. Nothing about the waveform's physics: the values are the cell's words in volts, no
; more accurate than the cell (linear.t27 states its error), and nothing is claimed against ngspice's trace of the same
; circuit here. Nothing about a board.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogRawWriter;

use analog::linear::{step_row, vin_at, sm_f64, fold, RLC_N, RLC_D, RLC_NV, RLC_DT, RLC_ZS, RLC_EXP_S, STEPS};

pub const KIND : str = "analog-raw-writer";
pub const ID : str = "analog/raw_writer";
pub const REFERENCE : str = "ngspice-47 write, ASCII and binary";

; --- sizes ----------------------------------------------------------------------------------------
/// One limb of the exact decimal expansion holds 9 digits.
pub const RAW_BASE : u64 = 1000000000;
/// 90 limbs = 810 digits; the longest expansion of a finite f64 (m * 5^1074) has 767.
pub const RAW_LIMBS : usize = 90;
pub const RAW_DIGITS : usize = 810;
/// %.15e: 16 significant digits.
pub const RAW_SIG : usize = 16;

pub struct RawParts { m: u64, e: i32 }

/// |x| = m * 2^e exactly, with m odd or e >= 0 (x finite, nonzero).
pub fn raw_parts(x: f64) -> RawParts {
    var y : f64 = x;
    if (y < 0.0) { y = 0.0 - y; }
    var e : i32 = 0;
    while (y >= 9007199254740992.0) {
        y = y / 2.0;
        e = e + 1;
    }
    while (y < 4503599627370496.0) {
        y = y * 2.0;
        e = e - 1;
    }
    var m : u64 = y as u64;
    while (e < 0 and m % 2 == 0) {
        m = m / 2;
        e = e + 1;
    }
    return RawParts { m: m, e: e };
}

test parts_of_small_numbers {
    const p : RawParts = raw_parts(1.0);
    assert(p.m == 1);
    assert(p.e == 0);
    const q : RawParts = raw_parts(-0.5);
    assert(q.m == 1);
    assert(q.e == -1);
    const r : RawParts = raw_parts(3.0);
    assert(r.m == 3);
    assert(r.e == 0);
    const s : RawParts = raw_parts(8.0);
    assert(s.m == 8);
    assert(s.e == 0);
}

; --- the exact decimal expansion of a finite f64 --------------------------------------------------
; |x| = m * 2^e. For e >= 0 the integer m * 2^e; for e < 0 the integer m * 5^-e read with the point -e digits from the
; right (m / 2^k = m * 5^k / 10^k). The integer lives in base-1e9 limbs, least significant first, and is only ever
; multiplied by a small number, so every product fits u64 (1e9 * 2^31 < 2^62).

/// base^n for a small n.
pub fn raw_pow(base: u64, n: u32) -> u64 {
    var r : u64 = 1;
    var i : u32 = 0;
    while (i < n) {
        r = r * base;
        i = i + 1;
    }
    return r;
}

/// a[0..n) times k (k < 2^31), in place; the new limb count (a carry past the end of a is dropped, never written).
pub fn raw_mul(a: []u64, n: usize, k: u64) -> usize {
    var carry : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        const t : u64 = a[i] * k + carry;
        a[i] = t % RAW_BASE;
        carry = t / RAW_BASE;
        i = i + 1;
    }
    var cnt : usize = n;
    while (carry > 0) {
        if (cnt < a.len) { a[cnt] = carry % RAW_BASE; }
        carry = carry / RAW_BASE;
        cnt = cnt + 1;
    }
    return cnt;
}

/// The limbs of m * 2^e (e >= 0) or m * 5^-e (e < 0) into a; the limb count.
pub fn raw_expand(m: u64, e: i32, a: []u64) -> usize {
    a[0] = m % RAW_BASE;
    a[1] = (m / RAW_BASE) % RAW_BASE;
    a[2] = m / RAW_BASE / RAW_BASE;
    var n : usize = 3;
    var left : i32 = e;
    var big : u64 = 1073741824;
    var chunk : i32 = 30;
    var base : u64 = 2;
    if (e < 0) {
        left = 0 - e;
        big = 1220703125;
        chunk = 13;
        base = 5;
    }
    while (left >= chunk) {
        n = raw_mul(a, n, big);
        left = left - chunk;
    }
    if (left > 0) { n = raw_mul(a, n, raw_pow(base, left as u32)); }
    return n;
}

/// The decimal digits (0..9, most significant first, no leading zero) of a[0..n) into d; the digit count. a is nonzero.
pub fn raw_digits(a: []const u64, n: usize, d: []u8) -> usize {
    var cnt : usize = 0;
    var i : usize = n;
    while (i > 0) {
        i = i - 1;
        var div : u64 = 100000000;
        var j : usize = 0;
        while (j < 9) {
            const dg : u8 = ((a[i] / div) % 10) as u8;
            if (cnt > 0 or dg != 0) {
                d[cnt] = dg;
                cnt = cnt + 1;
            }
            div = div / 10;
            j = j + 1;
        }
    }
    return cnt;
}

test the_expansion_of_powers_is_exact {
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    // 2^64 = 18446744073709551616 (20 digits)
    const n : usize = raw_expand(1, 64, &a);
    const c : usize = raw_digits(&a, n, &d);
    assert(c == 20);
    assert(d[0] == 1);
    assert(d[1] == 8);
    assert(d[19] == 6);
    assert(d[18] == 1);
}

test the_expansion_of_a_fraction_is_exact {
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    // 1/2^10 = 5^10 / 10^10 = 9765625 / 10^10: 7 digits
    const n : usize = raw_expand(1, -10, &a);
    const c : usize = raw_digits(&a, n, &d);
    assert(c == 7);
    assert(d[0] == 9);
    assert(d[6] == 5);
}

; --- %.15e, exactly -------------------------------------------------------------------------------
; ngspice writes every ASCII value with C's "%.15e": 16 significant digits of the exact binary value, rounded to nearest,
; a tie to the even digit. The digits come from the exact expansion above, not from f64 arithmetic, so the rounding is
; the C library's rounding on every input, including the ties and the carries (9.9999...95e-1).

/// The 16 significant digits of |x| (x finite, nonzero), rounded, left in d[0..16) as values 0..9; the decimal exponent of
/// the first one. a and d are scratch: RAW_LIMBS limbs and RAW_DIGITS digits.
pub fn raw_sig(x: f64, a: []u64, d: []u8) -> i32 {
    const p : RawParts = raw_parts(x);
    const n : usize = raw_expand(p.m, p.e, a);
    const nd : usize = raw_digits(a, n, d);
    var ex : i32 = (nd as i32) - 1;
    if (p.e < 0) { ex = ex + p.e; }
    var up : bool = false;
    if (nd > RAW_SIG) {
        var rest : bool = false;
        var j : usize = RAW_SIG + 1;
        while (j < nd) {
            if (d[j] != 0) { rest = true; }
            j = j + 1;
        }
        up = d[RAW_SIG] > 5 or (d[RAW_SIG] == 5 and (rest or d[RAW_SIG - 1] % 2 == 1));
    }
    var i : usize = nd;
    while (i < RAW_SIG) {
        d[i] = 0;
        i = i + 1;
    }
    if (up) {
        var k : usize = RAW_SIG;
        var carry : bool = true;
        while (carry and k > 0) {
            k = k - 1;
            if (d[k] == 9) {
                d[k] = 0;
            } else {
                d[k] = d[k] + 1;
                carry = false;
            }
        }
        if (carry) {
            d[0] = 1;
            ex = ex + 1;
        }
    }
    return ex;
}

; --- bytes out ------------------------------------------------------------------------------------
; Every writer takes the output buffer and a write cursor and returns the new cursor. A byte that does not fit is not
; written but still counted, so the cursor after a call is the length the whole text needs (size it with a short buffer).

/// One byte at w if it fits; the new cursor.
pub fn raw_put(out: []u8, w: usize, c: u8) -> usize {
    if (w < out.len) { out[w] = c; }
    return w + 1;
}

/// The bytes of s; the new cursor.
pub fn raw_puts(out: []u8, w: usize, s: []const u8) -> usize {
    var p : usize = w;
    var i : usize = 0;
    while (i < s.len) {
        p = raw_put(out, p, s[i]);
        i = i + 1;
    }
    return p;
}

/// v in decimal; the new cursor.
pub fn raw_put_uint(out: []u8, w: usize, v: u64) -> usize {
    var p : usize = w;
    if (v >= 10) { p = raw_put_uint(out, p, v / 10); }
    return raw_put(out, p, 48 + ((v % 10) as u8));
}

/// x as C's "%.15e" prints it: [-]d.ddddddddddddddde[+-]dd (three exponent digits when the exponent needs them). A NaN is
/// "nan"; an infinity "inf" or "-inf". A negative zero cannot be told from zero without its bits and is written as 0.
pub fn raw_put_f64(out: []u8, w: usize, x: f64, a: []u64, d: []u8) -> usize {
    if (x != x) { return raw_puts(out, w, "nan"); }
    if (x - x != 0.0) {
        if (x < 0.0) { return raw_puts(out, w, "-inf"); }
        return raw_puts(out, w, "inf");
    }
    var p : usize = w;
    if (x < 0.0) { p = raw_put(out, p, 45); }
    if (x == 0.0) { return raw_puts(out, p, "0.000000000000000e+00"); }
    const ex : i32 = raw_sig(x, a, d);
    p = raw_put(out, p, 48 + d[0]);
    p = raw_put(out, p, 46);
    var i : usize = 1;
    while (i < RAW_SIG) {
        p = raw_put(out, p, 48 + d[i]);
        i = i + 1;
    }
    p = raw_put(out, p, 101);
    var ea : u64 = 0;
    if (ex < 0) {
        p = raw_put(out, p, 45);
        ea = (0 - ex) as u64;
    } else {
        p = raw_put(out, p, 43);
        ea = ex as u64;
    }
    if (ea < 10) { p = raw_put(out, p, 48); }
    return raw_put_uint(out, p, ea);
}

; --- the f64 <-> bits pair, in arithmetic ----------------------------------------------------------
; Exact for every finite f64 and built from + * / and compares only, so every backend lowers it (gen-rust passes @bitCast
; through unchanged, which rustc refuses; see the issue named in the header). Negative zero reads as zero.

/// The IEEE 754 binary64 pattern of x. -0.0 gives the pattern of 0.0; a NaN gives 0x7FF8000000000000, an infinity 0x7FF0000000000000
/// (0xFFF0000000000000 for -inf).
pub fn raw_to_bits(x: f64) -> u64 {
    if (x != x) { return 0x7FF8000000000000; }
    if (x - x != 0.0) {
        if (x < 0.0) { return 0xFFF0000000000000; }
        return 0x7FF0000000000000;
    }
    if (x == 0.0) { return 0; }
    var sign : u64 = 0;
    if (x < 0.0) { sign = 9223372036854775808; }
    const p : RawParts = raw_parts(x);
    var m : u64 = p.m;
    var e : i32 = p.e;
    while (m < 4503599627370496) {
        m = m * 2;
        e = e - 1;
    }
    const be : i32 = e + 1075;
    if (be >= 1) { return sign | ((be as u64) << 52) | (m - 4503599627370496); }
    return sign | (m >> ((1 - be) as u32));
}

/// The finite f64 of a binary64 pattern. An infinity or a NaN pattern (exponent field 2047) reads as 0.0: this file
/// only reads what it wrote, and it writes no such pattern.
pub fn raw_from_bits(b: u64) -> f64 {
    const ex : i32 = ((b >> 52) & 2047) as i32;
    if (ex == 2047) { return 0.0; }
    var m : f64 = (b & 4503599627370495) as f64;
    var e : i32 = 0 - 1074;
    if (ex > 0) {
        m = m + 4503599627370496.0;
        e = ex - 1075;
    }
    while (e > 0) {
        m = m * 2.0;
        e = e - 1;
    }
    while (e < 0) {
        m = m / 2.0;
        e = e + 1;
    }
    if ((b >> 63) != 0) { return 0.0 - m; }
    return m;
}

/// Eight bytes, least significant first.
pub fn raw_put_le64(out: []u8, w: usize, b: u64) -> usize {
    var p : usize = w;
    var i : u32 = 0;
    while (i < 8) {
        p = raw_put(out, p, ((b >> (i * 8)) & 255) as u8);
        i = i + 1;
    }
    return p;
}

/// Does out hold s starting at `at`?
pub fn raw_at(out: []const u8, at: usize, s: []const u8) -> bool {
    if (at + s.len > out.len) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (out[at + i] != s[i]) { return false; }
        i = i + 1;
    }
    return true;
}

; --- test vectors: every expected line was printed by Python 3's '%.15e' % x (correctly rounded, ties to even, as the C
; library does) for the double with the pattern in FMT_BITS: round and short numbers, 1e-11 (just below the decimal),
; 1e23, exact ties that round down and up and carry (3000000000000000.5, ...1.5, 3999999999999999.5), the subnormals,
; the smallest normal and the largest double, and a dozen random ones across 1e-33 .. 1e37.
pub const FMT_N : usize = 35;
pub const FMT_BITS : [35]u64 = [
    0x3FF0000000000000, 0xBFF0000000000000, 0x3FE0000000000000,
    0x3FB999999999999A, 0x3DA5FD7FE1796495, 0x40FE240000000000,
    0xBE90C6F7A0B5ED8D, 0x44B52D02C7E14AF6, 0x4480F0CF064DD592,
    0x432550F7DCA70001, 0x432550F7DCA70003, 0x432C6BF52633FFFF,
    0x0010000000000000, 0x0000000000000001, 0x7FEFFFFFFFFFFFFF,
    0x0000000000000003, 0x3FD3333333333334, 0x0000000000000007,
    0x7FE0000000000000, 0x3FEFFFFFFFFFFFFF, 0x3FF0000000000001,
    0x4340000000000000, 0x4330000000000002, 0x4435D520A5380AA8,
    0xBF0FD59DF2BE23E8, 0xB939810A6433D164, 0xC5DAF833936FC075,
    0x41597E6720897B22, 0xC22D7DE32E66009E, 0xBD7F11CF951E0441,
    0x396DD25E7837A7EB, 0x46AE6AE32324C5F6, 0x47C978CD87E8DCA8,
    0x429179806751334A, 0x43418120C1445D0A,
];
pub const FMT_0 : str = "1.000000000000000e+00\n-1.000000000000000e+00\n5.000000000000000e-01\n1.000000000000000e-01\n9.999999999999999e-12\n";
pub const FMT_1 : str = "1.234560000000000e+05\n-2.500000000000000e-07\n9.999999999999999e+22\n1.000000000000000e+22\n3.000000000000000e+15\n";
pub const FMT_2 : str = "3.000000000000002e+15\n4.000000000000000e+15\n2.225073858507201e-308\n4.940656458412465e-324\n1.797693134862316e+308\n";
pub const FMT_3 : str = "1.482196937523740e-323\n3.000000000000000e-01\n3.458459520888726e-323\n8.988465674311580e+307\n9.999999999999999e-01\n";
pub const FMT_4 : str = "1.000000000000000e+00\n9.007199254740992e+15\n4.503599627370498e+15\n4.027390819373495e+20\n-6.071937818236795e-05\n";
pub const FMT_5 : str = "-4.911904212198047e-33\n-3.338666967613588e+28\n6.683036508391174e+06\n-6.333304606700121e+10\n-1.766100792077441e-12\n";
pub const FMT_6 : str = "4.594768720539267e-32\n3.084703844596761e+32\n6.771588835897009e+37\n4.803385742412822e+12\n9.854104571001364e+15\n";

test the_bits_round_trip_and_match_ieee {
    assert(raw_to_bits(1.0) == 0x3FF0000000000000);
    assert(raw_to_bits(-2.0) == 0xC000000000000000);
    assert(raw_to_bits(0.0) == 0);
    assert(raw_to_bits(-0.0) == 0);
    assert(raw_to_bits(0.5) == 0x3FE0000000000000);
    var i : usize = 0;
    while (i < FMT_N) {
        const x : f64 = raw_from_bits(FMT_BITS[i]);
        assert(raw_to_bits(x) == FMT_BITS[i]);
        i = i + 1;
    }
    // the bits of a double ngspice wrote, cross-checked against @bitCast
    const b : u64 = 0x3DA5FD7FE1796496;
    const y : f64 = @bitCast(b);
    assert(raw_from_bits(b) == y);
    assert(raw_to_bits(y) == b);
}

test f64_prints_like_c_printf_15e {
    var o : [2048]u8 = [0] ** 2048;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var w : usize = 0;
    var i : usize = 0;
    while (i < FMT_N) {
        w = raw_put_f64(&o, w, raw_from_bits(FMT_BITS[i]), &a, &d);
        w = raw_put(&o, w, 10);
        i = i + 1;
    }
    const want : [7]str = [FMT_0, FMT_1, FMT_2, FMT_3, FMT_4, FMT_5, FMT_6];
    var at : usize = 0;
    var k : usize = 0;
    while (k < 7) {
        assert(raw_at(&o, at, want[k]));
        at = at + want[k].len;
        k = k + 1;
    }
    assert(at == w);
}

; --- the file: header, variable table, values ------------------------------------------------------
; The RAW layout is what ngspice's own `write` produced for a four-variable transient (raw_ref.cir). Header, one line
; each: Title, Date, Command (optional), Plotname, "Flags: real", "No. Variables: N", "No. Points: P", "Variables:", then one
; line per variable "<TAB>index<TAB>name<TAB>type", then "Values:" (ASCII) or "Binary:". An ASCII point is " index<TAB>v0",
; then "<TAB>vj" for each other variable, each on its own line, and one empty line; a binary point is N little-endian f64.
; The variables arrive as a table of "name<TAB>type<LF>" lines, which is the Variables: block without its indexes.

/// The number of variables in a table of "name<TAB>type<LF>" lines.
pub fn raw_count_vars(vars: []const u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < vars.len) {
        if (vars[i] == 10) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The Variables: block: every table line with "<TAB>index<TAB>" in front.
pub fn raw_put_vars(out: []u8, w: usize, vars: []const u8) -> usize {
    var p : usize = w;
    var line : u64 = 0;
    var start : bool = true;
    var i : usize = 0;
    while (i < vars.len) {
        if (start) {
            p = raw_put(out, p, 9);
            p = raw_put_uint(out, p, line);
            p = raw_put(out, p, 9);
            start = false;
        }
        p = raw_put(out, p, vars[i]);
        if (vars[i] == 10) {
            start = true;
            line = line + 1;
        }
        i = i + 1;
    }
    return p;
}

/// The header with the counts it is told (nv and np are stated, not derived, so a test can state a wrong one). An empty
/// command writes no Command line: ngspice executes the text of that line as a command when it loads the file.
pub fn raw_put_header(out: []u8, w: usize, title: []const u8, date: []const u8, command: []const u8, plotname: []const u8, vars: []const u8, nv: usize, np: usize, binary: bool) -> usize {
    var p : usize = raw_puts(out, w, "Title: ");
    p = raw_puts(out, p, title);
    p = raw_puts(out, p, "\nDate: ");
    p = raw_puts(out, p, date);
    p = raw_put(out, p, 10);
    if (command.len > 0) {
        p = raw_puts(out, p, "Command: ");
        p = raw_puts(out, p, command);
        p = raw_put(out, p, 10);
    }
    p = raw_puts(out, p, "Plotname: ");
    p = raw_puts(out, p, plotname);
    p = raw_puts(out, p, "\nFlags: real\nNo. Variables: ");
    p = raw_put_uint(out, p, nv as u64);
    p = raw_puts(out, p, "\nNo. Points: ");
    p = raw_put_uint(out, p, np as u64);
    p = raw_puts(out, p, "\nVariables:\n");
    p = raw_put_vars(out, p, vars);
    if (binary) { return raw_puts(out, p, "Binary:\n"); }
    return raw_puts(out, p, "Values:\n");
}

/// np points of nv values from vals (time-major: point p, variable v is vals[p * nv + v]; a missing value is 0) as ASCII.
pub fn raw_put_ascii(out: []u8, w: usize, nv: usize, np: usize, vals: []const f64, a: []u64, d: []u8) -> usize {
    var p : usize = w;
    var pt : usize = 0;
    while (pt < np) {
        var v : usize = 0;
        while (v < nv) {
            if (v == 0) {
                p = raw_put(out, p, 32);
                p = raw_put_uint(out, p, pt as u64);
            }
            p = raw_put(out, p, 9);
            var x : f64 = 0.0;
            if (pt * nv + v < vals.len) { x = vals[pt * nv + v]; }
            p = raw_put_f64(out, p, x, a, d);
            p = raw_put(out, p, 10);
            v = v + 1;
        }
        p = raw_put(out, p, 10);
        pt = pt + 1;
    }
    return p;
}

/// np points of nv values from vals, each a little-endian f64.
pub fn raw_put_binary(out: []u8, w: usize, nv: usize, np: usize, vals: []const f64) -> usize {
    var p : usize = w;
    var i : usize = 0;
    while (i < nv * np) {
        var x : f64 = 0.0;
        if (i < vals.len) { x = vals[i]; }
        p = raw_put_le64(out, p, raw_to_bits(x));
        i = i + 1;
    }
    return p;
}

/// The whole file: nv comes from the table, np from the number of values. The length it needs (see "bytes out").
pub fn raw_write(out: []u8, title: []const u8, date: []const u8, command: []const u8, plotname: []const u8, vars: []const u8, vals: []const f64, binary: bool, a: []u64, d: []u8) -> usize {
    const nv : usize = raw_count_vars(vars);
    var np : usize = 0;
    if (nv > 0) { np = vals.len / nv; }
    const p : usize = raw_put_header(out, 0, title, date, command, plotname, vars, nv, np, binary);
    if (binary) { return raw_put_binary(out, p, nv, np, vals); }
    return raw_put_ascii(out, p, nv, np, vals, a, d);
}

; --- the reader that judges a file ------------------------------------------------------------------
; It checks what ngspice's `load` and uberWAVE's parser rely on: the header lines in order, the counts against the
; body, and the body's shape. A file whose header lies about its points or variables is refused with the reason.

pub const RAW_OK : u32 = 0;
pub const RAW_E_TITLE : u32 = 1;
pub const RAW_E_DATE : u32 = 2;
pub const RAW_E_PLOT : u32 = 3;
pub const RAW_E_FLAGS : u32 = 4;
pub const RAW_E_NVARS : u32 = 5;
pub const RAW_E_NPTS : u32 = 6;
pub const RAW_E_VARS : u32 = 7;
pub const RAW_E_MODE : u32 = 8;
/// Fewer points than the header says.
pub const RAW_E_SHORT : u32 = 9;
/// Bytes after the last point the header declares.
pub const RAW_E_TRAIL : u32 = 10;
pub const RAW_E_INDEX : u32 = 11;
pub const RAW_E_VALUE : u32 = 12;
/// A point with more or fewer values than the header has variables.
pub const RAW_E_SHAPE : u32 = 13;
/// The largest count a header may state (nv * np * 8 stays below 2^63).
pub const RAW_MAX : u64 = 1000000000;
pub const RAW_BAD : u64 = 18446744073709551615;
/// No position.
pub const RAW_NONE : usize = 4294967295;

pub struct RawInfo { err: u32, nv: usize, np: usize, binary: bool, data: usize }

/// The index of the line feed at or after `from`, or n.
pub fn raw_eol(buf: []const u8, n: usize, from: usize) -> usize {
    var i : usize = from;
    while (i < n and buf[i] != 10) { i = i + 1; }
    return i;
}

/// Does buf[0..n) hold s at `at`?
pub fn raw_has(buf: []const u8, n: usize, at: usize, s: []const u8) -> bool {
    if (at + s.len > n) { return false; }
    return raw_at(buf, at, s);
}

/// The unsigned number in buf[from..to): digits, then spaces (ngspice pads the point count of a file it rewrites); RAW_BAD else.
pub fn raw_uint(buf: []const u8, from: usize, to: usize) -> u64 {
    var v : u64 = 0;
    var i : usize = from;
    while (i < to and buf[i] >= 48 and buf[i] <= 57) {
        if (i - from >= 18) { return RAW_BAD; }
        v = v * 10 + ((buf[i] - 48) as u64);
        i = i + 1;
    }
    if (i == from) { return RAW_BAD; }
    while (i < to and buf[i] == 32) { i = i + 1; }
    if (i != to) { return RAW_BAD; }
    return v;
}

/// The count on the line at `at` that starts with `prefix`; RAW_BAD if the line is not that or the count is not in range.
pub fn raw_count_line(buf: []const u8, n: usize, at: usize, prefix: []const u8) -> u64 {
    if (!raw_has(buf, n, at, prefix)) { return RAW_BAD; }
    const v : u64 = raw_uint(buf, at + prefix.len, raw_eol(buf, n, at));
    if (v > RAW_MAX) { return RAW_BAD; }
    return v;
}

/// Is buf[from..to) the text of a number: [-]digits[.digits][e[+-]digits], or inf, -inf, nan?
pub fn raw_value_ok(buf: []const u8, from: usize, to: usize) -> bool {
    var i : usize = from;
    if (i < to and buf[i] == 45) { i = i + 1; }
    if (raw_has(buf, to, i, "inf") and to == i + 3) { return true; }
    if (raw_has(buf, to, i, "nan") and to == i + 3) { return true; }
    var digits : usize = 0;
    while (i < to and buf[i] >= 48 and buf[i] <= 57) {
        i = i + 1;
        digits = digits + 1;
    }
    if (digits == 0) { return false; }
    if (i < to and buf[i] == 46) {
        i = i + 1;
        var frac : usize = 0;
        while (i < to and buf[i] >= 48 and buf[i] <= 57) {
            i = i + 1;
            frac = frac + 1;
        }
        if (frac == 0) { return false; }
    }
    if (i < to and (buf[i] == 101 or buf[i] == 69)) {
        i = i + 1;
        if (i < to and (buf[i] == 43 or buf[i] == 45)) { i = i + 1; }
        var ed : usize = 0;
        while (i < to and buf[i] >= 48 and buf[i] <= 57) {
            i = i + 1;
            ed = ed + 1;
        }
        if (ed == 0) { return false; }
    }
    return i == to;
}

/// The ASCII body from `start`: np points of nv values, each point " index<TAB>v0", "<TAB>vj" lines and an empty line.
pub fn raw_check_ascii(buf: []const u8, n: usize, start: usize, nv: usize, np: usize) -> u32 {
    var at : usize = start;
    var pt : usize = 0;
    while (pt < np) {
        var v : usize = 0;
        while (v < nv) {
            if (at >= n) { return RAW_E_SHORT; }
            const e : usize = raw_eol(buf, n, at);
            if (e >= n) { return RAW_E_SHORT; }
            var from : usize = at + 1;
            if (v == 0) {
                if (buf[at] != 32) { return RAW_E_INDEX; }
                var t : usize = from;
                while (t < e and buf[t] != 9) { t = t + 1; }
                if (t >= e) { return RAW_E_INDEX; }
                if (raw_uint(buf, from, t) != (pt as u64)) { return RAW_E_INDEX; }
                from = t + 1;
            } else if (buf[at] != 9) {
                return RAW_E_SHAPE;
            }
            if (!raw_value_ok(buf, from, e)) { return RAW_E_VALUE; }
            at = e + 1;
            v = v + 1;
        }
        if (at >= n) { return RAW_E_SHORT; }
        if (buf[at] != 10) { return RAW_E_SHAPE; }
        at = at + 1;
        pt = pt + 1;
    }
    if (at != n) { return RAW_E_TRAIL; }
    return RAW_OK;
}

/// The Variables: lines from `start`: nv lines "<TAB>k<TAB>name<TAB>type", both words non-empty; the position after them, or RAW_NONE.
pub fn raw_check_vars(buf: []const u8, n: usize, start: usize, nv: usize) -> usize {
    var at : usize = start;
    var k : usize = 0;
    while (k < nv) {
        if (at >= n or buf[at] != 9) { return RAW_NONE; }
        const e : usize = raw_eol(buf, n, at);
        if (e >= n) { return RAW_NONE; }
        var t1 : usize = at + 1;
        while (t1 < e and buf[t1] != 9) { t1 = t1 + 1; }
        if (t1 >= e or raw_uint(buf, at + 1, t1) != (k as u64)) { return RAW_NONE; }
        var t2 : usize = t1 + 1;
        while (t2 < e and buf[t2] != 9) { t2 = t2 + 1; }
        if (t2 >= e or t2 == t1 + 1 or e == t2 + 1) { return RAW_NONE; }
        var t3 : usize = t2 + 1;
        while (t3 < e and buf[t3] != 9) { t3 = t3 + 1; }
        if (t3 != e) { return RAW_NONE; }
        at = e + 1;
        k = k + 1;
    }
    return at;
}

/// Judge buf[0..n) as a real-valued RAW file; err is RAW_OK or the first thing that is wrong.
pub fn raw_check(buf: []const u8, n: usize) -> RawInfo {
    var inf : RawInfo = RawInfo { err: 0, nv: 0, np: 0, binary: false, data: 0 };
    var at : usize = 0;
    if (!raw_has(buf, n, at, "Title: ")) {
        inf.err = RAW_E_TITLE;
        return inf;
    }
    at = raw_eol(buf, n, at) + 1;
    if (!raw_has(buf, n, at, "Date: ")) {
        inf.err = RAW_E_DATE;
        return inf;
    }
    at = raw_eol(buf, n, at) + 1;
    if (raw_has(buf, n, at, "Command: ")) { at = raw_eol(buf, n, at) + 1; }
    if (!raw_has(buf, n, at, "Plotname: ")) {
        inf.err = RAW_E_PLOT;
        return inf;
    }
    at = raw_eol(buf, n, at) + 1;
    if (!raw_has(buf, n, at, "Flags: real\n")) {
        inf.err = RAW_E_FLAGS;
        return inf;
    }
    at = at + 12;
    const nv : u64 = raw_count_line(buf, n, at, "No. Variables: ");
    if (nv == RAW_BAD) {
        inf.err = RAW_E_NVARS;
        return inf;
    }
    at = raw_eol(buf, n, at) + 1;
    const np : u64 = raw_count_line(buf, n, at, "No. Points: ");
    if (np == RAW_BAD) {
        inf.err = RAW_E_NPTS;
        return inf;
    }
    at = raw_eol(buf, n, at) + 1;
    inf.nv = nv as usize;
    inf.np = np as usize;
    if (!raw_has(buf, n, at, "Variables:\n")) {
        inf.err = RAW_E_VARS;
        return inf;
    }
    at = raw_check_vars(buf, n, at + 11, inf.nv);
    if (at == RAW_NONE) {
        inf.err = RAW_E_VARS;
        return inf;
    }
    if (raw_has(buf, n, at, "Binary:\n")) {
        inf.binary = true;
        inf.data = at + 8;
        const want : u64 = nv * np * 8;
        const have : u64 = (n - inf.data) as u64;
        if (have < want) { inf.err = RAW_E_SHORT; }
        if (have > want) { inf.err = RAW_E_TRAIL; }
        return inf;
    }
    if (raw_has(buf, n, at, "Values:\n")) {
        inf.data = at + 8;
        inf.err = raw_check_ascii(buf, n, inf.data, inf.nv, inf.np);
        return inf;
    }
    inf.err = RAW_E_MODE;
    return inf;
}

/// Eight bytes at `at`, least significant first.
pub fn raw_get_le64(buf: []const u8, at: usize) -> u64 {
    var b : u64 = 0;
    var i : usize = 8;
    while (i > 0) {
        i = i - 1;
        b = (b << 8) | (buf[at + i] as u64);
    }
    return b;
}

/// Value v of point p of a binary file that raw_check accepted.
pub fn raw_binary_value(buf: []const u8, inf: RawInfo, p: usize, v: usize) -> f64 {
    return raw_from_bits(raw_get_le64(buf, inf.data + (p * inf.nv + v) * 8));
}

