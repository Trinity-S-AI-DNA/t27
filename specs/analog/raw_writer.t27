; --- small helpers for the tests ----------------------------------------------------------------------

/// The first position at or after `from` where buf[0..n) holds s; RAW_NONE if there is none.
pub fn raw_find(buf: []const u8, n: usize, s: []const u8, from: usize) -> usize {
    var i : usize = from;
    while (i + s.len <= n) {
        if (raw_at(buf, i, s)) { return i; }
        i = i + 1;
    }
    return RAW_NONE;
}

/// The value of a hex digit (0-9, a-f, A-F).
pub fn raw_nibble(c: u8) -> u8 {
    if (c >= 97) { return c - 87; }
    if (c >= 65) { return c - 55; }
    return c - 48;
}

/// Does out hold, at `at`, the bytes written as hex digits in `hex`?
pub fn raw_at_hex(out: []const u8, at: usize, hex: []const u8) -> bool {
    if (at + hex.len / 2 > out.len) { return false; }
    var i : usize = 0;
    while (i < hex.len / 2) {
        if (out[at + i] != raw_nibble(hex[2 * i]) * 16 + raw_nibble(hex[2 * i + 1])) { return false; }
        i = i + 1;
    }
    return true;
}

/// The bytes written as hex digits in `hex`, into out from w; the new cursor.
pub fn raw_put_hex(out: []u8, w: usize, hex: []const u8) -> usize {
    var p : usize = w;
    var i : usize = 0;
    while (i < hex.len / 2) {
        p = raw_put(out, p, raw_nibble(hex[2 * i]) * 16 + raw_nibble(hex[2 * i + 1]));
        i = i + 1;
    }
    return p;
}

; --- the M1 RLC trace as a RAW file ----------------------------------------------------------------------
; Circuit 2 of specs/analog/linear.t27: R = 100 Ohm, L = 10 uH, C = 1 nF, dt = 5 ns, IN = 1 V for 100 steps then 0 V.
; The trace has 201 points: point 0 is the circuit at rest before the source turns on (time 0, IN 0 V), point k the state
; after the k-th update at time k * dt, with IN the source value of that update. The variables are named as ngspice names them for
; specs/analog/decks/rlc_fixed.cir: v(in), the node v(1) between R and L, the capacitor voltage v(2) and the inductor
; current i(l1) (the cell keeps it as volts, current * 100 Ohm; it is divided back here). That deck's time axis is this one
; shifted by 42.5 ns, the instant its source turns on.

/// The variable table of the RLC trace.
pub const RLC_VARS : str = "time\ttime\nv(in)\tvoltage\nv(1)\tvoltage\nv(2)\tvoltage\ni(l1)\tcurrent\n";
pub const RLC_NVARS : usize = 5;
/// Point 0 and one point after each of the 200 steps.
pub const RLC_PTS : usize = 201;
/// RLC_PTS * RLC_NVARS: the f64 a trace holds.
pub const RLC_VALS : usize = 1005;
pub const RLC_TITLE : str = "m1 series rlc, backward euler on a fixed 5 ns grid";

/// Simulate a 3-unknown cell with the tables d (D, 9 words) and nv (N, 3 words) for STEPS steps; vals (RLC_VALS of them) gets the
/// trace, point-major. The fold of every state word of every update comes back: for the RLC's own tables linear.t27 pins it
/// as RLC_EXP_S, so it says the trace is that simulation.
pub fn raw_cell_trace(d: []const u32, nv: []const u32, vals: []f64) -> u64 {
    var x : [3]u32 = [0] ** 3;
    var s : u64 = 0;
    var j : usize = 0;
    while (j < RLC_NVARS) {
        vals[j] = 0.0;
        j = j + 1;
    }
    var k : u32 = 0;
    while (k < STEPS) {
        const u : u32 = vin_at(k);
        const y0 : u32 = step_row(0, RLC_N, d, nv, &x, u);
        const y1 : u32 = step_row(1, RLC_N, d, nv, &x, u);
        const y2 : u32 = step_row(2, RLC_N, d, nv, &x, u);
        x[0] = y0;
        x[1] = y1;
        x[2] = y2;
        s = fold(s, y0);
        s = fold(s, y1);
        s = fold(s, y2);
        const row : usize = ((k + 1) as usize) * RLC_NVARS;
        vals[row] = ((k + 1) as f64) * RLC_DT;
        vals[row + 1] = sm_f64(u);
        vals[row + 2] = sm_f64(y0);
        vals[row + 3] = sm_f64(y1);
        vals[row + 4] = sm_f64(y2) / RLC_ZS;
        k = k + 1;
    }
    return s;
}

/// The RLC trace: raw_cell_trace over the tables of linear.t27's circuit 2.
pub fn raw_rlc_trace(vals: []f64) -> u64 {
    return raw_cell_trace(&RLC_D, &RLC_NV, vals);
}

/// The RLC trace as a RAW file in out, ASCII or binary, with the given Date line and no Command line (ngspice executes a
/// Command: line when it loads the file); the length it needs. vals: RLC_VALS f64
/// of scratch for the trace; a and d: the scratch of raw_put_f64.
pub fn raw_rlc_file(out: []u8, date: []const u8, binary: bool, vals: []f64, a: []u64, d: []u8) -> usize {
    const s : u64 = raw_rlc_trace(vals);
    if (s != RLC_EXP_S) { return 0; }
    return raw_write(out, RLC_TITLE, date, "", "Transient Analysis", RLC_VARS, vals, binary, a, d);
}

; --- tests: the writer against ngspice -------------------------------------------------------------------

test a_nan_or_an_infinity_is_written_in_both_modes_without_hanging {
    const bi : u64 = 0x7FF0000000000000;
    const bm : u64 = 0xFFF0000000000000;
    const bn : u64 = 0x7FF8000000000000;
    const inf : f64 = @bitCast(bi);
    const ninf : f64 = @bitCast(bm);
    const nan : f64 = @bitCast(bn);
    assert(raw_to_bits(inf) == 0x7FF0000000000000);
    assert(raw_to_bits(ninf) == 0xFFF0000000000000);
    assert(raw_to_bits(nan) == 0x7FF8000000000000);
    var out : [32]u8 = [0] ** 32;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var n : usize = raw_put_f64(&out, 0, inf, &a, &d);
    assert(n == 3);
    assert(raw_at(&out, 0, "inf"));
    n = raw_put_f64(&out, 0, ninf, &a, &d);
    assert(n == 4);
    assert(raw_at(&out, 0, "-inf"));
    n = raw_put_f64(&out, 0, nan, &a, &d);
    assert(n == 3);
    assert(raw_at(&out, 0, "nan"));
    // the reader takes all three as numbers
    assert(raw_value_ok(&out, 0, n));
}

test the_ascii_file_is_ngspices_byte_for_byte {
    var vals : [60]f64 = [0.0] ** 60;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var out : [4096]u8 = [0] ** 4096;
    var i : usize = 0;
    while (i < 60) {
        vals[i] = raw_from_bits(SM_BITS[i]);
        i = i + 1;
    }
    const n : usize = raw_write(&out, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, &vals, false, &a, &d);
    const want : [5]str = [SM_A0, SM_A1, SM_A2, SM_A3, SM_A4];
    var at : usize = 0;
    var k : usize = 0;
    while (k < 5) {
        assert(raw_at(&out, at, want[k]));
        at = at + want[k].len;
        k = k + 1;
    }
    assert(at == n);
    // the comparison is not vacuous: one changed digit is not the reference
    out[n - 4] = out[n - 4] + 1;
    assert(!raw_at(&out, n - want[4].len, want[4]));
}

test the_binary_file_is_ngspices_byte_for_byte {
    var vals : [60]f64 = [0.0] ** 60;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var out : [4096]u8 = [0] ** 4096;
    var i : usize = 0;
    while (i < 60) {
        vals[i] = raw_from_bits(SM_BITS[i]);
        i = i + 1;
    }
    const n : usize = raw_write(&out, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, &vals, true, &a, &d);
    const want : [5]str = [SM_H0, SM_H1, SM_H2, SM_H3, SM_H4];
    var at : usize = 0;
    var k : usize = 0;
    while (k < 5) {
        assert(raw_at_hex(&out, at, want[k]));
        at = at + want[k].len / 2;
        k = k + 1;
    }
    assert(at == n);
    assert(n == 799);
}

test the_reader_accepts_ngspices_own_files_and_reads_the_binary_values {
    var buf : [4096]u8 = [0] ** 4096;
    const hex : [5]str = [SM_H0, SM_H1, SM_H2, SM_H3, SM_H4];
    var n : usize = 0;
    var k : usize = 0;
    while (k < 5) {
        n = raw_put_hex(&buf, n, hex[k]);
        k = k + 1;
    }
    const inf : RawInfo = raw_check(&buf, n);
    assert(inf.err == RAW_OK);
    assert(inf.binary);
    assert(inf.nv == SM_NV);
    assert(inf.np == SM_NP);
    var p : usize = 0;
    while (p < SM_NP) {
        var v : usize = 0;
        while (v < SM_NV) {
            assert(raw_to_bits(raw_binary_value(&buf, inf, p, v)) == SM_BITS[p * SM_NV + v]);
            v = v + 1;
        }
        p = p + 1;
    }
    var m : usize = 0;
    const asc : [5]str = [SM_A0, SM_A1, SM_A2, SM_A3, SM_A4];
    k = 0;
    while (k < 5) {
        m = raw_puts(&buf, m, asc[k]);
        k = k + 1;
    }
    const ia : RawInfo = raw_check(&buf, m);
    assert(ia.err == RAW_OK);
    assert(!ia.binary);
    assert(ia.nv == SM_NV);
    assert(ia.np == SM_NP);
}

test the_point_index_is_written_with_one_space_before_it_at_every_width {
    // ngspice writes " 9", " 10", " 100", " 1000": a space, then the index in decimal
    var out : [32768]u8 = [0] ** 32768;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var vals : [1001]f64 = [0.0] ** 1001;
    var i : usize = 0;
    while (i < 1001) {
        vals[i] = (i as f64) * 0.25;
        i = i + 1;
    }
    var n : usize = raw_put_header(&out, 0, "t", "d", "", "p", "time\ttime\n", 1, 1001, false);
    n = raw_put_ascii(&out, n, 1, 1001, &vals, &a, &d);
    assert(n <= 32768);
    assert(raw_check(&out, n).err == RAW_OK);
    assert(raw_find(&out, n, "\n 9\t3.000000000000000e+00\n", 0) == RAW_NONE);
    assert(raw_find(&out, n, "\n 9\t2.250000000000000e+00\n\n 10\t2.500000000000000e+00\n", 0) != RAW_NONE);
    assert(raw_find(&out, n, "\n 100\t2.500000000000000e+01\n", 0) != RAW_NONE);
    assert(raw_find(&out, n, "\n 1000\t2.500000000000000e+02\n\n", 0) != RAW_NONE);
    // no Command line when the command is empty
    assert(raw_find(&out, n, "Command", 0) == RAW_NONE);
}

; --- tests: the reader refuses a file that lies -------------------------------------------------------------

test a_header_with_the_wrong_point_count_is_refused {
    var vals : [60]f64 = [0.0] ** 60;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var buf : [4096]u8 = [0] ** 4096;
    var i : usize = 0;
    while (i < 60) {
        vals[i] = raw_from_bits(SM_BITS[i]);
        i = i + 1;
    }
    // the control: the honest header and body
    var n : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 4, 15, false);
    n = raw_put_ascii(&buf, n, 4, 15, &vals, &a, &d);
    assert(raw_check(&buf, n).err == RAW_OK);
    // one point too many in the header: the file ends early
    var n16 : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 4, 16, false);
    n16 = raw_put_ascii(&buf, n16, 4, 15, &vals, &a, &d);
    assert(raw_check(&buf, n16).err == RAW_E_SHORT);
    // one too few: a point is left over
    var n14 : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 4, 14, false);
    n14 = raw_put_ascii(&buf, n14, 4, 15, &vals, &a, &d);
    assert(raw_check(&buf, n14).err == RAW_E_TRAIL);
    // the same two lies in a binary file
    var b15 : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 4, 15, true);
    b15 = raw_put_binary(&buf, b15, 4, 15, &vals);
    assert(raw_check(&buf, b15).err == RAW_OK);
    assert(raw_check(&buf, b15 - 1).err == RAW_E_SHORT);
    buf[b15] = 0;
    assert(raw_check(&buf, b15 + 1).err == RAW_E_TRAIL);
}

test a_header_with_the_wrong_variable_count_is_refused {
    var vals : [60]f64 = [0.0] ** 60;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var buf : [4096]u8 = [0] ** 4096;
    var i : usize = 0;
    while (i < 60) {
        vals[i] = raw_from_bits(SM_BITS[i]);
        i = i + 1;
    }
    // the table has 4 variables; the header says 5 or 3
    var n5 : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 5, 12, false);
    n5 = raw_put_ascii(&buf, n5, 4, 15, &vals, &a, &d);
    assert(raw_check(&buf, n5).err == RAW_E_VARS);
    var n3 : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 3, 15, false);
    n3 = raw_put_ascii(&buf, n3, 4, 15, &vals, &a, &d);
    assert(raw_check(&buf, n3).err == RAW_E_MODE);
    // header and table agree on 4, the body has 3 values per point
    var m : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 4, 15, false);
    m = raw_put_ascii(&buf, m, 3, 15, &vals, &a, &d);
    assert(raw_check(&buf, m).err == RAW_E_SHAPE);
    // and 5 values per point
    var q : usize = raw_put_header(&buf, 0, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, 4, 12, false);
    q = raw_put_ascii(&buf, q, 5, 12, &vals, &a, &d);
    assert(raw_check(&buf, q).err == RAW_E_SHAPE);
}

test a_file_with_a_broken_header_index_or_value_is_refused {
    var vals : [60]f64 = [0.0] ** 60;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var buf : [4096]u8 = [0] ** 4096;
    var i : usize = 0;
    while (i < 60) {
        vals[i] = raw_from_bits(SM_BITS[i]);
        i = i + 1;
    }
    const n : usize = raw_write(&buf, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, &vals, false, &a, &d);
    assert(raw_check(&buf, n).err == RAW_OK);
    // point 1 numbered 7
    const at1 : usize = raw_find(&buf, n, "\n 1\t", 0);
    assert(at1 != RAW_NONE);
    buf[at1 + 2] = 55;
    assert(raw_check(&buf, n).err == RAW_E_INDEX);
    buf[at1 + 2] = 49;
    assert(raw_check(&buf, n).err == RAW_OK);
    // an exponent letter turned into x
    const av : usize = raw_find(&buf, n, "Values:\n", 0);
    const ae : usize = raw_find(&buf, n, "e-", av);
    assert(ae != RAW_NONE);
    buf[ae] = 120;
    assert(raw_check(&buf, n).err == RAW_E_VALUE);
    buf[ae] = 101;
    assert(raw_check(&buf, n).err == RAW_OK);
    // the first header line, the flags line, the mode line
    buf[0] = 116;
    assert(raw_check(&buf, n).err == RAW_E_TITLE);
    buf[0] = 84;
    const af : usize = raw_find(&buf, n, "real", 0);
    buf[af] = 99;
    assert(raw_check(&buf, n).err == RAW_E_FLAGS);
    buf[af] = 114;
    const am : usize = raw_find(&buf, n, "Values:", 0);
    buf[am] = 86;
    buf[am + 1] = 65;
    assert(raw_check(&buf, n).err == RAW_E_MODE);
    buf[am] = 86;
    buf[am + 1] = 97;
    assert(raw_check(&buf, n).err == RAW_OK);
}

test the_value_syntax_the_reader_accepts {
    var b : [32]u8 = [0] ** 32;
    var n : usize = raw_puts(&b, 0, "-1.500000000000000e-03");
    assert(raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "1");
    assert(raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "nan");
    assert(raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "-inf");
    assert(raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "1.5E+10");
    assert(raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "");
    assert(!raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, ".5");
    assert(!raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "1.");
    assert(!raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "1e");
    assert(!raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "--1");
    assert(!raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "1.0e+0x");
    assert(!raw_value_ok(&b, 0, n));
    n = raw_puts(&b, 0, "nanx");
    assert(!raw_value_ok(&b, 0, n));
}

test the_reader_takes_the_padded_point_count_of_a_rewritten_file {
    // ngspice -r writes the point count padded with spaces once the simulation has ended
    var b : [256]u8 = [0] ** 256;
    const n : usize = raw_puts(&b, 0, "Title: t\nDate: d\nPlotname: p\nFlags: real\nNo. Variables: 1\nNo. Points: 0    \nVariables:\n\t0\ttime\ttime\nValues:\n");
    const inf : RawInfo = raw_check(&b, n);
    assert(inf.err == RAW_OK);
    assert(inf.nv == 1);
    assert(inf.np == 0);
}

; --- tests: the M1 RLC trace ---------------------------------------------------------------------------------

test the_rlc_trace_is_the_cells_own_run {
    var vals : [1005]f64 = [0.0] ** 1005;
    const s : u64 = raw_rlc_trace(&vals);
    assert(s == RLC_EXP_S);
    // point 0: at rest, the source not yet on
    var j : usize = 0;
    while (j < 5) {
        assert(vals[j] == 0.0);
        j = j + 1;
    }
    // the time axis is k * dt
    assert(vals[5] == RLC_DT);
    assert(vals[5 * 100] == 100.0 * RLC_DT);
    assert(vals[5 * 200] == 200.0 * RLC_DT);
    // IN is 1 V for the 100 charging steps and 0 V for the next 100
    assert(vals[5 * 1 + 1] == 1.0);
    assert(vals[5 * 100 + 1] == 1.0);
    assert(vals[5 * 101 + 1] == 0.0);
    assert(vals[5 * 200 + 1] == 0.0);
    // the capacitor rings past the 1 V it is driven to (damping 0.5: overshoot near 15 %) and the inductor current moves both ways
    var vmax : f64 = 0.0;
    var imin : f64 = 0.0;
    var imax : f64 = 0.0;
    var p : usize = 0;
    while (p < 201) {
        if (vals[5 * p + 3] > vmax) { vmax = vals[5 * p + 3]; }
        if (vals[5 * p + 4] < imin) { imin = vals[5 * p + 4]; }
        if (vals[5 * p + 4] > imax) { imax = vals[5 * p + 4]; }
        p = p + 1;
    }
    assert(vmax > 1.05);
    assert(vmax < 1.2);
    assert(imax > 0.0);
    assert(imin < 0.0);
}

test the_rlc_file_passes_the_reader_in_ascii_and_binary_and_the_binary_decodes_exactly {
    var vals : [1005]f64 = [0.0] ** 1005;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var asc : [32768]u8 = [0] ** 32768;
    var bin : [16384]u8 = [0] ** 16384;
    const na : usize = raw_rlc_file(&asc, "Mon Oct 19 00:00:00  2026", false, &vals, &a, &d);
    const nb : usize = raw_rlc_file(&bin, "Mon Oct 19 00:00:00  2026", true, &vals, &a, &d);
    assert(na > 0);
    assert(na <= 32768);
    assert(nb <= 16384);
    const ia : RawInfo = raw_check(&asc, na);
    assert(ia.err == RAW_OK);
    assert(!ia.binary);
    assert(ia.nv == 5);
    assert(ia.np == 201);
    const ib : RawInfo = raw_check(&bin, nb);
    assert(ib.err == RAW_OK);
    assert(ib.binary);
    assert(ib.nv == 5);
    assert(ib.np == 201);
    assert(nb == ib.data + 1005 * 8);
    var i : usize = 0;
    while (i < 1005) {
        assert(raw_binary_value(&bin, ib, i / 5, i % 5) == vals[i]);
        i = i + 1;
    }
    // the header names the five traces
    assert(raw_find(&asc, na, "\n\t0\ttime\ttime\n\t1\tv(in)\tvoltage\n\t2\tv(1)\tvoltage\n\t3\tv(2)\tvoltage\n\t4\ti(l1)\tcurrent\nValues:\n", 0) != RAW_NONE);
    assert(raw_find(&asc, na, "No. Points: 201\n", 0) != RAW_NONE);
    assert(raw_find(&asc, na, "Command", 0) == RAW_NONE);
    assert(raw_find(&bin, nb, "Command", 0) == RAW_NONE);
    assert(raw_find(&asc, na, "No. Variables: 5\n", 0) != RAW_NONE);
}

test a_mis_signed_constant_is_not_the_cells_run {
    // the negative control: the sign of one stored constant flipped (as a mis-stamped element would) changes the fold and the trace
    var good : [1005]f64 = [0.0] ** 1005;
    var bad : [1005]f64 = [0.0] ** 1005;
    var d : [9]u32 = [0] ** 9;
    var i : usize = 0;
    while (i < 9) {
        d[i] = RLC_D[i];
        i = i + 1;
    }
    assert(raw_cell_trace(&d, &RLC_NV, &good) == RLC_EXP_S);
    d[4] = d[4] ^ 2147483648;
    assert(raw_cell_trace(&d, &RLC_NV, &bad) != RLC_EXP_S);
    var diff : bool = false;
    i = 0;
    while (i < 1005) {
        if (good[i] != bad[i]) { diff = true; }
        i = i + 1;
    }
    assert(diff);
}

; --- tests: mutation test gaps, batch 1 (groups A to D of the census of #12116; Refs #12273) --------------------
; Each assert below names the surviving mutants it kills. S<n> is the survivor numbered n in the census (the table is in
; docs/analog/mutation-raw_writer-2026-10-25.md). The tests only read the functions above; none of them is edited.
; Every buffer that a reader helper looks at is its own zero-filled array, so no byte past a text is left over from an earlier
; text: the readers of groups E to J (survivors that stay pending) would otherwise see it.

test raw_at_hex_checks_its_bytes {
    // group A, upper-case digits: the vectors write lower-case hex, so no other test passes a letter A to F
    assert(raw_nibble(65) == 10);
    // S74 (branch dropped: 17), S75 (`> 65`: 17 at 65 itself), S76 (`c + 55`: 120)
    assert(raw_nibble(70) == 15);
    // S74 (22), S76 (125)
    // group A, an exact-size buffer: the match ends where the buffer ends
    var o : [2]u8 = [0] ** 2;
    const w : usize = raw_put_hex(&o, 0, "abcd");
    assert(w == 2);
    assert(o[0] == 171);
    assert(o[1] == 205);
    assert(raw_at_hex(&o, 0, "abcd"));
    // S78 (bound `hex.len * 2`: refuses it), S79 (`>=`: refuses it)
    assert(!raw_at_hex(&o, 0, "abce"));
    // S80 (byte compare dropped: true whenever the bytes fit)
}

test a_changed_last_byte_is_not_the_binary_reference {
    // group A, the negative control the binary byte-for-byte test lacks: it asserts only positively, so it passes against a
    // raw_at_hex that checks nothing. The same file, its last byte changed, as the ASCII twin does with one digit.
    var vals : [60]f64 = [0.0] ** 60;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    var out : [4096]u8 = [0] ** 4096;
    var i : usize = 0;
    while (i < 60) {
        vals[i] = raw_from_bits(SM_BITS[i]);
        i = i + 1;
    }
    const n : usize = raw_write(&out, SM_TITLE, SM_DATE, SM_COMMAND, SM_PLOT, SM_VARS, &vals, true, &a, &d);
    assert(n == 799);
    const want : [5]str = [SM_H0, SM_H1, SM_H2, SM_H3, SM_H4];
    const last : usize = n - want[4].len / 2;
    assert(raw_at_hex(&out, last, want[4]));
    out[n - 1] = out[n - 1] + 1;
    assert(!raw_at_hex(&out, last, want[4]));
    // S80 (byte compare dropped)
}

test raw_check_vars_refuses_malformed_lines {
    // group B: direct calls on one variable line each, nv = 1. TAB is byte 9, LF byte 10. The recount of the byte lengths of the
    // last three lines gives 9, not the 11, 11 and 10 of the classification; each n below is the length raw_puts returns.
    var b0 : [32]u8 = [0] ** 32;
    const n0 : usize = raw_puts(&b0, 0, "\t0\ttime\ttime\n");
    assert(n0 == 13);
    assert(raw_check_vars(&b0, n0, 0, 1) == 13);
    // the control: a good line is taken and the cursor ends after it
    var b1 : [32]u8 = [0] ** 32;
    const n1 : usize = raw_puts(&b1, 0, "x0\ttime\ttime\n");
    assert(n1 == 13);
    assert(raw_check_vars(&b1, n1, 0, 1) == RAW_NONE);
    // no leading TAB: S55 (guard dropped), S57 (`or` to `and`)
    var b2 : [32]u8 = [0] ** 32;
    const n2 : usize = raw_puts(&b2, 0, "\t0\ttime\ttime");
    assert(n2 == 12);
    assert(raw_check_vars(&b2, n2, 0, 1) == RAW_NONE);
    // no final LF: S58 (guard dropped), S59 (`e > n`)
    var b3 : [32]u8 = [0] ** 32;
    const n3 : usize = raw_puts(&b3, 0, "\t1\ttime\ttime\n");
    assert(n3 == 13);
    assert(raw_check_vars(&b3, n3, 0, 1) == RAW_NONE);
    // wrong index (1 for 0): S61 (guard dropped), S63 (`or` to `and`)
    var b4 : [32]u8 = [0] ** 32;
    const n4 : usize = raw_puts(&b4, 0, "\t0\t\ttime\n");
    assert(n4 == 9);
    assert(raw_check_vars(&b4, n4, 0, 1) == RAW_NONE);
    // empty name: S65 (guard dropped), S67 (first `or` to `and`), S68 (`t1 + 1` to `t1`), S69 (`t1 - 1`), S70 (second `or` to `and`)
    var b5 : [32]u8 = [0] ** 32;
    const n5 : usize = raw_puts(&b5, 0, "\t0\ttime\t\n");
    assert(n5 == 9);
    assert(raw_check_vars(&b5, n5, 0, 1) == RAW_NONE);
    // empty type: S65, S70, S71 (`t2 + 1` to `t2`), S72 (`t2 - 1`)
    var b6 : [32]u8 = [0] ** 32;
    const n6 : usize = raw_puts(&b6, 0, "\t0\ta\tb\tc\n");
    assert(n6 == 9);
    assert(raw_check_vars(&b6, n6, 0, 1) == RAW_NONE);
    // a fourth field: S73 (guard dropped)
}

test zero_is_written_unsigned_and_nonfinite_bits_read_as_zero {
    // group C: no vector holds a zero, and the RLC trace is judged by raw_check, which accepts a leading '-'
    var b : [32]u8 = [0] ** 32;
    var a : [90]u64 = [0] ** 90;
    var d : [810]u8 = [0] ** 810;
    const n : usize = raw_put_f64(&b, 0, 0.0, &a, &d);
    assert(n == 21);
    assert(raw_at(&b, 0, "0.000000000000000e+00"));
    // S14 (`x <= 0.0` writes a '-' first: 22 bytes)
    // exponent field 2047: the pattern of +inf and of a quiet NaN read as 0.0
    const bi : u64 = 0x7FF0000000000000;
    const bn : u64 = 0x7FF8000000000000;
    assert(raw_from_bits(bi) == 0.0);
    assert(raw_from_bits(bn) == 0.0);
    // S18 (guard dropped: both build an infinity)
}

test numbers_and_counts_at_their_limits {
    // group D, raw_uint: 19 digits, an empty range, only spaces, and a digit run followed by junk. One zero-filled buffer each.
    var bu : [32]u8 = [0] ** 32;
    const nu : usize = raw_puts(&bu, 0, "1000000000000000000");
    assert(nu == 19);
    assert(raw_uint(&bu, 0, nu) == RAW_BAD);
    // S28 (guard dropped: 10^18), S29 (`>= 18` to `> 18`: 10^18)
    var be : [32]u8 = [0] ** 32;
    assert(raw_uint(&be, 0, 0) == RAW_BAD);
    // S30 (guard dropped: an empty range reads as 0)
    var bs : [32]u8 = [0] ** 32;
    const ns : usize = raw_puts(&bs, 0, "  ");
    assert(ns == 2);
    assert(raw_uint(&bs, 0, ns) == RAW_BAD);
    // S30 (the same guard: all spaces reads as 0)
    var bj : [32]u8 = [0] ** 32;
    const nj : usize = raw_puts(&bj, 0, "12x");
    assert(nj == 3);
    assert(raw_uint(&bj, 0, nj) == RAW_BAD);
    // S32 (`and` to `or`: the junk is eaten as padding, 12), S33 (trailing check dropped: 12)
    // group D, raw_count_line. Each line ends in a line feed, as a line of a file does, so that the survivors of raw_eol and
    // raw_has (groups F, pending) are not decided here. The control is the same line with the right label.
    var c0 : [32]u8 = [0] ** 32;
    const m0 : usize = raw_puts(&c0, 0, "No. Variables: 1\n");
    assert(m0 == 17);
    assert(raw_count_line(&c0, m0, 0, "No. Variables: ") == 1);
    var c1 : [32]u8 = [0] ** 32;
    const m1 : usize = raw_puts(&c1, 0, "No. Variablez: 1\n");
    assert(m1 == 17);
    assert(raw_count_line(&c1, m1, 0, "No. Variables: ") == RAW_BAD);
    // S34 (prefix check dropped: 1)
    var c2 : [32]u8 = [0] ** 32;
    const m2 : usize = raw_puts(&c2, 0, "No. Variables: 1000000001\n");
    assert(m2 == 26);
    assert(raw_count_line(&c2, m2, 0, "No. Variables: ") == RAW_BAD);
    // S35 (range check dropped: 1000000001)
    var c3 : [32]u8 = [0] ** 32;
    const m3 : usize = raw_puts(&c3, 0, "No. Points: 1000000000\n");
    assert(m3 == 23);
    assert(raw_count_line(&c3, m3, 0, "No. Points: ") == 1000000000);
    // S36 (`v > RAW_MAX` to `>=`: RAW_MAX itself is refused)
}
