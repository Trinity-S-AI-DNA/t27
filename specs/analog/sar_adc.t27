/// The code of the merged blocks as they are (Cp = 0, offset 0) for each held sample: pinned so the comparison table is asserted element by element.
pub const BASE_CODE : [31]u32 = [
    1002, 840, 688, 549,
    428, 330, 259, 217,
    206, 226, 277, 357,
    462, 589, 733, 887,
    1047, 1207, 1359, 1498,
    1619, 1717, 1788, 1830,
    1841, 1821, 1770, 1690,
    1585, 1458, 1314
];
/// The code of the fitted model (Cp = CP_FIT, offset OFF_FIT_V) for each held sample.
pub const FIT_CODE : [31]u32 = [
    1006, 841, 686, 544,
    421, 321, 248, 205,
    194, 215, 267, 348,
    456, 585, 732, 889,
    1052, 1215, 1370, 1512,
    1635, 1735, 1808, 1851,
    1862, 1841, 1789, 1708,
    1601, 1471, 1325
];
; --- END PINNED DATA ------------------------------------------------------------------------------------------------------

; --- scoring: the conversions of one set (par 0 = even k, 1 = odd k, 2 = all) -----------------------------------------------
/// Is conversion i in the set par?
pub fn in_set(i: usize, par: u32) -> bool {
    if (par == 2) { return true; }
    return ((i & 1) as u32) == par;
}

/// How many conversions of the set give ngspice's code, from the held words of vp, vn (arrays of volts).
pub fn match_count_p(k: []const u32, off: u32, vp: []const f64, vn: []const f64, par: u32) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < N_CONV) {
        if (in_set(i, par) && convert_sar(k, q_sm(vp[i]), q_sm(vn[i]), off) == NG_CODE[i]) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// All 31.
pub fn match_count(k: []const u32, off: u32, vp: []const f64, vn: []const f64) -> u32 {
    return match_count_p(k, off, vp, vn, 2);
}

/// The sum and the largest of the first-violation margins over the set's conversions that do not match, volts.
pub struct Margins { sum: f64, worst: f64 }

pub fn miss_margins(k: []const u32, off: u32, vp: []const f64, vn: []const f64, par: u32) -> Margins {
    var sum : f64 = 0.0;
    var worst : f64 = 0.0;
    var i : usize = 0;
    while (i < N_CONV) {
        if (in_set(i, par) && convert_sar(k, q_sm(vp[i]), q_sm(vn[i]), off) != NG_CODE[i]) {
            const m : Miss = follow(k, q_sm(vp[i]), q_sm(vn[i]), off, NG_CODE[i]);
            sum = sum + m.margin;
            if (m.margin > worst) { worst = m.margin; }
        }
        i = i + 1;
    }
    return Margins { sum: sum, worst: worst };
}

pub struct ErrRange { lo: f64, hi: f64 }

/// The smallest and the largest signed code error (model - ngspice) over the 31 conversions.
pub fn err_range(k: []const u32, off: u32, vp: []const f64, vn: []const f64) -> ErrRange {
    var lo : f64 = 0.0;
    var hi : f64 = 0.0;
    var i : usize = 0;
    while (i < N_CONV) {
        const c : u32 = convert_sar(k, q_sm(vp[i]), q_sm(vn[i]), off);
        const e : f64 = (c as f64) - (NG_CODE[i] as f64);
        if (e < lo) { lo = e; }
        if (e > hi) { hi = e; }
        i = i + 1;
    }
    return ErrRange { lo: lo, hi: hi };
}

; --- the fit: two numbers the merged blocks do not have ---------------------------------------------------------------------
/// The top-plate parasitic, in units of the 9 um x 9 um cap_cmim (122.94 fF).
pub const CP_FIT : f64 = 0.63;
/// The comparator offset: it decides "VDP above VDN" when VDP - VDN + OFF_FIT_V > 0, volts.
pub const OFF_FIT_V : f64 = 0.0067;
/// The grid the fit searches: Cp = 0.55 + 0.004 a, a = 0 .. 40; offset = 5.0 mV + 0.1 mV b, b = 0 .. 40.
pub const FIT_CP0 : f64 = 0.55;
pub const FIT_DCP : f64 = 0.004;
pub const FIT_NA : usize = 41;
pub const FIT_OFF0 : f64 = 0.005;
pub const FIT_DOFF : f64 = 0.0001;
pub const FIT_NB : usize = 41;

pub struct Fit { cp: f64, off: f64, hits: u32, viol: f64 }

/// The grid optimum on the set par: the most exact matches, ties broken by the smallest sum of first-violation margins.
pub fn fit_grid(par: u32, vp: []const f64, vn: []const f64) -> Fit {
    var best : Fit = Fit { cp: 0.0, off: 0.0, hits: 0, viol: 1000000.0 };
    var a : usize = 0;
    while (a < FIT_NA) {
        const cp : f64 = FIT_CP0 + FIT_DCP * (a as f64);
        const k : [20]u32 = model_k(&UNITS, 1.0, cp);
        var b : usize = 0;
        while (b < FIT_NB) {
            const off : f64 = FIT_OFF0 + FIT_DOFF * (b as f64);
            const w : u32 = q_sm(off);
            const hits : u32 = match_count_p(&k, w, vp, vn, par);
            if (hits >= best.hits) {
                const v : f64 = miss_margins(&k, w, vp, vn, par).sum;
                if (hits > best.hits || v < best.viol) {
                    best = Fit { cp: cp, off: off, hits: hits, viol: v };
                }
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return best;
}

/// Cp alone: the grid optimum (Cp = FIT_CP0 + FIT_DCP a, a = 0 .. 40) of the matches for a fixed offset in volts, ties broken as fit_grid breaks them.
pub fn fit_cp(off: f64, vp: []const f64, vn: []const f64) -> Fit {
    var best : Fit = Fit { cp: 0.0, off: off, hits: 0, viol: 1000000.0 };
    const w : u32 = q_sm(off);
    var a : usize = 0;
    while (a < FIT_NA) {
        const cp : f64 = FIT_CP0 + FIT_DCP * (a as f64);
        const k : [20]u32 = model_k(&UNITS, 1.0, cp);
        const hits : u32 = match_count_p(&k, w, vp, vn, 2);
        if (hits >= best.hits) {
            const v : f64 = miss_margins(&k, w, vp, vn, 2).sum;
            if (hits > best.hits || v < best.viol) {
                best = Fit { cp: cp, off: off, hits: hits, viol: v };
            }
        }
        a = a + 1;
    }
    return best;
}

; --- the tests ------------------------------------------------------------------------------------------------------------

test the_ideal_sar_reads_every_bin_centre {
    var c : u32 = 0;
    while (c < CODES11) {
        const dv : f64 = (((c as f64) - 1023.5) * VDD_V) / 1023.0;
        const vp : u32 = q_sm(VCM_V + dv / 2.0);
        const vn : u32 = q_sm(VCM_V - dv / 2.0);
        assert_eq(convert_sar(&K_Q, vp, vn, 0), c);
        assert_eq(ideal_code(dv), c);
        c = c + 1;
    }
}

test the_sar_is_msb_first_each_plate_step_halves_and_the_msb_is_the_sign_of_the_sample {
    var res : [11]f64 = [0.0] ** 11;
    var wrong : [11]u32 = [0] ** 11;
    // VDP 0.5 V above VDN: the sample alone decides the first bit
    const c : u32 = sar_core(&K_Q, q_sm(1.0004), q_sm(0.5), 0, false, 0, &res, &wrong);
    assert_eq(c, ideal_code(0.5004));
    assert fabs64(res[0] - 0.5004) < 0.0000001;
    // between two decisions the residual moves by VDD 2^(9 - i) / 1023: Bit_10 (512 of 1023) first, Bit_1 (1 of 1023) last
    var i : usize = 0;
    var w : f64 = 512.0;
    while (i < 10) {
        assert fabs64(fabs64(res[i] - res[i + 1]) - VDD_V * w / 1023.0) < 0.0000005;
        w = w / 2.0;
        i = i + 1;
    }
    // a set decision lowers the residual, a clear one raises it: 0.5 > 0 sets the MSB, 0.5 - 0.7507 < 0 clears the next
    assert(res[0] > 0.0);
    assert(res[1] < 0.0);
    assert(res[1] < res[0]);
    assert(res[2] > res[1]);
    assert_eq(c >> 10, 1);
    assert_eq((c >> 9) & 1, 0);
    // the MSB follows the sign of the sample for either polarity, and the eleven decisions fill 11 bits
    assert_eq(convert_sar(&K_Q, q_sm(0.5), q_sm(1.0), 0) >> 10, 0);
    assert(convert_sar(&K_Q, q_sm(1.5), q_sm(0.0), 0) < CODES11);
    // run down its own bits the model has no wrong decision; one flipped bit is seen at that decision
    const own : Miss = follow(&K_Q, q_sm(1.0004), q_sm(0.5), 0, c);
    assert_eq(own.first, 0);
    assert_eq(own.nviol, 0);
    const flipped : Miss = follow(&K_Q, q_sm(1.0004), q_sm(0.5), 0, c ^ 4);
    assert(flipped.first >= 1);
    assert_eq(flipped.first, 9);
}

test a_decision_is_the_sign_of_vdp_minus_vdn_plus_the_offset_on_words {
    const a : u32 = q_sm(0.75);
    assert(!decide(a, a, 0));
    assert(decide(q_sm(0.7500001), a, 0));
    assert(!decide(a, q_sm(0.7500001), 0));
    // negative words (sign-magnitude): -0.1 V is above -0.2 V
    assert(decide(q_sm(0.0 - 0.1), q_sm(0.0 - 0.2), 0));
    assert(!decide(q_sm(0.0 - 0.2), q_sm(0.0 - 0.1), 0));
    // the offset moves the threshold: +5 mV decides "above" for VDP 4 mV under VDN and not for 6 mV under
    assert(decide(q_sm(0.746), a, q_sm(0.005)));
    assert(!decide(q_sm(0.744), a, q_sm(0.005)));
    assert(!decide(q_sm(0.754), a, q_sm(0.0 - 0.005)));
    assert(decide(q_sm(0.756), a, q_sm(0.0 - 0.005)));
    assert_eq(neg_word(0), 0);
    assert_eq(neg_word(5), NEG | 5);
    assert_eq(neg_word(NEG | 5), 5);
}

test the_pinned_reference_is_the_decks_own_sine_and_its_code_is_read_from_out {
    var k : usize = 0;
    var cm_worst : f64 = 0.0;
    while (k < N_CONV) {
        // the 11 latched bits weigh 0.5 ... 2^-11 of 1.5 V in the deck's chain of E sources: V(out) = 1.5 V code / 2048
        assert fabs64(NG_OUT[k] * 2048.0 / VDD_V - (NG_CODE[k] as f64)) < 0.03;
        assert(NG_CODE[k] < CODES11);
        // the inputs are the deck's: Vinp + Vinn = 2 VCM = 1.5 V (VDD3 and VDD8 are the same sine with opposite signs)
        assert fabs64(S_IP[k] + S_IN[k] - VDD_V) < 0.0000000002;
        // 16 conversions are 8 us, half the 16 us period of 62.5 kHz: the sine changes sign
        if (k + 16 < N_CONV) {
            assert fabs64(S_IP[k] + S_IP[k + 16] - VDD_V) < 0.0000000002;
            assert fabs64(S_IN[k] + S_IN[k + 16] - VDD_V) < 0.0000000002;
        }
        // the held top plates keep the common mode of the sample, within a few mV; conversion 0 starts from the .ic state (all nodes at
        // 0 V) and its 82 ns of tracking do not settle: 13.8 mV
        const cm : f64 = fabs64(S_VP[k] + S_VN[k] - VDD_V);
        if (k > 0 && cm > cm_worst) { cm_worst = cm; }
        if (k == 0) { assert(cm > 0.01); }
        // the amplitude is 0.6 V about 0.75 V
        assert fabs64(S_IP[k] - VCM_V) < 0.6000000001;
        k = k + 1;
    }
    assert cm_worst < 0.004;
    // the extremes of the sine fall in the middle of the 31 samples: conversions 8 and 24 sit within 0.01 V of the 0.15 V and 1.35 V peaks
    assert fabs64(S_IP[8] - 0.15) < 0.01;
    assert fabs64(S_IP[24] - 1.35) < 0.01;
    // the ngspice codes rise and fall with the held differential: monotone in VDP - VDN
    k = 1;
    while (k < N_CONV) {
        const d0 : f64 = S_VP[k - 1] - S_VN[k - 1];
        const d1 : f64 = S_VP[k] - S_VN[k];
        if (d1 > d0) { assert(NG_CODE[k] > NG_CODE[k - 1]); }
        if (d1 < d0) { assert(NG_CODE[k] < NG_CODE[k - 1]); }
        k = k + 1;
    }
}

test the_merged_blocks_as_they_are_match_none_of_the_conversions_and_the_error_has_a_shape {
    const k0 : [20]u32 = model_k(&UNITS, 1.0, 0.0);
    // the ratio words are M4a's own
    var i : usize = 0;
    while (i < 20) {
        assert_eq(k0[i], K_Q[i]);
        i = i + 1;
    }
    assert_eq(match_count(&k0, 0, &S_VP, &S_VN), 0);
    i = 0;
    while (i < N_CONV) {
        assert_eq(convert_sar(&k0, q_sm(S_VP[i]), q_sm(S_VN[i]), 0), BASE_CODE[i]);
        assert(BASE_CODE[i] != NG_CODE[i]);
        i = i + 1;
    }
    // model - ngspice: the model is 12 codes above ngspice at the low end of the sine and 21 codes below it at the high end
    const r : ErrRange = err_range(&k0, 0, &S_VP, &S_VN);
    assert_eq(r.lo, 0.0 - 21.0);
    assert_eq(r.hi, 12.0);
    // the error is a straight line, a gain and an offset: ngspice's code about the middle (1023.5) is a times the model's plus b, by
    // least squares over the 31 conversions, and no point is a full code (1.47 mV) off the line
    var sx : f64 = 0.0;
    var sy : f64 = 0.0;
    i = 0;
    while (i < N_CONV) {
        sx = sx + ((BASE_CODE[i] as f64) - 1023.5);
        sy = sy + ((NG_CODE[i] as f64) - 1023.5);
        i = i + 1;
    }
    const mx : f64 = sx / (N_CONV as f64);
    const my : f64 = sy / (N_CONV as f64);
    var sxx : f64 = 0.0;
    var sxy : f64 = 0.0;
    i = 0;
    while (i < N_CONV) {
        const dx : f64 = (BASE_CODE[i] as f64) - 1023.5 - mx;
        const dy : f64 = (NG_CODE[i] as f64) - 1023.5 - my;
        sxx = sxx + dx * dx;
        sxy = sxy + dx * dy;
        i = i + 1;
    }
    const a : f64 = sxy / sxx;
    const b : f64 = my - a * mx;
    assert(a > 1.019);
    assert(a < 1.021);
    assert(b > 4.5);
    assert(b < 4.7);
    var line : f64 = 0.0;
    i = 0;
    while (i < N_CONV) {
        const e : f64 = fabs64((NG_CODE[i] as f64) - 1023.5 - (a * ((BASE_CODE[i] as f64) - 1023.5) + b));
        if (e > line) { line = e; }
        i = i + 1;
    }
    assert(line < 0.62);
    assert(line > 0.59);
    // a miss that is not a rounding: the first wrong decision of the model is 0.11 mV .. 21.4 mV from its threshold, and 24 of the 31 are
    // more than 2 mV (1.4 LSB) away
    var far : u32 = 0;
    i = 0;
    while (i < N_CONV) {
        const f : Miss = follow(&k0, q_sm(S_VP[i]), q_sm(S_VN[i]), 0, NG_CODE[i]);
        assert(f.first >= 3);
        assert(f.first <= 11);
        if (f.margin > 0.002) { far = far + 1; }
        assert(f.margin < 0.0215);
        i = i + 1;
    }
    assert_eq(far, 24);
}

test with_the_top_plate_parasitic_and_the_comparator_offset_30_of_31_conversions_match_and_the_miss_is_a_fraction_of_a_millivolt {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    const off : u32 = q_sm(OFF_FIT_V);
    assert_eq(match_count(&kf, off, &S_VP, &S_VN), 30);
    var i : usize = 0;
    var misses : u32 = 0;
    while (i < N_CONV) {
        const c : u32 = convert_sar(&kf, q_sm(S_VP[i]), q_sm(S_VN[i]), off);
        assert_eq(c, FIT_CODE[i]);
        if (c != NG_CODE[i]) {
            misses = misses + 1;
            // off by one code, and the first wrong decision is the last or one of the last: a margin of a fraction of a millivolt
            assert(c == NG_CODE[i] + 1 || c + 1 == NG_CODE[i]);
            const f : Miss = follow(&kf, q_sm(S_VP[i]), q_sm(S_VN[i]), off, NG_CODE[i]);
            assert(f.first >= 8);
            assert(f.margin < 0.0003);
            assert_eq(f.nviol, 1);
        }
        i = i + 1;
    }
    assert_eq(misses, 1);
    const mm : Margins = miss_margins(&kf, off, &S_VP, &S_VN, 2);
    assert(mm.worst < 0.0003);
    assert(mm.worst > 0.0001);
    const r : ErrRange = err_range(&kf, off, &S_VP, &S_VN);
    assert_eq(r.lo, 0.0 - 1.0);
    assert_eq(r.hi, 0.0);
    // one LSB of the 11-bit code is VDD / 1023 = 1.466 mV: the misses are within 0.15 of it
    assert(mm.worst < 0.15 * VDD_V / 1023.0);
}

test the_two_numbers_are_the_optimum_of_a_stated_grid_and_a_narrow_one {
    const f : Fit = fit_grid(2, &S_VP, &S_VN);
    assert fabs64(f.cp - CP_FIT) < 0.000000001;
    assert fabs64(f.off - OFF_FIT_V) < 0.000000001;
    assert_eq(f.hits, 30);
    // the grid is wide enough: the optimum is inside it, not on an edge
    assert(CP_FIT > FIT_CP0 + 3.0 * FIT_DCP);
    assert(CP_FIT < FIT_CP0 + ((FIT_NA - 4) as f64) * FIT_DCP);
    assert(OFF_FIT_V > FIT_OFF0 + 3.0 * FIT_DOFF);
    assert(OFF_FIT_V < FIT_OFF0 + ((FIT_NB - 4) as f64) * FIT_DOFF);
    // narrow: 0.02 units (2.5 fF) of Cp or 1 mV of offset costs matches, and 0.63 units is 77 fF
    const kp : [20]u32 = model_k(&UNITS, 1.0, CP_FIT + 0.02);
    const km : [20]u32 = model_k(&UNITS, 1.0, CP_FIT - 0.02);
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    assert_eq(match_count(&kp, q_sm(OFF_FIT_V), &S_VP, &S_VN), 20);
    assert_eq(match_count(&km, q_sm(OFF_FIT_V), &S_VP, &S_VN), 23);
    assert_eq(match_count(&kf, q_sm(OFF_FIT_V + 0.001), &S_VP, &S_VN), 6);
    assert_eq(match_count(&kf, q_sm(OFF_FIT_V - 0.001), &S_VP, &S_VN), 11);
}

test the_fit_made_on_one_half_of_the_conversions_predicts_the_other_half {
    // fit on the even conversions (16), score the odd ones (15) that the fit never saw, and the other way round
    const fe : Fit = fit_grid(0, &S_VP, &S_VN);
    const ke : [20]u32 = model_k(&UNITS, 1.0, fe.cp);
    assert_eq(fe.hits, 16);
    assert_eq(match_count_p(&ke, q_sm(fe.off), &S_VP, &S_VN, 1), 14);
    const fo : Fit = fit_grid(1, &S_VP, &S_VN);
    const ko : [20]u32 = model_k(&UNITS, 1.0, fo.cp);
    assert_eq(fo.hits, 15);
    assert_eq(match_count_p(&ko, q_sm(fo.off), &S_VP, &S_VN, 0), 15);
    // the two halves find the same two numbers to within 0.005 units (0.6 fF) and 0.3 mV
    assert fabs64(fe.cp - fo.cp) < 0.005;
    assert fabs64(fe.off - fo.off) < 0.0003;
}

test an_ideal_sampling_instant_hides_the_switch_and_loses_the_match {
    // the SAME converter on the deck's input at the end of the clks fall (84 ns) instead of the held top plates: the switch's
    // tracking lag and injection are 1 .. 3 mV, one to two LSB of 1.47 mV
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    const k0 : [20]u32 = model_k(&UNITS, 1.0, 0.0);
    assert_eq(match_count(&kf, q_sm(OFF_FIT_V), &S_IP, &S_IN), 4);
    assert_eq(match_count(&k0, 0, &S_IP, &S_IN), 1);
    var k : usize = 1;
    var worst : f64 = 0.0;
    while (k < N_CONV) {
        const dp : f64 = fabs64(S_VP[k] - S_IP[k]);
        const dn : f64 = fabs64(S_VN[k] - S_IN[k]);
        if (dp > worst) { worst = dp; }
        if (dn > worst) { worst = dn; }
        k = k + 1;
    }
    // the held plates differ from the input at 84 ns by at most 3.7 mV from conversion 1 on, by more than an 11-bit LSB (1.47 mV); the first
    // conversion, which starts from 0 V, by 12.5 mV
    assert(worst > 0.003);
    assert(worst < 0.004);
    assert(fabs64(S_VN[0] - S_IN[0]) > 0.01);
    assert(worst > VDD_V / 1023.0);
}

test one_changed_block_breaks_the_match {
    const off : u32 = q_sm(OFF_FIT_V);
    // the bridge capacitor of 2 units instead of 1
    const kb : [20]u32 = model_k(&UNITS, 2.0, CP_FIT);
    assert_eq(match_count(&kb, off, &S_VP, &S_VN), 0);
    // Bit_8 with 3 units instead of 4
    var bad : [10]u32 = UNITS;
    bad[7] = 3;
    const ku : [20]u32 = model_k(&bad, 1.0, CP_FIT);
    assert_eq(match_count(&ku, off, &S_VP, &S_VN), 0);
    // no parasitic
    const k0 : [20]u32 = model_k(&UNITS, 1.0, 0.0);
    assert_eq(match_count(&k0, off, &S_VP, &S_VN), 2);
    // no offset, and the offset of the wrong sign
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    assert_eq(match_count(&kf, 0, &S_VP, &S_VN), 0);
    assert_eq(match_count(&kf, q_sm(0.0 - OFF_FIT_V), &S_VP, &S_VN), 0);
    // every one of these is far below the fitted 30
    assert(match_count(&kf, off, &S_VP, &S_VN) > match_count(&kb, off, &S_VP, &S_VN) + 20);
    // the bridge of 2 units also fails the ideal sweep that the 1-unit bridge passes: M4a's seal catches it by the stored words,
    // here the sequence's own bin-centre test sees it
    var wrong_bins : u32 = 0;
    var c : u32 = 0;
    while (c < CODES11) {
        const dv : f64 = (((c as f64) - 1023.5) * VDD_V) / 1023.0;
        const kb0 : [20]u32 = model_k(&UNITS, 2.0, 0.0);
        if (convert_sar(&kb0, q_sm(VCM_V + dv / 2.0), q_sm(VCM_V - dv / 2.0), 0) != c) { wrong_bins = wrong_bins + 1; }
        c = c + 128;
    }
    assert(wrong_bins >= 8);
}

test thirty_one_conversions_29_matches_with_the_offset_measured_on_the_kick_and_not_fitted {
    const off : u32 = q_sm(off_late_v());
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    // row 4: the offset is the mean of the last two decisions' flip points measured on the netlist (sar_kick.t27), Cp is row 2's
    assert_eq(match_count(&kf, off, &S_VP, &S_VN), 29);
    var i : usize = 0;
    var held : u32 = 0;
    while (i < N_CONV) {
        const c : u32 = convert_sar(&kf, q_sm(S_VP[i]), q_sm(S_VN[i]), off);
        if (c != NG_CODE[i]) {
            // the two misses are one code off: conversion 16 one high, conversion 25 one low
            assert(i == 16 || i == 25);
            if (i == 16) { assert_eq(c, NG_CODE[i] + 1); }
            if (i == 25) { assert_eq(c + 1, NG_CODE[i]); }
        }
        if (i >= 2 && c == NG_CODE[i]) { held = held + 1; }
        i = i + 1;
    }
    // the offset's decisions are the sine's conversions 0 and 1 and DC conversions: conversions 2 .. 30 never entered it, and 27 of those 29 match
    assert_eq(held, 27);
    // the fitted offset found the measured one to 0.08 mV
    assert fabs64(OFF_FIT_V - off_late_v()) < 0.0001;
    assert(off_late_v() > OFF_FIT_V);
}

test thirty_one_conversions_30_matches_with_the_offset_measured_and_only_cp_refitted {
    // row 5: Cp alone re-fitted on row 2's grid with the offset fixed at the measured value: 30 of 31 at Cp = 0.634 (row 2's was 0.630), the offset is nobody's fit
    const f : Fit = fit_cp(off_late_v(), &S_VP, &S_VN);
    assert_eq(f.hits, 30);
    assert fabs64(f.cp - 0.634) < 0.000000001;
    assert fabs64(f.off - off_late_v()) < 0.000000001;
    // the same count as the fitted row, 0.004 units (0.5 fF) of Cp away from it
    assert fabs64(f.cp - CP_FIT) < 0.0041;
    const kf : [20]u32 = model_k(&UNITS, 1.0, f.cp);
    assert_eq(match_count(&kf, q_sm(off_late_v()), &S_VP, &S_VN), 30);
}

test the_count_over_the_measured_spread_of_the_offset_is_29_to_30_from_6_6_to_6_9_mv_and_falls_beyond {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    assert_eq(match_count(&kf, q_sm(0.0066), &S_VP, &S_VN), 29);
    assert_eq(match_count(&kf, q_sm(0.006655), &S_VP, &S_VN), 29);
    assert_eq(match_count(&kf, q_sm(0.0067), &S_VP, &S_VN), 30);
    assert_eq(match_count(&kf, q_sm(0.0069), &S_VP, &S_VN), 30);
    assert_eq(match_count(&kf, q_sm(0.0070), &S_VP, &S_VN), 25);
    assert_eq(match_count(&kf, q_sm(0.0071), &S_VP, &S_VN), 21);
}

test the_first_four_decisions_are_never_within_3_mv_of_their_thresholds_so_their_larger_offset_cannot_change_a_code {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    const off : u32 = q_sm(off_late_v());
    var k : usize = 0;
    var closest : f64 = 1000.0;
    while (k < N_CONV) {
        var res : [11]f64 = [0.0] ** 11;
        var wrong : [11]u32 = [0] ** 11;
        const c : u32 = sar_core(&kf, q_sm(S_VP[k]), q_sm(S_VN[k]), off, false, 0, &res, &wrong);
        assert_eq(c, convert_sar(&kf, q_sm(S_VP[k]), q_sm(S_VN[k]), off));
        var i : usize = 0;
        while (i < 4) {
            const m : f64 = fabs64(res[i]);
            if (m < closest) { closest = m; }
            i = i + 1;
        }
        k = k + 1;
    }
    assert(closest > 0.0029);
    assert(closest < 0.0031);
    // the first decision's own offset is 2.6 mV larger than the late one: less than the closest of those four decisions to its threshold
    assert(first_off(V_BASE) - off_late_v() < closest);
}

test the_offsets_the_mechanism_rules_out_match_none_of_the_31_conversions {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    // the latch alone (+0.153 mV in this file's sign), the first decision's 9.42 mV for every decision, no offset, and the measured one with the wrong sign
    assert_eq(match_count(&kf, q_sm(0.0 - LATCH_FLIP_V), &S_VP, &S_VN), 0);
    assert_eq(match_count(&kf, q_sm(first_off(V_BASE)), &S_VP, &S_VN), 0);
    assert_eq(match_count(&kf, 0, &S_VP, &S_VN), 0);
    assert_eq(match_count(&kf, q_sm(0.0 - off_late_v()), &S_VP, &S_VN), 0);
}

; --- issue 12096: tests appended after the last original test so the line numbers of docs/analog/mutation-accepted-sar_adc.txt hold ---

test the_ideal_quantizer_clamps_below_the_first_code_and_above_the_last {
    // x = dv 1023 / 1.5 + 1024: -2 V gives -340, -1.6 V gives -67.2, +1.6 V gives 2115.2 and +2 V gives 2388, all outside 0 .. 2047
    assert_eq(ideal_code(0.0 - 2.0), 0);
    assert_eq(ideal_code(0.0 - 1.6), 0);
    assert_eq(ideal_code(1.6), 2047);
    assert_eq(ideal_code(2.0), 2047);
    // the ends and the middle of the range: x = 1 at -1.5 V (-1534.5 / 1.5 = -1023 exactly), x = 2047 at +1.5 V, x = 1024 at 0 V
    assert_eq(ideal_code(0.0 - 1.5), 1);
    assert_eq(ideal_code(1.5), 2047);
    assert_eq(ideal_code(0.0), 1024);
}

test fit_cp_returns_the_first_point_of_most_matches_and_least_margin_on_every_offset_of_the_fit_grid {
    // the reference: all 41 points of the Cp grid scored, then the most matches, then the first of the smallest sums of margins
    var b : usize = 0;
    while (b < FIT_NB) {
        const off : f64 = FIT_OFF0 + FIT_DOFF * (b as f64);
        const w : u32 = q_sm(off);
        var hits : [41]u32 = [0] ** 41;
        var viol : [41]f64 = [0.0] ** 41;
        var most : u32 = 0;
        var a : usize = 0;
        while (a < FIT_NA) {
            const k : [20]u32 = model_k(&UNITS, 1.0, FIT_CP0 + FIT_DCP * (a as f64));
            hits[a] = match_count(&k, w, &S_VP, &S_VN);
            viol[a] = miss_margins(&k, w, &S_VP, &S_VN, 2).sum;
            if (hits[a] > most) { most = hits[a]; }
            a = a + 1;
        }
        var pick : usize = FIT_NA;
        var p : usize = 0;
        while (p < FIT_NA) {
            if (hits[p] == most && (pick == FIT_NA || viol[p] < viol[pick])) { pick = p; }
            p = p + 1;
        }
        const f : Fit = fit_cp(off, &S_VP, &S_VN);
        assert_eq(f.hits, most);
        assert fabs64(f.cp - (FIT_CP0 + FIT_DCP * (pick as f64))) < 0.000000001;
        assert fabs64(f.viol - viol[pick]) < 0.000000001;
        assert fabs64(f.off - off) < 0.000000001;
        b = b + 1;
    }
}

test a_model_one_step_past_the_end_of_a_fit_grid_is_not_found_and_one_in_the_middle_is_found_at_its_first_point {
    // three models of the converter, each turned into 31 inputs that its own SAR reads as the 31 reference codes (so the model matches all 31):
    //   0: Cp one step past the last Cp of the grid (a = 41), the offset on the grid (b = 17)
    //   1: the offset one step past the last offset of the grid (b = 41), Cp on the grid (a = 20)
    //   2: Cp and offset on the grid (a = 20, b = 17), with each input in the middle of its code's interval instead of 2 uV inside one end
    var which : u32 = 0;
    while (which < 3) {
        var cp_a : f64 = 20.0;
        var off_b : f64 = 17.0;
        if (which == 0) { cp_a = 41.0; }
        if (which == 1) { off_b = 41.0; }
        const cp : f64 = FIT_CP0 + FIT_DCP * cp_a;
        const off : f64 = FIT_OFF0 + FIT_DOFF * off_b;
        const ke : [20]u32 = model_k(&UNITS, 1.0, cp);
        const w : u32 = q_sm(off);
        var vp : [31]f64 = [0.0] ** 31;
        var vn : [31]f64 = [0.0] ** 31;
        var i : usize = 0;
        while (i < N_CONV) {
            const c : u32 = NG_CODE[i];
            const d0 : f64 = (((c as f64) - 1023.5) * VDD_V) / 1023.0;
            // the lowest input that reads code c, and the lowest that reads c + 1, by bisection inside d0 +/- 80 mV (the model's gain is 2 % off the ideal one)
            assert(convert_sar(&ke, q_sm(VCM_V + (d0 - 0.08) / 2.0), q_sm(VCM_V - (d0 - 0.08) / 2.0), w) < c);
            assert(convert_sar(&ke, q_sm(VCM_V + (d0 + 0.08) / 2.0), q_sm(VCM_V - (d0 + 0.08) / 2.0), w) > c);
            var tlo : f64 = 0.0;
            var thi : f64 = 0.0;
            var j : u32 = 0;
            while (j < 2) {
                var lo : f64 = d0 - 0.08;
                var hi : f64 = d0 + 0.08;
                var it : u32 = 0;
                while (it < 44) {
                    const mid : f64 = (lo + hi) / 2.0;
                    if (convert_sar(&ke, q_sm(VCM_V + mid / 2.0), q_sm(VCM_V - mid / 2.0), w) >= c + j) { hi = mid; } else { lo = mid; }
                    it = it + 1;
                }
                if (j == 0) { tlo = hi; } else { thi = hi; }
                j = j + 1;
            }
            // the even inputs sit 2 uV inside the low end of their code's interval, the odd ones 2 uV inside the high end, so that a neighbour on the
            // grid with the offset one step (0.1 mV) either way loses one of the two kinds; model 2 puts every input in the middle instead
            var dv : f64 = tlo + 0.000002;
            if ((i & 1) == 1) { dv = thi - 0.000002; }
            if (which == 2) { dv = (tlo + thi) / 2.0; }
            vp[i] = VCM_V + dv / 2.0;
            vn[i] = VCM_V - dv / 2.0;
            assert_eq(convert_sar(&ke, q_sm(vp[i]), q_sm(vn[i]), w), c);
            i = i + 1;
        }
        assert_eq(match_count(&ke, w, &vp, &vn), 31);
        if (which == 0) {
            // the grid stops at a = 40: the model at a = 41 is not in it, and no point of it matches all 31 (fit_grid and fit_cp alike)
            assert(fit_grid(2, &vp, &vn).hits < 31);
            assert(fit_cp(off, &vp, &vn).hits < 31);
        }
        if (which == 1) {
            // the grid stops at b = 40, a tenth of a millivolt short of the model's offset
            assert(fit_grid(2, &vp, &vn).hits < 31);
        }
        if (which == 2) {
            // many neighbouring Cp match all 31 with no miss at all, and fit_cp keeps the first of them
            var first : usize = FIT_NA;
            var run : u32 = 0;
            var a : usize = 0;
            while (a < FIT_NA) {
                const k : [20]u32 = model_k(&UNITS, 1.0, FIT_CP0 + FIT_DCP * (a as f64));
                if (match_count(&k, w, &vp, &vn) == 31) {
                    run = run + 1;
                    if (first == FIT_NA) { first = a; }
                }
                a = a + 1;
            }
            assert(run >= 2);
            assert(first <= 20);
            const f : Fit = fit_cp(off, &vp, &vn);
            assert_eq(f.hits, 31);
            assert fabs64(f.viol) < 0.000000001;
            assert fabs64(f.cp - (FIT_CP0 + FIT_DCP * (first as f64))) < 0.000000001;
        }
        which = which + 1;
    }
}
