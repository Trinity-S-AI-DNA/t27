// SPDX-License-Identifier: Apache-2.0
; specs/analog/sar_adc.t27 -- the whole SAR ADC of the golden deck, conversion by conversion: our own ngspice + PSP103 codes, and a behavioural converter run on the same samples
; M4e of the SAR ADC milestone (#10524, epic #10486, issue #10818), first slice. The converter is the golden deck of uberWAVE (wp2-parser/golden/top.spice, GPL-2.0: read at
; run time, never vendored; its RAW file is never committed either): two tracking switches, the differential split capacitive DAC, the dynamic comparator, the SAR logic of
; eleven D flip-flops, 1265 transistor instances. This file (1) pins the output code of every conversion of OUR OWN ngspice + PSP103 run of that deck, with the held input of each;
; (2) runs a behavioural converter, built from the merged blocks, on the same samples; (3) compares the two conversion by conversion and says what the difference is.
; Everything hand-written is this file and one function added to M4a (derive_k_top in specs/analog/sar_cdac.t27): the DAC arithmetic and the switch event are M4a's and M1's
; (specs/analog/linear.t27), called by name. No deck is committed: the reference is a run of the golden deck, not a netlist of ours.
; -
; THE REFERENCE RUN (FR-002: the unmodified deck, paths substituted only; anyone can repeat it).
;   deck      https://gitlab.symbioticeda.com/Juan_25/uberwave/-/raw/main/wp2-parser/golden/top.spice, sha256 c5ad548a3e1a181f1b8e81e92ead2f630e14861a36b796169f4fec6b95746e23;
;             uberWAVE HEAD c75a89c8fae0eecdf18a3b31c4f2b55af56b1ae2 (read 2026-10-19); the deck last changed in 8e015311a43eee436b25734865de68b7e0617ee0 (2026-04-01).
;   changes   the two `.lib` paths /usr/local/share/OpenPDKs/IHP-Open-PDK -> a checkout of IHP-Open-PDK at commit 21133f219b1a6da10d803e345761e77415ceff40; and six `pre_osdi`
;             lines (psp103, psp103_nqs, r3_cmc, mosvar, cap_cmomi, cap_cmomf .osdi, compiled from the PDK at that commit, M3b #10516) at the top of the deck's own .control
;             block, where uberWAVE's Dockerfile puts them in spinit. Nothing else: `tran 0.1n 16u`, `.options TEMP = 50`, the `.ic` and `.nodeset` lines, `.save` and `write`
;             (an ASCII RAW of v(out), v(VDP), v(VDN), v(Vinp), v(Vinn)) are the deck's own; its `plot` is ignored in batch mode.
;   command   ngspice -b run_full.spice          ngspice-47 (Homebrew, SPARSE 1.3), models mos_tt and cap_typ (PSP103 through OSDI), TEMP 50 C (TNOM 27 C).
;   cost      2026-10-19 03:38:22Z to 04:43:17Z: wall 3894.9 s (65 min), user 3285.7 s, sys 42.5 s, on a Mac shared with other jobs (load average 5 to 40); 161633 time
;             points; a 31 MB ASCII RAW (not committed, not needed again: the numbers below are all that is read from it).
;   cross-check  uberWAVE publishes the RAW of this deck (ngspice-46, 2026-03-30; its Dockerfile also sets ngbehavior=hsa). Against it: 30 of the 31 codes are identical
;             (conversion 0, which starts from the .ic state, is 1006 here and 1007 there); at the pinned instants from conversion 1 on VDP and VDN agree to 0.007 and 0.012 mV
;             and V(out) to under 0.001 mV; the whole traces, compared every 0.5 ns, differ by at most 1.1 mV (VDP) and 1.3 mV (VDN) from 600 ns on (edge timing). And
;             `set ngbehavior=hsa` changes nothing here: a 0.5 us run with and without it differs by 0 V in all five saved vectors. A 1.1 us run of the same deck with every
;             node saved (CK1..CK11, Valid, clkc, vocp, vocn, the bits) is identical to this run to 0 V over its length; it is where the instants below were read.
; -
; THE CODE. The deck's own output is V(out): E1..E11 chain the eleven latched bits out_11 .. out_1 with weights 0.5 .. 2^-11, so V(out) = 1.5 V code / 2048 with the bits at
; 0 / 1.5 V. out_k is the D flip-flop of DAC_control stage k, latched on the rising edge of clks, so conversion k (clks high 0 .. 84 ns of each 500 ns period: the track
; phase; the SAR runs in the low phase) shows its code from 500 (k + 1) ns. NG_CODE is round(V(out) 2048 / 1.5 V) read at 500 (k + 1) + 10 ns; NG_OUT keeps the voltage, and a
; test checks that every one is within 0.03 LSB of its integer. 31 conversions: the run ends at 16 us, where the 32nd conversion would latch. One LSB of the 11-bit code is
; 3 V / 2048 = 1.466 mV of VDP - VDN.
; THE SAMPLES. S_VP and S_VN are V(VDP) and V(VDN) at 500 k + 98 ns: the track phase has ended (clks fell at 83 ns, 50 %), the comparator clock clkc has not yet started to rise
; (it passes half of Vdd 20.1 ns after clks falls: 103.12 and 603.04 ns in the 1.1 us run), and VDP and VDN move by less than 0.25 mV between 90 and 98 ns. They are the top
; plates the first comparison sees, with the switches' lag and injection in them. S_IP and S_IN are the deck's input, V(Vinp) = 0.75 V - 0.6 V sin(2 pi 62.5 kHz t) and V(Vinn)
; = 0.75 V + 0.6 V sin(...), at 500 k + 84 ns, the instant the switch is opening: the input an IDEAL switch would have sampled. The sine's 16 us period is 32 conversions, so
; conversion k + 16 samples the negative of conversion k (a test). Conversion 0 starts from the deck's .ic state (everything at 0 V) and its track phase has not settled: its
; held common mode is 13.8 mV off and VDN is 10.6 mV from the input; from conversion 1 on the held plates are within 3.1 mV of the common mode and 3.6 mV of the 84 ns input.
; -
; THE BEHAVIOURAL CONVERTER, block by block (FR-001: the level of every block is also LEVEL_* below).
;   sampling     none: the held top plates S_VP, S_VN of the run are the input (the PSP103 switch, as simulated). An ideal-sampling variant (S_IP, S_IN) is scored too.
;   DAC          M4a: ideal capacitors, exact charge redistribution, the 1-unit bridge, ratios K = C^-1 C_b as Q.24 words, a plate move is M1's step with D = 0. One
;                addition, derive_k_top: a parasitic Cp from the top plate to ground joins the Vout corner of C, so every Vout ratio is 2^j / (1023 + 32 Cp) (a test in
;                sar_cdac.t27). Both halves are modelled (the P half on VDP with the bits, the N half on VDN with the complements), each from its own sample; net1 starts at
;                the sample and the comparator never sees it (a move of Vout does not depend on the state).
;   comparator   the sign of VDP - VDN + off, on words: true means "VDP above VDN", which is the latch's dp winning (M4b's convention) and out_k = 1 (D0 = vocn at CK_k, whose
;                inverse drives the plate). M4b's latch is NOT run: 31 x 11 regenerations at 0.1 ps would be a different PR, and the decision here is a stated number.
;   SAR logic    decision i = 0 .. 10, MSB first; a set decision lowers the P plate and raises the N plate by VCM, a clear one the reverse; the plate is Bit_10 after the first
;                decision, Bit_9 after the second, ... Bit_1 after the tenth; the eleventh decision moves no plate (Bit_0 has no capacitor); the code is the 11 decisions. Read
;                from DAC_control_top, DAC_control, neg_bottom_plate_logic and SAR_logic of the deck. M4d (#10754) replaces this sequence with the gates.
; With K from the merged M4a, a zero offset and no parasitic, the converter is exactly the ideal quantizer floor(1023 dv / 1.5 V + 1024) (a test over all 2048 bin centres).
; -
; THE RESULT, 31 conversions, exact code match (model = ngspice), three rows.
;   1  the merged blocks as they are (Cp = 0, off = 0): 0 of 31 match. model - ngspice is -21 .. +12 codes, and the first wrong decision of each lies 0.11 .. 21.4 mV from its
;      threshold: 24 of the 31 are more than 2 mV away, so these are not roundings. The error is a straight line: ngspice's code about the middle (1023.5) is 1.0199 times the
;      model's plus 4.60 codes, and no point is 0.61 code (0.9 mV) off that line (least squares, a test). A gain of 1.02 is the DAC steps being 1.95 % smaller than ideal
;      capacitors give (a parasitic on the top plate takes 1023 / (1023 + 32 Cp) of every step: 0.9816 at the fit), and an offset of 4.6 codes (6.7 mV) is the comparator
;      deciding "above" while VDP is still that far below VDN. A bridge or a unit count that is wrong bends the line (M4a) and does not give this; the controls below show it.
;   2  + Cp = 0.63 units and off = +6.7 mV: 30 of 31 match. model - ngspice is -1 .. 0 codes; the one miss, conversion 25 (1841 against 1842), has its first wrong decision at the
;      tenth, 0.133 mV from the threshold: 0.09 LSB. Moving the offset by 0.2 mV to 6.9 mV matches 30 again and the miss becomes conversion 16 (1053 against 1052, 0.196 mV): the
;      last code is below the resolution of a two-number model.
;   3  the same on an ideal-sampling input (S_IP, S_IN): 4 of 31 with the fit, 1 of 31 without it. The PSP103 switch's lag and injection (up to 3.6 mV from conversion 1 on) are
;      one to three LSB of the 11-bit code and cannot be left out of a converter model.
; THE FIT. Cp = 0.63 units of the 9 um x 9 um cap_cmim (122.94 fF, M4c), 77 fF; off = +6.7 mV (the comparator decides "above" when VDP - VDN + 6.7 mV > 0). It is the optimum
; of a stated grid (a test: Cp = 0.55 + 0.004 a units, a = 0 .. 40; off = 5.0 mV + 0.1 mV b, b = 0 .. 40): most matches first, then the least total distance-from-threshold of
; the misses. It was made on ALL 31 conversions, so row 2 describes this run, it does not predict another. The held-out check is separate and is a test: the same search on
; the 16 even conversions alone (all 16 match, Cp 0.626, 6.7 mV) scores the 15 odd ones it never saw 14 of 15; on the 15 odd alone (all 15, Cp 0.630, 6.9 mV) the 16 even 15 of
; 16. The optimum is narrow in the offset and broad in Cp: Cp -0.02 / +0.02 units matches 23 / 20, the offset -1 / +1 mV matches 11 / 6.
; WHAT THE TWO NUMBERS ARE. Cp is everything on the top plate that M4a does not have: the explicit 4 fF capacitors (C3, C5 on VDP, C2 in the switch: 12 fF) and the device
; capacitance of the comparator's 36-unit input device and of the switch, which this file does not decompose. off is not the comparator's offset alone: it is mostly the clock edge's
; kickback (THE OFFSET, below). The first reading of it, from the 22 decisions of the two conversions in the 1.1 us all-nodes run (the real VDP - VDN a fixed time before clkc passes
; half of Vdd, against the decided bit), put the decision point at +2.5 .. +3.1 mV for 1 ns before, +3.3 .. +4.0 mV for 2 ns: those are in this file's sign convention ("above" when
; VDP - VDN + off > 0, off = minus the flip point; M4b-psp's dynamic_comparator_top, 0.153 mV, has the SAME sign, not the opposite), and they were read INSIDE the kickback, which by
; 1 ns before half of Vdd has already moved VDP - VDN by 3.9 mV. Read before the edge (clkc at 0.1 V) the golden comparator flips at VDP - VDN = -6.7 .. -6.9 mV: the fitted 6.7 mV
; was the comparator's real view of the plates, and it was found by the fit to 0.08 mV. Cp stays a fit.
; -
; THE OFFSET (M4e-offset, #10888, sub-issue #10941; specs/analog/sar_kick.t27 has the data, the estimators and the tests; specs/analog/decks/sar_off_*.cir the experiments). Seven ngspice + PSP103 decks of the
; golden circuit change one thing each and read the first decision's flip point (an eighth, sar_off_ron.cir, measures a golden tgate's resistance): the golden circuit +9.42 mV; ideal tracking switches +9.19 (moved by -0.23 +- 0.40: the switches are not
; it); the comparator's kickback removed (buffers between the plates and the comparator) +0.03 (-9.38: it IS the offset, and what is left holds the latch's own 0.153 mV); the N half's
; bottom plates ideal -25.8 (-35.2); the P half's ideal +43.9 (+34.5); both halves' ideal and symmetric +0.27 (-9.14, again the latch's); a tgate's resistance added to the P half's plates -0.89 (-10.31). When clkc rises the comparator's tail node and the drains
; of its input pair fall and its gate capacitances push charge into the two top plates: VDP falls by 22.7 mV and VDN by 30.2 mV by half of Vdd, because the N half's bottom plates sit behind
; one more transmission gate (neg_bottom_plate_logic's x11 or x15) than the P half's and are softer at that time scale (a resistor of a golden tgate's size, 2592 ohm, added to each P plate
; takes the first decision's offset from +9.42 to -0.89 mV; with stiff plates both fall by 6.87 mV and nothing is left).
; The difference, 7.5 mV, plus the latch's regeneration margin, is the offset: 9.42 mV at the first decision, 6.66 mV (decision 9) and 6.90 mV (decision 10) at the last ones, from 26 DC
; conversions that put those decisions' D at 0.2 mV steps around their flip points. THE MODEL TAKES the mean of the last two, 6.776 mV (sar_kick.t27 off_late_v), for every decision:
; the decisions from the first to the fourth are never within 3 mV of their thresholds in the 31 conversions (the closest is 3.01 mV, a test), so their 2.6 mV larger value cannot change a code.
;   row 4  the merged blocks, Cp = 0.63 (row 2's), off = 6.776 mV MEASURED: 29 of 31 match; the misses are conversions 16 (+1 code) and 25 (-1 code). The fitted 6.7 mV is 0.08 mV from the measured offset.
;   row 5  the same with Cp re-fitted ALONE on row 2's grid, the offset fixed: 30 of 31 at Cp = 0.634. Only Cp is fitted.
; The count over the measured spread of the offset (Cp = 0.63): 6.6 mV 29, 6.655 29, 6.7 30, 6.9 30, 7.0 25, 7.1 21. The flip point depends on the bit path at the 0.1 mV level (decision 10's
; threshold lies between -7.06 and -6.85 mV depending on the path), which is the size of what separates 29 from 30. What is NOT done: the kick is measured, not derived from the plates' drive
; (the follow-up, #10942): and Cp is not predicted (the first plate step gives Cp from 0.58 to 0.85 units depending on how the plates are driven).
; -
; THE LEVELS (FR-001). Reference: the whole deck at PSP103 (OSDI) level. Sampling: PSP103, taken from the reference run. DAC: behavioural (ideal capacitors, exact charge
; redistribution) plus one fitted parasitic. Comparator: behavioural (a sign and an offset, fitted in row 2, measured on the netlist in rows 4 and 5); the square-law M4b is not called. SAR logic: behavioural sequence. The tracking
; switch of M4c is square law and is not called either: its lag at the sine's zero crossing is 1.27 mV, and this deck's held plates sit 2.5 mV from the 84 ns input there
; (conversion 16, slope 0.236 mV/ns, injection included): not the same quantity, but the level of the switch matters at the size of a few LSB.
; -
; THE NEGATIVE CONTROLS (tests that pass by seeing the failure), each on the fitted model's 30 of 31: the bridge of 2 units instead of 1 matches 0 of 31 (it also fails the
; ideal sweep); Bit_8 with 3 units instead of 4 matches 0; no parasitic matches 2; no offset 0; the offset of the wrong sign 0; Cp or the offset moved by 0.02 units or 1 mV
; loses 7 to 24 matches.
; -
; WHAT A PASS SAYS. The output code of each of 31 conversions of the golden deck at PSP103 (ngspice-47, IHP-Open-PDK 21133f21, TEMP 50 C), with the held plates of each, are
; pinned with their provenance and agree with uberWAVE's own published run in 30 of 31 codes. The merged blocks alone (ideal DAC, a sign) match none of them: they are 21 codes
; low to 12 codes high, on a straight line with gain 1.02 and offset +4.6 codes. With one top-plate parasitic and one comparator offset they match 30 of 31, the other is one
; code off at 0.133 mV from a threshold, and the same search on half the conversions predicts the other half 14 of 15 and 15 of 16. The sequence is MSB first with Bit_10 after
; the first decision; the ideal converter is the exact quantizer; a changed bridge, unit count, parasitic or offset is caught.
; WHAT IT DOES NOT SAY. Nothing about speed: no timing is modelled, the reference took 65 minutes and the behavioural converter does 31 conversions in a fraction of a second,
; which is not a comparison of the same thing. Nothing about power, noise, mismatch, supply or temperature, or about another corner: one run, TEMP 50 C, mos_tt, cap_typ.
; Nothing about the comparator as a circuit: the sign and offset are a stated behaviour, not M4b's latch; the offset's cause is found and measured (THE OFFSET), not derived. Nothing about
; the switch: the samples are the run's, not M4c's. Nothing about the SAR logic as gates (M4d). Nothing about conversion 0 beyond its code (it is the .ic transient). The fit
; uses the 31 codes it is then scored on: row 2 is a description of this run, only the held-out rows are predictions, and 15 and 16 conversions of one sine are few. Nothing
; about a board: no bitstream, no clock, no LUT, DSP or BRAM.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogSarAdc;

use analog::linear::{NEG, MAG, q_sm, sm_f64, pack, is_neg, add_sm, fabs64};
use analog::sar_cdac::{UNITS, SIDE, PLATES, K_Q, derive_k_top, event_k, plate_step};
use analog::sar_kick::{off_late_v, first_off, V_BASE, LATCH_FLIP_V};

pub const KIND : str = "analog-cell";
pub const ID : str = "analog/sar_adc";
pub const REFERENCE : str = "uberWAVE wp2-parser/golden/top.spice (read at run time, GPL-2.0, not vendored); specs/analog/sar_cdac.t27";

; --- the levels of every block (FR-001) ---------------------------------------------------------------------------------
pub const LEVEL_SAMPLE : str = "ngspice 47 + IHP PSP103 (the whole deck): VDP and VDN read from the run; ideal input variant also reported";
pub const LEVEL_DAC : str = "behavioural: ideal capacitors, exact charge redistribution (M4a sar_cdac), plus one parasitic on the top plate";
pub const LEVEL_COMPARATOR : str = "behavioural: the sign of VDP - VDN + offset (M4b sar_comparator is not run)";
pub const LEVEL_LOGIC : str = "behavioural: one decision per step, MSB first (M4d, #10754, replaces it with the gates)";

; --- the converter -------------------------------------------------------------------------------------------------------
/// Decisions per conversion: the MSB against the sample alone, ten plate moves, the last against the 10-plate residual.
pub const DECISIONS : usize = 11;
pub const CODES11 : u32 = 2048;
pub const VDD_V : f64 = 1.5;
pub const VCM_V : f64 = 0.75;

/// The negation of a sign-magnitude word (zero stays zero).
pub fn neg_word(w: u32) -> u32 {
    return pack(w & MAG, !is_neg(w));
}

/// The comparator, behavioural: true iff VDP - VDN + off > 0, on words (M1's adder and a sign test). `off` is a word, volts * 2^24.
pub fn decide(p: u32, n: u32, off: u32) -> bool {
    const d : u32 = add_sm(add_sm(p, neg_word(n)), off);
    if ((d & MAG) == 0) { return false; }
    return !is_neg(d);
}

/// The SAR sequence of the deck, the one implementation. Decision i = 0 .. 10, MSB first: the model decides from the top-plate words
/// (xp, xn: net1 and Vout of each half), then the plate of the DECIDED bit moves: a set decision (VDP above VDN) lowers the P plate and
/// raises the N plate, a clear one the reverse; the plate is index PLATES - 1 - i (Bit_10 after the first decision, Bit_1 after the
/// tenth); the eleventh decision moves no plate. res[i] is VDP - VDN + off in volts before decision i. With `force` the plates follow
/// the bits of `ng` instead of the model's own (ngspice's path) and wrong[i] is 1 where the model's sign differs from ngspice's bit.
/// Returns the code the model's decisions give.
pub fn sar_core(k: []const u32, vp: u32, vn: u32, off: u32, force: bool, ng: u32, res: []f64, wrong: []u32) -> u32 {
    var xp : [2]u32 = [vp, vp];
    var xn : [2]u32 = [vn, vn];
    var yp : [2]u32 = [0, 0];
    var yn : [2]u32 = [0, 0];
    var code : u32 = 0;
    var i : usize = 0;
    while (i < DECISIONS) {
        res[i] = sm_f64(xp[1]) - sm_f64(xn[1]) + sm_f64(off);
        const d : bool = decide(xp[1], xn[1], off);
        const nb : bool = ((ng >> ((DECISIONS - 1 - i) as u32)) & 1) == 1;
        wrong[i] = 0;
        if (force && d != nb) { wrong[i] = 1; }
        var b : bool = d;
        if (force) { b = nb; }
        code = code * 2;
        if (d) { code = code + 1; }
        if (i < PLATES) {
            const j : usize = PLATES - 1 - i;
            event_k(k, j, plate_step(!b), &xp, &yp);
            event_k(k, j, plate_step(b), &xn, &yn);
            xp[0] = yp[0];
            xp[1] = yp[1];
            xn[0] = yn[0];
            xn[1] = yn[1];
        }
        i = i + 1;
    }
    return code;
}

/// The 11-bit code of one conversion from the held top-plate words vp, vn.
pub fn convert_sar(k: []const u32, vp: u32, vn: u32, off: u32) -> u32 {
    var res : [11]f64 = [0.0] ** 11;
    var wrong : [11]u32 = [0] ** 11;
    return sar_core(k, vp, vn, off, false, 0, &res, &wrong);
}

/// What a conversion run down ngspice's own path shows: the first decision (1 .. 11, 0 = none) at which the model's sign differs from
/// ngspice's bit, the model's |VDP - VDN + off| there (its distance from the decision threshold), and how many decisions differ in all.
pub struct Miss { first: u32, margin: f64, nviol: u32 }

/// The model's DAC with the plates following ngspice's bits `ng`, the model's sign compared with each bit.
pub fn follow(k: []const u32, vp: u32, vn: u32, off: u32, ng: u32) -> Miss {
    var res : [11]f64 = [0.0] ** 11;
    var wrong : [11]u32 = [0] ** 11;
    const c : u32 = sar_core(k, vp, vn, off, true, ng, &res, &wrong);
    var first : u32 = 0;
    var margin : f64 = 0.0;
    var nviol : u32 = 0;
    var i : usize = 0;
    while (i < DECISIONS) {
        if (wrong[i] == 1) {
            nviol = nviol + 1;
            if (first == 0) {
                first = (i as u32) + 1;
                margin = fabs64(res[i]);
            }
        }
        i = i + 1;
    }
    return Miss { first: first, margin: margin, nviol: nviol };
}

/// Words of f64 ratios: q_sm of each.
pub fn words_of(kf: []const f64) -> [20]u32 {
    var w : [20]u32 = [0] ** 20;
    var i : usize = 0;
    while (i < 20) {
        w[i] = q_sm(kf[i]);
        i = i + 1;
    }
    return w;
}

/// The model's ratio words for a unit list, a bridge of `bridge` units and a top-plate parasitic of `top` units (the deck: UNITS, 1, fit).
pub fn model_k(units: []const u32, bridge: f64, top: f64) -> [20]u32 {
    const kf : [20]f64 = derive_k_top(units, &SIDE, bridge, 0.0, top);
    return words_of(&kf);
}

/// The ideal quantizer of the 11-bit converter: floor(x + 1024), x = (VDP - VDN) 1023 / VDD, clamped to 0 .. 2047.
pub fn ideal_code(dv: f64) -> u32 {
    const x : f64 = dv * 1023.0 / VDD_V + 1024.0;
    if (x < 0.0) { return 0; }
    if (x >= 2047.0) { return 2047; }
    return x as u32;
}

pub const N_CONV : usize = 31;
; --- BEGIN PINNED DATA (the reference run: see the header) -----------------------------------------------------------------
