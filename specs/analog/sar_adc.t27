pub const S_IN : [31]f64 = [
    0.7697884445, 0.8863987294, 0.9977672876, 1.0996142878,
    1.1880258070, 1.2596042402, 1.3115988681, 1.3420115665,
    1.3496735924, 1.3342904985, 1.2964534484, 1.2376164987,
