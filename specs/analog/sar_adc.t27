/// V(VDP) of the deck at 500 k + 98 ns, volts: the held top plate of the P half, 5 ns before the comparator clock reaches half of Vdd.
pub const S_VP : [31]f64 = [
    0.7269686961, 0.6147933219, 0.5032696326, 0.4011759707,
    0.3124819051, 0.2406802002, 0.1883776363, 0.1576606066,
    0.1496928808, 0.1647834218, 0.2023500934, 0.2609311830,
    0.3383049515, 0.4314737982, 0.5367822844, 0.6503503377,
    0.7677272898, 0.8835405443, 0.9950495472, 1.0971101614,
