    4.028570114e-03, 4.025980268e-03, 2.718979635e-03, 4.077966063e-01, 1.499988215e+00, 1.499979013e+00, 4.011192655e-03, 4.615473271e-02
];
/// Decision time and resolution time of the four decks, in steps (0.1 ps) after the clock through 0.75 V: (tfirst - tck) and
/// (tres - tck) of the .meas lines. The -2 mV and -0.5 mV decks print the same times as +2 mV and +0.5 mV, to the 6 digits.
pub const SC_NG_FIRST_2 : f64 = 54.9629;
pub const SC_NG_RES_2 : f64 = 69.3083;
pub const SC_NG_FIRST_05 : f64 = 55.6936;
pub const SC_NG_RES_05 : f64 = 76.9385;
/// The loser's peak (dnmax of the +2 mV and +0.5 mV decks, dpmax of the others), in volts.
pub const SC_NG_PEAK_2 : f64 = 0.747264;
pub const SC_NG_PEAK_05 : f64 = 0.822056;

/// The largest |model - ngspice| over the eight nodes at the eight recorded steps, in volts; the model's states are real, in units.
pub fn sc_dev_ng_f(out: []const f64, ng: []const f64) -> f64 {
    var worst : f64 = 0.0;
    var c : u32 = 0;
    while (c < 8) {
        var n : u32 = 0;
        while (n < SC_NN) {
            const model : f64 = out[(SC_CHK[c as usize] * SC_NN + n) as usize] / SC_UPV;
            worst = fmax64(worst, fabs64(model - ng[(c * SC_NN + n) as usize]));
            n = n + 1;
        }
        c = c + 1;
    }
    return worst;
}

/// The same for the fixed-point run's unsigned states.
pub fn sc_dev_ng_u(out: []const u32, ng: []const f64) -> f64 {
    var worst : f64 = 0.0;
    var c : u32 = 0;
    while (c < 8) {
        var n : u32 = 0;
        while (n < SC_NN) {
            const model : f64 = ((out[(SC_CHK[c as usize] * SC_NN + n) as usize]) as f64) / SC_UPV;
            worst = fmax64(worst, fabs64(model - ng[(c * SC_NN + n) as usize]));
            n = n + 1;
        }
        c = c + 1;
    }
    return worst;
}

/// The largest |a - b| between a fixed-point run and a real run over every node and step, in units.
pub fn sc_dev_fix_f(a: []const u32, b: []const f64) -> f64 {
    var worst : f64 = 0.0;
    var i : usize = 0;
    while (i < SC_LEN) {
        worst = fmax64(worst, fabs64((a[i] as f64) - b[i]));
        i = i + 1;
    }
    return worst;
}

/// The largest |a - b| between two real runs, in units.
pub fn sc_dev_f_f(a: []const f64, b: []const f64) -> f64 {
    var worst : f64 = 0.0;
    var i : usize = 0;
    while (i < SC_LEN) {
        worst = fmax64(worst, fabs64(a[i] - b[i]));
        i = i + 1;
    }
    return worst;
}

/// The largest |entry - law| over the 625 nodes, in table units, against the law with the true threshold.
pub fn sc_node_err(t: []const u32) -> f64 {
    var worst : f64 = 0.0;
    var ix : u32 = 0;
    while (ix < NODES) {
        var iy : u32 = 0;
        while (iy < NODES) {
            const want : f64 = sc_law_t(((ix as f64) / 16.0) * SC_UPV, ((iy as f64) / 16.0) * SC_UPV);
            worst = fmax64(worst, fabs64((t[(ix * NODES + iy) as usize] as f64) - want));
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    return worst;
}

/// A copy of the device multipliers with the input pair's m set to (a, b): XM3 gets a, XM4 gets b.
pub fn sc_mult_pair(a: u32, b: u32, mult: []u32) {
    var e : usize = 0;
    while (e < (SC_NDEV as usize)) {
        mult[e] = SC_DV_M[e];
        e = e + 1;
    }
    mult[2] = a;
    mult[3] = b;
}

/// The node that takes the place of node n when the two halves of the comparator are exchanged.
pub fn sc_mirror_node(n: u32) -> u32 {
    if (n == SC_AP) { return SC_AN; }
    if (n == SC_AN) { return SC_AP; }
    if (n == SC_NET2) { return SC_NET3; }
    if (n == SC_NET3) { return SC_NET2; }
    if (n == SC_DP) { return SC_DN; }
    if (n == SC_DN) { return SC_DP; }
    return n;
}

/// The largest |a(step, n) - b(step, mirror(n))| over a pair of fixed-point runs, in units: 0 for a circuit that is symmetric.
pub fn sc_mirror_dev_u(a: []const u32, b: []const u32) -> u32 {
    var worst : u32 = 0;
    var j : u32 = 0;
    while (j <= SC_N) {
        var n : u32 = 0;
        while (n < SC_NN) {
            const d : u32 = mag_diff(a[(j * SC_NN + n) as usize], b[(j * SC_NN + sc_mirror_node(n)) as usize]);
            if (d > worst) { worst = d; }
            n = n + 1;
        }
        j = j + 1;
    }
    return worst;
}

/// The same for two real runs.
pub fn sc_mirror_dev_f(a: []const f64, b: []const f64) -> f64 {
    var worst : f64 = 0.0;
    var j : u32 = 0;
    while (j <= SC_N) {
        var n : u32 = 0;
        while (n < SC_NN) {
            worst = fmax64(worst, fabs64(a[(j * SC_NN + n) as usize] - b[(j * SC_NN + sc_mirror_node(n)) as usize]));
            n = n + 1;
        }
        j = j + 1;
    }
    return worst;
}

/// The state at step j of a real run as eight reals.
pub fn sc_state_f(out: []const f64, j: u32, v: []f64) {
    var n : u32 = 0;
    while (n < SC_NN) {
        v[n as usize] = out[(j * SC_NN + n) as usize];
        n = n + 1;
    }
}

/// The state at step j of a fixed-point run as eight words.
pub fn sc_state_u(out: []const u32, j: u32, v: []u32) {
    const base : u32 = j * SC_NN;
    var n : u32 = 0;
    while (n < SC_NN) {
        v[n as usize] = out[(base + n) as usize];
        n = n + 1;
    }
}

/// A sign-magnitude word as a real number.
pub fn sc_word_f(w: u64) -> f64 {
    const m : f64 = (sc_mag(w)) as f64;
    if (sc_neg(w)) { return 0.0 - m; }
    return m;
}

/// The largest |dG_i / dv_j (central difference, +-SC_FD_DELTA units) - J_ij| of the real system at v, for the step from v0 with
/// the clock, VDP and VDN in drv. With transposed set it compares against J_ji instead, which is wrong on purpose.
pub fn sc_fd_err(mode: u32, t: []const u32, v: []const f64, v0: []const f64, drv: []const f64, mult: []const u32, transposed: bool) -> f64 {
    var j0 : [72]f64 = [0.0] ** 72;
    var jp : [72]f64 = [0.0] ** 72;
    var jq : [72]f64 = [0.0] ** 72;
    var vp : [8]f64 = [0.0] ** 8;
    var vq : [8]f64 = [0.0] ** 8;
    sc_stamp_f(mode, t, v, v0, drv, mult, &j0);
    var worst : f64 = 0.0;
    var j : u32 = 0;
    while (j < SC_NN) {
        var n : u32 = 0;
        while (n < SC_NN) {
            vp[n as usize] = v[n as usize];
            vq[n as usize] = v[n as usize];
            n = n + 1;
        }
        vp[j as usize] = v[j as usize] + SC_FD_DELTA;
        vq[j as usize] = v[j as usize] - SC_FD_DELTA;
        sc_stamp_f(mode, t, &vp, v0, drv, mult, &jp);
        sc_stamp_f(mode, t, &vq, v0, drv, mult, &jq);
        var i : u32 = 0;
        while (i < SC_NN) {
            const fd : f64 = (jp[(SC_FG + i) as usize] - jq[(SC_FG + i) as usize]) / (2.0 * SC_FD_DELTA);
            var an : f64 = j0[(i * SC_NN + j) as usize];
            if (transposed) { an = j0[(j * SC_NN + i) as usize]; }
            worst = fmax64(worst, fabs64(fd - an));
            i = i + 1;
        }
        j = j + 1;
    }
    return worst;
}

/// The largest |G_fixed - G_real| over the eight nodes at the fixed-point state v (a table system, both stamps on the same words), units.
pub fn sc_gap_g(t: []const u32, v: []const u32, v0: []const u32, clk: u32, vdp: u32, vdn: u32, mult: []const u32) -> f64 {
    var reg : [144]u64 = [0] ** 144;
    sc_stamp(t, v, v0, clk, vdp, vdn, mult, &reg);
    var vf : [8]f64 = [0.0] ** 8;
    var v0f : [8]f64 = [0.0] ** 8;
    var n : u32 = 0;
    while (n < SC_NN) {
        vf[n as usize] = (v[n as usize]) as f64;
        v0f[n as usize] = (v0[n as usize]) as f64;
        n = n + 1;
    }
    var jg : [72]f64 = [0.0] ** 72;
    var drv : [3]f64 = [0.0] ** 3;
    drv[0] = (clk) as f64;
    drv[1] = (vdp) as f64;
    drv[2] = (vdn) as f64;
    sc_stamp_f(0, t, &vf, &v0f, &drv, mult, &jg);
    var worst : f64 = 0.0;
    n = 0;
    while (n < SC_NN) {
        const gx : f64 = (reg[(SC_RGP + n) as usize] as f64) - (reg[(SC_RGN + n) as usize] as f64);
        worst = fmax64(worst, fabs64(gx - jg[(SC_FG + n) as usize]));
        n = n + 1;
    }
    return worst;
}

/// The largest |J_fixed / 2^20 - J_real| over the 64 entries at the same state.
pub fn sc_gap_j(t: []const u32, v: []const u32, v0: []const u32, clk: u32, vdp: u32, vdn: u32, mult: []const u32) -> f64 {
    var reg : [144]u64 = [0] ** 144;
    sc_stamp(t, v, v0, clk, vdp, vdn, mult, &reg);
    var vf : [8]f64 = [0.0] ** 8;
    var v0f : [8]f64 = [0.0] ** 8;
    var n : u32 = 0;
    while (n < SC_NN) {
        vf[n as usize] = (v[n as usize]) as f64;
        v0f[n as usize] = (v0[n as usize]) as f64;
        n = n + 1;
    }
    var jg : [72]f64 = [0.0] ** 72;
    var drv : [3]f64 = [0.0] ** 3;
    drv[0] = (clk) as f64;
    drv[1] = (vdp) as f64;
    drv[2] = (vdn) as f64;
    sc_stamp_f(0, t, &vf, &v0f, &drv, mult, &jg);
    var worst : f64 = 0.0;
    var k : usize = 0;
    while (k < 64) {
        const jx : f64 = ((reg[(SC_RJP as usize) + k] as f64) - (reg[(SC_RJN as usize) + k] as f64)) / CELL_F;
        worst = fmax64(worst, fabs64(jx - jg[k]));
        k = k + 1;
    }
    return worst;
}

/// The largest |fixed - real| over the first steps 0..last, in units.
pub fn sc_dev_prefix(a: []const u32, b: []const f64, last: u32) -> f64 {
    var worst : f64 = 0.0;
    var i : usize = 0;
    while (i < (((last + 1) * SC_NN) as usize)) {
        worst = fmax64(worst, fabs64((a[i] as f64) - b[i]));
        i = i + 1;
    }
    return worst;
}

/// The highest value node sel takes over a real run, in units.
pub fn sc_peak_f(out: []const f64, sel: u32) -> f64 {
    var m : f64 = 0.0;
    var j : u32 = 0;
    while (j <= SC_N) {
        m = fmax64(m, out[(j * SC_NN + sel) as usize]);
        j = j + 1;
    }
    return m;
}

/// The largest magnitude among the first n sign-magnitude words.
pub fn sc_max_mag(w: []const u64, n: u32) -> u64 {
    var m : u64 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (sc_mag(w[i as usize]) > m) { m = sc_mag(w[i as usize]); }
        i = i + 1;
    }
    return m;
}

/// The widest word the fixed-point solve forms in a whole run, as a bound: the largest register, the largest matrix word
/// before and after elimination, and the largest sum back substitution can form, 8 |a|max |x|max + |b|max 2^20. A u64 holds
/// the result when it is below 2^63; the tests ask for 2^62.
pub fn sc_headroom(t: []const u32, h: u32, swap: bool, k: u32, mult: []const u32) -> u64 {
    var vdp : u32 = SC_VCM + h;
    var vdn : u32 = SC_VCM - h;
    if (swap) {
        vdp = SC_VCM - h;
        vdn = SC_VCM + h;
    }
    var v : [8]u32 = [0] ** 8;
    var v0 : [8]u32 = [0] ** 8;
    sc_rest(vdp, vdn, &v);
    var wide : u64 = 0;
    var j : u32 = 1;
    while (j <= SC_N) {
        var n : u32 = 0;
        while (n < SC_NN) {
            v0[n as usize] = v[n as usize];
            n = n + 1;
        }
        const clk : u32 = sc_clk_at(j);
        var i : u32 = 0;
        while (i < k) {
            var reg : [144]u64 = [0] ** 144;
            var a : [72]u64 = [0] ** 72;
            var x : [8]u64 = [0] ** 8;
            sc_stamp(t, &v, &v0, clk, vdp, vdn, mult, &reg);
            var r : u64 = 0;
            var q : usize = 0;
            while (q < SC_REG_LEN) {
                if (reg[q] > r) { r = reg[q]; }
                q = q + 1;
            }
            sc_load(&reg, &a);
            const before : u64 = sc_max_mag(&a, 72);
            sc_eliminate(&a);
            sc_backsub(&a, &x);
            const amax : u64 = sc_max_mag(&a, 72);
            const xmax : u64 = sc_max_mag(&x, 8);
            var bmax : u64 = 0;
            n = 0;
            while (n < SC_NN) {
                if (sc_mag(a[(n * 9 + 8) as usize]) > bmax) { bmax = sc_mag(a[(n * 9 + 8) as usize]); }
                n = n + 1;
            }
            const sums : u64 = 8 * amax * xmax + (bmax << CELL_BITS);
            if (r > wide) { wide = r; }
            if (before > wide) { wide = before; }
            if (amax > wide) { wide = amax; }
            if (sums > wide) { wide = sums; }
            sc_apply(&v, &x);
            i = i + 1;
        }
        j = j + 1;
    }
    return wide;
}

/// How many of the first n words equal x.
pub fn sc_count_eq(r: []const u32, n: u32, x: u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (r[i as usize] == x) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// The highest value node sel takes over a fixed-point run.
pub fn sc_peak(out: []const u32, sel: u32) -> u32 {
    var m : u32 = 0;
    var j : u32 = 0;
    while (j <= SC_N) {
        if (out[(j * SC_NN + sel) as usize] > m) { m = out[(j * SC_NN + sel) as usize]; }
        j = j + 1;
    }
    return m;
}

/// Does node sel never rise (never exceed its previous sample) from step 1 on in a fixed-point run?
pub fn sc_never_rises(out: []const u32, sel: u32) -> bool {
    var j : u32 = 2;
    while (j <= SC_N) {
        if (out[(j * SC_NN + sel) as usize] > out[((j - 1) * SC_NN + sel) as usize]) { return false; }
        j = j + 1;
    }
    return true;
}

/// The first crossing of Vdd / 2 by one node, as sc_t_first reports it (SC_NONE when the node never gets there).
pub fn sc_t_node(out: []const u32, sel: u32) -> u32 {
    var s : [141]u32 = [0] ** 141;
    sc_pick(out, sel, &s);
    return sc_cross(&s);
}

/// The largest of the first n words.
pub fn sc_max_u(r: []const u32, n: u32) -> u32 {
    var m : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (r[i as usize] > m) { m = r[i as usize]; }
        i = i + 1;
    }
    return m;
}

/// The largest of the first n reals.
pub fn sc_max_f(r: []const f64, n: u32) -> f64 {
    var m : f64 = 0.0;
    var i : u32 = 0;
    while (i < n) {
        m = fmax64(m, r[i as usize]);
        i = i + 1;
    }
    return m;
}

; --- the tests ----------------------------------------------------------------------------------


test the_units_the_devices_and_the_circuit_are_as_stated {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var cell : u32 = CELL;
    var vdd : u32 = VDD;
    var vcm : u32 = SC_VCM;
    var r : u32 = SC_R;
    var cstep : u32 = SC_CLK_STEP;
    var upv : f64 = SC_UPV;
    var vddf : f64 = VDD_F;
    var vthu : u32 = SC_VTH_U;
    var tmax : u32 = SC_TBL_MAX;
    var h2 : u32 = SC_H2;
    var h05 : u32 = SC_H05;
    var h0125 : u32 = SC_H0125;
    var h003 : u32 = SC_H003;
    // The M3a grid, read as 24 cells of 62.5 mV: Vdd = 1.5 V = 1.5 * 2^24 units, the common mode is half of it.
    assert_eq(vdd, 24 * cell);
    assert_eq(vddf, 1.5 * upv);
    assert_eq(vcm * 2, vdd);
    // The clock is a ramp of 16 steps of exactly Vdd / 16, and is at Vdd / 2 at step 8.
    assert_eq(cstep * r, vdd);
    assert_eq(sc_clk_at(0), 0);
    assert_eq(sc_clk_at(r >> 1), vcm);
    assert_eq(sc_clk_at(r), vdd);
    assert_eq(sc_clk_at(r + 50), vdd);
    // dt = 0.1 ps over the 0.125 fF charge unit is 800 V/A; 4, 4, 6, 2, 2, 4, 4, 2 fF.
    const dtc : f64 = (SC_DT_FS as f64) * 0.000000000000001 / ((SC_CUNIT_AF as f64) * 0.000000000000000001) - SC_STEP_V_PER_A;
    assert dtc * dtc < 0.000001 * 0.000001;
    var capsum : u32 = 0;
    var i : u32 = 0;
    while (i < SC_NN) {
        capsum = capsum + SC_CAP[i as usize];
        i = i + 1;
    }
    assert_eq(capsum, 224);
    // Variables, not constants: an assert on a constant table element is folded by the compiler and counts as no assert at all (#12166).
    var cap5 : u32 = SC_CAP[5];
    var cap6 : u32 = SC_CAP[6];
    assert_eq(cap5, 32);
    assert_eq(cap6, 32);
    // beta = KP W / L is 666.7 uA/V^2 per unit m for both types, which is why ONE table serves both transistors.
    const bn : f64 = SC_KP_N * SC_W_N / SC_L - SC_BETA;
    const bp : f64 = SC_KP_P * SC_W_P / SC_L - SC_BETA;
    assert bn * bn < 0.00000000000000001 * 0.00000000000000001;
    assert bp * bp < 0.00000000000000001 * 0.00000000000000001;
    // The threshold 0.35 V is 5.6 cells: inside cell 5, so the table has a soft knee (the next test measures it).
    const vthd : f64 = (vthu as f64) - SC_VTH_V * upv;
    assert vthd * vthd < 0.5 * 0.5;
    assert vthu > 5 * cell;
    assert vthu < 6 * cell;
    // The inputs are Vcm +- h; 2 h is the stated differential to within half a unit each side (59.6 nV).
    const d2 : f64 = 2.0 * (h2 as f64) / upv - 0.002;
    const d05 : f64 = 2.0 * (h05 as f64) / upv - 0.0005;
    const d0125 : f64 = 2.0 * (h0125 as f64) / upv - 0.000125;
    const d003 : f64 = 2.0 * (h003 as f64) / upv - 0.00003125;
    assert d2 * d2 < 0.0000001 * 0.0000001;
    assert d05 * d05 < 0.0000001 * 0.0000001;
    assert d0125 * d0125 < 0.0000001 * 0.0000001;
    assert d003 * d003 < 0.0000001 * 0.0000001;
    // The device table: fifteen devices, eight NMOS (kind 0) and seven PMOS, every terminal one of the 13 names.
    var ndev : u32 = SC_NDEV;
    var pmos : u32 = 0;
    var msum : u32 = 0;
    var ok : bool = true;
    var e : usize = 0;
    while (e < (ndev as usize)) {
        pmos = pmos + SC_DV_KIND[e];
        msum = msum + SC_DV_M[e];
        if (SC_DV_D[e] >= 13 or SC_DV_G[e] >= 13 or SC_DV_S[e] >= 13) { ok = false; }
        if (SC_DV_D[e] == SC_DV_S[e] or SC_DV_G[e] == SC_DV_D[e] or SC_DV_G[e] == SC_DV_S[e]) { ok = false; }
        if (SC_DV_D[e] >= SC_NN and SC_DV_S[e] >= SC_NN) { ok = false; }
        e = e + 1;
    }
    assert(ok);
    assert_eq(pmos, 7);
    assert_eq(msum, 266);
    // The input pair: XM3 (gate VDN) and XM4 (gate VDP), both m = 36, on ap and an, sharing net1 with the tail XM5 (m = 18).
    var dvg2 : u32 = SC_DV_G[2];
    var dvg3 : u32 = SC_DV_G[3];
    var dvm2 : u32 = SC_DV_M[2];
    var dvm3 : u32 = SC_DV_M[3];
    var dvs2 : u32 = SC_DV_S[2];
    var dvs3 : u32 = SC_DV_S[3];
    var dvd4 : u32 = SC_DV_D[4];
    assert_eq(dvg2, SC_T_VDN);
    assert_eq(dvg3, SC_T_VDP);
    assert_eq(dvm2, dvm3);
    assert_eq(dvs2, dvs3);
    assert_eq(dvs2, dvd4);
    // The cross-coupled NMOS pair XM10, XM11 (m = 12) and PMOS pair XM8, XM9 (m = 30): each output gates the other's pull-down.
    var dvg9 : u32 = SC_DV_G[9];
    var dvg10 : u32 = SC_DV_G[10];
    var dvd7 : u32 = SC_DV_D[7];
    var dvd8 : u32 = SC_DV_D[8];
    var dvd9 : u32 = SC_DV_D[9];
    var dvd10 : u32 = SC_DV_D[10];
    assert_eq(dvg9, dvd10);
    assert_eq(dvg10, dvd9);
    assert_eq(dvd7, dvd10);
    assert_eq(dvd8, dvd9);
    // The widest product of the interpolation: TBL_MAX * 2^40 and the rounding half fit in a u64 (the same rule as M3a).
    assert tmax < 8388608;
    assert (tmax as u64) * 1099511627776 + 549755813888 < 9223372036854775808;
}

test the_table_is_the_law_at_the_nodes_and_the_knee_sits_inside_a_cell {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    // At the 625 nodes the entry is the law to within half a unit (59.6 nV of node voltage, in the charge unit).
    assert sc_node_err(&t) <= 0.5 + 0.0000001;
    assert sc_node_err(&t) > 0.3;
    assert(monotone(&t));
    assert_eq(t[624], SC_TBL_MAX);
    assert_eq(t[0], 0);
    // Vgs on node 5 (0.3125 V) and below: no current. Vds = 0: no current.
    var ix : u32 = 0;
    var iy : u32 = 0;
    while (ix <= 5) {
        iy = 0;
        while (iy < NODES) {
            assert_eq(t[(ix * NODES + iy) as usize], 0);
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    ix = 0;
    while (ix < NODES) {
        assert_eq(t[(ix * NODES) as usize], 0);
        ix = ix + 1;
    }
    // Node 6 (0.375 V) has 25 mV of overdrive: T = beta ov^2 / 2 * 800 * 2^24 = 2796 units, flat in Vds from there on.
    assert_eq(t[(6 * NODES + 24) as usize], 2796);
    assert_eq(t[(6 * NODES + 2) as usize], t[(6 * NODES + 24) as usize]);
    // Saturation is flat in Vds: Vgs = 0.75 V has ov = 0.4 V, so Vds >= 0.4375 V (node 7) gives one value, node 6 less.
    assert_eq(t[(12 * NODES + 7) as usize], t[(12 * NODES + 24) as usize]);
    assert t[(12 * NODES + 6) as usize] < t[(12 * NODES + 7) as usize];
    // THE KNEE. The law is exactly 0 at Vgs = 0.33 V, a chord from node 5 (0) to node 6 (2796) is not: the table reads
    // 783 units there, about 28 % of the next node's value. The table's threshold is soft inside cell 5; it is the price of
    // reading M3a's 24-cell grid as 62.5 mV cells, and PSP103 tables (M3b) will have a subthreshold tail of their own.
    const leak : u32 = id_of(&t, 5536481, SC_VCM);
    assert_eq(leak, 783);
    assert leak > 0;
    assert sc_law_t(5536481.0, 12582912.0) == 0.0;
    // N and P read this one table: the unit device's law at the top node is beta (1.5 - 0.35)^2 / 2 = 0.44083 mA.
    const top : f64 = sc_law_t(VDD_F, VDD_F) / (SC_STEP_V_PER_A * SC_UPV) - 0.000440833333333;
    assert top * top < 0.000000001 * 0.000000001;
}

test a_device_conducts_from_its_high_end_to_its_low_end {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var v : [8]u32 = [0] ** 8;
    var reg : [144]u64 = [0] ** 144;
    // XM3 (index 2): NMOS, drain ap, gate VDN = 0.75 V, source net1, m = 36. Forward: ap at 1.0 V, net1 at 0.2 V.
    v[0] = 16777216;
    v[2] = 3355443;
    sc_stamp_dev(&t, 2, &v, 0, SC_VCM, SC_VCM, 36, &reg);
    const x : u32 = SC_VCM - 3355443;
    const y : u32 = 16777216 - 3355443;
    const cur : u64 = 36 * (id_of(&t, x, y) as u64);
    assert cur > 0;
    assert_eq(reg[(SC_RGP + 0) as usize], cur);
    assert_eq(reg[(SC_RGN + 2) as usize], cur);
    assert_eq(reg[(SC_RGP + 2) as usize], 0);
    assert_eq(reg[(SC_RGN + 0) as usize], 0);
    // The table's current against the law: m T(x, y), here 0.55 V of drive and 0.8 V across the channel.
    const law : f64 = 36.0 * sc_law_t((x as f64), (y as f64));
    const rel : f64 = ((cur as f64) - law) / law;
    assert rel * rel < 0.02 * 0.02;
    assert rel * rel > 0.01 * 0.01;
    // Reverse: net1 at 1.0 V, ap at 0.2 V. The channel is symmetric, so the same current now leaves net1 and enters ap.
    var w : [8]u32 = [0] ** 8;
    var reg2 : [144]u64 = [0] ** 144;
    w[0] = 3355443;
    w[2] = 16777216;
    sc_stamp_dev(&t, 2, &w, 0, SC_VCM, SC_VCM, 36, &reg2);
    assert_eq(reg2[(SC_RGP + 2) as usize], cur);
    assert_eq(reg2[(SC_RGN + 0) as usize], cur);
    assert_eq(reg2[(SC_RGP + 0) as usize], 0);
    assert_eq(reg2[(SC_RGN + 2) as usize], 0);
    // XM8 (index 7): PMOS, drain dp, gate an, source net3, m = 30; all three are internal nodes. Forward: net3 at 1.4 V.
    var p : [8]u32 = [0] ** 8;
    var reg3 : [144]u64 = [0] ** 144;
    p[4] = 23488102;
    p[5] = 5033165;
    p[1] = 6710886;
    sc_stamp_dev(&t, 7, &p, 0, SC_VCM, SC_VCM, 30, &reg3);
    const px : u32 = 23488102 - 6710886;
    const py : u32 = 23488102 - 5033165;
    const pcur : u64 = 30 * (id_of(&t, px, py) as u64);
    assert pcur > 0;
    assert_eq(reg3[(SC_RGP + 4) as usize], pcur);
    assert_eq(reg3[(SC_RGN + 5) as usize], pcur);
    // Reverse: dp at 1.4 V and net3 at 0.3 V, the gate unchanged: the same drive (1.4 - 0.4 V) and span, the roles exchanged.
    var q : [8]u32 = [0] ** 8;
    var reg4 : [144]u64 = [0] ** 144;
    q[5] = 23488102;
    q[4] = 5033165;
    q[1] = 6710886;
    sc_stamp_dev(&t, 7, &q, 0, SC_VCM, SC_VCM, 30, &reg4);
    assert_eq(reg4[(SC_RGP + 5) as usize], pcur);
    assert_eq(reg4[(SC_RGN + 4) as usize], pcur);
    // A common shift of all three terminals changes no current, so every row of the Jacobian sums to zero (all three are
    // internal here): row sums of (J+ - J-) over the eight columns.
    var row : u32 = 0;
    var worst : f64 = 0.0;
    while (row < SC_NN) {
        var sum : f64 = 0.0;
        var col : u32 = 0;
        while (col < SC_NN) {
            sum = sum + (reg3[(SC_RJP + row * SC_NN + col) as usize] as f64) - (reg3[(SC_RJN + row * SC_NN + col) as usize] as f64);
            sum = sum + (reg4[(SC_RJP + row * SC_NN + col) as usize] as f64) - (reg4[(SC_RJN + row * SC_NN + col) as usize] as f64);
            col = col + 1;
        }
        worst = fmax64(worst, fabs64(sum));
        row = row + 1;
    }
    assert worst < 0.5;
    // And the Jacobian of the PMOS is not empty: the gm entry (gate column an) of the high end's row is negative for a PMOS.
    assert reg3[(SC_RJN + 4 * SC_NN + 1) as usize] > 0;
    assert_eq(reg3[(SC_RJP + 4 * SC_NN + 1) as usize], 0);
}

test the_jacobian_is_the_derivative_of_the_residual {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var outa : [1128]f64 = [0.0] ** 1128;
    var resa : [140]f64 = [0.0] ** 140;
    var outt : [1128]f64 = [0.0] ** 1128;
    var rest : [140]f64 = [0.0] ** 140;
    sc_run_f(1, &t, SC_H2, false, SC_K_ANA, &SC_DV_M, &outa, &resa);
    sc_run_f(0, &t, SC_H2, false, SC_K, &SC_DV_M, &outt, &rest);
    var drv : [3]f64 = [0.0] ** 3;
    drv[1] = ((SC_VCM + SC_H2) as f64);
    drv[2] = ((SC_VCM - SC_H2) as f64);
    var steps : [7]u32 = [1, 12, 24, 40, 62, 70, 110];
    var v : [8]f64 = [0.0] ** 8;
    var v0 : [8]f64 = [0.0] ** 8;
    var worst_law : f64 = 0.0;
    var worst_tab : f64 = 0.0;
    var wrong : f64 = 0.0;
    var k : usize = 0;
    while (k < 7) {
        const j : u32 = steps[k];
        drv[0] = (sc_clk_at(j)) as f64;
        sc_state_f(&outa, j, &v);
        sc_state_f(&outa, j - 1, &v0);
        worst_law = fmax64(worst_law, sc_fd_err(1, &t, &v, &v0, &drv, &SC_DV_M, false));
        wrong = fmax64(wrong, sc_fd_err(1, &t, &v, &v0, &drv, &SC_DV_M, true));
        sc_state_f(&outt, j, &v);
        sc_state_f(&outt, j - 1, &v0);
        worst_tab = fmax64(worst_tab, sc_fd_err(0, &t, &v, &v0, &drv, &SC_DV_M, false));
        k = k + 1;
    }
    // The analytic law is C1, so a central difference of the residual (+-200 units, 12 uV) is its Jacobian to 1e-4 of a pure
    // number, entries being O(1) to O(50). What is left is the kink in the second derivative where a device sits exactly at
    // Vds = 0, as several do at rest (steps 1, 12, 24); from step 40 on the difference is below 1e-6.
    assert worst_law < 0.0002;
    assert worst_law > 0.00005;
    // The table's slopes ARE the derivative of its bilinear interpolant inside a cell; the same kinks (and the cell edges) leave 2e-5.
    assert worst_tab < 0.0001;
    assert worst_tab > 0.00001;
    // The check has teeth: the transposed Jacobian (a row and a column exchanged, the commonest stamping slip) is far off.
    assert wrong > 0.5;
}

test the_fixed_point_system_is_the_real_system_to_rounding {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const s : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    var steps : [5]u32 = [12, 40, 62, 70, 110];
    var v : [8]u32 = [0] ** 8;
    var v0 : [8]u32 = [0] ** 8;
    var wg : f64 = 0.0;
    var wj : f64 = 0.0;
    var k : usize = 0;
    while (k < 5) {
        const j : u32 = steps[k];
        sc_state_u(&out, j, &v);
        sc_state_u(&out, j - 1, &v0);
        wg = fmax64(wg, sc_gap_g(&t, &v, &v0, sc_clk_at(j), SC_VCM + SC_H2, SC_VCM - SC_H2, &SC_DV_M));
        wj = fmax64(wj, sc_gap_j(&t, &v, &v0, sc_clk_at(j), SC_VCM + SC_H2, SC_VCM - SC_H2, &SC_DV_M));
        k = k + 1;
    }
    // G: each device's current is read, rounded to a unit, and multiplied by m (at most 36): half of m per device, 266 / 2 in all.
    assert wg < 133.0;
    assert wg > 1.0;
    // J: each slope is read and rounded to 2^-20, times m (at most 36): well under 1e-4 of a pure number.
    assert wj < 0.0001;
    assert wj > 0.000001;
    assert_eq(s, 858149221550211914);
}

test the_gauss_solver_pivots_and_agrees_with_the_real_solver {
    // (a) A permutation system with signs: A has 1.0 (2^20) at (i, 7 - i), so every diagonal entry is zero and each column
    // needs a row swap. The solution is exact: x = (100, -200, 300, -400, 500, -600, 700, -800) units.
    var a : [72]u64 = [0] ** 72;
    var x : [8]u64 = [0] ** 8;
    var xt : [8]u64 = [0] ** 8;
    var i : u32 = 0;
    while (i < 8) {
        xt[i as usize] = sc_pack(((i + 1) * 100) as u64, (i % 2) == 1);
        i = i + 1;
    }
    i = 0;
    while (i < 8) {
        const cneg : bool = (i % 3) == 1;
        const j : u32 = 7 - i;
        a[(i * 9 + j) as usize] = sc_pack(CELL as u64, cneg);
        a[(i * 9 + 8) as usize] = sc_pack(sc_mag(xt[j as usize]), cneg != sc_neg(xt[j as usize]));
        i = i + 1;
    }
    sc_eliminate(&a);
    sc_backsub(&a, &x);
    i = 0;
    while (i < 8) {
        assert_eq(x[i as usize], xt[i as usize]);
        i = i + 1;
    }
    // (b) The real matrix of the run at step 60, from the previous state as the first guess: the full first Newton move.
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const s : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    var v0 : [8]u32 = [0] ** 8;
    sc_state_u(&out, 59, &v0);
    var reg : [144]u64 = [0] ** 144;
    sc_stamp(&t, &v0, &v0, sc_clk_at(60), SC_VCM + SC_H2, SC_VCM - SC_H2, &SC_DV_M, &reg);
    var b : [72]u64 = [0] ** 72;
    var y : [8]u64 = [0] ** 8;
    sc_load(&reg, &b);
    var af : [72]f64 = [0.0] ** 72;
    var yf : [8]f64 = [0.0] ** 8;
    i = 0;
    while (i < 72) {
        af[i as usize] = sc_word_f(b[i as usize]);
        if ((i % 9) < 8) { af[i as usize] = af[i as usize] / CELL_F; }
        i = i + 1;
    }
    sc_eliminate(&b);
    sc_backsub(&b, &y);
    sc_solve_f(&af, &yf);
    var worst : f64 = 0.0;
    var biggest : f64 = 0.0;
    i = 0;
    while (i < 8) {
        worst = fmax64(worst, fabs64(sc_word_f(y[i as usize]) - yf[i as usize]));
        biggest = fmax64(biggest, fabs64(yf[i as usize]));
        i = i + 1;
    }
    // The first move at step 60 is thousands of units; the fixed-point solve agrees with the real one to a few.
    assert biggest > 1000.0;
    assert worst < 4.0;
    assert worst > 0.1;
    assert_eq(s, 858149221550211914);
}

test the_circuit_rests_until_the_clock_moves {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var v : [8]u32 = [0] ** 8;
    var v0 : [8]u32 = [0] ** 8;
    const vdp : u32 = SC_VCM + SC_H2;
    const vdn : u32 = SC_VCM - SC_H2;
    sc_rest(vdp, vdn, &v);
    sc_rest(vdp, vdn, &v0);
    assert_eq(v[0], VDD);
    assert_eq(v[1], VDD);
    assert_eq(v[2], vdp - SC_VTH_U);
    assert_eq(v[3], VDD);
    assert_eq(v[4], VDD);
    assert_eq(v[5], 0);
    assert_eq(v[6], 0);
    assert_eq(v[7], VDD);
    // At the rest state with the clock low five nodes are in balance, exactly: net2, net3, dp, dn and n_clkc.
    var reg : [144]u64 = [0] ** 144;
    sc_stamp(&t, &v, &v0, 0, vdp, vdn, &SC_DV_M, &reg);
    assert_eq(reg[(SC_RGP + SC_NET2) as usize], reg[(SC_RGN + SC_NET2) as usize]);
    assert_eq(reg[(SC_RGP + SC_NET3) as usize], reg[(SC_RGN + SC_NET3) as usize]);
    assert_eq(reg[(SC_RGP + SC_DP) as usize], reg[(SC_RGN + SC_DP) as usize]);
    assert_eq(reg[(SC_RGP + SC_DN) as usize], reg[(SC_RGN + SC_DN) as usize]);
    assert_eq(reg[(SC_RGP + SC_NCLK) as usize], reg[(SC_RGN + SC_NCLK) as usize]);
    // Three are not: both input devices sit at the threshold 0.35 V, which is inside the table's cell 5, so their chords
    // conduct. The current leaves ap and an (G > 0: they sag a little under their precharge PMOS) and charges net1 (G < 0)
    // until net1 is a whole 0.3125 V under the higher input. The real circuit (the decks) rests at once; this is the knee.
    assert reg[(SC_RGP + SC_AP) as usize] > reg[(SC_RGN + SC_AP) as usize];
    assert reg[(SC_RGP + SC_AN) as usize] > reg[(SC_RGN + SC_AN) as usize];
    assert reg[(SC_RGN + SC_NET1) as usize] > reg[(SC_RGP + SC_NET1) as usize];
    var w : [8]u32 = [0] ** 8;
    var n : u32 = 0;
    while (n < SC_NN) {
        w[n as usize] = v[n as usize];
        n = n + 1;
    }
    const r : u32 = sc_step(&t, &w, 0, vdp, vdn, SC_K, &SC_DV_M);
    assert r <= SC_RES_BOUND;
    // One step at clock 0 (0.1 ps): the five balanced nodes do not move; ap and an sag by 91 and 96 uV, net1 rises by 145 uV.
    assert_eq(w[SC_NET2 as usize], v[SC_NET2 as usize]);
    assert_eq(w[SC_NET3 as usize], v[SC_NET3 as usize]);
    assert_eq(w[SC_DP as usize], v[SC_DP as usize]);
    assert_eq(w[SC_DN as usize], v[SC_DN as usize]);
    assert_eq(w[SC_NCLK as usize], v[SC_NCLK as usize]);
    assert_eq(v[0] - w[0], 1524);
    assert_eq(v[1] - w[1], 1610);
    assert_eq(w[2] - v[2], 2440);
}

test the_plus_2_mv_run_is_pinned {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const s : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    assert_eq(s, 858149221550211914);
    // VDP > VDN: dp wins. It is the first output through Vdd / 2, at 62.8876 steps (the clock is at 50 % at step 8, so
    // 54.8876 steps = 5.489 ps after the clock edge). The loser dn rises with it, crosses Vdd / 2 3.7 steps later and falls
    // back: ngspice's loser peaks 3 mV UNDER Vdd / 2 (0.7473 V), the table model's peak is a few mV over, so whether the loser
    // "crosses" is below the model's resolution and is not used; the winner's crossing and the final sign are.
    assert(sc_sign(&out));
    assert_eq(sc_t_first(&out), 257587);
    assert_eq(sc_t_node(&out, SC_DP), 257587);
    assert_eq(sc_t_node(&out, SC_DN), 272643);
    // |dp - dn| reaches Vdd / 2 at 77.6312 steps: 69.6312 steps = 6.963 ps after the clock edge.
    assert_eq(sc_t_res(&out), 317977);
    const tf : f64 = ((sc_after_clock(sc_t_first(&out))) as f64) / 4096.0;
    const tr : f64 = ((sc_after_clock(sc_t_res(&out))) as f64) / 4096.0;
    assert tf > 54.887;
    assert tf < 54.888;
    assert tr > 69.631;
    assert tr < 69.632;
    // At step 140 the latch has settled: dp within 10 units of Vdd, dn at 47375 units = 2.8 mV.
    assert_eq(out[(140 * 8 + 5) as usize], 25165814);
    assert_eq(out[(140 * 8 + 6) as usize], 47375);
    // The loser's peak, in units: ngspice 0.747264 V (the decks' dnmax).
    assert_eq(sc_peak(&out, SC_DN), 12632942);
    // The shape of the evaluation: the precharged nodes ap and an and the inverted clock only fall.
    assert(sc_never_rises(&out, SC_AP));
    assert(sc_never_rises(&out, SC_AN));
    assert(sc_never_rises(&out, SC_NCLK));
}

test all_four_stimuli_decide_the_right_way_and_the_halves_mirror {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var a : [1128]u32 = [0] ** 1128;
    var b : [1128]u32 = [0] ** 1128;
    var c : [1128]u32 = [0] ** 1128;
    var d : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const sa : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &a, &res);
    const sb : u64 = sc_run(&t, SC_H2, true, SC_K, &SC_DV_M, &b, &res);
    const sc : u64 = sc_run(&t, SC_H05, false, SC_K, &SC_DV_M, &c, &res);
    const sd : u64 = sc_run(&t, SC_H05, true, SC_K, &SC_DV_M, &d, &res);
    // +2 mV and +0.5 mV decide "VDP > VDN" (dp high); -2 mV and -0.5 mV decide it the other way.
    assert(sc_sign(&a));
    assert(!sc_sign(&b));
    assert(sc_sign(&c));
    assert(!sc_sign(&d));
    // The first output to cross is the winner: dp for the positive inputs, dn for the negative ones, at the same time.
    assert_eq(sc_t_node(&a, SC_DP), sc_t_node(&b, SC_DN));
    assert_eq(sc_t_node(&c, SC_DP), sc_t_node(&d, SC_DN));
    assert_eq(sc_t_first(&a), sc_t_first(&b));
    assert_eq(sc_t_first(&c), 260428);
    assert_eq(sc_t_first(&d), sc_t_first(&c));
    assert_eq(sc_t_res(&a), sc_t_res(&b));
    assert_eq(sc_t_res(&c), 349568);
    assert_eq(sc_t_res(&d), sc_t_res(&c));
    // At 0.5 mV the loser (ngspice: peak 0.822 V) also gets through Vdd / 2, after the winner.
    assert sc_t_node(&c, SC_DN) != SC_NONE;
    assert sc_t_node(&c, SC_DN) > sc_t_node(&c, SC_DP);
    // The slower decision at the smaller input: first output (commonly driven) 0.69 steps later, resolution 7.71 steps later.
    assert sc_t_first(&c) > sc_t_first(&a);
    assert sc_t_res(&c) - sc_t_res(&a) > 31000;
    assert sc_t_res(&c) - sc_t_res(&a) < 32000;
    assert_eq(sa, 858149221550211914);
    assert_eq(sb, 7832980476838438025);
    assert_eq(sc, 7639752914144809206);
    assert_eq(sd, 42403085586441860);
    // The comparator is its own mirror. In real arithmetic the exchanged run is the mirrored run (see the f64 test); in
    // fixed point the two halves round differently (the pivot order differs), by at most 2 units at 2 mV and 61 at 0.5 mV,
    // which regeneration has amplified from one.
    assert_eq(sc_mirror_dev_u(&a, &b), 2);
    assert_eq(sc_mirror_dev_u(&c, &d), 61);
}

test the_residual_is_bounded_at_every_step {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var hs : [6]u32 = [SC_H2, SC_H05, SC_H0125, SC_H003, SC_H2, SC_H05];
    var n : u32 = 0;
    var worst : u32 = 0;
    var twos : u32 = 0;
    while (n < 6) {
        const s : u64 = sc_run(&t, hs[n as usize], n >= 4, SC_K, &SC_DV_M, &out, &res);
        var j : u32 = 0;
        while (j < SC_N) {
            assert res[j as usize] <= SC_RES_BOUND;
            j = j + 1;
        }
        if (sc_max_u(&res, 140) > worst) { worst = sc_max_u(&res, 140); }
        twos = twos + sc_count_eq(&res, 140, 2);
        n = n + 1;
    }
    // From both sides, over six runs of 140 steps (2 mV, 0.5 mV, 0.125 mV, 31 uV, and the two mirrored): the worst residual is
    // exactly 2 units, so the bound is tight; it is the rounding of the table reads times m, over the node's own slope, and it
    // is reached at 31 of the 840 steps and exceeded at none.
    assert_eq(worst, 2);
    assert_eq(twos, 31);
    // The real twin converges further: after K = 3 real Newton iterations the residual is 1.5e-4 of a unit at 2 mV and 4.6e-5
    // at 0.5 mV (bound 2e-4, from both sides).
    var outf : [1128]f64 = [0.0] ** 1128;
    var resf : [140]f64 = [0.0] ** 140;
    sc_run_f(0, &t, SC_H2, false, SC_K, &SC_DV_M, &outf, &resf);
    const r2 : f64 = sc_max_f(&resf, 140);
    sc_run_f(0, &t, SC_H05, false, SC_K, &SC_DV_M, &outf, &resf);
    const r05 : f64 = sc_max_f(&resf, 140);
    assert r2 < 0.0002;
    assert r2 > 0.0001;
    assert r05 < 0.00005;
    assert r05 > 0.00004;
}

test k1_and_k2_are_the_negative_controls_they_break_the_residual_bound {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var out1 : [1128]u32 = [0] ** 1128;
    var res1 : [140]u32 = [0] ** 140;
    var out2 : [1128]u32 = [0] ** 1128;
    var res2 : [140]u32 = [0] ** 140;
    const s3 : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    const s1 : u64 = sc_run(&t, SC_H2, false, 1, &SC_DV_M, &out1, &res1);
    const s2 : u64 = sc_run(&t, SC_H2, false, 2, &SC_DV_M, &out2, &res2);
    // One Newton iteration leaves 29361 units (1.75 mV) at the worst step, 14680 times the bound.
    assert sc_max_u(&res1, 140) > SC_RES_BOUND;
    assert_eq(sc_max_u(&res1, 140), 29361);
    // Two leave 55 units (3.3 uV), 27 times the bound; three leave 2.
    assert sc_max_u(&res2, 140) > SC_RES_BOUND;
    assert_eq(sc_max_u(&res2, 140), 55);
    assert_eq(sc_max_u(&res, 140), 2);
    assert s1 != s3;
    assert s2 != s3;
    // K = 1 also moves the decision: the first output 88 counts of 1/4096 step late (0.021 steps), the resolution 870 counts (0.21 steps).
    // K = 2 does not move it at this resolution: the bound is about the solve, not about the answer.
    assert_eq(sc_t_first(&out1), 257675);
    assert_eq(sc_t_res(&out1), 318847);
    assert_eq(sc_t_first(&out2), sc_t_first(&out));
    assert_eq(sc_t_res(&out2), sc_t_res(&out));
    // And K = 3 is enough: a fourth iteration buys nothing. Its worst residual is also 2 units and its times are the same.
    var out4 : [1128]u32 = [0] ** 1128;
    var res4 : [140]u32 = [0] ** 140;
    const s4 : u64 = sc_run(&t, SC_H2, false, 4, &SC_DV_M, &out4, &res4);
    assert_eq(sc_max_u(&res4, 140), 2);
    assert_eq(sc_t_first(&out4), sc_t_first(&out));
    assert_eq(sc_t_res(&out4), sc_t_res(&out));
    assert s4 != 0;
}

test the_arithmetic_error_against_the_real_twin {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var outf : [1128]f64 = [0.0] ** 1128;
    var resf : [140]f64 = [0.0] ** 140;
    const s2 : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    sc_run_f(0, &t, SC_H2, false, SC_K, &SC_DV_M, &outf, &resf);
    // The fixed-point run against the real run of the SAME iteration (the same table words, K = 3, the same clamps), the largest
    // |difference| over the eight nodes and 141 states, in units of 59.6 nV: 68.05 at 2 mV (bound 70, from both sides).
    const a2 : f64 = sc_dev_fix_f(&out, &outf);
    assert a2 < 70.0;
    assert a2 > 66.0;
    // Until step 50 it is under 3 units (0.2 uV): the arithmetic itself is tight. The regeneration then amplifies it, e-fold per
    // 5.3 steps, to the 68 above. (2.915 at 2 mV, bound 3.)
    const p2 : f64 = sc_dev_prefix(&out, &outf, 50);
    assert p2 < 3.0;
    assert p2 > 2.8;
    const f2 : f64 = (sc_after_clock(sc_t_first(&out)) as f64) / 4096.0 - sc_t_first_f(&outf);
    const r2 : f64 = (sc_after_clock(sc_t_res(&out)) as f64) / 4096.0 - sc_t_res_f(&outf);
    // The decision times differ by under 2.5e-4 steps, which is the 1/4096 step the fixed-point time is truncated to.
    assert f2 * f2 < 0.00025 * 0.00025;
    assert r2 * r2 < 0.00025 * 0.00025;
    const s05 : u64 = sc_run(&t, SC_H05, false, SC_K, &SC_DV_M, &out, &res);
    sc_run_f(0, &t, SC_H05, false, SC_K, &SC_DV_M, &outf, &resf);
    // At 0.5 mV the decision takes longer, so the amplification has longer to act: 250.8 units (15 uV; bound 255, from both sides).
    const a05 : f64 = sc_dev_fix_f(&out, &outf);
    assert a05 < 255.0;
    assert a05 > 245.0;
    const p05 : f64 = sc_dev_prefix(&out, &outf, 50);
    assert p05 < 3.4;
    assert p05 > 3.2;
    const f05 : f64 = (sc_after_clock(sc_t_first(&out)) as f64) / 4096.0 - sc_t_first_f(&outf);
    const r05 : f64 = (sc_after_clock(sc_t_res(&out)) as f64) / 4096.0 - sc_t_res_f(&outf);
    assert f05 * f05 < 0.00025 * 0.00025;
    assert r05 * r05 < 0.00035 * 0.00035;
    assert r05 * r05 > 0.0003 * 0.0003;
    assert_eq(s2, 858149221550211914);
    assert_eq(s05, 7639752914144809206);
}

test the_table_error_against_the_analytic_law {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var tab : [1128]f64 = [0.0] ** 1128;
    var law : [1128]f64 = [0.0] ** 1128;
    var res : [140]f64 = [0.0] ** 140;
    sc_run_f(0, &t, SC_H2, false, SC_K, &SC_DV_M, &tab, &res);
    sc_run_f(1, &t, SC_H2, false, SC_K_ANA, &SC_DV_M, &law, &res);
    // The real table run against the analytic square law solved to convergence (12 Newton iterations a step) on the same
    // backward Euler grid: the largest |difference| of any node at any step, in volts. This is the table's error, the 62.5 mV
    // cells and the knee, and it is the largest error here: 15.2 mV at 2 mV (bound 15.4 mV, from both sides).
    const e2 : f64 = sc_dev_f_f(&tab, &law) / SC_UPV;
    assert e2 < 0.0154;
    assert e2 > 0.0150;
    const f2 : f64 = sc_t_first_f(&tab) - sc_t_first_f(&law);
    const r2 : f64 = sc_t_res_f(&tab) - sc_t_res_f(&law);
    sc_run_f(0, &t, SC_H05, false, SC_K, &SC_DV_M, &tab, &res);
    sc_run_f(1, &t, SC_H05, false, SC_K_ANA, &SC_DV_M, &law, &res);
    const e05 : f64 = sc_dev_f_f(&tab, &law) / SC_UPV;
    // 19.0 mV at 0.5 mV (bound 19.2 mV).
    assert e05 < 0.0192;
    assert e05 > 0.0188;
    const f05 : f64 = sc_t_first_f(&tab) - sc_t_first_f(&law);
    const r05 : f64 = sc_t_res_f(&tab) - sc_t_res_f(&law);
    // In time the table is 0.075 and 0.112 steps early to the first output, 0.323 and 0.406 steps late to the resolution
    // (0.14 %, 0.20 %, 0.47 %, 0.53 %): the first output is the common-mode rise, the resolution is the regeneration, which
    // the table's slopes (piecewise constant over a cell) slow a little.
    assert f2 < 0.0 - 0.07;
    assert f2 > 0.0 - 0.08;
    assert f05 < 0.0 - 0.11;
    assert f05 > 0.0 - 0.12;
    assert r2 > 0.32;
    assert r2 < 0.33;
    assert r05 > 0.40;
    assert r05 < 0.41;
}

test the_analytic_run_is_the_ngspice_deck {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var law : [1128]f64 = [0.0] ** 1128;
    var law20 : [1128]f64 = [0.0] ** 1128;
    var res : [140]f64 = [0.0] ** 140;
    sc_run_f(1, &t, SC_H2, false, SC_K_ANA, &SC_DV_M, &law, &res);
    sc_run_f(1, &t, SC_H2, false, 20, &SC_DV_M, &law20, &res);
    // Newton is converged: 12 iterations and 20 give the same run to a millionth of a unit.
    assert sc_dev_f_f(&law, &law20) < 0.000001;
    // The analytic square law, backward Euler on the grid, K = 12, against ngspice MOSFET LEVEL=1 on the same grid: the largest
    // |difference| at the eight nodes and eight recorded steps, in volts. It is 1.44e-9 V at 2 mV (bound 1.6e-9, from both
    // sides): the deck IS the spec's circuit, device for device and farad for farad. Wrong by a device, a node cap or a
    // wire, it would be millivolts.
    const e2 : f64 = sc_dev_ng_f(&law, &SC_NG_P2);
    assert e2 < 0.0000000016;
    assert e2 > 0.0000000013;
    const d1 : f64 = sc_t_first_f(&law) - SC_NG_FIRST_2;
    const d2 : f64 = sc_t_res_f(&law) - SC_NG_RES_2;
    assert d1 * d1 < 0.00005 * 0.00005;
    assert d2 * d2 < 0.00005 * 0.00005;
    // The loser's peak: ngspice 0.747264 V (printed to 6 digits).
    const pk : f64 = sc_peak_f(&law, SC_DN) / SC_UPV - SC_NG_PEAK_2;
    assert pk * pk < 0.000001 * 0.000001;
    sc_run_f(1, &t, SC_H05, false, SC_K_ANA, &SC_DV_M, &law, &res);
    const e05 : f64 = sc_dev_ng_f(&law, &SC_NG_P05);
    assert e05 < 0.0000000015;
    assert e05 > 0.0000000012;
    const d3 : f64 = sc_t_first_f(&law) - SC_NG_FIRST_05;
    const d4 : f64 = sc_t_res_f(&law) - SC_NG_RES_05;
    assert d3 * d3 < 0.00005 * 0.00005;
    assert d4 * d4 < 0.00005 * 0.00005;
    // The four time differences are the 6 printed digits of the .meas lines (a step is 0.1 ps, 7 digits of ps).
    assert d1 * d1 > 0.00001 * 0.00001;
    const pk05 : f64 = sc_peak_f(&law, SC_DN) / SC_UPV - SC_NG_PEAK_05;
    assert pk05 * pk05 < 0.000001 * 0.000001;
}

test the_fixed_point_run_against_ngspice {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var a : [1128]u32 = [0] ** 1128;
    var b : [1128]u32 = [0] ** 1128;
    var c : [1128]u32 = [0] ** 1128;
    var d : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const sa : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &a, &res);
    const sb : u64 = sc_run(&t, SC_H2, true, SC_K, &SC_DV_M, &b, &res);
    const sc : u64 = sc_run(&t, SC_H05, false, SC_K, &SC_DV_M, &c, &res);
    const sd : u64 = sc_run(&t, SC_H05, true, SC_K, &SC_DV_M, &d, &res);
    // THE DECISION. ngspice LEVEL=1 resolves +2 mV and +0.5 mV with dp high and -2 mV and -0.5 mV with dn high (the decks'
    // dpend and dnend); so does the fixed-point run.
    assert(sc_sign(&a));
    assert(!sc_sign(&b));
    assert(sc_sign(&c));
    assert(!sc_sign(&d));
    // THE DECISION TIME: the first output through Vdd / 2, in steps after the clock's 50 % point, against the decks' tfirst - tck.
    const fa : f64 = (sc_after_clock(sc_t_first(&a)) as f64) / 4096.0;
    const fb : f64 = (sc_after_clock(sc_t_first(&b)) as f64) / 4096.0;
    const fc : f64 = (sc_after_clock(sc_t_first(&c)) as f64) / 4096.0;
    const fd : f64 = (sc_after_clock(sc_t_first(&d)) as f64) / 4096.0;
    const ra : f64 = (fa - SC_NG_FIRST_2) / SC_NG_FIRST_2;
    const rb : f64 = (fb - SC_NG_FIRST_2) / SC_NG_FIRST_2;
    const rc : f64 = (fc - SC_NG_FIRST_05) / SC_NG_FIRST_05;
    const rd : f64 = (fd - SC_NG_FIRST_05) / SC_NG_FIRST_05;
    // 5.489 ps against 5.496 ps at 2 mV (-0.14 %), 5.558 ps against 5.569 ps at 0.5 mV (-0.20 %): within 0.25 %, from both sides.
    assert ra * ra < 0.0025 * 0.0025;
    assert rb * rb < 0.0025 * 0.0025;
    assert rc * rc < 0.0025 * 0.0025;
    assert rd * rd < 0.0025 * 0.0025;
    assert rc * rc > 0.0018 * 0.0018;
    assert ra * ra > 0.0012 * 0.0012;
    // THE RESOLUTION TIME: |dp - dn| through Vdd / 2 against the decks' tres - tck. 6.963 ps against 6.931 ps (+0.47 %) and
    // 7.734 ps against 7.694 ps (+0.53 %): within 0.6 %, from both sides.
    const ga : f64 = (sc_after_clock(sc_t_res(&a)) as f64) / 4096.0;
    const gb : f64 = (sc_after_clock(sc_t_res(&b)) as f64) / 4096.0;
    const gc : f64 = (sc_after_clock(sc_t_res(&c)) as f64) / 4096.0;
    const gd : f64 = (sc_after_clock(sc_t_res(&d)) as f64) / 4096.0;
    const qa : f64 = (ga - SC_NG_RES_2) / SC_NG_RES_2;
    const qb : f64 = (gb - SC_NG_RES_2) / SC_NG_RES_2;
    const qc : f64 = (gc - SC_NG_RES_05) / SC_NG_RES_05;
    const qd : f64 = (gd - SC_NG_RES_05) / SC_NG_RES_05;
    assert qa * qa < 0.006 * 0.006;
    assert qb * qb < 0.006 * 0.006;
    assert qc * qc < 0.006 * 0.006;
    assert qd * qd < 0.006 * 0.006;
    assert qc * qc > 0.005 * 0.005;
    assert qa * qa > 0.004 * 0.004;
    // The issue's 5 % is met by a factor 9 at the worst of the four.
    assert qc * qc < 0.05 * 0.05 / 81.0;
    // THE NODES: the fixed-point states against the 8 x 8 recorded ngspice values, the largest |difference| in volts. This is
    // the table's error (15 mV) seen at the checkpoints: 14.66 mV at 2 mV (bound 14.8 mV), 15.40 mV at 0.5 mV (bound 15.6 mV).
    const n2 : f64 = sc_dev_ng_u(&a, &SC_NG_P2);
    const n05 : f64 = sc_dev_ng_u(&c, &SC_NG_P05);
    assert n2 < 0.0148;
    assert n2 > 0.0145;
    assert n05 < 0.0156;
    assert n05 > 0.0152;
    // THE REAL TWIN (f64, the same iteration, no rounding) against ngspice: the model's own error with the arithmetic taken out.
    // 14.67 mV and 15.42 mV at the recorded steps; -0.137 % and +0.466 % in the two times at 2 mV, -0.202 % and +0.527 % at 0.5 mV.
    var tw : [1128]f64 = [0.0] ** 1128;
    var rs : [140]f64 = [0.0] ** 140;
    sc_run_f(0, &t, SC_H2, false, SC_K, &SC_DV_M, &tw, &rs);
    const w2 : f64 = sc_dev_ng_f(&tw, &SC_NG_P2);
    const wf2 : f64 = (sc_t_first_f(&tw) - SC_NG_FIRST_2) / SC_NG_FIRST_2;
    const wr2 : f64 = (sc_t_res_f(&tw) - SC_NG_RES_2) / SC_NG_RES_2;
    assert w2 < 0.0148;
    assert w2 > 0.0145;
    assert wf2 < 0.0 - 0.0013;
    assert wf2 > 0.0 - 0.0014;
    assert wr2 > 0.0046;
    assert wr2 < 0.0047;
    sc_run_f(0, &t, SC_H05, false, SC_K, &SC_DV_M, &tw, &rs);
    const w05 : f64 = sc_dev_ng_f(&tw, &SC_NG_P05);
    const wf05 : f64 = (sc_t_first_f(&tw) - SC_NG_FIRST_05) / SC_NG_FIRST_05;
    const wr05 : f64 = (sc_t_res_f(&tw) - SC_NG_RES_05) / SC_NG_RES_05;
    assert w05 < 0.0156;
    assert w05 > 0.0152;
    assert wf05 < 0.0 - 0.0020;
    assert wf05 > 0.0 - 0.0021;
    assert wr05 > 0.0052;
    assert wr05 < 0.0053;
    // THE LOSER'S PEAK: 0.7530 V against ngspice's 0.7473 V at 2 mV (+5.7 mV), and ngspice's loser at 0.5 mV peaks at 0.822 V.
    const k2 : f64 = (sc_peak(&a, SC_DN) as f64) / SC_UPV - SC_NG_PEAK_2;
    assert k2 > 0.005;
    assert k2 < 0.006;
    const k05 : f64 = (sc_peak(&c, SC_DN) as f64) / SC_UPV - SC_NG_PEAK_05;
    assert k05 * k05 < 0.01 * 0.01;
    assert_eq(sa, 858149221550211914);
    assert_eq(sb, 7832980476838438025);
    assert_eq(sc, 7639752914144809206);
    assert_eq(sd, 42403085586441860);
}

test swapped_inputs_and_a_mismatched_pair_are_the_negative_controls {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var mm : [15]u32 = [0] ** 15;
    // The right answer for a positive input (VDP > VDN) is dp high. The nominal circuit gives it for 2 mV and 0.5 mV.
    const s0 : u64 = sc_run(&t, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    assert(sc_sign(&out));
    const s1 : u64 = sc_run(&t, SC_H05, false, SC_K, &SC_DV_M, &out, &res);
    assert(sc_sign(&out));
    // CONTROL 1, the inputs wired the wrong way round (the stimulus +2 mV with VDP and VDN exchanged): dn goes high, the
    // check "dp high for VDP > VDN" fails, at both sizes.
    const s2 : u64 = sc_run(&t, SC_H2, true, SC_K, &SC_DV_M, &out, &res);
    assert(!sc_sign(&out));
    const s3 : u64 = sc_run(&t, SC_H05, true, SC_K, &SC_DV_M, &out, &res);
    assert(!sc_sign(&out));
    // The pair of equal m = 36 gives the nominal run, bit for bit, through the same table of multipliers.
    sc_mult_pair(36, 36, &mm);
    const s4 : u64 = sc_run(&t, SC_H2, false, SC_K, &mm, &out, &res);
    assert_eq(s4, s0);
    // CONTROL 2, the pair's m swapped when they differ: m3 = 38, m4 = 34 against m3 = 34, m4 = 38. The decision follows the
    // mismatch, not the input: (38, 34) gives dn high for every stimulus, (34, 38) dp high for every stimulus, and the two are
    // opposite for all four stimuli (+-2 mV, +-0.5 mV). A 5.6 % mismatch (35, 37) already outweighs 2 mV.
    var hs : [4]u32 = [SC_H2, SC_H2, SC_H05, SC_H05];
    var k : u32 = 0;
    while (k < 4) {
        sc_mult_pair(38, 34, &mm);
        const sx : u64 = sc_run(&t, hs[k as usize], (k % 2) == 1, SC_K, &mm, &out, &res);
        const hi_lo : bool = sc_sign(&out);
        sc_mult_pair(34, 38, &mm);
        const sy : u64 = sc_run(&t, hs[k as usize], (k % 2) == 1, SC_K, &mm, &out, &res);
        const lo_hi : bool = sc_sign(&out);
        assert(!hi_lo);
        assert(lo_hi);
        k = k + 1;
    }
    sc_mult_pair(35, 37, &mm);
    const s5 : u64 = sc_run(&t, SC_H2, true, SC_K, &mm, &out, &res);
    assert(sc_sign(&out));
    assert s5 != s0;
    assert s2 != s0;
    assert s3 != s1;
}

test a_wrong_threshold_table_is_caught {
    var good : [625]u32 = [0] ** 625;
    var bad : [625]u32 = [0] ** 625;
    sc_build_table(&good, SC_VTH_V);
    sc_build_table(&bad, SC_VTH_WRONG_V);
    // The law check: the right table is within half a unit of the law, the wrong one (Vth = 0.30 V) is 525686 units off at a node.
    assert sc_node_err(&good) <= 0.5 + 0.0000001;
    assert sc_node_err(&bad) > 525000.0;
    assert sc_node_err(&bad) < 526000.0;
    // In the circuit: the run on the wrong table still decides the right way (the sign alone would not catch it) ...
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const s : u64 = sc_run(&bad, SC_H2, false, SC_K, &SC_DV_M, &out, &res);
    assert(sc_sign(&out));
    // ... but the decision time is 16.7 % early against ngspice (bound 5 %), the resolution 13.7 % early, and the states are
    // 0.39 V off at the recorded steps (bound 15 mV).
    const f : f64 = (sc_after_clock(sc_t_first(&out)) as f64) / 4096.0;
    const r : f64 = (sc_after_clock(sc_t_res(&out)) as f64) / 4096.0;
    const rf : f64 = (f - SC_NG_FIRST_2) / SC_NG_FIRST_2;
    const rr : f64 = (r - SC_NG_RES_2) / SC_NG_RES_2;
    assert rf * rf > 0.05 * 0.05;
    assert rr * rr > 0.05 * 0.05;
    assert rf < 0.0 - 0.16;
    assert rf > 0.0 - 0.17;
    assert rr < 0.0 - 0.13;
    assert rr > 0.0 - 0.14;
    const n : f64 = sc_dev_ng_u(&out, &SC_NG_P2);
    assert n > 0.39;
    assert n < 0.40;
    assert n > 20.0 * 0.0148;
    assert s != 858149221550211914;
}

test metastability_is_reported_not_hidden {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    // The input quartered three times, 2 mV down to 31 uV: every one is decided the right way within 140 steps, and the
    // resolution time grows by the same 7.67 steps (0.77 ps) at every quartering, the logarithm of the input.
    var hs : [4]u32 = [SC_H2, SC_H05, SC_H0125, SC_H003];
    var prev : u32 = 0;
    var k : u32 = 0;
    while (k < 4) {
        const s : u64 = sc_run(&t, hs[k as usize], false, SC_K, &SC_DV_M, &out, &res);
        assert(sc_sign(&out));
        assert sc_max_u(&res, 140) <= SC_RES_BOUND;
        const tr : u32 = sc_t_res(&out);
        assert tr != SC_NONE;
        if (k > 0) {
            assert tr - prev > 31300;
            assert tr - prev < 31700;
        }
        prev = tr;
        k = k + 1;
    }
    assert_eq(prev, 412373);
    // So one e-fold of the input costs 7.67 / ln 4 = 5.53 steps = 0.553 ps: the regeneration time constant.
    const tau : f64 = (((prev - 317977) as f64) / 4096.0) / 3.0 / 1.3862943611198906;
    assert tau > 5.5;
    assert tau < 5.6;
    // At 0 V of input the SAME circuit does not decide. In real arithmetic it stays exactly symmetric: dp = dn at every step
    // to a millionth of a unit, and |dp - dn| never reaches Vdd / 2.
    var outf : [1128]f64 = [0.0] ** 1128;
    var resf : [140]f64 = [0.0] ** 140;
    sc_run_f(0, &t, 0, false, SC_K, &SC_DV_M, &outf, &resf);
    var j : u32 = 0;
    while (j <= SC_N) {
        const d : f64 = fabs64(outf[(j * SC_NN + SC_DP) as usize] - outf[(j * SC_NN + SC_DN) as usize]);
        assert d < 0.000001;
        j = j + 1;
    }
    // In fixed point the same run is NOT symmetric to the last unit: one unit of rounding at step 60 (|dp - dn| = 1) grows,
    // 2027 units at step 100 and 2659643 at step 140 (0.158 V), still short of Vdd / 2: unresolved, the side it leans to
    // set by rounding, not by an input. This is the metastable state, reported as it is.
    const s0 : u64 = sc_run(&t, 0, false, SC_K, &SC_DV_M, &out, &res);
    assert_eq(sc_t_res(&out), SC_NONE);
    assert_eq(mag_diff(out[(60 * 8 + 5) as usize], out[(60 * 8 + 6) as usize]), 1);
    assert_eq(mag_diff(out[(100 * 8 + 5) as usize], out[(100 * 8 + 6) as usize]), 2027);
    assert_eq(mag_diff(out[(140 * 8 + 5) as usize], out[(140 * 8 + 6) as usize]), 2659643);
    assert mag_diff(out[(140 * 8 + 5) as usize], out[(140 * 8 + 6) as usize]) < (VDD >> 1);
}

test the_halves_mirror_exactly_in_real_arithmetic {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var a : [1128]f64 = [0.0] ** 1128;
    var b : [1128]f64 = [0.0] ** 1128;
    var res : [140]f64 = [0.0] ** 140;
    // Exchanging VDP and VDN gives the run with every node replaced by its mirror (ap <-> an, net2 <-> net3, dp <-> dn): to the
    // last bit in real arithmetic, for the table and for the law. A device on the wrong side, or a gate on the wrong net, breaks it.
    sc_run_f(0, &t, SC_H2, false, SC_K, &SC_DV_M, &a, &res);
    sc_run_f(0, &t, SC_H2, true, SC_K, &SC_DV_M, &b, &res);
    assert sc_mirror_dev_f(&a, &b) < 0.000000001;
    sc_run_f(1, &t, SC_H05, false, SC_K_ANA, &SC_DV_M, &a, &res);
    sc_run_f(1, &t, SC_H05, true, SC_K_ANA, &SC_DV_M, &b, &res);
    assert sc_mirror_dev_f(&a, &b) < 0.000000001;
    // And the check can fail: a run with the input pair's m unequal is not its own mirror.
    var mm : [15]u32 = [0] ** 15;
    sc_mult_pair(38, 34, &mm);
    sc_run_f(0, &t, SC_H2, false, SC_K, &mm, &a, &res);
    sc_run_f(0, &t, SC_H2, true, SC_K, &mm, &b, &res);
    assert sc_mirror_dev_f(&a, &b) > 1000000.0;
}

test the_board_step_is_the_k3_step_and_the_words_have_headroom {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    // The step a board would run (a static trip count) is sc_step at K = 3, state for state and residual for residual.
    var v : [8]u32 = [0] ** 8;
    var w : [8]u32 = [0] ** 8;
    sc_rest(SC_VCM + SC_H2, SC_VCM - SC_H2, &v);
    sc_rest(SC_VCM + SC_H2, SC_VCM - SC_H2, &w);
    var j : u32 = 1;
    while (j <= 80) {
        const ra : u32 = sc_step(&t, &v, j, SC_VCM + SC_H2, SC_VCM - SC_H2, SC_K, &SC_DV_M);
        const rb : u32 = sc_board_step(&t, &w, j, SC_VCM + SC_H2, SC_VCM - SC_H2, &SC_DV_M);
        assert_eq(ra, rb);
        var n : u32 = 0;
        while (n < SC_NN) {
            assert_eq(v[n as usize], w[n as usize]);
            n = n + 1;
        }
        j = j + 1;
    }
    // HEADROOM. Every register, matrix word and move of the solve, and the widest sum back substitution can form (8 |a| |x|
    // + |b| 2^20), over the whole run at 2 mV, 0.5 mV and 0 V: the widest is 4.95e14, under 2^49. A u64 holds 2^63: a factor
    // of more than 10^4 to spare, and the test asks for 2^62.
    const w2 : u64 = sc_headroom(&t, SC_H2, false, SC_K, &SC_DV_M);
    const w05 : u64 = sc_headroom(&t, SC_H05, false, SC_K, &SC_DV_M);
    const w0 : u64 = sc_headroom(&t, 0, false, SC_K, &SC_DV_M);
    var wide : u64 = w2;
    if (w05 > wide) { wide = w05; }
    if (w0 > wide) { wide = w0; }
    assert wide < 4611686018427387904;
    assert wide < 562949953421312;
    assert wide > 281474976710656;
    assert_eq(wide, 495357036992680);
}
