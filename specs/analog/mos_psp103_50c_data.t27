; --- the accessors and the tests ------------------------------------------------------------------------

/// The largest of the 25 entries at Vds = 0 (the first row of a gate column is index ix * 25).
pub fn at_vds0(t: []const u32) -> u32 {
    var worst : u32 = 0;
    var ix : usize = 0;
    while (ix < 25) {
        if (t[ix * 25] > worst) { worst = t[ix * 25]; }
        ix = ix + 1;
    }
    return worst;
}

test the_50c_numbers_are_the_numbers_ngspice_printed {
    var s : u64 = fold_arr(&TT50_N, 625, 0);
    s = fold_arr(&TT50_P, 625, s);
    assert_eq(s, PIN_TAB50);
    s = fold_arr(&TT50_R2_N, 200, 0);
    s = fold_arr(&TT50_R2_P, 200, s);
    assert_eq(s, PIN_HELD50);
    // A pin sees one changed number: the NMOS table with its last entry one lower is another word.
    var t : [625]u32 = [0] ** 625;
    var i : usize = 0;
    while (i < 625) {
        t[i] = TT50_N[i];
        i = i + 1;
    }
    t[624] = t[624] - 1;
    assert fold_arr(&t, 625, 0) != fold_arr(&TT50_N, 625, 0);
    assert_eq(R2_COUNT_50, 200);
}

test the_tables_are_monotone_and_vanish_at_vds_0 {
    assert(monotone(&TT50_N));
    assert(monotone(&TT50_P));
    // Zero at Vds = 0 in every column (the deck holds the gate current out of the drain at 0), off current of at most 3 units (0.9 nA).
    assert_eq(at_vds0(&TT50_N), 0);
    assert_eq(at_vds0(&TT50_P), 0);
    // Variables, not constants: an assert on a constant table element is folded by the compiler and counts as no assert at all (#12166).
    var n24 : u32 = TT50_N[24];
    var p24 : u32 = TT50_P[24];
    assert_eq(n24, 3);
    assert_eq(p24, 0);
    // The largest entry is at (1.5 V, 1.5 V), below the 2^23 the solver's u64 interpolation allows.
    var n624 : u32 = TT50_N[624];
    var p624 : u32 = TT50_P[624];
    assert_eq(n624, 1271348);
    assert_eq(p624, 968691);
    assert n624 < 8388608;
    assert p624 < 8388608;
}

// Negative control (#11061): one entry dropped to 0 inside the NMOS table is not monotone and not the table the deck printed; the real one is both.
test one_changed_number_is_caught_by_the_pin_and_a_dropped_entry_breaks_the_monotone_check {
    var t : [625]u32 = [0] ** 625;
    var i : usize = 0;
    while (i < 625) {
        t[i] = TT50_N[i];
        i = i + 1;
    }
    assert(monotone(&t));
    var s : u64 = fold_arr(&t, 625, 0);
    s = fold_arr(&TT50_P, 625, s);
    assert_eq(s, PIN_TAB50);
    t[312] = 0;
    assert monotone(&t) == false;
    s = fold_arr(&t, 625, 0);
    s = fold_arr(&TT50_P, 625, s);
    assert s != PIN_TAB50;
}

test fifty_degrees_move_the_tables_the_way_the_model_moves_them {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var n50 : u32 = TT50_N[624];
    var n27 : u32 = TT_N[624];
    var p50 : u32 = TT50_P[624];
    var p27 : u32 = TT_P[624];
    // Saturation current falls: NMOS -5.8 %, PMOS -4.2 % against 27 C.
    assert n50 < n27;
    assert p50 < p27;
    assert n50 * 1000 > n27 * 940;
    assert n50 * 1000 < n27 * 945;
    assert p50 * 1000 > p27 * 955;
    assert p50 * 1000 < p27 * 960;
    // Weak inversion rises (NMOS at Vgs = 0.25 V, Vds = 1.5 V: 1725 to 2774; Vgs = 0.3125 V: 6937 to 9004).
    var w50 : u32 = TT50_N[4 * 25 + 24];
    var w27 : u32 = TT_N[4 * 25 + 24];
    assert_eq(w27, 1725);
    assert_eq(w50, 2774);
    assert w50 > w27;
    var v50 : u32 = TT50_N[5 * 25 + 24];
    var v27 : u32 = TT_N[5 * 25 + 24];
    assert v50 > v27;
    var pw50 : u32 = TT50_P[4 * 25 + 24];
    var pw27 : u32 = TT_P[4 * 25 + 24];
    assert pw50 > pw27;
    var pv50 : u32 = TT50_P[5 * 25 + 24];
    var pv27 : u32 = TT_P[5 * 25 + 24];
    assert pv50 > pv27;
    // The curves cross between Vgs = 0.5 V (node 8) and 0.75 V (node 12): above that the 50 C current is the lower.
    var a50 : u32 = TT50_N[8 * 25 + 24];
    var a27 : u32 = TT_N[8 * 25 + 24];
    assert a50 > a27;
    var b50 : u32 = TT50_N[12 * 25 + 24];
    var b27 : u32 = TT_N[12 * 25 + 24];
    assert b50 < b27;
}
