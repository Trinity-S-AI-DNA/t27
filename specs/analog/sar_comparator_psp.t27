// SPDX-License-Identifier: Apache-2.0
; specs/analog/sar_comparator_psp.t27 -- the SAR ADC dynamic comparator on the IHP SG13G2 PSP103 current tables at 50 C, judged by ngspice
; Analog M4b-psp (#10856, epic #10486; M4b is #10583, the PSP103 tables are M3b, #10516; M4e, #10818, fits a decision offset of 6.7 mV and asks
; where it comes from). M4b (specs/analog/sar_comparator.t27) solves the golden deck's StrongARM latch, eight nodes, by a multi-node Newton step on a
; SQUARE-LAW table. Here the same solver runs on the foundry's model: Id(Vgs, Vds) of sg13_lv_nmos (W 1.0 um) and sg13_lv_pmos (W 3.0 um), L 0.45 um,
; PSP 103.6 through ngspice-47, tt, at 50 C, the temperature of the golden deck (specs/analog/mos_psp103_50c_data.t27, deck psp103_tab_tt50.cir;
; M3b tabulated 27 C). The solver is reused, not copied: in sar_comparator.t27 the device stamp, the stamp, the Newton iteration, the step and the
; run gain `_np` forms that take the NMOS table and the PMOS table as two arguments (the square law's one table serves both types; PSP103's two do
; not), and the old names delegate to them with one table twice: every old test and pin is unchanged. Everything else is here: the unit
; conversion, the runs, the flip-point bisection, the pinned ngspice numbers and the tests. The decks are in specs/analog/decks/ (sar_cmp_psp_*.cir,
; psp103_tab_tt50.cir); the golden deck itself is fetched at run time and never vendored.
; -
; WHAT WAS ASKED AND WHAT CAME OUT, first. M4e needs a 6.7 mV decision offset to match the golden run's codes 30 of 31; reading the golden run's
; decisions put the latch's decision point at +2.5 .. +3.1 mV. The issue asks the PSP103 latch to PREDICT that threshold. It does not, because the
; latch has none: the circuit is mirror-symmetric (the pair XM3, XM4, the pull-ups XM8, XM9 and XM6, XM7, the cross-coupled XM10, XM11, the
; resets XM12, XM13 and the loads), so with equal devices its flip point -- the input difference at which dp and dn trade places -- is ZERO, and
; the measurements say so: model +0.12 uV (rounding, 2 units of 2^-24 V), ngspice with PSP103 within 0.12 uV of zero, whether the charge is swamped
; or real. The golden comparator WITH ITS LOADS (dynamic_comparator_top: an inverter on dp and on dn, then the NAND "Valid") has a flip point
; of -0.153 mV, from the NAND's two inputs not being the same load; it favours dp, the golden run's reading is positive (dp needs VDP above VDN),
; so even the sign differs. The offset the converter shows is not the DC threshold of the latch: it is what the converter does around it (kickback
; at the clock edge moves VDP and VDN by 12 and 25 mV in 2 ns, per M4e) or an imbalance of the pair, which this file measures:
;   flip point of an unequal pair (XM4 at m = 35 or 34 instead of 36), VDP - VDN:
;                        ngspice (bulks tied, charge swamped)    model            model against ngspice
;   m = 35                 +4.2665 mV   (71579 .. 71581 units)     +4.176 mV (70064)    -2.1 %
;   m = 34                 +8.689  mV   (145772 .. 145774 units)   +8.513 mV (142816)    -2.0 %
; so 6.7 mV is an imbalance of 4.4 % of the pair's current (m of XM4 = 34.42 of 36), a mismatch of the pair or of the input stages, and a predictor
; of the offset has to be given THAT, not the latch. The threshold is predicted within 2.1 % as a function of the imbalance, and is zero without.
; -
; THE UNIT. A table entry is Id * dt / C in units of 2^-24 V. M3b's tables have dt / C = 200 V/A (0.1 ps on 0.5 fF, or 2 ns on 10 pF); the
; comparator's charge unit is 0.125 fF (SC_CUNIT_AF) at dt = 0.1 ps, so its dt / C is 800 V/A (SC_STEP_V_PER_A): a word of the solver is exactly 4
; times an M3b word (sp_scale; the rounding of M3b's 0.298 nA becomes 1.2 nA, a ten-thousandth of the 100 uA the devices work at). The largest word, 4 x
; 1271348 = 5085392 (tt50 NMOS), stays under the 2^23 the solver's u64 interpolation allows. THE DEVICE SIZES. The table devices are the golden
; comparator's: NMOS W 1.0 um and PMOS W 3.0 um at L 0.45 um, ng 1. The comparator's devices are those with a multiplier m (6 .. 36), and PSP103
; multiplies every current by m exactly, so the table needs no width correction, only the multiplier SC_DV_M the solver already applies: nothing
; of narrow-width or edge effects is assumed because no width differs. THE TEMPERATURE is the deck's own, 50 C (`.options TEMP = 50`), tabulated
; with M3b's recipe; the same ngspice and checkout reproduce M3b's 27 C tables word for word. 50 C moves the tables: the saturation current falls 5.8 %
; (NMOS) and 4.2 % (PMOS), the weak-inversion current rises 1.6 times at Vgs = 0.25 V. The tables' held-out accuracy at 50 C (first 200 R2 points
; per device): absolute 4.97e-7 A (NMOS) and 3.92e-7 A (PMOS), relative at least 100 uA 0.34 % and 0.14 %, the size of M3b's (0.56 % and 0.41 %).
; -
; THREE REFERENCES, all ngspice-47 with PSP103 (IHP-Open-PDK 21133f21, mos_tt, OSDI), 50 C, the golden subcircuits read at run time from the file
; named by SAR_GOLDEN_SUBCKTS (the subcircuit section of the fetched deck: `sed -n '/^.subckt tracking_switch/,$p' top.spice | grep -v -i -E
; '^\.(end|global)([[:space:]]|$)'`; the pattern `^.(end|global)` of M4d's header drops the `.ends` lines too):
;   R2   sar_cmp_psp_r2.cir      the golden dynamic_comparator as it is, the node capacitances of M4b (4 fF on ap an dp dn, 6 fF on net1, 2 fF on net2,
;                                net3, n_clkc) times 1e6 and the step times 1e6 (0.1 us): the same dt / C, and PSP103's own charge (a few hundred fF)
;                                is 1e-4 of the lumped one. The CURRENTS alone are compared. Between scales 1e4, 1e5, 1e6 the decision time moved by
;                                0.83 % and 0.09 %: the charge left is about 0.01 %. Fixed-step backward Euler on the model's grid (the M4b recipe).
;   R2b  sar_cmp_psp_r2b.cir     R2 with every bulk tied to its source, the one thing a 2-D table Id(Vgs, Vds) models. The golden deck ties the
;                                NMOS bulks to ground and the PMOS bulks to VDD, so the input pair (source net1, 0.15 .. 0.4 V above ground) and XM8, XM9
;                                (sources below VDD) have a body effect the tables cannot have.
;   R1   sar_cmp_psp_real.cir    the circuit as the converter has it: all of PSP103's charge, 4 fF on dp and dn, an ideal 1.6 ps clock, the inputs held,
;                                ngspice's own trapezoidal steps. Xb is the bare latch, Xtop is dynamic_comparator_top.
; The rest is M4b's (rest value, clock of 16 steps, 140 steps, the two outputs dp and dn). The rest of net1 is an initial condition, 0.401 V, both in the
; model and in the decks (PSP103's own operating point puts floating net1 at 0.71 V on gmin).
; -
; THE RESULT, K = 3, fixed point, tt 50 C tables, times in steps of 0.1 ps after the clock's 50 % point:
;                          decision (first output)                               resolution (|dp - dn| = Vdd / 2)
;                   model     R2b (tied)   error     R2 (golden)   error       model     R2b       error      R2        error      sign
;   +-2 mV           53.502    53.854    -0.65 %      57.198     -6.46 %      71.856    72.309   -0.63 %    74.476   -3.52 %     right
;   +-0.5 mV         54.621    54.937    -0.58 %      58.442     -6.54 %      81.255    81.726   -0.58 %    83.462   -2.64 %     right
; and 0.125 mV, 31 uV, 10 uV, 1 uV (h = 1049, 262, 84, 8): decision 55.00, 55.13, 55.16, 55.17 (R2b 55.34, 55.46, 55.48, 55.49), resolution 90.63, 100.02, 107.70, 123.44
; (R2b 91.16, 100.60, 108.34, 124.33); at 0.12 uV (1 unit of h) the sign is right and the resolution is not reached in 140 steps, in ngspice either.
; All 14 runs (7 inputs, 2 orientations) decide as R2 and R2b do. The bounds are set from these numbers: the decision time against R2b within 0.66 %
; and the resolution time within 0.72 %, against R2 within 6.7 % and 3.6 %, both from both sides.
; -
; THE ERRORS, kept apart (W10):
;   arithmetic   not re-measured here: the real twin of the iteration (sc_run_f) has no two-table form yet. What is checked: the last residual is at
;                most 3 units (0.18 uV) at all 140 steps of all 14 runs (SP_RES_BOUND; M4b's square law had 2), K = 4 gives the same decision time to
;                1e-3 of a step and the same resolution time to 7e-3 of 100 steps, K = 2 leaves 155 units and K = 1 leaves 20750.
;   table        the model against R2b: -0.65 % (decision), -0.63 % (resolution); the eight nodes at the eight recorded steps within 15.9 mV (dp), the
;                same size as the square law's 15 mV in M4b: the 62.5 mV cells and the constant slopes over a cell.
;   body effect  R2b against R2, ngspice alone: the golden deck is 6.2 .. 6.5 % slower to decide and 3.0 % .. 0.3 % slower to resolve. This is the
;                largest error of the model against the golden deck (the nodes: 150 mV at net2 after the decision, 113 mV at dp); the tables carry no
;                Vsb. A 3-D table, or a threshold-shift model, is what would take it out. The two compose: (1 - 0.0065) / (1 + 0.0621) - 1 = -6.46 %.
;   charge       R1 against R2: the bare golden comparator with its own charge decides 523.0 ps after the clock at +2 mV, the model 5.35 ps: THE
;                MODEL IS 96 .. 98 TIMES TOO FAST in the decision and 155 .. 183 times in the resolution (1111.9 ps at +2 mV against 7.19 ps). The
;                devices' own gate and junction capacitance (m up to 36 on W 1 .. 3 um) outweighs the 2 .. 6 fF of the model. Until the charge tables
;                (#10777) exist the model's time is the time of the currents; the times above are judged against the charge-swamped decks.
;   discretization shared with ngspice by construction in R2 and R2b (backward Euler on the same grid).
; -
; THE NEGATIVE CONTROLS, tests that pass by seeing the failure. The decision time is what tells the right tables from the wrong ones; the sign and the
; flip point cannot, because the symmetric latch decides the right way and flips at zero for ANY pair of tables (the test says so):
;   ss at 27 C (M3b's slow corner) in the run   14.1 % late (decision), 11.5 % late (resolution) against R2b (bounds 0.66 %, 0.72 %); 7.5 % late against R2
;   tt at 27 C (the right corner, the wrong temperature)   5.0 % early and 6.0 % early: 7.5 and 8 times the bounds
;   the PMOS table in the NMOS slot and the reverse   20.7 % late
;   the inputs exchanged   the sign check fails (dn wins for VDP > VDN)
;   K = 1, K = 2   the residual bound of 3 units is broken by 6900 and 52 times
; -
; THE HARDWARE. The functions from sp_scale on are test-side (f64 and comparison); the board's step is M4b's (`sc_run_np` and below take bool and
; unsigned words), with two 625-word tables a board would load at run time. No board top, no clock, no LUT, DSP, BRAM, Fmax or UART line is in
; this file or claimed.
; -
; WHAT A PASS SAYS. The comparator of eight nodes and fifteen devices, each read from the tt 50 C PSP103 tables (NMOS and PMOS tables, M4b's solver
; with three Newton iterations, last residual at most 3 units), decides +-2 mV, +-0.5 mV and every smaller input down to 0.12 uV the way ngspice
; does; its decision time is within 0.66 % and its resolution time within 0.72 % of the PSP103 comparator with the bulks at the sources when the
; charge is swamped, and 6.7 % and 3.6 % early against the golden deck itself, 6.2 % of which is the body effect the tables do not carry; its flip point
; is zero to 0.12 uV and the pair-imbalance flip points are within 2.1 % of ngspice's; the tables of the wrong corner, the wrong temperature or the
; wrong slots, and the wrong number of Newton iterations, are refused. It does NOT predict the 6.7 mV of M4e (see the top).
; WHAT IT DOES NOT SAY. Anything about charge: the real comparator is 98 times slower than the model, and the model's picoseconds are the currents'.
; Anything about the body effect beyond its measure (6.2 % of the decision time). The converter's offset: the kickback at the clock edge, the
; input stages, the delay-cell clock and the DAC's settling are not here, and the flip point of the isolated latch says nothing about them. The
; top's -0.15 mV is measured, not modelled (the inverters, the NAND and their charge are not in the model). Another corner or temperature than
; tt 50 C, another W, L or supply, noise, or Monte Carlo mismatch (the imbalance is a deterministic m, not a distribution). The arithmetic error
; against a real twin (above). A board, power, or speed against SPICE. The golden deck is read at run time and is not in this repository.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogSarComparatorPsp;

use analog::linear::{fabs64};
use analog::mos_table::{TBL_LEN, VDD};
use analog::mos_psp103::{hold_stats, Hold};
use analog::mos_psp103_data::{TT_N, TT_P, SS_N, SS_P, NMOS_W_NM, PMOS_W_NM, L_NM, DTC_V_PER_A};
use analog::mos_psp103_50c_data::{TT50_N, TT50_P, TT50_R2_N, TT50_R2_P, TEMP50_C};
use analog::sar_comparator::{SC_DV_M, SC_K, SC_N, SC_UPV, SC_STEP_V_PER_A, SC_W_N, SC_W_P, SC_L, SC_NONE, SC_NN, SC_DP, sc_run_np, sc_sign, sc_t_first, sc_t_res, sc_after_clock, sc_mult_pair, sc_dev_ng_u};

pub const KIND : str = "analog-cell-check";
pub const ID : str = "analog/sar_comparator_psp";
pub const REFERENCE : str = "uberWAVE wp2-parser/golden/top.spice, subckts dynamic_comparator and dynamic_comparator_top (GPL-2.0: read at run time, never vendored); IHP-Open-PDK 21133f21 PSP103 through ngspice-47, 50 C";

; --- the units: M3b's tables into M4b's solver ---------------------------------------------------------------
/// A table entry is Id * dt / C in units of 2^-24 V. M3b's tables have dt / C = 200 V/A (0.1 ps on 0.5 fF, or 2 ns on 10 pF); the comparator's
/// charge unit is 0.125 fF, so its dt / C is 800 V/A (SC_STEP_V_PER_A): every M3b word times 4 is the word the solver reads.
pub const SP_CONV : u32 = 4;
/// The largest differential half-input of the flip-point bisection, in units: 400000 is 23.8 mV on each side.
pub const SP_HMAX : u32 = 400000;
/// Newton residual bound with these tables: 3 units (0.18 uV); the square law's was 2.
pub const SP_RES_BOUND : u32 = 3;
/// The inputs of the decks' first list, h in units of 2^-24 V (VDP - VDN = 2h): 2 mV, 0.5 mV, 0.125 mV, 31 uV, 10 uV, 1 uV and 0.12 uV. Every
/// run but the last reaches a resolution time.
pub const SP_H : [7]u32 = [16777, 4194, 1049, 262, 84, 8, 1];
/// M4e's fitted decision offset (mV) and the latch's own decision point seen in the golden run (mV), for the comparison only.
pub const M4E_FIT_MV : f64 = 6.7;
pub const M4E_RUN_LO_MV : f64 = 2.5;
pub const M4E_RUN_HI_MV : f64 = 3.1;

/// dst = SP_CONV * src for a 625-word table.
pub fn sp_scale(src: []const u32, dst: []u32) {
    var i : usize = 0;
    while (i < TBL_LEN) {
        dst[i] = src[i] * SP_CONV;
        i = i + 1;
    }
}

/// The comparator's run (SC_N steps from rest, inputs VCM +- h, exchanged when swap) on M3b-unit tables: NMOS from tn_src, PMOS from tp_src,
/// each converted to the solver's unit. Returns the order-sensitive fold of every sample.
pub fn sp_run(tn_src: []const u32, tp_src: []const u32, h: u32, swap: bool, k: u32, mult: []const u32, out: []u32, res: []u32) -> u64 {
    var tn : [625]u32 = [0] ** 625;
    var tp : [625]u32 = [0] ** 625;
    sp_scale(tn_src, &tn);
    sp_scale(tp_src, &tp);
    return sc_run_np(&tn, &tp, h, swap, k, mult, out, res);
}

/// The decision time, in steps (0.1 ps) after the clock's 50 % point; -1.0 when the first output never reaches Vdd / 2.
pub fn sp_first(out: []const u32) -> f64 {
    const q : u32 = sc_after_clock(sc_t_first(out));
    if (q == SC_NONE) { return 0.0 - 1.0; }
    return (q as f64) / 4096.0;
}

/// The resolution time (|dp - dn| through Vdd / 2), in steps after the clock; -1.0 when it is not reached in SC_N steps.
pub fn sp_res(out: []const u32) -> f64 {
    const q : u32 = sc_after_clock(sc_t_res(out));
    if (q == SC_NONE) { return 0.0 - 1.0; }
    return (q as f64) / 4096.0;
}

/// (a - b) / b.
pub fn sp_rel(a: f64, b: f64) -> f64 {
    return (a - b) / b;
}

/// The largest residual of a run, in units.
pub fn sp_res_max(res: []const u32) -> u32 {
    var worst : u32 = 0;
    var i : usize = 0;
    while (i < (SC_N as usize)) {
        if (res[i] > worst) { worst = res[i]; }
        i = i + 1;
    }
    return worst;
}

/// Does dp win (dp above dn at the last step) for VDP - VDN = +2h units (swap false) or -2h (swap true)?
pub fn sp_wins(tn_src: []const u32, tp_src: []const u32, mult: []const u32, h: u32, swap: bool) -> bool {
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    sp_run(tn_src, tp_src, h, swap, SC_K, mult, &out, &res);
    return sc_sign(&out);
}

/// The flip point of the circuit with the given multipliers, as the differential VDP - VDN in units of 2^-24 V at which the decision changes:
/// the smallest d (even; d = 2h) such that dp wins at d and above, found by bisection on h in [0, SP_HMAX] (the winner is monotone in h).
/// Positive when dp needs VDP above VDN, negative when dp wins at d = 0.
pub fn sp_flip(tn_src: []const u32, tp_src: []const u32, mult: []const u32) -> i64 {
    if (sp_wins(tn_src, tp_src, mult, 0, false)) {
        var lo : u32 = 0;
        var hi : u32 = SP_HMAX;
        while (hi - lo > 1) {
            const mid : u32 = (lo + hi) / 2;
            if (sp_wins(tn_src, tp_src, mult, mid, true)) { lo = mid; } else { hi = mid; }
        }
        return 0 - (2 * (lo as i64));
    }
    var lo2 : u32 = 0;
    var hi2 : u32 = SP_HMAX;
    while (hi2 - lo2 > 1) {
        const mid2 : u32 = (lo2 + hi2) / 2;
        if (sp_wins(tn_src, tp_src, mult, mid2, false)) { hi2 = mid2; } else { lo2 = mid2; }
    }
    return 2 * (hi2 as i64);
}

/// Absolute value of a signed 64-bit integer, as f64.
pub fn sp_abs_i(x: i64) -> f64 {
    if (x < 0) { return ((0 - x) as f64); }
    return (x as f64);
}

