/// The input pair made unequal (m of XM4 = 35, then 34), r2b deck: dp, dn at the last point for d = 71579, 71581 (m = 35) and 145772, 145774 (m = 34).
pub const NG_MM : [8]f64 = [0.588023, 1.00043, 0.920144, 0.666049, 0.741355, 0.843, 1.05863, 0.529989];
/// REAL CHARGE (sar_cmp_psp_real.cir, Xb: the bare comparator, 4 fF on dp and dn): the first output through 0.75 V after the clock (ps), +2h.
pub const NG_RL_FIRST_PS : [7]f64 = [523.032, 528.007, 529.386, 529.741, 529.822, 529.857, 529.860];
/// The resolution time (ps), the same.
pub const NG_RL_RES_PS : [7]f64 = [1111.910, 1319.320, 1526.820, 1734.590, 1904.960, 2257.140, 2568.600];
/// Xtop (dynamic_comparator_top): Valid through 0.75 V after the clock (ps), VDP - VDN = +2h.
pub const NG_RL_VALID_PS_P : [7]f64 = [897.700, 922.560, 927.390, 928.410, 928.630, 928.720, 928.730];
/// The same, VDP - VDN = -2h.
pub const NG_RL_VALID_PS_M : [7]f64 = [920.620, 932.190, 929.900, 929.040, 928.830, 928.740, 928.730];
/// 1 where dp wins, Xb, VDP - VDN = +2h.
pub const NG_RL_BARE_WIN_P : [7]u32 = [1, 1, 1, 1, 1, 1, 1];
/// 1 where dp wins, Xtop, VDP - VDN = +2h.
pub const NG_RL_TOP_WIN_P : [7]u32 = [1, 1, 1, 1, 1, 1, 1];
/// 1 where dp wins, Xb, VDP - VDN = -2h.
pub const NG_RL_BARE_WIN_M : [7]u32 = [0, 0, 0, 0, 0, 0, 0];
/// 1 where dp wins, Xtop, VDP - VDN = -2h.
pub const NG_RL_TOP_WIN_M : [7]u32 = [0, 0, 1, 1, 1, 1, 1];
/// Xtop scan, VDP - VDN = d units: d = -2700, -2600, -2571, -2570, -2540, -2400.
/// 1 where dp wins, Xtop, over the scan list.
pub const NG_RL_SCAN_TOP_WIN : [6]u32 = [0, 0, 0, 0, 1, 1];
/// 1 where dp wins, Xb, over the scan list.
pub const NG_RL_SCAN_BARE_WIN : [6]u32 = [0, 0, 0, 0, 0, 0];
/// The clock 50 % point in the real deck, ps.
pub const NG_RL_TCK_PS : f64 = 200.8;

; --- the tests --------------------------------------------------------------------------------------------

test the_unit_of_the_tables_is_converted_by_an_exact_factor_and_the_devices_are_the_tables_devices {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var conv : u32 = SP_CONV;
    var dtc : u32 = DTC_V_PER_A;
    // M3b's tables have dt / C = 200 V/A; the solver's charge unit gives 800 V/A: a factor of exactly 4.
    assert_eq(conv * dtc, 800);
    assert_eq(SC_STEP_V_PER_A, 800.0);
    var w_n : f64 = SC_W_N * 1000.0;
    var w_p : f64 = SC_W_P * 1000.0;
    var l : f64 = SC_L * 1000.0;
    // The table devices are the golden comparator's: sg13_lv_nmos W 1.0 um, sg13_lv_pmos W 3.0 um, L 0.45 um, ng 1; a device of the comparator is
    // m of them in parallel, and PSP103 scales every current by m exactly, so the table needs no width correction, only the multiplier.
    assert_eq((w_n + 0.5) as u32, NMOS_W_NM);
    assert_eq((w_p + 0.5) as u32, PMOS_W_NM);
    assert_eq((l + 0.5) as u32, L_NM);
    assert_eq(TEMP50_C, 50);
    var tn : [625]u32 = [0] ** 625;
    var tp : [625]u32 = [0] ** 625;
    sp_scale(&TT50_N, &tn);
    sp_scale(&TT50_P, &tp);
    // The converted words are 4 times M3b's, the largest under the 2^23 the solver's u64 interpolation allows.
    assert_eq(tn[624], 5085392);
    assert_eq(tp[624], 3874764);
    assert_eq(tn[624], 4 * TT50_N[624]);
    assert tn[624] < 8388608;
    assert tp[624] < 8388608;
    var ss : [625]u32 = [0] ** 625;
    sp_scale(&SS_N, &ss);
    assert ss[624] < 8388608;
    sp_scale(&TT_N, &ss);
    assert ss[624] < 8388608;
    // Per unit of m the PMOS (W 3 um) drives 0.76 of the NMOS (W 1 um) at 1.5 V, 1.5 V: the two types need two tables.
    var ratio : f64 = (tp[624] as f64) / (tn[624] as f64);
    assert ratio > 0.76;
    assert ratio < 0.77;
}

test the_50c_tables_at_the_held_out_points_against_ngspice {
    const rn : Hold = hold_stats(&TT50_N, &TT50_R2_N, 1, 200);
    const rp : Hold = hold_stats(&TT50_P, &TT50_R2_P, 1, 200);
    // The first 200 R2 points of each device, never nodes. Absolute error 4.97e-7 A (NMOS, 0.13 % of its 378.9 uA) and 3.92e-7 A (PMOS): M3b's 27 C
    // tables had 6.5e-7 and 4.4e-7 over 1000 points. Both sides.
    assert rn.abs_a < 0.0000005;
    assert rn.abs_a > 0.00000049;
    assert rp.abs_a < 0.00000040;
    assert rp.abs_a > 0.00000039;
    // Relative error where the current is at least 100 uA: 0.34 % and 0.14 %; at least 10 uA: 3.15 % and 2.65 %; at least 1 uA: 13.6 % and 10.0 %.
    assert rn.b4 < 0.0035;
    assert rn.b4 > 0.0033;
    assert rp.b4 < 0.0015;
    assert rp.b4 > 0.0013;
    assert rn.b5 < 0.0320;
    assert rn.b5 > 0.0310;
    assert rp.b5 < 0.0270;
    assert rp.b5 > 0.0260;
    assert rn.b6 < 0.137;
    assert rn.b6 > 0.135;
    assert rp.b6 < 0.101;
    assert rp.b6 > 0.099;
    assert rn.n4 > 70;
    assert rp.n4 > 50;
    assert rn.n6 > 160;
    // The issue's relative measure with a floor of 1e-9 A is 53 % and 54 % here too: a chord over a 62.5 mV cell cannot do 1 % in weak inversion
    // (M3b says so for 27 C); the bound that matters for the comparator is the one at 100 uA and above, where its devices work.
    assert rn.rel9 > 0.5;
    assert rp.rel9 > 0.5;
}

test the_run_decides_the_right_way_at_every_input_down_to_one_unit {
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var k : usize = 0;
    while (k < 7) {
        const sp : u64 = sp_run(&TT50_N, &TT50_P, SP_H[k], false, SC_K, &SC_DV_M, &out, &res);
        assert !(!sc_sign(&out));
        assert !((NG_R2_DP_P[k] > NG_R2_DN_P[k]) != sc_sign(&out));
        assert !((NG_R2B_DP_P[k] > NG_R2B_DN_P[k]) != sc_sign(&out));
        const sm : u64 = sp_run(&TT50_N, &TT50_P, SP_H[k], true, SC_K, &SC_DV_M, &out, &res);
        assert !(sc_sign(&out));
        assert !((NG_R2_DP_M[k] > NG_R2_DN_M[k]) != sc_sign(&out));
        assert !((NG_R2B_DP_M[k] > NG_R2B_DN_M[k]) != sc_sign(&out));
        k = k + 1;
    }
}

test the_times_against_the_table_reference_with_the_bulks_tied_to_the_sources {
    // sar_cmp_psp_r2b.cir: the same PSP103 comparator with every bulk tied to its source, which is what a 2-D table Id(Vgs, Vds) models, charge
    // swamped by 1e6. The decision time (first output through Vdd / 2) is 0.57 .. 0.66 % early and the resolution time 0.57 .. 0.72 % early, for
    // every input from 2 mV down to h = 8 (a 1 uV differential); at h = 1 (0.12 uV) the resolution is not reached in 140 steps, in ngspice or here.
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var k : usize = 0;
    while (k < 6) {
        const s : u64 = sp_run(&TT50_N, &TT50_P, SP_H[k], false, SC_K, &SC_DV_M, &out, &res);
        const f : f64 = sp_rel(sp_first(&out), NG_R2B_FIRST[k]);
        const r : f64 = sp_rel(sp_res(&out), NG_R2B_RES[k]);
        assert !(f > 0.0 - 0.0057);
        assert !(f < 0.0 - 0.0066);
        assert !(r > 0.0 - 0.0057);
        assert !(r < 0.0 - 0.0072);
        k = k + 1;
    }
    // At 1 unit: the first output as before, no resolution in either.
    const s1 : u64 = sp_run(&TT50_N, &TT50_P, 1, false, SC_K, &SC_DV_M, &out, &res);
    assert sp_rel(sp_first(&out), NG_R2B_FIRST[6]) < 0.0 - 0.0057;
    assert sp_rel(sp_first(&out), NG_R2B_FIRST[6]) > 0.0 - 0.0066;
    assert sp_res(&out) < 0.0;
    // Variables, not constants: an assert on a constant table element is folded by the compiler and counts as no assert at all (#12166).
    var ng_res6 : f64 = NG_R2B_RES[6];
    assert ng_res6 == 0.0;
}

test the_times_against_the_golden_deck_and_the_body_effect_is_the_difference {
    // sar_cmp_psp_r2.cir: the golden subcircuit as it is, NMOS bulks at ground and PMOS bulks at VDD. The tables have no bulk: the input pair XM3, XM4
    // (source net1, 0.15 .. 0.4 V above ground) and XM8, XM9 (sources below VDD) lose current to the body effect in ngspice. The decision time is
    // 6.5 % early against the golden deck (bound 6.7 %), the resolution time 3.5 % .. 1.0 % early (bound 3.6 %).
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var k : usize = 0;
    while (k < 6) {
        const s : u64 = sp_run(&TT50_N, &TT50_P, SP_H[k], false, SC_K, &SC_DV_M, &out, &res);
        const f : f64 = sp_rel(sp_first(&out), NG_R2_FIRST[k]);
        const r : f64 = sp_rel(sp_res(&out), NG_R2_RES[k]);
        assert !(f > 0.0 - 0.063);
        assert !(f < 0.0 - 0.067);
        assert !(r > 0.0 - 0.0100);
        assert !(r < 0.0 - 0.0360);
        // The body effect in ngspice alone, golden deck against the bulk-tied deck: the decision 6.2 .. 6.5 % later, the resolution 0.3 .. 3.0 % later.
        const be_f : f64 = sp_rel(NG_R2_FIRST[k], NG_R2B_FIRST[k]);
        const be_r : f64 = sp_rel(NG_R2_RES[k], NG_R2B_RES[k]);
        assert !(be_f < 0.062);
        assert !(be_f > 0.065);
        assert !(be_r < 0.0029);
        assert !(be_r > 0.0305);
        // The two errors compose: model against the golden deck = (1 + table error) / (1 + body effect) - 1.
        const comp : f64 = (1.0 + sp_rel(sp_first(&out), NG_R2B_FIRST[k])) / (1.0 + be_f) - 1.0;
        const d : f64 = comp - f;
        assert !(d * d > 0.00000001 * 0.00000001);
        k = k + 1;
    }
}

test the_nodes_at_the_checkpoints_against_both_references {
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const sa : u64 = sp_run(&TT50_N, &TT50_P, SP_H[0], false, SC_K, &SC_DV_M, &out, &res);
    // Against the bulk-tied deck the eight nodes at the eight steps are within 15.9 mV (dp at the early checkpoints; ap, an, net2, net3 10.8 .. 13.4 mV,
    // net1 2.7 mV, n_clkc 0.35 mV): the table's error, the same size as the square law's 15 mV in M4b.
    const nb : f64 = sc_dev_ng_u(&out, &NG_R2B_CHK_2);
    assert nb < 0.0160;
    assert nb > 0.0158;
    // Against the golden deck: 150 mV, at net2 after the decision (ngspice's net2 stays at 0.53 V, the table's falls to 0.38 V: the PMOS XM9 in its
    // body-effect weak inversion), 113 mV at dp in the middle of the regeneration.
    const ng : f64 = sc_dev_ng_u(&out, &NG_R2_CHK_2);
    assert ng < 0.1510;
    assert ng > 0.1495;
    const sb : u64 = sp_run(&TT50_N, &TT50_P, SP_H[1], false, SC_K, &SC_DV_M, &out, &res);
    const nh : f64 = sc_dev_ng_u(&out, &NG_R2_CHK_05);
    assert nh < 0.1485;
    assert nh > 0.1478;
}

test the_flip_point_of_the_isolated_latch_is_zero_in_the_model_and_in_ngspice {
    // THE FLIP POINT: the input difference VDP - VDN at which dp and dn trade places. The comparator is symmetric (XM8, XM9, XM6, XM7 and the pair
    // are mirror images, SC_DV_*), so with equal devices it is zero in exact arithmetic; the question is how far from zero each side puts it.
    // The model: bisection on h in units of 2^-24 V (a differential of 2h, 0.12 uV per step of h).
    const f : i64 = sp_flip(&TT50_N, &TT50_P, &SC_DV_M);
    assert sp_abs_i(f) <= 2.0;
    const f_mv : f64 = (f as f64) * 1000.0 / SC_UPV;
    // ngspice, charge swamped (golden deck and bulk-tied deck): the right winner at h = 1, i.e. at +-2 units, in both orientations, so the flip lies
    // inside (-2, 2) units; at d = 0 the two outputs agree to 1e-6 V (the sweep in the header).
    // Variables, not constants: an assert on a constant table element is folded by the compiler and counts as no assert at all (#12166).
    var r2_dp_p : f64 = NG_R2_DP_P[6];
    var r2_dn_p : f64 = NG_R2_DN_P[6];
    var r2_dp_m : f64 = NG_R2_DP_M[6];
    var r2_dn_m : f64 = NG_R2_DN_M[6];
    var r2b_dp_p : f64 = NG_R2B_DP_P[6];
    var r2b_dn_p : f64 = NG_R2B_DN_P[6];
    var r2b_dp_m : f64 = NG_R2B_DP_M[6];
    var r2b_dn_m : f64 = NG_R2B_DN_M[6];
    assert(r2_dp_p > r2_dn_p);
    assert(r2_dp_m < r2_dn_m);
    assert(r2b_dp_p > r2b_dn_p);
    assert(r2b_dp_m < r2b_dn_m);
    // ngspice, real charge, the bare comparator (4 fF on dp, dn): the same, and dn wins on every point of the scan below zero.
    var bare_ok : u32 = 0;
    var k : usize = 0;
    while (k < 7) {
        bare_ok = bare_ok + NG_RL_BARE_WIN_P[k] + (1 - NG_RL_BARE_WIN_M[k]);
        k = k + 1;
    }
    assert_eq(bare_ok, 14);
    var scan_dn : u32 = 0;
    k = 0;
    while (k < 6) {
        scan_dn = scan_dn + (1 - NG_RL_SCAN_BARE_WIN[k]);
        k = k + 1;
    }
    assert_eq(scan_dn, 6);
    // The model's flip against M4e's: 0.00012 mV against the fitted 6.7 mV and the golden run's +2.5 .. +3.1 mV. The isolated latch does not have the
    // threshold M4e fits, and the model, which is the isolated latch, does not predict it.
    assert sp_abs_i(f) * 1000.0 / SC_UPV < 0.001;
    assert f_mv < M4E_RUN_LO_MV / 1000.0;
    assert f_mv > 0.0 - M4E_RUN_LO_MV / 1000.0;
}

test the_golden_top_with_its_inverters_and_nand_has_a_flip_point_of_minus_0_15_mv {
    // dynamic_comparator_top: the same latch, an inverter on dp and on dn (x5, x6), and the NAND of the two inverter outputs ("Valid"), PSP103 with
    // all its charge. Its flip point is NOT zero: the scan (tight tolerances, reltol 1e-8) has dn winning at d = -2700, -2600, -2571, -2570 units
    // and dp winning at -2540 and -2400, so the flip lies in (-2570, -2540], i.e. VDP - VDN between -0.1532 and -0.1514 mV: dp is favoured by
    // about 0.15 mV. The NAND's two inputs are not the same load (A and B sit differently in its stack), the inverters' gate-drain capacitance feeds
    // that back to dp and dn, and the latch is asymmetric by that much. At loose tolerances (reltol 1e-6) the bracket is (-2571, -2570]: the 1 uV level
    // is the tolerance's.
    var scan_d : [6]u32 = [2700, 2600, 2571, 2570, 2540, 2400];
    // Variables, not constants: an assert on a constant table element is folded by the compiler and counts as no assert at all (#12166).
    var sw0 : u32 = NG_RL_SCAN_TOP_WIN[0];
    var sw1 : u32 = NG_RL_SCAN_TOP_WIN[1];
    var sw2 : u32 = NG_RL_SCAN_TOP_WIN[2];
    var sw3 : u32 = NG_RL_SCAN_TOP_WIN[3];
    var sw4 : u32 = NG_RL_SCAN_TOP_WIN[4];
    var sw5 : u32 = NG_RL_SCAN_TOP_WIN[5];
    assert_eq(sw0 + sw1 + sw2 + sw3, 0);
    assert_eq(sw4 + sw5, 2);
    // d is negative: dn wins down to -2570 (index 3) and dp wins at -2540 (index 4).
    const lo_mv : f64 = 0.0 - (scan_d[3] as f64) * 1000.0 / SC_UPV;
    const hi_mv : f64 = 0.0 - (scan_d[4] as f64) * 1000.0 / SC_UPV;
    assert lo_mv < 0.0 - 0.1531;
    assert lo_mv > 0.0 - 0.1533;
    assert hi_mv < 0.0 - 0.1513;
    assert hi_mv > 0.0 - 0.1515;
    // The sign: the top favours dp (negative flip) and the golden run's reading of the latch is +2.5 .. +3.1 mV (dp needs VDP ABOVE VDN): the two
    // have opposite signs, and the top's offset is 1/16 of the run's lower figure and 1/44 of M4e's fit.
    assert lo_mv < 0.0;
    assert 0.0 - lo_mv < M4E_RUN_LO_MV / 16.0;
    assert 0.0 - lo_mv > M4E_FIT_MV / 45.0;
    assert 0.0 - lo_mv < M4E_FIT_MV / 43.0;
    // The same asymmetry in the time of Valid: at +-2 mV Valid rises 897.7 ps and 920.6 ps after the clock (a 22.9 ps difference between the two
    // orientations), and 928.7 ps at 0.12 uV, where the input no longer matters.
    const dv : f64 = NG_RL_VALID_PS_M[0] - NG_RL_VALID_PS_P[0];
    assert dv > 22.0;
    assert dv < 24.0;
    var valid_p6 : f64 = NG_RL_VALID_PS_P[6];
    assert valid_p6 > 928.0;
    assert valid_p6 < 929.5;
    // The top at the h list: dp wins for every +2h, and for -2h dn wins only while 2h exceeds the offset (h = 16777 and 4194).
    var tp0 : u32 = NG_RL_TOP_WIN_P[0];
    var tp1 : u32 = NG_RL_TOP_WIN_P[1];
    var tp2 : u32 = NG_RL_TOP_WIN_P[2];
    var tp3 : u32 = NG_RL_TOP_WIN_P[3];
    var tp4 : u32 = NG_RL_TOP_WIN_P[4];
    var tp5 : u32 = NG_RL_TOP_WIN_P[5];
    var tp6 : u32 = NG_RL_TOP_WIN_P[6];
    var tm0 : u32 = NG_RL_TOP_WIN_M[0];
    var tm1 : u32 = NG_RL_TOP_WIN_M[1];
    var tm2 : u32 = NG_RL_TOP_WIN_M[2];
    var tm3 : u32 = NG_RL_TOP_WIN_M[3];
    var tm4 : u32 = NG_RL_TOP_WIN_M[4];
    var tm5 : u32 = NG_RL_TOP_WIN_M[5];
    var tm6 : u32 = NG_RL_TOP_WIN_M[6];
    assert_eq(tp0 + tp1 + tp2 + tp3 + tp4 + tp5 + tp6, 7);
    assert_eq(tm0 + tm1, 0);
    assert_eq(tm2 + tm3 + tm4 + tm5 + tm6, 5);
}

test an_unequal_input_pair_moves_the_flip_point_as_ngspice_says {
    // The offset that a latch of this kind does have is the pair's imbalance. ngspice (the bulk-tied deck, charge swamped): XM4, whose gate is VDP,
    // at m = 35 instead of 36 puts the flip at VDP - VDN = +4.2665 mV (dn wins at d = 71579 units, dp at 71581), at m = 34 at +8.689 mV (dn at 145772,
    // dp at 145774). The model, the same pair through sc_mult_pair, bisects to 70064 and 142816 units.
    // Variables, not constants: an assert on a constant table element is folded by the compiler and counts as no assert at all (#12166).
    var mm0 : f64 = NG_MM[0];
    var mm1 : f64 = NG_MM[1];
    var mm2 : f64 = NG_MM[2];
    var mm3 : f64 = NG_MM[3];
    var mm4 : f64 = NG_MM[4];
    var mm5 : f64 = NG_MM[5];
    var mm6 : f64 = NG_MM[6];
    var mm7 : f64 = NG_MM[7];
    assert(mm0 < mm1);
    assert(mm2 > mm3);
    assert(mm4 < mm5);
    assert(mm6 > mm7);
    var mm : [15]u32 = [0] ** 15;
    sc_mult_pair(36, 35, &mm);
    const f35 : i64 = sp_flip(&TT50_N, &TT50_P, &mm);
    sc_mult_pair(36, 34, &mm);
    const f34 : i64 = sp_flip(&TT50_N, &TT50_P, &mm);
    const e35 : f64 = ((f35 as f64) - 71580.0) / 71580.0;
    const e34 : f64 = ((f34 as f64) - 145773.0) / 145773.0;
    // 2.1 % and 2.0 % low, from both sides.
    assert e35 < 0.0 - 0.0195;
    assert e35 > 0.0 - 0.0225;
    assert e34 < 0.0 - 0.0185;
    assert e34 > 0.0 - 0.0215;
    // The flip point is a fixed-point number far above the 2-unit rounding of the nominal one.
    assert f35 > 69000;
    assert f34 > 140000;
    // What imbalance would M4e's 6.7 mV be? 6.7 mV is 112400 units; between the two model points the m of XM4 that gives it is 34.42, an imbalance of
    // 4.4 % of the pair's current (1 part in 23): a pair mismatch of that size, not an effect of the latch itself.
    const units67 : f64 = M4E_FIT_MV * SC_UPV / 1000.0;
    const m4 : f64 = 35.0 - (units67 - (f35 as f64)) / ((f34 as f64) - (f35 as f64));
    assert m4 > 34.40;
    assert m4 < 34.44;
    const imb : f64 = (36.0 - m4) / 36.0;
    assert imb > 0.043;
    assert imb < 0.045;
}

test without_charge_tables_the_decision_is_98_times_too_fast {
    // sar_cmp_psp_real.cir: the bare golden comparator with ALL of PSP103's charge, 4 fF on dp and dn, an ideal 1.6 ps clock. The first output
    // reaches Vdd / 2 523.0 ps after the clock's 50 % point at +2 mV; the model, which has current and the lumped capacitances of M4b (4, 6, 2 fF)
    // and no charge, 5.35 ps. The decision is 96 .. 98 times too fast, the resolution 155 .. 183 times: the devices' own gate and junction
    // capacitance (m up to 36, a few hundred fF on a node) outweighs the 4 fF. This is what the charge tables (#10777) are for; until they exist the
    // model's time is the time of the current alone, and the check against the charge-swamped deck above is the one that judges the tables.
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var k : usize = 0;
    while (k < 6) {
        const s : u64 = sp_run(&TT50_N, &TT50_P, SP_H[k], false, SC_K, &SC_DV_M, &out, &res);
        const f_ps : f64 = sp_first(&out) * 0.1;
        const r_ps : f64 = sp_res(&out) * 0.1;
        const rf : f64 = NG_RL_FIRST_PS[k] / f_ps;
        const rr : f64 = NG_RL_RES_PS[k] / r_ps;
        assert !(rf < 95.5);
        assert !(rf > 98.0);
        assert !(rr < 154.0);
        assert !(rr > 183.5);
        k = k + 1;
    }
    assert NG_RL_TCK_PS > 200.7;
    assert NG_RL_TCK_PS < 200.9;
}

test the_residual_is_bounded_and_three_iterations_are_enough {
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    var k : usize = 0;
    while (k < 7) {
        const sp : u64 = sp_run(&TT50_N, &TT50_P, SP_H[k], false, SC_K, &SC_DV_M, &out, &res);
        assert sp_res_max(&res) <= SP_RES_BOUND;
        const sm : u64 = sp_run(&TT50_N, &TT50_P, SP_H[k], true, SC_K, &SC_DV_M, &out, &res);
        assert sp_res_max(&res) <= SP_RES_BOUND;
        k = k + 1;
    }
    // The bound is reached: h = 262 and 84 end a step 3 units from solved (0.18 uV).
    const s262 : u64 = sp_run(&TT50_N, &TT50_P, 262, false, SC_K, &SC_DV_M, &out, &res);
    assert_eq(sp_res_max(&res), 3);
    // K = 4 gives the same times as K = 3 (the decision time to 1e-3 of a step, the resolution time to 7e-3 of 100 steps): three are enough.
    const f3 : f64 = sp_first(&out);
    const r3 : f64 = sp_res(&out);
    const s4 : u64 = sp_run(&TT50_N, &TT50_P, 262, false, 4, &SC_DV_M, &out, &res);
    assert fabs64(sp_first(&out) - f3) < 0.001;
    assert fabs64(sp_res(&out) - r3) < 0.01;
    // NEGATIVE CONTROLS: K = 1 leaves the Newton move owed at 20750 units (1.2 mV), 6900 times the bound, and K = 2 at 155 units (52 times).
    const s1 : u64 = sp_run(&TT50_N, &TT50_P, 262, false, 1, &SC_DV_M, &out, &res);
    assert sp_res_max(&res) > 20000;
    assert sp_res_max(&res) < 21000;
    const s2 : u64 = sp_run(&TT50_N, &TT50_P, 262, false, 2, &SC_DV_M, &out, &res);
    assert sp_res_max(&res) > 50 * SP_RES_BOUND;
    assert sp_res_max(&res) < 160;
}

test the_wrong_tables_are_refused_by_the_time_check_not_by_the_sign_or_the_flip_point {
    // NEGATIVE CONTROLS. The comparator is symmetric, so ANY pair of tables decides the right way and has a flip point at zero: the sign and the flip
    // point cannot tell tt at 50 C from ss. The decision time can. The check is the bulk-tied deck's decision time at +2 mV (53.854 steps) to
    // 0.66 % and the resolution time (72.309) to 0.72 %: the tt50 run is 0.65 % and 0.63 % early and passes (the test above); each wrong pair fails.
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    // ss at 27 C (M3b's slow corner) in the tt 50 C run: 14.1 % late (decision), 11.5 % late (resolution); against the golden deck 7.5 % late, over
    // the 6.7 % bound of the true tables, by a margin that is small and is why the table reference is the bulk-tied deck.
    const s_ss : u64 = sp_run(&SS_N, &SS_P, SP_H[0], false, SC_K, &SC_DV_M, &out, &res);
    assert(sc_sign(&out));
    const fs : f64 = sp_rel(sp_first(&out), NG_R2B_FIRST[0]);
    const rs : f64 = sp_rel(sp_res(&out), NG_R2B_RES[0]);
    assert fs > 0.14;
    assert fs < 0.143;
    assert rs > 0.114;
    assert rs < 0.117;
    assert fs > 20.0 * 0.0066;
    assert sp_rel(sp_first(&out), NG_R2_FIRST[0]) > 0.067;
    assert sp_flip(&SS_N, &SS_P, &SC_DV_M) <= 2;
    // tt at 27 C in the 50 C run: the temperature is part of the table. 5.0 % early (decision), 6.0 % early (resolution): 7.5 and 8 times the bound.
    const s_27 : u64 = sp_run(&TT_N, &TT_P, SP_H[0], false, SC_K, &SC_DV_M, &out, &res);
    assert(sc_sign(&out));
    const f27 : f64 = sp_rel(sp_first(&out), NG_R2B_FIRST[0]);
    const r27 : f64 = sp_rel(sp_res(&out), NG_R2B_RES[0]);
    assert f27 < 0.0 - 0.048;
    assert f27 > 0.0 - 0.052;
    assert r27 < 0.0 - 0.058;
    assert r27 > 0.0 - 0.062;
    assert f27 * f27 > 7.0 * 0.0066 * 7.0 * 0.0066;
    // The two tables in each other's slots (the PMOS table for the NMOS): the sign is right, the decision is 20.7 % late.
    const s_sw : u64 = sp_run(&TT50_P, &TT50_N, SP_H[0], false, SC_K, &SC_DV_M, &out, &res);
    assert(sc_sign(&out));
    const fw : f64 = sp_rel(sp_first(&out), NG_R2B_FIRST[0]);
    assert fw > 0.205;
    assert fw < 0.21;
    // The inputs wired the wrong way round (swap) with the right tables: the sign check fails, as in M4b.
    const s_x : u64 = sp_run(&TT50_N, &TT50_P, SP_H[0], true, SC_K, &SC_DV_M, &out, &res);
    assert(!sc_sign(&out));
}

test the_four_main_runs_are_pinned {
    // The order-sensitive fold of all 1120 samples of each run (+2 mV and +0.5 mV, both orientations): any changed word of the tables, the solver or the
    // run changes a pin. The two orientations are different words because the circuit is mirror-symmetric only in real arithmetic.
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    const a : u64 = sp_run(&TT50_N, &TT50_P, SP_H[0], false, SC_K, &SC_DV_M, &out, &res);
    const b : u64 = sp_run(&TT50_N, &TT50_P, SP_H[0], true, SC_K, &SC_DV_M, &out, &res);
    const c : u64 = sp_run(&TT50_N, &TT50_P, SP_H[1], false, SC_K, &SC_DV_M, &out, &res);
    const d : u64 = sp_run(&TT50_N, &TT50_P, SP_H[1], true, SC_K, &SC_DV_M, &out, &res);
    assert_eq(a, 16485561492764736872);
    assert_eq(b, 17229961214508940637);
    assert_eq(c, 15843583760717418062);
    assert_eq(d, 5888890600074327155);
    // One unit changed in one table word of the tt 50 C NMOS table (Vgs = 0.5 V, Vds = 0.75 V) moves the pin.
    var t1 : [625]u32 = [0] ** 625;
    var i : usize = 0;
    while (i < 625) {
        t1[i] = TT50_N[i];
        i = i + 1;
    }
    t1[212] = t1[212] + 1;
    const e : u64 = sp_run(&t1, &TT50_P, SP_H[0], false, SC_K, &SC_DV_M, &out, &res);
    assert e != a;
}

test the_times_are_minus_one_where_no_output_reaches_half_the_supply {
    // Every run of the tests above reaches Vdd / 2 on the first output, so the "never" branch of sp_first was never taken. A run whose every sample
    // is zero has no rising crossing in any of the 141 samples of dp, dn or |dp - dn|: sc_t_first and sc_t_res return SC_NONE, sc_after_clock keeps it,
    // and both times are the -1.0 the comment promises. The value is the literal, not a read-back.
    var z : [1128]u32 = [0] ** 1128;
    var first : f64 = sp_first(&z);
    var resol : f64 = sp_res(&z);
    assert first == 0.0 - 1.0;
    assert resol == 0.0 - 1.0;
    assert first < 0.0;
    // A state that does cross is not -1.0: dp jumps from 0 to Vdd at the last sample only, so dp crosses Vdd / 2 half way through step 139 -> 140
    // (the level is exactly half of Vdd), i.e. at 139.5 steps from step 0, and the clock's 50 % point is step SC_R / 2 = 8: 131.5 steps after it.
    var vdd : u32 = VDD;
    z[(SC_N * SC_NN + SC_DP) as usize] = vdd;
    var after : f64 = sp_first(&z);
    assert after == 131.5;
    assert sp_res(&z) == 131.5;
}

test the_absolute_value_of_a_signed_integer_changes_only_the_negative_side {
    // sp_abs_i is the only caller-visible conversion of the flip point; its negative branch was never taken (the nominal flip is 0 or +2).
    var n5 : i64 = 0 - 5;
    var p5 : i64 = 5;
    var z : i64 = 0;
    var n_big : i64 = 0 - 140000;
    assert sp_abs_i(n5) == 5.0;
    assert sp_abs_i(p5) == 5.0;
    assert sp_abs_i(z) == 0.0;
    assert sp_abs_i(n_big) == 140000.0;
}

test the_mirrored_unequal_pair_moves_the_flip_point_to_the_other_side {
    // The pair of the test an_unequal_input_pair_moves_the_flip_point_as_ngspice_says with the roles exchanged: XM3 (gate VDN) at m = 35 and XM4 at
    // m = 36 favours dp, so dp wins at d = 0 and the flip is at a NEGATIVE differential: the other branch of sp_flip, bisecting on the swapped input.
    // The second source is the circuit's mirror symmetry: exchanging the halves changes the sign of the flip and nothing else, so the two flips
    // sum to the rounding of the fixed-point arithmetic, which at the nominal pair is at most 2 units (asserted above).
    var mm : [15]u32 = [0] ** 15;
    sc_mult_pair(36, 35, &mm);
    const fa : i64 = sp_flip(&TT50_N, &TT50_P, &mm);
    assert fa > 69000;
    assert !(sp_wins(&TT50_N, &TT50_P, &mm, 0, false));
    sc_mult_pair(35, 36, &mm);
    const fb : i64 = sp_flip(&TT50_N, &TT50_P, &mm);
    assert sp_wins(&TT50_N, &TT50_P, &mm, 0, false);
    assert fb < 0;
    assert fb < 0 - 69000;
    // The magnitude is the mirror of the first orientation's, to the rounding: at most 4 units (two steps of h) by the argument above. Measured
    // 2026-10-25 (a pin, not the argument): 70064 and -70062, one step of h apart.
    const sum : i64 = fa + fb;
    assert sp_abs_i(sum) <= 4.0;
    assert_eq(fa, 70064);
    assert_eq(fb, 0 - 70062);
    assert sp_abs_i(fb) > 69000.0;
    assert sp_abs_i(fb) < 71580.0;
    // The ngspice flip for m = 35 is 71580 units; the model is 2.1 % low, from the other side as well.
    const eb : f64 = (sp_abs_i(fb) - 71580.0) / 71580.0;
    assert eb < 0.0 - 0.0195;
    assert eb > 0.0 - 0.0225;
}
