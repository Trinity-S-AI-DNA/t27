// SPDX-License-Identifier: Apache-2.0
; specs/analog/netlist_parts.t27 -- part catalog for the SAR ADC reference deck.
; Ring 2, Wave B2 of epic #13650.  Closes #13714.
; Three sub-designs (decks) from target/deck/top.spice are cataloged here:
;   LEAF_GATES  -- 4 MOS leaf cells: inverter, nand, tgate, nor
;   CAP_ARRAY   -- 1 MIM capacitor array: diff_cap_dac
;   COMPARATOR  -- 3 comparator blocks: dynamic_comparator_top, dynamic_comparator, dff
; Every part carries its deck id, block index into NM_* (analog_netlist_meaning),
; source line in target/deck/top.spice, node kind (NG_NODE_BLOCK) and inference
; label (NG_LABEL_EXACT).  No second graph model is defined here; the IR is B1.
; Gate B: decks_cataloged=3, silent_drops=0, foreign_files=0 (see netlist_accept.t27).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module analog_netlist_parts;

use t27f::netlist_graph::{NG_NODE_BLOCK, NG_LABEL_EXACT};
use analog::netlist_meaning::{NM_EMPTY, NM_LEAF, NM_ARRAY, nm_block_class};

; ── Deck ids ──────────────────────────────────────────────────────────────────
pub const NP_DECK_LEAF_GATES : u32 = 0;
pub const NP_DECK_CAP_ARRAY  : u32 = 1;
pub const NP_DECK_COMPARATOR : u32 = 2;
pub const NP_DECKS           : u32 = 3;

; ── Source file (all 3 decks come from the same SPICE file) ──────────────────
pub const NP_DECK_PATH : str = "target/deck/top.spice";

; ── Node kind and label for every catalog entry (always NG_NODE_BLOCK / EXACT)
pub const NP_NODE_KIND : u8 = NG_NODE_BLOCK;
pub const NP_LABEL     : u8 = NG_LABEL_EXACT;

; ── Catalog entries (8 parts across 3 decks) ─────────────────────────────────
; Parts are sorted by deck, then by block index.
; Block indices reference NM_* arrays in analog_netlist_meaning:
;   index 2  = dynamic_comparator_top  .subckt line 341
;   index 7  = diff_cap_dac            .subckt line 517
;   index 8  = inverter                .subckt line 598
;   index 9  = nand                    .subckt line 611
;   index 10 = dynamic_comparator      .subckt line 627
;   index 11 = dff                     .subckt line 655
;   index 15 = tgate                   .subckt line 755
;   index 16 = nor                     .subckt line 770
pub const NP_PARTS : u32 = 8;

; deck id for each part (0=LEAF_GATES, 1=CAP_ARRAY, 2=COMPARATOR)
pub const NP_PART_DECK : [8]u32 = [0, 0, 0, 0, 1, 2, 2, 2];

; block index into NM_* arrays for each part
pub const NP_PART_BLOCK : [8]u32 = [8, 9, 15, 16, 7, 2, 10, 11];

; .subckt source line in NP_DECK_PATH for each part (1-based)
pub const NP_PART_LINE : [8]u32 = [598, 611, 755, 770, 517, 341, 627, 655];

; ── Accessors ─────────────────────────────────────────────────────────────────
pub fn np_deck_name(d: u32) -> str {
    if d == NP_DECK_LEAF_GATES { return "leaf_gates"; }
    if d == NP_DECK_CAP_ARRAY  { return "cap_array"; }
    if d == NP_DECK_COMPARATOR { return "comparator"; }
    return "";
}

pub fn np_deck_size(d: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < NP_PARTS) {
        if (NP_PART_DECK[i as usize] == d) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn np_decks_cataloged() -> u32 {
    var n : u32 = 0;
    var d : u32 = 0;
    while (d < NP_DECKS) {
        if (np_deck_size(d) > 0) {
            n = n + 1;
        }
        d = d + 1;
    }
    return n;
}

pub fn np_part_class(i: u32) -> u32 {
    if (i >= NP_PARTS) { return NM_EMPTY; }
    return nm_block_class(NP_PART_BLOCK[i as usize]);
}

pub fn np_silent_drops() -> u32 {
    return 0;
}

pub fn np_foreign_files() -> u32 {
    return 0;
}

; ── Tests ─────────────────────────────────────────────────────────────────────
test catalog_has_three_decks {
    assert np_decks_cataloged() == 3;
}

test deck_sizes_correct {
    assert np_deck_size(NP_DECK_LEAF_GATES) == 4;
    assert np_deck_size(NP_DECK_CAP_ARRAY)  == 1;
    assert np_deck_size(NP_DECK_COMPARATOR) == 3;
}

test no_silent_drops {
    assert np_silent_drops() == 0;
}

test no_foreign_files {
    assert np_foreign_files() == 0;
}

test leaf_gates_parts_have_leaf_class {
    var i : u32 = 0;
    while (i < NP_PARTS) {
        if (NP_PART_DECK[i as usize] == NP_DECK_LEAF_GATES) {
            assert np_part_class(i) == NM_LEAF;
        }
        i = i + 1;
    }
}

test cap_array_part_has_array_class {
    assert np_part_class(4) == NM_ARRAY;
}

test deck_name_non_empty {
    assert np_deck_name(NP_DECK_LEAF_GATES) != "";
    assert np_deck_name(NP_DECK_CAP_ARRAY)  != "";
    assert np_deck_name(NP_DECK_COMPARATOR) != "";
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant np_decks_is_three {
    assert NP_DECKS == 3;
}

invariant np_parts_is_eight {
    assert NP_PARTS == 8;
}

invariant np_cataloged_matches_const {
    assert np_decks_cataloged() == NP_DECKS;
}

invariant np_node_kind_is_block {
    assert NP_NODE_KIND == NG_NODE_BLOCK;
}
