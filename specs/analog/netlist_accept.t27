// SPDX-License-Identifier: Apache-2.0
; specs/analog/netlist_accept.t27 -- the acceptance checklist of the netlist constructor epic as functions.
; Refs #13653, epic #13650.
; Why. The epic's Success Criteria were a paragraph someone reads. Here each criterion is one row with its
; expected value, and each gate (A, B, C) is a function over measured numbers: it returns 0 for a pass or
; the set of failing rows. A missing measurement is a fail, never a pass.
; --
; The rows (index, name, expected, owning gates):
;   0 blocks_extracted     17   A . C    blocks of the reference deck the converter census lists
;   1 element_lines        247  A . C    element lines of the reference deck the census lists
;   2 silent_drops         0    A B C    lines neither listed nor refused with a line number
;   3 decks_cataloged      3    . B C    decks whose part catalog covers 100 percent of their blocks
;   4 presets_rendered     3    . . C    task presets rendered (explorer, explainer, report)
;   5 changed_pixels       0    . . C    visual regression against the blessed snapshots
;   6 stage_events         5    . . C    T27L stage events recorded in the report
;   7 foreign_files        0    A B C    files added in a non-t27 language
; A measurement is a [8]u32 in row order; NA_MISSING in a slot means "not measured".
; na_gate(g, m) is a bit set: bit i (value NA_BIT[i]) is set when row i is owned by gate g and its
; measurement is missing or unequal to the expected value. 0 means the gate passes. An unknown gate
; fails every row (NA_ALL). na_first_fail names the lowest failing row, na_fail_count counts them.
; --
; NOT claimed: this module measures nothing. The numbers come from the converter census, the catalog,
; the renderer and the visual-regression run; a caller that types a number by hand defeats the gate.
; Gate A also needs the token schema and this checklist's own tests to pass on the lab: that is a
; test-report row, not a row here. The expected 17 and 247 are measured: the block census run on the
; reference deck (external, pinned by hash) on 2026-11-14 listed 17 blocks and 247 element lines.
; The epic's derived table said 249; its 2 extra lines are `let` commands of the .control block,
; counted as inductors by their first letter.
; Every private helper carries the na_ prefix. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module analog_netlist_accept;

pub const NA_ROWS : u32 = 8;
pub const NA_GATES : u32 = 3;
pub const NA_GATE_A : u32 = 0;
pub const NA_GATE_B : u32 = 1;
pub const NA_GATE_C : u32 = 2;

pub const NA_BLOCKS : u32 = 0;
pub const NA_LINES : u32 = 1;
pub const NA_DROPS : u32 = 2;
pub const NA_DECKS : u32 = 3;
pub const NA_PRESETS : u32 = 4;
pub const NA_PIXELS : u32 = 5;
pub const NA_EVENTS : u32 = 6;
pub const NA_FOREIGN : u32 = 7;

pub const NA_MISSING : u32 = 65535;
pub const NA_ALL : u32 = 255;

pub const NA_NAMES : [8]str = ["blocks_extracted", "element_lines", "silent_drops", "decks_cataloged", "presets_rendered", "changed_pixels", "stage_events", "foreign_files"];
pub const NA_EXPECT : [8]u32 = [17, 247, 0, 3, 3, 0, 5, 0];
pub const NA_BIT : [8]u32 = [1, 2, 4, 8, 16, 32, 64, 128];

; which rows a gate owns, 1 = owned
pub const NA_OWN_A : [8]u32 = [1, 1, 1, 0, 0, 0, 0, 1];
pub const NA_OWN_B : [8]u32 = [0, 0, 1, 1, 0, 0, 0, 1];
pub const NA_OWN_C : [8]u32 = [1, 1, 1, 1, 1, 1, 1, 1];

pub fn na_row_name(row: u32) -> str {
    if row >= NA_ROWS {
        return "";
    }
    return NA_NAMES[row];
}

pub fn na_owns(gate: u32, row: u32) -> bool {
    if row >= NA_ROWS {
        return false;
    }
    if gate == NA_GATE_A {
        return NA_OWN_A[row] == 1;
    }
    if gate == NA_GATE_B {
        return NA_OWN_B[row] == 1;
    }
    if gate == NA_GATE_C {
        return NA_OWN_C[row] == 1;
    }
    return false;
}

; one row: true only when it was measured and equals the expected value
pub fn na_row_ok(row: u32, value: u32) -> bool {
    if row >= NA_ROWS {
        return false;
    }
    if value == NA_MISSING {
        return false;
    }
    return value == NA_EXPECT[row];
}

; the failing rows of a gate as a bit set; 0 = pass; an unknown gate fails all rows
pub fn na_gate(gate: u32, m: [8]u32) -> u32 {
    if gate >= NA_GATES {
        return NA_ALL;
    }
    var bad : u32 = 0;
    var i : u32 = 0;
    while i < NA_ROWS {
        if na_owns(gate, i) {
            if na_row_ok(i, m[i]) == false {
                bad = bad + NA_BIT[i];
            }
        }
        i = i + 1;
    }
    return bad;
}

pub fn na_pass(gate: u32, m: [8]u32) -> bool {
    return na_gate(gate, m) == 0;
}

; true when row is in a bit set returned by na_gate
pub fn na_in(set: u32, row: u32) -> bool {
    if row >= NA_ROWS {
        return false;
    }
    return (set / NA_BIT[row]) % 2 == 1;
}

pub fn na_fail_count(set: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < NA_ROWS {
        if na_in(set, i) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

; the name of the lowest failing row, "" when the set is empty
pub fn na_first_fail(set: u32) -> str {
    var i : u32 = 0;
    while i < NA_ROWS {
        if na_in(set, i) {
            return NA_NAMES[i];
        }
        i = i + 1;
    }
    return "";
}

test gate_a_passes_on_the_census_numbers_alone {
    var m : [8]u32 = [65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535];
    m[NA_BLOCKS] = 17;
    m[NA_LINES] = 247;
    m[NA_DROPS] = 0;
    m[NA_FOREIGN] = 0;
    assert na_gate(NA_GATE_A, m) == 0;
    assert na_pass(NA_GATE_A, m);
    assert na_fail_count(na_gate(NA_GATE_A, m)) == 0;
    let none : str = na_first_fail(0);
    assert none == "";
    var i : u32 = 0;
    while i < NA_ROWS {
        assert na_owns(NA_GATE_C, i);
        let unset : bool = NA_EXPECT[i] == NA_MISSING;
        assert unset == false;
        i = i + 1;
    }
}

test gate_a_fails_and_names_a_wrong_or_missing_row {
    var m : [8]u32 = [16, 65535, 0, 65535, 65535, 65535, 65535, 0];
    let bad : u32 = na_gate(NA_GATE_A, m);
    assert bad == 3;
    assert na_pass(NA_GATE_A, m) == false;
    assert na_fail_count(bad) == 2;
    let first : str = na_first_fail(bad);
    assert first == "blocks_extracted";
    m[NA_BLOCKS] = 17;
    let second : str = na_first_fail(na_gate(NA_GATE_A, m));
    assert second == "element_lines";
    m[NA_LINES] = 247;
    m[NA_DROPS] = 1;
    assert na_gate(NA_GATE_A, m) == 4;
}

test gate_b_passes_on_three_cataloged_decks_and_no_drops {
    var m : [8]u32 = [65535, 65535, 0, 3, 65535, 65535, 65535, 0];
    assert na_gate(NA_GATE_B, m) == 0;
    assert na_pass(NA_GATE_B, m);
    assert na_owns(NA_GATE_B, NA_BLOCKS) == false;
    assert na_owns(NA_GATE_B, NA_DECKS);
}

test gate_b_fails_on_two_decks_or_a_foreign_file {
    var m : [8]u32 = [17, 247, 0, 2, 3, 0, 5, 0];
    assert na_gate(NA_GATE_B, m) == 8;
    let name : str = na_first_fail(na_gate(NA_GATE_B, m));
    assert name == "decks_cataloged";
    m[NA_DECKS] = 3;
    m[NA_FOREIGN] = 1;
    assert na_gate(NA_GATE_B, m) == 128;
    m[NA_FOREIGN] = 65535;
    assert na_pass(NA_GATE_B, m) == false;
}

test gate_c_passes_only_on_all_eight_rows {
    var m : [8]u32 = [17, 247, 0, 3, 3, 0, 5, 0];
    assert na_gate(NA_GATE_C, m) == 0;
    assert na_pass(NA_GATE_C, m);
    assert na_pass(NA_GATE_A, m);
    assert na_pass(NA_GATE_B, m);
}

test gate_c_fails_on_one_changed_pixel_a_missing_row_or_an_unknown_gate {
    var m : [8]u32 = [17, 247, 0, 3, 3, 4, 5, 0];
    assert na_gate(NA_GATE_C, m) == 32;
    let name : str = na_first_fail(na_gate(NA_GATE_C, m));
    assert name == "changed_pixels";
    m[NA_PIXELS] = 0;
    m[NA_EVENTS] = 65535;
    assert na_gate(NA_GATE_C, m) == 64;
    var none : [8]u32 = [65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535];
    assert na_gate(NA_GATE_C, none) == 255;
    assert na_fail_count(na_gate(NA_GATE_C, none)) == 8;
    m[NA_EVENTS] = 5;
    assert na_gate(NA_GATES, m) == NA_ALL;
    assert na_pass(NA_GATES, m) == false;
    let off : str = na_row_name(NA_ROWS);
    assert off == "";
}
