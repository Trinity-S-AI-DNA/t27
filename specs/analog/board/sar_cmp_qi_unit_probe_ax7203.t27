// SPDX-License-Identifier: Apache-2.0
; specs/analog/board/sar_cmp_qi_unit_probe_ax7203.t27 -- ONE evaluator unit of the 27 C comparator with its NMOS table ROM, as a design for the ALINX AX7203: the resource probe of M3f phase 2a
; M3f of the analog emulation epic (#10486, issue #11380), PHASE 2a. This is not the comparator on the board (that is phase 2b: the solver, the top, the receipt). It is the smallest design that places
; and routes the unit of specs/analog/board/sar_cmp_qi_unit.t27 and the ROM of specs/analog/board/sar_cmp_qi_tab_n.t27 on the die at 100 MHz and says what one unit costs: LUT, FF, DSP48 and block RAM after routing, and
; the post-route Fmax. Nothing here is measured against the spec on the board; the unit's equality with the spec is the unit's own tests.
; -
; WHAT IT RUNS. The PLL of M0 (the 200 MHz oscillator on R4/T4 to 100 MHz) clocks a counter of 2048 clocks. At clock 1 of each period the unit is started on the device 2 of the comparator (an NMOS whose two
; channel ends are internal nodes, so every slice of the log table is in use) with the Jacobian wanted; the eight node voltages are registers that move at the end of each period (so that no logic of the unit
; is a constant to the tools); from clock 1024 the twenty stamps are asked for one at a time and every word is folded, with the channel ends, into a 64-bit register. The LED D15 (active low) shows a bit of that
; register: it keeps all of the unit's logic alive and is the only output. An evaluation is at most 674 clocks, so the period is long enough.
; WHAT IT DOES NOT SAY. Nothing about the comparator on the board, the solver, or speed. ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaSarCmpQiUnitProbe;

use fpga::rc_filter_ax7203;

pub const KIND : str = "board-cell";
pub const ID : str = "fpga/sar_cmp_qi_unit_probe_ax7203";
pub const REFERENCE : str = "specs/analog/board/sar_cmp_qi_unit.t27, specs/analog/board/sar_cmp_qi_tab_n.t27";
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";

/// The period of the probe's run, in clocks, and the clock at which the stamps are read.
pub const PERIOD : u32 = 2048;
pub const GO_AT : u32 = 1;
pub const READ_AT : u32 = 1024;
pub const MOVE_AT : u32 = 2000;
/// The device the probe evaluates: the NMOS of the comparator whose drain and source are both nodes (ap and net1).
pub const PROBE_DEV : u8 = 2;

/// A differential input buffer (the 200 MHz oscillator on R4/T4).
pub struct IbufdsOut { O: bool }
pub fn IBUFDS(I: bool, IB: bool) -> IbufdsOut {}

/// The table ROM of the NMOS unit (specs/analog/board/sar_cmp_qi_tab_n.t27, generated by `t27b verilog`): the words of the nine tables at the address, registered.
pub struct TabOut { w0: u32, w1: u32, w2: u32, w3: u32, w4: u32, w5: u32, w6: u32, qd: u32, qg: u32 }
pub fn FpgaSarCmpQiTabN(clk_: bool, addr: u16) -> TabOut {}

/// The evaluator unit (specs/analog/board/sar_cmp_qi_unit.t27, generated by `t27b verilog`).
pub struct UnitOut { o_taddr: u16, o_done: bool, o_hi: u32, o_lo: u32, o_rword: u64 }
pub fn FpgaSarCmpQiUnit(clk_: bool, i_go: bool, i_e: u8, i_jac: bool, i_nochg: bool, i_n0: u32, i_n1: u32, i_n2: u32, i_n3: u32, i_n4: u32, i_n5: u32, i_n6: u32, i_n7: u32, i_clk: u32, i_vdp: u32, i_vdn: u32, i_tw0: u32, i_tw1: u32, i_tw2: u32, i_tw3: u32, i_tw4: u32, i_tw5: u32, i_tw6: u32, i_tqd: u32, i_tqg: u32, i_sel: u8) -> UnitOut {}

; --- the pins in ---------------------------------------------------------------------------------------------
const clk200_p : bool = undefined;
const clk200_p_LOC : str = "R4";
const clk200_p_IOSTANDARD : str = "DIFF_SSTL15";
const clk200_n : bool = undefined;
const clk200_n_LOC : str = "T4";
const clk200_n_IOSTANDARD : str = "DIFF_SSTL15";

; --- the clock: M0's, unchanged --------------------------------------------------------------------------------
const clkbuf : IbufdsOut = IBUFDS(clk200_p, clk200_n);
const clkbuf_O_PERIOD_PS : u32 = 5000;
const pll : PllOut = PLLE2_ADV(clkbuf.O, pll.CLKFBOUT, false, false, 5.0, 0.01, 8, 1, 16, 0, "FALSE");
const gclk : BufgOut = BUFG(pll.CLKOUT0);
const gclk_O_PERIOD_PS : u32 = 10000;

const clk : bool = gclk.O;
const rst_n : bool = true;
const en : bool = true;

; --- the registers ---------------------------------------------------------------------------------------------
var cnt : u32 = 0;
var r_go : bool = false;
var r_sel : u8 = 0;
var r_n0 : u32 = 33554432;
var r_n1 : u32 = 33554432;
var r_n2 : u32 = 27000000;
var r_n3 : u32 = 33554432;
var r_n4 : u32 = 33554432;
var r_n5 : u32 = 8388608;
var r_n6 : u32 = 8388608;
var r_n7 : u32 = 33554432;
var r_chk : u64 = 0;

; --- the unit and its ROM: the unit asks the ROM for an address, the ROM answers two clocks later -------------------
const u : UnitOut = FpgaSarCmpQiUnit(clk, r_go, PROBE_DEV, true, false, r_n0, r_n1, r_n2, r_n3, r_n4, r_n5, r_n6, r_n7, 33554432, 20971520, 20000000, tab.w0, tab.w1, tab.w2, tab.w3, tab.w4, tab.w5, tab.w6, tab.qd, tab.qg, r_sel);
const tab : TabOut = FpgaSarCmpQiTabN(clk, u.o_taddr);

; --- the pin out: a register ---------------------------------------------------------------------------------------
pub var led_3 : bool = false;
const led_3_LOC : str = "D15";
const led_3_IOSTANDARD : str = "LVCMOS33";

/// The register a stamp word, a channel end and the unit's done flag are folded into: rotated by one, then exclusive-or'ed.
pub fn fold_word(sum: u64, w: u64, hi: u32, lo: u32) -> u64 {
    return ((sum << 1) | (sum >> 63)) ^ w ^ ((hi as u64) << 40) ^ ((lo as u64) << 48);
}

// Every var is read before it is written, so the test's order and the clock edge agree.
fn on_clock(u_o_done: bool, u_o_hi: u32, u_o_lo: u32, u_o_rword: u64) {
    led_3 = ((r_chk >> 17) & 1) == 1;
    cnt = cnt + 1;
    r_go = (cnt & (PERIOD - 1)) == GO_AT;
    if ((cnt & (PERIOD - 1)) >= READ_AT and (cnt & (PERIOD - 1)) < READ_AT + 20) {
        r_sel = ((cnt & (PERIOD - 1)) - READ_AT) as u8;
        if (u_o_done) { r_chk = fold_word(r_chk, u_o_rword, u_o_hi, u_o_lo); }
    }
    if ((cnt & (PERIOD - 1)) == MOVE_AT) {
        r_n0 = r_n0 + 4093;
        r_n1 = r_n1 - 1021;
        r_n2 = r_n2 + 7919;
        r_n3 = r_n3 - 2053;
        r_n4 = r_n4 + 3001;
        r_n5 = r_n5 + 811;
        r_n6 = r_n6 - 619;
        r_n7 = r_n7 + 1511;
    }
}

; --- the tests ---------------------------------------------------------------------------------------------------------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test the_probe_starts_the_unit_once_a_period_asks_for_the_twenty_stamps_and_moves_the_nodes_at_the_end {
    var gos : u32 = 0;
    var sels : [20]u32 = [0] ** 20;
    var moves : u32 = 0;
    var i : u32 = 0;
    const n0 : u32 = r_n0;
    while (i < 3 * PERIOD) {
        const before : u32 = r_n0;
        on_clock(true, 3, 8, 12345);
        if (r_go) { gos = gos + 1; }
        if ((cnt & (PERIOD - 1)) >= READ_AT and (cnt & (PERIOD - 1)) < READ_AT + 20) { sels[r_sel as usize] = sels[r_sel as usize] + 1; }
        if (r_n0 != before) { moves = moves + 1; }
        i = i + 1;
    }
    assert_eq(gos, 3);
    assert_eq(moves, 3);
    assert_eq(r_n0, n0 + 3 * 4093);
    var k : usize = 0;
    var covered : u32 = 0;
    while (k < 20) {
        if (sels[k] == 3) { covered = covered + 1; }
        k = k + 1;
    }
    assert_eq(covered, 20);
    // the fold depends on every word it is given
    assert fold_word(0, 5, 0, 0) != fold_word(0, 6, 0, 0);
    assert fold_word(1, 5, 0, 0) != fold_word(2, 5, 0, 0);
    assert fold_word(1, 5, 3, 0) != fold_word(1, 5, 4, 0);
    assert fold_word(1, 5, 3, 8) != fold_word(1, 5, 3, 9);
    assert_eq(PROBE_DEV, 2);
}
