// SPDX-License-Identifier: Apache-2.0
; specs/analog/board/sar_cmp_qi_tab_p.t27 -- the table ROM of a PMOS evaluator unit of the 27 C comparator on the ALINX AX7203
; M3f of the analog emulation epic (#10486, issue #11380), PHASE 2a. The same as specs/analog/board/sar_cmp_qi_tab_n.t27 for the PMOS: the seven slices of the log-domain current table (the slice 0 is TT_LG_P
; of mos_psp103_data.t27, the slices 1 .. 6 are VSB_P1 .. VSB_P6 of mos_psp103_vsb_data.t27) and the drain and gate charge tables (TT_QD_P, TT_QG_P), each a ROM function of this module that the build
; maps to block RAM and each read once a clock. See that file for the layout of the tables and the timing. ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaSarCmpQiTabP;

use analog::mos_psp103_data::{TT_LG_P, TT_QD_P, TT_QG_P};
use analog::mos_psp103_vsb_data::{VSB_P1, VSB_P2, VSB_P3, VSB_P4, VSB_P5, VSB_P6};

pub const KIND : str = "board-cell";
pub const ID : str = "fpga/sar_cmp_qi_tab_p";
pub const REFERENCE : str = "specs/analog/mos_psp103_data.t27 (TT_LG_P, TT_QD_P, TT_QG_P), specs/analog/mos_psp103_vsb_data.t27 (VSB_P1 .. VSB_P6)";
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";

// No asynchronous reset and no enable (see the NMOS ROM).
const rst_n : bool = true;
const en : bool = true;

pub var w0 : u32 = 0;
pub var w1 : u32 = 0;
pub var w2 : u32 = 0;
pub var w3 : u32 = 0;
pub var w4 : u32 = 0;
pub var w5 : u32 = 0;
pub var w6 : u32 = 0;
pub var qd : u32 = 0;
pub var qg : u32 = 0;

// A table is read only at an address inside it (see the NMOS ROM).
fn on_clock(addr: u16) {
    if (addr < 4851) {
        w0 = TT_LG_P[addr as usize];
        w1 = VSB_P1[addr as usize];
        w2 = VSB_P2[addr as usize];
        w3 = VSB_P3[addr as usize];
        w4 = VSB_P4[addr as usize];
        w5 = VSB_P5[addr as usize];
        w6 = VSB_P6[addr as usize];
    }
    if (addr < 625) {
        qd = TT_QD_P[addr as usize];
        qg = TT_QG_P[addr as usize];
    }
}

; --- the tests ---------------------------------------------------------------------------------------------------------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test the_rom_answers_every_table_word_of_the_pmos_at_the_address_it_was_given {
    var a : u16 = 0;
    var checked : u32 = 0;
    while (a < 4851) {
        on_clock(a);
        assert_eq(w0, TT_LG_P[a as usize]);
        assert_eq(w1, VSB_P1[a as usize]);
        assert_eq(w2, VSB_P2[a as usize]);
        assert_eq(w3, VSB_P3[a as usize]);
        assert_eq(w4, VSB_P4[a as usize]);
        assert_eq(w5, VSB_P5[a as usize]);
        assert_eq(w6, VSB_P6[a as usize]);
        if (a < 625) {
            assert_eq(qd, TT_QD_P[a as usize]);
            assert_eq(qg, TT_QG_P[a as usize]);
        }
        checked = checked + 1;
        a = a + 16;
    }
    on_clock(4850);
    assert_eq(w0, TT_LG_P[4850]);
    assert_eq(w6, VSB_P6[4850]);
    on_clock(0);
    assert_eq(w0, 4294967295);
    assert_eq(w6, 4294967295);
    assert checked > 300;
    on_clock(2000);
    assert w1 < w0;
    assert w6 < w1;
}

test a_mutant_pmos_rom_register_with_one_flipped_bit_is_caught_by_the_word_compare {
    // NEGATIVE CONTROL. At every address of the stride the ROM answers, the register w3 holds the slice 3 word and the compare of the test above passes it; then the register is set to what a mutant ROM would hold,
    // the same word with its lowest bit flipped, and the compare must refuse it at every one of the addresses, the tag word and the rv words included (a flipped bit is a different word wherever it is).
    var a : u16 = 0;
    var caught : u32 = 0;
    var seen : u32 = 0;
    while (a < 4851) {
        on_clock(a);
        assert w3 == VSB_P3[a as usize];
        w3 = w3 ^ 1;
        if (w3 != VSB_P3[a as usize]) { caught = caught + 1; }
        seen = seen + 1;
        a = a + 16;
    }
    assert caught > 300;
    assert_eq(caught, seen);
}
