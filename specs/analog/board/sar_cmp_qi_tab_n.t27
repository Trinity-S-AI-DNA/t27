// SPDX-License-Identifier: Apache-2.0
; specs/analog/board/sar_cmp_qi_tab_n.t27 -- the table ROM of an NMOS evaluator unit of the 27 C comparator on the ALINX AX7203
; M3f of the analog emulation epic (#10486, issue #11380), PHASE 2a. The unit (specs/analog/board/sar_cmp_qi_unit.t27) holds no table: this module is the ROM it reads, one instance for each unit (or
; one for several, when a top shares it between units). It answers the address it was given with, one clock later and registered, the word of every table the unit can ask for at that address:
; the seven slices of the log-domain current table of the NMOS (the slice 0 is TT_LG_N of mos_psp103_data.t27, the slices 1 .. 6 are VSB_N1 .. VSB_N6 of mos_psp103_vsb_data.t27: Vsb = 0, 0.25, ..
; 1.5 V) and the drain and gate charge tables (TT_QD_N, TT_QG_N). The tables are not copied here: they come in by `use` and `t27b verilog` writes each as a ROM function of this module, which the
; build maps to block RAM (the `setattr ram_style block` of the build recipe, docs/analog/board-sar-cmp-unit-2026-10-20.md). Each table is read ONCE a clock: two reads of one table in one clock
; would be two ROMs. The log tables are 4851 words (the tag word, 4753 log words at 1 + 49 cx + cy, 97 rv words from 4754) and the charge tables 625 (25 cx + cy); an address past a table's end
; has no meaning for it and the word the ROM gives there is not used.
; WHAT IT DOES NOT SAY. Nothing about the tables themselves: they are the spec's. ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaSarCmpQiTabN;

use analog::mos_psp103_data::{TT_LG_N, TT_QD_N, TT_QG_N};
use analog::mos_psp103_vsb_data::{VSB_N1, VSB_N2, VSB_N3, VSB_N4, VSB_N5, VSB_N6};

pub const KIND : str = "board-cell";
pub const ID : str = "fpga/sar_cmp_qi_tab_n";
pub const REFERENCE : str = "specs/analog/mos_psp103_data.t27 (TT_LG_N, TT_QD_N, TT_QG_N), specs/analog/mos_psp103_vsb_data.t27 (VSB_N1 .. VSB_N6)";
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";

// No asynchronous reset and no enable: the ROM answers on every edge, and its output registers are the ones a block RAM merges.
const rst_n : bool = true;
const en : bool = true;

pub var w0 : u32 = 0;
pub var w1 : u32 = 0;
pub var w2 : u32 = 0;
pub var w3 : u32 = 0;
pub var w4 : u32 = 0;
pub var w5 : u32 = 0;
pub var w6 : u32 = 0;
pub var qd : u32 = 0;
pub var qg : u32 = 0;

// A table is read only at an address inside it: past its end the register keeps its word (the ROM's read enable is the comparison), so that a log table's address does not index a charge table.
fn on_clock(addr: u16) {
    if (addr < 4851) {
        w0 = TT_LG_N[addr as usize];
        w1 = VSB_N1[addr as usize];
        w2 = VSB_N2[addr as usize];
        w3 = VSB_N3[addr as usize];
        w4 = VSB_N4[addr as usize];
        w5 = VSB_N5[addr as usize];
        w6 = VSB_N6[addr as usize];
    }
    if (addr < 625) {
        qd = TT_QD_N[addr as usize];
        qg = TT_QG_N[addr as usize];
    }
}

; --- the tests ---------------------------------------------------------------------------------------------------------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test the_rom_answers_every_table_word_of_the_nmos_at_the_address_it_was_given {
    // the words of the nine tables at 300 addresses of the log tables' range (and the charge tables' own 625 below them): the first words, the tag, the rv words at the end, and a stride over the rest
    var a : u16 = 0;
    var checked : u32 = 0;
    while (a < 4851) {
        on_clock(a);
        assert_eq(w0, TT_LG_N[a as usize]);
        assert_eq(w1, VSB_N1[a as usize]);
        assert_eq(w2, VSB_N2[a as usize]);
        assert_eq(w3, VSB_N3[a as usize]);
        assert_eq(w4, VSB_N4[a as usize]);
        assert_eq(w5, VSB_N5[a as usize]);
        assert_eq(w6, VSB_N6[a as usize]);
        if (a < 625) {
            assert_eq(qd, TT_QD_N[a as usize]);
            assert_eq(qg, TT_QG_N[a as usize]);
        }
        checked = checked + 1;
        a = a + 16;
    }
    on_clock(4850);
    assert_eq(w0, TT_LG_N[4850]);
    assert_eq(w6, VSB_N6[4850]);
    on_clock(0);
    // the tag word of a log table, and the origin of a charge table
    assert_eq(w0, 4294967295);
    assert_eq(w6, 4294967295);
    assert_eq(qd, 2097152);
    assert checked > 300;
    // the slices are different tables: the body effect lowers the log word of the current at one node from one slice to the next
    on_clock(2000);
    assert w1 < w0;
    assert w6 < w1;
}
