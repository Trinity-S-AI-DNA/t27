pub const OP_CGDOL_AF : f64 = 569.0;
/// The two-port the drivers of an idle bit hang on Bit and Bit_n (sar_kick_cnode.cir, 50 C, both ports at 0.75 V): the currents ngspice printed in the sources VPB and VNB (A, volts are 1),
/// real and imaginary, as printed: port 1 excited (i(vpb) re, im, i(vnb) re, im), then port 2 excited; 100 MHz, then 300 MHz. The current into the network is minus the printed one.
pub const Y_I100 : [8]f64 = [-7.7334126e-04, -1.6094823e-05, 3.86570209e-04, -2.0072801e-06, 3.86570200e-04, -2.0072794e-06, -3.8667660e-04, -8.0481677e-06];
pub const Y_I300 : [8]f64 = [-7.7409205e-04, -4.8192037e-05, 3.86147488e-04, -5.9923287e-06, 3.86147408e-04, -5.9923193e-06, -3.8709942e-04, -2.4114984e-05];
; --- END PINNED DATA ---------------------------------------------------------------------------------------------------------------------------

; --- derived constants ------------------------------------------------------------------------------------------------------------------
/// pi.
pub const PI_F : f64 = 3.141592653589793;
/// A current-table entry in amperes: an entry is Id * 200 V/A * 2^-24 V units (M3b), so 1 / (200 * 2^24) A.
pub const I_UNIT_A : f64 = 0.000000000298023223876953125;
/// The latch's own offset: the decision is "above" when VDP - VDN + off > 0 (M4b-psp), V.
pub const LATCH_OFF_V : f64 = 0.000153;
/// The aperture table has 16 rows: the steps at 3.0 ns + 0.125 ns j after clkc crosses 0.1 V.
pub const AP_N : usize = 16;
pub const AP_TAU0 : f64 = 3.0;
pub const AP_DTAU : f64 = 0.125;

pub fn clampf(x: f64, lo: f64, hi: f64) -> f64 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

/// The wave v at the fractional sample kf, linear between samples.
pub fn at(v: []const f64, kf: f64) -> f64 {
    const i : usize = kf as usize;
    const f : f64 = kf - (i as f64);
    return v[i] * (1.0 - f) + v[i + 1] * f;
}

; --- the comparator's charge pulse, from the tables ------------------------------------------------------------------------------------
/// The gate charge of the pair (36 devices) in fC at the source Vs and the drain Vd, from one of the three tables (M3a's bilinear reader on the 25 x 25 grid: the source axis has
/// cells of 31.25 mV, so it is read at 2 Vs, the drain axis at Vd); the table's origin is the gate at 0.742 V and the source and drain at ground.
pub fn qtab_fc(tab: []const u32, vs: f64, vd: f64) -> f64 {
    const s : f64 = clampf(vs, 0.0, 0.75) * 2.0 * SCALE;
    const d : f64 = clampf(vd, 0.0, 1.5) * SCALE;
    return idf(tab, s, d) * QG_UNIT_FC * M_PAIR;
}

/// The charge the pair's gates take from the plates since sample 0 at each sample, fC, from the gate-charge table `tab` read along the waves n1 and ap (67 samples each).
pub fn pulse_dq(tab: []const u32, n1: []const f64, ap: []const f64, dq: []f64) {
    const q0 : f64 = qtab_fc(tab, n1[0], ap[0]);
    var k : usize = 0;
    while (k < NS) {
        dq[k] = qtab_fc(tab, n1[k], ap[k]) - q0;
        k = k + 1;
    }
}

/// The same pulse from M3c's table (TT_QG_N: bulk at the source, 27 C, axes Vgs and Vds), the negative control: its origin is Vgs = Vds = 0, the gate at 0.742 V.
pub fn pulse_dq_m3c(n1: []const f64, ap: []const f64, dq: []f64) {
    const q0 : f64 = idf(&TT_QG_N, clampf(VG_PLATES - n1[0], 0.0, 1.5) * SCALE, clampf(ap[0] - n1[0], 0.0, 1.5) * SCALE) * QG_UNIT_FC * M_PAIR;
    var k : usize = 0;
    while (k < NS) {
        const q : f64 = idf(&TT_QG_N, clampf(VG_PLATES - n1[k], 0.0, 1.5) * SCALE, clampf(ap[k] - n1[k], 0.0, 1.5) * SCALE) * QG_UNIT_FC * M_PAIR;
        dq[k] = q - q0;
        k = k + 1;
    }
}

/// The pair's gate capacitance in fF at sample k: dQ_G / dVg across the two tables at 0.717 and 0.767 V, 50 mV apart.
pub fn cgg_at(n1: []const f64, ap: []const f64, k: usize) -> f64 {
    return (qtab_fc(&QG_HI, n1[k], ap[k]) - qtab_fc(&QG_LO, n1[k], ap[k])) / QG_DVG;
}

/// The gate capacitance the network carries, fF: the average of cgg over the pulse, weighted by the charge each interval puts in (the intervals from the sample at or before the
/// 0.1 V crossing t01k to the one after the 0.75 V crossing t075k), because the matrix of M1's step is one constant matrix while the gate's capacitance falls as the source and
/// drain move.
pub fn cgg_pulse(dq: []const f64, n1: []const f64, ap: []const f64, t01k: f64, t075k: f64) -> f64 {
    var num : f64 = 0.0;
    var den : f64 = 0.0;
    var i : usize = t01k as usize;
    const i2 : usize = (t075k as usize) + 1;
    while (i < i2) {
        const w : f64 = dq[i + 1] - dq[i];
        num = num + w * (cgg_at(n1, ap, i) + cgg_at(n1, ap, i + 1)) / 2.0;
        den = den + w;
        i = i + 1;
    }
    return num / den;
}

; --- the drivers, from the tables and the idle two-port ----------------------------------------------------------------------------------
/// The on-resistance (ohm) of a device conducting at a rail with its gate at the other: the table's Id(Vgs = vg, Vds) at Vds = h and 2 h (h = 62.5 mV) gives the slope
/// at Vds = 0 by a quadratic through the origin, a = (4 I1 - I2) / (2 h): the chord of the first cell would read the triode curve 1.7 percent soft.
pub fn r_tangent(t: []const u32, vg: f64) -> f64 {
    const h : f64 = 0.0625;
    const i1 : f64 = idf(t, vg * SCALE, h * SCALE) * I_UNIT_A;
    const i2 : f64 = idf(t, vg * SCALE, 2.0 * h * SCALE) * I_UNIT_A;
    return 2.0 * h / (4.0 * i1 - i2);
}

/// The inverter's nmos holding its output at ground (gate 1.5 V), 50 C: ohm. XM2 of the golden inverter, W 1.0 um.
pub fn r_inv_n() -> f64 {
    return r_tangent(&TT50_N, 1.5);
}

/// The inverter's pmos holding its output at the rail (gate 0 V), 50 C: ohm. XM1, W 3.0 um.
pub fn r_inv_p() -> f64 {
    return r_tangent(&TT50_P, 1.5);
}

/// The resistance of a moved plate's driver (ohm): the P half's inverter, UP through the pmos, DOWN through the nmos. The N half's plate is behind the inverter x12 and then the
/// tgate x15, which at a rail is one device of the same size again: twice that, see n_drive.
pub fn p_drive(mode: u8) -> f64 {
    if (mode == DR_UP) { return r_inv_p(); }
    return r_inv_n();
}

pub fn n_drive(mode: u8) -> f64 {
    return 2.0 * p_drive(mode);
}

/// A real part of the two-port, microsiemens: minus the printed current, volts being 1.
pub fn y_g(a: []const f64, idx: usize) -> f64 {
    return (0.0 - a[idx]) * 1000000.0;
}

/// An imaginary part of the two-port as a capacitance in fF: Im Y / (2 pi f).
pub fn y_c(a: []const f64, idx: usize, f_hz: f64) -> f64 {
    return (0.0 - a[idx]) / (2.0 * PI_F * f_hz) * 1000000000000000.0;
}

/// The idle bit's conductance matrix at its two plate nodes (Bit_k, Bit_k_n), microsiemens: [0] G11, [1] G12 (negative), [2] G22.
pub fn idle_g(i: usize) -> f64 {
    if (i == 0) { return y_g(&Y_I100, 0); }
    if (i == 1) { return (y_g(&Y_I100, 2) + y_g(&Y_I100, 4)) / 2.0; }
    return y_g(&Y_I100, 6);
}

/// The idle bit's capacitance matrix, fF: [0] C11, [1] C12, [2] C22, at 100 MHz.
pub fn idle_c(i: usize) -> f64 {
    if (i == 0) { return y_c(&Y_I100, 1, 100000000.0); }
    if (i == 1) { return (y_c(&Y_I100, 3, 100000000.0) + y_c(&Y_I100, 5, 100000000.0)) / 2.0; }
    return y_c(&Y_I100, 7, 100000000.0);
}

/// The moved bit's two-port at its two plate nodes: dir 0 (the P plate UP) or 1 (DOWN). Its conductances, microsiemens: [0] G11, [1] G12, [2] G22.
pub fn moved_g(dir: usize, i: usize) -> f64 {
    const o : usize = 8 * dir;
    if (i == 0) { return y_g(&Y_MV100, o); }
    if (i == 1) { return (y_g(&Y_MV100, o + 2) + y_g(&Y_MV100, o + 4)) / 2.0; }
    return y_g(&Y_MV100, o + 6);
}

/// The moved bit's capacitance matrix, fF at 100 MHz: [0] C11 (Bit to ground), [1] C12 (a normal coupling capacitor shows as a negative entry), [2] C22 (Bit_n).
pub fn moved_c(dir: usize, i: usize) -> f64 {
    const o : usize = 8 * dir;
    if (i == 0) { return y_c(&Y_MV100, o + 1, 100000000.0); }
    if (i == 1) { return (y_c(&Y_MV100, o + 3, 100000000.0) + y_c(&Y_MV100, o + 5, 100000000.0)) / 2.0; }
    return y_c(&Y_MV100, o + 7, 100000000.0);
}

/// The tgate x11 between Bit and Bit_n, ohm: 1 / -Re Y12.
pub fn r_x11() -> f64 {
    return 1000000.0 / (0.0 - idle_g(1));
}

/// The tgate x2 that holds Bit at VCM, ohm: 1 / (Re Y11 + Re Y12).
pub fn r_x2() -> f64 {
    return 1000000.0 / (idle_g(0) + idle_g(1));
}

; --- the network ------------------------------------------------------------------------------------------------------------------------
/// Add the admittance y between nodes a and b (either may be GND) to the NMAX x NMAX matrix m.
pub fn stamp_y(m: []f64, a: usize, b: usize, y: f64) {
    if (a != GND) { m[a * NMAX + a] = m[a * NMAX + a] + y; }
    if (b != GND) { m[b * NMAX + b] = m[b * NMAX + b] + y; }
    if (a != GND && b != GND) {
        m[a * NMAX + b] = m[a * NMAX + b] - y;
        m[b * NMAX + a] = m[b * NMAX + a] - y;
    }
}

/// A capacitor y from node a to a plate whose voltage is minus node b's (an ideal source 1.5 V - Vb): the current into a is y d(Va + Vb) / dt, and b feels nothing.
pub fn stamp_follow(m: []f64, a: usize, b: usize, y: f64) {
    m[a * NMAX + a] = m[a * NMAX + a] + y;
    m[a * NMAX + b] = m[a * NMAX + b] + y;
}

/// The conductance (G) and capacitance (C) matrices of the plate network. Nodes: 0 VDP, 1 net1 of the P half, 2 VDN, 3 net1 of the N half, then Bit_k = 4 + 3 k, Bit_k_n = 5 + 3 k and the
/// P plate behind its series resistor = 6 + 3 k, k = 0 .. 9 (plate k has UNITS[k] units on the side SIDE[k]: 1 is the top plate, 0 is net1, behind the one-unit bridge).
/// kp, kn: the mode of each plate (DR_*). rs: the resistor between each idle P plate and its Bit node (0 for none). cgg: the gate capacitance on each top plate, fF.
/// para: stamp the capacitances of the idle bit's two-port. gs: a factor on its conductances (1 for the measured two-port).
pub fn build(kp: []const u8, kn: []const u8, rs: f64, cgg: f64, para: bool, gs: f64, g: []f64, c: []f64) {
    var i : usize = 0;
    while (i < NSQ) {
        g[i] = 0.0;
        c[i] = 0.0;
        i = i + 1;
    }
    stamp_y(c, 0, 1, C_UNIT_FF);
    stamp_y(c, 2, 3, C_UNIT_FF);
    stamp_y(c, 0, GND, C_EXPLICIT_FF + cgg);
    stamp_y(c, 2, GND, C_EXPLICIT_FF + cgg);
    var k : usize = 0;
    while (k < PLATES) {
        const cu : f64 = (UNITS[k] as f64) * C_UNIT_FF;
        var tp : usize = 1;
        var tn : usize = 3;
        if (SIDE[k] == 1) {
            tp = 0;
            tn = 2;
        }
        const bit : usize = 4 + 3 * k;
        const bnl : usize = bit + 1;
        const pr : usize = bit + 2;
        const pm : bool = kp[k] == DR_UP || kp[k] == DR_DOWN;
        const nm : bool = kn[k] == DR_UP || kn[k] == DR_DOWN;
        // the drivers: a moved plate is held through its inverter, an idle one is the measured two-port (x2 to VCM, x11 across)
        if (pm) { stamp_y(g, bit, GND, 1000000.0 / p_drive(kp[k])); }
        if (nm) { stamp_y(g, bnl, GND, 1000000.0 / n_drive(kn[k])); }
        if (!pm && !nm) {
            stamp_y(g, bit, GND, gs * (idle_g(0) + idle_g(1)));
            stamp_y(g, bit, bnl, gs * (0.0 - idle_g(1)));
            stamp_y(g, bnl, GND, gs * (idle_g(2) + idle_g(1)));
            if (para) {
                c[bit * NMAX + bit] = c[bit * NMAX + bit] + idle_c(0);
                c[bnl * NMAX + bnl] = c[bnl * NMAX + bnl] + idle_c(2);
                c[bit * NMAX + bnl] = c[bit * NMAX + bnl] + idle_c(1);
                c[bnl * NMAX + bit] = c[bnl * NMAX + bit] + idle_c(1);
            }
        }
        if (pm && nm && para) {
            // the moved bit's own capacitances (its conductances are the inverters' above)
            var dir : usize = 1;
            if (kp[k] == DR_UP) { dir = 0; }
            c[bit * NMAX + bit] = c[bit * NMAX + bit] + moved_c(dir, 0);
            c[bnl * NMAX + bnl] = c[bnl * NMAX + bnl] + moved_c(dir, 2);
            c[bit * NMAX + bnl] = c[bit * NMAX + bnl] + moved_c(dir, 1);
            c[bnl * NMAX + bit] = c[bnl * NMAX + bit] + moved_c(dir, 1);
        }
        if (pm && !nm) { stamp_y(g, bnl, bit, gs * (0.0 - idle_g(1))); }
        if (!pm && nm) { stamp_y(g, bit, GND, gs * (idle_g(0) + idle_g(1))); }
        // the P plate
        if (kp[k] == DR_MIRROR) {
            stamp_follow(c, tp, bnl, cu);
            stamp_y(g, pr, GND, G_SHORT);
        } else if (kp[k] == DR_IDEAL) {
            stamp_y(c, tp, GND, cu);
            stamp_y(g, pr, GND, G_SHORT);
        } else {
            stamp_y(c, tp, pr, cu);
            if (kp[k] == DR_IDLE && rs > 0.0) {
                stamp_y(g, pr, bit, 1000000.0 / rs);
            } else {
                stamp_y(g, pr, bit, G_SHORT);
            }
        }
        // the N plate
        if (kn[k] == DR_MIRROR) {
            stamp_follow(c, tn, bit, cu);
        } else if (kn[k] == DR_IDEAL) {
            stamp_y(c, tn, GND, cu);
        } else {
            stamp_y(c, tn, bnl, cu);
        }
        k = k + 1;
    }
}

; --- the solve: Gauss-Jordan with partial pivoting, n up to 34 (M1's own derivation is capped at 5 unknowns) -----------------------------------------
/// Fill the work matrix [A | C / dt | b] and reduce A to the identity: the rest of each row becomes A^-1 [C / dt | b], that is M and N of M1's x' = M x + N u. A = G + C / dt; the input
/// is the charge u (fC) that a step takes out of the two top plates: b = (e_VDP + e_VDN) / dt, or the plate VDP's alone (bsel 1) or VDN's alone (bsel 2).
pub fn solve_mn(n: usize, g: []const f64, c: []const f64, h: f64, aug: []f64, bsel: usize) {
    var i : usize = 0;
    var j : usize = 0;
    while (i < n) {
        j = 0;
        while (j < n) {
            aug[i * WA + j] = g[i * NMAX + j] + c[i * NMAX + j] / h;
            aug[i * WA + n + j] = c[i * NMAX + j] / h;
            j = j + 1;
        }
        aug[i * WA + 2 * n] = 0.0;
        if ((i == 0 && bsel != 2) || (i == 2 && bsel != 1)) { aug[i * WA + 2 * n] = 1.0 / h; }
        i = i + 1;
    }
    var col : usize = 0;
    while (col < n) {
        var p : usize = col;
        var r : usize = col + 1;
        while (r < n) {
            if (fabs64(aug[r * WA + col]) > fabs64(aug[p * WA + col])) { p = r; }
            r = r + 1;
        }
        var k : usize = 0;
        if (p != col) {
            k = 0;
            while (k <= 2 * n) {
                const t : f64 = aug[col * WA + k];
                aug[col * WA + k] = aug[p * WA + k];
                aug[p * WA + k] = t;
                k = k + 1;
            }
        }
        const piv : f64 = aug[col * WA + col];
        k = col;
        while (k <= 2 * n) {
            aug[col * WA + k] = aug[col * WA + k] / piv;
            k = k + 1;
        }
        r = 0;
        while (r < n) {
            if (r != col) {
                const f : f64 = aug[r * WA + col];
                k = col;
                while (k <= 2 * n) {
                    aug[r * WA + k] = aug[r * WA + k] - f * aug[col * WA + k];
                    k = k + 1;
                }
            }
            r = r + 1;
        }
        col = col + 1;
    }
}

/// The largest |A X - R| over the n + 1 solved columns, relative to the largest entry of R in the column: a solve that did not solve shows here.
pub fn solve_residual(n: usize, g: []const f64, c: []const f64, h: f64, aug: []const f64) -> f64 {
    var worst : f64 = 0.0;
    var i : usize = 0;
    var col : usize = 0;
    var k : usize = 0;
    while (col <= n) {
        var scale : f64 = 0.0;
        i = 0;
        while (i < n) {
            var rhs : f64 = 0.0;
            if (col < n) { rhs = c[i * NMAX + col] / h; }
            if (col == n && (i == 0 || i == 2)) { rhs = 1.0 / h; }
            if (fabs64(rhs) > scale) { scale = fabs64(rhs); }
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            var rhs : f64 = 0.0;
            if (col < n) { rhs = c[i * NMAX + col] / h; }
            if (col == n && (i == 0 || i == 2)) { rhs = 1.0 / h; }
            var acc : f64 = 0.0 - rhs;
            k = 0;
            while (k < n) {
                acc = acc + (g[i * NMAX + k] + c[i * NMAX + k] / h) * aug[k * WA + n + col];
                k = k + 1;
            }
            if (scale > 0.0 && fabs64(acc) / scale > worst) { worst = fabs64(acc) / scale; }
            i = i + 1;
        }
        col = col + 1;
    }
    return worst;
}

/// M1's words: D = M - I and N at 2^-24, sign-magnitude, row-major n x n.
pub fn quantize(n: usize, aug: []const f64, d: []u32, nv: []u32) {
    var i : usize = 0;
    var j : usize = 0;
    while (i < n) {
        j = 0;
        while (j < n) {
            var m : f64 = aug[i * WA + n + j];
            if (i == j) { m = m - 1.0; }
            d[i * n + j] = q_sm(m);
            j = j + 1;
        }
        nv[i] = q_sm(aug[i * WA + 2 * n]);
        i = i + 1;
    }
}

; --- the run ---------------------------------------------------------------------------------------------------------------------------
/// The two top plates' voltage deviations at each of the NS samples, by M1's step (`sub` steps per sample; each takes the sample's charge increment / sub into both top plates).
pub fn run_q(n: usize, sub: usize, d: []const u32, nv: []const u32, dq: []const f64, vp: []f64, vn: []f64) {
    var x : [34]u32 = [0] ** 34;
    var y : [34]u32 = [0] ** 34;
    vp[0] = 0.0;
    vn[0] = 0.0;
    var k : usize = 1;
    while (k < NS) {
        const u : u32 = q_sm(0.0 - (dq[k] - dq[k - 1]) / (sub as f64));
        var s : usize = 0;
        while (s < sub) {
            step(n, d, nv, &x, u, &y);
            var i : usize = 0;
            while (i < n) {
                x[i] = y[i];
                i = i + 1;
            }
            s = s + 1;
        }
        vp[k] = sm_f64(x[0]);
        vn[k] = sm_f64(x[2]);
        k = k + 1;
    }
}

/// The same run in f64 with the unrounded M and N: x' = M x + N u, the reference the words are judged by.
pub fn run_f(n: usize, sub: usize, aug: []const f64, dq: []const f64, vp: []f64, vn: []f64) {
    var x : [34]f64 = [0.0] ** 34;
    var y : [34]f64 = [0.0] ** 34;
    vp[0] = 0.0;
    vn[0] = 0.0;
    var k : usize = 1;
    while (k < NS) {
        const u : f64 = 0.0 - (dq[k] - dq[k - 1]) / (sub as f64);
        var s : usize = 0;
        while (s < sub) {
            var i : usize = 0;
            while (i < n) {
                var acc : f64 = aug[i * WA + 2 * n] * u;
                var j : usize = 0;
                while (j < n) {
                    acc = acc + aug[i * WA + n + j] * x[j];
                    j = j + 1;
                }
                y[i] = acc;
                i = i + 1;
            }
            i = 0;
            while (i < n) {
                x[i] = y[i];
                i = i + 1;
            }
            s = s + 1;
        }
        vp[k] = x[0];
        vn[k] = x[2];
        k = k + 1;
    }
}

; --- the aperture and the decision --------------------------------------------------------------------------------------------------------
/// The share of the decision that the input still decides at row j of the aperture table `set`: the latch's response to a 1 mV step at 3.0 ns + 0.125 ns j after clkc crosses
/// 0.1 V over its response to a step before the edge, each less the unperturbed run's own small difference. Set 0 is the first decision with the gates on ideal sources
/// (sar_kick_aperture.cir); sets 1 and 2 are the late decisions of the sine run's first and second conversion (sar_kick_late_aperture.cir, sar_which 0 and 1).
pub fn ap_share(set: usize, j: usize) -> f64 {
    if (set == 0) {
        const base : f64 = LIN_DD[0] - LIN_DE[0];
        const g0 : f64 = (AP_DD0 - AP_DE0) - base;
        return ((AP_DD[j] - AP_DE[j]) - base) / g0;
    }
    const s : usize = set - 1;
    const base : f64 = LAP_LIN_DD[3 * s] - LAP_LIN_DE[3 * s];
    const g0 : f64 = (LAP_DD0[s] - LAP_DE0[s]) - base;
    return ((LAP_DD[16 * s + j] - LAP_DE[16 * s + j]) - base) / g0;
}

/// What the decision reads of the plates' kick: the change of VDP - VDN since clkc crossed 0.1 V, weighed by the decision's share still open: each interval of the aperture table
/// carries (S_j - S_{j+1}) of the decision and is read at its middle.
pub fn kd_eff(vp: []const f64, vn: []const f64, t01k: f64, set: usize) -> f64 {
    const d0 : f64 = at(vp, t01k) - at(vn, t01k);
    var t : f64 = 0.0;
    var j : usize = 0;
    while (j + 1 < AP_N) {
        const kk : f64 = t01k + (AP_TAU0 + AP_DTAU * ((j as f64) + 0.5)) / SAMPLE_NS;
        t = t + (ap_share(set, j) - ap_share(set, j + 1)) * ((at(vp, kk) - at(vn, kk)) - d0);
        j = j + 1;
    }
    return t;
}

pub struct KickOut { dvdp: f64, dvdn: f64, off: f64 }

/// One run of the network: the modes of the plates, the series resistor, the gate capacitance, the options, the step count per sample, the charge pulse dq (fC at each sample) and
/// the sample positions of the two crossings of clkc and the aperture set. dvdp, dvdn: what the edge did to the two plates between clkc = 0.1 V and 0.75 V (V); off: the decision's offset, kd_eff plus
/// the latch's own (V).
pub fn net_run(kp: []const u8, kn: []const u8, rs: f64, cgg: f64, para: bool, gs: f64, sub: usize, dq: []const f64, t01k: f64, t075k: f64, set: usize) -> KickOut {
    var g : [1156]f64 = [0.0] ** 1156;
    var c : [1156]f64 = [0.0] ** 1156;
    var aug : [2346]f64 = [0.0] ** 2346;
    var d : [1156]u32 = [0] ** 1156;
    var nv : [34]u32 = [0] ** 34;
    var vp : [67]f64 = [0.0] ** 67;
    var vn : [67]f64 = [0.0] ** 67;
    build(kp, kn, rs, cgg, para, gs, &g, &c);
    solve_mn(NMAX, &g, &c, SAMPLE_NS / (sub as f64), &aug, 0);
    quantize(NMAX, &aug, &d, &nv);
    run_q(NMAX, sub, &d, &nv, dq, &vp, &vn);
    return KickOut { dvdp: at(&vp, t075k) - at(&vp, t01k), dvdn: at(&vn, t075k) - at(&vn, t01k), off: kd_eff(&vp, &vn, t01k, set) + LATCH_OFF_V };
}

pub fn fill_u8(a: []u8, m: u8) {
    var k : usize = 0;
    while (k < PLATES) {
        a[k] = m;
        k = k + 1;
    }
}

/// The pulse selectors of kick_with.
pub const PULSE_TABLE : u8 = 0;
pub const PULSE_NONE : u8 = 1;
pub const PULSE_M3C : u8 = 2;

/// A run with every P plate in mode mp and every N plate in mode mn: the six first-decision rows, the series resistor and the controls are all this.
pub fn kick_with(mp: u8, mn: u8, rs: f64, para: bool, gs: f64, sub: usize, pulse: u8) -> KickOut {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    fill_u8(&kp, mp);
    fill_u8(&kn, mn);
    var dq : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &WAVE_N1, &WAVE_AP, &dq);
    const cgg : f64 = cgg_pulse(&dq, &WAVE_N1, &WAVE_AP, T01_K, T075_K);
    if (pulse == PULSE_NONE) { fill_f64(&dq, 0.0); }
    if (pulse == PULSE_M3C) { pulse_dq_m3c(&WAVE_N1, &WAVE_AP, &dq); }
    return net_run(&kp, &kn, rs, cgg, para, gs, sub, &dq, T01_K, T075_K, 0);
}

pub fn fill_f64(a: []f64, v: f64) {
    var k : usize = 0;
    while (k < NS) {
        a[k] = v;
        k = k + 1;
    }
}

/// The first-decision experiment v of sar_kick.t27 (V_BASE .. V_PPLATE) as the network runs it. The tracking switch (V_IDEALSW) is not in the network: its row is the base circuit's.
/// The comparator isolated by buffers (V_NOKICK) has no charge pulse.
pub fn kick_row(v: usize) -> KickOut {
    if (v == V_PLATES) { return kick_with(DR_IDEAL, DR_IDEAL, 0.0, true, 1.0, SUB, PULSE_TABLE); }
    if (v == V_NPLATE) { return kick_with(DR_IDLE, DR_MIRROR, 0.0, true, 1.0, SUB, PULSE_TABLE); }
    if (v == V_PPLATE) { return kick_with(DR_MIRROR, DR_IDLE, 0.0, true, 1.0, SUB, PULSE_TABLE); }
    if (v == V_NOKICK) { return kick_with(DR_IDLE, DR_IDLE, 0.0, true, 1.0, SUB, PULSE_NONE); }
    return kick_with(DR_IDLE, DR_IDLE, 0.0, true, 1.0, SUB, PULSE_TABLE);
}

/// The P plates behind the resistor rs (ohm): the first decision's run.
pub fn kick_series(rs: f64) -> KickOut {
    return kick_with(DR_IDLE, DR_IDLE, rs, true, 1.0, SUB, PULSE_TABLE);
}

/// The resistance (ohm) at which the P plates' series resistor brings the derived first-decision offset down to the latch's own: bisection on 1300 .. 3900 ohm, where the derived
/// offset is above it at the first and below it at the second.
pub fn series_cross_ohm() -> f64 {
    var lo : f64 = 1300.0;
    var hi : f64 = 3900.0;
    var it : u32 = 0;
    while (it < 14) {
        const mid : f64 = (lo + hi) / 2.0;
        if (kick_series(mid).off > LATCH_OFF_V) { lo = mid; } else { hi = mid; }
        it = it + 1;
    }
    return (lo + hi) / 2.0;
}

/// The tgate at VCM from M3b's tables, ohm: the nmos (Vgs = 0.75 V) and the pmos (Vsg = 0.75 V) in parallel, each at Vds -> 0. The tables are for the source and bulk together (nmos) and the
/// n-well on the rail (pmos); the golden tgate has its nmos source at 0.75 V over a grounded bulk, so this leaves the body effect out.
pub fn r_tgate_tables() -> f64 {
    const gn : f64 = 1.0 / r_tangent(&TT50_N, 0.75);
    const gp : f64 = 1.0 / r_tangent(&TT50_P, 0.75);
    return 1.0 / (gn + gp);
}

/// How far the words of M1's step are from the f64 run of the same method, V: the largest |difference| of either top plate over the 67 samples, for the first-decision base circuit.
pub fn quant_err_v() -> f64 {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    var dq : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &WAVE_N1, &WAVE_AP, &dq);
    const cgg : f64 = cgg_pulse(&dq, &WAVE_N1, &WAVE_AP, T01_K, T075_K);
    var g : [1156]f64 = [0.0] ** 1156;
    var c : [1156]f64 = [0.0] ** 1156;
    var aug : [2346]f64 = [0.0] ** 2346;
    var d : [1156]u32 = [0] ** 1156;
    var nv : [34]u32 = [0] ** 34;
    var vp : [67]f64 = [0.0] ** 67;
    var vn : [67]f64 = [0.0] ** 67;
    var fp : [67]f64 = [0.0] ** 67;
    var fn_ : [67]f64 = [0.0] ** 67;
    build(&kp, &kn, 0.0, cgg, true, 1.0, &g, &c);
    solve_mn(NMAX, &g, &c, SAMPLE_NS / (SUB as f64), &aug, 0);
    quantize(NMAX, &aug, &d, &nv);
    run_q(NMAX, SUB, &d, &nv, &dq, &vp, &vn);
    run_f(NMAX, SUB, &aug, &dq, &fp, &fn_);
    var worst : f64 = 0.0;
    var k : usize = 0;
    while (k < NS) {
        if (fabs64(vp[k] - fp[k]) > worst) { worst = fabs64(vp[k] - fp[k]); }
        if (fabs64(vn[k] - fn_[k]) > worst) { worst = fabs64(vn[k] - fn_[k]); }
        k = k + 1;
    }
    return worst;
}

/// The residual of the solve for the first-decision base circuit (relative).
pub fn base_residual() -> f64 {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    var dq : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &WAVE_N1, &WAVE_AP, &dq);
    const cgg : f64 = cgg_pulse(&dq, &WAVE_N1, &WAVE_AP, T01_K, T075_K);
    var g : [1156]f64 = [0.0] ** 1156;
    var c : [1156]f64 = [0.0] ** 1156;
    var aug : [2346]f64 = [0.0] ** 2346;
    build(&kp, &kn, 0.0, cgg, true, 1.0, &g, &c);
    solve_mn(NMAX, &g, &c, SAMPLE_NS / (SUB as f64), &aug, 0);
    return solve_residual(NMAX, &g, &c, SAMPLE_NS / (SUB as f64), &aug);
}

; --- the late decisions: plates that have moved ------------------------------------------------------------------------------------------
/// The bit of decision i (0 = the first) of the golden sine's conversion cv (0 or 1): the latch decides "above" (bit 1, the P plate goes down) when D + off > 0, with D the pinned
/// VDP - VDN before the decision (sar_kick.t27, DEC_D) and the offset the first decision's at i = 0, the mean late one from 1 to 6 (every D there is more than 8 mV from it but the first conversion's
/// sixth) and each decision's own measured one from 7 on.
pub fn sine_bit(cv: usize, i: usize) -> u8 {
    var off : f64 = off_late_v();
    if (i == 0) { off = first_off(V_BASE); }
    if (i >= 7) { off = 0.0 - late_thr(i as u32).mid; }
    if (DEC_D[11 * cv + i] + off > 0.0) { return 1; }
    return 0;
}

/// The waves of window w of sar_kick_late.cir (w < LATE_NW), or those of the first-decision edge deck (w = LATE_NW), copied into n1 and ap.
pub fn window_waves(w: usize, n1: []f64, ap: []f64) {
    var k : usize = 0;
    while (k < NS) {
        if (w < LATE_NW) {
            n1[k] = LATE_N1[w * NS + k];
            ap[k] = LATE_AP[w * NS + k];
        } else {
            n1[k] = WAVE_N1[k];
            ap[k] = WAVE_AP[k];
        }
        k = k + 1;
    }
}

/// The sample position of the 0.1 V crossing of clkc in window w (the edge deck's when w = LATE_NW).
pub fn window_t01k(w: usize) -> f64 {
    if (w < LATE_NW) { return (LATE_TCB_NS[w] - LATE_TS_NS[w]) / SAMPLE_NS; }
    return T01_K;
}

/// The same for the 0.75 V crossing.
pub fn window_t075k(w: usize) -> f64 {
    if (w < LATE_NW) { return (LATE_TCC_NS[w] - LATE_TS_NS[w]) / SAMPLE_NS; }
    return T075_K;
}

/// The aperture set of window w: the late decisions of the first conversion (windows 1, 2) are set 1, those of the second (4, 5) set 2, the rest the first decision's.
pub fn window_set(w: usize) -> usize {
    if (w == 1 || w == 2) { return 1; }
    if (w == 4 || w == 5) { return 2; }
    return 0;
}

/// One run of the network with the plates in the modes kp, kn, driven by the comparator's edge of window w: its charge pulse and its pulse-weighted gate capacitance from the tables.
pub fn run_window(kp: []const u8, kn: []const u8, w: usize) -> KickOut {
    return run_window_opts(kp, kn, w, window_set(w), true);
}

/// The same with the aperture set and the bits' capacitances chosen: the controls.
pub fn run_window_opts(kp: []const u8, kn: []const u8, w: usize, set: usize, para: bool) -> KickOut {
    var n1 : [67]f64 = [0.0] ** 67;
    var ap : [67]f64 = [0.0] ** 67;
    window_waves(w, &n1, &ap);
    var dq : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &n1, &ap, &dq);
    const cgg : f64 = cgg_pulse(&dq, &n1, &ap, window_t01k(w), window_t075k(w));
    return net_run(kp, kn, 0.0, cgg, para, 1.0, SUB, &dq, window_t01k(w), window_t075k(w), set);
}

/// The plates of the decision with m plates moved (m = 9 for the tenth decision, 10 for the eleventh) of the golden sine's conversion cv: decision i moved plate 9 - i, the P plate
/// down (nmos of DAC_control's inverter) for bit 1 and up for bit 0, the N plate the other way behind x12 and x15; the others are idle.
pub fn late_modes(cv: usize, m: usize, kp: []u8, kn: []u8) {
    var i : usize = 0;
    while (i < m) {
        const k : usize = 9 - i;
        if (sine_bit(cv, i) == 1) {
            kp[k] = DR_DOWN;
            kn[k] = DR_UP;
        } else {
            kp[k] = DR_UP;
            kn[k] = DR_DOWN;
        }
        i = i + 1;
    }
}

/// The decision with m plates moved of conversion cv, with the comparator's edge of window w (LATE_NW: the first decision's edge deck).
pub fn late_kick(cv: usize, m: usize, w: usize) -> KickOut {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    late_modes(cv, m, &kp, &kn);
    return run_window(&kp, &kn, w);
}

/// The same with the aperture set and the bits' capacitances chosen.
pub fn late_kick_opts(cv: usize, m: usize, w: usize, set: usize, para: bool) -> KickOut {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    late_modes(cv, m, &kp, &kn);
    return run_window_opts(&kp, &kn, w, set, para);
}

/// The window of the decision with m plates moved of conversion cv in sar_kick_late.cir: clkc rises 10 and 11 (conversion 0), 21 and 22 (conversion 1) for m = 9 and 10; the first
/// decision (m = 0) is rise 1 and 12.
pub fn own_window(cv: usize, m: usize) -> usize {
    if (m == 0) { return 3 * cv; }
    if (m == 9) { return 3 * cv + 1; }
    return 3 * cv + 2;
}

/// The offset of the decision with m plates moved (9 or 10) of conversion cv, each with its own edge and its own aperture: what the network derives, V.
pub fn late_off(cv: usize, m: usize) -> f64 {
    return late_kick(cv, m, own_window(cv, m)).off;
}

/// The late offset the network derives: the mean of the four decisions with nine and ten plates moved of the golden sine's two conversions, V.
pub fn late_off_derived() -> f64 {
    return (late_off(0, 9) + late_off(0, 10) + late_off(1, 9) + late_off(1, 10)) / 4.0;
}

; --- the pair's two gates at their own levels (the extension the three gate-level tables allow) ------------------------------------------
/// The gate charge of the pair (fC) with its gate at vg (V): the three tables (0.717, 0.742, 0.767 V) interpolated linearly in vg, clamped to their range.
pub fn qtab_g(vg: f64, vs: f64, vd: f64) -> f64 {
    const qm : f64 = qtab_fc(&QG_MID, vs, vd);
    const x : f64 = clampf((vg - VG_PLATES) / QG_DVG_STEP, 0.0 - 1.0, 1.0);
    if (x >= 0.0) { return qm + x * (qtab_fc(&QG_HI, vs, vd) - qm); }
    return qm + x * (qm - qtab_fc(&QG_LO, vs, vd));
}

/// The charge a gate at vg takes from its plate since sample 0, fC, along the waves n1 and ap.
pub fn pulse_dq_g(n1: []const f64, ap: []const f64, vg: f64, dq: []f64) {
    const q0 : f64 = qtab_g(vg, n1[0], ap[0]);
    var k : usize = 0;
    while (k < NS) {
        dq[k] = qtab_g(vg, n1[k], ap[k]) - q0;
        k = k + 1;
    }
}

/// net_run with a pulse of its own for each top plate: dqp into VDP, dqn into VDN. The network is linear, so the two inputs are two runs of M1's step (one input each, bsel 1 and 2)
/// that add.
pub fn net_run2(kp: []const u8, kn: []const u8, rs: f64, cgg: f64, para: bool, sub: usize, dqp: []const f64, dqn: []const f64, t01k: f64, t075k: f64, set: usize) -> KickOut {
    var g : [1156]f64 = [0.0] ** 1156;
    var c : [1156]f64 = [0.0] ** 1156;
    var aug : [2346]f64 = [0.0] ** 2346;
    var d : [1156]u32 = [0] ** 1156;
    var nv : [34]u32 = [0] ** 34;
    var vpa : [67]f64 = [0.0] ** 67;
    var vna : [67]f64 = [0.0] ** 67;
    var vpb : [67]f64 = [0.0] ** 67;
    var vnb : [67]f64 = [0.0] ** 67;
    build(kp, kn, rs, cgg, para, 1.0, &g, &c);
    solve_mn(NMAX, &g, &c, SAMPLE_NS / (sub as f64), &aug, 1);
    quantize(NMAX, &aug, &d, &nv);
    run_q(NMAX, sub, &d, &nv, dqp, &vpa, &vna);
    solve_mn(NMAX, &g, &c, SAMPLE_NS / (sub as f64), &aug, 2);
    quantize(NMAX, &aug, &d, &nv);
    run_q(NMAX, sub, &d, &nv, dqn, &vpb, &vnb);
    var k : usize = 0;
    while (k < NS) {
        vpa[k] = vpa[k] + vpb[k];
        vna[k] = vna[k] + vnb[k];
        k = k + 1;
    }
    return KickOut { dvdp: at(&vpa, t075k) - at(&vpa, t01k), dvdn: at(&vna, t075k) - at(&vna, t01k), off: kd_eff(&vpa, &vna, t01k, set) + LATCH_OFF_V };
}

/// A run of the first decision's edge (the edge deck's waves) with the plates in modes mp, mn (every plate alike), the series resistor rs, and the pair's gates at 0.742 V + d / 2
/// (VDP) and 0.742 V - d / 2 (VDN): d is VDP - VDN before the edge.
pub fn kick_with_g(mp: u8, mn: u8, rs: f64, d: f64) -> KickOut {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    fill_u8(&kp, mp);
    fill_u8(&kn, mn);
    var dqm : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &WAVE_N1, &WAVE_AP, &dqm);
    const cgg : f64 = cgg_pulse(&dqm, &WAVE_N1, &WAVE_AP, T01_K, T075_K);
    var dqp : [67]f64 = [0.0] ** 67;
    var dqn : [67]f64 = [0.0] ** 67;
    pulse_dq_g(&WAVE_N1, &WAVE_AP, VG_PLATES + d / 2.0, &dqp);
    pulse_dq_g(&WAVE_N1, &WAVE_AP, VG_PLATES - d / 2.0, &dqn);
    return net_run2(&kp, &kn, rs, cgg, true, SUB, &dqp, &dqn, T01_K, T075_K, 0);
}

/// The modes and the resistor of the first-decision experiment v (V_BASE .. V_PPLATE) as kick_row runs them, at VDP - VDN = d.
pub fn kick_row_g(v: usize, d: f64) -> KickOut {
    if (v == V_PLATES) { return kick_with_g(DR_IDEAL, DR_IDEAL, 0.0, d); }
    if (v == V_NPLATE) { return kick_with_g(DR_IDLE, DR_MIRROR, 0.0, d); }
    if (v == V_PPLATE) { return kick_with_g(DR_MIRROR, DR_IDLE, 0.0, d); }
    return kick_with_g(DR_IDLE, DR_IDLE, 0.0, d);
}

/// The offset of experiment v with the plates at the D the decision itself flips at: the fixed point of d = -off, from d = 0 in four steps (each moves it by a tenth of the last).
pub fn off_row_g(v: usize) -> f64 {
    var d : f64 = 0.0;
    var i : u32 = 0;
    while (i < 4) {
        d = 0.0 - kick_row_g(v, d).off;
        i = i + 1;
    }
    return 0.0 - d;
}

/// The decision with m plates moved of conversion cv, with the edge of window w and the gates at the plates' own voltages in that window (the sine run's, pinned).
pub fn late_kick_g(cv: usize, m: usize, w: usize) -> KickOut {
    return late_kick_gv(cv, m, w, LATE_VP_V[w], LATE_VN_V[w]);
}

/// The same with the gates at vgp (VDP's) and vgn (VDN's).
pub fn late_kick_gv(cv: usize, m: usize, w: usize, vgp: f64, vgn: f64) -> KickOut {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    late_modes(cv, m, &kp, &kn);
    var n1 : [67]f64 = [0.0] ** 67;
    var ap : [67]f64 = [0.0] ** 67;
    window_waves(w, &n1, &ap);
    var dqm : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &n1, &ap, &dqm);
    const cgg : f64 = cgg_pulse(&dqm, &n1, &ap, window_t01k(w), window_t075k(w));
    var dqp : [67]f64 = [0.0] ** 67;
    var dqn : [67]f64 = [0.0] ** 67;
    pulse_dq_g(&n1, &ap, vgp, &dqp);
    pulse_dq_g(&n1, &ap, vgn, &dqn);
    return net_run2(&kp, &kn, 0.0, cgg, true, SUB, &dqp, &dqn, window_t01k(w), window_t075k(w), window_set(w));
}

; --- S5: the decision's balance in situ, the bit path and the pair's gate charge in the sine run's windows (read 2026-10-20) ---------------------
; --- BEGIN PINNED DATA (ngspice-47 + PSP103, sar_kick_late_aperture.cir sar_which 2 and 3 (LINEAR rows), sar_kick_plates.cir) ----------------------
/// The LINEAR rows of the aperture deck at the decisions with TEN plates moved (clkc rise 11: window 2, rise 22: window 5), the same experiment as LAP_LIN_DD / LAP_LIN_DE at decision 9: the unperturbed run
/// and a step of the gate of VDP of 0.5 mV and 2 mV before the edge, the latch's two outputs 4.8 ns after the 0.1 V crossing, volts; window 2's three rows, then window 5's.
pub const LAP10_LIN_DD : [6]f64 = [6.890881e-01, 6.957881e-01, 7.159300e-01, 7.148057e-01, 7.217686e-01, 7.426692e-01];
pub const LAP10_LIN_DE : [6]f64 = [6.865726e-01, 6.809588e-01, 6.638987e-01, 6.795934e-01, 6.735652e-01, 6.552885e-01];
/// The pair's gate charge in the sine run (sar_kick_plates.cir, VMP / VMN: the current of the gate of each plate's 36 devices integrated from the 0.1 V to the 0.75 V crossing of clkc), the windows 1, 2, 4,
/// 5 in this order: the plate's own voltage at the two crossings (V) and the charge the gates took (fC): P (VDP) then N (VDN).
pub const PQ_WIN : [4]u32 = [1, 2, 4, 5];
pub const PQ_VP0 : [4]f64 = [0.738542, 0.737823, 0.745246, 0.745964];
pub const PQ_VP1 : [4]f64 = [0.725097, 0.724431, 0.731652, 0.732327];
pub const PQ_VN0 : [4]f64 = [0.743993, 0.744712, 0.752102, 0.751382];
pub const PQ_VN1 : [4]f64 = [0.725201, 0.725827, 0.733126, 0.732508];
pub const PQ_DQP : [4]f64 = [25.3969, 25.3022, 25.4746, 25.5565];
pub const PQ_DQN : [4]f64 = [25.1379, 25.2422, 25.4336, 25.3168];
/// DC conversions of the base circuit (sar_kick_plates.cir with sar_amp 0: the input sar_dmv = -196.21 .. 278.71 mV chosen as sar_kick.t27's late decisions were), the eight read here: the bit path
/// of the first ten decisions (bit i of the code is decision i: 1 = VDP above, the P plate down), then at decision 9 and at decision 10: D = VDP - VDN at the 0.1 V crossing (V) and the latch's
/// margin dd - de 4.8 ns after it (V), the unperturbed run.
pub const DC_N : usize = 8;
pub const DC_CODE : [8]u32 = [49, 49, 1014, 502, 470, 793, 793, 153];
pub const DC_D9 : [8]f64 = [-0.008190, -0.007690, -0.006299, -0.006700, -0.007468, -0.006615, -0.005617, -0.009365];
pub const DC_B9 : [8]f64 = [-0.033331, -0.020556, 0.010203, 0.000010, -0.019573, 0.013812, 0.039251, -0.056296];
pub const DC_D10 : [8]f64 = [-0.006756, -0.006256, -0.007739, -0.005259, -0.006028, -0.008055, -0.007057, -0.007934];
pub const DC_B10 : [8]f64 = [0.003091, 0.015956, -0.025911, 0.035964, 0.016316, -0.022528, 0.002696, -0.019764];
; --- END PINNED DATA ---------------------------------------------------------------------------------------------------------------------------

/// The slope of the latch's margin in the input at the DC conversions, V per V: 24.8 to 26.1 at the four sine windows (insitu_sine), 25 for the DC ones, whose rows were not repeated.
pub const DC_GAIN : f64 = 25.0;

/// The balance of a decision in situ, V: dd - de of the unperturbed run (the margin) is base, a step of dv at the gate of VDP changes it by g dv (g from the 2 mV row), so the input that zeroes it is -base / g
/// and the decision flips at D0 - base / g: the offset is base / g - D0. dd, de: the three rows (0, 0.5, 2 mV) from index o; d0: VDP - VDN at the 0.1 V crossing. No model and no kick enters: it is the
/// circuit's own answer at that decision, with the plates and the comparator as the converter left them.
pub fn insitu_off(dd: []const f64, de: []const f64, o: usize, d0: f64) -> f64 {
    const base : f64 = dd[o] - de[o];
    const g : f64 = ((dd[o + 2] - de[o + 2]) - base) / 0.002;
    return base / g - d0;
}

/// The same at the four sine decisions: window 1 (decision 9, first conversion), 2 (decision 10), 4 (decision 9, second conversion), 5 (decision 10).
pub fn insitu_sine(w: usize) -> f64 {
    if (w == 1) { return insitu_off(&LAP_LIN_DD, &LAP_LIN_DE, 0, LATE_D_V[1]); }
    if (w == 4) { return insitu_off(&LAP_LIN_DD, &LAP_LIN_DE, 3, LATE_D_V[4]); }
    if (w == 2) { return insitu_off(&LAP10_LIN_DD, &LAP10_LIN_DE, 0, LATE_D_V[2]); }
    return insitu_off(&LAP10_LIN_DD, &LAP10_LIN_DE, 3, LATE_D_V[5]);
}

/// The balance of decision 9 (m = 9) or 10 (m = 10) of the DC conversion i in situ, V.
pub fn dc_insitu(i: usize, m: usize) -> f64 {
    if (m == 9) { return DC_B9[i] / DC_GAIN - DC_D9[i]; }
    return DC_B10[i] / DC_GAIN - DC_D10[i];
}

/// The plates of a decision with m plates moved for a bit path given as a code (bit i = decision i), as late_modes sets them from the sine's decisions.
pub fn modes_code(code: u32, m: usize, kp: []u8, kn: []u8) {
    var c : u32 = code;
    var i : usize = 0;
    while (i < m) {
        const k : usize = 9 - i;
        if (c % 2 == 1) {
            kp[k] = DR_DOWN;
            kn[k] = DR_UP;
        } else {
            kp[k] = DR_UP;
            kn[k] = DR_DOWN;
        }
        c = c / 2;
        i = i + 1;
    }
}

/// The network's offset (model A: one pulse for the pair) of the decision m = 9 or 10 on the bit path `code`, V, with the sine run's edge and aperture of that decision (window 1 or 2, aperture set 1).
pub fn off_code(code: u32, m: usize) -> f64 {
    var kp : [10]u8 = [0] ** 10;
    var kn : [10]u8 = [0] ** 10;
    modes_code(code, m, &kp, &kn);
    var w : usize = 1;
    if (m == 10) { w = 2; }
    return run_window(&kp, &kn, w).off;
}

/// The charge the gates of the pair (one plate's 36 devices) take between the 0.1 V and the 0.75 V crossing of clkc in window w, fC, from the three charge tables read at the plate's own voltage at the two
/// crossings (vg0, vg1) and the comparator's tail node and drain there: what ngspice integrated from the gate current (PQ_DQP, PQ_DQN).
pub fn gate_charge_fc(w: usize, vg0: f64, vg1: f64) -> f64 {
    var n1 : [67]f64 = [0.0] ** 67;
    var ap : [67]f64 = [0.0] ** 67;
    window_waves(w, &n1, &ap);
    const k0 : f64 = window_t01k(w);
    const k1 : f64 = window_t075k(w);
    return qtab_g(vg1, at(&n1, k1), at(&ap, k1)) - qtab_g(vg0, at(&n1, k0), at(&ap, k0));
}

; --- the pins -----------------------------------------------------------------------------------------------------------------------------
/// An order-sensitive fold (M1's) of the f64 numbers a[0 .. n), each as q_sm(a * scale), onto the seed s.
pub fn fold_f(a: []const f64, n: usize, scale: f64, s: u64) -> u64 {
    var acc : u64 = s;
    var k : usize = 0;
    while (k < n) {
        acc = fold(acc, q_sm(a[k] * scale));
        k = k + 1;
    }
    return acc;
}

/// The three gate-charge tables.
pub fn fold_tables() -> u64 {
    return fold_arr(&QG_HI, 625, fold_arr(&QG_MID, 625, fold_arr(&QG_LO, 625, 0)));
}

/// The comparator's waves: net1, ap and the gate charge ngspice integrated.
pub fn fold_waves() -> u64 {
    return fold_f(&WAVE_QG_FC, NS, 1.0, fold_f(&WAVE_AP, NS, 1.0, fold_f(&WAVE_N1, NS, 1.0, 0)));
}

/// The aperture rows and the idle two-port currents (the currents in mA).
pub fn fold_rest() -> u64 {
    var s : u64 = fold_f(&AP_DD, AP_N, 1.0, 0);
    s = fold_f(&AP_DE, AP_N, 1.0, s);
    s = fold_f(&LIN_DD, 3, 1.0, s);
    s = fold_f(&LIN_DE, 3, 1.0, s);
    s = fold_f(&Y_I100, 8, 1000.0, s);
    return fold_f(&Y_I300, 8, 1000.0, s);
}

/// The six windows of sar_kick_late.cir.
pub fn fold_late() -> u64 {
    var s : u64 = fold_arr(&LATE_RISE, LATE_NW, 0);
    s = fold_f(&LATE_TS_NS, LATE_NW, 0.001, s);
    s = fold_f(&LATE_TCB_NS, LATE_NW, 0.001, s);
    s = fold_f(&LATE_TCC_NS, LATE_NW, 0.001, s);
    s = fold_f(&LATE_D_V, LATE_NW, 1.0, s);
    s = fold_f(&LATE_VP_V, LATE_NW, 1.0, s);
    s = fold_f(&LATE_VN_V, LATE_NW, 1.0, s);
    s = fold_f(&LATE_N1, LATE_NW * NS, 1.0, s);
    return fold_f(&LATE_AP, LATE_NW * NS, 1.0, s);
}

/// The two late apertures of sar_kick_late_aperture.cir.
pub fn fold_late_aperture() -> u64 {
    var s : u64 = fold_f(&LAP_TCB_NS, 2, 0.001, 0);
    s = fold_f(&LAP_DD0, 2, 1.0, s);
    s = fold_f(&LAP_DE0, 2, 1.0, s);
    s = fold_f(&LAP_DD, 32, 1.0, s);
    s = fold_f(&LAP_DE, 32, 1.0, s);
    s = fold_f(&LAP_LIN_DD, 6, 1.0, s);
    return fold_f(&LAP_LIN_DE, 6, 1.0, s);
}

/// The moved bit's two-port of sar_kick_cnode_moved.cir (the currents in mA).
pub fn fold_moved() -> u64 {
    var s : u64 = fold_f(&Y_MV100, 16, 1000.0, 0);
    s = fold_f(&Y_MV300, 16, 1000.0, s);
    return fold_f(&MV_OP_I, 4, 1000.0, s);
}

/// The sample index at or before the fractional position x.
pub fn sample_floor(x: f64) -> usize {
    return x as usize;
}

/// The units on one side of the bridge (1: the top plate, 0: net1).
pub fn units_on(side: u8) -> f64 {
    var s : f64 = 0.0;
    var k : usize = 0;
    while (k < PLATES) {
        if (SIDE[k] == side) { s = s + (UNITS[k] as f64); }
        k = k + 1;
    }
    return s;
}

/// The comparator's gate capacitance at the fractional sample kf, fF.
pub fn cgg_frac(kf: f64) -> f64 {
    const i : usize = kf as usize;
    const f : f64 = kf - (i as f64);
    return cgg_at(&WAVE_N1, &WAVE_AP, i) * (1.0 - f) + cgg_at(&WAVE_N1, &WAVE_AP, i + 1) * f;
}

/// The charge between the 0.1 V and the 0.75 V crossings of clkc, fC, from the wave dq.
pub fn dq_kick(dq: []const f64) -> f64 {
    return at(dq, T075_K) - at(dq, T01_K);
}

; --- the tests ------------------------------------------------------------------------------------------------------------------------------

test the_pinned_data_is_what_the_decks_printed {
    assert_eq(fold_tables(), 1294308024549390123);
    assert_eq(fold_waves(), 10042905305604155163);
    assert_eq(fold_rest(), 4489942338656569774);
    assert_eq(fold_late(), 14396952515047338484);
    assert_eq(fold_late_aperture(), 14624395582691900021);
    assert_eq(fold_moved(), 1950012138477754938);
    // the tables' origin is the offset, the charge rises with the gate everywhere, and the sample positions of the two crossings are the deck's times
    assert_eq(QG_MID[0], 2097152);
    var k : usize = 0;
    while (k < 625) {
        assert(QG_LO[k] < QG_MID[k]);
        assert(QG_MID[k] < QG_HI[k]);
        k = k + 1;
    }
    assert(fabs64(T01_K - (T01_NS - T0_NS) / SAMPLE_NS) < 0.000001);
    assert(fabs64(T075_K - (T075_NS - T0_NS) / SAMPLE_NS) < 0.001);
    // the comparator's tail node starts at 0.654 V, the drain at the rail, the gates held at 0.742 V
    assert(fabs64(WAVE_N1[0] - 0.654226) < 0.000001);
    assert(fabs64(WAVE_AP[0] - 1.500045) < 0.000001);
    // the aperture's response is linear in the step: 0.5 mV, 1 mV and 2 mV give the same response per millivolt to 0.3 percent
    const r1 : f64 = AP_DD0 - AP_DE0;
    const r05 : f64 = (LIN_DD[1] - LIN_DE[1]) * 2.0;
    const r2 : f64 = (LIN_DD[2] - LIN_DE[2]) / 2.0;
    assert(fabs64(r05 - r1) < 0.003 * r1);
    assert(fabs64(r2 - r1) < 0.003 * r1);
}

test the_charge_pulse_from_the_tables_is_what_ngspice_integrated_and_m3cs_table_is_not {
    var dq : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &WAVE_N1, &WAVE_AP, &dq);
    // at clkc = 0.75 V: 26.93 fC from the tables against 26.90 fC that ngspice integrated from the gate current, 0.1 percent
    const q075 : f64 = at(&dq, T075_K);
    const n075 : f64 = at(&WAVE_QG_FC, T075_K);
    assert(fabs64(n075 - 26.897) < 0.001);
    assert(fabs64(q075 - n075) < 0.005 * n075);
    // and through the edge: the tables are within 0.11 fC of the integral at every sample, 0.07 fC from 0.1 V to 0.75 V (the pulse is 27 fC)
    var worst : f64 = 0.0;
    var worst_edge : f64 = 0.0;
    var k : usize = 0;
    while (k < NS) {
        const e : f64 = fabs64(dq[k] - WAVE_QG_FC[k]);
        if (e > worst) { worst = e; }
        if (k >= sample_floor(T01_K) && k <= sample_floor(T075_K) && e > worst_edge) { worst_edge = e; }
        k = k + 1;
    }
    assert(worst < 0.12);
    assert(worst_edge < 0.08);
    // the gate capacitance the same tables give at ngspice's own operating point (Vg 0.742, Vs 0.4, Vd 1.3 V): 2.615 fF per device against its channel + both overlaps, 2.618 fF
    const c_op : f64 = (qtab_fc(&QG_HI, 0.4, 1.3) - qtab_fc(&QG_LO, 0.4, 1.3)) / QG_DVG / M_PAIR;
    const c_ng : f64 = (OP_CGG_AF + OP_CGSOL_AF + OP_CGDOL_AF) / 1000.0;
    assert(fabs64(c_op - c_ng) < 0.01 * c_ng);
    // the pair's gate capacitance at the 0.1 V crossing is 59 fF and the pulse-weighted one the network carries is 110
    assert(fabs64(cgg_frac(T01_K) - 59.19) < 0.05);
    assert(fabs64(cgg_pulse(&dq, &WAVE_N1, &WAVE_AP, T01_K, T075_K) - 109.9) < 0.1);
    // M3c's table (bulk at the source, 27 C, Vgs and Vds axes) is the wrong table for this pair: 36.4 fC at clkc = 0.75 V, 35 percent more than the integral
    var dm : [67]f64 = [0.0] ** 67;
    pulse_dq_m3c(&WAVE_N1, &WAVE_AP, &dm);
    const ratio : f64 = at(&dm, T075_K) / n075;
    assert(ratio > 1.30);
    assert(ratio < 1.40);
}

test the_drivers_resistances_come_from_the_tables_and_the_idle_two_port {
    // the inverter holding a rail, from M3b's 50 C tables: within 1 percent of the ohms ngspice measured on the golden inverter (sar_off_ron.cir)
    assert(fabs64(r_inv_n() - RON_INVN) < 0.01 * RON_INVN);
    assert(fabs64(r_inv_p() - RON_INVP) < 0.01 * RON_INVP);
    assert(r_inv_n() < r_inv_p());
    // the idle bit's two tgates, in situ from the two-port: x11 2587 ohm, x2 2586 ohm, within 0.5 percent of the tgate sar_off_ron.cir measured alone
    assert(fabs64(r_x11() - RON_TG) < 0.005 * RON_TG);
    assert(fabs64(r_x2() - RON_TG) < 0.005 * RON_TG);
    assert(fabs64(r_x11() - r_x2()) < 0.002 * r_x11());
    // its capacitances, 25.6, 12.8 and 3.2 fF at 100 MHz, agree with the 300 MHz reading to 1 percent
    assert(fabs64(idle_c(0) - 25.615) < 0.01);
    assert(fabs64(idle_c(2) - 12.809) < 0.01);
    assert(fabs64(idle_c(1) - 3.194) < 0.01);
    assert(fabs64(y_c(&Y_I300, 1, 300000000.0) - idle_c(0)) < 0.01 * idle_c(0));
    assert(fabs64(y_c(&Y_I300, 7, 300000000.0) - idle_c(2)) < 0.01 * idle_c(2));
    assert(fabs64(y_c(&Y_I300, 3, 300000000.0) - idle_c(1)) < 0.02 * idle_c(1));
    // the moved N plate is behind the inverter and one tgate more, at a rail one device again: twice the P plate's
    assert(fabs64(n_drive(DR_UP) - 2.0 * r_inv_p()) < 0.000001);
    assert(fabs64(p_drive(DR_DOWN) - r_inv_n()) < 0.000001);
    // the tables cannot give the tgate at VCM: no body effect in a table made with the source and bulk together, so they read it 30 percent too stiff
    const rt : f64 = r_tgate_tables();
    assert(rt < 0.75 * RON_TG);
    assert(rt > 0.65 * RON_TG);
}

test the_five_drive_mode_codes_are_the_dense_table_zero_to_four_and_up_is_the_pmos_driver_by_its_number {
    // idle is 0 because every drive array of this spec starts as [0] ** 10, and a bit nobody drove must be idle (second source: the arrays)
    var untouched : [10]u8 = [0] ** 10;
    assert(untouched[7] == DR_IDLE);
    // five modes (the doc comment of the constants lists idle, up, down, ideal, mirror) in strictly ascending order from that zero, the last one below 5:
    // that is exactly the codes 0, 1, 2, 3, 4, and a code outside the table (a plant of DR_UP to 7) breaks the chain
    assert(DR_IDLE < DR_UP);
    assert(DR_UP < DR_DOWN);
    assert(DR_DOWN < DR_IDEAL);
    assert(DR_IDEAL < DR_MIRROR);
    assert(DR_MIRROR < 5);
    // the moved modes by their numbers, the way p_drive's doc comment gives them: UP through the pmos, DOWN through the nmos; the N half twice that
    assert(p_drive(1) == r_inv_p());
    assert(p_drive(2) == r_inv_n());
    assert(n_drive(1) == 2.0 * r_inv_p());
    assert(n_drive(2) == 2.0 * r_inv_n());
}

test the_network_has_34_nodes_a_solve_that_solves_and_m1s_words_that_follow_the_f64_run {
    assert_eq(NMAX, 34);
    assert_eq(NSQ, NMAX * NMAX);
    assert_eq(WA, 2 * NMAX + 1);
    assert_eq(NAUG, NMAX * WA);
    // A X = [C / dt | b] to a part in 1e9 (the stiff 1 mOhm joints leave 2e-11)
    assert(base_residual() < 0.000000001);
    // the words of M1's step against the f64 run of the same method: 1.2 uV at the worst plate and sample
    assert(quant_err_v() < 0.000003);
    assert(quant_err_v() > 0.0000001);
}

test with_ideal_plates_the_network_is_the_capacitive_divider_and_both_plates_fall_alike {
    const r : KickOut = kick_row(V_PLATES);
    // closed form: stiff plates make the DAC a capacitor to ground, 31 units on the top plate and the one-unit bridge in series with the 31 of net1, plus 12 fF and the gate
    var dq : [67]f64 = [0.0] ** 67;
    pulse_dq(&QG_MID, &WAVE_N1, &WAVE_AP, &dq);
    const c_tot : f64 = C_EXPLICIT_FF + cgg_pulse(&dq, &WAVE_N1, &WAVE_AP, T01_K, T075_K) + units_on(1) * C_UNIT_FF + C_UNIT_FF * (units_on(0) * C_UNIT_FF) / (C_UNIT_FF + units_on(0) * C_UNIT_FF);
    const closed : f64 = 0.0 - dq_kick(&dq) / c_tot;
    assert(fabs64(r.dvdp - closed) < 0.005 * fabs64(closed));
    // both plates fall by 6.71 mV, within 5 percent of ngspice's 6.87 mV, and by exactly the same
    assert(fabs64(r.dvdp - KICK_P[V_PLATES]) < 0.05 * fabs64(KICK_P[V_PLATES]));
    assert(fabs64(r.dvdn - KICK_N[V_PLATES]) < 0.05 * fabs64(KICK_N[V_PLATES]));
    assert(fabs64(r.dvdp - r.dvdn) < 0.0001);
    assert(r.dvdp < 0.0 - 0.0065);
    // the decision's offset is the latch's own
    assert(fabs64(r.off - LATCH_OFF_V) < 0.000000001);
}

test the_golden_plates_fall_by_22_and_30_mv_and_the_n_half_falls_more {
    const b : KickOut = kick_row(V_BASE);
    // dVDP and dVDN at clkc = 0.75 V within 10 percent of ngspice's -22.7 and -30.2 mV (derived -22.4 and -29.5)
    assert(fabs64(b.dvdp - KICK_P[V_BASE]) < 0.1 * fabs64(KICK_P[V_BASE]));
    assert(fabs64(b.dvdn - KICK_N[V_BASE]) < 0.1 * fabs64(KICK_N[V_BASE]));
    assert(b.dvdp < 0.0 - 0.020);
    assert(b.dvdn < b.dvdp);
    // the 7 mV between them, within 10 percent of ngspice's 7.5 mV
    assert(fabs64((b.dvdp - b.dvdn) - kick_diff(V_BASE)) < 0.1 * kick_diff(V_BASE));
    // soft plates fall 3.3 and 4.4 times as far as stiff ones: the same windows as the measurement's
    const ideal : KickOut = kick_row(V_PLATES);
    const rp : f64 = b.dvdp / ideal.dvdp;
    const rn : f64 = b.dvdn / ideal.dvdn;
    assert(rp > 3.2);
    assert(rp < 3.4);
    assert(rn > 4.3);
    assert(rn < 4.5);
    // the tracking switch is not in the network: the ideal-switch row is the base row
    assert(fabs64(kick_row(V_IDEALSW).off - b.off) < 0.000000001);
}

test with_one_half_ideal_the_kick_differential_is_lopsided_the_way_ngspice_found {
    const n : KickOut = kick_row(V_NPLATE);
    const p : KickOut = kick_row(V_PPLATE);
    // N half ideal: the differential within 15 percent of ngspice's -20.5 mV (derived -19.1); P half ideal: +35.9 mV (derived +33.0)
    assert(fabs64((n.dvdp - n.dvdn) - kick_diff(V_NPLATE)) < 0.15 * fabs64(kick_diff(V_NPLATE)));
    assert(fabs64((p.dvdp - p.dvdn) - kick_diff(V_PPLATE)) < 0.15 * fabs64(kick_diff(V_PPLATE)));
    assert(n.dvdp - n.dvdn < 0.0 - 0.017);
    assert(p.dvdp - p.dvdn > 0.030);
    // each plate on its own: the ideal half's partner is lifted (VDN rises 2.8 mV with the N half ideal, VDP 9.8 mV with the P half ideal), the other falls
    assert(n.dvdn > 0.0);
    assert(p.dvdp > 0.0);
    assert(fabs64(n.dvdp - KICK_P[V_NPLATE]) < 0.1 * fabs64(KICK_P[V_NPLATE]));
    assert(fabs64(p.dvdn - KICK_N[V_PPLATE]) < 0.1 * fabs64(KICK_N[V_PPLATE]));
}

test a_resistor_on_the_p_plates_takes_the_offset_through_zero_where_ngspice_found_it {
    // the first decision's offset with 1300, 2592 and 3900 ohm between each P plate and its Bit node: within 1 mV of +4.09, -0.89 and -4.19 mV
    var i : usize = 0;
    var prev : f64 = kick_row(V_BASE).off;
    while (i < NRS) {
        const o : f64 = kick_series(RS_OHM[i]).off;
        assert(fabs64(o - rs_off(i)) < 0.001);
        assert(o < prev);
        prev = o;
        i = i + 1;
    }
    // with a tgate's own resistance the plates fall alike (29.2 and 29.1 against ngspice's 29.7 and 29.2) and the offset is under 1 mV
    const t : KickOut = kick_series(RS_OHM[1]);
    assert(fabs64(t.dvdp - t.dvdn) < 0.0007);
    assert(fabs64(t.dvdp + 0.0297480) < 0.002);
    assert(fabs64(t.off) < 0.001);
    // it crosses the latch's own 0.153 mV between 2200 and 2450 ohm (2386); ngspice's 2320 is 3 percent from it
    const r0 : f64 = series_cross_ohm();
    assert(r0 > 2200.0);
    assert(r0 < 2450.0);
    assert(fabs64(r0 - rs_zero_ohm()) < 0.04 * rs_zero_ohm());
}

test the_six_first_decision_rows_and_the_series_row_are_within_1_mv_and_in_the_measured_order {
    var v : usize = 0;
    while (v < 6) {
        const o : f64 = kick_row(v).off;
        assert(fabs64(o - first_off(v)) < 0.001);
        v = v + 1;
    }
    assert(fabs64(kick_series(RS_OHM[1]).off - rs_off(1)) < 0.001);
    // the order: P ideal > golden > symmetric = comparator isolated > N ideal
    const pid : f64 = kick_row(V_PPLATE).off;
    const base : f64 = kick_row(V_BASE).off;
    const sym : f64 = kick_row(V_PLATES).off;
    const iso : f64 = kick_row(V_NOKICK).off;
    const nid : f64 = kick_row(V_NPLATE).off;
    assert(pid > base);
    assert(base > sym);
    assert(fabs64(sym - iso) < 0.000000001);
    assert(sym > nid);
    // the signs and sizes: +43.0, +9.3, +0.15, +0.15, -24.9 mV
    assert(pid > 0.042);
    assert(base > 0.009);
    assert(base < 0.0095);
    assert(nid < 0.0 - 0.024);
    // the comparator isolated (no charge pulse) leaves the latch's own offset and nothing else, against ngspice's +0.03 +- 0.15 mV
    assert(fabs64(iso - LATCH_OFF_V) < 0.000000001);
    assert(fabs64(LATCH_OFF_V + LATCH_FLIP_V) < 0.000000001);
    assert(fabs64(iso - first_off(V_NOKICK)) < 0.00025);
}

test the_derived_kick_follows_the_charge_pulse_and_the_drive_and_nothing_else {
    // 1. no pulse, no kick: the plates stay put and the offset is the latch's
    const none : KickOut = kick_with(DR_IDLE, DR_IDLE, 0.0, true, 1.0, SUB, PULSE_NONE);
    assert(fabs64(none.dvdp) < 0.000000001);
    assert(fabs64(none.dvdn) < 0.000000001);
    // 2. M3c's gate-charge table (bulk at the source, 27 C) pushes in 35 percent more charge and the plates fall 21 percent too far: S1 fails its 10 percent
    const m3c : KickOut = kick_with(DR_IDLE, DR_IDLE, 0.0, true, 1.0, SUB, PULSE_M3C);
    assert(fabs64(m3c.dvdp - KICK_P[V_BASE]) > 0.15 * fabs64(KICK_P[V_BASE]));
    assert(m3c.dvdp < 1.15 * KICK_P[V_BASE]);
    // 3. the tgate from M3b's tables (no body effect) is 1.43 times too stiff a drive: S1 fails by 17 to 19 percent
    const stiff : KickOut = kick_with(DR_IDLE, DR_IDLE, 0.0, true, r_x11() / r_tgate_tables(), SUB, PULSE_TABLE);
    assert(fabs64(stiff.dvdp - KICK_P[V_BASE]) > 0.15 * fabs64(KICK_P[V_BASE]));
    assert(fabs64(stiff.dvdn - KICK_N[V_BASE]) > 0.15 * fabs64(KICK_N[V_BASE]));
    assert(kick_row(V_BASE).off - stiff.off > 0.0015);
    // 4. the bit's two-port capacitances left out: the one-half-ideal rows move by 1.7 and 2.7 mV and the 2592 ohm row misses ngspice's -0.89 mV by more than 1 mV
    const np_n : KickOut = kick_with(DR_IDLE, DR_MIRROR, 0.0, false, 1.0, SUB, PULSE_TABLE);
    const np_p : KickOut = kick_with(DR_MIRROR, DR_IDLE, 0.0, false, 1.0, SUB, PULSE_TABLE);
    const np_s : KickOut = kick_with(DR_IDLE, DR_IDLE, 2592.0, false, 1.0, SUB, PULSE_TABLE);
    const dn : f64 = fabs64(np_n.off - kick_row(V_NPLATE).off);
    const dp : f64 = fabs64(np_p.off - kick_row(V_PPLATE).off);
    assert(dn > 0.0015);
    assert(dn < 0.0019);
    assert(dp > 0.0025);
    assert(dp < 0.0029);
    assert(fabs64(np_s.off - rs_off(1)) > 0.001);
    assert(fabs64(np_p.off - first_off(V_PPLATE)) > 0.001);
    // 5. a step of 100 ps (one per sample) moves the rows by up to 0.9 mV and the one-half-ideal rows then miss by more than 1 mV
    const c_n : KickOut = kick_with(DR_IDLE, DR_MIRROR, 0.0, true, 1.0, 1, PULSE_TABLE);
    const c_p : KickOut = kick_with(DR_MIRROR, DR_IDLE, 0.0, true, 1.0, 1, PULSE_TABLE);
    const c_b : KickOut = kick_with(DR_IDLE, DR_IDLE, 0.0, true, 1.0, 1, PULSE_TABLE);
    assert(fabs64(c_p.off - kick_row(V_PPLATE).off) > 0.0008);
    assert(fabs64(c_p.off - kick_row(V_PPLATE).off) < 0.0009);
    assert(fabs64(c_n.off - kick_row(V_NPLATE).off) > 0.0004);
    assert(fabs64(c_b.off - kick_row(V_BASE).off) < 0.0003);
    assert(fabs64(c_p.off - first_off(V_PPLATE)) > 0.001);
    assert(fabs64(c_n.off - first_off(V_NPLATE)) > 0.001);
    // and 20 steps per sample (dt = 5 ps) move the 10 ps result by under 0.05 mV: dt = 10 ps is converged
    const f_n : KickOut = kick_with(DR_IDLE, DR_MIRROR, 0.0, true, 1.0, 20, PULSE_TABLE);
    assert(fabs64(f_n.off - kick_row(V_NPLATE).off) < 0.00005);
}

test the_top_plate_load_with_stiff_plates_is_the_tables_gate_capacitance_and_its_dependence_on_the_drive_is_the_next_gap {
    // FR-003: with ideal plates the first plate step reads a top-plate load Cp of 0.582 units of 122.94 fF; the network's load is the explicit 12 fF plus the pair's gate
    // capacitance at the pre-edge bias from the tables, 59.2 fF: 0.579 units, within 1 percent of the measurement
    const cp : f64 = (C_EXPLICIT_FF + cgg_frac(T01_K)) / C_UNIT_FF;
    const cp_ideal : f64 = cp_of_step(step_mean(V_PLATES));
    assert(fabs64(cp - cp_ideal) < 0.01 * cp_ideal);
    assert(fabs64(cp - 0.5791) < 0.0005);
    // what is NOT derived: the golden circuit reads 0.647 and the P plates behind 1300, 2592, 3900 ohm read 0.62, 0.69, 0.85 and a raised and a lowered plate differ by 2.85 mV
    // (sar_kick.t27): the load grows by 0.07 to 0.27 units, which the fixed gate capacitance does not give. The step is read a time after the plate moves that the pinned data do not hold
    assert(cp_of_step(step_mean(V_BASE)) - cp > 0.06);
    assert(cp_of_step((RS_STEP_UP[0] + RS_STEP_DN[0]) / 2.0) - cp > 0.04);
    assert(cp_of_step((RS_STEP_UP[2] + RS_STEP_DN[2]) / 2.0) - cp > 0.26);
    assert(STEP_UP[V_BASE] - STEP_DN[V_BASE] > 0.0028);
}

test a_moved_bits_drivers_are_the_inverters_the_tables_give_and_its_two_port_adds_capacitance_not_coupling {
    // the operating points of sar_kick_cnode_moved.cir: 10 mV over the current is the path's resistance. P plate up through the pmos 1881 ohm, down through the nmos 1428 ohm; the N plate
    // behind the inverter x12 and the tgate x15: 2862 ohm (down) and 3772 ohm (up), twice the inverter's, to within 1 percent
    const rpu : f64 = 0.01 / MV_OP_I[0];
    const rnd : f64 = 0.0 - 0.01 / MV_OP_I[1];
    const rpd : f64 = 0.0 - 0.01 / MV_OP_I[2];
    const rnu : f64 = 0.01 / MV_OP_I[3];
    assert(fabs64(rpu - p_drive(DR_UP)) < 0.01 * rpu);
    assert(fabs64(rpd - p_drive(DR_DOWN)) < 0.01 * rpd);
    assert(fabs64(rnd - n_drive(DR_DOWN)) < 0.01 * rnd);
    assert(fabs64(rnu - n_drive(DR_UP)) < 0.01 * rnu);
    assert(rpu > rpd);
    assert(rnu > rnd);
    // the ac conductances at 100 MHz agree with the operating point to 0.5 percent, and there is no conductance between the two plates (x11 is off)
    assert(fabs64(1000000.0 / moved_g(0, 0) - rpu) < 0.005 * rpu);
    assert(fabs64(1000000.0 / moved_g(1, 0) - rpd) < 0.005 * rpd);
    assert(fabs64(1000000.0 / moved_g(0, 2) - rnd) < 0.005 * rnd);
    assert(fabs64(1000000.0 / moved_g(1, 2) - rnu) < 0.005 * rnu);
    assert(fabs64(moved_g(0, 1)) < 0.001 * moved_g(0, 0));
    assert(fabs64(moved_g(1, 1)) < 0.001 * moved_g(1, 0));
    // what its devices add: 50 and 41 fF at the P plate's node, 11 and 19 fF at the N plate's, a normal coupling of 2 fF (a negative entry); more than an idle bit's 25.6 fF at Bit
    assert(fabs64(moved_c(0, 0) - 50.05) < 0.05);
    assert(fabs64(moved_c(1, 0) - 41.2) < 0.1);
    assert(fabs64(moved_c(0, 2) - 11.28) < 0.05);
    assert(fabs64(moved_c(1, 2) - 19.35) < 0.05);
    assert(moved_c(0, 1) < 0.0 - 1.9);
    assert(moved_c(1, 1) < 0.0 - 1.9);
    assert(moved_c(0, 0) > idle_c(0));
    // the 300 MHz reading of the P node's capacitance is within 1 percent
    assert(fabs64(y_c(&Y_MV300, 1, 300000000.0) - moved_c(0, 0)) < 0.01 * moved_c(0, 0));
    assert(fabs64(y_c(&Y_MV300, 9, 300000000.0) - moved_c(1, 0)) < 0.01 * moved_c(1, 0));
}

test the_late_windows_are_the_sine_runs_own_edges_and_its_late_decisions_start_from_a_lower_net1 {
    // the plates' VDP - VDN at the 0.1 V crossing of each window is the pinned sine run's D to 0.01 mV: the run reproduces the one that was pinned
    var w : usize = 0;
    while (w < LATE_NW) {
        assert(fabs64(LATE_D_V[w] - DEC_D[(LATE_RISE[w] as usize) - 1]) < 0.00001);
        // each window starts 1.50 to 1.55 ns before the crossing and the clock takes 3.7 to 3.9 ns from 0.1 V to 0.75 V
        const lead : f64 = LATE_TCB_NS[w] - LATE_TS_NS[w];
        assert(lead > 1.499);
        assert(lead < 1.551);
        const rise : f64 = LATE_TCC_NS[w] - LATE_TCB_NS[w];
        assert(rise > 3.7);
        assert(rise < 3.9);
        w = w + 1;
    }
    // the sine run's first decision has net1 6 mV above the edge deck's at the window start, the late ones 32 to 40 mV below it
    assert(LATE_N1[0] - WAVE_N1[0] > 0.006);
    assert(LATE_N1[0] - WAVE_N1[0] < 0.007);
    assert(WAVE_N1[0] - LATE_N1[NS] > 0.039);
    assert(WAVE_N1[0] - LATE_N1[NS] < 0.041);
    assert(WAVE_N1[0] - LATE_N1[4 * NS] > 0.031);
    assert(WAVE_N1[0] - LATE_N1[4 * NS] < 0.033);
    // the charge the pair takes between the 0.1 V and 0.75 V crossings (27.2 fC at the edge deck's first decision): 27.5 and 27.6 fC at the first conversion's late decisions, 27.3 and 27.2 at the
    // second's; the pair's gate capacitance averaged over the pulse 112.8 and 111.5 fF against 109.9
    var dq : [67]f64 = [0.0] ** 67;
    var n1 : [67]f64 = [0.0] ** 67;
    var ap : [67]f64 = [0.0] ** 67;
    window_waves(1, &n1, &ap);
    pulse_dq(&QG_MID, &n1, &ap, &dq);
    assert(fabs64(at(&dq, window_t075k(1)) - at(&dq, window_t01k(1)) - 27.53) < 0.01);
    assert(fabs64(cgg_pulse(&dq, &n1, &ap, window_t01k(1), window_t075k(1)) - 112.8) < 0.1);
    window_waves(4, &n1, &ap);
    pulse_dq(&QG_MID, &n1, &ap, &dq);
    assert(fabs64(at(&dq, window_t075k(4)) - at(&dq, window_t01k(4)) - 27.28) < 0.01);
    assert(fabs64(cgg_pulse(&dq, &n1, &ap, window_t01k(4), window_t075k(4)) - 111.5) < 0.1);
    // the decisions' bits, derived from the pinned D before each, are the pinned decisions at 7 .. 10 of both conversions
    var cv : usize = 0;
    while (cv < 2) {
        var i : usize = 7;
        while (i < 11) {
            assert_eq(sine_bit(cv, i) as u32, LD_BIT[4 * cv + i - 7]);
            i = i + 1;
        }
        cv = cv + 1;
    }
}

test the_late_apertures_are_measured_at_the_late_state_and_differ_from_the_first_decisions {
    // the unperturbed run of the scan has the 0.1 V crossing of sar_kick_late.cir to 2.1 ps (the series source and a different step history)
    assert(fabs64(LAP_TCB_NS[0] - LATE_TCB_NS[1]) < 0.003);
    assert(fabs64(LAP_TCB_NS[1] - LATE_TCB_NS[4]) < 0.003);
    // the response to a 1 mV step before the edge is 24.9 and 25.8 mV at the late decisions against 36.3 mV at the first: the late latch has 0.69 and 0.71 of its gain at the read instant
    const g1 : f64 = (AP_DD0 - AP_DE0) - (LIN_DD[0] - LIN_DE[0]);
    const g2 : f64 = (LAP_DD0[0] - LAP_DE0[0]) - (LAP_LIN_DD[0] - LAP_LIN_DE[0]);
    const g3 : f64 = (LAP_DD0[1] - LAP_DE0[1]) - (LAP_LIN_DD[3] - LAP_LIN_DE[3]);
    assert(fabs64(g1 - 0.036336) < 0.00001);
    assert(fabs64(g2 - 0.024864) < 0.00001);
    assert(fabs64(g3 - 0.025759) < 0.00001);
    // linear in the step to 1 percent (steps of 0.5, 1 and 2 mV, each less the unperturbed run's own output difference, which is the decision's margin, not zero)
    const b2 : f64 = LAP_LIN_DD[0] - LAP_LIN_DE[0];
    const b3 : f64 = LAP_LIN_DD[3] - LAP_LIN_DE[3];
    assert(fabs64(((LAP_LIN_DD[1] - LAP_LIN_DE[1]) - b2) * 2.0 - g2) < 0.01 * g2);
    assert(fabs64(((LAP_LIN_DD[2] - LAP_LIN_DE[2]) - b2) / 2.0 - g2) < 0.01 * g2);
    assert(fabs64(((LAP_LIN_DD[4] - LAP_LIN_DE[4]) - b3) * 2.0 - g3) < 0.01 * g3);
    assert(fabs64(((LAP_LIN_DD[5] - LAP_LIN_DE[5]) - b3) / 2.0 - g3) < 0.01 * g3);
    // each share runs from 1 to 0 and falls at every row but the last two, which are within 0.001 of zero
    var set : usize = 0;
    while (set < 3) {
        assert(ap_share(set, 0) > 0.98);
        assert(fabs64(ap_share(set, 15)) < 0.000001);
        assert(fabs64(ap_share(set, 14)) < 0.001);
        var j : usize = 0;
        while (j < 13) {
            assert(ap_share(set, j) > ap_share(set, j + 1));
            j = j + 1;
        }
        set = set + 1;
    }
    // the late latch's share is already 0.985 at 3.0 ns where the first decision's is 1.000, and at 4.0 ns it is 0.555 where the first's is 0.601; they meet at 4.5 ns (0.075 and 0.073)
    assert(fabs64(ap_share(1, 0) - 0.9851) < 0.0001);
    assert(fabs64(ap_share(2, 0) - 0.9854) < 0.0001);
    assert(fabs64(ap_share(0, 0) - 0.9995) < 0.0001);
    assert(fabs64(ap_share(1, 8) - 0.5554) < 0.0001);
    assert(fabs64(ap_share(2, 8) - 0.5562) < 0.0001);
    assert(fabs64(ap_share(0, 8) - 0.6005) < 0.0001);
    assert(fabs64(ap_share(1, 12) - 0.0754) < 0.0001);
    assert(fabs64(ap_share(0, 12) - 0.0733) < 0.0001);
}

test decisions_9_and_10_with_their_own_edge_and_aperture_are_within_0_2_mv_of_the_measured_late_offsets_in_three_of_four_and_s5_is_not_met {
    // the measured late offsets (sar_kick.t27: 28 decisions at each index, one threshold each): decision 9 6.6575 mV to 0.05 mV; decision 10 6.895 mV, which the bit path moves between 6.85 and 7.06 mV
    const m9 : f64 = 0.0 - late_thr(9).mid;
    const m10 : f64 = 0.0 - late_thr(10).mid;
    assert(fabs64(m9 - 0.0066575) < 0.000001);
    assert(fabs64(m10 - 0.006895) < 0.000001);
    // the network's, each decision with its own edge (pulse from the tables) and its own aperture, the plates it had moved held by their inverters: 6.830, 6.862, 6.631 and 6.604 mV
    const o90 : f64 = late_off(0, 9);
    const o100 : f64 = late_off(0, 10);
    const o91 : f64 = late_off(1, 9);
    const o101 : f64 = late_off(1, 10);
    assert(fabs64(o90 - 0.0068295) < 0.000002);
    assert(fabs64(o100 - 0.0068615) < 0.000002);
    assert(fabs64(o91 - 0.0066305) < 0.000002);
    assert(fabs64(o101 - 0.0066035) < 0.000002);
    // the issue's 0.2 mV: met by the first conversion's two decisions (+0.17 and -0.03 mV) and the second's ninth (-0.03 mV) ...
    assert(fabs64(o90 - m9) < 0.0002);
    assert(fabs64(o100 - m10) < 0.0002);
    assert(fabs64(o91 - m9) < 0.0002);
    // ... and NOT by the second conversion's tenth: 6.604 against 6.895 mV, 0.29 mV low, and 0.25 mV under the lowest the paths allow (6.85). S5 is not met; the gap is stated, not closed.
    const gap : f64 = o101 - m10;
    assert(gap < 0.0 - 0.0002);
    assert(gap > 0.0 - 0.0003);
    assert(o101 < 0.00685 - 0.0002);
    // what the network does not have: the measured offset has one value at decision 9 over every path (28 decisions inside 0.05 mV), the derived has two 0.2 mV apart; and the measured offset
    // is 0.24 mV higher at decision 10 than at 9 where the derived is the same (to 0.03 mV)
    assert(fabs64(o90 - o91) > 0.0001);
    assert(fabs64(o90 - o91) < 0.0003);
    assert(m10 - m9 > 0.0002);
    assert(fabs64(o100 - o90) < 0.00005);
    assert(fabs64(o101 - o91) < 0.00005);
    // the mean of the four, 6.731 mV, against the 6.776 mV the converter model takes (sar_adc.t27 is not switched to it)
    assert(fabs64(late_off_derived() - 0.0067315) < 0.000002);
    assert(late_off_derived() > 0.0066);
    assert(late_off_derived() < 0.0069);
}

test the_late_decisions_controls_the_first_decisions_edge_the_bits_capacitances_and_the_bit_path_each_move_the_offset_by_a_tenth_to_a_third_of_a_millivolt {
    const m9 : f64 = 0.0 - late_thr(9).mid;
    const m10 : f64 = 0.0 - late_thr(10).mid;
    // 1. the first decision's edge and aperture (the edge deck's, as the first lane read the late decisions): 7.087, 7.086, 6.774 and 6.772 mV; the first conversion's ninth misses by 0.43 mV
    assert(fabs64(late_kick(0, 9, LATE_NW).off - 0.0070875) < 0.000002);
    assert(fabs64(late_kick(0, 10, LATE_NW).off - 0.0070865) < 0.000002);
    assert(fabs64(late_kick(1, 9, LATE_NW).off - 0.0067745) < 0.000002);
    assert(fabs64(late_kick(1, 10, LATE_NW).off - 0.0067725) < 0.000002);
    assert(late_kick(0, 9, LATE_NW).off - m9 > 0.0004);
    // 2. the late edge with the first decision's aperture: 6.980, 7.009, 6.796 and 6.769 mV: the aperture's timing matters at 0.1 to 0.2 mV
    assert(fabs64(late_kick_opts(0, 9, 1, 0, true).off - 0.0069805) < 0.000002);
    assert(fabs64(late_kick_opts(1, 9, 4, 0, true).off - 0.0067965) < 0.000002);
    assert(late_kick_opts(0, 9, 1, 0, true).off - late_off(0, 9) > 0.0001);
    // 3. the bits' capacitances left out (idle two-port and moved two-port): +0.11, +0.11, +0.05 and +0.05 mV
    const np90 : f64 = late_kick_opts(0, 9, 1, 1, false).off;
    const np101 : f64 = late_kick_opts(1, 10, 5, 2, false).off;
    assert(np90 - late_off(0, 9) > 0.0001);
    assert(np90 - late_off(0, 9) < 0.00012);
    assert(np101 - late_off(1, 10) > 0.00004);
    assert(np101 - late_off(1, 10) < 0.00006);
    // 4. the bit path: the first conversion's plates under the second's edge and aperture, and the reverse, differ by 0.3 mV from the plates that belong to them
    assert(fabs64(late_kick_opts(1, 9, 1, 1, true).off - 0.0065365) < 0.000002);
    assert(fabs64(late_kick_opts(0, 9, 4, 2, true).off - 0.0069365) < 0.000002);
    assert(late_kick_opts(0, 9, 1, 1, true).off - late_kick_opts(1, 9, 1, 1, true).off > 0.0002);
    assert(m10 > m9);
}

test the_first_decision_read_from_the_sine_runs_own_edge_stays_within_1_mv_and_sits_0_6_mv_above_the_edge_decks {
    // the edge deck holds the two gates on ideal sources settled for 14 ns; the sine run's first decision (window 0, plates 31 mV apart: the pulse is read from the table at one gate level for both) has
    // net1 6 mV higher and gives 9.97 mV against the edge deck's 9.34 and ngspice's 9.42 (the base experiment, D near the flip)
    const own : f64 = late_kick(0, 0, 0).off;
    assert(fabs64(own - first_off(V_BASE)) < 0.001);
    assert(own - kick_row(V_BASE).off > 0.0005);
    assert(own - kick_row(V_BASE).off < 0.0007);
}

test with_each_gate_at_its_own_level_every_kick_is_within_3_5_percent_and_the_three_differentials_are_closer_than_with_one_pulse {
    // the extension the three gate-level tables allow: VDP's device takes the charge of its own gate (0.742 V + D / 2), VDN's of its own (0.742 V - D / 2), D being the VDP - VDN at which
    // ngspice measured the kick (the input just below the flip). The charge rises 81 fC per volt of gate: a plate 4.7 mV lower takes 0.4 fC (1.4 percent) less. Every kick of the four
    // experiments with a kick is then within 3.5 percent of ngspice's (one pulse: 1.3 to 8 percent)
    var v : usize = 0;
    while (v < NV_ROWS) {
        const vv : usize = row_of(v);
        const r : KickOut = kick_row_g(vv, FLIP_LO[vv]);
        assert(fabs64(r.dvdp - KICK_P[vv]) < 0.035 * fabs64(KICK_P[vv]));
        assert(fabs64(r.dvdn - KICK_N[vv]) < 0.035 * fabs64(KICK_N[vv]));
        v = v + 1;
    }
    // the three differentials: golden 7.40 mV against 7.46 (0.8 percent; one pulse 7.15, 4.1), N ideal -19.9 against -20.5 (2.6; 6.6), P ideal +35.0 against +35.9 (2.7; 8.1)
    const b : KickOut = kick_row_g(V_BASE, FLIP_LO[V_BASE]);
    const n : KickOut = kick_row_g(V_NPLATE, FLIP_LO[V_NPLATE]);
    const p : KickOut = kick_row_g(V_PPLATE, FLIP_LO[V_PPLATE]);
    const b1 : KickOut = kick_row(V_BASE);
    const n1 : KickOut = kick_row(V_NPLATE);
    const p1 : KickOut = kick_row(V_PPLATE);
    assert(fabs64((b.dvdp - b.dvdn) - kick_diff(V_BASE)) < 0.01 * kick_diff(V_BASE));
    assert(fabs64((n.dvdp - n.dvdn) - kick_diff(V_NPLATE)) < 0.03 * fabs64(kick_diff(V_NPLATE)));
    assert(fabs64((p.dvdp - p.dvdn) - kick_diff(V_PPLATE)) < 0.03 * fabs64(kick_diff(V_PPLATE)));
    assert(fabs64((b.dvdp - b.dvdn) - kick_diff(V_BASE)) < fabs64((b1.dvdp - b1.dvdn) - kick_diff(V_BASE)));
    assert(fabs64((n.dvdp - n.dvdn) - kick_diff(V_NPLATE)) < fabs64((n1.dvdp - n1.dvdn) - kick_diff(V_NPLATE)));
    assert(fabs64((p.dvdp - p.dvdn) - kick_diff(V_PPLATE)) < fabs64((p1.dvdp - p1.dvdn) - kick_diff(V_PPLATE)));
}

/// The four experiments with a kick, in the order of the table: V_BASE, V_PLATES, V_NPLATE, V_PPLATE.
pub const NV_ROWS : usize = 4;
pub fn row_of(i: usize) -> usize {
    if (i == 0) { return V_BASE; }
    if (i == 1) { return V_PLATES; }
    if (i == 2) { return V_NPLATE; }
    return V_PPLATE;
}

test with_the_gates_at_their_own_levels_the_offsets_are_within_1_mv_but_the_p_half_ideal_row_which_is_0_15_mv_beyond {
    // the offsets with the plates at the D the decision flips at (the fixed point d = -off, so the measured flip is no input): 9.600, 0.157, -25.714 and +45.016 mV against 9.42, 0.27, -25.79 and +43.87:
    // the first three within 0.2 mV and the P half ideal 1.15 mV above ngspice's, 0.15 mV past the issue's 1 mV (one pulse: -0.84). The kick it comes from is 2.7 percent low.
    assert(fabs64(off_row_g(V_BASE) - 0.0096) < 0.000002);
    assert(fabs64(off_row_g(V_PLATES) - 0.000157) < 0.000002);
    assert(fabs64(off_row_g(V_NPLATE) + 0.025714) < 0.000002);
    assert(fabs64(off_row_g(V_PPLATE) - 0.045016) < 0.000002);
    assert(fabs64(off_row_g(V_BASE) - first_off(V_BASE)) < 0.0002);
    assert(fabs64(off_row_g(V_PLATES) - first_off(V_PLATES)) < 0.001);
    assert(fabs64(off_row_g(V_NPLATE) - first_off(V_NPLATE)) < 0.0002);
    assert(off_row_g(V_PPLATE) - first_off(V_PPLATE) > 0.001);
    assert(off_row_g(V_PPLATE) - first_off(V_PPLATE) < 0.0013);
    // the order is kept
    assert(off_row_g(V_PPLATE) > off_row_g(V_BASE));
    assert(off_row_g(V_BASE) > off_row_g(V_PLATES));
    assert(off_row_g(V_PLATES) > off_row_g(V_NPLATE));
    // the series rows, at their own flips: +4.185, -0.567, -4.949 mV against +4.09, -0.89 and -4.19: within 1 mV
    var i : usize = 0;
    while (i < NRS) {
        var d : f64 = 0.0;
        var k : u32 = 0;
        while (k < 4) {
            d = 0.0 - kick_with_g(DR_IDLE, DR_IDLE, RS_OHM[i], d).off;
            k = k + 1;
        }
        assert(fabs64((0.0 - d) - rs_off(i)) < 0.001);
        i = i + 1;
    }
    // the ratio of the offset to the 0.75 V kick differential is the aperture's: 1.30 in the model, 1.26 measured, for the golden and the N half ideal
    const rb : f64 = off_row_g(V_BASE) / (kick_row_g(V_BASE, FLIP_LO[V_BASE]).dvdp - kick_row_g(V_BASE, FLIP_LO[V_BASE]).dvdn);
    assert(rb > 1.28);
    assert(rb < 1.31);
    assert(first_off(V_BASE) / kick_diff(V_BASE) < 1.27);
}

test with_the_gates_at_their_own_levels_the_late_offsets_are_7_00_7_08_6_90_and_6_82_mv_two_of_four_within_0_2_mv {
    const m9 : f64 = 0.0 - late_thr(9).mid;
    const m10 : f64 = 0.0 - late_thr(10).mid;
    const g90 : f64 = late_kick_g(0, 9, 1).off;
    const g100 : f64 = late_kick_g(0, 10, 2).off;
    const g91 : f64 = late_kick_g(1, 9, 4).off;
    const g101 : f64 = late_kick_g(1, 10, 5).off;
    assert(fabs64(g90 - 0.0069985) < 0.000002);
    assert(fabs64(g100 - 0.0070805) < 0.000002);
    assert(fabs64(g91 - 0.0068985) < 0.000002);
    assert(fabs64(g101 - 0.0068235) < 0.000002);
    // against the measured 6.6575 mV (decision 9) and 6.895 mV (decision 10): +0.34, +0.19, +0.24, -0.07 mV: the first conversion's tenth and the second's eleventh are within the issue's 0.2 mV,
    // the other two are not
    assert(g90 - m9 > 0.0002);
    assert(fabs64(g100 - m10) < 0.0002);
    assert(g91 - m9 > 0.0002);
    assert(fabs64(g101 - m10) < 0.0002);
    // what moves them from the single pulse's 6.83, 6.86, 6.63, 6.60: the plates' common mode (0.7413 V in the first conversion, 0.7487 V in the second, against the table's 0.742 V) and
    // their difference (the P gate 5 to 7 mV below the N gate takes 0.4 to 0.6 fC less); the second conversion's ninth decision, with the common mode alone: +0.04 mV, with the difference alone +0.22 mV
    const cm : f64 = (LATE_VP_V[4] + LATE_VN_V[4]) / 2.0;
    const only_cm : f64 = late_kick_gv(1, 9, 4, cm, cm).off;
    const only_d : f64 = late_kick_gv(1, 9, 4, VG_PLATES + LATE_D_V[4] / 2.0, VG_PLATES - LATE_D_V[4] / 2.0).off;
    assert(only_cm - late_off(1, 9) > 0.00003);
    assert(only_cm - late_off(1, 9) < 0.00006);
    assert(only_d - late_off(1, 9) > 0.0002);
    assert(only_d - late_off(1, 9) < 0.00024);
    // neither variant meets S5: the single pulse is 3 of 4, the gate levels 2 of 4, and the model's two bit paths stay 0.2 to 0.3 mV apart at decision 9 where ngspice's 28 are within 0.05
    assert(fabs64(g90 - g91) > 0.0001);
    assert(g90 - late_off(0, 9) > 0.0001);
}

test the_pairs_gate_charge_in_the_sine_runs_windows_is_the_three_tables_at_the_plates_own_voltages_and_the_single_pulse_is_9_percent_more {
    // ngspice's gate current integrated from the 0.1 V to the 0.75 V crossing (25.1 to 25.6 fC) against the three tables read at the plate's own gate voltage at the two crossings (the plate falls 13 mV
    // and 19 mV between them, so the gate takes less than at a fixed 0.742 V): within 1.5 percent, P and N, four windows; the single pulse (the gates held at 0.742 V, the pulse the network is driven
    // with in model A) is 27.2 to 27.6 fC, 1.7 to 2.5 fC (7 to 10 percent) more, which the gate capacitance in the network takes back
    var i : usize = 0;
    while (i < 4) {
        const w : usize = PQ_WIN[i] as usize;
        const qp : f64 = gate_charge_fc(w, PQ_VP0[i], PQ_VP1[i]);
        const qn : f64 = gate_charge_fc(w, PQ_VN0[i], PQ_VN1[i]);
        assert(fabs64(qp - PQ_DQP[i]) < 0.015 * PQ_DQP[i]);
        assert(fabs64(qn - PQ_DQN[i]) < 0.015 * PQ_DQN[i]);
        var n1 : [67]f64 = [0.0] ** 67;
        var ap : [67]f64 = [0.0] ** 67;
        window_waves(w, &n1, &ap);
        var dq : [67]f64 = [0.0] ** 67;
        pulse_dq(&QG_MID, &n1, &ap, &dq);
        const single : f64 = at(&dq, window_t075k(w)) - at(&dq, window_t01k(w));
        assert(single - PQ_DQP[i] > 1.6);
        assert(single - PQ_DQP[i] < 2.7);
        assert(single - PQ_DQN[i] > 1.6);
        assert(single - PQ_DQN[i] < 2.7);
        // the plates' voltages at the 0.1 V crossing are the pinned sine run's (LATE_VP_V, LATE_VN_V) to 0.01 mV
        assert(fabs64(PQ_VP0[i] - LATE_VP_V[w]) < 0.00001);
        assert(fabs64(PQ_VN0[i] - LATE_VN_V[w]) < 0.00001);
        i = i + 1;
    }
}

test ngspices_own_balance_of_decision_10_is_decision_9s_in_each_conversion_and_the_network_is_0_13_to_0_17_mv_below_it_at_all_four {
    // the aperture deck's LINEAR rows say where each decision flips in the run itself: the margin dd - de of the unperturbed run over its slope in the input. Window 1 (decision 9, first conversion)
    // 6.984 mV, window 2 (decision 10) 6.991, window 4 (decision 9, second conversion) 6.771, window 5 (decision 10) 6.769: one number per conversion, 0.22 mV apart between the two
    const i1 : f64 = insitu_sine(1);
    const i2 : f64 = insitu_sine(2);
    const i4 : f64 = insitu_sine(4);
    const i5 : f64 = insitu_sine(5);
    assert(fabs64(i1 - 0.0069837) < 0.000002);
    assert(fabs64(i2 - 0.0069911) < 0.000002);
    assert(fabs64(i4 - 0.0067713) < 0.000002);
    assert(fabs64(i5 - 0.0067686) < 0.000002);
    assert(fabs64(i2 - i1) < 0.00001);
    assert(fabs64(i5 - i4) < 0.00001);
    assert(i1 - i4 > 0.0002);
    assert(i1 - i4 < 0.00023);
    // S5 read against that: the network (model A, with its own edge and aperture) is below ngspice's balance by 0.154, 0.130, 0.141 and 0.165 mV: all four within the issue's 0.2 mV, and all four on the
    // same side (a path-independent part is missing: the latch's own offset in the converter is not the 0.153 mV of its isolated test)
    const o90 : f64 = late_off(0, 9);
    const o100 : f64 = late_off(0, 10);
    const o91 : f64 = late_off(1, 9);
    const o101 : f64 = late_off(1, 10);
    assert(fabs64(o90 - i1) < 0.0002);
    assert(fabs64(o100 - i2) < 0.0002);
    assert(fabs64(o91 - i4) < 0.0002);
    assert(fabs64(o101 - i5) < 0.0002);
    assert(o90 < i1 - 0.0001);
    assert(o100 < i2 - 0.0001);
    assert(o91 < i4 - 0.0001);
    assert(o101 < i5 - 0.0001);
    // gap 2: decision 10 against decision 9 is 0.007 and -0.003 mV in ngspice and +0.033 and -0.028 mV in the network: no effect of the last plate in either; the +0.24 mV between the pooled
    // thresholds (6.658 and 6.895 mV) is the mix of bit paths each pooled threshold was bracketed on, see the DC conversions below
    assert(fabs64((o100 - o90) - (i2 - i1)) < 0.00005);
    assert(fabs64((o101 - o91) - (i5 - i4)) < 0.00005);
    // the difference between the two conversions: 0.212 and 0.222 mV in ngspice, 0.199 and 0.259 in the network
    assert(fabs64((o90 - o91) - (i1 - i4)) < 0.00005);
    assert(fabs64((o100 - o101) - (i2 - i5)) < 0.00005);
}

test eight_dc_conversions_on_five_bit_paths_balance_decision_9_and_10_alike_and_the_network_has_their_order_and_most_of_their_spread_and_is_0_1_to_0_3_mv_below_them {
    // sar_kick_plates.cir, DC input, the base circuit: decisions 9 and 10 of eight conversions on five distinct bit paths (49 = 1000110000, 1014 and 502 = 0110111111 / 0110111110, 470, 793, 153: the
    // codes bit i = decision i). ngspice's balance in situ at each: the same number at decision 10 as at decision 9 to 0.03 mV on every path, and different between paths by up to 0.48 mV
    var d9 : [8]f64 = [0.0] ** 8;
    var d10 : [8]f64 = [0.0] ** 8;
    var o9 : [8]f64 = [0.0] ** 8;
    var o10 : [8]f64 = [0.0] ** 8;
    var i : usize = 0;
    while (i < DC_N) {
        d9[i] = dc_insitu(i, 9);
        d10[i] = dc_insitu(i, 10);
        o9[i] = off_code(DC_CODE[i], 9);
        o10[i] = off_code(DC_CODE[i], 10);
        assert(fabs64(d10[i] - d9[i]) < 0.00004);
        // the network is below ngspice's balance on every path and decision, by 0.10 to 0.29 mV: not within the issue's 0.2 mV on the paths that are not the sine's
        assert(d9[i] - o9[i] > 0.00012);
        assert(d9[i] - o9[i] < 0.00032);
        assert(d10[i] - o10[i] > 0.00009);
        assert(d10[i] - o10[i] < 0.00025);
        i = i + 1;
    }
    // the paths at decision 10, ngspice: 793 (index 5, 6) 7.154, 7.165 > 153 (7) 7.143 > 49 (0, 1) 6.880, 6.894 > 1014 (2) 6.702 and 502 (3) 6.697 > 470 (4) 6.681 mV
    assert(d10[5] > d10[7]);
    assert(d10[6] > d10[7]);
    assert(d10[7] > d10[0] + 0.0002);
    assert(d10[7] > d10[1] + 0.0002);
    assert(d10[0] > d10[2] + 0.0001);
    assert(d10[1] > d10[3] + 0.0001);
    assert(d10[2] > d10[4]);
    assert(d10[3] > d10[4]);
    // the network: 793 and 153 6.925 mV > 49 6.660 > 1014 6.600, 502 6.598 > 470 6.581: the same order (the first two are 1 uV apart)
    assert(o10[5] > o10[0] + 0.0002);
    assert(o10[7] > o10[0] + 0.0002);
    assert(o10[0] > o10[2] + 0.00005);
    assert(o10[2] > o10[4]);
    assert(o10[3] > o10[4]);
    // the spread over the paths: 0.484 mV in ngspice, 0.345 mV in the network (71 percent): gap 1 is real (the offset depends on the bit path by half a millivolt) and the network has most of it
    var hi : f64 = d10[0];
    var lo : f64 = d10[0];
    var ohi : f64 = o10[0];
    var olo : f64 = o10[0];
    i = 1;
    while (i < DC_N) {
        if (d10[i] > hi) { hi = d10[i]; }
        if (d10[i] < lo) { lo = d10[i]; }
        if (o10[i] > ohi) { ohi = o10[i]; }
        if (o10[i] < olo) { olo = o10[i]; }
        i = i + 1;
    }
    assert(hi - lo > 0.00045);
    assert(hi - lo < 0.0005);
    assert((ohi - olo) > 0.6 * (hi - lo));
    assert((ohi - olo) < 0.8 * (hi - lo));
}
