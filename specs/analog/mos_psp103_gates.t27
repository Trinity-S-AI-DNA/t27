// SPDX-License-Identifier: Apache-2.0
; specs/analog/mos_psp103_gates.t27 -- the two-input gates and the transmission gate of the SAR ADC on the PSP103 log tables, judged by ngspice
; M5d of the analog emulation epic (#10486, issue #11263). specs/analog/mos_psp103.t27 solves ONE CMOS inverter on the tt tables of the NMOS (W 1.0 um) and the PMOS (W 3.0 um), L 0.45 um. The
; nand, the nor and the tgate of the integrated converter's golden netlist are made of the same two devices, with the same W, L and m (nand: two NMOS in series and two PMOS in parallel;
; nor: two NMOS in parallel and two PMOS in series; tgate: one PMOS and one NMOS in parallel between the input and the output; the sizes are facts of the circuit, none of its text is
; copied), so no new table is needed: this file reads the tt LOG tables TT_LG_N and TT_LG_P (M3c-2, weak inversion included) with the integer reader `lg_fine` of mos_table.t27, which
; returns a current in IUNIT = 1.164 pA, and builds three things on it: the DC output of a two-input gate, the tgate's resistance and the tgate's off leakage. Nothing is copied from the
; inverter: its bisection (`dc_out`) is the one-device case of `gt_nand_y` below, where the stack's middle node is solved inside it.
; -
; THE GATE. `gt_nand_y(ts, tq, a, b)` is the DC output of a series stack of two devices of table ts (gates a and b, bottom source on the rail the output is measured from) against a
; parallel pair of table tq (gates VDD - a and VDD - b from the other rail): the largest y at which the stack's current does not exceed the pair's, by bisection on integer reads (the
; stack's current rises with y, the pair's falls), and for each y the middle node of the stack, where the bottom device's current equals the top device's, by a second bisection
; (`gt_mid`: the bottom current rises with the node and the top current falls, so there is one root). The nand is that call with the NMOS as the stack. The nor is the same call seen
; from the supply: the PMOS as the stack, the inputs mirrored (VDD - a), the output taken from the rail. A gate whose gate sits below its source reads the table at 0 (the tables
; stop at 0 V). The voltages are 2^-24 V words, the output resolution is 1 word = 59.6 nV, the currents are IUNIT words.
; THE TGATE. `gt_tg_i`: conducting (PMOS gate 0 V, NMOS gate Vdd), the input 10 mV above the output vout: the NMOS reads (Vdd - vout, 10 mV), its source being the output, the PMOS
; reads (vin, 10 mV), its source being the input, and the current is the sum. The resistance is 10 mV over it, at the 27 outputs 0.10 V, 0.15 V, .. 1.40 V (`gt_tg_ron`, `gt_tg_worst`;
; sar_off_ron.cir measures the golden tgate the same way). Off (PMOS gate Vdd, NMOS gate 0 V), the input at Vdd and the output at 0 V: both devices at Vgs = 0, Vds = Vdd, and the
; leakage is the sum of their two table words (`gt_tg_off`).
; -
; THE REFERENCE. ngspice-47 with the IHP SG13G2 PSP103 of IHP-Open-PDK 21133f21, mos_tt, 27 C, on the reference host (a container, 2 threads), 2026-10-20, three decks of
; specs/analog/decks: accept_gates.cir (the eight gate outputs, the off tgate), accept_tgate.cir (the conducting tgate, two cells), accept_switch.cir (used by accept_sar.t27).
; The levels are the DC solution with no load, which is what a gate settles to into 10 fF. The numbers are the GT_NG_* constants below, none changed after printing.
; -
; THE RESULT, our model against that run.
;   levels   the distance of each output from its ideal level (1.5 V minus a 1, a 0 itself), nand A B = 00, 01, 10, 11 / nor 00, 01, 10, 11, in uV:
;            nand  ours 0.179 0.477 0.477 0.179      ngspice 0.316 0.721 0.687 2.537      worst gap 2.358 uV (nand 11)
;            nor   ours 1.848 0.060 0.060 0.060      ngspice 2.883 0.634 0.617 0.611      worst gap 1.036 uV (nor 00)
;            Every level of both gates is within 3 uV of 1.5 V or 0 V: the limit of the external team's report is 50 mV. The bar of the cross-check is 10 uV (GT_B_LEVEL_V), set at
;            four times the worst gap: it says the model and ngspice put the output at the same microvolts, and the 50 mV verdicts do not depend on it.
;   leakage  the tgate off: ours 291.0 pA (NMOS 261 pA + PMOS 30 pA of the table words at Vgs = 0, Vds = 1.5 V); ngspice 285.6 pA at the output source and 271.4 pA at the input source
;            (the two differ by 14 pA, the size of a junction leakage that sits in different terminals of the two sources; the terms are not separated here): +1.9 % and +7.2 %. The bar is 10 % (GT_B_REL).
;   Ron      ours 1718.0 ohm at 0.75 V and 2109.3 ohm at the worst of the 27 points; ngspice's REAL cell 2459.6 ohm and 2776.1 ohm: ours is 30.2 % and 24.0 % below. THE TABLES HAVE NO BODY
;            EFFECT, and the real cell has bulks on the rails: while the tgate conducts at 0.75 V the NMOS source is 0.75 V above its bulk and the PMOS source 0.75 V below its bulk, which
;            raises both thresholds. That is not an assumption: accept_tgate.cir also runs the same two devices with each bulk tied to its own source (the condition the tables were made
;            under), and there our model is within 0.06 % of ngspice at all 27 points (the largest gap 0.0588 %) (ngspice 1717.2 ohm at 0.75 V, 2108.4 ohm at the worst). The bar of 10 % refuses the real cell by
;            3 times at 0.75 V and 2.4 times at the worst point, so the tgate's Ron rows of accept_sar.t27 are NOT MODELLED, with our numbers and ngspice's shown.
;   the external team's report has 2.44 kohm at 0.75 V, 2.78 kohm worst and 0.29 nA: ngspice's real cell gives 2.46 kohm (0.8 % over), 2.78 kohm (0.1 % under) and 0.286 nA, so the
;            reference run reproduces the report; the report's numbers are the report's, ours are the functions here.
; -
; THE NEGATIVE CONTROLS (FR-004), each a test that passes by seeing the failure. The nand with the PMOS table zeroed never rises (its 1 levels are under 0.4 mV, 1.5 V off); with the NMOS
; zeroed its 11 output stays at 1.5 V; the nand's output read where the nor has a 0 is 1.5 V off. The tgate's leakage with the NMOS table in both slots is 521.5 pA, 82.6 % over ngspice's, and
; with the NMOS zeroed 30.3 pA, 89 % under; its Ron at 0.75 V with the PMOS zeroed is 2895 ohm and with the NMOS zeroed 4225 ohm, 69 % and 146 % over the no-body-effect cell: the bar of 10 %
; refuses each. THE LIMIT OF THE LEVEL CONTROL: the two tables in each other's slots (a 3 um stack and a 1 um pair) leave every level within 0.69 uV (nand) and 2.7 uV (nor) of ngspice's,
; inside the bar, because a level is the leakage of the off side times the resistance of the on side and both are microvolts for either width: a level check does not see a device's
; width, and a test pins that (the leakage and the resistance see it).
; -
; WHAT A PASS SAYS. The tt log tables of the two devices, read by the integer reader and solved for the nand, nor and tgate cells of the golden netlist, give the gates' output levels
; within 2.4 uV of ngspice's, and the tgate's off leakage within 7.2 % of it, at 27 C with no load. WHAT IT DOES NOT SAY. The Ron of the real cell: it is 30 % off, for the body effect
; (the tables have no source-to-bulk voltage, and no test here pretends otherwise: the no-body-effect run agrees to 0.06 % and the real cell does not). Nothing about delay or a transient
; into 10 fF (the DC level is what the gate settles to), another corner or temperature (tt, 27 C only), mismatch, noise or power; the leakage is one bias (full swing) and its two junction
; terms are not separated. The model is a TABLE MODEL of PSP103, not PSP103. ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogMosPsp103Gates;

use analog::mos_table::{VDD, lg_fine, dpos};
use analog::mos_psp103::{UPV, IUNIT_A};
use analog::mos_psp103_data::{TT_LG_N, TT_LG_P};

pub const KIND : str = "analog-cell-check";
pub const ID : str = "analog/mos_psp103_gates";
pub const REFERENCE : str = "IHP-Open-PDK 21133f21 sg13_lv_nmos/pmos (PSP103) through ngspice-47; decks specs/analog/decks/accept_gates.cir, accept_tgate.cir";

/// 10 mV across the tgate in units of 2^-24 V (167772.16, rounded down): the small signal of the Ron measurement.
pub const GT_DV : u32 = 167772;
/// The Ron sweep: the output at 0.10 V + 0.05 V k, k = 0 .. 26, so 0.10 V to 1.40 V; the input is 10 mV above it. k = 13 is 0.75 V.
pub const GT_NV : u32 = 27;
/// The cross-check bar for a level: ours and ngspice's output within 10 uV of each other.
pub const GT_B_LEVEL_V : f64 = 0.00001;
/// The cross-check bar for a resistance or a current: 10 percent of ngspice's.
pub const GT_B_REL : f64 = 0.10;

; --- ngspice-47 + PSP103 mos_tt 27 C, the decks of specs/analog/decks (printed to 12 digits, none changed) ----------------------------------
/// accept_gates.cir: the nand's output distance from its ideal level in V, inputs A B = 00, 01, 10, 11 (the 1 levels as 1.5 V minus the output, the 0 level as the output).
pub const GT_NG_NAND : [4]f64 = [3.164692066182e-07, 7.208471957121e-07, 6.868970867657e-07, 2.537007301171e-06];
/// The nor's, inputs 00, 01, 10, 11 (the 1 level for 00 as 1.5 V minus the output).
pub const GT_NG_NOR : [4]f64 = [2.883448431801e-06, 6.342530482189e-07, 6.169936628426e-07, 6.113602654695e-07];
/// The tgate off, input 1.5 V and output 0 V: the current of the output source and of the input source in A.
pub const GT_NG_LEAK_OUT_A : f64 = 2.855936198881e-10;
pub const GT_NG_LEAK_IN_A : f64 = 2.71379799196e-10;
/// accept_tgate.cir: R = 10 mV / I of the REAL tgate (bulks on the rails), output 0.10 V + 0.05 V k, in ohm.
pub const GT_NG_RTG : [27]f64 = [
    1.385850169689e+03, 1.436940183067e+03, 1.495475607876e+03, 1.562989802067e+03, 1.641428551801e+03, 1.733192207340e+03, 1.840556415694e+03,
    1.961389669307e+03, 2.078911578725e+03, 2.175210690376e+03, 2.253511737344e+03, 2.323073375943e+03, 2.390489741297e+03, 2.459620200341e+03,
    2.531972294128e+03, 2.606525281963e+03, 2.679011255823e+03, 2.740623935101e+03, 2.776143506080e+03, 2.762403492626e+03, 2.676178974948e+03,
    2.531594339737e+03, 2.378836180061e+03, 2.242112927391e+03, 2.123359914762e+03, 2.019956253274e+03, 1.929212699950e+03
];
/// The same two devices with each bulk tied to its own source (the condition of the current tables).
pub const GT_NG_RNB : [27]f64 = [
    1.365215261225e+03, 1.403458829789e+03, 1.446658843102e+03, 1.494710454293e+03, 1.544561854305e+03, 1.587480372693e+03, 1.616151649472e+03,
    1.632407253458e+03, 1.641784068477e+03, 1.649200796891e+03, 1.658285597710e+03, 1.671581138101e+03, 1.690831976540e+03, 1.717208511895e+03,
    1.751432178725e+03, 1.793786279514e+03, 1.843992527380e+03, 1.900918901949e+03, 1.962070717373e+03, 2.022824967882e+03, 2.075454403590e+03,
    2.108373119070e+03, 2.107837939555e+03, 2.068816154170e+03, 2.007537559864e+03, 1.943503954402e+03, 1.884071056350e+03
];

; --- the gate ----------------------------------------------------------------------------------------------------
/// a - m, or 0 when m is larger: a device whose gate sits below its source reads the table at Vgs = 0 (the tables stop at 0).
pub fn gt_sub(a: u32, m: u32) -> u32 {
    return dpos(a as u64, m as u64) as u32;
}

/// The node between the two devices of a series stack of the table ts, the top one with gate a and its drain at y, the bottom one with gate b and its source on the rail: the
/// largest m at which the bottom device's current does not exceed the top's. The bottom current rises with m and the top current falls, so the bisection has one root.
pub fn gt_mid(ts: []const u32, a: u32, b: u32, y: u32) -> u32 {
    var lo : u32 = 0;
    var hi : u32 = y;
    while (hi - lo > 1) {
        const m : u32 = lo + ((hi - lo) >> 1);
        if (lg_fine(ts, b, m) > lg_fine(ts, gt_sub(a, m), y - m)) { hi = m; } else { lo = m; }
    }
    return lo;
}

/// The DC output of a two-input gate whose series stack is made of the table ts (gates a and b, source on the rail the output is measured from) and whose parallel pair is made
/// of the table tq (gates VDD - a and VDD - b from the other rail): the largest y at which the stack's current does not exceed the pair's (the inverter's bisection in
/// `dc_out`, with the stack's middle node solved inside it). Currents in IUNIT = 1.164 pA, voltages in units of 2^-24 V.
pub fn gt_nand_y(ts: []const u32, tq: []const u32, a: u32, b: u32) -> u32 {
    var lo : u32 = 0;
    var hi : u32 = VDD;
    while (hi - lo > 1) {
        const y : u32 = lo + ((hi - lo) >> 1);
        const m : u32 = gt_mid(ts, a, b, y);
        const i_s : u64 = lg_fine(ts, b, m);
        const i_q : u64 = lg_fine(tq, VDD - a, VDD - y) + lg_fine(tq, VDD - b, VDD - y);
        if (i_s > i_q) { hi = y; } else { lo = y; }
    }
    return lo;
}

/// The nand: two NMOS in series to ground (the stack is the NMOS table), two PMOS in parallel to the supply. Output in units of 2^-24 V.
pub fn gt_nand(tn: []const u32, tp: []const u32, a: u32, b: u32) -> u32 {
    return gt_nand_y(tn, tp, a, b);
}

/// The nor, the nand seen from the supply: two PMOS in series to the supply (the stack is the PMOS table, its inputs VDD - a and VDD - b), two NMOS in parallel to ground. The
/// output is the supply minus the distance the nand-shaped call finds below it.
pub fn gt_nor(tn: []const u32, tp: []const u32, a: u32, b: u32) -> u32 {
    return VDD - gt_nand_y(tp, tn, VDD - a, VDD - b);
}

/// The eight levels, the nand or the nor for the inputs A B = 00, 01, 10, 11 (code k = 2 A + B, a high input is VDD): one_v the lowest output of a logic 1 (1.5 V is ideal), zero_v
/// the highest output of a logic 0 (0 V is ideal), and gap_v the largest distance of a level from ngspice's (GT_NG_NAND or GT_NG_NOR), all in V.
pub struct Lv { one_v: f64, zero_v: f64, gap_v: f64 }

pub fn gt_levels(tn: []const u32, tp: []const u32, nor: bool) -> Lv {
    var one : f64 = 1.5;
    var zero : f64 = 0.0;
    var gap : f64 = 0.0;
    var k : u32 = 0;
    while (k < 4) {
        const a : u32 = (k / 2) * VDD;
        const b : u32 = (k % 2) * VDD;
        var out : u32 = 0;
        var is_one : bool = false;
        var want : f64 = 0.0;
        if (nor) {
            out = gt_nor(tn, tp, a, b);
            if (k == 0) { is_one = true; }
            want = GT_NG_NOR[k as usize];
        } else {
            out = gt_nand(tn, tp, a, b);
            if (k != 3) { is_one = true; }
            want = GT_NG_NAND[k as usize];
        }
        const v : f64 = (out as f64) / UPV;
        var dev : f64 = v;
        if (is_one) {
            dev = 1.5 - v;
            if (v < one) { one = v; }
        } else {
            if (v > zero) { zero = v; }
        }
        const g : f64 = dev - want;
        if (g > gap) { gap = g; }
        if (0.0 - g > gap) { gap = 0.0 - g; }
        k = k + 1;
    }
    return Lv { one_v: one, zero_v: zero, gap_v: gap };
}

; --- the tgate -----------------------------------------------------------------------------------------------------
/// The tgate conducting (PMOS gate 0 V, NMOS gate Vdd): the current from an input dv above the output vout to the output, in IUNIT. The NMOS source is the output, the PMOS
/// source the input: the NMOS reads (Vdd - vout, dv), the PMOS (vin, dv).
pub fn gt_tg_i(tn: []const u32, tp: []const u32, vout: u32, dv: u32) -> u64 {
    return lg_fine(tn, VDD - vout, dv) + lg_fine(tp, vout + dv, dv);
}

/// The output of the sweep point k of the Ron sweep, in units of 2^-24 V.
pub fn gt_tg_v(k: u32) -> u32 {
    return ((0.1 + 0.05 * (k as f64)) * UPV + 0.5) as u32;
}

/// The tgate's resistance in ohm at output vout: the voltage across it over the current.
pub fn gt_tg_ron(tn: []const u32, tp: []const u32, vout: u32) -> f64 {
    const i : f64 = (gt_tg_i(tn, tp, vout, GT_DV) as f64) * IUNIT_A;
    return ((GT_DV as f64) / UPV) / i;
}

/// The largest resistance over the 27 points, 0.10 V to 1.40 V.
pub fn gt_tg_worst(tn: []const u32, tp: []const u32) -> f64 {
    var w : f64 = 0.0;
    var k : u32 = 0;
    while (k < GT_NV) {
        const r : f64 = gt_tg_ron(tn, tp, gt_tg_v(k));
        if (r > w) { w = r; }
        k = k + 1;
    }
    return w;
}

/// The largest relative distance |ours - ngspice| / ngspice of the resistance from a 27-point reference (GT_NG_RTG or GT_NG_RNB).
pub fn gt_ron_gap(tn: []const u32, tp: []const u32, refs: []const f64) -> f64 {
    var w : f64 = 0.0;
    var k : u32 = 0;
    while (k < GT_NV) {
        const want : f64 = refs[k as usize];
        var g : f64 = (gt_tg_ron(tn, tp, gt_tg_v(k)) - want) / want;
        if (g < 0.0) { g = 0.0 - g; }
        if (g > w) { w = g; }
        k = k + 1;
    }
    return w;
}

/// The largest of a 27-point reference.
pub fn gt_ref_max(refs: []const f64) -> f64 {
    var w : f64 = 0.0;
    var k : u32 = 0;
    while (k < GT_NV) {
        if (refs[k as usize] > w) { w = refs[k as usize]; }
        k = k + 1;
    }
    return w;
}

/// The tgate off (PMOS gate Vdd, NMOS gate 0 V), the input at Vdd and the output at 0 V: both devices at Vgs = 0 and Vds = Vdd, and the current is the sum of their table words, in A.
pub fn gt_tg_off(tn: []const u32, tp: []const u32) -> f64 {
    return ((lg_fine(tn, 0, VDD) + lg_fine(tp, 0, VDD)) as f64) * IUNIT_A;
}

; --- the tests ----------------------------------------------------------------------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test the_nand_levels_are_microvolts_from_the_rails_the_solver_brackets_its_roots_and_every_level_is_within_3_uV_of_ngspice {
    var a0 : u32 = 0;
    var a1 : u32 = VDD;
    // the words (59.6 nV): the 1 levels (inputs 00, 01, 10) are 3, 8 and 8 words under the supply, the 0 level (11) is 3 words over ground
    assert_eq(VDD - gt_nand(&TT_LG_N, &TT_LG_P, a0, a0), 3);
    assert_eq(VDD - gt_nand(&TT_LG_N, &TT_LG_P, a0, a1), 8);
    assert_eq(VDD - gt_nand(&TT_LG_N, &TT_LG_P, a1, a0), 8);
    assert_eq(gt_nand(&TT_LG_N, &TT_LG_P, a1, a1), 3);
    // the root is bracketed: at the output y the stack's current does not exceed the pair's, one word higher it does (inputs 01: the top device off, the bottom on)
    const y : u32 = gt_nand_y(&TT_LG_N, &TT_LG_P, a0, a1);
    const m0 : u32 = gt_mid(&TT_LG_N, a0, a1, y);
    const m1 : u32 = gt_mid(&TT_LG_N, a0, a1, y + 1);
    const pair0 : u64 = lg_fine(&TT_LG_P, VDD - a0, VDD - y) + lg_fine(&TT_LG_P, VDD - a1, VDD - y);
    const pair1 : u64 = lg_fine(&TT_LG_P, VDD - a0, VDD - y - 1) + lg_fine(&TT_LG_P, VDD - a1, VDD - y - 1);
    assert(lg_fine(&TT_LG_N, a1, m0) <= pair0);
    assert(lg_fine(&TT_LG_N, a1, m1) > pair1);
    // and the middle node of the stack with the top device on and the bottom off (inputs 10): it rises to where the bottom's leakage meets the top's current, and brackets the same way
    const y10 : u32 = gt_nand_y(&TT_LG_N, &TT_LG_P, a1, a0);
    const mm : u32 = gt_mid(&TT_LG_N, a1, a0, y10);
    assert(mm > 8388608);
    assert(lg_fine(&TT_LG_N, a0, mm) <= lg_fine(&TT_LG_N, gt_sub(a1, mm), y10 - mm));
    assert(lg_fine(&TT_LG_N, a0, mm + 1) > lg_fine(&TT_LG_N, gt_sub(a1, mm + 1), y10 - mm - 1));
    // the levels: the lowest 1 is 1.4999995 V, the highest 0 is 0.178 uV, and the worst gap to ngspice is 2.358 uV (11: 0.178 uV against 2.537 uV); the bar is 10 uV
    const nd : Lv = gt_levels(&TT_LG_N, &TT_LG_P, false);
    assert(nd.one_v > 1.4999995);
    assert(nd.one_v < 1.4999996);
    assert(nd.zero_v > 0.00000017);
    assert(nd.zero_v < 0.00000018);
    assert(nd.gap_v > 0.0000023);
    assert(nd.gap_v < 0.0000024);
    assert(nd.gap_v < GT_B_LEVEL_V);
    // ngspice's own levels are microvolts too (the report: 1.5 V for a 1, microvolts for a 0)
    assert(GT_NG_NAND[3] > 0.0000025);
    assert(GT_NG_NAND[3] < 0.0000026);
    assert(GT_NG_NAND[1] > 0.0000007);
    assert(GT_NG_NAND[1] < 0.0000008);
}

test the_nor_levels_are_the_nand_seen_from_the_supply_and_every_level_is_within_1_1_uV_of_ngspice {
    var a0 : u32 = 0;
    var a1 : u32 = VDD;
    // the 1 level (00) is 31 words under the supply (1.85 uV: two PMOS in series against two NMOS leaking in parallel), the 0 levels (01, 10, 11) are 1 word over ground
    assert_eq(VDD - gt_nor(&TT_LG_N, &TT_LG_P, a0, a0), 31);
    assert_eq(gt_nor(&TT_LG_N, &TT_LG_P, a0, a1), 1);
    assert_eq(gt_nor(&TT_LG_N, &TT_LG_P, a1, a0), 1);
    assert_eq(gt_nor(&TT_LG_N, &TT_LG_P, a1, a1), 1);
    const nr : Lv = gt_levels(&TT_LG_N, &TT_LG_P, true);
    assert(nr.one_v > 1.4999981);
    assert(nr.one_v < 1.4999982);
    assert(nr.zero_v > 0.00000005);
    assert(nr.zero_v < 0.00000007);
    assert(nr.gap_v > 0.0000010);
    assert(nr.gap_v < 0.0000011);
    assert(nr.gap_v < GT_B_LEVEL_V);
    assert(GT_NG_NOR[0] > 0.0000028);
    assert(GT_NG_NOR[0] < 0.0000029);
}

test a_gate_with_a_dead_device_table_or_the_wrong_gate_is_refused_and_the_tables_in_each_others_slots_are_not_and_that_is_the_limit_of_the_level_check {
    var dead : [4851]u32 = [0] ** 4851;
    var a0 : u32 = 0;
    var a1 : u32 = VDD;
    // NEGATIVE CONTROL, the PMOS never conducts (a zero table, F = 0): the output never rises (under 0.4 mV, the rounding of the off current to words), the 1 levels are 1.5 V away
    // and the gap to ngspice is 1.5 V
    const np : Lv = gt_levels(&TT_LG_N, &dead, false);
    assert(gt_nand(&TT_LG_N, &dead, a0, a0) < 20000);
    assert(np.one_v < 0.001);
    assert(np.gap_v > 1.499);
    assert(np.gap_v > 100000.0 * GT_B_LEVEL_V);
    // the NMOS never conducts: the nand's 11 stays at the supply, its 0 level is 1.5 V (the report's check, 50 mV, refuses it), the gap is 1.5 V
    const nn : Lv = gt_levels(&dead, &TT_LG_P, false);
    assert(nn.zero_v > 1.4999);
    assert(nn.gap_v > 1.4999);
    // NEGATIVE CONTROL, the wrong gate: the nand's output for 01 (a 1, 1.5 V) read where the nor has a 0 (0.63 uV): 1.5 V apart
    const wrong : f64 = (gt_nand(&TT_LG_N, &TT_LG_P, a0, a1) as f64) / UPV;
    assert(wrong > 1.4999);
    assert(wrong - GT_NG_NOR[1] > 1.4999);
    // THE LIMIT OF THE CONTROL: the two tables in each other's slots (a 3 um stack and a 1 um pair) are still rail to rail within 10 uV of ngspice's levels (0.69 uV for the nand,
    // 2.7 uV for the nor), because a level is the leakage of the off side times the on resistance of the other and both are microvolts either way. The cross-check on levels does not see
    // a device's width; the Ron and the leakage below do
    const ex : Lv = gt_levels(&TT_LG_P, &TT_LG_N, false);
    const ey : Lv = gt_levels(&TT_LG_P, &TT_LG_N, true);
    assert(ex.gap_v > 0.00000068);
    assert(ex.gap_v < 0.00000070);
    assert(ey.gap_v > 0.0000027);
    assert(ey.gap_v < 0.0000028);
    assert(ex.gap_v < GT_B_LEVEL_V);
    assert(ey.gap_v < GT_B_LEVEL_V);
}

test the_tgate_without_the_body_effect_is_within_0_07_percent_of_ngspice_at_all_27_points_where_the_two_cells_have_the_same_bulk_condition_as_the_tables {
    // accept_tgate.cir, second cell: each bulk tied to its own source, the condition the tables were made under. 1718.0 ohm at 0.75 V (ngspice 1717.2), 2109.3 ohm at the worst point
    // (ngspice 2108.4); the largest of the 27 relative gaps is 0.0588 %
    const r075 : f64 = gt_tg_ron(&TT_LG_N, &TT_LG_P, gt_tg_v(13));
    assert(r075 > 1717.9);
    assert(r075 < 1718.1);
    const worst : f64 = gt_tg_worst(&TT_LG_N, &TT_LG_P);
    assert(worst > 2109.2);
    assert(worst < 2109.4);
    assert(GT_NG_RNB[13] > 1717.2);
    assert(GT_NG_RNB[13] < 1717.3);
    assert(gt_ref_max(&GT_NG_RNB) > 2108.3);
    assert(gt_ref_max(&GT_NG_RNB) < 2108.4);
    const gap : f64 = gt_ron_gap(&TT_LG_N, &TT_LG_P, &GT_NG_RNB);
    assert(gap > 0.0005);
    assert(gap < 0.0007);
    assert(gap < GT_B_REL);
    // the sweep points: 0.10 V is output 1677722 words, 0.75 V is 12582912, 1.40 V is 23488102
    assert_eq(gt_tg_v(0), 1677722);
    assert_eq(gt_tg_v(13), 12582912);
    assert_eq(gt_tg_v(26), 23488102);
    // NEGATIVE CONTROL, a device missing from the cell: the PMOS never conducts, the NMOS alone is 2895 ohm at 0.75 V, 69 % over the no-body-effect cell; the NMOS never conducts, the
    // PMOS alone is 4225 ohm, 146 % over. The bar of 10 % refuses both, by 6.9 and 14.6 times
    var dead : [4851]u32 = [0] ** 4851;
    const rn : f64 = gt_tg_ron(&TT_LG_N, &dead, gt_tg_v(13));
    const rp : f64 = gt_tg_ron(&dead, &TT_LG_P, gt_tg_v(13));
    assert(rn > 2895.0);
    assert(rn < 2896.0);
    assert(rp > 4225.0);
    assert(rp < 4226.0);
    assert((rn - GT_NG_RNB[13]) / GT_NG_RNB[13] > 6.0 * GT_B_REL);
    assert((rp - GT_NG_RNB[13]) / GT_NG_RNB[13] > 14.0 * GT_B_REL);
    assert(gt_ron_gap(&TT_LG_N, &dead, &GT_NG_RNB) > 0.6);
}

test the_real_tgate_is_24_to_31_percent_above_the_tables_at_every_point_because_the_tables_have_no_body_effect_and_the_10_percent_bar_refuses_it {
    // accept_tgate.cir, first cell (bulks on the rails): 2459.6 ohm at 0.75 V (the external team's report 2.44 kohm) and 2776.1 ohm at the worst point, 1.0 V (the report 2.78 kohm).
    // Ours are 1718.0 and 2109.3 ohm: 30.2 % and 24.0 % below; the largest of the 27 gaps is 31.1 %
    assert(GT_NG_RTG[13] > 2459.6);
    assert(GT_NG_RTG[13] < 2459.7);
    assert(gt_ref_max(&GT_NG_RTG) > 2776.1);
    assert(gt_ref_max(&GT_NG_RTG) < 2776.2);
    const r075 : f64 = gt_tg_ron(&TT_LG_N, &TT_LG_P, gt_tg_v(13));
    const g075 : f64 = (GT_NG_RTG[13] - r075) / GT_NG_RTG[13];
    assert(g075 > 0.301);
    assert(g075 < 0.302);
    const worst : f64 = gt_tg_worst(&TT_LG_N, &TT_LG_P);
    const gw : f64 = (gt_ref_max(&GT_NG_RTG) - worst) / gt_ref_max(&GT_NG_RTG);
    assert(gw > 0.240);
    assert(gw < 0.241);
    const gap : f64 = gt_ron_gap(&TT_LG_N, &TT_LG_P, &GT_NG_RTG);
    assert(gap > 0.311);
    assert(gap < 0.312);
    // the bar of 10 % refuses the real cell by 3 times at 0.75 V and 2.4 times at the worst point
    assert(g075 > 3.0 * GT_B_REL);
    assert(gw > 2.4 * GT_B_REL);
    // the body effect only raises a resistance: at every one of the 27 points ngspice's real cell is above the table model, and above the no-body-effect cell
    var k : u32 = 0;
    var above : bool = true;
    var above_nb : bool = true;
    while (k < GT_NV) {
        if (gt_tg_ron(&TT_LG_N, &TT_LG_P, gt_tg_v(k)) >= GT_NG_RTG[k as usize]) { above = false; }
        if (GT_NG_RNB[k as usize] >= GT_NG_RTG[k as usize]) { above_nb = false; }
        k = k + 1;
    }
    assert(above);
    assert(above_nb);
}

test the_tgate_off_leakage_is_291_pA_against_ngspices_286_pA_at_the_output_and_271_pA_at_the_input_and_two_nmos_tables_are_refused {
    // the sum of the two table words at Vgs = 0, Vds = 1.5 V: the NMOS 224 words (261 pA), the PMOS 26 words (30 pA); 291.0 pA
    const off : f64 = gt_tg_off(&TT_LG_N, &TT_LG_P);
    assert(off > 0.000000000291);
    assert(off < 0.0000000002911);
    assert(GT_NG_LEAK_OUT_A > 0.000000000285);
    assert(GT_NG_LEAK_OUT_A < 0.000000000286);
    assert(GT_NG_LEAK_IN_A > 0.000000000271);
    assert(GT_NG_LEAK_IN_A < 0.000000000272);
    const g_out : f64 = (off - GT_NG_LEAK_OUT_A) / GT_NG_LEAK_OUT_A;
    const g_in : f64 = (off - GT_NG_LEAK_IN_A) / GT_NG_LEAK_IN_A;
    // +1.9 % and +7.2 %: inside the bar of 10 % at both sources
    assert(g_out > 0.019);
    assert(g_out < 0.0191);
    assert(g_in > 0.0723);
    assert(g_in < 0.0725);
    assert(g_out < GT_B_REL);
    assert(g_in < GT_B_REL);
    // NEGATIVE CONTROL: the NMOS table in both slots leaks 521.5 pA, 82.6 % over the output source's, 8 times the bar; the PMOS alone (the NMOS dead) 30.3 pA, 89 % under
    var dead : [4851]u32 = [0] ** 4851;
    const two : f64 = gt_tg_off(&TT_LG_N, &TT_LG_N);
    const only_p : f64 = gt_tg_off(&dead, &TT_LG_P);
    assert(two > 0.000000000521);
    assert(two < 0.000000000522);
    assert((two - GT_NG_LEAK_OUT_A) / GT_NG_LEAK_OUT_A > 8.0 * GT_B_REL);
    assert(only_p > 0.0000000000302);
    assert(only_p < 0.0000000000303);
    assert((GT_NG_LEAK_OUT_A - only_p) / GT_NG_LEAK_OUT_A > 8.0 * GT_B_REL);
}
