; --- helpers -----------------------------------------------------------------------------------------------
/// The largest |a[i] - b[i]| over the first n entries.
pub fn vc_maxdiff(a: []const f64, b: []const f64, n: usize) -> f64 {
    var worst : f64 = 0.0;
    var i : usize = 0;
    while (i < n) {
        const d : f64 = fabs64(a[i] - b[i]);
        if (d > worst) { worst = d; }
        i = i + 1;
    }
    return worst;
}

/// The smallest |a[i] - b[i]| over the first n entries.
pub fn vc_mindiff(a: []const f64, b: []const f64, n: usize) -> f64 {
    var best : f64 = fabs64(a[0] - b[0]);
    var i : usize = 1;
    while (i < n) {
        const d : f64 = fabs64(a[i] - b[i]);
        if (d < best) { best = d; }
        i = i + 1;
    }
    return best;
}

/// |x - y| <= tol.
pub fn vc_within(x: f64, y: f64, tol: f64) -> bool {
    return fabs64(x - y) <= tol;
}

/// 1 when dp is above dn.
pub fn vc_win(dp: f64, dn: f64) -> u32 {
    if (dp > dn) { return 1; }
    return 0;
}

/// How many of the first n runs have a winner different from the flags (1 = dp wins).
pub fn vc_mismatch(dp: []const f64, dn: []const f64, flags: []const u32, n: usize) -> u32 {
    var bad : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        if (vc_win(dp[i], dn[i]) != flags[i]) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

/// The magnitude (units) of the last scan point where dn still wins, scanning from the most negative d to the least: the lower end of the flip bracket. 0 if dp wins everywhere.
pub fn vc_bracket_lo(d: []const u32, dp: []const f64, dn: []const f64, n: usize) -> u32 {
    var lo : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        if (vc_win(dp[i], dn[i]) == 0) { lo = d[i]; }
        i = i + 1;
    }
    return lo;
}

/// The magnitude of the first scan point where dp wins (the upper end of the flip bracket); 0 if dn wins everywhere.
pub fn vc_bracket_hi(d: []const u32, dp: []const f64, dn: []const f64, n: usize) -> u32 {
    var i : usize = 0;
    while (i < n) {
        if (vc_win(dp[i], dn[i]) == 1) { return d[i]; }
        i = i + 1;
    }
    return 0;
}

/// True when the winner changes once only along the scan (dn, dn, .., dp, dp): the flip is a single point.
pub fn vc_monotone(dp: []const f64, dn: []const f64, n: usize) -> bool {
    var seen_dp : bool = false;
    var i : usize = 0;
    while (i < n) {
        if (vc_win(dp[i], dn[i]) == 1) { seen_dp = true; }
        if (seen_dp) {
            if (vc_win(dp[i], dn[i]) == 0) { return false; }
        }
        i = i + 1;
    }
    return true;
}

/// The model's first output and resolution time (ps after the clock) for the input h (units), orientation swap.
pub fn vc_model_first_ps(h: u32, swap: bool) -> f64 {
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    sp_run(&TT50_N, &TT50_P, h, swap, SC_K, &SC_DV_M, &out, &res);
    return sp_first(&out) * 0.1;
}

/// The model's resolution time, the same run.
pub fn vc_model_res_ps(h: u32, swap: bool) -> f64 {
    var out : [1128]u32 = [0] ** 1128;
    var res : [140]u32 = [0] ** 140;
    sp_run(&TT50_N, &TT50_P, h, swap, SC_K, &SC_DV_M, &out, &res);
    return sp_res(&out) * 0.1;
}

; --- the tests: the comparator --------------------------------------------------------------------------------

test vacask_and_ngspice_agree_on_the_comparators_times_within_the_stated_tolerance {
    // sar_cmp_psp_real.cir against vacask_cmp_real.sim, the same PSP103 file: the decision, resolution and Valid times at the 7 magnitudes and both signs. ngspice's numbers are
    // the committed pins of sar_comparator_psp.t27 (the host run of 2026-10-20 reproduces them to the last digit); VACASK's are this file's.
    const f_p : f64 = vc_maxdiff(&VK_FIRST_PS_P, &NG_RL_FIRST_PS, 7);
    const f_m : f64 = vc_maxdiff(&VK_FIRST_PS_M, &NG_RL_FIRST_PS, 7);
    const r_p : f64 = vc_maxdiff(&VK_RES_PS_P, &NG_RL_RES_PS, 7);
    const r_m : f64 = vc_maxdiff(&VK_RES_PS_M, &NG_RL_RES_PS, 7);
    const v_p : f64 = vc_maxdiff(&VK_VALID_PS_P, &NG_RL_VALID_PS_P, 7);
    const v_m : f64 = vc_maxdiff(&VK_VALID_PS_M, &NG_RL_VALID_PS_M, 7);
    // Inside the tolerance ...
    assert f_p < TOL_FIRST_PS;
    assert f_m < TOL_FIRST_PS;
    assert v_p < TOL_FIRST_PS;
    assert v_m < TOL_FIRST_PS;
    assert r_p < TOL_RES_PS;
    assert r_m < TOL_RES_PS;
    // ... and the observed maxima from below, so a copied column or a loosened bound is noticed: 0.1250 and 0.1245, 0.1375 and 0.1360, 0.0653 and 0.0635.
    assert f_p > 0.124;
    assert f_m > 0.124;
    assert v_p > 0.136;
    assert v_m > 0.135;
    assert r_p > 0.065;
    assert r_m > 0.063;
    // The first point is the headline: 523.032 ps against 522.910 ps, -0.023 %.
    const rel : f64 = (VK_FIRST_PS_P[0] - NG_RL_FIRST_PS[0]) / NG_RL_FIRST_PS[0];
    assert rel < 0.0 - 0.00022;
    assert rel > 0.0 - 0.00025;
    // The clock's 50 % point is the deck's: 200.8 ps in both.
    assert NG_RL_TCK_PS > 200.7;
    assert NG_RL_TCK_PS < 200.9;
}

test every_winner_of_both_comparators_is_the_same_in_vacask_and_ngspice {
    // 14 runs for xb (the bare latch) and 14 for xtop (with its loads): dp wins for VDP > VDN and dn for VDP < VDN in the bare latch; the top favours dp by 0.15 mV, so for -2h dn
    // wins only while 2h exceeds that (h = 16777 and 4194). VACASK has the same winner as ngspice in every one of the 28 runs.
    assert_eq(vc_mismatch(&VK_BDP_P, &VK_BDN_P, &NG_RL_BARE_WIN_P, 7), 0);
    assert_eq(vc_mismatch(&VK_BDP_M, &VK_BDN_M, &NG_RL_BARE_WIN_M, 7), 0);
    assert_eq(vc_mismatch(&VK_XDP_P, &VK_XDN_P, &NG_RL_TOP_WIN_P, 7), 0);
    assert_eq(vc_mismatch(&VK_XDP_M, &VK_XDN_M, &NG_RL_TOP_WIN_M, 7), 0);
    // The bare latch over the scan: dn wins at all six negative differences, in both.
    assert_eq(vc_mismatch(&VK_SCAN_BDP, &VK_SCAN_BDN, &NG_RL_SCAN_BARE_WIN, 6), 0);
    // The top over the scan differs at exactly the two points between the two flip points (-2571 and -2570 units): dn wins there in ngspice, dp in VACASK.
    assert_eq(vc_mismatch(&VK_SCAN_XDP, &VK_SCAN_XDN, &NG_RL_SCAN_TOP_WIN, 6), 2);
    assert_eq(vc_win(VK_SCAN_XDP[2], VK_SCAN_XDN[2]), 1);
    assert_eq(vc_win(VK_SCAN_XDP[3], VK_SCAN_XDN[3]), 1);
    assert_eq(NG_RL_SCAN_TOP_WIN[2], 0);
    assert_eq(NG_RL_SCAN_TOP_WIN[3], 0);
    // The end values are decided, not marginal: the loser is below 0.1 V at every input but the smallest (h = 1: 0.084 V, 7 times as large as at h = 8, still decided).
    var k : usize = 0;
    var decided : u32 = 0;
    while (k < 7) {
        if (VK_BDN_P[k] < 0.1) { decided = decided + 1; }
        if (VK_BDP_M[k] < 0.1) { decided = decided + 1; }
        k = k + 1;
    }
    assert_eq(decided, 14);
}

test the_flip_points_the_bare_latch_at_zero_and_the_tops_within_46_units_of_ngspices {
    // xb, the bare latch: no flip point to speak of. The right winner at h = 1 (VDP - VDN = +-2 units) in both orientations, in both simulators, so the flip is inside (-2, 2) units; the
    // model's flip (sp_flip, bisection on the fixed-point comparator) is at most 2 units from zero, 0.12 uV.
    assert_eq(vc_win(VK_BDP_P[6], VK_BDN_P[6]), 1);
    assert_eq(vc_win(VK_BDP_M[6], VK_BDN_M[6]), 0);
    assert_eq(NG_RL_BARE_WIN_P[6], 1);
    assert_eq(NG_RL_BARE_WIN_M[6], 0);
    const fm : i64 = sp_flip(&TT50_N, &TT50_P, &SC_DV_M);
    const fa : f64 = fabs64((fm as f64));
    assert fa <= 2.0;
    // xtop: ngspice's flip is in (-2570, -2540] units from its scan, VACASK's in (-2586, -2582] from the finer scan; the winner changes once along each scan.
    assert vc_monotone(&VK_FINE_XDP, &VK_FINE_XDN, 8);
    assert vc_monotone(&VK_SCAN_XDP, &VK_SCAN_XDN, 6);
    const vk_lo : u32 = vc_bracket_lo(&FINE_D, &VK_FINE_XDP, &VK_FINE_XDN, 8);
    const vk_hi : u32 = vc_bracket_hi(&FINE_D, &VK_FINE_XDP, &VK_FINE_XDN, 8);
    assert_eq(vk_lo, 2586);
    assert_eq(vk_hi, 2582);
    const ng_lo : u32 = vc_bracket_lo(&SCAN_D, &NG_SCAN_XDP, &NG_SCAN_XDN, 6);
    const ng_hi : u32 = vc_bracket_hi(&SCAN_D, &NG_SCAN_XDP, &NG_SCAN_XDN, 6);
    assert_eq(ng_lo, 2570);
    assert_eq(ng_hi, 2540);
    // The flip bracket of VACASK is below ngspice's (a larger magnitude: the top favours dp by more), and the two are 12 to 46 units apart: at least vk_hi - ng_lo, at most
    // vk_lo - ng_hi. 46 units is 2.7 uV, 1.8 % of the 0.153 mV offset, the size of ngspice's own dependence on its tolerance (10 units between reltol 1e-6 and 1e-8).
    const gap_min : u32 = vk_hi - ng_lo;
    const gap_max : u32 = vk_lo - ng_hi;
    assert_eq(gap_min, 12);
    assert_eq(gap_max, 46);
    assert gap_max <= TOL_FLIP_UNITS;
    const gap_uv : f64 = (gap_max as f64) * UNIT_V * 1000000.0;
    assert gap_uv > 2.7;
    assert gap_uv < 2.8;
    // The offset itself, in mV: -0.1541 .. -0.1539 (VACASK) against -0.1532 .. -0.1514 (ngspice): the same sign, the same 0.15 mV.
    const vk_mv : f64 = (vk_hi as f64) * UNIT_V * 1000.0;
    const ng_mv : f64 = (ng_lo as f64) * UNIT_V * 1000.0;
    assert vk_mv > 0.1538;
    assert vk_mv < 0.1541;
    assert ng_mv > 0.1531;
    assert ng_mv < 0.1533;
    // The same asymmetry in the Valid time at -+2 mV: VACASK 920.548 - 897.567 = 22.98 ps, ngspice 22.92 ps.
    const dv_vk : f64 = VK_VALID_PS_M[0] - VK_VALID_PS_P[0];
    const dv_ng : f64 = NG_RL_VALID_PS_M[0] - NG_RL_VALID_PS_P[0];
    assert vc_within(dv_vk, dv_ng, 0.1);
    assert dv_vk > 22.9;
    assert dv_vk < 23.1;
}

test the_pre_clock_waveforms_of_the_two_simulators_agree_from_one_picosecond_on {
    // The comparator's start is a uic start from a state that is not a solution; in both simulators the outputs jump to about 1.2 V in the first step and fall back through 0.75 V at
    // about 150 ps. The first step differs by 31 mV (1.2197 V against 1.2509 V); from 1 ps on the two waveforms agree within 0.4 mV, from 30 ps on within 0.15 mV.
    const first : f64 = fabs64(VK_PRE_005_V - NG_PRE_005_V);
    assert first > 0.031;
    assert first < 0.032;
    const all : f64 = vc_maxdiff(&VK_PRE_V, &NG_PRE_V, 12);
    assert all < TOL_PRE_V;
    assert all > 0.00034;
    var late : f64 = 0.0;
    var k : usize = 3;
    while (k < 12) {
        const d : f64 = fabs64(VK_PRE_V[k] - NG_PRE_V[k]);
        if (d > late) { late = d; }
        k = k + 1;
    }
    assert late < 0.00015;
    assert late > 0.0001;
    // The falling crossing of 0.75 V is between 100 and 190 ps, near 150 ps, in both: the values at 100 ps are above and at 190 ps below.
    assert NG_PRE_V[5] > 0.75;
    assert VK_PRE_V[5] > 0.75;
    assert NG_PRE_V[7] < 0.75;
    assert VK_PRE_V[7] < 0.75;
    assert PRE_T_PS[5] > 99.0;
    assert PRE_T_PS[5] < 101.0;
    // The 0.75 V crossing itself, by linear interpolation between 100 and 150 ps: ngspice puts it at 150.417 ps, VACASK at 150.428 ps (the waveform falls at 2 mV/ps there).
    const cn : f64 = PRE_T_PS[5] + (PRE_T_PS[6] - PRE_T_PS[5]) * (NG_PRE_V[5] - 0.75) / (NG_PRE_V[5] - NG_PRE_V[6]);
    const cv : f64 = PRE_T_PS[5] + (PRE_T_PS[6] - PRE_T_PS[5]) * (VK_PRE_V[5] - 0.75) / (VK_PRE_V[5] - VK_PRE_V[6]);
    assert vc_within(cn, cv, 0.05);
}

test our_comparator_model_is_98_and_155_times_too_fast_against_both_simulators {
    // The model (specs/analog/sar_comparator_psp.t27, currents only: no charge) decides in 5.350 ps and resolves in 7.186 ps at +2 mV; ngspice's real-charge comparator takes 523.032 ps
    // and 1111.910 ps. VACASK's 522.910 ps and 1111.845 ps give the same ratio to 0.03 %: the discrepancy is the model's (the charge tables, #10777, are what is missing).
    var k : usize = 0;
    while (k < 6) {
        const f_ps : f64 = vc_model_first_ps(SP_H[k], false);
        const r_ps : f64 = vc_model_res_ps(SP_H[k], false);
        const rf_ng : f64 = NG_RL_FIRST_PS[k] / f_ps;
        const rf_vk : f64 = VK_FIRST_PS_P[k] / f_ps;
        const rr_ng : f64 = NG_RL_RES_PS[k] / r_ps;
        const rr_vk : f64 = VK_RES_PS_P[k] / r_ps;
        // The same band as sar_comparator_psp.t27's own check, now for both simulators.
        assert !(rf_ng < 95.5);
        assert !(rf_ng > 98.0);
        assert !(rf_vk < 95.5);
        assert !(rf_vk > 98.0);
        assert !(rr_ng < 154.0);
        assert !(rr_ng > 183.5);
        assert !(rr_vk < 154.0);
        assert !(rr_vk > 183.5);
        // VACASK and ngspice judge the model alike: the two ratios differ by under 0.03 % (decision) and 0.007 % (resolution).
        assert vc_within(rf_vk / rf_ng, 1.0, 0.0003);
        assert vc_within(rr_vk / rr_ng, 1.0, 0.00007);
        k = k + 1;
    }
    const f0 : f64 = vc_model_first_ps(SP_H[0], false);
    const r0 : f64 = vc_model_res_ps(SP_H[0], false);
    assert f0 > 5.34;
    assert f0 < 5.36;
    assert r0 > 7.18;
    assert r0 < 7.19;
    assert NG_RL_FIRST_PS[0] / f0 > 97.7;
    assert VK_FIRST_PS_P[0] / f0 < 97.8;
}

; --- the tests: the capacitive DAC ----------------------------------------------------------------------------

test the_dac_top_plate_voltage_is_the_same_in_vacask_ngspice_and_the_closed_form {
    // 16 codes (NG_SPOT) of one half, ideal capacitors, sampled at 0.75 V: ngspice's one long run (its host run and the committed table NG_HALF), VACASK's 30 ns per code, the closed
    // form 1.5 c / 1023 (sar_cdac.t27: the bridge's gain error, no bend), and the fixed-point model (ten M1 steps per code).
    var cf : [16]f64 = [0.0] ** 16;
    var half : [16]f64 = [0.0] ** 16;
    var mdl : [16]f64 = [0.0] ** 16;
    var k : usize = 0;
    while (k < 16) {
        const code : u32 = NG_SPOT[k];
        cf[k] = 1.5 * (code as f64) / 1023.0;
        half[k] = NG_HALF[code as usize];
        const n : CdacNodes = convert(code, VS_HALF);
        mdl[k] = sm_f64(n.m);
        k = k + 1;
    }
    const vk_cf : f64 = vc_maxdiff(&VK_DAC_M, &cf, 16);
    const vk_ng : f64 = vc_maxdiff(&VK_DAC_M, &NG_DAC_M, 16);
    const vk_half : f64 = vc_maxdiff(&VK_DAC_M, &half, 16);
    const ng_cf : f64 = vc_maxdiff(&NG_DAC_M, &cf, 16);
    const vk_mdl : f64 = vc_maxdiff(&VK_DAC_M, &mdl, 16);
    // VACASK is at the closed form to 2e-15 V; ngspice's long run is up to 1.18e-12 V from it (1.0 .. 1.4e-12), so VACASK is within 1.4e-12 V of ngspice's host run and of the committed table.
    assert vk_cf < TOL_DAC_CF_V;
    assert vk_ng < TOL_DAC_NG_V;
    assert vk_half < TOL_DAC_NG_V;
    assert ng_cf < TOL_DAC_NG_V;
    assert ng_cf > 0.000000000001;
    assert vk_ng > 0.000000000001;
    // The model is the fixed-point one: within 1.74 units (1.04e-7 V) of the closed form and so of VACASK; its code 0 is one unit below 0 V.
    assert vk_mdl < TOL_DAC_MODEL_V;
    assert vk_mdl > 0.00000005;
    assert mdl[0] < 0.0;
    assert mdl[0] > 0.0 - 0.00000006;
    // The codes' order and meaning: 0, the single bits, 511, 513 and the two alternating patterns; the top plate rises by 1.5 / 1023 per code.
    assert VK_DAC_M[11] < VK_DAC_M[10];
    assert VK_DAC_M[12] > VK_DAC_M[10];
    assert vc_within(VK_DAC_M[13], 0.5, 0.000000000000002);
    assert vc_within(VK_DAC_M[14], 1.0, 0.000000000000002);
    assert vc_within(VK_DAC_M[15], 1.5, 0.000000000000002);
}

; --- the negative controls --------------------------------------------------------------------------------------

test the_checks_refuse_a_changed_integrator_a_wrong_start_and_wrong_numbers {
    // 1. VACASK with tran_xmu = 0.25 (a more Euler-like integration): the resolution time is 0.65 to 1.87 ps early at all 7 inputs, at least 8 times the 0.08 ps bound.
    const x_min : f64 = vc_mindiff(&VK_XMU_RES_PS_P, &NG_RL_RES_PS, 7);
    const x_max : f64 = vc_maxdiff(&VK_XMU_RES_PS_P, &NG_RL_RES_PS, 7);
    assert x_min > 0.65;
    assert x_min > 8.0 * TOL_RES_PS;
    assert x_max < 1.88;
    assert x_max > 1.86;
    var k : usize = 0;
    var refused : u32 = 0;
    while (k < 7) {
        if (!vc_within(VK_XMU_RES_PS_P[k], NG_RL_RES_PS[k], TOL_RES_PS)) { refused = refused + 1; }
        k = k + 1;
    }
    assert_eq(refused, 7);
    // 2. The plates left out of the ic list: every DAC code is 0.75 V high (all 16), 5e11 times the 1.4e-12 V bound.
    const u_min : f64 = vc_mindiff(&VK_DAC_UNLISTED, &NG_DAC_M, 16);
    const u_max : f64 = vc_maxdiff(&VK_DAC_UNLISTED, &NG_DAC_M, 16);
    assert u_min > 0.7499;
    assert u_max < 0.7501;
    assert u_min > 500000000000.0 * TOL_DAC_NG_V;
    // 3. A decision time moved by 1 ps, and by 0.3 ps, is refused; 0.1 ps still passes (a bound that is not a rubber band).
    assert !vc_within(VK_FIRST_PS_P[0] + 1.0, NG_RL_FIRST_PS[0], TOL_FIRST_PS);
    assert !vc_within(VK_FIRST_PS_P[0] + 0.3, NG_RL_FIRST_PS[0], TOL_FIRST_PS);
    assert vc_within(VK_FIRST_PS_P[0] + 0.1, NG_RL_FIRST_PS[0], TOL_FIRST_PS);
    // 4. The inputs exchanged (VDP and VDN swapped): the +2h list against the -2h flags and the reverse: every one of the 14 bare-latch winners is wrong.
    assert_eq(vc_mismatch(&VK_BDP_P, &VK_BDN_P, &NG_RL_BARE_WIN_M, 7), 7);
    assert_eq(vc_mismatch(&VK_BDP_M, &VK_BDN_M, &NG_RL_BARE_WIN_P, 7), 7);
    // 5. A claim that VACASK's flip point of xtop is ngspice's bracket (-2570 .. -2540): the finer scan puts VACASK's dp winning at -2582 and dn at -2586, outside it.
    const vk_hi : u32 = vc_bracket_hi(&FINE_D, &VK_FINE_XDP, &VK_FINE_XDN, 8);
    const ng_lo : u32 = vc_bracket_lo(&SCAN_D, &NG_SCAN_XDP, &NG_SCAN_XDN, 6);
    assert vk_hi > ng_lo;
    assert vc_win(VK_SCAN_XDP[2], VK_SCAN_XDN[2]) != NG_RL_SCAN_TOP_WIN[2];
    // 6. A wrong DAC pin: the values of code 511 and code 513 exchanged (they are 2.93 mV apart, two codes of 1.466 mV) are refused by the 1.4e-12 V bound.
    const sw : f64 = fabs64(VK_DAC_M[11] - VK_DAC_M[12]);
    assert sw > 0.0029;
    assert !vc_within(VK_DAC_M[12], NG_DAC_M[11], TOL_DAC_NG_V);
}
