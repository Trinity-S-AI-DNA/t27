/// The same, deck sar_sw_sn0 (the sine with a zero crossing up at step 328).
pub const SW_NG_CK_SN0 : [56]f64 = [
    6.306825280e-01, 1.295557076e+00, 3.956065768e-02, 4.726546923e-15, 1.527923540e+00, 2.764169448e-15, 1.160058980e+00,
    6.344526307e-01, 6.569488896e-01, 6.177645530e-01, 1.954700431e+00, 2.070386754e+00, 9.378305693e-01, 5.205259514e-02,
    6.388136703e-01, 7.132766827e-01, 7.141814874e-01, 2.151177925e+00, 2.162707442e+00, 1.070268941e+00, 8.004301088e-04,
    6.833559089e-01, 7.318454295e-01, 7.318463815e-01, 2.179375708e+00, 2.179385497e+00, 1.146010650e+00, 1.956521739e-15,
    7.487333884e-01, 7.499926794e-01, 7.499936235e-01, 2.197151177e+00, 2.197153714e+00, 1.149848484e+00, 1.956521739e-15,
    7.489730057e-01, 8.886361703e-01, 8.152377031e-01, 2.259051788e+00, 2.261152423e+00, 1.149850368e+00, 3.399410195e-01,
    7.489730057e-01, 1.451913864e+00, 4.772256103e-02, 2.179159436e-01, 1.498959445e+00, 1.181425829e-01, 1.447947405e+00,
    7.489730057e-01, 1.500000000e+00, 8.776279687e-03, 8.198503997e-09, 1.491223720e+00, 4.603892629e-09, 1.500000000e+00
];

; --- the bounds, each named ------------------------------------------------------------------------------
/// |OD - ngspice| for the fixed-point run: the table's soft knee leaves 0.2528 mV at the worst of the seven stimuli.
pub const SW_B_OD_V : f64 = 0.0004;
/// |TE - ngspice|: a floor of 3 uV (the settling the integer words stop at, 1.93 uV at the DC levels) plus 5 % of the ngspice value
/// (the table's on-resistance is 2.85 % high: 36.9 uV of 1266.7 uV at the zero crossing).
pub const SW_B_TE_ABS_V : f64 = 0.000003;
pub const SW_B_TE_REL : f64 = 0.05;
/// |injection step - ngspice|: 1 uV (the worst is 0.36 uV).
pub const SW_B_INJ_V : f64 = 0.000001;
/// |droop|: 1 nV. The square law has no leak, so both are round-off.
pub const SW_B_DROOP_V : f64 = 0.000000001;
/// The residual after any step of any run: SW_STOP's largest entry.
pub const SW_B_RES : u32 = 64;
/// The most iterations any step of the seven runs needs (the clock fall at step 333 of the sine trough).
pub const SW_NIT_MAX : u32 = 120;
/// Arithmetic error: fixed point against the fully converged real run of the same table, any node, any step, in units (247.4 measured).
pub const SW_B_ARITH_U : f64 = 260.0;
/// Table error: the real table run against the analytic law, any node, any step, in units (653576 measured: 39.0 mV at net5, step 35).
pub const SW_B_TABLE_U : f64 = 660000.0;
/// Model error: the analytic law against ngspice at the 8 x 7 recorded checkpoints, V (0.50 nV measured).
pub const SW_B_LAW_V : f64 = 0.000000001;
/// Discretization: ngspice on the 250 ps grid against ngspice on the 50 ps grid, for the sn0 stimulus.
pub const SW_B_DISC_OD_V : f64 = 0.004;
pub const SW_B_DISC_TE_V : f64 = 0.000005;
pub const SW_B_DISC_INJ_V : f64 = 0.000015;
/// The no-boost mutant against ngspice's own no-boost deck (2.85 mV measured).
pub const SW_B_NOCB_V : f64 = 0.005;

; --- helpers of the tests ----------------------------------------------------------------------------------
/// How many of the first n words exceed thr.
pub fn sw_cnt_gt(r: []const u32, n: u32, thr: u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (r[i as usize] > thr) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// The largest |a - b| over two runs' states, in units.
pub fn sw_maxdiff(a: []const f64, b: []const f64) -> f64 {
    var m : f64 = 0.0;
    var i : usize = 0;
    while (i < SW_LEN) {
        m = fmax64(m, fabs64(a[i] - b[i]));
        i = i + 1;
    }
    return m;
}

/// Where the largest |a - b| sits: step * 8 + node.
pub fn sw_argmax(a: []const f64, b: []const f64) -> usize {
    var m : f64 = 0.0;
    var at : usize = 0;
    var i : usize = 0;
    while (i < SW_LEN) {
        const d : f64 = fabs64(a[i] - b[i]);
        if (d > m) {
            m = d;
            at = i;
        }
        i = i + 1;
    }
    return at;
}

/// The largest |model - ngspice| over the 7 nodes at the 8 checkpoints, V; the model's states are real, in units.
pub fn sw_ck_dev(w: []const f64, ng: []const f64) -> f64 {
    var m : f64 = 0.0;
    var c : u32 = 0;
    while (c < 8) {
        var n : u32 = 0;
        while (n < 7) {
            m = fmax64(m, fabs64(sw_node_v(w, SW_CHK[c as usize], n) - ng[(c * 7 + n) as usize]));
            n = n + 1;
        }
        c = c + 1;
    }
    return m;
}

/// Is the value within the named bounds of ngspice's: abs + rel |ng|?
pub fn sw_within(v: f64, ng: f64, abs_b: f64, rel_b: f64) -> bool {
    return fabs64(v - ng) <= abs_b + rel_b * fabs64(ng);
}

/// cap_cmim of l um x w um, fF: C = CJ l w + 2 CJSW (l + w) with CJ = 1.5 fF/um^2 and CJSW = 0.04 fF/um (the IHP PDK at 21133f21,
/// ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib:22 and capacitors_mod.lib:58, instance line 72).
pub fn sw_cmim_ff(l: f64, w: f64) -> f64 {
    return 1.5 * l * w + 0.08 * (l + w);
}

/// The M4a DAC's capacitance at the top plate, in cap_cmim units: the 31 units of the MSB array plus the bridge unit in series with
/// the 31 units of the LSB array (the other plates sit at fixed voltages), from M4a's own counts.
pub fn sw_dac_top_units() -> f64 {
    const cl : f64 = side_sum(&UNITS, &SIDE, SIDE_L);
    const cm : f64 = side_sum(&UNITS, &SIDE, SIDE_M);
    const cb : f64 = (BRIDGE_UNITS) as f64;
    return cm + cb * cl / (cb + cl);
}

/// The largest |dG_i / dv_j (central difference, +-16 units) - J_ij| of the real system at v, for the step from v0, drv the clock and
/// Vin as words. With transposed set it compares against J_ji, which is wrong on purpose.
pub fn sw_fd_err(mode: u32, t: []const u32, v: []const f64, v0: []const f64, drv: []const f64, cbf: f64, mult: []const u32, transposed: bool) -> f64 {
    var j0 : [72]f64 = [0.0] ** 72;
    var jp : [72]f64 = [0.0] ** 72;
    var jq : [72]f64 = [0.0] ** 72;
    var vp : [8]f64 = [0.0] ** 8;
    var vq : [8]f64 = [0.0] ** 8;
    sw_stamp_f(mode, t, v, v0, drv, cbf, mult, &j0);
    var worst : f64 = 0.0;
    var j : u32 = 0;
    while (j < SC_NN) {
        var n : u32 = 0;
        while (n < SC_NN) {
            vp[n as usize] = v[n as usize];
            vq[n as usize] = v[n as usize];
            n = n + 1;
        }
        vp[j as usize] = v[j as usize] + 16.0;
        vq[j as usize] = v[j as usize] - 16.0;
        sw_stamp_f(mode, t, &vp, v0, drv, cbf, mult, &jp);
        sw_stamp_f(mode, t, &vq, v0, drv, cbf, mult, &jq);
        var i : u32 = 0;
        while (i < SC_NN) {
            const fd : f64 = (jp[(SC_FG + i) as usize] - jq[(SC_FG + i) as usize]) / 32.0;
            var an : f64 = j0[(i * SC_NN + j) as usize];
            if (transposed) { an = j0[(j * SC_NN + i) as usize]; }
            worst = fmax64(worst, fabs64(fd - an));
            i = i + 1;
        }
        j = j + 1;
    }
    return worst;
}

/// The widest word the fixed-point solve forms at the first iteration of the clock edges (steps 5, 6, 7, 331, 332, 333, 334, where the
/// Newton move is largest), as a real: the largest register, the largest matrix word before and after elimination, the elimination's
/// widest product (a multiplier of 2^20 at most times the largest word before), and the two sums of every row of the back substitution,
/// recomputed from the eliminated matrix and the solution exactly as sc_backsub forms them.
pub fn sw_headroom(t: []const u32, vin: []const u32, cb: u32, mult: []const u32) -> f64 {
    var v : [8]u32 = [0] ** 8;
    var info : [1]u32 = [0] ** 1;
    sw_rest(vin[0], &v);
    var wide : f64 = 0.0;
    var j : u32 = 1;
    while (j <= 335) {
        if (j == 5 or j == 6 or j == 7 or j == 331 or j == 332 or j == 333 or j == 334) {
            var v0 : [8]u32 = [0] ** 8;
            var n : u32 = 0;
            while (n < SC_NN) {
                v0[n as usize] = v[n as usize];
                n = n + 1;
            }
            var reg : [144]u64 = [0] ** 144;
            var a : [72]u64 = [0] ** 72;
            var x : [8]u64 = [0] ** 8;
            sw_stamp(t, &v, &v0, SW_OFF + sw_clk_at(j), SW_OFF + vin[j as usize], cb, mult, &reg);
            var q : usize = 0;
            while (q < 144) {
                wide = fmax64(wide, (reg[q]) as f64);
                q = q + 1;
            }
            sc_load(&reg, &a);
            const before : f64 = (sc_max_mag(&a, 72)) as f64;
            wide = fmax64(wide, before);
            wide = fmax64(wide, before * CELL_F);
            sc_eliminate(&a);
            sc_backsub(&a, &x);
            wide = fmax64(wide, (sc_max_mag(&a, 72)) as f64);
            var i : u32 = 0;
            while (i < SC_NN) {
                var pos : f64 = 0.0;
                var neg : f64 = 0.0;
                const b : u64 = a[(i * 9 + 8) as usize];
                if (sc_neg(b)) { neg = neg + ((sc_mag(b)) as f64) * CELL_F; } else { pos = pos + ((sc_mag(b)) as f64) * CELL_F; }
                var c : u32 = i + 1;
                while (c < SC_NN) {
                    const aij : u64 = a[(i * 9 + c) as usize];
                    const xj : u64 = x[c as usize];
                    const pr : f64 = ((sc_mag(aij)) as f64) * ((sc_mag(xj)) as f64);
                    if (sc_neg(aij) != sc_neg(xj)) { pos = pos + pr; } else { neg = neg + pr; }
                    c = c + 1;
                }
                wide = fmax64(wide, fmax64(pos, neg));
                i = i + 1;
            }
        }
        const r0 : u32 = sw_step(t, &v, j, vin[j as usize], cb, SW_K, mult, &info);
        j = j + 1;
    }
    return wide;
}

/// The largest |G_fixed - G_real| over the eight nodes at the fixed-point state v (both stamps on the same words, the table system),
/// in charge units x voltage units.
pub fn sw_gap_g(t: []const u32, v: []const u32, v0: []const u32, clkw: u32, vinw: u32, cb: u32, mult: []const u32) -> f64 {
    var reg : [144]u64 = [0] ** 144;
    sw_stamp(t, v, v0, clkw, vinw, cb, mult, &reg);
    var vf : [8]f64 = [0.0] ** 8;
    var v0f : [8]f64 = [0.0] ** 8;
    var n : u32 = 0;
    while (n < SC_NN) {
        vf[n as usize] = (v[n as usize]) as f64;
        v0f[n as usize] = (v0[n as usize]) as f64;
        n = n + 1;
    }
    var drv : [2]f64 = [0.0] ** 2;
    drv[0] = (clkw) as f64;
    drv[1] = (vinw) as f64;
    var jg : [72]f64 = [0.0] ** 72;
    sw_stamp_f(0, t, &vf, &v0f, &drv, (cb) as f64, mult, &jg);
    var worst : f64 = 0.0;
    n = 0;
    while (n < SC_NN) {
        const gx : f64 = (reg[(SC_RGP + n) as usize] as f64) - (reg[(SC_RGN + n) as usize] as f64);
        worst = fmax64(worst, fabs64(gx - jg[(SC_FG + n) as usize]));
        n = n + 1;
    }
    return worst;
}

/// The largest |J_fixed / 2^20 - J_real| over the 64 entries at the same state.
pub fn sw_gap_j(t: []const u32, v: []const u32, v0: []const u32, clkw: u32, vinw: u32, cb: u32, mult: []const u32) -> f64 {
    var reg : [144]u64 = [0] ** 144;
    sw_stamp(t, v, v0, clkw, vinw, cb, mult, &reg);
    var vf : [8]f64 = [0.0] ** 8;
    var v0f : [8]f64 = [0.0] ** 8;
    var n : u32 = 0;
    while (n < SC_NN) {
        vf[n as usize] = (v[n as usize]) as f64;
        v0f[n as usize] = (v0[n as usize]) as f64;
        n = n + 1;
    }
    var drv : [2]f64 = [0.0] ** 2;
    drv[0] = (clkw) as f64;
    drv[1] = (vinw) as f64;
    var jg : [72]f64 = [0.0] ** 72;
    sw_stamp_f(0, t, &vf, &v0f, &drv, (cb) as f64, mult, &jg);
    var worst : f64 = 0.0;
    var k : usize = 0;
    while (k < 64) {
        const jx : f64 = ((reg[(SC_RJP as usize) + k] as f64) - (reg[(SC_RJN as usize) + k] as f64)) / CELL_F;
        worst = fmax64(worst, fabs64(jx - jg[k]));
        k = k + 1;
    }
    return worst;
}

/// The errors of stimulus sel, kept apart. m gets, in order: 0 fixed point against the real run of the same scheme (units, any node,
/// any step); 1 fixed point against the fully converged real table run; 2, 3, 4 the OD, TE and injection step of the fixed-point run
/// minus the converged real table run's (V); 5 the converged real table run against the analytic law (units, any node, any step);
/// 6 and 7 its step and node; 8, 9, 10 the OD, TE and injection step of the law minus the table's (V); 11 the law against ngspice's
/// checkpoints (V; sel 1 and 3 only); 12, 13, 14 the OD, TE and injection step of the law minus ngspice's (V).
pub fn sw_errors(sel: u32, m: []f64) {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    var ws : [3336]f64 = [0.0] ** 3336;
    var wt : [3336]f64 = [0.0] ** 3336;
    var wl : [3336]f64 = [0.0] ** 3336;
    var rf : [416]f64 = [0.0] ** 416;
    var nf : [416]f64 = [0.0] ** 416;
    sw_make_vin(sel, &vin);
    const s : u64 = sw_run(&t, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
    sw_widen(&out, &w);
    sw_run_f(0, &t, &vin, 6032.0, SW_K, false, &SW_DV_M, &ws, &rf, &nf);
    sw_run_f(0, &t, &vin, 6032.0, 600, true, &SW_DV_M, &wt, &rf, &nf);
    sw_run_f(1, &t, &vin, 6032.0, 600, true, &SW_DV_M, &wl, &rf, &nf);
    m[0] = sw_maxdiff(&w, &ws);
    m[1] = sw_maxdiff(&w, &wt);
    m[2] = sw_od(&w, &vin) - sw_od(&wt, &vin);
    m[3] = sw_te(&w, &vin) - sw_te(&wt, &vin);
    m[4] = sw_inj(&w) - sw_inj(&wt);
    m[5] = sw_maxdiff(&wl, &wt);
    const at : usize = sw_argmax(&wl, &wt);
    m[6] = (((at / 8) as u32)) as f64;
    m[7] = (((at % 8) as u32)) as f64;
    m[8] = sw_od(&wl, &vin) - sw_od(&wt, &vin);
    m[9] = sw_te(&wl, &vin) - sw_te(&wt, &vin);
    m[10] = sw_inj(&wl) - sw_inj(&wt);
    m[11] = 0.0;
    if (sel == 1) { m[11] = sw_ck_dev(&wl, &SW_NG_CK_DC075); }
    if (sel == 3) { m[11] = sw_ck_dev(&wl, &SW_NG_CK_SN0); }
    m[12] = sw_od(&wl, &vin) - SW_NG_OD[sel as usize];
    m[13] = sw_te(&wl, &vin) - SW_NG_TE[sel as usize];
    m[14] = sw_inj(&wl) - SW_NG_INJ[sel as usize];
}

; --- the tests ----------------------------------------------------------------------------------

test the_units_the_devices_and_the_circuit_are_as_stated {
    // Variables, not constants: a constant assert is folded by the compiler and counts as no assert at all.
    var off : u32 = SW_OFF;
    var vddw : u32 = SW_VDDW;
    var vdd : u32 = VDD;
    var top : u32 = SW_TOP;
    var scale : u32 = SW_SCALE;
    var step : u32 = SW_CLK_STEP;
    var r : u32 = SW_R;
    var jf : u32 = SW_JF;
    // Ground is 0.5 V = 2^23 in the word, the supply 0.5 V + 1.5 V = 2^25; the top of the range is 3.2 V above ground.
    assert_eq(off, 8388608);
    assert_eq(vddw, 33554432);
    assert_eq(vddw, off + vdd);
    const topd : f64 = ((top - off) as f64) / SC_UPV - 3.2;
    assert topd * topd < 0.0000001 * 0.0000001;
    // dt = 250 ps over the 0.1 fF charge unit is 2.5e6 V/A = 3125 * 800: a device is 3125 of M4b's table devices.
    const dtc : f64 = ((SW_DT_PS as f64) * 0.000000000001) / ((SW_CUNIT_AF as f64) * 0.000000000000000001) - (scale as f64) * 800.0;
    assert dtc * dtc < 0.000001 * 0.000001;
    var e : usize = 0;
    var mok : bool = true;
    while (e < 12) {
        if (SW_DV_M[e] != 3125) { mok = false; }
        e = e + 1;
    }
    assert(mok);
    // The clock: a rise of 8 steps of exactly Vdd / 8, 320 steps at Vdd, a fall of 8 steps, then low; 2 ns is 8 steps of 250 ps.
    assert_eq(step * r, VDD);
    var n0 : u32 = 0;
    var n4 : u32 = 4;
    assert_eq(sw_clk_at(n0), 0);
    assert_eq(sw_clk_at(n4), vdd / 2);
    assert_eq(sw_clk_at(r), vdd);
    assert_eq(sw_clk_at(jf), vdd);
    assert_eq(sw_clk_at(jf + n4), vdd / 2);
    assert_eq(sw_clk_at(jf + r), 0);
    assert_eq(sw_clk_at(jf + r + 50), 0);
    var p : u32 = SW_P;
    var h : u32 = SW_H;
    var nn : u32 = SW_N;
    var jh : u32 = SW_JH;
    var ln : usize = SW_LEN;
    assert_eq(jf, r + p);
    assert_eq(nn, jf + r + h);
    assert_eq(jh, jf + 2 * r);
    assert_eq((nn + 1) * SC_NN, ln as u32);
    // The device table: ten transistors and the inverter's two, four PMOS (XM1, XM7, XM10, the inverter's), every terminal one of the
    // 12 names (nodes 0..7, Vdd 8, ground 9, clks 10, Vin 11), no device shorted, no device between two rails.
    var pmos : u32 = 0;
    var ok : bool = true;
    e = 0;
    while (e < 12) {
        pmos = pmos + SW_DV_KIND[e];
        if (SW_DV_D[e] >= 12 or SW_DV_G[e] >= 12 or SW_DV_S[e] >= 12) { ok = false; }
        if (SW_DV_D[e] == SW_DV_S[e] or SW_DV_G[e] == SW_DV_D[e] or SW_DV_G[e] == SW_DV_S[e]) { ok = false; }
        if (SW_DV_D[e] >= SC_NN and SW_DV_S[e] >= SC_NN) { ok = false; }
        e = e + 1;
    }
    assert(ok);
    assert_eq(pmos, 4);
    // XM6 is the switch: Vout - Vin, gate net3; XM5 shares its gate and puts Vin on net2; XM3 does the same from net1.
    assert_eq(SW_DV_D[5], SW_VOUT);
    assert_eq(SW_DV_G[5], SW_N3);
    assert_eq(SW_DV_S[5], 11);
    assert_eq(SW_DV_G[4], SW_N3);
    assert_eq(SW_DV_D[4], 11);
    assert_eq(SW_DV_S[4], SW_N2);
    assert_eq(SW_DV_G[2], SW_N3);
    // The pull-downs of net2 (XM4) and net5 (XM9) are gated by the inverter's output; XM8 (gate Vdd) links net3 to net5.
    assert_eq(SW_DV_G[3], SW_NCLK);
    assert_eq(SW_DV_G[8], SW_NCLK);
    assert_eq(SW_DV_G[7], 8);
    assert_eq(SW_DV_D[7], SW_N3);
    assert_eq(SW_DV_S[7], SW_N5);
    // XM7 (gate net3) and XM10 (gate net1) are the PMOS from net4 to Vdd and to net3: the bootstrap's charge path.
    assert_eq(SW_DV_S[6], SW_N4);
    assert_eq(SW_DV_S[9], SW_N4);
    assert_eq(SW_DV_D[9], SW_N3);
    assert_eq(SW_DV_G[9], SW_N1);
    // The inverter drives n_clks (node 6) from clks.
    assert_eq(SW_DV_D[10], SW_NCLK);
    assert_eq(SW_DV_D[11], SW_NCLK);
    assert_eq(SW_DV_G[10], 10);
    assert_eq(SW_DV_G[11], 10);
    // 0.1 fF units: Vout 3934.2, net1 4, net2 4, net3 8, net4 4, net5 4, n_clks 1 (not in the deck), the spare 0.1 fF.
    assert_eq(SW_CAP[0], 39342);
    assert_eq(SW_CAP[3], 80);
    assert_eq(SW_CAP[6], 10);
    assert_eq(SW_CB, 6032);
}

test the_capacitors_come_from_the_pdk_and_the_dac_counts {
    // cap_cmim: C = CJ l w + 2 CJSW (l + w) with CJ = 1.5 fF/um^2 and CJSW = 0.04 fF/um: 20 x 20 um is 600 + 3.2 = 603.2 fF (the boost
    // capacitor XC3), 9 x 9 um is 121.5 + 1.44 = 122.94 fF (one unit of the DAC). Checked in ngspice: a 1 uA step into the deck's
    // model charged the 20 x 20 and the 9 x 9 capacitor to 603.2 fF and 122.94 fF.
    var l20 : f64 = 20.0;
    var l9 : f64 = 9.0;
    const c20 : f64 = sw_cmim_ff(l20, l20);
    const c9 : f64 = sw_cmim_ff(l9, l9);
    assert (c20 - 603.2) * (c20 - 603.2) < 0.000000001 * 0.000000001;
    assert (c9 - 122.94) * (c9 - 122.94) < 0.000000001 * 0.000000001;
    var cbw : u32 = SW_CB;
    const cbd : f64 = (cbw as f64) - c20 * 10.0;
    assert cbd * cbd < 0.000001 * 0.000001;
    // The DAC (M4a, specs/analog/sar_cdac.t27): 31 + 31 + 1 units; the top plate sees the 31 units of the MSB array and the bridge unit
    // in series with the LSB array: 31 + 1 * 31 / (1 + 31) = 31 + 31/32 = 1023/32 units. M4a states the counts and leaves the unit's value to this file.
    const top : f64 = sw_dac_top_units();
    const topd : f64 = top - 1023.0 / 32.0;
    assert topd * topd < 0.000000000001 * 0.000000000001;
    const dac_ff : f64 = top * c9;
    const dacd : f64 = dac_ff - 3930.238125;
    assert dacd * dacd < 0.000001 * 0.000001;
    // Vout's word: the deck's 4 fF plus the DAC, in 0.1 fF units, rounded: 40 + 39302.38 -> 39342.
    var capv : u32 = SW_CAP[0];
    const stored : f64 = (capv as f64) / 10.0;
    const outd : f64 = stored - (4.0 + dac_ff);
    assert outd * outd < 0.05 * 0.05;
    assert_eq(((4.0 + dac_ff) * 10.0 + 0.5) as u32, capv);
    // Nothing else in the deck moves with the 20 um x 20 um capacitor: the node capacitors are 4 fF (C1 net4, C4 net1, C5 net2, C7 net5)
    // and 4 + 4 fF on net3 (C6, C8).
    var c1 : u32 = SW_CAP[1];
    var c3 : u32 = SW_CAP[3];
    assert_eq(c1, 40);
    assert_eq(c3, 2 * c1);
    assert_eq(SW_CAP[2], c1);
    assert_eq(SW_CAP[4], c1);
    assert_eq(SW_CAP[5], c1);
}

test a_device_conducts_from_its_high_end_to_its_low_end_and_the_table_is_the_comparators {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    // The comparator's table, unchanged: its largest entry is the law at (1.5 V, 1.5 V), the knee sits inside cell 5.
    assert_eq(t[624], 5916765);
    var v : [8]u32 = [0] ** 8;
    var reg : [144]u64 = [0] ** 144;
    // XM6 (index 5): NMOS, drain Vout, gate net3, source Vin. Vout above Vin by 20 mV, the gate 1.45 V above Vin (Vin = 0.75 V):
    // the current leaves Vout and enters the source side, which is the node Vin, a terminal with no row.
    v[0] = SW_OFF + 12582912 + 335544;
    v[3] = SW_OFF + 12582912 + 24326963;
    sw_stamp(&t, &v, &v, SW_OFF, SW_OFF + 12582912, 0, &SW_DV_M, &reg);
    const x : u32 = 24326963;
    const y : u32 = 335544;
    const cur : u64 = 3125 * (id_of(&t, x, y) as u64);
    assert cur > 0;
    // Vout's G+ register holds the current of XM6 (the capacitor terms cancel, v == v0): exactly the table's current times 3125.
    assert_eq(reg[(SC_RGP + 0) as usize], 3125 * (id_of(&t, x, y) as u64) + 39342 * ((SW_OFF + 12582912 + 335544) as u64));
    // The same device with Vout 20 mV BELOW Vin: the channel is symmetric, the current now leaves Vin and enters Vout, and the gate
    // overdrive is read from the lower end (Vout), so the magnitude is the table at (Vg - Vout, 20 mV).
    var w : [8]u32 = [0] ** 8;
    var reg2 : [144]u64 = [0] ** 144;
    w[0] = SW_OFF + 12582912 - 335544;
    w[3] = SW_OFF + 12582912 + 24326963 - 335544;
    sw_stamp(&t, &w, &w, SW_OFF, SW_OFF + 12582912, 0, &SW_DV_M, &reg2);
    const cur2 : u64 = 3125 * (id_of(&t, 24326963, y) as u64);
    assert cur2 > 0;
    assert_eq(reg2[(SC_RGN + 0) as usize], 39342 * ((SW_OFF + 12582912 - 335544) as u64) + cur2);
    // The table's on-resistance is high: at Vds -> 0 the table's slope is the chord over the first 62.5 mV cell, beta (ov - 31.25 mV),
    // against the law's beta ov. At Vgs = 1.45 V (ov = 1.1 V) that is 2.85 % low in conductance, which is the 2.9 % in the tracking error.
    const gt : f64 = ((gds_cell(&t, x, 0)) as f64) / CELL_F;
    const gl : f64 = sc_law_gds_t((x) as f64, 0.0);
    const ratio : f64 = gt / gl;
    assert ratio > 0.970;
    assert ratio < 0.973;
}

test the_jacobian_is_the_derivative_of_the_residual_and_the_fixed_system_is_the_real_system_to_rounding {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    sw_make_vin(1, &vin);
    const s : u64 = sw_run(&t, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
    sw_widen(&out, &w);
    // Four states of the Vin = 0.75 V run, each the end state of a step with the state before it as v0: step 6 and step 333, in the
    // middle of the two bootstrap events (the gate net3 at 2.17 V on the rise, collapsing on the fall), and steps 20 and 100, in the
    // settling of the track phase. The central differences are taken at the settling states: at step 6 the table is read past its end
    // (XM7 has Vsg = 1.53 V, the table stops at 1.5 V) and its slope there is not the derivative of what it returns.
    var steps : [4]u32 = [6, 20, 100, 333];
    var k : usize = 0;
    while (k < 4) {
        const j : u32 = steps[k];
        var vf : [8]f64 = [0.0] ** 8;
        var v0f : [8]f64 = [0.0] ** 8;
        var vu : [8]u32 = [0] ** 8;
        var v0u : [8]u32 = [0] ** 8;
        var n : u32 = 0;
        while (n < SC_NN) {
            vf[n as usize] = w[(j * SC_NN + n) as usize];
            v0f[n as usize] = w[((j - 1) * SC_NN + n) as usize];
            vu[n as usize] = out[(j * SC_NN + n) as usize];
            v0u[n as usize] = out[((j - 1) * SC_NN + n) as usize];
            n = n + 1;
        }
        var drv : [2]f64 = [0.0] ** 2;
        drv[0] = SW_OFF_F + ((sw_clk_at(j)) as f64);
        drv[1] = SW_OFF_F + ((vin[j as usize]) as f64);
        if (j == 20 or j == 100) {
            // The Jacobian is dG/dv: a central difference of G over +-16 units, in the table system and in the law (a pure number
            // per entry, entries up to 4e4); the transposed matrix is far off.
            const e0 : f64 = sw_fd_err(0, &t, &vf, &v0f, &drv, 6032.0, &SW_DV_M, false);
            const e1 : f64 = sw_fd_err(1, &t, &vf, &v0f, &drv, 6032.0, &SW_DV_M, false);
            const et : f64 = sw_fd_err(0, &t, &vf, &v0f, &drv, 6032.0, &SW_DV_M, true);
            assert e0 < 0.01;
            assert e1 < 0.001;
            assert et > 1.0;
        }
        // The fixed-point system is the real table system at the same words, up to the table's integer rounding (half a table unit
        // times 3125 per device, at most 6 devices on a node) in G and the cell rounding of the slopes in J.
        const gg : f64 = sw_gap_g(&t, &vu, &v0u, SW_OFF + sw_clk_at(j), SW_OFF + vin[j as usize], SW_CB, &SW_DV_M);
        const gj : f64 = sw_gap_j(&t, &vu, &v0u, SW_OFF + sw_clk_at(j), SW_OFF + vin[j as usize], SW_CB, &SW_DV_M);
        assert gg < 10000.0;
        assert gj < 0.05;
        k = k + 1;
    }
}

test the_circuit_rests_until_the_clock_moves {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    sw_make_vin(3, &vin);
    var v : [8]u32 = [0] ** 8;
    var v0 : [8]u32 = [0] ** 8;
    var info : [1]u32 = [0] ** 1;
    sw_rest(vin[0], &v);
    sw_rest(vin[0], &v0);
    // Past the clock's fall (steps 336 on) clks is low: every channel is off or has no voltage across it, so the state is a fixed point
    // of the step whatever Vin does (the sine moves 60 uV a step here). Ten steps, the state is the rest state bit for bit, the
    // residual is zero and no iteration moves anything.
    var j : u32 = 340;
    var same : bool = true;
    var rmax : u32 = 0;
    var umax : u32 = 0;
    while (j < 350) {
        const r : u32 = sw_step(&t, &v, j, vin[j as usize], SW_CB, SW_K, &SW_DV_M, &info);
        if (r > rmax) { rmax = r; }
        if (info[0] > umax) { umax = info[0]; }
        var n : u32 = 0;
        while (n < SC_NN) {
            if (v[n as usize] != v0[n as usize]) { same = false; }
            n = n + 1;
        }
        j = j + 1;
    }
    assert(same);
    assert_eq(rmax, 0);
    assert_eq(umax, 0);
    // And the clock at its first step of rise moves the circuit: step 1 puts clks at 0.1875 V, below the NMOS threshold, so nothing
    // turns on but the inverter's PMOS pulls n_clks 40 uV down at step 2 (clks at 0.375 V).
    sw_rest(vin[0], &v);
    const r1 : u32 = sw_step(&t, &v, 1, vin[1], SW_CB, SW_K, &SW_DV_M, &info);
    assert_eq(info[0], 0);
    assert_eq(v[SW_NCLK as usize], SW_VDDW);
    const r2 : u32 = sw_step(&t, &v, 2, vin[2], SW_CB, SW_K, &SW_DV_M, &info);
    assert info[0] > 0;
    assert v[SW_NCLK as usize] < SW_VDDW;
    assert v[SW_N1 as usize] < SW_VDDW;
}

test the_gate_overdrive_the_tracking_error_the_injection_and_the_droop_at_the_three_dc_levels {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    var sel : u32 = 0;
    var odprev : f64 = 9.0;
    var worst_od : f64 = 0.0;
    var worst_te : f64 = 0.0;
    while (sel < 3) {
        sw_make_vin(sel, &vin);
        const s : u64 = sw_run(&t, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
        sw_widen(&out, &w);
        const od : f64 = sw_od(&w, &vin);
        const te : f64 = sw_te(&w, &vin);
        const inj : f64 = sw_inj(&w);
        const dr : f64 = sw_droop(&w);
        // (1) The gate overdrive while tracking: within the named bound of ngspice at each level, and a real overdrive (the threshold
        // is 0.35 V, so 1.4 V of Vgs is 1.05 V of overdrive at Vin = 0.2, 0.75 and 1.3 V alike), a little lower at higher Vin.
        assert fabs64(od - SW_NG_OD[sel as usize]) <= SW_B_OD_V;
        assert od > 1.4;
        assert od < odprev;
        odprev = od;
        worst_od = fmax64(worst_od, fabs64(od - SW_NG_OD[sel as usize]));
        // (2) The tracking error at the end of the track phase: the settled remainder, microvolts.
        assert sw_within(te, SW_NG_TE[sel as usize], SW_B_TE_ABS_V, SW_B_TE_REL);
        worst_te = fmax64(worst_te, fabs64(te - SW_NG_TE[sel as usize]));
        // (3) The injection step and (4) the droop: the square law has no gate capacitance and no leak, so both are round-off.
        assert sw_within(inj, SW_NG_INJ[sel as usize], SW_B_INJ_V, 0.0);
        assert sw_within(dr, SW_NG_DROOP[sel as usize], SW_B_DROOP_V, 0.0);
        // Every step is settled and none needs more iterations than SW_NIT_MAX; the 3328 words fold to the pinned S.
        assert sc_max_u(&res, 416) <= SW_B_RES;
        assert sc_max_u(&nit, 416) <= SW_NIT_MAX;
        assert_eq(s, SW_EXP_S[sel as usize]);
        sel = sel + 1;
    }
    // The measured deviations, from both sides: 0.2528 mV of overdrive (the knee, see THE TABLE) and 1.93 uV of tracking error.
    assert worst_od > 0.00025;
    assert worst_od < 0.00026;
    assert worst_te > 0.0000019;
    assert worst_te < 0.00000195;
}

test the_tracking_error_the_overdrive_the_injection_and_the_droop_at_four_phases_of_the_sine {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    var sel : u32 = 3;
    while (sel < 7) {
        sw_make_vin(sel, &vin);
        const s : u64 = sw_run(&t, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
        sw_widen(&out, &w);
        const od : f64 = sw_od(&w, &vin);
        const te : f64 = sw_te(&w, &vin);
        const inj : f64 = sw_inj(&w);
        const dr : f64 = sw_droop(&w);
        assert fabs64(od - SW_NG_OD[sel as usize]) <= SW_B_OD_V;
        assert sw_within(te, SW_NG_TE[sel as usize], SW_B_TE_ABS_V, SW_B_TE_REL);
        assert sw_within(inj, SW_NG_INJ[sel as usize], SW_B_INJ_V, 0.0);
        assert sw_within(dr, SW_NG_DROOP[sel as usize], SW_B_DROOP_V, 0.0);
        assert sc_max_u(&res, 416) <= SW_B_RES;
        assert sc_max_u(&nit, 416) <= SW_NIT_MAX;
        assert_eq(s, SW_EXP_S[sel as usize]);
        // The input at the end of the track phase, 0.75 V + 0.6 V sin(phase): the zero crossings and the two peaks.
        const vend : f64 = ((vin[SW_JF as usize]) as f64) / SC_UPV;
        if (sel == 3 or sel == 5) {
            assert fabs64(vend - 0.75) < 0.00001;
        } else {
            assert fabs64(fabs64(vend - 0.75) - 0.6) < 0.0001;
        }
        sel = sel + 1;
    }
    // The tracking error is R C dVin/dt: negative while Vin rises, positive while it falls, and tiny at the peaks, where the slope is 0.
    sw_make_vin(3, &vin);
    const s3 : u64 = sw_run(&t, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
    sw_widen(&out, &w);
    const te3 : f64 = sw_te(&w, &vin);
    const inj3 : f64 = sw_inj(&w);
    assert te3 < 0.0 - 0.0012;
    // The table is 2.85 % low in conductance (a_device_conducts...): the lag is 2.9 % longer than the law's and ngspice's, 1.2666 mV.
    const ratio : f64 = te3 / SW_NG_TE[3];
    assert ratio > 1.028;
    assert ratio < 1.030;
    // The gate closes at step 333; Vout follows the input until then, so the injection step is dVin/dt times about 1 ns, 0.24 mV.
    assert inj3 > 0.00023;
    assert inj3 < 0.00025;
}

test the_three_errors_kept_apart_at_the_dc_level {
    var m : [15]f64 = [0.0] ** 15;
    sw_errors(1, &m);
    // ARITHMETIC: the fixed-point run against the real run of the same scheme and against the fully converged real run of the same
    // table. The largest difference of any node at any step is in the slow tail of the hold (step 416, net2): each step stops with
    // up to 64 units owed on the small nodes, and the stops add up to 237 units (14 uV). At the measurements it is under 5 uV.
    assert m[0] > 180.0;
    assert m[0] < 195.0;
    assert m[1] > 230.0;
    assert m[1] < SW_B_ARITH_U;
    assert fabs64(m[2]) < 0.000001;
    assert fabs64(m[3]) < 0.0000025;
    assert fabs64(m[4]) < 0.0000003;
    // TABLE: the converged real table run against the analytic law. The largest difference is the knee: XM8 (gate Vdd) charges net5 until
    // its Vgs is the threshold, 0.35 V in the law, 0.3125 V in the table (the chord inside cell 5), so net5 settles 37.5 mV higher
    // and 39.0 mV is the difference at step 35. At the measurements: 0.253 mV of overdrive.
    assert m[5] > 650000.0;
    assert m[5] < SW_B_TABLE_U;
    assert_eq((m[6] + 0.5) as u32, 35);
    assert_eq((m[7] + 0.5) as u32, 5);
    assert m[8] > 0.00025;
    assert m[8] < 0.000255;
    assert fabs64(m[9]) < 0.0000001;
    assert fabs64(m[10]) < 0.00000001;
    // MODEL: the analytic law against ngspice with the same W, L, KP, VTO, capacitors and grid: under a nanovolt at the 56 recorded
    // states and in the three measurements.
    assert m[11] < SW_B_LAW_V;
    assert m[11] > 0.0000000003;
    assert fabs64(m[12]) < 0.000000002;
    assert fabs64(m[13]) < 0.000000002;
    assert fabs64(m[14]) < 0.000000002;
}

test the_three_errors_kept_apart_at_the_sine_zero_crossing {
    var m : [15]f64 = [0.0] ** 15;
    sw_errors(3, &m);
    assert m[0] > 160.0;
    assert m[0] < 170.0;
    assert m[1] > 240.0;
    assert m[1] < SW_B_ARITH_U;
    assert fabs64(m[2]) < 0.000005;
    assert fabs64(m[3]) < 0.0000005;
    assert fabs64(m[4]) < 0.00000003;
    // The knee is the same (the sine only moves Vin by 0.4 mV in the first 35 steps); here the table's on-resistance shows in the
    // tracking error: the law lags 36.6 uV less than the table.
    assert m[5] > 650000.0;
    assert m[5] < SW_B_TABLE_U;
    assert_eq((m[6] + 0.5) as u32, 35);
    assert_eq((m[7] + 0.5) as u32, 5);
    assert m[8] > 0.000252;
    assert m[8] < 0.000255;
    assert m[9] > 0.000036;
    assert m[9] < 0.000037;
    assert m[10] > 0.00000035;
    assert m[10] < 0.0000004;
    assert m[11] < SW_B_LAW_V;
    assert m[11] > 0.0000000003;
    assert fabs64(m[12]) < 0.000000002;
    assert fabs64(m[13]) < 0.000000002;
    assert fabs64(m[14]) < 0.000000002;
}

test the_discretization_error_is_the_grids_and_the_emulator_shares_it_with_ngspice {
    // The same circuit, the same sine, ngspice on the 250 ps grid (the emulator's, and so the comparison above is free of it) and on a
    // grid five times finer (deck sar_sw_fine): backward Euler at 250 ps is a different circuit from the continuous one. The gate
    // overdrive is 3.0 mV higher on the coarse grid (the bootstrap's charge sharing is a stiff step), the tracking error 3.4 uV (0.27 %)
    // less negative, and the injection step 11.2 uV (4.5 %) smaller.
    var sn0 : usize = 3;
    const dod : f64 = SW_NG_OD[sn0] - SW_NG_FINE_OD;
    const dte : f64 = SW_NG_TE[sn0] - SW_NG_FINE_TE;
    const dinj : f64 = SW_NG_INJ[sn0] - SW_NG_FINE_INJ;
    assert dod > 0.00296;
    assert dod < SW_B_DISC_OD_V;
    assert dte > 0.0000034;
    assert dte < SW_B_DISC_TE_V;
    assert dinj < 0.0 - 0.0000111;
    assert dinj > 0.0 - SW_B_DISC_INJ_V;
    // Against the finer grid the emulator carries both: the grid's 2.96 mV and the table's 0.25 mV of overdrive.
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    sw_make_vin(3, &vin);
    const s : u64 = sw_run(&t, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
    sw_widen(&out, &w);
    const dfine : f64 = sw_od(&w, &vin) - SW_NG_FINE_OD;
    assert dfine > 0.0027;
    assert dfine < 0.0028;
}

test k_too_small_is_a_negative_control_and_the_cap_is_exactly_enough {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    // The sine trough (stimulus 6) has the hardest step, the clock fall at step 333, which needs SW_NIT_MAX = 120 iterations. K = 128
    // and K = 600 give the same 3336 words; K = 119 leaves that step unsettled; K = 4 leaves several unsettled on the DC run.
    sw_make_vin(6, &vin);
    const sa : u64 = sw_run(&t, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
    assert_eq(sc_max_u(&nit, 416), SW_NIT_MAX);
    assert_eq(nit[332], SW_NIT_MAX);
    const sb : u64 = sw_run(&t, &vin, SW_CB, 600, &SW_DV_M, &out, &res, &nit);
    assert_eq(sa, sb);
    const sc : u64 = sw_run(&t, &vin, SW_CB, SW_NIT_MAX - 1, &SW_DV_M, &out, &res, &nit);
    assert sc_max_u(&res, 416) > SW_B_RES;
    assert res[332] > SW_B_RES;
    sw_make_vin(1, &vin);
    const sd : u64 = sw_run(&t, &vin, SW_CB, 4, &SW_DV_M, &out, &res, &nit);
    assert sw_cnt_gt(&res, 416, SW_B_RES) >= 4;
    assert sc_max_u(&res, 416) > 1000000;
}

test the_boost_capacitor_removed_fails_the_overdrive_check {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    sw_make_vin(1, &vin);
    // The mutant: cb = 0. The gate is no longer lifted above Vin: net3 stays near the 1.5 V that XM10 can pass (the overdrive is 0.437 V).
    const s : u64 = sw_run(&t, &vin, 0, SW_K, &SW_DV_M, &out, &res, &nit);
    sw_widen(&out, &w);
    const od : f64 = sw_od(&w, &vin);
    const te : f64 = sw_te(&w, &vin);
    // The check of the DC run, as the real circuit's, FAILS for the mutant: |OD - ngspice| is 1.0 V against the bound of 0.4 mV, and
    // the tracking error is 23 mV against a few microvolts.
    const bad : f64 = fabs64(od - SW_NG_OD[1]);
    assert bad > SW_B_OD_V;
    assert bad > 1.0;
    assert !sw_within(te, SW_NG_TE[1], SW_B_TE_ABS_V, SW_B_TE_REL);
    // And the mutant is not just wrong: it is ngspice's own circuit without the capacitor (deck sar_sw_nocb) to 2.85 mV of overdrive, so
    // the emulator tells a circuit with a boost capacitor from one without.
    const dn : f64 = od - SW_NG_NOCB_OD;
    assert fabs64(dn) < SW_B_NOCB_V;
    assert dn > 0.0028;
    assert dn < 0.0029;
    // The tracking error of the mutant is 25.4 mV, ngspice's no-boost deck 23.4 mV: the table's knee is worst at 80 mV of overdrive.
    assert fabs64(te - SW_NG_NOCB_TE) > 0.0019;
    assert fabs64(te - SW_NG_NOCB_TE) < 0.0021;
    assert sc_max_u(&res, 416) <= SW_B_RES;
}

test a_wrong_threshold_table_a_stuck_pull_down_and_a_weak_switch_are_caught {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    var out : [3336]u32 = [0] ** 3336;
    var res : [416]u32 = [0] ** 416;
    var nit : [416]u32 = [0] ** 416;
    var w : [3336]f64 = [0.0] ** 3336;
    // A table built with Vth = 0.30 V: the gate overdrive of the DC 0.75 V run is 4.2 mV off ngspice, against the bound of 0.4 mV.
    var t2 : [625]u32 = [0] ** 625;
    sc_build_table(&t2, 0.30);
    sw_make_vin(1, &vin);
    const s1 : u64 = sw_run(&t2, &vin, SW_CB, SW_K, &SW_DV_M, &out, &res, &nit);
    sw_widen(&out, &w);
    const dv : f64 = sw_od(&w, &vin) - SW_NG_OD[1];
    assert fabs64(dv) > SW_B_OD_V;
    assert fabs64(dv) > 0.004;
    assert fabs64(dv) < 0.0045;
    // XM9 (the pull-down of net5, index 8) removed: net3 can no longer discharge through XM8 and XM9 when clks falls, the gate stays high,
    // XM6 stays on, and Vout follows the sine through the hold: 4.1 mV of "droop" against the bound of 1 nV.
    var mult : [12]u32 = [3125, 3125, 3125, 3125, 3125, 3125, 3125, 3125, 3125, 3125, 3125, 3125];
    mult[8] = 0;
    sw_make_vin(3, &vin);
    const s2 : u64 = sw_run(&t, &vin, SW_CB, SW_K, &mult, &out, &res, &nit);
    sw_widen(&out, &w);
    const dr : f64 = sw_droop(&w);
    assert fabs64(dr) > SW_B_DROOP_V;
    assert dr > 0.0040;
    assert dr < 0.0042;
    // XM6 at half width: twice the on-resistance, twice the lag: 1.40 mV more than ngspice's 1.2666 mV, against a few microvolts.
    mult[8] = 3125;
    mult[5] = 1562;
    const s3 : u64 = sw_run(&t, &vin, SW_CB, SW_K, &mult, &out, &res, &nit);
    sw_widen(&out, &w);
    const te : f64 = sw_te(&w, &vin);
    assert !sw_within(te, SW_NG_TE[3], SW_B_TE_ABS_V, SW_B_TE_REL);
    assert fabs64(te - SW_NG_TE[3]) > 0.0013;
    assert fabs64(te - SW_NG_TE[3]) < 0.0015;
}

test the_words_have_headroom {
    var t : [625]u32 = [0] ** 625;
    sc_build_table(&t, SC_VTH_V);
    var vin : [417]u32 = [0] ** 417;
    sw_make_vin(1, &vin);
    // The widest word any stage of the solve forms at the first iteration of the clock edges (steps 5, 6, 7, 331, 332, 333, 334),
    // where the Newton move is largest: 7.23e16 (2^56), below the 2^62 the comparator asks for, 2^63 being the u64's limit.
    const wide : f64 = sw_headroom(&t, &vin, SW_CB, &SW_DV_M);
    assert wide < 4611686018427387904.0;
    assert wide > 7.0e16;
    assert wide < 7.5e16;
}
