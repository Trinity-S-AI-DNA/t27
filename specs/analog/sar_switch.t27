pub const SW_NG_FINE_TE : f64 = -1.2700276014e-03;
pub const SW_NG_FINE_INJ : f64 = 2.5082115803e-04;
/// The steps at which the checkpoints below are recorded.
pub const SW_CHK : [8]u32 = [4, 5, 6, 20, 328, 332, 333, 340];
