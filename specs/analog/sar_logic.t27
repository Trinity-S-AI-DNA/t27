/// The delay cell, by trim code 4 A + 2 B + C: the falling output (the input rising) and the rising output, ps. MEASURED: sar_delay_cell.cir.
pub const SL_DC_FALL : [8]usize = [8087, 5746, 5746, 4107, 5746, 4107, 4107, 1733];
pub const SL_DC_RISE : [8]usize = [10482, 10545, 10545, 10576, 10545, 10576, 10576, 10581];
/// The nor3 -> delay_cell -> inverter chain of sar_delay_cell.cir end to end, clks falling to clkc rising and clks rising to clkc falling, ps.
pub const SL_NG_TOT_R : [8]usize = [16147, 13592, 13592, 11875, 13592, 11875, 11875, 9669];
pub const SL_NG_TOT_F : [8]usize = [13305, 13479, 13479, 13609, 13479, 13609, 13609, 13712];
/// What the nor3 sees at the delay cell's input, in thousandths of an inverter input, for a rising and a falling edge (calibrated, see the header).
pub const SL_DC_LOAD_R : usize = 33380;
pub const SL_DC_LOAD_F : usize = 75700;

/// What the In terminal of a tgate puts on its net (thousandths of an inverter input): 4 um of diffusion (the 3 um PMOS and the 1 um NMOS), first guessed
/// as 0.15, which left the CK11 .. CK2 edges 8 % early once the skew-window fight was in; FITTED to those edges (all ten are one delay in the model), so
/// they are no independent check of it. CK1, whose net carries no tgate In, and the swapped-pins control, which shares the path, are the other checks.
pub const SL_TG_IN_LOAD : usize = 430;

/// The capacitance of the golden top on CK1 (4 fF) and clkc (8 fF), in thousandths of an inverter input: what the inverter's delay at that cap equals.
pub const SL_EXT_4F : usize = 300;
pub const SL_EXT_8F : usize = 600;

/// THE HISTORY OF THE DELAY CELL (sar_delay_hist.cir). Four tables of SL_H_N pairs (age, delay), ps, ages rising; flat outside. The AGE of an output is the
/// time since that output last crossed the other way. SL_H_N1F: the nor3 output (n1, the delay cell input) falling, on a Valid rise, against the age of its
/// last rise; SL_H_N2R: the delay cell output (n2) rising against its age since its last fall, read at the moment n1 crosses; SL_H_N1R: n1 rising, on a Valid
/// fall, against the age of n2's last rise (n2 still rising pulls n1 up through the Miller capacitance); SL_H_N2F: n2 falling against its age since its last
/// rise. The delay of n1 is from the Valid edge, that of n2 from the n1 crossing. Code 000, the golden top. MEASURED, not fitted: each point is one
/// calibration chain of sar_delay_hist.cir at its fourth pulse (Wh = 30 ns with Wl = 16 .. 120 ns for the first two tables; Wl = 30 ns with Wh = 14 .. 120 ns
/// for the last two), the age and the delay both read from ngspice's 50 % crossings; the first pair of N1F, N2R and N1R repeats the next one (below the
/// shortest calibrated age the table is flat, which is an extrapolation).
pub const SL_H_N : usize = 11;
pub const SL_H_N1F : usize = 0;
pub const SL_H_N2R : usize = 22;
pub const SL_H_N1R : usize = 44;
pub const SL_H_N2F : usize = 66;
pub const SL_HIST : [88]usize = [
