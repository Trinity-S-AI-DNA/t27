    9753, 6520, 12283, 6723, 14653, 6871, 16924, 6989, 20212, 7130, 24444, 7295, 29572, 7501, 37627, 7781, 52712, 8014, 77857, 8067, 117930, 8081
];
/// The age of a net that has not changed since the start (every net starts unknown, and the first change from unknown is the circuit at rest): a long rest.
pub const SL_AGE_INF : usize = 1000000;
/// The ages at which sar_delay_cell.cir measured the settled delays (clks low for 80 ns, high for 80 ns): the nor3 fall and the delay cell rise.
/// The settled numbers (SL_DC_*, SL_DC_LOAD_*) hold there; the tables above scale them for any other age.
pub const SL_H_REF_N1F : usize = 72800;
pub const SL_H_REF_N2R : usize = 67400;
/// The inverter after the delay cell sees a slow edge, so its delay is longer than its fast-edge arc: ps, measured as iv_<code>_r (clkc rising, by trim
