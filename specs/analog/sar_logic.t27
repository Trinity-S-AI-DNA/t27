// SPDX-License-Identifier: Apache-2.0
// specs/analog/sar_logic.t27 -- the SAR ADC sequencer and its asynchronous clock, GATE LEVEL, from the netlist, against ngspice PSP103
// M4d of the SAR ADC milestone (#10524, epic #10486, issue #10754). The digital half of the golden SAR deck (uberWAVE
// wp2-parser/golden/top.spice, GPL-2.0: read at run time, never vendored). THE LOGIC IS MODELLED AT GATE LEVEL (a gate is a delay and a
// truth table, a transmission gate is a switch with a stored node) and NOTHING HERE IS TRANSISTOR LEVEL: the transistors of the gates are in the
// ngspice decks that measure the gates and judge this model. The comparator and the DAC are not here (M4e composes them): Valid is an input.
// -
// THE CIRCUIT. SAR_logic is eleven `dff` in a chain: x1 has D = D, Q = CK11, CLK = Valid; xk has D = the CK of the stage above and Q = the next CK
// down (CK11 .. CK1); every dff has Reset = clks and Set = Set. At the top of the golden deck D = VDD, Set = 0 and clks is the track/hold clock: while
// clks is high every Q is held at 0; when it falls, each rising edge of Valid shifts a 1 one stage down. With D tied to VDD the chain FILLS, it
// does not walk: after n Valid edges CK11 .. CK(12-n) are high and stay high until clks rises (a thermometer code, not a one-hot walk). A dff is
// a master/slave latch of four `tgate`, four `nor` and two `inverter`: the master (x1 transparent while CLK is low, x9 its keeper while CLK is
// high), the slave (x3 transparent while CLK is high, x7 its keeper while CLK is low), x2 and x8 the master's NORs with Set and Reset, x4 and x5 the
// slave's, x6 the nQ inverter and x10 the clock inverter. clock_gen makes the comparator clock without a clock source: nor3(clks, Valid, CK1) ->
// delay_cell (trimmed by A, B, C; the golden top ties A = B = C = 0) -> inverter -> clkc. The clock restarts itself after each Valid pulse and stops
// once CK1 is high. The gates are the deck's own subcircuits inverter, nor, nor3, tgate and delay_cell (and nand, which neither block uses).
// -
// THE NETLIST, NOT RE-TYPED (FR-002). The instance list comes from the t27o SPICE front end: tools::t27o::spice_convert::emit_gates reads the
// hierarchy of a named subcircuit down to its gates and lists, for each, the kind and its nets (nets 0, 1, 2 .. the ports of the root, then the
// others in the order met, an internal net named <instance path>.<name>). THIS FILE holds the wiring of SAR_logic, dff and clock_gen and the two
// lines of the golden top that instantiate them, as netlist text (the facts of the circuit: which gate sits on which net; the gates carry their
// ports only, no transistors) and the model is built from what the converter returns for it; no instance table is typed here. The wiring is the
// deck's: `tri t27o` on the golden deck's subcircuit section gives the same table (the receipt is in the PR).
// -
// THE GATE MODEL. A net has the value 0, 1 or X. A gate drives its output net through a delay: when its inputs ask for a new output, the change
// is scheduled one propagation delay later, and withdrawn if the inputs revert first (an INERTIAL delay: a glitch shorter than the delay is
// swallowed). The delay of an arc is d0 + k * FO: the arc is (kind, the input pin that changed, the output edge), FO the load of the output net in
// units of ONE INVERTER INPUT (1.8 um^2 of gate): the sum of the loads of the pins on the net (an inverter, nor, nand or nor3 input is 1, a tgate's
// PMOS gate 0.75, its NMOS gate 0.25, its in and out terminals 0.15 each) plus the capacitance the top puts there (4 fF = 0.3, 8 fF = 0.6). d0 and k
// are MEASURED (specs/analog/decks/sar_gate_arcs.cir: every gate driving 1, 4 and 16 inverter inputs, ngspice-47, IHP SG13G2 PSP103, mos_tt, 50 C),
// least squares over the three loads; SL_NG_ARC pins the measured points and a test holds the fit to them. Not modelled: the slope of the input edge.
// -
// THE SWITCH. A `tgate` (CLK, nCLK, In, Out): CLK is the gate of its PMOS, nCLK the gate of its NMOS. The PMOS is on while CLK is 0, the NMOS while
// nCLK is 1. A node driven through a conducting tgate takes its driver's value; a node that no gate and no conducting tgate drives HOLDS its value
// (dynamic storage: this is how the master and the slave remember). Drive strengths: a gate's output is strong; a tgate with both devices on passes
// a strong 0 or 1; with one device on it passes strongly what that device passes well (an NMOS a 0, a PMOS a 1) and WEAKLY the other. A strong driver
// beats a weak one; two drivers of equal strength and different value, or an unknown, make X. The dff needs this: in the clock-skew window the
// slave's x3 (NMOS on first) pulls net3 low while the keeper x7 (its NMOS still on until nCLK falls) pushes a weak 1, and net3 must go low. A tgate
// is used In -> Out only in this circuit (checked by a test: every tgate In is driven by a gate or by an input). Not modelled: the threshold drop of
// a weak level (a weak 1 is a 1), charge sharing, leakage (a stored node never decays).
// -
// THE EVENT STEP. Time is an integer number of picoseconds, the quantum is 1 ps and no delay is shorter. The run advances from event time to event
// time: stimulus edges and matured gate events at one time are applied TOGETHER, the nets are resolved, then every gate is evaluated against the new
// state in table order and its change scheduled. So two events at one quantum never depend on the order of the instances. TIES: events at the same
// ps are simultaneous; two drivers that disagree at that time give X (the same rule as a contention). A tgate that keeps its value and only changes
// strength (one of its devices turns off or on) takes 1 ps: the value does not travel, and without this rule the slave's keeper still drives a strong
// 1 for the 83 ps the new value needs to arrive, and the dff goes unknown. At t = 0 every net is X; the inputs are applied, and the circuit resolves
// itself from X through the reset (a test: no net is X after the reset).
// -
// THE DELAY CELL. Its delay is ANALOG-ISH and is TABULATED, not computed: SL_DC_FALL / SL_DC_RISE hold, for each trim code 4 A + 2 B + C, the time from
// the 50 % point of its input to the 50 % point of its output when the input has been still for tens of ns (specs/analog/decks/sar_delay_cell.cir:
// nor3 -> delay_cell -> inverter as in clock_gen, eight codes). The falling output (a slow, trimmable NMOS stack) takes 8.09 ns at code 000 and
// 1.73 ns at 111, depends on how many of A, B, C are set (1, 2 and 4 give the same time), the rising output (a PMOS) takes 10.5 ns for every code.
// The delay cell's INPUT is not a gate capacitance: its long channels make the nor3 slower than 1.8 um^2 per input would, so the nor3 sees SL_DC_LOAD_R
// and SL_DC_LOAD_F inverter inputs for a rising and a falling edge, MEASURED from the same deck (the nor3's 7.43 ns and 2.71 ns at code 000), i.e.
// calibrated, not derived. The nor3's other arcs and the delay table are then tested on different stimuli (Valid, the 8 codes).
// -
// THE REFERENCE. ngspice-47, IHP SG13G2 PSP103 (the lv models, mos_tt) at 50 C (the golden deck's own temperature), transistor level, the deck's subcircuits.
// PSP103, not LEVEL=1, is the reference: the issue text says LEVEL=1, but the IHP models run here (M3b), they are what the golden deck itself uses and
// they are the better reference. Four decks in specs/analog/decks, each a bench of my own wired to the golden subcircuits:
// - sar_gate_arcs.cir: every gate driving 1, 4 and 16 inverter inputs (and the inverter driving 4 .. 32 fF): SL_ARC, SL_NG_ARC, SL_EXT_*.
// - sar_delay_cell.cir: nor3 -> delay_cell -> inverter for the eight trim codes: SL_DC_*, SL_NG_TOT_*.
// - sar_logic_ref.cir: SAR_logic and clock_gen wired as the golden top wires them (D = VDD, Set = 0, A = B = C = 0, 4 fF on CK1, 8 fF on clkc, 12 fF on
//   Valid), ideal clks and eleven Valid pulses: the 50 % crossings SL_NG_TV .. SL_NG_TCF.
// - sar_logic_swap.cir: the same with the fifth dff's Set and Reset exchanged: SL_NG_SW_*.
// The decks read the golden subcircuits at run time: IHP_PDK, IHP_OSDI and SAR_GOLDEN_SUBCKTS are environment variables (no path is committed).
// SAR_GOLDEN_SUBCKTS is the subcircuit section of the fetched deck:
//   sed -n '/^.subckt tracking_switch/,$p' top.spice | grep -v -i -E '^.(end|global)' > $SAR_GOLDEN_SUBCKTS
// -
// WHAT A PASS SAYS (each is a test below). (1) The converter hands this file 113 gates in 100 nets (23 inverter, 44 nor, 1 nor3, 44 tgate, 1 delay_cell),
// every tgate read In -> Out with a stored Out. (2) After the reset every CK is 0 and no net is X. (3) Eleven Valid pulses make CK11 .. CK1 rise ONCE
// each, in that order, the same order as ngspice, and they stay up; each edge is within SL_CK_BOUND_PM permille and SL_CK_ABS_PS ps of ngspice's delay
// from its Valid edge. (4) The gate arcs reproduce the 60 measured points of sar_gate_arcs.cir within SL_ARC_ABS_PS ps. (5) For each of the 8 trim
// codes the model's clks -> clkc delay, rising and falling, is within SL_DC_BOUND_PM permille of ngspice (sar_delay_cell.cir). (6) clkc rises after
// clks falls and makes one rise and one fall per Valid pulse (eleven falls, ten more rises: CK1 holds the last back), the first rise and the first fall
// within SL_CLKC_BOUND_PM permille of ngspice, the later edges within SL_REPEAT_R_BOUND_PM (rises) and SL_REPEAT_F_BOUND_PM (falls, wide: see below).
// (7) NEGATIVE CONTROL: a dff with Set and Reset swapped fails the order check, and the model shows what ngspice shows: CK7 high from the reset, falling at
// the first Valid edge and rising at its turn, CK6 rising a stage early. (8) A node only a tgate drives holds its value when the tgate turns off; a pulse
// shorter than the gate's delay is swallowed.
// -
// WHAT IT DOES NOT SAY. Not a transistor-level model of the logic, and no speed claim: nothing here is compared with how long ngspice takes. The CK
// edges are the sequencer's own: no CK net carries the DAC's load, and the comparator closes the loop with a Valid of its own, not an ideal one. THE CK
// EDGES COME OUT ABOUT 17 % EARLY (458 ps against 548 ps from the Valid edge; CK1 625 ps against 654 ps): the model has no contention slowdown in the
// skew window and no input-slope term, and the bound says so. A CK FALLING (negative control only) comes 22 % early. THE REPEATED clkc EDGES ARE NOT
// RIGHT: the delay cell is history dependent. When Valid rises for the second time ngspice has the delay cell's input at 1.05 V and its output still at
// 0.39 V, still falling (in the first cycle: 1.35 V and 0.08 V), and the output then rises in 6.1 ns, not the 10.5 ns of a settled input. A table of
// settled delays can not follow that: in the repeated cycles ngspice's falling edge comes 7.0 ns after Valid rises, the table says 13.2 ns, 83 to
// 127 % too late; the rising edges are 6 to 11 % late. SL_REPEAT_F_BOUND_PM says how wrong the model
// is allowed to be there, and the PR lists every error. A conversion needs the self-timed loop closed through the comparator; that is M4e. A weak level
// is not degraded and a stored node does not leak. The delay cell input load and the 4 fF and 8 fF equivalents are fitted, not derived (above).
// ASCII only, English only.
// phi^2 + 1/phi^2 = 3 | TRINITY

module AnalogSarLogic;

use tools::t27o::spice_convert::{emit_gates, NONE, ERR_LINE, GT_NGATE, GT_NNET, GT_NET0, GT_GATE0, GT_PER_KIND, GATE_SLOTS, G_INV, G_NAND, G_NOR, G_NOR3, G_TGATE, G_DELAY};

// ---------------------------------------------------------------- the numbers

/// An output edge: falling or rising. The table rows below list the falling arc first.
pub const SL_FALL : usize = 0;
pub const SL_RISE : usize = 1;

/// What a gate drives onto its output net: a strong 0, a strong 1, an unknown, nothing (a tgate that is off), a weak 0, a weak 1.
pub const SL_S0 : usize = 0;
pub const SL_S1 : usize = 1;
pub const SL_X : usize = 2;
pub const SL_Z : usize = 3;
pub const SL_W0 : usize = 4;
pub const SL_W1 : usize = 5;

/// The arcs, one row of four per arc: the falling output's d0 (ps) and k (0.1 ps per inverter input), then the rising output's. Rows: 0 inverter;
/// 1, 2 nand A, B; 3, 4 nor A, B; 5, 6, 7 nor3 A, B, C; 8 a tgate's pass (In changes while it conducts); 9 a tgate's enable (a gate pin changes).
/// MEASURED: sar_gate_arcs.cir, delay from the input's 50 % point to the output's 50 % point, fitted over the loads of 1, 4 and 16 inverter inputs.
pub const SL_ARC : [40]usize = [
    64, 327, 48, 719,
    91, 606, 58, 719,
    95, 607, 74, 716,
    100, 329, 113, 1446,
    73, 328, 64, 1449,
    110, 343, 239, 2155,
    108, 329, 197, 2155,
    77, 327, 80, 2159,
    40, 246, 17, 449,
    49, 297, 85, 527
];

/// The measured points the rows were fitted to, ps: for each arc row, the falling output at 1, 4 and 16 inverter inputs, then the rising output
/// (so six numbers a row, in the order of the rows above).
pub const SL_NG_ARC : [60]usize = [
    96, 196, 588, 130, 323, 1200,
    150, 336, 1061, 139, 333, 1210,
    154, 340, 1066, 156, 348, 1223,
    131, 233, 625, 272, 674, 2431,
    105, 205, 597, 223, 627, 2386,
    139, 252, 658, 462, 1092, 3689,
    140, 241, 634, 419, 1050, 3647,
    109, 208, 600, 302, 937, 3536,
    66, 136, 434, 75, 180, 738,
    76, 171, 524, 125, 312, 925
];

/// The delay cell, by trim code 4 A + 2 B + C: the falling output (the input rising) and the rising output, ps. MEASURED: sar_delay_cell.cir.
pub const SL_DC_FALL : [8]usize = [8087, 5746, 5746, 4107, 5746, 4107, 4107, 1733];
pub const SL_DC_RISE : [8]usize = [10482, 10545, 10545, 10576, 10545, 10576, 10576, 10581];
/// The nor3 -> delay_cell -> inverter chain of sar_delay_cell.cir end to end, clks falling to clkc rising and clks rising to clkc falling, ps.
pub const SL_NG_TOT_R : [8]usize = [16147, 13592, 13592, 11875, 13592, 11875, 11875, 9669];
pub const SL_NG_TOT_F : [8]usize = [13305, 13479, 13479, 13609, 13479, 13609, 13609, 13712];
/// What the nor3 sees at the delay cell's input, in thousandths of an inverter input, for a rising and a falling edge (calibrated, see the header).
pub const SL_DC_LOAD_R : usize = 33380;
pub const SL_DC_LOAD_F : usize = 75700;

/// The capacitance of the golden top on CK1 (4 fF) and clkc (8 fF), in thousandths of an inverter input: what the inverter's delay at that cap equals.
pub const SL_EXT_4F : usize = 300;
pub const SL_EXT_8F : usize = 600;

/// ngspice's crossings (sar_logic_ref.cir), ps: Valid rising and falling (eleven pulses), clks falling, CK11 .. CK1 rising, clkc rising and falling.
pub const SL_NG_TV : [11]usize = [80100, 120100, 160100, 200100, 240100, 280100, 320100, 360100, 400100, 440100, 480100];
pub const SL_NG_TVF : [11]usize = [100300, 140300, 180300, 220300, 260300, 300300, 340300, 380300, 420300, 460300, 500300];
pub const SL_NG_CLKS_F : usize = 31500;
pub const SL_NG_TCK : [11]usize = [80650, 120648, 160648, 200648, 240648, 280648, 320648, 360648, 400648, 440648, 480754];
pub const SL_NG_TCR : [11]usize = [47732, 114320, 154962, 194987, 234988, 274988, 314988, 354988, 394988, 434988, 474988];
pub const SL_NG_TCF : [11]usize = [92096, 127307, 167062, 207052, 247052, 287052, 327052, 367052, 407052, 447052, 485907];

/// ngspice's crossings for the negative control (sar_logic_swap.cir: the fifth dff, which drives CK7, has Set and Reset exchanged), ps. CK7 is high from the
/// reset (its first rise, 527 ps, is the reset, not an edge of the run), falls at the first Valid edge and rises at its own turn; CK6 follows it.
pub const SL_NG_SW_CK7_F : usize = 80635;
pub const SL_NG_SW_CK7_R2 : usize = 240648;
pub const SL_NG_SW_CK6_R1 : usize = 80648;
pub const SL_NG_SW_CK6_F : usize = 120635;
pub const SL_NG_SW_CK6_R2 : usize = 280648;

/// The bounds the tests hold the model to. CK edges: permille of ngspice's Valid -> CK delay. Arcs: ps. The delay cell: permille of the end-to-end
/// delay. clkc, the first (settled) edges: permille; the repeated edges: permille of ngspice's delay from the causing Valid edge (wide, the model is
/// wrong there and says so).
pub const SL_CK_BOUND_PM : usize = 200;
pub const SL_CK_ABS_PS : usize = 100;
/// A CK FALLING (only in the negative control: a stage takes a 0): the model's weak 1 charges the node faster than the NMOS of the real tgate, so the
/// fall comes about 22 % early, and the bound is wider.
pub const SL_FALL_BOUND_PM : usize = 250;
pub const SL_FALL_ABS_PS : usize = 150;
pub const SL_ARC_ABS_PS : usize = 25;
pub const SL_DC_BOUND_PM : usize = 60;
pub const SL_CLKC_BOUND_PM : usize = 150;
pub const SL_REPEAT_R_BOUND_PM : usize = 150;
pub const SL_REPEAT_F_BOUND_PM : usize = 1300;
/// Changes before this time (ps) are the reset settling from unknown, not edges of the run.
pub const SL_TMIN : usize = 20000;

// ---------------------------------------------------------------- the state

/// Capacities, and where each table sits in the state vector `ms` (zeroed by the caller, SL_SLOTS long).
pub const SL_NETS : usize = 128;
pub const SL_GATES : usize = 160;
pub const SL_SLOTS : usize = 5000;
pub const SL_VAL : usize = 0;
pub const SL_CNT : usize = 128;
pub const SL_EXT : usize = 896;
pub const SL_LDR : usize = 1024;
pub const SL_LDF : usize = 1152;
pub const SL_DRV : usize = 1280;
pub const SL_PT : usize = 1440;
pub const SL_PV : usize = 1600;
pub const SL_PREV : usize = 1760;
pub const SL_WATCH : usize = 2880;
pub const SL_NWATCH : usize = 2896;
pub const SL_NLOG : usize = 2897;
pub const SL_T : usize = 2898;
pub const SL_NSTEP : usize = 2899;
pub const SL_LOG : usize = 2900;
pub const SL_LOGMAX : usize = 640;
pub const SL_SI : usize = 4825;
pub const SL_EXTL : usize = 4830;
pub const SL_MAXSTEP : usize = 200000;

/// The kind of gate g, and its pin p (a net), in the converter's table.
pub fn sl_kind(gt: []const usize, g: usize) -> usize {
    return gt[GT_GATE0 + g * GATE_SLOTS];
}

pub fn sl_pin(gt: []const usize, g: usize, p: usize) -> usize {
    return gt[GT_GATE0 + g * GATE_SLOTS + 1 + p];
}

/// The pin that is the output of a gate of this kind: the one after its inputs (inverter 1, nand and nor 2, nor3 and tgate 3, delay_cell 4).
pub fn sl_out_pin(kind: usize) -> usize {
    return sl_n_in(kind);
}

/// How many input pins a gate of this kind has (a tgate: its two gates and In).
pub fn sl_n_in(kind: usize) -> usize {
    if (kind == G_INV) { return 1; }
    if (kind == G_NAND or kind == G_NOR) { return 2; }
    if (kind == G_NOR3 or kind == G_TGATE) { return 3; }
    return 4;
}

/// What pin p of a gate of this kind loads its net with, in thousandths of an inverter input, when the driver's output edge is `dir`.
pub fn sl_pin_load(kind: usize, p: usize, dir: usize) -> usize {
    if (kind == G_INV) {
        if (p == 0) { return 1000; }
        return 0;
    }
    if (kind == G_NAND or kind == G_NOR) {
        if (p < 2) { return 1000; }
        return 0;
    }
    if (kind == G_NOR3) {
        if (p < 3) { return 1000; }
        return 0;
    }
    if (kind == G_TGATE) {
        if (p == 0) { return 750; }
        if (p == 1) { return 250; }
        if (p == 2 or p == 3) { return 150; }
        return 0;
    }
    if (p == 0) {
        if (dir == SL_RISE) { return SL_DC_LOAD_R; }
        return SL_DC_LOAD_F;
    }
    if (p < 4) { return 250; }
    return 0;
}

/// The row of SL_ARC for a gate of this kind whose input pin `p` changed (a tgate: p 2 is the pass arc, 0 and 1 the enable arc).
pub fn sl_row(kind: usize, p: usize) -> usize {
    if (kind == G_INV) { return 0; }
    if (kind == G_NAND) { return 1 + p; }
    if (kind == G_NOR) { return 3 + p; }
    if (kind == G_NOR3) { return 5 + p; }
    if (p == 2) { return 8; }
    return 9;
}

/// The delay d0 + k * FO of one arc row for the output edge `dir` and the load `load` in thousandths of an inverter input, ps.
pub fn sl_arc(row: usize, dir: usize, load: usize) -> usize {
    const base : usize = row * 4 + dir * 2;
    return SL_ARC[base] + SL_ARC[base + 1] * load / 10000;
}

// ---------------------------------------------------------------- the logic

/// The code a gate drives for the inverse of v (X stays X).
pub fn sl_not(v: usize) -> usize {
    if (v == 0) { return SL_S1; }
    if (v == 1) { return SL_S0; }
    return SL_X;
}

/// NOR of three inputs (a missing input is passed as 0).
pub fn sl_nor_code(a: usize, b: usize, c: usize) -> usize {
    if (a == 1 or b == 1 or c == 1) { return SL_S0; }
    if (a == 0 and b == 0 and c == 0) { return SL_S1; }
    return SL_X;
}

pub fn sl_nand_code(a: usize, b: usize) -> usize {
    if (a == 0 or b == 0) { return SL_S1; }
    if (a == 1 and b == 1) { return SL_S0; }
    return SL_X;
}

/// What a tgate drives: pm is the value of the gate of its PMOS (CLK), nm that of its NMOS (nCLK), x its In. The PMOS is on at 0, the NMOS at 1;
/// both on pass x strongly; one on passes strongly what it passes well (an NMOS a 0, a PMOS a 1) and weakly the other; none on drives nothing.
pub fn sl_tg_code(pm: usize, nm: usize, x: usize) -> usize {
    if (pm == 2 or nm == 2) { return SL_X; }
    const pon : bool = (pm == 0);
    const non : bool = (nm == 1);
    if (!pon and !non) { return SL_Z; }
    if (x == 2) { return SL_X; }
    if (pon and non) {
        if (x == 0) { return SL_S0; }
        return SL_S1;
    }
    if (non) {
        if (x == 0) { return SL_S0; }
        return SL_W1;
    }
    if (x == 1) { return SL_S1; }
    return SL_W0;
}

/// What gate g wants to drive, from the values on its input nets.
pub fn sl_want(ms: []const usize, gt: []const usize, g: usize) -> usize {
    const kind : usize = sl_kind(gt, g);
    const v0 : usize = ms[SL_VAL + sl_pin(gt, g, 0)];
    if (kind == G_INV) { return sl_not(v0); }
    const v1 : usize = ms[SL_VAL + sl_pin(gt, g, 1)];
    if (kind == G_NAND) { return sl_nand_code(v0, v1); }
    if (kind == G_NOR) { return sl_nor_code(v0, v1, 0); }
    const v2 : usize = ms[SL_VAL + sl_pin(gt, g, 2)];
    if (kind == G_NOR3) { return sl_nor_code(v0, v1, v2); }
    if (kind == G_TGATE) { return sl_tg_code(v0, v1, v2); }
    return sl_not(v0);
}

/// The net a gate drives.
pub fn sl_out_net(gt: []const usize, g: usize) -> usize {
    return sl_pin(gt, g, sl_out_pin(sl_kind(gt, g)));
}

// ---------------------------------------------------------------- the delay of a change

/// The trim code of a delay cell: 4 A + 2 B + C from its three pins (an unknown counts as 0).
pub fn sl_code(ms: []const usize, gt: []const usize, g: usize) -> usize {
    var c : usize = 0;
    if (ms[SL_VAL + sl_pin(gt, g, 1)] == 1) { c = c + 4; }
    if (ms[SL_VAL + sl_pin(gt, g, 2)] == 1) { c = c + 2; }
    if (ms[SL_VAL + sl_pin(gt, g, 3)] == 1) { c = c + 1; }
    return c;
}

/// The input pin that made gate g change: the first whose value differs from the one at the last evaluation (a tgate: 0 for the enable arc when
/// either gate pin changed, else 2); the first pin when none did.
pub fn sl_trigger(ms: []const usize, gt: []const usize, g: usize) -> usize {
    const kind : usize = sl_kind(gt, g);
    const base : usize = SL_PREV + g * 7;
    var j : usize = 0;
    var hit : usize = NONE;
    while (j < sl_n_in(kind)) {
        if (hit == NONE and ms[base + j] != ms[SL_VAL + sl_pin(gt, g, j)]) { hit = j; }
        j = j + 1;
    }
    if (hit == NONE) { hit = 0; }
    if (kind == G_TGATE and hit == 1) { hit = 0; }
    return hit;
}

/// The propagation delay, ps, of gate g changing to `want`: an unknown or a release is 1 ps; a delay cell reads its table; the others d0 + k * FO.
pub fn sl_delay(ms: []const usize, gt: []const usize, g: usize, ask: usize) -> usize {
    var dir : usize = SL_FALL;
    var known : bool = false;
    if (ask == SL_S1 or ask == SL_W1) {
        dir = SL_RISE;
        known = true;
    }
    if (ask == SL_S0 or ask == SL_W0) { known = true; }
    if (!known) { return 1; }
    const kind : usize = sl_kind(gt, g);
    const cur : usize = ms[SL_DRV + g];
    // a tgate that keeps its value and only changes strength (one of its devices turns off or on) takes 1 ps: the value does not travel
    if (kind == G_TGATE) {
        if ((cur == SL_S1 or cur == SL_W1) and (ask == SL_S1 or ask == SL_W1)) { return 1; }
        if ((cur == SL_S0 or cur == SL_W0) and (ask == SL_S0 or ask == SL_W0)) { return 1; }
    }
    if (kind == G_DELAY) {
        const c : usize = sl_code(ms, gt, g);
        if (dir == SL_RISE) { return SL_DC_RISE[c]; }
        return SL_DC_FALL[c];
    }
    const net : usize = sl_out_net(gt, g);
    var load : usize = ms[SL_LDF + net];
    if (dir == SL_RISE) { load = ms[SL_LDR + net]; }
    if (kind == G_TGATE) { load = load - 150; }
    const d : usize = sl_arc(sl_row(kind, sl_trigger(ms, gt, g)), dir, load);
    if (d < 1) { return 1; }
    return d;
}

// ---------------------------------------------------------------- the model

/// Look a net up by name in the converter's table (the names are lower case): its number, NONE when there is no such net.
pub fn sl_net(w: []const u8, gt: []const usize, name: []const u8) -> usize {
    var n : usize = 0;
    while (n < gt[GT_NNET]) {
        const a : usize = gt[GT_NET0 + n * 2];
        const b : usize = gt[GT_NET0 + n * 2 + 1];
        if (b - a == name.len) {
            var i : usize = 0;
            while (i < name.len and w[a + i] == name[i]) { i = i + 1; }
            if (i == name.len) { return n; }
        }
        n = n + 1;
    }
    return NONE;
}

/// The model at t = 0: every net unknown, every gate driving X, nothing pending, no input driven, nothing watched.
pub fn sl_init(ms: []usize, gt: []const usize) -> void {
    var n : usize = 0;
    while (n < gt[GT_NNET]) {
        ms[SL_VAL + n] = SL_X;
        n = n + 1;
    }
    var g : usize = 0;
    while (g < gt[GT_NGATE]) {
        ms[SL_DRV + g] = SL_X;
        ms[SL_PT + g] = NONE;
        var j : usize = 0;
        while (j < 7) {
            ms[SL_PREV + g * 7 + j] = SL_X;
            j = j + 1;
        }
        g = g + 1;
    }
}

/// The loads of every net, from the pins on it and the capacitance the top added (SL_EXTL, set by sl_ext_load before this).
pub fn sl_loads(ms: []usize, gt: []const usize) -> void {
    var n : usize = 0;
    while (n < gt[GT_NNET]) {
        ms[SL_LDR + n] = ms[SL_EXTL + n];
        ms[SL_LDF + n] = ms[SL_EXTL + n];
        n = n + 1;
    }
    var g : usize = 0;
    while (g < gt[GT_NGATE]) {
        const kind : usize = sl_kind(gt, g);
        var p : usize = 0;
        while (p < 4) {
            const net : usize = sl_pin(gt, g, p);
            if (p < sl_n_in(kind) or (kind == G_TGATE and p == 3)) {
                ms[SL_LDR + net] = ms[SL_LDR + net] + sl_pin_load(kind, p, SL_RISE);
                ms[SL_LDF + net] = ms[SL_LDF + net] + sl_pin_load(kind, p, SL_FALL);
            }
            p = p + 1;
        }
        g = g + 1;
    }
}

pub fn sl_ext_load(ms: []usize, net: usize, mfo: usize) -> void {
    ms[SL_EXTL + net] = mfo;
}

/// Watch a net: every change of its value is logged with the time.
pub fn sl_watch(ms: []usize, net: usize) -> void {
    ms[SL_WATCH + ms[SL_NWATCH]] = net;
    ms[SL_NWATCH] = ms[SL_NWATCH] + 1;
}

/// Set the value of net n at time t and log it if the net is watched and the value changed.
pub fn sl_set(ms: []usize, n: usize, v: usize, t: usize) -> void {
    if (ms[SL_VAL + n] == v) { return; }
    ms[SL_VAL + n] = v;
    var i : usize = 0;
    while (i < ms[SL_NWATCH]) {
        if (ms[SL_WATCH + i] == n and ms[SL_NLOG] < SL_LOGMAX) {
            const row : usize = SL_LOG + ms[SL_NLOG] * 3;
            ms[row] = t;
            ms[row + 1] = n;
            ms[row + 2] = v;
            ms[SL_NLOG] = ms[SL_NLOG] + 1;
        }
        i = i + 1;
    }
}

/// An input: net n takes the value v from now on (it has no driver in the circuit).
pub fn sl_drive(ms: []usize, n: usize, v: usize, t: usize) -> void {
    ms[SL_EXT + n] = 1;
    sl_set(ms, n, v, t);
}

/// The value a net takes from the drivers counted on it: strong beats weak, equal strength and different value is X, no driver holds `old`.
pub fn sl_resolve(ms: []const usize, n: usize, old: usize) -> usize {
    const b : usize = SL_CNT + n * 6;
    const s0 : usize = ms[b + SL_S0];
    const s1 : usize = ms[b + SL_S1];
    const sx : usize = ms[b + SL_X];
    const w0 : usize = ms[b + SL_W0];
    const w1 : usize = ms[b + SL_W1];
    if (s0 + s1 + sx > 0) {
        if (sx > 0 or (s0 > 0 and s1 > 0)) { return SL_X; }
        if (s1 > 0) { return 1; }
        return 0;
    }
    if (w0 + w1 > 0) {
        if (w0 > 0 and w1 > 0) { return SL_X; }
        if (w1 > 0) { return 1; }
        return 0;
    }
    return old;
}

/// Schedule or withdraw the change of gate g at time t (the inertial rule), then remember its inputs for the next evaluation.
pub fn sl_sched(ms: []usize, gt: []const usize, g: usize, t: usize) -> void {
    const ask : usize = sl_want(ms, gt, g);
    const cur : usize = ms[SL_DRV + g];
    if (ms[SL_PT + g] != NONE) {
        if (ask != ms[SL_PV + g]) {
            if (ask == cur) {
                ms[SL_PT + g] = NONE;
            } else {
                ms[SL_PT + g] = t + sl_delay(ms, gt, g, ask);
                ms[SL_PV + g] = ask;
            }
        }
    } else if (ask != cur) {
        ms[SL_PT + g] = t + sl_delay(ms, gt, g, ask);
        ms[SL_PV + g] = ask;
    }
    const kind : usize = sl_kind(gt, g);
    var j : usize = 0;
    while (j < sl_n_in(kind)) {
        ms[SL_PREV + g * 7 + j] = ms[SL_VAL + sl_pin(gt, g, j)];
        j = j + 1;
    }
}

/// One event time: the gates whose change matures now take effect, every net is resolved from what drives it, then every gate is evaluated.
pub fn sl_step(ms: []usize, gt: []const usize, t: usize) -> void {
    var g : usize = 0;
    while (g < gt[GT_NGATE]) {
        if (ms[SL_PT + g] == t) {
            ms[SL_DRV + g] = ms[SL_PV + g];
            ms[SL_PT + g] = NONE;
        }
        g = g + 1;
    }
    var n : usize = 0;
    while (n < gt[GT_NNET]) {
        var c : usize = 0;
        while (c < 6) {
            ms[SL_CNT + n * 6 + c] = 0;
            c = c + 1;
        }
        n = n + 1;
    }
    g = 0;
    while (g < gt[GT_NGATE]) {
        const o : usize = sl_out_net(gt, g);
        ms[SL_CNT + o * 6 + ms[SL_DRV + g]] = ms[SL_CNT + o * 6 + ms[SL_DRV + g]] + 1;
        g = g + 1;
    }
    n = 0;
    while (n < gt[GT_NNET]) {
        if (ms[SL_EXT + n] == 0) {
            sl_set(ms, n, sl_resolve(ms, n, ms[SL_VAL + n]), t);
        }
        n = n + 1;
    }
    g = 0;
    while (g < gt[GT_NGATE]) {
        sl_sched(ms, gt, g, t);
        g = g + 1;
    }
}

/// Run to time t_end (a second call continues where the first stopped). The stimulus is nst edges (time, net, value), sorted by time;
/// edges at one time are applied together before the step.
pub fn sl_run(ms: []usize, gt: []const usize, s_t: []const usize, s_n: []const usize, s_v: []const usize, nst: usize, t_end: usize) -> void {
    var si : usize = ms[SL_SI];
    var t : usize = ms[SL_T];
    var go : bool = true;
    while (go) {
        var nxt : usize = NONE;
        if (si < nst) { nxt = s_t[si]; }
        var g : usize = 0;
        while (g < gt[GT_NGATE]) {
            if (ms[SL_PT + g] < nxt) { nxt = ms[SL_PT + g]; }
            g = g + 1;
        }
        if (nxt == NONE or nxt > t_end or ms[SL_NSTEP] >= SL_MAXSTEP) {
            go = false;
        } else {
            t = nxt;
            while (si < nst and s_t[si] == t) {
                sl_drive(ms, s_n[si], s_v[si], t);
                si = si + 1;
            }
            sl_step(ms, gt, t);
            ms[SL_NSTEP] = ms[SL_NSTEP] + 1;
        }
    }
    ms[SL_T] = t;
    ms[SL_SI] = si;
}

// ---------------------------------------------------------------- reading the run

/// How many logged changes of net n went to value v at or after tmin.
pub fn sl_edges(ms: []const usize, n: usize, v: usize, tmin: usize) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i < ms[SL_NLOG]) {
        const row : usize = SL_LOG + i * 3;
        if (ms[row + 1] == n and ms[row + 2] == v and ms[row] >= tmin) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// The time of the nth (from 1) change of net n to value v at or after tmin, NONE when there is no such change.
pub fn sl_edge(ms: []const usize, n: usize, v: usize, nth: usize, tmin: usize) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    var found : usize = NONE;
    while (i < ms[SL_NLOG]) {
        const row : usize = SL_LOG + i * 3;
        if (ms[row + 1] == n and ms[row + 2] == v and ms[row] >= tmin) {
            c = c + 1;
            if (c == nth) { found = ms[row]; }
        }
        i = i + 1;
    }
    return found;
}

/// |a - b|.
pub fn sl_absdiff(a: usize, b: usize) -> usize {
    if (a > b) { return a - b; }
    return b - a;
}

/// Is the model's delay within SL_CK_BOUND_PM permille and SL_CK_ABS_PS ps of ngspice's?
pub fn sl_within(got: usize, ref_ps: usize) -> bool {
    return sl_err_pm(got, ref_ps) <= SL_CK_BOUND_PM and sl_absdiff(got, ref_ps) <= SL_CK_ABS_PS;
}

/// The same for a falling CK edge (SL_FALL_BOUND_PM, SL_FALL_ABS_PS).
pub fn sl_within_fall(got: usize, ref_ps: usize) -> bool {
    return sl_err_pm(got, ref_ps) <= SL_FALL_BOUND_PM and sl_absdiff(got, ref_ps) <= SL_FALL_ABS_PS;
}

/// The error of `got` against `ref_ps` in permille of `ref_ps`.
pub fn sl_err_pm(got: usize, ask: usize) -> usize {
    return sl_absdiff(got, ask) * 1000 / ask;
}

// ---------------------------------------------------------------- the netlist text

/// The wiring of SAR_logic, dff and clock_gen and the top's two lines, as netlist text (see the header): the gates carry their ports only. The
/// text is cut in pieces so the swapped-pins negative control can change one line.
pub const SL_DECK_A : str = "SAR logic and clock_gen of the golden SAR deck: the gates (ports only), dff, SAR_logic, clock_gen and the two lines of the top that wire them\n.subckt inverter Vin VDD VSS Vout\n.ends\n.subckt nor A B Vout VDD VSS\n.ends\n.subckt nor3 VDD VSS Vout A B C\n.ends\n.subckt tgate CLK nCLK In Out VDD VSS\n.ends\n.subckt delay_cell OUT VDD VSS IN A B C\n.ends\n.subckt dff VDD VSS Q CLK nQ D Reset Set\nx1 CLK nCLK D net1 VDD VSS tgate\nx2 Set net1 net2 VDD VSS nor\nx3 nCLK CLK net2 net3 VDD VSS tgate\nx4 Reset net3 Q VDD VSS nor\nx5 Q Set net4 VDD VSS nor\nx6 Q VDD VSS nQ inverter\nx7 CLK nCLK net4 net3 VDD VSS tgate\nx8 net2 Reset net5 VDD VSS nor\nx9 nCLK CLK net5 net1 VDD VSS tgate\nx10 CLK VDD VSS nCLK inverter\n.ends\n";
pub const SL_DECK_B1 : str = ".subckt SAR_logic CK3 CK11 CK7 CK2 CK6 CK10 CK1 CK9 CK5 CK8 CK4 VDD VSS D Valid Set clks\nx1 VDD VSS CK11 Valid net1 D clks Set dff\nx2 VDD VSS CK10 Valid net2 CK11 clks Set dff\nx3 VDD VSS CK9 Valid net3 CK10 clks Set dff\nx4 VDD VSS CK8 Valid net4 CK9 clks Set dff\n";
pub const SL_X5 : str = "x5 VDD VSS CK7 Valid net5 CK8 clks Set dff\n";
pub const SL_X5_SWAPPED : str = "x5 VDD VSS CK7 Valid net5 CK8 Set clks dff\n";
pub const SL_DECK_B2 : str = "x6 VDD VSS CK6 Valid net6 CK7 clks Set dff\nx7 VDD VSS CK5 Valid net7 CK6 clks Set dff\nx8 VDD VSS CK4 Valid net8 CK5 clks Set dff\nx9 VDD VSS CK3 Valid net9 CK4 clks Set dff\nx10 VDD VSS CK2 Valid net10 CK3 clks Set dff\nx11 VDD VSS CK1 Valid net11 CK2 clks Set dff\n.ends\n";
pub const SL_DECK_C : str = ".subckt clock_gen VDD Vout VSS clks Valid CK1 A B C\nx1 VDD VSS net1 clks Valid CK1 nor3\nx2 net2 VDD VSS net1 A B C delay_cell\nx3 net2 VDD VSS Vout inverter\n.ends\n.subckt sar_clk VDD VSS D Set clks Valid A B C CK11 CK10 CK9 CK8 CK7 CK6 CK5 CK4 CK3 CK2 CK1 clkc\nx7 CK3 CK11 CK7 CK2 CK6 CK10 CK1 CK9 CK5 CK8 CK4 VDD VSS D Valid Set clks SAR_logic\nx4 VDD clkc VSS clks Valid CK1 A B C clock_gen\n.ends\n.end\n";

/// Copy the text `lit` into dst at pos; the result is the position after it.
pub fn sl_cat(dst: []u8, pos: usize, lit: []const u8) -> usize {
    var i : usize = 0;
    while (i < lit.len and pos + i < dst.len) {
        dst[pos + i] = lit[i];
        i = i + 1;
    }
    return pos + i;
}

/// The whole netlist into dst; with `swapped` the dff x5 of SAR_logic has its Set and Reset pins exchanged (the negative control).
pub fn sl_deck(dst: []u8, swapped: bool) -> usize {
    var p : usize = sl_cat(dst, 0, SL_DECK_A);
    p = sl_cat(dst, p, SL_DECK_B1);
    if (swapped) { p = sl_cat(dst, p, SL_X5_SWAPPED); } else { p = sl_cat(dst, p, SL_X5); }
    p = sl_cat(dst, p, SL_DECK_B2);
    p = sl_cat(dst, p, SL_DECK_C);
    return p;
}

// ---------------------------------------------------------------- building and driving a run

/// One stimulus edge (time, net, value) written at index k; the result is k + 1.
pub fn sl_put(s_t: []usize, s_n: []usize, s_v: []usize, k: usize, t: usize, n: usize, v: usize) -> usize {
    s_t[k] = t;
    s_n[k] = n;
    s_v[k] = v;
    return k + 1;
}

/// The nets of the sequencer that the runs use, in `ids`: vdd, vss, d, set, clks, valid, a, b, c, then CK11 .. CK1 (9 .. 19), then clkc (20).
pub fn sl_ids(w: []const u8, gt: []const usize, ids: []usize) -> void {
    ids[0] = sl_net(w, gt, "vdd");
    ids[1] = sl_net(w, gt, "vss");
    ids[2] = sl_net(w, gt, "d");
    ids[3] = sl_net(w, gt, "set");
    ids[4] = sl_net(w, gt, "clks");
    ids[5] = sl_net(w, gt, "valid");
    ids[6] = sl_net(w, gt, "a");
    ids[7] = sl_net(w, gt, "b");
    ids[8] = sl_net(w, gt, "c");
    var i : usize = 0;
    while (i < 11) {
        var nm : [4]u8 = [99, 107, 49, 49];
        var len : usize = 4;
        if (i == 1) { nm[3] = 48; }
        if (i >= 2) {
            len = 3;
            nm[2] = 48 + (11 - i) as u8;
        }
        ids[9 + i] = sl_net(w, gt, nm[0 .. len]);
        i = i + 1;
    }
    ids[20] = sl_net(w, gt, "clkc");
}

/// Read the netlist, build the model of `sar_clk` and watch CK11 .. CK1 and clkc. False when the converter refuses the netlist.
pub fn sl_build(src: []u8, w: []u8, out: []u8, st: []usize, gt: []usize, ms: []usize, ids: []usize, swapped: bool) -> bool {
    const len : usize = sl_deck(src, swapped);
    const n : usize = emit_gates(src[0 .. len], "sar_clk", w, out, st, gt);
    if (st[ERR_LINE] != 0 or n == 0) { return false; }
    sl_init(ms, gt);
    sl_ids(w, gt, ids);
    sl_ext_load(ms, ids[19], SL_EXT_4F);
    sl_ext_load(ms, ids[20], SL_EXT_8F);
    sl_loads(ms, gt);
    var i : usize = 0;
    while (i < 12) {
        sl_watch(ms, ids[9 + i]);
        i = i + 1;
    }
    return true;
}

/// The stimulus of sar_logic_ref.cir at its measured 50 % points: the inputs at t = 0 with clks high (the reset), clks falling, eleven Valid pulses.
pub fn sl_stim(s_t: []usize, s_n: []usize, s_v: []usize, ids: []const usize) -> usize {
    var k : usize = 0;
    k = sl_put(s_t, s_n, s_v, k, 0, ids[0], 1);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[1], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[2], 1);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[3], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[6], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[7], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[8], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[5], 0);
    k = sl_put(s_t, s_n, s_v, k, 0, ids[4], 1);
    k = sl_put(s_t, s_n, s_v, k, SL_NG_CLKS_F, ids[4], 0);
    var i : usize = 0;
    while (i < 11) {
        k = sl_put(s_t, s_n, s_v, k, SL_NG_TV[i], ids[5], 1);
        k = sl_put(s_t, s_n, s_v, k, SL_NG_TVF[i], ids[5], 0);
        i = i + 1;
    }
    return k;
}

/// Do CK11 .. CK1 each rise exactly once in the whole run (a rise during the reset counts), never fall after the reset, and rise in the same order
/// as ngspice's rising edges?
pub fn sl_order_ok(ms: []const usize, ids: []const usize) -> bool {
    var i : usize = 0;
    while (i < 11) {
        if (sl_edges(ms, ids[9 + i], 1, 0) != 1) { return false; }
        if (sl_edges(ms, ids[9 + i], 0, SL_TMIN) != 0) { return false; }
        i = i + 1;
    }
    i = 0;
    while (i < 11) {
        var j : usize = 0;
        while (j < 11) {
            const ri : usize = sl_edge(ms, ids[9 + i], 1, 1, 0);
            const rj : usize = sl_edge(ms, ids[9 + j], 1, 1, 0);
            if ((ri < rj) != (SL_NG_TCK[i] < SL_NG_TCK[j])) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------- tests
// Each test builds the model from the netlist text above: the converter reads it into `gt`, the model runs on `gt`. The buffers are the caller's.

test the_gate_logic_is_the_truth_table_of_each_kind {
    // inverter
    assert(sl_not(0) == SL_S1 and sl_not(1) == SL_S0 and sl_not(SL_X) == SL_X);
    // nor: any 1 gives 0, all 0 gives 1, else unknown; a missing input is passed as 0
    assert(sl_nor_code(0, 0, 0) == SL_S1);
    assert(sl_nor_code(1, 0, 0) == SL_S0 and sl_nor_code(0, 1, 0) == SL_S0 and sl_nor_code(0, 0, 1) == SL_S0);
    assert(sl_nor_code(SL_X, 1, 0) == SL_S0);
    assert(sl_nor_code(SL_X, 0, 0) == SL_X);
    // nand: any 0 gives 1, all 1 gives 0
    assert(sl_nand_code(1, 1) == SL_S0);
    assert(sl_nand_code(0, 1) == SL_S1 and sl_nand_code(1, 0) == SL_S1 and sl_nand_code(0, 0) == SL_S1);
    assert(sl_nand_code(SL_X, 0) == SL_S1);
    assert(sl_nand_code(SL_X, 1) == SL_X);
    // tgate (pmos gate, nmos gate, in): both on pass strongly, one on passes its good level strongly and the other weakly, none on is off
    assert(sl_tg_code(0, 1, 0) == SL_S0 and sl_tg_code(0, 1, 1) == SL_S1);
    assert(sl_tg_code(1, 1, 0) == SL_S0 and sl_tg_code(1, 1, 1) == SL_W1);
    assert(sl_tg_code(0, 0, 1) == SL_S1 and sl_tg_code(0, 0, 0) == SL_W0);
    assert(sl_tg_code(1, 0, 0) == SL_Z and sl_tg_code(1, 0, 1) == SL_Z);
    assert(sl_tg_code(SL_X, 1, 0) == SL_X and sl_tg_code(0, 1, SL_X) == SL_X);
}

test a_net_takes_the_stronger_driver_holds_when_nothing_drives_and_goes_unknown_on_a_tie {
    var ms : [5000]usize = [0] ** 5000;
    // net 0: a strong 0 and a weak 1 -> 0; a weak 1 alone -> 1; a strong 0 and a strong 1 -> X; nothing -> the old value
    ms[SL_CNT + SL_S0] = 1;
    ms[SL_CNT + SL_W1] = 1;
    assert(sl_resolve(&ms, 0, 1) == 0);
    ms[SL_CNT + SL_S0] = 0;
    assert(sl_resolve(&ms, 0, 0) == 1);
    ms[SL_CNT + SL_W0] = 1;
    assert(sl_resolve(&ms, 0, 0) == SL_X);
    ms[SL_CNT + SL_W1] = 0;
    ms[SL_CNT + SL_W0] = 0;
    assert(sl_resolve(&ms, 0, 1) == 1);
    assert(sl_resolve(&ms, 0, 0) == 0);
    ms[SL_CNT + SL_S0] = 1;
    ms[SL_CNT + SL_S1] = 1;
    assert(sl_resolve(&ms, 0, 0) == SL_X);
    ms[SL_CNT + SL_S1] = 0;
    ms[SL_CNT + SL_Z] = 3;
    assert(sl_resolve(&ms, 0, 1) == 0);
}

test the_converter_hands_over_113_gates_in_100_nets_with_the_ports_of_the_root_first {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    const len : usize = sl_deck(&src, false);
    const n : usize = emit_gates(src[0 .. len], "sar_clk", &w, &out, &st, &gt);
    assert(n > 0);
    assert(st[ERR_LINE] == 0);
    assert(gt[GT_NGATE] == 113);
    assert(gt[GT_NNET] == 100);
    assert(gt[GT_PER_KIND + G_INV] == 23);
    assert(gt[GT_PER_KIND + G_NAND] == 0);
    assert(gt[GT_PER_KIND + G_NOR] == 44);
    assert(gt[GT_PER_KIND + G_NOR3] == 1);
    assert(gt[GT_PER_KIND + G_TGATE] == 44);
    assert(gt[GT_PER_KIND + G_DELAY] == 1);
    // the ports of the root are nets 0 .. 20 in the order of its .subckt line
    assert(sl_net(&w, &gt, "vdd") == 0);
    assert(sl_net(&w, &gt, "vss") == 1);
    assert(sl_net(&w, &gt, "valid") == 5);
    assert(sl_net(&w, &gt, "ck11") == 9);
    assert(sl_net(&w, &gt, "ck1") == 19);
    assert(sl_net(&w, &gt, "clkc") == 20);
    // an internal net is named by its instance path; the nQ of dff x3 of SAR_logic and the dff's own net3
    assert(sl_net(&w, &gt, "x7.net3") != NONE);
    assert(sl_net(&w, &gt, "x7.x3.net3") != NONE);
    assert(sl_net(&w, &gt, "x7.x3.net3") != sl_net(&w, &gt, "x7.net3"));
    assert(sl_net(&w, &gt, "x4.net1") != NONE);
    assert(sl_net(&w, &gt, "nosuchnet") == NONE);
}

test every_tgate_is_used_from_in_to_out_and_its_out_is_a_stored_node {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    const len : usize = sl_deck(&src, false);
    const n : usize = emit_gates(src[0 .. len], "sar_clk", &w, &out, &st, &gt);
    assert(n > 0);
    var tg : usize = 0;
    var bad_in : usize = 0;
    var driven_out : usize = 0;
    var g : usize = 0;
    while (g < gt[GT_NGATE]) {
        if (sl_kind(&gt, g) == G_TGATE) {
            tg = tg + 1;
            const innet : usize = sl_pin(&gt, g, 2);
            const outnet : usize = sl_pin(&gt, g, 3);
            // is anything but a tgate driving the In net, or is it an input of the sequencer (D, Set, a CK port)?
            var drv : usize = 0;
            var h : usize = 0;
            while (h < gt[GT_NGATE]) {
                if (sl_kind(&gt, h) != G_TGATE and sl_out_net(&gt, h) == innet) { drv = drv + 1; }
                if (sl_kind(&gt, h) != G_TGATE and sl_out_net(&gt, h) == outnet) { driven_out = driven_out + 1; }
                h = h + 1;
            }
            if (drv == 0 and innet > 8) { bad_in = bad_in + 1; }
        }
        g = g + 1;
    }
    assert(tg == 44);
    // the In of a tgate is a gate's output or one of the inputs vdd vss d set clks valid a b c (nets 0 .. 8); the Out is never a gate's output
    assert(bad_in == 0);
    assert(driven_out == 0);
}

test the_reset_resolves_the_unknown_start_and_clears_every_ck {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5000]usize = [0] ** 5000;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    assert(sl_build(&src, &w, &out, &st, &gt, &ms, &ids, false));
    const k : usize = sl_stim(&s_t, &s_n, &s_v, &ids);
    assert(k == 32);
    // every net is unknown at t = 0, and none is after the reset and the first clks fall, before the first Valid edge
    assert(ms[SL_VAL + ids[9]] == SL_X);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 70000);
    var i : usize = 0;
    while (i < 11) {
        assert(ms[SL_VAL + ids[9 + i]] == 0);
        i = i + 1;
    }
    var unknown : usize = 0;
    var n : usize = 0;
    while (n < gt[GT_NNET]) {
        if (ms[SL_VAL + n] == SL_X) { unknown = unknown + 1; }
        n = n + 1;
    }
    assert(unknown == 0);
    // the clock has started on its own: clkc went high once clks fell
    assert(ms[SL_VAL + ids[20]] == 1);
}

test eleven_valid_pulses_make_ck11_to_ck1_rise_once_each_in_ngspices_order_within_the_bound {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5000]usize = [0] ** 5000;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    assert(sl_build(&src, &w, &out, &st, &gt, &ms, &ids, false));
    const k : usize = sl_stim(&s_t, &s_n, &s_v, &ids);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 540000);
    assert(sl_order_ok(&ms, &ids));
    var i : usize = 0;
    while (i < 11) {
        const r : usize = sl_edge(&ms, ids[9 + i], 1, 1, SL_TMIN);
        assert(r > SL_NG_TV[i]);
        assert(r < SL_NG_TVF[i]);
        const got : usize = r - SL_NG_TV[i];
        const ng : usize = SL_NG_TCK[i] - SL_NG_TV[i];
        assert(sl_within(got, ng));
        i = i + 1;
    }
    // CK1 carries the nor3 pin and 4 fF more than the others: its delay is the longest of the eleven, in the model as in ngspice
    const d1 : usize = sl_edge(&ms, ids[19], 1, 1, SL_TMIN) - SL_NG_TV[10];
    const d2 : usize = sl_edge(&ms, ids[18], 1, 1, SL_TMIN) - SL_NG_TV[9];
    assert(d1 > d2);
}

test the_asynchronous_clock_starts_after_clks_falls_and_follows_every_valid_pulse {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5000]usize = [0] ** 5000;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    assert(sl_build(&src, &w, &out, &st, &gt, &ms, &ids, false));
    const k : usize = sl_stim(&s_t, &s_n, &s_v, &ids);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 540000);
    // eleven rises (after clks falls, then after the first ten Valid falls: CK1 holds the eleventh back) and eleven falls (one per Valid rise), as in ngspice
    assert(sl_edges(&ms, ids[20], 1, SL_TMIN) == 11);
    assert(sl_edges(&ms, ids[20], 0, SL_TMIN) == 11);
    // the settled edges: the first rise from clks falling, the first fall from the first Valid rise
    const r1 : usize = sl_edge(&ms, ids[20], 1, 1, SL_TMIN);
    assert(r1 > SL_NG_CLKS_F);
    assert(sl_err_pm(r1 - SL_NG_CLKS_F, SL_NG_TCR[0] - SL_NG_CLKS_F) <= SL_CLKC_BOUND_PM);
    const f1 : usize = sl_edge(&ms, ids[20], 0, 1, SL_TMIN);
    assert(f1 > SL_NG_TV[0]);
    assert(sl_err_pm(f1 - SL_NG_TV[0], SL_NG_TCF[0] - SL_NG_TV[0]) <= SL_CLKC_BOUND_PM);
    // the repeated edges: each from the Valid edge that causes it, with the wide bounds of the header
    var i : usize = 1;
    while (i < 11) {
        const rr : usize = sl_edge(&ms, ids[20], 1, i + 1, SL_TMIN);
        assert(rr > SL_NG_TVF[i - 1]);
        assert(sl_err_pm(rr - SL_NG_TVF[i - 1], SL_NG_TCR[i] - SL_NG_TVF[i - 1]) <= SL_REPEAT_R_BOUND_PM);
        const ff : usize = sl_edge(&ms, ids[20], 0, i + 1, SL_TMIN);
        assert(ff > SL_NG_TV[i]);
        assert(sl_err_pm(ff - SL_NG_TV[i], SL_NG_TCF[i] - SL_NG_TV[i]) <= SL_REPEAT_F_BOUND_PM);
        i = i + 1;
    }
}

test the_gate_arcs_reproduce_the_measured_points_of_the_arc_deck {
    var row : usize = 0;
    var worst : usize = 0;
    while (row < 10) {
        var dir : usize = 0;
        while (dir < 2) {
            var li : usize = 0;
            while (li < 3) {
                var load : usize = 1000;
                if (li == 1) { load = 4000; }
                if (li == 2) { load = 16000; }
                const model : usize = sl_arc(row, dir, load);
                const ng : usize = SL_NG_ARC[row * 6 + dir * 3 + li];
                const e : usize = sl_absdiff(model, ng);
                assert(e <= SL_ARC_ABS_PS);
                if (e > worst) { worst = e; }
                li = li + 1;
            }
            dir = dir + 1;
        }
        row = row + 1;
    }
    // the worst error is a real one, not zero: the table is a fit, not a copy
    assert(worst > 0);
    // a nor driving one inverter input rises slower than it falls, a nor3 slower than a nor (the series PMOS stack), and a heavier load is slower
    assert(sl_arc(3, SL_RISE, 1000) > sl_arc(3, SL_FALL, 1000));
    assert(sl_arc(5, SL_RISE, 1000) > sl_arc(3, SL_RISE, 1000));
    assert(sl_arc(0, SL_RISE, 4000) > sl_arc(0, SL_RISE, 1000));
}

test the_delay_cell_trim_codes_give_ngspices_clks_to_clkc_delays_for_all_eight_settings {
    var code : usize = 0;
    var base_r : usize = 0;
    while (code < 8) {
        var src : [4096]u8 = undefined;
        var w : [24576]u8 = undefined;
        var out : [24576]u8 = undefined;
        var st : [3000]usize = [0] ** 3000;
        var gt : [3200]usize = [0] ** 3200;
        var ms : [5000]usize = [0] ** 5000;
        const len : usize = sl_deck(&src, false);
        const n : usize = emit_gates(src[0 .. len], "clock_gen", &w, &out, &st, &gt);
        assert(n > 0);
        assert(st[ERR_LINE] == 0);
        assert(gt[GT_NGATE] == 3);
        sl_init(&ms, &gt);
        const vdd : usize = sl_net(&w, &gt, "vdd");
        const vss : usize = sl_net(&w, &gt, "vss");
        const clks : usize = sl_net(&w, &gt, "clks");
        const valid : usize = sl_net(&w, &gt, "valid");
        const ck1 : usize = sl_net(&w, &gt, "ck1");
        const va : usize = sl_net(&w, &gt, "a");
        const vb : usize = sl_net(&w, &gt, "b");
        const vc : usize = sl_net(&w, &gt, "c");
        const vout : usize = sl_net(&w, &gt, "vout");
        sl_ext_load(&ms, vout, SL_EXT_8F);
        sl_loads(&ms, &gt);
        sl_watch(&ms, vout);
        var s_t : [16]usize = [0] ** 16;
        var s_n : [16]usize = [0] ** 16;
        var s_v : [16]usize = [0] ** 16;
        var k : usize = 0;
        k = sl_put(&s_t, &s_n, &s_v, k, 0, vdd, 1);
        k = sl_put(&s_t, &s_n, &s_v, k, 0, vss, 0);
        k = sl_put(&s_t, &s_n, &s_v, k, 0, valid, 0);
        k = sl_put(&s_t, &s_n, &s_v, k, 0, ck1, 0);
        k = sl_put(&s_t, &s_n, &s_v, k, 0, va, (code / 4) % 2);
        k = sl_put(&s_t, &s_n, &s_v, k, 0, vb, (code / 2) % 2);
        k = sl_put(&s_t, &s_n, &s_v, k, 0, vc, code % 2);
        k = sl_put(&s_t, &s_n, &s_v, k, 0, clks, 1);
        k = sl_put(&s_t, &s_n, &s_v, k, 10100, clks, 0);
        k = sl_put(&s_t, &s_n, &s_v, k, 90300, clks, 1);
        sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 190000);
        const r : usize = sl_edge(&ms, vout, 1, 1, 5000);
        const f : usize = sl_edge(&ms, vout, 0, 1, 50000);
        assert(r > 10100);
        assert(f > 90300);
        assert(sl_err_pm(r - 10100, SL_NG_TOT_R[code]) <= SL_DC_BOUND_PM);
        assert(sl_err_pm(f - 90300, SL_NG_TOT_F[code]) <= SL_DC_BOUND_PM);
        // more bits set, a shorter clks -> clkc rise (the falling output of the delay cell is trimmed by A, B and C)
        if (code == 0) { base_r = r - 10100; }
        if (code == 7) { assert(r - 10100 < base_r); }
        code = code + 1;
    }
}

test a_node_that_only_a_tgate_drives_holds_its_value_when_the_tgate_turns_off {
    var src : [1024]u8 = undefined;
    var w : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5000]usize = [0] ** 5000;
    // one tgate (PMOS gate en, NMOS gate nen) from d to q, and an inverter on q
    const len : usize = sl_cat(&src, 0, "hold\n.subckt inverter Vin VDD VSS Vout\n.ends\n.subckt tgate CLK nCLK In Out VDD VSS\n.ends\n.subckt hold en nen d q y vdd vss\nx1 en nen d q vdd vss tgate\nx2 q vdd vss y inverter\n.ends\n.end\n");
    const n : usize = emit_gates(src[0 .. len], "hold", &w, &out, &st, &gt);
    assert(n > 0);
    assert(st[ERR_LINE] == 0);
    assert(gt[GT_NGATE] == 2);
    sl_init(&ms, &gt);
    sl_loads(&ms, &gt);
    const en : usize = sl_net(&w, &gt, "en");
    const nen : usize = sl_net(&w, &gt, "nen");
    const d : usize = sl_net(&w, &gt, "d");
    const q : usize = sl_net(&w, &gt, "q");
    const y : usize = sl_net(&w, &gt, "y");
    sl_watch(&ms, q);
    var s_t : [16]usize = [0] ** 16;
    var s_n : [16]usize = [0] ** 16;
    var s_v : [16]usize = [0] ** 16;
    var k : usize = 0;
    k = sl_put(&s_t, &s_n, &s_v, k, 0, sl_net(&w, &gt, "vdd"), 1);
    k = sl_put(&s_t, &s_n, &s_v, k, 0, sl_net(&w, &gt, "vss"), 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 0, d, 1);
    k = sl_put(&s_t, &s_n, &s_v, k, 0, en, 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 0, nen, 1);
    k = sl_put(&s_t, &s_n, &s_v, k, 5000, en, 1);
    k = sl_put(&s_t, &s_n, &s_v, k, 5000, nen, 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 10000, d, 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 15000, en, 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 15000, nen, 1);
    // conducting: q follows d = 1
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 4900);
    assert(ms[SL_VAL + q] == 1);
    assert(ms[SL_VAL + y] == 0);
    // off, then d falls: q keeps 1 (dynamic storage), the inverter still reads 1
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 14900);
    assert(ms[SL_VAL + d] == 0);
    assert(ms[SL_VAL + q] == 1);
    assert(ms[SL_VAL + y] == 0);
    // on again: q takes the new value after the tgate's delay, y after the inverter's
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 20000);
    assert(ms[SL_VAL + q] == 0);
    assert(ms[SL_VAL + y] == 1);
    const tq : usize = sl_edge(&ms, q, 0, 1, 1000);
    assert(tq > 15000);
    assert(tq < 15400);
}

test a_pulse_shorter_than_the_delay_is_swallowed_and_a_tie_of_two_drivers_is_unknown {
    var src : [1024]u8 = undefined;
    var w : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5000]usize = [0] ** 5000;
    // an inverter y = not a, unloaded: its fall takes d0 = 64 ps, its rise 48 ps
    const len : usize = sl_cat(&src, 0, "glitch\n.subckt inverter Vin VDD VSS Vout\n.ends\n.subckt top a y vdd vss\nx1 a vdd vss y inverter\n.ends\n.end\n");
    const n : usize = emit_gates(src[0 .. len], "top", &w, &out, &st, &gt);
    assert(n > 0);
    assert(st[ERR_LINE] == 0);
    sl_init(&ms, &gt);
    sl_loads(&ms, &gt);
    const a : usize = sl_net(&w, &gt, "a");
    const y : usize = sl_net(&w, &gt, "y");
    sl_watch(&ms, y);
    var s_t : [16]usize = [0] ** 16;
    var s_n : [16]usize = [0] ** 16;
    var s_v : [16]usize = [0] ** 16;
    var k : usize = 0;
    k = sl_put(&s_t, &s_n, &s_v, k, 0, sl_net(&w, &gt, "vdd"), 1);
    k = sl_put(&s_t, &s_n, &s_v, k, 0, sl_net(&w, &gt, "vss"), 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 0, a, 0);
    // a rises at 1000 and falls again at 1030 (30 ps < 64 ps): y must not move; a rises again at 2000 and stays: y falls 64 ps later
    k = sl_put(&s_t, &s_n, &s_v, k, 1000, a, 1);
    k = sl_put(&s_t, &s_n, &s_v, k, 1030, a, 0);
    k = sl_put(&s_t, &s_n, &s_v, k, 2000, a, 1);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 5000);
    assert(sl_edges(&ms, y, 0, 500) == 1);
    assert(sl_edge(&ms, y, 0, 1, 500) == 2064);
    assert(ms[SL_VAL + y] == 0);
}

test one_dff_with_set_and_reset_swapped_fails_the_order_check_that_the_right_netlist_passes {
    var src : [4096]u8 = undefined;
    var w : [24576]u8 = undefined;
    var out : [24576]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var gt : [3200]usize = [0] ** 3200;
    var ms : [5000]usize = [0] ** 5000;
    var ids : [24]usize = [0] ** 24;
    var s_t : [64]usize = [0] ** 64;
    var s_n : [64]usize = [0] ** 64;
    var s_v : [64]usize = [0] ** 64;
    assert(sl_build(&src, &w, &out, &st, &gt, &ms, &ids, false));
    var k : usize = sl_stim(&s_t, &s_n, &s_v, &ids);
    sl_run(&ms, &gt, &s_t, &s_n, &s_v, k, 540000);
    assert(sl_order_ok(&ms, &ids));
    // the same run on the netlist whose fifth dff has Set = clks and Reset = Set
    var st2 : [3000]usize = [0] ** 3000;
    var gt2 : [3200]usize = [0] ** 3200;
    var ms2 : [5000]usize = [0] ** 5000;
    var ids2 : [24]usize = [0] ** 24;
    assert(sl_build(&src, &w, &out, &st2, &gt2, &ms2, &ids2, true));
    k = sl_stim(&s_t, &s_n, &s_v, &ids2);
    sl_run(&ms2, &gt2, &s_t, &s_n, &s_v, k, 540000);
    assert(!sl_order_ok(&ms2, &ids2));
    // CK7 (the fifth stage's output) is the one that is wrong: set during the reset (a first rise), it falls at the first Valid edge when the stage
    // takes its D = 0 (Reset is now the constant Set) and rises again in its turn: two rises and one fall after the reset, at ngspice's times
    assert(sl_edges(&ms2, ids2[13], 1, 0) == 2);
    assert(sl_edges(&ms2, ids2[13], 0, SL_TMIN) == 1);
    const f7 : usize = sl_edge(&ms2, ids2[13], 0, 1, SL_TMIN);
    assert(f7 > SL_NG_TV[0]);
    assert(sl_within_fall(f7 - SL_NG_TV[0], SL_NG_SW_CK7_F - SL_NG_TV[0]));
    const r7 : usize = sl_edge(&ms2, ids2[13], 1, 2, 0);
    assert(r7 > SL_NG_TV[4]);
    assert(sl_within(r7 - SL_NG_TV[4], SL_NG_SW_CK7_R2 - SL_NG_TV[4]));
    // CK6, whose D is CK7, rises at the FIRST edge, falls at the second and rises at its own, the sixth
    assert(sl_edges(&ms2, ids2[14], 1, 0) == 2);
    assert(sl_edges(&ms2, ids2[14], 0, SL_TMIN) == 1);
    const a6 : usize = sl_edge(&ms2, ids2[14], 1, 1, 0);
    assert(a6 > SL_NG_TV[0]);
    assert(sl_within(a6 - SL_NG_TV[0], SL_NG_SW_CK6_R1 - SL_NG_TV[0]));
    const f6 : usize = sl_edge(&ms2, ids2[14], 0, 1, SL_TMIN);
    assert(f6 > SL_NG_TV[1]);
    assert(sl_within_fall(f6 - SL_NG_TV[1], SL_NG_SW_CK6_F - SL_NG_TV[1]));
    const b6 : usize = sl_edge(&ms2, ids2[14], 1, 2, 0);
    assert(b6 > SL_NG_TV[5]);
    assert(sl_within(b6 - SL_NG_TV[5], SL_NG_SW_CK6_R2 - SL_NG_TV[5]));
    // the other stages are untouched: CK11 rises once, on time
    assert(sl_edges(&ms2, ids2[9], 1, 0) == 1);
}
