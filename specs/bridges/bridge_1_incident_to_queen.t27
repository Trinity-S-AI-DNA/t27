// specs/bridges/bridge_1_incident_to_queen.t27 - Doctor incident -> Queen task -> GitHub Issue bridge
module bridges::incident_to_queen {
    use github::protocol::{incident_to_github_issue, atomic_claim, LABEL_STATUS_OPEN};
    use queen::tasks::{QueenTask, Evidence, task_create_from_incident, TaskStatus};
    use queen::incident_adapter::{DoctorIncident, incident_to_queen_task};
    
    // Bridge 1: Doctor incident -> Queen task -> GitHub Issue
    // This bridge converts Doctor incidents into Queen tasks and GitHub issues
    // Evidence from incident is copied into issue body and comments
    
    // Bridge result enum
    enum Bridge1Result {
        Success,
        IncidentConversionFailed,
        TaskCreationFailed,
        IssueCreationFailed,
        ClaimFailed,
        PartialFailure,
    }
    
    // Main bridge function: incident -> Queen task -> GitHub Issue
    fn incident_to_queen_bridge(
        incident_id: str,
        incident_title: str,
        incident_description: str,
        incident_severity: str,
        incident_created_at: str,
        incident_status: str,
        incident_evidence: [Evidence]
    ) -> Bridge1Result {
        print("🔗 BRIDGE_1: Starting incident_to_queen bridge");
        
        // Step 1: Create Doctor incident structure
        var doctor_incident: DoctorIncident = undefined;
        doctor_incident.id = incident_id;
        doctor_incident.title = incident_title;
        doctor_incident.description = incident_description;
        doctor_incident.severity = incident_severity;
        doctor_incident.created_at = incident_created_at;
        doctor_incident.status = incident_status;
        doctor_incident.evidence = incident_evidence;
        
        print("📝 Step 1: Doctor incident created");
        
        // Step 2: Convert Doctor incident to Queen task
        var queen_task = incident_to_queen_task(doctor_incident);
        
        if (queen_task.id == 0) {
            print("❌ Queen task creation failed");
            return Bridge1Result::TaskCreationFailed;
        }
        
        print("👑 Step 2: Queen task created");
        print("   Task ID: {}", queen_task.id);
        print("   Task Title: {}", queen_task.title);
        print("   Status: {}", queen_task.status);
        print("   Evidence count: {}", queen_task.evidence.len);
        
        // Step 3: Create GitHub issue from Queen task
        var (issue_number, issue_url) = incident_to_github_issue(
            incident_id, 
            queen_task.title,
            format!("{}\n\n## Original Incident\n{}", incident_description, evidence_to_summary(incident_evidence)),
            incident_severity,
            ""  // No initial agent assignment
        );
        
        if (issue_number == 0) {
            print("❌ GitHub issue creation failed");
            return Bridge1Result::IssueCreationFailed;
        }
        
        print("🌐 Step 3: GitHub issue created");
        print("   Issue Number: {}", issue_number);
        print("   Issue URL: {}", issue_url);
        
        // Step 4: Update Queen task with GitHub issue ID
        queen_task.github_issue_id = issue_number;
        
        // Step 5: Copy incident evidence to issue comments
        var evidence_copied = 0;
        for (var i = 0; i < incident_evidence.len; i++) {
            var evidence = incident_evidence[i];
            
            // Create evidence comment on GitHub issue
            var comment_body = format!(
                "INCIDENT_EVIDENCE\n\n"
                "**Source**: {}\n"
                "**Timestamp**: {}\n"
                "**Evidence ID**: {}\n\n"
                "```\n{}\n```",
                evidence.source, evidence.timestamp, evidence.id, evidence.content
            );
            
            var comment_result = github_comment_create(issue_number, comment_body);
            if (comment_result.success) {
                evidence_copied++;
                print("   📎 Evidence {} copied to issue comment", evidence.id);
            }
        }
        
        // Step 6: Add bridge metadata to issue body
        var bridge_metadata = format!(
            "\n\n## Bridge Information\n"
            "- **Bridge**: BRIDGE_1 incident_to_queen\n"
            "- **Queen Task ID**: {}\n"
            "- **Incident ID**: {}\n"
            "- **Evidence Copied**: {} items\n"
            "- **Created**: {}",
            queen_task.id, incident_id, evidence_copied, iso8601_now()
        );
        
        var body_update_success = github_issue_update_body(issue_number, 
            queen_task.title + "\n\n" + bridge_metadata);
        
        if (!body_update_success) {
            print("⚠️  Warning: Bridge metadata not added to issue body");
        } else {
            print("🏗️  Step 6: Bridge metadata added to issue body");
        }
        
        // Step 7: Final verification
        var final_issue = github_issue_get(issue_number);
        var final_task = queen_task;
        
        // Verify all components are connected
        var bridge_complete = 
            final_issue.number > 0 &&
            final_task.id > 0 &&
            final_task.github_issue_id == issue_number &&
            evidence_copied > 0;
        
        if (bridge_complete) {
            print("✅ BRIDGE_1: incident_to_queen bridge completed successfully");
            print("   📊 Summary: {} -> {} -> {}", incident_id, queen_task.id, issue_number);
            return Bridge1Result::Success;
        } else {
            print("❌ BRIDGE_1: Bridge incomplete");
            return Bridge1Result::PartialFailure;
        }
    }
    
    // Evidence to summary converter for issue body
    fn evidence_to_summary(evidence: [Evidence]) -> str {
        if (evidence.len == 0) {
            return "No incident evidence available";
        }
        
        var summary: str = "### Incident Evidence Summary\n\n";
        
        for (var i = 0; i < evidence.len; i++) {
            var entry = evidence[i];
            summary = summary + format!(
                "**[{}] {}** - {}\n"
                "- ID: {}\n"
                "- Time: {}\n\n",
                i + 1, entry.source, entry.content, entry.id, entry.timestamp
            );
        }
        
        return summary;
    }
    
    // Helper functions for GitHub operations
    fn github_comment_create(issue_number: u32, body: str) -> {success: bool, comment_id: u64} {
        var result: {success: bool, comment_id: u64} = undefined;
        result.success = true;  // Mock implementation
        result.comment_id = 1000u64 + issue_number;
        return result;
    }
    
    fn github_issue_update_body(issue_number: u32, body: str) -> bool {
        return true;  // Mock implementation
    }
    
    fn github_issue_get(issue_number: u32) -> {number: u32, title: str, body: str} {
        var issue: {number: u32, title: str, body: str} = undefined;
        issue.number = issue_number;
        issue.title = "Mock Issue";
        issue.body = "Mock issue body with evidence";
        return issue;
    }
    
    fn iso8601_now() -> str {
        return "2024-01-01T00:00:00Z";
    }
    
    fn print(message: str) {
        // Print function for logging
        print(message);
    }
    
    fn print(message: str, param: u64) {
        // Print function with parameter
        print(message, param);
    }
    
    fn print(message: str, param: str) {
        // Print function with string parameter
        print(message, param);
    }
    
    // Test functions for bridge verification
    test "bridge_1_basic_incident_conversion" {
        var incident_evidence: [Evidence] = undefined;
        
        var incident_id: str = "test-incident-001";
        var incident_title: str = "Database Connection Failure";
        var incident_description: str = "Users unable to connect to primary database";
        var incident_severity: str = "high";
        var incident_created_at: str = "2024-01-01T10:00:00Z";
        var incident_status: str = "open";
        
        var result = incident_to_queen_bridge(
            incident_id, incident_title, incident_description, 
            incident_severity, incident_created_at, incident_status, incident_evidence
        );
        
        assert(result == Bridge1Result::Success);
        print("✅ Basic incident conversion test passed");
    }
    
    test "bridge_1_with_evidence" {
        // Create test evidence
        var evidence1: Evidence = undefined;
        evidence1.id = 2001;
        evidence1.timestamp = "2024-01-01T10:15:00Z";
        evidence1.content = "Error logs show connection timeout";
        evidence1.source = "logs";
        
        var evidence2: Evidence = undefined;
        evidence2.id = 2002;
        evidence2.timestamp = "2024-01-01T10:30:00Z";
        evidence2.content = "Database server showing 100% CPU usage";
        evidence2.source = "monitoring";
        
        var evidence_list: [Evidence] = undefined;
        evidence_list.push(evidence1);
        evidence_list.push(evidence2);
        
        var result = incident_to_queen_bridge(
            "evidence-test-001", "Evidence Test", "Test with evidence",
            "critical", "2024-01-01T10:00:00Z", "open", evidence_list
        );
        
        assert(result == Bridge1Result::Success);
        print("✅ Evidence copying test passed");
    }
    
    test "bridge_1_error_handling" {
        // Test with invalid incident data
        var empty_evidence: [Evidence] = undefined;
        
        var result = incident_to_queen_bridge(
            "",  // Empty incident ID
            "Test", "Description", "low", 
            "2024-01-01T10:00:00Z", "open", empty_evidence
        );
        
        // Should handle gracefully, though specific result depends on implementation
        assert(result == Bridge1Result::Success || result == Bridge1Result::PartialFailure);
        print("✅ Error handling test passed");
    }
}