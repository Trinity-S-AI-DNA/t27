// SPDX-License-Identifier: Apache-2.0
// specs/provider/call.t27 -- the outbound provider call, as laws: the request bytes one writes to
// a provider's chat-completions endpoint, and the assistant's content one reads back out of the
// reply. The socket belongs to the caller (the walk, issue 12797's successor); this spec owns the
// BYTES. Keys travel as the caller holds them and are never printed; the max_tokens comes in from
// the caller, which applies the floor law (provider/transform.t27).
// phi^2 + 1/phi^2 = 3 | TRINITY

module ProviderCall;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

// ---- the request --------------------------------------------------------------------------------------------

/// The JSON body of one chat-completions call: the model, one user message, no stream, the
/// caller's max_tokens. Quotes and backslashes in the prompt are escaped. Returns the new
/// position (the length, from 0).
pub fn chat_body(model: []const u8, prompt: []const u8, max_tokens: u32, out: []u8) -> usize {
    var n : usize = 0;
    n = put_bytes(out, n, "{\"model\":\"");
    n = n + json_copy(out, n, model);
    n = put_bytes(out, n, "\",\"messages\":[{\"role\":\"user\",\"content\":\"");
    n = n + json_copy(out, n, prompt);
    n = put_bytes(out, n, "\"}],\"stream\":false,\"max_tokens\":");
    n = put_dec(out, n, @as(u64, max_tokens));
    n = put_bytes(out, n, "}");
    return n;
}

/// The whole request: the head, then the body, with Content-Length naming the body's length.
/// Returns the new position. `path` carries the leading slash ("/v1/chat/completions").
pub fn chat_request(host: []const u8, path: []const u8, key: []const u8, model: []const u8, prompt: []const u8, max_tokens: u32, out: []u8) -> usize {
    var tail : [4096]u8 = undefined;
    const bn : usize = chat_body(model, prompt, max_tokens, tail[0..4096]);
    var n : usize = 0;
    n = put_bytes(out, n, "POST ");
    n = put_bytes(out, n, path);
    n = put_bytes(out, n, " HTTP/1.1\r\n");
    n = put_bytes(out, n, "Host: ");
    n = put_bytes(out, n, host);
    n = put_bytes(out, n, "\r\nAuthorization: Bearer ");
    n = put_bytes(out, n, key);
    n = put_bytes(out, n, "\r\nContent-Type: application/json\r\nContent-Length: ");
    n = put_dec(out, n, @as(u64, bn));
    n = put_bytes(out, n, "\r\n\r\n");
    var j : usize = 0;
    while (j < bn) {
        out[n + j] = tail[j];
        j = j + 1;
    }
    return n + bn;
}

/// Copies src into out at n, escaping what JSON strings must escape: the quote and the
/// backslash. Returns the number of bytes WRITTEN (the caller adds it to its own position).
fn json_copy(out: []u8, n: usize, src: []const u8) -> usize {
    var w : usize = 0;
    var i : usize = 0;
    while (i < src.len) {
        if (out.len <= n + w + 1) { return w; }
        if (src[i] == 34 or src[i] == 92) {
            out[n + w] = 92;
            w = w + 1;
            if (out.len <= n + w) { return w; }
        }
        out[n + w] = src[i];
        w = w + 1;
        i = i + 1;
    }
    return w;
}

// ---- the reply ----------------------------------------------------------------------------------------------

/// The assistant's content, read out of a chat-completions reply: the bytes after
/// "content":" up to the closing quote, the \" and \\ escapes decoded. 0 when the reply
/// names no content.
pub fn reply_content(resp: []const u8, out: []u8) -> usize {
    const tag : []const u8 = "\"content\":\"";
    var i : usize = 0;
    while (i + tag.len <= resp.len) {
        var hit : bool = true;
        var k : usize = 0;
        while (k < tag.len) {
            if (resp[i + k] != tag[k]) { hit = false; }
            k = k + 1;
        }
        if (hit) {
            return copy_content(resp, i + tag.len, out);
        }
        i = i + 1;
    }
    return 0;
}

/// Copies the escaped string that starts at `at` until its closing quote. Returns the decoded
/// length, 0 when the string never closes.
fn copy_content(resp: []const u8, at: usize, out: []u8) -> usize {
    var w : usize = 0;
    var i : usize = at;
    while (i < resp.len) {
        if (resp[i] == 34) { return w; }
        if (resp[i] == 92 and i + 1 < resp.len) {
            const e : u8 = resp[i + 1];
            if (out.len <= w) { return w; }
            if (e == 110) {
                out[w] = 10;
            } else {
                out[w] = e;
            }
            w = w + 1;
            i = i + 2;
        } else {
            if (out.len <= w) { return w; }
            out[w] = resp[i];
            w = w + 1;
            i = i + 1;
        }
    }
    return 0;
}

// ---- the tests ----------------------------------------------------------------------------------------------

test "the_request_carries_the_head_and_the_body" {
    var out : [512]u8 = undefined;
    const n : usize = chat_request("integrate.api.nvidia.com", "/v1/chat/completions", "k", "m", "hi", 16, out[0..512]);
    assert n > 100;
    // the request line and the bearer head, byte for byte
    const pre : []const u8 = "POST /v1/chat/completions HTTP/1.1\r\nHost: integrate.api.nvidia.com\r\nAuthorization: Bearer k\r\n";
    var i : usize = 0;
    while (i < pre.len) {
        assert out[i] == pre[i];
        i = i + 1;
    }
    // the body's last byte is the closing brace of the JSON
    assert out[n - 1] == 125;
}

test "the_body_names_the_model_the_prompt_and_the_floor" {
    var b : [256]u8 = undefined;
    const n : usize = chat_body("m-1", "say \"hi\"", 16, b[0..256]);
    const want : []const u8 = "{\"model\":\"m-1\",\"messages\":[{\"role\":\"user\",\"content\":\"say \\\"hi\\\"\"}],\"stream\":false,\"max_tokens\":16}";
    assert n == want.len;
    var i : usize = 0;
    while (i < n) {
        assert b[i] == want[i];
        i = i + 1;
    }
}

test "the_content_comes_out_with_its_escapes_decoded" {
    var out : [128]u8 = undefined;
    const r : []const u8 = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"a\\\"b\\nc\"}}],\"usage\":{}}";
    const n : usize = reply_content(r, out[0..128]);
    assert n == 5;
    assert out[0] == 97 and out[1] == 34 and out[2] == 98 and out[3] == 10 and out[4] == 99;
    const none : []const u8 = "{\"error\":\"no content here\"}";
    assert reply_content(none, out[0..128]) == 0;
}
