// provider/schema.t27 — Provider Message Types
// AI provider message structures and model types
// φ² + 1/φ² = 3 | TRINITY

module provider-schema;

// ============================================================================
// Imports
// ============================================================================


// ============================================================================
// Constants
// ============================================================================

/// Anthropic API provider name
pub const PROVIDER_ANTHROPIC : []const u8 = "anthropic";

/// OpenAI API provider name
pub const PROVIDER_OPENAI : []const u8 = "openai";

/// Default provider
pub const PROVIDER_DEFAULT : []const u8 = PROVIDER_ANTHROPIC;

/// Default model for Anthropic
pub const MODEL_ANTHROPIC_DEFAULT : []const u8 = "claude-sonnet-4-20250514";

/// Default model for OpenAI
pub const MODEL_OPENAI_DEFAULT : []const u8 = "gpt-4";

/// Maximum tokens in request
pub const MAX_TOKENS : usize = 128000;

/// Default temperature
pub const DEFAULT_TEMPERATURE : f64 = 0.7;

/// Default max tokens
pub const DEFAULT_MAX_TOKENS : usize = 4096;

/// Default top p value
pub const DEFAULT_TOP_P : f64 = 1.0;

// ============================================================================
// Types
// ============================================================================

// Text fields are read-only views of bytes owned by the caller, so they are
// []const u8. A message or a response points into a slot the caller provides
// (there is no allocator), so no value ever points at a dead stack frame.

/// Provider type
pub const ProviderType = enum(u8) {
    anthropic = 0,
    openai = 1,
};

/// Message role
pub const MessageRole = enum(u8) {
    system = 0,
    user = 1,
    assistant = 2,
    tool = 3,
};

/// Message content type
pub const ContentType = enum(u8) {
    text = 0,
    image = 1,
    tool_use = 2,
    tool_result = 3,
};

/// Message content
pub const MessageContent = struct {
    type : ContentType,
    text : []const u8,
    image_url : []const u8,
    tool_call_id : []const u8,
    tool_result : []const u8,
};

/// Message
pub const Message = struct {
    role : MessageRole,
    content : []MessageContent,
};

/// Tool definition
pub const Tool = struct {
    name : []const u8,
    description : []const u8,
    input_schema : []const u8,
};

/// Tool call
pub const ToolCall = struct {
    id : []const u8,
    name : []const u8,
    arguments : []const u8,
};

/// Request parameters
pub const RequestParams = struct {
    model : []const u8,
    messages : []Message,
    max_tokens : usize,
    temperature : f64,
    top_p : f64,
    tools : []Tool,
};

/// Streaming chunk type (the error member is named err: error is a reserved word)
pub const ChunkType = enum(u8) {
    content = 0,
    tool_call = 1,
    done = 2,
    err = 3,
};

/// Token usage
pub const Usage = struct {
    prompt_tokens : usize,
    completion_tokens : usize,
    total_tokens : usize,
};

/// Streaming chunk
pub const StreamingChunk = struct {
    chunk_type : ChunkType,
    delta : []const u8,
    tool_calls : []ToolCall,
    finish_reason : []const u8,
    usage : Usage,
};

/// Choice
pub const Choice = struct {
    message : Message,
    finish_reason : []const u8,
};

/// Response
pub const Response = struct {
    id : []const u8,
    model : []const u8,
    choices : []Choice,
    usage : Usage,
    finish_reason : []const u8,
};

/// Stream response
pub const StreamResponse = struct {
    id : []const u8,
    model : []const u8,
    chunks : []StreamingChunk,
};

/// Provider configuration
pub const ProviderConfig = struct {
    provider_type : ProviderType,
    api_key : []const u8,
    base_url : []const u8,
    model : []const u8,
    timeout_ms : usize,
    max_retries : usize,
};

/// Provider capability
pub const ProviderCapability = enum(u8) {
    chat_completion = 0,
    streaming = 1,
    function_calling = 2,
    vision = 3,
};

/// Provider capabilities
pub const ProviderCapabilities = struct {
    chat_completion : bool,
    streaming : bool,
    function_calling : bool,
    vision : bool,
};

/// Error type
pub const ProviderError = struct {
    code : i32,
    message : []const u8,
    type : []const u8,
};

/// Image content
pub const ImageContent = struct {
    url : []const u8,
    detail : []const u8,
};

// ============================================================================
// Functions
// ============================================================================

/// Byte-wise equality of two strings
pub fn str_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) {
        return false;
    }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Create provider type from string
pub fn provider_type_from_string(s: []const u8) ProviderType {
    if (str_eq(s, PROVIDER_ANTHROPIC)) {
        return .anthropic;
    } else if (str_eq(s, PROVIDER_OPENAI)) {
        return .openai;
    } else {
        return .anthropic;
    }
}

/// Get provider type string
pub fn provider_type_to_string(pt: ProviderType) []const u8 {
    return switch (pt) {
        .anthropic => PROVIDER_ANTHROPIC,
        .openai => PROVIDER_OPENAI,
    };
}

/// Create message; its single content block is stored in slot[0]
pub fn message_create(role: MessageRole, text: []const u8, slot: []MessageContent) Message {
    slot[0] = MessageContent{
        .type = .text,
        .text = text,
        .image_url = "",
        .tool_call_id = "",
        .tool_result = "",
    };
    return Message{
        .role = role,
        .content = slot[0..1],
    };
}

/// Create system message
pub fn system_message_create(text: []const u8, slot: []MessageContent) Message {
    return message_create(.system, text, slot);
}

/// Create user message
pub fn user_message_create(text: []const u8, slot: []MessageContent) Message {
    return message_create(.user, text, slot);
}

/// Create tool definition
pub fn tool_create(name: []const u8, description: []const u8) Tool {
    return Tool{
        .name = name,
        .description = description,
        .input_schema = "",
    };
}

/// Create request params
pub fn request_params_create(model: []const u8, messages: []Message) RequestParams {
    return RequestParams{
        .model = model,
        .messages = messages,
        .max_tokens = DEFAULT_MAX_TOKENS,
        .temperature = DEFAULT_TEMPERATURE,
        .top_p = DEFAULT_TOP_P,
        .tools = &.{},
    };
}

/// Create provider config
pub fn provider_config_create(provider_type: ProviderType, api_key: []const u8) ProviderConfig {
    const base_url = if (provider_type == .anthropic) "https://api.anthropic.com" else "https://api.openai.com";
    const model = if (provider_type == .anthropic) MODEL_ANTHROPIC_DEFAULT else MODEL_OPENAI_DEFAULT;
    return ProviderConfig{
        .provider_type = provider_type,
        .api_key = api_key,
        .base_url = base_url,
        .model = model,
        .timeout_ms = 30000,
        .max_retries = 3,
    };
}

/// Create usage
pub fn usage_create(prompt: usize, completion: usize) Usage {
    return Usage{
        .prompt_tokens = prompt,
        .completion_tokens = completion,
        .total_tokens = prompt + completion,
    };
}

/// Create streaming chunk
pub fn streaming_chunk_create(chunk_type: ChunkType, delta: []const u8) StreamingChunk {
    return StreamingChunk{
        .chunk_type = chunk_type,
        .delta = delta,
        .tool_calls = &.{},
        .finish_reason = "",
        .usage = usage_create(0, 0),
    };
}

/// Create response; its single choice is stored in choice_slot[0]
pub fn response_create(id: []const u8, model: []const u8, message: Message, choice_slot: []Choice) Response {
    choice_slot[0] = Choice{
        .message = message,
        .finish_reason = "stop",
    };
    return Response{
        .id = id,
        .model = model,
        .choices = choice_slot[0..1],
        .usage = usage_create(0, 0),
        .finish_reason = "stop",
    };
}

/// Get role string
pub fn role_to_string(role: MessageRole) []const u8 {
    return switch (role) {
        .system => "system",
        .user => "user",
        .assistant => "assistant",
        .tool => "tool",
    };
}

/// Create provider error
pub fn provider_error_create(code: i32, message: []const u8) ProviderError {
    return ProviderError{
        .code = code,
        .message = message,
        .type = "ProviderError",
    };
}

/// Check if provider is Anthropic
pub fn is_anthropic_provider(pt: ProviderType) bool {
    return pt == .anthropic;
}

/// Check if provider is OpenAI
pub fn is_openai_provider(pt: ProviderType) bool {
    return pt == .openai;
}

/// Check if response has error
pub fn response_has_error(resp: Response) bool {
    return resp.choices.len == 0;
}

/// Check if chunk is done
pub fn chunk_is_done(chunk: StreamingChunk) bool {
    return chunk.chunk_type == .done;
}

/// Get chunk type string
pub fn chunk_type_to_string(ct: ChunkType) []const u8 {
    return switch (ct) {
        .content => "content",
        .tool_call => "tool_call",
        .done => "done",
        .err => "error",
    };
}

// ============================================================================
// TDD - Tests
// ============================================================================

test "provider_provider_type_from_string" {
    var pt = provider_type_from_string(PROVIDER_ANTHROPIC);
    assert(pt == .anthropic);
    assert(provider_type_from_string(PROVIDER_OPENAI) == .openai);
    assert(provider_type_from_string("unknown") == .anthropic);
}

test "provider_provider_type_to_string" {
    var str = provider_type_to_string(.openai);
    assert(str.len == 6);
    assert(str_eq(str, "openai"));
    assert(provider_type_to_string(.anthropic).len == 9);
}

test "provider_message_create" {
    var slot : [1]MessageContent = undefined;
    var msg = message_create(.user, "hello", &slot);
    assert(msg.role == .user);
    assert(msg.content.len == 1);
    assert(str_eq(msg.content[0].text, "hello"));
    var ct = msg.content[0].type;
    assert(ct == .text);
}

test "provider_system_message_create" {
    var slot : [1]MessageContent = undefined;
    var msg = system_message_create("system prompt", &slot);
    assert(msg.role == .system);
    assert(str_eq(msg.content[0].text, "system prompt"));
}

test "provider_user_message_create" {
    var slot : [1]MessageContent = undefined;
    var msg = user_message_create("user input", &slot);
    assert(msg.role == .user);
    assert(str_eq(msg.content[0].text, "user input"));
}

test "provider_tool_create" {
    var tool = tool_create("test", "test tool");
    assert(tool.name.len == 4);
    assert(str_eq(tool.description, "test tool"));
    assert(tool.input_schema.len == 0);
}

test "provider_request_params_create" {
    var params = request_params_create("model", &.{});
    assert(params.model.len == 5);
    assert(params.messages.len == 0);
    assert(params.max_tokens == DEFAULT_MAX_TOKENS);
    assert(params.tools.len == 0);
}

test "provider_provider_config_create" {
    var config = provider_config_create(.anthropic, "key");
    assert(config.provider_type == .anthropic);
    assert(str_eq(config.base_url, "https://api.anthropic.com"));
    assert(str_eq(config.model, MODEL_ANTHROPIC_DEFAULT));
    var openai = provider_config_create(.openai, "key");
    assert(str_eq(openai.base_url, "https://api.openai.com"));
    assert(str_eq(openai.model, MODEL_OPENAI_DEFAULT));
}

test "provider_usage_create" {
    var usage = usage_create(100, 50);
    assert(usage.total_tokens == 150);
    assert(usage.prompt_tokens == 100);
    assert(usage.completion_tokens == 50);
}

test "provider_streaming_chunk_create" {
    var chunk = streaming_chunk_create(.content, "delta");
    assert(chunk.chunk_type == .content);
    assert(str_eq(chunk.delta, "delta"));
    assert(chunk.tool_calls.len == 0);
}

test "provider_response_create" {
    var slot : [1]MessageContent = undefined;
    var choices : [1]Choice = undefined;
    var resp = response_create("id", "model", user_message_create("test", &slot), &choices);
    assert(resp.id.len == 2);
    assert(resp.choices.len == 1);
    assert(str_eq(resp.choices[0].message.content[0].text, "test"));
    assert(str_eq(resp.choices[0].finish_reason, "stop"));
}

test "provider_role_to_string" {
    var str = role_to_string(.assistant);
    assert(str.len == 9);
    assert(str_eq(str, "assistant"));
}

test "provider_provider_error_create" {
    var err = provider_error_create(-1, "error");
    assert(err.code == -1);
    assert(str_eq(err.message, "error"));
}

test "provider_is_anthropic_provider" {
    assert(is_anthropic_provider(.anthropic));
    assert(is_anthropic_provider(.openai) == false);
}

test "provider_is_openai_provider" {
    assert(is_openai_provider(.openai));
    assert(is_openai_provider(.anthropic) == false);
}

// response_create always stores exactly one choice, so a response built by it
// can never be an error response; the original test expected one to be. The
// error response here is one with no choices at all, which is what
// response_has_error looks for.
test "provider_response_has_error" {
    var slot : [1]MessageContent = undefined;
    var choices : [1]Choice = undefined;
    var ok_resp = response_create("", "", user_message_create("", &slot), &choices);
    assert(response_has_error(ok_resp) == false);
    var err_resp = Response{
        .id = "",
        .model = "",
        .choices = &.{},
        .usage = usage_create(0, 0),
        .finish_reason = "error",
    };
    assert(response_has_error(err_resp));
}

test "provider_chunk_is_done" {
    var chunk = streaming_chunk_create(.done, "");
    assert(chunk_is_done(chunk));
    assert(chunk_is_done(streaming_chunk_create(.content, "")) == false);
}

test "provider_chunk_type_to_string" {
    var str = chunk_type_to_string(.content);
    assert(str.len == 7);
    assert(str_eq(chunk_type_to_string(.err), "error"));
}

// ============================================================================
// TDD - Invariants
// ============================================================================

invariant provider_type_in_range {
    // ProviderType is in [0, 1]
    @intFromEnum(ProviderType.anthropic) == 0;
    @intFromEnum(ProviderType.openai) == 1;
}

invariant message_role_in_range {
    // MessageRole is in [0, 3]
    @intFromEnum(MessageRole.system) == 0;
    @intFromEnum(MessageRole.tool) == 3;
}

invariant content_type_in_range {
    // ContentType is in [0, 3]
    @intFromEnum(ContentType.text) == 0;
    @intFromEnum(ContentType.tool_result) == 3;
}

invariant max_tokens_positive {
    // MAX_TOKENS is positive
    MAX_TOKENS > 0;
}

invariant default_temperature_valid {
    // DEFAULT_TEMPERATURE is in [0, 2]
    DEFAULT_TEMPERATURE >= 0.0 and DEFAULT_TEMPERATURE <= 2.0;
}

invariant default_max_tokens_valid {
    // DEFAULT_MAX_TOKENS is positive and within MAX_TOKENS
    DEFAULT_MAX_TOKENS > 0;
    DEFAULT_MAX_TOKENS <= MAX_TOKENS;
}

invariant usage_totals_equal_parts {
    // Usage total equals prompt + completion
    usage_create(100, 50).total_tokens == 150;
}

invariant request_params_has_model {
    // RequestParams has non-empty model
    request_params_create("model", &.{}).model.len > 0;
}

invariant response_has_id_or_model {
    // Response has either id or model
    var slot : [1]MessageContent = undefined;
    var choices : [1]Choice = undefined;
    var resp = response_create("id", "model", user_message_create("x", &slot), &choices);
    resp.id.len > 0 or resp.model.len > 0;
}

invariant chunk_type_in_range {
    // ChunkType is in [0, 3]
    @intFromEnum(ChunkType.content) == 0;
    @intFromEnum(ChunkType.err) == 3;
}

invariant tool_has_name {
    // Tool has non-empty name
    tool_create("name", "description").name.len > 0;
}

invariant provider_config_has_api_key {
    // ProviderConfig has non-empty api_key
    provider_config_create(.openai, "key").api_key.len > 0;
}

invariant provider_error_has_code {
    // ProviderError has valid error code
    provider_error_create(-1, "e").code != 0;
}

invariant message_has_role {
    // Message has valid role
    var slot : [1]MessageContent = undefined;
    message_create(.user, "x", &slot).role == .user;
}

// ============================================================================
// TDD - Benchmarks
// ============================================================================

bench "provider_message_create_latency" {
    // Measure: cycles for message creation
    // Target: < 100 cycles
    @setEvalBranchQuota(10000);
    var slot : [1]MessageContent = undefined;
    var result : Message = undefined;
    for (0..1000) |_| {
        result = message_create(.user, "test", &slot);
    }
    _ = result;
}

bench "provider_request_params_create_latency" {
    // Measure: cycles for request params creation
    // Target: < 200 cycles
    @setEvalBranchQuota(10000);
    var result : RequestParams = undefined;
    for (0..1000) |_| {
        result = request_params_create("model", &.{});
    }
    _ = result;
}

bench "provider_provider_config_create_latency" {
    // Measure: cycles for provider config creation
    // Target: < 150 cycles
    @setEvalBranchQuota(10000);
    var result : ProviderConfig = undefined;
    for (0..1000) |_| {
        result = provider_config_create(.anthropic, "api-key");
    }
    _ = result;
}

bench "provider_streaming_chunk_create_latency" {
    // Measure: cycles for streaming chunk creation
    // Target: < 100 cycles
    @setEvalBranchQuota(10000);
    var result : StreamingChunk = undefined;
    for (0..1000) |_| {
        result = streaming_chunk_create(.content, "delta");
    }
    _ = result;
}

bench "provider_response_create_latency" {
    // Measure: cycles for response creation
    // Target: < 200 cycles
    @setEvalBranchQuota(10000);
    var slot : [1]MessageContent = undefined;
    var choices : [1]Choice = undefined;
    var result : Response = undefined;
    for (0..1000) |_| {
        result = response_create("id", "model", user_message_create("test", &slot), &choices);
    }
    _ = result;
}

bench "provider_role_to_string_latency" {
    // Measure: cycles for role to string conversion
    // Target: < 20 cycles
    @setEvalBranchQuota(10000);
    var result : []const u8 = undefined;
    for (0..1000) |_| {
        result = role_to_string(.assistant);
    }
    _ = result;
}
