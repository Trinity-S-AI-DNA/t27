module diagnostics-t27-enforcement-verify;

use std::process;
use std::env;
use std::fs;

// ============================================================================
// SKILL CONTRACT
// ============================================================================

/// SKILL NAME: t27-diagnostic-t27-enforcement-verify
/// PURPOSE: Verify T27-First Enforcement implementation completeness
/// INPUTS: target_directory (string), enforcement_mode (string: BLOCK_NEW|AUDIT_ONLY)
/// OUTPUT: t27-enforcement-verification-report.t27-evidence
/// EXIT: 0=pass, 1=fail, 2=errors
/// SIDE_EFFECTS: none
/// LANGUAGE: .t27 only
/// STORAGE: specs/diagnostics/

// ============================================================================
// SACRED CONSTANTS
// ============================================================================

/// Required configuration file
pub const ENFORCEMENT_CONFIG_FILE : string = ".t27-enforcement-config.yaml";

/// Required TypeScript controller
pub const ENFORCEMENT_TS_FILE : string = ".t27-enforcement-mode.ts";

/// Required CI configuration
pub const CI_CONFIG_FILE : string = ".gitlab-ci.yml";

/// Required migration task
pub const MIGRATION_TASK_FILE : string = "specs/automation/t27-first-migration-agent-runner.t27";

/// Required documentation
pub const DOCUMENTATION_FILE : string = "T27-FIRST-ENFORCEMENT-DEPLOYMENT.md";

/// Required baseline inventory
pub const BASELINE_INVENTORY_FILE : string = "specs/architecture/misplaced-logic-inventory.t27";

/// Required enforcement mode
pub const REQUIRED_ENFORCEMENT_MODE : string = "BLOCK_NEW";

/// Required baseline violations count
pub const REQUIRED_VIOLATIONS_COUNT : u32 = 198;

/// Required configuration values
pub const REQUIRED_CONFIG_VALUES : string[] = [
    "enforcement_mode.*BLOCK_NEW",
    "baselineSuppression.*true"
];

// ============================================================================
// VERIFICATION STATE
// ============================================================================

/// Component check result
pub struct ComponentResult {
    /// Component name
    pub name : string,
    /// Pass/fail status
    pub passed : bool,
    /// Error message (if any)
    pub error : string,
    /// Details found
    pub details : string
}

/// Verification result
pub struct VerificationResult {
    /// Target directory
    pub target_directory : string,
    /// Enforcement mode
    pub enforcement_mode : string,
    /// Total components checked
    pub total_components : u32,
    /// Passed components
    pub passed_components : u32,
    /// Failed components
    pub failed_components : u32,
    /// Component results
    pub component_results : ComponentResult[],
    /// Evidence artifacts
    pub evidence_artifacts : string[],
    /// Exit code
    pub exit_code : u32
}

/// Initialize verification result
pub fn verification_result_init(target_dir : string, enforcement_mode : string) -> VerificationResult {
    return VerificationResult{
        .target_directory = target_dir,
        .enforcement_mode = enforcement_mode,
        .total_components = 0,
        .passed_components = 0,
        .failed_components = 0,
        .component_results = [],
        .evidence_artifacts = [],
        .exit_code = 0
    };
}

// ============================================================================
// COMPONENT CHECKING FUNCTIONS
// ============================================================================

/// Check if file exists and contains required patterns
pub fn check_file_with_patterns(file_path : string, patterns : string[], description : string) -> ComponentResult {
    let result = ComponentResult{
        .name = description,
        .passed = false,
        .error = "",
        .details = ""
    };
    
    if (!fs::exists(file_path)) {
        result.error = file_path + " not found";
        return result;
    }
    
    const content = fs::read_to_string(file_path);
    let all_patterns_found = true;
    let found_details = [];
    
    for pattern in patterns {
        if (content.contains(pattern)) {
            found_details.append(pattern);
        } else {
            all_patterns_found = false;
        }
    }
    
    result.passed = all_patterns_found;
    result.details = found_details.join(", ");
    
    if (!result.passed) {
        result.error = "Not all required patterns found in " + file_path;
    }
    
    result.evidence_artifacts.append("FILE_CHECK:" + file_path + ":" + result.passed.to_string());
    
    return result;
}

/// Check configuration file
pub fn check_enforcement_config(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    const config_result = check_file_with_patterns(
        new_result.target_directory + "/" + ENFORCEMENT_CONFIG_FILE,
        ["enforcement_mode.*" + REQUIRED_ENFORCEMENT_MODE, "baselineSuppression.*true"],
        "Enforcement configuration"
    );
    
    new_result.total_components += 1;
    if (config_result.passed) {
        new_result.passed_components += 1;
    } else {
        new_result.failed_components += 1;
    }
    
    new_result.component_results.append(config_result);
    new_result.evidence_artifacts.append("CONFIG_CHECK:" + config_result.passed.to_string());
    
    return new_result;
}

/// Check TypeScript controller
pub fn check_ts_controller(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    const ts_result = check_file_with_patterns(
        new_result.target_directory + "/" + ENFORCEMENT_TS_FILE,
        ["BLOCK_NEW", "baselineSuppression"],
        "TypeScript controller"
    );
    
    new_result.total_components += 1;
    if (ts_result.passed) {
        new_result.passed_components += 1;
    } else {
        new_result.failed_components += 1;
    }
    
    new_result.component_results.append(ts_result);
    new_result.evidence_artifacts.append("TS_CONTROLLER_CHECK:" + ts_result.passed.to_string());
    
    return new_result;
}

/// Check CI configuration
pub fn check_ci_config(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    const ci_result = check_file_with_patterns(
        new_result.target_directory + "/" + CI_CONFIG_FILE,
        ["VIOLATION_THRESHOLD.*\"0\"", "baseline_suppression.*true"],
        "CI configuration"
    );
    
    new_result.total_components += 1;
    if (ci_result.passed) {
        new_result.passed_components += 1;
    } else {
        new_result.failed_components += 1;
    }
    
    new_result.component_results.append(ci_result);
    new_result.evidence_artifacts.append("CI_CONFIG_CHECK:" + ci_result.passed.to_string());
    
    return new_result;
}

/// Check migration task
pub fn check_migration_task(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    const migration_result = check_file_with_patterns(
        new_result.target_directory + "/" + MIGRATION_TASK_FILE,
        ["acceptance_criteria.*6", "keep_in_python.*5", "AGENT_RUNNER_MIGRATION"],
        "Migration task specification"
    );
    
    new_result.total_components += 1;
    if (migration_result.passed) {
        new_result.passed_components += 1;
    } else {
        new_result.failed_components += 1;
    }
    
    new_result.component_results.append(migration_result);
    new_result.evidence_artifacts.append("MIGRATION_TASK_CHECK:" + migration_result.passed.to_string());
    
    return new_result;
}

/// Check documentation
pub fn check_documentation(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    const doc_result = check_file_with_patterns(
        new_result.target_directory + "/" + DOCUMENTATION_FILE,
        ["ENFORCEMENT_IMPLEMENTED_AUDIT_MODE"],
        "Deployment documentation"
    );
    
    new_result.total_components += 1;
    if (doc_result.passed) {
        new_result.passed_components += 1;
    } else {
        new_result.failed_components += 1;
    }
    
    new_result.component_results.append(doc_result);
    new_result.evidence_artifacts.append("DOCUMENTATION_CHECK:" + doc_result.passed.to_string());
    
    return new_result;
}

/// Check baseline inventory
pub fn check_baseline_inventory(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    const baseline_result = check_file_with_patterns(
        new_result.target_directory + "/" + BASELINE_INVENTORY_FILE,
        ["VIOLATIONS.*" + REQUIRED_VIOLATIONS_COUNT.to_string()],
        "Baseline inventory"
    );
    
    new_result.total_components += 1;
    if (baseline_result.passed) {
        new_result.passed_components += 1;
    } else {
        new_result.failed_components += 1;
    }
    
    new_result.component_results.append(baseline_result);
    new_result.evidence_artifacts.append("BASELINE_INVENTORY_CHECK:" + baseline_result.passed.to_string());
    
    return new_result;
}

// ============================================================================
// MAIN VERIFICATION FLOW
// ============================================================================

/// Run complete T27 enforcement verification
pub fn run_enforcement_verification(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    println!("🔍 T27-First Enforcement Verification");
    println!("======================================");
    println!("Enforcement mode: {}", new_result.enforcement_mode);
    println!("Target directory: {}", new_result.target_directory);
    println!("");
    
    // Check configuration file
    println!("📋 Checking configuration files...");
    new_result = check_enforcement_config(new_result);
    
    // Check TypeScript controller
    println!("📋 Checking TypeScript controller...");
    new_result = check_ts_controller(new_result);
    
    // Check CI configuration
    println!("📋 Checking CI configuration...");
    new_result = check_ci_config(new_result);
    
    // Check migration task
    println!("📋 Checking migration task...");
    new_result = check_migration_task(new_result);
    
    // Check documentation
    println!("📋 Checking documentation...");
    new_result = check_documentation(new_result);
    
    // Check baseline inventory
    println!("📋 Checking baseline inventory...");
    new_result = check_baseline_inventory(new_result);
    
    // Print verification summary
    println!("");
    println!("======================================");
    println!("📋 T27-First Enforcement Verification Summary");
    println!("======================================");
    println!("Total components checked: {}", new_result.total_components);
    println!("Passed: {}", new_result.passed_components);
    println!("Failed: {}", new_result.failed_components);
    println!("");
    
    if (new_result.failed_components == 0) {
        println!("✅ All components verified successfully");
        println!("");
        println("📋 Configuration details:");
        println("   - Mode: {} with baseline suppression", REQUIRED_ENFORCEMENT_MODE);
        println("   - CI Gate: New violations blocked, existing violations allowed");
        println("   - Migration: Agent runner workflow defined");
        println("   - Status: ENFORCEMENT_IMPLEMENTED_AUDIT_MODE (not production-ready)");
        println("   - Baseline: {} violations properly configured", REQUIRED_VIOLATIONS_COUNT);
        println!("");
        println("🚀 Ready for next phase: Agent-runner migration implementation");
    } else {
        println!("❌ {} components failed verification", new_result.failed_components);
        println!("");
        println("Please review failed components above");
    }
    
    // Set exit code
    new_result.exit_code = if new_result.failed_components > 0 1 else 0;
    
    return new_result;
}

// ============================================================================
// EVIDENCE GENERATION
// ============================================================================

/// Generate structured evidence file
pub fn generate_evidence_file(result : VerificationResult, target_dir : string) -> string {
    const timestamp = env::get_timestamp();
    const evidence_filename = "t27-enforcement-verification-report-" + timestamp + ".t27-evidence";
    const evidence_path = target_dir + "/.trinity/evidence/" + evidence_filename;
    
    let content = "# T27 Enforcement Verification Evidence\n" +
                   "# Generated by t27-diagnostic-t27-enforcement-verify\n" +
                   "# Timestamp: " + timestamp + "\n" +
                   "\n" +
                   "## Summary\n" +
                   "- Target directory: {}\n".format(result.target_directory) +
                   "- Enforcement mode: {}\n".format(result.enforcement_mode) +
                   "- Total components: {}\n".format(result.total_components) +
                   "- Passed: {}\n".format(result.passed_components) +
                   "- Failed: {}\n".format(result.failed_components) +
                   "- Exit code: {}\n".format(result.exit_code) +
                   "\n" +
                   "## Component Results\n" +
                   "\n";
    
    for component in result.component_results {
        content += "### {}\n".format(component.name);
        content += "- Status: {}\n".format(if component.passed "PASS" else "FAIL");
        if (component.error.length > 0) {
            content += "- Error: {}\n".format(component.error);
        }
        if (component.details.length > 0) {
            content += "- Details: {}\n".format(component.details);
        }
        content += "\n";
    }
    
    content += "## Evidence Entries\n";
    for entry in result.evidence_artifacts {
        content += "- {}\n".format(entry);
    }
    
    fs::write(evidence_path, content);
    
    return evidence_path;
}

// ============================================================================
// TDD: TESTS
// ============================================================================

test "verification_result_init_default_values" {
    const result = verification_result_init(".", "BLOCK_NEW");
    assert result.target_directory == ".";
    assert result.enforcement_mode == "BLOCK_NEW";
    assert result.total_components == 0;
    assert result.passed_components == 0;
    assert result.failed_components == 0;
    assert result.component_results.length == 0;
    assert result.evidence_artifacts.length == 0;
    assert result.exit_code == 0;
}

test "check_file_with_patterns_logic" {
    // This test would require actual file creation
    // Test the logic structure
    const result = check_file_with_patterns("/tmp/test.txt", ["pattern1", "pattern2"], "Test file");
    // In real test, would create file with patterns and check behavior
}

// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant "component_counts_consistency" {
    const result = verification_result_init(".", "BLOCK_NEW");
    assert result.passed_components + result.failed_components == result.total_components;
}

invariant "exit_code_is_valid" {
    const result = verification_result_init(".", "BLOCK_NEW");
    assert result.exit_code == 0 || result.exit_code == 1 || result.exit_code == 2;
}

// ============================================================================
// SKILL EXECUTION ENTRY POINT
// ============================================================================

/// Main skill execution function
pub fn main() {
    const args = env::get_argv();
    let target_dir = ".";
    let enforcement_mode = "BLOCK_NEW";
    
    // Parse arguments
    for i in 0..(args.length - 1) {
        if (args[i] == "--target-dir") {
            target_dir = args[i + 1];
        } else if (args[i] == "--enforcement-mode") {
            enforcement_mode = args[i + 1];
        }
    }
    
    println!("Running T27 Enforcement Verification Skill");
    println!("Target directory: {}", target_dir);
    println!("Enforcement mode: {}", enforcement_mode);
    
    const result = verification_result_init(target_dir, enforcement_mode);
    const verification_result = run_enforcement_verification(result);
    
    // Generate evidence file
    const evidence_file = generate_evidence_file(verification_result, target_dir);
    println!("");
    println!("Evidence artifact created: {}", evidence_file);
    
    process::exit(verification_result.exit_code);
}