// φ² + 1/φ² = 3 | TRINITY

module diagnostics-provider-guard-integration-verify;

use std::process;
use std::env;
use std::fs;

// ============================================================================
// SKILL CONTRACT
// ============================================================================

/// SKILL NAME: t27-diagnostic-provider-guard-integration-verify
/// PURPOSE: Verify ProviderInvariantGuard integration completeness and alignment
/// INPUTS: target_directory (string), implementation_file (string), spec_file (string)
/// OUTPUT: provider-guard-integration-verification-report.t27-evidence
/// EXIT: 0=pass, 1=fail, 2=errors
/// SIDE_EFFECTS: none
/// LANGUAGE: .t27 only
/// STORAGE: specs/diagnostics/

// ============================================================================
// SACRED CONSTANTS
// ============================================================================

/// Default implementation file path
pub const DEFAULT_IMPLEMENTATION_FILE : string = "contrib/backend/agent-runner/src/api.rs";

/// Default spec file path
pub const DEFAULT_SPEC_FILE : string = "specs/system/llm_request_provider_gate.t27";

/// Required functions
pub const REQUIRED_FUNCTIONS : string[] = [
    "pub fn preflight",
    "fn resolve_provider",
    "fn model_allowed_on_provider", 
    "fn reject_request"
];

/// Required error codes
pub const REQUIRED_ERROR_CODES : string[] = [
    "ROUTING_MISMATCH",
    "MODEL_NOT_ALLOWED",
    "CREDENTIALS_MISSING",
    "PROVIDER_UNFUNDED"
];

/// Required test patterns
pub const REQUIRED_TEST_PATTERNS : string[] = [
    "unfunded_provider_is_rejected_before_network_io",
    "funded_provider_passes_preflight",
    "transient_stream_retry_is_bounded"
];

/// Required policy enforcements
pub const REQUIRED_POLICY_ENFORCEMENTS : string[] = [
    "network_io=deny",
    "retry=deny",
    "checkpoint=preserved",
    "follow_up_task=create"
];

// ============================================================================
// VERIFICATION STATE
// ============================================================================

/// Function check result
pub struct FunctionResult {
    /// Function name
    pub name : string,
    /// Pass/fail status
    pub passed : bool,
    /// Error message (if any)
    pub error : string
}

/// Policy check result
pub struct PolicyResult {
    /// Policy name
    pub name : string,
    /// Pass/fail status
    pub passed : bool,
    /// Error message (if any)
    pub error : string
}

/// Verification result
pub struct VerificationResult {
    /// Target directory
    pub target_directory : string,
    /// Implementation file
    pub implementation_file : string,
    /// Spec file
    pub spec_file : string,
    /// Total functions checked
    pub total_functions : u32,
    /// Passed functions
    pub passed_functions : u32,
    /// Failed functions
    pub failed_functions : u32,
    /// Total policies checked
    pub total_policies : u32,
    /// Passed policies
    pub passed_policies : u32,
    /// Failed policies
    pub failed_policies : u32,
    /// Function results
    pub function_results : FunctionResult[],
    /// Policy results
    pub policy_results : PolicyResult[],
    /// Test count
    pub test_count : u32,
    /// Evidence artifacts
    pub evidence_artifacts : string[],
    /// Exit code
    pub exit_code : u32
}

/// Initialize verification result
pub fn verification_result_init(target_dir : string, impl_file : string, spec_file : string) -> VerificationResult {
    return VerificationResult{
        .target_directory = target_dir,
        .implementation_file = impl_file,
        .spec_file = spec_file,
        .total_functions = 0,
        .passed_functions = 0,
        .failed_functions = 0,
        .total_policies = 0,
        .passed_policies = 0,
        .failed_policies = 0,
        .function_results = [],
        .policy_results = [],
        .test_count = 0,
        .evidence_artifacts = [],
        .exit_code = 0
    };
}

// ============================================================================
// VERIFICATION FUNCTIONS
// ============================================================================

/// Check if implementation file exists
pub fn check_implementation_file(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    if (fs::exists(new_result.implementation_file)) {
        println!("✅ Implementation file found: {}", new_result.implementation_file);
        new_result.evidence_artifacts.append("IMPLEMENTATION_FILE:FOUND");
    } else {
        println!("❌ Implementation file not found: {}", new_result.implementation_file);
        new_result.evidence_artifacts.append("IMPLEMENTATION_FILE:MISSING");
        new_result.exit_code = 1;
    }
    
    return new_result;
}

/// Check if spec file exists
pub fn check_spec_file(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    if (fs::exists(new_result.spec_file)) {
        println!("✅ Spec file found: {}", new_result.spec_file);
        new_result.evidence_artifacts.append("SPEC_FILE:FOUND");
    } else {
        println!("❌ Spec file not found: {}", new_result.spec_file);
        new_result.evidence_artifacts.append("SPEC_FILE:MISSING");
        new_result.exit_code = 1;
    }
    
    return new_result;
}

/// Check for required functions
pub fn check_required_functions(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    println!("=== Checking Critical Functions ===");
    println!("");
    
    for func in REQUIRED_FUNCTIONS {
        const func_result = check_file_contains(new_result.implementation_file, func, func);
        
        new_result.total_functions += 1;
        if (func_result.passed) {
            new_result.passed_functions += 1;
            println!("✅ {} exists", func);
        } else {
            new_result.failed_functions += 1;
            println!("❌ {} missing", func);
        }
        
        new_result.function_results.append(FunctionResult{
            .name = func,
            .passed = func_result.passed,
            .error = func_result.error
        });
        
        new_result.evidence_artifacts.append("FUNCTION:" + func + ":" + func_result.passed.to_string());
    }
    
    return new_result;
}

/// Check for required error codes
pub fn check_error_codes(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    println!("");
    println!("=== Checking Error Codes ===");
    println!("");
    
    for code in REQUIRED_ERROR_CODES {
        const error_code = "ERR_" + code;
        const code_result = check_file_contains(new_result.implementation_file, error_code, error_code);
        
        if (code_result.passed) {
            println!("✅ Error code {} defined", code);
        } else {
            println!("❌ Error code {} missing", code);
        }
        
        new_result.evidence_artifacts.append("ERROR_CODE:" + code + ":" + code_result.passed.to_string());
    }
    
    return new_result;
}

/// Check for test coverage
pub fn check_test_coverage(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    println!("");
    println!("=== Checking Test Coverage ===");
    println!("");
    
    for pattern in REQUIRED_TEST_PATTERNS {
        const test_result = check_file_contains(new_result.implementation_file, pattern, pattern);
        
        if (test_result.passed) {
            println!("✅ {} test exists", pattern);
        } else {
            println!("❌ {} test missing", pattern);
        }
        
        new_result.evidence_artifacts.append("TEST_PATTERN:" + pattern + ":" + test_result.passed.to_string());
    }
    
    // Count total test functions
    const implementation_content = fs::read_to_string(new_result.implementation_file);
    const test_count = count_substrings(implementation_content, "#\[tokio::test\]");
    new_result.test_count = test_count;
    println!("📊 Total test functions found: {}", test_count);
    new_result.evidence_artifacts.append("TEST_COUNT:" + test_count.to_string());
    
    return new_result;
}

/// Check policy enforcement
pub fn check_policy_enforcement(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    println!("");
    println!("=== Checking Policy Enforcement ===");
    println!("");
    
    for policy in REQUIRED_POLICY_ENFORCEMENTS {
        const policy_result = check_file_contains(new_result.implementation_file, policy, policy);
        
        new_result.total_policies += 1;
        if (policy_result.passed) {
            new_result.passed_policies += 1;
            println!("✅ {} policy enforced", policy);
        } else {
            new_result.failed_policies += 1;
            println!("❌ {} policy missing", policy);
        }
        
        new_result.policy_results.append(PolicyResult{
            .name = policy,
            .passed = policy_result.passed,
            .error = policy_result.error
        });
        
        new_result.evidence_artifacts.append("POLICY:" + policy + ":" + policy_result.passed.to_string());
    }
    
    return new_result;
}

/// Check spec alignment
pub fn check_spec_alignment(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    println!("");
    println!("=== Checking Spec Alignment ===");
    println!("");
    
    // Check if both files exist
    if (!fs::exists(new_result.implementation_file) || !fs::exists(new_result.spec_file)) {
        println!("❌ One or both files missing for alignment check");
        return new_result;
    }
    
    const impl_content = fs::read_to_string(new_result.implementation_file);
    const spec_content = fs::read_to_string(new_result.spec_file);
    
    // Check preflight alignment
    const preflight_impl = impl_content.contains("preflight");
    const preflight_spec = spec_content.contains("preflight");
    if (preflight_impl && preflight_spec) {
        println!("✅ Preflight function exists in both");
        new_result.evidence_artifacts.append("ALIGNMENT_PREFLIGHT:YES");
    } else {
        println!("❌ Preflight function mismatch");
        new_result.evidence_artifacts.append("ALIGNMENT_PREFLIGHT:NO");
    }
    
    // Check error codes alignment
    const error_alignment = REQUIRED_ERROR_CODES.map(|code| 
        spec_content.contains(code) && impl_content.contains(code)
    ).reduce(|a, b| a && b, true);
    
    if (error_alignment) {
        println!("✅ Error codes aligned");
        new_result.evidence_artifacts.append("ALIGNMENT_ERROR_CODES:YES");
    } else {
        println!("❌ Error codes misaligned");
        new_result.evidence_artifacts.append("ALIGNMENT_ERROR_CODES:NO");
    }
    
    // Check network policy alignment
    const network_policy_impl = impl_content.contains("network_io=deny");
    const network_policy_spec = spec_content.contains("network_io.*deny");
    if (network_policy_impl && network_policy_spec) {
        println!("✅ Network policy aligned");
        new_result.evidence_artifacts.append("ALIGNMENT_NETWORK_POLICY:YES");
    } else {
        println!("❌ Network policy misaligned");
        new_result.evidence_artifacts.append("ALIGNMENT_NETWORK_POLICY:NO");
    }
    
    return new_result;
}

/// Helper function to check file contains text
pub fn check_file_contains(file_path : string, search_text : string, description : string) -> FunctionResult {
    let result = FunctionResult{
        .name = description,
        .passed = false,
        .error = ""
    };
    
    if (!fs::exists(file_path)) {
        result.error = file_path + " not found";
        return result;
    }
    
    const content = fs::read_to_string(file_path);
    if (content.contains(search_text)) {
        result.passed = true;
    } else {
        result.error = search_text + " not found in " + file_path;
    }
    
    return result;
}

/// Helper function to count substring occurrences
pub fn count_substrings(text : string, pattern : string) -> u32 {
    let count = 0;
    let start = 0;
    
    while (true) {
        const pos = text.find(pattern, start);
        if (pos == -1) break;
        count += 1;
        start = pos + pattern.length;
    }
    
    return count;
}

// ============================================================================
// MAIN VERIFICATION FLOW
// ============================================================================

/// Run complete integration verification
pub fn run_integration_verification(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    println!("=== ProviderInvariantGuard Integration Verification ===");
    println!("Date: {}", env::get_timestamp());
    println!("");
    
    // Check files exist
    new_result = check_implementation_file(new_result);
    new_result = check_spec_file(new_result);
    
    if (new_result.exit_code != 0) {
        return new_result; // Exit early if files missing
    }
    
    // Check functions
    new_result = check_required_functions(new_result);
    
    // Check error codes
    new_result = check_error_codes(new_result);
    
    // Check test coverage
    new_result = check_test_coverage(new_result);
    
    // Check policy enforcement
    new_result = check_policy_enforcement(new_result);
    
    // Check spec alignment
    new_result = check_spec_alignment(new_result);
    
    // Print final summary
    println!("");
    println!("=== Integration Verification Complete ===");
    if (new_result.failed_functions == 0 && new_result.failed_policies == 0) {
        println!("✅ ProviderInvariantGuard integration appears to be properly implemented");
        println!("   with comprehensive test coverage and policy enforcement.");
    } else {
        println!("❌ {} functions or {} policies failed verification", 
                 new_result.failed_functions, new_result.failed_policies);
    }
    println!("");
    
    // Set exit code
    new_result.exit_code = if (new_result.failed_functions > 0 || new_result.failed_policies > 0) 1 else 0;
    
    return new_result;
}

// ============================================================================
// EVIDENCE GENERATION
// ============================================================================

/// Generate structured evidence file
pub fn generate_evidence_file(result : VerificationResult, target_dir : string) -> string {
    const timestamp = env::get_timestamp();
    const evidence_filename = "provider-guard-integration-verification-report-" + timestamp + ".t27-evidence";
    const evidence_path = target_dir + "/.trinity/evidence/" + evidence_filename;
    
    let content = "# Provider Guard Integration Verification Evidence\n" +
                   "# Generated by t27-diagnostic-provider-guard-integration-verify\n" +
                   "# Timestamp: " + timestamp + "\n" +
                   "\n" +
                   "## Summary\n" +
                   "- Target directory: {}\n".format(result.target_directory) +
                   "- Implementation: {}\n".format(result.implementation_file) +
                   "- Spec: {}\n".format(result.spec_file) +
                   "- Total functions: {}\n".format(result.total_functions) +
                   "- Passed functions: {}\n".format(result.passed_functions) +
                   "- Failed functions: {}\n".format(result.failed_functions) +
                   "- Total policies: {}\n".format(result.total_policies) +
                   "- Passed policies: {}\n".format(result.passed_policies) +
                   "- Failed policies: {}\n".format(result.failed_policies) +
                   "- Test count: {}\n".format(result.test_count) +
                   "- Exit code: {}\n".format(result.exit_code) +
                   "\n" +
                   "## Function Results\n" +
                   "\n";
    
    for func in result.function_results {
        content += "### {}\n".format(func.name);
        content += "- Status: {}\n".format(if func.passed "PASS" else "FAIL");
        if (func.error.length > 0) {
            content += "- Error: {}\n".format(func.error);
        }
        content += "\n";
    }
    
    content += "## Policy Results\n" +
               "\n";
    
    for policy in result.policy_results {
        content += "### {}\n".format(policy.name);
        content += "- Status: {}\n".format(if policy.passed "PASS" else "FAIL");
        if (policy.error.length > 0) {
            content += "- Error: {}\n".format(policy.error);
        }
        content += "\n";
    }
    
    content += "## Evidence Entries\n";
    for entry in result.evidence_artifacts {
        content += "- {}\n".format(entry);
    }
    
    fs::write(evidence_path, content);
    
    return evidence_path;
}

// ============================================================================
// TDD: TESTS
// ============================================================================

test "verification_result_init_default_values" {
    const result = verification_result_init(".", "api.rs", "spec.t27");
    assert result.target_directory == ".";
    assert result.implementation_file == "api.rs";
    assert result.spec_file == "spec.t27";
    assert result.total_functions == 0;
    assert result.passed_functions == 0;
    assert result.failed_functions == 0;
    assert result.total_policies == 0;
    assert result.passed_policies == 0;
    assert result.failed_policies == 0;
    assert result.test_count == 0;
    assert result.function_results.length == 0;
    assert result.policy_results.length == 0;
    assert result.evidence_artifacts.length == 0;
    assert result.exit_code == 0;
}

// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant "function_counts_consistency" {
    const result = verification_result_init(".", "api.rs", "spec.t27");
    assert result.passed_functions + result.failed_functions == result.total_functions;
}

invariant "policy_counts_consistency" {
    const result = verification_result_init(".", "api.rs", "spec.t27");
    assert result.passed_policies + result.failed_policies == result.total_policies;
}

invariant "exit_code_is_valid" {
    const result = verification_result_init(".", "api.rs", "spec.t27");
    assert result.exit_code == 0 || result.exit_code == 1 || result.exit_code == 2;
}

// ============================================================================
// SKILL EXECUTION ENTRY POINT
// ============================================================================

/// Main skill execution function
pub fn main() {
    const args = env::get_argv();
    let target_dir = ".";
    let impl_file = DEFAULT_IMPLEMENTATION_FILE;
    let spec_file = DEFAULT_SPEC_FILE;
    
    // Parse arguments
    for i in 0..(args.length - 1) {
        if (args[i] == "--target-dir") {
            target_dir = args[i + 1];
        } else if (args[i] == "--implementation-file") {
            impl_file = args[i + 1];
        } else if (args[i] == "--spec-file") {
            spec_file = args[i + 1];
        }
    }
    
    println!("Running Provider Guard Integration Verification Skill");
    println!("Target directory: {}", target_dir);
    println!("Implementation file: {}", impl_file);
    println!("Spec file: {}", spec_file);
    
    const result = verification_result_init(target_dir, impl_file, spec_file);
    const verification_result = run_integration_verification(result);
    
    // Generate evidence file
    const evidence_file = generate_evidence_file(verification_result, target_dir);
    println!("");
    println!("Evidence artifact created: {}", evidence_file);
    
    process::exit(verification_result.exit_code);
}