module diagnostics-provider-guard-verify;

use std::process;
use std::env;
use std::fs;

// ============================================================================
// SKILL CONTRACT
// ============================================================================

/// SKILL NAME: t27-diagnostic-provider-guard-verify
/// PURPOSE: Comprehensive verification of provider guard implementation requirements
/// INPUTS: verification_mode (string: full|ci|quick), project_root (string)
/// OUTPUT: provider-guard-verification-report.t27-evidence
/// EXIT: 0=pass, 1=fail, 2=errors
/// SIDE_EFFECTS: none
/// LANGUAGE: .t27 only
/// STORAGE: specs/diagnostics/

// ============================================================================
// SACRED CONSTANTS
// ============================================================================

/// Verification modes
pub const MODE_QUICK : string = "quick";
pub const MODE_CI : string = "ci"; 
pub const MODE_FULL : string = "full";

/// Default project root
pub const DEFAULT_PROJECT_ROOT : string = ".";

/// Required spec file path
pub const SPEC_FILE_PATH : string = "specs/system/llm_request_provider_gate.t27";

/// Required API implementation path
pub const API_IMPLEMENTATION_PATH : string = "contrib/backend/agent-runner/src/api.rs";

/// Required configuration path
pub const CONFIG_IMPLEMENTATION_PATH : string = "contrib/backend/agent-runner/src/config.rs";

/// Required error constant
pub const REQUIRED_ERROR_CONSTANT : string = "ERR_PROVIDER_UNFUNDED";

/// Required function name
pub const REQUIRED_FUNCTION : string = "fn preflight";

/// Required invariants
pub const REQUIRED_INVARIANTS : string[] = [
    "every_violation_denies_network_io",
    "every_violation_denies_retry", 
    "every_violation_creates_a_follow_up_task"
];

/// Required verdicts
pub const REQUIRED_VERDICTS : string[] = [
    "VERDICT_ROUTING_MISMATCH",
    "VERDICT_PROVIDER_UNFUNDED",
    "VERDICT_CREDENTIALS_MISSING",
    "VERDICT_MODEL_NOT_ALLOWED"
];

/// Required fallback configuration
pub const REQUIRED_FALLBACK : string = "approved_fallback";

// ============================================================================
// VERIFICATION STATE
// ============================================================================

/// Test result
pub struct TestResult {
    /// Test name
    pub name : string,
    /// Pass/fail status
    pub passed : bool,
    /// Error message (if any)
    pub error : string,
    /// Execution time (if measured)
    pub execution_time : f64
}

/// Requirement check result
pub struct RequirementResult {
    /// Requirement number
    pub number : u32,
    /// Requirement description
    pub description : string,
    /// Pass/fail status
    pub passed : bool,
    /// Error message (if any)
    pub error : string
}

/// Verification result
pub struct VerificationResult {
    /// Verification mode
    pub mode : string,
    /// Project root
    pub project_root : string,
    /// Total tests run
    pub total_tests : u32,
    /// Passed tests
    pub passed_tests : u32,
    /// Failed tests
    pub failed_tests : u32,
    /// Test results
    pub test_results : TestResult[],
    /// Requirement results
    pub requirement_results : RequirementResult[],
    /// Evidence artifacts
    pub evidence_artifacts : string[],
    /// Exit code
    pub exit_code : u32
}

/// Initialize verification result
pub fn verification_result_init(mode : string, project_root : string) -> VerificationResult {
    return VerificationResult{
        .mode = mode,
        .project_root = project_root,
        .total_tests = 0,
        .passed_tests = 0,
        .failed_tests = 0,
        .test_results = [],
        .requirement_results = [],
        .evidence_artifacts = [],
        .exit_code = 0
    };
}

// ============================================================================
// FILE CHECKING FUNCTIONS
// ============================================================================

/// Check if file exists and has content
pub fn check_file_exists_with_content(file_path : string, description : string) -> TestResult {
    let result = TestResult{
        .name = description,
        .passed = false,
        .error = "",
        .execution_time = 0.0
    };
    
    if (fs::exists(file_path)) {
        if (fs::read_to_string(file_path).length > 0) {
            result.passed = true;
            result.evidence_artifacts.append("FILE_EXISTS:" + file_path + ":PASS");
        } else {
            result.error = file_path + " exists but is empty";
            result.evidence_artifacts.append("FILE_EXISTS:" + file_path + ":EMPTY");
        }
    } else {
        result.error = file_path + " not found";
        result.evidence_artifacts.append("FILE_EXISTS:" + file_path + ":FAIL");
    }
    
    return result;
}

/// Check if file contains specific text
pub fn check_file_contains(file_path : string, search_text : string, description : string) -> TestResult {
    let result = TestResult{
        .name = description,
        .passed = false,
        .error = "",
        .execution_time = 0.0
    };
    
    if (!fs::exists(file_path)) {
        result.error = file_path + " not found";
        return result;
    }
    
    const content = fs::read_to_string(file_path);
    if (content.contains(search_text)) {
        result.passed = true;
        result.evidence_artifacts.append("FILE_CONTAINS:" + file_path + ":" + search_text + ":PASS");
    } else {
        result.error = search_text + " not found in " + file_path;
        result.evidence_artifacts.append("FILE_CONTAINS:" + file_path + ":" + search_text + ":FAIL");
    }
    
    return result;
}

// ============================================================================
// TEST EXECUTION FUNCTIONS
// ============================================================================

/// Execute compilation test
pub fn execute_compilation_test(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    const cargo_cmd = "cargo check --manifest-path " + new_result.project_root + "/" + API_IMPLEMENTATION_PATH;
    const exit_code = process::system(cargo_cmd);
    
    const test_result = TestResult{
        .name = "API compilation",
        .passed = exit_code == 0,
        .error = if (exit_code != 0) "Compilation failed with exit code " + exit_code.to_string() else "",
        .execution_time = 0.0
    };
    
    new_result.total_tests += 1;
    if (test_result.passed) {
        new_result.passed_tests += 1;
    } else {
        new_result.failed_tests += 1;
    }
    
    new_result.test_results.append(test_result);
    new_result.evidence_artifacts.append("COMPILATION:" + exit_code.to_string());
    
    return new_result;
}

/// Execute spec syntax test
pub fn execute_spec_syntax_test(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    // Check if tri compiler is available
    if (process::system("command -v tri") == 0) {
        const tri_cmd = "tri test " + new_result.project_root + "/" + SPEC_FILE_PATH + " --silent";
        const exit_code = process::system(tri_cmd);
        
        const test_result = TestResult{
            .name = "Spec syntax check",
            .passed = exit_code == 0,
            .error = if (exit_code != 0) "Spec test failed with exit code " + exit_code.to_string() else "",
            .execution_time = 0.0
        };
        
        new_result.total_tests += 1;
        if (test_result.passed) {
            new_result.passed_tests += 1;
        } else {
            new_result.failed_tests += 1;
            // Don't fail whole verification for spec test issues
        }
        
        new_result.test_results.append(test_result);
        new_result.evidence_artifacts.append("SPEC_SYNTAX:" + exit_code.to_string());
    } else {
        const test_result = TestResult{
            .name = "Spec syntax check",
            .passed = true, // Don't fail if tri not available
            .error = "tri compiler not available",
            .execution_time = 0.0
        };
        
        new_result.total_tests += 1;
        new_result.passed_tests += 1;
        new_result.test_results.append(test_result);
        new_result.evidence_artifacts.append("SPEC_SYNTAX:WARNING:tri_not_available");
    }
    
    return new_result;
}

/// Execute requirement checks
pub fn execute_requirement_checks(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    // Requirement 1: Preflight coverage
    const requirement1 = check_file_contains(
        new_result.project_root + "/" + API_IMPLEMENTATION_PATH,
        REQUIRED_FUNCTION,
        "Preflight coverage"
    );
    
    new_result.requirement_results.append(RequirementResult{
        .number = 1,
        .description = "Preflight runs for every active session, model, route, credential scope",
        .passed = requirement1.passed,
        .error = requirement1.error
    });
    
    // Requirement 2: No silent fallback paths
    const requirement2 = check_file_contains(
        new_result.project_root + "/" + SPEC_FILE_PATH,
        "fallback_explicitly_approved",
        "No silent fallback paths"
    );
    
    new_result.requirement_results.append(RequirementResult{
        .number = 2,
        .description = "No undeclared silent fallback path remains",
        .passed = requirement2.passed,
        .error = requirement2.error
    });
    
    // Requirement 3: Required verdicts
    for verdict in REQUIRED_VERDICTS {
        const verdict_check = check_file_contains(
            new_result.project_root + "/" + SPEC_FILE_PATH,
            verdict,
            verdict + " verdict found"
        );
        
        new_result.requirement_results.append(RequirementResult{
            .number = 3 + verdict_check.name, // Dynamic requirement number
            .description = verdict + " blocks retry",
            .passed = verdict_check.passed,
            .error = verdict_check.error
        });
    }
    
    // Requirement 4: Explicit fallback approval
    const requirement4 = check_file_contains(
        new_result.project_root + "/" + API_IMPLEMENTATION_PATH,
        REQUIRED_FALLBACK,
        "Explicit fallback approval"
    );
    
    new_result.requirement_results.append(RequirementResult{
        .number = 7,
        .description = "Explicit fallback requires approved configuration",
        .passed = requirement4.passed,
        .error = requirement4.error
    });
    
    return new_result;
}

/// Run comprehensive verification
pub fn run_comprehensive_verification(result : VerificationResult) -> VerificationResult {
    var new_result = result;
    
    // Test 1: Check spec file exists and has required content
    const spec_check = check_file_exists_with_content(
        new_result.project_root + "/" + SPEC_FILE_PATH,
        "Provider guard spec"
    );
    
    new_result.total_tests += 1;
    if (spec_check.passed) {
        new_result.passed_tests += 1;
    } else {
        new_result.failed_tests += 1;
    }
    
    new_result.test_results.append(spec_check);
    new_result.evidence_artifacts.append("SPEC_FILE:" + spec_check.passed.to_string());
    
    // Test 2: Check API implementation exists
    const api_check = check_file_exists_with_content(
        new_result.project_root + "/" + API_IMPLEMENTATION_PATH,
        "API implementation"
    );
    
    new_result.total_tests += 1;
    if (api_check.passed) {
        new_result.passed_tests += 1;
    } else {
        new_result.failed_tests += 1;
    }
    
    new_result.test_results.append(api_check);
    new_result.evidence_artifacts.append("API_FILE:" + api_check.passed.to_string());
    
    // Test 3: Check configuration exists
    const config_check = check_file_exists_with_content(
        new_result.project_root + "/" + CONFIG_IMPLEMENTATION_PATH,
        "Configuration implementation"
    );
    
    new_result.total_tests += 1;
    if (config_check.passed) {
        new_result.passed_tests += 1;
    } else {
        new_result.failed_tests += 1;
    }
    
    new_result.test_results.append(config_check);
    new_result.evidence_artifacts.append("CONFIG_FILE:" + config_check.passed.to_string());
    
    // Test 4: Basic compilation check
    new_result = execute_compilation_test(new_result);
    
    // Test 5: Spec syntax check
    new_result = execute_spec_syntax_test(new_result);
    
    // Test 6: Check for required error constants
    const error_check = check_file_contains(
        new_result.project_root + "/" + API_IMPLEMENTATION_PATH,
        REQUIRED_ERROR_CONSTANT,
        "Required error constant"
    );
    
    new_result.total_tests += 1;
    if (error_check.passed) {
        new_result.passed_tests += 1;
    } else {
        new_result.failed_tests += 1;
    }
    
    new_result.test_results.append(error_check);
    new_result.evidence_artifacts.append("ERROR_CONSTANT:" + error_check.passed.to_string());
    
    // Test 7: Check for preflight function
    const preflight_check = check_file_contains(
        new_result.project_root + "/" + API_IMPLEMENTATION_PATH,
        REQUIRED_FUNCTION,
        "Required function"
    );
    
    new_result.total_tests += 1;
    if (preflight_check.passed) {
        new_result.passed_tests += 1;
    } else {
        new_result.failed_tests += 1;
    }
    
    new_result.test_results.append(preflight_check);
    new_result.evidence_artifacts.append("PREFLIGHT_FUNCTION:" + preflight_check.passed.to_string());
    
    // Test 8: Check required invariants
    for invariant in REQUIRED_INVARIANTS {
        const invariant_check = check_file_contains(
            new_result.project_root + "/" + SPEC_FILE_PATH,
            invariant,
            "Required invariant"
        );
        
        new_result.total_tests += 1;
        if (invariant_check.passed) {
            new_result.passed_tests += 1;
        } else {
            new_result.failed_tests += 1;
        }
        
        new_result.test_results.append(invariant_check);
        new_result.evidence_artifacts.append("INVARIANT:" + invariant + ":" + invariant_check.passed.to_string());
    }
    
    // Execute requirement checks
    new_result = execute_requirement_checks(new_result);
    
    // Set exit code
    new_result.exit_code = if new_result.failed_tests > 0 1 else 0;
    
    return new_result;
}

// ============================================================================
// EVIDENCE GENERATION
// ============================================================================

/// Generate structured evidence file
pub fn generate_evidence_file(result : VerificationResult, target_dir : string) -> string {
    const timestamp = env::get_timestamp();
    const evidence_filename = "provider-guard-verification-report-" + timestamp + ".t27-evidence";
    const evidence_path = target_dir + "/.trinity/evidence/" + evidence_filename;
    
    let content = "# Provider Guard Verification Evidence\n" +
                   "# Generated by t27-diagnostic-provider-guard-verify\n" +
                   "# Timestamp: " + timestamp + "\n" +
                   "\n" +
                   "## Summary\n" +
                   "- Verification mode: {}\n".format(result.mode) +
                   "- Project root: {}\n".format(result.project_root) +
                   "- Total tests: {}\n".format(result.total_tests) +
                   "- Passed: {}\n".format(result.passed_tests) +
                   "- Failed: {}\n".format(result.failed_tests) +
                   "- Exit code: {}\n".format(result.exit_code) +
                   "\n" +
                   "## Test Results\n" +
                   "\n";
    
    for test in result.test_results {
        content += "### {}\n".format(test.name);
        content += "- Status: {}\n".format(if test.passed "PASS" else "FAIL");
        if (test.error.length > 0) {
            content += "- Error: {}\n".format(test.error);
        }
        content += "\n";
    }
    
    content += "## Requirement Results\n" +
               "\n";
    
    for requirement in result.requirement_results {
        content += "### Requirement {}\n".format(requirement.number);
        content += "- Description: {}\n".format(requirement.description);
        content += "- Status: {}\n".format(if requirement.passed "PASS" else "FAIL");
        if (requirement.error.length > 0) {
            content += "- Error: {}\n".format(requirement.error);
        }
        content += "\n";
    }
    
    content += "## Evidence Entries\n";
    for entry in result.evidence_artifacts {
        content += "- {}\n".format(entry);
    }
    
    fs::write(evidence_path, content);
    
    return evidence_path;
}

// ============================================================================
// TDD: TESTS
// ============================================================================

test "verification_result_init_default_values" {
    const result = verification_result_init(MODE_QUICK, DEFAULT_PROJECT_ROOT);
    assert result.mode == MODE_QUICK;
    assert result.project_root == DEFAULT_PROJECT_ROOT;
    assert result.total_tests == 0;
    assert result.passed_tests == 0;
    assert result.failed_tests == 0;
    assert result.test_results.length == 0;
    assert result.requirement_results.length == 0;
    assert result.evidence_artifacts.length == 0;
    assert result.exit_code == 0;
}

test "check_file_exists_logic" {
    // This test would require actual file system interaction
    // Test the logic structure
    const result = check_file_exists_with_content("/tmp/test.txt", "Test file");
    // In real test, would create file and check behavior
}

// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant "test_counts_consistency" {
    const result = verification_result_init(MODE_QUICK, DEFAULT_PROJECT_ROOT);
    assert result.passed_tests + result.failed_tests == result.total_tests;
}

invariant "exit_code_is_valid" {
    const result = verification_result_init(MODE_QUICK, DEFAULT_PROJECT_ROOT);
    assert result.exit_code == 0 || result.exit_code == 1 || result.exit_code == 2;
}

// ============================================================================
// SKILL EXECUTION ENTRY POINT
// ============================================================================

/// Main skill execution function
pub fn main() {
    const args = env::get_argv();
    let mode = MODE_QUICK;
    let project_root = DEFAULT_PROJECT_ROOT;
    
    // Parse arguments
    for i in 0..(args.length - 1) {
        if (args[i] == "--mode") {
            mode = args[i + 1];
        } else if (args[i] == "--project-root") {
            project_root = args[i + 1];
        }
    }
    
    println!("Running Provider Guard Verification Skill");
    println!("Verification mode: {}", mode);
    println!("Project root: {}", project_root);
    
    const result = verification_result_init(mode, project_root);
    const verification_result = run_comprehensive_verification(result);
    
    // Generate evidence file
    const evidence_file = generate_evidence_file(verification_result, project_root);
    println!("");
    println!("Evidence artifact created: {}", evidence_file);
    
    // Print summary
    println!("");
    println!("Verification Complete");
    println!("Tests: {}", verification_result.total_tests);
    println!("Passed: {}", verification_result.passed_tests);
    println!("Failed: {}", verification_result.failed_tests);
    
    if (verification_result.failed_tests > 0) {
        println!("❌ Some tests failed. Please review the errors above.");
    } else {
        println!("✅ All tests passed! Provider guard implementation is ready.");
    }
    
    process::exit(verification_result.exit_code);
}