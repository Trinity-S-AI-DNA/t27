module diagnostics-pr-conflict-check;

use std::process;
use std::env;

// ============================================================================
// SKILL CONTRACT
// ============================================================================

/// SKILL NAME: t27-diagnostic-pr-conflict-check  
/// PURPOSE: Check PR merge status and detect conflicts between branches
/// INPUTS: target_branch (string), base_branch (string)
/// OUTPUT: pr-conflict-report.t27-evidence
/// EXIT: 0=clean, 1=conflicts, 2=errors
/// SIDE_EFFECTS: none  
/// LANGUAGE: .t27 only
/// STORAGE: specs/diagnostics/

// ============================================================================
// SACRED CONSTANTS
// ============================================================================

/// Default branches to check in merge order
pub const PHASE_4_BRANCHES : string[] = [
    "feat/ring-051-verdict-schema",
    "feat/ring-052-lotus-automation", 
    "feat/ring-053-property-test",
    "feat/ring-055-experience-schema",
    "feat/ring-056-schema-validation-ci"
];

/// Stale PRs that may need attention first
pub const STALE_PR_BRANCHES : string[] = [
    "feat/ring-039-clara-prep-plan",
    "feat/ring-035-technology-tree",
    "feat/ring-041-gf16-arxiv-draft",
    "ring/037-soul-parser-enforcement"
];

/// Default base branch for merge checks
pub const BASE_BRANCH : string = "master";

/// Default remote name
pub const REMOTE_NAME : string = "origin";

// ============================================================================
// PR CHECK STATE
// ============================================================================

/// PR check result
pub struct PRCheckResult {
    /// Total branches checked
    pub total_branches : u32,
    /// Merged branches
    pub merged_branches : u32,
    /// Pending branches
    pub pending_branches : u32,
    /// Stale branches needing review
    pub stale_branches : u32,
    /// Conflicts detected
    pub conflicts_detected : u32,
    /// Evidence artifacts
    pub evidence_artifacts : string[],
    /// Exit code
    pub exit_code : u32
}

/// Initialize PR check result
pub fn pr_check_result_init() -> PRCheckResult {
    return PRCheckResult{
        .total_branches = 0,
        .merged_branches = 0,
        .pending_branches = 0,
        .stale_branches = 0,
        .conflicts_detected = 0,
        .evidence_artifacts = [],
        .exit_code = 0
    };
}

// ============================================================================
// GIT OPERATIONS
// ============================================================================

/// Check if branch is merged into base
pub fn check_branch_merged(branch_name : string, base_branch : string, remote : string) -> bool {
    const git_cmd = "git merge-base --is-ancestor " + remote + "/" + branch_name + " " + base_branch + " 2>/dev/null";
    const exit_code = process::system(git_cmd);
    return exit_code == 0;
}

/// Get branch existence status
pub fn check_branch_exists(branch_name : string, remote : string) -> bool {
    const git_cmd = "git show-ref --verify --quiet refs/remotes/" + remote + "/" + branch_name;
    const exit_code = process::system(git_cmd);
    return exit_code == 0;
}

// ============================================================================
// PR CHECKING FUNCTIONS
// ============================================================================

/// Check phase 4 branches for merge status
pub fn check_phase_4_branches(result : PRCheckResult, base_branch : string, remote : string) -> PRCheckResult {
    var new_result = result;
    println("Checking Phase 4 PRs (merge order):");
    println("");
    
    new_result.total_branches += PHASE_4_BRANCHES.length;
    
    for branch in PHASE_4_BRANCHES {
        if (check_branch_merged(branch, base_branch, remote)) {
            println("  [MERGED] {}", branch);
            const evidence = "BRANCH_MERGED:" + branch + ":" + base_branch;
            new_result.evidence_artifacts.append(evidence);
            new_result.merged_branches += 1;
        } else {
            println("  [PENDING] {}", branch);
            const evidence = "BRANCH_PENDING:" + branch + ":" + base_branch;
            new_result.evidence_artifacts.append(evidence);
            new_result.pending_branches += 1;
        }
    }
    
    return new_result;
}

/// Check stale PR branches
pub fn check_stale_branches(result : PRCheckResult, base_branch : string, remote : string) -> PRCheckResult {
    var new_result = result;
    println("");
    println("Checking stale PRs:");
    println("");
    
    for branch in STALE_PR_BRANCHES {
        if (check_branch_merged(branch, base_branch, remote)) {
            println("  [MERGED] {}", branch);
            const evidence = "STALE_MERGED:" + branch + ":" + base_branch;
            new_result.evidence_artifacts.append(evidence);
            new_result.merged_branches += 1;
        } else {
            println("  [PENDING] {} (STALE - review needed)", branch);
            const evidence = "STALE_PENDING:" + branch + ":" + base_branch + ":REVIEW_NEEDED";
            new_result.evidence_artifacts.append(evidence);
            new_result.stale_branches += 1;
            new_result.pending_branches += 1;
        }
    }
    
    return new_result;
}

/// Check for potential conflicts between branches
pub fn check_branch_conflicts(result : PRCheckResult, branches : string[], base_branch : string) -> PRCheckResult {
    var new_result = result;
    
    // Simple conflict detection: check if any pending branches have diverged significantly
    for i in 0..(branches.length - 1) {
        const branch1 = branches[i];
        const branch2 = branches[i + 1];
        
        // Check if both branches exist and are not merged
        if (!check_branch_merged(branch1, base_branch, REMOTE_NAME) && 
            !check_branch_merged(branch2, base_branch, REMOTE_NAME)) {
            
            // Check if they have common ancestor (potential conflict)
            const merge_base_cmd = "git merge-base --is-ancestor " + REMOTE_NAME + "/" + branch1 + " " + REMOTE_NAME + "/" + branch2 + " 2>/dev/null";
            const exit_code = process::system(merge_base_cmd);
            
            if (exit_code != 0) {
                println!("  [CONFLICT] Potential conflict between {} and {}", branch1, branch2);
                const evidence = "POTENTIAL_CONFLICT:" + branch1 + ":" + branch2;
                new_result.evidence_artifacts.append(evidence);
                new_result.conflicts_detected += 1;
            }
        }
    }
    
    return new_result;
}

/// Generate summary of merge status
pub fn generate_merge_summary(result : PRCheckResult) -> string {
    const summary = "=== PR Conflict Check Summary ===\n" +
                   "Total branches checked: " + result.total_branches.to_string() + "\n" +
                   "Merged: " + result.merged_branches.to_string() + "\n" +
                   "Pending: " + result.pending_branches.to_string() + "\n" +
                   "Stale: " + result.stale_branches.to_string() + "\n" +
                   "Conflicts detected: " + result.conflicts_detected.to_string() + "\n";
    
    return summary;
}

// ============================================================================
// EVIDENCE GENERATION
// ============================================================================

/// Generate structured evidence file
pub fn generate_evidence_file(result : PRCheckResult, target_dir : string) -> string {
    const timestamp = env::get_timestamp();
    const evidence_filename = "pr-conflict-report-" + timestamp + ".t27-evidence";
    const evidence_path = target_dir + "/.trinity/evidence/" + evidence_filename;
    
    const content = "# PR Conflict Check Evidence\n" +
                   "# Generated by t27-diagnostic-pr-conflict-check\n" +
                   "# Timestamp: " + timestamp + "\n" +
                   "\n" +
                   generate_merge_summary(result) +
                   "\n" +
                   "## Detailed Results\n" +
                   "\n" +
                   "### Evidence Entries\n";
    
    for entry in result.evidence_artifacts {
        const evidence_line = "- " + entry + "\n";
        const content_with_entry = content + evidence_line;
        fs::write(evidence_path, content_with_entry);
    }
    
    return evidence_path;
}

// ============================================================================
// TDD: TESTS
// ============================================================================

test "pr_check_result_init_default_values" {
    const result = pr_check_result_init();
    assert result.total_branches == 0;
    assert result.merged_branches == 0;
    assert result.pending_branches == 0;
    assert result.stale_branches == 0;
    assert result.conflicts_detected == 0;
    assert result.evidence_artifacts.length == 0;
    assert result.exit_code == 0;
}

test "check_branch_merged_logic" {
    // Test the logic without actual git operations
    // This would require mocking or creating test environment
    const result1 = check_branch_merged("merged-branch", "master", "origin");
    const result2 = check_branch_merged("pending-branch", "master", "origin");
    // Actual values would depend on git state in test environment
}

// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant "total_branches_consistency" {
    const result = pr_check_result_init();
    const calculated_total = result.merged_branches + result.pending_branches + result.stale_branches;
    // Note: This might not match exactly due to overlaps in categories
    assert result.total_branches >= calculated_total;
}

invariant "exit_code_is_valid" {
    const result = pr_check_result_init();
    assert result.exit_code == 0 || result.exit_code == 1 || result.exit_code == 2;
}

// ============================================================================
// MAIN EXECUTION
// ============================================================================

/// Run comprehensive PR conflict check
pub fn check_pr_conflicts(target_branch : string, base_branch : string) -> PRCheckResult {
    var result = pr_check_result_init();
    
    println("=== T27 Conflict Checker ===");
    println("");
    
    // Check phase 4 branches
    result = check_phase_4_branches(result, base_branch, REMOTE_NAME);
    
    // Check stale branches
    result = check_stale_branches(result, base_branch, REMOTE_NAME);
    
    // Check for conflicts between pending branches
    const all_pending_branches = [];
    for branch in PHASE_4_BRANCHES {
        if (!check_branch_merged(branch, base_branch, REMOTE_NAME)) {
            all_pending_branches.append(branch);
        }
    }
    for branch in STALE_PR_BRANCHES {
        if (!check_branch_merged(branch, base_branch, REMOTE_NAME)) {
            all_pending_branches.append(branch);
        }
    }
    
    result = check_branch_conflicts(result, all_pending_branches, base_branch);
    
    // Set exit code based on conflicts
    if (result.conflicts_detected > 0) {
        result.exit_code = 1; // Conflicts detected
    } else if (result.pending_branches > 0) {
        result.exit_code = 0; // Clean but some work pending
    } else {
        result.exit_code = 0; // All clean
    }
    
    // Generate summary
    println("");
    println("Summary: {} merged, {} pending", result.merged_branches, result.pending_branches);
    println("");
    
    println("{}", generate_merge_summary(result));
    println("");
    println("=== End of check ===");
    
    return result;
}

// ============================================================================
// SKILL EXECUTION ENTRY POINT
// ============================================================================

/// Main skill execution function
pub fn main() {
    const target_dir = env::get_current_dir();
    const target_branch = env::getenv("TARGET_BRANCH", BASE_BRANCH);
    const base_branch = env::getenv("BASE_BRANCH", BASE_BRANCH);
    
    println("Running PR Conflict Check Skill");
    println("Target directory: {}", target_dir);
    println("Target branch: {}", target_branch);
    println("Base branch: {}", base_branch);
    
    const result = check_pr_conflicts(target_branch, base_branch);
    
    // Generate evidence file
    const evidence_file = generate_evidence_file(result, target_dir);
    println("");
    println("Evidence artifact created: {}", evidence_file);
    
    // Exit with appropriate code
    if (result.exit_code == 1) {
        println!("⚠️  Conflicts detected - review needed");
    } else {
        println!("✅ No conflicts detected");
    }
    
    process::exit(result.exit_code);
}