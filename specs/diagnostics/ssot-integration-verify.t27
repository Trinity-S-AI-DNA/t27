// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant "total_checks_equals_sum_of_categories" {
    const result = verification_result_init();
    const total = result.passed_checks + result.failed_checks + result.warning_checks;
    assert result.total_checks == total;
}

invariant "exit_code_is_zero_or_one" {
    const result = verification_result_init();
    assert result.exit_code == 0 || result.exit_code == 1;
}

// ============================================================================
// SKILL EXECUTION ENTRY POINT
// ============================================================================

/// Main skill execution function
pub fn main() {
    const target_dir = env::get_current_dir();
    
    println("Running SSOT Integration Verification Skill");
    println("Target directory: {}", target_dir);
    
    const result = verify_ssot_integration(target_dir);
    
    // Generate evidence file
    const evidence_file = generate_evidence_file(result, target_dir);
    println("");
    println("Evidence artifact created: {}", evidence_file);
    
    // Output final summary
    println("");
    println("=== Summary ===");
    println("Passed: {}", result.passed_checks);
    println("Failed: {}", result.failed_checks);
    
    if (result.failed_checks > 0) {
        println("\n❌ Some checks failed. Please fix the issues above.");
    } else {
        println("\n✅ All checks passed!");
    }
    
    // Exit with proper code
    process::exit(result.exit_code);
}