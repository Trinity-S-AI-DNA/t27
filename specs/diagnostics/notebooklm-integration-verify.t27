// Trinity S³AI — 7-Level NotebookLM Integration Diagnostic
// φ² + 1/φ² = 3 | TRINITY

module diagnostics-notebooklm-integration-verify;

use std::process;
use std::env;
use std::fs;

// ============================================================================
// SKILL CONTRACT
// ============================================================================

/// SKILL NAME: t27-diagnostic-notebooklm-integration-verify
/// PURPOSE: 7-level verification of NotebookLM integration completeness
/// INPUTS: target_directory (string), venv_path (string)
/// OUTPUT: notebooklm-integration-report.t27-evidence  
/// EXIT: 0=pass, 1=fail, 2=errors
/// SIDE_EFFECTS: none
/// LANGUAGE: .t27 only
/// STORAGE: specs/diagnostics/

// ============================================================================
// SACRED CONSTANTS
// ============================================================================

/// Expected number of NotebookLM modules
pub const EXPECTED_MODULE_COUNT : u32 = 11;

/// Default NotebookLM directory
pub const NOTEBOOKLM_DIR : string = "contrib/backend/notebooklm";

/// Expected notebook name
pub const EXPECTED_NOTEBOOK_NAME : string = "t27-QUEEN-BRAIN";

/// Expected timeout in milliseconds
pub const EXPECTED_TIMEOUT_MS : u32 = 30000;

/// Expected auto-refresh setting
pub const EXPECTED_AUTO_REFRESH : bool = true;

/// Default virtual environment path
pub const DEFAULT_VENV_PATH : string = "/tmp/notebooklm-venv";

/// Test file for stdlib conflict check
pub const STDLIB_TEST_FILE : string = "test_stdlib.py";

// ============================================================================
// VERIFICATION STATE
// ============================================================================

/// Verification level result
pub struct LevelResult {
    /// Level number
    pub level : u32,
    /// Level name
    pub name : string,
    /// Passed flag
    pub passed : bool,
    /// Evidence entry
    pub evidence : string,
    /// Error message (if any)
    pub error : string
}

/// Complete verification result
pub struct VerificationResult {
    /// Total levels
    pub total_levels : u32,
    /// Passed levels
    pub passed_levels : u32,
    /// Failed levels
    pub failed_levels : u32,
    /// Level results
    pub level_results : LevelResult[],
    /// Evidence artifacts
    pub evidence_artifacts : string[],
    /// Exit code
    pub exit_code : u32
}

/// Initialize verification result
pub fn verification_result_init() -> VerificationResult {
    return VerificationResult{
        .total_levels = 7,
        .passed_levels = 0,
        .failed_levels = 0,
        .level_results = [],
        .evidence_artifacts = [],
        .exit_code = 0
    };
}

// ============================================================================
// LEVEL 1: Files in place
// ============================================================================

/// Check if required NotebookLM files exist
pub fn check_level_files(result : VerificationResult, target_dir : string) -> VerificationResult {
    var new_result = result;
    
    const notebooklm_full_path = target_dir + "/" + NOTEBOOKLM_DIR;
    
    // Count Python files in directory
    const count_cmd = "ls -1 " + notebooklm_full_path + "/*.py 2>/dev/null | wc -l | tr -d ' '";
    const exit_code = process::system(count_cmd);
    
    let file_count : u32 = 0;
    if (exit_code == 0) {
        const output = process::get_command_output(count_cmd);
        file_count = output.to_u32();
    }
    
    const level_result = LevelResult{
        .level = 1,
        .name = "Files in place",
        .passed = file_count == EXPECTED_MODULE_COUNT,
        .evidence = "LEVEL1_FILE_COUNT:" + file_count.to_string() + ":" + EXPECTED_MODULE_COUNT.to_string(),
        .error = if (file_count != EXPECTED_MODULE_COUNT) 
            "Expected " + EXPECTED_MODULE_COUNT.to_string() + ", found " + file_count.to_string() 
            else ""
    };
    
    new_result.level_results.append(level_result);
    
    if (level_result.passed) {
        new_result.passed_levels += 1;
        println!("[PASS] All {} modules present", EXPECTED_MODULE_COUNT);
    } else {
        new_result.failed_levels += 1;
        println!("[FAIL] Expected {}, found {}", EXPECTED_MODULE_COUNT, file_count);
    }
    
    new_result.evidence_artifacts.append(level_result.evidence);
    
    return new_result;
}

// ============================================================================
// LEVEL 2: Python imports work  
// ============================================================================

/// Check Python imports functionality
pub fn check_level_imports(result : VerificationResult, target_dir : string) -> VerificationResult {
    var new_result = result;
    
    const python_cmd = 
        "python3 -c \"" +
        "import sys; sys.path.insert(0, '.'); " +
        "from contrib.backend.notebooklm.config import config_from_env, NotebookLMConfig; " +
        "from contrib.backend.notebooklm.auth_token import token_load, token_save, token_is_valid, AuthTokens; " +
        "from contrib.backend.notebooklm.cookie_auth import authenticate_with_cookies; " +
        "print('[OK] All Python imports work')" +
        "\"";
    
    const exit_code = process::system(python_cmd);
    
    const level_result = LevelResult{
        .level = 2,
        .name = "Python imports work",
        .passed = exit_code == 0,
        .evidence = "LEVEL2_IMPORTS:" + exit_code.to_string(),
        .error = if (exit_code != 0) "Import test failed" else ""
    };
    
    new_result.level_results.append(level_result);
    
    if (level_result.passed) {
        new_result.passed_levels += 1;
        println!("[PASS] Import test succeeded");
    } else {
        new_result.failed_levels += 1;
        println!("[FAIL] Import test failed");
    }
    
    new_result.evidence_artifacts.append(level_result.evidence);
    
    return new_result;
}

// ============================================================================
// LEVEL 3: Config defaults correct
// ============================================================================

/// Check configuration defaults
pub fn check_level_config(result : VerificationResult, target_dir : string) -> VerificationResult {
    var new_result = result;
    
    const python_cmd = 
        "python3 -c \"" +
        "import sys; sys.path.insert(0, '.'); " +
        "from contrib.backend.notebooklm.config import config_from_env; " +
        "cfg = config_from_env(); " +
        "assert cfg.notebook_name == '" + EXPECTED_NOTEBOOK_NAME + "', f'Wrong notebook name: {cfg.notebook_name}'; " +
        "assert cfg.timeout_ms == " + EXPECTED_TIMEOUT_MS.to_string() + ", f'Wrong timeout: {cfg.timeout_ms}'; " +
        "assert cfg.auto_refresh == " + EXPECTED_AUTO_REFRESH.to_string() + ", f'Wrong auto-refresh: {cfg.auto_refresh}'; " +
        "print('[OK] Config defaults verified')" +
        "\"";
    
    const exit_code = process::system(python_cmd);
    
    const level_result = LevelResult{
        .level = 3,
        .name = "Config defaults correct",
        .passed = exit_code == 0,
        .evidence = "LEVEL3_CONFIG:" + exit_code.to_string(),
        .error = if (exit_code != 0) "Config verification failed" else ""
    };
    
    new_result.level_results.append(level_result);
    
    if (level_result.passed) {
        new_result.passed_levels += 1;
        println!("[PASS] Config defaults verified");
    } else {
        new_result.failed_levels += 1;
        println!("[FAIL] Config verification failed");
    }
    
    new_result.evidence_artifacts.append(level_result.evidence);
    
    return new_result;
}

// ============================================================================
// LEVEL 4: Token operations work
// ============================================================================

/// Check token operations functionality
pub fn check_level_tokens(result : VerificationResult, target_dir : string) -> VerificationResult {
    var new_result = result;
    
    const python_cmd = 
        "python3 -c \"" +
        "import sys; import tempfile; from datetime import datetime, timedelta; " +
        "sys.path.insert(0, '.'); " +
        "from contrib.backend.notebooklm.auth_token import token_load, token_save, token_is_valid, AuthTokens; " +
        "# Test load from default path; " +
        "result = token_load(); " +
        "# Test save with future expiry date; " +
        "future_expiry = datetime.now() + timedelta(hours=1); " +
        "tokens = AuthTokens('access_token', 'refresh_token', future_expiry, 'bearer'); " +
        "success = token_save(tokens); " +
        "assert success == True, f'Failed to save tokens'; " +
        "# Test token_is_valid; " +
        "assert token_is_valid(tokens) == True, 'Valid token should return True'; " +
        "print('[OK] Token operations verified')" +
        "\"";
    
    const exit_code = process::system(python_cmd);
    
    const level_result = LevelResult{
        .level = 4,
        .name = "Token operations work",
        .passed = exit_code == 0,
        .evidence = "LEVEL4_TOKENS:" + exit_code.to_string(),
        .error = if (exit_code != 0) "Token operations failed" else ""
    };
    
    new_result.level_results.append(level_result);
    
    if (level_result.passed) {
        new_result.passed_levels += 1;
        println!("[PASS] Token operations work");
    } else {
        new_result.failed_levels += 1;
        println!("[FAIL] Token operations failed");
    }
    
    new_result.evidence_artifacts.append(level_result.evidence);
    
    return new_result;
}

// ============================================================================
// LEVEL 5: SDK installed
// ============================================================================

/// Check SDK installation
pub fn check_level_sdk(result : VerificationResult, venv_path : string) -> VerificationResult {
    var new_result = result;
    
    const activate_cmd = "source " + venv_path + "/bin/activate 2>/dev/null";
    const python_cmd = 
        "python3 -c \"" +
        "import notebooklm; " +
        "print(f'[OK] SDK version: {notebooklm.__version__}')" +
        "\"";
    const full_cmd = activate_cmd + " && " + python_cmd;
    
    const exit_code = process::system(full_cmd);
    
    // Deactivate (even if failed)
    process::system("deactivate 2>/dev/null");
    
    const level_result = LevelResult{
        .level = 5,
        .name = "SDK installed",
        .passed = exit_code == 0,
        .evidence = "LEVEL5_SDK:" + exit_code.to_string(),
        .error = if (exit_code != 0) "SDK not available" else ""
    };
    
    new_result.level_results.append(level_result);
    
    if (level_result.passed) {
        new_result.passed_levels += 1;
        println!("[PASS] SDK is available");
    } else {
        new_result.failed_levels += 1;
        println!("[FAIL] SDK not available");
    }
    
    new_result.evidence_artifacts.append(level_result.evidence);
    
    return new_result;
}

// ============================================================================
// LEVEL 6: Imports don't conflict with stdlib
// ============================================================================

/// Check for stdlib conflicts
pub fn check_level_stdlib_conflict(result : VerificationResult, target_dir : string) -> VerificationResult {
    var new_result = result;
    
    const python_cmd = 
        "python3 -c \"" +
        "import sys; import tempfile; import os; " +
        "orig_dir = os.getcwd(); " +
        "sys.path.insert(0, orig_dir); " +
        "os.chdir('/tmp'); " +
        "with open('" + STDLIB_TEST_FILE + "', 'w') as f: " +
        "    f.write('import token; print(\\\"stdlib token works\\\")'); " +
        "from contrib.backend.notebooklm.auth_token import AuthTokens; " +
        "from contrib.backend.notebooklm.config import NotebookLMConfig; " +
        "print('[OK] No stdlib conflict detected')" +
        "\"";
    
    const exit_code = process::system(python_cmd);
    
    // Clean up test file
    const cleanup_cmd = "rm -f /tmp/" + STDLIB_TEST_FILE;
    process::system(cleanup_cmd);
    
    const level_result = LevelResult{
        .level = 6,
        .name = "Imports don't conflict with stdlib",
        .passed = exit_code == 0,
        .evidence = "LEVEL6_STDLIB:" + exit_code.to_string(),
        .error = if (exit_code != 0) "Stdlib conflict detected" else ""
    };
    
    new_result.level_results.append(level_result);
    
    if (level_result.passed) {
        new_result.passed_levels += 1;
        println!("[PASS] auth_token.py doesn't conflict with stdlib 'token'");
    } else {
        new_result.failed_levels += 1;
        println!("[FAIL] Stdlib conflict detected");
    }
    
    new_result.evidence_artifacts.append(level_result.evidence);
    
    return new_result;
}

// ============================================================================
// LEVEL 7: Connection test
// ============================================================================

/// Check connection functionality (sandbox mode)
pub fn check_level_connection(result : VerificationResult, venv_path : string) -> VerificationResult {
    var new_result = result;
    
    println!("LEVEL 7: Connection test (SANDBOX MODE)");
    println!("--------------------------------");
    println!("NOTE: Full auth requires browser. This is a unit test only.");
    println!("");
    
    const activate_cmd = "source " + venv_path + "/bin/activate 2>/dev/null";
    const python_cmd = 
        "python3 -c \"" +
        "import sys; sys.path.insert(0, '.'); " +
        "from contrib.backend.notebooklm.cookie_auth import test_notebooklm_sdk_integration; " +
        "if test_notebooklm_sdk_integration(): " +
        "    print('[OK] SDK check works') " +
        "else: " +
        "    print('[FAIL] SDK check failed'); " +
        "    sys.exit(1) " +
        "\"";
    const full_cmd = activate_cmd + " && " + python_cmd;
    
    const exit_code = process::system(full_cmd);
    
    // Deactivate
    process::system("deactivate 2>/dev/null");
    
    const level_result = LevelResult{
        .level = 7,
        .name = "Connection test (SANDBOX MODE)",
        .passed = exit_code == 0,
        .evidence = "LEVEL7_CONNECTION:" + exit_code.to_string(),
        .error = if (exit_code != 0) "SDK availability test failed" else ""
    };
    
    new_result.level_results.append(level_result);
    
    if (level_result.passed) {
        new_result.passed_levels += 1;
        println!("[PASS] SDK availability test passed");
    } else {
        new_result.failed_levels += 1;
        println!("[FAIL] SDK availability test failed");
    }
    
    new_result.evidence_artifacts.append(level_result.evidence);
    
    return new_result;
}

// ============================================================================
// EVIDENCE GENERATION
// ============================================================================

/// Generate structured evidence file
pub fn generate_evidence_file(result : VerificationResult, target_dir : string) -> string {
    const timestamp = env::get_timestamp();
    const evidence_filename = "notebooklm-integration-report-" + timestamp + ".t27-evidence";
    const evidence_path = target_dir + "/.trinity/evidence/" + evidence_filename;
    
    let content = "# NotebookLM Integration Verification Evidence\n" +
                   "# Generated by t27-diagnostic-notebooklm-integration-verify\n" +
                   "# Timestamp: " + timestamp + "\n" +
                   "\n" +
                   "## Summary\n" +
                   "- Total levels: " + result.total_levels.to_string() + "\n" +
                   "- Passed: " + result.passed_levels.to_string() + "\n" +
                   "- Failed: " + result.failed_levels.to_string() + "\n" +
                   "- Exit code: " + result.exit_code.to_string() + "\n" +
                   "\n" +
                   "## Level Results\n" +
                   "\n";
    
    for level in result.level_results {
        const status = if level.passed "PASS" else "FAIL";
        content += "### Level {}: {} ({})\n".format(level.level, level.name, status);
        if (level.error.length > 0) {
            content += "- Error: {}\n".format(level.error);
        }
        content += "- Evidence: {}\n\n".format(level.evidence);
    }
    
    content += "## Evidence Entries\n";
    for entry in result.evidence_artifacts {
        content += "- {}\n".format(entry);
    }
    
    fs::write(evidence_path, content);
    
    return evidence_path;
}

// ============================================================================
// MAIN VERIFICATION FLOW
// ============================================================================

/// Run complete 7-level verification
pub fn run_verification(target_dir : string, venv_path : string) -> VerificationResult {
    var result = verification_result_init();
    
    println("==========================================");
    println("NOTEBOOKLM INTEGRATION VERIFICATION");
    println("==========================================");
    println!("");
    
    // Run all verification levels
    result = check_level_files(result, target_dir);
    println!("");
    
    result = check_level_imports(result, target_dir);
    println!("");
    
    result = check_level_config(result, target_dir);
    println!("");
    
    result = check_level_tokens(result, target_dir);
    println!("");
    
    result = check_level_sdk(result, venv_path);
    println!("");
    
    result = check_level_stdlib_conflict(result, target_dir);
    println!("");
    
    result = check_level_connection(result, venv_path);
    println!("");
    
    // Set exit code
    result.exit_code = if result.failed_levels > 0 1 else 0;
    
    return result;
}

// ============================================================================
// TDD: TESTS
// ============================================================================

test "verification_result_init_default_values" {
    const result = verification_result_init();
    assert result.total_levels == 7;
    assert result.passed_levels == 0;
    assert result.failed_levels == 0;
    assert result.level_results.length == 0;
    assert result.evidence_artifacts.length == 0;
    assert result.exit_code == 0;
}

// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant "level_counts_consistency" {
    const result = verification_result_init();
    assert result.passed_levels + result.failed_levels == result.total_levels;
}

invariant "exit_code_is_valid" {
    const result = verification_result_init();
    assert result.exit_code == 0 || result.exit_code == 1 || result.exit_code == 2;
}

// ============================================================================
// SKILL EXECUTION ENTRY POINT
// ============================================================================

/// Main skill execution function
pub fn main() {
    const target_dir = env::get_current_dir();
    const venv_path = env::getenv("VENV_PATH", DEFAULT_VENV_PATH);
    
    println("Running NotebookLM Integration Verification Skill");
    println!("Target directory: {}", target_dir);
    println!("Virtual environment: {}", venv_path);
    
    const result = run_verification(target_dir, venv_path);
    
    // Generate summary
    println("");
    println("==========================================");
    println("SUMMARY");
    println("==========================================");
    println("Levels passed: {}/{}", result.passed_levels, result.total_levels);
    println("Levels failed: {}/{}", result.failed_levels, result.total_levels);
    
    // Generate evidence file
    const evidence_file = generate_evidence_file(result, target_dir);
    println!("");
    println("Evidence artifact created: {}", evidence_file);
    
    if (result.passed_levels == result.total_levels) {
        println!("");
        println("RESULT: ALL VERIFICATION LEVELS PASSED!");
        println!("");
        println("Next steps:");
        println("  1. Integration tests (T-14 to T-19 from PR plan)");
        println!("  2. Update PR #309 with verification status");
    } else {
        println!("");
        println("RESULT: {} LEVELS FAILED", result.failed_levels);
        println!("");
        println("To fix failures:");
        println("  1. Check missing modules in {}/", target_dir, NOTEBOOKLM_DIR);
        println!("  2. Verify Python version compatibility (requires 3.10+)");
        println!("  3. Ensure venv has notebooklm-py installed");
    }
    
    process::exit(result.exit_code);
}