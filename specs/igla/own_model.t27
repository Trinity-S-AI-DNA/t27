pub fn step_number(cell: i32) -> i32 {
    return cell + 1;
}

/// part of whole, in whole percent, truncated.
pub fn share_pct(part: i32, whole: i32) -> i32 {
    return @divTrunc(part * 100, whole);
}

/// Mean PCT of cells [from, from+n), truncated: every cell weighs the same.
pub fn mean_pct(from: i32, n: i32) -> i32 {
    var sum : i32 = 0;
    var c : i32 = from;
    while (c < from + n) {
        const p : i32 = @intCast(PCT[@intCast(c)]);
        sum = sum + p;
        c = c + 1;
    }
    return @divTrunc(sum, n);
}

test the_domain_is_routed_not_chosen {
    assert DOMAIN == DOMAIN_ENGINEERING;
    assert keyword_hits(BRIEF, BRIEF.len, ENGINEERING_WORDS, ENGINEERING_WORDS.len) == 3;
    assert keyword_hits(BRIEF, BRIEF.len, CONTENT_WORDS, CONTENT_WORDS.len) == 0;
    assert keyword_hits(BRIEF, BRIEF.len, RESEARCH_WORDS, RESEARCH_WORDS.len) == 0;
    assert keyword_hits(BRIEF, BRIEF.len, SALES_WORDS, SALES_WORDS.len) == 0;
    assert route_brief(BRIEF, BRIEF.len) == DOMAIN;
}

test every_step_is_a_cell {
    assert CELL_COUNT == 27;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        assert TITLES[i].len > 0;
        var want : i32 = 1;
        if (step_number(c) >= 10) {
            want = 2;
        }
        const len : i32 = @intCast(LABELS[i].len);
        assert len == want;
        c = c + 1;
    }
    assert LENS_TITLES[2].len > 0;
}

test a_gap_is_named_not_filled {
    assert gaps_are_named(SOURCES, MISSING, GROUNDED);
    assert count_true(GROUNDED) == 20;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        // a gap is drawn as a gap, and only a gap is; a gap is a part that does not exist: 0 percent
        assert (STATUS[i] == STATUS_GAP) == (GROUNDED[i] == false);
        assert (GROUNDED[i] == false) == (PCT[i] == 0);
        assert PCT[i] <= 100;
        c = c + 1;
    }
}

test a_status_is_earned_not_chosen {
    assert statuses_earned(STATUS, DOMAIN, GROUNDED, TEST_PASS, REVIEWED, LIVE);
    // the evidence slide's "1 published, 12 verified, 7 drafts" and "7 gaps"
    assert count_status(STATUS, STATUS_PUBLISHED) == 1;
    assert count_status(STATUS, STATUS_VERIFIED) == 12;
    assert count_status(STATUS, STATUS_DRAFT) == 7;
    assert count_status(STATUS, STATUS_GAP) == 7;
    assert count_true(REVIEWED) == 0;
    // every passing test is a PRACTICE step: loss, optimizers, forward pass, matvec
    assert count_true(TEST_PASS) == 4;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        if (TEST_PASS[i]) {
            assert step_stage(@intCast(c)) == STAGE_PRACTICE;
        }
        c = c + 1;
    }
    // the 9M model is live, but a live page does not stand in for a review
    assert LIVE[6];
    assert STATUS[6] == STATUS_DRAFT;
    // the board is live and was sourced, so it is the one published cell
    assert STATUS[20] == STATUS_PUBLISHED;
}

test the_compile_counts_are_the_measured_ones {
    // the IGLA CODER specs cell: grounded, none compiles, so it is a draft at 10 percent
    assert CODER_SPECS_COMPILING == 0;
    assert STATUS[5] == STATUS_DRAFT;
    assert TEST_PASS[5] == false;
    // the compile cell's percent is the measured share, truncated
    const share : i32 = share_pct(ML_SPECS_COMPILING, ML_SPECS_MEASURED);
    assert share == 35;
    const p22 : i32 = @intCast(PCT[22]);
    assert p22 == share;
    assert share_pct(CODER_SPECS_COMPILING, CODER_SPECS) == 0;
    assert CODER_SPECS <= ML_SPECS_MEASURED;
}

test percent_per_lens_is_a_plain_mean {
    assert mean_pct(0, 9) == 45;
    assert mean_pct(9, 9) == 51;
    assert mean_pct(18, 9) == 30;
    // the evidence slide's "about 42 percent overall"
    assert mean_pct(0, CELL_COUNT) == 42;
}

test the_camera_is_the_demo_camera {
    assert DEMO_COUNT == 5;
    // scene 1 shows lens 0, the row HEAD[1] calls "Steps 1-9"
    assert DEMO_LENS[1] == 0;
    // scenes 2 and 3 focus cell 10, which the focus slide calls "Step 11": the HSLM trainer
    assert DEMO_CELL[2] == 10;
    assert DEMO_CELL[3] == 10;
    assert step_number(DEMO_CELL[2]) == 11;
    assert STATUS[10] == STATUS_VERIFIED;
}

test every_slide_fits_every_preset {
    assert slides_fit(HEAD, ROWS);
    assert stage_slides_bare(ROWS);
}

invariant twenty_seven_parts {
    assert CELL_COUNT == 27;
}
