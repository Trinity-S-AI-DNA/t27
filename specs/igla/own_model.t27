pub fn step_number(cell: i32) -> i32 {
    return cell + 1;
}

/// part of whole, in whole percent, truncated.
pub fn share_pct(part: i32, whole: i32) -> i32 {
    return @divTrunc(part * 100, whole);
}

/// Mean PCT of cells [from, from+n), truncated: every cell weighs the same.
pub fn mean_pct(from: i32, n: i32) -> i32 {
    var sum : i32 = 0;
    var c : i32 = from;
    while (c < from + n) {
        const p : i32 = @intCast(PCT[@intCast(c)]);
        sum = sum + p;
        c = c + 1;
    }
    return @divTrunc(sum, n);
}

test the_domain_is_routed_not_chosen {
    assert DOMAIN == DOMAIN_ENGINEERING;
    assert keyword_hits(BRIEF, BRIEF.len, ENGINEERING_WORDS, ENGINEERING_WORDS.len) == 3;
    assert keyword_hits(BRIEF, BRIEF.len, CONTENT_WORDS, CONTENT_WORDS.len) == 0;
    assert keyword_hits(BRIEF, BRIEF.len, RESEARCH_WORDS, RESEARCH_WORDS.len) == 0;
    assert keyword_hits(BRIEF, BRIEF.len, SALES_WORDS, SALES_WORDS.len) == 0;
    assert route_brief(BRIEF, BRIEF.len) == DOMAIN;
}

test every_step_is_a_cell {
    assert CELL_COUNT == 27;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        assert TITLES[i].len > 0;
        var want : i32 = 1;
        if (step_number(c) >= 10) {
            want = 2;
        }
        const len : i32 = @intCast(LABELS[i].len);
        assert len == want;
        c = c + 1;
    }
    assert LENS_TITLES[2].len > 0;
}

test a_gap_is_named_not_filled {
    assert gaps_are_named(SOURCES, MISSING, GROUNDED);
    assert count_true(GROUNDED) == 26;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        // a gap is drawn as a gap, and only a gap is; a gap is a part that does not exist: 0 percent
        assert (STATUS[i] == STATUS_GAP) == (GROUNDED[i] == false);
        assert (GROUNDED[i] == false) == (PCT[i] == 0);
        assert PCT[i] <= 100;
        c = c + 1;
    }
}

test a_status_is_earned_not_chosen {
    assert statuses_earned(STATUS, DOMAIN, GROUNDED, TEST_PASS, REVIEWED, LIVE);
    // the evidence slide's "3 published, 22 verified, 1 draft" and "1 gap"
    assert count_status(STATUS, STATUS_PUBLISHED) == 3;
    assert count_status(STATUS, STATUS_VERIFIED) == 22;
    assert count_status(STATUS, STATUS_DRAFT) == 1;
    assert count_status(STATUS, STATUS_GAP) == 1;
    assert count_true(REVIEWED) == 7;
    // every passing test is a PRACTICE step: the t27 bench, MultiPL-E and coder specs (cells 4 to
    // 6), loss, optimizers, forward pass, matvec, the ML specs that compile (cell 23) and the
    // file I/O t27c lowers (cell 24)
    assert count_true(TEST_PASS) == 9;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        if (TEST_PASS[i]) {
            assert step_stage(@intCast(c)) == STAGE_PRACTICE;
        }
        c = c + 1;
    }
    // the 9M model is live and its evidence reviewed, so it is published
    assert LIVE[6];
    assert REVIEWED[6];
    assert STATUS[6] == STATUS_PUBLISHED;
    // and the same holds for the public 100M model (step 8)
    assert LIVE[7];
    assert REVIEWED[7];
    assert STATUS[7] == STATUS_PUBLISHED;
    assert STATUS[23] == STATUS_VERIFIED;
    // the slice training binary (step 25) is a reviewed DELIVER step that is not live: verified
    assert GROUNDED[24];
    assert REVIEWED[24];
    assert LIVE[24] == false;
    assert step_stage(24) == STAGE_DELIVER;
    assert STATUS[24] == STATUS_VERIFIED;
    // the board is live and was sourced: the third published cell
    assert STATUS[20] == STATUS_PUBLISHED;
}

test a_review_is_named_not_assumed {
    // REVIEWED is true exactly at the grounded DELIVER cells PR REVIEW_PR put to review: every
    // grounded DELIVER cell except step 26, whose evidence came in a PR with no review
    assert REVIEW_PR == 10275;
    assert REVIEW_ID.len > 0;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        var want : bool = false;
        if (step_stage(@intCast(c)) == STAGE_DELIVER and GROUNDED[i] and c != 25) {
            want = true;
        }
        assert REVIEWED[i] == want;
        c = c + 1;
    }
    // the gap, step 9, is a DELIVER step with nothing to review
    assert step_stage(8) == STAGE_DELIVER;
    assert GROUNDED[8] == false;
    assert REVIEWED[8] == false;
    // step 26 is grounded but not reviewed, so it stays a draft
    assert step_stage(25) == STAGE_DELIVER;
    assert GROUNDED[25];
    assert REVIEWED[25] == false;
    assert STATUS[25] == STATUS_DRAFT;
}

test the_compile_counts_are_the_measured_ones {
    // the IGLA CODER specs cell: grounded, all nine compile and pass, a PRACTICE step with a
    // passing test, so it is verified; its percent is the measured share of coder specs
    assert CODER_SPECS_COMPILING == CODER_SPECS;
    assert STATUS[5] == STATUS_VERIFIED;
    assert TEST_PASS[5];
    const p5 : i32 = @intCast(PCT[5]);
    assert p5 == share_pct(CODER_SPECS_COMPILING, CODER_SPECS);
    // the compile cell's percent is the measured share, truncated
    const share : i32 = share_pct(ML_SPECS_COMPILING, ML_SPECS_MEASURED);
    assert share == 100;
    const p22 : i32 = @intCast(PCT[22]);
    assert p22 == share;
    // the compiling ML specs are the nine coder specs plus the eight others
    assert ML_SPECS_COMPILING == CODER_SPECS_COMPILING + 8;
    assert ML_SPECS_COMPILING == ML_SPECS_MEASURED;
    assert STATUS[22] == STATUS_VERIFIED;
    assert CODER_SPECS <= ML_SPECS_MEASURED;
    // the two coder cells that carry numbers (bench, MultiPL-E) are verified by their spec's test
    assert TEST_PASS[3];
    assert TEST_PASS[4];
    assert STATUS[3] == STATUS_VERIFIED;
    assert STATUS[4] == STATUS_VERIFIED;
}

test percent_per_lens_is_a_plain_mean {
    assert mean_pct(0, 9) == 65;
    assert mean_pct(9, 9) == 70;
    assert mean_pct(18, 9) == 48;
    // the evidence slide's "about 61 percent overall"
    assert mean_pct(0, CELL_COUNT) == 61;
}

test the_training_step_cells_are_verified_once_reviewed {
    // steps 16-18 are DELIVER steps: their specs pass (see MEASURED) and the engine asks a review
    // for them; review REVIEW_ID approved it, and they are not live, so they are verified
    var c : i32 = 15;
    while (c < 18) {
        const i : usize = @intCast(c);
        assert GROUNDED[i];
        assert STATUS[i] == STATUS_VERIFIED;
        assert REVIEWED[i];
        assert LIVE[i] == false;
        assert step_stage(@intCast(c)) == STAGE_DELIVER;
        c = c + 1;
    }
}

test the_camera_is_the_demo_camera {
    assert DEMO_COUNT == 5;
    // scene 1 shows lens 0, the row HEAD[1] calls "Steps 1-9"
    assert DEMO_LENS[1] == 0;
    // scenes 2 and 3 focus cell 10, which the focus slide calls "Step 11": the HSLM trainer
    assert DEMO_CELL[2] == 10;
    assert DEMO_CELL[3] == 10;
    assert step_number(DEMO_CELL[2]) == 11;
    assert STATUS[10] == STATUS_VERIFIED;
}

test every_slide_fits_every_preset {
    assert slides_fit(HEAD, ROWS);
    assert stage_slides_bare(ROWS);
}

invariant twenty_seven_parts {
    assert CELL_COUNT == 27;
}
