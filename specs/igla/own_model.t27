/// Percent of each part that exists, estimated from its source (see the header). Never a status.
pub const PCT : [27]u8 = [60, 70, 80, 80, 60, 10, 50, 0, 0, 100, 100, 20, 80, 65, 60, 40, 0, 0, 70, 15, 60, 40, 35, 0, 0, 0, 50];

/// The t27c test-report counts the PRACTICE cells quote.
pub const ML_SPECS_MEASURED : i32 = 17;
pub const ML_SPECS_COMPILING : i32 = 6;
pub const CODER_SPECS : i32 = 9;
pub const CODER_SPECS_COMPILING : i32 = 0;

