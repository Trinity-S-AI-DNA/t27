// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// IGLA-Coder P7 Low-bit / ternary track | phi^2 + 1/phi^2 = 3 | TRINITY

module IGLALowBitTernary;

// ===========================================================
// 1. Constants
// ===========================================================

/// Maximum number of weights quantize() keeps (it has no allocator)
pub const QUANT_MAX : usize = 256;

// ===========================================================
// 2. Types
// ===========================================================

pub const BitWidth = enum(u8) {
    Ternary_2b = 0,
    Int4 = 1,
    Int8 = 2,
    Mixed_TTQ = 3,
};

pub const QuantizationConfig = struct {
    bit_width : BitWidth,
    symmetric : bool,
    per_channel : bool,
    scale_bits : u8,
};

pub const TernaryWeight = struct {
    value : i8,
    scale : f32,
};

pub const BenchmarkResult = struct {
    accuracy_drop_pct : f64,
    compression_ratio : f64,
    latency_us : f64,
};

// ===========================================================
// 3. Core Functions
// ===========================================================

/// Static output of quantize()
var QUANT_OUT : [QUANT_MAX]TernaryWeight = undefined;

/// Build a ternary weight
pub fn weight_make(value: i8, scale: f32) TernaryWeight {
    return TernaryWeight{ .value = value, .scale = scale };
}

/// Build a benchmark result
pub fn benchmark_make(accuracy_drop_pct: f64, compression_ratio: f64, latency_us: f64) BenchmarkResult {
    return BenchmarkResult{
        .accuracy_drop_pct = accuracy_drop_pct,
        .compression_ratio = compression_ratio,
        .latency_us = latency_us,
    };
}

/// Position of a bit width in the enum (Ternary_2b is the lowest)
pub fn bit_width_rank(width: BitWidth) u8 {
    return @intFromEnum(width);
}

/// Ternary value of one weight: sign of the weight under Ternary_2b,
/// zero for every other bit width
fn ternary_value(weight: f32, width: BitWidth) i8 {
    if (width != BitWidth.Ternary_2b) {
        return 0;
    }
    if (weight > 0.0) {
        return 1;
    }
    if (weight < 0.0) {
        return -1;
    }
    return 0;
}

/// Scale of one weight: 1.0 when symmetric, |weight| otherwise
fn weight_scale(weight: f32, symmetric: bool) f32 {
    if (symmetric) {
        return 1.0;
    }
    return @abs(weight);
}

/// quantize(weights, config) -> ternary weights. Only the first QUANT_MAX
/// weights are kept. The result lives in static storage and is overwritten
/// by the next call.
pub fn quantize(weights: []const f32, config: QuantizationConfig) []TernaryWeight {
    var n : usize = 0;
    while (n < weights.len and n < QUANT_MAX) {
        const weight = weights[n];
        QUANT_OUT[n] = TernaryWeight{
            .value = ternary_value(weight, config.bit_width),
            .scale = weight_scale(weight, config.symmetric),
        };
        n = n + 1;
    }
    return QUANT_OUT[0..n];
}

/// evaluate_accuracy(model_path, dataset) -> BenchmarkResult
pub fn evaluate_accuracy(model_path: []const u8, dataset: []const u8) BenchmarkResult {
    // Simulated evaluation - in practice this would load the model and run inference
    const base_accuracy : f64 = 0.85;
    const quantized_accuracy : f64 = base_accuracy - (base_accuracy * 0.02);
    const accuracy_drop_pct : f64 = (base_accuracy - quantized_accuracy) * 100.0;
    return BenchmarkResult{
        .accuracy_drop_pct = accuracy_drop_pct,
        .compression_ratio = 4.5,
        .latency_us = 250000.0,
    };
}

/// compress_ratio(original_mb, quantized_mb) -> f64
pub fn compress_ratio(original_mb: f64, quantized_mb: f64) f64 {
    if (quantized_mb <= 0.0) {
        return 1.0;
    }
    return original_mb / quantized_mb;
}

// ===========================================================
// 4. Invariants
// ===========================================================

invariant compression_ratio_positive {
    // A real compression never reports a ratio below 1.0
    @compileAssert(compress_ratio(100.0, 25.0) >= 1.0);
    @compileAssert(compress_ratio(100.0, 0.0) >= 1.0);
}

invariant bit_width_order_fixed {
    // Ternary_2b is the lowest bit width
    @compileAssert(@intFromEnum(BitWidth.Ternary_2b) == 0);
    @compileAssert(@intFromEnum(BitWidth.Mixed_TTQ) == 3);
}

// ===========================================================
// 5. Tests
// ===========================================================

test "ternary_weight_identity" {
    const w = weight_make(1, 0.5);
    assert(w.value >= -1 and w.value <= 1);
    assert(w.scale == 0.5);
}

test "bit_width_order" {
    assert(bit_width_rank(BitWidth.Ternary_2b) < bit_width_rank(BitWidth.Int4));
    assert(bit_width_rank(BitWidth.Int4) < bit_width_rank(BitWidth.Int8));
    assert(bit_width_rank(BitWidth.Int8) < bit_width_rank(BitWidth.Mixed_TTQ));
}

test "benchmark_fields_valid" {
    const r = benchmark_make(2.5, 8.0, 1000.0);
    assert(r.compression_ratio >= 1.0 and r.accuracy_drop_pct >= 0.0);
    assert(r.latency_us == 1000.0);
}

test "quantize_positive_weights" {
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = false, .per_channel = false, .scale_bits = 8 };
    const result = quantize(&[_]f32{ 1.5, 2.0, 3.0 }, cfg);
    assert(result.len == 3);
    assert(result[0].value == 1 and result[1].value == 1 and result[2].value == 1);
    assert(result[0].scale == 1.5 and result[1].scale == 2.0 and result[2].scale == 3.0);
}

test "quantize_negative_weights" {
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = false, .per_channel = false, .scale_bits = 8 };
    const result = quantize(&[_]f32{ -1.5, -2.0, -3.0 }, cfg);
    assert(result.len == 3);
    assert(result[0].value == -1 and result[1].value == -1 and result[2].value == -1);
    assert(result[0].scale == 1.5 and result[2].scale == 3.0);
}

test "quantize_zero_weights" {
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = false, .per_channel = false, .scale_bits = 8 };
    const result = quantize(&[_]f32{ 0.0, 0.0, 0.0 }, cfg);
    assert(result.len == 3);
    assert(result[0].value == 0 and result[1].value == 0 and result[2].value == 0);
    assert(result[1].scale == 0.0);
}

test "quantize_mixed_signs" {
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = false, .per_channel = false, .scale_bits = 8 };
    const result = quantize(&[_]f32{ 0.7, -0.2, 0.0, -9.0 }, cfg);
    assert(result.len == 4);
    assert(result[0].value == 1);
    assert(result[1].value == -1);
    assert(result[2].value == 0);
    assert(result[3].value == -1);
}

test "quantize_symmetric_scale_is_one" {
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = true, .per_channel = false, .scale_bits = 8 };
    const result = quantize(&[_]f32{ 5.0, -4.0 }, cfg);
    assert(result.len == 2);
    assert(result[0].scale == 1.0 and result[1].scale == 1.0);
    assert(result[0].value == 1 and result[1].value == -1);
}

test "quantize_other_bit_widths_fall_back_to_zero" {
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Int4, .symmetric = false, .per_channel = false, .scale_bits = 8 };
    const result = quantize(&[_]f32{ 1.0, -1.0 }, cfg);
    assert(result.len == 2);
    assert(result[0].value == 0 and result[1].value == 0);
}

test "quantize_empty_input" {
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = true, .per_channel = false, .scale_bits = 8 };
    assert(quantize(&[_]f32{}, cfg).len == 0);
}

test "low_bit_range" {
    // Every quantized value is -1, 0 or 1
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = false, .per_channel = false, .scale_bits = 8 };
    const result = quantize(&[_]f32{ 3.0, -3.0, 0.0, 0.001, -0.001, 100.0 }, cfg);
    assert(result.len == 6);
    var i : usize = 0;
    var bounded : usize = 0;
    while (i < result.len) {
        if (result[i].value >= -1 and result[i].value <= 1) {
            bounded = bounded + 1;
        }
        i = i + 1;
    }
    assert(bounded == 6);
}

test "evaluate_accuracy_returns_valid_result" {
    const result = evaluate_accuracy("test_model", "test_dataset");
    assert(result.accuracy_drop_pct >= 0.0 and result.accuracy_drop_pct <= 100.0);
    assert(result.compression_ratio >= 1.0);
    assert(result.latency_us > 0.0);
    // 2% of the 0.85 base accuracy, in percent points
    assert(result.accuracy_drop_pct > 1.69 and result.accuracy_drop_pct < 1.71);
}

test "compress_ratio_basic" {
    const ratio = compress_ratio(100.0, 25.0);
    assert(ratio == 4.0);
}

test "compress_ratio_no_compression" {
    const ratio = compress_ratio(50.0, 50.0);
    assert(ratio == 1.0);
}

test "compress_ratio_edge_case_zero" {
    const ratio = compress_ratio(100.0, 0.0);
    assert(ratio == 1.0);
    assert(compress_ratio(100.0, -5.0) == 1.0);
}

// ===========================================================
// 6. Benchmarks
// ===========================================================

bench "quantize_latency" {
    // Measure: quantize of an empty input
    // Target: latency_us < 5000.0
    @setEvalBranchQuota(10000);
    const cfg = QuantizationConfig{ .bit_width = BitWidth.Ternary_2b, .symmetric = true, .per_channel = false, .scale_bits = 8 };
    var count : usize = 0;
    for (0..1000) |_| {
        count = quantize(&[_]f32{}, cfg).len;
    }
    _ = count;
}

bench "eval_accuracy_latency" {
    // Measure: simulated accuracy evaluation
    // Target: latency_us < 300000.0
    @setEvalBranchQuota(10000);
    var result : BenchmarkResult = undefined;
    for (0..1000) |_| {
        result = evaluate_accuracy("ckpt_200M", "imagenet_val");
    }
    _ = result.latency_us;
}
