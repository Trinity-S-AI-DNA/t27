// SPDX-License-Identifier: Apache-2.0
; specs/igla/cl_loop.t27 -- the LAW of the continual-learning loop (ORDER IGLA_CODER_CL_SPIKE_V1,
; approved 2026-11-11). The loop: spec -> t27b build/test -> verdict -> LoRA update -> replay mix.
; Every decision the spike harness makes comes from this spec:
;   - which verdicts count as positive signal,
;   - the replay mix ratio (old : new) so old specs are not forgotten,
;   - the forgetting threshold: how many old-spec regressions abort the update,
;   - the LoRA update step scale and its cap,
;   - the CPU-hour cap of Wave 3 and the toy parameter cap.
; The generated TypeScript (t27b ts) is the executable artifact; the harness reads decisions from it.
; --
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module IglaClLoop;

/// Verdict codes from the oracle: 0 build failed, 1 build ok + test failed, 2 build ok + test passed.
pub const VERDICT_BUILD_FAIL : u32 = 0;
pub const VERDICT_TEST_FAIL : u32 = 1;
pub const VERDICT_PASS : u32 = 2;

/// Replay mix: per batch of 8 examples, 5 old (replay) and 3 new -- roughly 62/38, the phi-side mix
/// that keeps old specs dominant so new tasks cannot wash them out.
pub const REPLAY_BATCH : u32 = 8;
pub const REPLAY_OLD : u32 = 5;
pub const REPLAY_NEW : u32 = 3;

/// Forgetting threshold: an update aborts (adapter rolled back) if more than this many old specs
/// regress from PASS to a lower verdict on the held-out replay check.
pub const FORGETTING_THRESHOLD : u32 = 1;

/// LoRA update scale: the adapter delta step, and its cap (no step larger than the cap is applied).
pub const LORA_STEP : u32 = 16; // fixed-point, 1/256 units
pub const LORA_STEP_CAP : u32 = 64;

/// Wave 3 caps (approved by the owner, ORDER IGLA_CODER_CL_SPIKE_V1).
pub const CPU_HOURS_CAP : u32 = 4;
pub const TOY_PARAMS_CAP : u32 = 10; // in millions; the toy run must stay at or below 10M

// ----------------------------------------------------------------------------------------------------------
// Decisions.
// ----------------------------------------------------------------------------------------------------------

/// A verdict is positive training signal only when build and tests both passed.
pub fn verdict_is_positive(verdict: u32) -> bool {
    return verdict == VERDICT_PASS;
}

/// The replay ratio holds: old count + new count fills the batch, and old is the majority.
pub fn replay_mix_valid() -> bool {
    return (REPLAY_OLD + REPLAY_NEW == REPLAY_BATCH) and (REPLAY_OLD > REPLAY_NEW);
}

/// An update is accepted only when forgetting is at or under the threshold:
/// regressions counted on the held-out replay check.
pub fn update_accepted(regressions: u32) -> bool {
    return regressions <= FORGETTING_THRESHOLD;
}

/// Applies the law to a proposed adapter step: 0 stays 0, anything above the cap is clipped,
/// otherwise the step itself is taken.
pub fn applied_step(proposed: u32) -> u32 {
    if (proposed == 0) { return 0; }
    if (proposed > LORA_STEP_CAP) { return LORA_STEP_CAP; }
    return proposed;
}

/// One replay check over the held-out old specs: regressions counted by the caller from the
/// pass flags; the law decides acceptance.
pub fn replay_check_ok(regressions: u32) -> bool {
    return update_accepted(regressions);
}

/// The Wave 3 caps hold: the run is in-budget and at or under the toy parameter cap.
pub fn caps_ok(cpu_hours_used: u32, params_millions: u32) -> bool {
    if (cpu_hours_used > CPU_HOURS_CAP) { return false; }
    if (params_millions > TOY_PARAMS_CAP) { return false; }
    return true;
}

// ----------------------------------------------------------------------------------------------------------
// Tests (L4).
// ----------------------------------------------------------------------------------------------------------

test only_a_full_pass_is_positive_signal {
    assert verdict_is_positive(VERDICT_PASS);
    assert !verdict_is_positive(VERDICT_BUILD_FAIL);
    assert !verdict_is_positive(VERDICT_TEST_FAIL);
}

test the_replay_mix_is_fixed_and_old_dominates {
    assert replay_mix_valid();
    assert REPLAY_OLD == 5 and REPLAY_NEW == 3 and REPLAY_BATCH == 8;
}

test forgetting_threshold_aborts_an_update {
    assert update_accepted(0);
    assert update_accepted(FORGETTING_THRESHOLD);
    assert !update_accepted(FORGETTING_THRESHOLD + 1);
}

test adapter_steps_are_clipped_never_negative {
    assert applied_step(0) == 0;
    assert applied_step(LORA_STEP) == LORA_STEP;
    assert applied_step(1000) == LORA_STEP_CAP;
    assert applied_step(LORA_STEP_CAP) == LORA_STEP_CAP;
}

test replay_check_counts_regressions_across_old_specs {
    assert replay_check_ok(0); // no old spec regressed
    assert replay_check_ok(FORGETTING_THRESHOLD); // exactly at the threshold: accepted
    assert !replay_check_ok(FORGETTING_THRESHOLD + 1); // over: rolled back
}

test wave3_caps_hold {
    assert caps_ok(1, 5);
    assert caps_ok(CPU_HOURS_CAP, TOY_PARAMS_CAP);
    assert !caps_ok(CPU_HOURS_CAP + 1, 1);
    assert !caps_ok(1, TOY_PARAMS_CAP + 1);
}
