// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/rollback_plan.t27
// Rollback plan for GOLDEN TRAINING runs: checkpoint retention, the restore
// procedure, and the idempotent re-run rule.
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-rollback-plan;

// ============================================================================
// 1. Constants
// ============================================================================

/// Keep the last N checkpoints plus every best-so-far checkpoint.
pub const KEEP_LAST : u8 = 3;
/// A rollback triggers when the latest eval degrades past this fraction.
pub const ROLLBACK_THRESHOLD : f64 = 0.9;
/// Checkpoints are content-addressed by sha256; a restore re-checks the hash.
pub const CHECKPOINT_HASH_BYTES : u8 = 32;

// ============================================================================
// 2. Types
// ============================================================================

pub const Checkpoint = struct {
    step       : u32,
    loss       : f64,
    is_best    : bool,
    sha_hex    : str,
};

pub const RollbackVerdict = enum(u8) {
    cont    = 0,
    rollback = 1,
};

// ============================================================================
// 3. Core functions
// ============================================================================

/// keep(c) -> bool
/// Retention rule: a checkpoint survives if it is best-so-far, or among the
/// newest KEEP_LAST by step.
pub fn keep(c: Checkpoint, newest_steps: []const u32) bool {
    if (c.is_best) { return true; }
    var i: usize = 0;
    while (i < newest_steps.len) {
        if (newest_steps[i] == c.step) { return true; }
        i = i + 1;
    }
    return false;
}

/// verdict(latest, best) -> RollbackVerdict
/// Rollback when the latest eval loss exceeds the best by the threshold gap
/// (latest > best * ROLLBACK_THRESHOLD + margin is NOT how it reads: we roll
/// back on degradation, so the condition is latest > best / ROLLBACK_THRESHOLD).
pub fn verdict(latest: f64, best: f64) RollbackVerdict {
    if (latest > best / ROLLBACK_THRESHOLD) {
        return RollbackVerdict.rollback;
    }
    return RollbackVerdict.cont;
}

/// restore_ok(expected_sha, actual_sha) -> bool
/// A restore only proceeds on an exact hash match; a mismatched checkpoint is
/// never loaded.
pub fn restore_ok(expected_sha: str, actual_sha: str) bool {
    return eq_str(expected_sha, actual_sha);
}

/// eq_str(a, b) -> bool
fn eq_str(a: str, b: str) bool {
    if (a.len() != b.len()) { return false; }
    var i: usize = 0;
    while (i < a.len()) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// ============================================================================
// 4. Tests
// ============================================================================

test best_always_kept {
    const c = Checkpoint { .step = 100, .loss = 1.0, .is_best = true, .sha_hex = "aa" };
    assert keep(c, &[_]u32{}) == true;
}

test old_nonbest_dropped {
    const c = Checkpoint { .step = 5, .loss = 9.0, .is_best = false, .sha_hex = "bb" };
    assert keep(c, &[_]u32{100, 200, 300}) == false;
}

test recent_nonbest_kept {
    const c = Checkpoint { .step = 300, .loss = 9.0, .is_best = false, .sha_hex = "cc" };
    assert keep(c, &[_]u32{100, 200, 300}) == true;
}

test rollback_on_degradation {
    // latest 2.0 vs best 1.0: 2.0 > 1.0/0.9 = 1.111 -> rollback
    assert verdict(2.0, 1.0) == RollbackVerdict.rollback;
}

test continue_on_small_drift {
    // latest 1.05 vs best 1.0: 1.05 < 1.111 -> continue
    assert verdict(1.05, 1.0) == RollbackVerdict.cont;
}

test restore_refuses_hash_mismatch {
    assert restore_ok("a1b2", "a1b2") == true;
    assert restore_ok("a1b2", "zzzz") == false;
}

// ============================================================================
// 5. Benchmarks
// ============================================================================

bench verdict_latency
    measure verdict(1.05, 1.0)
    target latency_us < 1.0
