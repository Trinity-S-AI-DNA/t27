// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/p4_budget.t27
// P4 pilot budget arithmetic for GOLDEN TRAINING (planning-grade).
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// Inputs and their provenance:
// - MEASURED_HOURS_100M = 19.74 h: the real tern100m pair on an RTX 4090,
//   recorded in specs/igla/coder/preflight.t27 (measured 2026-10-18).
// - SPEED_DERATE = 0.95: the preflight derate of smoke-run speed.
// - Price per hour is an OWNER INPUT, not measured here. No live market
//   quote is recorded in this repository; scenario prices in docs are
//   examples and say so.
//
// What is assumed, named so nobody reads it as measured:
// - Linear scaling of hours with model scale at a fixed token budget is a
//   planning assumption, not a measurement.
// - The pilot token budget is assumed to match the 100m reference pair.

module igla-coder-p4-budget;

pub const MEASURED_HOURS_100M : f64 = 19.74;
pub const SPEED_DERATE : f64 = 0.95;

/// pilot_hours(scale) -> f64
/// Wall-clock hours for a pilot at `scale` times the 100m reference size,
/// derated the way preflight derates smoke-run speed.
pub fn pilot_hours(scale: f64) -> f64 {
    return MEASURED_HOURS_100M * scale / SPEED_DERATE;
}

/// pilot_cost(hours, price_per_h) -> f64
/// Dollars for `hours` at `price_per_h`. The price is supplied by the caller.
pub fn pilot_cost(hours: f64, price_per_h: f64) -> f64 {
    return hours * price_per_h;
}

test derated_hours_at_reference_scale {
    let h = pilot_hours(1.0);
    // 19.74 / 0.95 = 20.7789...; tolerance compare (L5: no exact f64 ==)
    assert h > 20.7 and h < 20.9;
}

test hours_scale_linearly {
    let h1 = pilot_hours(1.0);
    let h2 = pilot_hours(2.0);
    assert h2 > 2.0 * h1 - 0.001 and h2 < 2.0 * h1 + 0.001;
}

test cost_is_linear {
    let c = pilot_cost(10.0, 2.0);
    assert c > 19.999 and c < 20.001;
}

test cost_zero_price_is_zero {
    let c = pilot_cost(100.0, 0.0);
    assert c > -0.0001 and c < 0.0001;
}

bench pilot_hours_reference
    measure pilot_hours(1.0)
    target latency_ms < 1.0
