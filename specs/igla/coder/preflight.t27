// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/preflight.t27
// IGLA-Coder pre-flight: decide GO or REFUSE before a training run is launched
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// Why this exists. The training kernels (PyTorch) stay Python because t27c has no
// GPU backend, but the decisions around a run -- launch, kill, resume -- are plain
// logic and live in .t27. A 2026-10-18 read-only study of the igla-coder-gpu
// pipeline ranked two rules as the real savings on a 500M run: a pre-flight check
// (up to $80 insured) and a kill rule (kill_rule.t27, $8-15 expected).
//
// What it checks, in this order (first failure wins, so the code is stable):
//   6  input is not a usable number (non-finite, zero or negative where it must not be)
//   3  batch_tokens is not a multiple of micro * seq_len   (train.py: seqs % micro)
//   4  d_model is not a multiple of n_head
//   5  n_head is not a multiple of n_kv_head
//   1  the run would reach the queue timeout (runq.py timeout_h, default 24)
//   2  the run would cost more than the budget cap
// 0 is GO.
//
// The speed comes from the 60-step smoke run (queues.smoke). A smoke run is a
// little faster than the full run, so the planned speed is derated: the real
// tern100m pair on an RTX 4090 ran 19.74 h against 19.49 h predicted from the
// smoke speed (1.3 % slower); SPEED_DERATE = 0.95 leaves room for that and for
// the eval passes.
//
// The python glue calls preflight() and prints the code; it holds no logic.

module igla-coder-preflight;
use base::types;

// ============================================================================
// 1. Codes and constants
// ============================================================================

pub const GO              : i32 = 0;
pub const REFUSE_TIMEOUT  : i32 = 1;
pub const REFUSE_CAP      : i32 = 2;
pub const REFUSE_BATCH    : i32 = 3;
pub const REFUSE_HEADS    : i32 = 4;
pub const REFUSE_KV_HEADS : i32 = 5;
pub const REFUSE_INPUT    : i32 = 6;

// Planned speed is this fraction of the smoke-run speed.
pub const SPEED_DERATE    : f64 = 0.95;
pub const SECONDS_PER_HOUR: f64 = 3600.0;

// ============================================================================
// 2. Helpers
// ============================================================================

// NaN is the one value not equal to itself; inf - inf is NaN
fn is_finite(x: f64) -> bool {
    return x == x and (x - x) == (x - x);
}

// a / b at run time, where IEEE gives NaN for 0 / 0 and inf for 1 / 0
fn ratio(a: f64, b: f64) -> f64 {
    return a / b;
}

// Wall-clock hours for `tokens` at the smoke speed tok_s, derated.
pub fn planned_hours(tokens: f64, tok_s: f64) -> f64 {
    return tokens / (tok_s * SPEED_DERATE) / SECONDS_PER_HOUR;
}

// Dollars for those hours at price_h dollars per hour.
pub fn planned_cost(tokens: f64, tok_s: f64, price_h: f64) -> f64 {
    return planned_hours(tokens, tok_s) * price_h;
}

fn inputs_ok(tokens: f64, tok_s: f64, timeout_h: f64, price_h: f64, cap_usd: f64,
             micro: i64, seq_len: i64, n_head: i64, n_kv_head: i64) -> bool {
    if (!is_finite(tokens) or !is_finite(tok_s) or !is_finite(timeout_h) or !is_finite(price_h) or !is_finite(cap_usd)) {
        return false;
    }
    if (!(tokens > 0.0) or !(tok_s > 0.0) or !(timeout_h > 0.0) or !(cap_usd > 0.0) or price_h < 0.0) {
        return false;
    }
    return micro > 0 and seq_len > 0 and n_head > 0 and n_kv_head > 0;
}

// ============================================================================
// 3. The decision
// ============================================================================

pub fn preflight(tokens: f64, tok_s: f64, timeout_h: f64, price_h: f64, cap_usd: f64,
                 batch_tokens: i64, micro: i64, seq_len: i64,
                 d_model: i64, n_head: i64, n_kv_head: i64) -> i32 {
    if (!inputs_ok(tokens, tok_s, timeout_h, price_h, cap_usd, micro, seq_len, n_head, n_kv_head)) {
        return REFUSE_INPUT;
    }
    if (batch_tokens <= 0 or batch_tokens % (micro * seq_len) != 0) {
        return REFUSE_BATCH;
    }
    if (d_model <= 0 or d_model % n_head != 0) {
        return REFUSE_HEADS;
    }
    if (n_head % n_kv_head != 0) {
        return REFUSE_KV_HEADS;
    }
    // A run that ends exactly at the timeout is killed by it: refuse on >=.
    if (planned_hours(tokens, tok_s) >= timeout_h) {
        return REFUSE_TIMEOUT;
    }
    if (planned_cost(tokens, tok_s, price_h) > cap_usd) {
        return REFUSE_CAP;
    }
    return GO;
}

// The 100m ternary shape of train.py / model.py, for the tests:
// seq 2048, batch 524288, micro 64, d_model 768, 12 heads, 4 kv heads.
fn tern100m(tokens: f64, tok_s: f64, timeout_h: f64, price_h: f64, cap_usd: f64) -> i32 {
    return preflight(tokens, tok_s, timeout_h, price_h, cap_usd, 524288, 64, 2048, 768, 12, 4);
}

// ============================================================================
// 4. Tests -- real numbers from igla-coder-gpu README.md and results/
// ============================================================================

// tern100m, 10B tokens (9,999,745,024 as trained), H100 SXM 457,172 tok/s, $3.49/h:
// 6.40 h derated, $22.3. The queue allows 24 h, the budget 50 USD.
test go_tern100m_h100
    given code = tern100m(9999745024.0, 457172.0, 24.0, 3.49, 50.0)
    when hours = planned_hours(9999745024.0, 457172.0)
    then code == 0 and hours > 6.3 and hours < 6.5 and planned_cost(9999745024.0, 457172.0, 3.49) < 23.0

// The same run on an RTX 4090 at 142,550 tok/s, $0.74/h: 20.5 h predicted. It really
// ran 19.74 h (results/tern100m_pair/summary.json), so the derate is conservative.
test go_tern100m_rtx4090_prediction_covers_the_real_run
    given code = tern100m(9999745024.0, 142550.0, 24.0, 0.74, 50.0)
    when hours = planned_hours(9999745024.0, 142550.0)
    then code == 0 and hours > 19.74 and hours < 21.0

// A 500M-class plan: the 100m speed divided by the 5x flops. The 500m rate is
// scaled, not measured. 32 h does not fit the 24 h queue timeout.
test refuse_500m_class_plan_hits_the_timeout
    given code = tern100m(9999745024.0, 91434.0, 24.0, 3.49, 200.0)
    when hours = planned_hours(9999745024.0, 91434.0)
    then code == 1 and hours > 31.0 and hours < 33.0

// With a 36 h timeout the same plan fits the clock but costs about 112 USD, over an
// 80 USD cap.
test refuse_500m_class_plan_hits_the_cap
    given code = tern100m(9999745024.0, 91434.0, 36.0, 3.49, 80.0)
    when cost = planned_cost(9999745024.0, 91434.0, 3.49)
    then code == 2 and cost > 110.0 and cost < 114.0

// Timeout is checked before the cap, so a run over both reports the timeout.
test refuse_timeout_wins_over_cap
    given code = tern100m(9999745024.0, 91434.0, 24.0, 3.49, 10.0)
    then code == 1

// The 4090 run under a 15 USD cap: 20.5 h * 0.74 = 15.2 USD, refused on the cap only.
test refuse_cap_alone
    given code = tern100m(9999745024.0, 142550.0, 24.0, 0.74, 15.0)
    then code == 2

// Equal to the cap is allowed; equal to the timeout is not.
test boundaries
    given at_cap = tern100m(9999745024.0, 142550.0, 24.0, 0.74, 15.2)
    when at_timeout = tern100m(9999745024.0, 142550.0, 20.511, 0.74, 50.0)
    then at_cap != 2 and at_timeout == 1

// Shape checks. 100m: batch 524288 = 256 sequences of 2048, micro 64 divides it.
test shape_batch_not_a_multiple
    given a = preflight(9999745024.0, 457172.0, 24.0, 3.49, 50.0, 500000, 64, 2048, 768, 12, 4)
    when b = preflight(9999745024.0, 457172.0, 24.0, 3.49, 50.0, 524288, 96, 2048, 768, 12, 4)
    then a == 3 and b == 3

test shape_d_model_not_a_multiple_of_heads
    given code = preflight(9999745024.0, 457172.0, 24.0, 3.49, 50.0, 524288, 64, 2048, 770, 12, 4)
    then code == 4

test shape_heads_not_a_multiple_of_kv_heads
    given code = preflight(9999745024.0, 457172.0, 24.0, 3.49, 50.0, 524288, 64, 2048, 768, 12, 5)
    then code == 5

// The other real shapes of model.py: 25m (384, 6 heads, 2 kv) at batch 262144, micro 64;
// 13m (256, 4, 2) and 52m (512, 8, 4) at the 524288 batch.
test go_the_other_ladder_shapes
    given m25 = preflight(500000000.0, 1425322.0, 24.0, 3.49, 50.0, 262144, 64, 2048, 384, 6, 2)
    when m13 = preflight(250000000.0, 1425322.0, 24.0, 3.49, 50.0, 524288, 64, 2048, 256, 4, 2)
    then m25 == 0 and m13 == 0 and preflight(1000000000.0, 1000000.0, 24.0, 3.49, 50.0, 524288, 64, 2048, 512, 8, 4) == 0

// Garbage in is refused, not computed: a zero speed would divide by zero.
test refuse_unusable_inputs
    given zero_speed = tern100m(9999745024.0, 0.0, 24.0, 3.49, 50.0)
    when nan_speed = tern100m(9999745024.0, ratio(0.0, 0.0), 24.0, 3.49, 50.0)
    then zero_speed == 6 and nan_speed == 6 and tern100m(9999745024.0, ratio(1.0, 0.0), 24.0, 3.49, 50.0) == 6 and tern100m(0.0, 457172.0, 24.0, 3.49, 50.0) == 6 and tern100m(9999745024.0, 457172.0, 24.0, 3.49, 0.0) == 6

// A zero head count must be refused before it can divide.
test refuse_zero_heads
    given code = preflight(9999745024.0, 457172.0, 24.0, 3.49, 50.0, 524288, 64, 2048, 768, 0, 4)
    then code == 6

invariant preflight_derate_is_a_fraction
    assert SPEED_DERATE > 0.0 and SPEED_DERATE <= 1.0

invariant preflight_codes_are_distinct
    assert GO == 0 and REFUSE_TIMEOUT != REFUSE_CAP and REFUSE_BATCH != REFUSE_HEADS and REFUSE_HEADS != REFUSE_KV_HEADS and REFUSE_INPUT == 6
