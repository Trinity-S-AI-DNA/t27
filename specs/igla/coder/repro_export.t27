// t27/specs/igla/coder/repro_export.t27
// Repro for blocker #8972: state-bearing / slice-taking pub fns not exported.
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-repro-export;

pub fn all_nonneg(data : []f64) -> bool {
    var i : usize = 0;
    while (i < data.len) {
        if (data[i] < 0.0) { return false; }
        i = i + 1;
    }
    return true;
}

test all_nonneg_true {
    var d : [4]f64 = [1.0, 2.0, 3.0, 4.0];
    assert all_nonneg(&d);
}

test all_nonneg_false {
    var d : [4]f64 = [1.0, -2.0, 3.0, 4.0];
    assert !all_nonneg(&d);
}
