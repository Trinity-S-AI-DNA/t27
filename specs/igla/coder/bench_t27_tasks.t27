// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/bench_t27_tasks.t27
// DESIGN DRAFT (pre-registered, not yet populated): a closed benchmark of
// short T27 code-completion tasks for the IGLA CODER pilot line.
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// Scope (one task type only): given the text of a real .t27 spec up to a
// short function's opening brace, the candidate supplies the body; the task
// is graded by (a) t27b compile and (b) the module's OWN test block passing.
// Nothing here runs a model; this spec defines the tasks, the metric rows and
// the pre-registered success bar. Tasks come ONLY from dataset v0.3-real
// val/test files (disjoint from every train pair), so a model trained on the
// train split cannot have seen a benchmark target.

module igla-coder-bench-t27-tasks;

// ============================================================================
// 1. Task schema
// ============================================================================

pub const TaskDef = struct {
    task_id       : str,   // stable hash of (source_rel, fn name)
    source_rel    : str,   // provenance: the .t27 file the task was cut from
    split_origin  : str,   // must be "val" or "test" - never "train"
    fn_name       : str,
    max_new_bytes : u32,
    time_limit_ms : u32,
};

pub const MetricRow = struct {
    task_id      : str,
    model        : str,   // "baseline-copy" | "baseline-empty" | "ckpt-<sha8>" | "untrained"
    syntax_ok    : bool,  // t27b compile of the restored module
    tests_pass   : bool,  // the module's own test block, 0 vacuous
    first_try    : bool,  // headline metric: single sample, no resampling
    latency_ms   : u32,
    retries_used : u8,
};

// ============================================================================
// 2. Pre-registered rules (fixed before any model sees the tasks)
// ============================================================================

pub const RETRIES_IN_HEADLINE : u8 = 0;
pub const MAX_TASKS_FIRST_WAVE : u32 = 100;
pub const MIN_TASKS_FIRST_WAVE : u32 = 50;
pub const BASELINES_REQUIRED   : u8 = 2;  // baseline-empty + baseline-copy, both mandatory
pub const BASELINE_EMPTY       : str = "baseline-empty";
pub const BASELINE_COPY        : str = "baseline-copy";

/// headline_is_single_sample(row) -> bool
/// The headline tests_pass number counts first_try rows only.
pub fn headline_is_single_sample(row: MetricRow) bool {
    return row.first_try and row.retries_used == RETRIES_IN_HEADLINE;
}

/// task_is_legal(t, train_ids) -> bool
/// A task may only be graded if its provenance file is disjoint from train.
pub fn task_is_legal(t: TaskDef, train_ids: []const str) bool {
    if (neq(t.split_origin, "val") and neq(t.split_origin, "test")) {
        return false;
    }
    var i: usize = 0;
    while (i < train_ids.len) {
        if (eq(t.source_rel, train_ids[i])) { return false; }
        i = i + 1;
    }
    return true;
}

fn eq(a: str, b: str) bool { return a.len() == b.len(); } // placeholder eq
fn neq(a: str, b: str) bool { return a.len() != b.len(); }

// ============================================================================
// 3. Tests
// ============================================================================

test headline_is_first_try_only {
    const r = MetricRow { .task_id = "t", .model = "x", .syntax_ok = true,
        .tests_pass = true, .first_try = true, .latency_ms = 5, .retries_used = 0 };
    assert headline_is_single_sample(r) == true;
}

test retried_row_is_not_headline {
    const r = MetricRow { .task_id = "t", .model = "x", .syntax_ok = true,
        .tests_pass = true, .first_try = false, .latency_ms = 5, .retries_used = 2 };
    assert headline_is_single_sample(r) == false;
}

test task_from_train_split_is_illegal {
    const t = TaskDef { .task_id = "t", .source_rel = "a/b.t27",
        .split_origin = "train", .fn_name = "f", .max_new_bytes = 200,
        .time_limit_ms = 1000 };
    assert task_is_legal(t, &[_]str{"a/b.t27"}) == false;
}

test task_from_test_split_is_legal {
    const t = TaskDef { .task_id = "t", .source_rel = "a/b.t27",
        .split_origin = "test", .fn_name = "f", .max_new_bytes = 200,
        .time_limit_ms = 1000 };
    assert task_is_legal(t, &[_]str{"other/c.t27"}) == true;
}

test wave_size_bounded {
    assert MIN_TASKS_FIRST_WAVE >= 50;
    assert MAX_TASKS_FIRST_WAVE <= 100;
}
