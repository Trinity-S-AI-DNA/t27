// SPDX-License-Identifier: Apache-2.0
; specs/igla/coder/ternary_gemm_ptx.t27 -- the PTX text of the ternary x int8 GEMM kernel, written by t27.
; Issue #10404, plan #10360. Owner override 2026-10-18: build the backend, and build it in t27.
; --
; What this is. specs/igla/coder/ternary_gemm_gpu.t27 pins the math of a tiled ternary x int8 GEMM and
; checks it bit-exactly on two compilers. This spec is its GPU lowering: emit_ptx() writes the PTX of
; one kernel, `ternary_gemm_s8`, for int8 tensor cores (mma.sync m16n8k32 s8 x s8 -> s32, sm_80 and
; later; the RTX 4090 is sm_89). `t27c compile specs/igla/coder/ternary_gemm_gpu.t27 --backend ptx`
; writes this text; `t27c gen-rust` lowers this spec into bootstrap/gen/rust/igla/coder/ and Rust
; only copies the bytes to a file or to the CUDA driver.
; The honest limit: this is a kernel-specific emitter, not a general t27 -> PTX lowering. It writes
; exactly one kernel, and t27c refuses `--backend ptx` for every other spec.
; --
; Why int8 tensor cores and not dp4a. On the RTX 4090 bench of #10360 (CUTLASS 3.5.1, one pod),
; int8 tensor cores ran 2.9-3.5x bf16 and dp4a ran 0.91-0.94x bf16; only the mma path can win.
; --
; The kernel, v2 (v1 was the first kernel that ran; v2 is the first that is meant to be fast).
;   C[m][n] = sum_k A[m][k] * w(k, n); A is i8 row-major (m x k); W is the k x n code matrix of
;   ternary_gemm_gpu.t27, row-major, four 2-bit codes per byte, code i at byte i/4, lane i%4, lane 0
;   in the low bits; C is i32 row-major (m x n).
;   Grid (ceil(n/128), ceil(m/128)), 256 threads. Each block computes a 128 x 128 tile of C in k-tiles
;   of 64, two stages of shared memory, ONE bar.sync per k-tile. Per k-tile:
;     - A tile: 128 rows x 64 bytes arrives by cp.async.cg (16 bytes, src-size 0 zero-fills past m
;       and past k) straight into sA at row * 80 + chunk; thread t issues rows t/4 and t/4 + 64,
;       bytes (t%4)*16; cp.async.wait_group 0 at the top of the next k-tile;
;     - W tile: 64 k-rows x 128 columns. The four k-rows 4q..4q+3 of eight columns are four
;       halfwords (8 codes each) that thread t loads into registers one tile ahead (q = t/16,
;       columns (t%16)*8). After the mma of the current tile it decodes them with prmt (a 4-entry
;       table in a register turns four 2-bit codes at once into four s8, 0 -> 0, 1 -> +1, 2 -> -1,
;       3 -> 0 = (c & 1) - ((c >> 1) & 1)), transposes the 4 x 4 bytes with 8 prmt so that each
;       column has its four k as one word, and stores 8 words into the other stage of sB at
;       column * 80 + k ("col" operand of the mma);
;     - warp v = t/32 owns the 64 x 32 sub-tile at rows (v/4)*64, columns (v%4)*32: 4 x 4 mma tiles
;       of 16 x 8, so 2 x 16 mma.sync per k-tile and 64 i32 accumulators per thread.
;   The 80-byte row stride (64 data bytes + 16 pad) puts the 32 lanes of every fragment load on 32
;   distinct banks: lane (g, t) reads word 20g + t, and 20g mod 32 for g = 0..7 is 0,20,8,28,16,4,24,12.
;   The W stores would hit one bank 16 times (lanes of a warp write 16 columns of one k-word), so the
;   eight columns of a group are stored rotated: logical column c of group q lives at row
;   8q + ((c + q) & 7), and the B fragment loads apply the same rotation; the loads stay conflict
;   free (g -> (g + q) & 7 is a permutation) and the stores drop to a 2-way conflict.
;   Fragment layouts are the PTX ISA's for m16n8k32 .s8 (g = lane/4, t = lane%4):
;     A: a0 = row g, k 4t..4t+3; a1 = row g+8; a2 = row g, k 16+4t..; a3 = row g+8, k 16+4t..
;     B: b0 = column g, k 4t..4t+3; b1 = column g, k 16+4t..
;     C: c0, c1 = row g, columns 2t, 2t+1; c2, c3 = row g+8, same columns.
;   Block pipeline: the barrier at the top of tile i guarantees that tile i is complete in shared
;   memory and that every warp has finished the mma of tile i-1, so the other stage is free; the
;   fetch of tile i+1 (cp.async + W registers) is issued before the mma of tile i and the W decode
;   after it, which hides the global latency behind 32 mma per warp.
; Preconditions, checked by shape_ok() before a launch: n and k are multiples of 16 (aligned 16-byte
; A loads and 4-byte W loads; a k chunk or a 16-column W word is then either wholly inside or wholly
; outside), 1 <= m, and k <= K_MAX_I32 so that no i32 partial sum can overflow.
; --
; The host side lives here too, so that the bit-exact check is t27 as well: gen_a, gen_wp (the data),
; ref_row (the CPU reference, one output row at a time) and mismatches (the count the run reports).
; Bit-exact is valid for the reason ternary_gemm_gpu.t27 states: every product is in [-128, 128], the
; sum is i32 and cannot overflow while k <= K_MAX_I32, so integer addition is associative and any
; order of the k-sum gives the same bits.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-ternary-gemm-ptx;

/// The kernel's entry name, the one cuModuleGetFunction looks up.
pub const KERNEL_NAME : str = "ternary_gemm_s8";
/// Block tile and k-step of the kernel, and its thread count.
pub const BM : u32 = 128;
pub const BN : u32 = 128;
pub const BK : u32 = 64;
pub const THREADS : u32 = 256;
/// Bytes per row of a shared tile: 64 data bytes and 16 bytes of padding.
pub const SMEM_STRIDE : u32 = 80;
/// Shared-memory stages of the pipeline, and the bytes of one stage of one operand.
pub const STAGES : u32 = 2;
pub const STAGE_BYTES : u32 = 10240;
/// mma.sync instructions per 32-wide k-step: 4 x 4 tiles of 16 x 8 per warp.
pub const MMA_PER_STEP : u32 = 16;
/// Largest k for which no i32 partial sum can overflow: 128 * 16777215 = 2147483520.
pub const K_MAX_I32 : usize = 16777215;
/// Largest grid y the driver accepts.
pub const GRID_Y_MAX : usize = 65535;
/// Buffer the emitted text needs, with room to spare; emit_ptx returns the exact length.
pub const PTX_CAP : usize = 65536;
/// tern-tc-500m: d_model and d_ff (read from the trainer config, see #10360).
pub const D_MODEL_500M : usize = 1280;
pub const D_FF_500M : usize = 4096;

// ============================================================================
// 1. A bounded text writer
// ============================================================================

/// Write s at out[w..]; bytes past cap are counted but not written. Returns the new end.
fn put_s(out : []u8, cap : usize, w : usize, s : str) -> usize {
    var i : usize = 0;
    while (i < s.len) {
        if (w + i < cap) { out[w + i] = s[i]; }
        i += 1;
    }
    return w + s.len;
}

/// Write v in decimal at out[w..], bounded by cap like put_s.
fn put_u(out : []u8, cap : usize, w : usize, v : u32) -> usize {
    var d : u32 = 1;
    while (v / d >= 10) { d = d * 10; }
    var x : usize = w;
    while (d > 0) {
        const c : u8 = '0' + (((v / d) % 10) as u8);
        if (x < cap) { out[x] = c; }
        x += 1;
        d = d / 10;
    }
    return x;
}

/// One indented instruction line that has no operand to fill in.
fn ins(out : []u8, cap : usize, w : usize, s : str) -> usize {
    // One writer call per statement: a nested call would borrow `out` twice in the Rust that gen-rust writes.
    var x : usize = put_s(out, cap, w, "    ");
    x = put_s(out, cap, x, s);
    return put_s(out, cap, x, "\n");
}

/// "{%name<i>, %name<i+1>, %name<i+2>, %name<i+3>}"
fn put_quad(out : []u8, cap : usize, w : usize, name : str, first : u32) -> usize {
    var x : usize = put_s(out, cap, w, "{");
    var j : u32 = 0;
    while (j < 4) {
        if (j > 0) { x = put_s(out, cap, x, ", "); }
        x = put_s(out, cap, x, name);
        x = put_u(out, cap, x, first + j);
        j += 1;
    }
    return put_s(out, cap, x, "}");
}

// ============================================================================
// 2. The kernel, section by section
// ============================================================================

/// "    <pre><n><post>\n": one instruction line with one number to fill in.
fn ins_u(out : []u8, cap : usize, w : usize, pre : str, n : u32, post : str) -> usize {
    var x : usize = put_s(out, cap, w, "    ");
    x = put_s(out, cap, x, pre);
    x = put_u(out, cap, x, n);
    x = put_s(out, cap, x, post);
    return put_s(out, cap, x, "\n");
}

/// "    <pre><a><mid><b><post>\n": one instruction line with two numbers to fill in.
fn ins_uu(out : []u8, cap : usize, w : usize, pre : str, a : u32, mid : str, b : u32, post : str) -> usize {
    var x : usize = put_s(out, cap, w, "    ");
    x = put_s(out, cap, x, pre);
    x = put_u(out, cap, x, a);
    x = put_s(out, cap, x, mid);
    x = put_u(out, cap, x, b);
    x = put_s(out, cap, x, post);
    return put_s(out, cap, x, "\n");
}

fn emit_header(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = put_s(out, cap, w, "// ternary_gemm_s8 -- emitted by t27c from specs/igla/coder/ternary_gemm_ptx.t27 (#10404). Do not edit.\n");
    x = put_s(out, cap, x, ".version 7.0\n.target sm_80\n.address_size 64\n\n");
    x = put_s(out, cap, x, ".visible .entry ternary_gemm_s8(\n");
    x = put_s(out, cap, x, "    .param .u64 p_a,\n    .param .u64 p_w,\n    .param .u64 p_c,\n");
    x = put_s(out, cap, x, "    .param .u32 p_m,\n    .param .u32 p_n,\n    .param .u32 p_k\n)\n");
    x = put_s(out, cap, x, ".maxntid 256, 1, 1\n.minnctapersm 2\n{\n");
    x = ins(out, cap, x, ".reg .pred %p<12>;");
    x = ins(out, cap, x, ".reg .b32 %r<72>;");
    x = ins(out, cap, x, ".reg .b32 %acc<64>;");
    x = ins(out, cap, x, ".reg .b32 %fa<16>;");
    x = ins(out, cap, x, ".reg .b32 %fb<8>;");
    x = ins(out, cap, x, ".reg .b64 %rd<16>;");
    x = ins(out, cap, x, ".shared .align 16 .b8 sA[20480];");
    x = ins(out, cap, x, ".shared .align 16 .b8 sB[20480];");
    return x;
}

/// Parameters, thread coordinates, and the addresses each thread reuses every k-tile.
/// Register map (all %r): 1 m, 2 n, 3 k, 4 tid; A loader 8 chunk byte, 12 cp.async destination,
/// rd4/rd5 the two source pointers; W loader 16 column group, 17 4 x k-group, 20 sB store base,
/// rd6 the source pointer, rd7 = n/4, rd8 = 61 n/4; 22..25 the four prefetched W halfwords;
/// 32 the A fragment base, 33..36 the four B fragment bases; 37 k0; 39 stage delta; 40 prmt table.
fn emit_prologue(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = ins(out, cap, w, "ld.param.u64 %rd1, [p_a];");
    x = ins(out, cap, x, "ld.param.u64 %rd2, [p_w];");
    x = ins(out, cap, x, "ld.param.u64 %rd3, [p_c];");
    x = ins(out, cap, x, "ld.param.u32 %r1, [p_m];");
    x = ins(out, cap, x, "ld.param.u32 %r2, [p_n];");
    x = ins(out, cap, x, "ld.param.u32 %r3, [p_k];");
    x = ins(out, cap, x, "cvta.to.global.u64 %rd1, %rd1;");
    x = ins(out, cap, x, "cvta.to.global.u64 %rd2, %rd2;");
    x = ins(out, cap, x, "cvta.to.global.u64 %rd3, %rd3;");
    x = ins(out, cap, x, "mov.u32 %r4, %tid.x;");
    x = ins(out, cap, x, "mov.u32 %r5, %ctaid.x;");
    x = ins(out, cap, x, "mov.u32 %r6, %ctaid.y;");
    // A loader: rows r7 = tid/4 and r7 + 64, chunk byte r8 = (tid%4)*16; p1, p2 = rows inside m.
    x = ins(out, cap, x, "shr.u32 %r7, %r4, 2;");
    x = ins(out, cap, x, "and.b32 %r8, %r4, 3;");
    x = ins(out, cap, x, "shl.b32 %r8, %r8, 4;");
    x = ins(out, cap, x, "shl.b32 %r9, %r6, 7;");
    x = ins(out, cap, x, "add.u32 %r9, %r9, %r7;");
    x = ins(out, cap, x, "add.u32 %r10, %r9, 64;");
    x = ins(out, cap, x, "setp.lt.u32 %p1, %r9, %r1;");
    x = ins(out, cap, x, "setp.lt.u32 %p2, %r10, %r1;");
    x = ins(out, cap, x, "mov.u32 %r11, sA;");
    x = ins(out, cap, x, "mad.lo.u32 %r12, %r7, 80, %r8;");
    x = ins(out, cap, x, "add.u32 %r12, %r12, %r11;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd9, %r8;");
    x = ins(out, cap, x, "mul.wide.u32 %rd4, %r9, %r3;");
    x = ins(out, cap, x, "add.u64 %rd4, %rd4, %rd1;");
    x = ins(out, cap, x, "add.u64 %rd4, %rd4, %rd9;");
    x = ins(out, cap, x, "mul.wide.u32 %rd5, %r10, %r3;");
    x = ins(out, cap, x, "add.u64 %rd5, %rd5, %rd1;");
    x = ins(out, cap, x, "add.u64 %rd5, %rd5, %rd9;");
    // W loader: column group r16 = tid%16 (8 columns = one halfword of codes), k-group r17 = 4 (tid/16),
    // global column r18, p6 = group inside n, r19 = n/4 bytes per code row.
    x = ins(out, cap, x, "and.b32 %r16, %r4, 15;");
    x = ins(out, cap, x, "shr.u32 %r17, %r4, 4;");
    x = ins(out, cap, x, "shl.b32 %r17, %r17, 2;");
    x = ins(out, cap, x, "shl.b32 %r18, %r5, 7;");
    x = ins(out, cap, x, "shl.b32 %r19, %r16, 3;");
    x = ins(out, cap, x, "add.u32 %r18, %r18, %r19;");
    x = ins(out, cap, x, "setp.lt.u32 %p6, %r18, %r2;");
    x = ins(out, cap, x, "shr.u32 %r19, %r2, 2;");
    x = ins(out, cap, x, "mul.wide.u32 %rd6, %r17, %r19;");
    x = ins(out, cap, x, "shr.u32 %r21, %r18, 2;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd9, %r21;");
    x = ins(out, cap, x, "add.u64 %rd6, %rd6, %rd9;");
    x = ins(out, cap, x, "add.u64 %rd6, %rd6, %rd2;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd7, %r19;");
    x = ins(out, cap, x, "mul.wide.u32 %rd8, %r19, 61;");
    x = ins(out, cap, x, "mov.u32 %r21, sB;");
    x = ins(out, cap, x, "mul.lo.u32 %r20, %r16, 640;");
    x = ins(out, cap, x, "add.u32 %r20, %r20, %r17;");
    x = ins(out, cap, x, "add.u32 %r20, %r20, %r21;");
    x = ins(out, cap, x, "mov.u32 %r40, 0x00FF0100;");
    // Warp r26, lane r27, g r28, t r29, warp row r30, warp column r31, 4t in r41.
    x = ins(out, cap, x, "shr.u32 %r26, %r4, 5;");
    x = ins(out, cap, x, "and.b32 %r27, %r4, 31;");
    x = ins(out, cap, x, "shr.u32 %r28, %r27, 2;");
    x = ins(out, cap, x, "and.b32 %r29, %r27, 3;");
    x = ins(out, cap, x, "shr.u32 %r30, %r26, 2;");
    x = ins(out, cap, x, "and.b32 %r31, %r26, 3;");
    x = ins(out, cap, x, "shl.b32 %r41, %r29, 2;");
    // A fragment base r32 = sA + (64 wm + g) * 80 + 4t.
    x = ins(out, cap, x, "shl.b32 %r32, %r30, 6;");
    x = ins(out, cap, x, "add.u32 %r32, %r32, %r28;");
    x = ins(out, cap, x, "mul.lo.u32 %r32, %r32, 80;");
    x = ins(out, cap, x, "add.u32 %r32, %r32, %r41;");
    x = ins(out, cap, x, "add.u32 %r32, %r32, %r11;");
    // B fragment bases r33..r36: column group q = 4 wn + ni; its column g sits at row 8 q + ((g + q) & 7).
    x = ins(out, cap, x, "add.u32 %r42, %r21, %r41;");
    x = ins(out, cap, x, "shl.b32 %r43, %r31, 2;");
    var ni : u32 = 0;
    while (ni < 4) {
        x = ins_u(out, cap, x, "add.u32 %r44, %r43, ", ni, ";");
        x = ins(out, cap, x, "add.u32 %r45, %r44, %r28;");
        x = ins(out, cap, x, "and.b32 %r45, %r45, 7;");
        x = ins(out, cap, x, "mad.lo.u32 %r45, %r44, 8, %r45;");
        x = ins_u(out, cap, x, "mad.lo.u32 %r", 33 + ni, ", %r45, 80, %r42;");
        ni += 1;
    }
    x = ins(out, cap, x, "mov.u32 %r37, 0;");
    x = ins(out, cap, x, "mov.u32 %r39, 10240;");
    var i : u32 = 0;
    while (i < 64) {
        x = put_s(out, cap, x, "    mov.b32 %acc");
        x = put_u(out, cap, x, i);
        x = put_s(out, cap, x, ", 0;\n");
        i += 1;
    }
    return x;
}

/// Start the fetch of the k-tile whose first k is in register kreg: two 16-byte cp.async of A (zero
/// filled past m and past k), then four halfword loads of W into r22..r25 (zero past n and past k).
/// The source pointers step to the next tile.
fn emit_fetch(out : []u8, cap : usize, w : usize, kreg : u32) -> usize {
    var x : usize = ins_u(out, cap, w, "add.u32 %r13, %r", kreg, ", %r8;");
    x = ins(out, cap, x, "setp.lt.u32 %p4, %r13, %r3;");
    x = ins(out, cap, x, "and.pred %p5, %p4, %p1;");
    x = ins(out, cap, x, "and.pred %p4, %p4, %p2;");
    x = ins(out, cap, x, "selp.b32 %r14, 16, 0, %p5;");
    x = ins(out, cap, x, "selp.b32 %r15, 16, 0, %p4;");
    x = ins(out, cap, x, "cp.async.cg.shared.global [%r12], [%rd4], 16, %r14;");
    x = ins(out, cap, x, "cp.async.cg.shared.global [%r12+5120], [%rd5], 16, %r15;");
    x = ins(out, cap, x, "add.u64 %rd4, %rd4, 64;");
    x = ins(out, cap, x, "add.u64 %rd5, %rd5, 64;");
    x = ins(out, cap, x, "cp.async.commit_group;");
    x = ins_u(out, cap, x, "add.u32 %r21, %r", kreg, ", %r17;");
    x = ins(out, cap, x, "setp.lt.u32 %p7, %r21, %r3;");
    x = ins(out, cap, x, "and.pred %p7, %p7, %p6;");
    var r : u32 = 0;
    while (r < 4) {
        x = ins_u(out, cap, x, "mov.b32 %r", 22 + r, ", 0;");
        r += 1;
    }
    r = 0;
    while (r < 4) {
        x = ins_u(out, cap, x, "@%p7 ld.global.u16 %r", 22 + r, ", [%rd6];");
        if (r < 3) {
            x = ins(out, cap, x, "add.u64 %rd6, %rd6, %rd7;");
        } else {
            x = ins(out, cap, x, "add.u64 %rd6, %rd6, %rd8;");
        }
        r += 1;
    }
    return x;
}

/// "    ld.shared.u32 %<reg><i>, [%r<base>+<off>];"
fn emit_lds(out : []u8, cap : usize, w : usize, reg : str, i : u32, base : u32, off : u32) -> usize {
    var x : usize = put_s(out, cap, w, "    ld.shared.u32 ");
    x = put_s(out, cap, x, reg);
    x = put_u(out, cap, x, i);
    x = put_s(out, cap, x, ", [%r");
    x = put_u(out, cap, x, base);
    x = put_s(out, cap, x, "+");
    x = put_u(out, cap, x, off);
    return put_s(out, cap, x, "];\n");
}

/// The fragment loads and the 16 mma.sync of one 32-wide k-step (ks = 0 or 1) of the k-tile.
fn emit_mma_step(out : []u8, cap : usize, w : usize, ks : u32) -> usize {
    var x : usize = w;
    const kb : u32 = ks * 32;
    var mi : u32 = 0;
    while (mi < 4) {
        const off : u32 = mi * 16 * SMEM_STRIDE + kb;
        x = emit_lds(out, cap, x, "%fa", mi * 4, 32, off);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 1, 32, off + 8 * SMEM_STRIDE);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 2, 32, off + 16);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 3, 32, off + 8 * SMEM_STRIDE + 16);
        mi += 1;
    }
    var ni : u32 = 0;
    while (ni < 4) {
        x = emit_lds(out, cap, x, "%fb", ni * 2, 33 + ni, kb);
        x = emit_lds(out, cap, x, "%fb", ni * 2 + 1, 33 + ni, kb + 16);
        ni += 1;
    }
    mi = 0;
    while (mi < 4) {
        ni = 0;
        while (ni < 4) {
            const b : u32 = (mi * 4 + ni) * 4;
            x = put_s(out, cap, x, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 ");
            x = put_quad(out, cap, x, "%acc", b);
            x = put_s(out, cap, x, ", ");
            x = put_quad(out, cap, x, "%fa", mi * 4);
            x = put_s(out, cap, x, ", {%fb");
            x = put_u(out, cap, x, ni * 2);
            x = put_s(out, cap, x, ", %fb");
            x = put_u(out, cap, x, ni * 2 + 1);
            x = put_s(out, cap, x, "}, ");
            x = put_quad(out, cap, x, "%acc", b);
            x = put_s(out, cap, x, ";\n");
            ni += 1;
        }
        mi += 1;
    }
    return x;
}

/// Decode the four prefetched halfwords r22..r25 (8 codes each, row i of 4 k-rows) and store them
/// transposed into sB. Half 0 decodes the even codes (columns 0, 2, 4, 6 of the group), half 1 the
/// odd ones. prmt maps a nibble holding a code to its s8 weight through the table r40 = 0x00FF0100
/// (0 -> 0, 1 -> +1, 2 -> -1, 3 -> 0), four codes per instruction; a 4 x 4 byte transpose
/// (8 prmt) turns the four k-rows into one word of 4 consecutive k per column.
fn emit_decode_store(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = w;
    var h : u32 = 0;
    while (h < 2) {
        var i : u32 = 0;
        while (i < 4) {
            if (h == 0) {
                x = ins_uu(out, cap, x, "and.b32 %r", 41 + i, ", %r", 22 + i, ", 0x3333;");
            } else {
                x = ins_uu(out, cap, x, "shr.u32 %r", 41 + i, ", %r", 22 + i, ", 2;");
                x = ins_uu(out, cap, x, "and.b32 %r", 41 + i, ", %r", 41 + i, ", 0x3333;");
            }
            x = ins_uu(out, cap, x, "prmt.b32 %r", 41 + i, ", %r40, 0, %r", 41 + i, ";");
            i += 1;
        }
        x = ins(out, cap, x, "prmt.b32 %r45, %r41, %r42, 0x5140;");
        x = ins(out, cap, x, "prmt.b32 %r46, %r43, %r44, 0x5140;");
        x = ins(out, cap, x, "prmt.b32 %r47, %r41, %r42, 0x7362;");
        x = ins(out, cap, x, "prmt.b32 %r48, %r43, %r44, 0x7362;");
        x = ins(out, cap, x, "prmt.b32 %r49, %r45, %r46, 0x5410;");
        x = ins(out, cap, x, "prmt.b32 %r50, %r45, %r46, 0x7632;");
        x = ins(out, cap, x, "prmt.b32 %r51, %r47, %r48, 0x5410;");
        x = ins(out, cap, x, "prmt.b32 %r52, %r47, %r48, 0x7632;");
        var j : u32 = 0;
        while (j < 4) {
            x = ins_u(out, cap, x, "add.u32 %r53, %r16, ", 2 * j + h, ";");
            x = ins(out, cap, x, "and.b32 %r53, %r53, 7;");
            x = ins(out, cap, x, "mad.lo.u32 %r53, %r53, 80, %r20;");
            x = ins_u(out, cap, x, "st.shared.b32 [%r53], %r", 49 + j, ";");
            j += 1;
        }
        h += 1;
    }
    return x;
}

/// One guarded pair store: accumulators b, b+1 to C[row0 + dr][col0 + dc .. +1].
fn emit_store(out : []u8, cap : usize, w : usize, dr : u32, dc : u32, b : u32) -> usize {
    var x : usize = put_s(out, cap, w, "    add.u32 %r70, %r67, ");
    x = put_u(out, cap, x, dr);
    x = put_s(out, cap, x, ";\n");
    x = put_s(out, cap, x, "    add.u32 %r71, %r69, ");
    x = put_u(out, cap, x, dc);
    x = put_s(out, cap, x, ";\n");
    x = ins(out, cap, x, "setp.lt.u32 %p8, %r70, %r1;");
    x = ins(out, cap, x, "setp.lt.u32 %p9, %r71, %r2;");
    x = ins(out, cap, x, "and.pred %p8, %p8, %p9;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd10, %r71;");
    x = ins(out, cap, x, "mad.wide.u32 %rd10, %r70, %r2, %rd10;");
    x = ins(out, cap, x, "shl.b64 %rd10, %rd10, 2;");
    x = ins(out, cap, x, "add.u64 %rd10, %rd10, %rd3;");
    x = put_s(out, cap, x, "    @%p8 st.global.v2.u32 [%rd10], {%acc");
    x = put_u(out, cap, x, b);
    x = put_s(out, cap, x, ", %acc");
    x = put_u(out, cap, x, b + 1);
    return put_s(out, cap, x, "};\n");
}

/// Thread coordinates again (so the loop does not keep them live), row base r67 = 128 by + 64 wm + g
/// and column base r69 = 128 bx + 32 wn + 2t, then 32 stores.
fn emit_epilogue(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = ins(out, cap, w, "mov.u32 %r60, %tid.x;");
    x = ins(out, cap, x, "shr.u32 %r61, %r60, 5;");
    x = ins(out, cap, x, "and.b32 %r62, %r60, 31;");
    x = ins(out, cap, x, "shr.u32 %r63, %r62, 2;");
    x = ins(out, cap, x, "and.b32 %r64, %r62, 3;");
    x = ins(out, cap, x, "shr.u32 %r65, %r61, 2;");
    x = ins(out, cap, x, "and.b32 %r66, %r61, 3;");
    x = ins(out, cap, x, "mov.u32 %r67, %ctaid.y;");
    x = ins(out, cap, x, "shl.b32 %r67, %r67, 7;");
    x = ins(out, cap, x, "shl.b32 %r68, %r65, 6;");
    x = ins(out, cap, x, "add.u32 %r67, %r67, %r68;");
    x = ins(out, cap, x, "add.u32 %r67, %r67, %r63;");
    x = ins(out, cap, x, "mov.u32 %r69, %ctaid.x;");
    x = ins(out, cap, x, "shl.b32 %r69, %r69, 7;");
    x = ins(out, cap, x, "shl.b32 %r68, %r66, 5;");
    x = ins(out, cap, x, "add.u32 %r69, %r69, %r68;");
    x = ins(out, cap, x, "shl.b32 %r68, %r64, 1;");
    x = ins(out, cap, x, "add.u32 %r69, %r69, %r68;");
    var mi : u32 = 0;
    while (mi < 4) {
        var ni : u32 = 0;
        while (ni < 4) {
            const b : u32 = (mi * 4 + ni) * 4;
            x = emit_store(out, cap, x, mi * 16, ni * 8, b);
            x = emit_store(out, cap, x, mi * 16 + 8, ni * 8, b + 2);
            ni += 1;
        }
        mi += 1;
    }
    return x;
}

/// The whole kernel into out[0..cap). Returns the bytes it needs; when that exceeds cap the buffer
/// holds a clipped text the caller must not use.
pub fn emit_ptx(out : []u8, cap : usize) -> usize {
    var x : usize = emit_header(out, cap, 0);
    x = emit_prologue(out, cap, x);
    // Tile 0 goes to stage 0 (A by cp.async, W decoded by hand); the loop then fills the other stage.
    x = emit_fetch(out, cap, x, 37);
    x = emit_decode_store(out, cap, x);
    x = ins(out, cap, x, "add.u32 %r12, %r12, 10240;");
    x = ins(out, cap, x, "add.u32 %r20, %r20, 10240;");
    x = put_s(out, cap, x, "LOOP_K:\n");
    x = ins(out, cap, x, "setp.ge.u32 %p3, %r37, %r3;");
    x = ins(out, cap, x, "@%p3 bra DONE_K;");
    x = ins(out, cap, x, "cp.async.wait_group 0;");
    x = ins(out, cap, x, "bar.sync 0;");
    x = ins(out, cap, x, "add.u32 %r38, %r37, 64;");
    x = emit_fetch(out, cap, x, 38);
    x = emit_mma_step(out, cap, x, 0);
    x = emit_mma_step(out, cap, x, 1);
    x = emit_decode_store(out, cap, x);
    var q : u32 = 32;
    while (q < 37) {
        x = ins_uu(out, cap, x, "add.u32 %r", q, ", %r", q, ", %r39;");
        q += 1;
    }
    x = ins(out, cap, x, "sub.u32 %r12, %r12, %r39;");
    x = ins(out, cap, x, "sub.u32 %r20, %r20, %r39;");
    x = ins(out, cap, x, "neg.s32 %r39, %r39;");
    x = ins(out, cap, x, "add.u32 %r37, %r37, 64;");
    x = ins(out, cap, x, "bra LOOP_K;");
    x = put_s(out, cap, x, "DONE_K:\n");
    x = ins(out, cap, x, "cp.async.wait_group 0;");
    x = emit_epilogue(out, cap, x);
    x = ins(out, cap, x, "ret;");
    return put_s(out, cap, x, "}\n");
}

// ============================================================================
// 3. Launch geometry and the shapes the kernel accepts
// ============================================================================

/// Blocks along a dimension of x elements: ceil(x / 128).
pub fn grid_dim(x : usize) -> u32 {
    return ((x + 127) / 128) as u32;
}

/// Whether the kernel can run m x k times k x n. n and k multiples of 16; k small enough for i32.
pub fn shape_ok(m : usize, n : usize, k : usize) -> bool {
    if (m < 1 or n < 16 or k < 16) { return false; }
    if (n % 16 != 0 or k % 16 != 0) { return false; }
    if (k > K_MAX_I32) { return false; }
    return (m + 127) / 128 <= GRID_Y_MAX;
}

// ============================================================================
// 4. Host data, the CPU reference and the mismatch count
// ============================================================================

/// 31-bit LCG (glibc constants); its period is 2^31, so no row of a 500m shape repeats another.
pub fn lcg(s : u64) -> u64 {
    return (s * 1103515245 + 12345) % 2147483648;
}

/// count activations in [-128, 127] from bits 16..23 of the LCG; returns the last state.
pub fn gen_a(a : []i8, count : usize, seed : u64) -> u64 {
    var s : u64 = seed;
    var i : usize = 0;
    while (i < count) {
        s = lcg(s);
        a[i] = ((((s >> 16) % 256) as i32) - 128) as i8;
        i += 1;
    }
    return s;
}

/// count 2-bit codes (all four values, so code 3 = 0 is exercised too), packed four per byte with
/// lane 0 in the low bits. count is a multiple of 4. Returns the last state.
pub fn gen_wp(wp : []u8, count : usize, seed : u64) -> u64 {
    var s : u64 = seed;
    var i : usize = 0;
    while (i < count) {
        var byte : u32 = 0;
        var lane : u32 = 0;
        while (lane < 4) {
            s = lcg(s);
            const code : u32 = ((s >> 16) % 4) as u32;
            byte = byte | (code << (lane * 2));
            lane += 1;
        }
        wp[i / 4] = byte as u8;
        i += 4;
    }
    return s;
}

/// Code i of the packed matrix.
pub fn code_at(wp : []const u8, i : usize) -> u32 {
    const b : u32 = wp[i / 4] as u32;
    const sh : u32 = ((i % 4) * 2) as u32;
    return (b >> sh) & 3;
}

/// The decode the kernel runs: (c & 1) - ((c >> 1) & 1); 0 -> 0, 1 -> +1, 2 -> -1, 3 -> 0.
pub fn weight(code : u32) -> i32 {
    return ((code & 1) as i32) - (((code >> 1) & 1) as i32);
}

/// acc[0..n) = row `row` of A x W, k-outer so the codes are read in memory order.
pub fn ref_row(a : []const i8, wp : []const u8, n : usize, k : usize, row : usize, acc : []i32) -> void {
    var j : usize = 0;
    while (j < n) {
        acc[j] = 0;
        j += 1;
    }
    var kk : usize = 0;
    while (kk < k) {
        const v : i32 = a[row * k + kk] as i32;
        if (v != 0) {
            const base : usize = kk * n;
            var col : usize = 0;
            while (col < n) {
                acc[col] += v * weight(code_at(wp, base + col));
                col += 1;
            }
        }
        kk += 1;
    }
}

/// Entries of c (m x n) that differ from the reference, over rows 0, stride, 2 stride, ... and always
/// the last row; stride 1 checks every entry. acc is n entries of scratch.
pub fn mismatches(a : []const i8, wp : []const u8, c : []const i32, m : usize, n : usize, k : usize, stride : usize, acc : []i32) -> usize {
    var st : usize = stride;
    if (st == 0) { st = 1; }
    var bad : usize = 0;
    var row : usize = 0;
    while (row < m) {
        ref_row(a, wp, n, k, row, acc);
        var col : usize = 0;
        while (col < n) {
            if (c[row * n + col] != acc[col]) { bad += 1; }
            col += 1;
        }
        if (row + 1 < m and row + st >= m) {
            row = m - 1;
        } else {
            row += st;
        }
    }
    return bad;
}

// ============================================================================
// 5. Test helpers: search the emitted text
// ============================================================================

/// Whether t[at..] starts with s.
fn at_text(t : []const u8, n : usize, at : usize, s : str) -> bool {
    if (at + s.len > n) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (t[at + i] != s[i]) { return false; }
        i += 1;
    }
    return true;
}

/// How many times s occurs in t[0..n).
fn count_text(t : []const u8, n : usize, s : str) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i < n) {
        if (at_text(t, n, i, s)) { c += 1; }
        i += 1;
    }
    return c;
}

// ============================================================================
// 6. Tests
// ============================================================================

test the_text_opens_with_the_ptx_header {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert at_text(&out, m, 0, "// ternary_gemm_s8 -- emitted by t27c from specs/igla/coder/ternary_gemm_ptx.t27");
    assert count_text(&out, m, "\n.version 7.0\n.target sm_80\n.address_size 64\n\n") == 1;
}

test the_entry_takes_three_pointers_and_three_sizes {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, ".visible .entry ternary_gemm_s8(\n    .param .u64 p_a,\n    .param .u64 p_w,\n    .param .u64 p_c,\n    .param .u32 p_m,\n    .param .u32 p_n,\n    .param .u32 p_k\n)\n.maxntid 256, 1, 1\n.minnctapersm 2\n{\n") == 1;
    assert count_text(&out, m, "    .shared .align 16 .b8 sA[20480];\n") == 1;
    assert count_text(&out, m, "    .shared .align 16 .b8 sB[20480];\n") == 1;
}

test thirty_two_int8_mma_per_k_tile {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    // Two 32-wide k-steps of 16 mma each; both steps use the same register names.
    assert count_text(&out, m, "mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 ") == 32;
    assert count_text(&out, m, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%acc0, %acc1, %acc2, %acc3}, {%fa0, %fa1, %fa2, %fa3}, {%fb0, %fb1}, {%acc0, %acc1, %acc2, %acc3};\n") == 2;
    assert count_text(&out, m, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%acc20, %acc21, %acc22, %acc23}, {%fa4, %fa5, %fa6, %fa7}, {%fb2, %fb3}, {%acc20, %acc21, %acc22, %acc23};\n") == 2;
    assert count_text(&out, m, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%acc60, %acc61, %acc62, %acc63}, {%fa12, %fa13, %fa14, %fa15}, {%fb6, %fb7}, {%acc60, %acc61, %acc62, %acc63};\n") == 2;
    assert count_text(&out, m, "dp4a") == 0;
}

test every_accumulator_starts_at_zero_once {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "    mov.b32 %acc") == 64;
    assert count_text(&out, m, "    mov.b32 %acc0, 0;\n") == 1;
    assert count_text(&out, m, "    mov.b32 %acc63, 0;\n") == 1;
}

test fragment_offsets_follow_the_80_byte_stride {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "    ld.shared.u32 ") == 48;
    // A: tile mi at 16 rows x 80 = 1280 bytes, the g+8 rows 640 further, the upper k half 16 further,
    // the second 32-wide k-step 32 further.
    assert count_text(&out, m, "    ld.shared.u32 %fa0, [%r32+0];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa0, [%r32+32];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa1, [%r32+640];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa2, [%r32+16];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa3, [%r32+656];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa13, [%r32+4480];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa15, [%r32+4528];\n") == 1;
    // B: one base register per 8-column group (the rows are rotated, so the group is not an offset).
    assert count_text(&out, m, "    ld.shared.u32 %fb0, [%r33+0];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fb1, [%r33+48];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fb6, [%r36+32];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fb7, [%r36+16];\n") == 1;
}

test a_k_tile_is_fetched_by_cp_async_and_decoded_by_prmt {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    // Two fetches (the prologue's tile 0 and the loop's tile i + 1), two 16-byte copies each.
    assert count_text(&out, m, "    cp.async.cg.shared.global ") == 4;
    assert count_text(&out, m, "    cp.async.cg.shared.global [%r12+5120], [%rd5], 16, %r15;\n") == 2;
    assert count_text(&out, m, "    cp.async.commit_group;\n") == 2;
    assert count_text(&out, m, "    cp.async.wait_group 0;\n") == 2;
    assert count_text(&out, m, " ld.global.u16 ") == 8;
    assert count_text(&out, m, "ld.global.v4") == 0;
    assert count_text(&out, m, "st.shared.u8") == 0;
    // Decode: 4 selectors + 8 transpose prmt per half, two halves, two emissions.
    assert count_text(&out, m, "    prmt.b32 ") == 48;
    assert count_text(&out, m, "0x00FF0100") == 1;
    assert count_text(&out, m, "    and.b32 %r41, %r22, 0x3333;\n") == 2;
    assert count_text(&out, m, "    shr.u32 %r41, %r22, 2;\n") == 2;
    assert count_text(&out, m, "    prmt.b32 %r41, %r40, 0, %r41;\n") == 4;
    assert count_text(&out, m, "    prmt.b32 %r45, %r41, %r42, 0x5140;\n") == 4;
    assert count_text(&out, m, "    prmt.b32 %r52, %r47, %r48, 0x7632;\n") == 4;
    assert count_text(&out, m, "    st.shared.b32 [%r53], %r49;\n") == 4;
    assert count_text(&out, m, "    st.shared.b32 ") == 16;
    assert count_text(&out, m, "    add.u32 %r53, %r16, 7;\n") == 2;
}

test thirty_two_guarded_pair_stores {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "st.global.v2.u32 ") == 32;
    assert count_text(&out, m, "    @%p8 st.global.v2.u32 [%rd10], {%acc0, %acc1};\n") == 1;
    assert count_text(&out, m, "    @%p8 st.global.v2.u32 [%rd10], {%acc62, %acc63};\n") == 1;
    assert count_text(&out, m, "    add.u32 %r70, %r67, 56;\n") == 4;
    assert count_text(&out, m, "    add.u32 %r71, %r69, 24;\n") == 8;
}

test one_loop_one_barrier_one_return {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "\nLOOP_K:\n") == 1;
    assert count_text(&out, m, "\nDONE_K:\n") == 1;
    assert count_text(&out, m, "    bar.sync 0;\n") == 1;
    assert count_text(&out, m, "    add.u32 %r37, %r37, 64;\n    bra LOOP_K;\n") == 1;
    // The stage toggle: reads move by the delta, writes move back by it, the delta flips sign.
    assert count_text(&out, m, "    add.u32 %r32, %r32, %r39;\n") == 1;
    assert count_text(&out, m, "    add.u32 %r36, %r36, %r39;\n") == 1;
    assert count_text(&out, m, "    sub.u32 %r12, %r12, %r39;\n") == 1;
    assert count_text(&out, m, "    sub.u32 %r20, %r20, %r39;\n") == 1;
    assert count_text(&out, m, "    neg.s32 %r39, %r39;\n") == 1;
    assert at_text(&out, m, m - 11, "    ret;\n}\n");
}

test the_text_is_ascii_and_fits_its_buffer {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert m == 29178;
    assert m < PTX_CAP;
    var i : usize = 0;
    while (i < m) {
        assert out[i] == '\n' or (out[i] >= 32 and out[i] < 127);
        i += 1;
    }
}

test a_short_buffer_reports_the_full_length_and_writes_nothing_past_cap {
    var out : [65536]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    var small : [64]u8 = [7; 64];
    const s : usize = emit_ptx(&small, 32);
    assert s == m;
    assert small[31] == out[31];
    assert small[32] == 7;
    assert small[63] == 7;
}

test emitting_twice_gives_the_same_bytes {
    var a : [65536]u8 = undefined;
    var b : [65536]u8 = undefined;
    const m : usize = emit_ptx(&a, PTX_CAP);
    const k : usize = emit_ptx(&b, PTX_CAP);
    assert k == m;
    var i : usize = 0;
    while (i < m) {
        assert a[i] == b[i];
        i += 1;
    }
}

test the_fragment_stride_is_bank_conflict_free {
    // An LDS.32 fragment load of lane (g, t) reads word (SMEM_STRIDE / 4) g + t: 32 lanes, 32 banks.
    var seen : [32]u32 = [0; 32];
    var g : u32 = 0;
    while (g < 8) {
        var t : u32 = 0;
        while (t < 4) {
            const bank : u32 = (g * (SMEM_STRIDE / 4) + t) % 32;
            seen[bank] += 1;
            t += 1;
        }
        g += 1;
    }
    var b : u32 = 0;
    while (b < 32) {
        assert seen[b] == 1;
        b += 1;
    }
}

test the_column_rotation_of_a_group_is_a_permutation {
    // Logical column c of group q is stored at row slot (c + q) & 7 and read back at the same slot,
    // so every group still fills its eight slots exactly once.
    var q : u32 = 0;
    while (q < 16) {
        var seen : [8]u32 = [0; 8];
        var c : u32 = 0;
        while (c < 8) {
            seen[(c + q) % 8] += 1;
            c += 1;
        }
        var i : u32 = 0;
        while (i < 8) {
            assert seen[i] == 1;
            i += 1;
        }
        q += 1;
    }
}

test the_decode_is_the_gpu_spec_decode {
    // ternary_gemm_gpu.t27 decode: 0 -> 0, 1 -> +1, 2 -> -1, 3 -> 0.
    assert weight(0) == 0;
    assert weight(1) == 1;
    assert weight(2) == -1;
    assert weight(3) == 0;
}

test packing_puts_lane_zero_in_the_low_bits {
    var wp : [4]u8 = [0; 4];
    wp[0] = 0x1B;
    wp[3] = 0x80;
    // 0x1B = 00 01 10 11: lanes 0..3 hold 3, 2, 1, 0.
    assert code_at(&wp, 0) == 3;
    assert code_at(&wp, 1) == 2;
    assert code_at(&wp, 2) == 1;
    assert code_at(&wp, 3) == 0;
    assert code_at(&wp, 15) == 2;
    assert code_at(&wp, 12) == 0;
}

test generated_codes_round_trip_through_the_packing {
    var wp : [8]u8 = [0; 8];
    const last : u64 = gen_wp(&wp, 32, 7);
    var s : u64 = 7;
    var i : usize = 0;
    var seen : [4]usize = [0; 4];
    while (i < 32) {
        s = lcg(s);
        const code : u32 = ((s >> 16) % 4) as u32;
        assert code_at(&wp, i) == code;
        seen[code] += 1;
        i += 1;
    }
    assert s == last;
    assert seen[0] > 0 and seen[1] > 0 and seen[2] > 0 and seen[3] > 0;
}

test generated_activations_span_the_i8_range {
    var a : [4096]i8 = [0; 4096];
    const s : u64 = gen_a(&a, 4096, 1);
    assert s != 1;
    var lo : i32 = 0;
    var hi : i32 = 0;
    var i : usize = 0;
    while (i < 4096) {
        const v : i32 = a[i] as i32;
        if (v < lo) { lo = v; }
        if (v > hi) { hi = v; }
        i += 1;
    }
    assert lo == -128;
    assert hi == 127;
}

test the_reference_row_on_a_hand_case {
    // k = 16, n = 16: a[kk] = kk + 1; w(kk, kk) = +1 for even kk, -1 for odd kk, w(kk, 15 - kk) = 3
    // (a zero), everything else 0. Then acc[j] = (j + 1) for even j and -(j + 1) for odd j.
    var a : [16]i8 = [0; 16];
    var wp : [64]u8 = [0; 64];
    var kk : usize = 0;
    while (kk < 16) {
        a[kk] = (kk + 1) as i8;
        const i : usize = kk * 16 + kk;
        var code : u32 = 1;
        if (kk % 2 == 1) { code = 2; }
        wp[i / 4] = ((wp[i / 4] as u32) | (code << (((i % 4) * 2) as u32))) as u8;
        const z : usize = kk * 16 + 15 - kk;
        if (z != i) { wp[z / 4] = ((wp[z / 4] as u32) | (3 << (((z % 4) * 2) as u32))) as u8; }
        kk += 1;
    }
    var acc : [16]i32 = [5; 16];
    ref_row(&a, &wp, 16, 16, 0, &acc);
    assert acc[0] == 1;
    assert acc[1] == -2;
    assert acc[6] == 7;
    assert acc[15] == -16;
}

test the_extremes_reach_128_k_without_overflow {
    // a = -128 everywhere, w = -1 everywhere: every entry is 128 * k.
    var a : [64]i8 = [-128; 64];
    var wp : [256]u8 = [0xAA; 256];
    var acc : [16]i32 = [0; 16];
    ref_row(&a, &wp, 16, 64, 0, &acc);
    assert acc[0] == 8192;
    assert acc[15] == 8192;
}

test mismatches_count_exactly_the_wrong_entries {
    // m = 3, n = 16, k = 32: c filled from the reference has 0 mismatches; one wrong entry has 1.
    var a : [96]i8 = [0; 96];
    var wp : [128]u8 = [0; 128];
    const s : u64 = gen_a(&a, 96, 3);
    const t : u64 = gen_wp(&wp, 512, s);
    assert t != s;
    var c : [48]i32 = [0; 48];
    var acc : [16]i32 = [0; 16];
    var row : usize = 0;
    while (row < 3) {
        ref_row(&a, &wp, 16, 32, row, &acc);
        var j : usize = 0;
        while (j < 16) {
            c[row * 16 + j] = acc[j];
            j += 1;
        }
        row += 1;
    }
    assert mismatches(&a, &wp, &c, 3, 16, 32, 1, &acc) == 0;
    c[16 + 5] += 1;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 1, &acc) == 1;
    // stride 2 checks rows 0 and 2 only, so the wrong entry in row 1 is not seen;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 2, &acc) == 0;
    // a wrong entry in the last row is seen at any stride.
    c[47] -= 1;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 100, &acc) == 1;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 0, &acc) == 2;
}

test the_500m_shapes_are_accepted {
    assert shape_ok(4096, D_MODEL_500M, D_MODEL_500M) == true;
    assert shape_ok(4096, D_FF_500M, D_MODEL_500M) == true;
    assert shape_ok(4096, D_MODEL_500M, D_FF_500M) == true;
    assert shape_ok(16384, D_FF_500M, D_MODEL_500M) == true;
    assert shape_ok(17, 16, 16) == true;
}

test unsupported_shapes_are_refused {
    assert shape_ok(0, 1280, 1280) == false;
    assert shape_ok(4096, 1288, 1280) == false;
    assert shape_ok(4096, 1280, 1288) == false;
    assert shape_ok(4096, 8, 1280) == false;
    assert shape_ok(4096, 1280, 16777216) == false;
    assert shape_ok(4096, 1280, 16777200) == true;
    assert shape_ok(65535 * 128 + 1, 1280, 1280) == false;
}

test the_grid_covers_every_row_and_column {
    assert grid_dim(1280) == 10;
    assert grid_dim(4096) == 32;
    assert grid_dim(16384) == 128;
    assert grid_dim(129) == 2;
    assert grid_dim(1) == 1;
}

invariant accumulator_cannot_overflow { 128 * K_MAX_I32 <= 2147483647 }

invariant shared_tiles_fit_static_shared_memory { 2 * STAGES * BM * SMEM_STRIDE <= 49152 }

invariant a_stage_is_128_rows_of_the_stride { STAGE_BYTES == BM * SMEM_STRIDE }

invariant the_stride_holds_a_k_tile_and_keeps_16_byte_rows { SMEM_STRIDE >= BK and SMEM_STRIDE % 16 == 0 }

invariant an_odd_number_of_four_word_units_per_row_spreads_the_banks { (SMEM_STRIDE / 16) % 2 == 1 }

invariant eight_warps_cover_the_block { (THREADS / 32) * 64 * 32 == BM * BN }

invariant the_500m_shapes_are_whole_blocks { D_MODEL_500M % 128 == 0 and D_FF_500M % 128 == 0 and D_MODEL_500M % BK == 0 and D_FF_500M % BK == 0 }
