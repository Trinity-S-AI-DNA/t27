// SPDX-License-Identifier: Apache-2.0
; specs/igla/coder/ternary_gemm_ptx.t27 -- the PTX text of the ternary x int8 GEMM kernel, written by t27.
; Issue #10404, plan #10360. Owner override 2026-10-18: build the backend, and build it in t27.
; --
; What this is. specs/igla/coder/ternary_gemm_gpu.t27 pins the math of a tiled ternary x int8 GEMM and
; checks it bit-exactly on two compilers. This spec is its GPU lowering: emit_ptx() writes the PTX of
; one kernel, `ternary_gemm_s8`, for int8 tensor cores (mma.sync m16n8k32 s8 x s8 -> s32, sm_80 and
; later; the RTX 4090 is sm_89). `t27c compile specs/igla/coder/ternary_gemm_gpu.t27 --backend ptx`
; writes this text; `t27c gen-rust` lowers this spec into bootstrap/gen/rust/igla/coder/ and Rust
; only copies the bytes to a file or to the CUDA driver.
; The honest limit: this is a kernel-specific emitter, not a general t27 -> PTX lowering. It writes
; exactly one kernel, and t27c refuses `--backend ptx` for every other spec.
; --
; Why int8 tensor cores and not dp4a. On the RTX 4090 bench of #10360 (CUTLASS 3.5.1, one pod),
; int8 tensor cores ran 2.9-3.5x bf16 and dp4a ran 0.91-0.94x bf16; only the mma path can win.
; --
; The kernel, v1.
;   C[m][n] = sum_k A[m][k] * w(k, n); A is i8 row-major (m x k); W is the k x n code matrix of
;   ternary_gemm_gpu.t27, row-major, four 2-bit codes per byte, code i at byte i/4, lane i%4, lane 0
;   in the low bits; C is i32 row-major (m x n).
;   Grid (ceil(n/128), ceil(m/128)), 256 threads. Each block computes a 128 x 128 tile of C in k-steps
;   of 32. Per k-step:
;     - A tile: 128 rows x 32 bytes; thread t loads 16 bytes, row t/2, bytes (t%2)*16, zero past m
;       and past k, and stores them in sA at row * 48 + chunk;
;     - W tile: 32 k-rows x 128 columns of codes = 256 words; thread t loads one u32 (16 codes) at
;       k-row t/8, columns (t%8)*16, decodes each code once as w = (c & 1) - ((c >> 1) & 1), and
;       stores it TRANSPOSED as an s8 in sB at column * 48 + k-row ("col" operand of the mma);
;     - warp v = t/32 owns the 64 x 32 sub-tile at rows (v/4)*64, columns (v%4)*32: 4 x 4 mma tiles
;       of 16 x 8, so 16 mma.sync per k-step and 64 i32 accumulators per thread.
;   The 48-byte row stride (32 data bytes + 16 pad) puts the 32 lanes of every fragment load on 32
;   distinct banks: lane (g, t) reads word 12g + t, and 12g mod 32 for g = 0..7 is 0,12,24,4,16,28,8,20.
;   Fragment layouts are the PTX ISA's for m16n8k32 .s8 (g = lane/4, t = lane%4):
;     A: a0 = row g, k 4t..4t+3; a1 = row g+8; a2 = row g, k 16+4t..; a3 = row g+8, k 16+4t..
;     B: b0 = column g, k 4t..4t+3; b1 = column g, k 16+4t..
;     C: c0, c1 = row g, columns 2t, 2t+1; c2, c3 = row g+8, same columns.
;   v1 has no cp.async and no double buffering: it is the first kernel that runs, not the fastest.
; Preconditions, checked by shape_ok() before a launch: n and k are multiples of 16 (aligned 16-byte
; A loads and 4-byte W loads; a k chunk or a 16-column W word is then either wholly inside or wholly
; outside), 1 <= m, and k <= K_MAX_I32 so that no i32 partial sum can overflow.
; --
; The host side lives here too, so that the bit-exact check is t27 as well: gen_a, gen_wp (the data),
; ref_row (the CPU reference, one output row at a time) and mismatches (the count the run reports).
; Bit-exact is valid for the reason ternary_gemm_gpu.t27 states: every product is in [-128, 128], the
; sum is i32 and cannot overflow while k <= K_MAX_I32, so integer addition is associative and any
; order of the k-sum gives the same bits.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-ternary-gemm-ptx;

/// The kernel's entry name, the one cuModuleGetFunction looks up.
pub const KERNEL_NAME : str = "ternary_gemm_s8";
/// Block tile and k-step of the kernel, and its thread count.
pub const BM : u32 = 128;
pub const BN : u32 = 128;
pub const BK : u32 = 32;
pub const THREADS : u32 = 256;
/// Bytes per row of a shared tile: 32 data bytes and 16 bytes of padding.
pub const SMEM_STRIDE : u32 = 48;
/// mma.sync instructions per k-step: 4 x 4 tiles of 16 x 8 per warp.
pub const MMA_PER_STEP : u32 = 16;
/// Largest k for which no i32 partial sum can overflow: 128 * 16777215 = 2147483520.
pub const K_MAX_I32 : usize = 16777215;
/// Largest grid y the driver accepts.
pub const GRID_Y_MAX : usize = 65535;
/// Buffer the emitted text needs, with room to spare; emit_ptx returns the exact length.
pub const PTX_CAP : usize = 32768;
/// tern-tc-500m: d_model and d_ff (read from the trainer config, see #10360).
pub const D_MODEL_500M : usize = 1280;
pub const D_FF_500M : usize = 4096;

// ============================================================================
// 1. A bounded text writer
// ============================================================================

/// Write s at out[w..]; bytes past cap are counted but not written. Returns the new end.
fn put_s(out : []u8, cap : usize, w : usize, s : str) -> usize {
    var i : usize = 0;
    while (i < s.len) {
        if (w + i < cap) { out[w + i] = s[i]; }
        i += 1;
    }
    return w + s.len;
}

/// Write v in decimal at out[w..], bounded by cap like put_s.
fn put_u(out : []u8, cap : usize, w : usize, v : u32) -> usize {
    var d : u32 = 1;
    while (v / d >= 10) { d = d * 10; }
    var x : usize = w;
    while (d > 0) {
        const c : u8 = '0' + (((v / d) % 10) as u8);
        if (x < cap) { out[x] = c; }
        x += 1;
        d = d / 10;
    }
    return x;
}

/// One indented instruction line that has no operand to fill in.
fn ins(out : []u8, cap : usize, w : usize, s : str) -> usize {
    const x : usize = put_s(out, cap, w, "    ");
    return put_s(out, cap, put_s(out, cap, x, s), "\n");
}

/// "{%name<i>, %name<i+1>, %name<i+2>, %name<i+3>}"
fn put_quad(out : []u8, cap : usize, w : usize, name : str, first : u32) -> usize {
    var x : usize = put_s(out, cap, w, "{");
    var j : u32 = 0;
    while (j < 4) {
        if (j > 0) { x = put_s(out, cap, x, ", "); }
        x = put_u(out, cap, put_s(out, cap, x, name), first + j);
        j += 1;
    }
    return put_s(out, cap, x, "}");
}

// ============================================================================
// 2. The kernel, section by section
// ============================================================================

fn emit_header(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = put_s(out, cap, w, "// ternary_gemm_s8 -- emitted by t27c from specs/igla/coder/ternary_gemm_ptx.t27 (#10404). Do not edit.\n");
    x = put_s(out, cap, x, ".version 7.0\n.target sm_80\n.address_size 64\n\n");
    x = put_s(out, cap, x, ".visible .entry ternary_gemm_s8(\n");
    x = put_s(out, cap, x, "    .param .u64 p_a,\n    .param .u64 p_w,\n    .param .u64 p_c,\n");
    x = put_s(out, cap, x, "    .param .u32 p_m,\n    .param .u32 p_n,\n    .param .u32 p_k\n)\n");
    x = put_s(out, cap, x, ".maxntid 256, 1, 1\n{\n");
    x = ins(out, cap, x, ".reg .pred %p<8>;");
    x = ins(out, cap, x, ".reg .b32 %r<48>;");
    x = ins(out, cap, x, ".reg .b32 %acc<64>;");
    x = ins(out, cap, x, ".reg .b32 %fa<16>;");
    x = ins(out, cap, x, ".reg .b32 %fb<8>;");
    x = ins(out, cap, x, ".reg .b64 %rd<12>;");
    x = ins(out, cap, x, ".shared .align 16 .b8 sA[6144];");
    x = ins(out, cap, x, ".shared .align 16 .b8 sB[6144];");
    return x;
}

/// Parameters, thread coordinates, and the addresses each thread reuses every k-step.
fn emit_prologue(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = ins(out, cap, w, "ld.param.u64 %rd1, [p_a];");
    x = ins(out, cap, x, "ld.param.u64 %rd2, [p_w];");
    x = ins(out, cap, x, "ld.param.u64 %rd3, [p_c];");
    x = ins(out, cap, x, "ld.param.u32 %r1, [p_m];");
    x = ins(out, cap, x, "ld.param.u32 %r2, [p_n];");
    x = ins(out, cap, x, "ld.param.u32 %r3, [p_k];");
    x = ins(out, cap, x, "cvta.to.global.u64 %rd1, %rd1;");
    x = ins(out, cap, x, "cvta.to.global.u64 %rd2, %rd2;");
    x = ins(out, cap, x, "cvta.to.global.u64 %rd3, %rd3;");
    x = ins(out, cap, x, "mov.u32 %r4, %tid.x;");
    x = ins(out, cap, x, "mov.u32 %r5, %ctaid.x;");
    x = ins(out, cap, x, "mov.u32 %r6, %ctaid.y;");
    // A tile: row r7 = tid/2, chunk r8 = (tid%2)*16, global row r9, p1 = row inside m.
    x = ins(out, cap, x, "shr.u32 %r7, %r4, 1;");
    x = ins(out, cap, x, "and.b32 %r8, %r4, 1;");
    x = ins(out, cap, x, "shl.b32 %r8, %r8, 4;");
    x = ins(out, cap, x, "shl.b32 %r9, %r6, 7;");
    x = ins(out, cap, x, "add.u32 %r9, %r9, %r7;");
    x = ins(out, cap, x, "setp.lt.u32 %p1, %r9, %r1;");
    x = ins(out, cap, x, "mov.u32 %r10, sA;");
    x = ins(out, cap, x, "mad.lo.u32 %r11, %r7, 48, %r8;");
    x = ins(out, cap, x, "add.u32 %r11, %r11, %r10;");
    x = ins(out, cap, x, "mul.wide.u32 %rd4, %r9, %r3;");
    x = ins(out, cap, x, "add.u64 %rd4, %rd4, %rd1;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd5, %r8;");
    x = ins(out, cap, x, "add.u64 %rd4, %rd4, %rd5;");
    // W tile: k-row r12 = tid/8, column group r13 = (tid%8)*16, global column r14, p2 = inside n.
    x = ins(out, cap, x, "shr.u32 %r12, %r4, 3;");
    x = ins(out, cap, x, "and.b32 %r13, %r4, 7;");
    x = ins(out, cap, x, "shl.b32 %r13, %r13, 4;");
    x = ins(out, cap, x, "shl.b32 %r14, %r5, 7;");
    x = ins(out, cap, x, "add.u32 %r14, %r14, %r13;");
    x = ins(out, cap, x, "setp.lt.u32 %p2, %r14, %r2;");
    x = ins(out, cap, x, "mov.u32 %r15, sB;");
    x = ins(out, cap, x, "mad.lo.u32 %r16, %r13, 48, %r12;");
    x = ins(out, cap, x, "add.u32 %r16, %r16, %r15;");
    x = ins(out, cap, x, "shr.u32 %r17, %r2, 2;");
    x = ins(out, cap, x, "shr.u32 %r18, %r14, 2;");
    // Warp r19, lane r20, g r21, t r22, warp row r23, warp column r24.
    x = ins(out, cap, x, "shr.u32 %r19, %r4, 5;");
    x = ins(out, cap, x, "and.b32 %r20, %r4, 31;");
    x = ins(out, cap, x, "shr.u32 %r21, %r20, 2;");
    x = ins(out, cap, x, "and.b32 %r22, %r20, 3;");
    x = ins(out, cap, x, "shr.u32 %r23, %r19, 2;");
    x = ins(out, cap, x, "and.b32 %r24, %r19, 3;");
    // Fragment bases: r25 = sA + (64 wm + g) * 48 + 4t, r27 = sB + (32 wn + g) * 48 + 4t.
    x = ins(out, cap, x, "shl.b32 %r26, %r22, 2;");
    x = ins(out, cap, x, "shl.b32 %r25, %r23, 6;");
    x = ins(out, cap, x, "add.u32 %r25, %r25, %r21;");
    x = ins(out, cap, x, "mul.lo.u32 %r25, %r25, 48;");
    x = ins(out, cap, x, "add.u32 %r25, %r25, %r26;");
    x = ins(out, cap, x, "add.u32 %r25, %r25, %r10;");
    x = ins(out, cap, x, "shl.b32 %r27, %r24, 5;");
    x = ins(out, cap, x, "add.u32 %r27, %r27, %r21;");
    x = ins(out, cap, x, "mul.lo.u32 %r27, %r27, 48;");
    x = ins(out, cap, x, "add.u32 %r27, %r27, %r26;");
    x = ins(out, cap, x, "add.u32 %r27, %r27, %r15;");
    x = ins(out, cap, x, "mov.u32 %r28, 0;");
    var i : u32 = 0;
    while (i < 64) {
        x = put_s(out, cap, put_u(out, cap, put_s(out, cap, x, "    mov.b32 %acc"), i), ", 0;\n");
        i += 1;
    }
    return x;
}

/// The cooperative tile loads of one k-step (k0 in r28), A first, then W decoded into sB.
fn emit_tile_loads(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = ins(out, cap, w, "add.u32 %r29, %r28, %r8;");
    x = ins(out, cap, x, "setp.lt.u32 %p4, %r29, %r3;");
    x = ins(out, cap, x, "and.pred %p4, %p4, %p1;");
    x = ins(out, cap, x, "mov.b32 %r30, 0;");
    x = ins(out, cap, x, "mov.b32 %r31, 0;");
    x = ins(out, cap, x, "mov.b32 %r32, 0;");
    x = ins(out, cap, x, "mov.b32 %r33, 0;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd5, %r28;");
    x = ins(out, cap, x, "add.u64 %rd6, %rd4, %rd5;");
    x = ins(out, cap, x, "@%p4 ld.global.v4.u32 {%r30, %r31, %r32, %r33}, [%rd6];");
    x = ins(out, cap, x, "st.shared.v4.u32 [%r11], {%r30, %r31, %r32, %r33};");
    x = ins(out, cap, x, "add.u32 %r34, %r28, %r12;");
    x = ins(out, cap, x, "setp.lt.u32 %p5, %r34, %r3;");
    x = ins(out, cap, x, "and.pred %p5, %p5, %p2;");
    x = ins(out, cap, x, "mov.b32 %r35, 0;");
    x = ins(out, cap, x, "mul.wide.u32 %rd7, %r34, %r17;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd8, %r18;");
    x = ins(out, cap, x, "add.u64 %rd7, %rd7, %rd8;");
    x = ins(out, cap, x, "add.u64 %rd9, %rd7, %rd2;");
    x = ins(out, cap, x, "@%p5 ld.global.u32 %r35, [%rd9];");
    var j : u32 = 0;
    while (j < 16) {
        x = put_s(out, cap, put_u(out, cap, put_s(out, cap, x, "    shr.u32 %r36, %r35, "), 2 * j), ";\n");
        x = ins(out, cap, x, "and.b32 %r37, %r36, 1;");
        x = ins(out, cap, x, "shr.u32 %r38, %r36, 1;");
        x = ins(out, cap, x, "and.b32 %r38, %r38, 1;");
        x = ins(out, cap, x, "sub.s32 %r37, %r37, %r38;");
        x = put_s(out, cap, put_u(out, cap, put_s(out, cap, x, "    st.shared.u8 [%r16+"), j * SMEM_STRIDE), "], %r37;\n");
        j += 1;
    }
    return x;
}

/// "    ld.shared.u32 %<reg><i>, [%<base>+<off>];"
fn emit_lds(out : []u8, cap : usize, w : usize, reg : str, i : u32, base : str, off : u32) -> usize {
    var x : usize = put_u(out, cap, put_s(out, cap, put_s(out, cap, w, "    ld.shared.u32 "), reg), i);
    x = put_s(out, cap, put_s(out, cap, put_s(out, cap, x, ", ["), base), "+");
    return put_s(out, cap, put_u(out, cap, x, off), "];\n");
}

/// The fragment loads and the 16 mma.sync of one k-step.
fn emit_mma_step(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = w;
    var mi : u32 = 0;
    while (mi < 4) {
        const off : u32 = mi * 16 * SMEM_STRIDE;
        x = emit_lds(out, cap, x, "%fa", mi * 4, "%r25", off);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 1, "%r25", off + 8 * SMEM_STRIDE);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 2, "%r25", off + 16);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 3, "%r25", off + 8 * SMEM_STRIDE + 16);
        mi += 1;
    }
    var ni : u32 = 0;
    while (ni < 4) {
        x = emit_lds(out, cap, x, "%fb", ni * 2, "%r27", ni * 8 * SMEM_STRIDE);
        x = emit_lds(out, cap, x, "%fb", ni * 2 + 1, "%r27", ni * 8 * SMEM_STRIDE + 16);
        ni += 1;
    }
    mi = 0;
    while (mi < 4) {
        ni = 0;
        while (ni < 4) {
            const b : u32 = (mi * 4 + ni) * 4;
            x = put_s(out, cap, x, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 ");
            x = put_s(out, cap, put_quad(out, cap, x, "%acc", b), ", ");
            x = put_s(out, cap, put_quad(out, cap, x, "%fa", mi * 4), ", {%fb");
            x = put_u(out, cap, put_s(out, cap, put_u(out, cap, x, ni * 2), ", %fb"), ni * 2 + 1);
            x = put_s(out, cap, put_quad(out, cap, put_s(out, cap, x, "}, "), "%acc", b), ";\n");
            ni += 1;
        }
        mi += 1;
    }
    return x;
}

/// One guarded pair store: accumulators b, b+1 to C[row0 + dr][col0 + dc .. +1].
fn emit_store(out : []u8, cap : usize, w : usize, dr : u32, dc : u32, b : u32) -> usize {
    var x : usize = put_s(out, cap, put_u(out, cap, put_s(out, cap, w, "    add.u32 %r41, %r39, "), dr), ";\n");
    x = put_s(out, cap, put_u(out, cap, put_s(out, cap, x, "    add.u32 %r42, %r40, "), dc), ";\n");
    x = ins(out, cap, x, "setp.lt.u32 %p6, %r41, %r1;");
    x = ins(out, cap, x, "setp.lt.u32 %p7, %r42, %r2;");
    x = ins(out, cap, x, "and.pred %p6, %p6, %p7;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd10, %r42;");
    x = ins(out, cap, x, "mad.wide.u32 %rd10, %r41, %r2, %rd10;");
    x = ins(out, cap, x, "shl.b64 %rd10, %rd10, 2;");
    x = ins(out, cap, x, "add.u64 %rd10, %rd10, %rd3;");
    x = put_u(out, cap, put_s(out, cap, x, "    @%p6 st.global.v2.u32 [%rd10], {%acc"), b);
    return put_s(out, cap, put_u(out, cap, put_s(out, cap, x, ", %acc"), b + 1), "};\n");
}

/// Row base r39 = 128 by + 64 wm + g and column base r40 = 128 bx + 32 wn + 2t, then 32 stores.
fn emit_epilogue(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = ins(out, cap, w, "shl.b32 %r39, %r6, 7;");
    x = ins(out, cap, x, "shl.b32 %r41, %r23, 6;");
    x = ins(out, cap, x, "add.u32 %r39, %r39, %r41;");
    x = ins(out, cap, x, "add.u32 %r39, %r39, %r21;");
    x = ins(out, cap, x, "shl.b32 %r40, %r5, 7;");
    x = ins(out, cap, x, "shl.b32 %r41, %r24, 5;");
    x = ins(out, cap, x, "add.u32 %r40, %r40, %r41;");
    x = ins(out, cap, x, "shl.b32 %r41, %r22, 1;");
    x = ins(out, cap, x, "add.u32 %r40, %r40, %r41;");
    var mi : u32 = 0;
    while (mi < 4) {
        var ni : u32 = 0;
        while (ni < 4) {
            const b : u32 = (mi * 4 + ni) * 4;
            x = emit_store(out, cap, x, mi * 16, ni * 8, b);
            x = emit_store(out, cap, x, mi * 16 + 8, ni * 8, b + 2);
            ni += 1;
        }
        mi += 1;
    }
    return x;
}

/// The whole kernel into out[0..cap). Returns the bytes it needs; when that exceeds cap the buffer
/// holds a clipped text the caller must not use.
pub fn emit_ptx(out : []u8, cap : usize) -> usize {
    var x : usize = emit_header(out, cap, 0);
    x = emit_prologue(out, cap, x);
    x = put_s(out, cap, x, "LOOP_K:\n");
    x = ins(out, cap, x, "setp.ge.u32 %p3, %r28, %r3;");
    x = ins(out, cap, x, "@%p3 bra DONE_K;");
    x = emit_tile_loads(out, cap, x);
    x = ins(out, cap, x, "bar.sync 0;");
    x = emit_mma_step(out, cap, x);
    x = ins(out, cap, x, "bar.sync 0;");
    x = ins(out, cap, x, "add.u32 %r28, %r28, 32;");
    x = ins(out, cap, x, "bra LOOP_K;");
    x = put_s(out, cap, x, "DONE_K:\n");
    x = emit_epilogue(out, cap, x);
    x = ins(out, cap, x, "ret;");
    return put_s(out, cap, x, "}\n");
}

// ============================================================================
// 3. Launch geometry and the shapes the kernel accepts
// ============================================================================

/// Blocks along a dimension of x elements: ceil(x / 128).
pub fn grid_dim(x : usize) -> u32 {
    return ((x + 127) / 128) as u32;
}

/// Whether the kernel can run m x k times k x n. n and k multiples of 16; k small enough for i32.
pub fn shape_ok(m : usize, n : usize, k : usize) -> bool {
    if (m < 1 or n < 16 or k < 16) { return false; }
    if (n % 16 != 0 or k % 16 != 0) { return false; }
    if (k > K_MAX_I32) { return false; }
    return (m + 127) / 128 <= GRID_Y_MAX;
}

// ============================================================================
// 4. Host data, the CPU reference and the mismatch count
// ============================================================================

/// 31-bit LCG (glibc constants); its period is 2^31, so no row of a 500m shape repeats another.
pub fn lcg(s : u64) -> u64 {
    return (s * 1103515245 + 12345) % 2147483648;
}

/// count activations in [-128, 127] from bits 16..23 of the LCG; returns the last state.
pub fn gen_a(a : []i8, count : usize, seed : u64) -> u64 {
    var s : u64 = seed;
    var i : usize = 0;
    while (i < count) {
        s = lcg(s);
        a[i] = ((((s >> 16) % 256) as i32) - 128) as i8;
        i += 1;
    }
    return s;
}

/// count 2-bit codes (all four values, so code 3 = 0 is exercised too), packed four per byte with
/// lane 0 in the low bits. count is a multiple of 4. Returns the last state.
pub fn gen_wp(wp : []u8, count : usize, seed : u64) -> u64 {
    var s : u64 = seed;
    var i : usize = 0;
    while (i < count) {
        var byte : u32 = 0;
        var lane : u32 = 0;
        while (lane < 4) {
            s = lcg(s);
            const code : u32 = ((s >> 16) % 4) as u32;
            byte = byte | (code << (lane * 2));
            lane += 1;
        }
        wp[i / 4] = byte as u8;
        i += 4;
    }
    return s;
}

/// Code i of the packed matrix.
pub fn code_at(wp : []const u8, i : usize) -> u32 {
    const b : u32 = wp[i / 4] as u32;
    const sh : u32 = ((i % 4) * 2) as u32;
    return (b >> sh) & 3;
}

/// The decode the kernel runs: (c & 1) - ((c >> 1) & 1); 0 -> 0, 1 -> +1, 2 -> -1, 3 -> 0.
pub fn weight(code : u32) -> i32 {
    return ((code & 1) as i32) - (((code >> 1) & 1) as i32);
}

/// acc[0..n) = row `row` of A x W, k-outer so the codes are read in memory order.
pub fn ref_row(a : []const i8, wp : []const u8, n : usize, k : usize, row : usize, acc : []i32) -> void {
    var j : usize = 0;
    while (j < n) {
        acc[j] = 0;
        j += 1;
    }
    var kk : usize = 0;
    while (kk < k) {
        const v : i32 = a[row * k + kk] as i32;
        if (v != 0) {
            const base : usize = kk * n;
            var col : usize = 0;
            while (col < n) {
                acc[col] += v * weight(code_at(wp, base + col));
                col += 1;
            }
        }
        kk += 1;
    }
}

/// Entries of c (m x n) that differ from the reference, over rows 0, stride, 2 stride, ... and always
/// the last row; stride 1 checks every entry. acc is n entries of scratch.
pub fn mismatches(a : []const i8, wp : []const u8, c : []const i32, m : usize, n : usize, k : usize, stride : usize, acc : []i32) -> usize {
    var st : usize = stride;
    if (st == 0) { st = 1; }
    var bad : usize = 0;
    var row : usize = 0;
    while (row < m) {
        ref_row(a, wp, n, k, row, acc);
        var col : usize = 0;
        while (col < n) {
            if (c[row * n + col] != acc[col]) { bad += 1; }
            col += 1;
        }
        if (row + 1 < m and row + st >= m) {
            row = m - 1;
        } else {
            row += st;
        }
    }
    return bad;
}

// ============================================================================
// 5. Test helpers: search the emitted text
// ============================================================================

/// Whether t[at..] starts with s.
fn at_text(t : []const u8, n : usize, at : usize, s : str) -> bool {
    if (at + s.len > n) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (t[at + i] != s[i]) { return false; }
        i += 1;
    }
    return true;
}

/// How many times s occurs in t[0..n).
fn count_text(t : []const u8, n : usize, s : str) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i < n) {
        if (at_text(t, n, i, s)) { c += 1; }
        i += 1;
    }
    return c;
}

// ============================================================================
// 6. Tests
// ============================================================================

test the_text_opens_with_the_ptx_header {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert at_text(&out, m, 0, "// ternary_gemm_s8 -- emitted by t27c from specs/igla/coder/ternary_gemm_ptx.t27");
    assert count_text(&out, m, "\n.version 7.0\n.target sm_80\n.address_size 64\n\n") == 1;
}

test the_entry_takes_three_pointers_and_three_sizes {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, ".visible .entry ternary_gemm_s8(\n    .param .u64 p_a,\n    .param .u64 p_w,\n    .param .u64 p_c,\n    .param .u32 p_m,\n    .param .u32 p_n,\n    .param .u32 p_k\n)\n.maxntid 256, 1, 1\n{\n") == 1;
    assert count_text(&out, m, "    .shared .align 16 .b8 sA[6144];\n") == 1;
    assert count_text(&out, m, "    .shared .align 16 .b8 sB[6144];\n") == 1;
}

test sixteen_int8_mma_per_k_step {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 ") == 16;
    assert count_text(&out, m, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%acc0, %acc1, %acc2, %acc3}, {%fa0, %fa1, %fa2, %fa3}, {%fb0, %fb1}, {%acc0, %acc1, %acc2, %acc3};\n") == 1;
    assert count_text(&out, m, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%acc20, %acc21, %acc22, %acc23}, {%fa4, %fa5, %fa6, %fa7}, {%fb2, %fb3}, {%acc20, %acc21, %acc22, %acc23};\n") == 1;
    assert count_text(&out, m, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%acc60, %acc61, %acc62, %acc63}, {%fa12, %fa13, %fa14, %fa15}, {%fb6, %fb7}, {%acc60, %acc61, %acc62, %acc63};\n") == 1;
    assert count_text(&out, m, "dp4a") == 0;
}

test every_accumulator_starts_at_zero_once {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "    mov.b32 %acc") == 64;
    assert count_text(&out, m, "    mov.b32 %acc0, 0;\n") == 1;
    assert count_text(&out, m, "    mov.b32 %acc63, 0;\n") == 1;
}

test fragment_offsets_follow_the_48_byte_stride {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "    ld.shared.u32 ") == 24;
    // A: tile mi at 16 rows x 48 = 768 bytes, the g+8 rows 384 further, the upper k half 16 further.
    assert count_text(&out, m, "    ld.shared.u32 %fa0, [%r25+0];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa1, [%r25+384];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa2, [%r25+16];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa3, [%r25+400];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa13, [%r25+2688];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fa15, [%r25+2704];\n") == 1;
    // B: tile ni at 8 columns x 48 = 384 bytes.
    assert count_text(&out, m, "    ld.shared.u32 %fb6, [%r27+1152];\n") == 1;
    assert count_text(&out, m, "    ld.shared.u32 %fb7, [%r27+1168];\n") == 1;
}

test sixteen_codes_decoded_per_thread_per_k_step {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "    st.shared.u8 ") == 16;
    assert count_text(&out, m, "    shr.u32 %r36, %r35, 0;\n") == 1;
    assert count_text(&out, m, "    shr.u32 %r36, %r35, 30;\n") == 1;
    assert count_text(&out, m, "    st.shared.u8 [%r16+0], %r37;\n") == 1;
    assert count_text(&out, m, "    st.shared.u8 [%r16+720], %r37;\n") == 1;
    assert count_text(&out, m, "    sub.s32 %r37, %r37, %r38;\n") == 16;
}

test thirty_two_guarded_pair_stores {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "st.global.v2.u32 ") == 32;
    assert count_text(&out, m, "    @%p6 st.global.v2.u32 [%rd10], {%acc0, %acc1};\n") == 1;
    assert count_text(&out, m, "    @%p6 st.global.v2.u32 [%rd10], {%acc62, %acc63};\n") == 1;
    assert count_text(&out, m, "    add.u32 %r41, %r39, 56;\n") == 4;
    assert count_text(&out, m, "    add.u32 %r42, %r40, 24;\n") == 8;
}

test one_loop_two_barriers_one_return {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert count_text(&out, m, "\nLOOP_K:\n") == 1;
    assert count_text(&out, m, "\nDONE_K:\n") == 1;
    assert count_text(&out, m, "    bar.sync 0;\n") == 2;
    assert count_text(&out, m, "    add.u32 %r28, %r28, 32;\n    bra LOOP_K;\n") == 1;
    assert at_text(&out, m, m - 11, "    ret;\n}\n");
}

test the_text_is_ascii_and_fits_its_buffer {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    assert m == 21403;
    assert m < PTX_CAP;
    var i : usize = 0;
    while (i < m) {
        assert out[i] == '\n' or (out[i] >= 32 and out[i] < 127);
        i += 1;
    }
}

test a_short_buffer_reports_the_full_length_and_writes_nothing_past_cap {
    var out : [32768]u8 = undefined;
    const m : usize = emit_ptx(&out, PTX_CAP);
    var small : [64]u8 = [7; 64];
    const s : usize = emit_ptx(&small, 32);
    assert s == m;
    assert small[31] == out[31];
    assert small[32] == 7;
    assert small[63] == 7;
}

test emitting_twice_gives_the_same_bytes {
    var a : [32768]u8 = undefined;
    var b : [32768]u8 = undefined;
    const m : usize = emit_ptx(&a, PTX_CAP);
    const k : usize = emit_ptx(&b, PTX_CAP);
    assert k == m;
    var i : usize = 0;
    while (i < m) {
        assert a[i] == b[i];
        i += 1;
    }
}

test the_decode_is_the_gpu_spec_decode {
    // ternary_gemm_gpu.t27 decode: 0 -> 0, 1 -> +1, 2 -> -1, 3 -> 0.
    assert weight(0) == 0;
    assert weight(1) == 1;
    assert weight(2) == -1;
    assert weight(3) == 0;
}

test packing_puts_lane_zero_in_the_low_bits {
    var wp : [4]u8 = [0; 4];
    wp[0] = 0x1B;
    wp[3] = 0x80;
    // 0x1B = 00 01 10 11: lanes 0..3 hold 3, 2, 1, 0.
    assert code_at(&wp, 0) == 3;
    assert code_at(&wp, 1) == 2;
    assert code_at(&wp, 2) == 1;
    assert code_at(&wp, 3) == 0;
    assert code_at(&wp, 15) == 2;
    assert code_at(&wp, 12) == 0;
}

test generated_codes_round_trip_through_the_packing {
    var wp : [8]u8 = [0; 8];
    const last : u64 = gen_wp(&wp, 32, 7);
    var s : u64 = 7;
    var i : usize = 0;
    var seen : [4]usize = [0; 4];
    while (i < 32) {
        s = lcg(s);
        const code : u32 = ((s >> 16) % 4) as u32;
        assert code_at(&wp, i) == code;
        seen[code] += 1;
        i += 1;
    }
    assert s == last;
    assert seen[0] > 0 and seen[1] > 0 and seen[2] > 0 and seen[3] > 0;
}

test generated_activations_span_the_i8_range {
    var a : [4096]i8 = [0; 4096];
    const s : u64 = gen_a(&a, 4096, 1);
    assert s != 1;
    var lo : i32 = 0;
    var hi : i32 = 0;
    var i : usize = 0;
    while (i < 4096) {
        const v : i32 = a[i] as i32;
        if (v < lo) { lo = v; }
        if (v > hi) { hi = v; }
        i += 1;
    }
    assert lo == -128;
    assert hi == 127;
}

test the_reference_row_on_a_hand_case {
    // k = 16, n = 16: a[kk] = kk + 1; w(kk, kk) = +1 for even kk, -1 for odd kk, w(kk, 15 - kk) = 3
    // (a zero), everything else 0. Then acc[j] = (j + 1) for even j and -(j + 1) for odd j.
    var a : [16]i8 = [0; 16];
    var wp : [64]u8 = [0; 64];
    var kk : usize = 0;
    while (kk < 16) {
        a[kk] = (kk + 1) as i8;
        const i : usize = kk * 16 + kk;
        var code : u32 = 1;
        if (kk % 2 == 1) { code = 2; }
        wp[i / 4] = ((wp[i / 4] as u32) | (code << (((i % 4) * 2) as u32))) as u8;
        const z : usize = kk * 16 + 15 - kk;
        if (z != i) { wp[z / 4] = ((wp[z / 4] as u32) | (3 << (((z % 4) * 2) as u32))) as u8; }
        kk += 1;
    }
    var acc : [16]i32 = [5; 16];
    ref_row(&a, &wp, 16, 16, 0, &acc);
    assert acc[0] == 1;
    assert acc[1] == -2;
    assert acc[6] == 7;
    assert acc[15] == -16;
}

test the_extremes_reach_128_k_without_overflow {
    // a = -128 everywhere, w = -1 everywhere: every entry is 128 * k.
    var a : [64]i8 = [-128; 64];
    var wp : [256]u8 = [0xAA; 256];
    var acc : [16]i32 = [0; 16];
    ref_row(&a, &wp, 16, 64, 0, &acc);
    assert acc[0] == 8192;
    assert acc[15] == 8192;
}

test mismatches_count_exactly_the_wrong_entries {
    // m = 3, n = 16, k = 32: c filled from the reference has 0 mismatches; one wrong entry has 1.
    var a : [96]i8 = [0; 96];
    var wp : [128]u8 = [0; 128];
    const s : u64 = gen_a(&a, 96, 3);
    const t : u64 = gen_wp(&wp, 512, s);
    assert t != s;
    var c : [48]i32 = [0; 48];
    var acc : [16]i32 = [0; 16];
    var row : usize = 0;
    while (row < 3) {
        ref_row(&a, &wp, 16, 32, row, &acc);
        var j : usize = 0;
        while (j < 16) {
            c[row * 16 + j] = acc[j];
            j += 1;
        }
        row += 1;
    }
    assert mismatches(&a, &wp, &c, 3, 16, 32, 1, &acc) == 0;
    c[16 + 5] += 1;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 1, &acc) == 1;
    // stride 2 checks rows 0 and 2 only, so the wrong entry in row 1 is not seen;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 2, &acc) == 0;
    // a wrong entry in the last row is seen at any stride.
    c[47] -= 1;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 100, &acc) == 1;
    assert mismatches(&a, &wp, &c, 3, 16, 32, 0, &acc) == 2;
}

test the_500m_shapes_are_accepted {
    assert shape_ok(4096, D_MODEL_500M, D_MODEL_500M) == true;
    assert shape_ok(4096, D_FF_500M, D_MODEL_500M) == true;
    assert shape_ok(4096, D_MODEL_500M, D_FF_500M) == true;
    assert shape_ok(16384, D_FF_500M, D_MODEL_500M) == true;
    assert shape_ok(17, 16, 16) == true;
}

test unsupported_shapes_are_refused {
    assert shape_ok(0, 1280, 1280) == false;
    assert shape_ok(4096, 1288, 1280) == false;
    assert shape_ok(4096, 1280, 1288) == false;
    assert shape_ok(4096, 8, 1280) == false;
    assert shape_ok(4096, 1280, 16777216) == false;
    assert shape_ok(4096, 1280, 16777200) == true;
    assert shape_ok(65535 * 128 + 1, 1280, 1280) == false;
}

test the_grid_covers_every_row_and_column {
    assert grid_dim(1280) == 10;
    assert grid_dim(4096) == 32;
    assert grid_dim(16384) == 128;
    assert grid_dim(129) == 2;
    assert grid_dim(1) == 1;
}

invariant accumulator_cannot_overflow { 128 * K_MAX_I32 <= 2147483647 }

invariant shared_tiles_fit_static_shared_memory { 2 * BM * SMEM_STRIDE <= 49152 }

invariant the_stride_holds_a_k_step_and_keeps_16_byte_rows { SMEM_STRIDE >= BK and SMEM_STRIDE % 16 == 0 }

invariant eight_warps_cover_the_block { (THREADS / 32) * 64 * 32 == BM * BN }

invariant the_500m_shapes_are_whole_blocks { D_MODEL_500M % 128 == 0 and D_FF_500M % 128 == 0 and D_MODEL_500M % BK == 0 }
