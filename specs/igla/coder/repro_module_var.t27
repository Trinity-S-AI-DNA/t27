// t27/specs/igla/coder/repro_module_var.t27
// Repro for blocker: "t27b build refuses module-level var (no writable data section)".
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-repro-module-var;

pub const N : usize = 16;

var buf : [N]f64 = undefined;

pub fn buf_sum() -> f64 {
    var s : f64 = 0.0;
    var i : usize = 0;
    while (i < N) {
        s = s + buf[i];
        i = i + 1;
    }
    return s;
}

test buf_sum_is_zero {
    var i : usize = 0;
    while (i < N) { assert buf[i] == 0.0; i = i + 1; }
    assert buf_sum() == 0.0;
}
