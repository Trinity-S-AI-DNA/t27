// Diversity-oriented generation tests (W107)

test diversity_score_identical {
    const a = "module test(); assign y = a + b; endmodule";
    assert diversity_score(a, a) == 0.0;
}

test diversity_score_completely_different {
    const d = diversity_score("module test(); input a; output b; wire c; assign y = a + b; endmodule", "");
    assert d == 1.0;
}

test diversity_score_partial {
    const d = diversity_score("module test(); input a; output b; assign y = a + b; endmodule", "module test(); assign y = a + b; endmodule");
    assert d > 0.0 && d < 1.0;
}

test generate_diverse_candidates_count {
    var txt : [1024]u8 = undefined;
    var cands : [4]string = undefined;
    const n = generate_diverse_candidates("generate adder module", pl_tiny_bank(), pl_cfg(5), 3, &txt, &cands);
    assert n == 3;
}

test reject_resample_for_sacred_filters_star {
    var cs : [2]string = [
        "module add2(a, b, y); assign y = a + b; endmodule",
        "module mul(a, b, y); assign y = a * b; endmodule"
    ];
    var kept : [2]string = undefined;
    const n = reject_resample_for_sacred(&cs, &kept);
    assert n == 1;
    assert pl_same(kept[0], cs[0]);
}

test reject_resample_for_sacred_all_compliant {
    var cs : [2]string = [
        "module add2(a, b, y); assign y = a + b; endmodule",
        "module add2(a, b, y); assign y = a - b; endmodule"
    ];
    var kept : [2]string = undefined;
    const n = reject_resample_for_sacred(&cs, &kept);
    assert n == 2;
}

test adaptive_temperature_by_sacred_score_compliant {
    assert adaptive_temperature_by_sacred_score(1.0, 1.0) == 1.0;
}

test adaptive_temperature_by_sacred_score_at_risk {
    assert adaptive_temperature_by_sacred_score(0.3, 1.0) == 0.5;
}

test adaptive_temperature_by_sacred_score_moderate {
    assert adaptive_temperature_by_sacred_score(0.7, 1.0) == 0.8;
}

// Hierarchical design Knowledge Graph tests (W111)

test decompose_spec_to_modules_riscv {
    const mods = decompose_spec_to_modules("generate a RISC-V CPU with PC, ALU, and register file");
    assert mods.len == 3;
    assert mods[0].name == "pc";
}

test decompose_spec_to_modules_uart {
    const mods = decompose_spec_to_modules("generate a UART transmitter and receiver");
    assert mods.len == 2;
    assert mods[0].name == "tx";
}

test decompose_spec_to_modules_empty {
    const mods = decompose_spec_to_modules("");
    assert mods.len == 0;
}

test decompose_spec_to_modules_generic {
    const mods = decompose_spec_to_modules("a blinking led");
    assert mods.len == 1;
    assert mods[0].name == "top";
}

test build_knowledge_graph_riscv {
    const mods = decompose_spec_to_modules("generate a RISC-V CPU");
    var eb : [8]KgEdge = undefined;
    var nb : [32]u8 = undefined;
    const kg = build_knowledge_graph(mods, &eb, &nb);
    assert kg.modules.len == 3;
    assert kg.top_name == "pc_top";
    assert kg.edges.len == 0;
}

test build_knowledge_graph_uart_edge {
    const mods = decompose_spec_to_modules("generate a UART");
    var eb : [8]KgEdge = undefined;
    var nb : [32]u8 = undefined;
    const kg = build_knowledge_graph(mods, &eb, &nb);
    assert kg.edges.len == 1;
    assert kg.edges[0].src_mod == "tx" && kg.edges[0].dst_mod == "rx";
    var out : [64]u8 = undefined;
    const n = format_edge(kg.edges[0], &out);
    assert pl_text_is(&out, n, "tx.clk -> rx.clk");
}

test build_knowledge_graph_empty {
    const mods = decompose_spec_to_modules("");
    var eb : [8]KgEdge = undefined;
    var nb : [32]u8 = undefined;
    const kg = build_knowledge_graph(mods, &eb, &nb);
    assert kg.modules.len == 0;
    assert kg.top_name == "empty";
}

test wire_modules_nonempty {
    const mods = decompose_spec_to_modules("generate a UART");
    var eb : [8]KgEdge = undefined;
    var nb : [32]u8 = undefined;
    const kg = build_knowledge_graph(mods, &eb, &nb);
    var out : [1024]u8 = undefined;
    const n = wire_modules(kg, "chain", &out);
    assert n != PIPE_NONE;
    assert n > 0;
    assert pl_match_at(out[0..n], "module", 0);
}

test generate_hierarchical_verilog_contains_modules {
    const mods = decompose_spec_to_modules("generate a UART");
    var eb : [8]KgEdge = undefined;
    var nb : [32]u8 = undefined;
    const kg = build_knowledge_graph(mods, &eb, &nb);
    var out : [2048]u8 = undefined;
    const n = generate_hierarchical_verilog(kg, &out);
    assert n != PIPE_NONE;
    assert pl_has(out[0..n], "module");
    assert pl_has(out[0..n], "endmodule");
}

test validate_kg_connectivity_valid {
    const mods = decompose_spec_to_modules("generate a UART");
    var eb : [8]KgEdge = undefined;
    var nb : [32]u8 = undefined;
    const kg = build_knowledge_graph(mods, &eb, &nb);
    assert validate_kg_connectivity(kg);
}

test validate_kg_connectivity_empty {
    const kg = KnowledgeGraph { modules: &NO_MODULES, edges: &NO_EDGES, top_name: "" };
    assert !validate_kg_connectivity(kg);
}

// Multi-Agent RL orchestration tests (W112)

test orchestrate_agents_with_ppo_selects_generator {
    const state : [2]f32 = [1.0, 2.0];
    const agents : [2]AgentProfile = [
        AgentProfile { name: "Gen", role: "generator", model_size: 1000 },
        AgentProfile { name: "Ver", role: "verifier", model_size: 500 }
    ];
    const action = orchestrate_agents_with_ppo(&state, &agents);
    assert action.agent_id == 0;
}

test orchestrate_agents_with_ppo_empty_agents {
    const state : [1]f32 = [1.0];
    const agents : [0]AgentProfile = [];
    const action = orchestrate_agents_with_ppo(&state, &agents);
    assert action.temperature == 1.0;
}

test compute_team_match_reward_identical {
    assert compute_team_match_reward("module add2(); endmodule", "module add2(); endmodule") == 1.0;
}

test compute_team_match_reward_empty {
    assert compute_team_match_reward("", "") == 1.0;
}

test generate_verilog_ai_end_to_end_sacred {
    var out : [256]u8 = undefined;
    const n = generate_verilog_ai("generate a 2-bit adder", pl_tiny_bank(), pl_cfg(10), &out);
    assert n != PIPE_NONE;
    assert eval::check_sacred_compliance(out[0..n]) == eval::R_SI_1_COMPLIANT;
}

test orchestrate_agents_deterministic {
    const state : [2]f32 = [1.0, 2.0];
    const agents : [2]AgentProfile = [
        AgentProfile { name: "Gen", role: "generator", model_size: 1000 },
        AgentProfile { name: "Ver", role: "verifier", model_size: 500 }
    ];
    const a1 = orchestrate_agents_with_ppo(&state, &agents);
    const a2 = orchestrate_agents_with_ppo(&state, &agents);
    assert a1.agent_id == a2.agent_id && a1.temperature == a2.temperature;
}

test compute_team_match_reward_mismatch {
    assert compute_team_match_reward("abc", "xyz") == 0.0;
}

test generate_verilog_ai_with_formal_reward_increases {
    var out : [256]u8 = undefined;
    const n = generate_verilog_ai("generate a 2-bit adder", pl_tiny_bank(), pl_cfg(10), &out);
    assert n != PIPE_NONE;
    assert eval::check_sacred_compliance(out[0..n]) >= eval::R_SI_1_COMPLIANT;
}

test select_agent_by_ppo_policy_first_generator {
    const st : [1]f32 = [0.0];
    const cands : [2]AgentProfile = [
        AgentProfile { name: "G", role: "generator", model_size: 1000 },
        AgentProfile { name: "V", role: "verifier", model_size: 500 }
    ];
    assert select_agent_by_ppo_policy(&st, &cands) == 0;
}

test select_agent_by_ppo_policy_fallback {
    const st : [1]f32 = [0.0];
    const cands : [1]AgentProfile = [AgentProfile { name: "V", role: "verifier", model_size: 500 }];
    assert select_agent_by_ppo_policy(&st, &cands) == 0;
}

// The generator is found at its own index, not only at 0.
test select_agent_by_ppo_policy_generator_second {
    const st : [1]f32 = [0.0];
    const cands : [2]AgentProfile = [
        AgentProfile { name: "V", role: "verifier", model_size: 500 },
        AgentProfile { name: "G", role: "generator", model_size: 1000 }
    ];
    assert select_agent_by_ppo_policy(&st, &cands) == 1;
}

test temporal_trace_check_with_assert {
    const c = Contract { module_name: "add2", precond: "a>=0", postcond: "y==a+b", invariant_expr: "assert no_overflow", clk: "clk", reset: "rst" };
    assert temporal_trace_check("module add2(); assert (1==1); endmodule", c);
}

test temporal_trace_check_no_assert {
    const c = Contract { module_name: "add2", precond: "a>=0", postcond: "y==a+b", invariant_expr: "no_overflow", clk: "clk", reset: "rst" };
    assert !temporal_trace_check("module add2(); endmodule", c);
}

test generate_verify_debug_nonempty {
    const spec = ModuleSpec { name: "add2", ports: &NO_PORTS, body_hint: "adder" };
    const contracts : [1]Contract = [Contract { module_name: "add2", precond: "", postcond: "", invariant_expr: "assert ok", clk: "clk", reset: "rst" }];
    var acts : [2]AgentAction = undefined;
    const n = generate_verify_debug(spec, &contracts, &acts);
    assert n > 0;
}

// The adder stub contains no assertion, so the loop asks for a debug retry; a
// body hint that carries "assert" ends up in the stub and verifies.
test generate_verify_debug_pass_and_retry {
    const contracts : [1]Contract = [Contract { module_name: "add2", precond: "", postcond: "", invariant_expr: "assert ok", clk: "clk", reset: "rst" }];
    var acts : [2]AgentAction = undefined;
    const plain = ModuleSpec { name: "add2", ports: &NO_PORTS, body_hint: "adder" };
    const n1 = generate_verify_debug(plain, &contracts, &acts);
    assert n1 == 1;
    assert acts[0].config == "debug_retry";
    const checked = ModuleSpec { name: "add2", ports: &NO_PORTS, body_hint: "assert ok" };
    const n2 = generate_verify_debug(checked, &contracts, &acts);
    assert n2 == 1;
    assert acts[0].config == "verify_pass";
}

