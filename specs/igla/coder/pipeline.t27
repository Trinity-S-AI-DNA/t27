// The prefix and suffix variants really carry the feedback comment.
test mutate_for_correctness_variants_text {
    const sample = DataSample { prompt: "p", rtl: "module a(); endmodule", template: "test" };
    var txt : [256]u8 = undefined;
    var vs : [3]DataSample = undefined;
    const n = mutate_for_correctness(sample, "fix", &txt, &vs);
    assert n == 3;
    assert vs[0].rtl == "/* fix */ module a(); endmodule";
    assert vs[1].rtl == "module a(); endmodule /* fix */";
    assert vs[0].prompt == "p /* corrected */";
    assert vs[1].prompt == "p /* v2 */";
}

