// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/pipeline.t27
// End-to-end inference pipeline: prompt -> tokenize -> forward -> decode
// Conceptual stubs for all stages requiring runtime support (BPE, model weights).
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// Conventions of this file (there is no heap in generated Zig):
//   * Text and token streams are written into CALLER-PROVIDED buffers. A writer
//     returns the number of bytes / tokens written, or PIPE_NONE when the buffer
//     is too short (the same value tokenizer.t27 uses for NONE).
//   * Slices returned from arch.t27 point into its static scratch buffers and are
//     valid only until the next call of the same arch function.
//   * Private helpers carry a pl_ prefix so that they never collide with the
//     helpers of the modules whose names are spliced in by `use`.

module igla-coder-pipeline;
use base::types;
use igla::race::bram_weights;
use igla::coder::arch;
use igla::coder::tokenizer;
use igla::coder::eval;

// Why prm and dataset are not imported (t27c use-resolution limits, see the
// report of #10075): `use` splices the private helpers of every imported module
// into this file, and arch, prm, eval and dataset each declare same-named private
// helpers (min_usize, exp_approx, ln_approx, has_substring, check_sacred_compliance,
// BeamCandidate) with different bodies, which t27c marks UNRESOLVED and does not
// splice. So this file declares the two small types it needs (DataSample,
// BeamCandidate: same fields as dataset / arch) and scores steps itself. The
// splicer also does not copy module-level `var` declarations, so the scratch
// buffers that the spliced arch and eval functions write are declared again in
// section 1.1 (same names, same types). Delete that section once use_resolve
// splices `var`.

// ============================================================================
// 1. Types
// ============================================================================

/// DataSample: same fields as igla::coder::dataset::DataSample.
pub const DataSample = struct {
    prompt   : string,
    rtl      : string,
    template : string,
};

/// BeamCandidate: same fields as igla::coder::arch::BeamCandidate.
pub const BeamCandidate = struct {
    token : u32,
    score : f32,
    prefix_len : u32,
};

/// "Buffer too short / not found" marker (same value as tokenizer NONE).
pub const PIPE_NONE : usize = 18446744073709551615;

/// Largest token sequence any stage of this file holds on its stack.
pub const PL_MAX_TOKENS : usize = 256;

/// PipelineConfig: generation hyperparameters.
pub const PipelineConfig = struct {
    max_tokens  : u32,
    temperature : f32,
    top_p       : f32,
};

/// PipelineResult: output + metadata. `generated` is a slice of the caller's buffer.
pub const PipelineResult = struct {
    generated : string,
    token_count : u32,
};

/// Port: module port declaration for hierarchical design.
pub const Port = struct {
    name     : string,
    direction: string,  // "input", "output", "inout"
    width    : u32,
};

/// ModuleSpec: specification of a sub-module in hierarchical design.
pub const ModuleSpec = struct {
    name       : string,
    ports      : []const Port,
    body_hint  : string,
};

/// KgEdge: one port-to-port wire "src_mod.src_port -> dst_mod.dst_port".
pub const KgEdge = struct {
    src_mod  : string,
    src_port : string,
    dst_mod  : string,
    dst_port : string,
};

/// KnowledgeGraph: hierarchical design connectivity graph.
/// Nodes = modules; edges = port-to-port wiring.
pub const KnowledgeGraph = struct {
    modules    : []const ModuleSpec,
    edges      : []const KgEdge,
    top_name   : string,
};

/// Contract: temporal assertion contract for RTL module correctness.
/// Specifies preconditions, postconditions, and invariants for formal checking.
pub const Contract = struct {
    module_name : string,
    precond     : string,   // e.g. "a >= 0 && b >= 0"
    postcond    : string,   // e.g. "y == a + b"
    invariant_expr : string,   // e.g. "no_overflow" (`invariant` is a keyword)
    clk         : string,   // clock signal name
    reset       : string,   // reset signal name
};

/// AgentAction: selected agent + configuration for PPO orchestration.
/// `config` is "verify_pass" / "debug_retry" for the generate-verify-debug loop.
pub const AgentAction = struct {
    agent_id      : u32,
    temperature   : f32,
    use_rag       : bool,
    config        : string,
};

// ============================================================================
// 1.1 Scratch buffers of the spliced arch / eval functions (see the header)
// ============================================================================

var BUF_RMS : [MAX_VEC]f32 = undefined;
var BUF_ATTN : [MAX_VEC]f32 = undefined;
var BUF_ADD : [MAX_VEC]f32 = undefined;
var BUF_FF : [MAX_VEC]f32 = undefined;
var BUF_EMB : [MAX_VEC]f32 = undefined;
var BUF_LOGITS : [MAX_VEC]f32 = undefined;
var BUF_TEMP : [MAX_VEC]f32 = undefined;
var BUF_SOFT : [MAX_VEC]f32 = undefined;
var BUF_MASK : [MAX_VEC]f32 = undefined;
var BUF_DIV : [MAX_VEC]f32 = undefined;
var BUF_CUMUL : [MAX_VEC]f32 = undefined;
var BUF_ROPE_Q : [MAX_VEC]f32 = undefined;
var BUF_ROPE_K : [MAX_VEC]f32 = undefined;
var BUF_WROW : [MAX_ROW]f32 = undefined;
var BUF_W1 : [1]f32 = undefined;
var BUF_OPCODE : [OPCODE_EMBED_DIM]f32 = undefined;
var BUF_IDS : [MAX_IDS]u32 = undefined;
var BUF_TOPK : [MAX_TOPK]u32 = undefined;
var BUF_BEAM : [MAX_BEAMS]BeamCandidate = undefined;
var NO_KV : [1][]f32 = undefined;
var SCRATCH : [SCRATCH_SIZE]u8 = undefined;
var scratch_off : usize = 0;

// arch declares exp_approx / ln_approx, and so does math::constants (f64 versions).
// The two are ambiguous for the splicer, so the arch bodies are repeated here; they
// use arch's exp_taylor / ln_taylor, which are spliced as usual. Drop these two
// functions once arch gives them unique names.

fn exp_approx(x: f32) -> f32 {
    if (x == 0.0) { return 1.0; }
    if (x < 0.0) { return 1.0 / exp_approx(-x); }
    if (x > 1.0) {
        const half = exp_approx(x / 2.0);
        return half * half;
    }
    return exp_taylor(x);
}

fn ln_approx(x: f32) -> f32 {
    if (x <= 0.0) { return 0.0; }
    if (x == 1.0) { return 0.0; }
    if (x < 1.0) { return -ln_approx(1.0 / x); }
    if (x > 1.5) {
        return 0.693147 + ln_approx(x / 2.0);
    }
    return ln_taylor(x - 1.0);
}

// ============================================================================
// 1.5 Private helpers (text writers and string predicates)
// ============================================================================

/// pl_emit_str(out, n, s) -> usize
/// Appends s to out at position n. Returns the new length, or PIPE_NONE when it
/// does not fit (or when n is already PIPE_NONE).
fn pl_emit_str(out: []u8, n: usize, s: string) -> usize {
    if (n == PIPE_NONE) { return PIPE_NONE; }
    if (n > out.len) { return PIPE_NONE; }
    if (out.len - n < s.len) { return PIPE_NONE; }
    var k : usize = 0;
    while (k < s.len) {
        out[n + k] = s[k];
        k = k + 1;
    }
    return n + s.len;
}

/// pl_emit_u32(out, n, v) -> usize
/// Appends the decimal digits of v. Returns the new length or PIPE_NONE.
fn pl_emit_u32(out: []u8, n: usize, v: u32) -> usize {
    if (n == PIPE_NONE) { return PIPE_NONE; }
    var digits : [10]u8 = undefined;
    var cnt : usize = 0;
    var x : u32 = v;
    if (x == 0) {
        digits[0] = 48;
        cnt = 1;
    }
    while (x > 0) {
        digits[cnt] = @intCast(48 + x % 10);
        cnt = cnt + 1;
        x = x / 10;
    }
    var pos : usize = n;
    while (cnt > 0) {
        cnt = cnt - 1;
        if (pos >= out.len) { return PIPE_NONE; }
        out[pos] = digits[cnt];
        pos = pos + 1;
    }
    return pos;
}

/// pl_match_at(s, needle, at) -> bool
/// True when needle occurs in s starting exactly at index `at`.
fn pl_match_at(s: string, needle: string, at: usize) -> bool {
    if (at > s.len) { return false; }
    if (s.len - at < needle.len) { return false; }
    var j : usize = 0;
    while (j < needle.len) {
        if (s[at + j] != needle[j]) { return false; }
        j = j + 1;
    }
    return true;
}

/// pl_has(s, needle) -> bool
/// True when needle occurs anywhere in s (an empty needle always occurs).
fn pl_has(s: string, needle: string) -> bool {
    var i : usize = 0;
    while (i + needle.len <= s.len) {
        if (pl_match_at(s, needle, i)) { return true; }
        i = i + 1;
    }
    return false;
}

/// pl_text_is(buf, n, want) -> bool
/// True when a writer returned n (not PIPE_NONE) and buf[0..n] equals want.
fn pl_text_is(buf: []u8, n: usize, want: string) -> bool {
    if (n == PIPE_NONE) { return false; }
    if (n != want.len) { return false; }
    return pl_match_at(buf[0..n], want, 0);
}

/// pl_same(a, b) -> bool
/// Byte equality of two texts (== is only available against a literal).
fn pl_same(a: string, b: string) -> bool {
    if (a.len != b.len) { return false; }
    return pl_match_at(a, b, 0);
}

/// pl_has_star(s) -> bool
/// True when s contains a '*' (code 42), the R-SI-1 violation marker.
fn pl_has_star(s: string) -> bool {
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] == 42) { return true; }
        i = i + 1;
    }
    return false;
}

/// pl_balanced(s) -> bool
/// True when every '{' (123) is closed by a '}' (125) and none is left open.
fn pl_balanced(s: string) -> bool {
    var depth : usize = 0;
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] == 123) {
            depth = depth + 1;
        }
        if (s[i] == 125) {
            if (depth == 0) { return false; }
            depth = depth - 1;
        }
        i = i + 1;
    }
    return depth == 0;
}

/// pl_equal_count(a, b) -> usize
/// Number of positions in the common prefix length where a and b hold the same byte.
fn pl_equal_count(a: string, b: string) -> usize {
    var matches : usize = 0;
    var i : usize = 0;
    while (i < a.len && i < b.len) {
        if (a[i] == b[i]) { matches = matches + 1; }
        i = i + 1;
    }
    return matches;
}

// ============================================================================
// 2. Stage Stubs
// ============================================================================

/// tokenize_prompt(prompt, out) -> usize
/// Stage 1: Convert natural language prompt to token IDs.
/// Stub: character-level ASCII encoding (tokenizer::tokenize). Real BPE requires
/// runtime. Returns the token count, or PIPE_NONE when out is too short.
pub fn tokenize_prompt(prompt: string, out: []u32) -> usize {
    return tokenizer::tokenize(prompt, out);
}

/// tokenize_prompt_len(prompt) -> usize
/// Number of ASCII tokens of the prompt; 0 when it does not fit PL_MAX_TOKENS.
pub fn tokenize_prompt_len(prompt: string) -> usize {
    var toks : [PL_MAX_TOKENS]u32 = undefined;
    const n = tokenize_prompt(prompt, &toks);
    if (n == PIPE_NONE) { return 0; }
    return n;
}

/// prompt_tokens_hybrid(prompt, out) -> usize
/// Hybrid tokenizer: keyword IDs for Verilog terms, ASCII for other words.
/// Returns the token count, or PIPE_NONE when out is too short.
pub fn prompt_tokens_hybrid(prompt: string, out: []u32) -> usize {
    return tokenizer::tokenize_prompt_hybrid(prompt, out);
}

/// run_forward(tokens, bank) -> []f32
/// Stage 2: Model forward pass. Wired to arch::forward_with_bank.
/// Returns logits from the coder architecture using supplied WeightBank. The
/// slice points into arch scratch memory: use or copy it before the next forward.
pub fn run_forward(tokens: []u32, bank: WeightBank) -> []f32 {
    const out = arch::forward_with_bank(tokens, bank, arch::no_past_kv());
    return out.logits;
}

/// run_forward_copy(tokens, bank, dst) -> usize
/// run_forward whose logits are copied into dst (at most dst.len values), so they
/// survive the next forward pass. Returns the number of logits copied.
pub fn run_forward_copy(tokens: []u32, bank: WeightBank, dst: []f32) -> usize {
    const logits = run_forward(tokens, bank);
    var i : usize = 0;
    while (i < logits.len && i < dst.len) {
        dst[i] = logits[i];
        i = i + 1;
    }
    return i;
}

/// generate_next_token_from_logits(logits, cfg) -> u32
/// Stage 3a: Sample next token using unified sampling from arch.
pub fn generate_next_token_from_logits(logits: []f32, cfg: PipelineConfig) -> u32 {
    return arch::generate_next_token_unified(logits, 4, cfg.temperature, cfg.top_p, 1);
}

/// generate_tokens_recursive(logits, cfg, depth, out) -> usize
/// Stage 3b: Token generation up to `depth` tokens from fixed logits (one
/// unified-sampling call per token; written as a loop, there is no recursion).
/// Returns the number of tokens written (at most out.len); 0 for depth 0 or no logits.
pub fn generate_tokens_recursive(logits: []f32, cfg: PipelineConfig, depth: u32, out: []u32) -> usize {
    if (depth == 0 || logits.len == 0) { return 0; }
    var k : usize = 0;
    while (k < depth && k < out.len) {
        out[k] = generate_next_token_from_logits(logits, cfg);
        k = k + 1;
    }
    return k;
}

/// generate_tokens_autoregressive(input_ids, bank, cfg, depth, out) -> usize
/// True autoregressive generation: forward -> sample -> append -> repeat.
/// Each step re-runs forward_with_bank on the extended token sequence (the
/// sequence is held in a local buffer of PL_MAX_TOKENS ids). Returns the number
/// of tokens written to out: at most depth, out.len and the room left in the
/// local sequence; it stops early when a forward pass yields no logits.
pub fn generate_tokens_autoregressive(input_ids: []const u32, bank: WeightBank, cfg: PipelineConfig, depth: u32, out: []u32) -> usize {
    var ids : [PL_MAX_TOKENS]u32 = undefined;
    var n : usize = 0;
    while (n < input_ids.len && n < PL_MAX_TOKENS) {
        ids[n] = input_ids[n];
        n = n + 1;
    }
    var k : usize = 0;
    while (k < depth && k < out.len && n < PL_MAX_TOKENS) {
        const logits = run_forward(ids[0..n], bank);
        if (logits.len == 0) { return k; }
        const token = generate_next_token_from_logits(logits, cfg);
        out[k] = token;
        ids[n] = token;
        n = n + 1;
        k = k + 1;
    }
    return k;
}

/// decode_tokens(tokens, out) -> usize
/// Convert sampled token IDs to Verilog text. Keyword ids (>= 256) decode through
/// tokenizer::decode_keyword and are separated from the previous text by one
/// space; ids below 256 decode as their ASCII byte (NUL becomes a space); id 0
/// (BOS) and keyword ids with no keyword write nothing.
/// Returns the byte count, or PIPE_NONE when out is too short.
pub fn decode_tokens(tokens: []const u32, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < tokens.len) {
        const t = tokens[i];
        if (t >= 256) {
            const kw = tokenizer::decode_keyword(t);
            if (kw.len > 0) {
                if (n > 0 && n != PIPE_NONE) {
                    if (out[n - 1] != 32) {
                        n = pl_emit_str(out, n, " ");
                    }
                }
                n = pl_emit_str(out, n, kw);
            }
        }
        if (t < 256 && t != tokenizer::BOS_ID) {
            var ch : u8 = tokenizer::decode_char(t);
            if (ch == 0) { ch = 32; }
            if (n == PIPE_NONE || n >= out.len) { return PIPE_NONE; }
            out[n] = ch;
            n = n + 1;
        }
        if (n == PIPE_NONE) { return PIPE_NONE; }
        i = i + 1;
    }
    return n;
}

/// decode_logits(logits, out) -> usize
/// Stage 3c: Convert logits to Verilog text via greedy argmax + decode_tokens.
/// An empty logits slice writes nothing. Returns the byte count or PIPE_NONE.
pub fn decode_logits(logits: []f32, out: []u8) -> usize {
    if (logits.len == 0) { return 0; }
    var one : [1]u32 = undefined;
    one[0] = arch::top_k_argmax(logits, 1);
    return decode_tokens(&one, out);
}

/// fallback_to_template(prompt) -> string
/// Stage 4: Fallback to existing keyword-based template dispatch.
/// Any prompt without a known keyword (including the empty prompt) gets the
/// "unknown" template, so the result is never empty.
pub fn fallback_to_template(prompt: string) -> string {
    if (pl_has(prompt, "cordic")) {
        return "module cordic_rtl(); endmodule";
    }
    if (pl_has(prompt, "adder")) {
        return "module add2(); endmodule";
    }
    if (pl_has(prompt, "booth")) {
        return "module booth_mul(); endmodule";
    }
    return "module unknown(); endmodule";
}

/// pl_fallback_into(prompt, out) -> usize
/// Writes the fallback template for the prompt to out.
fn pl_fallback_into(prompt: string, out: []u8) -> usize {
    return pl_emit_str(out, 0, fallback_to_template(prompt));
}

// ============================================================================
// 3. End-to-End Pipeline
// ============================================================================

/// generate_verilog_ai(prompt, bank, cfg, out) -> usize
/// Full pipeline: tokenize -> forward -> decode.
/// If pipeline stages return empty, falls back to keyword dispatch.
/// Returns the byte count written to out, or PIPE_NONE when out is too short.
pub fn generate_verilog_ai(prompt: string, bank: WeightBank, cfg: PipelineConfig, out: []u8) -> usize {
    var toks : [PL_MAX_TOKENS]u32 = undefined;
    const nt = tokenize_prompt(prompt, &toks);
    if (nt == 0 || nt == PIPE_NONE) {
        return pl_fallback_into(prompt, out);
    }
    const logits = run_forward(toks[0..nt], bank);
    if (logits.len == 0) {
        return pl_fallback_into(prompt, out);
    }
    const nd = decode_logits(logits, out);
    if (nd == PIPE_NONE) { return PIPE_NONE; }
    if (nd == 0) {
        return pl_fallback_into(prompt, out);
    }
    return nd;
}

/// generate_verilog_ai_autoregressive(prompt, bank, cfg, out) -> usize
/// Autoregressive pipeline: tokenize (hybrid) -> forward -> sample -> append -> decode.
/// Uses hybrid tokenizer for keyword-aware prompt encoding.
pub fn generate_verilog_ai_autoregressive(prompt: string, bank: WeightBank, cfg: PipelineConfig, out: []u8) -> usize {
    var toks : [PL_MAX_TOKENS]u32 = undefined;
    const nt = prompt_tokens_hybrid(prompt, &toks);
    if (nt == 0 || nt == PIPE_NONE) {
        return pl_fallback_into(prompt, out);
    }
    var gen : [PL_MAX_TOKENS]u32 = undefined;
    const ng = generate_tokens_autoregressive(toks[0..nt], bank, cfg, cfg.max_tokens, &gen);
    if (ng == 0) {
        return pl_fallback_into(prompt, out);
    }
    const nd = decode_tokens(gen[0..ng], out);
    if (nd == PIPE_NONE) { return PIPE_NONE; }
    if (nd == 0) {
        return pl_fallback_into(prompt, out);
    }
    return nd;
}

/// generate_verilog_ai_with_meta(prompt, bank, cfg, out) -> PipelineResult
/// Pipeline returning structured result with token count. `generated` is a slice
/// of out (empty when out was too short).
pub fn generate_verilog_ai_with_meta(prompt: string, bank: WeightBank, cfg: PipelineConfig, out: []u8) -> PipelineResult {
    var toks : [PL_MAX_TOKENS]u32 = undefined;
    const nt = tokenize_prompt(prompt, &toks);
    var count : u32 = 0;
    if (nt != PIPE_NONE) { count = @intCast(nt); }
    const n = generate_verilog_ai(prompt, bank, cfg, out);
    if (n == PIPE_NONE) {
        return PipelineResult { generated: "", token_count: count };
    }
    return PipelineResult { generated: out[0..n], token_count: count };
}

/// select_best_candidate(candidates) -> BeamCandidate
/// Selects candidate with highest score from beam search results (the earliest
/// wins a tie). An empty list yields the sentinel {token 0, score -999999.0, prefix_len 0}.
pub fn select_best_candidate(candidates: []const BeamCandidate) -> BeamCandidate {
    var best : BeamCandidate = BeamCandidate { token: 0, score: -999999.0, prefix_len: 0 };
    var i : usize = 0;
    while (i < candidates.len) {
        if (candidates[i].score > best.score) {
            best = candidates[i];
        }
        i = i + 1;
    }
    return best;
}

/// pl_step_reward(output) -> f32
/// Step reward in [0, 1] for a generated step: 0.0 for an empty step (syntax and
/// sacred compliance are vacuously true on empty text and must not be paid),
/// otherwise the mean of the syntax and R-SI-1 scores. A local stand-in for
/// prm::compute_step_reward (prm cannot be imported next to arch, see header).
fn pl_step_reward(output: string) -> f32 {
    if (output.len == 0) { return 0.0; }
    return (score_syntax_correctness(output) + score_sacred_constraint(output)) / 2.0;
}

/// beam_search_prm_pipeline(prompt, bank, cfg, beam_width, max_depth, out) -> usize
/// Combines beam search from arch with PRM-style step scoring.
/// Tokenizes prompt, runs beam search, scores the best candidate with the step
/// reward (candidate.score * reward, the prm::score_beam_with_prm rule).
/// If the score > 0.5 returns the decoded best token; otherwise fallback.
pub fn beam_search_prm_pipeline(prompt: string, bank: WeightBank, cfg: PipelineConfig, beam_width: u32, max_depth: u32, out: []u8) -> usize {
    var toks : [PL_MAX_TOKENS]u32 = undefined;
    const nt = prompt_tokens_hybrid(prompt, &toks);
    if (nt == 0 || nt == PIPE_NONE) { return pl_fallback_into(prompt, out); }
    const candidates = arch::generate_beam_search(bank, toks[0..nt], beam_width, max_depth, 0.0);
    if (candidates.len == 0) { return pl_fallback_into(prompt, out); }
    const best = select_best_candidate(candidates);
    const reward = pl_step_reward(fallback_to_template(prompt));
    const scored = best.score * reward;
    if (scored > 0.5) {
        var one : [1]u32 = undefined;
        one[0] = best.token;
        const nd = decode_tokens(&one, out);
        if (nd == PIPE_NONE) { return PIPE_NONE; }
        if (nd > 0) { return nd; }
    }
    return pl_fallback_into(prompt, out);
}

/// prm_scored_pipeline(prompt, bank, cfg, out) -> usize
/// Single-step pipeline with PRM scoring on generated output.
pub fn prm_scored_pipeline(prompt: string, bank: WeightBank, cfg: PipelineConfig, out: []u8) -> usize {
    const n = generate_verilog_ai_autoregressive(prompt, bank, cfg, out);
    if (n == PIPE_NONE) { return PIPE_NONE; }
    const reward = pl_step_reward(out[0..n]);
    if (reward > 0.5) {
        return n;
    }
    return pl_fallback_into(prompt, out);
}

// ============================================================================
// 3.5 Training-Free Correctness Steering
// ============================================================================

/// score_syntax_correctness(rtl) -> f32
/// Returns 1.0 if RTL has module + endmodule and balanced braces.
/// Returns 0.5 if module + endmodule but unbalanced braces.
/// Returns 0.25 if only the module keyword is present.
/// Returns 0.0 otherwise.
pub fn score_syntax_correctness(rtl: string) -> f32 {
    const has_module = pl_has(rtl, "module");
    const has_endmodule = pl_has(rtl, "endmodule");
    const balanced = pl_balanced(rtl);
    if (has_module && has_endmodule && balanced) { return 1.0; }
    if (has_module && has_endmodule) { return 0.5; }
    if (has_module) { return 0.25; }
    return 0.0;
}

/// score_sacred_constraint(rtl) -> f32
/// Returns 1.0 if R-SI-1 compliant (no '*' operators), 0.0 otherwise.
pub fn score_sacred_constraint(rtl: string) -> f32 {
    if (pl_has_star(rtl)) { return 0.0; }
    return 1.0;
}

/// score_synthesis_success(rtl) -> f32
/// Real synthesis scorer via eval::score_rtl_with_yosys.
/// Returns 1.0 if Yosys report confirms synth_ok, 0.0 otherwise.
pub fn score_synthesis_success(rtl: string) -> f32 {
    const report = eval::score_rtl_with_yosys(rtl);
    if (report.synth_ok) { return 1.0; }
    return 0.0;
}

/// reject_resample(sample, score, threshold) -> DataSample
/// If score < threshold, return sample with RTL mutated to fallback template.
/// Otherwise return sample unchanged.
pub fn reject_resample(sample: DataSample, score: f32, threshold: f32) -> DataSample {
    if (score < threshold) {
        const fallback = fallback_to_template(sample.prompt);
        return DataSample { prompt: sample.prompt, rtl: fallback, template: "fallback" };
    }
    return sample;
}

/// mutate_for_correctness(sample, feedback, txt, out) -> usize
/// Generates 3 mutation variants of a sample into out (needs out.len >= 3):
/// 1. Prefix the RTL with a feedback comment (prompt gets " /* corrected */")
/// 2. Suffix the RTL with a feedback comment (prompt gets " /* v2 */")
/// 3. Replace with fallback template
/// The new prompt / RTL texts are written into txt. Returns 3, or PIPE_NONE when
/// txt or out is too small.
pub fn mutate_for_correctness(sample: DataSample, feedback: string, txt: []u8, out: []DataSample) -> usize {
    if (out.len < 3) { return PIPE_NONE; }
    var n : usize = 0;

    var p0 : usize = n;
    n = pl_emit_str(txt, n, sample.prompt);
    n = pl_emit_str(txt, n, " /* corrected */");
    if (n == PIPE_NONE) { return PIPE_NONE; }
    var p0e : usize = n;
    var r0 : usize = n;
    n = pl_emit_str(txt, n, "/* ");
    n = pl_emit_str(txt, n, feedback);
    n = pl_emit_str(txt, n, " */ ");
    n = pl_emit_str(txt, n, sample.rtl);
    if (n == PIPE_NONE) { return PIPE_NONE; }
    var r0e : usize = n;

    var p1 : usize = n;
    n = pl_emit_str(txt, n, sample.prompt);
    n = pl_emit_str(txt, n, " /* v2 */");
    if (n == PIPE_NONE) { return PIPE_NONE; }
    var p1e : usize = n;
    var r1 : usize = n;
    n = pl_emit_str(txt, n, sample.rtl);
    n = pl_emit_str(txt, n, " /* ");
    n = pl_emit_str(txt, n, feedback);
    n = pl_emit_str(txt, n, " */");
    if (n == PIPE_NONE) { return PIPE_NONE; }
    var r1e : usize = n;

    out[0] = DataSample { prompt: txt[p0..p0e], rtl: txt[r0..r0e], template: sample.template };
    out[1] = DataSample { prompt: txt[p1..p1e], rtl: txt[r1..r1e], template: sample.template };
    out[2] = DataSample { prompt: sample.prompt, rtl: fallback_to_template(sample.prompt), template: "fallback" };
    return 3;
}

/// generate_verilog_ai_with_steering(prompt, bank, cfg, out) -> usize
/// Generation pipeline with training-free steering:
/// generate -> score -> filter -> return best (or the fallback template).
pub fn generate_verilog_ai_with_steering(prompt: string, bank: WeightBank, cfg: PipelineConfig, out: []u8) -> usize {
    const n = generate_verilog_ai_autoregressive(prompt, bank, cfg, out);
    var raw : string = "";
    if (n != PIPE_NONE) { raw = out[0..n]; }
    const syn_score = score_syntax_correctness(raw);
    const sac_score = score_sacred_constraint(raw);
    const synth_score = score_synthesis_success(raw);
    const total_score = (syn_score + sac_score + synth_score) / 3.0;
    if (total_score >= 0.6 && n != PIPE_NONE) {
        return n;
    }
    const sample = DataSample { prompt: prompt, rtl: raw, template: "steered" };
    const resampled = reject_resample(sample, total_score, 0.6);
    return pl_emit_str(out, 0, resampled.rtl);
}

/// pl_same_report(a, b) -> bool
/// Field-wise equality of two Yosys reports.
fn pl_same_report(a: YosysReport, b: YosysReport) -> bool {
    return a.lut_count == b.lut_count && a.ff_count == b.ff_count
        && a.carry_count == b.carry_count && a.max_mhz == b.max_mhz
        && a.synth_ok == b.synth_ok;
}

/// select_best_synth_candidate(candidates, idx, best_report, best_candidate) -> string
/// Finds the candidate (from index idx on) with the best Yosys synthesis report.
/// A later candidate replaces the current best only when its report is strictly
/// better (eval::compare_ppa_reports prefers it and it differs); ties keep the
/// earlier candidate. Tracks best_candidate alongside best_report.
pub fn select_best_synth_candidate(candidates: []string, idx: usize, best_report: YosysReport, best_candidate: string) -> string {
    var br : YosysReport = best_report;
    var bc : string = best_candidate;
    var i : usize = idx;
    while (i < candidates.len) {
        const report = eval::score_rtl_with_yosys(candidates[i]);
        const better = eval::compare_ppa_reports(br, report);
        if (pl_same_report(better, report) && !pl_same_report(br, report)) {
            br = report;
            bc = candidates[i];
        }
        i = i + 1;
    }
    return bc;
}

// ============================================================================
// 3.6 Diversity-Oriented Generation (W107)
// ============================================================================

/// pl_keyword_diffs(a, b) -> u32
/// Heuristic: counts how many of {module, endmodule, input, output, wire, assign}
/// differ in presence between two RTL strings.
fn pl_keyword_diffs(a: string, b: string) -> u32 {
    var diffs : u32 = 0;
    if (pl_has(a, "module") != pl_has(b, "module")) { diffs = diffs + 1; }
    if (pl_has(a, "endmodule") != pl_has(b, "endmodule")) { diffs = diffs + 1; }
    if (pl_has(a, "input") != pl_has(b, "input")) { diffs = diffs + 1; }
    if (pl_has(a, "output") != pl_has(b, "output")) { diffs = diffs + 1; }
    if (pl_has(a, "wire") != pl_has(b, "wire")) { diffs = diffs + 1; }
    if (pl_has(a, "assign") != pl_has(b, "assign")) { diffs = diffs + 1; }
    return diffs;
}

/// diversity_score(rtl_a, rtl_b) -> f32
/// Returns 0.0 if identical keywords, up to 1.0 if completely different.
/// Normalized against 6 structural keywords.
pub fn diversity_score(rtl_a: string, rtl_b: string) -> f32 {
    const diffs = pl_keyword_diffs(rtl_a, rtl_b);
    const d : f32 = @floatFromInt(diffs);
    const ratio = d / 6.0;
    if (ratio > 1.0) { return 1.0; }
    return ratio;
}

/// generate_diverse_candidates(prompt, bank, cfg, n, txt, cands) -> usize
/// Generates up to n RTL candidates using the autoregressive pipeline. Candidate
/// texts are written one after another into txt; cands[i] is a slice of txt.
/// Returns the number of candidates produced (at most n and cands.len; fewer when
/// txt runs out).
pub fn generate_diverse_candidates(prompt: string, bank: WeightBank, cfg: PipelineConfig, n: u32, txt: []u8, cands: []string) -> usize {
    var pos : usize = 0;
    var made : usize = 0;
    while (made < n && made < cands.len) {
        const len = generate_verilog_ai_autoregressive(prompt, bank, cfg, txt[pos..txt.len]);
        if (len == PIPE_NONE) { return made; }
        cands[made] = txt[pos..pos + len];
        pos = pos + len;
        made = made + 1;
    }
    return made;
}

/// reject_resample_for_sacred(candidates, out) -> usize
/// Copies only the R-SI-1 compliant candidates into out (at most out.len).
/// Returns how many were kept.
pub fn reject_resample_for_sacred(candidates: []string, out: []string) -> usize {
    var kept : usize = 0;
    var i : usize = 0;
    while (i < candidates.len && kept < out.len) {
        if (score_sacred_constraint(candidates[i]) == 1.0) {
            out[kept] = candidates[i];
            kept = kept + 1;
        }
        i = i + 1;
    }
    return kept;
}

/// generate_verilog_ai_with_diversity_and_sacred(prompt, bank, cfg, out) -> usize
/// W108: Combines diversity-oriented generation with sacred constraint filtering.
/// 1. Generate N diverse candidates via autoregressive pipeline.
/// 2. Filter by R-SI-1 sacred compliance.
/// 3. Score remaining candidates with synthesis proxy (Yosys PPA).
/// 4. Return best candidate; fallback to steering if none pass.
pub fn generate_verilog_ai_with_diversity_and_sacred(prompt: string, bank: WeightBank, cfg: PipelineConfig, out: []u8) -> usize {
    var txt : [2048]u8 = undefined;
    var cands : [4]string = undefined;
    const made = generate_diverse_candidates(prompt, bank, cfg, 4, &txt, &cands);
    var kept : [4]string = undefined;
    const nk = reject_resample_for_sacred(cands[0..made], &kept);
    if (nk == 0) {
        return generate_verilog_ai_with_steering(prompt, bank, cfg, out);
    }
    const first = eval::score_rtl_with_yosys(kept[0]);
    const best = select_best_synth_candidate(kept[0..nk], 0, first, kept[0]);
    return pl_emit_str(out, 0, best);
}

/// adaptive_temperature_by_sacred_score(score, base_temp) -> f32
/// Lowers temperature when sacred compliance is at risk.
/// score: 1.0 = fully compliant. <1.0 = reduce temperature to steer toward structure.
pub fn adaptive_temperature_by_sacred_score(score: f32, base_temp: f32) -> f32 {
    if (score >= 1.0) { return base_temp; }
    if (score >= 0.5) { return base_temp * 0.8; }
    return base_temp * 0.5;
}

// ============================================================================
// 3.7 Hierarchical Design Knowledge Graph (W111)
// ============================================================================

pub const NO_PORTS : [0]Port = [];
pub const NO_EDGES : [0]KgEdge = [];
pub const NO_MODULES : [0]ModuleSpec = [];

pub const RV_PC_PORTS : [2]Port = [
    Port{ .name = "clk", .direction = "input", .width = 1 },
    Port{ .name = "next_pc", .direction = "input", .width = 32 }
];
pub const RV_ALU_PORTS : [3]Port = [
    Port{ .name = "a", .direction = "input", .width = 32 },
    Port{ .name = "b", .direction = "input", .width = 32 },
    Port{ .name = "result", .direction = "output", .width = 32 }
];
pub const RV_REGFILE_PORTS : [2]Port = [
    Port{ .name = "rd_addr", .direction = "input", .width = 5 },
    Port{ .name = "wr_data", .direction = "input", .width = 32 }
];
pub const RV_MODULES : [3]ModuleSpec = [
    ModuleSpec{ .name = "pc", .ports = &RV_PC_PORTS, .body_hint = "program counter" },
    ModuleSpec{ .name = "alu", .ports = &RV_ALU_PORTS, .body_hint = "arithmetic logic unit" },
    ModuleSpec{ .name = "regfile", .ports = &RV_REGFILE_PORTS, .body_hint = "register file" }
];

pub const UART_TX_PORTS : [2]Port = [
    Port{ .name = "clk", .direction = "input", .width = 1 },
    Port{ .name = "tx_data", .direction = "input", .width = 8 }
];
pub const UART_RX_PORTS : [2]Port = [
    Port{ .name = "clk", .direction = "input", .width = 1 },
    Port{ .name = "rx_data", .direction = "output", .width = 8 }
];
pub const UART_MODULES : [2]ModuleSpec = [
    ModuleSpec{ .name = "tx", .ports = &UART_TX_PORTS, .body_hint = "transmitter" },
    ModuleSpec{ .name = "rx", .ports = &UART_RX_PORTS, .body_hint = "receiver" }
];

pub const TOP_PORTS : [1]Port = [
    Port{ .name = "clk", .direction = "input", .width = 1 }
];
pub const GENERIC_MODULES : [1]ModuleSpec = [
    ModuleSpec{ .name = "top", .ports = &TOP_PORTS, .body_hint = "generic top module" }
];

/// decompose_spec_to_modules(spec_text) -> []const ModuleSpec
/// Parses a natural language specification into a list of sub-module specs.
/// Conceptual: keyword-based extraction of module boundaries. The result is one
/// of the static tables above (RISC-V, UART, generic top; empty for empty text).
pub fn decompose_spec_to_modules(spec_text: string) -> []const ModuleSpec {
    if (spec_text.len == 0) { return &NO_MODULES; }
    if (pl_has(spec_text, "RISC-V")) { return &RV_MODULES; }
    if (pl_has(spec_text, "UART")) { return &UART_MODULES; }
    return &GENERIC_MODULES;
}

/// pl_first_shared_port(ports_a, ports_b) -> usize
/// Index in ports_a of the first port whose name also appears in ports_b,
/// or PIPE_NONE.
fn pl_first_shared_port(ports_a: []const Port, ports_b: []const Port) -> usize {
    var ia : usize = 0;
    while (ia < ports_a.len) {
        var ib : usize = 0;
        while (ib < ports_b.len) {
            if (ports_a[ia].name == ports_b[ib].name) { return ia; }
            ib = ib + 1;
        }
        ia = ia + 1;
    }
    return PIPE_NONE;
}

/// build_knowledge_graph(modules, edge_buf, name_buf) -> KnowledgeGraph
/// Constructs a connectivity graph from module specs.
/// Edges are derived from shared port names (clock, reset): for every module pair
/// (i < j) that shares a port, the first shared port yields one edge. Edges are
/// written to edge_buf (at most its length); the top name "<first>_top" is
/// written to name_buf (falls back to "top" if it does not fit). No modules give
/// top_name "empty".
pub fn build_knowledge_graph(modules: []const ModuleSpec, edge_buf: []KgEdge, name_buf: []u8) -> KnowledgeGraph {
    if (modules.len == 0) {
        return KnowledgeGraph { modules: modules, edges: edge_buf[0..0], top_name: "empty" };
    }
    var ne : usize = 0;
    var i : usize = 0;
    while (i < modules.len) {
        var j : usize = i + 1;
        while (j < modules.len) {
            const ia = pl_first_shared_port(modules[i].ports, modules[j].ports);
            if (ia != PIPE_NONE && ne < edge_buf.len) {
                const pname = modules[i].ports[ia].name;
                edge_buf[ne] = KgEdge { src_mod: modules[i].name, src_port: pname, dst_mod: modules[j].name, dst_port: pname };
                ne = ne + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    var top : string = "top";
    var tn : usize = pl_emit_str(name_buf, 0, modules[0].name);
    tn = pl_emit_str(name_buf, tn, "_top");
    if (tn != PIPE_NONE) { top = name_buf[0..tn]; }
    return KnowledgeGraph { modules: modules, edges: edge_buf[0..ne], top_name: top };
}

/// format_edge(e, out) -> usize
/// Renders an edge as "src_mod.src_port -> dst_mod.dst_port".
pub fn format_edge(e: KgEdge, out: []u8) -> usize {
    var n : usize = pl_emit_str(out, 0, e.src_mod);
    n = pl_emit_str(out, n, ".");
    n = pl_emit_str(out, n, e.src_port);
    n = pl_emit_str(out, n, " -> ");
    n = pl_emit_str(out, n, e.dst_mod);
    n = pl_emit_str(out, n, ".");
    n = pl_emit_str(out, n, e.dst_port);
    return n;
}

/// pl_emit_ports_decl(out, n, ports) -> usize
/// Appends "dir [w-1:0] name" for each port, separated by ", ".
fn pl_emit_ports_decl(out: []u8, n: usize, ports: []const Port) -> usize {
    var m : usize = n;
    var i : usize = 0;
    while (i < ports.len) {
        if (i > 0) { m = pl_emit_str(out, m, ", "); }
        m = pl_emit_str(out, m, ports[i].direction);
        m = pl_emit_str(out, m, " [");
        var hi : u32 = 0;
        if (ports[i].width > 0) { hi = ports[i].width - 1; }
        m = pl_emit_u32(out, m, hi);
        m = pl_emit_str(out, m, ":0] ");
        m = pl_emit_str(out, m, ports[i].name);
        i = i + 1;
    }
    return m;
}

/// pl_emit_top_ports(out, n, modules) -> usize
/// Appends the port declarations of all modules; modules with ports are
/// separated by ",\n" (a module without ports adds nothing).
fn pl_emit_top_ports(out: []u8, n: usize, modules: []const ModuleSpec) -> usize {
    var m : usize = n;
    var wrote : bool = false;
    var i : usize = 0;
    while (i < modules.len) {
        if (modules[i].ports.len > 0) {
            if (wrote) { m = pl_emit_str(out, m, ",\n"); }
            m = pl_emit_ports_decl(out, m, modules[i].ports);
            wrote = true;
        }
        i = i + 1;
    }
    return m;
}

/// pl_emit_instances(out, n, modules) -> usize
/// Appends one instantiation per module: "  name uK(\n    .p(p),\n  );\n".
fn pl_emit_instances(out: []u8, n: usize, modules: []const ModuleSpec) -> usize {
    var m : usize = n;
    var i : usize = 0;
    while (i < modules.len) {
        m = pl_emit_str(out, m, "  ");
        m = pl_emit_str(out, m, modules[i].name);
        m = pl_emit_str(out, m, " u");
        m = pl_emit_u32(out, m, @intCast(i));
        m = pl_emit_str(out, m, "(\n");
        const ports = modules[i].ports;
        var k : usize = 0;
        while (k < ports.len) {
            m = pl_emit_str(out, m, "    .");
            m = pl_emit_str(out, m, ports[k].name);
            m = pl_emit_str(out, m, "(");
            m = pl_emit_str(out, m, ports[k].name);
            m = pl_emit_str(out, m, ")");
            if (k + 1 < ports.len) {
                m = pl_emit_str(out, m, ",\n");
            } else {
                m = pl_emit_str(out, m, "\n");
            }
            k = k + 1;
        }
        m = pl_emit_str(out, m, "  );\n");
        i = i + 1;
    }
    return m;
}

/// wire_modules(kg, topology, out) -> usize
/// Generates a Verilog top-level wiring module from a knowledge graph.
/// Topology: "chain", "tree", "mesh", "bus" (accepted for the interface; every
/// topology currently instantiates the modules side by side).
pub fn wire_modules(kg: KnowledgeGraph, topology: string, out: []u8) -> usize {
    if (kg.modules.len == 0) { return pl_emit_str(out, 0, "module empty(); endmodule"); }
    var n : usize = pl_emit_str(out, 0, "module ");
    n = pl_emit_str(out, n, kg.top_name);
    n = pl_emit_str(out, n, "(\n");
    n = pl_emit_top_ports(out, n, kg.modules);
    n = pl_emit_str(out, n, ");\n");
    n = pl_emit_instances(out, n, kg.modules);
    n = pl_emit_str(out, n, "endmodule\n");
    return n;
}

/// pl_body_template(hint) -> string
/// RTL body text for a known body hint, or "" for an unknown hint.
fn pl_body_template(hint: string) -> string {
    if (hint == "adder") {
        return "  assign y = a + b;";
    }
    if (hint == "program counter") {
        return "  reg [31:0] pc_reg;\n  always @(posedge clk) pc_reg <= next_pc;";
    }
    if (hint == "arithmetic logic unit") {
        return "  assign result = a + b;";
    }
    if (hint == "register file") {
        return "  reg [31:0] regs [0:31];\n  always @(posedge clk) if (wr_en) regs[wr_addr] <= wr_data;";
    }
    if (hint == "transmitter") {
        return "  reg [3:0] bit_cnt;\n  always @(posedge clk) if (tx_start) bit_cnt <= 4'd0;";
    }
    if (hint == "receiver") {
        return "  reg [3:0] bit_cnt;\n  always @(posedge clk) if (rx_ready) bit_cnt <= bit_cnt + 1;";
    }
    return "";
}

/// pl_emit_body(out, n, hint) -> usize
/// Appends the body for a hint: the template, or "  // Body: <hint>".
fn pl_emit_body(out: []u8, n: usize, hint: string) -> usize {
    const t = pl_body_template(hint);
    if (t.len > 0) { return pl_emit_str(out, n, t); }
    var m : usize = pl_emit_str(out, n, "  // Body: ");
    m = pl_emit_str(out, m, hint);
    return m;
}

/// generate_module_body(spec, body_hint, out) -> usize
/// Generates a real module body from a body hint by dispatching to template library.
/// Replaces TODO stubs with actual RTL implementations. The spec only names the
/// module; the body depends on the hint.
pub fn generate_module_body(spec: ModuleSpec, body_hint: string, out: []u8) -> usize {
    if (spec.name.len == 0) { return pl_emit_body(out, 0, body_hint); }
    return pl_emit_body(out, 0, body_hint);
}

/// resolve_port_widths(ports) -> []const Port
/// Infers and resolves port widths from connectivity context.
/// Currently returns ports unchanged (conceptual width resolution).
pub fn resolve_port_widths(ports: []const Port) -> []const Port {
    return ports;
}

/// generate_module_stubs(modules, out) -> usize
/// One stub per module: "module name(ports);\n<body>\nendmodule\n\n".
pub fn generate_module_stubs(modules: []const ModuleSpec, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < modules.len) {
        n = pl_emit_str(out, n, "module ");
        n = pl_emit_str(out, n, modules[i].name);
        n = pl_emit_str(out, n, "(");
        n = pl_emit_ports_decl(out, n, modules[i].ports);
        n = pl_emit_str(out, n, ");\n");
        n = pl_emit_body(out, n, modules[i].body_hint);
        n = pl_emit_str(out, n, "\nendmodule\n\n");
        i = i + 1;
    }
    return n;
}

/// generate_hierarchical_verilog(kg, out) -> usize
/// Full hierarchical RTL generation: top wrapper + sub-module stubs.
pub fn generate_hierarchical_verilog(kg: KnowledgeGraph, out: []u8) -> usize {
    var n : usize = wire_modules(kg, "tree", out);
    n = pl_emit_str(out, n, "\n// Sub-module stubs\n");
    if (n == PIPE_NONE) { return PIPE_NONE; }
    const stubs = generate_module_stubs(kg.modules, out[n..out.len]);
    if (stubs == PIPE_NONE) { return PIPE_NONE; }
    return n + stubs;
}

/// connect_modules_by_name(kg, out) -> usize
/// Generates Verilog wiring statements connecting modules by shared port names.
/// One wire is created for the first shared port of each connected module pair.
pub fn connect_modules_by_name(kg: KnowledgeGraph, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < kg.modules.len) {
        var j : usize = i + 1;
        while (j < kg.modules.len) {
            const ia = pl_first_shared_port(kg.modules[i].ports, kg.modules[j].ports);
            if (ia != PIPE_NONE) {
                n = pl_emit_str(out, n, "  wire ");
                n = pl_emit_str(out, n, kg.modules[i].ports[ia].name);
                n = pl_emit_str(out, n, "_net; // connects ");
                n = pl_emit_str(out, n, kg.modules[i].name);
                n = pl_emit_str(out, n, " and ");
                n = pl_emit_str(out, n, kg.modules[j].name);
                n = pl_emit_str(out, n, "\n");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return n;
}

/// validate_kg_connectivity(kg) -> bool
/// Validates that every module in the graph has at least one port
/// and that the top-level module is named.
pub fn validate_kg_connectivity(kg: KnowledgeGraph) -> bool {
    if (kg.modules.len == 0) { return false; }
    if (kg.top_name.len == 0) { return false; }
    var i : usize = 0;
    while (i < kg.modules.len) {
        if (kg.modules[i].ports.len == 0) { return false; }
        i = i + 1;
    }
    return true;
}

// ============================================================================
// 3.8 Multi-Agent RL Orchestration (W112)
// ============================================================================

/// select_agent_by_ppo_policy(state, candidates) -> u32
/// Conceptual PPO policy: select agent with highest state affinity.
/// Stub: returns index of first candidate with role == "generator" (0 if none).
pub fn select_agent_by_ppo_policy(state: []const f32, candidates: []const AgentProfile) -> u32 {
    if (candidates.len == 0 || state.len == 0) { return 0; }
    var i : usize = 0;
    while (i < candidates.len) {
        if (candidates[i].role == "generator") { return @intCast(i); }
        i = i + 1;
    }
    return 0;
}

/// orchestrate_agents_with_ppo(state, agents) -> AgentAction
/// Conceptual PPO-based agent selection for multi-agent RTL generation.
/// Selects the best agent given a 168-dimensional state vector (conceptual).
pub fn orchestrate_agents_with_ppo(state: []const f32, agents: []const AgentProfile) -> AgentAction {
    if (agents.len == 0) { return AgentAction { agent_id: 0, temperature: 1.0, use_rag: false, config: "" }; }
    const selected = select_agent_by_ppo_policy(state, agents);
    return AgentAction { agent_id: selected, temperature: 0.8, use_rag: true, config: "" };
}

/// compute_team_match_reward(output_a, output_b) -> f32
/// Computes mutual-agreement reward for multi-agent cross-verification.
/// 1.0 = perfect match, 0.0 = complete disagreement.
pub fn compute_team_match_reward(output_a: string, output_b: string) -> f32 {
    if (output_a.len == 0 && output_b.len == 0) { return 1.0; }
    if (output_a.len == 0 || output_b.len == 0) { return 0.0; }
    const matches = pl_equal_count(output_a, output_b);
    var min_len : usize = output_a.len;
    if (output_b.len < min_len) { min_len = output_b.len; }
    const m : f32 = @floatFromInt(matches);
    const l : f32 = @floatFromInt(min_len);
    const ratio = m / l;
    if (ratio > 1.0) { return 1.0; }
    return ratio;
}

// ============================================================================
// 5. Generate-Verify-Debug Loop (W116)
// ============================================================================

/// temporal_trace_check(rtl, contract) -> bool
/// Conceptual temporal tracing: verify if RTL satisfies contract conditions.
/// Stub: returns true if RTL contains contract.module_name and "assert", and the
/// contract's invariant_expr also contains "assert".
pub fn temporal_trace_check(rtl: string, contract: Contract) -> bool {
    if (rtl.len == 0 || contract.module_name.len == 0) { return false; }
    const name_ok = pl_has(rtl, contract.module_name);
    const assert_ok = pl_has(rtl, "assert") && pl_has(contract.invariant_expr, "assert");
    return name_ok && assert_ok;
}

/// generate_verify_debug(spec, contracts, out) -> usize
/// Iterative generate-verify-debug loop over a module spec with contract list.
/// Writes one AgentAction per contract attempt into out (at most out.len):
/// config is "verify_pass" when the generated stub passes temporal_trace_check
/// for that contract, "debug_retry" otherwise. Returns the number written.
pub fn generate_verify_debug(spec: ModuleSpec, contracts: []const Contract, out: []AgentAction) -> usize {
    var rtl : [2048]u8 = undefined;
    const specs : [1]ModuleSpec = [spec];
    const n = generate_module_stubs(&specs, &rtl);
    var text : string = "";
    if (n != PIPE_NONE) { text = rtl[0..n]; }
    var i : usize = 0;
    while (i < contracts.len && i < out.len) {
        const ok = temporal_trace_check(text, contracts[i]);
        var cfg : string = "debug_retry";
        if (ok) { cfg = "verify_pass"; }
        out[i] = AgentAction { agent_id: @intCast(i), temperature: 1.0, use_rag: false, config: cfg };
        i = i + 1;
    }
    return i;
}

// ============================================================================
// Tool-Assisted Pipeline Integration -- LLM4RTL-style (arXiv:2606.15500)
// ============================================================================

/// preprocess_pipeline_integration(prompt: string) -> string
/// Calls tool_assisted_preprocess before RTL generation when the prompt
/// contains tabular data (truth tables, Karnaugh maps, waveforms).
/// Improves Pass@1 on combinational tasks by parsing logic upfront.
pub fn preprocess_pipeline_integration(prompt: string) -> string {
    return eval::tool_assisted_preprocess(prompt);
}

// ============================================================================
// Contrastive Learning Primitives -- VerilogCL-style (arXiv:2604.18162)
// ============================================================================

/// structural_similarity(a, b) -> f32
/// Similarity in [0, 1] (1.0 = same structure) used by the contrastive
/// primitives: the shared prefix plus the shared suffix, capped at the shorter
/// text, divided by the shorter length. Two empty texts are identical (1.0); one
/// empty text shares nothing (0.0). A minimal perturbation keeps the head or the
/// tail of the RTL intact, so it scores high; a different operator scores low.
pub fn structural_similarity(a: string, b: string) -> f32 {
    if (a.len == 0 && b.len == 0) { return 1.0; }
    if (a.len == 0 || b.len == 0) { return 0.0; }
    var min_len : usize = a.len;
    if (b.len < min_len) { min_len = b.len; }
    var pre : usize = 0;
    while (pre < min_len && a[pre] == b[pre]) {
        pre = pre + 1;
    }
    var suf : usize = 0;
    while (suf < min_len && a[a.len - 1 - suf] == b[b.len - 1 - suf]) {
        suf = suf + 1;
    }
    var shared : usize = pre + suf;
    if (shared > min_len) { shared = min_len; }
    const s : f32 = @floatFromInt(shared);
    const m : f32 = @floatFromInt(min_len);
    return s / m;
}

/// contrastive_learning_pair(correct_rtl: string, perturbed_rtl: string) -> string
/// Returns a contrastive training pair label: "positive" if perturbed_rtl is
/// a minimally corrupted version of correct_rtl (structural similarity > 0.85),
/// "negative" otherwise.
pub fn contrastive_learning_pair(correct_rtl: string, perturbed_rtl: string) -> string {
    const sim = structural_similarity(correct_rtl, perturbed_rtl);
    if (sim > 0.85) {
        return "positive";
    }
    return "negative";
}

/// perturb_rtl_minimally(rtl, seed, out) -> usize
/// Introduces a single minimal perturbation (e.g., bit-width off-by-one,
/// signal name typo) to generate a hard negative for contrastive training.
/// seed % 3: 0 appends " // perturb: width-1", 1 prepends "// perturb: typo\n",
/// 2 appends "\n// perturb: extra semicolon". Returns the byte count or PIPE_NONE.
pub fn perturb_rtl_minimally(rtl: string, seed: u32, out: []u8) -> usize {
    if (seed % 3 == 0) {
        var n : usize = pl_emit_str(out, 0, rtl);
        n = pl_emit_str(out, n, " // perturb: width-1");
        return n;
    }
    if (seed % 3 == 1) {
        var n : usize = pl_emit_str(out, 0, "// perturb: typo\n");
        n = pl_emit_str(out, n, rtl);
        return n;
    }
    var n : usize = pl_emit_str(out, 0, rtl);
    n = pl_emit_str(out, n, "\n// perturb: extra semicolon");
    return n;
}

/// contrastive_loss(anchor: string, positive: string, negative: string) -> f32
/// Simplified triplet margin loss using structural similarity: zero when the
/// positive is at least `margin` (0.2) more similar to the anchor than the
/// negative is, else margin - (pos_sim - neg_sim).
pub fn contrastive_loss(anchor: string, positive: string, negative: string) -> f32 {
    const pos_sim = structural_similarity(anchor, positive);
    const neg_sim = structural_similarity(anchor, negative);
    const margin : f32 = 0.2;
    const gap = pos_sim - neg_sim;
    if (gap < margin) {
        return margin - gap;
    }
    return 0.0;
}

// ============================================================================
// 3.9 Stage composition and pass-through stages
// ============================================================================

pub const STAGE_IDENTITY : u32 = 0;
pub const STAGE_DOUBLE : u32 = 1;
pub const STAGE_TRIPLE : u32 = 2;
pub const STAGE_QUADRUPLE : u32 = 3;

/// pipeline_token_count(result) -> u32
/// Token count recorded in a pipeline result.
pub fn pipeline_token_count(result: PipelineResult) -> u32 {
    return result.token_count;
}

/// stage_apply(stage, x) -> i32
/// One scalar stage: identity, x2, x3 or x4 (an unknown stage id is the identity).
pub fn stage_apply(stage: u32, x: i32) -> i32 {
    if (stage == STAGE_DOUBLE) { return x * 2; }
    if (stage == STAGE_TRIPLE) { return x * 3; }
    if (stage == STAGE_QUADRUPLE) { return x * 4; }
    return x;
}

/// compose(first, second, x) -> i32
/// Runs stage `first`, then stage `second`, on x.
pub fn compose(first: u32, second: u32, x: i32) -> i32 {
    return stage_apply(second, stage_apply(first, x));
}

/// run_pipeline(input, out) -> usize
/// Token pass-through pipeline: writes the input token stream to out unchanged.
/// Returns the number of tokens written (input.len, or out.len if shorter).
pub fn run_pipeline(input: []const u32, out: []u32) -> usize {
    var i : usize = 0;
    while (i < input.len && i < out.len) {
        out[i] = input[i];
        i = i + 1;
    }
    return i;
}

/// pipeline_f32(input, out) -> usize
/// Length-preserving float stage: copies the values to out unchanged.
pub fn pipeline_f32(input: []const f32, out: []f32) -> usize {
    var i : usize = 0;
    while (i < input.len && i < out.len) {
        out[i] = input[i];
        i = i + 1;
    }
    return i;
}

// ============================================================================
// 4. Tests
// ============================================================================

var PL_TINY_DATA : [1]i16 = [0];
var PL_SMALL_DATA : [4]i16 = [16384, 8192, 4096, 2048];

/// Test bank: one zero weight.
fn pl_tiny_bank() -> WeightBank {
    return WeightBank { depth: 1, width: 1, data: &PL_TINY_DATA };
}

/// Test bank: 2x2 weights.
fn pl_small_bank() -> WeightBank {
    return WeightBank { depth: 2, width: 2, data: &PL_SMALL_DATA };
}

/// Test config with the given token budget.
fn pl_cfg(max_tokens: u32) -> PipelineConfig {
    return PipelineConfig { max_tokens: max_tokens, temperature: 1.0, top_p: 1.0 };
}

test tokenize_prompt_empty {
    var toks : [8]u32 = undefined;
    const n = tokenize_prompt("", &toks);
    assert n == 0;
}

test tokenize_prompt_abc {
    var toks : [8]u32 = undefined;
    const n = tokenize_prompt("abc", &toks);
    assert n == 3;
    assert toks[0] == 97 && toks[1] == 98 && toks[2] == 99;
}

test tokenize_prompt_buffer_too_short {
    var toks : [2]u32 = undefined;
    const n = tokenize_prompt("abc", &toks);
    assert n == PIPE_NONE;
}

test run_forward_returns_logits {
    var toks : [3]u32 = [1, 2, 3];
    const logits = run_forward(&toks, pl_tiny_bank());
    assert logits.len == 32000;
}

test generate_next_token_from_logits_valid {
    var logits : [5]f32 = [0.1, 0.5, 0.3, 0.9, 0.2];
    const token = generate_next_token_from_logits(&logits, pl_cfg(10));
    assert token <= 4;
}

test generate_tokens_recursive_depth_zero {
    var logits : [5]f32 = [0.1, 0.5, 0.3, 0.9, 0.2];
    var out : [8]u32 = undefined;
    const n = generate_tokens_recursive(&logits, pl_cfg(10), 0, &out);
    assert n == 0;
}

test generate_tokens_recursive_one_step {
    var logits : [5]f32 = [0.1, 0.5, 0.3, 0.9, 0.2];
    var out : [8]u32 = undefined;
    const n = generate_tokens_recursive(&logits, pl_cfg(10), 1, &out);
    assert n == 1;
    assert out[0] <= 4;
}

// decode_logits writes the decoded argmax token. Token 3 is the ASCII byte 3
// (decode_char), not the digit "3": the original expectation `s == "3"` did not
// match the documented argmax + detokenize behaviour.
test decode_logits_nonempty {
    var logits : [5]f32 = [0.1, 0.5, 0.3, 0.9, 0.2];
    var out : [8]u8 = undefined;
    const n = decode_logits(&logits, &out);
    assert n == 1;
    assert out[0] == 3;
}

test decode_logits_empty {
    var logits : [0]f32 = [];
    var out : [8]u8 = undefined;
    const n = decode_logits(&logits, &out);
    assert n == 0;
}

test fallback_to_template_cordic {
    assert fallback_to_template("generate cordic module") == "module cordic_rtl(); endmodule";
}

test fallback_to_template_unknown {
    assert fallback_to_template("hello world") == "module unknown(); endmodule";
}

test generate_verilog_ai_pipeline {
    var out : [256]u8 = undefined;
    const n = generate_verilog_ai("generate cordic module", pl_tiny_bank(), pl_cfg(10), &out);
    assert n != PIPE_NONE;
    assert n > 0;
    assert !pl_text_is(&out, n, "module pipeline_stub(); endmodule");
}

test generate_verilog_ai_with_meta {
    var out : [256]u8 = undefined;
    const res = generate_verilog_ai_with_meta("abc", pl_tiny_bank(), pl_cfg(10), &out);
    assert res.token_count == 3;
    assert res.generated.len > 0;
}

