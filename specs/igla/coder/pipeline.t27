test generate_verilog_ai_autoregressive_returns_nonempty {
    var out : [256]u8 = undefined;
    const n = generate_verilog_ai_autoregressive("generate cordic module", pl_tiny_bank(), pl_cfg(5), &out);
    assert n != PIPE_NONE;
    assert n > 0;
}

// The stub forward pass (arch::lm_head_from_hidden) ranks logits by index, so the
// sampled token is the last vocabulary id, a keyword id with no keyword text. The
// stream decodes to nothing and the pipeline falls back to the template. (The
// original test expected the AI path here, which the stub model cannot take.)
test generate_verilog_ai_autoregressive_stub_logits_fall_back {
    var out : [256]u8 = undefined;
    const n = generate_verilog_ai_autoregressive("generate cordic module", pl_tiny_bank(), pl_cfg(5), &out);
    assert pl_text_is(&out, n, "module cordic_rtl(); endmodule");
}

// run_forward returns arch scratch memory, so the two passes are copied out
// before they are compared (comparing the slices themselves would compare the
// same memory with itself).
test run_forward_deterministic {
    var toks : [3]u32 = [1, 2, 3];
    var l1 : [32000]f32 = undefined;
    var l2 : [32000]f32 = undefined;
    const n1 = run_forward_copy(&toks, pl_small_bank(), &l1);
    const n2 = run_forward_copy(&toks, pl_small_bank(), &l2);
    assert n1 == n2;
    assert l1[0] == l2[0];
    assert l1[100] == l2[100];
}

test decode_logits_argmax_last {
    var logits : [3]f32 = [0.0, 0.0, 5.0];
    var out : [8]u8 = undefined;
    const n = decode_logits(&logits, &out);
    assert n == 1;
    assert out[0] == 2;
}

// A logits vector longer than 256 can pick a keyword id.
test decode_logits_keyword_id {
    var logits : [300]f32 = undefined;
    var i : usize = 0;
    while (i < 300) {
        logits[i] = 0.0;
        i = i + 1;
    }
    logits[256] = 5.0;
    var out : [16]u8 = undefined;
    const n = decode_logits(&logits, &out);
    assert pl_text_is(&out, n, "module");
}

test tokenize_prompt_hybrid_pipeline {
    var toks : [16]u32 = undefined;
    const n = prompt_tokens_hybrid("module input", &toks);
    assert n == 2;
    assert toks[0] == 256 && toks[1] == 258;
}

test tokenize_prompt_hybrid_mixed_pipeline {
    var toks : [32]u32 = undefined;
    const n = prompt_tokens_hybrid("generate abc module", &toks);
    assert n != PIPE_NONE;
    assert toks[0] == 284 && toks[n - 1] == 256;
}

