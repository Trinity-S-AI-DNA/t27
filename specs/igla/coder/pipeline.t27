    const best = select_best_synth_candidate(&cs, 0, eval::score_rtl_with_yosys(cs[0]), cs[0]);
    assert pl_same(best, cs[0]);
}

test select_best_synth_candidate_prefers_synth_ok {
    // eval::score_rtl_with_yosys fails synthesis only for empty RTL (every other
    // text is mapped to a template report), so the failing candidate is "" here
    // (the original "module bad(); endmodule" scores the same as the adder and
    // a tie keeps the earlier candidate).
    var cs : [2]string = [
        "",
        "module add2(a,b,y); assign y=a+b; endmodule"
    ];
    const best = select_best_synth_candidate(&cs, 0, eval::score_rtl_with_yosys(cs[0]), cs[0]);
    assert pl_same(best, cs[1]);
}

test select_best_synth_candidate_tracks_best_at_base {
    var cs : [2]string = [
        "module good(); endmodule",
        "module bad(); endmodule"
    ];
    const best = select_best_synth_candidate(&cs, 0, eval::score_rtl_with_yosys(cs[0]), cs[0]);
    assert pl_same(best, cs[0]);
}

