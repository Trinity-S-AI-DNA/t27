    const best = select_best_candidate(&cs);
    assert best.token == 1 && best.score == 0.5;
}

test select_best_candidate_highest_score {
    const cs : [3]BeamCandidate = [
        BeamCandidate { token: 1, score: 0.3, prefix_len: 1 },
        BeamCandidate { token: 2, score: 0.9, prefix_len: 1 },
        BeamCandidate { token: 3, score: 0.5, prefix_len: 1 }
    ];
    const best = select_best_candidate(&cs);
    assert best.token == 2;
}

