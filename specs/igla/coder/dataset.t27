// The old `bench dataset_len_nonneg: dataset.len >= 0` named a variable that was never declared and
// asserted a tautology (a slice length is unsigned). It is now a concrete check that the counter
// agrees with the slice length of a generated dataset.
test dataset_len_nonneg {
    const ds = generate_dataset(["adder", "booth"]);
    assert(count_dataset_samples(ds) == ds.len());
    assert(ds.len() > 0);
}


