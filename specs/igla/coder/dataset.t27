    given samples = []DataSample{}
    given threshold = 0.5
    when filtered = filter_dataset_by_quality(samples, threshold)
    then filtered.len() == 0

// dataset_diversity_score is unique templates / total samples, so one sample is 1/1 = 1.0 (the test
// expected 0.0, which contradicts the documented ratio).
test dataset_diversity_score_single_sample_one
    given samples = [DataSample { prompt: "p", rtl: "module a; endmodule", template: "t" }]
    when score = dataset_diversity_score(samples)
    then score == 1.0


// Compositional expansion pairs neighbouring samples, so one sample has no partner and comes back
// unchanged (size 1, as estimate_compositional_size(1, d) == 1). The test expected 2 ("doubles"),
// which contradicts that documented behaviour.
test dataset_expand_compositional_depth_one_single_sample_unchanged
    given base = [DataSample { prompt: "p", rtl: "module a; endmodule", template: "adder" }]
    given depth = 1
    when expanded = expand_dataset_compositional(base, depth)
    then expanded.len() == 1

