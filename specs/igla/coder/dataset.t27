// ============================================================================
// Concrete instances of the former `forall` invariants
// ============================================================================
// The removed `invariant ... forall ...` blocks lowered to "NOT CHECKED (T43)" comptime blocks: they
// proved nothing and could not call the arena functions at comptime. The properties they named are
// checked here on concrete inputs, as real runtime asserts.

// score is in [0, 1]; filtering never grows a dataset; counting agrees with the slice length.
test dataset_bounds_hold_on_generated_dataset {
    const ds = generate_dataset(["adder", "booth", "cordic"]);
    assert(ds.len() == 3);
    assert(count_dataset_samples(ds) == ds.len());
    assert(filter_dataset_by_quality(ds, 0.5).len() <= ds.len());
    assert(filter_dataset_by_quality(ds, 2.0).len() <= ds.len());
    assert(filter_dataset_by_sacred(ds).len() <= ds.len());
    assert(score_dataset_sample(ds[0]) >= 0.0);
    assert(score_dataset_sample(ds[0]) <= 1.0);
    assert(count_unique_templates(ds) == 3);
}

// generate_prompt is never empty for the three known templates (and the unknown default).
test dataset_generate_prompt_nonempty_for_known_templates {
    assert(generate_prompt("cordic").len() > 0);
    assert(generate_prompt("booth").len() > 0);
    assert(generate_prompt("adder").len() > 0);
    assert(generate_prompt("unknown").len() > 0);
}

// Round-trip accuracy is in [0, 1] for identical, partly different and fully different strings.
test dataset_round_trip_accuracy_bounded_instances {
    assert(round_trip_accuracy("abcdef", "abcdef") <= 1.0);
    assert(round_trip_accuracy("abcdef", "abcxyz") >= 0.0);
    assert(round_trip_accuracy("abcdef", "abcxyz") <= 1.0);
    assert(round_trip_accuracy("abc", "xyz") >= 0.0);
    assert(round_trip_accuracy("abc", "xyz") <= 1.0);
}

// Repairing, prefixing and suffixing with non-empty text always makes the RTL longer.
test dataset_mutations_grow_rtl_instances {
    assert(fix_repository_issue("", "x").len() > 0);
    assert(fix_repository_issue("module t(); endmodule", "timing").len() > 21);
    assert(mutate_with_prefix("module t(); endmodule", "// ").len() > 21);
    assert(mutate_with_suffix("module t(); endmodule", " /* end */").len() > 21);
}

// The batch count is exact when the size divides the sample count.
test dataset_batch_count_exact_division_instances {
    assert(batch_count(32, 64) == 2);
    assert(batch_count(10, 10) == 1);
    assert(batch_count(4, 12) == 3);
}
