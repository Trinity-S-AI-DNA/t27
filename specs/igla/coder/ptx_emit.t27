// SPDX-License-Identifier: Apache-2.0
; specs/igla/coder/ptx_emit.t27 -- the PTX text helpers the two HSLM kernel specs share.
; Issue #10930 (duplicate-bodies, 12 helpers copied between ternary_gemm_ptx.t27 and hslm_bwd_ptx.t27).
; --
; What is here. A bounded text writer (put_s, put_u, ins, put_quad), the forward kernel's fragment
; loads, mma step and epilogue (emit_lds, emit_mma_step, emit_store, emit_epilogue), the 2-bit code
; decode (code_at, weight) and two searches over emitted text (at_text, count_text). Both
; ternary_gemm_ptx.t27 (#10404) and hslm_bwd_ptx.t27 (#10847) `use` this module; neither keeps a copy.
; The emitters read SMEM_STRIDE below, which is the value both kernels declare.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-ptx-emit;

/// sA and sB row stride in bytes: 32 data + 16 pad.
pub const SMEM_STRIDE : u32 = 48;

// ============================================================================
// 1. A bounded text writer
// ============================================================================

/// Write s at out[w..]; bytes past cap are counted but not written. Returns the new end.
pub fn put_s(out : []u8, cap : usize, w : usize, s : str) -> usize {
    var i : usize = 0;
    while (i < s.len) {
        if (w + i < cap) { out[w + i] = s[i]; }
        i += 1;
    }
    return w + s.len;
}

/// Write v in decimal at out[w..], bounded by cap like put_s.
pub fn put_u(out : []u8, cap : usize, w : usize, v : u32) -> usize {
    var d : u32 = 1;
    while (v / d >= 10) { d = d * 10; }
    var x : usize = w;
    while (d > 0) {
        const c : u8 = '0' + (((v / d) % 10) as u8);
        if (x < cap) { out[x] = c; }
        x += 1;
        d = d / 10;
    }
    return x;
}

/// One indented instruction line that has no operand to fill in.
pub fn ins(out : []u8, cap : usize, w : usize, s : str) -> usize {
    // One writer call per statement: a nested call would borrow `out` twice in the Rust that gen-rust writes.
    var x : usize = put_s(out, cap, w, "    ");
    x = put_s(out, cap, x, s);
    return put_s(out, cap, x, "\n");
}

/// "{%name<i>, %name<i+1>, %name<i+2>, %name<i+3>}"
pub fn put_quad(out : []u8, cap : usize, w : usize, name : str, first : u32) -> usize {
    var x : usize = put_s(out, cap, w, "{");
    var j : u32 = 0;
    while (j < 4) {
        if (j > 0) { x = put_s(out, cap, x, ", "); }
        x = put_s(out, cap, x, name);
        x = put_u(out, cap, x, first + j);
        j += 1;
    }
    return put_s(out, cap, x, "}");
}

// ============================================================================
// 2. Fragment loads, mma step and epilogue of the forward kernel
// ============================================================================

/// "    ld.shared.u32 %<reg><i>, [%<base>+<off>];"
pub fn emit_lds(out : []u8, cap : usize, w : usize, reg : str, i : u32, base : str, off : u32) -> usize {
    var x : usize = put_s(out, cap, w, "    ld.shared.u32 ");
    x = put_s(out, cap, x, reg);
    x = put_u(out, cap, x, i);
    x = put_s(out, cap, x, ", [");
    x = put_s(out, cap, x, base);
    x = put_s(out, cap, x, "+");
    x = put_u(out, cap, x, off);
    return put_s(out, cap, x, "];\n");
}

/// The fragment loads and the 16 mma.sync of one k-step.
pub fn emit_mma_step(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = w;
    var mi : u32 = 0;
    while (mi < 4) {
        const off : u32 = mi * 16 * SMEM_STRIDE;
        x = emit_lds(out, cap, x, "%fa", mi * 4, "%r25", off);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 1, "%r25", off + 8 * SMEM_STRIDE);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 2, "%r25", off + 16);
        x = emit_lds(out, cap, x, "%fa", mi * 4 + 3, "%r25", off + 8 * SMEM_STRIDE + 16);
        mi += 1;
    }
    var ni : u32 = 0;
    while (ni < 4) {
        x = emit_lds(out, cap, x, "%fb", ni * 2, "%r27", ni * 8 * SMEM_STRIDE);
        x = emit_lds(out, cap, x, "%fb", ni * 2 + 1, "%r27", ni * 8 * SMEM_STRIDE + 16);
        ni += 1;
    }
    mi = 0;
    while (mi < 4) {
        ni = 0;
        while (ni < 4) {
            const b : u32 = (mi * 4 + ni) * 4;
            x = put_s(out, cap, x, "    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 ");
            x = put_quad(out, cap, x, "%acc", b);
            x = put_s(out, cap, x, ", ");
            x = put_quad(out, cap, x, "%fa", mi * 4);
            x = put_s(out, cap, x, ", {%fb");
            x = put_u(out, cap, x, ni * 2);
            x = put_s(out, cap, x, ", %fb");
            x = put_u(out, cap, x, ni * 2 + 1);
            x = put_s(out, cap, x, "}, ");
            x = put_quad(out, cap, x, "%acc", b);
            x = put_s(out, cap, x, ";\n");
            ni += 1;
        }
        mi += 1;
    }
    return x;
}

/// One guarded pair store: accumulators b, b+1 to C[row0 + dr][col0 + dc .. +1].
pub fn emit_store(out : []u8, cap : usize, w : usize, dr : u32, dc : u32, b : u32) -> usize {
    var x : usize = put_s(out, cap, w, "    add.u32 %r41, %r39, ");
    x = put_u(out, cap, x, dr);
    x = put_s(out, cap, x, ";\n");
    x = put_s(out, cap, x, "    add.u32 %r42, %r40, ");
    x = put_u(out, cap, x, dc);
    x = put_s(out, cap, x, ";\n");
    x = ins(out, cap, x, "setp.lt.u32 %p6, %r41, %r1;");
    x = ins(out, cap, x, "setp.lt.u32 %p7, %r42, %r2;");
    x = ins(out, cap, x, "and.pred %p6, %p6, %p7;");
    x = ins(out, cap, x, "cvt.u64.u32 %rd10, %r42;");
    x = ins(out, cap, x, "mad.wide.u32 %rd10, %r41, %r2, %rd10;");
    x = ins(out, cap, x, "shl.b64 %rd10, %rd10, 2;");
    x = ins(out, cap, x, "add.u64 %rd10, %rd10, %rd3;");
    x = put_s(out, cap, x, "    @%p6 st.global.v2.u32 [%rd10], {%acc");
    x = put_u(out, cap, x, b);
    x = put_s(out, cap, x, ", %acc");
    x = put_u(out, cap, x, b + 1);
    return put_s(out, cap, x, "};\n");
}

/// Row base r39 = 128 by + 64 wm + g and column base r40 = 128 bx + 32 wn + 2t, then 32 stores.
pub fn emit_epilogue(out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = ins(out, cap, w, "shl.b32 %r39, %r6, 7;");
    x = ins(out, cap, x, "shl.b32 %r41, %r23, 6;");
    x = ins(out, cap, x, "add.u32 %r39, %r39, %r41;");
    x = ins(out, cap, x, "add.u32 %r39, %r39, %r21;");
    x = ins(out, cap, x, "shl.b32 %r40, %r5, 7;");
    x = ins(out, cap, x, "shl.b32 %r41, %r24, 5;");
    x = ins(out, cap, x, "add.u32 %r40, %r40, %r41;");
    x = ins(out, cap, x, "shl.b32 %r41, %r22, 1;");
    x = ins(out, cap, x, "add.u32 %r40, %r40, %r41;");
    var mi : u32 = 0;
    while (mi < 4) {
        var ni : u32 = 0;
        while (ni < 4) {
            const b : u32 = (mi * 4 + ni) * 4;
            x = emit_store(out, cap, x, mi * 16, ni * 8, b);
            x = emit_store(out, cap, x, mi * 16 + 8, ni * 8, b + 2);
            ni += 1;
        }
        mi += 1;
    }
    return x;
}

// ============================================================================
// 3. The 2-bit code decode
// ============================================================================

/// Code i of the packed matrix.
pub fn code_at(wp : []const u8, i : usize) -> u32 {
    const b : u32 = wp[i / 4] as u32;
    const sh : u32 = ((i % 4) * 2) as u32;
    return (b >> sh) & 3;
}

/// The decode the kernel runs: (c & 1) - ((c >> 1) & 1); 0 -> 0, 1 -> +1, 2 -> -1, 3 -> 0.
pub fn weight(code : u32) -> i32 {
    return ((code & 1) as i32) - (((code >> 1) & 1) as i32);
}

// ============================================================================
// 4. Search the emitted text
// ============================================================================

/// Whether t[at..] starts with s.
pub fn at_text(t : []const u8, n : usize, at : usize, s : str) -> bool {
    if (at + s.len > n) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (t[at + i] != s[i]) { return false; }
        i += 1;
    }
    return true;
}

/// How many times s occurs in t[0..n).
pub fn count_text(t : []const u8, n : usize, s : str) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i < n) {
        if (at_text(t, n, i, s)) { c += 1; }
        i += 1;
    }
    return c;
}


// ============================================================================
// 5. Tests
// ============================================================================

test put_s_counts_every_byte_but_writes_only_below_cap {
    var buf : [8]u8 = [0; 8];
    const e : usize = put_s(&buf, 4, 0, "abcdef");
    assert e == 6;
    assert buf[0] == 'a';
    assert buf[3] == 'd';
    assert buf[4] == 0;
}

test put_u_writes_decimal {
    var buf : [8]u8 = [0; 8];
    assert put_u(&buf, 8, 0, 0) == 1;
    assert buf[0] == '0';
    assert put_u(&buf, 8, 0, 4096) == 4;
    assert buf[0] == '4';
    assert buf[1] == '0';
    assert buf[2] == '9';
    assert buf[3] == '6';
}

test ins_indents_by_four_and_ends_the_line {
    var buf : [16]u8 = [0; 16];
    const e : usize = ins(&buf, 16, 0, "nop;");
    assert e == 9;
    assert at_text(&buf, e, 0, "    nop;\n");
}

test put_quad_names_four_consecutive_registers {
    var buf : [32]u8 = [0; 32];
    const e : usize = put_quad(&buf, 32, 0, "%acc", 4);
    assert e == 28;
    assert at_text(&buf, e, 0, "{%acc4, %acc5, %acc6, %acc7}");
}

test emit_lds_writes_one_shared_load {
    var buf : [64]u8 = [0; 64];
    const e : usize = emit_lds(&buf, 64, 0, "%fa", 3, "%r25", 48);
    assert at_text(&buf, e, 0, "    ld.shared.u32 %fa3, [%r25+48];\n");
}

test at_text_and_count_text_search_the_text {
    var buf : [16]u8 = [0; 16];
    const e : usize = put_s(&buf, 16, 0, "abab ab");
    assert at_text(&buf, e, 2, "ab");
    assert at_text(&buf, e, 6, "abc") == false;
    assert count_text(&buf, e, "ab") == 3;
    assert count_text(&buf, e, "ba") == 1;
}

test one_k_step_has_sixteen_mma_and_the_fragment_loads {
    var buf : [8192]u8 = undefined;
    const e : usize = emit_mma_step(&buf, 8192, 0);
    assert e < 8192;
    assert count_text(&buf, e, "mma.sync") == 16;
    assert count_text(&buf, e, "ld.shared.u32") == 24;
}

test the_epilogue_has_thirty_two_guarded_stores {
    var buf : [16384]u8 = undefined;
    const e : usize = emit_epilogue(&buf, 16384, 0);
    assert e < 16384;
    assert count_text(&buf, e, "st.global.v2.u32") == 32;
}

test the_decode_maps_codes_to_zero_plus_one_minus_one_zero {
    assert weight(0) == 0;
    assert weight(1) == 1;
    assert weight(2) == -1;
    assert weight(3) == 0;
}

test code_at_reads_lane_zero_from_the_low_bits {
    var wp : [2]u8 = [0; 2];
    wp[0] = 0x1B;
    assert code_at(&wp, 0) == 3;
    assert code_at(&wp, 1) == 2;
    assert code_at(&wp, 2) == 1;
    assert code_at(&wp, 3) == 0;
}
