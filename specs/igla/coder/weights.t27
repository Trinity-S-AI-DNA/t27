// 16. Tests: ternary weights and int8 quantization
// ============================================================================

test weights_load_all_plus_ones_count {
    var buf : [8]TernaryWeight = [TernaryWeight { code: 0 }] ** 8;
    const w = load_weights("all_plus", &buf);
    assert w.len == 4;
    assert count_positive(w) == w.len;
    assert all_positive(w);
}

test weights_load_weights_named_sets {
    var buf : [8]TernaryWeight = [TernaryWeight { code: 1 }] ** 8;
    const minus = load_weights("all_minus", &buf);
    assert minus.len == 4;
    assert count_minus(minus) == 4;
    assert all_positive(minus) == false;
    const zero = load_weights("all_zero", &buf);
    assert count_zero(zero) == 4;
    const none = load_weights("nothing", &buf);
    assert none.len == 0;
}

test weights_load_all_plus_ones_count_w294
    given n = 3
    when c = plus_after_load(n)
    then c == 3

test weights_load_all_minus_ones_count_w294
