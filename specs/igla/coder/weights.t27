test weights_load_all_minus_single_count_w299
    given n = 1
    when c = minus_after_load(n)
    then c == 1

test weights_load_all_zero_single_count_w303
    given n = 1
    when c = zero_after_load(n)
    then c == 1

test weights_load_all_zero_count_w306
    given n = 4
    when c = zero_after_load(n)
    then c == 4

// The loaders only count what they were asked for: a zero set has no plus or minus.
test weights_load_all_sets_are_disjoint {
    var buf : [8]TernaryWeight = [TernaryWeight { code: 0 }] ** 8;
    const plus = load_all_plus(3, &buf);
    assert count_plus(plus) == 3;
    assert count_minus(plus) == 0;
    assert count_zero(plus) == 0;
    const minus = load_all_minus(3, &buf);
    assert count_minus(minus) == 3;
    assert count_plus(minus) == 0;
    const zero = load_all_zero(3, &buf);
    assert count_zero(zero) == 3;
    assert count_plus(zero) == 0;
}

// A request larger than the buffer is cut to the buffer.
test weights_load_all_bounded_by_buffer {
    var buf : [2]TernaryWeight = [TernaryWeight { code: 0 }] ** 2;
    const w = load_all_plus(5, &buf);
    assert w.len == 2;
    assert count_plus(w) == 2;
}

test weights_count_plus_three_plus_w299 {
    const w : [3]TernaryWeight = [TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }];
    assert count_plus(&w) == 3;
}

test weights_count_minus_three_minus_w300 {
    const w : [3]TernaryWeight = [TernaryWeight { code: 2 }, TernaryWeight { code: 2 }, TernaryWeight { code: 2 }];
    assert count_minus(&w) == 3;
}

test weights_count_zero_three_zero_w301 {
    const w : [3]TernaryWeight = [TernaryWeight { code: 0 }, TernaryWeight { code: 0 }, TernaryWeight { code: 0 }];
    assert count_zero(&w) == 3;
}

test weights_count_plus_two_plus_w302 {
    const w : [2]TernaryWeight = [TernaryWeight { code: 1 }, TernaryWeight { code: 1 }];
    assert count_plus(&w) == 2;
}

test weights_count_minus_two_minus_w303 {
    const w : [2]TernaryWeight = [TernaryWeight { code: 2 }, TernaryWeight { code: 2 }];
    assert count_minus(&w) == 2;
}

// a mixed set is counted by code
test weights_count_mixed {
    const w : [5]TernaryWeight = [TernaryWeight { code: 1 }, TernaryWeight { code: 2 }, TernaryWeight { code: 0 }, TernaryWeight { code: 1 }, TernaryWeight { code: 2 }];
    assert count_plus(&w) == 2;
    assert count_minus(&w) == 2;
    assert count_zero(&w) == 1;
    assert all_positive(&w) == false;
}

test weights_quantize_symmetric_zero_w304
    given x = 0.0
    when q = quantize_symmetric(x)
    then q == 0

test weights_quantize_symmetric_positive_one_w304
    given x = 1.0
    when q = quantize_symmetric(x)
    then q == 127

test weights_quantize_symmetric_negative_one_w305
    given x = -1.0
    when q = quantize_symmetric(x)
    then q == -127

test weights_quantize_symmetric_half_w305
    given x = 0.5
    when q = quantize_symmetric(x)
    then q == 63

test weights_quantize_symmetric_minus_half_w308
    given x = -0.5
    when q = quantize_symmetric(x)
    then q == -63

test weights_quantize_symmetric_clamps
    given x = 3.0
    when q = quantize_symmetric(x)
    then q == 127 && quantize_symmetric(-3.0) == -127

// ============================================================================
// 17. Invariants (comptime-checked facts)
// ============================================================================

invariant checkpoint_magic_known
    assert header_is_known(parse_checkpoint_header("")) && header_is_known(parse_safetensors_header(""))

invariant checkpoint_version_supported
    assert parse_checkpoint_header("").version == 0 && parse_safetensors_header("").version == 0

invariant save_checkpoint_length_constant
    assert save_checkpoint_trinity_format(CheckpointHeader { magic: 0, tensor_count: 0, version: 0 }, WeightBank { depth: 0, width: 0, data: []i16{} }).len == 20

invariant tensor_bank_index_range
    assert tensor_name_to_bank_index("lm_head.weight") <= 10 && tensor_name_to_bank_index("foo.bar") == UNKNOWN_TENSOR

invariant parse_json_empty_returns_empty
    assert text_equal("", "") && text_equal("a", "a") && text_equal("a", "b") == false

invariant int4_quantize_zero_is_zero_inv
    assert int4_quantize(0.0) == 0

invariant int4_quantize_negative_half_inv
    assert int4_quantize(-0.5) < 0

invariant int4_quantize_negative_max_inv
    assert int4_quantize(-8.0) == -7

invariant int4_quantize_symmetric_range_inv
    assert int4_quantize(7.0) == 7

invariant weights_int4_roundtrip_zero_inv
    assert int4_roundtrip(0.0) == 0.0

invariant weights_int4_dequantize_zero_inv
    assert int4_dequantize(0) == 0.0

invariant weights_quantize_symmetric_zero_w304_inv
    assert quantize_symmetric(0.0) == 0

invariant weights_quantize_symmetric_negative_one_w305_inv
    assert quantize_symmetric(-1.0) == -127

invariant weights_quantize_symmetric_one_w307_inv
    assert quantize_symmetric(1.0) == 127

invariant weights_quantize_symmetric_half_w308_inv
    assert quantize_symmetric(0.5) == 63

invariant weights_bank_rank_nonneg
    assert weight_bank_rank(WeightBank { depth: 0, width: 0, data: []i16{} }) == 0
