}

// ============================================================================
// 14. Tests: INT4 quantization
// ============================================================================

test int4_quantize_zero
    given value = 0.0
    when code = int4_quantize(value)
    then code == 0

test int4_quantize_zero_is_zero
    given w = 0.0
    when code = int4_quantize(w)
    then code == 0

test int4_quantize_boundary_clamp
    given value = 2.0
    when code = int4_quantize(value)
    then code == 7

test int4_quantize_positive_half
    given w = 0.5
    when code = int4_quantize(w)
    then code > 0

test int4_quantize_negative_half
    given value = -0.5
    when code = int4_quantize(value)
    then code < 0

test weights_int4_quantize_positive_max
    given value = 7.0
    when code = int4_quantize(value)
    then code == 7

test weights_int4_quantize_symmetric_range
    given value = 7.0
    when code = int4_quantize(value)
    then code == 7

// The documented code range is [-7, 7] (symmetric), so -8.0 clamps to -7; the old
// expectation of -8 contradicted that range.
test weights_int4_quantize_negative_max
    given value = -8.0
    when code = int4_quantize(value)
    then code == -7

test weights_int4_quantize_zero_zero
    given value = 0.0
    when code = int4_quantize(value)
    then code == 0

test int4_roundtrip_zero_identity
    given value = 0.0
    when rt = int4_roundtrip(value)
    then rt == 0.0

test weights_int4_roundtrip_zero_identity
    given value = 0.0
    when result = int4_roundtrip(value)
    then result == 0.0

test weights_int4_roundtrip_zero
    given value = 0.0
    when result = int4_roundtrip(value)
    then result == 0.0

// Full scale survives a round trip exactly: 1.0 -> 7 -> 7/7.
test weights_int4_roundtrip_one
    given value = 1.0
    when result = int4_roundtrip(value)
    then result == 1.0

test weights_int4_roundtrip_negative_one
    given value = -1.0
    when result = int4_roundtrip(value)
    then result == -1.0

// INT4 has 15 levels, so 0.5 cannot come back as 0.5: 0.5 * 7 = 3.5 truncates to code 3,
// which dequantizes to 3/7. The old expectations of 0.5 and -0.5 ignored the step of 1/7.
test weights_int4_roundtrip_positive_half {
    assert int4_quantize(0.5) == 3;
    assert @abs(int4_roundtrip(0.5) - 0.4285714) < 0.000001;
    assert @abs(int4_roundtrip(0.5) - 0.5) < 0.1428572;
}

test weights_int4_roundtrip_negative_half {
    assert int4_quantize(-0.5) == -3;
    assert @abs(int4_roundtrip(-0.5) + 0.4285714) < 0.000001;
    assert @abs(int4_roundtrip(-0.5) + 0.5) < 0.1428572;
}

test weights_int4_dequantize_zero
    given code = 0
    when value = int4_dequantize(code)
    then value == 0.0

// One code step is 1/7 of full scale; the old expectations of +-1.0 (and 7.0) treated the
// code as if it were already normalized.
test weights_int4_dequantize_positive_one
    given code = 1
    when value = int4_dequantize(code)
    then @abs(value - 0.1428571) < 0.000001

test weights_int4_dequantize_negative_one
    given code = -1
    when value = int4_dequantize(code)
    then @abs(value + 0.1428571) < 0.000001

test weights_int4_dequantize_symmetric_range
    given code = 7
    when value = int4_dequantize(code)
    then value == 1.0

// Over a sweep of inputs the code stays inside [-7, 7] and is monotone.
test int4_quantize_range {
    var v : f32 = -3.0;
    var prev : i8 = -7;
    while (v <= 3.0) {
        const code = int4_quantize(v);
        assert code >= -7;
        assert code <= 7;
        assert code >= prev;
        prev = code;
        v = v + 0.125;
    }
}

// ============================================================================
// 15. Tests: INT4 bank dequantization
// ============================================================================

test int4_dequantize_bank_empty {
    const codes : [0]i8 = [];
    var buf : [4]i16 = [0] ** 4;
    const bank = int4_dequantize_bank(&codes, 0, 0, &buf);
    assert bank.data.len == 0;
}

test int4_dequantize_bank_empty_codes {
    const codes : [0]i8 = [];
    var buf : [4]i16 = [0] ** 4;
    const bank = int4_dequantize_bank(&codes, 0, 0, &buf);
    assert bank.data.len == 0;
}

test int4_dequantize_bank_depth_mismatch_empty {
    const codes : [0]i8 = [];
    var buf : [4]i16 = [0] ** 4;
    const bank = int4_dequantize_bank(&codes, 0, 0, &buf);
    assert bank.data.len == 0;
}

test int4_dequantize_bank_single_zero {
    const codes : [1]i8 = [0];
    var buf : [1]i16 = [5] ** 1;
    const bank = int4_dequantize_bank(&codes, 1, 1, &buf);
    assert bank.data[0] == 0;
}

// 0.5 quantizes to code 3, which dequantizes to 3/7 (see the roundtrip tests above); the
// old range 0.49..0.51 ignored the 1/7 quantization step.
test int4_dequantize_bank_roundtrip_value {
    var codes : [1]i8 = [0];
    codes[0] = int4_quantize(0.5);
    var buf : [1]i16 = [0] ** 1;
    const bank = int4_dequantize_bank(&codes, 1, 1, &buf);
    const rt : f32 = @as(f32, @floatFromInt(bank.data[0])) / 32767.0;
    assert rt > 0.42;
    assert rt < 0.44;
}

test int4_dequantize_bank_negative_code {
    const codes : [1]i8 = [-4];
    var buf : [1]i16 = [0] ** 1;
    const bank = int4_dequantize_bank(&codes, 1, 1, &buf);
    assert bank.data[0] < 0;
}

test int4_dequantize_bank_max_positive_code {
    const codes : [1]i8 = [7];
    var buf : [1]i16 = [0] ** 1;
    const bank = int4_dequantize_bank(&codes, 1, 1, &buf);
    assert bank.data[0] == 32767;
}

test int4_dequantize_bank_all_zeros {
    const codes : [3]i8 = [0, 0, 0];
    var buf : [3]i16 = [9] ** 3;
    const bank = int4_dequantize_bank(&codes, 1, 3, &buf);
    assert bank.data[0] == 0;
    assert bank.data[1] == 0;
    assert bank.data[2] == 0;
}

test int4_dequantize_bank_depth_one {
    const codes : [1]i8 = [3];
    var buf : [1]i16 = [0] ** 1;
    const bank = int4_dequantize_bank(&codes, 1, 1, &buf);
    assert bank.depth == 1;
}

// When depth * width == codes.len the bank keeps the shape and one value per code.
test int4_dequantize_bank_shape_matches {
    const codes : [6]i8 = [1, -1, 2, -2, 3, -3];
    var buf : [6]i16 = [0] ** 6;
    const bank = int4_dequantize_bank(&codes, 2, 3, &buf);
    assert bank.depth == 2;
    assert bank.width == 3;
    assert bank.data.len == codes.len;
    assert bank.data[0] > 0;
    assert bank.data[1] < 0;
    assert bank.data[0] == 0 - bank.data[1];
}

