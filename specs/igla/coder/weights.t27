test parse_json_u32_array_empty {
    var buf : [8]u32 = [0] ** 8;
    const arr = parse_json_u32_array("", &buf);
    assert arr.len == 0;
}

test parse_json_u32_array_single_digit {
    var buf : [8]u32 = [0] ** 8;
    const arr = parse_json_u32_array("[7]", &buf);
    assert arr.len == 1;
    assert arr[0] == 7;
}

test parse_json_u32_array_two_digits {
    var buf : [8]u32 = [0] ** 8;
    const arr = parse_json_u32_array("[2, 2]", &buf);
    assert arr.len == 2;
    assert arr[0] == 2;
    assert arr[1] == 2;
}

// The buffer bounds the result: 4 digits into a 3-entry buffer keep the first 3.
test parse_json_u32_array_short_buffer {
    var buf : [3]u32 = [0] ** 3;
    const arr = parse_json_u32_array("[1,2,3,4]", &buf);
    assert arr.len == 3;
