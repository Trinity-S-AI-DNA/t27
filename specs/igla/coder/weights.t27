    when c = minus_after_load(n)
    then c == 5

test weights_load_all_zero_count_zero_w295
    given n = 3
    when c = zero_after_load(n)
    then c == 3

test weights_load_all_plus_count_plus_w296
    given n = 10
    when c = plus_after_load(n)
    then c == 10

test weights_load_all_zero_count_zero_w296
    given n = 5
    when c = zero_after_load(n)
    then c == 5

test weights_load_all_plus_large_count_w297
    given n = 100
    when c = plus_after_load(n)
    then c == 100

test weights_load_all_zero_large_count_w297
    given n = 50
    when c = zero_after_load(n)
    then c == 50

test weights_load_all_plus_small_count_w298
    given n = 2
    when c = plus_after_load(n)
