// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/prm.t27
// Process Reward Model (PRM) specification for IGLA CODER
// Step-level verifiable rewards for sacred RTL / Rust code generation
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// NOTE: Written to avoid t27c parser body-truncation on unsupported
// constructs (for loops, .push(), .contains(), +=, **, match, etc), and to
// avoid constructs the Zig backend lowers to invalid Zig (array concatenation
// with '+', slice returns of local arrays, '==' between slices). Aggregating
// functions therefore write into a caller-provided buffer instead of returning
// a slice.
//
// Cross-module references are not lowered by t27c (a `use` line produces no
// import), so this module is self-contained: BeamCandidate and the synthesis
// proxy are defined here rather than taken from arch.t27 / eval.t27.

module igla-coder-prm;

// ============================================================================
// 1. Step Definitions
// ============================================================================

/// A single design step in the RTL / code generation pipeline.
/// StepPRM-RTL evaluates each intermediate sub-task (interface, reset,
/// state-machine, datapath) separately.
pub const Step = struct {
    id          : u32,
    description : string,
    kind        : StepKind,
    input       : string,   // prompt or partial code
    output      : string,   // generated code snippet
};

pub const StepKind = enum {
    InterfaceDecl,      // module / entity / function signature
    ResetLogic,         // initial conditions, reset handling
    StateMachine,       // always_ff / match arms / control flow
    Datapath,           // assignments, arithmetic, combinational
    Testbench,          // test generation, stimulus, assertions
    Integration,        // module instantiation, wiring
};

/// One entry of a PRM-guided beam: a token, its running score and the
/// prefix length it extends.
pub const BeamCandidate = struct {
    token      : u32,
    score      : f32,
    prefix_len : u32,
};

/// A bounded training hyper-parameter: val is expected inside [min, max].
pub const Param = struct {
    key : string,
    val : f32,
    min : f32,
    max : f32,
};

// ============================================================================
// 2. Verifiable Reward Signals
// ============================================================================

/// Each reward signal is verifiable by an oracle (compiler, linter,
/// synthesizer, simulator).  No human judgement required.
pub const RewardSignal = struct {
    name   : string,
    weight : f32,         // relative weight in composite score
    score  : f32,         // [0.0, 1.0]
};

pub const SimResult = struct {
    passed : u32,
    total  : u32,
};

/// Syntax score of a code snippet: 1.0 if it is non-empty and its braces
/// balance, 0.0 otherwise.  Heuristic stand-in for the target-language
/// compiler (semicolons and keywords are not checked).
pub fn reward_syntax_score(code: string, lang: string) -> f32 {
    if (code.len() == 0) {
        return 0.0;
    }
    if (check_syntax(code, lang)) {
        return 1.0;
    }
    return 0.0;
}

/// Compile the generated code snippet.  Return 1.0 if syntax-clean,
/// 0.0 if any syntax error.  Heuristic: non-empty output with balanced braces.
pub fn reward_syntax(step: Step, language: string) -> RewardSignal {
    let score = reward_syntax_score(step.output, language);
    return RewardSignal {
        name: "syntax",
        weight: 1.0,
        score: score,
    };
}

/// Detect whether rhs contains a multiplication operator '*'.
/// Skips '//' line comments and avoids matching inside identifiers.
fn contains_multiply_in_rhs(rhs: string) -> bool {
    return contains_multiply_in_rhs_inner(rhs, 0, false);
}

fn contains_multiply_in_rhs_inner(rhs: string, idx: u32, in_comment: bool) -> bool {
    if (idx >= rhs.len()) {
        return false;
    }
    if (idx + 1 < rhs.len() && rhs[idx] == 47 && rhs[idx + 1] == 47) {
        return contains_multiply_in_rhs_inner(rhs, idx + 2, true);
    }
    if (rhs[idx] == 10) {
        return contains_multiply_in_rhs_inner(rhs, idx + 1, false);
    }
    if (!in_comment && rhs[idx] == 42) {
        return true;
    }
    return contains_multiply_in_rhs_inner(rhs, idx + 1, in_comment);
}

/// Run the target-language linter (rustfmt/clippy for Rust;
/// verilator --lint-only for Verilog; vcom for VHDL).
/// Heuristic: penalize outputs containing a '*' operator (score 0.0, else 1.0).
pub fn reward_lint(step: Step, language: string) -> RewardSignal {
    let score: f32 = if (contains_multiply_in_rhs(step.output)) { 0.0 } else { 1.0 };
    return RewardSignal {
        name: "lint",
        weight: 0.618,
        score: score,
    };
}

/// For RTL steps: check R-SI-1 compliance (zero '*' in assignments).
/// For Rust steps: check unsafe-free (simplified, always compliant).
pub fn reward_sacred_compliance(step: Step, language: string) -> RewardSignal {
    let score: f32 = if (check_sacred_compliance(step.output, language)) { 1.0 } else { 0.0 };
    return RewardSignal {
        name: "sacred_compliance",
        weight: 2.618,
        score: score,
    };
}

/// Simulation pass rate for generated testbenches.
/// Heuristic: 1.0 if output contains "PASS", else 0.0.
pub fn reward_simulation(step: Step) -> RewardSignal {
    let score: f32 = if (contains_pass(step.output)) { 1.0 } else { 0.0 };
    return RewardSignal {
        name: "simulation",
        weight: 1.0,
        score: score,
    };
}

/// Recursively scan for substring "PASS" (case-sensitive).
fn contains_pass(s: string) -> bool {
    return contains_pass_inner(s, 0);
}

fn contains_pass_inner(s: string, idx: u32) -> bool {
    if (idx + 4 > s.len()) {
        return false;
    }
    if (s[idx] == 80 && s[idx + 1] == 65 && s[idx + 2] == 83 && s[idx + 3] == 83) {
        return true;
    }
    return contains_pass_inner(s, idx + 1);
}

/// Local synthesizability proxy: the snippet declares a module and closes it.
/// The real oracle (eval.t27 score_rtl_with_real_yosys) writes a file and runs
/// yosys; it cannot be called from this self-contained module.
fn synth_ok_proxy(code: string) -> bool {
    return contains_keyword(code, "module", 0) && contains_keyword(code, "endmodule", 0);
}

/// Synthesis-in-the-loop score (for RTL only), via the local proxy above.
pub fn reward_synthesis(step: Step) -> RewardSignal {
    let score: f32 = if (synth_ok_proxy(step.output)) { 1.0 } else { 0.0 };
    return RewardSignal {
        name: "synthesis",
        weight: 1.0,
        score: score,
    };
}

fn contains_keyword(s: string, keyword: string, idx: u32) -> bool {
    if (idx + keyword.len() > s.len()) {
        return false;
    }
    if (match_at(s, keyword, idx, 0)) {
        return true;
    }
    return contains_keyword(s, keyword, idx + 1);
}

fn match_at(s: string, needle: string, s_idx: u32, n_idx: u32) -> bool {
    if (n_idx >= needle.len()) {
        return true;
    }
    if (s[s_idx] != needle[n_idx]) {
        return false;
    }
    return match_at(s, needle, s_idx + 1, n_idx + 1);
}

/// True if needle occurs anywhere in haystack (the empty needle always does).
pub fn contains_substring(haystack: string, needle: string) -> bool {
    return contains_keyword(haystack, needle, 0);
}

/// Structural similarity to a golden reference (if available).
/// Heuristic: recursive character-by-character match ratio.
pub fn reward_reference_match(step: Step, golden: string) -> RewardSignal {
    let score = char_match_ratio(step.output, golden, 0, 0);
    return RewardSignal {
        name: "reference_match",
        weight: 0.618,
        score: score,
    };
}

/// Fraction of positions where a and b agree, over the longer length.
/// Two empty strings agree entirely (1.0).
fn char_match_ratio(a: string, b: string, idx: u32, matches: u32) -> f32 {
    let max_len = if (a.len() > b.len()) { a.len() } else { b.len() };
    if (max_len == 0) {
        return 1.0;
    }
    if (idx >= a.len() || idx >= b.len()) {
        return matches as f32 / max_len as f32;
    }
    let new_matches = if (a[idx] == b[idx]) { matches + 1 } else { matches };
    return char_match_ratio(a, b, idx + 1, new_matches);
}

// ============================================================================
// 3. Composite Process Reward
// ============================================================================

/// Weighted sum of the reward signals, normalized by total weight.
/// Returns value in [0.0, 1.0].  A step with no output earns 0.0: lint and
/// sacred compliance are vacuously true on an empty string and must not be
/// paid.  The reference-match signal joins the sum only when a non-empty
/// golden reference is available.
pub fn compute_step_reward(step: Step, language: string, golden: string) -> f32 {
    if (step.output.len() == 0) {
        return 0.0;
    }
    let syntax_r = reward_syntax(step, language);
    let lint_r = reward_lint(step, language);
    let sacred_r = reward_sacred_compliance(step, language);
    let sim_r = reward_simulation(step);
    let ref_r = reward_reference_match(step, golden);
    let ref_weight: f32 = if (golden.len() > 0) { ref_r.weight } else { 0.0 };
    let total_score = syntax_r.score * syntax_r.weight
                    + lint_r.score * lint_r.weight
                    + sacred_r.score * sacred_r.weight
                    + sim_r.score * sim_r.weight
                    + ref_r.score * ref_weight;
    let total_weight = syntax_r.weight + lint_r.weight + sacred_r.weight + sim_r.weight + ref_weight;
    if (total_weight == 0.0) {
        return 0.0;
    }
    return total_score / total_weight;
}

/// For a complete multi-step trajectory, compute cumulative reward.
/// NOTE: Exponential decay is not implemented (decay is accepted for the
/// interface but unused).  Returns the arithmetic mean of per-step rewards.
pub fn compute_trajectory_reward(steps: []Step, language: string,
                                  decay: f32) -> f32 {
    if (steps.len() == 0) {
        return 0.0;
    }
    let sum = trajectory_reward_sum(steps, language, 0, 0.0);
    return sum / steps.len() as f32;
}

fn trajectory_reward_sum(steps: []Step, language: string, idx: u32, acc: f32) -> f32 {
    if (idx >= steps.len()) {
        return acc;
    }
    let r = compute_step_reward(steps[idx], language, "");
    return trajectory_reward_sum(steps, language, idx + 1, acc + r);
}

fn min_usize(a: usize, b: usize) -> usize {
    if (a < b) {
        return a;
    }
    return b;
}

/// score_beam_with_prm(candidate, step, language) -> BeamCandidate
/// Re-scores a beam candidate using PRM step reward.
/// Returns candidate with updated score = candidate.score * prm_reward.
pub fn score_beam_with_prm(candidate: BeamCandidate, step: Step, language: string) -> BeamCandidate {
    let prm_reward = compute_step_reward(step, language, "");
    let new_score = candidate.score * prm_reward;
    return BeamCandidate { token: candidate.token, score: new_score, prefix_len: candidate.prefix_len };
}

/// Write the same candidate into out[idx .. n); returns n.
fn fill_beam(cand: BeamCandidate, out: []BeamCandidate, idx: usize, n: usize) -> usize {
    if (idx >= n) {
        return n;
    }
    out[idx] = cand;
    return fill_beam(cand, out, idx + 1, n);
}

/// prm_guided_beam_search(step, language, beam_width, max_depth, out) -> count
/// Conceptual PRM-guided beam search: the root candidate (token 0, score 1.0)
/// is scored with the PRM and written into out, once per depth level, at most
/// beam_width entries and never more than out can hold.  Returns the number of
/// entries written.
pub fn prm_guided_beam_search(step: Step, language: string, beam_width: u32, max_depth: u32,
                              out: []BeamCandidate) -> usize {
    let initial = BeamCandidate { token: 0, score: 1.0, prefix_len: 1 };
    let scored = score_beam_with_prm(initial, step, language);
    let n = min_usize(min_usize(max_depth, beam_width), out.len());
    return fill_beam(scored, out, 0, n);
}

// ============================================================================
// 4. Training Integration
// ============================================================================

/// Contrastive preference pair: (chosen, rejected) trajectory.
/// Loss = softplus( rejected_sum - chosen_sum ) for numerical stability.
pub fn preference_loss(chosen: []Step, rejected: []Step, language: string) -> f32 {
    let chosen_sum = trajectory_reward_sum(chosen, language, 0, 0.0);
    let rejected_sum = trajectory_reward_sum(rejected, language, 0, 0.0);
    let diff = rejected_sum - chosen_sum;
    return softplus(diff);
}

/// compute_prm_loss(chosen, rejected, language) -> f32
/// Wrapper around preference_loss for a single (chosen, rejected) pair.
/// Returns the softplus contrastive loss for PRM training.
pub fn compute_prm_loss(chosen: []Step, rejected: []Step, language: string) -> f32 {
    return preference_loss(chosen, rejected, language);
}

/// train_prm_step(chosen_batch, rejected_batch, language) -> f32
/// Conceptual single training step over a batch of one-step preference pairs:
/// pair i is (chosen_batch[i], rejected_batch[i]).  Returns the average loss
/// across the pairs.  (A batch of multi-step trajectories would be [][]Step,
/// but the generator lowers a nested slice literal to a tuple, which is not a
/// slice; multi-step pairs go through compute_prm_loss one at a time.)
pub fn train_prm_step(chosen_batch: []Step, rejected_batch: []Step, language: string) -> f32 {
    let n = min_usize(chosen_batch.len(), rejected_batch.len());
    if (n == 0) { return 0.0; }
    let total_loss = train_prm_step_inner(chosen_batch, rejected_batch, language, 0, 0.0);
    return total_loss / n as f32;
}

fn train_prm_step_inner(chosen_batch: []Step, rejected_batch: []Step, language: string, idx: u32, acc: f32) -> f32 {
    if (idx >= chosen_batch.len() || idx >= rejected_batch.len()) { return acc; }
    let chosen_r = compute_step_reward(chosen_batch[idx], language, "");
    let rejected_r = compute_step_reward(rejected_batch[idx], language, "");
    let loss = softplus(rejected_r - chosen_r);
    return train_prm_step_inner(chosen_batch, rejected_batch, language, idx + 1, acc + loss);
}

/// Write the PRM reward of steps[idx .. n) into out[idx .. n); returns n.
fn batch_score_fill(steps: []Step, language: string, out: []f32, idx: usize, n: usize) -> usize {
    if (idx >= n) {
        return n;
    }
    out[idx] = compute_step_reward(steps[idx], language, "");
    return batch_score_fill(steps, language, out, idx + 1, n);
}

/// batch_score_with_prm(steps, language, out) -> count
/// Scores multiple independent steps with the PRM, writing the rewards into
/// the caller's buffer (a parallel array).  Returns the number of scores
/// written: min(steps.len, out.len).
pub fn batch_score_with_prm(steps: []Step, language: string, out: []f32) -> usize {
    let n = min_usize(steps.len(), out.len());
    return batch_score_fill(steps, language, out, 0, n);
}

/// update_prm_weights(current_loss, learning_rate) -> f32
/// Conceptual weight update: returns estimated new loss after one SGD step.
/// Heuristic: loss decreases proportionally to learning_rate.
pub fn update_prm_weights(current_loss: f32, learning_rate: f32) -> f32 {
    if (current_loss <= 0.0) { return 0.0; }
    let new_loss = current_loss * (1.0 - learning_rate);
    if (new_loss < 0.0) { return 0.0; }
    return new_loss;
}

/// evaluate_prm_on_validation(validation_steps, language) -> f32
/// Validation accuracy proxy: fraction of steps with reward > 0.5.
pub fn evaluate_prm_on_validation(validation_steps: []Step, language: string) -> f32 {
    if (validation_steps.len() == 0) { return 0.0; }
    let passed = count_steps_above(validation_steps, language, 0.5, 0, 0);
    return passed as f32 / validation_steps.len() as f32;
}

fn count_steps_above(steps: []Step, language: string, threshold: f32, idx: u32, acc: u32) -> u32 {
    if (idx >= steps.len()) { return acc; }
    let r = compute_step_reward(steps[idx], language, "");
    let inc: u32 = if (r > threshold) { 1 } else { 0 };
    return count_steps_above(steps, language, threshold, idx + 1, acc + inc);
}

/// Number of scores strictly above threshold, from idx on.
pub fn count_above_threshold(scores: []f32, threshold: f32, idx: u32, acc: u32) -> u32 {
    if (idx >= scores.len()) { return acc; }
    let inc: u32 = if (scores[idx] > threshold) { 1 } else { 0 };
    return count_above_threshold(scores, threshold, idx + 1, acc + inc);
}

/// Number of entries that rank before scores[i] when sorted by score,
/// highest first, ties broken by lower index.  Counted over j >= from.
fn rank_of(scores: []f32, i: u32, from: u32, acc: u32) -> u32 {
    if (from >= scores.len()) { return acc; }
    let ahead: u32 = if (scores[from] > scores[i] || (scores[from] == scores[i] && from < i)) { 1 } else { 0 };
    return rank_of(scores, i, from + 1, acc + ahead);
}

fn select_top_fill(scores: []f32, k: u32, out: []u32, i: u32, written: u32) -> u32 {
    if (i >= scores.len()) { return written; }
    let r = rank_of(scores, i, 0, 0);
    if (r < k && r < out.len()) {
        out[r] = i;
        return select_top_fill(scores, k, out, i + 1, written + 1);
    }
    return select_top_fill(scores, k, out, i + 1, written);
}

/// select_top(scores, k, out) -> count
/// Writes into out the indices of the k highest scores, best first (ties go
/// to the lower index).  Returns how many were written: min(k, scores.len,
/// out.len).
pub fn select_top(scores: []f32, k: u32, out: []u32) -> u32 {
    return select_top_fill(scores, k, out, 0, 0);
}

/// Range clamp for a float hyper-parameter.
pub fn clamp(v: f32, lo: f32, hi: f32) -> f32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

/// Saturate an integer to the signed 8-bit range [-128, 127].
pub fn param_bounds_saturate(val: i32) -> i32 {
    if (val < -128) { return -128; }
    if (val > 127) { return 127; }
    return val;
}

/// ln_approx(x: f32) -> f32
/// Natural logarithm: range reduction to x <= 2 (ln 2 added per halving),
/// then the atanh series 2*(z + z^3/3 + z^5/5 + z^7/7), z = (x-1)/(x+1).
/// Error below 2e-5 on (0, inf).
fn ln_approx(x: f32) -> f32 {
    if (x <= 0.0) { return 0.0; }
    if (x == 1.0) { return 0.0; }
    if (x < 1.0) { return -ln_approx(1.0 / x); }
    if (x > 2.0) {
        return 0.693147 + ln_approx(x / 2.0);
    }
    let z = (x - 1.0) / (x + 1.0);
    let z2 = z * z;
    let z3 = z2 * z;
    let z5 = z3 * z2;
    let z7 = z5 * z2;
    return 2.0 * (z + z3 / 3.0 + z5 / 5.0 + z7 / 7.0);
}

/// Stable softplus approximation: ln(1 + exp(x)).
fn softplus(x: f32) -> f32 {
    if (x > 20.0) {
        return x;
    }
    if (x < -20.0) {
        return 0.0;
    }
    let exp_x = exp_approx(x);
    return ln_approx(1.0 + exp_x);
}

/// exp(x): range-reduced by halving until |x| <= 0.5 (exp(x) = exp(x/2)^2),
/// then a 6-term Taylor series 1 + x + x^2/2 + ... + x^5/120 (relative error
/// below 3e-5 on the reduced range).
pub fn exp_approx(x: f32) -> f32 {
    if (x > 0.5 || x < -0.5) {
        let h = exp_approx(x / 2.0);
        return h * h;
    }
    let x2 = x * x;
    let x3 = x2 * x;
    let x4 = x3 * x;
    let x5 = x4 * x;
    return 1.0 + x + x2 / 2.0 + x3 / 6.0 + x4 / 24.0 + x5 / 120.0;
}

// ============================================================================
// 5. Oracle Interfaces (heuristic stand-ins for real tool invocations)
// ============================================================================

/// Check syntax of generated code by invoking the target-language compiler.
/// Heuristic: verify balanced braces recursively.
pub fn check_syntax(code: string, lang: string) -> bool {
    return check_balanced_braces(code, 0, 0);
}

fn check_balanced_braces(s: string, idx: u32, depth: u32) -> bool {
    if (idx >= s.len()) {
        return depth == 0;
    }
    if (s[idx] == 123) {
        return check_balanced_braces(s, idx + 1, depth + 1);
    }
    if (s[idx] == 125) {
        if (depth == 0) {
            return false;
        }
        return check_balanced_braces(s, idx + 1, depth - 1);
    }
    return check_balanced_braces(s, idx + 1, depth);
}

/// Run target-language linter and return warning count.
/// Heuristic: count occurrences of ASCII '*' in code.
pub fn lint_warning_count(code: string, lang: string) -> u32 {
    return count_star(code, 0, 0);
}

fn count_star(s: string, idx: u32, acc: u32) -> u32 {
    if (idx >= s.len()) {
        return acc;
    }
    let inc: u32 = if (s[idx] == 42) { 1 } else { 0 };
    return count_star(s, idx + 1, acc + inc);
}

/// Simulate generated testbench and return (passed, total).
/// Heuristic: return passed=1, total=1 if code contains "PASS".
pub fn run_simulation(tb_code: string) -> SimResult {
    let passed: u32 = if (contains_pass(tb_code)) { 1 } else { 0 };
    return SimResult { passed: passed, total: 1 };
}

/// Check sacred compliance (R-SI-1 for RTL: no '*' in assignments).
/// Languages starting with 'v' (verilog, vhdl) are RTL.
/// For Rust: unsafe-free check (simplified, always true).
/// Implemented locally; does not require external tool.
pub fn check_sacred_compliance(code: string, lang: string) -> bool {
    if (lang.len() > 0 && lang[0] == 118) {
        return !contains_multiply_in_rhs(code);
    }
    return true;
}

// ============================================================================
// 6. Tests
// ============================================================================

test syntax_reward_non_empty
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given language = "verilog"
    when r = reward_syntax(step, language)
    then r.score == 1.0

test syntax_reward_empty
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "" }
    given language = "verilog"
    when r = reward_syntax(step, language)
    then r.score == 0.0

test sacred_compliance_weight
    given step = Step { id: 1, description: "mul", kind: StepKind::Datapath,
                        input: "", output: "assign z = x * y;" }
    given language = "verilog"
    when r = reward_sacred_compliance(step, language)
    then r.weight == 2.618

test trajectory_reward_range
    given s1 = Step { id: 0, description: "s1", kind: StepKind::InterfaceDecl,
                      input: "", output: "" }
    given s2 = Step { id: 1, description: "s2", kind: StepKind::Datapath,
                      input: "", output: "" }
    given traj = [s1, s2]
    when r = compute_trajectory_reward(traj, "verilog", 0.618)
    then r == 0.0

test preference_loss_non_negative
    given good = [Step { id: 0, description: "g", kind: StepKind::Datapath,
                       input: "", output: "assign a = b + c;" }]
    given bad  = [Step { id: 0, description: "b", kind: StepKind::Datapath,
                       input: "", output: "assign z = x * y;" }]
    when loss = preference_loss(good, bad, "verilog")
    then loss >= 0.0

// Measured: good = 0.80902, bad = 0.19098, diff = -0.61804, softplus = 0.4312.
test preference_loss_value
    given good = [Step { id: 0, description: "g", kind: StepKind::Datapath,
                       input: "", output: "assign a = b + c;" }]
    given bad  = [Step { id: 0, description: "b", kind: StepKind::Datapath,
                       input: "", output: "assign z = x * y;" }]
    when loss = preference_loss(good, bad, "verilog")
    then loss > 0.42 && loss < 0.44

test softplus_positive
    when s = softplus(5.0)
    then s > 4.0

test softplus_zero
    when s = softplus(0.0)
    then s > 0.6 && s < 0.8

test softplus_large
    when s = softplus(100.0)
    then s == 100.0

test softplus_negative
    when s = softplus(-10.0)
    then s > 0.0 && s < 0.1

test exp_approx_near_zero
    when e = exp_approx(0.0)
    then e == 1.0

// e^1 = 2.718282, e^-1 = 0.367879, e^5 = 148.4132.
test exp_approx_reduced_range_values
    when e1 = exp_approx(1.0)
    when en1 = exp_approx(-1.0)
    when e5 = exp_approx(5.0)
    then e1 > 2.7182 && e1 < 2.7184 && en1 > 0.3678 && en1 < 0.3680 && e5 > 148.3 && e5 < 148.5

// ln 2 = 0.693147, ln 10 = 2.302585, ln 0.5 = -0.693147.
test ln_approx_values
    when l2 = ln_approx(2.0)
    when l10 = ln_approx(10.0)
    when lh = ln_approx(0.5)
    then l2 > 0.6931 && l2 < 0.6932 && l10 > 2.3025 && l10 < 2.3027 && lh > -0.6932 && lh < -0.6931

test sacred_compliance_verilog_no_mul
    when ok = check_sacred_compliance("assign z = a + b;", "verilog")
    then ok == true

test sacred_compliance_verilog_with_mul
    when ok = check_sacred_compliance("assign z = a * b;", "verilog")
    then ok == false

test sacred_compliance_rust
    when ok = check_sacred_compliance("unsafe { ptr.read() }", "rust")
    then ok == true

// A '*' inside a '//' comment is not an operator; a lone '/' is division,
// not a comment, so the '*' after it still counts.
test sacred_compliance_star_in_comment_ignored
    when ok = check_sacred_compliance("assign z = a + b; // not a * here", "verilog")
    then ok == true

test sacred_compliance_star_after_division_flagged
    when ok = check_sacred_compliance("assign z = a / b * c;", "verilog")
    then ok == false

test reward_synthesis_oracle_ok
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "module test(); endmodule" }
    when r = reward_synthesis(step)
    then r.score == 1.0

test reward_synthesis_oracle_fail
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "" }
    when r = reward_synthesis(step)
    then r.score == 0.0

test reward_synthesis_unclosed_module_fails
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "module test();" }
    when r = reward_synthesis(step)
    then r.score == 0.0

// PRM-guided beam search tests

test score_beam_with_prm_updates_score
    given candidate = BeamCandidate { token: 5, score: 1.0, prefix_len: 1 }
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given language = "verilog"
    when scored = score_beam_with_prm(candidate, step, language)
    then scored.score >= 0.0 && scored.score <= 1.0

// compute_step_reward("assign a = b + c;") = (1 + 0.618 + 2.618) / 5.236 = 0.80902.
test score_beam_with_prm_scales_by_reward
    given candidate = BeamCandidate { token: 5, score: 0.5, prefix_len: 3 }
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    when scored = score_beam_with_prm(candidate, step, "verilog")
    then scored.score > 0.4045 && scored.score < 0.4046 && scored.token == 5 && scored.prefix_len == 3

test prm_guided_beam_search_returns_candidates
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given language = "verilog"
    given out = [BeamCandidate { token: 9, score: 0.0, prefix_len: 0 }, BeamCandidate { token: 9, score: 0.0, prefix_len: 0 }]
    when n = prm_guided_beam_search(step, language, 2, 2, out)
    then n == 2 && out[0].score > 0.809 && out[1].score > 0.809 && out[0].token == 0

test prm_guided_beam_search_width_caps_count
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given out = [BeamCandidate { token: 9, score: 0.0, prefix_len: 0 }, BeamCandidate { token: 9, score: 0.0, prefix_len: 0 }]
    when n = prm_guided_beam_search(step, "verilog", 1, 2, out)
    then n == 1 && out[1].token == 9

test prm_guided_beam_search_zero_depth_empty
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given out = [BeamCandidate { token: 9, score: 0.0, prefix_len: 0 }]
    when n = prm_guided_beam_search(step, "verilog", 2, 0, out)
    then n == 0 && out[0].token == 9

// PRM training loop tests (W109)

test compute_prm_loss_positive
    given good = [Step { id: 0, description: "g", kind: StepKind::Datapath,
                       input: "", output: "assign a = b + c;" }]
    given bad  = [Step { id: 0, description: "b", kind: StepKind::Datapath,
                       input: "", output: "assign z = x * y;" }]
    given language = "verilog"
    when loss = compute_prm_loss(good, bad, language)
    then loss >= 0.0

test train_prm_step_average_loss
    given good = [Step { id: 0, description: "g", kind: StepKind::Datapath,
                       input: "", output: "assign a = b + c;" }]
    given bad  = [Step { id: 0, description: "b", kind: StepKind::Datapath,
                       input: "", output: "assign z = x * y;" }]
    when avg_loss = train_prm_step(good, bad, "verilog")
    then avg_loss > 0.42 && avg_loss < 0.44

test batch_score_with_prm_count
    given s1 = Step { id: 0, description: "s1", kind: StepKind::Datapath,
                      input: "", output: "assign a = b + c;" }
    given s2 = Step { id: 1, description: "s2", kind: StepKind::Datapath,
                      input: "", output: "assign z = x * y;" }
    given steps = [s1, s2]
    given out = [0.0f32, 0.0f32, 0.0f32]
    when n = batch_score_with_prm(steps, "verilog", out)
    then n == 2 && out[0] > 0.809 && out[0] < 0.810 && out[1] > 0.190 && out[1] < 0.192 && out[2] == 0.0

test update_prm_weights_decreases_loss
    given loss = 1.0
    given lr = 0.1
    when new_loss = update_prm_weights(loss, lr)
    then new_loss < loss

test evaluate_prm_validation_pass
    given s1 = Step { id: 0, description: "s1", kind: StepKind::Datapath,
                      input: "", output: "assign a = b + c;" }
    when acc = evaluate_prm_on_validation([s1], "verilog")
    then acc >= 0.0 && acc <= 1.0

// good scores 0.809 (> 0.5), bad scores 0.191 (< 0.5): half the steps pass.
test evaluate_prm_validation_half
    given s1 = Step { id: 0, description: "s1", kind: StepKind::Datapath,
                      input: "", output: "assign a = b + c;" }
    given s2 = Step { id: 1, description: "s2", kind: StepKind::Datapath,
                      input: "", output: "assign z = x * y;" }
    when acc = evaluate_prm_on_validation([s1, s2], "verilog")
    then acc == 0.5

test softplus_monotonic
    given x1 = 0.0
    given x2 = 1.0
    when y1 = softplus(x1)
    when y2 = softplus(x2)
    then y2 > y1

// The chosen trajectory must be cheaper than its swap: the loss of
// (good, bad) is below the loss of (bad, good), and softplus(d) - softplus(-d) = d.
test preference_loss_orders_pair
    given good = [Step { id: 0, description: "g", kind: StepKind::Datapath,
                       input: "", output: "assign a = b + c;" }]
    given bad  = [Step { id: 0, description: "b", kind: StepKind::Datapath,
                       input: "", output: "assign z = x * y;" }]
    when forward = preference_loss(good, bad, "verilog")
    when swapped = preference_loss(bad, good, "verilog")
    then forward < swapped && swapped - forward > 0.617 && swapped - forward < 0.619

test prm_reward_lint_mul_penalty
    given step = Step { id: 0, description: "mul", kind: StepKind::Datapath,
                        input: "", output: "assign z = x * y;" }
    given language = "verilog"
    when r = reward_lint(step, language)
    then r.score == 0.0

test prm_compute_step_reward_empty
    given steps = []Step{}
    when r = compute_trajectory_reward(steps, "verilog", 0.618)
    then r == 0.0

test prm_softplus_small_negative
    when s = softplus(-1.0)
    then s > 0.0 && s < 0.5

invariant prm_softplus_nonnegative
    forall x : f32
    softplus(x) >= 0.0

test prm_softplus_zero
    when s = softplus(0.0)
    then s > 0.693 && s < 0.694

// The five composite signal weights sum to 1 + 0.618 + 2.618 + 1 + 0.618 = 5.854.
// (The old test only read back a field of a literal it had just built, which the
// compiler folds away at comptime; this one runs the real signal functions.)
test prm_reward_signal_weights_sum
    given step = Step { id: 0, description: "s", kind: StepKind::Datapath, input: "", output: "x" }
    when a = reward_syntax(step, "verilog")
    when b = reward_lint(step, "verilog")
    when c = reward_sacred_compliance(step, "verilog")
    when d = reward_simulation(step)
    when e = reward_reference_match(step, "x")
    when total = a.weight + b.weight + c.weight + d.weight + e.weight
    then total > 5.853 && total < 5.855

// Output identical to the golden reference and containing PASS: every one of
// the five signals scores 1.0, so the normalized reward is 1.0.
test prm_compute_step_reward_perfect_match
    given step = Step { id: 0, description: "s1", kind: StepKind::Datapath, input: "", output: "assign a = b + c; // PASS" }
    given expected = "assign a = b + c; // PASS"
    when reward = compute_step_reward(step, "verilog", expected)
    then reward > 0.99

invariant prm_step_reward_bounded:
    forall step : Step, lang : string, expected : string
    compute_step_reward(step, lang, expected) >= 0.0
    && compute_step_reward(step, lang, expected) <= 1.0

// Concrete samples of the bounded-reward invariant: empty, good and bad outputs.
test prm_step_reward_bounded_samples
    given empty = Step { id: 0, description: "e", kind: StepKind::Datapath, input: "", output: "" }
    given good = Step { id: 1, description: "g", kind: StepKind::Datapath, input: "", output: "assign a = b + c;" }
    given bad = Step { id: 2, description: "b", kind: StepKind::Datapath, input: "", output: "assign z = x * y;" }
    when r0 = compute_step_reward(empty, "verilog", "")
    when r1 = compute_step_reward(good, "verilog", "assign a = b + c;")
    when r2 = compute_step_reward(bad, "verilog", "zzz")
    then r0 >= 0.0 && r0 <= 1.0 && r1 >= 0.0 && r1 <= 1.0 && r2 >= 0.0 && r2 <= 1.0

// ============================================================================
// Invariants
// ============================================================================

invariant reward_score_bounds
    forall r : RewardSignal
    r.score >= 0.0 && r.score <= 1.0

invariant reward_weight_positive
    forall r : RewardSignal
    r.weight > 0.0

invariant stepkind_valid:
    forall e : StepKind, e != undefined

// ============================================================================
// Benchmarks
// ============================================================================

// The original targets (throughput > 1000 steps/sec, latency < 2 us) are
// timing claims the t27 bench block cannot express; the benches check the
// value computed on the hot path instead.
bench trajectory_reward_10_steps {
    var s = Step { id: 0, description: "s1", kind: StepKind::Datapath, input: "", output: "assign a = b + c;" };
    var steps = [s, s, s, s, s, s, s, s, s, s];
    var r = compute_trajectory_reward(steps, "verilog", 0.618);
    assert r > 0.809;
    assert r < 0.810;
}

bench prm_evaluate_latency {
    var s1 = Step { id: 0, description: "s1", kind: StepKind::Datapath, input: "", output: "assign a = b + c;" };
    var r = compute_step_reward(s1, "verilog", "");
    assert r > 0.809;
    assert r < 0.810;
}

test compute_step_reward_deterministic
    given step = Step { id: 0, description: "s1", kind: StepKind::Datapath, input: "", output: "assign a = b + c;" }
    given lang = "verilog"
    given expected = ""
    when r1 = compute_step_reward(step, lang, expected)
    when r2 = compute_step_reward(step, lang, expected)
    then r1 == r2

test trajectory_reward_single_step
    given s1 = Step { id: 0, description: "s1", kind: StepKind::Datapath,
                      input: "", output: "assign a = b + c;" }
    given traj = [s1]
    when r = compute_trajectory_reward(traj, "verilog", 0.618)
    then r >= 0.0 && r <= 1.0

test prm_reward_syntax_perfect_match
    given step = Step { id: 0, description: "add", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given language = "verilog"
    when r = reward_syntax(step, language)
    then r.score > 0.0

// golden is "if available": an empty golden leaves the reference signal out, so
// a clean non-empty step scores (1 + 0.618 + 2.618) / 5.236 = 0.80902 (no PASS).
test prm_compute_step_reward_empty_golden_excludes_reference
    given step = Step { id: 0, description: "add", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given language = "verilog"
    given golden = ""
    when r = compute_step_reward(step, language, golden)
    then r > 0.809 && r < 0.810

// A mismatching golden pulls the reward down: reference score 0 with weight
// 0.618 gives 4.236 / 5.854 = 0.7236.
test prm_compute_step_reward_mismatched_golden_lowers_reward
    given step = Step { id: 0, description: "add", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given golden = "zzzzzzzzzzzzzzzzz"
    when r = compute_step_reward(step, "verilog", golden)
    then r > 0.72 && r < 0.73

test prm_reward_lint_no_mul_high_score
    given step = Step { id: 0, description: "add", kind: StepKind::Datapath,
                        input: "", output: "assign a = b + c;" }
    given language = "verilog"
    when r = reward_lint(step, language)
    then r.score > 0.0

invariant compute_step_reward_nonnegative
    forall step : Step, lang : string, expected : string
    compute_step_reward(step, lang, expected) >= 0.0

invariant prm_compute_step_reward_bounded
    forall step : Step, lang : string, golden : string
    compute_step_reward(step, lang, golden) <= 1.0

bench module_identity_latency_5 {
    // Measure: module-level identity
    // Target: < 10 cycles
    var input = 1;
    var result = input + 0;
    assert result == 1;
    _ = result;
}

test prm_char_match_ratio_identical_strings
    given a = "hello"
    given b = "hello"
    when r = char_match_ratio(a, b, 0, 0)
    then r == 1.0

test prm_char_match_ratio_completely_different
    given a = "abc"
    given b = "xyz"
    when r = char_match_ratio(a, b, 0, 0)
    then r == 0.0

test prm_char_match_ratio_half
    given a = "abcd"
    given b = "abxy"
    when r = char_match_ratio(a, b, 0, 0)
    then r == 0.5

test prm_contains_pass_substring_middle
    given s = "test PASS done"
    when ok = contains_pass(s)
    then ok == true

test prm_contains_pass_empty_string_false
    given s = ""
    when ok = contains_pass(s)
    then ok == false

test prm_contains_pass_case_sensitive_lower_false
    given s = "test pass done"
    when ok = contains_pass(s)
    then ok == false

// Two empty strings agree entirely (char_match_ratio returns 1.0 for max_len 0).
test prm_char_match_ratio_empty_empty_one
    given a = ""
    given b = ""
    when r = char_match_ratio(a, b, 0, 0)
    then r == 1.0

test prm_contains_keyword_empty_needle_true
    given s = "abc"
    given keyword = ""
    given idx = 0
    when r = contains_keyword(s, keyword, idx)
    then r == true

invariant prm_contains_pass_empty_false
    forall s : string
    s.len() == 0 ==> contains_pass(s) == false

invariant prm_char_match_ratio_bounded:
    forall a : string, b : string
    char_match_ratio(a, b, 0, 0) >= 0.0
    && char_match_ratio(a, b, 0, 0) <= 1.0

test prm_reward_syntax_nonempty_output
    given step = Step { id: 1, description: "d", kind: StepKind::Datapath, input: "in", output: "out" }
    given lang = "verilog"
    when r = reward_syntax(step, lang)
    then r.score == 1.0

test prm_reward_syntax_empty_output_zero
    given step = Step { id: 1, description: "d", kind: StepKind::Datapath, input: "in", output: "" }
    given lang = "verilog"
    when r = reward_syntax(step, lang)
    then r.score == 0.0

test prm_contains_multiply_simple_true
    given rhs = "a * b"
    when ok = contains_multiply_in_rhs(rhs)
    then ok == true

invariant prm_reward_syntax_nonempty_score_one:
    forall step : Step, lang : string
    step.output.len() > 0 ==> reward_syntax(step, lang).score == 1.0

test prm_contains_multiply_in_rhs_no_star_false
    given rhs = "a + b"
    when ok = contains_multiply_in_rhs(rhs)
    then ok == false

test prm_reward_lint_no_multiply_pass
    given step = Step { id: 1, description: "d", kind: StepKind::Datapath, input: "in", output: "assign c = a + b;" }
    given lang = "verilog"
    when r = reward_lint(step, lang)
    then r.score == 1.0

test prm_contains_pass_single_pass_true
    given s = "PASS"
    when r = contains_pass(s)
    then r == true

invariant prm_contains_multiply_in_rhs_no_star_false_inv:
    forall rhs : string
    rhs.len() == 0 ==>
    contains_multiply_in_rhs(rhs) == false

invariant prm_contains_pass_single_pass_true_inv:
    contains_pass("PASS") == true

// The syntax heuristic checks braces, not semicolons (see reward_syntax_score):
// a statement without ';' still scores 1.0, an unbalanced brace scores 0.0.
test prm_reward_syntax_no_semicolon_not_checked
    given step = Step { id: 1, description: "d", kind: StepKind::Datapath, input: "in", output: "assign c = a" }
    given lang = "verilog"
    when r = reward_syntax(step, lang)
    then r.score == 1.0

test prm_reward_syntax_unbalanced_brace_zero
    given step = Step { id: 1, description: "d", kind: StepKind::Datapath, input: "in", output: "module m { assign c = a;" }
    given lang = "verilog"
    when r = reward_syntax(step, lang)
    then r.score == 0.0

invariant prm_reward_syntax_empty_output_zero_inv:
    forall step : Step
    step.output.len() == 0 ==>
    reward_syntax(step, "verilog").score == 0.0

test prm_reward_syntax_valid_output_pass
    given step = Step { id: 1, description: "d", kind: StepKind::Datapath, input: "in", output: "assign c = a + b;" }
    given lang = "verilog"
    when r = reward_syntax(step, lang)
    then r.score == 1.0

invariant prm_contains_pass_case_sensitive_inv:
    forall s : string
    s.len() >= 4
    && s[0] == 80 && s[1] == 65 && s[2] == 83 && s[3] == 83
    ==>
    contains_pass(s) == true

test prm_reward_syntax_no_multiply_high
    given step = Step { id: 1, description: "d", kind: StepKind::Datapath, input: "in", output: "a + b + c" }
    given lang = "verilog"
    when r = reward_syntax(step, lang)
    then r.score >= 0.5

invariant prm_reward_syntax_no_multiply_high_inv:
    forall step : Step
    step.output == "a + b + c" ==>
    reward_syntax(step, "verilog").score >= 0.5

test prm_check_syntax_empty_true
    given code = ""
    given lang = "verilog"
    when ok = check_syntax(code, lang)
    then ok == true

invariant prm_exp_approx_zero_is_one_inv:
    exp_approx(0.0) == 1.0

test prm_reward_reference_match_identical
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath, input: "", output: "module add2(); endmodule" }
    given golden = "module add2(); endmodule"
    when r = reward_reference_match(step, golden)
    then r.score == 1.0

test prm_lint_warning_count_no_star
    given code = "module add2(a, b, y); assign y = a + b; endmodule"
    given lang = "verilog"
    when n = lint_warning_count(code, lang)
    then n == 0

test prm_lint_warning_count_two_stars
    given code = "assign y = a * b * c;"
    given lang = "verilog"
    when n = lint_warning_count(code, lang)
    then n == 2

invariant prm_run_simulation_contains_pass_passed_one_inv:
    forall tb_code : string
    contains_pass(tb_code) == true ==>
    run_simulation(tb_code).passed == 1

test prm_run_simulation_pass_and_fail
    given ok = run_simulation("tb PASS")
    given bad = run_simulation("tb FAIL")
    then ok.passed == 1 && ok.total == 1 && bad.passed == 0 && bad.total == 1

test prm_contains_multiply_in_rhs_empty
    given rhs = ""
    when ok = contains_multiply_in_rhs(rhs)
    then ok == false

test prm_reward_reference_match_empty_output
    given step = Step { id: 0, description: "test", kind: StepKind::Datapath, input: "", output: "" }
    given golden = "module add2(); endmodule"
    when r = reward_reference_match(step, golden)
    then r.score == 0.0

invariant prm_contains_multiply_in_rhs_empty_false_inv:
    forall rhs : string
    rhs.len() == 0 ==> contains_multiply_in_rhs(rhs) == false

test prm_reward_syntax_score_empty_output
    given code = ""
    when score = reward_syntax_score(code, "verilog")
    then score == 0.0

invariant prm_contains_multiply_in_rhs_single_mul_inv:
    forall a : string, b : string
    a.len() > 0 && b.len() > 0 ==>
    contains_multiply_in_rhs(a ++ " * " ++ b) == true

test prm_check_syntax_unbalanced_open_brace_false
    given code = "{"
    given lang = "verilog"
    when ok = check_syntax(code, lang)
    then ok == false

invariant prm_check_syntax_unbalanced_open_false_inv
    forall s : string
    s == "{" ==> check_syntax(s, "verilog") == false

test prm_param_bounds_clamp_min
    given p = Param { key: "lr", val: -1.0, min: 0.0, max: 0.5 }
    when v = clamp(p.val, p.min, p.max)
    then v == 0.0

invariant prm_param_bounds_clamp_min_inv:
    forall p : Param
    p.val < p.min ==> clamp(p.val, p.min, p.max) == p.min

test prm_contains_substring_empty_needle_true
    given haystack = "hello"
    given needle = ""
    when ok = contains_substring(haystack, needle)
    then ok == true

test prm_param_bounds_clamp_max
    given p = Param { key: "lr", val: 1.0, min: 0.0, max: 0.5 }
    when v = clamp(p.val, p.min, p.max)
    then v == 0.5

test prm_param_bounds_clamp_inside_identity
    given p = Param { key: "lr", val: 0.25, min: 0.0, max: 0.5 }
    when v = clamp(p.val, p.min, p.max)
    then v == 0.25

invariant prm_contains_substring_empty_needle_true_inv:
    forall haystack : string
    contains_substring(haystack, "") == true

test prm_reward_syntax_score_perfect_one
    given code = "module test; endmodule"
    given lang = "verilog"
    when score = reward_syntax_score(code, lang)
    then score == 1.0

test prm_contains_substring_not_found_false
    given haystack = "hello"
    given needle = "xyz"
    when ok = contains_substring(haystack, needle)
    then ok == false

invariant prm_reward_syntax_score_perfect_one_inv:
    forall code : string, lang : string
    code == "module test; endmodule" ==> reward_syntax_score(code, lang) == 1.0

test prm_contains_substring_prefix_true
    given haystack = "abcdef"
    given needle = "abc"
    when ok = contains_substring(haystack, needle)
    then ok == true

test prm_contains_substring_suffix_true
    given haystack = "abcdef"
    given needle = "def"
    when ok = contains_substring(haystack, needle)
    then ok == true

test prm_contains_substring_longer_needle_false
    given haystack = "ab"
    given needle = "abc"
    when ok = contains_substring(haystack, needle)
    then ok == false

test prm_reward_syntax_score_empty_zero
    given code = ""
    given lang = "verilog"
    when score = reward_syntax_score(code, lang)
    then score == 0.0

invariant prm_contains_substring_prefix_true_inv:
    forall haystack : string, needle : string
    haystack.starts_with(needle) == true ==> contains_substring(haystack, needle) == true

// param_bounds_saturate: i8 range clamp, inside / on the edge / one past / far past.
test prm_param_bounds_saturate_below_min_clamps
    given val = -200
    when result = param_bounds_saturate(val)
    then result == -128

test prm_param_bounds_saturate_above_max_clamps
    given val = 200
    when result = param_bounds_saturate(val)
    then result == 127

test prm_param_bounds_saturate_identity_inside_range
    given val = 0
    when result = param_bounds_saturate(val)
    then result == 0

test prm_param_bounds_saturate_max_boundary_identity
    given val = 127
    when result = param_bounds_saturate(val)
    then result == 127

test prm_param_bounds_saturate_min_boundary_identity
    given val = -128
    when result = param_bounds_saturate(val)
    then result == -128

test prm_param_bounds_saturate_minus_one_identity
    given val = -1
    when result = param_bounds_saturate(val)
    then result == -1

test prm_param_bounds_saturate_plus_one_identity
    given val = 1
    when result = param_bounds_saturate(val)
    then result == 1

test prm_param_bounds_saturate_boundary_minus_one_clamp
    given val = -129
    when result = param_bounds_saturate(val)
    then result == -128

test prm_param_bounds_saturate_boundary_plus_one_clamp
    given val = 128
    when result = param_bounds_saturate(val)
    then result == 127

invariant prm_param_bounds_saturate_min_inv:
    forall val : i32
    val < -128 ==> param_bounds_saturate(val) == -128

invariant prm_param_bounds_saturate_identity_inside_range_inv:
    forall val : i32
    val >= -128 && val <= 127 ==> param_bounds_saturate(val) == val

invariant prm_param_bounds_saturate_boundary_identity_inv:
    forall val : i32
    (val == -128 || val == 127) ==> param_bounds_saturate(val) == val

invariant prm_param_bounds_saturate_above_max_clamps_inv:
    forall val : i32
    val > 127 ==> param_bounds_saturate(val) == 127

invariant prm_param_bounds_saturate_plus_one_identity_inv:
    forall val : i32
    val == 1 ==> param_bounds_saturate(val) == 1

invariant prm_param_bounds_saturate_below_min_clamp_inv:
    param_bounds_saturate(-200) == -128

invariant prm_param_bounds_saturate_mid_value_identity_inv:
    param_bounds_saturate(0) == 0

invariant prm_param_bounds_saturate_boundary_plus_one_inv:
    param_bounds_saturate(128) == 127

invariant prm_param_bounds_saturate_boundary_minus_one_clamp_inv:
    param_bounds_saturate(-129) == -128

invariant prm_param_bounds_saturate_min_boundary_identity_inv:
    param_bounds_saturate(-128) == -128

invariant prm_param_bounds_saturate_max_boundary_identity_inv:
    param_bounds_saturate(127) == 127

test prm_param_bounds_saturate_small_negative_clamp
    given val = -129
    when result = param_bounds_saturate(val)
    then result == -128

// select_top: indices of the k best scores, best first; ties go to the lower index.
// (Indices are 0-based; the old w309 expectations [1, 2, 3] and [1, 2, 3, 4, 5]
// were off by one and contradicted the w308 tests of the same inputs.)
test prm_select_top_two_highest
    given scores = [0.1f32, 0.9f32, 0.5f32]
    given out = [7u32, 7u32]
    when n = select_top(scores, 2, out)
    then n == 2 && out[0] == 1 && out[1] == 2

test prm_select_top_all_same
    given scores = [0.5f32, 0.5f32, 0.5f32]
    given out = [7u32, 7u32]
    when n = select_top(scores, 1, out)
    then n == 1 && out[0] == 0 && out[1] == 7

test prm_select_top_three_descending
    given scores = [0.9f32, 0.5f32, 0.1f32]
    given out = [7u32, 7u32, 7u32]
    when n = select_top(scores, 3, out)
    then n == 3 && out[0] == 0 && out[1] == 1 && out[2] == 2

test prm_select_top_negative_scores
    given scores = [-0.5f32, -0.1f32, -0.9f32]
    given out = [7u32, 7u32]
    when n = select_top(scores, 1, out)
    then n == 1 && out[0] == 1 && out[1] == 7

test prm_select_top_empty_empty
    given scores = []f32{}
    given out = [7u32, 7u32]
    when n = select_top(scores, 0, out)
    then n == 0 && out[0] == 7 && out[1] == 7

test prm_select_top_two_equal
    given scores = [0.5f32, 0.5f32, 0.5f32]
    given out = [7u32, 7u32]
    when n = select_top(scores, 2, out)
    then n == 2 && out[0] == 0 && out[1] == 1

test prm_select_top_three_equal
    given scores = [0.5f32, 0.5f32, 0.5f32]
    given out = [7u32, 7u32, 7u32]
    when n = select_top(scores, 3, out)
    then n == 3 && out[0] == 0 && out[1] == 1 && out[2] == 2

test prm_select_top_reverse_descending
    given scores = [0.9f32, 0.7f32, 0.5f32, 0.3f32]
    given out = [7u32, 7u32, 7u32, 7u32]
    when n = select_top(scores, 4, out)
    then n == 4 && out[0] == 0 && out[1] == 1 && out[2] == 2 && out[3] == 3

test prm_select_top_descending_five
    given scores = [0.9f32, 0.7f32, 0.5f32, 0.3f32, 0.1f32]
    given out = [7u32, 7u32, 7u32, 7u32, 7u32]
    when n = select_top(scores, 5, out)
    then n == 5 && out[0] == 0 && out[1] == 1 && out[2] == 2 && out[3] == 3 && out[4] == 4

test prm_select_top_ascending_reverses
    given scores = [0.1f32, 0.3f32, 0.5f32, 0.7f32, 0.9f32]
    given out = [7u32, 7u32, 7u32, 7u32, 7u32]
    when n = select_top(scores, 5, out)
    then n == 5 && out[0] == 4 && out[1] == 3 && out[2] == 2 && out[3] == 1 && out[4] == 0

test prm_select_top_k_larger_than_scores
    given scores = [0.2f32, 0.8f32]
    given out = [7u32, 7u32, 7u32]
    when n = select_top(scores, 3, out)
    then n == 2 && out[0] == 1 && out[1] == 0 && out[2] == 7

test prm_count_above_threshold
    given scores = [0.2f32, 0.7f32, 0.9f32, 0.5f32]
    when n = count_above_threshold(scores, 0.5, 0, 0)
    then n == 2
