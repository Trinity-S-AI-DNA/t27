// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/rewrite_plan.t27
// Phase/gate law for rewriting the IGLA CODER pilot line from the external
// Python runner onto the t27 toolchain. Companion doc:
// docs/igla-coder-t27-rewrite-plan.md (evidence tables live there).
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-rewrite-plan;

// ============================================================================
// 1. Phases (order is the law; a phase lands only through normal gates)
// ============================================================================

pub const PHASE_R0_INFERENCE_REF : u8 = 0;
pub const PHASE_R1_TRAIN_STEP    : u8 = 1;
pub const PHASE_R2_RELOAD_GRADE  : u8 = 2;
pub const PHASE_R3_CPU_ACCEL     : u8 = 3;
pub const PHASE_R4_GPU_KERNELS   : u8 = 4;
pub const PHASE_R5_T27OS         : u8 = 5;
pub const PHASE_COUNT            : u8 = 6;

pub const CURRENT_PHASE : u8 = PHASE_R0_INFERENCE_REF;

/// next_phase(p) -> u8
/// Monotone ladder; the last phase is terminal.
pub fn next_phase(p: u8) -> u8 {
    if (p + 1 >= PHASE_COUNT) { return PHASE_R5_T27OS; }
    return p + 1;
}

// ============================================================================
// 2. Measured laws the plan inherits (numbers carry their source)
// ============================================================================

/// int8 tensor-core forward vs bf16, RTX 4090, 5 shapes (#10360):
/// speedup s in [2.9, 3.5] -> saving f x (1 - 1/s) = 16.4 .. 23.8 percent.
pub const SAVING_LAW_PCT_MIN : f64 = 16.4;
pub const SAVING_LAW_PCT_MAX : f64 = 23.8;
/// The share f is an ESTIMATE. The law must never be quoted as measured.
pub const F_MEASURED : bool = false;
/// A generated CUDA kernel ships only if it beats CUTLASS s8 by 10 percent.
pub const GEN_CUDA_BAR_E2 : u32 = 110;
/// Backend-ml precedent: the whole 2.13M-param HSLM trained in-spec at this
/// tok/s (own_model.t27) - proof that the executable path exists today.
pub const BACKEND_ML_TRAIN_TOKS : u32 = 306;
/// dp4a is never picked (0.91-0.94x on every shape).
pub const DP4A_PICKED : bool = false;

/// gpu_allowed(beats_cutlass, criteria_met) -> bool
/// GPU kernels ship only past the 110 bar AND the owner's A-E criteria.
pub fn gpu_allowed(beats_cutlass: bool, criteria_met: bool) -> bool {
    return beats_cutlass and criteria_met;
}

// ============================================================================
// 3. Tests
// ============================================================================

test phase_order_monotone {
    var p: u8 = PHASE_R0_INFERENCE_REF;
    var i: u8 = 0;
    while (i < PHASE_COUNT - 1) {
        const n = next_phase(p);
        assert n == p + 1;
        p = n;
        i = i + 1;
    }
    assert next_phase(PHASE_R5_T27OS) == PHASE_R5_T27OS;
}

test saving_law_bounds {
    assert SAVING_LAW_PCT_MIN >= 16.0;
    assert SAVING_LAW_PCT_MAX <= 24.0;
    assert SAVING_LAW_PCT_MIN < SAVING_LAW_PCT_MAX;
}

test saving_law_not_claimed_as_measured {
    assert F_MEASURED == false;
}

test cuda_bar_is_110 {
    assert GEN_CUDA_BAR_E2 == 110;
    assert gpu_allowed(true, true) == true;
    assert gpu_allowed(false, true) == false;
    assert gpu_allowed(true, false) == false;
}

test backend_ml_precedent_recorded {
    assert BACKEND_ML_TRAIN_TOKS == 306;
}

test dp4a_never_picked {
    assert DP4A_PICKED == false;
}
