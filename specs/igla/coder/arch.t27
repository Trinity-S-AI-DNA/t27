// Target: latency under 50 ms for 512 tokens (needs a hardware clock; the bench
// body only exercises the forward pass).
bench "forward_latency_512_tokens" {
    const input_ids = random_tokens(512);
    _ = forward(input_ids, no_past_kv());
}

// Target: latency under 100 ms for 1024 tokens (see above).
bench "forward_latency_1024_tokens" {
    const input_ids = random_tokens(1024);
    _ = forward(input_ids, no_past_kv());
}

