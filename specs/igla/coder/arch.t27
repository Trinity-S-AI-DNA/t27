test arch_add_slices_empty_left_w308
    given a = []f32{}
    given b = [1.0, 2.0, 3.0]
    when c = add_slices(a, b, 0)
    // add_slices truncates to the shorter operand, so an empty left operand gives an
    // empty result (the old expectation, a passthrough of b, contradicted the
    // documented "truncated to the shorter" behaviour that the w296 test pins).
    then c.len() == 0

test arch_add_slices_empty_right_w308
    given a = [1.0, 2.0, 3.0]
    given b = []f32{}
    when c = add_slices(a, b, 0)
    // Truncated to the shorter (empty) operand: empty result, see the empty-left test.
    then c.len() == 0

