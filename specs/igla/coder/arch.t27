// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/arch.t27
// IGLA-Coder model architecture specification
// Sub-1B parameter code-generation LLM | phi^2 + 1/phi^2 = 3 | TRINITY
//
// Memory model (gHashTag/t27#10075): the t27 runtime has no allocator, so a
// function cannot build a dynamic-length slice by `[v] + recurse(...)`. Every
// function that produces a vector writes it into a fixed-size scratch buffer
// owned by this module (the BUF_* arrays below, BRAM-style static storage) and
// returns a slice of that buffer. A returned slice is valid until the next call
// of the SAME function. Vector helpers are element-wise, so feeding a buffer
// back into its own producer (the layer stack does) is safe.
//
// Loops use `while` with `var`; the parser truncates bodies on `for`, `.push()`
// and `+=`.

module igla-coder-arch;
use base::types;
use math::constants;
use igla::race::bram_weights;

// ============================================================================
// 1. Architecture Constants
// ============================================================================

pub const MAX_PARAMS : u32 = 1_000_000_000;   // sub-1B hard ceiling
pub const VOCAB_SIZE : u32 = 32000;           // multilingual code vocab
pub const MAX_SEQ_LEN : u32 = 8192;           // 8k context window
pub const D_MODEL : u32 = 768;                // hidden dim (phi-aligned)
pub const N_LAYERS : u32 = 12;                // transformer layers
pub const N_HEADS : u32 = 12;                 // attention heads
pub const N_KV_HEADS : u32 = 4;               // GQA: grouped query attention
pub const D_FF : u32 = 2048;                  // feed-forward inner dim
pub const ROPE_THETA : f32 = 10000.0;         // rotary base frequency
pub const RMS_NORM_EPS : f32 = 0.000001;          // pre-normalization epsilon
pub const DROPOUT_RATE : f32 = 0.0;           // inference-time dropout (0 for codegen)

// ============================================================================
// 2. Sacred Opcode Embedding Constraints
// ============================================================================

// IGLA-Coder must embed sacred opcode awareness into token embeddings
// so that generated code respects the hardware alphabet.
pub const SACRED_OPCODE_COUNT : u8 = 10;
pub const OPCODE_EMBED_DIM : u32 = 64;

// ============================================================================
// 3. Scratch Storage Sizes
// ============================================================================

pub const MAX_VEC : u32 = 32768;      // longest vector a helper can produce (>= VOCAB_SIZE)
pub const MAX_IDS : u32 = 2048;       // longest token-id sequence the beam / bench helpers hold
pub const MAX_ROW : u32 = 4096;       // longest weight row load_weight_row can return
pub const MAX_BEAMS : u32 = 16;       // beam candidates held at once
pub const MAX_TOPK : u32 = 64;        // largest k top_k_indices returns
pub const KV_MAX_ROWS : u32 = 8;      // KV-cache rows
pub const KV_ROW_CAP : u32 = 64;      // KV-cache floats per row
pub const KV_CAP : u32 = 512;         // KV_MAX_ROWS * KV_ROW_CAP

// ============================================================================
// 4. Types
// ============================================================================

pub const ModelConfig = struct {
    vocab_size : u32,
    max_seq_len : u32,
    d_model : u32,
    n_layers : u32,
    n_heads : u32,
    n_kv_heads : u32,
    d_ff : u32,
    rope_theta : f32,
    rms_norm_eps : f32,
    dropout_rate : f32,
    use_gqa : bool,
    use_rope : bool,
    use_sacred_embed : bool,
};

pub const AttentionConfig = struct {
    n_heads : u32,
    n_kv_heads : u32,
    head_dim : u32,
    max_seq_len : u32,
};

pub const LayerOutput = struct {
    hidden_states : []f32,
    past_kv : []f32,
};

pub const CoderForwardOutput = struct {
    logits : []f32,
    hidden_states : []f32,
    past_key_values : [][]f32,
};

// KVCache: fixed-capacity cache, `rows` rows used. Row r of the keys lives in
// key_cache[r * KV_ROW_CAP .. r * KV_ROW_CAP + key_lens[r]] (same for values).
// A value type: updates return a new cache and never touch the old one.
pub const KVCache = struct {
    rows : u32,
    key_lens : [KV_MAX_ROWS]u32,
    value_lens : [KV_MAX_ROWS]u32,
    key_cache : [KV_CAP]f32,
    value_cache : [KV_CAP]f32,
};

/// RegisterFile: eight general registers of the sacred-opcode execution model.
pub const RegisterFile = struct {
    x0 : i32,
    x1 : i32,
    x2 : i32,
    x3 : i32,
    x4 : i32,
    x5 : i32,
    x6 : i32,
    x7 : i32,
};

// Scratch buffers. Each is written by exactly the function named beside it.
var BUF_RMS : [MAX_VEC]f32 = undefined;       // rms_norm / rms_scale
var BUF_ATTN : [MAX_VEC]f32 = undefined;      // weight_by_scalar
var BUF_ADD : [MAX_VEC]f32 = undefined;       // add_slices
var BUF_FF : [MAX_VEC]f32 = undefined;        // feed_forward_* / swiglu_*
var BUF_EMB : [MAX_VEC]f32 = undefined;       // embedding_lookup
var BUF_LOGITS : [MAX_VEC]f32 = undefined;    // lm_head_from_hidden
var BUF_TEMP : [MAX_VEC]f32 = undefined;      // temperature_scale / scale_by_temp
var BUF_SOFT : [MAX_VEC]f32 = undefined;      // softmax_approx
var BUF_MASK : [MAX_VEC]f32 = undefined;      // top_p_mask
var BUF_DIV : [MAX_VEC]f32 = undefined;       // div_vec
var BUF_CUMUL : [MAX_VEC]f32 = undefined;     // cumulative_probs
var BUF_ROPE_Q : [MAX_VEC]f32 = undefined;    // apply_rope_q
var BUF_ROPE_K : [MAX_VEC]f32 = undefined;    // apply_rope_k
var BUF_WROW : [MAX_ROW]f32 = undefined;      // load_weight_row
var BUF_W1 : [1]f32 = undefined;              // transformer_layer_with_weights
var BUF_OPCODE : [OPCODE_EMBED_DIM]f32 = undefined;   // sacred_opcode_embed
var BUF_IDS : [MAX_IDS]u32 = undefined;       // random_tokens / generate_beam_search
var BUF_TOPK : [MAX_TOPK]u32 = undefined;     // top_k_indices
var BUF_BEAM : [MAX_BEAMS]BeamCandidate = undefined;   // beam helpers

var NO_KV : [1][]f32 = undefined;             // backing store of the empty past_kv slice

/// no_past_kv() -> [][]f32
/// The empty past-key-values argument (no allocator, so an empty literal is not
/// available): a zero-length slice of NO_KV.
fn no_past_kv() -> [][]f32 {
    return NO_KV[0..0];
}

fn empty_kv_cache() -> KVCache {
    var c : KVCache = undefined;
    c.rows = 0;
    var r : usize = 0;
    while (r < KV_MAX_ROWS) {
        c.key_lens[r] = 0;
        c.value_lens[r] = 0;
        r = r + 1;
    }
    var i : usize = 0;
    while (i < KV_CAP) {
        c.key_cache[i] = 0.0;
        c.value_cache[i] = 0.0;
        i = i + 1;
    }
    return c;
}

// ============================================================================
// 5. Core Functions
// ============================================================================

fn clamp_vec_len(n: usize) -> usize {
    if (n > MAX_VEC) { return MAX_VEC; }
    return n;
}

fn min_usize(a: usize, b: usize) -> usize {
    if (a < b) { return a; }
    return b;
}

// sqrt_approx(x: f32) -> f32
// Newton iteration with improved initial guess for small x (8 steps).
fn sqrt_approx(x: f32) -> f32 {
    if (x <= 0.0) { return 0.0; }
    var g : f32 = if (x < 0.01) { 0.1 } else { if (x < 1.0) { 0.5 + x } else { x / 2.0 + 1.0 } };
    var i : u32 = 0;
    while (i < 8) {
        g = (g + x / g) / 2.0;
        i = i + 1;
    }
    return g;
}

// exp_taylor(x: f32) -> f32
// 5-term Taylor series for exp(x), valid for |x| <= 1.0.
fn exp_taylor(x: f32) -> f32 {
    let x2 = x * x;
    let x3 = x2 * x;
    let x4 = x3 * x2;
    let x5 = x4 * x2;
    return 1.0 + x + x2 / 2.0 + x3 / 6.0 + x4 / 24.0 + x5 / 120.0;
}

// exp_approx(x: f32) -> f32
// Range reduction via repeated halving, then Taylor expansion.
fn exp_approx(x: f32) -> f32 {
    if (x == 0.0) { return 1.0; }
    if (x < 0.0) { return 1.0 / exp_approx(-x); }
    if (x > 1.0) {
        let half = exp_approx(x / 2.0);
        return half * half;
    }
    return exp_taylor(x);
}

// ln_taylor(y: f32) -> f32
// Taylor series for ln(1+y), valid for |y| <= 0.5.
fn ln_taylor(y: f32) -> f32 {
    let y2 = y * y;
    let y3 = y2 * y;
    let y4 = y3 * y2;
    let y5 = y4 * y2;
    return y - y2 / 2.0 + y3 / 3.0 - y4 / 4.0 + y5 / 5.0;
}

// ln_approx(x: f32) -> f32
// Range reduction: ln(x) = ln(2) + ln(x / 2) until x <= 1.5, so that the
// argument handed to ln_taylor is 1+y with |y| <= 0.5, the range ln_taylor is
// valid on (the earlier bound of 2.0 gave ln_approx(2.0) = 0.78 instead of 0.69).
fn ln_approx(x: f32) -> f32 {
    if (x <= 0.0) { return 0.0; }
    if (x == 1.0) { return 0.0; }
    if (x < 1.0) { return -ln_approx(1.0 / x); }
    if (x > 1.5) {
        return 0.693147 + ln_approx(x / 2.0);
    }
    return ln_taylor(x - 1.0);
}

// pow_approx(base: f32, exp: f32) -> f32
// General exponent via exp(ln(base) * exp) with range reduction.
fn pow_approx(base: f32, exp: f32) -> f32 {
    if (exp == 0.0) { return 1.0; }
    if (exp == 1.0) { return base; }
    if (exp == 2.0) { return base * base; }
    return exp_approx(exp * ln_approx(base));
}

// rms_norm(x: []f32, weight: []f32, eps: f32) -> []f32
// Two-pass: first compute sum_of_squares, then scale each element.
// A weight shorter than x is padded with 1.0. Result lives in BUF_RMS.
fn rms_norm(x: []f32, weight: []f32, eps: f32) -> []f32 {
    const n = clamp_vec_len(x.len);
    if (n == 0) { return BUF_RMS[0..0]; }
    const sum_sq = rms_sum_sq(x[0..n], 0, 0.0);
    const mean_sq = sum_sq / @as(f32, @floatFromInt(n));
    const denom = sqrt_approx(mean_sq + eps);
    return rms_scale(x[0..n], weight, denom, 0);
}

// Sum of x[idx]^2 over idx..len, added to acc.
fn rms_sum_sq(x: []f32, idx: u32, acc: f32) -> f32 {
    var i : usize = idx;
    var total : f32 = acc;
    while (i < x.len) {
        total = total + x[i] * x[i];
        i = i + 1;
    }
    return total;
}

// x[idx..] / denom * weight[i] (weight[i] = 1.0 past the end of weight), into BUF_RMS.
fn rms_scale(x: []f32, weight: []f32, denom: f32, idx: u32) -> []f32 {
    const n = clamp_vec_len(x.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        const w = if (i < weight.len) { weight[i] } else { 1.0 };
        BUF_RMS[j] = x[i] / denom * w;
        i = i + 1;
        j = j + 1;
    }
    return BUF_RMS[0..j];
}

// apply_rope(q: []f32, k: []f32, pos: u32, theta: f32) -> ([]f32, []f32)
// Rotary positional embedding: rotate pairs by position-dependent angle.
// Uses 5-term Taylor-series sin/cos approximations.
fn sin_approx(x: f32) -> f32 {
    let x2 = x * x;
    let x3 = x2 * x;
    let x5 = x3 * x2;
    let x7 = x5 * x2;
    let x9 = x7 * x2;
    return x - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0;
}

fn cos_approx(x: f32) -> f32 {
    let x2 = x * x;
    let x4 = x2 * x2;
    let x6 = x4 * x2;
    let x8 = x6 * x2;
    let x10 = x8 * x2;
    return 1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0 + x8 / 40320.0 - x10 / 3628800.0;
}

fn apply_rope(q: []f32, k: []f32, pos: u32, theta: f32) -> ([]f32, []f32) {
    return (apply_rope_q(q, pos, theta, 0), apply_rope_k(k, pos, theta, 0));
}

// Rotates the pairs (src[i], src[i+1]) for i = start, start+2, ... into dst;
// an odd trailing element is copied unrotated. Returns dst[0..written].
fn rope_rotate(src: []f32, pos: u32, theta: f32, start: u32, dst: []f32) -> []f32 {
    const n = clamp_vec_len(src.len);
    const dim = @as(f32, @floatFromInt(n));
    var i : usize = start;
    var j : usize = 0;
    while (i + 1 < n) {
        const exponent = @as(f32, @floatFromInt(i)) / dim;
        const inv_freq = 1.0 / pow_approx(theta, exponent);
        const angle = @as(f32, @floatFromInt(pos)) * inv_freq;
        const s = sin_approx(angle);
        const c = cos_approx(angle);
        const a0 = src[i];
        const a1 = src[i + 1];
        dst[j] = a0 * c - a1 * s;
        dst[j + 1] = a0 * s + a1 * c;
        i = i + 2;
        j = j + 2;
    }
    if (i < n) {
        dst[j] = src[i];
        j = j + 1;
    }
    return dst[0..j];
}

fn apply_rope_q(q: []f32, pos: u32, theta: f32, idx: u32) -> []f32 {
    return rope_rotate(q, pos, theta, idx, BUF_ROPE_Q[0..MAX_VEC]);
}

fn apply_rope_k(k: []f32, pos: u32, theta: f32, idx: u32) -> []f32 {
    return rope_rotate(k, pos, theta, idx, BUF_ROPE_K[0..MAX_VEC]);
}

// grouped_query_attention(q: []f32, k: []f32, v: []f32, mask: []f32) -> []f32
// GQA: dot-product attention with grouped KV heads.
// Computes scaled dot-product and weights v by it. Result lives in BUF_ATTN.
fn grouped_query_attention(q: []f32, k: []f32, v: []f32, mask: []f32) -> []f32 {
    let dot_val = dot_product(q, k, 0, 0.0);
    let dim = q.len() as f32;
    let scale = sqrt_approx(dim);
    if (scale == 0.0) {
        return v;
    }
    let score = dot_val / scale;
    return weight_by_scalar(v, score, 0);
}

// Sum of a[i] * b[i] for i = idx .. min(len a, len b), added to acc.
fn dot_product(a: []f32, b: []f32, idx: u32, acc: f32) -> f32 {
    var i : usize = idx;
    var total : f32 = acc;
    while (i < a.len && i < b.len) {
        total = total + a[i] * b[i];
        i = i + 1;
    }
    return total;
}

// v[idx..] * score, into BUF_ATTN.
fn weight_by_scalar(v: []f32, score: f32, idx: u32) -> []f32 {
    const n = clamp_vec_len(v.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_ATTN[j] = v[i] * score;
        i = i + 1;
        j = j + 1;
    }
    return BUF_ATTN[0..j];
}

// sacred_opcode_embed(token_id: u32) -> []f32
// Map token_id deterministically into OPCODE_EMBED_DIM (64) f32 values.
fn sacred_opcode_embed(token_id: u32) -> []f32 {
    return sacred_opcode_embed_inner(token_id, 0);
}

// Entries idx..OPCODE_EMBED_DIM of the embedding, into BUF_OPCODE.
fn sacred_opcode_embed_inner(token_id: u32, idx: u32) -> []f32 {
    var i : u32 = idx;
    var j : usize = 0;
    while (i < OPCODE_EMBED_DIM) {
        BUF_OPCODE[j] = @as(f32, @floatFromInt((token_id + i) % 256)) / 256.0;
        i = i + 1;
        j = j + 1;
    }
    return BUF_OPCODE[0..j];
}

// embedding_lookup(input_ids: []u32, idx: u32) -> []f32
// Convert token IDs idx.. to normalized float embeddings, into BUF_EMB.
fn embedding_lookup(input_ids: []u32, idx: u32) -> []f32 {
    const n = clamp_vec_len(input_ids.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_EMB[j] = @as(f32, @floatFromInt(input_ids[i])) / @as(f32, @floatFromInt(VOCAB_SIZE));
        i = i + 1;
        j = j + 1;
    }
    return BUF_EMB[0..j];
}

// add_slices_count(a, b, offset) -> usize
// Number of elements add_slices(a, b, offset) produces: min(len a - offset, len b),
// 0 when offset is past the end of a. Touches no buffer, so it is usable in
// compile-time invariants.
fn add_slices_count(a: []f32, b: []f32, offset: u32) -> usize {
    if (offset >= a.len) { return 0; }
    return clamp_vec_len(min_usize(a.len - offset, b.len));
}

// add_slices(a: []f32, b: []f32, offset: u32) -> []f32
// Elementwise addition c[j] = a[offset + j] + b[j], truncated to the shorter
// operand; `offset` skips the first `offset` elements of a. Into BUF_ADD.
fn add_slices(a: []f32, b: []f32, offset: u32) -> []f32 {
    const n = add_slices_count(a, b, offset);
    var j : usize = 0;
    while (j < n) {
        BUF_ADD[j] = a[offset + j] + b[j];
        j = j + 1;
    }
    return BUF_ADD[0..n];
}

// feed_forward_vec(x: []f32, idx: u32) -> []f32
// Apply scalar feed-forward to x[idx..], into BUF_FF.
fn feed_forward_vec(x: []f32, idx: u32) -> []f32 {
    const n = clamp_vec_len(x.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_FF[j] = ff_scalar(x[i], 0.5, 1.0);
        i = i + 1;
        j = j + 1;
    }
    return BUF_FF[0..j];
}

// feed_forward_vec_with_weights(x: []f32, idx: u32, w: f32) -> []f32
// Apply scalar feed-forward with external BRAM-loaded weight, into BUF_FF.
fn feed_forward_vec_with_weights(x: []f32, idx: u32, w: f32) -> []f32 {
    const n = clamp_vec_len(x.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_FF[j] = ff_scalar(x[i], w, w);
        i = i + 1;
        j = j + 1;
    }
    return BUF_FF[0..j];
}

// transformer_layer_with_weights(x: []f32, weights: WeightBank) -> []f32
// Conceptual single-layer pass with BRAM-loaded scalar weights.
// Result lives in BUF_ADD; x may be any slice, including a previous layer's result.
fn transformer_layer_with_weights(x: []f32, weights: WeightBank) -> []f32 {
    let w_rms = load_scalar_weight(weights, 0, 0);
    let w_ff = load_scalar_weight(weights, 0, 1);
    BUF_W1[0] = w_rms;
    let weight_slice = BUF_W1[0..1];
    let norm1 = rms_norm(x, weight_slice, RMS_NORM_EPS);
    let attn = grouped_query_attention(norm1, norm1, norm1, BUF_ATTN[0..0]);
    let res1 = add_slices(x, attn, 0);
    let norm2 = rms_norm(res1, weight_slice, RMS_NORM_EPS);
    let ff = swiglu_vec_with_weights(norm2, 0, w_ff);
    return add_slices(res1, ff, 0);
}

/// default_weight_bank() -> WeightBank
/// The fixed 2x2 bank (Q15 0.5, 0.25, 0.125, 0.0625) the legacy wrappers use.
fn default_weight_bank() -> WeightBank {
    return WeightBank { depth: 2, width: 2, data: [16384, 8192, 4096, 2048] };
}

/// Legacy transformer_layer without weights (kept for backward compat).
fn transformer_layer(x: []f32) -> []f32 {
    return transformer_layer_with_weights(x, WeightBank { depth: 1, width: 1, data: [16384] });
}

/// Apply transformer_layer_with_weights n times (conceptual N-layer stack).
fn forward_layers_with_weights(x: []f32, n: u32, weights: WeightBank) -> []f32 {
    var cur : []f32 = x;
    var i : u32 = 0;
    while (i < n) {
        cur = transformer_layer_with_weights(cur, weights);
        i = i + 1;
    }
    return cur;
}

/// forward_layers(x, n) -> []f32
/// Apply the legacy (no-weights) transformer_layer n times; n = 0 returns x.
fn forward_layers(x: []f32, n: u32) -> []f32 {
    var cur : []f32 = x;
    var i : u32 = 0;
    while (i < n) {
        cur = transformer_layer(cur);
        i = i + 1;
    }
    return cur;
}

// lm_head_seed(hidden: []f32, idx: u32) -> f32
// Return hidden element at idx if present, else 0.0.
fn lm_head_seed(hidden: []f32, idx: u32) -> f32 {
    if (hidden.len() > idx) {
        return hidden[idx];
    }
    return 0.0;
}

// lm_head_from_hidden(hidden: []f32, idx: u32) -> []f32
// Project hidden state to VOCAB_SIZE logits (entries idx.. only), into BUF_LOGITS.
fn lm_head_from_hidden(hidden: []f32, idx: u32) -> []f32 {
    const seed = lm_head_seed(hidden, 0);
    var i : u32 = idx;
    var j : usize = 0;
    while (i < VOCAB_SIZE) {
        BUF_LOGITS[j] = seed + @as(f32, @floatFromInt(i)) / @as(f32, @floatFromInt(VOCAB_SIZE));
        i = i + 1;
        j = j + 1;
    }
    return BUF_LOGITS[0..j];
}

/// forward_with_bank(input_ids, bank, past_kv) -> CoderForwardOutput
/// Forward pass accepting an external WeightBank. Core wiring for pipeline integration.
/// past_kv is carried through to past_key_values (reserved; the cache itself is KVCache).
fn forward_with_bank(input_ids: []u32, bank: WeightBank, past_kv: [][]f32) -> CoderForwardOutput {
    let hidden = embedding_lookup(input_ids, 0);
    let processed = forward_layers_with_weights(hidden, N_LAYERS, bank);
    let logits = lm_head_from_hidden(processed, 0);
    return CoderForwardOutput {
        logits: logits,
        hidden_states: processed,
        past_key_values: past_kv,
    };
}

// forward(input_ids: []u32, past_kv: [][]f32) -> CoderForwardOutput
// Architecturally correct skeleton: embedding -> N weighted transformer layers -> LM head.
// Legacy wrapper using hardcoded weights; prefer forward_with_bank for real inference.
pub fn forward(input_ids: []u32, past_kv: [][]f32) -> CoderForwardOutput {
    return forward_with_bank(input_ids, default_weight_bank(), past_kv);
}

/// Conceptual weight loader: reads a single scalar weight from BRAM.
/// Demonstrates igla-race-bram-weights integration into the coder model.
/// The i16 weight is read as Q15: weight / 32768.
fn load_scalar_weight(bank: WeightBank, row: u32, col: u32) -> f32 {
    let addr = WeightAddr { row: row, col: col };
    let w = read_weight(bank, addr);
    return @as(f32, @floatFromInt(w)) / 32768.0;
}

/// load_weight_row(bank, row, width) -> []f32
/// Load a full row of scalar weights from BRAM and normalize each to f32, into BUF_WROW.
fn load_weight_row(bank: WeightBank, row: u32, width: u32) -> []f32 {
    return load_weight_row_inner(bank, row, width, 0);
}

// Columns col..width of the row.
fn load_weight_row_inner(bank: WeightBank, row: u32, width: u32, col: u32) -> []f32 {
    var c : u32 = col;
    var j : usize = 0;
    while (c < width && j < MAX_ROW) {
        BUF_WROW[j] = load_scalar_weight(bank, row, c);
        c = c + 1;
        j = j + 1;
    }
    return BUF_WROW[0..j];
}

/// matmul_row_vec(weights, x) -> f32
/// Dot product of a weight row vector with an input vector.
/// Conceptual attention projection step.
fn matmul_row_vec(weights: []f32, x: []f32) -> f32 {
    return dot_product(weights, x, 0, 0.0);
}

fn default_config() -> ModelConfig {
    return ModelConfig {
        vocab_size: VOCAB_SIZE,
        max_seq_len: MAX_SEQ_LEN,
        d_model: D_MODEL,
        n_layers: N_LAYERS,
        n_heads: N_HEADS,
        n_kv_heads: N_KV_HEADS,
        d_ff: D_FF,
        rope_theta: ROPE_THETA,
        rms_norm_eps: RMS_NORM_EPS,
        dropout_rate: DROPOUT_RATE,
        use_gqa: true,
        use_rope: true,
        use_sacred_embed: true,
    };
}

fn estimate_param_count(cfg: ModelConfig) -> u32 {
    let embed = cfg.vocab_size * cfg.d_model;
    let ff_per_layer = cfg.d_model * cfg.d_ff * 2;
    let attn_per_layer = cfg.d_model * cfg.d_model * 4;
    let layer_norm = cfg.d_model * 2;
    let per_layer = ff_per_layer + attn_per_layer + layer_norm;
    let total = embed + (per_layer * cfg.n_layers) + embed;
    return total;
}

/// compute_head_dim(cfg) -> u32
/// Returns d_model / n_heads. Validates divisibility implicitly.
fn compute_head_dim(cfg: ModelConfig) -> u32 {
    return cfg.d_model / cfg.n_heads;
}

// ============================================================================
// 6. Activation and Inference Helpers
// ============================================================================

fn relu(x: f32) -> f32 {
    if (x > 0.0) { return x; }
    return 0.0;
}

/// Scalar feed-forward: x -> w2 * relu(w1 * x)
fn ff_scalar(x: f32, w1: f32, w2: f32) -> f32 {
    return w2 * relu(w1 * x);
}

/// SwiGLU conceptual approximation: (w1 * x) * relu(w2 * x)
/// Simplified for t27 safety; real SwiGLU uses sigmoid gate.
fn swiglu_scalar(x: f32, w1: f32, w2: f32) -> f32 {
    return (w1 * x) * relu(w2 * x);
}

/// Apply SwiGLU to each element of x[idx..], into BUF_FF.
fn swiglu_vec(x: []f32, idx: u32) -> []f32 {
    const n = clamp_vec_len(x.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_FF[j] = swiglu_scalar(x[i], 0.5, 1.0);
        i = i + 1;
        j = j + 1;
    }
    return BUF_FF[0..j];
}

/// Apply SwiGLU with external BRAM-loaded weight per element, into BUF_FF.
fn swiglu_vec_with_weights(x: []f32, idx: u32, w: f32) -> []f32 {
    const n = clamp_vec_len(x.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_FF[j] = swiglu_scalar(x[i], w, w);
        i = i + 1;
        j = j + 1;
    }
    return BUF_FF[0..j];
}

/// Top-k argmax: index of the maximum logit (first one on ties).
/// The greedy pick from the k highest logits is the highest logit itself, so for
/// k >= 1 this is the global argmax; k = 0 or an empty slice give 0.
fn top_k_argmax(logits: []f32, k: u32) -> u32 {
    if (k == 0 || logits.len == 0) { return 0; }
    var best_idx : usize = 0;
    var best_val : f32 = logits[0];
    var i : usize = 1;
    while (i < logits.len) {
        if (logits[i] > best_val) {
            best_val = logits[i];
            best_idx = i;
        }
        i = i + 1;
    }
    return @intCast(best_idx);
}

// True when ids[0..upto] already contains cand.
fn index_taken(ids: []u32, upto: usize, cand: usize) -> bool {
    var r : usize = 0;
    while (r < upto) {
        if (ids[r] == cand) { return true; }
        r = r + 1;
    }
    return false;
}

/// top_k_indices(logits, k) -> []u32
/// Indices of the k highest logits, highest first (earlier index first on ties);
/// k is capped at MAX_TOPK and at len(logits). Into BUF_TOPK.
fn top_k_indices(logits: []f32, k: u32) -> []u32 {
    const m = min_usize(min_usize(k, MAX_TOPK), logits.len);
    var r : usize = 0;
    while (r < m) {
        var best_idx : usize = 0;
        var best_val : f32 = -999999.0;
        var found : bool = false;
        var i : usize = 0;
        while (i < logits.len) {
            if (!index_taken(BUF_TOPK[0..MAX_TOPK], r, i)) {
                if (!found || logits[i] > best_val) {
                    best_val = logits[i];
                    best_idx = i;
                    found = true;
                }
            }
            i = i + 1;
        }
        BUF_TOPK[r] = @intCast(best_idx);
        r = r + 1;
    }
    return BUF_TOPK[0..m];
}

/// Generate next token from logits using top-k sampling (temperature=1.0).
pub fn generate_next_token(logits: []f32, k: u32) -> u32 {
    return generate_next_token_temp(logits, k, 1.0);
}

/// softmax_approx(logits: []f32) -> []f32
/// Numerically stable softmax using max subtraction and exp_approx, into BUF_SOFT.
/// Empty when the logits are empty or the exponentials sum to 0.
fn softmax_approx(logits: []f32) -> []f32 {
    const n = clamp_vec_len(logits.len);
    if (n == 0) { return BUF_SOFT[0..0]; }
    const max_logit = find_max(logits[0..n], 0, -999999.0);
    var i : usize = 0;
    var total : f32 = 0.0;
    while (i < n) {
        const e = exp_approx(logits[i] - max_logit);
        BUF_SOFT[i] = e;
        total = total + e;
        i = i + 1;
    }
    if (total == 0.0) { return BUF_SOFT[0..0]; }
    var j : usize = 0;
    while (j < n) {
        BUF_SOFT[j] = BUF_SOFT[j] / total;
        j = j + 1;
    }
    return BUF_SOFT[0..n];
}

/// softmax_vec(x) -> []f32
/// Alias of softmax_approx: the softmax of a vector, into BUF_SOFT.
fn softmax_vec(x: []f32) -> []f32 {
    return softmax_approx(x);
}

// Largest of best and logits[idx..].
fn find_max(logits: []f32, idx: u32, best: f32) -> f32 {
    var i : usize = idx;
    var m : f32 = best;
    while (i < logits.len) {
        if (logits[i] > m) { m = logits[i]; }
        i = i + 1;
    }
    return m;
}

// Sum of v[idx..] added to acc.
fn sum_vec(v: []f32, idx: u32, acc: f32) -> f32 {
    var i : usize = idx;
    var total : f32 = acc;
    while (i < v.len) {
        total = total + v[i];
        i = i + 1;
    }
    return total;
}

// v[idx..] / denom, into BUF_DIV.
fn div_vec(v: []f32, denom: f32, idx: u32) -> []f32 {
    const n = clamp_vec_len(v.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_DIV[j] = v[i] / denom;
        i = i + 1;
        j = j + 1;
    }
    return BUF_DIV[0..j];
}

/// temperature_scale(logits: []f32, temp: f32) -> []f32
/// Divide each logit by temperature (temp = 0 leaves them unchanged). Into BUF_TEMP.
fn temperature_scale(logits: []f32, temp: f32) -> []f32 {
    return temperature_scale_inner(logits, temp, 0);
}

fn temperature_scale_inner(logits: []f32, temp: f32, idx: u32) -> []f32 {
    const n = clamp_vec_len(logits.len);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_TEMP[j] = if (temp == 0.0) { logits[i] } else { logits[i] / temp };
        i = i + 1;
        j = j + 1;
    }
    return BUF_TEMP[0..j];
}

/// generate_next_token_temp(logits, k, temp) -> u32
/// Temperature-scaled top-k greedy sampling.
/// Higher temperature flattens distribution; lower sharpens it.
pub fn generate_next_token_temp(logits: []f32, k: u32, temp: f32) -> u32 {
    let scaled = temperature_scale(logits, temp);
    let probs = softmax_approx(scaled);
    return top_k_argmax(probs, k);
}

/// generate_next_token_unified(logits, k, temp, p, beam_width) -> u32
/// Single API entry combining greedy, temperature-scaled top-k,
/// nucleus (top-p), and beam search.
/// Priority: beam > nucleus > temperature > greedy.
pub fn generate_next_token_unified(logits: []f32, k: u32, temp: f32, p: f32, beam_width: u32) -> u32 {
    if (beam_width > 1) {
        let result = beam_search_step(BUF_BEAM[0..0], logits, beam_width);
        if (result.len() > 0) {
            return result[0].token;
        }
        return top_k_argmax(logits, k);
    }
    if (p < 1.0) {
        return generate_next_token_stochastic(logits, k, temp, p);
    }
    return generate_next_token_temp(logits, k, temp);
}

/// forward_with_cache_bank(input_ids, cache, bank) -> (CoderForwardOutput, KVCache)
/// Forward pass with KV-cache and external WeightBank for autoregressive generation.
/// Appends the new hidden states to the KV cache as one key row and one value row.
fn forward_with_cache_bank(input_ids: []u32, cache: KVCache, bank: WeightBank) -> (CoderForwardOutput, KVCache) {
    let out = forward_with_bank(input_ids, bank, no_past_kv());
    let new_cache = kv_cache_incremental_update(cache, out.hidden_states, out.hidden_states);
    return (out, new_cache);
}

/// Forward pass with KV-cache for autoregressive generation.
/// Returns logits and the cache with this pass appended.
pub fn forward_with_cache(input_ids: []u32, cache: KVCache) -> (CoderForwardOutput, KVCache) {
    return forward_with_cache_bank(input_ids, cache, default_weight_bank());
}

/// DraftModelConfig: small draft model parameters for speculative decoding.
pub const DraftModelConfig = struct {
    d_model : u32,
    n_layers : u32,
    temperature : f32,
};

/// HeterogeneousNpuConfig: MOSAIC-style Big/Little/Special-Function tile mix.
pub const HeterogeneousNpuConfig = struct {
    big_tiles       : u32,
    little_tiles    : u32,
    special_tiles   : u32,
    tile_area_mm2   : f32,
    process_node_nm   : u16,
};

/// TileWorkloadProfile: describes compute intensity of a workload.
pub const TileWorkloadProfile = struct {
    compute_ops     : f32,    // GOPs per inference
    memory_mb       : f32,    // working set size
    sparsity_ratio  : f32,    // fraction of zero weights
};

/// compute_tile_energy(config, workload) -> f32
/// Estimates per-tile energy in pJ/op for a heterogeneous NPU configuration.
/// Based on MOSAIC ASAP7 models: Big=2.5 pJ/op, Little=0.8 pJ/op, Special=1.2 pJ/op.
pub fn compute_tile_energy(config: HeterogeneousNpuConfig, workload: TileWorkloadProfile) -> f32 {
    let big_energy   = 2.5 * workload.compute_ops;
    let little_energy = 0.8 * workload.compute_ops;
    let special_energy = 1.2 * workload.compute_ops;
    let total_tiles = config.big_tiles + config.little_tiles + config.special_tiles;
    if (total_tiles == 0) { return 0.0; }
    let total = (big_energy * config.big_tiles as f32
               + little_energy * config.little_tiles as f32
               + special_energy * config.special_tiles as f32)
               / total_tiles as f32;
    return total;
}

/// llm_guided_dse(prompt, target) -> HeterogeneousNpuConfig
/// Conceptual LLM-guided design-space exploration from a natural language prompt.
/// Returns a heterogeneous NPU configuration tuned for the target application.
pub fn llm_guided_dse(prompt: string, target: string) -> HeterogeneousNpuConfig {
    if (target == "edge") {
        return HeterogeneousNpuConfig { big_tiles: 0, little_tiles: 4, special_tiles: 1, tile_area_mm2: 0.5, process_node_nm: 16 };
    }
    if (target == "cloud") {
        return HeterogeneousNpuConfig { big_tiles: 8, little_tiles: 4, special_tiles: 2, tile_area_mm2: 4.0, process_node_nm: 7 };
    }
    return HeterogeneousNpuConfig { big_tiles: 2, little_tiles: 2, special_tiles: 1, tile_area_mm2: 1.0, process_node_nm: 7 };
}

/// rag_retrieve_architecture(query) -> string
/// Conceptual RAG retrieval of architecture documents for DSE.
/// Returns a hardware template name matching the query.
pub fn rag_retrieve_architecture(query: string) -> string {
    if (query.len() == 0) { return "generic"; }
    if (query[0] == 67) {  // 'C'
        return "cordic_accelerator";
    }
    if (query[0] == 83) {  // 'S'
        return "systolic_array";
    }
    if (query[0] == 84) {  // 'T'
        return "ternary_mac_unit";
    }
    return "generic";
}

/// round_to_u32(v) -> u32
/// Round a non-negative float to the nearest integer (halves up); v <= 0 gives 0.
fn round_to_u32(v: f32) -> u32 {
    if (v <= 0.0) { return 0; }
    return (v + 0.5) as u32;
}

/// load_draft_weights(bank) -> DraftModelConfig
/// Reads draft model config from first 3 BRAM scalars; d_model and n_layers
/// are the Q15 scalars rounded to the nearest integer.
fn load_draft_weights(bank: WeightBank) -> DraftModelConfig {
    let d_model = round_to_u32(load_scalar_weight(bank, 0, 0));
    let n_layers = round_to_u32(load_scalar_weight(bank, 0, 1));
    let temperature = load_scalar_weight(bank, 1, 0);
    return DraftModelConfig { d_model: d_model, n_layers: n_layers, temperature: temperature };
}

/// draft_forward(input_ids, draft_cfg) -> []f32
/// Simplified forward pass for a small draft model.
/// Returns scaled embeddings as "draft logits" for verification.
fn draft_forward(input_ids: []u32, draft_cfg: DraftModelConfig) -> []f32 {
    let emb = embedding_lookup(input_ids, 0);
    return scale_by_temp(emb, draft_cfg.temperature, 0);
}

// v[idx..] / temp (temp = 0 leaves them unchanged), into BUF_TEMP.
fn scale_by_temp(v: []f32, temp: f32, idx: u32) -> []f32 {
    return temperature_scale_inner(v, temp, idx);
}

/// verify_accept(draft_logits, target_logits) -> bool
/// Accept draft token if top-1 indices match between draft and target.
fn verify_accept(draft_logits: []f32, target_logits: []f32) -> bool {
    let draft_idx = top_k_argmax(draft_logits, 1);
    let target_idx = top_k_argmax(target_logits, 1);
    return draft_idx == target_idx;
}

/// speculative_decode_step(input_ids, draft_cfg) -> u32
/// Draft one token with small model, verify against target, accept or fallback.
fn speculative_decode_step(input_ids: []u32, draft_cfg: DraftModelConfig) -> u32 {
    let draft_logits = draft_forward(input_ids, draft_cfg);
    let target_logits = lm_head_from_hidden(draft_logits, 0);
    let accepted = verify_accept(draft_logits, target_logits);
    if (accepted) {
        return top_k_argmax(draft_logits, 1);
    }
    return top_k_argmax(target_logits, 1);
}

/// BeamCandidate: token, score, prefix_len for beam search.
pub const BeamCandidate = struct {
    token : u32,
    score : f32,
    prefix_len : u32,
};

/// beam_search_step(candidates, logits, beam_width) -> []BeamCandidate
/// Conceptual beam search: one expansion step. The single best next token extends
/// the beam; its prefix_len is len(candidates) + 1. Into BUF_BEAM.
fn beam_search_step(candidates: []BeamCandidate, logits: []f32, beam_width: u32) -> []BeamCandidate {
    if (beam_width == 0) { return BUF_BEAM[0..0]; }
    let best_token = top_k_argmax(logits, 1);
    let plen = @as(u32, @intCast(candidates.len)) + 1;
    BUF_BEAM[0] = BeamCandidate { token: best_token, score: 0.0, prefix_len: plen };
    return BUF_BEAM[0..1];
}

/// score_beam_candidate(candidate, length_penalty) -> BeamCandidate
/// Applies length penalty to beam candidate score.
/// Formula: score = score / (prefix_len ^ length_penalty)
fn score_beam_candidate(candidate: BeamCandidate, length_penalty: f32) -> BeamCandidate {
    let lp = if (length_penalty == 0.0) { 1.0 } else { pow_approx(candidate.prefix_len as f32, length_penalty) };
    if (lp == 0.0) {
        return candidate;
    }
    return BeamCandidate { token: candidate.token, score: candidate.score / lp, prefix_len: candidate.prefix_len };
}

/// select_best_beam(candidates, beam_width) -> []BeamCandidate
/// Conceptually selects top beam_width candidates by score.
/// Simplified: returns first beam_width candidates or all if fewer
/// (at most MAX_BEAMS). Into BUF_BEAM.
fn select_best_beam(candidates: []BeamCandidate, beam_width: u32) -> []BeamCandidate {
    return select_best_beam_inner(candidates, beam_width, 0);
}

fn select_best_beam_inner(candidates: []BeamCandidate, beam_width: u32, idx: u32) -> []BeamCandidate {
    const n = min_usize(min_usize(beam_width, candidates.len), MAX_BEAMS);
    var i : usize = idx;
    var j : usize = 0;
    while (i < n) {
        BUF_BEAM[j] = candidates[i];
        i = i + 1;
        j = j + 1;
    }
    return BUF_BEAM[0..j];
}

/// generate_beam_search(bank, initial_ids, beam_width, max_depth, length_penalty) -> []BeamCandidate
/// Conceptual beam search with external WeightBank.
/// Expands one candidate per step for max_depth steps (at most MAX_BEAMS),
/// feeding each chosen token back into the prompt. Into BUF_BEAM.
fn generate_beam_search(bank: WeightBank, initial_ids: []u32, beam_width: u32, max_depth: u32, length_penalty: f32) -> []BeamCandidate {
    var n_ids : usize = min_usize(initial_ids.len, MAX_IDS);
    var q : usize = 0;
    while (q < n_ids) {
        BUF_IDS[q] = initial_ids[q];
        q = q + 1;
    }
    var depth : u32 = 0;
    var count : usize = 0;
    while (depth < max_depth && count < MAX_BEAMS) {
        let out = forward_with_bank(BUF_IDS[0..n_ids], bank, no_past_kv());
        let next_token = generate_next_token_unified(out.logits, beam_width, 1.0, 1.0, 1);
        BUF_BEAM[count] = score_beam_candidate(BeamCandidate { token: next_token, score: 1.0, prefix_len: depth + 1 }, length_penalty);
        count = count + 1;
        if (n_ids < MAX_IDS) {
            BUF_IDS[n_ids] = next_token;
            n_ids = n_ids + 1;
        }
        depth = depth + 1;
    }
    return BUF_BEAM[0..count];
}

/// generate_beam_search_cached(bank, initial_ids, cache, beam_width, max_depth, length_penalty) -> ([]BeamCandidate, KVCache)
/// Beam search with KV-cache incremental update.
/// One step: the cache gains this pass's hidden states; max_depth = 0 yields no candidate.
fn generate_beam_search_cached(bank: WeightBank, initial_ids: []u32, cache: KVCache, beam_width: u32, max_depth: u32, length_penalty: f32) -> ([]BeamCandidate, KVCache) {
    let (out, new_cache) = forward_with_cache_bank(initial_ids, cache, bank);
    if (max_depth == 0) { return (BUF_BEAM[0..0], new_cache); }
    let next_token = generate_next_token_unified(out.logits, beam_width, 1.0, 1.0, 1);
    BUF_BEAM[0] = score_beam_candidate(BeamCandidate { token: next_token, score: 1.0, prefix_len: 1 }, length_penalty);
    return (BUF_BEAM[0..1], new_cache);
}

/// cumulative_prob(probs, idx, acc) -> f32
/// Sum of probs[idx..] added to acc.
fn cumulative_prob(probs: []f32, idx: u32, acc: f32) -> f32 {
    return sum_vec(probs, idx, acc);
}

/// top_p_mask(logits, probs, p) -> []f32
/// Zero out tokens outside the nucleus (cumulative probability > p). Into BUF_MASK.
fn top_p_mask(logits: []f32, probs: []f32, p: f32) -> []f32 {
    return top_p_mask_inner(logits, probs, p, 0, 0.0);
}

// Entries idx.. of the mask; acc is the probability mass before idx.
fn top_p_mask_inner(logits: []f32, probs: []f32, p: f32, idx: u32, acc: f32) -> []f32 {
    const n = clamp_vec_len(logits.len);
    var i : usize = idx;
    var j : usize = 0;
    var running : f32 = acc;
    while (i < n) {
        running = running + (if (i < probs.len) { probs[i] } else { 0.0 });
        BUF_MASK[j] = if (running <= p) { logits[i] } else { 0.0 };
        i = i + 1;
        j = j + 1;
    }
    return BUF_MASK[0..j];
}

/// generate_next_token_nucleus(logits, p, temp) -> u32
/// Temperature-scaled nucleus (top-p) sampling.
fn generate_next_token_nucleus(logits: []f32, p: f32, temp: f32) -> u32 {
    let scaled = temperature_scale(logits, temp);
    let probs = softmax_approx(scaled);
    let masked = top_p_mask(scaled, probs, p);
    return top_k_argmax(masked, @as(u32, @intCast(logits.len)));
}

/// cumulative_probs(probs: []f32) -> []f32
/// Returns prefix-sum cumulative distribution, into BUF_CUMUL.
/// Element i = sum of probs[0..=i].
fn cumulative_probs(probs: []f32) -> []f32 {
    return cumulative_probs_inner(probs, 0, 0.0);
}

// Prefix sums over probs[idx..], starting from acc.
fn cumulative_probs_inner(probs: []f32, idx: u32, acc: f32) -> []f32 {
    const n = clamp_vec_len(probs.len);
    var i : usize = idx;
    var j : usize = 0;
    var running : f32 = acc;
    while (i < n) {
        running = running + probs[i];
        BUF_CUMUL[j] = running;
        i = i + 1;
        j = j + 1;
    }
    return BUF_CUMUL[0..j];
}

/// multinomial_sample(probs, threshold) -> u32
/// Sample token from probability distribution by walking cumulative probabilities.
/// Returns first index where cumulative probability >= threshold (the last
/// index when none reaches it; 0 for an empty distribution).
/// Deterministic in spec; threshold represents external randomness source.
fn multinomial_sample(probs: []f32, threshold: f32) -> u32 {
    let cumul = cumulative_probs(probs);
    return multinomial_walk(cumul, threshold, 0);
}

fn multinomial_walk(cumul: []f32, threshold: f32, idx: u32) -> u32 {
    if (cumul.len == 0) { return 0; }
    var i : usize = idx;
    while (i < cumul.len) {
        if (cumul[i] >= threshold) { return @intCast(i); }
        i = i + 1;
    }
    return @intCast(cumul.len - 1);
}

/// generate_next_token_stochastic(logits, k, temp, p) -> u32
/// Sample from softmax distribution after top-p masking and temperature scaling.
/// Uses multinomial_sample with threshold as conceptual random source.
pub fn generate_next_token_stochastic(logits: []f32, k: u32, temp: f32, p: f32) -> u32 {
    let scaled = temperature_scale(logits, temp);
    let probs = softmax_approx(scaled);
    let masked = top_p_mask(probs, probs, p);
    // Re-normalize masked probabilities
    let masked_sum = sum_vec(masked, 0, 0.0);
    if (masked_sum == 0.0) { return top_k_argmax(logits, k); }
    let normalized = div_vec(masked, masked_sum, 0);
    // Deterministic threshold: pick median probability mass as conceptual random draw
    let threshold = masked_sum * 0.5;
    return multinomial_sample(normalized, threshold);
}

/// kv_cache_row_count(cache) -> u32
/// Returns the number of KV rows in cache.
fn kv_cache_row_count(cache: KVCache) -> u32 {
    return cache.rows;
}

/// kv_cache_incremental_update(cache, key_row, value_row) -> KVCache
/// Appends key/value rows to KV cache for incremental attention. A row longer
/// than KV_ROW_CAP is truncated to it; a full cache (KV_MAX_ROWS rows) is
/// returned unchanged.
fn kv_cache_incremental_update(cache: KVCache, key_row: []f32, value_row: []f32) -> KVCache {
    var c : KVCache = cache;
    if (c.rows >= KV_MAX_ROWS) { return c; }
    const base = c.rows * KV_ROW_CAP;
    const kn = min_usize(key_row.len, KV_ROW_CAP);
    const vn = min_usize(value_row.len, KV_ROW_CAP);
    var j : usize = 0;
    while (j < kn) {
        c.key_cache[base + j] = key_row[j];
        j = j + 1;
    }
    var m : usize = 0;
    while (m < vn) {
        c.value_cache[base + m] = value_row[m];
        m = m + 1;
    }
    c.key_lens[c.rows] = @intCast(kn);
    c.value_lens[c.rows] = @intCast(vn);
    c.rows = c.rows + 1;
    return c;
}

/// kv_cache_append(cache, key_row, value_row) -> KVCache
/// Legacy alias for kv_cache_incremental_update.
fn kv_cache_append(cache: KVCache, key_row: []f32, value_row: []f32) -> KVCache {
    return kv_cache_incremental_update(cache, key_row, value_row);
}

/// kv_cache_from_single_rows(key_row, value_row) -> KVCache
/// Construct a KVCache from a single key/value row pair.
fn kv_cache_from_single_rows(key_row: []f32, value_row: []f32) -> KVCache {
    return kv_cache_incremental_update(empty_kv_cache(), key_row, value_row);
}

/// kv_cache_empty() -> KVCache
/// Returns an empty KVCache.
fn kv_cache_empty() -> KVCache {
    return empty_kv_cache();
}

// ============================================================================
// 7. Register file and benchmark input helpers
// ============================================================================

/// zero_init_registers() -> RegisterFile
/// All eight registers cleared.
fn zero_init_registers() -> RegisterFile {
    return RegisterFile { x0: 0, x1: 0, x2: 0, x3: 0, x4: 0, x5: 0, x6: 0, x7: 0 };
}

/// read_register(rf, idx) -> i32
/// Value of register x<idx>; an index past x7 reads 0.
fn read_register(rf: RegisterFile, idx: u32) -> i32 {
    if (idx == 0) { return rf.x0; }
    if (idx == 1) { return rf.x1; }
    if (idx == 2) { return rf.x2; }
    if (idx == 3) { return rf.x3; }
    if (idx == 4) { return rf.x4; }
    if (idx == 5) { return rf.x5; }
    if (idx == 6) { return rf.x6; }
    if (idx == 7) { return rf.x7; }
    return 0;
}

/// random_tokens(n) -> []u32
/// n deterministic pseudo-random token ids below VOCAB_SIZE (linear congruential
/// generator, fixed seed), n capped at MAX_IDS. Into BUF_IDS.
fn random_tokens(n: u32) -> []u32 {
    const m = min_usize(n, MAX_IDS);
    var s : u64 = 12345;
    var i : usize = 0;
    while (i < m) {
        s = (s * 1103515245 + 12345) % 2147483648;
        BUF_IDS[i] = @intCast(s % VOCAB_SIZE);
        i = i + 1;
    }
    return BUF_IDS[0..m];
}

