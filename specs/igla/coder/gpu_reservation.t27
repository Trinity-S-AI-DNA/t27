// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/gpu_reservation.t27
// GPU reservation spec for IGLA CODER / HSLM retraining (GOLDEN TRAINING)
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// Reservation status: CONFIRMED. Owner go on 2026-10-31.
// Gate: scripts/train_igla_coder.sh aborts unless RESERVATION_STATUS_CONFIRMED
// is present in this file.

module igla-coder-gpu-reservation;

// ============================================================================
// 1. Reservation Status Codes
// ============================================================================

pub const RESERVATION_STATUS_PENDING   : u8 = 0;
pub const RESERVATION_STATUS_CONFIRMED : u8 = 1;
pub const RESERVATION_STATUS_RELEASED  : u8 = 2;

// ============================================================================
// 2. Reservation Record
// ============================================================================

pub const GpuReservation = struct {
    status           : u8,      // one of RESERVATION_STATUS_*
    cluster          : str,     // target cluster name
    device_type      : str,     // e.g. "AMD CMP 170H" / "NVIDIA GPU"
    device_count     : u8,      // number of GPUs reserved
    reservation_id   : str,     // HPC cluster ticket ID
    approved_by      : str,     // HPC admin / owner who confirmed
    approved_at_iso  : str,     // ISO-8601 timestamp of confirmation
    start_at_iso     : str,     // reserved start time
    end_at_iso       : str,     // reserved end time
    gpu_memory_gb    : u16,     // GPU memory in GB
    notes            : str,     // free-form notes
};

// ============================================================================
// 3. Current Reservation — CONFIRMED
// ============================================================================

pub const CURRENT_RESERVATION : GpuReservation = GpuReservation {
    status           : RESERVATION_STATUS_CONFIRMED,
    cluster          : "local-mac (owner decision 2026-11-02: this machine IS hpc-t27-lab)",
    device_type      : "Apple Mac CPU, no CUDA - shakedown track only",
    device_count     : 1,
    reservation_id   : "T27-LOCAL-2026-11-02-001",
    approved_by      : "owner (instruction: run locally, embed hpc-t27-lab)",
    approved_at_iso  : "2026-11-02T00:00:00Z",
    start_at_iso     : "2026-11-02T00:00:00Z",
    end_at_iso       : "unset until the shakedown completes",
    gpu_memory_gb    : 0,
    notes            : "Owner redirected the lab to the local Mac for the P4 shakedown: 13m ternary CPU pilot on a repo-sourced byte corpus. This authorizes the pipeline shakedown ONLY - it is not a GPU result and makes no model-quality claim. A real GPU cluster (CMP 170H or legal cloud) remains unconfirmed; its budget lives in p4_budget.t27.",
};

// ============================================================================
// 4. Gate Function
// ============================================================================

/// is_confirmed(reservation) -> bool
/// True when reservation status is CONFIRMED. Used by train_igla_coder.sh
/// as the GPU reservation gate.
pub fn is_confirmed(reservation: GpuReservation) -> bool {
    return reservation.status == RESERVATION_STATUS_CONFIRMED;
}

// ============================================================================
// 5. Tests
// ============================================================================

test gate_open_for_local_shakedown {
    // 2026-11-02: owner embedded hpc-t27-lab into the local Mac for the
    // shakedown track; the gate is open for that, and nothing here claims GPU.
    assert is_confirmed(CURRENT_RESERVATION) == true;
}

test reservation_is_confirmed_for_shakedown_only {
    assert CURRENT_RESERVATION.status == RESERVATION_STATUS_CONFIRMED;
    assert CURRENT_RESERVATION.gpu_memory_gb == 0; // no GPU on this track
}

test reservation_has_id {
    assert CURRENT_RESERVATION.reservation_id.len() > 0;
}

test reservation_has_approver {
    assert CURRENT_RESERVATION.approved_by.len() > 0;
}

test reservation_memory_zero_is_honest_here {
    // CPU shakedown track: zero GPU memory is the truth, not a defect.
    assert CURRENT_RESERVATION.gpu_memory_gb == 0;
}

// ============================================================================
// 6. Benchmarks
// ============================================================================

bench reservation_gate_latency {
    let r = is_confirmed(CURRENT_RESERVATION);
    _ = r;
}
