// SPDX-License-Identifier: Apache-2.0
// t27/specs/igla/coder/tokenizer.t27
// Conceptual tokenizer for Verilog / t27 syntax
// Deterministic character-level encoding (ASCII -> ID) for spec safety.
// Real BPE/SentencePiece requires runtime support.
//
// There is no heap in a spec, so every function that used to RETURN a
// fresh token list or string now WRITES into a caller buffer and returns
// the number of items written, or NONE (and may leave a partial result)
// when the buffer is too short. Same convention as specs/tri/crypto/hex.t27.
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla-coder-tokenizer;
use base::types;

// ============================================================================
// 1. Types and constants
// ============================================================================

/// VocabEntry: one token -> ID mapping.
pub const VocabEntry = struct {
    token : string,
    id    : u32,
};

/// NONE: "buffer too short" marker returned instead of a length.
pub const NONE : usize = 18446744073709551615;

/// BOS_ID: beginning-of-sequence token, prepended by add_special_tokens.
pub const BOS_ID : u32 = 0;

// ============================================================================
// 2. Character-Level Encode / Decode
// ============================================================================

/// encode_char(c) -> u32
/// Maps an ASCII byte to its token ID.
/// Deterministic: ID == ASCII code for spec safety.
pub fn encode_char(c: u8) -> u32 {
    return c as u32;
}

/// decode_char(id) -> u8
/// Maps a token ID back to ASCII byte.
/// Values >= 256 clamp to '?'
pub fn decode_char(id: u32) -> u8 {
    if (id < 256) {
        return id as u8;
    }
    return 63;
}

/// vocab_size() -> u32
/// Hardcoded ASCII vocab size.
pub fn vocab_size() -> u32 {
    return 256;
}

/// vocab_size_keywords() -> u32
/// Number of keyword tokens beyond ASCII base.
pub fn vocab_size_keywords() -> u32 {
    return 64;
}

// ============================================================================
// 3. Keyword-Level Encode / Decode
// ============================================================================

/// encode_keyword(keyword) -> u32
/// Maps a Verilog keyword to a keyword token ID (base 256 + offset).
/// Returns 0 for unknown keywords.
pub fn encode_keyword(keyword: string) -> u32 {
    if (keyword == "module")     { return 256; }
    if (keyword == "endmodule")  { return 257; }
    if (keyword == "input")      { return 258; }
    if (keyword == "output")     { return 259; }
    if (keyword == "wire")       { return 260; }
    if (keyword == "reg")        { return 261; }
    if (keyword == "assign")     { return 262; }
    if (keyword == "always")     { return 263; }
    if (keyword == "begin")      { return 264; }
    if (keyword == "end")        { return 265; }
    if (keyword == "if")         { return 266; }
    if (keyword == "else")       { return 267; }
    if (keyword == "case")       { return 268; }
    if (keyword == "endcase")    { return 269; }
    if (keyword == "posedge")    { return 270; }
    if (keyword == "negedge")    { return 271; }
    if (keyword == "or")         { return 272; }
    if (keyword == "and")        { return 273; }
    if (keyword == "not")        { return 274; }
    if (keyword == "nand")       { return 275; }
    if (keyword == "nor")        { return 276; }
    if (keyword == "xor")        { return 277; }
    if (keyword == "xnor")       { return 278; }
    if (keyword == "buf")        { return 279; }
    if (keyword == "integer")    { return 280; }
    if (keyword == "parameter")  { return 281; }
    if (keyword == "localparam") { return 282; }
    if (keyword == "defparam")   { return 283; }
    if (keyword == "generate")   { return 284; }
    if (keyword == "endgenerate"){ return 285; }
    if (keyword == "function")   { return 286; }
    if (keyword == "endfunction"){ return 287; }
    if (keyword == "task")       { return 288; }
    if (keyword == "endtask")    { return 289; }
    if (keyword == "signed")     { return 290; }
    if (keyword == "unsigned")   { return 291; }
    if (keyword == "clk")        { return 292; }
    if (keyword == "rst_n")      { return 293; }
    if (keyword == "rst")        { return 294; }
    if (keyword == "inout")      { return 295; }
    if (keyword == "tri")        { return 296; }
    if (keyword == "supply0")    { return 297; }
    if (keyword == "supply1")    { return 298; }
    if (keyword == "ground")     { return 299; }
    if (keyword == "highz")      { return 300; }
    if (keyword == "pullup")     { return 301; }
    if (keyword == "pulldown")   { return 302; }
    if (keyword == "specify")    { return 303; }
    if (keyword == "endspecify") { return 304; }
    if (keyword == "initial")    { return 305; }
    if (keyword == "forever")    { return 306; }
    if (keyword == "repeat")     { return 307; }
    if (keyword == "while")      { return 308; }
    if (keyword == "for")        { return 309; }
    if (keyword == "switch")     { return 310; }
    if (keyword == "return")     { return 311; }
    if (keyword == "break")      { return 312; }
    if (keyword == "continue")   { return 313; }
    if (keyword == "typedef")    { return 314; }
    if (keyword == "struct")     { return 315; }
    if (keyword == "union")      { return 316; }
    if (keyword == "enum")       { return 317; }
    if (keyword == "packed")     { return 318; }
    if (keyword == "unpacked")   { return 319; }
    return 0;
}

/// decode_keyword(id) -> string
/// Maps a keyword token ID back to string. Returns "" for unknown IDs.
pub fn decode_keyword(id: u32) -> string {
    if (id == 256) { return "module"; }
    if (id == 257) { return "endmodule"; }
    if (id == 258) { return "input"; }
    if (id == 259) { return "output"; }
    if (id == 260) { return "wire"; }
    if (id == 261) { return "reg"; }
    if (id == 262) { return "assign"; }
    if (id == 263) { return "always"; }
    if (id == 264) { return "begin"; }
    if (id == 265) { return "end"; }
    if (id == 266) { return "if"; }
    if (id == 267) { return "else"; }
    if (id == 268) { return "case"; }
    if (id == 269) { return "endcase"; }
    if (id == 270) { return "posedge"; }
    if (id == 271) { return "negedge"; }
    if (id == 272) { return "or"; }
    if (id == 273) { return "and"; }
    if (id == 274) { return "not"; }
    if (id == 275) { return "nand"; }
    if (id == 276) { return "nor"; }
    if (id == 277) { return "xor"; }
    if (id == 278) { return "xnor"; }
    if (id == 279) { return "buf"; }
    if (id == 280) { return "integer"; }
    if (id == 281) { return "parameter"; }
    if (id == 282) { return "localparam"; }
    if (id == 283) { return "defparam"; }
    if (id == 284) { return "generate"; }
    if (id == 285) { return "endgenerate"; }
    if (id == 286) { return "function"; }
    if (id == 287) { return "endfunction"; }
    if (id == 288) { return "task"; }
    if (id == 289) { return "endtask"; }
    if (id == 290) { return "signed"; }
    if (id == 291) { return "unsigned"; }
    if (id == 292) { return "clk"; }
    if (id == 293) { return "rst_n"; }
    if (id == 294) { return "rst"; }
    if (id == 295) { return "inout"; }
    if (id == 296) { return "tri"; }
    if (id == 297) { return "supply0"; }
    if (id == 298) { return "supply1"; }
    if (id == 299) { return "ground"; }
    if (id == 300) { return "highz"; }
    if (id == 301) { return "pullup"; }
    if (id == 302) { return "pulldown"; }
    if (id == 303) { return "specify"; }
    if (id == 304) { return "endspecify"; }
    if (id == 305) { return "initial"; }
    if (id == 306) { return "forever"; }
    if (id == 307) { return "repeat"; }
    if (id == 308) { return "while"; }
    if (id == 309) { return "for"; }
    if (id == 310) { return "switch"; }
    if (id == 311) { return "return"; }
    if (id == 312) { return "break"; }
    if (id == 313) { return "continue"; }
    if (id == 314) { return "typedef"; }
    if (id == 315) { return "struct"; }
    if (id == 316) { return "union"; }
    if (id == 317) { return "enum"; }
    if (id == 318) { return "packed"; }
    if (id == 319) { return "unpacked"; }
    return "";
}

/// vocab_size_total() -> u32
/// Combined ASCII + keyword vocab size.
pub fn vocab_size_total() -> u32 {
    return vocab_size() + vocab_size_keywords();
}

// ============================================================================
// 4. Buffer writers (the no-heap replacement for list / string concatenation)
// ============================================================================

/// put_token(out, n, t) -> usize
/// Writes token t at out[n]; returns n + 1, or NONE when out is full.
fn put_token(out: []u32, n: usize, t: u32) -> usize {
    if (n >= out.len) {
        return NONE;
    }
    out[n] = t;
    return n + 1;
}

/// put_byte(out, n, b) -> usize
/// Writes byte b at out[n]; returns n + 1, or NONE when out is full.
fn put_byte(out: []u8, n: usize, b: u8) -> usize {
    if (n >= out.len) {
        return NONE;
    }
    out[n] = b;
    return n + 1;
}

/// put_str(out, n, s) -> usize
/// Copies the bytes of s to out[n..]; returns n + s.len, or NONE when they do not fit.
fn put_str(out: []u8, n: usize, s: []const u8) -> usize {
    if (n > out.len) {
        return NONE;
    }
    if (out.len - n < s.len) {
        return NONE;
    }
    var k : usize = 0;
    while (k < s.len) {
        out[n + k] = s[k];
        k = k + 1;
    }
    return n + s.len;
}

// ============================================================================
// 5. Tokenize / Detokenize
// ============================================================================

/// tokenize(text, out) -> usize
/// Character-level encoding. Writes the ASCII code of each byte to out.
pub fn tokenize(text: []const u8, out: []u32) -> usize {
    if (out.len < text.len) {
        return NONE;
    }
    var i : usize = 0;
    while (i < text.len) {
        out[i] = encode_char(text[i]);
        i = i + 1;
    }
    return text.len;
}

/// encode(text, out) -> usize
/// The byte-level encoder: one token per byte (same as tokenize).
pub fn encode(text: []const u8, out: []u32) -> usize {
    return tokenize(text, out);
}

/// detokenize(tokens, out) -> usize
/// Real ASCII decoder. Maps each token ID < 256 to its ASCII byte (a NUL byte
/// is written as a space); keyword tokens (>= 256) decode via decode_keyword
/// for mixed-mode support. Returns the number of bytes written.
pub fn detokenize(tokens: []const u32, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < tokens.len) {
        if (tokens[i] < 256) {
            var ch : u8 = decode_char(tokens[i]);
            if (ch == 0) {
                ch = 32;
            }
            n = put_byte(out, n, ch);
        } else {
            n = put_str(out, n, decode_keyword(tokens[i]));
        }
        if (n == NONE) {
            return NONE;
        }
        i = i + 1;
    }
    return n;
}

/// decode(tokens, out) -> usize
/// The mixed-mode decoder (same as detokenize).
pub fn decode(tokens: []const u32, out: []u8) -> usize {
    return detokenize(tokens, out);
}

/// detokenize_first_token(tokens) -> u8
/// Returns decoded first token if available; conceptual for testing.
pub fn detokenize_first_token(tokens: []const u32) -> u8 {
    if (tokens.len == 0) {
        return 0;
    }
    return decode_char(tokens[0]);
}

/// add_special_tokens(tokens, out) -> usize
/// Writes BOS_ID followed by tokens into out; returns tokens.len + 1.
pub fn add_special_tokens(tokens: []const u32, out: []u32) -> usize {
    if (out.len < tokens.len + 1) {
        return NONE;
    }
    out[0] = BOS_ID;
    var i : usize = 0;
    while (i < tokens.len) {
        out[i + 1] = tokens[i];
        i = i + 1;
    }
    return tokens.len + 1;
}

/// skip_spaces(code, start) -> usize
/// Advances index past contiguous spaces.
pub fn skip_spaces(code: []const u8, start: usize) -> usize {
    var i : usize = start;
    while (i < code.len) {
        if (code[i] != 32) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

/// word_end(code, start) -> usize
/// Index of the first space at or after start (code.len when there is none).
fn word_end(code: []const u8, start: usize) -> usize {
    var i : usize = start;
    while (i < code.len) {
        if (code[i] == 32) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

/// next_word(code, start) -> string
/// Extracts next contiguous non-space substring; "" when start is at a space
/// or past the end.
pub fn next_word(code: []const u8, start: usize) -> []const u8 {
    if (start >= code.len) {
        return "";
    }
    if (code[start] == 32) {
        return "";
    }
    return code[start..word_end(code, start)];
}

/// tokenize_word_ascii(word, out, at) -> usize
/// Character-level ASCII encoding for a single word, written at out[at..].
/// Returns the index after the last token written, or NONE when it does not fit.
pub fn tokenize_word_ascii(word: []const u8, out: []u32, at: usize) -> usize {
    if (at > out.len) {
        return NONE;
    }
    if (out.len - at < word.len) {
        return NONE;
    }
    var i : usize = 0;
    while (i < word.len) {
        out[at + i] = word[i] as u32;
        i = i + 1;
    }
    return at + word.len;
}

/// tokenize_verilog(code, out) -> usize
/// Keyword-level tokenizer. Splits on spaces and encodes known keywords.
/// Unknown words are dropped. Conceptual: real runtime needs full lexer.
pub fn tokenize_verilog(code: []const u8, out: []u32) -> usize {
    var i : usize = 0;
    var n : usize = 0;
    while (i < code.len) {
        const word = next_word(code, i);
        if (word.len == 0) {
            i = skip_spaces(code, i);
        } else {
            const kw_id = encode_keyword(word);
            if (kw_id > 0) {
                n = put_token(out, n, kw_id);
                if (n == NONE) {
                    return NONE;
                }
            }
            i = i + word.len;
        }
    }
    return n;
}

/// detokenize_verilog(tokens, out) -> usize
/// Keyword-level decoder. Joins decoded keywords with single spaces.
pub fn detokenize_verilog(tokens: []const u32, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < tokens.len) {
        if (i > 0) {
            n = put_byte(out, n, 32);
            if (n == NONE) {
                return NONE;
            }
        }
        n = put_str(out, n, decode_keyword(tokens[i]));
        if (n == NONE) {
            return NONE;
        }
        i = i + 1;
    }
    return n;
}

/// tokenize_prompt_hybrid(prompt, out) -> usize
/// Hybrid tokenizer for natural language prompts.
/// Splits on spaces. If a word matches a Verilog keyword, encodes as keyword ID.
/// Otherwise encodes each character as ASCII code.
pub fn tokenize_prompt_hybrid(prompt: []const u8, out: []u32) -> usize {
    var i : usize = 0;
    var n : usize = 0;
    while (i < prompt.len) {
        const word = next_word(prompt, i);
        if (word.len == 0) {
            i = skip_spaces(prompt, i);
        } else {
            const kw_id = encode_keyword(word);
            if (kw_id > 0) {
                n = put_token(out, n, kw_id);
            } else {
                n = tokenize_word_ascii(word, out, n);
            }
            if (n == NONE) {
                return NONE;
            }
            i = i + word.len;
        }
    }
    return n;
}

// ============================================================================
// 6. Test helpers
// ============================================================================

fn same_bytes(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    var k : usize = 0;
    while (k < a.len) {
        if (a[k] != b[k]) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// detok_is(tokens, want): detokenize(tokens) is exactly the bytes of want.
fn detok_is(tokens: []const u32, want: []const u8) -> bool {
    var buf : [64]u8 = [42] ** 64;
    const n = detokenize(tokens, &buf);
    if (n == NONE) {
        return false;
    }
    return same_bytes(buf[0..n], want);
}

/// detok_verilog_is(tokens, want): detokenize_verilog(tokens) is exactly want.
fn detok_verilog_is(tokens: []const u32, want: []const u8) -> bool {
    var buf : [64]u8 = [42] ** 64;
    const n = detokenize_verilog(tokens, &buf);
    if (n == NONE) {
        return false;
    }
    return same_bytes(buf[0..n], want);
}

/// text_roundtrip(text): decode(encode(text)) gives text back byte for byte.
fn text_roundtrip(text: []const u8) -> bool {
    var toks : [64]u32 = [0] ** 64;
    var back : [64]u8 = [42] ** 64;
    const n = encode(text, &toks);
    if (n == NONE) {
        return false;
    }
    const m = decode(toks[0..n], &back);
    if (m == NONE) {
        return false;
    }
    return same_bytes(back[0..m], text);
}

/// bos_len(tokens): length of add_special_tokens(tokens) (NONE if it did not fit).
fn bos_len(tokens: []const u32) -> usize {
    var buf : [16]u32 = [7] ** 16;
    return add_special_tokens(tokens, &buf);
}

/// bos_first(tokens): first token of add_special_tokens(tokens).
fn bos_first(tokens: []const u32) -> u32 {
    var buf : [16]u32 = [7] ** 16;
    const n = add_special_tokens(tokens, &buf);
    if (n == NONE) {
        return 7;
    }
    return buf[0];
}

/// tokens_len(text): number of tokens tokenize(text) writes.
fn tokens_len(text: []const u8) -> usize {
    var buf : [64]u32 = [0] ** 64;
    return tokenize(text, &buf);
}

/// verilog_len(code): number of tokens tokenize_verilog(code) writes.
fn verilog_len(code: []const u8) -> usize {
    var buf : [64]u32 = [0] ** 64;
    return tokenize_verilog(code, &buf);
}

// ============================================================================
// 7. Tests
// ============================================================================

test encode_char_a {
    assert encode_char(97) == 97;
}

test decode_char_a {
    assert decode_char(97) == 97;
}

test decode_char_oob {
    assert decode_char(999) == 63;
}

test vocab_size_value {
    assert vocab_size() == 256;
}

test tokenize_empty {
    var buf : [4]u32 = [9] ** 4;
    assert tokenize("", &buf) == 0;
    assert buf[0] == 9;
}

test tokenize_abc {
    var buf : [8]u32 = [0] ** 8;
    assert tokenize("abc", &buf) == 3;
    assert buf[0] == 97 and buf[1] == 98 and buf[2] == 99;
}

test detokenize_empty {
    const tokens : [1]u32 = [97];
    assert detok_is(tokens[0..0], "");
}

test detokenize_first_token {
    const tokens : [3]u32 = [97, 98, 99];
    assert detokenize_first_token(&tokens) == 97;
}

// Keyword-level tests

test encode_keyword_module {
    assert encode_keyword("module") == 256;
}

test decode_keyword_module {
    assert same_bytes(decode_keyword(256), "module");
}

test vocab_size_total_value {
    assert vocab_size_total() == 320;
}

test tokenize_verilog_module {
    var buf : [8]u32 = [0] ** 8;
    assert tokenize_verilog("module input output", &buf) == 3;
    assert buf[0] == 256 and buf[1] == 258 and buf[2] == 259;
}

test detokenize_verilog_roundtrip {
    const tokens : [3]u32 = [256, 258, 259];
    assert detok_verilog_is(&tokens, "module input output");
}

// Hybrid tokenizer tests

test tokenize_prompt_hybrid_keyword {
    var buf : [8]u32 = [0] ** 8;
    assert tokenize_prompt_hybrid("module", &buf) == 1;
    assert buf[0] == 256;
}

test tokenize_prompt_hybrid_ascii_word {
    var buf : [8]u32 = [0] ** 8;
    assert tokenize_prompt_hybrid("abc", &buf) == 3;
    assert buf[0] == 97 and buf[1] == 98 and buf[2] == 99;
}

test tokenize_prompt_hybrid_mixed {
    var buf : [8]u32 = [0] ** 8;
    assert tokenize_prompt_hybrid("module abc", &buf) == 4;
    assert buf[0] == 256 and buf[1] == 97;
}

test tokenizer_roundtrip_hybrid {
    var buf : [8]u32 = [0] ** 8;
    const n = tokenize_prompt_hybrid("module", &buf);
    assert n == 1;
    assert detok_is(buf[0..n], "module");
}

test tokenize_word_ascii_basic {
    var buf : [8]u32 = [0] ** 8;
    assert tokenize_word_ascii("xyz", &buf, 0) == 3;
    assert buf[0] == 120 and buf[1] == 121 and buf[2] == 122;
}

test detokenize_single_token {
    const tokens : [1]u32 = [256];
    assert detok_is(&tokens, "module");
}

test encode_char_boundary {
    const c : u8 = 255;
    assert encode_char(c) == 255;
}

test decode_char_zero {
    // NUL: decode_char(0) is byte 0 (the old spec wrote this as '\0').
    assert decode_char(0) == 0;
}

test tokenize_single_char {
    var buf : [4]u32 = [0] ** 4;
    assert tokenize("a", &buf) == 1;
    assert buf[0] == 97;
}

test detokenize_empty_2 {
    const tokens : [1]u32 = [97];
    assert detok_is(tokens[0..0], "");
}

test encode_char_numeric {
    const c : u8 = 48;
    assert encode_char(c) == 48;
}

test tokenize_empty_string {
    assert tokens_len("") == 0;
}

test detokenize_two_tokens {
    const tokens : [2]u32 = [256, 257];
    assert detok_is(&tokens, "moduleendmodule");
}

test detokenize_ascii_abc {
    const tokens : [3]u32 = [97, 98, 99];
    assert detok_is(&tokens, "abc");
}

// ============================================================================
// 8. Properties (the old `forall` invariants, checked exhaustively)
// ============================================================================

// forall c : u8, decode_char(encode_char(c)) == c
test tokenizer_roundtrip_char {
    var c : u32 = 0;
    while (c < 256) {
        const b : u8 = c as u8;
        assert decode_char(encode_char(b)) == b;
        c = c + 1;
    }
}

invariant tokenizer_roundtrip_keyword_module:
    encode_keyword("module") == 256

test tokenizer_roundtrip_keyword_module_decode {
    assert same_bytes(decode_keyword(256), "module");
}

invariant tokenizer_roundtrip_keyword_endmodule:
    encode_keyword("endmodule") == 257

test tokenizer_roundtrip_keyword_endmodule_decode {
    assert same_bytes(decode_keyword(257), "endmodule");
}

// The old "encode_char(a) != undefined for every i32" had no meaning for a
// total function; the checkable content is that every byte has a defined
// token and it is the byte itself.
test encode_char_returns_defined {
    var c : u32 = 0;
    while (c < 256) {
        const b : u8 = c as u8;
        assert encode_char(b) == c;
        c = c + 1;
    }
}

test tokenizer_encode_char_zero {
    assert encode_char(0) == 0;
}

test tokenizer_decode_char_boundary_255 {
    assert decode_char(255) == 255;
}

test tokenizer_vocab_size_total_constant {
    assert vocab_size_total() == 320;
}

// forall c : u8, encode_char(c) < 256 (and <= 255)
test tokenizer_encode_char_bounded {
    var c : u32 = 0;
    while (c < 256) {
        const b : u8 = c as u8;
        assert encode_char(b) < 256;
        assert encode_char(b) <= 255;
        c = c + 1;
    }
}

// ============================================================================
// 9. Benchmarks
// ============================================================================

// The old `measure ... target latency_us < N` form has no clock in a spec; the
// bench bodies run the workload and check its result.
bench tokenize_latency_short {
    var buf : [64]u32 = [0] ** 64;
    const n = tokenize("module add2(); endmodule", &buf);
    assert n == 24;
}

bench tokenize_verilog_latency {
    var buf : [64]u32 = [0] ** 64;
    const n = tokenize_verilog("module input output wire reg assign", &buf);
    assert n == 6;
}

test tokenizer_encode_keyword_unknown_returns_zero {
    assert encode_keyword("unknown_xyz") == 0;
}

test tokenizer_tokenize_verilog_empty_string {
    assert verilog_len("") == 0;
}

test tokenizer_detokenize_verilog_empty_tokens {
    const tokens : [1]u32 = [256];
    assert detok_verilog_is(tokens[0..0], "");
}

// forall kw : string, encode_keyword(kw) == 0 || encode_keyword(kw) >= 256
// Checked on every keyword the decoder knows, on unknown words and on the
// ASCII range boundary.
test tokenizer_encode_keyword_unknown_returns_zero_property {
    assert encode_keyword("") == 0;
    assert encode_keyword("x") == 0;
    assert encode_keyword("Module") == 0;
    assert encode_keyword("modules") == 0;
    assert encode_keyword("unknown_xyz") == 0;
    var id : u32 = 256;
    while (id < 320) {
        const kw = encode_keyword(decode_keyword(id));
        assert kw == 0 or kw >= 256;
        id = id + 1;
    }
}

bench module_identity_latency_200 {
    // Measure: module-level identity
    // Target: < 10 cycles
    var input = 1;
    var result = input + 0;
    assert result == 1;
    _ = result;
}

test tokenize_verilog_unknown_word_ignored {
    assert verilog_len("unknown_keyword") == 0;
}

test tokenize_prompt_hybrid_unknown_then_known {
    var buf : [8]u32 = [0] ** 8;
    assert tokenize_prompt_hybrid("foo module", &buf) == 4;
    assert buf[0] == 102 and buf[1] == 111 and buf[2] == 111 and buf[3] == 256;
}

test detokenize_keyword_only {
    // The old expectation was "module", but detokenize decodes EVERY token:
    // [256, 257] is "module" then "endmodule", as detokenize_two_tokens says.
    const tokens : [2]u32 = [256, 257];
    assert detok_is(&tokens, "moduleendmodule");
}

test tokenizer_encode_decode_roundtrip_keyword {
    const id = encode_keyword("module");
    assert id == 256;
    // keyword ids are outside the ASCII range: decode_keyword gets them back,
    // decode_char clamps them to '?' (the old test expected decode_char to
    // return 256, which a u8 cannot hold).
    assert same_bytes(decode_keyword(id), "module");
    assert decode_char(id) == 63;
}

test tokenizer_tokenize_empty_string {
    assert tokens_len("") == 0;
}

test tokenizer_detokenize_single_char {
    const tokens : [1]u32 = [111];
    assert detok_is(&tokens, "o");
}

test tokenizer_encode_decode_char_roundtrip {
    assert decode_char(encode_char(65)) == 65;
}

test tokenizer_vocab_size_positive {
    assert vocab_size() > 0;
}

test tokenizer_detokenize_empty_empty {
    const tokens : [1]u32 = [97];
    assert detok_is(tokens[0..0], "");
}

// forall c : u8, decode_char(encode_char(c)) == c (second copy of the property)
test tokenizer_encode_decode_char_identity {
    var c : u32 = 0;
    while (c < 256) {
        const b : u8 = c as u8;
        assert decode_char(encode_char(b)) == b;
        c = c + 1;
    }
}

// forall kw : string, encode_keyword(kw) == encode_keyword(kw)
test tokenizer_encode_keyword_deterministic {
    assert encode_keyword("module") == encode_keyword("module");
    assert encode_keyword("nope") == encode_keyword("nope");
    assert encode_keyword("") == encode_keyword("");
}

// forall id : u16, decode_char(id) <= 255; and the clamp rule: id when id < 256, else '?'
test tokenizer_decode_char_bounded {
    var id : u32 = 0;
    while (id < 1024) {
        const d : u32 = decode_char(id) as u32;
        assert d <= 255;
        if (id < 256) {
            assert d == id;
        } else {
            assert d == 63;
        }
        id = id + 1;
    }
}

test tokenizer_encode_char_space {
    assert encode_char(32) == 32;
}

test tokenizer_detokenize_single_space {
    const tokens : [1]u32 = [32];
    assert detok_is(&tokens, " ");
}

test tokenizer_vocab_size_keywords_positive {
    assert vocab_size_keywords() > 0;
}

invariant tokenizer_vocab_size_keywords_positive_inv:
    vocab_size_keywords() > 0

test tokenizer_encode_char_255 {
