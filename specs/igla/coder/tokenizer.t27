test tokenizer_tokenize_verilog_single_keyword {
    var buf : [4]u32 = [0] ** 4;
    assert tokenize_verilog("module", &buf) == 1;
    assert buf[0] == 256;
}

test tokenizer_detokenize_verilog_single_keyword {
    const tokens : [1]u32 = [256];
    assert detok_verilog_is(&tokens, "module");
}

// encode_keyword(kw) > 0 ==> decode_keyword(encode_keyword(kw)) == kw, for
// every keyword id the decoder knows.
test tokenizer_encode_decode_keyword_roundtrip_inv {
    var id : u32 = 256;
    while (id < 320) {
        const kw = decode_keyword(id);
        assert encode_keyword(kw) == id;
        assert same_bytes(decode_keyword(encode_keyword(kw)), kw);
        id = id + 1;
    }
    // and the ids above the table decode to "" (which encode_keyword maps to 0)
    assert decode_keyword(320).len == 0;
    assert decode_keyword(5000).len == 0;
    assert encode_keyword("") == 0;
}

test tokenizer_detokenize_single_keyword_endmodule {
    const tokens : [1]u32 = [257];
    assert detok_is(&tokens, "endmodule");
}

test tokenizer_next_word_empty {
    assert next_word("", 0).len == 0;
}

test tokenizer_next_word_empty_empty_inv {
    // code.len == 0 ==> next_word(code, 0) == ""
    assert next_word("", 0).len == 0;
    assert next_word("abc", 3).len == 0;
}

test tokenizer_encode_decode_roundtrip_endmodule {
    const id = encode_keyword("endmodule");
    assert same_bytes(decode_keyword(id), "endmodule");
}

test tokenizer_next_word_single_space {
    assert same_bytes(next_word("a b", 0), "a");
}

// The old property was: code.len() > 0 && code contains a space ==> next_word
// is non-empty. That is false for code starting with a space (" a"): the word
// at a space is "" by design. The true statement is conditioned on the first
// byte, and is checked on both sides.
test tokenizer_next_word_single_space_inv {
    assert next_word("a b", 0).len > 0;
    assert next_word("ab c", 0).len > 0;
    assert next_word(" a", 0).len == 0;
    assert same_bytes(next_word("a b", 2), "b");
}

test tokenizer_skip_spaces_empty_string {
    assert skip_spaces("", 0) == 0;
}

test tokenizer_skip_spaces_empty_string_inv {
    assert skip_spaces("", 0) == 0;
    assert skip_spaces("   ", 0) == 3;
    assert skip_spaces("  a", 0) == 2;
    assert skip_spaces("a", 0) == 0;
}

// The old tests asserted s[0] == 0 && s.len() == 2 for an empty token list,
// but every other BOS test (tokenize([]).len() == 1 in w294, w299, w302)
// says BOS only. add_special_tokens prepends BOS and nothing else: length 1.
test tokenizer_empty_tokens_bos_only {
    const tokens : [1]u32 = [5];
    assert bos_first(tokens[0..0]) == 0;
    assert bos_len(tokens[0..0]) == 1;
}

test tokenizer_empty_tokens_bos_only_inv {
    const tokens : [1]u32 = [5];
    assert bos_len(tokens[0..0]) == 1;
}

// The old tests used `encode_keyword(code).len() == 1` on a u32 and a
// decode([1]) == "if" from an older vocab where "if" was id 1. In the current
// vocab "if" is 266: one keyword token.
test tokenizer_encode_keyword_single {
    var buf : [4]u32 = [0] ** 4;
    const n = tokenize_verilog("if", &buf);
    assert n == 1;
    assert buf[0] == 266;
}

test tokenizer_decode_single_id_roundtrip {
    const ids : [1]u32 = [266];
