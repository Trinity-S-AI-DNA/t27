// ----------------------------------------------------------------------------
// BOS tests. The old tests called tokenize(tokens) with a token list and
// expected BOS (0) prepended; that function is add_special_tokens (tokenize
// takes text). Each wave group is kept as written, pointed at the real name.
// ----------------------------------------------------------------------------

test tokenizer_empty_tokens_bos_only_w294 {
    const t : [1]u32 = [0];
    assert bos_len(t[0..0]) == 1;
    assert bos_first(t[0..0]) == 0;
}

test tokenizer_single_token_length_one_w294 {
    const t : [1]u32 = [42];
    var buf : [4]u32 = [7] ** 4;
    assert add_special_tokens(&t, &buf) == 2;
    assert buf[0] == 0 and buf[1] == 42;
}

test tokenizer_empty_tokens_bos_only_w294_inv {
    const t : [1]u32 = [0];
    assert bos_len(t[0..0]) == 1;
}

test tokenizer_two_tokens_length_two_w295 {
    const t : [2]u32 = [1, 2];
    var buf : [4]u32 = [7] ** 4;
    assert add_special_tokens(&t, &buf) == 3;
    assert buf[0] == 0 and buf[1] == 1 and buf[2] == 2;
}

test tokenizer_single_token_appended_w295 {
    const t : [1]u32 = [100];
    assert bos_len(&t) == 2;
}

test tokenizer_two_tokens_length_two_w295_inv {
    const t : [2]u32 = [1, 2];
    assert bos_len(&t) == 3;
}

test tokenizer_three_tokens_length_three_w296 {
    const t : [3]u32 = [1, 2, 3];
    assert bos_len(&t) == 4;
}

test tokenizer_zero_token_bos_only_w296 {
    const t : [1]u32 = [0];
    var buf : [4]u32 = [7] ** 4;
    assert add_special_tokens(&t, &buf) == 2;
    assert buf[0] == 0 and buf[1] == 0;
}

test tokenizer_three_tokens_length_three_w296_inv {
    const t : [3]u32 = [1, 2, 3];
    assert bos_len(&t) == 4;
}

test tokenizer_four_tokens_length_four_w297 {
    const t : [4]u32 = [1, 2, 3, 4];
    assert bos_len(&t) == 5;
}

test tokenizer_negative_token_preserved_w297 {
    const t : [2]u32 = [0, 42];
    var buf : [4]u32 = [7] ** 4;
    assert add_special_tokens(&t, &buf) == 3;
    assert buf[0] == 0 and buf[1] == 0 and buf[2] == 42;
}

test tokenizer_four_tokens_length_four_w297_inv {
    const t : [4]u32 = [1, 2, 3, 4];
    assert bos_len(&t) == 5;
}

test tokenizer_five_tokens_length_five_w298 {
    const t : [5]u32 = [1, 2, 3, 4, 5];
    assert bos_len(&t) == 6;
}

test tokenizer_mixed_tokens_preserved_w298 {
    const t : [3]u32 = [5, 10, 15];
    var buf : [8]u32 = [7] ** 8;
    assert add_special_tokens(&t, &buf) == 4;
    assert buf[0] == 0 and buf[1] == 5 and buf[2] == 10 and buf[3] == 15;
}

test tokenizer_five_tokens_length_five_w298_inv {
    const t : [5]u32 = [1, 2, 3, 4, 5];
