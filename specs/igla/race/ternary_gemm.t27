test ternary_gemm_2x2_single_plus_weight
    given a = [3, 0, 0, 0]
    given w = [TernaryWeight { code: 1 }, TernaryWeight { code: 0 }, TernaryWeight { code: 0 }, TernaryWeight { code: 0 }]
    when out = ternary_gemm_2x2(a, w)
    then out[0] == 3

test ternary_gemm_2x2_single_minus_weight
    given a = [5, 0, 0, 0]
    given w = [TernaryWeight { code: 2 }, TernaryWeight { code: 0 }, TernaryWeight { code: 0 }, TernaryWeight { code: 0 }]
    when out = ternary_gemm_2x2(a, w)
    then out[0] == -5

invariant ternary_gemm_2x2_single_plus_weight_inv:
    forall a : i8
    ternary_gemm_2x2([a, 0, 0, 0], [TernaryWeight { code: 1 }, TernaryWeight { code: 0 }, TernaryWeight { code: 0 }, TernaryWeight { code: 0 }])[0] == cast_i16(a)

test ternary_gemm_2x2_single_element_minus_weight_row0col1
