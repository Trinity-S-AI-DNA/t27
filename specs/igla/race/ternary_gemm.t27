invariant ternary_gemm_2x2_zero_activations_zero_output_inv:
    forall w : []TernaryWeight
    len(w) == 4 ==>
    let a = [0, 0, 0, 0]
    let out = ternary_gemm_2x2(a, w)
    out[0] == 0 && out[1] == 0 && out[2] == 0 && out[3] == 0

test ternary_gemm_2x2_single_plus_weight_broadcast
