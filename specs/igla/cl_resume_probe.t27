// SPDX-License-Identifier: Apache-2.0
; specs/igla/cl_resume_probe.t27 -- the resume-branch probe (CL spike, step 3): the REAL published
; checkpoint state (playra/hslm-t27-2m, ckpt_8000.state) must decode per the T27S law that
; ml/train_hslm.t27's resume path implements. The 64-byte header is embedded as 16 little-endian
; u32 words exactly as they sit in the downloaded file; the test decodes the law's fields:
; magic "T27S", version 1, step 8000, nparam 2130138 (= the model card's 2,130,138 f64),
; rng words, beta1^t / beta2^t / loss as f64 word pairs, 30 segments.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module IglaClResumeProbe;

pub const T27S_MAGIC_LO : u32 = 0x53373254; // "T27S" little-endian
pub const T27S_MAGIC_HI : u32 = 0;
pub const HDR_VERSION : u32 = 1;
pub const HDR_STEP : u32 = 8000;
pub const HDR_NPARAM : u32 = 2130138;
pub const HDR_NSEG : u32 = 30;
pub const RNG_WORD0 : u32 = 3282519414;
pub const RNG_WORD1 : u32 = 2435930503;
pub const BETA1T_LO : u32 = 2118266993;
pub const BETA1T_HI : u32 = 1060496805;
pub const BETA2T_LO : u32 = 576327125;
pub const BETA2T_HI : u32 = 1074380811;
pub const LOSS_LO : u32 = 0;
pub const LOSS_HI : u32 = 0;

pub fn header_word(words0: u32, words1: u32, words2: u32, words3: u32, idx: u32) -> u32 {
    if (idx == 0) { return words0; }
    if (idx == 1) { return words1; }
    if (idx == 2) { return words2; }
    if (idx == 3) { return words3; }
    return 0;
}

test the_published_8000_step_state_decodes_per_the_resume_law {
    assert header_word(T27S_MAGIC_LO, 1, 8000, 2130138, 0) == T27S_MAGIC_LO;
    assert header_word(T27S_MAGIC_LO, 1, 8000, 2130138, 1) == HDR_VERSION;
    assert header_word(T27S_MAGIC_LO, 1, 8000, 2130138, 2) == HDR_STEP;
    assert header_word(T27S_MAGIC_LO, 1, 8000, 2130138, 3) == HDR_NPARAM;
    assert header_word(RNG_WORD0, RNG_WORD1, 5, 0, 0) == RNG_WORD0;
    assert header_word(RNG_WORD0, RNG_WORD1, 5, 0, 1) == RNG_WORD1;
    assert header_word(RNG_WORD0, RNG_WORD1, 5, 0, 2) == 5; // parallel rung marker in the published run
    assert header_word(RNG_WORD0, RNG_WORD1, 5, 0, 3) == 0;
    assert header_word(BETA1T_LO, BETA1T_HI, BETA2T_LO, BETA2T_HI, 0) == BETA1T_LO;
    assert header_word(BETA1T_LO, BETA1T_HI, BETA2T_LO, BETA2T_HI, 1) == BETA1T_HI;
    assert header_word(BETA1T_LO, BETA1T_HI, BETA2T_LO, BETA2T_HI, 2) == BETA2T_LO;
    assert header_word(BETA1T_LO, BETA1T_HI, BETA2T_LO, BETA2T_HI, 3) == BETA2T_HI;
    assert header_word(LOSS_LO, LOSS_HI, HDR_NSEG, 0, 2) == HDR_NSEG;
    assert replay_resume_ready(HDR_STEP, HDR_NPARAM, HDR_NSEG);
    assert !replay_resume_ready(HDR_STEP, HDR_NPARAM, HDR_NSEG - 1);
    assert !replay_resume_ready(HDR_STEP - 1, HDR_NPARAM, HDR_NSEG);
}

pub fn replay_resume_ready(step: u32, nparam: u32, nseg: u32) -> bool {
    if (step != HDR_STEP) { return false; }
    if (nparam != HDR_NPARAM) { return false; }
    return nseg == HDR_NSEG;
}
