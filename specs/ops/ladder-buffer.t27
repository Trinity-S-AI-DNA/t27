// SPDX-License-Identifier: Apache-2.0
// specs/ops/ladder-buffer.t27 — T27 Ladder buffering proxy contract
// Trinity S³AI — Operational spec for `ladder-buffer` on 127.0.0.1:3133
// φ² + 1/φ² = 3 | TRINITY

// Root cause (2026-11-26): ladder-native is a single-worker server.
// While one model call is in flight it stops calling accept().
// Slow rungs (nvidia 79–139 s, zai 429 flaps + 8–36 s successes) fill the
// kernel accept queue, and every new client — including /health — gets
// `connect ETIMEDOUT 127.0.0.1:3131`. A restart does not fix it: the problem
// is structural, not a hang.

// Contract: ladder-buffer sits in front of ladder-native (:3131) on :3133.
// Clients connect here; exactly one request at a time goes upstream.
// Everything else queues in memory where nothing times out.

module LadderBuffer {

    // ------------------------------------------------------------------------
    // LISTEN ADDRESS (loopback only, never exposed beyond 127.0.0.1)
    // ------------------------------------------------------------------------

    /// Proxy listen host. Loopback only.
    const LISTEN_HOST : &str = "127.0.0.1"

    /// Proxy listen port. Clients connect here instead of :3131.
    const LISTEN_PORT : u16 = 3133

    /// Upstream host (ladder-native). Loopback only.
    const UPSTREAM_HOST : &str = "127.0.0.1"

    /// Upstream port (ladder-native single worker).
    const UPSTREAM_PORT : u16 = 3131

    // ------------------------------------------------------------------------
    // UPSTREAM BEHAVIOR
    // ------------------------------------------------------------------------

    /// Maximum time to wait for the ladder to answer a model call.
    /// A slow rung becomes a slow answer, not a client-side ETIMEDOUT.
    const UPSTREAM_TIMEOUT_MS : u64 = 300000

    /// The proxy keeps exactly one upstream socket (keepAlive, maxSockets=1).
    /// This matches what the single-worker ladder can actually do.
    const UPSTREAM_MAX_SOCKETS : u16 = 1

    /// Number of connection-level retries before returning 502/504 to the client.
    /// Retried only on connection-level failure (ECONNREFUSED, ECONNRESET,
    /// EPIPE, ETIMEDOUT). Never retried on a model-level error the ladder
    /// itself returned.
    const CONNECTION_RETRY_MAX : u8 = 1

    // ------------------------------------------------------------------------
    // /HEALTH
    // ------------------------------------------------------------------------

    /// /health answers immediately and never blocks on a model call or queue
    /// depth. It reports queueDepth and inFlight separately, non-blocking.
    const HEALTH_INSTANT_MS : u64 = 5

    // ------------------------------------------------------------------------
    // QUEUE
    // ------------------------------------------------------------------------

    /// Requests that cannot go upstream right now wait here, in memory.
    /// No client-side timeout applies while queued.
    /// TODO: add cap + alerting (see issue for next agent).
    const QUEUE_CAP : u64 = 0 // 0 = unbounded for now; set before production

    // ------------------------------------------------------------------------
    // ROUTING (DSH provider overlay points here)
    // ------------------------------------------------------------------------

    /// DSH provider overlay rewrites t27-ladder / auto baseURL from :3131
    /// to :3133. Direct nvidia / zai routes are unchanged.
    const DSH_PROVIDER_OVERLAY : &str = "t27-godmode.patch.yml"

    // ------------------------------------------------------------------------
    // INVARIANTS
    // ------------------------------------------------------------------------

    invariant listen_is_loopback:
        LISTEN_HOST == "127.0.0.1"

    invariant upstream_is_loopback:
        UPSTREAM_HOST == "127.0.0.1"

    invariant upstream_one_socket:
        UPSTREAM_MAX_SOCKETS == 1

    invariant retry_only_connection_level:
        CONNECTION_RETRY_MAX <= 3

    // ------------------------------------------------------------------------
    // TEST
    // ------------------------------------------------------------------------

    test health_answers_instantly:
        // /health must return within HEALTH_INSTANT_MS even when the ladder
        // is busy with a slow model call. Verified by curl --max-time 5.
        assert HEALTH_INSTANT_MS <= 5

    test upstream_single_socket:
        // The ladder has one worker; the proxy must not open a pool.
        assert UPSTREAM_MAX_SOCKETS == 1

    test loopback_only:
        // Neither side may be exposed beyond 127.0.0.1.
        assert LISTEN_HOST == "127.0.0.1"
        assert UPSTREAM_HOST == "127.0.0.1"

}
