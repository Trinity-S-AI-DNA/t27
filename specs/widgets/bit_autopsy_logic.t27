// SPDX-License-Identifier: Apache-2.0
; specs/widgets/bit_autopsy_logic.t27 -- one Xilinx 7-series bitstream taken apart, as pure rules over
; bytes: the JavaScript file apps/website/public/widgets/bit-autopsy/autopsy.js (289 lines, gHashTag/trinity)
; ported to .t27. Epic gHashTag/t27#10937, issue #10938. Owner rule (Only t27): the logic is written in
; .t27, never by hand in JavaScript. The page reads a dropped or picked file in the reader's browser and
; sends nothing anywhere; these rules keep that: they see only the bytes the glue hands over, fill buffers
; the glue hands over, read no file and hold no state between calls.
; --
; Table: every export of autopsy.js and the function(s) that replace it.
;   SYNC_WORD FRAME_WORDS ECC_WORD ECC_MASK IDCODE_MASK PAD_FRAMES_PER_ROW   the constants of the same names
;   REG_NAMES, CMD_NAMES    the tables of the same names (UG470 tables 5-23 and 5-25); "" where the JavaScript
;                           has no entry; cmd_name_known(v) says whether CMD_NAMES[v] exists
;   hex8(v)                 hex8: "0x" and eight lower-case hex digits into out, 10 bytes
;   parseHeader(u8)         parse_header: fills hd, see "header layout"
;   findSync(u8,from,limit) find_sync: the offset or -1
;   dieOf(s)                die_of: the lower-cased "xc7" letters digits prefix into out; its length, -1 for null
;   lookupIdcode(code,parts) lookup_idcode: the index of the entry, -1 for null; parts are the low 32 bits of
;                           each entry's Number(p[0]), which the glue computes
;   frameSlots(geom)        frame_slots: the FARs, NONE (4294967295) for a pad slot
;   walkPackets(u8,sync)    walk_packets: fills wp, fdri, cmds, see "packet layout"
;   autopsy(u8,{geoms,parts,buckets})   autopsy: fills res, lists, cells, strs, see "autopsy layout"
; Not ported: nothing of autopsy.js is left out. The private helpers be32, popcount, encodeFar and shade are
; be32, popcount, encode_far and shade_char here.
; --
; Domain. A bitstream is bytes. Geometry values stay in the ranges the FAR holds (block < 8, bottom < 2,
; row < 32, columns < 1024, minors < 128, 4 or 5 blocks at most are drawn); buckets is at least 1 (status 5
; otherwise); a file shorter than 4 GiB. JavaScript's Number(p[0]) of the parts table is the glue's.
; --
; header layout (hd u64 x 12): [0] 1 when the header parsed, [1 .. 8] design offset, length, part offset,
;   length, date offset, length, time offset, length (offsets in u8; length is the text up to the first NUL),
;   [9] the length field, [10] dataStart.
; packet layout (walk_packets(u, sync, wp, fdri, cmds) -> status 0 ok, 1 fdri or cmds full):
;   wp u64 x 24: [0] idcode present (0 when the last IDCODE write had no data), [1] idcode, [2] end, [3] desync,
;   [4 .. 14] the counts type1 type2 nop pad writes reads cmd crc far fdri other, [15] refuse count, [16 17]
;   refuse codes (1 encrypted, 2 compressed; in order of first occurrence, each once), [18] warning count,
;   [19 20] warning codes (1 truncated, 2 badheader), [21] fdri entries, [22] command values.
;   fdri u32 x 4 per entry: offset of the first data byte, words, far present, far.
;   cmds u32: the CMD value of every CMD write that had data, in order.
; autopsy layout (autopsy(u, geoms, parts, models, buckets, res, lists, cells, strs, fdri, cmds, nz, fars,
;   slots, hitall) -> status 0 | 1 | 3 | 5):
;   geoms  u32: [count], then per geometry: idcode, rows, then per row: block, bottom, row, columns, and
;          the column frame counts.
;   parts  u32 idcodes, models the model texts one per line ("xc7a100\n..."), same order.
;   res    u64 x 64: [0] bytes, [1] kind (1 bit, 0 bin), [2] header present, [3 .. 10] design, part, date, time
;          (offset, length in u), [11] header length field, [12] headerLengthOk (0 false, 1 true, 2 null),
;          [13] sync (u64 max for -1), [14] idcode present, [15] idcode, [16] idcodeVersion, [17] device index
;          (u64 max for null), [18 19] headerDie (offset, length in strs; length u64 max for null), [20 21]
;          idDie, [22] agree (0 false, 1 true, 2 null), [23] zeroBytes, [24] refuse count, [25 26] refuse
;          codes (1 encrypted, 2 compressed, 3 nosync), [27] warning count, [28 .. 30] warning codes (1 truncated,
;          2 badheader, 3 partialframe), [31 .. 41] packet counts (as in wp [4 .. 14]), [42] packets present,
;          [43] commands, [44] frameWords, [45] frameSlots, [46] padFrames, [47] configFrames, [48] nonzeroFrames,
;          [49] ones, [50] mapped, [51] geometry index (u64 max for null), [52 .. 57] blocks 0 1 2 frames and
;          nonzero, [58] strip entries.
;   lists  u32: the commands (res[43] values), then per strip entry block, bottom, row (4294967295 for null).
;   cells  u8: per strip entry `buckets` characters of the strip.
;   strs   u8: the two die texts. fdri u32 x 4 per FDRI write; cmds u32; nz u8, fars u32: per frame slot; slots u32:
;          per slot of the geometry; hitall u32: 2 * buckets per geometry row (a one-row strip when unmapped).
;   status 0 ok, 1 a buffer is too small, 3 nz/fars too small, 5 buckets is 0.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_bit_autopsy_logic;

pub const SYNC_WORD : u32 = 2862274918;
pub const FRAME_WORDS : u32 = 101;
pub const ECC_WORD : u32 = 50;
pub const ECC_MASK : u32 = 8191;
pub const IDCODE_MASK : u32 = 268435455;
pub const PAD_FRAMES_PER_ROW : u32 = 2;

pub const NONE : u32 = 4294967295;
pub const NONE64 : u64 = 18446744073709551615;

pub const REG_CRC : u32 = 0;
pub const REG_FAR : u32 = 1;
pub const REG_FDRI : u32 = 2;
pub const REG_CMD : u32 = 4;
pub const REG_CTL0 : u32 = 5;
pub const REG_MFWR : u32 = 10;
pub const REG_CBC : u32 = 11;
pub const REG_IDCODE : u32 = 12;
pub const CMD_DESYNC : u32 = 13;
pub const CTL0_DEC : u32 = 64;

pub const REG_NAMES : [32]str = ["CRC", "FAR", "FDRI", "FDRO", "CMD", "CTL0", "MASK", "STAT", "LOUT", "COR0", "MFWR", "CBC", "IDCODE", "AXSS", "COR1", "", "WBSTAR", "TIMER", "", "RBCRC_SW", "", "", "BOOTSTS", "", "CTL1", "", "", "", "", "", "", "BSPI"];
pub const CMD_NAMES : [20]str = ["NULL", "WCFG", "MFW", "LFRM", "RCFG", "START", "RCAP", "RCRC", "AGHIGH", "SWITCH", "GRESTORE", "SHUTDOWN", "GCAPTURE", "DESYNC", "", "IPROG", "CRCC", "LTIMER", "BSPI_READ", "FALL_EDGE"];

/// Does CMD_NAMES have an entry for this CMD value?
pub fn cmd_name_known(v: u32) -> bool {
    return v < 20 and v != 14;
}

// ------------------------------------------------------------------------------------------------
// small pure functions
// ------------------------------------------------------------------------------------------------

pub fn be32(u: []const u8, o: usize) -> u32 {
    return ((u[o] as u32) << 24) | ((u[o + 1] as u32) << 16) | ((u[o + 2] as u32) << 8) | (u[o + 3] as u32);
}

pub fn popcount(x: u32) -> u32 {
    var v : u32 = x - ((x >> 1) & 1431655765);
    v = (v & 858993459) + ((v >> 2) & 858993459);
    const w : u32 = (v + (v >> 4)) & 252645135;
    return ((((w as u64) * 16843009) >> 24) & 255) as u32;
}

pub fn encode_far(block: u32, bottom: u32, row: u32, column: u32, minor: u32) -> u32 {
    return ((block & 7) << 23) | ((bottom & 1) << 22) | ((row & 31) << 17) | ((column & 1023) << 7) | (minor & 127);
}

/// "0x" and eight lower-case hex digits of v into out[0 .. 10]; returns 10.
pub fn hex8(v: u32, out: []u8) -> usize {
    out[0] = 48;
    out[1] = 120;
    var i : usize = 0;
    while (i < 8) {
        const d : u32 = (v >> ((28 - 4 * (i as u32)) as u32)) & 15;
        if (d < 10) { out[2 + i] = (48 + d) as u8; } else { out[2 + i] = (87 + d) as u8; }
        i = i + 1;
    }
    return 10;
}

/// One character of the strip: '-' no frame there, '0' none non-zero, '1' to '9' the share of non-zero frames.
pub fn shade_char(hit: u32, all: u32) -> u8 {
    if (all == 0) { return 45; }
    if (hit == 0) { return 48; }
    var d : f64 = @ceil(((hit as f64) / (all as f64)) * 9.0);
    if (d < 1.0) { d = 1.0; }
    return (48 + (d as u32)) as u8;
}

/// The offset of the sync word at or after `from`, searching `limit` bytes, or -1.
pub fn find_sync(u: []const u8, from: usize, limit: usize) -> i64 {
    var end : usize = 0;
    if (u.len >= 3) { end = u.len - 3; }
    if (from + limit < end) { end = from + limit; }
    var i : usize = from;
    while (i < end) {
        if (u[i] == 170 and u[i + 1] == 153 and u[i + 2] == 85 and u[i + 3] == 102) { return i as i64; }
        i = i + 1;
    }
    return -1;
}

/// The text of a header field: from start, at most len bytes, stopping at a NUL or the end.
pub fn field_len(u: []const u8, start: usize, len: usize) -> usize {
    var i : usize = start;
    while (i < start + len and i < u.len and u[i] != 0) { i = i + 1; }
    if (i < start) { return 0; }
    return i - start;
}

/// parseHeader: the .bit header; see "header layout". Returns whether it parsed.
pub fn parse_header(u: []const u8, hd: []u64) -> bool {
    var k : usize = 0;
    while (k < 12) {
        hd[k] = 0;
        k = k + 1;
    }
    if (u.len < 13) { return false; }
    if (u[0] != 0 or u[1] != 9 or u[2] != 15 or u[3] != 240 or u[4] != 15 or u[5] != 240 or u[6] != 15 or u[7] != 240 or u[8] != 15 or u[9] != 240 or u[10] != 0 or u[11] != 0 or u[12] != 1) { return false; }
    var o : usize = 13;
    // design, part, date, time: offset and length of the last field of each kind, empty by default
    var fo : [4]usize = [0; 4];
    var fl : [4]usize = [0; 4];
    while (o + 3 <= u.len and o < 4096) {
        const key : u8 = u[o];
        if (key == 101) {
            if (o + 5 > u.len) { return false; }
            hd[0] = 1;
            var q : usize = 0;
            while (q < 4) {
                hd[1 + 2 * q] = fo[q] as u64;
                hd[2 + 2 * q] = fl[q] as u64;
                q = q + 1;
            }
            hd[9] = be32(u, o + 1) as u64;
            hd[10] = (o + 5) as u64;
            return true;
        }
        if (key < 97 or key > 100) { return false; }
        const len : usize = ((u[o + 1] as usize) << 8) | (u[o + 2] as usize);
        const slot : usize = (key - 97) as usize;
        fo[slot] = o + 3;
        fl[slot] = field_len(u, o + 3, len);
        o = o + 3 + len;
    }
    return false;
}

/// dieOf: the lower-cased "xc7", letters, digits prefix of s into out; its length, or -1.
pub fn die_of(s: []const u8, out: []u8) -> i64 {
    if (s.len < 5) { return -1; }
    if ((s[0] | 32) != 120 or (s[1] | 32) != 99 or s[2] != 55) { return -1; }
    var i : usize = 3;
    while (i < s.len and ((s[i] >= 97 and s[i] <= 122) or (s[i] >= 65 and s[i] <= 90))) { i = i + 1; }
    if (i == 3) { return -1; }
    const d : usize = i;
    while (i < s.len and s[i] >= 48 and s[i] <= 57) { i = i + 1; }
    if (i == d) { return -1; }
    var k : usize = 0;
    while (k < i) {
        var c : u8 = s[k];
        if (c >= 65 and c <= 90) { c = c + 32; }
        if (k < out.len) { out[k] = c; }
        k = k + 1;
    }
    return i as i64;
}

/// lookupIdcode: the index of the first entry whose idcode equals `code` once the version nibble is masked
/// on both sides, or -1.
pub fn lookup_idcode(code: u32, parts: []const u32) -> i64 {
    const key : u32 = code & IDCODE_MASK;
    var i : usize = 0;
    while (i < parts.len) {
        if ((parts[i] & IDCODE_MASK) == key) { return i as i64; }
        i = i + 1;
    }
    return -1;
}

/// Slots of geometry g (its offset in `geoms` after the count): rows * (columns' frames + PAD) entries.
pub fn geom_slot_count(geoms: []const u32, at: usize) -> usize {
    var p : usize = at + 2;
    const nrows : usize = geoms[at + 1] as usize;
    var total : usize = 0;
    var r : usize = 0;
    while (r < nrows) {
        const ncols : usize = geoms[p + 3] as usize;
        var c : usize = 0;
        while (c < ncols) {
            total = total + (geoms[p + 4 + c] as usize);
            c = c + 1;
        }
        total = total + (PAD_FRAMES_PER_ROW as usize);
        p = p + 4 + ncols;
        r = r + 1;
    }
    return total;
}

/// frameSlots of the geometry at `at`: the FAR of every frame slot in FDRI order, NONE for the pad slots.
/// Returns how many; out must hold geom_slot_count entries.
pub fn frame_slots(geoms: []const u32, at: usize, out: []u32) -> usize {
    var p : usize = at + 2;
    const nrows : usize = geoms[at + 1] as usize;
    var n : usize = 0;
    var r : usize = 0;
    while (r < nrows) {
        const block : u32 = geoms[p];
        const bottom : u32 = geoms[p + 1];
        const row : u32 = geoms[p + 2];
        const ncols : usize = geoms[p + 3] as usize;
        var c : usize = 0;
        while (c < ncols) {
            const frames : u32 = geoms[p + 4 + c];
            var mi : u32 = 0;
            while (mi < frames) {
                if (n < out.len) { out[n] = encode_far(block, bottom, row, c as u32, mi); }
                n = n + 1;
                mi = mi + 1;
            }
            c = c + 1;
        }
        var k : u32 = 0;
        while (k < PAD_FRAMES_PER_ROW) {
            if (n < out.len) { out[n] = NONE; }
            n = n + 1;
            k = k + 1;
        }
        p = p + 4 + ncols;
        r = r + 1;
    }
    return n;
}

// ------------------------------------------------------------------------------------------------
// walkPackets
// ------------------------------------------------------------------------------------------------

pub fn add_refuse(wp: []u64, code: u64) {
    var i : usize = 0;
    while (i < (wp[15] as usize)) {
        if (wp[16 + i] == code) { return; }
        i = i + 1;
    }
    if (wp[15] < 2) {
        wp[16 + (wp[15] as usize)] = code;
        wp[15] = wp[15] + 1;
    }
}

pub fn add_warning(wp: []u64, code: u64) {
    var i : usize = 0;
    while (i < (wp[18] as usize)) {
        if (wp[19 + i] == code) { return; }
        i = i + 1;
    }
    if (wp[18] < 2) {
        wp[19 + (wp[18] as usize)] = code;
        wp[18] = wp[18] + 1;
    }
}

pub fn push_fdri(fdri: []u32, wp: []u64, off: usize, words: usize, far_present: bool, far: u32) {
    const k : usize = wp[21] as usize;
    if ((k + 1) * 4 <= fdri.len) {
        fdri[k * 4] = off as u32;
        fdri[k * 4 + 1] = words as u32;
        if (far_present) { fdri[k * 4 + 2] = 1; } else { fdri[k * 4 + 2] = 0; }
        fdri[k * 4 + 3] = far;
    } else {
        wp[23] = 1;
    }
    wp[21] = (k + 1) as u64;
}

/// walkPackets: see "packet layout". Returns 0, or 1 when fdri or cmds was too small.
pub fn walk_packets(u: []const u8, sync: usize, wp: []u64, fdri: []u32, cmds: []u32) -> u32 {
    var z : usize = 0;
    while (z < 24) {
        wp[z] = 0;
        z = z + 1;
    }
    var o : usize = sync + 4;
    var far_present : bool = false;
    var far : u32 = 0;
    var last_reg : u32 = NONE;
    const n : usize = u.len;
    var go : bool = true;
    while (o + 4 <= n and go) {
        const w : u32 = be32(u, o);
        const typ : u32 = w >> 29;
        if (typ == 1) {
            const op : u32 = (w >> 27) & 3;
            const reg : u32 = (w >> 13) & 16383;
            const count : usize = (w & 2047) as usize;
            if (op == 0) {
                wp[6] = wp[6] + 1;
                o = o + 4;
                continue;
            }
            wp[4] = wp[4] + 1;
            if ((o as u64) + 4 + (count as u64) * 4 > (n as u64)) {
                add_warning(wp, 1);
                o = n;
                go = false;
                continue;
            }
            if (op == 1) { wp[9] = wp[9] + 1; }
            var advanced : bool = false;
            if (op == 2) {
                wp[8] = wp[8] + 1;
                var has_v : bool = count > 0;
                var v : u32 = 0;
                if (has_v) { v = be32(u, o + 4); }
                if (reg == REG_CMD) {
                    wp[10] = wp[10] + 1;
                    if (has_v) {
                        const k : usize = wp[22] as usize;
                        if (k < cmds.len) { cmds[k] = v; } else { wp[23] = 1; }
                        wp[22] = (k + 1) as u64;
                    }
                } else {
                    if (reg == REG_CRC) {
                        wp[11] = wp[11] + 1;
                    } else {
                        if (reg == REG_FAR) {
                            wp[12] = wp[12] + 1;
                            far_present = has_v;
                            far = v;
                        } else {
                            if (reg == REG_IDCODE) {
                                if (has_v) { wp[0] = 1; wp[1] = v as u64; } else { wp[0] = 0; wp[1] = 0; }
                            } else {
                                if (reg == REG_CBC) {
                                    add_refuse(wp, 1);
                                } else {
                                    if (reg == REG_CTL0 and has_v and (v & CTL0_DEC) != 0) {
                                        add_refuse(wp, 1);
                                    } else {
                                        if (reg == REG_MFWR) { add_refuse(wp, 2); }
                                    }
                                }
                            }
                        }
                    }
                }
                if (reg == REG_FDRI) {
                    wp[13] = wp[13] + 1;
                    if (count > 0) { push_fdri(fdri, wp, o + 4, count, far_present, far); }
                }
                if (reg == REG_CMD and has_v and v == CMD_DESYNC) {
                    o = o + 4 + count * 4;
                    wp[3] = 1;
                    advanced = true;
                    go = false;
                }
            }
            if (!advanced) {
                last_reg = reg;
                o = o + 4 + count * 4;
            }
        } else {
            if (typ == 2) {
                const op : u32 = (w >> 27) & 3;
                const count : usize = (w & 134217727) as usize;
                wp[5] = wp[5] + 1;
                if ((o as u64) + 4 + (count as u64) * 4 > (n as u64)) {
                    add_warning(wp, 1);
                    o = n;
                    go = false;
                    continue;
                }
                if (op == 2) {
                    wp[8] = wp[8] + 1;
                    if (last_reg == REG_FDRI) {
                        wp[13] = wp[13] + 1;
                        push_fdri(fdri, wp, o + 4, count, far_present, far);
                    }
                }
                o = o + 4 + count * 4;
            } else {
                if (w == 4294967295 or w == 0) {
                    wp[7] = wp[7] + 1;
                    o = o + 4;
                } else {
                    wp[14] = wp[14] + 1;
                    add_warning(wp, 2);
                    o = o + 4;
                }
            }
        }
    }
    wp[2] = o as u64;
    if (wp[23] != 0) { return 1; }
    return 0;
}

// ------------------------------------------------------------------------------------------------
// the autopsy
// ------------------------------------------------------------------------------------------------

/// The offset in `geoms` of the geometry whose idcode matches `code` (version nibble masked), or -1.
pub fn find_geom(geoms: []const u32, code: u32) -> i64 {
    const count : usize = geoms[0] as usize;
    var at : usize = 1;
    var g : usize = 0;
    while (g < count) {
        if ((geoms[at] & IDCODE_MASK) == (code & IDCODE_MASK)) { return at as i64; }
        const nrows : usize = geoms[at + 1] as usize;
        var p : usize = at + 2;
        var r : usize = 0;
        while (r < nrows) {
            p = p + 4 + (geoms[p + 3] as usize);
            r = r + 1;
        }
        at = p;
        g = g + 1;
    }
    return -1;
}

pub fn geom_index_of(geoms: []const u32, at: usize) -> usize {
    const count : usize = geoms[0] as usize;
    var a : usize = 1;
    var g : usize = 0;
    while (g < count) {
        if (a == at) { return g; }
        const nrows : usize = geoms[a + 1] as usize;
        var p : usize = a + 2;
        var r : usize = 0;
        while (r < nrows) {
            p = p + 4 + (geoms[p + 3] as usize);
            r = r + 1;
        }
        a = p;
        g = g + 1;
    }
    return 0;
}

/// The k-th line of a newline-separated text, as (start, end).
pub fn nth_line(t: []const u8, k: usize) -> i64 {
    var line : usize = 0;
    var start : usize = 0;
    var i : usize = 0;
    while (i <= t.len) {
        if (i == t.len or t[i] == 10) {
            if (line == k) { return ((start as i64) * 4294967296) + (i as i64); }
            line = line + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return ((t.len as i64) * 4294967296) + (t.len as i64);
}

/// autopsy: see "autopsy layout" in the header.
pub fn autopsy(u: []const u8, geoms: []const u32, parts: []const u32, models: []const u8, buckets: usize, res: []u64, lists: []u32, cells: []u8, strs: []u8, fdri: []u32, cmds: []u32, nz: []u8, fars: []u32, slots: []u32, hitall: []u32) -> u32 {
    var z : usize = 0;
    while (z < 64) {
        res[z] = 0;
        z = z + 1;
    }
    res[13] = NONE64;
    res[17] = NONE64;
    res[19] = NONE64;
    res[21] = NONE64;
    res[22] = 2;
    res[12] = 2;
    res[51] = NONE64;
    if (buckets == 0) { return 5; }
    res[0] = u.len as u64;
    var zeros : u64 = 0;
    var i : usize = 0;
    while (i < u.len) {
        if (u[i] == 0) { zeros = zeros + 1; }
        i = i + 1;
    }
    res[23] = zeros;
    var hd : [12]u64 = [0; 12];
    var from : usize = 0;
    var header_die_len : i64 = -1;
    var strs_used : usize = 0;
    if (parse_header(u, hd[0 .. 12])) {
        res[1] = 1;
        res[2] = 1;
        z = 0;
        while (z < 8) {
            res[3 + z] = hd[1 + z];
            z = z + 1;
        }
        res[11] = hd[9];
        if (hd[9] == ((u.len as u64) - hd[10])) { res[12] = 1; } else { res[12] = 0; }
        const po : usize = hd[3] as usize;
        const pl : usize = hd[4] as usize;
        header_die_len = die_of(u[po .. po + pl], strs[0 .. strs.len]);
        if (header_die_len > (strs.len as i64)) { return 1; }
        if (header_die_len >= 0) {
            res[18] = 0;
            res[19] = header_die_len as u64;
            strs_used = header_die_len as usize;
        }
        from = hd[10] as usize;
    }
    const sy : i64 = find_sync(u, from, 1048576);
    if (sy < 0) {
        res[24] = 1;
        res[25] = 3;
        return 0;
    }
    res[13] = sy as u64;
    var wp : [24]u64 = [0; 24];
    const wst : u32 = walk_packets(u, sy as usize, wp[0 .. 24], fdri, cmds);
    if (wst != 0) { return 1; }
    res[42] = 1;
    z = 0;
    while (z < 11) {
        res[31 + z] = wp[4 + z];
        z = z + 1;
    }
    res[43] = wp[22];
    z = 0;
    while (z < (wp[22] as usize)) {
        if (z < lists.len) { lists[z] = cmds[z]; } else { return 1; }
        z = z + 1;
    }
    res[27] = wp[18];
    res[28] = wp[19];
    res[29] = wp[20];
    res[24] = wp[15];
    res[25] = wp[16];
    res[26] = wp[17];
    var have_id : bool = wp[0] == 1;
    var idc : u32 = 0;
    if (have_id) {
        idc = wp[1] as u32;
        res[14] = 1;
        res[15] = wp[1];
        res[16] = (idc >> 28) as u64;
        const di : i64 = lookup_idcode(idc, parts);
        if (di >= 0) {
            res[17] = di as u64;
            const ln : i64 = nth_line(models, di as usize);
            const ms : usize = (ln / 4294967296) as usize;
            const me : usize = (ln % 4294967296) as usize;
            const idl : i64 = die_of(models[ms .. me], strs[strs_used .. strs.len]);
            if (idl > ((strs.len - strs_used) as i64)) { return 1; }
            if (idl >= 0) {
                res[20] = strs_used as u64;
                res[21] = idl as u64;
                strs_used = strs_used + (idl as usize);
            }
        }
        if (res[21] != NONE64 and res[19] != NONE64) {
            // agree: the two lower-cased dies are the same text
            res[22] = 0;
            if (res[21] == res[19]) {
                var same : bool = true;
                var q : usize = 0;
                while (q < (res[19] as usize)) {
                    if (strs[(res[18] as usize) + q] != strs[(res[20] as usize) + q]) { same = false; }
                    q = q + 1;
                }
                if (same) { res[22] = 1; }
            }
        }
    }
    if (wp[15] > 0) { return 0; }

    // the frames
    var frame_words : u64 = 0;
    z = 0;
    while (z < (wp[21] as usize)) {
        frame_words = frame_words + (fdri[z * 4 + 1] as u64);
        z = z + 1;
    }
    res[44] = frame_words;
    const frame_slots_n : usize = (frame_words / (FRAME_WORDS as u64)) as usize;
    res[45] = frame_slots_n as u64;
    if (frame_words % (FRAME_WORDS as u64) != 0) {
        // partialframe is appended after the packet warnings
        const wc : usize = res[27] as usize;
        if (wc < 3) {
            res[28 + wc] = 3;
            res[27] = (wc + 1) as u64;
        }
    }
    if (nz.len < frame_slots_n or fars.len < frame_slots_n) { return 3; }
    z = 0;
    while (z < frame_slots_n) {
        nz[z] = 0;
        z = z + 1;
    }
    var k : usize = 0;
    var nonzero_frames : u64 = 0;
    var ones : u64 = 0;
    var e : usize = 0;
    while (e < (wp[21] as usize)) {
        const woff : usize = fdri[e * 4] as usize;
        const nf : usize = ((fdri[e * 4 + 1] as u64) / (FRAME_WORDS as u64)) as usize;
        var f : usize = 0;
        while (f < nf and k < frame_slots_n) {
            const base : usize = woff + f * (FRAME_WORDS as usize) * 4;
            var fones : u64 = 0;
            var wi : usize = 0;
            while (wi < (FRAME_WORDS as usize)) {
                var v : u32 = be32(u, base + wi * 4);
                if (wi == (ECC_WORD as usize)) { v = v & (4294967295 - ECC_MASK); }
                if (v != 0) { fones = fones + (popcount(v) as u64); }
                wi = wi + 1;
            }
            nz[k] = 0;
            if (fones != 0) {
                nz[k] = 1;
                nonzero_frames = nonzero_frames + 1;
                ones = ones + fones;
            }
            f = f + 1;
            k = k + 1;
        }
        e = e + 1;
    }
    res[48] = nonzero_frames;
    res[49] = ones;

    // frame addresses from the die's layout
    var geom_at : i64 = -1;
    if (have_id) { geom_at = find_geom(geoms, idc); }
    var mapped : bool = false;
    var nslots : usize = 0;
    if (geom_at >= 0) {
        const ga : usize = geom_at as usize;
        const need : usize = geom_slot_count(geoms, ga);
        if (slots.len < need) { return 1; }
        nslots = frame_slots(geoms, ga, slots[0 .. need]);
        // fars[j]: NONE for a pad slot, NONE - 1 for undefined, else the FAR
        var ok : bool = true;
        var j : usize = 0;
        e = 0;
        while (e < (wp[21] as usize)) {
            const nf : usize = ((fdri[e * 4 + 1] as u64) / (FRAME_WORDS as u64)) as usize;
            var at : i64 = -1;
            if (fdri[e * 4 + 2] == 1) {
                var s : usize = 0;
                while (s < nslots and at < 0) {
                    if (slots[s] != NONE and slots[s] == fdri[e * 4 + 3]) { at = s as i64; }
                    s = s + 1;
                }
            }
            if (at < 0) { ok = false; }
            var f : usize = 0;
            while (f < nf and j < frame_slots_n) {
                fars[j] = NONE - 1;
                if (at >= 0 and (at as usize) + f < nslots) { fars[j] = slots[(at as usize) + f]; }
                f = f + 1;
                j = j + 1;
            }
            e = e + 1;
        }
        // frames never reached keep the initial `undefined` of fill(undefined)
        while (j < frame_slots_n) {
            fars[j] = NONE - 1;
            j = j + 1;
        }
        if (ok) {
            mapped = true;
            res[50] = 1;
            res[51] = geom_index_of(geoms, ga) as u64;
        }
    }
    if (mapped) {
        const ga : usize = geom_at as usize;
        const nrows : usize = geoms[ga + 1] as usize;
        var pads : u64 = 0;
        var q : usize = 0;
        while (q < frame_slots_n) {
            if (fars[q] == NONE) { pads = pads + 1; }
            q = q + 1;
        }
        res[46] = pads;
        res[47] = (frame_slots_n as u64) - pads;
        if (hitall.len < 2 * buckets * nrows) { return 1; }
        var h : usize = 0;
        while (h < 2 * buckets * nrows) {
            hitall[h] = 0;
            h = h + 1;
        }
        // geometry rows: p offsets
        var fi : usize = 0;
        while (fi < frame_slots_n) {
            const far : u32 = fars[fi];
            if (far != NONE and far != NONE - 1) {
                const blk : u32 = (far >> 23) & 7;
                if (blk < 3) {
                    res[52 + 2 * (blk as usize)] = res[52 + 2 * (blk as usize)] + 1;
                    if (nz[fi] == 1) { res[53 + 2 * (blk as usize)] = res[53 + 2 * (blk as usize)] + 1; }
                }
                // the row: the last geometry row with the same block, bottom and row
                var ri : i64 = -1;
                var rp : usize = ga + 2;
                var r : usize = 0;
                var rpos : usize = 0;
                while (r < nrows) {
                    const gb : u32 = geoms[rp];
                    const gbo : u32 = geoms[rp + 1];
                    const gr : u32 = geoms[rp + 2];
                    if (((gb << 6) | (gbo << 5) | gr) == (far >> 17)) {
                        ri = r as i64;
                        rpos = rp;
                    }
                    rp = rp + 4 + (geoms[rp + 3] as usize);
                    r = r + 1;
                }
                if (ri >= 0) {
                    // total frames of the row, and the start of the column named by the FAR
                    const ncols : usize = geoms[rpos + 3] as usize;
                    var total : u64 = 0;
                    var c : usize = 0;
                    while (c < ncols) {
                        total = total + (geoms[rpos + 4 + c] as u64);
                        c = c + 1;
                    }
                    // colStart: the last row with this block/bottom/row key and a column of that number
                    var cstart : u64 = 0;
                    var rp2 : usize = ga + 2;
                    var r2 : usize = 0;
                    const want : u32 = far & (4294967295 - 127);
                    while (r2 < nrows) {
                        const nc2 : usize = geoms[rp2 + 3] as usize;
                        var acc : u64 = 0;
                        var c2 : usize = 0;
                        while (c2 < nc2) {
                            if (encode_far(geoms[rp2], geoms[rp2 + 1], geoms[rp2 + 2], c2 as u32, 0) == want) { cstart = acc; }
                            acc = acc + (geoms[rp2 + 4 + c2] as u64);
                            c2 = c2 + 1;
                        }
                        rp2 = rp2 + 4 + nc2;
                        r2 = r2 + 1;
                    }
                    const pos : u64 = cstart + ((far & 127) as u64);
                    const ratio : f64 = ((pos as f64) / (total as f64)) * (buckets as f64);
                    var bi : f64 = @floor(ratio);
                    if (ratio == ratio) {
                        if (bi > ((buckets - 1) as f64)) { bi = (buckets - 1) as f64; }
                        const b : usize = bi as usize;
                        const base : usize = (ri as usize) * 2 * buckets;
                        hitall[base + buckets + b] = hitall[base + buckets + b] + 1;
                        if (nz[fi] == 1) { hitall[base + b] = hitall[base + b] + 1; }
                    }
                }
            }
            fi = fi + 1;
        }
        // the strip: one entry per geometry row
        res[58] = nrows as u64;
        const lbase : usize = res[43] as usize;
        if (lists.len < lbase + 3 * nrows or cells.len < buckets * nrows) { return 1; }
        var r : usize = 0;
        var rp : usize = ga + 2;
        while (r < nrows) {
            lists[lbase + r * 3] = geoms[rp];
            lists[lbase + r * 3 + 1] = geoms[rp + 1];
            lists[lbase + r * 3 + 2] = geoms[rp + 2];
            var b : usize = 0;
            while (b < buckets) {
                cells[r * buckets + b] = shade_char(hitall[r * 2 * buckets + b], hitall[r * 2 * buckets + buckets + b]);
                b = b + 1;
            }
            rp = rp + 4 + (geoms[rp + 3] as usize);
            r = r + 1;
        }
    } else {
        res[47] = frame_slots_n as u64;
        if (frame_slots_n > 0) {
            if (hitall.len < 2 * buckets) { return 1; }
            var h : usize = 0;
            while (h < 2 * buckets) {
                hitall[h] = 0;
                h = h + 1;
            }
            var per : f64 = (frame_slots_n as f64) / (buckets as f64);
            if (per == 0.0 or per != per) { per = 1.0; }
            var fi : usize = 0;
            while (fi < frame_slots_n) {
                var cf : f64 = @floor((fi as f64) / per);
                if (cf > ((buckets - 1) as f64)) { cf = (buckets - 1) as f64; }
                const c : usize = cf as usize;
                hitall[buckets + c] = hitall[buckets + c] + 1;
                if (nz[fi] == 1) { hitall[c] = hitall[c] + 1; }
                fi = fi + 1;
            }
            res[58] = 1;
            const lbase : usize = res[43] as usize;
            if (lists.len < lbase + 3 or cells.len < buckets) { return 1; }
            lists[lbase] = NONE;
            lists[lbase + 1] = NONE;
            lists[lbase + 2] = NONE;
            var b : usize = 0;
            while (b < buckets) {
                cells[b] = shade_char(hitall[b], hitall[buckets + b]);
                b = b + 1;
            }
        }
    }
    return 0;
}



// ------------------------------------------------------------------------------------------------
// tests: the first 369 bytes of blink_j26.bit (the header, the sync word at 181 and the packets up to the
// first FDRI write, from gHashTag/t27 fpga/openxc7-synth) and small streams built word by word; the
// answers are samples.json's for the first, and autopsy.js's for the others.
// ------------------------------------------------------------------------------------------------

pub const REAL_HEAD : [369]u8 = [0, 9, 15, 240, 15, 240, 15, 240, 15, 240, 0, 0, 1, 97, 0, 66, 47, 119, 111, 114, 107, 47, 102, 112, 103, 97, 47, 111, 112, 101, 110, 120, 99, 55, 45, 115, 121, 110, 116, 104, 47, 98, 108, 105, 110, 107, 95, 106, 50, 54, 46, 102, 114, 97, 109, 101, 115, 59, 71, 101, 110, 101, 114, 97, 116, 111, 114, 61, 120, 99, 55, 102, 114, 97, 109, 101, 115, 50, 98, 105, 116, 0, 98, 0, 17, 120, 99, 55, 97, 49, 48, 48, 116, 102, 103, 103, 54, 55, 54, 45, 49, 0, 99, 0, 11, 50, 48, 50, 54, 47, 48, 53, 47, 48, 56, 0, 100, 0, 9, 49, 57, 58, 51, 51, 58, 50, 50, 0, 101, 0, 58, 96, 124, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 0, 0, 0, 187, 17, 34, 0, 68, 255, 255, 255, 255, 255, 255, 255, 255, 170, 153, 85, 102, 32, 0, 0, 0, 48, 2, 32, 1, 0, 0, 0, 0, 48, 2, 0, 1, 0, 0, 0, 0, 48, 0, 128, 1, 0, 0, 0, 0, 32, 0, 0, 0, 48, 0, 128, 1, 0, 0, 0, 7, 32, 0, 0, 0, 32, 0, 0, 0, 48, 2, 96, 1, 0, 0, 0, 0, 48, 1, 32, 1, 2, 0, 63, 229, 48, 1, 192, 1, 0, 0, 0, 0, 48, 1, 128, 1, 3, 99, 16, 147, 48, 0, 128, 1, 0, 0, 0, 9, 32, 0, 0, 0, 48, 0, 192, 1, 0, 0, 4, 1, 48, 0, 160, 1, 0, 0, 5, 1, 48, 0, 192, 1, 0, 0, 0, 0, 48, 3, 0, 1, 0, 0, 0, 0, 32, 0, 0, 0, 32, 0, 0, 0, 32, 0, 0, 0, 32, 0, 0, 0, 32, 0, 0, 0, 32, 0, 0, 0, 32, 0, 0, 0, 32, 0, 0, 0, 48, 0, 32, 1, 0, 0, 0, 0, 48, 0, 128, 1, 0, 0, 0, 1, 32, 0, 0, 0, 48, 0, 64, 0, 80, 14, 149, 216];

pub var T_BIN : [4096]u8 = [0; 4096];
pub var T_RES : [64]u64 = [0; 64];
pub var T_LISTS : [256]u32 = [0; 256];
pub var T_CELLS : [256]u8 = [0; 256];
pub var T_STRS : [64]u8 = [0; 64];
pub var T_FDRI : [64]u32 = [0; 64];
pub var T_CMDS : [64]u32 = [0; 64];
pub var T_NZ : [512]u8 = [0; 512];
pub var T_FARS : [512]u32 = [0; 512];
pub var T_SLOTS : [4096]u32 = [0; 4096];
pub var T_HIT : [1024]u32 = [0; 1024];
pub var T_HD : [12]u64 = [0; 12];
pub var T_WP : [24]u64 = [0; 24];
pub var T_OUT : [32]u8 = [0; 32];

/// The test geometry (one device, two rows) and the real a100t layout, flat as autopsy wants them.
pub var T_GEOM : [64]u32 = [0; 64];
pub var T_PARTS : [2]u32 = [0; 2];

pub fn t_setup() {
    T_GEOM[0] = 1;
    T_GEOM[1] = 56807571;
    T_GEOM[2] = 2;
    T_GEOM[3] = 0;
    T_GEOM[4] = 0;
    T_GEOM[5] = 0;
    T_GEOM[6] = 2;
    T_GEOM[7] = 2;
    T_GEOM[8] = 1;
    T_GEOM[9] = 1;
    T_GEOM[10] = 0;
    T_GEOM[11] = 0;
    T_GEOM[12] = 1;
    T_GEOM[13] = 1;
    T_PARTS[0] = 56807571;
    T_PARTS[1] = 56823955;
}

pub fn t_models() -> []const u8 {
    return "xc7a35\nxc7a100\n";
}

/// Zero T_BIN and write one big-endian word.
pub fn t_clear() {
    var i : usize = 0;
    while (i < 4096) {
        T_BIN[i] = 0;
        i = i + 1;
    }
}

pub fn t_word(at: usize, v: u32) {
    T_BIN[at] = ((v >> 24) & 255) as u8;
    T_BIN[at + 1] = ((v >> 16) & 255) as u8;
    T_BIN[at + 2] = ((v >> 8) & 255) as u8;
    T_BIN[at + 3] = (v & 255) as u8;
}

pub fn t_run(len: usize, buckets: usize) -> u32 {
    t_setup();
    return autopsy(T_BIN[0 .. len], T_GEOM[0 .. 64], T_PARTS[0 .. 2], t_models(), buckets, T_RES[0 .. 64], T_LISTS[0 .. 256], T_CELLS[0 .. 256], T_STRS[0 .. 64], T_FDRI[0 .. 64], T_CMDS[0 .. 64], T_NZ[0 .. 512], T_FARS[0 .. 512], T_SLOTS[0 .. 4096], T_HIT[0 .. 1024]);
}


test the_real_head_says_what_samples_json_says_about_blink_j26 {
    t_clear();
    var i : usize = 0;
    while (i < 369) {
        T_BIN[i] = REAL_HEAD[i];
        i = i + 1;
    }
    t_setup();
    assert autopsy(T_BIN[0 .. 369], T_GEOM[0 .. 64], T_PARTS[0 .. 2], t_models(), 160, T_RES[0 .. 64], T_LISTS[0 .. 256], T_CELLS[0 .. 256], T_STRS[0 .. 64], T_FDRI[0 .. 64], T_CMDS[0 .. 64], T_NZ[0 .. 512], T_FARS[0 .. 512], T_SLOTS[0 .. 4096], T_HIT[0 .. 1024]) == 0;
    assert T_RES[0] == 369;
    assert T_RES[1] == 1;
    assert T_RES[2] == 1;
    assert T_RES[13] == 181;
    assert T_RES[11] == 3825788;
    assert T_RES[12] == 0;
    assert T_RES[14] == 1;
    assert T_RES[15] == 56823955;
    assert T_RES[16] == 0;
    assert T_RES[17] == 1;
    assert T_RES[22] == 1;
    assert T_RES[24] == 0;
    assert T_RES[27] == 1;
    assert T_RES[28] == 1;
    assert T_RES[31] == 16;
    assert T_RES[32] == 1;
    assert T_RES[33] == 14;
    assert T_RES[37] == 4;
    assert T_RES[43] == 4;
    assert T_LISTS[0] == 0;
    assert T_LISTS[1] == 7;
    assert T_LISTS[3] == 1;
    assert T_RES[42] == 1;
    assert T_RES[50] == 0;
    assert T_RES[45] == 0;
    assert hd_part_is("xc7a100tfgg676-1");
}

pub fn hd_part_is(w: []const u8) -> bool {
    return parse_header(T_BIN[0 .. 369], T_HD[0 .. 12]) and (T_HD[4] as usize) == w.len and T_BIN[T_HD[3] as usize] == w[0] and T_BIN[(T_HD[3] as usize) + w.len - 1] == w[w.len - 1] and T_HD[0] == 1 and T_HD[10] == 133;
}

test a_mapped_stream_counts_frames_and_ones_and_draws_the_strip {
    t_clear();
    t_word(0, 2862175590);
    t_word(4, 536870912);
    t_word(8, 805404673);
    t_word(12, 56807571);
    t_word(16, 805339137);
    t_word(20, 7);
    t_word(24, 805314561);
    t_word(32, 805339137);
    t_word(36, 1);
    t_word(40, 805323055);
    t_word(56, 2147483649);
    t_word(244, 8191);
    t_word(1052, 65535);
    t_word(1252, 1);
    t_word(1256, 805339137);
    t_word(1260, 13);
    t_word(1264, 4294967295);
    assert t_run(1268, 8) == 0;
    assert T_RES[1] == 0;
    assert T_RES[13] == 0;
    assert T_RES[14] == 1;
    assert T_RES[17] == 0;
    assert T_RES[44] == 303;
    assert T_RES[45] == 3;
    assert T_RES[48] == 2;
    assert T_RES[49] == 6;
    assert T_RES[50] == 1;
    assert T_RES[46] == 0;
    assert T_RES[47] == 3;
    assert T_RES[52] == 3;
    assert T_RES[53] == 2;
    assert T_RES[58] == 2;
    assert T_RES[43] == 3;
    assert T_LISTS[3] == 0;
    assert T_CELLS[0] == 57;
    assert T_CELLS[1] == 45;
    assert T_CELLS[2] == 48;
    assert T_CELLS[3] == 45;
    assert T_CELLS[4] == 45;
    assert T_CELLS[5] == 57;
    assert T_CELLS[6] == 45;
    assert T_CELLS[7] == 45;
    assert T_LISTS[6] == 1;
    assert T_CELLS[8] == 45;
    assert T_CELLS[9] == 45;
    assert T_CELLS[10] == 45;
    assert T_CELLS[11] == 45;
    assert T_CELLS[12] == 45;
    assert T_CELLS[13] == 45;
    assert T_CELLS[14] == 45;
    assert T_CELLS[15] == 45;
    assert T_RES[37] == 3;
    assert T_RES[27] == 0;
}

test an_unknown_device_is_drawn_in_stream_order {
    t_clear();
    t_word(0, 2862175590);
    t_word(4, 805404673);
    t_word(8, 326307987);
    t_word(12, 805322954);
    t_word(20, 3);
    t_word(448, 240);
    assert t_run(824, 4) == 0;
    assert T_RES[14] == 1;
    assert T_RES[17] == 18446744073709551615;
    assert T_RES[50] == 0;
    assert T_RES[45] == 2;
    assert T_RES[48] == 2;
    assert T_RES[49] == 6;
    assert T_RES[58] == 1;
    assert T_LISTS[0] == 4294967295;
    assert T_CELLS[0] == 57;
    assert T_CELLS[1] == 45;
    assert T_CELLS[2] == 57;
    assert T_CELLS[3] == 45;
}

test an_encrypted_stream_is_refused_before_any_frame_is_read {
    t_clear();
    t_word(0, 2862175590);
    t_word(4, 805404673);
    t_word(8, 56823955);
    t_word(12, 805396481);
    t_word(16, 5);
    t_word(20, 805322853);
    t_word(28, 1);
    assert t_run(428, 4) == 0;
    assert T_RES[24] == 1;
    assert T_RES[25] == 1;
    assert T_RES[44] == 0;
    assert T_RES[14] == 1;
    assert T_RES[17] == 1;
}

test compression_and_the_decrypt_bit_are_refusals_too {
    t_clear();
    t_word(0, 2862175590);
    t_word(4, 805388290);
    t_word(8, 1);
    t_word(12, 2);
    assert t_run(16, 4) == 0;
    assert T_RES[24] == 1;
    assert T_RES[25] == 2;
    assert T_RES[14] == 0;
    t_word(4, 805347329);
    t_word(8, 64);
    t_word(12, 0);
    assert t_run(16, 4) == 0;
    assert T_RES[24] == 1;
    assert T_RES[25] == 1;
}

test a_bad_word_a_partial_frame_and_a_cut_write_are_warnings {
    t_clear();
    t_word(0, 2862175590);
    t_word(4, 1073741824);
    t_word(8, 805404673);
    t_word(12, 56823955);
    t_word(20, 4294967295);
    t_word(24, 805322902);
    t_word(36, 9);
    assert t_run(628, 4) == 0;
    assert T_RES[27] == 1;
    assert T_RES[28] == 3;
    assert T_RES[44] == 150;
    assert T_RES[45] == 1;
    assert T_RES[41] == 0;
    assert T_RES[34] == 2;
}

test no_sync_word_means_nosync_and_the_small_functions_agree {
    t_clear();
    T_BIN[0] = 1;
    T_BIN[1] = 2;
    T_BIN[2] = 3;
    T_BIN[3] = 4;
    T_BIN[4] = 5;
    assert t_run(5, 4) == 0;
    assert T_RES[24] == 1;
    assert T_RES[25] == 3;
    assert T_RES[13] == 18446744073709551615;
    assert T_RES[42] == 0;
    assert hex8(56823955, T_OUT[0 .. 32]) == 10;
    assert T_OUT[0] == 48;
    assert T_OUT[1] == 120;
    assert T_OUT[2] == 48;
    assert T_OUT[3] == 51;
    assert T_OUT[4] == 54;
    assert T_OUT[9] == 51;
    assert popcount(4294967295) == 32;
    assert popcount(2863311530) == 16;
    assert popcount(0) == 0;
    assert encode_far(1, 1, 3, 5, 9) == 12976777;
    assert shade_char(0, 0) == 45;
    assert shade_char(0, 4) == 48;
    assert shade_char(1, 100) == 49;
    assert shade_char(9, 9) == 57;
    assert shade_char(1, 3) == 51;
    assert cmd_name_known(13);
    assert cmd_name_known(14) == false;
    assert cmd_name_known(20) == false;
    assert find_sync(REAL_HEAD[0 .. 369], 0, 1048576) == 181;
    assert find_sync(REAL_HEAD[0 .. 369], 182, 1048576) == -1;
    assert lookup_idcode(2147483648 + 56823955, T_PARTS[0 .. 2]) == 1;
    assert die_of("XC7A100TFGG676-1", T_OUT[0 .. 32]) == 7;
    assert T_OUT[0] == 120;
    assert T_OUT[6] == 48;
    assert die_of("xc7a", T_OUT[0 .. 32]) == -1;
    assert die_of("foo", T_OUT[0 .. 32]) == -1;
    t_setup();
    assert geom_slot_count(T_GEOM[0 .. 64], 1) == 8;
    assert frame_slots(T_GEOM[0 .. 64], 1, T_SLOTS[0 .. 4096]) == 8;
    assert T_SLOTS[0] == 0;
    assert T_SLOTS[1] == 1;
    assert T_SLOTS[2] == 128;
    assert T_SLOTS[3] == 4294967295;
    assert T_SLOTS[4] == 4294967295;
    assert T_SLOTS[5] == 8388608;
}

