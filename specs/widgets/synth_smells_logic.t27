/// Parse a log and fill T_OUT with its smell counts; the parse status.
pub fn t_counts(text: []const u8) -> u32 {
    const st : u32 = parse_log(text, T_LS[0 .. 24000], T_ITEMS[0 .. 2400], T_RES[0 .. 40]);
    smell_counts(T_RES[0 .. 40], T_ITEMS[0 .. 2400], T_RES[28] as usize, T_OUT[0 .. 18]);
    return st;
}

/// Is the text of the item (its a span) exactly w?
pub fn t_item_is(text: []const u8, i: usize, w: []const u8) -> bool {
    const o : usize = T_ITEMS[i * 8 + 1] as usize;
    return match_in(text, o, o + (T_ITEMS[i * 8 + 2] as usize), w) and (T_ITEMS[i * 8 + 2] as usize) == w.len;
}

test the_teaching_log_counts_are_the_k_facts_of_the_spec {
    const x : []const u8 = log_teaching();
    assert t_counts(x) == 0;
    assert T_OUT[0] == 0;
    assert T_OUT[1] == 1;
    assert T_OUT[2] == 1;
    assert T_OUT[3] == 4;
    assert T_OUT[4] == 3;
    assert T_OUT[5] == 1;
    assert T_OUT[6] == 15;
    assert T_OUT[7] == 363;
    assert T_OUT[8] == 12;
    assert T_OUT[10] == 53;
    assert T_OUT[11] == 16;
    assert T_OUT[12] == 16;
    assert T_OUT[13] == 16;
    assert T_OUT[14] == 4;
    assert T_OUT[15] == 0;
}

test the_refused_spec_is_one_error_with_its_file_and_line {
    const x : []const u8 = log_ternary_add();
    assert t_counts(x) == 0;
    assert T_OUT[0] == 1;
    assert T_OUT[10] == 0;
    assert T_RES[14] == 0;
    assert T_ITEMS[0] == K_ERROR;
    assert T_ITEMS[5] == 213;
    assert t_item_is(x, 0, "ternary_add.v");
    assert T_ITEMS[3] != NONE;
    assert match_in(x, T_ITEMS[3] as usize, (T_ITEMS[3] + T_ITEMS[4]) as usize, "syntax error, unexpected '@'");
    assert T_RES[1] != NONE as u64;
    assert match_in(x, T_RES[1] as usize, (T_RES[1] + T_RES[2]) as usize, "0.67+post");
    assert T_RES[3] != NONE as u64;
    assert match_in(x, T_RES[3] as usize, (T_RES[3] + T_RES[4]) as usize, "read_verilog -sv ternary_add.v; synth_xilinx -family xc7 -flatten -top ternary_add");
}

test the_clean_comb_dot_log_has_cells_and_no_smell {
    const x : []const u8 = log_comb_dot();
    assert t_counts(x) == 0;
    assert T_OUT[0] + T_OUT[1] + T_OUT[2] + T_OUT[4] + T_OUT[5] + T_OUT[8] == 0;
    assert T_OUT[6] == 250;
    assert T_OUT[7] == 3183;
    assert T_OUT[10] == 457;
    assert T_OUT[11] == 144;
    assert T_OUT[12] == 317;
    assert T_OUT[15] == 2;
}

test the_teaching_log_names_its_wire_its_latch_and_its_memory {
    const x : []const u8 = log_teaching();
    assert t_counts(x) == 0;
    var k : usize = 0;
    var latches : u32 = 0;
    var wires : u32 = 0;
    var mems : u32 = 0;
    while (k < (T_RES[28] as usize)) {
        if (T_ITEMS[k * 8] == K_LATCH) {
            latches = latches + 1;
            assert t_item_is(x, k, "\\smelly_teaching.\\y");
        }
        if (T_ITEMS[k * 8] == K_UNDRIVEN) {
            wires = wires + 1;
            assert t_item_is(x, k, "smelly_teaching.\\forgot");
            assert T_ITEMS[k * 8 + 5] == 4;
        }
        if (T_ITEMS[k * 8] == K_MEMORY) {
            mems = mems + 1;
            assert t_item_is(x, k, "\\regs");
        }
        k = k + 1;
    }
    assert latches == 1;
    assert wires == 1;
    assert mems == 1;
}

test cell_types_fall_into_the_widget_groups {
    assert group_of("LUT6") == G_LUT;
    assert group_of("LUT7") == G_OTHER;
    assert group_of("FDRE") == G_FF;
    assert group_of("FDCE_1") == G_FF;
    assert group_of("FDRE_2") == G_OTHER;
    assert group_of("LDCE") == G_LATCH;
    assert group_of("$_DLATCH_P_") == G_LATCH;
    assert group_of("CARRY4") == G_CARRY;
    assert group_of("MUXF8") == G_MUX;
    assert group_of("DSP48E1") == G_DSP;
    assert group_of("RAMB36E1") == G_BRAM;
    assert group_of("RAM32M") == G_LUTRAM;
    assert group_of("RAM16X1S") == G_LUTRAM;
    assert group_of("RAM16M") == G_OTHER;
    assert group_of("SRLC32E") == G_LUTRAM;
    assert group_of("IBUF") == G_IO;
    assert group_of("BUFGCE") == G_IO;
    assert group_of("OBUFT") == G_IO;
    assert group_of("BUFH") == G_OTHER;
}

test the_lazy_groups_of_the_warning_lines_follow_the_regexes {
    const a : []const u8 = "Warning: Wire 'top.\\w [3]' is used but has no driver.";
    assert m_undriven(a, 0, a.len);
    assert M[1] - M[0] == 10;
    assert wire_end(a, M[0], M[1]) - M[0] == 6;
    const b : []const u8 = "Warning: wire x is used but has no driver";
    assert m_undriven(b, 0, b.len);
    assert M[1] - M[0] == 1;
    const c : []const u8 = "Warning: Wire ' is used but has no driver";
    assert m_undriven(c, 0, c.len);
    assert M[1] - M[0] == 1;
    const d : []const u8 = "Warning: Wire  is used but has no driver";
    assert m_undriven(d, 0, d.len) == false;
    const e : []const u8 = "Warning: multiple conflicting drivers for top.\\a [0]:";
    assert m_conflict(e, 0, e.len);
    assert M[1] - M[0] == 10;
    const f : []const u8 = "Warning: multiple conflicting drivers for :";
    assert m_conflict(f, 0, f.len);
    assert M[1] - M[0] == 1;
    const g : []const u8 = "a:b.v:3:4: ERROR: x";
    assert m_error(g, 0, g.len);
    assert M[1] - M[0] == 7;
    assert M[3] - M[2] == 1;
}

test warnings_count_every_line_and_the_summary_overrides {
    const x : []const u8 = "Warning: a\nWarning: a\nWarning: b\nok\n";
    assert t_counts(x) == 0;
    assert T_RES[8] == 3;
    assert T_RES[9] == 2;
    assert T_RES[11] == 0;
    const y : []const u8 = "Warning: a\nWarning: a\nWarnings: 1 unique message, 7 total\n";
    assert t_counts(y) == 0;
    assert T_RES[8] == 7;
    assert T_RES[9] == 1;
    assert T_RES[10] == 2;
    assert T_RES[11] == 1;
    assert T_RES[0] == 4;
}

test an_empty_command_does_not_count_as_set_and_a_later_one_wins {
    const x : []const u8 = "-- Running command `' --\n-- Running command `abc' --\n";
    assert t_counts(x) == 0;
    assert T_RES[3] != NONE as u64;
    assert T_RES[4] == 3;
}

test trim_log_keeps_the_banner_the_hits_and_the_final_statistics {
    const x : []const u8 = "banner\n-- Running command `x' --\nnoise 1\n2.1. Executing CHECK pass.\nnoise 3\nWarning: w\n    detail\nnoise 4\nnoise 5\n7. Printing statistics.\ntail\n";
    const st : u32 = trim_log(x, T_LS[0 .. 24000], "[{n}]", T_TRIM[0 .. 4096], T_OLEN[0 .. 2]);
    assert st == 0;
    assert T_OLEN[0] == 123;
    assert match_in(T_TRIM[0 .. 4096], 0, 123, "banner\n-- Running command `x' --\n[1]\n2.1. Executing CHECK pass.\n[1]\nWarning: w\n    detail\n[2]\n7. Printing statistics.\ntail\n");
}

