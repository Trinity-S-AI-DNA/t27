// SPDX-License-Identifier: Apache-2.0
; specs/widgets/synth_smells_logic.t27 -- the yosys log reader of the synth-smells widget, as pure rules
; over bytes: the JavaScript file apps/website/public/widgets/synth-smells/smellparse.js (192 lines,
; gHashTag/trinity) ported to .t27. Epic gHashTag/t27#10937, issue #10938. Owner rule (Only t27): the
; logic is written in .t27, never by hand in JavaScript. The page reads a pasted or dropped log in the
; reader's browser and sends nothing anywhere; these rules keep that: they see only the bytes the glue
; hands over, fill buffers the glue hands over, read no file and hold no state between calls.
; --
; Table: every export of smellparse.js and the function(s) that replace it.
;   CELL_GROUPS, groupOf    group_of(type) -> group code: G_LUT 0, G_FF 1, G_LATCH 2, G_CARRY 3, G_MUX 4,
;                           G_DSP 5, G_BRAM 6, G_LUTRAM 7, G_IO 8, G_OTHER 9 (the order of CELL_GROUPS,
;                           "other" last). The regexes are hand-matched; see "regexes" below.
;   parseYosysLog(text)     parse_log(text, ls, items, res) -> status. See "parse layout".
;   smellCounts(p)          smell_counts(res, items, n_items, out): 18 counts, see "counts layout".
;   trimLog(text, marker)   trim_log(text, ls, marker, out, olen) -> status. See "trim layout".
; The internal regex table RE is not exported; each entry is one m_ function, listed under "regexes".
; Not ported: nothing of smellparse.js is left out. Two JavaScript quirks are NOT reproduced and are out of
; the claimed domain: a wire or cell name that is an array index ("0", "17") would come out of
; Object.keys in numeric order, and the name "__proto__" is swallowed by an object; the differential uses
; neither. A number longer than 18 digits saturates at 10^18 here and loses digits in JavaScript; the
; differential stays below 15 digits. An item field that is a u32 (an error's line, a wire's bit count, a
; cell count of one type) above 4294967295 sets status 4.
; Quirk ported on purpose: the JavaScript tests !out.command, so a command that captured the empty text is
; still unset and a later "-- Running command" line replaces it (found by the differential). A string
; literal of this language has no \r or \0 escape; the tests here need neither.
; --
; Domain. ASCII or UTF-8 bytes; bytes above 127 are ordinary non-space characters (JavaScript's \s and
; trim() also take NBSP, U+2028 and friends as space; none of that is ported or claimed). Lines end at
; LF, CR or CRLF (parseYosysLog and trimLog both replace \r\n? by \n before they split).
; --
; line table: ls holds 3 u32 per line (start, end, flag), end exclusive and without the terminator, for
;   up to text.len + 1 lines: ls.len >= 3 * (text.len + 1).
; parse layout (parse_log(text, ls, items, res) -> status 0 | 1 | 2 | 4):
;   res    u64 x 40: [0] lines, [1] version offset (4294967295 none), [2] version length, [3] command
;          offset (4294967295 none), [4] command length, [5] removed cells, [6] removed wires, [7] removed
;          passes, [8] warnings total, [9] warnings unique, [10] warnings counted, [11] summary seen,
;          [12] problems present, [13] problems, [14] stat present, [15] stat total present, [16] stat
;          total, [17] stat submodules, [18 .. 27] group totals G_LUT .. G_OTHER, [28] items used,
;          [29] status. Offsets are in text.
;   items  8 u32 per item: kind, a off, a len, b off, b len, n, k off, k len. Kinds, in order of
;          discovery (the glue reads kinds 0 to 5 and skips 6 and 7, the parser's own sets):
;            0 error      a = file (off 4294967295 when none), b = message, n = line (4294967295 when none)
;            1 latch      a = the signal            2 undriven   a = the wire, n = distinct names (bits)
;            3 conflict   a = the signal            4 memory     a = the memory
;            5 cell       a = the cell type, n = count (the last statistics block, counts of one type added)
;            6 undriven name   (internal)           7 warning line (internal)
;   status 0 ok; 1 items full (the counts in res are incomplete); 2 ls shorter than needed; 4 a number above
;          4294967295 in a u32 field.
; counts layout (smell_counts(res, items, n_items, out) with out u64 x 18): errors, latches, undriven,
;   undriven bits, conflicts, memories, removed cells, removed wires, warnings, warnings unique, cells,
;   submodules, luts, ffs, latch cells, carry, dsp, bram -- the keys of smellCounts, in order.
; trim layout (trim_log(text, ls, marker, out, olen) -> status 0 | 1 | 2): the text trimLog returns is
;   written to out; olen[0] is its length, counted even when out is too short (status 1). marker is the
;   marker text, its first {n} replaced by the number of lines it stands for.
; --
; regexes. Each RE entry of smellparse.js is matched by hand; JavaScript's \s is the ASCII set (tab to
; carriage return, space), \S its complement, \w letters digits underscore. Where a lazy group meets an
; optional tail (`(.+?):?$`, `'?(.+?)'?`) the rule is written out in the function. The capture registers
; M[0 .. 5] hold the spans of the last successful match (offsets in the text; 4294967295 for a group that
; did not take part).
;   version m_version   command m_command   error m_error   latch m_latch   undriven m_undriven
;   conflictNew/Old m_conflict   memMap/memRegs m_memory   removed m_removed   warning m_warning
;   summary m_summary   problems m_problems   statStart is_stat_start   statModule is_stat_module
;   cellsNew/cellsOld m_cells_total   submodules m_submodules   cellNew m_cell_new   cellOld m_cell_old
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_synth_smells_logic;

pub const NONE : u32 = 4294967295;
pub const NO_TEXT : i64 = -1;
pub const PACK : i64 = 4294967296;
pub const BIG : u64 = 1000000000000000000;

pub const G_LUT : u8 = 0;
pub const G_FF : u8 = 1;
pub const G_LATCH : u8 = 2;
pub const G_CARRY : u8 = 3;
pub const G_MUX : u8 = 4;
pub const G_DSP : u8 = 5;
pub const G_BRAM : u8 = 6;
pub const G_LUTRAM : u8 = 7;
pub const G_IO : u8 = 8;
pub const G_OTHER : u8 = 9;

pub const K_ERROR : u32 = 0;
pub const K_LATCH : u32 = 1;
pub const K_UNDRIVEN : u32 = 2;
pub const K_CONFLICT : u32 = 3;
pub const K_MEMORY : u32 = 4;
pub const K_CELL : u32 = 5;
pub const K_UNAME : u32 = 6;
pub const K_WARN : u32 = 7;

pub var M : [8]usize = [0; 8];

// ------------------------------------------------------------------------------------------------
// bytes and spans
// ------------------------------------------------------------------------------------------------

pub fn pack(lo: usize, hi: usize) -> i64 {
    return (lo as i64) * PACK + (hi as i64);
}

pub fn lo_of(p: i64) -> usize {
    return (p / PACK) as usize;
}

pub fn hi_of(p: i64) -> usize {
    return (p % PACK) as usize;
}

pub fn is_ws(b: u8) -> bool {
    return b == 32 or (b >= 9 and b <= 13);
}

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

pub fn is_word(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95;
}

/// Do the bytes of w sit at s[p ..], inside s[.. hi]?
pub fn match_in(s: []const u8, p: usize, hi: usize, w: []const u8) -> bool {
    if (p + w.len > hi) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (s[p + k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn span_eq(s: []const u8, alo: usize, ahi: usize, blo: usize, bhi: usize) -> bool {
    if (ahi - alo != bhi - blo) { return false; }
    var k : usize = 0;
    const n : usize = ahi - alo;
    while (k < n) {
        if (s[alo + k] != s[blo + k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn trim_span(s: []const u8, lo: usize, hi: usize) -> i64 {
    var a : usize = lo;
    var b : usize = hi;
    while (a < b and is_ws(s[a])) { a = a + 1; }
    while (b > a and is_ws(s[b - 1])) { b = b - 1; }
    return pack(a, b);
}

pub fn skip_ws(s: []const u8, p: usize, hi: usize) -> usize {
    var q : usize = p;
    while (q < hi and is_ws(s[q])) { q = q + 1; }
    return q;
}

pub fn skip_digits(s: []const u8, p: usize, hi: usize) -> usize {
    var q : usize = p;
    while (q < hi and is_digit(s[q])) { q = q + 1; }
    return q;
}

/// The value of the digits s[lo .. hi], saturating at 10^18.
pub fn num_of(s: []const u8, lo: usize, hi: usize) -> u64 {
    var v : u64 = 0;
    var i : usize = lo;
    while (i < hi) {
        if (v >= BIG) { return BIG; }
        v = v * 10 + ((s[i] - 48) as u64);
        i = i + 1;
    }
    return v;
}

pub fn clear_m() {
    var k : usize = 0;
    while (k < 8) {
        M[k] = NONE as usize;
        k = k + 1;
    }
}

// ------------------------------------------------------------------------------------------------
// cell groups
// ------------------------------------------------------------------------------------------------

/// The group of a cell type: the first CELL_GROUPS entry whose regex matches.
pub fn group_of(t: []const u8) -> u8 {
    const n : usize = t.len;
    if (n == 4 and match_in(t, 0, n, "LUT") and t[3] >= 49 and t[3] <= 54) { return G_LUT; }
    if (n >= 4 and match_in(t, 0, n, "FD") and (match_in(t, 2, n, "RE") or match_in(t, 2, n, "SE") or match_in(t, 2, n, "CE") or match_in(t, 2, n, "PE"))) {
        if (n == 4) { return G_FF; }
        if (n == 6 and match_in(t, 4, n, "_1")) { return G_FF; }
    }
    if (n >= 4 and match_in(t, 0, n, "LD") and (match_in(t, 2, n, "CE") or match_in(t, 2, n, "PE"))) {
        if (n == 4) { return G_LATCH; }
        if (n == 6 and match_in(t, 4, n, "_1")) { return G_LATCH; }
    }
    if (match_in(t, 0, n, "$_DLATCH")) { return G_LATCH; }
    if (n == 6 and match_in(t, 0, n, "CARRY") and (t[5] == 52 or t[5] == 56)) { return G_CARRY; }
    if (n == 5 and match_in(t, 0, n, "MUXF") and (t[4] == 55 or t[4] == 56)) { return G_MUX; }
    if (n == 7 and match_in(t, 0, n, "DSP48E1")) { return G_DSP; }
    if (n == 8 and (match_in(t, 0, n, "RAMB18E1") or match_in(t, 0, n, "RAMB36E1"))) { return G_BRAM; }
    if (match_in(t, 0, n, "RAM")) {
        if (match_in(t, 3, n, "32") and n >= 6 and (t[5] == 77 or t[5] == 88)) { return G_LUTRAM; }
        if (match_in(t, 3, n, "64") and n >= 6 and (t[5] == 77 or t[5] == 88)) { return G_LUTRAM; }
        if (match_in(t, 3, n, "128") and n >= 7 and (t[6] == 77 or t[6] == 88)) { return G_LUTRAM; }
        if (match_in(t, 3, n, "256") and n >= 7 and (t[6] == 77 or t[6] == 88)) { return G_LUTRAM; }
        if ((match_in(t, 3, n, "16") or match_in(t, 3, n, "32") or match_in(t, 3, n, "64")) and match_in(t, 5, n, "X1") and n >= 8 and (t[7] == 83 or t[7] == 68)) { return G_LUTRAM; }
    }
    if (n == 6 and match_in(t, 0, n, "SRL16E")) { return G_LUTRAM; }
    if (n == 7 and match_in(t, 0, n, "SRLC32E")) { return G_LUTRAM; }
    if (match_in(t, 0, n, "IBUF") or match_in(t, 0, n, "OBUF") or match_in(t, 0, n, "IOBUF") or match_in(t, 0, n, "BUFG")) { return G_IO; }
    return G_OTHER;
}

// ------------------------------------------------------------------------------------------------
// lines
// ------------------------------------------------------------------------------------------------

/// Split at LF, CR and CRLF; ls gets (start, end, 0) per line. Returns the number of lines (terminators + 1),
/// or 0 when ls is too short.
pub fn split_lines(text: []const u8, ls: []u32) -> usize {
    if (ls.len < 3 * (text.len + 1)) { return 0; }
    var n : usize = 0;
    var start : usize = 0;
    var i : usize = 0;
    while (i < text.len) {
        const c : u8 = text[i];
        if (c == 10 or c == 13) {
            ls[n * 3] = start as u32;
            ls[n * 3 + 1] = i as u32;
            ls[n * 3 + 2] = 0;
            n = n + 1;
            if (c == 13 and i + 1 < text.len and text[i + 1] == 10) { i = i + 1; }
            i = i + 1;
            start = i;
        } else {
            i = i + 1;
        }
    }
    ls[n * 3] = start as u32;
    ls[n * 3 + 1] = text.len as u32;
    ls[n * 3 + 2] = 0;
    return n + 1;
}

// ------------------------------------------------------------------------------------------------
// regexes (on one trimmed line s[lo .. hi], unless noted)
// ------------------------------------------------------------------------------------------------

/// version, on the raw line: ^\s*Yosys (\d+\.\d+\S*)  -> M[0..1] = the capture.
pub fn m_version(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = skip_ws(s, lo, hi);
    if (!match_in(s, p, hi, "Yosys ")) { return false; }
    p = p + 6;
    var q : usize = skip_digits(s, p, hi);
    if (q == p) { return false; }
    if (q >= hi or s[q] != 46) { return false; }
    q = q + 1;
    var r : usize = skip_digits(s, q, hi);
    if (r == q) { return false; }
    while (r < hi and !is_ws(s[r])) { r = r + 1; }
    M[0] = p;
    M[1] = r;
    return true;
}

/// command: ^-- Running command `(.*)' --$  -> M[0..1].
pub fn m_command(s: []const u8, lo: usize, hi: usize) -> bool {
    if (hi - lo < 24) { return false; }
    if (!match_in(s, lo, hi, "-- Running command `")) { return false; }
    if (!match_in(s, hi - 4, hi, "' --")) { return false; }
    M[0] = lo + 20;
    M[1] = hi - 4;
    return true;
}

/// error: ^(?:(\S+?):(\d+): )?ERROR: (.*)$  -> M[0..1] file (none: NONE), M[2..3] line digits, M[4..5] message.
pub fn m_error(s: []const u8, lo: usize, hi: usize) -> bool {
    var k : usize = lo;
    while (k < hi and !is_ws(s[k])) {
        if (s[k] == 58 and k > lo) {
            const q : usize = k + 1;
            const e : usize = skip_digits(s, q, hi);
            if (e > q and match_in(s, e, hi, ": ERROR: ")) {
                M[0] = lo;
                M[1] = k;
                M[2] = q;
                M[3] = e;
                M[4] = e + 9;
                M[5] = hi;
                return true;
            }
        }
        k = k + 1;
    }
    if (match_in(s, lo, hi, "ERROR: ")) {
        M[0] = NONE as usize;
        M[1] = NONE as usize;
        M[2] = NONE as usize;
        M[3] = NONE as usize;
        M[4] = lo + 7;
        M[5] = hi;
        return true;
    }
    return false;
}

pub fn m_warning(s: []const u8, lo: usize, hi: usize) -> bool {
    return match_in(s, lo, hi, "Warning: ");
}

/// latch: ^(?:Warning: )?Latch inferred for signal `(.+?)' from process  -> M[0..1].
pub fn m_latch(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = lo;
    if (match_in(s, p, hi, "Warning: ")) { p = p + 9; }
    if (!match_in(s, p, hi, "Latch inferred for signal `")) { return false; }
    p = p + 27;
    var k : usize = p + 1;
    while (k + 14 <= hi) {
        if (match_in(s, k, hi, "' from process")) {
            M[0] = p;
            M[1] = k;
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// The X of `'?(.+?)'?` over E = s[lo .. hi) (hi > lo): a leading quote is taken when something remains, a
/// trailing quote is dropped when something remains.
pub fn strip_quotes(s: []const u8, lo: usize, hi: usize) -> i64 {
    var a : usize = lo;
    if (s[lo] == 39 and hi - lo >= 2) { a = lo + 1; }
    var b : usize = hi;
    if (b - a >= 2 and s[b - 1] == 39) { b = b - 1; }
    return pack(a, b);
}

/// undriven: ^Warning: [Ww]ire '?(.+?)'? is used but has no driver\.?$  -> M[0..1] = X.
pub fn m_undriven(s: []const u8, lo: usize, hi: usize) -> bool {
    if (!match_in(s, lo, hi, "Warning: ")) { return false; }
    const p0 : usize = lo + 9;
    if (p0 >= hi) { return false; }
    if (s[p0] != 87 and s[p0] != 119) { return false; }
    if (!match_in(s, p0 + 1, hi, "ire ")) { return false; }
    const p : usize = p0 + 5;
    var e : usize = hi;
    if (e - p >= 27 and s[e - 1] == 46 and match_in(s, e - 27, hi, " is used but has no driver.")) {
        e = e - 27;
    } else {
        if (e - p >= 26 and match_in(s, e - 26, hi, " is used but has no driver")) {
            e = e - 26;
        } else {
            return false;
        }
    }
    if (e <= p) { return false; }
    const x : i64 = strip_quotes(s, p, e);
    M[0] = lo_of(x);
    M[1] = hi_of(x);
    return true;
}

/// conflict: ^Warning: multiple conflicting drivers for (.+?):?$  or  ^Warning: Driver-driver conflict for (\S+)
/// -> M[0..1].
pub fn m_conflict(s: []const u8, lo: usize, hi: usize) -> bool {
    if (match_in(s, lo, hi, "Warning: multiple conflicting drivers for ")) {
        const p : usize = lo + 42;
        if (p < hi) {
            var e : usize = hi;
            if (e - p >= 2 and s[e - 1] == 58) { e = e - 1; }
            M[0] = p;
            M[1] = e;
            return true;
        }
    }
    if (match_in(s, lo, hi, "Warning: Driver-driver conflict for ")) {
        const p : usize = lo + 36;
        var e : usize = p;
        while (e < hi and !is_ws(s[e])) { e = e + 1; }
        if (e > p) {
            M[0] = p;
            M[1] = e;
            return true;
        }
    }
    return false;
}

/// memory: ^Mapping memory (\S+) in module (\S+?):?$  or  ^Replacing memory (\S+) with list of registers
/// -> M[0..1] = the memory.
pub fn m_memory(s: []const u8, lo: usize, hi: usize) -> bool {
    if (match_in(s, lo, hi, "Mapping memory ")) {
        const p : usize = lo + 15;
        var q : usize = p;
        while (q < hi and !is_ws(s[q])) { q = q + 1; }
        if (q > p and match_in(s, q, hi, " in module ")) {
            const r : usize = q + 11;
            var e : usize = r;
            while (e < hi and !is_ws(s[e])) { e = e + 1; }
            if (e == hi and e > r) {
                M[0] = p;
                M[1] = q;
                return true;
            }
        }
    }
    if (match_in(s, lo, hi, "Replacing memory ")) {
        const p : usize = lo + 17;
        var q : usize = p;
        while (q < hi and !is_ws(s[q])) { q = q + 1; }
        if (q > p and match_in(s, q, hi, " with list of registers")) {
            M[0] = p;
            M[1] = q;
            return true;
        }
    }
    return false;
}

/// removed: ^Removed (\d+) unused cells and (\d+) unused wires\.$  -> M[0..1] cells, M[2..3] wires.
pub fn m_removed(s: []const u8, lo: usize, hi: usize) -> bool {
    if (!match_in(s, lo, hi, "Removed ")) { return false; }
    const a : usize = lo + 8;
    const b : usize = skip_digits(s, a, hi);
    if (b == a) { return false; }
    if (!match_in(s, b, hi, " unused cells and ")) { return false; }
    const c : usize = b + 18;
    const d : usize = skip_digits(s, c, hi);
    if (d == c) { return false; }
    if (!match_in(s, d, hi, " unused wires.")) { return false; }
    if (d + 14 != hi) { return false; }
    M[0] = a;
    M[1] = b;
    M[2] = c;
    M[3] = d;
    return true;
}

/// summary: ^Warnings: (\d+) unique messages?, (\d+) total$  -> M[0..1] unique, M[2..3] total.
pub fn m_summary(s: []const u8, lo: usize, hi: usize) -> bool {
    if (!match_in(s, lo, hi, "Warnings: ")) { return false; }
    const a : usize = lo + 10;
    const b : usize = skip_digits(s, a, hi);
    if (b == a) { return false; }
    if (!match_in(s, b, hi, " unique message")) { return false; }
    var p : usize = b + 15;
    if (p < hi and s[p] == 115) { p = p + 1; }
    if (!match_in(s, p, hi, ", ")) { return false; }
    const c : usize = p + 2;
    const d : usize = skip_digits(s, c, hi);
    if (d == c) { return false; }
    if (!match_in(s, d, hi, " total")) { return false; }
    if (d + 6 != hi) { return false; }
    M[0] = a;
    M[1] = b;
    M[2] = c;
    M[3] = d;
    return true;
}

/// problems: ^Found and reported (\d+) problems?\.$  -> M[0..1].
pub fn m_problems(s: []const u8, lo: usize, hi: usize) -> bool {
    if (!match_in(s, lo, hi, "Found and reported ")) { return false; }
    const a : usize = lo + 19;
    const b : usize = skip_digits(s, a, hi);
    if (b == a) { return false; }
    if (!match_in(s, b, hi, " problem")) { return false; }
    var p : usize = b + 8;
    if (p < hi and s[p] == 115) { p = p + 1; }
    if (!match_in(s, p, hi, ".")) { return false; }
    if (p + 1 != hi) { return false; }
    M[0] = a;
    M[1] = b;
    return true;
}

/// statStart: ^\d+(?:\.\d+)*\. Printing statistics\.$|^Printing statistics\.$
pub fn is_stat_start(s: []const u8, lo: usize, hi: usize) -> bool {
    if (match_in(s, lo, hi, "Printing statistics.") and hi - lo == 20) { return true; }
    var p : usize = skip_digits(s, lo, hi);
    if (p == lo) { return false; }
    while (p < hi and s[p] == 46 and p + 1 < hi and is_digit(s[p + 1])) { p = skip_digits(s, p + 1, hi); }
    if (!match_in(s, p, hi, ". Printing statistics.")) { return false; }
    return p + 22 == hi;
}

/// ^\d+(?:\.\d+)+\. Executing  (a pass header with at least one dot group)
pub fn is_exec(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = skip_digits(s, lo, hi);
    if (p == lo) { return false; }
    var groups : usize = 0;
    while (p < hi and s[p] == 46 and p + 1 < hi and is_digit(s[p + 1])) {
        p = skip_digits(s, p + 1, hi);
        groups = groups + 1;
    }
    if (groups == 0) { return false; }
    return match_in(s, p, hi, ". Executing ");
}

/// ^\d+(?:\.\d+)*\. \S  (a pass header line, for trimLog)
pub fn is_pass_header(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = skip_digits(s, lo, hi);
    if (p == lo) { return false; }
    while (p < hi and s[p] == 46 and p + 1 < hi and is_digit(s[p + 1])) { p = skip_digits(s, p + 1, hi); }
    if (!match_in(s, p, hi, ". ")) { return false; }
    return p + 2 < hi and !is_ws(s[p + 2]);
}

/// statModule: ^=== (.+) ===$
pub fn is_stat_module(s: []const u8, lo: usize, hi: usize) -> bool {
    if (hi - lo < 9) { return false; }
    return match_in(s, lo, hi, "=== ") and match_in(s, hi - 4, hi, " ===");
}

/// cellsNew ^\s+(\d+) cells$  or cellsOld ^\s+Number of cells:\s+(\d+)  on the raw line -> M[0..1].
pub fn m_cells_total(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    if (p == lo) { return false; }
    const q : usize = skip_digits(s, p, hi);
    if (q > p and match_in(s, q, hi, " cells") and q + 6 == hi) {
        M[0] = p;
        M[1] = q;
        return true;
    }
    if (match_in(s, p, hi, "Number of cells:")) {
        const r : usize = skip_ws(s, p + 16, hi);
        if (r > p + 16) {
            const e : usize = skip_digits(s, r, hi);
            if (e > r) {
                M[0] = r;
                M[1] = e;
                return true;
            }
        }
    }
    return false;
}

/// submodules: ^\s+(\d+) submodules$  on the raw line -> M[0..1].
pub fn m_submodules(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    if (p == lo) { return false; }
    const q : usize = skip_digits(s, p, hi);
    if (q == p) { return false; }
    if (!match_in(s, q, hi, " submodules")) { return false; }
    if (q + 11 != hi) { return false; }
    M[0] = p;
    M[1] = q;
    return true;
}

pub fn is_type_start(b: u8) -> bool {
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b == 36 or b == 92;
}

pub fn is_type_char(b: u8) -> bool {
    return is_word(b) or b == 36 or b == 92 or b == 46 or b == 58;
}

/// cellNew: ^\s+(\d+)\s{3,}([A-Za-z_$\\][\w$\\.:]*)\s*$  -> M[0..1] count, M[2..3] type.
pub fn m_cell_new(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    if (p == lo) { return false; }
    const q : usize = skip_digits(s, p, hi);
    if (q == p) { return false; }
    const r : usize = skip_ws(s, q, hi);
    if (r - q < 3) { return false; }
    if (r >= hi or !is_type_start(s[r])) { return false; }
    var e : usize = r + 1;
    while (e < hi and is_type_char(s[e])) { e = e + 1; }
    if (skip_ws(s, e, hi) != hi) { return false; }
    M[0] = p;
    M[1] = q;
    M[2] = r;
    M[3] = e;
    return true;
}

/// cellOld: ^\s{5,}([A-Za-z_$\\][\w$\\.:]*)\s+(\d+)\s*$  -> M[0..1] type, M[2..3] count.
pub fn m_cell_old(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    if (p - lo < 5) { return false; }
    if (p >= hi or !is_type_start(s[p])) { return false; }
    var e : usize = p + 1;
    while (e < hi and is_type_char(s[e])) { e = e + 1; }
    const r : usize = skip_ws(s, e, hi);
    if (r == e) { return false; }
    const d : usize = skip_digits(s, r, hi);
    if (d == r) { return false; }
    if (skip_ws(s, d, hi) != hi) { return false; }
    M[0] = p;
    M[1] = e;
    M[2] = r;
    M[3] = d;
    return true;
}

// ------------------------------------------------------------------------------------------------
// the parser
// ------------------------------------------------------------------------------------------------

/// Add an item; false when items is full (the status is set by the caller).
pub fn put_item(items: []u32, res: []u64, kind: u32, ao: u32, al: u32, bo: u32, bl: u32, n: u32, ko: u32, kl: u32) -> bool {
    const at : usize = res[28] as usize;
    if ((at + 1) * 8 > items.len) {
        res[29] = 1;
        return false;
    }
    items[at * 8] = kind;
    items[at * 8 + 1] = ao;
    items[at * 8 + 2] = al;
    items[at * 8 + 3] = bo;
    items[at * 8 + 4] = bl;
    items[at * 8 + 5] = n;
    items[at * 8 + 6] = ko;
    items[at * 8 + 7] = kl;
    res[28] = (at + 1) as u64;
    return true;
}

/// Index of the item of this kind whose (a) span equals s[lo .. hi], or -1.
pub fn find_item(text: []const u8, items: []const u32, n_items: usize, kind: u32, lo: usize, hi: usize) -> i64 {
    var i : usize = 0;
    while (i < n_items) {
        if (items[i * 8] == kind) {
            const ao : usize = items[i * 8 + 1] as usize;
            if (span_eq(text, ao, ao + (items[i * 8 + 2] as usize), lo, hi)) { return i as i64; }
        }
        i = i + 1;
    }
    return -1;
}

/// wireOf: drop a trailing  \s*\[\d+\]  from s[lo .. hi]; returns the new end.
pub fn wire_end(s: []const u8, lo: usize, hi: usize) -> usize {
    if (hi <= lo or s[hi - 1] != 93) { return hi; }
    var p : usize = hi - 1;
    while (p > lo and is_digit(s[p - 1])) { p = p - 1; }
    if (p == hi - 1) { return hi; }
    if (p == lo or s[p - 1] != 91) { return hi; }
    p = p - 1;
    while (p > lo and is_ws(s[p - 1])) { p = p - 1; }
    return p;
}

/// Add one to a cell type's count (or add the type).
pub fn add_cell(text: []const u8, items: []u32, res: []u64, tlo: usize, thi: usize, count: u64) {
    var big : u64 = count;
    if (big > 4294967295) { res[29] = 4; big = 4294967295; }
    const idx : i64 = find_item(text, items, res[28] as usize, K_CELL, tlo, thi);
    if (idx >= 0) {
        const at : usize = idx as usize;
        const sum : u64 = (items[at * 8 + 5] as u64) + big;
        if (sum > 4294967295) {
            res[29] = 4;
            items[at * 8 + 5] = 4294967295;
        } else {
            items[at * 8 + 5] = sum as u32;
        }
    } else {
        put_item(items, res, K_CELL, tlo as u32, (thi - tlo) as u32, 0, 0, big as u32, 0, 0);
    }
}

/// lastStat: the last statistics block; fills res[14 .. 27] and the cell items.
pub fn last_stat(text: []const u8, ls: []const u32, nlines: usize, items: []u32, res: []u64) {
    var start : i64 = -1;
    var i : usize = nlines;
    while (i > 0 and start < 0) {
        i = i - 1;
        const t : i64 = trim_span(text, ls[i * 3] as usize, ls[i * 3 + 1] as usize);
        if (is_stat_start(text, lo_of(t), hi_of(t))) { start = i as i64; }
    }
    if (start < 0) { return; }
    var from : usize = start as usize;
    i = from;
    var found : bool = false;
    while (i < nlines and !found) {
        const t : i64 = trim_span(text, ls[i * 3] as usize, ls[i * 3 + 1] as usize);
        if (hi_of(t) - lo_of(t) == 24 and match_in(text, lo_of(t), hi_of(t), "=== design hierarchy ===")) {
            from = i;
            found = true;
        }
        i = i + 1;
    }
    var total_present : bool = false;
    var total : u64 = 0;
    var submodules : u64 = 0;
    var seen_types : bool = false;
    i = from + 1;
    var stop : bool = false;
    while (i < nlines and !stop) {
        const lo : usize = ls[i * 3] as usize;
        const hi : usize = ls[i * 3 + 1] as usize;
        const t : i64 = trim_span(text, lo, hi);
        const tl : usize = lo_of(t);
        const th : usize = hi_of(t);
        if (is_exec(text, tl, th) or match_in(text, tl, th, "End of script")) {
            stop = true;
        } else {
            if (is_stat_module(text, tl, th) and seen_types) {
                stop = true;
            } else {
                if (m_cells_total(text, lo, hi)) {
                    total_present = true;
                    total = num_of(text, M[0], M[1]);
                } else {
                    if (m_submodules(text, lo, hi)) {
                        submodules = num_of(text, M[0], M[1]);
                    } else {
                        if (m_cell_new(text, lo, hi)) {
                            add_cell(text, items, res, M[2], M[3], num_of(text, M[0], M[1]));
                            seen_types = true;
                        } else {
                            if (total_present and m_cell_old(text, lo, hi) and !(M[1] - M[0] == 6 and match_in(text, M[0], M[1], "Number"))) {
                                add_cell(text, items, res, M[0], M[1], num_of(text, M[2], M[3]));
                                seen_types = true;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if (!total_present and !seen_types) { return; }
    res[14] = 1;
    if (total_present) {
        res[15] = 1;
        res[16] = total;
    }
    res[17] = submodules;
    var k : usize = 0;
    const n : usize = res[28] as usize;
    while (k < n) {
        if (items[k * 8] == K_CELL) {
            const to : usize = items[k * 8 + 1] as usize;
            const g : u8 = group_of(text[to .. to + (items[k * 8 + 2] as usize)]);
            res[18 + (g as usize)] = res[18 + (g as usize)] + (items[k * 8 + 5] as u64);
        }
        k = k + 1;
    }
}

/// parseYosysLog: see "parse layout" in the header.
pub fn parse_log(text: []const u8, ls: []u32, items: []u32, res: []u64) -> u32 {
    var z : usize = 0;
    while (z < 40) {
        res[z] = 0;
        z = z + 1;
    }
    res[1] = NONE as u64;
    res[3] = NONE as u64;
    const nlines : usize = split_lines(text, ls);
    if (nlines == 0) {
        res[29] = 2;
        return 2;
    }
    res[0] = nlines as u64;
    var counted : u64 = 0;
    var i : usize = 0;
    while (i < nlines) {
        const lo : usize = ls[i * 3] as usize;
        const hi : usize = ls[i * 3 + 1] as usize;
        const tt : i64 = trim_span(text, lo, hi);
        const tl : usize = lo_of(tt);
        const th : usize = hi_of(tt);
        if (res[1] == NONE as u64 and m_version(text, lo, hi)) {
            res[1] = M[0] as u64;
            res[2] = (M[1] - M[0]) as u64;
        }
        if (res[4] == 0 and m_command(text, tl, th)) {   // JavaScript tests !out.command: an empty command is still unset
            res[3] = M[0] as u64;
            res[4] = (M[1] - M[0]) as u64;
        }
        i = i + 1;
        if (m_error(text, tl, th)) {
            const fo : usize = M[0];
            const fe : usize = M[1];
            const lo2 : usize = M[2];
            const le2 : usize = M[3];
            const mo : usize = M[4];
            const me : usize = M[5];
            if (true) {
                // the dedupe key of an error is the whole trimmed line, stored in k
                var dup : bool = false;
                var q : usize = 0;
                const n0 : usize = res[28] as usize;
                while (q < n0 and !dup) {
                    if (items[q * 8] == K_ERROR) {
                        const ko : usize = items[q * 8 + 6] as usize;
                        if (span_eq(text, ko, ko + (items[q * 8 + 7] as usize), tl, th)) { dup = true; }
                    }
                    q = q + 1;
                }
                if (!dup) {
                    var fa : u32 = NONE;
                    var fl : u32 = 0;
                    if (fo != NONE as usize) {
                        fa = fo as u32;
                        fl = (fe - fo) as u32;
                    }
                    var ln : u32 = NONE;
                    if (lo2 != NONE as usize) {
                        const v : u64 = num_of(text, lo2, le2);
                        if (v > 4294967294) { res[29] = 4; ln = NONE; } else { ln = v as u32; }
                    }
                    put_item(items, res, K_ERROR, fa, fl, mo as u32, (me - mo) as u32, ln, tl as u32, (th - tl) as u32);
                }
            }
            continue;
        }
        if (m_warning(text, tl, th)) {
            counted = counted + 1;
            var dupw : bool = false;
            var q : usize = 0;
            const n0 : usize = res[28] as usize;
            while (q < n0 and !dupw) {
                if (items[q * 8] == K_WARN) {
                    const ao : usize = items[q * 8 + 1] as usize;
                    if (span_eq(text, ao, ao + (items[q * 8 + 2] as usize), tl, th)) { dupw = true; }
                }
                q = q + 1;
            }
            if (!dupw) { put_item(items, res, K_WARN, tl as u32, (th - tl) as u32, 0, 0, 0, 0, 0); }
        }
        if (m_latch(text, tl, th)) {
            if (find_item(text, items, res[28] as usize, K_LATCH, M[0], M[1]) < 0) {
                put_item(items, res, K_LATCH, M[0] as u32, (M[1] - M[0]) as u32, 0, 0, 0, 0, 0);
            }
            continue;
        }
        if (m_undriven(text, tl, th)) {
            const xo : usize = M[0];
            const xe : usize = M[1];
            const we : usize = wire_end(text, xo, xe);
            var wi : i64 = find_item(text, items, res[28] as usize, K_UNDRIVEN, xo, we);
            if (wi < 0) {
                if (put_item(items, res, K_UNDRIVEN, xo as u32, (we - xo) as u32, 0, 0, 0, 0, 0)) { wi = (res[28] as i64) - 1; }
            }
            if (wi >= 0) {
                // is this full name already counted for this wire?
                var dupn : bool = false;
                var q : usize = 0;
                const n0 : usize = res[28] as usize;
                while (q < n0 and !dupn) {
                    if (items[q * 8] == K_UNAME and (items[q * 8 + 5] as i64) == wi) {
                        const ao : usize = items[q * 8 + 1] as usize;
                        if (span_eq(text, ao, ao + (items[q * 8 + 2] as usize), xo, xe)) { dupn = true; }
                    }
                    q = q + 1;
                }
                if (!dupn) {
                    if (put_item(items, res, K_UNAME, xo as u32, (xe - xo) as u32, 0, 0, wi as u32, 0, 0)) {
                        items[(wi as usize) * 8 + 5] = items[(wi as usize) * 8 + 5] + 1;
                    }
                }
            }
            continue;
        }
        if (m_conflict(text, tl, th)) {
            if (find_item(text, items, res[28] as usize, K_CONFLICT, M[0], M[1]) < 0) {
                put_item(items, res, K_CONFLICT, M[0] as u32, (M[1] - M[0]) as u32, 0, 0, 0, 0, 0);
            }
            continue;
        }
        if (m_memory(text, tl, th)) {
            if (find_item(text, items, res[28] as usize, K_MEMORY, M[0], M[1]) < 0) {
                put_item(items, res, K_MEMORY, M[0] as u32, (M[1] - M[0]) as u32, 0, 0, 0, 0, 0);
            }
            continue;
        }
        if (m_removed(text, tl, th)) {
            res[5] = res[5] + num_of(text, M[0], M[1]);
            res[6] = res[6] + num_of(text, M[2], M[3]);
            res[7] = res[7] + 1;
            continue;
        }
        if (m_summary(text, tl, th)) {
            res[9] = num_of(text, M[0], M[1]);
            res[8] = num_of(text, M[2], M[3]);
            res[11] = 1;
            continue;
        }
        if (m_problems(text, tl, th)) {
            res[12] = 1;
            res[13] = num_of(text, M[0], M[1]);
        }
    }
    res[10] = counted;
    if (res[11] == 0) {
        res[8] = counted;
        var uniq : u64 = 0;
        var q : usize = 0;
        const n0 : usize = res[28] as usize;
        while (q < n0) {
            if (items[q * 8] == K_WARN) { uniq = uniq + 1; }
            q = q + 1;
        }
        res[9] = uniq;
    }
    last_stat(text, ls, nlines, items, res);
    return res[29] as u32;
}

/// smellCounts: see "counts layout" in the header.
pub fn smell_counts(res: []const u64, items: []const u32, n_items: usize, out: []u64) {
    var k : usize = 0;
    while (k < 18) {
        out[k] = 0;
        k = k + 1;
    }
    var i : usize = 0;
    while (i < n_items) {
        const kind : u32 = items[i * 8];
        if (kind == K_ERROR) { out[0] = out[0] + 1; }
        if (kind == K_LATCH) { out[1] = out[1] + 1; }
        if (kind == K_UNDRIVEN) {
            out[2] = out[2] + 1;
            out[3] = out[3] + (items[i * 8 + 5] as u64);
        }
        if (kind == K_CONFLICT) { out[4] = out[4] + 1; }
        if (kind == K_MEMORY) { out[5] = out[5] + 1; }
        i = i + 1;
    }
    out[6] = res[5];
    out[7] = res[6];
    out[8] = res[8];
    out[9] = res[9];
    if (res[14] == 1) {
        if (res[15] == 1) { out[10] = res[16]; }
        out[11] = res[17];
        out[12] = res[18];
        out[13] = res[19];
        out[14] = res[20];
        out[15] = res[21];
        out[16] = res[23];
        out[17] = res[24];
    }
}

// ------------------------------------------------------------------------------------------------
// trimLog
// ------------------------------------------------------------------------------------------------

/// ^\s{2,}\S  on the raw line.
pub fn is_indented(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    return p - lo >= 2 and p < hi;
}

/// A line trimLog keeps because the parser reads it.
pub fn is_hit(s: []const u8, lo: usize, hi: usize) -> bool {
    return m_error(s, lo, hi) or m_warning(s, lo, hi) or m_latch(s, lo, hi) or m_memory(s, lo, hi) or m_removed(s, lo, hi) or m_summary(s, lo, hi) or m_problems(s, lo, hi);
}

pub fn out_put(out: []u8, olen: []u32, b: u8) {
    const at : usize = olen[0] as usize;
    if (at < out.len) { out[at] = b; } else { olen[1] = 1; }
    olen[0] = (at + 1) as u32;
}

pub fn out_span(out: []u8, olen: []u32, s: []const u8, lo: usize, hi: usize) {
    var k : usize = lo;
    while (k < hi) {
        out_put(out, olen, s[k]);
        k = k + 1;
    }
}

/// The marker with its first {n} replaced by gap.
pub fn out_marker(out: []u8, olen: []u32, marker: []const u8, gap: usize) {
    var at : i64 = -1;
    var k : usize = 0;
    while (k + 3 <= marker.len and at < 0) {
        if (marker[k] == 123 and marker[k + 1] == 110 and marker[k + 2] == 125) { at = k as i64; }
        k = k + 1;
    }
    if (at < 0) {
        out_span(out, olen, marker, 0, marker.len);
        return;
    }
    const a : usize = at as usize;
    out_span(out, olen, marker, 0, a);
    var digits : [20]u8 = [0; 20];
    var n : usize = 0;
    var g : usize = gap;
    if (g == 0) {
        digits[0] = 48;
        n = 1;
    }
    while (g > 0) {
        digits[n] = (48 + (g % 10)) as u8;
        g = g / 10;
        n = n + 1;
    }
    while (n > 0) {
        n = n - 1;
        out_put(out, olen, digits[n]);
    }
    out_span(out, olen, marker, a + 3, marker.len);
}

/// trimLog: see "trim layout" in the header. olen has 2 slots: the length, and a full-buffer flag.
pub fn trim_log(text: []const u8, ls: []u32, marker: []const u8, out: []u8, olen: []u32) -> u32 {
    olen[0] = 0;
    olen[1] = 0;
    const nlines : usize = split_lines(text, ls);
    if (nlines == 0) { return 2; }
    var stat_from : usize = nlines;
    var i : usize = nlines;
    var found : bool = false;
    while (i > 0 and !found) {
        i = i - 1;
        const t : i64 = trim_span(text, ls[i * 3] as usize, ls[i * 3 + 1] as usize);
        if (is_stat_start(text, lo_of(t), hi_of(t))) {
            stat_from = i;
            found = true;
        }
    }
    var header : i64 = -1;
    var banner : bool = true;
    i = 0;
    while (i < nlines) {
        const lo : usize = ls[i * 3] as usize;
        const hi : usize = ls[i * 3 + 1] as usize;
        const t : i64 = trim_span(text, lo, hi);
        const tl : usize = lo_of(t);
        const th : usize = hi_of(t);
        if (banner) {
            ls[i * 3 + 2] = 1;
            if (m_command(text, tl, th) or i >= 20) { banner = false; }
            i = i + 1;
            continue;
        }
        if (is_pass_header(text, tl, th)) { header = i as i64; }
        if (i >= stat_from) {
            ls[i * 3 + 2] = 1;
            i = i + 1;
            continue;
        }
        if (is_hit(text, tl, th)) {
            ls[i * 3 + 2] = 1;
            if (header >= 0) { ls[(header as usize) * 3 + 2] = 1; }
            var j : usize = i + 1;
            while (j < nlines and is_indented(text, ls[j * 3] as usize, ls[j * 3 + 1] as usize)) {
                ls[j * 3 + 2] = 1;
                j = j + 1;
            }
        }
        i = i + 1;
    }
    var gap : usize = 0;
    var any : bool = false;
    i = 0;
    while (i < nlines) {
        if (ls[i * 3 + 2] == 1) {
            if (gap > 0) {
                if (any) { out_put(out, olen, 10); }
                out_marker(out, olen, marker, gap);
                any = true;
                gap = 0;
            }
            if (any) { out_put(out, olen, 10); }
            out_span(out, olen, text, ls[i * 3] as usize, ls[i * 3 + 1] as usize);
            any = true;
        } else {
            gap = gap + 1;
        }
        i = i + 1;
    }
    if (gap > 0) {
        if (any) { out_put(out, olen, 10); }
        out_marker(out, olen, marker, gap);
    }
    return olen[1];
}

