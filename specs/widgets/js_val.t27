// SPDX-License-Identifier: Apache-2.0
; specs/widgets/js_val.t27 -- what String(v), Number(v), `v ? a : b`, `v === "x"` and fill(template, vars) do to
; a JSON value, for the native widget views. Epic gHashTag/t27#10937, issue #10938. The tool.js files call
; JSON.parse and then splice the values into words with String() / toFixed() / a {name} filler; a native view
; has no tree, only the SPAN of a value in the bytes (json_scan.t27), so this file reads the span the way
; JavaScript would have read the parsed value.
; --
; Value kinds handled the JavaScript way: a string is its decoded UTF-8 text; a number is
; String(Number(text)) (js_num.t27: the shortest digits, "1e+21", never the file's own spelling "1.0");
; true / false / null are those words; a missing key (NO_SPAN) is "undefined"; an object is "[object Object]";
; an array is its elements joined by "," with null and a missing element as "" (one level; an array inside an
; array is joined the same way). Number(v): a number is parsed correctly rounded; a string is trimmed and read
; as a decimal literal (empty -> 0, "Infinity", ".5", "5.", an exponent, the unsigned 0x / 0o / 0b integers,
; JavaScript white space around it, anything else -> NaN); true 1, false 0, null 0, missing NaN, an object NaN,
; an array its single element or 0 when empty. jv_valid is JSON.parse's verdict on a text.
; MEASURED 2026-10-19: t27c 0.5.2 gen + zig wasm32-freestanding ReleaseSmall (5825 bytes for the two functions
; below): 170040 comparisons with node 23: Number(text) over 90027 texts (atoms glued at random, JavaScript
; white space of every kind, hex / octal / binary, 1e1000, "-0", 22-digit random decimals) and JSON.parse's
; verdict over 80013 texts (8665 valid): 0 differences. NOT modelled: lone UTF-16 surrogates in a string
; (\ud800 alone) and an array nested deeper than one level inside Number().
; The value pool (jv_vput_*, jv_fill): a packed byte buffer of (key, value) pairs built by the view, and the
; filler that replaces {key} in a template the way fill() does: a key not in the pool stays as written; the
; template and every value are written as escaped text. `digits_only` selects the t27-cell filler, whose
; placeholder is {\d+}; the others take {\w+}.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_js_val;

use widgets::html_out::OVER;
use widgets::html_out::put;
use widgets::html_out::raw;
use widgets::html_out::put_escaped;
use widgets::html_out::is_word_byte;
use widgets::html_out::H_LT;
use widgets::html_out::H_GT;
use widgets::html_out::H_AMP;
use widgets::html_out::H_QUOTE;
use widgets::html_out::H_APOS;
use widgets::json_scan::NO_SPAN;
use widgets::json_scan::J_NONE;
use widgets::json_scan::J_OBJECT;
use widgets::json_scan::J_ARRAY;
use widgets::json_scan::J_STRING;
use widgets::json_scan::J_NUMBER;
use widgets::json_scan::J_TRUE;
use widgets::json_scan::J_FALSE;
use widgets::json_scan::J_NULL;
use widgets::json_scan::jspan;
use widgets::json_scan::span_lo;
use widgets::json_scan::span_hi;
use widgets::json_scan::skip_ws;
use widgets::json_scan::string_end;
use widgets::json_scan::value_end;
use widgets::json_scan::kind;
use widgets::json_scan::root;
use widgets::json_scan::obj_get;
use widgets::json_scan::arr_len;
use widgets::json_scan::arr_at;
use widgets::json_scan::hex4;
use widgets::json_scan::escape_at;
use widgets::json_scan::cp_utf8_len;
use widgets::json_scan::cp_utf8_byte;
use widgets::json_scan::str_len;
use widgets::json_scan::str_byte;
use widgets::js_num::js_nan;
use widgets::js_num::js_inf;
use widgets::js_num::js_str_num;
use widgets::js_num::js_locale_num;
use widgets::js_num::js_parse_num;
use widgets::js_num::js_to_fixed;
use widgets::js_num::jn_num_ok;
use widgets::js_num::js_is_nan;
use widgets::js_num::jn_put;
use widgets::js_num::jn_raw;
use widgets::js_num::jn_digits;
use widgets::js_num::jn_mul;
use widgets::js_num::jn_mul2;
use widgets::js_num::jn_mul5;
use widgets::js_num::jn_shift;
use widgets::js_num::jn_cmp;
use widgets::js_num::jn_expo;
use widgets::js_num::jn_mant;
use widgets::js_num::jn_make;
use widgets::js_num::jn_exact;
use widgets::js_num::jn_fscale;
use widgets::js_num::jn_shortest;
use widgets::js_num::jn_layout;
use widgets::js_num::JN_TWO52;
use widgets::js_num::JN_TWO53;

/// One decoded UTF-8 byte of the string at sp appended raw: the whole string, linear time.
pub fn jv_str_to(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    while (p < hi) {
        if (d[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(d, p + 1, hi);
            const cp : u32 = e / 16;
            const w : u32 = cp_utf8_len(cp);
            var j : u32 = 0;
            while (j < w) {
                n = put(o, n, cp_utf8_byte(cp, j));
                j = j + 1;
            }
            p = p + 1 + ((e % 16) as usize);
        } else {
            n = put(o, n, d[p]);
            p = p + 1;
        }
    }
    return n;
}

/// The string at sp as escaped HTML text.
pub fn jv_text_str(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    while (p < hi) {
        if (d[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(d, p + 1, hi);
            const cp : u32 = e / 16;
            const w : u32 = cp_utf8_len(cp);
            var j : u32 = 0;
            while (j < w) {
                n = put_escaped(o, n, cp_utf8_byte(cp, j));
                j = j + 1;
            }
            p = p + 1 + ((e % 16) as usize);
        } else {
            n = put_escaped(o, n, d[p]);
            p = p + 1;
        }
    }
    return n;
}

/// The number at sp, correctly rounded.
pub fn jv_numval(d: []const u8, sp: i64) -> f64 {
    return js_parse_num(d, span_lo(sp), span_hi(sp));
}

/// String(v) appended raw (not escaped).
pub fn jv_str(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    const k : u8 = kind(d, sp);
    if (k == J_NONE) { return jn_raw(o, n0, "undefined"); }
    if (k == J_STRING) { return jv_str_to(o, n0, d, sp); }
    if (k == J_NUMBER) { return js_str_num(o, n0, jv_numval(d, sp)); }
    if (k == J_TRUE) { return jn_raw(o, n0, "true"); }
    if (k == J_FALSE) { return jn_raw(o, n0, "false"); }
    if (k == J_NULL) { return jn_raw(o, n0, "null"); }
    if (k == J_OBJECT) { return jn_raw(o, n0, "[object Object]"); }
    var n : u32 = n0;
    const cnt : u32 = arr_len(d, sp);
    var i : u32 = 0;
    while (i < cnt) {
        if (i > 0) { n = put(o, n, 44); }
        const el : i64 = arr_at(d, sp, i);
        const ek : u8 = kind(d, el);
        if (ek != J_NULL and ek != J_NONE) { n = jv_str(o, n, d, el); }
        i = i + 1;
    }
    return n;
}

/// String(v) as escaped HTML text.
pub fn jv_text(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) == J_STRING) { return jv_text_str(o, n0, d, sp); }
    var tmp : [4096]u8 = [0; 4096];
    const l : u32 = jv_str(tmp[0..], 0, d, sp);
    if (l == OVER) { return OVER; }
    var n : u32 = n0;
    var i : u32 = 0;
    while (i < l) {
        n = put_escaped(o, n, tmp[i as usize]);
        i = i + 1;
    }
    return n;
}

/// v === "lit" for a string literal.
pub fn jv_is(d: []const u8, sp: i64, lit: []const u8) -> bool {
    if (kind(d, sp) != J_STRING) { return false; }
    if (str_len(d, sp) != (lit.len as u32)) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (str_byte(d, sp, k as u32) != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// JavaScript truthiness of the value at sp.
pub fn jv_truthy(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    if (k == J_NONE or k == J_NULL or k == J_FALSE) { return false; }
    if (k == J_STRING) { return str_len(d, sp) > 0; }
    if (k == J_NUMBER) {
        const v : f64 = jv_numval(d, sp);
        return v != 0.0 and v == v;
    }
    return true;
}

pub fn jv_is_ws(b: u8) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 11 or b == 12 or b == 13;
}

/// The byte length of the JavaScript white space that STARTS at b[i] (0 when none): the ASCII ones and the
/// UTF-8 forms of U+00A0, U+1680, U+2000..200A, U+2028, U+2029, U+202F, U+205F, U+3000 and U+FEFF.
pub fn jv_ws_at(b: []const u8, i: u32, hi: u32) -> u32 {
    const c : u8 = b[i as usize];
    if (jv_is_ws(c)) { return 1; }
    if (c == 194 and i + 1 < hi and b[(i + 1) as usize] == 160) { return 2; }
    if (c == 239 and i + 2 < hi and b[(i + 1) as usize] == 187 and b[(i + 2) as usize] == 191) { return 3; }
    if (c == 225 and i + 2 < hi and b[(i + 1) as usize] == 154 and b[(i + 2) as usize] == 128) { return 3; }
    if (c == 227 and i + 2 < hi and b[(i + 1) as usize] == 128 and b[(i + 2) as usize] == 128) { return 3; }
    if (c == 226 and i + 2 < hi) {
        const c1 : u8 = b[(i + 1) as usize];
        const c2 : u8 = b[(i + 2) as usize];
        if (c1 == 128 and ((c2 >= 128 and c2 <= 138) or c2 == 168 or c2 == 169 or c2 == 175)) { return 3; }
        if (c1 == 129 and c2 == 159) { return 3; }
    }
    return 0;
}

/// The byte length of the white space that ENDS just before b[hi] (0 when none).
pub fn jv_ws_before(b: []const u8, lo: u32, hi: u32) -> u32 {
    if (hi <= lo) { return 0; }
    if (jv_is_ws(b[(hi - 1) as usize])) { return 1; }
    if (hi >= lo + 2 and jv_ws_at(b, hi - 2, hi) == 2) { return 2; }
    if (hi >= lo + 3 and jv_ws_at(b, hi - 3, hi) == 3) { return 3; }
    return 0;
}

pub fn jv_digit_value(c: u8) -> u32 {
    if (c >= 48 and c <= 57) { return (c - 48) as u32; }
    if (c >= 97 and c <= 102) { return (c - 97) as u32 + 10; }
    if (c >= 65 and c <= 70) { return (c - 65) as u32 + 10; }
    return 99;
}

/// Number(text) for a decoded string of b[0..l), the way JavaScript reads it: white space trimmed, empty is 0,
/// [+-]Infinity, a decimal literal (".5", "5.", exponent), and the unsigned 0x / 0o / 0b integers; else NaN.
pub fn jv_number_of_text(b: []const u8, l: u32) -> f64 {
    var lo : u32 = 0;
    var hi : u32 = l;
    var w : u32 = 1;
    while (lo < hi and w > 0) {
        w = jv_ws_at(b, lo, hi);
        lo = lo + w;
    }
    w = 1;
    while (hi > lo and w > 0) {
        w = jv_ws_before(b, lo, hi);
        hi = hi - w;
    }
    if (lo == hi) { return 0.0; }
    var p : u32 = lo;
    var neg : bool = false;
    if (b[p as usize] == 43 or b[p as usize] == 45) {
        neg = b[p as usize] == 45;
        p = p + 1;
    }
    if (hi - p == 8 and b[p as usize] == 73 and b[(p + 1) as usize] == 110 and b[(p + 2) as usize] == 102 and b[(p + 3) as usize] == 105 and b[(p + 4) as usize] == 110 and b[(p + 5) as usize] == 105 and b[(p + 6) as usize] == 116 and b[(p + 7) as usize] == 121) {
        if (neg) { return 0.0 - js_inf(0.0); }
        return js_inf(0.0);
    }
    if (!neg and p == lo and hi - p >= 3 and b[p as usize] == 48) {
        const x : u8 = b[(p + 1) as usize];
        var radix : u32 = 0;
        if (x == 120 or x == 88) { radix = 16; }
        if (x == 111 or x == 79) { radix = 8; }
        if (x == 98 or x == 66) { radix = 2; }
        if (radix > 0) {
            // the digits as a u64 with the dropped low digits folded into a sticky bit: one correct rounding
            var acc : u64 = 0;
            var sticky : bool = false;
            var drop : i32 = 0;
            var bits : u32 = 4;
            if (radix == 8) { bits = 3; }
            if (radix == 2) { bits = 1; }
            var k : u32 = p + 2;
            while (k < hi) {
                const dv : u32 = jv_digit_value(b[k as usize]);
                if (dv >= radix) { return js_nan(0.0); }
                if (acc < 1152921504606846976) {
                    acc = acc * (radix as u64) + (dv as u64);
                } else {
                    if (dv != 0) { sticky = true; }
                    drop = drop + (bits as i32);
                }
                k = k + 1;
            }
            if (sticky) { acc = acc - (acc % 2) + 1; }
            return jn_make(acc, drop);
        }
    }
    // a decimal literal: digits [. digits] [e [+-] digits]; js_parse_num reads ".5" and "5." too
    if (!jn_num_ok(b, p as usize, hi as usize)) { return js_nan(0.0); }
    if (b[p as usize] == 43 or b[p as usize] == 45) { return js_nan(0.0); }
    const v : f64 = js_parse_num(b, p as usize, hi as usize);
    if (neg) { return v * (0.0 - 1.0); }
    return v;
}

/// Number(v) for the value at sp.
pub fn jv_num(d: []const u8, sp: i64) -> f64 {
    const k : u8 = kind(d, sp);
    if (k == J_NUMBER) { return jv_numval(d, sp); }
    if (k == J_NULL or k == J_FALSE) { return 0.0; }
    if (k == J_TRUE) { return 1.0; }
    if (k == J_STRING) {
        var tmp : [1024]u8 = [0; 1024];
        const l : u32 = jv_str_to(tmp[0..], 0, d, sp);
        if (l == OVER) { return js_nan(0.0); }
        return jv_number_of_text(tmp[0..], l);
    }
    if (k == J_ARRAY) {
        const c : u32 = arr_len(d, sp);
        if (c == 0) { return 0.0; }
        if (c == 1) { return jv_num(d, arr_at(d, sp, 0)); }
    }
    return js_nan(0.0);
}

/// The end of a JSON string whose quote is at p (just past its closing quote), 0 when it is not valid JSON.
pub fn jv_string_ok(d: []const u8, p0: usize) -> usize {
    var p : usize = p0 + 1;
    while (p < d.len) {
        const c : u8 = d[p];
        if (c == 34) { return p + 1; }
        if (c < 32) { return 0; }
        if (c == 92) {
            if (p + 1 >= d.len) { return 0; }
            const e : u8 = d[p + 1];
            if (e == 117) {
                if (p + 5 >= d.len) { return 0; }
                var k : usize = 0;
                while (k < 4) {
                    const h : u8 = d[p + 2 + k];
                    if (!((h >= 48 and h <= 57) or (h >= 65 and h <= 70) or (h >= 97 and h <= 102))) { return 0; }
                    k = k + 1;
                }
                p = p + 6;
            } else {
                if (e == 34 or e == 92 or e == 47 or e == 98 or e == 102 or e == 110 or e == 114 or e == 116) {
                    p = p + 2;
                } else {
                    return 0;
                }
            }
        } else {
            p = p + 1;
        }
    }
    return 0;
}

/// The end of a JSON number at p (strict grammar), 0 when it is not one.
pub fn jv_number_ok(d: []const u8, p0: usize) -> usize {
    var p : usize = p0;
    if (p < d.len and d[p] == 45) { p = p + 1; }
    if (p >= d.len) { return 0; }
    if (d[p] == 48) {
        p = p + 1;
    } else {
        if (d[p] >= 49 and d[p] <= 57) {
            while (p < d.len and d[p] >= 48 and d[p] <= 57) { p = p + 1; }
        } else {
            return 0;
        }
    }
    if (p < d.len and d[p] == 46) {
        p = p + 1;
        var nf : u32 = 0;
        while (p < d.len and d[p] >= 48 and d[p] <= 57) { p = p + 1; nf = nf + 1; }
        if (nf == 0) { return 0; }
    }
    if (p < d.len and (d[p] == 101 or d[p] == 69)) {
        p = p + 1;
        if (p < d.len and (d[p] == 43 or d[p] == 45)) { p = p + 1; }
        var ne : u32 = 0;
        while (p < d.len and d[p] >= 48 and d[p] <= 57) { p = p + 1; ne = ne + 1; }
        if (ne == 0) { return 0; }
    }
    return p;
}

pub fn jv_lit_ok(d: []const u8, p: usize, lit: []const u8) -> bool {
    if (p + lit.len > d.len) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (d[p + k] != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is d one valid JSON document (what JSON.parse accepts), nesting up to 60 deep?
pub fn jv_valid(d: []const u8) -> bool {
    var stack : [64]u8 = [0; 64];
    var depth : u32 = 0;
    var mode : u8 = 0;
    var p : usize = skip_ws(d, 0);
    while (true) {
        if (mode == 0) {
            if (p >= d.len) { return false; }
            const c : u8 = d[p];
            if (c == 123) {
                if (depth >= 60) { return false; }
                stack[depth as usize] = 123;
                depth = depth + 1;
                p = skip_ws(d, p + 1);
                if (p < d.len and d[p] == 125) {
                    depth = depth - 1;
                    p = skip_ws(d, p + 1);
                    mode = 1;
                } else {
                    mode = 2;
                }
            } else {
                if (c == 91) {
                    if (depth >= 60) { return false; }
                    stack[depth as usize] = 91;
                    depth = depth + 1;
                    p = skip_ws(d, p + 1);
                    if (p < d.len and d[p] == 93) {
                        depth = depth - 1;
                        p = skip_ws(d, p + 1);
                        mode = 1;
                    }
                } else {
                    if (c == 34) {
                        const e : usize = jv_string_ok(d, p);
                        if (e == 0) { return false; }
                        p = skip_ws(d, e);
                        mode = 1;
                    } else {
                        if (c == 116 or c == 102 or c == 110) {
                            var lit : usize = 4;
                            var ok1 : bool = false;
                            if (c == 116) { ok1 = jv_lit_ok(d, p, "true"); }
                            if (c == 102) { ok1 = jv_lit_ok(d, p, "false"); lit = 5; }
                            if (c == 110) { ok1 = jv_lit_ok(d, p, "null"); }
                            if (!ok1) { return false; }
                            p = skip_ws(d, p + lit);
                            mode = 1;
                        } else {
                            const e2 : usize = jv_number_ok(d, p);
                            if (e2 == 0) { return false; }
                            p = skip_ws(d, e2);
                            mode = 1;
                        }
                    }
                }
            }
        } else {
            if (mode == 2) {
                if (p >= d.len or d[p] != 34) { return false; }
                const ke : usize = jv_string_ok(d, p);
                if (ke == 0) { return false; }
                p = skip_ws(d, ke);
                if (p >= d.len or d[p] != 58) { return false; }
                p = skip_ws(d, p + 1);
                mode = 0;
            } else {
                if (depth == 0) { return p == d.len; }
                if (p >= d.len) { return false; }
                const t : u8 = stack[(depth - 1) as usize];
                if (d[p] == 44) {
                    p = skip_ws(d, p + 1);
                    if (t == 123) { mode = 2; } else { mode = 0; }
                } else {
                    if ((t == 123 and d[p] == 125) or (t == 91 and d[p] == 93)) {
                        depth = depth - 1;
                        p = skip_ws(d, p + 1);
                    } else {
                        return false;
                    }
                }
            }
        }
    }
    return false;
}

// --- the value pool ------------------------------------------------------------------------------
// vb holds entries: key length (1 byte), key bytes, value length (2 bytes, high then low), value bytes.

pub fn jv_vput_str(vb: []u8, n0: u32, key: []const u8, val: []const u8) -> u32 {
    var n : u32 = n0;
    if (n == OVER) { return OVER; }
    n = put(vb, n, key.len as u8);
    n = jn_raw(vb, n, key);
    n = put(vb, n, ((val.len as u32) / 256) as u8);
    n = put(vb, n, ((val.len as u32) % 256) as u8);
    return jn_raw(vb, n, val);
}

/// A pool entry whose value is String(number).
pub fn jv_vput_f64(vb: []u8, n0: u32, key: []const u8, x: f64) -> u32 {
    var tmp : [64]u8 = [0; 64];
    const l : u32 = js_str_num(tmp[0..], 0, x);
    if (l == OVER) { return OVER; }
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// A pool entry whose value is String(v) of the value at sp.
pub fn jv_vput_val(vb: []u8, n0: u32, key: []const u8, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    if (n == OVER) { return OVER; }
    n = put(vb, n, key.len as u8);
    n = jn_raw(vb, n, key);
    const at : u32 = n;
    n = put(vb, n, 0);
    n = put(vb, n, 0);
    const from : u32 = n;
    n = jv_str(vb, n, d, sp);
    if (n == OVER) { return OVER; }
    const l : u32 = n - from;
    vb[at as usize] = (l / 256) as u8;
    vb[(at + 1) as usize] = (l % 256) as u8;
    return n;
}

/// A pool entry only when the value is defined: a missing key leaves the placeholder as written.
pub fn jv_vput_defined(vb: []u8, n0: u32, key: []const u8, d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) == J_NONE) { return n0; }
    return jv_vput_val(vb, n0, key, d, sp);
}

/// A pool entry whose value is x.toFixed(digits).
pub fn jv_vput_fixed(vb: []u8, n0: u32, key: []const u8, x: f64, digits: u32) -> u32 {
    var tmp : [400]u8 = [0; 400];
    const l : u32 = js_to_fixed(tmp[0..], 0, x, digits);
    if (l == OVER) { return OVER; }
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// A child node of h()/el(): null, undefined and false add nothing, an array adds each of its elements, the rest
/// is String(v) as escaped text.
pub fn jv_kid(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    const k : u8 = kind(d, sp);
    if (k == J_NONE or k == J_NULL or k == J_FALSE) { return n0; }
    if (k == J_ARRAY) {
        var n : u32 = n0;
        const cnt : u32 = arr_len(d, sp);
        var i : u32 = 0;
        while (i < cnt) {
            n = jv_kid(o, n, d, arr_at(d, sp, i));
            i = i + 1;
        }
        return n;
    }
    return jv_text(o, n0, d, sp);
}

/// The value offset of `key` in the pool (its length at offset - 2), or OVER when the key is not there.
pub fn jv_find(vb: []const u8, vn: u32, key: []const u8) -> u32 {
    var p : u32 = 0;
    while (p < vn) {
        const kl : u32 = vb[p as usize] as u32;
        const vl : u32 = (vb[(p + 1 + kl) as usize] as u32) * 256 + (vb[(p + 2 + kl) as usize] as u32);
        var same : bool = kl == (key.len as u32);
        var i : u32 = 0;
        while (same and i < kl) {
            if (vb[(p + 1 + i) as usize] != key[i as usize]) { same = false; }
            i = i + 1;
        }
        if (same) { return p + 3 + kl; }
        p = p + 3 + kl + vl;
    }
    return OVER;
}

/// fill(template, pool): {key} becomes the pool's value (escaped), an unknown {key} stays as written.
pub fn jv_fill(o: []u8, n0: u32, t: []const u8, vb: []const u8, vn: u32, digits_only: bool) -> u32 {
    return jv_fill_with(o, n0, t, vb, vn, digits_only, true);
}

/// jv_fill without the escaping, for a text that is a value itself (an SVG <title>, a pool value).
pub fn jv_fill_raw(o: []u8, n0: u32, t: []const u8, vb: []const u8, vn: u32, digits_only: bool) -> u32 {
    return jv_fill_with(o, n0, t, vb, vn, digits_only, false);
}

pub fn jv_fill_with(o: []u8, n0: u32, t: []const u8, vb: []const u8, vn: u32, digits_only: bool, esc: bool) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        var closed : usize = 0;
        if (t[i] == 123) {
            var j : usize = i + 1;
            if (digits_only) {
                while (j < t.len and t[j] >= 48 and t[j] <= 57) { j = j + 1; }
            } else {
                while (j < t.len and is_word_byte(t[j])) { j = j + 1; }
            }
            if (j > i + 1 and j < t.len and t[j] == 125) { closed = j; }
        }
        if (closed > 0) {
            const at : u32 = jv_find(vb, vn, t[(i + 1)..closed]);
            if (at == OVER) {
                var q : usize = i;
                while (q <= closed) {
                    n = put(o, n, t[q]);
                    q = q + 1;
                }
            } else {
                const vl : u32 = (vb[(at - 2) as usize] as u32) * 256 + (vb[(at - 1) as usize] as u32);
                var v : u32 = 0;
                while (v < vl) {
                    if (esc) { n = put_escaped(o, n, vb[(at + v) as usize]); } else { n = put(o, n, vb[(at + v) as usize]); }
                    v = v + 1;
                }
            }
            i = closed + 1;
        } else {
            if (esc) { n = put_escaped(o, n, t[i]); } else { n = put(o, n, t[i]); }
            i = i + 1;
        }
    }
    return n;
}

fn jv_same_t(o: []const u8, n: u32, want: []const u8) -> bool {
    if (n != (want.len as u32)) { return false; }
    var i : usize = 0;
    while (i < want.len) {
        if (o[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test strings_follow_javascript_for_each_kind {
    const d : []const u8 = "{ \"s\": \"a\\u00e9\\\"b\", \"n\": 1.50, \"i\": 100000000000000000000000, \"t\": true, \"z\": null, \"a\": [1, null, \"x\", [2, 3]], \"o\": {} }";
    const r : i64 = root(d);
    var o : [128]u8 = [0; 128];
    var ln : u32 = jv_str(o[0..], 0, d, obj_get(d, r, "s"));
    assert ln == 5;
    assert o[0] == 97 and o[1] == 195 and o[2] == 169 and o[3] == 34 and o[4] == 98;
    assert jv_same_t(o[0..], jv_str(o[0..], 0, d, obj_get(d, r, "n")), "1.5");
    assert jv_same_t(o[0..], jv_str(o[0..], 0, d, obj_get(d, r, "i")), "1e+23");
    assert jv_same_t(o[0..], jv_str(o[0..], 0, d, obj_get(d, r, "t")), "true");
    assert jv_same_t(o[0..], jv_str(o[0..], 0, d, obj_get(d, r, "z")), "null");
    assert jv_same_t(o[0..], jv_str(o[0..], 0, d, obj_get(d, r, "a")), "1,,x,2,3");
    assert jv_same_t(o[0..], jv_str(o[0..], 0, d, obj_get(d, r, "o")), "[object Object]");
    assert jv_same_t(o[0..], jv_str(o[0..], 0, d, obj_get(d, r, "nope")), "undefined");
    ln = jv_text(o[0..], 0, d, obj_get(d, r, "s"));
    assert ln == 10;
    assert o[1] == 195 and o[2] == 169 and o[3] == 38 and o[4] == 113;
}

test numbers_follow_javascript_for_each_kind {
    const d : []const u8 = "{ \"a\": \" 12.5 \", \"b\": \"\", \"c\": \"x\", \"d\": null, \"e\": true, \"f\": \".5\", \"g\": \"5.\", \"h\": \"1e3\", \"i\": \"-Infinity\", \"j\": [7], \"k\": [] }";
    const r : i64 = root(d);
    assert jv_num(d, obj_get(d, r, "a")) == 12.5;
    assert jv_num(d, obj_get(d, r, "b")) == 0.0;
    assert js_is_nan(jv_num(d, obj_get(d, r, "c")));
    assert jv_num(d, obj_get(d, r, "d")) == 0.0;
    assert jv_num(d, obj_get(d, r, "e")) == 1.0;
    assert jv_num(d, obj_get(d, r, "f")) == 0.5;
    assert jv_num(d, obj_get(d, r, "g")) == 5.0;
    assert jv_num(d, obj_get(d, r, "h")) == 1000.0;
    assert jv_num(d, obj_get(d, r, "i")) < 0.0 - 1e308;
    assert jv_num(d, obj_get(d, r, "j")) == 7.0;
    assert jv_num(d, obj_get(d, r, "k")) == 0.0;
    assert js_is_nan(jv_num(d, obj_get(d, r, "zz")));
    assert jv_truthy(d, obj_get(d, r, "b")) == false;
    assert jv_truthy(d, obj_get(d, r, "a"));
    assert jv_truthy(d, obj_get(d, r, "k"));
    assert jv_truthy(d, obj_get(d, r, "d")) == false;
}

test the_validator_accepts_what_json_parse_accepts_and_nothing_else {
    assert jv_valid("{ \"a\": [1, -2.5e3, \"x\\n\\u00e9\", true, false, null, {}], \"b\": {\"c\": []} }");
    assert jv_valid("  [ ]  ");
    assert jv_valid("0");
    assert jv_valid("\"\"");
    assert jv_valid("{}");
    assert jv_valid("") == false;
    assert jv_valid("   ") == false;
    assert jv_valid("not json {") == false;
    assert jv_valid("{\"a\": 1,}") == false;
    assert jv_valid("[1,]") == false;
    assert jv_valid("{\"a\" 1}") == false;
    assert jv_valid("{a: 1}") == false;
    assert jv_valid("[1 2]") == false;
    assert jv_valid("01") == false;
    assert jv_valid("1.") == false;
    assert jv_valid(".5") == false;
    assert jv_valid("+1") == false;
    assert jv_valid("\"\\x\"") == false;
    assert jv_valid("[1] 2") == false;
    assert jv_valid("{\"a\": 1") == false;
    assert jv_valid("tru") == false;
    assert jv_valid("[\"a\", ]") == false;
    assert jv_valid("{\"a\": nul}") == false;
}

test the_filler_takes_named_and_numbered_placeholders_and_leaves_unknown_ones {
    var vb : [128]u8 = [0; 128];
    var vn : u32 = jv_vput_str(vb[0..], 0, "a", "x<y");
    vn = jv_vput_f64(vb[0..], vn, "n", 0.1);
    vn = jv_vput_str(vb[0..], vn, "0", "zero");
    var o : [128]u8 = [0; 128];
    assert jv_same_t(o[0..], jv_fill(o[0..], 0, "{a} {n} {b} {0} {1} <{", vb[0..], vn, false), "x&lt;y 0.1 {b} zero {1} &lt;{");
    assert jv_same_t(o[0..], jv_fill(o[0..], 0, "{a} {0}", vb[0..], vn, true), "{a} zero");
}
