// SPDX-License-Identifier: Apache-2.0
; specs/widgets/gatle_rule.t27 -- the rules of Gatle as pure functions: the first widget logic file
; ported from JavaScript (trinity apps/website/public/widgets/gatle/rule.js, 51 lines) to .t27.
; Epic gHashTag/t27#10937. Until now rule.js was hand-written and gatle.mjs re-imported it to check
; it against the fixed answers in gatle.t27, "so the page cannot drift from the spec". Here the
; rules and their fixed answers are one file, so there is nothing to drift.
; Ported: dayNumber, dayIndex, puzzleNumber, grade (heat and dir), emoji_code. Not yet ported:
; parseHash and formatHash (URL text handling) -- the next step, once gen-js of str ops is measured.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_gatle_rule;

pub const DAY_MS : u64 = 86400000;

pub const HEAT_CLOSE : u8 = 0;
pub const HEAT_WARM : u8 = 1;
pub const HEAT_COLD : u8 = 2;
pub const DIR_HIT : u8 = 0;
pub const DIR_UP : u8 = 1;
pub const DIR_DOWN : u8 = 2;

pub const EMOJI_HEAT : [3]u32 = [129001, 129000, 128997];
pub const ARROWS : [2]u32 = [11014, 11015];

/// Whole UTC days since 1970-01-01 for a time in milliseconds.
pub fn day_number(ms: u64) -> u64 {
    return ms / DAY_MS;
}

/// The puzzle a UTC day gets: days since the epoch, modulo the pool size (never negative).
pub fn day_index(day: u64, epoch_day: u64, size: u64) -> u64 {
    if (day >= epoch_day) {
        return (day - epoch_day) % size;
    }
    return (size - ((epoch_day - day) % size)) % size;
}

/// The running number a day's puzzle is shared under: the epoch day is #1.
pub fn puzzle_number(day: u64, epoch_day: u64) -> u64 {
    return day - epoch_day + 1;
}

/// |guess - truth| * 100, integer arithmetic only.
pub fn off100(guess: u64, truth: u64) -> u64 {
    if (guess > truth) {
        return (guess - truth) * 100;
    }
    return (truth - guess) * 100;
}

/// close within close_pct percent of the truth (boundary counts), warm within warm_pct, else cold.
pub fn heat(guess: u64, truth: u64, close_pct: u64, warm_pct: u64) -> u8 {
    const off : u64 = off100(guess, truth);
    if (off <= truth * close_pct) {
        return HEAT_CLOSE;
    }
    if (off <= truth * warm_pct) {
        return HEAT_WARM;
    }
    return HEAT_COLD;
}

/// hit when close, else up (the truth is higher) or down.
pub fn dir(guess: u64, truth: u64, close_pct: u64, warm_pct: u64) -> u8 {
    if (heat(guess, truth, close_pct, warm_pct) == HEAT_CLOSE) {
        return DIR_HIT;
    }
    if (truth > guess) {
        return DIR_UP;
    }
    return DIR_DOWN;
}

/// The code point of the heat square of one graded guess.
pub fn heat_code(h: u8) -> u32 {
    return EMOJI_HEAT[h as usize];
}

/// The code point of the arrow of one graded guess; 0 for a hit (no arrow).
pub fn arrow_code(d: u8) -> u32 {
    if (d == DIR_HIT) {
        return 0;
    }
    return ARROWS[(d - 1) as usize];
}

test day_index_on_two_fixed_dates {
    assert day_number(1791072000000) == 20730;
    assert day_index(20730, 20730, 37) == 0;
    assert day_index(20819, 20730, 37) == 15;
    assert puzzle_number(20730, 20730) == 1;
    assert puzzle_number(20819, 20730) == 90;
    assert day_index(20729, 20730, 37) == 36;
}

test close_is_within_ten_percent_boundary_included {
    assert heat(180, 200, 10, 50) == HEAT_CLOSE;
    assert heat(179, 200, 10, 50) == HEAT_WARM;
    assert heat(220, 200, 10, 50) == HEAT_CLOSE;
    assert heat(221, 200, 10, 50) == HEAT_WARM;
    assert heat(1, 200, 10, 50) == HEAT_COLD;
    assert dir(180, 200, 10, 50) == DIR_HIT;
    assert dir(179, 200, 10, 50) == DIR_UP;
    assert dir(221, 200, 10, 50) == DIR_DOWN;
}

test the_share_codes_follow_the_grade {
    assert heat_code(HEAT_CLOSE) == 129001;
    assert heat_code(HEAT_COLD) == 128997;
    assert arrow_code(DIR_HIT) == 0;
    assert arrow_code(DIR_UP) == 11014;
    assert arrow_code(DIR_DOWN) == 11015;
}
