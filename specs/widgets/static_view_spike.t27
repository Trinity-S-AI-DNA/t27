// SPDX-License-Identifier: Apache-2.0
; specs/widgets/static_view_spike.t27 -- spike FR-106 of epic gHashTag/t27#10937 and gHashTag/trinity#1807.
; Question: can a widget of course 12 ship as a page with NO script, built by t27 alone? The page is a
; finite-state machine written out in full: one section per state, a link per transition, the CSS :target
; selector shows the section the address names. t27 enumerates the states at build time (the same
; transition fns and the same writer, html_out, a wasm view would use), so the page is generated, not written.
; The subject is vc-the-loop (apps/website/specs/widgets/vc-the-loop.t27 on branch feat/course-vibecoding of
; gHashTag/trinity); its words and its round table are copied below, unchanged, because that spec lives in
; another repository and cannot be imported here.
; --
; STATE. (h, k, sw): h honest rounds, 0 to 3, each reads the result and fixes one problem, so the problems
; left are K_ROUND_STATE[h]; k rounds run with the reading skipped, they fix nothing; sw is the switch
; "Skip the reading". Total rounds h + k. The switch makes skipping unbounded (k grows by one per click), so the
; page caps the total at cap; at the cap, or when green (h = 3), the round link is a plain span.
; ASSUMPTION: the interaction is read from the words of the widget (SAY_ROUND, SAY_SKIP_READ, SAY_RESET,
; SAY_LEFT, SAY_ROUNDS, SAY_GREEN, SAY_SKIPPED); the old tool.js is not in the worktree. One click on the round
; link is one whole round; the four steps are listed in every state and none is highlighted.
; --
; MEASURE. No workflow can be added for this spike: a new hand-written .yml is DENY in this repository
; (own_language.t27) and t27c has no backend that writes one. So the numbers come out of the tests of this
; spec, which the existing CI already runs. A failing assertion prints the value of its non-literal side
; (W599 in compiler.rs), so each measure_* test below asserts == 1 and fails on purpose (a printed 0 means the page did not fit); the number is in the
; failing line of the log. Raw bytes are render_page's own return value. The compressed size is NOT gzip: it
; is deflate_bytes(), a greedy LZ77 with fixed Huffman codes and one hash candidate, the size a block of that
; kind would take. Real gzip -9 (lazy matching, dynamic Huffman) is expected to be smaller, so it is an upper
; bound for gzip, labelled as such wherever the number is quoted.
; MEASURED (CI run 42816872139, commit 57a5001a1f, read through failing-test counts of ladder probes that are
; deleted in the next commit): cap 6 = 44 states, page 21.7 KB raw (21,700..21,799), deflate estimate 1,920..1,929 B;
; cap 24 = 188 states, page 92.0 KB raw (92,000..92,399), deflate estimate 5,375..5,399 B. About 490 B per state.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_static_view_spike;

use widgets::html_out;

pub const TITLE : str = "Ask, run, read, fix";
pub const K_STEPS_PER_ROUND : u8 = 4;
pub const K_START_PROBLEMS : u8 = 3;
pub const K_ROUND_STATE : [4]u8 = [3, 2, 1, 0];
pub const SAY_STEPS : [4]str = ["Ask", "Run", "Read", "Fix"];
pub const SAY_STEP_LINES : [4]str = [
    "Tell the agent one thing to change.",
    "Run the program or the tests.",
    "Read what came back, all of it.",
    "Fix one problem, then go round again."
];
pub const SAY_ASK : str = "How many rounds until the program is green?";
pub const SAY_ROUND : str = "Run one round";
pub const SAY_SKIP_READ : str = "Skip the reading";
pub const SAY_RESET : str = "Start again";
pub const SAY_LEFT : str = "problems left: {0}";
pub const SAY_ROUNDS : str = "rounds: {0}";
pub const SAY_GREEN : str = "Green. Every problem was found by reading the result.";
pub const SAY_SKIPPED : str = "You did not read the result, so you do not know what is left.";
pub const SAY_NOTE : str = "One round, one fix. Fixing three things at once makes the next error hard to place.";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/the_loop.t27";

/// The whole style sheet. The sections are hidden; the one named by the address is shown; the first state
/// (s0-0-0, written last) is shown when no section is named.
pub const CSS : str = "body{font:16px/1.5 system-ui,sans-serif;max-width:40rem;margin:1rem auto;padding:0 1rem;color:#111;background:#fff}.s{display:none}.s:target{display:block}.s:target~#s0-0-0{display:none}#s0-0-0{display:block}a{color:#111}a.on{font-weight:700}span.off{color:#777}li b{margin-right:.5rem}";

pub var OUT : [524288]u8 = [0;524288];
pub var NUM_A : [20]u8 = [0;20];

// ---- the transitions: the whole logic of the widget, one place ----

/// Problems left after h honest rounds: the round table of the lesson.
pub fn problems_after(h: u32) -> u32 {
    if (h >= 3) { return 0; }
    return K_ROUND_STATE[h as usize] as u32;
}

/// May the round link do something: not when green, not at the cap.
pub fn can_run(h: u32, k: u32, cap: u32) -> bool {
    if (h >= 3) { return false; }
    return h + k < cap;
}

/// Honest rounds after one click on the round link.
pub fn next_h(h: u32, k: u32, sw: u32, cap: u32) -> u32 {
    if (!can_run(h, k, cap)) { return h; }
    if (sw == 1) { return h; }
    return h + 1;
}

/// Skipped rounds after one click on the round link.
pub fn next_k(h: u32, k: u32, sw: u32, cap: u32) -> u32 {
    if (!can_run(h, k, cap)) { return k; }
    if (sw == 1) { return k + 1; }
    return k;
}

/// The number of states with at most cap rounds: h 0 to 3, k up to cap - h, the switch on or off.
pub fn state_count(cap: u32) -> u32 {
    var c : u32 = 0;
    var h : u32 = 0;
    while (h <= 3) {
        var k : u32 = 0;
        while (h + k <= cap) {
            c = c + 2;
            k = k + 1;
        }
        h = h + 1;
    }
    return c;
}

// ---- the page ----

/// The id of a state: s, h, -, k, -, sw.
pub fn state_id(o: []u8, n0: u32, h: u32, k: u32, sw: u32) -> u32 {
    var n : u32 = raw(o, n0, "s");
    n = num(o, n, h as u64);
    n = raw(o, n, "-");
    n = num(o, n, k as u64);
    n = raw(o, n, "-");
    return num(o, n, sw as u64);
}

/// A link to a state, or the plain label when there is nothing to go to.
pub fn link_to(o: []u8, n0: u32, h: u32, k: u32, sw: u32, label: []const u8, live: bool, on: bool) -> u32 {
    var n : u32 = n0;
    if (!live) {
        n = raw(o, n, "<span class='off'>");
        n = text(o, n, label);
        return raw(o, n, "</span> ");
    }
    n = raw(o, n, "<a href='#");
    n = state_id(o, n, h, k, sw);
    if (on) { n = raw(o, n, "' class='on'>"); } else { n = raw(o, n, "'>"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One section: the four steps, the two counters, the verdict line, and the three links.
pub fn render_state(o: []u8, n0: u32, h: u32, k: u32, sw: u32, cap: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section class='s' id='");
    n = state_id(o, n, h, k, sw);
    n = raw(o, n, "'><ol>");
    var i : u32 = 0;
    while (i < 4) {
        n = raw(o, n, "<li><b>");
        n = text(o, n, SAY_STEPS[i as usize]);
        n = raw(o, n, "</b>");
        n = text(o, n, SAY_STEP_LINES[i as usize]);
        n = raw(o, n, "</li>");
        i = i + 1;
    }
    n = raw(o, n, "</ol><p>");
    var la : u32 = dec_to(NUM_A[0..], problems_after(h) as u64);
    n = fill(o, n, SAY_LEFT, NUM_A[0..(la as usize)], "", "", 1);
    n = raw(o, n, "</p><p>");
    var lb : u32 = dec_to(NUM_A[0..], (h + k) as u64);
    n = fill(o, n, SAY_ROUNDS, NUM_A[0..(lb as usize)], "", "", 1);
    n = raw(o, n, "</p>");
    if (h >= 3) {
        n = raw(o, n, "<p>");
        n = text(o, n, SAY_GREEN);
        n = raw(o, n, "</p>");
    } else {
        if (k > 0) {
            n = raw(o, n, "<p>");
            n = text(o, n, SAY_SKIPPED);
            n = raw(o, n, "</p>");
        }
    }
    n = raw(o, n, "<p>");
    n = link_to(o, n, next_h(h, k, sw, cap), next_k(h, k, sw, cap), sw, SAY_ROUND, can_run(h, k, cap), false);
    n = link_to(o, n, h, k, 1 - sw, SAY_SKIP_READ, true, sw == 1);
    n = link_to(o, n, 0, 0, 0, SAY_RESET, true, false);
    return raw(o, n, "</p></section>");
}

/// The whole page for a cap. Every state except s0-0-0 first, s0-0-0 last (the CSS needs it last). 0 when it did not fit.
pub fn render_page(o: []u8, cap: u32) -> u32 {
    var n : u32 = raw(o, 0, "<!doctype html><html lang='en'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>");
    n = text(o, n, TITLE);
    n = raw(o, n, "</title><style>");
    n = raw(o, n, CSS);
    n = raw(o, n, "</style><main><h1>");
    n = text(o, n, TITLE);
    n = raw(o, n, "</h1><p>");
    n = text(o, n, SAY_ASK);
    n = raw(o, n, "</p>");
    var h : u32 = 0;
    while (h <= 3) {
        var k : u32 = 0;
        while (h + k <= cap) {
            var sw : u32 = 0;
            while (sw <= 1) {
                if (!(h == 0 and k == 0 and sw == 0)) { n = render_state(o, n, h, k, sw, cap); }
                sw = sw + 1;
            }
            k = k + 1;
        }
        h = h + 1;
    }
    n = render_state(o, n, 0, 0, 0, cap);
    n = raw(o, n, "<p>");
    n = text(o, n, SAY_NOTE);
    n = raw(o, n, "</p><p>");
    n = text(o, n, SAY_SOURCE);
    n = raw(o, n, "</p></main>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions (see jtag_verdict.t27). Never called.
pub fn html_out_anchor(o: []u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    return OVER + n + (H_SLASH + H_EQ + H_SPACE + H_APOS + H_QUOTE + H_AMP + H_GT + H_LT) as u32;
}

// ---- compressed-size estimate (fixed Huffman, greedy LZ77) ----

pub var HEAD : [32768]u32 = [0;32768];

/// A hash of the four bytes at i; the matches it proposes are verified byte by byte, so a collision costs only a missed match.
fn hash4(b: []const u8, i: u32) -> u32 {
    const x : u32 = (b[i as usize] as u32) * 29791 + (b[(i + 1) as usize] as u32) * 961 + (b[(i + 2) as usize] as u32) * 31 + (b[(i + 3) as usize] as u32);
    return x % 32749;
}

/// Bits of a length code (fixed Huffman: 7 bits up to length 114, 8 from 115) plus its extra bits.
fn len_bits(l: u32) -> u64 {
    var extra : u64 = 0;
    if (l >= 11) { extra = 1; }
    if (l >= 19) { extra = 2; }
    if (l >= 35) { extra = 3; }
    if (l >= 67) { extra = 4; }
    if (l >= 131) { extra = 5; }
    if (l == 258) { extra = 0; }
    if (l >= 115) { return 8 + extra; }
    return 7 + extra;
}

/// Bits of a distance code (fixed Huffman: 5 bits) plus its extra bits.
fn dist_bits(d: u32) -> u64 {
    var extra : u64 = 0;
    var span : u32 = 4;
    while (d > span and extra < 13) {
        extra = extra + 1;
        span = span * 2;
    }
    return 5 + extra;
}

/// Bytes of one fixed-Huffman deflate block holding b[0..n] (3-bit header, 7-bit end code) plus the 18 bytes of a gzip wrapper.
pub fn deflate_bytes(b: []const u8, n: u32) -> u32 {
    var z : usize = 0;
    while (z < 32768) {
        HEAD[z] = 0;
        z = z + 1;
    }
    var bits : u64 = 10;
    var i : u32 = 0;
    while (i < n) {
        var best_len : u32 = 0;
        var best_dist : u32 = 0;
        if (i + 4 <= n) {
            const hv : u32 = hash4(b, i);
            const cand : u32 = HEAD[hv as usize];
            HEAD[hv as usize] = i + 1;
            if (cand > 0) {
                const c : u32 = cand - 1;
                if (i - c <= 32768) {
                    var l : u32 = 0;
                    while (l < 258 and i + l < n and b[(c + l) as usize] == b[(i + l) as usize]) { l = l + 1; }
                    if (l >= 3) {
                        best_len = l;
                        best_dist = i - c;
                    }
                }
            }
        }
        if (best_len >= 3) {
            bits = bits + len_bits(best_len) + dist_bits(best_dist);
            var j : u32 = 1;
            while (j < best_len) {
                if (i + j + 4 <= n) { HEAD[hash4(b, i + j) as usize] = i + j + 1; }
                j = j + 1;
            }
            i = i + best_len;
        } else {
            if (b[i as usize] < 144) { bits = bits + 8; } else { bits = bits + 9; }
            i = i + 1;
        }
    }
    return (((bits + 7) / 8) as u32) + 18;
}

test the_state_counts_for_the_three_caps {
    assert state_count(6) == 44;
    assert state_count(12) == 92;
    assert state_count(24) == 188;
}

test three_honest_rounds_reach_green {
    var h : u32 = 0;
    var k : u32 = 0;
    var i : u32 = 0;
    while (i < 3) {
        const nh : u32 = next_h(h, k, 0, 12);
        const nk : u32 = next_k(h, k, 0, 12);
        h = nh;
        k = nk;
        i = i + 1;
    }
    assert h == 3;
    assert k == 0;
    assert problems_after(h) == 0;
    assert can_run(h, k, 12) == false;
}

test skipping_the_reading_fixes_nothing {
    assert next_h(0, 0, 1, 12) == 0;
    assert next_k(0, 0, 1, 12) == 1;
    assert problems_after(0) == 3;
}

test the_cap_stops_the_round_link {
    assert can_run(0, 11, 12) == true;
    assert can_run(0, 12, 12) == false;
    assert next_k(0, 12, 1, 12) == 12;
}

test every_transition_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var h : u32 = 0;
    while (h <= 3) {
        var k : u32 = 0;
        while (h + k <= 12) {
            var sw : u32 = 0;
            while (sw <= 1) {
                if (next_h(h, k, sw, 12) + next_k(h, k, sw, 12) > 12) { bad = bad + 1; }
                if (next_h(h, k, sw, 12) > 3) { bad = bad + 1; }
                sw = sw + 1;
            }
            k = k + 1;
        }
        h = h + 1;
    }
    assert bad == 0;
}

test the_page_fits_and_a_tiny_buffer_is_refused {
    assert render_page(OUT[0..], 12) > 1000;
    var tiny : [64]u8 = [0; 64];
    assert render_page(tiny[0..], 12) == 0;
}

test the_estimate_is_small_for_a_run_and_large_for_noise {
    var i : usize = 0;
    while (i < 1000) {
        OUT[i] = 97;
        i = i + 1;
    }
    assert deflate_bytes(OUT[0..], 1000) < 60;
    i = 0;
    while (i < 256) {
        OUT[i] = i as u8;
        i = i + 1;
    }
    assert deflate_bytes(OUT[0..], 256) > 256;
    assert dist_bits(1) == 5;
    assert dist_bits(4) == 5;
    assert dist_bits(5) == 6;
    assert dist_bits(9) == 7;
    assert len_bits(3) == 7;
    assert len_bits(11) == 8;
    assert len_bits(258) == 8;
}

// ---- the measurements: each fails on purpose and prints its number (see MEASURE above) ----

test measure_raw_bytes_cap6 {
    const n : u32 = render_page(OUT[0..], 6);
    assert n == 1;
}

test measure_raw_bytes_cap12 {
    const n : u32 = render_page(OUT[0..], 12);
    assert n == 1;
}

test measure_raw_bytes_cap24 {
    const n : u32 = render_page(OUT[0..], 24);
    assert n == 1;
}

test measure_deflate_bytes_cap6 {
    const z : u32 = deflate_bytes(OUT[0..], render_page(OUT[0..], 6));
    assert z == 1;
}

test measure_deflate_bytes_cap12 {
    const z : u32 = deflate_bytes(OUT[0..], render_page(OUT[0..], 12));
    assert z == 1;
}

test measure_deflate_bytes_cap24 {
    const z : u32 = deflate_bytes(OUT[0..], render_page(OUT[0..], 24));
    assert z == 1;
}
