// SPDX-License-Identifier: Apache-2.0
; specs/widgets/json_scan.t27 -- read JSON as bytes, without building a tree. Epic gHashTag/t27#10937,
; stage "page" of specs/t27f/widget_factory.t27: 23 of the 28 tools fetch a data.json (or pool.json,
; design.json) and draw from it; their tool.js calls JSON.parse and walks the result. A native view
; cannot allocate a tree, so it asks this file for the SPAN of a value and reads inside it.
; --
; A span is the byte range of one value, packed in an i64 (lo * 2^32 + hi) as page_reader.t27 packs
; texts; NO_SPAN (-1) is "not there". obj_get finds a key's value, arr_at an element, str_len and
; str_byte read a string with its escapes decoded (\uXXXX and surrogate pairs become UTF-8), num_f64
; and num_i64 read a number, is_true/is_false/is_null the literals. The input is trusted to be JSON
; the data builder wrote: a malformed byte gives NO_SPAN or a wrong value, never a write outside the
; slice.
; Numbers: num_f64 is m / 10^k (or m * 10^k) with m an integer below 2^53 and 10^k exactly
; representable (k up to 22): one correctly rounded operation, equal to JavaScript's Number() for
; those inputs. Outside them (more than 15 or 16 significant digits, an exponent past 22) the last
; digit may differ. MEASURED on the 143 JSON files of the widgets (284965 values read against
; JSON.parse): 6 values differ, all numbers of 16 or 17 significant digits (t27-cell storage permille
; and the same ratios in t27-vs-nvfp4), each in the last place; a correct slow path is not written. A first version divided by 10 k times and was wrong in the last digit of 8 numbers
; of the widgets' data.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_json_scan;

pub const NO_SPAN : i64 = -1;
pub const SPAN : i64 = 4294967296;

pub const J_OBJECT : u8 = 1;
pub const J_ARRAY : u8 = 2;
pub const J_STRING : u8 = 3;
pub const J_NUMBER : u8 = 4;
pub const J_TRUE : u8 = 5;
pub const J_FALSE : u8 = 6;
pub const J_NULL : u8 = 7;
pub const J_NONE : u8 = 0;

pub fn jspan(lo: usize, hi: usize) -> i64 {
    return (lo as i64) * SPAN + (hi as i64);
}

pub fn span_lo(sp: i64) -> usize {
    return (sp / SPAN) as usize;
}

pub fn span_hi(sp: i64) -> usize {
    return (sp % SPAN) as usize;
}

pub fn skip_ws(s: []const u8, p0: usize) -> usize {
    var p : usize = p0;
    while (p < s.len and (s[p] == 32 or s[p] == 9 or s[p] == 10 or s[p] == 13)) { p = p + 1; }
    return p;
}

/// The end offset of the string whose opening quote is at p (just past its closing quote); s.len + 1 when unclosed.
pub fn string_end(s: []const u8, p: usize) -> usize {
    var q : usize = p + 1;
    while (q < s.len) {
        if (s[q] == 92) { q = q + 2; continue; }
        if (s[q] == 34) { return q + 1; }
        q = q + 1;
    }
    return s.len + 1;
}

/// The end offset of the value starting at p (a non-space byte); s.len + 1 when it is cut short.
pub fn value_end(s: []const u8, p: usize) -> usize {
    if (p >= s.len) { return s.len + 1; }
    const c : u8 = s[p];
    if (c == 34) { return string_end(s, p); }
    if (c == 123 or c == 91) {
        var depth : u32 = 0;
        var q : usize = p;
        while (q < s.len) {
            const b : u8 = s[q];
            if (b == 34) {
                q = string_end(s, q);
                continue;
            }
            if (b == 123 or b == 91) { depth = depth + 1; }
            if (b == 125 or b == 93) {
                depth = depth - 1;
                if (depth == 0) { return q + 1; }
            }
            q = q + 1;
        }
        return s.len + 1;
    }
    var q : usize = p;
    while (q < s.len and s[q] != 44 and s[q] != 125 and s[q] != 93 and s[q] != 32 and s[q] != 9 and s[q] != 10 and s[q] != 13) { q = q + 1; }
    return q;
}

/// The span of the whole document: its one value, white space trimmed.
pub fn root(s: []const u8) -> i64 {
    const a : usize = skip_ws(s, 0);
    if (a >= s.len) { return NO_SPAN; }
    const e : usize = value_end(s, a);
    if (e > s.len) { return NO_SPAN; }
    return jspan(a, e);
}

pub fn kind(s: []const u8, sp: i64) -> u8 {
    if (sp < 0) { return J_NONE; }
    const p : usize = span_lo(sp);
    const c : u8 = s[p];
    if (c == 123) { return J_OBJECT; }
    if (c == 91) { return J_ARRAY; }
    if (c == 34) { return J_STRING; }
    if (c == 116) { return J_TRUE; }
    if (c == 102) { return J_FALSE; }
    if (c == 110) { return J_NULL; }
    return J_NUMBER;
}

/// Is the key at s[lo .. hi] (a string with its quotes) equal to `key` once its escapes are decoded?
pub fn key_is(s: []const u8, lo: usize, hi: usize, key: []const u8) -> bool {
    const sp : i64 = jspan(lo, hi);
    if (str_len(s, sp) != (key.len as u32)) { return false; }
    var k : usize = 0;
    while (k < key.len) {
        if (str_byte(s, sp, k as u32) != key[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// The value of `key` in the object at sp (the first such key), NO_SPAN when absent or sp is no object.
pub fn obj_get(s: []const u8, sp: i64, key: []const u8) -> i64 {
    if (kind(s, sp) != J_OBJECT) { return NO_SPAN; }
    const hi : usize = span_hi(sp);
    var p : usize = skip_ws(s, span_lo(sp) + 1);
    while (p < hi and s[p] == 34) {
        const ke : usize = string_end(s, p);
        if (ke > hi) { return NO_SPAN; }
        const q : usize = skip_ws(s, ke);
        if (q >= hi or s[q] != 58) { return NO_SPAN; }
        const v : usize = skip_ws(s, q + 1);
        const ve : usize = value_end(s, v);
        if (ve > hi) { return NO_SPAN; }
        if (key_is(s, p, ke, key)) { return jspan(v, ve); }
        p = skip_ws(s, ve);
        if (p < hi and s[p] == 44) { p = skip_ws(s, p + 1); }
    }
    return NO_SPAN;
}

/// How many elements the array at sp holds (0 when it is no array).
pub fn arr_len(s: []const u8, sp: i64) -> u32 {
    if (kind(s, sp) != J_ARRAY) { return 0; }
    const hi : usize = span_hi(sp);
    var p : usize = skip_ws(s, span_lo(sp) + 1);
    var n : u32 = 0;
    while (p < hi - 1) {
        const e : usize = value_end(s, p);
        if (e > hi) { return n; }
        n = n + 1;
        p = skip_ws(s, e);
        if (p < hi and s[p] == 44) { p = skip_ws(s, p + 1); }
    }
    return n;
}

/// The i-th element of the array at sp, NO_SPAN past the end.
pub fn arr_at(s: []const u8, sp: i64, i: u32) -> i64 {
    if (kind(s, sp) != J_ARRAY) { return NO_SPAN; }
    const hi : usize = span_hi(sp);
    var p : usize = skip_ws(s, span_lo(sp) + 1);
    var n : u32 = 0;
    while (p < hi - 1) {
        const e : usize = value_end(s, p);
        if (e > hi) { return NO_SPAN; }
        if (n == i) { return jspan(p, e); }
        n = n + 1;
        p = skip_ws(s, e);
        if (p < hi and s[p] == 44) { p = skip_ws(s, p + 1); }
    }
    return NO_SPAN;
}

pub fn hex4(s: []const u8, p: usize) -> u32 {
    var v : u32 = 0;
    var i : usize = 0;
    while (i < 4) {
        const b : u8 = s[p + i];
        var d : u32 = 0;
        if (b >= 48 and b <= 57) { d = (b - 48) as u32; }
        if (b >= 97 and b <= 102) { d = (b - 97) as u32 + 10; }
        if (b >= 65 and b <= 70) { d = (b - 65) as u32 + 10; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

/// The code point (and its source length) at s[p ..], p just after a backslash: returns cp * 16 + srclen.
pub fn escape_at(s: []const u8, p: usize, hi: usize) -> u32 {
    const c : u8 = s[p];
    if (c == 110) { return 10 * 16 + 1; }
    if (c == 116) { return 9 * 16 + 1; }
    if (c == 114) { return 13 * 16 + 1; }
    if (c == 98) { return 8 * 16 + 1; }
    if (c == 102) { return 12 * 16 + 1; }
    if (c == 117 and p + 4 < hi) {
        const u : u32 = hex4(s, p + 1);
        if (u >= 55296 and u <= 56319 and p + 10 < hi and s[p + 5] == 92 and s[p + 6] == 117) {
            const lo : u32 = hex4(s, p + 7);
            if (lo >= 56320 and lo <= 57343) {
                const cp : u32 = 65536 + (u - 55296) * 1024 + (lo - 56320);
                return cp * 16 + 11;
            }
        }
        return u * 16 + 5;
    }
    return (c as u32) * 16 + 1;
}

pub fn cp_utf8_len(cp: u32) -> u32 {
    if (cp < 128) { return 1; }
    if (cp < 2048) { return 2; }
    if (cp < 65536) { return 3; }
    return 4;
}

pub fn cp_utf8_byte(cp: u32, j: u32) -> u8 {
    if (cp < 128) { return cp as u8; }
    if (cp < 2048) {
        if (j == 0) { return (192 + cp / 64) as u8; }
        return (128 + cp % 64) as u8;
    }
    if (cp < 65536) {
        if (j == 0) { return (224 + cp / 4096) as u8; }
        if (j == 1) { return (128 + (cp / 64) % 64) as u8; }
        return (128 + cp % 64) as u8;
    }
    if (j == 0) { return (240 + cp / 262144) as u8; }
    if (j == 1) { return (128 + (cp / 4096) % 64) as u8; }
    if (j == 2) { return (128 + (cp / 64) % 64) as u8; }
    return (128 + cp % 64) as u8;
}

/// The length in bytes of the string at sp once its escapes are decoded to UTF-8.
pub fn str_len(s: []const u8, sp: i64) -> u32 {
    if (kind(s, sp) != J_STRING) { return 0; }
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    var n : u32 = 0;
    while (p < hi) {
        if (s[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(s, p + 1, hi);
            n = n + cp_utf8_len(e / 16);
            p = p + 1 + ((e % 16) as usize);
        } else {
            n = n + 1;
            p = p + 1;
        }
    }
    return n;
}

/// The k-th byte of the decoded string at sp; 0 past the end.
pub fn str_byte(s: []const u8, sp: i64, k: u32) -> u8 {
    if (kind(s, sp) != J_STRING) { return 0; }
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    var n : u32 = 0;
    while (p < hi) {
        var cp : u32 = s[p] as u32;
        var adv : usize = 1;
        if (s[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(s, p + 1, hi);
            cp = e / 16;
            adv = 1 + ((e % 16) as usize);
        }
        const w : u32 = cp_utf8_len(cp);
        if (adv == 1 and s[p] != 92 and s[p] >= 128) {
            // a UTF-8 byte already: copied as it stands
            if (n == k) { return s[p]; }
            n = n + 1;
            p = p + 1;
            continue;
        }
        if (k < n + w) { return cp_utf8_byte(cp, k - n); }
        n = n + w;
        p = p + adv;
    }
    return 0;
}

pub fn is_true(s: []const u8, sp: i64) -> bool {
    return kind(s, sp) == J_TRUE;
}

pub fn is_false(s: []const u8, sp: i64) -> bool {
    return kind(s, sp) == J_FALSE;
}

pub fn is_null(s: []const u8, sp: i64) -> bool {
    return kind(s, sp) == J_NULL;
}

/// The number at sp as a double; 0 when it is no number.
pub fn num_f64(s: []const u8, sp: i64) -> f64 {
    if (kind(s, sp) != J_NUMBER) { return 0.0; }
    const hi : usize = span_hi(sp);
    var p : usize = span_lo(sp);
    var neg : bool = false;
    if (s[p] == 45) { neg = true; p = p + 1; }
    var m : f64 = 0.0;
    var scale : i32 = 0;
    var seen_dot : bool = false;
    while (p < hi) {
        const b : u8 = s[p];
        if (b >= 48 and b <= 57) {
            m = m * 10.0 + ((b - 48) as f64);
            if (seen_dot) { scale = scale - 1; }
        } else {
            if (b == 46) { seen_dot = true; } else { break; }
        }
        p = p + 1;
    }
    if (p < hi and (s[p] == 101 or s[p] == 69)) {
        p = p + 1;
        var eneg : bool = false;
        if (p < hi and s[p] == 45) { eneg = true; p = p + 1; }
        if (p < hi and s[p] == 43) { p = p + 1; }
        var e : i32 = 0;
        while (p < hi and s[p] >= 48 and s[p] <= 57) {
            e = e * 10 + ((s[p] - 48) as i32);
            p = p + 1;
        }
        if (eneg) { scale = scale - e; } else { scale = scale + e; }
    }
    // One division or one multiplication by an exactly representable power of ten: correctly rounded.
    // Repeated division by 10 is not (measured: 15042 / 10 / 10 / 10 gives 15.042000000000002).
    var p10 : f64 = 1.0;
    var k : i32 = scale;
    if (k < 0) { k = 0 - k; }
    while (k > 0) { p10 = p10 * 10.0; k = k - 1; }
    var v : f64 = m;
    if (scale < 0) { v = m / p10; } else { v = m * p10; }
    if (neg) { return 0.0 - v; }
    return v;
}

/// The integer part of the number at sp (truncated toward zero) as an i64.
pub fn num_i64(s: []const u8, sp: i64) -> i64 {
    return num_f64(s, sp) as i64;
}

test objects_give_the_span_of_a_key {
    const d : []const u8 = "{ \"days\": 7, \"repo\": \"gHashTag/t27\", \"lanes\": { \"bee\": { \"merged\": 152 } }, \"list\": [1, 22, \"x\"] }";
    const r : i64 = root(d);
    assert r >= 0;
    assert kind(d, r) == J_OBJECT;
    assert num_i64(d, obj_get(d, r, "days")) == 7;
    assert str_len(d, obj_get(d, r, "repo")) == 12;
    assert str_byte(d, obj_get(d, r, "repo"), 0) == 103;
    assert num_i64(d, obj_get(d, obj_get(d, obj_get(d, r, "lanes"), "bee"), "merged")) == 152;
    assert obj_get(d, r, "missing") == NO_SPAN;
    assert obj_get(d, obj_get(d, r, "days"), "x") == NO_SPAN;
}

test arrays_give_their_length_and_elements {
    const d : []const u8 = "{ \"list\": [1, 22, \"x\", [3, 4], {}] , \"empty\": [] , \"one\": [ 5 ] }";
    const r : i64 = root(d);
    const l : i64 = obj_get(d, r, "list");
    assert arr_len(d, l) == 5;
    assert num_i64(d, arr_at(d, l, 1)) == 22;
    assert kind(d, arr_at(d, l, 2)) == J_STRING;
    assert arr_len(d, arr_at(d, l, 3)) == 2;
    assert num_i64(d, arr_at(d, arr_at(d, l, 3), 1)) == 4;
    assert kind(d, arr_at(d, l, 4)) == J_OBJECT;
    assert arr_at(d, l, 5) == NO_SPAN;
    assert arr_len(d, obj_get(d, r, "empty")) == 0;
    assert arr_len(d, obj_get(d, r, "one")) == 1;
    assert arr_len(d, r) == 0;
}

test strings_decode_their_escapes_to_utf8 {
    const d : []const u8 = "{ \"a\": \"x\\\"y\\\\z\\n\", \"u\": \"\\u00e9\\u20ac\\ud83d\\ude00\" }";
    const r : i64 = root(d);
    const a : i64 = obj_get(d, r, "a");
    assert str_len(d, a) == 6;
    assert str_byte(d, a, 1) == 34;
    assert str_byte(d, a, 3) == 92;
    assert str_byte(d, a, 5) == 10;
    const u : i64 = obj_get(d, r, "u");
    assert str_len(d, u) == 9;
    assert str_byte(d, u, 0) == 195;
    assert str_byte(d, u, 1) == 169;
    assert str_byte(d, u, 2) == 226;
    assert str_byte(d, u, 4) == 172;
    assert str_byte(d, u, 5) == 240;
    assert str_byte(d, u, 8) == 128;
}

test numbers_and_literals_read_like_javascript {
    const d : []const u8 = "{ \"a\": 0.3, \"b\": -17.25, \"c\": 1e3, \"d\": 2.5E-2, \"e\": 12345678, \"f\": true, \"g\": false, \"h\": null }";
    const r : i64 = root(d);
    assert num_f64(d, obj_get(d, r, "a")) == 0.3;
    assert num_f64(d, obj_get(d, r, "b")) == -17.25;
    assert num_f64(d, obj_get(d, r, "c")) == 1000.0;
    assert num_f64(d, obj_get(d, r, "d")) == 0.025;
    assert num_f64("15.042", root("15.042")) == 15.042;
    assert num_f64("7.238", root("7.238")) == 7.238;
    assert num_f64("1.584962500721156", root("1.584962500721156")) == 1.584962500721156;
    assert num_i64(d, obj_get(d, r, "e")) == 12345678;
    assert num_i64(d, obj_get(d, r, "b")) == -17;
    assert is_true(d, obj_get(d, r, "f"));
    assert is_false(d, obj_get(d, r, "g"));
    assert is_null(d, obj_get(d, r, "h"));
    assert is_true(d, obj_get(d, r, "g")) == false;
}

test a_key_is_matched_after_its_escapes_are_decoded {
    const d : []const u8 = "{ \"\\\\gf16_add\": 1, \"a\\u0062c\": 2 }";
    const r : i64 = root(d);
    assert num_i64(d, obj_get(d, r, "\\gf16_add")) == 1;
    assert num_i64(d, obj_get(d, r, "abc")) == 2;
    assert obj_get(d, r, "gf16_add") == NO_SPAN;
}

test a_cut_or_empty_document_has_no_span {
    assert root("") == NO_SPAN;
    assert root("   ") == NO_SPAN;
    assert root("{ \"a\": [1, 2") == NO_SPAN;
    assert obj_get("{ \"a\": 1", root("{ \"a\": 1"), "a") == NO_SPAN;
}
