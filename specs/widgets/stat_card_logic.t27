// SPDX-License-Identifier: Apache-2.0
; specs/widgets/stat_card_logic.t27 -- the stat-card widget's reader: the JSON `yosys stat -json` printed,
; sorted into LUT, FF, DSP, BRAM, other, internal and hier. Ported from trinity
; apps/website/public/widgets/stat-card/statparse.js (127 lines). Epic gHashTag/t27#10937, issue #10938.
; The JavaScript leaned on JSON.parse and on JavaScript objects; this file carries a strict JSON reader
; (the JSON.parse grammar) and the object rules the code used (last duplicate key wins, first position kept).
; --
; JS export    -> t27 function(s)                 note
;   jsonOf     -> trim_bounds, json_top, + the span retry inside stat_parse  (not exported by JS either)
;   parseStat  -> stat_parse(text, lists) + getters (layout below)
;   listsOf    -> NOT ported: it renames the spec constants; the glue writes them into `lists`
;   badgeSvg   -> badge_svg(...) fills a byte buffer; fmt() and xml() are its helpers fmt_into, xml_put
;   bare/topOf/flatten/byTypeOf are not exported by JS; they are by_type_of, bare_off, top selection in
;   analyze, and flat (flatten, one table per recursion level).
; --
; Inputs. text: the UTF-8 bytes. lists: one entry per line (byte 10): a digit then the type; 0 lut,
; 1 ff, 2 dsp, 3 bram, 4 internal, e.g. "0LUT6", "1FDRE", "2DSP48E1", "3RAMB36E1", "4$scopeinfo".
; A type in several lists takes the LAST list (internal wins), as the JS put() order does.
; --
; Result layout. stat_parse(text, lists) -> 0 ok, 1 empty, 2 nojson, 3 badjson, 4 nomodules, 5 nocells,
; 9 a case this port does not carry (below), -1 a table limit. Strings are read from the decoded-string
; pool with st_pool(i); a string is (offset, length) into it.
;   st_info(f): 0 key (0 num_cells_by_type, 1 cells) 1 from (0 design, 1 modules) 2 module count
;     3 type count 4 creator_set 5 creator_off 6 creator_len 7 version_set 8 version_off 9 version_len
;     10 top_set 11 top_off 12 top_len   (creator, version and top are also set for status 5)
;   st_type(i, f): 0 off 1 len 2 group (0 lut 1 ff 2 dsp 3 bram 4 other 5 internal 6 hier)
;   st_n(i) the count of type i (f64); st_group(g) the group totals (f64); st_cells() = lut+ff+dsp+bram+other.
;   badge_svg(label, value_tpl, title_tpl, label_fill, value_fill, char_w, pad, h, font_px, out) -> bytes
;     written to out (the full length even if out is short: compare with out's capacity), -2 when a group
;     total is not a whole number below 1e15 (JS String() of a fraction is not ported), -1 over a limit.
;     It reads the last stat_parse result, like badgeSvg(r, K).
; --
; Not carried, answered with status 9 instead of a wrong card (each is a case yosys never prints):
;   - a count that is a string, array or object (JS would concatenate or coerce: "0"+"5" is "05");
;   - a number that is not exactly rounded here: more than 19 significant digits, a mantissa above 2^53,
;     or a decimal exponent outside -22..22 after dropping trailing zeros (read only when a count uses it);
;   - a lone surrogate escape (\ud800) in a string; an integer-like object key ("7") in an object whose
;     key order matters (JS orders those first); a cell type named like an Object.prototype member
;     (constructor, toString, __proto__ ...), which the JS maps through plain objects;
; Table limits (the JS has none): 131072 JSON nodes, 4 MB of decoded strings, nesting 512, 16384 types,
; 32 module levels of 512 cell types for the expansion.
; Trim and \s use the full JavaScript whitespace set (NBSP, U+2028 ... U+FEFF) on UTF-8; the JSON
; grammar itself allows only space, tab, line feed and carriage return, as JSON.parse does.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_stat_card_logic;

use widgets::page_reader::match_in;
use widgets::page_reader::pack;
use widgets::page_reader::lo_of;
use widgets::page_reader::hi_of;
use widgets::page_reader::NO_TEXT;

pub const K_NULL : u8 = 0;
pub const K_FALSE : u8 = 1;
pub const K_TRUE : u8 = 2;
pub const K_NUM : u8 = 3;
pub const K_STR : u8 = 4;
pub const K_ARR : u8 = 5;
pub const K_OBJ : u8 = 6;

pub const V_PN : usize = 0;
pub const V_NN : usize = 1;
pub const V_UNSUP : usize = 2;
pub const V_JR : usize = 3;
pub const V_JO : usize = 4;
pub const V_JL : usize = 5;
pub const V_ENT : usize = 6;
pub const V_BTK : usize = 7;
pub const V_CAP : usize = 8;
pub const V_BC : usize = 9;
pub const V_NT : usize = 10;
pub const V_AN : usize = 11;
pub const V_AB : usize = 12;

pub var V : [16]u64 = [0; 16];
pub var INF : [16]i64 = [0; 16];
pub var POOL : [4194304]u8 = [0; 4194304];
pub var NK : [131073]u8 = [0; 131073];
pub var NA : [131073]u32 = [0; 131073];
pub var NB : [131073]u32 = [0; 131073];
pub var NX : [131073]u32 = [0; 131073];
pub var KO : [131073]u32 = [0; 131073];
pub var KL : [131073]u32 = [0; 131073];
pub var EST : [131073]u32 = [0; 131073];
pub var ECN : [131073]u32 = [0; 131073];
pub var EIL : [131073]u8 = [0; 131073];
pub var EBU : [131073]u8 = [0; 131073];
pub var EKO : [131073]u32 = [0; 131073];
pub var EKL : [131073]u32 = [0; 131073];
pub var EVN : [131073]u32 = [0; 131073];
pub var EUS : [131073]u8 = [0; 131073];
pub var P10 : [23]f64 = [0.0; 23];
pub var LKO : [16384]u32 = [0; 16384];
pub var LKL : [16384]u32 = [0; 16384];
pub var LVL : [16384]f64 = [0.0; 16384];
pub var LCN : [32]u32 = [0; 32];
pub var SEO : [32]u32 = [0; 32];
pub var SEL : [32]u32 = [0; 32];
pub var TYO : [16384]u32 = [0; 16384];
pub var TYL : [16384]u32 = [0; 16384];
pub var TYN : [16384]f64 = [0.0; 16384];
pub var TYG : [16384]u8 = [0; 16384];
pub var GRP : [8]f64 = [0.0; 8];
pub var CELLS : [2]f64 = [0.0; 2];
pub var VAL : [2048]u8 = [0; 2048];
pub var TIT : [4096]u8 = [0; 4096];
pub var ARB : [4096]u8 = [0; 4096];
pub var ARO : [8]u32 = [0; 8];
pub var ARL : [8]u32 = [0; 8];

// ---------------------------------------------------------------- bytes and whitespace
/// The length of the JavaScript whitespace character at s[p ..] (0 when none), UTF-8.
pub fn ws_len_at(s: []const u8, p: usize, hi: usize) -> usize {
    if (p >= hi) { return 0; }
    const b : u8 = s[p];
    if (b == 32 or (b >= 9 and b <= 13)) { return 1; }
    if (b == 194 and p + 1 < hi and s[p + 1] == 160) { return 2; }
    if (p + 3 <= hi) {
        const b1 : u8 = s[p + 1];
        const b2 : u8 = s[p + 2];
        if (b == 225 and b1 == 154 and b2 == 128) { return 3; }
        if (b == 226 and b1 == 128 and ((b2 >= 128 and b2 <= 138) or b2 == 168 or b2 == 169 or b2 == 175)) { return 3; }
        if (b == 226 and b1 == 129 and b2 == 159) { return 3; }
        if (b == 227 and b1 == 128 and b2 == 128) { return 3; }
        if (b == 239 and b1 == 187 and b2 == 191) { return 3; }
    }
    return 0;
}

/// The length of the JavaScript whitespace character that ends at e.
pub fn ws_len_before(s: []const u8, lo: usize, e: usize) -> usize {
    if (e > lo and ws_len_at(s, e - 1, e) == 1) { return 1; }
    if (e >= lo + 2 and ws_len_at(s, e - 2, e) == 2) { return 2; }
    if (e >= lo + 3 and ws_len_at(s, e - 3, e) == 3) { return 3; }
    return 0;
}

/// String.prototype.trim: the packed [lo, hi).
pub fn trim_bounds(s: []const u8) -> i64 {
    var lo : usize = 0;
    var hi : usize = s.len;
    var w : usize = ws_len_at(s, lo, hi);
    while (w > 0) {
        lo = lo + w;
        w = ws_len_at(s, lo, hi);
    }
    w = ws_len_before(s, lo, hi);
    while (w > 0) {
        hi = hi - w;
        w = ws_len_before(s, lo, hi);
    }
    return pack(lo, hi);
}

pub fn jws(s: []const u8, p0: usize, hi: usize) -> usize {
    var p : usize = p0;
    while (p < hi and (s[p] == 32 or s[p] == 9 or s[p] == 10 or s[p] == 13)) { p = p + 1; }
    return p;
}

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

pub fn hexv(b: u8) -> i64 {
    if (b >= 48 and b <= 57) { return (b - 48) as i64; }
    if (b >= 97 and b <= 102) { return (b - 87) as i64; }
    if (b >= 65 and b <= 70) { return (b - 55) as i64; }
    return -1;
}

/// Four hex digits at s[p ..], or -1.
pub fn hex4(s: []const u8, p: usize, hi: usize) -> i64 {
    if (p + 4 > hi) { return -1; }
    var v : i64 = 0;
    var k : usize = 0;
    while (k < 4) {
        const h : i64 = hexv(s[p + k]);
        if (h < 0) { return -1; }
        v = v * 16 + h;
        k = k + 1;
    }
    return v;
}

// ---------------------------------------------------------------- the string pool
pub fn pool_put(b: u8) -> bool {
    if (V[V_PN] >= 4194300) { return false; }
    POOL[V[V_PN] as usize] = b;
    V[V_PN] = V[V_PN] + 1;
    return true;
}

pub fn put_utf8(cp: u32) -> bool {
    if (cp < 128) { return pool_put(cp as u8); }
    if (cp < 2048) {
        if (!pool_put((192 + cp / 64) as u8)) { return false; }
        return pool_put((128 + cp % 64) as u8);
    }
    if (cp < 65536) {
        if (!pool_put((224 + cp / 4096) as u8)) { return false; }
        if (!pool_put((128 + (cp / 64) % 64) as u8)) { return false; }
        return pool_put((128 + cp % 64) as u8);
    }
    if (!pool_put((240 + cp / 262144) as u8)) { return false; }
    if (!pool_put((128 + (cp / 4096) % 64) as u8)) { return false; }
    if (!pool_put((128 + (cp / 64) % 64) as u8)) { return false; }
    return pool_put((128 + cp % 64) as u8);
}

pub fn pool_put_u(k0: u64) -> bool {
    var digits : u64 = 1;
    var t : u64 = k0;
    while (t >= 10) {
        t = t / 10;
        digits = digits * 10;
    }
    var d : u64 = digits;
    var r : u64 = k0;
    while (d > 0) {
        if (!pool_put((48 + r / d) as u8)) { return false; }
        r = r % d;
        d = d / 10;
    }
    return true;
}

pub fn pool_eq(a: u32, al: u32, b: u32, bl: u32) -> bool {
    if (al != bl) { return false; }
    var k : u32 = 0;
    while (k < al) {
        if (POOL[(a + k) as usize] != POOL[(b + k) as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn pool_is(a: u32, al: u32, w: []const u8) -> bool {
    if (al as usize != w.len) { return false; }
    var k : u32 = 0;
    while (k < al) {
        if (POOL[(a + k) as usize] != w[k as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

/// bare(): the start and length of a pool string without one leading backslash.
pub fn bare_off(o: u32, l: u32) -> u32 {
    if (l > 0 and POOL[o as usize] == 92) { return o + 1; }
    return o;
}

pub fn bare_len(o: u32, l: u32) -> u32 {
    if (l > 0 and POOL[o as usize] == 92) { return l - 1; }
    return l;
}

// ---------------------------------------------------------------- the JSON reader (JSON.parse grammar)
pub fn esc_byte(e: u8) -> i32 {
    if (e == 34) { return 34; }
    if (e == 92) { return 92; }
    if (e == 47) { return 47; }
    if (e == 98) { return 8; }
    if (e == 102) { return 12; }
    if (e == 110) { return 10; }
    if (e == 114) { return 13; }
    if (e == 116) { return 9; }
    return -1;
}

/// A string starting at the quote p: decoded into the pool (V_JO, V_JL); the end, -1 syntax, -3 limit.
pub fn jstring(s: []const u8, p: usize, hi: usize) -> i64 {
    var q : usize = p + 1;
    V[V_JO] = V[V_PN];
    while (q < hi) {
        const b : u8 = s[q];
        if (b == 34) {
            V[V_JL] = V[V_PN] - V[V_JO];
            return (q + 1) as i64;
        }
        if (b < 32) { return -1; }
        if (b == 92) {
            if (q + 1 >= hi) { return -1; }
            const e : u8 = s[q + 1];
            const sb : i32 = esc_byte(e);
            if (sb >= 0) {
                if (!pool_put(sb as u8)) { return -3; }
                q = q + 2;
            } else {
                if (e != 117) { return -1; }
                const h : i64 = hex4(s, q + 2, hi);
                if (h < 0) { return -1; }
                var cp : u32 = h as u32;
                q = q + 6;
                var emit : bool = true;
                if (cp >= 55296 and cp <= 56319) {
                    emit = false;
                    if (q + 6 <= hi and s[q] == 92 and s[q + 1] == 117) {
                        const l : i64 = hex4(s, q + 2, hi);
                        if (l >= 56320 and l <= 57343) {
                            cp = 65536 + (cp - 55296) * 1024 + ((l as u32) - 56320);
                            q = q + 6;
                            emit = true;
                        }
                    }
                    if (!emit) { V[V_UNSUP] = 1; }
                } else {
                    if (cp >= 56320 and cp <= 57343) {
                        emit = false;
                        V[V_UNSUP] = 1;
                    }
                }
                if (emit) {
                    if (!put_utf8(cp)) { return -3; }
                }
            }
        } else {
            if (!pool_put(b)) { return -3; }
            q = q + 1;
        }
    }
    return -1;
}

/// A number starting at p (JSON grammar): the end, or -1.
pub fn jnumber(s: []const u8, p0: usize, hi: usize) -> i64 {
    var p : usize = p0;
    if (p < hi and s[p] == 45) { p = p + 1; }
    if (p >= hi) { return -1; }
    if (s[p] == 48) {
        p = p + 1;
    } else {
        if (s[p] < 49 or s[p] > 57) { return -1; }
        while (p < hi and is_digit(s[p])) { p = p + 1; }
    }
    if (p < hi and s[p] == 46) {
        p = p + 1;
        if (p >= hi or !is_digit(s[p])) { return -1; }
        while (p < hi and is_digit(s[p])) { p = p + 1; }
    }
    if (p < hi and (s[p] == 101 or s[p] == 69)) {
        p = p + 1;
        if (p < hi and (s[p] == 43 or s[p] == 45)) { p = p + 1; }
        if (p >= hi or !is_digit(s[p])) { return -1; }
        while (p < hi and is_digit(s[p])) { p = p + 1; }
    }
    return p as i64;
}

pub fn alloc_node(kind: u8) -> usize {
    if (V[V_NN] >= 131072) { return 0; }
    V[V_NN] = V[V_NN] + 1;
    const n : usize = V[V_NN] as usize;
    NK[n] = kind;
    NA[n] = 0;
    NB[n] = 0;
    NX[n] = 0;
    KO[n] = 0;
    KL[n] = 0;
    EBU[n] = 0;
    return n;
}

/// A value at p (no leading space): the end, -1 syntax, -3 limit. The node is left in V_JR.
pub fn jvalue(s: []const u8, p: usize, hi: usize, depth: u32) -> i64 {
    if (p >= hi) { return -1; }
    const b : u8 = s[p];
    if (b == 34) {
        const r : i64 = jstring(s, p, hi);
        if (r < 0) { return r; }
        const n : usize = alloc_node(K_STR);
        if (n == 0) { return -3; }
        NA[n] = V[V_JO] as u32;
        NB[n] = V[V_JL] as u32;
        V[V_JR] = n as u64;
        return r;
    }
    if (b == 45 or is_digit(b)) {
        const r : i64 = jnumber(s, p, hi);
        if (r < 0) { return r; }
        const n : usize = alloc_node(K_NUM);
        if (n == 0) { return -3; }
        NA[n] = p as u32;
        NB[n] = r as u32;
        V[V_JR] = n as u64;
        return r;
    }
    if (b == 116) {
        if (!match_in(s, p, hi, "true")) { return -1; }
        const n : usize = alloc_node(K_TRUE);
        if (n == 0) { return -3; }
        V[V_JR] = n as u64;
        return (p + 4) as i64;
    }
    if (b == 102) {
        if (!match_in(s, p, hi, "false")) { return -1; }
        const n : usize = alloc_node(K_FALSE);
        if (n == 0) { return -3; }
        V[V_JR] = n as u64;
        return (p + 5) as i64;
    }
    if (b == 110) {
        if (!match_in(s, p, hi, "null")) { return -1; }
        const n : usize = alloc_node(K_NULL);
        if (n == 0) { return -3; }
        V[V_JR] = n as u64;
        return (p + 4) as i64;
    }
    if (b != 91 and b != 123) { return -1; }
    if (depth >= 512) { return -3; }
    const isobj : bool = b == 123;
    var kind : u8 = K_ARR;
    var close : u8 = 93;
    if (isobj) {
        kind = K_OBJ;
        close = 125;
    }
    const n : usize = alloc_node(kind);
    if (n == 0) { return -3; }
    var q : usize = jws(s, p + 1, hi);
    if (q < hi and s[q] == close) {
        V[V_JR] = n as u64;
        return (q + 1) as i64;
    }
    var last : usize = 0;
    var more : bool = true;
    while (more) {
        var ko : u64 = 0;
        var kl : u64 = 0;
        if (isobj) {
            if (q >= hi or s[q] != 34) { return -1; }
            const kr : i64 = jstring(s, q, hi);
            if (kr < 0) { return kr; }
            ko = V[V_JO];
            kl = V[V_JL];
            q = jws(s, kr as usize, hi);
            if (q >= hi or s[q] != 58) { return -1; }
            q = jws(s, q + 1, hi);
        }
        const vr : i64 = jvalue(s, q, hi, depth + 1);
        if (vr < 0) { return vr; }
        const c : usize = V[V_JR] as usize;
        KO[c] = ko as u32;
        KL[c] = kl as u32;
        if (last == 0) { NA[n] = c as u32; } else { NX[last] = c as u32; }
        last = c;
        NB[n] = NB[n] + 1;
        q = jws(s, vr as usize, hi);
        if (q >= hi) { return -1; }
        if (s[q] == 44) {
            q = jws(s, q + 1, hi);
        } else {
            if (s[q] != close) { return -1; }
            more = false;
        }
    }
    V[V_JR] = n as u64;
    return (q + 1) as i64;
}

/// JSON.parse over s[lo..hi): 0 ok (root in V_JR), 1 syntax error, -1 a table limit.
pub fn json_top(s: []const u8, lo: usize, hi: usize) -> i32 {
    V[V_PN] = 0;
    V[V_NN] = 0;
    V[V_ENT] = 0;
    V[V_UNSUP] = 0;
    const r : i64 = jvalue(s, jws(s, lo, hi), hi, 0);
    if (r == -3) { return -1; }
    if (r < 0) { return 1; }
    if (jws(s, r as usize, hi) != hi) { return 1; }
    return 0;
}

// ---------------------------------------------------------------- objects as JavaScript sees them
/// An array index key: "0", or digits without a leading zero, at most 4294967294.
pub fn intlike(o: u32, l: u32) -> bool {
    if (l == 0 or l > 10) { return false; }
    if (l > 1 and POOL[o as usize] == 48) { return false; }
    var v : u64 = 0;
    var k : u32 = 0;
    while (k < l) {
        const b : u8 = POOL[(o + k) as usize];
        if (!is_digit(b)) { return false; }
        v = v * 10 + ((b - 48) as u64);
        k = k + 1;
    }
    return v <= 4294967294;
}

/// The entries of an object (distinct keys in first-appearance order, the last duplicate's value) or
/// an array (index keys), built once per node. False over the table limit.
pub fn ent_build(n: usize) -> bool {
    if (EBU[n] == 1) { return true; }
    const start : usize = V[V_ENT] as usize;
    var cnt : usize = 0;
    var il : u8 = 0;
    var c : usize = NA[n] as usize;
    var k : u64 = 0;
    while (c != 0) {
        if (start + cnt >= 131072) { V[V_CAP] = 1; return false; }
        if (NK[n] == K_ARR) {
            const o : u64 = V[V_PN];
            if (!pool_put_u(k)) { V[V_CAP] = 1; return false; }
            EKO[start + cnt] = o as u32;
            EKL[start + cnt] = (V[V_PN] - o) as u32;
            EVN[start + cnt] = c as u32;
            cnt = cnt + 1;
        } else {
            var j : usize = 0;
            var found : bool = false;
            while (j < cnt and !found) {
                if (pool_eq(EKO[start + j], EKL[start + j], KO[c], KL[c])) {
                    EVN[start + j] = c as u32;
                    found = true;
                }
                j = j + 1;
            }
            if (!found) {
                if (intlike(KO[c], KL[c])) { il = 1; }
                EKO[start + cnt] = KO[c];
                EKL[start + cnt] = KL[c];
                EVN[start + cnt] = c as u32;
                cnt = cnt + 1;
            }
        }
        c = NX[c] as usize;
        k = k + 1;
    }
    V[V_ENT] = (start + cnt) as u64;
    EST[n] = start as u32;
    ECN[n] = cnt as u32;
    EIL[n] = il;
    EBU[n] = 1;
    return true;
}

/// obj.key for an object node: the last member with that key, or 0.
pub fn obj_get(n: usize, w: []const u8) -> usize {
    if (n == 0 or NK[n] != K_OBJ) { return 0; }
    var c : usize = NA[n] as usize;
    var r : usize = 0;
    while (c != 0) {
        if (pool_is(KO[c], KL[c], w)) { r = c; }
        c = NX[c] as usize;
    }
    return r;
}

/// byTypeOf: the map node (num_cells_by_type, else cells) of a module node, or 0. V_BTK says which.
pub fn by_type_of(m: usize) -> usize {
    if (m == 0 or NK[m] != K_OBJ) { return 0; }
    const a : usize = obj_get(m, "num_cells_by_type");
    if (a != 0 and (NK[a] == K_ARR or NK[a] == K_OBJ)) {
        V[V_BTK] = 0;
        return a;
    }
    const b : usize = obj_get(m, "cells");
    if (b != 0 and (NK[b] == K_ARR or NK[b] == K_OBJ)) {
        V[V_BTK] = 1;
        return b;
    }
    return 0;
}

/// Names that JavaScript finds on every plain object.
pub fn proto_name(o: u32, l: u32) -> bool {
    if (pool_is(o, l, "constructor")) { return true; }
    if (pool_is(o, l, "__proto__")) { return true; }
    if (pool_is(o, l, "toString")) { return true; }
    if (pool_is(o, l, "valueOf")) { return true; }
    if (pool_is(o, l, "hasOwnProperty")) { return true; }
    if (pool_is(o, l, "isPrototypeOf")) { return true; }
    if (pool_is(o, l, "propertyIsEnumerable")) { return true; }
    if (pool_is(o, l, "toLocaleString")) { return true; }
    if (pool_is(o, l, "__defineGetter__")) { return true; }
    if (pool_is(o, l, "__defineSetter__")) { return true; }
    if (pool_is(o, l, "__lookupGetter__")) { return true; }
    if (pool_is(o, l, "__lookupSetter__")) { return true; }
    return false;
}

// ---------------------------------------------------------------- numbers
/// The value of a JSON number s[lo..hi) when it is exactly rounded here (see the header), else flags V_UNSUP.
pub fn num_val(s: []const u8, lo: usize, hi: usize) -> f64 {
    var p : usize = lo;
    var neg : bool = false;
    if (s[p] == 45) {
        neg = true;
        p = p + 1;
    }
    var m : u64 = 0;
    var nd : u32 = 0;
    var e10 : i64 = 0;
    var bad : bool = false;
    while (p < hi and is_digit(s[p])) {
        const d : u64 = (s[p] - 48) as u64;
        if (m == 0 and d == 0) {
            m = 0;
        } else {
            if (nd < 19) {
                m = m * 10 + d;
                nd = nd + 1;
            } else {
                bad = true;
            }
        }
        p = p + 1;
    }
    if (p < hi and s[p] == 46) {
        p = p + 1;
        while (p < hi and is_digit(s[p])) {
            const d : u64 = (s[p] - 48) as u64;
            if (m == 0 and d == 0) {
                m = 0;
            } else {
                if (nd < 19) {
                    m = m * 10 + d;
                    nd = nd + 1;
                } else {
                    bad = true;
                }
            }
            e10 = e10 - 1;
            p = p + 1;
        }
    }
    if (p < hi and (s[p] == 101 or s[p] == 69)) {
        p = p + 1;
        var eneg : bool = false;
        if (p < hi and (s[p] == 43 or s[p] == 45)) {
            eneg = s[p] == 45;
            p = p + 1;
        }
        var ev : i64 = 0;
        while (p < hi and is_digit(s[p])) {
            if (ev < 100000) { ev = ev * 10 + ((s[p] - 48) as i64); }
            p = p + 1;
        }
        if (eneg) { e10 = e10 - ev; } else { e10 = e10 + ev; }
    }
    if (m == 0) { return 0.0; }
    if (bad) {
        V[V_UNSUP] = 1;
        return 0.0;
    }
    while (m % 10 == 0) {
        m = m / 10;
        e10 = e10 + 1;
    }
    if (m > 9007199254740992 or e10 > 22 or e10 < -22) {
        V[V_UNSUP] = 1;
        return 0.0;
    }
    var v : f64 = m as f64;
    if (e10 > 0) { v = v * P10[e10 as usize]; }
    if (e10 < 0) { v = v / P10[(0 - e10) as usize]; }
    if (neg) { return 0.0 - v; }
    return v;
}

/// Number(value) for the kinds this port carries; a string, array or object flags V_UNSUP.
pub fn conv(s: []const u8, n: usize) -> f64 {
    const k : u8 = NK[n];
    if (k == K_NULL or k == K_FALSE) { return 0.0; }
    if (k == K_TRUE) { return 1.0; }
    if (k == K_NUM) { return num_val(s, NA[n] as usize, NB[n] as usize); }
    V[V_UNSUP] = 1;
    return 0.0;
}

/// Number(n) || 0
pub fn num_or_zero(v: f64) -> f64 {
    if (v != v or v == 0.0) { return 0.0; }
    return v;
}

// ---------------------------------------------------------------- the analysis
pub fn find_module(ms: usize, mc: usize, o: u32, l: u32) -> i64 {
    var j : usize = 0;
    while (j < mc) {
        if (pool_eq(bare_off(EKO[ms + j], EKL[ms + j]), bare_len(EKO[ms + j], EKL[ms + j]), o, l)) { return j as i64; }
        j = j + 1;
    }
    return -1;
}

/// out[ct] = (out[ct] ?? 0) + x in the table of this level.
pub fn lvl_add(level: usize, o: u32, l: u32, x: f64) -> bool {
    const base : usize = level * 512;
    const cnt : usize = LCN[level] as usize;
    var j : usize = 0;
    while (j < cnt) {
        if (pool_eq(LKO[base + j], LKL[base + j], o, l)) {
            LVL[base + j] = LVL[base + j] + x;
            return true;
        }
        j = j + 1;
    }
    if (cnt >= 512) { return false; }
    if (intlike(o, l)) { V[V_UNSUP] = 1; }
    LKO[base + cnt] = o;
    LKL[base + cnt] = l;
    LVL[base + cnt] = 0.0 + x;
    LCN[level] = (cnt + 1) as u32;
    return true;
}

/// flatten(modules, name, seen) for the module at entry mi, into the table of `level`. 0 ok, -1 limit.
pub fn flat(s: []const u8, level: usize, mi: usize, ms: usize, mc: usize) -> i32 {
    if (level >= 32) { V[V_CAP] = 1; return -1; }
    LCN[level] = 0;
    const o : u32 = bare_off(EKO[mi], EKL[mi]);
    const l : u32 = bare_len(EKO[mi], EKL[mi]);
    const mp : usize = by_type_of(EVN[mi] as usize);
    if (mp == 0) { return 0; }
    var k : usize = 0;
    while (k < level) {
        if (pool_eq(SEO[k], SEL[k], o, l)) { return 0; }
        k = k + 1;
    }
    SEO[level] = o;
    SEL[level] = l;
    if (!ent_build(mp)) { return -1; }
    if (EIL[mp] == 1) { V[V_UNSUP] = 1; }
    const es : usize = EST[mp] as usize;
    const ec : usize = ECN[mp] as usize;
    var i : usize = 0;
    while (i < ec) {
        const to : u32 = EKO[es + i];
        const tl : u32 = EKL[es + i];
        const vn : usize = EVN[es + i] as usize;
        if (proto_name(to, tl)) { V[V_UNSUP] = 1; }
        const j : i64 = find_module(ms, mc, bare_off(to, tl), bare_len(to, tl));
        if (j >= 0) {
            const r : i32 = flat(s, level + 1, ms + (j as usize), ms, mc);
            if (r < 0) { return r; }
            var c : usize = 0;
            while (c < (LCN[level + 1] as usize)) {
                const n : f64 = conv(s, vn);
                const x : f64 = n * LVL[(level + 1) * 512 + c];
                if (!lvl_add(level, LKO[(level + 1) * 512 + c], LKL[(level + 1) * 512 + c], x)) { V[V_CAP] = 1; return -1; }
                c = c + 1;
            }
        } else {
            const n : f64 = conv(s, vn);
            if (!lvl_add(level, to, tl, n)) { V[V_CAP] = 1; return -1; }
        }
        i = i + 1;
    }
    return 0;
}

/// The group of a type: the last list that holds it, else hier for a module name, else other.
pub fn group_of(o: u32, l: u32, lists: []const u8, ms: usize, mc: usize) -> u8 {
    var best : i32 = -1;
    var a : usize = 0;
    while (a < lists.len) {
        var e : usize = a;
        while (e < lists.len and lists[e] != 10) { e = e + 1; }
        if (e > a + 1 and lists[a] >= 48 and lists[a] <= 52 and e - a - 1 == l as usize) {
            var same : bool = true;
            var k : usize = 0;
            while (k < l as usize) {
                if (lists[a + 1 + k] != POOL[(o as usize) + k]) { same = false; }
                k = k + 1;
            }
            if (same) {
                const c : i32 = (lists[a] - 48) as i32;
                if (c > best) { best = c; }
            }
        }
        a = e + 1;
    }
    if (best == 4) { return 5; }
    if (best >= 0) { return best as u8; }
    if (find_module(ms, mc, bare_off(o, l), bare_len(o, l)) >= 0) { return 6; }
    return 4;
}

pub fn fin(code: i32) -> i32 {
    if (V[V_CAP] == 1) { return -1; }
    if (V[V_UNSUP] == 1) { return 9; }
    return code;
}

/// The part of parseStat after JSON.parse: the root is in V_JR.
pub fn analyze(s: []const u8, lists: []const u8) -> i32 {
    const root : usize = V[V_JR] as usize;
    if (NK[root] != K_OBJ) { return 4; }
    const modn : usize = obj_get(root, "modules");
    if (modn == 0 or (NK[modn] != K_ARR and NK[modn] != K_OBJ)) { return 4; }
    if (!ent_build(modn)) { return -1; }
    const ms : usize = EST[modn] as usize;
    const mc : usize = ECN[modn] as usize;
    if (EIL[modn] == 1) { V[V_UNSUP] = 1; }
    INF[2] = mc as i64;
    const cn : usize = obj_get(root, "creator");
    if (cn != 0 and NK[cn] == K_STR) {
        INF[4] = 1;
        INF[5] = NA[cn] as i64;
        INF[6] = NB[cn] as i64;
        if (NB[cn] > 0) {
            const cv : []const u8 = POOL[0 .. 4194304];
            const co : usize = NA[cn] as usize;
            const ce : usize = co + (NB[cn] as usize);
            if (match_in(cv, co, ce, "Yosys")) {
                var p : usize = co + 5;
                const w0 : usize = p;
                var w : usize = ws_len_at(cv, p, ce);
                while (w > 0) {
                    p = p + w;
                    w = ws_len_at(cv, p, ce);
                }
                if (p > w0) {
                    var t : usize = p;
                    while (t < ce and ws_len_at(cv, t, ce) == 0) { t = t + 1; }
                    if (t > p) {
                        INF[7] = 1;
                        INF[8] = p as i64;
                        INF[9] = (t - p) as i64;
                    }
                }
            }
        }
    }
    // topOf
    var j : usize = 0;
    while (j < mc) {
        EUS[ms + j] = 0;
        j = j + 1;
    }
    j = 0;
    while (j < mc) {
        const mp : usize = by_type_of(EVN[ms + j] as usize);
        if (mp != 0) {
            if (!ent_build(mp)) { return -1; }
            var t : usize = 0;
            while (t < (ECN[mp] as usize)) {
                const to : u32 = EKO[(EST[mp] as usize) + t];
                const tl : u32 = EKL[(EST[mp] as usize) + t];
                var k : usize = 0;
                while (k < mc) {
                    if (pool_eq(bare_off(EKO[ms + k], EKL[ms + k]), bare_len(EKO[ms + k], EKL[ms + k]), bare_off(to, tl), bare_len(to, tl))) { EUS[ms + k] = 1; }
                    k = k + 1;
                }
                t = t + 1;
            }
        }
        j = j + 1;
    }
    var ti : usize = 0;
    var have_top : bool = false;
    j = 0;
    while (j < mc and !have_top) {
        if (EUS[ms + j] == 0) {
            ti = j;
            have_top = true;
        }
        j = j + 1;
    }
    if (!have_top and mc > 0) {
        ti = 0;
        have_top = true;
    }
    var top_len : u32 = 0;
    if (have_top) {
        INF[10] = 1;
        INF[2] = mc as i64;
        INF[12] = bare_len(EKO[ms + ti], EKL[ms + ti]) as i64;
        INF[11] = bare_off(EKO[ms + ti], EKL[ms + ti]) as i64;
        top_len = bare_len(EKO[ms + ti], EKL[ms + ti]);
    }
    // the map
    const dn : usize = obj_get(root, "design");
    const dmap : usize = by_type_of(dn);
    var nt : usize = 0;
    if (dmap != 0) {
        INF[0] = V[V_BTK] as i64;
        INF[1] = 0;
        if (!ent_build(dmap)) { return -1; }
        if (EIL[dmap] == 1) { V[V_UNSUP] = 1; }
        const es : usize = EST[dmap] as usize;
        var i : usize = 0;
        while (i < (ECN[dmap] as usize)) {
            if (nt >= 16384) { V[V_CAP] = 1; return fin(0); }
            if (proto_name(EKO[es + i], EKL[es + i])) { V[V_UNSUP] = 1; }
            TYO[nt] = EKO[es + i];
            TYL[nt] = EKL[es + i];
            TYN[nt] = num_or_zero(conv(s, EVN[es + i] as usize));
            nt = nt + 1;
            i = i + 1;
        }
    } else {
        if (!have_top or top_len == 0) { return fin(5); }
        const bt : usize = by_type_of(EVN[ms + ti] as usize);
        if (bt == 0) { return fin(5); }
        INF[0] = V[V_BTK] as i64;
        INF[1] = 1;
        const fr : i32 = flat(s, 0, ms + ti, ms, mc);
        if (fr < 0) { return -1; }
        var i : usize = 0;
        while (i < (LCN[0] as usize)) {
            if (nt >= 16384) { V[V_CAP] = 1; return fin(0); }
            TYO[nt] = LKO[i];
            TYL[nt] = LKL[i];
            TYN[nt] = num_or_zero(LVL[i]);
            nt = nt + 1;
            i = i + 1;
        }
    }
    var g : usize = 0;
    while (g < 8) {
        GRP[g] = 0.0;
        g = g + 1;
    }
    var i2 : usize = 0;
    while (i2 < nt) {
        const gc : u8 = group_of(TYO[i2], TYL[i2], lists, ms, mc);
        TYG[i2] = gc;
        GRP[gc as usize] = GRP[gc as usize] + TYN[i2];
        i2 = i2 + 1;
    }
    CELLS[0] = GRP[0] + GRP[1] + GRP[2] + GRP[3] + GRP[4];
    INF[3] = nt as i64;
    return fin(0);
}

/// parseStat. 0 ok, 1 empty, 2 nojson, 3 badjson, 4 nomodules, 5 nocells, 9 not carried, -1 a table limit.
pub fn stat_parse(text: []const u8, lists: []const u8) -> i32 {
    var f : usize = 0;
    while (f < 16) {
        INF[f] = 0;
        V[f] = 0;
        f = f + 1;
    }
    P10[0] = 1.0;
    var e : usize = 1;
    while (e < 23) {
        P10[e] = P10[e - 1] * 10.0;
        e = e + 1;
    }
    const tb : i64 = trim_bounds(text);
    const tl : usize = lo_of(tb);
    const th : usize = hi_of(tb);
    if (tl == th) { return 1; }
    var st : i32 = json_top(text, tl, th);
    if (st < 0) { return -1; }
    if (st == 1) {
        var a : usize = tl;
        while (a < th and text[a] != 123) { a = a + 1; }
        var b : usize = th;
        while (b > tl and text[b - 1] != 125) { b = b - 1; }
        if (a >= th or b == tl or b - 1 <= a) { return 2; }
        st = json_top(text, a, b);
        if (st < 0) { return -1; }
        if (st == 1) { return 3; }
    }
    if (V[V_UNSUP] == 1) { return 9; }
    return analyze(text, lists);
}

pub fn st_info(f: u32) -> i64 {
    return INF[f as usize];
}

pub fn st_type(i: u32, f: u32) -> i64 {
    if (f == 0) { return TYO[i as usize] as i64; }
    if (f == 1) { return TYL[i as usize] as i64; }
    return TYG[i as usize] as i64;
}

pub fn st_n(i: u32) -> f64 {
    return TYN[i as usize];
}

pub fn st_group(g: u32) -> f64 {
    return GRP[g as usize];
}

pub fn st_cells() -> f64 {
    return CELLS[0];
}

pub fn st_pool(i: u32) -> u8 {
    return POOL[i as usize];
}

// ---------------------------------------------------------------- badgeSvg
pub fn bput(out: []u8, b: u8) -> bool {
    const c : usize = V[V_BC] as usize;
    if (c < out.len) { out[c] = b; }
    V[V_BC] = V[V_BC] + 1;
    return true;
}

pub fn bputs(out: []u8, w: []const u8) -> bool {
    var k : usize = 0;
    while (k < w.len) {
        bput(out, w[k]);
        k = k + 1;
    }
    return true;
}

pub fn bput_u(out: []u8, k0: u64) -> bool {
    var digits : u64 = 1;
    var t : u64 = k0;
    while (t >= 10) {
        t = t / 10;
        digits = digits * 10;
    }
    var d : u64 = digits;
    var r : u64 = k0;
    while (d > 0) {
        bput(out, (48 + r / d) as u8);
        r = r % d;
        d = d / 10;
    }
    return true;
}

/// xml(): & < > " escaped, one pass.
pub fn xml_put(out: []u8, w: []const u8, lo: usize, hi: usize) -> bool {
    var k : usize = lo;
    while (k < hi) {
        const b : u8 = w[k];
        if (b == 38) { bputs(out, "&amp;"); }
        else { if (b == 60) { bputs(out, "&lt;"); }
        else { if (b == 62) { bputs(out, "&gt;"); }
        else { if (b == 34) { bputs(out, "&quot;"); }
        else { bput(out, b); } } } }
        k = k + 1;
    }
    return true;
}

/// The UTF-16 length of a UTF-8 string (JS .length).
pub fn utf16_len(w: []const u8, lo: usize, hi: usize) -> u64 {
    var n : u64 = 0;
    var k : usize = lo;
    while (k < hi) {
        const b : u8 = w[k];
        if (b < 128 or b >= 192) { n = n + 1; }
        if (b >= 240) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

/// fmt(): {0} {1} ... replaced by the arguments in ARB; an index with no argument becomes nothing.
/// Writes into dst; returns the length, or -1 when dst is too small.
pub fn fmt_into(dst: []u8, tpl: []const u8, nargs: u32) -> i64 {
    var n : usize = 0;
    var k : usize = 0;
    while (k < tpl.len) {
        var done : bool = false;
        if (tpl[k] == 123) {
            var q : usize = k + 1;
            var idx : u64 = 0;
            while (q < tpl.len and is_digit(tpl[q])) {
                if (idx < 100000) { idx = idx * 10 + ((tpl[q] - 48) as u64); }
                q = q + 1;
            }
            if (q > k + 1 and q < tpl.len and tpl[q] == 125) {
                if (idx < (nargs as u64)) {
                    var a : usize = 0;
                    while (a < (ARL[idx as usize] as usize)) {
                        if (n >= dst.len) { return -1; }
                        dst[n] = ARB[(ARO[idx as usize] as usize) + a];
                        n = n + 1;
                        a = a + 1;
                    }
                }
                k = q + 1;
                done = true;
            }
        }
        if (!done) {
            if (n >= dst.len) { return -1; }
            dst[n] = tpl[k];
            n = n + 1;
            k = k + 1;
        }
    }
    return n as i64;
}

/// Append an argument (bytes) to ARB as argument number i; the cursor is the end of the last one.
pub fn arg_set(i: usize, w: []const u8, lo: usize, hi: usize) -> bool {
    var at : usize = 0;
    if (i > 0) { at = (ARO[i - 1] + ARL[i - 1]) as usize; }
    if (at + (hi - lo) > 4096) { return false; }
    ARO[i] = at as u32;
    ARL[i] = (hi - lo) as u32;
    var k : usize = lo;
    while (k < hi) {
        ARB[at + (k - lo)] = w[k];
        k = k + 1;
    }
    return true;
}

/// A whole number below 1e15 as decimal text into ARB as argument i; false when it is not one.
pub fn arg_num(i: usize, x: f64) -> bool {
    if (x != x or x >= 1000000000000000.0 or x <= -1000000000000000.0) { return false; }
    const t : i64 = x as i64;
    if ((t as f64) != x) { return false; }
    var at : usize = 0;
    if (i > 0) { at = (ARO[i - 1] + ARL[i - 1]) as usize; }
    ARO[i] = at as u32;
    var neg : bool = t < 0;
    var u : u64 = 0;
    if (neg) { u = (0 - t) as u64; } else { u = t as u64; }
    var digits : u64 = 1;
    var q : u64 = u;
    while (q >= 10) {
        q = q / 10;
        digits = digits * 10;
    }
    var n : usize = 0;
    if (neg) {
        ARB[at] = 45;
        n = 1;
    }
    var d : u64 = digits;
    var r : u64 = u;
    while (d > 0) {
        ARB[at + n] = (48 + r / d) as u8;
        n = n + 1;
        r = r % d;
        d = d / 10;
    }
    ARL[i] = n as u32;
    return true;
}

/// Math.round for a non-negative number: floor(x + 0.5) without the 0.49999999999999994 trap.
pub fn js_round(x: f64) -> i64 {
    const f : i64 = x as i64;
    if (x - (f as f64) >= 0.5) { return f + 1; }
    return f;
}

pub fn badge_svg(label: []const u8, value_tpl: []const u8, title_tpl: []const u8, label_fill: []const u8, value_fill: []const u8, cw: i64, pad: i64, h: i64, font_px: i64, out: []u8) -> i64 {
    if (!arg_num(0, GRP[0])) { return -2; }
    if (!arg_num(1, GRP[1])) { return -2; }
    if (!arg_num(2, GRP[2])) { return -2; }
    if (!arg_num(3, GRP[3])) { return -2; }
    const vl : i64 = fmt_into(VAL[0 .. 2048], value_tpl, 4);
    if (vl < 0) { return -1; }
    const vlen : usize = vl as usize;
    // title args: value, top, version
    var ok : bool = arg_set(0, VAL[0 .. 2048], 0, vlen);
    if (!ok) { return -1; }
    var to : usize = 0;
    var tn : usize = 0;
    if (INF[10] == 1) {
        to = INF[11] as usize;
        tn = INF[12] as usize;
    }
    ok = arg_set(1, POOL[0 .. 4194304], to, to + tn);
    if (!ok) { return -1; }
    var vo : usize = 0;
    var vn : usize = 0;
    if (INF[7] == 1) {
        vo = INF[8] as usize;
        vn = INF[9] as usize;
    }
    ok = arg_set(2, POOL[0 .. 4194304], vo, vo + vn);
    if (!ok) { return -1; }
    const tl : i64 = fmt_into(TIT[0 .. 4096], title_tpl, 3);
    if (tl < 0) { return -1; }
    const lw : i64 = (utf16_len(label, 0, label.len) as i64) * cw + 2 * pad;
    const vw : i64 = (utf16_len(VAL[0 .. 2048], 0, vlen) as i64) * cw + 2 * pad;
    const w : i64 = lw + vw;
    const y : i64 = js_round((h as f64) * 0.7);
    V[V_BC] = 0;
    bputs(out, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"");
    bput_u(out, w as u64);
    bputs(out, "\" height=\"");
    bput_u(out, h as u64);
    bputs(out, "\" role=\"img\" aria-label=\"");
    xml_put(out, label, 0, label.len);
    bputs(out, ": ");
    xml_put(out, VAL[0 .. 2048], 0, vlen);
    bputs(out, "\"><title>");
    xml_put(out, TIT[0 .. 4096], 0, tl as usize);
    bputs(out, "</title><rect width=\"");
    bput_u(out, lw as u64);
    bputs(out, "\" height=\"");
    bput_u(out, h as u64);
    bputs(out, "\" rx=\"3\" fill=\"");
    bputs(out, label_fill);
    bputs(out, "\"/><rect x=\"");
    bput_u(out, lw as u64);
    bputs(out, "\" width=\"");
    bput_u(out, vw as u64);
    bputs(out, "\" height=\"");
    bput_u(out, h as u64);
    bputs(out, "\" rx=\"3\" fill=\"");
    bputs(out, value_fill);
    bputs(out, "\"/><rect x=\"");
    bput_u(out, lw as u64);
    bputs(out, "\" width=\"4\" height=\"");
    bput_u(out, h as u64);
    bputs(out, "\" fill=\"");
    bputs(out, value_fill);
    bputs(out, "\"/><g fill=\"#fff\" font-family=\"monospace\" font-size=\"");
    bput_u(out, font_px as u64);
    bputs(out, "\"><text x=\"");
    bput_u(out, pad as u64);
    bputs(out, "\" y=\"");
    bput_u(out, y as u64);
    bputs(out, "\" textLength=\"");
    bput_u(out, (utf16_len(label, 0, label.len) as u64) * (cw as u64));
    bputs(out, "\" lengthAdjust=\"spacingAndGlyphs\">");
    xml_put(out, label, 0, label.len);
    bputs(out, "</text><text x=\"");
    bput_u(out, (lw + pad) as u64);
    bputs(out, "\" y=\"");
    bput_u(out, y as u64);
    bputs(out, "\" textLength=\"");
    bput_u(out, (utf16_len(VAL[0 .. 2048], 0, vlen) as u64) * (cw as u64));
    bputs(out, "\" lengthAdjust=\"spacingAndGlyphs\">");
    xml_put(out, VAL[0 .. 2048], 0, vlen);
    bputs(out, "</text></g></svg>");
    return V[V_BC] as i64;
}

// ---------------------------------------------------------------- tests
pub var LST : [256]u8 = [0; 256];
pub var LSN : usize = 0;
pub var OUT : [2048]u8 = [0; 2048];

pub fn ls_line(s: []const u8) -> usize {
    var k : usize = 0;
    while (k < s.len) {
        LST[LSN] = s[k];
        LSN = LSN + 1;
        k = k + 1;
    }
    LST[LSN] = 10;
    LSN = LSN + 1;
    return LSN;
}

pub fn lists_default() -> usize {
    LSN = 0;
    ls_line("0LUT1");
    ls_line("0LUT2");
    ls_line("0LUT3");
    ls_line("0LUT4");
    ls_line("0LUT5");
    ls_line("0LUT6");
    ls_line("1FDRE");
    ls_line("1FDSE");
    ls_line("1FDCE");
    ls_line("1FDPE");
    ls_line("2DSP48E1");
    ls_line("3RAMB18E1");
    ls_line("3RAMB36E1");
    ls_line("4$scopeinfo");
    return LSN;
}

pub fn pool_text(o: i64, l: i64, w: []const u8) -> bool {
    return pool_is(o as u32, l as u32, w);
}

test the_sample_stat_is_read_from_its_design_block {
    lists_default();
    const t : []const u8 = "{ \"creator\": \"Yosys 0.67+post (git sha1 b8e7da6f, Release)\", \"invocation\": \"stat -json \", \"modules\": { \"\\\\lm_head_matvec\": { \"num_wires\": 200, \"num_cells\": 430, \"num_cells_by_type\": { \"BUFG\": 1, \"CARRY4\": 32, \"FDRE\": 149, \"IBUF\": 23, \"INV\": 28, \"LUT2\": 69, \"LUT3\": 3, \"LUT4\": 4, \"LUT5\": 50, \"LUT6\": 12, \"MUXF7\": 3, \"MUXF8\": 1, \"OBUF\": 51, \"RAMB36E1\": 4 } } }, \"design\": { \"num_cells\": 430, \"num_cells_by_type\": { \"BUFG\": 1, \"CARRY4\": 32, \"FDRE\": 149, \"IBUF\": 23, \"INV\": 28, \"LUT2\": 69, \"LUT3\": 3, \"LUT4\": 4, \"LUT5\": 50, \"LUT6\": 12, \"MUXF7\": 3, \"MUXF8\": 1, \"OBUF\": 51, \"RAMB36E1\": 4 } } }";
    assert stat_parse(t, LST[0 .. LSN]) == 0;
    assert st_info(1) == 0;
    assert st_info(0) == 0;
    assert st_info(2) == 1;
    assert st_info(3) == 14;
    assert pool_text(st_info(11), st_info(12), "lm_head_matvec");
    assert pool_text(st_info(8), st_info(9), "0.67+post");
    assert st_group(0) == 138.0;
    assert st_group(1) == 149.0;
    assert st_group(2) == 0.0;
    assert st_group(3) == 4.0;
    assert st_group(4) == 139.0;
    assert st_cells() == 430.0;
    assert st_n(5) == 69.0;
    assert pool_text(st_type(5, 0), st_type(5, 1), "LUT2");
    assert st_type(5, 2) == 0;
    assert st_type(13, 2) == 3;
}

test without_a_design_block_the_top_module_is_expanded {
    lists_default();
    const t : []const u8 = "{\"modules\": {\"\\\\sub\": {\"num_cells_by_type\": {\"LUT2\": 5, \"FDRE\": 1}}, \"\\\\top\": {\"num_cells_by_type\": {\"\\\\sub\": 2, \"LUT2\": 3, \"IBUF\": 1}}}}";
    assert stat_parse(t, LST[0 .. LSN]) == 0;
    assert st_info(1) == 1;
    assert st_info(2) == 2;
    assert pool_text(st_info(11), st_info(12), "top");
    assert st_info(10) == 1;
    assert st_info(3) == 3;
    assert st_n(0) == 13.0;
    assert pool_text(st_type(0, 0), st_type(0, 1), "LUT2");
    assert st_n(1) == 2.0;
    assert st_group(0) == 13.0;
    assert st_group(1) == 2.0;
    assert st_group(4) == 1.0;
    assert st_cells() == 16.0;
    assert st_info(4) == 0;
    assert st_info(7) == 0;
}

test the_five_failures_are_told_apart {
    lists_default();
    assert stat_parse("  \t ", LST[0 .. LSN]) == 1;
    assert stat_parse("hello yosys", LST[0 .. LSN]) == 2;
    assert stat_parse("{ x }", LST[0 .. LSN]) == 3;
    assert stat_parse("{\"a\": 1}", LST[0 .. LSN]) == 4;
    assert stat_parse("[]", LST[0 .. LSN]) == 4;
    assert stat_parse("null", LST[0 .. LSN]) == 4;
    assert stat_parse("{\"modules\": null}", LST[0 .. LSN]) == 4;
    assert stat_parse("{\"modules\": {}}", LST[0 .. LSN]) == 5;
    assert stat_parse("{\"creator\": \"Yosys 0.9\", \"modules\": {\"\\\\m\": {}}}", LST[0 .. LSN]) == 5;
    assert st_info(7) == 1;
    assert pool_text(st_info(11), st_info(12), "m");
    assert stat_parse("{\"modules\": {\"\": {\"cells\": {\"LUT2\": 1}}}}", LST[0 .. LSN]) == 5;
}

test json_inside_a_terminal_capture_is_found_by_its_braces {
    lists_default();
    const t : []const u8 = "yosys> stat -json {\"modules\": {\"top\": {\"cells\": {\"LUT6\": 7, \"FDRE\": 2}}}} bye";
    assert stat_parse(t, LST[0 .. LSN]) == 0;
    assert st_info(0) == 1;
    assert st_info(1) == 1;
    assert st_group(0) == 7.0;
    assert st_group(1) == 2.0;
    assert stat_parse("x {\"modules\": {\"top\": {\"cells\": {\"LUT6\": 7,}}}} y", LST[0 .. LSN]) == 3;
    assert stat_parse("} {", LST[0 .. LSN]) == 2;
}

test strings_escapes_duplicates_and_odd_values_follow_javascript {
    lists_default();
    const t : []const u8 = "{\"creator\":\"Yosys   x\\u0041y z\",\"modules\":{\"m\":{\"num_cells_by_type\":{\"LUT\\u0032\":1,\"X\":null,\"Y\":true,\"LUT2\":4,\"Z\":-0,\"W\":1.5e1,\"V\":2.50}}}}";
    assert stat_parse(t, LST[0 .. LSN]) == 0;
    assert pool_text(st_info(8), st_info(9), "xAy");
    assert st_info(3) == 6;
    assert pool_text(st_type(0, 0), st_type(0, 1), "LUT2");
    assert st_n(0) == 4.0;
    assert st_n(1) == 0.0;
    assert st_n(2) == 1.0;
    assert st_n(3) == 0.0;
    assert st_n(4) == 15.0;
    assert st_n(5) == 2.5;
    assert st_group(4) == 18.5;
    assert st_group(0) == 4.0;
}

test what_the_port_does_not_carry_is_refused_not_guessed {
    lists_default();
    assert stat_parse("{\"modules\":{\"m\":{\"cells\":{\"LUT2\":\"5\"}}}}", LST[0 .. LSN]) == 9;
    assert stat_parse("{\"modules\":{\"m\":{\"cells\":{\"LUT2\":[5]}}}}", LST[0 .. LSN]) == 9;
    assert stat_parse("{\"modules\":{\"m\":{\"cells\":{\"constructor\":5}}}}", LST[0 .. LSN]) == 9;
    assert stat_parse("{\"modules\":{\"m\":{\"cells\":{\"7\":5}}}}", LST[0 .. LSN]) == 9;
    assert stat_parse("{\"modules\":{\"m\":{\"cells\":{\"A\":1e30}}}}", LST[0 .. LSN]) == 9;
    assert stat_parse("{\"modules\":{\"m\":{\"cells\":{\"A\":1}}},\"x\":\"\\ud800\"}", LST[0 .. LSN]) == 9;
    assert stat_parse("{\"modules\":{\"m\":{\"cells\":{\"A\":1}}},\"x\":1e30}", LST[0 .. LSN]) == 0;
}

test hierarchy_cycles_and_group_priority_follow_flatten {
    lists_default();
    const t : []const u8 = "{\"modules\":{\"\\\\a\":{\"cells\":{\"\\\\b\":1,\"LUT2\":1}},\"\\\\b\":{\"cells\":{\"\\\\a\":1,\"FDRE\":1}}}}";
    assert stat_parse(t, LST[0 .. LSN]) == 0;
    assert st_info(3) == 2;
    assert st_n(0) == 1.0;
    assert st_n(1) == 1.0;
    assert st_group(0) == 1.0;
    assert st_group(1) == 1.0;
    assert stat_parse("{\"design\":{\"cells\":{\"$scopeinfo\":3,\"m\":2,\"LUT3\":1}},\"modules\":{\"m\":{\"cells\":{}}}}", LST[0 .. LSN]) == 0;
    assert st_group(5) == 3.0;
    assert st_group(6) == 2.0;
    assert st_group(0) == 1.0;
    assert st_cells() == 1.0;
}

test the_badge_is_plain_svg_with_the_counts {
    lists_default();
    const t : []const u8 = "{\"creator\":\"Yosys 0.67+post (x)\",\"modules\":{\"\\\\t<\":{\"cells\":{\"LUT2\":138,\"FDRE\":149,\"RAMB36E1\":4}}}}";
    assert stat_parse(t, LST[0 .. LSN]) == 0;
    const n : i64 = badge_svg("yosys synth", "{0} LUT | {1} FF | {2} DSP | {3} BRAM", "{0} -- top {1}, yosys {2}: x", "#555", "#2e7d4f", 7, 6, 20, 11, OUT[0 .. 2048]);
    assert n > 300;
    assert n < 2048;
    assert OUT[0] == 60;
    assert OUT[(n - 1) as usize] == 62;
    assert match_in(OUT[0 .. 2048], 0, 2048, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"");
    assert match_in(OUT[0 .. 2048], 47, 2048, "332\" height=\"20\"");
    assert js_round(14.0) == 14;
    assert js_round(2.5) == 3;
    assert js_round(20.0 * 0.7) == 14;
}
