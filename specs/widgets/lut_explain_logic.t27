// SPDX-License-Identifier: Apache-2.0
; specs/widgets/lut-explain_logic.t27 -- the logic of the lut-explain widget as .t27: a Xilinx
; 7-series LUT6 INIT value read as logic (support, Quine-McCluskey cover, a name for the function)
; and a FASM line split into tile, site, BEL and feature. Ported from JavaScript (gHashTag/trinity,
; apps/website/public/widgets/lut-explain/lut.js, 370 lines). Epic gHashTag/t27#10937, port issue
; #10938. Owner rule (Only t27): the logic is written once, in .t27.
; --
; MODEL. The 64 output bits of a LUT6 are ONE u64 (bit i = INIT[i]); the JavaScript Uint8Array
; and BigInt forms are the same thing. Inputs: 0 = A1 .. 5 = A6. A JS function that returns text
; or a list fills OUT (OUT_N bytes, out_byte(i)) or is read through getters; a text that is a piece
; of the INPUT is returned as byte offsets into the input.
; --
; JS EXPORT -> t27 (the table asked for by the port brief)
;   N_IN, N_BITS            n_in(), n_bits()
;   bitsFromBig(v)          bit_of(v, i) -> 0/1 (the u64 IS the bits)
;   bigFromBits(bits)       big_from_bits(bits: []const u8) -> u64 (reads b[i] & 1, i < 64)
;   initHex(bits)           init_hex(bits) -> 16, the digits in OUT (upper case)
;   initBin(bits)           init_bin(bits) -> 64, INIT[63] first, in OUT
;   parseLiteral(text)      parse_literal(text) -> bool; lit_value(), lit_width()
;   parseFasmLine(line)     parse_fasm_line(line) -> bool (false: null); fields through fl_*:
;                           fl_kind (0 other, 1 bad-value, 2 site, 3 lut-init, 4 pip),
;                           fl_text_lo/hi, fl_tile_lo/hi, fl_type_hi (tileType = tile_lo .. type_hi),
;                           fl_path_lo/hi, fl_has_hi/fl_hi, fl_has_lo/fl_lo (f64), fl_has_vtext and
;                           fl_vtext_lo/hi, fl_has_lit with fl_lit_value/fl_lit_width, fl_has_site with
;                           fl_site_lo/hi, fl_feat_lo/hi, fl_lut (the letter byte, 0 for none),
;                           fl_nparts and fl_part_lo/hi(i); all offsets are into the line passed
;   parseInput(text)        parse_input(text) -> bool (false: a capacity was hit); pi_has_bits and
;                           pi_bits; pi_has_lut with pi_tile_lo/hi, pi_type_hi, pi_site_lo/hi,
;                           pi_lut_letter; pi_n parsed lines with pi_line_lo/hi(k) and pi_kind(k)
;                           (the five kinds above, 5 = bad-range; re-parse the line with
;                           parse_fasm_line for the fields); pi_bad_n bad lines, pi_bad_lo/hi(k)
;   support(bits)           support_mask(bits) -> bit k set = input k matters
;   minimize(bits, budget)  minimize(bits, budget) -> term count; min_value(i), min_dc(i),
;                           min_exact(), min_primes()
;   termLiterals(t)         term_literals(value, dc) -> count; tl_input(i), tl_inverted(i)
;   coverBits(terms)        term_set(i, value, dc) then cover_bits(n) -> u64 (minimize fills the same terms)
;   CLASS_IDS               class_id(i) names in OUT: zero one buf not and nand or nor andx orx xor
;                           xnor maj majx carry2 carry2x mux2 mux4 xorwith xnorwith other (ids 0..20)
;   classify(bits)          classify(bits): cls_id, cls_n, cls_k, cls_inputs_mask, cls_sel_n/cls_sel(i),
;                           cls_data_n/cls_data(i); for xorwith/xnorwith cls_has_inner and the same
;                           getters with the inner(.) suffix: cls_inner_id/_n/_k/_inputs_mask/_sel_n/
;                           _sel/_data_n/_data
;   classKey(c)             class_key() -> length, the text in OUT
;   halves(bits)            halves_o5(bits), halves_o6(bits), halves_same(bits)
;   rowLevels(i)            row_level(i, q) (q = 0 is A6)
;   permutations(xs)        internal: the 24 orderings of four inputs are enumerated in the same
;                           order inside the mux4 test
;   popcount, popcount32    internal: pop64
; WHAT IS NOT MATCHED (measured or reasoned; the differential never feeds these and prints that):
;   - a field count of 0x or digits longer than 15 in a bracket (INIT[1234567890123456789]):
;     JS Number() rounds the decimal text exactly, this file adds digits in f64;
;   - parse_literal on text with more than 65536 non-underscore bytes after the trim (a literal is
;     at most a few dozen characters; JS would accept 100000 leading zeros), and parse_fasm_line on
;     a path with more than 1024 dot-separated parts (fl_nparts still counts them, the ranges stop);
;   - parse_input capacity: 16384 non-empty lines. Over it parse_input returns false;
;   - bits given to the JS functions that are not 0 or 1 (the page only passes 0/1).
; JS quirks PORTED exactly: parseFasmLine strips a comment only when no line terminator follows its
; '#' (the regex #.*$ has no s or m flag); the tile and path are the maximal runs the lazy regex
; ends up with; `[hi:lo]` with lo > hi is not a feature line; a '[' that does not close makes the
; whole line null; parseLiteral with a Verilog width that is out of range or digits that do not
; fit the base returns null WITHOUT trying the bare forms; parseInput ignores a lut-init line of a
; second LUT but still lists it, keeps a literal when a bad-range first line allocated the LUT but
; set no bits, and lets the LUT bits replace an earlier literal.
; JS ORDER kept: the minimizer's pair loop, Map insertion order, the cover search with its node
; budget (the tie-breaks of the sort are stable), the greedy fallback, and the term sort.
; BUILD: t27c gen (Zig) + an export wrapper -> wasm32-freestanding, ReleaseSmall (19043 bytes). gen-c cannot be used
; (invalid C for byte slices). u64 values cross wasm as i64 (BigInt in JS).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_lut_explain_logic;

pub const N_IN : u32 = 6;
pub const N_BITS : u32 = 64;

pub const FK_OTHER : u32 = 0;
pub const FK_BAD_VALUE : u32 = 1;
