// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fsm_sketch_logic.t27 -- the FSM reader and layout of the fsm-sketch widget, as pure rules
; over bytes and numbers: the JavaScript file apps/website/public/widgets/fsm-sketch/fsmparse.js (379 lines,
; gHashTag/trinity) ported to .t27. Epic gHashTag/t27#10937, issue #10938. Owner rule (Only t27): the logic is
; written in .t27, never by hand in JavaScript. The page reads a pasted or dropped yosys log or KISS2 file
; in the reader's browser and sends nothing anywhere; these rules keep that: they see only the bytes and
; numbers the glue hands over, fill buffers the glue hands over, and hold no state between calls.
; --
; Table: every export of fsmparse.js and the function(s) that replace it.
;   sniff(text)             sniff: 0 none, 1 log, 2 kiss2.
;   parseAny(text)          fsm_parse with mode 0: sniff, then parse_log or parse_kiss2; one result stream, see
;                           "the result stream" before fsm_parse's helpers.
;   parseLog, parseKiss2    fsm_parse with mode 1 and mode 2 (parse_log, parse_kiss2).
;   countsOf(f)             counts_of.
;   codeValue(code)         code_value: -1 for null.
;   conditionOf(pat,names)  condition_of: the (index, bit) pairs; the glue joins "name=bit" (names[idx] ?? in[idx]).
;   walkOrder(f)            walk_order.
;   layoutFsm(f, opts)      layout_fsm. opts are passed explicitly: font, charW, edgeFont, maxLabelRows; the
;                           JavaScript defaults (14, 0.6 * font, round(0.86 * font), 3) are the glue's. The
;                           label lines of a state are given as two numbers each: how many lines and the
;                           longest line's length in UTF-16 units (a label's text is drawn by the glue).
;                           js_number is Number() of a KISS2 header token, which parseKiss2 uses.
; Not ported: nothing of fsmparse.js is left out, but the three libm calls of layoutFsm stay with the host
; (see "Floating point"). The private helpers stateNum, unslash, unit, rot, boxExit, labelBox, overlap,
; placeLabels, bounds and place are the functions of the same names here (stateNum is state_num).
; --
; Domain. ASCII or UTF-8 bytes; bytes above 127 are ordinary non-space characters (JavaScript's \s and trim()
; also take NBSP, U+2028 and friends as space: not ported, not claimed). A number in a log or KISS2 file is read
; as an integer of up to 15 digits; an index above 2147483647 or a state number above 15 digits sets status 5
; ("out of the claimed domain"). A KISS2 header value goes through Number() in the JavaScript: decimal
; integers and decimals with at most 15 significant digits and an exponent within 22, hex, octal and
; binary literals and Infinity are read the same here; any other form is NaN, as there. A longer decimal sets
; status 5.
; One JavaScript throw is reproduced as status 6: a "FSM `...' from module `...':" line above an
; "Information on FSM" line whose module name has no non-quote text right after "from module `".
; --
; Floating point. layout_fsm repeats fsmparse.js's arithmetic operation for operation in f64. Math.hypot is
; V8's (the largest absolute value, then Kahan-summed squares of the ratios); Math.max and Math.min
; propagate NaN and order -0 below +0; Math.round is floor(x + 0.5) without the 0.49999999999999994 trap.
; The three libm calls of the JavaScript stay with the host, because Math.sin, Math.cos and Math.atan2 are
; the engine's own (measured: V8 12.9 on arm64 differs in the last bit from fdlibm, musl and the system
; libm in about 1 call in 100, so no port can promise their bits): (1) the cos and sin of the node angles
; -Math.PI / 2 + (2 * Math.PI * k) / n, k below n, and of -0.45, 0.45, -0.55, 0.55 come in as the table
; trig (cos, sin pairs: 2n for the nodes, then 8 for the four fixed angles, in that order); node_angle(k, n)
; gives the angle to ask the host for. (2) arrow.angle, which no other result depends on, is
; Math.atan2(arrow.y - c.y, arrow.x - c.x) with c the second control point of a self loop (ef 4, 5) and
; the control point of a curve (ef 2, 3): the glue computes it from the returned points; ef 10 is 0.
; The `**` of the JavaScript is exact for every base and exponent it is applied to with a constant t of
; 0.25 0.5 0.75, and x ** 2 is x * x.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fsm_sketch_logic;

pub const NONE : u32 = 4294967295;
pub const NO_TEXT : i64 = -1;
pub const PACK : i64 = 4294967296;
pub const PI : f64 = 3.141592653589793;

pub var V : [8]f64 = [0.0; 8];

// ------------------------------------------------------------------------------------------------
// numbers and the small pure functions
// ------------------------------------------------------------------------------------------------

pub fn pack(lo: usize, hi: usize) -> i64 {
    return (lo as i64) * PACK + (hi as i64);
}

pub fn lo_of(p: i64) -> usize {
    return (p / PACK) as usize;
}

pub fn hi_of(p: i64) -> usize {
    return (p % PACK) as usize;
}

pub fn inf() -> f64 {
    var z : f64 = 0.0;
    return 1.0 / z;
}

pub fn nan() -> f64 {
    var z : f64 = 0.0;
    return z / z;
}

pub fn neg_zero(x: f64) -> bool {
    if (x != 0.0) { return false; }
    var y : f64 = x;
    return 1.0 / y < 0.0;
}

/// JavaScript's truthiness of a number: not 0, not NaN.
pub fn truthy(x: f64) -> bool {
    return x != 0.0 and x == x;
}

/// Math.max of two numbers: NaN wins, +0 is above -0.
pub fn jsmax(a: f64, b: f64) -> f64 {
    if (a != a) { return a; }
    if (b != b) { return b; }
    if (a > b) { return a; }
    if (b > a) { return b; }
    if (a == 0.0 and neg_zero(a)) { return b; }
    return a;
}

/// Math.min of two numbers: NaN wins, -0 is below +0.
pub fn jsmin(a: f64, b: f64) -> f64 {
    if (a != a) { return a; }
    if (b != b) { return b; }
    if (a < b) { return a; }
    if (b < a) { return b; }
    if (a == 0.0 and !neg_zero(a)) { return b; }
    return a;
}

/// Math.round: the nearest integer, halves toward +infinity.
pub fn jsround(x: f64) -> f64 {
    const r : f64 = @floor(x);
    if (x - r >= 0.5) {
        if (x < 0.0 and r + 1.0 == 0.0) {
            var m1 : f64 = 0.0 - 1.0;
            return 0.0 * m1;
        }
        return r + 1.0;
    }
    return r;
}

/// V8's Math.hypot(x, y).
pub fn hypot2(x: f64, y: f64) -> f64 {
    const ax : f64 = @abs(x);
    const ay : f64 = @abs(y);
    var max : f64 = 0.0;
    if (ax == ax and ax > max) { max = ax; }
    if (ay == ay and ay > max) { max = ay; }
    if (max == inf()) { return inf(); }
    if (x != x or y != y) { return nan(); }
    if (max == 0.0) { return 0.0; }
    var sum : f64 = 0.0;
    var comp : f64 = 0.0;
    var k : u32 = 0;
    while (k < 2) {
        var v : f64 = ax;
        if (k == 1) { v = ay; }
        const q : f64 = v / max;
        const summand : f64 = q * q - comp;
        const prelim : f64 = sum + summand;
        comp = (prelim - sum) - summand;
        sum = prelim;
        k = k + 1;
    }
    return @sqrt(sum) * max;
}

/// The unit vector of (x, y) into V[0], V[1]: unit = (x, y) => { const l = Math.hypot(x, y) || 1; ... }.
pub fn unit_to(x: f64, y: f64) {
    var l : f64 = hypot2(x, y);
    if (!truthy(l)) { l = 1.0; }
    V[0] = x / l;
    V[1] = y / l;
}

/// rot([x, y], a) into V[0], V[1], given cos(a) and sin(a) (the glue's Math.cos and Math.sin).
pub fn rot_to(x: f64, y: f64, cs: f64, sn: f64) {
    V[0] = x * cs - y * sn;
    V[1] = x * sn + y * cs;
}

/// The angle of the k-th state on the ellipse of n states: -Math.PI / 2 + (2 * Math.PI * k) / n.
pub fn node_angle(k: usize, n: usize) -> f64 {
    return (0.0 - PI) / 2.0 + (2.0 * PI * (k as f64)) / (n as f64);
}

/// Where a ray from a box's centre in direction (dx, dy) leaves the box, into V[0], V[1].
pub fn box_exit(nx: f64, ny: f64, nw: f64, nh: f64, dx: f64, dy: f64, pad: f64) {
    const hw : f64 = nw / 2.0 + pad;
    const hh : f64 = nh / 2.0 + pad;
    var a : f64 = inf();
    if (truthy(dx)) { a = hw / @abs(dx); }
    var b : f64 = inf();
    if (truthy(dy)) { b = hh / @abs(dy); }
    const t : f64 = jsmin(a, b);
    V[0] = nx + dx * t;
    V[1] = ny + dy * t;
}

/// parseInt(code, 2) of a code of 0 and 1 of at most 52 digits; -1 when it holds anything else.
pub fn code_value(code: []const u8) -> i64 {
    if (code.len == 0 or code.len > 52) { return -1; }
    var v : i64 = 0;
    var i : usize = 0;
    while (i < code.len) {
        const c : u8 = code[i];
        if (c != 48 and c != 49) { return -1; }
        v = v * 2 + ((c - 48) as i64);
        i = i + 1;
    }
    return v;
}

/// conditionOf: for every character of the pattern that is not "-", its input index (highest first as
/// yosys prints) in out_idx and the character in out_bit; returns how many.
pub fn condition_of(pattern: []const u8, out_idx: []u32, out_bit: []u8) -> usize {
    const n : usize = pattern.len;
    var cnt : usize = 0;
    var j : usize = 0;
    while (j < n) {
        const c : u8 = pattern[j];
        if (c != 45) {
            if (cnt < out_idx.len and cnt < out_bit.len) {
                out_idx[cnt] = (n - 1 - j) as u32;
                out_bit[cnt] = c;
            }
            cnt = cnt + 1;
        }
        j = j + 1;
    }
    return cnt;
}

/// countsOf: out = [states, transitions, inputs, outputs, bits].
pub fn counts_of(n_states: u32, n_rows: u32, n_in: f64, n_out: f64, n_bits: f64, out: []f64) {
    out[0] = n_states as f64;
    out[1] = n_rows as f64;
    out[2] = n_in;
    out[3] = n_out;
    out[4] = n_bits;
}

// ------------------------------------------------------------------------------------------------
// walkOrder
// ------------------------------------------------------------------------------------------------

/// States in the order a reader follows them: breadth-first from reset (or 0), then any left over.
/// order gets n states; work needs 2 * n + nrows + 2 words. Rows whose ends are not below n are ignored.
/// Returns n.
pub fn walk_order(n: usize, reset: i64, nrows: usize, rows_from: []const u32, rows_to: []const u32, order: []u32, work: []u32) -> usize {
    // work[0 .. n] offsets, work[n + 1 .. n + 1 + nrows] neighbours, work[n + 1 + nrows .. 2n + 1 + nrows] seen
    const adj : usize = n + 1;
    const seen : usize = n + 1 + nrows;
    var i : usize = 0;
    while (i <= n) {
        work[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        work[seen + i] = 0;
        i = i + 1;
    }
    var r : usize = 0;
    while (r < nrows) {
        const f : usize = rows_from[r] as usize;
        const t : usize = rows_to[r] as usize;
        if (f < n and t < n and f != t) { work[f + 1] = work[f + 1] + 1; }
        r = r + 1;
    }
    i = 0;
    while (i < n) {
        work[i + 1] = work[i + 1] + work[i];
        i = i + 1;
    }
    // fill with a cursor kept in order[] (free until the walk starts)
    i = 0;
    while (i < n) {
        order[i] = work[i];
        i = i + 1;
    }
    r = 0;
    while (r < nrows) {
        const f : usize = rows_from[r] as usize;
        const t : usize = rows_to[r] as usize;
        if (f < n and t < n and f != t) {
            work[adj + (order[f] as usize)] = t as u32;
            order[f] = order[f] + 1;
        }
        r = r + 1;
    }
    // sort each neighbour list ascending
    i = 0;
    while (i < n) {
        const lo : usize = work[i] as usize;
        const hi : usize = work[i + 1] as usize;
        var a : usize = lo + 1;
        while (a < hi) {
            const v : u32 = work[adj + a];
            var b : usize = a;
            while (b > lo and work[adj + b - 1] > v) {
                work[adj + b] = work[adj + b - 1];
                b = b - 1;
            }
            work[adj + b] = v;
            a = a + 1;
        }
        i = i + 1;
    }
    var start : usize = 0;
    if (reset >= 0) { start = reset as usize; }
    var tail : usize = 0;
    var head : usize = 0;
    var s : usize = 0;
    var pass : usize = 0;
    // the roots are start, then 0 .. n - 1
    while (pass <= n) {
        var root : usize = start;
        if (pass > 0) { root = pass - 1; }
        pass = pass + 1;
        if (root < n and work[seen + root] == 0) {
            work[seen + root] = 1;
            order[tail] = root as u32;
            tail = tail + 1;
            while (head < tail) {
                const x : usize = order[head] as usize;
                head = head + 1;
                var q : usize = work[x] as usize;
                const qe : usize = work[x + 1] as usize;
                while (q < qe) {
                    const y : usize = work[adj + q] as usize;
                    if (work[seen + y] == 0) {
                        work[seen + y] = 1;
                        order[tail] = y as u32;
                        tail = tail + 1;
                    }
                    q = q + 1;
                }
            }
        }
    }
    s = tail;
    return n;
}

// ------------------------------------------------------------------------------------------------
// layoutFsm
// ------------------------------------------------------------------------------------------------

/// The box a label covers, into V[0 .. 3] = x0, y0, x1, y1. anchor 0 middle 1 start 2 end; valign 0 middle
/// 1 bottom 2 top; labmax is the longest line length (at least 1, or the "more" text length + 6); shown and
/// more as in the label.
pub fn label_box(lx: f64, ly: f64, anchor: u32, valign: u32, labmax: u32, shown: u32, more: u32, edge_font: f64, edge_char_w: f64) {
    const lh : f64 = edge_font * 1.15;
    const bw : f64 = (labmax as f64) * edge_char_w;
    var extra : f64 = 0.0;
    if (more != 0) { extra = 1.0; }
    const bh : f64 = ((shown as f64) + extra) * lh;
    var x0 : f64 = lx - bw / 2.0;
    if (anchor == 1) { x0 = lx; }
    if (anchor == 2) { x0 = lx - bw; }
    var y0 : f64 = ly - bh / 2.0;
    if (valign == 1) { y0 = ly - bh; }
    if (valign == 2) { y0 = ly; }
    V[0] = x0;
    V[1] = y0;
    V[2] = x0 + bw;
    V[3] = y0 + bh;
}

/// overlap of two boxes (x0, y0, x1, y1).
pub fn overlap(px0: f64, py0: f64, px1: f64, py1: f64, qx0: f64, qy0: f64, qx1: f64, qy1: f64) -> f64 {
    const w : f64 = jsmax(0.0, jsmin(px1, qx1) - jsmax(px0, qx0));
    const h : f64 = jsmax(0.0, jsmin(py1, qy1) - jsmax(py0, qy0));
    return w * h;
}

pub fn digits_of(v: u32) -> u32 {
    var n : u32 = 1;
    var x : u32 = v;
    while (x >= 10) {
        x = x / 10;
        n = n + 1;
    }
    return n;
}

pub fn anchor_of(nx: f64) -> u32 {
    if (@abs(nx) < 0.35) { return 0; }
    if (nx > 0.0) { return 1; }
    return 2;
}

pub fn valign_of(ny: f64) -> u32 {
    if (ny < -0.35) { return 1; }
    if (ny > 0.35) { return 2; }
    return 0;
}

/// layoutFsm: node boxes and edge curves for one FSM in a w x h box. See the header of the file.
///   rows_from, rows_to, rows_inlen: nrows entries (every from and to below n).
///   label_n, label_maxlen: n entries.
///   nodes (f64, 4 per state): x, y, w, h.
///   ef (f64, 13 per edge): p0 x y, c1 (the control point of a quadratic) x y, c2 x y (self loops only; 0
///     otherwise), p1 x y, arrow x y angle, label x y. For a quadratic the points are p0, c, p1 and the
///     entries 4 to 7 hold 0, 0, then p1: [p0, c, 0, 0, p1]. Self loops: [p0, c1, c2, p1].
///   eu (u32, 10 per edge): from, to, self, rows, lines shown, more, anchor, valign, longest label line,
///     unused. The shown lines are the first rows of the pair, in row order.
///   order: n words (the walk order), work: u32 of 2n + nrows + 2 + 2nrows + 4, fw: f64 of 4 * (n + 2 * nrows) + 8.
/// Returns the number of edges.
pub fn layout_fsm(n: usize, reset: i64, nrows: usize, rows_from: []const u32, rows_to: []const u32, rows_inlen: []const u32, label_n: []const u32, label_maxlen: []const u32, w: f64, h: f64, font: f64, charw: f64, edgefont: f64, maxrows: i64, nodes: []f64, ef: []f64, eu: []u32, order: []u32, work: []u32, fw: []f64, trig: []const f64) -> usize {
    const edge_char_w : f64 = edgefont * (charw / font);
    const line_h : f64 = jsround(font * 1.25);
    // boxes
    var maxw : f64 = 0.0;
    var maxh : f64 = 0.0;
    var i : usize = 0;
    while (i < n) {
        var tw : f64 = (0.0 - inf()) * charw;
        if (label_n[i] > 0) { tw = (label_maxlen[i] as f64) * charw; }
        const bw : f64 = jsmax(tw + font * 1.4, font * 3.2);
        const bh : f64 = (label_n[i] as f64) * line_h + font * 0.9;
        nodes[i * 4 + 2] = bw;
        nodes[i * 4 + 3] = bh;
        maxw = jsmax(maxw, bw);
        maxh = jsmax(maxh, bh);
        i = i + 1;
    }
    const loop_r : f64 = jsmax(maxh * 0.8, font * 2.2);
    walk_order(n, reset, nrows, rows_from, rows_to, order, work);
    // one edge per (from, to) pair, in order of first row
    var ne : usize = 0;
    var r : usize = 0;
    while (r < nrows) {
        var e : usize = 0;
        var hit : bool = false;
        while (e < ne and !hit) {
            if (eu[e * 10] == rows_from[r] and eu[e * 10 + 1] == rows_to[r]) { hit = true; } else { e = e + 1; }
        }
        if (!hit) {
            eu[ne * 10] = rows_from[r];
            eu[ne * 10 + 1] = rows_to[r];
            eu[ne * 10 + 3] = 0;
            e = ne;
            ne = ne + 1;
        }
        eu[e * 10 + 3] = eu[e * 10 + 3] + 1;
        r = r + 1;
    }
    var e : usize = 0;
    while (e < ne) {
        const cntr : i64 = eu[e * 10 + 3] as i64;
        var shown : i64 = cntr;
        var more : i64 = 0;
        if (cntr > maxrows) {
            var keep : i64 = maxrows - 1;
            if (keep < 1) { keep = 1; }
            shown = keep;
            more = cntr - keep;
        }
        eu[e * 10 + 2] = 0;
        if (eu[e * 10] == eu[e * 10 + 1]) { eu[e * 10 + 2] = 1; }
        eu[e * 10 + 4] = shown as u32;
        eu[e * 10 + 5] = more as u32;
        var lm : u32 = 1;
        var seen : i64 = 0;
        r = 0;
        while (r < nrows and seen < shown) {
            if (rows_from[r] == eu[e * 10] and rows_to[r] == eu[e * 10 + 1]) {
                if (rows_inlen[r] > lm) { lm = rows_inlen[r]; }
                seen = seen + 1;
            }
            r = r + 1;
        }
        if (more != 0) {
            const mt : u32 = digits_of(more as u32) + 6;
            if (mt > lm) { lm = mt; }
        }
        eu[e * 10 + 8] = lm;
        eu[e * 10 + 9] = 0;
        e = e + 1;
    }
    // the ellipse, shrunk until everything fits
    const fx0 : f64 = 4.0;
    const fy0 : f64 = 4.0;
    const fx1 : f64 = w - 4.0;
    const fy1 : f64 = h - 4.0;
    var rx : f64 = jsmax(0.0, w / 2.0 - maxw / 2.0 - 6.0);
    var ry : f64 = jsmax(0.0, h / 2.0 - maxh / 2.0 - 6.0);
    var pass : u32 = 0;
    var done : bool = false;
    while (pass < 12 and !done) {
        place(n, ne, rx, ry, w, h, edgefont, edge_char_w, loop_r, nodes, ef, eu, order, fw, trig);
        // bounds
        var bx0 : f64 = inf();
        var by0 : f64 = inf();
        var bx1 : f64 = 0.0 - inf();
        var by1 : f64 = 0.0 - inf();
        i = 0;
        while (i < n) {
            const x : f64 = nodes[i * 4];
            const y : f64 = nodes[i * 4 + 1];
            const nw : f64 = nodes[i * 4 + 2];
            const nh : f64 = nodes[i * 4 + 3];
            bx0 = jsmin(bx0, x - nw / 2.0 - 6.0);
            by0 = jsmin(by0, y - nh / 2.0 - 6.0);
            bx1 = jsmax(bx1, x + nw / 2.0 + 6.0);
            by1 = jsmax(by1, y + nh / 2.0 + 6.0);
            i = i + 1;
        }
        e = 0;
        while (e < ne) {
            label_box(ef[e * 13 + 11], ef[e * 13 + 12], eu[e * 10 + 6], eu[e * 10 + 7], eu[e * 10 + 8], eu[e * 10 + 4], eu[e * 10 + 5], edgefont, edge_char_w);
            bx0 = jsmin(bx0, V[0]);
            by0 = jsmin(by0, V[1]);
            bx1 = jsmax(bx1, V[2]);
            by1 = jsmax(by1, V[3]);
            if (eu[e * 10 + 2] == 1) {
                var s : u32 = 0;
                while (s < 3) {
                    var t : f64 = 0.25;
                    if (s == 1) { t = 0.5; }
                    if (s == 2) { t = 0.75; }
                    const u1 : f64 = 1.0 - t;
                    const k0 : f64 = u1 * u1 * u1;
                    const k1 : f64 = 3.0 * (u1 * u1) * t;
                    const k2 : f64 = 3.0 * u1 * t * t;
                    const k3 : f64 = t * t * t;
                    const x : f64 = k0 * ef[e * 13] + k1 * ef[e * 13 + 2] + k2 * ef[e * 13 + 4] + k3 * ef[e * 13 + 6];
                    const y : f64 = k0 * ef[e * 13 + 1] + k1 * ef[e * 13 + 3] + k2 * ef[e * 13 + 5] + k3 * ef[e * 13 + 7];
                    bx0 = jsmin(bx0, x - 2.0);
                    by0 = jsmin(by0, y - 2.0);
                    bx1 = jsmax(bx1, x + 2.0);
                    by1 = jsmax(by1, y + 2.0);
                    s = s + 1;
                }
            }
            e = e + 1;
        }
        const ox : f64 = jsmax(jsmax(0.0, fx0 - bx0), bx1 - fx1);
        const oy : f64 = jsmax(jsmax(0.0, fy0 - by0), by1 - fy1);
        if (ox < 1.0 and oy < 1.0) {
            done = true;
        } else {
            rx = jsmax(0.0, rx - ox - 1.0);
            ry = jsmax(0.0, ry - oy - 1.0);
        }
        pass = pass + 1;
    }
    return ne;
}

/// place(rx, ry): the node centres on the ellipse, the edge curves, then the edge labels.
pub fn place(n: usize, ne: usize, rx: f64, ry: f64, w: f64, h: f64, edgefont: f64, edge_char_w: f64, loop_r: f64, nodes: []f64, ef: []f64, eu: []u32, order: []u32, fw: []f64, trig: []const f64) {
    const cx : f64 = w / 2.0;
    const cy : f64 = h / 2.0;
    var i : usize = 0;
    while (i < n) {
        nodes[i * 4] = cx;
        nodes[i * 4 + 1] = cy;
        i = i + 1;
    }
    if (n != 1) {
        var k : usize = 0;
        while (k < n) {
            const st : usize = order[k] as usize;
            nodes[st * 4] = cx + rx * trig[k * 2];
            nodes[st * 4 + 1] = cy + ry * trig[k * 2 + 1];
            k = k + 1;
        }
    }
    var e : usize = 0;
    while (e < ne) {
        const af : usize = eu[e * 10] as usize;
        const bt : usize = eu[e * 10 + 1] as usize;
        const ax : f64 = nodes[af * 4];
        const ay : f64 = nodes[af * 4 + 1];
        const aw : f64 = nodes[af * 4 + 2];
        const ah : f64 = nodes[af * 4 + 3];
        const o : usize = e * 13;
        if (eu[e * 10 + 2] == 1) {
            var ux : f64 = 0.0;
            var uy : f64 = 0.0 - 1.0;
            if (n != 1) {
                unit_to(ax - cx, ay - cy);
                ux = V[0];
                uy = V[1];
            }
            rot_to(ux, uy, trig[2 * n], trig[2 * n + 1]);
            box_exit(ax, ay, aw, ah, V[0], V[1], 0.0);
            const p0x : f64 = V[0];
            const p0y : f64 = V[1];
            rot_to(ux, uy, trig[2 * n + 2], trig[2 * n + 3]);
            box_exit(ax, ay, aw, ah, V[0], V[1], 0.0);
            const p1x : f64 = V[0];
            const p1y : f64 = V[1];
            rot_to(ux, uy, trig[2 * n + 4], trig[2 * n + 5]);
            const c1x : f64 = ax + V[0] * (loop_r * 1.6 + aw / 5.0);
            const c1y : f64 = ay + V[1] * (loop_r * 1.6 + ah / 3.0);
            rot_to(ux, uy, trig[2 * n + 6], trig[2 * n + 7]);
            const c2x : f64 = ax + V[0] * (loop_r * 1.6 + aw / 5.0);
            const c2y : f64 = ay + V[1] * (loop_r * 1.6 + ah / 3.0);
            const apx : f64 = 0.125 * p0x + 0.375 * c1x + 0.375 * c2x + 0.125 * p1x;
            const apy : f64 = 0.125 * p0y + 0.375 * c1y + 0.375 * c2y + 0.125 * p1y;
            ef[o] = p0x;
            ef[o + 1] = p0y;
            ef[o + 2] = c1x;
            ef[o + 3] = c1y;
            ef[o + 4] = c2x;
            ef[o + 5] = c2y;
            ef[o + 6] = p1x;
            ef[o + 7] = p1y;
            ef[o + 8] = p1x;
            ef[o + 9] = p1y;
            ef[o + 10] = 0.0;
            ef[o + 11] = apx + ux * edgefont * 0.5;
            ef[o + 12] = apy + uy * edgefont * 0.5;
            eu[e * 10 + 6] = anchor_of(ux);
            eu[e * 10 + 7] = valign_of(uy);
        } else {
            const bx : f64 = nodes[bt * 4];
            const by : f64 = nodes[bt * 4 + 1];
            const bw : f64 = nodes[bt * 4 + 2];
            const bh : f64 = nodes[bt * 4 + 3];
            const dx : f64 = bx - ax;
            const dy : f64 = by - ay;
            var len : f64 = hypot2(dx, dy);
            if (!truthy(len)) { len = 1.0; }
            const nx : f64 = -dy / len;
            const ny : f64 = dx / len;
            var back : bool = false;
            var q : usize = 0;
            while (q < ne and !back) {
                if (eu[q * 10] == eu[e * 10 + 1] and eu[q * 10 + 1] == eu[e * 10]) { back = true; }
                q = q + 1;
            }
            var bend : f64 = len * 0.1;
            if (back) { bend = len * 0.2; }
            const cxx : f64 = (ax + bx) / 2.0 + nx * bend;
            const cyy : f64 = (ay + by) / 2.0 + ny * bend;
            unit_to(cxx - ax, cyy - ay);
            box_exit(ax, ay, aw, ah, V[0], V[1], 0.0);
            const p0x : f64 = V[0];
            const p0y : f64 = V[1];
            unit_to(cxx - bx, cyy - by);
            box_exit(bx, by, bw, bh, V[0], V[1], 2.0);
            const p1x : f64 = V[0];
            const p1y : f64 = V[1];
            ef[o] = p0x;
            ef[o + 1] = p0y;
            ef[o + 2] = cxx;
            ef[o + 3] = cyy;
            ef[o + 4] = 0.0;
            ef[o + 5] = 0.0;
            ef[o + 6] = p1x;
            ef[o + 7] = p1y;
            ef[o + 8] = p1x;
            ef[o + 9] = p1y;
            ef[o + 10] = 0.0;
        }
        e = e + 1;
    }
    place_labels(n, ne, w, h, edgefont, edge_char_w, nodes, ef, eu, fw);
}

/// placeLabels: self-loop labels stay at the loop's apex; every other label tries points along its curve
/// on either side and takes the cheapest. fw holds the boxes already taken, 4 f64 each.
pub fn place_labels(n: usize, ne: usize, w: f64, h: f64, edgefont: f64, edge_char_w: f64, nodes: []f64, ef: []f64, eu: []u32, fw: []f64) {
    var np : usize = 0;
    var i : usize = 0;
    while (i < n) {
        const x : f64 = nodes[i * 4];
        const y : f64 = nodes[i * 4 + 1];
        const nw : f64 = nodes[i * 4 + 2];
        const nh : f64 = nodes[i * 4 + 3];
        fw[np * 4] = x - nw / 2.0 - 3.0;
        fw[np * 4 + 1] = y - nh / 2.0 - 3.0;
        fw[np * 4 + 2] = x + nw / 2.0 + 3.0;
        fw[np * 4 + 3] = y + nh / 2.0 + 3.0;
        np = np + 1;
        i = i + 1;
    }
    var e : usize = 0;
    while (e < ne) {
        if (eu[e * 10 + 2] == 1) {
            label_box(ef[e * 13 + 11], ef[e * 13 + 12], eu[e * 10 + 6], eu[e * 10 + 7], eu[e * 10 + 8], eu[e * 10 + 4], eu[e * 10 + 5], edgefont, edge_char_w);
            fw[np * 4] = V[0];
            fw[np * 4 + 1] = V[1];
            fw[np * 4 + 2] = V[2];
            fw[np * 4 + 3] = V[3];
            np = np + 1;
        }
        e = e + 1;
    }
    const gx0 : f64 = 2.0;
    const gy0 : f64 = 2.0;
    const gx1 : f64 = w - 2.0;
    const gy1 : f64 = h - 2.0;
    e = 0;
    while (e < ne) {
        if (eu[e * 10 + 2] == 0) {
            const o : usize = e * 13;
            const p0x : f64 = ef[o];
            const p0y : f64 = ef[o + 1];
            const cx : f64 = ef[o + 2];
            const cy : f64 = ef[o + 3];
            const p1x : f64 = ef[o + 6];
            const p1y : f64 = ef[o + 7];
            var have : bool = false;
            var best_cost : f64 = 0.0;
            var best_x : f64 = 0.0;
            var best_y : f64 = 0.0;
            var best_anchor : u32 = 0;
            var best_valign : u32 = 0;
            var bb0 : f64 = 0.0;
            var bb1 : f64 = 0.0;
            var bb2 : f64 = 0.0;
            var bb3 : f64 = 0.0;
            var ti : u32 = 0;
            var stop : bool = false;
            while (ti < 7 and !stop) {
                var t : f64 = 0.5;
                if (ti == 1) { t = 0.4; }
                if (ti == 2) { t = 0.6; }
                if (ti == 3) { t = 0.3; }
                if (ti == 4) { t = 0.7; }
                if (ti == 5) { t = 0.22; }
                if (ti == 6) { t = 0.78; }
                const om : f64 = 1.0 - t;
                const ptx : f64 = om * om * p0x + 2.0 * om * t * cx + t * t * p1x;
                const pty : f64 = om * om * p0y + 2.0 * om * t * cy + t * t * p1y;
                unit_to(2.0 * om * (cx - p0x) + 2.0 * t * (p1x - cx), 2.0 * om * (cy - p0y) + 2.0 * t * (p1y - cy));
                const tanx : f64 = V[0];
                const tany : f64 = V[1];
                var si : u32 = 0;
                while (si < 2) {
                    var side : f64 = 1.0;
                    if (si == 1) { side = 0.0 - 1.0; }
                    const nrx : f64 = -tany * side;
                    const nry : f64 = tanx * side;
                    const lx : f64 = ptx + nrx * edgefont * 0.5;
                    const ly : f64 = pty + nry * edgefont * 0.5;
                    const anc : u32 = anchor_of(nrx);
                    const val : u32 = valign_of(nry);
                    label_box(lx, ly, anc, val, eu[e * 10 + 8], eu[e * 10 + 4], eu[e * 10 + 5], edgefont, edge_char_w);
                    const x0 : f64 = V[0];
                    const y0 : f64 = V[1];
                    const x1 : f64 = V[2];
                    const y1 : f64 = V[3];
                    const out : f64 = (x1 - x0) * (y1 - y0) - overlap(x0, y0, x1, y1, gx0, gy0, gx1, gy1);
                    var sum : f64 = 0.0;
                    var q : usize = 0;
                    while (q < np) {
                        sum = sum + overlap(x0, y0, x1, y1, fw[q * 4], fw[q * 4 + 1], fw[q * 4 + 2], fw[q * 4 + 3]);
                        q = q + 1;
                    }
                    const cost : f64 = sum + out * 4.0 + @abs(t - 0.5) * 4.0;
                    if (!have or cost < best_cost) {
                        have = true;
                        best_cost = cost;
                        best_x = lx;
                        best_y = ly;
                        best_anchor = anc;
                        best_valign = val;
                        bb0 = x0;
                        bb1 = y0;
                        bb2 = x1;
                        bb3 = y1;
                    }
                    si = si + 1;
                }
                if (have and best_cost < 1.0) { stop = true; }
                ti = ti + 1;
            }
            ef[o + 11] = best_x;
            ef[o + 12] = best_y;
            eu[e * 10 + 6] = best_anchor;
            eu[e * 10 + 7] = best_valign;
            fw[np * 4] = bb0;
            fw[np * 4 + 1] = bb1;
            fw[np * 4 + 2] = bb2;
            fw[np * 4 + 3] = bb3;
            np = np + 1;
        }
        e = e + 1;
    }
}

// ------------------------------------------------------------------------------------------------
// text helpers
// ------------------------------------------------------------------------------------------------

pub const EV : usize = 10;

pub const EV_FOUND : u32 = 1;
pub const EV_REJ : u32 = 2;
pub const EV_REASON : u32 = 3;
pub const EV_RECODE : u32 = 4;
pub const EV_FSM : u32 = 5;
pub const EV_NUM : u32 = 6;
pub const EV_IN : u32 = 7;
pub const EV_OUT : u32 = 8;
pub const EV_STATE : u32 = 9;
pub const EV_ROW : u32 = 10;
pub const EV_RESET : u32 = 11;
pub const EV_NAME : u32 = 20;
pub const EV_ROW2 : u32 = 21;
pub const EV_ILB : u32 = 22;
pub const EV_OB : u32 = 23;

pub const N_KISS2_S : u32 = 0;
pub const N_KISS2_P : u32 = 1;
pub const N_NO_RESET_NAMED : u32 = 2;
pub const N_NO_RESET : u32 = 3;
pub const N_WIDTH_IN : u32 = 4;
pub const N_RECODED : u32 = 5;
pub const N_NO_INFO : u32 = 6;

pub const E_UNKNOWN : u32 = 1;
pub const E_KISS2ROW : u32 = 2;
pub const E_NOFSMPASS : u32 = 3;

pub var M : [8]usize = [0; 8];
pub var NUMFLAG : u32 = 0;
pub var PEND : [2]usize = [0; 2];

pub fn is_ws(b: u8) -> bool {
    return b == 32 or (b >= 9 and b <= 13);
}

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

pub fn match_in(s: []const u8, p: usize, hi: usize, w: []const u8) -> bool {
    if (p + w.len > hi) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (s[p + k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// p + the length of lit when lit sits at s[p ..] inside s[.. hi], else -1.
pub fn eat(s: []const u8, p: usize, hi: usize, lit: []const u8) -> i64 {
    if (match_in(s, p, hi, lit)) { return (p + lit.len) as i64; }
    return -1;
}

pub fn span_eq(a: []const u8, alo: usize, ahi: usize, blo: usize, bhi: usize) -> bool {
    if (ahi - alo != bhi - blo) { return false; }
    var k : usize = 0;
    const n : usize = ahi - alo;
    while (k < n) {
        if (a[alo + k] != a[blo + k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn skip_ws(s: []const u8, p: usize, hi: usize) -> usize {
    var q : usize = p;
    while (q < hi and is_ws(s[q])) { q = q + 1; }
    return q;
}

pub fn skip_digits(s: []const u8, p: usize, hi: usize) -> usize {
    var q : usize = p;
    while (q < hi and is_digit(s[q])) { q = q + 1; }
    return q;
}

/// The end of the non-space run that starts at p.
pub fn tok_end(s: []const u8, p: usize, hi: usize) -> usize {
    var q : usize = p;
    while (q < hi and !is_ws(s[q])) { q = q + 1; }
    return q;
}

/// The end of the run of bytes other than ' that starts at p.
pub fn run_noquote(s: []const u8, p: usize, hi: usize) -> usize {
    var q : usize = p;
    while (q < hi and s[q] != 39) { q = q + 1; }
    return q;
}

/// The end of the run of [01\-xz] that starts at p.
pub fn run_code(s: []const u8, p: usize, hi: usize) -> usize {
    var q : usize = p;
    while (q < hi and (s[q] == 48 or s[q] == 49 or s[q] == 45 or s[q] == 120 or s[q] == 122)) { q = q + 1; }
    return q;
}

pub fn rstrip(s: []const u8, lo: usize, hi: usize) -> usize {
    var e : usize = hi;
    while (e > lo and is_ws(s[e - 1])) { e = e - 1; }
    return e;
}

/// Does s[lo .. hi] hold no carriage return? (JavaScript's . does not match one.)
pub fn no_cr(s: []const u8, lo: usize, hi: usize) -> bool {
    var i : usize = lo;
    while (i < hi) {
        if (s[i] == 13 or s[i] == 10) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn has_sub(s: []const u8, w: []const u8) -> bool {
    var p : usize = 0;
    while (p + w.len <= s.len) {
        if (match_in(s, p, s.len, w)) { return true; }
        p = p + 1;
    }
    return false;
}

/// Number(digits) for a run of ASCII digits, saturating at 2147483647 and flagging NUMFLAG = 5 above it.
pub fn dig_val(s: []const u8, lo: usize, hi: usize) -> u32 {
    var v : u64 = 0;
    var i : usize = lo;
    while (i < hi) {
        v = v * 10 + ((s[i] - 48) as u64);
        if (v > 2147483647) {
            NUMFLAG = 5;
            return 2147483647;
        }
        i = i + 1;
    }
    return v as u32;
}

/// text.split(/\r?\n/): ls gets (start, end) for every line; returns how many (0 when ls is too short).
pub fn split_nl(text: []const u8, ls: []u32) -> usize {
    if (ls.len < 2 * (text.len + 1)) { return 0; }
    var n : usize = 0;
    var start : usize = 0;
    var i : usize = 0;
    while (i < text.len) {
        if (text[i] == 10) {
            var e : usize = i;
            if (e > start and text[e - 1] == 13) { e = e - 1; }
            ls[n * 2] = start as u32;
            ls[n * 2 + 1] = e as u32;
            n = n + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    ls[n * 2] = start as u32;
    ls[n * 2 + 1] = text.len as u32;
    return n + 1;
}

// ------------------------------------------------------------------------------------------------
// Number() of a header token, and stateNum
// ------------------------------------------------------------------------------------------------

pub fn hex_val(b: u8) -> i64 {
    if (b >= 48 and b <= 57) { return (b - 48) as i64; }
    if (b >= 97 and b <= 102) { return (b - 87) as i64; }
    if (b >= 65 and b <= 70) { return (b - 55) as i64; }
    return -1;
}

/// JavaScript's Number(token) for a token with no white space. A form outside the claimed domain sets
/// NUMFLAG = 5 (see the header).
pub fn js_number(s: []const u8, lo: usize, hi: usize) -> f64 {
    var i : usize = lo;
    var neg : bool = false;
    if (i >= hi) { return 0.0; }
    if (hi - lo >= 3 and s[lo] == 48 and (s[lo + 1] == 120 or s[lo + 1] == 88 or s[lo + 1] == 111 or s[lo + 1] == 79 or s[lo + 1] == 98 or s[lo + 1] == 66)) {
        var radix : f64 = 16.0;
        if (s[lo + 1] == 111 or s[lo + 1] == 79) { radix = 8.0; }
        if (s[lo + 1] == 98 or s[lo + 1] == 66) { radix = 2.0; }
        var v : f64 = 0.0;
        var k : usize = lo + 2;
        while (k < hi) {
            const d : i64 = hex_val(s[k]);
            if (d < 0 or (d as f64) >= radix) { return nan(); }
            v = v * radix + (d as f64);
            k = k + 1;
        }
        if (hi - lo - 2 > 13 and radix == 16.0) { NUMFLAG = 5; }
        if (hi - lo - 2 > 17 and radix == 8.0) { NUMFLAG = 5; }
        if (hi - lo - 2 > 52 and radix == 2.0) { NUMFLAG = 5; }
        return v;
    }
    if (s[i] == 43 or s[i] == 45) {
        neg = s[i] == 45;
        i = i + 1;
    }
    if (match_in(s, i, hi, "Infinity") and hi - i == 8) {
        if (neg) { return 0.0 - inf(); }
        return inf();
    }
    var mant : f64 = 0.0;
    var sig : u32 = 0;
    var any : bool = false;
    var lead : bool = true;
    var frac : i64 = 0;
    while (i < hi and is_digit(s[i])) {
        any = true;
        if (s[i] != 48 or !lead) {
            lead = false;
            sig = sig + 1;
        }
        mant = mant * 10.0 + ((s[i] - 48) as f64);
        i = i + 1;
    }
    if (i < hi and s[i] == 46) {
        i = i + 1;
        while (i < hi and is_digit(s[i])) {
            any = true;
            if (s[i] != 48 or !lead) {
                lead = false;
                sig = sig + 1;
            }
            mant = mant * 10.0 + ((s[i] - 48) as f64);
            frac = frac + 1;
            i = i + 1;
        }
    }
    if (!any) { return nan(); }
    var e10 : i64 = 0;
    if (i < hi and (s[i] == 101 or s[i] == 69)) {
        i = i + 1;
        var eneg : bool = false;
        if (i < hi and (s[i] == 43 or s[i] == 45)) {
            eneg = s[i] == 45;
            i = i + 1;
        }
        const d0 : usize = i;
        var ev : i64 = 0;
        while (i < hi and is_digit(s[i])) {
            if (ev < 100000) { ev = ev * 10 + ((s[i] - 48) as i64); }
            i = i + 1;
        }
        if (i == d0) { return nan(); }
        e10 = ev;
        if (eneg) { e10 = 0 - ev; }
    }
    if (i != hi) { return nan(); }
    var result : f64 = 0.0;
    if (mant != 0.0) {
        if (sig > 15) { NUMFLAG = 5; }
        const k10 : i64 = e10 - frac;
        var p10 : f64 = 1.0;
        var q : i64 = 0;
        var ak : i64 = k10;
        if (k10 < 0) { ak = 0 - k10; }
        if (ak > 22) { NUMFLAG = 5; }
        while (q < ak and q < 22) {
            p10 = p10 * 10.0;
            q = q + 1;
        }
        if (k10 >= 0) { result = mant * p10; } else { result = mant / p10; }
    }
    if (neg) { return -result; }
    return result;
}

/// stateNum: the number of a name of the form s<digits>, or -1 (JavaScript's NaN) when it has another shape.
pub fn state_num(s: []const u8, lo: usize, hi: usize) -> i64 {
    if (hi - lo < 2 or s[lo] != 115) { return -1; }
    var v : i64 = 0;
    var i : usize = lo + 1;
    while (i < hi) {
        if (!is_digit(s[i])) { return -1; }
        v = v * 10 + ((s[i] - 48) as i64);
        if (v > 1000000000000000) {
            NUMFLAG = 5;
            return 1000000000000000;
        }
        i = i + 1;
    }
    return v;
}

// ------------------------------------------------------------------------------------------------
// sniff
// ------------------------------------------------------------------------------------------------

pub fn is_nl(b: u8) -> bool {
    return b == 10 or b == 13;
}

/// After the end of the second token of a row: (\s+[01\-]*)?\s*$ with $ at a line end.
pub fn tail_ok(s: []const u8, e2: usize) -> bool {
    var j : usize = e2;
    var go : bool = true;
    while (go) {
        if (j >= s.len) { return true; }
        if (is_nl(s[j])) { return true; }
        if (is_ws(s[j])) { j = j + 1; } else { go = false; }
    }
    if (j == e2) { return false; }
    var k : usize = j;
    while (k < s.len and (s[k] == 48 or s[k] == 49 or s[k] == 45)) { k = k + 1; }
    if (k < s.len and !is_ws(s[k])) { return false; }
    var m : usize = k;
    go = true;
    while (go) {
        if (m >= s.len) { return true; }
        if (is_nl(s[m])) { return true; }
        if (is_ws(s[m])) { m = m + 1; } else { go = false; }
    }
    return false;
}

/// /^\s*[01\-]*\s+\S+\s+\S+(\s+[01\-]*)?\s*$/m anywhere in the text.
pub fn kiss_row_anywhere(s: []const u8) -> bool {
    var p : usize = 0;
    while (p <= s.len) {
        if (p == 0 or is_nl(s[p - 1])) {
            const q0 : usize = skip_ws(s, p, s.len);
            if (q0 < s.len) {
                const e0 : usize = tok_end(s, q0, s.len);
                var all01 : bool = true;
                var c : usize = q0;
                while (c < e0) {
                    if (s[c] != 48 and s[c] != 49 and s[c] != 45) { all01 = false; }
                    c = c + 1;
                }
                if (all01) {
                    const p1 : usize = skip_ws(s, e0, s.len);
                    if (p1 > e0 and p1 < s.len) {
                        const e1 : usize = tok_end(s, p1, s.len);
                        const p2 : usize = skip_ws(s, e1, s.len);
                        if (p2 > e1 and p2 < s.len) {
                            const e2 : usize = tok_end(s, p2, s.len);
                            if (tail_ok(s, e2)) { return true; }
                        }
                    }
                }
                if (q0 > p) {
                    const p2 : usize = skip_ws(s, e0, s.len);
                    if (p2 > e0 and p2 < s.len) {
                        const e2 : usize = tok_end(s, p2, s.len);
                        if (tail_ok(s, e2)) { return true; }
                    }
                }
            }
        }
        p = p + 1;
    }
    return false;
}

/// /^\s*\.(i|s|p|r)\s+\S+/m anywhere in the text.
pub fn kiss_head_anywhere(s: []const u8) -> bool {
    var q : usize = 0;
    while (q + 2 < s.len) {
        if (s[q] == 46 and (s[q + 1] == 105 or s[q + 1] == 115 or s[q + 1] == 112 or s[q + 1] == 114) and is_ws(s[q + 2])) {
            const after : usize = skip_ws(s, q + 2, s.len);
            if (after < s.len) {
                var b : usize = q;
                while (b > 0 and is_ws(s[b - 1])) { b = b - 1; }
                var ok : bool = b == 0;
                var j : usize = b;
                while (j < q and !ok) {
                    if (is_nl(s[j])) { ok = true; }
                    j = j + 1;
                }
                if (ok) { return true; }
            }
        }
        q = q + 1;
    }
    return false;
}

/// sniff: 1 a yosys log, 2 a KISS2 file, 0 neither.
pub fn sniff(text: []const u8) -> u8 {
    if (has_sub(text, "Executing FSM_DETECT pass") or has_sub(text, "Information on FSM ") or has_sub(text, "FSM state register")) { return 1; }
    if (kiss_head_anywhere(text) and kiss_row_anywhere(text)) { return 2; }
    return 0;
}

// ------------------------------------------------------------------------------------------------
// the result stream
// ------------------------------------------------------------------------------------------------
// res (u32 x 32): [0] status, [1] ok, [2] kind (0 none, 1 log, 2 kiss2), [3] error id, [4] error line
//   offset, [5] its length, [6] version offset (4294967295 none), [7] its length, [8] detectRan (0, 1;
//   2 for a KISS2 file), [9] fsms, [10] found, [11] rejected, [12] notes, [13] words written to out,
//   [16] events used (internal), [17] nslots (internal).
// out (u32), in this order:
//   found      2 words each: offset, length
//   rejected   offset, length, number of reasons, then 2 words per reason
//   notes      5 words each: id, a0, a1, a2, 0 -- kiss2_s and kiss2_p: the header value (offset, length)
//              and the count; no_reset_named: the name (offset, length); no_info: found, fsms; width_in:
//              nums[0] holds the number
//   fsms       a 16-word header per FSM, then its states (4 words each), rows (6 words each), input
//              entries (3 words each), output entries (3 words each):
//     header   [0] id offset, [1] id length (id offset 4294967295: the id is "kiss2"), [2] module offset
//              (4294967295: null), [3] its length, [4] reg offset (4294967295: null), [5] its length,
//              [6] reset (4294967295: -1), [7] encoding offset (4294967295: null), [8] its length,
//              [9] states, [10] rows, [11] inputs array length (4294967295: null), [12] input entries,
//              [13] outputs array length (4294967295: null), [14] output entries, [15] 1 when nBits is null
//     state    name offset (4294967295: the name is "s" and the index), name length, code offset
//              (4294967295: null), code length
//     row      from, to, in offset, in length, out offset, out length
//     entry    index, offset, length (an index below the array length that has no entry is a hole)
//   nums (f64): [0] the nIn of a width_in note; then 3 per FSM: nIn, nOut, nBits.
// Offsets are in text.

pub fn ow(out: []u32, res: []u32, v: u32) {
    const at : usize = res[13] as usize;
    if (at < out.len) {
        out[at] = v;
    } else {
        if (res[0] == 0) { res[0] = 1; }
    }
    res[13] = (at + 1) as u32;
}

/// Write an event of 10 words; returns its index.
pub fn ev(work: []u32, res: []u32, tag: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32, a8: u32, a9: u32) -> usize {
    const at : usize = res[16] as usize;
    if ((at + 1) * EV > work.len) {
        if (res[0] == 0) { res[0] = 2; }
        return at;
    }
    work[at * EV] = tag;
    work[at * EV + 1] = a1;
    work[at * EV + 2] = a2;
    work[at * EV + 3] = a3;
    work[at * EV + 4] = a4;
    work[at * EV + 5] = a5;
    work[at * EV + 6] = a6;
    work[at * EV + 7] = a7;
    work[at * EV + 8] = a8;
    work[at * EV + 9] = a9;
    res[16] = (at + 1) as u32;
    return at;
}

pub fn clear_res(res: []u32, nums: []f64) {
    var k : usize = 0;
    while (k < 32) {
        res[k] = 0;
        k = k + 1;
    }
    res[6] = NONE;
    res[8] = 2;
    nums[0] = 0.0;
    NUMFLAG = 0;
}

// ------------------------------------------------------------------------------------------------
// KISS2
// ------------------------------------------------------------------------------------------------

/// Is the byte allowed in a KISS2 input or output pattern?
pub fn pat_ok(s: []const u8, lo: usize, hi: usize) -> bool {
    var i : usize = lo;
    while (i < hi) {
        if (s[i] != 48 and s[i] != 49 and s[i] != 45) { return false; }
        i = i + 1;
    }
    return true;
}

/// Index of the name s[lo .. hi] in the NAME events (or a new one).
pub fn name_index(text: []const u8, work: []u32, res: []u32, lo: usize, hi: usize) -> u32 {
    var idx : u32 = 0;
    var k : usize = 0;
    const n : usize = res[16] as usize;
    while (k < n) {
        if (work[k * EV] == EV_NAME) {
            const o : usize = work[k * EV + 1] as usize;
            if (span_eq(text, o, o + (work[k * EV + 2] as usize), lo, hi)) { return work[k * EV + 3]; }
            idx = idx + 1;
        }
        k = k + 1;
    }
    ev(work, res, EV_NAME, lo as u32, (hi - lo) as u32, idx, 0, 0, 0, 0, 0, 0);
    return idx;
}

/// parseKiss2: see "the result stream". tmp needs 4 words per state name.
pub fn parse_kiss2(text: []const u8, ls: []u32, nlines: usize, work: []u32, tmp: []u32, out: []u32, nums: []f64, res: []u32) {
    // head values: i o s p r, as (offset, length), offset NONE when undefined
    var hoff : [5]u32 = [4294967295; 5];
    var hlen : [5]u32 = [0; 5];
    var ilb_gen : u32 = 0;
    var ob_gen : u32 = 0;
    var nrows : u32 = 0;
    var stopped : bool = false;
    var li : usize = 0;
    while (li < nlines and !stopped and res[0] == 0) {
        const rlo : usize = ls[li * 2] as usize;
        const rhi : usize = ls[li * 2 + 1] as usize;
        li = li + 1;
        // strip the comment: the first # with no CR after it in the line
        var last_cr : i64 = -1;
        var c : usize = rlo;
        while (c < rhi) {
            if (text[c] == 13) { last_cr = c as i64; }
            c = c + 1;
        }
        var cut : usize = rhi;
        var found_hash : bool = false;
        c = rlo;
        while (c < rhi and !found_hash) {
            if (text[c] == 35 and (c as i64) > last_cr) {
                cut = c;
                found_hash = true;
            }
            c = c + 1;
        }
        var a : usize = rlo;
        var b : usize = cut;
        while (a < b and is_ws(text[a])) { a = a + 1; }
        while (b > a and is_ws(text[b - 1])) { b = b - 1; }
        if (b == a) { continue; }
        if (text[a] == 46) {
            const kend : usize = tok_end(text, a, b);
            if (match_in(text, a, kend, ".e") and kend - a == 2) { stopped = true; continue; }
            if (match_in(text, a, kend, ".end") and kend - a == 4) { stopped = true; continue; }
            if (match_in(text, a, kend, ".ilb") and kend - a == 4) {
                ilb_gen = ilb_gen + 1;
                var p : usize = skip_ws(text, kend, b);
                while (p < b) {
                    const e : usize = tok_end(text, p, b);
                    ev(work, res, EV_ILB, ilb_gen, p as u32, (e - p) as u32, 0, 0, 0, 0, 0, 0);
                    p = skip_ws(text, e, b);
                }
                continue;
            }
            if (match_in(text, a, kend, ".ob") and kend - a == 3) {
                ob_gen = ob_gen + 1;
                var p : usize = skip_ws(text, kend, b);
                while (p < b) {
                    const e : usize = tok_end(text, p, b);
                    ev(work, res, EV_OB, ob_gen, p as u32, (e - p) as u32, 0, 0, 0, 0, 0, 0);
                    p = skip_ws(text, e, b);
                }
                continue;
            }
            var key : i64 = -1;
            if (kend - a == 2) {
                if (text[a + 1] == 105) { key = 0; }
                if (text[a + 1] == 111) { key = 1; }
                if (text[a + 1] == 115) { key = 2; }
                if (text[a + 1] == 112) { key = 3; }
                if (text[a + 1] == 114) { key = 4; }
            }
            if (key >= 0) {
                const p : usize = skip_ws(text, kend, b);
                if (p < b) {
                    const e : usize = tok_end(text, p, b);
                    hoff[key as usize] = p as u32;
                    hlen[key as usize] = (e - p) as u32;
                } else {
                    hoff[key as usize] = NONE;
                    hlen[key as usize] = 0;
                }
            }
            continue;
        }
        // a transition row
        var ts : [5]usize = [0; 5];
        var te : [5]usize = [0; 5];
        var ntok : usize = 0;
        var p : usize = a;
        while (p < b) {
            const e : usize = tok_end(text, p, b);
            if (ntok < 5) {
                ts[ntok] = p;
                te[ntok] = e;
            }
            ntok = ntok + 1;
            p = skip_ws(text, e, b);
        }
        var nin_zero : bool = false;
        var nout_zero : bool = false;
        if (hoff[0] != NONE) { nin_zero = js_number(text, hoff[0] as usize, (hoff[0] + hlen[0]) as usize) == 0.0; }
        if (hoff[1] != NONE) { nout_zero = js_number(text, hoff[1] as usize, (hoff[1] + hlen[1]) as usize) == 0.0; }
        var io : usize = 0;
        var il : usize = 0;
        var fo : usize = 0;
        var fl : usize = 0;
        var to : usize = 0;
        var tl : usize = 0;
        var oo : usize = 0;
        var ol : usize = 0;
        var good : bool = true;
        if (ntok == 4) {
            io = ts[0]; il = te[0] - ts[0]; fo = ts[1]; fl = te[1] - ts[1]; to = ts[2]; tl = te[2] - ts[2]; oo = ts[3]; ol = te[3] - ts[3];
        } else {
            if (ntok == 3 and nin_zero) {
                fo = ts[0]; fl = te[0] - ts[0]; to = ts[1]; tl = te[1] - ts[1]; oo = ts[2]; ol = te[2] - ts[2];
            } else {
                if (ntok == 3 and nout_zero) {
                    io = ts[0]; il = te[0] - ts[0]; fo = ts[1]; fl = te[1] - ts[1]; to = ts[2]; tl = te[2] - ts[2];
                } else {
                    good = false;
                }
            }
        }
        if (good) {
            if (!pat_ok(text, io, io + il) or !pat_ok(text, oo, oo + ol)) { good = false; }
        }
        if (!good) {
            res[1] = 0;
            res[3] = E_KISS2ROW;
            res[4] = rlo as u32;
            // raw.trim()
            var ra : usize = rlo;
            var rb : usize = rhi;
            while (ra < rb and is_ws(text[ra])) { ra = ra + 1; }
            while (rb > ra and is_ws(text[rb - 1])) { rb = rb - 1; }
            res[4] = ra as u32;
            res[5] = (rb - ra) as u32;
            return;
        }
        const fi : u32 = name_index(text, work, res, fo, fo + fl);
        const ti : u32 = name_index(text, work, res, to, to + tl);
        ev(work, res, EV_ROW2, fi, ti, io as u32, il as u32, oo as u32, ol as u32, 0, 0, 0);
        nrows = nrows + 1;
    }
    if (res[0] != 0) { return; }
    // names
    var nnames : usize = 0;
    var k : usize = 0;
    const nev : usize = res[16] as usize;
    while (k < nev) {
        if (work[k * EV] == EV_NAME) { nnames = nnames + 1; }
        k = k + 1;
    }
    if (hoff[0] == NONE and hoff[2] == NONE and nrows == 0) {
        res[1] = 0;
        res[3] = E_UNKNOWN;
        return;
    }
    if (tmp.len < 4 * (nnames + 1)) {
        res[0] = 2;
        return;
    }
    // tmp[0 .. n]: order (new position -> old index); tmp[n .. 2n]: remap (old -> new); numbers in tmp[2n ..]
    var all_num : bool = nnames > 0;
    k = 0;
    var ni : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_NAME) {
            const o : usize = work[k * EV + 1] as usize;
            const sn : i64 = state_num(text, o, o + (work[k * EV + 2] as usize));
            if (sn < 0) { all_num = false; }
            tmp[ni] = ni as u32;
            ni = ni + 1;
        }
        k = k + 1;
    }
    if (all_num) {
        // stable insertion sort of the order by state number (the numbers are kept in two words each below)
        var i : usize = 1;
        while (i < nnames) {
            const cur : u32 = tmp[i];
            const cv : i64 = state_num_of(text, work, nev, cur as usize);
            var j : usize = i;
            while (j > 0 and state_num_of(text, work, nev, tmp[j - 1] as usize) > cv) {
                tmp[j] = tmp[j - 1];
                j = j - 1;
            }
            tmp[j] = cur;
            i = i + 1;
        }
    }
    var q : usize = 0;
    while (q < nnames) {
        tmp[nnames + (tmp[q] as usize)] = q as u32;
        q = q + 1;
    }
    // results
    res[1] = 1;
    res[2] = 2;
    res[9] = 1;
    // nIn, nOut
    var nin : f64 = 0.0;
    var nout : f64 = 0.0;
    var first_in : u32 = NONE;
    var first_out : u32 = NONE;
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_ROW2) {
            first_in = work[k * EV + 4];
            first_out = work[k * EV + 6];
            k = nev;
        } else {
            k = k + 1;
        }
    }
    if (first_in == NONE) { first_in = 0; first_out = 0; }
    if (hoff[0] != NONE) { nin = js_number(text, hoff[0] as usize, (hoff[0] + hlen[0]) as usize); } else { nin = first_in as f64; }
    if (hoff[1] != NONE) { nout = js_number(text, hoff[1] as usize, (hoff[1] + hlen[1]) as usize); } else { nout = first_out as f64; }
    // reset
    var reset : u32 = NONE;
    var has_reset_name : bool = hoff[4] != NONE;
    if (has_reset_name) {
        q = 0;
        while (q < nnames) {
            const oi : usize = tmp[q] as usize;
            const nm : usize = name_event(work, nev, oi);
            const no : usize = work[nm * EV + 1] as usize;
            if (span_eq(text, no, no + (work[nm * EV + 2] as usize), hoff[4] as usize, (hoff[4] + hlen[4]) as usize) and reset == NONE) { reset = q as u32; }
            q = q + 1;
        }
    }
    // notes
    var notes : u32 = 0;
    var out_notes_at : usize = 0;
    // found, rejected: none
    res[10] = 0;
    res[11] = 0;
    // count the notes first to write the count, then write them
    // kiss2_s
    if (hoff[2] != NONE and js_number(text, hoff[2] as usize, (hoff[2] + hlen[2]) as usize) != (nnames as f64)) {
        ow(out, res, N_KISS2_S);
        ow(out, res, hoff[2]);
        ow(out, res, hlen[2]);
        ow(out, res, nnames as u32);
        ow(out, res, 0);
        notes = notes + 1;
    }
    if (hoff[3] != NONE and js_number(text, hoff[3] as usize, (hoff[3] + hlen[3]) as usize) != (nrows as f64)) {
        ow(out, res, N_KISS2_P);
        ow(out, res, hoff[3]);
        ow(out, res, hlen[3]);
        ow(out, res, nrows);
        ow(out, res, 0);
        notes = notes + 1;
    }
    if (has_reset_name and reset == NONE) {
        ow(out, res, N_NO_RESET_NAMED);
        ow(out, res, hoff[4]);
        ow(out, res, hlen[4]);
        ow(out, res, 0);
        ow(out, res, 0);
        notes = notes + 1;
    }
    if (!has_reset_name) {
        ow(out, res, N_NO_RESET);
        ow(out, res, 0);
        ow(out, res, 0);
        ow(out, res, 0);
        ow(out, res, 0);
        notes = notes + 1;
    }
    var width_bad : bool = false;
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_ROW2) {
            if ((work[k * EV + 4] as f64) != nin) { width_bad = true; }
        }
        k = k + 1;
    }
    if (width_bad) {
        ow(out, res, N_WIDTH_IN);
        ow(out, res, 0);
        ow(out, res, 0);
        ow(out, res, 0);
        ow(out, res, 0);
        nums[0] = nin;
        notes = notes + 1;
    }
    res[12] = notes;
    // the FSM block
    var in_len : u32 = NONE;
    var n_in_ent : u32 = 0;
    var out_len : u32 = NONE;
    var n_out_ent : u32 = 0;
    if (ilb_gen > 0) {
        var cnt : u32 = 0;
        k = 0;
        while (k < nev) {
            if (work[k * EV] == EV_ILB and work[k * EV + 1] == ilb_gen) { cnt = cnt + 1; }
            k = k + 1;
        }
        if ((cnt as f64) == nin) {
            in_len = cnt;
            n_in_ent = cnt;
        }
    }
    if (ob_gen > 0) {
        var cnt : u32 = 0;
        k = 0;
        while (k < nev) {
            if (work[k * EV] == EV_OB and work[k * EV + 1] == ob_gen) { cnt = cnt + 1; }
            k = k + 1;
        }
        if ((cnt as f64) == nout) {
            out_len = cnt;
            n_out_ent = cnt;
        }
    }
    ow(out, res, NONE);
    ow(out, res, 0);
    ow(out, res, NONE);
    ow(out, res, 0);
    ow(out, res, NONE);
    ow(out, res, 0);
    ow(out, res, reset);
    ow(out, res, NONE);
    ow(out, res, 0);
    ow(out, res, nnames as u32);
    ow(out, res, nrows);
    ow(out, res, in_len);
    ow(out, res, n_in_ent);
    ow(out, res, out_len);
    ow(out, res, n_out_ent);
    ow(out, res, 1);
    nums[1] = nin;
    nums[2] = nout;
    nums[3] = 0.0;
    q = 0;
    while (q < nnames) {
        const oi : usize = tmp[q] as usize;
        const nm : usize = name_event(work, nev, oi);
        ow(out, res, work[nm * EV + 1]);
        ow(out, res, work[nm * EV + 2]);
        ow(out, res, NONE);
        ow(out, res, 0);
        q = q + 1;
    }
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_ROW2) {
            ow(out, res, tmp[nnames + (work[k * EV + 1] as usize)]);
            ow(out, res, tmp[nnames + (work[k * EV + 2] as usize)]);
            ow(out, res, work[k * EV + 3]);
            ow(out, res, work[k * EV + 4]);
            ow(out, res, work[k * EV + 5]);
            ow(out, res, work[k * EV + 6]);
        }
        k = k + 1;
    }
    if (n_in_ent > 0) {
        // inputs = ilb.slice().reverse(): entry i is the (len - 1 - i)-th token
        var seen : u32 = 0;
        k = 0;
        while (k < nev) {
            if (work[k * EV] == EV_ILB and work[k * EV + 1] == ilb_gen) {
                ow(out, res, in_len - 1 - seen);
                ow(out, res, work[k * EV + 2]);
                ow(out, res, work[k * EV + 3]);
                seen = seen + 1;
            }
            k = k + 1;
        }
    }
    if (n_out_ent > 0) {
        var seen : u32 = 0;
        k = 0;
        while (k < nev) {
            if (work[k * EV] == EV_OB and work[k * EV + 1] == ob_gen) {
                ow(out, res, out_len - 1 - seen);
                ow(out, res, work[k * EV + 2]);
                ow(out, res, work[k * EV + 3]);
                seen = seen + 1;
            }
            k = k + 1;
        }
    }
}

/// The event index of the idx-th NAME event.
pub fn name_event(work: []const u32, nev: usize, idx: usize) -> usize {
    var seen : usize = 0;
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_NAME) {
            if (seen == idx) { return k; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return 0;
}

pub fn state_num_of(text: []const u8, work: []const u32, nev: usize, idx: usize) -> i64 {
    const e : usize = name_event(work, nev, idx);
    const o : usize = work[e * EV + 1] as usize;
    return state_num(text, o, o + (work[e * EV + 2] as usize));
}

// ------------------------------------------------------------------------------------------------
// the yosys log
// ------------------------------------------------------------------------------------------------

/// ^Found FSM state register (\S+?)\.?\s*$  -> M[0..1] the name.
pub fn m_found(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : i64 = eat(s, lo, hi, "Found FSM state register ");
    if (p < 0) { return false; }
    const a : usize = p as usize;
    if (a >= hi or is_ws(s[a])) { return false; }
    const e : usize = tok_end(s, a, hi);
    if (skip_ws(s, e, hi) != hi) { return false; }
    var x : usize = e;
    if (e - a >= 2 and s[e - 1] == 46) { x = e - 1; }
    M[0] = a;
    M[1] = x;
    return true;
}

/// ^Not marking (\S+) as FSM state register:\s*$  -> M[0..1] the register.
pub fn m_not_marking(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : i64 = eat(s, lo, hi, "Not marking ");
    if (p < 0) { return false; }
    const a : usize = p as usize;
    const e : usize = tok_end(s, a, hi);
    if (e == a) { return false; }
    const q : i64 = eat(s, e, hi, " as FSM state register:");
    if (q < 0) { return false; }
    if (skip_ws(s, q as usize, hi) != hi) { return false; }
    M[0] = a;
    M[1] = e;
    return true;
}

/// ^Recoding FSM `([^']+)' from module `([^']+)' using `([^']+)' encoding:  -> M[0..1] the FSM, M[2..3] the encoding.
pub fn m_recoding(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : i64 = eat(s, lo, hi, "Recoding FSM `");
    if (p < 0) { return false; }
    const a0 : usize = p as usize;
    const a1 : usize = run_noquote(s, a0, hi);
    if (a1 == a0) { return false; }
    const q : i64 = eat(s, a1, hi, "' from module `");
    if (q < 0) { return false; }
    const b0 : usize = q as usize;
    const b1 : usize = run_noquote(s, b0, hi);
    if (b1 == b0) { return false; }
    const r : i64 = eat(s, b1, hi, "' using `");
    if (r < 0) { return false; }
    const c0 : usize = r as usize;
    const c1 : usize = run_noquote(s, c0, hi);
    if (c1 == c0) { return false; }
    if (eat(s, c1, hi, "' encoding:") < 0) { return false; }
    M[0] = a0;
    M[1] = a1;
    M[2] = c0;
    M[3] = c1;
    return true;
}

/// mapping auto encoding to `([^`']+)'?`?  anywhere  -> M[0..1].
pub fn m_mapping(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = lo;
    while (p < hi) {
        const q : i64 = eat(s, p, hi, "mapping auto encoding to `");
        if (q >= 0) {
            const a : usize = q as usize;
            var r : usize = a;
            while (r < hi and s[r] != 96 and s[r] != 39) { r = r + 1; }
            if (r > a) {
                M[0] = a;
                M[1] = r;
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

/// ^\s*Information on FSM (\S+) \((.+)\):\s*$  -> M[0..1] the id, M[2..3] the register.
pub fn m_info(s: []const u8, lo: usize, hi: usize) -> bool {
    const p0 : usize = skip_ws(s, lo, hi);
    const p : i64 = eat(s, p0, hi, "Information on FSM ");
    if (p < 0) { return false; }
    const a : usize = p as usize;
    const e : usize = tok_end(s, a, hi);
    if (e == a) { return false; }
    const q : i64 = eat(s, e, hi, " (");
    if (q < 0) { return false; }
    const c : usize = q as usize;
    const re : usize = rstrip(s, lo, hi);
    if (re < c + 3) { return false; }
    if (s[re - 2] != 41 or s[re - 1] != 58) { return false; }
    if (!no_cr(s, c, re - 2)) { return false; }
    M[0] = a;
    M[1] = e;
    M[2] = c;
    M[3] = re - 2;
    return true;
}

/// ^\s*<label>\s*(\d+)  -> M[0..1] the digits.
pub fn m_number_line(s: []const u8, lo: usize, hi: usize, label: []const u8) -> bool {
    const p0 : usize = skip_ws(s, lo, hi);
    const p : i64 = eat(s, p0, hi, label);
    if (p < 0) { return false; }
    const a : usize = skip_ws(s, p as usize, hi);
    const e : usize = skip_digits(s, a, hi);
    if (e == a) { return false; }
    M[0] = a;
    M[1] = e;
    return true;
}

/// ^\s*<label>\s*$
pub fn is_header(s: []const u8, lo: usize, hi: usize, label: []const u8) -> bool {
    const p0 : usize = skip_ws(s, lo, hi);
    const p : i64 = eat(s, p0, hi, label);
    if (p < 0) { return false; }
    return skip_ws(s, p as usize, hi) == hi;
}

/// RULE: ^-{10,}\s*$
pub fn is_rule(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = lo;
    while (p < hi and s[p] == 45) { p = p + 1; }
    if (p - lo < 10) { return false; }
    return skip_ws(s, p, hi) == hi;
}

/// ^\s{2,}\S
pub fn is_indented(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    return p - lo >= 2 and p < hi;
}

/// ^\s*(\d+):\s+(.+?)\s*$  -> M[0..1] the index, M[2..3] the text.
pub fn m_index_line(s: []const u8, lo: usize, hi: usize) -> bool {
    const p0 : usize = skip_ws(s, lo, hi);
    const d : usize = skip_digits(s, p0, hi);
    if (d == p0) { return false; }
    if (d >= hi or s[d] != 58) { return false; }
    const q : usize = skip_ws(s, d + 1, hi);
    if (q == d + 1) { return false; }
    M[0] = p0;
    M[1] = d;
    if (q < hi) {
        const e : usize = rstrip(s, q, hi);
        if (!no_cr(s, q, e)) { return false; }
        M[2] = q;
        M[3] = e;
        return true;
    }
    // only white space after the colon: the lazy group takes one character that . can match, the last
    // such one that leaves a space for \s+
    var j : usize = hi;
    while (j > d + 2) {
        j = j - 1;
        if (s[j] != 13 and s[j] != 10) {
            M[2] = j;
            M[3] = j + 1;
            return true;
        }
    }
    return false;
}

/// ^\s*(\d+):\s+(\d+)'([01\-xz]*)(\s+<RESET STATE>)?\s*$  -> M[0..1] the index, M[2..3] the code, M[4] 1 for RESET.
pub fn m_encoding_line(s: []const u8, lo: usize, hi: usize) -> bool {
    const p0 : usize = skip_ws(s, lo, hi);
    const d : usize = skip_digits(s, p0, hi);
    if (d == p0) { return false; }
    if (d >= hi or s[d] != 58) { return false; }
    const q : usize = skip_ws(s, d + 1, hi);
    if (q == d + 1) { return false; }
    const w : usize = skip_digits(s, q, hi);
    if (w == q) { return false; }
    if (w >= hi or s[w] != 39) { return false; }
    const c0 : usize = w + 1;
    const c1 : usize = run_code(s, c0, hi);
    var reset : usize = 0;
    if (skip_ws(s, c1, hi) != hi) {
        if (!(c1 < hi and is_ws(s[c1]))) { return false; }
        const t : usize = skip_ws(s, c1, hi);
        const u : i64 = eat(s, t, hi, "<RESET STATE>");
        if (u < 0) { return false; }
        if (skip_ws(s, u as usize, hi) != hi) { return false; }
        reset = 1;
    }
    M[0] = p0;
    M[1] = d;
    M[2] = c0;
    M[3] = c1;
    M[4] = reset;
    return true;
}

/// ^\s*\d+:\s+(\d+)\s+(\d+)'([01\-xz]*)\s+->\s+(\d+)\s+(\d+)'([01\-xz]*)\s*$
/// -> M[0..1] from, M[2..3] in, M[4..5] to, M[6..7] out.
pub fn m_row_line(s: []const u8, lo: usize, hi: usize) -> bool {
    const p0 : usize = skip_ws(s, lo, hi);
    const d : usize = skip_digits(s, p0, hi);
    if (d == p0) { return false; }
    if (d >= hi or s[d] != 58) { return false; }
    const q : usize = skip_ws(s, d + 1, hi);
    if (q == d + 1) { return false; }
    const f1 : usize = skip_digits(s, q, hi);
    if (f1 == q) { return false; }
    const w0 : usize = skip_ws(s, f1, hi);
    if (w0 == f1) { return false; }
    const w1 : usize = skip_digits(s, w0, hi);
    if (w1 == w0) { return false; }
    if (w1 >= hi or s[w1] != 39) { return false; }
    const i0 : usize = w1 + 1;
    const i1 : usize = run_code(s, i0, hi);
    const a0 : usize = skip_ws(s, i1, hi);
    if (a0 == i1) { return false; }
    const ar : i64 = eat(s, a0, hi, "->");
    if (ar < 0) { return false; }
    const b0 : usize = skip_ws(s, ar as usize, hi);
    if (b0 == (ar as usize)) { return false; }
    const t1 : usize = skip_digits(s, b0, hi);
    if (t1 == b0) { return false; }
    const c0 : usize = skip_ws(s, t1, hi);
    if (c0 == t1) { return false; }
    const c1 : usize = skip_digits(s, c0, hi);
    if (c1 == c0) { return false; }
    if (c1 >= hi or s[c1] != 39) { return false; }
    const o0 : usize = c1 + 1;
    const o1 : usize = run_code(s, o0, hi);
    if (skip_ws(s, o1, hi) != hi) { return false; }
    M[0] = q;
    M[1] = f1;
    M[2] = i0;
    M[3] = i1;
    M[4] = b0;
    M[5] = t1;
    M[6] = o0;
    M[7] = o1;
    return true;
}

/// /^FSM `.+' from module `.+':/
pub fn is_fsm_module_line(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : i64 = eat(s, lo, hi, "FSM `");
    if (p < 0) { return false; }
    const p0 : usize = p as usize;
    var u : usize = p0 + 1;
    while (u < hi and no_cr(s, p0, u)) {
        if (match_in(s, u, hi, "' from module `")) {
            var v : usize = u + 16;
            while (v < hi and no_cr(s, u + 15, v)) {
                if (match_in(s, v, hi, "':")) { return true; }
                v = v + 1;
            }
        }
        u = u + 1;
    }
    return false;
}

/// /from module `([^']+)'/  -> M[0..1].
pub fn m_module_name(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = lo;
    while (p < hi) {
        const q : i64 = eat(s, p, hi, "from module `");
        if (q >= 0) {
            const a : usize = q as usize;
            const r : usize = run_noquote(s, a, hi);
            if (r > a and r < hi) {
                M[0] = a;
                M[1] = r;
                return true;
            }
        }
        p = p + 1;
    }
    return false;
}

/// The offset after an optional leading backslash (unslash).
pub fn unslash(s: []const u8, lo: usize, hi: usize) -> usize {
    if (lo < hi and s[lo] == 92) { return lo + 1; }
    return lo;
}

/// \bYosys (\d+\.\d+[^\s(]*)  first match in the text  -> M[0..1].
pub fn m_yosys_version(s: []const u8) -> bool {
    var p : usize = 0;
    while (p < s.len) {
        const q : i64 = eat(s, p, s.len, "Yosys ");
        var word_before : bool = false;
        if (p > 0) {
            const b : u8 = s[p - 1];
            word_before = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95;
        }
        if (q >= 0 and !word_before) {
            const a : usize = q as usize;
            const d1 : usize = skip_digits(s, a, s.len);
            if (d1 > a and d1 < s.len and s[d1] == 46) {
                const d2 : usize = skip_digits(s, d1 + 1, s.len);
                if (d2 > d1 + 1) {
                    var e : usize = d2;
                    while (e < s.len and !is_ws(s[e]) and s[e] != 40) { e = e + 1; }
                    M[0] = a;
                    M[1] = e;
                    return true;
                }
            }
        }
        p = p + 1;
    }
    return false;
}

/// The slot of the FSM with this id (first set), or -1; gen_out[0] gets how many times it was set.
pub fn find_slot(text: []const u8, work: []const u32, nev: usize, lo: usize, hi: usize) -> i64 {
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_FSM) {
            const o : usize = work[k * EV + 2] as usize;
            if (span_eq(text, o, o + (work[k * EV + 3] as usize), lo, hi)) { return work[k * EV + 1] as i64; }
        }
        k = k + 1;
    }
    return -1;
}

pub fn count_sets(work: []const u32, nev: usize, slot: u32) -> u32 {
    var n : u32 = 0;
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_FSM and work[k * EV + 1] == slot) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

/// parseLog: see "the result stream".
pub fn parse_log(text: []const u8, ls: []u32, nlines: usize, work: []u32, out: []u32, nums: []f64, res: []u32) {
    res[2] = 1;
    res[8] = 0;
    if (has_sub(text, "Executing FSM_DETECT pass")) { res[8] = 1; }
    if (m_yosys_version(text)) {
        res[6] = M[0] as u32;
        res[7] = (M[1] - M[0]) as u32;
    }
    var cur_slot : i64 = -1;
    var cur_gen : u32 = 0;
    var section : u32 = 0;
    var pending : i64 = -1;
    var nslots : u32 = 0;
    var k : usize = 0;
    while (k < nlines and res[0] == 0) {
        const lo : usize = ls[k * 2] as usize;
        const hi : usize = ls[k * 2 + 1] as usize;
        const nev0 : usize = res[16] as usize;
        if (m_found(text, lo, hi)) {
            const a : usize = M[0];
            const b : usize = M[1];
            var dup : bool = false;
            var e : usize = 0;
            while (e < nev0 and !dup) {
                if (work[e * EV] == EV_FOUND) {
                    const o : usize = work[e * EV + 1] as usize;
                    if (span_eq(text, o, o + (work[e * EV + 2] as usize), a, b)) { dup = true; }
                }
                e = e + 1;
            }
            if (!dup) { ev(work, res, EV_FOUND, a as u32, (b - a) as u32, 0, 0, 0, 0, 0, 0, 0); }
            k = k + 1;
            continue;
        }
        if (m_not_marking(text, lo, hi)) {
            const ra : usize = M[0];
            const rb : usize = M[1];
            // the reasons: the following lines that start with two or more spaces and have text
            var nr : usize = 0;
            while (k + 1 + nr < nlines and is_indented(text, ls[(k + 1 + nr) * 2] as usize, ls[(k + 1 + nr) * 2 + 1] as usize)) { nr = nr + 1; }
            var prev : i64 = -1;
            var e : usize = 0;
            while (e < nev0 and prev < 0) {
                if (work[e * EV] == EV_REJ) {
                    const o : usize = work[e * EV + 1] as usize;
                    if (span_eq(text, o, o + (work[e * EV + 2] as usize), ra, rb)) { prev = e as i64; }
                }
                e = e + 1;
            }
            var target : usize = 0;
            if (prev < 0) { target = ev(work, res, EV_REJ, ra as u32, (rb - ra) as u32, 0, 0, 0, 0, 0, 0, 0); } else { target = prev as usize; }
            var j : usize = 0;
            while (j < nr) {
                var ra2 : usize = ls[(k + 1 + j) * 2] as usize;
                var rb2 : usize = ls[(k + 1 + j) * 2 + 1] as usize;
                while (ra2 < rb2 and is_ws(text[ra2])) { ra2 = ra2 + 1; }
                rb2 = rstrip(text, ra2, rb2);
                var present : bool = false;
                if (prev >= 0) {
                    const nevc : usize = res[16] as usize;
                    var f : usize = 0;
                    while (f < nevc and !present) {
                        if (work[f * EV] == EV_REASON and (work[f * EV + 1] as usize) == target) {
                            const o : usize = work[f * EV + 2] as usize;
                            if (span_eq(text, o, o + (work[f * EV + 3] as usize), ra2, rb2)) { present = true; }
                        }
                        f = f + 1;
                    }
                }
                if (!present) { ev(work, res, EV_REASON, target as u32, ra2 as u32, (rb2 - ra2) as u32, 0, 0, 0, 0, 0, 0); }
                j = j + 1;
            }
            k = k + 1 + nr;
            continue;
        }
        if (m_recoding(text, lo, hi)) {
            ev(work, res, EV_RECODE, M[0] as u32, (M[1] - M[0]) as u32, M[2] as u32, (M[3] - M[2]) as u32, 0, 0, 0, 0, 0);
            pending = ev_last_index(res);
            // remember which FSM id is pending: the id span itself
            pend_lo_set(M[0], M[1]);
            k = k + 1;
            continue;
        }
        if (pending >= 0 and m_mapping(text, lo, hi)) {
            ev(work, res, EV_RECODE, PEND[0] as u32, (PEND[1] - PEND[0]) as u32, M[0] as u32, (M[1] - M[0]) as u32, 0, 0, 0, 0, 0);
            pending = -1;
            k = k + 1;
            continue;
        }
        if (m_info(text, lo, hi)) {
            const ia : usize = M[0];
            const ib : usize = M[1];
            const ra : usize = unslash(text, M[2], M[3]);
            const rb : usize = M[3];
            // the module: the nearest of the previous four lines that is an "FSM `..' from module `..':" line
            var mod_lo : u32 = NONE;
            var mod_len : u32 = 0;
            var from_line : usize = 0;
            if (k > 4) { from_line = k - 4; }
            var back : usize = k;
            var found_line : bool = false;
            while (back > from_line and !found_line) {
                back = back - 1;
                if (is_fsm_module_line(text, ls[back * 2] as usize, ls[back * 2 + 1] as usize)) { found_line = true; }
            }
            if (found_line) {
                if (m_module_name(text, ls[back * 2] as usize, ls[back * 2 + 1] as usize)) {
                    const mo : usize = unslash(text, M[0], M[1]);
                    mod_lo = mo as u32;
                    mod_len = (M[1] - mo) as u32;
                } else {
                    res[0] = 6;
                    return;
                }
            }
            var slot : i64 = find_slot(text, work, nev0, ia, ib);
            var gen : u32 = 0;
            if (slot < 0) {
                slot = nslots as i64;
                nslots = nslots + 1;
            } else {
                gen = count_sets(work, nev0, slot as u32);
            }
            ev(work, res, EV_FSM, slot as u32, ia as u32, (ib - ia) as u32, mod_lo, mod_len, ra as u32, (rb - ra) as u32, 0, gen);
            cur_slot = slot;
            cur_gen = gen;
            section = 0;
            k = k + 1;
            continue;
        }
        if (cur_slot < 0) {
            k = k + 1;
            continue;
        }
        const cs : u32 = cur_slot as u32;
        if (m_number_line(text, lo, hi, "Number of input signals:")) {
            ev(work, res, EV_NUM, cs, cur_gen, 0, dig_val(text, M[0], M[1]), 0, 0, 0, 0, 0);
            k = k + 1;
            continue;
        }
        if (m_number_line(text, lo, hi, "Number of output signals:")) {
            ev(work, res, EV_NUM, cs, cur_gen, 1, dig_val(text, M[0], M[1]), 0, 0, 0, 0, 0);
            k = k + 1;
            continue;
        }
        if (m_number_line(text, lo, hi, "Number of state bits:")) {
            ev(work, res, EV_NUM, cs, cur_gen, 2, dig_val(text, M[0], M[1]), 0, 0, 0, 0, 0);
            k = k + 1;
            continue;
        }
        if (is_header(text, lo, hi, "Input signals:")) { section = 1; k = k + 1; continue; }
        if (is_header(text, lo, hi, "Output signals:")) { section = 2; k = k + 1; continue; }
        if (is_header(text, lo, hi, "State encoding:")) { section = 3; k = k + 1; continue; }
        if (match_in(text, skip_ws(text, lo, hi), hi, "Transition Table")) { section = 4; k = k + 1; continue; }
        if (skip_ws(text, lo, hi) == hi or is_rule(text, lo, hi)) {
            if (section == 4 and slot_has_rows(work, res[16] as usize, cs, cur_gen)) {
                cur_slot = -1;
                section = 0;
            }
            k = k + 1;
            continue;
        }
        if (section == 1 and m_index_line(text, lo, hi)) {
            ev(work, res, EV_IN, cs, cur_gen, dig_val(text, M[0], M[1]), unslash(text, M[2], M[3]) as u32, (M[3] - unslash(text, M[2], M[3])) as u32, 0, 0, 0, 0);
            k = k + 1;
            continue;
        }
        if (section == 2 and m_index_line(text, lo, hi)) {
            ev(work, res, EV_OUT, cs, cur_gen, dig_val(text, M[0], M[1]), unslash(text, M[2], M[3]) as u32, (M[3] - unslash(text, M[2], M[3])) as u32, 0, 0, 0, 0);
            k = k + 1;
            continue;
        }
        if (section == 3 and m_encoding_line(text, lo, hi)) {
            const idx : u32 = dig_val(text, M[0], M[1]);
            ev(work, res, EV_STATE, cs, cur_gen, idx, M[2] as u32, (M[3] - M[2]) as u32, 0, 0, 0, 0);
            if (M[4] == 1) { ev(work, res, EV_RESET, cs, cur_gen, idx, 0, 0, 0, 0, 0, 0); }
            k = k + 1;
            continue;
        }
        if (section == 4 and m_row_line(text, lo, hi)) {
            ev(work, res, EV_ROW, cs, cur_gen, dig_val(text, M[0], M[1]), dig_val(text, M[4], M[5]), M[2] as u32, (M[3] - M[2]) as u32, M[6] as u32, (M[7] - M[6]) as u32, 0);
            k = k + 1;
            continue;
        }
        k = k + 1;
    }
    if (res[0] != 0) { return; }
    if (NUMFLAG != 0) {
        res[0] = 5;
        return;
    }
    res[17] = nslots;
    emit_log(text, work, out, nums, res);
}

pub fn pend_lo_set(a: usize, b: usize) {
    PEND[0] = a;
    PEND[1] = b;
}

pub fn ev_last_index(res: []const u32) -> i64 {
    return (res[16] as i64) - 1;
}

pub fn slot_has_rows(work: []const u32, nev: usize, slot: u32, gen: u32) -> bool {
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_ROW and work[k * EV + 1] == slot and work[k * EV + 2] == gen) { return true; }
        k = k + 1;
    }
    return false;
}

/// The last event of this kind for (slot, gen) with this index field (a3), or -1.
pub fn last_with(work: []const u32, nev: usize, tag: u32, slot: u32, gen: u32, idx: u32) -> i64 {
    var found : i64 = -1;
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == tag and work[k * EV + 1] == slot and work[k * EV + 2] == gen and work[k * EV + 3] == idx) { found = k as i64; }
        k = k + 1;
    }
    return found;
}

/// Write the result stream of a log from the events.
pub fn emit_log(text: []const u8, work: []u32, out: []u32, nums: []f64, res: []u32) {
    const nev : usize = res[16] as usize;
    const nslots : u32 = res[17];
    res[1] = 1;
    res[9] = nslots;
    // the recoded encoding of each FSM
    var found_n : u32 = 0;
    var rej_n : u32 = 0;
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_FOUND) { found_n = found_n + 1; }
        if (work[k * EV] == EV_REJ) { rej_n = rej_n + 1; }
        k = k + 1;
    }
    if (res[8] == 0 and nslots == 0 and found_n == 0 and rej_n == 0) {
        res[1] = 0;
        res[2] = 0;
        res[3] = E_NOFSMPASS;
        res[9] = 0;
        return;
    }
    res[10] = found_n;
    res[11] = rej_n;
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_FOUND) {
            ow(out, res, work[k * EV + 1]);
            ow(out, res, work[k * EV + 2]);
        }
        k = k + 1;
    }
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_REJ) {
            var nr : u32 = 0;
            var r : usize = 0;
            while (r < nev) {
                if (work[r * EV] == EV_REASON and (work[r * EV + 1] as usize) == k) { nr = nr + 1; }
                r = r + 1;
            }
            ow(out, res, work[k * EV + 1]);
            ow(out, res, work[k * EV + 2]);
            ow(out, res, nr);
            r = 0;
            while (r < nev) {
                if (work[r * EV] == EV_REASON and (work[r * EV + 1] as usize) == k) {
                    ow(out, res, work[r * EV + 2]);
                    ow(out, res, work[r * EV + 3]);
                }
                r = r + 1;
            }
        }
        k = k + 1;
    }
    // notes
    var recoded : bool = false;
    var s : u32 = 0;
    while (s < nslots) {
        const e : i64 = last_set_event(work, nev, s);
        const eo : usize = work[(e as usize) * EV + 2] as usize;
        const el : usize = work[(e as usize) * EV + 3] as usize;
        const enc : i64 = recode_of(text, work, nev, eo, eo + el);
        if (enc >= 0) {
            const x : usize = work[(enc as usize) * EV + 3] as usize;
            const xl : usize = work[(enc as usize) * EV + 4] as usize;
            if (xl > 0 and !(xl == 4 and match_in(text, x, x + xl, "auto"))) { recoded = true; }
        }
        s = s + 1;
    }
    var notes : u32 = 0;
    if (recoded) { notes = notes + 1; }
    if (found_n > nslots) { notes = notes + 1; }
    res[12] = notes;
    if (recoded) {
        ow(out, res, N_RECODED);
        ow(out, res, 0);
        ow(out, res, 0);
        ow(out, res, 0);
        ow(out, res, 0);
    }
    if (found_n > nslots) {
        ow(out, res, N_NO_INFO);
        ow(out, res, found_n);
        ow(out, res, nslots);
        ow(out, res, 0);
        ow(out, res, 0);
    }
    s = 0;
    while (s < nslots) {
        emit_fsm(text, work, nev, s, out, nums, res);
        s = s + 1;
    }
}

pub fn last_set_event(work: []const u32, nev: usize, slot: u32) -> i64 {
    var found : i64 = -1;
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_FSM and work[k * EV + 1] == slot) { found = k as i64; }
        k = k + 1;
    }
    return found;
}

/// The last RECODE event whose id is s[lo .. hi], or -1.
pub fn recode_of(text: []const u8, work: []const u32, nev: usize, lo: usize, hi: usize) -> i64 {
    var found : i64 = -1;
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV] == EV_RECODE) {
            const o : usize = work[k * EV + 1] as usize;
            if (span_eq(text, o, o + (work[k * EV + 2] as usize), lo, hi)) { found = k as i64; }
        }
        k = k + 1;
    }
    return found;
}

pub fn emit_fsm(text: []const u8, work: []const u32, nev: usize, slot: u32, out: []u32, nums: []f64, res: []u32) {
    const se : usize = last_set_event(work, nev, slot) as usize;
    const gen : u32 = work[se * EV + 9];
    // numbers
    var nin : u32 = 0;
    var nout : u32 = 0;
    var nbits : u32 = 0;
    var top : i64 = -1;
    var max_state : i64 = -1;
    var max_in : i64 = -1;
    var max_out : i64 = -1;
    var n_rows : u32 = 0;
    var reset : u32 = NONE;
    var k : usize = 0;
    while (k < nev) {
        if (work[k * EV + 1] == slot and work[k * EV + 2] == gen) {
            const tag : u32 = work[k * EV];
            if (tag == EV_NUM) {
                if (work[k * EV + 3] == 0) { nin = work[k * EV + 4]; }
                if (work[k * EV + 3] == 1) { nout = work[k * EV + 4]; }
                if (work[k * EV + 3] == 2) { nbits = work[k * EV + 4]; }
            }
            if (tag == EV_STATE and (work[k * EV + 3] as i64) > max_state) { max_state = work[k * EV + 3] as i64; }
            if (tag == EV_IN and (work[k * EV + 3] as i64) > max_in) { max_in = work[k * EV + 3] as i64; }
            if (tag == EV_OUT and (work[k * EV + 3] as i64) > max_out) { max_out = work[k * EV + 3] as i64; }
            if (tag == EV_ROW) {
                n_rows = n_rows + 1;
                if ((work[k * EV + 3] as i64) > top) { top = work[k * EV + 3] as i64; }
                if ((work[k * EV + 4] as i64) > top) { top = work[k * EV + 4] as i64; }
            }
            if (tag == EV_RESET) { reset = work[k * EV + 3]; }
        }
        k = k + 1;
    }
    var n_states : i64 = max_state + 1;
    if (top + 1 > n_states) { n_states = top + 1; }
    // distinct entries of the input and output arrays
    var n_in_ent : u32 = 0;
    var n_out_ent : u32 = 0;
    k = 0;
    while (k < nev) {
        if ((work[k * EV] == EV_IN or work[k * EV] == EV_OUT) and work[k * EV + 1] == slot and work[k * EV + 2] == gen) {
            if (last_with(work, nev, work[k * EV], slot, gen, work[k * EV + 3]) == (k as i64)) {
                if (work[k * EV] == EV_IN) { n_in_ent = n_in_ent + 1; } else { n_out_ent = n_out_ent + 1; }
            }
        }
        k = k + 1;
    }
    const eo : usize = work[se * EV + 2] as usize;
    const el : usize = work[se * EV + 3] as usize;
    const enc : i64 = recode_of(text, work, nev, eo, eo + el);
    ow(out, res, work[se * EV + 2]);
    ow(out, res, work[se * EV + 3]);
    ow(out, res, work[se * EV + 4]);
    ow(out, res, work[se * EV + 5]);
    ow(out, res, work[se * EV + 6]);
    ow(out, res, work[se * EV + 7]);
    ow(out, res, reset);
    if (enc >= 0) {
        ow(out, res, work[(enc as usize) * EV + 3]);
        ow(out, res, work[(enc as usize) * EV + 4]);
    } else {
        ow(out, res, NONE);
        ow(out, res, 0);
    }
    ow(out, res, n_states as u32);
    ow(out, res, n_rows);
    ow(out, res, (max_in + 1) as u32);
    ow(out, res, n_in_ent);
    ow(out, res, (max_out + 1) as u32);
    ow(out, res, n_out_ent);
    ow(out, res, 0);
    const base : usize = 1 + 3 * (slot as usize);
    if (base + 2 < nums.len) {
        nums[base] = nin as f64;
        nums[base + 1] = nout as f64;
        nums[base + 2] = nbits as f64;
    }
    var i : i64 = 0;
    while (i < n_states) {
        const st : i64 = last_with(work, nev, EV_STATE, slot, gen, i as u32);
        if (st >= 0) {
            ow(out, res, NONE);
            ow(out, res, 0);
            ow(out, res, work[(st as usize) * EV + 4]);
            ow(out, res, work[(st as usize) * EV + 5]);
        } else {
            ow(out, res, NONE);
            ow(out, res, 0);
            ow(out, res, NONE);
            ow(out, res, 0);
        }
        i = i + 1;
    }
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_ROW and work[k * EV + 1] == slot and work[k * EV + 2] == gen) {
            ow(out, res, work[k * EV + 3]);
            ow(out, res, work[k * EV + 4]);
            ow(out, res, work[k * EV + 5]);
            ow(out, res, work[k * EV + 6]);
            ow(out, res, work[k * EV + 7]);
            ow(out, res, work[k * EV + 8]);
        }
        k = k + 1;
    }
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_IN and work[k * EV + 1] == slot and work[k * EV + 2] == gen) {
            if (last_with(work, nev, EV_IN, slot, gen, work[k * EV + 3]) == (k as i64)) {
                ow(out, res, work[k * EV + 3]);
                ow(out, res, work[k * EV + 4]);
                ow(out, res, work[k * EV + 5]);
            }
        }
        k = k + 1;
    }
    k = 0;
    while (k < nev) {
        if (work[k * EV] == EV_OUT and work[k * EV + 1] == slot and work[k * EV + 2] == gen) {
            if (last_with(work, nev, EV_OUT, slot, gen, work[k * EV + 3]) == (k as i64)) {
                ow(out, res, work[k * EV + 3]);
                ow(out, res, work[k * EV + 4]);
                ow(out, res, work[k * EV + 5]);
            }
        }
        k = k + 1;
    }
}

/// parseAny (mode 0: sniff, then parse), parseLog (mode 1) or parseKiss2 (mode 2); see "the result stream". ls: 2 u32 per line + 2; work: 10 u32 per event,
/// 2 * (text.len + 16) events; tmp: 4 * (text.len + 16) u32; out and nums as large as you dare.
pub fn fsm_parse(text: []const u8, mode: u8, ls: []u32, work: []u32, tmp: []u32, out: []u32, nums: []f64, res: []u32) -> u32 {
    clear_res(res, nums);
    var kind : u8 = mode;
    if (mode == 0) { kind = sniff(text); }
    if (kind == 0) {
        res[3] = E_UNKNOWN;
        return 0;
    }
    const nlines : usize = split_nl(text, ls);
    if (nlines == 0) {
        res[0] = 2;
        return 2;
    }
    if (kind == 1) {
        parse_log(text, ls, nlines, work, out, nums, res);
    } else {
        res[2] = 2;
        parse_kiss2(text, ls, nlines, work, tmp, out, nums, res);
        if (NUMFLAG != 0 and res[0] == 0) { res[0] = 5; }
    }
    return res[0];
}

// ------------------------------------------------------------------------------------------------
// tests: the widget's own samples (public/widgets/fsm-sketch/samples/) and the K_SAMPLE_ facts of
// specs/widgets/fsm-sketch.t27 for them.
// ------------------------------------------------------------------------------------------------

pub var T_LS : [8000]u32 = [0; 8000];
pub var T_WORK : [80000]u32 = [0; 80000];
pub var T_TMP : [8000]u32 = [0; 8000];
pub var T_OUT : [8000]u32 = [0; 8000];
pub var T_NUMS : [200]f64 = [0.0; 200];
pub var T_RES : [32]u32 = [0; 32];
pub var T_RF : [64]u32 = [0; 64];
pub var T_RT : [64]u32 = [0; 64];
pub var T_RIL : [64]u32 = [0; 64];
pub var T_LN : [16]u32 = [0; 16];
pub var T_LM : [16]u32 = [0; 16];
pub var T_NODES : [64]f64 = [0.0; 64];
pub var T_EF : [832]f64 = [0.0; 832];
pub var T_EU : [640]u32 = [0; 640];
pub var T_ORDER : [16]u32 = [0; 16];
pub var T_LW : [200]u32 = [0; 200];
pub var T_FW : [400]f64 = [0.0; 400];
pub var T_TRIG : [32]f64 = [0.0; 32];
pub var T_IDX : [16]u32 = [0; 16];
pub var T_BIT : [16]u8 = [0; 16];

pub fn log_uart_rx() -> []const u8 {
    return "5. Executing FSM_DETECT pass (finding FSMs in design).\nFound FSM state register uart_rx.state.\n\n7. Executing FSM_INFO pass (dumping all available information on FSM cells).\n\nFSM `$fsm$\\state$162' from module `uart_rx':\n-------------------------------------\n\n  Information on FSM $fsm$\\state$162 (\\state):\n\n  Number of input signals:    4\n  Number of output signals:   7\n  Number of state bits:       3\n\n  Input signals:\n    0: \\rst\n    1: \\rx_sync [1]\n    2: $ge$fpga/rtl/uart_rx.v:58$13_Y\n    3: $eq$fpga/rtl/uart_rx.v:75$26_Y\n\n  Output signals:\n    0: $0\\state[2:0] [0]\n    1: $0\\state[2:0] [1]\n    2: $0\\state[2:0] [2]\n    3: $procmux$109_CMP\n    4: $procmux$115_CMP\n    5: $procmux$123_CMP\n    6: $procmux$138_CMP\n\n  State encoding:\n    0:      3'000  <RESET STATE>\n    1:      3'010\n    2:      3'001\n    3:      3'011\n\n  Transition Table (state_in, ctrl_in, state_out, ctrl_out):\n      0:     0 4'--00   ->     2 7'1000001\n      1:     0 4'--10   ->     0 7'1000000\n      2:     0 4'---1   ->     0 7'1000000\n      3:     1 4'-0-0   ->     1 7'0001010\n      4:     1 4'01-0   ->     1 7'0001010\n      5:     1 4'11-0   ->     3 7'0001011\n      6:     1 4'---1   ->     0 7'0001000\n      7:     2 4'-0-0   ->     2 7'0010001\n      8:     2 4'-100   ->     1 7'0010010\n      9:     2 4'-110   ->     0 7'0010000\n     10:     2 4'---1   ->     0 7'0010000\n     11:     3 4'-0-0   ->     3 7'0100011\n     12:     3 4'-1-0   ->     0 7'0100000\n     13:     3 4'---1   ->     0 7'0100000\n";
}

pub fn log_fsm_simple() -> []const u8 {
    return "5. Executing FSM_DETECT pass (finding FSMs in design).\nNot marking fsm_simple.next_state as FSM state register:\n    Register has an initialization value.\n\n";
}

pub fn kiss_uart_rx() -> []const u8 {
    return ".i 4\n.o 7\n.p 14\n.s 4\n.r s0\n--00 s0 s2 1000001\n--10 s0 s0 1000000\n---1 s0 s0 1000000\n-0-0 s1 s1 0001010\n01-0 s1 s1 0001010\n11-0 s1 s3 0001011\n---1 s1 s0 0001000\n-0-0 s2 s2 0010001\n-100 s2 s1 0010010\n-110 s2 s0 0010000\n---1 s2 s0 0010000\n-0-0 s3 s3 0100011\n-1-0 s3 s0 0100000\n---1 s3 s0 0100000\n";
}

pub fn kiss_spi_flash() -> []const u8 {
    return ".i 7\n.o 11\n.p 23\n.s 7\n.r s0\n---0--0 s0 s0 00000010000\n---1--0 s0 s4 00000010001\n------1 s0 s0 00000010000\n-----00 s1 s1 00000100100\n--0--10 s1 s1 00000100100\n0-1--10 s1 s1 00000100100\n1-1--10 s1 s5 00000100101\n------1 s1 s0 00000100000\n----0-0 s2 s2 00010000010\n--0-1-0 s2 s2 00010000010\n--1-1-0 s2 s6 00010000011\n------1 s2 s0 00010000000\n------0 s3 s0 10000000000\n------1 s3 s0 10000000000\n------0 s4 s2 00100000010\n------1 s4 s0 00100000000\n------0 s5 s3 01000000110\n------1 s5 s0 01000000000\n----0-0 s6 s6 00001000011\n--0-1-0 s6 s6 00001000011\n-01-1-0 s6 s6 00001000011\n-11-1-0 s6 s1 00001000100\n------1 s6 s0 00001000000\n";
}

/// parseAny (mode 0), parseLog (1) or parseKiss2 (2) of a text into the T_ buffers; the status.
pub fn t_parse(text: []const u8, mode: u8) -> u32 {
    return fsm_parse(text, mode, T_LS[0 .. 8000], T_WORK[0 .. 80000], T_TMP[0 .. 8000], T_OUT[0 .. 8000], T_NUMS[0 .. 200], T_RES[0 .. 32]);
}

/// Is the text span (off, len) exactly w?
pub fn t_is(text: []const u8, off: u32, len: u32, w: []const u8) -> bool {
    return match_in(text, off as usize, (off + len) as usize, w) and (len as usize) == w.len;
}

/// Where the first FSM block starts in T_OUT: after the found list, the rejected list and the notes.
pub fn t_fsm_at() -> usize {
    var p : usize = (T_RES[10] as usize) * 2;
    var i : u32 = 0;
    while (i < T_RES[11]) {
        p = p + 3 + (T_OUT[p + 2] as usize) * 2;
        i = i + 1;
    }
    return p + (T_RES[12] as usize) * 5;
}

test the_uart_rx_kiss2_file_is_four_states_and_fourteen_rows {
    const x : []const u8 = kiss_uart_rx();
    assert t_parse(x, 0) == 0;
    assert T_RES[1] == 1;
    assert T_RES[2] == 2;
    assert T_RES[9] == 1;
    assert T_RES[12] == 0;
    const p : usize = t_fsm_at();
    assert T_OUT[p + 9] == 4;
    assert T_OUT[p + 10] == 14;
    assert T_OUT[p + 6] == 0;
    assert T_OUT[p + 15] == 1;
    assert T_OUT[p + 0] == NONE;
    assert T_NUMS[1] == 4.0;
    assert T_NUMS[2] == 7.0;
    const rows : usize = p + 16 + 4 * 4;
    assert T_OUT[rows] == 0;
    assert T_OUT[rows + 1] == 2;
    assert t_is(x, T_OUT[rows + 2], T_OUT[rows + 3], "--00");
    assert t_is(x, T_OUT[rows + 4], T_OUT[rows + 5], "1000001");
    assert t_is(x, T_OUT[p + 16], T_OUT[p + 17], "s0");
}

test the_spi_flash_kiss2_file_is_seven_states_and_twenty_three_rows {
    const x : []const u8 = kiss_spi_flash();
    assert t_parse(x, 2) == 0;
    const p : usize = t_fsm_at();
    assert T_OUT[p + 9] == 7;
    assert T_OUT[p + 10] == 23;
    assert T_NUMS[1] == 7.0;
    assert T_NUMS[2] == 11.0;
    assert T_RES[12] == 0;
    assert sniff(x) == 2;
}

test the_uart_rx_log_is_found_and_read_to_the_last_row {
    const x : []const u8 = log_uart_rx();
    assert sniff(x) == 1;
    assert t_parse(x, 0) == 0;
    assert T_RES[1] == 1;
    assert T_RES[2] == 1;
    assert T_RES[8] == 1;
    assert T_RES[10] == 1;
    assert T_RES[11] == 0;
    assert T_RES[9] == 1;
    assert t_is(x, T_OUT[0], T_OUT[1], "uart_rx.state");
    const p : usize = t_fsm_at();
    assert t_is(x, T_OUT[p], T_OUT[p + 1], "$fsm$\\state$162");
    assert t_is(x, T_OUT[p + 2], T_OUT[p + 3], "uart_rx");
    assert t_is(x, T_OUT[p + 4], T_OUT[p + 5], "state");
    assert T_OUT[p + 6] == 0;
    assert T_OUT[p + 7] == NONE;
    assert T_OUT[p + 9] == 4;
    assert T_OUT[p + 10] == 14;
    assert T_OUT[p + 11] == 4;
    assert T_OUT[p + 12] == 4;
    assert T_OUT[p + 13] == 7;
    assert T_OUT[p + 14] == 7;
    assert T_NUMS[1] == 4.0;
    assert T_NUMS[2] == 7.0;
    assert T_NUMS[3] == 3.0;
    assert t_is(x, T_OUT[p + 16 + 2], T_OUT[p + 16 + 3], "000");
    assert t_is(x, T_OUT[p + 16 + 4 * 3 + 2], T_OUT[p + 16 + 4 * 3 + 3], "011");
}

test the_traffic_light_register_is_named_and_refused {
    const x : []const u8 = log_fsm_simple();
    assert t_parse(x, 1) == 0;
    assert T_RES[1] == 1;
    assert T_RES[9] == 0;
    assert T_RES[10] == 0;
    assert T_RES[11] == 1;
    assert t_is(x, T_OUT[0], T_OUT[1], "fsm_simple.next_state");
    assert T_OUT[2] == 1;
    assert t_is(x, T_OUT[3], T_OUT[4], "Register has an initialization value.");
    assert T_RES[8] == 1;
}

test a_log_with_no_fsm_pass_is_refused_and_a_pass_alone_is_an_empty_result {
    const a : []const u8 = "4.1. Executing OPT pass.\nnothing about state machines\n";
    assert t_parse(a, 0) == 0;
    assert T_RES[1] == 0;
    assert T_RES[3] == E_UNKNOWN;
    assert t_parse(a, 1) == 0;
    assert T_RES[1] == 0;
    assert T_RES[3] == E_NOFSMPASS;
    const b : []const u8 = "5. Executing FSM_DETECT pass (finding FSMs in design).\n";
    assert t_parse(b, 0) == 0;
    assert T_RES[1] == 1;
    assert T_RES[9] == 0;
    assert T_RES[8] == 1;
    assert t_parse("this is not it", 0) == 0;
    assert T_RES[3] == E_UNKNOWN;
}

test a_kiss2_row_that_is_no_row_is_named_by_its_line {
    const x : []const u8 = ".i 2\n.o 1\n01 s0 s1 1\n  01 s0 s1 2  \n";
    assert t_parse(x, 2) == 0;
    assert T_RES[1] == 0;
    assert T_RES[3] == E_KISS2ROW;
    assert t_is(x, T_RES[4], T_RES[5], "01 s0 s1 2");
}

test the_notes_of_a_kiss2_file_that_disagrees_with_itself {
    const x : []const u8 = ".i 3\n.o 1\n.p 5\n.s 9\n.r zz\n01 s1 s0 1\n0-1 s0 s1 0\n";
    assert t_parse(x, 0) == 0;
    assert T_RES[1] == 1;
    assert T_RES[12] == 4;
    assert T_OUT[0] == N_KISS2_S;
    assert T_OUT[3] == 2;
    assert T_OUT[5] == N_KISS2_P;
    assert T_OUT[8] == 2;
    assert T_OUT[10] == N_NO_RESET_NAMED;
    assert T_OUT[15] == N_WIDTH_IN;
    assert T_NUMS[0] == 3.0;
}

test a_recoding_is_a_note_and_a_state_register_is_found_once {
    const x : []const u8 = "Found FSM state register a.b.\nFound FSM state register a.b\nRecoding FSM `$fsm$\\q$1' from module `\\m' using `auto' encoding:\n  mapping auto encoding to `one-hot' for this FSM.\nFSM `$fsm$\\q$1' from module `m':\n  Information on FSM $fsm$\\q$1 (\\q):\n  State encoding:\n    0:   3'001  <RESET STATE>\n";
    assert t_parse(x, 0) == 0;
    assert T_RES[10] == 1;
    assert t_is(x, T_OUT[0], T_OUT[1], "a.b");
    assert T_RES[12] == 1;
    assert T_OUT[2] == N_RECODED;
    const p : usize = t_fsm_at();
    assert t_is(x, T_OUT[p + 7], T_OUT[p + 8], "one-hot");
    assert T_OUT[p + 6] == 0;
}

test the_code_of_a_state_and_the_conditions_of_a_row {
    assert code_value("011") == 3;
    assert code_value("1111") == 15;
    assert code_value("01x") == -1;
    assert code_value("") == -1;
    const c : usize = condition_of("01-0", T_IDX[0 .. 16], T_BIT[0 .. 16]);
    assert c == 3;
    assert T_IDX[0] == 3;
    assert T_BIT[0] == 48;
    assert T_IDX[1] == 2;
    assert T_BIT[1] == 49;
    assert T_IDX[2] == 0;
    assert condition_of("----", T_IDX[0 .. 16], T_BIT[0 .. 16]) == 0;
    assert js_number("4", 0, 1) == 4.0;
    assert js_number("0x10", 0, 4) == 16.0;
    assert js_number("1e1", 0, 3) == 10.0;
    assert js_number("-3", 0, 2) == -3.0;
    assert js_number("0.5", 0, 3) == 0.5;
    assert js_number("x", 0, 1) != js_number("x", 0, 1);
}

test the_uart_rx_layout_matches_the_javascript_to_the_last_bit {
    const x : []const u8 = log_uart_rx();
    assert t_parse(x, 0) == 0;
    const p : usize = t_fsm_at();
    const ns : usize = T_OUT[p + 9] as usize;
    const nr : usize = T_OUT[p + 10] as usize;
    assert ns == 4;
    assert nr == 14;
    var i : usize = 0;
    while (i < nr) {
        const r : usize = p + 16 + ns * 4 + i * 6;
        T_RF[i] = T_OUT[r];
        T_RT[i] = T_OUT[r + 1];
        T_RIL[i] = T_OUT[r + 3];
        i = i + 1;
    }
    i = 0;
    while (i < ns) {
        T_LN[i] = 2;
        T_LM[i] = 3;
        i = i + 1;
    }
    T_TRIG[0] = 6.123233995736766e-17;
    T_TRIG[1] = -1.0;
    T_TRIG[2] = 1.0;
    T_TRIG[3] = 0.0;
    T_TRIG[4] = 6.123233995736766e-17;
    T_TRIG[5] = 1.0;
    T_TRIG[6] = -1.0;
    T_TRIG[7] = 1.2246467991473532e-16;
    T_TRIG[8] = 0.9004471023526769;
    T_TRIG[9] = -0.43496553411123023;
    T_TRIG[10] = 0.9004471023526769;
    T_TRIG[11] = 0.43496553411123023;
    T_TRIG[12] = 0.8525245220595057;
    T_TRIG[13] = -0.5226872289306592;
    T_TRIG[14] = 0.8525245220595057;
    T_TRIG[15] = 0.5226872289306592;
    assert node_angle(1, 4) == 0.0;
    const ne : usize = layout_fsm(ns, T_OUT[p + 6] as i64, nr, T_RF[0 .. 64], T_RT[0 .. 64], T_RIL[0 .. 64], T_LN[0 .. 16], T_LM[0 .. 16], 620.0, 420.0, 13.0, 7.8, 11.0, 3, T_NODES[0 .. 64], T_EF[0 .. 832], T_EU[0 .. 640], T_ORDER[0 .. 16], T_LW[0 .. 200], T_FW[0 .. 400], T_TRIG[0 .. 32]);
