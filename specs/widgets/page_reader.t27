// SPDX-License-Identifier: Apache-2.0
; specs/widgets/page_reader.t27 -- the gallery's reader as pure rules over bytes: what a widget's
; page and recording say, without touching a disk. Epic gHashTag/t27#10937; owner 2026-10-19: the
; gallery goes native into t27b and T27F. Replaces, rule for rule, the reading half of
; apps/website/scripts/widgets-from-spec.mjs in gHashTag/trinity: metaOf (the og and twitter tags
; of a share page), unescape, localOf (an absolute t27.ai address to its file), framed, the cast's
; exit_codes test, and hudViews (which Queen board views exist, for the one tab).
; --
; The pattern is source_text.t27's (T27bSourceText): the glue passes a file's BYTES and gets back
; offsets; nothing here reads a file. A sub-text is returned as its two byte offsets packed in one
; i64 (start * 2^32 + end), NO_TEXT when there is none, so the whole module is scalar-and-slice and
; t27b can run it. A text with HTML entities is read through text_len and text_byte, which unescape
; on the fly: no buffer, no allocation.
; --
; Exact semantics kept from the generator, so the swap changes nothing a reader can see:
;   - a meta tag matches only as `<meta` + whitespace + (property|name)="KEY" + whitespace +
;     content="VALUE"; the LAST tag with a key wins, as in metaOf's overwrite;
;   - unescape is one pass over &amp; &lt; &gt; &quot; &#39; &apos; (never twice);
;   - localOf is the text after ORIGIN up to the first ? or #, none when the address is elsewhere.
; What the glue still does, and the rules cannot: say whether a file EXISTS (page, image, player),
; and hand over the bytes. judge() takes those answers as booleans and returns gallery_rules'
; verdict, so the decision is the spec's and the I/O is the glue's.
; MEASURED 2026-10-19, differential on the whole corpus: this file, generated to Rust by t27c 0.5.2
; gen-rust, read all 337 index.html and meta.json files of gHashTag/trinity origin/main (term/,
; widgets/, play/) and printed 1487 lines (five tags, localOf, the exit-code verdict per file); the
; generator's own metaOf, unescape, localOf and exit_codes filter, copied verbatim into node, printed
; the same 1487 lines, byte for byte. 67 title or description values carry a decoded entity; 107
; casts, none with a non-zero exit code. A changed byte fails the comparison (negative control run).
; Not claimed: the differential harness (a throwaway driver) is not in the repo; the glue that reads
; the files and feeds judge() is the next step, and the page the gallery draws from it (T27F).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_page_reader;

use widgets::gallery_rules::verdict;
use widgets::gallery_rules::K_CAST;
use widgets::gallery_rules::K_TOOL;
use widgets::gallery_rules::V_OK;

/// No such text.
pub const NO_TEXT : i64 = -1;
/// The packing of a sub-text's offsets: start * PACK + end.
pub const PACK : i64 = 4294967296;

// The bytes the rules read, as numbers.
pub const B_QUOTE : u8 = 34;
pub const B_AMP : u8 = 38;
pub const B_APOS : u8 = 39;
pub const B_LT : u8 = 60;
pub const B_GT : u8 = 62;
pub const B_SPACE : u8 = 32;
pub const B_TAB : u8 = 9;
pub const B_LF : u8 = 10;
pub const B_VT : u8 = 11;
pub const B_FF : u8 = 12;
pub const B_CR : u8 = 13;
pub const B_COMMA : u8 = 44;
pub const B_SLASH : u8 = 47;
pub const B_ZERO : u8 = 48;
pub const B_HASH : u8 = 35;
pub const B_QUERY : u8 = 63;
pub const B_OPEN : u8 = 91;
pub const B_CLOSE : u8 = 93;

/// Which tags a page has, as bits. A share page needs title, line and image; a tool also a hook;
/// a player a twitter:player.
pub const F_TITLE : u32 = 1;
pub const F_LINE : u32 = 2;
pub const F_IMAGE : u32 = 4;
pub const F_HOOK : u32 = 8;
pub const F_PLAYER : u32 = 16;

pub fn pack(lo: usize, hi: usize) -> i64 {
    return (lo as i64) * PACK + (hi as i64);
}

pub fn lo_of(p: i64) -> usize {
    return (p / PACK) as usize;
}

pub fn hi_of(p: i64) -> usize {
    return (p % PACK) as usize;
}

/// JavaScript's \s for the ASCII range: space, tab, line feed, vertical tab, form feed, carriage return.
pub fn is_space(b: u8) -> bool {
    return b == B_SPACE or (b >= B_TAB and b <= B_CR);
}

/// Do the bytes of w sit at s[p ..], inside s[.. hi]?
pub fn match_in(s: []const u8, p: usize, hi: usize, w: []const u8) -> bool {
    if (p + w.len > hi) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (s[p + k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// The first offset at or after `from` where w starts, or NO_TEXT.
pub fn find_from(s: []const u8, from: usize, w: []const u8) -> i64 {
    var p : usize = from;
    while (p + w.len <= s.len) {
        if (match_in(s, p, s.len, w)) { return p as i64; }
        p = p + 1;
    }
    return NO_TEXT;
}

/// The offset of the next `"` at or after p, or NO_TEXT.
pub fn next_quote(s: []const u8, p0: usize) -> i64 {
    var p : usize = p0;
    while (p < s.len) {
        if (s[p] == B_QUOTE) { return p as i64; }
        p = p + 1;
    }
    return NO_TEXT;
}

pub fn skip_space(s: []const u8, p0: usize) -> usize {
    var p : usize = p0;
    while (p < s.len and is_space(s[p])) { p = p + 1; }
    return p;
}

/// One `<meta` tag whose attributes start at p0: the packed value of its content when it is
/// (property|name)="key" content="...", else NO_TEXT.
pub fn meta_at(html: []const u8, p0: usize, key: []const u8) -> i64 {
    var p : usize = skip_space(html, p0);
    if (p == p0) { return NO_TEXT; }
    if (match_in(html, p, html.len, "property=")) {
        p = p + 9;
    } else {
        if (match_in(html, p, html.len, "name=")) {
            p = p + 5;
        } else {
            return NO_TEXT;
        }
    }
    if (p >= html.len or html[p] != B_QUOTE) { return NO_TEXT; }
    p = p + 1;
    if (!match_in(html, p, html.len, key)) { return NO_TEXT; }
    p = p + key.len;
    if (key.len == 0 or p >= html.len or html[p] != B_QUOTE) { return NO_TEXT; }
    p = p + 1;
    const q : usize = skip_space(html, p);
    if (q == p) { return NO_TEXT; }
    if (!match_in(html, q, html.len, "content=")) { return NO_TEXT; }
    const v : usize = q + 8;
    if (v >= html.len or html[v] != B_QUOTE) { return NO_TEXT; }
    const e : i64 = next_quote(html, v + 1);
    if (e < 0) { return NO_TEXT; }
    return pack(v + 1, e as usize);
}

/// The packed content of the meta tag with this key; the last one wins, as in metaOf.
pub fn meta_value(html: []const u8, key: []const u8) -> i64 {
    var found : i64 = NO_TEXT;
    var at : i64 = find_from(html, 0, "<meta");
    while (at >= 0) {
        const after : usize = (at as usize) + 5;
        const r : i64 = meta_at(html, after, key);
        if (r >= 0) { found = r; }
        at = find_from(html, after, "<meta");
    }
    return found;
}

pub fn has_meta(html: []const u8, key: []const u8) -> bool {
    return meta_value(html, key) >= 0;
}

/// Which of the tags a gallery widget needs the page has.
pub fn page_flags(html: []const u8) -> u32 {
    var f : u32 = 0;
    if (has_meta(html, "og:title")) { f = f + F_TITLE; }
    if (has_meta(html, "og:description")) { f = f + F_LINE; }
    if (has_meta(html, "og:image")) { f = f + F_IMAGE; }
    if (has_meta(html, "t27:hook")) { f = f + F_HOOK; }
    if (has_meta(html, "twitter:player")) { f = f + F_PLAYER; }
    return f;
}

/// A share page has its title, line and image, and none is empty.
pub fn words_ok(html: []const u8) -> bool {
    var k : u32 = 0;
    while (k < 3) {
        var key : []const u8 = "og:title";
        if (k == 1) { key = "og:description"; }
        if (k == 2) { key = "og:image"; }
        const v : i64 = meta_value(html, key);
        if (v < 0) { return false; }
        if (hi_of(v) == lo_of(v)) { return false; }
        k = k + 1;
    }
    return true;
}

/// The length of the HTML entity at s[p ..] inside s[.. hi], 0 when there is none of the six.
pub fn entity_len(s: []const u8, p: usize, hi: usize) -> usize {
    if (p >= hi or s[p] != B_AMP) { return 0; }
    if (match_in(s, p, hi, "&amp;")) { return 5; }
    if (match_in(s, p, hi, "&lt;")) { return 4; }
    if (match_in(s, p, hi, "&gt;")) { return 4; }
    if (match_in(s, p, hi, "&quot;")) { return 6; }
    if (match_in(s, p, hi, "&#39;")) { return 5; }
    if (match_in(s, p, hi, "&apos;")) { return 6; }
    return 0;
}

pub fn entity_byte(s: []const u8, p: usize, hi: usize) -> u8 {
    if (match_in(s, p, hi, "&amp;")) { return B_AMP; }
    if (match_in(s, p, hi, "&lt;")) { return B_LT; }
    if (match_in(s, p, hi, "&gt;")) { return B_GT; }
    if (match_in(s, p, hi, "&quot;")) { return B_QUOTE; }
    return B_APOS;
}

/// The length of s[lo .. hi] once its entities are replaced, in one pass.
pub fn text_len(s: []const u8, lo: usize, hi: usize) -> usize {
    var p : usize = lo;
    var n : usize = 0;
    while (p < hi) {
        const e : usize = entity_len(s, p, hi);
        if (e > 0) { p = p + e; } else { p = p + 1; }
        n = n + 1;
    }
    return n;
}

/// The k-th byte of s[lo .. hi] once its entities are replaced; 0 past the end.
pub fn text_byte(s: []const u8, lo: usize, hi: usize, k: usize) -> u8 {
    var p : usize = lo;
    var n : usize = 0;
    while (p < hi) {
        const e : usize = entity_len(s, p, hi);
        if (n == k) {
            if (e > 0) { return entity_byte(s, p, hi); }
            return s[p];
        }
        if (e > 0) { p = p + e; } else { p = p + 1; }
        n = n + 1;
    }
    return 0;
}

/// localOf: the packed path of url after origin, up to the first ? or #; NO_TEXT when url is not
/// under origin.
pub fn local_of(url: []const u8, origin: []const u8) -> i64 {
    if (!match_in(url, 0, url.len, origin)) { return NO_TEXT; }
    var e : usize = origin.len;
    while (e < url.len and url[e] != B_QUERY and url[e] != B_HASH) { e = e + 1; }
    return pack(origin.len, e);
}

/// framed: a path that ends in a slash names a directory and gets index.html appended.
pub fn is_dir(path: []const u8, lo: usize, hi: usize) -> bool {
    return hi > lo and path[hi - 1] == B_SLASH;
}

/// The cast's exit codes: true when exit_codes holds anything but the number 0. A token is a run of
/// bytes between spaces, commas and quotes; "exit_codes" absent or empty is clean.
pub fn bad_exit(json: []const u8) -> bool {
    const k : i64 = find_from(json, 0, "exit_codes");
    if (k < 0) { return false; }
    var p : usize = (k as usize) + 10;
    while (p < json.len and json[p] != B_OPEN) { p = p + 1; }
    if (p >= json.len) { return false; }
    p = p + 1;
    var len : usize = 0;
    var zero : bool = true;
    while (p < json.len and json[p] != B_CLOSE) {
        const b : u8 = json[p];
        if (is_space(b) or b == B_COMMA or b == B_QUOTE) {
            if (len > 0 and (len != 1 or !zero)) { return true; }
            len = 0;
            zero = true;
        } else {
            if (b != B_ZERO) { zero = false; }
            len = len + 1;
        }
        p = p + 1;
    }
    if (len > 0 and (len != 1 or !zero)) { return true; }
    return false;
}

/// hudViews: is `view` one of the quoted names in `export const HUD_VIEWS ... = [ ... ] as const`?
pub fn view_listed(src: []const u8, view: []const u8) -> bool {
    const k : i64 = find_from(src, 0, "HUD_VIEWS");
    if (k < 0) { return false; }
    const eq : i64 = find_from(src, (k as usize) + 9, "=");
    if (eq < 0) { return false; }
    const open : i64 = find_from(src, (eq as usize) + 1, "[");
    if (open < 0) { return false; }
    var close : i64 = find_from(src, (open as usize) + 1, "]");
    var ok : bool = false;
    while (close >= 0 and !ok) {
        const a : usize = skip_space(src, (close as usize) + 1);
        if (match_in(src, a, src.len, "as const")) { ok = true; } else { close = find_from(src, (close as usize) + 1, "]"); }
    }
    if (!ok) { return false; }
    var p : usize = (open as usize) + 1;
    while (p < (close as usize)) {
        if (src[p] == B_QUOTE) {
            const e : i64 = next_quote(src, p + 1);
            if (e < 0 or (e as usize) > (close as usize)) { return false; }
            if (e as usize - p - 1 == view.len and match_in(src, p + 1, e as usize, view)) { return true; }
            p = (e as usize) + 1;
        } else {
            p = p + 1;
        }
    }
    return false;
}

/// The decision about one widget: the generator's problems list as gallery_rules' verdict. The glue
/// answers what only a disk knows -- page_ok (the index.html exists), image_file_ok (the og:image is
/// a file under public/), player_file_ok (the twitter:player is a page under public/), cast_meta
/// (meta.json exists), view_ok (hudViews lists the tab's view) -- and passes the bytes.
pub fn judge(kind: u8, html: []const u8, cast_json: []const u8, origin: []const u8, page_ok: bool, image_file_ok: bool, player_file_ok: bool, cast_meta: bool, view_ok: bool) -> u8 {
    const img : i64 = meta_value(html, "og:image");
    var image_local : bool = false;
    if (img >= 0) {
        image_local = local_of(html[lo_of(img) .. hi_of(img)], origin) >= 0 and image_file_ok;
    }
    const flags : u32 = page_flags(html);
    const hook_ok : bool = (flags / F_HOOK) % 2 == 1;
    return verdict(kind, view_ok, page_ok, words_ok(html), image_local, cast_meta, bad_exit(cast_json), hook_ok, player_file_ok);
}

test a_meta_value_is_the_content_of_the_last_matching_tag {
    const h : []const u8 = "<meta name=\"description\" content=\"d\"><meta property=\"og:title\" content=\"Gatle\"><meta property=\"og:title\" content=\"Second\">";
    const v : i64 = meta_value(h, "og:title");
    assert v >= 0;
    assert hi_of(v) - lo_of(v) == 6;
    assert h[lo_of(v)] == 83;
    assert meta_value(h, "og:image") == NO_TEXT;
    assert hi_of(meta_value(h, "description")) - lo_of(meta_value(h, "description")) == 1;
}

test a_meta_tag_must_be_spelled_the_way_the_generator_matches {
    assert meta_value("<meta property=\"og:title\" content=\"x\">", "og:title") >= 0;
    assert meta_value("<meta  name=\"og:title\"  content=\"x\">", "og:title") >= 0;
    assert meta_value("<metaproperty=\"og:title\" content=\"x\">", "og:title") == NO_TEXT;
    assert meta_value("<meta property=\"og:title\"content=\"x\">", "og:title") == NO_TEXT;
    assert meta_value("<meta content=\"x\" property=\"og:title\">", "og:title") == NO_TEXT;
    assert meta_value("<meta property=\"og:titleX\" content=\"x\">", "og:title") == NO_TEXT;
    assert meta_value("<meta property=\"og:title\" content=\"x", "og:title") == NO_TEXT;
    assert meta_value("<meta property=\"og:title\" content=\"\">", "og:title") >= 0;
    assert meta_value("", "og:title") == NO_TEXT;
}

test the_page_flags_say_which_tags_a_share_page_has {
    const p : []const u8 = "<meta property=\"og:title\" content=\"T\"><meta property=\"og:description\" content=\"D\"><meta property=\"og:image\" content=\"https://t27.ai/widgets/gatle/card.png?v=9e7908d83118\"><meta name=\"t27:hook\" content=\"H\">";
    assert page_flags(p) == F_TITLE + F_LINE + F_IMAGE + F_HOOK;
    assert words_ok(p);
    assert page_flags("<meta name=\"twitter:player\" content=\"https://t27.ai/play/x/\">") == F_PLAYER;
    assert words_ok("<meta property=\"og:title\" content=\"\"><meta property=\"og:description\" content=\"D\"><meta property=\"og:image\" content=\"I\">") == false;
    assert words_ok("<meta property=\"og:title\" content=\"T\">") == false;
}

test entities_unescape_in_one_pass {
    const s : []const u8 = "a &amp; b &lt;c&gt; &quot;d&quot; it&#39;s &apos;e&apos; &amp;amp; &bogus;";
    assert text_len(s, 0, s.len) == 36;
    assert text_byte(s, 0, s.len, 2) == 38;
    assert text_byte(s, 0, s.len, 6) == 60;
    assert text_byte(s, 0, s.len, 16) == 39;
    assert text_byte(s, 0, s.len, 29) == 38;
    assert text_byte(s, 0, s.len, 30) == 98;
    assert text_byte(s, 0, s.len, 23) == 38;
    assert text_byte(s, 0, s.len, 24) == 97;
    assert text_byte(s, 0, s.len, 999) == 0;
    assert text_len("plain", 0, 5) == 5;
    assert text_len("&amp", 0, 4) == 4;
    assert text_len("", 0, 0) == 0;
}

test an_address_is_local_when_it_sits_under_the_origin {
    const u : []const u8 = "https://t27.ai/widgets/gatle/card.png?v=9e7908d83118";
    const r : i64 = local_of(u, "https://t27.ai/");
    assert r >= 0;
    assert lo_of(r) == 15;
    assert hi_of(r) == 37;
    assert local_of("https://other.example/x.png", "https://t27.ai/") == NO_TEXT;
    assert hi_of(local_of("https://t27.ai/term/a/#frag", "https://t27.ai/")) == 22;
    assert lo_of(local_of("https://t27.ai/", "https://t27.ai/")) == 15;
    assert hi_of(local_of("https://t27.ai/", "https://t27.ai/")) == 15;
    assert is_dir("term/x7-board/", 0, 14);
    assert is_dir("widgets/gatle/card.png", 0, 22) == false;
    assert is_dir("", 0, 0) == false;
}

test a_cast_is_bad_when_any_exit_code_is_not_zero {
    assert bad_exit("{ \"exit_codes\": [ 0, 0, 0 ], \"gif\": true }") == false;
    assert bad_exit("{ \"exit_codes\": [0] }") == false;
    assert bad_exit("{ \"exit_codes\": [0, 1] }");
    assert bad_exit("{ \"exit_codes\": [ 2 ] }");
    assert bad_exit("{ \"exit_codes\": [ 00 ] }");
    assert bad_exit("{ \"exit_codes\": [ 10 ] }");
    assert bad_exit("{ \"exit_codes\": [ \"0\", \"0\" ] }") == false;
    assert bad_exit("{ \"exit_codes\": [] }") == false;
    assert bad_exit("{ \"gif\": true }") == false;
    assert bad_exit("") == false;
}

test the_tab_view_must_be_listed_in_the_hud {
    const src : []const u8 = "export const HUD_VIEWS: readonly string[] = [ \"board\", \"widgets\", \"wars\" ] as const";
    assert view_listed(src, "widgets");
    assert view_listed(src, "board");
    assert view_listed(src, "wars");
    assert view_listed(src, "widget") == false;
    assert view_listed(src, "nope") == false;
    assert view_listed("const X = [ \"widgets\" ]", "widgets") == false;
    assert view_listed("", "widgets") == false;
}

test judge_turns_what_was_read_into_gallery_rules_verdicts {
    const page : []const u8 = "<meta property=\"og:title\" content=\"T\"><meta property=\"og:description\" content=\"D\"><meta property=\"og:image\" content=\"https://t27.ai/widgets/gatle/card.png?v=1\"><meta name=\"t27:hook\" content=\"H\">";
    const origin : []const u8 = "https://t27.ai/";
    assert judge(K_TOOL, page, "", origin, true, true, false, false, false) == V_OK;
    assert judge(K_TOOL, page, "", origin, false, true, false, false, false) != V_OK;
    assert judge(K_TOOL, page, "", origin, true, false, false, false, false) != V_OK;
    assert judge(K_TOOL, "<meta property=\"og:title\" content=\"T\">", "", origin, true, true, false, false, false) != V_OK;
    assert judge(K_CAST, page, "{ \"exit_codes\": [0, 0] }", origin, true, true, false, true, false) == V_OK;
    assert judge(K_CAST, page, "{ \"exit_codes\": [0, 1] }", origin, true, true, false, true, false) != V_OK;
    assert judge(K_CAST, page, "{ \"exit_codes\": [0] }", origin, true, true, false, false, false) != V_OK;
}
