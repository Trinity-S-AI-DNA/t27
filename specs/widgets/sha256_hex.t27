// SPDX-License-Identifier: Apache-2.0
; specs/widgets/sha256_hex.t27 -- SHA-256 of a byte slice as 64 lowercase hex digits, for the native widget pages that
; show a file's digest (bit-diff, bit-autopsy). Epic gHashTag/t27#10937, issue #10938. The tool.js files called
; crypto.subtle.digest('SHA-256', bytes) and printed the bytes as hex; a native page has no crypto, so the digest is
; computed here (FIPS 180-4), once, in the language of the project.
; --
; STATELESS: the caller gives two scratch arrays, h (8 u32) and w (64 u32), and the 64-byte output; nothing is kept.
; The message may be any length below 2^32 bytes (the length in bits is written as a 64-bit big-endian number).
; Words are held in u64 and reduced modulo 2^32 after every addition, so no operation depends on overflow behaviour.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_sha256_hex;

pub const SH_K : [64]u32 = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298];

pub const SH_M32 : u64 = 4294967296;

pub fn sh_rotr(x: u64, n: u64) -> u64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

pub fn sh_hexd(v: u64) -> u8 {
    if (v < 10) { return (48 + v) as u8; }
    return (87 + v) as u8;
}

/// One 64-byte block of the message (or of the padding) at m[at ..] into h.
pub fn sh_block(h: []u32, w: []u32, m: []const u8, at: usize) -> u32 {
    var t : usize = 0;
    while (t < 16) {
        w[t] = (((m[at + 4 * t] as u32) << 24) | ((m[at + 4 * t + 1] as u32) << 16) | ((m[at + 4 * t + 2] as u32) << 8) | (m[at + 4 * t + 3] as u32));
        t = t + 1;
    }
    while (t < 64) {
        const a : u64 = w[t - 15] as u64;
        const b : u64 = w[t - 2] as u64;
        const s0 : u64 = sh_rotr(a, 7) ^ sh_rotr(a, 18) ^ (a >> 3);
        const s1 : u64 = sh_rotr(b, 17) ^ sh_rotr(b, 19) ^ (b >> 10);
        w[t] = ((((w[t - 16] as u64) + s0 + (w[t - 7] as u64) + s1) % SH_M32) as u32);
        t = t + 1;
    }
    var a : u64 = h[0] as u64;
    var b : u64 = h[1] as u64;
    var c : u64 = h[2] as u64;
    var d : u64 = h[3] as u64;
    var e : u64 = h[4] as u64;
    var f : u64 = h[5] as u64;
    var g : u64 = h[6] as u64;
    var hh : u64 = h[7] as u64;
    t = 0;
    while (t < 64) {
        const s1 : u64 = sh_rotr(e, 6) ^ sh_rotr(e, 11) ^ sh_rotr(e, 25);
        const ch : u64 = (e & f) ^ ((4294967295 - e) & g);
        const t1 : u64 = (hh + s1 + ch + (SH_K[t] as u64) + (w[t] as u64)) % SH_M32;
        const s0 : u64 = sh_rotr(a, 2) ^ sh_rotr(a, 13) ^ sh_rotr(a, 22);
        const mj : u64 = (a & b) ^ (a & c) ^ (b & c);
        const t2 : u64 = (s0 + mj) % SH_M32;
        hh = g;
        g = f;
        f = e;
        e = (d + t1) % SH_M32;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) % SH_M32;
        t = t + 1;
    }
    h[0] = (((h[0] as u64) + a) % SH_M32) as u32;
    h[1] = (((h[1] as u64) + b) % SH_M32) as u32;
    h[2] = (((h[2] as u64) + c) % SH_M32) as u32;
    h[3] = (((h[3] as u64) + d) % SH_M32) as u32;
    h[4] = (((h[4] as u64) + e) % SH_M32) as u32;
    h[5] = (((h[5] as u64) + f) % SH_M32) as u32;
    h[6] = (((h[6] as u64) + g) % SH_M32) as u32;
    h[7] = (((h[7] as u64) + hh) % SH_M32) as u32;
    return 0;
}

/// SHA-256 of msg as 64 hex digits in out[0 .. 64]. h has 8 words and w has 64 words of scratch. Returns 64, or 0 when out is short.
pub fn sha256_hex(msg: []const u8, h: []u32, w: []u32, out: []u8) -> u32 {
    if (out.len < 64 or h.len < 8 or w.len < 64) { return 0; }
    h[0] = 1779033703;
    h[1] = 3144134277;
    h[2] = 1013904242;
    h[3] = 2773480762;
    h[4] = 1359893119;
    h[5] = 2600822924;
    h[6] = 528734635;
    h[7] = 1541459225;
    const n : usize = msg.len;
    var done : usize = 0;
    while (done + 64 <= n) {
        sh_block(h, w, msg, done);
        done = done + 64;
    }
    // the last one or two blocks: the rest, 0x80, zeros, the length in bits
    var tail : [128]u8 = [0; 128];
    var r : usize = n - done;
    var k : usize = 0;
    while (k < r) {
        tail[k] = msg[done + k];
        k = k + 1;
    }
    tail[r] = 128;
    var total : usize = 64;
    if (r >= 56) { total = 128; }
    const bits : u64 = (n as u64) * 8;
    k = 0;
    while (k < 8) {
        tail[total - 1 - k] = ((bits >> ((8 * k) as u64)) & 255) as u8;
        k = k + 1;
    }
    sh_block(h, w, tail[0..128], 0);
    if (total == 128) { sh_block(h, w, tail[0..128], 64); }
    var i : usize = 0;
    while (i < 8) {
        var j : u64 = 0;
        while (j < 8) {
            out[i * 8 + (j as usize)] = sh_hexd(((h[i] as u64) >> (28 - 4 * j)) & 15);
            j = j + 1;
        }
        i = i + 1;
    }
    return 64;
}

fn sh_same(o: []const u8, want: []const u8) -> bool {
    if (o.len < want.len) { return false; }
    var i : usize = 0;
    while (i < want.len) {
        if (o[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub var SH_H : [8]u32 = [0; 8];
pub var SH_W : [64]u32 = [0; 64];
pub var SH_O : [64]u8 = [0; 64];

test the_digest_of_nothing_and_of_abc {
    assert sha256_hex("", SH_H[0..8], SH_W[0..64], SH_O[0..64]) == 64;
    assert sh_same(SH_O[0..64], "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    assert sha256_hex("abc", SH_H[0..8], SH_W[0..64], SH_O[0..64]) == 64;
    assert sh_same(SH_O[0..64], "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

test a_message_that_needs_two_padding_blocks {
    // 56 bytes: the length no longer fits behind the 0x80 byte
    assert sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", SH_H[0..8], SH_W[0..64], SH_O[0..64]) == 64;
    assert sh_same(SH_O[0..64], "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
}

test a_message_of_several_blocks {
    var big : [1000]u8 = [97; 1000];
    assert sha256_hex(big[0..1000], SH_H[0..8], SH_W[0..64], SH_O[0..64]) == 64;
    assert sh_same(SH_O[0..64], "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3");
}
