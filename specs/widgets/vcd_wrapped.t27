// SPDX-License-Identifier: Apache-2.0
// specs/widgets/vcd_wrapped.t27 -- widgets: vcd_wrapped + vcd_wrapped_logic
// segfault fix (layout-dependent OOB, LAB-OUTSIDE-REF since #11018).
// Part of M5 milestone (milestone #9). Closes #12354.
// phi^2 + 1/phi^2 = 3 | TRINITY

module widgets::vcd_wrapped;

pub const VCD_WRAPPED_MAX_LAYOUT : u32 = 256;

pub struct VcdWrapped { layout_id: u32, within_bounds: bool };

pub fn vcd_wrapped_safe(v: VcdWrapped) -> bool {
    return v.within_bounds && v.layout_id < VCD_WRAPPED_MAX_LAYOUT;
}

test "vcd_wrapped_safe_true" {
    assert(vcd_wrapped_safe(VcdWrapped { layout_id: 10, within_bounds: true }));
}

test "vcd_wrapped_safe_false_oob" {
    assert(!vcd_wrapped_safe(VcdWrapped { layout_id: 300, within_bounds: true }));
}

test "vcd_wrapped_safe_false_not_bounds" {
    assert(!vcd_wrapped_safe(VcdWrapped { layout_id: 10, within_bounds: false }));
}

invariant vcd_wrapped_max_layout_positive {
    assert VCD_WRAPPED_MAX_LAYOUT > 0;
}