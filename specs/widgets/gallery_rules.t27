// SPDX-License-Identifier: Apache-2.0
; specs/widgets/gallery_rules.t27 -- the rules of the widget gallery (app.t27.ai/game/widgets) as
; scalar functions, so t27b can run them native. Epic gHashTag/t27#10937, owner 2026-10-19: the
; gallery is integrated natively into t27b and T27F.
; The gallery is 195 widgets: 104 casts, 8 players, 1 tab, 82 tools; by category 95 fpga, 92
; compiler, 8 game. Its data is gHashTag/trinity apps/website/specs/widgets/gallery.t27 and stays
; there (this file does not copy 195 rows). Its generator, scripts/widgets-from-spec.mjs (269
; lines), does two jobs: I/O (read each widget's page for og tags, read meta.json) and RULES (which
; widget is refused, how tall its embed is, whether its preview carries ?embed=1). The rules are
; here; the I/O stays a thin reader that hands this file booleans. verdict() is the generator's
; problems list as one number, in the generator's order.
; Not claimed: the generator still runs in node today; this file is what replaces its decisions.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_gallery_rules;

pub const K_CAST : u8 = 0;
pub const K_PLAYER : u8 = 1;
pub const K_TAB : u8 = 2;
pub const K_TOOL : u8 = 3;
pub const K_KINDS : u8 = 4;

pub const GALLERY_COUNT : u32 = 195;
pub const KIND_COUNTS : [4]u32 = [104, 8, 1, 82];
pub const CAT_COUNTS : [3]u32 = [95, 92, 8];

pub const EMBED_WIDTH : u32 = 640;
pub const PLAYER_EMBED_HEIGHT : u32 = 360;
pub const CAST_EMBED_HEIGHT : u32 = 460;

pub const V_OK : u8 = 0;
pub const V_TAB_VIEW_MISSING : u8 = 1;
pub const V_PAGE_MISSING : u8 = 2;
pub const V_META_MISSING : u8 = 3;
pub const V_IMAGE_NOT_LOCAL : u8 = 4;
pub const V_CAST_META_MISSING : u8 = 5;
pub const V_CAST_BAD_EXIT : u8 = 6;
pub const V_TOOL_HOOK_MISSING : u8 = 7;
pub const V_PLAYER_EMBED_MISSING : u8 = 8;
pub const V_UNKNOWN_KIND : u8 = 9;

/// Embed query a kind carries: 0 none, 1 "?embed=1", 2 "&embed=1" (a tab already has a query).
pub fn embed_query(kind: u8) -> u8 {
    if (kind == K_TOOL) {
        return 1;
    }
    if (kind == K_TAB) {
        return 2;
    }
    return 0;
}

pub fn embed_height(kind: u8) -> u32 {
    if (kind == K_PLAYER) {
        return PLAYER_EMBED_HEIGHT;
    }
    return CAST_EMBED_HEIGHT;
}

/// A tab has no page of its own to preview; every other kind previews its framed page.
pub fn has_preview(kind: u8) -> bool {
    return kind != K_TAB;
}

/// Why the generator would refuse one widget, or V_OK. The booleans are what its reader found.
pub fn verdict(kind: u8, view_ok: bool, page_ok: bool, meta_ok: bool, image_local: bool, cast_meta: bool, bad_exit: bool, hook_ok: bool, player_ok: bool) -> u8 {
    if (kind >= K_KINDS) {
        return V_UNKNOWN_KIND;
    }
    if (kind == K_TAB) {
        if (view_ok) {
            return V_OK;
        }
        return V_TAB_VIEW_MISSING;
    }
    if (page_ok == false) {
        return V_PAGE_MISSING;
    }
    if (meta_ok == false) {
        return V_META_MISSING;
    }
    if (image_local == false) {
        return V_IMAGE_NOT_LOCAL;
    }
    if (kind == K_CAST) {
        if (cast_meta == false) {
            return V_CAST_META_MISSING;
        }
        if (bad_exit) {
            return V_CAST_BAD_EXIT;
        }
        return V_OK;
    }
    if (kind == K_TOOL) {
        if (hook_ok == false) {
            return V_TOOL_HOOK_MISSING;
        }
        return V_OK;
    }
    if (player_ok == false) {
        return V_PLAYER_EMBED_MISSING;
    }
    return V_OK;
}

pub fn kinds_sum() -> u32 {
    return KIND_COUNTS[0] + KIND_COUNTS[1] + KIND_COUNTS[2] + KIND_COUNTS[3];
}

pub fn cats_sum() -> u32 {
    return CAT_COUNTS[0] + CAT_COUNTS[1] + CAT_COUNTS[2];
}

test the_gallery_counts_agree_by_kind_and_by_category {
    assert kinds_sum() == GALLERY_COUNT;
    assert cats_sum() == GALLERY_COUNT;
}

test embed_size_and_query_follow_the_kind {
    assert embed_height(K_PLAYER) == 360;
    assert embed_height(K_CAST) == 460;
    assert embed_height(K_TOOL) == 460;
    assert embed_height(K_TAB) == 460;
    assert embed_query(K_TOOL) == 1;
    assert embed_query(K_TAB) == 2;
    assert embed_query(K_CAST) == 0;
    assert embed_query(K_PLAYER) == 0;
    assert has_preview(K_TAB) == false;
    assert has_preview(K_TOOL);
}

test a_widget_is_refused_for_the_first_rule_it_breaks {
    assert verdict(K_CAST, true, true, true, true, true, false, false, false) == V_OK;
    assert verdict(K_CAST, true, false, true, true, true, false, false, false) == V_PAGE_MISSING;
    assert verdict(K_CAST, true, true, false, true, true, false, false, false) == V_META_MISSING;
    assert verdict(K_CAST, true, true, true, false, true, false, false, false) == V_IMAGE_NOT_LOCAL;
    assert verdict(K_CAST, true, true, true, true, false, false, false, false) == V_CAST_META_MISSING;
    assert verdict(K_CAST, true, true, true, true, true, true, false, false) == V_CAST_BAD_EXIT;
    assert verdict(K_TOOL, true, true, true, true, false, false, false, false) == V_TOOL_HOOK_MISSING;
    assert verdict(K_TOOL, true, true, true, true, false, false, true, false) == V_OK;
    assert verdict(K_PLAYER, true, true, true, true, false, false, false, false) == V_PLAYER_EMBED_MISSING;
    assert verdict(K_PLAYER, true, true, true, true, false, false, false, true) == V_OK;
    assert verdict(K_TAB, false, false, false, false, false, false, false, false) == V_TAB_VIEW_MISSING;
    assert verdict(K_TAB, true, false, false, false, false, false, false, false) == V_OK;
    assert verdict(K_KINDS, true, true, true, true, true, false, true, true) == V_UNKNOWN_KIND;
}
