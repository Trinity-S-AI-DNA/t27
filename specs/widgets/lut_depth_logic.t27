// SPDX-License-Identifier: Apache-2.0
; specs/widgets/lut_depth_logic.t27 -- the LUT-depth widget's reader: what yosys `ltp` printed, read from
; bytes. Ported from trinity apps/website/public/widgets/lut-depth/ltpparse.js (97 lines). Epic
; gHashTag/t27#10937, issue #10938. The widget's page and scripts/widget-data/lut-depth.mjs both ran
; that JavaScript; here the same rules are .t27, built to wasm, and measured equal to the JavaScript.
; --
; JS export          -> t27 function(s)                       note
;   bare(name)       -> bare_lo(s, lo, hi)                    the one-backslash strip, as a start offset
;   classOf(type, L) -> class_of(s, tl, th, lists)            returns 0 lut 1 carry 2 mux 3 io 4 clocked 5 other
;                                                             (unknown, 6, is decided by the caller: no type)
;   parseLtp(text,L) -> ltp_parse(text, lists) + getters      see "Result layout" below
;   listsOf(K)       -> NOT ported: it only renames the spec's constants into an object; the page glue
;                       writes them into the `lists` bytes (layout below)
; --
; Inputs. text is the UTF-8 bytes of the pasted or dropped text. lists is the cell-type lists as one
; byte string, one entry per line (byte 10): a class digit then the type, e.g. "0LUT6", "1CARRY4",
; "2MUXF7", "3IBUF", "4FDCE" (0 lut, 1 carry, 2 mux, 3 io, 4 clocked). A type in none is "other".
; --
; Result layout (ltp_parse fills module-level tables; the getters read them; every offset is a BYTE
; offset into text, a range is [lo, hi) and the JS string is text[lo..hi] decoded):
;   ltp_parse(text, lists) -> 0 ok, 1 "empty", 2 "noltp", 3 "loop", -1 over a table limit
;   ltp_info(0) blocks, (1) loops, (2) typed (1 = the text held an RTLIL cell line), (3) cellTypes
;           (distinct bare names of `cell` lines), (4) steps in all blocks, (5) cell lines read
;   ltp_blk(b, f) f: 0 module_lo 1 module_hi 2 length 3 command_set 4 command_lo 5 command_hi
;           6 printed (step lines read) 7 first step index 8 lut 9 carry 10 mux 11 io 12 clocked
;           13 other 14 unknown (the counts)
;   ltp_step(i, f) i = ltp_blk(b,7) + k for step k of block b; f: 0 bit_lo 1 bit_hi 2 via_set
;           (0 = JS null, 1 = a string, possibly empty) 3 via_lo 4 via_hi 5 type_set (0 = JS null)
;           6 type_lo 7 type_hi 8 cls (0 lut 1 carry 2 mux 3 io 4 clocked 5 other 6 unknown 7 start)
;   ltp_loop(l, f) f: 0 bit_lo 1 bit_hi 2 module_lo 3 module_hi
; Limits (the JS has none): 1024 blocks, 16384 steps, 1024 loops, 16384 cell lines.
; --
; Quirks of the JavaScript kept on purpose:
;   - a step whose via is empty ("x (via )", or "(via \)") has via "" which is falsy: it is typed
;     null, class "start", and counted in no class;
;   - a block that is current with no step yet is not closed by a non-step line; one with a step is closed by
;     the first line that is not the next step, and a number such as 007 equals 7;
;   - a line with a carriage return inside it matches none of the `.`-ending patterns (JS `.` and `$`);
;   - the last `cell` line for a name wins; cellTypes counts distinct names;
;   - "Detected loop" lines skip the header and step tests of the same line.
; Not ported, by design: JS \s also matches Unicode spaces (NBSP, U+2028 ...) and `.` stops at
; U+2028 and U+2029; here the ASCII \s set is used and every byte of 128 and up is an ordinary
; character. Numbers with more than 15 digits (length=, step index) are exact here and rounded in JS.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_lut_depth_logic;

use widgets::page_reader::match_in;
use widgets::page_reader::is_space;
use widgets::page_reader::pack;
use widgets::page_reader::lo_of;
use widgets::page_reader::hi_of;
use widgets::page_reader::NO_TEXT;

pub const B_NL : u8 = 10;
pub const B_CR : u8 = 13;
pub const B_RPAREN : u8 = 41;
pub const B_BACKSLASH : u8 = 92;
pub const B_BACKTICK : u8 = 96;

pub const CLS_OTHER : u32 = 5;
pub const CLS_UNKNOWN : u32 = 6;
pub const CLS_START : u32 = 7;

pub const MAX_BLOCKS : usize = 1024;
pub const MAX_STEPS : usize = 16384;
pub const MAX_LOOPS : usize = 1024;
pub const MAX_CELLS : usize = 16384;

pub var BLK : [16384]u64 = [0; 16384];
pub var STP : [147456]u32 = [0; 147456];
pub var LOP : [4096]u32 = [0; 4096];
pub var CEL : [65536]u32 = [0; 65536];
pub var SC : [8]u64 = [0; 8];
pub var INFO : [8]u64 = [0; 8];

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

/// JavaScript's \w for the ASCII range.
pub fn is_word(b: u8) -> bool {
    return is_digit(b) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95;
}

pub fn skip_ws(s: []const u8, p0: usize, hi: usize) -> usize {
    var p : usize = p0;
    while (p < hi and is_space(s[p])) { p = p + 1; }
    return p;
}

/// The end of the run of non-space bytes that starts at p0.
pub fn tok_end(s: []const u8, p0: usize, hi: usize) -> usize {
    var p : usize = p0;
    while (p < hi and !is_space(s[p])) { p = p + 1; }
    return p;
}

pub fn digits_end(s: []const u8, p0: usize, hi: usize) -> usize {
    var p : usize = p0;
    while (p < hi and is_digit(s[p])) { p = p + 1; }
    return p;
}

/// The value of the digits s[a..b), held at a ceiling so a long run cannot wrap.
pub fn digits_val(s: []const u8, a: usize, b: usize) -> u64 {
    var v : u64 = 0;
    var k : usize = a;
    while (k < b) {
        if (v < 100000000000000000) { v = v * 10 + ((s[k] - 48) as u64); }
        k = k + 1;
    }
    return v;
}

/// The end of s[lo..hi) with its trailing space removed (JS trimEnd for ASCII).
pub fn rtrim_end(s: []const u8, lo: usize, hi: usize) -> usize {
    var e : usize = hi;
    while (e > lo and is_space(s[e - 1])) { e = e - 1; }
    return e;
}

pub fn has_cr(s: []const u8, a: usize, b: usize) -> bool {
    var k : usize = a;
    while (k < b) {
        if (s[k] == B_CR) { return true; }
        k = k + 1;
    }
    return false;
}

/// The first offset in [from, hi) where w starts, wholly inside the range, or NO_TEXT.
pub fn find_in(s: []const u8, from: usize, hi: usize, w: []const u8) -> i64 {
    var p : usize = from;
    while (p + w.len <= hi) {
        if (match_in(s, p, hi, w)) { return p as i64; }
        p = p + 1;
    }
    return NO_TEXT;
}

/// The last offset in [lo, hi) where w starts, wholly inside the range, or NO_TEXT.
pub fn rfind_in(s: []const u8, lo: usize, hi: usize, w: []const u8) -> i64 {
    if (hi < lo + w.len) { return NO_TEXT; }
    var p : usize = hi - w.len + 1;
    while (p > lo) {
        p = p - 1;
        if (match_in(s, p, hi, w)) { return p as i64; }
    }
    return NO_TEXT;
}

pub fn next_nl(s: []const u8, from: usize) -> usize {
    var p : usize = from;
    while (p < s.len and s[p] != B_NL) { p = p + 1; }
    return p;
}

/// bare(): a public yosys name loses its leading backslash; the start offset of the result.
pub fn bare_lo(s: []const u8, lo: usize, hi: usize) -> usize {
    if (lo < hi and s[lo] == B_BACKSLASH) { return lo + 1; }
    return lo;
}

/// Are s[a..b) and t[c..d) the same bytes?
pub fn same_range(s: []const u8, a: usize, b: usize, t: []const u8, c: usize, d: usize) -> bool {
    if (b - a != d - c) { return false; }
    var k : usize = 0;
    while (a + k < b) {
        if (s[a + k] != t[c + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// classOf for a non-empty type: the first of lut, carry, mux, io, clocked whose list holds it, else other.
pub fn class_of(s: []const u8, tl: usize, th: usize, lists: []const u8) -> u32 {
    var best : u32 = CLS_OTHER;
    var a : usize = 0;
    while (a < lists.len) {
        const e : usize = next_nl(lists, a);
        if (e > a + 1 and lists[a] >= 48 and lists[a] <= 52) {
            if (same_range(s, tl, th, lists, a + 1, e)) {
                const c : u32 = (lists[a] - 48) as u32;
                if (c < best) { best = c; }
            }
        }
        a = e + 1;
    }
    return best;
}

/// The tail of HEAD_RE from q: " (length=<n>):" and then only space to the end of the line.
pub fn head_tail(s: []const u8, q: usize, hi: usize) -> bool {
    if (!match_in(s, q, hi, " (length=")) { return false; }
    const a : usize = q + 9;
    const d : usize = digits_end(s, a, hi);
    if (d == a) { return false; }
    if (!match_in(s, d, hi, "):")) { return false; }
    if (skip_ws(s, d + 2, hi) != hi) { return false; }
    SC[0] = digits_val(s, a, d);
    return true;
}

/// HEAD_RE on the line [lo, hi): the packed range of the module name (lazy, so the first name that
/// lets the tail match), the length in SC[0]; NO_TEXT when the line is no header.
pub fn head_match(s: []const u8, lo: usize, hi: usize) -> i64 {
    var f : i64 = find_in(s, lo, hi, "Longest topological path in ");
    while (f >= 0) {
        const ns : usize = (f as usize) + 28;
        var q : usize = ns + 1;
        var dead : bool = false;
        while (q <= hi and !dead) {
            if (s[q - 1] == B_CR) {
                dead = true;
            } else {
                if (head_tail(s, q, hi)) { return pack(ns, q); }
                q = q + 1;
            }
        }
        f = find_in(s, (f as usize) + 1, hi, "Longest topological path in ");
    }
    return NO_TEXT;
}

/// LOOP_RE on the line: the packed range of the net bit, the module in SC[1]..SC[2]; NO_TEXT when none.
pub fn loop_match(s: []const u8, lo: usize, hi: usize) -> i64 {
    const te : usize = rtrim_end(s, lo, hi);
    var ts : usize = te;
    while (ts > lo and !is_space(s[ts - 1])) { ts = ts - 1; }
    if (ts == te) { return NO_TEXT; }
    if (ts < lo + 4) { return NO_TEXT; }
    if (!match_in(s, ts - 4, hi, " in ")) { return NO_TEXT; }
    const bhi : usize = ts - 4;
    var f : i64 = find_in(s, lo, hi, "Detected loop at ");
    while (f >= 0) {
        const bl : usize = (f as usize) + 17;
        if (bl + 1 <= bhi and !has_cr(s, bl, bhi)) {
            SC[1] = ts as u64;
            SC[2] = te as u64;
            return pack(bl, bhi);
        }
        f = find_in(s, (f as usize) + 1, hi, "Detected loop at ");
    }
    return NO_TEXT;
}

/// CELL_RE on the line: type token in SC[0]..SC[1], name token in SC[2]..SC[3].
pub fn cell_match(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = skip_ws(s, lo, hi);
    if (!match_in(s, p, hi, "cell")) { return false; }
    p = p + 4;
    var q : usize = skip_ws(s, p, hi);
    if (q == p) { return false; }
    p = q;
    q = tok_end(s, p, hi);
    if (q == p) { return false; }
    SC[0] = p as u64;
    SC[1] = q as u64;
    p = skip_ws(s, q, hi);
    if (p == q) { return false; }
    q = tok_end(s, p, hi);
    if (q == p) { return false; }
    SC[2] = p as u64;
    SC[3] = q as u64;
    if (skip_ws(s, q, hi) != hi) { return false; }
    return true;
}

/// STEP_RE on the line: the step number in SC[0] (held at a ceiling), the start of the rest in SC[1].
pub fn step_match(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    const d : usize = digits_end(s, p, hi);
    if (d == p) { return false; }
    if (!match_in(s, d, hi, ": ")) { return false; }
    if (has_cr(s, d + 2, hi)) { return false; }
    SC[0] = digits_val(s, p, d);
    SC[1] = (d + 2) as u64;
    return true;
}

/// \b after a word character: the end of the line or a non-word byte.
pub fn boundary_after(s: []const u8, p: usize, hi: usize) -> bool {
    return p >= hi or !is_word(s[p]);
}

/// The first backtick in [from, hi), else hi.
pub fn backtick_or_end(s: []const u8, from: usize, hi: usize) -> usize {
    var p : usize = from;
    while (p < hi and s[p] != B_BACKTICK) { p = p + 1; }
    return p;
}

/// CMD_RES[0]: yosys> ltp ...   (also yosys [module]> ltp ...)
pub fn cmd_prompt(s: []const u8, lo: usize, hi: usize) -> i64 {
    var p : usize = skip_ws(s, lo, hi);
    if (!match_in(s, p, hi, "yosys")) { return NO_TEXT; }
    p = p + 5;
    if (match_in(s, p, hi, " [")) {
        const c : i64 = find_in(s, p + 2, hi, "]");
        if (c >= 0) { p = (c as usize) + 1; }
    }
    if (!match_in(s, p, hi, "> ")) { return NO_TEXT; }
    p = p + 2;
    if (!match_in(s, p, hi, "ltp")) { return NO_TEXT; }
    if (!boundary_after(s, p + 3, hi)) { return NO_TEXT; }
    const e : usize = rtrim_end(s, p + 3, hi);
    if (has_cr(s, p + 3, e)) { return NO_TEXT; }
    return pack(p, e);
}

/// CMD_RES[1]: -- Running command `ltp ...' --
pub fn cmd_running_ltp(s: []const u8, lo: usize, hi: usize) -> i64 {
    if (!match_in(s, lo, hi, "-- Running command `ltp")) { return NO_TEXT; }
    const t : usize = lo + 23;
    if (!boundary_after(s, t, hi)) { return NO_TEXT; }
    const r : usize = backtick_or_end(s, t, hi);
    const e : i64 = rfind_in(s, t, r, "' --");
    if (e < 0) { return NO_TEXT; }
    return pack(lo + 20, e as usize);
}

/// CMD_RES[2]: -- Running command `... ltp ...' -- with the last whole word ltp that lets the rest fit.
pub fn cmd_running_any(s: []const u8, lo: usize, hi: usize) -> i64 {
    if (!match_in(s, lo, hi, "-- Running command `")) { return NO_TEXT; }
    const a : usize = lo + 20;
    if (hi < a + 3) { return NO_TEXT; }
    var t : usize = hi - 2;
    while (t > a) {
        t = t - 1;
        if (match_in(s, t, hi, "ltp") and !has_cr(s, a, t)) {
            if (t == a or !is_word(s[t - 1])) {
                if (boundary_after(s, t + 3, hi)) {
                    const r : usize = backtick_or_end(s, t + 3, hi);
                    const e : i64 = rfind_in(s, t + 3, r, "' --");
                    if (e >= 0) { return pack(a, e as usize); }
                }
            }
        }
    }
    return NO_TEXT;
}

pub fn cmd_match(s: []const u8, lo: usize, hi: usize) -> i64 {
    var c : i64 = cmd_prompt(s, lo, hi);
    if (c < 0) { c = cmd_running_ltp(s, lo, hi); }
    if (c < 0) { c = cmd_running_any(s, lo, hi); }
    return c;
}

/// The end of the line that starts at ls: the offset of its newline (or the end), minus a CR just before the newline.
pub fn line_hi(s: []const u8, ls: usize, le: usize) -> usize {
    if (le < s.len and le > ls and s[le - 1] == B_CR) { return le - 1; }
    return le;
}

/// Is every byte of the text a space? (JS: no line has anything left after trim.)
pub fn all_space(s: []const u8) -> bool {
    return skip_ws(s, 0, s.len) == s.len;
}

/// Pass 1: every RTLIL `cell <type> <name>` line, in order, into CEL as name_lo, name_hi, type_lo, type_hi.
/// Returns false when there are more than MAX_CELLS.
pub fn read_cells(s: []const u8) -> bool {
    var ls : usize = 0;
    var n : usize = 0;
    var distinct : u64 = 0;
    while (ls <= s.len) {
        const le : usize = next_nl(s, ls);
        const hi : usize = line_hi(s, ls, le);
        if (cell_match(s, ls, hi)) {
            if (n >= MAX_CELLS) { return false; }
            const tl : usize = bare_lo(s, SC[0] as usize, SC[1] as usize);
            const th : usize = SC[1] as usize;
            const nl : usize = bare_lo(s, SC[2] as usize, SC[3] as usize);
            const nh : usize = SC[3] as usize;
            var seen : bool = false;
            var k : usize = 0;
            while (k < n and !seen) {
                if (same_range(s, CEL[k * 4], CEL[k * 4 + 1], s, nl, nh)) { seen = true; }
                k = k + 1;
            }
            if (!seen) { distinct = distinct + 1; }
            CEL[n * 4] = nl as u32;
            CEL[n * 4 + 1] = nh as u32;
            CEL[n * 4 + 2] = tl as u32;
            CEL[n * 4 + 3] = th as u32;
            n = n + 1;
        }
        ls = le + 1;
    }
    INFO[3] = distinct;
    INFO[5] = n as u64;
    return true;
}

/// Pass 3, one step: its type from the dump (the last cell line with its via as name), and its class.
pub fn type_step(s: []const u8, i: usize, lists: []const u8) -> u32 {
    const vf : u32 = STP[i * 9 + 2];
    const vl : usize = STP[i * 9 + 3] as usize;
    const vh : usize = STP[i * 9 + 4] as usize;
    STP[i * 9 + 5] = 0;
    STP[i * 9 + 6] = 0;
    STP[i * 9 + 7] = 0;
    if (vf == 0 or vh <= vl) {
        STP[i * 9 + 8] = CLS_START;
        return CLS_START;
    }
    var k : usize = INFO[5] as usize;
    var cls : u32 = CLS_UNKNOWN;
    var found : bool = false;
    while (k > 0 and !found) {
        k = k - 1;
        if (same_range(s, CEL[k * 4], CEL[k * 4 + 1], s, vl, vh)) {
            found = true;
            STP[i * 9 + 5] = 1;
            STP[i * 9 + 6] = CEL[k * 4 + 2];
            STP[i * 9 + 7] = CEL[k * 4 + 3];
            if (CEL[k * 4 + 3] > CEL[k * 4 + 2]) {
                cls = class_of(s, CEL[k * 4 + 2] as usize, CEL[k * 4 + 3] as usize, lists);
            }
        }
    }
    STP[i * 9 + 8] = cls;
    return cls;
}

/// parseLtp. Returns 0 ok, 1 empty, 2 noltp, 3 loop, -1 over a table limit.
pub fn ltp_parse(text: []const u8, lists: []const u8) -> i32 {
    INFO[0] = 0;
    INFO[1] = 0;
    INFO[2] = 0;
    INFO[3] = 0;
    INFO[4] = 0;
    INFO[5] = 0;
    if (all_space(text)) { return 1; }
    if (!read_cells(text)) { return -1; }
    var nb : usize = 0;
    var ns : usize = 0;
    var nl : usize = 0;
    var cmd_set : u64 = 0;
    var cmd_lo : u64 = 0;
    var cmd_hi : u64 = 0;
    var cur : i64 = -1;
    var ls : usize = 0;
    while (ls <= text.len) {
        const le : usize = next_nl(text, ls);
        const hi : usize = line_hi(text, ls, le);
        const c : i64 = cmd_match(text, ls, hi);
        if (c >= 0) {
            cmd_set = 1;
            cmd_lo = lo_of(c) as u64;
            cmd_hi = hi_of(c) as u64;
        }
        var handled : bool = false;
        const lm : i64 = loop_match(text, ls, hi);
        if (lm >= 0) {
            if (nl >= MAX_LOOPS) { return -1; }
            LOP[nl * 4] = lo_of(lm) as u32;
            LOP[nl * 4 + 1] = hi_of(lm) as u32;
            LOP[nl * 4 + 2] = SC[1] as u32;
            LOP[nl * 4 + 3] = SC[2] as u32;
            nl = nl + 1;
            handled = true;
        }
        if (!handled) {
            const hm : i64 = head_match(text, ls, hi);
            if (hm >= 0) {
                if (nb >= MAX_BLOCKS) { return -1; }
                const len : u64 = SC[0];
                const ml : usize = bare_lo(text, lo_of(hm), hi_of(hm));
                const b : usize = nb * 16;
                BLK[b] = ml as u64;
                BLK[b + 1] = hi_of(hm) as u64;
                BLK[b + 2] = len;
                BLK[b + 3] = cmd_set;
                BLK[b + 4] = cmd_lo;
                BLK[b + 5] = cmd_hi;
                BLK[b + 6] = 0;
                BLK[b + 7] = ns as u64;
                var z : usize = 8;
                while (z < 15) {
                    BLK[b + z] = 0;
                    z = z + 1;
                }
                cur = nb as i64;
                nb = nb + 1;
                handled = true;
            }
        }
        if (!handled and cur >= 0) {
            const cb : usize = (cur as usize) * 16;
            var took : bool = false;
            if (step_match(text, ls, hi)) {
                if (SC[0] == BLK[cb + 6]) {
                    if (ns >= MAX_STEPS) { return -1; }
                    var bl : usize = SC[1] as usize;
                    var bh : usize = hi;
                    var vf : u32 = 0;
                    var vl : usize = 0;
                    var vh : usize = 0;
                    if (bh > bl and text[bh - 1] == B_RPAREN) {
                        const at : i64 = rfind_in(text, bl, bh, " (via ");
                        if (at >= 0) {
                            vl = bare_lo(text, (at as usize) + 6, bh - 1);
                            vh = bh - 1;
                            vf = 1;
                            bh = at as usize;
                        }
                    }
                    STP[ns * 9] = bl as u32;
                    STP[ns * 9 + 1] = bh as u32;
                    STP[ns * 9 + 2] = vf;
                    STP[ns * 9 + 3] = vl as u32;
                    STP[ns * 9 + 4] = vh as u32;
                    ns = ns + 1;
                    BLK[cb + 6] = BLK[cb + 6] + 1;
                    took = true;
                }
            }
            if (!took and BLK[cb + 6] > 0) { cur = -1; }
        }
        ls = le + 1;
    }
    INFO[0] = nb as u64;
    INFO[1] = nl as u64;
    INFO[4] = ns as u64;
    if (nb == 0) {
        if (nl > 0) { return 3; }
        return 2;
    }
    INFO[2] = 0;
    if (INFO[3] > 0) { INFO[2] = 1; }
    var bi : usize = 0;
    while (bi < nb) {
        const first : usize = BLK[bi * 16 + 7] as usize;
        const cnt : usize = BLK[bi * 16 + 6] as usize;
        var k : usize = 0;
        while (k < cnt) {
            const cls : u32 = type_step(text, first + k, lists);
            if (cls < CLS_START) { BLK[bi * 16 + 8 + (cls as usize)] = BLK[bi * 16 + 8 + (cls as usize)] + 1; }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return 0;
}

pub fn ltp_info(f: u32) -> u64 {
    return INFO[f as usize];
}

pub fn ltp_blk(b: u32, f: u32) -> u64 {
    return BLK[(b as usize) * 16 + (f as usize)];
}

pub fn ltp_step(i: u32, f: u32) -> u32 {
    return STP[(i as usize) * 9 + (f as usize)];
}

pub fn ltp_loop(l: u32, f: u32) -> u32 {
    return LOP[(l as usize) * 4 + (f as usize)];
}

// ---------------------------------------------------------------------------------------------
// Test support: a text built from lines (the string literals cannot hold a newline).
pub var TXT : [8192]u8 = [0; 8192];
pub var TXN : usize = 0;
pub var LST : [256]u8 = [0; 256];
pub var LSN : usize = 0;

pub fn tx_reset() -> usize {
    TXN = 0;
    return 0;
}

pub fn tx_line(s: []const u8) -> usize {
    var k : usize = 0;
    while (k < s.len) {
        TXT[TXN] = s[k];
        TXN = TXN + 1;
        k = k + 1;
    }
    TXT[TXN] = B_NL;
    TXN = TXN + 1;
    return TXN;
}

pub fn ls_line(s: []const u8) -> usize {
    var k : usize = 0;
    while (k < s.len) {
        LST[LSN] = s[k];
        LSN = LSN + 1;
        k = k + 1;
    }
    LST[LSN] = B_NL;
    LSN = LSN + 1;
    return LSN;
}

/// The lists the widget's spec names (K_LUT_TYPES ... K_CLOCKED_TYPES), in the lists layout.
pub fn lists_default() -> usize {
    LSN = 0;
    ls_line("0LUT1");
    ls_line("0LUT2");
    ls_line("0LUT3");
    ls_line("0LUT4");
    ls_line("0LUT5");
    ls_line("0LUT6");
    ls_line("0$lut");
    ls_line("1CARRY4");
    ls_line("2MUXF7");
    ls_line("2MUXF8");
    ls_line("3IBUF");
    ls_line("3OBUF");
    ls_line("3BUFG");
    ls_line("4FDRE");
    ls_line("4FDCE");
    ls_line("4SRL16E");
    return LSN;
}

/// Does s[lo..hi) read exactly w?
pub fn is_text(s: []const u8, lo: u64, hi: u64, w: []const u8) -> bool {
    return (hi - lo) == (w.len as u64) and match_in(s, lo as usize, hi as usize, w);
}

/// The sample's first path, cut to its first four steps, with the real names, and a dump of the cells it names.
pub fn short_block() -> usize {
    tx_reset();
    tx_line("yosys> ltp -noff t:FD* %n");
    tx_line("");
    tx_line("Longest topological path in gf16_add (length=3):");
    tx_line("    0: \\in_b [12]");
    tx_line("    1: \\exp_b [3] (via $iopadmap$gf16_add.in_b_12)");
    tx_line("    2: $auto$alumacc.cc:512:replace_alu$1455.X [3] (via $abc$2850$auto$blifparse.cc:557:parse_blif$2977)");
    tx_line("    3: $auto$alumacc.cc:512:replace_alu$1455.CO [3] (via $auto$alumacc.cc:512:replace_alu$1455.genblk1.slice[0].genblk1.carry4)");
    tx_line("");
    tx_line("yosys> dump t:*");
    tx_line("  cell \\IBUF $iopadmap$gf16_add.in_b_12");
    tx_line("  cell \\LUT2 $abc$2850$auto$blifparse.cc:557:parse_blif$2977");
    tx_line("  cell \\CARRY4 $auto$alumacc.cc:512:replace_alu$1455.genblk1.slice[0].genblk1.carry4");
    tx_line("  cell \\FDCE $auto$ff.cc:337:slice$1884");
    return TXN;
}

test a_complete_block_is_typed_from_the_dump {
    lists_default();
    short_block();
    const t : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(t, LST[0 .. LSN]) == 0;
    assert ltp_info(0) == 1;
    assert ltp_info(2) == 1;
    assert ltp_info(3) == 4;
    assert ltp_info(4) == 4;
    assert is_text(t, ltp_blk(0, 0), ltp_blk(0, 1), "gf16_add");
    assert ltp_blk(0, 2) == 3;
    assert ltp_blk(0, 6) == 4;
    assert ltp_blk(0, 8) == 1;
    assert ltp_blk(0, 9) == 1;
    assert ltp_blk(0, 11) == 1;
    assert ltp_blk(0, 14) == 0;
    assert ltp_step(0, 8) == 7;
    assert ltp_step(1, 8) == 3;
    assert ltp_step(2, 8) == 0;
    assert ltp_step(3, 8) == 1;
    assert ltp_step(2, 5) == 1;
}

test the_steps_keep_their_bits_vias_and_types {
    lists_default();
    short_block();
    const t : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(t, LST[0 .. LSN]) == 0;
    assert is_text(t, ltp_step(0, 0) as u64, ltp_step(0, 1) as u64, "\\in_b [12]");
    assert ltp_step(0, 2) == 0;
    assert is_text(t, ltp_step(1, 0) as u64, ltp_step(1, 1) as u64, "\\exp_b [3]");
    assert is_text(t, ltp_step(1, 3) as u64, ltp_step(1, 4) as u64, "$iopadmap$gf16_add.in_b_12");
    assert is_text(t, ltp_step(1, 6) as u64, ltp_step(1, 7) as u64, "IBUF");
    assert is_text(t, ltp_step(2, 6) as u64, ltp_step(2, 7) as u64, "LUT2");
    assert is_text(t, ltp_step(3, 6) as u64, ltp_step(3, 7) as u64, "CARRY4");
    assert ltp_step(1, 5) == 1;
    assert ltp_step(0, 5) == 0;
}

test the_command_is_the_last_one_seen_before_the_header {
    lists_default();
    short_block();
    const t : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(t, LST[0 .. LSN]) == 0;
    assert ltp_blk(0, 3) == 1;
    assert is_text(t, ltp_blk(0, 4), ltp_blk(0, 5), "ltp -noff t:FD* %n");
    tx_reset();
    tx_line("-- Running command `ltp -noff' --");
    tx_line("Longest topological path in top (length=0):");
    tx_line("    0: \\a");
    const u : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(u, LST[0 .. LSN]) == 0;
    assert is_text(u, ltp_blk(0, 4), ltp_blk(0, 5), "ltp -noff");
    tx_reset();
    tx_line("-- Running command `read_verilog x.v; ltp -noff; stat' --");
    tx_line("  yosys [top]> ltp   ");
    tx_line("Longest topological path in top (length=0):");
    tx_line("    0: \\a");
    const w : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(w, LST[0 .. LSN]) == 0;
    assert is_text(w, ltp_blk(0, 4), ltp_blk(0, 5), "ltp");
    tx_reset();
    tx_line("Longest topological path in top (length=0):");
    const x : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(x, LST[0 .. LSN]) == 0;
    assert ltp_blk(0, 3) == 0;
}

test without_a_dump_every_step_is_type_not_given {
    lists_default();
    tx_reset();
    tx_line("Longest topological path in gf16_add (length=23):");
    tx_line("    0: \\in_b [12]");
    tx_line("    1: \\exp_b [3] (via $iopadmap$gf16_add.in_b_12)");
    tx_line("    2: $auto$alumacc.cc:512:replace_alu$1455.X [3] (via $abc$2850$auto$blifparse.cc:557:parse_blif$2977)");
    const t : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(t, LST[0 .. LSN]) == 0;
    assert ltp_info(2) == 0;
    assert ltp_info(3) == 0;
    assert ltp_blk(0, 2) == 23;
    assert ltp_blk(0, 6) == 3;
    assert ltp_blk(0, 14) == 2;
    assert ltp_step(1, 8) == 6;
    assert ltp_step(1, 5) == 0;
    assert ltp_step(0, 8) == 7;
}

test a_block_ends_at_the_first_line_that_is_not_its_next_step {
    lists_default();
    tx_reset();
    tx_line("Longest topological path in a (length=9):");
    tx_line("");
    tx_line("    0: x");
    tx_line("    1: y (via c1)");
    tx_line("    3: z (via c2)");
    tx_line("    2: w (via c3)");
    tx_line("Longest topological path in b (length=1):");
    tx_line("  007: early");
    tx_line("    0: p");
    tx_line("    1: q (via )");
    tx_line("    2: r (via \\)");
    tx_line("    3: s (via \\c4) ");
    const t : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(t, LST[0 .. LSN]) == 0;
    assert ltp_info(0) == 2;
    assert ltp_blk(0, 6) == 2;
    assert ltp_blk(1, 6) == 4;
    assert ltp_blk(0, 7) == 0;
    assert ltp_blk(1, 7) == 2;
    assert ltp_step(3, 2) == 1;
    assert ltp_step(3, 4) == ltp_step(3, 3);
    assert ltp_step(3, 8) == 7;
    assert ltp_step(4, 2) == 1;
    assert ltp_step(4, 4) == ltp_step(4, 3);
    assert ltp_step(5, 2) == 0;
    assert is_text(t, ltp_step(5, 0) as u64, ltp_step(5, 1) as u64, "s (via \\c4) ");
    assert ltp_blk(1, 14) == 0;
    assert ltp_blk(1, 8) + ltp_blk(1, 13) == 0;
}

test the_three_failures_are_told_apart {
    lists_default();
    tx_reset();
    tx_line("   ");
    tx_line("");
    assert ltp_parse(TXT[0 .. TXN], LST[0 .. LSN]) == 1;
    tx_reset();
    tx_line("Hello. Nothing from ltp here. 12: x");
    assert ltp_parse(TXT[0 .. TXN], LST[0 .. LSN]) == 2;
    assert ltp_info(0) == 0;
    tx_reset();
    tx_line("Detected loop at \\foo [3] in gf16_add");
    const t : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(t, LST[0 .. LSN]) == 3;
    assert ltp_info(1) == 1;
    assert is_text(t, ltp_loop(0, 0) as u64, ltp_loop(0, 1) as u64, "\\foo [3]");
    assert is_text(t, ltp_loop(0, 2) as u64, ltp_loop(0, 3) as u64, "gf16_add");
    tx_reset();
    tx_line("Detected loop at \\foo in a in b   ");
    tx_line("Longest topological path in b (length=0):");
    const u : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(u, LST[0 .. LSN]) == 0;
    assert ltp_info(1) == 1;
    assert is_text(u, ltp_loop(0, 0) as u64, ltp_loop(0, 1) as u64, "\\foo in a");
    assert is_text(u, ltp_loop(0, 2) as u64, ltp_loop(0, 3) as u64, "b");
}

test class_of_follows_the_lists_and_a_cell_line_overrides_an_earlier_one {
    lists_default();
    assert class_of("LUT6", 0, 4, LST[0 .. LSN]) == 0;
    assert class_of("$lut", 0, 4, LST[0 .. LSN]) == 0;
    assert class_of("CARRY4", 0, 6, LST[0 .. LSN]) == 1;
    assert class_of("MUXF8", 0, 5, LST[0 .. LSN]) == 2;
    assert class_of("BUFG", 0, 4, LST[0 .. LSN]) == 3;
    assert class_of("FDCE", 0, 4, LST[0 .. LSN]) == 4;
    assert class_of("RAMB36E1", 0, 8, LST[0 .. LSN]) == 5;
    assert class_of("LUT", 0, 3, LST[0 .. LSN]) == 5;
    tx_reset();
    tx_line("Longest topological path in t (length=1):");
    tx_line("    0: a");
    tx_line("    1: b (via u1)");
    tx_line("cell \\LUT2 u1");
    tx_line("cell \\FDCE u1");
    tx_line("cell \\IBUF \\u2");
    const t : []const u8 = TXT[0 .. TXN];
    assert ltp_parse(t, LST[0 .. LSN]) == 0;
    assert ltp_info(3) == 2;
    assert ltp_step(1, 8) == 4;
    assert ltp_blk(0, 12) == 1;
    assert ltp_blk(0, 8) == 0;
}
