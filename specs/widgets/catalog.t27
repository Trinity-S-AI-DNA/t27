// SPDX-License-Identifier: Apache-2.0
; specs/widgets/catalog.t27 -- the census of every widget in every t27 project, and how much of each
; is still written by hand. Owner, 2026-10-19: find all widgets in all projects, catalogue them,
; rewrite the hand-written ones in .t27, make them easy to work with, move the lesson into an epic
; for tri CLI and TRI CLAW, and build a widget factory natively in t27f, t27b and t27c seal.
; This file is the catalogue. The factory that retires the hand-written column is
; specs/t27f/widget_factory.t27; the shipped gallery (what a reader may share) is
; specs/widgets/gallery.t27 in gHashTag/trinity and is NOT copied here -- this spec counts, it does
; not list titles.
; --
; MEASURED 2026-10-19 at gHashTag/trinity origin/main, wc -l of every file, nothing estimated:
;   apps/website/public/widgets/<id>/   82 widget folders, app.t27.ai/game/widgets previews them
;   apps/website/specs/widgets/<id>.t27 the words and numbers of each (SAY_ and K_ constants)
;   apps/website/scripts/widget-data/   the data builders (.mjs) and the card renderers (.py)
;   apps/queen/QueenUI/Widgets/         105 SwiftUI views, 42052 lines
;   apps/website/src/components/        11 React *Widget*.tsx, 4902 lines
; Of the 82 folders, 54 are LESSONS (27 basics-*, 27 golden-*): a 3-line tool.js and a 47-48 line
; page, both generated from the spec. They are already native. The other 28 are TOOLS and carry
; hand-written JavaScript, CSS, a Node data builder and a Python card renderer.
; --
; What the census found, which no one had written down:
;  1. A tool is TWO layers. 12 of the 28 have a pure logic file beside tool.js (rule.js, bitparse.js,
;     fsmparse.js, lut.js, treemap.js, xdc.js, statparse.js, ...): 2775 lines of functions of
;     numbers and text, no DOM. They port to .t27 and gen-ts as they stand, and the spec's test
;     blocks replace the fixed answers the data builder re-checks today (gatle.mjs imports rule.js
;     "so the page cannot drift from the spec" -- one source would make that true by construction).
;  2. The other 8920 lines are DOM drawing. Every tool.js opens with the same helpers (fill, el,
;     link, a stylesheet link) and then builds tables, bars, maps and timelines. That is a renderer,
;     not 28 programs: ui_plan.t27 already decides that a plan is data and a trusted renderer draws
;     it. The factory extends that catalog instead of adding a second one.
;  3. 23 tools have a Node data builder (5572 lines) and 24 a Python card renderer (3415 lines).
;     The card is a picture of the page; t27f draws pictures from specs already (SF_STILL).
; --
; Stages reached, each with a differential against the hand-written version on the trinity side.
; PORT_LOGIC (the pure logic file is .t27, built to wasm, 0 mismatches against the JavaScript):
; gatle 866178 comparisons, lut-depth 12125, stat-card 30827, fasm-skyline 384784, lut-treemap
; 14667449, lut-explain 1395124, bit-diff 275620, vcd-wrapped 76076, pin-map 180587, synth-smells 87094, fsm-sketch 91657 (its Math.sin/cos/atan2 stay with the host: V8 differs from libm in the last bit), bit-autopsy 96007.
; With these, all 12 pure logic files of the census (2775 lines of JavaScript) exist as .t27.
; gatle is at PORT_LOGIC (specs/widgets/gatle_rule.t27: 866178 comparisons vs rule.js, 0 mismatches)
; and jtag-verdict, race-the-bee, t27-vs-nvfp4, t27-cell, build-receipt, uart-bucket, test-touch, pin-map, lut-depth, lut-explain, gf16-calc and resource-bars at PORT_DRAW (specs/widgets/jtag_verdict.t27: 3015 DOM
; comparisons vs tool.js, 0 mismatches; specs/widgets/race_the_bee.t27: 59, with 13 data variants, 0). Every other tool is at PORT_WORDS: its words live in its spec, its logic and drawing
; still live in JavaScript. A stage is reached on the t27 side first; the page in trinity keeps
; loading the hand-written file until that repo's migration PR deletes it. A tool moves up only when
; its output is identical to the hand version, and the factory spec states that gate.
; The Swift and React widgets are counted, not classified: they are another renderer's targets.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_catalog;

pub const KIND : str = "widgets-catalog";
pub const ID : str = "widgets/catalog";
pub const MEASURED : str = "2026-10-19";
pub const MEASURED_AT : str = "gHashTag/trinity origin/main";

; --- What the gallery serves, by kind (gallery.t27: WIDGET_COUNT) -------------------------------
pub const GALLERY_CASTS : u32 = 104;
pub const GALLERY_PLAYERS : u32 = 8;
pub const GALLERY_TABS : u32 = 1;
pub const GALLERY_TOOLS : u32 = 82;
pub const GALLERY_COUNT : u32 = 195;

; --- The 82 tool folders ----------------------------------------------------------------------
pub const LESSON_BASICS : u32 = 27;
pub const LESSON_GOLDEN : u32 = 27;
pub const TOOL_COUNT : u32 = 28;

; --- Other renderers' widgets, counted not classified ------------------------------------------
pub const SWIFT_FILES : u32 = 105;
pub const SWIFT_LINES : u32 = 42052;
pub const REACT_FILES : u32 = 11;
pub const REACT_LINES : u32 = 4902;

; --- The 28 tools, in alphabetical order; every array below is TOOL_COUNT long -----------------
pub const TOOL_IDS : [28]str = ["bit-autopsy", "bit-diff", "build-receipt", "cost-curves", "fasm-skyline", "fits-on", "fsm-sketch", "gatle", "gf16-calc", "idcode", "jtag-verdict", "lut-depth", "lut-explain", "lut-treemap", "pin-map", "placement-map", "race-the-bee", "resource-bars", "slack-waterfall", "stat-card", "synth-smells", "t27-cell", "t27-vs-nvfp4", "t27c-stages", "test-touch", "test-waves", "uart-bucket", "vcd-wrapped"];

; Hand-written lines per tool. LOGIC is the pure parser/rule file beside tool.js (0 when the tool
; has none), DRAW is tool.js. CSS is tool.css. DATA is scripts/widget-data/<id>.mjs, CARD is
; scripts/widget-data/<id>-card.py (0 when the tool has neither). SPEC is specs/widgets/<id>.t27.
pub const LOGIC_LINES : [28]u32 = [289, 371, 0, 0, 122, 0, 379, 51, 0, 0, 0, 97, 370, 289, 207, 0, 0, 0, 0, 127, 192, 0, 0, 0, 0, 0, 0, 281];
pub const DRAW_LINES : [28]u32 = [376, 274, 221, 273, 533, 232, 361, 309, 511, 316, 171, 241, 588, 322, 340, 379, 105, 172, 369, 318, 304, 187, 192, 364, 146, 726, 228, 362];
pub const CSS_LINES : [28]u32 = [57, 50, 127, 65, 43, 51, 56, 98, 114, 96, 61, 89, 128, 85, 151, 32, 51, 33, 42, 48, 76, 78, 78, 169, 89, 34, 72, 78];
pub const DATA_LINES : [28]u32 = [184, 124, 329, 395, 266, 209, 294, 411, 0, 153, 0, 187, 242, 252, 187, 0, 208, 0, 0, 163, 203, 144, 221, 109, 696, 144, 177, 274];
pub const CARD_LINES : [28]u32 = [103, 72, 201, 131, 153, 126, 194, 131, 0, 121, 117, 150, 104, 252, 206, 0, 89, 0, 0, 147, 148, 85, 101, 163, 133, 189, 129, 170];
pub const SPEC_LINES : [28]u32 = [183, 148, 139, 246, 196, 187, 197, 188, 193, 180, 159, 197, 304, 233, 189, 125, 110, 121, 135, 201, 201, 134, 168, 153, 183, 124, 129, 198];

; Port stage of one tool. A tool moves up only through widget_factory.t27's port_gate.
pub const PORT_HAND : u8 = 0; // words and rules in JavaScript
pub const PORT_WORDS : u8 = 1; // words and numbers in the spec (every tool today)
pub const PORT_LOGIC : u8 = 2; // pure logic is .t27, generated to JS by gen-ts
pub const PORT_DRAW : u8 = 3; // the page is drawn by the trusted renderer from a plan
pub const PORT_SEALED : u8 = 4; // the spec seal keys the page, the data and the card
pub const PORT_STAGES : u8 = 5;
pub const TOOL_PORT : [28]u8 = [2, 2, 3, 1, 2, 1, 2, 2, 3, 1, 3, 3, 3, 2, 3, 1, 3, 3, 1, 2, 2, 3, 3, 1, 3, 1, 3, 2];

; Port waves, by the hand lines a tool still carries (logic + draw + css + data + card).
; Wave 1 is the small tools, wave 3 the largest; a wave is a batch of port issues.
pub const WAVE_1_MAX : u32 = 700;
pub const WAVE_2_MAX : u32 = 1000;

pub fn gallery_sum() -> u32 {
    return GALLERY_CASTS + GALLERY_PLAYERS + GALLERY_TABS + GALLERY_TOOLS;
}

pub fn folder_sum() -> u32 {
    return LESSON_BASICS + LESSON_GOLDEN + TOOL_COUNT;
}

pub fn hand_lines(i: u32) -> u32 {
    return LOGIC_LINES[i] + DRAW_LINES[i] + CSS_LINES[i] + DATA_LINES[i] + CARD_LINES[i];
}

pub fn wave_of(lines: u32) -> u32 {
    if (lines <= WAVE_1_MAX) {
        return 1;
    }
    if (lines <= WAVE_2_MAX) {
        return 2;
    }
    return 3;
}

pub fn has_logic_file(i: u32) -> bool {
    return LOGIC_LINES[i] > 0;
}

pub fn sum_lines(a: [28]u32) -> u32 {
    var s : u32 = 0;
    var i : u32 = 0;
    while (i < TOOL_COUNT) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

pub fn total_hand() -> u32 {
    return sum_lines(LOGIC_LINES) + sum_lines(DRAW_LINES) + sum_lines(CSS_LINES) + sum_lines(DATA_LINES) + sum_lines(CARD_LINES);
}

pub fn count_with(a: [28]u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < TOOL_COUNT) {
        if (a[i] > 0) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn count_wave(w: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < TOOL_COUNT) {
        if (wave_of(hand_lines(i)) == w) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn count_port(stage: u8) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < TOOL_COUNT) {
        if (TOOL_PORT[i] == stage) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

test the_gallery_kinds_add_up_to_its_count {
    assert gallery_sum() == GALLERY_COUNT;
    assert GALLERY_COUNT == 195;
}

test the_tool_folders_are_lessons_plus_tools {
    assert folder_sum() == GALLERY_TOOLS;
}

test every_tool_has_an_id_and_a_spec {
    var i : u32 = 0;
    while (i < TOOL_COUNT) {
        assert SPEC_LINES[i] > 100;
        assert DRAW_LINES[i] > 0;
        assert CSS_LINES[i] > 0;
        i = i + 1;
    }
    assert TOOL_IDS[0] == "bit-autopsy";
    assert TOOL_IDS[7] == "gatle";
    assert TOOL_IDS[27] == "vcd-wrapped";
}

test the_hand_written_column_is_the_measured_total {
    assert sum_lines(LOGIC_LINES) == 2775;
    assert sum_lines(DRAW_LINES) == 8920;
    assert sum_lines(CSS_LINES) == 2151;
    assert sum_lines(DATA_LINES) == 5572;
    assert sum_lines(CARD_LINES) == 3415;
    assert sum_lines(SPEC_LINES) == 4921;
    assert total_hand() == 22833;
}

test twelve_tools_split_logic_from_drawing {
    assert count_with(LOGIC_LINES) == 12;
    assert has_logic_file(7);
    assert has_logic_file(2) == false;
    assert LOGIC_LINES[7] == 51;
    assert count_with(DATA_LINES) == 23;
    assert count_with(CARD_LINES) == 24;
}

test the_waves_cover_every_tool_once {
    assert count_wave(1) == 11;
    assert count_wave(2) == 8;
    assert count_wave(3) == 9;
    assert count_wave(1) + count_wave(2) + count_wave(3) == TOOL_COUNT;
    assert hand_lines(17) == 205;
    assert hand_lines(7) == 1000;
    assert wave_of(hand_lines(7)) == 2;
    assert hand_lines(26) == 606;
    assert hand_lines(12) == 1432;
}

test twelve_pages_are_native_and_the_remaining_logic_files_are_ported {
    assert count_port(PORT_DRAW) == 12;
    assert count_port(PORT_LOGIC) == 9;
    assert count_port(PORT_WORDS) == 7;
    assert count_port(PORT_SEALED) == 0;
    assert TOOL_PORT[17] == PORT_DRAW;
    assert TOOL_PORT[14] == PORT_DRAW;
    assert TOOL_PORT[8] == PORT_DRAW;
    assert TOOL_PORT[7] == PORT_LOGIC;
}
