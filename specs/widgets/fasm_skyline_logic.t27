// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fasm_skyline_logic.t27 -- the fasm-skyline widget's counting: the features a FASM text sets in
; each tile, the tile grid of the XC7A200T, and the totals per family. Ported from trinity
; apps/website/public/widgets/fasm-skyline/skyline.js (122 lines). Epic gHashTag/t27#10937, issue #10938.
; --
; JS export         -> t27 function(s)                         note
;   parseFasm(text) -> parse_fasm(text) + fa_* getters         tiles keep first-appearance order
;   decodeGrid(g)   -> grid_begin, grid_types, grid_rle, grid_prefixes, grid_segs, grid_except, then
;                      grid_lookup(name) and grid_at(gx, gy)    g.json is split into those calls by the glue
;   familyOf(...)   -> fam_set(prefixes, families, names) once, then family_of(type)
;   summarize(...)  -> summarize(), results through sm_* getters  famOfType is family_of; nFam = names count
;   expand, zeroValue, TILE_RE are not exported by JS: expand is folded into seg_value, zeroValue is
;                      zero_value, TILE_RE is tile_split.
; --
; Result layouts (a string is (offset, length) into the pool: read it with pool(i)).
;   parse_fasm(text) -> 0 ok, -1 over a limit (a line over 1 MB, 65536 tiles, 8 MB of strings)
;   fa_info(f): 0 features 1 comments 2 cleared 3 header count (at most 8) 4 tile count 5 bad count (at most 200)
;   fa_header(i, f), fa_bad(i, f): f 0 offset 1 length.   fa_tile(i, f): f 0 offset 1 length 2 count.
;   Grid. grid_begin(w, h) -> 0, or -1 over 4194304 cells. grid_types(list): the type names, each ended by byte 10.
;   grid_rle(u32 pairs value, count) -> 0, or 1 when the runs do not cover w*h cells (decodeGrid throws).
;   grid_prefixes(axis, list): the keys of g.x (axis 0) or g.y (axis 1), each ended by byte 10, numbered
;   in the order given across both calls. grid_segs(i32 records of 7: axis, prefix number, k0, v0, n, dk, dv).
;   grid_except(list of names ended by byte 10, i32 pairs gx, gy). All numbers are whole.
;   grid_lookup(name) -> 1 and lk(0..3) = gx, gy, type length (the type is the name without its _X<n>Y<n>
;   tail), type index; or 0 for JS null. grid_at(gx, gy) -> the cell byte, or -1 for undefined.
;   family lists: each item ended by byte 10.   family_of(type) -> the family index, -1 when the family
;   name is not in the names.
;   summarize() -> 0; sm_info(f): 0 columns 1 off-die tiles 2 features 3 placed features 4 tiles
;   5 tallest column (index, or -1);  sm_col(i, f): 0 tile index 1 gx 2 gy 3 type length 4 family 5 count
;   (the tile index is an fa_tile index; the name is fa_tile(idx,0..1));  sm_off(i, f): 0 tile index 1 count;
;   sm_fam(k, f): 0 tiles 1 features (k below 64).
; --
; JavaScript quirks kept: `#` starts a comment even inside {...}; annotations {..} are cut out before
; the line is cut at '='; a value of 0, 0'b0, 8'h00 (underscores ignored) clears and is counted apart;
; a name without a tile prefix is "bad" (the first 200 are kept); a family -1 is counted nowhere in
; famTiles; a later duplicate type or segment wins, as Map.set does; the grid cell is read at
; gx*h+gy even when gy is past h (it wraps into the next column), and outside 0..w*h it is undefined.
; Not carried: fractional or huge grid numbers; a family list with more than 64 families.
; Trim uses the JavaScript whitespace set on UTF-8 (NBSP, U+2028 ... U+FEFF).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fasm_skyline_logic;

pub const V_PN : usize = 0;
pub const V_FEAT : usize = 1;
pub const V_COM : usize = 2;
pub const V_CLR : usize = 3;
pub const V_NH : usize = 4;
pub const V_NT : usize = 5;
pub const V_NB : usize = 6;
pub const V_GW : usize = 8;
pub const V_GH : usize = 9;
pub const V_NTY : usize = 10;
pub const V_NPF : usize = 11;
pub const V_NSEG : usize = 12;
pub const V_NEX : usize = 13;
pub const V_GP : usize = 14;
pub const V_FPL : usize = 15;
pub const V_FFL : usize = 16;
pub const V_FNL : usize = 17;
pub const V_SM0 : usize = 20;

pub var V : [32]u64 = [0; 32];
pub var SC : [4]u64 = [0; 4];
pub var LK : [4]i64 = [0; 4];
pub var SV : [2]i64 = [0; 2];
pub var POOL : [8388608]u8 = [0; 8388608];
pub var LINE : [1048576]u8 = [0; 1048576];
pub var VB : [1048576]u8 = [0; 1048576];
pub var HDRO : [8]u32 = [0; 8];
pub var HDRL : [8]u32 = [0; 8];
pub var BADO : [200]u32 = [0; 200];
pub var BADL : [200]u32 = [0; 200];
pub var TLO : [65536]u32 = [0; 65536];
pub var TLL : [65536]u32 = [0; 65536];
pub var TCT : [65536]u32 = [0; 65536];
pub var HT : [262144]u32 = [0; 262144];
pub var SIDX : [65536]u32 = [0; 65536];
pub var STMP : [65536]u32 = [0; 65536];

pub var CELLS : [4194304]u8 = [0; 4194304];
pub var GPOOL : [262144]u8 = [0; 262144];
pub var GTO : [4096]u32 = [0; 4096];
pub var GTL : [4096]u32 = [0; 4096];
pub var PFO : [4096]u32 = [0; 4096];
pub var PFL : [4096]u32 = [0; 4096];
pub var PFA : [4096]u8 = [0; 4096];
pub var SGA : [65536]i64 = [0; 65536];
pub var SGP : [65536]i64 = [0; 65536];
pub var SGK : [65536]i64 = [0; 65536];
pub var SGV : [65536]i64 = [0; 65536];
pub var SGN : [65536]i64 = [0; 65536];
pub var SGD : [65536]i64 = [0; 65536];
pub var SGE : [65536]i64 = [0; 65536];
pub var EXO : [4096]u32 = [0; 4096];
pub var EXL : [4096]u32 = [0; 4096];
pub var EXX : [4096]i64 = [0; 4096];
pub var EXY : [4096]i64 = [0; 4096];

pub var FPB : [16384]u8 = [0; 16384];
pub var FFB : [16384]u8 = [0; 16384];
pub var FNB : [16384]u8 = [0; 16384];

pub var COLT : [65536]u32 = [0; 65536];
pub var COLX : [65536]u32 = [0; 65536];
pub var COLY : [65536]u32 = [0; 65536];
pub var COLL : [65536]u32 = [0; 65536];
pub var COLF : [65536]i32 = [0; 65536];
pub var OFFT : [65536]u32 = [0; 65536];
pub var FMT : [64]u32 = [0; 64];
pub var FMF : [64]u64 = [0; 64];

// ---------------------------------------------------------------- whitespace and small helpers
pub fn ws_len_at(s: []const u8, p: usize, hi: usize) -> usize {
    if (p >= hi) { return 0; }
    const b : u8 = s[p];
    if (b == 32 or (b >= 9 and b <= 13)) { return 1; }
    if (b == 194 and p + 1 < hi and s[p + 1] == 160) { return 2; }
    if (p + 3 <= hi) {
        const b1 : u8 = s[p + 1];
        const b2 : u8 = s[p + 2];
        if (b == 225 and b1 == 154 and b2 == 128) { return 3; }
        if (b == 226 and b1 == 128 and ((b2 >= 128 and b2 <= 138) or b2 == 168 or b2 == 169 or b2 == 175)) { return 3; }
        if (b == 226 and b1 == 129 and b2 == 159) { return 3; }
        if (b == 227 and b1 == 128 and b2 == 128) { return 3; }
        if (b == 239 and b1 == 187 and b2 == 191) { return 3; }
    }
    return 0;
}

pub fn ws_len_before(s: []const u8, lo: usize, e: usize) -> usize {
    if (e > lo and ws_len_at(s, e - 1, e) == 1) { return 1; }
    if (e >= lo + 2 and ws_len_at(s, e - 2, e) == 2) { return 2; }
    if (e >= lo + 3 and ws_len_at(s, e - 3, e) == 3) { return 3; }
    return 0;
}

/// String.prototype.trim on s[lo..hi): the new start in SC[0], the new end in SC[1].
pub fn trim_range(s: []const u8, lo0: usize, hi0: usize) -> bool {
    var lo : usize = lo0;
    var hi : usize = hi0;
    var w : usize = ws_len_at(s, lo, hi);
    while (w > 0) {
        lo = lo + w;
        w = ws_len_at(s, lo, hi);
    }
    w = ws_len_before(s, lo, hi);
    while (w > 0) {
        hi = hi - w;
        w = ws_len_before(s, lo, hi);
    }
    SC[0] = lo as u64;
    SC[1] = hi as u64;
    return true;
}

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

pub fn digits_val(s: []const u8, a: usize, b: usize) -> u64 {
    var v : u64 = 0;
    var k : usize = a;
    while (k < b) {
        if (v < 100000000000000000) { v = v * 10 + ((s[k] - 48) as u64); }
        k = k + 1;
    }
    return v;
}

pub fn find_byte(s: []const u8, from: usize, hi: usize, b: u8) -> i64 {
    var p : usize = from;
    while (p < hi) {
        if (s[p] == b) { return p as i64; }
        p = p + 1;
    }
    return -1;
}

pub fn pool_put_text(s: []const u8, lo: usize, hi: usize) -> i64 {
    const at : u64 = V[V_PN];
    if (at + ((hi - lo) as u64) >= 8388608) { return -1; }
    var k : usize = lo;
    while (k < hi) {
        POOL[(at as usize) + (k - lo)] = s[k];
        k = k + 1;
    }
    V[V_PN] = at + ((hi - lo) as u64);
    return at as i64;
}

// ---------------------------------------------------------------- the FASM line rules
/// The tile name test /^([A-Z0-9_]+)_X(\d+)Y(\d+)$/ : the length of the type, the two numbers in SC[0], SC[1]; -1 when it does not match.
pub fn tile_split(s: []const u8, lo: usize, hi: usize) -> i64 {
    var k : usize = lo;
    while (k < hi) {
        const b : u8 = s[k];
        if (!((b >= 65 and b <= 90) or is_digit(b) or b == 95)) { return -1; }
        k = k + 1;
    }
    var ys : usize = hi;
    while (ys > lo and is_digit(s[ys - 1])) { ys = ys - 1; }
    if (ys == hi) { return -1; }
    if (ys == lo or s[ys - 1] != 89) { return -1; }
    const xe : usize = ys - 1;
    var xs : usize = xe;
    while (xs > lo and is_digit(s[xs - 1])) { xs = xs - 1; }
    if (xs == xe) { return -1; }
    if (xs < lo + 2) { return -1; }
    if (s[xs - 1] != 88 or s[xs - 2] != 95) { return -1; }
    const tl : usize = (xs - 2) - lo;
    if (tl < 1) { return -1; }
    SC[0] = digits_val(s, xs, xe);
    SC[1] = digits_val(s, ys, hi);
    return tl as i64;
}

/// zeroValue(v): v = s[lo..hi). Underscores are dropped, the rest trimmed; a Verilog-style constant is zero
/// when its digits are all 0, a bare number when it is all 0.
pub fn zero_value(s: []const u8, lo: usize, hi: usize) -> bool {
    var n : usize = 0;
    var k : usize = lo;
    while (k < hi) {
        if (s[k] != 95) {
            VB[n] = s[k];
            n = n + 1;
        }
        k = k + 1;
    }
    const t : []const u8 = VB[0 .. 1048576];
    trim_range(t, 0, n);
    const a : usize = SC[0] as usize;
    const b : usize = SC[1] as usize;
    // (\d+)?'([bhdo])([0-9a-f]+)$  with the i flag
    var p : usize = a;
    while (p < b and is_digit(t[p])) { p = p + 1; }
    if (p + 2 < b and t[p] == 39) {
        const base : u8 = t[p + 1] | 32;
        if (base == 98 or base == 104 or base == 100 or base == 111) {
            var q : usize = p + 2;
            var allhex : bool = true;
            var allzero : bool = true;
            while (q < b) {
                const c : u8 = t[q];
                const lc : u8 = c | 32;
                if (is_digit(c) or (lc >= 97 and lc <= 102)) {
                    if (c != 48) { allzero = false; }
                } else {
                    allhex = false;
                }
                q = q + 1;
            }
            if (allhex) { return allzero; }
        }
    }
    // /^0+$/
    if (b == a) { return false; }
    var z : usize = a;
    while (z < b) {
        if (t[z] != 48) { return false; }
        z = z + 1;
    }
    return true;
}

pub fn fnv(s: []const u8, lo: usize, hi: usize) -> u32 {
    var h : u64 = 2166136261;
    var k : usize = lo;
    while (k < hi) {
        h = (((h ^ (s[k] as u64)) * 16777619) % 4294967296);
        k = k + 1;
    }
    return h as u32;
}

pub fn pool_eq_text(o: u32, l: u32, s: []const u8, lo: usize, hi: usize) -> bool {
    if ((l as usize) != hi - lo) { return false; }
    var k : usize = 0;
    while (k < (l as usize)) {
        if (POOL[(o as usize) + k] != s[lo + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// tiles.set(name, (tiles.get(name) || 0) + 1) for a name held in LINE[lo..hi).
pub fn tile_add(lo: usize, hi: usize) -> bool {
    const t : []const u8 = LINE[0 .. 1048576];
    var idx : usize = (fnv(t, lo, hi) as usize) % 262144;
    while (HT[idx] != 0) {
        const ti : usize = (HT[idx] - 1) as usize;
        if (pool_eq_text(TLO[ti], TLL[ti], t, lo, hi)) {
            TCT[ti] = TCT[ti] + 1;
            return true;
        }
        idx = (idx + 1) % 262144;
    }
    const nt : usize = V[V_NT] as usize;
    if (nt >= 65536) { return false; }
    const at : i64 = pool_put_text(t, lo, hi);
    if (at < 0) { return false; }
    TLO[nt] = at as u32;
    TLL[nt] = (hi - lo) as u32;
    TCT[nt] = 1;
    HT[idx] = (nt + 1) as u32;
    V[V_NT] = (nt + 1) as u64;
    return true;
}

/// parseFasm. 0 ok, -1 over a limit.
pub fn parse_fasm(text: []const u8) -> i32 {
    var f : usize = 0;
    while (f < 8) {
        V[f] = 0;
        f = f + 1;
    }
    var h : usize = 0;
    while (h < 262144) {
        HT[h] = 0;
        h = h + 1;
    }
    const lt : []const u8 = LINE[0 .. 1048576];
    var start : usize = 0;
    const n : usize = text.len;
    while (start <= n) {
        var end : usize = start;
        while (end < n and text[end] != 10) { end = end + 1; }
        const ls : usize = start;
        start = end + 1;
        var le : usize = end;
        if (le - ls > 1048576) { return -1; }
        const hash : i64 = find_byte(text, ls, le, 35);
        if (hash >= 0) {
            const hp : usize = hash as usize;
            trim_range(text, hp + 1, le);
            const cl : usize = SC[0] as usize;
            const ch : usize = SC[1] as usize;
            trim_range(text, ls, hp);
            if (SC[0] == SC[1]) {
                V[V_COM] = V[V_COM] + 1;
                if (V[V_NH] < 8 and ch > cl) {
                    const at : i64 = pool_put_text(text, cl, ch);
                    if (at < 0) { return -1; }
                    HDRO[V[V_NH] as usize] = at as u32;
                    HDRL[V[V_NH] as usize] = (ch - cl) as u32;
                    V[V_NH] = V[V_NH] + 1;
                }
            }
            le = hp;
        }
        // line.replace(/\{[^}]*\}/g, '')
        var m : usize = 0;
        var i : usize = ls;
        var done : bool = false;
        while (!done) {
            const ob : i64 = find_byte(text, i, le, 123);
            if (ob < 0) {
                done = true;
            } else {
                const cb : i64 = find_byte(text, (ob as usize) + 1, le, 125);
                if (cb < 0) {
                    done = true;
                } else {
                    var k : usize = i;
                    while (k < (ob as usize)) {
                        LINE[m] = text[k];
                        m = m + 1;
                        k = k + 1;
                    }
                    i = (cb as usize) + 1;
                }
            }
        }
        var k2 : usize = i;
        while (k2 < le) {
            LINE[m] = text[k2];
            m = m + 1;
            k2 = k2 + 1;
        }
        trim_range(lt, 0, m);
        const a : usize = SC[0] as usize;
        const b : usize = SC[1] as usize;
        if (b > a) {
            const eq : i64 = find_byte(lt, a, b, 61);
            var nb : usize = b;
            if (eq >= 0) { nb = eq as usize; }
            trim_range(lt, a, nb);
            const na : usize = SC[0] as usize;
            const ne : usize = SC[1] as usize;
            var cleared : bool = false;
            if (eq >= 0) {
                cleared = zero_value(lt, (eq as usize) + 1, b);
            }
            if (cleared) {
                V[V_CLR] = V[V_CLR] + 1;
            } else {
                const dot : i64 = find_byte(lt, na, ne, 46);
                var tl : i64 = -1;
                var tend : usize = na;
                if (dot > (na as i64)) {
                    tend = dot as usize;
                    tl = tile_split(lt, na, tend);
                }
                if (tl < 0) {
                    if (V[V_NB] < 200) {
                        const at : i64 = pool_put_text(lt, a, b);
                        if (at < 0) { return -1; }
                        BADO[V[V_NB] as usize] = at as u32;
                        BADL[V[V_NB] as usize] = (b - a) as u32;
                        V[V_NB] = V[V_NB] + 1;
                    }
                } else {
                    V[V_FEAT] = V[V_FEAT] + 1;
                    if (!tile_add(na, tend)) { return -1; }
                }
            }
        }
    }
    return 0;
}

pub fn fa_info(f: u32) -> u64 {
    return V[f as usize + 1];
}

pub fn fa_header(i: u32, f: u32) -> u32 {
    if (f == 0) { return HDRO[i as usize]; }
    return HDRL[i as usize];
}

pub fn fa_bad(i: u32, f: u32) -> u32 {
    if (f == 0) { return BADO[i as usize]; }
    return BADL[i as usize];
}

pub fn fa_tile(i: u32, f: u32) -> u32 {
    if (f == 0) { return TLO[i as usize]; }
    if (f == 1) { return TLL[i as usize]; }
    return TCT[i as usize];
}

pub fn pool(i: u32) -> u8 {
    return POOL[i as usize];
}

// ---------------------------------------------------------------- the grid
pub fn grid_begin(w: u32, h: u32) -> i32 {
    V[V_GW] = w as u64;
    V[V_GH] = h as u64;
    V[V_NTY] = 0;
    V[V_NPF] = 0;
    V[V_NSEG] = 0;
    V[V_NEX] = 0;
    V[V_GP] = 0;
    if ((w as u64) * (h as u64) > 4194304) { return -1; }
    return 0;
}

pub fn gpool_put(s: []const u8, lo: usize, hi: usize) -> i64 {
    const at : u64 = V[V_GP];
    if (at + ((hi - lo) as u64) >= 262144) { return -1; }
    var k : usize = lo;
    while (k < hi) {
        GPOOL[(at as usize) + (k - lo)] = s[k];
        k = k + 1;
    }
    V[V_GP] = at + ((hi - lo) as u64);
    return at as i64;
}

pub fn grid_types(list: []const u8) -> i32 {
    var a : usize = 0;
    while (a < list.len) {
        var e : usize = a;
        while (e < list.len and list[e] != 10) { e = e + 1; }
        const at : i64 = gpool_put(list, a, e);
        const n : usize = V[V_NTY] as usize;
        if (at < 0 or n >= 4096) { return -1; }
        GTO[n] = at as u32;
        GTL[n] = (e - a) as u32;
        V[V_NTY] = (n + 1) as u64;
        a = e + 1;
    }
    return 0;
}

pub fn grid_rle(rle: []const u32) -> i32 {
    const total : u64 = V[V_GW] * V[V_GH];
    var i : u64 = 0;
    var r : usize = 0;
    while (r + 1 < rle.len) {
        const v : u8 = (rle[r] % 256) as u8;
        const c : u64 = rle[r + 1] as u64;
        var k : u64 = 0;
        while (k < c and i + k < total) {
            CELLS[(i + k) as usize] = v;
            k = k + 1;
        }
        i = i + c;
        r = r + 2;
    }
    if (rle.len % 2 == 1) { return 1; }
    if (i != total) { return 1; }
    return 0;
}

pub fn grid_prefixes(axis: u32, list: []const u8) -> i32 {
    var a : usize = 0;
    while (a < list.len) {
        var e : usize = a;
        while (e < list.len and list[e] != 10) { e = e + 1; }
        const at : i64 = gpool_put(list, a, e);
        const n : usize = V[V_NPF] as usize;
        if (at < 0 or n >= 4096) { return -1; }
        PFO[n] = at as u32;
        PFL[n] = (e - a) as u32;
        PFA[n] = axis as u8;
        V[V_NPF] = (n + 1) as u64;
        a = e + 1;
    }
    return 0;
}

pub fn grid_segs(recs: []const i32) -> i32 {
    var r : usize = 0;
    while (r + 7 <= recs.len) {
        const n : usize = V[V_NSEG] as usize;
        if (n >= 65536) { return -1; }
        SGA[n] = recs[r] as i64;
        SGP[n] = recs[r + 1] as i64;
        SGK[n] = recs[r + 2] as i64;
        SGV[n] = recs[r + 3] as i64;
        SGN[n] = recs[r + 4] as i64;
        SGD[n] = recs[r + 5] as i64;
        SGE[n] = recs[r + 6] as i64;
        V[V_NSEG] = (n + 1) as u64;
        r = r + 7;
    }
    return 0;
}

pub fn grid_except(names: []const u8, xy: []const i32) -> i32 {
    var a : usize = 0;
    var i : usize = 0;
    while (a < names.len) {
        var e : usize = a;
        while (e < names.len and names[e] != 10) { e = e + 1; }
        const at : i64 = gpool_put(names, a, e);
        const n : usize = V[V_NEX] as usize;
        if (at < 0 or n >= 4096 or 2 * i + 1 >= xy.len) { return -1; }
        EXO[n] = at as u32;
        EXL[n] = (e - a) as u32;
        EXX[n] = xy[2 * i] as i64;
        EXY[n] = xy[2 * i + 1] as i64;
        V[V_NEX] = (n + 1) as u64;
        i = i + 1;
        a = e + 1;
    }
    return 0;
}

pub fn gp_eq(o: u32, l: u32, s: []const u8, lo: usize, hi: usize) -> bool {
    if ((l as usize) != hi - lo) { return false; }
    var k : usize = 0;
    while (k < (l as usize)) {
        if (GPOOL[(o as usize) + k] != s[lo + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// expand(segs).get(k): true with the value in SV[0] (the last segment and step that set key k), false when none did (JS undefined).
pub fn seg_value(pf: i64, k: i64) -> bool {
    var found : bool = false;
    var s : usize = 0;
    while (s < (V[V_NSEG] as usize)) {
        if (SGP[s] == pf and SGN[s] > 0) {
            const d : i64 = k - SGK[s];
            var i : i64 = -1;
            if (SGD[s] == 0) {
                if (d == 0) { i = SGN[s] - 1; }
            } else {
                if (d % SGD[s] == 0) {
                    const q : i64 = d / SGD[s];
                    if (q >= 0 and q < SGN[s]) { i = q; }
                }
            }
            if (i >= 0) {
                SV[0] = SGV[s] + i * SGE[s];
                found = true;
            }
        }
        s = s + 1;
    }
    return found;
}

pub fn grid_at(gx: i64, gy: i64) -> i32 {
    const idx : i64 = gx * (V[V_GH] as i64) + gy;
    if (idx < 0 or idx >= (V[V_GW] as i64) * (V[V_GH] as i64)) { return -1; }
    return CELLS[idx as usize] as i32;
}

/// grid.lookup(name) for name = s[lo..hi): true with LK = gx, gy, type length, type index; false for null.
pub fn grid_lookup(s: []const u8, lo: usize, hi: usize) -> bool {
    var gx : i64 = 0;
    var gy : i64 = 0;
    var tl : usize = hi - lo;
    var ex : i64 = -1;
    var e : usize = 0;
    while (e < (V[V_NEX] as usize) and ex < 0) {
        if (gp_eq(EXO[e], EXL[e], s, lo, hi)) { ex = e as i64; }
        e = e + 1;
    }
    if (ex >= 0) {
        gx = EXX[ex as usize];
        gy = EXY[ex as usize];
        const t0 : i64 = tile_split(s, lo, hi);
        if (t0 >= 0) { tl = t0 as usize; }
    } else {
        const t1 : i64 = tile_split(s, lo, hi);
        if (t1 < 0) { return false; }
        tl = t1 as usize;
        const x : i64 = SC[0] as i64;
        const y : i64 = SC[1] as i64;
        var px : i64 = -1;
        var py : i64 = -1;
        var p : usize = 0;
        while (p < (V[V_NPF] as usize)) {
            if (gp_eq(PFO[p], PFL[p], s, lo, lo + tl)) {
                if (PFA[p] == 0) { px = p as i64; }
                if (PFA[p] == 1) { py = p as i64; }
            }
            p = p + 1;
        }
        if (px < 0 or py < 0) { return false; }
        if (!seg_value(px, x)) { return false; }
        gx = SV[0];
        if (!seg_value(py, y)) { return false; }
        gy = SV[0];
    }
    var t : i64 = -1;
    var k : usize = V[V_NTY] as usize;
    while (k > 0 and t < 0) {
        k = k - 1;
        if (gp_eq(GTO[k], GTL[k], s, lo, lo + tl)) { t = k as i64; }
    }
    if (t < 0) { return false; }
    if ((grid_at(gx, gy) as i64) != t) { return false; }
    LK[0] = gx;
    LK[1] = gy;
    LK[2] = tl as i64;
    LK[3] = t;
    return true;
}

pub fn lk(f: u32) -> i64 {
    return LK[f as usize];
}

// ---------------------------------------------------------------- families and the summary
pub fn fam_set(prefixes: []const u8, families: []const u8, names: []const u8) -> i32 {
    if (prefixes.len > 16384 or families.len > 16384 or names.len > 16384) { return -1; }
    var k : usize = 0;
    while (k < prefixes.len) {
        FPB[k] = prefixes[k];
        k = k + 1;
    }
    k = 0;
    while (k < families.len) {
        FFB[k] = families[k];
        k = k + 1;
    }
    k = 0;
    while (k < names.len) {
        FNB[k] = names[k];
        k = k + 1;
    }
    V[V_FPL] = prefixes.len as u64;
    V[V_FFL] = families.len as u64;
    V[V_FNL] = names.len as u64;
    return 0;
}

/// The packed [start, end) of the i-th item (each ended by byte 10) of a list, or -1.
pub fn item_of(buf: []const u8, used: usize, i: usize) -> i64 {
    var a : usize = 0;
    var n : usize = 0;
    while (a < used) {
        var e : usize = a;
        while (e < used and buf[e] != 10) { e = e + 1; }
        if (n == i) { return (a as i64) * 4294967296 + (e as i64); }
        n = n + 1;
        a = e + 1;
    }
    return -1;
}

pub fn count_items(buf: []const u8, used: usize) -> usize {
    var a : usize = 0;
    var n : usize = 0;
    while (a < used) {
        var e : usize = a;
        while (e < used and buf[e] != 10) { e = e + 1; }
        n = n + 1;
        a = e + 1;
    }
    return n;
}

/// famNames.indexOf(item) where item is s[lo..hi) of the families list; -1 when absent.
pub fn index_of_name(s: []const u8, lo: usize, hi: usize) -> i32 {
    const names : []const u8 = FNB[0 .. 16384];
    const used : usize = V[V_FNL] as usize;
    var a : usize = 0;
    var n : i32 = 0;
    while (a < used) {
        var e : usize = a;
        while (e < used and names[e] != 10) { e = e + 1; }
        if (e - a == hi - lo) {
            var same : bool = true;
            var k : usize = 0;
            while (k < e - a) {
                if (names[a + k] != s[lo + k]) { same = false; }
                k = k + 1;
            }
            if (same) { return n; }
        }
        n = n + 1;
        a = e + 1;
    }
    return -1;
}

/// familyOf(type, prefixes, families, famNames) with the three lists set by fam_set.
pub fn family_of_range(s: []const u8, lo: usize, hi: usize) -> i32 {
    const pf : []const u8 = FPB[0 .. 16384];
    const fm : []const u8 = FFB[0 .. 16384];
    const np : usize = count_items(pf, V[V_FPL] as usize);
    var i : usize = 0;
    while (i < np) {
        const it : i64 = item_of(pf, V[V_FPL] as usize, i);
        const a : usize = (it / 4294967296) as usize;
        const e : usize = (it % 4294967296) as usize;
        if (hi - lo >= e - a) {
            var same : bool = true;
            var k : usize = 0;
            while (k < e - a) {
                if (s[lo + k] != pf[a + k]) { same = false; }
                k = k + 1;
            }
            if (same) {
                const fi : i64 = item_of(fm, V[V_FFL] as usize, i);
                if (fi < 0) { return -1; }
                return index_of_name(fm, (fi / 4294967296) as usize, (fi % 4294967296) as usize);
            }
        }
        i = i + 1;
    }
    return (count_items(FNB[0 .. 16384], V[V_FNL] as usize) as i32) - 1;
}

pub fn family_of(t: []const u8) -> i32 {
    return family_of_range(t, 0, t.len);
}

pub fn name_less(a: u32, b: u32) -> bool {
    const la : usize = TLL[a as usize] as usize;
    const lb : usize = TLL[b as usize] as usize;
    var k : usize = 0;
    while (k < la and k < lb) {
        const x : u8 = POOL[(TLO[a as usize] as usize) + k];
        const y : u8 = POOL[(TLO[b as usize] as usize) + k];
        if (x != y) { return x < y; }
        k = k + 1;
    }
    return la < lb;
}

/// Sort SIDX[0..n) by tile name (default JS sort of ASCII strings), bottom-up merge sort.
pub fn sort_names(n: usize) -> bool {
    var i : usize = 0;
    while (i < n) {
        SIDX[i] = i as u32;
        i = i + 1;
    }
    var w : usize = 1;
    while (w < n) {
        var lo : usize = 0;
        while (lo < n) {
            var mid : usize = lo + w;
            if (mid > n) { mid = n; }
            var hi : usize = lo + 2 * w;
            if (hi > n) { hi = n; }
            var a : usize = lo;
            var b : usize = mid;
            var o : usize = lo;
            while (a < mid or b < hi) {
                if (b >= hi or (a < mid and !name_less(SIDX[b], SIDX[a]))) {
                    STMP[o] = SIDX[a];
                    a = a + 1;
                } else {
                    STMP[o] = SIDX[b];
                    b = b + 1;
                }
                o = o + 1;
            }
            lo = lo + 2 * w;
        }
        var c : usize = 0;
        while (c < n) {
            SIDX[c] = STMP[c];
            c = c + 1;
        }
        w = w * 2;
    }
    return true;
}

/// summarize(parsed, grid, famOfType, nFam). Needs parse_fasm, the grid calls and fam_set done.
pub fn summarize() -> i32 {
    const nt : usize = V[V_NT] as usize;
    sort_names(nt);
    const nfam : usize = count_items(FNB[0 .. 16384], V[V_FNL] as usize);
    var f : usize = 0;
    while (f < 64) {
        FMT[f] = 0;
        FMF[f] = 0;
        f = f + 1;
    }
    var ncol : usize = 0;
    var noff : usize = 0;
    var placed : u64 = 0;
    var tallest : i64 = -1;
    var tn : u64 = 0;
    var i : usize = 0;
    const pl : []const u8 = POOL[0 .. 8388608];
    while (i < nt) {
        const t : usize = SIDX[i] as usize;
        const o : usize = TLO[t] as usize;
        const l : usize = TLL[t] as usize;
        const n : u64 = TCT[t] as u64;
        if (!grid_lookup(pl, o, o + l)) {
            OFFT[noff] = t as u32;
            noff = noff + 1;
        } else {
            const tl : usize = LK[2] as usize;
            const fam : i32 = family_of_range(pl, o, o + tl);
            COLT[ncol] = t as u32;
            COLX[ncol] = LK[0] as u32;
            COLY[ncol] = LK[1] as u32;
            COLL[ncol] = tl as u32;
            COLF[ncol] = fam;
            if (fam >= 0 and (fam as usize) < nfam and fam < 64) {
                FMT[fam as usize] = FMT[fam as usize] + 1;
                FMF[fam as usize] = FMF[fam as usize] + n;
            }
            placed = placed + n;
            if (tallest < 0 or n > tn) {
                tallest = ncol as i64;
                tn = n;
            }
            ncol = ncol + 1;
        }
        i = i + 1;
    }
    V[V_SM0] = ncol as u64;
    V[V_SM0 + 1] = noff as u64;
    V[V_SM0 + 2] = V[V_FEAT];
    V[V_SM0 + 3] = placed;
    V[V_SM0 + 4] = ncol as u64;
    V[V_SM0 + 5] = (tallest + 1) as u64;
    return 0;
}

pub fn sm_info(f: u32) -> i64 {
    if (f == 5) { return (V[V_SM0 + 5] as i64) - 1; }
    return V[V_SM0 + (f as usize)] as i64;
}

pub fn sm_col(i: u32, f: u32) -> i64 {
    const c : usize = i as usize;
    if (f == 0) { return COLT[c] as i64; }
    if (f == 1) { return COLX[c] as i64; }
    if (f == 2) { return COLY[c] as i64; }
    if (f == 3) { return COLL[c] as i64; }
    if (f == 4) { return COLF[c] as i64; }
    return TCT[COLT[c] as usize] as i64;
}

pub fn sm_off(i: u32, f: u32) -> i64 {
    if (f == 0) { return OFFT[i as usize] as i64; }
    return TCT[OFFT[i as usize] as usize] as i64;
}

pub fn sm_fam(k: u32, f: u32) -> u64 {
    if (f == 0) { return FMT[k as usize] as u64; }
    return FMF[k as usize];
}

// ---------------------------------------------------------------- tests
pub var TXT : [8192]u8 = [0; 8192];
pub var TXN : usize = 0;
pub var LA : [256]u8 = [0; 256];
pub var LB : [256]u8 = [0; 256];
pub var LC : [256]u8 = [0; 256];
pub var LAN : usize = 0;
pub var LBN : usize = 0;
pub var LCN : usize = 0;
pub var RLE : [16]u32 = [0; 16];
pub var SEG : [28]i32 = [0; 28];

pub fn tx_reset() -> usize {
    TXN = 0;
    return 0;
}

pub fn tx_line(s: []const u8) -> usize {
    var k : usize = 0;
    while (k < s.len) {
        TXT[TXN] = s[k];
        TXN = TXN + 1;
        k = k + 1;
    }
    TXT[TXN] = 10;
    TXN = TXN + 1;
    return TXN;
}

/// Lists, one item per byte-10 end, built from up to four items (an empty item is skipped).
pub fn la_make(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> usize {
    LAN = 0;
    var w : u32 = 0;
    while (w < 4) {
        var s : []const u8 = a;
        if (w == 1) { s = b; }
        if (w == 2) { s = c; }
        if (w == 3) { s = d; }
        if (s.len > 0) {
            var k : usize = 0;
            while (k < s.len) {
                LA[LAN] = s[k];
                LAN = LAN + 1;
                k = k + 1;
            }
            LA[LAN] = 10;
            LAN = LAN + 1;
        }
        w = w + 1;
    }
    return LAN;
}

pub fn lb_make(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> usize {
    LBN = 0;
    var w : u32 = 0;
    while (w < 4) {
        var s : []const u8 = a;
        if (w == 1) { s = b; }
        if (w == 2) { s = c; }
        if (w == 3) { s = d; }
        if (s.len > 0) {
            var k : usize = 0;
            while (k < s.len) {
                LB[LBN] = s[k];
                LBN = LBN + 1;
                k = k + 1;
            }
            LB[LBN] = 10;
            LBN = LBN + 1;
        }
        w = w + 1;
    }
    return LBN;
}

pub fn lc_make(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> usize {
    LCN = 0;
    var w : u32 = 0;
    while (w < 4) {
        var s : []const u8 = a;
        if (w == 1) { s = b; }
        if (w == 2) { s = c; }
        if (w == 3) { s = d; }
        if (s.len > 0) {
            var k : usize = 0;
            while (k < s.len) {
                LC[LCN] = s[k];
                LCN = LCN + 1;
                k = k + 1;
            }
            LC[LCN] = 10;
            LCN = LCN + 1;
        }
        w = w + 1;
    }
    return LCN;
}

pub fn pool_is(o: u32, l: u32, w: []const u8) -> bool {
    if ((l as usize) != w.len) { return false; }
    return pool_eq_text(o, l, w, 0, w.len);
}

pub fn seg_set(i: usize, ax: i32, pf: i32, k0: i32, v0: i32, n: i32, dk: i32, dv: i32) -> usize {
    SEG[i * 7] = ax;
    SEG[i * 7 + 1] = pf;
    SEG[i * 7 + 2] = k0;
    SEG[i * 7 + 3] = v0;
    SEG[i * 7 + 4] = n;
    SEG[i * 7 + 5] = dk;
    SEG[i * 7 + 6] = dv;
    return i;
}

/// A small die: 3 columns of 2 cells, w = 3, h = 2. Types 0 CLBLL_L, 1 INT_L, 2 BRAM_L. Cells (index gx*2+gy):
/// 0 is CLBLL_L, 1 to 3 are INT_L, 4 and 5 are BRAM_L. X numbers: CLBLL_L 7 -> gx 0; INT_L 5, 6 -> gx 1, 0;
/// BRAM_L 10 -> gx 2. Y numbers for every type: 20, 21 -> gy 0, 1.
pub fn small_die() -> i32 {
    grid_begin(3, 2);
    var n : usize = la_make("CLBLL_L", "INT_L", "BRAM_L", "");
    grid_types(LA[0 .. n]);
    RLE[0] = 0;
    RLE[1] = 1;
    RLE[2] = 1;
    RLE[3] = 3;
    RLE[4] = 2;
    RLE[5] = 2;
    const r : i32 = grid_rle(RLE[0 .. 6]);
    grid_prefixes(0, LA[0 .. n]);
    grid_prefixes(1, LA[0 .. n]);
    seg_set(0, 0, 0, 7, 0, 1, 1, 0);
    seg_set(1, 0, 1, 5, 1, 2, 1, -1);
    seg_set(2, 0, 2, 10, 2, 1, 1, 0);
    grid_segs(SEG[0 .. 21]);
    seg_set(0, 1, 3, 20, 0, 2, 1, 1);
    seg_set(1, 1, 4, 20, 0, 2, 1, 1);
    seg_set(2, 1, 5, 20, 0, 2, 1, 1);
    grid_segs(SEG[0 .. 21]);
    return r;
}

test a_fasm_text_is_counted_by_tile {
    tx_reset();
    tx_line("# nextpnr-xilinx 0.9.2-107-g7037c948");
    tx_line("#  chipdb xc7a200tfbg484-2 version 1 generator prjxray  ");
    tx_line("CLBLL_L_X2Y10.SLICEL_X0.ALUT.INIT[63:0] = 64'hFFFF0000FFFF0000");
    tx_line("CLBLL_L_X2Y10.SLICEL_X0.CLUT.INIT[63:0] = 64'h0000_0000_0000_0000");
    tx_line("CLBLL_L_X2Y10.SLICEL_X0.FFSYNC");
    tx_line("INT_L_X5Y20.IMUX_L12.LOGIC_OUTS_L3  # a comment after");
    tx_line("INT_L_X5Y20.EE2BEG0.SS2END0 {annotation} ");
    tx_line("  BRAM_L_X10Y20.BRAM_L.RAMB18_Y0.WRITE_WIDTH_A_18 = 1'b1");
    tx_line("BRAM_L_X10Y20.BRAM_L.INIT = 0");
    tx_line("garbage line without a tile");
    tx_line("lowercase_X1Y2.FOO");
    tx_line("");
    tx_line("   ");
    const t : []const u8 = TXT[0 .. TXN];
    assert parse_fasm(t) == 0;
    assert fa_info(0) == 5;
    assert fa_info(1) == 2;
    assert fa_info(2) == 2;
    assert fa_info(3) == 2;
    assert fa_info(4) == 3;
    assert fa_info(5) == 2;
    assert pool_is(fa_header(0, 0), fa_header(0, 1), "nextpnr-xilinx 0.9.2-107-g7037c948");
    assert pool_is(fa_header(1, 0), fa_header(1, 1), "chipdb xc7a200tfbg484-2 version 1 generator prjxray");
    assert pool_is(fa_tile(0, 0), fa_tile(0, 1), "CLBLL_L_X2Y10");
    assert fa_tile(0, 2) == 2;
    assert pool_is(fa_tile(1, 0), fa_tile(1, 1), "INT_L_X5Y20");
    assert fa_tile(1, 2) == 2;
    assert fa_tile(2, 2) == 1;
    assert pool_is(fa_bad(0, 0), fa_bad(0, 1), "garbage line without a tile");
    assert pool_is(fa_bad(1, 0), fa_bad(1, 1), "lowercase_X1Y2.FOO");
}

test zero_values_clear_a_feature_and_other_values_set_it {
    tx_reset();
    tx_line("T_X1Y1.A = 0");
    tx_line("T_X1Y1.B = 00");
    tx_line("T_X1Y1.C = 8'h00");
    tx_line("T_X1Y1.D = 64'b0000_0000");
    tx_line("T_X1Y1.E = 1");
    tx_line("T_X1Y1.F = 8'h01");
    tx_line("T_X1Y1.G = 'hf");
    tx_line("T_X1Y1.H = 8'x0");
    tx_line("T_X1Y1.I = 0'b");
    tx_line("T_X1Y1.J = ");
    tx_line("T_X1Y1.K = 12'D00A");
    tx_line("T_X1Y1.L = _0_");
    assert parse_fasm(TXT[0 .. TXN]) == 0;
    assert fa_info(2) == 5;
    assert fa_info(0) == 7;
    assert fa_tile(0, 2) == 7;
}

test annotations_and_hashes_follow_the_javascript_order {
    tx_reset();
    tx_line("T_X1Y1.A {x # y}");
    tx_line("{note} T_X1Y1.B");
    tx_line("T_X1Y1.C {unclosed");
    tx_line("T_X1Y1.D {a} = {b} 0");
    tx_line("T_X1Y1.{q}E");
    tx_line("T_X1Y1 .F");
    tx_line("T_X1Y1.G = 1 # keep");
    tx_line(".H = 1");
    tx_line("T_X1Y1");
    tx_line("T_X1Y1 = 1");
    assert parse_fasm(TXT[0 .. TXN]) == 0;
    assert fa_info(1) == 0;
    assert fa_info(0) == 5;
    assert fa_info(2) == 1;
    assert fa_info(5) == 4;
    assert fa_tile(0, 2) == 5;
}

test the_tile_name_is_split_into_type_and_numbers {
    assert tile_split("CLBLL_L_X2Y10", 0, 13) == 7;
    assert SC[0] == 2;
    assert SC[1] == 10;
    assert tile_split("A_X1Y2_X3Y4", 0, 11) == 6;
    assert SC[0] == 3;
    assert SC[1] == 4;
    assert tile_split("A_X007Y0", 0, 8) == 1;
    assert SC[0] == 7;
    assert tile_split("_X1Y2", 0, 5) == -1;
    assert tile_split("A_X1Y", 0, 5) == -1;
    assert tile_split("A_X1Y2Y3", 0, 8) == -1;
    assert tile_split("a_X1Y2", 0, 6) == -1;
    assert tile_split("A_X1Y2 ", 0, 7) == -1;
    assert tile_split("AX1Y2", 0, 5) == -1;
}

test the_grid_finds_a_tile_only_when_the_cell_holds_that_type {
    assert small_die() == 0;
    assert grid_lookup("CLBLL_L_X7Y20", 0, 13);
    assert lk(0) == 0;
    assert lk(1) == 0;
    assert lk(2) == 7;
    assert lk(3) == 0;
    assert grid_lookup("INT_L_X5Y21", 0, 11);
    assert lk(0) == 1;
    assert lk(1) == 1;
    assert grid_lookup("INT_L_X6Y21", 0, 11);
    assert lk(0) == 0;
    assert lk(1) == 1;
    assert lk(3) == 1;
    assert grid_lookup("BRAM_L_X10Y21", 0, 13);
    assert lk(0) == 2;
    assert lk(1) == 1;
    assert grid_lookup("INT_L_X6Y20", 0, 11) == false;
    assert grid_lookup("CLBLL_L_X7Y21", 0, 13) == false;
    assert grid_lookup("INT_L_X9Y20", 0, 11) == false;
    assert grid_lookup("NOPE_X1Y1", 0, 9) == false;
    assert grid_lookup("not a tile", 0, 10) == false;
    assert grid_at(2, 1) == 2;
    assert grid_at(3, 0) == -1;
    assert grid_at(0, 2) == 1;
    assert grid_at(-1, 0) == -1;
}

test the_runs_must_cover_every_cell {
    grid_begin(3, 2);
    RLE[0] = 0;
    RLE[1] = 5;
    assert grid_rle(RLE[0 .. 2]) == 1;
    RLE[1] = 7;
    assert grid_rle(RLE[0 .. 2]) == 1;
    RLE[1] = 6;
    assert grid_rle(RLE[0 .. 2]) == 0;
    RLE[2] = 9;
    assert grid_rle(RLE[0 .. 3]) == 1;
}

test a_summary_totals_the_placed_tiles_by_family {
    assert small_die() == 0;
    var a : usize = la_make("CLB", "INT", "BRAM", "");
    var b : usize = lb_make("logic", "routing", "memory", "");
    var c : usize = lc_make("logic", "routing", "memory", "other");
    assert fam_set(LA[0 .. a], LB[0 .. b], LC[0 .. c]) == 0;
    assert family_of("CLBLL_L") == 0;
    assert family_of("INT_L") == 1;
    assert family_of("BRAM_L") == 2;
    assert family_of("DSP_L") == 3;
    a = la_make("INT", "XYZ", "", "");
    b = lb_make("routing", "missing", "", "");
    c = lc_make("logic", "routing", "", "");
    assert fam_set(LA[0 .. a], LB[0 .. b], LC[0 .. c]) == 0;
    assert family_of("INT_R") == 1;
    assert family_of("XYZ1") == -1;
    assert family_of("QQ") == 1;
    a = la_make("CLB", "INT", "BRAM", "");
    b = lb_make("logic", "routing", "memory", "");
    c = lc_make("logic", "routing", "memory", "other");
    assert fam_set(LA[0 .. a], LB[0 .. b], LC[0 .. c]) == 0;
    tx_reset();
    tx_line("INT_L_X5Y20.A");
    tx_line("INT_L_X5Y20.B");
    tx_line("CLBLL_L_X7Y20.A");
    tx_line("BRAM_L_X10Y21.A");
    tx_line("BRAM_L_X10Y21.B");
    tx_line("BRAM_L_X10Y21.C");
    tx_line("INT_L_X6Y20.A");
    tx_line("INT_L_X6Y20.B");
    tx_line("INT_L_X6Y20.C");
    tx_line("DSP_L_X1Y1.A");
    tx_line("CLBLL_L_X7Y21.A");
    assert parse_fasm(TXT[0 .. TXN]) == 0;
    assert summarize() == 0;
    assert sm_info(0) == 3;
    assert sm_info(1) == 3;
    assert sm_info(2) == 11;
    assert sm_info(3) == 6;
    assert sm_fam(0, 0) == 1;
    assert sm_fam(1, 0) == 1;
    assert sm_fam(2, 0) == 1;
    assert sm_fam(0, 1) == 1;
    assert sm_fam(1, 1) == 2;
    assert sm_fam(2, 1) == 3;
    assert sm_info(5) >= 0;
    assert sm_col(sm_info(5) as u32, 5) == 3;
    assert sm_col(sm_info(5) as u32, 4) == 2;
}
