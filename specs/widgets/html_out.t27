// SPDX-License-Identifier: Apache-2.0
; specs/widgets/html_out.t27 -- the HTML writer every native widget view uses. Epic gHashTag/t27#10937,
; stage "page" of specs/t27f/widget_factory.t27. A tool.js builds its page with el()/h() helpers and
; DOM calls (28 files, 8920 lines); a native view writes HTML text into one module-level buffer and the
; host sets it as innerHTML. This file is that writer, once: reset, put a byte, put text (raw or
; HTML-escaped), put a number, open/close a tag, put an attribute. No allocation: the buffer is fixed
; at OUT_CAP and a write past the end sets OVERFLOW and drops the byte, so a view can never write
; outside it. The host reads out_len() bytes starting at out_at(0..).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_html_out;

pub const OUT_CAP : u32 = 65536;
pub var OUT : [65536]u8 = [0; 65536];
pub var OUT_LEN : u32 = 0;
pub var OVERFLOW : u32 = 0;

pub const B_LT : u8 = 60;
pub const B_GT : u8 = 62;
pub const B_AMP : u8 = 38;
pub const B_QUOTE : u8 = 34;
pub const B_APOS : u8 = 39;
pub const B_SPACE : u8 = 32;
pub const B_SLASH : u8 = 47;
pub const B_EQ : u8 = 61;

pub fn out_reset() -> u32 {
    OUT_LEN = 0;
    OVERFLOW = 0;
    return 0;
}

pub fn out_len() -> u32 {
    return OUT_LEN;
}

pub fn out_at(i: u32) -> u8 {
    return OUT[i as usize];
}

pub fn out_overflowed() -> bool {
    return OVERFLOW != 0;
}

pub fn put(b: u8) -> u32 {
    if (OUT_LEN >= OUT_CAP) {
        OVERFLOW = 1;
        return OUT_LEN;
    }
    OUT[OUT_LEN as usize] = b;
    OUT_LEN = OUT_LEN + 1;
    return OUT_LEN;
}

/// Raw bytes, as the caller wrote them (markup the view itself owns).
pub fn raw(s: []const u8) -> u32 {
    var i : usize = 0;
    while (i < s.len) {
        put(s[i]);
        i = i + 1;
    }
    return OUT_LEN;
}

/// Text from outside the view (data, words): & < > " ' are written as entities.
pub fn text(s: []const u8) -> u32 {
    var i : usize = 0;
    while (i < s.len) {
        const b : u8 = s[i];
        if (b == B_AMP) {
            raw("&amp;");
        } else {
            if (b == B_LT) {
                raw("&lt;");
            } else {
                if (b == B_GT) {
                    raw("&gt;");
                } else {
                    if (b == B_QUOTE) {
                        raw("&quot;");
                    } else {
                        if (b == B_APOS) {
                            raw("&#39;");
                        } else {
                            put(b);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return OUT_LEN;
}

/// An unsigned decimal.
pub fn num(n: u64) -> u32 {
    if (n == 0) {
        return put(48);
    }
    var digits : [20]u8 = [0; 20];
    var k : usize = 0;
    var v : u64 = n;
    while (v > 0) {
        digits[k] = ((v % 10) as u8) + 48;
        v = v / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        put(digits[k]);
    }
    return OUT_LEN;
}

/// An unsigned decimal with thousands separated by commas, as toLocaleString('en-US') writes it.
pub fn num_grouped(n: u64) -> u32 {
    var digits : [20]u8 = [0; 20];
    var k : usize = 0;
    var v : u64 = n;
    if (v == 0) {
        return put(48);
    }
    while (v > 0) {
        digits[k] = ((v % 10) as u8) + 48;
        v = v / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        put(digits[k]);
        if (k > 0 and k % 3 == 0) {
            put(44);
        }
    }
    return OUT_LEN;
}

/// <tag with no attributes yet; close it with open_end().
pub fn open(tag: []const u8) -> u32 {
    put(B_LT);
    return raw(tag);
}

pub fn open_end() -> u32 {
    return put(B_GT);
}

/// name="value" with the value escaped, preceded by a space.
pub fn attr(name: []const u8, value: []const u8) -> u32 {
    put(B_SPACE);
    raw(name);
    put(B_EQ);
    put(B_QUOTE);
    text(value);
    return put(B_QUOTE);
}

pub fn close(tag: []const u8) -> u32 {
    put(B_LT);
    put(B_SLASH);
    raw(tag);
    return put(B_GT);
}

/// {0} {1} ... filled from up to three values, as fmt() does in the tool.js files. A placeholder with
/// no value writes nothing. The template is the view's own words, written raw; each value is escaped.
pub fn fill3(t: []const u8, a: []const u8, b: []const u8, c: []const u8) -> u32 {
    var i : usize = 0;
    while (i < t.len) {
        if (t[i] == 123 and i + 2 < t.len and t[i + 2] == 125 and t[i + 1] >= 48 and t[i + 1] <= 50) {
            if (t[i + 1] == 48) { text(a); }
            if (t[i + 1] == 49) { text(b); }
            if (t[i + 1] == 50) { text(c); }
            i = i + 3;
        } else {
            put(t[i]);
            i = i + 1;
        }
    }
    return OUT_LEN;
}

pub fn same_bytes(a: u32, b: []const u8) -> bool {
    var i : usize = 0;
    if (OUT_LEN != (b.len as u32) + a) { return false; }
    while (i < b.len) {
        if (OUT[(a as usize) + i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_writer_escapes_text_and_leaves_markup_alone {
    assert out_reset() == 0;
    open("p");
    attr("title", "a \"b\" & c");
    open_end();
    text("x < y & 'z'");
    close("p");
    assert same_bytes(0, "<p title=\"a &quot;b&quot; &amp; c\">x &lt; y &amp; &#39;z&#39;</p>");
    assert out_overflowed() == false;
}

test numbers_are_decimal_and_grouped_like_en_us {
    out_reset();
    num(0);
    put(32);
    num(1234567);
    put(32);
    num_grouped(0);
    put(32);
    num_grouped(999);
    put(32);
    num_grouped(1000);
    put(32);
    num_grouped(215360);
    put(32);
    num_grouped(1234567890);
    assert same_bytes(0, "0 1234567 0 999 1,000 215,360 1,234,567,890");
}

test fill_puts_values_in_the_template_and_escapes_them {
    out_reset();
    fill3("{0} of {1}, {2}{3}", "Gatle", "<6>", "end");
    assert same_bytes(0, "Gatle of &lt;6&gt;, end{3}");
}

test the_buffer_never_writes_past_its_end {
    out_reset();
    var i : u32 = 0;
    while (i < OUT_CAP + 10) {
        put(65);
        i = i + 1;
    }
    assert out_len() == OUT_CAP;
    assert out_overflowed();
    assert out_at(OUT_CAP - 1) == 65;
    out_reset();
    assert out_len() == 0;
    assert out_overflowed() == false;
}
