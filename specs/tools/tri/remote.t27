// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/remote.t27 -- tool tri/remote, the `tri remote` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/remote).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the Remote variant and its /// doc were read in cli/tri/src/main.rs with gHashTag/t27#11020).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_remote;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/remote";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/remote";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri remote";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Remote";
pub const SOURCE : str = "cli/tri/src/main.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "An analog reference job on a remote Docker host over SSH (host: TRI_REMOTE_HOST): ping | run <deck> [--golden] [--threads N] | status <id> | logs <id> | stop <id> | fetch <id> <file> [--to dir]; --print shows the command lines and sends nothing (rules: specs/tri/remote/remote_job.t27, #11020).";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Remote (cli/tri/src/main.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [0]str = [];
pub const ACTIONS_ABOUT : [0]str = [];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [7]str = ["<action>: ping, run, status, logs, stop or fetch (the words of specs/tri/remote/remote_job.t27; any other word is refused).", "<name>: a deck file on this machine (run) or the id of a job (status, logs, stop, fetch); a name has letters, digits and _-. only.", "<file>: fetch: a result file of the job, for example ngspice.log.", "--to: fetch: the local directory the file is copied into (default .).", "--golden: run: the container fetches the golden deck from TRI_REMOTE_DECK_URL and applies the recipe, so <name> only names the job and no deck is staged.", "--threads: run --golden: ngspice's thread count, 1 to 16 (default 8).", "--print: Print each command line and send nothing."];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [1]str = ["T"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). The card states what the tool is for (long analog reference runs off the bench Mac) but no source binds a bee to it, so no domain lead is named.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Run a long analog reference job (35 to 65 minutes for the golden SAR deck) on a Linux host with Docker instead of the bench Mac: start it, watch it, fetch its files. The host comes from TRI_REMOTE_HOST and is never written in the repository; the image from TRI_REMOTE_IMAGE (default t27-ngspice:47-osdi); the golden deck's address from TRI_REMOTE_DECK_URL.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

; The identity of the card, held to the rules it is written under: specs/tools/catalog.t27
; (ID_RULE: a legacy card has ID = <family>/<name> and QUALIFIED_ID = REPO:ID; every card
; carries SCHEMA = 2) and the header above (the `tri <name>` command of the tri CLI, read off
; a clap #[derive(Subcommand)] enum, which spells the name of a variant in kebab-case).

test qualified_id_is_repo_colon_id {
    assert SCHEMA == 2;
    assert QUALIFIED_ID.len == REPO.len + 1 + ID.len;
    var i : usize = 0;
    while (i < REPO.len) {
        assert QUALIFIED_ID[i] == REPO[i];
        i = i + 1;
    }
    assert QUALIFIED_ID[REPO.len] == ':';
    var j : usize = 0;
    while (j < ID.len) {
        assert QUALIFIED_ID[REPO.len + 1 + j] == ID[j];
        j = j + 1;
    }
}

test id_command_and_variant_name_one_subcommand {
    // ID is `tri/<name>` and COMMAND is `tri <name>`: the same bytes but the separator.
    assert ID.len == COMMAND.len;
    var i : usize = 0;
    while (i < ID.len) {
        if (i == 3) {
            assert ID[i] == '/';
            assert COMMAND[i] == ' ';
        } else {
            assert ID[i] == COMMAND[i];
        }
        i = i + 1;
    }
    assert COMMAND[0] == 't';
    assert COMMAND[1] == 'r';
    assert COMMAND[2] == 'i';
    // VARIANT is `Commands::<Name>`, and the kebab-case of <Name> is <name>: an upper-case
    // letter starts each word, and a word boundary is a `-` in the name.
    assert VARIANT[8] == ':';
    assert VARIANT[9] == ':';
    var v : usize = 10;
    var n : usize = 4;
    var word_start : bool = true;
    while (n < ID.len) {
        if (ID[n] == '-') {
            word_start = true;
        } else {
            if (word_start) {
                assert VARIANT[v] == ID[n] - 32;
            } else {
                assert VARIANT[v] == ID[n];
            }
            word_start = false;
            v = v + 1;
        }
        n = n + 1;
    }
    assert v == VARIANT.len;
}

test clap_names_are_kebab_case {
    // The own name of the command and every action are lower-case words joined by `-`, and each
    // action has its about text (`""` when the source has none) at the same index.
    assert ACTIONS.len == ACTIONS_ABOUT.len;
    var n : usize = 4;
    while (n < ID.len) {
        assert (ID[n] >= 'a' and ID[n] <= 'z') or ID[n] == '-';
        n = n + 1;
    }
    assert ID[4] != '-';
    assert ID[ID.len - 1] != '-';
    var a : usize = 0;
    while (a < ACTIONS.len) {
        var k : usize = 0;
        while (k < ACTIONS[a].len) {
            assert (ACTIONS[a][k] >= 'a' and ACTIONS[a][k] <= 'z') or (ACTIONS[a][k] >= '0' and ACTIONS[a][k] <= '9') or ACTIONS[a][k] == '-';
            k = k + 1;
        }
        assert ACTIONS[a][0] != '-';
        a = a + 1;
    }
    // ARGS are `<positional>` or `--flag`, each with its doc after `: ` when it has one.
    var g : usize = 0;
    while (g < ARGS.len) {
        assert ARGS[g][0] == '<' or (ARGS[g][0] == '-' and ARGS[g][1] == '-');
        g = g + 1;
    }
}

test the_queen_holds_every_tool {
    // AGENTS_ALPHABET.md binds every tool to the Queen (T); this card names no domain lead,
    // so the Queen is its only letter, one capital letter, no letter twice.
    assert AGENTS.len >= 1;
    assert AGENTS[0] == "T";
    var i : usize = 0;
    while (i < AGENTS.len) {
        assert AGENTS[i].len == 1;
        assert AGENTS[i][0] >= 'A' and AGENTS[i][0] <= 'Z';
        var j : usize = i + 1;
        while (j < AGENTS.len) {
            assert AGENTS[i][0] != AGENTS[j][0];
            j = j + 1;
        }
        i = i + 1;
    }
}

test the_card_names_the_tool_it_describes {
    assert ID == "tri/remote";
    assert COMMAND == "tri remote";
    assert VARIANT == "Commands::Remote";
    assert ARGS.len == 7;
    assert ARGS[1][0] == '<' and ARGS[1][1] == 'n';
    assert ARGS[6][0] == '-' and ARGS[6][2] == 'p';
    assert ENABLED == true;
}
