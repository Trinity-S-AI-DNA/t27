// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/worktree_checkpoint.t27 -- tool tri/worktree-checkpoint, the `tri worktree checkpoint` command
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/worktree-checkpoint).
; Checkpoint system for TRI Worktree OS that saves work state and enables safe resumption.
; φ² + 1/φ² = 3 | TRINITY

module tool_tri_worktree_checkpoint;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/worktree-checkpoint";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/worktree-checkpoint";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri worktree checkpoint";
pub const VARIANT : str = "Commands::Worktree::Checkpoint";
pub const SOURCE : str = "cli/tri/src/main.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
pub const ABOUT : str = "Create checkpoint of worktree progress and evidence for task resumption.";
pub const ABOUT_SOURCE : str = "Checkpoint system for TRI Worktree OS that saves work state and enables safe resumption.";
pub const ACTIONS : [0]str = [];
pub const ACTIONS_ABOUT : [0]str = [];
pub const ARGS : [5]str = ["--issue: Worktree issue number (required)", "--name: Checkpoint name (default: auto-generated)", "--description: Checkpoint description", "--evidence-dir: Custom evidence directory (default: .wt/evidence)", "--resume-brief: Brief for resuming work"];
pub const AGENTS : [2]str = ["T", "W"];
pub const AGENTS_NOTE : str = "Checkpoint system owned by Queen (T) and operated by Worktree (W). Saves work state and enables safe task resumption.";
pub const WHEN_TO_USE : str = "During long-running work sessions, before risky operations, and when creating safe suspension points.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test qualified_id_is_repo_colon_id {
    assert SCHEMA == 2;
    assert QUALIFIED_ID.len == REPO.len + 1 + ID.len;
    var i : usize = 0;
    while (i < REPO.len) {
        assert QUALIFIED_ID[i] == REPO[i];
        i = i + 1;
    }
    assert QUALIFIED_ID[REPO.len] == ':';
    var j : usize = 0;
    while (j < ID.len) {
        assert QUALIFIED_ID[REPO.len + 1 + j] == ID[j];
        j = j + 1;
    }
}

test id_command_and_variant_name_one_subcommand {
    assert ID.len == COMMAND.len;
    var i : usize = 0;
    while (i < ID.len) {
        if (i == 3) {
            assert ID[i] == '/';
            assert COMMAND[i] == ' ';
        } else {
            assert ID[i] == COMMAND[i];
        }
        i = i + 1;
    }
    assert COMMAND[0] == 't';
    assert COMMAND[1] == 'r';
    assert COMMAND[2] == 'i';
    assert VARIANT[8] == ':';
    assert VARIANT[9] == ':';
    var v : usize = 10;
    var n : usize = 4;
    var word_start : bool = true;
    while (n < ID.len) {
        if (ID[n] == '-') {
            word_start = true;
        } else {
            if (word_start) {
                assert VARIANT[v] == ID[n] - 32;
            } else {
                assert VARIANT[v] == ID[n];
            }
            word_start = false;
            v = v + 1;
        }
        n = n + 1;
    }
    assert v == VARIANT.len;
}

test clap_names_are_kebab_case {
    assert ACTIONS.len == ACTIONS_ABOUT.len;
    var n : usize = 4;
    while (n < ID.len) {
        assert (ID[n] >= 'a' and ID[n] <= 'z') or ID[n] == '-';
        n = n + 1;
    }
    assert ID[4] != '-';
    assert ID[ID.len - 1] != '-';
    var a : usize = 0;
    while (a < ACTIONS.len) {
        var k : usize = 0;
        while (k < ACTIONS[a].len) {
            assert (ACTIONS[a][k] >= 'a' and ACTIONS[a][k] <= 'z') or (ACTIONS[a][k] >= '0' and ACTIONS[a][k] <= '9') or ACTIONS[a][k] == '-';
            k = k + 1;
        }
        assert ACTIONS[a][0] != '-';
        a = a + 1;
    }
    var g : usize = 0;
    while (g < ARGS.len) {
        assert ARGS[g][0] == '<' or (ARGS[g][0] == '-' and ARGS[g][1] == '-');
        g = g + 1;
    }
}

test the_queen_holds_every_tool_beside_its_lead {
    assert AGENTS.len >= 2;
    assert AGENTS[0] == "T";
    var i : usize = 0;
    while (i < AGENTS.len) {
        assert AGENTS[i].len == 1;
        assert AGENTS[i][0] >= 'A' and AGENTS[i][0] <= 'Z';
        var j : usize = i + 1;
        while (j < AGENTS.len) {
            assert AGENTS[i][0] != AGENTS[j][0];
            j = j + 1;
        }
        i = i + 1;
    }
}