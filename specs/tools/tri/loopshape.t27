// SPDX-License-Identifier: Apache-2.0
// specs/tools/tri/loopshape.t27 -- a pure rule that names the shape of a hand `while` loop and says
// whether std::mem already has a function for it (epic gHashTag/t27#12444, row G, issue #12451).
// ADVISORY ONLY: a rule for a reviewer, or for a later scanner, to read. It is never a gate, it refuses
// nothing, and no `tri loopshape` command exists; this file is a rule and not a tool card.
// The sample, the six shapes, their shares and the coverage table are measured in
// docs/reports/boilerplate_loops_2026-10-25.md. This file holds only the decision rule and none of the
// numbers, so a share is written in one place.
// The input is what one loop shows when it is read: a handful of yes/no facts and one small number for the
// kind of per-element test. The output is a shape code, then a cover code for that shape.
// The rule is a first-match order and it errs towards OTHER: a loop that is nested, steps by other than
// one, or keeps more state than an index and one accumulator is never called boilerplate.
// A cover code names a whole function (or a family of them) in std::mem, or says that std::text has only
// the byte class and nothing that scans with it. Fold and copy have no function in either module.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module tools::loopshape;

// The six shapes of the report's table.
pub const SHAPE_OTHER : u32 = 0;
pub const SHAPE_FIND : u32 = 1;
pub const SHAPE_ALL_EQUAL : u32 = 2;
pub const SHAPE_COUNT : u32 = 3;
pub const SHAPE_FOLD : u32 = 4;
pub const SHAPE_COPY : u32 = 5;

// What each element is tested against.
// ELEM_BYTE: one fixed byte. ELEM_RUN: the same position of a second run (a literal counts as a run).
// ELEM_CLASS: a byte class that std::text names (digit, space, hex and so on).
// ELEM_OTHER: anything else, and every loop over elements that are not bytes of a []const u8 run.
pub const ELEM_OTHER : u32 = 0;
pub const ELEM_BYTE : u32 = 1;
pub const ELEM_RUN : u32 = 2;
pub const ELEM_CLASS : u32 = 3;

// Which std family covers a loop.
// COVER_BYTES_EQ: std::mem bytes_eq, bytes_eq_prefix, bytes_starts_with, bytes_ends_with.
// COVER_BYTES_FIND: std::mem bytes_index_of, bytes_index_of_byte, bytes_contains, bytes_trim_start, bytes_trim_end.
// COVER_BYTES_COUNT: std::mem bytes_count.
// COVER_CLASS_ONLY: std::text has the class test, but no std function scans, counts or checks with it.
pub const COVER_NONE : u32 = 0;
pub const COVER_BYTES_EQ : u32 = 1;
pub const COVER_BYTES_FIND : u32 = 2;
pub const COVER_BYTES_COUNT : u32 = 3;
pub const COVER_CLASS_ONLY : u32 = 4;

/// The shape of one hand loop; the first rule that matches wins.
/// A loop that does not step by one, or is nested, or keeps more state than an index and one accumulator,
/// is OTHER. A loop that writes an output buffer is COPY. One that stops at the first element that matches
/// (or the first that stops matching, as a skip-while does) is FIND. One that stops at the first element
/// that fails, or only compares two runs, is ALL_EQUAL. One that bumps a counter is COUNT, and one that
/// folds a value is FOLD. A loop that shows none of these facts is OTHER.
pub fn loop_shape(steps_by_one: bool, plain_body: bool, writes_output: bool, leaves_on_first_hit: bool, leaves_on_first_mismatch: bool, compares_two_runs: bool, bumps_a_counter: bool, folds_a_value: bool) -> u32 {
    if (steps_by_one == false or plain_body == false) { return SHAPE_OTHER; }
    if (writes_output) { return SHAPE_COPY; }
    if (leaves_on_first_hit) { return SHAPE_FIND; }
    if (leaves_on_first_mismatch) { return SHAPE_ALL_EQUAL; }
    if (bumps_a_counter) { return SHAPE_COUNT; }
    if (folds_a_value) { return SHAPE_FOLD; }
    if (compares_two_runs) { return SHAPE_ALL_EQUAL; }
    return SHAPE_OTHER;
}

/// The std family that covers a loop of this shape with this per-element test, or COVER_NONE.
/// A byte-class test is only partly covered. A fixed-byte test on an all-equal loop, a second-run test on
/// a count (a mismatch count), and every fold, copy and other loop have no cover at all.
pub fn std_cover(shape: u32, element_test: u32) -> u32 {
    if (shape == SHAPE_FIND) {
        if (element_test == ELEM_BYTE or element_test == ELEM_RUN) { return COVER_BYTES_FIND; }
        if (element_test == ELEM_CLASS) { return COVER_CLASS_ONLY; }
        return COVER_NONE;
    }
    if (shape == SHAPE_ALL_EQUAL) {
        if (element_test == ELEM_RUN) { return COVER_BYTES_EQ; }
        if (element_test == ELEM_CLASS) { return COVER_CLASS_ONLY; }
        return COVER_NONE;
    }
    if (shape == SHAPE_COUNT) {
        if (element_test == ELEM_BYTE) { return COVER_BYTES_COUNT; }
        if (element_test == ELEM_CLASS) { return COVER_CLASS_ONLY; }
        return COVER_NONE;
    }
    return COVER_NONE;
}

/// A rewrite to one std::mem call can be suggested: only when a whole function covers the loop.
pub fn suggests_rewrite(cover: u32) -> bool {
    return cover == COVER_BYTES_EQ or cover == COVER_BYTES_FIND or cover == COVER_BYTES_COUNT;
}

// The arguments of loop_shape, in order:
// steps_by_one, plain_body, writes_output, leaves_on_first_hit, leaves_on_first_mismatch,
// compares_two_runs, bumps_a_counter, folds_a_value.

test all_equal_takes_the_bytes_eq_shape {
    // bytes_eq: two runs, leaves on the first mismatch
    assert loop_shape(true, true, false, false, true, true, false, false) == SHAPE_ALL_EQUAL;
}

test all_equal_takes_the_assert_form_and_the_forall_form {
    // two runs compared with no early exit (the loop asserts each pair)
    assert loop_shape(true, true, false, false, false, true, false, false) == SHAPE_ALL_EQUAL;
    // one run, every byte must pass a test, leaves on the first that fails
    assert loop_shape(true, true, false, false, true, false, false, false) == SHAPE_ALL_EQUAL;
}

test find_takes_the_first_hit_and_the_skip_while {
    // index_of_byte, trim_start: stops at the first element that matches or stops matching
    assert loop_shape(true, true, false, true, false, false, false, false) == SHAPE_FIND;
    // the inner loop of a substring search: compares two runs and leaves on a hit
    assert loop_shape(true, true, false, true, false, true, false, false) == SHAPE_FIND;
}

test a_find_is_not_an_equality_check {
    assert loop_shape(true, true, false, true, false, false, false, false) != SHAPE_ALL_EQUAL;
    assert loop_shape(true, true, false, true, false, true, false, false) != SHAPE_ALL_EQUAL;
}

test count_takes_a_counter {
    // bytes_count: bumps a counter for every matching element
    assert loop_shape(true, true, false, false, false, false, true, false) == SHAPE_COUNT;
}

test a_mismatch_count_is_a_count_and_not_an_equality {
    // two runs compared, but the loop bumps a counter instead of leaving: it counts, it does not check
    assert loop_shape(true, true, false, false, false, true, true, false) == SHAPE_COUNT;
    assert loop_shape(true, true, false, false, false, true, true, false) != SHAPE_ALL_EQUAL;
}

test fold_takes_an_accumulator_and_is_not_a_count {
    assert loop_shape(true, true, false, false, false, false, false, true) == SHAPE_FOLD;
    assert loop_shape(true, true, false, false, false, false, false, true) != SHAPE_COUNT;
}

test copy_takes_a_write_and_wins_over_a_compare {
    assert loop_shape(true, true, true, false, false, false, false, false) == SHAPE_COPY;
    // a filter-copy that also compares and leaves early is still a copy
    assert loop_shape(true, true, true, false, true, true, false, false) == SHAPE_COPY;
    assert loop_shape(true, true, true, false, true, true, false, false) != SHAPE_ALL_EQUAL;
}

test other_when_the_loop_is_nested_or_steps_by_other_than_one {
    // a clean equality loop in every other way, but nested
    assert loop_shape(true, false, false, false, true, true, false, false) == SHAPE_OTHER;
    // a clean equality loop in every other way, but it steps by two
    assert loop_shape(false, true, false, false, true, true, false, false) == SHAPE_OTHER;
    // a nested loop that writes an output buffer is not called a copy
    assert loop_shape(true, false, true, false, false, false, false, false) == SHAPE_OTHER;
    assert loop_shape(true, false, true, false, false, false, false, false) != SHAPE_COPY;
}

test other_when_the_loop_shows_no_feature {
    assert loop_shape(true, true, false, false, false, false, false, false) == SHAPE_OTHER;
}

test the_six_shape_codes_are_six_different_numbers {
    // each code is read back from the rule, so the asserts run (a bare constant compare is folded away)
    var o : u32 = loop_shape(false, true, false, false, false, false, false, false);
    var f : u32 = loop_shape(true, true, false, true, false, false, false, false);
    var e : u32 = loop_shape(true, true, false, false, false, true, false, false);
    var c : u32 = loop_shape(true, true, false, false, false, false, true, false);
    var d : u32 = loop_shape(true, true, false, false, false, false, false, true);
    var w : u32 = loop_shape(true, true, true, false, false, false, false, false);
    assert o == 0 and f == 1 and e == 2;
    assert c == 3 and d == 4 and w == 5;
}

test cover_names_the_family_for_a_byte_or_run_equality_test {
    assert std_cover(SHAPE_FIND, ELEM_BYTE) == COVER_BYTES_FIND;
    assert std_cover(SHAPE_FIND, ELEM_RUN) == COVER_BYTES_FIND;
    assert std_cover(SHAPE_ALL_EQUAL, ELEM_RUN) == COVER_BYTES_EQ;
    assert std_cover(SHAPE_COUNT, ELEM_BYTE) == COVER_BYTES_COUNT;
}

test cover_of_a_byte_class_test_is_partial {
    assert std_cover(SHAPE_FIND, ELEM_CLASS) == COVER_CLASS_ONLY;
    assert std_cover(SHAPE_ALL_EQUAL, ELEM_CLASS) == COVER_CLASS_ONLY;
    assert std_cover(SHAPE_COUNT, ELEM_CLASS) == COVER_CLASS_ONLY;
}

test cover_of_any_other_test_is_none {
    assert std_cover(SHAPE_FIND, ELEM_OTHER) == COVER_NONE;
    assert std_cover(SHAPE_ALL_EQUAL, ELEM_OTHER) == COVER_NONE;
    assert std_cover(SHAPE_COUNT, ELEM_OTHER) == COVER_NONE;
    assert std_cover(SHAPE_FIND, 9) == COVER_NONE;
}

test a_fixed_byte_on_all_equal_and_a_run_on_a_count_have_no_cover {
    // all bytes equal one byte: no std function takes that shape
    assert std_cover(SHAPE_ALL_EQUAL, ELEM_BYTE) == COVER_NONE;
    // a mismatch count between two runs: bytes_count counts one fixed byte only
    assert std_cover(SHAPE_COUNT, ELEM_RUN) == COVER_NONE;
}

test fold_copy_and_other_have_no_cover_whatever_the_test {
    assert std_cover(SHAPE_FOLD, ELEM_BYTE) == COVER_NONE;
    assert std_cover(SHAPE_FOLD, ELEM_CLASS) == COVER_NONE;
    assert std_cover(SHAPE_COPY, ELEM_RUN) == COVER_NONE;
    assert std_cover(SHAPE_COPY, ELEM_CLASS) == COVER_NONE;
    assert std_cover(SHAPE_OTHER, ELEM_BYTE) == COVER_NONE;
    assert std_cover(9, ELEM_BYTE) == COVER_NONE;
}

test a_rewrite_is_suggested_only_for_a_whole_function {
    assert suggests_rewrite(COVER_BYTES_EQ);
    assert suggests_rewrite(COVER_BYTES_FIND);
    assert suggests_rewrite(COVER_BYTES_COUNT);
    assert suggests_rewrite(COVER_CLASS_ONLY) == false;
    assert suggests_rewrite(COVER_NONE) == false;
}

test a_loop_read_end_to_end {
    // a bytes_eq-shaped loop over byte runs: rewrite suggested
    assert suggests_rewrite(std_cover(loop_shape(true, true, false, false, true, true, false, false), ELEM_RUN));
    // a fold: nothing to suggest
    assert suggests_rewrite(std_cover(loop_shape(true, true, false, false, false, false, false, true), ELEM_BYTE)) == false;
    // a count over a byte class: std::text has the class only, so no rewrite
    assert suggests_rewrite(std_cover(loop_shape(true, true, false, false, false, false, true, false), ELEM_CLASS)) == false;
    // a mismatch count between two runs: a count, and bytes_count does not cover it
    assert suggests_rewrite(std_cover(loop_shape(true, true, false, false, false, true, true, false), ELEM_RUN)) == false;
    // a find on one fixed byte: rewrite suggested
    assert suggests_rewrite(std_cover(loop_shape(true, true, false, true, false, false, false, false), ELEM_BYTE));
}
