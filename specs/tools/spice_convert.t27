// specs/tools/spice_convert.t27 -- spice_convert.t27 is BLOCKED on the lab at
// master: 44 tests have no receipt.
// Part of M1 (milestone #5). Closes #13657.
// phi^2 + 1/phi^2 = 3 | TRINITY

module tools::spice_convert;

pub const SPICE_CONVERT_TEST_RECEIPTS : u32 = 44;

pub struct SpiceConvert { tests_with_receipt: u32 };

pub fn spice_convert_all_tested(s: SpiceConvert) -> bool {
    return s.tests_with_receipt >= SPICE_CONVERT_TEST_RECEIPTS;
}

test "spice convert test receipts" {
    assert(spice_convert_all_tested(SpiceConvert { tests_with_receipt: 44 }));
    assert(!spice_convert_all_tested(SpiceConvert { tests_with_receipt: 43 }));
}

invariant spice_convert_test_receipts_is_44 {
    assert SPICE_CONVERT_TEST_RECEIPTS == 44;
}