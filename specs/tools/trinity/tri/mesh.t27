// ═════════════════════════════════════════════════════════════════════
// Unified Mesh Types (from identity_events.t27)
// ═════════════════════════════════════════════════════════════════════

/// Mesh node state (matches tri-net TriNetMonitor.swift)
pub enum MeshNodeState {
  Offline,    // Node not connected to mesh
  Online,     // Node connected and healthy
  Weak,       // Node connected but with poor quality
}

/// Mesh node kind (matches tri-net TriNetMonitor.swift)
pub enum MeshNodeKind {
  Endpoint,   // Regular endpoint node
  Relay,      // Relay node for forwarding
  Gateway,    // Gateway to external networks
  External,   // External node (not part of core mesh)
}

/// Mesh node with state and kind
pub struct MeshNode {
  state: MeshNodeState,
  kind: MeshNodeKind,
}

/// ETX link quality thresholds (matches tri-net TriNetMonitor.swift)
pub const ETX_GREEN_THRESHOLD: f32 = 1.2;  // Good quality link
pub const ETX_YELLOW_THRESHOLD: f32 = 2.0; // Moderate quality link
pub const ETX_RED_THRESHOLD: f32 = 3.5;    // Poor quality link

/// Mesh link quality color
pub enum MeshLinkColor {
  Green,      // ETX < 1.2 (good quality)
  Yellow,     // 1.2 ≤ ETX < 2.0 (moderate quality)
  Red,        // ETX ≥ 2.0 (poor quality)
}

/// Mesh link between two nodes
pub struct MeshLink {
  etx: f32,                    // Expected transmission count (quality metric)
  color: MeshLinkColor,       // Quality color based on ETX thresholds
}

/// Determine mesh link color based on ETX value
pub fn mesh_link_color_from_etx(etx: f32) MeshLinkColor {
  if (etx < ETX_GREEN_THRESHOLD) {
    return MeshLinkColor.Green;
  } else if (etx < ETX_YELLOW_THRESHOLD) {
    return MeshLinkColor.Yellow;
  } else {
    return MeshLinkColor.Red;
  }
}

// ═════════════════════════════════════════════════════════════════════
// Deprecated Schemes
// ═════════════════════════════════════════════════════════════════════

/// DEPRECATED: mesh NodeId u32 = last IP octet (non-unique, unreliable)
/// REPLACED BY: IdentityRecord.key_id (64-bit, unique)
pub const DEPRECATED_MESH_NODE_ID_U32: bool = false;

/// DEPRECATED: executor_id = 32 bits of SHA-256(pubkey), spec and doc disagree on bits
/// REPLACED BY: IdentityRecord.key_id (64-bit, unambiguous)
pub const DEPRECATED_EXECUTOR_ID_BIT_SLICE: bool = false;

/// DEPRECATED: device_id u32 (insufficient uniqueness)
/// REPLACED BY: IdentityRecord.fuse_dna (32-byte, unique per device)
pub const DEPRECATED_DEVICE_ID_U32: bool = false;

/// DEPRECATED: P-256 app keys (different key type from mesh keys)
/// REPLACED BY: IdentityRecord.key_id (unified key identity)
pub const DEPRECATED_P256_APP_KEYS: bool = false;

/// DEPRECATED: symmetric node_key (different cryptographic primitive)
/// REPLACED BY: IdentityRecord.key_id with asymmetric signature
pub const DEPRECATED_SYMMETRIC_NODE_KEY: bool = false;

/// DEPRECATED: demo keys derived from public node IDs (insecure, predictable)
/// REPLACED BY: IdentityRecord.key_id (cryptographically secure)
pub const DEPRECATED_DEMO_KEYS: bool = false;

// ═════════════════════════════════════════════════════════════════════
// Unified mesh operations for tri mesh command
// ═════════════════════════════════════════════════════════════════════

pub fn create_mesh_node(state: MeshNodeState, kind: MeshNodeKind) MeshNode {
    return MeshNode{
        .state = state,
        .kind = kind,
    };
}

pub fn create_mesh_link(etx: f32) MeshLink {
    return MeshLink{
        .etx = etx,
        .color = mesh_link_color_from_etx(etx),
    };
}
