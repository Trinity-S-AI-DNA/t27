// ═════════════════════════════════════════════════════════════════════
// Unified Identity Types (from identity_events.t27)
// ═════════════════════════════════════════════════════════════════════

/// Mesh address for network routing
pub struct MeshAddr {
  addr: [16]u8,
}

/// Node roles in the network
pub enum Role {
  Endpoint,    // Regular endpoint node
  Relay,       // Relay node for forwarding
  Gateway,     // Gateway to external networks
  External,    // External node (not part of core mesh)
}

/// Single identity record binding all identity components with verified signature
/// Replaces: mesh NodeId u32, executor_id 32-bit SHA-256, device_id u32, 
/// P-256 app keys, symmetric node_key, 64-bit receipt key ids
pub struct IdentityRecord {
  key_id: u64,                    // 64-bit receipt key id (e.g., a05db80f53c317f6)
  fuse_dna: [32]u8,              // 32-byte device FUSE_DNA (unique per Zynq Mini)
  mesh_addr: MeshAddr,           // Mesh address for routing
  role: Role,                    // Node role in the network
  binding_sig: [64]u8,           // Ed25519 signature over concatenation of above fields
}

/// Verify the binding signature in an IdentityRecord
pub fn verify_identity_binding(record: IdentityRecord) bool {
  // Concatenate the identity fields for signing
  var data: [144]u8 = undefined; // 8 + 32 + 16 + 88 (approximate)
  var offset: usize = 0;
  
  // Copy key_id (8 bytes)
  var i: usize = 0;
  while (i < 8) {
    data[offset + i] = @intCast(record.key_id >> (8 * (7 - i)));
    i += 1;
  }
  offset += 8;
  
  // Copy fuse_dna (32 bytes)
  i = 0;
  while (i < 32) {
    data[offset + i] = record.fuse_dna[i];
    i += 1;
  }
  offset += 32;
  
  // Copy mesh_addr (16 bytes)
  i = 0;
  while (i < 16) {
    data[offset + i] = record.mesh_addr.addr[i];
    i += 1;
  }
  offset += 16;
  
  // Copy role (1 byte)
  data[offset] = @intFromEnum(record.role);
  offset += 1;
  
  // Verify signature using Ed25519 (simplified - actual implementation would use crypto library)
  // This is a placeholder for the actual signature verification logic
  return verify_ed25519_signature(data[0..offset], record.binding_sig);
}

/// Ed25519 signature verification (placeholder)
fn verify_ed25519_signature(message: []const u8, signature: [64]u8) bool {
  // Actual implementation would use Ed25519 verification
  // For now, return true for valid-looking signatures
  return signature[0] != 0 or signature[63] != 0;
}

// ═════════════════════════════════════════════════════════════════════
// Deprecated Schemes
// ═════════════════════════════════════════════════════════════════════

/// DEPRECATED: mesh NodeId u32 = last IP octet (non-unique, unreliable)
/// REPLACED BY: IdentityRecord.key_id (64-bit, unique)
pub const DEPRECATED_MESH_NODE_ID_U32: bool = false;

/// DEPRECATED: executor_id = 32 bits of SHA-256(pubkey), spec and doc disagree on bits
/// REPLACED BY: IdentityRecord.key_id (64-bit, unambiguous)
pub const DEPRECATED_EXECUTOR_ID_BIT_SLICE: bool = false;

/// DEPRECATED: device_id u32 (insufficient uniqueness)
/// REPLACED BY: IdentityRecord.fuse_dna (32-byte, unique per device)
pub const DEPRECATED_DEVICE_ID_U32: bool = false;

/// DEPRECATED: P-256 app keys (different key type from mesh keys)
/// REPLACED BY: IdentityRecord.key_id (unified key identity)
pub const DEPRECATED_P256_APP_KEYS: bool = false;

/// DEPRECATED: symmetric node_key (different cryptographic primitive)
/// REPLACED BY: IdentityRecord.key_id with asymmetric signature
pub const DEPRECATED_SYMMETRIC_NODE_KEY: bool = false;

/// DEPRECATED: demo keys derived from public node IDs (insecure, predictable)
/// REPLACED BY: IdentityRecord.key_id (cryptographically secure)
pub const DEPRECATED_DEMO_KEYS: bool = false;

// ═════════════════════════════════════════════════════════════════════
// Unified identity operations for tri identity command
// ═════════════════════════════════════════════════════════════════════

pub fn create_identity_record(key_id: u64, fuse_dna: [32]u8, mesh_addr: [16]u8, role: Role) IdentityRecord {
    return IdentityRecord{
        .key_id = key_id,
        .fuse_dna = fuse_dna,
        .mesh_addr = MeshAddr{ .addr = mesh_addr },
        .role = role,
        .binding_sig = [64]u8{0} ** 64, // Will be populated by signing
    };
}

pub fn verify_identity(record: IdentityRecord) bool {
    return verify_identity_binding(record);
}
