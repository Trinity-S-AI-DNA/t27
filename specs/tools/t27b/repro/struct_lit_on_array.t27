// Repro: ExprStructLit on array type (t27b native-backend defect)
// t27b rejects `TernaryWord{.raw=0}` when TernaryWord is an array type [N]u8.
// Expected: struct-literal syntax on an array type should lower correctly.
// Actual:   "TernaryWord is [5]u8, not a struct" — exit 2.

module repro_struct_lit_on_array;

const WORD_SIZE : usize = 5;

type TernaryWord = [WORD_SIZE]u8;

fn make_word(raw: u32) -> TernaryWord {
    return TernaryWord{ .raw = 0 };  // ExprStructLit on array type
}

test struct_lit_on_array_compiles {
    given w = make_word(0)
    then w[0] == 0u8
}
