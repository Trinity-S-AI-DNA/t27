// Repro: ExprCast enum-to-int (t27b native-backend defect)
// t27b rejects casting an enum to an integer type.
// Expected: enum-to-int cast lowers to the enum's discriminant value.
// Actual:   "enum `Trit` as i8" — exit 2.

module repro_enum_cast;

type Trit = enum { neg, zero, pos };

fn to_i8(t: Trit) -> i8 {
    return t as i8;  // ExprCast enum-to-int
}

test enum_cast_neg {
    given t = Trit.neg
    then to_i8(t) == 0i8
}

test enum_cast_pos {
    given t = Trit.pos
    then to_i8(t) == 2i8
}
