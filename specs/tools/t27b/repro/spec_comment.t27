// Repro: parse error on `;` comment inside spec body (t27b native-backend defect)
// t27b's parser rejects `;`-prefixed comments at module level inside a `spec` block.
// Expected: `;` comments are ignored like elsewhere.
// Actual:   "Expected RBrace, got Semicolon (';')" — exit 3.

module repro_spec_comment;

spec repro_spec_comment {
    ; this comment at module level inside a spec body causes a parse error

    test spec_comment_passes {
        given x = 1
        then x == 1
    }
}
