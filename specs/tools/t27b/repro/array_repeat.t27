// SPDX-License-Identifier: Apache-2.0
// specs/tools/t27b/repro/array_repeat.t27 -- Widget array repeat rendering:
// widget array repeat edge cases to prevent out-of-bounds reads.
// Part of M5 milestone (milestone #9). Closes #12354.
// phi^2 + 1/phi^2 = 3 | TRINITY

module widgets::array_repeat;

pub const ARRAY_REPEAT_MAX : u32 = 256;

pub struct ArrayRepeat {
    count: u32,
    value: u32,
}

pub fn array_repeat_count(a: ArrayRepeat) -> u32 {
    return a.count;
}

pub fn array_repeat_value(a: ArrayRepeat) -> u32 {
    return a.value;
}

pub fn array_repeat_create(count: u32, value: u32) -> ArrayRepeat {
    return ArrayRepeat { count: count, value: value };
}

pub fn array_repeat_is_valid(a: ArrayRepeat) -> bool {
    return a.count <= ARRAY_REPEAT_MAX;
}

test "array_repeat_count" {
    var a = ArrayRepeat { count: 5, value: 42 };
    assert(array_repeat_count(a) == 5);
}

test "array_repeat_value" {
    var a = ArrayRepeat { count: 3, value: 42 };
    assert(array_repeat_value(a) == 42);
}

test "array_repeat_create" {
    var a = array_repeat_create(7, 99);
    assert(a.count == 7);
    assert(a.value == 99);
}

test "array_repeat_is_valid" {
    assert(array_repeat_is_valid(ArrayRepeat { count: 0, value: 0 }));
    assert(array_repeat_is_valid(ArrayRepeat { count: ARRAY_REPEAT_MAX, value: 0 }));
    assert(!array_repeat_is_valid(ArrayRepeat { count: ARRAY_REPEAT_MAX + 1, value: 0 }));
}

invariant array_repeat_max_positive {
    assert ARRAY_REPEAT_MAX > 0;
}