// Repro: ExprArrayLiteral repeat-to-slice / no result type (t27b native-backend defect)
// t27b rejects `[X; N]` array repetition literals and array literals without
// an inferrable result type.
// Expected: array repetition literal lowers to a fixed-size array.
// Actual:   "array literal with no result type" / "repeat to slice" — exit 2.

module repro_array_repeat;

const N : usize = 4;

fn fill_pos(val: u8) -> [N]u8 {
    return [val; N];  // ExprArrayLiteral repeat-to-slice
}

test array_repeat_compiles {
    given arr = fill_pos(7u8)
    then arr[0] == 7u8 and arr[3] == 7u8
}
