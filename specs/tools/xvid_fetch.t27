// SPDX-License-Identifier: Apache-2.0
// specs/tools/xvid_fetch.t27 -- the decisions of a post-video fetch: which record to read for a post,
// which MP4 variant of that record to take, and what to call the file. See epic #13650.
// Why. Studying a post's video from one screenshot is not a study (owner, 2026-11-14). The frames must
// be on disk first, and the choice of what to download was made by hand eight times in one session:
// read the id out of the post link, build the public record address, find the `/vid/avc1/<W>x<H>/`
// variants in the record text, take the largest. Those four choices are pure text functions; this file
// pins them with tests so a host does not re-derive them.
// What is NOT done here: the network. Fetching the record and the file is plumbing (`curl` with a
// browser User-Agent); this spec only says which address and which name. A post that needs a sign-in
// is not worked around: variant_url returns 0 and the caller reports "no video".
// --
// The functions, each with its `_n` core (lengths given, because a slice has no `.len` in C):
// - post_id(url, out, cap): the decimal digits right after `/status/`. 0 when the link has no
//   `/status/`, no digit after it, or the id does not fit cap.
// - record_url(id, out, cap): `https://cdn.syndication.twimg.com/tweet-result?id=<id>&token=a`.
//   0 when the id is empty, holds a non-digit, or the address does not fit cap.
// - variant_area(rec, m, n): W * H of the variant whose `/vid/avc1/` marker starts at rec[m]. 0 when
//   the marker is not followed by `<digits>x<digits>/`, or a side has more than 5 digits.
// - best_variant(rec): the marker index of the variant with the largest area; the first one wins a
//   tie. rec.len when the record lists no well-formed variant (a post with photos only).
// - variant_url(rec, out, cap): the address of the best variant, from the byte after the opening
//   quote to the byte before the closing quote, copied verbatim. 0 when there is no variant, the
//   address is not on `https://video.twimg.com/`, the quote never closes, or it does not fit cap.
// - file_name(id, k, out, cap): `<id>_<k>.mp4` for the k-th video of a post, k in 1..9.
// 0 always means "nothing"; bytes written before a 0 is returned may be clipped: do not read them.
// --
// Limits. One video per record: a post with several videos gives the largest variant over all of
// them (file_name's k is for a caller that splits the record itself). Text matching only, no JSON
// reader: a record that escapes `/` as `\/` shows no marker and gives 0. Literal patterns use `.len`,
// so this module is for the Zig road and its tests, not for C lowering.
// Every private helper carries the xv_ prefix: the `use` splice keys declarations by bare name.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module tools::xvid_fetch;

use std::text::is_digit;
use policy::own_language::put;
use policy::own_language::put_range;

/// True when pat stands at s[i].
fn xv_at(s: []const u8, i: usize, n: usize, pat: []const u8) -> bool {
    const pn : usize = pat.len;
    if (i + pn > n) { return false; }
    var k : usize = 0;
    while (k < pn) {
        if (s[i + k] != pat[k]) { return false; }
        k += 1;
    }
    return true;
}

/// The first index at or after `from` where pat stands; n when it stands nowhere.
fn xv_find(s: []const u8, n: usize, from: usize, pat: []const u8) -> usize {
    var i : usize = from;
    while (i + pat.len <= n) {
        if (xv_at(s, i, n, pat)) { return i; }
        i += 1;
    }
    return n;
}

/// One past the last digit of the run that starts at s[i]; i itself when s[i] is not a digit.
fn xv_digits_end(s: []const u8, i: usize, n: usize) -> usize {
    var k : usize = i;
    while (k < n and is_digit(s[k])) { k += 1; }
    return k;
}

/// The decimal value of s[from..to]; 0 for an empty run or one longer than 5 digits.
fn xv_value(s: []const u8, from: usize, to: usize) -> usize {
    if (to <= from or to - from > 5) { return 0; }
    var v : usize = 0;
    var k : usize = from;
    while (k < to) {
        v = v * 10 + (s[k] - 48);
        k += 1;
    }
    return v;
}

/// True when s[0..n] is one or more digits and nothing else.
fn xv_all_digits(s: []const u8, n: usize) -> bool {
    return n > 0 and xv_digits_end(s, 0, n) == n;
}

/// Write a literal.
fn xv_put_text(out: []u8, w: usize, cap: usize, t: []const u8) -> usize {
    return put_range(out, w, cap, t, 0, t.len);
}

/// True when a[0..an] equals b. For tests.
fn xv_same(a: []const u8, an: usize, b: []const u8) -> bool {
    return an == b.len and xv_at(a, 0, an, b);
}

pub fn post_id_n(url: []const u8, n: usize, out: []u8, cap: usize) -> usize {
    const m : usize = xv_find(url, n, 0, "/status/");
    if (m == n) { return 0; }
    const a : usize = m + 8;
    const e : usize = xv_digits_end(url, a, n);
    if (e == a or e - a > cap) { return 0; }
    return put_range(out, 0, cap, url, a, e);
}

pub fn post_id(url: []const u8, out: []u8, cap: usize) -> usize {
    return post_id_n(url, url.len, out, cap);
}

pub fn record_url_n(id: []const u8, idn: usize, out: []u8, cap: usize) -> usize {
    if (xv_all_digits(id, idn) == false) { return 0; }
    var w : usize = xv_put_text(out, 0, cap, "https://cdn.syndication.twimg.com/tweet-result?id=");
    w = put_range(out, w, cap, id, 0, idn);
    w = xv_put_text(out, w, cap, "&token=a");
    if (w > cap) { return 0; }
    return w;
}

pub fn record_url(id: []const u8, out: []u8, cap: usize) -> usize {
    return record_url_n(id, id.len, out, cap);
}

pub fn variant_area(rec: []const u8, m: usize, n: usize) -> usize {
    if (xv_at(rec, m, n, "/vid/avc1/") == false) { return 0; }
    const a : usize = m + 10;
    const we : usize = xv_digits_end(rec, a, n);
    if (we >= n or rec[we] != 'x') { return 0; }
    const he : usize = xv_digits_end(rec, we + 1, n);
    if (he >= n or rec[he] != '/') { return 0; }
    return xv_value(rec, a, we) * xv_value(rec, we + 1, he);
}

pub fn best_variant_n(rec: []const u8, n: usize) -> usize {
    var best : usize = n;
    var area : usize = 0;
    var i : usize = xv_find(rec, n, 0, "/vid/avc1/");
    while (i < n) {
        const a : usize = variant_area(rec, i, n);
        if (a > area) {
            area = a;
            best = i;
        }
        i = xv_find(rec, n, i + 1, "/vid/avc1/");
    }
    return best;
}

pub fn best_variant(rec: []const u8) -> usize {
    return best_variant_n(rec, rec.len);
}

pub fn variant_url_n(rec: []const u8, n: usize, out: []u8, cap: usize) -> usize {
    const m : usize = best_variant_n(rec, n);
    if (m == n) { return 0; }
    var s : usize = m;
    while (s > 0 and rec[s - 1] != '"') { s -= 1; }
    var e : usize = m;
    while (e < n and rec[e] != '"') { e += 1; }
    if (e == n) { return 0; }
    if (xv_at(rec, s, n, "https://video.twimg.com/") == false) { return 0; }
    if (e - s > cap) { return 0; }
    return put_range(out, 0, cap, rec, s, e);
}

pub fn variant_url(rec: []const u8, out: []u8, cap: usize) -> usize {
    return variant_url_n(rec, rec.len, out, cap);
}

pub fn file_name_n(id: []const u8, idn: usize, k: u8, out: []u8, cap: usize) -> usize {
    if (xv_all_digits(id, idn) == false) { return 0; }
    if (k < 1 or k > 9) { return 0; }
    var w : usize = put_range(out, 0, cap, id, 0, idn);
    w = put(out, w, cap, '_');
    w = put(out, w, cap, 48 + k);
    w = xv_put_text(out, w, cap, ".mp4");
    if (w > cap) { return 0; }
    return w;
}

pub fn file_name(id: []const u8, k: u8, out: []u8, cap: usize) -> usize {
    return file_name_n(id, id.len, k, out, cap);
}

test post_id_reads_the_digits_after_status {
    var out : [32]u8 = undefined;
    const w : usize = post_id("https://x.com/someone/status/2117298374114431296?s=20", &out, 32);
    assert w == 19;
    assert xv_same(&out, w, "2117298374114431296");
}

test post_id_refuses_a_link_without_an_id {
    var out : [32]u8 = undefined;
    assert post_id("https://x.com/someone", &out, 32) == 0;
    assert post_id("https://x.com/someone/status/abc", &out, 32) == 0;
    assert post_id("https://x.com/someone/status/", &out, 32) == 0;
}

test post_id_refuses_an_id_that_does_not_fit {
    var out : [4]u8 = undefined;
    assert post_id("https://x.com/a/status/12345", &out, 4) == 0;
    assert post_id("https://x.com/a/status/1234", &out, 4) == 4;
}

test record_url_is_the_public_record_address {
    var out : [96]u8 = undefined;
    const w : usize = record_url("2117298374114431296", &out, 96);
    assert xv_same(&out, w, "https://cdn.syndication.twimg.com/tweet-result?id=2117298374114431296&token=a");
}

test record_url_refuses_a_bad_id_and_a_short_buffer {
    var out : [96]u8 = undefined;
    assert record_url("", &out, 96) == 0;
    assert record_url("12a4", &out, 96) == 0;
    assert record_url("12/../4", &out, 96) == 0;
    assert record_url("1234", &out, 20) == 0;
}

test variant_area_is_width_times_height {
    assert variant_area("/vid/avc1/1874x1080/b.mp4", 0, 25) == 2023920;
    assert variant_area("/vid/avc1/468x270/a.mp4", 0, 23) == 126360;
}

test variant_area_refuses_a_malformed_size {
    assert variant_area("/vid/avc1/1874-1080/b.mp4", 0, 25) == 0;
    assert variant_area("/vid/avc1/x1080/b.mp4", 0, 21) == 0;
    assert variant_area("/vid/avc1/1874x/b.mp4", 0, 21) == 0;
    assert variant_area("/vid/avc1/1874x1080", 0, 19) == 0;
    assert variant_area("/vid/avc1/123456x10/b.mp4", 0, 25) == 0;
    assert variant_area("/pic/avc1/10x10/b.mp4", 0, 21) == 0;
}

test variant_url_takes_the_largest_variant_in_any_order {
    var out : [96]u8 = undefined;
    const rec : []const u8 = "{\"v\":[{\"src\":\"https://video.twimg.com/a/1/vid/avc1/624x360/m.mp4?tag=1\"},{\"src\":\"https://video.twimg.com/a/1/vid/avc1/1874x1080/big.mp4?tag=1\"},{\"src\":\"https://video.twimg.com/a/1/vid/avc1/468x270/s.mp4\"}]}";
    const w : usize = variant_url(rec, &out, 96);
    assert xv_same(&out, w, "https://video.twimg.com/a/1/vid/avc1/1874x1080/big.mp4?tag=1");
}

test best_variant_keeps_the_first_of_a_tie {
    const rec : []const u8 = "\"https://video.twimg.com/a/vid/avc1/10x20/a.mp4\",\"https://video.twimg.com/a/vid/avc1/20x10/b.mp4\"";
    assert best_variant(rec) == 26;
}

test a_record_with_photos_only_has_no_video {
    var out : [96]u8 = undefined;
    const rec : []const u8 = "{\"photos\":[{\"url\":\"https://pbs.twimg.com/media/x.jpg\"}]}";
    assert best_variant(rec) == rec.len;
    assert variant_url(rec, &out, 96) == 0;
}

test variant_url_refuses_a_foreign_host_an_open_quote_and_a_short_buffer {
    var out : [96]u8 = undefined;
    assert variant_url("\"https://evil.example/a/vid/avc1/10x10/a.mp4\"", &out, 96) == 0;
    assert variant_url("\"https://video.twimg.com/a/vid/avc1/10x10/a.mp4", &out, 96) == 0;
    assert variant_url("\"https://video.twimg.com/a/vid/avc1/10x10/a.mp4\"", &out, 8) == 0;
}

test file_name_is_id_underscore_index {
    var out : [32]u8 = undefined;
    const w : usize = file_name("2117298374114431296", 1, &out, 32);
    assert xv_same(&out, w, "2117298374114431296_1.mp4");
}

test file_name_refuses_a_bad_id_and_a_bad_index {
    var out : [32]u8 = undefined;
    assert file_name("../etc", 1, &out, 32) == 0;
    assert file_name("123", 0, &out, 32) == 0;
    assert file_name("123", 10, &out, 32) == 0;
    assert file_name("123", 1, &out, 4) == 0;
}
