// SPDX-License-Identifier: Apache-2.0
; specs/tools/grok_plugin.t27 -- identity of the T27 plugin the Grok plugins
; dashboard loads. The dashboard at DASHBOARD reads .grok-plugin/marketplace.json.
; The package is plugins/t27. Grok parses JSON and SKILL.md, not this module, so
; those files repeat the strings below. A mismatch is a defect of the package.
; phi^2 + 1/phi^2 = 3 | TRINITY

module grok_plugin;

pub const NAME : str = "t27";
pub const VERSION : str = "0.1.0";
pub const CATALOG : str = "Work in a t27 checkout: specs are the source, t27c checks them, t27b runs them.";
pub const SKILL_DESCRIPTION : str = "Work in a t27 checkout. Use when the tree has specs or the user names t27, t27c, t27b, or t27.ai.";
pub const CMD_CHECK : str = "Parse and typecheck one .t27 spec with t27c. Use after a spec edit, before tests.";
pub const CMD_TEST : str = "Run one spec's tests with t27b and t27c test-report. Use when behavior must be shown.";
pub const CMD_SEAL : str = "Seal one spec with t27c seal --save and --verify. Use after that spec's tests pass.";
pub const HOMEPAGE : str = "https://t27.ai";
pub const REPOSITORY : str = "https://github.com/Trinity-S-AI-DNA/t27";
pub const DASHBOARD : str = "https://grok.com/dashboard/plugins";
pub const LICENSE_NAME : str = "Apache-2.0";
pub const CATEGORY : str = "development";
pub const SOURCE_PATH : str = "./plugins/t27";
pub const MARKET_FILE : str = ".grok-plugin/marketplace.json";
pub const MANIFEST_FILE : str = "plugins/t27/.grok-plugin/plugin.json";
pub const INDEX_FILE : str = ".grok-plugin/plugin-index.json";
pub const KEYWORDS : [5]str = ["t27", "t27c", "t27b", "golden chain", ".t27"];
pub const DOMAINS : [2]str = ["t27.ai", "app.t27.ai"];
pub const COMMANDS : [3]str = ["t27-check", "t27-test", "t27-seal"];
pub const PETAL_COUNT : u8 = 27;
pub const HAS_MCP : bool = false;
pub const HAS_HOOKS : bool = false;

test identity {
    assert NAME == "t27";
    assert VERSION == "0.1.0";
    assert CATALOG == "Work in a t27 checkout: specs are the source, t27c checks them, t27b runs them.";
    assert HOMEPAGE == "https://t27.ai";
    assert REPOSITORY == "https://github.com/Trinity-S-AI-DNA/t27";
    assert DASHBOARD == "https://grok.com/dashboard/plugins";
    assert LICENSE_NAME == "Apache-2.0";
    assert CATEGORY == "development";
    assert SOURCE_PATH == "./plugins/t27";
    assert MARKET_FILE == ".grok-plugin/marketplace.json";
    assert MANIFEST_FILE == "plugins/t27/.grok-plugin/plugin.json";
    assert INDEX_FILE == ".grok-plugin/plugin-index.json";
    assert PETAL_COUNT == 27;
    assert HAS_MCP == false;
    assert HAS_HOOKS == false;
}

test keywords_are_brand_scoped {
    assert KEYWORDS.len == 5;
    assert KEYWORDS[0] == "t27";
    assert KEYWORDS[1] == "t27c";
    assert KEYWORDS[2] == "t27b";
    assert KEYWORDS[3] == "golden chain";
    assert KEYWORDS[4] == ".t27";
    assert KEYWORDS[0] != "api";
    assert KEYWORDS[0] != "cli";
    assert KEYWORDS[0] != "database";
}

test domains_are_owned_hosts {
    assert DOMAINS.len == 2;
    assert DOMAINS[0] == "t27.ai";
    assert DOMAINS[1] == "app.t27.ai";
}

test commands_and_skill {
    assert SKILL_DESCRIPTION == "Work in a t27 checkout. Use when the tree has specs or the user names t27, t27c, t27b, or t27.ai.";
    assert COMMANDS.len == 3;
    assert COMMANDS[0] == "t27-check";
    assert COMMANDS[1] == "t27-test";
    assert COMMANDS[2] == "t27-seal";
    assert CMD_CHECK == "Parse and typecheck one .t27 spec with t27c. Use after a spec edit, before tests.";
    assert CMD_TEST == "Run one spec's tests with t27b and t27c test-report. Use when behavior must be shown.";
    assert CMD_SEAL == "Seal one spec with t27c seal --save and --verify. Use after that spec's tests pass.";
}

test negative_control_refutes_wrong_version {
    assert(VERSION != "9.9.9");
    assert(NAME != "not-t27");
    assert(HAS_MCP != true);
}
