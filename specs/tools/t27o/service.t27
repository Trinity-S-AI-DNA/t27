// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/service.t27 -- t27o as a service (#8996, epic #8998): the signed-binary surface a
; foreign repository consumes, entirely inside that repository's own GitHub Actions. Zero LLM tokens,
; zero servers, zero secrets: the user's runner downloads the cosign-signed binaries of a t27o-v* tag,
; verifies them against THIS repository's keyless OIDC identity, and runs the same converter that
; specs/tools/t27o/rust_convert.t27 defines (`tri t27o`, #8967) over the user's own Rust files.
; --
; What is LOGIC and where it lives:
; - What the converter accepts, what it refuses and why, the oracle vectors, the reuse lookup: all in
;   specs/tools/t27o/rust_convert.t27 (and rust_std.t27) -- the binary the user downloads IS that spec.
; - What counts as GOLDEN (behavioural equivalence on N recorded vectors and translated tests, DRY
;   reuse, sealed, attested): issue #8997's lane. This file references it; it does not restate it.
; - The service surface -- the modes, the default selection, the verification identity, the shape of
;   the report every mode emits, the caller's contract: the constants and functions below. The two
;   workflow files (.github/workflows/t27o-release.yml, .github/workflows/t27o-golden.yml) are the
;   plumbing that carries these values; a change here is a change there in the same pull request.
; --
; The honest limit, said in the report and never summarized away (#8998): golden means equivalent on
; the recorded oracle vectors and translated tests, not a proof for all inputs; every body that does
; not qualify appears in the report with its refusal reason, as a comment in the skeleton the
; converter writes (see rust_convert.t27's pipeline, step 1).
; --
; Provenance: the binaries are signed cosign-keyless by the run that builds them, so the certificate
; identity names the building workflow and the t27o-v* tag, and the user's runner refuses anything
; else. A GitHub release created with GITHUB_TOKEN never fires this repository's sign-release.yml
; (GitHub's anti-recursion rule), which is why t27o-release.yml signs in-workflow rather than relying
; on the repo-wide signer.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oService;

/// The three modes of the consuming workflow (.github/workflows/t27o-golden.yml), one word each.
pub const MODE_SCAN : str = "scan$";
pub const MODE_GOLDEN : str = "golden$";
pub const MODE_CHECK : str = "check$";
pub const DEFAULT_MODE : str = "golden$";

/// Which Rust files the service looks at by default: a git pathspec, not a regex.
pub const DEFAULT_PATHSPEC : str = "*.rs$";

/// The tag family a release of the t27o-carrying toolchain (`tri` + `t27c`) is cut from.
pub const TAG_PREFIX : str = "t27o-v$";

/// Keyless verification: the OIDC issuer GitHub Actions mints, and the certificate identity the
/// building workflow must have. cosign verify-blob is fed both, byte for byte.
pub const OIDC_ISSUER : str = "https://token.actions.githubusercontent.com$";
pub const IDENTITY_PREFIX : str = "https://github.com/gHashTag/t27/.github/workflows/t27o-release.yml@refs/tags/t27o-v$";

/// The report every mode writes (the pull-request body in golden mode, the step summary in scan and
/// check mode). Raw converter output is fenced verbatim; nothing is summarized away.
pub const REPORT_TITLE : str = "# t27o $MODE report$";
pub const REPORT_PROVENANCE : str = "- provenance: $RUN_URL$";
pub const REPORT_FENCE : str = "```$";
pub const HONEST_LIMIT : str = "golden means equivalent on the recorded oracle vectors and translated tests, not a proof for all inputs$";

/// Is m one of the three modes?
pub fn mode_valid(m : str) -> bool {
    return m == MODE_SCAN or m == MODE_GOLDEN or m == MODE_CHECK;
}

/// Does the mode open a pull request? golden does; scan reports in place; check fails on drift.
pub fn mode_opens_pr(m : str) -> bool {
    return m == MODE_GOLDEN;
}

/// Does the mode exit non-zero when a committed golden spec no longer matches its source?
pub fn mode_fails_on_drift(m : str) -> bool {
    return m == MODE_CHECK;
}

/// The pull request golden mode opens carries only what the converter wrote under this directory.
pub const SPEC_DIR : str = "specs/t27o_check/$";

test default_mode_is_golden_and_valid {
    assert(mode_valid(DEFAULT_MODE));
    assert(mode_valid(MODE_SCAN));
    assert(mode_valid(MODE_GOLDEN));
    assert(mode_valid(MODE_CHECK));
    assert(!mode_valid("gold"));
    assert(!mode_valid(""));
}

test only_golden_opens_a_pr_and_only_check_fails_on_drift {
    assert(mode_opens_pr(MODE_GOLDEN));
    assert(!mode_opens_pr(MODE_SCAN));
    assert(!mode_opens_pr(MODE_CHECK));
    assert(mode_fails_on_drift(MODE_CHECK));
    assert(!mode_fails_on_drift(MODE_SCAN));
    assert(!mode_fails_on_drift(MODE_GOLDEN));
}

test the_identity_names_the_building_workflow_and_its_tag_family {
    assert(IDENTITY_PREFIX.len == 84);
    assert(OIDC_ISSUER.len == 44);
    assert(IDENTITY_PREFIX[0] == 'h');
    assert(TAG_PREFIX.len == 7);
}

test the_report_says_the_honest_limit_and_fences_raw_output {
    assert(REPORT_FENCE.len == 4);
    assert(REPORT_TITLE.len > 0);
    assert(HONEST_LIMIT.len > 40);
    assert(SPEC_DIR.len == 18);
}
