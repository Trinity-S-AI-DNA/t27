// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/rust_convert.t27 -- t27o (Ouroboros), its Rust front end: a deterministic converter
; from a subset of Rust to t27. t27o eats code written in other languages into .t27 (Rust first; Zig,
; Python and TypeScript front ends can sit beside this one as specs/tools/t27o/<language>_convert.t27).
; Ports were done by hand: bees porting trios crates into specs/port/**, agents porting
; cli/t27b/src/lower.rs into specs/tri/t27b/** (see #6198). This spec does the mechanical part.
; --
; The pipeline, one spec.
; 1. Skeleton. Every item is read; a struct, enum or const that converts is written, and a fn whose
;    body is refused keeps its signature with an empty body (t27's declared, not implemented) and a
;    comment naming the refused construct and its line. The output always compiles: an item that uses
;    a refused one (or a name from another file, or one nobody declares) is refused with it, in passes
;    until no new name is refused, so no converted fn or test reaches a stub.
; 2. Normalisation into the subset: &mut self as a pointer (`self: *T`, calls `T_m(&x)`), for-each over
;    `s` / `s.iter()` / `&s`, `.iter().enumerate()` as an index loop, `if let Some(v) = e` as `e != null`
;    and `e.?`, `*r` of a shared reference as `r`, `let _x = e` as a discard, an unused parameter as
;    `_ = p;`, #[cfg(..)] variants refused whole.
; 3. Oracle: `oracle` writes a Rust harness made of the original text of what converted plus calls on
;    sample and edge inputs; rustc runs it (on the lab) and its output is t27 `test oracle_<fn>` blocks,
;    the behaviour the t27 bodies must reproduce. A Rust #[test] fn becomes a t27 `test` as well.
; --
; The subset.
; - Items: fn with typed parameters and a return type; const and static; structs with named fields;
;   enums with unit variants; inherent impl blocks, whose methods become free functions `Type_method`
;   taking the struct as `self`; `mod` blocks are flattened; `use` is dropped.
; - Types: u8..u128, i8..i128, usize, isize, bool, f32, f64, char (as u32); &str and &[u8] as []const u8,
;   &[T] as []const T, &mut [T] as []T, &T as T, [T; N] as [N]T, Option<T> as ?T, () as void.
; - Statements: let and let mut (const / var), assignment and compound assignment, if / else, while,
;   loop, for over a range or a slice, return, break, continue, match on integers, chars, strings and
;   unit enum variants (an if-chain, its last arm the else), expression statements; the tail expression
;   of a block is its `return` (or the assignment of a typed `let x: T = if ... / match ...`).
; - Expressions: literals, unary and binary operators with Rust's precedence (a parenthesis wherever
;   t27 might read it differently), calls, Type::f(..) as Type_f(..), Enum::V as Enum.V, `as`, field
;   access, indexing and slicing, .len(), .as_bytes(), .is_empty(), .unwrap(), .is_some(), .is_none(),
;   .wrapping_add/sub/mul, method calls on this file's structs, struct and array literals, Some / None,
;   u32::MAX and friends, `==` against a string literal through the helper t27o_eq.
; - Tests: a #[test] fn becomes a `test` block; assert!, assert_eq! and assert_ne! become assert (the
;   message is dropped).
; Refused: generics, trait impls, closures, iterator adaptors, other macros, String / Vec / Box and other
; heap types, the ? operator, tuples, labels, &mut of a scalar, `mut self`, unsafe, and if / match /
; blocks used as a value without a type annotation.
; --
; The caller passes the source, an output buffer and a state vector: STATE slots, then the name table
; (NAME_SLOTS a name, as many as fit). The result is the number of bytes the output needs; the buffer was
; too small when that is above out.len (the bytes past the end are counted, not written). Every byte
; this spec reads or writes is a number, as in specs/tri/t27b/source_text.t27 (#7604): gen-rust reads a
; char literal as a Rust char.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oRust;

// ---------------------------------------------------------------- state

/// The state vector: where the reader is, how much is written, the refusal and the counters.
pub const P : usize = 0;
pub const W : usize = 1;
pub const ERR : usize = 2;
pub const AT : usize = 3;
pub const NLO : usize = 4;
pub const NHI : usize = 5;
pub const IND : usize = 6;
pub const ILO : usize = 7;
pub const IHI : usize = 8;
pub const FLO : usize = 9;
pub const NFN : usize = 10;
pub const NOK : usize = 11;
pub const NTS : usize = 12;
pub const NTEST : usize = 13;
pub const NEQ : usize = 14;
pub const TLO : usize = 15;
pub const THI : usize = 16;
pub const OLO : usize = 17;
pub const OHI : usize = 18;
/// How many names the table holds. The table starts at slot NAMES: NAME_SLOTS slots a name (its text,
/// its owner type, its kind), as many as the caller's state vector has room for.
pub const NNAMES : usize = 19;
/// Refused fns kept as a signature with an empty body (a stub).
pub const NSTUB : usize = 20;
/// What a pass writes: M_T27 the spec, M_SOURCE the Rust source of what converted (the oracle
/// harness's items), M_CALLS the harness's calls.
pub const MODE : usize = 21;
/// 1 while the fn being read takes `&mut self` (its `self` is a pointer).
pub const SELFMUT : usize = 22;
/// The receiver kind of the method method_owner found: 1 self or &self, 2 &mut self.
pub const OKIND : usize = 23;
/// 1 while a `for` header is read (`.iter()` and `.enumerate()` are dropped there), and whether an
/// `.enumerate()` was.
pub const FORHDR : usize = 24;
pub const ENUMSEEN : usize = 25;
/// 1 while a stub's signature is written: its self is `self_` (t27c discards an unused parameter of
/// an empty body, except one named self, and Zig refuses an unused one).
pub const STUBBING : usize = 26;
pub const STATE : usize = 28;
pub const NAMES : usize = 28;
pub const NAME_SLOTS : usize = 5;

pub const M_T27 : usize = 0;
pub const M_SOURCE : usize = 1;
pub const M_CALLS : usize = 2;

/// The kinds of parameter and result the oracle harness samples.
pub const V_NONE : usize = 0;
pub const V_UNSIGNED : usize = 1;
pub const V_SIGNED : usize = 2;
pub const V_BOOL : usize = 3;
pub const V_FLOAT : usize = 4;
pub const V_STR : usize = 5;
pub const V_BYTES : usize = 6;
pub const V_ENUM : usize = 7;

/// What a name of the table is: a refused fn, a refused member of an impl (fn or const, with its
/// type), a refused struct / enum / const / other item, or a name a `use` brings from another file.
pub const K_FN : usize = 1;
pub const K_MEMBER : usize = 2;
pub const K_ITEM : usize = 3;
pub const K_EXT : usize = 4;

/// What the tail expression of a block becomes: a statement, a `return`, or an assignment to the
/// target src[TLO .. THI].
pub const M_STMT : u8 = 0;
pub const M_RET : u8 = 1;
pub const M_SET : u8 = 2;

/// Rust's binary precedence levels, lowest first; L_UNARY and L_ATOM are what a unary or a postfix
/// expression returns.
pub const L_OR : usize = 3;
pub const L_AND : usize = 4;
pub const L_CMP : usize = 5;
pub const L_BOR : usize = 6;
pub const L_XOR : usize = 7;
pub const L_BAND : usize = 8;
pub const L_SHIFT : usize = 9;
pub const L_ADD : usize = 10;
pub const L_MUL : usize = 11;
pub const L_AS : usize = 12;
pub const L_UNARY : usize = 13;
pub const L_ATOM : usize = 99;

/// Why a function or an item is refused.
pub const R_SYNTAX : usize = 1;
pub const R_GENERIC : usize = 2;
pub const R_TRAIT : usize = 3;
pub const R_CLOSURE : usize = 4;
pub const R_TRY : usize = 5;
pub const R_MACRO : usize = 6;
pub const R_TYPE : usize = 7;
pub const R_METHOD : usize = 8;
pub const R_TUPLE : usize = 9;
pub const R_IFLET : usize = 10;
pub const R_ITER : usize = 11;
pub const R_PATTERN : usize = 12;
pub const R_MUTREF : usize = 13;
pub const R_DEREF : usize = 14;
pub const R_VALUE : usize = 15;
pub const R_LITERAL : usize = 16;
pub const R_LABEL : usize = 17;
pub const R_ITEM : usize = 18;
pub const R_UNSAFE : usize = 19;
pub const R_PATH : usize = 20;
pub const R_WHERE : usize = 21;
pub const R_SELFMUT : usize = 22;
pub const R_UPDATE : usize = 23;
pub const R_DATA : usize = 24;
pub const R_DEPENDS : usize = 25;
pub const R_EXTERNAL : usize = 26;
pub const R_UNDECL : usize = 27;

// The bytes the converter reads, as numbers (#7604).
pub const B_TAB : u8 = 9;
pub const B_NL : u8 = 10;
pub const B_CR : u8 = 13;
pub const B_SPACE : u8 = 32;
pub const B_BANG : u8 = 33;
pub const B_QUOTE : u8 = 34;
pub const B_HASH : u8 = 35;
pub const B_PCT : u8 = 37;
pub const B_AMP : u8 = 38;
pub const B_APOS : u8 = 39;
pub const B_LPAREN : u8 = 40;
pub const B_RPAREN : u8 = 41;
pub const B_STAR : u8 = 42;
pub const B_PLUS : u8 = 43;
pub const B_COMMA : u8 = 44;
pub const B_MINUS : u8 = 45;
pub const B_DOT : u8 = 46;
pub const B_SLASH : u8 = 47;
pub const B_ZERO : u8 = 48;
pub const B_NINE : u8 = 57;
pub const B_COLON : u8 = 58;
pub const B_SEMI : u8 = 59;
pub const B_LT : u8 = 60;
pub const B_EQ : u8 = 61;
pub const B_GT : u8 = 62;
pub const B_UPPER_A : u8 = 65;
pub const B_UPPER_E : u8 = 69;
pub const B_UPPER_Z : u8 = 90;
pub const B_LBRACKET : u8 = 91;
pub const B_BACKSLASH : u8 = 92;
pub const B_RBRACKET : u8 = 93;
pub const B_CARET : u8 = 94;
pub const B_UNDERSCORE : u8 = 95;
pub const B_LOWER_A : u8 = 97;
pub const B_LOWER_B : u8 = 98;
pub const B_LOWER_E : u8 = 101;
pub const B_LOWER_F : u8 = 102;
pub const B_LOWER_N : u8 = 110;
pub const B_LOWER_O : u8 = 111;
pub const B_LOWER_R : u8 = 114;
pub const B_LOWER_T : u8 = 116;
pub const B_LOWER_U : u8 = 117;
pub const B_LOWER_X : u8 = 120;
pub const B_LOWER_Z : u8 = 122;
pub const B_LBRACE : u8 = 123;
pub const B_PIPE : u8 = 124;
pub const B_RBRACE : u8 = 125;
pub const B_DEL : u8 = 127;

// ---------------------------------------------------------------- bytes

pub fn is_space(c: u8) -> bool {
    return c == B_SPACE or c == B_TAB or c == B_NL or c == B_CR;
}

pub fn is_upper(c: u8) -> bool {
    return c >= B_UPPER_A and c <= B_UPPER_Z;
}

pub fn is_alpha(c: u8) -> bool {
    return (c >= B_LOWER_A and c <= B_LOWER_Z) or is_upper(c) or c == B_UNDERSCORE;
}

pub fn is_digit(c: u8) -> bool {
    return c >= B_ZERO and c <= B_NINE;
}

pub fn is_word(c: u8) -> bool {
    return is_alpha(c) or is_digit(c);
}

pub fn is_open(c: u8) -> bool {
    return c == B_LPAREN or c == B_LBRACKET or c == B_LBRACE;
}

pub fn is_close(c: u8) -> bool {
    return c == B_RPAREN or c == B_RBRACKET or c == B_RBRACE;
}

/// The value of a hex digit, 0 for any other byte.
pub fn hex_value(c: u8) -> usize {
    if (is_digit(c)) { return (c - B_ZERO) as usize; }
    if (c >= B_LOWER_A and c <= B_LOWER_F) { return (c - B_LOWER_A + 10) as usize; }
    if (c >= B_UPPER_A and c <= B_UPPER_A + 5) { return (c - B_UPPER_A + 10) as usize; }
    return 0;
}

// ---------------------------------------------------------------- tokens

/// The next token at or after `from`: spaces, `//` comments and nested `/* */` comments skipped.
pub fn skip_ws(src: []const u8, from: usize) -> usize {
    var p : usize = from;
    while (p < src.len) {
        const c : u8 = src[p];
        if (is_space(c)) {
            p = p + 1;
        } else if (c == B_SLASH and p + 1 < src.len and src[p + 1] == B_SLASH) {
            while (p < src.len and src[p] != B_NL) { p = p + 1; }
        } else if (c == B_SLASH and p + 1 < src.len and src[p + 1] == B_STAR) {
            var depth : usize = 1;
            p = p + 2;
            while (p < src.len and depth > 0) {
                if (src[p] == B_STAR and p + 1 < src.len and src[p + 1] == B_SLASH) {
                    depth = depth - 1;
                    p = p + 2;
                } else if (src[p] == B_SLASH and p + 1 < src.len and src[p + 1] == B_STAR) {
                    depth = depth + 1;
                    p = p + 2;
                } else {
                    p = p + 1;
                }
            }
        } else {
            return p;
        }
    }
    return p;
}

/// The end of a quoted literal whose opening quote is src[q]: past the matching quote, escapes skipped.
pub fn quoted_end(src: []const u8, q: usize) -> usize {
    const quote : u8 = src[q];
    var p : usize = q + 1;
    while (p < src.len) {
        if (src[p] == B_BACKSLASH) {
            p = p + 2;
        } else if (src[p] == quote) {
            return p + 1;
        } else {
            p = p + 1;
        }
    }
    return src.len;
}

/// The end of a raw string r"..." or r#"..."# that starts at src[r].
pub fn raw_end(src: []const u8, r: usize) -> usize {
    var p : usize = r + 1;
    var hashes : usize = 0;
    while (p < src.len and src[p] == B_HASH) {
        hashes = hashes + 1;
        p = p + 1;
    }
    if (p >= src.len or src[p] != B_QUOTE) { return r + 1; }
    p += 1;
    while (p < src.len) {
        if (src[p] == B_QUOTE) {
            var k : usize = 0;
            while (k < hashes and p + 1 + k < src.len and src[p + 1 + k] == B_HASH) { k = k + 1; }
            if (k == hashes) { return p + 1 + hashes; }
        }
        p = p + 1;
    }
    return src.len;
}

/// The end of a number literal at src[p]: digits, `_`, a fraction, an exponent and a type suffix.
pub fn num_end(src: []const u8, p: usize) -> usize {
    var e : usize = p + 1;
    if (src[p] == B_ZERO and e < src.len and (src[e] == B_LOWER_X or src[e] == B_LOWER_O or src[e] == B_LOWER_B)) {
        e = e + 1;
        while (e < src.len and is_word(src[e])) { e = e + 1; }
        return e;
    }
    while (e < src.len and (is_digit(src[e]) or src[e] == B_UNDERSCORE)) { e = e + 1; }
    if (e + 1 < src.len and src[e] == B_DOT and is_digit(src[e + 1])) {
        e = e + 1;
        while (e < src.len and (is_digit(src[e]) or src[e] == B_UNDERSCORE)) { e = e + 1; }
    }
    if (e < src.len and (src[e] == B_LOWER_E or src[e] == B_UPPER_E)) {
        var x : usize = e + 1;
        if (x < src.len and (src[x] == B_PLUS or src[x] == B_MINUS)) { x = x + 1; }
        if (x < src.len and is_digit(src[x])) {
            e = x;
            while (e < src.len and (is_digit(src[e]) or src[e] == B_UNDERSCORE)) { e = e + 1; }
        }
    }
    while (e < src.len and is_word(src[e])) { e = e + 1; }
    return e;
}

/// Is src[p .. p + 2] an operator of two bytes?
pub fn op2(src: []const u8, p: usize) -> bool {
    const a : u8 = src[p];
    const b : u8 = src[p + 1];
    if (b == B_EQ) {
        return a == B_EQ or a == B_BANG or a == B_LT or a == B_GT or a == B_PLUS or a == B_MINUS or a == B_STAR or a == B_SLASH or a == B_PCT or a == B_CARET or a == B_AMP or a == B_PIPE;
    }
    if (a == B_COLON and b == B_COLON) { return true; }
    if ((a == B_MINUS or a == B_EQ) and b == B_GT) { return true; }
    if (a == b and (a == B_AMP or a == B_PIPE or a == B_LT or a == B_GT or a == B_DOT)) { return true; }
    return false;
}

/// Is src[p .. p + 3] an operator of three bytes (`<<=`, `>>=`, `..=`, `...`)?
pub fn op3(src: []const u8, p: usize) -> bool {
    const a : u8 = src[p];
    const b : u8 = src[p + 1];
    const c : u8 = src[p + 2];
    if ((a == B_LT or a == B_GT) and b == a and c == B_EQ) { return true; }
    return a == B_DOT and b == B_DOT and (c == B_EQ or c == B_DOT);
}

/// The end of the token that starts at src[p].
pub fn tok_end(src: []const u8, p: usize) -> usize {
    if (p >= src.len) { return p; }
    const c : u8 = src[p];
    if (c == B_LOWER_B and p + 1 < src.len and (src[p + 1] == B_QUOTE or src[p + 1] == B_APOS)) { return quoted_end(src, p + 1); }
    if (c == B_LOWER_R and p + 1 < src.len and (src[p + 1] == B_QUOTE or src[p + 1] == B_HASH)) { return raw_end(src, p); }
    if (is_alpha(c)) {
        var e : usize = p + 1;
        while (e < src.len and is_word(src[e])) { e = e + 1; }
        return e;
    }
    if (is_digit(c)) { return num_end(src, p); }
    if (c == B_QUOTE) { return quoted_end(src, p); }
    if (c == B_APOS) {
        if (p + 1 < src.len and src[p + 1] == B_BACKSLASH) { return quoted_end(src, p); }
        if (p + 2 < src.len and src[p + 2] == B_APOS) { return p + 3; }
        var e : usize = p + 1;
        while (e < src.len and is_word(src[e])) { e = e + 1; }
        return e;
    }
    if (p + 2 < src.len and op3(src, p)) { return p + 3; }
    if (p + 1 < src.len and op2(src, p)) { return p + 2; }
    return p + 1;
}

/// Is src[a .. b] the text `s`?
pub fn word_is(src: []const u8, a: usize, b: usize, s: []const u8) -> bool {
    if (b < a or b - a != s.len) { return false; }
    var k : usize = 0;
    while (k < s.len) {
        if (src[a + k] != s[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Are src[q .. e] and the bytes of src from `a` the same?
pub fn same_at(src: []const u8, q: usize, e: usize, a: usize) -> bool {
    var k : usize = 0;
    while (q + k < e) {
        if (a + k >= src.len or src[q + k] != src[a + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is the token at src[q] the text `s`?
pub fn tok_is(src: []const u8, q: usize, s: []const u8) -> bool {
    return word_is(src, q, tok_end(src, q), s);
}

/// The line (1-based) of byte `pos`.
pub fn line_of(src: []const u8, pos: usize) -> usize {
    var n : usize = 1;
    var i : usize = 0;
    while (i < pos and i < src.len) {
        if (src[i] == B_NL) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// Where the bracket that opens at src[o] closes: past its match, every bracket kind counted.
pub fn block_end(src: []const u8, o: usize) -> usize {
    var depth : usize = 0;
    var q : usize = o;
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (e == q + 1 and is_open(src[q])) { depth = depth + 1; }
        if (e == q + 1 and is_close(src[q])) {
            if (depth <= 1) { return e; }
            depth = depth - 1;
        }
        q = skip_ws(src, e);
    }
    return src.len;
}

/// The single-byte token `c` at bracket depth 0 from `from`, before any unmatched closer; src.len when
/// there is none.
pub fn find_at(src: []const u8, from: usize, c: u8) -> usize {
    var depth : usize = 0;
    var q : usize = from;
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (e == q + 1) {
            if (src[q] == c and depth == 0) { return q; }
            if (is_open(src[q])) { depth = depth + 1; }
            if (is_close(src[q])) {
                if (depth == 0) { return src.len; }
                depth = depth - 1;
            }
        }
        q = skip_ws(src, e);
    }
    return src.len;
}

/// The token `s` at bracket depth 0 from `from`, before any unmatched closer; src.len when none.
pub fn find_tok(src: []const u8, from: usize, s: []const u8) -> usize {
    var depth : usize = 0;
    var q : usize = from;
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (depth == 0 and word_is(src, q, e, s)) { return q; }
        if (e == q + 1 and is_open(src[q])) { depth = depth + 1; }
        if (e == q + 1 and is_close(src[q])) {
            if (depth == 0) { return src.len; }
            depth = depth - 1;
        }
        q = skip_ws(src, e);
    }
    return src.len;
}

/// Where the text of the item that starts at src[start] ends: just past the `}` of its body, or past
/// its `;` for use, const, static and type items. Stops before a closer of an enclosing block.
pub fn item_end(src: []const u8, start: usize) -> usize {
    var depth : usize = 0;
    var semi : bool = false;
    var q : usize = start;
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (depth == 0 and (word_is(src, q, e, "use") or word_is(src, q, e, "static") or word_is(src, q, e, "type"))) { semi = true; }
        if (depth == 0 and word_is(src, q, e, "const") and !tok_is(src, skip_ws(src, e), "fn")) { semi = true; }
        if (e == q + 1) {
            const c : u8 = src[q];
            if (is_open(c)) { depth = depth + 1; }
            if (is_close(c)) {
                if (depth == 0) { return q; }
                depth = depth - 1;
                if (depth == 0 and c == B_RBRACE and !semi) { return e; }
            }
            if (c == B_SEMI and depth == 0) { return e; }
        }
        q = skip_ws(src, e);
    }
    return src.len;
}

/// The next token after the item that starts at src[start].
pub fn skip_item(src: []const u8, start: usize) -> usize {
    return skip_ws(src, item_end(src, start));
}

/// Is the statement at src[p] the last one of its block with no `;` after it (the block's value)?
pub fn is_tail(src: []const u8, p: usize) -> bool {
    const e0 : usize = tok_end(src, p);
    const blocky : bool = word_is(src, p, e0, "if") or word_is(src, p, e0, "match") or word_is(src, p, e0, "while") or word_is(src, p, e0, "loop") or word_is(src, p, e0, "for") or word_is(src, p, e0, "unsafe");
    var depth : usize = 0;
    var q : usize = p;
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (e == q + 1) {
            const c : u8 = src[q];
            if (is_open(c)) { depth = depth + 1; }
            if (is_close(c)) {
                if (depth == 0) { return true; }
                depth = depth - 1;
                if (depth == 0 and c == B_RBRACE and blocky) {
                    const n : usize = skip_ws(src, e);
                    if (!tok_is(src, n, "else")) { return n < src.len and src[n] == B_RBRACE; }
                }
            }
            if (c == B_SEMI and depth == 0) { return false; }
        }
        q = skip_ws(src, e);
    }
    return false;
}

/// Where the arm of a match that starts at src[p] ends: past its body and the comma after it.
pub fn skip_arm(src: []const u8, p: usize) -> usize {
    const arrow : usize = find_tok(src, p, "=>");
    if (arrow >= src.len) { return src.len; }
    const b : usize = skip_ws(src, tok_end(src, arrow));
    var q : usize = b;
    if (b < src.len and src[b] == B_LBRACE) {
        q = skip_ws(src, block_end(src, b));
    } else {
        q = find_at(src, b, B_COMMA);
        if (q >= src.len) { q = find_at(src, b, B_RBRACE); }
        if (q >= src.len) { return src.len; }
    }
    if (q < src.len and src[q] == B_COMMA) { q = skip_ws(src, q + 1); }
    return q;
}

/// How many `fn <name>` items src[lo .. hi] holds.
pub fn count_fns(src: []const u8, lo: usize, hi: usize) -> usize {
    var n : usize = 0;
    var q : usize = lo;
    while (q < hi) {
        const e : usize = tok_end(src, q);
        if (word_is(src, q, e, "fn")) {
            const k : usize = skip_ws(src, e);
            if (k < src.len and is_alpha(src[k])) { n = n + 1; }
        }
        q = skip_ws(src, e);
    }
    return n;
}

// ---------------------------------------------------------------- the reader's position

// The readers below take st[P] (the position), st[ERR] or st[W] by value: gen-rust lowers a slice
// parameter a fn only reads to a Vec, which a caller holding `&mut [usize]` cannot pass.

/// Was something refused (`e` is st[ERR])?
pub fn bad(e: usize) -> bool {
    return e != 0;
}

/// Is there more to read and nothing refused (`p` is st[P], `e` st[ERR])?
pub fn live(src: []const u8, p: usize, e: usize) -> bool {
    return e == 0 and p < src.len;
}

/// The first byte of the token at `p`, 0 at the end.
pub fn head(src: []const u8, p: usize) -> u8 {
    if (p >= src.len) { return 0; }
    return src[p];
}

pub fn at(src: []const u8, p: usize, s: []const u8) -> bool {
    return tok_is(src, p, s);
}

/// Is the token after the one at `p` the text `s`?
pub fn peek_is(src: []const u8, p: usize, s: []const u8) -> bool {
    return tok_is(src, skip_ws(src, tok_end(src, p)), s);
}

pub fn step(src: []const u8, st: []usize) -> void {
    st[P] = skip_ws(src, tok_end(src, st[P]));
}

pub fn take(src: []const u8, st: []usize, s: []const u8) -> bool {
    if (at(src, st[P], s)) {
        step(src, st);
        return true;
    }
    return false;
}

/// Record the first refusal: its reason, where, and the source text it names.
pub fn refuse(st: []usize, code: usize, pos: usize, lo: usize, hi: usize) -> void {
    if (st[ERR] == 0) {
        st[ERR] = code;
        st[AT] = pos;
        st[NLO] = lo;
        st[NHI] = hi;
    }
}

/// Refuse at the current token.
pub fn refuse_here(src: []const u8, st: []usize, code: usize) -> void {
    refuse(st, code, st[P], st[P], tok_end(src, st[P]));
}

pub fn want(src: []const u8, st: []usize, s: []const u8) -> void {
    if (!take(src, st, s)) { refuse_here(src, st, R_SYNTAX); }
}

// ---------------------------------------------------------------- the name table

/// Are src[a .. b] and src[c .. d] the same text?
pub fn same_text(src: []const u8, a: usize, b: usize, c: usize, d: usize) -> bool {
    if (b < a or d < c or b - a != d - c) { return false; }
    return same_at(src, a, b, c);
}

/// Add a name to the table once; a full table drops it.
pub fn add_name(src: []const u8, st: []usize, kind: usize, lo: usize, hi: usize, olo: usize, ohi: usize) -> void {
    if (hi <= lo) { return; }
    var k : usize = 0;
    while (k < st[NNAMES]) {
        const s : usize = NAMES + k * NAME_SLOTS;
        if (st[s + 4] == kind and same_text(src, st[s], st[s + 1], lo, hi) and same_text(src, st[s + 2], st[s + 3], olo, ohi)) { return; }
        k = k + 1;
    }
    const e : usize = NAMES + st[NNAMES] * NAME_SLOTS;
    if (e + NAME_SLOTS > st.len) { return; }
    st[e] = lo;
    st[e + 1] = hi;
    st[e + 2] = olo;
    st[e + 3] = ohi;
    st[e + 4] = kind;
    st[NNAMES] = st[NNAMES] + 1;
}

/// Each `fn <name>` in src[lo .. hi] as a refused member of the type src[olo .. ohi].
pub fn record_fns(src: []const u8, st: []usize, lo: usize, hi: usize, olo: usize, ohi: usize) -> void {
    var q : usize = lo;
    while (q < hi) {
        const e : usize = tok_end(src, q);
        if (word_is(src, q, e, "fn")) {
            const n : usize = skip_ws(src, e);
            if (n < src.len and is_alpha(src[n])) { add_name(src, st, K_MEMBER, n, tok_end(src, n), olo, ohi); }
        }
        q = skip_ws(src, e);
    }
}

/// The names a `use` item brings from another file (its leaves, an `as` alias for its name); nothing
/// for `use super::...` and `use self::...`, which stay in this file.
pub fn use_names(src: []const u8, st: []usize, u: usize, end: usize) -> void {
    var q : usize = skip_ws(src, tok_end(src, u));
    if (tok_is(src, q, "::")) { q = skip_ws(src, tok_end(src, q)); }
    if (tok_is(src, q, "super") or tok_is(src, q, "self")) { return; }
    while (q < end) {
        const e : usize = tok_end(src, q);
        const nx : usize = skip_ws(src, e);
        if (is_alpha(src[q]) and !word_is(src, q, e, "self") and !word_is(src, q, e, "crate") and !word_is(src, q, e, "as") and (tok_is(src, nx, ",") or tok_is(src, nx, "}") or tok_is(src, nx, ";"))) {
            add_name(src, st, K_EXT, q, e, 0, 0);
        }
        q = nx;
    }
}

/// Is there a `fn <name>` anywhere in the file?
pub fn declared_fn(src: []const u8, a: usize, b: usize) -> bool {
    var q : usize = skip_ws(src, 0);
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (word_is(src, q, e, "fn")) {
            const n : usize = skip_ws(src, e);
            if (same_text(src, n, tok_end(src, n), a, b)) { return true; }
        }
        q = skip_ws(src, e);
    }
    return false;
}

/// Is the capitalized name src[a .. b] declared in the file (struct, enum, type, trait, union, const,
/// static), or one Rust always has (Self, Option, Some, None)?
pub fn declared_type(src: []const u8, a: usize, b: usize) -> bool {
    if (word_is(src, a, b, "Self") or word_is(src, a, b, "Option") or word_is(src, a, b, "Some") or word_is(src, a, b, "None")) { return true; }
    var q : usize = skip_ws(src, 0);
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (word_is(src, q, e, "struct") or word_is(src, q, e, "enum") or word_is(src, q, e, "type") or word_is(src, q, e, "trait") or word_is(src, q, e, "union") or word_is(src, q, e, "const") or word_is(src, q, e, "static")) {
            const n : usize = skip_ws(src, e);
            if (same_text(src, n, tok_end(src, n), a, b)) { return true; }
        }
        q = skip_ws(src, e);
    }
    return false;
}

/// A Rust keyword that may stand before `(`.
pub fn call_keyword(src: []const u8, a: usize, b: usize) -> bool {
    return word_is(src, a, b, "if") or word_is(src, a, b, "while") or word_is(src, a, b, "match") or word_is(src, a, b, "return") or word_is(src, a, b, "in") or word_is(src, a, b, "as") or word_is(src, a, b, "let") or word_is(src, a, b, "mut") or word_is(src, a, b, "move") or word_is(src, a, b, "ref") or word_is(src, a, b, "break") or word_is(src, a, b, "continue") or word_is(src, a, b, "where") or word_is(src, a, b, "for");
}

/// Refuse the item src[lo .. hi] when it uses a name of the table (a refused item, or one from
/// another file) or calls a fn this file does not declare: its output would not compile.
pub fn deps(src: []const u8, st: []usize, lo: usize, hi: usize) -> void {
    // a member of an impl whose type is refused (its `Self`) is refused with it
    var k0 : usize = 0;
    while (st[ILO] != st[IHI] and k0 < st[NNAMES] and st[ERR] == 0) {
        const s0 : usize = NAMES + k0 * NAME_SLOTS;
        if ((st[s0 + 4] == K_ITEM or st[s0 + 4] == K_EXT) and same_text(src, st[s0], st[s0 + 1], st[ILO], st[IHI])) {
            refuse(st, R_DEPENDS, st[ILO], st[ILO], st[IHI]);
        }
        k0 = k0 + 1;
    }
    if (st[ILO] != st[IHI] and st[ERR] == 0 and !declared_type(src, st[ILO], st[IHI])) { refuse(st, R_UNDECL, st[ILO], st[ILO], st[IHI]); }
    var p0 : usize = src.len;
    var p1 : usize = src.len;
    var q : usize = lo;
    while (q < hi and st[ERR] == 0) {
        const e : usize = tok_end(src, q);
        if (is_alpha(src[q])) {
            const nx : usize = skip_ws(src, e);
            const call : bool = tok_is(src, nx, "(");
            const after_dot : bool = tok_is(src, p0, ".");
            const after_path : bool = tok_is(src, p0, "::");
            // the name a declaration declares is no use of it
            const after_fn : bool = tok_is(src, p0, "fn") or tok_is(src, p0, "struct") or tok_is(src, p0, "enum") or tok_is(src, p0, "const") or tok_is(src, p0, "static") or tok_is(src, p0, "type") or tok_is(src, p0, "trait");
            var k : usize = 0;
            while (k < st[NNAMES] and st[ERR] == 0) {
                const s : usize = NAMES + k * NAME_SLOTS;
                if (same_text(src, st[s], st[s + 1], q, e)) {
                    const kind : usize = st[s + 4];
                    var hit : bool = false;
                    if (kind == K_FN) { hit = call and !after_dot and !after_path and !after_fn; }
                    if (kind == K_MEMBER and after_dot and call) { hit = true; }
                    if (kind == K_MEMBER and after_path and p1 < src.len) {
                        hit = same_text(src, st[s + 2], st[s + 3], p1, tok_end(src, p1)) or tok_is(src, p1, "Self");
                    }
                    if (kind == K_ITEM or kind == K_EXT) { hit = !after_dot and !after_path and !after_fn and !tok_is(src, nx, ":"); }
                    if (hit and kind == K_EXT) { refuse(st, R_EXTERNAL, q, q, e); }
                    if (hit and kind != K_EXT) { refuse(st, R_DEPENDS, q, q, e); }
                }
                k = k + 1;
            }
            if (st[ERR] == 0 and call and !after_dot and !after_path and !after_fn and !is_upper(src[q]) and !call_keyword(src, q, e) and !declared_fn(src, q, e)) {
                refuse(st, R_UNDECL, q, q, e);
            }
            // a capitalized name nobody here declares came through a glob `use` or from another file
            if (st[ERR] == 0 and is_upper(src[q]) and !after_dot and !after_path and !prim(src, q, e) and !declared_type(src, q, e)) {
                refuse(st, R_UNDECL, q, q, e);
            }
        }
        p1 = p0;
        p0 = q;
        q = skip_ws(src, e);
    }
}

// ---------------------------------------------------------------- output

/// Write one byte if it fits; the count goes on past the end.
pub fn put(st: []usize, out: []u8, c: u8) -> void {
    const w : usize = st[W];
    if (w < out.len) { out[w] = c; }
    st[W] = w + 1;
}

pub fn puts(st: []usize, out: []u8, s: []const u8) -> void {
    var i : usize = 0;
    while (i < s.len) {
        put(st, out, s[i]);
        i = i + 1;
    }
}

pub fn put_src(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    var i : usize = a;
    while (i < b and i < src.len) {
        put(st, out, src[i]);
        i = i + 1;
    }
}

/// Source text for a comment, at most `max` bytes: a UTF-8 char or a control byte as one `?` (L3).
pub fn put_text(src: []const u8, st: []usize, out: []u8, a: usize, b: usize, max: usize) -> void {
    var i : usize = a;
    while (i < b and i < src.len and i < a + max) {
        const c : u8 = src[i];
        if (c >= B_SPACE and c < B_DEL) {
            put(st, out, c);
        } else if (c < 128 or c >= 192) {
            put(st, out, 63);
        }
        i = i + 1;
    }
}

pub fn put_num(st: []usize, out: []u8, v: usize) -> void {
    if (v >= 10) { put_num(st, out, v / 10); }
    put(st, out, B_ZERO + (v % 10) as u8);
}

/// A newline and the indentation of the current depth.
pub fn newline(st: []usize, out: []u8) -> void {
    put(st, out, B_NL);
    var k : usize = 0;
    while (k < st[IND]) {
        puts(st, out, "    ");
        k = k + 1;
    }
}

/// The byte written at out[i], 0 when there is none (`w` is st[W]).
pub fn out_at(w: usize, out: []const u8, i: usize) -> u8 {
    if (i < w and i < out.len) { return out[i]; }
    return 0;
}

/// Does what was written from `from` on hold the byte `c` (`w` is st[W])?
pub fn out_has(w: usize, out: []const u8, from: usize, c: u8) -> bool {
    var i : usize = from;
    while (i < w and i < out.len) {
        if (out[i] == c) { return true; }
        i = i + 1;
    }
    return false;
}

/// Is what was written from `from` on exactly `s` (`w` is st[W])?
pub fn out_is(w: usize, out: []const u8, from: usize, s: []const u8) -> bool {
    if (w < from or w - from != s.len or w > out.len) { return false; }
    var k : usize = 0;
    while (k < s.len) {
        if (out[from + k] != s[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Make room for n bytes at out[pos], moving what was written after it.
pub fn open_gap(st: []usize, out: []u8, pos: usize, n: usize) -> bool {
    const w : usize = st[W];
    const grown : usize = w + n;
    st[W] = grown;
    if (grown > out.len) { return false; }
    var i : usize = w;
    while (i > pos) {
        i = i - 1;
        out[i + n] = out[i];
    }
    return true;
}

/// Insert `s` at out[pos].
pub fn insert(st: []usize, out: []u8, pos: usize, s: []const u8) -> void {
    if (open_gap(st, out, pos, s.len)) {
        var k : usize = 0;
        while (k < s.len) {
            out[pos + k] = s[k];
            k = k + 1;
        }
    }
}

/// Insert src[a .. b] at out[pos].
pub fn insert_src(src: []const u8, st: []usize, out: []u8, pos: usize, a: usize, b: usize) -> void {
    if (open_gap(st, out, pos, b - a)) {
        var k : usize = 0;
        while (a + k < b) {
            out[pos + k] = src[a + k];
            k = k + 1;
        }
    }
}

/// Parenthesize what was written from `from` on.
pub fn wrap(st: []usize, out: []u8, from: usize) -> void {
    insert(st, out, from, "(");
    puts(st, out, ")");
}

/// A name t27 reserves; the converter writes it with a trailing `_`.
pub fn reserved(src: []const u8, a: usize, b: usize) -> bool {
    return word_is(src, a, b, "and") or word_is(src, a, b, "or") or word_is(src, a, b, "test") or word_is(src, a, b, "var") or word_is(src, a, b, "error") or word_is(src, a, b, "null") or word_is(src, a, b, "undefined") or word_is(src, a, b, "switch") or word_is(src, a, b, "orelse") or word_is(src, a, b, "try") or word_is(src, a, b, "defer") or word_is(src, a, b, "comptime") or word_is(src, a, b, "module") or word_is(src, a, b, "invariant") or word_is(src, a, b, "bench") or word_is(src, a, b, "catch") or word_is(src, a, b, "unreachable") or word_is(src, a, b, "anytype") or word_is(src, a, b, "opaque") or word_is(src, a, b, "packed") or word_is(src, a, b, "export") or word_is(src, a, b, "inline") or word_is(src, a, b, "align") or word_is(src, a, b, "noreturn") or word_is(src, a, b, "errdefer") or word_is(src, a, b, "spec") or word_is(src, a, b, "void");
}

pub fn put_ident(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    put_src(src, st, out, a, b);
    if (reserved(src, a, b)) { puts(st, out, "_"); }
}

/// Insert the identifier src[a .. b] at out[pos], renamed as put_ident renames it.
pub fn insert_ident(src: []const u8, st: []usize, out: []u8, pos: usize, a: usize, b: usize) -> void {
    if (reserved(src, a, b)) { insert(st, out, pos, "_"); }
    insert_src(src, st, out, pos, a, b);
}

/// The name of the impl block being read.
pub fn put_impl(src: []const u8, st: []usize, out: []u8) -> void {
    put_src(src, st, out, st[ILO], st[IHI]);
}

/// A type or path segment src[a .. b], `Self` read as the impl's type.
pub fn put_owner(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    if (word_is(src, a, b, "Self")) {
        if (st[ILO] == st[IHI]) { refuse(st, R_PATH, a, a, b); }
        put_impl(src, st, out);
    } else {
        put_ident(src, st, out, a, b);
    }
}

// ---------------------------------------------------------------- types

/// One of the primitive scalar types t27 spells the same way.
pub fn prim(src: []const u8, a: usize, b: usize) -> bool {
    return int_type(src, a, b) or word_is(src, a, b, "usize") or word_is(src, a, b, "bool") or word_is(src, a, b, "f32") or word_is(src, a, b, "f64");
}

/// An integer type other than usize.
pub fn int_type(src: []const u8, a: usize, b: usize) -> bool {
    return word_is(src, a, b, "u8") or word_is(src, a, b, "u16") or word_is(src, a, b, "u32") or word_is(src, a, b, "u64") or word_is(src, a, b, "u128") or word_is(src, a, b, "i8") or word_is(src, a, b, "i16") or word_is(src, a, b, "i32") or word_is(src, a, b, "i64") or word_is(src, a, b, "i128") or word_is(src, a, b, "isize");
}

/// A Rust type that owns heap memory, or an std type t27 has no counterpart for.
pub fn heap_type(src: []const u8, a: usize, b: usize) -> bool {
    return word_is(src, a, b, "String") or word_is(src, a, b, "Vec") or word_is(src, a, b, "Box") or word_is(src, a, b, "Rc") or word_is(src, a, b, "Arc") or word_is(src, a, b, "HashMap") or word_is(src, a, b, "HashSet") or word_is(src, a, b, "BTreeMap") or word_is(src, a, b, "BTreeSet") or word_is(src, a, b, "VecDeque") or word_is(src, a, b, "RefCell") or word_is(src, a, b, "Cell") or word_is(src, a, b, "Result") or word_is(src, a, b, "PathBuf") or word_is(src, a, b, "Path") or word_is(src, a, b, "str") or word_is(src, a, b, "impl") or word_is(src, a, b, "dyn") or word_is(src, a, b, "fn");
}

/// Close a generic argument list; `>>` closes two.
pub fn close_angle(src: []const u8, st: []usize) -> void {
    if (take(src, st, ">")) { return; }
    if (at(src, st[P], ">>") or at(src, st[P], ">=") or at(src, st[P], ">>=")) {
        st[P] = st[P] + 1;
        return;
    }
    refuse_here(src, st, R_SYNTAX);
}

/// One type, written as t27.
pub fn ty(src: []const u8, st: []usize, out: []u8) -> void {
    if (bad(st[ERR])) { return; }
    if (take(src, st, "&") or take(src, st, "&&")) {
        if (head(src, st[P]) == B_APOS) { step(src, st); }
        const m : bool = take(src, st, "mut");
        if (at(src, st[P], "str")) {
            if (m) { refuse_here(src, st, R_MUTREF); }
            step(src, st);
            puts(st, out, "[]const u8");
            return;
        }
        if (at(src, st[P], "[")) {
            step(src, st);
            if (m) { puts(st, out, "[]"); } else { puts(st, out, "[]const "); }
            ty(src, st, out);
            if (take(src, st, ";")) {
                const close : usize = find_at(src, st[P], B_RBRACKET);
                if (close < src.len) { st[P] = close; }
            }
            want(src, st, "]");
            return;
        }
        if (m and heap_type(src, st[P], tok_end(src, st[P]))) {
            refuse_here(src, st, R_TYPE);
            return;
        }
        if (m) {
            refuse_here(src, st, R_MUTREF);
            return;
        }
        ty(src, st, out);
        return;
    }
    if (at(src, st[P], "[")) {
        const elem : usize = skip_ws(src, st[P] + 1);
        const semi : usize = find_at(src, elem, B_SEMI);
        if (semi >= src.len) {
            refuse_here(src, st, R_TYPE);
            return;
        }
        st[P] = skip_ws(src, semi + 1);
        puts(st, out, "[");
        expr(src, st, out, false);
        puts(st, out, "]");
        if (!at(src, st[P], "]")) {
            refuse_here(src, st, R_SYNTAX);
            return;
        }
        const after : usize = skip_ws(src, tok_end(src, st[P]));
        st[P] = elem;
        ty(src, st, out);
        st[P] = after;
        return;
    }
    if (at(src, st[P], "(")) {
        step(src, st);
        if (take(src, st, ")")) {
            puts(st, out, "void");
            return;
        }
        refuse_here(src, st, R_TUPLE);
        return;
    }
    const a : usize = st[P];
    const b : usize = tok_end(src, a);
    if (!is_alpha(head(src, st[P]))) {
        refuse_here(src, st, R_SYNTAX);
        return;
    }
    step(src, st);
    if (prim(src, a, b)) {
        put_src(src, st, out, a, b);
        return;
    }
    if (word_is(src, a, b, "char")) {
        puts(st, out, "u32");
        return;
    }
    if (word_is(src, a, b, "Option") and at(src, st[P], "<")) {
        step(src, st);
        puts(st, out, "?");
        ty(src, st, out);
        close_angle(src, st);
        return;
    }
    if (heap_type(src, a, b) or at(src, st[P], "<") or at(src, st[P], "::")) {
        refuse(st, R_TYPE, a, a, b);
        return;
    }
    put_owner(src, st, out, a, b);
}

// ---------------------------------------------------------------- expressions

/// The precedence level of the binary operator src[a .. b], 0 when it is none.
pub fn op_level(src: []const u8, a: usize, b: usize) -> usize {
    if (b == a + 1) {
        const c : u8 = src[a];
        if (c == B_LT or c == B_GT) { return L_CMP; }
        if (c == B_PIPE) { return L_BOR; }
        if (c == B_CARET) { return L_XOR; }
        if (c == B_AMP) { return L_BAND; }
        if (c == B_PLUS or c == B_MINUS) { return L_ADD; }
        if (c == B_STAR or c == B_SLASH or c == B_PCT) { return L_MUL; }
        return 0;
    }
    if (word_is(src, a, b, "||")) { return L_OR; }
    if (word_is(src, a, b, "&&")) { return L_AND; }
    if (word_is(src, a, b, "==") or word_is(src, a, b, "!=") or word_is(src, a, b, "<=") or word_is(src, a, b, ">=")) { return L_CMP; }
    if (word_is(src, a, b, "<<") or word_is(src, a, b, ">>")) { return L_SHIFT; }
    if (word_is(src, a, b, "as")) { return L_AS; }
    return 0;
}

/// May an operand of level `child` stand bare under the operator of level `parent`? Every language
/// t27 lowers to agrees on arithmetic over shifts over comparisons over `and` over `or`; the bitwise
/// operators and `as` are parenthesized, as their precedence differs between Rust, C and Zig.
pub fn keep_bare(child: usize, parent: usize, left: bool) -> bool {
    if (child == L_ATOM or child == L_UNARY) { return true; }
    if (child == parent) { return left and parent != L_CMP and parent != L_AS; }
    if (child == L_BOR or child == L_XOR or child == L_BAND or child == L_AS) { return false; }
    if (parent == L_BOR or parent == L_XOR or parent == L_BAND) { return false; }
    return child > parent;
}

/// Is the token at src[q] a string literal?
pub fn str_tok(src: []const u8, q: usize) -> bool {
    if (q >= src.len) { return false; }
    if (src[q] == B_QUOTE) { return true; }
    return src[q] == B_LOWER_B and q + 1 < src.len and src[q + 1] == B_QUOTE;
}

pub fn expr(src: []const u8, st: []usize, out: []u8, ns: bool) -> usize {
    return expr_bp(src, st, out, L_OR, ns);
}

/// An expression of operators at level `min` or above; the level of its top operator. `ns` is set
/// where Rust reads `Name {` as a block, not a struct literal (conditions, scrutinees, ranges).
pub fn expr_bp(src: []const u8, st: []usize, out: []u8, min: usize, ns: bool) -> usize {
    const start : usize = st[W];
    var lvl : usize = unary(src, st, out, ns);
    while (!bad(st[ERR])) {
        const a : usize = st[P];
        const b : usize = tok_end(src, a);
        const lv : usize = op_level(src, a, b);
        if (lv == 0 or lv < min) { return lvl; }
        step(src, st);
        if (lv == L_AS) {
            if (lvl != L_ATOM) { wrap(st, out, start); }
            puts(st, out, " as ");
            ty(src, st, out);
            lvl = L_AS;
        } else if ((word_is(src, a, b, "==") or word_is(src, a, b, "!=")) and (out_at(st[W], out, start) == B_QUOTE or str_tok(src, st[P]))) {
            if (word_is(src, a, b, "!=")) { insert(st, out, start, "!t27o_eq("); } else { insert(st, out, start, "t27o_eq("); }
            puts(st, out, ", ");
            expr_bp(src, st, out, lv + 1, ns);
            puts(st, out, ")");
            st[NEQ] = 1;
            lvl = L_UNARY;
        } else {
            if (!keep_bare(lvl, lv, true)) { wrap(st, out, start); }
            puts(st, out, " ");
            if (word_is(src, a, b, "||")) {
                puts(st, out, "or");
            } else if (word_is(src, a, b, "&&")) {
                puts(st, out, "and");
            } else {
                put_src(src, st, out, a, b);
            }
            puts(st, out, " ");
            const rs : usize = st[W];
            const rl : usize = expr_bp(src, st, out, lv + 1, ns);
            if (!keep_bare(rl, lv, false)) { wrap(st, out, rs); }
            lvl = lv;
        }
    }
    return lvl;
}

/// Was the name src[a .. b] declared as an array (`name: [`, `name = [`) earlier in this fn? A Rust
/// borrow of it passes a slice, which t27 writes as `&name`; a borrow of anything else is dropped.
pub fn array_local(src: []const u8, flo: usize, a: usize, b: usize) -> bool {
    var q : usize = flo;
    while (q < a) {
        const e : usize = tok_end(src, q);
        if (e - q == b - a and same_at(src, q, e, a)) {
            const n1 : usize = skip_ws(src, e);
            const e1 : usize = tok_end(src, n1);
            const n2 : usize = skip_ws(src, e1);
            if ((word_is(src, n1, e1, ":") or word_is(src, n1, e1, "=")) and n2 < src.len and src[n2] == B_LBRACKET) { return true; }
        }
        q = skip_ws(src, e);
    }
    return false;
}

pub fn unary(src: []const u8, st: []usize, out: []u8, ns: bool) -> usize {
    if (bad(st[ERR])) { return L_ATOM; }
    // t27c's Zig backend drops the parentheses of -(x) and !(x) (#6549), so a parenthesized operand
    // is written as (0 - (x)) and ((x) == false).
    if (take(src, st, "-")) {
        if (at(src, st[P], "(")) {
            puts(st, out, "(0 - ");
            unary(src, st, out, ns);
            puts(st, out, ")");
            return L_ATOM;
        }
        puts(st, out, "-");
        unary(src, st, out, ns);
        return L_UNARY;
    }
    if (take(src, st, "!")) {
        if (at(src, st[P], "(")) {
            puts(st, out, "(");
            unary(src, st, out, ns);
            puts(st, out, " == false)");
            return L_ATOM;
        }
        puts(st, out, "!");
        unary(src, st, out, ns);
        return L_UNARY;
    }
    // A shared reference is passed as its value (&T is T), so reading through one drops the `*`;
    // `*self` in a &mut self fn is `self.*`.
    if (take(src, st, "*")) {
        if (st[SELFMUT] == 1 and at(src, st[P], "self")) {
            step(src, st);
            puts(st, out, "self.*");
            return L_ATOM;
        }
        return unary(src, st, out, ns);
    }
    if (take(src, st, "&") or take(src, st, "&&")) {
        const m : bool = take(src, st, "mut");
        const s : usize = st[W];
        const oa : usize = st[P];
        const l : usize = unary(src, st, out, ns);
        const ob : usize = tok_end(src, oa);
        const one : bool = oa < src.len and is_alpha(src[oa]) and st[P] == skip_ws(src, ob);
        const arr : bool = one and array_local(src, st[FLO], oa, ob);
        if (arr) { insert(st, out, s, "&"); }
        // `&mut x` of anything but an array or a slice range would write through a copy
        if (m and !arr and out_at(st[W], out, st[W] - 1) != B_RBRACKET) { refuse(st, R_MUTREF, oa, oa, ob); }
        return l;
    }
    return postfix(src, st, out, ns);
}

/// Call arguments from `(` to `)`.
pub fn call_args(src: []const u8, st: []usize, out: []u8) -> void {
    want(src, st, "(");
    puts(st, out, "(");
    if (!at(src, st[P], ")")) { args_list(src, st, out); }
    want(src, st, ")");
    puts(st, out, ")");
}

pub fn args_list(src: []const u8, st: []usize, out: []u8) -> void {
    expr(src, st, out, false);
    while (live(src, st[P], st[ERR]) and take(src, st, ",")) {
        if (!at(src, st[P], ")")) {
            puts(st, out, ", ");
            expr(src, st, out, false);
        }
    }
}

/// A call with no arguments: `()`.
pub fn no_args(src: []const u8, st: []usize) -> void {
    want(src, st, "(");
    want(src, st, ")");
}

/// recv.wrapping_add(x) and its kin: `(recv +% x)`.
pub fn wrapping(src: []const u8, st: []usize, out: []u8, start: usize, op: []const u8) -> void {
    want(src, st, "(");
    puts(st, out, op);
    const rs : usize = st[W];
    const l : usize = expr(src, st, out, false);
    if (!keep_bare(l, L_ADD, false)) { wrap(st, out, rs); }
    want(src, st, ")");
    wrap(st, out, start);
}

/// The receiver of `fn <name>(..self` in src[lo .. hi]: 1 for self or &self, 2 for &mut self, 0 when
/// there is no such method.
pub fn method_kind(src: []const u8, lo: usize, hi: usize, na: usize, nb: usize) -> usize {
    var q : usize = lo;
    while (q < hi) {
        const e : usize = tok_end(src, q);
        if (word_is(src, q, e, "fn")) {
            const n : usize = skip_ws(src, e);
            const ne : usize = tok_end(src, n);
            const lp : usize = skip_ws(src, ne);
            if (ne - n == nb - na and same_at(src, n, ne, na) and lp < hi and src[lp] == B_LPAREN) {
                var s : usize = skip_ws(src, lp + 1);
                var amp : bool = false;
                var mutable : bool = false;
                if (s < hi and src[s] == B_AMP) {
                    amp = true;
                    s = skip_ws(src, s + 1);
                }
                if (s < hi and src[s] == B_APOS) { s = skip_ws(src, tok_end(src, s)); }
                if (tok_is(src, s, "mut")) {
                    mutable = true;
                    s = skip_ws(src, tok_end(src, s));
                }
                if (tok_is(src, s, "self") and amp and mutable) { return 2; }
                if (tok_is(src, s, "self")) { return 1; }
            }
        }
        q = skip_ws(src, e);
    }
    return 0;
}

/// The type of the first inherent impl block (`impl Name {`) with a method `name` taking self, into
/// st[OLO .. OHI], its receiver kind into st[OKIND].
pub fn method_owner(src: []const u8, st: []usize, na: usize, nb: usize) -> bool {
    var q : usize = skip_ws(src, 0);
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        if (word_is(src, q, e, "impl")) {
            const t : usize = skip_ws(src, e);
            const te : usize = tok_end(src, t);
            const o : usize = skip_ws(src, te);
            if (t < src.len and is_alpha(src[t]) and o < src.len and src[o] == B_LBRACE) {
                const kind : usize = method_kind(src, o, block_end(src, o), na, nb);
                if (kind != 0) {
                    st[OLO] = t;
                    st[OHI] = te;
                    st[OKIND] = kind;
                    return true;
                }
            }
        }
        q = skip_ws(src, e);
    }
    return false;
}

/// The method call recv.name(..) whose receiver was written from `start` on; st[P] is at `(`.
pub fn method(src: []const u8, st: []usize, out: []u8, start: usize, na: usize, nb: usize) -> void {
    if (word_is(src, na, nb, "len")) {
        no_args(src, st);
        puts(st, out, ".len");
        return;
    }
    // .as_str() / .clone() / ... are no-ops on the types t27o reads, unless this file's structs define them
    const user : bool = method_owner(src, st, na, nb);
    if (!user and (word_is(src, na, nb, "as_bytes") or word_is(src, na, nb, "as_str") or word_is(src, na, nb, "as_slice") or word_is(src, na, nb, "clone"))) {
        no_args(src, st);
        return;
    }
    // in a `for` header, `.iter()` is the slice itself and `.enumerate()` asks for the index
    if (st[FORHDR] == 1 and (word_is(src, na, nb, "iter") or word_is(src, na, nb, "enumerate"))) {
        if (word_is(src, na, nb, "enumerate")) { st[ENUMSEEN] = 1; }
        no_args(src, st);
        return;
    }
    if (word_is(src, na, nb, "is_empty")) {
        no_args(src, st);
        puts(st, out, ".len == 0");
        wrap(st, out, start);
        return;
    }
    if (word_is(src, na, nb, "unwrap")) {
        no_args(src, st);
        puts(st, out, ".?");
        return;
    }
    if (word_is(src, na, nb, "is_some") or word_is(src, na, nb, "is_none")) {
        no_args(src, st);
        if (word_is(src, na, nb, "is_some")) { puts(st, out, " != null"); } else { puts(st, out, " == null"); }
        wrap(st, out, start);
        return;
    }
    if (word_is(src, na, nb, "wrapping_add")) {
        wrapping(src, st, out, start, " +% ");
        return;
    }
    if (word_is(src, na, nb, "wrapping_sub")) {
        wrapping(src, st, out, start, " -% ");
        return;
    }
    if (word_is(src, na, nb, "wrapping_mul")) {
        wrapping(src, st, out, start, " *% ");
        return;
    }
    if (user) {
        // a &mut self method takes a pointer: `&recv`, or `self` as it is inside another one; a
        // self or &self method called from a &mut self one reads through the pointer: `self.*`
        const recv_self : bool = out_is(st[W], out, start, "self");
        if (st[OKIND] == 2 and (!recv_self or st[SELFMUT] != 1)) { insert(st, out, start, "&"); }
        if (st[OKIND] == 1 and recv_self and st[SELFMUT] == 1) { puts(st, out, ".*"); }
        insert(st, out, start, "(");
        insert_ident(src, st, out, start, na, nb);
        insert(st, out, start, "_");
        insert_src(src, st, out, start, st[OLO], st[OHI]);
        step(src, st);
        if (!at(src, st[P], ")")) {
            puts(st, out, ", ");
            args_list(src, st, out);
        }
        want(src, st, ")");
        puts(st, out, ")");
        return;
    }
    refuse(st, R_METHOD, na, na, nb);
}

/// An index or a slice, from `[`.
pub fn index(src: []const u8, st: []usize, out: []u8) -> void {
    step(src, st);
    const w0 : usize = st[W];
    puts(st, out, "[");
    if (at(src, st[P], "..") or at(src, st[P], "..=")) {
        const incl : bool = at(src, st[P], "..=");
        step(src, st);
        if (take(src, st, "]")) {
            st[W] = w0;
            return;
        }
        puts(st, out, "0 .. ");
        range_hi(src, st, out, incl, false);
    } else {
        expr(src, st, out, false);
        if (at(src, st[P], "..") or at(src, st[P], "..=")) {
            const incl2 : bool = at(src, st[P], "..=");
            step(src, st);
            if (at(src, st[P], "]")) {
                puts(st, out, " ..");
            } else {
                puts(st, out, " .. ");
                range_hi(src, st, out, incl2, false);
            }
        }
    }
    puts(st, out, "]");
    want(src, st, "]");
}

/// The upper bound of a range; an inclusive one gets `+ 1`.
pub fn range_hi(src: []const u8, st: []usize, out: []u8, incl: bool, ns: bool) -> void {
    const s : usize = st[W];
    const l : usize = expr(src, st, out, ns);
    if (incl) {
        if (!keep_bare(l, L_ADD, true)) { wrap(st, out, s); }
        puts(st, out, " + 1");
    }
}

pub fn postfix(src: []const u8, st: []usize, out: []u8, ns: bool) -> usize {
    const start : usize = st[W];
    primary(src, st, out, ns);
    while (!bad(st[ERR])) {
        if (at(src, st[P], ".")) {
            step(src, st);
            const na : usize = st[P];
            const nb : usize = tok_end(src, na);
            if (na >= src.len or !is_alpha(src[na])) {
                refuse(st, R_TUPLE, na, na, nb);
                return L_ATOM;
            }
            step(src, st);
            if (at(src, st[P], "::")) {
                refuse_here(src, st, R_GENERIC);
                return L_ATOM;
            }
            if (at(src, st[P], "(")) {
                method(src, st, out, start, na, nb);
            } else {
                puts(st, out, ".");
                put_ident(src, st, out, na, nb);
            }
        } else if (at(src, st[P], "[")) {
            index(src, st, out);
        } else if (at(src, st[P], "?")) {
            refuse_here(src, st, R_TRY);
            return L_ATOM;
        } else {
            return L_ATOM;
        }
    }
    return L_ATOM;
}

/// The digits of a number literal without its `_` separators.
pub fn put_digits(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    var i : usize = a;
    while (i < b) {
        if (src[i] != B_UNDERSCORE) { put(st, out, src[i]); }
        i = i + 1;
    }
}

/// Does src[a .. b] end with `s`?
pub fn ends_with(src: []const u8, a: usize, b: usize, s: []const u8) -> bool {
    if (b - a <= s.len) { return false; }
    return word_is(src, b - s.len, b, s);
}

/// The length of the type suffix of the number literal src[a .. b] (`7u8`, `1.0f64`), 0 when none.
pub fn suffix_len(src: []const u8, a: usize, b: usize) -> usize {
    if (b <= a or !is_digit(src[a])) { return 0; }
    const radix : bool = b - a > 2 and src[a] == B_ZERO and (src[a + 1] == B_LOWER_X or src[a + 1] == B_LOWER_O or src[a + 1] == B_LOWER_B);
    if (ends_with(src, a, b, "usize") or ends_with(src, a, b, "isize")) { return 5; }
    if (ends_with(src, a, b, "u128") or ends_with(src, a, b, "i128")) { return 4; }
    if (ends_with(src, a, b, "u16") or ends_with(src, a, b, "u32") or ends_with(src, a, b, "u64") or ends_with(src, a, b, "i16") or ends_with(src, a, b, "i32") or ends_with(src, a, b, "i64")) { return 3; }
    if (!radix and (ends_with(src, a, b, "f32") or ends_with(src, a, b, "f64"))) { return 3; }
    if (ends_with(src, a, b, "u8") or ends_with(src, a, b, "i8")) { return 2; }
    return 0;
}

/// A number literal: `_` dropped, a suffix written as `@as(T, n)`.
pub fn put_number(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    const k : usize = suffix_len(src, a, b);
    if (k > 0) {
        puts(st, out, "@as(");
        put_src(src, st, out, b - k, b);
        puts(st, out, ", ");
    }
    put_digits(src, st, out, a, b - k);
    if (k > 0) { puts(st, out, ")"); }
}

/// A char or byte literal: printable bytes and the escapes t27 reads kept, `\0` and `\xNN` as numbers.
pub fn put_char(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    var s : usize = a;
    if (src[s] == B_LOWER_B) { s = s + 1; }
    if (b < s + 3) {
        refuse(st, R_LITERAL, a, a, b);
        return;
    }
    const n : usize = b - s - 2;
    if (n == 1 and src[s + 1] >= B_SPACE and src[s + 1] < B_DEL) {
        put_src(src, st, out, s, b);
        return;
    }
    if (n == 2 and src[s + 1] == B_BACKSLASH) {
        const e : u8 = src[s + 2];
        if (e == B_LOWER_N or e == B_LOWER_R or e == B_LOWER_T or e == B_BACKSLASH or e == B_APOS or e == B_QUOTE) {
            put_src(src, st, out, s, b);
            return;
        }
        if (e == B_ZERO) {
            puts(st, out, "0");
            return;
        }
    }
    if (n == 4 and src[s + 1] == B_BACKSLASH and src[s + 2] == B_LOWER_X) {
        put_num(st, out, hex_value(src[s + 3]) * 16 + hex_value(src[s + 4]));
        return;
    }
    refuse(st, R_LITERAL, a, a, b);
}

/// An escape a t27 string literal reads: `\n \r \t \\ \" \' \xNN \u{N}`.
pub fn string_escape(e: u8) -> bool {
    return e == B_LOWER_N or e == B_LOWER_R or e == B_LOWER_T or e == B_BACKSLASH or e == B_QUOTE or e == B_APOS or e == B_LOWER_X or e == B_LOWER_U;
}

/// A string literal: printable ASCII and the escapes t27 reads, else refused.
pub fn put_string(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    var s : usize = a;
    if (src[s] == B_LOWER_B) { s = s + 1; }
    var i : usize = s + 1;
    while (i + 1 < b) {
        const c : u8 = src[i];
        if (c < B_SPACE or c >= B_DEL) {
            refuse(st, R_LITERAL, a, a, b);
            return;
        }
        if (c == B_BACKSLASH) {
            const e : u8 = src[i + 1];
            if (!string_escape(e)) {
                refuse(st, R_LITERAL, a, i, i + 2);
                return;
            }
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    put_src(src, st, out, s, b);
}

/// The value of T::MAX or T::MIN for an integer type T (usize and isize as 64-bit).
pub fn put_limit(src: []const u8, st: []usize, out: []u8, a: usize, b: usize, max: bool) -> bool {
    if (word_is(src, a, b, "u8") or word_is(src, a, b, "u16") or word_is(src, a, b, "u32") or word_is(src, a, b, "u64") or word_is(src, a, b, "u128") or word_is(src, a, b, "usize")) {
        if (!max) {
            puts(st, out, "0");
        } else if (word_is(src, a, b, "u8")) {
            puts(st, out, "255");
        } else if (word_is(src, a, b, "u16")) {
            puts(st, out, "65535");
        } else if (word_is(src, a, b, "u32")) {
            puts(st, out, "4294967295");
        } else if (word_is(src, a, b, "u128")) {
            puts(st, out, "340282366920938463463374607431768211455");
        } else {
            puts(st, out, "18446744073709551615");
        }
        return true;
    }
    if (word_is(src, a, b, "i8")) {
        if (max) { puts(st, out, "127"); } else { puts(st, out, "(-128)"); }
        return true;
    }
    if (word_is(src, a, b, "i16")) {
        if (max) { puts(st, out, "32767"); } else { puts(st, out, "(-32768)"); }
        return true;
    }
    if (word_is(src, a, b, "i32")) {
        if (max) { puts(st, out, "2147483647"); } else { puts(st, out, "(-2147483648)"); }
        return true;
    }
    if (word_is(src, a, b, "i64") or word_is(src, a, b, "isize")) {
        if (max) { puts(st, out, "9223372036854775807"); } else { puts(st, out, "(-9223372036854775808)"); }
        return true;
    }
    if (word_is(src, a, b, "i128")) {
        if (max) { puts(st, out, "170141183460469231731687303715884105727"); } else { puts(st, out, "(-170141183460469231731687303715884105728)"); }
        return true;
    }
    return false;
}

/// A const's name: upper case, digits and `_`, two bytes or more (a variant is CamelCase).
pub fn upper_const(src: []const u8, a: usize, b: usize) -> bool {
    if (b - a < 2) { return false; }
    var i : usize = a;
    while (i < b) {
        if (!is_upper(src[i]) and !is_digit(src[i]) and src[i] != B_UNDERSCORE) { return false; }
        i = i + 1;
    }
    return true;
}

/// Is src[a .. b] a prefix of a path t27 does not spell (`crate`, `self`, `super`, `std`, `core`)?
pub fn path_prefix(src: []const u8, a: usize, b: usize) -> bool {
    return word_is(src, a, b, "crate") or word_is(src, a, b, "self") or word_is(src, a, b, "super") or word_is(src, a, b, "std") or word_is(src, a, b, "core");
}

/// A path that starts with the segment src[a0 .. b0]; st[P] is at `::`.
pub fn path(src: []const u8, st: []usize, out: []u8, a0: usize, b0: usize) -> void {
    var a : usize = a0;
    var b : usize = b0;
    while (live(src, st[P], st[ERR]) and at(src, st[P], "::") and path_prefix(src, a, b)) {
        step(src, st);
        a = st[P];
        b = tok_end(src, a);
        if (a >= src.len or !is_alpha(src[a])) {
            refuse(st, R_PATH, a0, a0, b);
            return;
        }
        step(src, st);
    }
    if (bad(st[ERR])) { return; }
    if (!at(src, st[P], "::")) {
        put_ident(src, st, out, a, b);
        if (at(src, st[P], "(")) { call_args(src, st, out); }
        return;
    }
    step(src, st);
    if (at(src, st[P], "<")) {
        refuse_here(src, st, R_GENERIC);
        return;
    }
    const ma : usize = st[P];
    const mb : usize = tok_end(src, ma);
    if (ma >= src.len or !is_alpha(src[ma])) {
        refuse(st, R_PATH, a, a, mb);
        return;
    }
    step(src, st);
    if (at(src, st[P], "::") or at(src, st[P], "{")) {
        refuse(st, R_PATH, a, a, mb);
        return;
    }
    if (prim(src, a, b) or word_is(src, a, b, "char") or heap_type(src, a, b)) {
        if ((word_is(src, ma, mb, "MAX") or word_is(src, ma, mb, "MIN")) and !at(src, st[P], "(")) {
            if (put_limit(src, st, out, a, b, word_is(src, ma, mb, "MAX"))) { return; }
        }
        refuse(st, R_PATH, a, a, mb);
        return;
    }
    // a lower-case first segment is a module: its items live in another file
    if (!is_upper(src[a])) {
        refuse(st, R_EXTERNAL, a, a, mb);
        return;
    }
    if (at(src, st[P], "(")) {
        put_owner(src, st, out, a, b);
        puts(st, out, "_");
        put_ident(src, st, out, ma, mb);
        call_args(src, st, out);
        return;
    }
    put_owner(src, st, out, a, b);
    if (upper_const(src, ma, mb)) { puts(st, out, "_"); } else { puts(st, out, "."); }
    put_src(src, st, out, ma, mb);
}

/// A struct literal `Name { f: e, g }` as `Name{ .f = e, .g = g }`; st[P] is at `{`.
pub fn struct_lit(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    put_owner(src, st, out, a, b);
    step(src, st);
    puts(st, out, "{");
    var n : usize = 0;
    var more : bool = true;
    while (more and live(src, st[P], st[ERR]) and !at(src, st[P], "}")) {
        if (at(src, st[P], "..")) {
            refuse_here(src, st, R_UPDATE);
            return;
        }
        const fa : usize = st[P];
        const fb : usize = tok_end(src, fa);
        if (!is_alpha(src[fa])) {
            refuse_here(src, st, R_SYNTAX);
            return;
        }
        step(src, st);
        if (n > 0) { puts(st, out, ","); }
        puts(st, out, " .");
        put_ident(src, st, out, fa, fb);
        puts(st, out, " = ");
        if (take(src, st, ":")) { expr(src, st, out, false); } else { put_ident(src, st, out, fa, fb); }
        n = n + 1;
        more = take(src, st, ",");
    }
    want(src, st, "}");
    if (n > 0) { puts(st, out, " "); }
    puts(st, out, "}");
}

/// An array literal `[a, b]` or `[v; n]` (as `[v] ** n`), from `[`.
pub fn array_lit(src: []const u8, st: []usize, out: []u8) -> void {
    step(src, st);
    puts(st, out, "[");
    if (at(src, st[P], "]")) {
        refuse_here(src, st, R_VALUE);
        return;
    }
    expr(src, st, out, false);
    if (take(src, st, ";")) {
        puts(st, out, "] ** ");
        const s : usize = st[W];
        const l : usize = expr(src, st, out, false);
        if (l != L_ATOM) { wrap(st, out, s); }
        want(src, st, "]");
        return;
    }
    while (live(src, st[P], st[ERR]) and take(src, st, ",")) {
        if (!at(src, st[P], "]")) {
            puts(st, out, ", ");
            expr(src, st, out, false);
        }
    }
    want(src, st, "]");
    puts(st, out, "]");
}

pub fn primary(src: []const u8, st: []usize, out: []u8, ns: bool) -> void {
    if (bad(st[ERR])) { return; }
    const a : usize = st[P];
    const b : usize = tok_end(src, a);
    if (a >= src.len) {
        refuse(st, R_SYNTAX, a, a, b);
        return;
    }
    const c : u8 = src[a];
    const c1 : u8 = head(src, st[P]);
    var c2 : u8 = 0;
    if (a + 1 < src.len) { c2 = src[a + 1]; }
    if (is_digit(c)) {
        put_number(src, st, out, a, b);
        step(src, st);
        return;
    }
    if (c == B_APOS or (c1 == B_LOWER_B and c2 == B_APOS)) {
        put_char(src, st, out, a, b);
        step(src, st);
        return;
    }
    if (c == B_QUOTE or (c1 == B_LOWER_B and c2 == B_QUOTE)) {
        put_string(src, st, out, a, b);
        step(src, st);
        return;
    }
    if (c == B_LOWER_R and (c2 == B_QUOTE or c2 == B_HASH)) {
        refuse(st, R_LITERAL, a, a, a + 2);
        return;
    }
    if (c == B_LPAREN) {
        step(src, st);
        if (at(src, st[P], ")")) {
            refuse(st, R_TUPLE, a, a, b);
            return;
        }
        puts(st, out, "(");
        expr(src, st, out, false);
        if (at(src, st[P], ",")) {
            refuse(st, R_TUPLE, a, a, b);
            return;
        }
        want(src, st, ")");
        puts(st, out, ")");
        return;
    }
    if (c == B_LBRACKET) {
        array_lit(src, st, out);
        return;
    }
    if (c == B_PIPE or word_is(src, a, b, "||") or word_is(src, a, b, "move")) {
        refuse(st, R_CLOSURE, a, a, b);
        return;
    }
    if (c == B_LBRACE or word_is(src, a, b, "if") or word_is(src, a, b, "match") or word_is(src, a, b, "loop") or word_is(src, a, b, "while") or word_is(src, a, b, "for")) {
        refuse(st, R_VALUE, a, a, b);
        return;
    }
    if (word_is(src, a, b, "unsafe")) {
        refuse(st, R_UNSAFE, a, a, b);
        return;
    }
    if (!is_alpha(c)) {
        refuse(st, R_SYNTAX, a, a, b);
        return;
    }
    if (word_is(src, a, b, "true") or word_is(src, a, b, "false")) {
        put_src(src, st, out, a, b);
        step(src, st);
        return;
    }
    if (word_is(src, a, b, "None")) {
        puts(st, out, "null");
        step(src, st);
        return;
    }
    step(src, st);
    if (word_is(src, a, b, "Some") and at(src, st[P], "(")) {
        step(src, st);
        const s : usize = st[W];
        const l : usize = expr(src, st, out, false);
        if (l != L_ATOM and l != L_UNARY) { wrap(st, out, s); }
        want(src, st, ")");
        return;
    }
    if (at(src, st[P], "!")) {
        refuse(st, R_MACRO, a, a, b);
        return;
    }
    if (at(src, st[P], "::")) {
        path(src, st, out, a, b);
        return;
    }
    if (at(src, st[P], "(")) {
        // `Name(..)` builds a tuple struct or a tuple variant; a Rust fn is snake_case
        if (is_upper(c)) {
            refuse(st, R_TUPLE, a, a, b);
            return;
        }
        put_ident(src, st, out, a, b);
        call_args(src, st, out);
        return;
    }
    if (!ns and at(src, st[P], "{") and is_upper(c)) {
        struct_lit(src, st, out, a, b);
        return;
    }
    put_owner(src, st, out, a, b);
}

// ---------------------------------------------------------------- statements

/// `{` and one more level of indentation.
pub fn open_block(src: []const u8, st: []usize, out: []u8) -> bool {
    if (bad(st[ERR])) { return false; }
    if (!at(src, st[P], "{")) {
        refuse_here(src, st, R_SYNTAX);
        return false;
    }
    step(src, st);
    puts(st, out, "{");
    st[IND] = st[IND] + 1;
    return true;
}

pub fn close_block(src: []const u8, st: []usize, out: []u8) -> void {
    st[IND] = st[IND] - 1;
    newline(st, out);
    puts(st, out, "}");
    want(src, st, "}");
}

/// A block whose tail expression becomes what `mode` says.
pub fn block(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    if (open_block(src, st, out)) {
        stmts(src, st, out, mode);
        close_block(src, st, out);
    }
}

pub fn stmts(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    while (live(src, st[P], st[ERR]) and !at(src, st[P], "}")) {
        if (!take(src, st, ";")) {
            newline(st, out);
            stmt(src, st, out, mode);
        }
    }
}

/// Finish an expression written from w0 on as the tail of a block.
pub fn tail_of(src: []const u8, st: []usize, out: []u8, w0: usize, mode: u8) -> void {
    if (mode == M_RET) { insert(st, out, w0, "return "); }
    if (mode == M_SET) {
        insert(st, out, w0, " = ");
        insert_ident(src, st, out, w0, st[TLO], st[THI]);
    }
    puts(st, out, ";");
}

pub fn stmt(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    const a : usize = st[P];
    const b : usize = tok_end(src, a);
    var m : u8 = M_STMT;
    if (is_tail(src, a)) { m = mode; }
    if (word_is(src, a, b, "let")) {
        let_stmt(src, st, out);
    } else if (word_is(src, a, b, "if")) {
        if_stmt(src, st, out, m);
    } else if (word_is(src, a, b, "match")) {
        match_stmt(src, st, out, m);
    } else if (word_is(src, a, b, "while")) {
        step(src, st);
        if (at(src, st[P], "let")) {
            refuse_here(src, st, R_IFLET);
            return;
        }
        puts(st, out, "while (");
        expr(src, st, out, true);
        puts(st, out, ") ");
        block(src, st, out, M_STMT);
    } else if (word_is(src, a, b, "loop")) {
        step(src, st);
        puts(st, out, "while (true) ");
        block(src, st, out, M_STMT);
    } else if (word_is(src, a, b, "for")) {
        for_stmt(src, st, out);
    } else if (word_is(src, a, b, "return")) {
        return_stmt(src, st, out);
    } else if (word_is(src, a, b, "break") or word_is(src, a, b, "continue")) {
        jump_stmt(src, st, out, a, b);
    } else if (src[a] == B_APOS) {
        refuse(st, R_LABEL, a, a, b);
    } else if (word_is(src, a, b, "unsafe")) {
        refuse(st, R_UNSAFE, a, a, b);
    } else if (src[a] == B_LBRACE) {
        refuse(st, R_VALUE, a, a, b);
    } else if (src[a] == B_HASH or word_is(src, a, b, "fn") or word_is(src, a, b, "struct") or word_is(src, a, b, "enum") or word_is(src, a, b, "impl") or word_is(src, a, b, "use")) {
        refuse(st, R_ITEM, a, a, b);
    } else if (word_is(src, a, b, "const")) {
        local_const(src, st, out);
    } else if (is_alpha(src[a]) and peek_is(src, st[P], "!")) {
        macro_stmt(src, st, out, a, b);
    } else {
        const w0 : usize = st[W];
        expr_stmt(src, st, out);
        if (bad(st[ERR])) { return; }
        if (take(src, st, ";")) {
            puts(st, out, ";");
        } else if (at(src, st[P], "}")) {
            tail_of(src, st, out, w0, m);
        } else {
            refuse_here(src, st, R_SYNTAX);
        }
    }
}

/// An assignment operator, plain or compound.
pub fn assign_op(src: []const u8, p: usize) -> bool {
    return at(src, p, "=") or at(src, p, "+=") or at(src, p, "-=") or at(src, p, "*=") or at(src, p, "/=") or at(src, p, "%=") or at(src, p, "^=") or at(src, p, "&=") or at(src, p, "|=") or at(src, p, "<<=") or at(src, p, ">>=");
}

pub fn expr_stmt(src: []const u8, st: []usize, out: []u8) -> void {
    expr(src, st, out, false);
    if (live(src, st[P], st[ERR]) and assign_op(src, st[P])) {
        puts(st, out, " ");
        put_src(src, st, out, st[P], tok_end(src, st[P]));
        puts(st, out, " ");
        step(src, st);
        expr(src, st, out, false);
    }
}

/// The first token after the `=` of a let that starts at src[p], src.len when it has none.
pub fn init_at(src: []const u8, p: usize) -> usize {
    const eq : usize = find_at(src, p, B_EQ);
    const semi : usize = find_at(src, p, B_SEMI);
    if (eq >= semi) { return src.len; }
    return skip_ws(src, eq + 1);
}

/// A block-valued expression: if, match, loop, a block.
pub fn value_form(src: []const u8, p: usize) -> bool {
    return tok_is(src, p, "if") or tok_is(src, p, "match") or tok_is(src, p, "loop") or tok_is(src, p, "{") or tok_is(src, p, "unsafe");
}

pub fn let_stmt(src: []const u8, st: []usize, out: []u8) -> void {
    step(src, st);
    const mutable : bool = take(src, st, "mut");
    const na : usize = st[P];
    const nb : usize = tok_end(src, na);
    if (na >= src.len or !is_alpha(src[na])) {
        refuse(st, R_TUPLE, na, na, nb);
        return;
    }
    step(src, st);
    // `let _ = e;` and `let _x = e;` (Rust's "unused on purpose") discard e
    const eqp : usize = find_at(src, st[P], B_EQ);
    const unused : bool = word_is(src, na, nb, "_") or (src[na] == B_UNDERSCORE and !mentions(src, eqp, item_end(src, st[FLO]), na, nb));
    if (unused and eqp < find_at(src, st[P], B_SEMI)) {
        st[P] = skip_ws(src, eqp + 1);
        puts(st, out, "_ = ");
        expr(src, st, out, false);
        want(src, st, ";");
        puts(st, out, ";");
        return;
    }
    const typed : bool = at(src, st[P], ":");
    const init : usize = init_at(src, st[P]);
    const vform : bool = init < src.len and value_form(src, init);
    if (mutable or vform or init >= src.len) { puts(st, out, "var "); } else { puts(st, out, "const "); }
    put_ident(src, st, out, na, nb);
    if (typed) {
        step(src, st);
        puts(st, out, " : ");
        ty(src, st, out);
    }
    if (init >= src.len) {
        if (!typed) {
            refuse(st, R_VALUE, na, na, nb);
            return;
        }
        puts(st, out, " = undefined;");
        want(src, st, ";");
        return;
    }
    want(src, st, "=");
    if (bad(st[ERR])) { return; }
    if (vform) {
        if (!typed) {
            refuse_here(src, st, R_VALUE);
            return;
        }
        puts(st, out, " = undefined;");
        newline(st, out);
        const tlo : usize = st[TLO];
        const thi : usize = st[THI];
        st[TLO] = na;
        st[THI] = nb;
        if (at(src, st[P], "if")) {
            if_stmt(src, st, out, M_SET);
        } else if (at(src, st[P], "match")) {
            match_stmt(src, st, out, M_SET);
        } else {
            refuse_here(src, st, R_VALUE);
        }
        st[TLO] = tlo;
        st[THI] = thi;
        want(src, st, ";");
        return;
    }
    const ie : usize = tok_end(src, init);
    const k : usize = suffix_len(src, init, ie);
    if (!typed and k > 0 and tok_is(src, skip_ws(src, ie), ";")) {
        puts(st, out, " : ");
        put_src(src, st, out, ie - k, ie);
        puts(st, out, " = ");
        put_digits(src, st, out, init, ie - k);
        st[P] = skip_ws(src, ie);
    } else {
        puts(st, out, " = ");
        expr(src, st, out, false);
    }
    want(src, st, ";");
    puts(st, out, ";");
}

pub fn local_const(src: []const u8, st: []usize, out: []u8) -> void {
    step(src, st);
    const na : usize = st[P];
    const nb : usize = tok_end(src, na);
    step(src, st);
    puts(st, out, "const ");
    put_ident(src, st, out, na, nb);
    want(src, st, ":");
    puts(st, out, " : ");
    ty(src, st, out);
    want(src, st, "=");
    puts(st, out, " = ");
    expr(src, st, out, false);
    want(src, st, ";");
    puts(st, out, ";");
}

pub fn if_stmt(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    step(src, st);
    if (at(src, st[P], "let")) {
        if_let(src, st, out, mode);
        return;
    }
    puts(st, out, "if (");
    expr(src, st, out, true);
    puts(st, out, ") ");
    block(src, st, out, mode);
    else_chain(src, st, out, mode);
}

/// `if let Some(v) = e { .. }` as `if (e != null) { const v = e.?; .. }`; e is read twice, so one
/// that calls something is refused.
pub fn if_let(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    step(src, st);
    if (!at(src, st[P], "Some") or !peek_is(src, st[P], "(")) {
        refuse_here(src, st, R_IFLET);
        return;
    }
    step(src, st);
    step(src, st);
    const va : usize = st[P];
    const vb : usize = tok_end(src, va);
    if (va >= src.len or !is_alpha(src[va])) {
        refuse(st, R_IFLET, va, va, vb);
        return;
    }
    step(src, st);
    want(src, st, ")");
    want(src, st, "=");
    const ea : usize = st[P];
    puts(st, out, "if (");
    const xw : usize = st[W];
    expr(src, st, out, true);
    if (bad(st[ERR])) { return; }
    const once : bool = out_has(st[W], out, xw, B_LPAREN);
    const spaced : bool = out_has(st[W], out, xw, B_SPACE);
    if (once) {
        refuse(st, R_IFLET, ea, ea, tok_end(src, ea));
        return;
    }
    if (spaced) { wrap(st, out, xw); }
    puts(st, out, " != null) ");
    if (open_block(src, st, out)) {
        newline(st, out);
        puts(st, out, "const ");
        put_ident(src, st, out, va, vb);
        puts(st, out, " = ");
        const save : usize = st[P];
        const vw : usize = st[W];
        st[P] = ea;
        expr(src, st, out, true);
        st[P] = save;
        if (spaced) { wrap(st, out, vw); }
        puts(st, out, ".?;");
        stmts(src, st, out, mode);
        close_block(src, st, out);
    }
    else_chain(src, st, out, mode);
}

/// The `else if` / `else` branches after an if's first block.
pub fn else_chain(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    var more : bool = true;
    while (more and live(src, st[P], st[ERR]) and at(src, st[P], "else")) {
        step(src, st);
        if (take(src, st, "if")) {
            if (at(src, st[P], "let")) {
                refuse_here(src, st, R_IFLET);
                return;
            }
            puts(st, out, " else if (");
            expr(src, st, out, true);
            puts(st, out, ") ");
            block(src, st, out, mode);
        } else {
            puts(st, out, " else ");
            block(src, st, out, mode);
            more = false;
        }
    }
}

/// The token of the type the name src[a .. b] was declared with in src[lo .. hi] (the last
/// `name: T`, a parameter or a let), src.len when none.
pub fn decl_type(src: []const u8, lo: usize, hi: usize, a: usize, b: usize) -> usize {
    var found : usize = src.len;
    var q : usize = lo;
    while (q < hi) {
        const e : usize = tok_end(src, q);
        if (e - q == b - a and same_at(src, q, e, a)) {
            const c : usize = skip_ws(src, e);
            const ce : usize = tok_end(src, c);
            if (word_is(src, c, ce, ":")) { found = skip_ws(src, ce); }
        }
        q = skip_ws(src, e);
    }
    return found;
}

/// The slice of a for-each header, `.iter()` and `.enumerate()` dropped; a `&` before it too.
pub fn each_slice(src: []const u8, st: []usize, out: []u8) -> void {
    if (take(src, st, "&") and take(src, st, "mut")) { refuse_here(src, st, R_MUTREF); }
    st[FORHDR] = 1;
    expr(src, st, out, true);
    st[FORHDR] = 0;
}

/// `for x in s` / `s.iter()` / `&s` over a slice or an array keeps t27's for-each;
/// `for (i, x) in s.iter().enumerate()` becomes `for i in 0..s.len { const x = s[i]; .. }`.
pub fn for_each(src: []const u8, st: []usize, out: []u8, ia: usize, ib: usize, va: usize, vb: usize) -> void {
    const ra : usize = st[P];
    st[ENUMSEEN] = 0;
    puts(st, out, "for ");
    if (ib > ia) {
        put_ident(src, st, out, ia, ib);
        puts(st, out, " in 0..");
    } else {
        put_ident(src, st, out, va, vb);
        puts(st, out, " in ");
    }
    const hw : usize = st[W];
    each_slice(src, st, out);
    if (bad(st[ERR])) { return; }
    // over a slice or an array that has a name; an array literal is a tuple to Zig's for
    if ((ib > ia) != (st[ENUMSEEN] == 1) or out_at(st[W], out, hw) == B_LBRACKET) {
        refuse(st, R_ITER, ra, ra, tok_end(src, ra));
        return;
    }
    if (ib > ia) { puts(st, out, ".len"); }
    puts(st, out, " ");
    if (open_block(src, st, out)) {
        if (ib > ia) {
            newline(st, out);
            puts(st, out, "const ");
            put_ident(src, st, out, va, vb);
            puts(st, out, " = ");
            const save : usize = st[P];
            st[P] = ra;
            each_slice(src, st, out);
            st[P] = save;
            puts(st, out, "[");
            put_ident(src, st, out, ia, ib);
            puts(st, out, "];");
        }
        stmts(src, st, out, M_STMT);
        close_block(src, st, out);
    }
}

/// `for i in a..b` keeps t27's `for`, whose variable is a usize. When the upper bound is one name
/// declared with another integer type T, the body gets `const i : T = i_t27o as T;`. Without a range
/// the loop is a for-each (for_each).
pub fn for_stmt(src: []const u8, st: []usize, out: []u8) -> void {
    const fpos : usize = st[P];
    step(src, st);
    var ia : usize = 0;
    var ib : usize = 0;
    if (take(src, st, "(")) {
        ia = st[P];
        ib = tok_end(src, ia);
        if (ia >= src.len or !is_alpha(src[ia])) {
            refuse(st, R_TUPLE, ia, ia, ib);
            return;
        }
        step(src, st);
        want(src, st, ",");
    }
    take(src, st, "&");
    const va : usize = st[P];
    const vb : usize = tok_end(src, va);
    if (va >= src.len or !is_alpha(src[va])) {
        refuse(st, R_TUPLE, va, va, vb);
        return;
    }
    step(src, st);
    if (ib > ia) { want(src, st, ")"); }
    want(src, st, "in");
    if (bad(st[ERR])) { return; }
    const ra : usize = st[P];
    var dots : usize = find_tok(src, ra, "..");
    const dots2 : usize = find_tok(src, ra, "..=");
    if (dots2 < dots) { dots = dots2; }
    const lbrace : usize = find_at(src, ra, B_LBRACE);
    if (dots >= lbrace) {
        for_each(src, st, out, ia, ib, va, vb);
        return;
    }
    if (ib > ia) {
        refuse(st, R_TUPLE, ia, ia, ib);
        return;
    }
    const hb : usize = skip_ws(src, tok_end(src, dots));
    const hbe : usize = tok_end(src, hb);
    var tt : usize = src.len;
    if (skip_ws(src, hbe) == lbrace and is_alpha(src[hb]) and !word_is(src, va, vb, "_")) {
        const d : usize = decl_type(src, st[FLO], fpos, hb, hbe);
        if (d < src.len and int_type(src, d, tok_end(src, d))) { tt = d; }
    }
    puts(st, out, "for ");
    put_ident(src, st, out, va, vb);
    if (tt < src.len) { puts(st, out, "_t27o"); }
    puts(st, out, " in ");
    expr(src, st, out, true);
    const incl : bool = at(src, st[P], "..=");
    if (!take(src, st, "..") and !take(src, st, "..=")) {
        refuse(st, R_ITER, ra, ra, tok_end(src, ra));
        return;
    }
    puts(st, out, "..");
    range_hi(src, st, out, incl, true);
    puts(st, out, " ");
    if (open_block(src, st, out)) {
        if (tt < src.len) {
            newline(st, out);
            puts(st, out, "const ");
            put_ident(src, st, out, va, vb);
            puts(st, out, " : ");
            put_src(src, st, out, tt, tok_end(src, tt));
            puts(st, out, " = ");
            put_ident(src, st, out, va, vb);
            puts(st, out, "_t27o as ");
            put_src(src, st, out, tt, tok_end(src, tt));
            puts(st, out, ";");
        }
        stmts(src, st, out, M_STMT);
        close_block(src, st, out);
    }
}

pub fn return_stmt(src: []const u8, st: []usize, out: []u8) -> void {
    step(src, st);
    puts(st, out, "return");
    if (!at(src, st[P], ";") and !at(src, st[P], "}") and !at(src, st[P], ",")) {
        puts(st, out, " ");
        expr(src, st, out, false);
    }
    take(src, st, ";");
    puts(st, out, ";");
}

pub fn jump_stmt(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    step(src, st);
    if (!at(src, st[P], ";") and !at(src, st[P], "}") and !at(src, st[P], ",")) {
        refuse_here(src, st, R_LABEL);
        return;
    }
    put_src(src, st, out, a, b);
    take(src, st, ";");
    puts(st, out, ";");
}

/// The scrutinee of a match: the temporary `m<line>` when it calls something, else its text again.
pub fn put_scrut(src: []const u8, st: []usize, out: []u8, sa: usize, tmp: usize, wrapit: bool) -> void {
    if (tmp > 0) {
        puts(st, out, "m");
        put_num(st, out, tmp);
        return;
    }
    const save : usize = st[P];
    const w0 : usize = st[W];
    st[P] = sa;
    expr(src, st, out, true);
    st[P] = save;
    if (wrapit) { wrap(st, out, w0); }
}

/// One pattern of a match arm as a condition on the scrutinee.
pub fn pattern(src: []const u8, st: []usize, out: []u8, sa: usize, tmp: usize, wrapit: bool) -> void {
    const a : usize = st[P];
    const b : usize = tok_end(src, a);
    if (a >= src.len) {
        refuse(st, R_SYNTAX, a, a, b);
        return;
    }
    const c : u8 = src[a];
    if (str_tok(src, a)) {
        puts(st, out, "t27o_eq(");
        put_scrut(src, st, out, sa, tmp, wrapit);
        puts(st, out, ", ");
        primary(src, st, out, true);
        puts(st, out, ")");
        st[NEQ] = 1;
        return;
    }
    if (c == B_MINUS or is_digit(c) or c == B_APOS or (c == B_LOWER_B and b > a + 1 and src[a + 1] == B_APOS)) {
        var e : usize = b;
        if (c == B_MINUS) { e = tok_end(src, skip_ws(src, b)); }
        if (tok_is(src, skip_ws(src, e), "..=")) {
            puts(st, out, "(");
            put_scrut(src, st, out, sa, tmp, wrapit);
            puts(st, out, " >= ");
            unary(src, st, out, true);
            want(src, st, "..=");
            puts(st, out, " and ");
            put_scrut(src, st, out, sa, tmp, wrapit);
            puts(st, out, " <= ");
            unary(src, st, out, true);
            puts(st, out, ")");
            return;
        }
        put_scrut(src, st, out, sa, tmp, wrapit);
        puts(st, out, " == ");
        unary(src, st, out, true);
        return;
    }
    if (word_is(src, a, b, "true") or word_is(src, a, b, "false")) {
        put_scrut(src, st, out, sa, tmp, wrapit);
        puts(st, out, " == ");
        put_src(src, st, out, a, b);
        step(src, st);
        return;
    }
    if (word_is(src, a, b, "None")) {
        put_scrut(src, st, out, sa, tmp, wrapit);
        puts(st, out, " == null");
        step(src, st);
        return;
    }
    if (!is_alpha(c)) {
        refuse(st, R_PATTERN, a, a, b);
        return;
    }
    step(src, st);
    if (at(src, st[P], "::")) {
        step(src, st);
        const ma : usize = st[P];
        const mb : usize = tok_end(src, ma);
        if (ma >= src.len or !is_alpha(src[ma])) {
            refuse(st, R_PATTERN, a, a, mb);
            return;
        }
        step(src, st);
        if (at(src, st[P], "(") or at(src, st[P], "{") or at(src, st[P], "::")) {
            refuse(st, R_DATA, a, a, mb);
            return;
        }
        put_scrut(src, st, out, sa, tmp, wrapit);
        puts(st, out, " == ");
        put_owner(src, st, out, a, b);
        if (upper_const(src, ma, mb)) { puts(st, out, "_"); } else { puts(st, out, "."); }
        put_src(src, st, out, ma, mb);
        return;
    }
    if (is_upper(c) and !at(src, st[P], "(") and !at(src, st[P], "{")) {
        put_scrut(src, st, out, sa, tmp, wrapit);
        puts(st, out, " == ");
        put_ident(src, st, out, a, b);
        return;
    }
    refuse(st, R_PATTERN, a, a, b);
}

pub fn patterns(src: []const u8, st: []usize, out: []u8, sa: usize, tmp: usize, wrapit: bool) -> void {
    var n : usize = 0;
    var more : bool = true;
    while (more and live(src, st[P], st[ERR])) {
        if (n > 0) { puts(st, out, " or "); }
        pattern(src, st, out, sa, tmp, wrapit);
        n = n + 1;
        more = take(src, st, "|");
    }
}

/// The value of a match arm or of a branch written without braces.
pub fn arm_expr(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    const a : usize = st[P];
    const b : usize = tok_end(src, a);
    if (word_is(src, a, b, "return")) {
        return_stmt(src, st, out);
    } else if (word_is(src, a, b, "break") or word_is(src, a, b, "continue")) {
        jump_stmt(src, st, out, a, b);
    } else if (word_is(src, a, b, "if")) {
        if_stmt(src, st, out, mode);
    } else if (word_is(src, a, b, "match")) {
        match_stmt(src, st, out, mode);
    } else if (is_alpha(head(src, st[P])) and peek_is(src, st[P], "!")) {
        macro_stmt(src, st, out, a, b);
    } else if (at(src, st[P], "(") and peek_is(src, st[P], ")")) {
        step(src, st);
        step(src, st);
    } else {
        const w0 : usize = st[W];
        expr_stmt(src, st, out);
        tail_of(src, st, out, w0, mode);
    }
}

/// `match` as an if-chain; Rust checked the match is exhaustive, so its last arm is the `else`.
pub fn match_stmt(src: []const u8, st: []usize, out: []u8, mode: u8) -> void {
    const mpos : usize = st[P];
    step(src, st);
    const sa : usize = st[P];
    const w0 : usize = st[W];
    expr(src, st, out, true);
    if (bad(st[ERR])) { return; }
    const calls : bool = out_has(st[W], out, w0, B_LPAREN);
    const wrapit : bool = out_has(st[W], out, w0, B_SPACE);
    st[W] = w0;
    var tmp : usize = 0;
    if (calls) {
        tmp = line_of(src, mpos);
        puts(st, out, "const m");
        put_num(st, out, tmp);
        puts(st, out, " = ");
        st[P] = sa;
        expr(src, st, out, true);
        puts(st, out, ";");
        newline(st, out);
    }
    if (!take(src, st, "{")) {
        refuse_here(src, st, R_SYNTAX);
        return;
    }
    var first_arm : bool = true;
    while (live(src, st[P], st[ERR]) and !at(src, st[P], "}")) {
        const aa : usize = st[P];
        const ab : usize = tok_end(src, aa);
        const ae : usize = skip_arm(src, aa);
        const last : bool = ae >= src.len or src[ae] == B_RBRACE;
        const arrow : usize = find_tok(src, aa, "=>");
        const guard : usize = find_tok(src, aa, "if");
        if (arrow >= src.len or guard < arrow) {
            refuse(st, R_PATTERN, aa, aa, ab);
            return;
        }
        const single : bool = skip_ws(src, ab) == arrow;
        const wild : bool = single and word_is(src, aa, ab, "_");
        const bind : bool = single and last and !wild and src[aa] >= B_LOWER_A and src[aa] <= B_LOWER_Z and !word_is(src, aa, ab, "true") and !word_is(src, aa, ab, "false");
        if (wild or bind or (last and !first_arm)) {
            if (first_arm) { puts(st, out, "if (true) "); } else { puts(st, out, " else "); }
            st[P] = arrow;
        } else {
            if (first_arm) { puts(st, out, "if ("); } else { puts(st, out, " else if ("); }
            patterns(src, st, out, sa, tmp, wrapit);
            puts(st, out, ") ");
        }
        want(src, st, "=>");
        if (bad(st[ERR])) { return; }
        const braced : bool = at(src, st[P], "{");
        if (braced) {
            step(src, st);
        }
        puts(st, out, "{");
        st[IND] = st[IND] + 1;
        if (bind) {
            newline(st, out);
            puts(st, out, "const ");
            put_ident(src, st, out, aa, ab);
            puts(st, out, " = ");
            put_scrut(src, st, out, sa, tmp, false);
            puts(st, out, ";");
        }
        if (braced) {
            stmts(src, st, out, mode);
        } else {
            newline(st, out);
            arm_expr(src, st, out, mode);
        }
        st[IND] = st[IND] - 1;
        newline(st, out);
        puts(st, out, "}");
        if (braced) { want(src, st, "}"); }
        take(src, st, ",");
        first_arm = false;
    }
    want(src, st, "}");
}

/// assert!, assert_eq! and assert_ne! (and their debug_ forms) as `assert`; the message is dropped.
/// Any other macro is refused.
pub fn macro_stmt(src: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    const plain : bool = word_is(src, a, b, "assert") or word_is(src, a, b, "debug_assert");
    const eq : bool = word_is(src, a, b, "assert_eq") or word_is(src, a, b, "debug_assert_eq");
    const ne : bool = word_is(src, a, b, "assert_ne") or word_is(src, a, b, "debug_assert_ne");
    if (!plain and !eq and !ne) {
        refuse(st, R_MACRO, a, a, b);
        return;
    }
    step(src, st);
    step(src, st);
    want(src, st, "(");
    puts(st, out, "assert(");
    if (plain) {
        expr(src, st, out, false);
    } else {
        const w0 : usize = st[W];
        const l : usize = expr(src, st, out, false);
        const lstr : bool = out_at(st[W], out, w0) == B_QUOTE;
        want(src, st, ",");
        if (lstr or str_tok(src, st[P])) {
            if (ne) { insert(st, out, w0, "!t27o_eq("); } else { insert(st, out, w0, "t27o_eq("); }
            puts(st, out, ", ");
            expr(src, st, out, false);
            puts(st, out, ")");
            st[NEQ] = 1;
        } else {
            if (!keep_bare(l, L_CMP, true)) { wrap(st, out, w0); }
            if (eq) { puts(st, out, " == "); } else { puts(st, out, " != "); }
            const r0 : usize = st[W];
            const r : usize = expr(src, st, out, false);
            if (!keep_bare(r, L_CMP, false)) { wrap(st, out, r0); }
        }
    }
    if (take(src, st, ",")) {
        const close : usize = find_at(src, st[P], B_RPAREN);
        if (close < src.len) { st[P] = close; }
    }
    want(src, st, ")");
    puts(st, out, ")");
    take(src, st, ";");
    puts(st, out, ";");
}

// ---------------------------------------------------------------- items

/// The `///` lines right above the item that starts at src[p], written as they are (L3 kept).
pub fn put_docs(src: []const u8, st: []usize, out: []u8, p: usize) -> void {
    if (st[MODE] != M_T27) { return; }
    var ls : usize = p;
    while (ls > 0 and src[ls - 1] != B_NL) {
        if (src[ls - 1] != B_SPACE and src[ls - 1] != B_TAB) { return; }
        ls = ls - 1;
    }
    var top : usize = ls;
    var more : bool = true;
    while (more and top > 0) {
        const nl : usize = top - 1;
        var a : usize = nl;
        while (a > 0 and src[a - 1] != B_NL) { a = a - 1; }
        var t : usize = a;
        while (t < nl and (src[t] == B_SPACE or src[t] == B_TAB)) { t = t + 1; }
        if (t + 3 <= nl and src[t] == B_SLASH and src[t + 1] == B_SLASH and src[t + 2] == B_SLASH and (t + 3 >= nl or src[t + 3] != B_SLASH)) {
            top = a;
        } else {
            more = false;
        }
    }
    var q : usize = top;
    while (q < ls) {
        var e : usize = q;
        while (e < ls and src[e] != B_NL) { e = e + 1; }
        var t2 : usize = q;
        while (t2 < e and (src[t2] == B_SPACE or src[t2] == B_TAB)) { t2 = t2 + 1; }
        var hi : usize = e;
        while (hi > t2 and (src[hi - 1] == B_CR or src[hi - 1] == B_SPACE)) { hi = hi - 1; }
        put_text(src, st, out, t2, hi, hi - t2);
        puts(st, out, "\n");
        q = e + 1;
    }
}

/// Why the refusal in the state was made, with the source text it names.
pub fn put_reason(src: []const u8, st: []usize, out: []u8) -> void {
    const c : usize = st[ERR];
    if (c == R_GENERIC) {
        puts(st, out, "generics");
    } else if (c == R_TRAIT) {
        puts(st, out, "trait impl");
    } else if (c == R_CLOSURE) {
        puts(st, out, "closure");
    } else if (c == R_TRY) {
        puts(st, out, "? operator");
    } else if (c == R_MACRO) {
        puts(st, out, "macro");
    } else if (c == R_TYPE) {
        puts(st, out, "type");
    } else if (c == R_METHOD) {
        puts(st, out, "method");
    } else if (c == R_TUPLE) {
        puts(st, out, "tuple");
    } else if (c == R_IFLET) {
        puts(st, out, "if let / while let");
    } else if (c == R_ITER) {
        puts(st, out, "for over an iterator");
    } else if (c == R_PATTERN) {
        puts(st, out, "match pattern");
    } else if (c == R_MUTREF) {
        puts(st, out, "&mut of a value");
    } else if (c == R_DEREF) {
        puts(st, out, "deref");
    } else if (c == R_VALUE) {
        puts(st, out, "block as a value");
    } else if (c == R_LITERAL) {
        puts(st, out, "literal");
    } else if (c == R_LABEL) {
        puts(st, out, "label or break value");
    } else if (c == R_ITEM) {
        puts(st, out, "item");
    } else if (c == R_UNSAFE) {
        puts(st, out, "unsafe");
    } else if (c == R_PATH) {
        puts(st, out, "path");
    } else if (c == R_WHERE) {
        puts(st, out, "where clause");
    } else if (c == R_SELFMUT) {
        puts(st, out, "mut self");
    } else if (c == R_UPDATE) {
        puts(st, out, "struct update");
    } else if (c == R_DATA) {
        puts(st, out, "enum variant with data");
    } else if (c == R_DEPENDS) {
        puts(st, out, "uses refused");
    } else if (c == R_EXTERNAL) {
        puts(st, out, "uses external");
    } else if (c == R_UNDECL) {
        puts(st, out, "undeclared");
    } else {
        puts(st, out, "syntax");
    }
    puts(st, out, " `");
    put_text(src, st, out, st[NLO], st[NHI], 40);
    puts(st, out, "` at line ");
    put_num(st, out, line_of(src, st[AT]));
}

/// The comment that stands where a refused item was.
pub fn put_refusal(src: []const u8, st: []usize, out: []u8, what: []const u8, na: usize, nb: usize, pos: usize) -> void {
    puts(st, out, "// t27o: refused ");
    puts(st, out, what);
    puts(st, out, " ");
    put_text(src, st, out, na, nb, 60);
    puts(st, out, " (line ");
    put_num(st, out, line_of(src, pos));
    puts(st, out, "): ");
    put_reason(src, st, out);
    puts(st, out, "\n\n");
}

/// Skip a whole item that is refused, counting the fns it holds as refused.
pub fn skip_refused(src: []const u8, st: []usize, out: []u8, start: usize, a: usize, b: usize, code: usize) -> void {
    const end : usize = skip_item(src, start);
    const nf : usize = count_fns(src, start, end);
    st[NFN] = st[NFN] + nf;
    st[ERR] = 0;
    refuse(st, code, a, a, b);
    if (st[MODE] == M_T27) {
        puts(st, out, "// t27o: refused ");
        put_text(src, st, out, a, b, 40);
        puts(st, out, " (line ");
        put_num(st, out, line_of(src, a));
        puts(st, out, "): ");
        put_reason(src, st, out);
        if (nf > 0) {
            puts(st, out, "; ");
            put_num(st, out, nf);
            puts(st, out, " fn inside");
        }
        puts(st, out, "\n\n");
    }
    st[ERR] = 0;
    st[P] = end;
}

/// A derive the oracle harness can compile without crates.
pub fn std_derive(src: []const u8, a: usize, b: usize) -> bool {
    return word_is(src, a, b, "Debug") or word_is(src, a, b, "Clone") or word_is(src, a, b, "Copy") or word_is(src, a, b, "PartialEq") or word_is(src, a, b, "Eq") or word_is(src, a, b, "Hash") or word_is(src, a, b, "PartialOrd") or word_is(src, a, b, "Ord") or word_is(src, a, b, "Default");
}

/// The Rust text of an item for the oracle harness: attributes dropped (serde and the like need their
/// crates), `#[derive(..)]` kept with its std derives only.
pub fn put_item_source(src: []const u8, st: []usize, out: []u8, start: usize, end: usize) -> void {
    var from : usize = start;
    var q : usize = start;
    while (q < end) {
        const e : usize = tok_end(src, q);
        const lb : usize = skip_ws(src, e);
        if (word_is(src, q, e, "#") and tok_is(src, lb, "[")) {
            put_src(src, st, out, from, q);
            const close : usize = block_end(src, lb);
            const d : usize = skip_ws(src, lb + 1);
            const lp : usize = skip_ws(src, tok_end(src, d));
            if (tok_is(src, d, "derive") and tok_is(src, lp, "(")) {
                var n : usize = 0;
                var t : usize = skip_ws(src, lp + 1);
                while (t < close) {
                    const te : usize = tok_end(src, t);
                    if (is_alpha(src[t]) and std_derive(src, t, te)) {
                        if (n == 0) { puts(st, out, "#[derive("); } else { puts(st, out, ", "); }
                        put_src(src, st, out, t, te);
                        n = n + 1;
                    }
                    t = skip_ws(src, te);
                }
                if (n > 0) { puts(st, out, ")]"); }
            }
            from = close;
            q = skip_ws(src, close);
        } else {
            q = skip_ws(src, e);
        }
    }
    put_src(src, st, out, from, end);
}

/// After a struct, enum or const item: in M_SOURCE its Rust text replaces the t27, in M_CALLS it
/// writes nothing; a refused one writes its refusal only in M_T27.
pub fn item_done(src: []const u8, st: []usize, out: []u8, what: []const u8, start: usize, w0: usize, na: usize, nb: usize, kpos: usize) -> void {
    if (bad(st[ERR])) {
        st[W] = w0;
        if (st[MODE] == M_T27) { put_refusal(src, st, out, what, na, nb, kpos); }
        return;
    }
    if (st[MODE] != M_T27) { st[W] = w0; }
    if (st[MODE] == M_SOURCE) {
        put_item_source(src, st, out, start, item_end(src, start));
        puts(st, out, "\n\n");
    }
}

/// `<'a, 'b>` is dropped; any other generic parameter list is refused.
pub fn generics(src: []const u8, st: []usize) -> void {
    const lt : usize = st[P];
    step(src, st);
    var depth : usize = 1;
    var lifetimes : bool = true;
    while (st[P] < src.len and depth > 0) {
        const a : usize = st[P];
        const b : usize = tok_end(src, a);
        if (word_is(src, a, b, "<")) {
            depth = depth + 1;
        } else if (word_is(src, a, b, ">")) {
            depth = depth - 1;
        } else if (word_is(src, a, b, ">>")) {
            if (depth >= 2) { depth = depth - 2; } else { depth = 0; }
        } else if (src[a] != B_APOS and !word_is(src, a, b, ",")) {
            lifetimes = false;
        }
        step(src, st);
    }
    if (!lifetimes) { refuse(st, R_GENERIC, lt, lt, lt + 1); }
}

/// One parameter: `name: T`, `mut name: T` (as `name_in: T`), or self.
pub fn param(src: []const u8, st: []usize, out: []u8) -> void {
    const pa : usize = st[P];
    const amp : bool = take(src, st, "&");
    if (amp and head(src, st[P]) == B_APOS) { step(src, st); }
    const m : bool = take(src, st, "mut");
    if (at(src, st[P], "self")) {
        if (st[ILO] == st[IHI]) {
            refuse_here(src, st, R_SYNTAX);
            return;
        }
        if (m and !amp) {
            refuse(st, R_SELFMUT, pa, pa, tok_end(src, st[P]));
            return;
        }
        step(src, st);
        if (at(src, st[P], ":")) {
            refuse_here(src, st, R_SYNTAX);
            return;
        }
        puts(st, out, "self");
        if (st[STUBBING] == 1) { puts(st, out, "_"); }
        // &mut self is a pointer to the struct
        if (m) {
            puts(st, out, ": *");
            st[SELFMUT] = 1;
        } else {
            puts(st, out, ": ");
        }
        put_impl(src, st, out);
        return;
    }
    const na : usize = st[P];
    const nb : usize = tok_end(src, na);
    if (amp or na >= src.len or !is_alpha(src[na]) or word_is(src, na, nb, "_")) {
        refuse(st, R_PATTERN, pa, pa, nb);
        return;
    }
    step(src, st);
    want(src, st, ":");
    put_ident(src, st, out, na, nb);
    if (m) { puts(st, out, "_in"); }
    puts(st, out, ": ");
    ty(src, st, out);
}

pub fn params(src: []const u8, st: []usize, out: []u8) -> void {
    want(src, st, "(");
    var n : usize = 0;
    while (live(src, st[P], st[ERR]) and !at(src, st[P], ")")) {
        if (n > 0) { puts(st, out, ", "); }
        param(src, st, out);
        n = n + 1;
        if (!take(src, st, ",") and !at(src, st[P], ")")) { refuse_here(src, st, R_SYNTAX); }
    }
    want(src, st, ")");
}

/// `var x : T = x_in;` for each `mut x: T` parameter of the list that starts at src[pa].
pub fn mut_params(src: []const u8, st: []usize, out: []u8, pa: usize) -> void {
    const save : usize = st[P];
    st[P] = skip_ws(src, pa + 1);
    while (live(src, st[P], st[ERR]) and !at(src, st[P], ")")) {
        if (take(src, st, "mut") and !at(src, st[P], "self")) {
            const na : usize = st[P];
            const nb : usize = tok_end(src, na);
            step(src, st);
            want(src, st, ":");
            newline(st, out);
            puts(st, out, "var ");
            put_ident(src, st, out, na, nb);
            puts(st, out, " : ");
            ty(src, st, out);
            puts(st, out, " = ");
            put_ident(src, st, out, na, nb);
            puts(st, out, "_in;");
        } else {
            const nx : usize = find_at(src, st[P], B_COMMA);
            if (nx >= src.len) {
                st[P] = find_at(src, st[P], B_RPAREN);
            } else {
                st[P] = skip_ws(src, nx + 1);
            }
        }
        take(src, st, ",");
    }
    st[P] = save;
}

/// Does a token of src[lo .. hi] read the name src[a .. b]?
pub fn mentions(src: []const u8, lo: usize, hi: usize, a: usize, b: usize) -> bool {
    var q : usize = lo;
    while (q < hi) {
        const e : usize = tok_end(src, q);
        if (same_text(src, q, e, a, b)) { return true; }
        q = skip_ws(src, e);
    }
    return false;
}

/// `_ = p;` for each parameter of the list at src[pa] that the body src[lo .. hi] never reads: Rust
/// only warns about it, Zig refuses it. A `mut` parameter is read by its `var` line.
pub fn unused_params(src: []const u8, st: []usize, out: []u8, pa: usize, lo: usize, hi: usize) -> void {
    var q : usize = skip_ws(src, pa + 1);
    while (q < src.len and !tok_is(src, q, ")")) {
        var n : usize = q;
        if (tok_is(src, n, "&")) { n = skip_ws(src, n + 1); }
        if (n < src.len and src[n] == B_APOS) { n = skip_ws(src, tok_end(src, n)); }
        var value_mut : bool = false;
        if (tok_is(src, n, "mut")) {
            n = skip_ws(src, tok_end(src, n));
            value_mut = !tok_is(src, n, "self");
        }
        const ne : usize = tok_end(src, n);
        const named : bool = n < src.len and is_alpha(src[n]) and !value_mut and !word_is(src, n, ne, "_");
        if (named and !mentions(src, lo, hi, n, ne)) {
            newline(st, out);
            puts(st, out, "_ = ");
            put_ident(src, st, out, n, ne);
            puts(st, out, ";");
        }
        const comma : usize = find_at(src, q, B_COMMA);
        if (comma >= src.len) { q = src.len; } else { q = skip_ws(src, comma + 1); }
    }
}

/// `[pub] fn [Type_]name(params) -> R` from the parameter list on; what the body's tail becomes.
pub fn fn_head(src: []const u8, st: []usize, out: []u8, is_pub: bool, na: usize, nb: usize) -> u8 {
    if (is_pub) { puts(st, out, "pub fn "); } else { puts(st, out, "fn "); }
    if (st[ILO] != st[IHI]) {
        put_impl(src, st, out);
        puts(st, out, "_");
    }
    put_ident(src, st, out, na, nb);
    puts(st, out, "(");
    params(src, st, out);
    puts(st, out, ")");
    var mode : u8 = M_STMT;
    if (take(src, st, "->")) {
        puts(st, out, " -> ");
        if (!at(src, st[P], "(") or !peek_is(src, st[P], ")")) { mode = M_RET; }
        ty(src, st, out);
    } else {
        puts(st, out, " -> void");
    }
    return mode;
}

/// The skeleton of a refused fn: its signature with an empty body (t27's declared, not implemented),
/// when the signature converts and names nothing refused. No converted fn or test calls it: those
/// that would are refused with it, so the spec still compiles.
pub fn stub(src: []const u8, st: []usize, out: []u8, is_pub: bool, na: usize, nb: usize, pn: usize, fpos: usize) -> void {
    const sw : usize = st[W];
    st[ERR] = 0;
    st[P] = pn;
    if (at(src, st[P], "<")) { generics(src, st); }
    st[STUBBING] = 1;
    fn_head(src, st, out, is_pub, na, nb);
    st[STUBBING] = 0;
    if (!bad(st[ERR])) { deps(src, st, fpos, st[P]); }
    if (bad(st[ERR]) or !at(src, st[P], "{")) {
        st[W] = sw;
        st[ERR] = 0;
        return;
    }
    puts(st, out, " {\n}\n\n");
    st[NSTUB] = st[NSTUB] + 1;
}

/// What the oracle samples for a parameter or a result of the type at src[q], V_NONE when it does not.
pub fn vkind(src: []const u8, q: usize) -> usize {
    const e : usize = tok_end(src, q);
    if (word_is(src, q, e, "u8") or word_is(src, q, e, "u16") or word_is(src, q, e, "u32") or word_is(src, q, e, "u64") or word_is(src, q, e, "u128") or word_is(src, q, e, "usize")) { return V_UNSIGNED; }
    if (word_is(src, q, e, "i8") or word_is(src, q, e, "i16") or word_is(src, q, e, "i32") or word_is(src, q, e, "i64") or word_is(src, q, e, "i128") or word_is(src, q, e, "isize")) { return V_SIGNED; }
    if (word_is(src, q, e, "bool")) { return V_BOOL; }
    if (word_is(src, q, e, "f32") or word_is(src, q, e, "f64")) { return V_FLOAT; }
    if (word_is(src, q, e, "&")) {
        var r : usize = skip_ws(src, e);
        if (r < src.len and src[r] == B_APOS) { r = skip_ws(src, tok_end(src, r)); }
        if (tok_is(src, r, "str")) { return V_STR; }
        const u : usize = skip_ws(src, tok_end(src, r));
        if (tok_is(src, r, "[") and tok_is(src, u, "u8") and tok_is(src, skip_ws(src, tok_end(src, u)), "]")) { return V_BYTES; }
    }
    return V_NONE;
}

/// The `{` of `enum <name> {` in the file, src.len when there is none.
pub fn find_enum(src: []const u8, a: usize, b: usize) -> usize {
    var q : usize = skip_ws(src, 0);
    while (q < src.len) {
        const e : usize = tok_end(src, q);
        const n : usize = skip_ws(src, e);
        const ne : usize = tok_end(src, n);
        if (word_is(src, q, e, "enum") and same_text(src, n, ne, a, b) and tok_is(src, skip_ws(src, ne), "{")) { return skip_ws(src, ne); }
        q = skip_ws(src, e);
    }
    return src.len;
}

/// The name of variant k of the enum whose body opens at src[lb] (k counted modulo the variants), or
/// with `count` set, how many variants it has.
pub fn enum_variant(src: []const u8, lb: usize, k: usize, count: bool) -> usize {
    var n : usize = 0;
    var first : usize = src.len;
    var q : usize = skip_ws(src, lb + 1);
    while (q < src.len and !tok_is(src, q, "}")) {
        while (tok_is(src, q, "#")) { q = skip_ws(src, block_end(src, skip_ws(src, q + 1))); }
        if (n == 0) { first = q; }
        if (!count and n == k) { return q; }
        n = n + 1;
        const comma : usize = find_at(src, q, B_COMMA);
        if (comma >= src.len) { q = src.len; } else { q = skip_ws(src, comma + 1); }
    }
    if (count) { return n; }
    if (n == 0) { return src.len; }
    return enum_variant(src, lb, k % n, false);
}

/// How many sample values the oracle has for a kind (for an enum, its variants).
pub fn vlen(src: []const u8, kind: usize, tq: usize) -> usize {
    if (kind == V_ENUM) { return enum_variant(src, tq, 0, true); }
    if (kind == V_BOOL) { return 2; }
    if (kind == V_FLOAT or kind == V_BYTES) { return 5; }
    if (kind == V_STR) { return 8; }
    return 7;
}

/// A quote: `"` in Rust source, `\"` inside the format string that prints the t27 line.
pub fn put_quote(st: []usize, out: []u8, rust: bool) -> void {
    if (!rust) { puts(st, out, "\\"); }
    puts(st, out, "\"");
}

/// Sample value `idx` of a kind (the type at src[tq] for integer limits, the enum body for a
/// variant): small values, the edges of the type, short texts, every variant. The same literal reads
/// the same in Rust and in t27, but for a variant: `E::V` there, `E.V` here.
pub fn put_value(src: []const u8, st: []usize, out: []u8, kind: usize, tq: usize, idx: usize, rust: bool) -> void {
    const k : usize = idx % vlen(src, kind, tq);
    if (kind == V_ENUM) {
        const v : usize = enum_variant(src, tq, k, false);
        put_impl(src, st, out);
        if (rust) { puts(st, out, "::"); } else { puts(st, out, "."); }
        put_src(src, st, out, v, tok_end(src, v));
        return;
    }
    if (kind == V_UNSIGNED or kind == V_SIGNED) {
        if (k == 0) { puts(st, out, "0"); }
        if (k == 1) { puts(st, out, "1"); }
        if (k == 2 and kind == V_UNSIGNED) { puts(st, out, "2"); }
        if (k == 2 and kind == V_SIGNED) { puts(st, out, "-1"); }
        if (k == 3) { puts(st, out, "7"); }
        if (k == 4 and kind == V_UNSIGNED) { puts(st, out, "10"); }
        if (k == 4 and kind == V_SIGNED) { puts(st, out, "-100"); }
        if (k == 5 and kind == V_UNSIGNED) { puts(st, out, "100"); }
        if (k == 5 and kind == V_SIGNED) { put_limit(src, st, out, tq, tok_end(src, tq), true); }
        if (k == 6) { put_limit(src, st, out, tq, tok_end(src, tq), kind == V_UNSIGNED); }
        return;
    }
    if (kind == V_BOOL) {
        if (k == 0) { puts(st, out, "false"); } else { puts(st, out, "true"); }
        return;
    }
    if (kind == V_FLOAT) {
        if (k == 0) { puts(st, out, "0.0"); }
        if (k == 1) { puts(st, out, "1.0"); }
        if (k == 2) { puts(st, out, "-1.5"); }
        if (k == 3) { puts(st, out, "2.5"); }
        if (k == 4) { puts(st, out, "100.0"); }
        return;
    }
    if (kind == V_BYTES and rust) { puts(st, out, "b"); }
    put_quote(st, out, rust);
    if (k == 1) { puts(st, out, "a"); }
    if (k == 2) { puts(st, out, "abc"); }
    if (k == 3) { puts(st, out, "0"); }
    if (k == 4) { puts(st, out, "42"); }
    if (k == 5) { puts(st, out, "0x1f"); }
    if (k == 6) { puts(st, out, "a b"); }
    if (k == 7) { puts(st, out, "-7"); }
    put_quote(st, out, rust);
}

/// One sampled call, parameter i taking sample j * (i + 1) + i. Rust: `Type::name(args)`, or
/// `Type::V.name(args)` for an enum's self; t27: `Type_name(args)` with the variant first.
pub fn put_call(src: []const u8, st: []usize, out: []u8, na: usize, nb: usize, n: usize, k0: usize, t0: usize, k1: usize, t1: usize, k2: usize, t2: usize, j: usize, rust: bool) -> void {
    const selfp : bool = k0 == V_ENUM;
    if (rust and selfp) {
        put_value(src, st, out, k0, t0, j, rust);
        puts(st, out, ".");
    } else if (st[ILO] != st[IHI]) {
        put_impl(src, st, out);
        if (rust) { puts(st, out, "::"); } else { puts(st, out, "_"); }
    }
    if (rust) { put_src(src, st, out, na, nb); } else { put_ident(src, st, out, na, nb); }
    puts(st, out, "(");
    var sep : bool = false;
    if (n > 0 and (!rust or !selfp)) {
        put_value(src, st, out, k0, t0, j, rust);
        sep = true;
    }
    if (n > 1) {
        if (sep) { puts(st, out, ", "); }
        put_value(src, st, out, k1, t1, j * 2 + 1, rust);
        sep = true;
    }
    if (n > 2) {
        if (sep) { puts(st, out, ", "); }
        put_value(src, st, out, k2, t2, j * 3 + 2, rust);
    }
    puts(st, out, ")");
}

/// The oracle harness's calls of a converted fn (Rust tests or not): each sample input run by the
/// original Rust, its result printed as a t27 assert; an input on which Rust panics is skipped (it
/// is outside the fn's contract). Parameters: scalars, &str, &[u8], and self of a unit enum (every
/// variant); a scalar or &str result.
pub fn vectors(src: []const u8, st: []usize, out: []u8, na: usize, nb: usize, pn: usize) -> void {
    if (!tok_is(src, pn, "(")) { return; }
    var k0 : usize = V_NONE;
    var k1 : usize = V_NONE;
    var k2 : usize = V_NONE;
    var t0 : usize = 0;
    var t1 : usize = 0;
    var t2 : usize = 0;
    var n : usize = 0;
    var ok : bool = true;
    var q : usize = skip_ws(src, pn + 1);
    // self (or &self) of a unit enum of this file
    var s : usize = q;
    if (tok_is(src, s, "&")) { s = skip_ws(src, s + 1); }
    if (tok_is(src, s, "self")) {
        t0 = find_enum(src, st[ILO], st[IHI]);
        k0 = V_ENUM;
        n = 1;
        ok = t0 < src.len and enum_variant(src, t0, 0, true) > 0;
        const c0 : usize = find_at(src, s, B_COMMA);
        if (c0 >= src.len) { q = find_at(src, s, B_RPAREN); } else { q = skip_ws(src, c0 + 1); }
    }
    while (ok and q < src.len and !tok_is(src, q, ")")) {
        const ne : usize = tok_end(src, q);
        const colon : usize = skip_ws(src, ne);
        const tq : usize = skip_ws(src, tok_end(src, colon));
        const kind : usize = vkind(src, tq);
        if (!is_alpha(src[q]) or word_is(src, q, ne, "self") or word_is(src, q, ne, "mut") or !tok_is(src, colon, ":") or kind == V_NONE or n >= 3) { ok = false; }
        if (n == 0) {
            k0 = kind;
            t0 = tq;
        }
        if (n == 1) {
            k1 = kind;
            t1 = tq;
        }
        if (n == 2) {
            k2 = kind;
            t2 = tq;
        }
        n = n + 1;
        const comma : usize = find_at(src, tq, B_COMMA);
        if (comma >= src.len) { q = find_at(src, tq, B_RPAREN); } else { q = skip_ws(src, comma + 1); }
    }
    if (!ok or q >= src.len) { return; }
    const arrow : usize = skip_ws(src, tok_end(src, q));
    const rq : usize = skip_ws(src, tok_end(src, arrow));
    const rk : usize = vkind(src, rq);
    if (!tok_is(src, arrow, "->") or rk == V_NONE or rk == V_BYTES) { return; }
    var nv : usize = 1;
    if (n > 0) { nv = vlen(src, k0, t0); }
    if (n > 1 and vlen(src, k1, t1) > nv) { nv = vlen(src, k1, t1); }
    if (n > 2 and vlen(src, k2, t2) > nv) { nv = vlen(src, k2, t2); }
    if (rk == V_STR) { st[NEQ] = 1; }
    puts(st, out, "    {\n        let mut v: Vec<String> = Vec::new();\n");
    var j : usize = 0;
    while (j < nv) {
        puts(st, out, "        if let Ok(r) = std::panic::catch_unwind(|| ");
        put_call(src, st, out, na, nb, n, k0, t0, k1, t1, k2, t2, j, true);
        puts(st, out, ") { ");
        if (rk == V_FLOAT) { puts(st, out, "if r.is_finite() { "); }
        puts(st, out, "v.push(format!(\"    assert(");
        if (rk == V_STR) { puts(st, out, "t27o_eq("); }
        put_call(src, st, out, na, nb, n, k0, t0, k1, t1, k2, t2, j, false);
        if (rk == V_STR) { puts(st, out, ", {:?}));\", r)); "); } else { puts(st, out, " == {:?});\", r)); "); }
        if (rk == V_FLOAT) { puts(st, out, "} "); }
        puts(st, out, "}\n");
        j = j + 1;
    }
    puts(st, out, "        if !v.is_empty() { println!(\"test oracle_");
    if (st[ILO] != st[IHI]) {
        put_impl(src, st, out);
        puts(st, out, "_");
    }
    put_src(src, st, out, na, nb);
    puts(st, out, " {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n");
}

pub fn fn_item(src: []const u8, st: []usize, out: []u8, start: usize, is_test: bool, is_pub: bool) -> void {
    const fpos : usize = st[P];
    const end : usize = skip_item(src, start);
    st[NFN] = st[NFN] + 1;
    if (is_test) { st[NTS] = st[NTS] + 1; }
    const w0 : usize = st[W];
    st[ERR] = 0;
    st[IND] = 0;
    st[FLO] = fpos;
    st[SELFMUT] = 0;
    put_docs(src, st, out, start);
    step(src, st);
    const na : usize = st[P];
    const nb : usize = tok_end(src, na);
    step(src, st);
    const pn : usize = st[P];
    if (at(src, st[P], "<")) { generics(src, st); }
    if (is_test) {
        puts(st, out, "test ");
        put_src(src, st, out, na, nb);
        puts(st, out, " ");
        want(src, st, "(");
        want(src, st, ")");
        if (at(src, st[P], "->")) { refuse_here(src, st, R_SYNTAX); }
        block(src, st, out, M_STMT);
    } else {
        const pa : usize = st[P];
        const mode : u8 = fn_head(src, st, out, is_pub, na, nb);
        if (at(src, st[P], "where")) { refuse_here(src, st, R_WHERE); }
        puts(st, out, " ");
        if (open_block(src, st, out)) {
            unused_params(src, st, out, pa, st[P], end);
            mut_params(src, st, out, pa);
            stmts(src, st, out, mode);
            close_block(src, st, out);
        }
    }
    if (!bad(st[ERR])) { deps(src, st, fpos, end); }
    if (bad(st[ERR])) {
        st[W] = w0;
        if (st[MODE] == M_T27) {
            put_refusal(src, st, out, "fn", na, nb, fpos);
            if (!is_test) { stub(src, st, out, is_pub, na, nb, pn, fpos); }
        }
        st[ERR] = 0;
        st[IND] = 0;
        st[P] = end;
        if (!is_test and st[ILO] != st[IHI]) { add_name(src, st, K_MEMBER, na, nb, st[ILO], st[IHI]); }
        if (!is_test and st[ILO] == st[IHI]) { add_name(src, st, K_FN, na, nb, 0, 0); }
        return;
    }
    st[NOK] = st[NOK] + 1;
    if (is_test) { st[NTEST] = st[NTEST] + 1; }
    if (st[MODE] == M_T27) { puts(st, out, "\n\n"); } else { st[W] = w0; }
    if (st[MODE] == M_SOURCE and !is_test) {
        put_item_source(src, st, out, start, item_end(src, start));
        puts(st, out, "\n\n");
    }
    if (st[MODE] == M_CALLS and !is_test) { vectors(src, st, out, na, nb, pn); }
    st[P] = end;
}

/// `const` and `static` (not `static mut`) as `const`; in an impl block as `Type_NAME`.
pub fn const_item(src: []const u8, st: []usize, out: []u8, start: usize, is_pub: bool) -> void {
    const kpos : usize = st[P];
    const w0 : usize = st[W];
    st[ERR] = 0;
    st[FLO] = kpos;
    put_docs(src, st, out, start);
    step(src, st);
    if (at(src, st[P], "mut")) { refuse_here(src, st, R_ITEM); }
    const na : usize = st[P];
    const nb : usize = tok_end(src, na);
    step(src, st);
    if (is_pub) { puts(st, out, "pub const "); } else { puts(st, out, "const "); }
    if (st[ILO] != st[IHI]) {
        put_impl(src, st, out);
        puts(st, out, "_");
    }
    put_ident(src, st, out, na, nb);
    want(src, st, ":");
    puts(st, out, " : ");
    ty(src, st, out);
    want(src, st, "=");
    puts(st, out, " = ");
    expr(src, st, out, false);
    want(src, st, ";");
    puts(st, out, ";\n\n");
    if (!bad(st[ERR])) { deps(src, st, kpos, skip_item(src, start)); }
    const refused : bool = bad(st[ERR]);
    item_done(src, st, out, "const", start, w0, na, nb, kpos);
    st[ERR] = 0;
    st[P] = skip_item(src, start);
    if (refused and st[ILO] != st[IHI]) { add_name(src, st, K_MEMBER, na, nb, st[ILO], st[IHI]); }
    if (refused and st[ILO] == st[IHI]) { add_name(src, st, K_ITEM, na, nb, 0, 0); }
}

/// Skip `#[...]` attributes before a field or a variant.
pub fn skip_attrs(src: []const u8, st: []usize) -> void {
    while (live(src, st[P], st[ERR]) and head(src, st[P]) == B_HASH) {
        step(src, st);
        if (at(src, st[P], "[")) { st[P] = skip_ws(src, block_end(src, st[P])); }
    }
}

pub fn struct_item(src: []const u8, st: []usize, out: []u8, start: usize, is_pub: bool) -> void {
    const kpos : usize = st[P];
    const w0 : usize = st[W];
    st[ERR] = 0;
    st[IND] = 0;
    put_docs(src, st, out, start);
    step(src, st);
    const na : usize = st[P];
    const nb : usize = tok_end(src, na);
    step(src, st);
    if (is_pub) { puts(st, out, "pub const "); } else { puts(st, out, "const "); }
    put_ident(src, st, out, na, nb);
    puts(st, out, " = struct ");
    if (at(src, st[P], "<")) {
        refuse_here(src, st, R_GENERIC);
    } else if (at(src, st[P], "(")) {
        refuse_here(src, st, R_TUPLE);
    } else if (take(src, st, ";")) {
        puts(st, out, "{};\n\n");
        item_done(src, st, out, "struct", start, w0, na, nb, kpos);
        return;
    }
    if (open_block(src, st, out)) {
        while (live(src, st[P], st[ERR]) and !at(src, st[P], "}")) {
            skip_attrs(src, st);
            if (take(src, st, "pub") and at(src, st[P], "(")) { st[P] = skip_ws(src, block_end(src, st[P])); }
            const fa : usize = st[P];
            const fb : usize = tok_end(src, fa);
            step(src, st);
            want(src, st, ":");
            newline(st, out);
            put_ident(src, st, out, fa, fb);
            puts(st, out, " : ");
            ty(src, st, out);
            puts(st, out, ",");
            if (!take(src, st, ",") and !at(src, st[P], "}")) { refuse_here(src, st, R_SYNTAX); }
        }
        close_block(src, st, out);
    }
    puts(st, out, ";\n\n");
    if (!bad(st[ERR])) { deps(src, st, kpos, skip_item(src, start)); }
    const refused : bool = bad(st[ERR]);
    item_done(src, st, out, "struct", start, w0, na, nb, kpos);
    st[ERR] = 0;
    st[IND] = 0;
    st[P] = skip_item(src, start);
    if (refused) { add_name(src, st, K_ITEM, na, nb, 0, 0); }
}

pub fn enum_item(src: []const u8, st: []usize, out: []u8, start: usize, is_pub: bool) -> void {
    const kpos : usize = st[P];
    const w0 : usize = st[W];
    st[ERR] = 0;
    st[IND] = 0;
    put_docs(src, st, out, start);
    step(src, st);
    const na : usize = st[P];
    const nb : usize = tok_end(src, na);
    step(src, st);
    if (at(src, st[P], "<")) { refuse_here(src, st, R_GENERIC); }
    if (is_pub) { puts(st, out, "pub const "); } else { puts(st, out, "const "); }
    put_ident(src, st, out, na, nb);
    puts(st, out, " = enum(u32) ");
    if (open_block(src, st, out)) {
        while (live(src, st[P], st[ERR]) and !at(src, st[P], "}")) {
            skip_attrs(src, st);
            const va : usize = st[P];
            const vb : usize = tok_end(src, va);
            step(src, st);
            if (at(src, st[P], "(") or at(src, st[P], "{")) { refuse(st, R_DATA, va, va, vb); }
            newline(st, out);
            put_ident(src, st, out, va, vb);
            if (take(src, st, "=")) {
                puts(st, out, " = ");
                expr(src, st, out, false);
            }
            puts(st, out, ",");
            if (!take(src, st, ",") and !at(src, st[P], "}")) { refuse_here(src, st, R_SYNTAX); }
        }
        close_block(src, st, out);
    }
    puts(st, out, ";\n\n");
    const refused : bool = bad(st[ERR]);
    item_done(src, st, out, "enum", start, w0, na, nb, kpos);
    st[ERR] = 0;
    st[IND] = 0;
    st[P] = skip_item(src, start);
    if (refused) { add_name(src, st, K_ITEM, na, nb, 0, 0); }
}

/// An inherent impl block: its fns and consts as items named `Type_name`.
/// A trait impl, a generic one or one t27o cannot read is refused whole, its fns recorded as refused
/// members of the type; lifetime parameters (`impl<'a> Lower<'a>`) are dropped.
pub fn impl_item(src: []const u8, st: []usize, out: []u8, start: usize) -> void {
    const ipos : usize = st[P];
    step(src, st);
    if (at(src, st[P], "<")) { generics(src, st); }
    const ta : usize = st[P];
    const tb : usize = tok_end(src, ta);
    const lb : usize = find_at(src, ta, B_LBRACE);
    const fr : usize = find_tok(src, ta, "for");
    if (lb >= src.len) {
        st[ERR] = 0;
        skip_refused(src, st, out, start, ipos, tok_end(src, ipos), R_SYNTAX);
        return;
    }
    const close : usize = block_end(src, lb);
    if (bad(st[ERR])) {
        st[ERR] = 0;
        record_fns(src, st, lb, close, ta, tb);
        skip_refused(src, st, out, start, ipos, tok_end(src, ipos), R_GENERIC);
        return;
    }
    if (fr < lb) {
        const ya : usize = skip_ws(src, tok_end(src, fr));
        record_fns(src, st, lb, close, ya, tok_end(src, ya));
        var th : usize = fr;
        while (th > ta and is_space(src[th - 1])) { th = th - 1; }
        skip_refused(src, st, out, start, ta, th, R_TRAIT);
        return;
    }
    step(src, st);
    if (at(src, st[P], "<")) { generics(src, st); }
    if (bad(st[ERR]) or st[P] != lb) {
        st[ERR] = 0;
        record_fns(src, st, lb, close, ta, tb);
        skip_refused(src, st, out, start, ta, tb, R_GENERIC);
        return;
    }
    step(src, st);
    const w0 : usize = st[W];
    if (st[MODE] == M_SOURCE) {
        put_src(src, st, out, start, lb + 1);
        puts(st, out, "\n");
    }
    const wi : usize = st[W];
    const olo : usize = st[ILO];
    const ohi : usize = st[IHI];
    st[ILO] = ta;
    st[IHI] = tb;
    items(src, st, out, true);
    st[ILO] = olo;
    st[IHI] = ohi;
    take(src, st, "}");
    // the harness keeps the block only around a member that converted
    if (st[MODE] == M_SOURCE and st[W] == wi) { st[W] = w0; }
    if (st[MODE] == M_SOURCE and st[W] != w0) { puts(st, out, "}\n\n"); }
}

pub fn item(src: []const u8, st: []usize, out: []u8) -> void {
    st[ERR] = 0;
    const start : usize = st[P];
    var is_test : bool = false;
    var is_pub : bool = false;
    var gated : usize = 0;
    while (st[P] < src.len and head(src, st[P]) == B_HASH) {
        step(src, st);
        take(src, st, "!");
        if (at(src, st[P], "[")) {
            const close : usize = block_end(src, st[P]);
            const ia : usize = skip_ws(src, st[P] + 1);
            const ie : usize = tok_end(src, ia);
            if (word_is(src, ia, ie, "test") and skip_ws(src, ie) + 1 == close) { is_test = true; }
            // #[cfg(..)] other than cfg(test): one of several variants, which t27o cannot choose
            const ip : usize = skip_ws(src, ie);
            if (word_is(src, ia, ie, "cfg") and !tok_is(src, skip_ws(src, tok_end(src, ip)), "test")) { gated = ia; }
            st[P] = skip_ws(src, close);
        }
    }
    if (gated > 0) {
        var kw : usize = st[P];
        if (tok_is(src, kw, "pub")) { kw = skip_ws(src, tok_end(src, kw)); }
        if (tok_is(src, kw, "(")) { kw = skip_ws(src, block_end(src, kw)); }
        if (tok_is(src, kw, "const") and tok_is(src, skip_ws(src, tok_end(src, kw)), "fn")) { kw = skip_ws(src, tok_end(src, kw)); }
        const gn : usize = skip_ws(src, tok_end(src, kw));
        const fnk : bool = tok_is(src, kw, "fn");
        if (fnk and st[ILO] != st[IHI]) { add_name(src, st, K_MEMBER, gn, tok_end(src, gn), st[ILO], st[IHI]); }
        if (fnk and st[ILO] == st[IHI]) { add_name(src, st, K_FN, gn, tok_end(src, gn), 0, 0); }
        if (!fnk and gn < src.len and is_alpha(src[gn])) { add_name(src, st, K_ITEM, gn, tok_end(src, gn), 0, 0); }
        skip_refused(src, st, out, start, gated, tok_end(src, gated), R_ITEM);
        return;
    }
    if (take(src, st, "pub")) {
        is_pub = true;
        if (at(src, st[P], "(")) { st[P] = skip_ws(src, block_end(src, st[P])); }
    }
    if (at(src, st[P], "const") and peek_is(src, st[P], "fn")) { step(src, st); }
    const a : usize = st[P];
    const b : usize = tok_end(src, a);
    if (a >= src.len) { return; }
    if (word_is(src, a, b, "use") or (word_is(src, a, b, "extern") and peek_is(src, st[P], "crate"))) {
        const end : usize = skip_item(src, start);
        if (word_is(src, a, b, "use")) { use_names(src, st, a, end); }
        st[P] = end;
    } else if (word_is(src, a, b, "mod")) {
        step(src, st);
        step(src, st);
        if (take(src, st, "{")) {
            items(src, st, out, true);
            take(src, st, "}");
        } else {
            take(src, st, ";");
        }
    } else if (word_is(src, a, b, "fn")) {
        fn_item(src, st, out, start, is_test, is_pub);
    } else if (word_is(src, a, b, "const") or word_is(src, a, b, "static")) {
        const_item(src, st, out, start, is_pub);
    } else if (word_is(src, a, b, "struct")) {
        struct_item(src, st, out, start, is_pub);
    } else if (word_is(src, a, b, "enum")) {
        enum_item(src, st, out, start, is_pub);
    } else if (word_is(src, a, b, "impl")) {
        impl_item(src, st, out, start);
    } else {
        // trait, type, union, static mut, macro_rules ...: its name is refused with it
        var n : usize = skip_ws(src, b);
        if (tok_is(src, n, "mut")) { n = skip_ws(src, tok_end(src, n)); }
        if (n < src.len and is_alpha(src[n])) { add_name(src, st, K_ITEM, n, tok_end(src, n), 0, 0); }
        skip_refused(src, st, out, start, a, b, R_ITEM);
    }
}

/// Items up to the end of the source, or up to the `}` that closes a mod or impl block.
pub fn items(src: []const u8, st: []usize, out: []u8, nested: bool) -> void {
    while (st[P] < src.len and (!nested or !at(src, st[P], "}"))) {
        const before : usize = st[P];
        item(src, st, out);
        if (st[P] <= before) { st[P] = skip_ws(src, tok_end(src, before)); }
    }
}

// ---------------------------------------------------------------- the converter

pub fn clear(st: []usize) -> void {
    var i : usize = 0;
    while (i < STATE) {
        st[i] = 0;
        i = i + 1;
    }
}

/// The helper a converted `==` on text calls.
pub fn put_helpers(st: []usize, out: []u8) -> void {
    if (st[NEQ] != 0) {
        puts(st, out, "/// Byte equality of two texts (t27o's `==` on &str).\nfn t27o_eq(a: []const u8, b: []const u8) -> bool {\n    if (a.len != b.len) {\n        return false;\n    }\n    var i : usize = 0;\n    while (i < a.len) {\n        if (a[i] != b[i]) {\n            return false;\n        }\n        i += 1;\n    }\n    return true;\n}\n\n");
    }
}

/// The report line: functions seen, converted (tests among them), refused, coverage.
pub fn put_report(st: []usize, out: []u8) -> void {
    puts(st, out, "// t27o: ");
    put_num(st, out, st[NFN]);
    puts(st, out, " fn seen, ");
    put_num(st, out, st[NOK]);
    puts(st, out, " converted (");
    put_num(st, out, st[NTEST]);
    puts(st, out, " of ");
    put_num(st, out, st[NTS]);
    puts(st, out, " tests), ");
    put_num(st, out, st[NFN] - st[NOK]);
    puts(st, out, " refused (");
    put_num(st, out, st[NSTUB]);
    puts(st, out, " kept as stubs); coverage ");
    if (st[NFN] == 0) { puts(st, out, "100"); } else { put_num(st, out, st[NOK] * 100 / st[NFN]); }
    puts(st, out, "%\n");
}

/// One pass over the source: the output starts over, the name table is kept.
pub fn one_pass(src: []const u8, name: []const u8, out: []u8, st: []usize, whole: bool) -> void {
    const n : usize = st[NNAMES];
    clear(st);
    st[NNAMES] = n;
    if (whole) {
        puts(st, out, "// SPDX-License-Identifier: Apache-2.0\n; ");
        puts(st, out, name);
        puts(st, out, ".t27 -- converted from Rust by t27o (Ouroboros), specs/tools/t27o/rust_convert.t27; read it before it lands.\n; ASCII only (L3)\n\nmodule ");
        puts(st, out, name);
        puts(st, out, ";\n\n");
    }
    st[P] = skip_ws(src, 0);
    items(src, st, out, false);
    put_helpers(st, out);
    if (whole) { put_report(st, out); }
}

/// Passes until no new name is refused: an item that uses a refused one is refused in the next pass,
/// in whatever order the file declares them. The table only grows, so this ends.
pub fn passes(src: []const u8, name: []const u8, out: []u8, st: []usize, whole: bool) -> usize {
    clear(st);
    var grew : bool = true;
    var rounds : usize = 0;
    while (grew and rounds < 16) {
        const before : usize = st[NNAMES];
        one_pass(src, name, out, st, whole);
        grew = st[NNAMES] != before;
        rounds = rounds + 1;
    }
    return st[W];
}

/// The items of `src` as t27, with no header and no report (what the tests below compare).
pub fn body(src: []const u8, out: []u8, st: []usize) -> usize {
    return passes(src, "", out, st, false);
}

/// The Rust source `src` as the t27 spec `module <name>;`. The state vector holds STATE slots and the
/// name table (NAME_SLOTS a name). The result is the size of the output; the buffer was too small when
/// it is above out.len.
pub fn convert(src: []const u8, name: []const u8, out: []u8, st: []usize) -> usize {
    return passes(src, name, out, st, true);
}

/// The oracle harness for `src`: a Rust program made of the original text of every item t27o
/// converts (they use nothing else, so it compiles alone) and a main that runs each converted fn on
/// sample inputs and prints the results as t27 `test oracle_<fn>` blocks.
/// rustc runs it once on the lab; its output appended to the converted spec is the fn's behaviour,
/// which the t27 bodies must reproduce.
pub fn oracle(src: []const u8, out: []u8, st: []usize) -> usize {
    passes(src, "", out, st, false);
    const n : usize = st[NNAMES];
    const has_eq : bool = st[NEQ] != 0;
    clear(st);
    st[NNAMES] = n;
    st[MODE] = M_SOURCE;
    puts(st, out, "// t27o oracle harness (specs/tools/t27o/rust_convert.t27): the converted items, run to record\n// their behaviour as t27 tests.\n#![allow(warnings)]\n\n");
    st[P] = skip_ws(src, 0);
    items(src, st, out, false);
    const w : usize = st[W];
    clear(st);
    st[NNAMES] = n;
    st[W] = w;
    st[MODE] = M_CALLS;
    puts(st, out, "fn main() {\n    std::panic::set_hook(Box::new(|_| {}));\n");
    st[P] = skip_ws(src, 0);
    items(src, st, out, false);
    // a text result is compared through t27o_eq; print it when the spec does not define it already
    if (st[NEQ] != 0 and !has_eq) {
        puts(st, out, "    print!(\"{}\", r#\"");
        st[NEQ] = 1;
        put_helpers(st, out);
        puts(st, out, "\"#);\n");
    }
    puts(st, out, "}\n");
    st[MODE] = M_T27;
    return st[W];
}

// ---------------------------------------------------------------- tests
// Each test converts a Rust snippet and compares the whole output text (out_is).

test tokens_split_as_rust_reads_them {
    assert(tok_end("fn f", 0) == 2);
    assert(tok_end("0..n", 0) == 1);
    assert(tok_end("1.5e-3f64 x", 0) == 9);
    assert(tok_end("0xFFu8;", 0) == 6);
    assert(tok_end("b'a' x", 0) == 4);
    assert(tok_end("'a: loop", 0) == 2);
    assert(tok_end("'\\n'", 0) == 4);
    assert(tok_end("\"a\\\"b\" x", 0) == 6);
    assert(tok_end("..= x", 0) == 3);
    assert(tok_end("<<= x", 0) == 3);
    assert(tok_end("::x", 0) == 2);
    assert(skip_ws("  // c\n /* a /* b */ */ x", 0) == 24);
}

test the_tail_expression_returns {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("pub fn add(a: u32, b: u32) -> u32 { a + b * 2 }", &out, &st);
    assert(out_is(n, &out, 0, "pub fn add(a: u32, b: u32) -> u32 {\n    return a + b * 2;\n}\n\n"));
    assert(st[NOK] == 1);
}

test let_while_if_and_compound_assignment {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn count(s: &str, c: u8) -> usize {\n    let b = s.as_bytes();\n    let mut i = 0;\n    let mut k: usize = 0;\n    while i < b.len() {\n        if b[i] == c && i > 0 { k += 1; } else if b[i] == b'x' { k -= 1; }\n        i += 1;\n    }\n    k\n}", &out, &st);
    assert(out_is(n, &out, 0, "fn count(s: []const u8, c: u8) -> usize {\n    const b = s;\n    var i = 0;\n    var k : usize = 0;\n    while (i < b.len) {\n        if (b[i] == c and i > 0) {\n            k += 1;\n        } else if (b[i] == 'x') {\n            k -= 1;\n        }\n        i += 1;\n    }\n    return k;\n}\n\n"));
}

test precedence_is_kept_with_parentheses {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn f(a: u32, b: u32) -> bool { a & 3 == b as u32 * 2 || !(a < b) }", &out, &st);
    assert(out_is(n, &out, 0, "fn f(a: u32, b: u32) -> bool {\n    return (a & 3) == (b as u32) * 2 or ((a < b) == false);\n}\n\n"));
}

test for_over_a_range_and_a_typed_bound {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn s(v: &[u32], n: u32) -> u32 { let mut t = 0u32; for i in 0..v.len() { t += v[i]; } for j in 1..=n { t += j; } t }", &out, &st);
    assert(out_is(n, &out, 0, "fn s(v: []const u32, n: u32) -> u32 {\n    var t : u32 = 0;\n    for i in 0..v.len {\n        t += v[i];\n    }\n    for j_t27o in 1..n + 1 {\n        const j : u32 = j_t27o as u32;\n        t += j;\n    }\n    return t;\n}\n\n"));
}

test match_becomes_an_if_chain {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn k(c: u8) -> u32 { match c { b'0'..=b'9' => 1, b'a' | b'b' => 2, _ => 0 } }", &out, &st);
    assert(out_is(n, &out, 0, "fn k(c: u8) -> u32 {\n    if ((c >= '0' and c <= '9')) {\n        return 1;\n    } else if (c == 'a' or c == 'b') {\n        return 2;\n    } else {\n        return 0;\n    }\n}\n\n"));
}

test an_enum_match_ends_in_else {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("enum Trit { Neg, Zero, Pos }\nfn v(t: Trit) -> i8 { match t { Trit::Neg => -1, Trit::Zero => 0, Trit::Pos => 1 } }", &out, &st);
    assert(out_is(n, &out, 0, "const Trit = enum(u32) {\n    Neg,\n    Zero,\n    Pos,\n};\n\nfn v(t: Trit) -> i8 {\n    if (t == Trit.Neg) {\n        return -1;\n    } else if (t == Trit.Zero) {\n        return 0;\n    } else {\n        return 1;\n    }\n}\n\n"));
}

test a_struct_and_its_methods {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("pub struct Pt { pub x: u32, y: u32 }\nimpl Pt {\n    pub fn new(x: u32) -> Self { Pt { x, y: 0 } }\n    pub fn sum(&self) -> u32 { self.x + self.y }\n}\nfn t() -> u32 { Pt::new(2).sum() }", &out, &st);
    assert(out_is(n, &out, 0, "pub const Pt = struct {\n    x : u32,\n    y : u32,\n};\n\npub fn Pt_new(x: u32) -> Pt {\n    return Pt{ .x = x, .y = 0 };\n}\n\npub fn Pt_sum(self: Pt) -> u32 {\n    return self.x + self.y;\n}\n\nfn t() -> u32 {\n    return Pt_sum(Pt_new(2));\n}\n\n"));
}

test rust_tests_become_t27_tests {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("pub fn add(a: u32, b: u32) -> u32 { a + b }\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn adds() {\n        assert_eq!(add(1, 2), 3, \"sum\");\n        assert!(add(0, 0) == 0);\n        assert_ne!(name(), \"x\");\n    }\n    fn name() -> &'static str { \"y\" }\n}", &out, &st);
    assert(out_is(n, &out, 0, "pub fn add(a: u32, b: u32) -> u32 {\n    return a + b;\n}\n\ntest adds {\n    assert(add(1, 2) == 3);\n    assert(add(0, 0) == 0);\n    assert(!t27o_eq(name(), \"x\"));\n}\n\nfn name() -> []const u8 {\n    return \"y\";\n}\n\n/// Byte equality of two texts (t27o's `==` on &str).\nfn t27o_eq(a: []const u8, b: []const u8) -> bool {\n    if (a.len != b.len) {\n        return false;\n    }\n    var i : usize = 0;\n    while (i < a.len) {\n        if (a[i] != b[i]) {\n            return false;\n        }\n        i += 1;\n    }\n    return true;\n}\n\n"));
    assert(st[NTEST] == 1);
    assert(st[NTS] == 1);
}

test option_and_a_typed_value_match {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn d(v: Option<u8>) -> u8 {\n    let r: u8 = match v.is_some() { true => v.unwrap(), false => 0 };\n    if v.is_none() { return 9; }\n    r\n}", &out, &st);
    assert(out_is(n, &out, 0, "fn d(v: ?u8) -> u8 {\n    var r : u8 = undefined;\n    const m2 = (v != null);\n    if (m2 == true) {\n        r = v.?;\n    } else {\n        r = 0;\n    }\n    if ((v == null)) {\n        return 9;\n    }\n    return r;\n}\n\n"));
}

test refusals_name_the_construct_and_its_line {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn ok() -> u8 { 1 }\n/// Doc.\nfn bad(v: &[u8]) -> usize {\n    v.iter().count()\n}\nimpl Display for Pt { fn fmt(&self) {} }\nfn g<T>(x: T) {}\nfn tt() -> u8 { Wrap(1).0 }", &out, &st);
    assert(out_is(n, &out, 0, "fn ok() -> u8 {\n    return 1;\n}\n\n// t27o: refused fn bad (line 3): method `iter` at line 4\n\nfn bad(v: []const u8) -> usize {\n}\n\n// t27o: refused Display (line 6): trait impl `Display` at line 6; 1 fn inside\n\n// t27o: refused fn g (line 7): generics `<` at line 7\n\n// t27o: refused fn tt (line 8): tuple `Wrap` at line 8\n\nfn tt() -> u8 {\n}\n\n"));
    assert(st[NFN] == 5);
    assert(st[NOK] == 1);
    assert(st[NSTUB] == 2);
}

test normalisation_reaches_the_subset {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("struct Acc { n: u32 }\nimpl Acc {\n    fn add(&mut self, v: u32) { self.n += v; }\n    fn get(&self) -> u32 { self.n }\n    fn bump(&mut self) { self.add(1); let k = self.get(); self.n = k; }\n}\nfn sum(v: &[u32]) -> u32 {\n    let mut a = Acc { n: 0 };\n    for x in v.iter() { a.add(*x); }\n    for (i, &x) in v.iter().enumerate() { if i > 0 { a.add(x); } }\n    a.get()\n}\nfn first(o: Option<u32>) -> u32 {\n    if let Some(v) = o { return v; }\n    0\n}", &out, &st);
    assert(out_is(n, &out, 0, "const Acc = struct {\n    n : u32,\n};\n\nfn Acc_add(self: *Acc, v: u32) -> void {\n    self.n += v;\n}\n\nfn Acc_get(self: Acc) -> u32 {\n    return self.n;\n}\n\nfn Acc_bump(self: *Acc) -> void {\n    Acc_add(self, 1);\n    const k = Acc_get(self.*);\n    self.n = k;\n}\n\nfn sum(v: []const u32) -> u32 {\n    var a = Acc{ .n = 0 };\n    for x in v {\n        Acc_add(&a, x);\n    }\n    for i in 0..v.len {\n        const x = v[i];\n        if (i > 0) {\n            Acc_add(&a, x);\n        }\n    }\n    return Acc_get(a);\n}\n\nfn first(o: ?u32) -> u32 {\n    if (o != null) {\n        const v = o.?;\n        return v;\n    }\n    return 0;\n}\n\n"));
    assert(st[NOK] == 5);
}

test the_oracle_harness_runs_the_original_rust {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = oracle("fn neg(b: bool) -> bool { !b }\n#[test]\nfn t() { assert!(neg(false)); }", &out, &st);
    assert(out_is(n, &out, 0, "// t27o oracle harness (specs/tools/t27o/rust_convert.t27): the converted items, run to record\n// their behaviour as t27 tests.\n#![allow(warnings)]\n\nfn neg(b: bool) -> bool { !b }\n\nfn main() {\n    std::panic::set_hook(Box::new(|_| {}));\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| neg(false)) { v.push(format!(\"    assert(neg(false) == {:?});\", r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| neg(true)) { v.push(format!(\"    assert(neg(true) == {:?});\", r)); }\n        if !v.is_empty() { println!(\"test oracle_neg {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n}\n"));
    // self of a unit enum runs over every variant; a text result is compared through t27o_eq
    const n2 : usize = oracle("enum K { A, B }\nimpl K {\n    fn name(&self) -> &'static str { match self { K::A => \"a\", K::B => \"b\" } }\n}", &out, &st);
    assert(out_is(n2, &out, 0, "// t27o oracle harness (specs/tools/t27o/rust_convert.t27): the converted items, run to record\n// their behaviour as t27 tests.\n#![allow(warnings)]\n\nenum K { A, B }\n\nimpl K {\nfn name(&self) -> &'static str { match self { K::A => \"a\", K::B => \"b\" } }\n\n}\n\nfn main() {\n    std::panic::set_hook(Box::new(|_| {}));\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| K::A.name()) { v.push(format!(\"    assert(t27o_eq(K_name(K.A), {:?}));\", r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| K::B.name()) { v.push(format!(\"    assert(t27o_eq(K_name(K.B), {:?}));\", r)); }\n        if !v.is_empty() { println!(\"test oracle_K_name {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n    print!(\"{}\", r#\"/// Byte equality of two texts (t27o's `==` on &str).\nfn t27o_eq(a: []const u8, b: []const u8) -> bool {\n    if (a.len != b.len) {\n        return false;\n    }\n    var i : usize = 0;\n    while (i < a.len) {\n        if (a[i] != b[i]) {\n            return false;\n        }\n        i += 1;\n    }\n    return true;\n}\n\n\"#);\n}\n"));
}

test refusals_cascade_to_their_users {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("use other::Thing;\nfn a() -> u32 { b() + 1 }\nfn b() -> u32 { let v: Vec<u8> = Vec::new(); 0 }\nfn c(t: Thing) -> u32 { 0 }\nfn d() -> u32 { gone(1) }\nfn e() -> u32 { a() }", &out, &st);
    assert(out_is(n, &out, 0, "// t27o: refused fn a (line 2): uses refused `b` at line 2\n\nfn a() -> u32 {\n}\n\n// t27o: refused fn b (line 3): type `Vec` at line 3\n\nfn b() -> u32 {\n}\n\n// t27o: refused fn c (line 4): uses external `Thing` at line 4\n\n// t27o: refused fn d (line 5): undeclared `gone` at line 5\n\nfn d() -> u32 {\n}\n\n// t27o: refused fn e (line 6): uses refused `a` at line 6\n\nfn e() -> u32 {\n}\n\n"));
    assert(st[NOK] == 0);
    assert(st[NFN] == 5);
}

test the_whole_file_has_a_header_and_a_report {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = convert("/// One.\nconst ONE: u64 = 1_000;\nfn neg(x: i32) -> i32 { -x }\nfn bad() { let v = vec![1]; }", "Demo", &out, &st);
    assert(out_is(n, &out, 0, "// SPDX-License-Identifier: Apache-2.0\n; Demo.t27 -- converted from Rust by t27o (Ouroboros), specs/tools/t27o/rust_convert.t27; read it before it lands.\n; ASCII only (L3)\n\nmodule Demo;\n\n/// One.\nconst ONE : u64 = 1000;\n\nfn neg(x: i32) -> i32 {\n    return -x;\n}\n\n// t27o: refused fn bad (line 4): macro `vec` at line 4\n\nfn bad() -> void {\n}\n\n// t27o: 2 fn seen, 1 converted (0 of 0 tests), 1 refused (1 kept as stubs); coverage 50%\n"));
}

test the_output_size_is_counted_past_a_small_buffer {
    var out : [8]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn f() -> u8 { 1 }", &out, &st);
    assert(n == 32);
    // a slice expression in the file keeps gen-rust's []const u8 parameters &[u8] (has_slice)
    assert(out_is(8, out[0 .. 8], 0, "fn f() -"));
}
