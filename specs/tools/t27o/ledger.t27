// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/ledger.t27 -- the obligation ledger of a t27o conversion: one status per converted
; function, one outcome per oracle run, one verdict per file, and the key that says when a recorded
; verdict is stale. golden.t27 decides whether a whole spec is golden; this spec decides what each
; function's evidence is worth before golden.t27 counts it.
; --
; The patterns come from REA (morluto/rea b83b9ca, read as a reference, not linked):
;   - an empty set of obligations is unknown, never ready (src/domain/
;     reconstructionObligationLedgerIntegrity.ts:62). t27o printed "coverage 100%" for a file
;     with no fn at all; rust_convert.t27 put_report now prints unknown there and points here;
;   - one status per function by a fixed precedence: out of scope, blocked, contradicted,
;     unknown, unowned, then implemented or verified (ReconstructionObligationLedgerEvaluation.ts:452);
;   - oracle outcomes pass, fail, unknown, unsupported, truncated, skipped, and only pass counts
;     (docs/reconstruction-readiness.md:47). The t27o harness drops a sample on a panic, a
;     non-finite float or an unprintable string without counting it; a dropped sample makes the
;     run truncated, not passed;
;   - a weaker proof never closes a stronger requirement (ReconstructionObligationAuthority.ts:15):
;     a translated test does not stand in for the oracle where the oracle is required;
;   - a recorded verdict is keyed by the source digest, the converter version and the std table
;     version; a change of any one makes it stale (reconstructionCoverage.ts:101).
; --
; Unknown is not absent: every function below that lacks the facts to decide returns an UNKNOWN
; value with its own name, and no UNKNOWN is ever counted as verified or ready.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oLedger;

; --- Oracle outcomes. Only ORC_PASS counts as evidence. ----------------------------------------

pub const ORC_PASS : u32 = 0;
pub const ORC_FAIL : u32 = 1;
pub const ORC_UNKNOWN : u32 = 2;
pub const ORC_UNSUPPORTED : u32 = 3;
pub const ORC_TRUNCATED : u32 = 4;
pub const ORC_SKIPPED : u32 = 5;
pub const ORC_NAMES : [6]str = ["pass", "fail", "unknown", "unsupported", "truncated", "skipped"];

; --- Proof strength, weakest first. A proof satisfies a requirement of equal or lower strength. --

pub const PROOF_NONE : u32 = 0;
; The body was replaced by an existing t27 fn with the same input and output contract (#8963).
pub const PROOF_REUSE : u32 = 1;
; A translated #[test] passed against the converted body.
pub const PROOF_TEST : u32 = 2;
; Every sample the oracle (the original compiled by rustc) produced agreed with the converted body.
pub const PROOF_ORACLE : u32 = 3;

; --- Function status, in the order of precedence fn_status() applies. -------------------------

pub const FN_OUT_OF_SCOPE : u32 = 0;
pub const FN_BLOCKED : u32 = 1;
pub const FN_CONTRADICTED : u32 = 2;
pub const FN_UNKNOWN : u32 = 3;
pub const FN_UNOWNED : u32 = 4;
pub const FN_IMPLEMENTED : u32 = 5;
pub const FN_VERIFIED : u32 = 6;
pub const FN_NAMES : [7]str = [
    "out of scope: a #[cfg] variant that is off on the default host",
    "blocked: the converter refused the body",
    "contradicted: an oracle sample or a translated test disagreed",
    "unknown: the oracle run was truncated or could not decide",
    "unowned: kept as a stub, there is no body to check",
    "implemented: converted, but no proof as strong as required",
    "verified: converted, with a proof as strong as required",
];

; --- Ledger verdict of one converted file. ---------------------------------------------------

pub const L_READY : u32 = 0;
pub const L_OPEN : u32 = 1;
pub const L_FAILED : u32 = 2;
pub const L_UNKNOWN : u32 = 3;
pub const L_NAMES : [4]str = ["ready", "open", "failed", "unknown"];

; --- Recorded-verdict key. Bump a version whenever its table or its rules change. -------------

pub const CONVERTER_VERSION : u32 = 1;
pub const STD_TABLE_VERSION : u32 = 1;
pub const K_FRESH : u32 = 0;
pub const K_NONE : u32 = 1;
pub const K_STALE_SOURCE : u32 = 2;
pub const K_STALE_CONVERTER : u32 = 3;
pub const K_STALE_STD : u32 = 4;

; --- Which runner judges a converted spec (#10525). -------------------------------------------
; `tri t27o --check` runs `t27b test` (t27b's native JIT) on the spec it wrote, and `t27c
; test-report` (the reference, through Zig) only when t27b's run decided nothing. On rust_std.t27
; the two gave the same 10/10 verdict in 0.89 s and 94 s (2026-10-18, the loaded bench Mac). Only
; exit 0 (every test passed) and 1 (a test failed) are a verdict on the converted code; the other
; codes are cli/t27b/README.md's "Exit codes" table, and each says t27b could not judge the spec.

pub const T27B_PASS : i32 = 0;
pub const T27B_FAIL : i32 = 1;
pub const T27B_UNSUPPORTED : i32 = 2;
pub const T27B_FRONT_END : i32 = 3;
pub const T27B_DISAGREE : i32 = 4;
pub const T27B_CODEGEN_LIMIT : i32 = 5;

; --- Which front end reads a file, and what `--check` and `--oracle` mean for a Zig file (#10823) ----------
; By its extension: a .zig file goes to zig_convert.t27, any other file to rust_convert.t27 (a netlist is
; spice_convert.t27's, and `tri t27o` sends it there before it asks). `tri t27o` and `tri t27o-sweep` both ask
; front_end, so the two cannot disagree about a file.
; A Rust file is judged twice: by its translated tests and by an oracle, the original compiled by rustc and run on
; sampled inputs. A Zig file has no such harness: its own tests ARE the oracle, translated into the spec, and
; `t27b test` runs them (judged as above, t27b_outcome and needs_reference). So `--oracle` has nothing to run for a
; Zig file, and `--check` has evidence only when at least one test of the file converted: a spec with none passes
; `t27b test` as 0 of 0, and a pass that ran nothing is no verdict (#10497; oracle_outcome with nothing sampled is
; ORC_SKIPPED, never ORC_PASS). EXIT_UNJUDGED is outside t27b's table (0 .. 5), so no verdict of t27b is mistaken for it.

pub const FE_RUST : u32 = 0;
pub const FE_ZIG : u32 = 1;
pub const EXIT_UNJUDGED : i32 = 6;
pub const NOTE_ZIG_ORACLE : str = "t27o: --oracle does not apply to a .zig file: its own tests are the oracle, and --check runs them on the spec";
pub const NOTE_ZIG_UNJUDGED : str = "t27o: no test of this .zig file converted, so nothing judges the spec; a spec that ran no test is not a pass";

; The front end of a path, by its last four bytes: ".zig" is the Zig one, everything else the Rust one.
pub fn front_end(path: []const u8) -> u32 {
    if (path.len < 4) { return FE_RUST; }
    if (path[path.len - 4] == 46 and path[path.len - 3] == 122 and path[path.len - 2] == 105 and path[path.len - 1] == 103) { return FE_ZIG; }
    return FE_RUST;
}

; Does `--check` have anything to judge the spec by? A Rust file always has its oracle; a Zig file has the tests that
; converted and nothing else.
pub fn has_evidence(is_zig: bool, tests_converted: usize) -> bool {
    if (is_zig == false) { return true; }
    return tests_converted > 0;
}

; --- Decisions -------------------------------------------------------------------------------

; The oracle outcome of one `t27b test` run of a converted spec, from its exit code. A construct
; t27b lacks or a frame it cannot lay out is unsupported; a front-end error, a JIT that disagrees
; with t27b's own interpreter, and any code outside the table (usage, I/O, a signal) are unknown.
; Neither is ever a pass.
pub fn t27b_outcome(code: i32) -> u32 {
    if (code == T27B_PASS) { return ORC_PASS; }
    if (code == T27B_FAIL) { return ORC_FAIL; }
    if (code == T27B_UNSUPPORTED) { return ORC_UNSUPPORTED; }
    if (code == T27B_CODEGEN_LIMIT) { return ORC_UNSUPPORTED; }
    return ORC_UNKNOWN;
}

; Must t27c test-report run after t27b? Only when t27b's run is not a verdict.
pub fn needs_reference(outcome: u32) -> bool {
    if (outcome == ORC_PASS) { return false; }
    if (outcome == ORC_FAIL) { return false; }
    return true;
}

; One oracle run of one function. sampled inputs were drawn; agreed and disagreed are the samples
; compared; dropped are the samples the harness could not compare (panic, non-finite float,
; unprintable string). A disagreement stands even in a truncated run.
pub fn oracle_outcome(supported: bool, sampled: u32, agreed: u32, disagreed: u32, dropped: u32) -> u32 {
    if (supported == false) { return ORC_UNSUPPORTED; }
    if (disagreed > 0) { return ORC_FAIL; }
    if (sampled == 0) { return ORC_SKIPPED; }
    if (dropped > 0) { return ORC_TRUNCATED; }
    if (agreed + disagreed + dropped != sampled) { return ORC_UNKNOWN; }
    if (agreed == 0) { return ORC_UNKNOWN; }
    return ORC_PASS;
}

; The strongest proof a function holds.
pub fn proof_of(oracle: u32, tests_recorded: u32, tests_passed: u32, reused: bool) -> u32 {
    if (oracle == ORC_PASS) { return PROOF_ORACLE; }
    if (tests_recorded > 0) {
        if (tests_passed == tests_recorded) { return PROOF_TEST; }
    }
    if (reused) { return PROOF_REUSE; }
    return PROOF_NONE;
}

pub fn proof_satisfies(actual: u32, required: u32) -> bool {
    return actual >= required;
}

; The status of one function, by the fixed precedence. needs_oracle is true where a translated
; test is not enough, for example a fn with a float result.
pub fn fn_status(cfg_off: bool, refused: bool, stub: bool, oracle: u32,
                 tests_recorded: u32, tests_passed: u32, reused: bool, needs_oracle: bool) -> u32 {
    if (cfg_off) { return FN_OUT_OF_SCOPE; }
    if (refused) { return FN_BLOCKED; }
    if (oracle == ORC_FAIL) { return FN_CONTRADICTED; }
    if (tests_passed < tests_recorded) { return FN_CONTRADICTED; }
    if (oracle == ORC_TRUNCATED) { return FN_UNKNOWN; }
    if (oracle == ORC_UNKNOWN) { return FN_UNKNOWN; }
    if (stub) { return FN_UNOWNED; }
    var required : u32 = PROOF_TEST;
    if (needs_oracle) { required = PROOF_ORACLE; }
    if (proof_satisfies(proof_of(oracle, tests_recorded, tests_passed, reused), required)) { return FN_VERIFIED; }
    return FN_IMPLEMENTED;
}

; The counts a report prints must add up to the functions seen; a report whose parts do not add up
; is refused, not repaired.
pub fn summary_adds_up(total: u32, out_of_scope: u32, blocked: u32, contradicted: u32, unknown: u32,
                       unowned: u32, implemented: u32, verified: u32) -> bool {
    return out_of_scope + blocked + contradicted + unknown + unowned + implemented + verified == total;
}

; The verdict of a file from its status counts. No in-scope function is unknown, never ready.
pub fn ledger_status(total: u32, out_of_scope: u32, blocked: u32, contradicted: u32, unknown: u32,
                     unowned: u32, implemented: u32, verified: u32) -> u32 {
    if (summary_adds_up(total, out_of_scope, blocked, contradicted, unknown, unowned, implemented, verified) == false) { return L_UNKNOWN; }
    if (total == out_of_scope) { return L_UNKNOWN; }
    if (contradicted > 0) { return L_FAILED; }
    if (unknown > 0) { return L_UNKNOWN; }
    if (verified == total - out_of_scope) { return L_READY; }
    return L_OPEN;
}

; Whether a recorded verdict still holds: THE rule of staleness, from four booleans. same_source is
; the caller's comparison of the full source digests; a truncated digest is not a digest and must be
; passed as recorded == false. same_converter and same_std say the converter and the std table the
; row was made with are the ones in force: a version number compared with CONVERTER_VERSION below,
; or, for `tri t27o-sweep` (#10543), the spec_hash of rust_convert.t27's and rust_std.t27's seals
; compared with the recorded ones, so a changed converter makes every row stale with no constant to bump.
pub fn key_check(recorded: bool, same_source: bool, same_converter: bool, same_std: bool) -> u32 {
    if (recorded == false) { return K_NONE; }
    if (same_source == false) { return K_STALE_SOURCE; }
    if (same_converter == false) { return K_STALE_CONVERTER; }
    if (same_std == false) { return K_STALE_STD; }
    return K_FRESH;
}

; The same rule keyed by the two version constants.
pub fn key_state(recorded: bool, same_source: bool, converter_version: u32, std_table_version: u32) -> u32 {
    return key_check(recorded, same_source, converter_version == CONVERTER_VERSION, std_table_version == STD_TABLE_VERSION);
}

; --- `tri t27o-sweep` (#10543): t27o over a tree, with a cache of every file's result ------------
; One row per file. A row is reused only when its key holds; the glue computes the booleans by string
; equality of the SHA-256 of the file and of the two seals' spec_hash, and this spec decides. Every
; other decision of the command is below too: which files, which are too big, the coverage share,
; the kind of a refusal and whether it is a cascade, and the order of the ranking.

use tri::lab::receipt::span_is;
use tri::reseal::seal::line_stop;
use tri::reseal::seal::starts_at;
use tri::t27b::macho::put_text;

pub const SWEEP_MAX_BYTES : usize = 300000;
pub const SWEEP_TOP : usize = 15;
; The cache of the repository the command runs in, and the pieces of the cache of any other (cache_path).
pub const SWEEP_CACHE : str = "target/t27o-sweep.tsv";
pub const SWEEP_CACHE_HEAD : str = "target/t27o-sweep-";
pub const SWEEP_CACHE_TAIL : str = ".tsv";
; --repo when it is not given: the checkout the command runs in.
pub const SWEEP_HERE : str = ".";
; The two seals the keys come from, relative to the t27 checkout the command runs in (never to the
; swept repository), and what a missing one is told to do.
pub const SEAL_CONVERTER : str = ".trinity/seals/t27o_T27oRust.json";
pub const SEAL_STD : str = ".trinity/seals/t27o_T27oRustStd.json";
; A .zig row is also made with zig_convert.t27, so its converter key is the Zig seal's spec_hash joined to the Rust one's
; (zig_convert.t27 uses rust_convert.t27's helpers): a change to either converter makes every Zig row stale (#10823).
pub const SEAL_ZIG : str = ".trinity/seals/t27o_T27oZig.json";
pub const SEAL_HINT : str = "run from a t27 checkout";
; seen == 0 has no share: unknown, one above 100.0 percent, never a number inside the scale.
pub const COVERAGE_UNKNOWN : usize = 1001;
; The kind (see kind_to) of a refusal whose reason is another refusal.
pub const KIND_CASCADE : str = "uses refused";
; A cascade whose callee has no refusal in the file (a fn of another file, or a receiver: `self`, `Self`) stays a
; cascade; this is its row, apart from the root kinds (see root_of, #11122).
pub const KIND_EXTERNAL : str = "uses refused (external)";
; How many callees root_of follows before it gives up: a run of callees longer than this, or a cycle, is not attributed.
pub const ROOT_HOPS : usize = 64;
; Where a refusal line starts and where its item's line number begins: "<what> <name> (line N): <reason>".
pub const REFUSED : str = "// t27o: refused ";
pub const REF_LINE : str = " (line ";


; A row whose key holds is reused; any other state, including none, converts again.
pub fn reuse_row(state: u32) -> bool {
    return state == K_FRESH;
}

; Is this tracked path one the sweep converts: a .rs or a .zig file (#10823) with no gen/ or target/ directory above it
; (generated Rust is gen-rust of a .t27 spec, build output is neither, and a generator's Zig sits under gen/ too).
pub fn sweep_path(path: string) -> bool {
    if (path.len < 3) { return false; }
    if (span_is(path, path.len - 3, path.len, ".rs") == false and front_end(path) != FE_ZIG) { return false; }
    var from : usize = 0;
    var k : usize = 0;
    while (k < path.len) {
        if (path[k] == 47) {
            if (span_is(path, from, k, "gen")) { return false; }
            if (span_is(path, from, k, "target")) { return false; }
            from = k + 1;
        }
        k = k + 1;
    }
    return true;
}

; A file over the cap is reported as skipped, not converted: the converter has no time cap.
pub fn over_cap(size: usize, cap: usize) -> bool {
    return size > cap;
}

; --- `tri t27o-sweep --repo <dir>` (#10638): one cache per swept repository ---------------------
; A row is keyed by its path, so a cache shared by two repositories would evict the other's rows on
; every run. The default cache of a repository is named after its directory.

; Is --repo this checkout: not given, empty, or "." (with any trailing slashes). Anything else is
; another directory, "/" and ".." included.
pub fn repo_is_here(repo: string) -> bool {
    if (repo.len == 0) { return true; }
    var to : usize = repo.len;
    while (to > 0 and repo[to - 1] == 47) { to = to - 1; }
    return to == 1 and repo[0] == 46;
}

; The default cache of a repository written into out, its length: SWEEP_CACHE for this checkout, else
; target/t27o-sweep-<name>.tsv with <name> the last component of the directory, trailing slashes
; ignored. 0 when the path would not fit out: nothing is written then.
pub fn cache_path(repo: string, out: []u8) -> usize {
    if (repo_is_here(repo)) { return put_text(out, 0, SWEEP_CACHE); }
    var to : usize = repo.len;
    while (to > 0 and repo[to - 1] == 47) { to = to - 1; }
    var from : usize = to;
    while (from > 0 and repo[from - 1] != 47) { from = from - 1; }
    if (SWEEP_CACHE_HEAD.len + (to - from) + SWEEP_CACHE_TAIL.len > out.len) { return 0; }
    var w : usize = put_text(out, 0, SWEEP_CACHE_HEAD);
    var k : usize = from;
    while (k < to) {
        out[w] = repo[k];
        w = w + 1;
        k = k + 1;
    }
    return put_text(out, w, SWEEP_CACHE_TAIL);
}

; The share of functions converted, per mille. No function seen is unknown, never 1000; a count of
; converted above the count seen does not add up and is unknown too.
pub fn coverage_permille(seen: usize, converted: usize) -> usize {
    if (seen == 0) { return COVERAGE_UNKNOWN; }
    if (converted > seen) { return COVERAGE_UNKNOWN; }
    return converted * 1000 / seen;
}

pub fn coverage_known(permille: usize) -> bool {
    return permille < COVERAGE_UNKNOWN;
}

; Is the line that starts at text[at] a refusal: `// t27o: refused <what> <name> (line N): <reason> `<text>` at line M`.
; The functions below read a line of a text by the offset it starts at; a text that is one line is at 0.
pub fn is_refusal(text: string, at: usize) -> bool {
    return starts_at(text, at, REFUSED);
}

; Where the reason of the line starts: after the first "): " that follows "(line "; the line's end when there is
; none.
pub fn reason_from(text: string, at: usize) -> usize {
    const e : usize = line_stop(text, at);
    var seen_line : bool = false;
    var k : usize = at;
    while (k < e) {
        if (starts_at(text, k, "(line ")) { seen_line = true; }
        if (seen_line and starts_at(text, k, "): ")) { return k + 3; }
        k = k + 1;
    }
    return e;
}

; The kind of a refusal is the reason's words before the first backtick (the quoted text that follows
; them differs from one refusal to the next) or the first semicolon: a row of the sweep's cache separates its
; kinds with ';', and the Zig front end's "generated; convert its source spec instead" was cut in two by it and
; counted as the second half (#10823). A line with no reason is its own kind, whole.
pub fn kind_from(text: string, at: usize) -> usize {
    if (reason_from(text, at) == line_stop(text, at)) { return at; }
    return reason_from(text, at);
}

pub fn kind_to(text: string, at: usize) -> usize {
    const e : usize = line_stop(text, at);
    if (reason_from(text, at) == e) { return e; }
    var k : usize = reason_from(text, at);
    while (k < e and text[k] != 96 and text[k] != 59) { k = k + 1; }
    if (k > reason_from(text, at) and text[k - 1] == 32) { return k - 1; }
    return k;
}

; A cascade refusal is an item refused because it uses a refused one: fixing it is fixing the
; refusal it names, so it is counted apart and never ranked among the root kinds.
pub fn is_cascade(kind: string) -> bool {
    return starts_at(kind, 0, KIND_CASCADE);
}

; The order of two texts, byte by byte, a shorter prefix first: -1, 0 or 1.
pub fn text_order(a: string, b: string) -> i32 {
    var k : usize = 0;
    while (k < a.len and k < b.len) {
        if (a[k] < b[k]) { return 0 - 1; }
        if (a[k] > b[k]) { return 1; }
        k = k + 1;
    }
    if (a.len < b.len) { return 0 - 1; }
    if (a.len > b.len) { return 1; }
    return 0;
}

; The ranking of kinds: more refusals first, equal counts by the kind's text. -1 puts a before b.
pub fn rank_cmp(count_a: usize, kind_a: string, count_b: usize, kind_b: string) -> i32 {
    if (count_a > count_b) { return 0 - 1; }
    if (count_a < count_b) { return 1; }
    return text_order(kind_a, kind_b);
}

; --- A cascade is counted under its root (#11122) ---------------------------------------------------------
; "uses refused `a`" is a consequence: the fn b is refused because the item a is, and what to remove next is
; a's reason. Ranked under its own kind it hid 4,468 of the 16,057 first refusals of the five repositories
; (2026-10-19), so the converted share could not show a root blocker removed while its callers stayed refused
; for another reason. The converted text of one file holds one line per refused item,
;   // t27o: refused <what> <name> (line N): <reason> `<quoted>` at line M
; and a cascade quotes the name of the item it uses, so the root is a lookup in the same text: the first
; refusal line whose item is named so, followed while that one is a cascade too. A callee with no refusal in
; the file (a fn of another file, a receiver `self` or `Self`) ends the run at the cascade, counted apart as
; KIND_EXTERNAL; so does a cycle or a run over ROOT_HOPS. Every function below reads the line that starts
; at text[at], and `at` is the start of a refusal line (next_refusal).

; The start of the first refusal line at or after `from`; text.len when there is none. A `from` inside a line
; means the next line, so next_refusal(text, at + 1) is the refusal after the one at `at`.
pub fn next_refusal(text: string, from: usize) -> usize {
    var k : usize = from;
    if (k > 0 and k <= text.len and text[k - 1] != 10) { k = line_stop(text, k) + 1; }
    while (k < text.len) {
        if (is_refusal(text, k)) { return k; }
        k = line_stop(text, k) + 1;
    }
    return text.len;
}

; Where the item's name starts in the refusal line at `at`: after "<what> ". Items without a name
; (`unsafe`, `extern`, `std::fmt::Display`: a trait impl) have <what> and no name; the name is empty then.
pub fn item_from(text: string, at: usize) -> usize {
    const e : usize = line_stop(text, at);
    var k : usize = at + REFUSED.len;
    while (k < e and text[k] != 32) { k = k + 1; }
    if (k >= e or starts_at(text, k, REF_LINE)) { return k; }
    return k + 1;
}

; Where it ends: before " (line ". The name is empty (item_to == item_from) when the line has none.
pub fn item_to(text: string, at: usize) -> usize {
    const e : usize = line_stop(text, at);
    var k : usize = item_from(text, at);
    while (k < e and starts_at(text, k, REF_LINE) == false) { k = k + 1; }
    if (k >= e) { return item_from(text, at); }
    return k;
}

; The name a refusal quotes: the text between the first two backticks of its reason; empty when it has none.
pub fn target_from(text: string, at: usize) -> usize {
    const e : usize = line_stop(text, at);
    var k : usize = reason_from(text, at);
    while (k < e and text[k] != 96) { k = k + 1; }
    if (k < e) { return k + 1; }
    return e;
}

pub fn target_to(text: string, at: usize) -> usize {
    const e : usize = line_stop(text, at);
    var k : usize = target_from(text, at);
    while (k < e and text[k] != 96) { k = k + 1; }
    return k;
}

; The first refusal line whose item is named what the refusal at `at` quotes, byte for byte; text.len when none is,
; and when it quotes nothing (an empty name matches no item). Compared here, not by a span helper of another spec,
; none of which this spec can import as it is (measured 2026-10-20): tri::loop::tick makes `t27b test` stop on an
; unresolved name of lanes.t27, tri::network::payout pulls its network modules (a SHA-512) into the generated Rust,
; and the widgets' take []const u8 where the text here is a string (their Rust is &[u8]).
pub fn quoted_refusal(text: string, at: usize) -> usize {
    const from : usize = target_from(text, at);
    const n : usize = target_to(text, at) - from;
    if (n == 0) { return text.len; }
    var k : usize = next_refusal(text, 0);
    while (k < text.len) {
        if (item_to(text, k) - item_from(text, k) == n) {
            var i : usize = 0;
            while (i < n and text[item_from(text, k) + i] == text[from + i]) { i = i + 1; }
            if (i == n) { return k; }
        }
        k = next_refusal(text, k + 1);
    }
    return text.len;
}

; Is the refusal at `at` a cascade: its kind (kind_from .. kind_to) starts with KIND_CASCADE.
pub fn is_cascade_at(text: string, at: usize) -> bool {
    if (kind_to(text, at) - kind_from(text, at) < KIND_CASCADE.len) { return false; }
    return starts_at(text, kind_from(text, at), KIND_CASCADE);
}

; The refusal the one at `at` comes down to: itself when it is not a cascade, else the first refusal of the item it
; quotes, followed while that is a cascade. The line it stops at when the callee has no refusal in the file, when
; the run is a cycle or longer than ROOT_HOPS, is a cascade still (is_cascade_at): nothing was attributed.
pub fn root_of(text: string, at: usize) -> usize {
    var cur : usize = at;
    var hops : usize = 0;
    while (hops < ROOT_HOPS) {
        if (is_cascade_at(text, cur) == false) { return cur; }
        const next : usize = quoted_refusal(text, cur);
        if (next >= text.len) { return cur; }
        cur = next;
        hops = hops + 1;
    }
    return at;
}

; Was the refusal at `at` a cascade that root_of attributed: it is one, and the line it came down to is not.
pub fn attributed(text: string, at: usize, root: usize) -> bool {
    return is_cascade_at(text, at) and is_cascade_at(text, root) == false;
}

; A file converts whole when it has fn and every one converted. No fn is unknown, never whole (as ledger_status
; refuses an empty set); a count of converted above the count seen does not add up and is not whole either.
pub fn converts_whole(seen: usize, converted: usize) -> bool {
    return seen > 0 and converted == seen;
}

; --- Tests ----------------------------------------------------------------------------------

test an_oracle_run_passes_only_when_every_sample_agreed {
    assert(oracle_outcome(true, 64, 64, 0, 0) == ORC_PASS);
    assert(oracle_outcome(true, 64, 63, 1, 0) == ORC_FAIL);
    assert(ORC_NAMES[ORC_PASS] == "pass");
}

test a_dropped_sample_truncates_the_run_and_a_disagreement_still_fails_it {
    assert(oracle_outcome(true, 64, 60, 0, 4) == ORC_TRUNCATED);
    assert(oracle_outcome(true, 64, 59, 1, 4) == ORC_FAIL);
}

test negative_control_nothing_sampled_or_nothing_compared_is_not_a_pass {
    assert(oracle_outcome(true, 0, 0, 0, 0) == ORC_SKIPPED);
    assert(oracle_outcome(false, 64, 64, 0, 0) == ORC_UNSUPPORTED);
    assert(oracle_outcome(true, 64, 10, 0, 0) == ORC_UNKNOWN);
    assert(oracle_outcome(true, 64, 0, 0, 0) == ORC_UNKNOWN);
}

test a_weaker_proof_never_closes_a_stronger_requirement {
    assert(proof_satisfies(PROOF_ORACLE, PROOF_TEST));
    assert(proof_satisfies(PROOF_TEST, PROOF_ORACLE) == false);
    assert(proof_satisfies(PROOF_REUSE, PROOF_TEST) == false);
    assert(proof_of(ORC_SKIPPED, 3, 2, true) == PROOF_REUSE);
}

test fn_status_follows_the_precedence {
    assert(fn_status(true, true, true, ORC_FAIL, 1, 0, false, false) == FN_OUT_OF_SCOPE);
    assert(fn_status(false, true, true, ORC_FAIL, 1, 0, false, false) == FN_BLOCKED);
    assert(fn_status(false, false, true, ORC_FAIL, 0, 0, false, false) == FN_CONTRADICTED);
    assert(fn_status(false, false, false, ORC_PASS, 2, 1, false, false) == FN_CONTRADICTED);
    assert(fn_status(false, false, true, ORC_TRUNCATED, 0, 0, false, false) == FN_UNKNOWN);
    assert(fn_status(false, false, true, ORC_SKIPPED, 0, 0, false, false) == FN_UNOWNED);
}

test a_float_fn_with_only_translated_tests_is_implemented_not_verified {
    assert(fn_status(false, false, false, ORC_SKIPPED, 2, 2, false, true) == FN_IMPLEMENTED);
    assert(fn_status(false, false, false, ORC_PASS, 2, 2, false, true) == FN_VERIFIED);
    assert(fn_status(false, false, false, ORC_SKIPPED, 2, 2, false, false) == FN_VERIFIED);
    assert(fn_status(false, false, false, ORC_SKIPPED, 0, 0, true, false) == FN_IMPLEMENTED);
    assert(FN_NAMES[FN_IMPLEMENTED] == "implemented: converted, but no proof as strong as required");
}

test negative_control_a_file_with_no_in_scope_fn_is_unknown_not_ready {
    assert(ledger_status(0, 0, 0, 0, 0, 0, 0, 0) == L_UNKNOWN);
    assert(ledger_status(3, 3, 0, 0, 0, 0, 0, 0) == L_UNKNOWN);
    assert(L_NAMES[L_UNKNOWN] == "unknown");
}

test the_ledger_verdict_fails_on_a_contradiction_and_is_ready_only_when_all_are_verified {
    assert(ledger_status(5, 1, 0, 0, 0, 0, 0, 4) == L_READY);
    assert(ledger_status(5, 0, 1, 0, 0, 0, 0, 4) == L_OPEN);
    assert(ledger_status(5, 0, 1, 1, 0, 0, 0, 3) == L_FAILED);
    assert(ledger_status(5, 0, 0, 0, 1, 0, 0, 4) == L_UNKNOWN);
}

test a_summary_that_does_not_add_up_is_refused {
    assert(summary_adds_up(5, 1, 0, 0, 0, 0, 0, 4));
    assert(summary_adds_up(5, 1, 0, 0, 0, 0, 0, 5) == false);
    assert(ledger_status(5, 1, 0, 0, 0, 0, 0, 5) == L_UNKNOWN);
}

test a_recorded_verdict_goes_stale_when_any_part_of_its_key_changes {
    assert(key_state(true, true, CONVERTER_VERSION, STD_TABLE_VERSION) == K_FRESH);
    assert(key_state(false, true, CONVERTER_VERSION, STD_TABLE_VERSION) == K_NONE);
    assert(key_state(true, false, CONVERTER_VERSION, STD_TABLE_VERSION) == K_STALE_SOURCE);
    assert(key_state(true, true, CONVERTER_VERSION + 1, STD_TABLE_VERSION) == K_STALE_CONVERTER);
    assert(key_state(true, true, CONVERTER_VERSION, STD_TABLE_VERSION + 1) == K_STALE_STD);
}

test only_t27b_pass_and_fail_are_verdicts_every_other_code_falls_back_to_t27c {
    assert(t27b_outcome(T27B_PASS) == ORC_PASS);
    assert(t27b_outcome(T27B_FAIL) == ORC_FAIL);
    assert(t27b_outcome(T27B_UNSUPPORTED) == ORC_UNSUPPORTED);
    assert(t27b_outcome(T27B_CODEGEN_LIMIT) == ORC_UNSUPPORTED);
    assert(t27b_outcome(T27B_FRONT_END) == ORC_UNKNOWN);
    assert(t27b_outcome(T27B_DISAGREE) == ORC_UNKNOWN);
    assert(needs_reference(t27b_outcome(T27B_PASS)) == false);
    assert(needs_reference(t27b_outcome(T27B_FAIL)) == false);
    assert(needs_reference(t27b_outcome(T27B_UNSUPPORTED)));
    assert(needs_reference(t27b_outcome(T27B_FRONT_END)));
    assert(needs_reference(t27b_outcome(T27B_DISAGREE)));
    assert(needs_reference(t27b_outcome(T27B_CODEGEN_LIMIT)));
}

test negative_control_a_code_outside_t27b_table_is_unknown_never_a_pass {
    assert(t27b_outcome(64) == ORC_UNKNOWN);
    assert(t27b_outcome(74) == ORC_UNKNOWN);
    assert(t27b_outcome(133) == ORC_UNKNOWN);
    assert(t27b_outcome(0 - 1) == ORC_UNKNOWN);
    assert(needs_reference(t27b_outcome(0 - 1)));
    assert(ORC_NAMES[t27b_outcome(T27B_DISAGREE)] == "unknown");
}

test the_version_rule_and_the_hash_rule_are_one_rule {
    assert(key_check(true, true, true, true) == K_FRESH);
    assert(key_check(false, true, true, true) == K_NONE);
    assert(key_check(true, false, true, true) == K_STALE_SOURCE);
    assert(key_check(true, true, false, true) == K_STALE_CONVERTER);
    assert(key_check(true, true, true, false) == K_STALE_STD);
    assert(key_check(true, false, false, false) == K_STALE_SOURCE);
    assert(key_check(true, true, false, false) == K_STALE_CONVERTER);
    assert(key_state(true, true, CONVERTER_VERSION, STD_TABLE_VERSION) == key_check(true, true, true, true));
    assert(key_state(true, true, CONVERTER_VERSION + 1, STD_TABLE_VERSION) == key_check(true, true, false, true));
}

test negative_control_a_stale_or_missing_key_is_never_reused {
    assert(reuse_row(key_check(true, true, true, true)));
    assert(reuse_row(key_check(false, true, true, true)) == false);
    assert(reuse_row(key_check(true, false, true, true)) == false);
    assert(reuse_row(key_check(true, true, false, true)) == false);
    assert(reuse_row(key_check(true, true, true, false)) == false);
    assert(reuse_row(key_check(true, false, false, false)) == false);
    assert(reuse_row(K_NONE) == false);
    assert(reuse_row(K_STALE_SOURCE) == false);
    assert(reuse_row(K_STALE_CONVERTER) == false);
    assert(reuse_row(K_STALE_STD) == false);
}

test the_sweep_takes_rust_files_outside_gen_and_target {
    assert(sweep_path("cli/tri/src/main.rs"));
    assert(sweep_path("bootstrap/src/compiler.rs"));
    assert(sweep_path("build.rs"));
    assert(sweep_path("gen.rs"));
    assert(sweep_path("src/generator/x.rs"));
    assert(sweep_path("src/targets/x.rs"));
    assert(sweep_path("src/gen/x.rs") == false);
    assert(sweep_path("gen/rust/tools/t27o/ledger.rs") == false);
    assert(sweep_path("target/release/build/x/out.rs") == false);
    assert(sweep_path("a/b/target/c.rs") == false);
}

test negative_control_a_path_that_is_not_rust_or_is_empty_is_not_swept {
    assert(sweep_path("") == false);
    assert(sweep_path("rs") == false);
    assert(sweep_path("main.rs.bak") == false);
    assert(sweep_path("specs/tools/t27o/ledger.t27") == false);
    assert(sweep_path("README.md") == false);
}

test a_file_over_the_cap_is_skipped_and_one_at_the_cap_is_converted {
    assert(over_cap(300001, SWEEP_MAX_BYTES));
    assert(over_cap(300000, SWEEP_MAX_BYTES) == false);
    assert(over_cap(0, SWEEP_MAX_BYTES) == false);
}

test coverage_is_per_mille_and_a_tree_with_no_fn_is_unknown_not_complete {
    assert(coverage_permille(7108, 627) == 88);
    assert(coverage_permille(3, 3) == 1000);
    assert(coverage_permille(5, 0) == 0);
    assert(coverage_known(coverage_permille(5, 0)));
    assert(coverage_known(coverage_permille(3, 3)));
}

test negative_control_no_fn_seen_is_never_one_hundred_percent {
    assert(coverage_permille(0, 0) == COVERAGE_UNKNOWN);
    assert(coverage_known(coverage_permille(0, 0)) == false);
    assert(coverage_permille(0, 0) != 1000);
    assert(coverage_permille(2, 3) == COVERAGE_UNKNOWN);
}

test a_refusal_kind_is_the_words_before_the_first_backtick {
    const a : string = "// t27o: refused fn ids (line 65): type `Vec` at line 65";
    assert(is_refusal(a, 0));
    assert(span_is(a, kind_from(a, 0), kind_to(a, 0), "type"));
    const b : string = "// t27o: refused enum JumpsCmd (line 47): enum variant with data `Census` at line 50";
    assert(span_is(b, kind_from(b, 0), kind_to(b, 0), "enum variant with data"));
    const c : string = "// t27o: refused fn run (line 58): uses refused `JumpsCmd::Census` at line 60; 3 fn inside";
    assert(span_is(c, kind_from(c, 0), kind_to(c, 0), "uses refused"));
    const d : string = "// t27o: refused fn eq (line 9): == of structs `a == b` at line 11";
    assert(span_is(d, kind_from(d, 0), kind_to(d, 0), "== of structs"));
}

test only_a_reason_that_names_a_refused_item_is_a_cascade {
    assert(is_cascade("uses refused"));
    assert(is_cascade("type") == false);
    assert(is_cascade("uses external") == false);
    assert(is_cascade("") == false);
    assert(is_cascade("uses") == false);
}

test negative_control_a_line_that_is_not_a_refusal_or_has_no_reason_is_not_misread {
    assert(is_refusal("// t27o: 11 fn seen, 0 converted", 0) == false);
    assert(is_refusal("", 0) == false);
    assert(is_refusal("pub fn run() -> void {", 0) == false);
    const e : string = "// t27o: refused fn x (line 1) no reason";
    assert(is_refusal(e, 0));
    assert(span_is(e, kind_from(e, 0), kind_to(e, 0), e));
}

test the_ranking_puts_more_refusals_first_and_equal_counts_in_text_order {
    assert(rank_cmp(9, "type", 3, "method") == 0 - 1);
    assert(rank_cmp(3, "type", 9, "method") == 1);
    assert(rank_cmp(5, "method", 5, "type") == 0 - 1);
    assert(rank_cmp(5, "type", 5, "method") == 1);
    assert(rank_cmp(5, "type", 5, "type") == 0);
    assert(text_order("type", "types") == 0 - 1);
    assert(text_order("types", "type") == 1);
}

; --- Tests: `tri t27o-sweep --repo <dir>` (#10638) -------------------------------------------------

; out[0..n) holds exactly the bytes of want.
pub fn out_is(out: []u8, n: usize, want: str) -> bool {
    if (n != want.len or n > out.len) { return false; }
    var k : usize = 0;
    while (k < n) {
        if (out[k] != want[k]) { return false; }
        k = k + 1;
    }
    return true;
}

test this_checkout_is_not_given_empty_or_a_dot_and_nothing_else_is {
    assert(repo_is_here(SWEEP_HERE));
    assert(repo_is_here(""));
    assert(repo_is_here("./"));
    assert(repo_is_here(".//"));
    assert(repo_is_here("/srv/checkouts/trios") == false);
    assert(repo_is_here("trios") == false);
    assert(repo_is_here("..") == false);
    assert(repo_is_here("../") == false);
    assert(repo_is_here("/") == false);
    assert(repo_is_here("./trios") == false);
    assert(repo_is_here("trios/.") == false);
}

test the_cache_of_this_checkout_is_the_path_it_always_had {
    var out : [128]u8 = undefined;
    assert(cache_path(SWEEP_HERE, out[0 .. 128]) == SWEEP_CACHE.len);
    assert(out_is(out[0 .. 128], SWEEP_CACHE.len, "target/t27o-sweep.tsv"));
    assert(cache_path("", out[0 .. 128]) == SWEEP_CACHE.len);
    assert(out_is(out[0 .. 128], SWEEP_CACHE.len, SWEEP_CACHE));
}

test the_cache_of_another_repository_is_named_after_its_directory {
    var out : [128]u8 = undefined;
    assert(cache_path("/srv/checkouts/trios", out[0 .. 128]) == 27);
    assert(out_is(out[0 .. 128], 27, "target/t27o-sweep-trios.tsv"));
    assert(cache_path("/srv/checkouts/999-multibots-telegraf", out[0 .. 128]) == 44);
    assert(out_is(out[0 .. 128], 44, "target/t27o-sweep-999-multibots-telegraf.tsv"));
    assert(cache_path("trinity-fpga", out[0 .. 128]) == 34);
    assert(out_is(out[0 .. 128], 34, "target/t27o-sweep-trinity-fpga.tsv"));
}

test negative_control_two_repositories_never_share_a_cache_and_a_slash_changes_nothing {
    var a : [128]u8 = undefined;
    var b : [128]u8 = undefined;
    var na : usize = cache_path("/srv/checkouts/trios", a[0 .. 128]);
    var nb : usize = cache_path("/srv/checkouts/trinity", b[0 .. 128]);
    assert(out_is(a[0 .. 128], na, "target/t27o-sweep-trinity.tsv") == false);
    assert(out_is(b[0 .. 128], nb, "target/t27o-sweep-trios.tsv") == false);
    assert(out_is(a[0 .. 128], na, SWEEP_CACHE) == false);
    assert(cache_path("/srv/checkouts/trios/", b[0 .. 128]) == na);
    assert(out_is(b[0 .. 128], na, "target/t27o-sweep-trios.tsv"));
    assert(cache_path("/srv/checkouts/trios//", b[0 .. 128]) == na);
    assert(cache_path("/", b[0 .. 128]) == 22);
    assert(out_is(b[0 .. 128], 22, "target/t27o-sweep-.tsv"));
}

test a_cache_path_that_does_not_fit_is_not_written {
    var out : [24]u8 = undefined;
    out[0] = 0;
    assert(cache_path("/srv/checkouts/trios", out[0 .. 24]) == 0);
    assert(out[0] == 0);
    var fits : [27]u8 = undefined;
    assert(cache_path("/srv/checkouts/trios", fits[0 .. 27]) == 27);
    assert(cache_path(SWEEP_HERE, out[0 .. 24]) == SWEEP_CACHE.len);
}

test the_seals_are_read_from_the_checkout_and_a_missing_one_says_so {
    assert(span_is(SEAL_CONVERTER, 0, SEAL_CONVERTER.len, ".trinity/seals/t27o_T27oRust.json"));
    assert(span_is(SEAL_STD, 0, SEAL_STD.len, ".trinity/seals/t27o_T27oRustStd.json"));
    assert(starts_at(SEAL_CONVERTER, 0, ".trinity/seals/"));
    assert(starts_at(SEAL_STD, 0, ".trinity/seals/"));
    assert(span_is(SEAL_ZIG, 0, SEAL_ZIG.len, ".trinity/seals/t27o_T27oZig.json"));
    assert(starts_at(SEAL_ZIG, 0, ".trinity/seals/"));
    assert(SEAL_ZIG.len != SEAL_CONVERTER.len);
    assert(span_is(SEAL_HINT, 0, SEAL_HINT.len, "run from a t27 checkout"));
    assert(SEAL_CONVERTER.len != SEAL_STD.len);
}

; --- Tests: the front end of a file, and `--check` / `--oracle` of a Zig file (#10823) -----------------

test a_file_ending_in_dot_zig_goes_to_the_zig_front_end_and_any_other_to_the_rust_one {
    assert(front_end("a.zig") == FE_ZIG);
    assert(front_end("src/x/y.zig") == FE_ZIG);
    assert(front_end("/srv/checkouts/trinity/src/vsa/ops.zig") == FE_ZIG);
    assert(front_end("a.rs") == FE_RUST);
    assert(front_end("cli/tri/src/main.rs") == FE_RUST);
    assert(FE_ZIG != FE_RUST);
}

test negative_control_a_name_that_only_contains_zig_is_not_a_zig_file {
    assert(front_end("") == FE_RUST);
    assert(front_end("zig") == FE_RUST);
    assert(front_end(".zi") == FE_RUST);
    assert(front_end("a.zig.rs") == FE_RUST);
    assert(front_end("a.zigg") == FE_RUST);
    assert(front_end("azig") == FE_RUST);
    assert(front_end("a.ZIG") == FE_RUST);
    assert(front_end("a.cir") == FE_RUST);
    assert(front_end("zig/a.rs") == FE_RUST);
}

test a_zig_file_is_judged_by_the_tests_that_converted_and_a_rust_file_by_its_oracle {
    assert(has_evidence(true, 1));
    assert(has_evidence(true, 600));
    assert(has_evidence(false, 0));
    assert(has_evidence(false, 3));
}

test negative_control_a_zig_spec_with_no_converted_test_has_nothing_to_judge_it_by {
    assert(has_evidence(true, 0) == false);
    assert(t27b_outcome(T27B_PASS) == ORC_PASS);
    assert(EXIT_UNJUDGED > T27B_CODEGEN_LIMIT);
    assert(t27b_outcome(EXIT_UNJUDGED) == ORC_UNKNOWN);
    assert(needs_reference(t27b_outcome(EXIT_UNJUDGED)));
}

test the_notes_of_a_zig_file_say_what_does_not_apply_and_what_ran_nothing {
    assert(starts_at(NOTE_ZIG_ORACLE, 0, "t27o: --oracle does not apply to a .zig file"));
    assert(starts_at(NOTE_ZIG_UNJUDGED, 0, "t27o: no test of this .zig file converted"));
    assert(NOTE_ZIG_ORACLE.len > 0);
    assert(NOTE_ZIG_UNJUDGED.len > 0);
}

test the_sweep_takes_zig_files_beside_rust_ones {
    assert(sweep_path("src/vsa/ops.zig"));
    assert(sweep_path("crates/trios-x/src/lib.zig"));
    assert(sweep_path("build.zig"));
    assert(sweep_path("a.zig"));
    assert(sweep_path("src/targets/x.zig"));
    assert(sweep_path("src/generator/x.zig"));
    assert(sweep_path("src/main.rs"));
}

test negative_control_a_generated_or_target_zig_path_and_a_near_miss_are_not_swept {
    assert(sweep_path("gen/zig/x.zig") == false);
    assert(sweep_path("deploy/trinity-nexus/tools/src/gen/batch_gen.zig") == false);
    assert(sweep_path("target/x.zig") == false);
    assert(sweep_path("a/b/target/c.zig") == false);
    assert(sweep_path("main.zig.bak") == false);
    assert(sweep_path("zig") == false);
    assert(sweep_path("x.zi") == false);
    assert(sweep_path("x.zig/y.txt") == false);
}

test a_refusal_kind_stops_at_a_semicolon_because_the_cache_row_separates_kinds_with_one {
    const g : string = "// t27o: refused file (line 1): generated; convert its source spec instead";
    assert(is_refusal(g, 0));
    assert(span_is(g, kind_from(g, 0), kind_to(g, 0), "generated"));
    const h : string = "// t27o: refused fn f (line 3): pointer `*` at line 3; 2 fn inside";
    assert(span_is(h, kind_from(h, 0), kind_to(h, 0), "pointer"));
}

test negative_control_a_kind_with_no_semicolon_or_backtick_is_still_the_whole_reason {
    const k : string = "// t27o: refused fn f (line 3): name table full";
    assert(span_is(k, kind_from(k, 0), kind_to(k, 0), "name table full"));
    const c : string = "// t27o: refused fn f (line 3): uses refused `g` at line 4; 1 fn inside";
    assert(span_is(c, kind_from(c, 0), kind_to(c, 0), "uses refused"));
    assert(is_cascade("uses refused"));
}

; --- Tests: a cascade is counted under its root (#11122) -------------------------------------------------

test a_cascade_is_attributed_to_the_first_refusal_at_its_root {
    const t : string = "// t27o: refused fn b (line 3): uses refused `a` at line 3\n\nfn b() -> u32 {\n}\n\n// t27o: refused fn a (line 7): type `Vec` at line 7\n\nfn a() -> u32 {\n}\n\n";
    const b : usize = next_refusal(t, 0);
    const a : usize = next_refusal(t, b + 1);
    assert(b == 0);
    assert(a > b);
    assert(next_refusal(t, a + 1) == t.len);
    assert(root_of(t, b) == a);
    assert(span_is(t, kind_from(t, root_of(t, b)), kind_to(t, root_of(t, b)), "type"));
    assert(attributed(t, b, root_of(t, b)));
    assert(root_of(t, a) == a);
    assert(attributed(t, a, a) == false);
}

test a_run_of_cascades_is_followed_to_the_refusal_that_is_not_one {
    const t : string = "// t27o: refused fn c (line 1): uses refused `b` at line 1\n\n// t27o: refused fn b (line 2): uses refused `a` at line 2; 1 fn inside\n\n// t27o: refused fn a (line 3): macro `vec` at line 3\n\n";
    const c : usize = next_refusal(t, 0);
    const b : usize = next_refusal(t, c + 1);
    const a : usize = next_refusal(t, b + 1);
    assert(root_of(t, c) == a);
    assert(root_of(t, b) == a);
    assert(span_is(t, kind_from(t, a), kind_to(t, a), "macro"));
    assert(attributed(t, c, root_of(t, c)));
    assert(attributed(t, b, root_of(t, b)));
}

test a_cascade_may_end_in_any_root_reason_including_uses_external {
    const t : string = "// t27o: refused fn b (line 1): uses refused `a` at line 1\n\n// t27o: refused fn a (line 2): uses external `Thing` at line 2\n\n";
    const a : usize = next_refusal(t, 1);
    assert(root_of(t, 0) == a);
    assert(span_is(t, kind_from(t, a), kind_to(t, a), "uses external"));
    assert(attributed(t, 0, a));
}

test a_callee_in_another_file_stays_a_cascade_and_is_not_attributed {
    const t : string = "// t27o: refused fn b (line 1): uses refused `elsewhere` at line 1\n\n// t27o: refused fn c (line 2): uses refused `b` at line 2\n\nfn d() -> u32 {\n}\n\n";
    const c : usize = next_refusal(t, 1);
    assert(root_of(t, 0) == 0);
    assert(is_cascade_at(t, 0));
    assert(attributed(t, 0, root_of(t, 0)) == false);
    assert(root_of(t, c) == 0);
    assert(is_cascade_at(t, root_of(t, c)));
    assert(attributed(t, c, root_of(t, c)) == false);
    assert(span_is(t, kind_from(t, 0), kind_to(t, 0), "uses refused"));
}

test negative_control_a_cycle_or_a_self_call_ends_and_is_not_attributed {
    const t : string = "// t27o: refused fn a (line 1): uses refused `b` at line 1\n\n// t27o: refused fn b (line 2): uses refused `a` at line 2\n\n// t27o: refused fn r (line 3): uses refused `r` at line 3\n\n";
    const b : usize = next_refusal(t, 1);
    const r : usize = next_refusal(t, b + 1);
    assert(attributed(t, 0, root_of(t, 0)) == false);
    assert(attributed(t, b, root_of(t, b)) == false);
    assert(attributed(t, r, root_of(t, r)) == false);
    assert(is_cascade_at(t, root_of(t, 0)));
    assert(is_cascade_at(t, root_of(t, r)));
}

test negative_control_a_name_is_matched_whole_and_by_case_and_self_is_nobodys {
    const t : string = "// t27o: refused fn x (line 1): uses refused `ab` at line 1\n\n// t27o: refused fn y (line 2): uses refused `A` at line 2\n\n// t27o: refused fn z (line 3): uses refused `self` at line 3\n\n// t27o: refused fn a (line 4): type `Vec` at line 4\n\n// t27o: refused fn abc (line 5): type `Vec` at line 5\n\n// t27o: refused struct Self (line 6): type `Vec` at line 6\n\n";
    const y : usize = next_refusal(t, 1);
    const z : usize = next_refusal(t, y + 1);
    assert(attributed(t, 0, root_of(t, 0)) == false);
    assert(attributed(t, y, root_of(t, y)) == false);
    assert(attributed(t, z, root_of(t, z)) == false);
    assert(quoted_refusal(t, 0) == t.len);
}

test negative_control_a_refusal_with_no_quoted_name_and_a_nameless_item_resolve_nothing {
    const t : string = "// t27o: refused unsafe (line 1): item `unsafe` at line 1; 1 fn inside\n\n// t27o: refused fn f (line 2): uses refused `unsafe` at line 2\n\n// t27o: refused fn g (line 3): uses refused\n\n";
    const f : usize = next_refusal(t, 1);
    const g : usize = next_refusal(t, f + 1);
    assert(target_to(t, g) == target_from(t, g));
    assert(quoted_refusal(t, g) == t.len);
    assert(quoted_refusal(t, f) == t.len);
    assert(attributed(t, f, root_of(t, f)) == false);
    assert(attributed(t, g, root_of(t, g)) == false);
}

test the_item_a_refusal_names_is_the_word_after_its_kind_and_some_have_none {
    const t : string = "// t27o: refused struct Gen (line 1): type `Vec` at line 1\n// t27o: refused std::fmt::Display (line 2): trait impl `std::fmt::Display` at line 2; 1 fn inside\n// t27o: refused test \"calls bad\" (line 3): uses refused `bad` at line 5\n// t27o: refused unsafe (line 4): item `unsafe` at line 4\n";
    const s : usize = next_refusal(t, 0);
    const d : usize = next_refusal(t, s + 1);
    const q : usize = next_refusal(t, d + 1);
    const u : usize = next_refusal(t, q + 1);
    assert(span_is(t, item_from(t, s), item_to(t, s), "Gen"));
    assert(item_to(t, d) == item_from(t, d));
    assert(span_is(t, item_from(t, q), item_to(t, q), "\"calls bad\""));
    assert(item_to(t, u) == item_from(t, u));
    assert(span_is(t, target_from(t, q), target_to(t, q), "bad"));
    assert(next_refusal(t, u + 1) == t.len);
}

test the_first_refusal_of_a_name_is_the_one_a_cascade_follows {
    const t : string = "// t27o: refused fn go (line 1): uses refused `new` at line 1\n\n// t27o: refused fn new (line 2): type `Vec` at line 2\n\n// t27o: refused fn new (line 3): macro `vec` at line 3\n\n";
    const first : usize = next_refusal(t, 1);
    assert(root_of(t, 0) == first);
    assert(span_is(t, kind_from(t, first), kind_to(t, first), "type"));
}

test the_next_refusal_skips_other_lines_and_a_start_inside_a_line_means_the_next_line {
    const t : string = "pub fn ok() -> u32 {\n}\n\n// t27o: refused fn f (line 4): type `Vec` at line 4\n\n// t27o: 3 fn seen, 1 converted\n// t27o: refused fn g (line 5): type `Vec` at line 5\n";
    const f : usize = next_refusal(t, 0);
    const g : usize = next_refusal(t, f + 1);
    assert(f == 24);
    assert(g > f);
    assert(next_refusal(t, f) == f);
    assert(next_refusal(t, g + 1) == t.len);
    assert(next_refusal(t, t.len) == t.len);
    assert(next_refusal("", 0) == 0);
}

test the_kind_of_a_line_inside_a_text_is_the_kind_of_the_line_alone_at_offset_zero {
    const l : string = "// t27o: refused fn a (line 7): type `Vec` at line 7";
    const t : string = "x\n// t27o: refused fn a (line 7): type `Vec` at line 7\ny\n";
    assert(kind_from(t, 2) - 2 == kind_from(l, 0));
    assert(kind_to(t, 2) - 2 == kind_to(l, 0));
    assert(reason_from(t, 2) - 2 == reason_from(l, 0));
    const n : string = "// t27o: refused fn a (line 7) no reason\nnext\n";
    assert(kind_from(n, 0) == 0);
    assert(kind_to(n, 0) == line_stop(n, 0));
}

test a_file_converts_whole_when_it_has_fn_and_every_one_converted {
    assert(converts_whole(3, 3));
    assert(converts_whole(1, 1));
    assert(converts_whole(21, 20) == false);
    assert(converts_whole(5, 0) == false);
}

test negative_control_a_file_with_no_fn_or_a_count_that_does_not_add_up_is_not_whole {
    assert(converts_whole(0, 0) == false);
    assert(converts_whole(2, 3) == false);
    assert(coverage_known(coverage_permille(0, 0)) == false);
}
