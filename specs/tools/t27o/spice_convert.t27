// The bytes the reader looks at, as numbers (a char literal is a Rust char in gen-rust).
pub const B_TAB : u8 = 9;
pub const B_NL : u8 = 10;
pub const B_CR : u8 = 13;
pub const B_SPACE : u8 = 32;
pub const B_DOLLAR : u8 = 36;
pub const B_APOS : u8 = 39;
pub const B_LPAREN : u8 = 40;
pub const B_RPAREN : u8 = 41;
pub const B_STAR : u8 = 42;
pub const B_PLUS : u8 = 43;
pub const B_COMMA : u8 = 44;
pub const B_MINUS : u8 = 45;
pub const B_DOT : u8 = 46;
pub const B_ZERO : u8 = 48;
pub const B_SEMI : u8 = 59;
pub const B_EQ : u8 = 61;
pub const B_LBRACE : u8 = 123;

// ---------------------------------------------------------------- the file name

/// ASCII lowercase of one byte (every spec that reads text carries this one).
pub fn lower(c: u8) -> u8 {
    if (c >= 65 and c <= 90) { return c + 32; }
    return c;
}

/// Does a file name end in .spice, .cir or .sp, whatever the case? `tri t27o` sends such a file here.
pub fn is_spice_name(name: []const u8) -> bool {
    return ends_ci(name, ".spice") or ends_ci(name, ".cir") or ends_ci(name, ".sp");
}

pub fn ends_ci(name: []const u8, suffix: []const u8) -> bool {
    if (name.len < suffix.len) { return false; }
    const from : usize = name.len - suffix.len;
    var k : usize = 0;
    while (k < suffix.len) {
        if (lower(name[from + k]) != suffix[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// ---------------------------------------------------------------- tables

/// A refusal on `line`, kept only when it is the earliest one seen.
pub fn reject_at(st: []usize, why: usize, line: usize, k: usize, tok: usize) -> void {
    if (st[ERR_LINE] == 0 or line < st[ERR_LINE]) {
        st[ERR_LINE] = line;
        st[ERR_WHY] = why;
        st[ERR_CARD] = k;
        st[ERR_TOK] = tok;
    }
}

/// A refusal about card k, and token `tok` of it (NONE for the card as a whole).
pub fn reject(st: []usize, why: usize, k: usize, tok: usize) -> void {
    const line : usize = st[CARD0 + k * CARD_SLOTS + C_LINE];
    reject_at(st, why, line, k, tok);
}

pub fn exit_code(st: []usize) -> u8 {
    if (st[ERR_LINE] != 0) { return 1; }
    return 0;
}

// ---------------------------------------------------------------- tokens

/// A separator: a space, a tab or a comma.
pub fn is_sep(c: u8) -> bool {
    return is_space(c) or c == B_COMMA;
}

/// The punctuation that is a token by itself: ( ) and =.
pub fn is_punct(c: u8) -> bool {
    return c == B_LPAREN or c == B_RPAREN or c == B_EQ;
}

/// Where the next token at or after p starts, e when there is none.
pub fn tk(w: []const u8, p: usize, e: usize) -> usize {
    var q : usize = p;
    while (q < e and is_sep(w[q])) { q = q + 1; }
    return q;
}

/// Where the token that starts at s ends.
pub fn tk_end(w: []const u8, s: usize, e: usize) -> usize {
    if (s >= e) { return s; }
    if (is_punct(w[s])) { return s + 1; }
    var q : usize = s;
    while (q < e and !is_sep(w[q]) and !is_punct(w[q])) { q = q + 1; }
    return q;
}

/// Start of the i-th (from 0) word at or after p, NONE when a ( ) or = comes first or the card ends.
pub fn word_at(w: []const u8, p: usize, e: usize, i: usize) -> usize {
    var q : usize = p;
    var n : usize = 0;
    var found : usize = NONE;
    var go : bool = true;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e or is_punct(w[t])) {
            go = false;
        } else if (n == i) {
            found = t;
            go = false;
        } else {
            n = n + 1;
            q = tk_end(w, t, e);
        }
    }
    return found;
}

/// The position just after the i-th word, NONE when there is none.
pub fn after_word(w: []const u8, p: usize, e: usize, i: usize) -> usize {
    const t : usize = word_at(w, p, e, i);
    if (t == NONE) { return NONE; }
    return tk_end(w, t, e);
}

/// Is w[a..b] the text `lit`, ignoring case? `lit` is lower case.
pub fn ci_is(w: []const u8, a: usize, b: usize, lit: []const u8) -> bool {
    if (b < a or b - a != lit.len) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (lower(w[a + k]) != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is w[a..b] the text pre followed by suf, ignoring case? (.PARAM is spelled in two pieces: t27c's
/// `use` splice reads every word of a spec, string literals included, as a name to pull, and
/// rust_convert declares fns called param and params that would drag the Rust converter in with them.)
pub fn ci_cat(w: []const u8, a: usize, b: usize, pre: []const u8, suf: []const u8) -> bool {
    if (b < a or b - a != pre.len + suf.len) { return false; }
    return ci_is(w, a, a + pre.len, pre) and ci_is(w, a + pre.len, b, suf);
}

/// Are w[a1..b1] and w[a2..b2] the same text, ignoring case?
pub fn same_ci(w: []const u8, a1: usize, b1: usize, a2: usize, b2: usize) -> bool {
    if (b1 < a1 or b2 < a2 or b1 - a1 != b2 - a2) { return false; }
    var k : usize = 0;
    while (a1 + k < b1) {
        if (lower(w[a1 + k]) != lower(w[a2 + k])) { return false; }
        k = k + 1;
    }
    return true;
}

/// Where a byte of the card w[a..e] is `c1` or `c2`, NONE when neither is.
pub fn find_either(w: []const u8, a: usize, e: usize, c1: u8, c2: u8) -> usize {
    var q : usize = a;
    while (q < e) {
        if (w[q] == c1 or w[q] == c2) { return q; }
        q = q + 1;
    }
    return NONE;
}

// ---------------------------------------------------------------- numbers

/// Parse w[a..b] as a SPICE number into st[VM] (the mantissa, trailing zeros taken out), st[VE] (the
/// power of ten, biased by EXP_BIAS) and st[VS] (1 for a minus sign). False when it is not one.
pub fn parse_num(w: []const u8, a: usize, b: usize, st: []usize) -> bool {
    var q : usize = a;
    var neg : usize = 0;
    if (q < b and (w[q] == B_MINUS or w[q] == B_PLUS)) {
        if (w[q] == B_MINUS) { neg = 1; }
        q = q + 1;
    }
    var mant : usize = 0;
    var sig : usize = 0;
    var eb : usize = EXP_BIAS;
    var any : bool = false;
    var dot : bool = false;
    var go : bool = true;
    while (go and q < b) {
        const c : u8 = w[q];
        if (is_digit(c)) {
            any = true;
            if (mant != 0 or c != B_ZERO) {
                if (sig >= 18) { return false; }
                mant = mant * 10 + (c - B_ZERO) as usize;
                sig = sig + 1;
            }
            if (dot) { eb = eb - 1; }
            q = q + 1;
        } else if (c == B_DOT and !dot) {
            dot = true;
            q = q + 1;
        } else {
            go = false;
        }
    }
    if (!any) { return false; }
    // an exponent: e or E, an optional sign and at least one digit
    if (q < b and lower(w[q]) == 101) {
        var r : usize = q + 1;
        var eneg : bool = false;
        if (r < b and (w[r] == B_MINUS or w[r] == B_PLUS)) {
            eneg = w[r] == B_MINUS;
            r = r + 1;
        }
        if (r < b and is_digit(w[r])) {
            var ev : usize = 0;
            while (r < b and is_digit(w[r])) {
                if (ev > 1000) { return false; }
                ev = ev * 10 + (w[r] - B_ZERO) as usize;
                r = r + 1;
            }
            if (eneg) { eb = eb - ev; } else { eb = eb + ev; }
            q = r;
        }
    }
    // a scale factor, then units: letters only
    if (q < b) {
        const c : u8 = lower(w[q]);
        if (c == 109) {
            if (q + 2 < b and lower(w[q + 1]) == 101 and lower(w[q + 2]) == 103) {
                eb = eb + 6;
                q = q + 3;
            } else if (q + 2 < b and lower(w[q + 1]) == 105 and lower(w[q + 2]) == 108) {
                return false;
            } else {
                eb = eb - 3;
                q = q + 1;
            }
        } else if (c == 116) { eb = eb + 12; q = q + 1; }
        else if (c == 103) { eb = eb + 9; q = q + 1; }
        else if (c == 107) { eb = eb + 3; q = q + 1; }
        else if (c == 117) { eb = eb - 6; q = q + 1; }
        else if (c == 110) { eb = eb - 9; q = q + 1; }
        else if (c == 112) { eb = eb - 12; q = q + 1; }
        else if (c == 102) { eb = eb - 15; q = q + 1; }
        while (q < b) {
            if (!is_alpha(w[q])) { return false; }
            q = q + 1;
        }
    }
    while (mant != 0 and mant % 10 == 0) {
        mant = mant / 10;
        eb = eb + 1;
    }
    if (mant == 0) { eb = EXP_BIAS; }
    st[VM] = mant;
    st[VE] = eb;
    st[VS] = neg;
    return true;
}

/// Is the number with mantissa m, biased exponent e and sign s a whole number from 1 to MAX_MULT?
pub fn whole_mult(m: usize, e: usize, s: usize) -> bool {
    if (s != 0 or m == 0 or e < EXP_BIAS or e - EXP_BIAS > 9) { return false; }
    if (m > MAX_MULT) { return false; }
    return mult_value(m, e) <= MAX_MULT;
}

/// The whole number that whole_mult accepted: the mantissa times ten to the exponent.
pub fn mult_value(m: usize, e: usize) -> usize {
    var v : usize = m;
    var x : usize = e - EXP_BIAS;
    while (x > 0) {
        v = v * 10;
        x = x - 1;
    }
    return v;
}

// ---------------------------------------------------------------- the cleaned deck

/// Where a card's inline comment starts: a `;`, or a `$` after a blank or at the start; e when none.
pub fn cut_comment(src: []const u8, a: usize, e: usize) -> usize {
    var i : usize = a;
    while (i < e) {
        const c : u8 = src[i];
        if (c == B_SEMI) { return i; }
        if (c == B_DOLLAR and (i == a or src[i - 1] == B_SPACE or src[i - 1] == B_TAB)) { return i; }
        i = i + 1;
    }
    return e;
}

/// Read the deck into the work buffer, one card per line: the title set aside, comment and blank lines
/// dropped, inline comments cut, every `+` line joined to the card before it. The card table records
/// where each card is and the physical line it started on.
pub fn prepare(src: []const u8, w: []u8, st: []usize) -> void {
    var cap : usize = 0;
    if (st.len > CARD0) { cap = (st.len - CARD0) / CARD_SLOTS; }
    var p : usize = 0;
    var line : usize = 0;
    var wp : usize = 0;
    var open : bool = false;
    var n : usize = 0;
    var go : bool = true;
    while (go and p < src.len) {
        var e : usize = p;
        while (e < src.len and src[e] != B_NL) { e = e + 1; }
        line = line + 1;
        if (line == 1) {
            var te : usize = e;
            if (te > p and src[te - 1] == B_CR) { te = te - 1; }
            st[TITLE_A] = p;
            st[TITLE_B] = te;
        } else {
            var a : usize = p;
            while (a < e and (src[a] == B_SPACE or src[a] == B_TAB)) { a = a + 1; }
            var b : usize = cut_comment(src, a, e);
            while (b > a and is_space(src[b - 1])) { b = b - 1; }
            if (a < b and src[a] != B_STAR) {
                if (wp + (b - a) + 2 > w.len) {
                    reject_at(st, Y_SIZE, line, NONE, NONE);
                    go = false;
                } else if (src[a] == B_PLUS) {
                    if (!open) {
                        reject_at(st, Y_CONT, line, NONE, NONE);
                    } else {
                        w[wp] = B_SPACE;
                        wp = wp + 1;
                        var i : usize = a + 1;
                        while (i < b and (src[i] == B_SPACE or src[i] == B_TAB)) { i = i + 1; }
                        while (i < b) {
                            w[wp] = src[i];
                            wp = wp + 1;
                            i = i + 1;
                        }
                    }
                } else if (n >= cap) {
                    reject_at(st, Y_SIZE, line, NONE, NONE);
                    go = false;
                } else {
                    if (open) {
                        st[CARD0 + (n - 1) * CARD_SLOTS + C_B] = wp;
                        w[wp] = B_NL;
                        wp = wp + 1;
                    }
                    st[CARD0 + n * CARD_SLOTS + C_A] = wp;
                    st[CARD0 + n * CARD_SLOTS + C_LINE] = line;
                    st[CARD0 + n * CARD_SLOTS + C_SCOPE] = NONE;
                    var i : usize = a;
                    while (i < b) {
                        w[wp] = src[i];
                        wp = wp + 1;
                        i = i + 1;
                    }
                    n = n + 1;
                    open = true;
                }
            }
        }
        p = e + 1;
    }
    if (open) {
        st[CARD0 + (n - 1) * CARD_SLOTS + C_B] = wp;
        w[wp] = B_NL;
        wp = wp + 1;
    }
    st[NCARDS] = n;
    st[WEND] = wp;
}

/// Find the .end cards. The deck ends at the last one (see the header): the cards before it are read,
/// the ones after it are ignored and counted.
pub fn mark_end(w: []const u8, st: []usize) -> void {
    var k : usize = 0;
    var last : usize = NONE;
    var n : usize = 0;
    while (k < st[NCARDS]) {
        const a : usize = st[CARD0 + k * CARD_SLOTS + C_A];
        if (ci_is(w, a, tk_end(w, a, st[CARD0 + k * CARD_SLOTS + C_B]), ".end")) {
            if (n == 0) { st[END_LINE] = st[CARD0 + k * CARD_SLOTS + C_LINE]; }
            n = n + 1;
            last = k;
        }
        k = k + 1;
    }
    st[END_N] = n;
    st[END_LAST] = last;
    if (last == NONE) {
        st[SCAN_HI] = st[NCARDS];
        st[IGNORED] = 0;
    } else {
        st[SCAN_HI] = last;
        st[IGNORED] = st[NCARDS] - last - 1;
    }
}

// ---------------------------------------------------------------- reading the cards

/// Count one card of kind `kind` in the source text.
pub fn count(st: []usize, kind: usize) -> void {
    st[SRC + kind] = st[SRC + kind] + 1;
}

/// A value token: it must be a number.
pub fn need_num(w: []const u8, st: []usize, k: usize, t: usize, e: usize) -> bool {
    if (t == NONE or t >= e or is_punct(w[t])) {
        reject(st, Y_FIELDS, k, NONE);
        return false;
    }
    if (!parse_num(w, t, tk_end(w, t, e), st)) {
        reject(st, Y_NUMBER, k, t);
        return false;
    }
    return true;
}

/// The key=value pairs from p to the end of the card k. `allow` is a mask set of the keys that may
/// appear: 1 m, 2 w, 4 l, 8 ng, 16 ic. Every value is a number; with `whole` the m must be a whole number.
pub fn check_params(w: []const u8, st: []usize, k: usize, p: usize, e: usize, allow: usize, whole: bool) -> void {
    var q : usize = p;
    var go : bool = true;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            go = false;
        } else {
            const te : usize = tk_end(w, t, e);
            const eq : usize = tk(w, te, e);
            if (is_punct(w[t]) or eq >= e or w[eq] != B_EQ) {
                reject(st, Y_PARAM, k, t);
                go = false;
            } else {
                const v : usize = tk(w, eq + 1, e);
                var mask : usize = 0;
                if (ci_is(w, t, te, "m")) { mask = 1; }
                if (ci_is(w, t, te, "w")) { mask = 2; }
                if (ci_is(w, t, te, "l")) { mask = 4; }
                if (ci_is(w, t, te, "ng")) { mask = 8; }
                if (ci_is(w, t, te, "ic")) { mask = 16; }
                if (mask == 0 or (allow / mask) % 2 == 0) {
                    reject(st, Y_PARAM, k, t);
                    go = false;
                } else if (!need_num(w, st, k, v, e)) {
                    go = false;
                } else {
                    if (mask == 1 and whole and !whole_mult(st[VM], st[VE], st[VS])) {
                        reject(st, Y_MULT, k, v);
                        go = false;
                    }
                    q = tk_end(w, v, e);
                }
            }
        }
    }
}

/// R, C and L: name, two nodes, a value, then m=; a capacitor and an inductor also take ic=.
pub fn passive(w: []const u8, st: []usize, k: usize, kind: usize, t1: usize, e: usize) -> void {
    count(st, kind);
    const q : usize = after_word(w, t1, e, 2);
    const v : usize = word_at(w, t1, e, 2);
    var allow : usize = 1;
    if (kind != K_R) { allow = 17; }
    if (q == NONE) {
        reject(st, Y_FIELDS, k, NONE);
    } else if (need_num(w, st, k, v, e)) {
        check_params(w, st, k, q, e, allow, false);
    }
}

/// How many numbers sit between the ( at t and its ), NONE when the group is malformed or holds a non-number.
/// The position after the ) is left in st[GROUP_END].
pub fn group_count(w: []const u8, st: []usize, k: usize, t: usize, e: usize) -> usize {
    if (t >= e or w[t] != B_LPAREN) { return NONE; }
    var q : usize = t + 1;
    var n : usize = 0;
    var result : usize = NONE;
    var go : bool = true;
    while (go) {
        const a : usize = tk(w, q, e);
        if (a >= e) {
            go = false;
        } else if (w[a] == B_RPAREN) {
            st[GROUP_END] = a + 1;
            result = n;
            go = false;
        } else if (is_punct(w[a]) or !parse_num(w, a, tk_end(w, a, e), st)) {
            reject(st, Y_NUMBER, k, a);
            go = false;
        } else {
            n = n + 1;
            q = tk_end(w, a, e);
        }
    }
    return result;
}

/// V and I: two nodes, then a DC value, or DC value, or one of PULSE( .. ), SIN( .. ), PWL( .. ).
pub fn source(w: []const u8, st: []usize, k: usize, kind: usize, t1: usize, e: usize) -> void {
    count(st, kind);
    var q : usize = after_word(w, t1, e, 1);
    if (q == NONE) {
        reject(st, Y_FIELDS, k, NONE);
        return;
    }
    var wave : usize = WV_DC;
    var seen : usize = 0;
    var go : bool = true;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            go = false;
        } else {
            const te : usize = tk_end(w, t, e);
            if (ci_is(w, t, te, "dc")) {
                if (!need_num(w, st, k, tk(w, te, e), e)) { return; }
                q = tk_end(w, tk(w, te, e), e);
            } else if (ci_is(w, t, te, "pulse") or ci_is(w, t, te, "sin") or ci_is(w, t, te, "pwl")) {
                const n : usize = group_count(w, st, k, tk(w, te, e), e);
                if (n == NONE) {
                    reject(st, Y_FIELDS, k, t);
                    return;
                }
                var ok : bool = false;
                if (ci_is(w, t, te, "pulse")) { wave = WV_PULSE; ok = n >= 2 and n <= 7; }
                if (ci_is(w, t, te, "sin")) { wave = WV_SIN; ok = n >= 3 and n <= 6; }
                if (ci_is(w, t, te, "pwl")) { wave = WV_PWL; ok = n >= 2 and n % 2 == 0; }
                if (!ok) {
                    reject(st, Y_FIELDS, k, t);
                    return;
                }
                q = st[GROUP_END];
            } else if (seen == 0 and !is_punct(w[t]) and parse_num(w, t, te, st)) {
                q = te;
            } else {
                reject(st, Y_SOURCE, k, t);
                return;
            }
            seen = seen + 1;
        }
    }
    if (seen == 0) {
        reject(st, Y_FIELDS, k, NONE);
    } else {
        st[WAVE + wave] = st[WAVE + wave] + 1;
    }
}

/// Is the identifier w[a..b] one that a B expression may hold and still be a function of time alone? `time`, the
/// step and ramp functions u, u2 and uramp, and the plain functions of one number. v, i, a node name, a branch
/// name and every other word are not (a B source that reads a node is a nonlinear or controlled source).
pub fn time_word(w: []const u8, a: usize, b: usize) -> bool {
    return ci_is(w, a, b, "time") or ci_is(w, a, b, "u") or ci_is(w, a, b, "u2") or ci_is(w, a, b, "uramp") or ci_is(w, a, b, "abs") or ci_is(w, a, b, "sgn") or ci_is(w, a, b, "sin") or ci_is(w, a, b, "cos") or ci_is(w, a, b, "exp") or ci_is(w, a, b, "sqrt");
}

/// Is the expression w[a..b] built from numbers, `time`, those functions and + - * / ^ ( ) , and blanks, and from
/// nothing else? A number is digits and dots, an exponent, then a scale factor and units; it may not be followed by
/// a (. True means a function of time alone; any other character or word means it is not read.
pub fn time_only(w: []const u8, a: usize, b: usize) -> bool {
    var q : usize = a;
    var any : bool = false;
    while (q < b) {
        const c : u8 = w[q];
        if (is_digit(c) or c == B_DOT) {
            any = true;
            while (q < b and (is_digit(w[q]) or w[q] == B_DOT)) { q = q + 1; }
            if (q + 1 < b and lower(w[q]) == 101 and (is_digit(w[q + 1]) or ((w[q + 1] == B_MINUS or w[q + 1] == B_PLUS) and q + 2 < b and is_digit(w[q + 2])))) {
                q = q + 2;
                while (q < b and is_digit(w[q])) { q = q + 1; }
            }
            while (q < b and is_alpha(w[q])) { q = q + 1; }
            if (q < b and w[q] == B_LPAREN) { return false; }
        } else if (is_alpha(c)) {
            var f : usize = q;
            while (f < b and (is_alpha(w[f]) or is_digit(w[f]))) { f = f + 1; }
            if (!time_word(w, q, f)) { return false; }
            any = true;
            q = f;
        } else if (is_sep(c) or c == B_LPAREN or c == B_RPAREN or c == B_PLUS or c == B_MINUS or c == B_STAR or c == 47 or c == 94) {
            q = q + 1;
        } else {
            return false;
        }
    }
    return any;
}

/// B: name n+ n- V = expression. A voltage that is a function of time alone is an input, like a V source (ngspice
/// calls it behavioural; the decks of specs/analog/decks drive their circuit with one so the step is exact). A B
/// current source, an expression that reads a node or a branch, or any other form is refused.
pub fn bsource(w: []const u8, st: []usize, k: usize, t1: usize, e: usize) -> void {
    const q : usize = after_word(w, t1, e, 1);
    if (q == NONE) {
        reject(st, Y_B, k, NONE);
        return;
    }
    const kt : usize = tk(w, q, e);
    const ke : usize = tk_end(w, kt, e);
    const eq : usize = tk(w, ke, e);
    if (kt >= e or !ci_is(w, kt, ke, "v") or eq >= e or w[eq] != B_EQ or !time_only(w, eq + 1, e)) {
        reject(st, Y_B, k, NONE);
        return;
    }
    count(st, K_V);
    st[N_BSRC] = st[N_BSRC] + 1;
}

/// E: a voltage-controlled voltage source, name n+ n- nc+ nc- gain, and nothing else.
pub fn vcvs(w: []const u8, st: []usize, k: usize, t1: usize, e: usize) -> void {
    count(st, K_E);
    const g : usize = word_at(w, t1, e, 4);
    if (g == NONE) {
        reject(st, Y_E, k, NONE);
        return;
    }
    const q : usize = tk_end(w, g, e);
    if (tk(w, q, e) < e) {
        reject(st, Y_E, k, tk(w, q, e));
    } else if (!parse_num(w, g, q, st)) {
        reject(st, Y_E, k, g);
    }
}

/// Split an X card (or a .subckt card, from its first node on) at the first key=value: the words before
/// it are nodes and, last, the model. Sets st[XN] nodes, st[XA..XB] the model, st[XP] where the pairs
/// begin (e when there are none). False when there are fewer than two words.
pub fn xparse(w: []const u8, st: []usize, k: usize) -> bool {
    const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
    var q : usize = tk_end(w, st[CARD0 + k * CARD_SLOTS + C_A], e);
    var words : usize = 0;
    var ma : usize = 0;
    var mb : usize = 0;
    var pairs : usize = e;
    var go : bool = true;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            go = false;
        } else {
            const te : usize = tk_end(w, t, e);
            const nx : usize = tk(w, te, e);
            if (nx < e and w[nx] == B_EQ and !is_punct(w[t])) {
                pairs = t;
                go = false;
            } else if (is_punct(w[t])) {
                pairs = t;
                go = false;
            } else {
                words = words + 1;
                ma = t;
                mb = te;
                q = te;
            }
        }
    }
    st[XN] = 0;
    if (words > 0) { st[XN] = words - 1; }
    st[XA] = ma;
    st[XB] = mb;
    st[XP] = pairs;
    return words >= 2;
}

/// The PDK device an X card's model names, X_NONE when it is none of the table's.
pub fn pdk_class(w: []const u8, a: usize, b: usize) -> usize {
    if (ci_is(w, a, b, "sg13_lv_nmos")) { return X_NMOS; }
    if (ci_is(w, a, b, "sg13_lv_pmos")) { return X_PMOS; }
    if (ci_is(w, a, b, "cap_cmim")) { return X_MIM; }
    return X_NONE;
}

/// An X card: nodes, a model, then key=value pairs. Only the shape is checked here; whether the model
/// is a subcircuit of the deck or a PDK device waits until every .subckt is known (resolve).
pub fn x_card(w: []const u8, st: []usize, k: usize) -> void {
    st[N_XCARDS] = st[N_XCARDS] + 1;
    if (!xparse(w, st, k)) {
        reject(st, Y_FIELDS, k, NONE);
        return;
    }
    check_params(w, st, k, st[XP], st[CARD0 + k * CARD_SLOTS + C_B], 15, true);
}

pub fn element(w: []const u8, st: []usize, k: usize, t0: usize, t1: usize, e: usize) -> void {
    const c : u8 = lower(w[t0]);
    if (c == 114) { passive(w, st, k, K_R, t1, e); }
    else if (c == 99) { passive(w, st, k, K_C, t1, e); }
    else if (c == 108) { passive(w, st, k, K_L, t1, e); }
    else if (c == 118) { source(w, st, k, K_V, t1, e); }
    else if (c == 105) { source(w, st, k, K_I, t1, e); }
    else if (c == 101) { vcvs(w, st, k, t1, e); }
    else if (c == 120) { x_card(w, st, k); }
    else if (c == 98) { bsource(w, st, k, t1, e); }
    else { reject(st, Y_ELEMENT, k, NONE); }
}

// ---------------------------------------------------------------- directives

/// Is the directive token w[a..b] one of the two spellings?
pub fn dir_is(w: []const u8, a: usize, b: usize, one: []const u8, two: []const u8) -> bool {
    return ci_is(w, a, b, one) or ci_is(w, a, b, two);
}

/// The definition of a name among the ones whose parent is `scope` or an ancestor of it, NONE if none.
pub fn find_def(w: []const u8, st: []usize, a: usize, b: usize, scope: usize) -> usize {
    var s : usize = scope;
    var found : usize = NONE;
    var go : bool = true;
    while (go) {
        var d : usize = 0;
        while (go and d < st[NDEF]) {
            if (st[DEF0 + d * DEF_SLOTS + D_PARENT] == s and same_ci(w, a, b, st[DEF0 + d * DEF_SLOTS + D_NAME_A], st[DEF0 + d * DEF_SLOTS + D_NAME_B])) {
                found = d;
                go = false;
            }
            d = d + 1;
        }
        if (go) {
            if (s == NONE or s == SCOPE_CTL) {
                go = false;
            } else {
                s = st[DEF0 + s * DEF_SLOTS + D_PARENT];
            }
        }
    }
    st[DEF_HIT] = found;
    return found;
}

/// .subckt name port ... : a definition. Parameters on the line are refused, but the definition is still
/// recorded so its instances do not also read as undefined.
pub fn d_subckt(w: []const u8, st: []usize, k: usize, t1: usize, e: usize) -> void {
    const na : usize = word_at(w, t1, e, 0);
    if (na == NONE) {
        reject(st, Y_FIELDS, k, NONE);
        return;
    }
    const nb : usize = tk_end(w, na, e);
    var ports : usize = 0;
    var q : usize = nb;
    var go : bool = true;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            go = false;
        } else {
            const te : usize = tk_end(w, t, e);
            const nx : usize = tk(w, te, e);
            if (is_punct(w[t]) or (nx < e and w[nx] == B_EQ)) {
                reject(st, Y_SUBPARAM, k, t);
                go = false;
            } else {
                ports = ports + 1;
                q = te;
            }
        }
    }
    if (st[NDEF] >= MAXDEF) {
        reject(st, Y_SIZE, k, NONE);
        return;
    }
    const dup : usize = find_def(w, st, na, nb, st[CUR]);
    if (dup != NONE and st[DEF0 + dup * DEF_SLOTS + D_PARENT] == st[CUR]) {
        reject(st, Y_DUP, k, na);
    }
    const d : usize = st[NDEF];
    st[DEF0 + d * DEF_SLOTS + D_NAME_A] = na;
    st[DEF0 + d * DEF_SLOTS + D_NAME_B] = nb;
    st[DEF0 + d * DEF_SLOTS + D_NPORTS] = ports;
    st[DEF0 + d * DEF_SLOTS + D_FIRST] = k;
    st[DEF0 + d * DEF_SLOTS + D_LAST] = NONE;
    st[DEF0 + d * DEF_SLOTS + D_PARENT] = st[CUR];
    st[NDEF] = d + 1;
    st[CUR] = d;
}

/// .ends [name]: closes the definition being read.
pub fn d_ends(w: []const u8, st: []usize, k: usize, t1: usize, e: usize) -> void {
    const d : usize = st[CUR];
    if (d == NONE) {
        reject(st, Y_ENDS, k, NONE);
        return;
    }
    const na : usize = word_at(w, t1, e, 0);
    if (na != NONE and !same_ci(w, na, tk_end(w, na, e), st[DEF0 + d * DEF_SLOTS + D_NAME_A], st[DEF0 + d * DEF_SLOTS + D_NAME_B])) {
        reject(st, Y_ENDS, k, na);
    }
    st[DEF0 + d * DEF_SLOTS + D_LAST] = k;
    st[CUR] = st[DEF0 + d * DEF_SLOTS + D_PARENT];
}

/// Exactly `n` words after the directive and nothing else.
pub fn only_words(w: []const u8, t1: usize, e: usize, n: usize) -> bool {
    const q : usize = after_word(w, t1, e, n - 1);
    if (q == NONE) { return false; }
    return tk(w, q, e) >= e;
}

/// .options key=value ... : TEMP, and the integration the cell is judged by: method=gear (or trap, trapezoidal),
/// maxord=<number> and trtol=<number>. Any other key is refused.
pub fn d_options(w: []const u8, st: []usize, k: usize, t1: usize, e: usize) -> void {
    st[N_OPT] = st[N_OPT] + 1;
    var q : usize = t1;
    var go : bool = true;
    var seen : usize = 0;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            go = false;
        } else {
            const te : usize = tk_end(w, t, e);
            const eq : usize = tk(w, te, e);
            const v : usize = tk(w, eq + 1, e);
            var key : usize = 0;
            if (ci_is(w, t, te, "temp")) { key = 1; }
            if (ci_cat(w, t, te, "meth", "od")) { key = 2; }
            if (ci_is(w, t, te, "maxord")) { key = 3; }
            if (ci_is(w, t, te, "trtol")) { key = 4; }
            if (is_punct(w[t]) or key == 0 or eq >= e or w[eq] != B_EQ) {
                reject(st, Y_OPTION, k, t);
                go = false;
            } else if (key == 2) {
                const ve : usize = tk_end(w, v, e);
                if (v >= e or is_punct(w[v])) {
                    reject(st, Y_FIELDS, k, NONE);
                    go = false;
                } else if (ci_is(w, v, ve, "gear")) {
                    st[OPT_METHOD] = 1;
                    seen = seen + 1;
                    q = ve;
                } else if (ci_is(w, v, ve, "trap") or ci_is(w, v, ve, "trapezoidal")) {
                    st[OPT_METHOD] = 2;
                    seen = seen + 1;
                    q = ve;
                } else {
                    reject(st, Y_OPTION, k, v);
                    go = false;
                }
            } else if (!need_num(w, st, k, v, e)) {
                go = false;
            } else {
                if (key == 1) { st[TEMP_CARD] = k; }
                if (key == 3) {
                    if (st[VM] == 1 and st[VE] == EXP_BIAS and st[VS] == 0) { st[OPT_MAXORD] = 1; } else { st[OPT_MAXORD] = 2; }
                }
                seen = seen + 1;
                q = tk_end(w, v, e);
            }
        }
    }
    if (seen == 0) { reject(st, Y_FIELDS, k, NONE); }
}

/// .PARAM name=literal ... and .ic / .nodeset v(node)=literal ... : `groups` says which. Returns how many.
pub fn pairs(w: []const u8, st: []usize, k: usize, t1: usize, e: usize, groups: bool) -> usize {
    var q : usize = t1;
    var n : usize = 0;
    var go : bool = true;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            go = false;
        } else {
            var eq : usize = NONE;
            const te : usize = tk_end(w, t, e);
            if (groups) {
                // v ( node ) =
                const lp : usize = tk(w, te, e);
                const nd : usize = tk(w, lp + 1, e);
                const rp : usize = tk(w, tk_end(w, nd, e), e);
                const q2 : usize = tk(w, rp + 1, e);
                if (ci_is(w, t, te, "v") and lp < e and w[lp] == B_LPAREN and nd < e and !is_punct(w[nd]) and rp < e and w[rp] == B_RPAREN and q2 < e and w[q2] == B_EQ) { eq = q2; }
            } else {
                const q2 : usize = tk(w, te, e);
                if (!is_punct(w[t]) and q2 < e and w[q2] == B_EQ) { eq = q2; }
            }
            if (eq == NONE) {
                reject(st, Y_FIELDS, k, t);
                go = false;
            } else if (!need_num(w, st, k, tk(w, eq + 1, e), e)) {
                go = false;
            } else {
                n = n + 1;
                q = tk_end(w, tk(w, eq + 1, e), e);
            }
        }
    }
    if (n == 0 and st[ERR_LINE] == 0) { reject(st, Y_FIELDS, k, NONE); }
    return n;
}

/// The arguments of a transient analysis, from p: step and stop, up to two more numbers, and uic.
pub fn tran_args(w: []const u8, st: []usize, k: usize, p: usize, e: usize) -> void {
    var q : usize = p;
    var n : usize = 0;
    var go : bool = true;
    while (go) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            go = false;
        } else {
            const te : usize = tk_end(w, t, e);
            if (n >= 2 and ci_is(w, t, te, "uic")) {
                q = te;
            } else if (n < 4 and !is_punct(w[t]) and parse_num(w, t, te, st)) {
                n = n + 1;
                q = te;
            } else {
                reject(st, Y_NUMBER, k, t);
                go = false;
            }
        }
    }
    if (n < 2) { reject(st, Y_FIELDS, k, NONE); }
}

pub fn directive(w: []const u8, st: []usize, k: usize, t0: usize, t1: usize, e: usize) -> void {
    if (ci_is(w, t0, t1, ".subckt")) {
        d_subckt(w, st, k, t1, e);
    } else if (ci_is(w, t0, t1, ".ends")) {
        d_ends(w, st, k, t1, e);
    } else if (ci_is(w, t0, t1, ".end")) {
        // a .end with more cards after it: a section break (mark_end counted it)
    } else if (ci_is(w, t0, t1, ".control")) {
        if (st[CUR] != NONE) { reject(st, Y_CTLIN, k, NONE); }
        st[CTL_CARD] = k;
    } else if (ci_is(w, t0, t1, ".lib")) {
        st[N_LIB] = st[N_LIB] + 1;
        if (!only_words(w, t1, e, 2)) { reject(st, Y_FIELDS, k, NONE); }
    } else if (dir_is(w, t0, t1, ".include", ".inc")) {
        st[N_INC] = st[N_INC] + 1;
        if (!only_words(w, t1, e, 1)) { reject(st, Y_FIELDS, k, NONE); }
    } else if (dir_is(w, t0, t1, ".options", ".option")) {
        d_options(w, st, k, t1, e);
    } else if (ci_cat(w, t0, t1, ".par", "am") or ci_cat(w, t0, t1, ".par", "ams")) {
        st[N_PARAM] = st[N_PARAM] + pairs(w, st, k, t1, e, false);
    } else if (ci_is(w, t0, t1, ".tran")) {
        st[N_TRAN] = st[N_TRAN] + 1;
        tran_args(w, st, k, t1, e);
    } else if (ci_is(w, t0, t1, ".ic")) {
        st[N_IC] = st[N_IC] + pairs(w, st, k, t1, e, true);
    } else if (ci_is(w, t0, t1, ".nodeset")) {
        st[N_NODESET] = st[N_NODESET] + pairs(w, st, k, t1, e, true);
    } else if (ci_is(w, t0, t1, ".save")) {
        st[N_SAVE] = st[N_SAVE] + 1;
    } else if (ci_is(w, t0, t1, ".global")) {
        st[N_GLOBAL] = st[N_GLOBAL] + 1;
        if (word_at(w, t1, e, 0) == NONE) { reject(st, Y_FIELDS, k, NONE); }
    } else {
        reject(st, Y_DIRECTIVE, k, NONE);
    }
}

/// Is the control command w[a..b] one that only plots, prints, saves or sets a variable?
pub fn inert_command(w: []const u8, a: usize, b: usize) -> bool {
    return ci_is(w, a, b, "let") or ci_is(w, a, b, "plot") or ci_is(w, a, b, "set") or ci_is(w, a, b, "unset") or ci_is(w, a, b, "write") or ci_cat(w, a, b, "ru", "n") or ci_is(w, a, b, "print") or ci_is(w, a, b, "echo") or ci_is(w, a, b, "wrdata") or ci_is(w, a, b, "setplot") or ci_is(w, a, b, "display") or ci_is(w, a, b, "destroy") or ci_is(w, a, b, "quit") or ci_is(w, a, b, "exit") or ci_is(w, a, b, "save") or ci_is(w, a, b, "hardcopy");
}

/// A card inside .control ... .endc.
pub fn control_card(w: []const u8, st: []usize, k: usize, t0: usize, t1: usize, e: usize) -> void {
    if (ci_is(w, t0, t1, ".endc")) {
        st[CTL_CARD] = NONE;
    } else if (ci_is(w, t0, t1, "tran")) {
        st[N_TRAN_CTL] = st[N_TRAN_CTL] + 1;
        tran_args(w, st, k, t1, e);
    } else if (inert_command(w, t0, t1)) {
        st[N_CTLCMD] = st[N_CTLCMD] + 1;
    } else {
        reject(st, Y_CTL, k, t0);
    }
}

pub fn scan_card(w: []const u8, st: []usize, k: usize) -> void {
    const a : usize = st[CARD0 + k * CARD_SLOTS + C_A];
    const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
    const t0 : usize = tk(w, a, e);
    const t1 : usize = tk_end(w, t0, e);
    if (st[CTL_CARD] != NONE) {
        st[CARD0 + k * CARD_SLOTS + C_SCOPE] = SCOPE_CTL;
        control_card(w, st, k, t0, t1, e);
        return;
    }
    st[CARD0 + k * CARD_SLOTS + C_SCOPE] = st[CUR];
    const brace : usize = find_either(w, a, e, B_LBRACE, B_APOS);
    if (brace != NONE) {
        reject(st, Y_EXPR, k, brace);
    } else if (w[t0] == B_DOT) {
        directive(w, st, k, t0, t1, e);
    } else {
        element(w, st, k, t0, t1, e);
    }
}

pub fn scan(w: []const u8, st: []usize) -> void {
    var k : usize = 0;
    while (k < st[SCAN_HI]) {
        scan_card(w, st, k);
        k = k + 1;
    }
    if (st[CUR] != NONE) {
        reject(st, Y_OPEN, st[DEF0 + st[CUR] * DEF_SLOTS + D_FIRST], st[DEF0 + st[CUR] * DEF_SLOTS + D_NAME_A]);
    }
    if (st[CTL_CARD] != NONE) { reject(st, Y_CTLOPEN, st[CTL_CARD], NONE); }
}

// ---------------------------------------------------------------- resolving the X cards

/// What the X card k names: a subcircuit of the deck (its index in st[DEF_HIT]), a PDK device, or nothing.
pub fn x_class(w: []const u8, st: []usize, k: usize) -> usize {
    if (!xparse(w, st, k)) { return X_NONE; }
    const d : usize = find_def(w, st, st[XA], st[XB], st[CARD0 + k * CARD_SLOTS + C_SCOPE]);
    if (d != NONE) { return X_SUB; }
    return pdk_class(w, st[XA], st[XB]);
}

/// The m of the X card k, 1 when it has none (check_params has seen that it is a whole number).
pub fn x_mult(w: []const u8, st: []usize, k: usize) -> usize {
    const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
    var q : usize = st[XP];
    while (q < e) {
        const t : usize = tk(w, q, e);
        if (t >= e) { return 1; }
        const te : usize = tk_end(w, t, e);
        const v : usize = tk(w, tk(w, te, e) + 1, e);
        if (ci_is(w, t, te, "m") and parse_num(w, v, tk_end(w, v, e), st) and whole_mult(st[VM], st[VE], st[VS])) { return mult_value(st[VM], st[VE]); }
        q = tk_end(w, v, e);
    }
    return 1;
}

/// Every X card against the definitions: a subcircuit takes as many nodes as it has ports and only m; a
/// PDK device takes its node count; anything else is undefined. The cards of the source text are counted.
pub fn resolve(w: []const u8, st: []usize) -> void {
    var k : usize = 0;
    while (k < st[SCAN_HI]) {
        const a : usize = st[CARD0 + k * CARD_SLOTS + C_A];
        const t0 : usize = tk(w, a, st[CARD0 + k * CARD_SLOTS + C_B]);
        if (st[CARD0 + k * CARD_SLOTS + C_SCOPE] != SCOPE_CTL and w[t0] != B_DOT and lower(w[t0]) == 120 and xparse(w, st, k)) {
            const cls : usize = x_class(w, st, k);
            if (cls == X_SUB) {
                count(st, K_X);
                if (st[XN] != st[DEF0 + st[DEF_HIT] * DEF_SLOTS + D_NPORTS]) { reject(st, Y_PORTS, k, st[XA]); }
                if (st[XP] < st[CARD0 + k * CARD_SLOTS + C_B]) { check_params(w, st, k, st[XP], st[CARD0 + k * CARD_SLOTS + C_B], 1, true); }
            } else if (cls == X_NONE) {
                reject(st, Y_UNDEF, k, st[XA]);
            } else if (cls == X_MIM) {
                count(st, K_MIM);
                st[N_MIM] = st[N_MIM] + 1;
                if (st[XN] != 2) { reject(st, Y_PORTS, k, st[XA]); }
            } else {
                count(st, K_MOS);
                if (cls == X_NMOS) { st[N_NMOS] = st[N_NMOS] + 1; } else { st[N_PMOS] = st[N_PMOS] + 1; }
                if (st[XN] != 4) { reject(st, Y_PORTS, k, st[XA]); }
            }
        }
        k = k + 1;
    }
}

// ---------------------------------------------------------------- flattening

/// Write the name w[a..b] lowercased.
pub fn put_lower(w: []const u8, st: []usize, out: []u8, a: usize, b: usize) -> void {
    var i : usize = a;
    while (i < b) {
        put(st, out, lower(w[i]));
        i = i + 1;
    }
}

/// Write the path scratch: the instance names above the level being read, each followed by a dot.
pub fn put_trail(w: []const u8, st: []usize, out: []u8, plen: usize) -> void {
    var i : usize = 0;
    while (i < plen) {
        put(st, out, w[st[WEND] + i]);
        i = i + 1;
    }
}

/// One leaf device of the flattened circuit: its hierarchical name, its kind and, for a PDK device, its
/// model and the product of the m of the instance and of the instances above it.
pub fn emit_leaf(w: []const u8, st: []usize, out: []u8, k: usize, plen: usize, kind: []const u8, weight: usize) -> void {
    const a : usize = st[CARD0 + k * CARD_SLOTS + C_A];
    put_trail(w, st, out, plen);
    put_lower(w, st, out, a, tk_end(w, a, st[CARD0 + k * CARD_SLOTS + C_B]));
    puts(st, out, " ");
    puts(st, out, kind);
    if (weight > 0) {
        puts(st, out, " ");
        put_lower(w, st, out, st[XA], st[XB]);
        puts(st, out, " m=");
        put_num(st, out, weight);
    }
    put(st, out, B_NL);
}

/// Walk the cards lo..hi that belong to `scope` (a definition, or NONE for the top of the deck). A leaf
/// is counted (when st[EMIT] is 0) or listed (when it is 1); an X card of a subcircuit opens a level: the
/// instance name goes on the path scratch and the definition's cards are walked.
pub fn flatten(w: []u8, st: []usize, out: []u8, scope: usize, lo: usize, hi: usize, plen: usize, depth: usize, mult: usize) -> void {
    if (depth > st[DEPTH_SEEN]) { st[DEPTH_SEEN] = depth; }
    if (depth > 0 and depth <= MAX_DEPTH) { st[STK + depth - 1] = scope; }
    var k : usize = lo;
    while (k < hi) {
        const a : usize = st[CARD0 + k * CARD_SLOTS + C_A];
        const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
        const t0 : usize = tk(w, a, e);
        if (st[CARD0 + k * CARD_SLOTS + C_SCOPE] == scope and w[t0] != B_DOT) {
            const c : u8 = lower(w[t0]);
            var kind : usize = K_COUNT;
            var label : []const u8 = "";
            if (c == 114) { kind = K_R; label = "r"; }
            if (c == 99) { kind = K_C; label = "c"; }
            if (c == 108) { kind = K_L; label = "l"; }
            if (c == 118) { kind = K_V; label = "v"; }
            if (c == 98) { kind = K_V; label = "b"; }
            if (c == 105) { kind = K_I; label = "i"; }
            if (c == 101) { kind = K_E; label = "e"; }
            if (kind < K_COUNT) {
                if (st[EMIT] == 0) { st[FLAT + kind] = st[FLAT + kind] + 1; } else { emit_leaf(w, st, out, k, plen, label, 0); }
            } else if (c == 120) {
                const cls : usize = x_class(w, st, k);
                if (cls == X_SUB) {
                    const d : usize = st[DEF_HIT];
                    const nm : usize = mult * x_mult(w, st, k);
                    const nl : usize = tk_end(w, t0, e) - t0;
                    var open : bool = false;
                    var j : usize = 0;
                    while (j < depth and j < MAX_DEPTH) {
                        if (st[STK + j] == d) { open = true; }
                        j = j + 1;
                    }
                    if (open) {
                        reject(st, Y_RECUR, k, st[XA]);
                    } else if (depth >= MAX_DEPTH) {
                        reject(st, Y_DEPTH, k, st[XA]);
                    } else if (nm > MAX_MULT) {
                        reject(st, Y_MULT, k, NONE);
                    } else if (st[WEND] + plen + nl + 1 > w.len) {
                        reject(st, Y_SIZE, k, NONE);
                    } else {
                        if (st[EMIT] == 0) { st[FLAT + K_X] = st[FLAT + K_X] + 1; }
                        var i : usize = 0;
                        while (i < nl) {
                            w[st[WEND] + plen + i] = lower(w[t0 + i]);
                            i = i + 1;
                        }
                        w[st[WEND] + plen + nl] = B_DOT;
                        flatten(w, st, out, d, st[DEF0 + d * DEF_SLOTS + D_FIRST] + 1, st[DEF0 + d * DEF_SLOTS + D_LAST], plen + nl + 1, depth + 1, nm);
                    }
                } else if (cls != X_NONE) {
                    const weight : usize = mult * x_mult(w, st, k);
                    if (weight > MAX_MULT) {
                        reject(st, Y_MULT, k, NONE);
                    } else if (st[EMIT] == 0) {
                        if (cls == X_MIM) {
                            st[FLAT + K_MIM] = st[FLAT + K_MIM] + 1;
                            st[FLAT_MIM_W] = st[FLAT_MIM_W] + weight;
                        } else {
                            st[FLAT + K_MOS] = st[FLAT + K_MOS] + 1;
                            st[FLAT_MOS_W] = st[FLAT_MOS_W] + weight;
                        }
                    } else if (cls == X_MIM) {
                        emit_leaf(w, st, out, k, plen, "mim", weight);
                    } else {
                        emit_leaf(w, st, out, k, plen, "mos", weight);
                    }
                }
            }
        }
        k = k + 1;
    }
}

// ---------------------------------------------------------------- the inventory

/// Write the number parse_num found: whole numbers up to 9 powers of ten in digits (50), anything else as
/// <mantissa>e<exponent> (5e-8 is 50n); zero is 0.
pub fn put_val(st: []usize, out: []u8) -> void {
    if (st[VS] != 0) { put(st, out, B_MINUS); }
    put_num(st, out, st[VM]);
    if (st[VM] != 0 and st[VE] > EXP_BIAS and st[VE] - EXP_BIAS <= 9) {
        var z : usize = st[VE] - EXP_BIAS;
        while (z > 0) {
            put(st, out, B_ZERO);
            z = z - 1;
        }
    } else if (st[VM] != 0 and st[VE] != EXP_BIAS) {
        puts(st, out, "e");
        if (st[VE] < EXP_BIAS) {
            put(st, out, B_MINUS);
            put_num(st, out, EXP_BIAS - st[VE]);
        } else {
            put_num(st, out, st[VE] - EXP_BIAS);
        }
    }
}

/// Write the token w[t..] of card e, the way it was written.
pub fn put_tok(w: []const u8, st: []usize, out: []u8, t: usize, e: usize) -> void {
    put_text(w, st, out, t, tk_end(w, t, e), SHOW);
}

/// One `key=value` count line of the inventory.
pub fn put_kv(st: []usize, out: []u8, key: []const u8, v: usize) -> void {
    puts(st, out, key);
    put_num(st, out, v);
}

/// The reason of the refusal in st, with the token it is about.
pub fn put_why(w: []const u8, st: []usize, out: []u8) -> void {
    const why : usize = st[ERR_WHY];
    const k : usize = st[ERR_CARD];
    const tok : usize = st[ERR_TOK];
    if (why == Y_CONT) { puts(st, out, "continuation line with no card before it"); }
    else if (why == Y_SIZE) { puts(st, out, "deck is larger than the reader's tables"); }
    else if (why == Y_B) { puts(st, out, "B source not supported (only a voltage that is a function of time alone is read)"); }
    else if (why == Y_ELEMENT) {
        const c : u8 = lower(w[st[CARD0 + k * CARD_SLOTS + C_A]]);
        if (c >= 97 and c <= 122) { put(st, out, c - 32); } else { put(st, out, c); }
        puts(st, out, " element not supported");
    }
    else if (why == Y_DIRECTIVE) {
        put_tok(w, st, out, st[CARD0 + k * CARD_SLOTS + C_A], st[CARD0 + k * CARD_SLOTS + C_B]);
        puts(st, out, " directive not supported");
    }
    else if (why == Y_EXPR) { puts(st, out, "expression in braces or quotes not supported"); }
    else if (why == Y_FIELDS) { puts(st, out, "wrong number of fields"); }
    else if (why == Y_E) { puts(st, out, "E source must be a VCVS: name n+ n- nc+ nc- gain"); }
    else if (why == Y_SUBPARAM) { puts(st, out, "subcircuit parameters not supported"); }
    else if (why == Y_ENDS) { puts(st, out, ".ends does not close a .subckt"); }
    else if (why == Y_CTLOPEN) { puts(st, out, ".control without .endc"); }
    else if (why == Y_CTLIN) { puts(st, out, ".control inside a .subckt not supported"); }
    else if (why == Y_MULT) { puts(st, out, "m must be a whole number from 1 to 1000000000"); }
    else {
        if (why == Y_NUMBER) { puts(st, out, "not a literal number"); }
        if (why == Y_PARAM) { puts(st, out, "parameter not supported"); }
        if (why == Y_SOURCE) { puts(st, out, "source form not supported"); }
        if (why == Y_UNDEF) { puts(st, out, "subcircuit or device model not defined"); }
        if (why == Y_PORTS) { puts(st, out, "node count differs from the ports of"); }
        if (why == Y_DEPTH) { puts(st, out, "subcircuit nesting deeper than 32 levels"); }
        if (why == Y_RECUR) { puts(st, out, "subcircuit instantiates itself"); }
        if (why == Y_OPEN) { puts(st, out, ".subckt without .ends"); }
        if (why == Y_DUP) { puts(st, out, "subcircuit defined twice"); }
        if (why == Y_CTL) { puts(st, out, "control command not supported"); }
        if (why == Y_OPTION) { puts(st, out, "option not supported (only TEMP, METHOD, MAXORD and TRTOL)"); }
        if (why == Y_CELL_EL) { puts(st, out, "not in the M1 cell (a flat deck of R, C, L and one input source)"); }
        if (why == Y_CELL_IN) { puts(st, out, "the M1 cell has exactly one input: a V source or a time-only B source from a node to ground 0"); }
        if (why == Y_CELL_VALUE) { puts(st, out, "R, C and L need a positive value (a mantissa up to 2^53, a power of ten within 22), two different nodes and no m=, and C and L may not touch the input node"); }
        if (why == Y_CELL_SIZE) { puts(st, out, "the M1 cell has 1 to 5 states (numbered nodes plus inductors)"); }
        if (why == Y_CELL_DT) { puts(st, out, "the M1 cell needs one .tran card with tstep tstop tstart tmax; dt is tmax"); }
        if (why == Y_CELL_METHOD) {
            puts(st, out, "the M1 cell is backward Euler: the deck must say .options meth");
            puts(st, out, "od=gear maxord=1");
        }
        if (why == Y_CELL_IC) { puts(st, out, "initial condition other than 0: the M1 cell starts from rest"); }
        if (why == Y_CELL_SOLVE) { puts(st, out, "the matrix has no solution (a floating node?) or a constant is beyond +-127"); }
        if (why == Y_CELL_GND) { puts(st, out, "a node called gnd is not read as ground: write 0"); }
        if (tok != NONE and k != NONE) {
            puts(st, out, ": ");
            put_tok(w, st, out, tok, st[CARD0 + k * CARD_SLOTS + C_B]);
        }
    }
}

/// `line N: reason`, then the card.
pub fn put_reject(w: []const u8, st: []usize, out: []u8) -> void {
    puts(st, out, "line ");
    put_num(st, out, st[ERR_LINE]);
    puts(st, out, ": ");
    put_why(w, st, out);
    put(st, out, B_NL);
    if (st[ERR_CARD] != NONE) {
        puts(st, out, "  card: ");
        put_text(w, st, out, st[CARD0 + st[ERR_CARD] * CARD_SLOTS + C_A], st[CARD0 + st[ERR_CARD] * CARD_SLOTS + C_B], SHOW);
        put(st, out, B_NL);
    }
}

/// The line of the inventory that says what a .tran card or a control `tran` asks: the step and stop as
/// written, then as numbers.
pub fn put_tran(w: []const u8, st: []usize, out: []u8, k: usize, t1: usize, label: []const u8) -> void {
    const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
    const a : usize = tk(w, t1, e);
    const b : usize = tk(w, tk_end(w, a, e), e);
    puts(st, out, label);
    puts(st, out, " ");
    put_tok(w, st, out, a, e);
    puts(st, out, " ");
    put_tok(w, st, out, b, e);
    puts(st, out, ": tstep ");
    if (parse_num(w, a, tk_end(w, a, e), st)) { put_val(st, out); }
    puts(st, out, " tstop ");
    if (parse_num(w, b, tk_end(w, b, e), st)) { put_val(st, out); }
    puts(st, out, " (line ");
    put_num(st, out, st[CARD0 + k * CARD_SLOTS + C_LINE]);
    puts(st, out, ")\n");
}

/// The cards that are lines of the inventory by themselves: transients, corners, includes.
pub fn put_recorded(w: []const u8, st: []usize, out: []u8) -> void {
    var corners : usize = 0;
    var k : usize = 0;
    while (k < st[SCAN_HI]) {
        const a : usize = st[CARD0 + k * CARD_SLOTS + C_A];
        const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
        const t0 : usize = tk(w, a, e);
        const t1 : usize = tk_end(w, t0, e);
        if (st[CARD0 + k * CARD_SLOTS + C_SCOPE] == SCOPE_CTL) {
            if (ci_is(w, t0, t1, "tran")) { put_tran(w, st, out, k, t1, "tran (control)"); }
        } else if (ci_is(w, t0, t1, ".tran")) {
            put_tran(w, st, out, k, t1, "tran (.tran card)");
        } else if (ci_is(w, t0, t1, ".lib")) {
            puts(st, out, "corner: ");
            put_tok(w, st, out, word_at(w, t1, e, 1), e);
            puts(st, out, " from ");
            put_tok(w, st, out, word_at(w, t1, e, 0), e);
            puts(st, out, " (not read)\n");
            corners = corners + 1;
        } else if (dir_is(w, t0, t1, ".include", ".inc")) {
            puts(st, out, "include: ");
            put_tok(w, st, out, word_at(w, t1, e, 0), e);
            puts(st, out, " (not read)\n");
        }
        k = k + 1;
    }
    if (corners == 0) { puts(st, out, "corners: none\n"); }
    if (st[TEMP_CARD] == NONE) {
        puts(st, out, "temp: none\n");
    } else {
        const tc : usize = st[TEMP_CARD];
        const e : usize = st[CARD0 + tc * CARD_SLOTS + C_B];
        var q : usize = tk_end(w, st[CARD0 + tc * CARD_SLOTS + C_A], e);
        var go : bool = true;
        while (go) {
            const t : usize = tk(w, q, e);
            if (t >= e) { go = false; }
            else if (ci_is(w, t, tk_end(w, t, e), "temp")) {
                const v : usize = tk(w, tk(w, tk_end(w, t, e), e) + 1, e);
                if (parse_num(w, v, tk_end(w, v, e), st)) {
                    puts(st, out, "temp: ");
                    put_val(st, out);
                    puts(st, out, "\n");
                }
                go = false;
            } else {
                q = tk_end(w, t, e);
            }
        }
    }
}

/// The inventory of a deck that was accepted.
pub fn put_inventory(src: []const u8, w: []u8, st: []usize, out: []u8) -> void {
    puts(st, out, "deck: ");
    put_text(src, st, out, st[TITLE_A], st[TITLE_B], SHOW);
    puts(st, out, "\nend: ");
    if (st[END_N] == 0) {
        puts(st, out, "no .end card");
    } else {
        puts(st, out, "first .end on line ");
        put_num(st, out, st[END_LINE]);
        puts(st, out, ", the deck ends with the last of ");
        put_num(st, out, st[END_N]);
        puts(st, out, ", cards after it ignored: ");
        put_num(st, out, st[IGNORED]);
    }
    puts(st, out, "\ncards: ");
    put_kv(st, out, "r=", st[SRC + K_R]);
    put_kv(st, out, " c=", st[SRC + K_C]);
    put_kv(st, out, " l=", st[SRC + K_L]);
    put_kv(st, out, " v=", st[SRC + K_V]);
    put_kv(st, out, " i=", st[SRC + K_I]);
    put_kv(st, out, " e=", st[SRC + K_E]);
    put_kv(st, out, " x=", st[N_XCARDS]);
    put_kv(st, out, " (subcircuit instances ", st[SRC + K_X]);
    put_kv(st, out, ", mos ", st[SRC + K_MOS]);
    put_kv(st, out, ", mim ", st[SRC + K_MIM]);
    puts(st, out, ")\nsources: ");
    put_kv(st, out, "dc=", st[WAVE + WV_DC]);
    put_kv(st, out, " pulse=", st[WAVE + WV_PULSE]);
    put_kv(st, out, " sin=", st[WAVE + WV_SIN]);
    put_kv(st, out, " pwl=", st[WAVE + WV_PWL]);
    if (st[N_BSRC] > 0) { put_kv(st, out, " b=", st[N_BSRC]); }
    puts(st, out, "\nsubckt definitions: ");
    put_num(st, out, st[NDEF]);
    put(st, out, B_NL);
    var d : usize = 0;
    while (d < st[NDEF]) {
        puts(st, out, "  subckt ");
        put_lower(w, st, out, st[DEF0 + d * DEF_SLOTS + D_NAME_A], st[DEF0 + d * DEF_SLOTS + D_NAME_B]);
        put_kv(st, out, " ports=", st[DEF0 + d * DEF_SLOTS + D_NPORTS]);
        if (st[DEF0 + d * DEF_SLOTS + D_PARENT] != NONE) {
            puts(st, out, " inside ");
            put_lower(w, st, out, st[DEF0 + st[DEF0 + d * DEF_SLOTS + D_PARENT] * DEF_SLOTS + D_NAME_A], st[DEF0 + st[DEF0 + d * DEF_SLOTS + D_PARENT] * DEF_SLOTS + D_NAME_B]);
        }
        put(st, out, B_NL);
        d = d + 1;
    }
    put_kv(st, out, "mos: sg13_lv_nmos=", st[N_NMOS]);
    put_kv(st, out, " sg13_lv_pmos=", st[N_PMOS]);
    put_kv(st, out, " total=", st[SRC + K_MOS]);
    put_kv(st, out, "\nmim: cap_cmim=", st[N_MIM]);
    put(st, out, B_NL);
    put_recorded(w, st, out);
    puts(st, out, "recorded, not evaluated: ");
    put_kv(st, out, "lib=", st[N_LIB]);
    put_kv(st, out, " include=", st[N_INC]);
    put_kv(st, out, " parameters=", st[N_PARAM]);
    put_kv(st, out, " options=", st[N_OPT]);
    put_kv(st, out, " ic=", st[N_IC]);
    put_kv(st, out, " nodeset=", st[N_NODESET]);
    put_kv(st, out, " save=", st[N_SAVE]);
    put_kv(st, out, " global=", st[N_GLOBAL]);
    put_kv(st, out, " control-commands=", st[N_CTLCMD]);
    puts(st, out, "\nflattened: ");
    put_kv(st, out, "instances=", st[FLAT + K_R] + st[FLAT + K_C] + st[FLAT + K_L] + st[FLAT + K_V] + st[FLAT + K_I] + st[FLAT + K_E] + st[FLAT + K_MOS] + st[FLAT + K_MIM]);
    put_kv(st, out, " r=", st[FLAT + K_R]);
    put_kv(st, out, " c=", st[FLAT + K_C]);
    put_kv(st, out, " l=", st[FLAT + K_L]);
    put_kv(st, out, " v=", st[FLAT + K_V]);
    put_kv(st, out, " i=", st[FLAT + K_I]);
    put_kv(st, out, " e=", st[FLAT + K_E]);
    put_kv(st, out, " mos=", st[FLAT + K_MOS]);
    put_kv(st, out, " mim=", st[FLAT + K_MIM]);
    put_kv(st, out, " levels=", st[FLAT + K_X]);
    put_kv(st, out, " depth=", st[DEPTH_SEEN]);
    puts(st, out, "\nflattened, weighted by m: ");
    put_kv(st, out, "mos=", st[FLAT_MOS_W]);
    put_kv(st, out, " mim=", st[FLAT_MIM_W]);
    puts(st, out, "\ninstances:\n");
    st[EMIT] = 1;
    flatten(w, st, out, NONE, 0, st[SCAN_HI], 0, 0, 1);
}

/// Read a deck and write its inventory, or the refusal. `w` is the work buffer (see the header), `st` the
/// state vector, zeroed by the caller. The result is the size of the output.
pub fn inventory(src: []const u8, w: []u8, out: []u8, st: []usize) -> usize {
    st[END_LAST] = NONE;
    st[CUR] = NONE;
    st[CTL_CARD] = NONE;
    st[TEMP_CARD] = NONE;
    st[DEF_HIT] = NONE;
    prepare(src, w, st);
    mark_end(w, st);
    scan(w, st);
    resolve(w, st);
    st[EMIT] = 0;
    flatten(w, st, out, NONE, 0, st[SCAN_HI], 0, 0, 1);
    if (st[ERR_LINE] != 0) {
        put_reject(w, st, out);
    } else {
        put_inventory(src, w, st, out);
    }
    return st[W];
}

/// Does what was written, out[0 .. w], hold the text `needle`? (The tests of the larger decks look for a
/// line of the inventory, not for all of it.)
pub fn has_text(w: usize, out: []const u8, needle: []const u8) -> bool {
    var i : usize = 0;
    while (i + needle.len <= w) {
        var k : usize = 0;
        while (k < needle.len and out[i + k] == needle[k]) { k = k + 1; }
        if (k == needle.len) { return true; }
        i = i + 1;
    }
    return false;
}

// ---------------------------------------------------------------- the cell (M2b, #10766)

/// The f64 nearest to the decimal parse_num found: the mantissa times ten to (exponent - EXP_BIAS). It is one
/// multiplication or one division of two exact operands (dec_ok keeps both exact), so it is the very f64 that the
/// literal 1.0e-9 is, and a value read from a deck is the value linear.t27 writes as a literal.
pub fn dec_f64(m: usize, e: usize) -> f64 {
    var p : f64 = 1.0;
    var x : usize = 0;
    if (e >= EXP_BIAS) { x = e - EXP_BIAS; } else { x = EXP_BIAS - e; }
    while (x > 0) {
        p = p * 10.0;
        x = x - 1;
    }
    if (e < EXP_BIAS) { return (m as f64) / p; }
    return (m as f64) * p;
}

/// Can dec_f64 take this number exactly? A mantissa of at most 2^53 and a power of ten of at most 22.
pub fn dec_ok(m: usize, e: usize) -> bool {
    if (m == 0 or m > 9007199254740992) { return false; }
    if (e >= EXP_BIAS) { return e - EXP_BIAS <= 22; }
    return EXP_BIAS - e <= 22;
}

/// Read the value (the third word after the name) of the R, C or L card k into st[VM], st[VE] and st[VS] (all zero
/// when the card has none).
pub fn read_val(w: []const u8, st: []usize, k: usize) -> void {
    const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
    const t1 : usize = tk_end(w, tk(w, st[CARD0 + k * CARD_SLOTS + C_A], e), e);
    const v : usize = word_at(w, t1, e, 2);
    if (v == NONE or !parse_num(w, v, tk_end(w, v, e), st)) {
        st[VM] = 0;
        st[VE] = EXP_BIAS;
        st[VS] = 0;
    }
}

/// The value of the R, C or L card k as an f64.
pub fn card_val(w: []const u8, st: []usize, k: usize) -> f64 {
    read_val(w, st, k);
    return dec_f64(st[VM], st[VE]);
}

/// The id the cell gives the node w[a..b]: 0 for ground (the node called 0), NODE_IN for the input node, 1 + its place
/// among the numbered free nodes otherwise, NONE when it is not numbered (yet). The answer is left in st[CELL + CL_HIT]
/// too: a write keeps the state vector a `&mut` in the generated Rust.
pub fn node_of(w: []const u8, st: []usize, a: usize, b: usize) -> usize {
    var id : usize = NONE;
    if (b - a == 1 and w[a] == B_ZERO) {
        id = (NODE_GND as usize);
    } else if (st[CELL + CL_SRC] != NONE and same_ci(w, a, b, st[CELL + CL_IN_A], st[CELL + CL_IN_B])) {
        id = (NODE_IN as usize);
    } else {
        var i : usize = 0;
        while (i < st[CELL + CL_NODES]) {
            if (same_ci(w, a, b, st[CELL + CL_NAME + 2 * i], st[CELL + CL_NAME + 2 * i + 1])) { id = i + 1; }
            i = i + 1;
        }
    }
    st[CELL + CL_HIT] = id;
    return id;
}

/// The id of the node w[a..b], numbering it when it is new: the free nodes are numbered 1, 2, ... in the order
/// their names first appear in the R, C and L cards (the first card's first node is 1). NONE, and a refusal of card k,
/// when the table of names is full.
pub fn node_add(w: []const u8, st: []usize, k: usize, a: usize, b: usize) -> usize {
    var id : usize = node_of(w, st, a, b);
    if (id == NONE) {
        const n : usize = st[CELL + CL_NODES];
        if (n >= CL_NMAX) {
            reject(st, Y_CELL_SIZE, k, a);
        } else {
            st[CELL + CL_NAME + 2 * n] = a;
            st[CELL + CL_NAME + 2 * n + 1] = b;
            st[CELL + CL_NODES] = n + 1;
            id = n + 1;
        }
    }
    return id;
}

/// .ic v(node)=value: a value other than 0 is an initial state the cell does not have (it starts at rest).
pub fn cell_ic(w: []const u8, st: []usize, k: usize, t1: usize, e: usize) -> void {
    var q : usize = t1;
    while (q < e) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            q = e;
        } else {
            const te : usize = tk_end(w, t, e);
            if (w[t] == B_EQ) {
                const v : usize = tk(w, te, e);
                if (v < e and parse_num(w, v, tk_end(w, v, e), st) and st[VM] != 0) { reject(st, Y_CELL_IC, k, v); }
            }
            q = te;
        }
    }
}

/// The key=value pairs after the value of an R, C or L card: m= is not applied by the cell, ic= must be 0.
pub fn cell_keys(w: []const u8, st: []usize, k: usize, p: usize, e: usize) -> void {
    var q : usize = p;
    while (q < e) {
        const t : usize = tk(w, q, e);
        if (t >= e) {
            q = e;
        } else {
            const te : usize = tk_end(w, t, e);
            const v : usize = tk(w, tk(w, te, e) + 1, e);
            q = tk_end(w, v, e);
            if (ci_is(w, t, te, "m")) {
                reject(st, Y_CELL_VALUE, k, t);
            } else if (ci_is(w, t, te, "ic") and v < e and parse_num(w, v, q, st) and st[VM] != 0) {
                reject(st, Y_CELL_IC, k, v);
            }
        }
    }
}

/// A V or B source: the cell's one input. Its minus terminal is ground (0) and its plus terminal is not; the plus
/// node becomes the input node (NODE_IN). A second source, or any other shape, is refused.
pub fn cell_source(w: []const u8, st: []usize, k: usize, t1: usize, e: usize) -> void {
    const na : usize = word_at(w, t1, e, 0);
    const nb : usize = word_at(w, t1, e, 1);
    if (na == NONE or nb == NONE) {
        reject(st, Y_CELL_IN, k, NONE);
        return;
    }
    const ea : usize = tk_end(w, na, e);
    const eb : usize = tk_end(w, nb, e);
    if (eb - nb != 1 or w[nb] != B_ZERO or (ea - na == 1 and w[na] == B_ZERO)) {
        reject(st, Y_CELL_IN, k, NONE);
    } else if (ci_is(w, na, ea, "gnd")) {
        reject(st, Y_CELL_GND, k, na);
    } else if (st[CELL + CL_SRC] != NONE) {
        reject(st, Y_CELL_IN, k, NONE);
    } else {
        st[CELL + CL_SRC] = k;
        st[CELL + CL_IN_A] = na;
        st[CELL + CL_IN_B] = ea;
    }
}

/// Pass 1: every top-level card is R, C, L or the one input source (a V or a time-only B); a .ic must be zero.
/// Anything else the reader accepted (an I source, an E source, an X card) is outside the cell.
pub fn cell_inputs(w: []const u8, st: []usize) -> void {
    st[CELL + CL_SRC] = NONE;
    st[CELL + CL_L1] = NONE;
    st[CELL + CL_C1] = NONE;
    st[CELL + CL_DT_C] = NONE;
    var k : usize = 0;
    while (k < st[SCAN_HI]) {
        const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
        const t0 : usize = tk(w, st[CARD0 + k * CARD_SLOTS + C_A], e);
        const t1 : usize = tk_end(w, t0, e);
        if (st[CARD0 + k * CARD_SLOTS + C_SCOPE] == NONE) {
            if (w[t0] == B_DOT) {
                if (ci_is(w, t0, t1, ".ic")) { cell_ic(w, st, k, t1, e); }
            } else {
                const c : u8 = lower(w[t0]);
                if (c == 118 or c == 98) {
                    cell_source(w, st, k, t1, e);
                } else if (c != 114 and c != 99 and c != 108) {
                    reject(st, Y_CELL_EL, k, NONE);
                }
            }
        }
        k = k + 1;
    }
    if (st[CELL + CL_SRC] == NONE and st[ERR_LINE] == 0) {
        var line : usize = 1;
        if (st[SCAN_HI] > 0) { line = st[CARD0 + (st[SCAN_HI] - 1) * CARD_SLOTS + C_LINE]; }
        reject_at(st, Y_CELL_IN, line, NONE, NONE);
    }
}

/// Pass 2: number the free nodes in the order of first appearance and check each R, C and L card: a positive
/// value the cell can take exactly, two different nodes, neither named gnd, no m=, ic= zero, and no C or L on the
/// input node. Counts the inductors and refuses a sixth unknown (free nodes plus inductors; NMAX are the cell's).
pub fn cell_nodes(w: []const u8, st: []usize) -> void {
    var k : usize = 0;
    while (k < st[SCAN_HI] and st[ERR_LINE] == 0) {
        const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
        const t0 : usize = tk(w, st[CARD0 + k * CARD_SLOTS + C_A], e);
        const t1 : usize = tk_end(w, t0, e);
        const c : u8 = lower(w[t0]);
        if (st[CARD0 + k * CARD_SLOTS + C_SCOPE] == NONE and w[t0] != B_DOT and (c == 114 or c == 99 or c == 108)) {
            const na : usize = word_at(w, t1, e, 0);
            const nb : usize = word_at(w, t1, e, 1);
            const v : usize = word_at(w, t1, e, 2);
            const ea : usize = tk_end(w, na, e);
            const eb : usize = tk_end(w, nb, e);
            if (!parse_num(w, v, tk_end(w, v, e), st) or st[VS] != 0 or !dec_ok(st[VM], st[VE])) {
                reject(st, Y_CELL_VALUE, k, v);
            } else if (ci_is(w, na, ea, "gnd")) {
                reject(st, Y_CELL_GND, k, na);
            } else if (ci_is(w, nb, eb, "gnd")) {
                reject(st, Y_CELL_GND, k, nb);
            } else {
                const ia : usize = node_add(w, st, k, na, ea);
                const ib : usize = node_add(w, st, k, nb, eb);
                if (ia != NONE and ib != NONE) {
                    if (ia == ib) {
                        reject(st, Y_CELL_VALUE, k, na);
                    } else if (c != 114 and (ia == (NODE_IN as usize) or ib == (NODE_IN as usize))) {
                        reject(st, Y_CELL_VALUE, k, na);
                    }
                }
                cell_keys(w, st, k, tk_end(w, v, e), e);
                if (c == 108) {
                    st[CELL + CL_IND] = st[CELL + CL_IND] + 1;
                    if (st[CELL + CL_L1] == NONE) { st[CELL + CL_L1] = k; }
                }
                if (c == 99 and st[CELL + CL_C1] == NONE) { st[CELL + CL_C1] = k; }
                if (st[CELL + CL_NODES] + st[CELL + CL_IND] > (NMAX as usize)) { reject(st, Y_CELL_SIZE, k, NONE); }
            }
        }
        k = k + 1;
    }
    st[CELL + CL_UNK] = st[CELL + CL_NODES] + st[CELL + CL_IND];
    if (st[ERR_LINE] == 0 and st[CELL + CL_UNK] == 0) {
        var line : usize = 1;
        if (st[SCAN_HI] > 0) { line = st[CARD0 + (st[SCAN_HI] - 1) * CARD_SLOTS + C_LINE]; }
        reject_at(st, Y_CELL_SIZE, line, NONE, NONE);
    }
}

/// Pass 3: dt and the integration. The cell needs exactly one analysis, a .tran card (or the control `tran`) with
/// all four numbers: dt is the fourth, tmax, the largest internal step. The deck must also say method=gear
/// maxord=1, which ngspice runs as backward Euler: that is the method the cell folds.
pub fn cell_tran(w: []const u8, st: []usize) -> void {
    var n : usize = 0;
    var card : usize = NONE;
    var k : usize = 0;
    while (k < st[SCAN_HI]) {
        const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
        const t0 : usize = tk(w, st[CARD0 + k * CARD_SLOTS + C_A], e);
        const t1 : usize = tk_end(w, t0, e);
        const scope : usize = st[CARD0 + k * CARD_SLOTS + C_SCOPE];
        if ((scope == NONE and ci_is(w, t0, t1, ".tran")) or (scope == SCOPE_CTL and ci_is(w, t0, t1, "tran"))) {
            n = n + 1;
            card = k;
        }
        k = k + 1;
    }
    if (n == 0) {
        var line : usize = 1;
        if (st[SCAN_HI] > 0) { line = st[CARD0 + (st[SCAN_HI] - 1) * CARD_SLOTS + C_LINE]; }
        reject_at(st, Y_CELL_DT, line, NONE, NONE);
        return;
    }
    if (n > 1) {
        reject(st, Y_CELL_DT, card, NONE);
        return;
    }
    const ce : usize = st[CARD0 + card * CARD_SLOTS + C_B];
    var q : usize = tk_end(w, tk(w, st[CARD0 + card * CARD_SLOTS + C_A], ce), ce);
    var seen : usize = 0;
    while (q < ce) {
        const t : usize = tk(w, q, ce);
        if (t >= ce) {
            q = ce;
        } else {
            const te : usize = tk_end(w, t, ce);
            if (!ci_is(w, t, te, "uic") and parse_num(w, t, te, st)) {
                seen = seen + 1;
                if (seen == 4) {
                    if (st[VS] == 0 and dec_ok(st[VM], st[VE])) {
                        st[CELL + CL_DT_M] = st[VM];
                        st[CELL + CL_DT_E] = st[VE];
                    } else {
                        seen = 0;
                    }
                }
            }
            q = te;
        }
    }
    st[CELL + CL_DT_C] = card;
    if (seen < 4) {
        reject(st, Y_CELL_DT, card, NONE);
    } else if (st[OPT_METHOD] != 1 or st[OPT_MAXORD] != 1) {
        reject(st, Y_CELL_METHOD, card, NONE);
    }
}

/// The admittance y between nodes a and b into the columns of the work matrix that start at off: linear.t27's
/// stamp_pair, on node ids, taking and returning the matrix (the generated Rust cannot lend a local array to a function that
/// writes it, and linear.t27's own stamp does exactly that).
pub fn pair_add(w0: [55]f64, off: usize, a: usize, b: usize, y: f64) -> [55]f64 {
    var w : [55]f64 = w0;
    const fa : bool = is_free(a as u8);
    const fb : bool = is_free(b as u8);
    if (fa) {
        const i : usize = ix(a as u8) * WIDE + off + ix(a as u8);
        w[i] = w[i] + y;
    }
    if (fb) {
        const i : usize = ix(b as u8) * WIDE + off + ix(b as u8);
        w[i] = w[i] + y;
    }
    if (fa and fb) {
        const i : usize = ix(a as u8) * WIDE + off + ix(b as u8);
        const j : usize = ix(b as u8) * WIDE + off + ix(a as u8);
        w[i] = w[i] + (0.0 - y);
        w[j] = w[j] + (0.0 - y);
    }
    return w;
}

/// The driven node's side of an admittance y: its column moves to the right-hand side (column col) as y * u.
pub fn src_add(w0: [55]f64, col: usize, a: usize, b: usize, y: f64) -> [55]f64 {
    var w : [55]f64 = w0;
    if (is_free(a as u8) and b == (NODE_IN as usize)) {
        const i : usize = ix(a as u8) * WIDE + col;
        w[i] = w[i] + y;
    }
    if (is_free(b as u8) and a == (NODE_IN as usize)) {
        const i : usize = ix(b as u8) * WIDE + col;
        w[i] = w[i] + y;
    }
    return w;
}

/// Pass 4: the MNA stamps of the R, C and L cards into [A | C/dt | B], the Gauss-Jordan solve of linear.t27
/// (eliminate, mn_of), and the words: D = M - I and N rounded by linear.t27's q_sm, into st[CELL + CL_D ...] and
/// st[CELL + CL_NV ...]. The stamps are linear.t27's stamp, rule for rule (R: G, and y u to the right-hand side when
/// one end is the input; C: C/dt in A and in the middle block; L: a branch current stored times zs, KCL +-i/zs at its
/// nodes and the row L/(dt zs) x' - v_a' + v_b' = L/(dt zs) x). zs is sqrt(L1 / C1), L1 the first inductor and C1 the
/// first capacitor of the deck, and 1 when the deck lacks either.
pub fn cell_solve(w: []const u8, st: []usize) -> void {
    const nn : usize = st[CELL + CL_NODES];
    const n : usize = st[CELL + CL_UNK];
    const dt : f64 = dec_f64(st[CELL + CL_DT_M], st[CELL + CL_DT_E]);
    var zs : f64 = 1.0;
    if (st[CELL + CL_L1] != NONE and st[CELL + CL_C1] != NONE) {
        const lv : f64 = card_val(w, st, st[CELL + CL_L1]);
        const cv : f64 = card_val(w, st, st[CELL + CL_C1]);
        zs = @sqrt(lv / cv);
    }
    var aug : [55]f64 = [0.0] ** 55;
    st[CELL + CL_LSEEN] = 0;
    var k : usize = 0;
    while (k < st[SCAN_HI]) {
        const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
        const t0 : usize = tk(w, st[CARD0 + k * CARD_SLOTS + C_A], e);
        const t1 : usize = tk_end(w, t0, e);
        const c : u8 = lower(w[t0]);
        if (st[CARD0 + k * CARD_SLOTS + C_SCOPE] == NONE and w[t0] != B_DOT and (c == 114 or c == 99 or c == 108)) {
            const na : usize = word_at(w, t1, e, 0);
            const nb : usize = word_at(w, t1, e, 1);
            const ia : usize = node_of(w, st, na, tk_end(w, na, e));
            const ib : usize = node_of(w, st, nb, tk_end(w, nb, e));
            const val : f64 = card_val(w, st, k);
            if (c == 114) {
                aug = pair_add(aug, 0, ia, ib, 1.0 / val);
                aug = src_add(aug, 2 * n, ia, ib, 1.0 / val);
            } else if (c == 99) {
                aug = pair_add(aug, 0, ia, ib, val / dt);
                aug = pair_add(aug, n, ia, ib, val / dt);
            } else {
                const ki : usize = nn + st[CELL + CL_LSEEN];
                const yl : f64 = val / (dt * zs);
                if (is_free(ia as u8)) {
                    aug[ix(ia as u8) * WIDE + ki] = aug[ix(ia as u8) * WIDE + ki] + 1.0 / zs;
                    aug[ki * WIDE + ix(ia as u8)] = aug[ki * WIDE + ix(ia as u8)] + (0.0 - 1.0);
                }
                if (is_free(ib as u8)) {
                    aug[ix(ib as u8) * WIDE + ki] = aug[ix(ib as u8) * WIDE + ki] + (0.0 - 1.0 / zs);
                    aug[ki * WIDE + ix(ib as u8)] = aug[ki * WIDE + ix(ib as u8)] + 1.0;
                }
                aug[ki * WIDE + ki] = aug[ki * WIDE + ki] + yl;
                aug[ki * WIDE + n + ki] = aug[ki * WIDE + n + ki] + yl;
                if (ia == (NODE_IN as usize)) { aug[ki * WIDE + 2 * n] = aug[ki * WIDE + 2 * n] + 1.0; }
                if (ib == (NODE_IN as usize)) { aug[ki * WIDE + 2 * n] = aug[ki * WIDE + 2 * n] + (0.0 - 1.0); }
                st[CELL + CL_LSEEN] = st[CELL + CL_LSEEN] + 1;
            }
        }
        k = k + 1;
    }
    const sol : [55]f64 = eliminate(aug, n);
    const mn : [30]f64 = mn_of(sol, n);
    var ok : bool = true;
    var i : usize = 0;
    while (i < n) {
        var j : usize = 0;
        while (j < n) {
            var m : f64 = mn[i * n + j];
            if (i == j) { m = m - 1.0; }
            if (fabs64(m) < 127.0) { st[CELL + CL_D + i * n + j] = q_sm(m) as usize; } else { ok = false; }
            j = j + 1;
        }
        if (fabs64(mn[n * n + i]) < 127.0) { st[CELL + CL_NV + i] = q_sm(mn[n * n + i]) as usize; } else { ok = false; }
        i = i + 1;
    }
    if (!ok) { reject(st, Y_CELL_SOLVE, st[CELL + CL_SRC], NONE); }
}

/// Read a deck as a cell: the reader of the inventory (prepare, mark_end, scan), then the five passes above, each
/// only while no card has been refused. A refusal is the usual st[ERR_LINE] / st[ERR_WHY] / st[ERR_CARD]; an
/// accepted deck leaves the unknowns in st[CELL + CL_UNK], D in st[CELL + CL_D ...] (row-major) and N in
/// st[CELL + CL_NV ...], as sign-magnitude words (bit 31 is the sign).
pub fn cell_build(src: []const u8, w: []u8, st: []usize) -> void {
    st[END_LAST] = NONE;
    st[CUR] = NONE;
    st[CTL_CARD] = NONE;
    st[TEMP_CARD] = NONE;
    st[DEF_HIT] = NONE;
    prepare(src, w, st);
    mark_end(w, st);
    scan(w, st);
    if (st[ERR_LINE] == 0) { cell_inputs(w, st); }
    if (st[ERR_LINE] == 0) { cell_nodes(w, st); }
    if (st[ERR_LINE] == 0) { cell_tran(w, st); }
    if (st[ERR_LINE] == 0) { cell_solve(w, st); }
}

/// One word of the cell: `NEG | magnitude` for a negative one, the magnitude otherwise.
pub fn put_word(st: []usize, out: []u8, wd: usize) -> void {
    if (wd >= 2147483648) {
        puts(st, out, "NEG | ");
        put_num(st, out, wd - 2147483648);
    } else {
        put_num(st, out, wd);
    }
}

/// The state list of the emitted block: one line a state, in the order of the words.
pub fn put_states(w: []const u8, st: []usize, out: []u8) -> void {
    var i : usize = 0;
    while (i < st[CELL + CL_NODES]) {
        puts(st, out, "//   x");
        put_num(st, out, i);
        puts(st, out, " = v(");
        put_text(w, st, out, st[CELL + CL_NAME + 2 * i], st[CELL + CL_NAME + 2 * i + 1], SHOW);
        puts(st, out, ")\n");
        i = i + 1;
    }
    var k : usize = 0;
    var l : usize = 0;
    while (k < st[SCAN_HI]) {
        const e : usize = st[CARD0 + k * CARD_SLOTS + C_B];
        const t0 : usize = tk(w, st[CARD0 + k * CARD_SLOTS + C_A], e);
        if (st[CARD0 + k * CARD_SLOTS + C_SCOPE] == NONE and w[t0] != B_DOT and lower(w[t0]) == 108) {
            puts(st, out, "//   x");
            put_num(st, out, st[CELL + CL_NODES] + l);
            puts(st, out, " = i(");
            put_text(w, st, out, t0, tk_end(w, t0, e), SHOW);
            puts(st, out, ") * zs\n");
            l = l + 1;
        }
        k = k + 1;
    }
}

/// One array of words: `pub const CELL_<name> : [len]u32 = [ ... ];`, `per` words to a line when there are rows.
pub fn put_words(st: []usize, out: []u8, name: []const u8, base: usize, len: usize, per: usize) -> void {
    puts(st, out, "pub const CELL_");
    puts(st, out, name);
    puts(st, out, " : [");
    put_num(st, out, len);
    puts(st, out, "]u32 = [");
    var i : usize = 0;
    while (i < len) {
        if (per < len and i % per == 0) {
            if (i > 0) { puts(st, out, ","); }
            puts(st, out, "\n    ");
        } else if (i > 0) {
            puts(st, out, ", ");
        }
        put_word(st, out, st[CELL + base + i]);
        i = i + 1;
    }
    if (per < len) { puts(st, out, "\n"); }
    puts(st, out, "]");
    if (len == 1 and st[CELL + base] < 2147483648) { puts(st, out, " ** 1"); }
    puts(st, out, ";\n");
}

/// The t27 block of an accepted cell: a comment saying where the words come from and what each state is, then
/// CELL_N, CELL_D and CELL_NV. The words are the form linear.t27 pins (`NEG | magnitude`, Q.24 sign-magnitude), so
/// the block can sit beside RC_D / RC_NV with `use analog::linear::{NEG};`.
pub fn put_cell(src: []const u8, w: []const u8, st: []usize, out: []u8) -> void {
    const n : usize = st[CELL + CL_UNK];
    puts(st, out, "// t27o --emit-cell: ");
    put_text(src, st, out, st[TITLE_A], st[TITLE_B], SHOW);
    puts(st, out, "\n// the input u is the source on node ");
    put_text(w, st, out, st[CELL + CL_IN_A], st[CELL + CL_IN_B], SHOW);
    puts(st, out, " (line ");
    put_num(st, out, st[CARD0 + st[CELL + CL_SRC] * CARD_SLOTS + C_LINE]);
    puts(st, out, "); backward Euler, dt = ");
    st[VM] = st[CELL + CL_DT_M];
    st[VE] = st[CELL + CL_DT_E];
    st[VS] = 0;
    put_val(st, out);
    puts(st, out, " s (the tmax of line ");
    put_num(st, out, st[CARD0 + st[CELL + CL_DT_C] * CARD_SLOTS + C_LINE]);
    puts(st, out, "); zs = ");
    if (st[CELL + CL_L1] != NONE and st[CELL + CL_C1] != NONE) {
        puts(st, out, "sqrt(");
        read_val(w, st, st[CELL + CL_L1]);
        put_val(st, out);
        puts(st, out, " / ");
        read_val(w, st, st[CELL + CL_C1]);
        put_val(st, out);
        puts(st, out, ")\n");
    } else {
        puts(st, out, "1\n");
    }
    puts(st, out, "// the states, in the order of the words:\n");
    put_states(w, st, out);
    puts(st, out, "pub const CELL_N : usize = ");
    put_num(st, out, n);
    puts(st, out, ";\n");
    put_words(st, out, "D", CL_D, n * n, n);
    put_words(st, out, "NV", CL_NV, n, n);
}

/// `tri t27o deck.cir --emit-cell`: read a deck as a cell and write its block, or the refusal (`line N: reason`, the
/// card). `w` and `st` are the caller's, as for inventory. The result is the number of bytes the output needs.
pub fn emit_cell(src: []const u8, w: []u8, out: []u8, st: []usize) -> usize {
    cell_build(src, w, st);
    if (st[ERR_LINE] != 0) {
        put_reject(w, st, out);
    } else {
        put_cell(src, w, st, out);
    }
    return st[W];
}

// ---------------------------------------------------------------- tests
// Each test reads a small deck. The buffers are the caller's: a work buffer, an output buffer and a
// state vector with room for 300 cards.

test the_m0_rc_deck_is_one_r_one_c_one_pulse_source {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("RC lowpass\nV1 in 0 PULSE(0 1 0 1n 1n 5u 10u)\nR1 in out 1k\nC1 out 0 1n\n.tran 50n 10u\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(exit_code(&st) == 0);
    assert(st[SRC + K_R] == 1);
    assert(st[SRC + K_C] == 1);
    assert(st[SRC + K_V] == 1);
    assert(st[WAVE + WV_PULSE] == 1);
    assert(st[N_TRAN] == 1);
    assert(out_is(n, &out, 0, "deck: RC lowpass\nend: first .end on line 6, the deck ends with the last of 1, cards after it ignored: 0\ncards: r=1 c=1 l=0 v=1 i=0 e=0 x=0 (subcircuit instances 0, mos 0, mim 0)\nsources: dc=0 pulse=1 sin=0 pwl=0\nsubckt definitions: 0\nmos: sg13_lv_nmos=0 sg13_lv_pmos=0 total=0\nmim: cap_cmim=0\ntran (.tran card) 50n 10u: tstep 5e-8 tstop 1e-5 (line 5)\ncorners: none\ntemp: none\nrecorded, not evaluated: lib=0 include=0 parameters=0 options=0 ic=0 nodeset=0 save=0 global=0 control-commands=0\nflattened: instances=3 r=1 c=1 l=0 v=1 i=0 e=0 mos=0 mim=0 levels=0 depth=0\nflattened, weighted by m: mos=0 mim=0\ninstances:\nv1 v\nr1 r\nc1 c\n"));
}

test a_two_level_subcircuit_is_flattened_with_hierarchical_names {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("two level\n.subckt cell a b\nR1 a b 1k\nC1 b 0 1p\n.ends\n.subckt pair p q\nX1 p mid cell\nX2 mid q cell\n.ends\nX3 in out pair\nV1 in 0 1\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(st[NDEF] == 2);
    assert(st[FLAT + K_R] == 2);
    assert(st[FLAT + K_C] == 2);
    assert(st[FLAT + K_V] == 1);
    assert(st[FLAT + K_X] == 3);
    assert(st[DEPTH_SEEN] == 2);
    assert(out_is(n, &out, 0, "deck: two level\nend: first .end on line 12, the deck ends with the last of 1, cards after it ignored: 0\ncards: r=1 c=1 l=0 v=1 i=0 e=0 x=3 (subcircuit instances 3, mos 0, mim 0)\nsources: dc=1 pulse=0 sin=0 pwl=0\nsubckt definitions: 2\n  subckt cell ports=2\n  subckt pair ports=2\nmos: sg13_lv_nmos=0 sg13_lv_pmos=0 total=0\nmim: cap_cmim=0\ncorners: none\ntemp: none\nrecorded, not evaluated: lib=0 include=0 parameters=0 options=0 ic=0 nodeset=0 save=0 global=0 control-commands=0\nflattened: instances=5 r=2 c=2 l=0 v=1 i=0 e=0 mos=0 mim=0 levels=3 depth=2\nflattened, weighted by m: mos=0 mim=0\ninstances:\nx3.x1.r1 r\nx3.x1.c1 c\nx3.x2.r1 r\nx3.x2.c1 c\nv1 v\n"));
}

test continuation_comment_and_blank_lines_join_a_card {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("t\n* a comment\nR1 a b\n+ 2k ; trailing comment\n* a comment between continuation lines\n\n+ m=2\nC1 b 0 $ nothing\n+ 1p\n.end\n", &w, &out, &st);
    assert(n > 0);
    assert(st[ERR_LINE] == 0);
    assert(st[NCARDS] == 3);
    assert(out_is(st[CARD0 + C_B], &w, st[CARD0 + C_A], "R1 a b 2k m=2"));
    assert(st[CARD0 + C_LINE] == 3);
    assert(out_is(st[CARD0 + CARD_SLOTS + C_B], &w, st[CARD0 + CARD_SLOTS + C_A], "C1 b 0 1p"));
    assert(st[CARD0 + CARD_SLOTS + C_LINE] == 8);
    assert(st[SRC + K_R] == 1);
    assert(st[SRC + K_C] == 1);
}

test si_suffixes_milli_is_not_mega {
    var st : [64]usize = [0] ** 64;
    assert(parse_num("1meg", 0, 4, &st));
    assert(st[VM] == 1 and st[VE] == EXP_BIAS + 6 and st[VS] == 0);
    assert(parse_num("1m", 0, 2, &st));
    assert(st[VM] == 1 and st[VE] == EXP_BIAS - 3);
    assert(parse_num("2.5MEG", 0, 6, &st));
    assert(st[VM] == 25 and st[VE] == EXP_BIAS + 5);
    assert(parse_num("4f", 0, 2, &st));
    assert(st[VM] == 4 and st[VE] == EXP_BIAS - 15);
    assert(parse_num("0.13u", 0, 5, &st));
    assert(st[VM] == 13 and st[VE] == EXP_BIAS - 8);
    assert(parse_num("16u", 0, 3, &st));
    assert(st[VM] == 16 and st[VE] == EXP_BIAS - 6);
    assert(parse_num("100", 0, 3, &st));
    assert(st[VM] == 1 and st[VE] == EXP_BIAS + 2);
    assert(parse_num("9.0e-6", 0, 6, &st));
    assert(st[VM] == 9 and st[VE] == EXP_BIAS - 6);
    assert(parse_num("1E-12", 0, 5, &st));
    assert(st[VM] == 1 and st[VE] == EXP_BIAS - 12);
    assert(parse_num("0.00048828125", 0, 13, &st));
    assert(st[VM] == 48828125 and st[VE] == EXP_BIAS - 11);
    assert(parse_num("10pF", 0, 4, &st));
    assert(st[VM] == 1 and st[VE] == EXP_BIAS - 11);
    assert(parse_num("-3k", 0, 3, &st));
    assert(st[VM] == 3 and st[VE] == EXP_BIAS + 3 and st[VS] == 1);
    assert(parse_num("1t", 0, 2, &st) and st[VE] == EXP_BIAS + 12);
    assert(parse_num("1g", 0, 2, &st) and st[VE] == EXP_BIAS + 9);
    assert(parse_num("1n", 0, 2, &st) and st[VE] == EXP_BIAS - 9);
    assert(parse_num("1p", 0, 2, &st) and st[VE] == EXP_BIAS - 12);
    assert(parse_num("5V", 0, 2, &st) and st[VM] == 5 and st[VE] == EXP_BIAS);
    assert(parse_num("0", 0, 1, &st) and st[VM] == 0 and st[VE] == EXP_BIAS);
}

test numbers_that_are_not_literals_are_not_numbers {
    var st : [64]usize = [0] ** 64;
    assert(!parse_num("", 0, 0, &st));
    assert(!parse_num("abc", 0, 3, &st));
    assert(!parse_num("1mil", 0, 4, &st));
    assert(!parse_num("1.2.3", 0, 5, &st));
    assert(!parse_num("1k2", 0, 3, &st));
    assert(!parse_num("1234567890123456789", 0, 19, &st));
    assert(!parse_num("-", 0, 1, &st));
    assert(!parse_num(".", 0, 1, &st));
    assert(parse_num("123456789012345678", 0, 18, &st));
}

test a_control_block_reads_tran_and_ignores_post_processing {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("ctl\nV1 a 0 1\nR1 a 0 1k\n.control\ntran 0.1n 16u\nplot v(a)\nlet x = 1\nset filetype = ascii\n.endc\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(st[N_TRAN_CTL] == 1);
    assert(st[N_TRAN] == 0);
    assert(st[N_CTLCMD] == 3);
    assert(st[SRC + K_L] == 0);
    assert(st[SRC + K_V] == 1);
    assert(st[SRC + K_R] == 1);
    assert(has_text(n, &out, "tran (control) 0.1n 16u: tstep 1e-10 tstop 16e-6 (line 5)\n"));
    assert(has_text(n, &out, "control-commands=3\n"));
}

test the_deck_ends_at_the_last_end_and_definitions_after_the_first_are_read {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("end rule\nX1 a b cell\n.end\n.subckt cell p q\nR1 p q 1\n.ends\n.end\njunk after the last end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(st[END_N] == 2);
    assert(st[END_LINE] == 3);
    assert(st[IGNORED] == 1);
    assert(st[NDEF] == 1);
    assert(st[FLAT + K_R] == 1);
    assert(has_text(n, &out, "x1.r1 r\n"));
    assert(has_text(n, &out, "first .end on line 3, the deck ends with the last of 2, cards after it ignored: 1\n"));
}

test one_end_with_definitions_after_it_leaves_the_instance_undefined {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("single end\nX1 a b cell\n.end\n.subckt cell p q\nR1 p q 1\n.ends\n", &w, &out, &st);
    assert(st[ERR_LINE] == 2);
    assert(st[ERR_WHY] == Y_UNDEF);
    assert(st[IGNORED] == 3);
    assert(exit_code(&st) == 1);
    assert(out_is(n, &out, 0, "line 2: subcircuit or device model not defined: cell\n  card: X1 a b cell\n"));
}

test a_b_source_is_refused_with_its_line {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("bsrc\nR1 a b 1k\nB1 out 0 v=v(a)*2\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 3);
    assert(st[ERR_WHY] == Y_B);
    assert(exit_code(&st) == 1);
    assert(out_is(n, &out, 0, "line 3: B source not supported (only a voltage that is a function of time alone is read)\n  card: B1 out 0 v=v(a)*2\n"));
}

test unsupported_cards_are_refused_and_the_same_deck_without_them_is_accepted {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n1 : usize = inventory("neg\nR1 a b 1k\n.measure tran x max v(a)\n.end\n", &w, &out, &st);
    assert(out_is(n1, &out, 0, "line 3: .measure directive not supported\n  card: .measure tran x max v(a)\n"));
    assert(exit_code(&st) == 1);
    var st2 : [3000]usize = [0] ** 3000;
    const n2 : usize = inventory("neg\nR1 a b {rval}\n.end\n", &w, &out, &st2);
    assert(out_is(n2, &out, 0, "line 2: expression in braces or quotes not supported\n  card: R1 a b {rval}\n"));
    var st3 : [3000]usize = [0] ** 3000;
    const n3 : usize = inventory("neg\nR1 a b abc\n.end\n", &w, &out, &st3);
    assert(out_is(n3, &out, 0, "line 2: not a literal number: abc\n  card: R1 a b abc\n"));
    var st4 : [3000]usize = [0] ** 3000;
    const n4 : usize = inventory("neg\nD1 a b dmod\n.end\n", &w, &out, &st4);
    assert(out_is(n4, &out, 0, "line 2: D element not supported\n  card: D1 a b dmod\n"));
    var st5 : [3000]usize = [0] ** 3000;
    const n5 : usize = inventory("neg\n.model nmos1 nmos\n.end\n", &w, &out, &st5);
    assert(n5 > 0);
    assert(st5[ERR_LINE] == 2);
    assert(st5[ERR_WHY] == Y_DIRECTIVE);
    var st6 : [3000]usize = [0] ** 3000;
    const n6 : usize = inventory("neg\n.func f(x) {x*2}\n.end\n", &w, &out, &st6);
    assert(n6 > 0);
    assert(st6[ERR_LINE] == 2);
    assert(st6[ERR_WHY] == Y_EXPR);
    var ok : [3000]usize = [0] ** 3000;
    const n7 : usize = inventory("neg\nR1 a b 1k\n.end\n", &w, &out, &ok);
    assert(n7 > 0);
    assert(ok[ERR_LINE] == 0);
    assert(exit_code(&ok) == 0);
    assert(ok[SRC + K_R] == 1);
}

test the_earliest_refusal_is_the_one_reported {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("order\nX1 a b nosuch\nR1 a b 1k\nB1 x y v=1\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 2);
    assert(st[ERR_WHY] == Y_UNDEF);
    assert(out_is(n, &out, 0, "line 2: subcircuit or device model not defined: nosuch\n  card: X1 a b nosuch\n"));
}

test nested_definitions_are_scoped_to_the_definition_that_holds_them {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("nested\n.subckt outer a b\n.subckt inner p q\nR1 p q 1k\n.ends inner\nX1 a b inner\nX2 b a inner\n.ends outer\nX1 n1 n2 outer\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(st[NDEF] == 2);
    assert(st[FLAT + K_R] == 2);
    assert(has_text(n, &out, "  subckt inner ports=2 inside outer\n"));
    assert(has_text(n, &out, "x1.x1.r1 r\nx1.x2.r1 r\n"));
    var st2 : [3000]usize = [0] ** 3000;
    const n2 : usize = inventory("scope\n.subckt outer a b\n.subckt inner p q\nR1 p q 1\n.ends\n.ends\nX1 n1 n2 inner\n.end\n", &w, &out, &st2);
    assert(n2 > 0);
    assert(st2[ERR_LINE] == 7);
    assert(st2[ERR_WHY] == Y_UNDEF);
}

test pdk_devices_are_counted_by_model_and_weighted_by_m {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("mos\nXM1 d g s b sg13_lv_nmos w=1.0u l=0.13u ng=1 m=4\nXM2 d g s b sg13_lv_pmos w=3.0u l=0.45u ng=1 m=2\nXC1 a b cap_cmim w=9.0e-6 l=9.0e-6 m=1\n.subckt blk a b c d\nXM1 a b c d sg13_lv_nmos w=1u l=1u m=3\n.ends\nX1 n1 n2 n3 n4 blk m=5\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(st[N_NMOS] == 2);
    assert(st[N_PMOS] == 1);
    assert(st[N_MIM] == 1);
    assert(st[SRC + K_MOS] == 3);
    assert(st[SRC + K_X] == 1);
    assert(st[FLAT + K_MOS] == 3);
    assert(st[FLAT_MOS_W] == 21);
    assert(st[FLAT + K_MIM] == 1);
    assert(st[FLAT_MIM_W] == 1);
    assert(has_text(n, &out, "xm1 mos sg13_lv_nmos m=4\n"));
    assert(has_text(n, &out, "xm2 mos sg13_lv_pmos m=2\n"));
    assert(has_text(n, &out, "xc1 mim cap_cmim m=1\n"));
    assert(has_text(n, &out, "x1.xm1 mos sg13_lv_nmos m=15\n"));
    assert(has_text(n, &out, "mos: sg13_lv_nmos=2 sg13_lv_pmos=1 total=3\n"));
    assert(has_text(n, &out, "flattened, weighted by m: mos=21 mim=1\n"));
}

test instance_shapes_that_do_not_match_their_definition_are_refused {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var a : [3000]usize = [0] ** 3000;
    const na : usize = inventory("ports\n.subckt blk a b\nR1 a b 1\n.ends\nX1 n1 blk\n.end\n", &w, &out, &a);
    assert(na > 0);
    assert(a[ERR_LINE] == 5);
    assert(a[ERR_WHY] == Y_PORTS);
    var b : [3000]usize = [0] ** 3000;
    const nb : usize = inventory("extra\n.subckt blk a b\nR1 a b 1\n.ends\nX1 n1 n2 blk w=1u\n.end\n", &w, &out, &b);
    assert(nb > 0);
    assert(b[ERR_LINE] == 5);
    assert(b[ERR_WHY] == Y_PARAM);
    var c : [3000]usize = [0] ** 3000;
    const nc : usize = inventory("frac\nXM1 d g s b sg13_lv_nmos m=1.5\n.end\n", &w, &out, &c);
    assert(nc > 0);
    assert(c[ERR_LINE] == 2);
    assert(c[ERR_WHY] == Y_MULT);
    var d : [3000]usize = [0] ** 3000;
    const nd : usize = inventory("nodes\nXM1 d g s sg13_lv_nmos\n.end\n", &w, &out, &d);
    assert(nd > 0);
    assert(d[ERR_LINE] == 2);
    assert(d[ERR_WHY] == Y_PORTS);
    var e : [3000]usize = [0] ** 3000;
    const ne : usize = inventory("shadow\n.subckt sg13_lv_nmos d g s b\nR1 d s 1\n.ends\nXM1 a b c d sg13_lv_nmos\n.end\n", &w, &out, &e);
    assert(ne > 0);
    assert(e[ERR_LINE] == 0);
    assert(e[FLAT + K_MOS] == 0);
    assert(e[FLAT + K_R] == 1);
    assert(e[N_NMOS] == 0);
}

test lib_include_options_param_ic_and_global_are_recorded_not_followed {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("corners and options\n.lib /pdk/models.lib mos_tt\n.lib /pdk/cap.lib cap_typ\n.include /tmp/extra.inc\n.options TEMP = 50\n.PARAM vdd=1.5 tp=2n\n.ic v(x1.n1)=0 v(n2)=0.5\n.nodeset v(a)=1\n.global GND\n.save v(a) i(v1)\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(out_is(n, &out, 0, "deck: corners and options\nend: first .end on line 11, the deck ends with the last of 1, cards after it ignored: 0\ncards: r=0 c=0 l=0 v=0 i=0 e=0 x=0 (subcircuit instances 0, mos 0, mim 0)\nsources: dc=0 pulse=0 sin=0 pwl=0\nsubckt definitions: 0\nmos: sg13_lv_nmos=0 sg13_lv_pmos=0 total=0\nmim: cap_cmim=0\ncorner: mos_tt from /pdk/models.lib (not read)\ncorner: cap_typ from /pdk/cap.lib (not read)\ninclude: /tmp/extra.inc (not read)\ntemp: 50\nrecorded, not evaluated: lib=2 include=1 parameters=2 options=1 ic=2 nodeset=1 save=1 global=1 control-commands=0\nflattened: instances=0 r=0 c=0 l=0 v=0 i=0 e=0 mos=0 mim=0 levels=0 depth=0\nflattened, weighted by m: mos=0 mim=0\ninstances:\n"));
    var a : [3000]usize = [0] ** 3000;
    const na : usize = inventory("opt\n.options reltol=1m\n.end\n", &w, &out, &a);
    assert(na > 0);
    assert(a[ERR_LINE] == 2);
    assert(a[ERR_WHY] == Y_OPTION);
    var b : [3000]usize = [0] ** 3000;
    const nb : usize = inventory("par\n.PARAM x={1+2}\n.end\n", &w, &out, &b);
    assert(nb > 0);
    assert(b[ERR_LINE] == 2);
    assert(b[ERR_WHY] == Y_EXPR);
    var c : [3000]usize = [0] ** 3000;
    const nc : usize = inventory("lib\n.lib mos_tt\n.end\n", &w, &out, &c);
    assert(nc > 0);
    assert(c[ERR_LINE] == 2);
    assert(c[ERR_WHY] == Y_FIELDS);
}

test the_first_line_is_the_title_and_never_a_card {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("R1 a b 1k\nR2 a b 2k\n.end\n", &w, &out, &st);
    assert(st[SRC + K_R] == 1);
    assert(out_is(16, &out, 0, "deck: R1 a b 1k\n"));
    assert(n > 16);
}

test sources_take_dc_pulse_sin_and_pwl_and_a_vcvs_takes_a_gain {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("src\nV1 a 0 DC 1.5\nV2 a 0 1.5\nV3 a 0 SIN(0 0.6 62.5k)\nV4 a 0 PWL(0 0 1n 1 2n 0)\nI1 a 0 DC 1m\nV5 a 0 DC 0 PULSE(0 1 1n)\nE1 x y a 0 2\n.end\n", &w, &out, &st);
    assert(n > 0);
    assert(st[ERR_LINE] == 0);
    assert(st[SRC + K_V] == 5);
    assert(st[SRC + K_I] == 1);
    assert(st[SRC + K_E] == 1);
    assert(st[WAVE + WV_DC] == 3);
    assert(st[WAVE + WV_SIN] == 1);
    assert(st[WAVE + WV_PWL] == 1);
    assert(st[WAVE + WV_PULSE] == 1);
    var a : [3000]usize = [0] ** 3000;
    const na : usize = inventory("src\nV1 a 0 AC 1\n.end\n", &w, &out, &a);
    assert(na > 0);
    assert(a[ERR_LINE] == 2 and a[ERR_WHY] == Y_SOURCE);
    var b : [3000]usize = [0] ** 3000;
    const nb : usize = inventory("src\nV1 a 0 PULSE(0)\n.end\n", &w, &out, &b);
    assert(nb > 0);
    assert(b[ERR_LINE] == 2 and b[ERR_WHY] == Y_FIELDS);
    var c : [3000]usize = [0] ** 3000;
    const nc : usize = inventory("src\nV1 a 0 PWL(0 0 1n)\n.end\n", &w, &out, &c);
    assert(nc > 0);
    assert(c[ERR_LINE] == 2 and c[ERR_WHY] == Y_FIELDS);
    var d : [3000]usize = [0] ** 3000;
    const nd : usize = inventory("src\nE1 a b c d\n.end\n", &w, &out, &d);
    assert(nd > 0);
    assert(d[ERR_LINE] == 2 and d[ERR_WHY] == Y_E);
    var e : [3000]usize = [0] ** 3000;
    const ne : usize = inventory("src\nE1 a b POLY(1) c d 0 1\n.end\n", &w, &out, &e);
    assert(ne > 0);
    assert(e[ERR_LINE] == 2 and e[ERR_WHY] == Y_E);
    var f : [3000]usize = [0] ** 3000;
    const nf : usize = inventory("src\nV1 a 0 PULSE(0 1 x)\n.end\n", &w, &out, &f);
    assert(nf > 0);
    assert(f[ERR_LINE] == 2 and f[ERR_WHY] == Y_NUMBER);
}

test broken_structure_is_refused_where_it_starts {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var a : [3000]usize = [0] ** 3000;
    const na : usize = inventory("open\n.subckt a x\nR1 x 0 1\n", &w, &out, &a);
    assert(na > 0);
    assert(a[ERR_LINE] == 2 and a[ERR_WHY] == Y_OPEN);
    var b : [3000]usize = [0] ** 3000;
    const nb : usize = inventory("stray\n.ends\n.end\n", &w, &out, &b);
    assert(nb > 0);
    assert(b[ERR_LINE] == 2 and b[ERR_WHY] == Y_ENDS);
    var c : [3000]usize = [0] ** 3000;
    const nc : usize = inventory("dup\n.subckt a x\nR1 x 0 1\n.ends\n.subckt a y\nR1 y 0 1\n.ends\n.end\n", &w, &out, &c);
    assert(nc > 0);
    assert(c[ERR_LINE] == 5 and c[ERR_WHY] == Y_DUP);
    var d : [3000]usize = [0] ** 3000;
    const nd : usize = inventory("rec\n.subckt r a\nX1 a r\nX2 a r\n.ends\nX1 n r\n.end\n", &w, &out, &d);
    assert(nd > 0);
    assert(d[ERR_LINE] == 3 and d[ERR_WHY] == Y_RECUR);
    var e : [3000]usize = [0] ** 3000;
    const ne : usize = inventory("argument\n.subckt a x w=1u\nR1 x 0 1\n.ends\n.end\n", &w, &out, &e);
    assert(ne > 0);
    assert(e[ERR_LINE] == 2 and e[ERR_WHY] == Y_SUBPARAM);
    var f : [3000]usize = [0] ** 3000;
    const nf : usize = inventory("ctl\n.control\nac dec 10 1 1k\n.endc\n.end\n", &w, &out, &f);
    assert(nf > 0);
    assert(f[ERR_LINE] == 3 and f[ERR_WHY] == Y_CTL);
    var g : [3000]usize = [0] ** 3000;
    const ng : usize = inventory("ctl\n.control\ntran 1n 1u\n.end\n", &w, &out, &g);
    assert(ng > 0);
    assert(g[ERR_LINE] == 2 and g[ERR_WHY] == Y_CTLOPEN);
    var h : [3000]usize = [0] ** 3000;
    const nh : usize = inventory("cont\n+ foo\n.end\n", &w, &out, &h);
    assert(nh > 0);
    assert(h[ERR_LINE] == 2 and h[ERR_WHY] == Y_CONT);
}

test netlist_file_names_are_told_by_extension {
    assert(is_spice_name("top.spice"));
    assert(is_spice_name("rc.cir"));
    assert(is_spice_name("amp.sp"));
    assert(is_spice_name("RC.CIR"));
    assert(is_spice_name("dir/Deck.SP"));
    assert(!is_spice_name("lib.rs"));
    assert(!is_spice_name("top.spice.bak"));
    assert(!is_spice_name("spice"));
    assert(!is_spice_name(""));
}

test crlf_tabs_a_missing_final_newline_and_an_empty_deck_are_read {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    // a t27 string literal has no \r escape: ~ stands for the carriage return in the literal
    var src : [64]u8 = undefined;
    const lit : []const u8 = "crlf~\n\tR1\ta\tb\t1k~\nC1 b 0 1p~\n.end";
    var i : usize = 0;
    while (i < lit.len) {
        if (lit[i] == 126) { src[i] = 13; } else { src[i] = lit[i]; }
        i = i + 1;
    }
    const n : usize = inventory(src[0 .. lit.len], &w, &out, &st);
    assert(n > 0);
    assert(st[ERR_LINE] == 0);
    assert(st[SRC + K_R] == 1);
    assert(st[SRC + K_C] == 1);
    assert(st[END_N] == 1);
    assert(out_is(st[CARD0 + C_B], &w, st[CARD0 + C_A], "R1\ta\tb\t1k"));
    var st2 : [3000]usize = [0] ** 3000;
    const n2 : usize = inventory("", &w, &out, &st2);
    assert(st2[ERR_LINE] == 0);
    assert(st2[NCARDS] == 0);
    assert(has_text(n2, &out, "end: no .end card\n"));
}

test a_deck_larger_than_the_tables_is_refused_not_cut {
    var w : [1024]u8 = undefined;
    var out : [1024]u8 = undefined;
    var small : [1700]usize = [0] ** 1700;
    const n : usize = inventory("big\nR1 a b 1\nR2 a b 1\nR3 a b 1\nR4 a b 1\nR5 a b 1\nR6 a b 1\nR7 a b 1\nR8 a b 1\nR9 a b 1\nR10 a b 1\nR11 a b 1\nR12 a b 1\nR13 a b 1\nR14 a b 1\nR15 a b 1\n.end\n", &w, &out, &small);
    assert(n > 0);
    assert(small[ERR_WHY] == Y_SIZE);
    assert(exit_code(&small) == 1);
    var tiny : [16]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n2 : usize = inventory("big\nR1 a b 1k\nR2 a b 1k\n.end\n", &tiny, &out, &st);
    assert(n2 > 0);
    assert(st[ERR_WHY] == Y_SIZE);
    assert(st[ERR_LINE] == 3);
}

test the_sar_adc_dac_capacitors_bracketed_names_m_up_to_36_and_both_corners {
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const n : usize = inventory("sar\n.lib cornerMOSlv.lib mos_tt\n.lib cornerCAP.lib cap_typ\n.subckt dacarr vout b1 b2\nXC2[3] net1 b1 cap_cmim w=9.0e-6 l=9.0e-6 m=1\nXC2[4] net1 b2 cap_cmim w=9.0e-6 l=9.0e-6 m=1\nXM1 vout b1 net1 net1 sg13_lv_nmos w=1.0u l=0.45u ng=1 m=36\n.ends\nX17 vdn n1 n2 dacarr\nX18 vdp n1 n2 dacarr\n.end\n", &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(st[N_MIM] == 2);
    assert(st[SRC + K_MIM] == 2);
    assert(st[FLAT + K_MIM] == 4);
    assert(st[FLAT_MIM_W] == 4);
    assert(st[FLAT + K_MOS] == 2);
    assert(st[FLAT_MOS_W] == 72);
    assert(has_text(n, &out, "mim: cap_cmim=2\n"));
    assert(has_text(n, &out, "corner: mos_tt from cornerMOSlv.lib (not read)\ncorner: cap_typ from cornerCAP.lib (not read)\n"));
    assert(has_text(n, &out, "x17.xc2[3] mim cap_cmim m=1\n"));
    assert(has_text(n, &out, "x18.xc2[4] mim cap_cmim m=1\n"));
    assert(has_text(n, &out, "x18.xm1 mos sg13_lv_nmos m=36\n"));
    assert(has_text(n, &out, "flattened, weighted by m: mos=72 mim=4\n"));
}

// ---------------------------------------------------------------- the cell: tests (M2b)
// The four decks below are the text of specs/analog/decks/{rc,rlc,lad3,lad5}_fixed.cir without their `*` comment lines
// (the reader drops those); `~` stands for the letter o in the option word: a t27 string literal holding that word would
// splice rust_convert.t27 into this spec (see the header), and deck_text writes the o back.

pub const DECK_RC : str = "M0 RC low-pass, backward Euler on a fixed 50 ns grid\nB1 in 0 V = u(time-425n) - u(time-5425n)\nR1 in 1 1k\nC1 1 0 1n IC=0\n.options meth~d=gear maxord=1 trtol=1e7\n.tran 50n 10475n 0 50n uic\n.end\n";
pub const DECK_RLC : str = "M1 series RLC, backward Euler on a fixed 5 ns grid\nB1 in 0 V = u(time-42.5n) - u(time-542.5n)\nR1 in 1 100\nL1 1 2 10u IC=0\nC1 2 0 1n IC=0\n.options meth~d=gear maxord=1 trtol=1e7\n.tran 5n 1047.5n 0 5n uic\n.end\n";
pub const DECK_LAD3 : str = "M1 3-node RC ladder, backward Euler on a fixed 50 ns grid\nB1 in 0 V = u(time-425n) - u(time-5425n)\nR1 in 1 1k\nR2 1 2 1k\nR3 2 3 1k\nC1 1 0 1n IC=0\nC2 2 0 1n IC=0\nC3 3 0 1n IC=0\n.options meth~d=gear maxord=1 trtol=1e7\n.tran 50n 10475n 0 50n uic\n.end\n";
pub const DECK_LAD5 : str = "M1 5-node RC ladder, backward Euler on a fixed 50 ns grid\nB1 in 0 V = u(time-425n) - u(time-5425n)\nR1 in 1 1k\nR2 1 2 1k\nR3 2 3 1k\nR4 3 4 1k\nR5 4 5 1k\nC1 1 0 1n IC=0\nC2 2 0 1n IC=0\nC3 3 0 1n IC=0\nC4 4 0 1n IC=0\nC5 5 0 1n IC=0\n.options meth~d=gear maxord=1 trtol=1e7\n.tran 50n 10475n 0 50n uic\n.end\n";

/// Copy the deck text `lit` into dst with every ~ written as the letter o; the length is the result.
pub fn deck_text(dst: []u8, lit: []const u8) -> usize {
    var i : usize = 0;
    while (i < lit.len and i < dst.len) {
        if (lit[i] == 126) { dst[i] = 111; } else { dst[i] = lit[i]; }
        i = i + 1;
    }
    return i;
}

/// parse_num over the whole of s.
pub fn num_of(s: []const u8, st: []usize) -> bool {
    return parse_num(s, 0, s.len, st);
}

/// time_only over the whole of s.
pub fn time_expr(s: []const u8) -> bool {
    return time_only(s, 0, s.len);
}

/// How many of the cell's words in st differ from the n * n words d and the n words nv (the ones linear.t27 pins).
pub fn cell_diff(st: []usize, n: usize, d: []const u32, nv: []const u32) -> usize {
    var miss : usize = 0;
    var i : usize = 0;
    while (i < n * n) {
        if ((st[CELL + CL_D + i] as u32) != d[i]) { miss = miss + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if ((st[CELL + CL_NV + i] as u32) != nv[i]) { miss = miss + 1; }
        i = i + 1;
    }
    return miss;
}

test the_rc_deck_folds_to_the_words_linear_pins {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const len : usize = deck_text(&src, DECK_RC);
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    assert_eq(st[CELL + CL_UNK], RC_N);
    assert_eq(st[CELL + CL_NODES], 1);
    assert_eq(st[CELL + CL_IND], 0);
    assert_eq(cell_diff(&st, RC_N, &RC_D, &RC_NV), 0);
    assert((st[CELL + CL_D] as u32) == (NEG | 798915));
    assert((st[CELL + CL_NV] as u32) == 798915);
}

test the_rlc_deck_folds_to_the_words_linear_pins {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const len : usize = deck_text(&src, DECK_RLC);
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    assert_eq(st[CELL + CL_UNK], RLC_N);
    assert_eq(st[CELL + CL_NODES], 2);
    assert_eq(st[CELL + CL_IND], 1);
    assert_eq(cell_diff(&st, RLC_N, &RLC_D, &RLC_NV), 0);
    // the node between R and L has no capacitor: its D_aa is exactly -1, and the inductor state is i * 100 Ohm
    assert((st[CELL + CL_D] as u32) == (NEG | 16777216));
}

test the_ladder3_deck_folds_to_the_words_linear_pins {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const len : usize = deck_text(&src, DECK_LAD3);
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    assert_eq(st[CELL + CL_UNK], LAD3_N);
    assert_eq(cell_diff(&st, LAD3_N, &LAD3_D, &LAD3_NV), 0);
}

test the_ladder5_deck_folds_to_the_words_linear_pins {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    const len : usize = deck_text(&src, DECK_LAD5);
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    assert_eq(st[CELL + CL_UNK], LAD5_N);
    assert_eq(cell_diff(&st, LAD5_N, &LAD5_D, &LAD5_NV), 0);
}

test node_names_do_not_change_the_words_and_case_is_ignored {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "rc renamed\nB1 VIN 0 V = u(time)\nR1 vin out 1k\nC1 OUT 0 1n IC=0\n.options meth~d=gear maxord=1 trtol=1e7\n.tran 50n 10475n 0 50n uic\n.end\n");
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    assert_eq(cell_diff(&st, RC_N, &RC_D, &RC_NV), 0);
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "ladder renamed\nB1 drive 0 V = u(time)\nR1 drive a 1k\nR2 a b 1k\nR3 b c 1k\nC1 a 0 1n\nC2 b 0 1n\nC3 c 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 10475n 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 0);
    assert_eq(cell_diff(&st2, LAD3_N, &LAD3_D, &LAD3_NV), 0);
}

test the_states_are_the_free_nodes_in_order_of_first_appearance_then_the_inductors {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    // the ladder with its capacitors first: node 3 is met first, then 2, then 1: the states run backwards
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "backwards\nB1 in 0 V = u(time)\nC3 3 0 1n\nC2 2 0 1n\nC1 1 0 1n\nR1 in 1 1k\nR2 1 2 1k\nR3 2 3 1k\n.options meth~d=gear maxord=1\n.tran 50n 10475n 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    var i : usize = 0;
    var j : usize = 0;
    var miss : usize = 0;
    while (i < 3) {
        j = 0;
        while (j < 3) {
            if ((st[CELL + CL_D + i * 3 + j] as u32) != LAD3_D[(2 - i) * 3 + (2 - j)]) { miss = miss + 1; }
            j = j + 1;
        }
        if ((st[CELL + CL_NV + i] as u32) != LAD3_NV[2 - i]) { miss = miss + 1; }
        i = i + 1;
    }
    assert_eq(miss, 0);
    // the series RLC with its capacitor first: the capacitor's node is x0, the R-L node x1, the inductor is last
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "rlc, capacitor first\nB1 in 0 V = u(time)\nC1 2 0 1n\nR1 in 1 100\nL1 1 2 10u\n.options meth~d=gear maxord=1\n.tran 5n 1047.5n 0 5n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 0);
    const p : [3]usize = [1, 0, 2];
    i = 0;
    miss = 0;
    while (i < 3) {
        j = 0;
        while (j < 3) {
            if ((st2[CELL + CL_D + i * 3 + j] as u32) != RLC_D[p[i] * 3 + p[j]]) { miss = miss + 1; }
            j = j + 1;
        }
        if ((st2[CELL + CL_NV + i] as u32) != RLC_NV[p[i]]) { miss = miss + 1; }
        i = i + 1;
    }
    assert_eq(miss, 0);
    var st3 : [3000]usize = [0] ** 3000;
    const n : usize = emit_cell(src[0 .. len], &w, &out, &st3);
    assert(has_text(n, &out, "//   x0 = v(2)\n//   x1 = v(1)\n//   x2 = i(L1) * zs\n"));
}

test one_resistor_changed_gives_different_words {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    // the RC deck with R1 = 1.1 kOhm: g = dt / (R C + dt) = 5e-8 / 1.15e-6 = 1/23 -> 729444 at 2^-24, not 1/21 -> 798915
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "rc, 1.1k\nB1 in 0 V = u(time-425n) - u(time-5425n)\nR1 in 1 1.1k\nC1 1 0 1n IC=0\n.options meth~d=gear maxord=1 trtol=1e7\n.tran 50n 10475n 0 50n uic\n.end\n");
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    assert(cell_diff(&st, RC_N, &RC_D, &RC_NV) == 2);
    assert((st[CELL + CL_D] as u32) == (NEG | 729444));
    assert((st[CELL + CL_NV] as u32) == 729444);
    // the 3-node ladder with R2 doubled: every word that touches node 2 moves
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "ladder, R2 = 2k\nB1 in 0 V = u(time)\nR1 in 1 1k\nR2 1 2 2k\nR3 2 3 1k\nC1 1 0 1n\nC2 2 0 1n\nC3 3 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 10475n 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 0);
    assert(cell_diff(&st2, LAD3_N, &LAD3_D, &LAD3_NV) > 0);
    assert((st2[CELL + CL_D + 4] as u32) != LAD3_D[4]);
}

test a_mos_line_is_refused_naming_the_line {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "mos\nB1 in 0 V = u(time)\nR1 in 1 1k\nM1 1 in 0 0 nmos w=1u l=1u\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    const n : usize = emit_cell(src[0 .. len], &w, &out, &st);
    assert(st[ERR_LINE] == 4);
    assert(st[ERR_WHY] == Y_ELEMENT);
    assert(exit_code(&st) == 1);
    assert(out_is(n, &out, 0, "line 4: M element not supported\n  card: M1 1 in 0 0 nmos w=1u l=1u\n"));
    // a PDK device is a subcircuit instance to the cell: refused with its line too
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "pdk\nB1 in 0 V = u(time)\nR1 in 1 1k\nXM1 1 in 0 0 sg13_lv_nmos w=1u l=130n\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    const n2 : usize = emit_cell(src[0 .. len], &w, &out, &st2);
    assert(st2[ERR_LINE] == 4);
    assert(st2[ERR_WHY] == Y_CELL_EL);
    assert(has_text(n2, &out, "line 4: not in the M1 cell (a flat deck of R, C, L and one input source)\n  card: XM1 1 in 0 0 sg13_lv_nmos w=1u l=130n\n"));
    // and so is a current source, which the cell has no row for
    var st3 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "isrc\nB1 in 0 V = u(time)\nR1 in 1 1k\nI1 1 0 DC 1m\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st3);
    assert(st3[ERR_LINE] == 4 and st3[ERR_WHY] == Y_CELL_EL);
}

test a_b_source_is_an_input_only_when_it_is_a_function_of_time_alone {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "bsrc\nB1 in 0 V = v(1) * 2\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    const n : usize = emit_cell(src[0 .. len], &w, &out, &st);
    assert(st[ERR_LINE] == 2 and st[ERR_WHY] == Y_B);
    assert(has_text(n, &out, "line 2: B source not supported (only a voltage that is a function of time alone is read)\n  card: B1 in 0 V = v(1) * 2\n"));
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "bcur\nB1 in 0 I = u(time)\nR1 in 1 1k\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 2 and st2[ERR_WHY] == Y_B);
    assert(time_expr("u(time-425n) - u(time-5425n)"));
    assert(time_expr("2 * sin(6.28e3 * time) + 1"));
    assert(time_expr("uramp(time-1u)/1u"));
    assert(time_expr("1"));
    assert(!time_expr("v(a)*2"));
    assert(!time_expr("i(v1)"));
    assert(!time_expr("u(time) + vin"));
    assert(!time_expr("@r1[i]"));
    assert(!time_expr("time > 1u"));
    assert(!time_expr("2v(1)"));
    assert(!time_expr(""));
}

test the_input_source_is_one_v_or_b_from_a_node_to_ground {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "two\nB1 in 0 V = u(time)\nV2 x 0 1\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 3 and st[ERR_WHY] == Y_CELL_IN);
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "floating\nV1 a b 1\nR1 a 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 2 and st2[ERR_WHY] == Y_CELL_IN);
    var st3 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "upside down\nV1 0 a 1\nR1 a 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st3);
    assert(st3[ERR_LINE] == 2 and st3[ERR_WHY] == Y_CELL_IN);
    var st4 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "none\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st4);
    assert(st4[ERR_LINE] == 5 and st4[ERR_WHY] == Y_CELL_IN and st4[ERR_CARD] == NONE);
    // a V source with a waveform is the same input: only the column of B matters, not what u does
    var st5 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "pulse\nV1 in 0 PULSE(0 1 0 1n 1n 5u 10u)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st5);
    assert(st5[ERR_LINE] == 0);
    assert_eq(cell_diff(&st5, RC_N, &RC_D, &RC_NV), 0);
}

test values_nodes_and_keys_the_cell_cannot_take_are_refused {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "v0\nB1 in 0 V = u(time)\nR1 in 1 0\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    const n : usize = emit_cell(src[0 .. len], &w, &out, &st);
    assert(st[ERR_LINE] == 3 and st[ERR_WHY] == Y_CELL_VALUE);
    assert(has_text(n, &out, "line 3: R, C and L need a positive value (a mantissa up to 2^53, a power of ten within 22), two different nodes and no m=, and C and L may not touch the input node: 0\n  card: R1 in 1 0\n"));
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "neg\nB1 in 0 V = u(time)\nR1 in 1 -1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 3 and st2[ERR_WHY] == Y_CELL_VALUE);
    var st3 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "loop\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 1 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st3);
    assert(st3[ERR_LINE] == 4 and st3[ERR_WHY] == Y_CELL_VALUE);
    var st4 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "cap on the input\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 in 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st4);
    assert(st4[ERR_LINE] == 4 and st4[ERR_WHY] == Y_CELL_VALUE);
    var st5 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "multiplier\nB1 in 0 V = u(time)\nR1 in 1 1k m=2\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st5);
    assert(st5[ERR_LINE] == 3 and st5[ERR_WHY] == Y_CELL_VALUE);
    var st6 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "gnd\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 gnd 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st6);
    assert(st6[ERR_LINE] == 4 and st6[ERR_WHY] == Y_CELL_GND);
    var st7 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "ic\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n IC=0.5\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st7);
    assert(st7[ERR_LINE] == 4 and st7[ERR_WHY] == Y_CELL_IC);
    var st8 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "dot ic\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.ic v(1)=0.5\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st8);
    assert(st8[ERR_LINE] == 5 and st8[ERR_WHY] == Y_CELL_IC);
    var st9 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "zero ic is the cell's own start\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n IC=0\n.ic v(1)=0\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st9);
    assert(st9[ERR_LINE] == 0);
}

test size_step_and_integration_are_checked {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "six nodes\nB1 in 0 V = u(time)\nR1 in 1 1k\nR2 1 2 1k\nR3 2 3 1k\nR4 3 4 1k\nR5 4 5 1k\nR6 5 6 1k\nC1 6 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 8 and st[ERR_WHY] == Y_CELL_SIZE);
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "five nodes and an inductor\nB1 in 0 V = u(time)\nR1 in 1 1k\nR2 1 2 1k\nR3 2 3 1k\nR4 3 4 1k\nR5 4 5 1k\nC1 5 0 1n\nL1 5 0 1u\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 9 and st2[ERR_WHY] == Y_CELL_SIZE);
    var st0 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "a source and nothing to drive\nB1 in 0 V = u(time)\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st0);
    assert(st0[ERR_LINE] == 4 and st0[ERR_WHY] == Y_CELL_SIZE and st0[ERR_CARD] == NONE);
    var st3 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "no analysis\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.end\n");
    cell_build(src[0 .. len], &w, &st3);
    assert(st3[ERR_LINE] == 5 and st3[ERR_WHY] == Y_CELL_DT);
    var st4 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "two numbers\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u\n.end\n");
    cell_build(src[0 .. len], &w, &st4);
    assert(st4[ERR_LINE] == 6 and st4[ERR_WHY] == Y_CELL_DT);
    var st5 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "two analyses\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.tran 50n 2u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st5);
    assert(st5[ERR_LINE] == 7 and st5[ERR_WHY] == Y_CELL_DT);
    var st6 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "default integration\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st6);
    assert(st6[ERR_LINE] == 5 and st6[ERR_WHY] == Y_CELL_METHOD);
    var st7 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "second order\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=2\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st7);
    assert(st7[ERR_LINE] == 6 and st7[ERR_WHY] == Y_CELL_METHOD);
    var st8 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "trapezoidal\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=trap\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st8);
    assert(st8[ERR_LINE] == 6 and st8[ERR_WHY] == Y_CELL_METHOD);
    // the control block's tran is the analysis too
    var st9 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "control tran\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.control\ntran 50n 1u 0 50n\n.endc\n.end\n");
    cell_build(src[0 .. len], &w, &st9);
    assert(st9[ERR_LINE] == 0);
    assert_eq(cell_diff(&st9, RC_N, &RC_D, &RC_NV), 0);
}

test dt_is_the_fourth_number_of_tran_not_the_first {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    // tstep 10n only prints finer; tmax 50n is the step: the words are the RC deck's
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "tstep is not dt\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 10n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 0);
    assert_eq(cell_diff(&st, RC_N, &RC_D, &RC_NV), 0);
    // tmax 100n doubles the step: g = dt / (R C + dt) = 1/11 -> 1525201 at 2^-24
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "tmax doubles dt\nB1 in 0 V = u(time)\nR1 in 1 1k\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 100n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 0);
    assert((st2[CELL + CL_D] as u32) == (NEG | 1525201));
    assert((st2[CELL + CL_NV] as u32) == 1525201);
}

test a_floating_pair_has_no_solution_and_a_scanner_refusal_comes_first {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, "floating\nB1 in 0 V = u(time)\nR1 in 3 1k\nC1 3 0 1n\nR2 1 2 1k\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st);
    assert(st[ERR_LINE] == 2 and st[ERR_WHY] == Y_CELL_SOLVE);
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "scanner\nB1 in 0 V = u(time)\nR1 in 1 abc\nC1 1 0 1n\n.options meth~d=gear maxord=1\n.tran 50n 1u 0 50n\n.end\n");
    cell_build(src[0 .. len], &w, &st2);
    assert(st2[ERR_LINE] == 3 and st2[ERR_WHY] == Y_NUMBER);
}

test the_emitted_block_is_the_words_as_a_t27_constant_block {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var out : [4096]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, DECK_RC);
    var n : usize = emit_cell(src[0 .. len], &w, &out, &st);
    assert(exit_code(&st) == 0);
    assert(out_is(n, &out, 0, "// t27o --emit-cell: M0 RC low-pass, backward Euler on a fixed 50 ns grid\n// the input u is the source on node in (line 2); backward Euler, dt = 5e-8 s (the tmax of line 6); zs = 1\n// the states, in the order of the words:\n//   x0 = v(1)\npub const CELL_N : usize = 1;\npub const CELL_D : [1]u32 = [NEG | 798915];\npub const CELL_NV : [1]u32 = [798915] ** 1;\n"));
    var st2 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, DECK_RLC);
    n = emit_cell(src[0 .. len], &w, &out, &st2);
    assert(out_is(n, &out, 0, "// t27o --emit-cell: M1 series RLC, backward Euler on a fixed 5 ns grid\n// the input u is the source on node in (line 2); backward Euler, dt = 5e-9 s (the tmax of line 7); zs = sqrt(1e-5 / 1e-9)\n// the states, in the order of the words:\n//   x0 = v(1)\n//   x1 = v(2)\n//   x2 = i(L1) * zs\npub const CELL_N : usize = 3;\npub const CELL_D : [9]u32 = [\n    NEG | 16777216, 797017, NEG | 15940348,\n    0, NEG | 39851, 797017,\n    0, NEG | 797017, NEG | 836868\n];\npub const CELL_NV : [3]u32 = [15980199, 39851, 797017];\n"));
    // an inductor without a capacitor: zs is 1
    var st3 : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "RL\nV1 in 0 1\nR1 in 1 100\nL1 1 0 10u\n.options meth~d=gear maxord=1\n.tran 5n 1u 0 5n\n.end\n");
    n = emit_cell(src[0 .. len], &w, &out, &st3);
    assert(exit_code(&st3) == 0);
    assert_eq(st3[CELL + CL_UNK], 2);
    assert(has_text(n, &out, "zs = 1\n"));
    assert(has_text(n, &out, "//   x1 = i(L1) * zs\n"));
}

test values_read_from_a_deck_are_the_literals_of_linear {
    var st : [64]usize = [0] ** 64;
    assert(num_of("1k", &st));
    assert(dec_f64(st[VM], st[VE]) == 1000.0);
    assert(num_of("100", &st));
    assert(dec_f64(st[VM], st[VE]) == 100.0);
    assert(num_of("1n", &st));
    assert(dec_f64(st[VM], st[VE]) == 1.0e-9);
    assert(num_of("5n", &st));
    assert(dec_f64(st[VM], st[VE]) == 5.0e-9);
    assert(num_of("50n", &st));
    assert(dec_f64(st[VM], st[VE]) == 5.0e-8);
    assert(num_of("10u", &st));
    assert(dec_f64(st[VM], st[VE]) == 1.0e-5);
    assert(num_of("2.2u", &st));
    assert(dec_f64(st[VM], st[VE]) == 2.2e-6);
    assert(num_of("0.13u", &st));
    assert(dec_f64(st[VM], st[VE]) == 1.3e-7);
    assert(num_of("1.1k", &st));
    assert(dec_f64(st[VM], st[VE]) == 1100.0);
    assert(num_of("47pF", &st));
    assert(dec_f64(st[VM], st[VE]) == 4.7e-11);
    assert(dec_ok(1, EXP_BIAS - 22));
    assert(!dec_ok(1, EXP_BIAS - 23));
    assert(dec_ok(1, EXP_BIAS + 22));
    assert(!dec_ok(1, EXP_BIAS + 23));
    assert(dec_ok(9007199254740992, EXP_BIAS));
    assert(!dec_ok(9007199254740993, EXP_BIAS));
    assert(!dec_ok(0, EXP_BIAS));
}

test b_sources_ic_and_the_integration_options_are_read_by_the_inventory_too {
    var src : [1024]u8 = undefined;
    var w : [2048]u8 = undefined;
    var out : [4096]u8 = undefined;
    var st : [3000]usize = [0] ** 3000;
    var len : usize = deck_text(&src, DECK_RLC);
    var n : usize = inventory(src[0 .. len], &w, &out, &st);
    assert(st[ERR_LINE] == 0);
    assert(st[N_BSRC] == 1);
    assert(st[SRC + K_V] == 1);
    assert(st[SRC + K_L] == 1);
    assert(st[OPT_METHOD] == 1);
    assert(st[OPT_MAXORD] == 1);
    assert(st[N_OPT] == 1);
    assert(st[N_TRAN] == 1);
    assert(has_text(n, &out, "sources: dc=0 pulse=0 sin=0 pwl=0 b=1\n"));
    assert(has_text(n, &out, "tran (.tran card) 5n 1047.5n: tstep 5e-9 tstop 10475e-10 (line 7)\n"));
    assert(has_text(n, &out, "flattened: instances=4 r=1 c=1 l=1 v=1 i=0 e=0 mos=0 mim=0 levels=0 depth=0\n"));
    assert(has_text(n, &out, "instances:\nb1 b\nr1 r\nl1 l\nc1 c\n"));
    // ic= belongs to C and L only; the other integration choices are read, and an unknown option is still refused
    var a : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "ic\nR1 a b 1k ic=0\n.end\n");
    n = inventory(src[0 .. len], &w, &out, &a);
    assert(n > 0);
    assert(a[ERR_LINE] == 2 and a[ERR_WHY] == Y_PARAM);
    var b : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "opts\n.options meth~d=trap maxord=2 trtol=7\n.end\n");
    n = inventory(src[0 .. len], &w, &out, &b);
    assert(n > 0);
    assert(b[ERR_LINE] == 0);
    assert(b[OPT_METHOD] == 2);
    assert(b[OPT_MAXORD] == 2);
    var c : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "opts\n.options meth~d=euler\n.end\n");
    n = inventory(src[0 .. len], &w, &out, &c);
    assert(n > 0);
    assert(c[ERR_LINE] == 2 and c[ERR_WHY] == Y_OPTION);
    var d : [3000]usize = [0] ** 3000;
    len = deck_text(&src, "opts\n.options meth~d=\n.end\n");
    n = inventory(src[0 .. len], &w, &out, &d);
    assert(n > 0);
    assert(d[ERR_LINE] == 2 and d[ERR_WHY] == Y_FIELDS);
}
