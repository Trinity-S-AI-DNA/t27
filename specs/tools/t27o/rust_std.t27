    assert(div_ceil_u64(3, 9223372036854775808) == 1);
    assert(div_ceil_u64(3, 18446744073709551615) == 1);
    assert(div_ceil_u64(7, 1) == 7);
    assert(div_ceil_u64(7, 2) == 4);
    assert(div_ceil_u64(7, 3) == 3);
    assert(div_ceil_u64(7, 7) == 1);
    assert(div_ceil_u64(7, 4294967295) == 1);
    assert(div_ceil_u64(7, 4294967296) == 1);
    assert(div_ceil_u64(7, 9223372036854775807) == 1);
    assert(div_ceil_u64(7, 9223372036854775808) == 1);
    assert(div_ceil_u64(7, 18446744073709551615) == 1);
    assert(div_ceil_u64(4294967295, 1) == 4294967295);
    assert(div_ceil_u64(4294967295, 2) == 2147483648);
    assert(div_ceil_u64(4294967295, 3) == 1431655765);
    assert(div_ceil_u64(4294967295, 7) == 613566757);
    assert(div_ceil_u64(4294967295, 4294967295) == 1);
    assert(div_ceil_u64(4294967295, 4294967296) == 1);
    assert(div_ceil_u64(4294967295, 9223372036854775807) == 1);
    assert(div_ceil_u64(4294967295, 9223372036854775808) == 1);
    assert(div_ceil_u64(4294967295, 18446744073709551615) == 1);
    assert(div_ceil_u64(4294967296, 1) == 4294967296);
    assert(div_ceil_u64(4294967296, 2) == 2147483648);
    assert(div_ceil_u64(4294967296, 3) == 1431655766);
    assert(div_ceil_u64(4294967296, 7) == 613566757);
    assert(div_ceil_u64(4294967296, 4294967295) == 2);
    assert(div_ceil_u64(4294967296, 4294967296) == 1);
    assert(div_ceil_u64(4294967296, 9223372036854775807) == 1);
    assert(div_ceil_u64(4294967296, 9223372036854775808) == 1);
    assert(div_ceil_u64(4294967296, 18446744073709551615) == 1);
    assert(div_ceil_u64(9223372036854775807, 1) == 9223372036854775807);
    assert(div_ceil_u64(9223372036854775807, 2) == 4611686018427387904);
    assert(div_ceil_u64(9223372036854775807, 3) == 3074457345618258603);
    assert(div_ceil_u64(9223372036854775807, 7) == 1317624576693539401);
    assert(div_ceil_u64(9223372036854775807, 4294967295) == 2147483649);
    assert(div_ceil_u64(9223372036854775807, 4294967296) == 2147483648);
    assert(div_ceil_u64(9223372036854775807, 9223372036854775807) == 1);
    assert(div_ceil_u64(9223372036854775807, 9223372036854775808) == 1);
    assert(div_ceil_u64(9223372036854775807, 18446744073709551615) == 1);
    assert(div_ceil_u64(9223372036854775808, 1) == 9223372036854775808);
    assert(div_ceil_u64(9223372036854775808, 2) == 4611686018427387904);
    assert(div_ceil_u64(9223372036854775808, 3) == 3074457345618258603);
    assert(div_ceil_u64(9223372036854775808, 7) == 1317624576693539402);
    assert(div_ceil_u64(9223372036854775808, 4294967295) == 2147483649);
    assert(div_ceil_u64(9223372036854775808, 4294967296) == 2147483648);
    assert(div_ceil_u64(9223372036854775808, 9223372036854775807) == 2);
    assert(div_ceil_u64(9223372036854775808, 9223372036854775808) == 1);
    assert(div_ceil_u64(9223372036854775808, 18446744073709551615) == 1);
    assert(div_ceil_u64(18446744073709551615, 1) == 18446744073709551615);
    assert(div_ceil_u64(18446744073709551615, 2) == 9223372036854775808);
    assert(div_ceil_u64(18446744073709551615, 3) == 6148914691236517205);
    assert(div_ceil_u64(18446744073709551615, 7) == 2635249153387078803);
    assert(div_ceil_u64(18446744073709551615, 4294967295) == 4294967297);
    assert(div_ceil_u64(18446744073709551615, 4294967296) == 4294967296);
    assert(div_ceil_u64(18446744073709551615, 9223372036854775807) == 3);
    assert(div_ceil_u64(18446744073709551615, 9223372036854775808) == 2);
    assert(div_ceil_u64(18446744073709551615, 18446744073709551615) == 1);
}

/// div_ceil of usize: every expected value was printed by rustc 1.99 running `a.div_ceil(b)` on the same inputs;
/// the pairs are the edge values taken pairwise, divisor 0 left out (it panics).
test std_div_ceil_of_usize_is_rusts {
    assert(div_ceil_usize(0, 1) == 0);
    assert(div_ceil_usize(0, 2) == 0);
    assert(div_ceil_usize(0, 3) == 0);
    assert(div_ceil_usize(0, 7) == 0);
    assert(div_ceil_usize(0, 4294967295) == 0);
    assert(div_ceil_usize(0, 4294967296) == 0);
    assert(div_ceil_usize(0, 9223372036854775807) == 0);
    assert(div_ceil_usize(0, 9223372036854775808) == 0);
    assert(div_ceil_usize(0, 18446744073709551615) == 0);
    assert(div_ceil_usize(1, 1) == 1);
    assert(div_ceil_usize(1, 2) == 1);
    assert(div_ceil_usize(1, 3) == 1);
    assert(div_ceil_usize(1, 7) == 1);
    assert(div_ceil_usize(1, 4294967295) == 1);
    assert(div_ceil_usize(1, 4294967296) == 1);
    assert(div_ceil_usize(1, 9223372036854775807) == 1);
    assert(div_ceil_usize(1, 9223372036854775808) == 1);
    assert(div_ceil_usize(1, 18446744073709551615) == 1);
    assert(div_ceil_usize(2, 1) == 2);
    assert(div_ceil_usize(2, 2) == 1);
    assert(div_ceil_usize(2, 3) == 1);
    assert(div_ceil_usize(2, 7) == 1);
    assert(div_ceil_usize(2, 4294967295) == 1);
    assert(div_ceil_usize(2, 4294967296) == 1);
    assert(div_ceil_usize(2, 9223372036854775807) == 1);
    assert(div_ceil_usize(2, 9223372036854775808) == 1);
    assert(div_ceil_usize(2, 18446744073709551615) == 1);
    assert(div_ceil_usize(3, 1) == 3);
    assert(div_ceil_usize(3, 2) == 2);
    assert(div_ceil_usize(3, 3) == 1);
    assert(div_ceil_usize(3, 7) == 1);
    assert(div_ceil_usize(3, 4294967295) == 1);
    assert(div_ceil_usize(3, 4294967296) == 1);
    assert(div_ceil_usize(3, 9223372036854775807) == 1);
    assert(div_ceil_usize(3, 9223372036854775808) == 1);
    assert(div_ceil_usize(3, 18446744073709551615) == 1);
    assert(div_ceil_usize(7, 1) == 7);
    assert(div_ceil_usize(7, 2) == 4);
    assert(div_ceil_usize(7, 3) == 3);
    assert(div_ceil_usize(7, 7) == 1);
    assert(div_ceil_usize(7, 4294967295) == 1);
    assert(div_ceil_usize(7, 4294967296) == 1);
    assert(div_ceil_usize(7, 9223372036854775807) == 1);
    assert(div_ceil_usize(7, 9223372036854775808) == 1);
    assert(div_ceil_usize(7, 18446744073709551615) == 1);
    assert(div_ceil_usize(4294967295, 1) == 4294967295);
    assert(div_ceil_usize(4294967295, 2) == 2147483648);
    assert(div_ceil_usize(4294967295, 3) == 1431655765);
    assert(div_ceil_usize(4294967295, 7) == 613566757);
    assert(div_ceil_usize(4294967295, 4294967295) == 1);
    assert(div_ceil_usize(4294967295, 4294967296) == 1);
    assert(div_ceil_usize(4294967295, 9223372036854775807) == 1);
    assert(div_ceil_usize(4294967295, 9223372036854775808) == 1);
    assert(div_ceil_usize(4294967295, 18446744073709551615) == 1);
    assert(div_ceil_usize(4294967296, 1) == 4294967296);
    assert(div_ceil_usize(4294967296, 2) == 2147483648);
    assert(div_ceil_usize(4294967296, 3) == 1431655766);
    assert(div_ceil_usize(4294967296, 7) == 613566757);
    assert(div_ceil_usize(4294967296, 4294967295) == 2);
