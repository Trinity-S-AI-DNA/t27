}

/// saturating_add / sub / mul of i32: every expected value was printed by rustc 1.99 running the method on the same
/// inputs; the grid is the edge values taken pairwise, so the clamp-up, clamp-down and exact paths are all reached.
test std_saturating_arithmetic_of_i32_is_rusts {
    assert(saturating_add_i32(I32_MIN, I32_MIN) == I32_MIN);
    assert(saturating_add_i32(I32_MIN, -7) == I32_MIN);
    assert(saturating_add_i32(I32_MIN, -1) == I32_MIN);
    assert(saturating_add_i32(I32_MIN, 0) == I32_MIN);
    assert(saturating_add_i32(I32_MIN, 1) == -2147483647);
    assert(saturating_add_i32(I32_MIN, 7) == -2147483641);
    assert(saturating_add_i32(I32_MIN, I32_MAX) == -1);
    assert(saturating_add_i32(-7, I32_MIN) == I32_MIN);
    assert(saturating_add_i32(-7, -7) == -14);
    assert(saturating_add_i32(-7, -1) == -8);
    assert(saturating_add_i32(-7, 0) == -7);
    assert(saturating_add_i32(-7, 1) == -6);
    assert(saturating_add_i32(-7, 7) == 0);
    assert(saturating_add_i32(-7, I32_MAX) == 2147483640);
    assert(saturating_add_i32(-1, I32_MIN) == I32_MIN);
    assert(saturating_add_i32(-1, -7) == -8);
    assert(saturating_add_i32(-1, -1) == -2);
    assert(saturating_add_i32(-1, 0) == -1);
    assert(saturating_add_i32(-1, 1) == 0);
    assert(saturating_add_i32(-1, 7) == 6);
    assert(saturating_add_i32(-1, I32_MAX) == 2147483646);
    assert(saturating_add_i32(0, I32_MIN) == I32_MIN);
    assert(saturating_add_i32(0, -7) == -7);
    assert(saturating_add_i32(0, -1) == -1);
    assert(saturating_add_i32(0, 0) == 0);
    assert(saturating_add_i32(0, 1) == 1);
    assert(saturating_add_i32(0, 7) == 7);
    assert(saturating_add_i32(0, I32_MAX) == I32_MAX);
    assert(saturating_add_i32(1, I32_MIN) == -2147483647);
    assert(saturating_add_i32(1, -7) == -6);
    assert(saturating_add_i32(1, -1) == 0);
    assert(saturating_add_i32(1, 0) == 1);
    assert(saturating_add_i32(1, 1) == 2);
    assert(saturating_add_i32(1, 7) == 8);
    assert(saturating_add_i32(1, I32_MAX) == I32_MAX);
    assert(saturating_add_i32(7, I32_MIN) == -2147483641);
    assert(saturating_add_i32(7, -7) == 0);
    assert(saturating_add_i32(7, -1) == 6);
    assert(saturating_add_i32(7, 0) == 7);
    assert(saturating_add_i32(7, 1) == 8);
    assert(saturating_add_i32(7, 7) == 14);
    assert(saturating_add_i32(7, I32_MAX) == I32_MAX);
    assert(saturating_add_i32(I32_MAX, I32_MIN) == -1);
    assert(saturating_add_i32(I32_MAX, -7) == 2147483640);
    assert(saturating_add_i32(I32_MAX, -1) == 2147483646);
    assert(saturating_add_i32(I32_MAX, 0) == I32_MAX);
    assert(saturating_add_i32(I32_MAX, 1) == I32_MAX);
    assert(saturating_add_i32(I32_MAX, 7) == I32_MAX);
    assert(saturating_add_i32(I32_MAX, I32_MAX) == I32_MAX);
    assert(saturating_sub_i32(I32_MIN, I32_MIN) == 0);
    assert(saturating_sub_i32(I32_MIN, -7) == -2147483641);
    assert(saturating_sub_i32(I32_MIN, -1) == -2147483647);
    assert(saturating_sub_i32(I32_MIN, 0) == I32_MIN);
    assert(saturating_sub_i32(I32_MIN, 1) == I32_MIN);
    assert(saturating_sub_i32(I32_MIN, 7) == I32_MIN);
    assert(saturating_sub_i32(I32_MIN, I32_MAX) == I32_MIN);
    assert(saturating_sub_i32(-7, I32_MIN) == 2147483641);
    assert(saturating_sub_i32(-7, -7) == 0);
    assert(saturating_sub_i32(-7, -1) == -6);
    assert(saturating_sub_i32(-7, 0) == -7);
    assert(saturating_sub_i32(-7, 1) == -8);
    assert(saturating_sub_i32(-7, 7) == -14);
    assert(saturating_sub_i32(-7, I32_MAX) == I32_MIN);
    assert(saturating_sub_i32(-1, I32_MIN) == I32_MAX);
    assert(saturating_sub_i32(-1, -7) == 6);
    assert(saturating_sub_i32(-1, -1) == 0);
    assert(saturating_sub_i32(-1, 0) == -1);
    assert(saturating_sub_i32(-1, 1) == -2);
    assert(saturating_sub_i32(-1, 7) == -8);
    assert(saturating_sub_i32(-1, I32_MAX) == I32_MIN);
    assert(saturating_sub_i32(0, I32_MIN) == I32_MAX);
    assert(saturating_sub_i32(0, -7) == 7);
    assert(saturating_sub_i32(0, -1) == 1);
    assert(saturating_sub_i32(0, 0) == 0);
    assert(saturating_sub_i32(0, 1) == -1);
    assert(saturating_sub_i32(0, 7) == -7);
    assert(saturating_sub_i32(0, I32_MAX) == -2147483647);
    assert(saturating_sub_i32(1, I32_MIN) == I32_MAX);
    assert(saturating_sub_i32(1, -7) == 8);
    assert(saturating_sub_i32(1, -1) == 2);
    assert(saturating_sub_i32(1, 0) == 1);
    assert(saturating_sub_i32(1, 1) == 0);
    assert(saturating_sub_i32(1, 7) == -6);
    assert(saturating_sub_i32(1, I32_MAX) == -2147483646);
    assert(saturating_sub_i32(7, I32_MIN) == I32_MAX);
    assert(saturating_sub_i32(7, -7) == 14);
    assert(saturating_sub_i32(7, -1) == 8);
    assert(saturating_sub_i32(7, 0) == 7);
    assert(saturating_sub_i32(7, 1) == 6);
    assert(saturating_sub_i32(7, 7) == 0);
    assert(saturating_sub_i32(7, I32_MAX) == -2147483640);
    assert(saturating_sub_i32(I32_MAX, I32_MIN) == I32_MAX);
    assert(saturating_sub_i32(I32_MAX, -7) == I32_MAX);
    assert(saturating_sub_i32(I32_MAX, -1) == I32_MAX);
    assert(saturating_sub_i32(I32_MAX, 0) == I32_MAX);
    assert(saturating_sub_i32(I32_MAX, 1) == 2147483646);
    assert(saturating_sub_i32(I32_MAX, 7) == 2147483640);
    assert(saturating_sub_i32(I32_MAX, I32_MAX) == 0);
    assert(saturating_mul_i32(I32_MIN, I32_MIN) == I32_MAX);
    assert(saturating_mul_i32(I32_MIN, -7) == I32_MAX);
    assert(saturating_mul_i32(I32_MIN, -1) == I32_MAX);
    assert(saturating_mul_i32(I32_MIN, 0) == 0);
    assert(saturating_mul_i32(I32_MIN, 1) == I32_MIN);
    assert(saturating_mul_i32(I32_MIN, 7) == I32_MIN);
    assert(saturating_mul_i32(I32_MIN, I32_MAX) == I32_MIN);
    assert(saturating_mul_i32(-7, I32_MIN) == I32_MAX);
    assert(saturating_mul_i32(-7, -7) == 49);
    assert(saturating_mul_i32(-7, -1) == 7);
    assert(saturating_mul_i32(-7, 0) == 0);
    assert(saturating_mul_i32(-7, 1) == -7);
    assert(saturating_mul_i32(-7, 7) == -49);
    assert(saturating_mul_i32(-7, I32_MAX) == I32_MIN);
    assert(saturating_mul_i32(-1, I32_MIN) == I32_MAX);
    assert(saturating_mul_i32(-1, -7) == 7);
    assert(saturating_mul_i32(-1, -1) == 1);
    assert(saturating_mul_i32(-1, 0) == 0);
    assert(saturating_mul_i32(-1, 1) == -1);
    assert(saturating_mul_i32(-1, 7) == -7);
    assert(saturating_mul_i32(-1, I32_MAX) == -2147483647);
    assert(saturating_mul_i32(0, I32_MIN) == 0);
    assert(saturating_mul_i32(0, -7) == 0);
    assert(saturating_mul_i32(0, -1) == 0);
    assert(saturating_mul_i32(0, 0) == 0);
    assert(saturating_mul_i32(0, 1) == 0);
    assert(saturating_mul_i32(0, 7) == 0);
    assert(saturating_mul_i32(0, I32_MAX) == 0);
    assert(saturating_mul_i32(1, I32_MIN) == I32_MIN);
    assert(saturating_mul_i32(1, -7) == -7);
    assert(saturating_mul_i32(1, -1) == -1);
    assert(saturating_mul_i32(1, 0) == 0);
    assert(saturating_mul_i32(1, 1) == 1);
    assert(saturating_mul_i32(1, 7) == 7);
    assert(saturating_mul_i32(1, I32_MAX) == I32_MAX);
    assert(saturating_mul_i32(7, I32_MIN) == I32_MIN);
    assert(saturating_mul_i32(7, -7) == -49);
    assert(saturating_mul_i32(7, -1) == -7);
    assert(saturating_mul_i32(7, 0) == 0);
    assert(saturating_mul_i32(7, 1) == 7);
    assert(saturating_mul_i32(7, 7) == 49);
    assert(saturating_mul_i32(7, I32_MAX) == I32_MAX);
    assert(saturating_mul_i32(I32_MAX, I32_MIN) == I32_MIN);
    assert(saturating_mul_i32(I32_MAX, -7) == I32_MIN);
    assert(saturating_mul_i32(I32_MAX, -1) == -2147483647);
    assert(saturating_mul_i32(I32_MAX, 0) == 0);
    assert(saturating_mul_i32(I32_MAX, 1) == I32_MAX);
    assert(saturating_mul_i32(I32_MAX, 7) == I32_MAX);
    assert(saturating_mul_i32(I32_MAX, I32_MAX) == I32_MAX);
}

/// saturating_add / sub / mul of i64: every expected value was printed by rustc 1.99 running the method on the same
/// inputs; the grid is the edge values taken pairwise, so the clamp-up, clamp-down and exact paths are all reached.
test std_saturating_arithmetic_of_i64_is_rusts {
    assert(saturating_add_i64(I64_MIN, I64_MIN) == I64_MIN);
    assert(saturating_add_i64(I64_MIN, -7) == I64_MIN);
    assert(saturating_add_i64(I64_MIN, -1) == I64_MIN);
    assert(saturating_add_i64(I64_MIN, 0) == I64_MIN);
    assert(saturating_add_i64(I64_MIN, 1) == -9223372036854775807);
    assert(saturating_add_i64(I64_MIN, 7) == -9223372036854775801);
    assert(saturating_add_i64(I64_MIN, I64_MAX) == -1);
    assert(saturating_add_i64(-7, I64_MIN) == I64_MIN);
    assert(saturating_add_i64(-7, -7) == -14);
    assert(saturating_add_i64(-7, -1) == -8);
    assert(saturating_add_i64(-7, 0) == -7);
    assert(saturating_add_i64(-7, 1) == -6);
    assert(saturating_add_i64(-7, 7) == 0);
    assert(saturating_add_i64(-7, I64_MAX) == 9223372036854775800);
    assert(saturating_add_i64(-1, I64_MIN) == I64_MIN);
    assert(saturating_add_i64(-1, -7) == -8);
    assert(saturating_add_i64(-1, -1) == -2);
    assert(saturating_add_i64(-1, 0) == -1);
    assert(saturating_add_i64(-1, 1) == 0);
    assert(saturating_add_i64(-1, 7) == 6);
    assert(saturating_add_i64(-1, I64_MAX) == 9223372036854775806);
    assert(saturating_add_i64(0, I64_MIN) == I64_MIN);
    assert(saturating_add_i64(0, -7) == -7);
    assert(saturating_add_i64(0, -1) == -1);
    assert(saturating_add_i64(0, 0) == 0);
    assert(saturating_add_i64(0, 1) == 1);
    assert(saturating_add_i64(0, 7) == 7);
    assert(saturating_add_i64(0, I64_MAX) == I64_MAX);
    assert(saturating_add_i64(1, I64_MIN) == -9223372036854775807);
    assert(saturating_add_i64(1, -7) == -6);
    assert(saturating_add_i64(1, -1) == 0);
    assert(saturating_add_i64(1, 0) == 1);
    assert(saturating_add_i64(1, 1) == 2);
    assert(saturating_add_i64(1, 7) == 8);
    assert(saturating_add_i64(1, I64_MAX) == I64_MAX);
    assert(saturating_add_i64(7, I64_MIN) == -9223372036854775801);
    assert(saturating_add_i64(7, -7) == 0);
    assert(saturating_add_i64(7, -1) == 6);
    assert(saturating_add_i64(7, 0) == 7);
    assert(saturating_add_i64(7, 1) == 8);
    assert(saturating_add_i64(7, 7) == 14);
    assert(saturating_add_i64(7, I64_MAX) == I64_MAX);
    assert(saturating_add_i64(I64_MAX, I64_MIN) == -1);
    assert(saturating_add_i64(I64_MAX, -7) == 9223372036854775800);
    assert(saturating_add_i64(I64_MAX, -1) == 9223372036854775806);
    assert(saturating_add_i64(I64_MAX, 0) == I64_MAX);
    assert(saturating_add_i64(I64_MAX, 1) == I64_MAX);
    assert(saturating_add_i64(I64_MAX, 7) == I64_MAX);
    assert(saturating_add_i64(I64_MAX, I64_MAX) == I64_MAX);
    assert(saturating_sub_i64(I64_MIN, I64_MIN) == 0);
    assert(saturating_sub_i64(I64_MIN, -7) == -9223372036854775801);
    assert(saturating_sub_i64(I64_MIN, -1) == -9223372036854775807);
    assert(saturating_sub_i64(I64_MIN, 0) == I64_MIN);
    assert(saturating_sub_i64(I64_MIN, 1) == I64_MIN);
    assert(saturating_sub_i64(I64_MIN, 7) == I64_MIN);
    assert(saturating_sub_i64(I64_MIN, I64_MAX) == I64_MIN);
    assert(saturating_sub_i64(-7, I64_MIN) == 9223372036854775801);
    assert(saturating_sub_i64(-7, -7) == 0);
    assert(saturating_sub_i64(-7, -1) == -6);
    assert(saturating_sub_i64(-7, 0) == -7);
    assert(saturating_sub_i64(-7, 1) == -8);
    assert(saturating_sub_i64(-7, 7) == -14);
    assert(saturating_sub_i64(-7, I64_MAX) == I64_MIN);
    assert(saturating_sub_i64(-1, I64_MIN) == I64_MAX);
    assert(saturating_sub_i64(-1, -7) == 6);
    assert(saturating_sub_i64(-1, -1) == 0);
    assert(saturating_sub_i64(-1, 0) == -1);
    assert(saturating_sub_i64(-1, 1) == -2);
    assert(saturating_sub_i64(-1, 7) == -8);
    assert(saturating_sub_i64(-1, I64_MAX) == I64_MIN);
    assert(saturating_sub_i64(0, I64_MIN) == I64_MAX);
    assert(saturating_sub_i64(0, -7) == 7);
    assert(saturating_sub_i64(0, -1) == 1);
    assert(saturating_sub_i64(0, 0) == 0);
    assert(saturating_sub_i64(0, 1) == -1);
    assert(saturating_sub_i64(0, 7) == -7);
    assert(saturating_sub_i64(0, I64_MAX) == -9223372036854775807);
    assert(saturating_sub_i64(1, I64_MIN) == I64_MAX);
    assert(saturating_sub_i64(1, -7) == 8);
    assert(saturating_sub_i64(1, -1) == 2);
    assert(saturating_sub_i64(1, 0) == 1);
    assert(saturating_sub_i64(1, 1) == 0);
    assert(saturating_sub_i64(1, 7) == -6);
    assert(saturating_sub_i64(1, I64_MAX) == -9223372036854775806);
    assert(saturating_sub_i64(7, I64_MIN) == I64_MAX);
    assert(saturating_sub_i64(7, -7) == 14);
    assert(saturating_sub_i64(7, -1) == 8);
    assert(saturating_sub_i64(7, 0) == 7);
    assert(saturating_sub_i64(7, 1) == 6);
    assert(saturating_sub_i64(7, 7) == 0);
    assert(saturating_sub_i64(7, I64_MAX) == -9223372036854775800);
    assert(saturating_sub_i64(I64_MAX, I64_MIN) == I64_MAX);
    assert(saturating_sub_i64(I64_MAX, -7) == I64_MAX);
    assert(saturating_sub_i64(I64_MAX, -1) == I64_MAX);
    assert(saturating_sub_i64(I64_MAX, 0) == I64_MAX);
    assert(saturating_sub_i64(I64_MAX, 1) == 9223372036854775806);
    assert(saturating_sub_i64(I64_MAX, 7) == 9223372036854775800);
    assert(saturating_sub_i64(I64_MAX, I64_MAX) == 0);
    assert(saturating_mul_i64(I64_MIN, I64_MIN) == I64_MAX);
    assert(saturating_mul_i64(I64_MIN, -7) == I64_MAX);
    assert(saturating_mul_i64(I64_MIN, -1) == I64_MAX);
    assert(saturating_mul_i64(I64_MIN, 0) == 0);
    assert(saturating_mul_i64(I64_MIN, 1) == I64_MIN);
    assert(saturating_mul_i64(I64_MIN, 7) == I64_MIN);
    assert(saturating_mul_i64(I64_MIN, I64_MAX) == I64_MIN);
    assert(saturating_mul_i64(-7, I64_MIN) == I64_MAX);
    assert(saturating_mul_i64(-7, -7) == 49);
    assert(saturating_mul_i64(-7, -1) == 7);
    assert(saturating_mul_i64(-7, 0) == 0);
    assert(saturating_mul_i64(-7, 1) == -7);
    assert(saturating_mul_i64(-7, 7) == -49);
    assert(saturating_mul_i64(-7, I64_MAX) == I64_MIN);
    assert(saturating_mul_i64(-1, I64_MIN) == I64_MAX);
    assert(saturating_mul_i64(-1, -7) == 7);
    assert(saturating_mul_i64(-1, -1) == 1);
    assert(saturating_mul_i64(-1, 0) == 0);
    assert(saturating_mul_i64(-1, 1) == -1);
    assert(saturating_mul_i64(-1, 7) == -7);
    assert(saturating_mul_i64(-1, I64_MAX) == -9223372036854775807);
    assert(saturating_mul_i64(0, I64_MIN) == 0);
    assert(saturating_mul_i64(0, -7) == 0);
    assert(saturating_mul_i64(0, -1) == 0);
    assert(saturating_mul_i64(0, 0) == 0);
    assert(saturating_mul_i64(0, 1) == 0);
    assert(saturating_mul_i64(0, 7) == 0);
    assert(saturating_mul_i64(0, I64_MAX) == 0);
    assert(saturating_mul_i64(1, I64_MIN) == I64_MIN);
    assert(saturating_mul_i64(1, -7) == -7);
    assert(saturating_mul_i64(1, -1) == -1);
    assert(saturating_mul_i64(1, 0) == 0);
    assert(saturating_mul_i64(1, 1) == 1);
    assert(saturating_mul_i64(1, 7) == 7);
    assert(saturating_mul_i64(1, I64_MAX) == I64_MAX);
    assert(saturating_mul_i64(7, I64_MIN) == I64_MIN);
    assert(saturating_mul_i64(7, -7) == -49);
    assert(saturating_mul_i64(7, -1) == -7);
    assert(saturating_mul_i64(7, 0) == 0);
    assert(saturating_mul_i64(7, 1) == 7);
    assert(saturating_mul_i64(7, 7) == 49);
    assert(saturating_mul_i64(7, I64_MAX) == I64_MAX);
    assert(saturating_mul_i64(I64_MAX, I64_MIN) == I64_MIN);
    assert(saturating_mul_i64(I64_MAX, -7) == I64_MIN);
    assert(saturating_mul_i64(I64_MAX, -1) == -9223372036854775807);
    assert(saturating_mul_i64(I64_MAX, 0) == 0);
    assert(saturating_mul_i64(I64_MAX, 1) == I64_MAX);
    assert(saturating_mul_i64(I64_MAX, 7) == I64_MAX);
    assert(saturating_mul_i64(I64_MAX, I64_MAX) == I64_MAX);
}

