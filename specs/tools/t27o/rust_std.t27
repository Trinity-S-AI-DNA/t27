    assert(saturating_mul_u64(9223372036854775808, 18446744073709551615) == 18446744073709551615);
    assert(saturating_mul_u64(18446744073709551615, 0) == 0);
    assert(saturating_mul_u64(18446744073709551615, 1) == 18446744073709551615);
    assert(saturating_mul_u64(18446744073709551615, 7) == 18446744073709551615);
    assert(saturating_mul_u64(18446744073709551615, 4294967296) == 18446744073709551615);
    assert(saturating_mul_u64(18446744073709551615, 9223372036854775808) == 18446744073709551615);
    assert(saturating_mul_u64(18446744073709551615, 18446744073709551615) == 18446744073709551615);
}

