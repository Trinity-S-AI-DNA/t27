/// saturating_add / sub / mul of i16: every expected value was printed by rustc 1.99 running the method on the same
/// inputs; the grid is the edge values taken pairwise, so the clamp-up, clamp-down and exact paths are all reached.
test std_saturating_arithmetic_of_i16_is_rusts {
    assert(saturating_add_i16(-32768, -32768) == -32768);
    assert(saturating_add_i16(-32768, -7) == -32768);
    assert(saturating_add_i16(-32768, -1) == -32768);
    assert(saturating_add_i16(-32768, 0) == -32768);
    assert(saturating_add_i16(-32768, 1) == -32767);
    assert(saturating_add_i16(-32768, 7) == -32761);
    assert(saturating_add_i16(-32768, 32767) == -1);
    assert(saturating_add_i16(-7, -32768) == -32768);
    assert(saturating_add_i16(-7, -7) == -14);
    assert(saturating_add_i16(-7, -1) == -8);
    assert(saturating_add_i16(-7, 0) == -7);
    assert(saturating_add_i16(-7, 1) == -6);
    assert(saturating_add_i16(-7, 7) == 0);
    assert(saturating_add_i16(-7, 32767) == 32760);
    assert(saturating_add_i16(-1, -32768) == -32768);
    assert(saturating_add_i16(-1, -7) == -8);
    assert(saturating_add_i16(-1, -1) == -2);
    assert(saturating_add_i16(-1, 0) == -1);
    assert(saturating_add_i16(-1, 1) == 0);
    assert(saturating_add_i16(-1, 7) == 6);
    assert(saturating_add_i16(-1, 32767) == 32766);
    assert(saturating_add_i16(0, -32768) == -32768);
    assert(saturating_add_i16(0, -7) == -7);
    assert(saturating_add_i16(0, -1) == -1);
    assert(saturating_add_i16(0, 0) == 0);
    assert(saturating_add_i16(0, 1) == 1);
    assert(saturating_add_i16(0, 7) == 7);
    assert(saturating_add_i16(0, 32767) == 32767);
    assert(saturating_add_i16(1, -32768) == -32767);
    assert(saturating_add_i16(1, -7) == -6);
    assert(saturating_add_i16(1, -1) == 0);
    assert(saturating_add_i16(1, 0) == 1);
    assert(saturating_add_i16(1, 1) == 2);
    assert(saturating_add_i16(1, 7) == 8);
    assert(saturating_add_i16(1, 32767) == 32767);
    assert(saturating_add_i16(7, -32768) == -32761);
    assert(saturating_add_i16(7, -7) == 0);
    assert(saturating_add_i16(7, -1) == 6);
    assert(saturating_add_i16(7, 0) == 7);
    assert(saturating_add_i16(7, 1) == 8);
    assert(saturating_add_i16(7, 7) == 14);
    assert(saturating_add_i16(7, 32767) == 32767);
    assert(saturating_add_i16(32767, -32768) == -1);
    assert(saturating_add_i16(32767, -7) == 32760);
    assert(saturating_add_i16(32767, -1) == 32766);
    assert(saturating_add_i16(32767, 0) == 32767);
    assert(saturating_add_i16(32767, 1) == 32767);
    assert(saturating_add_i16(32767, 7) == 32767);
    assert(saturating_add_i16(32767, 32767) == 32767);
    assert(saturating_sub_i16(-32768, -32768) == 0);
    assert(saturating_sub_i16(-32768, -7) == -32761);
