/// Option::unwrap_or and Result::unwrap_or in the converter's inline form `if (r != null) { r.? } else { d }` (t27 has no `orelse`),
/// over the receivers the table makes (parse, find, strip_prefix): every expected value was printed by rustc 1.99 running
/// the Rust call on the same text and default. The receiver is written twice by the form, so it is a pure helper; the form stands alone as a value (a let here).
test std_unwrap_or_is_rusts {
    const r1 : u8 = if (parse_u8("255") != null) { parse_u8("255").? } else { 7 };
    assert(r1 == 255);
    const r2 : u8 = if (parse_u8("256") != null) { parse_u8("256").? } else { 7 };
    assert(r2 == 7);
    const r3 : u8 = if (parse_u8("") != null) { parse_u8("").? } else { 9 };
    assert(r3 == 9);
    const r4 : u16 = if (parse_u16("65535") != null) { parse_u16("65535").? } else { 1 };
    assert(r4 == 65535);
    const r5 : u16 = if (parse_u16("-1") != null) { parse_u16("-1").? } else { 65535 };
    assert(r5 == 65535);
    const r6 : u32 = if (parse_u32("4294967295") != null) { parse_u32("4294967295").? } else { 0 };
    assert(r6 == 4294967295);
    const r7 : u32 = if (parse_u32("4294967296") != null) { parse_u32("4294967296").? } else { 5 };
    assert(r7 == 5);
    const r8 : u64 = if (parse_u64("18446744073709551615") != null) { parse_u64("18446744073709551615").? } else { 0 };
    assert(r8 == 18446744073709551615);
    const r9 : u64 = if (parse_u64("18446744073709551616") != null) { parse_u64("18446744073709551616").? } else { 18446744073709551615 };
    assert(r9 == 18446744073709551615);
    const r10 : usize = if (parse_usize("42") != null) { parse_usize("42").? } else { 0 };
    assert(r10 == 42);
    const r11 : usize = if (parse_usize("4x") != null) { parse_usize("4x").? } else { 3 };
    assert(r11 == 3);
    const r12 : i8 = if (parse_i8("-128") != null) { parse_i8("-128").? } else { 127 };
    assert(r12 == -128);
    const r13 : i8 = if (parse_i8("-129") != null) { parse_i8("-129").? } else { 5 };
    assert(r13 == 5);
    const r14 : i16 = if (parse_i16("+7") != null) { parse_i16("+7").? } else { 0 };
    assert(r14 == 7);
    const r15 : i32 = if (parse_i32("-2147483648") != null) { parse_i32("-2147483648").? } else { 2147483647 };
    assert(r15 == I32_MIN);
    const r16 : i32 = if (parse_i32("2147483648") != null) { parse_i32("2147483648").? } else { I32_MIN };
    assert(r16 == I32_MIN);
    const r17 : i64 = if (parse_i64("-9223372036854775808") != null) { parse_i64("-9223372036854775808").? } else { 5 };
    assert(r17 == I64_MIN);
    const r18 : i64 = if (parse_i64("x") != null) { parse_i64("x").? } else { I64_MIN };
    assert(r18 == I64_MIN);
    const f0 : usize = if (find_byte("abc", 98) != null) { find_byte("abc", 98).? } else { 99 };
    assert(f0 == 1);
    const f1 : usize = if (find_byte("abc", 122) != null) { find_byte("abc", 122).? } else { 99 };
    assert(f1 == 99);
    const f2 : usize = if (find_text("hello", "ll") != null) { find_text("hello", "ll").? } else { 0 };
    assert(f2 == 2);
    const f3 : usize = if (find_text("hello", "lx") != null) { find_text("hello", "lx").? } else { 0 };
    assert(f3 == 0);
    const t0 : []const u8 = if (strip_prefix_text("pub fn", "pub ") != null) { strip_prefix_text("pub fn", "pub ").? } else { "pub fn" };
    assert(type_text::same(t0, "fn"));
    const t1 : []const u8 = if (strip_prefix_text("fn", "pub ") != null) { strip_prefix_text("fn", "pub ").? } else { "fn" };
    assert(type_text::same(t1, "fn"));
    const t2 : []const u8 = if (strip_prefix_text("", "pub ") != null) { strip_prefix_text("", "pub ").? } else { "" };
    assert(type_text::same(t2, ""));
    const t3 : []const u8 = if (strip_prefix_text("pub ", "pub ") != null) { strip_prefix_text("pub ", "pub ").? } else { "pub " };
    assert(type_text::same(t3, ""));
    const t4 : []const u8 = if (strip_prefix_text("x", "") != null) { strip_prefix_text("x", "").? } else { "x" };
    assert(type_text::same(t4, "x"));
    const t5 : []const u8 = if (strip_prefix_byte("-5", 45) != null) { strip_prefix_byte("-5", 45).? } else { "-5" };
    assert(type_text::same(t5, "5"));
    const t6 : []const u8 = if (strip_prefix_byte("5", 45) != null) { strip_prefix_byte("5", 45).? } else { "5" };
    assert(type_text::same(t6, "5"));
    const t7 : []const u8 = if (strip_prefix_byte("--", 45) != null) { strip_prefix_byte("--", 45).? } else { "--" };
    assert(type_text::same(t7, "-"));
}

/// The appends are Rust's own String writes: every expected value below was printed by
/// `format!`/`push` under rustc on the lab, not derived.
test std_appends_are_rusts_string_writes {
    var b : [32]u8 = undefined;
    assert(append_text(b[0 .. 32], 0, "abc") == 3);
    assert(b[0] == 97 and b[1] == 98 and b[2] == 99);
    assert(append_text(b[0 .. 32], 3, "") == 3);
    // U+00E9 (e-acute): 2 bytes, 195 then 169
    assert(append_char(b[0 .. 32], 3, 233) == 5);
    assert(b[3] == 195 and b[4] == 169);
    // newline: 1 byte, kept raw
    assert(append_char(b[0 .. 32], 5, 10) == 6);
    assert(b[5] == 10);
    // U+1F600: 4 bytes, 240 159 152 128
    assert(append_char(b[0 .. 32], 6, 128512) == 10);
    assert(b[6] == 240 and b[7] == 159 and b[8] == 152 and b[9] == 128);
    assert(append_uint(b[0 .. 32], 0, 0) == 1 and b[0] == 48);
    assert(append_uint(b[0 .. 32], 0, 42) == 2 and b[0] == 52 and b[1] == 50);
    // u64's maximum: 20 digits, first 49 (`1`), last 53 (`5`)
    assert(append_uint(b[0 .. 32], 0, 18446744073709551615) == 20);
    assert(b[0] == 49 and b[19] == 53);
    assert(append_int(b[0 .. 32], 0, 0) == 1 and b[0] == 48);
    assert(append_int(b[0 .. 32], 0, -7) == 2 and b[0] == 45 and b[1] == 55);
    // i64's own minimum: `-` then 19 digits, first 57 (`9`), last 56 (`8`)
    var c : [24]u8 = undefined;
    assert(append_int(c[0 .. 24], 0, -9223372036854775807 - 1) == 20);
    assert(c[0] == 45 and c[1] == 57 and c[19] == 56);
    // the pieces compose: "abc" + "!" + 42 + 'z' through one cursor
    var d : [16]u8 = undefined;
    var w : usize = append_text(d[0 .. 16], 0, "abc");
    w = append_char(d[0 .. 16], w, 33);
    w = append_uint(d[0 .. 16], w, 42);
    w = append_char(d[0 .. 16], w, 122);
    assert(w == 7);
    assert(d[0] == 97 and d[3] == 33 and d[4] == 52 and d[5] == 50 and d[6] == 122);
}

/// The trim entries lower to the slice written at the use site -- there is no trim fn to call (a fn
/// returning []const u8 is emitted `-> &'static str`, which a slice of a parameter cannot satisfy).
/// This pins the composition the table emits, on the same vectors as Rust's str::trim.
test std_trim_is_rusts_white_space_trim {
    // trim: s[trim_lo(s, 0, s.len) .. trim_hi(s, trim_lo(s, 0, s.len), s.len)]
    const a7 : []const u8 = "  a b  ";
    const lo : usize = type_text::trim_lo(a7, 0, a7.len);
    assert(type_text::same(a7[lo .. type_text::trim_hi(a7, lo, a7.len)], "a b"));
    const e : []const u8 = "";
    assert(type_text::same(e[type_text::trim_lo(e, 0, e.len) .. type_text::trim_hi(e, type_text::trim_lo(e, 0, e.len), e.len)], ""));
    const one : []const u8 = "a";
    assert(type_text::same(one[type_text::trim_lo(one, 0, one.len) .. type_text::trim_hi(one, type_text::trim_lo(one, 0, one.len), one.len)], "a"));
    const tab : []const u8 = "\t\n x";
    assert(type_text::same(tab[type_text::trim_lo(tab, 0, tab.len) .. type_text::trim_hi(tab, type_text::trim_lo(tab, 0, tab.len), tab.len)], "x"));
    // trim_start: s[trim_lo(s, 0, s.len) .. s.len]
    assert(type_text::same(a7[type_text::trim_lo(a7, 0, a7.len) .. a7.len], "a b  "));
    // trim_end: s[0 .. trim_hi(s, 0, s.len)]
    assert(type_text::same(a7[0 .. type_text::trim_hi(a7, 0, a7.len)], "  a b"));
    // a slice input, not only a literal, trims the same
    const cut : []const u8 = "z  q  z";
    const inner : []const u8 = cut[1 .. 6];
    assert(type_text::same(inner[type_text::trim_lo(inner, 0, inner.len) .. type_text::trim_hi(inner, type_text::trim_lo(inner, 0, inner.len), inner.len)], "q"));
}

test std_ascii_classes_and_chars_all {
    assert(alnum(48) and alnum(57) and alnum(97) and alnum(122) and alnum(65) and alnum(90));
    assert(!alnum(64) and !alnum(95) and !alnum(47) and !alnum(123));
    assert(chars_all_digit(""));
    assert(chars_all_digit("012"));
    assert(!chars_all_digit("01a"));
    assert(!chars_all_digit(" 1"));
    assert(chars_all_word(""));
    assert(chars_all_word("a1_"));
    assert(!chars_all_word("a-b"));
    assert(!chars_all_word("@@"));
}

test std_find_is_rusts_byte_index {
    assert(find_byte("ab]cd]", 93).? == 2);
    assert(find_byte("abc", 93) == null);
    assert(find_byte("xx", 120).? == 0);
    assert(find_byte("", 120) == null);
    assert(find_text("haystack", "ays").? == 1);
    assert(find_text("haystack", "k").? == 7);
    assert(find_text("haystack", "haystacks") == null);
    assert(find_text("", "").? == 0);
    assert(find_text("abc", "").? == 0);
    assert(str_contains("aab", "ab"));
    assert(!str_contains("abc", "ac"));
}

test std_trim_matches_strips_and_leading {
    assert(plant::same_text(trim_start_matches_text("000123", "0"), "123"));
    assert(plant::same_text(trim_start_matches_text("aaab", "a"), "b"));
    assert(plant::same_text(trim_start_matches_text("abc", "z"), "abc"));
    assert(plant::same_text(trim_start_matches_text("", "a"), ""));
    assert(plant::same_text(trim_start_matches_text("xxx", "xx"), "x"));
    assert(plant::same_text(trim_start_matches_byte(",,a", 44), "a"));
    assert(plant::same_text(trim_start_matches_byte("007", 48), "7"));
    assert(plant::same_text(trim_start_matches_byte("abc", 122), "abc"));
    assert(plant::same_text(trim_end_matches_text("path::", "::"), "path"));
    assert(plant::same_text(trim_end_matches_text("1.00", "0"), "1."));
    assert(plant::same_text(trim_end_matches_text("ab", "z"), "ab"));
    assert(plant::same_text(trim_end_matches_byte("a,b,", 44), "a,b"));
    assert(plant::same_text(trim_end_matches_byte("]]", 93), ""));
    assert(plant::same_text(trim_end_matches_byte("abc", 122), "abc"));
}

test std_strip_prefix_suffix_are_option_slices {
    assert(plant::same_text(strip_prefix_text("[]u8", "[]").?, "u8"));
    assert(strip_prefix_text("?T", "[]") == null);
    assert(plant::same_text(strip_prefix_text("abc", "abc").?, ""));
    assert(strip_prefix_text("abc", "abcd") == null);
    assert(plant::same_text(strip_prefix_byte("[i32;", 91).?, "i32;"));
    assert(plant::same_text(strip_prefix_byte("?x", 63).?, "x"));
    assert(strip_prefix_byte("y?", 63) == null);
    assert(plant::same_text(strip_suffix_text("u8[]", "[]").?, "u8"));
    assert(strip_suffix_text("f32", "[]") == null);
    assert(plant::same_text(strip_suffix_text("aa", "a").?, "a"));
    assert(plant::same_text(strip_suffix_byte("x]", 93).?, "x"));
    assert(strip_suffix_byte("xy", 93) == null);
    assert(plant::same_text(strip_suffix_byte("]", 93).?, ""));
    assert(starts_with_byte("abc", 97));
    assert(!starts_with_byte("abc", 98));
    assert(!starts_with_byte("", 97));
    assert(starts_with_digit("0x1F"));
    assert(!starts_with_digit("x1"));
    assert(!starts_with_digit(""));
}

// The helpers the parse_* fns share, and the sums no other test named (t27c coverage: 52 of 59 fns
// before this test, #10522). Each bound is checked on both sides: the largest value that parses and
// the first one that does not.
test std_parse_helpers_and_the_other_sums_named_directly {
    assert(digits_upto("123", 0, 999).? == 123);
    assert(digits_upto("123", 1, 999).? == 23);
    assert(digits_upto("999", 0, 999).? == 999);
    assert(digits_upto("1000", 0, 999) == null);
    assert(digits_upto("12a", 0, 999) == null);
    assert(digits_upto("12", 2, 999) == null);
    assert(parse_unsigned("+42", 100).? == 42);
    assert(parse_unsigned("100", 100).? == 100);
    assert(parse_unsigned("101", 100) == null);
    assert(parse_unsigned("-42", 100) == null);
    assert(parse_unsigned("+", 100) == null);
    assert(parse_signed("-128", 127).? == -128);
    assert(parse_signed("-129", 127) == null);
    assert(parse_signed("+127", 127).? == 127);
    assert(parse_signed("128", 127) == null);
    assert(parse_signed("-", 127) == null);
    assert(parse_signed("-9223372036854775808", 9223372036854775807).? == -9223372036854775807 - 1);
    const a : [3]u64 = [1, 2, 18446744073709551612];
    assert(sum_u64(a[0 .. 3]) == 18446744073709551615);
    assert(sum_u64(a[0 .. 0]) == 0);
    const b : [2]usize = [3, 4];
    assert(sum_usize(b[0 .. 2]) == 7);
    const c : [3]i32 = [-5, 7, -2147483646];
    assert(sum_i32(c[0 .. 3]) == -2147483644);
    const d : [3]f32 = [0.5, 1.25, -2.0];
    assert(sum_f32(d[0 .. 3]) == -0.25);
}
