}

/// f64 sqrt, is_finite and to_bits: every expected value was printed by rustc 1.99 running the method on the same bit
/// pattern (0, -0, +-1, halves, MAX, MIN_POSITIVE, a subnormal, both infinities, quiet and signalling NaNs). A NaN result is
/// tested as NaN (x != x): its sign and payload are the CPU's, not Rust's. Inputs enter through from_bits_f64.
test std_f64_sqrt_is_finite_and_to_bits_are_rusts {
    assert(to_bits_f64(from_bits_f64(0x0000000000000000)) == 0x0000000000000000);
    assert(to_bits_f64(0.0) == 0x0000000000000000);
    assert(is_finite_f64(from_bits_f64(0x0000000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x0000000000000000))) == 0x0000000000000000);
    assert(to_bits_f64(from_bits_f64(0x8000000000000000)) == 0x8000000000000000);
    assert(to_bits_f64(-0.0) == 0x8000000000000000);
    assert(is_finite_f64(from_bits_f64(0x8000000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x8000000000000000))) == 0x8000000000000000);
    assert(to_bits_f64(from_bits_f64(0x3FF0000000000000)) == 0x3FF0000000000000);
    assert(to_bits_f64(1.0) == 0x3FF0000000000000);
    assert(is_finite_f64(from_bits_f64(0x3FF0000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x3FF0000000000000))) == 0x3FF0000000000000);
    assert(to_bits_f64(from_bits_f64(0xBFF0000000000000)) == 0xBFF0000000000000);
    assert(to_bits_f64(-1.0) == 0xBFF0000000000000);
    assert(is_finite_f64(from_bits_f64(0xBFF0000000000000)) == true);
    assert(@sqrt(from_bits_f64(0xBFF0000000000000)) != @sqrt(from_bits_f64(0xBFF0000000000000)));
    assert(to_bits_f64(from_bits_f64(0x3FE0000000000000)) == 0x3FE0000000000000);
    assert(to_bits_f64(0.5) == 0x3FE0000000000000);
    assert(is_finite_f64(from_bits_f64(0x3FE0000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x3FE0000000000000))) == 0x3FE6A09E667F3BCD);
    assert(to_bits_f64(from_bits_f64(0x4000000000000000)) == 0x4000000000000000);
    assert(to_bits_f64(2.0) == 0x4000000000000000);
    assert(is_finite_f64(from_bits_f64(0x4000000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x4000000000000000))) == 0x3FF6A09E667F3BCD);
    assert(to_bits_f64(from_bits_f64(0x3FF8000000000000)) == 0x3FF8000000000000);
    assert(to_bits_f64(1.5) == 0x3FF8000000000000);
    assert(is_finite_f64(from_bits_f64(0x3FF8000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x3FF8000000000000))) == 0x3FF3988E1409212E);
    assert(to_bits_f64(from_bits_f64(0x4059100000000000)) == 0x4059100000000000);
    assert(to_bits_f64(100.25) == 0x4059100000000000);
    assert(is_finite_f64(from_bits_f64(0x4059100000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x4059100000000000))) == 0x4024066560954A8F);
    assert(to_bits_f64(from_bits_f64(0x4010000000000000)) == 0x4010000000000000);
    assert(to_bits_f64(4.0) == 0x4010000000000000);
    assert(is_finite_f64(from_bits_f64(0x4010000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x4010000000000000))) == 0x4000000000000000);
    assert(to_bits_f64(from_bits_f64(0x3FD0000000000000)) == 0x3FD0000000000000);
    assert(to_bits_f64(0.25) == 0x3FD0000000000000);
    assert(is_finite_f64(from_bits_f64(0x3FD0000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x3FD0000000000000))) == 0x3FE0000000000000);
    assert(to_bits_f64(from_bits_f64(0x4014000000000000)) == 0x4014000000000000);
    assert(to_bits_f64(5.0) == 0x4014000000000000);
    assert(is_finite_f64(from_bits_f64(0x4014000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x4014000000000000))) == 0x4001E3779B97F4A8);
    assert(to_bits_f64(from_bits_f64(0x400921FB54442D18)) == 0x400921FB54442D18);
    assert(to_bits_f64(3.141592653589793) == 0x400921FB54442D18);
    assert(is_finite_f64(from_bits_f64(0x400921FB54442D18)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x400921FB54442D18))) == 0x3FFC5BF891B4EF6A);
    assert(to_bits_f64(from_bits_f64(0x7FEFFFFFFFFFFFFF)) == 0x7FEFFFFFFFFFFFFF);
    assert(is_finite_f64(from_bits_f64(0x7FEFFFFFFFFFFFFF)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x7FEFFFFFFFFFFFFF))) == 0x5FEFFFFFFFFFFFFF);
    assert(to_bits_f64(from_bits_f64(0xFFEFFFFFFFFFFFFF)) == 0xFFEFFFFFFFFFFFFF);
    assert(is_finite_f64(from_bits_f64(0xFFEFFFFFFFFFFFFF)) == true);
    assert(@sqrt(from_bits_f64(0xFFEFFFFFFFFFFFFF)) != @sqrt(from_bits_f64(0xFFEFFFFFFFFFFFFF)));
    assert(to_bits_f64(from_bits_f64(0x0010000000000000)) == 0x0010000000000000);
    assert(is_finite_f64(from_bits_f64(0x0010000000000000)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x0010000000000000))) == 0x2000000000000000);
    assert(to_bits_f64(from_bits_f64(0x0000000000000001)) == 0x0000000000000001);
    assert(is_finite_f64(from_bits_f64(0x0000000000000001)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x0000000000000001))) == 0x1E60000000000000);
    assert(to_bits_f64(from_bits_f64(0x000FFFFFFFFFFFFF)) == 0x000FFFFFFFFFFFFF);
    assert(is_finite_f64(from_bits_f64(0x000FFFFFFFFFFFFF)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x000FFFFFFFFFFFFF))) == 0x1FFFFFFFFFFFFFFF);
    assert(to_bits_f64(from_bits_f64(0x7FF0000000000000)) == 0x7FF0000000000000);
    assert(is_finite_f64(from_bits_f64(0x7FF0000000000000)) == false);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x7FF0000000000000))) == 0x7FF0000000000000);
    assert(to_bits_f64(from_bits_f64(0xFFF0000000000000)) == 0xFFF0000000000000);
    assert(is_finite_f64(from_bits_f64(0xFFF0000000000000)) == false);
    assert(@sqrt(from_bits_f64(0xFFF0000000000000)) != @sqrt(from_bits_f64(0xFFF0000000000000)));
    assert(to_bits_f64(from_bits_f64(0x7FF8000000000000)) == 0x7FF8000000000000);
    assert(is_finite_f64(from_bits_f64(0x7FF8000000000000)) == false);
    assert(@sqrt(from_bits_f64(0x7FF8000000000000)) != @sqrt(from_bits_f64(0x7FF8000000000000)));
    assert(to_bits_f64(from_bits_f64(0xFFF8000000000000)) == 0xFFF8000000000000);
    assert(is_finite_f64(from_bits_f64(0xFFF8000000000000)) == false);
    assert(@sqrt(from_bits_f64(0xFFF8000000000000)) != @sqrt(from_bits_f64(0xFFF8000000000000)));
    assert(to_bits_f64(from_bits_f64(0x7FF0000000000001)) == 0x7FF0000000000001);
    assert(is_finite_f64(from_bits_f64(0x7FF0000000000001)) == false);
    assert(@sqrt(from_bits_f64(0x7FF0000000000001)) != @sqrt(from_bits_f64(0x7FF0000000000001)));
    assert(to_bits_f64(from_bits_f64(0x7E37E43C8800759C)) == 0x7E37E43C8800759C);
    assert(is_finite_f64(from_bits_f64(0x7E37E43C8800759C)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x7E37E43C8800759C))) == 0x5F138D352E5096AF);
    assert(to_bits_f64(from_bits_f64(0x1A56E1FC2F8F359C)) == 0x1A56E1FC2F8F359C);
    assert(is_finite_f64(from_bits_f64(0x1A56E1FC2F8F359C)) == true);
    assert(to_bits_f64(@sqrt(from_bits_f64(0x1A56E1FC2F8F359C))) == 0x2D232265FE206D57);
}

/// f32 sqrt, is_finite and to_bits, as above for binary32 (from_bits_f32 builds the input).
test std_f32_sqrt_is_finite_and_to_bits_are_rusts {
    assert(to_bits_f32(from_bits_f32(0x00000000)) == 0x00000000);
    assert(to_bits_f32(0.0) == 0x00000000);
    assert(is_finite_f32(from_bits_f32(0x00000000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x00000000))) == 0x00000000);
    assert(to_bits_f32(from_bits_f32(0x80000000)) == 0x80000000);
    assert(to_bits_f32(-0.0) == 0x80000000);
    assert(is_finite_f32(from_bits_f32(0x80000000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x80000000))) == 0x80000000);
    assert(to_bits_f32(from_bits_f32(0x3F800000)) == 0x3F800000);
    assert(to_bits_f32(1.0) == 0x3F800000);
    assert(is_finite_f32(from_bits_f32(0x3F800000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x3F800000))) == 0x3F800000);
    assert(to_bits_f32(from_bits_f32(0xBF800000)) == 0xBF800000);
    assert(to_bits_f32(-1.0) == 0xBF800000);
    assert(is_finite_f32(from_bits_f32(0xBF800000)) == true);
    assert(@sqrt(from_bits_f32(0xBF800000)) != @sqrt(from_bits_f32(0xBF800000)));
    assert(to_bits_f32(from_bits_f32(0x3F000000)) == 0x3F000000);
    assert(to_bits_f32(0.5) == 0x3F000000);
    assert(is_finite_f32(from_bits_f32(0x3F000000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x3F000000))) == 0x3F3504F3);
    assert(to_bits_f32(from_bits_f32(0x40000000)) == 0x40000000);
    assert(to_bits_f32(2.0) == 0x40000000);
    assert(is_finite_f32(from_bits_f32(0x40000000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x40000000))) == 0x3FB504F3);
    assert(to_bits_f32(from_bits_f32(0x3FC00000)) == 0x3FC00000);
    assert(to_bits_f32(1.5) == 0x3FC00000);
    assert(is_finite_f32(from_bits_f32(0x3FC00000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x3FC00000))) == 0x3F9CC471);
    assert(to_bits_f32(from_bits_f32(0x42C80000)) == 0x42C80000);
    assert(to_bits_f32(100.0) == 0x42C80000);
    assert(is_finite_f32(from_bits_f32(0x42C80000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x42C80000))) == 0x41200000);
    assert(to_bits_f32(from_bits_f32(0x40800000)) == 0x40800000);
    assert(to_bits_f32(4.0) == 0x40800000);
    assert(is_finite_f32(from_bits_f32(0x40800000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x40800000))) == 0x40000000);
    assert(to_bits_f32(from_bits_f32(0x3E800000)) == 0x3E800000);
    assert(to_bits_f32(0.25) == 0x3E800000);
    assert(is_finite_f32(from_bits_f32(0x3E800000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x3E800000))) == 0x3F000000);
    assert(to_bits_f32(from_bits_f32(0x40A00000)) == 0x40A00000);
    assert(to_bits_f32(5.0) == 0x40A00000);
    assert(is_finite_f32(from_bits_f32(0x40A00000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x40A00000))) == 0x400F1BBD);
    assert(to_bits_f32(from_bits_f32(0x40490FDB)) == 0x40490FDB);
    assert(is_finite_f32(from_bits_f32(0x40490FDB)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x40490FDB))) == 0x3FE2DFC5);
    assert(to_bits_f32(from_bits_f32(0x7F7FFFFF)) == 0x7F7FFFFF);
    assert(is_finite_f32(from_bits_f32(0x7F7FFFFF)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x7F7FFFFF))) == 0x5F7FFFFF);
    assert(to_bits_f32(from_bits_f32(0xFF7FFFFF)) == 0xFF7FFFFF);
    assert(is_finite_f32(from_bits_f32(0xFF7FFFFF)) == true);
    assert(@sqrt(from_bits_f32(0xFF7FFFFF)) != @sqrt(from_bits_f32(0xFF7FFFFF)));
    assert(to_bits_f32(from_bits_f32(0x00800000)) == 0x00800000);
    assert(is_finite_f32(from_bits_f32(0x00800000)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x00800000))) == 0x20000000);
    assert(to_bits_f32(from_bits_f32(0x00000001)) == 0x00000001);
    assert(is_finite_f32(from_bits_f32(0x00000001)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x00000001))) == 0x1A3504F3);
    assert(to_bits_f32(from_bits_f32(0x007FFFFF)) == 0x007FFFFF);
    assert(is_finite_f32(from_bits_f32(0x007FFFFF)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x007FFFFF))) == 0x1FFFFFFF);
    assert(to_bits_f32(from_bits_f32(0x7F800000)) == 0x7F800000);
    assert(is_finite_f32(from_bits_f32(0x7F800000)) == false);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x7F800000))) == 0x7F800000);
    assert(to_bits_f32(from_bits_f32(0xFF800000)) == 0xFF800000);
    assert(is_finite_f32(from_bits_f32(0xFF800000)) == false);
    assert(@sqrt(from_bits_f32(0xFF800000)) != @sqrt(from_bits_f32(0xFF800000)));
    assert(to_bits_f32(from_bits_f32(0x7FC00000)) == 0x7FC00000);
    assert(is_finite_f32(from_bits_f32(0x7FC00000)) == false);
    assert(@sqrt(from_bits_f32(0x7FC00000)) != @sqrt(from_bits_f32(0x7FC00000)));
    assert(to_bits_f32(from_bits_f32(0xFFC00000)) == 0xFFC00000);
    assert(is_finite_f32(from_bits_f32(0xFFC00000)) == false);
    assert(@sqrt(from_bits_f32(0xFFC00000)) != @sqrt(from_bits_f32(0xFFC00000)));
    assert(to_bits_f32(from_bits_f32(0x7F800001)) == 0x7F800001);
    assert(is_finite_f32(from_bits_f32(0x7F800001)) == false);
    assert(@sqrt(from_bits_f32(0x7F800001)) != @sqrt(from_bits_f32(0x7F800001)));
    assert(to_bits_f32(from_bits_f32(0x7149F2CA)) == 0x7149F2CA);
    assert(is_finite_f32(from_bits_f32(0x7149F2CA)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x7149F2CA))) == 0x58635FA9);
    assert(to_bits_f32(from_bits_f32(0x0DA24260)) == 0x0DA24260);
    assert(is_finite_f32(from_bits_f32(0x0DA24260)) == true);
    assert(to_bits_f32(@sqrt(from_bits_f32(0x0DA24260))) == 0x26901D7D);
}

/// ASCII methods: every expected value was printed by rustc 1.99 running the method on the same input. The bytes are the
/// edges of the letter ranges (63, 64, 65, 90, 91, 96, 97, 122, 123), a digit, control, DEL (127) and the first and last byte
/// above 127; then all 256 bytes at once through a checksum (the sum of (b + 1) * f(b), as u64), which rustc printed too.
test std_ascii_methods_are_rusts {
    assert(is_ascii_u8(0) == true);
    assert(to_ascii_lowercase_u8(0) == 0);
    assert(to_ascii_uppercase_u8(0) == 0);
    assert(is_ascii_u8(9) == true);
    assert(to_ascii_lowercase_u8(9) == 9);
    assert(to_ascii_uppercase_u8(9) == 9);
    assert(is_ascii_u8(32) == true);
    assert(to_ascii_lowercase_u8(32) == 32);
    assert(to_ascii_uppercase_u8(32) == 32);
    assert(is_ascii_u8(47) == true);
    assert(to_ascii_lowercase_u8(47) == 47);
    assert(to_ascii_uppercase_u8(47) == 47);
    assert(is_ascii_u8(48) == true);
    assert(to_ascii_lowercase_u8(48) == 48);
    assert(to_ascii_uppercase_u8(48) == 48);
    assert(is_ascii_u8(57) == true);
    assert(to_ascii_lowercase_u8(57) == 57);
    assert(to_ascii_uppercase_u8(57) == 57);
    assert(is_ascii_u8(63) == true);
    assert(to_ascii_lowercase_u8(63) == 63);
    assert(to_ascii_uppercase_u8(63) == 63);
    assert(is_ascii_u8(64) == true);
    assert(to_ascii_lowercase_u8(64) == 64);
    assert(to_ascii_uppercase_u8(64) == 64);
    assert(is_ascii_u8(65) == true);
    assert(to_ascii_lowercase_u8(65) == 97);
    assert(to_ascii_uppercase_u8(65) == 65);
    assert(is_ascii_u8(90) == true);
    assert(to_ascii_lowercase_u8(90) == 122);
    assert(to_ascii_uppercase_u8(90) == 90);
    assert(is_ascii_u8(91) == true);
    assert(to_ascii_lowercase_u8(91) == 91);
    assert(to_ascii_uppercase_u8(91) == 91);
    assert(is_ascii_u8(96) == true);
    assert(to_ascii_lowercase_u8(96) == 96);
    assert(to_ascii_uppercase_u8(96) == 96);
    assert(is_ascii_u8(97) == true);
    assert(to_ascii_lowercase_u8(97) == 97);
    assert(to_ascii_uppercase_u8(97) == 65);
    assert(is_ascii_u8(122) == true);
    assert(to_ascii_lowercase_u8(122) == 122);
    assert(to_ascii_uppercase_u8(122) == 90);
    assert(is_ascii_u8(123) == true);
    assert(to_ascii_lowercase_u8(123) == 123);
    assert(to_ascii_uppercase_u8(123) == 123);
    assert(is_ascii_u8(127) == true);
    assert(to_ascii_lowercase_u8(127) == 127);
    assert(to_ascii_uppercase_u8(127) == 127);
    assert(is_ascii_u8(128) == false);
    assert(to_ascii_lowercase_u8(128) == 128);
    assert(to_ascii_uppercase_u8(128) == 128);
    assert(is_ascii_u8(255) == false);
    assert(to_ascii_lowercase_u8(255) == 255);
    assert(to_ascii_uppercase_u8(255) == 255);
    var s_is : u64 = 0;
    var s_lo : u64 = 0;
    var s_up : u64 = 0;
    var n_ascii : u64 = 0;
    var b : u16 = 0;
    while (b < 256) {
        const x : u8 = b as u8;
        if (is_ascii_u8(x)) { s_is = s_is + ((b as u64) + 1); n_ascii = n_ascii + 1; }
        s_lo = s_lo + ((b as u64) + 1) * (to_ascii_lowercase_u8(x) as u64);
        s_up = s_up + ((b as u64) + 1) * (to_ascii_uppercase_u8(x) as u64);
        b = b + 1;
    }
    assert(n_ascii == 128);
    assert(s_is == 8256);
    assert(s_lo == 5657632);
    assert(s_up == 5500384);
    assert(is_ascii_text("") == true);
    assert(is_ascii_text("a") == true);
    assert(is_ascii_text("Hello, world 0123456789 ~") == true);
    const t1 : [4]u8 = [104, 105, 127, 10];
    assert(is_ascii_text(t1[0 .. 4]) == true);
    const t2 : [3]u8 = [104, 128, 105];
    assert(is_ascii_text(t2[0 .. 3]) == false);
    const t3 : [3]u8 = [104, 105, 255];
    assert(is_ascii_text(t3[0 .. 3]) == false);
    const t4 : [1]u8 = [128];
    assert(is_ascii_text(t4[0 .. 1]) == false);
    assert(is_ascii_text(t2[0 .. 1]) == true);
    assert(is_ascii_text(t2[0 .. 0]) == true);
}

/// [u8]::get(i): every expected value was printed by rustc 1.99 running `a.get(i)` on the same array, for an index in range, at the
/// last element, one past it, far past it and usize::MAX; an empty slice answers None for 0.
test std_get_of_u8_is_rusts {
    const a : [5]u8 = [0, 1, 127, 128, 255];
    assert(get_u8(a[0 .. 5], 0).? == 0);
    assert(get_u8(a[0 .. 5], 1).? == 1);
    assert(get_u8(a[0 .. 5], 2).? == 127);
    assert(get_u8(a[0 .. 5], 4).? == 255);
    assert(get_u8(a[0 .. 5], 5) == null);
    assert(get_u8(a[0 .. 5], 6) == null);
    assert(get_u8(a[0 .. 5], 1000) == null);
    assert(get_u8(a[0 .. 5], 18446744073709551615) == null);
    assert(get_u8(a[0 .. 0], 0) == null);
}

