    assert(saturating_mul_i16(0, 1) == 0);
    assert(saturating_mul_i16(0, 7) == 0);
    assert(saturating_mul_i16(0, 32767) == 0);
    assert(saturating_mul_i16(1, -32768) == -32768);
    assert(saturating_mul_i16(1, -7) == -7);
    assert(saturating_mul_i16(1, -1) == -1);
    assert(saturating_mul_i16(1, 0) == 0);
    assert(saturating_mul_i16(1, 1) == 1);
    assert(saturating_mul_i16(1, 7) == 7);
