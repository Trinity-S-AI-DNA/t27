    assert(checked_sub_u32(4294967295, 7).? == 4294967288);
    assert(checked_mul_u32(4294967295, 7) == null);
    assert(checked_add_u32(4294967295, 65536) == null);
    assert(checked_sub_u32(4294967295, 65536).? == 4294901759);
