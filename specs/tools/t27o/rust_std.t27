    assert(saturating_sub_i16(32767, -1) == 32767);
    assert(saturating_sub_i16(32767, 0) == 32767);
    assert(saturating_sub_i16(32767, 1) == 32766);
    assert(saturating_sub_i16(32767, 7) == 32760);
    assert(saturating_sub_i16(32767, 32767) == 0);
    assert(saturating_mul_i16(-32768, -32768) == 32767);
    assert(saturating_mul_i16(-32768, -7) == 32767);
    assert(saturating_mul_i16(-32768, -1) == 32767);
    assert(saturating_mul_i16(-32768, 0) == 0);
    assert(saturating_mul_i16(-32768, 1) == -32768);
    assert(saturating_mul_i16(-32768, 7) == -32768);
    assert(saturating_mul_i16(-32768, 32767) == -32768);
    assert(saturating_mul_i16(-7, -32768) == 32767);
    assert(saturating_mul_i16(-7, -7) == 49);
    assert(saturating_mul_i16(-7, -1) == 7);
    assert(saturating_mul_i16(-7, 0) == 0);
    assert(saturating_mul_i16(-7, 1) == -7);
    assert(saturating_mul_i16(-7, 7) == -49);
    assert(saturating_mul_i16(-7, 32767) == -32768);
    assert(saturating_mul_i16(-1, -32768) == 32767);
