/// saturating_add / sub / mul of u16: every expected value was printed by rustc 1.99 running the method on the same
/// inputs; the grid is the edge values taken pairwise, so the clamp-up, clamp-down and exact paths are all reached.
test std_saturating_arithmetic_of_u16_is_rusts {
    assert(saturating_add_u16(0, 0) == 0);
    assert(saturating_add_u16(0, 1) == 1);
    assert(saturating_add_u16(0, 7) == 7);
    assert(saturating_add_u16(0, 32768) == 32768);
    assert(saturating_add_u16(0, 65534) == 65534);
    assert(saturating_add_u16(0, 65535) == 65535);
    assert(saturating_add_u16(1, 0) == 1);
    assert(saturating_add_u16(1, 1) == 2);
    assert(saturating_add_u16(1, 7) == 8);
    assert(saturating_add_u16(1, 32768) == 32769);
