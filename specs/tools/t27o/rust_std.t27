    assert(leading_zeros_i64(-9223372036854775807) == 0);
    assert(leading_zeros_i64(4294967296) == 31);
    assert(leading_zeros_i64(-4294967296) == 0);
    assert(leading_zeros_i64(6148914691236517205) == 1);
    assert(leading_zeros_i64(-6148914691236517206) == 0);
    assert(leading_zeros_i64(48) == 58);
    assert(trailing_zeros_i64(0) == 64);
    assert(trailing_zeros_i64(1) == 0);
    assert(trailing_zeros_i64(-1) == 0);
    assert(trailing_zeros_i64(2) == 1);
    assert(trailing_zeros_i64(-2) == 1);
    assert(trailing_zeros_i64(9223372036854775807) == 0);
    assert(trailing_zeros_i64(I64_MIN) == 63);
    assert(trailing_zeros_i64(-9223372036854775807) == 0);
    assert(trailing_zeros_i64(4294967296) == 32);
    assert(trailing_zeros_i64(-4294967296) == 32);
    assert(trailing_zeros_i64(6148914691236517205) == 0);
    assert(trailing_zeros_i64(-6148914691236517206) == 1);
    assert(trailing_zeros_i64(48) == 4);
}

/// pow of u8: every expected value was printed by rustc 1.99 running `x.pow(e)` on the same inputs; the pairs
/// that overflow are not vectors (a debug build panics on them), the ones kept are those `checked_pow` answers,
/// up to the largest result the type holds.
test std_pow_of_u8_is_rusts {
    assert(pow_u8(0, 0) == 1);
