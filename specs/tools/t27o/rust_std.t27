    assert(checked_sub_i64(9223372036854775807, -1) == null);
    assert(checked_mul_i64(9223372036854775807, -1).? == -9223372036854775807);
    assert(checked_add_i64(9223372036854775807, 3037000500) == null);
    assert(checked_sub_i64(9223372036854775807, 3037000500).? == 9223372033817775307);
    assert(checked_mul_i64(9223372036854775807, 3037000500) == null);
    assert(checked_add_i64(9223372036854775807, 9223372036854775807) == null);
    assert(checked_sub_i64(9223372036854775807, 9223372036854775807).? == 0);
    assert(checked_mul_i64(9223372036854775807, 9223372036854775807) == null);
    assert(checked_add_i64(9223372036854775807, I64_MIN).? == -1);
    assert(checked_sub_i64(9223372036854775807, I64_MIN) == null);
    assert(checked_mul_i64(9223372036854775807, I64_MIN) == null);
    assert(checked_add_i64(I64_MIN, 0).? == I64_MIN);
    assert(checked_sub_i64(I64_MIN, 0).? == I64_MIN);
    assert(checked_mul_i64(I64_MIN, 0).? == 0);
    assert(checked_add_i64(I64_MIN, -1) == null);
    assert(checked_sub_i64(I64_MIN, -1).? == -9223372036854775807);
    assert(checked_mul_i64(I64_MIN, -1) == null);
    assert(checked_add_i64(I64_MIN, 3037000500).? == -9223372033817775308);
    assert(checked_sub_i64(I64_MIN, 3037000500) == null);
    assert(checked_mul_i64(I64_MIN, 3037000500) == null);
    assert(checked_add_i64(I64_MIN, 9223372036854775807).? == -1);
    assert(checked_sub_i64(I64_MIN, 9223372036854775807) == null);
    assert(checked_mul_i64(I64_MIN, 9223372036854775807) == null);
    assert(checked_add_i64(I64_MIN, I64_MIN) == null);
    assert(checked_sub_i64(I64_MIN, I64_MIN).? == 0);
    assert(checked_mul_i64(I64_MIN, I64_MIN) == null);
}

/// Bit counts: the three methods count the same pattern of an integer of each width (count_ones_*,
/// leading_zeros_*, trailing_zeros_*), every expected value printed by rustc 1.99 on the same inputs.
/// Edge values per width: 0, 1, 2, the highest bit alone, all ones, MIN / MAX, -1, an alternating pattern.
test std_bit_counts_are_rusts {
    // u8
    assert(count_ones_u8(0) == 0);
    assert(count_ones_u8(1) == 1);
    assert(count_ones_u8(2) == 1);
    assert(count_ones_u8(3) == 2);
    assert(count_ones_u8(7) == 3);
    assert(count_ones_u8(8) == 1);
    assert(count_ones_u8(16) == 1);
    assert(count_ones_u8(85) == 4);
    assert(count_ones_u8(127) == 7);
    assert(count_ones_u8(128) == 1);
    assert(count_ones_u8(170) == 4);
    assert(count_ones_u8(254) == 7);
    assert(count_ones_u8(255) == 8);
    assert(count_ones_u8(96) == 2);
    assert(leading_zeros_u8(0) == 8);
    assert(leading_zeros_u8(1) == 7);
    assert(leading_zeros_u8(2) == 6);
    assert(leading_zeros_u8(3) == 6);
    assert(leading_zeros_u8(7) == 5);
    assert(leading_zeros_u8(8) == 4);
    assert(leading_zeros_u8(16) == 3);
    assert(leading_zeros_u8(85) == 1);
    assert(leading_zeros_u8(127) == 1);
    assert(leading_zeros_u8(128) == 0);
    assert(leading_zeros_u8(170) == 0);
    assert(leading_zeros_u8(254) == 0);
    assert(leading_zeros_u8(255) == 0);
    assert(leading_zeros_u8(96) == 1);
    assert(trailing_zeros_u8(0) == 8);
    assert(trailing_zeros_u8(1) == 0);
    assert(trailing_zeros_u8(2) == 1);
    assert(trailing_zeros_u8(3) == 0);
    assert(trailing_zeros_u8(7) == 0);
    assert(trailing_zeros_u8(8) == 3);
    assert(trailing_zeros_u8(16) == 4);
    assert(trailing_zeros_u8(85) == 0);
    assert(trailing_zeros_u8(127) == 0);
    assert(trailing_zeros_u8(128) == 7);
    assert(trailing_zeros_u8(170) == 1);
    assert(trailing_zeros_u8(254) == 1);
    assert(trailing_zeros_u8(255) == 0);
    assert(trailing_zeros_u8(96) == 5);
    // u16
    assert(count_ones_u16(0) == 0);
    assert(count_ones_u16(1) == 1);
    assert(count_ones_u16(2) == 1);
    assert(count_ones_u16(255) == 8);
    assert(count_ones_u16(256) == 1);
    assert(count_ones_u16(4096) == 1);
    assert(count_ones_u16(21845) == 8);
    assert(count_ones_u16(32767) == 15);
    assert(count_ones_u16(32768) == 1);
    assert(count_ones_u16(43690) == 8);
    assert(count_ones_u16(65534) == 15);
    assert(count_ones_u16(65535) == 16);
    assert(count_ones_u16(24576) == 2);
    assert(leading_zeros_u16(0) == 16);
    assert(leading_zeros_u16(1) == 15);
    assert(leading_zeros_u16(2) == 14);
    assert(leading_zeros_u16(255) == 8);
    assert(leading_zeros_u16(256) == 7);
    assert(leading_zeros_u16(4096) == 3);
    assert(leading_zeros_u16(21845) == 1);
    assert(leading_zeros_u16(32767) == 1);
    assert(leading_zeros_u16(32768) == 0);
    assert(leading_zeros_u16(43690) == 0);
    assert(leading_zeros_u16(65534) == 0);
    assert(leading_zeros_u16(65535) == 0);
    assert(leading_zeros_u16(24576) == 1);
    assert(trailing_zeros_u16(0) == 16);
    assert(trailing_zeros_u16(1) == 0);
    assert(trailing_zeros_u16(2) == 1);
    assert(trailing_zeros_u16(255) == 0);
    assert(trailing_zeros_u16(256) == 8);
    assert(trailing_zeros_u16(4096) == 12);
    assert(trailing_zeros_u16(21845) == 0);
    assert(trailing_zeros_u16(32767) == 0);
    assert(trailing_zeros_u16(32768) == 15);
