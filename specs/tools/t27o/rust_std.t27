/// [u16]::contains(&x): every expected value was printed by rustc 1.99 running `a.contains(&x)` on the same array, for a
/// member (first, middle, last), a non-member and the neighbours of the edge values; the empty slice contains nothing.
test std_contains_of_u16_is_rusts {
    const a : [4]u16 = [7, 0, 65535, 300];
    assert(contains_u16(a[0 .. 4], 7) == true);
    assert(contains_u16(a[0 .. 4], 0) == true);
    assert(contains_u16(a[0 .. 4], 65535) == true);
    assert(contains_u16(a[0 .. 4], 300) == true);
    assert(contains_u16(a[0 .. 4], 1) == false);
    assert(contains_u16(a[0 .. 4], 299) == false);
    assert(contains_u16(a[0 .. 4], 301) == false);
    assert(contains_u16(a[0 .. 4], 32768) == false);
    assert(contains_u16(a[0 .. 0], 7) == false);
}

