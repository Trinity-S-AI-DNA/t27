/// [f32]::contains(&x): every expected value was printed by rustc 1.99 running `a.contains(&x)` on the same array, for a
/// member (first, middle, last), a non-member and the neighbours of the edge values; the empty slice contains nothing.
test std_contains_of_f32_is_rusts {
    const a : [4]f32 = [1.5, 0.0, -2.25, 100.0];
    assert(contains_f32(a[0 .. 4], 1.5) == true);
    assert(contains_f32(a[0 .. 4], 0.0) == true);
    assert(contains_f32(a[0 .. 4], -0.0) == true);
    assert(contains_f32(a[0 .. 4], -2.25) == true);
    assert(contains_f32(a[0 .. 4], 100.0) == true);
    assert(contains_f32(a[0 .. 4], 1.25) == false);
    assert(contains_f32(a[0 .. 4], 3.5) == false);
    assert(contains_f32(a[0 .. 0], 1.5) == false);
    const nan : f32 = from_bits_f32(0x7FC00000);
    const b : [2]f32 = [1.5, nan];
    assert(contains_f32(b[0 .. 2], nan) == false);
    assert(contains_f32(a[0 .. 4], nan) == false);
}

/// [f64]::contains(&x): every expected value was printed by rustc 1.99 running `a.contains(&x)` on the same array, for a
/// member (first, middle, last), a non-member and the neighbours of the edge values; the empty slice contains nothing.
test std_contains_of_f64_is_rusts {
    const a : [4]f64 = [1.5, 0.0, -2.25, 100.0];
    assert(contains_f64(a[0 .. 4], 1.5) == true);
    assert(contains_f64(a[0 .. 4], 0.0) == true);
    assert(contains_f64(a[0 .. 4], -0.0) == true);
    assert(contains_f64(a[0 .. 4], -2.25) == true);
    assert(contains_f64(a[0 .. 4], 100.0) == true);
    assert(contains_f64(a[0 .. 4], 1.25) == false);
    assert(contains_f64(a[0 .. 4], 3.5) == false);
    assert(contains_f64(a[0 .. 0], 1.5) == false);
    const nan : f64 = from_bits_f64(0x7FF8000000000000);
    const b : [2]f64 = [1.5, nan];
    assert(contains_f64(b[0 .. 2], nan) == false);
    assert(contains_f64(a[0 .. 4], nan) == false);
}

