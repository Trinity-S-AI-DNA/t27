    assert(pow_i16(-32768, 0) == 1);
    assert(pow_i16(-32768, 1) == -32768);
    assert(pow_i16(-3, 0) == 1);
    assert(pow_i16(-3, 1) == -3);
    assert(pow_i16(-3, 2) == 9);
    assert(pow_i16(-3, 3) == -27);
    assert(pow_i16(-3, 4) == 81);
    assert(pow_i16(-3, 5) == -243);
    assert(pow_i16(-3, 7) == -2187);
    assert(pow_i16(-3, 8) == 6561);
    assert(pow_i16(-2, 0) == 1);
    assert(pow_i16(-2, 1) == -2);
    assert(pow_i16(-2, 2) == 4);
    assert(pow_i16(-2, 3) == -8);
    assert(pow_i16(-2, 4) == 16);
    assert(pow_i16(-2, 5) == -32);
    assert(pow_i16(-2, 7) == -128);
    assert(pow_i16(-2, 8) == 256);
    assert(pow_i16(-2, 15) == -32768);
    assert(pow_i16(-1, 0) == 1);
    assert(pow_i16(-1, 1) == -1);
    assert(pow_i16(-1, 2) == 1);
    assert(pow_i16(-1, 3) == -1);
    assert(pow_i16(-1, 4) == 1);
    assert(pow_i16(-1, 5) == -1);
    assert(pow_i16(-1, 7) == -1);
    assert(pow_i16(-1, 8) == 1);
    assert(pow_i16(-1, 15) == -1);
    assert(pow_i16(-1, 16) == 1);
    assert(pow_i16(-1, 31) == -1);
    assert(pow_i16(-1, 32) == 1);
    assert(pow_i16(-1, 63) == -1);
    assert(pow_i16(-1, 64) == 1);
    assert(pow_i16(0, 0) == 1);
    assert(pow_i16(0, 1) == 0);
    assert(pow_i16(0, 2) == 0);
    assert(pow_i16(0, 3) == 0);
    assert(pow_i16(0, 4) == 0);
    assert(pow_i16(0, 5) == 0);
    assert(pow_i16(0, 7) == 0);
    assert(pow_i16(0, 8) == 0);
    assert(pow_i16(0, 15) == 0);
    assert(pow_i16(0, 16) == 0);
    assert(pow_i16(0, 31) == 0);
    assert(pow_i16(0, 32) == 0);
    assert(pow_i16(0, 63) == 0);
    assert(pow_i16(0, 64) == 0);
    assert(pow_i16(1, 0) == 1);
    assert(pow_i16(1, 1) == 1);
    assert(pow_i16(1, 2) == 1);
    assert(pow_i16(1, 3) == 1);
    assert(pow_i16(1, 4) == 1);
    assert(pow_i16(1, 5) == 1);
    assert(pow_i16(1, 7) == 1);
    assert(pow_i16(1, 8) == 1);
    assert(pow_i16(1, 15) == 1);
    assert(pow_i16(1, 16) == 1);
    assert(pow_i16(1, 31) == 1);
    assert(pow_i16(1, 32) == 1);
    assert(pow_i16(1, 63) == 1);
    assert(pow_i16(1, 64) == 1);
    assert(pow_i16(2, 0) == 1);
    assert(pow_i16(2, 1) == 2);
    assert(pow_i16(2, 2) == 4);
    assert(pow_i16(2, 3) == 8);
    assert(pow_i16(2, 4) == 16);
    assert(pow_i16(2, 5) == 32);
    assert(pow_i16(2, 7) == 128);
    assert(pow_i16(2, 8) == 256);
    assert(pow_i16(3, 0) == 1);
    assert(pow_i16(3, 1) == 3);
    assert(pow_i16(3, 2) == 9);
    assert(pow_i16(3, 3) == 27);
    assert(pow_i16(3, 4) == 81);
    assert(pow_i16(3, 5) == 243);
    assert(pow_i16(3, 7) == 2187);
    assert(pow_i16(3, 8) == 6561);
    assert(pow_i16(10, 0) == 1);
    assert(pow_i16(10, 1) == 10);
    assert(pow_i16(10, 2) == 100);
    assert(pow_i16(10, 3) == 1000);
    assert(pow_i16(10, 4) == 10000);
    assert(pow_i16(181, 0) == 1);
    assert(pow_i16(181, 1) == 181);
    assert(pow_i16(181, 2) == 32761);
    assert(pow_i16(32767, 0) == 1);
    assert(pow_i16(32767, 1) == 32767);
}

/// pow of i32: every expected value was printed by rustc 1.99 running `x.pow(e)` on the same inputs; the pairs
/// that overflow are not vectors (a debug build panics on them), the ones kept are those `checked_pow` answers,
/// up to the largest result the type holds.
