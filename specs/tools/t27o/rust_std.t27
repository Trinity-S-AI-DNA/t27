/// [i8]::contains(&x): every expected value was printed by rustc 1.99 running `a.contains(&x)` on the same array, for a
/// member (first, middle, last), a non-member and the neighbours of the edge values; the empty slice contains nothing.
test std_contains_of_i8_is_rusts {
    const a : [4]i8 = [7, -128, 127, -1];
    assert(contains_i8(a[0 .. 4], 7) == true);
    assert(contains_i8(a[0 .. 4], -128) == true);
    assert(contains_i8(a[0 .. 4], 127) == true);
    assert(contains_i8(a[0 .. 4], -1) == true);
    assert(contains_i8(a[0 .. 4], 0) == false);
    assert(contains_i8(a[0 .. 4], 1) == false);
    assert(contains_i8(a[0 .. 4], -127) == false);
    assert(contains_i8(a[0 .. 4], 126) == false);
    assert(contains_i8(a[0 .. 0], 7) == false);
}

/// [i16]::contains(&x): every expected value was printed by rustc 1.99 running `a.contains(&x)` on the same array, for a
/// member (first, middle, last), a non-member and the neighbours of the edge values; the empty slice contains nothing.
test std_contains_of_i16_is_rusts {
    const a : [4]i16 = [7, -32768, 32767, -1];
    assert(contains_i16(a[0 .. 4], 7) == true);
    assert(contains_i16(a[0 .. 4], -32768) == true);
    assert(contains_i16(a[0 .. 4], 32767) == true);
    assert(contains_i16(a[0 .. 4], -1) == true);
    assert(contains_i16(a[0 .. 4], 0) == false);
    assert(contains_i16(a[0 .. 4], 1) == false);
    assert(contains_i16(a[0 .. 4], -32767) == false);
    assert(contains_i16(a[0 .. 4], 32766) == false);
    assert(contains_i16(a[0 .. 0], 7) == false);
}

/// [i32]::contains(&x): every expected value was printed by rustc 1.99 running `a.contains(&x)` on the same array, for a
