// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/rust_std.t27 -- the t27 behind t27o's Rust std mapping table, and the proof of each
; entry's I/O. The table itself (STD_NAME / STD_FORM / ...) is in specs/tools/t27o/rust_convert.t27, which
; uses no other module (t27c splices a `use` by word, transitively, see #7176); a spec t27o converts
; `use`s this one for the entries below.
; --
; DRY: an entry names an EXISTING t27 function where one has the same I/O -- hosting::toolchain's
; starts_with / ends_with, tri::mutate::plant's same_text for `==` on texts, tri::t27b::type_text's
; trim_lo / trim_hi (Rust's White_Space, UTF-8 included) under the three trims -- or a builtin every
; backend lowers (`.len`, `@abs` / `@min` / `@max` of floats, `+%`). Only the rest is written here, once:
; contains, parse, sum, integer abs and the checked arithmetic.
; Each entry has a test below proving the same I/O as Rust's std on oracle vectors: the expected values
; were printed by rustc 1.99 (debug, so an overflow panics and is not a vector) running the Rust call on
; the same inputs, on the t27c lab. A text t27 cannot spell as a literal (it reads only \n \t \\ \" as
; escapes) is a byte array.
; The entries and what proves each:
;   len, is_empty                          `.len`, `(.len == 0)`         std_sum_abs_min_max_and_wrapping
;   abs (f32/f64), min, max, cmp::min/max  `@abs`, `@min`, `@max`         std_sum_abs_min_max_and_wrapping
;   abs (i8..i64)                          abs_<T>                        std_sum_abs_min_max_and_wrapping
;   wrapping_add / sub / mul               `+%`, `-%`, `*%`               std_sum_abs_min_max_and_wrapping
;   checked_add / sub / mul (u32 u64 usize i32 i64)  checked_<op>_<T>     std_checked_arithmetic
;   trim, trim_start, trim_end             str_trim, str_trim_start, ..   std_trim_is_rusts_white_space_trim
;   starts_with, ends_with                 hosting::toolchain's           std_contains_starts_with_ends_with_and_eq
;   contains (text, bytes), `==` on texts  str_contains, bytes_contain, tri::mutate::plant's same_text  (same)
;   parse::<u8 .. i64>                     parse_<T>, ?T                  std_parse_is_rusts_from_str
;   iter().sum::<T>(), iter().count()      sum_<T>, `.len`                std_sum_abs_min_max_and_wrapping
;   unwrap, expect, is_some, is_none, is_ok, is_err, ok, ok_or, context: `.?`, `!= null`, `== null`, the
;   value itself (an Option and a Result are both ?T); no function behind them.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oRustStd;

use hosting::toolchain;
use tri::mutate::plant;
use tri::t27b::type_text;

// ---------------------------------------------------------------- texts

/// str::trim. Rust's White_Space (char::is_whitespace, read from UTF-8 bytes) is tri::t27b::type_text's
/// trim_lo / trim_hi, used here, not written again.
pub fn str_trim(s: []const u8) -> []const u8 {
    const lo : usize = type_text::trim_lo(s, 0, s.len);
    return s[lo .. type_text::trim_hi(s, lo, s.len)];
}

/// str::trim_start.
pub fn str_trim_start(s: []const u8) -> []const u8 {
    return s[type_text::trim_lo(s, 0, s.len) .. s.len];
}

/// str::trim_end.
pub fn str_trim_end(s: []const u8) -> []const u8 {
    return s[0 .. type_text::trim_hi(s, 0, s.len)];
}

/// str::contains with a text pattern.
pub fn str_contains(hay: []const u8, needle: []const u8) -> bool {
    if (needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var k : usize = 0;
        while (k < needle.len and hay[i + k] == needle[k]) { k += 1; }
        if (k == needle.len) { return true; }
        i += 1;
    }
    return false;
}

/// <[u8]>::contains.
pub fn bytes_contain(xs: []const u8, x: u8) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

// ---------------------------------------------------------------- parse::<int>

/// The digits s[from ..] as a value at most max: at least one ASCII digit and nothing else (Rust's
/// FromStr for integers: no space, no `_`, no radix prefix).
pub fn digits_upto(s: []const u8, from: usize, max: u64) -> ?u64 {
    if (from >= s.len) { return null; }
    var v : u64 = 0;
    var i : usize = from;
    while (i < s.len) {
        const c : u8 = s[i];
        if (c < 48 or c > 57) { return null; }
        const d : u64 = (c - 48) as u64;
        if (v > (max - d) / 10) { return null; }
        v = v * 10 + d;
        i += 1;
    }
    return v;
}

/// An unsigned integer: an optional `+`, then digits.
pub fn parse_unsigned(s: []const u8, max: u64) -> ?u64 {
    var from : usize = 0;
    if (s.len > 0 and s[0] == 43) { from = 1; }
    return digits_upto(s, from, max);
}

/// A signed integer of at most max (and down to -max - 1): an optional `+` or `-`, then digits.
pub fn parse_signed(s: []const u8, max: u64) -> ?i64 {
    if (s.len > 0 and s[0] == 45) {
        const m : ?u64 = digits_upto(s, 1, max + 1);
        if (m == null) { return null; }
        const v : u64 = m.?;
        if (v == 9223372036854775808) { return -9223372036854775807 - 1; }
        return 0 - (v as i64);
    }
    const p : ?u64 = parse_unsigned(s, max);
    if (p == null) { return null; }
    return p.? as i64;
}

pub fn parse_u8(s: []const u8) -> ?u8 {
    const v : ?u64 = parse_unsigned(s, 255);
    if (v == null) { return null; }
    return v.? as u8;
}

pub fn parse_u16(s: []const u8) -> ?u16 {
    const v : ?u64 = parse_unsigned(s, 65535);
    if (v == null) { return null; }
    return v.? as u16;
}

pub fn parse_u32(s: []const u8) -> ?u32 {
    const v : ?u64 = parse_unsigned(s, 4294967295);
    if (v == null) { return null; }
    return v.? as u32;
}

pub fn parse_u64(s: []const u8) -> ?u64 {
    return parse_unsigned(s, 18446744073709551615);
}

pub fn parse_usize(s: []const u8) -> ?usize {
    const v : ?u64 = parse_unsigned(s, 18446744073709551615);
    if (v == null) { return null; }
    return v.? as usize;
}

pub fn parse_i8(s: []const u8) -> ?i8 {
    const v : ?i64 = parse_signed(s, 127);
    if (v == null) { return null; }
    return v.? as i8;
}

pub fn parse_i16(s: []const u8) -> ?i16 {
    const v : ?i64 = parse_signed(s, 32767);
    if (v == null) { return null; }
    return v.? as i16;
}

pub fn parse_i32(s: []const u8) -> ?i32 {
    const v : ?i64 = parse_signed(s, 2147483647);
    if (v == null) { return null; }
    return v.? as i32;
}

pub fn parse_i64(s: []const u8) -> ?i64 {
    return parse_signed(s, 9223372036854775807);
}

// ---------------------------------------------------------------- iter().sum()

pub fn sum_u32(xs: []const u32) -> u32 {
    var t : u32 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_u64(xs: []const u64) -> u64 {
    var t : u64 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_usize(xs: []const usize) -> usize {
    var t : usize = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_i32(xs: []const i32) -> i32 {
    var t : i32 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_i64(xs: []const i64) -> i64 {
    var t : i64 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_f32(xs: []const f32) -> f32 {
    var t : f32 = 0.0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_f64(xs: []const f64) -> f64 {
    var t : f64 = 0.0;
    for x in xs { t = t + x; }
    return t;
}

// ---------------------------------------------------------------- integer abs

pub fn abs_i8(x: i8) -> i8 {
    if (x < 0) { return 0 - x; }
    return x;
}

pub fn abs_i16(x: i16) -> i16 {
    if (x < 0) { return 0 - x; }
    return x;
}

pub fn abs_i32(x: i32) -> i32 {
    if (x < 0) { return 0 - x; }
    return x;
}

pub fn abs_i64(x: i64) -> i64 {
    if (x < 0) { return 0 - x; }
    return x;
}

// ---------------------------------------------------------------- checked arithmetic

pub const I32_MAX : i32 = 2147483647;
pub const I32_MIN : i32 = -2147483647 - 1;
pub const I64_MAX : i64 = 9223372036854775807;
pub const I64_MIN : i64 = -9223372036854775807 - 1;

pub fn checked_add_u32(a: u32, b: u32) -> ?u32 {
    if (b > 4294967295 - a) { return null; }
    return a + b;
}

pub fn checked_sub_u32(a: u32, b: u32) -> ?u32 {
    if (b > a) { return null; }
    return a - b;
}

pub fn checked_mul_u32(a: u32, b: u32) -> ?u32 {
    if (a != 0 and b > 4294967295 / a) { return null; }
    return a * b;
}

pub fn checked_add_u64(a: u64, b: u64) -> ?u64 {
    if (b > 18446744073709551615 - a) { return null; }
    return a + b;
}

pub fn checked_sub_u64(a: u64, b: u64) -> ?u64 {
    if (b > a) { return null; }
    return a - b;
}

pub fn checked_mul_u64(a: u64, b: u64) -> ?u64 {
    if (a != 0 and b > 18446744073709551615 / a) { return null; }
    return a * b;
}

/// usize is the 64-bit host's (as the oracle's rustc builds for): its checked arithmetic is u64's.
pub fn checked_add_usize(a: usize, b: usize) -> ?usize {
    const r : ?u64 = checked_add_u64(a as u64, b as u64);
    if (r == null) { return null; }
    return r.? as usize;
}

pub fn checked_sub_usize(a: usize, b: usize) -> ?usize {
    const r : ?u64 = checked_sub_u64(a as u64, b as u64);
    if (r == null) { return null; }
    return r.? as usize;
}

pub fn checked_mul_usize(a: usize, b: usize) -> ?usize {
    const r : ?u64 = checked_mul_u64(a as u64, b as u64);
    if (r == null) { return null; }
    return r.? as usize;
}

pub fn checked_add_i32(a: i32, b: i32) -> ?i32 {
    if ((b > 0 and a > I32_MAX - b) or (b < 0 and a < I32_MIN - b)) { return null; }
    return a + b;
}

pub fn checked_sub_i32(a: i32, b: i32) -> ?i32 {
    if ((b < 0 and a > I32_MAX + b) or (b > 0 and a < I32_MIN + b)) { return null; }
    return a - b;
}

/// Overflow is decided by division before the product is formed (CERT INT32-C).
pub fn checked_mul_i32(a: i32, b: i32) -> ?i32 {
    if (a > 0) {
        if (b > 0) {
            if (a > I32_MAX / b) { return null; }
        } else {
            if (b < I32_MIN / a) { return null; }
        }
    } else {
        if (b > 0) {
            if (a < I32_MIN / b) { return null; }
        } else {
            if (a != 0 and b < I32_MAX / a) { return null; }
        }
    }
    return a * b;
}

pub fn checked_add_i64(a: i64, b: i64) -> ?i64 {
    if ((b > 0 and a > I64_MAX - b) or (b < 0 and a < I64_MIN - b)) { return null; }
    return a + b;
}

pub fn checked_sub_i64(a: i64, b: i64) -> ?i64 {
    if ((b < 0 and a > I64_MAX + b) or (b > 0 and a < I64_MIN + b)) { return null; }
    return a - b;
}

pub fn checked_mul_i64(a: i64, b: i64) -> ?i64 {
    if (a > 0) {
        if (b > 0) {
            if (a > I64_MAX / b) { return null; }
        } else {
            if (b < I64_MIN / a) { return null; }
        }
    } else {
        if (b > 0) {
            if (a < I64_MIN / b) { return null; }
        } else {
            if (a != 0 and b < I64_MAX / a) { return null; }
        }
    }
    return a * b;
}

// ---------------------------------------------------------------- tests
// One test per entry (or group of entries): the t27 an entry writes, run on vectors whose expected
// values Rust's std printed (rustc 1.99 debug on the t27c lab).

test std_trim_is_rusts_white_space_trim {
    assert(plant::same_text(str_trim(""), ""));
    assert(plant::same_text(str_trim_start(""), ""));
    assert(plant::same_text(str_trim_end(""), ""));
    assert(plant::same_text(str_trim("a"), "a"));
    assert(plant::same_text(str_trim_start("a"), "a"));
    assert(plant::same_text(str_trim_end("a"), "a"));
    assert(plant::same_text(str_trim("  a b  "), "a b"));
    assert(plant::same_text(str_trim_start("  a b  "), "a b  "));
    assert(plant::same_text(str_trim_end("  a b  "), "  a b"));
    const in3 : [7]u8 = [9, 10, 32, 120, 32, 13, 10];
    assert(plant::same_text(str_trim(in3[0 .. 7]), "x"));
    const out3_1 : [4]u8 = [120, 32, 13, 10];
    assert(plant::same_text(str_trim_start(in3[0 .. 7]), out3_1[0 .. 4]));
    assert(plant::same_text(str_trim_end(in3[0 .. 7]), "\t\n x"));
    const in4 : [5]u8 = [194, 160, 97, 194, 160];
    assert(plant::same_text(str_trim(in4[0 .. 5]), "a"));
    const out4_1 : [3]u8 = [97, 194, 160];
    assert(plant::same_text(str_trim_start(in4[0 .. 5]), out4_1[0 .. 3]));
    const out4_2 : [3]u8 = [194, 160, 97];
    assert(plant::same_text(str_trim_end(in4[0 .. 5]), out4_2[0 .. 3]));
    const in5 : [7]u8 = [227, 128, 128, 122, 226, 128, 137];
    assert(plant::same_text(str_trim(in5[0 .. 7]), "z"));
    const out5_1 : [4]u8 = [122, 226, 128, 137];
    assert(plant::same_text(str_trim_start(in5[0 .. 7]), out5_1[0 .. 4]));
    const out5_2 : [4]u8 = [227, 128, 128, 122];
    assert(plant::same_text(str_trim_end(in5[0 .. 7]), out5_2[0 .. 4]));
    const in6 : [4]u8 = [11, 12, 113, 12];
    assert(plant::same_text(str_trim(in6[0 .. 4]), "q"));
    const out6_1 : [2]u8 = [113, 12];
    assert(plant::same_text(str_trim_start(in6[0 .. 4]), out6_1[0 .. 2]));
    const out6_2 : [3]u8 = [11, 12, 113];
    assert(plant::same_text(str_trim_end(in6[0 .. 4]), out6_2[0 .. 3]));
    assert(plant::same_text(str_trim("abc"), "abc"));
    assert(plant::same_text(str_trim_start("abc"), "abc"));
    assert(plant::same_text(str_trim_end("abc"), "abc"));
    const in8 : [12]u8 = [194, 133, 225, 154, 128, 107, 226, 128, 168, 226, 129, 159];
    assert(plant::same_text(str_trim(in8[0 .. 12]), "k"));
    const out8_1 : [7]u8 = [107, 226, 128, 168, 226, 129, 159];
    assert(plant::same_text(str_trim_start(in8[0 .. 12]), out8_1[0 .. 7]));
    const out8_2 : [6]u8 = [194, 133, 225, 154, 128, 107];
    assert(plant::same_text(str_trim_end(in8[0 .. 12]), out8_2[0 .. 6]));
    const in9 : [5]u8 = [195, 169, 32, 195, 169];
    const out9_0 : [5]u8 = [195, 169, 32, 195, 169];
    assert(plant::same_text(str_trim(in9[0 .. 5]), out9_0[0 .. 5]));
    const out9_1 : [5]u8 = [195, 169, 32, 195, 169];
    assert(plant::same_text(str_trim_start(in9[0 .. 5]), out9_1[0 .. 5]));
    const out9_2 : [5]u8 = [195, 169, 32, 195, 169];
    assert(plant::same_text(str_trim_end(in9[0 .. 5]), out9_2[0 .. 5]));
}

test std_contains_starts_with_ends_with_and_eq {
    assert(str_contains("abc", "b"));
    assert(!toolchain::starts_with("abc", "b"));
    assert(!toolchain::ends_with("abc", "b"));
    assert(!plant::same_text("abc", "b"));
    assert(str_contains("abc", ""));
    assert(toolchain::starts_with("abc", ""));
    assert(toolchain::ends_with("abc", ""));
    assert(!plant::same_text("abc", ""));
    assert(!str_contains("", "a"));
    assert(!toolchain::starts_with("", "a"));
    assert(!toolchain::ends_with("", "a"));
    assert(!plant::same_text("", "a"));
    assert(!str_contains("abc", "abcd"));
    assert(!toolchain::starts_with("abc", "abcd"));
    assert(!toolchain::ends_with("abc", "abcd"));
    assert(!plant::same_text("abc", "abcd"));
    assert(str_contains("aab", "ab"));
    assert(!toolchain::starts_with("aab", "ab"));
    assert(toolchain::ends_with("aab", "ab"));
    assert(!plant::same_text("aab", "ab"));
    assert(str_contains("abc", "c"));
    assert(!toolchain::starts_with("abc", "c"));
    assert(toolchain::ends_with("abc", "c"));
    assert(!plant::same_text("abc", "c"));
    assert(!str_contains("abc", "ac"));
    assert(!toolchain::starts_with("abc", "ac"));
    assert(!toolchain::ends_with("abc", "ac"));
    assert(!plant::same_text("abc", "ac"));
    assert(str_contains("", ""));
    assert(toolchain::starts_with("", ""));
    assert(toolchain::ends_with("", ""));
    assert(plant::same_text("", ""));
    const nul : [4]u8 = [97, 98, 99, 0];
    assert(bytes_contain(nul[0 .. 4], 97));
    assert(!bytes_contain(nul[0 .. 4], 122));
    assert(bytes_contain(nul[0 .. 4], 0));
}

test std_parse_is_rusts_from_str {
    assert(parse_u8("0").? == 0);
    assert(parse_u16("0").? == 0);
    assert(parse_u32("0").? == 0);
    assert(parse_u64("0").? == 0);
    assert(parse_usize("0").? == 0);
    assert(parse_i8("0").? == 0);
    assert(parse_i16("0").? == 0);
    assert(parse_i32("0").? == 0);
    assert(parse_i64("0").? == 0);
    assert(parse_u8("1").? == 1);
    assert(parse_u16("1").? == 1);
    assert(parse_u32("1").? == 1);
    assert(parse_u64("1").? == 1);
    assert(parse_usize("1").? == 1);
    assert(parse_i8("1").? == 1);
    assert(parse_i16("1").? == 1);
    assert(parse_i32("1").? == 1);
    assert(parse_i64("1").? == 1);
    assert(parse_u8("-1") == null);
    assert(parse_u16("-1") == null);
    assert(parse_u32("-1") == null);
    assert(parse_u64("-1") == null);
    assert(parse_usize("-1") == null);
    assert(parse_i8("-1").? == -1);
    assert(parse_i16("-1").? == -1);
    assert(parse_i32("-1").? == -1);
    assert(parse_i64("-1").? == -1);
    assert(parse_u8("+7").? == 7);
    assert(parse_u16("+7").? == 7);
    assert(parse_u32("+7").? == 7);
    assert(parse_u64("+7").? == 7);
    assert(parse_usize("+7").? == 7);
    assert(parse_i8("+7").? == 7);
    assert(parse_i16("+7").? == 7);
    assert(parse_i32("+7").? == 7);
    assert(parse_i64("+7").? == 7);
    assert(parse_u8("42").? == 42);
    assert(parse_u16("42").? == 42);
    assert(parse_u32("42").? == 42);
    assert(parse_u64("42").? == 42);
    assert(parse_usize("42").? == 42);
    assert(parse_i8("42").? == 42);
    assert(parse_i16("42").? == 42);
    assert(parse_i32("42").? == 42);
    assert(parse_i64("42").? == 42);
    assert(parse_u8("255").? == 255);
    assert(parse_u16("255").? == 255);
    assert(parse_u32("255").? == 255);
    assert(parse_u64("255").? == 255);
    assert(parse_usize("255").? == 255);
    assert(parse_i8("255") == null);
    assert(parse_i16("255").? == 255);
    assert(parse_i32("255").? == 255);
    assert(parse_i64("255").? == 255);
    assert(parse_u8("256") == null);
    assert(parse_u16("256").? == 256);
    assert(parse_u32("256").? == 256);
    assert(parse_u64("256").? == 256);
    assert(parse_usize("256").? == 256);
    assert(parse_i8("256") == null);
    assert(parse_i16("256").? == 256);
    assert(parse_i32("256").? == 256);
    assert(parse_i64("256").? == 256);
    assert(parse_u8("-128") == null);
    assert(parse_u16("-128") == null);
    assert(parse_u32("-128") == null);
    assert(parse_u64("-128") == null);
    assert(parse_usize("-128") == null);
    assert(parse_i8("-128").? == -128);
    assert(parse_i16("-128").? == -128);
    assert(parse_i32("-128").? == -128);
    assert(parse_i64("-128").? == -128);
    assert(parse_u8("-129") == null);
    assert(parse_u16("-129") == null);
    assert(parse_u32("-129") == null);
    assert(parse_u64("-129") == null);
    assert(parse_usize("-129") == null);
    assert(parse_i8("-129") == null);
    assert(parse_i16("-129").? == -129);
    assert(parse_i32("-129").? == -129);
    assert(parse_i64("-129").? == -129);
    assert(parse_u8("127").? == 127);
    assert(parse_u16("127").? == 127);
    assert(parse_u32("127").? == 127);
    assert(parse_u64("127").? == 127);
    assert(parse_usize("127").? == 127);
    assert(parse_i8("127").? == 127);
    assert(parse_i16("127").? == 127);
    assert(parse_i32("127").? == 127);
    assert(parse_i64("127").? == 127);
    assert(parse_u8("65535") == null);
    assert(parse_u16("65535").? == 65535);
    assert(parse_u32("65535").? == 65535);
    assert(parse_u64("65535").? == 65535);
    assert(parse_usize("65535").? == 65535);
    assert(parse_i8("65535") == null);
    assert(parse_i16("65535") == null);
    assert(parse_i32("65535").? == 65535);
    assert(parse_i64("65535").? == 65535);
    assert(parse_u8("65536") == null);
    assert(parse_u16("65536") == null);
