// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/rust_std.t27 -- the t27 behind t27o's Rust std mapping table, and the proof of each
; entry's I/O. The table itself (STD_NAME / STD_FORM / ...) is in specs/tools/t27o/rust_convert.t27, which
; uses no other module (t27c splices a `use` by word, transitively, see #7176); a spec t27o converts
; `use`s this one for the entries below.
; --
; DRY: an entry names an EXISTING t27 function where one has the same I/O -- hosting::toolchain's
; starts_with / ends_with, tri::t27b::type_text's same for `==` on texts and alpha / digit -- or a
; builtin every backend lowers (`.len`, `@abs` / `@min` / `@max` of floats, `+%`). Only the rest is
; written here, once: contains, parse, sum, integer abs, the checked arithmetic, #9100's needle fns
; and #9098's appends, and (#10764) the bit counts, pow, the saturating family, div_ceil, the float and
; ASCII helpers, a slice's get and contains. The ones that take an integer type are one fn per width
; (t27 has no generics), named <method>_<T>; the table's `%` writes T.
; Rust's three trims are NOT fns anywhere in this table's output: a t27 fn that returns `[]const u8`
; is emitted by gen-rust as `-> &'static str`, and a fn whose body hands back a slice of its parameter
; cannot satisfy that (E0308, the four stale copies of #9226). The trim entries lower to the slice
; written AT THE USE SITE over type_text's trim_lo / trim_hi -- see the table in rust_convert.t27.
; Each entry has a test below proving the same I/O as Rust's std on oracle vectors: the expected values
; were printed by rustc 1.99 (debug, so an overflow panics and is not a vector) running the Rust call on
; the same inputs, on the t27c lab. A text t27 cannot spell as a literal (it reads only \n \t \\ \" as
; escapes) is a byte array.
; The entries and what proves each:
;   len, is_empty                          `.len`, `(.len == 0)`         std_sum_abs_min_max_and_wrapping
;   abs (f32/f64), min, max, cmp::min/max  `@abs`, `@min`, `@max`         std_sum_abs_min_max_and_wrapping
;   abs (i8..i64)                          abs_<T>                        std_sum_abs_min_max_and_wrapping
;   wrapping_add / sub / mul               `+%`, `-%`, `*%`               std_sum_abs_min_max_and_wrapping
;   checked_add / sub / mul (u32 u64 usize i32 i64)  checked_<op>_<T>     std_checked_arithmetic
;   count_ones, leading_zeros, trailing_zeros (u8 u16 u32 u64 usize i8 i16 i32 i64)
;                                          count_ones_<T> / leading_zeros_<T> / trailing_zeros_<T>, u32
;                                          (#10764)                       std_bit_counts_are_rusts
;   saturating_add / sub / mul (the same nine types)  saturating_<op>_<T>; hosting::panel has the u64 add, a
;                                          `use` of it splices 28 modules (#7176) so it is written here
;                                          (#10764)                       std_saturating_arithmetic_of_<T>_is_rusts
;   div_ceil (u8 u16 u32 u64 usize)        div_ceil_<T>; a zero divisor traps as Rust's panics; the signed
;                                          div_ceil is unstable in Rust (#10764)  std_div_ceil_of_<T>_is_rusts
;   sqrt (f32, f64)                        `@sqrt` (IEEE 754 square root, correctly rounded)
;                                                                         std_f64_sqrt_is_finite_and_to_bits_are_rusts
;   is_finite, to_bits (f32, f64)          is_finite_<T>, to_bits_<T> (`(x - x) == 0.0`, `@bitCast`; the second is
;                                          printed as written by gen-rust, which rustc does not read) (#10764)
;                                                                         std_f32_sqrt_is_finite_and_to_bits_are_rusts
;   ln                                     refused: a libm function, see R_LIBM in rust_convert.t27
;   is_ascii (text, byte slice, u8)       is_ascii_text, is_ascii_u8      std_ascii_methods_are_rusts
;   to_ascii_lowercase / uppercase (u8)    to_ascii_lowercase_u8 / _uppercase_u8 (a text's returns an owned
;                                          String and t27o has no char class: both stay refused) (#10764)
;   get(i) on a slice of scalars (u8 .. i64, usize, f32, f64)   get_<T>, ?T (#10764)   std_get_of_<T>_is_rusts
;   contains(&x) on a slice of u16 .. i64, usize, f32, f64   contains_<T> (u8 is bytes_contain)
;   contains(c) on a text, c a char in a variable   str_contains_char: the char's UTF-8 bytes (#10764)
;                                                                         std_contains_of_<T>_is_rusts,
;                                                                         std_contains_of_a_char_is_rusts
;   unwrap_or(d) on an Option or a Result    `if (r != null) { r.? } else { d }` -- t27 has no `orelse`; the
;                                          receiver is written twice (a pure std helper only) and the form
;                                          stands alone as a value, for the reference prints an `if` without
;                                          parentheses (#10764)           std_unwrap_or_is_rusts
;   pow (u8 u16 u32 u64 usize i8 i16 i32 i64)   pow_<T>: Rust's loop, so an overflow traps where a
;                                          debug build panics (#10764)    std_pow_of_<T>_is_rusts
;   trim, trim_start, trim_end             the slice `s[trim_lo(..) .. trim_hi(..)]` written at the use
;                                          site (a fn returning []const u8 cannot be emitted; the
;                                          vectors live in type_text's trim test)   std_trim_is_rusts_white_space_trim
;   is_ascii_alphabetic, is_ascii_digit    type_text's alpha / digit      (proven in type_text's own tests)
;   is_ascii_alphanumeric                  alnum                          std_ascii_classes_and_chars_all
;   find (text needle, char needle)        find_text / find_byte, ?usize  std_find_is_rusts_byte_index
;   trim_start_matches / trim_end_matches  trim_*_matches_text / _byte    std_trim_matches_strips_and_leading
;   strip_prefix / strip_suffix            strip_*_text / _byte, ?[]const u8   std_strip_prefix_suffix_are_option_slices
;   chars().all(<one ASCII class test>)    chars_all_digit / chars_all_word  std_ascii_classes_and_chars_all
;   starts_with, ends_with                 hosting::toolchain's; starts_with of a byte needle or a digit
;                                          closure: starts_with_byte / starts_with_digit (below)
;   contains (text, bytes), `==` on texts  str_contains, bytes_contain, type_text's same  (same)
;   push / push_str / format! appends      append_text / _char / _uint / _int  std_appends_are_rusts_string_writes
;   parse::<u8 .. i64>                     parse_<T>, ?T                  std_parse_is_rusts_from_str
;   iter().sum::<T>(), iter().count()      sum_<T>, `.len`                std_sum_abs_min_max_and_wrapping
;   unwrap, expect, is_some, is_none, is_ok, is_err, ok, ok_or, context: `.?`, `!= null`, `== null`, the
;   value itself (an Option and a Result are both ?T); no function behind them.
; A needle-polymorphic entry (find, trim_*_matches, strip_*, starts_with) has its text-needle row first
; and its char-needle sibling after; the table's method() bumps to the sibling on a char-literal needle.
; The fns added for #9100 are self-contained on purpose: converted output splices this module at depth
; 1, and a spliced body that itself calls another module (type_text::) does not resolve (#7176, probed
; in specs/t27o_check/zz_probe_trim.t27) -- which is why the trims point straight at type_text.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oRustStd;

use hosting::toolchain;
use tri::mutate::plant;
use tri::t27b::type_text;

// ---------------------------------------------------------------- texts

/// char::is_ascii_alphanumeric of one byte (A-Z a-z 0-9); Rust's is_ascii_alphabetic and
/// is_ascii_digit of it are type_text's alpha / digit, which this stays consistent with.
pub fn alnum(c: u8) -> bool {
    if (c >= 48 and c <= 57) { return true; }
    if (c >= 65 and c <= 90) { return true; }
    if (c >= 97 and c <= 122) { return true; }
    return false;
}

/// str::find of a text needle: the byte index of its first occurrence, and 0 for the empty needle,
/// as Rust's. `s.contains(n)` is exactly `find_text(s, n) != null`, which is what str_contains says.
pub fn find_text(s: []const u8, n: []const u8) -> ?usize {
    if (n.len > s.len) { return null; }
    var i : usize = 0;
    while (i + n.len <= s.len) {
        var k : usize = 0;
        while (k < n.len and s[i + k] == n[k]) { k += 1; }
        if (k == n.len) { return i; }
        i += 1;
    }
    return null;
}

/// str::find of a char needle: on the ASCII corpus a char is its one byte.
pub fn find_byte(s: []const u8, n: u8) -> ?usize {
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] == n) { return i; }
        i += 1;
    }
    return null;
}

/// str::contains with a text pattern.
pub fn str_contains(hay: []const u8, needle: []const u8) -> bool {
    return find_text(hay, needle) != null;
}

/// str::trim_start_matches of a text needle: the needle is cut whole, repeatedly.
pub fn trim_start_matches_text(s: []const u8, n: []const u8) -> []const u8 {
    if (n.len == 0 or n.len > s.len) { return s; }
    var i : usize = 0;
    while (i + n.len <= s.len) {
        var k : usize = 0;
        while (k < n.len and s[i + k] == n[k]) { k += 1; }
        if (k < n.len) { return s[i .. s.len]; }
        i += n.len;
    }
    return s[i .. s.len];
}

/// str::trim_start_matches of a char needle.
pub fn trim_start_matches_byte(s: []const u8, n: u8) -> []const u8 {
    var i : usize = 0;
    while (i < s.len and s[i] == n) { i += 1; }
    return s[i .. s.len];
}

/// str::trim_end_matches of a text needle: the needle is cut whole, repeatedly, from the end.
pub fn trim_end_matches_text(s: []const u8, n: []const u8) -> []const u8 {
    if (n.len == 0 or n.len > s.len) { return s; }
    var hi : usize = s.len;
    while (hi >= n.len) {
        var k : usize = 0;
        while (k < n.len and s[hi - n.len + k] == n[k]) { k += 1; }
        if (k < n.len) { return s[0 .. hi]; }
        hi -= n.len;
    }
    return s[0 .. hi];
}

/// str::trim_end_matches of a char needle.
pub fn trim_end_matches_byte(s: []const u8, n: u8) -> []const u8 {
    var hi : usize = s.len;
    while (hi > 0 and s[hi - 1] == n) { hi -= 1; }
    return s[0 .. hi];
}

/// str::strip_prefix of a text needle: the rest, or null when s does not start with it.
pub fn strip_prefix_text(s: []const u8, n: []const u8) -> ?[]const u8 {
    if (n.len > s.len) { return null; }
    var k : usize = 0;
    while (k < n.len and s[k] == n[k]) { k += 1; }
    if (k < n.len) { return null; }
    return s[n.len .. s.len];
}

/// str::strip_prefix of a char needle.
pub fn strip_prefix_byte(s: []const u8, n: u8) -> ?[]const u8 {
    if (s.len == 0 or s[0] != n) { return null; }
    return s[1 .. s.len];
}

/// str::strip_suffix of a text needle: the rest, or null when s does not end with it.
pub fn strip_suffix_text(s: []const u8, n: []const u8) -> ?[]const u8 {
    if (n.len > s.len) { return null; }
    var k : usize = 0;
    while (k < n.len and s[s.len - n.len + k] == n[k]) { k += 1; }
    if (k < n.len) { return null; }
    return s[0 .. s.len - n.len];
}

/// str::strip_suffix of a char needle.
pub fn strip_suffix_byte(s: []const u8, n: u8) -> ?[]const u8 {
    if (s.len == 0 or s[s.len - 1] != n) { return null; }
    return s[0 .. s.len - 1];
}

/// `chars().all(|c| c.is_ascii_digit())`: a byte of a non-ASCII char is never an ASCII digit, so the
/// bytes answer the same as the chars, and the empty text is all digits.
pub fn chars_all_digit(s: []const u8) -> bool {
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] < 48 or s[i] > 57) { return false; }
        i += 1;
    }
    return true;
}

/// `chars().all(|c| c.is_ascii_alphanumeric() || c == '_')`: an identifier character.
pub fn chars_all_word(s: []const u8) -> bool {
    var i : usize = 0;
    while (i < s.len) {
        if (!alnum(s[i]) and s[i] != 95) { return false; }
        i += 1;
    }
    return true;
}

/// str::starts_with of a char needle.
pub fn starts_with_byte(s: []const u8, n: u8) -> bool {
    if (s.len == 0) { return false; }
    return s[0] == n;
}

/// `starts_with(|c: char| c.is_ascii_digit())`: the first char is an ASCII digit.
pub fn starts_with_digit(s: []const u8) -> bool {
    if (s.len == 0) { return false; }
    return s[0] >= 48 and s[0] <= 57;
}

/// <[u8]>::contains.
pub fn bytes_contain(xs: []const u8, x: u8) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

// ---------------------------------------------------------------- parse::<int>

/// The digits s[from ..] as a value at most max: at least one ASCII digit and nothing else (Rust's
/// FromStr for integers: no space, no `_`, no radix prefix).
pub fn digits_upto(s: []const u8, from: usize, max: u64) -> ?u64 {
    if (from >= s.len) { return null; }
    var v : u64 = 0;
    var i : usize = from;
    while (i < s.len) {
        const c : u8 = s[i];
        if (c < 48 or c > 57) { return null; }
        const d : u64 = (c - 48) as u64;
        if (v > (max - d) / 10) { return null; }
        v = v * 10 + d;
        i += 1;
    }
    return v;
}

/// An unsigned integer: an optional `+`, then digits.
pub fn parse_unsigned(s: []const u8, max: u64) -> ?u64 {
    var from : usize = 0;
    if (s.len > 0 and s[0] == 43) { from = 1; }
    return digits_upto(s, from, max);
}

/// A signed integer of at most max (and down to -max - 1): an optional `+` or `-`, then digits.
pub fn parse_signed(s: []const u8, max: u64) -> ?i64 {
    if (s.len > 0 and s[0] == 45) {
        const m : ?u64 = digits_upto(s, 1, max + 1);
        if (m == null) { return null; }
        const v : u64 = m.?;
        if (v == 9223372036854775808) { return -9223372036854775807 - 1; }
        return 0 - (v as i64);
    }
    const p : ?u64 = parse_unsigned(s, max);
    if (p == null) { return null; }
    return p.? as i64;
}

pub fn parse_u8(s: []const u8) -> ?u8 {
    const v : ?u64 = parse_unsigned(s, 255);
    if (v == null) { return null; }
    return v.? as u8;
}

pub fn parse_u16(s: []const u8) -> ?u16 {
    const v : ?u64 = parse_unsigned(s, 65535);
    if (v == null) { return null; }
    return v.? as u16;
}

pub fn parse_u32(s: []const u8) -> ?u32 {
    const v : ?u64 = parse_unsigned(s, 4294967295);
    if (v == null) { return null; }
    return v.? as u32;
}

pub fn parse_u64(s: []const u8) -> ?u64 {
    return parse_unsigned(s, 18446744073709551615);
}

pub fn parse_usize(s: []const u8) -> ?usize {
    const v : ?u64 = parse_unsigned(s, 18446744073709551615);
    if (v == null) { return null; }
    return v.? as usize;
}

pub fn parse_i8(s: []const u8) -> ?i8 {
    const v : ?i64 = parse_signed(s, 127);
    if (v == null) { return null; }
    return v.? as i8;
}

pub fn parse_i16(s: []const u8) -> ?i16 {
    const v : ?i64 = parse_signed(s, 32767);
    if (v == null) { return null; }
    return v.? as i16;
}

pub fn parse_i32(s: []const u8) -> ?i32 {
    const v : ?i64 = parse_signed(s, 2147483647);
    if (v == null) { return null; }
    return v.? as i32;
}

pub fn parse_i64(s: []const u8) -> ?i64 {
    return parse_signed(s, 9223372036854775807);
}

// ---------------------------------------------------------------- iter().sum()

pub fn sum_u32(xs: []const u32) -> u32 {
    var t : u32 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_u64(xs: []const u64) -> u64 {
    var t : u64 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_usize(xs: []const usize) -> usize {
    var t : usize = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_i32(xs: []const i32) -> i32 {
    var t : i32 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_i64(xs: []const i64) -> i64 {
    var t : i64 = 0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_f32(xs: []const f32) -> f32 {
    var t : f32 = 0.0;
    for x in xs { t = t + x; }
    return t;
}

pub fn sum_f64(xs: []const f64) -> f64 {
    var t : f64 = 0.0;
    for x in xs { t = t + x; }
    return t;
}

// ---------------------------------------------------------------- integer abs

pub fn abs_i8(x: i8) -> i8 {
    if (x < 0) { return 0 - x; }
    return x;
}

pub fn abs_i16(x: i16) -> i16 {
    if (x < 0) { return 0 - x; }
    return x;
}

pub fn abs_i32(x: i32) -> i32 {
    if (x < 0) { return 0 - x; }
    return x;
}

pub fn abs_i64(x: i64) -> i64 {
    if (x < 0) { return 0 - x; }
    return x;
}

// ---------------------------------------------------------------- checked arithmetic

pub const I32_MAX : i32 = 2147483647;
pub const I32_MIN : i32 = -2147483647 - 1;
pub const I64_MAX : i64 = 9223372036854775807;
pub const I64_MIN : i64 = -9223372036854775807 - 1;

pub fn checked_add_u32(a: u32, b: u32) -> ?u32 {
    if (b > 4294967295 - a) { return null; }
    return a + b;
}

pub fn checked_sub_u32(a: u32, b: u32) -> ?u32 {
    if (b > a) { return null; }
    return a - b;
}

pub fn checked_mul_u32(a: u32, b: u32) -> ?u32 {
    if (a != 0 and b > 4294967295 / a) { return null; }
    return a * b;
}

pub fn checked_add_u64(a: u64, b: u64) -> ?u64 {
    if (b > 18446744073709551615 - a) { return null; }
    return a + b;
}

pub fn checked_sub_u64(a: u64, b: u64) -> ?u64 {
    if (b > a) { return null; }
    return a - b;
}

pub fn checked_mul_u64(a: u64, b: u64) -> ?u64 {
    if (a != 0 and b > 18446744073709551615 / a) { return null; }
    return a * b;
}

/// usize is the 64-bit host's (as the oracle's rustc builds for): its checked arithmetic is u64's.
pub fn checked_add_usize(a: usize, b: usize) -> ?usize {
    const r : ?u64 = checked_add_u64(a as u64, b as u64);
    if (r == null) { return null; }
    return r.? as usize;
}

pub fn checked_sub_usize(a: usize, b: usize) -> ?usize {
    const r : ?u64 = checked_sub_u64(a as u64, b as u64);
    if (r == null) { return null; }
    return r.? as usize;
}

pub fn checked_mul_usize(a: usize, b: usize) -> ?usize {
    const r : ?u64 = checked_mul_u64(a as u64, b as u64);
    if (r == null) { return null; }
    return r.? as usize;
}

pub fn checked_add_i32(a: i32, b: i32) -> ?i32 {
    if ((b > 0 and a > I32_MAX - b) or (b < 0 and a < I32_MIN - b)) { return null; }
    return a + b;
}

pub fn checked_sub_i32(a: i32, b: i32) -> ?i32 {
    if ((b < 0 and a > I32_MAX + b) or (b > 0 and a < I32_MIN + b)) { return null; }
    return a - b;
}

/// Overflow is decided by division before the product is formed (CERT INT32-C).
pub fn checked_mul_i32(a: i32, b: i32) -> ?i32 {
    if (a > 0) {
        if (b > 0) {
            if (a > I32_MAX / b) { return null; }
        } else {
            if (b < I32_MIN / a) { return null; }
        }
    } else {
        if (b > 0) {
            if (a < I32_MIN / b) { return null; }
        } else {
            if (a != 0 and b < I32_MAX / a) { return null; }
        }
    }
    return a * b;
}

pub fn checked_add_i64(a: i64, b: i64) -> ?i64 {
    if ((b > 0 and a > I64_MAX - b) or (b < 0 and a < I64_MIN - b)) { return null; }
    return a + b;
}

pub fn checked_sub_i64(a: i64, b: i64) -> ?i64 {
    if ((b < 0 and a > I64_MAX + b) or (b > 0 and a < I64_MIN + b)) { return null; }
    return a - b;
}

pub fn checked_mul_i64(a: i64, b: i64) -> ?i64 {
    if (a > 0) {
        if (b > 0) {
            if (a > I64_MAX / b) { return null; }
        } else {
            if (b < I64_MIN / a) { return null; }
        }
    } else {
        if (b > 0) {
            if (a < I64_MIN / b) { return null; }
        } else {
            if (a != 0 and b < I64_MAX / a) { return null; }
        }
    }
    return a * b;
}

// ---------------------------------------------------------------- bit counts

/// u64::count_ones: how many bits of x are set. The narrower unsigned types widen to it (zero bits
/// add nothing); a signed one counts the two's complement pattern through count_ones_i64.
pub fn count_ones_u64(x: u64) -> u32 {
    var c : u32 = 0;
    var y : u64 = x;
    while (y != 0) {
        c = c + ((y & 1) as u32);
        y = y >> 1;
    }
    return c;
}

pub fn count_ones_u8(x: u8) -> u32 {
    return count_ones_u64(x as u64);
}

pub fn count_ones_u16(x: u16) -> u32 {
    return count_ones_u64(x as u64);
}

pub fn count_ones_u32(x: u32) -> u32 {
    return count_ones_u64(x as u64);
}

/// usize is the 64-bit host's (as the oracle's rustc builds for).
pub fn count_ones_usize(x: usize) -> u32 {
    return count_ones_u64(x as u64);
}

/// A negative i64 has 64 - (ones of its complement) set bits; its complement is -1 - x, which is
/// never negative and never overflows (x = MIN gives MAX).
pub fn count_ones_i64(x: i64) -> u32 {
    if (x < 0) { return 64 - count_ones_u64((-1 - x) as u64); }
    return count_ones_u64(x as u64);
}

/// A narrower signed type sign-extends to i64, which adds (64 - width) set bits when it is negative.
pub fn count_ones_i8(x: i8) -> u32 {
    const w : u32 = count_ones_i64(x as i64);
    if (x < 0) { return w - 56; }
    return w;
}

pub fn count_ones_i16(x: i16) -> u32 {
    const w : u32 = count_ones_i64(x as i64);
    if (x < 0) { return w - 48; }
    return w;
}

pub fn count_ones_i32(x: i32) -> u32 {
    const w : u32 = count_ones_i64(x as i64);
    if (x < 0) { return w - 32; }
    return w;
}

/// u64::leading_zeros: the zero bits above the highest set bit, 64 for 0.
pub fn leading_zeros_u64(x: u64) -> u32 {
    var c : u32 = 0;
    var y : u64 = x;
    while (c < 64 and (y & 9223372036854775808) == 0) {
        y = y << 1;
        c = c + 1;
    }
    return c;
}

/// The narrower unsigned types widen to u64, which puts (64 - width) more zeros on top.
pub fn leading_zeros_u8(x: u8) -> u32 {
    return leading_zeros_u64(x as u64) - 56;
}

pub fn leading_zeros_u16(x: u16) -> u32 {
    return leading_zeros_u64(x as u64) - 48;
}

pub fn leading_zeros_u32(x: u32) -> u32 {
    return leading_zeros_u64(x as u64) - 32;
}

pub fn leading_zeros_usize(x: usize) -> u32 {
    return leading_zeros_u64(x as u64);
}

/// A negative signed value has its sign bit set, so no zero above it; otherwise it counts as the
/// unsigned type of its width does.
pub fn leading_zeros_i8(x: i8) -> u32 {
    if (x < 0) { return 0; }
    return leading_zeros_u64(x as u64) - 56;
}

pub fn leading_zeros_i16(x: i16) -> u32 {
    if (x < 0) { return 0; }
    return leading_zeros_u64(x as u64) - 48;
}

pub fn leading_zeros_i32(x: i32) -> u32 {
    if (x < 0) { return 0; }
    return leading_zeros_u64(x as u64) - 32;
}

pub fn leading_zeros_i64(x: i64) -> u32 {
    if (x < 0) { return 0; }
    return leading_zeros_u64(x as u64);
}

/// u64::trailing_zeros: the zero bits below the lowest set bit, 64 for 0.
pub fn trailing_zeros_u64(x: u64) -> u32 {
    if (x == 0) { return 64; }
    var c : u32 = 0;
    var y : u64 = x;
    while ((y & 1) == 0) {
        y = y >> 1;
        c = c + 1;
    }
    return c;
}

/// A zero has its whole width as trailing zeros; any other narrower unsigned value counts as its u64 (widening adds
/// zeros only on top).
pub fn trailing_zeros_u8(x: u8) -> u32 {
    if (x == 0) { return 8; }
    return trailing_zeros_u64(x as u64);
}

pub fn trailing_zeros_u16(x: u16) -> u32 {
    if (x == 0) { return 16; }
    return trailing_zeros_u64(x as u64);
}

pub fn trailing_zeros_u32(x: u32) -> u32 {
    if (x == 0) { return 32; }
    return trailing_zeros_u64(x as u64);
}

pub fn trailing_zeros_usize(x: usize) -> u32 {
    return trailing_zeros_u64(x as u64);
}

/// A signed value is read by halving, which is exact while the low bit is clear (a negative even
/// number halves without remainder), so MIN needs no unsigned cast.
pub fn trailing_zeros_i64(x: i64) -> u32 {
    if (x == 0) { return 64; }
    var c : u32 = 0;
    var y : i64 = x;
    while ((y & 1) == 0) {
        y = y / 2;
        c = c + 1;
    }
    return c;
}

/// Sign extension keeps the low bits, so a narrower signed type counts as its i64.
pub fn trailing_zeros_i8(x: i8) -> u32 {
    if (x == 0) { return 8; }
    return trailing_zeros_i64(x as i64);
}

pub fn trailing_zeros_i16(x: i16) -> u32 {
    if (x == 0) { return 16; }
    return trailing_zeros_i64(x as i64);
}

pub fn trailing_zeros_i32(x: i32) -> u32 {
    if (x == 0) { return 32; }
    return trailing_zeros_i64(x as i64);
}

// ---------------------------------------------------------------- integer pow

/// Rust's `pow` for an integer type, step for step: the squarings and products it makes are the ones
/// below, so the overflow they trap on (a panic in a debug build, a trap here as for every `*` t27o
/// converts) is the same. The exponent is a u32 whatever the base. checked_pow and wrapping_pow are the
/// same loop over checked_mul and `*%`.
pub fn pow_u8(x: u8, e: u32) -> u8 {
    if (e == 0) { return 1; }
    var acc : u8 = 1;
    var base : u8 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_u16(x: u16, e: u32) -> u16 {
    if (e == 0) { return 1; }
    var acc : u16 = 1;
    var base : u16 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_u32(x: u32, e: u32) -> u32 {
    if (e == 0) { return 1; }
    var acc : u32 = 1;
    var base : u32 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_u64(x: u64, e: u32) -> u64 {
    if (e == 0) { return 1; }
    var acc : u64 = 1;
    var base : u64 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_usize(x: usize, e: u32) -> usize {
    if (e == 0) { return 1; }
    var acc : usize = 1;
    var base : usize = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_i8(x: i8, e: u32) -> i8 {
    if (e == 0) { return 1; }
    var acc : i8 = 1;
    var base : i8 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_i16(x: i16, e: u32) -> i16 {
    if (e == 0) { return 1; }
    var acc : i16 = 1;
    var base : i16 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_i32(x: i32, e: u32) -> i32 {
    if (e == 0) { return 1; }
    var acc : i32 = 1;
    var base : i32 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

pub fn pow_i64(x: i64, e: u32) -> i64 {
    if (e == 0) { return 1; }
    var acc : i64 = 1;
    var base : i64 = x;
    var n : u32 = e;
    while (n > 1) {
        if ((n & 1) == 1) { acc = acc * base; }
        n = n / 2;
        base = base * base;
    }
    return acc * base;
}

// ---------------------------------------------------------------- saturating arithmetic

/// u64::saturating_add: a + b, or the largest u64 when that does not fit. hosting::panel has this fn
/// too, but a `use` of it splices 28 modules into the converted spec (#7176), so it is written here,
/// once, with the rest of the family. The unsigned types narrower than 64 bits add and multiply in
/// u64 and clamp; usize is the 64-bit host's.
pub fn saturating_add_u64(a: u64, b: u64) -> u64 {
    if (b > 18446744073709551615 - a) { return 18446744073709551615; }
    return a + b;
}

pub fn saturating_sub_u64(a: u64, b: u64) -> u64 {
    if (b > a) { return 0; }
    return a - b;
}

pub fn saturating_mul_u64(a: u64, b: u64) -> u64 {
    if (a != 0 and b > 18446744073709551615 / a) { return 18446744073709551615; }
    return a * b;
}

pub fn saturating_add_usize(a: usize, b: usize) -> usize {
    return saturating_add_u64(a as u64, b as u64) as usize;
}

pub fn saturating_sub_usize(a: usize, b: usize) -> usize {
    return saturating_sub_u64(a as u64, b as u64) as usize;
}

pub fn saturating_mul_usize(a: usize, b: usize) -> usize {
    return saturating_mul_u64(a as u64, b as u64) as usize;
}

pub fn saturating_add_u32(a: u32, b: u32) -> u32 {
    const r : u64 = (a as u64) + (b as u64);
    if (r > 4294967295) { return 4294967295; }
    return r as u32;
}

pub fn saturating_sub_u32(a: u32, b: u32) -> u32 {
    if (b > a) { return 0; }
    return a - b;
}

pub fn saturating_mul_u32(a: u32, b: u32) -> u32 {
    const r : u64 = (a as u64) * (b as u64);
    if (r > 4294967295) { return 4294967295; }
    return r as u32;
}

pub fn saturating_add_u16(a: u16, b: u16) -> u16 {
    const r : u64 = (a as u64) + (b as u64);
    if (r > 65535) { return 65535; }
    return r as u16;
}

pub fn saturating_sub_u16(a: u16, b: u16) -> u16 {
    if (b > a) { return 0; }
    return a - b;
}

pub fn saturating_mul_u16(a: u16, b: u16) -> u16 {
    const r : u64 = (a as u64) * (b as u64);
    if (r > 65535) { return 65535; }
    return r as u16;
}

pub fn saturating_add_u8(a: u8, b: u8) -> u8 {
    const r : u64 = (a as u64) + (b as u64);
    if (r > 255) { return 255; }
    return r as u8;
}

pub fn saturating_sub_u8(a: u8, b: u8) -> u8 {
    if (b > a) { return 0; }
    return a - b;
}

pub fn saturating_mul_u8(a: u8, b: u8) -> u8 {
    const r : u64 = (a as u64) * (b as u64);
    if (r > 255) { return 255; }
    return r as u8;
}

/// A signed i64 saturates by the direction of the overflow checked_* found: an addition overflows
/// upward when b > 0, a subtraction downward when b > 0, a product upward when the signs agree.
pub fn saturating_add_i64(a: i64, b: i64) -> i64 {
    const r : ?i64 = checked_add_i64(a, b);
    if (r == null) {
        if (b > 0) { return I64_MAX; }
        return I64_MIN;
    }
    return r.?;
}

pub fn saturating_sub_i64(a: i64, b: i64) -> i64 {
    const r : ?i64 = checked_sub_i64(a, b);
    if (r == null) {
        if (b > 0) { return I64_MIN; }
        return I64_MAX;
    }
    return r.?;
}

pub fn saturating_mul_i64(a: i64, b: i64) -> i64 {
    const r : ?i64 = checked_mul_i64(a, b);
    if (r == null) {
        if ((a < 0) == (b < 0)) { return I64_MAX; }
        return I64_MIN;
    }
    return r.?;
}

/// The signed types narrower than 64 bits compute in i64, which holds every sum, difference and
/// product of two of them, and clamp.
pub fn saturating_add_i32(a: i32, b: i32) -> i32 {
    const r : i64 = (a as i64) + (b as i64);
    if (r > 2147483647) { return I32_MAX; }
    if (r < -2147483648) { return I32_MIN; }
    return r as i32;
}

pub fn saturating_sub_i32(a: i32, b: i32) -> i32 {
    const r : i64 = (a as i64) - (b as i64);
    if (r > 2147483647) { return I32_MAX; }
    if (r < -2147483648) { return I32_MIN; }
    return r as i32;
}

pub fn saturating_mul_i32(a: i32, b: i32) -> i32 {
    const r : i64 = (a as i64) * (b as i64);
    if (r > 2147483647) { return I32_MAX; }
    if (r < -2147483648) { return I32_MIN; }
    return r as i32;
}

pub fn saturating_add_i16(a: i16, b: i16) -> i16 {
    const r : i64 = (a as i64) + (b as i64);
    if (r > 32767) { return 32767; }
    if (r < -32768) { return -32768; }
    return r as i16;
}

pub fn saturating_sub_i16(a: i16, b: i16) -> i16 {
    const r : i64 = (a as i64) - (b as i64);
    if (r > 32767) { return 32767; }
    if (r < -32768) { return -32768; }
    return r as i16;
}

pub fn saturating_mul_i16(a: i16, b: i16) -> i16 {
    const r : i64 = (a as i64) * (b as i64);
    if (r > 32767) { return 32767; }
    if (r < -32768) { return -32768; }
    return r as i16;
}

pub fn saturating_add_i8(a: i8, b: i8) -> i8 {
    const r : i64 = (a as i64) + (b as i64);
    if (r > 127) { return 127; }
    if (r < -128) { return -128; }
    return r as i8;
}

pub fn saturating_sub_i8(a: i8, b: i8) -> i8 {
    const r : i64 = (a as i64) - (b as i64);
    if (r > 127) { return 127; }
    if (r < -128) { return -128; }
    return r as i8;
}

pub fn saturating_mul_i8(a: i8, b: i8) -> i8 {
    const r : i64 = (a as i64) * (b as i64);
    if (r > 127) { return 127; }
    if (r < -128) { return -128; }
    return r as i8;
}

// ---------------------------------------------------------------- div_ceil

/// u64::div_ceil: the quotient rounded up. A zero divisor traps, as Rust's panics. The narrower unsigned
/// types widen to u64 (the quotient is never above the dividend, so it narrows back); usize is the
/// 64-bit host's. The signed div_ceil is unstable in Rust and is not here.
pub fn div_ceil_u64(a: u64, b: u64) -> u64 {
    const q : u64 = a / b;
    if (a % b > 0) { return q + 1; }
    return q;
}

pub fn div_ceil_usize(a: usize, b: usize) -> usize {
    return div_ceil_u64(a as u64, b as u64) as usize;
}

pub fn div_ceil_u32(a: u32, b: u32) -> u32 {
    return div_ceil_u64(a as u64, b as u64) as u32;
}

pub fn div_ceil_u16(a: u16, b: u16) -> u16 {
    return div_ceil_u64(a as u64, b as u64) as u16;
}

pub fn div_ceil_u8(a: u8, b: u8) -> u8 {
    return div_ceil_u64(a as u64, b as u64) as u8;
}

// ---------------------------------------------------------------- floats

/// f64::is_finite: neither NaN nor an infinity. x - x is 0 for every finite x and NaN for a NaN and for an
/// infinity, so the test needs no infinity constant and no bit reading.
pub fn is_finite_f64(x: f64) -> bool {
    return (x - x) == 0.0;
}

pub fn is_finite_f32(x: f32) -> bool {
    return (x - x) == 0.0;
}

/// f64::to_bits: the IEEE 754 binary64 pattern of x, every bit of a NaN's payload kept. `@bitCast` is exact
/// in the Zig and t27b backends (specs/tri/t27b/conformance/bit_cast.t27 pins it); gen-rust prints it as
/// written, which rustc does not read, so converted output that calls this fn is for those two.
pub fn to_bits_f64(x: f64) -> u64 {
    const b : u64 = @bitCast(x);
    return b;
}

pub fn to_bits_f32(x: f32) -> u32 {
    const b : u32 = @bitCast(x);
    return b;
}

/// f64::from_bits, the inverse of to_bits_f64: the float of a binary64 pattern. It builds the NaNs and the
/// infinities the tests below need; the table does not map a path call to it.
pub fn from_bits_f64(b: u64) -> f64 {
    const x : f64 = @bitCast(b);
    return x;
}

pub fn from_bits_f32(b: u32) -> f32 {
    const x : f32 = @bitCast(b);
    return x;
}

// ---------------------------------------------------------------- ASCII

/// u8::is_ascii: the byte is below 128 (char::is_ascii is the same test on the ASCII corpus).
pub fn is_ascii_u8(b: u8) -> bool {
    return b < 128;
}

/// str::is_ascii and [u8]::is_ascii: every byte is below 128; the empty text is ASCII.
pub fn is_ascii_text(s: []const u8) -> bool {
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] >= 128) { return false; }
        i += 1;
    }
    return true;
}

/// u8::to_ascii_lowercase: A-Z become a-z, every other byte (control, digit, punctuation, above 127) stays.
pub fn to_ascii_lowercase_u8(b: u8) -> u8 {
    if (b >= 65 and b <= 90) { return b + 32; }
    return b;
}

/// u8::to_ascii_uppercase: a-z become A-Z, every other byte stays.
pub fn to_ascii_uppercase_u8(b: u8) -> u8 {
    if (b >= 97 and b <= 122) { return b - 32; }
    return b;
}

// ---------------------------------------------------------------- slice get

/// [T]::get(i) for a scalar T: the element at i, or null past the end. Option<&T> is ?T here (a reference to a
/// scalar is the scalar); get(a..b) is not this fn, the converter leaves a range alone. The element is bound
/// before it is returned: gen-rust wraps a returned name in Some(..) but not a returned index.
pub fn get_u8(xs: []const u8, i: usize) -> ?u8 {
    if (i >= xs.len) { return null; }
    const v : u8 = xs[i];
    return v;
}

pub fn get_u16(xs: []const u16, i: usize) -> ?u16 {
    if (i >= xs.len) { return null; }
    const v : u16 = xs[i];
    return v;
}

pub fn get_u32(xs: []const u32, i: usize) -> ?u32 {
    if (i >= xs.len) { return null; }
    const v : u32 = xs[i];
    return v;
}

pub fn get_u64(xs: []const u64, i: usize) -> ?u64 {
    if (i >= xs.len) { return null; }
    const v : u64 = xs[i];
    return v;
}

pub fn get_usize(xs: []const usize, i: usize) -> ?usize {
    if (i >= xs.len) { return null; }
    const v : usize = xs[i];
    return v;
}

pub fn get_i8(xs: []const i8, i: usize) -> ?i8 {
    if (i >= xs.len) { return null; }
    const v : i8 = xs[i];
    return v;
}

pub fn get_i16(xs: []const i16, i: usize) -> ?i16 {
    if (i >= xs.len) { return null; }
    const v : i16 = xs[i];
    return v;
}

pub fn get_i32(xs: []const i32, i: usize) -> ?i32 {
    if (i >= xs.len) { return null; }
    const v : i32 = xs[i];
    return v;
}

pub fn get_i64(xs: []const i64, i: usize) -> ?i64 {
    if (i >= xs.len) { return null; }
    const v : i64 = xs[i];
    return v;
}

pub fn get_f32(xs: []const f32, i: usize) -> ?f32 {
    if (i >= xs.len) { return null; }
    const v : f32 = xs[i];
    return v;
}

pub fn get_f64(xs: []const f64, i: usize) -> ?f64 {
    if (i >= xs.len) { return null; }
    const v : f64 = xs[i];
    return v;
}

// ---------------------------------------------------------------- slice contains

/// [T]::contains(&x) for a scalar T: some element is `==` x, so a NaN is never contained and -0.0 is 0.0.
/// (The u8 slice is bytes_contain, above.)
pub fn contains_u16(xs: []const u16, x: u16) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_u32(xs: []const u32, x: u32) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_u64(xs: []const u64, x: u64) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_usize(xs: []const usize, x: usize) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_i8(xs: []const i8, x: i8) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_i16(xs: []const i16, x: i16) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_i32(xs: []const i32, x: i32) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_i64(xs: []const i64, x: i64) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_f32(xs: []const f32, x: f32) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

pub fn contains_f64(xs: []const f64, x: f64) -> bool {
    var i : usize = 0;
    while (i < xs.len) {
        if (xs[i] == x) { return true; }
        i += 1;
    }
    return false;
}

/// str::contains with a char held in a variable (t27o holds a char as its u32 scalar value): the char's UTF-8
/// bytes occur in s. A char literal needle never gets here, it is written as the one-byte text it is.
pub fn str_contains_char(s: []const u8, c: u32) -> bool {
    var enc : [4]u8 = [0, 0, 0, 0];
    var n : usize = 1;
    if (c < 128) {
        enc[0] = c as u8;
    } else if (c < 2048) {
        enc[0] = (192 + (c >> 6)) as u8;
        enc[1] = (128 + (c & 63)) as u8;
        n = 2;
    } else if (c < 65536) {
        enc[0] = (224 + (c >> 12)) as u8;
        enc[1] = (128 + ((c >> 6) & 63)) as u8;
        enc[2] = (128 + (c & 63)) as u8;
        n = 3;
    } else {
        enc[0] = (240 + (c >> 18)) as u8;
        enc[1] = (128 + ((c >> 12) & 63)) as u8;
        enc[2] = (128 + ((c >> 6) & 63)) as u8;
        enc[3] = (128 + (c & 63)) as u8;
        n = 4;
    }
    return find_text(s, enc[0 .. n]) != null;
}

/// Append t at w; the new write cursor. A String's push_str, lowered by t27o (#9098): the owned
/// String goes through a caller's buffer, and push_str is one append onto it.
pub fn append_text(out: []u8, w: usize, t: []const u8) -> usize {
    var i : usize = 0;
    while (i < t.len) {
        if (w + i < out.len) { out[w + i] = t[i]; }
        i = i + 1;
    }
    return w + t.len;
}

/// Append c as its UTF-8 bytes; the new write cursor. A String's push(char), lowered by t27o. The
/// lengths are RFC 3629's (1, 2, 3 or 4 bytes), each continuation 10xxxxxx.
pub fn append_char(out: []u8, w: usize, c: u32) -> usize {
    if (c < 128) {
        if (w < out.len) { out[w] = c as u8; }
        return w + 1;
    }
    if (c < 2048) {
        if (w + 1 < out.len) {
            out[w] = (192 + c / 64) as u8;
            out[w + 1] = (128 + c % 64) as u8;
        }
        return w + 2;
    }
    if (c < 65536) {
        if (w + 2 < out.len) {
            out[w] = (224 + c / 4096) as u8;
            out[w + 1] = (128 + (c / 64) % 64) as u8;
            out[w + 2] = (128 + c % 64) as u8;
        }
        return w + 3;
    }
    if (w + 3 < out.len) {
        out[w] = (240 + c / 262144) as u8;
        out[w + 1] = (128 + (c / 4096) % 64) as u8;
        out[w + 2] = (128 + (c / 64) % 64) as u8;
        out[w + 3] = (128 + c % 64) as u8;
    }
    return w + 4;
}

/// Append v's decimal digits; the new write cursor. format!'s `{}` of an unsigned integer, lowered
/// by t27o. The digits are built back to front into a 20-byte buffer (u64's longest is 20), then
/// copied forwards.
pub fn append_uint(out: []u8, w: usize, v: u64) -> usize {
    var r : [20]u8 = undefined;
    var n : usize = 0;
    var x : u64 = v;
    while (true) {
        r[n] = 48 + ((x % 10) as u8);
        n = n + 1;
        x = x / 10;
        if (x == 0) { break; }
    }
    var i : usize = 0;
    while (i < n) {
        if (w + i < out.len) { out[w + i] = r[n - 1 - i]; }
        i = i + 1;
    }
    return w + n;
}

/// Append v's decimal digits with a `-` before them when negative; the new write cursor.
/// format!'s `{}` of a signed integer, lowered by t27o. i64's own minimum is written through u64
/// (its absolute value does not fit i64), the way rustc prints it.
pub fn append_int(out: []u8, w: usize, v: i64) -> usize {
    if (v >= 0) { return append_uint(out, w, v as u64); }
    if (w < out.len) { out[w] = 45; }
    if (v == -9223372036854775807 - 1) { return append_uint(out, w + 1, 9223372036854775808); }
    return append_uint(out, w + 1, (0 - v) as u64);
}

// ---------------------------------------------------------------- tests
// One test per entry (or group of entries): the t27 an entry writes, run on vectors whose expected
// values Rust's std printed (rustc 1.99 debug on the t27c lab).

test std_contains_starts_with_ends_with_and_eq {
    assert(str_contains("abc", "b"));
    assert(!toolchain::starts_with("abc", "b"));
    assert(!toolchain::ends_with("abc", "b"));
    assert(!type_text::same("abc", "b"));
    assert(str_contains("abc", ""));
    assert(toolchain::starts_with("abc", ""));
    assert(toolchain::ends_with("abc", ""));
    assert(!type_text::same("abc", ""));
    assert(!str_contains("", "a"));
    assert(!toolchain::starts_with("", "a"));
    assert(!toolchain::ends_with("", "a"));
    assert(!type_text::same("", "a"));
    assert(!str_contains("abc", "abcd"));
    assert(!toolchain::starts_with("abc", "abcd"));
    assert(!toolchain::ends_with("abc", "abcd"));
    assert(!type_text::same("abc", "abcd"));
    assert(str_contains("aab", "ab"));
    assert(!toolchain::starts_with("aab", "ab"));
    assert(toolchain::ends_with("aab", "ab"));
    assert(!type_text::same("aab", "ab"));
    assert(str_contains("abc", "c"));
    assert(!toolchain::starts_with("abc", "c"));
    assert(toolchain::ends_with("abc", "c"));
    assert(!type_text::same("abc", "c"));
    assert(!str_contains("abc", "ac"));
    assert(!toolchain::starts_with("abc", "ac"));
    assert(!toolchain::ends_with("abc", "ac"));
    assert(!type_text::same("abc", "ac"));
    assert(str_contains("", ""));
    assert(toolchain::starts_with("", ""));
    assert(toolchain::ends_with("", ""));
    assert(type_text::same("", ""));
    const nul : [4]u8 = [97, 98, 99, 0];
    assert(bytes_contain(nul[0 .. 4], 97));
    assert(!bytes_contain(nul[0 .. 4], 122));
    assert(bytes_contain(nul[0 .. 4], 0));
}

