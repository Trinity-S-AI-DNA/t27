    assert(div_ceil_usize(9223372036854775808, 4294967295) == 2147483649);
    assert(div_ceil_usize(9223372036854775808, 4294967296) == 2147483648);
    assert(div_ceil_usize(9223372036854775808, 9223372036854775807) == 2);
    assert(div_ceil_usize(9223372036854775808, 9223372036854775808) == 1);
