test std_sum_abs_min_max_and_wrapping {
    const u : [4]u32 = [1, 2, 3, 4000000000];
    assert(sum_u32(u[0 .. 3]) == 6);
    assert(sum_u32(u[0 .. 0]) == 0);
    const i : [3]i64 = [-5, 7, -9223372036854775807];
    assert(sum_i64(i[0 .. 3]) == -9223372036854775805);
    const f : [3]f64 = [0.5, 1.25, -2.0];
    assert(sum_f64(f[0 .. 3]) == -0.25);
    assert(abs_i32(0) == 0);
    assert(abs_i32(1) == 1);
    assert(abs_i32(-1) == 1);
    assert(abs_i32(7) == 7);
    assert(abs_i32(-100) == 100);
    assert(abs_i32(2147483647) == 2147483647);
    assert(abs_i64(0) == 0);
    assert(abs_i64(-1) == 1);
    assert(abs_i64(-9223372036854775807) == 9223372036854775807);
    assert(abs_i8(-127) == 127);
    assert(abs_i8(5) == 5);
    assert(abs_i16(-32767) == 32767);
    assert(abs_i16(3) == 3);
    assert(@abs(@as(f64, -1.5)) == 1.5);
    assert(@abs(@as(f64, 0.0)) == 0.0);
    assert(@abs(@as(f64, 2.5)) == 2.5);
    assert(@abs(@as(f64, -0.0)) == 0.0);
    assert(@min(@as(f64, 1.0), 2.0) == 1.0);
    assert(@max(@as(f64, 1.0), 2.0) == 2.0);
    assert(@max(@as(f32, 1.0), 2.0) == 2.0);
    assert(@min(@as(f64, 2.0), 1.0) == 1.0);
    assert(@max(@as(f64, 2.0), 1.0) == 2.0);
    assert(@max(@as(f32, 2.0), 1.0) == 2.0);
    assert(@min(@as(f64, -3.5), -3.25) == -3.5);
    assert(@max(@as(f64, -3.5), -3.25) == -3.25);
    assert(@max(@as(f32, -3.5), -3.25) == -3.25);
    assert(@min(@as(u32, 3), @as(u32, 9)) == 3);
    assert(@max(@as(u32, 3), @as(u32, 9)) == 9);
    assert(@min(@as(u32, 9), @as(u32, 3)) == 3);
    assert(@max(@as(u32, 9), @as(u32, 3)) == 9);
    assert(@min(@as(u32, 0), @as(u32, 4294967295)) == 0);
    assert(@max(@as(u32, 0), @as(u32, 4294967295)) == 4294967295);
    assert((@as(u8, 255) +% @as(u8, 1)) == 0);
    assert((@as(u8, 255) -% @as(u8, 1)) == 254);
    assert((@as(u8, 255) *% @as(u8, 1)) == 255);
    assert((@as(u8, 0) +% @as(u8, 1)) == 1);
    assert((@as(u8, 0) -% @as(u8, 1)) == 255);
    assert((@as(u8, 0) *% @as(u8, 1)) == 0);
    assert((@as(u8, 16) +% @as(u8, 16)) == 32);
    assert((@as(u8, 16) -% @as(u8, 16)) == 0);
    assert((@as(u8, 16) *% @as(u8, 16)) == 0);
    const s : [3]u8 = [7, 8, 9];
    assert(s[0 .. 3].len == 3 and (s[0 .. 0].len == 0) == true);
}

test std_checked_arithmetic {
    assert(checked_add_u32(0, 0).? == 0);
    assert(checked_sub_u32(0, 0).? == 0);
    assert(checked_mul_u32(0, 0).? == 0);
    assert(checked_add_u32(0, 1).? == 1);
    assert(checked_sub_u32(0, 1) == null);
    assert(checked_mul_u32(0, 1).? == 0);
    assert(checked_add_u32(0, 7).? == 7);
    assert(checked_sub_u32(0, 7) == null);
    assert(checked_mul_u32(0, 7).? == 0);
    assert(checked_add_u32(0, 65536).? == 65536);
    assert(checked_sub_u32(0, 65536) == null);
    assert(checked_mul_u32(0, 65536).? == 0);
    assert(checked_add_u32(0, 4294967295).? == 4294967295);
    assert(checked_sub_u32(0, 4294967295) == null);
    assert(checked_mul_u32(0, 4294967295).? == 0);
    assert(checked_add_u32(1, 0).? == 1);
    assert(checked_sub_u32(1, 0).? == 1);
    assert(checked_mul_u32(1, 0).? == 0);
    assert(checked_add_u32(1, 1).? == 2);
    assert(checked_sub_u32(1, 1).? == 0);
    assert(checked_mul_u32(1, 1).? == 1);
    assert(checked_add_u32(1, 7).? == 8);
    assert(checked_sub_u32(1, 7) == null);
    assert(checked_mul_u32(1, 7).? == 7);
    assert(checked_add_u32(1, 65536).? == 65537);
    assert(checked_sub_u32(1, 65536) == null);
    assert(checked_mul_u32(1, 65536).? == 65536);
    assert(checked_add_u32(1, 4294967295) == null);
    assert(checked_sub_u32(1, 4294967295) == null);
    assert(checked_mul_u32(1, 4294967295).? == 4294967295);
    assert(checked_add_u32(7, 0).? == 7);
    assert(checked_sub_u32(7, 0).? == 7);
    assert(checked_mul_u32(7, 0).? == 0);
    assert(checked_add_u32(7, 1).? == 8);
    assert(checked_sub_u32(7, 1).? == 6);
    assert(checked_mul_u32(7, 1).? == 7);
    assert(checked_add_u32(7, 7).? == 14);
    assert(checked_sub_u32(7, 7).? == 0);
    assert(checked_mul_u32(7, 7).? == 49);
    assert(checked_add_u32(7, 65536).? == 65543);
    assert(checked_sub_u32(7, 65536) == null);
    assert(checked_mul_u32(7, 65536).? == 458752);
    assert(checked_add_u32(7, 4294967295) == null);
    assert(checked_sub_u32(7, 4294967295) == null);
    assert(checked_mul_u32(7, 4294967295) == null);
    assert(checked_add_u32(65536, 0).? == 65536);
    assert(checked_sub_u32(65536, 0).? == 65536);
    assert(checked_mul_u32(65536, 0).? == 0);
    assert(checked_add_u32(65536, 1).? == 65537);
    assert(checked_sub_u32(65536, 1).? == 65535);
    assert(checked_mul_u32(65536, 1).? == 65536);
    assert(checked_add_u32(65536, 7).? == 65543);
    assert(checked_sub_u32(65536, 7).? == 65529);
    assert(checked_mul_u32(65536, 7).? == 458752);
    assert(checked_add_u32(65536, 65536).? == 131072);
    assert(checked_sub_u32(65536, 65536).? == 0);
    assert(checked_mul_u32(65536, 65536) == null);
    assert(checked_add_u32(65536, 4294967295) == null);
    assert(checked_sub_u32(65536, 4294967295) == null);
    assert(checked_mul_u32(65536, 4294967295) == null);
    assert(checked_add_u32(4294967295, 0).? == 4294967295);
