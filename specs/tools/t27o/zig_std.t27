// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/zig_std.t27 -- the t27 behind the Zig front end's std table (#10823): what a converted .zig spec `use`s
; where Zig's std has no t27 builtin that means the same. It sits beside zig_convert.t27 as rust_std.t27 sits beside
; rust_convert.t27; zig_convert.t27 writes a call of an entry here and a `use` line, and `t27b test` runs the file's own
; tests against it.
; --
; std.math.pow(f64, x, y) (std_math_pow_f64). Zig 0.16's std/math/pow.zig is a port of Go's math.Pow, not libm's pow: the
; integer part of y is taken by squaring the significand of x (frexp) and counting the exponent apart, the fractional part
; is exp(yf * log(x)), and the result is scaled once at the end. So an integer power by plain repeated multiplication is
; NOT Zig's result (the negative control below finds vectors where it differs in the last bits). This is that algorithm,
; step for step, in operations t27b and t27c both have:
; - `@exp` and `@log` of a run-time f64 are the routines Zig's compiler_rt has (t27b runs ports of them, specs/tri/t27b/
;   libm.t27, bit for bit; t27c writes Zig's own builtin); `@sqrt` is the IEEE square root; `@floor` of a non-negative f64
;   is Zig's `@trunc` there.
; - `math.frexp` is an exact function of its operand (read off the bits here). `math.ldexp` (`scalbn`) is Zig's own
;   integer code, ported as it is: its rounding of a subnormal result is NOT the IEEE tie rule in every case (see
;   zs_ldexp), so an exact power-of-two product (musl's scalbn) is not Zig's result, and the recorded vectors include the
;   case that shows it.
; The vectors below were recorded with Zig 0.16.0 (zig run, Debug, no libc): for each pair (x, y) the program in the
; comment above `ZS_POW_VEC` printed the bits of x, of y and of `std.math.pow(f64, x, y)`. A result the test compares is
; the bits, except a NaN, which has to be a NaN.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oZigStd;

// `@clz` of a u64, by a loop.
pub fn zs_clz64(v: u64) -> i32 {
    var n : i32 = 0;
    var b : u64 = 0x8000000000000000;
    while (b != 0 and (v & b) == 0) {
        n = n + 1;
        b = b >> 1;
    }
    return n;
}

// math.ldexp of an f64 (std/math/ldexp.zig, which math.scalbn is): x * 2^n on the bits. A subnormal result is rounded to
// nearest on the shifted-out bit, and an exact tie is cleared to even only when `@ctz(repr) == shift - 1` -- a test on
// the whole representation, exponent bits included. For a significand of 0.5 (all fraction bits zero) the exponent
// field's own trailing zeros make that false, so 0.5 * 2^-1074 = 2^-1075, a tie, becomes 2^-1074 and not 0, where musl's
// scalbn gives 0. Zig's result is the one a converted file saw, so this is Zig's code, not the IEEE rule: `@ctz(repr) ==
// shift - 1` is written as `(repr & low) == half` (the low `shift` bits are 1 then zeros), as specs/tri/t27b/libm.t27 does.
pub fn zs_ldexp(x: f64, n: i32) -> f64 {
    const repr : u64 = @bitCast(x);
    const sign : u64 = repr & 0x8000000000000000;
    if (x != x or (repr & 0x7FF0000000000000) == 0x7FF0000000000000) {
        return x;
    }
    var exponent : i32 = @intCast((repr & 0x7FFFFFFFFFFFFFFF) >> 52);
    if (exponent == 0) {
        exponent = exponent + 11 - zs_clz64((repr & 0x7FFFFFFFFFFFFFFF) << 1);
    }
    if (n >= 0) {
        if (n > 2046 - exponent) {
            return @bitCast(0x7FF0000000000000 | sign);
        }
        if (exponent + n <= 0) {
            return @bitCast(((repr & 0x7FFFFFFFFFFFFFFF) << n) | sign);
        }
        if (exponent <= 0) {
            const ne : u64 = @intCast(n + exponent);
            const frac : u64 = ((repr & 0x7FFFFFFFFFFFFFFF) << (1 - exponent)) & 0x000FFFFFFFFFFFFF;
            return @bitCast((ne << 52) | frac | sign);
        }
        const nu : u64 = @intCast(n);
        return @bitCast(repr + (nu << 52));
    }
    if (n <= 0 - exponent) {
        if (n < 0 - (52 + exponent)) {
            return @bitCast(sign);
        }
        var s : i32 = 0 - n;
        if (1 - (exponent + n) < s) {
            s = 1 - (exponent + n);
        }
        const shift : u64 = @intCast(s);
        const low : u64 = 0xFFFFFFFFFFFFFFFF >> (64 - shift);
        const half : u64 = low ^ (low >> 1);
        var result : u64 = repr & 0x000FFFFFFFFFFFFF;
        if (exponent > 0) {
            result = result | 0x0010000000000000;
        }
        result = result >> (shift - 1);
        result = (result + 1) >> 1;
        if ((repr & low) == half) {
            result = result & 0xFFFFFFFFFFFFFFFE;
        }
        return @bitCast(result | sign);
    }
    const nn : u64 = @intCast(0 - n);
    return @bitCast(repr - (nn << 52));
}

// math.frexp of a finite x that is not zero: x = significand * 2^exponent, |significand| in [0.5, 1). A subnormal is scaled
// by 2^54 first (exact), so its exponent field is that of a normal number.
pub fn zs_frexp_exp(x: f64) -> i32 {
    const u : u64 = @bitCast(x);
    const e : i32 = @intCast((u >> 52) & 0x7FF);
    if (e == 0) {
        const v : u64 = @bitCast(x * 18014398509481984.0);
        const e2 : i32 = @intCast((v >> 52) & 0x7FF);
        return e2 - 1022 - 54;
    }
    return e - 1022;
}

pub fn zs_frexp_sig(x: f64) -> f64 {
    var u : u64 = @bitCast(x);
    if (((u >> 52) & 0x7FF) == 0) {
        u = @bitCast(x * 18014398509481984.0);
    }
    return @bitCast((u & 0x800FFFFFFFFFFFFF) | 0x3FE0000000000000);
}

// pow.zig `isOddInteger`: |x| >= 2^53 is even; else x has no fraction and an odd integer part.
pub fn zs_is_odd_integer(x: f64) -> bool {
    const a : f64 = @abs(x);
    if (a >= 9007199254740992.0) {
        return false;
    }
    const ip : f64 = @floor(a);
    const i : i64 = @intFromFloat(ip);
    return a - ip == 0.0 and (i & 1) == 1;
}

// The sign bit of x: 1 for -0.0 and the negatives, 0 for +0.0 and the positives.
pub fn zs_sign(x: f64) -> u64 {
    const u : u64 = @bitCast(x);
    return u >> 63;
}

// std.math.pow(f64, x, y), Zig 0.16 std/math/pow.zig.
pub fn std_math_pow_f64(x: f64, y: f64) -> f64 {
    const inf : f64 = std.math.inf(f64);
    if (y == 0.0 or x == 1.0) {
        return 1.0;
    }
    if (x != x or y != y) {
        return std.math.nan(f64);
    }
    if (y == 1.0) {
        return x;
    }
    if (x == 0.0) {
        if (y < 0.0) {
            if (zs_is_odd_integer(y)) {
                if (zs_sign(x) == 1) {
                    return -inf;
                }
                return inf;
            }
            return inf;
        }
        if (zs_is_odd_integer(y)) {
            return x;
        }
        return 0.0;
    }
    if (y == inf or y == -inf) {
        if (x == -1.0) {
            return 1.0;
        }
        if ((@abs(x) < 1.0) == (y == inf)) {
            return 0.0;
        }
        return inf;
    }
    if (x == inf or x == -inf) {
        if (x == -inf) {
            return std_math_pow_f64(1.0 / x, -y);
        }
        if (y < 0.0) {
            return 0.0;
        }
        if (y > 0.0) {
            return inf;
        }
    }
    if (y == 0.5) {
        return @sqrt(x);
    }
    if (y == -0.5) {
        return 1.0 / @sqrt(x);
    }
    const ay : f64 = @abs(y);
    var yi : f64 = @floor(ay);
    var yf : f64 = ay - yi;
    if (yf != 0.0 and x < 0.0) {
        return std.math.nan(f64);
    }
    if (yi >= 9223372036854775808.0) {
        return @exp(y * @log(@abs(x)));
    }
    var a1 : f64 = 1.0;
    var ae : i32 = 0;
    if (yf != 0.0) {
        if (yf > 0.5) {
            yf = yf - 1.0;
            yi = yi + 1.0;
        }
        a1 = @exp(yf * @log(x));
    }
    var xe : i32 = zs_frexp_exp(x);
    var x1 : f64 = zs_frexp_sig(x);
    var i : i64 = @intFromFloat(yi);
    while (i != 0) {
        if (xe < -4096 or 4096 < xe) {
            ae = ae + xe;
            break;
        }
        if ((i & 1) == 1) {
            a1 = a1 * x1;
            ae = ae + xe;
        }
        x1 = x1 * x1;
        xe = xe * 2;
        if (x1 < 0.5) {
            x1 = x1 + x1;
            xe = xe - 1;
        }
        i = i >> 1;
    }
    if (y < 0.0) {
        a1 = 1.0 / a1;
        ae = 0 - ae;
    }
    return zs_ldexp(a1, ae);
}


// The vectors. Recorded with Zig 0.16.0 (`zig run`, Debug, no libc) by a program that read each (x, y) from a table of
// bits and printed `{x:0>16}` of the bits of x, of y and of `std.math.pow(f64, x, y)`; the same for `std.math.ldexp(x, n)`
// (n is stored as n + 4096) and `std.math.frexp(x)` (its exponent is stored as exponent + 2048):
//     const r = std.math.pow(f64, @bitCast(PIN[i]), @bitCast(PIN[i + 1]));
//     std.debug.print("P {x:0>16} {x:0>16} {x:0>16}\n", .{ PIN[i], PIN[i + 1], @as(u64, @bitCast(r)) });
// What they cover: the constants the corpus raises (phi, pi, e, 3, 10, 2, 1/2, phi^-3) to integers from 0 to 100 and down
// to -40; fractional exponents (1/phi, tenths, 3.7, -2.7); the special values (+-0, +-1, +-inf, NaN, a negative base) against
// zero, odd and even integers, a half, an infinity and a NaN; exponents past 2^53 and 2^63; results that overflow, underflow
// to zero or land in the subnormals; random pairs. A literal that ends in f32 or f64 is a float literal to t27, so those
// entries are written in decimal.
