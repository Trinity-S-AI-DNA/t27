test std_math_pow_f64_is_zigs_on_every_recorded_vector {
    var i : usize = 0;
    var bad : usize = 0;
    while (i < 433) {
        const xb : u64 = ZS_POW_VEC[3 * i];
        const yb : u64 = ZS_POW_VEC[3 * i + 1];
        const wb : u64 = ZS_POW_VEC[3 * i + 2];
        const x : f64 = @bitCast(xb);
        const y : f64 = @bitCast(yb);
        const w : f64 = @bitCast(wb);
        const r : f64 = std_math_pow_f64(x, y);
        const rb : u64 = @bitCast(r);
        var ok : bool = rb == wb;
        if (w != w) {
            ok = r != r;
        }
        if (ok == false) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    assert(bad == 0);
}

test zs_ldexp_is_zigs_on_every_recorded_vector_including_the_subnormal_ties {
    var i : usize = 0;
    var bad : usize = 0;
    while (i < 124) {
        const xb : u64 = ZS_LDEXP_VEC[3 * i];
        const nb : u64 = ZS_LDEXP_VEC[3 * i + 1];
        const wb : u64 = ZS_LDEXP_VEC[3 * i + 2];
        const x : f64 = @bitCast(xb);
        var n : i32 = @intCast(nb);
        n = n - 4096;
        const r : f64 = zs_ldexp(x, n);
        const rb : u64 = @bitCast(r);
        if (rb != wb) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    assert(bad == 0);
}

test zs_frexp_is_zigs_on_every_recorded_vector {
    var i : usize = 0;
    var bad : usize = 0;
    while (i < 16) {
        const xb : u64 = ZS_FREXP_VEC[3 * i];
        const sb : u64 = ZS_FREXP_VEC[3 * i + 1];
        const eb : u64 = ZS_FREXP_VEC[3 * i + 2];
        const x : f64 = @bitCast(xb);
        const s : f64 = zs_frexp_sig(x);
        const sbits : u64 = @bitCast(s);
        var e : i32 = @intCast(eb);
        e = e - 2048;
        if (sbits != sb or zs_frexp_exp(x) != e) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    assert(bad == 0);
}

test the_special_values_follow_pow_zig {
    const inf : f64 = std.math.inf(f64);
    const nzb : u64 = 0x8000000000000000;
    const nzero : f64 = @bitCast(nzb);
    assert(std_math_pow_f64(0.0, 0.0) == 1.0);
    assert(std_math_pow_f64(std.math.nan(f64), 0.0) == 1.0);
    assert(std_math_pow_f64(1.0, std.math.nan(f64)) == 1.0);
    assert(std.math.isNan(std_math_pow_f64(std.math.nan(f64), 1.0)));
    assert(std_math_pow_f64(nzero, -3.0) == -inf);
    assert(std_math_pow_f64(nzero, -2.0) == inf);
    assert(std_math_pow_f64(nzero, 3.0) == 0.0);
    assert(zs_sign(std_math_pow_f64(nzero, 3.0)) == 1);
    assert(zs_sign(std_math_pow_f64(nzero, 2.0)) == 0);
    assert(std_math_pow_f64(-1.0, inf) == 1.0);
    assert(std_math_pow_f64(2.0, inf) == inf);
    assert(std_math_pow_f64(2.0, -inf) == 0.0);
    assert(std_math_pow_f64(0.5, inf) == 0.0);
    assert(std_math_pow_f64(-inf, 3.0) == -inf);
    assert(std_math_pow_f64(-inf, 2.0) == inf);
    assert(std_math_pow_f64(inf, -1.0) == 0.0);
    assert(std_math_pow_f64(-8.0, 3.0) == -512.0);
    assert(std_math_pow_f64(9.0, 0.5) == 3.0);
    assert(std_math_pow_f64(4.0, -0.5) == 0.5);
}

test negative_control_a_negative_base_with_a_fraction_is_nan {
    assert(std.math.isNan(std_math_pow_f64(-8.0, 1.5)));
    assert(std.math.isNan(std_math_pow_f64(-2.0, 0.3)));
    assert(std.math.isNan(std_math_pow_f64(-0.5, -2.5)));
}

// Plain repeated multiplication, the obvious port of an integer power: NOT Zig's result.
pub fn zs_naive_powi(x: f64, n: u32) -> f64 {
    var r : f64 = 1.0;
    var k : u32 = 0;
    while (k < n) {
        r = r * x;
        k = k + 1;
    }
    return r;
}

test negative_control_repeated_multiplication_is_not_zigs_pow_and_the_vectors_tell_them_apart {
    // phi^8: 46.9787137637478 by multiplying eight times, 46.97871376374779 by Zig's pow
    const phi : f64 = 1.618033988749895;
    const naive : f64 = zs_naive_powi(phi, 8);
    const naive_bits : u64 = @bitCast(naive);
    const zig_bits : u64 = 0x40477D467E1BB88E;
    const mine : f64 = std_math_pow_f64(phi, 8.0);
    const mine_bits : u64 = @bitCast(mine);
    assert(naive_bits != zig_bits);
    assert(mine_bits == zig_bits);
}

test negative_control_an_exact_tie_below_the_subnormals_rounds_up_in_zig_where_ieee_rounds_to_even {
    // 2^-1075 is half of the smallest subnormal. 0.5 * 2^-1074 rounds to even: 0. Zig's ldexp gives 2^-1074.
    const one : u64 = 1;
    const tiny : f64 = @bitCast(one);
    const ieee : f64 = 0.5 * tiny;
    const ieee_bits : u64 = @bitCast(ieee);
    const zig : f64 = zs_ldexp(0.5, -1074);
    const zig_bits : u64 = @bitCast(zig);
    assert(ieee_bits == 0);
    assert(zig_bits == 1);
    assert(std_math_pow_f64(2.0, -1075.0) == tiny);
}
