// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/golden.t27 -- the golden criteria of #8997 (epic #8998): what makes a t27o
; conversion a golden spec, in the one place that decides it. The Trinity GitHub App evaluation,
; the report of the t27o workflow and the coverage badge read their answer here; none of them copies
; these criteria into prose. Beside this spec sit the converter (rust_convert.t27) and the std
; table (rust_std.t27) that produce the evidence these criteria judge.
; --
; A converted spec is golden exactly when all of this holds. The first miss is the refusal reason
; the report carries, in this order:
;   1. evidence      at least one recorded oracle vector or translated test exists; "nothing was
;                    checked" is not "everything passed";
;   2. equivalence   every recorded oracle vector agreed and every translated test passed;
;   3. DRY (#8963)   no body duplicates code that exists in t27; a match is `use`d, not copied;
;   4. sealed        the seal was saved and the emitted text still hashes to it;
;   5. provenance    a Sigstore attestation exists AND comes from the workflow run that produced
;                    the spec; an attestation from another run says nothing about this one.
; Everything that fails any criterion goes to the report with its refusal reason, token-free:
; TOKENS_SPENT is 0 on this path, and the only token-spending part is the opt-in bee fallback
; (#8969), which is not on it.
; --
; The honesty clause: golden means equivalent on the recorded vectors and translated tests, not a
; proof for all inputs. Every report says so, golden entries included; HONESTY is the line it
; carries, and a report that omits it overclaims.
; --
; The badge: golden coverage is the share of evaluated specs that are golden, floored, never
; rounded up -- 999 of 1000 reads 99, so a badge that says 100 has earned it.
; The caller records the evidence per converted function; the run ids are u64 because GitHub
; workflow run ids do not fit u32.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oGolden;

; --- Refusal codes, in the order the report checks them. R_NONE is not a refusal. ------------

pub const R_NONE : u32 = 0;
; No recorded vector and no translated test: equivalence was never witnessed.
pub const R_NO_EVIDENCE : u32 = 1;
; A recorded oracle vector disagreed with the output of the original.
pub const R_VECTOR : u32 = 2;
; A translated test failed against the converted body.
pub const R_TEST : u32 = 3;
; A body duplicates code that exists in t27 instead of `use` (#8963).
pub const R_DUPLICATE : u32 = 4;
; The seal is missing, or the emitted text no longer hashes to it.
pub const R_UNSEALED : u32 = 5;
; No Sigstore attestation covers the emitted artifacts.
pub const R_ATTESTATION : u32 = 6;
; The attestation was signed by a run other than the one that produced the spec.
pub const R_RUN_MISMATCH : u32 = 7;
pub const REFUSAL_COUNT : u32 = 8;

; One line a report, whatever it decided. The honesty clause rides with every one of them.
pub const REFUSAL_NAMES : [8]str = [
    "golden",
    "no recorded vector or translated test",
    "an oracle vector disagreed",
    "a translated test failed",
    "duplicates existing t27 code instead of use",
    "not sealed",
    "no sigstore attestation",
    "attestation is not from the producing workflow run",
];

; The honesty clause the report carries, golden entries included (see the header).
pub const HONESTY : str = "golden means equivalent on the recorded vectors and translated tests, not a proof for all inputs";

; LLM tokens this path spends. Zero: the criteria are a decision on recorded evidence, and the
; only token-spending part, the opt-in bee fallback (#8969), is not on this path.
pub const TOKENS_SPENT : u32 = 0;

; --- The decision ---------------------------------------------------------------------------

; True when equivalence was witnessed at all: at least one recorded vector or translated test,
; and every one of them agreed.
pub fn equivalent(vectors_recorded: u32, vectors_passed: u32, tests_recorded: u32, tests_passed: u32) -> bool {
    if (vectors_recorded + tests_recorded == 0) { return false; }
    if (vectors_passed < vectors_recorded) { return false; }
    if (tests_passed < tests_recorded) { return false; }
    return true;
}

; The first criterion that fails, or R_NONE. The order is the order of the report, and it is stable:
; the same evidence always refuses the same way.
pub fn refusal(vectors_recorded: u32, vectors_passed: u32, tests_recorded: u32, tests_passed: u32,
               duplicates: u32, sealed: bool, attested: bool, attestation_run: u64, producing_run: u64) -> u32 {
    if (vectors_recorded + tests_recorded == 0) { return R_NO_EVIDENCE; }
    if (vectors_passed < vectors_recorded) { return R_VECTOR; }
    if (tests_passed < tests_recorded) { return R_TEST; }
    if (duplicates > 0) { return R_DUPLICATE; }
    if (sealed == false) { return R_UNSEALED; }
    if (attested == false) { return R_ATTESTATION; }
    if (attestation_run != producing_run) { return R_RUN_MISMATCH; }
    return R_NONE;
}

pub fn is_golden(vectors_recorded: u32, vectors_passed: u32, tests_recorded: u32, tests_passed: u32,
                 duplicates: u32, sealed: bool, attested: bool, attestation_run: u64, producing_run: u64) -> bool {
    return refusal(vectors_recorded, vectors_passed, tests_recorded, tests_passed,
                   duplicates, sealed, attested, attestation_run, producing_run) == R_NONE;
}

; The report line for a code the caller holds; an unknown code says so rather than guessing.
pub fn refusal_name(code: u32) -> str {
    if (code < REFUSAL_COUNT) { return REFUSAL_NAMES[code]; }
    return "invalid_refusal_code";
}

; The line the report carries after the verdict, golden entries included: the clause that says
; what golden does not mean. A report without it overclaims.
pub fn report_honesty_line() -> str {
    return HONESTY;
}

; --- The badge ------------------------------------------------------------------------------

; Golden coverage of the evaluated specs, floored: a badge never rounds its way up to a claim.
; A golden spec is one of the evaluated specs, so golden > evaluated is an impossible count; it
; refuses the badge (0) rather than rounding up to one more claim.
pub fn coverage_percent(golden: u32, evaluated: u32) -> u32 {
    if (evaluated == 0) { return 0; }
    if (golden > evaluated) { return 0; }
    return (golden * 100) / evaluated;
}

; --- Tests ----------------------------------------------------------------------------------

test a_spec_that_meets_every_criterion_is_golden {
    assert(is_golden(12, 12, 3, 3, 0, true, true, 918273645011, 918273645011));
    assert(refusal(12, 12, 3, 3, 0, true, true, 918273645011, 918273645011) == R_NONE);
    assert(refusal_name(R_NONE) == "golden");
    assert(report_honesty_line() == HONESTY);
}

test nothing_checked_is_refused_not_passed {
    assert(refusal(0, 0, 0, 0, 0, true, true, 5, 5) == R_NO_EVIDENCE);
    assert(is_golden(0, 0, 0, 0, 0, true, true, 5, 5) == false);
    assert(equivalent(0, 0, 0, 0) == false);
    assert(refusal_name(R_NO_EVIDENCE) == "no recorded vector or translated test");
}

test a_disagreeing_vector_refuses {
    assert(refusal(7, 6, 2, 2, 0, true, true, 5, 5) == R_VECTOR);
    assert(is_golden(7, 6, 2, 2, 0, true, true, 5, 5) == false);
    assert(equivalent(7, 6, 2, 2) == false);
    assert(refusal_name(R_VECTOR) == "an oracle vector disagreed");
}

test a_failed_translated_test_refuses {
    assert(refusal(7, 7, 4, 3, 0, true, true, 5, 5) == R_TEST);
    assert(equivalent(7, 7, 4, 3) == false);
    assert(refusal_name(R_TEST) == "a translated test failed");
}

test a_duplicated_body_refuses_even_when_equivalent {
    assert(refusal(9, 9, 1, 1, 1, true, true, 5, 5) == R_DUPLICATE);
    assert(is_golden(9, 9, 1, 1, 1, true, true, 5, 5) == false);
    assert(equivalent(9, 9, 1, 1) == true);
    assert(refusal_name(R_DUPLICATE) == "duplicates existing t27 code instead of use");
}

test an_unsealed_spec_refuses {
    assert(refusal(9, 9, 1, 1, 0, false, true, 5, 5) == R_UNSEALED);
    assert(refusal_name(R_UNSEALED) == "not sealed");
}

test a_missing_attestation_refuses {
    assert(refusal(9, 9, 1, 1, 0, true, false, 5, 5) == R_ATTESTATION);
    assert(refusal_name(R_ATTESTATION) == "no sigstore attestation");
}

test an_attestation_from_another_run_refuses {
    assert(refusal(9, 9, 1, 1, 0, true, true, 5, 6) == R_RUN_MISMATCH);
    assert(is_golden(9, 9, 1, 1, 0, true, true, 5, 6) == false);
    assert(refusal_name(R_RUN_MISMATCH) == "attestation is not from the producing workflow run");
}

test the_first_refusal_wins_and_the_order_is_stable {
    assert(refusal(0, 0, 0, 0, 2, false, false, 1, 2) == R_NO_EVIDENCE);
    assert(refusal(3, 2, 1, 0, 1, false, false, 1, 2) == R_VECTOR);
    assert(refusal(3, 3, 1, 1, 1, false, false, 1, 2) == R_DUPLICATE);
    assert(refusal(3, 3, 1, 1, 0, false, false, 1, 2) == R_UNSEALED);
    assert(refusal(3, 3, 1, 1, 0, true, false, 1, 2) == R_ATTESTATION);
    assert(refusal(10, 9, 0, 0, 0, true, true, 5, 5) == R_VECTOR);
}

test every_code_has_its_name_and_its_place {
    assert(REFUSAL_NAMES.len() == REFUSAL_COUNT);
    assert(refusal_name(0) == "golden");
    var i : u32 = 0;
    while (i < REFUSAL_COUNT) {
        assert(refusal_name(i) != "invalid_refusal_code");
        i += 1;
    }
    assert(refusal_name(REFUSAL_COUNT) == "invalid_refusal_code");
    assert(refusal_name(9999) == "invalid_refusal_code");
}

test the_badge_floors_and_never_overclaims {
    assert(coverage_percent(0, 0) == 0);
    assert(coverage_percent(0, 4) == 0);
    assert(coverage_percent(1, 4) == 25);
    assert(coverage_percent(3, 4) == 75);
    assert(coverage_percent(4, 4) == 100);
    assert(coverage_percent(999, 1000) == 99);
    assert(coverage_percent(7, 4) == 0);
}

invariant the_criteria_path_spends_no_llm_tokens { assert TOKENS_SPENT == 0; }
invariant every_refusal_has_a_name { assert REFUSAL_NAMES.len() == REFUSAL_COUNT; }
invariant the_report_also_names_what_golden_does_not_mean { assert HONESTY == "golden means equivalent on the recorded vectors and translated tests, not a proof for all inputs"; }
invariant the_criteria_are_total { assert REFUSAL_COUNT == 8 and R_NO_EVIDENCE < REFUSAL_COUNT and R_RUN_MISMATCH < REFUSAL_COUNT; }
