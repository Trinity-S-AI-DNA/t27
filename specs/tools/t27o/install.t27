// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/install.t27 -- what the Trinity GitHub App (#8997, epic #8998) installs into a
; repository and registers with GitHub: the t27o workflow it proposes on installation, and the app
; manifest a repository owner one-click-registers from. The app copies WORKFLOW_YAML verbatim to
; DEST_PATH in the installed repository and appends FALLBACK_YAML below the run step while the
; reusable Action of #8996 is unpublished; the manifest is served from one URL GitHub reads, and
; materializing that file is the owner registration step on the #8997 checklist.
; --
; Why no .yml in this repository: hand-written .yml is denied by the owner language rule
; (specs/policy/own_language.t27), and the workflow is this project speaking about itself -- so its
; source lives in the language of this project and the app generates the .yml from it. The user
; repository that receives the copy is not bound by our language rule.
; --
; The criteria every report this workflow emits are judged by live in specs/tools/t27o/golden.t27;
; nothing here restates them, and the template header points the reader there. The oracle runs in
; the installed repository own Actions runners; the deterministic path spends zero LLM tokens.
; --
; GitHub expressions inside the YAML quote their string literals with apostrophes: GitHub accepts
; only single-quoted literals in ${{ }}, and a double-quoted one fails the workflow parse. A t27 str
; holds an apostrophe as an ordinary byte (specs/analog/accept_sar.t27 REFERENCE does).
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27oInstall;

; --- the workflow the app proposes -----------------------------------------------------------

pub const WORKFLOW_NAME : str = "t27o";
pub const DEST_PATH : str = ".github/workflows/t27o.yml";
; The stable name of the reusable Action the #8996 lane publishes (signed standalone t27o binary +
; Action, modes scan / golden / check). That lane has not landed yet; until it does, FALLBACK_YAML
; rides along and names the released binary.
pub const ACTION : str = "gHashTag/t27o-action@v1";
pub const MODES : [3]str = ["scan", "golden", "check"];
pub const DEFAULT_MODE : str = "golden";
pub const PUSH_BRANCHES : [2]str = ["main", "master"];
; What the workflow asks for, nothing more: commit the emitted specs, open the golden PR.
pub const PERMISSIONS : [2]str = ["contents: write", "pull-requests: write"];
; Where the criteria this workflow reports against are decided (one home, not restated here).
pub const CRITERIA_SPEC : str = "specs/tools/t27o/golden.t27";
; The event that makes the app propose this workflow as a pull request (FR-001 of #8997).
pub const INSTALL_EVENT : str = "installation";

pub const WORKFLOW_YAML : str = "# t27o -- proposed by the Trinity GitHub App when it is installed on this repository (#8997).\n# The oracle runs in YOUR Actions runners: your own code on recorded vectors, deterministic,\n# zero LLM tokens; what does not qualify is reported with its refusal reason.\n# The criteria every report is judged by live in gHashTag/t27 specs/tools/t27o/golden.t27:\n# golden means equivalent on the recorded vectors and translated tests, not a proof for all inputs.\nname: t27o\non:\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: scan (coverage report) | golden (convert + oracle + PR) | check (golden specs still match)\n        required: true\n        default: golden\n        type: choice\n        options: [scan, golden, check]\n  push:\n    branches: [main, master]\npermissions:\n  contents: write\n  pull-requests: write\nconcurrency:\n  group: t27o-${{ github.ref }}\n  cancel-in-progress: true\njobs:\n  t27o:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Check out the repository\n        uses: actions/checkout@v4\n      - name: Run t27o\n        uses: gHashTag/t27o-action@v1\n        with:\n          mode: ${{ github.event_name == 'workflow_dispatch' && inputs.mode || 'golden' }}\n          # token: the Trinity App installation token can replace the default GITHUB_TOKEN once\n          # the app is registered, so the golden PR triggers checks like any contributor PR.\n";

; The fallback, all of it YAML comments so nothing in it executes as shipped: while #8996 has not
; published the Action, the installer copies this below the run step and the repository owner
; swaps the step for it. Same contract, released binary direct.
pub const FALLBACK_BINARY : str = "https://github.com/gHashTag/t27/releases/latest/download/t27o-linux-x86_64";
pub const FALLBACK_YAML : str = "# FALLBACK while #8996 has not published the Action above -- the same contract, binary direct.\n# Replace the Run t27o step with this one:\n#   - name: Run t27o (released binary)\n#     run: |\n#       set -eu\n#       curl -fsSL -o t27o https://github.com/gHashTag/t27/releases/latest/download/t27o-linux-x86_64\n#       curl -fsSL -o t27o.sig https://github.com/gHashTag/t27/releases/latest/download/t27o-linux-x86_64.sig\n#       cosign verify-blob --signature t27o.sig --certificate t27o-linux-x86_64.pem t27o\n#       chmod +x t27o\n#       ./t27o golden\n";

; --- the manifest the owner registers ---------------------------------------------------------

pub const APP_NAME : str = "Trinity t27o";
pub const APP_URL : str = "https://t27.ai";
; installation: propose the workflow PR; pull_request: read the golden PRs; workflow_run: collect
; the scan report of each run (FR-001, FR-002 of #8997). No admin, no other write.
pub const APP_EVENTS : [3]str = ["installation", "pull_request", "workflow_run"];
pub const APP_PERMISSIONS : [3]str = ["contents: write", "pull-requests: write", "metadata: read"];
; The file name of the manifest the owner hosts at one URL; GitHub reads it from there.
pub const MANIFEST_FILE : str = "trinity-app-manifest.yml";
; The form a repository owner opens; GitHub pre-fills registration from the manifest URL.
pub const REGISTER_FORM : str = "https://github.com/settings/apps/new?manifest=";
; Not listed in the marketplace: own repositories first, then opt-in external ones (#8998).
pub const APP_PUBLIC : bool = false;

; What is deliberately NOT in the manifest, and why. A manifest that carried any of these would
; register an app that points at nothing; the owner sets each during registration (checklist,
; issue #8997). The order is the order the checklist asks them in.
pub const NOT_IN_MANIFEST : [3]str = [
    "hook_attributes: the webhook endpoint belongs to the deployed t27-bees backend, which only the owner can deploy and name; the owner sets it in the app settings",
    "redirect_url: receiving the registration code exchange needs that backend; registration succeeds without it and the owner completes setup in the app settings",
    "secrets: APP_ID and the private key are outputs of registration the owner sets as repository secrets; a manifest never carries credentials",
];

pub const MANIFEST_YAML : str = "name: Trinity t27o\ndescription: Installs the t27o workflow into your repository -- deterministic conversion of your code to golden .t27 specs, verified by an oracle in your own Actions runners. Zero LLM tokens; what does not qualify is reported with its refusal reason.\nurl: https://t27.ai\npublic: false\ndefault_events:\n  - installation\n  - pull_request\n  - workflow_run\ndefault_permissions:\n  contents: write\n  pull-requests: write\n  metadata: read\n";

; --- checks ----------------------------------------------------------------------------------

pub const B_HASH : u8 = 35;
pub const B_NL : u8 = 10;

; Whether needle occurs in hay, byte by byte. Every byte is a number (source_text.t27, #7604).
pub fn text_has(hay: []const u8, needle: []const u8) -> bool {
    if (needle.len > hay.len) { return false; }
    const last : usize = hay.len - needle.len;
    var i : usize = 0;
    while (i <= last) {
        var j : usize = 0;
        var same : bool = true;
        while (j < needle.len) {
            if (hay[i + j] != needle[j]) { same = false; }
            j += 1;
        }
        if (same) { return true; }
        i += 1;
    }
    return false;
}

; Whether every line of block starts with a comment marker, so nothing in it executes as shipped.
pub fn block_is_commented(block: []const u8) -> bool {
    var i : usize = 0;
    var at_line_start : bool = true;
    while (i < block.len) {
        if (at_line_start) {
            if (block[i] != B_HASH) { return false; }
            at_line_start = false;
        } else if (block[i] == B_NL) {
            at_line_start = true;
        }
        i += 1;
    }
    return true;
}

pub const B_DOLLAR : u8 = 36;
pub const B_LBRACE : u8 = 123;
pub const B_RBRACE : u8 = 125;
pub const B_DQUOTE : u8 = 34;

; Whether every GitHub expression in yaml quotes its literals the only way GitHub parses: no
; double-quote byte between an opening dollar-brace-brace and its closing brace-brace.
pub fn expressions_single_quoted(yaml: []const u8) -> bool {
    var i : usize = 0;
    var inside : bool = false;
    while (i < yaml.len) {
        if (inside) {
            if (yaml[i] == B_DQUOTE) { return false; }
            if (yaml[i] == B_RBRACE and i + 1 < yaml.len and yaml[i + 1] == B_RBRACE) { inside = false; }
        } else if (yaml[i] == B_DOLLAR and i + 2 < yaml.len and yaml[i + 1] == B_LBRACE and yaml[i + 2] == B_LBRACE) {
            inside = true;
        }
        i += 1;
    }
    return true;
}

; The mode line the template carried until 2026-10-24: double-quoted literals, which GitHub refuses.
pub const MODE_LINE_DOUBLE_QUOTED : str = "          mode: ${{ github.event_name == \"workflow_dispatch\" && inputs.mode || \"golden\" }}\n";

; A dispatch mode the caller may name: exactly the three the #8996 Action defines.
pub fn mode_valid(mode: str) -> bool {
    var i : u32 = 0;
    while (i < MODES.len()) {
        if (MODES[i] == mode) { return true; }
        i += 1;
    }
    return false;
}

; The app proposes the workflow PR on the installation event and on nothing else (FR-001).
pub fn proposes_workflow_pr(event: str) -> bool {
    return event == INSTALL_EVENT;
}

; --- tests -----------------------------------------------------------------------------------

test the_workflow_names_the_stable_action {
    assert(text_has(WORKFLOW_YAML, ACTION));
    assert(ACTION == "gHashTag/t27o-action@v1");
    assert(text_has(WORKFLOW_YAML, "uses: actions/checkout@v4"));
    assert(text_has(WORKFLOW_YAML, DEST_PATH) == false);
}

test the_workflow_expressions_quote_literals_the_way_github_parses {
    assert(expressions_single_quoted(WORKFLOW_YAML));
    assert(expressions_single_quoted(FALLBACK_YAML));
    assert(expressions_single_quoted(MANIFEST_YAML));
    assert(text_has(WORKFLOW_YAML, "github.event_name == 'workflow_dispatch'"));
    assert(text_has(WORKFLOW_YAML, "|| 'golden' }}"));
    ; negative control: the line the template shipped with is refused
    assert(expressions_single_quoted(MODE_LINE_DOUBLE_QUOTED) == false);
    ; a double quote outside an expression is plain YAML and stays allowed
    assert(expressions_single_quoted("name: \"t27o\"\nref: ${{ github.ref }}\n"));
}

test the_template_executes_no_hand_written_shell {
    assert(text_has(WORKFLOW_YAML, "run:") == false);
    assert(text_has(WORKFLOW_YAML, "curl ") == false);
    assert(text_has(WORKFLOW_YAML, "cosign") == false);
}

test the_workflow_requests_only_what_it_needs {
    assert(text_has(WORKFLOW_YAML, PERMISSIONS[0]));
    assert(text_has(WORKFLOW_YAML, PERMISSIONS[1]));
    assert(PERMISSIONS.len() == 2);
    assert(text_has(WORKFLOW_YAML, "admin") == false);
}

test the_dispatch_modes_are_exactly_the_three_of_the_action {
    assert(mode_valid("scan"));
    assert(mode_valid("golden"));
    assert(mode_valid("check"));
    assert(mode_valid(DEFAULT_MODE));
    assert(mode_valid("bogus") == false);
    assert(mode_valid("") == false);
    assert(MODES.len() == 3);
    assert(text_has(WORKFLOW_YAML, "options: [scan, golden, check]"));
}

test the_template_names_the_home_of_the_criteria {
    assert(text_has(WORKFLOW_YAML, CRITERIA_SPEC));
    assert(CRITERIA_SPEC == "specs/tools/t27o/golden.t27");
    assert(text_has(WORKFLOW_YAML, "not a proof for all inputs"));
}

test the_fallback_downloads_the_released_binary_and_never_executes {
    assert(text_has(FALLBACK_YAML, FALLBACK_BINARY));
    assert(text_has(FALLBACK_YAML, "cosign verify-blob"));
    assert(text_has(FALLBACK_YAML, "./t27o golden"));
    assert(block_is_commented(FALLBACK_YAML));
    assert(block_is_commented(WORKFLOW_YAML) == false);
}

test the_app_proposes_the_workflow_only_on_installation {
    assert(proposes_workflow_pr("installation"));
    assert(proposes_workflow_pr("push") == false);
    assert(proposes_workflow_pr("pull_request") == false);
    assert(proposes_workflow_pr("") == false);
}

test the_manifest_requests_exactly_its_three_events {
    assert(text_has(MANIFEST_YAML, "- installation"));
    assert(text_has(MANIFEST_YAML, "- pull_request"));
    assert(text_has(MANIFEST_YAML, "- workflow_run"));
    assert(APP_EVENTS.len() == 3);
    assert(text_has(MANIFEST_YAML, "- push") == false);
    assert(text_has(MANIFEST_YAML, "- issues") == false);
}

test the_manifest_permissions_are_minimal {
    assert(text_has(MANIFEST_YAML, APP_PERMISSIONS[0]));
    assert(text_has(MANIFEST_YAML, APP_PERMISSIONS[1]));
    assert(text_has(MANIFEST_YAML, APP_PERMISSIONS[2]));
    assert(APP_PERMISSIONS.len() == 3);
    assert(text_has(MANIFEST_YAML, "administration") == false);
}

test the_manifest_is_private_until_rollout_opens {
    assert(APP_PUBLIC == false);
    assert(text_has(MANIFEST_YAML, "public: false"));
    assert(text_has(MANIFEST_YAML, APP_URL));
    assert(MANIFEST_FILE == "trinity-app-manifest.yml");
    assert(text_has(REGISTER_FORM, "settings/apps/new?manifest="));
}

test the_manifest_carries_no_webhook_no_redirect_no_secrets {
    assert(text_has(MANIFEST_YAML, "hook_attributes") == false);
    assert(text_has(MANIFEST_YAML, "redirect_url") == false);
    assert(text_has(MANIFEST_YAML, "BEGIN") == false);
    assert(text_has(MANIFEST_YAML, "PRIVATE KEY") == false);
    assert(NOT_IN_MANIFEST.len() == 3);
    assert(text_has(NOT_IN_MANIFEST[0], "hook_attributes"));
    assert(text_has(NOT_IN_MANIFEST[2], "secrets"));
}

; Invariants are proved at comptime, and comptime evaluation is capped (1000 backwards branches),
; so they pin the constants; the text walks that read the whole template live in the tests above,
; which run at runtime where no cap applies.
invariant the_action_and_criteria_are_named_by_their_stable_refs { assert ACTION == "gHashTag/t27o-action@v1" and CRITERIA_SPEC == "specs/tools/t27o/golden.t27"; }
invariant the_manifest_is_private { assert APP_PUBLIC == false; }
invariant the_install_asks_no_more_than_it_needs { assert PERMISSIONS.len() == 2 and APP_PERMISSIONS.len() == 3 and MODES.len() == 3; }
