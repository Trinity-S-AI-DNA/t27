// SPDX-License-Identifier: Apache-2.0
; specs/tools/t27o/spice_census_host.t27 -- the host that runs the block census on one deck file.
; Refs #13651, epic #13650.
; Why. The census of spice_convert.t27 is a function over bytes in memory; nothing read a deck from disk,
; so the epic's table (17 blocks, 249 element lines) could not be reproduced by a command.
; What it does. main reads a deck from stdin (the reference deck is external, pinned by hash, never
; committed), runs `census`, and writes to stdout the census text followed by one "totals:" line:
; blocks, lines and the sum of every kind over all blocks. A deck the converter refuses is written as
; the refusal with its line, and the totals line is not written.
; HOST CALLS: std.c.read on stdin, std.c.write on stdout, std.c.exit (1 empty, 2 size, 3 refused); link libc.
; NOT claimed: a deck at or above CH_SRC bytes is refused, never truncated; the totals are
; sums of census_count, not a second parser.
; Every private name carries the ch_ prefix. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27oSpiceCensusHost;

use tools::t27o::spice_convert::census;
use tools::t27o::spice_convert::census_count;
use tools::t27o::spice_convert::census_lines;
use tools::t27o::spice_convert::NONE;
use tools::t27o::spice_convert::NDEF;
use tools::t27o::spice_convert::ERR_LINE;
use tools::t27o::spice_convert::K_COUNT;
use tools::t27o::spice_convert::CK_B;

pub const CH_SRC : usize = 65536;
pub const CH_WORK : usize = 262144;
pub const CH_OUT : usize = 32768;
pub const CH_ST : usize = 16384;
pub const CH_KINDS : usize = 10;


var ch_src : [65536]u8 = undefined;
var ch_w : [262144]u8 = undefined;
var ch_out : [32768]u8 = undefined;
var ch_st : [16384]usize = undefined;
var ch_line : [256]u8 = undefined;

/// The element cards of `kind` over the top of the deck and every definition.
pub fn ch_total(w: []const u8, st: []usize, kind: usize) -> usize {
    var n : usize = census_count(w, st, NONE, kind);
    var d : usize = 0;
    while (d < st[NDEF]) {
        n = n + census_count(w, st, d, kind);
        d = d + 1;
    }
    return n;
}

fn ch_put_text(dst: []u8, at: usize, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len and at + i < dst.len) {
        dst[at + i] = s[i];
        i = i + 1;
    }
    return at + i;
}

fn ch_put_num(dst: []u8, at: usize, v: usize) -> usize {
    var digits : [20]u8 = undefined;
    var n : usize = 0;
    var x : usize = v;
    if (x == 0) {
        digits[0] = 48;
        n = 1;
    }
    while (x > 0) {
        digits[n] = 48 + @as(u8, @intCast(x % 10));
        n = n + 1;
        x = x / 10;
    }
    var p : usize = at;
    while (n > 0 and p < dst.len) {
        n = n - 1;
        dst[p] = digits[n];
        p = p + 1;
    }
    return p;
}

/// The totals line of an accepted deck: "totals: blocks=B lines=N r= c= l= v= i= e= sub= mos= mim= b=".
pub fn ch_totals(w: []const u8, st: []usize, dst: []u8) -> usize {
    var p : usize = ch_put_text(dst, 0, "totals: blocks=");
    p = ch_put_num(dst, p, st[NDEF] + 1);
    p = ch_put_text(dst, p, " lines=");
    p = ch_put_num(dst, p, census_lines(w, st));
    p = ch_put_text(dst, p, " r=");
    p = ch_put_num(dst, p, ch_total(w, st, 0));
    p = ch_put_text(dst, p, " c=");
    p = ch_put_num(dst, p, ch_total(w, st, 1));
    p = ch_put_text(dst, p, " l=");
    p = ch_put_num(dst, p, ch_total(w, st, 2));
    p = ch_put_text(dst, p, " v=");
    p = ch_put_num(dst, p, ch_total(w, st, 3));
    p = ch_put_text(dst, p, " i=");
    p = ch_put_num(dst, p, ch_total(w, st, 4));
    p = ch_put_text(dst, p, " e=");
    p = ch_put_num(dst, p, ch_total(w, st, 5));
    p = ch_put_text(dst, p, " sub=");
    p = ch_put_num(dst, p, ch_total(w, st, 6));
    p = ch_put_text(dst, p, " mos=");
    p = ch_put_num(dst, p, ch_total(w, st, 7));
    p = ch_put_text(dst, p, " mim=");
    p = ch_put_num(dst, p, ch_total(w, st, 8));
    p = ch_put_text(dst, p, " b=");
    p = ch_put_num(dst, p, ch_total(w, st, CK_B));
    p = ch_put_text(dst, p, "\n");
    return p;
}

fn ch_zero(st: []usize) -> void {
    var i : usize = 0;
    while (i < st.len) {
        st[i] = 0;
        i = i + 1;
    }
}

/// Read the deck on stdin, write the census (or the refusal) and the totals line to stdout.
pub fn main() -> void {
    var len : usize = 0;
    var r : isize = 1;
    while (r > 0 and len < CH_SRC) {
        r = std.c.read(0, ch_src[len..CH_SRC].ptr, CH_SRC - len);
        if (r > 0) {
            len += @as(usize, @intCast(r));
        }
    }
    if (len == 0) { std.c.exit(1); }
    if (len >= CH_SRC) { std.c.exit(2); }
    ch_zero(&ch_st);
    const n : usize = census(ch_src[0 .. len], &ch_w, &ch_out, &ch_st);
    if (n > CH_OUT) { std.c.exit(2); }
    _ = std.c.write(1, ch_out[0..n].ptr, n);
    if (ch_st[ERR_LINE] != 0) { std.c.exit(3); }
    const t : usize = ch_totals(&ch_w, &ch_st, &ch_line);
    _ = std.c.write(1, ch_line[0..t].ptr, t);
}

fn ch_same(a: []const u8, n: usize, b: []const u8) -> bool {
    if (n != b.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_totals_line_sums_every_kind_over_the_top_and_every_block {
    var w : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var st : [3000]usize = undefined;
    var line : [256]u8 = undefined;
    ch_zero(&st);
    const n : usize = census("t\nV1 vdd 0 dc 1.2\n.subckt inv a y vdd vss\nXM1 y a vss vss sg13_lv_nmos w=1.0u l=0.13u ng=1 m=1\nXM2 y a vdd vdd sg13_lv_pmos w=1.0u l=0.13u ng=1 m=1\n.ends\n.subckt buf a y vdd vss\nX1 a m vdd vss inv\nX2 m y vdd vss inv\nC1 y vss 1p\n.ends\nX1 in out vdd 0 buf\nR1 out 0 1k\n.end\n", &w, &out, &st);
    assert n > 0;
    assert st[ERR_LINE] == 0;
    const t : usize = ch_totals(&w, &st, &line);
    assert ch_same(&line, t, "totals: blocks=3 lines=8 r=1 c=1 l=0 v=1 i=0 e=0 sub=3 mos=2 mim=0 b=0\n");
    assert ch_total(&w, &st, NONE) == census_lines(&w, &st);
    assert K_COUNT + 1 == CH_KINDS;
}

test a_number_is_written_in_decimal_and_never_past_the_buffer {
    var b : [8]u8 = undefined;
    assert ch_same(&b, ch_put_num(&b, 0, 0), "0");
    assert ch_same(&b, ch_put_num(&b, 0, 249), "249");
    assert ch_put_num(&b, 6, 12345) == 8;
    assert ch_put_text(&b, 7, "abc") == 8;
}
