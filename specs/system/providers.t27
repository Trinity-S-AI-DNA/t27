// SPDX-License-Identifier: Apache-2.0
// T27 Providers SSOT
// Purpose: the single registry of provider routes, their funding state and
//          their quarantine state. One provider fact, one owner.
//
// Owner: T27_ORDER_RESTORE_01 (issue #12897), 2026-10-30.
//
// OWNS:
//   - provider identity and route scope (local / remote)
//   - the credential REFERENCE name bound to a provider (never the value)
//   - funding state per provider and per credential
//   - quarantine state, and the only event that clears it
//   - the upstream-status to client-status transparency rule
//
// DOES NOT OWN (never restate these facts here):
//   - request-time preflight verdicts and the failure-class taxonomy:
//       specs/system/llm_request_provider_gate.t27
//   - response-side circuit breaker, retry budget, cooldown:
//       specs/system/model_routing_circuit_breaker.t27
//   - rung order, per-rung model, request adaptation:
//       specs/system/model-ladder.t27
//   - key values, rotation, masking, dead-key quarantine:
//       specs/system/credentials.t27
//   - the fact-ownership map of the system layer:
//       specs/system/language-boundary.t27
//
// Live evidence (2026-10-30, local route 127.0.0.1:3131):
//   - ladder up, 5 z.ai keys loaded at start, 4 healthy, 1 quota-exhausted
//     until 2026-11-01, 1 rejected with 401
//   - upstream 429 and 401 were observed directly; they must stay visible
//     to the caller instead of being flattened into a generic 503

module providers;

// ─── Provider identity ─────────────────────────────────────────────────────
//
// Identity only. The base URL, the endpoint and the key live in the host
// configuration and in the secret store; this registry names them.

pub const PROVIDER_T27_LADDER : u8 = 0;  // local loopback route
pub const PROVIDER_ZAI : u8 = 1;         // remote, glm models
pub const PROVIDER_OLLAMA : u8 = 2;      // local loopback route
pub const PROVIDER_DEEPSEEK : u8 = 3;    // remote, blocked until funded
pub const PROVIDER_NVIDIA_NIM : u8 = 4;  // remote, funded models
pub const PROVIDER_UNKNOWN : u8 = 5;

pub const PROVIDER_COUNT : u32 = 5;

// ─── Route scope ───────────────────────────────────────────────────────────

pub const SCOPE_NONE : u8 = 0;
pub const SCOPE_LOCAL : u8 = 1;   // loopback only
pub const SCOPE_REMOTE : u8 = 2;

// ─── Funding state ─────────────────────────────────────────────────────────

pub const FUNDING_UNKNOWN : u8 = 0;      // never verified
pub const FUNDING_FUNDED : u8 = 1;       // verified usable
pub const FUNDING_EXHAUSTED : u8 = 2;    // quota/balance consumed
pub const FUNDING_INVALID : u8 = 3;      // credential rejected
pub const FUNDING_UNVERIFIED : u8 = 4;   // present but not proven

// ─── Route signal ──────────────────────────────────────────────────────────
//
// A signal is an already-observed route event. It is NOT a re-classification
// of a response body: the failure taxonomy is owned by
// specs/system/llm_request_provider_gate.t27.

pub const SIGNAL_NONE : u8 = 0;
pub const SIGNAL_TRANSIENT : u8 = 1;
pub const SIGNAL_UNFUNDED : u8 = 2;
pub const SIGNAL_INVALID_KEY : u8 = 3;
pub const SIGNAL_TERMINAL : u8 = 4;
pub const SIGNAL_NEEDS_CAUSE : u8 = 5;   // status alone is not decisive

// ─── Quarantine state ──────────────────────────────────────────────────────

pub const QUARANTINE_NONE : u8 = 0;
pub const QUARANTINE_UNFUNDED : u8 = 1;
pub const QUARANTINE_INVALID_KEY : u8 = 2;
pub const QUARANTINE_REVIEW : u8 = 3;

// ─── Client status codes used by the transparency rule ─────────────────────

pub const HTTP_OK : u16 = 200;
pub const HTTP_UNAUTHORIZED : u16 = 401;
pub const HTTP_PAYMENT_REQUIRED : u16 = 402;
pub const HTTP_FORBIDDEN : u16 = 403;
pub const HTTP_TOO_MANY_REQUESTS : u16 = 429;
pub const HTTP_SERVICE_UNAVAILABLE : u16 = 503;

// ─── Functions ─────────────────────────────────────────────────────────────

// provider_is_known(p) - identity check against the registry.
pub fn provider_is_known(p: u8) -> bool {
    if (p < PROVIDER_COUNT) {
        return true;
    }
    return false;
}

// route_scope(p) - local routes are loopback only; a remote provider is
// never treated as local, and an unknown provider has no scope at all.
pub fn route_scope(p: u8) -> u8 {
    if (p == PROVIDER_T27_LADDER) {
        return SCOPE_LOCAL;
    }
    if (p == PROVIDER_OLLAMA) {
        return SCOPE_LOCAL;
    }
    if (p == PROVIDER_ZAI or p == PROVIDER_DEEPSEEK or p == PROVIDER_NVIDIA_NIM) {
        return SCOPE_REMOTE;
    }
    return SCOPE_NONE;
}

// local_route_is_loopback_only(p) - a local provider must never be reachable
// from off-host. This is the route form of the loopback law.
pub fn local_route_is_loopback_only(p: u8) -> bool {
    if (route_scope(p) != SCOPE_LOCAL) {
        return false;
    }
    return true;
}

// signal_from_upstream_status(status) - maps an upstream HTTP status to a
// route signal. 429 is deliberately NOT decided here: the same status means
// "rate limit" on one key and "weekly/monthly limit exhausted" on another,
// so the cause must be read before the route state changes.
pub fn signal_from_upstream_status(status: u16) -> u8 {
    if (status == HTTP_UNAUTHORIZED) {
        return SIGNAL_INVALID_KEY;
    }
    if (status == HTTP_PAYMENT_REQUIRED) {
        return SIGNAL_UNFUNDED;
    }
    if (status == HTTP_FORBIDDEN) {
        return SIGNAL_INVALID_KEY;
    }
    if (status == HTTP_TOO_MANY_REQUESTS) {
        return SIGNAL_NEEDS_CAUSE;
    }
    if (status >= 500) {
        return SIGNAL_TRANSIENT;
    }
    return SIGNAL_TERMINAL;
}

// funding_state_from_signal(signal) - the funding fact of a route.
pub fn funding_state_from_signal(signal: u8) -> u8 {
    if (signal == SIGNAL_UNFUNDED) {
        return FUNDING_EXHAUSTED;
    }
    if (signal == SIGNAL_INVALID_KEY) {
        return FUNDING_INVALID;
    }
    if (signal == SIGNAL_TRANSIENT or signal == SIGNAL_TERMINAL) {
        return FUNDING_UNKNOWN;
    }
    if (signal == SIGNAL_NEEDS_CAUSE) {
        return FUNDING_UNVERIFIED;
    }
    return FUNDING_UNKNOWN;
}

// quarantine_for_signal(signal) - what the registry does with a route after
// an observed signal.
pub fn quarantine_for_signal(signal: u8) -> u8 {
    if (signal == SIGNAL_UNFUNDED) {
        return QUARANTINE_UNFUNDED;
    }
    if (signal == SIGNAL_INVALID_KEY) {
        return QUARANTINE_INVALID_KEY;
    }
    if (signal == SIGNAL_TERMINAL) {
        return QUARANTINE_REVIEW;
    }
    return QUARANTINE_NONE;
}

// provider_selectable(p, funding, quarantine) - a quarantined or exhausted
// provider is never selected again on the same evidence.
pub fn provider_selectable(p: u8, funding: u8, quarantine: u8) -> bool {
    if (provider_is_known(p) == false) {
        return false;
    }
    if (quarantine != QUARANTINE_NONE) {
        return false;
    }
    if (funding == FUNDING_EXHAUSTED) {
        return false;
    }
    if (funding == FUNDING_INVALID) {
        return false;
    }
    return true;
}

// provider_verified_funded(p, funding) - only a verified provider may be
// reported as funded. Unknown and unverified are never "funded".
pub fn provider_verified_funded(p: u8, funding: u8) -> bool {
    if (provider_is_known(p) == false) {
        return false;
    }
    return funding == FUNDING_FUNDED;
}

// quarantine_cleared(signal, explicit_reverify) - quarantine is sticky. It is
// cleared only by an explicit re-verification that succeeded, never by the
// passage of time and never by a retry.
pub fn quarantine_cleared(signal: u8, explicit_reverify: bool) -> bool {
    if (explicit_reverify == false) {
        return false;
    }
    if (signal == SIGNAL_UNFUNDED or signal == SIGNAL_INVALID_KEY) {
        return true;
    }
    return false;
}

// client_status_for(upstream_status, signal) - status transparency. The
// caller must see the real reason: 401, 402, 403 and 429 are preserved, and
// 503 is reserved for a genuinely exhausted ladder.
pub fn client_status_for(upstream_status: u16, signal: u8) -> u16 {
    if (upstream_status == HTTP_UNAUTHORIZED) {
        return HTTP_UNAUTHORIZED;
    }
    if (upstream_status == HTTP_PAYMENT_REQUIRED) {
        return HTTP_PAYMENT_REQUIRED;
    }
    if (upstream_status == HTTP_FORBIDDEN) {
        return HTTP_FORBIDDEN;
    }
    if (upstream_status == HTTP_TOO_MANY_REQUESTS) {
        return HTTP_TOO_MANY_REQUESTS;
    }
    if (signal == SIGNAL_UNFUNDED) {
        return HTTP_PAYMENT_REQUIRED;
    }
    if (signal == SIGNAL_INVALID_KEY) {
        return HTTP_UNAUTHORIZED;
    }
    return upstream_status;
}

// ladder_exhausted_status(last_signal) - 503 is used for exactly one case:
// every rung refused and nothing else is left.
pub fn ladder_exhausted_status(last_signal: u8) -> u16 {
    if (last_signal == SIGNAL_NONE) {
        return HTTP_SERVICE_UNAVAILABLE;
    }
    return client_status_for(HTTP_SERVICE_UNAVAILABLE, last_signal);
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "known_providers_have_exactly_one_scope" {
    assert(provider_is_known(PROVIDER_T27_LADDER) == true);
    assert(provider_is_known(PROVIDER_ZAI) == true);
    assert(provider_is_known(PROVIDER_OLLAMA) == true);
    assert(provider_is_known(PROVIDER_DEEPSEEK) == true);
    assert(provider_is_known(PROVIDER_NVIDIA_NIM) == true);
    assert(provider_is_known(PROVIDER_UNKNOWN) == false);
    assert(route_scope(PROVIDER_T27_LADDER) == SCOPE_LOCAL);
    assert(route_scope(PROVIDER_OLLAMA) == SCOPE_LOCAL);
    assert(route_scope(PROVIDER_ZAI) == SCOPE_REMOTE);
    assert(route_scope(PROVIDER_DEEPSEEK) == SCOPE_REMOTE);
    assert(route_scope(PROVIDER_NVIDIA_NIM) == SCOPE_REMOTE);
    assert(route_scope(PROVIDER_UNKNOWN) == SCOPE_NONE);
}

test "local_routes_are_loopback_only" {
    assert(local_route_is_loopback_only(PROVIDER_T27_LADDER) == true);
    assert(local_route_is_loopback_only(PROVIDER_OLLAMA) == true);
    assert(local_route_is_loopback_only(PROVIDER_ZAI) == false);
    assert(local_route_is_loopback_only(PROVIDER_UNKNOWN) == false);
}

test "unfunded_signal_exhausts_funding_and_quarantines_route" {
    var signal = signal_from_upstream_status(HTTP_PAYMENT_REQUIRED);
    assert(signal == SIGNAL_UNFUNDED);
    assert(funding_state_from_signal(signal) == FUNDING_EXHAUSTED);
    assert(quarantine_for_signal(signal) == QUARANTINE_UNFUNDED);
    assert(provider_selectable(PROVIDER_ZAI, FUNDING_EXHAUSTED, QUARANTINE_UNFUNDED) == false);
}

test "invalid_key_signal_quarantines_the_credential_not_the_balance" {
    var signal = signal_from_upstream_status(HTTP_UNAUTHORIZED);
    assert(signal == SIGNAL_INVALID_KEY);
    assert(funding_state_from_signal(signal) == FUNDING_INVALID);
    assert(quarantine_for_signal(signal) == QUARANTINE_INVALID_KEY);
    assert(provider_selectable(PROVIDER_ZAI, FUNDING_INVALID, QUARANTINE_INVALID_KEY) == false);
}

test "rate_limit_status_is_not_decided_without_its_cause" {
    var signal = signal_from_upstream_status(HTTP_TOO_MANY_REQUESTS);
    assert(signal == SIGNAL_NEEDS_CAUSE);
    assert(funding_state_from_signal(signal) == FUNDING_UNVERIFIED);
    assert(quarantine_for_signal(signal) == QUARANTINE_NONE);
}

test "transient_signal_never_quarantines_and_never_claims_funded" {
    var signal = signal_from_upstream_status(HTTP_SERVICE_UNAVAILABLE);
    assert(signal == SIGNAL_TRANSIENT);
    assert(funding_state_from_signal(signal) == FUNDING_UNKNOWN);
    assert(quarantine_for_signal(signal) == QUARANTINE_NONE);
    assert(provider_verified_funded(PROVIDER_ZAI, FUNDING_UNKNOWN) == false);
    assert(provider_verified_funded(PROVIDER_ZAI, FUNDING_FUNDED) == true);
}

test "unknown_funding_is_never_reported_as_funded" {
    assert(provider_verified_funded(PROVIDER_ZAI, FUNDING_UNKNOWN) == false);
    assert(provider_verified_funded(PROVIDER_ZAI, FUNDING_UNVERIFIED) == false);
    assert(provider_verified_funded(PROVIDER_UNKNOWN, FUNDING_FUNDED) == false);
}

test "quarantine_is_sticky_until_explicit_reverification" {
    assert(quarantine_cleared(SIGNAL_UNFUNDED, false) == false);
    assert(quarantine_cleared(SIGNAL_INVALID_KEY, false) == false);
    assert(quarantine_cleared(SIGNAL_UNFUNDED, true) == true);
    assert(quarantine_cleared(SIGNAL_INVALID_KEY, true) == true);
    assert(quarantine_cleared(SIGNAL_TRANSIENT, true) == false);
}

test "client_status_preserves_the_real_cause" {
    assert(client_status_for(HTTP_UNAUTHORIZED, SIGNAL_INVALID_KEY) == HTTP_UNAUTHORIZED);
    assert(client_status_for(HTTP_PAYMENT_REQUIRED, SIGNAL_UNFUNDED) == HTTP_PAYMENT_REQUIRED);
    assert(client_status_for(HTTP_FORBIDDEN, SIGNAL_INVALID_KEY) == HTTP_FORBIDDEN);
    assert(client_status_for(HTTP_TOO_MANY_REQUESTS, SIGNAL_NEEDS_CAUSE) == HTTP_TOO_MANY_REQUESTS);
}

test "generic_503_is_not_used_to_hide_an_unfunded_or_invalid_key" {
    assert(client_status_for(HTTP_SERVICE_UNAVAILABLE, SIGNAL_UNFUNDED) == HTTP_PAYMENT_REQUIRED);
    assert(client_status_for(HTTP_SERVICE_UNAVAILABLE, SIGNAL_INVALID_KEY) == HTTP_UNAUTHORIZED);
    assert(ladder_exhausted_status(SIGNAL_NONE) == HTTP_SERVICE_UNAVAILABLE);
    assert(ladder_exhausted_status(SIGNAL_UNFUNDED) == HTTP_PAYMENT_REQUIRED);
}

test "unknown_provider_is_never_selectable" {
    assert(provider_selectable(PROVIDER_UNKNOWN, FUNDING_FUNDED, QUARANTINE_NONE) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant only_known_providers_are_selectable {
    provider_selectable(PROVIDER_UNKNOWN, FUNDING_FUNDED, QUARANTINE_NONE) == false;
    provider_selectable(PROVIDER_T27_LADDER, FUNDING_FUNDED, QUARANTINE_NONE) == true;
}

invariant quarantine_never_selects {
    provider_selectable(PROVIDER_ZAI, FUNDING_FUNDED, QUARANTINE_UNFUNDED) == false;
    provider_selectable(PROVIDER_ZAI, FUNDING_FUNDED, QUARANTINE_INVALID_KEY) == false;
    provider_selectable(PROVIDER_ZAI, FUNDING_FUNDED, QUARANTINE_REVIEW) == false;
}

invariant no_remote_provider_is_local {
    local_route_is_loopback_only(PROVIDER_ZAI) == false;
    local_route_is_loopback_only(PROVIDER_DEEPSEEK) == false;
    local_route_is_loopback_only(PROVIDER_NVIDIA_NIM) == false;
    route_scope(PROVIDER_UNKNOWN) == SCOPE_NONE;
}

invariant funded_is_never_claimed_for_exhausted_or_invalid {
    provider_verified_funded(PROVIDER_ZAI, FUNDING_EXHAUSTED) == false;
    provider_verified_funded(PROVIDER_ZAI, FUNDING_INVALID) == false;
    provider_verified_funded(PROVIDER_ZAI, FUNDING_FUNDED) == true;
}

invariant quarantine_clears_only_by_explicit_reverify {
    quarantine_cleared(SIGNAL_UNFUNDED, false) == false;
    quarantine_cleared(SIGNAL_INVALID_KEY, false) == false;
}

invariant real_causes_are_never_flattened_to_503 {
    client_status_for(HTTP_UNAUTHORIZED, SIGNAL_INVALID_KEY) != HTTP_SERVICE_UNAVAILABLE;
    client_status_for(HTTP_PAYMENT_REQUIRED, SIGNAL_UNFUNDED) != HTTP_SERVICE_UNAVAILABLE;
    client_status_for(HTTP_FORBIDDEN, SIGNAL_INVALID_KEY) != HTTP_SERVICE_UNAVAILABLE;
    client_status_for(HTTP_TOO_MANY_REQUESTS, SIGNAL_NEEDS_CAUSE) != HTTP_SERVICE_UNAVAILABLE;
}
