// SPDX-License-Identifier: Apache-2.0
// T27 System Route Registry SSOT
// Purpose: the registry the SYSTEM layer uses to route a request: which route
//          class exists, whether it is local or remote, which credential
//          REFERENCE it uses, when a route may enter the table, when it
//          leaves, and what the caller is told when it fails.
//
// Owner: T27_ORDER_RESTORE_01 (issue #14282), 2026-10-30.
//
// OWNS:
//   - the route classes of the system layer and their scope (local / remote)
//   - the rule that a local route is loopback only
//   - the admission rule: a route enters the table only when it is funded
//     AND probed
//   - the leave rules: an unfunded route leaves, an invalid credential leaves
//     the pool but not the route
//   - quarantine stickiness: only an explicit re-verification clears it
//   - the status transparency rule: the caller sees the real cause
//
// DOES NOT OWN (never restate these facts here):
//   - the dated route matrix (which route answered when, at which price):
//       specs/queen/api_fleet.t27
//   - the scan state vocabulary and the ranking:
//       specs/t27os/access_scan.t27
//   - per-credential refusal kinds, cooldowns, bitmasks, attempt bound:
//       specs/queen/key_failover.t27
//   - the node rung table, the serve laws (thinking off, fail-closed 503 that
//     names every rung), the probe size: specs/t27os/ladder.t27,
//       specs/t27os/ladder_speed.t27, specs/t27os/ladder_serve.t27
//   - the routing policy above a table (admission of a rung, the switch
//     rules, the walk budget): specs/system/model-ladder.t27
//   - credential custody, rotation by age, leases and audit:
//       specs/vault/policy.t27, specs/vault/custodian.t27,
//       specs/vault/audit.t27
//   - the credential reference registry and the pool reload contract:
//       specs/system/credentials.t27
//   - the scan rules that find a secret in a diff:
//       specs/policy/secret_gate.t27
//   - the recovery ladder levels and the Doctor states:
//       specs/system/session-recovery-ladder.t27,
//       specs/system/session-doctor.t27
//   - the fact-ownership index of the system layer:
//       specs/system/language-boundary.t27
//
// Live evidence (2026-10-30, local route 127.0.0.1:3131):
//   - the running ladder answered 200 while one pool credential was refused
//     with 401 and another was out of quota until 2026-11-01; the caller saw
//     a generic 503 instead of the real cause
//   - the loaded pool held 5 credentials while the store held 6
//
// L3 NO_SILENT_FALLBACK and L4 UNFUNDED_MEANS_STOP, as route state.

module providers;

// ─── Route classes of the system layer ─────────────────────────────────────
//
// Identity of a ROUTE, not of a provider card. The provider cards live under
// specs/providers/ (the catalog contract, specs/providers/catalog.t27) and the
// dated funding matrix lives in specs/queen/api_fleet.t27.

pub const ROUTE_LOCAL_LADDER : u8 = 0;   // the local model ladder, loopback
pub const ROUTE_LOCAL_OLLAMA : u8 = 1;   // the local model host, loopback
pub const ROUTE_REMOTE_ZAI : u8 = 2;     // remote, glm models
pub const ROUTE_REMOTE_NIM : u8 = 3;     // remote, funded models
pub const ROUTE_REMOTE_DEEPSEEK : u8 = 4; // remote, blocked until funded
pub const ROUTE_COUNT : u32 = 5;

// ─── Scope ─────────────────────────────────────────────────────────────────

pub const SCOPE_NONE : u8 = 0;
pub const SCOPE_LOCAL : u8 = 1;
pub const SCOPE_REMOTE : u8 = 2;

// ─── Quarantine ────────────────────────────────────────────────────────────

pub const QUARANTINE_NONE : u8 = 0;
pub const QUARANTINE_UNFUNDED : u8 = 1;
pub const QUARANTINE_INVALID_CREDENTIAL : u8 = 2;

// ─── HTTP statuses the caller must see as themselves ───────────────────────

pub const HTTP_OK : u16 = 200;
pub const HTTP_UNAUTHORIZED : u16 = 401;
pub const HTTP_PAYMENT_REQUIRED : u16 = 402;
pub const HTTP_FORBIDDEN : u16 = 403;
pub const HTTP_TOO_MANY_REQUESTS : u16 = 429;
pub const HTTP_SERVICE_UNAVAILABLE : u16 = 503;

// ─── Functions ─────────────────────────────────────────────────────────────

// registry_entry_count() - how many route classes the system layer routes to.
pub fn registry_entry_count() -> u32 {
    return ROUTE_COUNT;
}

// route_class_is_known(route_class) -> bool
pub fn route_class_is_known(route_class: u8) -> bool {
    if (route_class < ROUTE_COUNT) {
        return true;
    }
    return false;
}

// route_scope(route_class) -> u8
pub fn route_scope(route_class: u8) -> u8 {
    if (route_class == ROUTE_LOCAL_LADDER) {
        return SCOPE_LOCAL;
    }
    if (route_class == ROUTE_LOCAL_OLLAMA) {
        return SCOPE_LOCAL;
    }
    if (route_class == ROUTE_REMOTE_ZAI) {
        return SCOPE_REMOTE;
    }
    if (route_class == ROUTE_REMOTE_NIM) {
        return SCOPE_REMOTE;
    }
    if (route_class == ROUTE_REMOTE_DEEPSEEK) {
        return SCOPE_REMOTE;
    }
    return SCOPE_NONE;
}

// local_route_is_loopback_only(route_class) -> bool - a local route is node
// plumbing; it is never a network service.
pub fn local_route_is_loopback_only(route_class: u8) -> bool {
    if (route_scope(route_class) != SCOPE_LOCAL) {
        return false;
    }
    return true;
}

// route_admitted(funded, probed) -> bool - a route enters the table only when
// it is funded AND probed. An unprobed route is not a route yet.
pub fn route_admitted(funded: bool, probed: bool) -> bool {
    if (funded == false) {
        return false;
    }
    if (probed == false) {
        return false;
    }
    return true;
}

// route_leaves_on_unfunded(funded) -> bool - an exhausted route leaves the
// table until it is funded and probed again.
pub fn route_leaves_on_unfunded(funded: bool) -> bool {
    if (funded) {
        return false;
    }
    return true;
}

// route_leaves_on_invalid_credential(invalid_credential) -> bool - one
// rejected credential leaves the POOL, not the route: other credentials of
// the same route may still answer.
pub fn route_leaves_on_invalid_credential(invalid_credential: bool) -> bool {
    return invalid_credential;
}

// quarantine_state_for(funded, invalid_credential) -> u8
pub fn quarantine_state_for(funded: bool, invalid_credential: bool) -> u8 {
    if (funded == false) {
        return QUARANTINE_UNFUNDED;
    }
    if (invalid_credential) {
        return QUARANTINE_INVALID_CREDENTIAL;
    }
    return QUARANTINE_NONE;
}

// quarantine_is_sticky(quarantined, explicit_reverify) -> bool - quarantine is
// cleared only by an explicit re-verification, never by a retry and never by
// the passage of time.
pub fn quarantine_is_sticky(quarantined: bool, explicit_reverify: bool) -> bool {
    if (quarantined == false) {
        return false;
    }
    if (explicit_reverify) {
        return false;
    }
    return true;
}

// route_is_selectable(route_class, funded, probed, quarantined) -> bool
pub fn route_is_selectable(route_class: u8, funded: bool, probed: bool, quarantined: bool) -> bool {
    if (route_class_is_known(route_class) == false) {
        return false;
    }
    if (quarantined) {
        return false;
    }
    return route_admitted(funded, probed);
}

// remote_route_needs_matrix_entry(is_remote, matrix_has_entry) -> bool - a
// remote route must appear in the dated matrix (specs/queen/api_fleet.t27),
// otherwise the system layer routes to something nobody measured.
pub fn remote_route_needs_matrix_entry(is_remote: bool, matrix_has_entry: bool) -> bool {
    if (is_remote == false) {
        return false;
    }
    if (matrix_has_entry) {
        return false;
    }
    return true;
}

// client_status_for(upstream_status) -> u16 - the caller sees the real cause.
// A generic 503 is reserved for a ladder that really was exhausted.
pub fn client_status_for(upstream_status: u16) -> u16 {
    if (upstream_status == HTTP_UNAUTHORIZED) {
        return HTTP_UNAUTHORIZED;
    }
    if (upstream_status == HTTP_PAYMENT_REQUIRED) {
        return HTTP_PAYMENT_REQUIRED;
    }
    if (upstream_status == HTTP_FORBIDDEN) {
        return HTTP_FORBIDDEN;
    }
    if (upstream_status == HTTP_TOO_MANY_REQUESTS) {
        return HTTP_TOO_MANY_REQUESTS;
    }
    return upstream_status;
}

// status_is_masked(upstream_status, client_status) -> bool - a refusal that
// arrives as a generic 503 is a masked cause.
pub fn status_is_masked(upstream_status: u16, client_status: u16) -> bool {
    if (client_status != HTTP_SERVICE_UNAVAILABLE) {
        return false;
    }
    if (upstream_status == HTTP_SERVICE_UNAVAILABLE) {
        return false;
    }
    return true;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_registry_has_five_route_classes" {
    assert(registry_entry_count() == 5);
    assert(route_class_is_known(ROUTE_LOCAL_LADDER) == true);
    assert(route_class_is_known(ROUTE_REMOTE_DEEPSEEK) == true);
    assert(route_class_is_known(200) == false);
}

test "local_routes_are_loopback_only_and_remote_routes_are_not" {
    assert(route_scope(ROUTE_LOCAL_LADDER) == SCOPE_LOCAL);
    assert(route_scope(ROUTE_LOCAL_OLLAMA) == SCOPE_LOCAL);
    assert(route_scope(ROUTE_REMOTE_ZAI) == SCOPE_REMOTE);
    assert(local_route_is_loopback_only(ROUTE_LOCAL_LADDER) == true);
    assert(local_route_is_loopback_only(ROUTE_LOCAL_OLLAMA) == true);
    assert(local_route_is_loopback_only(ROUTE_REMOTE_ZAI) == false);
    assert(local_route_is_loopback_only(200) == false);
}

test "a_route_enters_the_table_only_when_it_is_funded_and_probed" {
    assert(route_admitted(true, true) == true);
    assert(route_admitted(false, true) == false);
    assert(route_admitted(true, false) == false);
    assert(route_admitted(false, false) == false);
}

test "an_unfunded_route_leaves_the_table" {
    assert(route_leaves_on_unfunded(false) == true);
    assert(route_leaves_on_unfunded(true) == false);
    assert(quarantine_state_for(false, false) == QUARANTINE_UNFUNDED);
}

test "an_invalid_credential_leaves_the_pool_but_not_the_route" {
    assert(route_leaves_on_invalid_credential(true) == true);
    assert(route_leaves_on_invalid_credential(false) == false);
    assert(quarantine_state_for(true, true) == QUARANTINE_INVALID_CREDENTIAL);
}

test "quarantine_is_cleared_only_by_an_explicit_reverification" {
    assert(quarantine_is_sticky(true, false) == true);
    assert(quarantine_is_sticky(true, true) == false);
    assert(quarantine_is_sticky(false, false) == false);
}

test "a_quarantined_or_unmeasured_route_is_never_selectable" {
    assert(route_is_selectable(ROUTE_REMOTE_ZAI, true, true, false) == true);
    assert(route_is_selectable(ROUTE_REMOTE_ZAI, false, true, false) == false);
    assert(route_is_selectable(ROUTE_REMOTE_ZAI, true, false, false) == false);
    assert(route_is_selectable(ROUTE_REMOTE_ZAI, true, true, true) == false);
    assert(route_is_selectable(200, true, true, false) == false);
}

test "a_remote_route_without_a_matrix_entry_is_a_gap" {
    assert(remote_route_needs_matrix_entry(true, false) == true);
    assert(remote_route_needs_matrix_entry(true, true) == false);
    assert(remote_route_needs_matrix_entry(false, false) == false);
}

test "the_caller_sees_the_real_cause" {
    assert(client_status_for(HTTP_UNAUTHORIZED) == HTTP_UNAUTHORIZED);
    assert(client_status_for(HTTP_PAYMENT_REQUIRED) == HTTP_PAYMENT_REQUIRED);
    assert(client_status_for(HTTP_FORBIDDEN) == HTTP_FORBIDDEN);
    assert(client_status_for(HTTP_TOO_MANY_REQUESTS) == HTTP_TOO_MANY_REQUESTS);
    assert(client_status_for(HTTP_OK) == HTTP_OK);
}

test "a_refusal_that_arrives_as_a_generic_503_is_masked" {
    assert(status_is_masked(HTTP_UNAUTHORIZED, HTTP_SERVICE_UNAVAILABLE) == true);
    assert(status_is_masked(HTTP_PAYMENT_REQUIRED, HTTP_SERVICE_UNAVAILABLE) == true);
    assert(status_is_masked(HTTP_TOO_MANY_REQUESTS, HTTP_SERVICE_UNAVAILABLE) == true);
    assert(status_is_masked(HTTP_SERVICE_UNAVAILABLE, HTTP_SERVICE_UNAVAILABLE) == false);
    assert(status_is_masked(HTTP_UNAUTHORIZED, HTTP_UNAUTHORIZED) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant every_route_class_has_exactly_one_scope {
    route_scope(ROUTE_LOCAL_LADDER) == SCOPE_LOCAL;
    route_scope(ROUTE_LOCAL_OLLAMA) == SCOPE_LOCAL;
    route_scope(ROUTE_REMOTE_ZAI) == SCOPE_REMOTE;
    route_scope(ROUTE_REMOTE_NIM) == SCOPE_REMOTE;
    route_scope(ROUTE_REMOTE_DEEPSEEK) == SCOPE_REMOTE;
    route_scope(200) == SCOPE_NONE;
}

invariant a_local_route_is_never_exposed_off_host {
    local_route_is_loopback_only(ROUTE_LOCAL_LADDER) == true;
    local_route_is_loopback_only(ROUTE_LOCAL_OLLAMA) == true;
    local_route_is_loopback_only(ROUTE_REMOTE_NIM) == false;
}

invariant an_unfunded_or_unprobed_route_is_never_selectable {
    route_is_selectable(ROUTE_REMOTE_ZAI, false, true, false) == false;
    route_is_selectable(ROUTE_REMOTE_ZAI, true, false, false) == false;
}

invariant a_quarantined_route_is_never_selectable {
    route_is_selectable(ROUTE_REMOTE_ZAI, true, true, true) == false;
    quarantine_is_sticky(true, false) == true;
}

invariant a_real_cause_is_never_flattened_to_503 {
    client_status_for(HTTP_UNAUTHORIZED) != HTTP_SERVICE_UNAVAILABLE;
    client_status_for(HTTP_PAYMENT_REQUIRED) != HTTP_SERVICE_UNAVAILABLE;
    client_status_for(HTTP_FORBIDDEN) != HTTP_SERVICE_UNAVAILABLE;
    client_status_for(HTTP_TOO_MANY_REQUESTS) != HTTP_SERVICE_UNAVAILABLE;
    status_is_masked(HTTP_UNAUTHORIZED, HTTP_SERVICE_UNAVAILABLE) == true;
}

invariant the_registry_is_a_closed_set {
    registry_entry_count() == 5;
    route_class_is_known(200) == false;
}
