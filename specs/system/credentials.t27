// SPDX-License-Identifier: Apache-2.0
// T27 Credential Reference SSOT
// Purpose: the credential REFERENCE contract of the system layer - a route is
//          configured by the NAME of a credential, a name resolves to a value
//          in a store, a name is what may be reported, and a value never is.
//
// Owner: T27_ORDER_RESTORE_01 (issue #14282), 2026-10-30.
//
// OWNS:
//   - the states of a credential reference (unknown, configured without a
//     value, resolvable, quarantined)
//   - the rule that a config carries the NAME of a credential, never its value
//   - the shape of a credential report: a name, a presence flag and a length;
//     never a value
//   - the pool freshness gap: the number of references the loader holds and
//     the number the store lists, and the rule that a mismatch is visible
//
// DOES NOT OWN (never restate these facts here):
//   - leases, scopes, TTLs, rotation by age, audit events, the injection
//     boundary and the leak detector:
//       specs/vault/policy.t27, specs/vault/custodian.t27,
//       specs/vault/audit.t27
//   - the node key storage (Keychain items), the probe of a key, the rescan
//     cadence and the fleet row: specs/t27os/keys.t27,
//       specs/t27os/keys_host.t27, specs/t27os/keys_probe.t27,
//       specs/t27os/keys_fleet.t27
//   - per-credential refusal kinds, cooldowns, bitmasks, attempt bound:
//       specs/queen/key_failover.t27
//   - the locality of a key (a rung's key never leaves the node):
//       specs/t27os/ladder.t27 (law 5)
//   - the scan rules that find a secret in a diff:
//       specs/policy/secret_gate.t27
//   - the foreign-code gate that keeps a value out of the repository:
//       specs/policy/own_language.t27
//   - the authentication configuration schema: specs/auth/config.t27
//   - the route classes and their admission: specs/system/providers.t27
//   - the fact-ownership index of the system layer:
//       specs/system/language-boundary.t27
//
// Live evidence (2026-10-30):
//   - the running ladder held 5 credential references while the store listed
//     6: the pool was stale, and the gap was invisible because nothing
//     compared the two counts
//   - one pooled credential answered HTTP 401 and kept being offered
//   - every diagnostic named the credential, never its value
//
// L2 NO_SECRET_IN_CODE: a config stores a reference, a secret store stores the
// value. This file owns the reference half of that sentence only.

module credentials;

// ─── Reference states ──────────────────────────────────────────────────────

pub const REF_UNKNOWN : u8 = 0;        // the name is not configured
pub const REF_CONFIGURED_NO_VALUE : u8 = 1; // the name is there, the value is not
pub const REF_RESOLVABLE : u8 = 2;     // the name resolves to a value
pub const REF_QUARANTINED : u8 = 3;    // the name was refused and is held back

// ─── Functions ─────────────────────────────────────────────────────────────

// reference_state(reference_known, value_present, quarantined) -> u8
pub fn reference_state(reference_known: bool, value_present: bool, quarantined: bool) -> u8 {
    if (quarantined) {
        return REF_QUARANTINED;
    }
    if (reference_known == false) {
        return REF_UNKNOWN;
    }
    if (value_present == false) {
        return REF_CONFIGURED_NO_VALUE;
    }
    return REF_RESOLVABLE;
}

// reference_is_configured(reference_known, value_present) -> bool - a name
// without a value is a configuration gap, not a route.
pub fn reference_is_configured(reference_known: bool, value_present: bool) -> bool {
    if (reference_known == false) {
        return false;
    }
    if (value_present == false) {
        return false;
    }
    return true;
}

// reference_is_usable(state) -> bool - an unknown, empty or quarantined
// reference is never offered to a route.
pub fn reference_is_usable(state: u8) -> bool {
    if (state == REF_RESOLVABLE) {
        return true;
    }
    return false;
}

// quarantined_reference_is_not_retried(state) -> bool - a refused credential
// is held back, not offered again on the same evidence.
pub fn quarantined_reference_is_not_retried(state: u8) -> bool {
    if (state == REF_QUARANTINED) {
        return true;
    }
    return false;
}

// config_carries_reference_not_value(config_holds_name, config_holds_value) -> bool
pub fn config_carries_reference_not_value(config_holds_name: bool, config_holds_value: bool) -> bool {
    if (config_holds_name == false) {
        return false;
    }
    if (config_holds_value) {
        return false;
    }
    return true;
}

// report_carries_name_only() -> bool - a diagnostic names the credential and
// never shows it.
pub fn report_carries_name_only() -> bool {
    return true;
}

// report_may_carry_value_length() -> bool - the length of a value is
// metadata, not the value: it says how long the credential is and shows none
// of it.
pub fn report_may_carry_value_length() -> bool {
    return true;
}

// pool_freshness_gap(loaded_count, store_count) -> bool - the loader holds a
// set of references; the store lists another. A mismatch is a stale pool.
pub fn pool_freshness_gap(loaded_count: u32, store_count: u32) -> bool {
    if (loaded_count == store_count) {
        return false;
    }
    return true;
}

// pool_gap_is_visible_by_count_only() -> bool - the gap is reported as two
// counts and a difference, never as a list of values.
pub fn pool_gap_is_visible_by_count_only() -> bool {
    return true;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "a_reference_has_four_states" {
    assert(reference_state(false, false, false) == REF_UNKNOWN);
    assert(reference_state(true, false, false) == REF_CONFIGURED_NO_VALUE);
    assert(reference_state(true, true, false) == REF_RESOLVABLE);
    assert(reference_state(true, true, true) == REF_QUARANTINED);
}

test "a_name_without_a_value_is_a_configuration_gap" {
    assert(reference_is_configured(true, true) == true);
    assert(reference_is_configured(true, false) == false);
    assert(reference_is_configured(false, true) == false);
}

test "only_a_resolvable_reference_is_usable" {
    assert(reference_is_usable(REF_RESOLVABLE) == true);
    assert(reference_is_usable(REF_UNKNOWN) == false);
    assert(reference_is_usable(REF_CONFIGURED_NO_VALUE) == false);
    assert(reference_is_usable(REF_QUARANTINED) == false);
}

test "a_quarantined_reference_is_not_offered_again" {
    assert(quarantined_reference_is_not_retried(REF_QUARANTINED) == true);
    assert(quarantined_reference_is_not_retried(REF_RESOLVABLE) == false);
}

test "a_config_carries_the_name_and_never_the_value" {
    assert(config_carries_reference_not_value(true, false) == true);
    assert(config_carries_reference_not_value(true, true) == false);
    assert(config_carries_reference_not_value(false, false) == false);
}

test "a_report_names_the_credential_and_may_state_its_length" {
    assert(report_carries_name_only() == true);
    assert(report_may_carry_value_length() == true);
}

test "a_stale_pool_is_visible_as_a_count_difference" {
    assert(pool_freshness_gap(5, 6) == true);
    assert(pool_freshness_gap(6, 6) == false);
    assert(pool_freshness_gap(0, 0) == false);
    assert(pool_gap_is_visible_by_count_only() == true);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant an_unusable_reference_is_never_offered {
    reference_is_usable(REF_UNKNOWN) == false;
    reference_is_usable(REF_CONFIGURED_NO_VALUE) == false;
    reference_is_usable(REF_QUARANTINED) == false;
}

invariant a_quarantined_reference_is_never_retried {
    quarantined_reference_is_not_retried(REF_QUARANTINED) == true;
    quarantined_reference_is_not_retried(REF_RESOLVABLE) == false;
}

invariant a_config_never_carries_a_value {
    config_carries_reference_not_value(true, true) == false;
    config_carries_reference_not_value(true, false) == true;
}

invariant a_report_never_carries_a_value {
    report_carries_name_only() == true;
    report_may_carry_value_length() == true;
}

invariant a_stale_pool_is_never_silent {
    pool_freshness_gap(5, 6) == true;
    pool_gap_is_visible_by_count_only() == true;
}

invariant an_unknown_reference_is_never_resolvable {
    reference_state(false, true, false) == REF_UNKNOWN;
    reference_is_usable(REF_UNKNOWN) == false;
}
