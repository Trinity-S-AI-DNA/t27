// SPDX-License-Identifier: Apache-2.0
// T27 System Fact Ownership Index SSOT
// Purpose: THE INDEX of the system layer. One fact, one owner. This file
//          names the fact classes of the system layer and the single spec
//          that owns each of them, so that a second file can never quietly
//          become a second home for the same fact.
//
// Owner: T27_ORDER_RESTORE_01 (issue #14282), 2026-10-30.
//
// OWNS:
//   - the fact classes of the system layer
//   - the single owner of each fact class
//   - the rules of the index itself: completeness, uniqueness, no dangling
//     owner, no restatement of a law that has an owner
//
// DOES NOT OWN (never restate these facts here):
//   - the language law, the forbidden-language list and the foreign budget
//     (40 added lines per file, 80 per change, shrink-only):
//       specs/policy/own_language.t27, with its agent-facing card
//       specs/policy/budget_discipline.t27
//   - the rule that a generator gap becomes a compiler defect:
//       specs/policy/own_language.t27 (and the self-host epic #5980)
//   - the issue shape, the PR budget, the secret scan rules:
//       specs/policy/issue_shape.t27, specs/policy/pr_budget.t27,
//       specs/policy/secret_gate.t27
//   - every fact this file indexes: the owners are named below
//
// HOW TO USE THIS FILE: a new fact class is added here FIRST, together with
// its owner; only then may a second file state it. A fact that is not in
// this index has no owner yet and may not be stated twice.

module language_boundary;

// ─── The owner specs ───────────────────────────────────────────────────────

pub const SPEC_PROVIDERS : u8 = 0;            // specs/system/providers.t27
pub const SPEC_MODEL_LADDER : u8 = 1;         // specs/system/model-ladder.t27
pub const SPEC_SESSION_CONTINUITY : u8 = 2;   // specs/system/session-continuity.t27
pub const SPEC_SESSION_RECOVERY_LADDER : u8 = 3; // specs/system/session-recovery-ladder.t27
pub const SPEC_SESSION_DOCTOR : u8 = 4;       // specs/system/session-doctor.t27
pub const SPEC_DISK_PREFLIGHT : u8 = 5;       // specs/system/disk/dsh-write-heavy-preflight.t27
pub const SPEC_DISK_SNAPSHOT : u8 = 6;        // specs/system/disk/dsh-disk-health-snapshot.t27
pub const SPEC_DISK_CLEANUP : u8 = 7;         // specs/system/disk/dsh-disk-cleanup-plan.t27
pub const SPEC_RELEASE_GATES : u8 = 8;        // specs/system/release-gates.t27
pub const SPEC_OWN_LANGUAGE : u8 = 9;         // specs/policy/own_language.t27
pub const SPEC_VAULT_POLICY : u8 = 10;        // specs/vault/policy.t27
pub const SPEC_VAULT_CUSTODIAN : u8 = 11;     // specs/vault/custodian.t27
pub const SPEC_API_FLEET : u8 = 12;           // specs/queen/api_fleet.t27
pub const SPEC_ACCESS_SCAN : u8 = 13;         // specs/t27os/access_scan.t27
pub const SPEC_NODE_LADDER : u8 = 14;         // specs/t27os/ladder.t27
pub const SPEC_CREDENTIALS : u8 = 15;         // specs/system/credentials.t27
pub const SPEC_DISK_HEALTH : u8 = 16;         // specs/system/disk-health.t27
pub const SPEC_COUNT : u32 = 17;

// ─── The fact classes ──────────────────────────────────────────────────────

pub const FACT_ROUTE_REGISTRY : u8 = 0;      // route classes, scope, admission
pub const FACT_ROUTE_MATRIX : u8 = 1;        // the dated route/funding matrix
pub const FACT_SCAN_VOCABULARY : u8 = 2;     // route state words and ranking
pub const FACT_LADDER_POLICY : u8 = 3;       // switch policy, walk budget
pub const FACT_NODE_RUNG_TABLE : u8 = 4;     // the rungs of the node table
pub const FACT_CHECKPOINT_CONTRACT : u8 = 5; // checkpoints, states, resume
pub const FACT_RECOVERY_LEVELS : u8 = 6;     // preserve .. hand off
pub const FACT_DOCTOR_STATES : u8 = 7;       // the Doctor lifecycle
pub const FACT_DISK_MEASUREMENT : u8 = 8;    // free space, thresholds
pub const FACT_DISK_RESERVATION : u8 = 9;    // footprint and reservation
pub const FACT_DISK_CLEANUP : u8 = 10;       // cleanup classes and priority
pub const FACT_RELEASE_LAW : u8 = 11;        // gates, evidence, rollback, tag
pub const FACT_FOREIGN_BOUNDARY : u8 = 12;   // what may be hand-written
pub const FACT_SECRET_CUSTODY : u8 = 13;     // leases, TTLs, audit of values
pub const FACT_CREDENTIAL_REFERENCES : u8 = 14; // references, pool, reload
pub const FACT_DISK_POLICY : u8 = 15;      // the allow / cleanup / block policy
pub const FACT_COUNT : u32 = 16;

// ─── Functions ─────────────────────────────────────────────────────────────

// fact_class_count() - how many fact classes the system layer indexes.
pub fn fact_class_count() -> u32 {
    return FACT_COUNT;
}

// owner_spec_count() - how many specs the index names.
pub fn owner_spec_count() -> u32 {
    return SPEC_COUNT;
}

// owner_of(fact_class) -> u8 - the ONE spec that owns a fact class.
pub fn owner_of(fact_class: u8) -> u8 {
    if (fact_class == FACT_ROUTE_REGISTRY) {
        return SPEC_PROVIDERS;
    }
    if (fact_class == FACT_ROUTE_MATRIX) {
        return SPEC_API_FLEET;
    }
    if (fact_class == FACT_SCAN_VOCABULARY) {
        return SPEC_ACCESS_SCAN;
    }
    if (fact_class == FACT_LADDER_POLICY) {
        return SPEC_MODEL_LADDER;
    }
    if (fact_class == FACT_NODE_RUNG_TABLE) {
        return SPEC_NODE_LADDER;
    }
    if (fact_class == FACT_CHECKPOINT_CONTRACT) {
        return SPEC_SESSION_CONTINUITY;
    }
    if (fact_class == FACT_RECOVERY_LEVELS) {
        return SPEC_SESSION_RECOVERY_LADDER;
    }
    if (fact_class == FACT_DOCTOR_STATES) {
        return SPEC_SESSION_DOCTOR;
    }
    if (fact_class == FACT_DISK_MEASUREMENT) {
        return SPEC_DISK_SNAPSHOT;
    }
    if (fact_class == FACT_DISK_RESERVATION) {
        return SPEC_DISK_PREFLIGHT;
    }
    if (fact_class == FACT_DISK_CLEANUP) {
        return SPEC_DISK_CLEANUP;
    }
    if (fact_class == FACT_RELEASE_LAW) {
        return SPEC_RELEASE_GATES;
    }
    if (fact_class == FACT_FOREIGN_BOUNDARY) {
        return SPEC_OWN_LANGUAGE;
    }
    if (fact_class == FACT_SECRET_CUSTODY) {
        return SPEC_VAULT_POLICY;
    }
    if (fact_class == FACT_CREDENTIAL_REFERENCES) {
        return SPEC_CREDENTIALS;
    }
    if (fact_class == FACT_DISK_POLICY) {
        return SPEC_DISK_HEALTH;
    }
    return SPEC_OWN_LANGUAGE;
}

// fact_has_owner(fact_class) -> bool
pub fn fact_has_owner(fact_class: u8) -> bool {
    if (fact_class < FACT_COUNT) {
        return true;
    }
    return false;
}

// duplicate_owner_refused(existing_owner, new_owner) -> bool - the index is a
// function: a fact class has one owner, and a second owner for it is refused.
pub fn duplicate_owner_refused(existing_owner: u8, new_owner: u8) -> bool {
    if (existing_owner == new_owner) {
        return false;
    }
    return true;
}

// owner_path_exists(path_exists) -> bool - a dangling owner reference is a
// defect, not a pointer.
pub fn owner_path_exists(path_exists: bool) -> bool {
    return path_exists;
}

// dangling_owner_is_a_defect(path_exists) -> bool
pub fn dangling_owner_is_a_defect(path_exists: bool) -> bool {
    if (path_exists) {
        return false;
    }
    return true;
}

// index_is_complete(fact_count, mapped_count) -> bool
pub fn index_is_complete(fact_count: u32, mapped_count: u32) -> bool {
    return fact_count == mapped_count;
}

// fact_may_be_added_only_with_an_owner(new_fact_has_owner) -> bool
pub fn fact_may_be_added_only_with_an_owner(new_fact_has_owner: bool) -> bool {
    return new_fact_has_owner;
}

// foreign_law_is_declared_here(caps_declared_here) -> bool - the index must
// NOT restate the foreign budget or the forbidden-language list: those live
// in specs/policy/own_language.t27. This function says so mechanically.
pub fn foreign_law_is_declared_here(caps_declared_here: bool) -> bool {
    return caps_declared_here;
}

// facts_of_one_owner_may_be_declared_together(owner_declares_both) -> bool
pub fn facts_of_one_owner_may_be_declared_together(owner_declares_both: bool) -> bool {
    return owner_declares_both;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "every_fact_class_has_exactly_one_owner" {
    assert(fact_class_count() == 16);
    assert(owner_spec_count() == 17);
    assert(fact_has_owner(FACT_ROUTE_REGISTRY) == true);
    assert(fact_has_owner(FACT_CHECKPOINT_CONTRACT) == true);
    assert(fact_has_owner(FACT_RELEASE_LAW) == true);
    assert(fact_has_owner(FACT_CREDENTIAL_REFERENCES) == true);
    assert(fact_has_owner(200) == false);
}

test "the_index_points_at_the_real_owners" {
    assert(owner_of(FACT_ROUTE_REGISTRY) == SPEC_PROVIDERS);
    assert(owner_of(FACT_ROUTE_MATRIX) == SPEC_API_FLEET);
    assert(owner_of(FACT_SCAN_VOCABULARY) == SPEC_ACCESS_SCAN);
    assert(owner_of(FACT_LADDER_POLICY) == SPEC_MODEL_LADDER);
    assert(owner_of(FACT_NODE_RUNG_TABLE) == SPEC_NODE_LADDER);
    assert(owner_of(FACT_CHECKPOINT_CONTRACT) == SPEC_SESSION_CONTINUITY);
    assert(owner_of(FACT_RECOVERY_LEVELS) == SPEC_SESSION_RECOVERY_LADDER);
    assert(owner_of(FACT_DOCTOR_STATES) == SPEC_SESSION_DOCTOR);
    assert(owner_of(FACT_DISK_MEASUREMENT) == SPEC_DISK_SNAPSHOT);
    assert(owner_of(FACT_DISK_RESERVATION) == SPEC_DISK_PREFLIGHT);
    assert(owner_of(FACT_DISK_CLEANUP) == SPEC_DISK_CLEANUP);
    assert(owner_of(FACT_RELEASE_LAW) == SPEC_RELEASE_GATES);
    assert(owner_of(FACT_FOREIGN_BOUNDARY) == SPEC_OWN_LANGUAGE);
    assert(owner_of(FACT_SECRET_CUSTODY) == SPEC_VAULT_POLICY);
    assert(owner_of(FACT_CREDENTIAL_REFERENCES) == SPEC_CREDENTIALS);
    assert(owner_of(FACT_DISK_POLICY) == SPEC_DISK_HEALTH);
}

test "a_second_owner_for_one_fact_is_refused" {
    assert(duplicate_owner_refused(SPEC_PROVIDERS, SPEC_API_FLEET) == true);
    assert(duplicate_owner_refused(SPEC_PROVIDERS, SPEC_PROVIDERS) == false);
}

test "a_dangling_owner_reference_is_a_defect" {
    assert(owner_path_exists(true) == true);
    assert(owner_path_exists(false) == false);
    assert(dangling_owner_is_a_defect(false) == true);
    assert(dangling_owner_is_a_defect(true) == false);
}

test "the_index_is_complete" {
    assert(index_is_complete(16, 16) == true);
    assert(index_is_complete(16, 15) == false);
}

test "a_new_fact_needs_an_owner_before_it_is_stated" {
    assert(fact_may_be_added_only_with_an_owner(true) == true);
    assert(fact_may_be_added_only_with_an_owner(false) == false);
}

test "the_index_does_not_restate_the_foreign_budget" {
    assert(foreign_law_is_declared_here(false) == false);
    assert(foreign_law_is_declared_here(true) == true);
}

test "one_spec_may_own_several_facts_only_when_it_declares_them" {
    assert(facts_of_one_owner_may_be_declared_together(true) == true);
    assert(facts_of_one_owner_may_be_declared_together(false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant every_fact_class_has_an_owner {
    fact_has_owner(FACT_ROUTE_REGISTRY) == true;
    fact_has_owner(FACT_ROUTE_MATRIX) == true;
    fact_has_owner(FACT_SCAN_VOCABULARY) == true;
    fact_has_owner(FACT_LADDER_POLICY) == true;
    fact_has_owner(FACT_NODE_RUNG_TABLE) == true;
    fact_has_owner(FACT_CHECKPOINT_CONTRACT) == true;
    fact_has_owner(FACT_RECOVERY_LEVELS) == true;
    fact_has_owner(FACT_DOCTOR_STATES) == true;
    fact_has_owner(FACT_DISK_MEASUREMENT) == true;
    fact_has_owner(FACT_DISK_RESERVATION) == true;
    fact_has_owner(FACT_DISK_CLEANUP) == true;
    fact_has_owner(FACT_RELEASE_LAW) == true;
    fact_has_owner(FACT_FOREIGN_BOUNDARY) == true;
    fact_has_owner(FACT_SECRET_CUSTODY) == true;
    fact_has_owner(FACT_CREDENTIAL_REFERENCES) == true;
    fact_has_owner(FACT_DISK_POLICY) == true;
}

invariant the_index_is_a_function {
    duplicate_owner_refused(SPEC_PROVIDERS, SPEC_API_FLEET) == true;
    duplicate_owner_refused(SPEC_PROVIDERS, SPEC_PROVIDERS) == false;
}

invariant a_dangling_owner_is_never_accepted {
    owner_path_exists(false) == false;
    dangling_owner_is_a_defect(false) == true;
}

invariant the_foreign_budget_is_not_restated_here {
    foreign_law_is_declared_here(false) == false;
}

invariant an_unowned_fact_is_never_added {
    fact_may_be_added_only_with_an_owner(false) == false;
}

invariant the_index_covers_every_registered_fact {
    fact_class_count() == 16;
    owner_spec_count() == 17;
}
