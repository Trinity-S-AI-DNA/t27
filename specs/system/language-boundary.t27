// SPDX-License-Identifier: Apache-2.0
// T27 Language Boundary SSOT
// Purpose: two boundaries in one place - which spec owns which fact (the
//          one-fact-one-owner index), and where business logic may live
//          (.t27 decides, host code only adapts).
//
// Owner: T27_ORDER_RESTORE_01 (issue #12897), 2026-10-30.
//
// OWNS:
//   - the fact-ownership index of the system layer: every fact class has
//     exactly one owning spec, and no two fact classes share an owner
//   - the classification of a change: policy, adapter, generated, forbidden
//   - the glue budget (40 added lines per file, 80 per change)
//   - the rule that no label lifts the glue budget
//   - the rule that a gap in the generator becomes a compiler defect
//
// DOES NOT OWN (never restate these facts here):
//   - the language law and the TDD mandate:
//       SOUL.md Article I and Article II, docs/T27-CONSTITUTION.md
//   - the mechanical enforcement hook specs/policy/own_language.t27
//     (it is present in lanes and must be restored to the main tree; this
//     spec owns the boundary law, that spec owns the enforcement)
//   - provider routes and funding: specs/system/providers.t27
//   - rung order and model mapping: specs/system/model-ladder.t27
//   - checkpoint and resume rules: specs/system/session-continuity.t27
//   - Doctor lifecycle and the user-visible status bar:
//       specs/system/session-doctor.t27
//   - recovery ladder levels and the per-failure policy:
//       specs/system/session-recovery-ladder.t27
//   - the Doctor skills, one file per skill:
//       specs/agents/session-health-watch.t27 and its seven siblings
//   - disk preflight and reserves: specs/system/disk-health.t27
//   - release gates and evidence: specs/system/release-gates.t27
//   - key references, rotation and masking: specs/system/credentials.t27
//
// L1 SSOT: one fact, one owner. The index below is that index: if a fact is
// not listed here, it has no owner yet and may not be introduced twice.

module language_boundary;

// ─── The fact classes of the system layer ──────────────────────────────────

pub const FACT_PROVIDER_ROUTES : u8 = 0;
pub const FACT_LADDER_ORDER : u8 = 1;
pub const FACT_CHECKPOINT_CONTRACT : u8 = 2;
pub const FACT_DISK_POLICY : u8 = 3;
pub const FACT_RELEASE_GATES : u8 = 4;
pub const FACT_CODE_BOUNDARY : u8 = 5;
pub const FACT_CREDENTIALS : u8 = 6;
pub const FACT_DOCTOR_LIFECYCLE : u8 = 7;
pub const FACT_RECOVERY_LADDER : u8 = 8;
pub const FACT_COUNT : u32 = 9;

// ─── The owning specs (ids mirror the fact classes) ───────────────────────

pub const SPEC_PROVIDERS : u8 = 0;        // specs/system/providers.t27
pub const SPEC_MODEL_LADDER : u8 = 1;     // specs/system/model-ladder.t27
pub const SPEC_SESSION_CONTINUITY : u8 = 2; // specs/system/session-continuity.t27
pub const SPEC_DISK_HEALTH : u8 = 3;      // specs/system/disk-health.t27
pub const SPEC_RELEASE_GATES : u8 = 4;    // specs/system/release-gates.t27
pub const SPEC_LANGUAGE_BOUNDARY : u8 = 5; // specs/system/language-boundary.t27
pub const SPEC_CREDENTIALS : u8 = 6;      // specs/system/credentials.t27
pub const SPEC_SESSION_DOCTOR : u8 = 7;   // specs/system/session-doctor.t27
pub const SPEC_SESSION_RECOVERY_LADDER : u8 = 8; // specs/system/session-recovery-ladder.t27

// ─── Change classification ─────────────────────────────────────────────────

pub const KIND_NONE : u8 = 0;
pub const KIND_POLICY : u8 = 1;
pub const KIND_ADAPTER : u8 = 2;
pub const KIND_GENERATED : u8 = 3;
pub const KIND_FORBIDDEN : u8 = 4;

// ─── Glue budget ───────────────────────────────────────────────────────────

pub const GLUE_MAX_LINES_PER_FILE : u32 = 40;
pub const GLUE_MAX_LINES_PER_PR : u32 = 80;

// ─── Functions ─────────────────────────────────────────────────────────────

// fact_class_count() - how many fact classes the system layer indexes.
pub fn fact_class_count() -> u32 {
    return FACT_COUNT;
}

// owner_of(fact_class) - the one spec that owns a fact class.
pub fn owner_of(fact_class: u8) -> u8 {
    if (fact_class == FACT_PROVIDER_ROUTES) {
        return SPEC_PROVIDERS;
    }
    if (fact_class == FACT_LADDER_ORDER) {
        return SPEC_MODEL_LADDER;
    }
    if (fact_class == FACT_CHECKPOINT_CONTRACT) {
        return SPEC_SESSION_CONTINUITY;
    }
    if (fact_class == FACT_DISK_POLICY) {
        return SPEC_DISK_HEALTH;
    }
    if (fact_class == FACT_RELEASE_GATES) {
        return SPEC_RELEASE_GATES;
    }
    if (fact_class == FACT_CODE_BOUNDARY) {
        return SPEC_LANGUAGE_BOUNDARY;
    }
    if (fact_class == FACT_CREDENTIALS) {
        return SPEC_CREDENTIALS;
    }
    if (fact_class == FACT_DOCTOR_LIFECYCLE) {
        return SPEC_SESSION_DOCTOR;
    }
    if (fact_class == FACT_RECOVERY_LADDER) {
        return SPEC_SESSION_RECOVERY_LADDER;
    }
    return SPEC_LANGUAGE_BOUNDARY;
}

// fact_has_owner(fact_class) -> bool
pub fn fact_has_owner(fact_class: u8) -> bool {
    if (fact_class < FACT_COUNT) {
        return true;
    }
    return false;
}

// no_two_facts_share_one_owner(a, b) -> bool - one fact, one owner, and one
// owner, one fact.
pub fn no_two_facts_share_one_owner(a: u8, b: u8) -> bool {
    if (fact_has_owner(a) == false) {
        return true;
    }
    if (fact_has_owner(b) == false) {
        return true;
    }
    return owner_of(a) != owner_of(b);
}

// classify_change(has_spec_change, has_adapter_change, has_generated_change,
//                 has_foreign_business_logic) -> u8
//
// A foreign business-logic change is forbidden even when a spec change
// travels with it: the spec does not launder the hand-written logic.
pub fn classify_change(has_spec_change: bool, has_adapter_change: bool, has_generated_change: bool, has_foreign_business_logic: bool) -> u8 {
    if (has_foreign_business_logic) {
        return KIND_FORBIDDEN;
    }
    if (has_spec_change) {
        return KIND_POLICY;
    }
    if (has_adapter_change) {
        return KIND_ADAPTER;
    }
    if (has_generated_change) {
        return KIND_GENERATED;
    }
    return KIND_NONE;
}

// classification_is_admissible(kind) -> bool
pub fn classification_is_admissible(kind: u8) -> bool {
    if (kind == KIND_FORBIDDEN) {
        return false;
    }
    return true;
}

// adapter_is_thin(adapter_lines) -> bool - an adapter is I/O glue only.
pub fn adapter_is_thin(adapter_lines: u32) -> bool {
    return adapter_lines <= GLUE_MAX_LINES_PER_FILE;
}

// glue_budget_ok(file_lines, change_lines) -> bool
pub fn glue_budget_ok(file_lines: u32, change_lines: u32) -> bool {
    if (file_lines > GLUE_MAX_LINES_PER_FILE) {
        return false;
    }
    if (change_lines > GLUE_MAX_LINES_PER_PR) {
        return false;
    }
    return true;
}

// override_label_lifts_budget() -> bool - the budget holds for every label.
pub fn override_label_lifts_budget() -> bool {
    return false;
}

// needs_spec(behavior_change, is_policy_change) -> bool - a behaviour change
// without a spec is a change without a contract.
pub fn needs_spec(behavior_change: bool, is_policy_change: bool) -> bool {
    if (behavior_change == false) {
        return false;
    }
    if (is_policy_change) {
        return false;
    }
    return true;
}

// compiler_defect_required(gen_cannot_express) -> bool - what the generator
// cannot express is a compiler defect, never an excuse to hand-write it.
pub fn compiler_defect_required(gen_cannot_express: bool) -> bool {
    return gen_cannot_express;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "every_fact_class_has_exactly_one_owner" {
    assert(fact_class_count() == 9);
    assert(fact_has_owner(FACT_PROVIDER_ROUTES) == true);
    assert(fact_has_owner(FACT_LADDER_ORDER) == true);
    assert(fact_has_owner(FACT_CHECKPOINT_CONTRACT) == true);
    assert(fact_has_owner(FACT_DISK_POLICY) == true);
    assert(fact_has_owner(FACT_RELEASE_GATES) == true);
    assert(fact_has_owner(FACT_CODE_BOUNDARY) == true);
    assert(fact_has_owner(FACT_CREDENTIALS) == true);
    assert(fact_has_owner(FACT_DOCTOR_LIFECYCLE) == true);
    assert(fact_has_owner(FACT_RECOVERY_LADDER) == true);
    assert(fact_has_owner(200) == false);
}

test "the_owner_map_points_at_the_nine_registries" {
    assert(owner_of(FACT_PROVIDER_ROUTES) == SPEC_PROVIDERS);
    assert(owner_of(FACT_LADDER_ORDER) == SPEC_MODEL_LADDER);
    assert(owner_of(FACT_CHECKPOINT_CONTRACT) == SPEC_SESSION_CONTINUITY);
    assert(owner_of(FACT_DISK_POLICY) == SPEC_DISK_HEALTH);
    assert(owner_of(FACT_RELEASE_GATES) == SPEC_RELEASE_GATES);
    assert(owner_of(FACT_CODE_BOUNDARY) == SPEC_LANGUAGE_BOUNDARY);
    assert(owner_of(FACT_CREDENTIALS) == SPEC_CREDENTIALS);
    assert(owner_of(FACT_DOCTOR_LIFECYCLE) == SPEC_SESSION_DOCTOR);
    assert(owner_of(FACT_RECOVERY_LADDER) == SPEC_SESSION_RECOVERY_LADDER);
}

test "no_two_fact_classes_share_one_owner" {
    assert(no_two_facts_share_one_owner(FACT_PROVIDER_ROUTES, FACT_LADDER_ORDER) == true);
    assert(no_two_facts_share_one_owner(FACT_DISK_POLICY, FACT_RELEASE_GATES) == true);
    assert(no_two_facts_share_one_owner(FACT_CODE_BOUNDARY, FACT_CREDENTIALS) == true);
    assert(no_two_facts_share_one_owner(FACT_PROVIDER_ROUTES, FACT_CODE_BOUNDARY) == true);
    assert(no_two_facts_share_one_owner(FACT_DOCTOR_LIFECYCLE, FACT_RECOVERY_LADDER) == true);
    assert(no_two_facts_share_one_owner(FACT_DOCTOR_LIFECYCLE, FACT_CHECKPOINT_CONTRACT) == true);
    assert(no_two_facts_share_one_owner(FACT_RECOVERY_LADDER, FACT_CHECKPOINT_CONTRACT) == true);
}

test "a_spec_change_is_policy_an_adapter_change_is_an_adapter" {
    assert(classify_change(true, false, false, false) == KIND_POLICY);
    assert(classify_change(false, true, false, false) == KIND_ADAPTER);
    assert(classify_change(false, false, true, false) == KIND_GENERATED);
    assert(classify_change(false, false, false, false) == KIND_NONE);
}

test "foreign_business_logic_is_forbidden_even_next_to_a_spec" {
    assert(classify_change(true, false, false, true) == KIND_FORBIDDEN);
    assert(classify_change(false, true, false, true) == KIND_FORBIDDEN);
    assert(classification_is_admissible(KIND_FORBIDDEN) == false);
    assert(classification_is_admissible(KIND_POLICY) == true);
}

test "the_glue_budget_is_forty_lines_per_file_and_eighty_per_change" {
    assert(glue_budget_ok(40, 80) == true);
    assert(glue_budget_ok(41, 80) == false);
    assert(glue_budget_ok(40, 81) == false);
    assert(adapter_is_thin(40) == true);
    assert(adapter_is_thin(41) == false);
}

test "no_label_lifts_the_glue_budget" {
    assert(override_label_lifts_budget() == false);
    assert(glue_budget_ok(41, 80) == false);
}

test "a_behaviour_change_without_a_spec_needs_one" {
    assert(needs_spec(true, false) == true);
    assert(needs_spec(true, true) == false);
    assert(needs_spec(false, false) == false);
}

test "what_gen_cannot_express_becomes_a_compiler_defect" {
    assert(compiler_defect_required(true) == true);
    assert(compiler_defect_required(false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant every_fact_has_an_owner {
    fact_has_owner(FACT_PROVIDER_ROUTES) == true;
    fact_has_owner(FACT_LADDER_ORDER) == true;
    fact_has_owner(FACT_CHECKPOINT_CONTRACT) == true;
    fact_has_owner(FACT_DISK_POLICY) == true;
    fact_has_owner(FACT_RELEASE_GATES) == true;
    fact_has_owner(FACT_CODE_BOUNDARY) == true;
    fact_has_owner(FACT_CREDENTIALS) == true;
    fact_has_owner(FACT_DOCTOR_LIFECYCLE) == true;
    fact_has_owner(FACT_RECOVERY_LADDER) == true;
}

invariant one_fact_never_has_two_owners {
    no_two_facts_share_one_owner(FACT_PROVIDER_ROUTES, FACT_LADDER_ORDER) == true;
    no_two_facts_share_one_owner(FACT_CHECKPOINT_CONTRACT, FACT_DISK_POLICY) == true;
    no_two_facts_share_one_owner(FACT_RELEASE_GATES, FACT_CODE_BOUNDARY) == true;
    no_two_facts_share_one_owner(FACT_CREDENTIALS, FACT_PROVIDER_ROUTES) == true;
    no_two_facts_share_one_owner(FACT_DOCTOR_LIFECYCLE, FACT_RECOVERY_LADDER) == true;
    no_two_facts_share_one_owner(FACT_DOCTOR_LIFECYCLE, FACT_CHECKPOINT_CONTRACT) == true;
}

invariant forbidden_logic_is_never_admissible {
    classification_is_admissible(KIND_FORBIDDEN) == false;
    classify_change(true, false, false, true) == KIND_FORBIDDEN;
}

invariant the_glue_budget_holds_under_every_label {
    override_label_lifts_budget() == false;
    glue_budget_ok(41, 10) == false;
    glue_budget_ok(10, 81) == false;
}

invariant a_behaviour_change_always_carries_a_spec {
    needs_spec(true, false) == true;
}

invariant a_generator_gap_becomes_an_issue_not_hand_written_code {
    compiler_defect_required(true) == true;
}
