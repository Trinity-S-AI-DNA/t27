// SPDX-License-Identifier: Apache-2.0
// T27 Model Ladder SSOT
// Purpose: the ordered ladder of providers and models, the per-model request
//          adaptation, and the rules of every rung switch.
//
// Owner: T27_ORDER_RESTORE_01 (issue #12897), 2026-10-30.
//
// OWNS:
//   - the rung order (priority) of the model ladder
//   - the model bound to each rung
//   - the per-model request adaptation (thinking compatibility)
//   - the rules of a rung switch: advance, stop, disable
//   - the rung-walk attempt budget of one request
//   - which providers stay out of the ladder until they are funded
//
// DOES NOT OWN (never restate these facts here):
//   - provider identity, route scope, funding and quarantine state:
//       specs/system/providers.t27
//   - failure-class taxonomy, preflight verdicts, transient retry budget:
//       specs/system/llm_request_provider_gate.t27
//   - circuit breaker states and cooldowns:
//       specs/system/model_routing_circuit_breaker.t27
//   - key values, rotation, dead-key quarantine:
//       specs/system/credentials.t27
//   - the fact-ownership map of the system layer:
//       specs/system/language-boundary.t27
//
// Live evidence (2026-10-30):
//   - z.ai rejects glm-5.3-flash with "this model always engages in thinking
//     and cannot be disabled", so a request that asks for thinking=disabled
//     is refused before it can be served
//   - the ladder answered through glm-4.5-flash while glm-5.3-flash was
//     unreachable, which is a silent downgrade unless it is declared
//
// Ladder (owner decision, 2026-10-30):
//   1  nvidia-nim funded models
//   2  t27-ladder  glm-5.3-flash   (thinking: low)
//   3  t27-ladder  glm-4.5-flash   (proven working)
//   4  local ollama limited fallback
//   deepseek stays out until it is explicitly funded

module model_ladder;

// ─── Rungs ─────────────────────────────────────────────────────────────────

pub const RUNG_NVIDIA_NIM : u8 = 0;
pub const RUNG_T27_LADDER_GLM53 : u8 = 1;
pub const RUNG_T27_LADDER_GLM45 : u8 = 2;
pub const RUNG_LOCAL_OLLAMA : u8 = 3;
pub const RUNG_COUNT : u32 = 4;
pub const RUNG_NONE : u8 = 255;

// ─── Models ────────────────────────────────────────────────────────────────

pub const MODEL_NIM_FUNDED : u8 = 0;
pub const MODEL_GLM_53 : u8 = 1;
pub const MODEL_GLM_45 : u8 = 2;
pub const MODEL_GEMMA_LOCAL : u8 = 3;

// ─── Thinking modes ────────────────────────────────────────────────────────

pub const THINKING_DISABLED : u8 = 0;
pub const THINKING_LOW : u8 = 1;
pub const THINKING_HIGH : u8 = 2;
pub const THINKING_MAX : u8 = 3;

// ─── Rung walk budget ──────────────────────────────────────────────────────
//
// The budget of RUNG ATTEMPTS of one request. It is NOT the transient retry
// budget of a single provider call: that budget is owned by
// specs/system/llm_request_provider_gate.t27.

pub const RUNG_ATTEMPT_BUDGET : u32 = 3;

// ─── Functions ─────────────────────────────────────────────────────────────

// rung_count() - how many rungs the ladder has.
pub fn rung_count() -> u32 {
    return RUNG_COUNT;
}

// rung_priority(rung) - the priority of a rung; a smaller value wins.
pub fn rung_priority(rung: u8) -> u32 {
    return rung;
}

// model_for_rung(rung) - exactly one model per rung.
pub fn model_for_rung(rung: u8) -> u8 {
    if (rung == RUNG_NVIDIA_NIM) {
        return MODEL_NIM_FUNDED;
    }
    if (rung == RUNG_T27_LADDER_GLM53) {
        return MODEL_GLM_53;
    }
    if (rung == RUNG_T27_LADDER_GLM45) {
        return MODEL_GLM_45;
    }
    if (rung == RUNG_LOCAL_OLLAMA) {
        return MODEL_GEMMA_LOCAL;
    }
    return MODEL_GEMMA_LOCAL;
}

// rung_is_limited_capability(rung) - the local rung is an emergency
// fallback, not an equal lane. Callers must be able to see the downgrade.
pub fn rung_is_limited_capability(rung: u8) -> bool {
    if (rung == RUNG_LOCAL_OLLAMA) {
        return true;
    }
    return false;
}

// thinking_disabled_supported(model) - z.ai glm-5.3-flash always engages in
// thinking; asking for "disabled" is a request the upstream refuses.
pub fn thinking_disabled_supported(model: u8) -> bool {
    if (model == MODEL_GLM_53) {
        return false;
    }
    return true;
}

// thinking_mode_for(model, requested) - the compatibility mapping. A caller
// that asks for "disabled" on a model that cannot disable thinking receives
// the cheapest thinking mode the model accepts (low). Every other requested
// mode is preserved exactly, so the caller's intent survives.
pub fn thinking_mode_for(model: u8, requested: u8) -> u8 {
    if (model == MODEL_GLM_53 and requested == THINKING_DISABLED) {
        return THINKING_LOW;
    }
    return requested;
}

// next_rung(current, recoverable, funded_rung_left) - the walk advances only
// when the failure is recoverable AND a funded rung is still available. A
// walk that ran out of funded rungs stops; it never invents a route.
pub fn next_rung(current: u8, recoverable: bool, funded_rung_left: bool) -> u8 {
    if (recoverable == false) {
        return RUNG_NONE;
    }
    if (funded_rung_left == false) {
        return RUNG_NONE;
    }
    if (current == RUNG_LOCAL_OLLAMA) {
        return RUNG_NONE;
    }
    return current + 1;
}

// rung_disabled_after_unfunded(rung) - an exhausted provider leaves the
// ladder. The quarantine itself is owned by specs/system/providers.t27.
pub fn rung_disabled_after_unfunded(rung: u8) -> bool {
    if (rung == RUNG_NONE) {
        return false;
    }
    return true;
}

// rung_survives_invalid_key(rung) - one rejected credential does not remove
// the rung: the pool may still hold other credentials for the same provider.
// The credential itself is quarantined by specs/system/credentials.t27.
pub fn rung_survives_invalid_key(rung: u8) -> bool {
    if (rung == RUNG_NONE) {
        return false;
    }
    return true;
}

// rung_attempt_budget() - how many rungs one request may try.
pub fn rung_attempt_budget() -> u32 {
    return RUNG_ATTEMPT_BUDGET;
}

// switch_record_required(switched) - every switch is visible: a rung change
// always produces a record. There is no silent switch.
pub fn switch_record_required(switched: bool) -> bool {
    return switched;
}

// provider_admitted_until_funded(provider_is_funded) - a provider that is not
// explicitly funded never enters the ladder.
pub fn provider_admitted_until_funded(provider_is_funded: bool) -> bool {
    return provider_is_funded;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "ladder_has_the_declared_four_rungs" {
    assert(rung_count() == 4);
    assert(rung_priority(RUNG_NVIDIA_NIM) == 0);
    assert(rung_priority(RUNG_T27_LADDER_GLM53) == 1);
    assert(rung_priority(RUNG_T27_LADDER_GLM45) == 2);
    assert(rung_priority(RUNG_LOCAL_OLLAMA) == 3);
}

test "every_rung_binds_exactly_one_model" {
    assert(model_for_rung(RUNG_NVIDIA_NIM) == MODEL_NIM_FUNDED);
    assert(model_for_rung(RUNG_T27_LADDER_GLM53) == MODEL_GLM_53);
    assert(model_for_rung(RUNG_T27_LADDER_GLM45) == MODEL_GLM_45);
    assert(model_for_rung(RUNG_LOCAL_OLLAMA) == MODEL_GEMMA_LOCAL);
}

test "glm_53_thinking_disabled_is_mapped_to_low" {
    assert(thinking_disabled_supported(MODEL_GLM_53) == false);
    assert(thinking_mode_for(MODEL_GLM_53, THINKING_DISABLED) == THINKING_LOW);
}

test "every_other_thinking_request_is_preserved" {
    assert(thinking_mode_for(MODEL_GLM_45, THINKING_DISABLED) == THINKING_DISABLED);
    assert(thinking_mode_for(MODEL_GLM_53, THINKING_LOW) == THINKING_LOW);
    assert(thinking_mode_for(MODEL_GLM_53, THINKING_HIGH) == THINKING_HIGH);
    assert(thinking_mode_for(MODEL_GLM_53, THINKING_MAX) == THINKING_MAX);
    assert(thinking_mode_for(MODEL_GEMMA_LOCAL, THINKING_DISABLED) == THINKING_DISABLED);
}

test "walk_advances_to_the_next_rung_while_a_funded_rung_remains" {
    assert(next_rung(RUNG_NVIDIA_NIM, true, true) == RUNG_T27_LADDER_GLM53);
    assert(next_rung(RUNG_T27_LADDER_GLM53, true, true) == RUNG_T27_LADDER_GLM45);
    assert(next_rung(RUNG_T27_LADDER_GLM45, true, true) == RUNG_LOCAL_OLLAMA);
}

test "walk_stops_on_a_terminal_failure" {
    assert(next_rung(RUNG_T27_LADDER_GLM53, false, true) == RUNG_NONE);
}

test "walk_stops_when_no_funded_rung_is_left" {
    assert(next_rung(RUNG_T27_LADDER_GLM45, true, false) == RUNG_NONE);
}

test "local_ollama_is_the_last_rung_and_is_marked_limited" {
    assert(next_rung(RUNG_LOCAL_OLLAMA, true, true) == RUNG_NONE);
    assert(rung_is_limited_capability(RUNG_LOCAL_OLLAMA) == true);
    assert(rung_is_limited_capability(RUNG_T27_LADDER_GLM45) == false);
}

test "unfunded_provider_leaves_the_ladder_but_an_invalid_key_does_not" {
    assert(rung_disabled_after_unfunded(RUNG_T27_LADDER_GLM53) == true);
    assert(rung_survives_invalid_key(RUNG_T27_LADDER_GLM53) == true);
    assert(rung_disabled_after_unfunded(RUNG_NONE) == false);
    assert(rung_survives_invalid_key(RUNG_NONE) == false);
}

test "rung_walk_budget_is_bounded" {
    assert(rung_attempt_budget() == 3);
}

test "every_switch_is_recorded" {
    assert(switch_record_required(true) == true);
    assert(switch_record_required(false) == false);
}

test "an_unfunded_provider_is_not_admitted_to_the_ladder" {
    assert(provider_admitted_until_funded(true) == true);
    assert(provider_admitted_until_funded(false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant priority_is_strictly_increasing {
    rung_priority(RUNG_NVIDIA_NIM) < rung_priority(RUNG_T27_LADDER_GLM53);
    rung_priority(RUNG_T27_LADDER_GLM53) < rung_priority(RUNG_T27_LADDER_GLM45);
    rung_priority(RUNG_T27_LADDER_GLM45) < rung_priority(RUNG_LOCAL_OLLAMA);
}

invariant a_model_that_requires_thinking_is_never_sent_disabled {
    thinking_mode_for(MODEL_GLM_53, THINKING_DISABLED) != THINKING_DISABLED;
    thinking_mode_for(MODEL_GLM_45, THINKING_DISABLED) == THINKING_DISABLED;
}

invariant the_walk_never_downgrades_to_a_lower_priority_rung {
    next_rung(RUNG_NVIDIA_NIM, true, true) > rung_priority(RUNG_NVIDIA_NIM);
    next_rung(RUNG_T27_LADDER_GLM53, true, true) > rung_priority(RUNG_T27_LADDER_GLM53);
    next_rung(RUNG_T27_LADDER_GLM45, true, true) > rung_priority(RUNG_T27_LADDER_GLM45);
}

invariant the_walk_stops_when_no_funded_rung_is_left {
    next_rung(RUNG_T27_LADDER_GLM45, true, false) == RUNG_NONE;
    next_rung(RUNG_LOCAL_OLLAMA, true, true) == RUNG_NONE;
}

invariant the_local_limited_fallback_is_the_last_rung {
    rung_is_limited_capability(RUNG_LOCAL_OLLAMA) == true;
    rung_is_limited_capability(RUNG_NVIDIA_NIM) == false;
    rung_is_limited_capability(RUNG_T27_LADDER_GLM53) == false;
    rung_is_limited_capability(RUNG_T27_LADDER_GLM45) == false;
}

invariant the_rung_walk_stays_within_its_budget {
    rung_attempt_budget() == 3;
    rung_attempt_budget() <= rung_count();
}
