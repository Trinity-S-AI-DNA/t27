// SPDX-License-Identifier: Apache-2.0
// T27 Model Ladder Policy SSOT
// Purpose: the policy that sits ABOVE any rung table: when the walk may
//          switch, that a switch is visible, how many rungs one request may
//          try, and what a model can actually serve.
//
// Owner: T27_ORDER_RESTORE_01 (issue #14282), 2026-10-30.
//
// OWNS:
//   - the switch policy of the system layer: when a switch may happen, and
//     that every switch is recorded (no silent switch)
//   - the rung-walk attempt budget of ONE request
//   - the model capability facts: what a model can serve, measured and dated
//   - the rule that the system order and the node table must agree
//   - the rule that a provider stays out of the table until it is funded
//
// DOES NOT OWN (never restate these facts here):
//   - the rung table itself (rungs, endpoints, head model, probe size, the
//     fail-closed 503 that names every rung, the thinking-off serve law):
//       specs/t27os/ladder.t27
//   - the acceleration variants (the measured head, the sticky last-good
//     rung, the hedge): specs/t27os/ladder_speed.t27
//   - the serve loop that walks the table: specs/t27os/ladder_serve.t27
//   - the vibee agent chain order: specs/automation/agent-provider-chain.t27
//   - the route classes, the admission of a route, the quarantine state and
//     the status transparency rule: specs/system/providers.t27
//   - the dated route matrix and the per-credential refusal machinery:
//       specs/queen/api_fleet.t27, specs/queen/key_failover.t27
//   - the recovery ladder levels (preserve, retry transient, switch approved
//     route, degrade, hand off) and the bounded transient retry budget:
//       specs/system/session-recovery-ladder.t27
//   - the Doctor states and the visible status bar:
//       specs/system/session-doctor.t27
//   - the checkpoint contract and the resume decision:
//       specs/system/session-continuity.t27
//   - the fact-ownership index of the system layer:
//       specs/system/language-boundary.t27
//
// Live evidence (2026-10-30, local route 127.0.0.1:3131):
//   - the zai GLM HEAD (glm-5.3-flash) answered HTTP 400 "This model always
//     engages in thinking and cannot be disabled; please use low, high, or
//     max" on four of five pooled credentials; the ladder therefore served
//     the request through the zai GLM FALLBACK (glm-4.5-flash)
//   - one pooled credential answered HTTP 401 and one was out of quota until
//     2026-11-01 14:35:31
//   - the serve law of specs/t27os/ladder.t27 (law 6) asks the head to run
//     with thinking off, which the upstream refused on that day: the two must
//     be reconciled by their owner (issue #14283), not by two specs each
//     holding a different law

module model_ladder;

// ─── Model classes ─────────────────────────────────────────────────────────
//
// The model NAMES belong to the node table (specs/t27os/ladder.t27 and
// specs/t27os/ladder_speed.t27). These are roles only.

pub const MODEL_GLM_HEAD : u8 = 0;      // the zai GLM head of the node table
pub const MODEL_GLM_FALLBACK : u8 = 1;  // the zai GLM fallback of the node table
pub const MODEL_UNKNOWN : u8 = 2;

// ─── Thinking capability ───────────────────────────────────────────────────

pub const CAP_UNKNOWN : u8 = 0;
pub const CAP_THINKING_OFF_ACCEPTED : u8 = 1;  // thinking may be turned off
pub const CAP_THINKING_REQUIRED : u8 = 2;      // thinking always engages

// ─── Thinking modes ────────────────────────────────────────────────────────

pub const THINKING_DISABLED : u8 = 0;
pub const THINKING_LOW : u8 = 1;
pub const THINKING_HIGH : u8 = 2;
pub const THINKING_MAX : u8 = 3;

// ─── Rung walk budget ──────────────────────────────────────────────────────
//
// How many RUNGS one request may try. It is NOT the transient retry budget
// of a single credential (specs/queen/key_failover.t27 and
// specs/system/session-recovery-ladder.t27) and NOT the transient retry
// budget of the request gate (specs/system/llm_request_provider_gate.t27).

pub const RUNG_ATTEMPT_BUDGET : u32 = 3;

// ─── Functions ─────────────────────────────────────────────────────────────

// switch_may_happen(rung_refused, next_rung_exists) -> bool - the walk
// switches only when the current rung refused and another rung exists.
pub fn switch_may_happen(rung_refused: bool, next_rung_exists: bool) -> bool {
    if (rung_refused == false) {
        return false;
    }
    if (next_rung_exists == false) {
        return false;
    }
    return true;
}

// switch_must_be_visible(switched) -> bool - every switch leaves a record.
// There is no silent switch, and a downgrade to a limited rung is a switch
// the caller must be able to see.
pub fn switch_must_be_visible(switched: bool) -> bool {
    return switched;
}

// rung_walk_budget() - how many rungs one request may try.
pub fn rung_walk_budget() -> u32 {
    return RUNG_ATTEMPT_BUDGET;
}

// walk_attempts_within_budget(attempts) -> bool
pub fn walk_attempts_within_budget(attempts: u32) -> bool {
    return attempts <= RUNG_ATTEMPT_BUDGET;
}

// model_thinking_capability(model) -> u8 - what the upstream accepts.
//
// The zai GLM HEAD refused thinking=disabled with HTTP 400 on 2026-10-30 and
// named the modes it accepts (low, high, max); the zai GLM FALLBACK served
// thinking-off requests with HTTP 200 on the same day.
pub fn model_thinking_capability(model: u8) -> u8 {
    if (model == MODEL_GLM_HEAD) {
        return CAP_THINKING_REQUIRED;
    }
    if (model == MODEL_GLM_FALLBACK) {
        return CAP_THINKING_OFF_ACCEPTED;
    }
    return CAP_UNKNOWN;
}

// capability_requires_thinking(model) -> bool
pub fn capability_requires_thinking(model: u8) -> bool {
    if (model_thinking_capability(model) == CAP_THINKING_REQUIRED) {
        return true;
    }
    return false;
}

// thinking_request_is_servable(model, requested_mode) -> bool - a request
// that asks a model for something it cannot serve is NOT servable as asked.
// The caller must learn that, instead of receiving a 400 from the upstream.
// What the ladder SENDS instead is the serve law of
// specs/t27os/ladder.t27, not this file.
pub fn thinking_request_is_servable(model: u8, requested_mode: u8) -> bool {
    if (requested_mode != THINKING_DISABLED) {
        return true;
    }
    if (capability_requires_thinking(model)) {
        return false;
    }
    return true;
}

// order_and_table_must_agree(system_order_count, node_table_count) -> bool -
// the system layer must not route against a table it does not know. A
// mismatch is a gap, not a licence to guess.
pub fn order_and_table_must_agree(system_order_count: u32, node_table_count: u32) -> bool {
    return system_order_count == node_table_count;
}

// provider_admitted_until_funded(provider_is_funded) -> bool - a provider
// that is not funded never enters the table.
pub fn provider_admitted_until_funded(provider_is_funded: bool) -> bool {
    return provider_is_funded;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "a_switch_needs_a_refusal_and_a_next_rung" {
    assert(switch_may_happen(true, true) == true);
    assert(switch_may_happen(false, true) == false);
    assert(switch_may_happen(true, false) == false);
    assert(switch_may_happen(false, false) == false);
}

test "every_switch_is_visible" {
    assert(switch_must_be_visible(true) == true);
    assert(switch_must_be_visible(false) == false);
}

test "the_rung_walk_budget_is_three" {
    assert(rung_walk_budget() == 3);
    assert(walk_attempts_within_budget(3) == true);
    assert(walk_attempts_within_budget(4) == false);
    assert(walk_attempts_within_budget(0) == true);
}

test "the_head_requires_thinking_and_the_fallback_does_not" {
    assert(model_thinking_capability(MODEL_GLM_HEAD) == CAP_THINKING_REQUIRED);
    assert(model_thinking_capability(MODEL_GLM_FALLBACK) == CAP_THINKING_OFF_ACCEPTED);
    assert(model_thinking_capability(MODEL_UNKNOWN) == CAP_UNKNOWN);
    assert(capability_requires_thinking(MODEL_GLM_HEAD) == true);
    assert(capability_requires_thinking(MODEL_GLM_FALLBACK) == false);
}

test "a_request_the_model_cannot_serve_is_not_servable_as_asked" {
    assert(thinking_request_is_servable(MODEL_GLM_HEAD, THINKING_DISABLED) == false);
    assert(thinking_request_is_servable(MODEL_GLM_HEAD, THINKING_LOW) == true);
    assert(thinking_request_is_servable(MODEL_GLM_HEAD, THINKING_MAX) == true);
    assert(thinking_request_is_servable(MODEL_GLM_FALLBACK, THINKING_DISABLED) == true);
}

test "the_system_order_and_the_node_table_must_agree" {
    assert(order_and_table_must_agree(4, 4) == true);
    assert(order_and_table_must_agree(4, 5) == false);
    assert(order_and_table_must_agree(0, 0) == true);
}

test "an_unfunded_provider_is_not_admitted" {
    assert(provider_admitted_until_funded(true) == true);
    assert(provider_admitted_until_funded(false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant a_switch_always_leaves_a_record {
    switch_must_be_visible(true) == true;
    switch_may_happen(false, true) == false;
}

invariant the_walk_stays_inside_its_budget {
    rung_walk_budget() == 3;
    walk_attempts_within_budget(4) == false;
    walk_attempts_within_budget(3) == true;
}

invariant a_model_that_requires_thinking_is_never_asked_for_thinking_off {
    thinking_request_is_servable(MODEL_GLM_HEAD, THINKING_DISABLED) == false;
    capability_requires_thinking(MODEL_GLM_HEAD) == true;
}

invariant the_system_never_routes_against_an_unknown_table {
    order_and_table_must_agree(4, 5) == false;
    order_and_table_must_agree(4, 4) == true;
}

invariant an_unfunded_provider_never_enters_the_table {
    provider_admitted_until_funded(false) == false;
}

invariant the_capability_of_every_known_model_is_known {
    model_thinking_capability(MODEL_GLM_HEAD) != CAP_UNKNOWN;
    model_thinking_capability(MODEL_GLM_FALLBACK) != CAP_UNKNOWN;
}
