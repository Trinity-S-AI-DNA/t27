// SPDX-License-Identifier: Apache-2.0
// T27 Model Routing Circuit Breaker
// Purpose: Prevent infinite retry loops on 503 unfunded errors
// Author: T27 Routing Specialist
// Date: 2026-10-29

module ModelRoutingCircuitBreaker {
    use base::types;
    use system::error;

    // ============================================================================
    // Circuit Breaker Configuration
    // ============================================================================

    pub const MAX_RETRIES : u32 = 3;
    pub const CIRCUIT_BREAK_TIMEOUT_MS : u64 = 30000; // 30 seconds
    pub const FALLBACK_COOLDOWN_MS : u64 = 60000; // 1 minute

    // Error classification types
    pub const ERROR_CLASSIFICATION = enum {
        RETRYABLE,           // Safe to retry
        TERMINAL,            // Should not retry
        CIRCUIT_BREAKER,     // Activate circuit breaker
        FALLBACK_REQUIRED,   // Use fallback provider
    };

    // Model route status
    pub const MODEL_ROUTE_STATUS = enum {
        ACTIVE,              // Route is active
        BLOCKED,             // Route is blocked (503 unfunded)
        COOLDOWN,            // In cooldown period
        FALLBACK_EXHAUSTED,  // No fallback providers available
    };

    // ============================================================================
    // Error Classification Logic
    // ============================================================================

    // classify_error categorizes HTTP errors by retryability
    pub fn classify_error(status_code: u16, error_message: str) -> ERROR_CLASSIFICATION {
        return switch (status_code) {
            // 503 Service Unavailable - check for unfunded specifically
            503 => {
                if (string_contains(error_message, "unfunded") or 
                    string_contains(error_message, "insufficient_funds") or
                    string_contains(error_message, "payment_required")) {
                    ERROR_CLASSIFICATION::CIRCUIT_BREAKER
                } else {
                    ERROR_CLASSIFICATION::RETRYABLE
                }
            },
            
            // 429 Too Many Requests - retry with backoff
            429 => ERROR_CLASSIFICATION::RETRYABLE,
            
            // 5xx Server errors - generally retryable except 503
            500, 501, 502, 504, 505...599 => ERROR_CLASSIFICATION::RETRYABLE,
            
            // 4xx Client errors - generally terminal
            400, 401, 402, 403, 404, 405, 406, 407, 408, 409, 
            410, 411, 412, 413, 414, 415, 416, 417, 418, 419...428,
            430, 431, 451 => ERROR_CLASSIFICATION::TERMINAL,
            
            // Success or unknown
            _ => ERROR_CLASSIFICATION::TERMINAL,
        };
    }

    // ============================================================================
    // Circuit Breaker State
    // ============================================================================

    pub struct CircuitBreakerState {
        status: MODEL_ROUTE_STATUS,
        failure_count: u32,
        last_failure_time: u64,
        retry_count: u32,
        blocked_until: u64,
        current_provider: str,
        fallback_provider: str?,
    }

    // ============================================================================
    // Circuit Breaker Logic
    // ============================================================================

    // should_retry determines if a request should be retried based on circuit breaker state
    pub fn should_retry(state: CircuitBreakerState, error_classification: ERROR_CLASSIFICATION) -> bool {
        match (error_classification) {
            ERROR_CLASSIFICATION::TERMINAL => false,
            ERROR_CLASSIFICATION::CIRCUIT_BREAKER => {
                // Activate circuit breaker
                if (state.failure_count >= MAX_RETRIES) {
                    state.status = MODEL_ROUTE_STATUS::BLOCKED;
                    state.blocked_until = current_timestamp_ms() + CIRCUIT_BREAK_TIMEOUT_MS;
                    return false;
                }
                return true;
            },
            ERROR_CLASSIFICATION::FALLBACK_REQUIRED => {
                // Try fallback provider
                if (state.fallback_provider != null) {
                    select_fallback_provider(state);
                    return true;
                }
                return false;
            },
            ERROR_CLASSIFICATION::RETRYABLE => {
                // Check if we're in cooldown
                if (state.status == MODEL_ROUTE_STATUS::COOLDOWN) {
                    if (current_timestamp_ms() < state.blocked_until) {
                        return false;
                    }
                    state.status = MODEL_ROUTE_STATUS::ACTIVE;
                }
                return true;
            },
        };
    }

    // record_failure updates circuit breaker state after a failed request
    pub fn record_failure(state: CircuitBreakerState, error_classification: ERROR_CLASSIFICATION) {
        state.last_failure_time = current_timestamp_ms();
        state.failure_count += 1;
        state.retry_count += 1;

        match (error_classification) {
            ERROR_CLASSIFICATION::CIRCUIT_BREAKER => {
                if (state.failure_count >= MAX_RETRIES) {
                    state.status = MODEL_ROUTE_STATUS::BLOCKED;
                    state.blocked_until = current_timestamp_ms() + CIRCUIT_BREAK_TIMEOUT_MS;
                }
            },
            ERROR_CLASSIFICATION::FALLBACK_REQUIRED => {
                if (state.fallback_provider == null) {
                    state.status = MODEL_ROUTE_STATUS::FALLBACK_EXHAUSTED;
                }
            },
            ERROR_CLASSIFICATION::TERMINAL => {
                state.status = MODEL_ROUTE_STATUS::BLOCKED;
                state.blocked_until = current_timestamp_ms() + CIRCUIT_BREAK_TIMEOUT_MS;
            },
            ERROR_CLASSIFICATION::RETRYABLE => {
                // Stay in active state, let backoff logic handle delay
            },
        }
    }

    // record_success resets circuit breaker state after a successful request
    pub fn record_success(state: CircuitBreakerState) {
        state.failure_count = 0;
        state.retry_count = 0;
        state.status = MODEL_ROUTE_STATUS::ACTIVE;
    }

    // ============================================================================
    // Fallback Provider Logic
    // ============================================================================

    // select_fallback_provider switches to fallback provider
    pub fn select_fallback_provider(state: CircuitBreakerState) {
        if (state.fallback_provider != null) {
            state.current_provider = state.fallback_provider.unwrap();
            state.status = MODEL_ROUTE_STATUS::COOLDOWN;
            state.blocked_until = current_timestamp_ms() + FALLBACK_COOLDOWN_MS;
        }
    }

    // has_fallback_available checks if fallback provider is configured
    pub fn has_fallback_available(state: CircuitBreakerState) -> bool {
        return state.fallback_provider != null;
    }

    // ============================================================================
    // Helper Functions
    // ============================================================================

    // current_timestamp_ms returns current timestamp in milliseconds
    fn current_timestamp_ms() -> u64 {
        // Implementation would use system time
        return 0;
    }

    // string_contains checks if string contains substring
    fn string_contains(haystack: str, needle: str) -> bool {
        return haystack.find(needle) != null;
    }

    // ============================================================================
    // TDD - Tests
    // ============================================================================

    test "classify_error_503_unfunded" {
        var classification = classify_error(503, "503 unfunded");
        assert(classification == ERROR_CLASSIFICATION::CIRCUIT_BREAKER);
    }

    test "classify_error_503_general" {
        var classification = classify_error(503, "503 service unavailable");
        assert(classification == ERROR_CLASSIFICATION::RETRYABLE);
    }

    test "classify_error_429" {
        var classification = classify_error(429, "429 too many requests");
        assert(classification == ERROR_CLASSIFICATION::RETRYABLE);
    }

    test "classify_error_404" {
        var classification = classify_error(404, "404 not found");
        assert(classification == ERROR_CLASSIFICATION::TERMINAL);
    }

    test "should_retry_terminal_error" {
        var state = CircuitBreakerState {
            status = MODEL_ROUTE_STATUS::ACTIVE,
            failure_count = 0,
            last_failure_time = 0,
            retry_count = 0,
            blocked_until = 0,
            current_provider = "deepseek",
            fallback_provider = null,
        };
        
        var should_retry_result = should_retry(state, ERROR_CLASSIFICATION::TERMINAL);
        assert(should_retry_result == false);
    }

    test "should_retry_circuit_breaker_below_max" {
        var state = CircuitBreakerState {
            status = MODEL_ROUTE_STATUS::ACTIVE,
            failure_count = 2, // Below MAX_RETRIES (3)
            last_failure_time = 0,
            retry_count = 0,
            blocked_until = 0,
            current_provider = "deepseek",
            fallback_provider = null,
        };
        
        var should_retry_result = should_retry(state, ERROR_CLASSIFICATION::CIRCUIT_BREAKER);
        assert(should_retry_result == true);
    }

    test "should_retry_circuit_breaker_above_max" {
        var state = CircuitBreakerState {
            status = MODEL_ROUTE_STATUS::ACTIVE,
            failure_count = 4, // Above MAX_RETRIES (3)
            last_failure_time = 0,
            retry_count = 0,
            blocked_until = 0,
            current_provider = "deepseek",
            fallback_provider = null,
        };
        
        var should_retry_result = should_retry(state, ERROR_CLASSIFICATION::CIRCUIT_BREAKER);
        assert(should_retry_result == false);
        assert(state.status == MODEL_ROUTE_STATUS::BLOCKED);
    }

    test "has_fallback_available_with_fallback" {
        var state = CircuitBreakerState {
            status = MODEL_ROUTE_STATUS::ACTIVE,
            failure_count = 0,
            last_failure_time = 0,
            retry_count = 0,
            blocked_until = 0,
            current_provider = "deepseek",
            fallback_provider = "openai",
        };
        
        var has_fallback = has_fallback_available(state);
        assert(has_fallback == true);
    }

    test "has_fallback_available_no_fallback" {
        var state = CircuitBreakerState {
            status = MODEL_ROUTE_STATUS::ACTIVE,
            failure_count = 0,
            last_failure_time = 0,
            retry_count = 0,
            blocked_until = 0,
            current_provider = "deepseek",
            fallback_provider = null,
        };
        
        var has_fallback = has_fallback_available(state);
        assert(has_fallback == false);
    }

    // ============================================================================
    // TDD - Invariants
    // ============================================================================

    invariant circuit_breaker_constants_valid {
        MAX_RETRIES > 0;
        CIRCUIT_BREAK_TIMEOUT_MS > 0;
        FALLBACK_COOLDOWN_MS > 0;
    }

    invariant model_route_status_enum_values {
        MODEL_ROUTE_STATUS::ACTIVE as u32 == 0;
        MODEL_ROUTE_STATUS::BLOCKED as u32 == 1;
        MODEL_ROUTE_STATUS::COOLDOWN as u32 == 2;
        MODEL_ROUTE_STATUS::FALLBACK_EXHAUSTED as u32 == 3;
    }

    invariant error_classification_enum_values {
        ERROR_CLASSIFICATION::RETRYABLE as u32 == 0;
        ERROR_CLASSIFICATION::TERMINAL as u32 == 1;
        ERROR_CLASSIFICATION::CIRCUIT_BREAKER as u32 == 2;
        ERROR_CLASSIFICATION::FALLBACK_REQUIRED as u32 == 3;
    }
}