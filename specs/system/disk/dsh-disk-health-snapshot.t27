// T27 Disk Health Snapshot Specification
// Part of T27_DISK_NEVER_ENOSPC_01 disk health gate
// Provides disk space measurement, growth rate analysis, and top consumer identification

spec "dsh-disk-health-snapshot" {
    // Public interface
    pub fn snapshot() -> DiskHealthSnapshot;
    pub fn get_free_space_gb() -> f64;
    pub fn get_growth_rate_gb_per_day() -> f64;
    pub fn get_top_consumers(count: u32) -> Vec<PathInfo>;
    
    // Types
    type DiskHealthSnapshot {
        free_space_gb: f64,
        total_space_gb: f64,
        used_percent: f64,
        growth_rate_gb_per_day: f64,
        top_consumers: Vec<PathInfo>,
        timestamp_ms: u64,
        healthy: bool,
        warning: bool,
        critical: bool,
    }
    
    type PathInfo {
        path: string,
        size_gb: f64,
        files: u32,
        is_directory: bool,
    }
    
    // Constants
    const WARNING_THRESHOLD_GB = 5.0;  // Warning below 5GB free
    const CRITICAL_THRESHOLD_GB = 2.0; // Critical below 2GB free
    const SAMPLE_INTERVAL_MS = 3600000; // 1 hour between growth samples
    
    // Internal state
    var last_snapshot: DiskHealthSnapshot?;
    var growth_samples: Vec<f64> = [];
    var sample_timestamps: Vec<u64> = [];
    
    // Implementation
    fn snapshot() -> DiskHealthSnapshot {
        let free = get_free_space_gb();
        let total = get_total_space_gb();
        let used_percent = (total - free) / total * 100.0;
        let growth = calculate_growth_rate();
        let top = get_top_consumers(10);
        
        let healthy = free >= WARNING_THRESHOLD_GB;
        let warning = free < WARNING_THRESHOLD_GB && free >= CRITICAL_THRESHOLD_GB;
        let critical = free < CRITICAL_THRESHOLD_GB;
        
        let result = DiskHealthSnapshot {
            free_space_gb: free,
            total_space_gb: total,
            used_percent: used_percent,
            growth_rate_gb_per_day: growth,
            top_consumers: top,
            timestamp_ms: current_timestamp_ms(),
            healthy: healthy,
            warning: warning,
            critical: critical,
        };
        
        // Update growth samples
        growth_samples.push(growth);
        sample_timestamps.push(current_timestamp_ms());
        
        // Keep only last 24 samples
        if growth_samples.len() > 24 {
            growth_samples.remove(0);
            sample_timestamps.remove(0);
        }
        
        last_snapshot = Some(result);
        result
    }
    
    fn get_free_space_gb() -> f64 {
        // Execute system command to get free space
        let output = execute_command("df -h /");
        parse_df_output(output)
    }
    
    fn get_total_space_gb() -> f64 {
        let output = execute_command("df -h /");
        parse_total_space(output)
    }
    
    fn calculate_growth_rate() -> f64 {
        if growth_samples.len() < 2 {
            return 0.0;
        }
        
        let recent_samples = growth_samples.iter().rev().take(5).collect::<Vec<_>>();
        if recent_samples.len() < 2 {
            return 0.0;
        }
        
        let total_growth = recent_samples[recent_samples.len() - 1] - recent_samples[0];
        let time_days = (sample_timestamps[sample_timestamps.len() - 1] - sample_timestamps[sample_timestamps.len() - recent_samples.len()]) as f64 / (86400000.0); // ms to days
        
        if time_days > 0.0 {
            total_growth / time_days
        } else {
            0.0
        }
    }
    
    fn get_top_consumers(count: u32) -> Vec<PathInfo> {
        let mut consumers = Vec::new();
        
        // Check key directories
        let paths = vec![
            "/Users/playom/Library",
            "/Users/playom/Downloads", 
            "/Users/playom/.cache",
            "/Users/playom/.npm",
            "/Users/playom/.local",
            "/Users/playom/Library/Caches",
            "/Users/playom/Library/Application Support",
            "/Users/playom/.dsh",
            "/Users/playom/deepseek-harness",
            "/Users/playom/t27"
        ];
        
        for path in paths.iter() {
            let size = get_directory_size_gb(path);
            let file_count = count_directory_files(path);
            
            consumers.push(PathInfo {
                path: path.clone(),
                size_gb: size,
                files: file_count,
                is_directory: true,
            });
        }
        
        // Sort by size and return top N
        consumers.sort_by(|a, b| b.size_gb.partial_cmp(&a.size_gb).unwrap_or(std::cmp::Ordering::Equal));
        consumers.iter().take(count as usize).cloned().collect()
    }
    
    fn get_directory_size_gb(path: string) -> f64 {
        let output = execute_command(format!("du -sh {} 2>/dev/null", path));
        parse_du_output(output)
    }
    
    fn count_directory_files(path: string) -> u32 {
        let output = execute_command(format!("find {} -type f 2>/dev/null | wc -l", path));
        parse_wc_output(output)
    }
    
    // Parser helpers
    fn parse_df_output(output: string) -> f64 {
        // Parse: Filesystem        Size    Used   Avail Capacity ...
        // Extract Avail column
        let lines: Vec<string> = output.split('\n').collect();
        for line in lines {
            if line.contains("/dev/") && line.contains("228Gi") {
                let parts: Vec<string> = line.split_whitespace().collect();
                if parts.len() >= 4 {
                    let avail_str = parts[3].replace("Gi", "");
                    return avail_str.parse::<f64>().unwrap_or(0.0);
                }
            }
        }
        0.0
    }
    
    fn parse_total_space(output: string) -> f64 {
        let lines: Vec<string> = output.split('\n').collect();
        for line in lines {
            if line.contains("/dev/") && line.contains("228Gi") {
                let parts: Vec<string> = line.split_whitespace().collect();
                if parts.len() >= 2 {
                    let size_str = parts[1].replace("Gi", "");
                    return size_str.parse::<f64>().unwrap_or(0.0);
                }
            }
        }
        0.0
    }
    
    fn parse_du_output(output: string) -> f64 {
        // Parse: 1.6G    /path
        let parts: Vec<string> = output.split_whitespace().collect();
        if parts.len() >= 1 {
            let size_str = parts[0];
            if size_str.ends_with('G') || size_str.ends_with('g') {
                let num_str = &size_str[0..size_str.len() - 1];
                return num_str.parse::<f64>().unwrap_or(0.0);
            }
        }
        0.0
    }
    
    fn parse_wc_output(output: string) -> u32 {
        output.trim().parse::<u32>().unwrap_or(0)
    }
    
    fn current_timestamp_ms() -> u64 {
        execute_command("date +%s").parse::<u64>().unwrap_or(0) * 1000
    }
    
    // Execute command wrapper
    fn execute_command(cmd: string) -> string {
        // This would be implemented by the runtime
        // For now, return placeholder
        "placeholder"
    }
    
    // Test suite
    test "disk_health_snapshot_basic" {
        let snapshot = snapshot();
        assert(snapshot.free_space_gb >= 0.0);
        assert(snapshot.total_space_gb > 0.0);
        assert(snapshot.used_percent >= 0.0 && snapshot.used_percent <= 100.0);
        assert(snapshot.top_consumers.len() >= 1);
    }
    
    test "disk_health_warning_threshold" {
        let snapshot = snapshot();
        if snapshot.free_space_gb < WARNING_THRESHOLD_GB {
            assert(snapshot.warning || snapshot.critical);
        }
    }
    
    test "disk_health_critical_threshold" {
        let snapshot = snapshot();
        if snapshot.free_space_gb < CRITICAL_THRESHOLD_GB {
            assert(snapshot.critical);
        }
    }
    
    bench "disk_snapshot_performance" {
        for i in 0..10 {
            snapshot();
        }
    }
}