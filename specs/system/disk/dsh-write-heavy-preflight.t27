// T27 Write-Heavy Preflight Specification
// Part of T27_DISK_NEVER_ENOSPC_01 disk health gate
// Provides task footprint estimation, space reservation, and write-heavy task blocking

spec "dsh-write-heavy-preflight" {
    // Public interface
    pub fn check_write_heavy_task(task: WriteHeavyTask) -> PreflightResult;
    pub fn estimate_task_footprint(task: WriteHeavyTask) -> FootprintEstimate;
    pub fn reserve_space(required_gb: f64) -> ReservationResult;
    pub fn release_reservation(reservation_id: string) -> bool;
    pub fn enforce_disk_gate(task: WriteHeavyTask) -> EnforcementResult;
    
    // Types
    type WriteHeavyTask {
        name: string,
        task_type: TaskType,
        estimated_size_gb: f64,
        max_duration_minutes: u32,
        working_directory: string,
        temp_files: Vec<string>,
        output_files: Vec<string>,
        requirements: TaskRequirements,
        criticality: Criticality,
    }
    
    type PreflightResult {
        approved: bool,
        warnings: Vec<string>,
        errors: Vec<string>,
        recommended_action: RecommendedAction,
        estimated_completion_time_ms: u64,
        confidence: f64,
    }
    
    type FootprintEstimate {
        total_size_gb: f64,
        working_space_gb: f64,
        temp_space_gb: f64,
        output_space_gb: f64,
        overhead_gb: f64,
        confidence: f64,
        margin_of_error_percent: f64,
        worst_case_gb: f64,
    }
    
    type ReservationResult {
        success: bool,
        reservation_id: string,
        reserved_gb: f64,
        expires_at_ms: u64,
        error_message: string,
    }
    
    type EnforcementResult {
        allowed: bool,
        requires_cleanup: bool,
        cleanup_plan: CleanupPlan?,
        blocking_reason: string,
        suggested_alternative: string,
        estimated_risk: RiskLevel,
    }
    
    type TaskRequirements {
        min_free_gb: f64,
        reserve_gb: f64,
        requires_internet: bool,
        requires_gpu: bool,
        max_concurrent_writes: u32,
        temp_cleanup_required: bool,
    }
    
    // Enums
    enum TaskType {
        BUILD,          // Compilation, packaging
        DOWNLOAD,       // Large file downloads
        TRAINING,       // ML model training
        EXPORT,         // Data export, archiving
        MIGRATION,      // System/data migration
        INSTALLATION,   // Package installation
        GENERATION,     // Code/data generation
        ANALYSIS,       // Data processing, analysis
        BACKUP,         // Data backup operations
    }
    
    enum Criticality {
        LOW,      // Non-critical, can be rescheduled
        MEDIUM,   // Important, should run as scheduled
        HIGH,     // Critical, cannot be delayed
        CRITICAL, // System-critical, must run immediately
    }
    
    enum RecommendedAction {
        PROCEED,        // Task can proceed normally
        PROCEED_WITH_CLEANUP,  // Task can proceed after cleanup
        RESCHEDULE,     // Task should be rescheduled
        BLOCK,          // Task should be blocked
        ALTERNATIVE,    // Use alternative approach
    }
    
    enum RiskLevel {
        NONE,
        LOW,
        MEDIUM,
        HIGH,
        CRITICAL,
    }
    
    // Constants
    const TASK_TYPE_WEIGHTS = {
        TaskType::BUILD: 1.2,
        TaskType::DOWNLOAD: 1.0,
        TaskType::TRAINING: 2.5,
        TaskType::EXPORT: 1.5,
        TaskType::MIGRATION: 2.0,
        TaskType::INSTALLATION: 1.3,
        TaskType::GENERATION: 1.1,
        TaskType::ANALYSIS: 0.8,
        TaskType::BACKUP: 1.0,
    };
    
    const CRITICALITY_MULTIPLIERS = {
        Criticality::LOW: 1.0,
        Criticality::MEDIUM: 1.2,
        Criticality::HIGH: 1.5,
        Criticality::CRITICAL: 2.0,
    };
    
    const MIN_SAFE_FREE_GB = 5.0;
    const RESERVATION_DURATION_MS = 3600000; // 1 hour
    const MAX_RESERVATION_GB = 50.0;
    const OVERHEAD_MULTIPLIER = 1.2; // 20% overhead
    
    // State
    var active_reservations: HashMap<string, Reservation> = HashMap::new();
    var task_history: Vec<TaskExecutionRecord> = Vec::new();
    var last_disk_snapshot: DiskHealthSnapshot?;
    
    // Main preflight check
    pub fn check_write_heavy_task(task: WriteHeavyTask) -> PreflightResult {
        // Get current disk state
        let disk_snapshot = get_current_disk_snapshot();
        last_disk_snapshot = Some(disk_snapshot);
        
        // Estimate task footprint
        let footprint = estimate_task_footprint(task);
        
        // Check space requirements
        let min_required = task.requirements.min_free_gb + footprint.total_size_gb;
        let available = disk_snapshot.free_space_gb;
        
        let mut warnings = Vec::new();
        let mut errors = Vec::new();
        
        // Check if task can proceed
        let can_proceed = available >= min_required;
        
        // Check for critical conditions
        if available < MIN_SAFE_FREE_GB {
            errors.push(format!("Critical: Only {:.2}GB free, minimum required: {:.2}GB", available, min_required));
        }
        
        if footprint.confidence < 0.7 {
            warnings.push(format!("Low confidence in footprint estimate: {:.1}%", footprint.confidence * 100.0));
        }
        
        // Check for high risk operations
        let risk_assessment = assess_task_risk(task, footprint, disk_snapshot);
        if risk_assessment >= RiskLevel::HIGH {
            warnings.push(format!("High risk task detected: {:?}", task.task_type));
        }
        
        // Generate recommendation
        let recommended_action = if !can_proceed {
            if can_attempt_cleanup(disk_snapshot, footprint) {
                RecommendedAction::PROCEED_WITH_CLEANUP
            } else {
                RecommendedAction::RESCHEDULE
            }
        } else if risk_assessment >= RiskLevel::CRITICAL {
            RecommendedAction::BLOCK
        } else {
            RecommendedAction::PROCEED
        };
        
        let estimated_completion = estimate_completion_time(task, footprint);
        
        PreflightResult {
            approved: can_proceed && recommended_action == RecommendedAction::PROCEED,
            warnings: warnings,
            errors: errors,
            recommended_action: recommended_action,
            estimated_completion_time_ms: estimated_completion,
            confidence: footprint.confidence,
        }
    }
    
    // Task footprint estimation
    pub fn estimate_task_footprint(task: WriteHeavyTask) -> FootprintEstimate {
        let base_size = task.estimated_size_gb;
        let type_weight = TASK_TYPE_WEIGHTS.get(task.task_type).unwrap_or(&1.0);
        let criticality_multiplier = CRITICALITY_MULTIPLIERS.get(task.criticality).unwrap_or(&1.0);
        
        // Calculate different components
        let working_space = base_size * 0.3; // 30% of total
        let temp_space = estimate_temp_space(task);
        let output_space = base_size;
        let overhead = base_size * (OVERHEAD_MULTIPLIER - 1.0);
        
        let total_size = (base_size * type_weight * criticality_multiplier) + overhead;
        
        // Estimate confidence based on task characteristics
        let mut confidence = 0.8; // Base confidence
        
        if task.estimated_size_gb < 1.0 {
            confidence += 0.1; // Small tasks more predictable
        }
        
        if task.max_duration_minutes > 60 {
            confidence -= 0.1; // Long tasks more variable
        }
        
        if task.temp_files.len() > 10 {
            confidence -= 0.1; // Many temp files harder to predict
        }
        
        confidence = std::cmp::max(0.1, std::cmp::min(1.0, confidence));
        
        // Calculate margin of error
        let margin_of_error = if confidence > 0.8 {
            0.1  // 10% error for high confidence
        } else if confidence > 0.6 {
            0.2  // 20% error for medium confidence
        } else {
            0.5  // 50% error for low confidence
        };
        
        let worst_case = total_size * (1.0 + margin_of_error);
        
        FootprintEstimate {
            total_size_gb: total_size,
            working_space_gb: working_space,
            temp_space_gb: temp_space,
            output_space_gb: output_space,
            overhead_gb: overhead,
            confidence: confidence,
            margin_of_error_percent: margin_of_error * 100.0,
            worst_case_gb: worst_case,
        }
    }
    
    // Space reservation system
    pub fn reserve_space(required_gb: f64) -> ReservationResult {
        if required_gb > MAX_RESERVATION_GB {
            return ReservationResult {
                success: false,
                reservation_id: String::new(),
                reserved_gb: 0.0,
                expires_at_ms: 0,
                error_message: format!("Requested space ({:.2}GB) exceeds maximum allowed ({:.2}GB)", required_gb, MAX_RESERVATION_GB),
            };
        }
        
        let disk_snapshot = get_current_disk_snapshot();
        if disk_snapshot.free_space_gb < required_gb {
            return ReservationResult {
                success: false,
                reservation_id: String::new(),
                reserved_gb: 0.0,
                expires_at_ms: 0,
                error_message: format!("Insufficient space: {:.2}GB required, {:.2}GB available", required_gb, disk_snapshot.free_space_gb),
            };
        }
        
        let reservation_id = generate_reservation_id();
        let expires_at = current_timestamp_ms() + RESERVATION_DURATION_MS;
        
        let reservation = Reservation {
            id: reservation_id.clone(),
            requested_gb: required_gb,
            expires_at_ms: expires_at,
            created_at_ms: current_timestamp_ms(),
            disk_state_at_reservation: disk_snapshot,
        };
        
        active_reservations.insert(reservation_id.clone(), reservation);
        
        ReservationResult {
            success: true,
            reservation_id: reservation_id,
            reserved_gb: required_gb,
            expires_at_ms: expires_at,
            error_message: String::new(),
        }
    }
    
    pub fn release_reservation(reservation_id: string) -> bool {
        if active_reservations.remove(&reservation_id).is_some() {
            true
        } else {
            false
        }
    }
    
    // Main enforcement function
    pub fn enforce_disk_gate(task: WriteHeavyTask) -> EnforcementResult {
        let preflight = check_write_heavy_task(task);
        
        if !preflight.approved {
            let cleanup_plan = if preflight.recommended_action == RecommendedAction::PROCEED_WITH_CLEANUP {
                Some(generate_cleanup_plan_for_task(task))
            } else {
                None
            };
            
            let blocking_reason = if !preflight.errors.is_empty() {
                preflight.errors[0].clone()
            } else {
                "Insufficient disk space for task requirements".to_string()
            };
            
            EnforcementResult {
                allowed: false,
                requires_cleanup: cleanup_plan.is_some(),
                cleanup_plan: cleanup_plan,
                blocking_reason: blocking_reason,
                suggested_alternative: suggest_alternative(task, preflight),
                estimated_risk: assess_task_risk(task, estimate_task_footprint(task), get_current_disk_snapshot()),
            };
        } else {
            // Try to reserve space
            let reservation_result = reserve_space(estimate_task_footprint(task).total_size_gb);
            
            if reservation_result.success {
                EnforcementResult {
                    allowed: true,
                    requires_cleanup: false,
                    cleanup_plan: None,
                    blocking_reason: String::new(),
                    suggested_alternative: String::new(),
                    estimated_risk: RiskLevel::LOW,
                }
            } else {
                EnforcementResult {
                    allowed: false,
                    requires_cleanup: true,
                    cleanup_plan: Some(generate_cleanup_plan_for_task(task)),
                    blocking_reason: reservation_result.error_message,
                    suggested_alternative: "Try cleanup and retry".to_string(),
                    estimated_risk: RiskLevel::MEDIUM,
                }
            }
        }
    }
    
    // Internal helpers
    fn estimate_temp_space(task: WriteHeavyTask) -> f64 {
        let base_temp = task.estimated_size_gb * 0.2; // 20% of total
        
        // Additional temp space based on task type
        let additional_temp = match task.task_type {
            TaskType::BUILD => task.estimated_size_gb * 0.3,
            TaskType::TRAINING => task.estimated_size_gb * 0.5,
            TaskType::EXPORT => task.estimated_size_gb * 0.1,
            TaskType::MIGRATION => task.estimated_size_gb * 0.4,
            _ => 0.0,
        };
        
        base_temp + additional_temp
    }
    
    fn can_attempt_cleanup(disk_snapshot: DiskHealthSnapshot, footprint: FootprintEstimate) -> bool {
        // Check if cleanup could free enough space
        let needed_space = footprint.total_size_gb - disk_snapshot.free_space_gb;
        needed_space > 0.0 && needed_space < 10.0 // Can clean up if we need less than 10GB
    }
    
    fn assess_task_risk(task: WriteHeavyTask, footprint: FootprintEstimate, disk_snapshot: DiskHealthSnapshot) -> RiskLevel {
        let risk_score = 0.0;
        
        // Space risk
        let space_ratio = footprint.total_size_gb / disk_snapshot.free_space_gb;
        if space_ratio > 0.5 {
            return RiskLevel::HIGH;
        } else if space_ratio > 0.3 {
            return RiskLevel::MEDIUM;
        }
        
        // Task type risk
        match task.task_type {
            TaskType::TRAINING | TaskType::MIGRATION => return RiskLevel::HIGH,
            TaskType::BUILD | TaskType::EXPORT => return RiskLevel::MEDIUM,
            _ => {}
        }
        
        // Criticality risk
        match task.criticality {
            Criticality::CRITICAL => return RiskLevel::HIGH,
            Criticality::HIGH => return RiskLevel::MEDIUM,
            _ => {}
        }
        
        // Final assessment
        if risk_score > 0.7 {
            RiskLevel::HIGH
        } else if risk_score > 0.4 {
            RiskLevel::MEDIUM
        } else if risk_score > 0.2 {
            RiskLevel::LOW
        } else {
            RiskLevel::NONE
        }
    }
    
    fn estimate_completion_time(task: WriteHeavyTask, footprint: FootprintEstimate) -> u64 {
        let base_time = task.max_duration_minutes as u64 * 60000; // Convert to ms
        
        // Adjust based on size and complexity
        let size_factor = footprint.total_size_gb * 1000; // 1ms per MB
        let complexity_factor = match task.task_type {
            TaskType::TRAINING => size_factor * 3,
            TaskType::MIGRATION => size_factor * 2,
            TaskType::BUILD => size_factor * 1.5,
            _ => size_factor,
        };
        
        base_time + complexity_factor
    }
    
    fn generate_cleanup_plan_for_task(task: WriteHeavyTask) -> CleanupPlan {
        // This would integrate with the cleanup plan spec
        // For now, return placeholder
        CleanupPlan {
            target_free_gb: estimate_task_footprint(task).total_size_gb + 5.0,
            current_free_gb: 0.0,
            estimated_freed_gb: 0.0,
            candidates: Vec::new(),
            safety_checks: Vec::new(),
            total_size_gb: 0.0,
            estimated_time_ms: 0,
            risk_level: RiskLevel::LOW,
            is_safe: true,
        }
    }
    
    fn suggest_alternative(task: WriteHeavyTask, preflight: PreflightResult) -> string {
        match task.task_type {
            TaskType::BUILD => "Consider using incremental build or cleaning build artifacts first".to_string(),
            TaskType::TRAINING => "Consider using smaller model or batch processing".to_string(),
            TaskType::EXPORT => "Consider compressing data or using streaming export".to_string(),
            _ => "Consider breaking task into smaller chunks".to_string(),
        }
    }
    
    // Reservation management
    type Reservation {
        id: string,
        requested_gb: f64,
        expires_at_ms: u64,
        created_at_ms: u64,
        disk_state_at_reservation: DiskHealthSnapshot,
    }
    
    fn generate_reservation_id() -> string {
        format!("res_{}", current_timestamp_ms())
    }
    
    fn cleanup_expired_reservations() {
        let now = current_timestamp_ms();
        let expired_ids: Vec<string> = active_reservations.iter()
            .filter(|(_, r)| r.expires_at_ms < now)
            .map(|(id, _)| id.clone())
            .collect();
        
        for id in expired_ids {
            active_reservations.remove(&id);
        }
    }
    
    // Mock implementations
    fn get_current_disk_snapshot() -> DiskHealthSnapshot {
        cleanup_expired_reservations();
        
        // Mock data - in reality this would call the disk snapshot spec
        DiskHealthSnapshot {
            free_space_gb: 4.9,
            total_space_gb: 228.0,
            used_percent: 71.0,
            growth_rate_gb_per_day: 0.1,
            top_consumers: Vec::new(),
            timestamp_ms: current_timestamp_ms(),
            healthy: false,
            warning: true,
            critical: false,
        }
    }
    
    fn current_timestamp_ms() -> u64 {
        0 // Placeholder
    }
    
    // Task execution record
    type TaskExecutionRecord {
        task_name: string,
        execution_time_ms: u64,
        peak_space_gb: f64,
        success: bool,
        errors: Vec<string>,
    }
    
    // Test suite
    test "preflight_basic_check" {
        let task = WriteHeavyTask {
            name: "test_build".to_string(),
            task_type: TaskType::BUILD,
            estimated_size_gb: 2.0,
            max_duration_minutes: 30,
            working_directory: "/tmp/test".to_string(),
            temp_files: Vec::new(),
            output_files: Vec::new(),
            requirements: TaskRequirements {
                min_free_gb: 5.0,
                reserve_gb: 2.0,
                requires_internet: false,
                requires_gpu: false,
                max_concurrent_writes: 1,
                temp_cleanup_required: true,
            },
            criticality: Criticality::MEDIUM,
        };
        
        let result = check_write_heavy_task(task);
        assert(result.recommended_action != RecommendedAction::BLOCK);
    }
    
    test "footprint_estimation" {
        let task = WriteHeavyTask {
            name: "test_training".to_string(),
            task_type: TaskType::TRAINING,
            estimated_size_gb: 5.0,
            max_duration_minutes: 60,
            working_directory: "/tmp/train".to_string(),
            temp_files: Vec::new(),
            output_files: Vec::new(),
            requirements: TaskRequirements {
                min_free_gb: 10.0,
                reserve_gb: 5.0,
                requires_internet: false,
                requires_gpu: true,
                max_concurrent_writes: 2,
                temp_cleanup_required: true,
            },
            criticality: Criticality::HIGH,
        };
        
        let estimate = estimate_task_footprint(task);
        assert(estimate.total_size_gb > task.estimated_size_gb);
        assert(estimate.confidence >= 0.1 && estimate.confidence <= 1.0);
    }
    
    test "space_reservation" {
        let result = reserve_space(2.0);
        if result.success {
            assert(release_reservation(result.reservation_id));
        }
    }
    
    bench "preflight_check_performance" {
        for i in 0..10 {
            let task = WriteHeavyTask {
                name: format!("task_{}", i),
                task_type: TaskType::BUILD,
                estimated_size_gb: 1.0 + i as f64,
                max_duration_minutes: 30,
                working_directory: format!("/tmp/task_{}", i),
                temp_files: Vec::new(),
                output_files: Vec::new(),
                requirements: TaskRequirements {
                    min_free_gb: 5.0,
                    reserve_gb: 1.0,
                    requires_internet: false,
                    requires_gpu: false,
                    max_concurrent_writes: 1,
                    temp_cleanup_required: true,
                },
                criticality: Criticality::MEDIUM,
            };
            check_write_heavy_task(task);
        }
    }
}