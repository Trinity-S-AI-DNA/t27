// SPDX-License-Identifier: Apache-2.0
// T27 Release Gates SSOT
// Purpose: what makes a release "released" - the gates, the evidence, the
//          rollback readiness and the tag rule. "Completed" without proof is
//          not completed.
//
// Owner: T27_ORDER_RESTORE_01 (issue #14282), 2026-10-30.
//
// OWNS:
//   - the ordered gate list of a release
//   - the required elements of an evidence artifact
//   - the rollback-readiness rule
//   - the tag rule (protected branch, release commit, signature)
//   - the rule that a failed gate always leaves evidence
//
// DOES NOT OWN (never restate these facts here):
//   - the inventory of CI workflows and their classes:
//       specs/claw/gates.t27
//   - the budget of open pull requests per author: specs/policy/pr_budget.t27
//   - the seal that a release must carry: specs/policy/seal_ownership.t27
//   - the release-gate verification skill:
//       specs/agents/dsh-release-gate-verify.t27
//   - the rollback drill in a disposable environment:
//       specs/system/rollback_drill_disposable_environment.t27
//   - shadow mode and its production block:
//       specs/system/shadow_mode_implementation.t27
//   - the provider preflight gate:
//       specs/system/llm_request_provider_gate.t27
//   - disk preflight and reserves: specs/system/disk-health.t27
//   - checkpoint and resume rules: specs/system/session-continuity.t27
//
// Live evidence (2026-10-30):
//   - the Shadow MVP package reached CONDITIONAL_GO on engineering evidence
//     while FULL_PRODUCTION stayed BLOCKED; a release verdict therefore has
//     to name the gate that is still open, not a mood

module release_gates;

// ─── Gates ─────────────────────────────────────────────────────────────────

pub const GATE_TESTS : u8 = 0;
pub const GATE_EVIDENCE : u8 = 1;
pub const GATE_ROLLBACK : u8 = 2;
pub const GATE_TAG : u8 = 3;
pub const GATE_COUNT : u32 = 4;
pub const GATE_NONE : u8 = 255;

// ─── Evidence elements ─────────────────────────────────────────────────────

pub const EVIDENCE_COMMAND : u8 = 0;
pub const EVIDENCE_OUTPUT : u8 = 1;
pub const EVIDENCE_EXIT_CODE : u8 = 2;
pub const EVIDENCE_ELEMENT_COUNT : u32 = 3;

// ─── Decisions ─────────────────────────────────────────────────────────────

pub const DECISION_BLOCK : u8 = 0;
pub const DECISION_RELEASE : u8 = 1;

// ─── Functions ─────────────────────────────────────────────────────────────

// evidence_element_count() - command, output, exit code. No third substitute.
pub fn evidence_element_count() -> u32 {
    return EVIDENCE_ELEMENT_COUNT;
}

// evidence_complete(has_command, has_output, has_exit_code) -> bool
pub fn evidence_complete(has_command: bool, has_output: bool, has_exit_code: bool) -> bool {
    if (has_command == false) {
        return false;
    }
    if (has_output == false) {
        return false;
    }
    if (has_exit_code == false) {
        return false;
    }
    return true;
}

// rollback_ready(drill_exit_code) -> bool - a rollback drill that did not
// exit zero is not a rollback plan.
pub fn rollback_ready(drill_exit_code: i32) -> bool {
    return drill_exit_code == 0;
}

// tag_allowed(is_protected_branch, is_release_commit, is_signed) -> bool
pub fn tag_allowed(is_protected_branch: bool, is_release_commit: bool, is_signed: bool) -> bool {
    if (is_protected_branch) {
        return false;
    }
    if (is_release_commit == false) {
        return false;
    }
    if (is_signed == false) {
        return false;
    }
    return true;
}

// release_allowed(gates_pass, evidence_ok, rollback_ok, tag_ok) -> bool
pub fn release_allowed(gates_pass: bool, evidence_ok: bool, rollback_ok: bool, tag_ok: bool) -> bool {
    if (gates_pass == false) {
        return false;
    }
    if (evidence_ok == false) {
        return false;
    }
    if (rollback_ok == false) {
        return false;
    }
    if (tag_ok == false) {
        return false;
    }
    return true;
}

// completion_valid(gates_pass, evidence_ok) -> bool - "completed" is a claim
// that needs the gates and the proof behind it.
pub fn completion_valid(gates_pass: bool, evidence_ok: bool) -> bool {
    if (gates_pass == false) {
        return false;
    }
    return evidence_ok;
}

// next_gate(gate_index) -> u8 - the gates are checked in order; no gate may
// be skipped.
pub fn next_gate(gate_index: u8) -> u8 {
    if (gate_index >= GATE_COUNT - 1) {
        return GATE_NONE;
    }
    return gate_index + 1;
}

// evidence_artifact_required(gate_failed) -> bool - a failed gate always
// leaves an artifact behind, otherwise nobody can learn from it.
pub fn evidence_artifact_required(gate_failed: bool) -> bool {
    return gate_failed;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "evidence_needs_command_output_and_exit_code" {
    assert(evidence_element_count() == 3);
    assert(evidence_complete(true, true, true) == true);
    assert(evidence_complete(false, true, true) == false);
    assert(evidence_complete(true, false, true) == false);
    assert(evidence_complete(true, true, false) == false);
}

test "a_drill_that_did_not_exit_zero_is_not_a_rollback_plan" {
    assert(rollback_ready(0) == true);
    assert(rollback_ready(1) == false);
    assert(rollback_ready(-1) == false);
}

test "a_tag_needs_a_release_commit_a_signature_and_no_protected_branch" {
    assert(tag_allowed(false, true, true) == true);
    assert(tag_allowed(true, true, true) == false);
    assert(tag_allowed(false, false, true) == false);
    assert(tag_allowed(false, true, false) == false);
}

test "release_needs_all_four_gates" {
    assert(release_allowed(true, true, true, true) == true);
    assert(release_allowed(false, true, true, true) == false);
    assert(release_allowed(true, false, true, true) == false);
    assert(release_allowed(true, true, false, true) == false);
    assert(release_allowed(true, true, true, false) == false);
}

test "completed_without_proof_is_not_completed" {
    assert(completion_valid(true, true) == true);
    assert(completion_valid(true, false) == false);
    assert(completion_valid(false, true) == false);
}

test "gates_are_checked_in_order_and_none_is_skipped" {
    assert(next_gate(GATE_TESTS) == GATE_EVIDENCE);
    assert(next_gate(GATE_EVIDENCE) == GATE_ROLLBACK);
    assert(next_gate(GATE_ROLLBACK) == GATE_TAG);
    assert(next_gate(GATE_TAG) == GATE_NONE);
}

test "a_failed_gate_always_leaves_an_artifact" {
    assert(evidence_artifact_required(true) == true);
    assert(evidence_artifact_required(false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant a_release_implies_complete_evidence {
    release_allowed(true, true, true, true) == true;
    release_allowed(true, false, true, true) == false;
}

invariant a_release_implies_a_ready_rollback {
    release_allowed(true, true, true, true) == true;
    release_allowed(true, true, false, true) == false;
}

invariant a_release_implies_an_allowed_tag {
    release_allowed(true, true, true, true) == true;
    release_allowed(true, true, true, false) == false;
}

invariant completion_always_carries_proof {
    completion_valid(true, false) == false;
    completion_valid(false, true) == false;
}

invariant every_failed_gate_leaves_evidence {
    evidence_artifact_required(true) == true;
}

invariant the_gate_sequence_is_total {
    GATE_COUNT == 4;
    next_gate(GATE_TESTS) == GATE_EVIDENCE;
    next_gate(GATE_TAG) == GATE_NONE;
}
