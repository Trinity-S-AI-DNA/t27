// SPDX-License-Identifier: Apache-2.0
// specs/system/session_never_dies.t27 -- T27_SESSION_NEVER_DIES: a session never
// dies silently. Durable checkpoints, Doctor watchdog, bounded retry, approved
// fallback only, degraded continuation, recovery drills.
// Part of [EPIC] T27_SESSION_NEVER_DIES (#12899). Closes #12899.
// phi^2 + 1/phi^2 = 3 | TRINITY

module system::session_never_dies {

    pub const MODULE : str = "session_never_dies";
    pub const SURFACE : str = "session";
    pub const MAX_RETRY : u32 = 3;

    // ---- Doctor watchdog states -------------------------------------------
    pub const STATE_IDLE : str = "IDLE";
    pub const STATE_WATCHING : str = "WATCHING";
    pub const STATE_DIAGNOSING : str = "DIAGNOSING";
    pub const STATE_REPAIRING : str = "REPAIRING";
    pub const STATE_WAITING_OWNER : str = "WAITING_OWNER";
    pub const STATE_RECOVERED : str = "RECOVERED";
    pub const STATE_DEGRADED : str = "DEGRADED";
    pub const STATE_UNRECOVERABLE : str = "UNRECOVERABLE";

    pub struct Session {
        checkpointed : bool,
        doctor_state : str,
        visible_to_user : bool,
        resumed_from_artifact : bool,
    };

    // ---- Rules --------------------------------------------------------------
    // Every meaningful step is checkpointed durably.
    pub fn step_checkpointed(cp: bool) -> bool {
        return cp;
    }

    // Bounded retry: max 3 attempts.
    pub fn retry_within_bound(attempts: u32) -> bool {
        return attempts <= MAX_RETRY;
    }

    // Approved fallback only; no silent provider switch.
    pub fn fallback_approved(approved: bool, silent_switch: bool) -> bool {
        return approved && !silent_switch;
    }

    // Degraded continuation gives honest user notice.
    pub fn degraded_honest(degraded: bool, notice_shown: bool) -> bool {
        return !degraded || notice_shown;
    }

    // Every failure class maps to a visible Doctor state and a bounded action.
    pub fn failure_mapped(state: str, action_bounded: bool) -> bool {
        return (state == STATE_IDLE || state == STATE_WATCHING || state == STATE_DIAGNOSING
            || state == STATE_REPAIRING || state == STATE_WAITING_OWNER || state == STATE_RECOVERED
            || state == STATE_DEGRADED || state == STATE_UNRECOVERABLE) && action_bounded;
    }

    // ---- Tests ------------------------------------------------------------
    test "every meaningful step is checkpointed durably" {
        assert(step_checkpointed(true));
        assert(!step_checkpointed(false));
    }

    test "bounded retry max 3" {
        assert(retry_within_bound(1));
        assert(retry_within_bound(3));
        assert(!retry_within_bound(4));
    }

    test "approved fallback only, no silent provider switch" {
        assert(fallback_approved(true, false));
        assert(!fallback_approved(false, false));
        assert(!fallback_approved(true, true));
    }

    test "degraded continuation shows honest notice" {
        assert(degraded_honest(true, true));
        assert(!degraded_honest(true, false));
        assert(degraded_honest(false, false));
    }

    test "every failure class maps to a visible Doctor state and bounded action" {
        assert(failure_mapped(STATE_IDLE, true));
        assert(failure_mapped(STATE_RECOVERED, true));
        assert(failure_mapped(STATE_UNRECOVERABLE, true));
        assert(!failure_mapped("UNKNOWN", true));
        assert(!failure_mapped(STATE_IDLE, false));
    }

    invariant max_retry_is_three {
        assert MAX_RETRY == 3;
    }

    invariant all_doctor_states_defined {
        assert STATE_IDLE == "IDLE";
        assert STATE_WATCHING == "WATCHING";
        assert STATE_REPAIRING == "REPAIRING";
        assert STATE_WAITING_OWNER == "WAITING_OWNER";
        assert STATE_RECOVERED == "RECOVERED";
        assert STATE_DEGRADED == "DEGRADED";
        assert STATE_UNRECOVERABLE == "UNRECOVERABLE";
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
