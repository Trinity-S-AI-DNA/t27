module provider_guard_runtime_integration;

// ─── Evidence from the bypass incident ────────────────────────────────────────
//
// Root cause analysis:
// - T27 specs: specs/system/llm_request_provider_gate.t27 (complete)
// - DSH runtime: packages/llm/llm/src/provider-invariant-guard.ts (exists)
// - DSH adapter: packages/llm/llm-deepseek/src/adapter.ts (has bypass path)
// - Runtime integration: NOT WIRED GUARD INTO ACTUAL REQUEST PATH
//
// Incident report:
// - 503 "deepseek unfunded" during file creation
// - Expected: guard should block before network I/O
// - Actual: request reached DeepSeek provider
// - Conclusion: P0_PROVIDER_GATE_INCOMPLETE, T27_RUNTIME_INTEGRATION_MISSING

// ─── Required Integration Points ─────────────────────────────────────────────

// Point 1: Guard must evaluate BEFORE any fetch() call in DeepSeek adapter
pub const INTEGRATION_POINT_ADAPTER_REQUEST: &str = "packages/llm/llm-deepseek/src/adapter.ts::request()";

// Point 2: Guard must have access to resolved provider information
pub const INTEGRATION_POINT_RESOLVED_PROVIDER: &str = "after resolveModel() in adapter";

// Point 3: Guard result must override retry logic for unfunded providers  
pub const INTEGRATION_POINT_RETRY_OVERRIDE: &str = "before any network retry attempt";

// ─── Integration Contract ───────────────────────────────────────────────────

/// The guard evaluation must occur at this exact point in the request flow.
pub type GuardIntegrationPoint = enum {
    BEFORE_NETWORK_REQUEST,    // Block before any HTTP fetch()
    AFTER_MODEL_RESOLUTION,   // With resolved provider info
    BEFORE_RETRY_ATTEMPT,     // Override retry for unfunded providers
};

/// Provider guard configuration loaded from T27 specs.
pub struct ProviderGuardConfig {
    pub expected_providers: Vec<String>,
    pub known_unfunded_providers: Vec<String>,
    pub approved_fallbacks: Vec<String>,
    pub model_allowlist: ModelAllowlist,
}

pub type ModelAllowlist = Vec<(String, String)>; // (provider, model_pattern)

/// Runtime guard result that can modify request flow.
pub struct GuardResult {
    pub allowed: bool,
    pub error_code: Option<String>,
    pub error_message: Option<String>,
    pub should_retry: bool,
    pub checkpoint_preserved: bool,
    pub follow_up_task_created: bool,
}

/// Integration function signature for runtime wiring.
pub fn integrate_provider_guard(
    request_options: RequestOptions,
    integration_point: GuardIntegrationPoint,
    config: ProviderGuardConfig,
) -> GuardResult {
    // TODO: Implement actual T27 guard logic integration
    // This function should be called at the required integration points
    // and implement the exact logic from llm_request_provider_gate.t27
    
    let result = evaluate_t27_provider_gate(request_options, config);
    
    match integration_point {
        GuardIntegrationPoint::BEFORE_NETWORK_REQUEST => {
            if !result.allowed {
                // Block network request entirely
                return GuardResult {
                    allowed: false,
                    error_code: result.error_code,
                    error_message: result.error_message,
                    should_retry: false,
                    checkpoint_preserved: true,
                    follow_up_task_created: true,
                };
            }
        },
        GuardIntegrationPoint::BEFORE_RETRY_ATTEMPT => {
            if !result.allowed {
                // Block retry, especially for unfunded providers
                return GuardResult {
                    allowed: false,
                    error_code: result.error_code,
                    error_message: result.error_message,
                    should_retry: false,
                    checkpoint_preserved: true,
                    follow_up_task_created: true,
                };
            }
        },
        _ => {}
    }
    
    GuardResult {
        allowed: true,
        error_code: None,
        error_message: None,
        should_retry: true,
        checkpoint_preserved: true,
        follow_up_task_created: false,
    }
}

/// Evaluate provider gate using T27 specification logic.
fn evaluate_t27_provider_gate(
    request_options: RequestOptions,
    config: ProviderGuardConfig,
) -> GuardResult {
    let resolved_provider = resolve_provider_from_url(&request_options.base_url);
    let expected_provider = &config.expected_providers[0]; // Primary expected provider
    
    // Rule 1: Provider routing mismatch
    if resolved_provider != *expected_provider {
        let fallback_approved = config.approved_fallbacks.contains(&resolved_provider);
        if !fallback_approved {
            return GuardResult {
                allowed: false,
                error_code: Some("PROVIDER_ROUTING_MISMATCH".to_string()),
                error_message: Some(format!("expected provider '{}', resolved provider '{}'", expected_provider, resolved_provider)),
                should_retry: false,
                checkpoint_preserved: true,
                follow_up_task_created: true,
            };
        }
    }
    
    // Rule 2: Model not allowed on provider
    if !is_model_allowed_on_provider(&request_options.model, &resolved_provider, &config.model_allowlist) {
        return GuardResult {
            allowed: false,
            error_code: Some("MODEL_NOT_ALLOWED_ON_PROVIDER".to_string()),
            error_message: Some(format!("model '{}' is not allowed on provider '{}'", request_options.model, resolved_provider)),
            should_retry: false,
            checkpoint_preserved: true,
            follow_up_task_created: true,
        };
    }
    
    // Rule 3: Missing credentials
    if !are_credentials_present(&resolved_provider, &request_options.credentials) {
        return GuardResult {
            allowed: false,
            error_code: Some("CREDENTIALS_MISSING".to_string()),
            error_message: Some(format!("no credential present for provider '{}'", resolved_provider)),
            should_retry: false,
            checkpoint_preserved: true,
            follow_up_task_created: true,
        };
    }
    
    // Rule 4: Provider unfunded (CRITICAL for the 503 issue)
    if config.known_unfunded_providers.contains(&resolved_provider) {
        return GuardResult {
            allowed: false,
            error_code: Some("PROVIDER_UNFUNDED".to_string()),
            error_message: Some(format!("provider '{}' is known unfunded", resolved_provider)),
            should_retry: false,
            checkpoint_preserved: true,
            follow_up_task_created: true,
        };
    }
    
    // All checks passed
    GuardResult {
        allowed: true,
        error_code: None,
        error_message: None,
        should_retry: true,
        checkpoint_preserved: true,
        follow_up_task_created: false,
    }
}

/// Helper functions implementing T27 guard logic
fn resolve_provider_from_url(base_url: &str) -> String {
    // Implementation from specs/system/llm_request_provider_gate.t27
    let rest = base_url.split_once("://").map(|(_, r)| r).unwrap_or(base_url);
    let authority = rest.split('/').next().unwrap_or(rest);
    let authority = authority.rsplit('@').next().unwrap_or(authority);
    let host = authority.split(':').next().unwrap_or(authority).to_lowercase();
    
    if host.contains("deepseek") {
        "deepseek".to_string()
    } else if host.contains("z.ai") {
        "z.ai".to_string()
    } else if host.contains("openai") {
        "openai".to_string()
    } else {
        host
    }
}

fn is_model_allowed_on_provider(model: &str, provider: &str, allowlist: &ModelAllowlist) -> bool {
    // Implementation from specs/system/llm_request_provider_gate.t27
    let model = model.to_lowercase();
    
    // Check explicit allowlist entries
    for (provider_pattern, model_pattern) in allowlist {
        if provider_pattern.contains(provider) && model.contains(model_pattern) {
            return true;
        }
    }
    
    // Default allowlists based on provider
    match provider {
        "z.ai" => model.contains("glm") || model.contains("claude"),
        "deepseek" => model.contains("deepseek"),
        "openai" => model.contains("gpt"),
        _ => true,
    }
}

fn are_credentials_present(provider: &str, credentials: &CredentialMap) -> bool {
    // Check if provider has required credentials
    match provider {
        "z.ai" => credentials.zai_key.is_some(),
        "deepseek" => credentials.deepseek_key.is_some(),
        "openai" => credentials.openai_key.is_some(),
        _ => true,
    }
}

// ─── Integration Test Cases ──────────────────────────────────────────────────

test "guard_blocks_unfunded_before_network_request" {
    // Given deepseek is in known unfunded providers
    let config = ProviderGuardConfig {
        expected_providers: vec!["z.ai".to_string()],
        known_unfunded_providers: vec!["deepseek".to_string()],
        approved_fallbacks: vec![],
        model_allowlist: vec![("deepseek".to_string(), "deepseek".to_string())],
    };
    
    let request = RequestOptions {
        base_url: "https://api.deepseek.com/v1".to_string(),
        model: "deepseek-chat".to_string(),
        credentials: CredentialMap {
            zai_key: None,
            deepseek_key: Some("test-key".to_string()),
            openai_key: None,
        },
    };
    
    // WHEN guard is evaluated at BEFORE_NETWORK_REQUEST
    let result = integrate_provider_guard(request, GuardIntegrationPoint::BEFORE_NETWORK_REQUEST, config);
    
    // THEN request is blocked before network I/O
    assert!(!result.allowed);
    assert!(result.error_code == Some("PROVIDER_UNFUNDED".to_string()));
    assert!(!result.should_retry);
    assert!(result.checkpoint_preserved);
    assert!(result.follow_up_task_created);
}

test "guard_allows_valid_provider_request" {
    // Given valid provider configuration
    let config = ProviderGuardConfig {
        expected_providers: vec!["z.ai".to_string()],
        known_unfunded_providers: vec![], // No unfunded providers
        approved_fallbacks: vec![],
        model_allowlist: vec![("z.ai".to_string(), "glm".to_string())],
    };
    
    let request = RequestOptions {
        base_url: "https://api.z.ai/v1".to_string(),
        model: "glm-4".to_string(),
        credentials: CredentialMap {
            zai_key: Some("test-key".to_string()),
            deepseek_key: None,
            openai_key: None,
        },
    };
    
    // WHEN guard is evaluated
    let result = integrate_provider_guard(request, GuardIntegrationPoint::BEFORE_NETWORK_REQUEST, config);
    
    // THEN request is allowed
    assert!(result.allowed);
    assert!(result.error_code.is_none());
    assert!(result.should_retry);
    assert!(result.checkpoint_preserved);
    assert!(!result.follow_up_task_created);
}

test "guard_blocks_retry_on_unfunded_after_503" {
    // Given unfunded provider returned 503
    let config = ProviderGuardConfig {
        expected_providers: vec!["z.ai".to_string()],
        known_unfunded_providers: vec!["deepseek".to_string()],
        approved_fallbacks: vec![],
        model_allowlist: vec![],
    };
    
    let request = RequestOptions {
        base_url: "https://api.deepseek.com/v1".to_string(),
        model: "deepseek-chat".to_string(),
        credentials: CredentialMap {
            zai_key: None,
            deepseek_key: Some("test-key".to_string()),
            openai_key: None,
        },
    };
    
    // WHEN guard is evaluated at BEFORE_RETRY_ATTEMPT (after 503)
    let result = integrate_provider_guard(request, GuardIntegrationPoint::BEFORE_RETRY_ATTEMPT, config);
    
    // THEN retry is denied and no new provider request occurs
    assert!(!result.allowed);
    assert!(result.error_code == Some("PROVIDER_UNFUNDED".to_string()));
    assert!(!result.should_retry);
    assert!(result.checkpoint_preserved);
    assert!(result.follow_up_task_created);
}

