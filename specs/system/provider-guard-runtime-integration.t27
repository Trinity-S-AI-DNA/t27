/// Required modifications to DeepSeek Harness packages/llm/llm-deepseek/src/adapter.ts
pub const ADAPTER_REQUIRED_MODIFICATIONS: &str = "
// In request() method, BEFORE the fetch() call:

// 1. Import T27 guard integration
import { integrate_provider_guard, ProviderGuardConfig } from './t27-provider-guard-integration.ts';

// 2. Add guard evaluation before network request
const guardConfig = ProviderGuardConfig.fromT27Specs(); // Load from T27 specs
const guardResult = integrate_provider_guard(
    { baseURL: connection.baseURL, model: options.model, credentials: auth.credentials },
    'BEFORE_NETWORK_REQUEST',
    guardConfig
);

if (!guardResult.allowed) {
    // Return blocked stream immediately - no network I/O
    return createBlockedStream(guardResult);
}

// 3. Add guard check before retry (if needed)
// ...

// 4. Implement createBlockedStream() from specs/system/llm_request_provider_gate.t27
";

// ═══════════════════════════════════════════════════════════════════════════
// Invariants for runtime integration
// ═══════════════════════════════════════════════════════════════════════════

invariant guard_runs_before_network_io {
    // Guard must execute before any HTTP fetch() call
    integration_point == GuardIntegrationPoint::BEFORE_NETWORK_REQUEST
}

invariant guard_blocks_unfunded_providers {
    // Known unfunded providers never reach network
    !config.known_unfunded_providers.contains(resolved_provider) || !network_io_allowed
}

invariant guard_preserves_checkpoint_on_block {
    // No conversation state modification when guard blocks
    checkpoint_preserved == true
}

invariant guard_creates_follow_up_task_on_violation {
    // Every violation creates follow-up task
    !allowed == follow_up_task_created
}

invariant guard_integrated_at_all_required_points {
    // Guard is called at BEFORE_NETWORK_REQUEST, BEFORE_RETRY_ATTEMPT, etc.
    integration_points.contains(GuardIntegrationPoint::BEFORE_NETWORK_REQUEST)
    && integration_points.contains(GuardIntegrationPoint::BEFORE_RETRY_ATTEMPT)
}