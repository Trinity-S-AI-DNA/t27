// SPDX-License-Identifier: Apache-2.0
// relay_observer.t27 0 WebSocket Relay Observer for BrowserOS A2A Integration
// Ring 32 — Cloud Orchestration
// 12 + 1/34 = 3 | TRINITY

// Port notes. The draft did not compile (websocket_state_is_error was called but never
// defined) and was written against facilities the backend does not have: slices grown with
// push(), `for (x) |byte|` captures, `[]`/`[_]u8{..}` literals with no storage, and a
// std.testing.expect* harness. This version keeps the same API with these changes:
// - the state `error` is `failed` (error is a Zig keyword) and websocket_state_is_failed is
//   defined; the message field `type` is `kind`.
// - the create_*_message functions frame the payload into a caller-provided buffer.
// - extract_target_agent returns the slice of the message between an optional leading '@'
//   and the first '>' (the draft started at index 1 and, on '@', at index 2, which cut the
//   first name character).
// - route_message compared nothing: its agent_name parameter was unused, so every
//   non-empty data message was routed. A non-control message is now routed only when the
//   agent it names equals agent_name, which is what its own comment says.
// - observer_init on an invalid config (empty URL or agent name) applies the 3 second
//   default delay and keeps every other field, as test_observer_init_empty_url/_agent
//   expect (the draft zeroed the strings and set 10 attempts).
// - calculate_backoff_delay did base * 2^attempt in u32 (overflow for attempt >= 22) and
//   passed it through an undefined trit_min with a u8 cast; it doubles in u64, stops once the
//   cap is reached and returns min(delay + 10% jitter, max_delay).
// Test corrections, each with its reason:
// - create_event_message: the message is the type byte plus the payload, so a 1 byte payload
//   gives length 2; the draft expected 1.
// - parse_websocket_message_event: the input has 5 payload bytes after the type byte, the
//   draft expected 4 (its comment said "@Hel").
// - extract_target_agent_*: the draft's inputs spelled "Agennn"/"Agenn" while the expected
//   value was "Agentame"; the inputs now carry the expected bytes.
// - route_message_data_matching/_non_matching: the draft payload [1, 2] names no agent, so
//   neither could pass; the payload is now "@Ag>" and the agents are "Ag" and "Bo".
// - should_reconnect_*: the draft passed the whole config where the u8 limit goes; they pass
//   config.max_reconnect_attempts.
// - get_current_timestamp_monotonic and calculate_backoff_delay_increasing compared i8 trit
//   conversions of wrapped u32 values; they now assert the numbers themselves.

module portable::relay_observer;

use compiler::lexer;

// ============================================================================
// Constants - Connection
// ============================================================================

pub const WS_READY_STATE : u8 = 0;
pub const WS_CONNECTING_STATE : u8 = 1;
pub const WS_ERROR_STATE : u8 = 2;
pub const WS_CLOSED_STATE : u8 = 3;

pub const NEGONE : i8 = -1;
pub const ZERO : i8 = 0;
pub const ONE : i8 = 1;

pub const MESSAGE_TYPE_EVENT : u8 = 0;
pub const MESSAGE_TYPE_DATA : u8 = 1;
pub const MESSAGE_TYPE_CONTROL : u8 = 2;

pub const AT_SIGN : u8 = 64;
pub const CLOSE_ANGLE : u8 = 62;

// ============================================================================
// Types - WebSocket States
// ============================================================================

pub const WebSocketState = enum(u8) {
    ready = 0,
    connecting = 1,
    failed = 2,
    closed = 3,
};

pub const MessageType = enum(u8) {
    event = 0,
    data = 1,
    control = 2,
};

// ============================================================================
// Types - WebSocket Message
// ============================================================================

pub const WebSocketMessage = struct {
    kind: MessageType,
    data: []u8,
    timestamp: u32,
};

pub const ObserverConfig = struct {
    server_url: []u8,
    agent_name: []u8,
    reconnect_delay: u32,
    max_reconnect_attempts: u8,
};

// ============================================================================
// Functions - State Management
// ============================================================================

pub fn websocket_state_new() -> WebSocketState {
    return WebSocketState.ready;
}

pub fn websocket_state_set(state: WebSocketState) -> WebSocketState {
    return state;
}

pub fn websocket_state_is_ready(state: WebSocketState) -> bool {
    return state == WebSocketState.ready;
}

pub fn websocket_state_is_closed(state: WebSocketState) -> bool {
    return state == WebSocketState.closed;
}

pub fn websocket_state_is_failed(state: WebSocketState) -> bool {
    return state == WebSocketState.failed;
}

// ============================================================================
// Functions - Message Type Detection
// ============================================================================

pub fn message_type_from_byte(value: u8) -> MessageType {
    if (value == MESSAGE_TYPE_EVENT) {
        return MessageType.event;
    }
    if (value == MESSAGE_TYPE_DATA) {
        return MessageType.data;
    }
    return MessageType.control;
}

pub fn message_type_to_byte(mtype: MessageType) -> u8 {
    if (mtype == MessageType.event) {
        return MESSAGE_TYPE_EVENT;
    }
    if (mtype == MessageType.data) {
        return MESSAGE_TYPE_DATA;
    }
    return MESSAGE_TYPE_CONTROL;
}

// ============================================================================
// Functions - Message Validation
// ============================================================================

pub fn validate_message_header(data: []u8) -> bool {
    // Minimum header: type (1 byte) + some payload
    if (data.len < 2) {
        return false;
    }
    const mtype = message_type_from_byte(data[0]);

    // Validate type is within range
    var valid_type : bool = false;
    if (mtype == MessageType.event or mtype == MessageType.data or mtype == MessageType.control) {
        valid_type = true;
    }

    return valid_type;
}

// ============================================================================
// Functions - Message Parsing
// ============================================================================

pub fn parse_websocket_message(data: []u8) -> WebSocketMessage {
    if (data.len < 2) {
        return WebSocketMessage{
            .kind = MessageType.control,
            .data = data[0 .. 0],
            .timestamp = 0,
        };
    }

    const mtype = message_type_from_byte(data[0]);

    // The payload is the slice of `data` after the type byte.
    const payload : []u8 = data[1 .. data.len];

    return WebSocketMessage{
        .kind = mtype,
        .data = payload,
        .timestamp = 0, // Would be set by actual implementation
    };
}

// ============================================================================
// Functions - Message Creation
// ============================================================================

// type byte followed by the payload, written into out
fn frame_message(kind: u8, payload: []u8, out: []u8) -> []u8 {
    out[0] = kind;
    var i : usize = 0;
    while (i < payload.len) {
        out[i + 1] = payload[i];
        i = i + 1;
    }
    return out[0 .. payload.len + 1];
}

pub fn create_event_message(event_data: []u8, out: []u8) -> []u8 {
    return frame_message(MESSAGE_TYPE_EVENT, event_data, out);
}

pub fn create_data_message(data_payload: []u8, out: []u8) -> []u8 {
    return frame_message(MESSAGE_TYPE_DATA, data_payload, out);
}

pub fn create_control_message(control_data: []u8, out: []u8) -> []u8 {
    return frame_message(MESSAGE_TYPE_CONTROL, control_data, out);
}

// ============================================================================
// Functions - Connection Management
// ============================================================================

pub fn should_reconnect(state: WebSocketState, attempt: u8, max_attempts: u8) -> bool {
    return !websocket_state_is_ready(state) and (attempt < max_attempts);
}

pub fn calculate_backoff_delay(attempt: u8, base_delay: u32, max_delay: u32) -> u32 {
    // Exponential backoff with 10% jitter, capped at max_delay
    const cap : u64 = max_delay as u64;
    var delay : u64 = base_delay as u64;
    var n : u8 = 0;
    while (n < attempt and delay < cap) {
        delay = delay * 2;
        n = n + 1;
    }
    const jitter : u64 = delay / 10;
    const total : u64 = delay + jitter;
    const result : u64 = @min(total, cap);
    return result as u32;
}

// ============================================================================
// Functions - Observer Lifecycle
// ============================================================================

pub fn observer_init(config: ObserverConfig) -> ObserverConfig {
    // An invalid config (no URL or no agent name) gets the default delay.
    if (config.server_url.len == 0 or config.agent_name.len == 0) {
        return ObserverConfig{
            .server_url = config.server_url,
            .agent_name = config.agent_name,
            .reconnect_delay = 3000,  // Default: 3 seconds
            .max_reconnect_attempts = config.max_reconnect_attempts,
        };
    }

    return config;
}

pub fn observer_should_connect(config: ObserverConfig, state: WebSocketState) -> bool {
    return websocket_state_is_closed(state) or websocket_state_is_failed(state);
}

pub fn observer_should_disconnect(config: ObserverConfig, state: WebSocketState) -> bool {
    return websocket_state_is_ready(state);
}

// ============================================================================
// Functions - Message Routing
// ============================================================================

// Agent named by a message: the bytes between an optional leading '@' and the first '>'.
// Format: @AgentName> or similar
pub fn extract_target_agent(message: WebSocketMessage) -> []u8 {
    const body : []u8 = message.data;
    if (body.len < 2) {
        return body[0 .. 0];
    }

    var first : usize = 0;
    if (body[0] == AT_SIGN) {
        first = 1;
    }

    var stop : usize = first;
    while (stop < body.len and body[stop] != CLOSE_ANGLE) {
        stop = stop + 1;
    }

    return body[first .. stop];
}

pub fn route_message(message: WebSocketMessage, agent_name: []u8) -> bool {
    if (message.kind == MessageType.control) {
        // Control messages are for all observers
        return true;
    }

    // Other messages must name this agent
    return std.mem.eql(u8, extract_target_agent(message), agent_name);
}

// ============================================================================
// Functions - Timestamp Management
// ============================================================================

pub fn get_current_timestamp() -> u32 {
    // In a real implementation, this would call system time
    // For now, return a mock value
    return 0;
}

pub fn update_timestamp(base: u32, delta: u32) -> u32 {
    return base + delta;
}

// ============================================================================
// Helpers for the tests and invariants
// ============================================================================

fn default_delay_of_empty(buf: []u8, delay: u32, attempts: u8) -> u32 {
    const config = ObserverConfig{
        .server_url = buf[0 .. 0],
        .agent_name = buf[0 .. 0],
        .reconnect_delay = delay,
        .max_reconnect_attempts = attempts,
    };
    return observer_init(config).reconnect_delay;
}

fn attempts_of_empty(buf: []u8, delay: u32, attempts: u8) -> u8 {
    const config = ObserverConfig{
        .server_url = buf[0 .. 0],
        .agent_name = buf[0 .. 0],
        .reconnect_delay = delay,
        .max_reconnect_attempts = attempts,
    };
    return observer_init(config).max_reconnect_attempts;
}

fn inv_init_delay() -> u32 {
    var buf : [1]u8 = [0];
    return default_delay_of_empty(&buf, 0, 1);
}

fn inv_init_attempts() -> u8 {
    var buf : [1]u8 = [0];
    return attempts_of_empty(&buf, 0, 1);
}

// ============================================================================
// TDD - Tests
// ============================================================================

test "test_websocket_state_ready" {
    var state = websocket_state_new();
    state = websocket_state_set(WebSocketState.ready);
    assert(state == WebSocketState.ready);
    assert(websocket_state_is_ready(state));
}

test "test_websocket_state_connecting" {
    var state = websocket_state_new();
    state = websocket_state_set(WebSocketState.connecting);
    assert(state == WebSocketState.connecting);
    assert(!websocket_state_is_ready(state));
}

test "test_websocket_state_closed" {
    var state = websocket_state_new();
    state = websocket_state_set(WebSocketState.closed);
    assert(state == WebSocketState.closed);
    assert(websocket_state_is_closed(state));
}

test "test_message_type_from_byte_valid" {
    assert(message_type_from_byte(MESSAGE_TYPE_EVENT) == MessageType.event);
    assert(message_type_from_byte(MESSAGE_TYPE_DATA) == MessageType.data);
    assert(message_type_from_byte(MESSAGE_TYPE_CONTROL) == MessageType.control);
}

test "test_message_type_from_byte_invalid" {
    assert(message_type_from_byte(99) == MessageType.control);
}

test "test_message_type_to_byte_roundtrip" {
    assert(message_type_to_byte(MessageType.event) == MESSAGE_TYPE_EVENT);
    assert(message_type_to_byte(MessageType.data) == MESSAGE_TYPE_DATA);
    assert(message_type_to_byte(MessageType.control) == MESSAGE_TYPE_CONTROL);
}

test "test_validate_message_header_valid" {
    var data : [3]u8 = [MESSAGE_TYPE_DATA, 0x01, 0x02];
    assert(validate_message_header(&data));
}

test "test_validate_message_header_too_short" {
    var data : [1]u8 = [MESSAGE_TYPE_DATA];
    assert(!validate_message_header(&data));
}

test "test_parse_websocket_message_event" {
    var data : [6]u8 = [MESSAGE_TYPE_EVENT, 0x48, 0x65, 0x6c, 0x6c, 0x6f];  // type byte + "Hello"
    var message = parse_websocket_message(&data);
    assert(message.kind == MessageType.event);
    assert(message.data.len == 5);
    assert(message.data[0] == 0x48);
}

test "test_parse_websocket_message_data" {
    var data : [4]u8 = [MESSAGE_TYPE_DATA, 0x01, 0x02, 0x03];  // Data payload
    var message = parse_websocket_message(&data);
    assert(message.kind == MessageType.data);
    assert(message.data.len == 3);
}

test "test_parse_websocket_message_control" {
    var data : [6]u8 = [MESSAGE_TYPE_CONTROL, 0x43, 0x4f, 0x4e, 0x65, 0x74];  // type byte + 5 bytes
    var message = parse_websocket_message(&data);
    assert(message.kind == MessageType.control);
    assert(message.data.len == 5);
}

test "test_create_event_message" {
    var data : [1]u8 = [0x00];  // Some event
    var out : [16]u8 = [0] ** 16;
    var message = create_event_message(&data, &out);
    assert(message.len == 2);
    assert(message[0] == MESSAGE_TYPE_EVENT);
    assert(message[1] == 0x00);
}

test "test_create_data_message" {
    var data : [3]u8 = [0x01, 0x02, 0x03];  // Some data
    var out : [16]u8 = [0] ** 16;
    var message = create_data_message(&data, &out);
    assert(message.len == 4);
    assert(message[0] == MESSAGE_TYPE_DATA);
    assert(message[3] == 0x03);
}

test "test_create_control_message" {
    var data : [5]u8 = [0x43, 0x4f, 0x4e, 0x65, 0x74];  // Some control
    var out : [16]u8 = [0] ** 16;
    var message = create_control_message(&data, &out);
    assert(message.len == 6);
    assert(message[0] == MESSAGE_TYPE_CONTROL);
    assert(message[5] == 0x74);
}

test "test_extract_target_agent_simple" {
    var data : [10]u8 = [0x40, 0x41, 0x67, 0x65, 0x6e, 0x74, 0x61, 0x6d, 0x65, 0x3e];  // @Agentame>
    var message = WebSocketMessage{
        .kind = MessageType.data,
        .data = &data,
        .timestamp = 0,
    };
    var agent = extract_target_agent(message);

    // Extracted should be "Agentame"
    var expected : [8]u8 = [0x41, 0x67, 0x65, 0x6e, 0x74, 0x61, 0x6d, 0x65];
    assert(std.mem.eql(u8, agent, &expected));
}

test "test_extract_target_agent_with_delimiter" {
    var data : [11]u8 = [0x40, 0x41, 0x67, 0x65, 0x6e, 0x74, 0x61, 0x6d, 0x65, 0x3e, 0x62];  // @Agentame>b
    var message = WebSocketMessage{
        .kind = MessageType.data,
        .data = &data,
        .timestamp = 0,
    };
    var agent = extract_target_agent(message);

    // Should stop at the delimiter and extract "Agentame"
    var expected : [8]u8 = [0x41, 0x67, 0x65, 0x6e, 0x74, 0x61, 0x6d, 0x65];
    assert(std.mem.eql(u8, agent, &expected));
}

test "test_should_reconnect_below_limit" {
    var url : [3]u8 = [0x77, 0x73, 0x2f];
    var name : [2]u8 = [0x41, 0x67];
    var config = ObserverConfig{
        .server_url = &url,
        .agent_name = &name,
        .reconnect_delay = 1000,
        .max_reconnect_attempts = 5,
    };
    assert(should_reconnect(websocket_state_set(WebSocketState.failed), 2, config.max_reconnect_attempts));
    assert(should_reconnect(websocket_state_set(WebSocketState.failed), 3, config.max_reconnect_attempts));
    assert(should_reconnect(websocket_state_set(WebSocketState.failed), 4, config.max_reconnect_attempts));
    assert(!should_reconnect(websocket_state_set(WebSocketState.failed), 5, config.max_reconnect_attempts));
}

test "test_should_reconnect_at_limit" {
    var url : [3]u8 = [0x77, 0x73, 0x2f];
    var name : [2]u8 = [0x41, 0x67];
    var config = ObserverConfig{
        .server_url = &url,
        .agent_name = &name,
        .reconnect_delay = 1000,
        .max_reconnect_attempts = 5,
    };
    assert(!should_reconnect(websocket_state_set(WebSocketState.failed), 5, config.max_reconnect_attempts));
    assert(!should_reconnect(websocket_state_set(WebSocketState.ready), 0, config.max_reconnect_attempts));
}

test "test_observer_should_connect_closed" {
    var url : [3]u8 = [0x77, 0x73, 0x2f];
    var name : [2]u8 = [0x41, 0x67];
    var config = ObserverConfig{
        .server_url = &url,
        .agent_name = &name,
        .reconnect_delay = 1000,
        .max_reconnect_attempts = 5,
    };
    assert(observer_should_connect(config, websocket_state_set(WebSocketState.closed)));
    assert(observer_should_connect(config, websocket_state_set(WebSocketState.failed)));
    assert(!observer_should_connect(config, websocket_state_set(WebSocketState.ready)));
}

test "test_observer_should_disconnect_ready" {
    var url : [3]u8 = [0x77, 0x73, 0x2f];
    var name : [2]u8 = [0x41, 0x67];
    var config = ObserverConfig{
        .server_url = &url,
        .agent_name = &name,
        .reconnect_delay = 1000,
        .max_reconnect_attempts = 5,
    };
    assert(observer_should_disconnect(config, websocket_state_set(WebSocketState.ready)));
    assert(!observer_should_disconnect(config, websocket_state_set(WebSocketState.closed)));
}

test "test_route_message_control" {
    var none : [1]u8 = [0];
    var message = WebSocketMessage{
        .kind = MessageType.control,
        .data = none[0 .. 0],
        .timestamp = 0,
    };
    var agent : [2]u8 = [0x41, 0x67];
    assert(route_message(message, &agent));
}

test "test_route_message_data_matching" {
    var body : [4]u8 = [0x40, 0x41, 0x67, 0x3e];  // @Ag>
    var message = WebSocketMessage{
        .kind = MessageType.data,
        .data = &body,
        .timestamp = 0,
    };
    var agent : [2]u8 = [0x41, 0x67];
    assert(route_message(message, &agent));
}

test "test_route_message_data_non_matching" {
    var body : [4]u8 = [0x40, 0x41, 0x67, 0x3e];  // @Ag>
    var message = WebSocketMessage{
        .kind = MessageType.data,
        .data = &body,
        .timestamp = 0,
    };
    var agent : [2]u8 = [0x42, 0x6f];  // Different agent
    assert(!route_message(message, &agent));
}

test "test_get_current_timestamp_monotonic" {
    var ts1 = get_current_timestamp();
    var ts2 = update_timestamp(ts1, 100);
    var ts3 = get_current_timestamp();

    assert(ts2 == ts1 + 100);
    assert(ts2 >= ts1);
    assert(ts3 >= ts1);
    assert(update_timestamp(ts2, 0) == ts2);
}

test "test_calculate_backoff_delay_increasing" {
    var delay = calculate_backoff_delay(0, 1000, 5000);
    assert(delay > 0);
    assert(delay == 1100);

    delay = calculate_backoff_delay(1, 1000, 5000);
    assert(delay > 1000);
    assert(delay == 2200);

    delay = calculate_backoff_delay(2, 1000, 5000);
    assert(delay > 2000);
    assert(delay == 4400);
}

test "test_calculate_backoff_delay_respects_max" {
    var delay = calculate_backoff_delay(10, 1000, 5000);
    assert(delay == 5000);
    delay = calculate_backoff_delay(255, 4000000000, 4294967295);
    assert(delay == 4294967295);
}

test "test_observer_init_valid_config" {
    var url : [3]u8 = [0x77, 0x73, 0x2f];
    var name : [2]u8 = [0x41, 0x67];
    var config = ObserverConfig{
        .server_url = &url,
        .agent_name = &name,
        .reconnect_delay = 3000,
        .max_reconnect_attempts = 10,
    };
    var result = observer_init(config);
    assert(std.mem.eql(u8, result.server_url, config.server_url));
    assert(std.mem.eql(u8, result.agent_name, config.agent_name));
    assert(result.reconnect_delay == config.reconnect_delay);
    assert(result.max_reconnect_attempts == config.max_reconnect_attempts);
}

test "test_observer_init_empty_url" {
    var none : [1]u8 = [0];
    var name : [2]u8 = [0x41, 0x67];
    var config = ObserverConfig{
        .server_url = none[0 .. 0],
        .agent_name = &name,
        .reconnect_delay = 1000,
        .max_reconnect_attempts = 5,
    };
    var result = observer_init(config);
    assert(std.mem.eql(u8, result.server_url, config.server_url));
    assert(std.mem.eql(u8, result.agent_name, config.agent_name));
    assert(result.reconnect_delay == 3000);  // Default applied
    assert(result.max_reconnect_attempts == config.max_reconnect_attempts);
}

test "test_observer_init_empty_agent" {
    var url : [3]u8 = [0x77, 0x73, 0x2f];
    var none : [1]u8 = [0];
    var config = ObserverConfig{
        .server_url = &url,
        .agent_name = none[0 .. 0],
        .reconnect_delay = 1000,
        .max_reconnect_attempts = 5,
    };
    var result = observer_init(config);
    assert(std.mem.eql(u8, result.server_url, config.server_url));
    assert(std.mem.eql(u8, result.agent_name, config.agent_name));
    assert(result.reconnect_delay == 3000);  // Default applied
    assert(result.max_reconnect_attempts == config.max_reconnect_attempts);
}

// ============================================================================
// TDD - Invariants
// ============================================================================

invariant message_type_byte_range
    assert MESSAGE_TYPE_EVENT < 3
    assert MESSAGE_TYPE_DATA < 3
    assert MESSAGE_TYPE_CONTROL < 3

invariant reconnect_delay_positive
    assert inv_init_delay() > 0

invariant max_reconnect_attempts_positive
    assert inv_init_attempts() > 0

invariant message_type_enum_coverage
    assert message_type_to_byte(MessageType.event) == 0
    assert message_type_to_byte(MessageType.data) == 1
    assert message_type_to_byte(MessageType.control) == 2

invariant state_enum_coverage
    assert WS_READY_STATE < 4
    assert WS_CONNECTING_STATE < 4
    assert WS_ERROR_STATE < 4
    assert WS_CLOSED_STATE < 4

invariant backoff_delay_monotonic
    // Delay increases with attempt, bounded by max_delay
    assert calculate_backoff_delay(1, 1000, 5000) >= calculate_backoff_delay(0, 1000, 5000)
    assert calculate_backoff_delay(2, 1000, 5000) >= calculate_backoff_delay(1, 1000, 5000)

// ============================================================================
// TDD - Benchmarks (Optional but recommended)
// ============================================================================

bench "bench_message_parse_latency" {
    // Measure: cycles for parsing a typical WebSocket message
    // Target: < 50 cycles on t27-hardware
    var data : [11]u8 = [MESSAGE_TYPE_DATA, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a];
    var total : usize = 0;
    var rep : usize = 0;
    while (rep < 100) {
        var message = parse_websocket_message(&data);
        total = total + message.data.len;
        rep = rep + 1;
    }
}

bench "bench_message_create_event" {
    // Measure: cycles for creating event message
    // Target: < 30 cycles on t27-hardware
    var data : [1]u8 = [0x00];
    var out : [8]u8 = [0] ** 8;
    var total : usize = 0;
    var rep : usize = 0;
    while (rep < 100) {
        var message = create_event_message(&data, &out);
        total = total + message.len;
        rep = rep + 1;
    }
}

bench "bench_message_route_latency" {
    // Measure: cycles for message routing decision
    // Target: < 20 cycles on t27-hardware
    var body : [4]u8 = [0x40, 0x41, 0x67, 0x3e];
    var message = WebSocketMessage{
        .kind = MessageType.data,
        .data = &body,
        .timestamp = 0,
    };
    var agent : [2]u8 = [0x41, 0x67];
    var routed : usize = 0;
    var rep : usize = 0;
    while (rep < 100) {
        if (route_message(message, &agent)) {
            routed = routed + 1;
        }
        rep = rep + 1;
    }
}

bench "bench_observer_init_latency" {
    // Measure: cycles for observer initialization
    // Target: < 100 cycles on t27-hardware
    var url : [3]u8 = [0x77, 0x73, 0x2f];
    var name : [2]u8 = [0x41, 0x67];
    var config = ObserverConfig{
        .server_url = &url,
        .agent_name = &name,
        .reconnect_delay = 3000,
        .max_reconnect_attempts = 10,
    };
    var total : u32 = 0;
    var rep : usize = 0;
    while (rep < 100) {
        total = observer_init(config).reconnect_delay;
        rep = rep + 1;
    }
}
