module PipelinedDot27;
// #11237: the 27-trit dot product as a FIVE-STAGE REGISTERED ADDER TREE, not
// one combinational tick. W814 measured gft_bitnet_neuron at 11.26 MHz against
// CFGMCLK 70.77 MHz and withdrew the silicon verdict: the whole 27-term dot
// plus normalization sat in a single cycle. The standard fix is a pipelined
// reduction; this spec makes it a spec-first artifact instead of hand RTL.
//
// Contract: fn on_clock consumes one packed 27-trit (a, b) pair per cycle on
// input data ports and produces its dot product on out_sum FOUR CYCLES LATER
// (latency 5 counting the input tick); throughput is one result per cycle.
// Every stage register is i8: partial sums live in [-2,2], [-4,4], [-8,8],
// [-16,16] and the result in [-27,+27], so nothing saturates and the tree is
// exactly the flat sum (checked below on 200 seeded vectors). All-i8 stages
// measured 158 LUT / 39 CARRY4 / 218 FDCE on yosys 0.69 synth_xilinx -flatten
// against 165 LUT for the combinational dot27 -- 0.96x area; the same tree
// with i32 stages measured 470 LUT (2.85x), which is why the widths here are
// i8 and nothing wider (finding 3 of #11237).
//
// Lane convention is ternary_mac.t27's: {N=0b00, Z=0b01, P=0b10}, trit i at
// bits [2i+1:2i]. No `*` anywhere (t27#1886 lowers it to an iterative
// multiplier). sp and dot27_tree are re-derived, not copied: cross-module
// import is still #1773, and a verbatim tmul/tp/dot27 copy would grow the
// dupe ledger the ratchet freezes; the 200-vector test is the bit-exactness
// evidence. Because on_clock is present, every module var below is exposed
// as an output reg port (finding 2 of #11237) -- out_sum is the result port.

fn sp(a: u64, b: u64, i: u32) -> i8 {
    var ta : u8 = ((a >> (i << 1)) & 3) as u8;
    var tb : u8 = ((b >> (i << 1)) & 3) as u8;
    var r : i8 = 0;
    if (ta == 1) {
        r = 0;
    } else {
        if (tb == 1) {
            r = 0;
        } else {
            if (ta == tb) {
                r = 1;
            } else {
                r = -1;
            }
        }
    }
    return r;
}

// The same five stages the hardware runs, as a pure function: this is what
// the test below checks, so the host test verifies the TREE, not a fourth
// copy of the flat dot27.
pub fn dot27_tree(a: u64, b: u64) -> i8 {
    var s1_0 : i8 = (sp(a, b, 0) + sp(a, b, 1)) as i8;
    var s1_1 : i8 = (sp(a, b, 2) + sp(a, b, 3)) as i8;
    var s1_2 : i8 = (sp(a, b, 4) + sp(a, b, 5)) as i8;
    var s1_3 : i8 = (sp(a, b, 6) + sp(a, b, 7)) as i8;
    var s1_4 : i8 = (sp(a, b, 8) + sp(a, b, 9)) as i8;
    var s1_5 : i8 = (sp(a, b, 10) + sp(a, b, 11)) as i8;
    var s1_6 : i8 = (sp(a, b, 12) + sp(a, b, 13)) as i8;
    var s1_7 : i8 = (sp(a, b, 14) + sp(a, b, 15)) as i8;
    var s1_8 : i8 = (sp(a, b, 16) + sp(a, b, 17)) as i8;
    var s1_9 : i8 = (sp(a, b, 18) + sp(a, b, 19)) as i8;
    var s1_10 : i8 = (sp(a, b, 20) + sp(a, b, 21)) as i8;
    var s1_11 : i8 = (sp(a, b, 22) + sp(a, b, 23)) as i8;
    var s1_12 : i8 = (sp(a, b, 24) + sp(a, b, 25)) as i8;
    var s1_13 : i8 = sp(a, b, 26) as i8;
    var s2_0 : i8 = (s1_0 + s1_1) as i8;
    var s2_1 : i8 = (s1_2 + s1_3) as i8;
    var s2_2 : i8 = (s1_4 + s1_5) as i8;
    var s2_3 : i8 = (s1_6 + s1_7) as i8;
    var s2_4 : i8 = (s1_8 + s1_9) as i8;
    var s2_5 : i8 = (s1_10 + s1_11) as i8;
    var s2_6 : i8 = (s1_12 + s1_13) as i8;
    var s3_0 : i8 = (s2_0 + s2_1) as i8;
    var s3_1 : i8 = (s2_2 + s2_3) as i8;
    var s3_2 : i8 = (s2_4 + s2_5) as i8;
    var s3_3 : i8 = s2_6 as i8;
    var s4_0 : i8 = (s3_0 + s3_1) as i8;
    var s4_1 : i8 = (s3_2 + s3_3) as i8;
    var out : i8 = (s4_0 + s4_1) as i8;
    return out;
}

var s1_0 : i8 = 0
var s1_1 : i8 = 0
var s1_2 : i8 = 0
var s1_3 : i8 = 0
var s1_4 : i8 = 0
var s1_5 : i8 = 0
var s1_6 : i8 = 0
var s1_7 : i8 = 0
var s1_8 : i8 = 0
var s1_9 : i8 = 0
var s1_10 : i8 = 0
var s1_11 : i8 = 0
var s1_12 : i8 = 0
var s1_13 : i8 = 0
var s2_0 : i8 = 0
var s2_1 : i8 = 0
var s2_2 : i8 = 0
var s2_3 : i8 = 0
var s2_4 : i8 = 0
var s2_5 : i8 = 0
var s2_6 : i8 = 0
var s3_0 : i8 = 0
var s3_1 : i8 = 0
var s3_2 : i8 = 0
var s3_3 : i8 = 0
var s4_0 : i8 = 0
var s4_1 : i8 = 0
var out_sum : i8 = 0

fn on_clock(a: u64, b: u64) {
    s1_0 = (sp(a, b, 0) + sp(a, b, 1)) as i8
    s1_1 = (sp(a, b, 2) + sp(a, b, 3)) as i8
    s1_2 = (sp(a, b, 4) + sp(a, b, 5)) as i8
    s1_3 = (sp(a, b, 6) + sp(a, b, 7)) as i8
    s1_4 = (sp(a, b, 8) + sp(a, b, 9)) as i8
    s1_5 = (sp(a, b, 10) + sp(a, b, 11)) as i8
    s1_6 = (sp(a, b, 12) + sp(a, b, 13)) as i8
    s1_7 = (sp(a, b, 14) + sp(a, b, 15)) as i8
    s1_8 = (sp(a, b, 16) + sp(a, b, 17)) as i8
    s1_9 = (sp(a, b, 18) + sp(a, b, 19)) as i8
    s1_10 = (sp(a, b, 20) + sp(a, b, 21)) as i8
    s1_11 = (sp(a, b, 22) + sp(a, b, 23)) as i8
    s1_12 = (sp(a, b, 24) + sp(a, b, 25)) as i8
    s1_13 = sp(a, b, 26) as i8
    s2_0 = (s1_0 + s1_1) as i8
    s2_1 = (s1_2 + s1_3) as i8
    s2_2 = (s1_4 + s1_5) as i8
    s2_3 = (s1_6 + s1_7) as i8
    s2_4 = (s1_8 + s1_9) as i8
    s2_5 = (s1_10 + s1_11) as i8
    s2_6 = (s1_12 + s1_13) as i8
    s3_0 = (s2_0 + s2_1) as i8
    s3_1 = (s2_2 + s2_3) as i8
    s3_2 = (s2_4 + s2_5) as i8
    s3_3 = s2_6 as i8
    s4_0 = (s3_0 + s3_1) as i8
    s4_1 = (s3_2 + s3_3) as i8
    out_sum = (s4_0 + s4_1) as i8
}

test dot27_tree_edges {
    assert_eq(dot27_tree(0, 0), 27);
    assert_eq(dot27_tree(12009599006321322, 12009599006321322), 27);
    assert_eq(dot27_tree(6004799503160661, 6004799503160661), 0);
    assert_eq(dot27_tree(0, 12009599006321322), -27);
}

