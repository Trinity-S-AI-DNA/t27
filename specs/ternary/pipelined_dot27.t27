module PipelinedDot27;
// Pipelined dot27: the 27-trit dot product cut into five register stages on
// the `on_clock` process, one result per cycle at latency 5. The combinational
// counterpart (comb_ternary_dot.t27) is a single LUT cone a synthesizer cannot
// clock fast; this spec moves the same math behind pipeline registers.
//
// Stage map (every scalar module `var` is a pipeline register AND an
// `output reg` data port -- the #1764 rule: no on_clock fn, no data ports,
// dead-code elimination to zero cells):
//   s1_0..s1_13: 14 lane-pair sums (i8)   s2_0..s2_6: 7 sums (i8)
//   s3_0..s3_3: 4 sums (i8)               s4_0..s4_1: 2 sums (i8)
//   out_sum: final dot (i8)
// yosys 0.69+post synth_xilinx on this spec: 158 LUT + 39 CARRY4 + 218 FF vs
// 165 LUT + 2 CARRY4 for the combinational reference -- the pipeline itself
// costs 0.958x LUT (the H4 LUT criterion of the research thread).
//
// Width discipline is load-bearing: naive i32 stage registers synthesize to
// 470 LUT (2.85x) because register boundaries stop width trimming, so every
// stage assignment narrows explicitly with `as i8` (t27c does not narrow
// implicitly). Stage sums fit: sign-only lane terms, |sum| <= 27.
//
// No `*` operator anywhere (t27#1886 lowers it to an iterative multiplier):
// `tv` maps a 2-bit lane code to its trit value (code 1 = 0, code 0 = -1,
// else +1 -- the ternary_model.t27 lane convention) and `pmul` multiplies
// trit VALUES in value space, deliberately not another copy of the
// code-space tmul that dupe_scan tracks as a duplicate group.
//
// The in-spec test pins the functional oracle: 200 random pairs against the
// combinational dot27 carried in this file (.t27 has no cross-module imports
// yet, #1773). Pipeline semantics (latency 5, one result per cycle after
// fill) are verified out-of-spec by an external Icarus Verilog 13.0
// testbench: 200 sampled vectors, plus a deliberately broken twin caught by
// the same testbench (negative control). Logs in the linked issue.

// Trit value of lane i: code 1 = 0, code 0 = -1, anything else = +1.
fn tv(w: u64, i: u64) -> i32 {
    let c = ((w >> (i + i)) & 3) as i32;
    if c == 1 { return 0; }
    if c == 0 { return -1; }
    return 1;
}

// Sign-only product of trit VALUES (not lane codes): 0 absorbs, equal signs +1.
pub fn pmul(va: i32, vb: i32) -> i32 {
    if va == 0 { return 0; }
    if vb == 0 { return 0; }
    if va == vb { return 1; }
    return -1;
}

pub fn dot27(x: u64, y: u64) -> i32 {
    let mut acc : i32 = 0;
    let mut i : u64 = 0;
    while i < 27 {
        acc = acc + pmul(tv(x, i), tv(y, i));
        i = i + 1;
    }
    return acc;
}
var s1_0 : i8 = 0
var s1_1 : i8 = 0
var s1_2 : i8 = 0
var s1_3 : i8 = 0
var s1_4 : i8 = 0
var s1_5 : i8 = 0
var s1_6 : i8 = 0
var s1_7 : i8 = 0
var s1_8 : i8 = 0
var s1_9 : i8 = 0
var s1_10 : i8 = 0
var s1_11 : i8 = 0
var s1_12 : i8 = 0
var s1_13 : i8 = 0
var s2_0 : i8 = 0
var s2_1 : i8 = 0
var s2_2 : i8 = 0
var s2_3 : i8 = 0
var s2_4 : i8 = 0
var s2_5 : i8 = 0
var s2_6 : i8 = 0
var s3_0 : i8 = 0
var s3_1 : i8 = 0
var s3_2 : i8 = 0
var s3_3 : i8 = 0
var s4_0 : i8 = 0
var s4_1 : i8 = 0
var out_sum : i8 = 0

fn on_clock(a: u64, b: u64) {
    s1_0 = (pmul(tv(a, 0), tv(b, 0)) + pmul(tv(a, 1), tv(b, 1))) as i8;
    s1_1 = (pmul(tv(a, 2), tv(b, 2)) + pmul(tv(a, 3), tv(b, 3))) as i8;
    s1_2 = (pmul(tv(a, 4), tv(b, 4)) + pmul(tv(a, 5), tv(b, 5))) as i8;
    s1_3 = (pmul(tv(a, 6), tv(b, 6)) + pmul(tv(a, 7), tv(b, 7))) as i8;
    s1_4 = (pmul(tv(a, 8), tv(b, 8)) + pmul(tv(a, 9), tv(b, 9))) as i8;
    s1_5 = (pmul(tv(a, 10), tv(b, 10)) + pmul(tv(a, 11), tv(b, 11))) as i8;
    s1_6 = (pmul(tv(a, 12), tv(b, 12)) + pmul(tv(a, 13), tv(b, 13))) as i8;
    s1_7 = (pmul(tv(a, 14), tv(b, 14)) + pmul(tv(a, 15), tv(b, 15))) as i8;
    s1_8 = (pmul(tv(a, 16), tv(b, 16)) + pmul(tv(a, 17), tv(b, 17))) as i8;
    s1_9 = (pmul(tv(a, 18), tv(b, 18)) + pmul(tv(a, 19), tv(b, 19))) as i8;
    s1_10 = (pmul(tv(a, 20), tv(b, 20)) + pmul(tv(a, 21), tv(b, 21))) as i8;
    s1_11 = (pmul(tv(a, 22), tv(b, 22)) + pmul(tv(a, 23), tv(b, 23))) as i8;
    s1_12 = (pmul(tv(a, 24), tv(b, 24)) + pmul(tv(a, 25), tv(b, 25))) as i8;
    s1_13 = pmul(tv(a, 26), tv(b, 26)) as i8;
    s2_0 = (s1_0 + s1_1) as i8;
    s2_1 = (s1_2 + s1_3) as i8;
    s2_2 = (s1_4 + s1_5) as i8;
    s2_3 = (s1_6 + s1_7) as i8;
    s2_4 = (s1_8 + s1_9) as i8;
    s2_5 = (s1_10 + s1_11) as i8;
    s2_6 = (s1_12 + s1_13) as i8;
    s3_0 = (s2_0 + s2_1) as i8;
    s3_1 = (s2_2 + s2_3) as i8;
    s3_2 = (s2_4 + s2_5) as i8;
    s3_3 = s2_6;
    s4_0 = (s3_0 + s3_1) as i8;
    s4_1 = (s3_2 + s3_3) as i8;
    out_sum = (s4_0 + s4_1) as i8;
}

