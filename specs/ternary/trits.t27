module Trits;
// Balanced ternary digits, operations, and encoding
// Trit values: -1 (N), 0 (Z), +1 (P)

// Trit constants
pub const TRIT_N : i8 = -1;
pub const TRIT_Z : i8 = 0;
pub const TRIT_P : i8 = 1;

// Encoding: offset 111...1 (base 3) for balanced ternary
pub const OFFSET_BASE_3 : i64 = 7656119315618446744; // (3^27 - 1) / 2

// ========================================================================
// 1. Balanced Ternary Digit Operations with Offset Reading
// ========================================================================

// trit_to_int(trit: i8, offset: i64) -> i64
// Convert trit to integer using offset reading (avoids signed division)
pub fn trit_to_int(trit: i8, offset: i64) -> i64 {
    return (trit as i64) + offset;
}

// int_to_trit(value: i64, offset: i64) -> i8
// Convert integer to trit using offset reading
pub fn int_to_trit(value: i64, offset: i64) -> i8 {
    return (value - offset) as i8;
}

// negate_trit(trit: i8) -> i8
// Negation by flipping trits: N->P, Z->Z, P->N
pub fn negate_trit(trit: i8) -> i8 {
    if (trit == TRIT_N) { return TRIT_P; }
    if (trit == TRIT_P) { return TRIT_N; }
    return TRIT_Z;
}

// round_trit(trit: i8) -> i8
// Rounding by cutting trits: values outside [-1,1] are clamped
pub fn round_trit(trit: i8) -> i8 {
    if (trit < TRIT_N) { return TRIT_N; }
    if (trit > TRIT_P) { return TRIT_P; }
    return trit;
}

// ========================================================================
// 2. Kleene Logic Operations
// ========================================================================

// kleene_not(trit: i8) -> i8
// Kleene NOT: N->P, Z->Z, P->N (same as negation)
pub fn kleene_not(trit: i8) -> i8 {
    return negate_trit(trit);
}

// kleene_min(a: i8, b: i8) -> i8
// Kleene MIN: returns the minimum (most negative) of two trits
pub fn kleene_min(a: i8, b: i8) -> i8 {
    if (a <= b) { return a; }
    return b;
}

// kleene_max(a: i8, b: i8) -> i8
// Kleene MAX: returns the maximum (most positive) of two trits
pub fn kleene_max(a: i8, b: i8) -> i8 {
    if (a >= b) { return a; }
    return b;
}

// kleene_consensus(a: i8, b: i8) -> i8
// Kleene CONSENSUS: returns Z if both are Z, otherwise the non-Z value
pub fn kleene_consensus(a: i8, b: i8) -> i8 {
    if (a == TRIT_Z and b == TRIT_Z) { return TRIT_Z; }
    if (a == TRIT_Z) { return b; }
    if (b == TRIT_Z) { return a; }
    return TRIT_Z; // Both non-Z, consensus is Z
}

// kleene_any(a: i8, b: i8) -> i8
// Kleene ANY: returns P if either is P, otherwise the maximum
pub fn kleene_any(a: i8, b: i8) -> i8 {
    if (a == TRIT_P or b == TRIT_P) { return TRIT_P; }
    return kleene_max(a, b);
}

// half_adder_trit(a: i8, b: i8) -> (i8, i8)
// Half adder for trits: returns (sum, carry)
pub fn half_adder_trit(a: i8, b: i8) -> (i8, i8) {
    var sum : i8 = a + b;
    var carry : i8 = 0;
    
    // Handle overflow
    if (sum > TRIT_P) {
        sum = TRIT_N;
        carry = TRIT_P;
    } else if (sum < TRIT_N) {
        sum = TRIT_P;
        carry = TRIT_N;
    }
    
    return (sum, carry);
}

// ========================================================================
// 3. Full Adder and Ripple Add
// ========================================================================

// full_adder_trit(a: i8, b: i8, cin: i8) -> (i8, i8)
// Full adder for trits: returns (sum, cout)
pub fn full_adder_trit(a: i8, b: i8, cin: i8) -> (i8, i8) {
    var (sum1, carry1) = half_adder_trit(a, b);
    var (sum, cout) = half_adder_trit(sum1, cin);
    return (sum, cout);
}

// ripple_add_trit(a: i8, b: i8, carry_in: i8) -> (i8, i8)
// Ripple add for single trits with carry: returns (sum, cout)
pub fn ripple_add_trit(a: i8, b: i8, carry_in: i8) -> (i8, i8) {
    return full_adder_trit(a, b, carry_in);
}

// ========================================================================
// 4. Multiplication Operations
// ========================================================================

// multiply_by_trit(a: i8, b: i8) -> i8
// Product by one trit without a multiplier
pub fn multiply_by_trit(a: i8, b: i8) -> i8 {
    if (a == TRIT_Z or b == TRIT_Z) { return TRIT_Z; }
    if (a == b) { return TRIT_P; }
    return TRIT_N;
}

// long_multiply_trit(a: i8, b: i8) -> i8
// Long multiplication for single trits
pub fn long_multiply_trit(a: i8, b: i8) -> i8 {
    return multiply_by_trit(a, b);
}

// mac_step_trit(a: i8, b: i8, c: i8) -> i8
// MAC (Multiply-Accumulate) step: (a * b) + c
pub fn mac_step_trit(a: i8, b: i8, c: i8) -> i8 {
    var product = multiply_by_trit(a, b);
    return product + c;
}

// ========================================================================
// 5. Trit Encoding: 2 bits per trit, 5 trits per byte
// ========================================================================

// trit_to_2bit(trit: i8) -> u8
// Encode trit in 2 bits: N=0b10, Z=0b00, P=0b01
pub fn trit_to_2bit(trit: i8) -> u8 {
    if (trit == TRIT_N) { return 2; }
    if (trit == TRIT_Z) { return 0; }
    return 1;
}

// bit2_to_trit(bits: u8) -> i8
// Decode 2-bit trit encoding back to trit
pub fn bit2_to_trit(bits: u8) -> i8 {
    if (bits == 2) { return TRIT_N; }
    if (bits == 0) { return TRIT_Z; }
    return TRIT_P;
}

// pack_5trits_to_byte(t0: i8, t1: i8, t2: i8, t3: i8, t4: i8) -> u8
// Pack 5 trits into one byte using 2 bits each
pub fn pack_5trits_to_byte(t0: i8, t1: i8, t2: i8, t3: i8, t4: i8) -> u8 {
    return (trit_to_2bit(t0) as u8) |
           ((trit_to_2bit(t1) as u8) << 2) |
           ((trit_to_2bit(t2) as u8) << 4) |
           ((trit_to_2bit(t3) as u8) << 6) |
           ((trit_to_2bit(t4) as u8) << 8);
}

// byte_to_5trits(byte: u8) -> (i8, i8, i8, i8, i8)
// Unpack one byte into 5 trits
pub fn byte_to_5trits(byte: u8) -> (i8, i8, i8, i8, i8) {
    return (bit2_to_trit(byte & 0x03),
            bit2_to_trit((byte >> 2) & 0x03),
            bit2_to_trit((byte >> 4) & 0x03),
            bit2_to_trit((byte >> 6) & 0x03),
            bit2_to_trit((byte >> 8) & 0x03));
}

// bits_for_k_trits(k: u32) -> u32
// Calculate bits needed for k trits (2 bits per trit)
pub fn bits_for_k_trits(k: u32) -> u32 {
    return k * 2;
}

// bytes_for_k_trits(k: u32) -> u32
// Calculate bytes needed for k trits (5 trits per byte)
pub fn bytes_for_k_trits(k: u32) -> u32 {
    return (k + 4) / 5; // Ceiling division
}

// ========================================================================
// 6. Three-Way Comparison
// ========================================================================

// three_way_compare(a: i8, b: i8) -> i8
// Compare two trits: -1 (a < b), 0 (a == b), +1 (a > b)
pub fn three_way_compare(a: i8, b: i8) -> i8 {
    if (a < b) { return TRIT_N; }
    if (a > b) { return TRIT_P; }
    return TRIT_Z;
}

// compare_arrays(a: i8, b: i8) -> i8
// Compare two trits: wrapper for three_way_compare
pub fn compare_arrays(a: i8, b: i8) -> i8 {
    return three_way_compare(a, b);
}

// two_answer_question(a: i8, b: i8) -> i8
// Two-answer question: 0 if equal, 1 if different
pub fn two_answer_question(a: i8, b: i8) -> i8 {
    if (a == b) { return TRIT_Z; }
    return TRIT_P;
}

// three_answer_question(a: i8, b: i8) -> i8
// Three-answer question: -1 (a < b), 0 (a == b), +1 (a > b)
pub fn three_answer_question(a: i8, b: i8) -> i8 {
    return three_way_compare(a, b);
}

// ========================================================================
// 7. Ternary Activation Function
// ========================================================================

// ternary_activation(x: i8) -> i8
// Ternary activation function: step function at zero
pub fn ternary_activation(x: i8) -> i8 {
    if (x > TRIT_Z) { return TRIT_P; }
    if (x < TRIT_Z) { return TRIT_N; }
    return TRIT_Z;
}

// ternary_activation_derivative(x: i8) -> i8
// Derivative of ternary activation (zero everywhere except at zero)
pub fn ternary_activation_derivative(x: i8) -> i8 {
    if (x == TRIT_Z) { return TRIT_P; }
    return TRIT_Z;
}

// ========================================================================
// 8. Tests
// ========================================================================

// Test offset reading
test offset_reading_identity {
    var offset = OFFSET_BASE_3;
    var trit = TRIT_P;
    var original = trit_to_int(trit, offset);
    var back = int_to_trit(original, offset);
    assert_eq(back, trit);
}

test offset_reading_negation {
    var offset = OFFSET_BASE_3;
    var trit = TRIT_N;
    var original = trit_to_int(trit, offset);
    var back = int_to_trit(original, offset);
    assert_eq(back, trit);
}

// Test negation
test negate_trit_n_to_p { assert_eq(negate_trit(TRIT_N), TRIT_P); }
test negate_trit_z_to_z { assert_eq(negate_trit(TRIT_Z), TRIT_Z); }
test negate_trit_p_to_n { assert_eq(negate_trit(TRIT_P), TRIT_N); }

// Test rounding
test round_trit_clamp_negative { assert_eq(round_trit(-2), TRIT_N); }
test round_trit_clamp_positive { assert_eq(round_trit(2), TRIT_P); }
test round_trit_identity { assert_eq(round_trit(TRIT_N), TRIT_N); }
test round_trit_identity_zero { assert_eq(round_trit(TRIT_Z), TRIT_Z); }
test round_trit_identity_positive { assert_eq(round_trit(TRIT_P), TRIT_P); }

// Test Kleene logic
test kleene_not_n { assert_eq(kleene_not(TRIT_N), TRIT_P); }
test kleene_not_z { assert_eq(kleene_not(TRIT_Z), TRIT_Z); }
test kleene_not_p { assert_eq(kleene_not(TRIT_P), TRIT_N); }

test kleene_min_n_p { assert_eq(kleene_min(TRIT_N, TRIT_P), TRIT_N); }
test kleene_min_z_p { assert_eq(kleene_min(TRIT_Z, TRIT_P), TRIT_Z); }
test kleene_min_n_z { assert_eq(kleene_min(TRIT_N, TRIT_Z), TRIT_N); }

test kleene_max_n_p { assert_eq(kleene_max(TRIT_N, TRIT_P), TRIT_P); }
test kleene_max_z_p { assert_eq(kleene_max(TRIT_Z, TRIT_P), TRIT_P); }
test kleene_max_n_z { assert_eq(kleene_max(TRIT_N, TRIT_Z), TRIT_Z); }

test kleene_consensus_zz { assert_eq(kleene_consensus(TRIT_Z, TRIT_Z), TRIT_Z); }
test kleene_consensus_np { assert_eq(kleene_consensus(TRIT_N, TRIT_P), TRIT_Z); }
test kleene_consensus_nz { assert_eq(kleene_consensus(TRIT_N, TRIT_Z), TRIT_N); }

test kleene_any_pp { assert_eq(kleene_any(TRIT_P, TRIT_P), TRIT_P); }
test kleene_any_np { assert_eq(kleene_any(TRIT_N, TRIT_P), TRIT_P); }
test kleene_any_nn { assert_eq(kleene_any(TRIT_N, TRIT_N), TRIT_N); }

// Test half adder
test half_adder_n_n { assert_eq(half_adder_trit(TRIT_N, TRIT_N), (TRIT_N, TRIT_N)); }
test half_adder_n_z { assert_eq(half_adder_trit(TRIT_N, TRIT_Z), (TRIT_N, TRIT_Z)); }
test half_adder_n_p { assert_eq(half_adder_trit(TRIT_N, TRIT_P), (TRIT_Z, TRIT_N)); }
test half_adder_z_z { assert_eq(half_adder_trit(TRIT_Z, TRIT_Z), (TRIT_Z, TRIT_Z)); }
test half_adder_z_p { assert_eq(half_adder_trit(TRIT_Z, TRIT_P), (TRIT_P, TRIT_Z)); }
test half_adder_p_p { assert_eq(half_adder_trit(TRIT_P, TRIT_P), (TRIT_Z, TRIT_P)); }

// Test full adder
test full_adder_n_n_n { assert_eq(full_adder_trit(TRIT_N, TRIT_N, TRIT_N), (TRIT_N, TRIT_N)); }
test full_adder_n_n_z { assert_eq(full_adder_trit(TRIT_N, TRIT_N, TRIT_Z), (TRIT_N, TRIT_N)); }
test full_adder_n_n_p { assert_eq(full_adder_trit(TRIT_N, TRIT_N, TRIT_P), (TRIT_Z, TRIT_N)); }
test full_adder_n_z_z { assert_eq(full_adder_trit(TRIT_N, TRIT_Z, TRIT_Z), (TRIT_N, TRIT_Z)); }
test full_adder_n_z_p { assert_eq(full_adder_trit(TRIT_N, TRIT_Z, TRIT_P), (TRIT_Z, TRIT_Z)); }
test full_adder_n_p_p { assert_eq(full_adder_trit(TRIT_N, TRIT_P, TRIT_P), (TRIT_P, TRIT_N)); }
test full_adder_z_z_z { assert_eq(full_adder_trit(TRIT_Z, TRIT_Z, TRIT_Z), (TRIT_Z, TRIT_Z)); }
test full_adder_z_z_p { assert_eq(full_adder_trit(TRIT_Z, TRIT_Z, TRIT_P), (TRIT_P, TRIT_Z)); }
test full_adder_z_p_p { assert_eq(full_adder_trit(TRIT_Z, TRIT_P, TRIT_P), (TRIT_Z, TRIT_P)); }
test full_adder_p_p_p { assert_eq(full_adder_trit(TRIT_P, TRIT_P, TRIT_P), (TRIT_P, TRIT_P)); }

// Test multiplication
test multiply_by_trit_n_z { assert_eq(multiply_by_trit(TRIT_N, TRIT_Z), TRIT_Z); }
test multiply_by_trit_n_n { assert_eq(multiply_by_trit(TRIT_N, TRIT_N), TRIT_P); }
test multiply_by_trit_n_p { assert_eq(multiply_by_trit(TRIT_N, TRIT_P), TRIT_N); }
test multiply_by_trit_z_p { assert_eq(multiply_by_trit(TRIT_Z, TRIT_P), TRIT_Z); }
test multiply_by_trit_p_p { assert_eq(multiply_by_trit(TRIT_P, TRIT_P), TRIT_P); }

test long_multiply_trit_n_p { assert_eq(long_multiply_trit(TRIT_N, TRIT_P), TRIT_N); }
test long_multiply_trit_p_p { assert_eq(long_multiply_trit(TRIT_P, TRIT_P), TRIT_P); }

test mac_step_trit_n_p_z { assert_eq(mac_step_trit(TRIT_N, TRIT_P, TRIT_Z), TRIT_N); }
test mac_step_trit_p_p_n { assert_eq(mac_step_trit(TRIT_P, TRIT_P, TRIT_N), TRIT_Z); }
test mac_step_trit_p_p_p { assert_eq(mac_step_trit(TRIT_P, TRIT_P, TRIT_P), TRIT_P); }

// Test encoding
test trit_to_2bit_n { assert_eq(trit_to_2bit(TRIT_N), 2); }
test trit_to_2bit_z { assert_eq(trit_to_2bit(TRIT_Z), 0); }
test trit_to_2bit_p { assert_eq(trit_to_2bit(TRIT_P), 1); }

test bit2_to_trit_2 { assert_eq(bit2_to_trit(2), TRIT_N); }
test bit2_to_trit_0 { assert_eq(bit2_to_trit(0), TRIT_Z); }
test bit2_to_trit_1 { assert_eq(bit2_to_trit(1), TRIT_P); }

test pack_5trits_to_byte_nzpzp {
    var packed = pack_5trits_to_byte(TRIT_N, TRIT_Z, TRIT_P, TRIT_Z, TRIT_P);
    var (t0, t1, t2, t3, t4) = byte_to_5trits(packed);
    assert_eq(t0, TRIT_N);
    assert_eq(t1, TRIT_Z);
    assert_eq(t2, TRIT_P);
    assert_eq(t3, TRIT_Z);
    assert_eq(t4, TRIT_P);
}

test bits_for_k_trits_0 { assert_eq(bits_for_k_trits(0), 0); }
test bits_for_k_trits_1 { assert_eq(bits_for_k_trits(1), 2); }
test bits_for_k_trits_5 { assert_eq(bits_for_k_trits(5), 10); }
test bits_for_k_trits_8 { assert_eq(bits_for_k_trits(8), 16); }

test bytes_for_k_trits_0 { assert_eq(bytes_for_k_trits(0), 0); }
test bytes_for_k_trits_1 { assert_eq(bytes_for_k_trits(1), 1); }
test bytes_for_k_trits_5 { assert_eq(bytes_for_k_trits(5), 1); }
test bytes_for_k_trits_6 { assert_eq(bytes_for_k_trits(6), 2); }
test bytes_for_k_trits_10 { assert_eq(bytes_for_k_trits(10), 2); }

// Test comparison
test three_way_compare_n_p { assert_eq(three_way_compare(TRIT_N, TRIT_P), TRIT_N); }
test three_way_compare_p_n { assert_eq(three_way_compare(TRIT_P, TRIT_N), TRIT_P); }
test three_way_compare_n_z { assert_eq(three_way_compare(TRIT_N, TRIT_Z), TRIT_N); }
test three_way_compare_z_n { assert_eq(three_way_compare(TRIT_Z, TRIT_N), TRIT_P); }
test three_way_compare_z_p { assert_eq(three_way_compare(TRIT_Z, TRIT_P), TRIT_N); }
test three_way_compare_p_z { assert_eq(three_way_compare(TRIT_P, TRIT_Z), TRIT_P); }
test three_way_compare_z_z { assert_eq(three_way_compare(TRIT_Z, TRIT_Z), TRIT_Z); }

test two_answer_question_n_p { assert_eq(two_answer_question(TRIT_N, TRIT_P), TRIT_P); }
test two_answer_question_z_z { assert_eq(two_answer_question(TRIT_Z, TRIT_Z), TRIT_Z); }

test three_answer_question_n_p { assert_eq(three_answer_question(TRIT_N, TRIT_P), TRIT_N); }
test three_answer_question_p_z { assert_eq(three_answer_question(TRIT_P, TRIT_Z), TRIT_P); }
test three_answer_question_z_z { assert_eq(three_answer_question(TRIT_Z, TRIT_Z), TRIT_Z); }

// Test activation function
test ternary_activation_negative { assert_eq(ternary_activation(TRIT_N), TRIT_N); }
test ternary_activation_zero { assert_eq(ternary_activation(TRIT_Z), TRIT_Z); }
test ternary_activation_positive { assert_eq(ternary_activation(TRIT_P), TRIT_P); }

test ternary_activation_derivative_zero { assert_eq(ternary_activation_derivative(TRIT_Z), TRIT_P); }
test ternary_activation_derivative_negative { assert_eq(ternary_activation_derivative(TRIT_N), TRIT_Z); }
test ternary_activation_derivative_positive { assert_eq(ternary_activation_derivative(TRIT_P), TRIT_Z); }

// ========================================================================
// 9. Negative Control Tests
// ========================================================================

// Test that invalid trit values are handled properly
test round_trit_invalid_negative { assert_eq(round_trit(-3), TRIT_N); }
test round_trit_invalid_positive { assert_eq(round_trit(3), TRIT_P); }

// Test edge cases in multiplication
test multiply_by_trit_edge_cases {
    assert_eq(multiply_by_trit(TRIT_N, TRIT_Z), TRIT_Z);
    assert_eq(multiply_by_trit(TRIT_Z, TRIT_N), TRIT_Z);
    assert_eq(multiply_by_trit(TRIT_Z, TRIT_Z), TRIT_Z);
}

// Test encoding edge cases
test trit_to_2bit_invalid { assert_eq(trit_to_2bit(3), 1); } // Invalid value treated as P
test bit2_to_trit_invalid { assert_eq(bit2_to_trit(3), TRIT_P); } // Invalid bit treated as P

// ========================================================================
// 10. Invariants
// ========================================================================

invariant trit_constants_valid
    assert TRIT_N == -1 and TRIT_Z == 0 and TRIT_P == 1;

invariant offset_positive
    assert OFFSET_BASE_3 > 0;

invariant encoding_consistency
    assert trit_to_2bit(TRIT_N) == 2;
    assert trit_to_2bit(TRIT_Z) == 0;
    assert trit_to_2bit(TRIT_P) == 1;

invariant decoding_consistency
    assert bit2_to_trit(2) == TRIT_N;
    assert bit2_to_trit(0) == TRIT_Z;
    assert bit2_to_trit(1) == TRIT_P;

invariant round_trit_bounds
    assert round_trit(-10) == TRIT_N;
    assert round_trit(10) == TRIT_P;
    assert round_trit(TRIT_N) == TRIT_N;
    assert round_trit(TRIT_Z) == TRIT_Z;
    assert round_trit(TRIT_P) == TRIT_P;

invariant kleene_logic_properties
    assert kleene_not(kleene_not(TRIT_N)) == TRIT_N;
    assert kleene_not(kleene_not(TRIT_Z)) == TRIT_Z;
    assert kleene_not(kleene_not(TRIT_P)) == TRIT_P;
    assert kleene_min(TRIT_N, TRIT_P) == TRIT_N;
    assert kleene_max(TRIT_N, TRIT_P) == TRIT_P;

invariant arithmetic_consistency
    assert half_adder_trit(TRIT_N, TRIT_P).0 == TRIT_Z;  // N + P = Z
    assert half_adder_trit(TRIT_P, TRIT_P).0 == TRIT_Z;  // P + P = Z
    assert half_adder_trit(TRIT_N, TRIT_N).0 == TRIT_N;  // N + N = N

invariant multiplication_properties
    assert multiply_by_trit(TRIT_N, TRIT_P) == TRIT_N;
    assert multiply_by_trit(TRIT_P, TRIT_P) == TRIT_P;
    assert multiply_by_trit(TRIT_N, TRIT_N) == TRIT_P;

invariant activation_properties
    assert ternary_activation(TRIT_N) == TRIT_N;
    assert ternary_activation(TRIT_Z) == TRIT_Z;
    assert ternary_activation(TRIT_P) == TRIT_P;

// ========================================================================
// 11. Root function for external calls
// ========================================================================

// on_comb(a: i8, b: i8) -> i8
// Root function for external calls - demonstrates basic trit operation
fn on_comb(a: i8, b: i8) -> i8 {
    return kleene_min(a, b);
}

endmodule