// SPDX-License-Identifier: Apache-2.0
// Trit codon: a perfect ternary [4,2,3] Hamming code over GF(3).
//
// Four trits carry two trits of data and correct any single-trit error.
// 9 codewords x 9 sphere points = 81 = 3^4, so the code is perfect: every
// one of the 81 four-trit words is either a codeword or one step from
// exactly one. This is the hardware analogue of codon degeneracy: the
// fourth "wobble" position is not payload, it is structure.
//
// Word packing: the four trits d0,d1,d2,d3 are stored base-3 as
// w = d0 + 3*d1 + 9*d2 + 27*d3, so w is in 0..80. The two data trits are
// (a, b) = (d0, d1); the parity trits are d2 = a+b, d3 = a-b (mod 3).
//
// Lowering notes (2026-10-18 fix): every local declaration sits at the top
// of its function; loop bodies call helpers instead of declaring new
// locals, because gen-verilog lowers a mid-block local to a mid-block
// `reg` declaration that iverilog rejects. `on_comb` is the hardware
// boundary: a 32-bit word in, the repaired 32-bit codeword out.
module TritCodon;

pub const Q : i32 = 3;

fn mod3(x: i32) -> i32 {
    var r : i32 = x % Q;
    if (r < 0) { r = r + Q; }
    return r;
}

// Base-3 place value of trit position pos (0..3).
fn place_of(pos: i32) -> i32 {
    if (pos == 0) { return 1; }
    if (pos == 1) { return 3; }
    if (pos == 2) { return 9; }
    return 27;
}

// Codeword (a, b, a+b, a-b) mod 3. Check matrix columns are the four
// projective points of GF(3)^2: (1,0), (0,1), (1,1), (1,2).
pub fn encode(a: i32, b: i32) -> i32 {
    var aa : i32 = mod3(a);
    var bb : i32 = mod3(b);
    var p : i32 = mod3(aa + bb);
    var q : i32 = mod3(aa - bb);
    return aa + Q * bb + Q * Q * p + Q * Q * Q * q;
}

fn digit(w: i32, place: i32) -> i32 {
    return mod3(w / place);
}

fn rebuild(d0: i32, d1: i32, d2: i32, d3: i32) -> i32 {
    return d0 + Q * d1 + Q * Q * d2 + Q * Q * Q * d3;
}

// Syndrome s = H r, two trits packed base-3 as s1 + 3*s2.
fn syndrome(w: i32) -> i32 {
    var s1 : i32 = mod3(digit(w, 1) + digit(w, 9) + digit(w, 27));
    var s2 : i32 = mod3(digit(w, 3) + digit(w, 9) + 2 * digit(w, 27));
    return s1 + Q * s2;
}

// The trit the syndrome names: position 0..3, or 4 when the word is clean.
fn error_pos(w: i32) -> i32 {
    var s : i32 = syndrome(w);
    var s1 : i32 = mod3(s);
    var s2 : i32 = mod3(s / Q);
    if (s1 == 0 && s2 == 0) { return 4; }
    if (s2 == 0) { return 0; }
    if (s1 == 0) { return 1; }
    if (s1 == s2) { return 2; }
    return 3;
}

// The magnitude the syndrome names: 1 or 2 (a trit stepped up or down).
fn error_mag(w: i32) -> i32 {
    var s : i32 = syndrome(w);
    var s1 : i32 = mod3(s);
    var s2 : i32 = mod3(s / Q);
    if (s2 == 0) {
        if (s1 == 1) { return 1; }
        return 2;
    }
    if (s1 == 0) {
        if (s2 == 1) { return 1; }
        return 2;
    }
    if (s1 == s2) {
        if (s1 == 1) { return 1; }
        return 2;
    }
    if (s1 == 1) { return 1; }
    return 2;
}

// Repair one trit error. Returns the codeword; a clean word passes through.
pub fn decode(w: i32) -> i32 {
    var pos : i32 = error_pos(w);
    if (pos == 4) { return w; }
    var place : i32 = place_of(pos);
    var lam : i32 = error_mag(w);
    var old : i32 = digit(w, place);
    var fixed : i32 = mod3(old - lam);
    var d0 : i32 = digit(w, 1);
    var d1 : i32 = digit(w, 3);
    var d2 : i32 = digit(w, 9);
    var d3 : i32 = digit(w, 27);
    if (pos == 0) { d0 = fixed; }
    if (pos == 1) { d1 = fixed; }
    if (pos == 2) { d2 = fixed; }
    if (pos == 3) { d3 = fixed; }
    return rebuild(d0, d1, d2, d3);
}

// Two payload trits recovered from any single-trit corruption of a codeword.
pub fn message(w: i32) -> i32 {
    var c : i32 = decode(w);
    return digit(c, 1) + Q * digit(c, 3);
}

// The hardware boundary: a word in, the repaired codeword out.
fn on_comb(w: i32) -> i32 {
    return decode(w);
}

// Add e (1 or 2) to the trit at position pos of a word, keeping the word in
// 0..80. Pure helper so loop bodies stay declaration-free.
fn corrupt(cw: i32, pos: i32, e: i32) -> i32 {
    var place : i32 = place_of(pos);
    var old : i32 = digit(cw, place);
    var bad : i32 = mod3(old + e);
    var d0 : i32 = digit(cw, 1);
    var d1 : i32 = digit(cw, 3);
    var d2 : i32 = digit(cw, 9);
    var d3 : i32 = digit(cw, 27);
    if (pos == 0) { d0 = bad; }
    if (pos == 1) { d1 = bad; }
    if (pos == 2) { d2 = bad; }
    if (pos == 3) { d3 = bad; }
    return rebuild(d0, d1, d2, d3);
}

// Number of nonzero trits in a word.
fn weight(w: i32) -> i32 {
    var wt : i32 = 0;
    if (digit(w, 1) != 0) { wt = wt + 1; }
    if (digit(w, 3) != 0) { wt = wt + 1; }
    if (digit(w, 9) != 0) { wt = wt + 1; }
    if (digit(w, 27) != 0) { wt = wt + 1; }
    return wt;
}

// Exhaustive: 9 messages x 4 positions x 2 error magnitudes, then every one
// of the 81 words must decode to a codeword with a zero syndrome.
fn selfcheck() -> i32 {
    var fail : i32 = 0;
    var a : i32 = 0;
    while (a < Q) {
        var b : i32 = 0;
        while (b < Q) {
            var cw : i32 = encode(a, b);
            var pos : i32 = 0;
            while (pos < 4) {
                var e : i32 = 1;
                while (e < Q) {
                    var bad : i32 = corrupt(cw, pos, e);
                    if (decode(bad) != cw) { fail = fail + 1; }
                    e = e + 1;
                }
                pos = pos + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    var w : i32 = 0;
    while (w < 81) {
        var c : i32 = decode(w);
        if (syndrome(c) != 0) { fail = fail + 1; }
        w = w + 1;
    }
    return fail;
}

test codon_is_perfect {
    assert_eq(selfcheck(), 0);
}
test known_codeword {
    // (1,2) -> (1,2,0,2) = 1 + 6 + 0 + 54 = 61
    assert_eq(encode(1, 2), 61);
}
test single_error_is_repaired {
    // clean (0,1) = 0 + 3 + 9 + 54 = 66; add 1 to position 3 -> 68
    assert_eq(decode(68), 66);
    assert_eq(message(68), 3);
}
test clean_word_passes_through {
    assert_eq(decode(66), 66);
    assert_eq(syndrome(66), 0);
}
test every_error_position_is_named {
    // (1,0) = 1 + 0 + 9 + 27 = 37; each position bumped by 1 repairs to 37
    assert_eq(decode(corrupt(37, 0, 1)), 37);
    assert_eq(decode(corrupt(37, 1, 1)), 37);
    assert_eq(decode(corrupt(37, 2, 1)), 37);
    assert_eq(decode(corrupt(37, 3, 1)), 37);
}
test distance_is_three {
    // Tests do not hoist locals the way functions do, so the loop lives in
    // a helper and the test body stays declaration-light.
    var d : i32 = min_weight();
    assert_eq(d, 3);
}

// Smallest nonzero-codeword weight: the minimum distance of the code.
fn min_weight() -> i32 {
    var d : i32 = 9;
    var a : i32 = 0;
    while (a < Q) {
        var b : i32 = 0;
        while (b < Q) {
            if (!(a == 0 && b == 0)) {
                if (weight(encode(a, b)) < d) { d = weight(encode(a, b)); }
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return d;
}

endmodule
