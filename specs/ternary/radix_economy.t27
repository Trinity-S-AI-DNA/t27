module RadixEconomy;
// Radix economy calculations: digits per base, cost functions, optimal base finding

// Natural logarithm series expansion constants
pub const LN_SERIES_PRECISION : u32 = 20; // Number of terms in series expansion
pub const LN_EPSILON : f64 = 1e-10; // Convergence threshold

// ========================================================================
// 1. Natural Logarithm using Series Expansion
// ========================================================================

// ln_series(x: f64, terms: u32) -> f64
// Compute natural logarithm using series expansion: ln(1+x) = x - x²/2 + x³/3 - x⁴/4 + ...
// Valid for |x| < 1, returns ln(x) for x > 0
pub fn ln_series(x: f64, terms: u32) -> f64 {
    if (x <= 0.0) { return -1000000.0; } // Error: domain violation
    
    var result : f64 = 0.0;
    var term : f64 = 1.0;
    var denominator : f64 = 1.0;
    
    for (terms) |i| {
        if (i == 0) {
            term = x;
        } else {
            term = term * x; // x^i
            denominator = denominator + 1.0; // i+1
        }
        
        var signed_term = term / denominator;
        if ((i % 2) == 0) {
            result = result + signed_term;
        } else {
            result = result - signed_term;
        }
        
        // Check convergence
        if (signed_term.abs() < LN_EPSILON) {
            break;
        }
    }
    
    return result;
}

// ln(x: f64) -> f64
// Natural logarithm function with domain validation
pub fn ln(x: f64) -> f64 {
    if (x <= 0.0) { return -1000000.0; } // Error: domain violation
    
    // For values close to 1, use series expansion directly
    if (x > 0.5 and x < 2.0) {
        return ln_series(x - 1.0, LN_SERIES_PRECISION);
    }
    
    // For larger values, use ln(x) = ln(x/2) + ln(2)
    var result : f64 = 0.0;
    var remaining = x;
    var ln2 = ln_series(1.0, LN_SERIES_PRECISION); // ln(2) ≈ 0.693147
    
    while (remaining >= 2.0) {
        result = result + ln2;
        remaining = remaining / 2.0;
    }
    
    while (remaining <= 0.5) {
        result = result - ln2;
        remaining = remaining * 2.0;
    }
    
    // Now remaining is in (0.5, 2.0), use series expansion
    return result + ln_series(remaining - 1.0, LN_SERIES_PRECISION);
}

// ========================================================================
// 2. Digits per Base Calculations
// ========================================================================

// digits_per_base(n: f64, base: f64) -> f64
// Calculate number of digits needed to represent number n in given base
// Formula: digits = floor(log_base(n)) + 1 for n > 1
// For n <= 1, digits = 1
pub fn digits_per_base(n: f64, base: f64) -> f64 {
    if (n <= 1.0) { return 1.0; }
    if (base <= 1.0) { return 1.0; }
    
    var log_n = ln(n);
    var log_base = ln(base);
    var digits = log_n / log_base;
    
    return digits.floor() + 1.0;
}

// digits_per_base_int(n: u64, base: u64) -> u64
// Integer version of digits per base calculation
pub fn digits_per_base_int(n: u64, base: u64) -> u64 {
    if (n == 0 or n == 1) { return 1; }
    if (base == 1) { return 1; }
    
    var digits : u64 = 0;
    var remaining = n;
    
    while (remaining > 0) {
        remaining = remaining / base;
        digits = digits + 1;
    }
    
    return digits;
}

// ========================================================================
// 3. Cost Function Calculations
// ========================================================================

// cost_linear(b: f64, digits: f64) -> f64
// Linear cost function: cost = b * digits
// where b is the base and digits is the number of digits
pub fn cost_linear(b: f64, digits: f64) -> f64 {
    return b * digits;
}

// cost_div(b: f64) -> f64
// Divisibility cost: b / ln(b)
// This represents the cost of division operations in base b
pub fn cost_div(b: f64) -> f64 {
    if (b <= 1.0) { return 1000000.0; } // Error: invalid base
    
    var ln_b = ln(b);
    if (ln_b.abs() < LN_EPSILON) { return 1000000.0; } // Avoid division by zero
    
    return b / ln_b;
}

// cost_total(b: f64, n: f64) -> f64
// Total cost function combining linear and divisibility costs
// cost = b * digits + b / ln(b)
pub fn cost_total(b: f64, n: f64) -> f64 {
    var digits = digits_per_base(n, b);
    var linear_cost = cost_linear(b, digits);
    var div_cost = cost_div(b);
    
    return linear_cost + div_cost;
}

// ========================================================================
// 4. Optimal Base Finding
// ========================================================================

// find_cheapest_base(n: f64, min_base: f64, max_base: f64, precision: f64) -> f64
// Find the base that minimizes the total cost function
// Uses gradient descent with multiple starting points
pub fn find_cheapest_base(n: f64, min_base: f64, max_base: f64, precision: f64) -> f64 {
    if (n <= 1.0) { return 2.0; } // Default for small numbers
    if (min_base <= 1.0) { min_base = 2.0; }
    if (max_base <= min_base) { max_base = min_base + 10.0; }
    
    var best_base : f64 = min_base;
    var best_cost : f64 = cost_total(best_base, n);
    
    // Search through integer bases first
    var base_int : f64 = min_base.floor();
    while (base_int <= max_base) {
        var current_cost = cost_total(base_int, n);
        if (current_cost < best_cost) {
            best_cost = current_cost;
            best_base = base_int;
        }
        base_int = base_int + 1.0;
    }
    
    // Fine search around the best integer base
    var search_range : f64 = 2.0;
    var step : f64 = 0.1;
    
    for (50) |i| { // Limited iterations for performance
        var test_base = best_base + (i as f64 - 25.0) * step;
        
        if (test_base >= min_base and test_base <= max_base) {
            var current_cost = cost_total(test_base, n);
            if (current_cost < best_cost) {
                best_cost = current_cost;
                best_base = test_base;
            }
        }
    }
    
    return best_base;
}

// find_cheapest_base_int(n: u64, min_base: u64, max_base: u64) -> u64
// Integer version of cheapest base finding
pub fn find_cheapest_base_int(n: u64, min_base: u64, max_base: u64) -> u64 {
    if (n == 0 or n == 1) { return 2; }
    if (min_base < 2) { min_base = 2; }
    if (max_base < min_base) { max_base = min_base; }
    
    var best_base : u64 = min_base;
    var best_cost : f64 = cost_total(min_base as f64, n as f64);
    
    for (min_base..max_base+1) |base| {
        var current_cost = cost_total(base as f64, n as f64);
        if (current_cost < best_cost) {
            best_cost = current_cost;
            best_base = base;
        }
    }
    
    return best_base;
}

// ========================================================================
// 5. Base Analysis Functions
// ========================================================================

// analyze_base(b: f64, n: f64) -> (f64, f64, f64, f64)
// Analyze a specific base: returns (digits, linear_cost, div_cost, total_cost)
pub fn analyze_base(b: f64, n: f64) -> (f64, f64, f64, f64) {
    var digits = digits_per_base(n, b);
    var linear_cost = cost_linear(b, digits);
    var div_cost = cost_div(b);
    var total_cost = linear_cost + div_cost;
    
    return (digits, linear_cost, div_cost, total_cost);
}

// analyze_base_int(b: u64, n: u64) -> (u64, f64, f64, f64)
// Integer version of base analysis
pub fn analyze_base_int(b: u64, n: u64) -> (u64, f64, f64, f64) {
    var digits = digits_per_base_int(n, b);
    var linear_cost = cost_linear(b as f64, digits as f64);
    var div_cost = cost_div(b as f64);
    var total_cost = linear_cost + div_cost;
    
    return (digits, linear_cost, div_cost, total_cost);
}

// ========================================================================
// 6. Comparative Analysis
// ========================================================================

// compare_bases(b1: f64, b2: f64, n: f64) -> f64
// Compare two bases and return the cost difference (b1 - b2)
pub fn compare_bases(b1: f64, b2: f64, n: f64) -> f64 {
    var cost1 = cost_total(b1, n);
    var cost2 = cost_total(b2, n);
    return cost1 - cost2;
}

// ========================================================================
// 7. Tests
// ========================================================================

// Test natural logarithm
test ln_series_basic {
    given x = 1.0
    when result = ln_series(x, 10)
    then result.abs() < 0.01  // ln(1) = 0
}

test ln_series_small {
    given x = 0.5
    when result = ln_series(x, 15)
    then (result - (-0.693147)).abs() < 0.01  // ln(0.5) ≈ -0.693147
}

test ln_basic {
    given x = 2.0
    when result = ln(x)
    then (result - 0.693147).abs() < 0.01  // ln(2) ≈ 0.693147
}

test ln_large {
    given x = 10.0
    when result = ln(x)
    then (result - 2.302585).abs() < 0.01  // ln(10) ≈ 2.302585
}

// Test digits per base
test digits_per_base_10_100 { assert_eq(digits_per_base(100.0, 10.0), 3.0); }
test digits_per_base_2_8 { assert_eq(digits_per_base(8.0, 2.0), 4.0); }
test digits_per_base_16_255 { assert_eq(digits_per_base(255.0, 16.0), 2.0); }
test digits_per_base_small { assert_eq(digits_per_base(1.0, 10.0), 1.0); }
test digits_per_base_int_100_10 { assert_eq(digits_per_base_int(100, 10), 3); }
test digits_per_base_int_8_2 { assert_eq(digits_per_base_int(8, 2), 4); }
test digits_per_base_int_1_10 { assert_eq(digits_per_base_int(1, 10), 1); }

// Test cost functions
test cost_linear_10_3 { assert_eq(cost_linear(10.0, 3.0), 30.0); }
test cost_linear_2_4 { assert_eq(cost_linear(2.0, 4.0), 8.0); }
test cost_div_10 { assert((cost_div(10.0) - 14.427).abs() < 1.0); } // 10/ln(10) ≈ 14.427
test cost_div_2 { assert((cost_div(2.0) - 2.885).abs() < 1.0); } // 2/ln(2) ≈ 2.885
test cost_total_10_100 {
    given result = cost_total(10.0, 100.0)
    when expected = 30.0 + 14.427  // linear + div
    then (result - expected).abs() < 1.0
}

// Test optimal base finding
test find_cheapest_base_100 {
    given result = find_cheapest_base(100.0, 2.0, 16.0, 0.1)
    then result >= 2.0 and result <= 16.0
}

test find_cheapest_base_int_100 {
    given result = find_cheapest_base_int(100, 2, 16)
    then result >= 2 and result <= 16
}

test find_cheapest_base_int_1000 {
    given result = find_cheapest_base_int(1000, 2, 16)
    then result >= 2 and result <= 16
}

// Test base analysis
test analyze_base_10_100 {
    given (digits, linear, div, total) = analyze_base(10.0, 100.0)
    then digits == 3.0 and linear == 30.0 and total > 30.0
}

test analyze_base_int_10_100 {
    given (digits, linear, div, total) = analyze_base_int(10, 100)
    then digits == 3 and linear == 30.0 and total > 30.0
}

// Test base comparison
test compare_bases_basic {
    var diff = compare_bases(2.0, 8.0, 100.0);
    assert(diff <= 0.0); // 2.0 should be cheaper than 8.0
}

// ========================================================================
// 8. Negative Control Tests
// ========================================================================

// Test error handling for invalid inputs
test ln_domain_error {
    given x = -1.0
    when result = ln(x)
    then result == -1000000.0  // Error value
}

test ln_zero_error {
    given x = 0.0
    when result = ln(x)
    then result == -1000000.0  // Error value
}

test cost_div_zero_error {
    given b = 1.0
    when result = cost_div(b)
    then result == 1000000.0  // Error value
}

test cost_div_negative_error {
    given b = -1.0
    when result = cost_div(b)
    then result == 1000000.0  // Error value
}

test digits_per_base_invalid_base {
    given n = 100.0
    and base = 0.5
    when result = digits_per_base(n, base)
    then result == 1.0  // Fallback to 1 for invalid base
}

test digits_per_base_int_zero {
    given n = 0
    and base = 10
    when result = digits_per_base_int(n, base)
    then result == 1  // Special case: 0 requires 1 digit
}

test find_cheapest_base_invalid_range {
    given n = 100.0
    and min_base = 16.0
    and max_base = 2.0
    when result = find_cheapest_base(n, min_base, max_base, 0.1)
    then result == 2.0  // Fallback to minimum valid base
}

// ========================================================================
// 9. Invariants
// ========================================================================

invariant ln_positive_domain
    assert ln(1.0) >= -0.1 and ln(1.0) <= 0.1;  // ln(1) = 0
    assert ln(2.0) > 0.5;  // ln(2) > 0
    assert ln(10.0) > 2.0;  // ln(10) > 2

invariant digits_per_base_properties
    assert digits_per_base(1.0, 10.0) == 1.0;
    assert digits_per_base(10.0, 10.0) == 2.0;
    assert digits_per_base(100.0, 10.0) == 3.0;
    assert digits_per_base(8.0, 2.0) == 4.0;

invariant cost_functions_positive
    assert cost_linear(10.0, 3.0) == 30.0;
    assert cost_linear(2.0, 4.0) == 8.0;
    assert cost_div(10.0) > 0.0;
    assert cost_div(2.0) > 0.0;

invariant cost_total_consistency
    assert cost_total(10.0, 100.0) > 0.0;
    assert cost_total(2.0, 8.0) > 0.0;

invariant optimal_base_reasonable
    assert find_cheapest_base(100.0, 2.0, 16.0, 0.1) >= 2.0;
    assert find_cheapest_base(100.0, 2.0, 16.0, 0.1) <= 16.0;
    assert find_cheapest_base_int(100, 2, 16) >= 2;
    assert find_cheapest_base_int(100, 2, 16) <= 16;

invariant base_analysis_consistency
    given (digits, linear, div, total) = analyze_base(10.0, 100.0)
    then digits == 3.0 and linear == 30.0 and total > 30.0;

invariant comparison_sorted
    var diff1 = compare_bases(2.0, 8.0, 100.0);
    var diff2 = compare_bases(8.0, 10.0, 100.0);
    var diff3 = compare_bases(10.0, 16.0, 100.0);
    assert diff1 <= 0.0 and diff2 <= 0.0 and diff3 <= 0.0;  // 2.0 < 8.0 < 10.0 < 16.0 in cost

invariant series_convergence
    assert ln_series(0.1, 20).abs() < 1.0;  // Series should converge
    assert ln_series(0.5, 20).abs() < 1.0;  // Series should converge

// ========================================================================
// 10. Root function for external calls
// ========================================================================

// on_comb(n: f64, base: f64) -> f64
// Root function for external calls - demonstrates cost calculation
fn on_comb(n: f64, base: f64) -> f64 {
    return cost_total(base, n);
}

endmodule