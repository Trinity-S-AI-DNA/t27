// SPDX-License-Identifier: Apache-2.0
// Trit codon, wire form: the same perfect [4,2,3] ternary Hamming code as
// trit_codon.t27, but on the 2-bit trit codes the hardware actually stores,
// with no division anywhere. The packed-base-3 reference spec measures
// ~4565 LC on Artix-7 because `/3` and `/27` lower to dividers; this spec
// slices bits instead, which is the form a tile or a BRAM guard needs.
//
// Trit codes follow the T27 convention (trit stdlib, ternary_link):
//   2'b00 = -1 (digit 2), 2'b01 = 0 (digit 0), 2'b10 = +1 (digit 1),
//   2'b11 = reserved. Here 2'b11 is carried through as an INVALID trit so a
// caller can treat it as an erasure; the decoder flags it, it never
// silently becomes a valid trit.
//
// Interface: on_comb takes the 8-bit 2-bit-coded word (trit i at [2i+1:2i])
// and returns the repaired 8-bit word; bit 8 of the packed result carries
// the error flag, so a u16 leaves the valid 8-bit codeword intact.
module TritCodonWire;

// Trit codes.
pub const CODE_N : u8 = 0;  // 2'b00 -> digit 2 (-1)
pub const CODE_Z : u8 = 1;  // 2'b01 -> digit 0 ( 0)
pub const CODE_P : u8 = 2;  // 2'b10 -> digit 1 (+1)
pub const CODE_INVALID : u8 = 3;  // 2'b11 -> erasure candidate

// Digit value of a trit code; invalid codes map to digit 0 and are flagged.
fn dig(code: u8) -> i32 {
    if (code == CODE_Z) { return 0; }
    if (code == CODE_P) { return 1; }
    return 2;
}

// Trit code of a digit (0,1,2).
fn code_of(d: i32) -> u8 {
    if (d == 0) { return CODE_Z; }
    if (d == 1) { return CODE_P; }
    return CODE_N;
}

fn mod3(x: i32) -> i32 {
    var r : i32 = x % 3;
    if (r < 0) { r = r + 3; }
    return r;
}

// Count of 2'b11 trits in the word (erasure candidates).
fn invalid_count(w: u8) -> i32 {
    var n : i32 = 0;
    var i : i32 = 0;
    while (i < 4) {
        var code : u8 = ((w >> ((i * 2) as u8)) & 3) as u8;
        if (code == CODE_INVALID) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// Encode two data trit codes into the 8-bit codeword: (a, b, a+b, a-b).
pub fn encode(a: u8, b: u8) -> u8 {
    var d0 : i32 = dig(a);
    var d1 : i32 = dig(b);
    var d2 : i32 = mod3(d0 + d1);
    var d3 : i32 = mod3(d0 - d1);
    return code_of(d0) | ((code_of(d1) << 2) | ((code_of(d2) << 4) | (code_of(d3) << 6)));
}

// Syndrome s = H r as two digits packed base-3: s1 + 3*s2.
fn syndrome(w: u8) -> i32 {
    var d0 : i32 = dig((w & 3) as u8);
    var d1 : i32 = dig(((w >> 2) & 3) as u8);
    var d2 : i32 = dig(((w >> 4) & 3) as u8);
    var d3 : i32 = dig(((w >> 6) & 3) as u8);
    var s1 : i32 = mod3(d0 + d2 + d3);
    var s2 : i32 = mod3(d1 + d2 + 2 * d3);
    return s1 + 3 * s2;
}

// Error position the syndrome names: 0..3, or 4 when the word is clean.
fn error_pos(w: u8) -> i32 {
    var s : i32 = syndrome(w);
    var s1 : i32 = mod3(s);
    var s2 : i32 = mod3(s / 3);
    if (s1 == 0 && s2 == 0) { return 4; }
    if (s2 == 0) { return 0; }
    if (s1 == 0) { return 1; }
    if (s1 == s2) { return 2; }
    return 3;
}

// Error magnitude the syndrome names: 1 or 2.
fn error_mag(w: u8) -> i32 {
    var s : i32 = syndrome(w);
    var s1 : i32 = mod3(s);
    var s2 : i32 = mod3(s / 3);
    if (s2 == 0) {
        if (s1 == 1) { return 1; }
        return 2;
    }
    if (s1 == 0) {
        if (s2 == 1) { return 1; }
        return 2;
    }
    if (s1 == s2) {
        if (s1 == 1) { return 1; }
        return 2;
    }
    if (s1 == 1) { return 1; }
    return 2;
}

// Repair a single-trit error in the 8-bit word. Clean words pass through.
pub fn decode(w: u8) -> u8 {
    var pos : i32 = error_pos(w);
    if (pos == 4) { return w; }
    var lam : i32 = error_mag(w);
    var shift : i32 = pos * 2;
    var oldcode : u8 = ((w >> (shift as u8)) & 3) as u8;
    var old : i32 = dig(oldcode);
    var fixed : i32 = mod3(old - lam);
    var d0 : i32 = dig((w & 3) as u8);
    var d1 : i32 = dig(((w >> 2) & 3) as u8);
    var d2 : i32 = dig(((w >> 4) & 3) as u8);
    var d3 : i32 = dig(((w >> 6) & 3) as u8);
    if (pos == 0) { d0 = fixed; }
    if (pos == 1) { d1 = fixed; }
    if (pos == 2) { d2 = fixed; }
    if (pos == 3) { d3 = fixed; }
    return code_of(d0) | ((code_of(d1) << 2) | ((code_of(d2) << 4) | (code_of(d3) << 6)));
}

// The hardware boundary: word in, (flag << 8) | repaired word out.
// flag = 1 when the input held a 2'b11 trit, so a caller can treat that
// position as an erasure instead of trusting the repair.
fn on_comb(w: u8) -> u16 {
    var bad : u16 = (invalid_count(w) > 0) as u16;
    var fixed : u16 = (decode(w)) as u16;
    return (bad << 8) | fixed;
}

// Flip trit at position pos up by e (1 or 2), staying inside valid codes.
fn corrupt(cw: u8, pos: i32, e: i32) -> u8 {
    var shift : i32 = pos * 2;
    var oldcode : u8 = ((cw >> (shift as u8)) & 3) as u8;
    var old : i32 = dig(oldcode);
    var bad : i32 = mod3(old + e);
    var d0 : i32 = dig((cw & 3) as u8);
    var d1 : i32 = dig(((cw >> 2) & 3) as u8);
    var d2 : i32 = dig(((cw >> 4) & 3) as u8);
    var d3 : i32 = dig(((cw >> 6) & 3) as u8);
    if (pos == 0) { d0 = bad; }
    if (pos == 1) { d1 = bad; }
    if (pos == 2) { d2 = bad; }
    if (pos == 3) { d3 = bad; }
    return code_of(d0) | ((code_of(d1) << 2) | ((code_of(d2) << 4) | (code_of(d3) << 6)));
}

// Exhaustive: 9 messages x 4 positions x 2 magnitudes repair to the
// codeword; every clean codeword has a zero syndrome.
fn selfcheck() -> i32 {
    var fail : i32 = 0;
    var a : i32 = 0;
    while (a < 3) {
        var b : i32 = 0;
        while (b < 3) {
            var cw : u8 = encode(code_of(a), code_of(b));
            if (syndrome(cw) != 0) { fail = fail + 1; }
            var pos : i32 = 0;
            while (pos < 4) {
                var e : i32 = 1;
                while (e < 3) {
                    var bad : u8 = corrupt(cw, pos, e);
                    if (decode(bad) != cw) { fail = fail + 1; }
                    e = e + 1;
                }
                pos = pos + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return fail;
}

test wire_codon_is_perfect {
    assert_eq(selfcheck(), 0);
}
test wire_known_codeword {
    // (d0,d1,d2,d3) = (1,2,0,2) -> codes P,N,Z,N; trit i at [2i+1:2i]
    // gives bits [7:6]=N=00, [5:4]=Z=01, [3:2]=N=00, [1:0]=P=10 = 0b00010010
    assert_eq(encode(CODE_P, CODE_N), 0b00010010);
}
test wire_single_error_is_repaired {
    var cw : u8 = encode(CODE_P, CODE_N);
    var bad : u8 = corrupt(cw, 3, 1);
    assert_eq(decode(bad), cw);
}
test wire_clean_passes_through {
    var cw : u8 = encode(CODE_Z, CODE_P);
    assert_eq(decode(cw), cw);
}
test wire_invalid_trit_is_flagged {
    // 2'b11 in position 0 must raise the flag bit, not vanish.
    var w : u8 = 0b00011011;
    var out : u16 = on_comb(w);
    assert_eq((out >> 8) & 1, 1);
}
test wire_valid_word_has_no_flag {
    var cw : u8 = encode(CODE_Z, CODE_Z);
    var out : u16 = on_comb(cw);
    assert_eq((out >> 8) & 1, 0);
}

endmodule
