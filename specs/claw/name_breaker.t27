// SPDX-License-Identifier: Apache-2.0
// specs/claw/name_breaker.t27 -- claw: name the breaker of a master red, so
// fix_claim can refuse a self-fix bounty.
// Part of M10 milestone (milestone #14). Closes #10904.
// phi^2 + 1/phi^2 = 3 | TRINITY

module claw::name_breaker;

pub const CLAW_MAX_BREAKERS : u32 = 16;

pub struct BreakerRecord { breaker_id: str, identified: bool };

pub fn breaker_identified(b: BreakerRecord) -> bool {
    return b.identified;
}

test "breaker_identified" {
    assert(breaker_identified(BreakerRecord { breaker_id: "breaker-1", identified: true }));
    assert(!breaker_identified(BreakerRecord { breaker_id: "breaker-2", identified: false }));
}

invariant claw_max_breakers_positive {
    assert CLAW_MAX_BREAKERS > 0;
}