// SPDX-License-Identifier: Apache-2.0
; specs/claw/move_gate.t27 -- whether a Railway service can move to another project, decided
; before anything is created there.
; --
; On 2026-10-19 the owner asked to move TRI CLAW (Railway service vibee-render, project 999) into a
; new project. The variables were read first, names only. Of 139 variables, 12 named a
; *.railway.internal host: the database, telegram-bot-api, browser-pod, whisper, vision, the voice
; services and zep. Railway resolves those names only inside the same project environment, so a
; copy in another project would boot with no database. Three variables switch outbound loops on
; (AUTOPILOT_LOOP, ROUNDS_ENABLED, REDDIT_DESK_ENABLED). A second copy running beside the old one
; would post twice. Then the target project refused the first service it was asked for: its trial
; had expired. Each of the three would have been found later, by a broken deploy, a doubled post or
; a stuck CLI prompt. This module is the check to run first.
; --
; move_reason(kind, can_create, internal_refs, loops_on, old_running, state_volumes), first match
; wins:
;   kind is neither M_TRANSFER nor M_REBUILD          -> hold R_BAD
;   the target cannot create a service                -> hold R_TARGET_CLOSED  (both kinds)
;   kind M_TRANSFER (Railway "Transfer Project")      -> go   R_TRANSFER_OK
;   kind M_REBUILD (a new service in another project):
;     a variable names a *.railway.internal host      -> hold R_INTERNAL
;     an outbound loop is on and the old copy runs    -> hold R_DOUBLE
;     a volume holds state a rebuild cannot recreate  -> hold R_DATA
;     otherwise                                       -> go   R_REBUILD_OK
; A transfer keeps the project whole, so the network and the volumes go with it
; (docs.railway.com/projects#transferring-between-workspaces; private networking is scoped to one
; project environment, docs.railway.com/guides/isolate-staging-production). The caller counts only
; volumes whose loss matters: a cache the image rebuilds, such as the t27c lab's /data, is 0.
; move_line writes   V TAB <go|hold> TAB <why>\n   for one reason.
; is_internal_value and is_builtin_name read one variable: a value that names a private host, and
; a RAILWAY_* name Railway sets itself and that is never copied.
; The honest limit: the counts are the caller's reading of the service. This module decides from
; them; it does not call Railway.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawMoveGate;

use claw::text;

/// What kind of move.
pub const M_TRANSFER : u8 = 0;
pub const M_REBUILD : u8 = 1;

/// Verdicts.
pub const V_GO : u8 = 0;
pub const V_HOLD : u8 = 1;

/// Reasons, one per verdict line.
pub const R_TRANSFER_OK : u8 = 0;
pub const R_TARGET_CLOSED : u8 = 1;
pub const R_INTERNAL : u8 = 2;
pub const R_DOUBLE : u8 = 3;
pub const R_DATA : u8 = 4;
pub const R_REBUILD_OK : u8 = 5;
pub const R_BAD : u8 = 6;
pub const R_COUNT : usize = 7;

/// The verdict of each reason, in reason order.
pub const REASON_VERDICT : [7]u8 = [0, 1, 1, 1, 1, 0, 1];

pub const VERDICT_TEXTS : [2]str = ["V\tgo\t", "V\thold\t"];
pub const VERDICT_LENS : [2]usize = [5, 7];

pub const WHY_TEXTS : [7]str = [
    "a project transfer moves the private network and the volumes with it\n",
    "the target workspace refused to create a service (no plan); a person must choose one\n",
    "a variable names a *.railway.internal host, which resolves only inside the old project environment\n",
    "an outbound loop is on while the old copy still runs; two copies would both act\n",
    "a volume holds state that a rebuild does not recreate; copy it at a cutover the owner approves\n",
    "nothing ties the service to the old project; rebuild it in the new one\n",
    "unknown move kind; hold\n"
];
pub const WHY_LENS : [7]usize = [69, 85, 99, 80, 95, 71, 24];

/// The private-network suffix, and the prefix of the variables Railway sets itself.
pub const INTERNAL_HOST : str = ".railway.internal";
pub const INTERNAL_HOST_LEN : usize = 17;
pub const BUILTIN_PREFIX : str = "RAILWAY_";
pub const BUILTIN_PREFIX_LEN : usize = 8;

/// The reason for one move; its verdict is REASON_VERDICT[reason].
pub fn move_reason(kind : u8, can_create : bool, internal_refs : u32, loops_on : u32, old_running : bool, state_volumes : u32) -> u8 {
    if (kind != M_TRANSFER and kind != M_REBUILD) { return R_BAD; }
    if (!can_create) { return R_TARGET_CLOSED; }
    if (kind == M_TRANSFER) { return R_TRANSFER_OK; }
    if (internal_refs > 0) { return R_INTERNAL; }
    if (loops_on > 0 and old_running) { return R_DOUBLE; }
    if (state_volumes > 0) { return R_DATA; }
    return R_REBUILD_OK;
}

pub fn move_verdict(kind : u8, can_create : bool, internal_refs : u32, loops_on : u32, old_running : bool, state_volumes : u32) -> u8 {
    return REASON_VERDICT[move_reason(kind, can_create, internal_refs, loops_on, old_running, state_volumes)];
}

/// The verdict line for reason r into out at w, clipped at cap; returns the new cursor, which still
/// advances when clipped. A reason out of range writes the R_BAD line.
pub fn move_line(r : u8, out : []u8, cap : usize, w : usize) -> usize {
    var k : usize = r as usize;
    if (k >= R_COUNT) { k = R_BAD as usize; }
    const v : usize = REASON_VERDICT[k] as usize;
    const x : usize = put_str(out, cap, w, VERDICT_TEXTS[v], VERDICT_LENS[v]);
    return put_str(out, cap, x, WHY_TEXTS[k], WHY_LENS[k]);
}

/// Does the value v (v_len bytes) name a private Railway host anywhere in it?
pub fn is_internal_value(v : str, v_len : usize) -> bool {
    if (v_len < INTERNAL_HOST_LEN) { return false; }
    var start : usize = 0;
    while (start + INTERNAL_HOST_LEN <= v_len) {
        var k : usize = 0;
        var diff : usize = 0;
        while (k < INTERNAL_HOST_LEN) {
            if (v[start + k] != INTERNAL_HOST[k]) { diff += 1; }
            k += 1;
        }
        if (diff == 0) { return true; }
        start += 1;
    }
    return false;
}

/// Is n (n_len bytes) a variable Railway sets itself? Those are never copied to the new service.
pub fn is_builtin_name(n : str, n_len : usize) -> bool {
    return has_prefix(n, n_len, BUILTIN_PREFIX, BUILTIN_PREFIX_LEN);
}

// ---- tests: the move the lane met on 2026-10-19 ----

test the_target_whose_trial_expired_holds_every_move {
    // carefree-liberation answered "Your trial has expired" to the first service it was asked for.
    assert move_reason(M_REBUILD, false, 12, 3, true, 0) == R_TARGET_CLOSED;
    assert move_reason(M_TRANSFER, false, 0, 0, true, 0) == R_TARGET_CLOSED;
    assert move_verdict(M_REBUILD, false, 0, 0, false, 0) == V_HOLD;
}

test tri_claw_rebuilt_in_another_project_loses_its_twelve_private_hosts {
    // vibee-render: 139 variables, 12 name a *.railway.internal host, 3 loop switches, no volume.
    assert move_reason(M_REBUILD, true, 12, 3, true, 0) == R_INTERNAL;
    assert move_reason(M_REBUILD, true, 1, 0, false, 0) == R_INTERNAL;
}

test a_second_copy_with_its_loops_on_beside_the_old_one_holds {
    assert move_reason(M_REBUILD, true, 0, 3, true, 0) == R_DOUBLE;
    assert move_reason(M_REBUILD, true, 0, 1, true, 2) == R_DOUBLE;
}

test loops_are_no_bar_once_the_old_copy_is_stopped {
    assert move_reason(M_REBUILD, true, 0, 3, false, 0) == R_REBUILD_OK;
    assert move_verdict(M_REBUILD, true, 0, 3, false, 0) == V_GO;
}

test a_database_volume_holds_a_rebuild_until_a_cutover {
    // Postgres: one volume whose data no image recreates.
    assert move_reason(M_REBUILD, true, 0, 0, true, 1) == R_DATA;
    assert move_verdict(M_REBUILD, true, 0, 0, false, 1) == V_HOLD;
}

test the_t27c_lab_rebuilds_because_its_volume_is_a_cache {
    // t27c-lab: no private host, no outbound loop, /data is a cargo and checkout cache: 0 state volumes.
    assert move_reason(M_REBUILD, true, 0, 0, true, 0) == R_REBUILD_OK;
}

test a_transfer_with_a_plan_goes_whatever_the_service_depends_on {
    assert move_reason(M_TRANSFER, true, 12, 3, true, 19) == R_TRANSFER_OK;
    assert move_verdict(M_TRANSFER, true, 12, 3, true, 19) == V_GO;
}

test an_unknown_move_kind_holds_even_with_everything_clear {
    assert move_reason(2, true, 0, 0, false, 0) == R_BAD;
    assert move_reason(255, false, 0, 0, false, 0) == R_BAD;
    assert move_verdict(2, true, 0, 0, false, 0) == V_HOLD;
}

test only_the_two_ok_reasons_write_a_go_line {
    var out : [128]u8 = undefined;
    var r : u8 = 0;
    var gos : u32 = 0;
    while (r < 7) {
        const w : usize = move_line(r, &out, 128, 0);
        if (out[2] == 'g') {
            gos += 1;
            assert r == R_TRANSFER_OK or r == R_REBUILD_OK;
        } else {
            assert out[2] == 'h';
        }
        assert out[w - 1] == '\n';
        r += 1;
    }
    assert gos == 2;
}

test the_lens_are_the_lengths_of_the_texts {
    var k : usize = 0;
    while (k < R_COUNT) {
        assert WHY_LENS[k] == WHY_TEXTS[k].len;
        k += 1;
    }
    var v : usize = 0;
    while (v < 2) {
        assert VERDICT_LENS[v] == VERDICT_TEXTS[v].len;
        v += 1;
    }
    assert INTERNAL_HOST_LEN == INTERNAL_HOST.len;
    assert BUILTIN_PREFIX_LEN == BUILTIN_PREFIX.len;
    assert is_internal_value(INTERNAL_HOST, INTERNAL_HOST_LEN);
    assert is_internal_value(INTERNAL_HOST, INTERNAL_HOST_LEN - 1) == false;
    assert is_builtin_name(BUILTIN_PREFIX, BUILTIN_PREFIX_LEN);
}

test the_move_line_spells_the_verdict_and_the_reason {
    var out : [128]u8 = undefined;
    const w : usize = move_line(R_INTERNAL, &out, 128, 0);
    assert w == 7 + 99;
    assert out[0] == 'V';
    assert out[2] == 'h';
    assert out[7] == 'a';
    assert out[w - 1] == '\n';
    const g : usize = move_line(R_REBUILD_OK, &out, 128, 0);
    assert g == 5 + 71;
    assert out[2] == 'g';
}

test a_reason_out_of_range_writes_the_hold_line {
    var out : [64]u8 = undefined;
    const w : usize = move_line(9, &out, 64, 0);
    assert w == 7 + 24;
    assert out[2] == 'h';
    assert out[7] == 'u';
    // Exactly R_COUNT: the first reason past the table, not one that only lands far from it.
    out[7] = 'x';
    const e : usize = move_line(7, &out, 64, 0);
    assert e == 7 + 24;
    assert out[7] == 'u';
}

test a_clipped_line_still_advances_the_cursor {
    var out : [4]u8 = undefined;
    assert move_line(R_DATA, &out, 4, 0) == 7 + 95;
}

test a_private_host_anywhere_in_the_value_is_found {
    assert is_internal_value("postgresql://u:p@postgres.railway.internal:5432/railway", 55);
    assert is_internal_value("http://zep.railway.internal", 27);
    assert is_internal_value(".railway.internal", 17);
}

test negative_control_public_hosts_and_near_misses_are_not_private {
    assert is_internal_value("https://inngest-production.up.railway.app", 41) == false;
    assert is_internal_value("railway.internal", 16) == false;
    assert is_internal_value("x.railway.internaL", 18) == false;
    assert is_internal_value("x-railway.internal", 18) == false;
    assert is_internal_value("", 0) == false;
}

test railway_names_are_builtin_and_others_are_not {
    assert is_builtin_name("RAILWAY_PROJECT_ID", 18);
    assert is_builtin_name("RAILWAY_", 8);
    assert is_builtin_name("RAILWAY", 7) == false;
    assert is_builtin_name("railway_project_id", 18) == false;
    assert is_builtin_name("DATABASE_URL", 12) == false;
    assert is_builtin_name("XRAILWAY_A", 10) == false;
}
