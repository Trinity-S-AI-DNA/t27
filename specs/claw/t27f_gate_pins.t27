// SPDX-License-Identifier: Apache-2.0
; specs/claw/t27f_gate_pins.t27 -- the pins for specs/claw/t27f_gate.t27 that need .len.
; t27f_gate.t27 is lowered by gen-c (gen/c/claw/t27f_gate.c), and gen-c lowers str to const char*:
; .len reaches C verbatim and == between two strings is a pointer compare there. So the gate measures
; its '$'-terminated literals with its own lit_len, and the facts that need the real string length or
; another module's strings are checked HERE, in a test-only module that is never passed to gen-c
; (the claw/gates_pins.t27 precedent).
; specs/claw/service.t27 is not imported: its has_prefix(s, p) and own_language's has_prefix(list, s,
; from, to) share a name, and the flat `use` splice refuses an ambiguous name. The service side of the
; link is service.t27's own test check_prefix_namespaced, which asserts "claw/t27f" carries CHECK_PREFIX.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawT27fGatePins;

use claw::t27f_gate;
use t27f::hot;

/// Does a equal the '$'-terminated b without its '$'?
fn same_as_lit(a: []const u8, b: []const u8) -> bool {
    if (b.len != a.len + 1) { return false; }
    if (b[a.len] != '$') { return false; }
    for i in 0..a.len {
        if (a[i] != b[i]) { return false; }
    }
    return true;
}

test the_decision_labels_are_hot_decision_names {
    for i in 0..4 {
        assert same_as_lit(hot::HOT_DECISION_NAMES[i], t27f_gate::DECISION_LABELS[i]) == true;
    }
}

test the_check_name_is_claw_t27f {
    assert same_as_lit("claw/t27f", t27f_gate::CHECK_NAME) == true;
    assert same_as_lit("claw/t27", t27f_gate::CHECK_NAME) == false;
}

test lit_len_agrees_with_len_on_every_table {
    for i in 0..t27f_gate::CONSUMERS {
        assert t27f_gate::lit_len(t27f_gate::CONSUMER_NAMES[i]) + 1 == t27f_gate::CONSUMER_NAMES[i].len;
    }
    for i in 0..6 {
        assert t27f_gate::lit_len(t27f_gate::VERDICT_NAMES[i]) + 1 == t27f_gate::VERDICT_NAMES[i].len;
    }
    for i in 0..3 {
        assert t27f_gate::lit_len(t27f_gate::CONCL_NAMES[i]) + 1 == t27f_gate::CONCL_NAMES[i].len;
    }
    assert t27f_gate::lit_len(t27f_gate::CHECK_NAME) == 9;
}

test negative_control_a_wrong_label_is_caught {
    assert same_as_lit("reuse", "reuse$") == true;
    assert same_as_lit("reuse", "reuses$") == false;
    assert same_as_lit("reuse", "reuse") == false;
    assert same_as_lit("reuse", "reusE$") == false;
}
