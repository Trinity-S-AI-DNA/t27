// SPDX-License-Identifier: Apache-2.0
; specs/claw/service.t27 -- TRI CLAW as a service (epic #9271, T5): the surface a foreign
; repository consumes. The t27o pattern (#8996), applied to gates: zero servers, zero secrets --
; the consumer's own GitHub Actions runner is the execution, pinned to a claw-v* tag of THIS
; repository; the App identity (docs/claw/app-manifest.yml) is the later layer, not a dependency.
; --
; What is LOGIC and where it lives:
; - Which gates exist, their classes and events: specs/claw/gates.t27 -- the SSOT. This file
;   never restates the census; every count a consumer sees comes from that spec.
; - How the spec is read out of the repo: the t27c gen-c lowering of gates.t27
;   (gen/c/claw/gates.c) behind the four-line harness the gate-topology workflow builds; the
;   law is claw_status in gates.t27, and no hand-written reader exists (owner rule 2026-10-13).
; - The service contract -- the modes, the exit codes, the report vocabulary, the release-tag
;   identity a consumer pins to: the constants and functions below.
; --
; The honest limit: an audit says "the workflows directory and the gate inventory agree at this
; commit"; it does not say a workflow does what its name claims. A gate that lies in its name
; reads as clean.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY
module ClawService;

use claw::text;

/// The four modes of the service. audit: diff the consumer's workflows directory against the gate
/// inventory, exit code below. report: the markdown table of the inventory, for a PR body or a step
/// summary. matrix: the raw class/name/events rows. t27f: the seal-gated T27F check-run the App posts
/// on a pull request that touches .t27 files (specs/claw/t27f_gate.t27, check "claw/t27f").
pub const MODE_AUDIT : str = "audit";
pub const MODE_REPORT : str = "report";
pub const MODE_MATRIX : str = "matrix";
pub const MODE_T27F : str = "t27f";
pub const DEFAULT_MODE : str = "audit";

/// The tag family a release is cut from (docs/claw/RELEASE.md is the checklist that gates a tag).
pub const TAG_PREFIX : str = "claw-v";

/// The App's check-run names are prefixed, so a consumer's required-checks list can name
/// "claw/matrix-drift" without colliding with their own checks (v0.2 layer).
pub const CHECK_PREFIX : str = "claw/";

/// Exit codes of audit mode. CLEAN: the directory and the inventory agree. DRIFT: they do not --
/// one side names a gate the other does not know. UNREADABLE: the inventory itself could not be
/// read; never silently treated as clean (fail closed).
pub const EXIT_CLEAN : i32 = 0;
pub const EXIT_DRIFT : i32 = 1;
pub const EXIT_UNREADABLE : i32 = 2;

/// The report's vocabulary for the gate classes. The classes themselves are specs/claw/gates.t27
/// (G_BLOCKING, G_SOFT, G_REPORTING, G_UNKNOWN); these strings are how the report spells them.
pub const LABEL_BLOCKING : str = "blocking";
pub const LABEL_SOFT : str = "soft";
pub const LABEL_REPORTING : str = "reporting";
pub const LABEL_UNKNOWN : str = "unknown";

pub fn mode_valid(m : str) -> bool {
    return m == MODE_AUDIT or m == MODE_REPORT or m == MODE_MATRIX or m == MODE_T27F;
}

/// A consumer pins the reusable workflow to a tag of this family; anything else is not a release.
pub fn is_release_tag(t : str) -> bool {
    return has_prefix(t, t.len, TAG_PREFIX, TAG_PREFIX.len);
}

/// Audit mode's verdict from the three diff counts. Unreadable wins over drift: a missing
/// inventory is never reported as agreement, and never as a mere naming mismatch either.
pub fn audit_exit(spec_only : u32, dir_only : u32, unreadable : u32) -> i32 {
    if (unreadable != 0) { return EXIT_UNREADABLE; }
    if (spec_only != 0 or dir_only != 0) { return EXIT_DRIFT; }
    return EXIT_CLEAN;
}

/// How the report spells a gate class. An out-of-range class prints as unknown, never as
/// blocking -- the fail-closed side of the vocabulary.
pub fn class_label(c : u8) -> str {
    if (c == 0) { return LABEL_BLOCKING; }
    if (c == 1) { return LABEL_SOFT; }
    if (c == 2) { return LABEL_REPORTING; }
    return LABEL_UNKNOWN;
}

test mode_valid_accepts_the_four_modes {
    const modes : [5]str = [ MODE_AUDIT, MODE_REPORT, MODE_MATRIX, MODE_T27F, DEFAULT_MODE ];
    var i : usize = 0;
    var valid : u32 = 0;
    while (i < 5) {
        if (mode_valid(modes[i])) { valid += 1; }
        i += 1;
    }
    assert(valid == 5);
    assert(mode_valid("audit") == true);
    assert(mode_valid("t27f") == true);
    assert(mode_valid("nope") == false);
    assert(mode_valid("t27") == false);
    assert(mode_valid("t27f2") == false);
}

test default_mode_is_audit_and_audit_is_valid {
    const d : str = DEFAULT_MODE;
    assert(mode_valid(d) == true);
    assert(d == MODE_AUDIT);
}

test has_prefix_matches_and_rejects {
    const tag : str = "claw-v0.1";
    assert(has_prefix(tag, tag.len, TAG_PREFIX, TAG_PREFIX.len) == true);
    assert(has_prefix("v0.1", 4, TAG_PREFIX, TAG_PREFIX.len) == false);
    assert(has_prefix("", 0, TAG_PREFIX, TAG_PREFIX.len) == false);
    assert(has_prefix("claw", 4, "claw-v", 6) == false);
}

test is_release_tag_accepts_only_the_tag_family {
    const good : [3]str = [ "claw-v0.1", "claw-v1", "claw-v0.1.2" ];
    const bad : [3]str = [ "v0.1", "claw", "master" ];
    var i : usize = 0;
    while (i < 3) {
        assert(is_release_tag(good[i]) == true);
        assert(is_release_tag(bad[i]) == false);
        i += 1;
    }
}

test audit_exit_orders_clean_drift_unreadable {
    assert(audit_exit(0, 0, 0) == EXIT_CLEAN);
    assert(audit_exit(1, 0, 0) == EXIT_DRIFT);
    assert(audit_exit(0, 1, 0) == EXIT_DRIFT);
    assert(audit_exit(2, 3, 0) == EXIT_DRIFT);
    assert(audit_exit(0, 0, 1) == EXIT_UNREADABLE);
    assert(audit_exit(5, 5, 2) == EXIT_UNREADABLE);
}

test audit_exit_fails_closed_from_runtime_counts {
    var spec_only : u32 = 0;
    var dir_only : u32 = 0;
    var unreadable : u32 = 1;
    assert(audit_exit(spec_only, dir_only, unreadable) == EXIT_UNREADABLE);
    unreadable = 0;
    dir_only = 1;
    assert(audit_exit(spec_only, dir_only, unreadable) == EXIT_DRIFT);
    dir_only = 0;
    assert(audit_exit(spec_only, dir_only, unreadable) == EXIT_CLEAN);
}

test class_labels_cover_every_class_and_fail_closed {
    const classes : [4]u8 = [ 0, 1, 2, 255 ];
    const want : [4]str = [ LABEL_BLOCKING, LABEL_SOFT, LABEL_REPORTING, LABEL_UNKNOWN ];
    var i : usize = 0;
    while (i < 4) {
        assert(class_label(classes[i]) == want[i]);
        i += 1;
    }
    assert(class_label(7) == LABEL_UNKNOWN);
    assert(class_label(0) != LABEL_UNKNOWN);
}

test check_prefix_namespaced {
    const check_run : str = "claw/matrix-drift";
    assert(has_prefix(check_run, check_run.len, CHECK_PREFIX, CHECK_PREFIX.len) == true);
    assert(has_prefix("matrix-drift", 12, CHECK_PREFIX, CHECK_PREFIX.len) == false);
    assert(has_prefix("claw/t27f", 9, CHECK_PREFIX, CHECK_PREFIX.len) == true);
}
