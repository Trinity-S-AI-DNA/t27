// SPDX-License-Identifier: Apache-2.0
// specs/claw/fix_claim.t27 -- claw: fix_claim -- a TRI CLAW fix earns TRI credit
// claims only through VerifiedPayout's rules.
// Part of M10 milestone (milestone #14). Closes #10886.
// phi^2 + 1/phi^2 = 3 | TRINITY

module claw::fix_claim;

pub const CLAW_MAX_CLAIMS : u32 = 1024;

pub struct FixClaim { claim_id: str, verified: bool };

pub fn fix_claim_verified(f: FixClaim) -> bool {
    return f.verified;
}

test "fix_claim_verified" {
    assert(fix_claim_verified(FixClaim { claim_id: "claim-1", verified: true }));
    assert(!fix_claim_verified(FixClaim { claim_id: "claim-2", verified: false }));
}

invariant claw_max_claims_positive {
    assert CLAW_MAX_CLAIMS > 0;
}