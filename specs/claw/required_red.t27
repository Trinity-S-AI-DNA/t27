// SPDX-License-Identifier: Apache-2.0
; specs/claw/required_red.t27 -- push_gate's req_red flag, read from the rollup (#10606, #10617).
; --
; push_gate.t27 takes req_red ("a required check is red") from its caller. Until now the lane set it
; by eye, from a PR Dashboard line or an Auto-fix event. On 2026-10-18 that eye pushed #10585 for a
; red claw-sarif, which is not required (#10606), and the dashboard called 21 queued checks failing
; (#10617). This module computes the flag from the same rows check_latest.t27 reads.
; --
; Input: check_latest's rows, name TAB run TAB status TAB conclusion (name is workflow/job).
; A row is required when its job (the part of name after the last `/`, or all of it) is exactly
; validate, check-linked-issue, parse-ratchet or own-language. Only live rows count: a re-run
; supersedes the run it replaces (check_latest). Live required rows are classed by check_state.
; A required check with no row at all is missing; missing is not red.
; Any row this module cannot read counts as unreadable, whatever its name: its name cannot be
; trusted, so it might be a required check.
; Output, required_plan:
;     R TAB required: <p> pass, <f> failing, <w> pending, <m> missing, <b> unreadable rows
;     F TAB req_red TAB true | false | unknown
; req_red is true when a live required check fails; otherwise unknown when any row is unreadable
; (a reader must look before pushing); otherwise false.
; The honest limit: the required list is the one the lane observed on 2026-10-18; the repository has
; no branch protection API answer for master (404), so this list is not read from GitHub.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawRequiredRed;

use claw::text;
use claw::queue_cost;
use claw::check_state;
use claw::check_latest;

pub const RR_FALSE : u8 = 0;
pub const RR_TRUE : u8 = 1;
pub const RR_UNKNOWN : u8 = 2;

/// Required checks; the slot after them in a counts array holds the missing count.
pub const RR_REQUIRED : u8 = 4;
pub const RR_MISSING : usize = 4;

pub const RR_HEAD : str = "R\trequired: ";
pub const RR_HEAD_LEN : usize = 12;
pub const RR_COUNT_TEXTS : [4]str = [" pass, ", " failing, ", " pending, ", " missing, "];
pub const RR_COUNT_LENS : [4]usize = [7, 10, 10, 10];
pub const RR_FLAG_HEAD : str = "F\treq_red\t";
pub const RR_FLAG_HEAD_LEN : usize = 10;
pub const RR_FLAG_TEXTS : [3]str = ["false\n", "true\n", "unknown\n"];
pub const RR_FLAG_LENS : [3]usize = [6, 5, 8];

/// Where the job part of raw[s..e) starts: after the last `/`, or s.
pub fn job_start(raw : []const u8, s : usize, e : usize) -> usize {
    var j : usize = s;
    var i : usize = s;
    while (i < e) {
        if (raw[i] == '/') { j = i + 1; }
        i += 1;
    }
    return j;
}

/// The required check named by raw[s..e), or RR_REQUIRED when it is not one.
pub fn required_index(raw : []const u8, s : usize, e : usize) -> u8 {
    const j : usize = job_start(raw, s, e);
    if (qc_range_is(raw, j, e, "validate", 8)) { return 0; }
    if (qc_range_is(raw, j, e, "check-linked-issue", 18)) { return 1; }
    if (qc_range_is(raw, j, e, "parse-ratchet", 13)) { return 2; }
    if (qc_range_is(raw, j, e, "own-language", 12)) { return 3; }
    return RR_REQUIRED;
}

/// Live required rows by class in st[K_PASS..K_WAIT]; every unreadable row in st[K_BAD]; required
/// checks with no row in st[RR_MISSING]. Returns the number of rows.
pub fn required_counts(raw : []const u8, n : usize, st : []u32) -> u32 {
    var f : [8]usize = undefined;
    var c : [4]usize = undefined;
    var seen : [4]u32 = undefined;
    var k : usize = 0;
    while (k < 5) {
        st[k] = 0;
        k += 1;
    }
    k = 0;
    while (k < 4) {
        seen[k] = 0;
        k += 1;
    }
    var rows : u32 = 0;
    var ls : usize = 0;
    while (ls < n) {
        const le : usize = qc_line_end(raw, n, ls);
        if (le > ls) {
            var readable : bool = false;
            if (rows < CHECK_MAX_ROWS and qc_split(raw, ls, le, &f, 4)) {
                if (row_ok(raw, &f)) {
                    readable = true;
                    const r : u8 = required_index(raw, f[0], f[1]);
                    if (r < RR_REQUIRED) {
                        seen[r] += 1;
                        if (is_superseded(raw, n, ls, &f) == false) {
                            c[0] = f[4];
                            c[1] = f[5];
                            c[2] = f[6];
                            c[3] = f[7];
                            st[check_class(raw, &c)] += 1;
                        }
                    }
                }
            }
            if (readable == false) { st[K_BAD] += 1; }
            rows += 1;
        }
        ls = le + 1;
    }
    k = 0;
    while (k < 4) {
        if (seen[k] == 0) { st[RR_MISSING] += 1; }
        k += 1;
    }
    return rows;
}

/// The flag from the counts: a known red wins over an unreadable row.
pub fn req_red_flag(st : []const u32) -> u8 {
    if (st[K_FAIL] > 0) { return RR_TRUE; }
    if (st[K_BAD] > 0) { return RR_UNKNOWN; }
    return RR_FALSE;
}

pub fn required_flag(raw : []const u8, n : usize) -> u8 {
    var st : [5]u32 = undefined;
    const rows : u32 = required_counts(raw, n, &st);
    if (rows == 0) { return RR_FALSE; }
    return req_red_flag(&st);
}

/// The two output lines into out, clipped at cap; returns the cursor, which still advances when
/// clipped.
pub fn required_plan(raw : []const u8, n : usize, out : []u8, cap : usize) -> usize {
    var st : [5]u32 = undefined;
    const rows : u32 = required_counts(raw, n, &st);
    var w : usize = put_str(out, cap, 0, RR_HEAD, RR_HEAD_LEN);
    w = put_count(out, cap, w, st[K_PASS]);
    w = put_str(out, cap, w, RR_COUNT_TEXTS[0], RR_COUNT_LENS[0]);
    w = put_count(out, cap, w, st[K_FAIL]);
    w = put_str(out, cap, w, RR_COUNT_TEXTS[1], RR_COUNT_LENS[1]);
    w = put_count(out, cap, w, st[K_WAIT]);
    w = put_str(out, cap, w, RR_COUNT_TEXTS[2], RR_COUNT_LENS[2]);
    w = put_count(out, cap, w, st[RR_MISSING]);
    w = put_str(out, cap, w, RR_COUNT_TEXTS[3], RR_COUNT_LENS[3]);
    w = put_count(out, cap, w, st[K_BAD]);
    w = put_str(out, cap, w, " unreadable rows\n", 17);
    w = put_str(out, cap, w, RR_FLAG_HEAD, RR_FLAG_HEAD_LEN);
    var v : usize = RR_FALSE as usize;
    if (rows > 0) { v = req_red_flag(&st) as usize; }
    return put_str(out, cap, w, RR_FLAG_TEXTS[v], RR_FLAG_LENS[v]);
}

// ---- test helpers ----

/// #10563's required checks on 2026-10-19: the old check-linked-issue failure, its queued re-run,
/// and the three that passed.
fn t_10563(dst : []u8, cap : usize) -> usize {
    var x : usize = put_str(dst, cap, 0, "Issue Gate/check-linked-issue\t39151562346\tCOMPLETED\tFAILURE\n", 60);
    x = put_str(dst, cap, x, "Issue Gate/check-linked-issue\t39157315158\tQUEUED\t-\n", 51);
    x = put_str(dst, cap, x, "CI/validate\t11\tCOMPLETED\tSUCCESS\n", 33);
    x = put_str(dst, cap, x, "Parse/parse-ratchet\t12\tCOMPLETED\tSUCCESS\n", 41);
    return put_str(dst, cap, x, "Own/own-language\t13\tCOMPLETED\tSUCCESS\n", 38);
}

fn t_flag2(a : str, al : usize, b : str, bl : usize) -> u8 {
    var raw : [128]u8 = undefined;
    var x : usize = put_str(&raw, 128, 0, a, al);
    x = put_str(&raw, 128, x, b, bl);
    return required_flag(&raw, x);
}

// ---- tests ----

test the_10563_old_failure_next_to_its_rerun_is_not_req_red {
    var raw : [256]u8 = undefined;
    const n : usize = t_10563(&raw, 256);
    assert n == 223;
    var st : [5]u32 = undefined;
    assert required_counts(&raw, n, &st) == 5;
    assert st[K_PASS] == 3;
    assert st[K_FAIL] == 0;
    assert st[K_WAIT] == 1;
    assert st[K_BAD] == 0;
    assert st[RR_MISSING] == 0;
    assert required_flag(&raw, n) == RR_FALSE;
}

test the_10563_plan_text {
    var raw : [256]u8 = undefined;
    const n : usize = t_10563(&raw, 256);
    var out : [128]u8 = undefined;
    const w : usize = required_plan(&raw, n, &out, 128);
    assert w == 87;
    assert buf_has(&out, w, "R\trequired: 3 pass, 0 failing, 1 pending, 0 missing, 0 unreadable rows\n", 71) == true;
    assert buf_has(&out, w, "F\treq_red\tfalse\n", 16) == true;
}

test a_red_check_that_is_not_required_is_not_req_red {
    assert t_flag2("CI/validate\t11\tCOMPLETED\tSUCCESS\n", 33, "Claw/claw-sarif\t14\tCOMPLETED\tFAILURE\n", 37) == RR_FALSE;
}

test a_red_required_check_is_req_red {
    assert t_flag2("CI/validate\t15\tCOMPLETED\tFAILURE\n", 33, "Claw/claw-sarif\t14\tCOMPLETED\tFAILURE\n", 37) == RR_TRUE;
    assert t_flag2("own-language\t-\tCONTEXT\tERROR\n", 29, "CI/validate\t11\tCOMPLETED\tSUCCESS\n", 33) == RR_TRUE;
}

test a_queued_rerun_clears_a_red_required_check_in_any_order {
    assert t_flag2("CI/validate\t9\tCOMPLETED\tFAILURE\n", 32, "CI/validate\t10\tQUEUED\t-\n", 24) == RR_FALSE;
    assert t_flag2("CI/validate\t10\tQUEUED\t-\n", 24, "CI/validate\t9\tCOMPLETED\tFAILURE\n", 32) == RR_FALSE;
}

test the_job_name_must_match_exactly {
    assert t_flag2("X/validate-extra\t16\tCOMPLETED\tFAILURE\n", 38, "CI/validate\t11\tCOMPLETED\tSUCCESS\n", 33) == RR_FALSE;
    assert t_flag2("validate\t17\tCOMPLETED\tFAILURE\n", 30, "Claw/claw-sarif\t14\tCOMPLETED\tFAILURE\n", 37) == RR_TRUE;
    assert required_index("A/b/own-language", 0, 16) == 3;
    assert required_index("own-language/x", 0, 14) == RR_REQUIRED;
}

test an_unreadable_row_makes_it_unknown_and_a_known_red_still_wins {
    assert t_flag2("CI/validate\t1x\tCOMPLETED\tFAILURE\n", 33, "CI/validate\t11\tCOMPLETED\tSUCCESS\n", 33) == RR_UNKNOWN;
    assert t_flag2("CI/validate\t1x\tCOMPLETED\tFAILURE\n", 33, "CI/validate\t15\tCOMPLETED\tFAILURE\n", 33) == RR_TRUE;
}

test missing_required_checks_are_counted_and_are_not_red {
    var st : [5]u32 = undefined;
    assert required_counts("Claw/claw-sarif\t14\tCOMPLETED\tFAILURE\n", 37, &st) == 1;
    assert st[RR_MISSING] == 4;
    assert st[K_FAIL] == 0;
    assert required_flag("", 0) == RR_FALSE;
}

test a_clipped_plan_still_advances_the_cursor {
    var raw : [256]u8 = undefined;
    const n : usize = t_10563(&raw, 256);
    var out : [128]u8 = undefined;
    assert required_plan(&raw, n, &out, 40) == 87;
}

// The tests below were written against a mutation sweep of this file: each one fails under a
// mutant of required_counts that the earlier tests let through.

test a_blank_line_is_not_a_row {
    var raw : [128]u8 = undefined;
    var x : usize = put_str(&raw, 128, 0, "CI/validate\t11\tCOMPLETED\tSUCCESS\n\n", 34);
    x = put_str(&raw, 128, x, "Own/own-language\t13\tCOMPLETED\tSUCCESS\n", 38);
    var st : [5]u32 = undefined;
    assert required_counts(&raw, x, &st) == 2;
    assert st[K_PASS] == 2;
    assert st[K_BAD] == 0;
    assert required_flag(&raw, x) == RR_FALSE;
}

test negative_control_the_row_past_the_cap_is_unreadable_and_the_last_one_in_it_is_read {
    var raw : [40000]u8 = undefined;
    var st : [5]u32 = undefined;
    var x : usize = t_rows(&raw, 40000, 0, "Claw/claw-sarif\t14\tCOMPLETED\tSUCCESS\n", 37, 1023);
    x = put_str(&raw, 40000, x, "CI/validate\t11\tCOMPLETED\tSUCCESS\n", 33);
    assert required_counts(&raw, x, &st) == 1024;
    assert st[K_PASS] == 1;
    assert st[K_BAD] == 0;
    x = t_rows(&raw, 40000, 0, "Claw/claw-sarif\t14\tCOMPLETED\tSUCCESS\n", 37, 1024);
    x = put_str(&raw, 40000, x, "CI/validate\t11\tCOMPLETED\tSUCCESS\n", 33);
    assert x == 37921;
    assert required_counts(&raw, x, &st) == 1025;
    assert st[K_PASS] == 0;
    assert st[K_BAD] == 1;
    assert st[RR_MISSING] == 4;
    assert required_flag(&raw, x) == RR_UNKNOWN;
}
