// SPDX-License-Identifier: Apache-2.0
; specs/claw/reel_still.t27 -- reel_still, the TRI CLAW /mcp tool that renders one particle still.
; specs/claw/visual_output.t27 says a report's visual is one PNG frame of a token_floor reel taken at
; STILL_MS, rendered on the Railway lab, and that no MCP tool renders one yet. This spec is that tool:
; what it takes, what it refuses, and the exact lab recipe it runs.
; --
; Input (four fields): topic, lesson, lang, aspect.
; - topic "" or "token-floor" with lesson -1 is the physics reel (token_floor + token_floor_mux).
; - A lesson id from the t27-basics course ("what-a-spec-is", "the-module-line", ...; the ids are
;   specs/t27f/reel_topics.t27's, so this tool and the reels never disagree about a lesson) is that
;   lesson's reel (lesson_reel). The lesson index 0..TOPICS-1 names the same reel; giving both is
;   allowed only when they agree.
; - lang 0 en, 1 ru. aspect 0 tall (1080x1920), 1 wide (1920x1080); one PNG is one aspect, so the
;   "both" cut token_floor's TF_CUT also accepts is refused here.
; Output: one image/png, the frame the reel shows at STILL_MS.
; --
; The recipe renders one frame, not the reel. frame_shard splits a reel into n shards; with
; n = SCENE_FRAMES every shard is one frame, so TF_SHARD = still_frame(), TF_SHARDS = SCENE_FRAMES
; draws exactly frame still_frame() (the physics still steps from frame 0; only drawing is skipped).
; The overlays (captions, labels, voice and music, which the still does not need but the filter graph
; reads) are the reel's own filter graph: the one frame enters it with `-itsoffset still_s()`, so the
; graph sees it at the reel's STILL_MS and draws what the reel draws there. `[v]` goes to the PNG,
; `[a]` to null. Measured on the lab 2026-10-18, lesson 1 en tall: rc 0, 1660 ms, 484981 bytes.
; --
; It runs on the Railway lab only (owner rule 2026-10-09); a call anywhere else is refused, never
; rendered. The name has no t27_ or t27f_ prefix, so the one registry (specs/t27mcp/service.t27) homes
; it in TRI CLAW and mounts it as it is.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawReelStill;

use t27mcp::service::admit;
use t27mcp::service::home_of;
use t27mcp::service::name_ok;
use t27mcp::service::H_T27;
use t27mcp::service::H_TRI_CLAW;
use t27mcp::service::A_MOUNT;
use t27mcp::service::A_REFUSE_COLLISION;
use claw::visual_output::STILL_MS;
use claw::visual_output::still_ms_ok;
use t27f::token_floor_scenes::SCENE_FPS;
use t27f::token_floor_scenes::SCENE_FRAMES;
use t27f::frame_shard::first_of;
use t27f::frame_shard::end_of;
use t27f::reel_topics::TOPICS;
use t27f::reel_topics::id_item;
use t27f::reel_topics::item_len;
use t27f::reel_topics::cp;

/// The tool's name in TRI CLAW's /mcp.
pub const TOOL_NAME : str = "reel_still";
pub const MIME : str = "image/png";

/// The input fields, in the order the tool's schema lists them.
pub const INPUT_COUNT : u32 = 4;
pub const INPUT_NAMES : [4]str = ["topic", "lesson", "lang", "aspect"];

/// The physics reel's topic name, and the lesson field's "no lesson".
pub const PHYSICS_TOPIC : str = "token-floor";
pub const LESSON_NONE : i32 = -1;

/// Which reel a call resolves to.
pub const REEL_PHYSICS : i32 = -1;   // otherwise the lesson index 0..TOPICS-1
pub const REEL_NONE : i32 = -2;      // the call is refused

pub const LANG_EN : i32 = 0;
pub const LANG_RU : i32 = 1;
pub const LANG_NAMES : [2]str = ["en", "ru"];

/// The aspect is token_floor's TF_CUT value for that cut.
pub const ASPECT_TALL : i32 = 0;
pub const ASPECT_WIDE : i32 = 1;
pub const ASPECT_NAMES : [2]str = ["tall", "wide"];

/// What the tool answers.
pub const V_OK : u32 = 0;
pub const V_UNKNOWN_TOPIC : u32 = 1;
pub const V_BAD_LESSON : u32 = 2;
pub const V_DISAGREE : u32 = 3;
pub const V_BAD_LANG : u32 = 4;
pub const V_BAD_ASPECT : u32 = 5;
pub const V_NOT_ON_LAB : u32 = 6;

/// The file the still is written to: STILL_PREFIX id - lang - aspect STILL_EXT.
pub const STILL_PREFIX : str = "still-";
pub const STILL_EXT : str = ".png";

/// Whether lesson t's course id is s, code point by code point.
pub fn id_is(t: u32, s: str) -> bool {
    let i : usize = id_item(t as usize);
    let n : usize = item_len(i);
    if (n != s.len) { return false; }
    var k : usize = 0;
    while (k < n) {
        if ((s[k] as u32) != cp(i, k)) { return false; }
        k = k + 1;
    }
    return true;
}

/// The lesson whose id is s, or REEL_PHYSICS for the physics reel's names, or REEL_NONE.
pub fn topic_reel(s: str) -> i32 {
    if (s.len == 0 or s == PHYSICS_TOPIC) { return REEL_PHYSICS; }
    var t : u32 = 0;
    while (t < (TOPICS as u32)) {
        if (id_is(t, s)) { return t as i32; }
        t = t + 1;
    }
    return REEL_NONE;
}

/// Whether a lesson field is "none" or a lesson index.
pub fn lesson_ok(lesson: i32) -> bool {
    return lesson == LESSON_NONE or (lesson >= 0 and lesson < (TOPICS as i32));
}

/// The reel a call names: from topic, from lesson, or from both when they agree.
pub fn reel_of(topic: str, lesson: i32) -> i32 {
    if (lesson_ok(lesson) == false) { return REEL_NONE; }
    let by_topic : i32 = topic_reel(topic);
    if (by_topic == REEL_NONE) { return REEL_NONE; }
    if (lesson == LESSON_NONE) { return by_topic; }
    if (topic.len == 0) { return lesson; }
    if (by_topic == lesson) { return lesson; }
    return REEL_NONE;
}

/// The tool's verdict on a call; only V_OK renders.
pub fn verdict(topic: str, lesson: i32, lang: i32, aspect: i32, on_lab: bool) -> u32 {
    if (lesson_ok(lesson) == false) { return V_BAD_LESSON; }
    if (topic_reel(topic) == REEL_NONE) { return V_UNKNOWN_TOPIC; }
    if (reel_of(topic, lesson) == REEL_NONE) { return V_DISAGREE; }
    if (lang != LANG_EN and lang != LANG_RU) { return V_BAD_LANG; }
    if (aspect != ASPECT_TALL and aspect != ASPECT_WIDE) { return V_BAD_ASPECT; }
    if (on_lab == false) { return V_NOT_ON_LAB; }
    return V_OK;
}

/// The frame the reel shows at STILL_MS.
pub fn still_frame() -> i32 {
    return @divTrunc(STILL_MS * SCENE_FPS, 1000);
}

/// The renderer's environment for that one frame: TF_SHARD, TF_SHARDS, TF_CUT.
pub fn env_shard() -> i32 { return still_frame(); }
pub fn env_shards() -> i32 { return SCENE_FRAMES; }
pub fn env_cut(aspect: i32) -> i32 { return aspect; }

/// The frame's size and its rgb24 bytes, the length of the renderer's stream for one frame.
pub fn frame_w(aspect: i32) -> i32 {
    if (aspect == ASPECT_WIDE) { return 1920; }
    return 1080;
}
pub fn frame_h(aspect: i32) -> i32 {
    if (aspect == ASPECT_WIDE) { return 1080; }
    return 1920;
}
pub fn frame_bytes(aspect: i32) -> i32 {
    return frame_w(aspect) * frame_h(aspect) * 3;
}

/// The `-itsoffset` the one frame enters the reel's filter graph with, in whole seconds.
pub fn still_s() -> i32 {
    return @divTrunc(STILL_MS, 1000);
}

/// The still's file name length: prefix, id, "-", lang, "-", aspect, extension.
pub fn name_len(reel: i32, lang: i32, aspect: i32) -> usize {
    var id_n : usize = PHYSICS_TOPIC.len;
    if (reel >= 0) { id_n = item_len(id_item(reel as usize)); }
    return STILL_PREFIX.len + id_n + 1 + LANG_NAMES[lang as usize].len + 1 + ASPECT_NAMES[aspect as usize].len + STILL_EXT.len;
}

test the_tool_is_tri_claws_and_mounted_as_it_is {
    assert name_ok(TOOL_NAME);
    assert home_of(TOOL_NAME) == H_TRI_CLAW;
    assert admit(TOOL_NAME, H_TRI_CLAW) == A_MOUNT;
    assert INPUT_NAMES.len == INPUT_COUNT as usize;
}

test negative_control_under_a_t27f_name_it_would_be_refused {
    assert home_of("t27f_reel_still") == H_T27;
    assert admit("t27f_reel_still", H_TRI_CLAW) == A_REFUSE_COLLISION;
}

test a_topic_names_the_physics_reel_or_a_lesson {
    assert topic_reel("") == REEL_PHYSICS;
    assert topic_reel("token-floor") == REEL_PHYSICS;
    assert topic_reel("what-a-spec-is") == 0;
    assert topic_reel("the-module-line") == 1;
    assert topic_reel("constants") == 3;
}

test every_lesson_id_resolves_to_its_own_index {
    var t : u32 = 0;
    var hits : u32 = 0;
    while (t < (TOPICS as u32)) {
        let i : usize = id_item(t as usize);
        assert item_len(i) > 0;
        if (id_is(t, "what-a-spec-is")) { hits = hits + 1; }
        t = t + 1;
    }
    assert hits == 1;
    assert TOPICS == 27;
}

test negative_control_a_near_miss_topic_is_unknown {
    assert topic_reel("what-a-spec") == REEL_NONE;
    assert topic_reel("what-a-spec-is-") == REEL_NONE;
    assert topic_reel("What-a-spec-is") == REEL_NONE;
    assert topic_reel("token_floor") == REEL_NONE;
    assert id_is(0, "the-module-line") == false;
}

test topic_and_lesson_agree_or_the_call_is_refused {
    assert reel_of("", LESSON_NONE) == REEL_PHYSICS;
    assert reel_of("", 1) == 1;
    assert reel_of("the-module-line", LESSON_NONE) == 1;
    assert reel_of("the-module-line", 1) == 1;
    assert reel_of("the-module-line", 2) == REEL_NONE;
    assert reel_of("token-floor", 0) == REEL_NONE;
    assert reel_of("", 27) == REEL_NONE;
    assert reel_of("", -2) == REEL_NONE;
}

test the_verdict_names_what_is_wrong_first {
    assert verdict("the-module-line", LESSON_NONE, LANG_EN, ASPECT_TALL, true) == V_OK;
    assert verdict("", LESSON_NONE, LANG_RU, ASPECT_WIDE, true) == V_OK;
    assert verdict("nope", LESSON_NONE, LANG_EN, ASPECT_TALL, true) == V_UNKNOWN_TOPIC;
    assert verdict("", 40, LANG_EN, ASPECT_TALL, true) == V_BAD_LESSON;
    assert verdict("constants", 0, LANG_EN, ASPECT_TALL, true) == V_DISAGREE;
    assert verdict("", 0, 2, ASPECT_TALL, true) == V_BAD_LANG;
    assert verdict("", 0, LANG_EN, 2, true) == V_BAD_ASPECT;
    assert verdict("", 0, LANG_EN, -1, true) == V_BAD_ASPECT;
}

test negative_control_a_good_call_off_the_lab_is_refused_not_rendered {
    assert verdict("the-module-line", LESSON_NONE, LANG_EN, ASPECT_TALL, false) == V_NOT_ON_LAB;
    assert verdict("", LESSON_NONE, LANG_EN, ASPECT_WIDE, false) == V_NOT_ON_LAB;
}

test the_still_is_frame_270_of_450_and_the_rule_allows_it {
    assert still_frame() == 270;
    assert still_frame() < SCENE_FRAMES;
    assert SCENE_FPS == 30;
    assert still_ms_ok(STILL_MS);
    assert @rem(STILL_MS, 1000) == 0;
    assert still_s() * 1000 == STILL_MS;
}

test the_shard_env_draws_exactly_the_still_frame {
    assert first_of(env_shard(), env_shards(), SCENE_FRAMES) == still_frame();
    assert end_of(env_shard(), env_shards(), SCENE_FRAMES) == still_frame() + 1;
    assert env_cut(ASPECT_TALL) == 0;
    assert env_cut(ASPECT_WIDE) == 1;
}

test negative_control_a_halved_shard_count_renders_the_whole_reel {
    let half : i32 = @divTrunc(env_shards(), 2);
    assert first_of(env_shard(), half, SCENE_FRAMES) == 0;
    assert end_of(env_shard(), half, SCENE_FRAMES) == SCENE_FRAMES;
    assert first_of(env_shard(), 1, SCENE_FRAMES) == 0;
}

test one_frame_is_6220800_bytes_in_either_aspect {
    assert frame_w(ASPECT_TALL) == 1080;
    assert frame_h(ASPECT_TALL) == 1920;
    assert frame_w(ASPECT_WIDE) == 1920;
    assert frame_h(ASPECT_WIDE) == 1080;
    assert frame_bytes(ASPECT_TALL) == 6220800;
    assert frame_bytes(ASPECT_WIDE) == frame_bytes(ASPECT_TALL);
}

test the_file_name_is_prefix_id_lang_aspect {
    // still-what-a-spec-is-en-tall.png
    assert name_len(0, LANG_EN, ASPECT_TALL) == 32;
    // still-token-floor-ru-wide.png
    assert name_len(REEL_PHYSICS, LANG_RU, ASPECT_WIDE) == 29;
    assert name_len(1, LANG_EN, ASPECT_TALL) != name_len(0, LANG_EN, ASPECT_TALL);
}
