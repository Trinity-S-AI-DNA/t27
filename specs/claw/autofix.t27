// SPDX-License-Identifier: Apache-2.0
; specs/claw/autofix.t27 -- TRI CLAW autofix (epic #9271, owner instruction 2026-10-12: "lift the
; CI/CD routine off the user; all the experience from the related repos; everything through
; .t27 / t27c / t27b / t27o", translated). A red gate is routine when its fix is known, mechanical
; and verifiable; this spec is the table that says which is which. The runner that applies a row
; is plumbing; the knowledge lives here.
; --
; What is LOGIC and where it lives:
; - Which gates exist: specs/claw/gates.t27 (SSOT). This file names gates; it never re-counts them.
; - What a fix DOES: the action vocabulary below -- each action is a named procedure whose steps
;   the runner executes and then re-runs the failing gate to verify (a fix is not done until the
;   gate it fixes is green; an unverifiable fix is not applied).
; - Risk classes decide who acts: SAFE rows are applied by the loop without a person; REVIEW rows
;   get a prepared patch and a report; OWNER rows are never touched automatically -- foreign code
;   (cli/t27b Rust), protected files, pricing and the App click sit there.
; --
; The honest limit: the table knows the failures the loops have actually met. A red whose
; signature is not in a row is A_MANUAL by default -- fail closed, report, do not guess.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY
module ClawAutofix;

pub const A_MANUAL : u8 = 0;
pub const A_REGEN_MATRIX : u8 = 1;
pub const A_LOWER_CEILING : u8 = 2;
pub const A_RESHAPE_BODY : u8 = 3;
pub const A_BLESS_LEDGER : u8 = 4;
pub const A_SPEC_FIRST : u8 = 5;
pub const A_REBASE : u8 = 6;
pub const A_TRACK : u8 = 7;
pub const A_REGEN_TOPOLOGY : u8 = 8;

pub const R_SAFE : u8 = 0;
pub const R_REVIEW : u8 = 1;
pub const R_OWNER : u8 = 2;

/// The row count and the table. Gate names are the workflow names in specs/claw/gates.t27;
/// "any" is the fallback row every unknown gate resolves to.
pub const COUNT : u32 = 12;

pub const GATES : [12]str = [
    "any", "matrix-drift", "Documented t27c subcommands exist", "duplicate-bodies",
    "Corpus ratchet (expected-failure ledger)", "own-language", "Conflict markers",
    "loop-tools-tracked", "gate-topology", "coverage", "cli-tri", "claw",
];

pub const ACTIONS : [12]u8 = [
    A_MANUAL, A_REGEN_MATRIX, A_LOWER_CEILING, A_RESHAPE_BODY,
    A_BLESS_LEDGER, A_SPEC_FIRST, A_REBASE, A_TRACK,
    A_REGEN_TOPOLOGY, A_REGEN_TOPOLOGY, A_MANUAL, A_REGEN_MATRIX,
];

/// Every gate this table names must exist in the gate inventory (specs/claw/gates.t27),
/// except "any". The check is a named list here because the inventory itself cannot be
/// imported; the same-commit rule keeps them in step: adding a workflow regenerates the
/// inventory, and the inventory's own tests catch the drift.
pub const INVENTORY_NAMES : [11]str = [
    "matrix-drift", "Documented t27c subcommands exist", "duplicate-bodies",
    "Corpus ratchet (expected-failure ledger)", "own-language", "Conflict markers",
    "loop-tools-tracked", "gate-topology", "coverage", "cli-tri", "claw",
];

fn same_name(a : str, b : str) -> bool {
    var mismatches : u32 = 0;
    var i : usize = 0;
    var span : usize = a.len;
    if (b.len < span) { span = b.len; }
    while (i < span) {
        if (a[i] != b[i]) { mismatches += 1; }
        i += 1;
    }
    if (a.len != b.len) { mismatches += 1; }
    return mismatches == 0;
}

/// The row a gate resolves to. Unknown gate -> 0 ("any"), never a wrong recipe.
pub fn row_of(gate : str) -> i32 {
    var i : usize = 1;
    while (i < COUNT) {
        if (same_name(GATES[i], gate)) { return (i) as i32; }
        i += 1;
    }
    return 0;
}

pub fn action_of(gate : str) -> u8 {
    const r = row_of(gate);
    return ACTIONS[(r) as usize];
}

/// Who acts. Regeneration, ceiling-lowering, rebase and tracking are mechanical and verified by
/// the gate itself. Reshaping a body and blessing a ledger change what the ratchets compare, so
; they wait for a person's intent. Foreign code and anything behind cli-tri are the owner's.
pub fn risk_of(action : u8) -> u8 {
    if (action == A_REGEN_MATRIX) { return R_SAFE; }
    if (action == A_LOWER_CEILING) { return R_SAFE; }
    if (action == A_REBASE) { return R_SAFE; }
    if (action == A_TRACK) { return R_SAFE; }
    if (action == A_RESHAPE_BODY) { return R_REVIEW; }
    if (action == A_BLESS_LEDGER) { return R_REVIEW; }
    if (action == A_SPEC_FIRST) { return R_REVIEW; }
    if (action == A_REGEN_TOPOLOGY) { return R_SAFE; }
    return R_OWNER;
}

/// The tool the runner drives for an action. owner = no tool acts, the report names the person.
pub fn tool_of(action : u8) -> str {
    if (action == A_REGEN_MATRIX) { return "tri"; }
    if (action == A_LOWER_CEILING) { return "t27c"; }
    if (action == A_RESHAPE_BODY) { return "tri"; }
    if (action == A_BLESS_LEDGER) { return "tri"; }
    if (action == A_SPEC_FIRST) { return "t27c"; }
    if (action == A_REBASE) { return "git"; }
    if (action == A_TRACK) { return "git"; }
    if (action == A_REGEN_TOPOLOGY) { return "t27c"; }
    return "owner";
}

/// The recipe a report prints for an action. Prose is data: one line per action, kept next to
/// the action it describes.
pub fn recipe_of(action : u8) -> str {
    if (action == A_REGEN_MATRIX) { return "regenerate the gate matrix from the workflows directory, same commit as the workflow change"; }
    if (action == A_LOWER_CEILING) { return "a tri command resolved: lower the dead-mention ceiling constant in the same commit"; }
    if (action == A_RESHAPE_BODY) { return "reuse the body that exists or restructure this one; do not copy"; }
    if (action == A_BLESS_LEDGER) { return "if the duplicate or conflict is deliberate, move the ledger in the same commit; otherwise fix forward"; }
    if (action == A_SPEC_FIRST) { return "move the logic into a .t27 spec and generate the file; machinery an outside parser reads goes through the exceptions-plus-label pattern"; }
    if (action == A_REBASE) { return "fetch, rebase onto the base, force-with-lease your own branch"; }
    if (action == A_TRACK) { return "a loop helper must live in the repository, not only on the workstation"; }
    if (action == A_REGEN_TOPOLOGY) { return "regenerate the topology artifact from its spec; never hand-edit generated files"; }
    return "no automatic fix: report the failure with its signature";
}

test unknown_gate_falls_back_to_manual_and_owner {
    assert(row_of("no-such-gate") == 0);
    assert(action_of("no-such-gate") == A_MANUAL);
    assert(risk_of(action_of("no-such-gate")) == R_OWNER);
    assert(tool_of(A_MANUAL) == "owner");
}

test every_row_resolves_and_actions_are_known {
    var i : usize = 0;
    var known : u32 = 0;
    var resolved : u32 = 0;
    while (i < COUNT) {
        if (action_of(GATES[i]) == ACTIONS[i]) { resolved += 1; }
        if (ACTIONS[i] <= A_REGEN_TOPOLOGY) { known += 1; }
        i += 1;
    }
    assert(resolved == COUNT);
    assert(known == COUNT);
}

test real_failures_route_to_their_recorded_fixes {
    assert(action_of("matrix-drift") == A_REGEN_MATRIX);
    assert(risk_of(A_REGEN_MATRIX) == R_SAFE);
    assert(action_of("claw") == A_REGEN_MATRIX);
    assert(action_of("Documented t27c subcommands exist") == A_LOWER_CEILING);
    assert(action_of("duplicate-bodies") == A_RESHAPE_BODY);
    assert(action_of("own-language") == A_SPEC_FIRST);
    assert(action_of("Conflict markers") == A_REBASE);
    assert(action_of("loop-tools-tracked") == A_TRACK);
    assert(action_of("gate-topology") == A_REGEN_TOPOLOGY);
    assert(action_of("coverage") == A_REGEN_TOPOLOGY);
    assert(action_of("cli-tri") == A_MANUAL);
    assert(risk_of(action_of("cli-tri")) == R_OWNER);
}

test inventory_names_are_rows_and_distinct_from_the_fallback {
    var i : usize = 0;
    var live : u32 = 0;
    var fallback : u32 = 0;
    while (i < 11) {
        const r = row_of(INVENTORY_NAMES[i]);
        if (r != 0) { live += 1; }
        if (same_name(INVENTORY_NAMES[i], "any")) { fallback += 1; }
        i += 1;
    }
    assert(live == 11);
    assert(fallback == 0);
}

test risk_classes_partition_every_action {
    var a : u8 = 0;
    var classified : u32 = 0;
    while (a <= A_REGEN_TOPOLOGY) {
        const r = risk_of(a);
        if (r == R_SAFE or r == R_REVIEW or r == R_OWNER) { classified += 1; }
        a += 1;
    }
    assert(classified == A_REGEN_TOPOLOGY + 1);
}

test tools_and_recipes_exist_for_every_action {
    var a : u8 = 1;
    var tools : u32 = 0;
    var recipes : u32 = 0;
    while (a <= A_REGEN_TOPOLOGY) {
        if (tool_of(a).len > 0) { tools += 1; }
        if (recipe_of(a).len > 10) { recipes += 1; }
        a += 1;
    }
    assert(tools == A_REGEN_TOPOLOGY);
    assert(recipes == A_REGEN_TOPOLOGY);
}

test safe_actions_are_the_mechanical_ones {
    assert(risk_of(A_RESHAPE_BODY) == R_REVIEW);
    assert(risk_of(A_BLESS_LEDGER) == R_REVIEW);
    assert(risk_of(A_SPEC_FIRST) == R_REVIEW);
    assert(risk_of(A_REBASE) == R_SAFE);
    assert(risk_of(A_TRACK) == R_SAFE);
}
