// SPDX-License-Identifier: Apache-2.0
; specs/claw/text.t27 -- the byte-text helpers the TRI CLAW specs share, written once (#10317).
; Before this file gates.t27 and sarif.t27 each carried put_str, digit_byte, put_count and
; buf_has; gates.t27 and suggest.t27 each carried str_eq; service.t27 and preview.t27 each carried
; a prefix test; sarif_pins.t27 carried a byte-equality loop. tools/dupe_scan.py counted them as
; copies of the same bodies (#10311), and sarif.t27 said it copied them "because this file must
; lower alone". It lowers alone still: `use claw::text;` is spliced in by use_resolve before every
; backend (gen-c, gen-rust, gen) runs, so the importer's C holds the helpers it names and nothing
; else, and no hand-written second copy is needed.
; --
; Every string here is COUNTED: the length rides along as a parameter, never read as `.len`,
; because gen-c lowers str to const char* and cannot express `.len` (the specs/claw/gates.t27
; idiom). That is also why this file lowers under gen-c on its own. A caller that holds a literal
; passes its length; a caller in a zig-runner-only spec may pass `s.len`.
; --
; The writers share one contract with the gen/c/policy write idiom: a write returns the new
; cursor, a clipped write still advances the cursor, only the bytes past cap are dropped, so the
; caller detects truncation by comparing the final cursor with cap.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawText;

/// Copy s_len bytes of s into dst at w, clipped at cap, and return the new write cursor -- the
/// gen/c/policy write idiom: a clipped write still advances the cursor so the caller's arithmetic
/// stays honest, only the bytes past cap are dropped.
pub fn put_str(dst : []u8, cap : usize, w : usize, s : str, s_len : usize) -> usize {
    var i : usize = 0;
    while (i < s_len) {
        if (w + i < cap) { dst[w + i] = s[i]; }
        i += 1;
    }
    return w + s_len;
}

pub fn digit_byte(d : u32) -> u8 {
    var b : u8 = '0';
    if (d == 1) { b = '1'; }
    if (d == 2) { b = '2'; }
    if (d == 3) { b = '3'; }
    if (d == 4) { b = '4'; }
    if (d == 5) { b = '5'; }
    if (d == 6) { b = '6'; }
    if (d == 7) { b = '7'; }
    if (d == 8) { b = '8'; }
    if (d == 9) { b = '9'; }
    return b;
}

/// Decimal digits of a count, into the out buffer, snprintf-style. Written with digit_byte rather
/// than '0' + digit because the gen-c backend lowers str to const char* and a u8 arithmetic
/// assignment has no precedent to lean on; every construct here is one gates.t27 already lowers.
pub fn put_count(dst : []u8, cap : usize, w : usize, v : u32) -> usize {
    var tmp : [16]u8 = undefined;
    var n : usize = 0;
    var x : u32 = v;
    if (x == 0) {
        tmp[0] = digit_byte(0);
        n = 1;
    }
    while (x > 0) {
        tmp[n] = digit_byte(x % 10);
        n += 1;
        x = x / 10;
    }
    var k : usize = 0;
    while (k < n) {
        if (w + k < cap) { dst[w + k] = tmp[n - 1 - k]; }
        k += 1;
    }
    return w + n;
}

/// Byte-scan of a written buffer for a needle -- the same loop as line_eq_name, over the whole
/// report instead of one line.
pub fn buf_has(buf : []const u8, buf_len : usize, needle : str, needle_len : usize) -> bool {
    if (needle_len > buf_len) { return false; }
    var start : usize = 0;
    while (start + needle_len <= buf_len) {
        var k : usize = 0;
        var diff : usize = 0;
        while (k < needle_len) {
            if (buf[start + k] != needle[k]) { diff += 1; }
            k += 1;
        }
        if (diff == 0) { return true; }
        start += 1;
    }
    return false;
}

/// Byte equality for two counted strings -- the same loop as affected.t27's `same`. `==` on str
/// does not lower element-to-element, and `.len` does not lower under gen-c at all, so both
/// lengths ride along as parameters.
pub fn str_eq(a : str, alen : usize, b : str, blen : usize) -> bool {
    if (alen != blen) { return false; }
    var diff : usize = 0;
    var i : usize = 0;
    while (i < alen) {
        if (a[i] != b[i]) { diff += 1; }
        i += 1;
    }
    return diff == 0;
}

/// Does s start with p? Both counted. A prefix longer than the string is never a prefix, and the
/// empty prefix is a prefix of everything.
pub fn has_prefix(s : str, s_len : usize, p : str, p_len : usize) -> bool {
    if (s_len < p_len) { return false; }
    var i : usize = 0;
    while (i < p_len) {
        if (s[i] != p[i]) { return false; }
        i += 1;
    }
    return true;
}

test digit_byte_is_the_ascii_digit {
    assert digit_byte(0) == '0';
    assert digit_byte(7) == '7';
    assert digit_byte(9) == '9';
}

test put_str_copies_and_returns_the_cursor {
    var out : [16]u8 = undefined;
    var w : usize = put_str(&out, 16, 0, "abc", 3);
    assert w == 3;
    w = put_str(&out, 16, w, "de", 2);
    assert w == 5;
    assert buf_has(&out, w, "abcde", 5) == true;
    assert buf_has(&out, w, "abcdf", 5) == false;
}

test put_str_clipped_write_still_advances_the_cursor {
    var out : [4]u8 = undefined;
    var w : usize = put_str(&out, 4, 0, "abcdef", 6);
    // The cursor says six bytes were asked for; only four fit, and the caller can tell.
    assert w == 6;
    assert buf_has(&out, 4, "abcd", 4) == true;
}

test put_count_writes_decimal_digits {
    var out : [16]u8 = undefined;
    var w : usize = put_count(&out, 16, 0, 0);
    assert w == 1;
    assert buf_has(&out, w, "0", 1) == true;
    w = put_count(&out, 16, 0, 7);
    assert w == 1;
    assert buf_has(&out, w, "7", 1) == true;
    w = put_count(&out, 16, 0, 1050);
    assert w == 4;
    assert buf_has(&out, w, "1050", 4) == true;
    assert buf_has(&out, w, "1051", 4) == false;
}

test buf_has_scans_every_start_and_rejects_a_long_needle {
    var out : [16]u8 = undefined;
    var w : usize = put_str(&out, 16, 0, "n=62 n=3", 8);
    assert buf_has(&out, w, "n=62", 4) == true;
    assert buf_has(&out, w, "n=3", 3) == true;
    assert buf_has(&out, w, "n=63", 4) == false;
    assert buf_has(&out, w, "n=62 n=3 more", 13) == false;
}

test str_eq_tells_equal_from_different {
    assert str_eq("abc", 3, "abc", 3) == true;
    assert str_eq("abc", 3, "abd", 3) == false;
    assert str_eq("abc", 3, "ab", 2) == false;
    assert str_eq("", 0, "", 0) == true;
}

test has_prefix_matches_and_rejects {
    assert has_prefix("claw-v0.1.0", 11, "claw-v", 6) == true;
    assert has_prefix("v0.1", 4, "claw-v", 6) == false;
    assert has_prefix("claw", 4, "claw-v", 6) == false;
    assert has_prefix("", 0, "claw-v", 6) == false;
    assert has_prefix("anything", 8, "", 0) == true;
}
