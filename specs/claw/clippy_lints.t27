// SPDX-License-Identifier: Apache-2.0
// specs/claw/clippy_lints.t27 -- t27c gen-rust: generated Rust trips 8 clippy
// lints and unused_parens.
// Part of M2 milestone (milestone #6). Closes #13381.
// phi^2 + 1/phi^2 = 3 | TRINITY

module claw::clippy_lints;

pub const CLAW_CLIPPY_LINTS_MAX : u32 = 128;

pub struct ClippyLint { name: str, fixed: bool };

pub fn clippy_lint_fixed(l: ClippyLint) -> bool {
    return l.fixed;
}

test "clippy_lint_fixed" {
    assert(clippy_lint_fixed(ClippyLint { name: "unused_parens", fixed: true }));
    assert(!clippy_lint_fixed(ClippyLint { name: "unused_parens", fixed: false }));
}

invariant claw_clippy_lints_max_positive {
    assert CLAW_CLIPPY_LINTS_MAX > 0;
}