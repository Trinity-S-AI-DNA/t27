// SPDX-License-Identifier: Apache-2.0
; specs/claw/goal_exit_gate.t27 -- the hard exit gate for a /goal: the agent does not exit
; until every linked epic is 100% done AND released (owner directive 2026-11-05).
; --
; The problem this solves: without a hard gate, an agent reaches partial progress
; ("22 PRs merged, rest are author-owned") and exits, leaving the goal incomplete.
; The exit gate is a conjunctive rule: EVERY epic must pass BOTH the done check
; (labeled `epic-done` on the GitHub issue) AND the release check (a merged PR
; carries the epic's work to master). No partial exits, no exemptions, no fallback.
; --
; How it works: the /goal names a list of epics (issue numbers). At every round,
; the agent classifies each epic: EPIC_DONE (labeled + released), EPIC_ACTIVE
; (open, work in flight), EPIC_BLOCKED (open, waiting on an external fix).
; The exit gate opens only when every epic is EPIC_DONE. If any epic is ACTIVE
; or BLOCKED, the agent stays in the goal and keeps working (or requesting fixes
; from the owners of foreign blockers).
; --
; The honest limits: this module reads structured inputs (issue numbers, label
; flags, release hashes) supplied by the caller. It does NOT call GitHub -- the
; caller (cron or agent) reads the issue state and feeds the results here. It
; also does NOT define what "release" means for a given epic -- the release
; criteria are per-epic and set when the /goal is created.
; --
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawGoalExitGate;

use claw::text;

/// Epic states.
pub const EPIC_DONE : u8 = 0;
pub const EPIC_ACTIVE : u8 = 1;
pub const EPIC_BLOCKED : u8 = 2;
pub const EPIC_UNKNOWN : u8 = 3;

/// Exit gate verdict.
pub const GATE_OPEN : u8 = 0;
pub const GATE_HELD : u8 = 1;

/// The exit gate: opens only when every epic is EPIC_DONE.
/// epic_states is an array of u8 states, one per linked epic.
/// Returns GATE_OPEN if all are EPIC_DONE, GATE_HELD otherwise.
pub fn exit_gate(epic_states : []const u8, count : usize) -> u8 {
    var i : usize = 0;
    while (i < count) {
        if (epic_states[i] != EPIC_DONE) { return GATE_HELD; }
        i += 1;
    }
    return GATE_OPEN;
}

/// Count of epics not yet done -- the number the agent must still drive to completion.
pub fn epics_remaining(epic_states : []const u8, count : usize) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < count) {
        if (epic_states[i] != EPIC_DONE) { n += 1; }
        i += 1;
    }
    return n;
}

/// An epic is DONE only when: the issue is labeled `epic-done` AND a merged PR
/// carries the epic's work to master. Both conditions are supplied by the caller;
/// this function just combines them.
pub fn epic_is_done(labeled_epic_done : bool, release_merged : bool) -> bool {
    return labeled_epic_done and release_merged;
}

/// A blocked epic needs a foreign fix: record the blocking issue number and
/// classify per blocker_attribution.t27 (OWN / SHARED / FOREIGN / UNSEEN).
pub const B_OWN : u8 = 0;
pub const B_SHARED : u8 = 1;
pub const B_FOREIGN : u8 = 2;
pub const B_UNSEEN : u8 = 3;

/// The next action the agent must take for each non-done epic.
pub const NEXT_WORK : u8 = 0;
pub const NEXT_HOLD : u8 = 1;

/// Given a blocked epic's blocker class, what does the agent do?
/// WORK: the agent can fix it now (OWN blocker).
/// HOLD: the agent must wait for a foreign fix (SHARED / FOREIGN / UNSEEN).
pub fn next_action(blocker_class : u8) -> u8 {
    if (blocker_class == B_OWN) { return NEXT_WORK; }
    return NEXT_HOLD;
}

invariant the_gate_is_conjunctive {
    // One not-done epic holds the gate, no matter how many are done.
    var states : [2]u8 = [EPIC_DONE, EPIC_ACTIVE];
    assert exit_gate(&states, 2) == GATE_HELD;
    var all_done : [3]u8 = [EPIC_DONE, EPIC_DONE, EPIC_DONE];
    assert exit_gate(&all_done, 3) == GATE_OPEN;
    var none_done : [1]u8 = [EPIC_BLOCKED];
    assert exit_gate(&none_done, 1) == GATE_HELD;
}

invariant epic_done_requires_both {
    assert epic_is_done(true, true) == true;
    assert epic_is_done(true, false) == false;
    assert epic_is_done(false, true) == false;
    assert epic_is_done(false, false) == false;
}

test a_goal_with_two_active_epics_is_held {
    var states : [2]u8 = [EPIC_ACTIVE, EPIC_ACTIVE];
    assert exit_gate(&states, 2) == GATE_HELD;
    assert epics_remaining(&states, 2) == 2;
}

test a_goal_with_one_active_one_done_is_held {
    var states : [2]u8 = [EPIC_DONE, EPIC_ACTIVE];
    assert exit_gate(&states, 2) == GATE_HELD;
    assert epics_remaining(&states, 2) == 1;
}

test a_goal_with_all_done_is_open {
    var states : [3]u8 = [EPIC_DONE, EPIC_DONE, EPIC_DONE];
    assert exit_gate(&states, 3) == GATE_OPEN;
    assert epics_remaining(&states, 3) == 0;
}

test an_empty_goal_is_open {
    var states : [1]u8 = [EPIC_DONE];
    assert exit_gate(&states, 0) == GATE_OPEN;
    assert epics_remaining(&states, 0) == 0;
}

test unknown_epic_holds_the_gate {
    var states : [2]u8 = [EPIC_DONE, EPIC_UNKNOWN];
    assert exit_gate(&states, 2) == GATE_HELD;
    assert epics_remaining(&states, 2) == 1;
}

test own_blocker_means_work_foreign_means_hold {
    assert next_action(B_OWN) == NEXT_WORK;
    assert next_action(B_SHARED) == NEXT_HOLD;
    assert next_action(B_FOREIGN) == NEXT_HOLD;
    assert next_action(B_UNSEEN) == NEXT_HOLD;
}
