// SPDX-License-Identifier: Apache-2.0
; specs/claw/cursor_route.t27 -- which model a Cursor session may start.
; Cursor is a different host from Claude Code and from a T27 OS pane. Those stay
; specs/claw/model_route.t27 (pane, then Sonnet 5.5, then Opus 5.5) and
; specs/claw/cost_policy.t27 (provider route). This module never picks a Claude
; tier and never edits those files.
; Owner contract 2026-11-10 (see #13536). A cheap task starts on composer-2.5.
; grok-4.7 is the escalation, and the start for architecture, a CRM contract, a
; multi-file refactor, and a repeated failure. Fast variants and a window above
; 256k are not defaults. A third-party model id is never a default.
; Prices below are Cursor list prices dated 2026-11-10, in integer micro-USD per
; 1_000_000 tokens. They are not a measured bill for this repository.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawCursorRoute;

; --- models: a lower number is not "stronger"; the pair is the only default ---
pub const M_COMPOSER : u32 = 1;
pub const M_GROK : u32 = 2;
pub const M_COMPOSER_FAST : u32 = 3;
pub const M_GROK_FAST : u32 = 4;
pub const M_GROK_500K : u32 = 5;
pub const M_OTHER : u32 = 6;

; --- tasks --------------------------------------------------------------------
pub const TK_PARSE : u32 = 1;
pub const TK_TEST : u32 = 2;
pub const TK_SMALL_T27 : u32 = 3;
pub const TK_SCREENSHOT : u32 = 4;
pub const TK_VISUAL : u32 = 5;
pub const TK_LIVE_GRAPH : u32 = 6;
pub const TK_UI_KIT : u32 = 7;
pub const TK_CRM : u32 = 8;
pub const TK_ARCH : u32 = 9;
pub const TK_REFACTOR : u32 = 10;
pub const TK_REPEATED : u32 = 11;
pub const TK_CHEAP_LAST : u32 = 7;
pub const TK_KNOWN_LAST : u32 = 11;

; --- budgets ------------------------------------------------------------------
pub const MAX_PARALLEL : u32 = 3;
pub const MAX_FILES : u32 = 8;
pub const MAX_RETRY : u32 = 2;
pub const ESCALATE_AFTER : u32 = 2;
pub const CONTEXT_K_CAP : u32 = 256;
pub const REQUIRE_COST_REPORT : bool = true;

; --- list prices, micro-USD per 1_000_000 tokens, Cursor docs 2026-11-10 ------
pub const PRICE_ASOF : u32 = 20261110;
pub const PER_M : u64 = 1000000;
pub const P_COMPOSER_IN : u64 = 500000;
pub const P_COMPOSER_CACHE : u64 = 200000;
pub const P_COMPOSER_OUT : u64 = 2500000;
pub const P_COMPOSER_FAST_IN : u64 = 3000000;
pub const P_COMPOSER_FAST_CACHE : u64 = 500000;
pub const P_COMPOSER_FAST_OUT : u64 = 15000000;
pub const P_GROK_IN : u64 = 2000000;
pub const P_GROK_CACHE : u64 = 500000;
pub const P_GROK_OUT : u64 = 6000000;
pub const P_GROK_FAST_IN : u64 = 4000000;
pub const P_GROK_FAST_CACHE : u64 = 1000000;
pub const P_GROK_FAST_OUT : u64 = 12000000;

; --- report bits; a report is complete only when every bit is present ---------
pub const RF_MODEL : u32 = 1;
pub const RF_INPUT : u32 = 2;
pub const RF_CACHED : u32 = 4;
pub const RF_OUTPUT : u32 = 8;
pub const RF_COST : u32 = 16;
pub const RF_SUBAGENTS : u32 = 32;
pub const RF_LANES : u32 = 64;
pub const RF_ESCALATIONS : u32 = 128;
pub const RF_REQUIRED : u32 = 255;

fn cr_eq(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    for i in 0..a.len {
        if (a[i] != b[i]) { return false; }
    }
    return true;
}

/// Published model id. Empty when the code is not one of the six.
pub fn cursor_model_name(model: u32) -> []const u8 {
    if (model == M_COMPOSER) { return "composer-2.5"; }
    if (model == M_GROK) { return "grok-4.7"; }
    if (model == M_COMPOSER_FAST) { return "composer-2.5-fast"; }
    if (model == M_GROK_FAST) { return "grok-4.7-fast"; }
    if (model == M_GROK_500K) { return "grok-4.7-500k"; }
    return "";
}

/// composer-2.5 or grok-4.7. Fast folds into its family. Anything else is other.
pub fn cursor_family(model: u32) -> u32 {
    if (model == M_COMPOSER or model == M_COMPOSER_FAST) { return M_COMPOSER; }
    if (model == M_GROK or model == M_GROK_FAST or model == M_GROK_500K) { return M_GROK; }
    return M_OTHER;
}

/// A known cheap task starts on Composer. A dear task, and any unknown id, starts
/// on Grok (fail closed).
pub fn cursor_base(task: u32) -> u32 {
    if (task >= TK_PARSE and task <= TK_CHEAP_LAST) { return M_COMPOSER; }
    return M_GROK;
}

/// The model a Cursor session starts. A cheap task stays on Composer for 0 and 1
/// failures and moves to Grok at 2. A Grok task never drops to Composer.
pub fn cursor_pick(task: u32, failed_attempts: u32) -> u32 {
    if (cursor_base(task) == M_GROK) { return M_GROK; }
    if (failed_attempts >= ESCALATE_AFTER) { return M_GROK; }
    return M_COMPOSER;
}

/// Composer and Grok are always allowed. Fast and 500k need an explicit reason.
/// Any other id, including a third-party model, is refused.
pub fn cursor_allowed(model: u32, reason_flag: bool) -> bool {
    if (model == M_COMPOSER or model == M_GROK) { return true; }
    if (reason_flag) {
        if (model == M_COMPOSER_FAST or model == M_GROK_FAST or model == M_GROK_500K) {
            return true;
        }
    }
    return false;
}

/// True when the choice spends the wrong family, or uses Fast, 500k, or a
/// third-party id without the reason flag.
pub fn cursor_waste(task: u32, model: u32, failed_attempts: u32, reason_flag: bool) -> bool {
    if (!cursor_allowed(model, reason_flag)) { return true; }
    if (cursor_family(model) != cursor_pick(task, failed_attempts)) { return true; }
    return false;
}

pub fn cursor_over_parallel(n: u32) -> bool {
    return n > MAX_PARALLEL;
}

pub fn cursor_over_files(n: u32) -> bool {
    return n > MAX_FILES;
}

pub fn cursor_over_retry(n: u32) -> bool {
    return n > MAX_RETRY;
}

/// 256k is inside the cap. Above it needs an explicit reason.
pub fn cursor_context_ok(k_tokens: u32, reason_flag: bool) -> bool {
    if (k_tokens <= CONTEXT_K_CAP) { return true; }
    return reason_flag;
}

fn cr_part(tokens: u64, rate: u64) -> u64 {
    const whole : u64 = tokens / PER_M;
    const rem : u64 = tokens % PER_M;
    return whole * rate + rem * rate / PER_M;
}

fn cr_rates(model: u32, which: u32) -> u64 {
    if (model == M_COMPOSER) {
        if (which == 0) { return P_COMPOSER_IN; }
        if (which == 1) { return P_COMPOSER_CACHE; }
        return P_COMPOSER_OUT;
    }
    if (model == M_COMPOSER_FAST) {
        if (which == 0) { return P_COMPOSER_FAST_IN; }
        if (which == 1) { return P_COMPOSER_FAST_CACHE; }
        return P_COMPOSER_FAST_OUT;
    }
    if (model == M_GROK) {
        if (which == 0) { return P_GROK_IN; }
        if (which == 1) { return P_GROK_CACHE; }
        return P_GROK_OUT;
    }
    if (model == M_GROK_FAST or model == M_GROK_500K) {
        if (which == 0) { return P_GROK_FAST_IN; }
        if (which == 1) { return P_GROK_FAST_CACHE; }
        return P_GROK_FAST_OUT;
    }
    return 0;
}

/// micro-USD for three independent counts: input, cache-read, output.
/// An unknown model prices at 0. Cached tokens are not subtracted from input.
pub fn cursor_cost_micro(model: u32, tok_in: u64, tok_cached: u64, tok_out: u64) -> u64 {
    const a : u64 = cr_part(tok_in, cr_rates(model, 0));
    const b : u64 = cr_part(tok_cached, cr_rates(model, 1));
    const c : u64 = cr_part(tok_out, cr_rates(model, 2));
    return a + b + c;
}

/// True only when model, input, cached, output, cost, subagents, lanes, and
/// escalations are all present.
pub fn cursor_report_ok(present: u32) -> bool {
    return (present & RF_REQUIRED) == RF_REQUIRED;
}

test cheap_tasks_start_on_composer {
    assert cursor_pick(TK_PARSE, 0) == M_COMPOSER;
    assert cursor_pick(TK_TEST, 0) == M_COMPOSER;
    assert cursor_pick(TK_SMALL_T27, 0) == M_COMPOSER;
    assert cursor_pick(TK_SCREENSHOT, 1) == M_COMPOSER;
    assert cursor_pick(TK_VISUAL, 1) == M_COMPOSER;
    assert cursor_pick(TK_LIVE_GRAPH, 0) == M_COMPOSER;
    assert cursor_pick(TK_UI_KIT, 1) == M_COMPOSER;
    assert cursor_base(TK_PARSE) == M_COMPOSER;
}

test two_failures_escalate_and_a_dear_task_never_drops {
    assert cursor_pick(TK_PARSE, 2) == M_GROK;
    assert cursor_pick(TK_TEST, 3) == M_GROK;
    assert cursor_pick(TK_SMALL_T27, 9) == M_GROK;
    assert cursor_pick(TK_CRM, 0) == M_GROK;
    assert cursor_pick(TK_ARCH, 0) == M_GROK;
    assert cursor_pick(TK_REFACTOR, 1) == M_GROK;
    assert cursor_pick(TK_REPEATED, 4) == M_GROK;
    assert cursor_pick(0, 0) == M_GROK;
    assert cursor_pick(99, 0) == M_GROK;
}

test grok_on_a_fresh_cheap_task_is_waste_and_composer_on_architecture_is_waste {
    assert cursor_waste(TK_PARSE, M_GROK, 0, false) == true;
    assert cursor_waste(TK_ARCH, M_COMPOSER, 0, false) == true;
    assert cursor_waste(TK_PARSE, M_COMPOSER, 0, false) == false;
    assert cursor_waste(TK_PARSE, M_GROK, 2, false) == false;
    assert cursor_waste(TK_ARCH, M_GROK, 0, false) == false;
}

test fast_and_500k_and_third_party_are_refused_without_a_reason {
    assert cursor_allowed(M_COMPOSER_FAST, false) == false;
    assert cursor_allowed(M_GROK_FAST, false) == false;
    assert cursor_allowed(M_GROK_500K, false) == false;
    assert cursor_allowed(M_OTHER, true) == false;
    assert cursor_allowed(0, true) == false;
    assert cursor_waste(TK_PARSE, M_COMPOSER_FAST, 0, false) == true;
    assert cursor_waste(TK_ARCH, M_GROK_500K, 0, false) == true;
    assert cursor_allowed(M_COMPOSER_FAST, true) == true;
    assert cursor_allowed(M_GROK_FAST, true) == true;
    assert cursor_allowed(M_GROK_500K, true) == true;
    assert cursor_waste(TK_PARSE, M_COMPOSER_FAST, 0, true) == false;
    assert cursor_waste(TK_ARCH, M_GROK_FAST, 0, true) == false;
    assert cursor_waste(TK_ARCH, M_COMPOSER_FAST, 0, true) == true;
    assert cursor_waste(TK_PARSE, M_GROK_500K, 0, true) == true;
}

test context_above_256k_needs_a_reason {
    assert cursor_context_ok(256, false) == true;
    assert cursor_context_ok(257, false) == false;
    assert cursor_context_ok(257, true) == true;
    assert cursor_context_ok(0, false) == true;
}

test budgets_refuse_a_fourth_lane_a_ninth_file_and_a_third_retry {
    assert cursor_over_parallel(3) == false;
    assert cursor_over_parallel(4) == true;
    assert cursor_over_files(8) == false;
    assert cursor_over_files(9) == true;
    assert cursor_over_retry(2) == false;
    assert cursor_over_retry(3) == true;
    assert REQUIRE_COST_REPORT == true;
    assert MAX_PARALLEL == 3;
    assert ESCALATE_AFTER == 2;
}

test list_price_ratios_are_exact_integers {
    assert PRICE_ASOF == 20261110;
    assert P_GROK_IN / P_COMPOSER_IN == 4;
    assert P_GROK_OUT * 5 == P_COMPOSER_OUT * 12;
    assert P_COMPOSER_FAST_OUT / P_COMPOSER_OUT == 6;
    assert P_GROK_FAST_IN / P_GROK_IN == 2;
    assert P_GROK_FAST_OUT == 12000000;
    assert cursor_cost_micro(M_COMPOSER, PER_M, 0, 0) == P_COMPOSER_IN;
    assert cursor_cost_micro(M_COMPOSER, 0, PER_M, 0) == P_COMPOSER_CACHE;
    assert cursor_cost_micro(M_COMPOSER, 0, 0, PER_M) == P_COMPOSER_OUT;
    assert cursor_cost_micro(M_COMPOSER, PER_M, PER_M, PER_M) == 3200000;
    assert cursor_cost_micro(M_COMPOSER, 500000, 0, 0) == 250000;
    assert cursor_cost_micro(M_GROK, PER_M, 0, 0) == P_GROK_IN;
    assert cursor_cost_micro(M_COMPOSER_FAST, 0, 0, PER_M) == P_COMPOSER_FAST_OUT;
    assert cursor_cost_micro(M_GROK_500K, PER_M, 0, 0) == P_GROK_FAST_IN;
    assert cursor_cost_micro(M_OTHER, PER_M, PER_M, PER_M) == 0;
}

test published_ids_and_a_complete_report {
    assert cr_eq(cursor_model_name(M_COMPOSER), "composer-2.5");
    assert cr_eq(cursor_model_name(M_GROK), "grok-4.7");
    assert cr_eq(cursor_model_name(M_COMPOSER_FAST), "composer-2.5-fast");
    assert cr_eq(cursor_model_name(M_GROK_FAST), "grok-4.7-fast");
    assert cr_eq(cursor_model_name(M_GROK_500K), "grok-4.7-500k");
    assert cursor_model_name(M_OTHER).len == 0;
    assert cursor_model_name(0).len == 0;
    assert cursor_family(M_COMPOSER_FAST) == M_COMPOSER;
    assert cursor_family(M_GROK_500K) == M_GROK;
    assert cursor_family(M_OTHER) == M_OTHER;
    assert cursor_report_ok(RF_REQUIRED) == true;
    assert cursor_report_ok(RF_REQUIRED - RF_COST) == false;
    assert cursor_report_ok(0) == false;
    assert RF_MODEL + RF_INPUT + RF_CACHED + RF_OUTPUT + RF_COST + RF_SUBAGENTS + RF_LANES + RF_ESCALATIONS == RF_REQUIRED;
}

invariant pick_stays_on_the_pair {
    var t : u32 = 0;
    while (t <= TK_KNOWN_LAST) {
        var f : u32 = 0;
        while (f < 6) {
            const m : u32 = cursor_pick(t, f);
            assert m == M_COMPOSER or m == M_GROK;
            f = f + 1;
        }
        t = t + 1;
    }
}
