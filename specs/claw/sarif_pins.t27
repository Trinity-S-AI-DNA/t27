; specs/claw/sarif_pins.t27 -- the length-table pins for specs/claw/sarif.t27.
; sarif.t27 carries every string length explicitly (LEVEL_LENS, ID_LEN, RULE_SLUG_LENS,
; RULE_TEXT_LENS, SCHEMA_URL_LEN, INFO_URL_LEN) because the gen-c backend lowers str to
; const char* and cannot express .len. A wrong number there would clip or over-read every string
; it measures and the document would still look self-consistent. .len, derived from the bytes,
; is the independent check; it runs under the zig runner but cannot lower under gen-c, so the
; pins live here, a test-only companion that is never passed to gen-c (same split as
; specs/claw/gates_pins.t27).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawSarifPins;

use claw::sarif;

fn same(a : str, b : str) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

test level_lens_pin_their_strings {
    for i in 0..3 {
        assert sarif::LEVEL_LENS[i] == sarif::LEVELS[i].len;
    }
}

test rule_lens_pin_their_strings {
    for i in 0..4 {
        assert sarif::ID_LEN == sarif::RULE_IDS[i].len;
        assert sarif::RULE_SLUG_LENS[i] == sarif::RULE_SLUGS[i].len;
        assert sarif::RULE_TEXT_LENS[i] == sarif::RULE_TEXTS[i].len;
    }
}

test url_lens_pin_their_strings {
    assert sarif::SCHEMA_URL_LEN == sarif::SCHEMA_URL.len;
    assert sarif::INFO_URL_LEN == sarif::INFO_URL.len;
}

test same_tells_equal_from_different {
    assert same("abc", "abc") == true;
    assert same("abc", "abd") == false;
    assert same("abc", "ab") == false;
}

test rule_ids_and_slugs_are_unique_so_an_alert_key_is_one_rule {
    for i in 0..4 {
        for j in 0..4 {
            if (i != j) {
                assert same(sarif::RULE_IDS[i], sarif::RULE_IDS[j]) == false;
                assert same(sarif::RULE_SLUGS[i], sarif::RULE_SLUGS[j]) == false;
            }
        }
    }
}
