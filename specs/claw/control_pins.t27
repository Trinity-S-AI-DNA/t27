// SPDX-License-Identifier: Apache-2.0
; specs/claw/control_pins.t27 -- the cross-check of specs/claw/control.t27 against the surface table
; of specs/claw/github_surface.t27 (#10395, lane 2 of epic #10393; the rows are lane 1's, #10394).
; control.t27 names the row each command mints by its own codes (SF_*) and a '$'-terminated list of
; row names. Nothing in control.t27 can tell whether those names are rows of the table: a name typed
; wrong there would be written to the token request and refused only at mint time. This module walks
; the table's own rows, so a name that is not a row, is a row twice, or is a row that cannot be minted
; fails here.
; It is a test-only companion, never passed to gen-c, like gates_pins.t27: gen-c lowers tests as well,
; and the table's STATUS row and str .len do not lower to C, so the check cannot sit in control.t27
; without breaking gen/c/claw/control.c.
; The walk's bound is the table's 27 rows as a literal: the bare name COUNT is declared both in
; github_surface.t27 and in recipes.t27, and use resolution splices neither. A table with fewer rows
; makes SURFACES[i] panic here; a table with more is a change to this bound, and uniqueness of the
; names is the table's own test. (Name no table function in prose here: use resolution reads
; identifiers out of comments too, and splices what it finds.)
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawControlPins;

use claw::control;
use claw::github_surface;
use policy::l2_generation;

test every_surface_is_one_mintable_row_of_github_surface {
    var sf : u8 = control::SF_MERGE_PR;
    var rows : usize = 0;
    while (sf < control::SF_COUNT) {
        var found : usize = 0;
        var i : usize = 0;
        while (i < 27) {
            const name : str = github_surface::SURFACES[i];
            if (l2_generation::list_index(control::SURFACE_ROWS, name, 0, name.len) + 1 == (sf) as usize) {
                assert github_surface::row_mintable(i, false) == true;
                found += 1;
            }
            i += 1;
        }
        assert found == 1;
        rows += found;
        sf += 1;
    }
    assert rows == 5;
}

test every_command_that_mints_lands_on_one_mintable_row {
    // From the command side: each command's surface is one mintable row of the table, by name.
    // (put_surface's bytes are control.t27's own test; it is not called here, as use resolution
    // does not carry its inner l2_generation call into this module.)
    var c : u8 = control::CMD_NONE;
    var minting : usize = 0;
    while (c < control::COMMANDS) {
        const sf : u8 = control::surface_of(c);
        if (sf != control::SF_NONE) {
            var hits : usize = 0;
            var i : usize = 0;
            while (i < 27) {
                const name : str = github_surface::SURFACES[i];
                if (l2_generation::list_index(control::SURFACE_ROWS, name, 0, name.len) + 1 == (sf) as usize) {
                    assert github_surface::row_mintable(i, false) == true;
                    hits += 1;
                }
                i += 1;
            }
            assert hits == 1;
            minting += 1;
        }
        c += 1;
    }
    assert minting == 6;
}
