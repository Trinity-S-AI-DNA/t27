// SPDX-License-Identifier: Apache-2.0
; specs/claw/blocker_attribution.t27 -- before a PR is declared blocked, whose blocker is it
; (measured 2026-11-05 on Trinity-S-AI-DNA/t27 PR #13183).
; --
; #13183 (the type_conflict_sweep spec) was clean on its own three files, yet three checks went
; red: scan named /Users/playra/ in specs/tri/t27b/timeout_terminal.t27 (#13179), duplicate-bodies
; named the same file's `fn same` loop (#13179), and the subcommand census named three dead
; `tri papers` mentions in docs/igla-coder-kernels-literature.md (#13175). The reflex "fix, commit,
; push" would have edited two other lanes' just-merged files -- foreign-budget: a foreign defect
; is fixed by its owner lane, never by the neighbour campaign. This module is that triage as law.
; --
; classify(offending_own, also_other_lane, master_red), first match wins:
;   the check's offending file is one this PR changes            -> own        B_OWN   fix now
;   another OPEN lane also changes that file                     -> shared     B_SHARED coordinate
;   master's last run of the check is red (inherited)            -> foreign    B_FOREIGN track+hold
;   otherwise                                                    -> unseen     B_UNSEEN re-read the log
; shared beats foreign: an inherited red on a file two lanes edit is a coordination problem before
; it is an ownership problem. own beats both: a PR that touches the named file fixes its own part
; even when master is red too (red_origin.t27's own-path rule, restated as the first match here).
; A FOREIGN verdict's next action is the one #13183 followed: open a tracking issue, request the
; owner-lane fix, hold the PR, and let the standing merge gate re-run the checks when master goes
; green -- never a retry storm, never a forced push over the red.
; blocker_line writes one B TAB verdict line for a caller's log.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawBlockerAttribution;

use claw::text;

/// The four verdicts of one blocked check.
pub const B_OWN : u8 = 0;
pub const B_SHARED : u8 = 1;
pub const B_FOREIGN : u8 = 2;
pub const B_UNSEEN : u8 = 3;

/// Whose blocker is it. own > shared > foreign > unseen, first match wins.
pub fn classify(offending_own : bool, also_other_lane : bool, master_red : bool) -> u8 {
    if (offending_own) { return B_OWN; }
    if (also_other_lane) { return B_SHARED; }
    if (master_red) { return B_FOREIGN; }
    return B_UNSEEN;
}

/// One B TAB verdict line: `B<TAB><own|shared|foreign|unseen>\n`.
pub fn blocker_line(out : []u8, cap : usize, offending_own : bool, also_other_lane : bool, master_red : bool) -> usize {
    var w : usize = 0;
    w = put_str(out, cap, w, "B\t", 2);
    const v : u8 = classify(offending_own, also_other_lane, master_red);
    if (v == B_OWN) { w = put_str(out, cap, w, "own\n", 4); }
    if (v == B_SHARED) { w = put_str(out, cap, w, "shared\n", 7); }
    if (v == B_FOREIGN) { w = put_str(out, cap, w, "foreign\n", 8); }
    if (v == B_UNSEEN) { w = put_str(out, cap, w, "unseen\n", 7); }
    return w;
}

invariant own_beats_shared_and_foreign {
    assert classify(true, true, true) == B_OWN;
    assert classify(true, false, false) == B_OWN;
}

test a_foreign_blocker_is_a_hold_not_a_fix {
    // #13183: offending file is not this PR's, no other lane edits it, master is red.
    assert classify(false, false, true) == B_FOREIGN;
}

test shared_beats_foreign {
    // an inherited red on a file two lanes edit is coordination first.
    assert classify(false, true, true) == B_SHARED;
    assert classify(false, true, false) == B_SHARED;
}

test unseen_is_the_honest_fallback {
    assert classify(false, false, false) == B_UNSEEN;
}

test the_line_names_the_verdict {
    var out : [32]u8 = undefined;
    const n : usize = blocker_line(&out, 32, false, false, true);
    assert n == 2 + 8;
    assert buf_has(&out, n, "foreign\n", 8) == true;
    const m : usize = blocker_line(&out, 32, true, true, true);
    assert m == 2 + 4;
    assert buf_has(&out, m, "own\n", 4) == true;
}
