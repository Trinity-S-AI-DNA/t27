// SPDX-License-Identifier: Apache-2.0
; specs/claw/evidence_pins.t27 -- the pins for specs/claw/evidence.t27 (#10412).
; evidence.t27 carries every string length explicitly (COV_NAME_LENS, LABEL_NAME_LENS,
; SEAL_PREFIX_LEN, SEAL_LEN and the fixture lengths) because the gen-c backend lowers str to
; const char* and cannot express .len; a wrong number there would miscompare silently, since
; every lookup inside evidence.t27 reads the same wrong number. .len derives the length from the
; bytes, so the pins live here, in a test-only module that is never passed to gen-c (the
; specs/claw/gates_pins.t27 pattern).
; It also pins the four labels to the T27F graph schema, specs/t27f/spec_graph.t27: same values,
; same names, so "the same four as T27F" is checked, not asserted in prose.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawEvidencePins;

use claw::evidence;
use t27f::spec_graph::LABEL_EXACT;
use t27f::spec_graph::LABEL_DERIVED;
use t27f::spec_graph::LABEL_SUGGESTED;
use t27f::spec_graph::LABEL_UNKNOWN;
use t27f::spec_graph::LABEL_KINDS;
use t27f::spec_graph::LABEL_NAMES;

test word_lens_pin_their_bytes {
    // Loop vars, not literal indices: a literal index lets the checker fold the compare at
    // compile time and the test passes with zero runtime asserts (#6509).
    for k in 0..3 {
        assert evidence::COV_NAME_LENS[k] == evidence::COV_NAMES[k].len;
    }
    for k in 0..4 {
        assert evidence::LABEL_NAME_LENS[k] == evidence::LABEL_NAMES[k].len;
    }
}

test seal_lens_pin_their_bytes {
    var p : str = evidence::SEAL_PREFIX;
    assert evidence::SEAL_PREFIX_LEN == p.len;
    var a : str = evidence::SEAL_A;
    var b : str = evidence::SEAL_B;
    assert evidence::SEAL_LEN == a.len;
    assert evidence::SEAL_LEN == b.len;
    var s : str = evidence::SEAL_A_SHOWN;
    assert evidence::SEAL_A_SHOWN_LEN == s.len;
    var f : str = evidence::FIX_PATH;
    assert evidence::FIX_PATH_LEN == f.len;
    var t : str = evidence::FIX_TEXT;
    assert evidence::FIX_TEXT_LEN == t.len;
}

test fixtures_are_what_their_names_say {
    // The display prefix really is the first digest's first 12 hex digits, so r4's refusal is a
    // refusal of a true prefix and not of unrelated bytes.
    var a : str = evidence::SEAL_A;
    var s : str = evidence::SEAL_A_SHOWN;
    for i in 0..12 {
        assert s[i] == a[evidence::SEAL_PREFIX_LEN + i];
    }
    // And the two digests differ, so r4's mixed citation is really mixed.
    assert evidence::seal_ok(a, a.len) == true;
    var b : str = evidence::SEAL_B;
    assert evidence::seal_ok(b, b.len) == true;
    var diff : u32 = 0;
    for i in 0..71 {
        if (a[i] != b[i]) { diff += 1; }
    }
    assert diff > 0;
}

test labels_are_the_t27f_four {
    var e : u8 = evidence::LABEL_EXACT;
    var d : u8 = evidence::LABEL_DERIVED;
    var g : u8 = evidence::LABEL_SUGGESTED;
    var u : u8 = evidence::LABEL_UNKNOWN;
    var n : u8 = evidence::LABEL_KINDS;
    assert e == LABEL_EXACT;
    assert d == LABEL_DERIVED;
    assert g == LABEL_SUGGESTED;
    assert u == LABEL_UNKNOWN;
    assert n == LABEL_KINDS;
    for k in 0..4 {
        var mine : str = evidence::LABEL_NAMES[k];
        var theirs : str = LABEL_NAMES[k];
        assert mine.len == theirs.len;
        for i in 0..mine.len {
            assert mine[i] == theirs[i];
        }
    }
}
