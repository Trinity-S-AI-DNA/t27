// SPDX-License-Identifier: Apache-2.0
; specs/claw/control.t27 -- the @tri-claw comment grammar: what a person may ask the TRI CLAW App,
; who may ask it, and which row of specs/claw/github_surface.t27 the answer mints (#10395, lane 2 of
; epic #10393).
; Owner, 2026-10-18 (translated): move the queue and dispatch into our GitHub App, TRI CLAW, and
; control it with @tri-claw comments; the App runs in GitHub CI, so dispatch gets faster.
; --
; Same discipline as command_of in specs/queen/app.t27: a '$'-terminated comma list walked byte by
; byte, the command is the word after the FIRST mention, and no mention is no command. The walkers
; are policy::l2_generation's (starts_with, piece_len, list_index, put_entry); nothing is copied.
; --
; The caller is the issue_comment job of lane 7 (#10400), through gen/c/claw/control.c. It hands over
; the comment body and its length, author_association as GitHub spells it, and whether the sender is
; a bot, and gets back u8 codes:
;   command_of       the command (CMD_*), CMD_NONE when there is none
;   association_of   the author_association string as an AS_* code
;   answer_of        IGNORE, ACT or HELP (refused, so only help is offered)
;   surface_of       the github_surface row the action mints (SF_*), SF_NONE when it mints nothing
;   put_surface      that row's name, the string the job asks the token for
;   batch_numbers    the PR numbers after "batch"
; --
; Who: OWNER, MEMBER and COLLABORATOR may say any command; anyone else gets help and status only; a
; bot gets nothing, so the App never answers its own comment and two bots cannot loop.
; Where: pause and resume are queue-wide; land, refresh and rerun act on the pull request the comment
; is on; batch takes PR numbers after the word (none: the job's own choice of the ready set).
; --
; The surface names below are rows of github_surface.t27 (lane 1, #10394). specs/claw/control_pins.t27
; walks that table's own rows and checks each SF code names exactly one of them and that it is
; mintable. The check lives there, a test-only companion never passed to gen-c, because gen-c lowers
; tests too and the table's STATUS row and str .len do not lower to C; control.c stays standalone.
; pause and resume mint control-comments (issues write): the answer is a comment, and the pause flag
; must be one an issues token can hold, such as a label on the queue dashboard issue. A repository
; variable would need actions_variables write, which no row of the table grants.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawControl;

use policy::l2_generation;

/// Commands. Index in COMMAND_WORDS + 1 = the code; CMD_NONE is no command.
///   status   what the queue holds and what it is doing
///   land     merge the pull request the comment is on, once it is green
///   batch    merge the PRs named after the word, together
///   refresh  bring the pull request up to date with its base
///   rerun    rerun the failed jobs of the pull request's last run
///   pause    stop the queue (queue-wide); resume undoes it
///   budget   what today's PR and run budget has left
///   help     list the commands
pub const CMD_NONE : u8 = 0;
pub const CMD_STATUS : u8 = 1;
pub const CMD_LAND : u8 = 2;
pub const CMD_BATCH : u8 = 3;
pub const CMD_REFRESH : u8 = 4;
pub const CMD_RERUN : u8 = 5;
pub const CMD_PAUSE : u8 = 6;
pub const CMD_RESUME : u8 = 7;
pub const CMD_BUDGET : u8 = 8;
pub const CMD_HELP : u8 = 9;
pub const COMMANDS : u8 = 10;

pub const MENTION : str = "@tri-claw$";
pub const COMMAND_WORDS : str = "status,land,batch,refresh,rerun,pause,resume,budget,help,$";

/// author_association, as GitHub spells it. Index in ASSOCIATIONS + 1 = the code; a string GitHub
/// may add later is AS_UNKNOWN, which is treated as a stranger.
pub const AS_UNKNOWN : u8 = 0;
pub const AS_OWNER : u8 = 1;
pub const AS_MEMBER : u8 = 2;
pub const AS_COLLABORATOR : u8 = 3;
pub const AS_CONTRIBUTOR : u8 = 4;
pub const AS_FIRST_TIME_CONTRIBUTOR : u8 = 5;
pub const AS_FIRST_TIMER : u8 = 6;
pub const AS_MANNEQUIN : u8 = 7;
pub const AS_NONE : u8 = 8;
pub const ASSOCIATIONS : str = "OWNER,MEMBER,COLLABORATOR,CONTRIBUTOR,FIRST_TIME_CONTRIBUTOR,FIRST_TIMER,MANNEQUIN,NONE,$";

/// What the job does with a comment.
///   IGNORE  nothing: a bot wrote it, or it holds no command
///   ACT     the command is allowed: do it and answer
///   HELP    the command is refused: answer with help only
pub const ANS_IGNORE : u8 = 0;
pub const ANS_ACT : u8 = 1;
pub const ANS_HELP : u8 = 2;

/// Rows of specs/claw/github_surface.t27 a command can mint. Index in SURFACE_ROWS + 1 = the code.
/// queue-dispatch is the queue's own row (it tells the Queen there is work); no comment mints it.
pub const SF_NONE : u8 = 0;
pub const SF_MERGE_PR : u8 = 1;
pub const SF_UPDATE_BRANCH : u8 = 2;
pub const SF_RERUN_FAILED : u8 = 3;
pub const SF_CONTROL_COMMENTS : u8 = 4;
pub const SF_QUEUE_DISPATCH : u8 = 5;
pub const SF_COUNT : u8 = 6;
pub const SURFACE_ROWS : str = "merge-pr,update-branch,rerun-failed,control-comments,queue-dispatch,$";

/// The row each command mints, by command code.
pub const COMMAND_SURFACE : [10]u8 = [
    SF_NONE, SF_NONE, SF_MERGE_PR, SF_MERGE_PR, SF_UPDATE_BRANCH,
    SF_RERUN_FAILED, SF_CONTROL_COMMENTS, SF_CONTROL_COMMENTS, SF_NONE, SF_NONE,
];

/// Whether the command acts on the pull request the comment is on (so it is refused on an issue).
pub const ON_THIS_PR : [10]bool = [
    false, false, true, false, true,
    true, false, false, false, false,
];

/// At most this many PR numbers are read after "batch".
pub const BATCH_MAX : usize = 100;
/// A PR number has at most this many digits; a longer run of digits is not a number.
pub const NUMBER_DIGITS : usize = 9;

/// Index just past the first mention in text[0..len]; 0 when there is none (a mention is never
/// empty, so 0 is never the end of one). (Mutating `at < len` to `at <= len` is an equivalent
/// mutant: at `at == len` starts_with refuses at once, its first bound check.)
pub fn mention_end(text: []const u8, len: usize) -> usize {
    var at : usize = 0;
    while (at < len) {
        if (l2_generation::starts_with(text, at, len, MENTION)) {
            return at + l2_generation::piece_len(MENTION);
        }
        at += 1;
    }
    return 0;
}

/// The first byte at or after `from` that is not a space.
pub fn skip_spaces(text: []const u8, len: usize, from: usize) -> usize {
    var k : usize = from;
    while (k < len and text[k] == ' ') { k += 1; }
    return k;
}

/// The end of the word that starts at `from`: the first space, newline or carriage return, or len.
pub fn word_end(text: []const u8, len: usize, from: usize) -> usize {
    var e : usize = from;
    while (e < len and text[e] != ' ' and text[e] != 10 and text[e] != 13) { e += 1; }
    return e;
}

/// The command in a comment: the word after the first mention, whole. No mention, an unknown word or
/// a word that only starts like a command is CMD_NONE.
pub fn command_of(text: []const u8, len: usize) -> u8 {
    const m : usize = mention_end(text, len);
    if (m == 0) { return CMD_NONE; }
    const k : usize = skip_spaces(text, len, m);
    const i : usize = l2_generation::list_index(COMMAND_WORDS, text, k, word_end(text, len, k));
    if (i == l2_generation::NOT_FOUND) { return CMD_NONE; }
    return (i + 1) as u8;
}

/// The AS_* code of author_association s[0..len], matched whole.
pub fn association_of(s: []const u8, len: usize) -> u8 {
    const i : usize = l2_generation::list_index(ASSOCIATIONS, s, 0, len);
    if (i == l2_generation::NOT_FOUND) { return AS_UNKNOWN; }
    return (i + 1) as u8;
}

/// May this author give this command? A bot never; OWNER, MEMBER and COLLABORATOR always; anyone
/// else help and status only. No command, or a code past the table, is never allowed.
pub fn allowed(command: u8, association: u8, from_a_bot: bool) -> bool {
    if (from_a_bot) { return false; }
    if (command == CMD_NONE or command >= COMMANDS) { return false; }
    if (association >= AS_OWNER and association <= AS_COLLABORATOR) { return true; }
    return command == CMD_HELP or command == CMD_STATUS;
}

/// What the job does: IGNORE for a bot or no command, ACT when allowed, HELP when refused.
pub fn answer_of(command: u8, association: u8, from_a_bot: bool) -> u8 {
    if (from_a_bot or command == CMD_NONE or command >= COMMANDS) { return ANS_IGNORE; }
    if (allowed(command, association, from_a_bot)) { return ANS_ACT; }
    return ANS_HELP;
}

/// The github_surface row the command's action mints; SF_NONE for help, status, budget, no command
/// and a code past the table.
pub fn surface_of(command: u8) -> u8 {
    if (command >= COMMANDS) { return SF_NONE; }
    return COMMAND_SURFACE[(command) as usize];
}

/// Does the command act on the pull request the comment is on?
pub fn acts_on_this_pr(command: u8) -> bool {
    if (command >= COMMANDS) { return false; }
    return ON_THIS_PR[(command) as usize];
}

/// Write the row name of surface code sf to out; the bytes it needs, 0 for SF_NONE or a code past
/// the table (put_entry writes nothing for an index past the list's '$'). The caller checks the
/// result against cap.
pub fn put_surface(sf: u8, out: []u8, cap: usize) -> usize {
    if (sf == SF_NONE) { return 0; }
    return l2_generation::put_entry(out, 0, cap, SURFACE_ROWS, (sf - 1) as usize);
}

/// The first byte at or after `from` that is neither a space nor a comma.
pub fn skip_gaps(text: []const u8, len: usize, from: usize) -> usize {
    var k : usize = from;
    while (k < len and (text[k] == ' ' or text[k] == ',')) { k += 1; }
    return k;
}

/// The PR numbers after "@tri-claw batch", written to out[0..]; how many. Numbers are separated by
/// spaces or commas and may carry a '#'. Reading stops at the first thing that is not a number (a
/// word, a newline, a 0, more than NUMBER_DIGITS digits, digits glued to a letter), after BATCH_MAX
/// numbers, or when out[0..cap] is full. A comment whose command is not batch reads none.
/// (Mutating `cap < most` to `cap <= most` is an equivalent mutant: at cap == most both keep most.)
pub fn batch_numbers(text: []const u8, len: usize, out: []u32, cap: usize) -> usize {
    if (command_of(text, len) != CMD_BATCH) { return 0; }
    var most : usize = BATCH_MAX;
    if (cap < most) { most = cap; }
    var p : usize = word_end(text, len, skip_spaces(text, len, mention_end(text, len)));
    var n : usize = 0;
    while (n < most) {
        p = skip_gaps(text, len, p);
        if (p < len and text[p] == '#') { p += 1; }
        var v : u32 = 0;
        var d : usize = 0;
        while (p < len and d < NUMBER_DIGITS and text[p] >= '0' and text[p] <= '9') {
            v = v * 10 + ((text[p] - '0') as u32);
            p += 1;
            d += 1;
        }
        if (d == 0 or v == 0) { return n; }
        if (p < len and text[p] != ' ' and text[p] != ',' and text[p] != 10 and text[p] != 13) { return n; }
        out[n] = v;
        n += 1;
    }
    return n;
}

test every_command_is_read_after_the_mention {
    assert command_of("@tri-claw status", 16) == CMD_STATUS;
    assert command_of("@tri-claw land", 14) == CMD_LAND;
    assert command_of("@tri-claw batch", 15) == CMD_BATCH;
    assert command_of("@tri-claw refresh", 17) == CMD_REFRESH;
    assert command_of("@tri-claw rerun", 15) == CMD_RERUN;
    assert command_of("@tri-claw pause", 15) == CMD_PAUSE;
    assert command_of("@tri-claw resume", 16) == CMD_RESUME;
    assert command_of("@tri-claw budget", 16) == CMD_BUDGET;
    assert command_of("@tri-claw help", 14) == CMD_HELP;
    // spaces before the word, text after it on the same line or the next
    assert command_of("please @tri-claw   land now", 27) == CMD_LAND;
    assert command_of("@tri-claw help\nthanks", 21) == CMD_HELP;
    // a carriage return ends the word too ("\r" in a literal is two bytes, so it is written as 13)
    var b : [16]u8 = undefined;
    const head : str = "@tri-claw rerun";
    var w : usize = 0;
    while (w < 15) {
        b[w] = head[w];
        w += 1;
    }
    b[15] = 13;
    assert command_of(&b, 16) == CMD_RERUN;
}

test no_mention_or_an_unknown_word_is_no_command {
    assert command_of("land", 4) == CMD_NONE;
    assert command_of("", 0) == CMD_NONE;
    assert command_of("@tri-claw dance", 15) == CMD_NONE;
    assert command_of("@tri-claw lands", 15) == CMD_NONE;
    assert command_of("@tri-claw land.", 15) == CMD_NONE;
    assert command_of("@tri-claw\tland", 14) == CMD_NONE;
    assert command_of("@tri-clow land", 14) == CMD_NONE;
    assert command_of("@TRI-CLAW land", 14) == CMD_NONE;
    // the text ends inside the mention, in the spaces after it, or right after it
    assert command_of("ask @tri-cl", 11) == CMD_NONE;
    assert command_of("@tri-claw   ", 12) == CMD_NONE;
    assert command_of("@tri-claw", 9) == CMD_NONE;
    // len is the end: a command past it is not read
    assert command_of("@tri-claw land", 13) == CMD_NONE;
}

test only_the_first_mention_counts {
    assert command_of("@tri-claw dance, then @tri-claw land", 36) == CMD_NONE;
    assert command_of("@tri-claw status and @tri-claw land", 35) == CMD_STATUS;
    assert mention_end("hi @tri-claw land", 17) == 12;
    assert mention_end("@tri-claw", 9) == 9;
    assert mention_end("no mention here", 15) == 0;
}

test author_association_is_read_whole {
    assert association_of("OWNER", 5) == AS_OWNER;
    assert association_of("MEMBER", 6) == AS_MEMBER;
    assert association_of("COLLABORATOR", 12) == AS_COLLABORATOR;
    assert association_of("CONTRIBUTOR", 11) == AS_CONTRIBUTOR;
    assert association_of("FIRST_TIME_CONTRIBUTOR", 22) == AS_FIRST_TIME_CONTRIBUTOR;
    assert association_of("FIRST_TIMER", 11) == AS_FIRST_TIMER;
    assert association_of("MANNEQUIN", 9) == AS_MANNEQUIN;
    assert association_of("NONE", 4) == AS_NONE;
    // a prefix, a longer word, another case or nothing is not an association
    assert association_of("OWNERS", 6) == AS_UNKNOWN;
    assert association_of("OWNE", 4) == AS_UNKNOWN;
    assert association_of("owner", 5) == AS_UNKNOWN;
    assert association_of("FIRST_TIME", 10) == AS_UNKNOWN;
    assert association_of("", 0) == AS_UNKNOWN;
}

test a_bot_gets_nothing {
    var c : u8 = 0;
    while (c < COMMANDS) {
        assert allowed(c, AS_OWNER, true) == false;
        assert allowed(c, AS_NONE, true) == false;
        assert answer_of(c, AS_OWNER, true) == ANS_IGNORE;
        assert answer_of(c, AS_NONE, true) == ANS_IGNORE;
        c += 1;
    }
}

test owner_member_and_collaborator_may_say_any_command {
    var a : u8 = AS_OWNER;
    while (a <= AS_COLLABORATOR) {
        var c : u8 = CMD_STATUS;
        while (c < COMMANDS) {
            assert allowed(c, a, false) == true;
            assert answer_of(c, a, false) == ANS_ACT;
            c += 1;
        }
        // no command, or a code past the table, is never allowed
        assert allowed(CMD_NONE, a, false) == false;
        assert allowed(COMMANDS, a, false) == false;
        assert answer_of(CMD_NONE, a, false) == ANS_IGNORE;
        assert answer_of(COMMANDS, a, false) == ANS_IGNORE;
        a += 1;
    }
}

test anyone_else_gets_help_and_status_only {
    var a : u8 = AS_CONTRIBUTOR;
    while (a <= AS_NONE + 1) {
        // AS_NONE + 1 is a string GitHub may add later; AS_UNKNOWN is checked after the loop
        assert allowed(CMD_HELP, a, false) == true;
        assert allowed(CMD_STATUS, a, false) == true;
        assert answer_of(CMD_HELP, a, false) == ANS_ACT;
        assert answer_of(CMD_STATUS, a, false) == ANS_ACT;
        var c : u8 = CMD_LAND;
        while (c <= CMD_BUDGET) {
            assert allowed(c, a, false) == false;
            assert answer_of(c, a, false) == ANS_HELP;
            c += 1;
        }
        a += 1;
    }
    assert allowed(CMD_LAND, AS_UNKNOWN, false) == false;
    assert allowed(CMD_HELP, AS_UNKNOWN, false) == true;
    assert answer_of(CMD_PAUSE, AS_UNKNOWN, false) == ANS_HELP;
}

test the_three_scenarios_of_the_issue {
    // the owner comments `@tri-claw land` on a green PR: LAND, allowed, surface merge-pr
    const land : u8 = command_of("@tri-claw land", 14);
    assert land == CMD_LAND;
    assert answer_of(land, association_of("OWNER", 5), false) == ANS_ACT;
    assert surface_of(land) == SF_MERGE_PR;
    // a first-time contributor comments `@tri-claw pause`: refused, help only
    const pause : u8 = command_of("@tri-claw pause", 15);
    assert pause == CMD_PAUSE;
    assert allowed(pause, association_of("FIRST_TIME_CONTRIBUTOR", 22), false) == false;
    assert answer_of(pause, association_of("FIRST_TIME_CONTRIBUTOR", 22), false) == ANS_HELP;
    // the App's own comment mentions @tri-claw: nothing happens
    const own : u8 = command_of("@tri-claw help -- commands: status, land", 40);
    assert own == CMD_HELP;
    assert answer_of(own, AS_NONE, true) == ANS_IGNORE;
}

test each_command_mints_its_row_or_none {
    assert surface_of(CMD_NONE) == SF_NONE;
    assert surface_of(CMD_STATUS) == SF_NONE;
    assert surface_of(CMD_LAND) == SF_MERGE_PR;
    assert surface_of(CMD_BATCH) == SF_MERGE_PR;
    assert surface_of(CMD_REFRESH) == SF_UPDATE_BRANCH;
    assert surface_of(CMD_RERUN) == SF_RERUN_FAILED;
    assert surface_of(CMD_PAUSE) == SF_CONTROL_COMMENTS;
    assert surface_of(CMD_RESUME) == SF_CONTROL_COMMENTS;
    assert surface_of(CMD_BUDGET) == SF_NONE;
    assert surface_of(CMD_HELP) == SF_NONE;
    assert surface_of(COMMANDS) == SF_NONE;
    assert surface_of(255) == SF_NONE;
}

test every_command_that_mints_writes_a_row_name {
    // which row each name is, and that it is mintable, is control_pins.t27's cross-check
    var c : u8 = CMD_NONE;
    var minting : usize = 0;
    while (c < COMMANDS) {
        var b : [32]u8 = undefined;
        const n : usize = put_surface(surface_of(c), &b, 32);
        if (surface_of(c) != SF_NONE) {
            assert n > 0;
            minting += 1;
        }
        if (surface_of(c) == SF_NONE) { assert n == 0; }
        c += 1;
    }
    assert minting == 6;
}

test the_row_names_are_written_whole {
    assert l2_generation::list_len(SURFACE_ROWS) == 5;
    assert l2_generation::list_index(SURFACE_ROWS, "merge-pr", 0, 8) + 1 == SF_MERGE_PR;
    assert l2_generation::list_index(SURFACE_ROWS, "update-branch", 0, 13) + 1 == SF_UPDATE_BRANCH;
    assert l2_generation::list_index(SURFACE_ROWS, "rerun-failed", 0, 12) + 1 == SF_RERUN_FAILED;
    assert l2_generation::list_index(SURFACE_ROWS, "control-comments", 0, 16) + 1 == SF_CONTROL_COMMENTS;
    assert l2_generation::list_index(SURFACE_ROWS, "queue-dispatch", 0, 14) + 1 == SF_QUEUE_DISPATCH;
    // put_surface writes the name the token is minted for, and nothing for no row
    var b : [32]u8 = undefined;
    const n1 : usize = put_surface(SF_MERGE_PR, &b, 32);
    assert l2_generation::is_piece(&b, 0, n1, "merge-pr$") == true;
    const n4 : usize = put_surface(SF_CONTROL_COMMENTS, &b, 32);
    assert l2_generation::is_piece(&b, 0, n4, "control-comments$") == true;
    const n5 : usize = put_surface(SF_QUEUE_DISPATCH, &b, 32);
    assert l2_generation::is_piece(&b, 0, n5, "queue-dispatch$") == true;
    assert put_surface(surface_of(CMD_REFRESH), &b, 32) == 13;
    assert l2_generation::is_piece(&b, 0, 13, "update-branch$") == true;
    assert put_surface(surface_of(CMD_RERUN), &b, 32) == 12;
    assert l2_generation::is_piece(&b, 0, 12, "rerun-failed$") == true;
    assert put_surface(SF_NONE, &b, 32) == 0;
    assert put_surface(SF_COUNT, &b, 32) == 0;
    assert put_surface(255, &b, 32) == 0;
    // a short buffer still reports the bytes the name needs
    assert put_surface(SF_CONTROL_COMMENTS, &b, 4) == 16;
}

test land_refresh_and_rerun_act_on_this_pr_only {
    assert acts_on_this_pr(CMD_LAND) == true;
    assert acts_on_this_pr(CMD_REFRESH) == true;
    assert acts_on_this_pr(CMD_RERUN) == true;
    assert acts_on_this_pr(CMD_NONE) == false;
    assert acts_on_this_pr(CMD_STATUS) == false;
    assert acts_on_this_pr(CMD_BATCH) == false;
    assert acts_on_this_pr(CMD_PAUSE) == false;
    assert acts_on_this_pr(CMD_RESUME) == false;
    assert acts_on_this_pr(CMD_BUDGET) == false;
    assert acts_on_this_pr(CMD_HELP) == false;
    assert acts_on_this_pr(COMMANDS) == false;
}

test batch_reads_numbers_until_the_first_non_number {
    var out : [8]u32 = undefined;
    assert batch_numbers("@tri-claw batch 12 345, #6,7", 28, &out, 8) == 4;
    assert out[0] == 12;
    assert out[1] == 345;
    assert out[2] == 6;
    assert out[3] == 7;
    // a 0 inside a number is a digit
    assert batch_numbers("@tri-claw batch #10406 30,100", 29, &out, 8) == 3;
    assert out[0] == 10406;
    assert out[1] == 30;
    assert out[2] == 100;
    // a word stops it; the number after the word is not read
    assert batch_numbers("@tri-claw batch 5 please 9", 26, &out, 8) == 1;
    assert out[0] == 5;
    // a newline stops it
    assert batch_numbers("@tri-claw batch 5\n9", 19, &out, 8) == 1;
    // a carriage return ends a number as well (written as 13: "\r" in a literal is two bytes)
    var t : [20]u8 = undefined;
    const head : str = "@tri-claw batch 5 9";
    var w : usize = 0;
    while (w < 19) {
        t[w] = head[w];
        w += 1;
    }
    t[17] = 13;
    assert batch_numbers(&t, 19, &out, 8) == 1;
    assert out[0] == 5;
    t[16] = 13;
    assert batch_numbers(&t, 19, &out, 8) == 0;
    // a 0, a bare '#', digits glued to a letter and a ten-digit run are not numbers
    assert batch_numbers("@tri-claw batch 0 4", 19, &out, 8) == 0;
    assert batch_numbers("@tri-claw batch # 4", 19, &out, 8) == 0;
    assert batch_numbers("@tri-claw batch 4x 5", 20, &out, 8) == 0;
    assert batch_numbers("@tri-claw batch 1234567890", 26, &out, 8) == 0;
    assert batch_numbers("@tri-claw batch 123456789", 25, &out, 8) == 1;
    assert out[0] == 123456789;
    // no numbers, trailing gaps, and a command that is not batch
    assert batch_numbers("@tri-claw batch", 15, &out, 8) == 0;
    assert batch_numbers("@tri-claw batch 8 , ", 20, &out, 8) == 1;
    assert batch_numbers("@tri-claw land 12", 17, &out, 8) == 0;
    assert batch_numbers("batch 12", 8, &out, 8) == 0;
    // the out buffer bounds it
    assert batch_numbers("@tri-claw batch 1 2 3 4", 23, &out, 3) == 3;
    assert out[2] == 3;
}

test batch_reads_at_most_a_hundred_numbers {
    var t : [256]u8 = undefined;
    const head : str = "@tri-claw batch";
    var w : usize = 0;
    while (w < 15) {
        t[w] = head[w];
        w += 1;
    }
    var k : usize = 0;
    while (k < 101) {
        t[w] = ' ';
        t[w + 1] = '7';
        w += 2;
        k += 1;
    }
    var out : [128]u32 = undefined;
    assert batch_numbers(&t, w, &out, 128) == BATCH_MAX;
    assert out[99] == 7;
    assert batch_numbers(&t, w - 2, &out, 128) == BATCH_MAX;
    assert batch_numbers(&t, w - 4, &out, 128) == 99;
}
