// SPDX-License-Identifier: Apache-2.0
; specs/claw/token_shape.t27 -- the shape every TRI CLAW job that mints an App token must have, so a
; permission the owner has not granted yet leaves a note in the step summary instead of a red check on
; every pull request.
; Recorded defect: #10501. claw-sarif asked for security_events write before it knew a .t27 changed,
; the installation lacked the permission, and the job was red on every pull request for a day (#10568
; fixed that one job). The same shape still sits in the other App-token jobs; this law names them.
; Competitor note (docs/claw/competitors.md, 2026-10-19): Codacy's coverage gate waits forever on a
; pull request with no coverage subject and offers no setting to skip it. The rule here is the
; opposite answer to the same question: a gate with nothing to judge, or no permission to judge it,
; says so and passes.
; --
; The rule, per job under `jobs:` in one workflow file:
; - R1 no-continue-on-error: a step that uses actions/create-github-app-token carries
;   `continue-on-error: true`, on its own step line (flow form) or as a key of that step (block form).
; - R2 no-failure-note: a job with such a step also has a step whose `if:` reads `.outcome == 'failure'`,
;   the step that writes the owner's fix to the step summary -- or uses the token as
;   `steps.tok.outputs.token || github.token`, a fallback that keeps the job working and names who
;   acted (auto-merge-ready-prs.yml, the merge line records "TRI CLAW" or "github.token").
; A job that mints no token is not judged.
; A job that says `# token_shape: red` on one of its lines is not judged either: an operator-dispatched
; run (claw-batch) asked for one action, and a token that cannot be minted must fail it, not hide in a note.
; A text that only mentions the action inside a `run: |` block
; is not a step that uses it: only the step's own line and the step's own keys are read, by indent.
; --
; Input: the workflow file's bytes. Output: one line per violation, "<job>\t<rule>\n", in file order;
; token_shape_report returns the bytes it needs (a write past cap is dropped, the cursor stays honest)
; and token_shape_count the number of violations.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawTokenShape;

use claw::text;

pub const RULE_COE : str = "no-continue-on-error";
pub const RULE_COE_LEN : usize = 20;
pub const RULE_NOTE : str = "no-failure-note";
pub const RULE_NOTE_LEN : usize = 15;

const MINT : str = "uses: actions/create-github-app-token@";
const MINT_LEN : usize = 38;
const COE : str = "continue-on-error: true";
const COE_LEN : usize = 23;
const NOTE : str = ".outcome == 'failure'";
const NOTE_LEN : usize = 21;
const FALLBACK : str = "outputs.token ||";
const FALLBACK_LEN : usize = 16;
const OPT_OUT : str = "# token_shape: red";
const OPT_OUT_LEN : usize = 18;

/// Does text[s..e) contain needle anywhere?
fn span_has(text : []const u8, s : usize, e : usize, needle : str, nlen : usize) -> bool {
    var i : usize = s;
    while (i + nlen <= e) {
        var k : usize = 0;
        var diff : usize = 0;
        while (k < nlen) {
            if (text[i + k] != needle[k]) { diff += 1; }
            k += 1;
        }
        if (diff == 0) { return true; }
        i += 1;
    }
    return false;
}

/// Does text[s..e) start with p?
fn span_starts(text : []const u8, s : usize, e : usize, p : str, plen : usize) -> bool {
    if (s + plen > e) { return false; }
    var k : usize = 0;
    while (k < plen) {
        if (text[s + k] != p[k]) { return false; }
        k += 1;
    }
    return true;
}

/// End of the line that starts at s: the index of its newline, or n.
fn line_end(text : []const u8, n : usize, s : usize) -> usize {
    var i : usize = s;
    while (i < n) {
        if (text[i] == '\n') { return i; }
        i += 1;
    }
    return n;
}

/// Leading spaces of the line text[s..e).
fn indent_of(text : []const u8, s : usize, e : usize) -> usize {
    var i : usize = s;
    while (i < e) {
        if (text[i] != ' ') { return i - s; }
        i += 1;
    }
    return e - s;
}

/// Is text[s..e) a job header: two spaces, a name with no space, a colon, then nothing but spaces?
fn is_job_header(text : []const u8, s : usize, e : usize) -> bool {
    if (indent_of(text, s, e) != 2) { return false; }
    var i : usize = s + 2;
    if (i >= e) { return false; }
    if (text[i] == '#' or text[i] == '-') { return false; }
    while (i < e) {
        if (text[i] == ':') {
            var j : usize = i + 1;
            while (j < e) {
                if (text[j] != ' ' and text[j] != 13) { return false; }
                j += 1;
            }
            return i > s + 2;
        }
        if (text[i] == ' ') { return false; }
        i += 1;
    }
    return false;
}

/// Is text[s..e) a list item, `- ` after its indent?
fn is_item(text : []const u8, s : usize, e : usize) -> bool {
    const p : usize = s + indent_of(text, s, e);
    return span_starts(text, p, e, "- ", 2);
}

/// Copy text[s..e) to dst at w, clipped at cap.
fn put_span(dst : []u8, cap : usize, w : usize, text : []const u8, s : usize, e : usize) -> usize {
    var i : usize = s;
    var x : usize = w;
    while (i < e) {
        if (x < cap) { dst[x] = text[i]; }
        x += 1;
        i += 1;
    }
    return x;
}

/// One violation line "<job>\t<rule>\n".
fn put_violation(dst : []u8, cap : usize, w : usize, text : []const u8, js : usize, je : usize, rule : str, rlen : usize) -> usize {
    var x : usize = put_span(dst, cap, w, text, js, je);
    x = put_str(dst, cap, x, "\t", 1);
    x = put_str(dst, cap, x, rule, rlen);
    return put_str(dst, cap, x, "\n", 1);
}

/// The report: one line per violation, in file order; returns the bytes it needs.
pub fn token_shape_report(text : []const u8, n : usize, dst : []u8, cap : usize) -> usize {
    var w : usize = 0;
    var in_jobs : bool = false;
    var have_job : bool = false;
    var js : usize = 0;
    var je : usize = 0;
    var step_indent : usize = 0;
    var mints : bool = false;
    var bad_coe : bool = false;
    var noted : bool = false;
    var red_ok : bool = false;
    var in_step : bool = false;
    var step_mints : bool = false;
    var step_coe : bool = false;
    var s : usize = 0;
    while (s <= n) {
        const e : usize = line_end(text, n, s);
        const ind : usize = indent_of(text, s, e);
        const header : bool = in_jobs and is_job_header(text, s, e);
        const top : bool = s < n and ind == 0 and e > s and text[s] != '#';
        const item : bool = have_job and is_item(text, s, e) and ind > 2 and (step_indent == 0 or ind == step_indent);
        // a step ends at the next step, the next job, the end of `jobs:` or the end of the file
        if (in_step and (item or header or top or s >= n)) {
            if (step_mints and !step_coe) { bad_coe = true; }
            if (step_mints) { mints = true; }
            in_step = false;
        }
        // a job ends at the next job, the end of `jobs:` or the end of the file
        if (have_job and (header or top or s >= n)) {
            if (red_ok) { mints = false; }
            if (mints and bad_coe) { w = put_violation(dst, cap, w, text, js, je, RULE_COE, RULE_COE_LEN); }
            if (mints and !noted) { w = put_violation(dst, cap, w, text, js, je, RULE_NOTE, RULE_NOTE_LEN); }
            have_job = false;
        }
        if (s >= n) { return w; }
        if (top) { in_jobs = span_starts(text, s, e, "jobs:", 5); }
        if (header) {
            have_job = true;
            js = s + 2;
            je = js;
            while (text[je] != ':') { je += 1; }
            step_indent = 0;
            mints = false;
            bad_coe = false;
            noted = false;
            red_ok = false;
        } else if (have_job) {
            if (span_has(text, s, e, NOTE, NOTE_LEN)) { noted = true; }
            if (span_has(text, s, e, FALLBACK, FALLBACK_LEN)) { noted = true; }
            if (span_has(text, s, e, OPT_OUT, OPT_OUT_LEN)) { red_ok = true; }
            if (item) {
                if (step_indent == 0) { step_indent = ind; }
                in_step = true;
                step_mints = span_has(text, s, e, MINT, MINT_LEN);
                step_coe = span_has(text, s, e, COE, COE_LEN);
            } else if (in_step and ind == step_indent + 2) {
                if (span_starts(text, s + ind, e, MINT, MINT_LEN)) { step_mints = true; }
                if (span_starts(text, s + ind, e, COE, COE_LEN)) { step_coe = true; }
            }
        }
        s = e + 1;
    }
    return w;
}

/// How many violations the report holds: its newlines.
pub fn token_shape_count(text : []const u8, n : usize) -> u32 {
    var out : [4096]u8 = undefined;
    const m : usize = token_shape_report(text, n, &out, 4096);
    var c : u32 = 0;
    var i : usize = 0;
    while (i < m and i < 4096) {
        if (out[i] == '\n') { c += 1; }
        i += 1;
    }
    return c;
}

test the_shape_10568_gave_claw_sarif_passes {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - id: have\n", 17);
    n = put_str(&t, 512, n, "        run: echo ok=1\n", 23);
    n = put_str(&t, 512, n, "      - {id: tok, continue-on-error: true, uses: actions/create-github-app-token@v2}\n", 85);
    n = put_str(&t, 512, n, "      - {if: steps.tok.outcome == 'failure', run: echo note}\n", 61);
    assert n == 213;
    assert token_shape_count(&t, n) == 0;
}

test the_shape_claw_sarif_had_before_10568_breaks_both_rules {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - id: have\n", 17);
    n = put_str(&t, 512, n, "        run: echo ok=1\n", 23);
    n = put_str(&t, 512, n, "      - {id: tok, uses: actions/create-github-app-token@v2}\n", 60);
    assert n == 127;
    var out : [256]u8 = undefined;
    const m : usize = token_shape_report(&t, n, &out, 256);
    assert m == 51;
    assert buf_has(&out, m, "claw-a\tno-continue-on-error\n", 28) == true;
    assert buf_has(&out, m, "claw-a\tno-failure-note\n", 23) == true;
    assert token_shape_count(&t, n) == 2;
}

test continue_on_error_as_a_key_of_a_block_step_counts {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - id: tok\n", 16);
    n = put_str(&t, 512, n, "        uses: actions/create-github-app-token@v2\n", 49);
    n = put_str(&t, 512, n, "        continue-on-error: true\n", 32);
    n = put_str(&t, 512, n, "      - {if: steps.tok.outcome == 'failure', run: echo note}\n", 61);
    assert n == 185;
    assert token_shape_count(&t, n) == 0;
}

test continue_on_error_on_a_later_step_does_not_cover_the_token_step {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - id: tok\n", 16);
    n = put_str(&t, 512, n, "        uses: actions/create-github-app-token@v2\n", 49);
    n = put_str(&t, 512, n, "      - id: have\n", 17);
    n = put_str(&t, 512, n, "        continue-on-error: true\n", 32);
    n = put_str(&t, 512, n, "      - {if: steps.tok.outcome == 'failure', run: echo note}\n", 61);
    assert n == 202;
    var out : [256]u8 = undefined;
    const m : usize = token_shape_report(&t, n, &out, 256);
    assert m == 28;
    assert buf_has(&out, m, "claw-a\tno-continue-on-error\n", 28) == true;
}

test a_job_that_mints_no_token_is_not_judged {
    var t : [256]u8 = undefined;
    var n : usize = put_str(&t, 256, 0, "jobs:\n", 6);
    n = put_str(&t, 256, n, "  plain:\n", 9);
    n = put_str(&t, 256, n, "    steps:\n", 11);
    n = put_str(&t, 256, n, "      - id: have\n", 17);
    n = put_str(&t, 256, n, "        run: echo ok=1\n", 23);
    assert n == 66;
    assert token_shape_count(&t, n) == 0;
}

test the_action_named_inside_a_run_block_is_not_a_token_step {
    var t : [256]u8 = undefined;
    var n : usize = put_str(&t, 256, 0, "jobs:\n", 6);
    n = put_str(&t, 256, n, "  plain:\n", 9);
    n = put_str(&t, 256, n, "    steps:\n", 11);
    n = put_str(&t, 256, n, "      - run: |\n", 15);
    n = put_str(&t, 256, n, "          - {id: x, uses: actions/create-github-app-token@v2}\n", 62);
    assert n == 103;
    assert token_shape_count(&t, n) == 0;
}

test each_job_is_judged_alone {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - {id: tok, uses: actions/create-github-app-token@v2}\n", 60);
    n = put_str(&t, 512, n, "  plain:\n", 9);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - {if: steps.tok.outcome == 'failure', run: echo note}\n", 61);
    assert n == 168;
    var out : [256]u8 = undefined;
    const m : usize = token_shape_report(&t, n, &out, 256);
    assert m == 51;
    assert token_shape_count(&t, n) == 2;
}

test a_clipped_report_still_returns_the_bytes_it_needs {
    var t : [256]u8 = undefined;
    var n : usize = put_str(&t, 256, 0, "jobs:\n", 6);
    n = put_str(&t, 256, n, "  claw-a:\n", 10);
    n = put_str(&t, 256, n, "    steps:\n", 11);
    n = put_str(&t, 256, n, "      - {id: tok, uses: actions/create-github-app-token@v2}\n", 60);
    var out : [8]u8 = undefined;
    assert token_shape_report(&t, n, &out, 8) == 51;
    assert out[0] == 'c';
    assert out[7] == 'n';
}

test a_token_with_a_github_token_fallback_needs_no_note {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - {id: tok, continue-on-error: true, uses: actions/create-github-app-token@v2}\n", 85);
    n = put_str(&t, 512, n, "      - {env: {T: steps.tok.outputs.token || github.token}, run: echo x}\n", 73);
    assert n == 185;
    assert token_shape_count(&t, n) == 0;
}

test a_job_that_says_red_on_purpose_is_not_judged {
    var t : [256]u8 = undefined;
    var n : usize = put_str(&t, 256, 0, "jobs:\n", 6);
    n = put_str(&t, 256, n, "  claw-b:\n", 10);
    n = put_str(&t, 256, n, "    steps:\n", 11);
    n = put_str(&t, 256, n, "      - {id: tok, uses: actions/create-github-app-token@v2}  # token_shape: red - an operator asked\n", 100);
    assert n == 127;
    assert token_shape_count(&t, n) == 0;
}

// Tests below were added by the mutation sweep of #10673 (tick 18); each names the mutants it kills.

// span_has `<=` -> `<`: a needle that ends exactly at the end of its line.
test a_note_at_the_end_of_its_line_counts {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - {id: tok, continue-on-error: true, uses: actions/create-github-app-token@v2}\n", 85);
    n = put_str(&t, 512, n, "      - if: steps.tok.outcome == 'failure'\n", 43);
    n = put_str(&t, 512, n, "        run: echo note\n", 23);
    assert n == 178;
    assert token_shape_count(&t, n) == 0;
}

// top `e > s` -> `e >= s` and is_job_header's empty-name `return false` -> `return true`:
// an empty line and a line of two spaces inside a job end neither the job nor `jobs:`.
test blank_and_two_space_lines_do_not_end_a_job {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - {id: tok, continue-on-error: true, uses: actions/create-github-app-token@v2}\n", 85);
    n = put_str(&t, 512, n, "\n", 1);
    n = put_str(&t, 512, n, "  \n", 3);
    n = put_str(&t, 512, n, "      - {if: steps.tok.outcome == 'failure', run: echo note}\n", 61);
    assert n == 177;
    assert token_shape_count(&t, n) == 0;
}

// is_job_header `or` -> `and` and its `return false` -> `return true` on '#' or '-':
// a commented-out job is not a job, so the note after it still belongs to claw-a.
test a_commented_out_job_header_is_not_a_job {
    var t : [512]u8 = undefined;
    var n : usize = put_str(&t, 512, 0, "jobs:\n", 6);
    n = put_str(&t, 512, n, "  claw-a:\n", 10);
    n = put_str(&t, 512, n, "    steps:\n", 11);
    n = put_str(&t, 512, n, "      - {id: tok, continue-on-error: true, uses: actions/create-github-app-token@v2}\n", 85);
    n = put_str(&t, 512, n, "  #build:\n", 10);
    n = put_str(&t, 512, n, "      - {if: steps.tok.outcome == 'failure', run: echo note}\n", 61);
    assert n == 183;
    assert token_shape_count(&t, n) == 0;
}

// item `ind > 2` -> `ind >= 2`: a step is deeper than its job; a list item at the job's own indent is not one.
// The `or` -> `and` on the in-step key check: a key-shaped line deep inside a `run: |` block is not a key of the step.
test only_a_step_or_its_own_key_can_mint {
    var t : [256]u8 = undefined;
    var n : usize = put_str(&t, 256, 0, "jobs:\n", 6);
    n = put_str(&t, 256, n, "  claw-a:\n", 10);
    n = put_str(&t, 256, n, "  - {id: tok, uses: actions/create-github-app-token@v2}\n", 56);
    assert n == 72;
    assert token_shape_count(&t, n) == 0;
    var b : [256]u8 = undefined;
    var m : usize = put_str(&b, 256, 0, "jobs:\n", 6);
    m = put_str(&b, 256, m, "  plain:\n", 9);
    m = put_str(&b, 256, m, "    steps:\n", 11);
    m = put_str(&b, 256, m, "      - run: |\n", 15);
    m = put_str(&b, 256, m, "            uses: actions/create-github-app-token@v2\n", 53);
    assert m == 94;
    assert token_shape_count(&b, m) == 0;
}

// is_job_header, line by line: trailing spaces and a CR are allowed after the colon (kills `!=` -> `==`
// and `and` -> `or` on the tail check); anything else after it, an empty name, a space in the name or no
// colon at all is not a header (kills `i + 1` -> `i + 2`, `>` -> `>=` on the name length, both
// `return false` -> `return true`, and the scan running past the line on `<` -> `<=`).
test only_a_bare_name_and_a_colon_is_a_job_header {
    var t : [32]u8 = undefined;
    var n : usize = put_str(&t, 32, 0, "  claw-a:  x\n", 13);
    t[11] = 13;
    assert n == 13;
    assert is_job_header(&t, 0, 12) == true;
    n = put_str(&t, 32, 0, "  a:b\n", 6);
    assert is_job_header(&t, 0, 5) == false;
    n = put_str(&t, 32, 0, "  #build:\n", 10);
    assert is_job_header(&t, 0, 9) == false;
    n = put_str(&t, 32, 0, "  :\n", 4);
    assert is_job_header(&t, 0, 3) == false;
    n = put_str(&t, 32, 0, "  a b:\n", 7);
    assert is_job_header(&t, 0, 6) == false;
    n = put_str(&t, 32, 0, "  \n", 3);
    assert is_job_header(&t, 0, 2) == false;
    // a last line with no newline in a reused buffer: the stale byte at e is a colon, and the scan must stop before it
    n = put_str(&t, 32, 0, "  oops:\n", 8);
    assert n == 8;
    assert is_job_header(&t, 0, 6) == false;
}

// put_span `x < cap` -> `x <= cap`: a clipped copy writes nothing at index cap.
test a_clipped_span_writes_nothing_at_cap {
    var t : [16]u8 = undefined;
    const n : usize = put_str(&t, 16, 0, "abcdef", 6);
    var d : [8]u8 = undefined;
    var k : usize = 0;
    while (k < 8) {
        d[k] = 0;
        k += 1;
    }
    assert put_span(&d, 4, 0, &t, 0, n) == 6;
    assert d[3] == 'd';
    assert d[4] == 0;
}
