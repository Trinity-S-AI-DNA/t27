// SPDX-License-Identifier: Apache-2.0
; specs/claw/ledger_union.t27 -- the one merge rule the claw-batch job needs, written once: how the
; t27b expectations ledger of a port pull request folds into a batch branch (#10398, lane 5 of
; the TRI CLAW epic #10393).
; --
; Why it exists: every port pull request appends lines to docs/reports/t27b_expectations.json, so
; any two of them conflict in git even when they touch different specs. The fork batch #10098 was
; folded by hand with a shell loop and a Python union in a scratch folder; this file is that union
; as law, lowered to gen/c/claw/ledger_union.c and called from the claw-batch job in
; .github/workflows/gate-topology.yml.
; --
; The rule, three sides keyed by the path field: base (the merge base), theirs (the pull request
; head), ours (the batch branch so far).
; - The result is ours plus what theirs added over base, sorted by path bytes -- the order the
;   ledger is blessed in.
; - Ours wins where theirs kept the base entry: that is the batch's own progress (master moved on).
; - A key two sides hold with different values is refused, never picked: theirs adding a path ours
;   also added with another verdict, and theirs changing or removing an entry of base that ours
;   does not match.
; - The header and footer are ours; theirs changing either, to something ours does not hold, is
;   refused.
; Fail closed: a side that is not the ledger's shape (one entry per line, two-space indent, a comma
; on every entry but the last, paths strictly ascending, no backslash in a path) is refused too,
; so the result is never a guess. A refusal writes one line naming the reason, the side and the
; path, and the job leaves that pull request out of the batch.
; --
; Two smaller rules the job asks of the same module, so they are law and not grep:
; - marker_lines counts git conflict-marker lines; the batch is checked to hold none.
; - pr_scope decides whether a pull request's file list stays inside specs/port, its own seal and
;   the ledger -- the only shape a batch folds.
; Every string is COUNTED (gen-c lowers str to const char*), the specs/claw/text.t27 idiom.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawLedgerUnion;

use claw::text;

/// The ledger the union is for, as git names it.
pub const LEDGER : str = "docs/reports/t27b_expectations.json";
pub const LEDGER_LEN : usize = 35;

/// Every entry line starts with these bytes; the path runs from here to the next quote.
pub const ENTRY_HEAD : str = "  {\"path\": \"";
pub const ENTRY_HEAD_LEN : usize = 12;

/// The header ends with this key and a newline.
pub const ENTRIES_OPEN : str = "\"entries\": [";
pub const ENTRIES_OPEN_LEN : usize = 12;

/// The footer starts with these bytes; what follows them is whitespace only.
pub const FOOTER : str = " ]\n}";
pub const FOOTER_LEN : usize = 4;

/// Verdicts of ledger_union, in stats[0].
pub const U_OK : u32 = 0;
pub const U_SHAPE : u32 = 1;
pub const U_UNSORTED : u32 = 2;
pub const U_BOTH_ADDED : u32 = 3;
pub const U_THEIRS_CHANGED : u32 = 4;
pub const U_FRAME : u32 = 5;
pub const U_OVERFLOW : u32 = 6;

pub const REASONS : [7]str = [
    "ok",
    "a side is not in the ledger's shape",
    "a side's paths are not strictly ascending",
    "both sides added this path with different values",
    "theirs changed or removed an entry that ours does not match",
    "theirs changed the header or footer and ours differs",
    "the union does not fit the output buffer",
];
pub const REASON_LENS : [7]usize = [2, 35, 41, 48, 59, 52, 40];

/// The sides, in the order ledger_union takes them; stats[3] names one (3 when none applies).
pub const SIDES : [3]str = ["base", "theirs", "ours"];
pub const SIDE_LENS : [3]usize = [4, 6, 4];

/// stats[0] verdict, stats[1] entries theirs added, stats[2] entries written, stats[3] side.
pub const STATS_LEN : usize = 4;

/// Verdicts of pr_scope, in stats[0].
pub const SC_OK : u32 = 0;
pub const SC_OUTSIDE : u32 = 1;
pub const SC_SEAL : u32 = 2;
pub const SC_BAD : u32 = 3;
pub const SC_EMPTY : u32 = 4;

pub const SCOPE_REASONS : [5]str = [
    "in scope",
    "a file outside specs/port, its seal and the ledger",
    "a seal whose spec is not a specs/port file of the same pull request",
    "an unreadable scope record",
    "no files",
];
pub const SCOPE_REASON_LENS : [5]usize = [8, 50, 67, 26, 8];

pub const PORT_DIR : str = "specs/port/";
pub const PORT_DIR_LEN : usize = 11;
pub const SEAL_DIR : str = ".trinity/seals/";
pub const SEAL_DIR_LEN : usize = 15;

/// Index of the newline that ends the line starting at s, or n.
fn lu_eol(x : []const u8, n : usize, s : usize) -> usize {
    var i : usize = s;
    while (i < n and x[i] != '\n') { i += 1; }
    return i;
}

/// Do the bytes of x at s, inside n, spell the counted literal p?
fn lu_at(x : []const u8, n : usize, s : usize, p : str, pn : usize) -> bool {
    if (s + pn > n) { return false; }
    var k : usize = 0;
    while (k < pn) {
        if (x[s + k] != p[k]) { return false; }
        k += 1;
    }
    return true;
}

/// Byte order of a[a0..a1) against b[b0..b1): -1, 0 or 1, a shorter prefix first -- the order of
/// Python's sorted() over path.encode(), which is how the ledger is blessed.
fn lu_cmp(a : []const u8, a0 : usize, a1 : usize, b : []const u8, b0 : usize, b1 : usize) -> i32 {
    var i : usize = 0;
    while (a0 + i < a1 and b0 + i < b1) {
        if (a[a0 + i] < b[b0 + i]) { return -1; }
        if (a[a0 + i] > b[b0 + i]) { return 1; }
        i += 1;
    }
    if (a0 + i < a1) { return 1; }
    if (b0 + i < b1) { return -1; }
    return 0;
}

/// Copy x[s..e) to dst at w, the put_str contract for a buffer instead of a literal.
fn lu_copy(dst : []u8, cap : usize, w : usize, x : []const u8, s : usize, e : usize) -> usize {
    var i : usize = s;
    while (i < e) {
        if (w + (i - s) < cap) { dst[w + (i - s)] = x[i]; }
        i += 1;
    }
    return w + (e - s);
}

/// End of the path that starts at ks on a line ending at e: the closing quote. e when there is no
/// closing quote or the path holds a backslash, which this rule does not unescape.
fn lu_key_end(x : []const u8, e : usize, ks : usize) -> usize {
    var i : usize = ks;
    while (i < e) {
        if (x[i] == '"') { return i; }
        if (x[i] == 92) { return e; }
        i += 1;
    }
    return e;
}

/// End of the value of the entry line starting at p: the line without its trailing comma.
fn lu_val_end(x : []const u8, n : usize, p : usize) -> usize {
    const e : usize = lu_eol(x, n, p);
    if (x[e - 1] == ',') { return e - 1; }
    return e;
}

/// Check one side and find its frame: fr[0] = first entry line, fr[1] = footer. Returns U_OK,
/// U_SHAPE or U_UNSORTED.
fn lu_frame(x : []const u8, n : usize, fr : []usize) -> u32 {
    var s : usize = 0;
    var hs : usize = n;
    while (s < n and hs == n) {
        const e : usize = lu_eol(x, n, s);
        if (lu_at(x, e, s, ENTRY_HEAD, ENTRY_HEAD_LEN)) { hs = s; } else { s = e + 1; }
    }
    // With no entry line hs is n; the checks below, or the empty entry list after them, refuse it.
    if (hs < ENTRIES_OPEN_LEN + 1) { return U_SHAPE; }
    if (lu_at(x, hs - 1, hs - 1 - ENTRIES_OPEN_LEN, ENTRIES_OPEN, ENTRIES_OPEN_LEN) == false) { return U_SHAPE; }
    var p : usize = hs;
    var fe : usize = n;
    var pks : usize = 0;
    var pke : usize = 0;
    var first : bool = true;
    var comma : bool = true;
    while (p < n and fe == n) {
        const e : usize = lu_eol(x, n, p);
        if (lu_at(x, e, p, ENTRY_HEAD, ENTRY_HEAD_LEN) == false) {
            fe = p;
        } else {
            if (comma == false) { return U_SHAPE; }
            const ks : usize = p + ENTRY_HEAD_LEN;
            const ke : usize = lu_key_end(x, e, ks);
            if (ke >= e or ke == ks) { return U_SHAPE; }
            if (x[e - 1] == ',') {
                if (x[e - 2] != '}') { return U_SHAPE; }
                comma = true;
            } else if (x[e - 1] == '}') {
                comma = false;
            } else {
                return U_SHAPE;
            }
            if (first == false) {
                if (lu_cmp(x, pks, pke, x, ks, ke) >= 0) { return U_UNSORTED; }
            }
            pks = ks;
            pke = ke;
            first = false;
            p = e + 1;
        }
    }
    if (fe == n or comma) { return U_SHAPE; }
    if (lu_at(x, n, fe, FOOTER, FOOTER_LEN) == false) { return U_SHAPE; }
    var t : usize = fe + FOOTER_LEN;
    while (t < n) {
        if (x[t] != '\n' and x[t] != ' ' and x[t] != 13) { return U_SHAPE; }
        t += 1;
    }
    fr[0] = hs;
    fr[1] = fe;
    return U_OK;
}

/// The refusal line into out, and the verdict into stats: "refused: <reason> (<side>)", then
/// ": <path>" when x[ks..ke) names one.
fn lu_refuse(out : []u8, cap : usize, stats : []u32, code : u32, side : u32, x : []const u8, ks : usize, ke : usize) -> usize {
    stats[0] = code;
    stats[3] = side;
    var w : usize = put_str(out, cap, 0, "refused: ", 9);
    w = put_str(out, cap, w, REASONS[(code) as usize], REASON_LENS[(code) as usize]);
    w = put_str(out, cap, w, " (", 2);
    w = put_str(out, cap, w, SIDES[(side) as usize], SIDE_LENS[(side) as usize]);
    w = put_str(out, cap, w, ")", 1);
    if (ke > ks) {
        w = put_str(out, cap, w, ": ", 2);
        w = lu_copy(out, cap, w, x, ks, ke);
    }
    return put_str(out, cap, w, "\n", 1);
}

/// The union of the ledger texts base b[0..bn), theirs t[0..tn) and ours o[0..on), into out.
/// Returns the bytes written. stats[0] is U_OK when out holds the merged ledger; any other verdict
/// means out holds one refusal line instead. U_OVERFLOW: the return exceeds cap and out is clipped.
pub fn ledger_union(b : []const u8, bn : usize, t : []const u8, tn : usize, o : []const u8, on : usize, out : []u8, cap : usize, stats : []u32) -> usize {
    var k : usize = 0;
    while (k < STATS_LEN) {
        stats[k] = 0;
        k += 1;
    }
    stats[3] = 3;
    var fb : [2]usize = undefined;
    var ft : [2]usize = undefined;
    var fo : [2]usize = undefined;
    var c : u32 = lu_frame(b, bn, &fb);
    if (c != U_OK) { return lu_refuse(out, cap, stats, c, 0, b, 0, 0); }
    c = lu_frame(t, tn, &ft);
    if (c != U_OK) { return lu_refuse(out, cap, stats, c, 1, t, 0, 0); }
    c = lu_frame(o, on, &fo);
    if (c != U_OK) { return lu_refuse(out, cap, stats, c, 2, o, 0, 0); }
    if (lu_cmp(t, 0, ft[0], b, 0, fb[0]) != 0 and lu_cmp(t, 0, ft[0], o, 0, fo[0]) != 0) {
        return lu_refuse(out, cap, stats, U_FRAME, 1, t, 0, 0);
    }
    if (lu_cmp(t, ft[1], tn, b, fb[1], bn) != 0 and lu_cmp(t, ft[1], tn, o, fo[1], on) != 0) {
        return lu_refuse(out, cap, stats, U_FRAME, 1, t, 0, 0);
    }
    var w : usize = lu_copy(out, cap, 0, o, 0, fo[0]);
    var pb : usize = fb[0];
    var pt : usize = ft[0];
    var po : usize = fo[0];
    var count : u32 = 0;
    var added : u32 = 0;
    while (pb < fb[1] or pt < ft[1] or po < fo[1]) {
        const hb : bool = pb < fb[1];
        const ht : bool = pt < ft[1];
        const ho : bool = po < fo[1];
        var kbs : usize = 0;
        var kbe : usize = 0;
        var kts : usize = 0;
        var kte : usize = 0;
        var kos : usize = 0;
        var koe : usize = 0;
        if (hb) {
            kbs = pb + ENTRY_HEAD_LEN;
            kbe = lu_key_end(b, bn, kbs);
        }
        if (ht) {
            kts = pt + ENTRY_HEAD_LEN;
            kte = lu_key_end(t, tn, kts);
        }
        if (ho) {
            kos = po + ENTRY_HEAD_LEN;
            koe = lu_key_end(o, on, kos);
        }
        // The smallest key, ties going to the earlier side: 0 base, 1 theirs, 2 ours.
        var m : u32 = 3;
        if (hb) { m = 0; }
        if (ht) {
            if (m == 3) {
                m = 1;
            } else if (lu_cmp(t, kts, kte, b, kbs, kbe) < 0) {
                m = 1;
            }
        }
        if (ho) {
            if (m == 3) {
                m = 2;
            } else if (m == 0) {
                if (lu_cmp(o, kos, koe, b, kbs, kbe) < 0) { m = 2; }
            } else if (lu_cmp(o, kos, koe, t, kts, kte) < 0) {
                m = 2;
            }
        }
        var in_b : bool = false;
        var in_t : bool = false;
        var in_o : bool = false;
        if (m == 0) {
            in_b = true;
            in_t = ht and lu_cmp(t, kts, kte, b, kbs, kbe) == 0;
            in_o = ho and lu_cmp(o, kos, koe, b, kbs, kbe) == 0;
        } else if (m == 1) {
            in_t = true;
            in_o = ho and lu_cmp(o, kos, koe, t, kts, kte) == 0;
        } else {
            in_o = true;
        }
        var vbe : usize = 0;
        var vte : usize = 0;
        var voe : usize = 0;
        if (in_b) { vbe = lu_val_end(b, bn, pb); }
        if (in_t) { vte = lu_val_end(t, tn, pt); }
        if (in_o) { voe = lu_val_end(o, on, po); }
        var same_tb : bool = in_t == in_b;
        if (same_tb and in_b) { same_tb = lu_cmp(t, pt, vte, b, pb, vbe) == 0; }
        var same_ot : bool = in_o == in_t;
        if (same_ot and in_t) { same_ot = lu_cmp(o, po, voe, t, pt, vte) == 0; }
        var emit : u32 = 3;
        if (same_tb or same_ot) {
            if (in_o) { emit = 2; }
        } else if (in_b == false and in_o == false) {
            emit = 1;
            added += 1;
        } else if (in_b == false) {
            return lu_refuse(out, cap, stats, U_BOTH_ADDED, 1, t, kts, kte);
        } else {
            return lu_refuse(out, cap, stats, U_THEIRS_CHANGED, 1, b, kbs, kbe);
        }
        if (emit != 3) {
            if (count > 0) { w = put_str(out, cap, w, ",\n", 2); }
            if (emit == 2) { w = lu_copy(out, cap, w, o, po, voe); } else { w = lu_copy(out, cap, w, t, pt, vte); }
            count += 1;
        }
        if (in_b) { pb = lu_eol(b, bn, pb) + 1; }
        if (in_t) { pt = lu_eol(t, tn, pt) + 1; }
        if (in_o) { po = lu_eol(o, on, po) + 1; }
    }
    w = put_str(out, cap, w, "\n", 1);
    w = lu_copy(out, cap, w, o, fo[1], on);
    stats[1] = added;
    stats[2] = count;
    if (w > cap) { stats[0] = U_OVERFLOW; }
    return w;
}

/// Git conflict-marker lines in x[0..n): a line whose first seven bytes are all '<', all '=', all
/// '>' or all '|'. A batch is checked to hold none.
pub fn marker_lines(x : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    var s : usize = 0;
    while (s < n) {
        const e : usize = lu_eol(x, n, s);
        if (e - s >= 7) {
            const m : u8 = x[s];
            if (m == '<' or m == '=' or m == '>' or m == '|') {
                var j : usize = 1;
                while (j < 7 and x[s + j] == m) { j += 1; }
                if (j == 7) { c += 1; }
            }
        }
        s = e + 1;
    }
    return c;
}

/// Does x[s..e) end with the counted literal p?
fn lu_ends(x : []const u8, s : usize, e : usize, p : str, pn : usize) -> bool {
    if (e - s < pn) { return false; }
    return lu_at(x, e, e - pn, p, pn);
}

/// Is x[s..e) a .t27 file under specs/port with no ".." in it?
fn lu_port_spec(x : []const u8, s : usize, e : usize) -> bool {
    if (lu_at(x, e, s, PORT_DIR, PORT_DIR_LEN) == false) { return false; }
    if (lu_ends(x, s, e, ".t27", 4) == false) { return false; }
    var i : usize = s;
    while (i + 1 < e) {
        if (x[i] == '.' and x[i + 1] == '.') { return false; }
        i += 1;
    }
    return true;
}

/// Index of the first tab in x[s..e), or e.
fn lu_tab(x : []const u8, s : usize, e : usize) -> usize {
    var i : usize = s;
    while (i < e and x[i] != '\t') { i += 1; }
    return i;
}

/// Is there a record with tag g whose second field equals x[fs..fe)? Returns the index just past
/// that field (its tab, or the line end), n when there is none.
fn lu_find(x : []const u8, n : usize, g : u8, fs : usize, fe : usize) -> usize {
    var s : usize = 0;
    while (s < n) {
        const e : usize = lu_eol(x, n, s);
        if (e > s + 1 and x[s] == g and x[s + 1] == '\t') {
            const t : usize = lu_tab(x, s + 2, e);
            if (lu_cmp(x, s + 2, t, x, fs, fe) == 0) { return t; }
        }
        s = e + 1;
    }
    return n;
}

/// Does the seal x[ps..pe) have an S record naming a specs/port .t27 file that is also an F record?
fn lu_seal_ok(x : []const u8, n : usize, ps : usize, pe : usize) -> bool {
    // sp is the tab before the spec field; with no S record, or one without a spec field, it is
    // the end of a line or of x, the spec range below is empty or reversed, and lu_port_spec
    // refuses it at its prefix check.
    const sp : usize = lu_find(x, n, 'S', ps, pe);
    const se : usize = lu_eol(x, n, sp);
    if (lu_port_spec(x, sp + 1, se) == false) { return false; }
    return lu_find(x, n, 'F', sp + 1, se) < n;
}

/// Whether one pull request may join a port batch. The records in x[0..n), one per line:
///   F<TAB><path>                 every file the pull request changes
///   S<TAB><seal path><TAB><spec> each changed seal and the spec_path field it records
/// In scope: every F is the ledger, a specs/port .t27 file, or a .trinity/seals/*.json whose S
/// record names a specs/port .t27 file that is itself an F of the same pull request. Returns the
/// bytes of the refusal line written to out (0 when in scope); stats[0] verdict, stats[1] files.
pub fn pr_scope(x : []const u8, n : usize, out : []u8, cap : usize, stats : []u32) -> usize {
    stats[0] = SC_OK;
    stats[1] = 0;
    var code : u32 = SC_OK;
    var bs : usize = 0;
    var be : usize = 0;
    var s : usize = 0;
    while (s < n and code == SC_OK) {
        const e : usize = lu_eol(x, n, s);
        if (e > s) {
            const tagged : bool = e > s + 2 and x[s + 1] == '\t';
            if (tagged and x[s] == 'F') {
                stats[1] += 1;
                const ps : usize = s + 2;
                const ledger : bool = e - ps == LEDGER_LEN and lu_at(x, e, ps, LEDGER, LEDGER_LEN);
                if (lu_tab(x, ps, e) < e) {
                    code = SC_BAD;
                } else if (ledger == false and lu_port_spec(x, ps, e) == false) {
                    if (lu_at(x, e, ps, SEAL_DIR, SEAL_DIR_LEN) and lu_ends(x, ps, e, ".json", 5)) {
                        if (lu_seal_ok(x, n, ps, e) == false) { code = SC_SEAL; }
                    } else {
                        code = SC_OUTSIDE;
                    }
                }
                if (code != SC_OK) {
                    bs = ps;
                    be = e;
                }
            } else if (tagged and x[s] == 'S') {
                const t : usize = lu_tab(x, s + 2, e);
                if (t >= e or t == s + 2) {
                    code = SC_BAD;
                    bs = s;
                    be = e;
                }
            } else {
                code = SC_BAD;
                bs = s;
                be = e;
            }
        }
        s = e + 1;
    }
    if (code == SC_OK and stats[1] == 0) { code = SC_EMPTY; }
    if (code == SC_OK) { return 0; }
    stats[0] = code;
    var w : usize = put_str(out, cap, 0, "refused: ", 9);
    w = put_str(out, cap, w, SCOPE_REASONS[(code) as usize], SCOPE_REASON_LENS[(code) as usize]);
    if (be > bs) {
        w = put_str(out, cap, w, ": ", 2);
        w = lu_copy(out, cap, w, x, bs, be);
    }
    return put_str(out, cap, w, "\n", 1);
}

// Test fixtures: the frame and line builders the tests below share.

/// The frame of a test ledger: the real one carries more header keys, none of which the rule reads.
pub const FIX_HEAD : str = "{\n \"entries\": [\n";
pub const FIX_HEAD_LEN : usize = 16;
pub const FIX_FOOT : str = " ]\n}\n";
pub const FIX_FOOT_LEN : usize = 5;

/// One entry line as the ratchet blesses it: path, verdict, a comma unless last, a newline.
fn fixture_line(dst : []u8, cap : usize, w : usize, path : str, plen : usize, verdict : str, vlen : usize, last : bool) -> usize {
    var x : usize = put_str(dst, cap, w, ENTRY_HEAD, ENTRY_HEAD_LEN);
    x = put_str(dst, cap, x, path, plen);
    x = put_str(dst, cap, x, "\", \"t27b\": \"", 12);
    x = put_str(dst, cap, x, verdict, vlen);
    x = put_str(dst, cap, x, "\"}", 2);
    if (last == false) { x = put_str(dst, cap, x, ",", 1); }
    return put_str(dst, cap, x, "\n", 1);
}

/// The trios-chat ledger paths of the real #10098 conflict (PR #9945 into the fork batch).
pub const CHAT_A : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-02/src/epoch_rollover_wraparound_guard.t27";
pub const CHAT_B : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-03/src/pcs_healing.t27";
pub const CHAT_C : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-03/src/proposal_ref_collision.t27";
pub const CHAT_D : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-03/src/proposal_validation.t27";
pub const CHAT_E : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-03/src/ratchet_tree_resolution_guard.t27";
pub const CHAT_F : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-03/src/ratchet_tree_update_integrity_guard.t27";
pub const CHAT_G : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-03/src/unmerged_leaves_bound_guard.t27";

/// Three tiny sides with two-letter paths, for the negative controls: base {aa, cc}, then whatever
/// the test writes.
fn fixture_pair(dst : []u8, cap : usize, p1 : str, v1 : str, v1n : usize, p2 : str, v2 : str, v2n : usize) -> usize {
    var w : usize = put_str(dst, cap, 0, FIX_HEAD, FIX_HEAD_LEN);
    w = fixture_line(dst, cap, w, p1, 2, v1, v1n, false);
    w = fixture_line(dst, cap, w, p2, 2, v2, v2n, true);
    return put_str(dst, cap, w, FIX_FOOT, FIX_FOOT_LEN);
}

test replays_the_ledger_conflict_of_pr_9945_in_the_10098_batch {
    // The entries around the conflict, byte for byte from git: base cd8a65666 (lines 853-855),
    // theirs = PR #9945 head (853-856), ours = the batch before it, 9ce20d7d6^1 (855 and 871-875;
    // 856-870 are left out, they sort outside the conflict). The batch commit 9ce20d7d6 holds the
    // expected order: theirs' proposal_validation lands between ours' two additions and the guard.
    var b : [2048]u8 = undefined;
    var bn : usize = put_str(&b, 2048, 0, FIX_HEAD, FIX_HEAD_LEN);
    bn = fixture_line(&b, 2048, bn, CHAT_A, 91, "pass", 4, false);
    bn = fixture_line(&b, 2048, bn, CHAT_E, 89, "pass", 4, false);
    bn = fixture_line(&b, 2048, bn, CHAT_G, 87, "pass", 4, true);
    bn = put_str(&b, 2048, bn, FIX_FOOT, FIX_FOOT_LEN);
    var t : [2048]u8 = undefined;
    var tn : usize = put_str(&t, 2048, 0, FIX_HEAD, FIX_HEAD_LEN);
    tn = fixture_line(&t, 2048, tn, CHAT_A, 91, "pass", 4, false);
    tn = fixture_line(&t, 2048, tn, CHAT_D, 79, "pass", 4, false);
    tn = fixture_line(&t, 2048, tn, CHAT_E, 89, "pass", 4, false);
    tn = fixture_line(&t, 2048, tn, CHAT_G, 87, "pass", 4, true);
    tn = put_str(&t, 2048, tn, FIX_FOOT, FIX_FOOT_LEN);
    var o : [2048]u8 = undefined;
    var on : usize = put_str(&o, 2048, 0, FIX_HEAD, FIX_HEAD_LEN);
    on = fixture_line(&o, 2048, on, CHAT_A, 91, "pass", 4, false);
    on = fixture_line(&o, 2048, on, CHAT_B, 71, "pass", 4, false);
    on = fixture_line(&o, 2048, on, CHAT_C, 82, "pass", 4, false);
    on = fixture_line(&o, 2048, on, CHAT_E, 89, "pass", 4, false);
    on = fixture_line(&o, 2048, on, CHAT_F, 95, "pass", 4, false);
    on = fixture_line(&o, 2048, on, CHAT_G, 87, "pass", 4, true);
    on = put_str(&o, 2048, on, FIX_FOOT, FIX_FOOT_LEN);
    var x : [2048]u8 = undefined;
    var xn : usize = put_str(&x, 2048, 0, FIX_HEAD, FIX_HEAD_LEN);
    xn = fixture_line(&x, 2048, xn, CHAT_A, 91, "pass", 4, false);
    xn = fixture_line(&x, 2048, xn, CHAT_B, 71, "pass", 4, false);
    xn = fixture_line(&x, 2048, xn, CHAT_C, 82, "pass", 4, false);
    xn = fixture_line(&x, 2048, xn, CHAT_D, 79, "pass", 4, false);
    xn = fixture_line(&x, 2048, xn, CHAT_E, 89, "pass", 4, false);
    xn = fixture_line(&x, 2048, xn, CHAT_F, 95, "pass", 4, false);
    xn = fixture_line(&x, 2048, xn, CHAT_G, 87, "pass", 4, true);
    xn = put_str(&x, 2048, xn, FIX_FOOT, FIX_FOOT_LEN);
    var out : [4096]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &t, tn, &o, on, &out, 4096, &st);
    assert st[0] == U_OK;
    assert st[1] == 1;
    assert st[2] == 7;
    assert m == xn;
    assert lu_cmp(&out, 0, m, &x, 0, xn) == 0;
    assert marker_lines(&out, m) == 0;
}

test the_same_addition_on_both_sides_is_written_once {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var t : [512]u8 = undefined;
    var tn : usize = put_str(&t, 512, 0, FIX_HEAD, FIX_HEAD_LEN);
    tn = fixture_line(&t, 512, tn, "aa", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "bb", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "cc", 2, "pass", 4, true);
    tn = put_str(&t, 512, tn, FIX_FOOT, FIX_FOOT_LEN);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &t, tn, &t, tn, &out, 1024, &st);
    assert st[0] == U_OK;
    assert st[1] == 0;
    assert st[2] == 3;
    assert m == tn;
    assert lu_cmp(&out, 0, m, &t, 0, tn) == 0;
}

test ours_progress_wins_where_theirs_kept_the_base_entry {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "unimplemented", 13, "cc", "pass", 4);
    var o : [256]u8 = undefined;
    const on : usize = fixture_pair(&o, 256, "aa", "pass", 4, "cc", "pass", 4);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &b, bn, &o, on, &out, 1024, &st);
    assert st[0] == U_OK;
    assert st[2] == 2;
    assert m == on;
    assert lu_cmp(&out, 0, m, &o, 0, on) == 0;
}

test ours_removing_an_entry_theirs_kept_stays_removed {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var o : [256]u8 = undefined;
    var on : usize = put_str(&o, 256, 0, FIX_HEAD, FIX_HEAD_LEN);
    on = fixture_line(&o, 256, on, "cc", 2, "pass", 4, true);
    on = put_str(&o, 256, on, FIX_FOOT, FIX_FOOT_LEN);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &b, bn, &o, on, &out, 1024, &st);
    assert st[0] == U_OK;
    assert st[2] == 1;
    assert lu_cmp(&out, 0, m, &o, 0, on) == 0;
}

test two_additions_of_one_path_with_different_verdicts_are_refused {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var t : [512]u8 = undefined;
    var tn : usize = put_str(&t, 512, 0, FIX_HEAD, FIX_HEAD_LEN);
    tn = fixture_line(&t, 512, tn, "aa", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "bb", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "cc", 2, "pass", 4, true);
    tn = put_str(&t, 512, tn, FIX_FOOT, FIX_FOOT_LEN);
    var o : [512]u8 = undefined;
    var on : usize = put_str(&o, 512, 0, FIX_HEAD, FIX_HEAD_LEN);
    on = fixture_line(&o, 512, on, "aa", 2, "pass", 4, false);
    on = fixture_line(&o, 512, on, "bb", 2, "unimplemented", 13, false);
    on = fixture_line(&o, 512, on, "cc", 2, "pass", 4, true);
    on = put_str(&o, 512, on, FIX_FOOT, FIX_FOOT_LEN);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &t, tn, &o, on, &out, 1024, &st);
    assert st[0] == U_BOTH_ADDED;
    assert st[3] == 1;
    assert buf_has(&out, m, "refused: both sides added this path with different values (theirs): bb\n", 71) == true;
}

test theirs_changing_a_base_entry_is_refused {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var t : [256]u8 = undefined;
    const tn : usize = fixture_pair(&t, 256, "aa", "pass", 4, "cc", "unimplemented", 13);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &t, tn, &b, bn, &out, 1024, &st);
    assert st[0] == U_THEIRS_CHANGED;
    assert buf_has(&out, m, "(theirs): cc\n", 13) == true;
}

