test a_header_theirs_changed_is_refused_and_one_ours_changed_is_kept {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var h : [256]u8 = undefined;
    var hn : usize = put_str(&h, 256, 0, "{\n \"max_not_pass\": 74,\n \"entries\": [\n", 37);
    hn = fixture_line(&h, 256, hn, "aa", 2, "pass", 4, false);
    hn = fixture_line(&h, 256, hn, "cc", 2, "pass", 4, true);
    hn = put_str(&h, 256, hn, FIX_FOOT, FIX_FOOT_LEN);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    var m : usize = ledger_union(&b, bn, &h, hn, &b, bn, &out, 1024, &st);
    assert st[0] == U_FRAME;
    m = ledger_union(&b, bn, &b, bn, &h, hn, &out, 1024, &st);
    assert st[0] == U_OK;
    assert m == hn;
    assert lu_cmp(&out, 0, m, &h, 0, hn) == 0;
}

test a_side_out_of_order_or_with_a_duplicate_is_refused {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var u : [256]u8 = undefined;
    const un : usize = fixture_pair(&u, 256, "cc", "pass", 4, "aa", "pass", 4);
    var d : [256]u8 = undefined;
    const dn : usize = fixture_pair(&d, 256, "aa", "pass", 4, "aa", "pass", 4);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    var m : usize = ledger_union(&b, bn, &u, un, &b, bn, &out, 1024, &st);
    assert st[0] == U_UNSORTED;
    assert st[3] == 1;
    m = ledger_union(&b, bn, &b, bn, &d, dn, &out, 1024, &st);
    assert st[0] == U_UNSORTED;
    assert st[3] == 2;
    assert buf_has(&out, m, "(ours)", 6) == true;
}

test a_side_not_in_the_ledger_shape_is_refused {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    // The last entry carries a comma.
    var x : [256]u8 = undefined;
    var xn : usize = put_str(&x, 256, 0, FIX_HEAD, FIX_HEAD_LEN);
    xn = fixture_line(&x, 256, xn, "aa", 2, "pass", 4, false);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    var m : usize = ledger_union(&b, bn, &x, xn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    // A middle entry lacks its comma.
    xn = put_str(&x, 256, 0, FIX_HEAD, FIX_HEAD_LEN);
    xn = fixture_line(&x, 256, xn, "aa", 2, "pass", 4, true);
    xn = fixture_line(&x, 256, xn, "cc", 2, "pass", 4, true);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    m = ledger_union(&b, bn, &x, xn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    // A path with a backslash.
    xn = fixture_pair(&x, 256, "aa", "pass", 4, "c\\", "pass", 4);
    m = ledger_union(&b, bn, &x, xn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    // No footer.
    m = ledger_union(&b, bn - FIX_FOOT_LEN, &b, bn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    assert st[3] == 0;
    // Conflict markers in place of entries.
    xn = put_str(&x, 256, 0, FIX_HEAD, FIX_HEAD_LEN);
    xn = put_str(&x, 256, xn, "<<<<<<< HEAD\n", 13);
    xn = fixture_line(&x, 256, xn, "aa", 2, "pass", 4, true);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    m = ledger_union(&b, bn, &b, bn, &x, xn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    assert buf_has(&out, m, "refused: a side is not in the ledger's shape (ours)\n", 52) == true;
}

test a_union_too_big_for_the_buffer_says_so {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var out : [16]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &b, bn, &b, bn, &out, 16, &st);
    assert st[0] == U_OVERFLOW;
    assert m == bn;
    assert m > 16;
    // A buffer of exactly the union's size is enough, one byte less is not.
    var fit : [256]u8 = undefined;
    var k : usize = ledger_union(&b, bn, &b, bn, &b, bn, &fit, bn, &st);
    assert st[0] == U_OK;
    assert k == bn;
    k = ledger_union(&b, bn, &b, bn, &b, bn, &fit, bn - 1, &st);
    assert st[0] == U_OVERFLOW;
}

test the_byte_helpers_stay_inside_their_ranges {
    var x : [16]u8 = undefined;
    const n : usize = put_str(&x, 16, 0, "abz.t27", 7);
    var y : [16]u8 = undefined;
    const yn : usize = put_str(&y, 16, 0, "abc", 3);
    // A line search, a literal match and a comparison never read past their bounds.
    assert lu_eol(&x, 3, 0) == 3;
    assert lu_at(&x, 2, 0, "abz", 3) == false;
    assert lu_at(&x, 3, 0, "abz", 3) == true;
    assert lu_cmp(&x, 0, 2, &y, 0, 2) == 0;
    assert lu_cmp(&x, 0, 2, &y, 0, yn) == -1;
    // A shorter prefix sorts first, from either side.
    assert lu_cmp(&x, 0, 2, &x, 0, 3) == -1;
    assert lu_cmp(&x, 0, 3, &x, 0, 2) == 1;
    // A suffix match needs the whole suffix inside the range.
    assert lu_ends(&x, 3, n, ".t27", 4) == true;
    assert lu_ends(&x, 5, n, ".t27", 4) == false;
    // A copy writes only its range, and only below cap.
    var d : [8]u8 = undefined;
    var w : usize = put_str(&d, 8, 0, "zzzz", 4);
    w = lu_copy(&d, 8, 0, &x, 3, 5);
    assert w == 2;
    assert d[2] == 'z';
    w = put_str(&d, 8, 0, "zzzz", 4);
    w = lu_copy(&d, 2, 0, &x, 3, 5);
    assert d[0] == '.';
    assert d[1] == 't';
}

test the_header_must_end_with_the_entries_key {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var x : [256]u8 = undefined;
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    // Another key in its place.
    var xn : usize = put_str(&x, 256, 0, "{\n \"rows\": [\n", 13);
    xn = fixture_line(&x, 256, xn, "aa", 2, "pass", 4, true);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    var m : usize = ledger_union(&x, xn, &b, bn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    assert st[3] == 0;
    // A space between the key and the newline.
    xn = put_str(&x, 256, 0, "{\n \"entries\": [ \n", 17);
    xn = fixture_line(&x, 256, xn, "aa", 2, "pass", 4, true);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    m = ledger_union(&x, xn, &b, bn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    // An entry on the first line, with no header at all.
    xn = fixture_line(&x, 256, 0, "aa", 2, "pass", 4, true);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    m = ledger_union(&x, xn, &b, bn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    // No entries.
    xn = put_str(&x, 256, 0, FIX_HEAD, FIX_HEAD_LEN);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    m = ledger_union(&x, xn, &b, bn, &b, bn, &out, 1024, &st);
    assert st[0] == U_SHAPE;
    // The shortest header, the key line alone, is enough.
    xn = put_str(&x, 256, 0, "\"entries\": [\n", 13);
    xn = fixture_line(&x, 256, xn, "aa", 2, "pass", 4, true);
    xn = put_str(&x, 256, xn, FIX_FOOT, FIX_FOOT_LEN);
    m = ledger_union(&x, xn, &x, xn, &x, xn, &out, 1024, &st);
    assert st[0] == U_OK;
    assert m == xn;
}

test a_footer_theirs_changed_is_refused_and_a_frame_both_changed_agrees {
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    // The same entries with one more newline after the footer, which the shape allows.
    var f : [256]u8 = undefined;
    var fz : usize = put_str(&f, 256, 0, FIX_HEAD, FIX_HEAD_LEN);
    fz = fixture_line(&f, 256, fz, "aa", 2, "pass", 4, false);
    fz = fixture_line(&f, 256, fz, "cc", 2, "pass", 4, true);
    fz = put_str(&f, 256, fz, " ]\n}\n\n", 6);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    var m : usize = ledger_union(&b, bn, &f, fz, &b, bn, &out, 1024, &st);
    assert st[0] == U_FRAME;
    assert st[3] == 1;
    m = ledger_union(&b, bn, &f, fz, &f, fz, &out, 1024, &st);
    assert st[0] == U_OK;
    assert m == fz;
    assert lu_cmp(&out, 0, m, &f, 0, fz) == 0;
    m = ledger_union(&b, bn, &b, bn, &f, fz, &out, 1024, &st);
    assert st[0] == U_OK;
    assert lu_cmp(&out, 0, m, &f, 0, fz) == 0;
    // A header both sides changed the same way agrees too.
    var h : [256]u8 = undefined;
    var hn : usize = put_str(&h, 256, 0, "{\n \"max_not_pass\": 74,\n \"entries\": [\n", 37);
    hn = fixture_line(&h, 256, hn, "aa", 2, "pass", 4, false);
    hn = fixture_line(&h, 256, hn, "cc", 2, "pass", 4, true);
    hn = put_str(&h, 256, hn, FIX_FOOT, FIX_FOOT_LEN);
    m = ledger_union(&b, bn, &h, hn, &h, hn, &out, 1024, &st);
    assert st[0] == U_OK;
    assert lu_cmp(&out, 0, m, &h, 0, hn) == 0;
}

test additions_at_either_end_of_the_ledger_are_kept {
    // Theirs adds a path before the first entry (a prefix of it, so it sorts first) and one after
    // the last; ours adds one after the last too. The merge runs until all three sides are spent.
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var t : [512]u8 = undefined;
    var tn : usize = put_str(&t, 512, 0, FIX_HEAD, FIX_HEAD_LEN);
    tn = fixture_line(&t, 512, tn, "a", 1, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "aa", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "cc", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "dd", 2, "pass", 4, true);
    tn = put_str(&t, 512, tn, FIX_FOOT, FIX_FOOT_LEN);
    var o : [512]u8 = undefined;
    var on : usize = put_str(&o, 512, 0, FIX_HEAD, FIX_HEAD_LEN);
    on = fixture_line(&o, 512, on, "aa", 2, "pass", 4, false);
    on = fixture_line(&o, 512, on, "cc", 2, "pass", 4, false);
    on = fixture_line(&o, 512, on, "ee", 2, "pass", 4, true);
    on = put_str(&o, 512, on, FIX_FOOT, FIX_FOOT_LEN);
    var x : [512]u8 = undefined;
    var xn : usize = put_str(&x, 512, 0, FIX_HEAD, FIX_HEAD_LEN);
    xn = fixture_line(&x, 512, xn, "a", 1, "pass", 4, false);
    xn = fixture_line(&x, 512, xn, "aa", 2, "pass", 4, false);
    xn = fixture_line(&x, 512, xn, "cc", 2, "pass", 4, false);
    xn = fixture_line(&x, 512, xn, "dd", 2, "pass", 4, false);
    xn = fixture_line(&x, 512, xn, "ee", 2, "pass", 4, true);
    xn = put_str(&x, 512, xn, FIX_FOOT, FIX_FOOT_LEN);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &t, tn, &o, on, &out, 1024, &st);
    assert st[0] == U_OK;
    assert st[1] == 2;
    assert st[2] == 5;
    assert m == xn;
    assert lu_cmp(&out, 0, m, &x, 0, xn) == 0;
}

test an_addition_of_theirs_after_ours_is_spent_is_kept {
    // Base and ours end at cc; theirs goes on to dd, which the merge must still reach.
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var t : [512]u8 = undefined;
    var tn : usize = put_str(&t, 512, 0, FIX_HEAD, FIX_HEAD_LEN);
    tn = fixture_line(&t, 512, tn, "aa", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "cc", 2, "pass", 4, false);
    tn = fixture_line(&t, 512, tn, "dd", 2, "pass", 4, true);
    tn = put_str(&t, 512, tn, FIX_FOOT, FIX_FOOT_LEN);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &t, tn, &b, bn, &out, 1024, &st);
    assert st[0] == U_OK;
    assert st[1] == 1;
    assert st[2] == 3;
    assert m == tn;
    assert lu_cmp(&out, 0, m, &t, 0, tn) == 0;
}

test both_sides_removing_one_entry_agree {
    // Theirs and ours both dropped aa; ours also added bb, which sorts between aa and cc.
    var b : [256]u8 = undefined;
    const bn : usize = fixture_pair(&b, 256, "aa", "pass", 4, "cc", "pass", 4);
    var t : [256]u8 = undefined;
    var tn : usize = put_str(&t, 256, 0, FIX_HEAD, FIX_HEAD_LEN);
    tn = fixture_line(&t, 256, tn, "cc", 2, "pass", 4, true);
    tn = put_str(&t, 256, tn, FIX_FOOT, FIX_FOOT_LEN);
    var o : [256]u8 = undefined;
    const on : usize = fixture_pair(&o, 256, "bb", "pass", 4, "cc", "pass", 4);
    var out : [1024]u8 = undefined;
    var st : [4]u32 = undefined;
    const m : usize = ledger_union(&b, bn, &t, tn, &o, on, &out, 1024, &st);
    assert st[0] == U_OK;
    assert st[1] == 0;
    assert st[2] == 2;
    assert m == on;
    assert lu_cmp(&out, 0, m, &o, 0, on) == 0;
}

test marker_lines_counts_only_full_markers_at_a_line_start {
    var x : [256]u8 = undefined;
    var n : usize = put_str(&x, 256, 0, "<<<<<<< HEAD\na\n=======\nb\n>>>>>>> pr\n", 36);
    assert marker_lines(&x, n) == 3;
    n = put_str(&x, 256, 0, "<<<<<< six\n a =======\n|||||||\n", 30);
    assert marker_lines(&x, n) == 1;
    n = put_str(&x, 256, 0, "{\"a\": \"=======\"}\n", 17);
    assert marker_lines(&x, n) == 0;
    // Eight in a row still start with seven.
    n = put_str(&x, 256, 0, "========\n", 9);
    assert marker_lines(&x, n) == 1;
    // Only the first n bytes count: a marker cut short by n is not one.
    n = put_str(&x, 256, 0, "aaaa\n<<<<<<<\n", 13);
    assert marker_lines(&x, 8) == 0;
    assert marker_lines(&x, n) == 1;
}

test a_port_spec_its_seal_and_the_ledger_are_in_scope {
    var x : [512]u8 = undefined;
    var n : usize = put_str(&x, 512, 0, "F\tdocs/reports/t27b_expectations.json\n", 38);
    n = put_str(&x, 512, n, "F\tspecs/port/a/b.t27\n", 21);
    n = put_str(&x, 512, n, "F\t.trinity/seals/port::a::b.json\n", 33);
    n = put_str(&x, 512, n, "S\t.trinity/seals/port::a::b.json\tspecs/port/a/b.t27\n", 52);
    var out : [256]u8 = undefined;
    var st : [2]u32 = undefined;
    const m : usize = pr_scope(&x, n, &out, 256, &st);
    assert m == 0;
    assert st[0] == SC_OK;
    assert st[1] == 3;
}

test a_file_outside_the_port_shape_is_named {
    var x : [512]u8 = undefined;
    var n : usize = put_str(&x, 512, 0, "F\tspecs/port/a/b.t27\n", 21);
    n = put_str(&x, 512, n, "F\t.github/workflows/x.yml\n", 26);
    var out : [256]u8 = undefined;
    var st : [2]u32 = undefined;
    var m : usize = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
    assert buf_has(&out, m, ": .github/workflows/x.yml\n", 26) == true;
    n = put_str(&x, 512, 0, "F\tspecs/port/../claw/text.t27\n", 30);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
    n = put_str(&x, 512, 0, "F\tspecs/port/a/b.zig\n", 21);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
}

test a_seal_counts_only_with_its_own_port_spec {
    var x : [512]u8 = undefined;
    var out : [256]u8 = undefined;
    var st : [2]u32 = undefined;
    // No S record for the seal.
    var n : usize = put_str(&x, 512, 0, "F\t.trinity/seals/port::a::b.json\n", 33);
    var m : usize = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_SEAL;
    // The spec it seals is not part of the pull request.
    n = put_str(&x, 512, n, "S\t.trinity/seals/port::a::b.json\tspecs/port/a/b.t27\n", 52);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_SEAL;
    // It seals a spec outside specs/port.
    n = put_str(&x, 512, 0, "F\t.trinity/seals/claw_X.json\nF\tspecs/claw/x.t27\n", 48);
    n = put_str(&x, 512, n, "S\t.trinity/seals/claw_X.json\tspecs/claw/x.t27\n", 46);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_SEAL;
    assert buf_has(&out, m, ": .trinity/seals/claw_X.json\n", 29) == true;
}

test an_empty_or_unreadable_file_list_is_refused {
    var x : [128]u8 = undefined;
    var out : [256]u8 = undefined;
    var st : [2]u32 = undefined;
    var m : usize = pr_scope(&x, 0, &out, 256, &st);
    assert st[0] == SC_EMPTY;
    assert m == 18;
    assert buf_has(&out, m, "refused: no files\n", 18) == true;
    var n : usize = put_str(&x, 128, 0, "\n", 1);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_EMPTY;
    n = put_str(&x, 128, 0, "X\tspecs/port/a.t27\n", 19);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_BAD;
    n = put_str(&x, 128, 0, "F\tspecs/port/a.t27\textra\n", 25);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_BAD;
    assert m > 0;
}

test the_scope_rule_reads_each_record_exactly {
    var x : [512]u8 = undefined;
    var out : [256]u8 = undefined;
    var st : [2]u32 = undefined;
    // A blank line between records is skipped.
    var n : usize = put_str(&x, 512, 0, "F\tspecs/port/a.t27\n\nF\tdocs/reports/t27b_expectations.json\n", 58);
    var m : usize = pr_scope(&x, n, &out, 256, &st);
    assert m == 0;
    assert st[0] == SC_OK;
    assert st[1] == 2;
    // The first refusal is the one named, and the list is not read past it.
    n = put_str(&x, 512, 0, "F\t.github/x.yml\nF\tspecs/port/a.t27\n", 35);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
    assert st[1] == 1;
    assert buf_has(&out, m, ": .github/x.yml\n", 16) == true;
    // An F record with no path.
    n = put_str(&x, 512, 0, "F\t\n", 3);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_BAD;
    // The ledger is matched whole: one byte off, or its name as a prefix, is outside.
    n = put_str(&x, 512, 0, "F\tdocs/reports/t27b_expectations.jsox\n", 38);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
    n = put_str(&x, 512, 0, "F\tdocs/reports/t27b_expectations.json.bak\n", 42);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
    // A seal is a .json in the seal folder; either half alone is outside.
    n = put_str(&x, 512, 0, "F\tdocs/x.json\n", 14);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
    n = put_str(&x, 512, 0, "F\t.trinity/seals/x.txt\n", 23);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_OUTSIDE;
    // An S record needs a seal field and a spec field.
    n = put_str(&x, 512, 0, "F\tspecs/port/a.t27\nS\tabc\n", 25);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_BAD;
    n = put_str(&x, 512, 0, "F\tspecs/port/a.t27\nS\t\tspecs/port/a.t27\n", 39);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_BAD;
    // A tag is one letter and a tab: an S with more letters before its tab is no record.
    n = put_str(&x, 512, 0, "F\tspecs/port/a.t27\nSab\tc\n", 25);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_BAD;
    // A seal whose S record has no spec field, with and without the last newline.
    n = put_str(&x, 512, 0, "F\t.trinity/seals/a.json\nS\t.trinity/seals/a.json\n", 48);
    m = pr_scope(&x, n, &out, 256, &st);
    assert st[0] == SC_SEAL;
    m = pr_scope(&x, n - 1, &out, 256, &st);
    assert st[0] == SC_SEAL;
}

test the_reason_tables_match_their_lengths {
    // Every reason ends in a letter: a length one short or one long would end elsewhere.
    var r : [128]u8 = undefined;
    var i : usize = 0;
    while (i < 7) {
        const k : usize = put_str(&r, 128, 0, REASONS[i], REASON_LENS[i]);
        assert r[k - 1] >= 'a' and r[k - 1] <= 'z';
        i += 1;
    }
    i = 0;
    while (i < 5) {
        const k : usize = put_str(&r, 128, 0, SCOPE_REASONS[i], SCOPE_REASON_LENS[i]);
        assert r[k - 1] >= 'a' and r[k - 1] <= 'z';
        i += 1;
    }
    const s : usize = put_str(&r, 128, 0, SCOPE_REASONS[2], SCOPE_REASON_LENS[2]);
    assert buf_has(&r, s, "same pull request", 17) == true;
}
