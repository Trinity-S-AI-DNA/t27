// SPDX-License-Identifier: Apache-2.0
; specs/claw/recipes.t27 -- TRI CLAW autofix recipe table (epic #9271; AF0 #9281, AF1 #9282).
; Owner instruction 2026-10-12, translated: "autofix for TRI CLAW must lift the CI/CD routine
; off the user. All the healing experience from the related repos goes in. Everything through
; .t27 + t27c + t27b + t27o." A red gate is routine when its fix is known, mechanical and
; verified by the gate it heals; this table is that knowledge, as data. The runner (AF2 #9283)
; and the CLI front door (AF3 #9284) are plumbing; the knowledge lives here.
; --
; Shape (same discipline as specs/claw/gates.t27): one ROW PER RECIPE, parallel arrays,
; alignment pinned by tests. A gate may carry several rows -- corpus-ratchet owns five
; instruments, and the types pair (bless + verdicts) must land in ONE PR: a bless alone
; leaves the classified gate red (#9145).
; GATES are workflow file stems, the same keys as NAMES in specs/claw/gates.t27 ("any" is the
; fallback row); display names never appear here, so the join cannot rot.
; CLASSES decide who acts:
; - C_AUTO: the loop runs the fix, opens the PR, arms auto-merge. Precondition CONDS[i] must
;   hold first -- every one of them was learned from a real incident.
; - C_REVIEW: a patch is prepared and reported; a person merges (foreign-code net-zero,
;   policy-PR-first cases).
; - C_OWNER: never executed; the report names the exact one keystroke.
; The honest limit: this table knows the failures the loops have actually met and healed
; (2026-10-06..10-12, night loop + claw + t27b/t27c stewards). A red whose signature matches
; no row resolves to "fallback-manual" -- fail closed, report, do not guess. New verified
; recipes land as new rows + test updates in the same commit (AF4 #9285 keeps harvesting).
; Direction (AF5 #9287, owner 2026-10-12): t27o transpiles foreign code into .t27 with no AI
; in the loop; the spec-first-port row moves REVIEW -> AUTO, tool t27o, on the first verified
; transpile -- the table records the day, and that day is not yet.
; Seed rows folded from claw-af-seed (specs/claw/autofix.t27, folded here, not merged).
; AF4 round 1 (2026-10-12, #9285): +2 verified fpga-build rows from the night-loop ticks --
; elab-baseline-raise (#9212) and physics-move (#9233). The fpga-build workflow carries two
; checks with different repairs; the class rule (real-typed model vs emitter debt) is in CONDS.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawRecipes;

/// Who acts on a row.
pub const C_AUTO : u8 = 0;
pub const C_REVIEW : u8 = 1;
pub const C_OWNER : u8 = 2;
/// Deliberately far from the real classes: a partial read cannot mistake it for a verdict.
pub const C_NONE : u8 = 255;

/// Row count of the table.
pub const COUNT : u32 = 21;

/// Workflow file stem (join key with specs/claw/gates.t27 NAMES); "any" = fallback row.
pub const GATES : [21]str = [
    "any", "claw", "documented-commands", "dupe-ratchet", "corpus-ratchet",
    "corpus-ratchet", "corpus-ratchet", "corpus-ratchet", "corpus-ratchet", "own-language",
    "conflict-markers", "loop-tools-gate", "gate-topology", "seal-coverage", "seal-coverage",
    "seal-staleness-warn", "cli-tri", "any", "spec-guards",
    "fpga-build", "fpga-build",
];

/// Short slug; the lookup key for every column.
pub const KINDS : [21]str = [
    "fallback-manual", "matrix-regen", "dead-pin-lower", "dupe-bless", "types-ledger-bless",
    "types-verdicts-write", "assertionless-bless", "suite-expectations-bless", "genverilog-cap-raise", "spec-first-port",
    "rebase-route", "loop-tool-track", "topology-classify", "seal-drift-resave", "seal-stale-reseal",
    "seal-currency-reseal", "cli-tri-dead-test", "owner-label", "spec-guards-reseal",
    "elab-baseline-raise", "physics-move",
];

/// The instrument the runner drives today (tri / t27c / git / python / owner). AF2 moves the
/// python instruments under t27-native execution; the column records the truth of the day.
pub const TOOLS : [21]str = [
    "owner", "t27c", "t27c", "python", "tri",
    "tri", "python", "t27c", "tri", "t27c",
    "git", "git", "python", "tri", "tri",
    "tri", "owner", "owner", "tri",
    "python", "tri",
];

/// The exact command the loops run. OWNER rows carry "" -- nothing executes.
pub const CMDS : [21]str = [
    "", "regenerate specs/claw/gates.t27 arrays from .github/workflows per docs/claw/README.md; the row lands in the same commit as the workflow file", "lower the dead-mention pin in the same commit as the doc change that removed the mentions", "tools/dupe_scan.py --bless on a fresh master checkout, rescan clean, PR with auto-merge armed", "tri types ratchet --bless on the newest tip",
    "write every NEW name verdict into docs/reports/type_conflicts_classified.json and the TYPE_CONFLICTS.md tables", "tools/check_assertionless_spec_tests.py --bless", "t27c suite --bless-expectations on the lab with zig on PATH", "raise the gen-verilog expected-failure cap to the blessed count and prepend a dated _why_entries_rose note", "move the logic into a .t27 spec and generate the file; deleting a whole foreign file always passes",
    "gh pr update-branch; on conflicts fetch refs/pull/N/head and merge origin/master in a /tmp worktree, fast-forward push", "move the loop helper into the repository so the gate can see it", "classify the new workflow in scripts/ci/check_pr_branch_filters.py as merge-critical or not", "tri seals drift --fix on the lab with zig on PATH; transfer the json base64+sha256", "re-seal with the tree own compiler and --save on the lab; transfer base64+sha256",
    "re-seal the edited specs on the lab and verify check_seal_currency STALE is 0 there", "", "", "re-seal the edited specs with the tree own compiler on the lab; same transfer protocol",
    "check_elab_ratchet.py --update-baseline recording the module at its measured error count and the 0-error siblings in the same commit", "move the real-typed model spec from specs/fpga to specs/physics, re-seal on the lab, re-path suite_expectations by line surgery, re-run the corpus ratchets",
];

/// The precondition that makes the fix safe. Learned the hard way; every word was an incident.
pub const CONDS : [21]str = [
    "no row matched the red signature: report with evidence, never guess", "the workflows directory changed and the inventory own tests pass on the regenerated table", "the pin lives in foreign python: policy PR and owner label first", "port wave quiet >= 30 min; fetch and reset to the newest tip; re-scan after reset; one bless per wave", "port wave quiet >= 30 min; re-scan after reset; lands in the same PR as the verdicts row",
    "every NEW name read at both definition sites; evidence quotes declarations and import edges; ASCII escapes", "port wave quiet >= 30 min; baseline format is path TAB count", "lab only; expectations are one line per entry: re-path by line surgery, keep rows sorted", "bless wrote OVER cap by design; restore the _why audit keys from master, never lose history", "foreign edits need an exceptions entry and the owner-approved-foreign label",
    "never force-push; never skip hooks; a merge commit carries the one-time exceptions entries", "none beyond the gate re-run", "net-zero rule: pay each added foreign line with an honest deletion; assert the block absent before replacing", "read the acceptance columns first; a baseline bump is the wrong repair for gen-drift", "take the side whose spec_hash matches the spec text; never re-bless to pass",
    "the compiler must be the tree own build; no Rust changed since the last lab build", "gates.rs is a foreign file: the label and its policy PR come first, then the deletion PR", "the label is the owner one click on the PR page; classifier-denied for agents since 2026-10-06", "edit-without-reseal is the usual root cause; same family as the currency reseal",
    "error class must be documented emitter debt (see the tool docstring); a NEW class is reported, never baselined", "spec is real-typed f64 math under specs/fpga that yosys rejects at a function real declaration; integer-logic siblings stay; check the ledgers for the path before the move",
];

/// C_AUTO / C_REVIEW / C_OWNER per row.
pub const CLASSES : [21]u8 = [
    C_OWNER, C_AUTO, C_REVIEW, C_AUTO, C_AUTO,
    C_AUTO, C_AUTO, C_AUTO, C_AUTO, C_REVIEW,
    C_AUTO, C_AUTO, C_REVIEW, C_AUTO, C_AUTO,
    C_AUTO, C_OWNER, C_OWNER, C_AUTO,
    C_AUTO, C_AUTO,
];

/// Byte equality; `==` on str does not lower for element-to-param compares (see gates.t27).
pub fn str_eq(a: str, b: str) -> bool {
    if (a.len != b.len) { return false; }
    var diff: usize = 0;
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { diff += 1; }
        i += 1;
    }
    return diff == 0;
}

/// Row index of a kind; -1 when unknown. Fail closed: callers check before use.
pub fn row_of_kind(kind: str) -> i32 {
    for i in 0..21 {
        if str_eq(KINDS[i], kind) { return (i) as i32; }
    }
    return -1;
}

/// Who acts on a kind; C_NONE when the kind is not in the table.
pub fn class_of(kind: str) -> u8 {
    const r = row_of_kind(kind);
    if (r < 0) { return C_NONE; }
    return CLASSES[(r) as usize];
}

/// The instrument a kind drives; "" when unknown.
pub fn tool_of(kind: str) -> str {
    const r = row_of_kind(kind);
    if (r < 0) { return ""; }
    return TOOLS[(r) as usize];
}

/// The exact command a kind runs; "" when unknown or when nobody runs anything.
pub fn cmd_of(kind: str) -> str {
    const r = row_of_kind(kind);
    if (r < 0) { return ""; }
    return CMDS[(r) as usize];
}

/// The precondition that must hold first; "" when unknown.
pub fn cond_of(kind: str) -> str {
    const r = row_of_kind(kind);
    if (r < 0) { return ""; }
    return CONDS[(r) as usize];
}

/// The workflow stem a kind heals; "" when unknown.
pub fn gate_of(kind: str) -> str {
    const r = row_of_kind(kind);
    if (r < 0) { return ""; }
    return GATES[(r) as usize];
}

/// How many recipes a gate carries (0 for a gate with no row).
pub fn count_for_gate(gate: str) -> u32 {
    var n : u32 = 0;
    for i in 0..21 {
        if str_eq(GATES[i], gate) { n += 1; }
    }
    return n;
}

/// Census by class.
pub fn count_class(c: u8) -> u32 {
    var n : u32 = 0;
    for i in 0..21 {
        if CLASSES[i] == c { n += 1; }
    }
    return n;
}

/// Every row has gate, kind, tool, condition -- and OWNER rows carry no command.
pub fn every_row_filled() -> bool {
    for i in 0..21 {
        if GATES[i] == "" { return false; }
        if KINDS[i] == "" { return false; }
        if TOOLS[i] == "" { return false; }
        if CONDS[i] == "" { return false; }
        if CLASSES[i] == C_OWNER {
            if CMDS[i] != "" { return false; }
        }
    }
    return true;
}

/// No kind appears twice -- 21*20/2 = 210 pairwise comparisons.
pub fn all_kinds_unique() -> bool {
    var i : usize = 0;
    while (i < 19) {
        var j : usize = i + 1;
        while (j < 19) {
            if str_eq(KINDS[i], KINDS[j]) { return false; }
            j += 1;
        }
        i += 1;
    }
    return true;
}

/// Every AUTO row carries a command and a condition; REVIEW rows carry a command to prepare.
pub fn auto_rows_carry_their_brief() -> bool {
    for i in 0..21 {
        if CLASSES[i] == C_AUTO {
            if CMDS[i] == "" { return false; }
        }
    }
    return true;
}

test class_constants_and_the_none_sentinel {
    assert C_AUTO == 0;
    assert C_REVIEW == 1;
    assert C_OWNER == 2;
    assert C_NONE == 255;
    // Runtime side: the sentinel classifies no row (const folds alone are vacuous).
    assert count_class(C_NONE) == 0;
}

test unknown_kind_fails_closed {
    assert row_of_kind("no-such-kind") == -1;
    assert class_of("no-such-kind") == C_NONE;
    assert str_eq(tool_of("no-such-kind"), "");
    assert str_eq(cmd_of("no-such-kind"), "");
    assert str_eq(cond_of("no-such-kind"), "");
    assert str_eq(gate_of("no-such-kind"), "");
}

test every_row_filled_and_classes_known {
    assert every_row_filled() == true;
    var known : u32 = 0;
    for i in 0..21 {
        if CLASSES[i] != C_NONE { known += 1; }
    }
    assert known == 21;
}

test all_kinds_unique_pairwise {
    assert all_kinds_unique() == true;
}

test gates_carry_their_recorded_recipe_counts {
    assert count_for_gate("any") == 2;
    assert count_for_gate("claw") == 1;
    assert count_for_gate("corpus-ratchet") == 5;
    assert count_for_gate("seal-coverage") == 2;
    assert count_for_gate("seal-staleness-warn") == 1;
    assert count_for_gate("spec-guards") == 1;
    assert count_for_gate("fpga-build") == 2;
    assert count_for_gate("no-such-gate") == 0;
}

test corpus_carries_both_types_rows_in_one_pr {
    // #9145: a bless alone leaves the classified gate red. The pair must both exist and the
    // bless row's condition names the same-PR rule.
    assert row_of_kind("types-ledger-bless") >= 0;
    assert row_of_kind("types-verdicts-write") >= 0;
    assert str_eq(gate_of("types-ledger-bless"), "corpus-ratchet");
    assert str_eq(gate_of("types-verdicts-write"), "corpus-ratchet");
    assert str_eq(cond_of("types-ledger-bless"), CONDS[4]);
}

test class_census_15_3_3 {
    assert count_class(C_AUTO) == 15;
    assert count_class(C_REVIEW) == 3;
    assert count_class(C_OWNER) == 3;
    assert count_class(C_AUTO) + count_class(C_REVIEW) + count_class(C_OWNER) == COUNT;
}

test auto_rows_carry_a_command {
    assert auto_rows_carry_their_brief() == true;
}

test rows_stay_aligned_gate_kind_class {
    // Index pins so a row inserted into one array without the others cannot pass unnoticed.
    assert GATES[0] == "any";
    assert KINDS[0] == "fallback-manual";
    assert CLASSES[0] == C_OWNER;
    assert KINDS[4] == "types-ledger-bless";
    assert GATES[4] == "corpus-ratchet";
    assert KINDS[9] == "spec-first-port";
    assert CLASSES[9] == C_REVIEW;
    assert KINDS[16] == "cli-tri-dead-test";
    assert CLASSES[16] == C_OWNER;
    assert TOOLS[17] == "owner";
    assert KINDS[17] == "owner-label";
    assert KINDS[19] == "elab-baseline-raise";
    assert GATES[19] == "fpga-build";
    assert CLASSES[19] == C_AUTO;
    assert KINDS[20] == "physics-move";
    assert GATES[20] == "fpga-build";
    assert CLASSES[20] == C_AUTO;
}

test real_failures_route_to_their_recorded_fixes {
    assert class_of("matrix-regen") == C_AUTO;
    assert class_of("dead-pin-lower") == C_REVIEW;
    assert class_of("dupe-bless") == C_AUTO;
    assert class_of("spec-first-port") == C_REVIEW;
    assert class_of("topology-classify") == C_REVIEW;
    assert class_of("cli-tri-dead-test") == C_OWNER;
    assert class_of("owner-label") == C_OWNER;
    assert class_of("spec-guards-reseal") == C_AUTO;
    assert class_of("elab-baseline-raise") == C_AUTO;
    assert class_of("physics-move") == C_AUTO;
}

test tools_are_the_recorded_instruments {
    assert str_eq(tool_of("types-ledger-bless"), "tri");
    assert str_eq(tool_of("matrix-regen"), "t27c");
    assert str_eq(tool_of("rebase-route"), "git");
    assert str_eq(tool_of("dupe-bless"), "python");
    assert str_eq(tool_of("owner-label"), "owner");
    assert str_eq(tool_of("physics-move"), "tri");
}
