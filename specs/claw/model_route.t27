// SPDX-License-Identifier: Apache-2.0
; specs/claw/model_route.t27 -- which Claude model does which job in TRI CLAW and in every agent
; session of this project: every role starts on Sonnet 5.5, the orchestrator included; Opus 5.5 is
; reached only on evidence (failed attempts) or on the owner's word.
; Owner directive 2026-10-19 (translated): "set Sonnet as the default model for all agents -- it is
; cheaper with the same result" (#10921). It replaces the directive of 2026-10-18 (#10493):
; "orchestration through Opus 5.5, sub-tasks through Sonnet 5.5", which kept the orchestration roles
; on Opus as "not a false economy"; the owner has since judged the result the same on Sonnet.
; --
; WHY. Epic #10066 measured one-shot spec-to-RTL work on the same ten tasks: Sonnet 5.5 passed 9 of
; 10 direct-Verilog tasks against Opus 5.5's 8, and 7 of 10 .t27 tasks against Opus's 7, at about 40%
; of Opus's cost (~$0.41 vs ~$0.99 and ~$0.77 vs ~$1.53 per task, list-price estimates). N = 10, one
; shot: the robust part is that Sonnet is not worse on bounded tasks and is much cheaper. What Opus
; was kept for until 2026-10-19 is the part no sub-task sees -- splitting the work, deciding what is
; true, saying "merge" or "stop" -- and that is now the owner's call per task, through owner_flag.
; --
; THE RULE.
; - A role is either ORCHESTRATION (orchestrate, plan, final review) or a SUB-TASK (implement,
;   port, search, test, docs, fix). The distinction stays for records and reviews, but base_tier()
;   maps every role to Sonnet.
; - Any role escalates to Opus only on evidence: ESCALATE_AFTER failed Sonnet attempts on the same
;   task, or the owner's explicit flag. route() is that rule; nothing else may raise a tier.
; - Opus without that evidence is waste, for an orchestration role as much as for a sub-task.
; - The rule names models by the aliases Claude Code's Agent tool and agent frontmatter accept
;   ("opus", "sonnet") and by the full API ids, so a host that is not Claude Code (TRI CLAW's own
;   chat agent, the Queen) reads the same table.
; --
; WHERE IT BINDS. Claude Code: `.claude/settings.json` sets CLAUDE_CODE_SUBAGENT_MODEL to the Sonnet
; id, every agent in `.claude/agents/` (the orchestrator `trinity.md` too) carries `model: sonnet`,
; the main session picks Sonnet 5.5 in the app's model menu, and the skill
; `.claude/skills/model-routing/SKILL.md` tells the orchestrator how to spawn and when to escalate.
; TRI CLAW's app and the Queen read this table when they pick a model (follow-up in their repos).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawModelRoute;

; --- tiers ---------------------------------------------------------------------------------------
pub const TIER_OPUS : u32 = 0;
pub const TIER_SONNET : u32 = 1;

pub const OPUS_ALIAS : str = "opus";
pub const SONNET_ALIAS : str = "sonnet";
pub const OPUS_ID : str = "claude-opus-5-5";
pub const SONNET_ID : str = "claude-sonnet-5-5";

; --- roles ---------------------------------------------------------------------------------------
/// Orchestration: break the task down, delegate, combine results.
pub const R_ORCHESTRATE : u32 = 0;
/// Orchestration: a plan, an epic, the acceptance criteria.
pub const R_PLAN : u32 = 1;
/// Orchestration: the last review before a merge or before a claim leaves the repo.
pub const R_REVIEW_FINAL : u32 = 2;
/// Sub-task: write or change a spec, a test, a board top.
pub const R_IMPLEMENT : u32 = 3;
/// Sub-task: port foreign code to .t27.
pub const R_PORT : u32 = 4;
/// Sub-task: find files, read code, collect facts.
pub const R_SEARCH : u32 = 5;
/// Sub-task: run tests, gates, seals and report what they said.
pub const R_TEST : u32 = 6;
/// Sub-task: docs, issue and PR text, release notes drafts.
pub const R_DOCS : u32 = 7;
/// Sub-task: fix a failing check whose cause is already named.
pub const R_FIX : u32 = 8;
pub const ROLE_COUNT : u32 = 9;

; --- escalation ----------------------------------------------------------------------------------
/// Failed Sonnet attempts on the same task before it may go to Opus.
pub const ESCALATE_AFTER : u32 = 2;

pub fn is_orchestration(role : u32) -> bool {
    return role <= R_REVIEW_FINAL;
}

/// The tier a role starts at: Sonnet for every role, known or not (owner 2026-10-19).
pub fn base_tier(role : u32) -> u32 {
    _ = role;
    return TIER_SONNET;
}

/// The tier a job runs at: the base tier, raised to Opus for any role only after ESCALATE_AFTER
/// failed attempts on the same task or on the owner's flag.
pub fn route(role : u32, failed_attempts : u32, owner_flag : bool) -> u32 {
    if (base_tier(role) == TIER_OPUS) { return TIER_OPUS; }
    if (owner_flag) { return TIER_OPUS; }
    if (failed_attempts >= ESCALATE_AFTER) { return TIER_OPUS; }
    return TIER_SONNET;
}

/// Is a job running on Opus without the evidence route() asks for? The audit question for a session
/// log or a TRI CLAW run record, for every role.
pub fn is_waste(role : u32, tier : u32, failed_attempts : u32, owner_flag : bool) -> bool {
    return tier == TIER_OPUS and route(role, failed_attempts, owner_flag) == TIER_SONNET;
}

test orchestration_roles_start_on_sonnet {
    assert base_tier(R_ORCHESTRATE) == TIER_SONNET;
    assert base_tier(R_PLAN) == TIER_SONNET;
    assert base_tier(R_REVIEW_FINAL) == TIER_SONNET;
    assert is_orchestration(R_REVIEW_FINAL);
    assert is_orchestration(R_IMPLEMENT) == false;
}

test sub_tasks_run_on_sonnet {
    assert base_tier(R_IMPLEMENT) == TIER_SONNET;
    assert base_tier(R_PORT) == TIER_SONNET;
    assert base_tier(R_SEARCH) == TIER_SONNET;
    assert base_tier(R_TEST) == TIER_SONNET;
    assert base_tier(R_DOCS) == TIER_SONNET;
    assert base_tier(R_FIX) == TIER_SONNET;
}

test an_unknown_role_is_a_cheap_sub_task {
    assert base_tier(ROLE_COUNT) == TIER_SONNET;
    assert base_tier(99) == TIER_SONNET;
}

test a_sub_task_escalates_only_on_evidence {
    assert route(R_IMPLEMENT, 0, false) == TIER_SONNET;
    assert route(R_IMPLEMENT, 1, false) == TIER_SONNET;
    assert route(R_IMPLEMENT, 2, false) == TIER_OPUS;
    assert route(R_FIX, 5, false) == TIER_OPUS;
    assert route(R_SEARCH, 0, true) == TIER_OPUS;
}

test orchestration_escalates_only_on_evidence_too {
    assert route(R_ORCHESTRATE, 0, false) == TIER_SONNET;
    assert route(R_PLAN, 1, false) == TIER_SONNET;
    assert route(R_REVIEW_FINAL, 2, false) == TIER_OPUS;
    assert route(R_ORCHESTRATE, 0, true) == TIER_OPUS;
}

test negative_control_opus_on_a_fresh_sub_task_is_waste {
    assert is_waste(R_PORT, TIER_OPUS, 0, false) == true;
    assert is_waste(R_PORT, TIER_OPUS, 2, false) == false;
    assert is_waste(R_PORT, TIER_OPUS, 0, true) == false;
    assert is_waste(R_PORT, TIER_SONNET, 0, false) == false;
    assert is_waste(R_PLAN, TIER_OPUS, 0, false) == true;
    assert is_waste(R_ORCHESTRATE, TIER_OPUS, 0, true) == false;
    assert is_waste(R_REVIEW_FINAL, TIER_OPUS, 2, false) == false;
}

invariant every_role_routes_to_a_known_tier {
    var r : u32 = 0;
    while (r < ROLE_COUNT) {
        const t : u32 = route(r, 0, false);
        assert t == TIER_OPUS or t == TIER_SONNET;
        r += 1;
    }
}
