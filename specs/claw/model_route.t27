// SPDX-License-Identifier: Apache-2.0
; specs/claw/model_route.t27 -- which model does which job in TRI CLAW and in every agent session of
; this project: a sub-task starts in a T27 OS pane on a free key tier, the orchestrator starts on
; Sonnet 5.5, Sonnet is the first escalation of a sub-task, and Opus 5.5 is reached only on evidence
; (failed attempts) or on the owner's word.
; Owner directive 2026-10-20 (#11317, summarised): run lanes through T27 OS, the Mac app built from
; specs/t27os, instead of paid subagents -- cheaper, and the owner watches every lane live in the
; window. It adds a tier below Sonnet for sub-tasks and leaves the orchestrator where 2026-10-19
; put it.
; Owner directive 2026-10-19 (translated): "set Sonnet as the default model for all agents -- it is
; cheaper with the same result" (#10921). It replaced the directive of 2026-10-18 (#10493):
; "orchestration through Opus 5.5, sub-tasks through Sonnet 5.5", which kept the orchestration roles
; on Opus as "not a false economy"; the owner has since judged the result the same on Sonnet.
; --
; WHY. Epic #10066 measured one-shot spec-to-RTL work on the same ten tasks: Sonnet 5.5 passed 9 of
; 10 direct-Verilog tasks against Opus 5.5's 8, and 7 of 10 .t27 tasks against Opus's 7, at about 40%
; of Opus's cost (~$0.41 vs ~$0.99 and ~$0.77 vs ~$1.53 per task, list-price estimates). N = 10, one
; shot: the robust part is that Sonnet is not worse on bounded tasks and is much cheaper. A pane on a
; free key tier costs nothing per token, and the gate (tests, seals, ratchets), not the model that
; wrote the diff, decides what lands -- so a bounded sub-task may start there and pay for a stronger
; model only when the pane fails it. What Opus was kept for until 2026-10-19 is the part no sub-task
; sees -- splitting the work, deciding what is true, saying "merge" or "stop" -- and that is now the
; owner's call per task, through owner_flag.
; --
; THE RULE.
; - A role is either ORCHESTRATION (orchestrate, plan, final review) or a SUB-TASK (implement,
;   port, search, test, docs, fix). base_tier() maps orchestration to Sonnet and a sub-task to PANE.
; - A job escalates ONE step per ESCALATE_AFTER failed attempts on the same task: pane -> Sonnet
;   after 2 failures, Sonnet -> Opus after 2 more (4 in all); an orchestration job, already on
;   Sonnet, goes to Opus after 2. The owner's flag goes straight to Opus at any time. route() is
;   that rule for Claude Code; nothing else may raise a Claude tier. Cursor cloud agents are a
;   different table, cursor_pick() (owner 2026-11-10): Composer 2.5 for a named cheap task, Grok
;   4.7 for architecture, a conflict, a wide refactor, a repeated failure, or an unknown class,
;   and after two failures of a cheap task. Fast and the long window are never that pick.
; - Spending a stronger tier than route() names is waste, for every role and every tier: Opus on a
;   fresh job, and Sonnet on a fresh sub-task that a pane could have run (is_waste).
; - The rule names models by the aliases Claude Code's Agent tool and agent frontmatter accept
;   ("opus", "sonnet") and by the full API ids, so a host that is not Claude Code (TRI CLAW's own
;   chat agent, the Queen) reads the same table. The pane tier is not a Claude model but a place: a
;   T27 OS agent pane running Claude Code on a free key tier (glm-4.5-flash, then an OpenRouter
;   ":free" model), driven by T27OS_CTL; PANE_ALIAS names it.
; --
; WHERE IT BINDS. Claude Code: `.claude/settings.json` sets CLAUDE_CODE_SUBAGENT_MODEL to the Sonnet
; id, so a subagent spawned on escalation runs on Sonnet, every agent in `.claude/agents/` (the
; orchestrator `trinity.md` too) carries `model: sonnet`, the main session picks Sonnet 5.5 in the
; app's model menu, and the skill `.claude/skills/model-routing/SKILL.md` tells the orchestrator how
; to spawn and when to escalate; `.claude/skills/t27os-orchestra/SKILL.md` is how a sub-task runs as
; a pane. TRI CLAW's app and the Queen read this table when they pick a model (follow-up in their
; repos).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawModelRoute;

; --- tiers ---------------------------------------------------------------------------------------
; Ordered by strength, strongest first: a LOWER number is a stronger (dearer) tier, so escalating is
; subtracting one. TIER_OPUS and TIER_SONNET keep the numbers they had before the pane tier existed.
pub const TIER_OPUS : u32 = 0;
pub const TIER_SONNET : u32 = 1;
/// A T27 OS agent pane on a free key tier: the base tier of the sub-task roles (owner 2026-10-20).
pub const TIER_PANE : u32 = 2;

pub const OPUS_ALIAS : str = "opus";
pub const SONNET_ALIAS : str = "sonnet";
pub const PANE_ALIAS : str = "pane";
pub const OPUS_ID : str = "claude-opus-5-5";
pub const SONNET_ID : str = "claude-sonnet-5-5";

; --- roles ---------------------------------------------------------------------------------------
/// Orchestration: break the task down, delegate, combine results.
pub const R_ORCHESTRATE : u32 = 0;
/// Orchestration: a plan, an epic, the acceptance criteria.
pub const R_PLAN : u32 = 1;
/// Orchestration: the last review before a merge or before a claim leaves the repo.
pub const R_REVIEW_FINAL : u32 = 2;
/// Sub-task: write or change a spec, a test, a board top.
pub const R_IMPLEMENT : u32 = 3;
/// Sub-task: port foreign code to .t27.
pub const R_PORT : u32 = 4;
/// Sub-task: find files, read code, collect facts.
pub const R_SEARCH : u32 = 5;
/// Sub-task: run tests, gates, seals and report what they said.
pub const R_TEST : u32 = 6;
/// Sub-task: docs, issue and PR text, release notes drafts.
pub const R_DOCS : u32 = 7;
/// Sub-task: fix a failing check whose cause is already named.
pub const R_FIX : u32 = 8;
pub const ROLE_COUNT : u32 = 9;

; --- escalation ----------------------------------------------------------------------------------
/// Failed attempts on the same task per step up the tiers: pane -> Sonnet after one multiple of this,
/// Sonnet -> Opus after the next.
pub const ESCALATE_AFTER : u32 = 2;

pub fn is_orchestration(role : u32) -> bool {
    return role <= R_REVIEW_FINAL;
}

/// The tier a role starts at: Sonnet for orchestration, a pane for every sub-task, known or not.
pub fn base_tier(role : u32) -> u32 {
    if (is_orchestration(role)) { return TIER_SONNET; }
    return TIER_PANE;
}

/// The tier a job runs at: the owner's flag is Opus at any time; otherwise the base tier, raised one
/// step per ESCALATE_AFTER failed attempts on the same task and capped at Opus.
pub fn route(role : u32, failed_attempts : u32, owner_flag : bool) -> u32 {
    if (owner_flag) { return TIER_OPUS; }
    const base : u32 = base_tier(role);
    const steps : u32 = failed_attempts / ESCALATE_AFTER;
    if (steps >= base) { return TIER_OPUS; }
    return base - steps;
}

/// Is a job running on a stronger tier than route() asks for? The audit question for a session log or
/// a TRI CLAW run record, for every role: Opus on a fresh job, Sonnet on a fresh sub-task.
pub fn is_waste(role : u32, tier : u32, failed_attempts : u32, owner_flag : bool) -> bool {
    return tier < route(role, failed_attempts, owner_flag);
}

test orchestration_roles_start_on_sonnet {
    assert base_tier(R_ORCHESTRATE) == TIER_SONNET;
    assert base_tier(R_PLAN) == TIER_SONNET;
    assert base_tier(R_REVIEW_FINAL) == TIER_SONNET;
    assert is_orchestration(R_REVIEW_FINAL);
    assert is_orchestration(R_IMPLEMENT) == false;
}

test sub_tasks_start_in_a_pane {
    assert base_tier(R_IMPLEMENT) == TIER_PANE;
    assert base_tier(R_PORT) == TIER_PANE;
    assert base_tier(R_SEARCH) == TIER_PANE;
    assert base_tier(R_TEST) == TIER_PANE;
    assert base_tier(R_DOCS) == TIER_PANE;
    assert base_tier(R_FIX) == TIER_PANE;
}

test an_unknown_role_is_a_cheap_sub_task {
    assert base_tier(ROLE_COUNT) == TIER_PANE;
    assert base_tier(99) == TIER_PANE;
}

test the_tiers_are_ordered_strongest_first {
    assert base_tier(R_IMPLEMENT) > base_tier(R_ORCHESTRATE);
    assert base_tier(R_ORCHESTRATE) > route(R_IMPLEMENT, 4, false);
    assert route(R_IMPLEMENT, 0, false) - route(R_IMPLEMENT, 2, false) == 1;
    assert route(R_IMPLEMENT, 2, false) - route(R_IMPLEMENT, 4, false) == 1;
}

test a_sub_task_escalates_one_step_per_two_failures {
    assert route(R_IMPLEMENT, 0, false) == TIER_PANE;
    assert route(R_IMPLEMENT, 1, false) == TIER_PANE;
    assert route(R_IMPLEMENT, 2, false) == TIER_SONNET;
    assert route(R_IMPLEMENT, 3, false) == TIER_SONNET;
    assert route(R_IMPLEMENT, 4, false) == TIER_OPUS;
    assert route(R_FIX, 5, false) == TIER_OPUS;
    assert route(R_FIX, 9, false) == TIER_OPUS;
}

test the_owner_flag_is_opus_at_any_time {
    assert route(R_SEARCH, 0, true) == TIER_OPUS;
    assert route(R_IMPLEMENT, 0, true) == TIER_OPUS;
    assert route(R_IMPLEMENT, 1, true) == TIER_OPUS;
}

test orchestration_escalates_only_on_evidence_too {
    assert route(R_ORCHESTRATE, 0, false) == TIER_SONNET;
    assert route(R_PLAN, 1, false) == TIER_SONNET;
    assert route(R_REVIEW_FINAL, 2, false) == TIER_OPUS;
    assert route(R_ORCHESTRATE, 0, true) == TIER_OPUS;
}

test negative_control_a_stronger_tier_than_route_names_is_waste {
    assert is_waste(R_PORT, TIER_OPUS, 0, false) == true;
    assert is_waste(R_PORT, TIER_OPUS, 2, false) == true;
    assert is_waste(R_PORT, TIER_OPUS, 4, false) == false;
    assert is_waste(R_PORT, TIER_OPUS, 0, true) == false;
    assert is_waste(R_PORT, TIER_SONNET, 0, false) == true;
    assert is_waste(R_PORT, TIER_SONNET, 2, false) == false;
    assert is_waste(R_PORT, TIER_PANE, 0, false) == false;
    assert is_waste(R_PLAN, TIER_OPUS, 0, false) == true;
    assert is_waste(R_PLAN, TIER_SONNET, 0, false) == false;
    assert is_waste(R_ORCHESTRATE, TIER_OPUS, 0, true) == false;
    assert is_waste(R_REVIEW_FINAL, TIER_OPUS, 2, false) == false;
}

invariant every_role_routes_to_a_known_tier {
    var r : u32 = 0;
    while (r < ROLE_COUNT) {
        const t : u32 = route(r, 0, false);
        assert t == TIER_OPUS or t == TIER_SONNET or t == TIER_PANE;
        r += 1;
    }
}

test more_failures_never_lower_the_tier {
    var r : u32 = 0;
    while (r < ROLE_COUNT) {
        var f : u32 = 0;
        while (f < 12) {
            assert route(r, f + 1, false) <= route(r, f, false);
            assert route(r, f, true) == TIER_OPUS;
            f += 1;
        }
        r += 1;
    }
}

; --- Cursor cloud agents (owner 2026-11-10) ------------------------------------------------------
; route() above is Claude Code. This table is the Cursor model a cloud subagent starts on.
; List prices below are the owner's cited Cursor list of 2026-11-10, in micro-USD per 1_000_000
; tokens. They are not a measured saving. cost_policy.t27 still refuses an unmeasured "saved
; percent". A host fills cost_usd_micro from cursor_micro(); truncation is integer division.
; The Grok slug is grok-4.7 with effort medium: not Fast, not the long window. The family the
; owner wrote as grok-4-7 is that slug.

pub const CUR_COMPOSER : u32 = 1;
pub const CUR_GROK : u32 = 2;
pub const CUR_COMPOSER_FAST : u32 = 3;
pub const CUR_GROK_FAST : u32 = 4;
pub const CUR_GROK_LONG : u32 = 5;
pub const CUR_GROK45 : u32 = 6;
pub const CUR_GROK45_FAST : u32 = 7;

pub const CURSOR_CHEAP_ID : str = "composer-2.5";
pub const CURSOR_STRONG_ID : str = "grok-4.7-medium";

pub const CK_PARSE : u32 = 1;
pub const CK_TEST : u32 = 2;
pub const CK_SMALL_T27 : u32 = 3;
pub const CK_SCREENSHOT : u32 = 4;
pub const CK_VISUAL : u32 = 5;
pub const CK_LIVE_GRAPH : u32 = 6;
pub const CK_UI_KIT : u32 = 7;
pub const CK_CRM : u32 = 8;
pub const CK_ARCH : u32 = 9;
pub const CK_REFACTOR : u32 = 10;
pub const CK_REPEAT : u32 = 11;

pub const CUR_MAX_PARALLEL : u32 = 3;
pub const CUR_MAX_FILES : u32 = 8;
pub const CUR_MAX_RETRY : u32 = 2;
pub const CUR_REPORT : bool = true;
pub const CUR_U64_MAX : u64 = 18446744073709551615;
pub const CUR_PER_M : u64 = 1000000;

pub fn cursor_cheap(kind : u32) -> bool {
    return kind >= CK_PARSE and kind <= CK_UI_KIT;
}

pub fn cursor_strong(kind : u32) -> bool {
    return kind >= CK_CRM and kind <= CK_REPEAT;
}

/// Composer for a named cheap class with fewer than ESCALATE_AFTER failures. Grok for a named
/// strong class, for an unknown class, and after two failures of a cheap class. Never Fast,
/// never the long window, never a third-party id.
pub fn cursor_pick(kind : u32, failures : u32) -> u32 {
    if (cursor_strong(kind) or cursor_cheap(kind) == false) { return CUR_GROK; }
    if (failures >= ESCALATE_AFTER) { return CUR_GROK; }
    return CUR_COMPOSER;
}

pub fn cursor_default_forbidden(model : u32) -> bool {
    return model == CUR_COMPOSER_FAST or model == CUR_GROK_FAST or model == CUR_GROK_LONG or model == CUR_GROK45_FAST;
}

pub fn cursor_parallel_ok(n : u32) -> bool { return n <= CUR_MAX_PARALLEL; }
pub fn cursor_files_ok(n : u32) -> bool { return n <= CUR_MAX_FILES; }

fn cur_in(m : u32) -> u64 {
    if (m == CUR_COMPOSER) { return 500000; }
    if (m == CUR_COMPOSER_FAST) { return 3000000; }
    if (m == CUR_GROK or m == CUR_GROK45) { return 2000000; }
    if (m == CUR_GROK_FAST or m == CUR_GROK_LONG or m == CUR_GROK45_FAST) { return 4000000; }
    return 0;
}

fn cur_cache(m : u32) -> u64 {
    if (m == CUR_COMPOSER) { return 200000; }
    if (m == CUR_COMPOSER_FAST or m == CUR_GROK or m == CUR_GROK45) { return 500000; }
    if (m == CUR_GROK_FAST or m == CUR_GROK_LONG or m == CUR_GROK45_FAST) { return 1000000; }
    return 0;
}

fn cur_out(m : u32) -> u64 {
    if (m == CUR_COMPOSER) { return 2500000; }
    if (m == CUR_COMPOSER_FAST) { return 15000000; }
    if (m == CUR_GROK or m == CUR_GROK45) { return 6000000; }
    if (m == CUR_GROK_FAST or m == CUR_GROK_LONG) { return 12000000; }
    if (m == CUR_GROK45_FAST) { return 18000000; }
    return 0;
}

fn cur_part(tokens : u64, rate : u64) -> u64 {
    if (rate == 0 or tokens > CUR_U64_MAX / rate) { return CUR_U64_MAX; }
    return tokens * rate / CUR_PER_M;
}

fn cur_add(a : u64, b : u64) -> u64 {
    if (a == CUR_U64_MAX or b == CUR_U64_MAX or a > CUR_U64_MAX - b) { return CUR_U64_MAX; }
    return a + b;
}

/// Micro-USD for one run at the cited list. cached tokens are billed at the cache rate and the
/// rest of tok_in at the input rate. cached > tok_in, an unknown model, or an overflow is
/// CUR_U64_MAX (refuse), never a zero bill.
pub fn cursor_micro(model : u32, tok_in : u64, tok_cached : u64, tok_out : u64) -> u64 {
    if (tok_cached > tok_in) { return CUR_U64_MAX; }
    const ri : u64 = cur_in(model);
    const rc : u64 = cur_cache(model);
    const ro : u64 = cur_out(model);
    if (ri == 0 or rc == 0 or ro == 0) { return CUR_U64_MAX; }
    return cur_add(cur_add(cur_part(tok_in - tok_cached, ri), cur_part(tok_cached, rc)), cur_part(tok_out, ro));
}

test a_cheap_cursor_task_starts_on_composer {
    assert cursor_pick(CK_PARSE, 0) == CUR_COMPOSER;
    assert cursor_pick(CK_TEST, 1) == CUR_COMPOSER;
    assert cursor_pick(CK_SMALL_T27, 0) == CUR_COMPOSER;
    assert cursor_pick(CK_SCREENSHOT, 0) == CUR_COMPOSER;
    assert cursor_pick(CK_VISUAL, 0) == CUR_COMPOSER;
    assert cursor_pick(CK_LIVE_GRAPH, 0) == CUR_COMPOSER;
    assert cursor_pick(CK_UI_KIT, 0) == CUR_COMPOSER;
}

test a_strong_or_unknown_cursor_task_starts_on_grok {
    assert cursor_pick(CK_CRM, 0) == CUR_GROK;
    assert cursor_pick(CK_ARCH, 0) == CUR_GROK;
    assert cursor_pick(CK_REFACTOR, 0) == CUR_GROK;
    assert cursor_pick(CK_REPEAT, 0) == CUR_GROK;
    assert cursor_pick(0, 0) == CUR_GROK;
    assert cursor_pick(99, 0) == CUR_GROK;
}

test composer_escalates_to_grok_after_two_failures {
    assert cursor_pick(CK_PARSE, 2) == CUR_GROK;
    assert cursor_pick(CK_SMALL_T27, 3) == CUR_GROK;
    assert cursor_pick(CK_ARCH, 2) == CUR_GROK;
    assert cursor_default_forbidden(cursor_pick(CK_PARSE, 0)) == false;
    assert cursor_default_forbidden(cursor_pick(CK_ARCH, 4)) == false;
    assert cursor_default_forbidden(CUR_COMPOSER_FAST);
    assert cursor_default_forbidden(CUR_GROK_FAST);
    assert cursor_default_forbidden(CUR_GROK_LONG);
    assert cursor_default_forbidden(CUR_GROK45_FAST);
    assert cursor_default_forbidden(CUR_COMPOSER) == false;
    assert cursor_default_forbidden(CUR_GROK) == false;
}

test cursor_budgets_match_the_owner_caps {
    assert CUR_MAX_PARALLEL == 3;
    assert CUR_MAX_FILES == 8;
    assert CUR_MAX_RETRY == ESCALATE_AFTER;
    assert CUR_REPORT;
    assert cursor_parallel_ok(3);
    assert cursor_parallel_ok(4) == false;
    assert cursor_files_ok(8);
    assert cursor_files_ok(9) == false;
}

test the_cited_list_bills_one_million_tokens {
    assert cursor_micro(CUR_COMPOSER, 1000000, 0, 0) == 500000;
    assert cursor_micro(CUR_COMPOSER, 0, 0, 1000000) == 2500000;
    assert cursor_micro(CUR_COMPOSER, 1000000, 1000000, 0) == 200000;
    assert cursor_micro(CUR_GROK, 1000000, 0, 0) == 2000000;
    assert cursor_micro(CUR_GROK, 0, 0, 1000000) == 6000000;
    assert cur_in(CUR_GROK) == cur_in(CUR_COMPOSER) * 4;
    assert cur_out(CUR_COMPOSER_FAST) == cur_out(CUR_COMPOSER) * 6;
    assert cur_out(CUR_GROK45_FAST) == 18000000;
    assert cursor_micro(CUR_COMPOSER, 10, 11, 0) == CUR_U64_MAX;
    assert cursor_micro(0, 1000000, 0, 0) == CUR_U64_MAX;
}
