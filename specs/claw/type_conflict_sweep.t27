// SPDX-License-Identifier: Apache-2.0
; specs/claw/type_conflict_sweep.t27 -- a renamed type must leave BOTH ledgers in the one commit
; that resolves it (#13166, measured 2026-11-03 on Trinity-S-AI-DNA/t27).
; --
; The types ratchet (cli/tri/src/types_dup.rs, LEDGER docs/reports/type_conflicts.json) is
; identity-keyed, not a count: a name that stops being a conflict still fails until its ledger
; line is removed, and a resolved name still carrying a verdict fails too. #13096 renamed the
; clade-local ParsedCommand to CladeParsedCommand, which resolved its conflict with the tri
; collections classifier -- and left BOTH files dirty: the ledger still listed "ParsedCommand"
; and docs/reports/type_conflicts_classified.json still held its verdict. Master's Corpus
; Ratchet went red, and every open PR inherited it, because a resolved name fails on purpose
; (a name with two definitions has no computable domain, #2774). The sweep removed the name from
; both files in one commit (#13166), 142 -> 141, RATCHET CLEAN.
; --
; The rule this file writes: a type name lives in both files or in neither. The rename that
; resolves it must sweep both in the same commit; a half-sweep is a red ratchet.
;   consistency(in_ledger, in_classified): the four states of one name across the two files.
;   sweep_verdict(resolved, state): what the resolving commit must do -- nothing, drop the
;     ledger line, drop the verdict, or drop both.
;   sweep_line: one S TAB verdict line for a caller's log.
; A name that is still conflicting is not a sweep: a rename that did not resolve it is out of
; scope, and an orphan state there is a different red (a conflict with no verdict, or a verdict
; with no conflict) the ratchet already refuses.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawTypeConflictSweep;

use claw::text;

/// The four ways one type name can sit across the two files.
pub const S_ACTIVE : u8 = 0;
pub const S_ABSENT : u8 = 1;
pub const S_ORPHAN_LEDGER : u8 = 2;
pub const S_ORPHAN_VERDICT : u8 = 3;

/// What the resolving commit must do.
pub const SW_CLEAN : u8 = 0;
pub const SW_LEDGER : u8 = 1;
pub const SW_VERDICT : u8 = 2;
pub const SW_BOTH : u8 = 3;

/// A name is in both files (a live conflict), in neither (no conflict), or in exactly one --
/// and exactly-one is the red the sweep removes.
pub fn consistency(in_ledger : bool, in_classified : bool) -> u8 {
    if (in_ledger and in_classified) { return S_ACTIVE; }
    if (in_ledger == false and in_classified == false) { return S_ABSENT; }
    if (in_ledger) { return S_ORPHAN_LEDGER; }
    return S_ORPHAN_VERDICT;
}

/// The rename that resolved a name must leave it S_ABSENT. A name that is still conflicting is
/// nobody's sweep -- return SW_CLEAN and let the ratchet judge the conflict on its own terms.
pub fn sweep_verdict(resolved : bool, st : u8) -> u8 {
    if (resolved == false) { return SW_CLEAN; }
    if (st == S_ABSENT) { return SW_CLEAN; }
    if (st == S_ORPHAN_LEDGER) { return SW_LEDGER; }
    if (st == S_ORPHAN_VERDICT) { return SW_VERDICT; }
    return SW_BOTH;
}

/// One S TAB verdict line: `S<TAB><clean|sweep-ledger|sweep-verdict|sweep-both>\n`.
pub fn sweep_line(out : []u8, cap : usize, resolved : bool, st : u8) -> usize {
    var w : usize = 0;
    w = put_str(out, cap, w, "S\t", 2);
    const a : u8 = sweep_verdict(resolved, st);
    if (a == SW_CLEAN) { w = put_str(out, cap, w, "clean\n", 6); }
    if (a == SW_LEDGER) { w = put_str(out, cap, w, "sweep-ledger\n", 13); }
    if (a == SW_VERDICT) { w = put_str(out, cap, w, "sweep-verdict\n", 14); }
    if (a == SW_BOTH) { w = put_str(out, cap, w, "sweep-both\n", 11); }
    return w;
}

invariant the_four_states_are_exhaustive {
    assert consistency(true, true) == S_ACTIVE;
    assert consistency(false, false) == S_ABSENT;
    assert consistency(true, false) == S_ORPHAN_LEDGER;
    assert consistency(false, true) == S_ORPHAN_VERDICT;
}

test a_resolved_name_must_leave_both_files {
    // #13166 was S_ACTIVE on a resolved name: the ledger line and the verdict both stayed.
    assert sweep_verdict(true, S_ACTIVE) == SW_BOTH;
    assert sweep_verdict(true, S_ORPHAN_LEDGER) == SW_LEDGER;
    assert sweep_verdict(true, S_ORPHAN_VERDICT) == SW_VERDICT;
    assert sweep_verdict(true, S_ABSENT) == SW_CLEAN;
}

test a_live_conflict_is_not_a_sweep {
    assert sweep_verdict(false, S_ACTIVE) == SW_CLEAN;
    assert sweep_verdict(false, S_ORPHAN_LEDGER) == SW_CLEAN;
    assert sweep_verdict(false, S_ORPHAN_VERDICT) == SW_CLEAN;
}

test the_line_names_the_sweep {
    var out : [64]u8 = undefined;
    const n : usize = sweep_line(&out, 64, true, S_ACTIVE);
    assert n == 13;
    assert buf_has(&out, n, "sweep-both\n", 11) == true;
    const m : usize = sweep_line(&out, 64, false, S_ORPHAN_LEDGER);
    assert m == 8;
    assert buf_has(&out, m, "clean\n", 6) == true;
}
