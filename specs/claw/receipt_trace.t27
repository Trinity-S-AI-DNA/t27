// specs/claw/receipt_trace.t27 -- claw: trace -- a TRI CLAW fix earns TRI credit
// claims only through VerifiedPayout's rules.
// Part of M2 milestone (milestone #6). Closes #13581.
// phi^2 + 1/phi^2 = 3 | TRINITY

module claw::receipt_trace;

pub const CLAW_RECEIPT_TRACE_MAX_EVENTS : u32 = 1024;

pub struct ReceiptTrace { id: str, verified: bool };

pub fn receipt_trace_verified(r: ReceiptTrace) -> bool {
    return r.verified;
}

test "receipt_trace_verified" {
    assert(receipt_trace_verified(ReceiptTrace { id: "trace-1", verified: true }));
    assert(!receipt_trace_verified(ReceiptTrace { id: "trace-2", verified: false }));
}

invariant receipt_trace_max_events_positive {
    assert CLAW_RECEIPT_TRACE_MAX_EVENTS > 0;
}