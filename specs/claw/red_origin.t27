// SPDX-License-Identifier: Apache-2.0
; specs/claw/red_origin.t27 -- whose red is it: when a check fails on a PR, does the fix belong in
; the PR, or did the PR inherit a failure master already has?
; --
; On 2026-10-19 Auto-fix reported four failing checks on gHashTag/t27 PR #10797 (claw mutation
; sweeps). Not one was the PR's: t27b-native-ratchet named 9 analog, fpga, port and t27f specs
; that master fails too; "Documented t27c subcommands exist" counted a dead `tri t27t` that
; master's #10790 had added to AGENTS.md; coverage and spec-guards named specs/t27f/frontend.t27,
; changed on master by #10786 without a re-seal. Each one took a log read, a diff and a git log
; by hand, and the reflex the event invites -- "fix, commit, and push" -- would have put other
; lanes' files into the PR and restarted every check while the queue stood above 300. This module
; is that triage as a rule.
; --
; red_reason(pr, named, moved, master), first match wins:
;   a path the failing log names is a path the PR changes        -> own R_OWN_PATH
;   master's last finished run of the same check is red          -> inherited R_INHERITED_RED
;   master's last finished run of the same check is green        -> own R_OWN_MERGE
;   master has no finished run (cancelled, none) and a named
;   path changed on master since the PR's merge base             -> inherited R_INHERITED_MOVED
;   otherwise                                                    -> unknown R_UNSEEN
; pr, named and moved are newline-separated path lists: the PR's changed files (gh pr diff
; --name-only), the files the failing log names, and the files master changed since the PR's
; merge base (git diff --name-only base origin/master). A path matches only as a whole line,
; byte for byte; an empty line matches nothing. master is M_GREEN, M_RED or M_UNSEEN; any other
; value reads as M_UNSEEN.
; The own-path rule comes first: when master is red too, a PR that touches a named file still
; fixes its own part. A green master makes any red the PR's, even on files the PR never
; touched -- that is the PR's merge with master failing, and only a rebase in the PR fixes it.
; R_INHERITED_MOVED is evidence, not proof: a counted ratchet ("dead mentions rose 138 -> 139")
; names old entries beside the new one, so one moved path is enough to say inherited, and the
; caller confirms on master before it calls the matter settled.
; Ask required_red.t27 first: it says whether a required check is red at all. None of #10797's
; four was required, so no push was due on any of them. This module answers the next question,
; for a red that does block: whose is it. Its lines are tagged O, apart from required_red's R.
; red_line writes   O TAB <own|inherited|unknown> TAB <why>\n   for one reason.
; The honest limits: the lists are what the caller read off GitHub and git; a flaky check that
; went red once on a green master reads as own here. This module decides; it pushes nothing.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawRedOrigin;

use claw::text;

/// The state of master's last finished run of the same check.
pub const M_GREEN : u8 = 0;
pub const M_RED : u8 = 1;
pub const M_UNSEEN : u8 = 2;

/// Verdicts.
pub const V_OWN : u8 = 0;
pub const V_INHERITED : u8 = 1;
pub const V_UNKNOWN : u8 = 2;

/// Reasons, one per red line.
pub const R_OWN_PATH : u8 = 0;
pub const R_OWN_MERGE : u8 = 1;
pub const R_INHERITED_RED : u8 = 2;
pub const R_INHERITED_MOVED : u8 = 3;
pub const R_UNSEEN : u8 = 4;
pub const R_COUNT : usize = 5;

pub const VERDICT_TEXTS : [3]str = ["O\town\t", "O\tinherited\t", "O\tunknown\t"];
pub const VERDICT_LENS : [3]usize = [6, 12, 10];

pub const WHY_TEXTS : [5]str = [
    "the log names a file this PR changes: fix it here and push\n",
    "master passes this check, so the PR's merge with master fails it: fix it here\n",
    "master fails this check too: do not push here; find or propose master's fix\n",
    "a file the log names changed on master since the PR's base, and the PR changes none: confirm on master, do not push here\n",
    "master has no finished run of this check and no named file settles it: read the log before you push\n"
];
pub const WHY_LENS : [5]usize = [59, 78, 76, 121, 100];

/// Whether b[s..e) is one whole line of list[0..list_len). An empty slice is on no list.
pub fn line_in(list : str, list_len : usize, b : str, s : usize, e : usize) -> bool {
    if (e <= s) { return false; }
    const n : usize = e - s;
    var i : usize = 0;
    while (i < list_len) {
        var j : usize = i;
        while (j < list_len and list[j] != '\n') { j += 1; }
        if (j - i == n) {
            var k : usize = 0;
            var same : bool = true;
            while (k < n) {
                if (list[i + k] != b[s + k]) { same = false; }
                k += 1;
            }
            if (same) { return true; }
        }
        i = j + 1;
    }
    return false;
}

/// How many lines of b[0..b_len) are lines of list.
pub fn hits(b : str, b_len : usize, list : str, list_len : usize) -> u32 {
    var n : u32 = 0;
    var s : usize = 0;
    while (s < b_len) {
        var e : usize = s;
        while (e < b_len and b[e] != '\n') { e += 1; }
        if (line_in(list, list_len, b, s, e)) { n += 1; }
        s = e + 1;
    }
    return n;
}

/// The reason for one failing check; its verdict is verdict_of(reason).
pub fn red_reason(pr : str, pr_len : usize, named : str, named_len : usize, moved : str, moved_len : usize, master : u8) -> u8 {
    if (hits(named, named_len, pr, pr_len) > 0) { return R_OWN_PATH; }
    if (master == M_RED) { return R_INHERITED_RED; }
    if (master == M_GREEN) { return R_OWN_MERGE; }
    if (hits(named, named_len, moved, moved_len) > 0) { return R_INHERITED_MOVED; }
    return R_UNSEEN;
}

/// The two own reasons are own, the two inherited reasons are inherited; every other reason, and
/// any value out of range, is unknown.
pub fn verdict_of(r : u8) -> u8 {
    if (r == R_OWN_PATH or r == R_OWN_MERGE) { return V_OWN; }
    if (r == R_INHERITED_RED or r == R_INHERITED_MOVED) { return V_INHERITED; }
    return V_UNKNOWN;
}

/// The red line for reason r into out at w, clipped at cap; returns the new cursor, which still
/// advances when clipped. A reason out of range writes the R_UNSEEN line.
pub fn red_line(r : u8, out : []u8, cap : usize, w : usize) -> usize {
    var k : u8 = r;
    if ((k as usize) >= R_COUNT) { k = R_UNSEEN; }
    const v : usize = verdict_of(k) as usize;
    const x : usize = put_str(out, cap, w, VERDICT_TEXTS[v], VERDICT_LENS[v]);
    return put_str(out, cap, x, WHY_TEXTS[k as usize], WHY_LENS[k as usize]);
}

// ---- tests: the four reds of PR #10797 ----

/// Five of the thirteen paths PR #10797 changed.
pub const PR : str = "specs/claw/move_gate.t27\nspecs/claw/reel_still.t27\n.trinity/seals/claw_ClawMoveGate.json\ndocs/claw/README.md\ndocs/reports/t27b_expectations.json\n";
pub const PR_LEN : usize = 145;

/// coverage and spec-guards named one spec; #10786 changed it on master.
pub const FRONT : str = "specs/t27f/frontend.t27\n";
pub const FRONT_LEN : usize = 24;
pub const MOVED_10786 : str = "specs/t27f/frontend.t27\nspecs/t27f/petal_menu.t27\n";
pub const MOVED_10786_LEN : usize = 50;

/// t27b-native-ratchet named nine specs; two of them here.
pub const RATCHET : str = "specs/analog/sar_switch.t27\nspecs/t27f/petal_menu.t27";
pub const RATCHET_LEN : usize = 53;

/// The dead-mention count names old entries beside the new one; #10790 changed AGENTS.md.
pub const DEAD : str = "docs/tri-ssot-integration.md\nAGENTS.md\ndocs/nona-03-manifest/SOUL.md\n";
pub const DEAD_LEN : usize = 69;
pub const MOVED_10790 : str = "AGENTS.md\nscripts/tri\nspecs/t27t/t27t.t27\n";
pub const MOVED_10790_LEN : usize = 42;

test the_stale_frontend_seal_was_inherited_from_master {
    // Master's runs of coverage were cancelled; the named spec moved on master.
    const r : u8 = red_reason(PR, PR_LEN, FRONT, FRONT_LEN, MOVED_10786, MOVED_10786_LEN, M_UNSEEN);
    assert r == R_INHERITED_MOVED;
    assert verdict_of(r) == V_INHERITED;
}

test the_ratchet_red_was_inherited_because_master_fails_it_too {
    const r : u8 = red_reason(PR, PR_LEN, RATCHET, RATCHET_LEN, "", 0, M_RED);
    assert r == R_INHERITED_RED;
    assert verdict_of(r) == V_INHERITED;
}

test the_dead_tri_count_was_inherited_through_one_moved_file {
    assert hits(DEAD, DEAD_LEN, MOVED_10790, MOVED_10790_LEN) == 1;
    const r : u8 = red_reason(PR, PR_LEN, DEAD, DEAD_LEN, MOVED_10790, MOVED_10790_LEN, M_UNSEEN);
    assert r == R_INHERITED_MOVED;
}

test a_named_file_the_pr_changes_is_own_even_when_master_is_red {
    const named : str = "specs/analog/sar_switch.t27\nspecs/claw/reel_still.t27\n";
    assert hits(named, 54, PR, PR_LEN) == 1;
    assert red_reason(PR, PR_LEN, named, 54, "", 0, M_RED) == R_OWN_PATH;
    assert red_reason(PR, PR_LEN, named, 54, named, 54, M_UNSEEN) == R_OWN_PATH;
    assert verdict_of(R_OWN_PATH) == V_OWN;
}

test a_green_master_makes_the_red_the_prs_even_on_moved_files {
    const r : u8 = red_reason(PR, PR_LEN, FRONT, FRONT_LEN, MOVED_10786, MOVED_10786_LEN, M_GREEN);
    assert r == R_OWN_MERGE;
    assert verdict_of(r) == V_OWN;
}

test with_no_finished_master_run_and_nothing_moved_it_is_unknown {
    assert red_reason(PR, PR_LEN, FRONT, FRONT_LEN, "", 0, M_UNSEEN) == R_UNSEEN;
    assert red_reason(PR, PR_LEN, "", 0, MOVED_10786, MOVED_10786_LEN, M_UNSEEN) == R_UNSEEN;
    assert verdict_of(R_UNSEEN) == V_UNKNOWN;
}

test a_log_that_names_no_file_follows_master_alone {
    assert red_reason(PR, PR_LEN, "", 0, "", 0, M_RED) == R_INHERITED_RED;
    assert red_reason(PR, PR_LEN, "", 0, "", 0, M_GREEN) == R_OWN_MERGE;
    assert red_reason(PR, PR_LEN, "\n\n", 2, "\n", 1, M_UNSEEN) == R_UNSEEN;
}

test a_master_state_out_of_range_reads_as_unseen {
    var m : u32 = 3;
    while (m < 256) {
        assert red_reason(PR, PR_LEN, FRONT, FRONT_LEN, MOVED_10786, MOVED_10786_LEN, m as u8) == R_INHERITED_MOVED;
        assert red_reason(PR, PR_LEN, FRONT, FRONT_LEN, "", 0, m as u8) == R_UNSEEN;
        m += 1;
    }
}

test negative_control_a_path_matches_only_as_a_whole_line {
    assert hits("specs/claw/move_gate.t2", 23, PR, PR_LEN) == 0;
    assert hits("specs/claw/move_gate.t27x", 25, PR, PR_LEN) == 0;
    assert hits("claw/move_gate.t27", 18, PR, PR_LEN) == 0;
    assert hits("pecs/claw/move_gate.t27", 23, PR, PR_LEN) == 0;
    assert hits("specs/claw/move_gate.t27", 24, PR, PR_LEN) == 1;
    assert hits("docs/reports/t27b_expectations.json", 35, PR, PR_LEN) == 1;
}

test negative_control_an_empty_line_matches_nothing {
    // Both lists carry an empty line; it must not count as a shared path.
    assert hits("a\n\nb", 4, "x\n\ny", 4) == 0;
    assert line_in("x\n\ny", 4, "a\n\nb", 2, 2) == false;
    assert hits("\n", 1, "\n", 1) == 0;
    assert hits("a", 1, "", 0) == 0;
}

test the_last_line_without_a_newline_is_read_to_the_end {
    assert hits(RATCHET, RATCHET_LEN, MOVED_10786, MOVED_10786_LEN) == 1;
    assert hits(RATCHET, RATCHET_LEN - 1, MOVED_10786, MOVED_10786_LEN) == 0;
    assert line_in("a\nbc", 4, "bc", 0, 2) == true;
    assert line_in("a\nbc", 3, "bc", 0, 2) == false;
}

test every_named_line_is_counted {
    assert hits(DEAD, DEAD_LEN, DEAD, DEAD_LEN) == 3;
    assert hits(PR, PR_LEN, PR, PR_LEN) == 5;
    assert hits(RATCHET, RATCHET_LEN, RATCHET, RATCHET_LEN) == 2;
}

test a_one_byte_list_at_the_end_of_a_full_buffer_is_not_read_past {
    var one : [1]u8 = undefined;
    one[0] = 'x';
    assert line_in(&one, 1, "x", 0, 1) == true;
    assert line_in(&one, 1, "y", 0, 1) == false;
    var two : [2]u8 = undefined;
    two[0] = 'x';
    two[1] = '\n';
    assert hits(&two, 2, "x", 1) == 1;
    assert hits(&two, 2, "xy", 2) == 0;
}

test only_two_reasons_are_own_and_two_inherited {
    var owns : u32 = 0;
    var inherits : u32 = 0;
    var r : u32 = 0;
    while (r < 256) {
        const v : u8 = verdict_of(r as u8);
        if (v == V_OWN) { owns += 1; assert r < 2; }
        if (v == V_INHERITED) { inherits += 1; assert r == 2 or r == 3; }
        r += 1;
    }
    assert owns == 2;
    assert inherits == 2;
    assert verdict_of(R_UNSEEN) == V_UNKNOWN;
}

test the_lens_are_the_text_lengths {
    var i : usize = 0;
    while (i < 3) {
        assert VERDICT_TEXTS[i][0] == 'O';
        assert VERDICT_TEXTS[i][1] == '\t';
        assert VERDICT_TEXTS[i][VERDICT_LENS[i] - 1] == '\t';
        assert VERDICT_TEXTS[i][VERDICT_LENS[i] - 2] != '\t';
        i += 1;
    }
    var k : usize = 0;
    while (k < R_COUNT) {
        assert WHY_TEXTS[k][WHY_LENS[k] - 1] == '\n';
        assert WHY_TEXTS[k][WHY_LENS[k] - 2] != '\n';
        k += 1;
    }
}

test each_red_line_is_spelled_out {
    var out : [160]u8 = undefined;
    assert red_line(R_OWN_PATH, &out, 160, 0) == 65;
    assert str_eq(&out, 6, "O\town\t", 6);
    assert out[6] == 't';
    assert red_line(R_OWN_MERGE, &out, 160, 0) == 84;
    assert out[6] == 'm';
    assert red_line(R_INHERITED_RED, &out, 160, 0) == 88;
    assert str_eq(&out, 12, "O\tinherited\t", 12);
    assert out[12] == 'm';
    assert red_line(R_INHERITED_MOVED, &out, 160, 0) == 133;
    assert out[12] == 'a';
    assert out[132] == '\n';
    assert red_line(R_UNSEEN, &out, 160, 0) == 110;
    assert str_eq(&out, 10, "O\tunknown\t", 10);
}

test out_of_range_reasons_write_the_unseen_line {
    var out : [160]u8 = undefined;
    var r : u32 = 5;
    while (r < 256) {
        assert red_line(r as u8, &out, 160, 0) == 110;
        assert out[2] == 'u';
        assert out[10] == 'm';
        assert out[109] == '\n';
        r += 1;
    }
}

test a_clipped_line_still_advances_the_cursor {
    var out : [8]u8 = undefined;
    assert red_line(R_INHERITED_RED, &out, 8, 0) == 88;
    assert out[2] == 'i';
    assert red_line(R_INHERITED_RED, &out, 8, 5) == 93;
}
