// specs/claw/merge_verdict.t27 -- claw: name the breaker of a master red, so
// fix_claim can refuse a self-fix bounty.
// Part of M10 milestone (milestone #14). Closes #10904.
// phi^2 + 1/phi^2 = 3 | TRINITY

module claw::merge_verdict;

pub const CLAW_MERGE_MAX_REASONS : u32 = 16;

pub struct MergeVerdict { approved: bool, reason: str };

pub fn merge_verdict_approved(v: MergeVerdict) -> bool {
    return v.approved;
}

test "merge_verdict_approved" {
    assert(merge_verdict_approved(MergeVerdict { approved: true, reason: "all green" }));
    assert(!merge_verdict_approved(MergeVerdict { approved: false, reason: "red build" }));
}

invariant claw_merge_max_reasons_positive {
    assert CLAW_MERGE_MAX_REASONS > 0;
}