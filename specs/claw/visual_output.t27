// SPDX-License-Identifier: Apache-2.0
; specs/claw/visual_output.t27 -- the particle-still layer of TRI CLAW's visual-output rule.
; Owner order 2026-10-18: every output in Claude Code carries a T27F visual, written into the TRI
; CLAW rules, and the T27F meant here is the particle video: the token_floor world
; (specs/t27f/token_floor.t27, token_floor_scenes.t27, token_floor_mux.t27, lesson_reel.t27).
; --
; The rule itself has one home, specs/t27mcp/visual_output.t27 (owner pick 2026-10-18): which answers
; carry a visual (needs_visual), how it reaches each host (answer_channel), and the verdict on a
; drawing made from t27f tool rows (answer_verdict). This spec imports those and adds only what is
; particular to a particle still:
; - Which answer's visual is a still: a report of a piece of work (K_REPORT). A spec, a flow or
;   numbers are drawn from t27f tool rows, as the t27mcp law says; a still backs no row, so it is
;   not their visual.
; - The still is one PNG frame of a rendered token_floor reel, taken at STILL_MS: after the hook has
;   written its statement and before the CTA hold.
; - It is rendered on the Railway lab, never on the owner's Mac (owner rule 2026-10-09). No MCP tool
;   renders one yet; the lab recipe (render the reel, then `ffmpeg -ss <s> -frames:v 1`) is the only
;   path, and a reel_still tool in TRI CLAW's /mcp is the follow-up.
; - It is a file, not an inline widget, so its channel is answer_channel for a drawing on a host with
;   no visual tool. On the desktop Code tab that is the file pane, which opens only files inside the
;   session's folder (measured 2026-10-18), so the PNG goes there.
; - A still that could not be made is reported missing, with the reason; an older file is never shown
;   as this turn's.
; Not measured: whether TRI CLAW's chat shows a PNG URL (the t27mcp header measured .svg only).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawVisualOutput;

use t27mcp::visual_output::needs_visual;
use t27mcp::visual_output::answer_channel;
use t27mcp::visual_output::K_SPEC;
use t27mcp::visual_output::K_FLOW;
use t27mcp::visual_output::K_NUMBERS;
use t27mcp::visual_output::K_REPORT;
use t27mcp::visual_output::K_ONE_SENTENCE;
use t27mcp::visual_output::K_QUESTION;
use t27mcp::visual_output::HOST_CLAUDE_CODE_CLI;
use t27mcp::visual_output::HOST_CLAUDE_CODE_DESKTOP;
use t27mcp::visual_output::HOST_MCP_APPS;
use t27mcp::visual_output::HOST_TRI_CLAW;
use t27mcp::visual_output::CH_FILE_PATH;
use t27mcp::visual_output::CH_FILE_AND_PANE;
use t27mcp::visual_output::CH_UI_RESOURCE;
use t27mcp::visual_output::CH_IMAGE_URL;
use t27f::reel_marketing::REEL_HOOK_MS;
use t27f::reel_marketing::REEL_CTA_MIN_MS;
use t27f::reel_marketing::REEL_MIN_MS;

/// The still is this frame of a reel: past the hook's decision window, before the CTA hold.
pub const STILL_MS : i32 = 9000;

/// Where the still's file is put.
pub const PLACE_ANY : u32 = 0;     // any path, printed in the answer
pub const PLACE_SESSION : u32 = 1; // inside the session's folder

/// Whether an answer of this kind shows a particle still as its visual.
pub fn takes_still(kind: u32) -> bool {
    return kind == K_REPORT;
}

/// How the still reaches the user: a drawn file on a host with no inline visual tool.
pub fn still_channel(host: u32) -> u32 {
    return answer_channel(host, false, true);
}

/// The file goes inside the session folder wherever the host opens it in a pane.
pub fn place_for(host: u32) -> u32 {
    if (still_channel(host) == CH_FILE_AND_PANE) {
        return PLACE_SESSION;
    }
    return PLACE_ANY;
}

/// A still frame shows the statement, not the hook still writing it and not the CTA hold.
pub fn still_ms_ok(ms: i32) -> bool {
    return ms > REEL_HOOK_MS and ms < REEL_MIN_MS - REEL_CTA_MIN_MS;
}

/// An answer is honest about its still when the still was made this turn or is said missing.
pub fn still_report_ok(kind: u32, made: bool, said_missing: bool) -> bool {
    if (takes_still(kind) == false) {
        return true;
    }
    return made or said_missing;
}

test only_a_report_takes_a_still {
    assert takes_still(K_REPORT);
    assert takes_still(K_SPEC) == false;
    assert takes_still(K_FLOW) == false;
    assert takes_still(K_NUMBERS) == false;
    assert takes_still(K_ONE_SENTENCE) == false;
    assert takes_still(K_QUESTION) == false;
}

test every_still_is_an_answer_the_t27mcp_law_gives_a_visual {
    var k : u32 = 0;
    var stills : u32 = 0;
    while (k <= K_QUESTION) {
        if (takes_still(k)) {
            assert needs_visual(k);
            stills = stills + 1;
        }
        k = k + 1;
    }
    assert stills == 1;
}

test the_still_is_a_file_not_a_widget {
    assert still_channel(HOST_CLAUDE_CODE_DESKTOP) == CH_FILE_AND_PANE;
    assert still_channel(HOST_CLAUDE_CODE_CLI) == CH_FILE_PATH;
    assert still_channel(HOST_MCP_APPS) == CH_UI_RESOURCE;
    assert still_channel(HOST_TRI_CLAW) == CH_IMAGE_URL;
}

test the_desktop_file_sits_in_the_session_folder {
    assert place_for(HOST_CLAUDE_CODE_DESKTOP) == PLACE_SESSION;
    assert place_for(HOST_CLAUDE_CODE_CLI) == PLACE_ANY;
    assert place_for(HOST_MCP_APPS) == PLACE_ANY;
    assert place_for(HOST_TRI_CLAW) == PLACE_ANY;
}

test the_still_is_past_the_hook_and_before_the_cta {
    assert still_ms_ok(STILL_MS);
    assert still_ms_ok(REEL_HOOK_MS) == false;
    assert still_ms_ok(1000) == false;
    assert still_ms_ok(14000) == false;
}

test a_missing_still_is_said_never_skipped {
    assert still_report_ok(K_REPORT, true, false);
    assert still_report_ok(K_REPORT, false, true);
    assert still_report_ok(K_REPORT, false, false) == false;
    assert still_report_ok(K_SPEC, false, false);
    assert still_report_ok(K_ONE_SENTENCE, false, false);
}
