// SPDX-License-Identifier: Apache-2.0
; specs/claw/visual_output.t27 -- every TRI CLAW output that did work carries a T27F visual, as law.
; Owner order 2026-10-18: study the T27F visualizer through the MCP tools, take the best practices,
; make the output in Claude Code always carry a visual, and write that into the TRI CLAW rules. The
; owner's T27F here is the particle video: the token_floor world (specs/t27f/token_floor.t27,
; token_floor_scenes.t27, token_floor_mux.t27, lesson_reel.t27), rendered as a reel.
; --
; The rule, each row tested below:
; - a reply that only talks (a short answer, a question back) needs no visual. Every other output
;   needs one: a turn that changed files or ran commands, a spec added or explained, a status report,
;   a reel, a TRI CLAW check-run on a pull request.
; - The default visual is a particle STILL: one PNG frame of a rendered token_floor reel, taken at
;   STILL_MS, after the hook has written its statement and before the CTA hold. A reel output carries
;   the reel itself (tall and wide) plus its still. A spec output also carries the spec's T27F GRAPH.
;   A check-run carries a LINK (claw/t27f and the T27F preview already post one).
; - Particle frames are rendered on the Railway lab, never on the owner's Mac (owner rule
;   2026-10-09). The MCP stills (t27f_graph, t27f_view) are SVG the MCP host draws.
; - Where it goes is T27fReel.channel_for (specs/t27f/reel.t27), imported, not copied. On the
;   desktop Code tab the file sits inside the session's folder (a gitignored out dir of the
;   worktree): the file pane opens only files there, and the Browser pane shows a file outside the
;   project folder only as a static snapshot (measured 2026-10-18).
; - Honesty: a visual that could not be made is reported missing, with the reason. It is never
;   skipped silently, and an older file is never shown as this turn's. A spec graph is EXPORTED only
;   when the MCP corpus served the spec and it fits the tool's caps. A larger one is FOLDED
;   (specs/t27f/spec_graph_fold.t27), never truncated. An unserved one is a MANUAL reading and is
;   called that.
; - A slide headline longer than T27fDeck.MAX_HEADLINE_LINES is split over more slides, not cut.
; --
; Measured 2026-10-18 through the MCP tools (gHashTag/t27-mcp):
; - t27f_outline and t27f_graph read the published corpus at t27.ai/t27/files/.
;   specs/tutorial/08_modules_and_arrays.t27 is served (14 nodes, 9 edges, exact only). But
;   specs/t27f/*.t27 and specs/claw/*.t27 answer 404, so the visualizer cannot yet draw its own
;   specs or TRI CLAW's: GRAPH_MANUAL until they are published.
; - t27f_view refuses a 3-line headline ("split it into a second slide"). It writes to the temp
;   directory unless `out` names a path, and on the desktop that temp path is outside the session.
; - No MCP tool renders a particle still. The lab recipe (render the reel, then
;   `ffmpeg -ss <s> -frames:v 1`) is the only path today; a reel_still tool in TRI CLAW's /mcp is
;   the follow-up.
; The caps GRAPH_NODE_CAP / GRAPH_EDGE_CAP are the t27f_graph tool's own (its description,
; 2026-10-18), not a spec's; the exporter itself reaches 1024 / 4096.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawVisualOutput;

use t27f::reel::channel_for;
use t27f::reel::HOST_CLAUDE_CODE_CLI;
use t27f::reel::HOST_CLAUDE_CODE_DESKTOP;
use t27f::reel::HOST_MCP_APPS;
use t27f::reel::HOST_SITE;
use t27f::reel::CHANNEL_FILE_AND_PANE;
use t27f::deck::MAX_HEADLINE_LINES;
use t27f::reel_marketing::REEL_HOOK_MS;
use t27f::reel_marketing::REEL_CTA_MIN_MS;
use t27f::reel_marketing::REEL_MIN_MS;

/// What an output is.
pub const OUT_TALK : u8 = 0;     // a short answer, a question back, conversation
pub const OUT_WORK : u8 = 1;     // a turn that changed files or ran commands
pub const OUT_SPEC : u8 = 2;     // a .t27 spec added, changed or explained
pub const OUT_STATUS : u8 = 3;   // a status or progress report
pub const OUT_REEL : u8 = 4;     // the output is a reel
pub const OUT_CHECK : u8 = 5;    // a TRI CLAW check-run on a pull request
pub const OUT_KINDS : u8 = 6;

/// What it carries, one bit each, so one output can carry several.
pub const VIS_STILL : u8 = 1;    // particle still, PNG, one frame of a token_floor reel
pub const VIS_REEL : u8 = 2;     // the reel, tall and wide mp4
pub const VIS_GRAPH : u8 = 4;    // the spec's T27F graph, SVG, from t27f_graph
pub const VIS_LINK : u8 = 8;     // a link in the check-run summary

/// Where a visual is made.
pub const RENDER_LAB : u8 = 0;   // the Railway lab
pub const RENDER_HOST : u8 = 1;  // the MCP host

/// Where the file is put.
pub const PLACE_ANY : u8 = 0;     // any path, printed in the answer
pub const PLACE_SESSION : u8 = 1; // inside the session's folder

/// How a spec graph is labelled.
pub const GRAPH_EXPORTED : u8 = 0;
pub const GRAPH_FOLDED : u8 = 1;
pub const GRAPH_MANUAL : u8 = 2;
pub const GRAPH_NODE_CAP : u32 = 192;
pub const GRAPH_EDGE_CAP : u32 = 254;

/// The still is this frame of a reel: past the hook's decision window, before the CTA hold.
pub const STILL_MS : i32 = 9000;

pub fn has(v: u8, bit: u8) -> bool {
    return @mod(v / bit, 2) == 1;
}

/// The visuals an output of this kind carries. A kind this law does not know gets the default
/// still: a reader that waves through an unknown kind with no visual is not a rule.
pub fn visuals_for(kind: u8) -> u8 {
    if (kind == OUT_TALK) {
        return 0;
    }
    if (kind == OUT_SPEC) {
        return VIS_STILL + VIS_GRAPH;
    }
    if (kind == OUT_REEL) {
        return VIS_STILL + VIS_REEL;
    }
    if (kind == OUT_CHECK) {
        return VIS_LINK;
    }
    return VIS_STILL;
}

pub fn needs_visual(kind: u8) -> bool {
    return visuals_for(kind) != 0;
}

/// Particle frames come from the lab; SVG from the MCP host.
pub fn render_place(bit: u8) -> u8 {
    if (bit == VIS_STILL or bit == VIS_REEL) {
        return RENDER_LAB;
    }
    return RENDER_HOST;
}

/// The file goes inside the session folder wherever the host opens it in a pane.
pub fn place_for(host: u8) -> u8 {
    if (channel_for(host) == CHANNEL_FILE_AND_PANE) {
        return PLACE_SESSION;
    }
    return PLACE_ANY;
}

pub fn graph_label(served: bool, nodes: u32, edges: u32) -> u8 {
    if (served == false) {
        return GRAPH_MANUAL;
    }
    if (nodes > GRAPH_NODE_CAP or edges > GRAPH_EDGE_CAP) {
        return GRAPH_FOLDED;
    }
    return GRAPH_EXPORTED;
}

/// An output is honest when every visual it needs was made this turn or is reported missing.
pub fn report_ok(kind: u8, made: u8, said_missing: u8) -> bool {
    const need = visuals_for(kind);
    var ok = true;
    var bit : u8 = 1;
    while (bit <= VIS_LINK) {
        if (has(need, bit) and has(made, bit) == false and has(said_missing, bit) == false) {
            ok = false;
        }
        bit = bit * 2;
    }
    return ok;
}

/// A still frame shows the statement, not the hook still writing it and not the CTA hold.
pub fn still_ms_ok(ms: i32) -> bool {
    return ms > REEL_HOOK_MS and ms < REEL_MIN_MS - REEL_CTA_MIN_MS;
}

/// Slides a headline of this many lines takes: split, never cut.
pub fn slides_for(lines: i32) -> i32 {
    return (lines + MAX_HEADLINE_LINES - 1) / MAX_HEADLINE_LINES;
}

test only_talk_goes_without_a_visual {
    assert needs_visual(OUT_TALK) == false;
    var k : u8 = 1;
    while (k < OUT_KINDS) {
        assert needs_visual(k);
        k = k + 1;
    }
    assert visuals_for(OUT_KINDS) == VIS_STILL;
    assert visuals_for(200) == VIS_STILL;
}

test each_kind_carries_its_visuals {
    assert visuals_for(OUT_WORK) == VIS_STILL;
    assert visuals_for(OUT_STATUS) == VIS_STILL;
    assert has(visuals_for(OUT_SPEC), VIS_STILL) and has(visuals_for(OUT_SPEC), VIS_GRAPH);
    assert has(visuals_for(OUT_REEL), VIS_REEL) and has(visuals_for(OUT_REEL), VIS_STILL);
    assert has(visuals_for(OUT_REEL), VIS_GRAPH) == false;
    assert visuals_for(OUT_CHECK) == VIS_LINK;
}

test particle_frames_come_from_the_lab {
    assert render_place(VIS_STILL) == RENDER_LAB;
    assert render_place(VIS_REEL) == RENDER_LAB;
    assert render_place(VIS_GRAPH) == RENDER_HOST;
}

test the_desktop_file_sits_in_the_session_folder {
    assert place_for(HOST_CLAUDE_CODE_DESKTOP) == PLACE_SESSION;
    assert place_for(HOST_CLAUDE_CODE_CLI) == PLACE_ANY;
    assert place_for(HOST_MCP_APPS) == PLACE_ANY;
    assert place_for(HOST_SITE) == PLACE_ANY;
}

test a_graph_says_how_it_was_read {
    // tutorial 08, as t27f_outline served it on 2026-10-18
    assert graph_label(true, 14, 9) == GRAPH_EXPORTED;
    assert graph_label(true, 192, 254) == GRAPH_EXPORTED;
    // the largest spec in specs/ after derive: 775 nodes, 3194 edges
    assert graph_label(true, 775, 3194) == GRAPH_FOLDED;
    assert graph_label(true, 193, 9) == GRAPH_FOLDED;
    // specs/claw/*.t27 answered 404
    assert graph_label(false, 14, 9) == GRAPH_MANUAL;
}

test a_missing_visual_is_said_never_skipped {
    assert report_ok(OUT_TALK, 0, 0);
    assert report_ok(OUT_WORK, VIS_STILL, 0);
    assert report_ok(OUT_WORK, 0, 0) == false;
    assert report_ok(OUT_WORK, 0, VIS_STILL);
    assert report_ok(OUT_SPEC, VIS_STILL, 0) == false;
    assert report_ok(OUT_SPEC, VIS_STILL, VIS_GRAPH);
    assert report_ok(OUT_REEL, VIS_STILL + VIS_REEL, 0);
    assert report_ok(OUT_CHECK, VIS_STILL, 0) == false;
}

test the_still_is_past_the_hook_and_before_the_cta {
    assert still_ms_ok(STILL_MS);
    assert still_ms_ok(REEL_HOOK_MS) == false;
    assert still_ms_ok(1000) == false;
    assert still_ms_ok(14000) == false;
}

test a_long_headline_takes_more_slides {
    assert slides_for(1) == 1;
    assert slides_for(2) == 1;
    assert slides_for(3) == 2;
    assert slides_for(5) == 3;
}
