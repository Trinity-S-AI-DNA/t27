// SPDX-License-Identifier: Apache-2.0
; specs/claw/gates.t27 -- the TRI CLAW gate inventory: every CI gate in this repository, as data.
; Epic #9271. This file is the single source of truth the TRI CLAW service reads: `tri claw status`
; (T2) lowers it with t27c and diffs the names below against .github/workflows/*.yml on disk, so a
; workflow file cannot land without its row here in the same commit -- the same ratchet discipline
; scripts/ci/check_pr_branch_filters.py holds for merge-critical classification.
; --
; Class rule, mechanically checkable from the workflow files:
; - G_SOFT: the workflow carries `continue-on-error` -- failure is reported, never fatal
;   (oracle-nightly, queen-doctor, rings-rust).
; - G_REPORTING: the workflow only merges, opens or files work -- its own failure gates no merge
;   (auto-merge-ready-prs merges ready PRs; queen-publish opens PRs from bee branches, and the
;   gates on those PRs are what gate). Same judgement, same two files, as the NOT_MERGE_CRITICAL
;   entries in scripts/ci/check_pr_branch_filters.py; stated here as data, not copied reasoning.
; - G_BLOCKING: everything else -- a failure can fail the run and so can block a merge.
; - An unknown name is G_UNKNOWN, never G_BLOCKING: a gate list that silently waves through a name
;   it does not know is not a gate list (fail-closed applies to the inventory reader in T2).
; Snapshot: 65 workflows on master, 2026-10-12. Counts: 60 blocking + 3 soft + 2 reporting.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawGates;

/// A workflow class. G_UNKNOWN is deliberately far from the real classes so a
/// partial read cannot mistake it for a verdict.
pub const G_BLOCKING : u8 = 0;
pub const G_SOFT : u8 = 1;
pub const G_REPORTING : u8 = 2;
pub const G_UNKNOWN : u8 = 255;

/// Workflow names (file stems, no .yml), alphabetical inside each list.
pub const BLOCKING : [60]str = [
    "agent-runner-docker", "bootstrap-tests", "brain-seal-refresh", "build-paper",
    "build-vivado-image", "catalog-count-gate", "cli-tri", "conflict-markers",
    "conformance-integrity-gate", "coq-kernel", "coq-proofs", "corpus-ratchet",
    "damage-negatives", "deploy-api", "documented-commands", "dupe-ratchet",
    "emit-bitexact-gate", "exhaustive-nightly", "fix-carries-source", "fpga-build",
    "gate-topology", "gf-wide-conformance", "gf16-conformance", "harness-scratch",
    "issue-gate", "l1-traceability", "lean-proofs", "loop-tools-gate",
    "needs-boundary", "orphan-modules", "own-language", "pack-index-consistency-gate",
    "phi-loop-ci", "pr-dashboard", "pusher", "queen-export-push",
    "queen-feed-empty-bodies", "queen-feed-roadmap", "queen-feed-untested", "queen-refile",
    "queen-watchdog", "release", "sandbox-docker", "sbom",
    "schema-validation", "scorecard", "seal-coverage", "seal-staleness-warn",
    "secret-scan", "sign-release", "spec-guards", "spec-parse-ratchet",
    "t27b-native", "untrusted-input-gate", "verilog-widths", "vivado-synth",
    "wasm-explorer", "withdrawn-live-gate", "xilinx7-l3-bench", "zenodo-publish",
];
pub const SOFT : [3]str = ["oracle-nightly", "queen-doctor", "rings-rust"];
pub const REPORTING : [2]str = ["auto-merge-ready-prs", "queen-publish"];

/// Total workflow files in .github/workflows/ this inventory claims to cover.
/// T2 fails when the directory and this number disagree.
pub const COUNT : u32 = 65;

fn in_blocking(name: str) -> bool {
    for i in 0..60 {
        if BLOCKING[i] == name { return true; }
    }
    return false;
}

fn in_soft(name: str) -> bool {
    for i in 0..3 {
        if SOFT[i] == name { return true; }
    }
    return false;
}

fn in_reporting(name: str) -> bool {
    for i in 0..2 {
        if REPORTING[i] == name { return true; }
    }
    return false;
}

/// The class of one workflow name; G_UNKNOWN when the name is not in the inventory.
pub fn class_of(name: str) -> u8 {
    if in_blocking(name) { return G_BLOCKING; }
    if in_soft(name) { return G_SOFT; }
    if in_reporting(name) { return G_REPORTING; }
    return G_UNKNOWN;
}

/// Whether a failure of this workflow can block a merge. Unknown names are
/// never blocking: the caller must classify them, not assume them away.
pub fn is_blocking(name: str) -> bool {
    return class_of(name) == G_BLOCKING;
}

test merge_critical_gates_are_blocking {
    assert is_blocking("issue-gate") == true;
    assert is_blocking("schema-validation") == true;
    assert is_blocking("own-language") == true;
}

test soft_gates_carry_continue_on_error {
    assert class_of("oracle-nightly") == G_SOFT;
    assert class_of("queen-doctor") == G_SOFT;
    assert class_of("rings-rust") == G_SOFT;
    assert is_blocking("rings-rust") == false;
}

test reporting_gates_never_block_a_merge {
    assert class_of("auto-merge-ready-prs") == G_REPORTING;
    assert class_of("queen-publish") == G_REPORTING;
    assert is_blocking("auto-merge-ready-prs") == false;
    assert is_blocking("queen-publish") == false;
}

test nightly_pair_contrast {
    ; exhaustive-nightly has no continue-on-error, so it blocks; oracle-nightly does, so it is soft.
    assert class_of("exhaustive-nightly") == G_BLOCKING;
    assert class_of("oracle-nightly") == G_SOFT;
}

test heavy_hw_gates_are_blocking {
    assert is_blocking("fpga-build") == true;
    assert is_blocking("verilog-widths") == true;
    assert is_blocking("xilinx7-l3-bench") == true;
    assert is_blocking("t27b-native") == true;
}

test list_edges_resolve_to_their_own_class {
    assert class_of(BLOCKING[0]) == G_BLOCKING;
    assert class_of(BLOCKING[59]) == G_BLOCKING;
    assert class_of(SOFT[0]) == G_SOFT;
    assert class_of(REPORTING[1]) == G_REPORTING;
}

test unknown_name_is_unknown_and_not_blocking {
    assert class_of("no-such-gate") == G_UNKNOWN;
    assert is_blocking("no-such-gate") == false;
}

test inventory_counts_add_up {
    assert 60 + 3 + 2 == COUNT;
}
