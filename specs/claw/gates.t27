/// The class of one workflow name; G_UNKNOWN when the name is not in the
/// inventory. name_len is explicit: gen-c lowers str to const char* and
/// carries no .len (the affected.t27 idiom, kept everywhere in this module).
pub fn class_of(name: str, name_len: usize) -> u8 {
    for i in 0..69 {
        if str_eq(NAMES[i], NAME_LENS[i], name, name_len) { return CLASSES[i]; }
    }
    return G_UNKNOWN;
}

/// Whether a failure of this workflow can block a merge. Unknown names are
/// never blocking: the caller must classify them, not assume them away.
pub fn is_blocking(name: str, name_len: usize) -> bool {
    return class_of(name, name_len) == G_BLOCKING;
}

/// Trigger keys of one workflow name; "" when the name is not in the inventory.
pub fn events_of(name: str, name_len: usize) -> str {
    for i in 0..69 {
        if str_eq(NAMES[i], NAME_LENS[i], name, name_len) { return EVENTS[i]; }
    }
    return "";
}

/// Length of events_of(name); 0 when the name is not in the inventory. A caller that lowers
/// through gen-c compares the result with str_eq and this length: `events_of(x) == "..."` would
/// lower to a C pointer comparison (#8013).
pub fn events_len_of(name: str, name_len: usize) -> usize {
    for i in 0..69 {
        if str_eq(NAMES[i], NAME_LENS[i], name, name_len) { return EVENT_LENS[i]; }
    }
    return 0;
}

/// How many workflows carry a given class.
pub fn count_class(c: u8) -> u32 {
    let mut n : u32 = 0;
    for i in 0..69 {
        if CLASSES[i] == c { n += 1; }
    }
    return n;
}

/// Every row of a table shaped like this one has a name and a recorded trigger set. The
/// columns are parameters so a test can hand in a copy with one hole: a check that only reads
/// the constant table can never fail, and no mutant of it can die (#10686). It reads the length
/// columns, not the strings: gen-c lowers `s == ""` to a C pointer comparison, so in the
/// committed gates.c an empty-string test compared addresses, not contents.
pub fn rows_filled(name_lens: [69]usize, event_lens: [69]usize) -> bool {
    for i in 0..69 {
        if name_lens[i] == 0 { return false; }
        if event_lens[i] == 0 { return false; }
    }
    return true;
}

/// Every row of the inventory has a name and a recorded trigger set.
pub fn every_row_filled() -> bool {
    return rows_filled(NAME_LENS, EVENT_LENS);
}

/// No name appears twice in a name column (with its length column).
pub fn names_unique_in(names: [69]str, lens: [69]usize) -> bool {
    for i in 0..69 {
        for j in (i + 1)..69 {
            if str_eq(names[i], lens[i], names[j], lens[j]) { return false; }
        }
    }
    return true;
}

pub fn all_names_unique() -> bool {
    return names_unique_in(NAMES, NAME_LENS);
}

/// Every class in a class column is one of the three real classes.
pub fn classes_known(cl: [69]u8) -> bool {
    for i in 0..69 {
        if cl[i] != G_BLOCKING {
            if cl[i] != G_SOFT {
                if cl[i] != G_REPORTING {
                    return false;
                }
            }
        }
    }
    return true;
}

/// Every class literal in CLASSES is one of the three real classes.
pub fn all_classes_known() -> bool {
    return classes_known(CLASSES);
}

// ---------------------------------------------------------------------------
// The audit law (T2, Refs #9271): does the live .github/workflows directory
// agree with this inventory? The runner the gate-topology workflow compiles
// feeds `ls` of that directory -- one workflow stem per line -- to
// claw_status's dir_text, prints the report, and exits with the problem count.
// Exit contract matches specs/claw/service.t27: 0 clean, otherwise DRIFT.
// ---------------------------------------------------------------------------

/// Problem kinds of the audit. P_OK: the row and the directory agree.
pub const P_OK : u8 = 0;
pub const P_SPEC_ONLY : u8 = 1;
pub const P_DIR_ONLY : u8 = 2;

/// Report vocabulary: the line each problem prints, by kind.
pub const LINE_PREFIX : [3]str = [
    "", "SPEC-ONLY  ", "DIR-ONLY   ",
];
pub const LINE_SUFFIX : [3]str = [
    "",
    "  (workflow file gone; regenerate the spec)",
    "  (workflow not in the matrix; regenerate the spec)",
];
pub const PREFIX_LENS : [3]usize = [0, 11, 11];
pub const SUFFIX_LENS : [3]usize = [0, 43, 51];
pub const COV_HEAD : str = "claw: gate-class coverage, generated from specs/claw/gates.t27";
pub const COV_HEAD_LEN : usize = 62;
pub const CLASS_LABELS : [3]str = ["G_BLOCKING", "G_SOFT", "G_REPORTING"];
pub const CLASS_LABEL_LENS : [3]usize = [10, 6, 11];

pub const AUDIT_HEAD : str = "claw: gate inventory vs .github/workflows (specs/claw/gates.t27)";
pub const HEAD_LEN : usize = 64;
pub const OK_TAIL : str = "claw: matrix is current";
pub const OK_TAIL_LEN : usize = 23;
pub const DRIFT_TAIL : str = "claw: DRIFT -- regenerate specs/claw/gates.t27 (docs/claw/README.md)";
pub const DRIFT_TAIL_LEN : usize = 68;

/// Length of the line starting at start, excluding its newline. A last line
/// without a newline ends at dir_len.
fn line_len(dir_text : []const u8, dir_len : usize, start : usize) -> usize {
    var i : usize = start;
    while (i < dir_len) {
        if (dir_text[i] == '\n') { return i - start; }
        i += 1;
    }
    return dir_len - start;
}

/// Byte equality of one directory line and one inventory name. Same loop as
/// str_eq, over a slice window instead of a str.
fn line_eq_name(dir_text : []const u8, start : usize, len : usize, name : str, name_len : usize) -> bool {
    if (len != name_len) { return false; }
    var k : usize = 0;
    var diff : usize = 0;
    while (k < len) {
        if (dir_text[start + k] != name[k]) { diff += 1; }
        k += 1;
    }
    return diff == 0;
}

/// Whether the directory listing names this inventory row. A workflow whose
/// file is gone is the audit's SPEC-ONLY problem, so this is the whole lookup.
pub fn dir_has(dir_text : []const u8, dir_len : usize, name : str, name_len : usize) -> bool {
    var start : usize = 0;
    while (start < dir_len) {
        var len : usize = line_len(dir_text, dir_len, start);
        if (line_eq_name(dir_text, start, len, name, name_len)) { return true; }
        start = start + len + 1;
    }
    return false;
}

/// Whether one directory line names any inventory row -- the DIR-ONLY lookup.
fn line_in_names(dir_text : []const u8, start : usize, len : usize) -> bool {
    for i in 0..69 {
        if (line_eq_name(dir_text, start, len, NAMES[i], NAME_LENS[i])) { return true; }
    }
    return false;
}

/// The audit: diff the directory listing against this inventory. dir_text is
/// `ls` output, one workflow stem per line; the report text lands in out; the
/// return value is the problem count -- the runner's exit code, 0 clean
/// otherwise DRIFT, per specs/claw/service.t27.
pub fn claw_status(dir_text : []const u8, dir_len : usize, out : []u8, out_cap : usize) -> i32 {
    var w : usize = 0;
    var problems : i32 = 0;
    w = put_str(out, out_cap, w, AUDIT_HEAD, HEAD_LEN);
    w = put_str(out, out_cap, w, "\n", 1);
    // spec rows whose workflow file is gone
    for i in 0..69 {
        if (dir_has(dir_text, dir_len, NAMES[i], NAME_LENS[i]) == false) {
            w = put_str(out, out_cap, w, LINE_PREFIX[P_SPEC_ONLY], PREFIX_LENS[P_SPEC_ONLY]);
            w = put_str(out, out_cap, w, NAMES[i], NAME_LENS[i]);
            w = put_str(out, out_cap, w, LINE_SUFFIX[P_SPEC_ONLY], SUFFIX_LENS[P_SPEC_ONLY]);
            w = put_str(out, out_cap, w, "\n", 1);
            problems += 1;
        }
    }
    // workflow files with no spec row
    var start : usize = 0;
    while (start < dir_len) {
        var len : usize = line_len(dir_text, dir_len, start);
        if (len > 0) {
            if (line_in_names(dir_text, start, len) == false) {
                w = put_str(out, out_cap, w, LINE_PREFIX[P_DIR_ONLY], PREFIX_LENS[P_DIR_ONLY]);
                var k : usize = 0;
                while (k < len) {
                    if (w + k < out_cap) { out[w + k] = dir_text[start + k]; }
                    k += 1;
                }
                w = w + len;
                w = put_str(out, out_cap, w, LINE_SUFFIX[P_DIR_ONLY], SUFFIX_LENS[P_DIR_ONLY]);
                w = put_str(out, out_cap, w, "\n", 1);
                problems += 1;
            }
        }
        start = start + len + 1;
    }
    if (problems == 0) {
        w = put_str(out, out_cap, w, OK_TAIL, OK_TAIL_LEN);
    } else {
        w = put_str(out, out_cap, w, DRIFT_TAIL, DRIFT_TAIL_LEN);
    }
    w = put_str(out, out_cap, w, "\n", 1);
    return problems;
}

/// The T8 coverage report, generated from this spec's own tables at call
/// time: one line per real gate class -- its census, the merge verdict the
/// law gives a member of it, and the first rows that carry it -- then the
/// lookup-miss class. The verdict is asked of is_blocking, not read off the
/// class constant, so the report cannot claim a class the law does not
/// answer for. Returns bytes written; the audit stays claw_status.
pub fn claw_coverage_report(out : []u8, out_cap : usize) -> usize {
    var w : usize = 0;
    w = put_str(out, out_cap, w, COV_HEAD, COV_HEAD_LEN);
    w = put_str(out, out_cap, w, "\n", 1);
    var ci : usize = 0;
    var c : u8 = 0;
    while (ci < 3) {
        w = put_str(out, out_cap, w, CLASS_LABELS[ci], CLASS_LABEL_LENS[ci]);
        w = put_str(out, out_cap, w, " n=", 3);
        w = put_count(out, out_cap, w, count_class(c));
        w = put_str(out, out_cap, w, " blocking=", 10);
        var shown : usize = 0;
        var i : usize = 0;
        while (i < 69) {
            if (shown < 3) {
                if (CLASSES[i] == c) {
                    if (shown == 0) {
                        if (is_blocking(NAMES[i], NAME_LENS[i]) == true) {
                            w = put_str(out, out_cap, w, "true", 4);
                        } else {
                            w = put_str(out, out_cap, w, "false", 5);
                        }
                        w = put_str(out, out_cap, w, " e.g. ", 6);
                    } else {
                        w = put_str(out, out_cap, w, ", ", 2);
                    }
                    w = put_str(out, out_cap, w, NAMES[i], NAME_LENS[i]);
                    shown += 1;
                }
            }
            i += 1;
        }
        w = put_str(out, out_cap, w, "\n", 1);
        ci += 1;
        c += 1;
    }
    w = put_str(out, out_cap, w, "G_UNKNOWN n=", 12);
    w = put_count(out, out_cap, w, count_class(G_UNKNOWN));
    w = put_str(out, out_cap, w, " blocking=false (lookup miss)\n", 30);
    return w;
}

test class_constants_are_the_documented_mapping {
    assert class_of("oracle-nightly", 14) == G_SOFT;
    assert class_of("queen-doctor", 12) == G_SOFT;
    assert class_of("rings-rust", 10) == G_SOFT;
    assert class_of("auto-merge-ready-prs", 20) == G_REPORTING;
    assert class_of("queen-publish", 13) == G_REPORTING;
    assert class_of("zenodo-publish", 14) == G_BLOCKING;
    assert class_of("no-such-gate", 12) == G_UNKNOWN;
}

test completeness_every_row_has_name_and_events {
    assert every_row_filled() == true;
    assert count_class(G_BLOCKING) + count_class(G_SOFT) + count_class(G_REPORTING) == COUNT;
}

test known_classes_only {
    assert all_classes_known() == true;
}

test no_duplicate_names_pairwise {
    assert all_names_unique() == true;
}

test critical_gates_present_and_blocking {
    // Lengths are hand-counted literals because .len cannot lower under gen-c
    // (gates_pins.t27 pins the tables to the bytes). A wrong literal here
    // fails the assert itself: a name that must match, must match.
    var a : str = "issue-gate";
    var b : str = "schema-validation";
    var c : str = "own-language";
    assert is_blocking(a, 10) == true;
    assert is_blocking(b, 17) == true;
    assert is_blocking(c, 12) == true;
}

test class_census_64_3_2 {
    assert count_class(G_BLOCKING) == 64;
    assert count_class(G_SOFT) == 3;
    assert count_class(G_REPORTING) == 2;
}

test rows_stay_aligned_name_class_events {
    // The two reporting rows and the first soft row, by index, so a row inserted
    // into one array without the others cannot pass unnoticed. Lengths are
    // hand-counted literals (gen-c carries no .len); the tables are pinned in
    // gates_pins.t27.
    var want1 : str = "auto-merge-ready-prs";
    var want42 : str = "queen-publish";
    var want29 : str = "oracle-nightly";
    var qp : str = "queen-publish";
    var ol : str = "own-language";
    var ev_qp : str = "push,schedule,workflow_dispatch";
    var ev_ol : str = "pull_request";
    // Every string compare carries its lengths through str_eq: `==` on str lowers to a C
    // pointer comparison under gen-c (#8013, #10698).
    assert str_eq(NAMES[1], NAME_LENS[1], want1, 20) == true;
    assert CLASSES[1] == G_REPORTING;
    assert str_eq(NAMES[42], NAME_LENS[42], want42, 13) == true;
    assert CLASSES[42] == G_REPORTING;
    assert str_eq(NAMES[29], NAME_LENS[29], want29, 14) == true;
    assert CLASSES[29] == G_SOFT;
    assert str_eq(events_of(qp, 13), events_len_of(qp, 13), ev_qp, 31) == true;
    assert str_eq(events_of(ol, 12), events_len_of(ol, 12), ev_ol, 12) == true;
}

test unknown_name_is_unknown_and_not_blocking {
    assert class_of("no-such-gate", 12) == G_UNKNOWN;
    assert is_blocking("no-such-gate", 12) == false;
    assert events_len_of("no-such-gate", 12) == 0;
}

test events_len_of_answers_every_row {
    // Every row through the length lookup, so a lookup that returned the wrong row's length, or
    // the sentinel for a known name, fails here and not only on the five rows named above.
    for i in 0..69 {
        assert events_len_of(NAMES[i], NAME_LENS[i]) == EVENT_LENS[i];
    }
}

test nightly_pair_contrast {
    // exhaustive-nightly has no continue-on-error, so it blocks; oracle-nightly does, so it is soft.
    assert class_of("exhaustive-nightly", 18) == G_BLOCKING;
    assert class_of("oracle-nightly", 14) == G_SOFT;
}

test reporting_gates_never_block_a_merge {
    assert is_blocking("auto-merge-ready-prs", 20) == false;
    assert is_blocking("queen-publish", 13) == false;
}

test audit_clean_when_directory_matches_inventory {
    // a synthetic directory: every inventory name, one per line
    var dir : [8192]u8 = undefined;
    var w : usize = 0;
    for i in 0..69 {
        w = put_str(&dir, 8192, w, NAMES[i], NAME_LENS[i]);
        w = put_str(&dir, 8192, w, "\n", 1);
    }
    var out : [8192]u8 = undefined;
    var n : i32 = claw_status(&dir, w, &out, 8192);
    assert n == 0;
    // the report opens with the header and closes with the clean tail
    assert out[0] == 'c';
    assert dir_has(&dir, w, NAMES[0], NAME_LENS[0]) == true;
}

test audit_spec_only_when_a_workflow_file_is_missing {
    // row 0 left out of the directory: its file is gone
    var dir : [8192]u8 = undefined;
    var w : usize = 0;
    for i in 1..69 {
        w = put_str(&dir, 8192, w, NAMES[i], NAME_LENS[i]);
        w = put_str(&dir, 8192, w, "\n", 1);
    }
    var out : [8192]u8 = undefined;
    var n : i32 = claw_status(&dir, w, &out, 8192);
    assert n == 1;
    assert dir_has(&dir, w, NAMES[0], NAME_LENS[0]) == false;
    assert dir_has(&dir, w, NAMES[1], NAME_LENS[1]) == true;
}

test audit_dir_only_for_an_unknown_workflow {
    // the directory lists one workflow the inventory does not know
    var dir : [8192]u8 = undefined;
    var w : usize = 0;
    for i in 0..69 {
        w = put_str(&dir, 8192, w, NAMES[i], NAME_LENS[i]);
        w = put_str(&dir, 8192, w, "\n", 1);
    }
    w = put_str(&dir, 8192, w, "not-a-real-workflow\n", 20);
    var out : [8192]u8 = undefined;
    var n : i32 = claw_status(&dir, w, &out, 8192);
    assert n == 1;
}

test audit_ignores_blank_lines_in_the_directory {
    // ls of a clean directory never emits blanks, but a pipeline that grows
    // one must not turn cleanliness into drift: blank lines are skipped
    var dir : [8192]u8 = undefined;
    var w : usize = 0;
    for i in 0..69 {
        w = put_str(&dir, 8192, w, NAMES[i], NAME_LENS[i]);
        w = put_str(&dir, 8192, w, "\n", 1);
    }
    w = put_str(&dir, 8192, w, "\n\n", 2);
    var out : [8192]u8 = undefined;
    var n : i32 = claw_status(&dir, w, &out, 8192);
    assert n == 0;
}

test audit_prefixes_name_the_problem_kind {
    assert str_eq(LINE_PREFIX[P_SPEC_ONLY], PREFIX_LENS[P_SPEC_ONLY], "SPEC-ONLY  ", 11) == true;
    assert str_eq(LINE_PREFIX[P_DIR_ONLY], PREFIX_LENS[P_DIR_ONLY], "DIR-ONLY   ", 11) == true;
    assert PREFIX_LENS[P_OK] == 0;
    assert str_eq(DRIFT_TAIL, DRIFT_TAIL_LEN, "claw: DRIFT -- regenerate specs/claw/gates.t27 (docs/claw/README.md)", 68) == true;
}
test every_row_round_trips_through_the_name_lookup {
    // Before T8, 8 of 66 names ever went through class_of -- a class swap
    // between two unexercised rows passed every test. This drives all 69
    // rows through the lookup, and the merge verdict with them: blocking
    // iff the class is G_BLOCKING, for every row.
    var i : usize = 0;
    while (i < 69) {
        assert class_of(NAMES[i], NAME_LENS[i]) == CLASSES[i];
        if (CLASSES[i] == G_BLOCKING) {
            assert is_blocking(NAMES[i], NAME_LENS[i]) == true;
        } else {
            assert is_blocking(NAMES[i], NAME_LENS[i]) == false;
        }
        i += 1;
    }
}

test soft_gates_report_their_events {
    // events_of answered for blocking and reporting rows before T8; the
    // three soft rows were assumed. Lengths are hand-counted literals
    // (gen-c carries no .len); the tables are pinned in gates_pins.t27.
    assert str_eq(events_of("oracle-nightly", 14), events_len_of("oracle-nightly", 14), "schedule,workflow_dispatch", 26) == true;
    assert str_eq(events_of("queen-doctor", 12), events_len_of("queen-doctor", 12), "schedule,workflow_dispatch", 26) == true;
    assert str_eq(events_of("rings-rust", 10), events_len_of("rings-rust", 10), "push,pull_request,workflow_dispatch", 35) == true;
}

test coverage_report_carries_every_class {
    // The report is the T8 artifact: every class label present, every
    // census digit printed by the report's own digit path, the lookup-miss
    // line present, and a negative control proving the scan can miss.
    var out : [4096]u8 = undefined;
    var w : usize = claw_coverage_report(&out, 4096);
    assert w > 100;
    // Literal lengths, not the CLASS_LABEL_LENS table: the report prints
    // through the table, so a wrong table entry truncates the label AND the
    // table-driven scan would agree with its own truncation. The .len pin
    // in gates_pins.t27 holds the table; these literals hold the bytes.
    assert buf_has(&out, w, "G_BLOCKING", 10) == true;
    assert buf_has(&out, w, "G_SOFT", 6) == true;
    assert buf_has(&out, w, "G_REPORTING", 11) == true;
    assert buf_has(&out, w, "n=64", 4) == true;
    assert buf_has(&out, w, "n=3", 3) == true;
    assert buf_has(&out, w, "n=2", 3) == true;
    assert buf_has(&out, w, "n=0", 3) == true;
    assert buf_has(&out, w, "n=65", 4) == false;
    assert buf_has(&out, w, "G_UNKNOWN", 9) == true;
}

// The length-table pins live in specs/claw/gates_pins.t27: they read .len on
// strings, which the zig runner executes and the gen-c backend cannot lower,
// so they sit in a companion module that is never gen-c'd. A wrong number in
// NAME_LENS/EVENT_LENS/PREFIX_LENS/SUFFIX_LENS/*_LEN fails there, not silently here.

test audit_tail_line_matches_the_count {
    // The runner prints the report; the tail must say what the count says.
    var dir : [8192]u8 = undefined;
    var w : usize = 0;
    for i in 0..69 {
        w = put_str(&dir, 8192, w, NAMES[i], NAME_LENS[i]);
        w = put_str(&dir, 8192, w, "\n", 1);
    }
    var out : [8192]u8 = undefined;
    for i in 0..8192 { out[i] = 0; }
    assert claw_status(&dir, w, &out, 8192) == 0;
    assert buf_has(&out, 8192, "claw: matrix is current\n", 24) == true;
    assert buf_has(&out, 8192, DRIFT_TAIL, DRIFT_TAIL_LEN) == false;
    // Row 0 left out: one problem, and the tail says drift.
    var gone : [8192]u8 = undefined;
    var g : usize = 0;
    for i in 1..69 {
        g = put_str(&gone, 8192, g, NAMES[i], NAME_LENS[i]);
        g = put_str(&gone, 8192, g, "\n", 1);
    }
    var red : [8192]u8 = undefined;
    for i in 0..8192 { red[i] = 0; }
    assert claw_status(&gone, g, &red, 8192) == 1;
    assert buf_has(&red, 8192, DRIFT_TAIL, DRIFT_TAIL_LEN) == true;
    assert buf_has(&red, 8192, OK_TAIL, OK_TAIL_LEN) == false;
}

test coverage_report_lines_are_exact {
    // Whole lines, newline included: the verdict word, the census, and the first three rows of
    // each class in table order. A fourth example, a row of another class or a flipped verdict
    // breaks the line.
    var out : [4096]u8 = undefined;
    var w : usize = claw_coverage_report(&out, 4096);
    assert buf_has(&out, w, "G_BLOCKING n=64 blocking=true e.g. agent-runner-docker, bootstrap-tests, build-paper\n", 85) == true;
    assert buf_has(&out, w, "G_SOFT n=3 blocking=false e.g. oracle-nightly, queen-doctor, rings-rust\n", 72) == true;
    assert buf_has(&out, w, "G_REPORTING n=2 blocking=false e.g. auto-merge-ready-prs, queen-publish\n", 72) == true;
}

test a_hole_in_either_column_fails_the_filled_check {
    assert rows_filled(NAME_LENS, EVENT_LENS) == true;
    var n : [69]usize = undefined;
    for i in 0..69 { n[i] = NAME_LENS[i]; }
    n[68] = 0;
    assert rows_filled(n, EVENT_LENS) == false;
    var e : [69]usize = undefined;
    for i in 0..69 { e[i] = EVENT_LENS[i]; }
    e[0] = 0;
    assert rows_filled(NAME_LENS, e) == false;
    // One byte is enough: the check asks "empty or not", never "how long".
    e[0] = 1;
    assert rows_filled(NAME_LENS, e) == true;
}

test a_repeated_name_is_caught_wherever_it_sits {
    var n : [69]str = undefined;
    for i in 0..69 { n[i] = NAMES[i]; }
    var l : [69]usize = undefined;
    for i in 0..69 { l[i] = NAME_LENS[i]; }
    n[5] = n[4];
    l[5] = l[4];
    assert names_unique_in(n, l) == false;
    var m : [69]str = undefined;
    for i in 0..69 { m[i] = NAMES[i]; }
    var k : [69]usize = undefined;
    for i in 0..69 { k[i] = NAME_LENS[i]; }
    m[68] = m[0];
    k[68] = k[0];
    assert names_unique_in(m, k) == false;
}

test a_class_outside_the_three_is_unknown {
    assert classes_known(CLASSES) == true;
    var c : [69]u8 = undefined;
    for i in 0..69 { c[i] = CLASSES[i]; }
    c[68] = G_UNKNOWN;
    assert classes_known(c) == false;
    // Each of the three real classes passes on its own, so no one of the three checks is spare.
    c[68] = G_BLOCKING;
    assert classes_known(c) == true;
    c[68] = G_SOFT;
    assert classes_known(c) == true;
    c[68] = G_REPORTING;
    assert classes_known(c) == true;
}
