// SPDX-License-Identifier: Apache-2.0
; specs/claw/mut_known.t27 -- which mutation survivors are known equivalent mutants, and which are
; new, keyed by the mutated line's text rather than its line number.
; --
; On 2026-10-19 the claw lane's red_origin sweep reported its two surviving mutants at lines 76 and
; 97; a header paragraph was added, and the next run reported the same two mutants at lines 79 and
; 100. Both were argued equivalent in issue #10821, by line number. lab_disk's equivalent survivor
; was argued in #10813, at line 93, with the same text as one of red_origin's. Every later sweep was
; then read by eye against issue text: is this survivor the one we already argued, or a new one?
; Five real survivors (tick 37: reel_still, visual_output, t27f_gate_pins) stood in exactly that
; place before tests killed them. A list keyed by line numbers goes stale on the first edit above the
; line, and a reader who trusts a stale list waves a new survivor through. This module is the list,
; and the reading of a sweep against it.
; --
; A sweep line is what the lab sweep prints for one mutant:
;     <spec> SP <line> SP [<from>-><to>] SP <result> [SP :: SP <source text>]
; <result> is the word just before the first " :: ", or the last word when there is none:
;     CAUGHT    a test failed on the mutant                       caught
;     TIMEOUT   the tests ran past the time limit                 caught, as Stryker and PIT count it
;     BLOCKED   the mutant did not compile or no test ran         not viable, left out of the score
;     SURVIVED  every test passed on the mutant                   known or new, by the list
;     NOAPPLY   the edit did not change the line                  the harness failed; nothing ran
;     any other word, or no <spec> SP <digits> SP head            unreadable
; A known entry is a sweep line with its SP <line> field removed:
;     red_origin [ < -> <= ] SURVIVED :: while (i < list_len) {
; It matches a sweep line as a whole line, byte for byte, so a mutant stays known when lines above it
; move, and becomes new when its own line's text, its operator or its spec changes. The result word is
; part of the key, so a known entry never matches a CAUGHT line. A known entry no sweep line matches
; is gone: the line changed or a test now kills the mutant, and the entry should be pruned.
; sweep_reason(counts), first match wins:
;   no mutant line at all                -> hold R_SILENT
;   an unreadable line                   -> hold R_UNREADABLE
;   a NOAPPLY line                       -> hold R_HARNESS
;   a survivor not on the list           -> hold R_NEW
;   a known entry is gone                -> pass R_PRUNE
;   otherwise                            -> pass R_PASS
; sweep_line writes, from the counts,   E TAB <pass|hold> TAB <why>\n   and new_lines writes one
;   E TAB <new|harness|unreadable> TAB <sweep line>\n   per line that holds the sweep.
; KNOWN_CLAW holds the claw lane's argued equivalents (#10813, #10821), and this module's own five keys
; (seven survivors: one loop-bound key covers three loops). The eleven ledger_union and four
; social_visuals equivalents of #10787 and #10773 join it when those specs are next swept, because only
; a sweep prints their exact operator text.
; The honest limits: two mutants with the same spec, operator and line text share one key, so one
; entry covers both; a known entry is the reviewer's argument, and this module trusts it. It reads the
; text a sweep printed; it runs no sweep.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawMutKnown;

use claw::text;

/// The class of one sweep line; index N_GONE of the counts holds the gone known entries.
pub const C_CAUGHT : u8 = 0;
pub const C_TIMEOUT : u8 = 1;
pub const C_BLOCKED : u8 = 2;
pub const C_KNOWN : u8 = 3;
pub const C_NEW : u8 = 4;
pub const C_NOAPPLY : u8 = 5;
pub const C_BAD : u8 = 6;
pub const N_GONE : usize = 7;
pub const N_COUNTS : usize = 8;

/// Verdicts.
pub const V_PASS : u8 = 0;
pub const V_HOLD : u8 = 1;

/// Reasons.
pub const R_SILENT : u8 = 0;
pub const R_UNREADABLE : u8 = 1;
pub const R_HARNESS : u8 = 2;
pub const R_NEW : u8 = 3;
pub const R_PRUNE : u8 = 4;
pub const R_PASS : u8 = 5;
pub const R_COUNT : usize = 6;

pub const VERDICT_TEXTS : [2]str = ["E\tpass\t", "E\thold\t"];
pub const VERDICT_LENS : [2]usize = [7, 7];

pub const WHY_TEXTS : [6]str = [
    "the sweep printed no mutant line: run it again before you read a score\n",
    "a sweep line is not <spec> <line> [<from>-><to>] <result>: fix the sweep before you trust its score\n",
    "a mutant edit left its line unchanged, so that mutant was never tested: fix the generator\n",
    "a survivor is not on the known list: kill it with a test, or argue it equivalent in the issue and list it\n",
    "every survivor is known, and some known entries no longer survive: prune them from the list\n",
    "every survivor is a known equivalent mutant\n"
];
pub const WHY_LENS : [6]usize = [71, 100, 90, 106, 92, 44];

/// The claw lane's argued equivalent mutants: lab_disk (#10813) and red_origin (#10821).
pub const KNOWN_CLAW : str = "red_origin [ < -> <= ] SURVIVED :: while (i < list_len) {\nred_origin [ < -> <= ] SURVIVED :: while (s < b_len) {\nlab_disk [ < -> <= ] SURVIVED :: while (s < b_len) {\nmut_known [ < -> <= ] SURVIVED :: if (i < n1) { x = b[s + i]; } else { x = b[c + i - n1]; }\nmut_known [ < -> <= ] SURVIVED :: while (i < known_len) {\nmut_known [ > -> >= ] SURVIVED :: while (q > from and b[q - 1] != ' ') { q -= 1; }\nmut_known [ < -> <= ] SURVIVED :: while (s < b_len) {\nmut_known [ < -> <= ] SURVIVED :: while (ks < known_len) {\n";
pub const KNOWN_CLAW_LEN : usize = 512;

/// Where the line number of sweep line b[s..e) is: f[0] is the space before it, f[1] the space
/// after. False when the line has no non-empty spec name, no digits, or no space after them.
pub fn num_span(b : str, s : usize, e : usize, f : []usize) -> bool {
    var i : usize = s;
    while (i < e and b[i] != ' ') { i += 1; }
    if (i == s or i == e) { return false; }
    const d : usize = i + 1;
    var j : usize = d;
    while (j < e and b[j] >= '0' and b[j] <= '9') { j += 1; }
    if (j == d or j == e or b[j] != ' ') { return false; }
    f[0] = i;
    f[1] = j;
    return true;
}

/// Whether known line k[ks..ke) is b[s..a) followed by b[c..e): the sweep line without its number.
pub fn key_eq(k : str, ks : usize, ke : usize, b : str, s : usize, a : usize, c : usize, e : usize) -> bool {
    const n1 : usize = a - s;
    if (ke - ks != n1 + (e - c)) { return false; }
    var i : usize = 0;
    while (i < ke - ks) {
        var x : u8 = 0;
        if (i < n1) { x = b[s + i]; } else { x = b[c + i - n1]; }
        if (k[ks + i] != x) { return false; }
        i += 1;
    }
    return true;
}

/// Whether some line of known[0..known_len) is the sweep line b[s..e) without its number field
/// b[a..c). An empty known line matches nothing, because a key always starts with a spec name.
pub fn key_in(known : str, known_len : usize, b : str, s : usize, a : usize, c : usize, e : usize) -> bool {
    var i : usize = 0;
    while (i < known_len) {
        var j : usize = i;
        while (j < known_len and known[j] != '\n') { j += 1; }
        if (key_eq(known, i, j, b, s, a, c, e)) { return true; }
        i = j + 1;
    }
    return false;
}

/// Whether b[s..e) is the n bytes of lit.
pub fn span_is(b : str, s : usize, e : usize, lit : str, n : usize) -> bool {
    if (e - s != n) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (b[s + i] != lit[i]) { return false; }
        i += 1;
    }
    return true;
}

/// The class the result word of b[from..e) names: the word before the first " :: ", or the last
/// word. SURVIVED comes back as C_NEW; the caller looks it up on the list.
pub fn result_class(b : str, from : usize, e : usize) -> u8 {
    var p : usize = from;
    var end : usize = e;
    while (p + 4 <= e and end == e) {
        if (b[p] == ' ' and b[p + 1] == ':' and b[p + 2] == ':' and b[p + 3] == ' ') { end = p; }
        p += 1;
    }
    var q : usize = end;
    while (q > from and b[q - 1] != ' ') { q -= 1; }
    if (span_is(b, q, end, "CAUGHT", 6)) { return C_CAUGHT; }
    if (span_is(b, q, end, "TIMEOUT", 7)) { return C_TIMEOUT; }
    if (span_is(b, q, end, "BLOCKED", 7)) { return C_BLOCKED; }
    if (span_is(b, q, end, "SURVIVED", 8)) { return C_NEW; }
    if (span_is(b, q, end, "NOAPPLY", 7)) { return C_NOAPPLY; }
    return C_BAD;
}

/// The class of sweep line b[s..e) against the known list.
pub fn line_class(b : str, s : usize, e : usize, known : str, known_len : usize) -> u8 {
    var f : [2]usize = undefined;
    if (num_span(b, s, e, &f) == false) { return C_BAD; }
    const c : u8 = result_class(b, f[1], e);
    if (c == C_NEW and key_in(known, known_len, b, s, f[0], f[1], e)) { return C_KNOWN; }
    return c;
}

/// Whether some sweep line of b[0..b_len) is known line k[ks..ke) once its number is removed.
pub fn seen(k : str, ks : usize, ke : usize, b : str, b_len : usize) -> bool {
    var s : usize = 0;
    while (s < b_len) {
        var e : usize = s;
        while (e < b_len and b[e] != '\n') { e += 1; }
        var f : [2]usize = undefined;
        if (num_span(b, s, e, &f) and key_eq(k, ks, ke, b, s, f[0], f[1], e)) { return true; }
        s = e + 1;
    }
    return false;
}

/// Counts of every class over the sweep's non-empty lines, and in counts[N_GONE] the non-empty
/// known lines no sweep line matches. Returns the number of non-empty sweep lines.
pub fn sweep_counts(b : str, b_len : usize, known : str, known_len : usize, counts : []u32) -> u32 {
    var i : usize = 0;
    var lines : u32 = 0;
    while (i < N_COUNTS) {
        counts[i] = 0;
        i += 1;
    }
    var s : usize = 0;
    while (s < b_len) {
        var e : usize = s;
        while (e < b_len and b[e] != '\n') { e += 1; }
        if (e > s) {
            counts[line_class(b, s, e, known, known_len) as usize] += 1;
            lines += 1;
        }
        s = e + 1;
    }
    var ks : usize = 0;
    while (ks < known_len) {
        var ke : usize = ks;
        while (ke < known_len and known[ke] != '\n') { ke += 1; }
        if (ke > ks and seen(known, ks, ke, b, b_len) == false) { counts[N_GONE] += 1; }
        ks = ke + 1;
    }
    return lines;
}

/// The reason for a sweep, from its counts.
pub fn sweep_reason(counts : []u32) -> u8 {
    var lines : u32 = 0;
    var i : usize = 0;
    while (i < N_GONE) {
        lines += counts[i];
        i += 1;
    }
    if (lines == 0) { return R_SILENT; }
    if (counts[C_BAD as usize] > 0) { return R_UNREADABLE; }
    if (counts[C_NOAPPLY as usize] > 0) { return R_HARNESS; }
    if (counts[C_NEW as usize] > 0) { return R_NEW; }
    if (counts[N_GONE] > 0) { return R_PRUNE; }
    return R_PASS;
}

/// R_PRUNE and R_PASS pass; every other reason, and any value out of range, holds.
pub fn verdict_of(r : u8) -> u8 {
    if (r == R_PRUNE or r == R_PASS) { return V_PASS; }
    return V_HOLD;
}

/// The verdict line for a sweep's counts into out at w, clipped at cap; returns the new cursor, which
/// still advances when clipped. It takes the counts, not a reason, so the line cannot name a reason
/// the sweep did not give.
pub fn sweep_line(counts : []u32, out : []u8, cap : usize, w : usize) -> usize {
    const k : u8 = sweep_reason(counts);
    const v : usize = verdict_of(k) as usize;
    const x : usize = put_str(out, cap, w, VERDICT_TEXTS[v], VERDICT_LENS[v]);
    return put_str(out, cap, x, WHY_TEXTS[k as usize], WHY_LENS[k as usize]);
}

/// One E line per sweep line that holds the sweep (new, harness, unreadable), into out at w,
/// clipped at cap; returns the new cursor.
pub fn new_lines(b : str, b_len : usize, known : str, known_len : usize, out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = w;
    var s : usize = 0;
    while (s < b_len) {
        var e : usize = s;
        while (e < b_len and b[e] != '\n') { e += 1; }
        if (e > s) {
            const c : u8 = line_class(b, s, e, known, known_len);
            var put : bool = true;
            if (c == C_NEW) {
                x = put_str(out, cap, x, "E\tnew\t", 6);
            } else if (c == C_NOAPPLY) {
                x = put_str(out, cap, x, "E\tharness\t", 10);
            } else if (c == C_BAD) {
                x = put_str(out, cap, x, "E\tunreadable\t", 13);
            } else {
                put = false;
            }
            if (put) {
                var i : usize = s;
                while (i < e) {
                    if (x < cap) { out[x] = b[i]; }
                    x += 1;
                    i += 1;
                }
                if (x < cap) { out[x] = '\n'; }
                x += 1;
            }
        }
        s = e + 1;
    }
    return x;
}

// ---- tests: the claw lane's real sweeps ----

/// The red_origin sweep of tick 41, after the header grew: one caught, two equivalent survivors.
pub const SWEEP41 : str = "red_origin 76 [<=-><] CAUGHT :: if (e <= s) { return false; }\nred_origin 79 [ < -> <= ] SURVIVED :: while (i < list_len) {\nred_origin 100 [ < -> <= ] SURVIVED :: while (s < b_len) {\n";
pub const SWEEP41_LEN : usize = 182;

/// The same two survivors in the run before the header grew, three lines higher.
pub const SWEEP41_EARLY : str = "red_origin 76 [ < -> <= ] SURVIVED :: while (i < list_len) {\nred_origin 97 [ < -> <= ] SURVIVED :: while (s < b_len) {\n";
pub const SWEEP41_EARLY_LEN : usize = 119;

/// The five real survivors of tick 37, each later killed by a test.
pub const SWEEP37 : str = "reel_still 101 [+ 1->+ 2] SURVIVED :: k = k + 1;\nreel_still 110 [ < -> <= ] SURVIVED :: while (t < (TOPICS as u32)) {\nt27f_gate_pins 21 [return false->return true] SURVIVED :: if (b[a.len] != '$') { return false; }\nt27f_gate_pins 22 [in 0..->in 1..] SURVIVED :: for i in 0..a.len {\nvisual_output 76 [ < -> <= ] SURVIVED :: return ms > REEL_HOOK_MS and ms < REEL_MIN_MS - REEL_CTA_MIN_MS;\n";
pub const SWEEP37_LEN : usize = 388;

/// lab_disk's equivalent survivor (#10813): the same text as one of red_origin's.
pub const DISK93 : str = "lab_disk 93 [ < -> <= ] SURVIVED :: while (s < b_len) {\n";
pub const DISK93_LEN : usize = 56;

/// This module's own sweep (tick 42): its seven survivors under five keys.
pub const SWEEP42 : str = "mut_known 114 [ < -> <= ] SURVIVED :: if (i < n1) { x = b[s + i]; } else { x = b[c + i - n1]; }\nmut_known 125 [ < -> <= ] SURVIVED :: while (i < known_len) {\nmut_known 155 [ > -> >= ] SURVIVED :: while (q > from and b[q - 1] != ' ') { q -= 1; }\nmut_known 176 [ < -> <= ] SURVIVED :: while (s < b_len) {\nmut_known 196 [ < -> <= ] SURVIVED :: while (s < b_len) {\nmut_known 206 [ < -> <= ] SURVIVED :: while (ks < known_len) {\nmut_known 252 [ < -> <= ] SURVIVED :: while (s < b_len) {\n";
pub const SWEEP42_LEN : usize = 482;

test this_modules_own_sweep_passes_on_its_own_list {
    var c : [8]u32 = undefined;
    assert sweep_counts(SWEEP42, SWEEP42_LEN, KNOWN_CLAW, KNOWN_CLAW_LEN, &c) == 7;
    assert c[C_KNOWN as usize] == 7;
    assert c[C_NEW as usize] == 0;
    assert c[C_BAD as usize] == 0;
    // red_origin's two and lab_disk's one are not in this sweep.
    assert c[N_GONE] == 3;
    assert sweep_reason(&c) == R_PRUNE;
    assert verdict_of(R_PRUNE) == V_PASS;
    assert SWEEP42[SWEEP42_LEN - 1] == '\n';
}

test the_tick_41_sweep_passes_on_the_known_list {
    var c : [8]u32 = undefined;
    assert sweep_counts(SWEEP41, SWEEP41_LEN, KNOWN_CLAW, KNOWN_CLAW_LEN, &c) == 3;
    assert c[C_CAUGHT as usize] == 1;
    assert c[C_KNOWN as usize] == 2;
    assert c[C_NEW as usize] == 0;
    assert c[N_GONE] == 6;
    assert sweep_reason(&c) == R_PRUNE;
    assert verdict_of(R_PRUNE) == V_PASS;
}

test moved_line_numbers_keep_a_survivor_known {
    var c : [8]u32 = undefined;
    assert sweep_counts(SWEEP41_EARLY, SWEEP41_EARLY_LEN, KNOWN_CLAW, KNOWN_CLAW_LEN, &c) == 2;
    assert c[C_KNOWN as usize] == 2;
    assert c[C_NEW as usize] == 0;
    assert line_class(SWEEP41_EARLY, 0, 60, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_KNOWN;
    assert line_class(SWEEP41, 62, 122, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_KNOWN;
}

test the_tick_37_survivors_are_new_and_hold_the_sweep {
    var c : [8]u32 = undefined;
    assert sweep_counts(SWEEP37, SWEEP37_LEN, KNOWN_CLAW, KNOWN_CLAW_LEN, &c) == 5;
    assert c[C_NEW as usize] == 5;
    assert c[C_KNOWN as usize] == 0;
    assert c[C_BAD as usize] == 0;
    assert c[N_GONE] == 8;
    assert sweep_reason(&c) == R_NEW;
    assert verdict_of(R_NEW) == V_HOLD;
}

test a_full_known_list_passes_clean {
    var c : [8]u32 = undefined;
    assert sweep_counts(DISK93, DISK93_LEN, "lab_disk [ < -> <= ] SURVIVED :: while (s < b_len) {", 52, &c) == 1;
    assert c[C_KNOWN as usize] == 1;
    assert c[N_GONE] == 0;
    assert sweep_reason(&c) == R_PASS;
}

test negative_control_the_same_text_in_another_spec_is_new {
    // red_origin's entry has lab_disk's text; the spec name is part of the key.
    const known : str = "red_origin [ < -> <= ] SURVIVED :: while (s < b_len) {\n";
    assert line_class(DISK93, 0, 55, known, 55) == C_NEW;
    assert line_class(DISK93, 0, 55, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_KNOWN;
}

test negative_control_a_changed_operator_or_text_is_new {
    assert line_class("lab_disk 93 [ < -> > ] SURVIVED :: while (s < b_len) {", 0, 54, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_NEW;
    assert line_class("lab_disk 93 [ < -> <= ] SURVIVED :: while (s < n) {", 0, 51, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_NEW;
    assert line_class("lab_disk 93 [ < -> <= ] SURVIVED :: while (s < b_len) { ", 0, 56, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_NEW;
    assert line_class("lab_disk 93 [ < -> <= ] SURVIVED :: while (s < b_len) ", 0, 54, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_NEW;
}

test negative_control_a_known_entry_never_matches_a_caught_line {
    const line : str = "lab_disk 93 [ < -> <= ] CAUGHT :: while (s < b_len) {";
    assert line_class(line, 0, 53, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_CAUGHT;
    var c : [8]u32 = undefined;
    assert sweep_counts(line, 53, "lab_disk [ < -> <= ] SURVIVED :: while (s < b_len) {", 52, &c) == 1;
    assert c[C_CAUGHT as usize] == 1;
    assert c[N_GONE] == 1;
}

test every_result_word_has_its_class {
    assert line_class("x 1 [a->b] CAUGHT :: t", 0, 22, "", 0) == C_CAUGHT;
    assert line_class("x 1 [a->b] TIMEOUT :: t", 0, 23, "", 0) == C_TIMEOUT;
    assert line_class("x 1 [a->b] BLOCKED :: t", 0, 23, "", 0) == C_BLOCKED;
    assert line_class("x 1 [a->b] SURVIVED :: t", 0, 24, "", 0) == C_NEW;
    assert line_class("x 1 [a->b] NOAPPLY", 0, 18, "", 0) == C_NOAPPLY;
    assert line_class("x 1 [a->b] KILLED :: t", 0, 22, "", 0) == C_BAD;
    assert line_class("x 1 [a->b] caught :: t", 0, 22, "", 0) == C_BAD;
    assert line_class("x 1 [a->b] CAUGHTX :: t", 0, 23, "", 0) == C_BAD;
}

test the_result_word_is_the_one_before_the_first_separator {
    // The source text may hold " :: " and result words of its own.
    assert line_class("x 1 [a->b] CAUGHT :: a :: SURVIVED :: b", 0, 39, "", 0) == C_CAUGHT;
    assert line_class("x 1 [a->b] SURVIVED :: CAUGHT", 0, 29, "", 0) == C_NEW;
    // With no separator the last word is read.
    assert line_class("x 1 [a->b] CAUGHT", 0, 17, "", 0) == C_CAUGHT;
    assert line_class("x 1 [a->b] CAUGHT ::", 0, 20, "", 0) == C_BAD;
}

test lines_without_the_head_are_unreadable {
    assert line_class("red_origin x [a->b] SURVIVED :: t", 0, 33, KNOWN_CLAW, KNOWN_CLAW_LEN) == C_BAD;
    assert line_class(" 12 [a->b] SURVIVED :: t", 0, 24, "", 0) == C_BAD;
    assert line_class("red_origin 12[a->b] SURVIVED :: t", 0, 33, "", 0) == C_BAD;
    assert line_class("red_origin", 0, 10, "", 0) == C_BAD;
    assert line_class("red_origin 12", 0, 13, "", 0) == C_BAD;
    assert line_class("red_origin 12 ", 0, 14, "", 0) == C_BAD;
    assert line_class("red_origin  12 [a->b] SURVIVED :: t", 0, 35, "", 0) == C_BAD;
    var f : [2]usize = undefined;
    assert num_span("ab 123 c", 0, 8, &f) == true;
    assert f[0] == 2;
    assert f[1] == 6;
}

test the_hold_reasons_come_in_order {
    var c : [8]u32 = undefined;
    assert sweep_counts("x 1 [a->b] SURVIVED :: t\nx 2 [a->b] NOAPPLY\nx 3 bad\n", 52, "", 0, &c) == 3;
    assert c[C_NEW as usize] == 1;
    assert c[C_NOAPPLY as usize] == 1;
    assert c[C_BAD as usize] == 1;
    assert sweep_reason(&c) == R_UNREADABLE;
    assert sweep_counts("x 1 [a->b] SURVIVED :: t\nx 2 [a->b] NOAPPLY\n", 44, "", 0, &c) == 2;
    assert sweep_reason(&c) == R_HARNESS;
    assert sweep_counts("x 1 [a->b] SURVIVED :: t\n", 25, "y [a->b] SURVIVED :: t", 22, &c) == 1;
    assert sweep_reason(&c) == R_NEW;
    assert sweep_counts("x 1 [a->b] TIMEOUT :: t\nx 2 [a->b] BLOCKED :: t\n", 48, "", 0, &c) == 2;
    assert c[C_TIMEOUT as usize] == 1;
    assert c[C_BLOCKED as usize] == 1;
    assert sweep_reason(&c) == R_PASS;
}

test an_empty_sweep_holds_as_silent {
    var c : [8]u32 = undefined;
    assert sweep_counts("", 0, KNOWN_CLAW, KNOWN_CLAW_LEN, &c) == 0;
    assert c[N_GONE] == 8;
    assert sweep_reason(&c) == R_SILENT;
    assert sweep_counts("\n\n\n", 3, "", 0, &c) == 0;
    assert sweep_reason(&c) == R_SILENT;
    assert verdict_of(R_SILENT) == V_HOLD;
}

test empty_known_lines_are_never_gone_and_match_nothing {
    var c : [8]u32 = undefined;
    assert sweep_counts(DISK93, DISK93_LEN, "\n\n", 2, &c) == 1;
    assert c[C_NEW as usize] == 1;
    assert c[N_GONE] == 0;
    assert key_in("\n", 1, DISK93, 0, 8, 11, 55) == false;
}

test only_prune_and_pass_pass {
    var passes : u32 = 0;
    var r : u32 = 0;
    while (r < 256) {
        if (verdict_of(r as u8) == V_PASS) { passes += 1; assert r == 4 or r == 5; }
        r += 1;
    }
    assert passes == 2;
}

test the_lens_are_the_text_lengths {
    var i : usize = 0;
    while (i < 2) {
        assert VERDICT_TEXTS[i][0] == 'E';
        assert VERDICT_TEXTS[i][VERDICT_LENS[i] - 1] == '\t';
        assert VERDICT_TEXTS[i][VERDICT_LENS[i] - 2] != '\t';
        i += 1;
    }
    var k : usize = 0;
    while (k < R_COUNT) {
        assert WHY_TEXTS[k][WHY_LENS[k] - 1] == '\n';
        assert WHY_TEXTS[k][WHY_LENS[k] - 2] != '\n';
        k += 1;
    }
    assert KNOWN_CLAW[KNOWN_CLAW_LEN - 1] == '\n';
    assert SWEEP37[SWEEP37_LEN - 1] == '\n';
    assert SWEEP41[SWEEP41_LEN - 2] == '{';
}

test each_sweep_line_is_spelled_out {
    var out : [128]u8 = undefined;
    var c : [8]u32 = undefined;
    assert sweep_counts("x 1 [a->b] CAUGHT :: t\n", 23, "", 0, &c) == 1;
    assert sweep_line(&c, &out, 128, 0) == 51;
    assert str_eq(&out, 7, "E\tpass\t", 7);
    assert out[7] == 'e';
    assert sweep_counts("x 1 [a->b] CAUGHT :: t\n", 23, "y [a->b] SURVIVED :: t", 22, &c) == 1;
    assert sweep_line(&c, &out, 128, 0) == 99;
    assert out[7] == 'e';
    assert out[98] == '\n';
    assert sweep_counts("x 1 [a->b] SURVIVED :: t\n", 25, "", 0, &c) == 1;
    assert sweep_line(&c, &out, 128, 0) == 113;
    assert str_eq(&out, 7, "E\thold\t", 7);
    assert out[9] == 's';
    assert sweep_counts("x 2 [a->b] NOAPPLY\n", 19, "", 0, &c) == 1;
    assert sweep_line(&c, &out, 128, 0) == 97;
    assert out[9] == 'm';
    assert sweep_counts("", 0, "", 0, &c) == 0;
    assert sweep_line(&c, &out, 128, 0) == 78;
    assert out[7] == 't';
    assert sweep_counts("x y\n", 4, "", 0, &c) == 1;
    assert sweep_line(&c, &out, 128, 0) == 107;
    assert out[9] == 's';
    assert out[106] == '\n';
}

test the_lines_that_hold_a_sweep_are_listed {
    var out : [128]u8 = undefined;
    const sweep : str = "x 1 [a->b] CAUGHT :: t\nx 2 [a->b] SURVIVED :: u\nx 3 [a->b] NOAPPLY\nx y\n";
    assert new_lines(sweep, 71, "x [a->b] SURVIVED :: u", 22, &out, 128, 0) == 46;
    assert str_eq(&out, 10, "E\tharness\t", 10);
    assert out[10] == 'x';
    assert out[12] == '3';
    assert out[28] == '\n';
    assert out[29] == 'E';
    assert out[31] == 'u';
    assert out[42] == 'x';
    assert out[45] == '\n';
    assert new_lines(sweep, 71, "", 0, &out, 128, 0) == 77;
    assert str_eq(&out, 6, "E\tnew\t", 6);
    assert out[6] == 'x';
    assert out[8] == '2';
    assert out[30] == '\n';
    assert out[31] == 'E';
    assert new_lines(sweep, 71, "", 0, &out, 4, 3) == 80;
    assert out[3] == 'E';
    assert new_lines(sweep, 71, "", 0, &out, 128, 5) == 82;
}

test a_line_at_the_end_of_a_full_buffer_is_not_read_past {
    var one : [24]u8 = undefined;
    const src : str = "x 1 [a->b] SURVIVED :: t";
    var i : usize = 0;
    while (i < 24) {
        one[i] = src[i];
        i += 1;
    }
    assert line_class(&one, 0, 24, "", 0) == C_NEW;
    assert line_class(&one, 0, 24, "x [a->b] SURVIVED :: t", 22) == C_KNOWN;
    var c : [8]u32 = undefined;
    assert sweep_counts(&one, 24, "x [a->b] SURVIVED :: t", 22, &c) == 1;
    assert c[C_KNOWN as usize] == 1;
    assert seen("x [a->b] SURVIVED :: t", 0, 22, &one, 24) == true;
    var two : [4]u8 = undefined;
    two[0] = 'x';
    two[1] = ' ';
    two[2] = '1';
    two[3] = ' ';
    assert line_class(&two, 0, 4, "", 0) == C_BAD;
    var f : [2]usize = undefined;
    assert num_span(&two, 0, 3, &f) == false;
}

test num_span_needs_a_name_digits_and_a_space_after_them {
    var f : [2]usize = undefined;
    assert num_span("red_origin", 0, 10, &f) == false;
    assert num_span(" 12 x", 0, 5, &f) == false;
    assert num_span("x 12", 0, 4, &f) == false;
    assert num_span("x ", 0, 2, &f) == false;
    assert num_span("x 1x ", 0, 5, &f) == false;
    assert num_span("x  1 ", 0, 5, &f) == false;
    assert num_span("x 1 ", 0, 4, &f) == true;
    assert f[0] == 1;
    assert f[1] == 3;
    assert num_span("ab x 1 ", 3, 7, &f) == true;
    assert f[0] == 4;
    assert f[1] == 6;
}

test the_separator_is_exactly_space_colon_colon_space {
    // A sweep of a blank source line ends in " :: " with no text after it.
    assert line_class("x 1 [a->b] SURVIVED :: ", 0, 23, "", 0) == C_NEW;
    assert line_class("x 1 [a->b] CAUGHT :: ", 0, 21, "", 0) == C_CAUGHT;
    // " a: " and " :a " are not separators, so the last word is read.
    assert line_class("x 1 [a->b] SURVIVED a: CAUGHT", 0, 29, "", 0) == C_CAUGHT;
    assert line_class("x 1 [a->b] SURVIVED :a CAUGHT", 0, 29, "", 0) == C_CAUGHT;
    assert line_class("x 1 [a->b] SURVIVED ::: CAUGHT", 0, 30, "", 0) == C_CAUGHT;
}

test empty_sweep_lines_list_nothing {
    var out : [8]u8 = undefined;
    assert new_lines("\n\n", 2, "", 0, &out, 8, 0) == 0;
    assert new_lines("", 0, "", 0, &out, 8, 3) == 3;
}

test new_lines_never_write_past_a_full_out_buffer {
    // The line's first byte lands exactly at cap.
    var six : [6]u8 = undefined;
    assert new_lines("x 2 [a->b] SURVIVED :: u", 24, "", 0, &six, 6, 0) == 31;
    assert six[0] == 'E';
    assert six[5] == '\t';
    // The closing newline lands exactly at cap.
    var thirty : [30]u8 = undefined;
    assert new_lines("x 2 [a->b] SURVIVED :: u", 24, "", 0, &thirty, 30, 0) == 31;
    assert thirty[6] == 'x';
    assert thirty[29] == 'u';
}

test new_lines_read_a_last_line_without_a_newline_to_the_end {
    var src : [18]u8 = undefined;
    const t : str = "x 3 [a->b] NOAPPLY";
    var i : usize = 0;
    while (i < 18) {
        src[i] = t[i];
        i += 1;
    }
    var out : [32]u8 = undefined;
    assert new_lines(&src, 18, "", 0, &out, 32, 0) == 29;
    assert out[27] == 'Y';
    assert out[28] == '\n';
}
