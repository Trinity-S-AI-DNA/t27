    "no .t27 value; a token holding it can plant a secret in any repository",
    "workflow files are owner gate files under the own-language gate; a bot never writes them",
    "settings, collaborators, deletion; only the ruleset row uses administration",
    "no .t27 value",
    "no .t27 value; widens what a leaked token can create or redirect",
    "the merger job merges a green PR; a merge by the App starts the downstream workflows, a github.token merge starts none",
    "a behind PR is brought up to date with its base and its CI reruns",
    "failed jobs of a run are rerun without rerunning the green ones",
    "the control job answers an @tri-claw comment and refreshes the queue dashboard",
    "a repository_dispatch tells the Queen that the queue has work",
];

/// The measured grant (GET /apps/tri-claw, 2026-10-18T06:59:05Z), for the permissions this
/// table names. Re-measure and edit here when the owner changes the App.
pub const GRANT_PERMS : [16]str = [
    "checks", "security_events", "pull_requests", "contents", "deployments",
    "issues", "administration", "attestations", "statuses", "merge_queues",
    "repository_custom_properties", "secrets", "workflows", "codespaces", "repository_hooks",
    "actions",
];

pub const GRANT_LEVELS : [16]u8 = [
    L_WRITE, L_WRITE, L_WRITE, L_WRITE, L_WRITE,
    L_WRITE, L_WRITE, L_WRITE, L_WRITE, L_WRITE,
    L_WRITE, L_WRITE, L_WRITE, L_WRITE, L_WRITE,
    L_WRITE,
];

/// Row index of a surface; -1 when unknown. Fail closed: callers check before use.
pub fn row_of(surface : str) -> i32 {
    for i in 0..27 {
        if recipes::str_eq(SURFACES[i], surface) { return (i) as i32; }
    }
    return -1;
}

/// Whether row i may ever reach a token. owner_yes is the owner's explicit yes for this run.
pub fn row_mintable(i : usize, owner_yes : bool) -> bool {
    const s = STATUS[i];
    if (s == S_LIVE or s == S_PLANNED) { return true; }
    if (s == S_OWNER and owner_yes) { return true; }
    return false;
}

/// The permission a job serving `surface` mints; "" when unknown or not mintable.
pub fn perm_of(surface : str, owner_yes : bool) -> str {
    const r = row_of(surface);
    if (r < 0) { return ""; }
    if (row_mintable((r) as usize, owner_yes) == false) { return ""; }
    return PERMS[(r) as usize];
}

/// The level a job serving `surface` mints; L_NONE when unknown or not mintable.
pub fn level_of(surface : str, owner_yes : bool) -> u8 {
    const r = row_of(surface);
    if (r < 0) { return L_NONE; }
    if (row_mintable((r) as usize, owner_yes) == false) { return L_NONE; }
    return LEVELS[(r) as usize];
}

/// The highest level any mintable row asks for `perm`; L_NONE means no token ever carries it.
pub fn mint_ceiling(perm : str, owner_yes : bool) -> u8 {
    var best : u8 = L_NONE;
    for i in 0..27 {
        if (recipes::str_eq(PERMS[i], perm) and row_mintable(i, owner_yes)) {
            if (LEVELS[i] > best) { best = LEVELS[i]; }
        }
    }
    return best;
}

/// The level the App was measured to hold for `perm`; L_NONE when not granted.
pub fn granted(perm : str) -> u8 {
    for i in 0..16 {
        if recipes::str_eq(GRANT_PERMS[i], perm) { return GRANT_LEVELS[i]; }
    }
    return L_NONE;
}

/// Every mintable row fits inside the measured grant: the App can actually mint what it plans.
pub fn plan_fits_grant(owner_yes : bool) -> bool {
    for i in 0..27 {
        if (row_mintable(i, owner_yes)) {
            if (LEVELS[i] > granted(PERMS[i])) { return false; }
        }
    }
    return true;
}

/// How many granted permissions no token will ever use at their granted level -- the part of
/// the grant that only widens a leak. The owner may narrow the App by exactly these.
pub fn over_granted(owner_yes : bool) -> u32 {
    var n : u32 = 0;
    for i in 0..16 {
        if (mint_ceiling(GRANT_PERMS[i], owner_yes) < GRANT_LEVELS[i]) { n += 1; }
    }
    return n;
}

/// Census by status.
pub fn count_status(s : u8) -> u32 {
    var n : u32 = 0;
    for i in 0..27 {
        if STATUS[i] == s { n += 1; }
    }
    return n;
}

/// Every row has surface, permission, endpoint and value.
pub fn every_row_filled() -> bool {
    for i in 0..27 {
        if SURFACES[i] == "" { return false; }
        if PERMS[i] == "" { return false; }
        if ENDPOINTS[i] == "" { return false; }
        if VALUES[i] == "" { return false; }
    }
    return true;
}

/// No surface appears twice among the first n rows.
pub fn all_surfaces_unique(n : usize) -> bool {
    var i : usize = 0;
    while (i < n) {
        var j : usize = i + 1;
        while (j < n) {
            if recipes::str_eq(SURFACES[i], SURFACES[j]) { return false; }
            j += 1;
        }
        i += 1;
    }
    return true;
}

test surface_rows_are_filled_and_unique {
    assert every_row_filled() == true;
    assert all_surfaces_unique((COUNT) as usize) == true;
}

test surface_census_adds_up {
    assert count_status(S_PLANNED) == 13;
    assert count_status(S_LIVE) == 3;
    assert count_status(S_OWNER) == 1;
    assert count_status(S_ACTIONS) == 1;
    assert count_status(S_NEEDS_HOOK) == 2;
    assert count_status(S_UNAVAILABLE) == 1;
    assert count_status(S_REFUSED) == 6;
    var total : u32 = 0;
    var s : u8 = 0;
    while (s <= S_REFUSED) {
        total += count_status(s);
        s += 1;
    }
    assert total == COUNT;
}

test claw_t27f_job_mints_exactly_three_narrow_scopes {
    // The rollout's claw/t27f job serves check-run, pr-files and spec-read.
    assert recipes::str_eq(perm_of("check-run", false), "checks") == true;
    assert level_of("check-run", false) == L_WRITE;
    assert recipes::str_eq(perm_of("pr-files", false), "pull_requests") == true;
    assert level_of("pr-files", false) == L_READ;
    assert recipes::str_eq(perm_of("spec-read", false), "contents") == true;
    assert level_of("spec-read", false) == L_READ;
}

test refused_permissions_never_reach_a_token {
    // Even with the owner's yes: refusal is about value, not consent.
    assert mint_ceiling("secrets", true) == L_NONE;
    assert mint_ceiling("workflows", true) == L_NONE;
    assert mint_ceiling("statuses", true) == L_NONE;
    assert mint_ceiling("codespaces", true) == L_NONE;
    assert mint_ceiling("repository_hooks", true) == L_NONE;
    assert level_of("secrets", true) == L_NONE;
    assert level_of("administration-other", true) == L_NONE;
}

test administration_only_with_the_owner_yes {
    assert mint_ceiling("administration", false) == L_NONE;
    assert level_of("required-check-ruleset", false) == L_NONE;
    assert mint_ceiling("administration", true) == L_WRITE;
    assert level_of("required-check-ruleset", true) == L_WRITE;
    // The yes opens the ruleset row, never the other administration row.
    assert level_of("administration-other", true) == L_NONE;
}

test hook_rows_mint_nothing_although_their_permission_is_minted_elsewhere {
    // checks is write through check-run; the buttons row still mints nothing on its own.
    assert mint_ceiling("checks", false) == L_WRITE;
    assert level_of("check-run-buttons", false) == L_NONE;
    assert mint_ceiling("merge_queues", true) == L_NONE;
    assert level_of("custom-properties", true) == L_NONE;
    assert level_of("attestations", true) == L_NONE;
}

test write_surfaces_that_carry_the_value {
    assert mint_ceiling("security_events", false) == L_WRITE;
    assert mint_ceiling("pull_requests", false) == L_WRITE;
    assert mint_ceiling("contents", false) == L_WRITE;
    assert mint_ceiling("deployments", false) == L_WRITE;
    assert mint_ceiling("issues", false) == L_WRITE;
}

test unknown_surface_fails_closed {
    assert row_of("no-such-surface") == -1;
    assert recipes::str_eq(perm_of("no-such-surface", true), "") == true;
    assert level_of("no-such-surface", true) == L_NONE;
    assert granted("no_such_permission") == L_NONE;
}

test the_plan_fits_the_measured_grant {
    assert plan_fits_grant(false) == true;
    assert plan_fits_grant(true) == true;
}

test over_grant_is_counted_so_the_owner_can_narrow_it {
    // statuses, attestations, merge_queues, repository_custom_properties, secrets, workflows,
    // codespaces, repository_hooks -- and administration until the owner says yes.
    assert over_granted(false) == 9;
    assert over_granted(true) == 8;
}

test merge_pr_mints_contents_write_only {
    // The merger job asks for merge-pr: contents at write, nothing wider, no owner yes needed.
    assert recipes::str_eq(perm_of("merge-pr", false), "contents") == true;
    assert level_of("merge-pr", false) == L_WRITE;
    assert recipes::str_eq(perm_of("merge-pr", true), "contents") == true;
    assert level_of("merge-pr", true) == L_WRITE;
    // The token the row names carries no administration, secrets or workflows.
    assert mint_ceiling("workflows", true) == L_NONE;
    assert mint_ceiling("secrets", true) == L_NONE;
    assert mint_ceiling("administration", false) == L_NONE;
}

test queue_rows_are_planned_and_mintable {
    assert row_of("merge-pr") == 22;
    assert row_of("update-branch") == 23;
    assert row_of("rerun-failed") == 24;
    assert row_of("control-comments") == 25;
    assert row_of("queue-dispatch") == 26;
    assert STATUS[22] == S_PLANNED;
    assert STATUS[23] == S_PLANNED;
    assert STATUS[24] == S_PLANNED;
    assert STATUS[25] == S_PLANNED;
    assert STATUS[26] == S_PLANNED;
    assert row_mintable(22, false) == true;
    assert row_mintable(23, false) == true;
    assert row_mintable(24, false) == true;
    assert row_mintable(25, false) == true;
    assert row_mintable(26, false) == true;
}

test queue_rows_name_their_permission_and_level {
    assert recipes::str_eq(perm_of("update-branch", false), "pull_requests") == true;
    assert level_of("update-branch", false) == L_WRITE;
    assert recipes::str_eq(perm_of("rerun-failed", false), "actions") == true;
    assert level_of("rerun-failed", false) == L_WRITE;
    assert recipes::str_eq(perm_of("control-comments", false), "issues") == true;
    assert level_of("control-comments", false) == L_WRITE;
    assert recipes::str_eq(perm_of("queue-dispatch", false), "contents") == true;
    assert level_of("queue-dispatch", false) == L_WRITE;
}

test actions_is_granted_and_minted_for_rerun_only {
    assert granted("actions") == L_WRITE;
    assert mint_ceiling("actions", false) == L_WRITE;
    assert plan_fits_grant(false) == true;
}

test the_original_rows_keep_their_permission_level_and_status {
    assert recipes::str_eq(PERMS[0], "checks") == true;
    assert LEVELS[0] == L_WRITE;
    assert STATUS[0] == S_LIVE; // claw/criteria posts it (#10549)
    assert recipes::str_eq(PERMS[2], "security_events") == true;
    assert STATUS[2] == S_LIVE;
    assert recipes::str_eq(PERMS[11], "administration") == true;
    assert STATUS[11] == S_OWNER;
    assert recipes::str_eq(SURFACES[21], "repo-creation-hooks") == true;
    assert STATUS[21] == S_REFUSED;
    assert COUNT == 27;
}
