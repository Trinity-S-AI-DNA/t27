    "PATCH /repos/{o}/{r}/check-runs/{id}",
    "POST /repos/{o}/{r}/code-scanning/sarifs",
    "GET /repos/{o}/{r}/pulls/{n}/files",
    "POST /repos/{o}/{r}/pulls/{n}/reviews",
    "GET /repos/{o}/{r}/git/trees/{sha}",
    "POST /repos/{o}/{r}/git/commits",
    "POST /repos/{o}/{r}/dispatches",
    "POST /repos/{o}/{r}/deployments",
    "POST /repos/{o}/{r}/issues/{n}/sub_issues",
    "POST /repos/{o}/{r}/dependency-graph/snapshots",
    "POST /repos/{o}/{r}/rulesets",
    "POST /repos/{o}/{r}/attestations",
    "POST /repos/{o}/{r}/statuses/{sha}",
    "event check_run.requested_action",
    "event merge_group.checks_requested",
    "PATCH /repos/{o}/{r}/properties/values",
    "PUT /repos/{o}/{r}/actions/secrets/{name}",
    "PUT /repos/{o}/{r}/contents/.github/workflows/{f}",
