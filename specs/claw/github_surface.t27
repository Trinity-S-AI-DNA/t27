// SPDX-License-Identifier: Apache-2.0
; specs/claw/github_surface.t27 -- what the TRI CLAW GitHub App does with each GitHub API surface,
; for .t27, and the token each job is allowed to mint (epic #9271).
; Owner, 2026-10-18, translated: "I gave full access. Study the GitHub API and connect full
; coverage and value for .t27." Measured the same day (GET /apps/tri-claw, updated_at
; 2026-10-18T06:59:05Z): the App holds write on 40 repository permissions, all repositories of
; the gHashTag user account (installation 167308749).
; --
; Full access is the grant, not the token. The private key lives in two places (the t27 Actions
; secret CLAW_APP_PRIVATE_KEY and the reviewer bees' Keychain), so a token minted without a
; scope from any t27 branch would carry administration, secrets and workflows write over every
; repository. The law here: a job names the SURFACE it serves, the token carries exactly that
; row's permission at that row's level (plus metadata read, which GitHub always adds), and a
; surface that is not mintable mints nothing. The grant may stay wide; every token stays narrow.
; --
; Shape (same discipline as specs/claw/recipes.t27): one ROW PER SURFACE, parallel arrays,
; alignment pinned by tests. STATUS decides whether a row ever reaches a token:
; - S_LIVE / S_PLANNED: mintable. PLANNED rows are filed lanes; a row moves to LIVE in the PR
;   that ships it.
; - S_OWNER: mintable only on the owner's explicit yes for that run (repository rulesets bind
;   every merge in a repository; that is the owner's call, never the loop's).
; - S_ACTIONS: the surface is real but the App adds nothing -- GitHub Actions' own token or OIDC
;   does it better (attestation signing needs the Actions OIDC token, not an App key).
; - S_NEEDS_HOOK: the value arrives only as a webhook event; claw runs zero servers
;   (specs/claw/service.t27), so these rows wait for a receiver and mint nothing until then.
; - S_UNAVAILABLE: the account type blocks it (custom properties exist only on organizations;
;   gHashTag is a user account).
; - S_REFUSED: no .t27 value, and holding it widens what a leaked token can do.
; The honest limit: this table records what each surface is FOR. It does not prove a workflow
; passes the scope it names -- that is the job of the workflow's own reviewer, and of the lane
; that ships each PLANNED row.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawGithubSurface;

use claw::recipes;

/// Row status.
pub const S_PLANNED : u8 = 0;
pub const S_LIVE : u8 = 1;
pub const S_OWNER : u8 = 2;
pub const S_ACTIONS : u8 = 3;
pub const S_NEEDS_HOOK : u8 = 4;
pub const S_UNAVAILABLE : u8 = 5;
pub const S_REFUSED : u8 = 6;

/// Permission level, as GitHub spells it: none < read < write.
pub const L_NONE : u8 = 0;
pub const L_READ : u8 = 1;
pub const L_WRITE : u8 = 2;

/// The App's id; a ruleset's required check pins integration_id to it, so no other actor can
/// post a green claw/t27f.
pub const APP_ID : u32 = 5166765;

/// Row count of the table.
pub const COUNT : u32 = 27;

/// Surface slug; the lookup key for every column.
pub const SURFACES : [27]str = [
    "check-run", "check-annotations", "code-scanning-sarif", "pr-files", "pr-suggestions",
    "spec-read", "autofix-commit", "cross-repo-dispatch", "t27f-preview", "findings-issues",
    "dependency-snapshot", "required-check-ruleset", "attestations", "commit-statuses",
    "check-run-buttons", "merge-queue", "custom-properties", "secrets", "workflows",
    "administration-other", "codespaces-agents", "repo-creation-hooks",
    "merge-pr", "update-branch", "rerun-failed", "control-comments", "queue-dispatch",
];

/// The GitHub App permission the surface needs (GitHub's own key names).
pub const PERMS : [27]str = [
    "checks", "checks", "security_events", "pull_requests", "pull_requests",
    "contents", "contents", "contents", "deployments", "issues",
    "contents", "administration", "attestations", "statuses",
    "checks", "merge_queues", "repository_custom_properties", "secrets", "workflows",
    "administration", "codespaces", "repository_hooks",
    "contents", "pull_requests", "actions", "issues", "contents",
];

/// The level the surface needs.
pub const LEVELS : [27]u8 = [
    L_WRITE, L_WRITE, L_WRITE, L_READ, L_WRITE,
    L_READ, L_WRITE, L_WRITE, L_WRITE, L_WRITE,
    L_WRITE, L_WRITE, L_WRITE, L_WRITE,
    L_WRITE, L_READ, L_WRITE, L_WRITE, L_WRITE,
    L_WRITE, L_WRITE, L_WRITE,
    L_WRITE, L_WRITE, L_WRITE, L_WRITE, L_WRITE,
];

pub const STATUS : [27]u8 = [
    S_LIVE, S_PLANNED, S_LIVE, S_PLANNED, S_LIVE,
    S_PLANNED, S_PLANNED, S_PLANNED, S_PLANNED, S_PLANNED,
    S_PLANNED, S_OWNER, S_ACTIONS, S_REFUSED,
    S_NEEDS_HOOK, S_NEEDS_HOOK, S_UNAVAILABLE, S_REFUSED, S_REFUSED,
    S_REFUSED, S_REFUSED, S_REFUSED,
    S_PLANNED, S_PLANNED, S_PLANNED, S_PLANNED, S_PLANNED,
];

