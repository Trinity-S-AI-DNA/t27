// SPDX-License-Identifier: Apache-2.0
; specs/claw/lab_receipt.t27 -- whether a Railway lab check is evidence about the change it was run
; for, read from what the lab printed.
; --
; On 2026-10-19 (tick 38) the lane checked a rebased branch on the lab in one shell line:
;     git clean specs/claw && git apply <patch> && ...; seal --verify every spec; test-report each
; The clean left a stale .trinity/seals/*.json behind, so `git apply` stopped with "already exists"
; and changed nothing. The checks after the `;` still ran, on master's files: seals 33 of 33 and
; four specs green. The fifth spec, the new one, was not in the tree, and its summary line came out
; blank. The output read like a pass. Only the missing line gave it away. Re-run on a clean
; tree, the same check applied 13 files and showed 34 seals. A blank line is not a zero, and a pass
; on code the patch never reached is not a pass.
; --
; lab_reason(expected_files, applied_files, tests, fails, vacuous), first match wins:
;   applied_files != expected_files                 -> hold R_NOT_APPLIED
;   tests, fails or vacuous is NONE (no such line)  -> hold R_SILENT
;   tests == 0                                      -> hold R_EMPTY
;   fails > 0                                       -> hold R_RED
;   vacuous > 0                                     -> hold R_VACUOUS
;   otherwise                                       -> pass R_PASS
; expected_files is the number of files in the local diff (`git diff --name-only | wc -l`);
; applied_files is what the lab echoed after `git apply --index` (`git status --short | wc -l`).
; count_after reads one number out of t27c's test-report text. It looks for these keys:
;     "\n  tests "   "\n  FAIL "   "\n  vacuous passes "
; Each key is anchored at a line start with exactly two spaces, so a test name in the per-test
; assert table (indented by a right-aligned count) never matches. The number is the first run of
; digits after the spaces that follow the key. It returns NONE when the key is absent, when no
; digit follows, or when the number has more than 9 digits.
; receipt_line writes   L TAB <pass|hold> TAB <why>\n   for one reason.
; Not specs/tri/lab/receipt.t27: that one reads the t27b lab's published run of a master commit.
; This one reads a hand-run lab check of a patch that is not on master yet.
; The honest limit: the counts are what the caller read off the lab. This module decides from them;
; it does not run the lab.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawLabReceipt;

use claw::text;

/// "No such line in the report."
pub const NONE : u32 = 4294967295;

/// Verdicts.
pub const V_PASS : u8 = 0;
pub const V_HOLD : u8 = 1;

/// Reasons, one per receipt line.
pub const R_PASS : u8 = 0;
pub const R_NOT_APPLIED : u8 = 1;
pub const R_SILENT : u8 = 2;
pub const R_EMPTY : u8 = 3;
pub const R_RED : u8 = 4;
pub const R_VACUOUS : u8 = 5;
pub const R_COUNT : usize = 6;

pub const VERDICT_TEXTS : [2]str = ["L\tpass\t", "L\thold\t"];
pub const VERDICT_LENS : [2]usize = [7, 7];

pub const WHY_TEXTS : [6]str = [
    "the patch landed and every test ran an assert and passed\n",
    "the lab applied a different number of files than the diff holds; the checks ran on other code\n",
    "the report has no tests, FAIL or vacuous line; the compiler stopped or a filter hid it\n",
    "the report ran no test; nothing was checked\n",
    "a test failed\n",
    "a test passed without running an assert; it checks nothing\n"
];
pub const WHY_LENS : [6]usize = [57, 94, 87, 44, 14, 59];

/// The three summary keys of t27c test-report.
pub const KEY_TESTS : str = "\n  tests ";
pub const KEY_TESTS_LEN : usize = 9;
pub const KEY_FAIL : str = "\n  FAIL ";
pub const KEY_FAIL_LEN : usize = 8;
pub const KEY_VACUOUS : str = "\n  vacuous passes ";
pub const KEY_VACUOUS_LEN : usize = 18;

/// The most digits a count may have.
pub const MAX_DIGITS : u32 = 9;

/// The reason for one lab check; its verdict is verdict_of(reason).
pub fn lab_reason(expected_files : u32, applied_files : u32, tests : u32, fails : u32, vacuous : u32) -> u8 {
    if (applied_files != expected_files) { return R_NOT_APPLIED; }
    if (tests == NONE or fails == NONE or vacuous == NONE) { return R_SILENT; }
    if (tests == 0) { return R_EMPTY; }
    if (fails > 0) { return R_RED; }
    if (vacuous > 0) { return R_VACUOUS; }
    return R_PASS;
}

/// Only R_PASS passes; every other reason, and any value out of range, holds.
pub fn verdict_of(r : u8) -> u8 {
    if (r == R_PASS) { return V_PASS; }
    return V_HOLD;
}

pub fn lab_verdict(expected_files : u32, applied_files : u32, tests : u32, fails : u32, vacuous : u32) -> u8 {
    return verdict_of(lab_reason(expected_files, applied_files, tests, fails, vacuous));
}

/// Where the first match of key starts in b[0..b_len); b_len when there is none.
pub fn key_at(b : str, b_len : usize, key : str, key_len : usize) -> usize {
    var start : usize = 0;
    while (start + key_len <= b_len) {
        var k : usize = 0;
        var diff : usize = 0;
        while (k < key_len) {
            if (b[start + k] != key[k]) { diff += 1; }
            k += 1;
        }
        if (diff == 0) { return start; }
        start += 1;
    }
    return b_len;
}

/// The number after the first match of key in b[0..b_len), past any spaces; NONE when the key is
/// absent, no digit follows, or the number has more than MAX_DIGITS digits.
pub fn count_after(b : str, b_len : usize, key : str, key_len : usize) -> u32 {
    const at : usize = key_at(b, b_len, key, key_len);
    if (at == b_len) { return NONE; }
    var i : usize = at + key_len;
    while (i < b_len and b[i] == ' ') { i += 1; }
    var v : u32 = 0;
    var digits : u32 = 0;
    while (i < b_len and b[i] >= '0' and b[i] <= '9') {
        if (digits == MAX_DIGITS) { return NONE; }
        v = v * 10 + ((b[i] - '0') as u32);
        digits += 1;
        i += 1;
    }
    if (digits == 0) { return NONE; }
    return v;
}

/// The reason for a whole test-report text, given the file counts.
pub fn report_reason(expected_files : u32, applied_files : u32, b : str, b_len : usize) -> u8 {
    const t : u32 = count_after(b, b_len, KEY_TESTS, KEY_TESTS_LEN);
    const f : u32 = count_after(b, b_len, KEY_FAIL, KEY_FAIL_LEN);
    const v : u32 = count_after(b, b_len, KEY_VACUOUS, KEY_VACUOUS_LEN);
    return lab_reason(expected_files, applied_files, t, f, v);
}

/// The receipt line for reason r into out at w, clipped at cap; returns the new cursor, which still
/// advances when clipped. A reason out of range writes the R_SILENT line.
pub fn receipt_line(r : u8, out : []u8, cap : usize, w : usize) -> usize {
    var k : u8 = r;
    if ((k as usize) >= R_COUNT) { k = R_SILENT; }
    const v : usize = verdict_of(k) as usize;
    const x : usize = put_str(out, cap, w, VERDICT_TEXTS[v], VERDICT_LENS[v]);
    return put_str(out, cap, x, WHY_TEXTS[k as usize], WHY_LENS[k as usize]);
}

// ---- tests: the reports the lane met ----

/// move_gate's report on 2026-10-19, trimmed to the summary and two table rows.
pub const GOOD : str = "--- test report: specs/claw/move_gate.t27 ---\n\n  tests       16\n  pass        16\n  FAIL        0\n  rate    100.0%\n\n  runtime asserts executed, per test (#6509; a pass with 0 is vacuous, T730):\n       3  the_target_whose_trial_expired_holds_every_move\n      15  only_the_two_ok_reasons_write_a_go_line\n  vacuous passes  0 of 16  (passed with 0 runtime asserts executed)\n";
pub const GOOD_LEN : usize = 369;

/// What t27c printed when zig was not on PATH: no summary at all.
pub const BLOCKED : str = "t27c: BLOCKED: zig not on PATH\n";
pub const BLOCKED_LEN : usize = 31;

test the_tick_38_apply_that_changed_nothing_holds_even_though_the_checks_were_green {
    // The diff held 13 files; the failed apply left 0 staged. The other specs' reports were green.
    assert lab_reason(13, 0, 25, 0, 0) == R_NOT_APPLIED;
    assert lab_verdict(13, 0, 25, 0, 0) == V_HOLD;
    assert report_reason(13, 0, GOOD, GOOD_LEN) == R_NOT_APPLIED;
    assert lab_reason(13, 14, 25, 0, 0) == R_NOT_APPLIED;
}

test the_new_spec_whose_line_came_out_blank_is_silent_not_zero {
    assert lab_reason(13, 13, NONE, NONE, NONE) == R_SILENT;
    assert report_reason(13, 13, "", 0) == R_SILENT;
    assert report_reason(13, 13, BLOCKED, BLOCKED_LEN) == R_SILENT;
}

test one_missing_count_is_enough_to_be_silent {
    assert lab_reason(1, 1, NONE, 0, 0) == R_SILENT;
    assert lab_reason(1, 1, 16, NONE, 0) == R_SILENT;
    assert lab_reason(1, 1, 16, 0, NONE) == R_SILENT;
}

test the_clean_rerun_passes {
    assert report_reason(13, 13, GOOD, GOOD_LEN) == R_PASS;
    assert lab_verdict(13, 13, 16, 0, 0) == V_PASS;
    assert lab_reason(0, 0, 1, 0, 0) == R_PASS;
}

test no_test_red_and_vacuous_each_hold {
    assert lab_reason(1, 1, 0, 0, 0) == R_EMPTY;
    assert lab_reason(1, 1, 16, 1, 0) == R_RED;
    assert lab_reason(1, 1, 16, 2, 2) == R_RED;
    assert lab_reason(1, 1, 16, 0, 1) == R_VACUOUS;
    assert lab_verdict(1, 1, 16, 0, 1) == V_HOLD;
}

test the_summary_numbers_are_read_from_the_report {
    assert count_after(GOOD, GOOD_LEN, KEY_TESTS, KEY_TESTS_LEN) == 16;
    assert count_after(GOOD, GOOD_LEN, KEY_FAIL, KEY_FAIL_LEN) == 0;
    assert count_after(GOOD, GOOD_LEN, KEY_VACUOUS, KEY_VACUOUS_LEN) == 0;
    assert count_after("x\n  FAIL 3\n", 11, KEY_FAIL, KEY_FAIL_LEN) == 3;
    assert count_after("\n  tests 120", 12, KEY_TESTS, KEY_TESTS_LEN) == 120;
}

test negative_control_a_test_named_tests_in_the_table_is_not_the_summary {
    // Table rows are indented by a right-aligned count, so "\n  tests " cannot match inside one.
    assert count_after("\n       3  tests 7 pass\n", 24, KEY_TESTS, KEY_TESTS_LEN) == NONE;
    assert count_after("\n tests 7\n", 10, KEY_TESTS, KEY_TESTS_LEN) == NONE;
    assert count_after("\n  testsx 7\n", 12, KEY_TESTS, KEY_TESTS_LEN) == NONE;
}

test a_key_with_no_number_after_it_reads_as_none {
    assert count_after("\n  FAIL ", 8, KEY_FAIL, KEY_FAIL_LEN) == NONE;
    assert count_after("\n  FAIL    x\n", 13, KEY_FAIL, KEY_FAIL_LEN) == NONE;
    assert count_after("\n  FAIL    ", 11, KEY_FAIL, KEY_FAIL_LEN) == NONE;
}

test a_count_stops_at_the_buffer_end_not_past_it {
    // b_len cuts "12" to "1": the digit past b_len is not read.
    assert count_after("\n  FAIL 12", 9, KEY_FAIL, KEY_FAIL_LEN) == 1;
    assert count_after("\n  FAIL  ", 9, KEY_FAIL, KEY_FAIL_LEN) == NONE;
    // A key that ends exactly at b_len.
    assert count_after("\n  FAIL 4", 8, KEY_FAIL, KEY_FAIL_LEN) == NONE;
}

test nine_digits_read_and_ten_are_refused {
    assert count_after("\n  FAIL 123456789\n", 18, KEY_FAIL, KEY_FAIL_LEN) == 123456789;
    assert count_after("\n  FAIL 1234567890\n", 19, KEY_FAIL, KEY_FAIL_LEN) == NONE;
}

test a_key_is_found_where_it_ends_exactly_at_the_buffer_end {
    assert key_at("\n  FAIL ", 8, KEY_FAIL, KEY_FAIL_LEN) == 0;
    assert key_at("x\n  FAIL ", 9, KEY_FAIL, KEY_FAIL_LEN) == 1;
    assert key_at("\n  FAI", 6, KEY_FAIL, KEY_FAIL_LEN) == 6;
    assert key_at("x\n  FAIL ", 8, KEY_FAIL, KEY_FAIL_LEN) == 8;
}

test the_first_match_wins {
    assert count_after("\n  FAIL 2\n  FAIL 5\n", 20, KEY_FAIL, KEY_FAIL_LEN) == 2;
}

test only_r_pass_passes_and_out_of_range_holds {
    var r : u32 = 0;
    var passes : u32 = 0;
    while (r < 256) {
        if (verdict_of(r as u8) == V_PASS) { passes += 1; assert r == 0; }
        r += 1;
    }
    assert passes == 1;
    assert verdict_of(6) == V_HOLD;
}

test only_the_pass_reason_writes_a_pass_line {
    var out : [128]u8 = undefined;
    var r : u8 = 0;
    var passes : u32 = 0;
    while (r < 6) {
        const w : usize = receipt_line(r, &out, 128, 0);
        if (out[2] == 'p') {
            passes += 1;
            assert r == R_PASS;
        } else {
            assert out[2] == 'h';
        }
        assert out[w - 1] == '\n';
        r += 1;
    }
    assert passes == 1;
}

test the_lens_are_the_lengths_of_the_texts {
    var k : usize = 0;
    while (k < R_COUNT) {
        assert WHY_LENS[k] == WHY_TEXTS[k].len;
        k += 1;
    }
    var v : usize = 0;
    while (v < 2) {
        assert VERDICT_LENS[v] == VERDICT_TEXTS[v].len;
        v += 1;
    }
    assert KEY_TESTS_LEN == KEY_TESTS.len;
    assert KEY_FAIL_LEN == KEY_FAIL.len;
    assert KEY_VACUOUS_LEN == KEY_VACUOUS.len;
    assert GOOD_LEN == GOOD.len;
    assert BLOCKED_LEN == BLOCKED.len;
}

test the_receipt_line_spells_the_verdict_and_the_reason {
    var out : [128]u8 = undefined;
    const w : usize = receipt_line(R_NOT_APPLIED, &out, 128, 0);
    assert w == 7 + 94;
    assert out[0] == 'L';
    assert out[2] == 'h';
    assert out[7] == 't';
    assert out[w - 1] == '\n';
    const p : usize = receipt_line(R_PASS, &out, 128, 0);
    assert p == 7 + 57;
    assert out[2] == 'p';
}

test a_reason_out_of_range_writes_the_silent_line {
    var out : [128]u8 = undefined;
    const w : usize = receipt_line(9, &out, 128, 0);
    assert w == 7 + 87;
    assert out[2] == 'h';
    assert out[11] == 'r';
    // Exactly R_COUNT: the first reason past the table.
    out[11] = 'x';
    const e : usize = receipt_line(6, &out, 128, 0);
    assert e == 7 + 87;
    assert out[11] == 'r';
}

test a_clipped_line_still_advances_the_cursor {
    var out : [4]u8 = undefined;
    assert receipt_line(R_RED, &out, 4, 0) == 7 + 14;
}
