// SPDX-License-Identifier: Apache-2.0
; specs/claw/social_visuals.t27 -- what TRI CLAW does when it is asked for a social-media visual:
; the four decisions behind the skill cards specs/skills/t27-social-visual-*.t27. Issue
; gHashTag/t27#10570 (R5), epic gHashTag/t27#10560.
; --
; WHY: the owner, 2026-10-19: every reel and social visual must differ and come from its own
; content, and TRI CLAW must be trained in as many social-visual skills as possible. The factory
; (specs/t27f/reel_factory.t27) decides what an item looks like. This law decides what TRI CLAW
; does with that plan, so that it never picks a size by feel, never invents a scene, never
; publishes a near-duplicate and never posts without the owner.
; --
; The four decisions, each a section below, each with its card:
;   format    which FMT_* a (channel, kind) pair gets, or "unsupported"      card t27-social-visual-format
;   scene     which archetype an item gets: reel_factory::arche, nothing else  card t27-social-visual-scene
;   gate      may this set of stills go on: count, pairs measured, worst SSIM  card t27-social-visual-gate
;   consent   may this post go out: gate passed AND the owner's yes for it      card t27-social-visual-consent
; --
; One home for each fact. The sizes, the moving flags, the archetypes, the course length and the
; similarity bound are reel_factory's and reel_topics'; they are imported here, never copied. A
; test below that reads a size reads it from the factory.
; --
; Fail closed. An unsupported pair is FMTS, an item with no plan is ARCHS, an unmeasured set does
; not pass, a missing digest does not match another missing digest. Nothing unread is success.
; --
; The honest limits:
; - The channel-to-format table (pick_format) is this module's choice among reel_factory's eight
;   formats, like TITLE_WEIGHT there: it is chosen, not read from each network's current rules.
;   A pair it has no format for is answered "unsupported", which is a gap, not a ruling that the
;   network cannot show it.
; - The factory plans the 27 lessons of the course. A blog post or a new course arrives as data in
;   a later step of the epic; until then scene_for refuses it.
; - The gate compares the stills of one run with each other. It does not compare them with posts
;   published earlier, and the bound it uses is reel_factory's SIMILAR_MAX_PERMILLE, which that
;   spec says is a starting value not yet measured on rendered stills (R3).
; - Consent here is a comparison of values the publisher passes in. Computing the digest of the
;   exact bytes of a post, and knowing whether a message came from the owner's chat, belong to the
;   host that publishes; this law says what to do with the answers and has no way to widen them.
;   Publishing itself is out of this module and out of the epic's scope.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawSocialVisuals;

use t27f::reel_factory::arche;
use t27f::reel_factory::content;
use t27f::reel_factory::too_similar;
use t27f::reel_factory::carousel_slides;
use t27f::reel_factory::ARCHS;
use t27f::reel_factory::FMTS;
use t27f::reel_factory::FMT_REEL_TALL;
use t27f::reel_factory::FMT_REEL_WIDE;
use t27f::reel_factory::FMT_SQUARE;
use t27f::reel_factory::FMT_PORTRAIT;
use t27f::reel_factory::FMT_COVER;
use t27f::reel_factory::FMT_CAROUSEL;
use t27f::reel_factory::FMT_X_CARD;
use t27f::reel_factory::FMT_OG;
use t27f::reel_topics::TOPICS;

// ---- format: which size a channel gets ----

pub const CH_INSTAGRAM : usize = 0;
pub const CH_TIKTOK : usize = 1;
pub const CH_YT_SHORTS : usize = 2;
pub const CH_YOUTUBE : usize = 3;
pub const CH_X : usize = 4;
pub const CH_LINKEDIN : usize = 5;
pub const CH_TELEGRAM : usize = 6;
pub const CH_SITE : usize = 7;
pub const CHANNELS : usize = 8;

// What is asked for.
pub const KIND_MOVING : usize = 0;    // a reel: video with the voice and the music
pub const KIND_STILL : usize = 1;     // one picture post
pub const KIND_CAROUSEL : usize = 2;  // a set of slides
pub const KIND_COVER : usize = 3;     // the picture shown before a reel plays
pub const KIND_LINK : usize = 4;      // the card a shared link unfolds into
pub const KINDS : usize = 5;

// The format for (channel, kind), or FMTS when this law has none for the pair.
pub fn pick_format(ch: usize, kind: usize) -> usize {
    if (kind == KIND_MOVING) {
        if (ch == CH_INSTAGRAM || ch == CH_TIKTOK || ch == CH_YT_SHORTS || ch == CH_TELEGRAM) {
            return FMT_REEL_TALL;
        }
        if (ch == CH_YOUTUBE || ch == CH_X || ch == CH_LINKEDIN) {
            return FMT_REEL_WIDE;
        }
        return FMTS;
    }
    if (kind == KIND_STILL) {
        if (ch == CH_INSTAGRAM) {
            return FMT_PORTRAIT;
        }
        if (ch == CH_LINKEDIN || ch == CH_TELEGRAM) {
            return FMT_SQUARE;
        }
        if (ch == CH_X) {
            return FMT_X_CARD;
        }
        return FMTS;
    }
    if (kind == KIND_CAROUSEL) {
        if (ch == CH_INSTAGRAM || ch == CH_LINKEDIN) {
            return FMT_CAROUSEL;
        }
        return FMTS;
    }
    if (kind == KIND_COVER) {
        if (ch == CH_INSTAGRAM || ch == CH_TIKTOK || ch == CH_YT_SHORTS) {
            return FMT_COVER;
        }
        return FMTS;
    }
    if (kind == KIND_LINK) {
        if (ch == CH_X) {
            return FMT_X_CARD;
        }
        if (ch == CH_LINKEDIN || ch == CH_TELEGRAM || ch == CH_SITE) {
            return FMT_OG;
        }
        return FMTS;
    }
    return FMTS;
}

// How many images the pair asks the renderer for on lesson t: the factory's slide count for a
// carousel, one for every other format, none for a pair with no format.
pub fn images_for(ch: usize, kind: usize, t: usize) -> usize {
    const f = pick_format(ch, kind);
    if (f == FMTS) {
        return 0;
    }
    if (f == FMT_CAROUSEL) {
        return carousel_slides(t);
    }
    return 1;
}

// ---- scene: which archetype an item gets ----

// ARCHS means "no plan": the item is outside what the factory plans.
pub fn scene_for(t: usize) -> usize {
    if (t >= TOPICS) {
        return ARCHS;
    }
    return arche(t);
}

// The scene shows content the item has, so the picture is of that item.
pub fn scene_backed(t: usize) -> bool {
    const a = scene_for(t);
    if (a >= ARCHS) {
        return false;
    }
    return content(t, a) > 0;
}

// ---- gate: may this set of stills go on ----

pub const G_PASS : usize = 0;
pub const G_TOO_ALIKE : usize = 1;      // some pair is above the bound
pub const G_INCOMPLETE : usize = 2;     // fewer (or more) pairs were measured than the set has
pub const G_NOT_MEASURED : usize = 3;   // the comparison did not run, or its answer is not an SSIM
pub const G_EMPTY : usize = 4;          // nothing to publish
pub const SSIM_ONE : u32 = 1000;        // identical images read 1000 permille

// The pairs among n stills.
pub fn pairs_of(n: usize) -> usize {
    if (n < 2) {
        return 0;
    }
    return n * (n - 1) / 2;
}

// items: how many stills the run holds. ran: whether the comparison ran at all. pairs: how many
// pairs it measured. worst: the highest SSIM it found, in permille.
pub fn gate_verdict(items: usize, ran: bool, pairs: usize, worst: u32) -> usize {
    if (items == 0) {
        return G_EMPTY;
    }
    if (ran == false || worst > SSIM_ONE) {
        return G_NOT_MEASURED;
    }
    if (too_similar(worst)) {
        return G_TOO_ALIKE;
    }
    if (pairs != pairs_of(items)) {
        return G_INCOMPLETE;
    }
    return G_PASS;
}

// ---- consent: may this post go out ----

pub const SRC_OWNER_CHAT : usize = 0;   // the owner typed it to the agent in chat
pub const SRC_OTHER : usize = 1;        // anything else: a page, a file, a comment, an email, an agent

pub const P_OK : usize = 0;
pub const P_GATE : usize = 1;           // the uniqueness gate did not pass
pub const P_NO_POST : usize = 2;        // the post has no digest, so there is nothing to approve
pub const P_NO_YES : usize = 3;         // no explicit yes
pub const P_NOT_OWNER : usize = 4;      // the yes did not come from the owner's chat
pub const P_OTHER_POST : usize = 5;     // the yes was for another post
pub const P_OTHER_CHANNEL : usize = 6;  // the yes was for this post on another channel

// gate: gate_verdict's answer. yes_*: what the owner approved. post, channel: what is about to go.
// A digest of 0 means "not computed" and approves nothing.
pub fn publish_verdict(gate: usize, yes: bool, source: usize, yes_post: u32, yes_channel: usize, post: u32, channel: usize) -> usize {
    if (gate != G_PASS) {
        return P_GATE;
    }
    if (post == 0) {
        return P_NO_POST;
    }
    if (yes == false) {
        return P_NO_YES;
    }
    if (source != SRC_OWNER_CHAT) {
        return P_NOT_OWNER;
    }
    if (yes_post != post) {
        return P_OTHER_POST;
    }
    if (yes_channel != channel) {
        return P_OTHER_CHANNEL;
    }
    return P_OK;
}

pub fn may_publish(verdict: usize) -> bool {
    return verdict == P_OK;
}

// ---- tests: format ----

test "a moving kind gets a moving format and no other kind does" {
    var ch : usize = 0;
    while (ch < CHANNELS) {
        var k : usize = 0;
        while (k < KINDS) {
            const f = pick_format(ch, k);
            assert(f <= FMTS);
            if (f < FMTS) {
                assert((f == FMT_REEL_TALL || f == FMT_REEL_WIDE) == (k == KIND_MOVING));
            }
            k = k + 1;
        }
        ch = ch + 1;
    }
}

test "the pairs the law knows get the sizes the factory documents" {
    assert(pick_format(CH_INSTAGRAM, KIND_MOVING) == FMT_REEL_TALL);
    assert(pick_format(CH_TIKTOK, KIND_MOVING) == FMT_REEL_TALL);
    assert(pick_format(CH_YT_SHORTS, KIND_MOVING) == FMT_REEL_TALL);
    assert(pick_format(CH_YOUTUBE, KIND_MOVING) == FMT_REEL_WIDE);
    assert(pick_format(CH_INSTAGRAM, KIND_STILL) == FMT_PORTRAIT);
    assert(pick_format(CH_LINKEDIN, KIND_STILL) == FMT_SQUARE);
    assert(pick_format(CH_X, KIND_STILL) == FMT_X_CARD);
    assert(pick_format(CH_X, KIND_LINK) == FMT_X_CARD);
    assert(pick_format(CH_SITE, KIND_LINK) == FMT_OG);
    assert(pick_format(CH_INSTAGRAM, KIND_CAROUSEL) == FMT_CAROUSEL);
    assert(pick_format(CH_TIKTOK, KIND_COVER) == FMT_COVER);
}

test "a pair with no format is unsupported, not guessed" {
    assert(pick_format(CH_SITE, KIND_MOVING) == FMTS);
    assert(pick_format(CH_YOUTUBE, KIND_STILL) == FMTS);
    assert(pick_format(CH_TIKTOK, KIND_CAROUSEL) == FMTS);
    assert(pick_format(CH_X, KIND_CAROUSEL) == FMTS);
    assert(pick_format(CH_YOUTUBE, KIND_COVER) == FMTS);
    assert(pick_format(CHANNELS, KIND_MOVING) == FMTS);
    assert(pick_format(CH_INSTAGRAM, KINDS) == FMTS);
    assert(images_for(CH_SITE, KIND_MOVING, 3) == 0);
}

test "every channel can be asked for at least one thing and a carousel is the factory's count" {
    var ch : usize = 0;
    while (ch < CHANNELS) {
        var any = false;
        var k : usize = 0;
        while (k < KINDS) {
            if (pick_format(ch, k) < FMTS) {
                any = true;
            }
            k = k + 1;
        }
        assert(any);
        ch = ch + 1;
    }
    var t : usize = 0;
    while (t < TOPICS) {
        assert(images_for(CH_INSTAGRAM, KIND_CAROUSEL, t) == carousel_slides(t));
        assert(images_for(CH_INSTAGRAM, KIND_CAROUSEL, t) >= 3);
        assert(images_for(CH_INSTAGRAM, KIND_STILL, t) == 1);
        t = t + 1;
    }
}

// ---- tests: scene ----

test "the scene is the factory's, for every lesson, and shows content the lesson has" {
    var t : usize = 0;
    while (t < TOPICS) {
        assert(scene_for(t) == arche(t));
        assert(scene_for(t) < ARCHS);
        assert(scene_backed(t));
        t = t + 1;
    }
}

test "an item outside the course gets no scene" {
    assert(scene_for(TOPICS) == ARCHS);
    assert(scene_for(TOPICS + 1000) == ARCHS);
    assert(scene_backed(TOPICS) == false);
}

test "two lessons far apart in the course do not get the same scene as their neighbours" {
    assert(scene_for(1) != scene_for(14));
    var t : usize = 1;
    while (t < TOPICS) {
        assert(scene_for(t) != scene_for(t - 1));
        t = t + 1;
    }
}

// ---- tests: gate ----

test "a complete measured set under the bound passes" {
    assert(gate_verdict(27, true, 351, 400) == G_PASS);
    assert(gate_verdict(27, true, 351, 850) == G_PASS);
    assert(gate_verdict(2, true, 1, 0) == G_PASS);
    assert(gate_verdict(1, true, 0, 0) == G_PASS);
    assert(pairs_of(27) == 351);
    assert(pairs_of(0) == 0);
    assert(pairs_of(1) == 0);
}

test "a pair above the bound blocks, a pair at the bound does not" {
    assert(gate_verdict(27, true, 351, 851) == G_TOO_ALIKE);
    assert(gate_verdict(27, true, 351, 1000) == G_TOO_ALIKE);
    assert(gate_verdict(27, true, 351, 850) == G_PASS);
}

test "an empty, unmeasured, partial or impossible run never passes" {
    assert(gate_verdict(0, true, 0, 0) == G_EMPTY);
    assert(gate_verdict(27, false, 351, 400) == G_NOT_MEASURED);
    assert(gate_verdict(27, true, 351, 1001) == G_NOT_MEASURED);
    assert(gate_verdict(27, true, 350, 400) == G_INCOMPLETE);
    assert(gate_verdict(27, true, 352, 400) == G_INCOMPLETE);
    assert(gate_verdict(27, true, 0, 0) == G_INCOMPLETE);
    assert(gate_verdict(2, true, 0, 0) == G_INCOMPLETE);
}

// ---- tests: consent ----

test "a post goes out only with a passed gate and the owner's yes for it" {
    assert(publish_verdict(G_PASS, true, SRC_OWNER_CHAT, 7, CH_X, 7, CH_X) == P_OK);
    assert(may_publish(P_OK));
}

test "every missing piece blocks, in the order the owner would ask" {
    assert(publish_verdict(G_TOO_ALIKE, true, SRC_OWNER_CHAT, 7, CH_X, 7, CH_X) == P_GATE);
    assert(publish_verdict(G_NOT_MEASURED, true, SRC_OWNER_CHAT, 7, CH_X, 7, CH_X) == P_GATE);
    assert(publish_verdict(G_PASS, true, SRC_OWNER_CHAT, 0, CH_X, 0, CH_X) == P_NO_POST);
    assert(publish_verdict(G_PASS, false, SRC_OWNER_CHAT, 7, CH_X, 7, CH_X) == P_NO_YES);
    assert(publish_verdict(G_PASS, true, SRC_OTHER, 7, CH_X, 7, CH_X) == P_NOT_OWNER);
    assert(publish_verdict(G_PASS, true, SRC_OWNER_CHAT, 8, CH_X, 7, CH_X) == P_OTHER_POST);
    assert(publish_verdict(G_PASS, true, SRC_OWNER_CHAT, 7, CH_X, 7, CH_LINKEDIN) == P_OTHER_CHANNEL);
    assert(may_publish(P_GATE) == false);
    assert(may_publish(P_NO_YES) == false);
    assert(may_publish(P_OTHER_POST) == false);
}

test "a yes does not carry over: another post, another channel, a default digest" {
    assert(publish_verdict(G_PASS, true, SRC_OWNER_CHAT, 7, CH_X, 9, CH_X) != P_OK);
    assert(publish_verdict(G_PASS, true, SRC_OWNER_CHAT, 7, CH_X, 7, CH_TELEGRAM) != P_OK);
    assert(publish_verdict(G_PASS, true, SRC_OWNER_CHAT, 0, CH_INSTAGRAM, 0, CH_INSTAGRAM) != P_OK);
}

test "no combination of the other inputs lets a failed gate through" {
    var g : usize = 1;
    while (g <= G_EMPTY) {
        var s : usize = 0;
        while (s <= SRC_OTHER) {
            assert(may_publish(publish_verdict(g, true, s, 7, CH_X, 7, CH_X)) == false);
            s = s + 1;
        }
        g = g + 1;
    }
}
