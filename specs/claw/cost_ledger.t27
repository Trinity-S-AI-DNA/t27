// specs/claw/cost_ledger.t27 -- claw: cost_ledger_scan, paid calls checked
// against the pane-first escalation law.
// Part of M1 (milestone #5). Closes #13400.
// phi^2 + 1/phi^2 = 3 | TRINITY

module claw::cost_ledger;

pub const COST_LEDGER_PANE_FIRST : bool = true;

pub struct CostLedgerEntry { paid_call: bool, pane_first_checked: bool };

pub fn cost_ledger_pane_first_checked(e: CostLedgerEntry) -> bool {
    return e.pane_first_checked && e.paid_call;
}

test "cost ledger pane first checked" {
    assert(cost_ledger_pane_first_checked(CostLedgerEntry { paid_call: true, pane_first_checked: true }));
    assert(!cost_ledger_pane_first_checked(CostLedgerEntry { paid_call: true, pane_first_checked: false }));
}

invariant cost_ledger_pane_first_default {
    assert COST_LEDGER_PANE_FIRST;
}