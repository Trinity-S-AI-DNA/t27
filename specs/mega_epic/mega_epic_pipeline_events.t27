// SPDX-License-Identifier: Apache-2.0
; specs/mega_epic/mega_epic_pipeline_events.t27 -- T27L events for Mega Epic pipeline phase
; V3 Vertical Slice: T27L Event Surface
; Canonical ID: 0xM@mega_epic.t27 pipeline events
; T27A Registry: specs/mega_epic/ — Mega Epic pipeline event registry
; Surface: system (10) — already references mega_epic/lab_job_msg.t27
; T27L Version: t27l/v1
; phi^2 + 1/phi^2 = 3 | TRINITY

module mega_epic_pipeline_events;

/// T27L version prefix for all events in this spec.
pub const T27L_VERSION : str = "t27l/v1";

/// Event ID prefix.
pub const EVENT_ID_PREFIX : str = "me_";

/// Actor id format: 0x<Role>@<slug>.t27
pub const ACTOR_PREFIX : str = "0x";
pub const ACTOR_SUFFIX : str = ".t27";

/// Mega Epic pipeline surface. Reuses surface 10 "system" which already references mega_epic.
/// This surface groups all Mega Epic pipeline phase events.
pub const SF_MEGA_EPIC_PIPELINE : u8 = 10;
pub const SF_TEXT : str = "system";

/// Mega Epic pipeline phase actions.
/// These track the grand aggregation and scope expansion through the Mega Epic pipeline.
pub const ME_PIPELINE_STARTED   : u8 = 0;
ME_PHASE_TRANSITION   : u8 = 1;
ME_TASK_AGGREGATION    : u8 = 2;
ME_TASK_COMPLETED     : u8 = 3;
ME_PHASE_ACK           : u8 = 4;
ME_COUNT                : u8 = 5;

/// Test: surfaces are stable
test surfaces_stable {
    assert SF_MEGA_EPIC_PIPELINE == 10;
    assert SF_TEXT == "system";
    assert T27L_VERSION == "t27l/v1";
    assert EVENT_ID_PREFIX == "me_";
    assert ACTOR_PREFIX == "0x";
    assert ACTOR_SUFFIX == ".t27";
}

/// Test: pipeline actions are stable
test pipeline_actions_stable {
    assert ME_PIPELINE_STARTED   == 0;
    assert ME_PHASE_TRANSITION   == 1;
    assert ME_TASK_AGGREGATION    == 2;
    assert ME_TASK_COMPLETED     == 3;
    assert ME_PHASE_ACK           == 4;
    assert ME_COUNT                == 5;
}

/// Invariant: surface count
invariant surface_count {
    assert SF_COUNT == 1;  // Only SF_MEGA_EPIC_PIPELINE in this spec
}

/// Invariant: version stable
invariant version_stable {
    assert T27L_VERSION == "t27l/v1";
}

/// Invactor: actor prefix/suffix format
invactor actor_format {
    assert ACTOR_PREFIX == "0x";
    assert ACTOR_SUFFIX == ".t27";
}
