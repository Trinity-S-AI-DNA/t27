; specs/skills/t27-social-visual-consent.t27 -- skill t27/social-visual-consent
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/social-visual-consent).
; Decision 4 of 4: may this post go out; passed gate and the owner's yes for this post and channel.
; The rules live once, in specs/claw/social_visuals.t27, which imports specs/t27f/reel_factory.t27;
; this card points at them and copies none. There is no SKILL.md behind it yet, so the card is
; spec-only (see "Witness labels" in specs/skills/README.md). Issue gHashTag/t27#10570, epic
; gHashTag/t27#10560.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_social_visual_consent;

pub const KIND : str = "skill";
pub const ID : str = "t27/social-visual-consent";
pub const NAME : str = "Social Visual Consent";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Publish a social post only with the owner's explicit yes, given in the owner's own chat, for that exact post on that channel after the uniqueness gate passed; no standing yes, no default match";
pub const COMMAND : str = "/social-visual-consent";
; Specs this skill stands on: the decision law, then the factory it reads.
pub const SPECS : [2]str = ["specs/claw/social_visuals.t27", "specs/t27f/reel_factory.t27"];
pub const TAGS : [4]str = ["social-visual", "consent", "publish", "claw"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/social-visual-consent";
    assert NAME == "Social Visual Consent";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/social-visual-consent";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 4;
    assert TAGS[0] == "social-visual";
    assert SPECS.len == 2;
    assert SPECS[0] == "specs/claw/social_visuals.t27";
    assert SPECS[1] == "specs/t27f/reel_factory.t27";
}
