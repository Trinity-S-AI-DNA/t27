; specs/skills/t27-issue-shape.t27 -- skill t27/issue-shape
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/issue-shape).
; The skill body lives in gHashTag/t27 at .claude/skills/issue-shape/SKILL.md. It is a reading guide
; to specs/policy/issue_shape.t27, which stays the rule (#7498); where the two disagree, the spec wins.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_issue_shape;

pub const KIND : str = "skill";
pub const ID : str = "t27/issue-shape";
pub const NAME : str = "Issue Shape";
pub const REPO : str = "t27";
pub const SOURCE : str = "SKILL.md";
pub const SUMMARY_EN : str = "How to file a gHashTag/t27 issue that the issue-shape gate keeps open: the four sections specs/policy/issue_shape.t27 requires (Boundary, User Scenarios, Requirements, Success Criteria), the trap that every path inside Boundary is reserved, checking a body with the generated check_issue() on the Railway lab before filing, and recovering from shape-refused with gh issue edit.";
; The frontmatter id is the slash command.
pub const COMMAND : str = "/issue-shape";
pub const SPECS : [1]str = ["specs/policy/issue_shape.t27"];
pub const TAGS : [3]str = ["issues", "policy", "queen"];
pub const ENABLED : bool = true;
; Default budget; SKILL.md declares no timeout of its own.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/issue-shape";
    assert NAME == "Issue Shape";
    assert REPO == "t27";
    assert SOURCE == "SKILL.md";
    assert COMMAND == "/issue-shape";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS[0] == "issues";
    assert TAGS[1] == "policy";
    assert TAGS[2] == "queen";
    assert SPECS.len == 1;
    assert SPECS[0] == "specs/policy/issue_shape.t27";
}
