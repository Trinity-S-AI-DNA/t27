// SPDX-License-Identifier: Apache-2.0
; specs/skills/t27-why-card.t27 -- skill t27/why-card
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/why-card).
; How TRI CLAW answers "why does spec A import spec B" with a picture: pipe
; `t27c use-edges` into why_card with WHY_A, WHY_B and WHY_FONT set, and render the
; graph it prints with ffmpeg as a 1080x1350 card, one box per spec of the shortest
; use chain, each hop an exact edge. The law lives once, in specs/t27f/why_card.t27
; (card_* functions and their tests), and the chain in specs/t27f/spec_deps.t27
; (deps_why); this card points at them and copies none. Posting a card is the owner's
; call. There is no SKILL.md behind it yet, so the card is spec-only (see "Witness
; labels" in specs/skills/README.md). Issues gHashTag/t27#10705 and
; gHashTag/t27#10716, epic gHashTag/trinity#1648.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_why_card;

pub const KIND : str = "skill";
pub const ID : str = "t27/why-card";
pub const NAME : str = "Why Card";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Draw why one spec imports another as a social card: the shortest use chain t27c resolved, one box per spec, every edge exact, and no card at all when the chain does not exist or does not fit";
pub const COMMAND : str = "/why-card";
; Specs this skill stands on: the card layout and the chain it draws.
pub const SPECS : [2]str = ["specs/t27f/why_card.t27", "specs/t27f/spec_deps.t27"];
pub const TAGS : [4]str = ["social-visual", "t27f", "deps", "card"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/why-card";
    assert NAME == "Why Card";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/why-card";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 4;
    assert TAGS[0] == "social-visual";
    assert TAGS[2] == "deps";
    assert SPECS.len == 2;
    assert SPECS[0] == "specs/t27f/why_card.t27";
    assert SPECS[1] == "specs/t27f/spec_deps.t27";
}
