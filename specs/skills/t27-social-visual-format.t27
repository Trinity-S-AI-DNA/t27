; specs/skills/t27-social-visual-format.t27 -- skill t27/social-visual-format
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/social-visual-format).
; Decision 1 of 4: which of reel_factory's eight output formats a (channel, kind) pair gets.
; The rules live once, in specs/claw/social_visuals.t27, which imports specs/t27f/reel_factory.t27;
; this card points at them and copies none. There is no SKILL.md behind it yet, so the card is
; spec-only (see "Witness labels" in specs/skills/README.md). Issue gHashTag/t27#10570, epic
; gHashTag/t27#10560.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_social_visual_format;

pub const KIND : str = "skill";
pub const ID : str = "t27/social-visual-format";
pub const NAME : str = "Social Visual Format";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Pick the output size for a social channel and kind of post (reel, still, carousel, cover, link card) from the content factory's formats, and answer unsupported for a pair with no format instead of guessing";
pub const COMMAND : str = "/social-visual-format";
; Specs this skill stands on: the decision law, then the factory it reads.
pub const SPECS : [2]str = ["specs/claw/social_visuals.t27", "specs/t27f/reel_factory.t27"];
pub const TAGS : [4]str = ["social-visual", "format", "t27f", "claw"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/social-visual-format";
    assert NAME == "Social Visual Format";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/social-visual-format";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 4;
    assert TAGS[0] == "social-visual";
    assert SPECS.len == 2;
    assert SPECS[0] == "specs/claw/social_visuals.t27";
    assert SPECS[1] == "specs/t27f/reel_factory.t27";
}
