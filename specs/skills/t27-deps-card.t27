// SPDX-License-Identifier: Apache-2.0
; specs/skills/t27-deps-card.t27 -- skill t27/deps-card
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/deps-card).
; How TRI CLAW answers "who uses this spec, and what does it use" with a picture: pipe
; `t27c use-edges` into deps_card with DEPS_SPEC and DEPS_FONT set, and render the
; graph it prints with ffmpeg as a 1080x1350 card: the spec's direct importers above
; it, its direct imports below it, `+N more` past three, the transitive counts in the
; footer, and a gold ON AN IMPORT CYCLE line when it is on one. The law lives once, in
; specs/t27f/deps_card.t27 (dcard_* functions and their tests), the walk in
; specs/t27f/spec_deps.t27 (deps_walk) and the drawing helpers in
; specs/t27f/why_card.t27; this card points at them and copies none. Posting a card is
; the owner's call. There is no SKILL.md behind it yet, so the card is spec-only (see
; "Witness labels" in specs/skills/README.md). Issue gHashTag/t27#10720, epic
; gHashTag/trinity#1648.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_deps_card;

pub const KIND : str = "skill";
pub const ID : str = "t27/deps-card";
pub const NAME : str = "Deps Card";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Draw who uses a spec and what it uses as a social card: its direct importers and imports t27c resolved, the transitive counts both ways, a cycle flag, and no card at all when the spec is not in the edge list";
pub const COMMAND : str = "/deps-card";
; Specs this skill stands on: the card layout and the walk it draws.
pub const SPECS : [2]str = ["specs/t27f/deps_card.t27", "specs/t27f/spec_deps.t27"];
pub const TAGS : [4]str = ["social-visual", "t27f", "deps", "card"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/deps-card";
    assert NAME == "Deps Card";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/deps-card";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 4;
    assert TAGS[0] == "social-visual";
    assert TAGS[2] == "deps";
    assert SPECS.len == 2;
    assert SPECS[0] == "specs/t27f/deps_card.t27";
    assert SPECS[1] == "specs/t27f/spec_deps.t27";
}
