; Law: specs/tri/trigit/roadmap_dashboard_sync.t27 (debounce + bounded cycle + overflow)
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_cron_batch;

pub const KIND : str = "skill";
pub const ID : str = "t27/cron-batch";
pub const NAME : str = "Cron batch";
pub const REPO : str = "t27";
pub const SOURCE : str = "SKILL.md";
pub const SUMMARY_EN : str = "CRON_BATCH_V1: one tick collects events, debounces 500 ms, runs one job capped at 100 actions, overflow to T27M dead letter, emits T27L; no per-event agents or tight polling.";
pub const COMMAND : str = "/cron-batch [tick-name]";
pub const SPECS : [5]str = [
    "specs/tri/trigit/roadmap_dashboard_sync.t27",
    "specs/t27os/t27m.t27",
    "specs/t27os/t27l.t27",
    "specs/claw/merge_verdict.t27",
    "specs/claw/model_route.t27",
];
pub const TAGS : [4]str = ["cron", "queen", "batch", "event-driven"];
pub const ENABLED : bool = true;
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/cron-batch";
    assert ENABLED == true;
    assert SPECS.len == 5;
    assert RD_CYCLE_MAX_REF == 100;
}

/// Pin the batch cap to the sync spec constant (compile-time name check only).
pub const RD_CYCLE_MAX_REF : u32 = 100;

test negative_control_refutes_wrong_debounce {
    assert(RD_CYCLE_MAX_REF != 99);
}
