; specs/skills/t27-t27f.t27 -- skill t27/t27f
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/t27f).
; The skill body lives in gHashTag/t27 at .claude/skills/t27f/SKILL.md; its rules live in
; specs/t27f/topic_engine.t27 (gHashTag/trinity#1677).
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_t27f;

pub const KIND : str = "skill";
pub const ID : str = "t27/t27f";
pub const NAME : str = "T27F Topic Engine";
pub const REPO : str = "t27";
pub const SOURCE : str = "SKILL.md";
pub const SUMMARY_EN : str = "Turn a topic or client brief into three lenses, a 27-lesson map, one Bee task and a verified artifact";
; The frontmatter id is the slash command.
pub const COMMAND : str = "/t27f";
; Specs this skill stands on.
pub const SPECS : [1]str = ["specs/t27f/topic_engine.t27"];
pub const TAGS : [3]str = ["t27f", "learning", "bees"];
pub const ENABLED : bool = true;
; Default budget; SKILL.md declares no timeout of its own.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/t27f";
    assert NAME == "T27F Topic Engine";
    assert REPO == "t27";
    assert COMMAND == "/t27f";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS[0] == "t27f";
    assert TAGS[1] == "learning";
    assert TAGS[2] == "bees";
    assert SPECS.len == 1;
    assert SPECS[0] == "specs/t27f/topic_engine.t27";
}
