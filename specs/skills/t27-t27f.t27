// SPDX-License-Identifier: Apache-2.0
; specs/skills/t27-t27f.t27 -- skill t27/t27f
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/t27f).
; The skill body lives in gHashTag/t27 at .claude/skills/t27f/SKILL.md. T27F is the visual spec of a
; .t27 file (gHashTag/trinity#1648, RFC gHashTag/trinity#1649); its UI plan IR is
; specs/t27f/ui_plan.t27. The topic-map application (gHashTag/trinity#1677) has its rules in
; specs/t27f/topic_engine.t27.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_t27f;

pub const KIND : str = "skill";
pub const ID : str = "t27/t27f";
pub const NAME : str = "T27F Visual Spec";
pub const REPO : str = "t27";
pub const SOURCE : str = "SKILL.md";
pub const SUMMARY_EN : str = "Show a .t27 spec as one synchronized model with many views, every node labelled exact, derived, suggested or unknown";
; The frontmatter id is the slash command.
pub const COMMAND : str = "/t27f";
; Specs this skill stands on: the T27F UI plan IR, then the topic-map application.
pub const SPECS : [2]str = ["specs/t27f/ui_plan.t27", "specs/t27f/topic_engine.t27"];
pub const TAGS : [3]str = ["t27f", "visual-spec", "specs"];
pub const ENABLED : bool = true;
; Default budget; SKILL.md declares no timeout of its own.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/t27f";
    assert NAME == "T27F Visual Spec";
    assert REPO == "t27";
    assert COMMAND == "/t27f";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS[0] == "t27f";
    assert TAGS[1] == "visual-spec";
    assert TAGS[2] == "specs";
    assert SPECS.len == 2;
    assert SPECS[0] == "specs/t27f/ui_plan.t27";
    assert SPECS[1] == "specs/t27f/topic_engine.t27";
}
