// SPDX-License-Identifier: Apache-2.0
; specs/skills/trinity-land-and-leave.t27 -- skill trinity/land-and-leave
; Source of truth for the skill card on t27.ai (#/skills?skill=trinity/land-and-leave).
; The protocol for the last hour of a pull request's life: an agent that has pushed a
; head with its work report does NOT sit in a polling loop over the checks. The
; reviewer bee reviews the queue on its own schedule; trinity:.github/workflows/
; auto-merge.yml sweeps every ten minutes, dispatches the work-report workflow for
; heads that lack their T27 work report status, and squash-merges a head only when
; the bee-reviewed label is present and postdates the last push (the owner's
; 2026-10-02 rule: a pull request without the bee-reviewed label is NEVER merged).
; Measured 2026-10-26/27: the fix sessions behind trinity #1763, #1766, #1769 and
; #1773 spent roughly forty minutes each in sleep-poll cycles over checks that
; passed -- pure queue, not work. The machinery to leave already runs; this card
; names the protocol so the next agent uses it.
; There is no SKILL.md behind this card yet, so it is spec-only (see "Witness
; labels" in specs/skills/README.md).
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_trinity_land_and_leave;

pub const KIND : str = "skill";
pub const ID : str = "trinity/land-and-leave";
pub const NAME : str = "Land and Leave";
pub const REPO : str = "trinity";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Hand a green pull request to the swarm and walk away: the reviewer bee labels it, auto-merge dispatches its missing work-report check and squash-merges the bee-reviewed head within ten minutes, so an agent never sleeps in a polling loop over checks that pass.";
pub const COMMAND : str = "";
; The law this skill stands on: the auto-merge sweep and its rules.
pub const SPECS : [1]str = ["specs/crons/trinity-auto-merge.t27"];
pub const TAGS : [4]str = ["ci", "auto-merge", "reviewer-bee", "workflow"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test id_is_repo_and_slug {
    assert KIND == "skill";
    assert ID == REPO + "/land-and-leave";
}
test the_card_stands_on_the_auto_merge_law {
    assert SPECS.len == 1;
    assert SPECS[0] == "specs/crons/trinity-auto-merge.t27";
    assert ENABLED == true;
    assert COMMAND == "";
}
