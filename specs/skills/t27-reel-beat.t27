; specs/skills/t27-reel-beat.t27 -- skill t27/reel-beat
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/reel-beat).
; How TRI CLAW cuts a lesson reel on the beat: LR_MODE=4 crossfades the open, main and close
; scene clips at the beat clock's cuts, on whole frames, and LR_MODE=5 lays mode 3's captions,
; cards and address over that video. Mode 5's inputs are 0..2 the scene clips, 3..5 the
; phrases' wavs and 6 the music. The law lives once, in specs/t27f/lesson_reel.t27 (beat_*
; functions and their tests); this card points at it and copies none. The scene clips are
; inputs the content factory's scene plan chooses: lesson_reel's scene_for_lesson(t, slot)
; names the archetype reel_factory's scoring picks for the lesson; the factory plans one
; archetype per lesson, so all three beat slots share it, and the beat clock still cuts on
; whole frames regardless of the scene identity (t27#11678). An item the scoring places
; nowhere keeps the three fixed clips: scene_for_arch lays slot 0..2 itself when the pick is
; ARCHS. What the plan still does not cover -- renderers for the planned archetype clips --
; stays R3 in lesson_reel.t27 and t27#10560. There is no SKILL.md
; behind it yet, so the card is spec-only (see "Witness labels" in specs/skills/README.md).
; Issues gHashTag/t27#10603, gHashTag/t27#10609 and
; gHashTag/t27#11678, epic gHashTag/t27#10560.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_reel_beat;

pub const KIND : str = "skill";
pub const ID : str = "t27/reel-beat";
pub const NAME : str = "Reel Beat";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Cut a 15 second lesson reel on the beat clock: crossfade the open, main and close scenes at whole-frame cuts that never fall inside a spoken phrase, lay the captions and address on top, and refuse a voice that does not fit";
pub const COMMAND : str = "/reel-beat";
; Spec this skill stands on: the beat clock and the graph printer.
pub const SPECS : [1]str = ["specs/t27f/lesson_reel.t27"];
pub const TAGS : [4]str = ["social-visual", "reel", "beat", "t27f"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/reel-beat";
    assert NAME == "Reel Beat";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/reel-beat";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 4;
    assert TAGS[0] == "social-visual";
    assert TAGS[2] == "beat";
    assert SPECS.len == 1;
    assert SPECS[0] == "specs/t27f/lesson_reel.t27";
}
