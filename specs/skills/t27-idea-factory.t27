// SPDX-License-Identifier: Apache-2.0
; specs/skills/t27-idea-factory.t27 -- skill t27/idea-factory
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/idea-factory).
; How TRI CLAW unpacks any idea in any style preset of the particle design system: the input
; is (idea, preset); the idea is UTF-8 text, a `|` cuts a scene, lines wrap at 9 characters
; and 4 lines a scene, and the closing scene is the address T27.AI. Every letter, card and
; glow on screen is a particle that springs to a target in glyph57's 5x7 Latin and Cyrillic
; font. The output is 1080x1920 frames at 30 fps, 72 frames a scene.
; The law lives once, in specs/t27f/idea_factory.t27 (wrap, layout, assign), in
; specs/t27f/glyph57.t27 (UTF-8 and the font) and in specs/t27f/particle_ds.t27 (presets,
; laws, tone); this card points at them and copies none. PRESETS below is a name list for
; the agent, in the order of particle_ds.PRESET_NAMES; cards import nothing, so the lab
; check compares the two byte for byte.
; A Russian idea is a u8 array of its UTF-8 bytes (idea_factory.RU_IDEA): t27c keeps
; "\xNN" in a string as four characters, and L3 keeps sources ASCII.
; NOT CLAIMED: no voice or music (lesson_reel mode 5 has those), capitals only (lower case
; folds), and the Verilog is emitted, not synthesised. There is no SKILL.md behind it yet,
; so the card is spec-only (see "Witness labels" in specs/skills/README.md). Issues
; gHashTag/t27#10771, gHashTag/t27#10788 and gHashTag/t27#10796, epic gHashTag/t27#10560.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_idea_factory;

pub const KIND : str = "skill";
pub const ID : str = "t27/idea-factory";
pub const NAME : str = "Idea Factory";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Unpack any idea, Latin or Russian, into a 1080x1920 particle reel in one of five style presets: every letter, card and glow is a particle springing into a 5x7 font, a bar cuts a scene, and the reel closes on the address";
pub const COMMAND : str = "/idea-factory";
; Specs this skill stands on: the factory, its font and its particle design system.
pub const SPECS : [3]str = ["specs/t27f/idea_factory.t27", "specs/t27f/glyph57.t27", "specs/t27f/particle_ds.t27"];
; The five presets, index = the preset number idea_factory takes.
pub const PRESETS : [5]str = ["noir-gold", "neon-vortex", "trit-charge", "paper-ink", "rain"];
pub const TAGS : [5]str = ["social-visual", "reel", "factory", "particles", "t27f"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/idea-factory";
    assert NAME == "Idea Factory";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/idea-factory";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 5;
    assert TAGS[0] == "social-visual";
    assert TAGS[2] == "factory";
    assert SPECS.len == 3;
    assert SPECS[0] == "specs/t27f/idea_factory.t27";
    assert SPECS[1] == "specs/t27f/glyph57.t27";
    assert SPECS[2] == "specs/t27f/particle_ds.t27";
}

test presets_in_preset_number_order {
    assert PRESETS.len == 5;
    assert PRESETS[0] == "noir-gold";
    assert PRESETS[1] == "neon-vortex";
    assert PRESETS[2] == "trit-charge";
    assert PRESETS[3] == "paper-ink";
    assert PRESETS[4] == "rain";
}
