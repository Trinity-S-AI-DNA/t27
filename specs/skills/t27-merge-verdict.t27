// Source of truth for the skill card on t27.ai (#/skills?skill=t27/merge-verdict).
// The skill body lives in gHashTag/t27 at .claude/skills/merge-verdict/SKILL.md
; Restores MERGE_QUEUE_V2 (owner 2026-11-10): pointer at specs/claw/merge_verdict.t27.
// phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_merge_verdict;

pub const KIND : str = "skill";
pub const ID : str = "t27/merge-verdict";
pub const NAME : str = "Merge verdict (MERGE_QUEUE_V2)";
pub const REPO : str = "t27";
pub const SOURCE : str = "SKILL.md";
pub const SUMMARY_EN : str = "Event-driven merge subagent: evaluate ClawMergeVerdict (seven conditions), emit one M-line verdict, squash-merge only on MERGE_NOW when the session owns the PR. Sonnet or Composer 2.5; no tight polling.";
pub const COMMAND : str = "/merge-verdict";
pub const SPECS : [5]str = ["specs/claw/merge_verdict.t27", "specs/claw/red_origin.t27", "specs/claw/ledger_union.t27", "specs/claw/merge_judge.t27", "specs/claw/model_route.t27"];
pub const TAGS : [5]str = ["claw", "merge", "ci", "subscribe", "t27"];
pub const ENABLED : bool = true;
pub const TIMEOUT_MIN : u16 = 15;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/merge-verdict";
    assert NAME == "Merge verdict (MERGE_QUEUE_V2)";
    assert REPO == "t27";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 15;
    assert SPECS.len == 5;
    assert SPECS[0] == "specs/claw/merge_verdict.t27";
    assert TAGS[0] == "claw";
}

test negative_control_refutes_wrong_id {
    assert(ID != "t27/pareto-improvement-loop");
}
