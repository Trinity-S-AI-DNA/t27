; Law: specs/claw/merge_verdict.t27, specs/claw/merge_judge.t27
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_merge_queue;

pub const KIND : str = "skill";
pub const ID : str = "t27/merge-queue";
pub const NAME : str = "Merge queue";
pub const REPO : str = "t27";
pub const SOURCE : str = "SKILL.md";
pub const SUMMARY_EN : str = "MERGE_QUEUE_V2: event-driven merge subagent on Composer 2.5 or Sonnet, seven conditions from merge_verdict.t27, machine-readable M-lines, ledger-line inherited reds, no tight polling.";
pub const COMMAND : str = "/merge-queue [pr-number | sweep]";
pub const SPECS : [4]str = [
    "specs/claw/merge_verdict.t27",
    "specs/claw/merge_judge.t27",
    "specs/claw/red_origin.t27",
    "specs/queen/merger_gate.t27",
];
pub const TAGS : [4]str = ["claw", "merge", "ci", "subagent"];
pub const ENABLED : bool = true;
pub const TIMEOUT_MIN : u16 = 45;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/merge-queue";
    assert NAME == "Merge queue";
    assert REPO == "t27";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 45;
    assert SPECS.len == 4;
    assert TAGS.len == 4;
    assert COMMAND.len > 0;
}

test negative_control_refutes_wrong_id {
    assert(ID != "t27/merge-judge");
}
