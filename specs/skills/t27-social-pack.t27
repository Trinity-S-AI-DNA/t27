// SPDX-License-Identifier: Apache-2.0
; specs/skills/t27-social-pack.t27 -- skill t27/social-pack
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/social-pack).
; How TRI CLAW turns one idea into one post, in order: pick the format (the format card),
; render the reel with the idea factory, take the cover still, weigh the caption against
; its channel, run the uniqueness gate, then wait for the owner's explicit yes. Nothing is
; published without that yes -- the consent card is the last step, not a formality.
; The law lives once, in the five cards this one strings together -- t27/social-visual-format,
; t27/social-visual-scene, t27/social-visual-gate, t27/social-visual-consent and
; t27/reel-beat -- and in the specs they point at; this card copies none of it.
; Pending, not done: the caption rule is its own spec (specs/t27f/post_caption.t27,
; gHashTag/t27#10916, open PR) -- until it lands the caption check stays by eye. The cover
; still itself landed (COVER=1, gHashTag/t27#10830; the cover's scene choice is #11028, open).
; There is no SKILL.md behind it yet, so the card is spec-only (see "Witness labels" in
; specs/skills/README.md). Issue gHashTag/t27#10917, epic gHashTag/t27#10915.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_social_pack;

pub const KIND : str = "skill";
pub const ID : str = "t27/social-pack";
pub const NAME : str = "Social Pack";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "Turn one idea into one post: pick the format, render the reel with the idea factory, take the cover still, weigh the caption against its channel, run the uniqueness gate, and wait for the owner's explicit yes before anything is published";
pub const COMMAND : str = "/social-pack";
; Specs this skill stands on: the reel renderer and the lesson reel's caption chunks.
pub const SPECS : [2]str = ["specs/t27f/idea_factory.t27", "specs/t27f/lesson_reel.t27"];
pub const TAGS : [3]str = ["social-visual", "t27f", "post"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/social-pack";
    assert NAME == "Social Pack";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/social-pack";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 3;
    assert TAGS[0] == "social-visual";
    assert TAGS[1] == "t27f";
    assert SPECS.len == 2;
    assert SPECS[0] == "specs/t27f/idea_factory.t27";
    assert SPECS[1] == "specs/t27f/lesson_reel.t27";
}
