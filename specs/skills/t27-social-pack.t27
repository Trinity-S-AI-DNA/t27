; specs/skills/t27-social-pack.t27 -- skill t27/social-pack
; Source of truth for the skill card on t27.ai (#/skills?skill=t27/social-pack).
; One idea to a post, in six steps, each behind a spec or a sibling card the agent already has:
;   1. pick the format   -- card t27/social-visual-format
;   2. render the reel    -- card t27/idea-factory, specs/t27f/idea_factory.t27
;   3. take the cover     -- PENDING: the cover still is PR #10830 (COVER=1); this card names it
;                           as pending, not as done
;   4. check the caption  -- PENDING: the caption rule is its own sub-issue of gHashTag/t27#10915
;                           (specs/t27f/post_caption.t27); named here as pending
;   5. run the gate       -- cards t27/social-visual-gate and t27/reel-beat
;   6. wait for the yes   -- card t27/social-visual-consent; nothing is published without the
;                           owner's explicit yes
; The five sibling cards this one orders, by ID: t27/social-visual-format, t27/social-visual-scene,
; t27/social-visual-gate, t27/social-visual-consent, t27/reel-beat. The law lives once, in
; specs/t27f/idea_factory.t27 and specs/t27f/lesson_reel.t27; this card points at them and copies
; none. There is no SKILL.md behind it yet, so the card is spec-only (see "Witness labels" in
; specs/skills/README.md). Issue gHashTag/t27#10917, epic gHashTag/t27#10915.
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_social_pack;

pub const KIND : str = "skill";
pub const ID : str = "t27/social-pack";
pub const NAME : str = "Social Pack";
pub const REPO : str = "t27";
; No SKILL.md exists for this card.
pub const SOURCE : str = "";
pub const SUMMARY_EN : str = "One idea to a post in six steps: pick the format, render the reel with the idea factory, take the cover still, check the caption, run the uniqueness gate, then wait -- nothing is published without the owner's explicit yes";
pub const COMMAND : str = "/social-pack";
; Specs this skill stands on: the idea factory and the reel it renders into.
pub const SPECS : [2]str = ["specs/t27f/idea_factory.t27", "specs/t27f/lesson_reel.t27"];
pub const TAGS : [3]str = ["social-visual", "t27f", "post"];
pub const ENABLED : bool = true;
; Default budget; no SKILL.md declares a timeout.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/social-pack";
    assert NAME == "Social Pack";
    assert REPO == "t27";
    assert SOURCE == "";
    assert COMMAND == "/social-pack";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS.len == 3;
    assert TAGS[0] == "social-visual";
    assert TAGS[1] == "t27f";
    assert SPECS.len == 2;
    assert SPECS[0] == "specs/t27f/idea_factory.t27";
    assert SPECS[1] == "specs/t27f/lesson_reel.t27";
}
