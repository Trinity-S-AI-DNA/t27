    var result : Hypervector = undefined;
    for (0..100) |_| {
        result = encode_sequence(&items, DEFAULT_DIM);
    }
    _ = result;
}

bench "vsa_dot_similarity_latency" {
    // Measure: cycles for dot similarity (dim=1024)
    // Target: < 5000 cycles
