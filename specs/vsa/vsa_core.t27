// SPDX-License-Identifier: Apache-2.0
// t27/specs/vsa/vsa_core.t27
// VSA (Vector Symbolic Architecture) Core Operations
// ⲤⲀⲔⲢⲀ ⲪⲞⲢⲘⲨⲖⲀ: V = n × 3^k × π^m × φ^p × e^q
// φ² + 1/φ² = 3 | TRINITY
//
// VSA provides high-dimensional vector operations for:
// - Symbolic reasoning (bind/unbind for role-filler pairs)
// - Set operations (bundle for superposition)
// - Similarity search (cosine, hamming, dot product)
// - Sequence encoding (permute for position)
//
// Key properties:
// - bind(a, bind(a, b)) = b (self-inverse for XOR-like binding)
// - bundle is used for set-like superposition
// - permute provides position-aware encoding

module vsa_core;

// ============================================================================
// Constants
// ============================================================================

/// Default VSA dimension (hypervector size)
pub const DEFAULT_DIM : usize = 1024;

/// SIMD width for parallel trit operations
pub const SIMD_WIDTH : usize = 32;

/// Maximum trits per hypervector
pub const MAX_TRITS : usize = 256;

/// Cosine similarity threshold for "match"
pub const COSINE_THRESHOLD : f64 = 0.7;

/// Hamming similarity threshold for "match"
pub const HAMMING_THRESHOLD : f64 = 0.8;

// ============================================================================
// Types
// ============================================================================

/// A trit is a small signed integer holding -1, 0 or +1. (The enum Trit of
/// base::types does not support the arithmetic these operations need, and the
/// backend cannot resolve that import, so the trit is declared here.)
pub const Trit = i8;

pub const TRIT_NEG : i8 = -1;
pub const TRIT_ZERO : i8 = 0;
pub const TRIT_POS : i8 = 1;

/// Hypervector representation (slice of trits)
pub const Hypervector = []Trit;

/// Search result with similarity score
pub const SearchResult = struct {
    index : usize,
    similarity : f64,
};

// ============================================================================
// Result storage
// ============================================================================

// The operations that return a new hypervector write it into this module-level
// arena and return a slice of it. A returned vector stays valid until the arena
// wraps around, which happens after ARENA_SIZE trits of new results.
// Every operation also has an _into / _fill form that writes into a buffer the
// caller owns; the arena forms are thin wrappers around them.

pub const ARENA_SIZE : usize = 32768;
var arena : [32768]i8 = undefined;
var arena_len : usize = 0;

/// Reserve len trits in the arena and return the offset of the reservation
fn arena_reserve(len: usize) usize {
    if (arena_len + len > ARENA_SIZE) {
        arena_len = 0;
    }
    // (Written without a local copy of arena_len: the backend inlines the copy
    // and would return the advanced value.)
    arena_len = arena_len + len;
    return arena_len - len;
}

/// A vector of dim zero trits, stored in the arena
fn arena_zeros(dim: usize) Hypervector {
    var start = arena_reserve(dim);
    var i : usize = 0;
    while (i < dim) {
        arena[start + i] = TRIT_ZERO;
        i = i + 1;
    }
    return arena[start .. start + dim];
}

/// Set every trit of v to value
pub fn fill_trits(v: []Trit, value: Trit) void {
    var i : usize = 0;
    while (i < v.len) {
        v[i] = value;
        i = i + 1;
    }
}

// ============================================================================
// Core VSA Operations
// ============================================================================

/// Fill out with deterministic pseudo-random trits derived from seed
/// A 31-bit LCG, so the 64-bit product never overflows
/// Complexity: O(out.len)
pub fn random_fill(seed: u64, out: []Trit) void {
    var rng : u64 = seed % 2147483648;

    var i : usize = 0;
    while (i < out.len) {
        // Simple LCG for deterministic random
        rng = (rng * 1103515245 + 12345) % 2147483648;
        const r : u64 = (rng / 65536) % 3;
        const trit_val : i8 = @intCast(r);
        out[i] = trit_val - 1;  // Map 0,1,2 to -1,0,1
        i = i + 1;
    }
}

/// Generate random hypervector with given seed
/// Uses deterministic random number generation
/// Complexity: O(dim)
pub fn random_vector(seed: u64, dim: usize) Hypervector {
    var start = arena_reserve(dim);
    random_fill(seed, arena[start .. start + dim]);
    return arena[start .. start + dim];
}

/// Bind a and b into out (out.len >= min(a.len, b.len))
pub fn bind_into(a: []Trit, b: []Trit, out: []Trit) void {
    const dim = @min(a.len, b.len);

    var i : usize = 0;
    while (i < dim) {
        const ai = a[i];
        const bi = b[i];

        if (ai == TRIT_ZERO) {
            out[i] = bi;
        } else if (bi == TRIT_ZERO) {
            out[i] = ai;
        } else {
            // Both non-zero: multiply (both are +-1)
            out[i] = if (ai == bi) { TRIT_POS } else { TRIT_NEG };
        }
        i = i + 1;
    }
}

/// Bind operation (XOR-like for associative memory)
/// Property: bind(a, bind(a, b)) = b wherever b is non-zero (self-inverse)
/// Used for: role-value binding, symbolic reasoning
/// Complexity: O(dim)
pub fn bind(a: Hypervector, b: Hypervector) Hypervector {
    const dim = @min(a.len, b.len);
    var start = arena_reserve(dim);
    bind_into(a, b, arena[start .. start + dim]);
    return arena[start .. start + dim];
}

/// Unbind operation (inverse of bind)
/// For XOR-like binding: unbind(x, y) = bind(x, y)
/// Complexity: O(dim)
pub fn unbind(bound: Hypervector, key: Hypervector) Hypervector {
    return bind(bound, key);
}

/// Bundle two vectors into out (out.len >= min(a.len, b.len))
pub fn bundle2_into(a: []Trit, b: []Trit, out: []Trit) void {
    const dim = @min(a.len, b.len);

    var i : usize = 0;
    while (i < dim) {
        const ai = a[i];
        const bi = b[i];

        if (ai == TRIT_ZERO) {
            out[i] = bi;
        } else if (bi == TRIT_ZERO) {
            out[i] = ai;
        } else {
            // Both non-zero: determine majority
            const sum = ai + bi;
            out[i] = if (sum > 0) { TRIT_POS }
                     else if (sum < 0) { TRIT_NEG }
                     else { TRIT_ZERO };
        }
        i = i + 1;
    }
}

/// Bundle2 operation (majority vote of 2 vectors)
/// Used for: superposition, set union
/// Complexity: O(dim)
pub fn bundle2(a: Hypervector, b: Hypervector) Hypervector {
    const dim = @min(a.len, b.len);
    var start = arena_reserve(dim);
    bundle2_into(a, b, arena[start .. start + dim]);
    return arena[start .. start + dim];
}

/// Bundle three vectors into out (out.len >= min(a.len, b.len, c.len))
pub fn bundle3_into(a: []Trit, b: []Trit, c: []Trit, out: []Trit) void {
    const dim = @min(@min(a.len, b.len), c.len);

    var i : usize = 0;
    while (i < dim) {
        const sum = a[i] + b[i] + c[i];
        out[i] = if (sum > 0) { TRIT_POS }
                 else if (sum < 0) { TRIT_NEG }
                 else { TRIT_ZERO };
        i = i + 1;
    }
}

/// Bundle3 operation (majority vote of 3 vectors)
/// Used for: robust superposition, noise reduction
/// Complexity: O(dim)
pub fn bundle3(a: Hypervector, b: Hypervector, c: Hypervector) Hypervector {
    const dim = @min(@min(a.len, b.len), c.len);
    var start = arena_reserve(dim);
    bundle3_into(a, b, c, arena[start .. start + dim]);
    return arena[start .. start + dim];
}

/// Circular shift of v into out (out.len == v.len)
pub fn permute_into(v: []Trit, shift: usize, out: []Trit) void {
    if (v.len == 0) {
        return;
    }

    const effective_shift = shift % v.len;

    var i : usize = 0;
    while (i < v.len) {
        out[(i + effective_shift) % v.len] = v[i];
        i = i + 1;
    }
}

/// Permute operation (circular shift of hypervector)
/// Used for: sequence encoding, position tagging
/// Complexity: O(dim)
pub fn permute(v: Hypervector, shift: usize) Hypervector {
    if (v.len == 0) {
        return v;
    }

    const effective_shift = shift % v.len;
    if (effective_shift == 0) {
        return v;
    }

    var start = arena_reserve(v.len);
    permute_into(v, shift, arena[start .. start + v.len]);
    return arena[start .. start + v.len];
}

/// Circular shift of v in the opposite direction into out (out.len == v.len)
pub fn inverse_permute_into(v: []Trit, shift: usize, out: []Trit) void {
    if (v.len == 0) {
        return;
    }

    const effective_shift = shift % v.len;

    // Inverse shift is (len - shift) mod len
    const inverse_shift = (v.len - effective_shift) % v.len;
    permute_into(v, inverse_shift, out);
}

/// Inverse permute (circular shift in opposite direction)
/// Property: inverse_permute(permute(v, n), n) = v
/// Complexity: O(dim)
pub fn inverse_permute(v: Hypervector, shift: usize) Hypervector {
    if (v.len == 0) {
        return v;
    }

    const effective_shift = shift % v.len;
    if (effective_shift == 0) {
        return v;
    }

    // Inverse shift is (len - shift) mod len
    const inverse_shift = (v.len - effective_shift) % v.len;
    return permute(v, inverse_shift);
}

/// Cosine similarity between two hypervectors
/// Formula: (a·b) / (||a|| * ||b||)
/// Range: [-1, 1] where 1 = identical, -1 = opposite
/// Complexity: O(dim)
pub fn cosine_similarity(a: Hypervector, b: Hypervector) f64 {
    const dim = @min(a.len, b.len);

    // Compute dot product
    var dot : i64 = 0;
    var i : usize = 0;
    while (i < dim) {
        dot = dot + @as(i64, a[i]) * @as(i64, b[i]);
        i = i + 1;
    }

    // Compute norms
    var norm_a : f64 = 0.0;
    var norm_b : f64 = 0.0;
    i = 0;
    while (i < dim) {
        if (a[i] != TRIT_ZERO) {
            norm_a = norm_a + 1.0;
        }
        if (b[i] != TRIT_ZERO) {
            norm_b = norm_b + 1.0;
        }
        i = i + 1;
    }

    if (norm_a == 0.0 or norm_b == 0.0) {
        return 0.0;
    }

    // ||a|| * ||b|| = sqrt(count_a * count_b). Taking one square root of the
    // product keeps identical and opposite vectors at exactly +1 and -1;
    // sqrt(n) * sqrt(n) is not exactly n in floating point (for n = 10).
    return @as(f64, @floatFromInt(dot)) / @sqrt(norm_a * norm_b);
}

/// Hamming distance between two hypervectors
/// Counts positions where trits differ
/// For unequal lengths, adds the difference in length
/// Complexity: O(min(len(a), len(b)))
pub fn hamming_distance(a: Hypervector, b: Hypervector) usize {
    const len = @min(a.len, b.len);
    var distance : usize = 0;

    var i : usize = 0;
    while (i < len) {
        if (a[i] != b[i]) {
            distance = distance + 1;
        }
        i = i + 1;
    }

    // Add difference in length
    if (a.len > b.len) {
        distance = distance + (a.len - b.len);
    } else {
        distance = distance + (b.len - a.len);
    }

    return distance;
}

/// Hamming similarity (normalized to [0, 1])
/// Formula: 1 - (hamming_distance / max_length)
/// Complexity: O(min(len(a), len(b)))
pub fn hamming_similarity(a: Hypervector, b: Hypervector) f64 {
    const max_len = @max(a.len, b.len);
    if (max_len == 0) {
        return 1.0;
    }

    const distance = hamming_distance(a, b);
    return 1.0 - @as(f64, @floatFromInt(distance)) / @as(f64, @floatFromInt(max_len));
}

/// Dot product similarity (raw dot product, normalized by dimension)
/// Formula: (a·b) / dim
/// Range: [-1, 1] for unit trits
/// Complexity: O(dim)
pub fn dot_similarity(a: Hypervector, b: Hypervector) f64 {
    const dim = @min(a.len, b.len);
    if (dim == 0) {
        return 0.0;
    }

    var dot : i64 = 0;
    var i : usize = 0;
    while (i < dim) {
        dot = dot + @as(i64, a[i]) * @as(i64, b[i]);
        i = i + 1;
    }

    return @as(f64, @floatFromInt(dot)) / @as(f64, @floatFromInt(dim));
}

/// Vector norm (L2 norm)
/// Formula: sqrt(sum trit[i]^2)
/// For trits, this is sqrt(count of non-zero trits)
/// Complexity: O(dim)
pub fn vector_norm(v: Hypervector) f64 {
    var count : usize = 0;
    var i : usize = 0;
    while (i < v.len) {
        if (v[i] != TRIT_ZERO) {
            count = count + 1;
        }
        i = i + 1;
    }

    return @sqrt(@as(f64, @floatFromInt(count)));
}

/// Bundle N operation (generalized majority vote)
/// Iteratively applies bundle3 to all vectors
/// Complexity: O(n * dim)
pub fn bundle_n(vectors: []Hypervector, dim: usize) Hypervector {
    const count = vectors.len;
    if (count == 0) {
        return arena_zeros(dim);
    }
    if (count == 1) {
        return vectors[0];
    }
    if (count == 2) {
        return bundle2(vectors[0], vectors[1]);
    }

    var result = bundle3(vectors[0], vectors[1], vectors[2]);

    var i : usize = 3;
    while (i < count) {
        // Use bundle3 with result and next vector
        const temp = result;
        result = bundle3(temp, temp, vectors[i]);
        i = i + 1;
    }

    return result;
}

/// Count non-zero trits in hypervector
/// Used for: sparsity analysis, norm calculation
/// Complexity: O(dim)
pub fn count_non_zero(v: Hypervector) usize {
    var count : usize = 0;
    var i : usize = 0;
    while (i < v.len) {
        if (v[i] != TRIT_ZERO) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/// Encode sequence using position-aware binding
/// Each item is bound with its position (via permute)
/// Complexity: O(sequence_len * dim)
pub fn encode_sequence(items: []usize, dim: usize) Hypervector {
    var result = arena_zeros(dim);

    var i : usize = 0;
    while (i < items.len) {
        // Generate item vector (simplified - uses item value as seed)
        const item_vec = random_vector(@as(u64, @intCast(items[i])), dim);
        // Shift by position
        const shifted = permute(item_vec, i);
        // Add to result via bundle
        result = bundle2(result, shifted);
        i = i + 1;
    }

    return result;
}

/// Probe sequence for item at position
/// Checks if item is present at given position in encoded sequence
/// Complexity: O(dim)
pub fn probe_sequence(sequence: Hypervector, item: usize, position: usize, dim: usize) f64 {
    // Generate item vector
    const item_vec = random_vector(@as(u64, @intCast(item)), dim);
    // Shift to position
    const shifted = permute(item_vec, position);

    // Check similarity (should use cosine, but using dot for simplicity)
    const sim = dot_similarity(sequence, shifted);

    return sim;
}

// ============================================================================
// TDD - Tests
// ============================================================================

test "vsa_random_vector_dimension" {
    // Verify random vector has correct dimension
    const v1 = random_vector(42, 100);
    assert(v1.len == 100);

    const v2 = random_vector(123, 256);
    assert(v2.len == 256);
}

test "vsa_random_vector_deterministic" {
    // Verify random vector is deterministic (same seed = same result)
    const v1 = random_vector(42, 50);
    const v2 = random_vector(42, 50);
    assert(v1.len == v2.len);

    var i : usize = 0;
    while (i < v1.len) {
        assert(v1[i] == v2[i]);
        i = i + 1;
    }
    assert(hamming_distance(v1, v2) == 0);
}

test "vsa_bind_self_inverse" {
    // Verify bind(a, bind(a, b)) = b
    var a : [10]Trit = undefined;
    var b : [10]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_NEG);

    // Set some values
    a[0] = TRIT_POS;
    a[1] = TRIT_NEG;
    a[2] = TRIT_ZERO;

    b[0] = TRIT_NEG;
    b[1] = TRIT_POS;
    b[2] = TRIT_POS;

    const bound = bind(&a, &b);
    const unbound = unbind(bound, &a);

    // Check that unbound recovers b
    var match_count : usize = 0;
    var i : usize = 0;
    while (i < b.len) {
        if (unbound[i] == b[i]) {
            match_count = match_count + 1;
        }
        i = i + 1;
    }
    assert(match_count == b.len);
}

test "vsa_bind_zero_identity" {
    // Verify bind with zero acts as identity
    var a : [10]Trit = undefined;
    var zero : [10]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&zero, TRIT_ZERO);

    const result1 = bind(&a, &zero);
    const result2 = bind(&zero, &a);

    assert(result1.len == a.len);
    assert(result2.len == a.len);

    var i : usize = 0;
    while (i < a.len) {
        assert(result1[i] == a[i]);
        assert(result2[i] == a[i]);
        i = i + 1;
    }
}

test "vsa_bundle2_consensus" {
    // Verify bundle2 gives correct majority
    var a : [5]Trit = undefined;
    var b : [5]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_NEG);

    const result = bundle2(&a, &b);

    // POS + NEG = ZERO (tie, so zero)
    assert(result.len == 5);
    assert(result[0] == TRIT_ZERO);
    assert(result[1] == TRIT_ZERO);
}

test "vsa_bundle3_voting" {
    // Verify bundle3 does majority voting
    var a : [3]Trit = undefined;
    var b : [3]Trit = undefined;
    var c : [3]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_POS);
    fill_trits(&c, TRIT_NEG);

    const result = bundle3(&a, &b, &c);

    // POS + POS + NEG = POS (2 vs 1)
    assert(result.len == 3);
    assert(result[0] == TRIT_POS);
}

test "vsa_permute_shifts_correctly" {
    // Verify permute shifts elements correctly
    var v : [5]Trit = undefined;
    v[0] = TRIT_POS;
    v[1] = TRIT_NEG;
    v[2] = TRIT_ZERO;
    v[3] = TRIT_NEG;
    v[4] = TRIT_POS;

    const shifted = permute(&v, 1);

    assert(shifted[1] == TRIT_POS);    // v[0] moved to position 1
    assert(shifted[2] == TRIT_NEG);    // v[1] moved to position 2
    assert(shifted[3] == TRIT_ZERO);   // v[2] moved to position 3
    assert(shifted[4] == TRIT_NEG);    // v[3] moved to position 4
    assert(shifted[0] == TRIT_POS);    // v[4] wrapped to position 0
}

test "vsa_inverse_permute_reverses" {
    // Verify inverse_permute reverses permute
    var v : [10]Trit = undefined;

    var i : usize = 0;
    while (i < v.len) {
        const m : i8 = @intCast(i % 3);
        v[i] = m - 1;
        i = i + 1;
    }

    const shifted = permute(&v, 3);
    const restored = inverse_permute(shifted, 3);

    assert(restored.len == v.len);
    // The shift really moved something
    assert(hamming_distance(shifted, &v) > 0);

    i = 0;
    while (i < v.len) {
        assert(restored[i] == v[i]);
        i = i + 1;
    }
}

test "vsa_cosine_identical" {
    // Verify cosine similarity is 1.0 for identical vectors
    var v : [10]Trit = undefined;
    fill_trits(&v, TRIT_POS);
    v[0] = TRIT_POS;
    v[1] = TRIT_NEG;
    v[2] = TRIT_ZERO;

    const sim = cosine_similarity(&v, &v);
    assert(sim == 1.0);
}

test "vsa_cosine_opposite" {
    // Verify cosine similarity is -1.0 for opposite vectors
    var a : [10]Trit = undefined;
    var b : [10]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_NEG);

    var i : usize = 0;
    while (i < a.len) {
        b[i] = 0 - a[i];
        i = i + 1;
    }

    const sim = cosine_similarity(&a, &b);
    assert(sim == -1.0);
}

test "vsa_cosine_orthogonal" {
    // Verify cosine similarity is 0.0 for orthogonal vectors
    var a : [10]Trit = undefined;
    var b : [10]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_ZERO);

    // The only non-zero trit of b is at position 5, and a is zero there,
    // so the supports are disjoint and the dot product is zero.
    a[5] = TRIT_ZERO;
    b[5] = TRIT_NEG;

    const sim = cosine_similarity(&a, &b);
    assert(@abs(sim) < 0.5);
    assert(sim == 0.0);
}

test "vsa_hamming_distance_identical" {
    // Verify hamming distance is 0 for identical vectors
    var v : [10]Trit = undefined;
    fill_trits(&v, TRIT_POS);

    const dist = hamming_distance(&v, &v);
    assert(dist == 0);
}

test "vsa_hamming_distance_opposite" {
    // Verify hamming distance for all-different vectors
    var a : [10]Trit = undefined;
    var b : [10]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_NEG);

    const dist = hamming_distance(&a, &b);
    assert(dist == 10);
}

test "vsa_hamming_similarity" {
    // Verify hamming similarity is inverse of distance (normalized)
    var a : [10]Trit = undefined;
    var b : [10]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_NEG);

    const dist = hamming_distance(&a, &b);
    const sim = hamming_similarity(&a, &b);

    assert(sim == 1.0 - @as(f64, @floatFromInt(dist)) / 10.0);
    assert(sim == 0.0);
}

test "vsa_dot_similarity" {
    // Verify dot similarity for known vectors
    var a : [3]Trit = undefined;
    var b : [3]Trit = undefined;
    fill_trits(&a, TRIT_POS);
    fill_trits(&b, TRIT_POS);

    const sim = dot_similarity(&a, &b);
    assert(sim == 1.0);  // All same = 1.0
}

test "vsa_vector_norm_all_zero" {
    // Verify norm of zero vector is 0
    var v : [10]Trit = undefined;
    fill_trits(&v, TRIT_ZERO);

    const norm = vector_norm(&v);
    assert(norm == 0.0);
}

test "vsa_vector_norm_all_positive" {
    // Verify norm of all-positive vector is sqrt(len)
    var v : [10]Trit = undefined;
    fill_trits(&v, TRIT_POS);

    const norm = vector_norm(&v);
    assert(norm == @sqrt(10.0));
}

test "vsa_count_non_zero" {
    // Verify count_non_zero returns correct count
    var v : [5]Trit = undefined;
    v[0] = TRIT_POS;
    v[1] = TRIT_NEG;
    v[2] = TRIT_ZERO;
    v[3] = TRIT_POS;
    v[4] = TRIT_POS;
    const expected : usize = 4;

    const count = count_non_zero(&v);
    assert(count == expected);
}

test "vsa_encode_sequence" {
    // Verify sequence encoding produces non-zero result
    var items : [3]usize = undefined;
    items[0] = 1;
    items[1] = 2;
    items[2] = 3;

    const encoded = encode_sequence(&items, 100);

    // Result should have some non-zero values
    assert(encoded.len == 100);
    var non_zero : usize = 0;
    var i : usize = 0;
    while (i < encoded.len) {
        if (encoded[i] != TRIT_ZERO) {
            non_zero = non_zero + 1;
        }
        i = i + 1;
    }
    assert(non_zero > 0);
}

test "vsa_probe_sequence" {
    // Verify probe_sequence detects item at position
    var items : [2]usize = undefined;
    items[0] = 42;
    items[1] = 123;
    const encoded = encode_sequence(&items, 100);

    // Probe for item 42 at position 0
    const sim = probe_sequence(encoded, 42, 0, 100);
    // Should have some similarity (exact match would be 1.0)
    assert(sim > 0.0);
}

test "vsa_bundle_n_single_vector" {
    // Verify bundle_n with single vector returns that vector
    var v : [10]Trit = undefined;
    fill_trits(&v, TRIT_POS);

    var vectors : [1]Hypervector = undefined;
    vectors[0] = &v;

    const result = bundle_n(&vectors, 10);
    assert(result.len == 10);
    assert(result[0] == TRIT_POS);
}

test "vsa_bundle_n_consistency" {
    // Verify bundle_n is consistent with iterated bundle3
    var v1 : [5]Trit = undefined;
    var v2 : [5]Trit = undefined;
    var v3 : [5]Trit = undefined;
    var v4 : [5]Trit = undefined;
    fill_trits(&v1, TRIT_POS);
    fill_trits(&v2, TRIT_NEG);
    fill_trits(&v3, TRIT_ZERO);
    fill_trits(&v4, TRIT_POS);

    var vectors : [4]Hypervector = undefined;
    vectors[0] = &v1;
    vectors[1] = &v2;
    vectors[2] = &v3;
    vectors[3] = &v4;

    // Using bundle_n
    const result1 = bundle_n(&vectors, 5);

    // Using iterative bundle3
    var result2 = bundle3(&v1, &v2, &v3);
    result2 = bundle3(result2, result2, &v4);

    assert(result1.len == result2.len);

    var i : usize = 0;
    while (i < result1.len) {
        assert(result1[i] == result2[i]);
        // POS + NEG + ZERO cancels to zero, then the fourth vector (POS) decides
        assert(result1[i] == TRIT_POS);
        i = i + 1;
    }
}

// ============================================================================
// TDD - Invariants
// ============================================================================

// Invariants are evaluated at compile time, so they use the _into / _fill
// forms on local buffers (the arena is runtime state).

invariant vsa_bind_self_inverse_property {
    // bind(a, bind(a, b)) = b at every position where b is non-zero
    // (where b is zero and a is not, bind returns a, and a * a = +1)
    @setEvalBranchQuota(100000);
    var a : [50]Trit = undefined;
    var b : [50]Trit = undefined;
    var bound : [50]Trit = undefined;
    var unbound : [50]Trit = undefined;
    random_fill(1, &a);
    random_fill(2, &b);
    bind_into(&a, &b, &bound);
    bind_into(&bound, &a, &unbound);

    var ok : bool = true;
    var checked : usize = 0;
    var i : usize = 0;
    while (i < 50) {
        if (b[i] != TRIT_ZERO) {
            checked = checked + 1;
            if (unbound[i] != b[i]) {
                ok = false;
            }
        }
        i = i + 1;
    }
    @compileAssert(ok);
    @compileAssert(checked > 0);
}

invariant vsa_bind_commutative {
    // bind(a, b) = bind(b, a) for all a, b
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    var result1 : [100]Trit = undefined;
    var result2 : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    bind_into(&v1, &v2, &result1);
    bind_into(&v2, &v1, &result2);
    @compileAssert(hamming_distance(&result1, &result2) == 0);
}

invariant vsa_bundle2_commutative {
    // bundle2(a, b) = bundle2(b, a) for all a, b
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    var result1 : [100]Trit = undefined;
    var result2 : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    bundle2_into(&v1, &v2, &result1);
    bundle2_into(&v2, &v1, &result2);
    @compileAssert(hamming_distance(&result1, &result2) == 0);
}

invariant vsa_bundle3_associative {
    // Majority vote is not exactly associative (the comparison of
    // bundle3(a, b, c) with the chained form used by bundle_n is only
    // approximate). What holds exactly: wherever all three inputs agree,
    // both forms return that value.
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    var v3 : [100]Trit = undefined;
    var inner : [100]Trit = undefined;
    var result1 : [100]Trit = undefined;
    var result2 : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    random_fill(3, &v3);
    bundle3_into(&v1, &v2, &v3, &result1);
    bundle2_into(&v1, &v2, &inner);
    bundle3_into(&inner, &inner, &v3, &result2);

    var ok : bool = true;
    var agreeing : usize = 0;
    var i : usize = 0;
    while (i < 100) {
        if (v1[i] == v2[i] and v2[i] == v3[i]) {
            agreeing = agreeing + 1;
            if (result1[i] != v1[i] or result2[i] != v1[i]) {
                ok = false;
            }
        }
        i = i + 1;
    }
    @compileAssert(ok);
    @compileAssert(agreeing > 0);
}

invariant vsa_permute_twice_returns_original {
    // permute(permute(v, n), n) != v in general (it's a shift)
    // But permute(v, len) returns to v
    @setEvalBranchQuota(100000);
    var v : [100]Trit = undefined;
    var shifted : [100]Trit = undefined;
    var shifted_twice : [100]Trit = undefined;
    random_fill(42, &v);
    permute_into(&v, 100, &shifted);
    permute_into(&shifted, 100, &shifted_twice);
    @compileAssert(hamming_distance(&shifted_twice, &v) == 0);
}

invariant vsa_inverse_permute_reverses_permute {
    // inverse_permute(permute(v, n), n) = v for all v, n
    @setEvalBranchQuota(100000);
    var v : [100]Trit = undefined;
    var shifted : [100]Trit = undefined;
    var restored : [100]Trit = undefined;
    random_fill(42, &v);
    permute_into(&v, 5, &shifted);
    inverse_permute_into(&shifted, 5, &restored);
    @compileAssert(hamming_distance(&restored, &v) == 0);
    @compileAssert(hamming_distance(&shifted, &v) > 0);
}

invariant vsa_cosine_symmetric {
    // cosine_similarity(a, b) = cosine_similarity(b, a)
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    const sim1 = cosine_similarity(&v1, &v2);
    const sim2 = cosine_similarity(&v2, &v1);
    @compileAssert(sim1 == sim2);
}

invariant vsa_cosine_range {
    // cosine_similarity result is in [-1, 1]
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    const sim = cosine_similarity(&v1, &v2);
    @compileAssert(sim >= -1.0 and sim <= 1.0);
}

invariant vsa_hamming_distance_symmetric {
    // hamming_distance(a, b) = hamming_distance(b, a)
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    const dist1 = hamming_distance(&v1, &v2);
    const dist2 = hamming_distance(&v2, &v1);
    @compileAssert(dist1 == dist2);
}

invariant vsa_hamming_distance_range {
    // hamming_distance result is in [0, max(len(a), len(b))]
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    const dist = hamming_distance(&v1, &v2);
    @compileAssert(dist <= @max(v1.len, v2.len));
}

invariant vsa_hamming_similarity_increases_with_distance {
    // hamming_similarity decreases as hamming_distance increases
    // (indirectly tested by: sim = 1 - dist/max)
    @setEvalBranchQuota(100000);
    var a : [100]Trit = undefined;
    var b : [100]Trit = undefined;
    random_fill(1, &a);
    random_fill(2, &b);
    const dist = hamming_distance(&a, &b);
    const sim = hamming_similarity(&a, &b);
    @compileAssert(@abs(sim - (1.0 - @as(f64, @floatFromInt(dist)) / 100.0)) < 0.01);
}

invariant vsa_vector_norm_non_negative {
    // vector_norm is always >= 0
    @setEvalBranchQuota(100000);
    var v : [100]Trit = undefined;
    random_fill(1, &v);
    const norm = vector_norm(&v);
    @compileAssert(norm >= 0.0);
}

invariant vsa_vector_norm_max_value {
    // vector_norm <= sqrt(dim) for trits in {-1, 0, 1}
    @setEvalBranchQuota(100000);
    var v : [100]Trit = undefined;
    random_fill(1, &v);
    const norm = vector_norm(&v);
    @compileAssert(norm <= @sqrt(@as(f64, @floatFromInt(v.len))));
}

invariant vsa_count_non_zero_accurate {
    // count_non_zero returns actual count of non-zero trits
    @setEvalBranchQuota(100000);
    var v : [100]Trit = undefined;
    random_fill(1, &v);
    const count = count_non_zero(&v);
    var expected : usize = 0;
    var i : usize = 0;
    while (i < 100) {
        if (v[i] != TRIT_ZERO) {
            expected = expected + 1;
        }
        i = i + 1;
    }
    @compileAssert(count == expected);
}

invariant vsa_bind_preserves_sparsity {
    // bind(a, b) is zero exactly where both a and b are zero
    @setEvalBranchQuota(100000);
    var v1 : [100]Trit = undefined;
    var v2 : [100]Trit = undefined;
    var result : [100]Trit = undefined;
    random_fill(1, &v1);
    random_fill(2, &v2);
    bind_into(&v1, &v2, &result);

    var ok : bool = true;
    var i : usize = 0;
    while (i < 100) {
        const both_zero = v1[i] == TRIT_ZERO and v2[i] == TRIT_ZERO;
        const result_zero = result[i] == TRIT_ZERO;
        if (both_zero != result_zero) {
            ok = false;
        }
        i = i + 1;
    }
    @compileAssert(ok);
}

// ============================================================================
// TDD - Benchmarks
// ============================================================================

bench "vsa_random_vector_latency" {
    // Measure: cycles for random vector generation (dim=1024)
    // Target: < 5000 cycles
    @setEvalBranchQuota(10000);
    var result : Hypervector = undefined;
    for (0..1000) |_| {
        result = random_vector(42, DEFAULT_DIM);
    }
    _ = result;
}

bench "vsa_bind_latency" {
    // Measure: cycles for bind operation (dim=1024)
    // Target: < 5000 cycles
    @setEvalBranchQuota(10000);
    var a = random_vector(1, DEFAULT_DIM);
    var b = random_vector(2, DEFAULT_DIM);
    var result : Hypervector = undefined;
    for (0..1000) |_| {
        result = bind(a, b);
    }
    _ = result;
}

bench "vsa_unbind_latency" {
    // Measure: cycles for unbind operation (dim=1024)
    // Target: < 5000 cycles
    @setEvalBranchQuota(10000);
    var a = random_vector(1, DEFAULT_DIM);
    var b = random_vector(2, DEFAULT_DIM);
    var result : Hypervector = undefined;
    for (0..1000) |_| {
        result = unbind(a, b);
    }
    _ = result;
}

bench "vsa_bundle2_latency" {
    // Measure: cycles for bundle2 operation (dim=1024)
    // Target: < 5000 cycles
    @setEvalBranchQuota(10000);
    var a = random_vector(1, DEFAULT_DIM);
    var b = random_vector(2, DEFAULT_DIM);
    var result : Hypervector = undefined;
    for (0..1000) |_| {
        result = bundle2(a, b);
    }
    _ = result;
}

bench "vsa_bundle3_latency" {
    // Measure: cycles for bundle3 operation (dim=1024)
    // Target: < 6000 cycles
    @setEvalBranchQuota(10000);
    var a = random_vector(1, DEFAULT_DIM);
    var b = random_vector(2, DEFAULT_DIM);
    var c = random_vector(3, DEFAULT_DIM);
    var result : Hypervector = undefined;
    for (0..1000) |_| {
        result = bundle3(a, b, c);
    }
    _ = result;
}

bench "vsa_permute_latency" {
    // Measure: cycles for permute operation (dim=1024)
    // Target: < 10000 cycles (memory move)
    @setEvalBranchQuota(10000);
    var v = random_vector(1, DEFAULT_DIM);
    var result : Hypervector = undefined;
    for (0..1000) |_| {
        result = permute(v, 1);
    }
    _ = result;
}

bench "vsa_cosine_similarity_latency" {
    // Measure: cycles for cosine similarity (dim=1024)
    // Target: < 10000 cycles (dot + norms + sqrt)
    @setEvalBranchQuota(10000);
    var a = random_vector(1, DEFAULT_DIM);
    var b = random_vector(2, DEFAULT_DIM);
    var result : f64 = 0;
    for (0..1000) |_| {
        result = cosine_similarity(a, b);
    }
    _ = result;
}

bench "vsa_hamming_distance_latency" {
    // Measure: cycles for hamming distance (dim=1024)
    // Target: < 5000 cycles (comparison only)
    @setEvalBranchQuota(10000);
    var a = random_vector(1, DEFAULT_DIM);
    var b = random_vector(2, DEFAULT_DIM);
    var result : usize = 0;
    for (0..1000) |_| {
        result = hamming_distance(a, b);
    }
    _ = result;
}

bench "vsa_vector_norm_latency" {
    // Measure: cycles for vector norm (dim=1024)
    // Target: < 5000 cycles
