// SPDX-License-Identifier: Apache-2.0
// t27/specs/vsa/ops.t27
// Vector Symbolic Architecture Operations
// Bind, Unbind, Bundle, Similarity for ternary hypervectors
// φ² + 1/φ² = 3 | TRINITY

module VSAOps {
    // Import base types and operations
    use base::types;
    use base::ops;

    // ═════════════════════════════════════════════════════════════════
    // 1. Constants
    // ═════════════════════════════════════════════════════════════════════════

    const VSA_DIM : usize = 1024;     // Default hypervector dimension
    const SIMD_WIDTH : usize = 32;    // SIMD trits per operation
    const MAX_VECTORS : usize = 32;   // Maximum vectors for bundleN

    // Similarity metrics
    const SIM_COSINE : u8 = 0;        // Cosine similarity [-1, 1]
    const SIM_HAMMING : u8 = 1;       // Hamming similarity [0, 1]
    const SIM_DOT : u8 = 2;           // Dot product similarity

    // Binding results
    const BIND_IDENTITY : u8 = 0;     // Self-binding (vector unchanged)
    const BIND_INVERT : u8 = 1;       // Inverted binding

    // Result storage: operations that return a new hypervector write it into this
    // module-level arena and return a slice of it. A returned vector stays valid
    // until the arena wraps around, which happens after ARENA_SIZE trits of results.
    const ARENA_SIZE : usize = 32768;
    var arena : [32768]Trit = undefined;
    var arena_len : usize = 0;

    // arena_reserve(len: usize) -> usize
    // Reserve len trits in the arena and return the offset of the reservation
    fn arena_reserve(len: usize) -> usize {
        if (arena_len + len > ARENA_SIZE) {
            arena_len = 0;
        }
        // (Written without a local copy of arena_len: the backend inlines the copy
        // and would return the advanced value.)
        arena_len = arena_len + len;
        return arena_len - len;
    }

    // trit_val(t: Trit) -> i8
    // Numeric value of a trit: -1, 0 or +1
    fn trit_val(t: Trit) -> i8 {
        if (t == Trit.pos) {
            return 1;
        }
        if (t == Trit.neg) {
            return -1;
        }
        return 0;
    }

    // fill_cycle3(out: []Trit, x: Trit, y: Trit, z: Trit) -> void
    // Fill out with the repeating pattern x, y, z, x, y, z, ...
    fn fill_cycle3(out: []Trit, x: Trit, y: Trit, z: Trit) -> void {
        var i : usize = 0;
        while (i < out.len) {
            const m = i % 3;
            if (m == 0) {
                out[i] = x;
            } else if (m == 1) {
                out[i] = y;
            } else {
                out[i] = z;
            }
            i = i + 1;
        }
    }

    // ═════════════════════════════════════════════════════════════════
    // 2. Bind Operation
    // ═════════════════════════════════════════════════════════════════════════

    // bind_into(a, b, len, out) -> void
    // Write bind(a, b) into out (out must hold len trits)
    fn bind_into(a: []const Trit, b: []const Trit, len: usize, out: []Trit) -> void {
        var i : usize = 0;
        while (i < len) {
            const ai = a[i];
            const bi = b[i];

            if (ai == Trit.zero) {
                out[i] = bi;
            } else if (bi == Trit.zero) {
                out[i] = ai;
            } else {
                // Both non-zero: multiply (both are +/-1)
                const product = if (ai == bi) { Trit.pos } else { Trit.neg };
                out[i] = product;
            }

            i = i + 1;
        }
    }

    // bind(a: []Trit, b: []Trit, len: usize) -> []Trit
    // XOR-like operation for balanced ternary hypervectors
    // Algorithm: if a[i] == 0 return b[i]; else if b[i] == 0 return a[i];
    //           else return a[i] * b[i] (which is either -1 or +1)
    // Used for: associative memory binding, role-value pairing
    // The result lives in the module arena (see arena_reserve).
    fn bind(a: []const Trit, b: []const Trit, len: usize) -> []Trit {
        var start = arena_reserve(len);
        bind_into(a, b, len, arena[start .. start + len]);
        return arena[start .. start + len];
    }

    // ═════════════════════════════════════════════════════════════════
    // 3. Unbind Operation
    // ═════════════════════════════════════════════════════════════════════════

    // unbind(bound: []Trit, key: []Trit, len: usize) -> []Trit
    // Inverse of bind operation
    // For XOR-like bind: unbind(x, y) = bind(x, y)
    // Used for: retrieving bound values from hypervectors
    fn unbind(bound: []const Trit, key: []const Trit, len: usize) -> []Trit {
        // unbind = bind for this XOR-like implementation
        return bind(bound, key, len);
    }

    // ═════════════════════════════════════════════════════════════════
    // 4. Bundle Operations
    // ═════════════════════════════════════════════════════════════════════════

    // bundle2_into(a, b, len, out) -> void
    // Write bundle2(a, b) into out (out must hold len trits)
    fn bundle2_into(a: []const Trit, b: []const Trit, len: usize, out: []Trit) -> void {
        var i : usize = 0;
        while (i < len) {
            const ai = a[i];
            const bi = b[i];

            if (ai == Trit.zero) {
                out[i] = bi;
            } else if (bi == Trit.zero) {
                out[i] = ai;
            } else {
                // Both non-zero: determine majority
                const sum = trit_val(ai) + trit_val(bi);  // -2, 0, or +2
                const trit = if (sum > 0) { Trit.pos }
                             else if (sum < 0) { Trit.neg }
                             else { Trit.zero };
                out[i] = trit;
            }

            i = i + 1;
        }
    }

    // bundle2(a: []Trit, b: []Trit, len: usize) -> []Trit
    // Majority vote of 2 ternary vectors
    // Algorithm: if a[i] == 0 return b[i]; else if b[i] == 0 return a[i];
    //           else return sign(a[i] + b[i]) in {-1, 0, +1}
    // Used for: superposition of items, set union
    fn bundle2(a: []const Trit, b: []const Trit, len: usize) -> []Trit {
        var start = arena_reserve(len);
        bundle2_into(a, b, len, arena[start .. start + len]);
        return arena[start .. start + len];
    }

    // bundle3_into(a, b, c, len, out) -> void
    // Write bundle3(a, b, c) into out (out must hold len trits)
    fn bundle3_into(a: []const Trit, b: []const Trit, c: []const Trit, len: usize, out: []Trit) -> void {
        var i : usize = 0;
        while (i < len) {
            const sum = trit_val(a[i]) + trit_val(b[i]) + trit_val(c[i]);  // -3, -1, +1, or +3

            const trit = if (sum > 0) { Trit.pos }
                         else if (sum < 0) { Trit.neg }
                         else { Trit.zero };
            out[i] = trit;

            i = i + 1;
        }
    }

    // bundle3(a: []Trit, b: []Trit, c: []Trit, len: usize) -> []Trit
    // Majority vote of 3 ternary vectors
    // Algorithm: sum = a[i] + b[i] + c[i]; result = sign(sum)
    // Used for: robust superposition, noise reduction
    fn bundle3(a: []const Trit, b: []const Trit, c: []const Trit, len: usize) -> []Trit {
        var start = arena_reserve(len);
        bundle3_into(a, b, c, len, arena[start .. start + len]);
        return arena[start .. start + len];
    }

    // ═════════════════════════════════════════════════════════════════
    // 5. Similarity Operations
    // ═════════════════════════════════════════════════════════════════════════

    // similarity(a: []Trit, b: []Trit, len: usize, metric: u8) -> f64
    // Compute similarity between two hypervectors
    // Metrics: COSINE, HAMMING, DOT
    fn similarity(a: []const Trit, b: []const Trit, len: usize, metric: u8) -> f64 {
        if (metric == SIM_COSINE) {
            return cosine_similarity(a, b, len);
        } else if (metric == SIM_HAMMING) {
            return hamming_similarity(a, b, len);
        }
        // Default to dot
        return dot_product(a, b, len);
    }

    // count_nonzero(v: []Trit, len: usize) -> usize
    // Number of non-zero trits in v
    fn count_nonzero(v: []const Trit, len: usize) -> usize {
        var nonzero_count : usize = 0;

        var i : usize = 0;
        while (i < len) {
            if (v[i] != Trit.zero) {
                nonzero_count = nonzero_count + 1;
            }
            i = i + 1;
        }

        return nonzero_count;
    }

    // cosine_similarity(a: []Trit, b: []Trit, len: usize) -> f64
    // Cosine similarity: (a.b) / (||a|| * ||b||)
    // ||a|| * ||b|| = sqrt(nonzero(a) * nonzero(b)); a single square root keeps the
    // result exactly +/-1 for parallel vectors (sqrt(n) * sqrt(n) is not exactly n).
    fn cosine_similarity(a: []const Trit, b: []const Trit, len: usize) -> f64 {
        const dot = dot_product(a, b, len);
        const count_a = count_nonzero(a, len);
        const count_b = count_nonzero(b, len);

        if (count_a == 0 || count_b == 0) {
            return 0.0;
        }

        return dot / @sqrt(@as(f64, @floatFromInt(count_a)) * @as(f64, @floatFromInt(count_b)));
    }

    // hamming_similarity(a: []Trit, b: []Trit, len: usize) -> f64
    // Hamming similarity: 1 - (hamming_distance / len)
    fn hamming_similarity(a: []const Trit, b: []const Trit, len: usize) -> f64 {
        const dist = hamming_distance(a, b, len);
        return 1.0 - (@as(f64, @floatFromInt(dist)) / @as(f64, @floatFromInt(len)));
    }

    // dot_product(a: []Trit, b: []Trit, len: usize) -> f64
    // Compute dot product sum of a[i] * b[i]
    fn dot_product(a: []const Trit, b: []const Trit, len: usize) -> f64 {
        var acc : i64 = 0;

        var i : usize = 0;
        while (i < len) {
            const product = trit_val(a[i]) * trit_val(b[i]);
            acc = acc + product;
            i = i + 1;
        }

        return @as(f64, @floatFromInt(acc));
    }

    // vector_norm(v: []Trit, len: usize) -> f64
    // Compute L2 norm: sqrt(sum of v[i]^2)
    // For trits: v[i]^2 is always 0 or 1
    // So norm = sqrt(count of non-zero trits)
    fn vector_norm(v: []const Trit, len: usize) -> f64 {
        const nonzero_count = count_nonzero(v, len);
        return @sqrt(@as(f64, @floatFromInt(nonzero_count)));
    }

    // hamming_distance(a: []Trit, b: []Trit, len: usize) -> usize
    // Count positions where a[i] != b[i]
    fn hamming_distance(a: []const Trit, b: []const Trit, len: usize) -> usize {
        var distance : usize = 0;

        var i : usize = 0;
        while (i < len) {
            if (a[i] != b[i]) {
                distance = distance + 1;
            }
            i = i + 1;
        }

        return distance;
    }

    // ═════════════════════════════════════════════════════════════════
    // 6. Permutation Operations
    // ═════════════════════════════════════════════════════════════════════════

    // permute_into(v, len, shift, out) -> void
    // Write permute(v, len, shift) into out (out must hold len trits)
    fn permute_into(v: []const Trit, len: usize, shift: usize, out: []Trit) -> void {
        const normalized_shift = shift % len;

        var i : usize = 0;
        while (i < len) {
            // Position i receives the trit shift places to its left
            const src_idx = (i + len - normalized_shift) % len;
            out[i] = v[src_idx];
            i = i + 1;
        }
    }

    // permute(v: []Trit, len: usize, shift: usize) -> []Trit
    // Circular shift of hypervector by shift positions (towards higher indices)
    // Used for: sequence encoding, position tagging
    fn permute(v: []const Trit, len: usize, shift: usize) -> []Trit {
        var start = arena_reserve(len);
        permute_into(v, len, shift, arena[start .. start + len]);
        return arena[start .. start + len];
    }

    // encode_sequence(items: [][]Trit, count: usize, item_len: usize) -> []Trit
    // Encode sequence of items using position-aware binding
    // result = items[0] + permute(items[1], 1) + permute(items[2], 2) + ...
    fn encode_sequence(items: [][]Trit, count: usize, item_len: usize) -> []Trit {
        // Copy the first item into the arena
        var start = arena_reserve(item_len);
        var j : usize = 0;
        while (j < item_len) {
            arena[start + j] = items[0][j];
            j = j + 1;
        }
        var result : []Trit = arena[start .. start + item_len];

        var i : usize = 1;
        while (i < count) {
            const permuted = permute(items[i], item_len, i);
            result = bundle2(result, permuted, item_len);
            i = i + 1;
        }

        return result;
    }

    // probe_sequence(seq: []Trit, candidate: []Trit, position: usize, len: usize) -> f64
    // Probe if candidate is at position in encoded sequence
    // Returns similarity between seq and permute(candidate, position)
    fn probe_sequence(seq: []const Trit, candidate: []const Trit, position: usize, len: usize) -> f64 {
        const permuted = permute(candidate, len, position);
        return similarity(seq, permuted, len, SIM_COSINE);
    }

    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════
    // TDD-Inside-Spec: Tests and Invariants for VSAOps
    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════

    test vsa_bind_with_zeros
        given a = [Trit.zero, Trit.pos, Trit.neg]
        and   b = [Trit.pos, Trit.zero, Trit.neg]
        when result = bind(a, b, 3)
        then result[0] == Trit.pos and result[1] == Trit.pos and result[2] == Trit.pos

    test vsa_bind_nonzero_multiply
        given a = [Trit.pos, Trit.pos, Trit.neg, Trit.neg]
        and   b = [Trit.pos, Trit.neg, Trit.pos, Trit.neg]
        when result = bind(a, b, 4)
        then result[0] == Trit.pos and result[1] == Trit.neg and result[2] == Trit.neg and result[3] == Trit.pos

    test vsa_bundle2_with_zero
        given a = [Trit.zero, Trit.pos, Trit.neg]
        and   b = [Trit.pos, Trit.zero, Trit.neg]
        when result = bundle2(a, b, 3)
        then result[0] == Trit.pos and result[1] == Trit.pos and result[2] == Trit.neg

    test vsa_bundle2_majority_vote
        given a = [Trit.pos, Trit.neg, Trit.pos]
        and   b = [Trit.neg, Trit.neg, Trit.neg]
        when result = bundle2(a, b, 3)
        then result[0] == Trit.zero and result[1] == Trit.neg and result[2] == Trit.zero

    test vsa_bundle3_consensus
        given a = [Trit.pos, Trit.pos, Trit.neg]
        and   b = [Trit.pos, Trit.neg, Trit.pos]
        and   c = [Trit.pos, Trit.pos, Trit.pos]
        when result = bundle3(a, b, c, 3)
        then result[0] == Trit.pos and result[1] == Trit.pos and result[2] == Trit.pos

    test vsa_dot_product_identical
        given a = [Trit.pos, Trit.neg, Trit.pos, Trit.zero]
        and   b = [Trit.pos, Trit.neg, Trit.pos, Trit.zero]
        when result = dot_product(a, b, 4)
        then result == 3.0

    test vsa_dot_product_orthogonal
        given a = [Trit.pos, Trit.neg, Trit.zero]
        and   b = [Trit.neg, Trit.pos, Trit.zero]
        when result = dot_product(a, b, 3)
        then result == -2.0

    test vsa_hamming_distance_identical
        given a = [Trit.pos, Trit.neg, Trit.zero]
        and   b = [Trit.pos, Trit.neg, Trit.zero]
        when result = hamming_distance(a, b, 3)
        then result == 0

    test vsa_hamming_distance_different
        given a = [Trit.pos, Trit.pos, Trit.pos]
        and   b = [Trit.neg, Trit.neg, Trit.neg]
        when result = hamming_distance(a, b, 3)
        then result == 3

    test vsa_vector_norm_zero_vector
        given v = [Trit.zero, Trit.zero, Trit.zero]
        when result = vector_norm(v, 3)
        then result == 0.0

    test vsa_vector_norm_all_nonzero
        given v = [Trit.pos, Trit.neg, Trit.pos]
        when result = vector_norm(v, 3)
        then abs(result - 1.732) < 0.01  // sqrt(3)

    test vsa_cosine_similarity_identical
        given a = [Trit.pos, Trit.neg, Trit.pos]
        and   b = [Trit.pos, Trit.neg, Trit.pos]
        when result = cosine_similarity(a, b, 3)
        then abs(result - 1.0) < 0.01

    test vsa_cosine_similarity_orthogonal
        given a = [Trit.pos, Trit.neg, Trit.zero]
        and   b = [Trit.neg, Trit.pos, Trit.zero]
        when result = cosine_similarity(a, b, 3)
        then abs(result + 1.0) < 0.01

    test vsa_permute_shift_by_one
        given v = [Trit.pos, Trit.neg, Trit.zero, Trit.pos]
        when result = permute(v, 4, 1)
        then result[0] == Trit.pos and result[1] == Trit.pos and result[2] == Trit.neg and result[3] == Trit.zero

    test vsa_permute_shift_by_len_returns_original
        given v = [Trit.pos, Trit.neg, Trit.zero]
        when result = permute(v, 3, 3)
        then result[0] == Trit.pos and result[1] == Trit.neg and result[2] == Trit.zero

    test vsa_permute_shift_zero_unchanged
        given v = [Trit.pos, Trit.neg, Trit.zero]
        when result = permute(v, 3, 0)
        then result[0] == Trit.pos and result[1] == Trit.neg and result[2] == Trit.zero

    test vsa_bind_unbind_identity
        given x = [Trit.pos, Trit.neg, Trit.zero, Trit.pos]
        and   key = [Trit.neg, Trit.pos, Trit.zero, Trit.neg]
        and   bound = bind(x, key, 4)
        and   unbound = unbind(bound, key, 4)
        and   sim = similarity(x, unbound, 4, SIM_COSINE)
        then sim > 0.95

    test vsa_bundle2_idempotent
        given v = [Trit.pos, Trit.neg, Trit.zero]
        when result = bundle2(v, v, 3)
        then hamming_distance(result, v, 3) == 0

    test vsa_similarity_symmetry
        given a = [Trit.pos, Trit.neg, Trit.pos, Trit.zero]
        and   b = [Trit.neg, Trit.pos, Trit.neg, Trit.pos]
        and   sim_ab = similarity(a, b, 4, SIM_COSINE)
        and   sim_ba = similarity(b, a, 4, SIM_COSINE)
        then abs(sim_ab - sim_ba) < 0.0001

    test vsa_similarity_bounds_cosine
        given a = [Trit.pos, Trit.neg, Trit.pos]
        and   b = [Trit.neg, Trit.pos, Trit.neg]
        and   sim = similarity(a, b, 3, SIM_COSINE)
        then sim >= -1.0 and sim <= 1.0

    test vsa_similarity_bounds_hamming
        given a = [Trit.pos, Trit.neg, Trit.pos]
        and   b = [Trit.neg, Trit.pos, Trit.neg]
        and   sim = similarity(a, b, 3, SIM_HAMMING)
        then sim >= 0.0 and sim <= 1.0

    invariant vsa_bind_commutative {
        @setEvalBranchQuota(100000);
        var a : [3]Trit = undefined;
        var b : [3]Trit = undefined;
        var ab : [3]Trit = undefined;
        var ba : [3]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.pos);
        bind_into(&a, &b, 3, &ab);
        bind_into(&b, &a, 3, &ba);
        @compileAssert(ab[0] == ba[0] and ab[1] == ba[1] and ab[2] == ba[2]);
        @compileAssert(ab[0] == Trit.neg and ab[1] == Trit.neg and ab[2] == Trit.pos);
    }

    invariant vsa_bind_associative {
        // For XOR-like bind: bind(a, bind(b, c)) == bind(bind(a, b), c)
        @setEvalBranchQuota(100000);
        var a : [2]Trit = undefined;
        var b : [2]Trit = undefined;
        var c : [2]Trit = undefined;
        var bc : [2]Trit = undefined;
        var abc : [2]Trit = undefined;
        var ab : [2]Trit = undefined;
        var abc2 : [2]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.zero);
        fill_cycle3(&c, Trit.pos, Trit.pos, Trit.zero);
        bind_into(&b, &c, 2, &bc);
        bind_into(&a, &bc, 2, &abc);
        bind_into(&a, &b, 2, &ab);
        bind_into(&ab, &c, 2, &abc2);
        @compileAssert(abc[0] == abc2[0] and abc[1] == abc2[1]);
        @compileAssert(abc[0] == Trit.neg and abc[1] == Trit.neg);
    }

    invariant vsa_bundle2_commutative {
        @setEvalBranchQuota(100000);
        var a : [3]Trit = undefined;
        var b : [3]Trit = undefined;
        var ab : [3]Trit = undefined;
        var ba : [3]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.pos);
        bundle2_into(&a, &b, 3, &ab);
        bundle2_into(&b, &a, 3, &ba);
        @compileAssert(hamming_distance(&ab, &ba, 3) == 0);
        @compileAssert(ab[0] == Trit.zero and ab[1] == Trit.zero and ab[2] == Trit.pos);
    }

    invariant vsa_bundle3_commutative {
        @setEvalBranchQuota(100000);
        var a : [2]Trit = undefined;
        var b : [2]Trit = undefined;
        var c : [2]Trit = undefined;
        var abc1 : [2]Trit = undefined;
        var abc2 : [2]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.zero);
        fill_cycle3(&c, Trit.pos, Trit.pos, Trit.zero);
        bundle3_into(&a, &b, &c, 2, &abc1);
        bundle3_into(&b, &a, &c, 2, &abc2);
        @compileAssert(hamming_distance(&abc1, &abc2, 2) == 0);
        @compileAssert(abc1[0] == Trit.pos and abc1[1] == Trit.pos);
    }

    invariant vsa_unbind_reverses_bind {
        // The key is zero where x is zero: bind treats zero as the identity, so a
        // zero in x against a non-zero key cannot be told apart from a non-zero x.
        @setEvalBranchQuota(100000);
        var x : [4]Trit = undefined;
        var key : [4]Trit = undefined;
        var bound : [4]Trit = undefined;
        var recovered : [4]Trit = undefined;
        fill_cycle3(&x, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&key, Trit.neg, Trit.pos, Trit.zero);
        key[3] = Trit.neg;
        bind_into(&x, &key, 4, &bound);
        bind_into(&bound, &key, 4, &recovered);
        @compileAssert(similarity(&x, &recovered, 4, SIM_COSINE) >= 0.95);
        @compileAssert(hamming_distance(&x, &recovered, 4) == 0);
    }

    invariant vsa_permute_involutivity {
        @setEvalBranchQuota(100000);
        var v : [5]Trit = undefined;
        var p1 : [5]Trit = undefined;
        var p2 : [5]Trit = undefined;
        fill_cycle3(&v, Trit.pos, Trit.neg, Trit.zero);
        permute_into(&v, 5, 2, &p1);
        permute_into(&p1, 5, 3, &p2);
        @compileAssert(hamming_distance(&v, &p2, 5) == 0);
        @compileAssert(hamming_distance(&v, &p1, 5) > 0);
    }

    invariant vsa_similarity_non_negativity_hamming {
        var a : [3]Trit = undefined;
        var b : [3]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.pos);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.neg);
        @compileAssert(similarity(&a, &b, 3, SIM_HAMMING) >= 0.0);
    }

    invariant vsa_vector_norm_non_negative {
        var v1 : [1]Trit = undefined;
        var v2 : [1]Trit = undefined;
        var v3 : [1]Trit = undefined;
        var v4 : [2]Trit = undefined;
        v1[0] = Trit.pos;
        v2[0] = Trit.neg;
        v3[0] = Trit.zero;
        fill_cycle3(&v4, Trit.pos, Trit.neg, Trit.zero);
        @compileAssert(vector_norm(&v1, 1) >= 0.0);
        @compileAssert(vector_norm(&v2, 1) >= 0.0);
        @compileAssert(vector_norm(&v3, 1) >= 0.0);
        @compileAssert(vector_norm(&v4, 2) >= 0.0);
    }

    invariant vsa_hamming_distance_symmetric {
        var a : [3]Trit = undefined;
        var b : [3]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.pos);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.neg);
        @compileAssert(hamming_distance(&a, &b, 3) == hamming_distance(&b, &a, 3));
        @compileAssert(hamming_distance(&a, &b, 3) == 3);
    }

    invariant vsa_dot_product_symmetric {
        var a : [3]Trit = undefined;
        var b : [3]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.pos);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.neg);
        @compileAssert(dot_product(&a, &b, 3) == dot_product(&b, &a, 3));
        @compileAssert(dot_product(&a, &b, 3) == -3.0);
    }

    invariant vsa_vsa_dim_positive
        assert VSA_DIM > 0

    invariant vsa_simd_width_positive
        assert SIMD_WIDTH > 0

    invariant vsa_max_vectors_positive
        assert MAX_VECTORS > 0

    // ═════════════════════════════════════════════════════════════════
    // Ring 048: Additional Algebraic Group Invariants
    // ═════════════════════════════════════════════════════════════════════════

    // bind_self_inverse: a BIND (a BIND b) == b
    // For XOR-like bind, bind is its own inverse
    invariant bind_self_inverse {
        @setEvalBranchQuota(100000);
        var a : [3]Trit = undefined;
        var b : [3]Trit = undefined;
        var ab : [3]Trit = undefined;
        var aab : [3]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.pos);
        bind_into(&a, &b, 3, &ab);
        bind_into(&a, &ab, 3, &aab);
        @compileAssert(hamming_distance(&aab, &b, 3) == 0);
        @compileAssert(hamming_distance(&ab, &b, 3) > 0);
    }

    // bundle3_majority: Bundle of 3 identical vectors returns that vector
    invariant bundle3_majority {
        @setEvalBranchQuota(100000);
        var v : [4]Trit = undefined;
        var result : [4]Trit = undefined;
        fill_cycle3(&v, Trit.pos, Trit.neg, Trit.zero);
        bundle3_into(&v, &v, &v, 4, &result);
        @compileAssert(hamming_distance(&result, &v, 4) == 0);
    }

    // similarity_range: Cosine similarity is bounded [-1, 1]
    invariant similarity_range_cosine {
        var a : [4]Trit = undefined;
        var b : [4]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.pos);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.neg);
        a[3] = Trit.zero;
        b[3] = Trit.pos;
        const sim = cosine_similarity(&a, &b, 4);
        @compileAssert(sim >= -1.0 and sim <= 1.0);
    }

    // similarity_range: Hamming similarity is bounded [0, 1]
    invariant similarity_range_hamming {
        var a : [4]Trit = undefined;
        var b : [4]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.pos);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.neg);
        a[3] = Trit.zero;
        b[3] = Trit.pos;
        const sim = hamming_similarity(&a, &b, 4);
        @compileAssert(sim >= 0.0 and sim <= 1.0);
    }

    // self_similarity: Cosine similarity of vector with itself is 1.0
    invariant self_similarity_cosine {
        var v : [4]Trit = undefined;
        fill_cycle3(&v, Trit.pos, Trit.neg, Trit.pos);
        v[3] = Trit.zero;
        const sim = cosine_similarity(&v, &v, 4);
        @compileAssert(@abs(sim - 1.0) < 0.0001);
    }

    // self_similarity: Hamming similarity of vector with itself is 1.0
    invariant self_similarity_hamming {
        var v : [4]Trit = undefined;
        fill_cycle3(&v, Trit.pos, Trit.neg, Trit.pos);
        v[3] = Trit.zero;
        const sim = hamming_similarity(&v, &v, 4);
        @compileAssert(@abs(sim - 1.0) < 0.0001);
    }

    // bind_distributes_over_bundle2: a BIND bundle2(b, c) = bundle2(a BIND b, a BIND c)
    // Zero is the identity of bind, so a position where b and c cancel (bundle2 gives
    // zero) is bound as a bare a, while the right side keeps the sign of a*b and a*c.
    // The law therefore holds exactly when b and c agree at every position, which is
    // the case checked here.
    invariant bind_distributes_over_bundle2 {
        @setEvalBranchQuota(100000);
        var a : [2]Trit = undefined;
        var b : [2]Trit = undefined;
        var c : [2]Trit = undefined;
        var bc : [2]Trit = undefined;
        var left : [2]Trit = undefined;
        var ab : [2]Trit = undefined;
        var ac : [2]Trit = undefined;
        var right : [2]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.zero);
        fill_cycle3(&c, Trit.neg, Trit.pos, Trit.zero);
        bundle2_into(&b, &c, 2, &bc);
        bind_into(&a, &bc, 2, &left);
        bind_into(&a, &b, 2, &ab);
        bind_into(&a, &c, 2, &ac);
        bundle2_into(&ab, &ac, 2, &right);
        @compileAssert(hamming_distance(&left, &right, 2) == 0);
        @compileAssert(left[0] == Trit.neg and left[1] == Trit.neg);
    }

    // zero_vector_bind_identity: bind(zero, x) == x and bind(x, zero) == x
    invariant zero_vector_bind_identity {
        @setEvalBranchQuota(100000);
        var x : [3]Trit = undefined;
        var zero : [3]Trit = undefined;
        var zx : [3]Trit = undefined;
        var xz : [3]Trit = undefined;
        fill_cycle3(&x, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&zero, Trit.zero, Trit.zero, Trit.zero);
        bind_into(&zero, &x, 3, &zx);
        bind_into(&x, &zero, 3, &xz);
        @compileAssert(hamming_distance(&zx, &x, 3) == 0);
        @compileAssert(hamming_distance(&xz, &x, 3) == 0);
    }

    // ═════════════════════════════════════════════════════════════════
    // 27-Dimensional Coptic Trit Space (Ring 048)
    // ═════════════════════════════════════════════════════════════════════════

    const COPTIC_DIM : usize = 27

    // TritVec27: 27-dimensional trit vector for Coptic alphabet encoding
    // Each of the 27 Coptic letters maps to a unique 27-dim hypervector
    fn coptic_bind(a: [27]Trit, b: [27]Trit) -> [27]Trit {
        var result : [27]Trit = undefined;
        var i : usize = 0;
        while (i < 27) {
            const ai = a[i];
            const bi = b[i];
            if (ai == Trit.zero) {
                result[i] = bi;
            } else if (bi == Trit.zero) {
                result[i] = ai;
            } else {
                result[i] = if (ai == bi) { Trit.pos } else { Trit.neg };
            }
            i = i + 1;
        }
        return result;
    }

    fn coptic_unbind(bound: [27]Trit, key: [27]Trit) -> [27]Trit {
        return coptic_bind(bound, key);
    }

    fn coptic_bundle3(a: [27]Trit, b: [27]Trit, c: [27]Trit) -> [27]Trit {
        var result : [27]Trit = undefined;
        var i : usize = 0;
        while (i < 27) {
            const sum = trit_val(a[i]) + trit_val(b[i]) + trit_val(c[i]);
            result[i] = if (sum > 0) { Trit.pos }
                       else if (sum < 0) { Trit.neg }
                       else { Trit.zero };
            i = i + 1;
        }
        return result;
    }

    fn coptic_similarity(a: [27]Trit, b: [27]Trit) -> f64 {
        var matches : usize = 0;
        var i : usize = 0;
        while (i < 27) {
            if (a[i] == b[i]) { matches = matches + 1; }
            i = i + 1;
        }
        return @as(f64, @floatFromInt(matches)) / 27.0;
    }

    // Coptic space invariants
    invariant coptic_bind_commutative {
        @setEvalBranchQuota(100000);
        var a : [27]Trit = undefined;
        var b : [27]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.pos);
        var ab : [27]Trit = coptic_bind(a, b);
        var ba : [27]Trit = coptic_bind(b, a);
        @compileAssert(hamming_distance(&ab, &ba, 27) == 0);
        @compileAssert(hamming_distance(&ab, &a, 27) > 0);
    }

    invariant coptic_bind_self_inverse {
        @setEvalBranchQuota(100000);
        var a : [27]Trit = undefined;
        var b : [27]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.pos);
        var ab : [27]Trit = coptic_bind(a, b);
        var aab : [27]Trit = coptic_bind(a, ab);
        @compileAssert(hamming_distance(&aab, &b, 27) == 0);
        @compileAssert(hamming_distance(&ab, &b, 27) > 0);
    }

    invariant coptic_bundle3_majority {
        @setEvalBranchQuota(100000);
        var v : [27]Trit = undefined;
        fill_cycle3(&v, Trit.pos, Trit.neg, Trit.zero);
        var result : [27]Trit = coptic_bundle3(v, v, v);
        @compileAssert(hamming_distance(&result, &v, 27) == 0);
    }

    invariant coptic_similarity_range {
        @setEvalBranchQuota(100000);
        var a : [27]Trit = undefined;
        var b : [27]Trit = undefined;
        fill_cycle3(&a, Trit.pos, Trit.neg, Trit.zero);
        fill_cycle3(&b, Trit.neg, Trit.pos, Trit.pos);
        const sim = coptic_similarity(a, b);
        @compileAssert(sim >= 0.0 and sim <= 1.0);
    }

    invariant coptic_self_similarity {
        @setEvalBranchQuota(100000);
        var v : [27]Trit = undefined;
        fill_cycle3(&v, Trit.pos, Trit.neg, Trit.zero);
        const sim = coptic_similarity(v, v);
        @compileAssert(@abs(sim - 1.0) < 0.0001);
    }

    test coptic_bind_unbind_identity
        given x = [Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.zero]
        and   key = [Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero, Trit.neg, Trit.pos, Trit.zero]
        and   bound = coptic_bind(x, key)
        and   unbound = coptic_unbind(bound, key)
        then hamming_distance(&unbound, x, 27) == 0

    bench vsa_bind_throughput
        measure: nanoseconds to bind([Trit.pos; 1024], [Trit.neg; 1024], 1024)
        target: < 1000ns

    bench vsa_bundle2_throughput
        measure: nanoseconds to bundle2([Trit.pos; 1024], [Trit.neg; 1024], 1024)
        target: < 1000ns

    bench vsa_bundle3_throughput
        measure: nanoseconds to bundle3([Trit.pos; 1024], [Trit.neg; 1024], [Trit.pos; 1024], 1024)
        target: < 1500ns

    bench vsa_similarity_latency
        measure: nanoseconds to cosine_similarity([Trit.pos; 1024], [Trit.neg; 1024], 1024)
        target: < 2000ns

    bench vsa_permute_latency
        measure: nanoseconds to permute([Trit.pos; 1024], 1024, 100)
        target: < 500ns

    bench vsa_dot_product_latency
        measure: nanoseconds to dot_product([Trit.pos; 1024], [Trit.neg; 1024], 1024)
        target: < 1500ns

    bench vsa_hamming_distance_latency
        measure: nanoseconds to hamming_distance([Trit.pos; 1024], [Trit.neg; 1024], 1024)
        target: < 1000ns
}
