module Sha256Micro4;

test x_identity {
    const x : u64 = 2670261550;
    assert(x == 2670261550);
}

test y_identity {
    const y : u64 = 172365677;
    assert(y == 172365677);
}

test and_large {
    const x : u64 = 2670261550;
    const y : u64 = 172365677;
    assert((x & y) == 167777580);
}

test or_large {
    const x : u64 = 2670261550;
    const y : u64 = 172365677;
    assert((x | y) == 2674849647);
}

test xor_large {
    const x : u64 = 2670261550;
    const y : u64 = 172365677;
    assert((x ^ y) == 2507072067);
}

test and_with_one {
    const x : u64 = 2670261550;
    assert((x & 1) == 0);
}

test or_with_one {
    const x : u64 = 2670261550;
    assert((x | 1) == 2670261551);
}

endmodule
