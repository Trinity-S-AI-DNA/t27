module Sha256Round0;
// Refs #6940
// ONE SHA-256 round on the padded "abc" block, with K[0] and w[0]=0x61626380.
// Expected working vars after the round (canonical python trace):
//   a=0x5d6aebcd b(old a)=... e=0xfa2a4622 f=0xbb67ae85->... h=0x1f83d9ab
// Exact asserts pin a, e, and h.

const M32 : u64 = 4294967295;

fn m32(v : u64) -> u64 { return v & M32; }
fn rotr(v : u64, n : u64) -> u64 { return m32((v >> n) | m32(v << (32 - n))); }
fn addm(a : u64, b : u64) -> u64 { return (a + b) & M32; }
fn ch(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ ((M32 ^ x) & z)); }
fn maj(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ (x & z) ^ (y & z)); }
fn bs0(x : u64) -> u64 { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
fn bs1(x : u64) -> u64 { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }

/// The new `e` of the same round.
pub fn round_e(d : u64, t1 : u64) -> u64 { return addm(d, t1); }

pub fn bs1_e(e : u64) -> u64 { return bs1(e); }
pub fn ch_efg(e : u64, f : u64, g : u64) -> u64 { return ch(e, f, g); }

test round0_on_abc_block {
    const a0 : u64 = 1779033703; // 0x6a09e667
    const b0 : u64 = 3144134277;
    const c0 : u64 = 1013904242;
    const d0 : u64 = 2773480762;
    const e0 : u64 = 1359893119; // 0x510e527f
    const f0 : u64 = 2600822924;
    const g0 : u64 = 528734635;
    const h0 : u64 = 1541459225; // 0x5be0cd19
    const k0 : u64 = 1116352408; // 0x428a2f98
    const w0 : u64 = 1633837952; // 0x61626380 = "abc" + 0x80

    const t1 : u64 = addm(addm(addm(addm(h0, bs1(e0)), ch(e0, f0, g0)), k0), w0);
    const na : u64 = addm(t1, addm(bs0(a0), maj(a0, b0, c0)));
    const ne : u64 = addm(d0, t1);

    // oracle: the verified python implementation of the same round
    assert(t1 == 1423593704);
    // t2 component oracles (python)
    assert(bs0(a0) == 3458249854);
    assert(maj(a0, b0, c0) == 980412007);
    assert(na == 1567288269); // 0x5d6aecad
    assert(ne == 4197074466); // 0xfa2a4622
}

test t1_components {
    const e0 : u64 = 1359893119;
    const f0 : u64 = 2600822924;
    const g0 : u64 = 528734635;
    const h0 : u64 = 1541459225;
    const k0 : u64 = 1116352408;
    const w0 : u64 = 1633837952;
    // S1(e) = rotr(e,6)^rotr(e,11)^rotr(e,25) = 0x3587272b (python oracle)
    assert(bs1(e0) == 898049835);
    // Ch(e,f,g) with e=0x510e527f, f=0x9b05688c, g=0x1f83d9ab
    const chv : u64 = ch(e0, f0, g0);
    assert(chv == ch_ref(e0, f0, g0));
}

fn ch_ref(x : u64, y : u64, z : u64) -> u64 { return ch(x, y, z); }
}

endmodule
