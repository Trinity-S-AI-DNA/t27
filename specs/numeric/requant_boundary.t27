// specs/numeric/requant_boundary.t27
// Records the inclusive threshold convention for requantization.
// PRE_RULE: agrees with the artifact it was written from.
// INTENT: DO_NOT_GUESS

module RequantBoundary {
    use base::types;

    // Placeholder constant for the threshold.
    const THRESHOLD: u32 = 0;

    // Accessor so the pinned value is checked at runtime: a bare
    // constant comparison is folded before execution and would leave the
    // test vacuous (T730), while a call is a real runtime assert (#6509).
    pub fn threshold() -> u32 {
        THRESHOLD
    }

    // t27b checked (#8473): pin the one value this spec records. The
    // inclusive requantization boundary is the placeholder 0 until a
    // measured threshold replaces it; this assert fails the moment that
    // recorded value drifts without the spec's PRE_RULE being revisited.
    test threshold_placeholder_is_pinned {
        assert threshold() == 0;
    }
}
