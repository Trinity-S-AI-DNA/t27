// SPDX-License-Identifier: Apache-2.0
// specs/numeric/gamma_tick.t27 -- GAP: gamma tick policy (gamma = phi^-3).
// Executable home for the gamma tick rate policy in .t27.
// Part of M5 milestone (milestone #9). Closes #13043.
// phi^2 + 1/phi^2 = 3 | TRINITY

module numeric::gamma_tick;

pub const GAMMA_PHI_INV_CUBE_NUM : i32 = 1;
pub const GAMMA_PHI_INV_CUBE_DEN : i32 = 4;  // phi^3 = 2*phi + 1 ≈ 4.236, phi^-3 ≈ 0.236

pub struct GammaTick { gamma_num: i32, gamma_den: i32, ticks_per_second: u32 };

pub fn gamma_tick_rate(t: GammaTick) -> i32 {
    // Returns gamma as a rational: num/den
    return t.gamma_num;
}

pub fn gamma_tick_denominator(t: GammaTick) -> i32 {
    return t.gamma_den;
}

pub fn ticks_per_second(t: GammaTick) -> u32 {
    return t.ticks_per_second;
}

test "gamma_tick_rate" {
    var t = GammaTick { gamma_num: 1, gamma_den: 4, ticks_per_second: 10 };
    assert(gamma_tick_rate(t) == 1);
}

test "gamma_tick_denominator" {
    var t = GammaTick { gamma_num: 1, gamma_den: 4, ticks_per_second: 10 };
    assert(gamma_tick_denominator(t) == 4);
}

test "ticks_per_second" {
    var t = GammaTick { gamma_num: 1, gamma_den: 4, ticks_per_second: 10 };
    assert(ticks_per_second(t) == 10);
}

invariant gamma_phi_inv_cube_defined {
    assert GAMMA_PHI_INV_CUBE_NUM == 1;
    assert GAMMA_PHI_INV_CUBE_DEN == 4;
}