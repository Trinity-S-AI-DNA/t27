module Sha256NaBits;
// Refs #6940

fn m32(v : u64) -> u64 { return v & 4294967295; }
fn addm(a : u64, b : u64) -> u64 { return (a + b) & 4294967295; }
fn rotr(v : u64, n : u64) -> u64 { return (v >> n) | (v << (32 - n)) & 4294967295; }
fn ch(x : u64, y : u64, z : u64) -> u64 { return (x & y) ^ ((4294967295 ^ x) & z); }
fn maj(x : u64, y : u64, z : u64) -> u64 { return (x & y) ^ (x & z) ^ (y & z); }
fn bs0(x : u64) -> u64 { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
fn bs1(x : u64) -> u64 { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }


use t27os::hot_reload::bytes_eq;

test nab_0 {
    const a0 : u64 = 1779033703; const b0 : u64 = 3144134277; const c0 : u64 = 1013904242;
    const d0 : u64 = 2773480762; const e0 : u64 = 1359893119; const f0 : u64 = 2600822924;
    const g0 : u64 = 528734635; const h0 : u64 = 1541459225;
    const k0 : u64 = 1116352408; const w0 : u64 = 1633837920;
    const t1 : u64 = addm(addm(addm(addm(h0, bs1(e0)), ch(e0, f0, g0)), k0), w0);
    const t2 : u64 = addm(bs0(a0), maj(a0, b0, c0));
    const na : u64 = addm(t1, t2);
    assert((na >> 0) & 1 == 1);
}

