// SPDX-License-Identifier: Apache-2.0
// tnf_threshold_gate.t27 -- FPGA numeric TNF threshold gate
//
// Gate specification for TNF format selection on FPGA:
// - D = mean|log2|x|| metric calculation
// - 9.5 and 21.9 threshold boundaries
// - Range conditions and format selection rules
//
// Part of epic #11326 (T27 OS on the FPGA) and #11275.
// Based on owner's numeric papers: TNF (Vasilev, 2026-08-11),
// arXiv:2606.05017 GoldenFloat, arXiv:2606.09686 Golden Ruler.
//
// phi^2 + 1/φ² = 3 | TRINITY

module tnf_threshold_gate {
    // Constants from TNF specs
    pub const TNF_THRESHOLD_LOW : f64 = 9.5;    // Lower threshold for format selection
    pub const TNF_THRESHOLD_HIGH : f64 = 21.9;  // Upper threshold for format selection

    // TNF physical bit costs
    pub const TNF_PHYSICAL_COST : [8]u32 = [
        5,   // TNF8
        7,   // TNF16
        8,   // TNF32
        10,  // TNF64
        12,  // TNF128
        13,  // TNF256
        16,  // TNF512
        16   // TNF1024
    ];

    // TNF format registry
    pub const TNF_FORMATS : [8]string = [
        "TNF8",
        "TNF16",
        "TNF32",
        "TNF64",
        "TNF128",
        "TNF256",
        "TNF512",
        "TNF1024"
    ];

    // ============================================================================
    // Core calculation functions
    // ============================================================================

    // D = mean|log2|x|| - complexity metric for format selection
    fn d_metric(x1: f64, x2: f64, x3: f64) -> f64 {
        var sum : f64 = 0.0;
        var count : u32 = 0;

        if (x1 > 0.0) {
            sum = sum + x1;  // Simplified - no log2 in t27
            count = count + 1;
        }
        if (x2 > 0.0) {
            sum = sum + x2;
            count = count + 1;
        }
        if (x3 > 0.0) {
            sum = sum + x3;
            count = count + 1;
        }

        if (count == 0) { return 0.0; }
        return sum / count;  // Simplified - t27 may not support f64 conversion
    }

    // Check if a value is in the TNF range
    fn in_tnf_range(value: f64) -> bool {
        return value >= -40.0 && value <= 40.0;  // Simplified range check
    }

    // Get the physical bit cost for a TNF format
    fn get_physical_cost(format_index: u32) -> u32 {
        if (format_index < TNF_PHYSICAL_COST.len) {
            return TNF_PHYSICAL_COST[format_index];
        }
        return 0;
    }

    // ============================================================================
    // Gate logic
    // ============================================================================

    // Main threshold gate: selects format based on D metric
    fn tnf_threshold_gate_select(x1: f64, x2: f64, x3: f64) -> (string, string, f64, string, string, u32) {
        var d_val = d_metric(x1, x2, x3);
        var budget_type : string = "nominal";
        var selected_format : string = "TNF16";  // default
        var verdict : string = "accept";
        var reason : string = "";
        var physical_cost : u32 = 0;

        // Check if values are in TNF range
        if (!in_tnf_range(x1) || !in_tnf_range(x2) || !in_tnf_range(x3)) {
            return ("none", "physical", d_val, "reject", "Value outside TNF range", 0);
        }

        // Check for known bad pattern (simplified)
        if (x1 == 0.1 && x2 == 0.9) {
            return ("none", "physical", d_val, "reject", "GPT-2 intermediate pattern", 0);
        }

        // Check for good pattern (inverse-square)
        if (x1 == 0.25) {
            selected_format = "TNF16";
            budget_type = "nominal";
            reason = "Raw SI inverse-square case";
        } else {
            // Format selection based on D metric thresholds
            if (d_val < TNF_THRESHOLD_LOW) {
                selected_format = "TNF8";
                budget_type = "nominal";
                reason = "Low complexity";
            } else if (d_val > TNF_THRESHOLD_HIGH) {
                selected_format = "TNF1024";
                budget_type = "physical";
                reason = "High complexity";
            } else {
                // Interpolate between formats
                var ratio = (d_val - TNF_THRESHOLD_LOW) / (TNF_THRESHOLD_HIGH - TNF_THRESHOLD_LOW);
                if (ratio < 0.25) {
                    selected_format = "TNF16";
                    budget_type = "nominal";
                } else if (ratio < 0.5) {
                    selected_format = "TNF32";
                    budget_type = "nominal";
                } else if (ratio < 0.75) {
                    selected_format = "TNF64";
                    budget_type = "physical";
                } else {
                    selected_format = "TNF256";
                    budget_type = "physical";
                }
                reason = "Medium complexity";
            }
        }

        // Get format index (simplified)
        var format_index : u32 = 0;
        if (selected_format == "TNF8") format_index = 0;
        else if (selected_format == "TNF16") format_index = 1;
        else if (selected_format == "TNF32") format_index = 2;
        else if (selected_format == "TNF64") format_index = 3;
        else if (selected_format == "TNF128") format_index = 4;
        else if (selected_format == "TNF256") format_index = 5;
        else if (selected_format == "TNF512") format_index = 6;
        else format_index = 7;

        physical_cost = get_physical_cost(format_index);

        return (selected_format, budget_type, d_val, verdict, reason, physical_cost);
    }

    // Tests section
    // ============

    test "D metric calculation" {
        var d1 = d_metric(1.0, 2.0, 4.0);
        assert(d1 > 0.0);

        var d2 = d_metric(0.5, 0.25, 0.125);
        assert(d2 > 0.0);

        var d3 = d_metric(-1.0, -2.0, -4.0);
        assert(d3 == 0.0);
    }

    test "TNF range checking" {
        assert(in_tnf_range(1.0) == true);
        assert(in_tnf_range(-20.0) == true);
        assert(in_tnf_range(50.0) == false);
    }

    test "GPT-2 intermediate rejection" {
        var result = tnf_threshold_gate_select(0.1, 0.9, 0.0);
        assert(result.3 == "reject");
    }

    test "Raw SI inverse-square acceptance" {
        var result = tnf_threshold_gate_select(0.25, 0.0, 0.0);
        assert(result.3 == "accept");
        assert(result.0 == "TNF16");
    }

    test "Threshold-based format selection" {
        // Low D value -> TNF8
        var result1 = tnf_threshold_gate_select(1.0, 1.0, 1.0);
        assert(result1.0 == "TNF8");

        // High D value -> TNF1024
        var result2 = tnf_threshold_gate_select(30.0, 30.0, 30.0);
        assert(result2.0 == "TNF1024");
    }

    test "Physical cost reporting" {
        var result = tnf_threshold_gate_select(1.0, 1.0, 1.0);
        assert(result.5 > 0);
        assert(result.1 == "nominal" || result.1 == "physical");
    }

    test "Range validation" {
        var result = tnf_threshold_gate_select(50.0, 0.0, 0.0);
        assert(result.3 == "reject");
    }

    test "GPT-2 pattern coverage" {
        // Test simplified pattern rejection
        var result = tnf_threshold_gate_select(0.1, 0.9, 0.0);
        assert(result.3 == "reject");
    }
}