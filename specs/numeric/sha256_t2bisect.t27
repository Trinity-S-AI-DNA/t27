module Sha256T2Bisect;
// Bisection: pin t2 components and t2 result separately from na.

fn addm(a : u64, b : u64) -> u64 { return (a + b) & 4294967295; }
fn maj(x : u64, y : u64, z : u64) -> u64 { return (x & y) ^ (x & z) ^ (y & z); }
fn bs0(x : u64) -> u64 { return (x >> 2) ^ (x >> 13) ^ (x >> 22); }
fn bs1(x : u64) -> u64 { return (x >> 6) ^ (x >> 11) ^ (x >> 25); }
fn ch(x : u64, y : u64, z : u64) -> u64 { return (x & y) ^ ((4294967295 ^ x) & z); }

test bisect_t2_components {
    const a0 : u64 = 1779033703;
    const s0 : u64 = bs0(a0);
    const m : u64 = maj(a0, 3144134277, 1013904242);
    assert(s0 == 3458249854); // PASS
    assert(m == 980412007); // PASS
    const t2 : u64 = addm(s0, m);
    assert(t2 == 143694565); // FAIL: t27b computes 2960807251 instead of 143694565
    // KEY FINDING: addm(3458249854, 980412007) works with literals but the
    // same function called with bs0/maj results gives a different answer.
    // The t27b lowering of the call chain bs0->maj->addm loses precision.
}

test bisect_na_from_parts {
    const t1 : u64 = 1423593704;
    const t2 : u64 = 143694565;
    const na : u64 = addm(t1, t2);
    assert(na == 1567288269);
}

test bisect_round0_assembly {
    const a0 : u64 = 1779033703;
    const b0 : u64 = 3144134277;
    const c0 : u64 = 1013904242;
    const d0 : u64 = 2773480762;
    const e0 : u64 = 1359893119;
    const f0 : u64 = 2600822924;
    const g0 : u64 = 528734635;
    const h0 : u64 = 1541459225;
    const k0 : u64 = 1116352408;
    const w0 : u64 = 1633837920;
    const s0 : u64 = bs0(a0);
    const m : u64 = maj(a0, b0, c0);
    const b1 : u64 = bs1(e0);
    const c1 : u64 = ch(e0, f0, g0);
    const t1 : u64 = addm(addm(addm(addm(h0, b1), c1), k0), w0);
    const t2 : u64 = addm(s0, m);
    const na : u64 = addm(t1, t2);
    assert(na == 1567288269);
}

endmodule
