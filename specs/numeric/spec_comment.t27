// SPDX-License-Identifier: Apache-2.0
// specs/numeric/spec_comment.t27 -- std::signmag GF-T core: sign-magnitude
// representation for GoldenFloat family widths GF4 through GF1024.
// Part of M5 milestone (milestone #9). Closes #12448.
// phi^2 + 1/phi^2 = 3 | TRINITY

module specs::numeric::signmag;

pub const SIGNMAG_BITS : u32 = 16;
pub const SIGNMAG_EXP_BITS : u32 = 5;
pub const SIGNMAG_MANT_BITS : u32 = 10;

pub struct SignMag { sign: bool, exp: u32, mant: u32 };

pub fn signmag_sign(s: SignMag) -> bool {
    return s.sign;
}

pub fn signmag_exp(s: SignMag) -> u32 {
    return s.exp;
}

pub fn signmag_mant(s: SignMag) -> u32 {
    return s.mant;
}

pub fn signmag_zero() -> SignMag {
    return SignMag { sign: false, exp: 0, mant: 0 };
}

pub fn signmag_one() -> SignMag {
    return SignMag { sign: false, exp: SIGNMAG_EXP_BITS, mant: 0 };
}

pub fn signmag_negate(s: SignMag) -> SignMag {
    return SignMag { sign: !s.sign, exp: s.exp, mant: s.mant };
}

test "signmag_sign" {
    assert(signmag_sign(SignMag { sign: true, exp: 0, mant: 0 }));
    assert(!signmag_sign(SignMag { sign: false, exp: 0, mant: 0 }));
}

test "signmag_exp" {
    assert(signmag_exp(SignMag { sign: false, exp: 5, mant: 0 }) == 5);
}

test "signmag_mant" {
    assert(signmag_mant(SignMag { sign: false, exp: 0, mant: 42 }) == 42);
}

test "signmag_zero" {
    var z = signmag_zero();
    assert(!signmag_sign(z));
    assert(signmag_exp(z) == 0);
    assert(signmag_mant(z) == 0);
}

test "signmag_one" {
    var o = signmag_one();
    assert(!signmag_sign(o));
    assert(signmag_exp(o) == SIGNMAG_EXP_BITS);
    assert(signmag_mant(o) == 0);
}

test "signmag_negate" {
    var s = SignMag { sign: false, exp: 5, mant: 42 };
    var n = signmag_negate(s);
    assert(signmag_sign(n));
    assert(signmag_exp(n) == 5);
    assert(signmag_mant(n) == 42);
}

invariant signmag_bits_positive {
    assert SIGNMAG_BITS > 0;
    assert SIGNMAG_EXP_BITS > 0;
    assert SIGNMAG_MANT_BITS > 0;
}

invariant signmag_bits_sum {
    assert SIGNMAG_BITS == SIGNMAG_EXP_BITS + SIGNMAG_MANT_BITS + 1;
}