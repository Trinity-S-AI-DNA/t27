// ---------------------------------------------------------------- exact integer helpers

/// floor(sqrt(n)) for n >= 0, by bisection.
pub fn isqrt(n: u64) -> u64 {
    var lo : u64 = 0;
    var hi : u64 = 1;
    while (hi * hi <= n) { hi = hi * 2; }
    while (lo + 1 < hi) {
        let mid : u64 = (lo + hi) / 2;
        if (mid * mid <= n) { lo = mid; } else { hi = mid; }
    }
    return lo;
}

/// GF exponent width round((N-1)/phi^2). With a = N-1, (N-1)/phi^2 = (3a - a sqrt5)/2 and a sqrt5 is
/// irrational for a > 0, so the rounded value is floor((3a - isqrt(5 a^2)) / 2).
pub fn gf_exp(n: u64) -> u64 {
    let a : u64 = n - 1;
    if (a <= 0) { return 0; }
    return (3 * a - isqrt(5 * a * a)) / 2;
}

/// (N-1)/phi^2 times 10^4, rounded half up, by the same argument at scale 10^4.
pub fn gf_raw_e4(n: u64) -> u64 {
    let a : u64 = n - 1;
    if (a <= 0) { return 0; }
    return (30000 * a - isqrt(500000000 * a * a)) / 2;
}

pub fn pow_i(b: u64, k: u64) -> u64 {
    var r : u64 = 1;
    var i : u64 = 0;
    while (i < k) { r = r * b; i = i + 1; }
    return r;
}

pub fn fib(k: u64) -> u64 {
    var a : u64 = 0;
    var b : u64 = 1;
    var i : u64 = 0;
    while (i < k) {
        let t : u64 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

/// Lucas numbers by their own recurrence, L_0 = 2, L_1 = 1.
pub fn lucas(k: u64) -> u64 {
    var a : u64 = 2;
    var b : u64 = 1;
    var i : u64 = 0;
    while (i < k) {
        let t : u64 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

/// In Z[phi], phi^k = F_k phi + F_(k-1) and psi^k = F_k psi + F_(k-1), and phi^-1 = -psi, so
/// phi^(2n) + phi^(-2n) = F_(2n) + 2 F_(2n-1). Count the n in 1..45 where that equals L_(2n).
pub fn lucas_count() -> u64 {
    var n : u64 = 1;
    var c : u64 = 0;
    while (n <= 45) {
        if (lucas(2 * n) == fib(2 * n) + 2 * fib(2 * n - 1)) { c = c + 1; }
        n = n + 1;
    }
    return c;
}

/// Integer value of a positive GF16 code (1 sign, 6 exponent, 9 mantissa bits, bias 31), or NONE when
/// the code is negative or special or its value is not an integer.
pub fn gf16_int(code: u64) -> u64 {
    let e : u64 = (code / 512) % 64;
    let m : u64 = code % 512;
    if (e == 63) { return NONE; }
    if (e < 31) { return NONE; }
    var v : u64 = 512 + m;
    var s : u64 = e - 31;
    while (s > 0) { v = v * 2; s = s - 1; }
    if (v % 512 != 0) { return NONE; }
    v = v / 512;
    if (code >= 32768) { return NONE; }
    return v;
}

pub fn sumsq(n: u64) -> u64 {
    var i : u64 = 1;
    var s : u64 = 0;
    while (i <= n) { s = s + i * i; i = i + 1; }
    return s;
}

/// m / unit rounded half to even.
pub fn round_even(m: u64, unit: u64) -> u64 {
    var q : u64 = m / unit;
    let r : u64 = m % unit;
    let half : u64 = unit / 2;
    if (r > half) { q = q + 1; }
    if (r == half) {
        if (q % 2 == 1) { q = q + 1; }
    }
    return q;
}

/// 2^-k to three significant digits: digits * 1000 + the negated decimal exponent.
pub fn pow2_sci3(k: u64) -> u64 {
    var m : u64 = E13;
    var ex : u64 = 0;
    var i : u64 = 0;
    while (i < k) {
        m = m / 2;
        if (m < E13) {
            m = m * 10;
            ex = ex + 1;
        }
        i = i + 1;
    }
    var d : u64 = round_even(m, E10 * 10);
    if (d == 1000) {
        d = 100;
        ex = ex - 1;
    }
    return d * 1000 + ex;
}

/// p/q (0 < p < q) to three significant digits, in the pow2_sci3 encoding.
pub fn ratio_sci3(p0: u64, q: u64) -> u64 {
    var p : u64 = p0;
    var ex : u64 = 0;
    while (p < q) {
        p = p * 10;
        ex = ex + 1;
    }
    let m : u64 = p * S12 / q;
    var d : u64 = round_even(m, E10);
    if (d == 1000) {
        d = 100;
        ex = ex - 1;
    }
    return d * 1000 + ex;
}

/// ln 2 at scale 10^12: sum over k of 1 / (k 2^k).
pub fn ln2_s() -> u64 {
    var s : u64 = 0;
    var k : u64 = 1;
    var p : u64 = 2;
    while (k <= 40) {
        s = s + S12 / (k * p);
        p = p * 2;
        k = k + 1;
    }
    return s;
}

/// ln 3 at scale 10^12: ln 2 + ln(3/2), and ln(3/2) = 2 atanh(1/5) = 2 sum 1 / ((2j+1) 5^(2j+1)).
pub fn ln3_s() -> u64 {
    var s : u64 = 0;
    var j : u64 = 0;
    var p : u64 = 5;
    while (j <= 10) {
        s = s + 2 * S12 / ((2 * j + 1) * p);
        p = p * 25;
        j = j + 1;
    }
    return ln2_s() + s;
}

/// e at scale 10^12: sum of 1/k!.
pub fn e_s() -> u64 {
    var s : u64 = 0;
    var f : u64 = 1;
    var k : u64 = 0;
    while (k <= 17) {
        if (k > 0) { f = f * k; }
        s = s + S12 / f;
        k = k + 1;
    }
    return s;
}

/// How far the radix economy r/ln r sits above its minimum e/ln e = e, in hundredths of a percent.
pub fn radix_bp(r: u64) -> u64 {
    var lnr : u64 = ln2_s();
    if (r == 3) { lnr = ln3_s(); }
    let p : u64 = lnr * (e_s() / M6) / M6;
    let ratio6 : u64 = r * E18 / p;
    return (ratio6 - M6 + 50) / 100;
}

/// kappa(3)/kappa(2) = (4 / (3 ln 3)) / (1 / (2 ln 2)) = 8 ln 2 / (3 ln 3), rounded to dec decimals.
pub fn kappa_ratio(dec: u64) -> u64 {
    let scale : u64 = pow_i(10, dec);
    let l3 : u64 = ln3_s();
    return (16 * scale * ln2_s() + 3 * l3) / (6 * l3);
}

pub fn half_ln2_e4() -> u64 {
    return (ln2_s() + E8) / (2 * E8);
}

pub fn quarter_inv_ln2_e4() -> u64 {
    let l2 : u64 = ln2_s();
    return (2 * E16 + 4 * l2) / (8 * l2);
}

pub fn one_minus_log3_2_e4() -> u64 {
    let l3 : u64 = ln3_s();
    return (20000 * (l3 - ln2_s()) + l3) / (2 * l3);
}

/// 3.0 = 1.5 * 2^1 in a format with m mantissa bits and the given bias, or NONE when m = 0.
pub fn encode3(f: u32) -> u64 {
    let m : u64 = FMT_M[f];
    if (m == 0) { return NONE; }
    return (1 + FMT_BIAS[f]) * pow_i(2, m) + pow_i(2, m - 1);
}

/// Smallest b with 2^b >= v.
pub fn ceil_log2(v: u64) -> u64 {
    var b : u64 = 0;
    var p : u64 = 1;
    while (p < v) {
        p = p * 2;
        b = b + 1;
    }
    return b;
}

/// Members (Et, M) of F_N: 1 + Et + M = N, Et >= 2, M >= 1.
pub fn family_size(n: u64) -> u64 {
    var c : u64 = 0;
    var et : u64 = 2;
    while (et <= n) {
        if (et + 2 <= n) { c = c + 1; }
        et = et + 1;
    }
    return c;
}

// ---------------------------------------------------------------- table counts

pub fn gf_table1_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < GF_ROWS) {
        let e : u64 = gf_exp(GF_N[i]);
        if (e == GF_E_PRINTED[i]) {
            if (GF_N[i] - 1 - e == GF_F_PRINTED[i]) { c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

pub fn gf_raw_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < GF_ROWS) {
        if (gf_raw_e4(GF_N[i]) == GF_RAW_PRINTED[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn t1_pow2_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < T1_ROWS) {
        if (pow2_sci3(T1_M[i] + 1) == T1_POW2[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// Table 1 starts at TNF8, which is rung 1 of the ladder.
pub fn t1_m_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < T1_ROWS) {
        if (T1_M[i] == T1_N[i] - 1 - TNF_ET[i + 1]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn t10_bits_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < T10_ROWS) {
        if (ceil_log2(pow_i(3, T10_ET[i])) == T10_BITS[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn t10_eff_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < T10_ROWS) {
        let num : u64 = pow_i(3, T10_ET[i]) * 1000;
        let den : u64 = pow_i(2, T10_BITS[i]);
        if ((2 * num + den) / (2 * den) == T10_EFF[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn t11_k_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < T11_ROWS) {
        if (T11_N[i] - (1 + T11_ET[i] + T11_M[i]) == T11_K[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// Index of width n in the ladder, or LADDER.
pub fn ladder_index(n: u64) -> u32 {
    var i : u32 = 0;
    while (i < LADDER) {
        if (LADDER_N[i] == n) { return i; }
        i = i + 1;
    }
    return LADDER;
}

pub fn t11_recon_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < T11_ROWS) {
        if (T11_RECON[i] != 0) {
            let j : u32 = ladder_index(T11_N[i]);
            if (T11_RECON[i] == T11_N[i] - 1 - T11_ET[i]) {
                if (j < LADDER) {
                    if (TNF_M[j] == T11_RECON[i]) { c = c + 1; }
                }
            }
        }
        i = i + 1;
    }
    return c;
}

pub fn t22_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < T22_ROWS) {
        var e : u64 = 0;
        var p : u64 = 100;
        while (p < T22_SPAN[i]) {
            p = p * 2;
            e = e + 1;
        }
        if (e == T22_E[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn t24_gft_golden_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < LADDER) {
        let e : u64 = gf_exp(LADDER_N[i]);
        if (T24_GFT_ET[i] == e) {
            if (T24_GFT_M[i] == LADDER_N[i] - 1 - e) { c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

/// Rungs where the golden rule and the reconciled width rule choose the same Et.
pub fn t24_identical_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < LADDER) {
        if (gf_exp(LADDER_N[i]) == TNF_ET[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn t24_sum_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < LADDER) {
        if (1 + T24_TNF_ET[i] + T24_TNF_M[i] == LADDER_N[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn repo_gft_golden_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < LADDER) {
        let e : u64 = gf_exp(LADDER_N[i]);
        if (GFT_ET[i] == e) {
            if (GFT_M[i] == LADDER_N[i] - 1 - e) { c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

pub fn repo_sums_count() -> u64 {
    var i : u32 = 0;
    var c : u64 = 0;
    while (i < LADDER) {
        if (1 + TNF_ET[i] + TNF_M[i] == LADDER_N[i]) { c = c + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < BNF_ROWS) {
        if (1 + BNF_E[i] + BNF_M[i] == BNF_N[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// ---------------------------------------------------------------- dispatch and verdicts

pub fn recompute(kind: u32, arg: u64) -> u64 {
    if (kind == K_GF_EXP) { return gf_exp(arg); }
    if (kind == K_GF_TABLE1) { return gf_table1_count(); }
    if (kind == K_GF_RAW) { return gf_raw_count(); }
    if (kind == K_GF_RAW_ONE) { return gf_raw_e4(arg); }
    if (kind == K_LUCAS_COUNT) { return lucas_count(); }
    if (kind == K_LUCAS) { return lucas(arg); }
    if (kind == K_GF16_DECODE) { return gf16_int(arg); }
    if (kind == K_SUMSQ) { return sumsq(arg); }
    if (kind == K_P_SCI3) { return ratio_sci3(83, 80000); }
    if (kind == K_ENC3) { return encode3(arg as u32); }
    if (kind == K_CLUSTERS) { return CATALOG_CLUSTERS; }
    if (kind == K_RECORDS) { return CATALOG_RECORDS; }
    if (kind == K_T1_POW2) { return t1_pow2_count(); }
    if (kind == K_T1_M) { return t1_m_count(); }
    if (kind == K_HALF_LN2) { return half_ln2_e4(); }
    if (kind == K_QUARTER_INV_LN2) { return quarter_inv_ln2_e4(); }
    if (kind == K_T10_BITS) { return t10_bits_count(); }
    if (kind == K_T10_EFF) { return t10_eff_count(); }
    if (kind == K_T11_K) { return t11_k_count(); }
    if (kind == K_T11_RECON) { return t11_recon_count(); }
    if (kind == K_RADIX_BP) { return radix_bp(arg); }
    if (kind == K_KAPPA) { return kappa_ratio(arg); }
    if (kind == K_ONE_MINUS_LOG3_2) { return one_minus_log3_2_e4(); }
    if (kind == K_T22) { return t22_count(); }
    if (kind == K_FAMILY) { return family_size(arg); }
    if (kind == K_T24_GFT_GOLDEN) { return t24_gft_golden_count(); }
    if (kind == K_T24_IDENTICAL) { return t24_identical_count(); }
    if (kind == K_T24_SUM) { return t24_sum_count(); }
    if (kind == K_TNF16_M) { return 16 - 1 - TNF_ET[2]; }
    if (kind == K_TRIT_RANGE) { return (pow_i(3, arg) - 1) / 2; }
    if (kind == K_TRIT_STEPS) { return pow_i(3, arg); }
    if (kind == K_BNF8_E) { return BNF_E[0]; }
    if (kind == K_REPO_GFT_GOLDEN) { return repo_gft_golden_count(); }
    if (kind == K_REPO_SUMS) { return repo_sums_count(); }
    return 0;
}

pub fn verdict_of(kind: u32, arg: u64, printed: u64) -> u32 {
    if (kind == K_NONE) { return V_UNCHECKED; }
    if (recompute(kind, arg) == printed) { return V_FITS; }
    return V_MISFIT;
}

pub fn row_recomputed(i: u32) -> u64 {
    return recompute(CL_KIND[i], CL_ARG[i]);
}

pub fn row_verdict(i: u32) -> u32 {
    return verdict_of(CL_KIND[i], CL_ARG[i], CL_PRINTED[i]);
}

/// How many rows of a paper (0 = all papers) have verdict v.
pub fn count_verdict(paper: u32, v: u32) -> u32 {
    var i : u32 = 0;
    var c : u32 = 0;
    while (i < ROWS) {
        if (paper == 0 || CL_PAPER[i] == paper) {
            if (row_verdict(i) == v) { c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

// ---------------------------------------------------------------- tests

test "golden rule: exact exponent widths across the ladder" {
    assert gf_exp(4) == 1;
    assert gf_exp(8) == 3;
    assert gf_exp(16) == 6;
    assert gf_exp(32) == 12;
    assert gf_exp(256) == 97;
    assert gf_exp(1024) == 391;
    assert gf_exp(1) == 0;
    assert isqrt(1125) == 33;
    assert isqrt(1089) == 33;
    assert isqrt(1088) == 32;
}

test "golden rule: raw values at scale 10^4" {
    assert gf_raw_e4(4) == 11459;
    assert gf_raw_e4(16) == 57295;
    assert gf_raw_e4(1024) == 3907512;
    assert gf_table1_count() == 17;
    assert gf_raw_count() == 17;
}

test "Lucas and the anchors" {
    assert lucas(2) == 3;
    assert lucas(10) == 123;
    assert fib(10) == 55;
    assert lucas(90) == fib(90) + 2 * fib(89);
    assert lucas_count() == 45;
    assert gf16_int(18368) == 30;
    assert gf16_int(16640) == 3;
    assert gf16_int(16384) == 2;
    assert gf16_int(32768 + 18368) == NONE;
    assert gf16_int(15872) == 1;
    assert gf16_int(15873) == NONE;
    assert sumsq(4) == 30;
}

test "three significant digits, half to even at a tie" {
    assert pow2_sci3(5) == 312002;
    assert pow2_sci3(10) == 977004;
    assert pow2_sci3(53) == 111016;
    assert pow2_sci3(1007) == 729304;
    assert pow2_sci3(1) == 500001;
    assert ratio_sci3(83, 80000) == 104003;
    assert ratio_sci3(1, 8) == 125001;
    assert round_even(125, 10) == 12;
    assert round_even(135, 10) == 14;
    assert round_even(126, 10) == 13;
}

test "3.0 in the six packs" {
    assert encode3(F_BF16) == 16448;
    assert encode3(F_E4M3) == 68;
    assert encode3(F_E5M2) == 66;
    assert encode3(F_E2M1) == 5;
    assert encode3(F_GF16) == 16640;
    assert encode3(F_E8M0) == NONE;
}

test "series constants" {
    assert half_ln2_e4() == 3466;
    assert quarter_inv_ln2_e4() == 3607;
    assert radix_bp(3) == 46;
    assert radix_bp(2) == 615;
    assert kappa_ratio(3) == 1682;
    assert kappa_ratio(2) == 168;
    assert one_minus_log3_2_e4() == 3691;
    assert ln2_s() / 1000 == 693147180;
    assert e_s() / 1000 == 2718281828;
}

test "TNF paper tables" {
    assert t1_pow2_count() == 8;
    assert t1_m_count() == 2;
    assert t10_bits_count() == 7;
    assert t10_eff_count() == 7;
    assert t11_k_count() == 10;
    assert t11_recon_count() == 9;
    assert t22_count() == 4;
    assert family_size(16) == 13;
    assert t24_gft_golden_count() == 1;
    assert t24_identical_count() == 1;
    assert t24_sum_count() == 3;
    assert repo_gft_golden_count() == 9;
    assert repo_sums_count() == 17;
}

test "the verdict of every claim" {
    assert count_verdict(0, V_FITS) == 34;
    assert count_verdict(0, V_MISFIT) == 8;
    assert count_verdict(0, V_UNCHECKED) == 3;
    assert count_verdict(P_GF, V_FITS) == 9;
    assert count_verdict(P_RULER, V_MISFIT) == 1;
    assert count_verdict(P_TNF, V_MISFIT) == 7;
    assert count_verdict(P_TNF, V_FITS) == 15;
    assert count_verdict(P_REPO, V_FITS) == 2;
    assert row_verdict(11) == V_MISFIT;
    assert row_recomputed(11) == 13;
    assert row_verdict(21) == V_MISFIT;
    assert row_recomputed(22) == 11;
    assert row_recomputed(33) == 1682;
    assert row_recomputed(38) == 1;
    assert row_recomputed(41) == 5;
    assert row_verdict(42) == V_UNCHECKED;
}

test "negative control: a printed value off by one is a misfit, and an unchecked row stays unchecked" {
    assert verdict_of(K_GF_EXP, 16, 6) == V_FITS;
    assert verdict_of(K_GF_EXP, 16, 7) == V_MISFIT;
    assert verdict_of(K_KAPPA, 3, 1682) == V_FITS;
    assert verdict_of(K_ENC3, 1, 69) == V_MISFIT;
    assert verdict_of(K_NONE, 0, 35) == V_UNCHECKED;
}

test "the claim table is whole" {
    assert PAPERS[P_TNF] == "TNF paper (Vasilev, 2026-08-11)";
    assert VERDICTS[V_MISFIT] == "does not fit";
    assert CL_PAPER[44] == P_REPO;
    assert CL_KIND[42] == K_NONE;
}
