module Sha256MinRepro;
// MINIMAL REPRO: addm (masked u32 addition) fails when the sum exceeds 2^32.
// addm(3458249854, 980412007) = 4438661861; masked to 32 bits = 143694565.
// The masking idiom `(a + b) & 4294967295` works in the reference but not in t27b.

fn addm(a : u64, b : u64) -> u64 { return (a + b) & 4294967295; }

test addm_no_overflow {
    // sum fits in 32 bits: works
    assert(addm(1000000000, 2000000000) == 3000000000);
}

test addm_with_overflow {
    // sum exceeds 32 bits: FAILS under t27b
    assert(addm(3458249854, 980412007) == 143694565);
}

test addm_boundary {
    // exactly at the boundary
    assert(addm(4294967295, 1) == 0);
}

endmodule
