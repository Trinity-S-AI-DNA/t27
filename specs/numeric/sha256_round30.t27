module Sha256Round30;
// Refs #6940
// Single-round repro: the state entering round 30 of the SHA-256 compress on
// the padded "abc" block (FIPS 180-4), and the registers a and e that round
// 30 produces. This spec isolates round 30 as a self-contained test.

const M32 : u64 = 4294967295;

fn m32(v : u64) -> u64 { return v & M32; }
fn addm(a : u64, b : u64) -> u64 { return (a + b) & M32; }
fn rotr(v : u64, n : u64) -> u64 { return m32((v >> n) | m32(v << (32 - n))); }
fn ch(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ ((M32 ^ x) & z)); }
fn maj(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ (x & z) ^ (y & z)); }
fn bs0(x : u64) -> u64 { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
fn bs1(x : u64) -> u64 { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }

// state entering round 30 (the registers after 30 rounds, rounds 0 to 29, of the abc block)
// Derived with the round functions of sha256.t27 (its FIPS KATs pass; 64 rounds from the IV give the FIPS abc digest), not from this file.
const a30 : u64 = 0xa0060b30;
const b30 : u64 = 0x363482c9;
const c30 : u64 = 0x77d37528;
const d30 : u64 = 0xb62ec4bc;
const e30 : u64 = 0xade79437;
const f30 : u64 = 0x6112a3b7;
const g30 : u64 = 0xedffbff8;
const h30 : u64 = 0xc74c6516;
const k30 : u64 = 0x06ca6351;
const w30 : u64 = 0x702138a4;

/// One compression round: returns new `a`.
pub fn round_a(a : u64, b : u64, c : u64, d : u64, e : u64, f : u64, g : u64, h : u64, k : u64, w : u64) -> u64 {
    const t1 : u64 = addm(addm(addm(addm(h, bs1(e)), ch(e, f, g)), k), w);
    const t2 : u64 = addm(bs0(a), maj(a, b, c));
    return addm(t1, t2);
}

/// One compression round: returns new `e`.
pub fn round_e(d : u64, t1 : u64) -> u64 { return addm(d, t1); }

test round30_na {
    const na : u64 = round_a(a30, b30, c30, d30, e30, f30, g30, h30, k30, w30);
    assert(na == 0xea992a22);
}

test round30_ne {
    const t1 : u64 = addm(addm(addm(addm(h30, bs1(e30)), ch(e30, f30, g30)), k30), w30);
    const ne : u64 = addm(d30, t1);
    assert(ne == 0x0109ab3a);
}

endmodule
