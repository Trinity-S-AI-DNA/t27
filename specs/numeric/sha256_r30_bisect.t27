module Sha256R30Bisect;
// Refs #6940
// Per-sub-expression bisection of round 30: each component asserted against
// the python oracle independently. The first failing assert localizes the
// gen-zig/t27b divergence to a specific sub-expression.

const M32 : u64 = 4294967295;

fn m32(v : u64) -> u64 { return v & M32; }
fn addm(a : u64, b : u64) -> u64 { return (a + b) & M32; }
fn rotr(v : u64, n : u64) -> u64 { return m32((v >> n) | m32(v << (32 - n))); }
fn ch(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ ((M32 ^ x) & z)); }
fn maj(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ (x & z) ^ (y & z)); }
fn bs0(x : u64) -> u64 { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
fn bs1(x : u64) -> u64 { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }

// state entering round 30 (python oracle, round 29 output)
const a30 : u64 = 3935906338; // 0xea992a22
const b30 : u64 = 2684750640; // 0xa0060b30
const c30 : u64 = 909411017;  // 0x363482c9
const d30 : u64 = 2009559336; // 0x77d37528
const e30 : u64 = 17410874;   // 0x0109ab3a
const f30 : u64 = 2917635127; // 0xade79437
const g30 : u64 = 1628611511; // 0x6112a3b7
const h30 : u64 = 4003899591; // 0xedffbff8
const k30 : u64 = 113926993;  // 0x06ca6351
const w30 : u64 = 1881225380; // 0x702138a4

test S1_of_e30 {
    assert(bs1(e30) == 194091673);
}

test Ch_of_e30_f30_g30 {
    assert(ch(e30, f30, g30) == 1628668087);
}

test S0_of_a30 {
    assert(bs0(a30) == 2400818667);
}

test Maj_of_a30_b30_c30 {
    assert(maj(a30, b30, c30) == 2719222304);
}

test t1_assembly_step_by_step {
    const s1 : u64 = bs1(e30);
    const cv : u64 = ch(e30, f30, g30);
    const s0 : u64 = bs0(a30);
    const mj : u64 = maj(a30, b30, c30);
    // step-by-step: h + s1 -> + cv -> + k -> + w
    const t1a : u64 = addm(h30, s1);
    const t1b : u64 = addm(t1a, cv);
    const t1c : u64 = addm(t1b, k30);
    const t1d : u64 = addm(t1c, w30);
    // oracle t1 = 3515165501
    assert(t1d == 3515165501);
}

test t2_assembly_step_by_step {
    const s0 : u64 = bs0(a30);
    const mj : u64 = maj(a30, b30, c30);
    const t2 : u64 = addm(s0, mj);
    assert(t2 == 461113054);
}

test na_full_round {
    const t1 : u64 = addm(addm(addm(addm(h30, bs1(e30)), ch(e30, f30, g30)), k30), w30);
    const t2 : u64 = addm(bs0(a30), maj(a30, b30, c30));
    const na : u64 = addm(t1, t2);
    assert(na == 3935906338);
}


endmodule
