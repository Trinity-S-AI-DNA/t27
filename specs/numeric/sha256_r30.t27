module Sha256R30;
// Refs #6940
// Round 30 sub-expression bisection: the state entering round 30 of the
// SHA-256 compress on the padded "abc" block (FIPS 180-4). Each
// sub-expression is asserted on its own, so the first failing assert
// localises a divergence to one part of the round function.

const M32 : u64 = 4294967295;

fn m32(v : u64) -> u64 { return v & M32; }
fn addm(a : u64, b : u64) -> u64 { return (a + b) & M32; }
fn rotr(v : u64, n : u64) -> u64 { return m32((v >> n) | m32(v << (32 - n))); }
fn ch(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ ((M32 ^ x) & z)); }
fn maj(x : u64, y : u64, z : u64) -> u64 { return m32((x & y) ^ (x & z) ^ (y & z)); }
fn bs0(x : u64) -> u64 { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
fn bs1(x : u64) -> u64 { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }

// state entering round 30 (the registers after 29 rounds of the abc block)
const a30 : u64 = 2684750640; // 0xa0060b30
const b30 : u64 = 909411017;  // 0x363482c9
const c30 : u64 = 2010346792; // 0x77d37528
const d30 : u64 = 3056518332; // 0xb62ec4bc
const e30 : u64 = 2917635127; // 0xade79437
const f30 : u64 = 1628611511; // 0x6112a3b7
const g30 : u64 = 3992961016; // 0xedffbff8
const h30 : u64 = 3343672598; // 0xc74c6516
const k30 : u64 = 113926993;  // 0x06ca6351
const w30 : u64 = 1881225380; // 0x702138a4

test s1_of_e30 {
    assert(bs1(e30) == 2877831540); // 0xab883974
}

test ch_of_e30_f30_g30 {
    assert(ch(e30, f30, g30) == 1629137919); // 0x611aabff
}

test s0_of_a30 {
    assert(bs0(a30) == 1772634236); // 0x69a8407c
}

test maj_of_a30_b30_c30 {
    assert(maj(a30, b30, c30) == 907412264); // 0x36160328
}

test t1_assembly {
    const v : u64 = addm(addm(addm(addm(h30, bs1(e30)), ch(e30, f30, g30)), k30), w30);
    assert(v == 1255859838); // 0x4adae67e, t1 of round 30
}

test t2_assembly {
    const v : u64 = addm(bs0(a30), maj(a30, b30, c30));
    assert(v == 2680046500); // 0x9fbe43a4, t2 of round 30
}

test na_full_round {
    const t1 : u64 = addm(addm(addm(addm(h30, bs1(e30)), ch(e30, f30, g30)), k30), w30);
    const t2 : u64 = addm(bs0(a30), maj(a30, b30, c30));
    const na : u64 = addm(t1, t2);
    assert(na == 3935906338); // 0xea992a22, new a (the a entering round 31)
}


test t1_step_by_step {
    const s1 : u64 = bs1(e30);
    const cv : u64 = ch(e30, f30, g30);
    const t1a : u64 = addm(h30, s1);
    const t1b : u64 = addm(t1a, cv);
    const t1c : u64 = addm(t1b, k30);
    const t1 : u64 = addm(t1c, w30);
    assert(s1 == 0xab883974);
    assert(cv == 0x611aabff);
    assert(t1a == 0x72d49e8a);
    assert(t1b == 0xd3ef4a89);
    assert(t1c == 0xdab9adda);
    assert(t1 == 0x4adae67e);
}

test t2_step_by_step {
    const s0 : u64 = bs0(a30);
    const mj : u64 = maj(a30, b30, c30);
    const t2 : u64 = addm(s0, mj);
    assert(s0 == 0x69a8407c);
    assert(mj == 0x36160328);
    assert(t2 == 0x9fbe43a4);
}

endmodule
