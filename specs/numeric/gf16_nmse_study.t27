/// Port of scripts/gf16_nmse_study.py (deleted in the same commit) into .t27.
/// The script studied value-level round-trip accuracy of GF16 (1/6/9, bias 31)
/// against IEEE fp16 (1/5/10) and bfloat16 (1/8/7): NMSE and max relative error
/// per distribution. The RNG sweeps are replaced by deterministic vectors, so
/// every number here recomputes exactly (L5: f64 assertions carry tolerance).
/// Format constants mirror specs/numeric/gf16.t27 (BIAS 31, mantissa 9, exp 6)
/// but are restated value-level; the bit-level SSOT stays there (L6).

pub const GF16_BIAS : i32 = 31;
pub const GF16_MBITS : i32 = 9;
pub const GF16_EMAX : i32 = 63;
pub const FP16_BIAS : i32 = 15;
pub const FP16_MBITS : i32 = 10;
pub const FP16_EMAX : i32 = 31;
pub const BF16_BIAS : i32 = 127;
pub const BF16_MBITS : i32 = 7;
pub const BF16_EMAX : i32 = 255;

/// 2^e for e in [-60, 60], by squaring-free loop multiplication (exact in f64:
/// every intermediate is a power of two, so no rounding enters).
pub fn pow2i(e : i32) -> f64 {
    var r : f64 = 1.0;
    var i : i32 = 0;
    if (e >= 0) {
        while (i < e) { r = r * 2.0; i += 1; }
    } else {
        while (i > e) { r = r / 2.0; i -= 1; }
    }
    return r;
}

/// floor(log2(a)) for finite a > 0, by binade search (exact: compares against
/// exact powers of two).
pub fn ilog2(a : f64) -> i32 {
    var e : i32 = 0;
    if (a >= 1.0) {
        while (a >= pow2i(e + 1)) { e += 1; }
    } else {
        while (a < pow2i(e)) { e -= 1; }
    }
    return e;
}

/// np.round semantics: round half to even (banker's rounding).
pub fn round_half_even(v : f64) -> f64 {
    var f : f64 = floor_f(v);
    var d : f64 = v - f;
    if (d > 0.5) { f = f + 1.0; }
    if (d == 0.5) {
        var h : f64 = f / 2.0;
        if (fmod1(h) != 0.0) { f = f + 1.0; }
    }
    return f;
}

/// floor for v in the magnitudes this study sees (|v| < 2^40): subtract the
/// largest exact power of two repeatedly until the remainder is below 1.
pub fn floor_f(v : f64) -> f64 {
    if (v >= 0.0) {
        return v - fmod1(v);
    }
    var a : f64 = 0.0 - v;
    var frac : f64 = fmod1(a);
    if (frac == 0.0) { return v; }
    return v - (1.0 - frac);
}

/// v mod 1 for v >= 0 (integer-magnitude f64), by binary decomposition on
/// exact powers of two -- no rounding enters anywhere.
pub fn fmod1(v : f64) -> f64 {
    var r : f64 = v;
    while (r >= 1.0) {
        var q : f64 = 1.0;
        while (q * 2.0 <= r) { q = q * 2.0; }
        r = r - q;
    }
    return r;
}

/// One shared round-trip: encode |x| into (expf, mant) at (bias, mbits), then
/// decode. Mirrors gf16_round in the deleted script; fp16/bf16 differ only in
/// the three constants. expf <= 0 -> 0.0 (no subnormals, as the script did);
/// expf >= emax clips to the max normal 2^(emax-1-bias).
pub fn fmt_round(x : f64, bias : i32, mbits : i32, emax : i32) -> f64 {
    if (x == 0.0) { return 0.0; }
    var s : f64 = 1.0;
    var a : f64 = x;
    if (x < 0.0) { s = 0.0 - 1.0; a = 0.0 - x; }
    var e : i32 = ilog2(a);
    var expf : i32 = e + bias;
    var frac : f64 = a / pow2i(e) - 1.0;
    var scale : f64 = pow2i(mbits);
    var mant : f64 = round_half_even(frac * scale);
    var carry : f64 = 0.0;
    if (mant >= scale) { carry = 1.0; mant = 0.0; }
    var out_exp : i32 = expf;
    if (carry == 1.0) { out_exp = expf + 1; }
    if (out_exp <= 0) { return 0.0; }
    if (out_exp >= emax) { return s * pow2i(emax - 1 - bias); }
    return s * (1.0 + mant / scale) * pow2i(out_exp - bias);
}

pub fn gf16_round(x : f64) -> f64 { return fmt_round(x, GF16_BIAS, GF16_MBITS, GF16_EMAX); }
pub fn fp16_round(x : f64) -> f64 { return fmt_round(x, FP16_BIAS, FP16_MBITS, FP16_EMAX); }
pub fn bf16_round(x : f64) -> f64 { return fmt_round(x, BF16_BIAS, BF16_MBITS, BF16_EMAX); }

/// NMSE = mean((approx-ref)^2) / mean(ref^2) over n samples.
pub fn nmse(ref_v : []f64, approx : []f64, n : usize) -> f64 {
    var se : f64 = 0.0;
    var sv : f64 = 0.0;
    var i : usize = 0;
    while (i < n) {
        var d : f64 = approx[i] - ref_v[i];
        se = se + d * d;
        sv = sv + ref_v[i] * ref_v[i];
        i += 1;
    }
    return se / sv;
}

/// max relative error |approx-ref|/|ref| over the nonzero refs.
pub fn maxrel(ref_v : []f64, approx : []f64, n : usize) -> f64 {
    var m : f64 = 0.0;
    var i : usize = 0;
    while (i < n) {
        if (ref_v[i] != 0.0) {
            var r : f64 = (approx[i] - ref_v[i]) / ref_v[i];
            if (r < 0.0) { r = 0.0 - r; }
            if (r > m) { m = r; }
        }
        i += 1;
    }
    return m;
}

test pow2_and_ilog2_exact {
    assert pow2i(0) == 1.0;
    assert pow2i(9) == 512.0;
    assert pow2i(-9) == 1.0 / 512.0;
    assert ilog2(1.0) == 0;
    assert ilog2(512.0) == 9;
    assert ilog2(511.9) == 8;
    assert ilog2(1e-8) == -27;
}

test round_half_even_ties {
    assert round_half_even(0.5) == 0.0;
    assert round_half_even(1.5) == 2.0;
    assert round_half_even(2.5) == 2.0;
    assert round_half_even(3.5) == 4.0;
    assert round_half_even(2.4) == 2.0;
    assert round_half_even(2.6) == 3.0;
}

test gf16_roundtrip_exact_and_ties {
    // exact in-format values survive bit for bit
    assert gf16_round(1.0) == 1.0;
    assert gf16_round(0.5) == 0.5;
    assert gf16_round(-2.0) == -2.0;
    assert gf16_round(1.001953125) == 1.001953125;  // 1 + 1/512
    // the half-ulp tie rounds to even: 1 + 1.5/512 -> 1 + 2/512
    var tie : f64 = 1.0 + 1.5 / 512.0;
    var want : f64 = 1.0 + 2.0 / 512.0;
    var got : f64 = gf16_round(tie);
    var tol : f64 = 1e-15;
    assert (got - want < tol) && (want - got < tol);
    // carry into the next binade: 1 + 511.6/512 rounds to 2.0
    var c : f64 = gf16_round(1.0 + 511.6 / 512.0);
    assert (c - 2.0 < tol) && (2.0 - c < tol);
}

test gf16_edges_underflow_overflow {
    // underflow: expf <= 0 -> 0 (no subnormals), boundary 2^(1-bias) = 2^-30
    assert gf16_round(pow2i(0 - 30)) == pow2i(0 - 30);
    assert gf16_round(pow2i(0 - 31)) == 0.0;
    assert gf16_round(1e-40) == 0.0;
    // overflow clips to max normal 2^(emax-1-bias) = 2^31
    var big : f64 = gf16_round(1e40);
    var clip : f64 = pow2i(31);
    assert big == clip;
}

test fp16_bf16_shape {
    // fp16 keeps 1/1024 steps in [1,2); bf16 keeps 1/128
    var x : f64 = 1.0 + 3.0 / 1024.0;
    assert fp16_round(x) == x;
    var b : f64 = bf16_round(x);
    // 1 + 3/1024 = 1 + 0.375/128 -> rounds to 1 + 0/128 = 1.0 (tie-less low)
    var want : f64 = 1.0;
    var tol : f64 = 1e-15;
    assert (b - want < tol) && (want - b < tol);
    // fp16 underflow boundary 2^-14, bf16 clips at 2^127
    assert fp16_round(pow2i(0 - 14)) == pow2i(0 - 14);
    assert fp16_round(pow2i(0 - 15)) == 0.0;
    assert bf16_round(1e40) == pow2i(127);
}

test nmse_maxrel_pinned {
    // deterministic vector: 8 samples across binades, GF16's 1/512 step
    var ref_v : [8]f64 = [8]f64{
        1.0, 1.25, 1.5, 3.0, 6.25, 0.75, 12.125, 100.5,
    };
    var approx : [8]f64 = [8]f64{
        gf16_round(1.0), gf16_round(1.25), gf16_round(1.5), gf16_round(3.0),
        gf16_round(6.25), gf16_round(0.75), gf16_round(12.125), gf16_round(100.5),
    };
    var n : usize = 8;
    // GF16 is exact on every value with mantissa in 512 steps used above
    var e : f64 = nmse(&ref_v, &approx, n);
    assert e == 0.0;
    var m : f64 = maxrel(&ref_v, &approx, n);
    assert m == 0.0;
    // and a coarse format shows nonzero, bounded error: bf16 on 1.00390625
    var one : [1]f64 = [1]f64{ 1.00390625 };
    var b1 : [1]f64 = [1]f64{ bf16_round(1.00390625) };
    var m1 : f64 = maxrel(&one, &b1, 1);
    // bf16 step at 1.0 is 1/128; 1.00390625 = 1 + 1/256 rounds to 1.0 (half-to-even)
    var want : f64 = (1.0 / 256.0) / (1.0 + 1.0 / 256.0);
    var tol : f64 = 1e-15;
    assert (m1 - want < tol) && (want - m1 < tol);
}
