module Sha256Micro5;
// ch-family sub-expressions with the CORRECTED oracle (true decimal operands).
// x=2670261550, y=172365677, z=2124455691.

const M32 : u64 = 4294967295;

test a1_and {
    const x : u64 = 2670261550;
    const y : u64 = 172365677;
    assert((x & y) == 168303660);
}

test a2_xor_with_mask {
    const x : u64 = 2670261550;
    assert((M32 ^ x) == 1624498881);
}

test a3_and_after_xor {
    const x : u64 = 2670261550;
    const z : u64 = 2124455691;
    assert(((M32 ^ x) & z) == 1619231233);
}

test a4_full_ch {
    const x : u64 = 2670261550;
    const y : u64 = 172365677;
    const z : u64 = 2124455691;
    assert(((x & y) ^ ((M32 ^ x) & z)) == 1787534893);
}

endmodule
