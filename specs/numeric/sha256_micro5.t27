module Sha256Micro5;
// ch-family sub-expressions. Oracle recomputed nibble by nibble from the hex below;
// the decimals this file held before were wrong, not the compiler.
// x=2670261550 (0x9F28F52E), y=172365677 (0x0A46176D), z=2124455691 (0x7EA09F0B).
// Expected: x&y=0x0A00152C, M32^x=0x60D70AD1, (M32^x)&z=0x60800A01, ch=0x6A801F2D.

const M32 : u64 = 4294967295;

test a1_and {
    const x : u64 = 2670261550;
    const y : u64 = 172365677;
    assert((x & y) == 167777580);
}

test a2_xor_with_mask {
    const x : u64 = 2670261550;
    assert((M32 ^ x) == 1624705745);
}

test a3_and_after_xor {
    const x : u64 = 2670261550;
    const z : u64 = 2124455691;
    assert(((M32 ^ x) & z) == 1619003905);
}

test a4_full_ch {
    const x : u64 = 2670261550;
    const y : u64 = 172365677;
    const z : u64 = 2124455691;
    assert(((x & y) ^ ((M32 ^ x) & z)) == 1786781485);
}

endmodule
