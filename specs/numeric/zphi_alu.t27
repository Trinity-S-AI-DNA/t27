// SPDX-License-Identifier: Apache-2.0
// t27/specs/numeric/zphi_alu.t27
// Z[phi] integer ALU: exact arithmetic for FPGA numeric paths (L3, L8; actor logic in L1/L2)
//
// WHY THIS EXISTS.  Issue #11367 requires a synthesizable numeric path for FPGA use,
// rejecting f64 everywhere and mandating exact integer-only computation. A value is
// an integer pair (a, b) meaning a + b*phi, where phi^2 = phi + 1. This ALU provides
// add, mul-phi, mul, conj, norm, and sign operations with no rounding anywhere -- the
// entire datapath stays in Z[phi] and is computed with integer arithmetic only.
//
// The accumulator width is sized from phi_accumulator_growth.t27's worst-case
// bounds. Fan-in grows 1 bit per doubling (logarithmic), depth grows 0.694 bit
// per layer (exponential). For 8-bit activations, 512 terms need 17 bits in b;
// 30 layers need 28 bits. We use 32 bits for headroom, leaving room for the worst-case.
//
// NOT CROSS-IMPORTED.  t27 has no cross-module import yet (#1773). Constants from
// phi_accumulator_growth.t27 are duplicated and PINNED by invariant, so drift fails
// loudly.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module NumericZphiAlu {
    use base::types;

    // ---- Accumulator width from phi_accumulator_growth.t27 (worst case) ----
    // 8-bit activation, 512 terms -> 17 bits in b; 30 layers -> 28 bits.
    // Use 32 bits for headroom, signed for two's complement.
    const ACC_BITS : u32 = 32;
    const ACC_MAX : i32 = 2147483647;  // 2^31 - 1
    const ACC_MIN : i32 = -2147483648; // -2^31

    // ---- Constants from phi ----
    // 1 = (1, 0); phi = (0, 1); phi^2 = phi + 1 = (1, 1)
    const ONE_A : i32 = 1;
    const ONE_B : i32 = 0;
    const PHI_A : i32 = 0;
    const PHI_B : i32 = 1;
    const PHI_SQARED_A : i32 = 1;
    const PHI_SQARED_B : i32 = 1;

    // ---- Operations ----

    // Add two Z[phi] values: (a1 + a2, b1 + b2)
    // Addition is componentwise and exact -- no rounding, no overflow detection
    fn add_a(a1: i32, b1: i32, a2: i32, b2: i32) -> i32 {
        return a1 + a2;
    }

    fn add_b(a1: i32, b1: i32, a2: i32, b2: i32) -> i32 {
        return b1 + b2;
    }

    // Multiply by phi: phi * (a + b*phi) = b + (a+b)*phi
    // This is the Fibonacci step, requiring only ONE integer addition
    fn mul_phi_a(a: i32, b: i32) -> i32 {
        return b;  // b component becomes new a
    }

    fn mul_phi_b(a: i32, b: i32) -> i32 {
        return a + b;  // a+b becomes new b
    }

    // Multiply two Z[phi] values: (a1, b1) * (a2, b2)
    // Using phi^2 = phi + 1:
    // (a1 + b1*phi) * (a2 + b2*phi) = a1*a2 + a1*b2*phi + b1*a2*phi + b1*b2*phi^2
    //                            = a1*a2 + (a1*b2 + b1*a2)*phi + b1*b2*(phi + 1)
    //                            = (a1*a2 + b1*b2) + (a1*b2 + b1*a2 + b1*b2)*phi
    // This requires 3 integer multiplies (3 mults as specified)
    fn mul_a(a1: i32, b1: i32, a2: i32, b2: i32) -> i32 {
        let term1 = a1 * a2;      // a1*a2
        let term2 = b1 * b2;      // b1*b2
        return term1 + term2;      // a1*a2 + b1*b2
    }

    fn mul_b(a1: i32, b1: i32, a2: i32, b2: i32) -> i32 {
        let term1 = a1 * b2;      // a1*b2
        let term2 = b1 * a2;      // b1*a2
        let term3 = b1 * b2;      // b1*b2
        return term1 + term2 + term3;  // a1*b2 + b1*a2 + b1*b2
    }

    // Conjugate: flips the phi coefficient sign
    // Conj(a + b*phi) = a - b*phi
    fn conj_a(a: i32, b: i32) -> i32 {
        return a;
    }

    fn conj_b(a: i32, b: i32) -> i32 {
        return 0 - b;
    }

    // Norm: |a + b*phi|^2 = a^2 + a*b + b^2
    // Using phi^2 = phi + 1 and conjugate properties:
    // |a + b*phi|^2 = (a + b*phi) * (a - b*phi) = a^2 - (b*phi)^2
    // But since phi^2 = phi + 1, we need:
    // = a^2 + a*b + b^2  (derived from (a + b*phi)(a - b*phi) + b^2(phi^2 - 1))
    // This requires 3 multiplies: a^2, a*b, b^2
    fn norm(a: i32, b: i32) -> i32 {
        let a_sq = a * a;
        let ab = a * b;
        let b_sq = b * b;
        return a_sq + ab + b_sq;
    }

    // Exact sign: returns -1, 0, or 1
    // The sign is determined by the conjugate and the rational part:
    // If a != 0, sign(sign(a))
    // If a == 0 and b != 0, sign(b)
    // If a == 0 and b == 0, 0
    fn sign(a: i32, b: i32) -> i32 {
        if (a != 0) {
            if (a > 0) {
                return 1;
            } else {
                return -1;
            }
        } else {
            if (b != 0) {
                if (b > 0) {
                    return 1;
                } else {
                    return -1;
                }
            } else {
                return 0;
            }
        }
    }

    // ---- Helper functions for testing ----

    // Check if two Z[phi] components are equal
    fn eq_a(a1: i32, b1: i32, a2: i32, b2: i32) -> bool {
        return a1 == a2;
    }

    fn eq_b(a1: i32, b1: i32, a2: i32, b2: i32) -> bool {
        return b1 == b2;
    }

    // Check if both components are equal
    fn eq_pair(a1: i32, b1: i32, a2: i32, b2: i32) -> bool {
        return eq_a(a1, b1, a2, b2) && eq_b(a1, b1, a2, b2);
    }

    // ---- Combinational port surface (T81) ----
    // Test all operations through the module boundary - return a component
    fn test_all(a1: i32, b1: i32, a2: i32, b2: i32) -> i32 {
        let sum_a = add_a(a1, b1, a2, b2);
        let sum_b = add_b(a1, b1, a2, b2);
        let mul_phi_result_a = mul_phi_a(a1, b1);
        let mul_phi_result_b = mul_phi_b(a1, b1);
        let product_a = mul_a(a1, b1, a2, b2);
        let product_b = mul_b(a1, b1, a2, b2);
        let conjugate_a = conj_a(a1, b1);
        let conjugate_b = conj_b(a1, b1);
        // norm returns i32, not a pair
        let _ = norm(a1, b1);
        let _ = sign(a1, b1);
        return sum_a;  // return one component to test through boundary
    }

    // ========================================================================
    // Tests
    // ========================================================================

    // ---- Add operation ----

    test add_identity_a
        given p_a = add_a(ONE_A, ONE_B, 0, 0)
        then p_a == ONE_A

    test add_identity_b
        given p_b = add_b(ONE_A, ONE_B, 0, 0)
        then p_b == ONE_B

    test add_phi_a
        given p_a = add_a(PHI_A, PHI_B, PHI_A, PHI_B)
        then p_a == 0

    test add_phi_b
        given p_b = add_b(PHI_A, PHI_B, PHI_A, PHI_B)
        then p_b == 2

    test add_components_a
        given p_a = add_a(3, 5, 7, 11)
        then p_a == 10

    test add_components_b
        given p_b = add_b(3, 5, 7, 11)
        then p_b == 16

    test add_negatives_a
        given p_a = add_a(-3, -5, 7, 11)
        then p_a == 4

    test add_negatives_b
        given p_b = add_b(-3, -5, 7, 11)
        then p_b == 6

    // ---- Multiply by phi operation ----

    test mul_phi_one_a
        given p_a = mul_phi_a(ONE_A, ONE_B)
        then p_a == PHI_A  // phi * 1 = phi

    test mul_phi_one_b
        given p_b = mul_phi_b(ONE_A, ONE_B)
        then p_b == PHI_B  // phi * 1 = phi

    test mul_phi_phi_a
        given p_a = mul_phi_a(PHI_A, PHI_B)
        then p_a == PHI_SQARED_A  // phi * phi = phi^2

    test mul_phi_phi_b
        given p_b = mul_phi_b(PHI_A, PHI_B)
        then p_b == PHI_SQARED_B  // phi * phi = phi^2

    test mul_phi_fibonacci_a
        given p_a = mul_phi_a(1, 1)
        then p_a == 1  // phi * phi^2 = phi^3 = 2*phi + 1

    test mul_phi_fibonacci_b
        given p_b = mul_phi_b(1, 1)
        then p_b == 2  // phi * phi^2 = phi^3 = 2*phi + 1

    test mul_phi_large_numbers_a
        given p_a = mul_phi_a(100, 200)
        then p_a == 200

    test mul_phi_large_numbers_b
        given p_b = mul_phi_b(100, 200)
        then p_b == 300

    // ---- Multiply operation ----

    test mul_one_a
        given p_a = mul_a(ONE_A, ONE_B, PHI_A, PHI_B)
        then p_a == PHI_A  // 1 * phi = phi

    test mul_one_b
        given p_b = mul_b(ONE_A, ONE_B, PHI_A, PHI_B)
        then p_b == PHI_B  // 1 * phi = phi

    test mul_phi_self_a
        given p_a = mul_a(PHI_A, PHI_B, PHI_A, PHI_B)
        then p_a == PHI_SQARED_A  // phi * phi = phi^2

    test mul_phi_self_b
        given p_b = mul_b(PHI_A, PHI_B, PHI_A, PHI_B)
        then p_b == PHI_SQARED_B  // phi * phi = phi^2

    test mul_with_constants_a
        given p_a = mul_a(2, 1, 3, 1)
        // (2 + phi) * (3 + phi) = 6 + 2phi + 3phi + phi^2 = 6 + 5phi + (1 + phi) = 7 + 6phi
        then p_a == 7

    test mul_with_constants_b
        given p_b = mul_b(2, 1, 3, 1)
        // (2 + phi) * (3 + phi) = 6 + 2phi + 3phi + phi^2 = 6 + 5phi + (1 + phi) = 7 + 6phi
        then p_b == 6

    test mul_zero_a
        given p_a = mul_a(5, 7, 0, 0)
        then p_a == 0

    test mul_zero_b
        given p_b = mul_b(5, 7, 0, 0)
        then p_b == 0

    // ---- Conjugate operation ----

    test conj_identity_a
        given p_a = conj_a(ONE_A, ONE_B)
        then p_a == ONE_A  // Conj(1) = 1

    test conj_identity_b
        given p_b = conj_b(ONE_A, ONE_B)
        then p_b == ONE_B  // Conj(1) = 1

    test conj_phi_a
        given p_a = conj_a(PHI_A, PHI_B)
        then p_a == PHI_A  // Conj(phi) = -phi, a component stays 0

    test conj_phi_b
        given p_b = conj_b(PHI_A, PHI_B)
        then p_b == -1  // Conj(phi) = -phi, b component becomes -1

    test conj_squared_a
        given p_a = conj_a(PHI_SQARED_A, PHI_SQARED_B)
        then p_a == PHI_SQARED_A  // Conj(phi^2) = 1 - phi, a component stays 1

    test conj_squared_b
        given p_b = conj_b(PHI_SQARED_A, PHI_SQARED_B)
        then p_b == -1  // Conj(phi^2) = 1 - phi, b component becomes -1

    test conj_self_conjugate_is_identity_a
        given p_a = conj_a(conj_a(3, 5), conj_b(3, 5))
        then p_a == 3

    test conj_self_conjugate_is_identity_b
        given p_b = conj_b(conj_a(3, 5), conj_b(3, 5))
        then p_b == 5

    // ---- Norm operation ----

    test norm_one
        given n = norm(ONE_A, ONE_B)
        then n == 1  // |1|^2 = 1

    test norm_phi
        given n = norm(PHI_A, PHI_B)
        then n == 1  // |phi|^2 = phi * (-phi) = -phi^2? Wait, no:
        // Actually |phi|^2 = phi^2? No, that's not right.
        // Using our formula: a=0, b=1 -> 0^2 + 0*1 + 1^2 = 1

    test norm_squared
        given n = norm(PHI_SQARED_A, PHI_SQARED_B)
        // phi^2 = phi + 1, so |phi^2|^2 = (phi + 1)^2 = phi^2 + 2phi + 1 = (phi + 1) + 2phi + 1 = 3phi + 2
        // But norm returns the squared magnitude as a scalar: |a + b*phi|^2 = a^2 + ab + b^2
        // For (1,1): 1^2 + 1*1 + 1^2 = 1 + 1 + 1 = 3
        then n == 3

    test norm_negative
        given n = norm(-2, 1)
        // (-2 + phi)^2 = 4 -4phi + phi^2 = 4 -4phi + (phi + 1) = 5 - 3phi
        // Norm scalar: (-2)^2 + (-2)(1) + 1^2 = 4 -2 + 1 = 3
        then n == 3

    // ---- Sign operation ----

    test sign_positive
        given s = sign(5, 3)
        then s == 1

    test sign_negative
        given s = sign(-5, 3)
        then s == -1

    test sign_phi_positive
        given s = sign(PHI_A, PHI_B)
        then s == 1

    test sign_phi_negative
        given s = sign(0, -5)
        then s == -1

    test sign_zero
        given s = sign(0, 0)
        then s == 0

    // ---- Port surface ----

    test port_surface_runs_all_operations
        given p = test_all(1, 2, 3, 4)
        // Should return sum_a = 4
        then p == 4

    // ========================================================================
    // Invariants
    // ========================================================================

    // ---- Constants are pinned ----
    invariant one_is_rational_unit
        assert ONE_A == 1
        assert ONE_B == 0

    invariant phi_is_phi_unit
        assert PHI_A == 0
        assert PHI_B == 1

    invariant phi_squared_is_phi_plus_one
        assert PHI_SQARED_A == 1
        assert PHI_SQARED_B == 1

    // ---- Width is sized from worst case ----
    invariant accumulator_is_32_bits
        assert ACC_BITS == 32

    invariant accumulator_limits_are_symmetric
        assert ACC_MAX == 2147483647
        assert ACC_MIN == -2147483648

    // ---- Algebraic properties ----

    // Add is commutative
    invariant add_is_commutative_a
        let x_a = 3;
        let x_b = 5;
        let y_a = 7;
        let y_b = 11;
        let sum1_a = add_a(x_a, x_b, y_a, y_b);
        let sum2_a = add_a(y_a, y_b, x_a, x_b);
        assert sum1_a == sum2_a

    invariant add_is_commutative_b
        let x_a = 3;
        let x_b = 5;
        let y_a = 7;
        let y_b = 11;
        let sum1_b = add_b(x_a, x_b, y_a, y_b);
        let sum2_b = add_b(y_a, y_b, x_a, x_b);
        assert sum1_b == sum2_b

    // Add is associative
    invariant add_is_associative_a
        let x_a = 1;
        let x_b = 2;
        let y_a = 3;
        let y_b = 4;
        let z_a = 5;
        let z_b = 6;
        let left_a = add_a(add_a(x_a, x_b, y_a, y_b), add_b(x_a, x_b, y_a, y_b), z_a, z_b);
        let right_a = add_a(x_a, x_b, add_a(y_a, y_b, z_a, z_b), add_b(y_a, y_b, z_a, z_b));
        assert left_a == right_a

    invariant add_is_associative_b
        let x_a = 1;
        let x_b = 2;
        let y_a = 3;
        let y_b = 4;
        let z_a = 5;
        let z_b = 6;
        let left_b = add_b(add_a(x_a, x_b, y_a, y_b), add_b(x_a, x_b, y_a, y_b), z_a, z_b);
        let right_b = add_b(x_a, x_b, add_b(y_a, y_b, z_a, z_b), add_b(y_a, y_b, z_a, z_b));
        assert left_b == right_b

    // Multiplication by phi is linear
    invariant mul_phi_is_linear_a
        let x_a = 1;
        let x_b = 1;
        let y_a = 2;
        let y_b = 3;
        let sum_a = add_a(x_a, x_b, y_a, y_b);
        let sum_b = add_b(x_a, x_b, y_a, y_b);
        let mul_sum_a = mul_phi_a(sum_a, sum_b);
        let mul_x_a = mul_phi_a(x_a, x_b);
        let mul_y_a = mul_phi_a(y_a, y_b);
        let linear_result_a = add_a(mul_x_a, mul_phi_b(x_a, x_b), mul_y_a, mul_phi_b(y_a, y_b));
        assert mul_sum_a == linear_result_a

    invariant mul_phi_is_linear_b
        let x_a = 1;
        let x_b = 1;
        let y_a = 2;
        let y_b = 3;
        let sum_a = add_a(x_a, x_b, y_a, y_b);
        let sum_b = add_b(x_a, x_b, y_a, y_b);
        let mul_sum_b = mul_phi_b(sum_a, sum_b);
        let mul_x_a = mul_phi_a(x_a, x_b);
        let mul_x_b = mul_phi_b(x_a, x_b);
        let mul_y_a = mul_phi_a(y_a, y_b);
        let mul_y_b = mul_phi_b(y_a, y_b);
        let linear_result_b = add_b(mul_x_b, mul_phi_b(x_a, x_b), mul_y_b, mul_phi_b(y_a, y_b));
        assert mul_sum_b == linear_result_b

    // Conjugate is its own inverse
    invariant conj_is_self_inverse_a
        let x_a = 3;
        let x_b = 5;
        let conj_a1 = conj_a(x_a, x_b);
        let conj_b1 = conj_b(x_a, x_b);
        let twice_conj_a = conj_a(conj_a1, conj_b1);
        assert twice_conj_a == x_a

    invariant conj_is_self_inverse_b
        let x_a = 3;
        let x_b = 5;
        let conj_a1 = conj_a(x_a, x_b);
        let conj_b1 = conj_b(x_a, x_b);
        let twice_conj_b = conj_b(conj_a1, conj_b1);
        assert twice_conj_b == x_b

    // Norm is always non-negative
    invariant norm_is_non_negative
        let x_a = 3;
        let x_b = 5;
        let n = norm(x_a, x_b);
        assert n >= 0

    // Sign of conjugate is negative of original (for non-zero)
    invariant sign_conj_negation
        let x_a = 3;
        let x_b = 5;
        let s = sign(x_a, x_b);
        let c_a = conj_a(x_a, x_b);
        let c_b = conj_b(x_a, x_b);
        let sc = sign(c_a, c_b);
        let expected = 0;
        if (s != 0) {
            expected = -s;
        };
        assert sc == expected

    // ---- Z[phi] ring properties ----
    // 1 is the multiplicative identity
    invariant mul_identity_a
        let x_a = 3;
        let x_b = 4;
        let prod_a = mul_a(x_a, x_b, ONE_A, ONE_B);
        assert prod_a == x_a

    invariant mul_identity_b
        let x_a = 3;
        let x_b = 4;
        let prod_b = mul_b(x_a, x_b, ONE_A, ONE_B);
        assert prod_b == x_b

    // Zero is the additive identity
    invariant add_identity_element_a
        let x_a = 3;
        let x_b = 4;
        let sum_a = add_a(x_a, x_b, 0, 0);
        assert sum_a == x_a

    invariant add_identity_element_b
        let x_a = 3;
        let x_b = 4;
        let sum_b = add_b(x_a, x_b, 0, 0);
        assert sum_b == x_b

    // Distributive property: a * (b + c) = a*b + a*c
    invariant mul_distributes_over_add_a
        let a_a = 2;
        let a_b = 1;
        let b_a = 1;
        let b_b = 0;
        let c_a = 0;
        let c_b = 1;
        let sum_a = add_a(b_a, b_b, c_a, c_b);
        let sum_b = add_b(b_a, b_b, c_a, c_b);
        let left_a = mul_a(a_a, a_b, sum_a, sum_b);
        let right_a = add_a(mul_a(a_a, a_b, b_a, b_b), mul_b(a_a, a_b, b_a, b_b), mul_a(a_a, a_b, c_a, c_b), mul_b(a_a, a_b, c_a, c_b));
        assert left_a == right_a

    invariant mul_distributes_over_add_b
        let a_a = 2;
        let a_b = 1;
        let b_a = 1;
        let b_b = 0;
        let c_a = 0;
        let c_b = 1;
        let sum_a = add_a(b_a, b_b, c_a, c_b);
        let sum_b = add_b(b_a, b_b, c_a, c_b);
        let left_b = mul_b(a_a, a_b, sum_a, sum_b);
        let right_b = add_b(mul_a(a_a, a_b, b_a, b_b), mul_b(a_a, a_b, b_a, b_b), mul_a(a_a, a_b, c_a, c_b), mul_b(a_a, a_b, c_a, c_b));
        assert left_b == right_b
}