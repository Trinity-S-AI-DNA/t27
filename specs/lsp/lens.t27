// specs/lsp/lens.t27 -- LSP code lens and runnables.
// Part of M1 (milestone #5). Closes #12238.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::lens;

pub struct CodeLens { command: str, range: str };

pub fn code_lens_command(lens: CodeLens) -> str {
    return lens.command;
}

test "code lens command" {
    assert(code_lens_command(CodeLens { command: "run", range: "1-10" }) == "run");
}

invariant code_lens_has_command {
    var l : CodeLens = CodeLens { command: "x", range: "y" };
    assert l.command == "x";
}