// specs/lsp/methods.t27 -- LSP: method registry for all 95 methods.
// Part of M9 milestone (milestone #13). Closes #12212.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::methods;

pub const METHOD_COUNT_317 : u32 = 90;
pub const METHOD_COUNT_318 : u32 = 95;
pub const REQUEST_COUNT_318 : u32 = 69;
pub const NOTIFICATION_COUNT_318 : u32 = 26;
pub const NEW_318_COUNT : u32 = 5;

pub struct Method { name: str, direction: str, kind: str, since: str };

pub fn method_registry_total_318() -> u32 {
    return METHOD_COUNT_318;
}

pub fn method_registry_requests_318() -> u32 {
    return REQUEST_COUNT_318;
}

pub fn method_registry_notifications_318() -> u32 {
    return NOTIFICATION_COUNT_318;
}

test "method_counts_318" {
    assert(method_registry_total_318() == 95);
    assert(method_registry_requests_318() == 69);
    assert(method_registry_notifications_318() == 26);
}

test "new_318_count" {
    assert(NEW_318_COUNT == 5);
    assert(METHOD_COUNT_317 + NEW_318_COUNT == METHOD_COUNT_318);
}

invariant method_counts_consistent {
    assert METHOD_COUNT_317 + NEW_318_COUNT == METHOD_COUNT_318;
    assert REQUEST_COUNT_318 + NOTIFICATION_COUNT_318 == METHOD_COUNT_318;
}