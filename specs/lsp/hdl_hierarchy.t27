// specs/lsp/hdl_hierarchy.t27 -- LSP module instances, hierarchy and signal cone tracing.
// Part of M1 (milestone #5). Closes #12264.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::hdl_hierarchy;

pub struct HdlInstance { name: str, kind: str };

pub fn hdl_instance_name(inst: HdlInstance) -> str {
    return inst.name;
}

test "hdl instance name" {
    assert(hdl_instance_name(HdlInstance { name: "uut", kind: "module" }) == "uut");
}

invariant hdl_instance_has_name {
    var h : HdlInstance = HdlInstance { name: "x", kind: "y" };
    assert h.name == "x";
}