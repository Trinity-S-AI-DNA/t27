// SPDX-License-Identifier: Apache-2.0
// specs/lsp/documents.t27 -- LSP: document store, full and incremental sync.
// Part of M9 milestone (milestone #13). Closes #12214.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::documents;

pub const DOCUMENT_STORE_MAX_DOCUMENTS : u32 = 1024;

pub struct Document { uri: str, version: i32, text: str };

pub struct DocumentStore { count: u32 };

pub fn document_store_count(s: DocumentStore) -> u32 {
    return s.count;
}

pub fn document_version(doc: Document) -> i32 {
    return doc.version;
}

test "document_store_count" {
    assert(document_store_count(DocumentStore { count: 0 }) == 0);
    assert(document_store_count(DocumentStore { count: 5 }) == 5);
}

test "document_version" {
    assert(document_version(Document { uri: "file:///a.t27", version: 1, text: "" }) == 1);
}

invariant document_store_max_positive {
    assert DOCUMENT_STORE_MAX_DOCUMENTS > 0;
}