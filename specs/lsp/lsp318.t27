// specs/lsp/lsp318.t27 -- LSP 3.18 delta: inline completion, virtual documents, snippet edits.
// Part of M1 (milestone #5). Closes #12246.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::lsp318;

pub struct InlineCompletion { item: str, range: str };

pub fn inline_completion_item(c: InlineCompletion) -> str {
    return c.item;
}

test "inline completion item" {
    assert(inline_completion_item(InlineCompletion { item: "foo", range: "1-5" }) == "foo");
}

invariant inline_completion_has_item {
    var c : InlineCompletion = InlineCompletion { item: "x", range: "y" };
    assert c.item == "x";
}