// SPDX-License-Identifier: Apache-2.0
// specs/lsp/docs.t27 -- LSP doc comments, doc links and code blocks in docs.
// Part of M1 (milestone #5). Closes #12259.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::docs;

pub struct DocLink { target: str, text: str };

pub fn doc_link_target(link: DocLink) -> str {
    return link.target;
}

test "doc link target" {
    assert(doc_link_target(DocLink { target: "specs/lsp/lint.t27", text: "lint" }) == "specs/lsp/lint.t27");
}

invariant doc_link_has_target {
    var d : DocLink = DocLink { target: "x", text: "y" };
    assert d.target == "x";
}