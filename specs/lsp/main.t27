// SPDX-License-Identifier: Apache-2.0
// specs/lsp/main.t27 -- LSP: stdio server entry and standalone --check mode.
// Part of M9 milestone (milestone #13). Closes #12216.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::main;

pub const STDIO_SERVER_MODE : str = "stdio";
pub const CHECK_MODE : str = "check";

pub struct ServerMode { mode: str };

pub fn server_mode_is_stdio(m: ServerMode) -> bool {
    return m.mode == STDIO_SERVER_MODE;
}

pub fn server_mode_is_check(m: ServerMode) -> bool {
    return m.mode == CHECK_MODE;
}

test "server_mode_is_stdio" {
    assert(server_mode_is_stdio(ServerMode { mode: STDIO_SERVER_MODE }));
    assert(!server_mode_is_stdio(ServerMode { mode: CHECK_MODE }));
}

test "server_mode_is_check" {
    assert(server_mode_is_check(ServerMode { mode: CHECK_MODE }));
    assert(!server_mode_is_check(ServerMode { mode: STDIO_SERVER_MODE }));
}

invariant stdio_mode_defined {
    assert STDIO_SERVER_MODE == "stdio";
}

invariant check_mode_defined {
    assert CHECK_MODE == "check";
}