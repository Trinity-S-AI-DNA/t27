// specs/lsp/status.t27 -- LSP server status, memory usage, file status and progress.
// Part of M1 (milestone #5). Closes #12251.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::status;

pub struct ServerStatus { state: str, memory_mb: u32 };

pub fn server_status_state(s: ServerStatus) -> str {
    return s.state;
}

test "server status state" {
    assert(server_status_state(ServerStatus { state: "idle", memory_mb: 64 }) == "idle");
}

invariant server_status_has_state {
    var s : ServerStatus = ServerStatus { state: "x", memory_mb: 0 };
    assert s.state == "x";
}