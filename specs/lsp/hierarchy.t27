// specs/lsp/hierarchy.t27 -- LSP call and type hierarchy.
// Part of M1 (milestone #5). Closes #12242.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::hierarchy;

pub struct HierarchyItem { name: str, kind: str, depth: u32 };

pub fn hierarchy_item_depth(item: HierarchyItem) -> u32 {
    return item.depth;
}

test "hierarchy item depth" {
    assert(hierarchy_item_depth(HierarchyItem { name: "f", kind: "function", depth: 2 }) == 2);
}

invariant hierarchy_item_has_name {
    var h : HierarchyItem = HierarchyItem { name: "x", kind: "k", depth: 0 };
    assert h.name == "x";
}