// specs/lsp/notebook.t27 -- LSP notebook document sync.
// Part of M1 (milestone #5). Closes #12247.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::notebook;

pub struct NotebookDoc { uri: str, version: u32, synced: bool };

pub fn notebook_synced(doc: NotebookDoc) -> bool {
    return doc.synced;
}

pub fn notebook_version(doc: NotebookDoc) -> u32 {
    return doc.version;
}

test "notebook synced status" {
    assert(notebook_synced(NotebookDoc { uri: "file:///a.t27", version: 1, synced: true }));
    assert(!notebook_synced(NotebookDoc { uri: "file:///a.t27", version: 1, synced: false }));
}

test "notebook version" {
    assert(notebook_version(NotebookDoc { uri: "x", version: 5, synced: true }) == 5);
}

invariant notebook_has_uri {
    var d : NotebookDoc = NotebookDoc { uri: "x", version: 0, synced: false };
    assert d.uri == "x";
}