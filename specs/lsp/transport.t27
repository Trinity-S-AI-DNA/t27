// specs/lsp/transport.t27 -- LSP: JSON-RPC transport, framing, errors,
// cancellation.
// Part of M9 milestone (milestone #13). Closes #12210.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::transport;

pub const CONTENT_LENGTH_HEADER : str = "Content-Length";
pub const MAX_FRAME_BYTES : u32 = 16 * 1024 * 1024;

pub struct Message { id: u32, method: str };

pub fn message_is_request(m: Message) -> bool {
    return m.id != 0 && m.method != "";
}

pub fn message_is_notification(m: Message) -> bool {
    return m.id == 0 && m.method != "";
}

pub fn message_is_response(m: Message) -> bool {
    return m.id != 0 && m.method == "";
}

pub fn frame_size_exceeded(size: u32) -> bool {
    return size > MAX_FRAME_BYTES;
}

test "message_is_request" {
    assert(message_is_request(Message { id: 1, method: "initialize" }));
    assert(!message_is_request(Message { id: 0, method: "initialized" }));
    assert(!message_is_request(Message { id: 1, method: "" }));
}

test "message_is_notification" {
    assert(message_is_notification(Message { id: 0, method: "initialized" }));
    assert(!message_is_notification(Message { id: 1, method: "initialize" }));
    assert(!message_is_notification(Message { id: 0, method: "" }));
}

test "message_is_response" {
    assert(message_is_response(Message { id: 1, method: "" }));
    assert(!message_is_response(Message { id: 1, method: "initialize" }));
    assert(!message_is_response(Message { id: 0, method: "" }));
}

test "frame_size_exceeded" {
    assert(frame_size_exceeded(MAX_FRAME_BYTES + 1));
    assert(!frame_size_exceeded(MAX_FRAME_BYTES));
}

invariant max_frame_bytes_defined {
    assert MAX_FRAME_BYTES == 16 * 1024 * 1024;
}