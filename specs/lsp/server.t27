// specs/lsp/server.t27 -- LSP: router and honest capabilities.
// Part of M9 milestone (milestone #13). Closes #12217.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::server;

pub const SERVER_CAPABILITIES_MAX : u32 = 16;

pub struct ServerCapability { name: str, advertised: bool, implemented: bool };

pub fn server_capability_honest(c: ServerCapability) -> bool {
    return !c.advertised || c.implemented;
}

pub fn server_capability_advertised(c: ServerCapability) -> bool {
    return c.advertised;
}

test "server_capability_honest" {
    assert(server_capability_honest(ServerCapability { name: "textDocument", advertised: true, implemented: true }));
    assert(!server_capability_honest(ServerCapability { name: "workspace", advertised: true, implemented: false }));
    assert(server_capability_honest(ServerCapability { name: "diagnostic", advertised: false, implemented: false }));
}

test "server_capability_advertised" {
    assert(server_capability_advertised(ServerCapability { name: "textDocument", advertised: true, implemented: true }));
    assert(!server_capability_advertised(ServerCapability { name: "workspace", advertised: false, implemented: true }));
}

invariant server_capabilities_max_positive {
    assert SERVER_CAPABILITIES_MAX > 0;
}