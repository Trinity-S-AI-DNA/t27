// specs/lsp/hw_hints.t27 -- LSP timing and utilisation hints with measured labels.
// Part of M1 (milestone #5). Closes #12265.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::hw_hints;

pub struct TimingHint { label: str, ns: u64 };

pub fn timing_hint_label(h: TimingHint) -> str {
    return h.label;
}

test "timing hint label" {
    assert(timing_hint_label(TimingHint { label: "parse", ns: 1234 }) == "parse");
}

invariant timing_hint_has_label {
    var h : TimingHint = TimingHint { label: "x", ns: 0 };
    assert h.label == "x";
}