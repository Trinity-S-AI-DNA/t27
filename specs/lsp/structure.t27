// specs/lsp/structure.t27 -- LSP folding, selection, linked editing, links, colours.
// Part of M1 (milestone #5). Closes #12232.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::structure;

pub struct FoldRange { start: u32, end: u32 };

pub fn fold_range_length(range: FoldRange) -> u32 {
    return range.end - range.start;
}

test "fold range length" {
    assert(fold_range_length(FoldRange { start: 5, end: 15 }) == 10);
}

invariant fold_range_has_start_end {
    var f : FoldRange = FoldRange { start: 0, end: 0 };
    assert f.start == 0;
}