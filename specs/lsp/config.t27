// specs/lsp/config.t27 -- LSP settings and project config in t27's own format.
// Part of M5 milestone (milestone #9). Closes #12256.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::config;

pub const CONFIG_MAX_KEYS : u32 = 64;

pub struct ConfigEntry { key: str, value: str };

pub struct Config { entries: [64]ConfigEntry, count: u32 };

pub fn config_get(c: Config, key: str) -> str {
    // Linear search; returns empty string if not found.
    var i : u32 = 0;
    while (i < c.count) {
        if (c.entries[i].key == key) {
            return c.entries[i].value;
        }
        i = i + 1;
    }
    return "";
}

pub fn config_count(c: Config) -> u32 {
    return c.count;
}

test "config_get_found" {
    var c = Config { entries: [_]ConfigEntry{ ConfigEntry{ key: "", value: "" } } ** 64, count: 0 };
    assert(config_count(c) == 0);
}

test "config_get_not_found" {
    var c = Config { entries: [_]ConfigEntry{ ConfigEntry{ key: "", value: "" } } ** 64, count: 0 };
    assert(config_get(c, "missing") == "");
    assert(config_count(c) == 0);
}

invariant config_max_keys_positive {
    assert CONFIG_MAX_KEYS > 0;
}