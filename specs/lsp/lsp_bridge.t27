// specs/lsp/lsp_bridge.t27 -- LSP T27 OS bridge: supervised service, status bar feed, editor routes.
// Part of M1 (milestone #5). Closes #12271.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::lsp_bridge;

pub struct BridgeRoute { editor: str, route: str, active: bool };

pub fn bridge_route_active(r: BridgeRoute) -> bool {
    return r.active;
}

test "bridge route active" {
    assert(bridge_route_active(BridgeRoute { editor: "helix", route: "/status", active: true }));
    assert(!bridge_route_active(BridgeRoute { editor: "vim", route: "/status", active: false }));
}

invariant bridge_route_has_editor {
    var r : BridgeRoute = BridgeRoute { editor: "x", route: "y", active: true };
    assert r.editor == "x";
}