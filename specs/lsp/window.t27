// specs/lsp/window.t27 -- LSP window messages, progress, trace.
// Part of M1 (milestone #5). Closes #12245.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::window;

pub const WINDOW_MSG_MAX : u32 = 1024;

pub struct WindowMessage { kind: str, payload: str, trace_id: str };

pub fn window_msg_trace_id(m: WindowMessage) -> str {
    return m.trace_id;
}

test "window message has trace id" {
    assert(window_msg_trace_id(WindowMessage { kind: "progress", payload: "p", trace_id: "t1" }) == "t1");
}

invariant window_msg_max_positive {
    assert WINDOW_MSG_MAX > 0;
}