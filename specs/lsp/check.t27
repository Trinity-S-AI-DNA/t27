// specs/lsp/check.t27 -- LSP check on save.
// Part of M1 (milestone #5). Closes #12255.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::check;

pub struct CheckResult { ok: bool, errors: [16]str, count: u32 };

pub fn check_ok(result: CheckResult) -> bool {
    return result.ok;
}

pub fn check_error_count(result: CheckResult) -> u32 {
    return result.count;
}

test "check passes with no errors" {
    assert(check_ok(CheckResult { ok: true, errors: [_]str{""} ** 16, count: 0 }));
}

test "check fails with errors" {
    assert(!check_ok(CheckResult { ok: false, errors: [_]str{"e1"} ** 16, count: 1 }));
}

test "error count matches" {
    var errs : [16]str = [_]str{""} ** 16;
    errs[0] = "a";
    errs[1] = "b";
    errs[2] = "c";
    assert(check_error_count(CheckResult { ok: false, errors: errs, count: 3 }) == 3);
}

invariant check_result_has_count {
    var c : CheckResult = CheckResult { ok: true, errors: [_]str{""} ** 16, count: 0 };
    assert c.count == 0;
}