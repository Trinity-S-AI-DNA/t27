// specs/lsp/t27f_view.t27 -- LSP: the T27F diagram in the editor.
// Part of M7 milestone (milestone #11). Closes #12253.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::t27f_view;

pub const T27F_VIEW_MAX_NODES : u32 = 1024;

pub struct DiagramView { node_count: u32, rendered: bool };

pub fn diagram_view_rendered(v: DiagramView) -> bool {
    return v.rendered;
}

test "diagram_view_rendered" {
    assert(diagram_view_rendered(DiagramView { node_count: 10, rendered: true }));
    assert(!diagram_view_rendered(DiagramView { node_count: 10, rendered: false }));
}

invariant t27f_view_max_nodes_positive {
    assert T27F_VIEW_MAX_NODES > 0;
}