// SPDX-License-Identifier: Apache-2.0
// specs/lsp/lint.t27 -- LSP lint engine: rules, profiles, waivers and autofix.
// Part of M1 (milestone #5). Closes #12257.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::lint;

pub struct Rule { id: str, severity: str, enabled: bool };
pub struct Profile { name: str, rules: [16]Rule, count: u32 };
pub struct Waiver { rule_id: str, range: str, reason: str };

pub fn rule_enabled(r: Rule) -> bool {
    return r.enabled;
}

pub fn profile_rule_count(p: Profile) -> u32 {
    return p.count;
}

pub fn waiver_covers(waiver: Waiver, rule_id: str) -> bool {
    return waiver.rule_id == rule_id;
}

test "rule enabled check" {
    assert(rule_enabled(Rule { id: "r1", severity: "error", enabled: true }));
    assert(!rule_enabled(Rule { id: "r2", severity: "warn", enabled: false }));
}

test "profile rule count" {
    assert(profile_rule_count(Profile { name: "p1", rules: [_]Rule{ Rule{ id: "", severity: "", enabled: false } } ** 16, count: 3 }) == 3);
}

test "waiver covers matching rule" {
    assert(waiver_covers(Waiver { rule_id: "r1", range: "1-5", reason: "false positive" }, "r1"));
    assert(!waiver_covers(Waiver { rule_id: "r1", range: "1-5", reason: "false positive" }, "r2"));
}

invariant rule_has_id {
    var r : Rule = Rule { id: "x", severity: "e", enabled: true };
    assert r.id == "x";
}