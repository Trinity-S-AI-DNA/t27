// specs/lsp/views.t27 -- LSP: views, syntax tree, IR, generated output, call
// graph.
// Part of M7 milestone (milestone #11). Closes #12252.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::views;

pub const VIEWS_MAX_KINDS : u32 = 8;

pub struct ViewKind { kind: str, enabled: bool };

pub fn view_kind_enabled(v: ViewKind) -> bool {
    return v.enabled;
}

test "view_kind_enabled" {
    assert(view_kind_enabled(ViewKind { kind: "syntax_tree", enabled: true }));
    assert(!view_kind_enabled(ViewKind { kind: "ir", enabled: false }));
}

invariant views_max_kinds_positive {
    assert VIEWS_MAX_KINDS > 0;
}