// SPDX-License-Identifier: Apache-2.0
// specs/lsp/vscode_client.t27 -- LSP: VS Code client generated from the
// client spec.
// Part of M1 (milestone #5). Closes #12266.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::vscode_client;

pub struct VscodeClient { generated: bool, client_spec: str };

pub fn vscode_client_generated(c: VscodeClient) -> bool {
    return c.generated;
}

test "vscode client generated" {
    assert(vscode_client_generated(VscodeClient { generated: true, client_spec: "specs/lsp/client.t27" }));
    assert(!vscode_client_generated(VscodeClient { generated: false, client_spec: "specs/lsp/client.t27" }));
}