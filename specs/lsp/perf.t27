// specs/lsp/perf.t27 -- LSP persisted index and performance budgets.
// Part of M1 (milestone #5). Closes #12261.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::perf;

pub const PERF_BUDGET_MS : u32 = 100;

pub struct PerfBudget { op: str, max_ms: u32 };

pub fn perf_budget_within(b: PerfBudget, actual_ms: u32) -> bool {
    return actual_ms <= b.max_ms;
}

test "perf budget within limit" {
    assert(perf_budget_within(PerfBudget { op: "parse", max_ms: 100 }, 50));
    assert(!perf_budget_within(PerfBudget { op: "parse", max_ms: 100 }, 150));
}

invariant perf_budget_ms_positive {
    assert PERF_BUDGET_MS > 0;
}