// specs/lsp/inactive.t27 -- LSP inactive regions and reachability.
// Part of M1 (milestone #5). Closes #12258.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::inactive;

pub struct Region { start: u32, end: u32, inactive: bool };

pub fn region_is_inactive(r: Region) -> bool {
    return r.inactive;
}

test "region inactive flag" {
    assert(region_is_inactive(Region { start: 0, end: 10, inactive: true }));
    assert(!region_is_inactive(Region { start: 0, end: 10, inactive: false }));
}

invariant region_has_bounds {
    var r : Region = Region { start: 0, end: 5, inactive: false };
    assert r.start == 0;
}