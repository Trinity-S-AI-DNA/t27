// specs/lsp/code_actions.t27 -- LSP code action framework.
// Part of M1 (milestone #5). Closes #12234.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::code_actions;

pub struct CodeAction { title: str, kind: str };

pub fn code_action_title(action: CodeAction) -> str {
    return action.title;
}

test "code action title" {
    assert(code_action_title(CodeAction { title: "fix", kind: "quickfix" }) == "fix");
}

invariant code_action_has_title {
    var a : CodeAction = CodeAction { title: "x", kind: "y" };
    assert a.title == "x";
}