// specs/lsp/edit_helpers.t27 -- LSP edit helpers: join lines, on enter, move item, matching brace, ssr.
// Part of M1 (milestone #5). Closes #12254.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::edit_helpers;

pub const EDIT_HELPER_MAX : u32 = 8;

pub struct EditHelper { name: str, kind: str };

pub fn edit_helper_name(h: EditHelper) -> str {
    return h.name;
}

test "edit helper name" {
    assert(edit_helper_name(EditHelper { name: "join_lines", kind: "edit" }) == "join_lines");
}

invariant edit_helper_max_positive {
    assert EDIT_HELPER_MAX > 0;
}