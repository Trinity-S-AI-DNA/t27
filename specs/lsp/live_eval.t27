// SPDX-License-Identifier: Apache-2.0
// specs/lsp/live_eval.t27 -- LSP: live evaluation of expressions, constants
// and test values.
// Part of M7 milestone (milestone #11). Closes #12260.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::live_eval;

pub const LIVE_EVAL_MAX_EXPRS : u32 = 32;

pub struct EvalResult { expr: str, value: str, ok: bool };

pub fn eval_result_ok(r: EvalResult) -> bool {
    return r.ok;
}

test "eval_result_ok" {
    assert(eval_result_ok(EvalResult { expr: "1+1", value: "2", ok: true }));
    assert(!eval_result_ok(EvalResult { expr: "1/0", value: "", ok: false }));
}

invariant live_eval_max_exprs_positive {
    assert LIVE_EVAL_MAX_EXPRS > 0;
}