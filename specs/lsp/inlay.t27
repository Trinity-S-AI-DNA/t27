// specs/lsp/inlay.t27 -- LSP inlay hints and inline values.
// Part of M1 (milestone #5). Closes #12233.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::inlay;

pub struct InlayHint { text: str, position: u32 };

pub fn inlay_hint_text(hint: InlayHint) -> str {
    return hint.text;
}

test "inlay hint text" {
    assert(inlay_hint_text(InlayHint { text: "i32", position: 10 }) == "i32");
}

invariant inlay_hint_has_text {
    var h : InlayHint = InlayHint { text: "x", position: 0 };
    assert h.text == "x";
}