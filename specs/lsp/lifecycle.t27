// specs/lsp/lifecycle.t27 -- LSP: lifecycle, capability negotiation, dynamic
// registration, position encodings.
// Part of M9 milestone (milestone #13). Closes #12213.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::lifecycle;

pub const STATE_UNINITIALIZED : str = "uninitialized";
pub const STATE_INITIALIZING : str = "initializing";
pub const STATE_RUNNING : str = "running";
pub const STATE_SHUTDOWN : str = "shutdown";
pub const STATE_EXITED : str = "exited";

pub struct ServerState { current: str };

pub fn server_state_is(m: ServerState, expected: str) -> bool {
    return m.current == expected;
}

pub fn error_code_server_not_initialized() -> i32 {
    return -32002;
}

pub fn error_code_after_shutdown() -> i32 {
    return -32600;
}

test "state_transitions" {
    assert(server_state_is(ServerState { current: STATE_UNINITIALIZED }, STATE_UNINITIALIZED));
    assert(server_state_is(ServerState { current: STATE_RUNNING }, STATE_RUNNING));
    assert(!server_state_is(ServerState { current: STATE_SHUTDOWN }, STATE_RUNNING));
}

test "error_codes" {
    assert(error_code_server_not_initialized() == -32002);
    assert(error_code_after_shutdown() == -32600);
}

invariant state_constants_defined {
    assert STATE_UNINITIALIZED == "uninitialized";
    assert STATE_RUNNING == "running";
    assert STATE_EXITED == "exited";
}