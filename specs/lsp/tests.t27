// specs/lsp/tests.t27 -- LSP test explorer.
// Part of M1 (milestone #5). Closes #12239.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::tests;

pub struct TestCase { id: str, passed: bool };

pub fn test_case_passed(t: TestCase) -> bool {
    return t.passed;
}

test "test case passed check" {
    assert(test_case_passed(TestCase { id: "t1", passed: true }));
    assert(!test_case_passed(TestCase { id: "t2", passed: false }));
}

invariant test_case_has_id {
    var t : TestCase = TestCase { id: "x", passed: true };
    assert t.id == "x";
}