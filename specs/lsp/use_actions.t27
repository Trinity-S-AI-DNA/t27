// specs/lsp/use_actions.t27 -- LSP use hygiene actions.
// Part of M1 (milestone #5). Closes #12235.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::use_actions;

pub const USE_ACTION_MAX : u32 = 32;

pub struct UseAction { name: str, applies_to: str };

pub fn use_action_name(action: UseAction) -> str {
    return action.name;
}

test "use action name" {
    assert(use_action_name(UseAction { name: "add_use", applies_to: "spec" }) == "add_use");
}

invariant use_action_max_positive {
    assert USE_ACTION_MAX > 0;
}