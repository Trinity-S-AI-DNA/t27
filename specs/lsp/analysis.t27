// SPDX-License-Identifier: Apache-2.0
// specs/lsp/analysis.t27 -- LSP: analysis snapshot shared by every provider.
// Part of M9 milestone (milestone #13). Closes #12215.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::analysis;

pub const ANALYSIS_SNAPSHOT_MAX_PROVIDERS : u32 = 16;

pub struct ProviderSnapshot { name: str, version: u32, ready: bool };

pub struct AnalysisSnapshot { providers: u32 };

pub fn analysis_snapshot_provider_count(s: AnalysisSnapshot) -> u32 {
    return s.providers;
}

pub fn provider_snapshot_ready(p: ProviderSnapshot) -> bool {
    return p.ready;
}

test "analysis_snapshot_provider_count" {
    assert(analysis_snapshot_provider_count(AnalysisSnapshot { providers: 0 }) == 0);
    assert(analysis_snapshot_provider_count(AnalysisSnapshot { providers: 3 }) == 3);
}

test "provider_snapshot_ready" {
    assert(provider_snapshot_ready(ProviderSnapshot { name: "t27core", version: 1, ready: true }));
    assert(!provider_snapshot_ready(ProviderSnapshot { name: "t27b", version: 0, ready: false }));
}

invariant analysis_snapshot_max_providers_positive {
    assert ANALYSIS_SNAPSHOT_MAX_PROVIDERS > 0;
}