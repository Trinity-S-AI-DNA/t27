// specs/lsp/workspace.t27 -- LSP workspace folders, settings, watched files, commands.
// Part of M1 (milestone #5). Closes #12243.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::workspace;

pub const WORKSPACE_MAX_FOLDERS : u32 = 64;

pub struct WorkspaceConfig { folders: [64]str, folder_count: u32 };

pub fn workspace_folder_count(config: WorkspaceConfig) -> u32 {
    return config.folder_count;
}

test "workspace folder count" {
    assert(workspace_folder_count(WorkspaceConfig {
        folders: [_]str{""} ** 64, folder_count: 3
    }) == 3);
}

invariant workspace_max_folders_positive {
    assert WORKSPACE_MAX_FOLDERS > 0;
}