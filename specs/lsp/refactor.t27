// specs/lsp/refactor.t27 -- LSP: refactorings.
// Part of M4 milestone (milestone #8). Closes #12236.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::refactor;

pub const LSP_REFACTOR_MAX_KINDS : u32 = 8;

pub struct RefactorKind { kind: str, applied: bool };

pub fn refactor_kind_applied(r: RefactorKind) -> bool {
    return r.applied;
}

test "refactor_kind_applied" {
    assert(refactor_kind_applied(RefactorKind { kind: "extract_method", applied: true }));
    assert(!refactor_kind_applied(RefactorKind { kind: "inline", applied: false }));
}

invariant lsp_refactor_max_kinds_positive {
    assert LSP_REFACTOR_MAX_KINDS > 0;
}