// specs/lsp/conformance.t27 -- LSP conformance harness and generated feature matrix.
// Part of M5 milestone (milestone #9). Closes #12268.
// phi^2 + 1/phi^2 = 3 | TRINITY

module lsp::conformance;

pub const CONFORMANCE_MAX_FEATURES : u32 = 32;

pub struct Feature { name: str, supported: bool };

pub struct ConformanceResult { features: [32]Feature, feature_count: u32, passed: u32 };

pub fn conformance_passed(r: ConformanceResult) -> bool {
    return r.passed == r.feature_count;
}

pub fn conformance_feature_count(r: ConformanceResult) -> u32 {
    return r.feature_count;
}

test "conformance_all_passed" {
    var r = ConformanceResult {
        features: [_]Feature{ Feature{ name: "", supported: false } } ** 32,
        feature_count: 3,
        passed: 3,
    };
    assert(conformance_passed(r));
}

test "conformance_not_all_passed" {
    var r = ConformanceResult {
        features: [_]Feature{ Feature{ name: "", supported: false } } ** 32,
        feature_count: 3,
        passed: 2,
    };
    assert(!conformance_passed(r));
}

invariant conformance_max_features_positive {
    assert CONFORMANCE_MAX_FEATURES > 0;
}