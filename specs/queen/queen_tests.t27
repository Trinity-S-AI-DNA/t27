// SPDX-License-Identifier: Apache-2.0
// specs/queen/queen_tests.t27 - Comprehensive tests for Queen task system
module queen::tests {
    use queen::tasks::{QueenTask, TaskStatus, Evidence, TaskIssueMapping};
    use queen::tasks::{task_create_from_incident, task_create_github_issue, task_claim, task_update_status};
    use queen::incident_adapter::{incident_to_queen_task, incident_to_task_and_issue, DoctorIncident};
    use github::issues::{Issue, ISSUE_STATE_OPEN};
    use github::comments::Comment;

    // Test suite: Queen Foundation Verification
    test_suite "queen_foundation_verification" {
        // Test 1: Incident creates persistent Queen task
        test "incident_creates_persistent_task" {
            var incident_evidence: [Evidence] = undefined;
            var incident: DoctorIncident = undefined;
            incident.id = "test-incident-001";
            incident.title = "Database Connection Error";
            incident.description = "Users unable to connect to primary database";
            incident.severity = "high";
            incident.created_at = "2024-01-01T10:00:00Z";
            incident.status = "open";
            incident.evidence = incident_evidence;
            
            var task = incident_to_queen_task(incident);
            
            // Verify persistence properties
            assert(task.id > 0);
            assert(task.title == "[INCIDENT] Database Connection Error");
            assert(task.status == TaskStatus.OPEN);
            assert(task.owner == "");
            assert(task.incident_id == "test-incident-001");
            assert(task.created_at == "2024-01-01T10:00:00Z");
            
            // Verify evidence preservation
            assert(task.evidence.len == 1);
            assert(task.evidence[0].content.contains("Database Connection Error"));
            assert(task.evidence[0].source == "incident");
        }

        // Test 2: Task creates/links GitHub Issue
        test "task_creates_github_issue" {
            var initial_evidence: [Evidence] = undefined;
            var task = task_create_from_incident(
                "API Rate Limit Exceeded",
                "incident-api-002",
                initial_evidence
            );
            
            var (issue_id, issue_url) = task_create_github_issue(task);
            
            // Verify issue creation
            assert(issue_id > 0);
            assert(issue_url.contains("github.com"));
            assert(issue_url.contains("API Rate Limit Exceeded"));
            
            // Verify task-issue linking
            assert(task.github_issue_id == issue_id);
        }

        // Test 3: Agent can atomically claim issue
        test "atomic_claim_protocol" {
            var initial_evidence: [Evidence] = undefined;
            var task = task_create_from_incident(
                "Payment Processing Failure",
                "incident-payment-003",
                initial_evidence
            );
            
            // First agent claims task
            var first_agent = "queen-agent-alpha";
            var first_claim = task_claim(task, first_agent);
            
            assert(first_claim == true);
            assert(task.status == TaskStatus.CLAIMED);
            assert(task.owner == first_agent);
            
            // Second agent cannot claim same task
            var second_agent = "queen-agent-beta";
            var second_claim = task_claim(task, second_agent);
            
            assert(second_claim == false);
            assert(task.owner == first_agent);  // Still owned by first agent
        }

        // Test 4: Status and evidence updates are visible
        test "status_and_evidence_visibility" {
            var initial_evidence: [Evidence] = undefined;
            var task = task_create_from_incident(
                "User Authentication Bug",
                "incident-auth-004",
                initial_evidence
            );
            
            // Create multiple evidence entries
            for (var i = 0; i < 5; i++) {
                var evidence: Evidence = undefined;
                evidence.id = 1000u64 + i;
                evidence.timestamp = format!("2024-01-01T10:{:02d}:00Z", i * 10);
                evidence.content = format!("Investigation step {}", i + 1);
                evidence.source = "agent";
                
                task = task_update_status(task, TaskStatus.IN_PROGRESS, evidence);
            }
            
            // Verify all updates are visible
            assert(task.status == TaskStatus.IN_PROGRESS);
            assert(task.evidence.len == 5);
            assert(task.updated_at > task.created_at);
            
            // Verify evidence ordering and content
            for (var i = 0; i < 5; i++) {
                assert(task.evidence[i].content == format!("Investigation step {}", i + 1));
                assert(task.evidence[i].source == "agent");
            }
        }

        // Test 5: Complete workflow from incident to resolution
        test "complete_incident_to_resolution_workflow" {
            // Step 1: Create incident
            var incident_evidence: [Evidence] = undefined;
            var incident: DoctorIncident = undefined;
            incident.id = "incident-workflow-005";
            incident.title = "Email Delivery Failure";
            incident.description = "Transactional emails not being sent";
            incident.severity = "critical";
            incident.created_at = "2024-01-01T09:00:00Z";
            incident.status = "open";
            incident.evidence = incident_evidence;
            
            // Step 2: Convert to task and create GitHub issue
            var (task, issue_id, issue_url) = incident_to_task_and_issue(incident);
            
            assert(task.status == TaskStatus.OPEN);
            assert(task.github_issue_id == issue_id);
            
            // Step 3: Agent claims task
            var claim_success = task_claim(task, "agent-resolution-team");
            assert(claim_success == true);
            assert(task.status == TaskStatus.CLAIMED);
            
            // Step 4: Agent updates task progress
            var progress_evidence: Evidence = undefined;
            progress_evidence.id = 2000u64;
            progress_evidence.timestamp = "2024-01-01T10:30:00Z";
            progress_evidence.content = "Identified SMTP configuration issue";
            progress_evidence.source = "agent";
            
            task = task_update_status(task, TaskStatus.IN_PROGRESS, progress_evidence);
            assert(task.status == TaskStatus.IN_PROGRESS);
            assert(task.evidence.len == 2);  // Incident + progress evidence
            
            // Step 5: Task completion
            var completion_evidence: Evidence = undefined;
            completion_evidence.id = 3000u64;
            completion_evidence.timestamp = "2024-01-01T11:00:00Z";
            completion_evidence.content = "SMTP configuration fixed, email delivery restored";
            completion_evidence.source = "agent";
            
            task = task_update_status(task, TaskStatus.COMPLETED, completion_evidence);
            assert(task.status == TaskStatus.COMPLETED);
            assert(task.evidence.len == 3);
        }

        // Test 6: Multiple agents claiming different tasks
        test "concurrent_task_claiming" {
            // Create multiple test tasks
            var task1 = task_create_from_incident("Task Alpha", "incident-alpha-001", undefined);
            var task2 = task_create_from_incident("Task Beta", "incident-beta-002", undefined);
            var task3 = task_create_from_incident("Task Gamma", "incident-gamma-003", undefined);
            
            // Different agents claim different tasks
            assert(task_claim(task1, "agent-1") == true);
            assert(task_claim(task2, "agent-2") == true);
            assert(task_claim(task3, "agent-3") == true);
            
            // Verify ownership
            assert(task1.owner == "agent-1");
            assert(task2.owner == "agent-2");
            assert(task3.owner == "agent-3");
            
            // Verify no cross-contamination
            assert(task_claim(task1, "agent-2") == false);  // Already claimed by agent-1
            assert(task_claim(task2, "agent-3") == false);  // Already claimed by agent-2
            assert(task_claim(task3, "agent-1") == false);  // Already claimed by agent-3
        }

        // Test 7: Evidence integrity and timestamps
        test "evidence_integrity" {
            var initial_evidence: [Evidence] = undefined;
            var task = task_create_from_incident("Evidence Integrity Test", "incident-evidence-006", initial_evidence);
            
            var initial_time = task.created_at;
            
            // Add multiple evidence entries
            for (var i = 0; i < 3; i++) {
                var evidence: Evidence = undefined;
                evidence.id = 4000u64 + i;
                evidence.timestamp = format!("2024-01-01T12:{:02d}:00Z", i * 15);
                evidence.content = format!("Evidence entry {}", i + 1);
                evidence.source = "system";
                
                task = task_update_status(task, TaskStatus.IN_PROGRESS, evidence);
            }
            
            // Verify evidence is appended (not replaced)
            assert(task.evidence.len == 4);  // Initial + 3 new entries
            
            // Verify timestamps are sequential
            assert(task.evidence[0].timestamp == initial_time);
            assert(task.evidence[1].timestamp == "2024-01-01T12:00:00Z");
            assert(task.evidence[2].timestamp == "2024-01-01T12:15:00Z");
            assert(task.evidence[3].timestamp == "2024-01-01T12:30:00Z");
            
            // Verify task update time reflects latest change
            assert(task.updated_at == "2024-01-01T12:30:00Z");
        }
    }

    // Test suite: Edge Cases and Error Handling
    test_suite "edge_cases" {
        // Test: Task with no initial evidence
        test "task_with_no_evidence" {
            var empty_evidence: [Evidence] = undefined;
            var task = task_create_from_incident("No Evidence Test", "incident-empty-007", empty_evidence);
            
            assert(task.evidence.len == 0);
            assert(task.status == TaskStatus.OPEN);
        }

        // Test: Task claiming with empty agent ID
        test "claim_with_empty_agent" {
            var initial_evidence: [Evidence] = undefined;
            var task = task_create_from_incident("Empty Agent Test", "incident-empty-008", initial_evidence);
            
            var claim_success = task_claim(task, "");
            assert(claim_success == false);  // Should not allow empty agent ID
            assert(task.status == TaskStatus.OPEN);  // Status unchanged
        }
    }

    // Benchmark suite for performance testing
    benchmark_suite "queen_task_performance" {
        benchmark "large_evidence_array" {
            var task: QueenTask = undefined;
            task.id = 999999u64;
            task.title = "Performance Test Task";
            task.status = TaskStatus.OPEN;
            task.owner = "";
            task.github_issue_id = 0;
            task.created_at = "2024-01-01T00:00:00Z";
            task.updated_at = "2024-01-01T00:00:00Z";
            task.incident_id = "incident-perf-001";
            
            // Create large evidence array
            var large_evidence: [Evidence] = undefined;
            for (var i = 0; i < 1000; i++) {
                var evidence: Evidence = undefined;
                evidence.id = i;
                evidence.timestamp = "2024-01-01T00:00:00Z";
                evidence.content = format!("Evidence item {}", i);
                evidence.source = "benchmark";
                large_evidence.push(evidence);
            }
            
            task.evidence = large_evidence;
            
            // Test performance of evidence operations
            var start_time = timestamp_ms();
            
            // Simulate multiple status updates
            for (var i = 0; i < 100; i++) {
                var evidence: Evidence = undefined;
                evidence.id = 1000u64 + i;
                evidence.timestamp = "2024-01-01T00:00:00Z";
                evidence.content = format!("Update {}", i);
                evidence.source = "benchmark";
                task = task_update_status(task, TaskStatus.IN_PROGRESS, evidence);
            }
            
            var end_time = timestamp_ms();
            var duration_ms = end_time - start_time;
            
            // Verify operation completed within reasonable time
            assert(duration_ms < 5000);  // Should complete within 5 seconds
            assert(task.evidence.len == 1100);  // 1000 initial + 100 updates
        }
    }
}