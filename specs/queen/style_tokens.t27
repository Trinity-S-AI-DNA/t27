// SPDX-License-Identifier: Apache-2.0
// specs/queen/style_tokens.t27 -- queen: ring 4 Style tokens, chain labels read
// existing T27F tokens only.
// Part of M7 milestone (milestone #11). Closes #13264.
// phi^2 + 1/phi^2 = 3 | TRINITY

module queen::style_tokens;

pub const QUEEN_STYLE_TOKENS_MAX : u32 = 16;

pub struct StyleToken { name: str, chain_label: str };

pub fn style_token_chain_label(t: StyleToken) -> str {
    return t.chain_label;
}

test "style_token_chain_label" {
    assert(style_token_chain_label(StyleToken { name: "token-1", chain_label: "label-1" }) == "label-1");
}

invariant queen_style_tokens_max_positive {
    assert QUEEN_STYLE_TOKENS_MAX > 0;
}