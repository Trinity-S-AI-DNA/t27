// SPDX-License-Identifier: Apache-2.0
; specs/queen/actor_journal.t27 -- the ordered run of T27L events of the pilot tree, and the projection a view reads
; Third M0 slice of the owner's 2026-11-15 actor order (gHashTag/t27#13904), after the actor pattern
; contract (#13860, 9e3655f46f) and the capability contract (#13886, 2e1b0dade9). Contract only: no
; agent runs, nothing is written to disk, no pilot node becomes runnable, no writer, no host call.
; Default taken (issue text): the T27L log is the one store, so the journal IS the ordered run of
; T27L events that concern a pilot node, ordered by position in the stored log -- never by a clock
; (FR-001). This card adds an order law (one append decision, FR-003) and one read-only fold
; (FR-004): no line format, no store, no file, no action number. The other two homes of the word
; journal are not touched: the T27L log (t27os/t27l.t27), the GODMODE v1 run journal and the Queen
; control effects journal. Defaults, one branch each, changeable by a version bump: a node that
; recorded agent_error stays failed (the actor pattern's restart slot is not filled yet); a node is
; created only after its parent is created, the root excepted.
; Inputs, read by item-level use, none restated (FR-002):
; - queen/agent_registry.t27 section 9h: AN_TREE_N, AN_TREE_IDS, AN_TREE_PARENT, AN_TREE_ROOT,
;   AN_TREE_KIND (the pilot tree: HyperSupervisor -> BuildSupervisor -> Compiler).
; - t27os/t27l.t27: tl_action_id, the T27L action numbers -- the six lifecycle ones (29, 31, 32, 33,
;   34, 6) and the five capability answers the capability contract answers with (52 access_approved,
;   53 access_denied, 121 secret_access_denied, 127 effect_denied, 165 owner_approval_required, the
;   numbers of agent_card.t27 cc_action, whose home is this same log) -- every one pinned below by
;   name, none restated as a new value. An answer entry is accepted for a created node and changes
;   no lifecycle state (FR-007).
; Read-only for a view (FR-008): nothing here takes a projection and returns a journal or an entry.
; Not here: binding a T27L line to a node, a writer, a view in the window, a restart engine, a
; second registry or task board, any new id, slug, kind, capability bit or action number (FR-009).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module QueenActorJournal;

use queen::agent_registry::AN_TREE_N;
use queen::agent_registry::AN_TREE_PARENT;
use queen::agent_registry::AN_TREE_ROOT;
use t27os::t27l::tl_action_id;

; --- 1. Version and the closed state set ----------------------------------------------------------------

/// One contract version; the two defaults above are one branch each, changeable by a bump.
pub const AJ_VERSION : u32 = 1;

/// One state per pilot node, out of a closed, contiguous set (FR-004). absent: no creation in the
/// journal. idle: created, holds no claim. working: holds a claim. failed: recorded agent_error and
/// version 1 has no restart, so it stays failed.
pub const AJ_ABSENT : u8 = 0;
pub const AJ_IDLE : u8 = 1;
pub const AJ_WORKING : u8 = 2;
pub const AJ_FAILED : u8 = 3;
pub const AJ_STATES : u8 = 4;

; --- 2. The entry, and the action numbers it may carry ---------------------------------------------------

/// One journal entry is a pilot node index plus a T27L action number; order is the entry's position
/// in the stored log (FR-001). The journal travels as two parallel arrays, nodes then actions, the
/// house form of a record run (actor_events.t27 section 6). No timestamp, no seq of our own: the
/// stored log already orders the lines.
/// Lifecycle action numbers, pinned to their T27L home by tests, not restated as new values.
pub const AJ_A_CREATED : u8 = 29;
pub const AJ_A_STATUS : u8 = 31;
pub const AJ_A_CLAIM : u8 = 32;
pub const AJ_A_HEARTBEAT : u8 = 33;
pub const AJ_A_RELEASE : u8 = 34;
pub const AJ_A_ERROR : u8 = 6;
/// Capability-contract answer numbers (agent_card.t27 cc_action), pinned to their home by tests.
/// An answer entry is accepted for a created node and must not change any lifecycle state (FR-007).
pub const AJ_A_CC_ALLOWED : u8 = 52;
pub const AJ_A_CC_OTHER : u8 = 53;
pub const AJ_A_CC_SECRET : u8 = 121;
pub const AJ_A_CC_MISSING : u8 = 127;
pub const AJ_A_CC_OWNER : u8 = 165;
/// The allowed set: six lifecycle numbers plus five capability answers.
pub const AJ_ACTIONS_KNOWN : usize = 11;

/// Membership in the allowed set; anything else is refused by name (FR-003).
pub fn aj_action_known(a: u8) -> bool {
    if (a == AJ_A_CREATED) { return true; }
    if (a == AJ_A_STATUS) { return true; }
    if (a == AJ_A_CLAIM) { return true; }
    if (a == AJ_A_HEARTBEAT) { return true; }
    if (a == AJ_A_RELEASE) { return true; }
    if (a == AJ_A_ERROR) { return true; }
    if (a == AJ_A_CC_ALLOWED) { return true; }
    if (a == AJ_A_CC_OTHER) { return true; }
    if (a == AJ_A_CC_SECRET) { return true; }
    if (a == AJ_A_CC_MISSING) { return true; }
    if (a == AJ_A_CC_OWNER) { return true; }
    return false;
}

/// A capability answer carries no lifecycle effect; a lifecycle entry does.
pub fn aj_action_lifecycle(a: u8) -> bool {
    if (a == AJ_A_CC_ALLOWED) { return false; }
    if (a == AJ_A_CC_OTHER) { return false; }
    if (a == AJ_A_CC_SECRET) { return false; }
    if (a == AJ_A_CC_MISSING) { return false; }
    if (a == AJ_A_CC_OWNER) { return false; }
    return true;
}

; --- 3. The append decision, every answer named ----------------------------------------------------------

/// One decision per entry (FR-003). Applies the entry to states in place only when it answers AJ_OK;
/// a refusal never touches the projection (FR-006). The branch order is: index, then the allowed
/// set, then creation, then answers, then the lifecycle law -- and the last branch is a denial
/// (a node after agent_error stays closed in version 1).
pub const AJ_OK : u8 = 0;
pub const AJ_REFUSED_INDEX : u8 = 1;
pub const AJ_REFUSED_ACTION : u8 = 2;
pub const AJ_REFUSED_TWICE : u8 = 3;
pub const AJ_REFUSED_PARENT : u8 = 4;
pub const AJ_REFUSED_ABSENT : u8 = 5;
pub const AJ_REFUSED_HELD : u8 = 6;
pub const AJ_REFUSED_NO_CLAIM : u8 = 7;
pub const AJ_REFUSED_AFTER_ERROR : u8 = 8;
pub const AJ_RESULTS : u8 = 9;

pub fn aj_step(states: []u8, node: u8, action: u8) -> u8 {
    if (node >= AN_TREE_N as u8) { return AJ_REFUSED_INDEX; }
    if (!aj_action_known(action)) { return AJ_REFUSED_ACTION; }
    let s : u8 = states[node as usize];
    if (action == AJ_A_CREATED) {
        if (s != AJ_ABSENT) { return AJ_REFUSED_TWICE; }
        if (node != AN_TREE_ROOT) {
            if (states[AN_TREE_PARENT[node as usize] as usize] == AJ_ABSENT) { return AJ_REFUSED_PARENT; }
        }
        states[node as usize] = AJ_IDLE;
        return AJ_OK;
    }
    if (!aj_action_lifecycle(action)) {
        if (s == AJ_ABSENT) { return AJ_REFUSED_ABSENT; }
        return AJ_OK;
    }
    if (s == AJ_ABSENT) { return AJ_REFUSED_ABSENT; }
    if (action == AJ_A_CLAIM) {
        if (s == AJ_WORKING) { return AJ_REFUSED_HELD; }
    }
    if (action == AJ_A_HEARTBEAT or action == AJ_A_RELEASE) {
        if (s != AJ_WORKING) { return AJ_REFUSED_NO_CLAIM; }
        if (action == AJ_A_RELEASE) { states[node as usize] = AJ_IDLE; }
        return AJ_OK;
    }
    if (action == AJ_A_CLAIM) { states[node as usize] = AJ_WORKING; return AJ_OK; }
    if (action == AJ_A_ERROR) { states[node as usize] = AJ_FAILED; return AJ_OK; }
    if (s == AJ_FAILED) { return AJ_REFUSED_AFTER_ERROR; }
    return AJ_OK;
}

/// The fold (FR-004): a prefix of the journal into one state per pilot node. Pure in the entries:
/// the same prefix always folds to the same states, one entry at a time or whole (FR-005). Returns
/// the number of entries folded; out holds AN_TREE_N states, every one absent before the first entry.
pub fn aj_fold(nodes: []const u8, actions: []const u8, count: usize, out: []u8) -> usize {
    var i : usize = 0;
    while (i < AN_TREE_N) {
        out[i] = AJ_ABSENT;
        i = i + 1;
    }
    var folded : usize = 0;
    i = 0;
    while (i < count) {
        if (aj_step(out, nodes[i], actions[i]) == AJ_OK) { folded = folded + 1; }
        i = i + 1;
    }
    return folded;
}

; --- 4. Tests: the pins, the scenarios, the denials ------------------------------------------------------

test the_action_numbers_are_pinned_to_their_homes {
    // FR-002: every action number this card branches on is pinned here, to the T27L log or to the
    // capability contract; none is a new value.
    assert tl_action_id("agent_created") == AJ_A_CREATED;
    assert tl_action_id("agent_status") == AJ_A_STATUS;
    assert tl_action_id("task_claimed") == AJ_A_CLAIM;
    assert tl_action_id("task_heartbeat") == AJ_A_HEARTBEAT;
    assert tl_action_id("task_released") == AJ_A_RELEASE;
    assert tl_action_id("agent_error") == AJ_A_ERROR;
    // the five capability answers, pinned by their own T27L names (agent_card.t27 cc_action's home)
    assert tl_action_id("access_approved") == AJ_A_CC_ALLOWED;
    assert tl_action_id("access_denied") == AJ_A_CC_OTHER;
    assert tl_action_id("secret_access_denied") == AJ_A_CC_SECRET;
    assert tl_action_id("effect_denied") == AJ_A_CC_MISSING;
    assert tl_action_id("owner_approval_required") == AJ_A_CC_OWNER;
    var known : usize = 0;
    var a : usize = 0;
    while (a < 256) {
        if (aj_action_known(a as u8)) { known = known + 1; }
        a = a + 1;
    }
    assert known == AJ_ACTIONS_KNOWN;
}

test an_empty_journal_projects_absent {
    // Given an empty journal, the projection of any pilot node is the absent state.
    var nodes : [1]u8 = [0];
    var actions : [1]u8 = [0];
    var out : [3]u8 = [0, 0, 0];
    assert aj_fold(nodes, actions, 0, out) == 0;
    var i : usize = 0;
    while (i < AN_TREE_N) {
        assert out[i] == AJ_ABSENT;
        i = i + 1;
    }
}

test the_issue_scenario_folds_to_working_idle_idle {
    // root, supervisor, subagent created in that order; the subagent claims a task.
    var nodes : [4]u8 = [0, 1, 2, 2];
    var actions : [4]u8 = [AJ_A_CREATED, AJ_A_CREATED, AJ_A_CREATED, AJ_A_CLAIM];
    var out : [3]u8 = [0, 0, 0];
    assert aj_fold(nodes, actions, 4, out) == 4;
    assert out[0] == AJ_IDLE;
    assert out[1] == AJ_IDLE;
    assert out[2] == AJ_WORKING;
}

test folding_whole_equals_folding_one_by_one_and_is_deterministic {
    // FR-005: fold once, fold again, fold entry by entry -- all equal.
    var nodes : [6]u8 = [0, 1, 2, 2, 2, 2];
    var actions : [6]u8 = [AJ_A_CREATED, AJ_A_CREATED, AJ_A_CREATED, AJ_A_CLAIM, AJ_A_HEARTBEAT, AJ_A_RELEASE];
    var whole : [3]u8 = [0, 0, 0];
    var again : [3]u8 = [0, 0, 0];
    var step : [3]u8 = [0, 0, 0];
    var empty_nodes : [1]u8 = [0];
    var empty_actions : [1]u8 = [0];
    aj_fold(nodes, actions, 6, whole);
    aj_fold(nodes, actions, 6, again);
    aj_fold(empty_nodes, empty_actions, 0, step);
    var i : usize = 0;
    while (i < 6) {
        assert aj_step(step, nodes[i], actions[i]) == AJ_OK;
        i = i + 1;
    }
    var j : usize = 0;
    while (j < AN_TREE_N) {
        assert whole[j] == again[j];
        assert whole[j] == step[j];
        j = j + 1;
    }
    // negative control: one changed entry changes the projection
    var actions2 : [6]u8 = [AJ_A_CREATED, AJ_A_CREATED, AJ_A_CREATED, AJ_A_CLAIM, AJ_A_HEARTBEAT, AJ_A_CLAIM];
    var other : [3]u8 = [0, 0, 0];
    aj_fold(nodes, actions2, 6, other);
    assert other[2] == AJ_WORKING and whole[2] == AJ_IDLE;
}

test every_refusal_is_named_and_leaves_the_projection_unchanged {
    // FR-006, over every denial of FR-003. Base tree: all three created, subagent working.
    var base : [3]u8 = [0, 0, 0];
    assert aj_step(base, 0, AJ_A_CREATED) == AJ_OK;
    assert aj_step(base, 1, AJ_A_CREATED) == AJ_OK;
    assert aj_step(base, 2, AJ_A_CREATED) == AJ_OK;
    assert aj_step(base, 2, AJ_A_CLAIM) == AJ_OK;
    // index outside the pilot tree
    var s1 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_IDLE];
    assert aj_step(s1, AN_TREE_N as u8, AJ_A_STATUS) == AJ_REFUSED_INDEX;
    assert s1[0] == AJ_IDLE and s1[1] == AJ_IDLE and s1[2] == AJ_IDLE;
    // action outside the allowed set
    var s2 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_IDLE];
    assert aj_step(s2, 0, 99) == AJ_REFUSED_ACTION;
    assert s2[0] == AJ_IDLE;
    // a second creation of one node
    var s3 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_IDLE];
    assert aj_step(s3, 1, AJ_A_CREATED) == AJ_REFUSED_TWICE;
    assert s3[1] == AJ_IDLE;
    // a creation whose parent is not created, the root excepted
    var s4 : [3]u8 = [AJ_ABSENT, AJ_ABSENT, AJ_ABSENT];
    assert aj_step(s4, AN_TREE_ROOT, AJ_A_CREATED) == AJ_OK;
    assert aj_step(s4, 2, AJ_A_CREATED) == AJ_REFUSED_PARENT;
    assert s4[2] == AJ_ABSENT;
    assert aj_step(s4, 1, AJ_A_CREATED) == AJ_OK;
    assert aj_step(s4, 2, AJ_A_CREATED) == AJ_OK;
    // a lifecycle entry for a node that is not created
    var s5 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_ABSENT];
    assert aj_step(s5, 2, AJ_A_CLAIM) == AJ_REFUSED_ABSENT;
    assert aj_step(s5, 2, AJ_A_STATUS) == AJ_REFUSED_ABSENT;
    assert s5[2] == AJ_ABSENT;
    // a heartbeat or a release for a node that holds no claim
    var s6 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_IDLE];
    assert aj_step(s6, 2, AJ_A_HEARTBEAT) == AJ_REFUSED_NO_CLAIM;
    assert aj_step(s6, 2, AJ_A_RELEASE) == AJ_REFUSED_NO_CLAIM;
    assert s6[2] == AJ_IDLE;
    // a second claim while one is held
    var s7 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_WORKING];
    assert aj_step(s7, 2, AJ_A_CLAIM) == AJ_REFUSED_HELD;
    assert s7[2] == AJ_WORKING;
    // any lifecycle entry after agent_error
    var s8 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_FAILED];
    assert aj_step(s8, 2, AJ_A_CLAIM) == AJ_REFUSED_AFTER_ERROR;
    assert aj_step(s8, 2, AJ_A_STATUS) == AJ_REFUSED_AFTER_ERROR;
    assert aj_step(s8, 2, AJ_A_HEARTBEAT) == AJ_REFUSED_AFTER_ERROR;
    assert aj_step(s8, 2, AJ_A_RELEASE) == AJ_REFUSED_AFTER_ERROR;
    assert aj_step(s8, 2, AJ_A_CREATED) == AJ_REFUSED_TWICE;
    assert s8[2] == AJ_FAILED;
}

test a_capability_answer_is_accepted_and_changes_no_state {
    // FR-007: all five answer numbers, on a created node, on working and on failed too.
    var s : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_WORKING];
    assert aj_step(s, 2, AJ_A_CC_ALLOWED) == AJ_OK;
    assert s[2] == AJ_WORKING;
    assert aj_step(s, 2, AJ_A_CC_OTHER) == AJ_OK;
    assert aj_step(s, 2, AJ_A_CC_SECRET) == AJ_OK;
    assert aj_step(s, 2, AJ_A_CC_MISSING) == AJ_OK;
    assert aj_step(s, 2, AJ_A_CC_OWNER) == AJ_OK;
    assert s[2] == AJ_WORKING;
    // an answer for a node that is not created is refused like any entry about it
    var s2 : [3]u8 = [AJ_IDLE, AJ_IDLE, AJ_ABSENT];
    assert aj_step(s2, 2, AJ_A_CC_ALLOWED) == AJ_REFUSED_ABSENT;
    assert s2[2] == AJ_ABSENT;
}

test the_lifecycle_runs_claim_heartbeat_release_and_error {
    var s : [3]u8 = [AJ_ABSENT, AJ_ABSENT, AJ_ABSENT];
    assert aj_step(s, 0, AJ_A_CREATED) == AJ_OK;
    assert aj_step(s, 1, AJ_A_CREATED) == AJ_OK;
    assert aj_step(s, 2, AJ_A_CREATED) == AJ_OK;
    assert aj_step(s, 2, AJ_A_STATUS) == AJ_OK;
    assert s[2] == AJ_IDLE;
    assert aj_step(s, 2, AJ_A_CLAIM) == AJ_OK;
    assert s[2] == AJ_WORKING;
    assert aj_step(s, 2, AJ_A_HEARTBEAT) == AJ_OK;
    assert s[2] == AJ_WORKING;
    assert aj_step(s, 2, AJ_A_RELEASE) == AJ_OK;
    assert s[2] == AJ_IDLE;
    assert aj_step(s, 2, AJ_A_ERROR) == AJ_OK;
    assert s[2] == AJ_FAILED;
    // version 1 has no restart: the node stays failed (default, one branch, a bump can change it)
    assert aj_step(s, 2, AJ_A_CLAIM) == AJ_REFUSED_AFTER_ERROR;
    assert s[2] == AJ_FAILED;
}

; --- 5. Invariants ----------------------------------------------------------------------------------------

invariant one_version_and_a_closed_state_set {
    assert AJ_VERSION == 1;
    assert AJ_STATES == 4;
    assert AJ_ABSENT == 0 and AJ_IDLE == 1 and AJ_WORKING == 2 and AJ_FAILED == 3;
    assert AN_TREE_N == 3;
}

invariant the_tree_names_the_parents_the_journal_relies_on {
    // the parent law of the append decision reads the registry's own links; the root is its own parent
    assert AN_TREE_PARENT[AN_TREE_ROOT] == AN_TREE_ROOT;
    var p : usize = 1;
    while (p < AN_TREE_N) {
        assert AN_TREE_PARENT[p] < p;
        p = p + 1;
    }
}

invariant the_result_set_is_contiguous_and_ends_in_denials {
    assert AJ_OK == 0;
    assert AJ_REFUSED_INDEX == 1 and AJ_REFUSED_ACTION == 2 and AJ_REFUSED_TWICE == 3;
    assert AJ_REFUSED_PARENT == 4 and AJ_REFUSED_ABSENT == 5;
    assert AJ_REFUSED_HELD == 6 and AJ_REFUSED_NO_CLAIM == 7 and AJ_REFUSED_AFTER_ERROR == 8;
    assert AJ_RESULTS == 9;
}
