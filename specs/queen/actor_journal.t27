// SPDX-License-Identifier: Apache-2.0
; specs/queen/actor_journal.t27 -- the append-only T27L event journal of the
; team runtime, and the deterministic replay that is the only source of the
; projection (issue #13904, V3 vertical slice, corrected contract).
; phi^2 + 1/phi^2 = 3 | TRINITY
; 
; THE CONTRACT (corrected V3 status, owner 2026-11-15):
; - append-only: a row is written once at index n and never rewritten; the
;   sequence number IS the index. No mutable projection state exists without
;   a journal event behind it.
; - the projection is derived ONLY from the journal: replay folds rows
;   0..n into per-kind counts; replaying twice gives the same counts, and a
;   verification call answers whether a given projection is the journal's.
; - rows beyond n are not journal: replay ignores them, so trailing garbage
;   from a reused buffer can never enter the projection.
; - a seal is generated by CI only; nothing here seals.
; - every team transition emits one event; the kinds are the five the team
;   runtime needs at M0 (spawn, exit, down, restart, deliver) plus task, so
;   a task-board transition carries its owner agent.
; 
; WORD LAYOUT: one event is one u64. kind in the top 4 bits (0..5), a in the
; next 28 bits (the actor's slot, as actors.t27's slot_of -- never the raw
; pid, so the journal does not leak generation bits), b in the low 28 bits
; (the task ref or the peer slot). Packing keeps the journal one flat array
; that stores, loads and hashes byte-exactly.
; 
; NOT HERE (one truth, no second home): the actor model is actors.t27's, the
; event kinds the bus writes are actor_events.t27's, the board's drawing is
; actor_view.t27's. This file is only the journal and its replay law.
; ASCII only (L3).

module QueenActorJournal;

; --- 1. Layout --------------------------------------------------------------------------------------

pub const JCAP : usize = 256;   // journal capacity, rows
pub const KINDS : u64 = 6;      // SPAWN EXIT DOWN RESTART DELIVER TASK

pub const K_SPAWN   : u8 = 0;
pub const K_EXIT    : u8 = 1;
pub const K_DOWN    : u8 = 2;
pub const K_RESTART : u8 = 3;
pub const K_DELIVER : u8 = 4;
pub const K_TASK    : u8 = 5;

const KIND_SHIFT : u64 = 60;
const A_SHIFT    : u64 = 28;
const FIELD_MASK : u64 = 0x0FFF_FFFF; // 28 bits
const KIND_MASK  : u64 = 0xF;

; --- 2. Pack and unpack -----------------------------------------------------------------------------

/// One journal word. a and b are 28-bit fields; a larger pid or ref is a
/// caller error and packs wrong, so ev refuses it.
pub fn ev(kind: u8, a: u64, b: u64) -> u64 {
    if (kind_valid(kind) == false) { return 0; }
    if (a > FIELD_MASK) { return 0; }
    if (b > FIELD_MASK) { return 0; }
    return ((kind as u64) << KIND_SHIFT) | (a << A_SHIFT) | b;
}

pub fn ev_kind(w: u64) -> u8 {
    return ((w >> KIND_SHIFT) & KIND_MASK) as u8;
}

pub fn ev_a(w: u64) -> u64 {
    return (w >> A_SHIFT) & FIELD_MASK;
}

pub fn ev_b(w: u64) -> u64 {
    return w & FIELD_MASK;
}

/// 0 is the empty word and never a valid event (kind 0 is K_SPAWN, so the
/// empty word would read as a spawn with no actor; the packer returns 0 only
/// on a refused input, and empty rows past n are ignored anyway).
pub fn empty(w: u64) -> bool {
    return w == 0;
}

; --- 3. The append law ------------------------------------------------------------------------------

pub fn kind_valid(kind: u8) -> bool {
    return (kind as u64) < KINDS;
}

/// The only append rule: the row goes at index n, and n must be inside the
/// capacity. The sequence number is the index; there is no other clock.
pub fn append_ok(n: usize) -> bool {
    return (n as u64) < (JCAP as u64);
}

/// The journal law over rows 0..n: every row is a packed event of a valid
/// kind. A rewritten middle row (the non-append mutation) breaks either this
/// or the projection check below.
pub fn journal_ok(j: [256]u64, n: usize) -> bool {
    if ((n as u64) > (JCAP as u64)) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (kind_valid(ev_kind(j[i])) == false) { return false; }
        i = i + 1;
    }
    return true;
}

; --- 4. Replay: the projection is derived only from the journal ------------------------------------

/// The replay fold for one kind: rows 0..n, no other input.
pub fn count_kind(j: [256]u64, n: usize, kind: u8) -> u64 {
    var c : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        if (ev_kind(j[i]) == kind) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// Whether counts is the projection of rows 0..n: the projection a caller
/// holds is accepted only when the journal replays to exactly it.
pub fn replay_ok(j: [256]u64, n: usize, counts: [8]u64) -> bool {
    var k : usize = 0;
    while (k < 8) {
        if (k as u64 >= KINDS) {
            // Kinds past the table must be zero in any honest projection.
            if (counts[k] != 0) { return false; }
        } else {
            if (count_kind(j, n, k as u8) != counts[k]) { return false; }
        }
        k = k + 1;
    }
    return journal_ok(j, n);
}

/// Determinism check: two replays of the same rows agree. The fold reads
/// only j and n, so this holds by construction; the test pins it.
pub fn replay_deterministic(j: [256]u64, n: usize) -> bool {
    return count_kind(j, n, K_SPAWN) == count_kind(j, n, K_SPAWN);
}

; --- 5. Tests: the witness sequence, then every refusal on its own ----------------------------------

const W_SPAWN : u64 = 0x0000_0000_0000_0001; // not used; tests pack with ev

test packs_and_unpacks_the_witness {
    // spawn actor slot 3 with task ref 12
    var w : u64 = ev(K_SPAWN, 3, 12);
    assert(ev_kind(w) == K_SPAWN);
    assert(ev_a(w) == 3);
    assert(ev_b(w) == 12);
}

test empty_word_is_not_an_event {
    assert(empty(0));
    assert(empty(ev(K_SPAWN, 1, 1)) == false);
}

test ev_refuses_an_invalid_kind {
    assert(ev(6, 1, 1) == 0);
    assert(ev(200, 1, 1) == 0);
}

test ev_refuses_an_oversized_field {
    // 2^28 does not fit the 28-bit a field; the packer refuses rather than
    // silently truncating a pid.
    assert(ev(K_TASK, 0x1000_0000, 1) == 0);
    assert(ev(K_TASK, 1, 0x1000_0000) == 0);
}

test kind_valid_names_six_kinds {
    assert(kind_valid(K_SPAWN));
    assert(kind_valid(K_TASK));
    assert(kind_valid(6) == false);
}

test append_refused_at_capacity {
    assert(append_ok(0));
    assert(append_ok(255));
    assert(append_ok(256) == false);
}

test journal_ok_refuses_n_past_capacity {
    var j : [256]u64;
    var z : usize = 0;
    while (z < 256) { j[z] = 0; z = z + 1; }
    assert(journal_ok(j, 257) == false);
}

test replay_reads_the_witness_sequence {
    // two spawns, one deliver, one exit: the M0 team turn
    var j : [256]u64;
    var z : usize = 0;
    while (z < 256) { j[z] = 0; z = z + 1; }
    j[0] = ev(K_SPAWN, 1, 0);
    j[1] = ev(K_SPAWN, 2, 0);
    j[2] = ev(K_DELIVER, 1, 7);
    j[3] = ev(K_EXIT, 2, 0);
    var counts : [8]u64;
    var fk : usize = 0;
    while (fk < 8) { counts[fk] = 0; fk = fk + 1; }
    counts[0] = 2; // spawns
    counts[1] = 1; // exits
    counts[4] = 1; // delivers
    assert(replay_ok(j, 4, counts));
    assert(count_kind(j, 4, K_SPAWN) == 2);
    assert(count_kind(j, 4, K_DOWN) == 0);
}

test replay_refuses_a_projection_not_from_the_journal {
    var j : [256]u64;
    var z : usize = 0;
    while (z < 256) { j[z] = 0; z = z + 1; }
    j[0] = ev(K_SPAWN, 1, 0);
    var counts : [8]u64;
    var fk : usize = 0;
    while (fk < 8) { counts[fk] = 0; fk = fk + 1; }
    counts[0] = 2; // the journal has one spawn, the projection claims two
    assert(replay_ok(j, 1, counts) == false);
}

test replay_refuses_an_honest_projection_of_a_mutated_journal {
    // the same projection, but a middle row was rewritten to a kind no row
    // of the projection accounts for: the append-only law catches it.
    var j : [256]u64;
    var z : usize = 0;
    while (z < 256) { j[z] = 0; z = z + 1; }
    j[0] = ev(K_SPAWN, 1, 0);
    j[1] = ev(K_EXIT, 1, 0);
    var counts : [8]u64;
    var fk : usize = 0;
    while (fk < 8) { counts[fk] = 0; fk = fk + 1; }
    counts[0] = 1;
    counts[1] = 1;
    assert(replay_ok(j, 2, counts));
    j[1] = ev(K_DOWN, 1, 0); // rewritten after the fact
    assert(replay_ok(j, 2, counts) == false);
}

test replay_ignores_rows_beyond_n {
    // a reused buffer keeps old rows past n; they are not journal.
    var j : [256]u64;
    var z : usize = 0;
    while (z < 256) { j[z] = 0; z = z + 1; }
    j[0] = ev(K_SPAWN, 1, 0);
    j[1] = ev(K_EXIT, 1, 0); // stale row from a previous turn
    var counts : [8]u64;
    var fk : usize = 0;
    while (fk < 8) { counts[fk] = 0; fk = fk + 1; }
    counts[0] = 1; // only row 0 is journal now
    assert(replay_ok(j, 1, counts));
}

test replay_is_deterministic {
    var j : [256]u64;
    var z : usize = 0;
    while (z < 256) { j[z] = 0; z = z + 1; }
    j[0] = ev(K_RESTART, 4, 0);
    j[1] = ev(K_TASK, 4, 9);
    assert(replay_deterministic(j, 2));
    // the same rows replay the same however many times they are read
    assert(count_kind(j, 2, K_RESTART) == count_kind(j, 2, K_RESTART));
}

test a_projection_with_junk_kinds_is_refused {
    var j : [256]u64;
    var z : usize = 0;
    while (z < 256) { j[z] = 0; z = z + 1; }
    j[0] = ev(K_SPAWN, 1, 0);
    var counts : [8]u64;
    counts[6] = 1; // kind 6 does not exist; an honest projection is zero there
    assert(replay_ok(j, 1, counts) == false);
}
