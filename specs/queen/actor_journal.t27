// SPDX-License-Identifier: Apache-2.0
; specs/queen/actor_journal.t27 -- the journal order law and the read-only projection of the 9h pilot
; tree (issue #13904, M0). Third slice of the owner's 2026-11-15 actor order, after the actor pattern
; contract (#13860) and the capability contract (#13886). A contract only: no agent is created, nothing
; is written to disk, no pilot node becomes runnable.
; The one store is the T27L log (specs/t27os/t27l.t27). The actor journal is the ordered run of T27L
; events that concern a pilot node. An entry here is a node index plus a T27L action number, ordered by
; its position in the stored log; no clock, no timestamp, no second line format, no file, no new id.
; Node count and parents are read from specs/queen/agent_registry.t27 (section 9h). Action numbers are
; read through tl_action_id and pinned by tests; none is restated as a new value.
; Defaults, each one branch and changeable by a version bump: a node that recorded agent_error stays
; failed in version 1 (the restart slot of the actor pattern is not filled); a node may be created only
; after its parent is created, the root excepted.
; The projection packs one state per node, base 4, node 0 in the lowest digit. A refused entry is not
; stored, so the fold skips it and the projection does not change. Nothing here turns a projection back
; into an entry (FR-008). ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenActorJournal;

use queen::agent_registry::AN_TREE_N;
use queen::agent_registry::AN_TREE_PARENT;
use queen::agent_registry::AN_TREE_ROOT;
use t27os::t27l::tl_action_id;

; --- 1. Version, states, results ---------------------------------------------------------------------

pub const AJ_VERSION : u32 = 1;

pub const AJ_ABSENT : u32 = 0;
pub const AJ_IDLE : u32 = 1;
pub const AJ_WORKING : u32 = 2;
pub const AJ_FAILED : u32 = 3;
pub const AJ_STATE_COUNT : u32 = 4;

pub const AJ_OK : u32 = 0;
pub const AJ_DENY_NODE : u32 = 1;
pub const AJ_DENY_ACTION : u32 = 2;
pub const AJ_DENY_RECREATE : u32 = 3;
pub const AJ_DENY_PARENT : u32 = 4;
pub const AJ_DENY_NOT_CREATED : u32 = 5;
pub const AJ_DENY_NO_CLAIM : u32 = 6;
pub const AJ_DENY_CLAIM_HELD : u32 = 7;
pub const AJ_DENY_FAILED : u32 = 8;

; --- 2. The allowed set ------------------------------------------------------------------------------

/// Kinds of allowed entry: 0 none, 1 created, 2 status, 3 claim, 4 heartbeat, 5 release, 6 error,
/// 7 a capability contract answer (52, 53, 121, 127, 165).
pub fn aj_kind(action: u8) -> u32 {
    if (action == 29) { return 1; }
    if (action == 31) { return 2; }
    if (action == 32) { return 3; }
    if (action == 33) { return 4; }
    if (action == 34) { return 5; }
    if (action == 6) { return 6; }
    if (action == 52 or action == 53 or action == 121 or action == 127 or action == 165) { return 7; }
    return 0;
}

; --- 3. Projection access ----------------------------------------------------------------------------

fn aj_unit(i: u32) -> u32 {
    var u : u32 = 1;
    var k : u32 = 0;
    while (k < i) {
        u = u * 4;
        k = k + 1;
    }
    return u;
}

/// State of node i in projection p; absent for an index outside the pilot tree.
pub fn aj_state(p: u32, i: u32) -> u32 {
    if (i >= AN_TREE_N as u32) { return AJ_ABSENT; }
    return (p / aj_unit(i)) % 4;
}

fn aj_with(p: u32, i: u32, s: u32) -> u32 {
    return p - aj_state(p, i) * aj_unit(i) + s * aj_unit(i);
}

; --- 4. The entry decision --------------------------------------------------------------------------

/// Answer for one entry against projection p. The last branch is a denial.
pub fn aj_decide(p: u32, node: u32, action: u8) -> u32 {
    if (node >= AN_TREE_N as u32) { return AJ_DENY_NODE; }
    const kind : u32 = aj_kind(action);
    if (kind == 0) { return AJ_DENY_ACTION; }
    const st : u32 = aj_state(p, node);
    if (kind == 1) {
        if (st != AJ_ABSENT) { return AJ_DENY_RECREATE; }
        if (node != AN_TREE_ROOT as u32) {
            if (aj_state(p, AN_TREE_PARENT[node as usize] as u32) == AJ_ABSENT) { return AJ_DENY_PARENT; }
        }
        return AJ_OK;
    }
    if (st == AJ_ABSENT) { return AJ_DENY_NOT_CREATED; }
    if (kind == 7) { return AJ_OK; }
    if (st == AJ_FAILED) { return AJ_DENY_FAILED; }
    if (kind == 3) {
        if (st == AJ_WORKING) { return AJ_DENY_CLAIM_HELD; }
        return AJ_OK;
    }
    if (kind == 4 or kind == 5) {
        if (st != AJ_WORKING) { return AJ_DENY_NO_CLAIM; }
        return AJ_OK;
    }
    if (kind == 2 or kind == 6) { return AJ_OK; }
    return AJ_DENY_ACTION;
}

; --- 5. The fold -------------------------------------------------------------------------------------

/// Apply one entry: an accepted entry moves one node, a refused one returns p unchanged.
pub fn aj_apply(p: u32, node: u32, action: u8) -> u32 {
    if (aj_decide(p, node, action) != AJ_OK) { return p; }
    const kind : u32 = aj_kind(action);
    if (kind == 1) { return aj_with(p, node, AJ_IDLE); }
    if (kind == 3) { return aj_with(p, node, AJ_WORKING); }
    if (kind == 5) { return aj_with(p, node, AJ_IDLE); }
    if (kind == 6) { return aj_with(p, node, AJ_FAILED); }
    return p;
}

/// Fold the first n entries (node[i], act[i]) of a journal into one projection. Pure.
pub fn aj_fold(nodes: []const u8, acts: []const u8, n: usize) -> u32 {
    var p : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        p = aj_apply(p, nodes[i] as u32, acts[i]);
        i = i + 1;
    }
    return p;
}

; --- 6. Tests ----------------------------------------------------------------------------------------

test aj_version_and_pins {
    assert AJ_VERSION == 1;
    assert tl_action_id("agent_created") == 29;
    assert tl_action_id("agent_status") == 31;
    assert tl_action_id("task_claimed") == 32;
    assert tl_action_id("task_heartbeat") == 33;
    assert tl_action_id("task_released") == 34;
    assert tl_action_id("agent_error") == 6;
    assert tl_action_id("access_approved") == 52;
    assert tl_action_id("access_denied") == 53;
    assert tl_action_id("secret_access_denied") == 121;
    assert tl_action_id("effect_denied") == 127;
    assert tl_action_id("owner_approval_required") == 165;
}

test aj_allowed_set_is_closed {
    assert aj_kind(29) == 1;
    assert aj_kind(31) == 2;
    assert aj_kind(32) == 3;
    assert aj_kind(33) == 4;
    assert aj_kind(34) == 5;
    assert aj_kind(6) == 6;
    assert aj_kind(52) == 7;
    assert aj_kind(53) == 7;
    assert aj_kind(121) == 7;
    assert aj_kind(127) == 7;
    assert aj_kind(165) == 7;
    assert aj_kind(0) == 0;
    assert aj_kind(1) == 0;
    assert aj_kind(30) == 0;
    assert aj_kind(35) == 0;
}

test aj_empty_journal_is_absent {
    var nodes : [1]u8 = [0] ** 1;
    nodes[0] = 0;
    var acts : [1]u8 = [0] ** 1;
    acts[0] = 29;
    const p : u32 = aj_fold(nodes[0..1], acts[0..1], 0);
    assert p == 0;
    assert aj_state(p, 0) == AJ_ABSENT;
    assert aj_state(p, 1) == AJ_ABSENT;
    assert aj_state(p, 2) == AJ_ABSENT;
}

test aj_three_created_and_claim_gives_working {
    var nodes : [4]u8 = [0] ** 4;
    nodes[0] = 0;
    nodes[1] = 1;
    nodes[2] = 2;
    nodes[3] = 2;
    var acts : [4]u8 = [0] ** 4;
    acts[0] = 29;
    acts[1] = 29;
    acts[2] = 29;
    acts[3] = 32;
    const p : u32 = aj_fold(nodes[0..4], acts[0..4], 4);
    assert aj_state(p, 0) == AJ_IDLE;
    assert aj_state(p, 1) == AJ_IDLE;
    assert aj_state(p, 2) == AJ_WORKING;
}

test aj_denial_out_of_tree_node {
    var nodes : [1]u8 = [0] ** 1;
    nodes[0] = 0;
    var acts : [1]u8 = [0] ** 1;
    acts[0] = 29;
    const p : u32 = aj_fold(nodes[0..1], acts[0..1], 1);
    assert aj_decide(p, 3, 29) == AJ_DENY_NODE;
    assert aj_decide(p, 200, 32) == AJ_DENY_NODE;
    assert aj_apply(p, 3, 29) == p;
}

test aj_denial_child_before_parent {
    assert aj_decide(0, 2, 29) == AJ_DENY_PARENT;
    assert aj_decide(0, 1, 29) == AJ_DENY_PARENT;
    assert aj_decide(0, 0, 29) == AJ_OK;
    assert aj_apply(0, 2, 29) == 0;
    const p1 : u32 = aj_apply(0, 0, 29);
    assert aj_decide(p1, 2, 29) == AJ_DENY_PARENT;
    const p2 : u32 = aj_apply(p1, 1, 29);
    assert aj_decide(p2, 2, 29) == AJ_OK;
}

test aj_denial_action_outside_set {
    const p : u32 = aj_apply(0, 0, 29);
    assert aj_decide(p, 0, 30) == AJ_DENY_ACTION;
    assert aj_decide(p, 0, 1) == AJ_DENY_ACTION;
    assert aj_apply(p, 0, 30) == p;
}

test aj_denial_second_creation {
    const p : u32 = aj_apply(0, 0, 29);
    assert aj_decide(p, 0, 29) == AJ_DENY_RECREATE;
    assert aj_apply(p, 0, 29) == p;
}

test aj_denial_lifecycle_before_creation {
    assert aj_decide(0, 0, 32) == AJ_DENY_NOT_CREATED;
    assert aj_decide(0, 0, 31) == AJ_DENY_NOT_CREATED;
    assert aj_decide(0, 0, 33) == AJ_DENY_NOT_CREATED;
    assert aj_decide(0, 0, 34) == AJ_DENY_NOT_CREATED;
    assert aj_decide(0, 0, 6) == AJ_DENY_NOT_CREATED;
    assert aj_apply(0, 0, 32) == 0;
}

test aj_denial_heartbeat_release_without_claim {
    const p : u32 = aj_apply(0, 0, 29);
    assert aj_decide(p, 0, 33) == AJ_DENY_NO_CLAIM;
    assert aj_decide(p, 0, 34) == AJ_DENY_NO_CLAIM;
    assert aj_apply(p, 0, 33) == p;
    assert aj_apply(p, 0, 34) == p;
}

test aj_denial_second_claim {
    const p : u32 = aj_apply(aj_apply(0, 0, 29), 0, 32);
    assert aj_state(p, 0) == AJ_WORKING;
    assert aj_decide(p, 0, 32) == AJ_DENY_CLAIM_HELD;
    assert aj_apply(p, 0, 32) == p;
    assert aj_decide(p, 0, 33) == AJ_OK;
    assert aj_decide(p, 0, 31) == AJ_OK;
}

test aj_release_returns_to_idle_and_reclaim {
    const p : u32 = aj_apply(aj_apply(0, 0, 29), 0, 32);
    const q : u32 = aj_apply(p, 0, 34);
    assert aj_state(q, 0) == AJ_IDLE;
    assert aj_decide(q, 0, 32) == AJ_OK;
}

test aj_error_is_terminal_in_version_1 {
    const p : u32 = aj_apply(aj_apply(0, 0, 29), 0, 32);
    const q : u32 = aj_apply(p, 0, 6);
    assert aj_state(q, 0) == AJ_FAILED;
    assert aj_decide(q, 0, 29) == AJ_DENY_RECREATE;
    assert aj_decide(q, 0, 32) == AJ_DENY_FAILED;
    assert aj_decide(q, 0, 33) == AJ_DENY_FAILED;
    assert aj_decide(q, 0, 34) == AJ_DENY_FAILED;
    assert aj_decide(q, 0, 31) == AJ_DENY_FAILED;
    assert aj_decide(q, 0, 6) == AJ_DENY_FAILED;
    assert aj_apply(q, 0, 32) == q;
}

test aj_capability_answers_do_not_move_state {
    var nodes : [4]u8 = [0] ** 4;
    nodes[0] = 0;
    nodes[1] = 1;
    nodes[2] = 2;
    nodes[3] = 2;
    var acts : [4]u8 = [0] ** 4;
    acts[0] = 29;
    acts[1] = 29;
    acts[2] = 29;
    acts[3] = 32;
    const p : u32 = aj_fold(nodes[0..4], acts[0..4], 4);
    assert aj_apply(p, 1, 52) == p;
    assert aj_apply(p, 1, 53) == p;
    assert aj_apply(p, 2, 121) == p;
    assert aj_apply(p, 0, 127) == p;
    assert aj_apply(p, 2, 165) == p;
    assert aj_decide(p, 1, 52) == AJ_OK;
    assert aj_decide(0, 1, 52) == AJ_DENY_NOT_CREATED;
    assert aj_decide(p, 3, 52) == AJ_DENY_NODE;
}

test aj_fold_twice_equals_once {
    var nodes : [6]u8 = [0] ** 6;
    nodes[0] = 0;
    nodes[1] = 1;
    nodes[2] = 2;
    nodes[3] = 2;
    nodes[4] = 2;
    nodes[5] = 1;
    var acts : [6]u8 = [0] ** 6;
    acts[0] = 29;
    acts[1] = 29;
    acts[2] = 29;
    acts[3] = 32;
    acts[4] = 33;
    acts[5] = 6;
    const a : u32 = aj_fold(nodes[0..6], acts[0..6], 6);
    const b : u32 = aj_fold(nodes[0..6], acts[0..6], 6);
    assert a == b;
    assert aj_state(a, 1) == AJ_FAILED;
    assert aj_state(a, 2) == AJ_WORKING;
}

test aj_incremental_equals_whole {
    var nodes : [7]u8 = [0] ** 7;
    nodes[0] = 0;
    nodes[1] = 1;
    nodes[2] = 2;
    nodes[3] = 2;
    nodes[4] = 2;
    nodes[5] = 2;
    nodes[6] = 1;
    var acts : [7]u8 = [0] ** 7;
    acts[0] = 29;
    acts[1] = 29;
    acts[2] = 29;
    acts[3] = 32;
    acts[4] = 33;
    acts[5] = 34;
    acts[6] = 6;
    var p : u32 = 0;
    var i : usize = 0;
    while (i < 7) {
        p = aj_apply(p, nodes[i] as u32, acts[i]);
        assert p == aj_fold(nodes[0..7], acts[0..7], i + 1);
        i = i + 1;
    }
    assert p == aj_fold(nodes[0..7], acts[0..7], 7);
}

test aj_refused_entries_leave_projection_unchanged_in_fold {
    var nodes : [6]u8 = [0] ** 6;
    nodes[0] = 2;
    nodes[1] = 0;
    nodes[2] = 9;
    nodes[3] = 1;
    nodes[4] = 2;
    nodes[5] = 2;
    var acts : [6]u8 = [0] ** 6;
    acts[0] = 29;
    acts[1] = 29;
    acts[2] = 29;
    acts[3] = 29;
    acts[4] = 29;
    acts[5] = 32;
    const p : u32 = aj_fold(nodes[0..6], acts[0..6], 6);
    var nodes2 : [4]u8 = [0] ** 4;
    nodes2[0] = 0;
    nodes2[1] = 1;
    nodes2[2] = 2;
    nodes2[3] = 2;
    var acts2 : [4]u8 = [0] ** 4;
    acts2[0] = 29;
    acts2[1] = 29;
    acts2[2] = 29;
    acts2[3] = 32;
    assert p == aj_fold(nodes2[0..4], acts2[0..4], 4);
}

test aj_negative_control_changed_entry_changes_projection {
    var nodes : [4]u8 = [0] ** 4;
    nodes[0] = 0;
    nodes[1] = 1;
    nodes[2] = 2;
    nodes[3] = 2;
    var a1 : [4]u8 = [0] ** 4;
    a1[0] = 29;
    a1[1] = 29;
    a1[2] = 29;
    a1[3] = 32;
    var a2 : [4]u8 = [0] ** 4;
    a2[0] = 29;
    a2[1] = 29;
    a2[2] = 29;
    a2[3] = 6;
    assert aj_fold(nodes[0..4], a1[0..4], 4) != aj_fold(nodes[0..4], a2[0..4], 4);
}

invariant aj_states_closed {
    assert AJ_STATE_COUNT == 4;
    assert AJ_FAILED < AJ_STATE_COUNT;
    assert AN_TREE_N == 3;
    assert AN_TREE_ROOT == 0;
}

invariant aj_decision_last_branch_denies {
    assert aj_decide(0, 7, 29) != AJ_OK;
    assert aj_decide(0, 0, 0) == AJ_DENY_ACTION;
}
