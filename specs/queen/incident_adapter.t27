// specs/queen/incident_adapter.t27 - Doctor incident to Queen task adapter
module queen::incident_adapter {
    use queen::tasks::{QueenTask, TaskStatus, Evidence};
    use github::issues::{Issue, ISSUE_STATE_OPEN};

    // Doctor incident structure
    struct DoctorIncident {
        id: str,
        title: str,
        description: str,
        severity: str,
        created_at: str,
        status: str,
        evidence: [Evidence],
    }

    // Convert Doctor incident to Queen task
    fn incident_to_queen_task(incident: DoctorIncident) -> QueenTask {
        // Extract relevant evidence from incident
        var task_evidence: [Evidence] = undefined;
        
        // Add incident evidence to task
        var incident_evidence: Evidence = undefined;
        incident_evidence.id = timestamp_ms();
        incident_evidence.timestamp = incident.created_at;
        incident_evidence.content = format!("Incident: {}\nSeverity: {}\nDescription: {}", 
                                         incident.title, incident.severity, incident.description);
        incident_evidence.source = "incident";
        task_evidence.push(incident_evidence);
        
        // Copy all existing evidence
        for (var i = 0; i < incident.evidence.len; i++) {
            task_evidence.push(incident.evidence[i]);
        }
        
        // Create Queen task from incident
        var task: QueenTask = undefined;
        task.id = timestamp_ms();
        task.title = format!("[INCIDENT] {}", incident.title);
        task.status = TaskStatus.OPEN;
        task.owner = "";
        task.github_issue_id = 0;  // Will be created when GitHub issue is made
        task.evidence = task_evidence;
        task.created_at = incident.created_at;
        task.updated_at = incident.created_at;
        task.incident_id = incident.id;
        
        return task;
    }

    // Create Queen task and GitHub issue from Doctor incident
    fn incident_to_task_and_issue(incident: DoctorIncident) -> (QueenTask, u32, str) {
        var task = incident_to_queen_task(incident);
        
        // Create GitHub issue
        var issue: Issue = undefined;
        issue.number = generate_issue_number();
        issue.title = task.title;
        issue.state = ISSUE_STATE_OPEN;
        
        // Add incident details to issue body
        var issue_body: str = format!(
            "# Queen Task Created from Doctor Incident\n\n"
            "## Incident Details\n"
            "- **Incident ID**: {}\n"
            "- **Severity**: {}\n"
            "- **Original Description**: {}\n\n"
            "## Task Description\n"
            "This Queen task was automatically created from a Doctor incident.\n\n"
            "## Next Steps\n"
            "1. Review the incident details above\n"
            "2. Claim this task with `TASK_CLAIMED` comment\n"
            "3. Investigate and resolve the underlying issue\n"
            "4. Update task status as progress is made",
            incident.id, incident.severity, incident.description
        );
        
        // Create issue (mock implementation)
        var issue_id: u32 = github::issues::issue_create_with_body(issue, issue_body);
        var issue_url: str = format!("https://github.com/owner/repo/issues/{}", issue.number);
        
        // Update task with GitHub issue ID
        task.github_issue_id = issue_id;
        
        return (task, issue_id, issue_url);
    }

    // Test: Incident creates persistent Queen task
    test "incident_creates_persistent_task" {
        var incident_evidence: [Evidence] = undefined;
        var incident: DoctorIncident = undefined;
        incident.id = "incident-123";
        incident.title = "Test Doctor Incident";
        incident.description = "This is a test incident description";
        incident.severity = "high";
        incident.created_at = "2024-01-01T00:00:00Z";
        incident.status = "open";
        incident.evidence = incident_evidence;
        
        var task = incident_to_queen_task(incident);
        
        // Verify task creation
        assert(task.id > 0);
        assert(task.title == "[INCIDENT] Test Doctor Incident");
        assert(task.status == TaskStatus.OPEN);
        assert(task.incident_id == "incident-123");
        
        // Verify evidence preservation
        assert(task.evidence.len >= 1);
        assert(task.evidence[0].content.contains("Test Doctor Incident"));
        assert(task.evidence[0].source == "incident");
    }

    // Test: Task creates/links GitHub Issue
    test "task_links_github_issue" {
        var incident_evidence: [Evidence] = undefined;
        var incident: DoctorIncident = undefined;
        incident.id = "incident-456";
        incident.title = "GitHub Integration Test";
        incident.description = "Testing GitHub issue creation";
        incident.severity = "medium";
        incident.created_at = "2024-01-01T00:00:00Z";
        incident.status = "open";
        incident.evidence = incident_evidence;
        
        var (task, issue_id, issue_url) = incident_to_task_and_issue(incident);
        
        // Verify issue creation and linking
        assert(issue_id > 0);
        assert(issue_url.contains("github.com"));
        assert(task.github_issue_id == issue_id);
        
        // Verify issue body contains incident details
        var issue_body = github::issues::issue_get_body(issue_id);
        assert(issue_body.contains("Queen Task Created from Doctor Incident"));
        assert(issue_body.contains("incident-456"));
        assert(issue_body.contains("TASK_CLAIMED"));
    }

    // Test: Full incident-to-task workflow
    test "full_incident_to_task_workflow" {
        // Create test incident
        var incident_evidence: [Evidence] = undefined;
        var incident: DoctorIncident = undefined;
        incident.id = "incident-workflow-789";
        incident.title = "Workflow Test Incident";
        incident.description = "Testing complete incident-to-task workflow";
        incident.severity = "critical";
        incident.created_at = "2024-01-01T00:00:00Z";
        incident.status = "open";
        incident.evidence = incident_evidence;
        
        // Convert to task and create issue
        var (task, issue_id, issue_url) = incident_to_task_and_issue(incident);
        
        // Verify task state
        assert(task.status == TaskStatus.OPEN);
        assert(task.owner == "");
        
        // Simulate agent claiming the task
        var claim_success = queen::tasks::task_claim(task, "agent-001");
        assert(claim_success == true);
        assert(task.status == TaskStatus.CLAIMED);
        assert(task.owner == "agent-001");
        
        // Verify GitHub state changes
        var issue = github::issues::issue_get(issue_id);
        assert(issue.state == ISSUE_STATE_OPEN);
        assert(issue.labels.contains("claimed"));
        
        // Verify claim comment exists
        var comments = github::comments::comment_list(issue_id);
        var claim_comment_found = false;
        for (var i = 0; i < comments.len; i++) {
            if (comments[i].body.contains("TASK_CLAIMED")) {
                claim_comment_found = true;
                break;
            }
        }
        assert(claim_comment_found == true);
    }

    // Helper functions
    fn timestamp_ms() -> u64 {
        return 1700000000000u64;  // Mock implementation
    }

    fn generate_issue_number() -> u32 {
        return 1001u32;
    }
}