; VISUAL-DISPATCH-SPEC
; Purpose: Define how the Queen spawns agents in the GUI for visibility.
; Law L7 Compliance: Logic for agent dispatch described in .t27.

module visual_dispatch {
  
  enum AgentRole {
    CREATOR,   // implementation
    VERIFIER,  // validation
    LEARNER,   // pattern extraction
    EXPERIENCE // context gathering
  }

  task spawn_agent_lane {
    input: ticket_id, role;
    
    // Visual Requirement: The agent must open in a separate pane/chat
    // so the owner can see the work in real-time.
    step 1: open_pane {
      title: "Queen-Lane: " + ticket_id + " [" + role + "]";
      model: route_by_complexity(ticket_id);
    }
    step 2: inject_context {
      load_spec(ticket_id);
      load_constitutional_laws();
    }
    step 3: execute_phi_phase {
      trigger_skill(role.associated_skill());
    }
    
    assert pane_visible == true
  }

  invariant transparency {
    // Every autonomous action must be visible in a dedicated GUI chat
    assert hidden_agents == 0
  }
}

test dispatch_visibility {
  assert visual_dispatch.spawn_agent_lane(101, AgentRole.CREATOR) == true
}
