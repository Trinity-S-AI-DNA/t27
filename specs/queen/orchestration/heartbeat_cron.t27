; HEARTBEAT-CRON-SPEC
; Defines the trigger intervals for the autonomous loop.

module heartbeat_cron {
  const loop_interval = "15m";
  const auto_recovery_timeout = "5m";

  task trigger_loop {
    if (current_time % loop_interval == 0) {
      invoke(decentralized_actor_loop.autonomous_cycle);
    }
  }
}
