// SPDX-License-Identifier: Apache-2.0
; specs/queen/actors_hw_top.t27 -- the top that puts the actor engine's self-test on the die (gHashTag/t27#8826,
; FPGA row of gHashTag/trios#1763): device primitives and wiring around QueenActorsHwJtag
; (specs/queen/actors_hw_jtag.t27), which holds QueenActorsHw (specs/queen/actors_hw.t27). All three modules
; are written by t27b's Verilog path (specs/tri/t27b/verilog_plan.t27); none is hand-written. It needs no board
; pin: the clock is STARTUPE2's CFGMCLK and the verdict leaves over JTAG USER1, so it fits any 7-series die
; (here the ALINX AX7203, xc7a200tfbg484-2, fpga/HARDWARE_SSOT.md).
; --
; - STARTUPE2's CFGMCLK, through a BUFG, is this module's clock (`clk`).
; - The self-test runs on that clock divided by 2^(DIV_BIT + 1), through a second BUFG: CFGMCLK is 65 MHz
;   nominal and the engine's timing is read off place-and-route, so the self-test gets the margin and JTAG's
;   sampling gets the slack (TCK must hold each level for four self-test clocks: 8 x 4 / 65 MHz = 0.5 us, an
;   adapter speed of 1000 kHz, as specs/fpga/die_probe.t27 runs).
; - The self-test leaves reset POR_LAST + 1 clocks after configuration; its registers start at their initial
;   values before that, from the bitstream.
; - BSCANE2 is on chain 1 (USER1, JTAG instruction 0x02); its TDO is the self-test's tdo.
; The primitives are declared once, in specs/fpga/xc7_primitives.t27.
; This module declares no output: it instantiates externs, so its ports are only the ones it marks `pub`, and
; it marks none (verilog_plan.t27).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenActorsHwTop;

use fpga::xc7_primitives;

/// The self-test's output.
pub struct SelfTestOut { tdo: bool }

/// QueenActorsHwJtag, as t27b's Verilog path writes it from specs/queen/actors_hw_jtag.t27: an extern module.
/// Its clk, rst_n and en are written clk_, rst_n_ and en_, since this module declares its own.
pub fn QueenActorsHwJtag(clk_: bool, rst_n_: bool, en_: bool, tck: bool, sel: bool, capture: bool, shift: bool, tdi: bool) -> SelfTestOut {}

/// Which bit of the divider clocks the self-test: CFGMCLK / 8.
pub const DIV_BIT : u8 = 2;
/// The last count of the power-on reset.
pub const POR_LAST : u8 = 255;

const startup : Startupe2Out = STARTUPE2("FALSE", 10.0, false, false, false, false, false, false, false, true, true);
const gclk : BufgOut = BUFG(startup.CFGMCLK);
const clk : bool = gclk.O;
const rst_n : bool = true;
const en : bool = true;
const slow : BufgOut = BUFG(((div >> DIV_BIT) & 1) == 1);
const bscan : Bscane2Out = BSCANE2(1, true, selftest.tdo);
const selftest : SelfTestOut = QueenActorsHwJtag(slow.O, por == POR_LAST, true, bscan.TCK, bscan.SEL, bscan.CAPTURE, bscan.SHIFT, bscan.TDI);

var div : u8 = 0;
var por : u8 = 0;

// Every var is read before it is written, so the test's order and the clock edge agree.
fn on_clock() {
    div = div +% 1;
    if (por != POR_LAST) { por = por + 1; }
}

test the_divider_counts_and_wraps {
    div = 0;
    por = 0;
    var i : u32 = 0;
    while (i < 8) {
        on_clock();
        i = i + 1;
    }
    assert_eq(div, 8);
    div = 255;
    on_clock();
    assert_eq(div, 0);
}

test the_reset_is_released_once_and_stays_released {
    por = 0;
    var i : u32 = 0;
    while (i < 254) {
        on_clock();
        i = i + 1;
    }
    assert por != POR_LAST;
    on_clock();
    assert_eq(por, POR_LAST);
    on_clock();
    on_clock();
    assert_eq(por, POR_LAST);
}
