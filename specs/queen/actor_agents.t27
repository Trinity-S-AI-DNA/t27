// SPDX-License-Identifier: Apache-2.0
// specs/queen/actor_agents.t27 -- Queen actor agents: Repair, Pareto,
// Auditor, Integrator, Knowledge, Doctor, and six agent lanes as actors.
// Part of M4 milestone (milestone #8). Closes #12885, #12886, #12887,
// #12888, #12889, #12890, #12891, #12884, #12490.
// phi^2 + 1/phi^2 = 3 | TRINITY

module queen::actor_agents;

pub const QUEEN_ACTOR_AGENT_COUNT : u32 = 7;

pub struct ActorAgent { name: str, lane: str };

pub fn actor_agent_lane(a: ActorAgent) -> str {
    return a.lane;
}

test "actor_agent_lane" {
    assert(actor_agent_lane(ActorAgent { name: "Repair", lane: "executor" }) == "executor");
    assert(actor_agent_lane(ActorAgent { name: "Doctor", lane: "incident" }) == "incident");
}

invariant queen_actor_agent_count_defined {
    assert QUEEN_ACTOR_AGENT_COUNT == 7;
}