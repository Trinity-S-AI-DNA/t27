// SPDX-License-Identifier: Apache-2.0
; specs/queen/roadmap_index_adapter.t27 -- the markdown index row -> roadmap entry adapter
; Owner directive (E/R/Y read-route wave): the R ROADMAP petal reads roadmap.t27 entries, but the
; index rows arrive as markdown bullets from docs/ROADMAP.md. This card is the pure transformation
; between the two shapes, so the petal can read a markdown index without host I/O -- the host
; route (reading the working tree) stays the named missing link.
; ---
; WHAT IS DECIDED HERE: the pinned row grammar ("- #<issue> <status-word> r<ring> L<line>", one
; bullet per roadmap entry, prose never carried -- roadmap.t27 carries zero prose characters by
; law), the field parse (issue, status word matched against STATE_NAMES, ring, doc line), the
; refusal law (any malformed field refuses the whole row -- no guessed defaults), and the
; freshness law consumed from roadmap.t27 (an index built from doc content hash C is stale once
; the doc hashes D != C; freshness is the hash, never the time of the read).
; Fixture-fed only: the pinned rows below are FIXTURE truth and never publishable as live.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module QueenRoadmapIndexAdapter;

use queen::roadmap::RS_OPEN;
use queen::roadmap::RS_DONE;
use queen::roadmap::RS_DROPPED;
use queen::roadmap::ENTRY_STATES;
use queen::roadmap::STATE_NAMES;
use queen::roadmap::rm_entry_ok;
use queen::roadmap::rm_pointer;
use queen::roadmap::rm_pointer_issue;
use queen::roadmap::rm_pointer_line;
use queen::roadmap::rm_index_current;
use queen::roadmap::rm_publishable;
use queen::roadmap::rm_prose_chars_carried;
use queen::roadmap::DOC_PATH;
use queen::actor_semantics::TRUTH_FIXTURE;
use queen::actor_semantics::TRUTH_LIVE;

; --- 1. The field scan -------------------------------------------------------------------------------

/// End of the field starting at `at`: the next space or the row's end.
pub fn ra_field_end(row : []const u8, at : usize) -> usize {
    var i : usize = at;
    while (i < row.len and row[i] != 32) { i = i + 1; }
    return i;
}

/// Start of the next field after `at` (skipping one separating space), or the row's end.
pub fn ra_field_next(row : []const u8, at : usize) -> usize {
    const e : usize = ra_field_end(row, at);
    if (e < row.len) { return e + 1; }
    return e;
}

/// The digits in row[a..b) as a number, or 0 when any byte is not a digit (0 also refuses the
/// entry downstream, so a malformed number and an absent number fail the same way).
pub fn ra_num(row : []const u8, a : usize, b : usize) -> u64 {
    if (b <= a) { return 0; }
    var v : u64 = 0;
    var i : usize = a;
    while (i < b) {
        if (row[i] < 48 or row[i] > 57) { return 0; }
        v = v * 10 + row[i] - 48;
        i = i + 1;
    }
    return v;
}

/// Does row[a..b) equal the word byte for byte?
pub fn ra_word_is(row : []const u8, a : usize, b : usize, w : str) -> bool {
    if (b - a != w.len) { return false; }
    var i : usize = 0;
    while (i < w.len) {
        if (row[a + i] != w[i]) { return false; }
        i = i + 1;
    }
    return true;
}

; --- 2. The row grammar -----------------------------------------------------------------------------

/// The pinned grammar: `- #<issue> <status-word> r<ring> L<line>` -- five fields, no prose. The
/// row parses or the row refuses; nothing is defaulted.
pub const RA_FIELDS : usize = 5;

/// The issue field must read `#` followed by a positive number.
pub fn ra_issue(row : []const u8, a : usize, b : usize) -> u64 {
    if (b <= a or row[a] != 35) { return 0; }
    return ra_num(row, a + 1, b);
}

/// The status word matched against STATE_NAMES, or ENTRY_STATES (unknown) -- which rm_entry_ok
/// then refuses.
pub fn ra_status(row : []const u8, a : usize, b : usize) -> u8 {
    var s : u8 = 0;
    while (s < ENTRY_STATES) {
        if (ra_word_is(row, a, b, STATE_NAMES[s])) { return s; }
        s = s + 1;
    }
    return ENTRY_STATES;
}

/// The ring field must read `r` followed by a number that fits u16.
pub fn ra_ring(row : []const u8, a : usize, b : usize) -> u64 {
    if (b <= a or row[a] != 114) { return 0; }
    const v : u64 = ra_num(row, a + 1, b);
    if (v > 65535) { return 0; }
    return v;
}

/// The line field must read `L` followed by a positive number.
pub fn ra_line(row : []const u8, a : usize, b : usize) -> u64 {
    if (b <= a or row[a] != 76) { return 0; }
    return ra_num(row, a + 1, b);
}

; --- 3. The parse -----------------------------------------------------------------------------------

/// The whole row against the roadmap entry law. On success the pointer (issue x line via
/// roadmap.t27's rm_pointer), on refusal 0 -- the pointer law's own no-issue shape.
pub fn ra_row_pointer(row : []const u8) -> u64 {
    const a0 : usize = 0;
    const e0 : usize = ra_field_end(row, a0);
    if (ra_word_is(row, a0, e0, "-") == false) { return 0; }
    const a1 : usize = ra_field_next(row, a0);
    const e1 : usize = ra_field_end(row, a1);
    const issue : u64 = ra_issue(row, a1, e1);
    const a2 : usize = ra_field_next(row, a1);
    const e2 : usize = ra_field_end(row, a2);
    const status : u8 = ra_status(row, a2, e2);
    const a3 : usize = ra_field_next(row, a2);
    const e3 : usize = ra_field_end(row, a3);
    const ring : u64 = ra_ring(row, a3, e3);
    const a4 : usize = ra_field_next(row, a3);
    const e4 : usize = ra_field_end(row, a4);
    const line : u64 = ra_line(row, a4, e4);
    if (a4 >= row.len) { return 0; }
    if (e4 < row.len) { return 0; }
    if (rm_entry_ok(issue, status, ring as u16, line as u32) == false) { return 0; }
    return rm_pointer(issue, line as u32);
}

/// The row's status once it parses; ENTRY_STATES (refused) for a malformed row.
pub fn ra_row_status(row : []const u8) -> u8 {
    const a0 : usize = 0;
    const e0 : usize = ra_field_end(row, a0);
    if (ra_word_is(row, a0, e0, "-") == false) { return ENTRY_STATES; }
    const a2 : usize = ra_field_next(row, ra_field_next(row, a0));
    return ra_status(row, a2, ra_field_end(row, a2));
}

; --- 4. Freshness -----------------------------------------------------------------------------------

/// The freshness law is roadmap.t27's, consumed here without re-derivation: an index built from
/// doc content hash C is current only while the doc still hashes C.
pub fn ra_index_current(built_hash : u64, doc_hash : u64) -> bool {
    return rm_index_current(built_hash, doc_hash);
}

; --- 5. The fixture ---------------------------------------------------------------------------------

/// The pinned fixture rows: three legal bullets (open, done, dropped) and three refusals (a
/// missing issue, an unknown status word, a missing line field). FIXTURE truth, never published.
pub const RA_ROWS : [6]str = [
    "- #126 open r999 L40",
    "- #135 done r40 L41",
    "- #140 dropped r999 L77",
    "- #0 open r999 L40",
    "- #126 working r999 L40",
    "- #126 open r999",
];

// ---------------------------------------------------------------- tests

test the_row_grammar_parses_issue_status_ring_line {
    const row : str = RA_ROWS[0];
    assert(ra_row_pointer(row[0..row.len]) == rm_pointer(126, 40));
    assert(rm_pointer_issue(ra_row_pointer(row[0..row.len])) == 126);
    assert(rm_pointer_line(ra_row_pointer(row[0..row.len])) == 40);
    assert(ra_row_status(row[0..row.len]) == RS_OPEN);
    // the done and dropped rows read their own statuses
    const done : str = RA_ROWS[1];
    assert(ra_row_pointer(done[0..done.len]) == rm_pointer(135, 41));
    assert(ra_row_status(done[0..done.len]) == RS_DONE);
    const dropped : str = RA_ROWS[2];
    assert(ra_row_pointer(dropped[0..dropped.len]) == rm_pointer(140, 77));
    assert(ra_row_status(dropped[0..dropped.len]) == RS_DROPPED);
}

test a_malformed_row_refuses_whole_never_defaults {
    // zero issue: refused (0 is also rm_pointer's refusal shape)
    const r3 : str = RA_ROWS[3];
    assert(ra_row_pointer(r3[0..r3.len]) == 0);
    // an unknown status word: refused
    const r4 : str = RA_ROWS[4];
    assert(ra_row_pointer(r4[0..r4.len]) == 0);
    assert(ra_row_status(r4[0..r4.len]) == ENTRY_STATES);
    // a missing field: refused
    const r5 : str = RA_ROWS[5];
    assert(ra_row_pointer(r5[0..r5.len]) == 0);
    // not a bullet at all: refused
    const junk : str = "prose about the roadmap";
    assert(ra_row_pointer(junk[0..junk.len]) == 0);
    // two entries never share a pointer
    const r0 : str = RA_ROWS[0];
    const r1 : str = RA_ROWS[1];
    assert(ra_row_pointer(r0[0..r0.len]) != ra_row_pointer(r1[0..r1.len]));
}

test the_field_scan_is_exact {
    const row : str = RA_ROWS[0];
    // the bullet, the issue, the status, the ring and the line are found field by field
    assert(ra_word_is(row[0..row.len], 0, 1, "-"));
    assert(ra_issue(row[0..row.len], 2, 6) == 126);
    assert(ra_status(row[0..row.len], 7, 11) == RS_OPEN);
    assert(ra_ring(row[0..row.len], 12, 16) == 999);
    assert(ra_line(row[0..row.len], 17, 20) == 40);
    // wrong prefixes refuse the field
    assert(ra_issue(row[0..row.len], 2, 6) != 0 and ra_issue(row[0..row.len], 3, 6) == 0);
    assert(ra_ring(row[0..row.len], 12, 16) != 0 and ra_ring(row[0..row.len], 13, 16) == 0);
    assert(ra_line(row[0..row.len], 17, 20) != 0 and ra_line(row[0..row.len], 18, 20) == 0);
}

test freshness_is_the_doc_hash_consumed_not_rederived {
    // an index built from hash 881 is current only while the doc still hashes 881
    assert(ra_index_current(881, 881));
    assert(ra_index_current(881, 882) == false);
    // the fixture index is fixture truth, never published as live
    assert(rm_publishable(TRUTH_FIXTURE) == false and rm_publishable(TRUTH_LIVE));
    // the adapter carries no prose, whatever the doc holds
    assert(rm_prose_chars_carried(4000) == 0);
    // and the doc the rows come from is the one roadmap.t27 names
    assert(DOC_PATH == "docs/ROADMAP.md");
}

invariant the_adapter_adds_no_second_entry_law {
    assert(ENTRY_STATES == 3 and RA_FIELDS == 5);
    assert(rm_entry_ok(126, RS_OPEN, 999, 40) and rm_entry_ok(0, RS_OPEN, 999, 40) == false);
    assert(rm_index_current(7, 7) and rm_index_current(7, 8) == false);
}
