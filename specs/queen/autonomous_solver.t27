; AUTONOMOUS-SOLVER-SPEC
; Law L7 Compliance: Orchestration moved from .sh to .t27
; Purpose: Define the autonomous loop for issue resolution.

module autonomous_solver {
  
  // The state machine for the Queen's loop
  enum LoopState {
    SCANNING,
    TICKET_ACQUIRED,
    EXECUTING_PHI,
    VERIFYING,
    LANDING,
    LEARNING
  }

  const priority_labels = ["P0", "P1"];
  const target_search_term = "epic";

  task solve_issue {
    input: issue_id;
    
    // PHI LOOP sequence
    step 1: observe {
      read_issue(issue_id);
      gather_context();
    }
    step 2: plan {
      breakdown_tasks();
      identify_skills();
    }
    step 3: execute {
      delegate_impl();
      verify_conformance();
    }
    step 4: land {
      merge_to_master();
      seal_hash();
    }
    
    assert loop_state == LoopState.LANDING
  }

  invariant autonomous_purity {
    // No hand-written shell scripts allowed for task execution
    assert forbidden("*.sh") == true
  }
}

test autonomous_loop_logic {
  assert autonomous_solver.solve_issue(123) == true
}
