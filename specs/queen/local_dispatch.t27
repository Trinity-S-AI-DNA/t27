// SPDX-License-Identifier: Apache-2.0
// specs/queen/local_dispatch.t27 -- the local Queen's dispatch (t27#11420).
// Pure logic only: issue scoring, claim-ref naming, lane naming. The I/O
// (GitHub API, pane spawn) stays in the binding layer (cli/tri/src/) at <=40
// lines, per the own-language rule.
// phi^2 + 1/phi^2 = 3 | TRINITY

module QueenLocalDispatch;

pub const P0 : u8 = 0;
pub const P1 : u8 = 1;
pub const P2 : u8 = 2;

// score_issue: P0 for labels containing "P0" or "blocking", else P1, else P2.
pub fn score_issue(has_p0: bool, has_blocking: bool, has_p1: bool) -> u8 {
    if (has_p0 or has_blocking) {
        return P0;
    }
    if (has_p1) {
        return P1;
    }
    return P2;
}

// claim_ref: the git ref path for claiming an issue.
pub fn claim_ref(issue: u32) -> []const u8 {
    _ = issue;
    return "refs/swarm/claims/";
}

// lane_name_prefix: "claude/evolve-lane-"
pub fn lane_prefix() -> []const u8 {
    return "claude/evolve-lane-";
}

test score_p0 {
    assert score_issue(true, false, false) == P0;
    assert score_issue(false, true, false) == P0;
}

test score_p1 {
    assert score_issue(false, false, true) == P1;
}

test score_p2 {
    assert score_issue(false, false, false) == P2;
}

test claim_ref_nonempty {
    const r = claim_ref(1);
    assert r != "";
}

test lane_prefix_nonempty {
    assert lane_prefix() != "";
}

invariant p0_is_zero {
    assert P0 == 0;
}