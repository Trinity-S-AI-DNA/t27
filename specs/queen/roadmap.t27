// SPDX-License-Identifier: Apache-2.0
; specs/queen/roadmap.t27 -- the eight goals that sum up the project plan, in one declarative table (gHashTag/t27#9022, 2026-10-14).
; The Queen serves GET /queen/roadmap from this file's constants: goals with stage, titles in English and Russian,
; why, and the GitHub epics whose sub-issues measure progress. The Russian titles and the per-goal done-criteria
; are served by the runtime from its own tables (the Queen runtime lives in the separate gHashTag/trinity repo);
; they are not restated here, because this repository's source files are ASCII only (L3).
; The plan shape is pinned by docs/ROADMAP_BRIEF.md ("The goal: dogfood all the way to the top", 2026-10-12):
; the five matryoshka layers L0-L4 (AGENTS.md, "The matryoshka", 2026-10-11), then t27o as a service, effects
; at the edge, and dogfooding our own repos. The still-holding stage goals ride inside as epics
; (docs/ROADMAP_BRIEF.md, stack table, 2026-10-12).
; Facts: the seed compiler's retirement epic #5980 spans L0 and L1, and t27b's epic #6198 spans L2 and L3
; (AGENTS.md, "The matryoshka", 2026-10-11); spec-compile is #4543 and silicon is #4549
; (docs/ROADMAP_BRIEF.md, stack table, 2026-10-12); effects at the edge is epic #9008
; (specs/tools/capability.t27, header); dogfooding is epic #6457 (specs/tri/t27b/dogfood.t27, header).
; Progress per goal is derived, not stored: closed sub-issues over open plus closed sub-issues of the goal's
; epics, as a number 0..100. The epics live on GitHub; this file only turns counts into a percentage.
; A goal's weight comes from its stage plus a boost while it sits on the critical path; specs/queen/priority.t27
; adds it to label rank, and specs/queen/self_health.t27 watches the path for drift.
; Not here: the HTTP layer that serves the endpoint, and the publish step that feeds stack.json
; (apps/website/scripts/roadmap-stack.mjs in gHashTag/trinity, per docs/ROADMAP_BRIEF.md, 2026-10-12; the
; measured .t27 share must not fall, per docs/T27-CONSTITUTION.md, "Same-metric check", line 87).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenRoadmap;

/// Sentinel goal index: the issue is linked to no goal and ranks on labels alone (specs/queen/priority.t27).
pub const GOAL_NONE : u32 = 8;

/// The eight goals, base first: five matryoshka layers L0-L4 (AGENTS.md, "The matryoshka", 2026-10-11), then
/// t27o as a service, effects at the edge, and dogfooding our own repos (docs/ROADMAP_BRIEF.md, 2026-10-12).
pub const GOAL_STAGES : [8]str = { "L0", "L1", "L2", "L3", "L4", "t27o", "effects", "dogfood" };

/// The English title of each goal, same order as GOAL_STAGES. The Russian titles are the runtime's own
/// translation table, served by GET /queen/roadmap; they are not restated here (ASCII only, L3).
pub const GOAL_TITLES : [8]str = {
    "Retire the seed compiler",
    "The compiler in its own language",
    "t27b compiles code",
    "t27b compiles itself",
    "Hardware",
    "t27o as a service",
    "Effects at the edge",
    "Dogfooding our own repos",
};

/// Why each goal holds, one line, same order as GOAL_STAGES.
pub const GOAL_WHY : [8]str = {
    "The seed compiler is hand-written Rust; the language proves nothing until it retires its own tool (AGENTS.md, the matryoshka; epic #5980 retires it).",
    "The compiler in its own language is the proof that the language can carry the stack (AGENTS.md, L1).",
    "t27b compiles code: the first layer the language itself builds, mounted with #[path] (AGENTS.md, L2; epic #6198).",
    "t27b compiles itself byte-for-byte, with no t27c in the loop (AGENTS.md, L3).",
    "The language reaches hardware: the Verilog path is decided in .t27 plans (AGENTS.md, L4; epic #4549).",
    "The language as a service: contracts and capabilities over HTTP, not just in-process (docs/ROADMAP_BRIEF.md; epic #8998).",
    "Effects at the edge: file, net, and process capabilities are declared, not assumed (specs/tools/capability.t27; epic #9008).",
    "Dogfooding our own repos: specs describe specs, from masking to capability (specs/tri/t27b/dogfood.t27; epic #6457).",
};

/// The epic that measures each goal's progress, one row per epic, with the goal index it feeds. A shared epic
/// is listed once per goal it spans (#5980 spans L0-L1, #6198 spans L2-L3); progress counters attribute its
/// sub-issues per epic, not per row, and goal_for_issue resolves a shared epic to its first listed goal.
pub const EPIC_IDS : [9]u32 = { 5980, 5980, 6198, 6198, 4543, 4549, 8998, 9008, 6457 };
pub const EPIC_GOALS : [9]u32 = { 0, 1, 2, 3, 2, 4, 5, 6, 7 };

/// Base weight per goal, same order as GOAL_STAGES: layer depth for L0-L4; the three goals that ride the stack
/// sit between L3 and L4. Ordering only -- the critical-path boost below is the term that decides.
pub const STAGE_WEIGHTS : [8]i64 = { 1, 2, 3, 4, 5, 4, 4, 3 };

/// The chain the plan rests on today: the seed retirement. docs/ROADMAP_BRIEF.md, stack table, 2026-10-12:
/// "t27c blocks them all." specs/queen/self_health.t27 watches it for drift.
pub const CRITICAL_PATH : [2]u32 = { 0, 1 };

/// Added once, when the issue's goal sits on the critical path.
pub const CRITICAL_BOOST : i64 = 10;

/// True when the goal sits on the current critical path.
pub fn on_critical_path(goal: u32) -> bool {
    var i : u32 = 0;
    while (i < 2) {
        if (CRITICAL_PATH[i] == goal) { return true; }
        i = i + 1;
    }
    return false;
}

/// Weight of a goal for ranking: stage weight, plus the critical-path boost once when the goal sits on the path.
/// GOAL_NONE weighs 0 (unlinked issues rank on labels alone).
pub fn goal_weight(goal: u32) -> i64 {
    if (goal >= GOAL_NONE) { return 0; }
    var w : i64 = STAGE_WEIGHTS[goal];
    if (on_critical_path(goal)) { w = w + CRITICAL_BOOST; }
    return w;
}

/// The goal an issue belongs to, by its epic; GOAL_NONE when unlinked.
pub fn goal_for_issue(issue: u32) -> u32 {
    var i : u32 = 0;
    while (i < 9) {
        if (EPIC_IDS[i] == issue) { return EPIC_GOALS[i]; }
        i = i + 1;
    }
    return GOAL_NONE;
}

/// Progress of a goal from its epics' sub-issue counts: closed over open plus closed, as 0..100. Zero
/// sub-issues counts as 0 progress, not an error.
pub fn goal_progress(closed: u32, open: u32) -> u32 {
    if (closed + open == 0) { return 0; }
    return (closed * 100) / (closed + open);
}

test roadmap_shape {
    assert GOAL_STAGES[0] == "L0";
    assert GOAL_STAGES[7] == "dogfood";
    assert GOAL_NONE == 8;
    assert EPIC_IDS[8] == 6457;
    assert EPIC_GOALS[8] == 7;
    assert on_critical_path(0);
    assert on_critical_path(1);
    assert on_critical_path(4) == false;
    assert goal_weight(0) == 11;
    assert goal_weight(4) == 5;
    assert goal_weight(5) == 4;
    assert goal_weight(8) == 0;
    assert goal_for_issue(9008) == 6;
    assert goal_for_issue(6457) == 7;
    assert goal_for_issue(1) == GOAL_NONE;
    assert goal_for_issue(5980) == 0;
    assert goal_progress(3, 1) == 75;
    assert goal_progress(7, 3) == 70;
    assert goal_progress(0, 0) == 0;
    assert goal_progress(2, 0) == 100;
}
