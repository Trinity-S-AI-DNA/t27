// SPDX-License-Identifier: Apache-2.0
; specs/queen/roadmap.t27 -- the tested INDEX of docs/ROADMAP.md, for the R ROADMAP petal
; Owner directive (petal unblock wave): R was blocked-by-law because no spec modeled what the
; roadmap contains. This card is the law; the prose stays where it is:
; - docs/ROADMAP.md is the prose source of truth for "what we are doing next". This spec is its
;   tested index: entry ids, statuses, targets and pointers INTO the doc. It never duplicates a
;   sentence of the prose -- a petal that wants the words reads the doc at the pointer.
; - an entry is one roadmap line the doc names: its GitHub issue id, its status, its target ring,
;   and the doc position (line) it points at. A pointer into nothing (line 0, issue 0) is refused.
; - truth law: a FIXTURE index is a snapshot of the doc at a pinned commit, used to test the
;   petal's rendering and filtering; a LIVE index is read from the doc in the working tree. An
;   index built at commit C goes stale when the doc's content hash changes; a stale index may be
;   shown only labelled stale, never as current.
; Feeding: once fed, R may claim: it shows the roadmap's real entries with their statuses and
; working pointers. It may not claim: priorities or dates the doc does not state -- the doc is
; the on-ramp; "what we are doing next" is GitHub Issues + Projects (the doc says so itself).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenRoadmap;

use queen::actor_semantics::TRUTH_FIXTURE;
use queen::actor_semantics::TRUTH_LIVE;

; --- 1. The prose source ------------------------------------------------------------------------------

/// The one prose home. The index points into it; it never quotes it.
pub const DOC_PATH : str = "docs/ROADMAP.md";

/// The index never stores prose. A row carries ids, statuses and positions only; any attempt to
/// carry prose characters is refused by this law (0 is the only honest answer).
pub fn rm_prose_chars_carried(n: u32) -> u32 {
    return 0;
}

; --- 2. Entries ---------------------------------------------------------------------------------------

/// An entry: the GitHub issue the doc names (> 0), a status, the target ring, and the doc line it
/// points at (> 0).
pub const RS_OPEN : u8 = 0;
pub const RS_DONE : u8 = 1;
pub const RS_DROPPED : u8 = 2;
pub const ENTRY_STATES : u8 = 3;
pub const STATE_NAMES : [3]str = ["open", "done", "dropped"];

pub fn rm_status_ok(status: u8) -> bool {
    return status < ENTRY_STATES;
}

/// A well-formed entry: a real issue, a known status, a real ring, a real line in the doc.
pub fn rm_entry_ok(issue: u64, status: u8, ring: u16, doc_line: u32) -> bool {
    if (issue == 0) { return false; }
    if (rm_status_ok(status) == false) { return false; }
    if (ring == 0) { return false; }
    return doc_line >= 1;
}

/// The pointer is one-way: the index points at the doc, the doc never points back at the index.
/// Reading the entry's words means opening DOC_PATH at doc_line.
pub fn rm_pointer(issue: u64, doc_line: u32) -> u64 {
    return issue * 100000 + doc_line as u64;
}

pub fn rm_pointer_issue(p: u64) -> u64 {
    return p / 100000;
}

pub fn rm_pointer_line(p: u64) -> u32 {
    return (p % 100000) as u32;
}

; --- 3. Truth: snapshot vs the working tree -----------------------------------------------------------

/// A FIXTURE index pins the doc at a commit (the content hash names which); a LIVE index is read
/// from the working tree now.
pub fn rm_publishable(truth: u8) -> bool {
    return truth == TRUTH_LIVE;
}

/// An index built from doc content hash C is stale once the doc hashes D != C. Stale may be shown
/// only labelled stale; the law answers false so a caller cannot mistake it for current.
pub fn rm_index_current(built_hash: u64, doc_hash: u64) -> bool {
    return built_hash == doc_hash;
}

test the_doc_is_named_and_never_quoted {
    assert DOC_PATH == "docs/ROADMAP.md";
    // the index carries no prose, whatever it is handed
    assert rm_prose_chars_carried(0) == 0;
    assert rm_prose_chars_carried(4000) == 0;
}

test an_entry_names_issue_status_ring_and_line {
    assert rm_entry_ok(126, RS_OPEN, 999, 40) == true;
    assert rm_entry_ok(135, RS_DONE, 40, 41) == true;
    // no issue, no line, no ring, or an unknown status: refused
    assert rm_entry_ok(0, RS_OPEN, 999, 40) == false;
    assert rm_entry_ok(126, RS_OPEN, 999, 0) == false;
    assert rm_entry_ok(126, RS_OPEN, 0, 40) == false;
    assert rm_entry_ok(126, ENTRY_STATES, 999, 40) == false;
}

test the_statuses_are_three_and_named {
    assert ENTRY_STATES == 3;
    assert rm_status_ok(RS_OPEN) == true and rm_status_ok(RS_DROPPED) == true;
    assert rm_status_ok(ENTRY_STATES) == false;
    assert STATE_NAMES[0] == "open" and STATE_NAMES[2] == "dropped";
}

test a_pointer_splits_back_into_issue_and_line {
    let p : u64 = rm_pointer(126, 40);
    assert rm_pointer_issue(p) == 126;
    assert rm_pointer_line(p) == 40;
    // two entries never share a pointer
    assert rm_pointer(126, 40) != rm_pointer(127, 40);
    assert rm_pointer(126, 40) != rm_pointer(126, 41);
}

test an_index_is_live_only_when_fresh_and_labeled {
    // a fixture snapshot of the doc is never published as current
    assert rm_publishable(TRUTH_FIXTURE) == false;
    assert rm_publishable(TRUTH_LIVE) == true;
    // freshness is the doc hash, not the time of the read
    assert rm_index_current(881, 881) == true;
    assert rm_index_current(881, 882) == false;
}

invariant the_index_law_has_one_home {
    assert ENTRY_STATES == 3;
    assert rm_prose_chars_carried(9999) == 0;
    assert DOC_PATH.len == 15;
}
