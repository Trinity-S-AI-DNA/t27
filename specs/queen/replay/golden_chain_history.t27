; Every link golden, landed in one pass from the merge-bases: the counts and each PR's outcome, as
; the gen-c of queen/golden_chain.t27 printed them.
test the_window_lands_in_one_pass_as_gc_land_answered {
    var v : [400]u8 = undefined;
    var k : usize = 0;
    while (k < 400) {
        v[k] = GC_V_PASS;
        k = k + 1;
    }
    var out : [80]u8 = undefined;
    var pos : [80]usize = undefined;
    assert gc_land(GCH_N, &GCH_ID, &GCH_PARENT, &v, GCH_M, &GCH_EO, &GCH_EP, &GCH_EK, &GCH_EL, &GCH_EH, GCH_Q, &GCH_IO, &GCH_IP, GCH_HEAD, &out, &pos) == 80;
    var fwd : usize = 0;
    var car : usize = 0;
    var reg : usize = 0;
    var rej : usize = 0;
    var con : usize = 0;
    var ung : usize = 0;
    var unk : usize = 0;
    var i : usize = 0;
    while (i < GCH_N) {
        if (out[i] == GC_OUT_FORWARD) {
            fwd = fwd + 1;
        }
        if (out[i] == GC_OUT_CARRIED) {
            car = car + 1;
        }
        if (out[i] == GC_OUT_REGEN) {
            reg = reg + 1;
        }
        if (out[i] == GC_OUT_REJUDGE) {
            rej = rej + 1;
        }
        if (out[i] == GC_OUT_CONFLICT) {
            con = con + 1;
        }
        if (out[i] == GC_OUT_NOT_GOLDEN) {
            ung = ung + 1;
        }
        if (out[i] == GC_OUT_UNKNOWN_PARENT) {
            unk = unk + 1;
        }
        i = i + 1;
    }
    assert fwd == 39;
    assert car == 32;
    assert reg == 9;
    assert rej == 0;
    assert con == 0;
    assert ung == 0;
    assert unk == 0;
    // #8776
    assert out[0] == GC_OUT_FORWARD;
    // #8777
    assert out[1] == GC_OUT_REGEN;
    // #8786
    assert out[2] == GC_OUT_CARRIED;
    // #8793
    assert out[3] == GC_OUT_FORWARD;
    // #8795
    assert out[4] == GC_OUT_FORWARD;
    // #8797
    assert out[5] == GC_OUT_FORWARD;
    // #8807
    assert out[6] == GC_OUT_FORWARD;
    // #8808
    assert out[7] == GC_OUT_REGEN;
    // #8810
    assert out[8] == GC_OUT_CARRIED;
    // #8814
    assert out[9] == GC_OUT_FORWARD;
    // #8818
    assert out[10] == GC_OUT_FORWARD;
    // #8819
    assert out[11] == GC_OUT_CARRIED;
    // #8820
    assert out[12] == GC_OUT_CARRIED;
    // #8825
    assert out[13] == GC_OUT_FORWARD;
    // #8830
    assert out[14] == GC_OUT_FORWARD;
    // #8833
    assert out[15] == GC_OUT_FORWARD;
    // #8836
    assert out[16] == GC_OUT_FORWARD;
    // #8837
    assert out[17] == GC_OUT_FORWARD;
    // #8840
    assert out[18] == GC_OUT_FORWARD;
    // #8845
    assert out[19] == GC_OUT_FORWARD;
