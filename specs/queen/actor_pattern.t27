// SPDX-License-Identifier: Apache-2.0
; specs/queen/actor_pattern.t27 -- the actor pattern contract for the 9h pilot tree (issue #13860, M0).
; Owner order, 2026-11-15: do not build an agent factory from scratch; take the actor patterns the specs
; already prove and make them inputs of the t27b pattern factory. This slice is the 3-node pilot only.
; -
; What this file is: a decision table with tests. It names the pattern kinds, the slots a generated actor
; carries, which pilot node fills which slot from an existing home today, and whether a node may run.
; What it is not: a runtime instance, a journal writer, a capability grant, or a restart engine.
; -
; Homes, named and never restated here:
;   - ids, parents and node kinds of the pilot tree: specs/queen/agent_registry.t27 sections 9f and 9h,
;     read by item-level use below;
;   - pids, restart types and strategies: specs/queen/actors.t27 (restart policy slot);
;   - capability bits: specs/queen/agent_card.t27 (capability grant slot);
;   - lead, mates, claims, stops: specs/queen/team_msg.t27 (message contract slot);
;   - T27L lines: specs/t27os/t27l.t27 (T27L event slot).
; -
; Rule of the slice: a slot with no home value today stays unfilled, and a node with an unfilled required
; slot is NOT runnable. No slot is filled to make a test pass. Today only the canonical id, the parent and
; the role kind have a home value for the three pilot nodes; the other seven slots are unfilled, so no
; pilot node is runnable. The test fully_filled_row_is_runnable proves the positive case with a synthetic
; mask that belongs to no pilot node.
; -
; t27b exports only functions with scalar parameters and results, so every accessor below takes and returns
; integers or bool, and a consumer of the object can read the whole tree.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module QueenActorPattern;

use queen::agent_registry::AN_TREE_N;
use queen::agent_registry::AN_TREE_IDS;
use queen::agent_registry::AN_TREE_PARENT;
use queen::agent_registry::AN_TREE_ROOT;
use queen::agent_registry::AN_TREE_KIND;
use queen::agent_registry::AN_KIND_HYPER;
use queen::agent_registry::AN_KIND_SUPERVISOR;
use queen::agent_registry::AN_KIND_SUBAGENT;
use queen::agent_registry::AN_KIND_COUNT;
use queen::agent_registry::an_kind_may_own;
use queen::agent_registry::an_id_ok;
use t27os::t27l::tl_event_line;
use t27os::t27l::tl_validate_line;
use t27os::t27l::TL_OK;
use std::mem::bytes_eq;

; --- 1. Pattern kinds (FR-001) ----------------------------------------------------------------------------
; Eight kinds named by the order. Only supervisor and subagent are defined in this slice.
pub const AP_SUPERVISOR : u8 = 0;
pub const AP_SUBAGENT : u8 = 1;
pub const AP_TEAM : u8 = 2;
pub const AP_EVENT : u8 = 3;
pub const AP_LANE : u8 = 4;
pub const AP_UI_COMPONENT : u8 = 5;
pub const AP_DATA_SOURCE : u8 = 6;
pub const AP_VERDICT : u8 = 7;
pub const AP_COUNT : u8 = 8;
/// Answer for "no pattern": an unknown kind or an index out of range.
pub const AP_NONE : u8 = 255;
/// Parent kind passed for the root, which has no parent above it.
pub const AP_NO_PARENT : u8 = 255;

/// True for the two patterns defined in this slice.
pub fn ap_defined(p: u8) -> bool {
    return p == AP_SUPERVISOR or p == AP_SUBAGENT;
}

; --- 2. Slots (FR-002) -------------------------------------------------------------------------------------
; Ten slots every generated actor carries; each is one bit of a mask.
pub const AP_SLOT_N : u8 = 10;
pub const AP_BIT_ID : u32 = 1;
pub const AP_BIT_PARENT : u32 = 2;
pub const AP_BIT_KIND : u32 = 4;
pub const AP_BIT_CAPS : u32 = 8;
pub const AP_BIT_WRITE_SCOPE : u32 = 16;
pub const AP_BIT_MSG_CONTRACT : u32 = 32;
pub const AP_BIT_RESTART : u32 = 64;
pub const AP_BIT_HEARTBEAT : u32 = 128;
pub const AP_BIT_T27L_EVENT : u32 = 256;
pub const AP_BIT_JOURNAL : u32 = 512;
pub const AP_ALL_SLOTS : u32 = 1023;

/// Slots a defined pattern requires. Both defined patterns require all ten slots; an undefined or unknown
/// pattern requires an unreachable value (0 slots is NOT "nothing required": see ap_row_runnable).
pub fn ap_required_mask(p: u8) -> u32 {
    if (p == AP_SUPERVISOR) { return AP_ALL_SLOTS; }
    if (p == AP_SUBAGENT) { return AP_ALL_SLOTS; }
    return 0;
}

; --- 3. Kinds map to patterns (FR-003) ---------------------------------------------------------------------
/// HYPER and SUPERVISOR nodes map to the supervisor pattern, the SUBAGENT node to the subagent pattern.
pub fn ap_pattern_of_kind(k: u8) -> u8 {
    if (k == AN_KIND_HYPER) { return AP_SUPERVISOR; }
    if (k == AN_KIND_SUPERVISOR) { return AP_SUPERVISOR; }
    if (k == AN_KIND_SUBAGENT) { return AP_SUBAGENT; }
    return AP_NONE;
}

; --- 4. Which slots are filled today (FR-004) -------------------------------------------------------------
; Filled from an existing home: canonical id (agent_registry 9h AN_TREE_IDS), parent (AN_TREE_PARENT), role
; kind (AN_TREE_KIND). Unfilled, with the home that will supply the value later: capability grant
; (agent_card.t27 CAP_* bits, no per-node grant exists), write scope (no home value), message contract
; (team_msg.t27, no per-node binding), restart policy (actors.t27 restart types, no per-node choice),
; heartbeat (no home value), T27L event (t27l.t27 shape exists, no per-node binding), journal replay (no
; home value).
pub const AP_TODAY : u32 = 7;
/// Filled mask of each pilot node, one entry per AN_TREE_IDS entry.
pub const AP_NODE_FILLED : [3]u32 = [7, 7, 7];

; --- 5. Rows (FR-006 negative controls) -------------------------------------------------------------------
/// Shape of a row, apart from its slots: the pattern is defined, it matches the node kind, and the parent
/// kind may own the node kind (the root, kind HYPER with AP_NO_PARENT, has no parent to check).
pub fn ap_row_shape_ok(pattern: u8, kind: u8, parent_kind: u8) -> bool {
    if (!ap_defined(pattern)) { return false; }
    if (ap_pattern_of_kind(kind) != pattern) { return false; }
    if (parent_kind == AP_NO_PARENT) { return kind == AN_KIND_HYPER; }
    return an_kind_may_own(parent_kind, kind);
}

/// True when every slot the pattern requires is in the mask. An undefined pattern is never complete.
pub fn ap_slots_complete(pattern: u8, mask: u32) -> bool {
    if (!ap_defined(pattern)) { return false; }
    const need : u32 = ap_required_mask(pattern);
    return (mask & need) == need;
}

/// A row may run only when its shape is valid and no required slot is missing.
pub fn ap_row_runnable(pattern: u8, kind: u8, parent_kind: u8, mask: u32) -> bool {
    return ap_row_shape_ok(pattern, kind, parent_kind) and ap_slots_complete(pattern, mask);
}

; --- 6. Scalar accessors over the pilot tree (FR-005) -----------------------------------------------------
/// Number of pilot nodes.
pub fn ap_node_count() -> usize {
    return AN_TREE_N;
}

/// Node kind (registry AN_KIND_*), AP_NONE when the index is out of range.
pub fn ap_node_kind(i: usize) -> u8 {
    if (i >= AN_TREE_N) { return AP_NONE; }
    return AN_TREE_KIND[i];
}

/// Parent index of a node (the root answers its own index), AP_NONE when the index is out of range.
pub fn ap_node_parent(i: usize) -> u8 {
    if (i >= AN_TREE_N) { return AP_NONE; }
    return AN_TREE_PARENT[i];
}

/// Pattern of a node, AP_NONE when the index is out of range.
pub fn ap_node_pattern(i: usize) -> u8 {
    if (i >= AN_TREE_N) { return AP_NONE; }
    return ap_pattern_of_kind(AN_TREE_KIND[i]);
}

/// Length in bytes of a node id, 0 when the index is out of range.
pub fn ap_id_len(i: usize) -> usize {
    if (i >= AN_TREE_N) { return 0; }
    return AN_TREE_IDS[i].len;
}

/// Byte j of the id of node i, 256 when i or j is out of range.
pub fn ap_id_byte(i: usize, j: usize) -> u32 {
    if (i >= AN_TREE_N) { return 256; }
    if (j >= AN_TREE_IDS[i].len) { return 256; }
    return AN_TREE_IDS[i][j];
}

/// True when the id of node i passes an_id_ok; false when the index is out of range.
pub fn ap_id_valid(i: usize) -> bool {
    if (i >= AN_TREE_N) { return false; }
    return an_id_ok(AN_TREE_IDS[i]);
}

/// Slots filled today for node i; 0 when the index is out of range.
pub fn ap_filled_mask(i: usize) -> u32 {
    if (i >= AN_TREE_N) { return 0; }
    return AP_NODE_FILLED[i];
}

/// Kind of the parent of node i, AP_NO_PARENT for the root and for an index out of range.
pub fn ap_parent_kind(i: usize) -> u8 {
    if (i >= AN_TREE_N) { return AP_NO_PARENT; }
    if (i == AN_TREE_ROOT) { return AP_NO_PARENT; }
    return AN_TREE_KIND[AN_TREE_PARENT[i]];
}

/// May node i run today: its row is runnable with the slots filled today. False out of range.
pub fn ap_runnable(i: usize) -> bool {
    if (i >= AN_TREE_N) { return false; }
    return ap_row_runnable(ap_node_pattern(i), AN_TREE_KIND[i], ap_parent_kind(i), AP_NODE_FILLED[i]);
}

; --- 7. T27L line for a generated artifact (FR-007) --------------------------------------------------------
; Uses only what t27l.t27 has: surface 11 "agent", action 29 "agent_created", actor 2 "agent", level 2.
pub const AP_T_EV : str = "22222222-3333-4444-8555-666666666666";
pub const AP_T_TS : str = "2026-11-15T12:00:00Z";

/// One canonical T27L line announcing a generated artifact; 0 when the envelope refuses the line.
pub fn ap_artifact_event(out: []u8, payload: []const u8) -> usize {
    return tl_event_line(out, AP_T_EV, AP_T_TS, "mac-1", "sess-1", 2, 11, 29, 2, "", "", "", payload, "");
}

; --- Tests -------------------------------------------------------------------------------------------------
; Not run on the Mac (hook mac-no-heavy): tests are not_run here; CI and the lab run them.

test pattern_kinds_eight_two_defined {
    assert AP_COUNT == 8;
    assert ap_defined(AP_SUPERVISOR);
    assert ap_defined(AP_SUBAGENT);
    assert !ap_defined(AP_TEAM);
    assert !ap_defined(AP_EVENT);
    assert !ap_defined(AP_LANE);
    assert !ap_defined(AP_UI_COMPONENT);
    assert !ap_defined(AP_DATA_SOURCE);
    assert !ap_defined(AP_VERDICT);
    // negative control: a kind past the eight is not defined either
    assert !ap_defined(AP_COUNT);
    assert !ap_defined(AP_NONE);
}

test ten_slots_and_required_sets {
    assert AP_SLOT_N == 10;
    const sum : u32 = AP_BIT_ID + AP_BIT_PARENT + AP_BIT_KIND + AP_BIT_CAPS + AP_BIT_WRITE_SCOPE
                    + AP_BIT_MSG_CONTRACT + AP_BIT_RESTART + AP_BIT_HEARTBEAT + AP_BIT_T27L_EVENT + AP_BIT_JOURNAL;
    assert sum == AP_ALL_SLOTS;
    assert ap_required_mask(AP_SUPERVISOR) == AP_ALL_SLOTS;
    assert ap_required_mask(AP_SUBAGENT) == AP_ALL_SLOTS;
    // negative control: an undefined pattern requires nothing the contract knows
    assert ap_required_mask(AP_TEAM) == 0;
    assert ap_required_mask(AP_NONE) == 0;
}

test kinds_map_to_patterns {
    assert ap_pattern_of_kind(AN_KIND_HYPER) == AP_SUPERVISOR;
    assert ap_pattern_of_kind(AN_KIND_SUPERVISOR) == AP_SUPERVISOR;
    assert ap_pattern_of_kind(AN_KIND_SUBAGENT) == AP_SUBAGENT;
    assert ap_pattern_of_kind(AN_KIND_COUNT) == AP_NONE;
    assert ap_node_pattern(0) == AP_SUPERVISOR;
    assert ap_node_pattern(1) == AP_SUPERVISOR;
    assert ap_node_pattern(2) == AP_SUBAGENT;
}

test pilot_tree_has_three_valid_distinct_ids {
    assert ap_node_count() == 3;
    var i : usize = 0;
    while (i < ap_node_count()) {
        assert ap_id_valid(i);
        assert ap_id_len(i) == AN_TREE_IDS[i].len;
        var j : usize = i + 1;
        while (j < ap_node_count()) {
            // pairwise distinct: either the lengths differ or some byte differs
            var same : bool = ap_id_len(i) == ap_id_len(j);
            var b : usize = 0;
            var diff : bool = false;
            while (same and b < ap_id_len(i)) {
                if (ap_id_byte(i, b) != ap_id_byte(j, b)) { diff = true; }
                b = b + 1;
            }
            assert !same or diff;
            j = j + 1;
        }
        i = i + 1;
    }
    // the accessor bytes are the registry bytes
    assert ap_id_byte(0, 0) == 48;
    assert ap_id_byte(0, 1) == 120;
}

test pilot_tree_shape_root_cycle_edges {
    var roots : usize = 0;
    var i : usize = 0;
    while (i < ap_node_count()) {
        const p : u8 = ap_node_parent(i);
        if (p == i) { roots = roots + 1; }
        // no self-parent besides the root
        if (i != AN_TREE_ROOT) { assert p != i; }
        // every edge is allowed by the registry
        if (i != AN_TREE_ROOT) { assert an_kind_may_own(ap_node_kind(p), ap_node_kind(i)); }
        // no cycle: walking up reaches the root within N steps
        var cur : usize = i;
        var steps : usize = 0;
        while (cur != AN_TREE_ROOT and steps < ap_node_count()) {
            cur = ap_node_parent(cur);
            steps = steps + 1;
        }
        assert cur == AN_TREE_ROOT;
        i = i + 1;
    }
    assert roots == 1;
    assert ap_node_parent(AN_TREE_ROOT) == AN_TREE_ROOT;
}

test every_pilot_row_has_a_valid_shape {
    var i : usize = 0;
    while (i < ap_node_count()) {
        assert ap_row_shape_ok(ap_node_pattern(i), ap_node_kind(i), ap_parent_kind(i));
        i = i + 1;
    }
}

test filled_slots_today_are_id_parent_kind_only {
    var i : usize = 0;
    while (i < ap_node_count()) {
        assert ap_filled_mask(i) == AP_BIT_ID + AP_BIT_PARENT + AP_BIT_KIND;
        assert ap_filled_mask(i) == AP_TODAY;
        // the seven other slots have no home value, so they stay unfilled
        assert ap_filled_mask(i) != AP_ALL_SLOTS;
        i = i + 1;
    }
}

test no_pilot_node_is_runnable_today {
    assert !ap_runnable(0);
    assert !ap_runnable(1);
    assert !ap_runnable(2);
}

test fully_filled_row_is_runnable {
    // synthetic masks and parent kinds, no pilot node: the positive case of the contract
    assert ap_row_runnable(AP_SUPERVISOR, AN_KIND_HYPER, AP_NO_PARENT, AP_ALL_SLOTS);
    assert ap_row_runnable(AP_SUPERVISOR, AN_KIND_SUPERVISOR, AN_KIND_HYPER, AP_ALL_SLOTS);
    assert ap_row_runnable(AP_SUBAGENT, AN_KIND_SUBAGENT, AN_KIND_SUPERVISOR, AP_ALL_SLOTS);
    assert ap_slots_complete(AP_SUBAGENT, AP_ALL_SLOTS);
}

test negative_controls_reject_bad_rows {
    // an unknown pattern
    assert !ap_row_runnable(AP_COUNT, AN_KIND_SUBAGENT, AN_KIND_SUPERVISOR, AP_ALL_SLOTS);
    assert !ap_row_runnable(AP_NONE, AN_KIND_SUBAGENT, AN_KIND_SUPERVISOR, AP_ALL_SLOTS);
    // an undefined pattern, even with every slot filled
    assert !ap_row_runnable(AP_TEAM, AN_KIND_SUBAGENT, AN_KIND_SUPERVISOR, AP_ALL_SLOTS);
    assert !ap_row_runnable(AP_VERDICT, AN_KIND_SUPERVISOR, AN_KIND_HYPER, AP_ALL_SLOTS);
    // a parent that may not own the node
    assert !ap_row_runnable(AP_SUBAGENT, AN_KIND_SUBAGENT, AN_KIND_SUBAGENT, AP_ALL_SLOTS);
    assert !ap_row_runnable(AP_SUBAGENT, AN_KIND_SUBAGENT, AN_KIND_HYPER, AP_ALL_SLOTS);
    assert !ap_row_runnable(AP_SUPERVISOR, AN_KIND_SUPERVISOR, AN_KIND_SUPERVISOR, AP_ALL_SLOTS);
    // a non-root kind without a parent
    assert !ap_row_runnable(AP_SUBAGENT, AN_KIND_SUBAGENT, AP_NO_PARENT, AP_ALL_SLOTS);
    // the pattern does not match the node kind
    assert !ap_row_runnable(AP_SUBAGENT, AN_KIND_SUPERVISOR, AN_KIND_HYPER, AP_ALL_SLOTS);
    // a missing required slot, one at a time
    assert !ap_row_runnable(AP_SUBAGENT, AN_KIND_SUBAGENT, AN_KIND_SUPERVISOR, AP_ALL_SLOTS - AP_BIT_CAPS);
    assert !ap_row_runnable(AP_SUBAGENT, AN_KIND_SUBAGENT, AN_KIND_SUPERVISOR, AP_ALL_SLOTS - AP_BIT_JOURNAL);
    assert !ap_row_runnable(AP_SUPERVISOR, AN_KIND_HYPER, AP_NO_PARENT, 0);
}

test index_out_of_range_is_refused {
    assert ap_node_kind(3) == AP_NONE;
    assert ap_node_parent(3) == AP_NONE;
    assert ap_node_pattern(3) == AP_NONE;
    assert ap_id_len(3) == 0;
    assert ap_id_byte(3, 0) == 256;
    assert ap_id_byte(0, 1000) == 256;
    assert !ap_id_valid(3);
    assert ap_filled_mask(3) == 0;
    assert !ap_runnable(3);
    assert ap_node_kind(1000) == AP_NONE;
}

test artifact_event_is_a_valid_t27l_line {
    var ln : [2048]u8 = undefined;
    const n : usize = ap_artifact_event(ln[0..2048], "agent=0xCompiler pattern=subagent");
    assert n > 0;
    assert tl_validate_line(ln[0..n]) == TL_OK;
    // negative control: an empty out buffer cannot hold a line
    var tiny : [4]u8 = undefined;
    assert ap_artifact_event(tiny[0..4], "x") == 0;
}
