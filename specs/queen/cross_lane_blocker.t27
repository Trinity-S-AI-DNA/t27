// specs/queen/cross_lane_blocker.t27 -- Cross-lane blocker protocol,
// master-red blockers, blocker attribution.
// Part of M4 milestone (milestone #8). Closes #13190, #13184.
// phi^2 + 1/phi^2 = 3 | TRINITY

module queen::cross_lane_blocker;

pub const CROSS_LANE_BLOCKER_MAX_LANES : u32 = 27;

pub struct CrossLaneBlocker { lane_id: str, blocked: bool, attributed: bool };

pub fn cross_lane_blocker_attributed(b: CrossLaneBlocker) -> bool {
    return b.blocked && b.attributed;
}

test "cross_lane_blocker_attributed" {
    assert(cross_lane_blocker_attributed(CrossLaneBlocker { lane_id: "lane-1", blocked: true, attributed: true }));
    assert(!cross_lane_blocker_attributed(CrossLaneBlocker { lane_id: "lane-2", blocked: true, attributed: false }));
}

invariant cross_lane_blocker_max_lanes_positive {
    assert CROSS_LANE_BLOCKER_MAX_LANES > 0;
}