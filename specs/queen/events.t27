// SPDX-License-Identifier: Apache-2.0
; specs/queen/events.t27 -- the event log as a bus: a cursor that loses nothing, read by every process
; and by anyone watching the board or the game
; Owner, 2026-10-08 (translated): lower every task to the scheduler's native level; the actors talk to
; each other, and the dashboard and the game show all of it. Epic #7718, slice 3. control.t27 section 1
; names the event kinds and what each wakes; this card says how an event travels.
; Measured on the supervisor (gHashTag/BrowserOS trios/agent-server) before this card:
; - the log took its number as MAX(seq)+1. Two writers at once got the same number, the second insert
;   hit the primary key, and the error was caught and dropped: an event lost without a word.
; - five of the ten kinds were never written (worker.idle, task.evidence, task.reviewed,
;   lease.heartbeat, tick), and nothing read the log back. A runner's task.ended woke nobody; it
;   waited out the Queen's next round.
; - the board and the game drew whole snapshots every few seconds, because there was no way to ask
;   "what changed since I last looked".
; - the GOLDEN CHAIN's accounting (golden-chain-international#140, #8609) publishes on a stream of
;   its own (section 7): anchor blocks, the contribution ledger, usage, signers, the atlas, the
;   gates. Not one new kind on the Queen's.
; Index of a per-kind table = control.t27 EV_*. The supervisor refuses to start when control.t27's
; EVENT_KINDS is not BUS_KINDS, so a new kind cannot ship without its row here.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenEvents;

pub const BUS_KINDS : u8 = 10;

; --- 1. The cursor -----------------------------------------------------------------------------------

/// Each stream numbers its events 1, 2, 3, ... with no gap and in commit order. The number comes from
/// a counter row the writing statement holds locked until it commits, so the next writer waits and
/// reads the number after it. A database sequence is the obvious tool and the wrong one: it hands out
/// numbers at insert, they commit in any order, and a reader that has seen 9 cannot know whether 8 is
/// still coming. Gapless is what lets a reader tell "nothing happened" from "I missed something".
pub fn next_seq(last: u64) -> u64 {
    return last + 1;
}

; --- 2. What is written ------------------------------------------------------------------------------

/// Seconds between two log rows of one kind for one task; 0 = every one, NEVER = not logged.
/// - evidence (4): a bee speaks many times a minute; one row a minute says it is alive and working.
/// - heartbeat (8): never. A heartbeat is the renewal of a lease row, which is already its record, and
///   at one per bee per minute it would be most of the log. The Queen needs no decision for it
///   (control.t27 wakes_queen), and liveness reaches the board through evidence.
/// - tick (9): written by the Queen's own timer, once per period, not by rounds an event asked for.
pub const NEVER : u32 = 4294967295;
pub const LOG_EVERY_SECONDS : [10]u32 = [0, 0, 0, 0, 60, 0, 0, 0, 4294967295, 0];

/// `seen_before`: this process logged the same kind for the same task before; `seconds_since`: since then.
pub fn log_due(kind: u8, seen_before: bool, seconds_since: u32) -> bool {
    if (kind >= BUS_KINDS) { return false; }
    if (LOG_EVERY_SECONDS[kind] == NEVER) { return false; }
    if (seen_before == false) { return true; }
    return seconds_since >= LOG_EVERY_SECONDS[kind];
}

/// Every kind that is logged is public, so the public feed has the log's numbers and no gap. What
/// keeps it safe is the projection: only these payload keys, and only scalar values. A string passes
/// only as a token (token_ok). A transcript line, a reason, a person's name, a URL with a query never
/// pass, whatever key they sit under.
pub const PUBLIC_KEYS : [5]str = ["issue", "outcome", "verdict", "repo", "slots"];
pub const TOKEN_MAX : usize = 128;

pub fn token_char(c: u8) -> bool {
    if (c >= 97 and c <= 122) { return true; }
    if (c >= 65 and c <= 90) { return true; }
    if (c >= 48 and c <= 57) { return true; }
    return c == 46 or c == 95 or c == 47 or c == 45;
}

/// A token: 1 to TOKEN_MAX letters, digits, or one of . _ / - ("accepted", "gHashTag/t27", "sendBack").
pub fn token_ok(buf: []const u8, n: usize) -> bool {
    if (n == 0 or n > TOKEN_MAX) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (token_char(buf[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

; --- 3. Reading past a cursor ------------------------------------------------------------------------

/// What a read after `cursor` finds, given the oldest and newest number the log still keeps (both 0 on
/// an empty log).
pub const CR_EMPTY : u8 = 0;
pub const CR_PAGE : u8 = 1;
pub const CR_RESYNC : u8 = 2;

/// RESYNC when the cursor is past the newest (the log was reset under the reader) or the events right
/// after it were pruned. A reader told to resync takes a snapshot, which carries a fresh cursor.
pub fn cursor_read(cursor: u64, oldest: u64, newest: u64) -> u8 {
    if (cursor > newest) { return CR_RESYNC; }
    if (cursor == newest) { return CR_EMPTY; }
    if (cursor + 1 < oldest) { return CR_RESYNC; }
    return CR_PAGE;
}

/// What a reader does with each event of a page, in order. Delivery is at least once (a poll and a
/// wake may both read the same row), so an event at or below the cursor is skipped; the next number is
/// applied; anything further means the reader missed some, and only a snapshot repairs that.
pub const DA_SKIP : u8 = 0;
pub const DA_APPLY : u8 = 1;
pub const DA_RESYNC : u8 = 2;

pub fn delta_action(cursor: u64, seq: u64) -> u8 {
    if (seq <= cursor) { return DA_SKIP; }
    if (seq == cursor + 1) { return DA_APPLY; }
    return DA_RESYNC;
}

/// Events one read returns. 0 asks for the default; more than the maximum gets the maximum.
pub const EVENTS_PAGE_DEFAULT : u32 = 200;
pub const EVENTS_PAGE_MAX : u32 = 1000;

pub fn page_size(asked: u32) -> u32 {
    if (asked == 0) { return EVENTS_PAGE_DEFAULT; }
    if (asked > EVENTS_PAGE_MAX) { return EVENTS_PAGE_MAX; }
    return asked;
}

/// A read with nothing new may wait for the next event instead of returning empty, at most
/// WAIT_MAX_SECONDS: under the 30-second idle timeout of the edge in front of the supervisor.
pub const WAIT_MAX_SECONDS : u32 = 25;

pub fn wait_seconds(asked: u32) -> u32 {
    if (asked > WAIT_MAX_SECONDS) { return WAIT_MAX_SECONDS; }
    return asked;
}

/// A board that read a page refreshes the tasks the page named, at most this many in one request.
/// More than that, and one snapshot is cheaper than the list.
pub const REFRESH_TASKS_MAX : u32 = 100;
pub const RF_NOTHING : u8 = 0;
pub const RF_TASKS : u8 = 1;
pub const RF_SNAPSHOT : u8 = 2;

pub fn refresh_action(changed_tasks: u32) -> u8 {
    if (changed_tasks == 0) { return RF_NOTHING; }
    if (changed_tasks > REFRESH_TASKS_MAX) { return RF_SNAPSHOT; }
    return RF_TASKS;
}

/// What a board does with one event. REFRESH: the task's column or its bee may have moved, so it is
/// read again (created, ended, lease.expired, reviewed, assign, cancel). TOUCH: the bee was heard and
/// nothing else changed, so the board marks it heard at the event's time and reads nothing (evidence,
/// the most frequent kind by far). NOTHING: the event names no task (worker.idle, tick).
pub const EA_NOTHING : u8 = 0;
pub const EA_REFRESH : u8 = 1;
pub const EA_TOUCH : u8 = 2;
pub const BOARD_ACTION : [10]u8 = [1, 1, 0, 1, 2, 1, 1, 1, 0, 0];

pub fn board_action(kind: u8) -> u8 {
    if (kind >= BUS_KINDS) { return EA_NOTHING; }
    return BOARD_ACTION[kind];
}

/// A board pauses this long after applying a page before it reads the next, so a burst of events
/// arrives as one page and one refresh rather than one each.
pub const READ_PAUSE_MS : u32 = 2000;

/// A board still takes a whole snapshot this often: it also shows what GitHub changed (an issue
/// opened, closed or edited), and no Queen event announces that. control.t27 reconciles the Queen on
/// the same period, for the same reason: events move the work, the period repairs what they miss.
pub const SNAPSHOT_EVERY_SECONDS : u32 = 300;

; --- 4. Every process follows the log ----------------------------------------------------------------

/// Each process reads the log past its own cursor every FOLLOW_MS, and at once after it writes, so an
/// event published by a runner reaches the Queen within a second instead of at her next round.
pub const FOLLOW_MS : u32 = 1000;

/// Kinds whose publisher already reacted in its own process: the dispatcher's created, the finisher's
/// ended, the reclaimer's lease.expired, the timer's tick. Read back from the log by that same process,
/// they wake nothing; read by any other process, they wake as control.t27 says.
pub const PUBLISHER_REACTS : [10]u8 = [1, 1, 0, 1, 0, 0, 0, 0, 0, 1];

/// `wakes`: control.t27 wakes_queen(kind). `published_here`: the row's origin is this process.
pub fn wakes_here(wakes: bool, kind: u8, published_here: bool) -> bool {
    if (wakes == false or kind >= BUS_KINDS) { return false; }
    if (published_here and PUBLISHER_REACTS[kind] == 1) { return false; }
    return true;
}

/// A runner with a free slot claims an order the moment task.created (0) is read, instead of at its
/// next poll; any other kind leaves it on its poll.
pub fn runner_claims_now(kind: u8, free_slots: u32) -> bool {
    return kind == 0 and free_slots > 0;
}

; --- 5. How long the log keeps an event --------------------------------------------------------------

/// An event is pruned once it is KEEP_SECONDS old AND at least KEEP_AT_LEAST newer events exist, so a
/// quiet week never empties the log a reader resumes from.
pub const KEEP_SECONDS : u32 = 259200;
pub const KEEP_AT_LEAST : u64 = 5000;

/// The highest number an old enough event may have and still be pruned; 0 = none.
pub fn prune_through(newest: u64) -> u64 {
    if (newest <= KEEP_AT_LEAST) { return 0; }
    return newest - KEEP_AT_LEAST;
}

; --- 6. The actors' own stream ---------------------------------------------------------------------

/// The actor runtime (actors.t27) publishes what its processes do on a stream of its own, ACTOR_STREAM,
/// of this same log: the same counter row and next_seq, the same cursor_read, delta_action, page_size
/// and prune_through. One sequence per stream, so a reader of the actors' feed can still tell
/// "nothing happened" from "I missed something" (section 1). A stream of its own, and not more kinds
/// on the Queen's, for two reasons: every process follows the Queen's stream (section 4), and actor
/// traffic must neither wake her nor bring her task events closer to the prune floor (section 5).
/// Kinds on that stream (gHashTag/trios#1744, agreed with the view of gHashTag/t27#8615). Index into
/// ACTOR_EVENT_NAMES. spawn, exit, DOWN and restart are rare and every one is written. A deliver that
/// names a task is written one by one (EV_ACTOR_DELIVER); every other deliver is counted into one
/// EV_ACTOR_DELIVERS per sender and receiver per window. actor_events.t27 decides which is which.
/// The first five are numbered as the view reads them (actor_view.t27, #8615: spawn, restart, exit,
/// down, deliver), so the board needs no table between the feed's kind and its own.
pub const ACTOR_STREAM : str = "actors";
pub const EV_ACTOR_SPAWN : u8 = 0;
pub const EV_ACTOR_RESTART : u8 = 1;
pub const EV_ACTOR_EXIT : u8 = 2;
pub const EV_ACTOR_DOWN : u8 = 3;
pub const EV_ACTOR_DELIVER : u8 = 4;
pub const EV_ACTOR_DELIVERS : u8 = 5;
pub const ACTOR_KINDS : u8 = 6;
pub const ACTOR_EVENT_NAMES : [6]str = [
    "actor.spawn", "actor.restart", "actor.exit", "actor.down", "actor.deliver", "actor.delivers"
];

/// Whether a kind is one the actors' stream carries. A row of any other kind on that stream is not
/// projected: it was not written by this card's rules.
pub fn actor_kind_ok(kind: u8) -> bool {
    return kind < ACTOR_KINDS;
}

test numbers_follow_one_another {
    assert next_seq(0) == 1;
    assert next_seq(41) == 42;
}

test evidence_is_thinned_and_heartbeats_are_not_logged {
    // created, ended, review: every one
    assert log_due(0, true, 0) == true;
    assert log_due(1, true, 0) == true;
    assert log_due(5, true, 0) == true;
    // evidence: the first, then one a minute
    assert log_due(4, false, 0) == true;
    assert log_due(4, true, 59) == false;
    assert log_due(4, true, 60) == true;
    // heartbeat: never, not even the first
    assert log_due(8, false, 0) == false;
    assert log_due(8, true, 4000000000) == false;
    // a kind the card has no row for is never written
    assert log_due(BUS_KINDS, false, 0) == false;
}

test a_token_is_short_and_plain {
    assert token_ok("accepted", 8) == true;
    assert token_ok("gHashTag/t27", 12) == true;
    assert token_ok("send_back-2.v1", 14) == true;
    assert token_ok("", 0) == false;
    assert token_ok("two words", 9) == false;
    assert token_ok("a?b=c", 5) == false;
    assert token_ok("x:y", 3) == false;
    assert token_ok("@me", 3) == false;
    assert token_ok("[z]", 3) == false;
    assert token_ok("{z}", 3) == false;
    assert token_ok("`z`", 3) == false;
    assert token_char(97) == true and token_char(122) == true;
    assert token_char(65) == true and token_char(90) == true;
    assert token_char(48) == true and token_char(57) == true;
    assert token_char(96) == false and token_char(123) == false;
    assert token_char(64) == false and token_char(91) == false;
    assert token_char(47) == true and token_char(58) == false;
    assert token_char(46) == true and token_char(95) == true and token_char(45) == true;
    assert token_char(44) == false and token_char(32) == false;
}

test a_token_has_a_ceiling {
    // 128 bytes of 'a' pass, 129 do not; n past the ceiling is refused before a byte is read
    assert token_ok("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128) == true;
    assert token_ok("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 129) == false;
}

test a_cursor_reads_a_page_nothing_or_a_resync {
    assert cursor_read(0, 0, 0) == CR_EMPTY;
    assert cursor_read(0, 1, 5) == CR_PAGE;
    assert cursor_read(4, 1, 5) == CR_PAGE;
    assert cursor_read(5, 1, 5) == CR_EMPTY;
    // the log was reset under the reader
    assert cursor_read(9, 1, 5) == CR_RESYNC;
    assert cursor_read(1, 0, 0) == CR_RESYNC;
    // the events right after the cursor were pruned
    assert cursor_read(10, 12, 40) == CR_RESYNC;
    assert cursor_read(11, 12, 40) == CR_PAGE;
    assert cursor_read(0, 2, 40) == CR_RESYNC;
}

test a_reader_skips_applies_or_resyncs {
    assert delta_action(5, 4) == DA_SKIP;
    assert delta_action(5, 5) == DA_SKIP;
    assert delta_action(5, 6) == DA_APPLY;
    assert delta_action(5, 7) == DA_RESYNC;
    assert delta_action(0, 1) == DA_APPLY;
}

test pages_and_waits_are_bounded {
    assert page_size(0) == EVENTS_PAGE_DEFAULT;
    assert page_size(1) == 1;
    assert page_size(EVENTS_PAGE_MAX) == EVENTS_PAGE_MAX;
    assert page_size(EVENTS_PAGE_MAX + 1) == EVENTS_PAGE_MAX;
    assert wait_seconds(0) == 0;
    assert wait_seconds(WAIT_MAX_SECONDS) == WAIT_MAX_SECONDS;
    assert wait_seconds(WAIT_MAX_SECONDS + 1) == WAIT_MAX_SECONDS;
    assert wait_seconds(3600) == WAIT_MAX_SECONDS;
}

test a_board_refreshes_what_changed {
    assert refresh_action(0) == RF_NOTHING;
    assert refresh_action(1) == RF_TASKS;
    assert refresh_action(REFRESH_TASKS_MAX) == RF_TASKS;
    assert refresh_action(REFRESH_TASKS_MAX + 1) == RF_SNAPSHOT;
}

test a_board_refreshes_touches_or_ignores {
    assert board_action(0) == EA_REFRESH;
    assert board_action(1) == EA_REFRESH;
    assert board_action(2) == EA_NOTHING;
    assert board_action(3) == EA_REFRESH;
    assert board_action(4) == EA_TOUCH;
    assert board_action(5) == EA_REFRESH;
    assert board_action(6) == EA_REFRESH;
    assert board_action(7) == EA_REFRESH;
    assert board_action(8) == EA_NOTHING;
    assert board_action(9) == EA_NOTHING;
    assert board_action(BUS_KINDS) == EA_NOTHING;
}

test an_event_wakes_once {
    // a runner's task.ended (1) wakes the Queen; her own does not wake her twice
    assert wakes_here(true, 1, false) == true;
    assert wakes_here(true, 1, true) == false;
    // created, lease.expired, tick: the publisher reacted
    assert wakes_here(true, 0, true) == false;
    assert wakes_here(true, 3, true) == false;
    assert wakes_here(true, 9, true) == false;
    assert wakes_here(true, 9, false) == true;
    // assign (6), cancel (7), review (5), idle (2), evidence (4): published by a route or a bee, they wake
    assert wakes_here(true, 6, true) == true;
    assert wakes_here(true, 7, true) == true;
    assert wakes_here(true, 5, true) == true;
    assert wakes_here(true, 2, true) == true;
    assert wakes_here(true, 4, true) == true;
    // a kind that wakes nobody, or one the card does not know, wakes nobody
    assert wakes_here(false, 8, false) == false;
    assert wakes_here(true, BUS_KINDS, false) == false;
}

test a_runner_claims_on_created_only {
    assert runner_claims_now(0, 1) == true;
    assert runner_claims_now(0, 0) == false;
    assert runner_claims_now(1, 4) == false;
    assert runner_claims_now(2, 4) == false;
}

test the_log_keeps_a_floor {
    assert prune_through(0) == 0;
    assert prune_through(KEEP_AT_LEAST) == 0;
    assert prune_through(KEEP_AT_LEAST + 1) == 1;
    assert prune_through(KEEP_AT_LEAST + 900) == 900;
}

invariant one_row_per_kind {
    assert BUS_KINDS == 10;
    assert LOG_EVERY_SECONDS[8] == NEVER;
    assert LOG_EVERY_SECONDS[4] == 60;
    assert EVENTS_PAGE_DEFAULT <= EVENTS_PAGE_MAX;
    assert WAIT_MAX_SECONDS < 30;
    assert KEEP_SECONDS == 72 * 3600;
    assert READ_PAUSE_MS < FOLLOW_MS * 5;
    assert SNAPSHOT_EVERY_SECONDS * 1000 > READ_PAUSE_MS;
}

test the_actors_have_kinds_of_their_own {
    assert actor_kind_ok(EV_ACTOR_SPAWN) == true;
    assert actor_kind_ok(EV_ACTOR_EXIT) == true;
    assert actor_kind_ok(EV_ACTOR_DOWN) == true;
    assert actor_kind_ok(EV_ACTOR_RESTART) == true;
    assert actor_kind_ok(EV_ACTOR_DELIVER) == true;
    assert actor_kind_ok(EV_ACTOR_DELIVERS) == true;
    assert actor_kind_ok(ACTOR_KINDS) == false;
    assert actor_kind_ok(255) == false;
}

invariant the_actor_kinds_are_numbered_in_order {
    assert EV_ACTOR_SPAWN == 0 and EV_ACTOR_RESTART == 1 and EV_ACTOR_EXIT == 2;
    assert EV_ACTOR_DOWN == 3 and EV_ACTOR_DELIVER == 4;
    assert EV_ACTOR_DELIVERS == ACTOR_KINDS - 1;
    assert ACTOR_KINDS == 6;
}

; --- 7. The golden chain's own stream (#8609) --------------------------------------------------------
; 
; The GOLDEN CHAIN design (golden-chain-international#140, Green Paper plus White Paper v0.9) runs
; its accounting through this bus. Not the pipeline's golden chain: golden_chain.t27 versions the
; pipeline's verdicts (#9027); this section carries the network's ledger. The two share a name and
; nothing else.
; A stream of its own, for section 6's reasons doubled. Accounting is not task traffic: it must
; neither wake the Queen (section 4) nor push task events past the prune floor (section 5), and no
; kind may ship on the Queen's stream without a row in control.t27, which this card does not
; touch. Same plumbing as the actors' feed: a counter row and next_seq (section 1), the same
; cursor_read, delta_action, page_size and prune_through (sections 3 and 5), one gapless sequence
; per stream, the same KEEP_SECONDS and floor. A row here is not the accounting: the ledger lives
; in recomputable files anyone may rebuild from git history (#8604), and the row only says the
; accounting moved, naming the root to check.
; One kind per plan item of #8609, in the plan's order:
pub const GLD_STREAM : str = "gld";

; #8603 (M0): the hub manifest's root was sealed into an anchor block. The block names a root;
; that is all it claims.
pub const GLD_ANCHOR_BLOCK : u8 = 0;
; #8603, rule RT-4: an anchor OUTSIDE t27 named the same root. Until this row arrives the block is
; a proposal, not an anchor (gld_anchored): a manifest that only the manifest anchors is circular.
pub const GLD_ANCHOR_EXTERN : u8 = 1;
; #8604: the contribution ledger, recomputed from git history over a commit range. Anyone may
; recompute it, so the row carries the range and the ranges abut (gld_epoch_ok).
pub const GLD_LEDGER_EPOCH : u8 = 2;
; #8605: per-spec usage counts over a window of receipts, counted only from receipts the k-of-n
; rule admitted (gld_usage_ok); the window's numbers are the transparency log's.
pub const GLD_USAGE_WINDOW : u8 = 3;
; #8606: the signer registry's state, n keys and quorum k, with the registry's root. It changes
; only by merged PR, and the row records n and k so no reader need trust the writer.
pub const GLD_SIGNER_SET : u8 = 4;
; #8606: a receipt admitted under k-of-n. A row exists only when the count passes
; (gld_receipt_admits); the transparency log's sequence numbers are gapless like section 1's.
pub const GLD_RECEIPT_SEALED : u8 = 5;
; trinity#1587: the daily scan finished. A prompt to go read the atlas, not the atlas itself.
pub const GLD_ATLAS_SCAN : u8 = 6;
; trinity#1587: a webhook asked for a live refresh; thinned to one a minute, like evidence.
pub const GLD_ATLAS_WEBHOOK : u8 = 7;
; trinity#1587: a generation of the atlas went live, with its root. Today the publish step is a
; human one; the row is the same the day that step is automated away.
pub const GLD_ATLAS_PUBLISHED : u8 = 8;
; The white paper's gates: a gate opened. The red lines live in gld_gates_open and
; gld_value_flow_open below.
pub const GLD_GATES : u8 = 9;
pub const GLD_KINDS : u8 = 10;
pub const GLD_EVENT_NAMES : [10]str = ["gld.anchor.block", "gld.anchor.extern", "gld.ledger.epoch", "gld.usage.window", "gld.signer.set", "gld.receipt.sealed", "gld.atlas.scan", "gld.atlas.webhook", "gld.atlas.published", "gld.gates"];

; A webhook row is thinned to one a minute per subject, like evidence (section 4); every other
; kind is rare and each row is a fact, so all are kept. The scan's daily cadence is the scanner's
; business, not the bus's.
pub const GLD_LOG_EVERY_SECONDS : [10]u32 = [0, 0, 0, 0, 0, 0, 0, 60, 0, 0];
; What a watcher of the stream does with a row. STATE: the row IS the datum, store it - a root, a
; range, a quorum, a gate. FETCH: the row is a prompt to go read the named thing, the atlas after
; a scan or a webhook. IGNORE: a kind with no row, until a merged PR adds one.
pub const GLD_ACT_IGNORE : u8 = 0;
pub const GLD_ACT_FETCH : u8 = 1;
pub const GLD_ACT_STATE : u8 = 2;
pub const GLD_ACTION : [10]u8 = [2, 2, 2, 2, 2, 2, 1, 1, 2, 2];
; A row's payload keys come only from this list, and a value is a token (token_ok) or a plain
; number; anything else is refused before the row is written. The chain stream is public whole -
; every kind on it is a public fact, which is the point of accounting - but a person's name is
; not a key even here: authors are tokens. root names a manifest, ledger, counts, registry or
; atlas hash, or the sealed receipt's hash; spec a spec token; epoch the ledger epoch number;
; from and to a commit or receipt range; count a per-spec count; n and k the registry size and
; quorum; gate which gate; anchor the external anchor's own id; receipt a receipt's id token.
pub const GLD_PUBLIC_KEYS : [11]str = ["root", "spec", "epoch", "from", "to", "count", "n", "k", "gate", "anchor", "receipt"];

; A kind this card does not define is refused before it is written: a new kind arrives as a merged
; PR that adds its row here, never as a raw write. Every rule below rides this check.
pub fn gld_kind_ok(kind: u8) -> bool {
    return kind < GLD_KINDS;
}

pub fn gld_log_due(kind: u8, seen_before: bool, seconds_since: u32) -> bool {
    if (kind >= GLD_KINDS) { return false; }
    var every : u32 = GLD_LOG_EVERY_SECONDS[kind];
    if (every == 0) { return true; }
    return (seen_before == false) or (seconds_since >= every);
}

pub fn gld_action(kind: u8) -> u8 {
    if (kind >= GLD_KINDS) { return GLD_ACT_IGNORE; }
    return GLD_ACTION[kind];
}

; The rules that do not bend. No chief validators (S1): a receipt is admitted by k of n registry
; keys, counted over signatures those keys verify, and the row records n and k so any reader can
; re-count without trusting the writer. One signer would make the t27b lab a de facto chief
; validator, so the floor is two.
pub const GLD_K_MIN : u32 = 2;
; The registry's state in the tree: one signer, the lab's key a05db80f53c317f6. This is the
; deficit #8606 exists to end, recorded honestly; until it ends the rule admits nothing, and
; this stream carries no receipt rows.
pub const GLD_N_NOW : u32 = 1;
pub const GLD_K_NOW : u32 = 1;

pub fn gld_registry_ok(n: u32, k: u32) -> bool {
    return (k >= GLD_K_MIN) and (k <= n);
}

pub fn gld_receipt_admits(sigs: u32, n: u32, k: u32) -> bool {
    return gld_registry_ok(n, k) and (sigs >= k);
}

; RT-4: the manifest is not circular. An anchor block counts as anchored only when an external
; anchor - outside t27, outside this bus - names the same root.
pub fn gld_anchored(block_sealed: bool, extern_names_block: bool) -> bool {
    return block_sealed and extern_names_block;
}

; #8604: an epoch row carries the commit range [from, to] it was computed over, and ranges abut:
; no gap (a commit nobody counted), no overlap (a commit counted twice), never empty. The first
; epoch (prev_to 0) claims history's beginning.
pub fn gld_epoch_ok(prev_to: u64, from: u64, to: u64) -> bool {
    if (prev_to != 0 and from != prev_to) { return false; }
    return to > from;
}

; #8605: a usage window runs over the transparency log's sequence numbers (#8606), gapless by the
; same philosophy as section 1, and counts only receipts the k-of-n rule admitted. Windows abut
; as epochs do: the same receipt can never be counted twice.
pub fn gld_usage_ok(receipts_sealed: bool, prev_to: u64, from: u64, to: u64) -> bool {
    return receipts_sealed and gld_epoch_ok(prev_to, from, to);
}

; trinity#1587: webhooks push and the daily scan is the baseline; either keeps the atlas fresh,
; neither does not. Past GLD_ATLAS_STALE_SECONDS the board shows the atlas as stale - it never
; shows old as live. Two days: one missed scan is tolerated, two is stale.
pub const GLD_ATLAS_STALE_SECONDS : u32 = 172800;

pub fn gld_atlas_fresh(seconds_since: u32) -> bool {
    return seconds_since < GLD_ATLAS_STALE_SECONDS;
}

; The gates, in the white paper's order: explorer-verified contracts, a fixed key registry,
; written legal opinions. All three, or nothing moves: accounting first, money last. No kind on
; this stream moves value - there is no payout, transfer or allocation row, and none may be added
; while a gate is closed. #8607's payout research is research: it writes no events here. A gates
; row says a gate OPENED and names the record that opened it (an explorer link, a counsel
; letter's id, as tokens); it never says value moved.
pub const GLD_GATE_CONTRACTS : u8 = 0;
pub const GLD_GATE_REGISTRY : u8 = 1;
pub const GLD_GATE_LEGAL : u8 = 2;
pub const GLD_GATE_COUNT : u8 = 3;
; The gate state in the tree: all closed. A gate opens by merged PR that flips its bit here and
; lands the record behind it. When a PR opens the third gate it must rewrite the invariant below
; on purpose - flipping the last red line is the one act this card will not let happen by
; accident.
pub const GLD_GATES_NOW : [3]u8 = [0, 0, 0];

pub fn gld_gates_open(gates: []const u8) -> bool {
    var i : u8 = 0;
    while (i < GLD_GATE_COUNT) {
        if (gates[i] == 0) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn gld_value_flow_open(gates: []const u8) -> bool {
    return gld_gates_open(gates);
}

test a_gold_row_is_due_or_thinned {
    assert gld_log_due(GLD_LEDGER_EPOCH, true, 0) == true;
    assert gld_log_due(GLD_GATES, false, 0) == true;
    assert gld_log_due(GLD_ATLAS_WEBHOOK, false, 0) == true;
    assert gld_log_due(GLD_ATLAS_WEBHOOK, true, 59) == false;
    assert gld_log_due(GLD_ATLAS_WEBHOOK, true, 60) == true;
    assert gld_log_due(GLD_KINDS, false, 0) == false;
    assert gld_kind_ok(GLD_GATES) == true and gld_kind_ok(GLD_KINDS) == false;
}

test a_watcher_stores_the_datum_or_goes_to_look {
    assert gld_action(GLD_LEDGER_EPOCH) == GLD_ACT_STATE;
    assert gld_action(GLD_ATLAS_PUBLISHED) == GLD_ACT_STATE;
    assert gld_action(GLD_ATLAS_SCAN) == GLD_ACT_FETCH;
    assert gld_action(GLD_ATLAS_WEBHOOK) == GLD_ACT_FETCH;
    assert gld_action(GLD_KINDS) == GLD_ACT_IGNORE;
}

test the_quorum_is_k_of_n_and_never_one {
    assert gld_registry_ok(2, 2) == true;
    assert gld_registry_ok(5, 3) == true;
    assert gld_registry_ok(5, 1) == false;
    assert gld_registry_ok(1, 2) == false;
    assert gld_registry_ok(5, 6) == false;
    assert gld_receipt_admits(3, 5, 3) == true;
    assert gld_receipt_admits(2, 5, 3) == false;
    assert gld_receipt_admits(1, 1, 1) == false;
    assert gld_registry_ok(GLD_N_NOW, GLD_K_NOW) == false;
    assert gld_receipt_admits(GLD_K_NOW, GLD_N_NOW, GLD_K_NOW) == false;
}

test an_anchor_needs_a_name_from_outside {
    assert gld_anchored(true, true) == true;
    assert gld_anchored(false, true) == false;
    assert gld_anchored(true, false) == false;
}

test an_epoch_or_window_abuts_and_is_never_empty {
    assert gld_epoch_ok(0, 0, 10) == true;
    assert gld_epoch_ok(0, 41890, 41900) == true;
    assert gld_epoch_ok(10, 10, 11) == true;
    assert gld_epoch_ok(10, 11, 20) == false;
    assert gld_epoch_ok(10, 9, 20) == false;
    assert gld_epoch_ok(10, 10, 10) == false;
    assert gld_usage_ok(true, 10, 10, 20) == true;
    assert gld_usage_ok(false, 10, 10, 20) == false;
    assert gld_usage_ok(true, 10, 11, 20) == false;
}

test the_atlas_says_stale_rather_than_showing_old_as_live {
    assert gld_atlas_fresh(0) == true;
    assert gld_atlas_fresh(GLD_ATLAS_STALE_SECONDS - 1) == true;
    assert gld_atlas_fresh(GLD_ATLAS_STALE_SECONDS) == false;
}

test the_gates_refuse_until_all_three_open {
    var none : [3]u8 = [0, 0, 0];
    var one : [3]u8 = [1, 0, 0];
    var two : [3]u8 = [1, 1, 0];
    var all : [3]u8 = [1, 1, 1];
    assert gld_gates_open(&none) == false;
    assert gld_gates_open(&one) == false;
    assert gld_gates_open(&two) == false;
    assert gld_gates_open(&all) == true;
    assert gld_value_flow_open(&two) == false;
    assert gld_value_flow_open(&all) == true;
}

invariant the_gold_kinds_are_numbered_in_order {
    assert GLD_ANCHOR_BLOCK == 0 and GLD_ANCHOR_EXTERN == 1 and GLD_LEDGER_EPOCH == 2;
    assert GLD_USAGE_WINDOW == 3 and GLD_SIGNER_SET == 4 and GLD_RECEIPT_SEALED == 5;
    assert GLD_ATLAS_SCAN == 6 and GLD_ATLAS_WEBHOOK == 7 and GLD_ATLAS_PUBLISHED == 8;
    assert GLD_GATES == GLD_KINDS - 1 and GLD_KINDS == 10;
}

invariant no_value_moves_from_this_tree {
    assert GLD_GATES_NOW[0] == 0 and GLD_GATES_NOW[1] == 0 and GLD_GATES_NOW[2] == 0;
}
