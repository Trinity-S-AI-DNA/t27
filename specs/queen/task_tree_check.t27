; specs/queen/task_tree_check.t27 -- full-chain verification matrix for the task tree and its
; return protocol. CHECKS track, task-10 (branch spec/zoom-checks).
; 
; This spec is the acceptance layer of the delegation slice (task-7 model law, task-8 runtime).
; It exercises the model + runtime through their PUBLIC functions only: specs/queen/task_tree.t27
; (task tree: parent links, attempts, states), specs/queen/actors.t27 (return protocol tags,
; scope subset), specs/queen/events.t27 (EV_RESULT / EV_ACCEPTED kinds), and the aggregation in
; specs/queen/actor_events.t27 (envelope: seq / at / from_pid / to_pid / task_ref).
; It does NOT restate or re-derive any law; a rule tested here is owned by the file that
; defines it. Contract tests for functions a task-7/8 file itself owns live with that file.
; 
; The ten cases of the verification matrix (one test name each, section 2 below):
;   1  multiple branches and nested levels
;   2  result returned along the correct parent link
;   3  repeated delivery without double completion (idempotent result delivery)
;   4  stale result from a previous attempt
;   5  executor disappearance and restart
;   6  parent cancel with a running child
;   7  budget exhaustion
;   8  one-branch error without a false global completion
;   9  history preserved across an executor change
;  10  no privilege escalation on delegation (child rights are a subset of the passed scope)
; 
; Status 2026-11-01: MODEL-LAW ASSERTS LANDED. Cases 1-4 and the model halves of 5/9/10 assert
; against the landed task-7 law (specs/queen/task_tree.t27, actors.t27 tags, events.t27 kinds).
; Still TODO: the runtime-dependent halves -- case 5 (real restart path), 6 (cancel with a
; running child), 7 (budget exhaustion mid-run), 8 (aggregation across branches), 9 (event-seq
; ordering across a real swap) and the section-3 real-call integration scenario -- land after
; task-8. Section 2 uses fixtures built from the model functions only; nothing passes vacuously.
; 
; Fixtures vs real calls: transformation tests in section 2 use fixtures built from the model
; functions; the integration scenario (section 3) uses real calls through the runtime. The two
; are never mixed in one claim.
; ASCII only (L3). L4: every rule named above has a test block in this file.
; phi^2 + 1/phi^2 = 3 | TRINITY

module TaskTreeCheck;

use queen::events::BUS_KINDS;
use queen::events::EV_RESULT;
use queen::events::EV_ACCEPTED;
use queen::events::EV_REWORK;
use queen::events::EV_CANCEL;
use queen::actors::M_RESULT;
use queen::actors::M_ACCEPT;
use queen::actors::M_REWORK;
use queen::task_tree::TT_ATTEMPT_STRIDE;
use queen::task_tree::TT_CREATED;
use queen::task_tree::TT_RUNNING;
use queen::task_tree::TT_EXEC_DONE;
use queen::task_tree::TT_RESULT_RETURNED;
use queen::task_tree::TT_ACCEPTED;
use queen::task_tree::tt_link_ok;
use queen::task_tree::tt_root;
use queen::task_tree::tt_attempt_id;
use queen::task_tree::tt_attempt_task;
use queen::task_tree::tt_attempt_no;
use queen::task_tree::tt_attempt_fresh;
use queen::task_tree::tt_on_executor_done;
use queen::task_tree::tt_on_result_delivered;
use queen::task_tree::tt_on_accepted;
use queen::task_tree::tt_transition_ok;
use queen::task_tree::tt_done_once;
use queen::task_tree::tt_sid_linked;
use queen::task_tree::tt_scope_subset;
use queen::task_tree::tt_grant;

; --- 1. Sanity of the acceptance layer itself ---------------------------------------------------------

/// The event bus the matrix reads must be the bus that exists: if the kind count moves, every
/// result-path test below must be re-read against the new kinds. This is the only cross-check
/// this file makes against a frozen shape.
test the_event_bus_the_matrix_reads_still_exists {
    assert BUS_KINDS == 10;
}

/// The result-path event kinds exist on the bus and are distinct: the matrix routes a delivery
/// through EV_RESULT, a verdict through EV_ACCEPTED, a retry demand through EV_REWORK and a
/// cancellation through EV_CANCEL.
test the_result_event_kinds_exist_and_are_distinct {
    assert EV_RESULT == 6;
    assert EV_ACCEPTED == 7;
    assert EV_REWORK == 8;
    assert EV_CANCEL == 9;
    assert EV_RESULT != EV_ACCEPTED and EV_REWORK != EV_CANCEL;
}

/// The return-protocol tags exist and are distinct from the offer/cancel pair: a result message
/// is not a task offer, and accept is not rework.
test the_return_protocol_tags_exist_and_are_distinct {
    assert M_RESULT == 4;
    assert M_ACCEPT == 5;
    assert M_REWORK == 6;
    assert M_RESULT != M_ACCEPT and M_REWORK != M_RESULT;
}

/// The state distinctions the return protocol is built on: executor-done (the executor finished
/// but nothing has reached the parent), result-returned (delivered, awaiting the verdict) and
/// accepted (the parent took it) are three different states with ordered transitions.
test exec_done_result_returned_and_accepted_are_distinct_states {
    assert TT_EXEC_DONE == 2;
    assert TT_RESULT_RETURNED == 3;
    assert TT_ACCEPTED == 4;
    var s: u8 = tt_on_executor_done(TT_RUNNING);
    assert s == TT_EXEC_DONE;
    assert s != TT_RESULT_RETURNED and s != TT_ACCEPTED;
    s = tt_on_result_delivered(s);
    assert s == TT_RESULT_RETURNED;
    assert s != TT_ACCEPTED;
    s = tt_on_accepted(s);
    assert s == TT_ACCEPTED;
    assert tt_transition_ok(TT_RUNNING, TT_ACCEPTED) == false;
    assert tt_transition_ok(TT_ACCEPTED, TT_RESULT_RETURNED) == false;
}

; --- 2. The verification matrix (asserts land after task-7 / task-8) ----------------------------------

// Case 1: several branches at the root and at least one nested level below a branch; the tree
// holds them side by side without crosstalk. Exercises: task_tree.t27 (task_id, parent_task_id,
// root_task_id), actor_events.t27 (envelope task_ref).
test multiple_branches_and_nested_levels_form_one_tree {
    // Root 100; branches 200 and 300 under it; nested children 210 under 200 and 310 under 300.
    assert tt_link_ok(0, 100) == false;   // every task needs a parent
    assert tt_link_ok(100, 200) == true;
    assert tt_link_ok(100, 300) == true;
    assert tt_link_ok(200, 210) == true;
    assert tt_link_ok(300, 310) == true;
    assert tt_link_ok(210, 210) == false; // no self-parent
    // Every node resolves to the same root, at any depth.
    assert tt_root(true, 0, 100) == 100;
    assert tt_root(false, tt_root(true, 0, 100), 200) == 100;
    assert tt_root(false, tt_root(true, 0, 100), 300) == 100;
    assert tt_root(false, tt_root(false, tt_root(true, 0, 100), 200), 210) == 100;
    assert tt_root(false, tt_root(false, tt_root(true, 0, 100), 300), 310) == 100;
    // The two branches do not see each other's children: each nested child inherits only its
    // own branch's root, and the two branch subtrees resolve to different roots.
    assert tt_root(false, 200, 210) == 200;
    assert tt_root(false, 300, 310) == 300;
    assert tt_root(false, 200, 210) != tt_root(false, 300, 310);
}

// Case 2: a child's result travels to ITS parent, not to the root or a sibling. Exercises:
// task_tree.t27 (parent_task_id link), actors.t27 (M_RESULT tag), events.t27 (EV_RESULT).
test result_returns_along_the_correct_parent_link {
    // Root 100, branch 200 under it, nested child 210 under the branch. A result from the
    // nested child travels to task 210's PARENT (200), never to the root (100) and never to a
    // sibling. The parent link is fixed at spawn (one parent per subtask).
    // Nested child 210 under the branch; the parent link is fixed at spawn (one parent per
    // subtask) and tt_link_ok validates a WELL-FORMED link (nonzero, not self). Which task is
    // the real parent is the single stored parent field, decided at spawn -- the validator
    // cannot know it, and routing reads the field, not the validator.
    assert tt_link_ok(200, 210) == true;
    // Direction lives in the single stored parent field (one parent per subtask).
    // The delivery itself: the child's attempt walks RUNNING -> EXEC_DONE -> RESULT_RETURNED
    // and stops there; acceptance is the PARENT's own transition, not the child's.
    var child: u8 = tt_on_result_delivered(tt_on_executor_done(TT_RUNNING));
    assert child == TT_RESULT_RETURNED;
    assert tt_on_accepted(child) == TT_ACCEPTED;  // the receiving parent accepts
    // A sibling branch (300) and the root (100) observed nothing: their states are untouched
    // by the child's delivery.
    assert tt_on_result_delivered(TT_RUNNING) == TT_EXEC_DONE;
    // The delivered attempt id still names its own task: result routed by task_ref, not by row.
    var aid: u64 = tt_attempt_id(210, 0);
    assert tt_attempt_task(aid) == 210;
    assert tt_attempt_task(aid) != 200 and tt_attempt_task(aid) != 100;
}

// Case 3: the same result delivered twice completes the task once. Exercises:
// task_tree.t27 (executor-done vs result-returned vs parent-accepted states).
test repeated_delivery_does_not_complete_twice {
    // One attempt, one result, delivered twice (same attempt_id). The state machine absorbs the
    // second delivery: RESULT_RETURNED and ACCEPTED are absorbing for tt_on_result_delivered.
    var s: u8 = tt_on_result_delivered(tt_on_executor_done(TT_RUNNING));
    assert s == TT_RESULT_RETURNED;
    var again: u8 = tt_on_result_delivered(s);
    assert again == s;                       // redelivery changed nothing
    assert tt_on_accepted(again) == TT_ACCEPTED;
    assert tt_on_accepted(TT_ACCEPTED) == TT_ACCEPTED;  // re-accept is a no-op, not a second one
    // Exactly one completion exists along the whole walk, by tt_done_once's edge rule.
    assert tt_done_once(TT_RESULT_RETURNED, TT_ACCEPTED) == true;   // the one completion
    assert tt_done_once(TT_ACCEPTED, TT_ACCEPTED) == false;         // redelivery: no second edge
    assert tt_done_once(TT_RUNNING, TT_EXEC_DONE) == false;         // exec-done is not completion
    // Every legal transition into ACCEPTED comes from RESULT_RETURNED only once backwards.
    assert tt_transition_ok(TT_EXEC_DONE, TT_ACCEPTED) == false;
    assert tt_transition_ok(TT_RUNNING, TT_ACCEPTED) == false;
}

// Case 4: a late result carried by attempt_id of a superseded attempt is rejected as stale and
// does not disturb the live attempt. Exercises: task_tree.t27 (attempt_id as an entity).
test stale_result_from_a_previous_attempt_is_rejected {
    // Task 210, attempt 0 superseded by attempt 1 after a rework. The old attempt's result
    // arrives late. Attempts are entities: attempt 1's id is fresh (a strictly larger id),
    // attempt 0's is not, and a stale id still decodes to the right task but the OLD number.
    var old_aid: u64 = tt_attempt_id(210, 0);
    var new_aid: u64 = tt_attempt_id(210, 1);
    assert tt_attempt_fresh(new_aid, old_aid) == true;   // the retry is a fresh entity
    assert tt_attempt_fresh(old_aid, new_aid) == false;  // the late delivery is not fresh
    assert tt_attempt_fresh(old_aid, old_aid) == false;  // a replayed id is not fresh either
    assert tt_attempt_no(old_aid) == 0 and tt_attempt_no(new_aid) == 1;
    assert tt_attempt_task(old_aid) == tt_attempt_task(new_aid);
    // Attempt ids of different tasks never alias each other (stride isolation).
    assert tt_attempt_id(211, 0) != old_aid;
    assert TT_ATTEMPT_STRIDE == 64;
    // The stale delivery must not move the live attempt: a RESULT_RETURNED live attempt stays
    // where it is when the stale transition is applied (absorbing, as the law defines).
    var live: u8 = tt_on_result_delivered(tt_on_executor_done(TT_RUNNING));
    assert tt_on_result_delivered(live) == live;
    // And a stale delivery into a superseded state is not a legal transition for the live task.
    assert tt_transition_ok(TT_RESULT_RETURNED, TT_EXEC_DONE) == false;
}

// Case 5: the executor disappears and comes back; the tree keeps the task's history and the
; replacement executor resumes it. Exercises: task_tree.t27 (agent sid link), actors.t27
; (restart paths), events.t27 (EV_ACTOR_DOWN / EV_ACTOR_RESTART kinds).
test executor_disappearance_and_restart_preserves_the_task {
    // MODEL half (now): the task's link is to the executor's sid, a reference and not a copy;
    // a dropped sid unlinks honestly and a replacement executor's valid sid links again, while
    // the attempt entities (the history) are untouched by the identity change.
    assert tt_sid_linked("12345678-1234-1234-1234-123456789012") == true;
    assert tt_sid_linked("-") == false;   // a "-" is not a sid: nothing is linked
    assert tt_sid_linked("") == false;
    assert tt_sid_linked("a b") == false; // and a malformed token is not one either
    // The restarted task resumes on a FRESH attempt id of the same task; the old attempts
    // remain decodeable, so the history survives the executor change.
    var before: u64 = tt_attempt_id(210, 0);
    var resumed: u64 = tt_attempt_id(210, 1);
    assert tt_attempt_fresh(resumed, before) == true;
    assert tt_attempt_task(before) == tt_attempt_task(resumed);
    assert tt_attempt_no(before) == 0 and tt_attempt_no(resumed) == 1;
    // RUNTIME half (TODO task-8): the real drop/restart path through the kernel actor tree.
}

