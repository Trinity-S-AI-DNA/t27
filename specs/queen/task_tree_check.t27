; --- 1. Sanity of the acceptance layer itself ---------------------------------------------------------

/// The event bus the matrix reads must be the bus that exists: if the kind count moves, every
/// result-path test below must be re-read against the new kinds. This is the only cross-check
/// this file makes against a frozen shape.
test the_event_bus_the_matrix_reads_still_exists {
    assert BUS_KINDS == 10;
}

/// The result-path event kinds exist on the bus and are distinct: the matrix routes a delivery
/// through EV_RESULT, a verdict through EV_ACCEPTED, a retry demand through EV_REWORK and a
/// cancellation through EV_CANCEL.
test the_result_event_kinds_exist_and_are_distinct {
    assert EV_RESULT == 6;
    assert EV_ACCEPTED == 7;
    assert EV_REWORK == 8;
    assert EV_CANCEL == 9;
    assert EV_RESULT != EV_ACCEPTED and EV_REWORK != EV_CANCEL;
}

/// The return-protocol tags exist and are distinct from the offer/cancel pair: a result message
/// is not a task offer, and accept is not rework.
test the_return_protocol_tags_exist_and_are_distinct {
    assert M_RESULT == 4;
    assert M_ACCEPT == 5;
    assert M_REWORK == 6;
    assert M_RESULT != M_ACCEPT and M_REWORK != M_RESULT;
}

/// The state distinctions the return protocol is built on: executor-done (the executor finished
/// but nothing has reached the parent), result-returned (delivered, awaiting the verdict) and
/// accepted (the parent took it) are three different states with ordered transitions.
test exec_done_result_returned_and_accepted_are_distinct_states {
    assert TT_EXEC_DONE == 2;
    assert TT_RESULT_RETURNED == 3;
    assert TT_ACCEPTED == 4;
    var s: u8 = tt_on_executor_done(TT_RUNNING);
    assert s == TT_EXEC_DONE;
    assert s != TT_RESULT_RETURNED and s != TT_ACCEPTED;
    s = tt_on_result_delivered(s);
    assert s == TT_RESULT_RETURNED;
    assert s != TT_ACCEPTED;
    s = tt_on_accepted(s);
    assert s == TT_ACCEPTED;
    assert tt_transition_ok(TT_RUNNING, TT_ACCEPTED) == false;
    assert tt_transition_ok(TT_ACCEPTED, TT_RESULT_RETURNED) == false;
}

; --- 2. The verification matrix (asserts land after task-7 / task-8) ----------------------------------

// Case 1: several branches at the root and at least one nested level below a branch; the tree
// holds them side by side without crosstalk. Exercises: task_tree.t27 (task_id, parent_task_id,
// root_task_id), actor_events.t27 (envelope task_ref).
test multiple_branches_and_nested_levels_form_one_tree {
    // Root 100; branches 200 and 300 under it; nested children 210 under 200 and 310 under 300.
    assert tt_link_ok(0, 100) == false;   // every task needs a parent
    assert tt_link_ok(100, 200) == true;
    assert tt_link_ok(100, 300) == true;
    assert tt_link_ok(200, 210) == true;
    assert tt_link_ok(300, 310) == true;
    assert tt_link_ok(210, 210) == false; // no self-parent
    // Every node resolves to the same root, at any depth.
    assert tt_root(true, 0, 100) == 100;
    assert tt_root(false, tt_root(true, 0, 100), 200) == 100;
    assert tt_root(false, tt_root(true, 0, 100), 300) == 100;
    assert tt_root(false, tt_root(false, tt_root(true, 0, 100), 200), 210) == 100;
    assert tt_root(false, tt_root(false, tt_root(true, 0, 100), 300), 310) == 100;
    // The two branches do not see each other's children: each nested child inherits only its
    // own branch's root, and the two branch subtrees resolve to different roots.
    assert tt_root(false, 200, 210) == 200;
    assert tt_root(false, 300, 310) == 300;
    assert tt_root(false, 200, 210) != tt_root(false, 300, 310);
}

// Case 2: a child's result travels to ITS parent, not to the root or a sibling. Exercises:
// task_tree.t27 (parent_task_id link), actors.t27 (M_RESULT tag), events.t27 (EV_RESULT).
test result_returns_along_the_correct_parent_link {
    // Root 100, branch 200 under it, nested child 210 under the branch. A result from the
    // nested child travels to task 210's PARENT (200), never to the root (100) and never to a
    // sibling. The parent link is fixed at spawn (one parent per subtask).
    // Nested child 210 under the branch; the parent link is fixed at spawn (one parent per
    // subtask) and tt_link_ok validates a WELL-FORMED link (nonzero, not self). Which task is
    // the real parent is the single stored parent field, decided at spawn -- the validator
    // cannot know it, and routing reads the field, not the validator.
    assert tt_link_ok(200, 210) == true;
    // Direction lives in the single stored parent field (one parent per subtask).
    // The delivery itself: the child's attempt walks RUNNING -> EXEC_DONE -> RESULT_RETURNED
    // and stops there; acceptance is the PARENT's own transition, not the child's.
    var child: u8 = tt_on_result_delivered(tt_on_executor_done(TT_RUNNING));
    assert child == TT_RESULT_RETURNED;
    assert tt_on_accepted(child) == TT_ACCEPTED;  // the receiving parent accepts
    // A sibling branch (300) and the root (100) observed nothing: their states are untouched
    // by the child's delivery.
    assert tt_on_result_delivered(TT_RUNNING) == TT_EXEC_DONE;
    // The delivered attempt id still names its own task: result routed by task_ref, not by row.
    var aid: u64 = tt_attempt_id(210, 0);
    assert tt_attempt_task(aid) == 210;
    assert tt_attempt_task(aid) != 200 and tt_attempt_task(aid) != 100;
}

// Case 3: the same result delivered twice completes the task once. Exercises:
// task_tree.t27 (executor-done vs result-returned vs parent-accepted states).
test repeated_delivery_does_not_complete_twice {
    // One attempt, one result, delivered twice (same attempt_id). The state machine absorbs the
    // second delivery: RESULT_RETURNED and ACCEPTED are absorbing for tt_on_result_delivered.
    var s: u8 = tt_on_result_delivered(tt_on_executor_done(TT_RUNNING));
    assert s == TT_RESULT_RETURNED;
    var again: u8 = tt_on_result_delivered(s);
    assert again == s;                       // redelivery changed nothing
    assert tt_on_accepted(again) == TT_ACCEPTED;
    assert tt_on_accepted(TT_ACCEPTED) == TT_ACCEPTED;  // re-accept is a no-op, not a second one
    // Exactly one completion exists along the whole walk, by tt_done_once's edge rule.
    assert tt_done_once(TT_RESULT_RETURNED, TT_ACCEPTED) == true;   // the one completion
    assert tt_done_once(TT_ACCEPTED, TT_ACCEPTED) == false;         // redelivery: no second edge
    assert tt_done_once(TT_RUNNING, TT_EXEC_DONE) == false;         // exec-done is not completion
    // Every legal transition into ACCEPTED comes from RESULT_RETURNED only once backwards.
    assert tt_transition_ok(TT_EXEC_DONE, TT_ACCEPTED) == false;
    assert tt_transition_ok(TT_RUNNING, TT_ACCEPTED) == false;
    // ENGINE half (contract mode): exactly EXEC_DONE may deliver; the engine refuses
    // everything before delegating, so a redelivery never re-counts.
    assert dr_deliver_ok(TT_EXEC_DONE) == true;
    assert dr_deliver_ok(TT_RUNNING) == false;
    assert dr_deliver_ok(TT_RESULT_RETURNED) == false;
    assert dr_deliver_ok(TT_ACCEPTED) == false;
    // A duplicate arriving at RESULT_RETURNED or later is refused outright.
    assert dr_redelivery_refused(TT_RESULT_RETURNED) == true;
    assert dr_redelivery_refused(TT_ACCEPTED) == true;
    assert dr_redelivery_refused(TT_EXEC_DONE) == false;  // not yet owned: deliverable
    // The delivered pair is the law's own constants: M_RESULT on the message, EV_RESULT in the log.
    assert dr_result_tag() == M_RESULT;
    assert dr_result_event() == EV_RESULT;
}

// Case 4: a late result carried by attempt_id of a superseded attempt is rejected as stale and
// does not disturb the live attempt. Exercises: task_tree.t27 (attempt_id as an entity).
test stale_result_from_a_previous_attempt_is_rejected {
    // Task 210, attempt 0 superseded by attempt 1 after a rework. The old attempt's result
    // arrives late. Attempts are entities: attempt 1's id is fresh (a strictly larger id),
    // attempt 0's is not, and a stale id still decodes to the right task but the OLD number.
    var old_aid: u64 = tt_attempt_id(210, 0);
    var new_aid: u64 = tt_attempt_id(210, 1);
    assert tt_attempt_fresh(new_aid, old_aid) == true;   // the retry is a fresh entity
    assert tt_attempt_fresh(old_aid, new_aid) == false;  // the late delivery is not fresh
    assert tt_attempt_fresh(old_aid, old_aid) == false;  // a replayed id is not fresh either
    assert tt_attempt_no(old_aid) == 0 and tt_attempt_no(new_aid) == 1;
    assert tt_attempt_task(old_aid) == tt_attempt_task(new_aid);
    // Attempt ids of different tasks never alias each other (stride isolation).
    assert tt_attempt_id(211, 0) != old_aid;
    assert TT_ATTEMPT_STRIDE == 64;
    // The stale delivery must not move the live attempt: a RESULT_RETURNED live attempt stays
    // where it is when the stale transition is applied (absorbing, as the law defines).
    var live: u8 = tt_on_result_delivered(tt_on_executor_done(TT_RUNNING));
    assert tt_on_result_delivered(live) == live;
    // And a stale delivery into a superseded state is not a legal transition for the live task.
    assert tt_transition_ok(TT_RESULT_RETURNED, TT_EXEC_DONE) == false;
}

// Case 5: the executor disappears and comes back; the tree keeps the task's history and the
; replacement executor resumes it. Exercises: task_tree.t27 (agent sid link), actors.t27
; (restart paths), events.t27 (EV_ACTOR_DOWN / EV_ACTOR_RESTART kinds).
test executor_disappearance_and_restart_preserves_the_task {
    // MODEL half (now): the task's link is to the executor's sid, a reference and not a copy;
    // a dropped sid unlinks honestly and a replacement executor's valid sid links again, while
    // the attempt entities (the history) are untouched by the identity change.
    assert tt_sid_linked("12345678-1234-1234-1234-123456789012") == true;
    assert tt_sid_linked("-") == false;   // a "-" is not a sid: nothing is linked
    assert tt_sid_linked("") == false;
    assert tt_sid_linked("a b") == false; // and a malformed token is not one either
    // The restarted task resumes on a FRESH attempt id of the same task; the old attempts
    // remain decodeable, so the history survives the executor change.
    var before: u64 = tt_attempt_id(210, 0);
    var resumed: u64 = tt_attempt_id(210, 1);
    assert tt_attempt_fresh(resumed, before) == true;
    assert tt_attempt_task(before) == tt_attempt_task(resumed);
    assert tt_attempt_no(before) == 0 and tt_attempt_no(resumed) == 1;
    // RUNTIME half (TODO task-8): the real drop/restart path through the kernel actor tree.
}

// Case 6: cancelling a parent whose child is still running cancels the child too, exactly once.
// Exercises: delegate_runtime.t27 (dr_cancel_ok engine guard), task_tree.t27 (cancel transition),
// events.t27 (EV_CANCEL). CONTRACT MODE: engine functions with fixture states; the executable
// host call is held for the owner, so this stays fixtures-only.
test parent_cancel_reaches_the_running_child {
    // The engine admits cancel from CREATED and RUNNING (the child is reachable), refuses it
    // on ACCEPTED and CANCELED (idempotent: a second cancel changes nothing).
    assert dr_cancel_ok(TT_CREATED) == true;
    assert dr_cancel_ok(TT_RUNNING) == true;
    assert dr_cancel_ok(TT_ACCEPTED) == false;
    assert dr_cancel_ok(TT_CANCELED) == false;
    // An admitted cancel moves the attempt to CANCELED and is a legal transition.
    var next : u8 = tt_on_cancel(TT_RUNNING);
    assert next == TT_CANCELED;
    assert tt_transition_ok(TT_RUNNING, next) == true;
    // The second cancel is refused by the engine: exactly one cancellation exists.
    assert dr_cancel_ok(next) == false;
    assert tt_transition_ok(TT_CANCELED, TT_CANCELED) == true;  // self-loop, no second edge
    // The cancellation travels as EV_CANCEL (the engine pairs it, never restates it).
    assert dr_cancel_event() == EV_CANCEL;
}

// Case 7: a delegation that spends past its granted budget is stopped and reports exhaustion;
// it must not fail the parent by surprise beyond the granted scope. Exercises:
// delegate_runtime.t27 (dr_admit, DR_ADMIT_BUDGET, DR_ADMIT_FULL), task_tree.t27 (scope).
// CONTRACT MODE: the admission guard with fixture numbers; the real mid-run meter is task-8's.
test budget_exhaustion_stops_the_delegation_cleanly {
    // Within budget and scope: the delegation is admitted.
    assert dr_admit(0b0100, 0b1101, 0, 1024) == DR_ADMIT_OK;
    // Past the budget ceiling: the explicit DR_ADMIT_BUDGET verdict, not a silent zero.
    assert dr_admit(0b0100, 0b1101, 0, DR_BUDGET_WORDS + 1) == DR_ADMIT_BUDGET;
    assert dr_admit(0b0100, 0b1101, 0, DR_BUDGET_WORDS) == DR_ADMIT_OK;  // the wall itself admits
    // The other refusals stay distinct: scope escalation and the children cap.
    assert dr_admit(0b0010, 0b1101, 0, 1024) == DR_ADMIT_SCOPE;
    assert dr_admit(0b0100, 0b1101, DR_MAX_CHILDREN, 1024) == DR_ADMIT_FULL;
    // Exhaustion is visible, not silent: no admitted delegation hides a budget refusal.
    assert DR_ADMIT_BUDGET != DR_ADMIT_OK and DR_ADMIT_BUDGET != DR_ADMIT_SCOPE;
    // TODO(task-8): the mid-run exhaustion meter (spend accrued against DR_BUDGET_WORDS).
}

// Case 8: one branch fails; siblings and the root must not report global completion. Exercises:
// task_tree.t27 (per-branch states), actor_events.t27 (aggregation over the envelope).
test one_branch_error_gives_no_false_global_completion {
    // TODO(task-7/8): fail one of two branches; assert the root is not accepted/done and the
    // failed branch's error is visible in the aggregation.
}

// Case 9: the executor changes (restart or replacement) and the task's recorded history --
// every attempt, result and verdict -- is still readable in order. Exercises: task_tree.t27
; (attempt_id entities), actor_events.t27 (seq ordering).
test history_survives_an_executor_change {
    // MODEL half (now): every attempt of task 210 keeps its own id, number and decodeable task,
    // across any number of executor changes; the ids grow monotonically so the recorded order
    // is readable; the recovery path reuses the attempt entity (same id, state back to RUNNING).
    var a0: u64 = tt_attempt_id(210, 0);
    var a1: u64 = tt_attempt_id(210, 1);
    var a2: u64 = tt_attempt_id(210, 2);
    assert tt_attempt_fresh(a1, a0) == true;
    assert tt_attempt_fresh(a2, a1) == true;
    assert tt_attempt_task(a0) == 210 and tt_attempt_task(a1) == 210 and tt_attempt_task(a2) == 210;
    assert tt_attempt_no(a0) == 0 and tt_attempt_no(a1) == 1 and tt_attempt_no(a2) == 2;
    // Recovery keeps the attempt entity: ERROR -> RUNNING on the same id.
    var recovered: u8 = tt_on_error(TT_RUNNING);
    assert recovered == TT_ERROR or recovered == TT_RUNNING;
    assert tt_transition_ok(TT_ERROR, TT_RUNNING) == true;
    // RUNTIME half (TODO task-8): the event-sequence ordering across a real executor swap.
}

// Case 10: a child's rights are a subset of the parent's passed scope; a delegation that asks
; for more than the parent holds is refused at delegation time. Exercises: actors.t27 (scope
; subset law beside M_RESULT acceptance/rework tags), task_tree.t27 (task record).
test no_privilege_escalation_on_delegation {
    // Scope is a 64-bit bitmask; the child's granted scope must be a subset of the parent's.
    // A delegation asking for a bit the parent does not hold is refused; equal or narrower
    // passes; tt_grant never hands out a bit the parent does not have.
    var parent: u64 = 0b1101;             // bits 0, 2, 3
    assert tt_scope_subset(0b1101, parent) == true;   // equal scope is a subset
    assert tt_scope_subset(0b0100, parent) == true;   // narrower is a subset
    assert tt_scope_subset(0b0000, parent) == true;   // empty scope is a subset
    assert tt_scope_subset(0b0010, parent) == false;  // bit 1: escalation, refused
    assert tt_scope_subset(0b1111, parent) == false;  // superset, refused
    // The grant is the intersection: the child gets exactly what was granted AND held.
    assert tt_grant(parent, 0b1111) == parent;  // asking for the world yields only the parent's
    assert tt_grant(parent, 0b0100) == 0b0100;
    assert tt_grant(parent, 0b0010) == 0b0000;  // a refused request grants nothing
    // Nested delegation composes: a grandchild of a narrowed child cannot exceed the child.
    var child: u64 = tt_grant(parent, 0b0100);
    assert tt_scope_subset(tt_grant(child, 0b1101), parent) == true;
    assert tt_grant(child, 0b1101) == child;    // the root's bit 0/3 never leak downward
}

; --- 3. Full-chain scenario (CONTRACT MODE: executable now on landed laws, real calls after task-8)

/// The owner's full-chain scenario, one section, never mixed: each step asserts what a LANDED
/// law already guarantees, through that law's public functions, with fixtures only. Steps that
/// need the runtime (task-8) or the graph/semantics tracks (task-12/13) are named TODO stubs
/// keyed to those tasks; no step pretends to have run through the real runtime.

// Step 1+2: select an actor on the graph; navigate to its task. The selection is the stable
// identity (source kind + lane text), and the card's task line names the task it serves --
// navigation reads identity and task_ref, never a row index.
test scenario_select_actor_and_navigate_to_its_task {
    var tab : [512]u32 = undefined;
    var txt : [5120]u8 = undefined;
    var n : u32 = lv_add(tab[0..512], txt[0..5120], 0, LV_PANE, 11324, 0, 0, LVS_RUNNING, 100, 0, "pane work vt.t27");
    n = lv_add(tab[0..512], txt[0..5120], n, LV_SCRIPT, 11371, 0, 0, LVS_RUNNING, 50, 0, "lane tri land");
    // select row 1: the identity is packed from source kind and lane text, not the row number
    var sel : u64 = qlg_zoom_select(tab[0..512], txt[0..5120], 1);
    assert(sel != QLG_Z_NOSEL and sel != QLG_Z_GONE);
    assert(qlg_zoom_select(tab[0..512], txt[0..5120], 0) != sel);
    // the same selection on the t27f contract side is one ref on the one VizState
    var s : VizState = viz_init(3, 2);
    var ref : u32 = viz_ref(2, 1);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_LOADED, 2, 0);
    s = viz_apply(s, VIZ_EV_SELECT, ref, 0);
    assert(s.selected == ref);
    // TODO(task-12/13): navigate-to-subtree as the graph semantics law lands; the task link
    // itself is asserted by result_returns_along_the_correct_parent_link in section 2.
}

// Step 3: a child executor appears in the graph. Fixture half: a new row appears and the
// selection law finds entities by identity, so a spawned child is visible without moving
// anyone else's identity. The real spawn is the runtime's (task-8).
test scenario_child_executor_appears_in_the_graph {
    var tab : [512]u32 = undefined;
    var txt : [5120]u8 = undefined;
    var n : u32 = lv_add(tab[0..512], txt[0..5120], 0, LV_PANE, 11324, 0, 0, LVS_RUNNING, 100, 0, "pane parent");
    var sel : u64 = qlg_zoom_select(tab[0..512], txt[0..5120], 0);
    // a child is spawned under the same task: the parent's identity is untouched
    n = lv_add(tab[0..512], txt[0..5120], n, LV_SCRIPT, 11324, 0, 0, LVS_RUNNING, 0, 0, "lane child of 11324");
    assert(qlg_zoom_find(tab[0..512], txt[0..5120], n, sel) == 0);
    assert(qlg_zoom_find(tab[0..512], txt[0..5120], n, qlg_zoom_id(LV_SCRIPT, "lane child of 11324")) == 1);
    // TODO(task-8): the real nested spawn (kernel actor tree), replacing this fixture claim.
}

// Step 4+5: the result returns to the correct attempt and the parent accepts or demands rework.
// Both verdicts are legal from RESULT_RETURNED, and only from there (fixture: the state machine).
test scenario_result_returns_and_parent_accepts_or_reworks {
    var s : u8 = tt_on_result_delivered(tt_on_executor_done(TT_RUNNING));
    assert(s == TT_RESULT_RETURNED);
    // the result names its attempt: task_ref decoding is the routing
    var aid : u64 = tt_attempt_id(210, 1);
    assert(tt_attempt_task(aid) == 210 and tt_attempt_no(aid) == 1);
    // accept is legal, rework is legal, both only from RESULT_RETURNED
    assert(tt_on_accepted(s) == TT_ACCEPTED);
    assert(tt_on_rework(s) == TT_RUNNING);          // rework opens a new attempt
    assert(tt_on_accepted(TT_RUNNING) == TT_RUNNING); // accept without a returned result: no-op
    // ENGINE half (contract mode): delivery is legal only from EXEC_DONE; the verdicts are
    // legal only on a delivered result; the verdict tags/events are the landed constants.
    assert dr_deliver_ok(TT_EXEC_DONE) == true;
    assert dr_verdict_ok(TT_RESULT_RETURNED, DR_VERDICT_ACCEPT) == true;
    assert dr_verdict_ok(TT_RESULT_RETURNED, DR_VERDICT_REWORK) == true;
    assert dr_verdict_ok(TT_EXEC_DONE, DR_VERDICT_ACCEPT) == false;   // not delivered yet
    assert dr_verdict_ok(TT_ACCEPTED, DR_VERDICT_REWORK) == false;    // already closed
    // TODO(task-8): the same step driven by real result delivery events (EV_RESULT envelope).
}

// Step 6: the graph updates without losing focus -- a refresh that changes lane states must
// keep the selection while the entity exists.
test scenario_graph_updates_without_losing_focus {
    var tab : [512]u32 = undefined;
    var txt : [5120]u8 = undefined;
    var n : u32 = lv_add(tab[0..512], txt[0..5120], 0, LV_PANE, 11324, 0, 0, LVS_RUNNING, 100, 0, "pane work vt.t27");
    var sel : u64 = qlg_zoom_select(tab[0..512], txt[0..5120], 0);
    // refresh: the same lane, now DONE, rebuilt at a new index; the selection keeps
    var tab2 : [512]u32 = undefined;
    var txt2 : [5120]u8 = undefined;
    var m : u32 = lv_add(tab2[0..512], txt2[0..5120], 0, LV_SCRIPT, 11371, 0, 0, LVS_DONE, 0, 0, "lane other");
    m = lv_add(tab2[0..512], txt2[0..5120], m, LV_PANE, 11324, 0, 0, LVS_DONE, 0, 0, "pane work vt.t27");
    assert(qlg_zoom_keep(sel, tab2[0..512], txt2[0..5120], m) == sel);
    assert(qlg_zoom_find(tab2[0..512], txt2[0..5120], m, sel) == 1);
}

// Step 7: a duplicate event in the chain creates no second completion (the scenario's idempotence
// leg, asserted through the landed task-tree law).
test scenario_duplicate_event_no_second_completion {
    var s : u8 = tt_on_accepted(tt_on_result_delivered(tt_on_executor_done(TT_RUNNING)));
    assert(s == TT_ACCEPTED);
    assert(tt_on_result_delivered(s) == s);        // duplicate EV_RESULT: absorbed
    assert(tt_on_accepted(s) == s);                // duplicate EV_ACCEPTED: absorbed
    assert(tt_done_once(s, s) == false);           // and no second completion edge exists
}

// Step 8: BACK from the detail view clears the selection and nothing else; returning from a
// tab restores the previous viewport.
test scenario_back_clears_selection_only_and_viewport_law_will_restore {
    // t27f contract law: BACK clears the selection; every other VizState field is unchanged.
    var s : VizState = viz_init(3, 2);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_LOADED, 2, 0);
    s = viz_apply(s, VIZ_EV_SELECT, viz_ref(2, 1), 0);
    var before : VizState = s;
    s = viz_apply(s, VIZ_EV_BACK, 0, 0);
    assert(s.selected == VIZ_REF_NONE);
    assert(s.step == before.step and s.param == before.param and s.focus == before.focus);
    // BACK with nothing selected closes the petal instead (the contract's own law)
    assert(viz_back_closes(s) == true);
    // t27os zoom law: BACK clears the selection to the explicit no-selection word
    var tab : [512]u32 = undefined;
    var txt : [5120]u8 = undefined;
    var n : u32 = lv_add(tab[0..512], txt[0..5120], 0, LV_PANE, 11324, 0, 0, LVS_RUNNING, 100, 0, "pane work vt.t27");
    var sel : u64 = qlg_zoom_select(tab[0..512], txt[0..5120], 0);
    assert(qlg_zoom_back(sel) == QLG_Z_NOSEL);
    // TODO(task-12/13): viewport restore across tabs -- the shell_state law landed, asserted
    // below in this test; the deeper inspector-viewport composition remains with task-12/13.
    // SHELL half (landed law): a tab switch keeps the selection, the viewport is kept through
    // the switch, and BACK restores the previous viewport without touching the selection.
    var sel_w : u64 = 0x1234;
    var vp : u64 = 0x5678;
    sel_w = ss_tab_switch_keeps_sel(SS_TAB_GRAPH, SS_TAB_TASKS, sel_w);
    assert sel_w == 0x1234;                       // selection survives the tab switch
    assert ss_viewport_keep(vp) == 0x5678;        // the viewport is kept, not reset
    assert ss_back(sel_w, vp) == 0x5678;          // BACK restores the previous viewport
    assert ss_back(SS_SEL_NONE, vp) == 0x5678;    // BACK with nothing selected: viewport intact
}

; --- 4. Bridge: QLG_Z <-> VIZ_ -- identity-and-state semantics, one meaning on both sides ----------

/// The bridge test: the t27os host zoom law and the t27f contract zoom law must agree on the
/// MEANING of keep, gone and back -- never on numeric constants. One selection, one VizState,
/// one explicit gone, one BACK.
test bridge_keep_gone_and_back_mean_the_same_on_both_sides {
    var tab : [512]u32 = undefined;
    var txt : [5120]u8 = undefined;
    var n : u32 = lv_add(tab[0..512], txt[0..5120], 0, LV_PANE, 11324, 0, 0, LVS_RUNNING, 100, 0, "pane work vt.t27");
    var sel : u64 = qlg_zoom_select(tab[0..512], txt[0..5120], 0);
    // KEEP: the entity exists after a refresh -> the same identity survives on both sides.
    // Host side: qlg_zoom_keep returns the identical id. Contract side: events that do not
    // touch the selection (hover) leave s.selected equal to what was selected.
    var tab2 : [512]u32 = undefined;
    var txt2 : [5120]u8 = undefined;
    var m : u32 = lv_add(tab2[0..512], txt2[0..5120], 0, LV_PANE, 11324, 0, 0, LVS_DONE, 0, 0, "pane work vt.t27");
    assert(qlg_zoom_keep(sel, tab2[0..512], txt2[0..5120], m) == sel);
    var s : VizState = viz_init(1, 1);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_LOADED, 1, 0);
    var r : u32 = viz_ref(2, 0);
    s = viz_apply(s, VIZ_EV_SELECT, r, 0);
    s = viz_apply(s, VIZ_EV_HOVER, r, 0);
    assert(s.selected == r);
    // GONE: the entity vanishes -> an EXPLICIT gone state, never a silent clear to no-selection.
    // Host side: QLG_Z_GONE is a distinct word from QLG_Z_NOSEL. Contract side has no silent
    // drop either: only SELECT/CLEAR/BACK move selected, so a refresh cannot erase it.
    var tab3 : [512]u32 = undefined;
    var txt3 : [5120]u8 = undefined;
    var k : u32 = lv_add(tab3[0..512], txt3[0..5120], 0, LV_SCRIPT, 11371, 0, 0, LVS_RUNNING, 0, 0, "lane other");
    assert(qlg_zoom_keep(sel, tab3[0..512], txt3[0..5120], k) == QLG_Z_GONE);
    assert(QLG_Z_GONE != QLG_Z_NOSEL);
    assert(QLG_Z_NONE != QLG_Z_NOSEL);
    assert(VIZ_REF_NONE == 0);   // the contract's "nothing" word: selection can rest on it only
    // BACK: clears the selection, and nothing else, on both sides.
    assert(qlg_zoom_back(sel) == QLG_Z_NOSEL);
    var s2 : VizState = viz_apply(s, VIZ_EV_BACK, 0, 0);
    assert(s2.selected == VIZ_REF_NONE);
    // TODO(task-12/13): the inspector-viewport composition legs of BACK (deeper than the
    // selection/viewport pair) join this bridge when those laws land.
    // SHELL half (landed law): the bridge's BACK leg on the shell side -- BACK hands back the
    // viewport, never a cleared viewport and never a moved selection.
    assert ss_back(0x1234, 0x5678) == 0x5678;
    assert ss_viewport_keep(0x5678) == 0x5678;
    assert ss_tab_switch_keeps_sel(SS_TAB_GRAPH, SS_TAB_TASKS, 0x1234) == 0x1234;
}
