// Case 9: the executor changes (restart or replacement) and the task's recorded history --
// every attempt, result and verdict -- is still readable in order. Exercises: task_tree.t27
; (attempt_id entities), actor_events.t27 (seq ordering).
test history_survives_an_executor_change {
    // MODEL half (now): every attempt of task 210 keeps its own id, number and decodeable task,
    // across any number of executor changes; the ids grow monotonically so the recorded order
    // is readable; the recovery path reuses the attempt entity (same id, state back to RUNNING).
    var a0: u64 = tt_attempt_id(210, 0);
    var a1: u64 = tt_attempt_id(210, 1);
    var a2: u64 = tt_attempt_id(210, 2);
    assert tt_attempt_fresh(a1, a0) == true;
    assert tt_attempt_fresh(a2, a1) == true;
    assert tt_attempt_task(a0) == 210 and tt_attempt_task(a1) == 210 and tt_attempt_task(a2) == 210;
    assert tt_attempt_no(a0) == 0 and tt_attempt_no(a1) == 1 and tt_attempt_no(a2) == 2;
    // Recovery keeps the attempt entity: ERROR -> RUNNING on the same id.
    var recovered: u8 = tt_on_error(TT_RUNNING);
    assert recovered == TT_ERROR or recovered == TT_RUNNING;
    assert tt_transition_ok(TT_ERROR, TT_RUNNING) == true;
    // RUNTIME half (TODO task-8): the event-sequence ordering across a real executor swap.
}

// Case 10: a child's rights are a subset of the parent's passed scope; a delegation that asks
; for more than the parent holds is refused at delegation time. Exercises: actors.t27 (scope
; subset law beside M_RESULT acceptance/rework tags), task_tree.t27 (task record).
test no_privilege_escalation_on_delegation {
    // Scope is a 64-bit bitmask; the child's granted scope must be a subset of the parent's.
    // A delegation asking for a bit the parent does not hold is refused; equal or narrower
    // passes; tt_grant never hands out a bit the parent does not have.
    var parent: u64 = 0b1101;             // bits 0, 2, 3
    assert tt_scope_subset(0b1101, parent) == true;   // equal scope is a subset
    assert tt_scope_subset(0b0100, parent) == true;   // narrower is a subset
    assert tt_scope_subset(0b0000, parent) == true;   // empty scope is a subset
    assert tt_scope_subset(0b0010, parent) == false;  // bit 1: escalation, refused
    assert tt_scope_subset(0b1111, parent) == false;  // superset, refused
    // The grant is the intersection: the child gets exactly what was granted AND held.
    assert tt_grant(parent, 0b1111) == parent;  // asking for the world yields only the parent's
    assert tt_grant(parent, 0b0100) == 0b0100;
    assert tt_grant(parent, 0b0010) == 0b0000;  // a refused request grants nothing
    // Nested delegation composes: a grandchild of a narrowed child cannot exceed the child.
    var child: u64 = tt_grant(parent, 0b0100);
    assert tt_scope_subset(tt_grant(child, 0b1101), parent) == true;
    assert tt_grant(child, 0b1101) == child;    // the root's bit 0/3 never leak downward
}

