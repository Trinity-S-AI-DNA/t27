; specs/queen/task_tree_check.t27 -- full-chain verification matrix for the task tree and its
; return protocol. CHECKS track, task-10 (branch spec/zoom-checks).
; 
; This spec is the acceptance layer of the delegation slice (task-7 model law, task-8 runtime).
; It exercises the model + runtime through their PUBLIC functions only: specs/queen/task_tree.t27
; (task tree: parent links, attempts, states), specs/queen/actors.t27 (return protocol tags,
; scope subset), specs/queen/events.t27 (EV_RESULT / EV_ACCEPTED kinds), and the aggregation in
; specs/queen/actor_events.t27 (envelope: seq / at / from_pid / to_pid / task_ref).
; It does NOT restate or re-derive any law; a rule tested here is owned by the file that
; defines it. Contract tests for functions a task-7/8 file itself owns live with that file.
; 
; The ten cases of the verification matrix (one test name each, section 2 below):
;   1  multiple branches and nested levels
;   2  result returned along the correct parent link
;   3  repeated delivery without double completion (idempotent result delivery)
;   4  stale result from a previous attempt
;   5  executor disappearance and restart
;   6  parent cancel with a running child
;   7  budget exhaustion
;   8  one-branch error without a false global completion
;   9  history preserved across an executor change
;  10  no privilege escalation on delegation (child rights are a subset of the passed scope)
; 
; Status 2026-11-01: SKELETON. The test names are the matrix; the asserts land after task-7
; (model law) and task-8 (runtime) define the public functions these tests call. Until then each
; body pins only what already exists, so the file compiles green and no test passes vacuously.
; 
; Fixtures vs real calls: transformation tests in section 2 use fixtures built from the model
; functions; the integration scenario (section 3) uses real calls through the runtime. The two
; are never mixed in one claim.
; ASCII only (L3). L4: every rule named above has a test block in this file.
; phi^2 + 1/phi^2 = 3 | TRINITY

module TaskTreeCheck;

use queen::events::BUS_KINDS;

; --- 1. Sanity of the acceptance layer itself ---------------------------------------------------------

/// The event bus the matrix reads must be the bus that exists: if the kind count moves, every
/// result-path test below must be re-read against the new kinds. This is the only cross-check
/// this file makes against a frozen shape.
test the_event_bus_the_matrix_reads_still_exists {
    assert BUS_KINDS == 10;
}

; --- 2. The verification matrix (asserts land after task-7 / task-8) ----------------------------------

// Case 1: several branches at the root and at least one nested level below a branch; the tree
// holds them side by side without crosstalk. Exercises: task_tree.t27 (task_id, parent_task_id,
// root_task_id), actor_events.t27 (envelope task_ref).
test multiple_branches_and_nested_levels_form_one_tree {
    // TODO(task-7/8): build a root, two branches, a child under each branch; assert every node
    // resolves to the root through its parent link and branches do not see each other's children.
}

// Case 2: a child's result travels to ITS parent, not to the root or a sibling. Exercises:
// task_tree.t27 (parent_task_id link), actors.t27 (M_RESULT tag), events.t27 (EV_RESULT).
test result_returns_along_the_correct_parent_link {
    // TODO(task-7/8): deliver a result from a nested child; assert the receiving task is the
    // direct parent and no other task in the tree observed the delivery.
}

// Case 3: the same result delivered twice completes the task once. Exercises:
// task_tree.t27 (executor-done vs result-returned vs parent-accepted states).
test repeated_delivery_does_not_complete_twice {
    // TODO(task-7/8): deliver one result twice (same attempt_id); assert one completion and one
    // accepted transition, no duplicate row in history.
}

// Case 4: a late result carried by attempt_id of a superseded attempt is rejected as stale and
// does not disturb the live attempt. Exercises: task_tree.t27 (attempt_id as an entity).
test stale_result_from_a_previous_attempt_is_rejected {
    // TODO(task-7/8): retry the task, then deliver the old attempt's result; assert it is marked
    // stale and the live attempt stays in its current state.
}

// Case 5: the executor disappears and comes back; the tree keeps the task's history and the
; replacement executor resumes it. Exercises: task_tree.t27 (agent sid link), actors.t27
; (restart paths), events.t27 (EV_ACTOR_DOWN / EV_ACTOR_RESTART kinds).
test executor_disappearance_and_restart_preserves_the_task {
    // TODO(task-7/8): drop the executor sid, restart under a new sid; assert task state and
    // history survive the identity change and the new sid is linked.
}

// Case 6: cancelling a parent whose child is still running cancels the child too, exactly once.
// Exercises: task_tree.t27 (cancel), actors.t27 (M_CANCEL and its acceptance tag).
test parent_cancel_reaches_the_running_child {
    // TODO(task-7/8): cancel the parent while the child runs; assert the child's cancellation and
    // that a repeated parent cancel does not cancel twice.
}

// Case 7: a delegation that spends past its granted budget is stopped and reports exhaustion;
// it must not fail the parent by surprise beyond the granted scope. Exercises: task_tree.t27
; (budget), actors.t27 (scope field passed on delegation).
test budget_exhaustion_stops_the_delegation_cleanly {
    // TODO(task-7/8): run a child past its budget; assert the exhaustion verdict and that the
    // parent sees an explicit exhaustion, not a silent zero.
}

// Case 8: one branch fails; siblings and the root must not report global completion. Exercises:
// task_tree.t27 (per-branch states), actor_events.t27 (aggregation over the envelope).
test one_branch_error_gives_no_false_global_completion {
    // TODO(task-7/8): fail one of two branches; assert the root is not accepted/done and the
    // failed branch's error is visible in the aggregation.
}

// Case 9: the executor changes (restart or replacement) and the task's recorded history --
// every attempt, result and verdict -- is still readable in order. Exercises: task_tree.t27
; (attempt_id entities), actor_events.t27 (seq ordering).
test history_survives_an_executor_change {
    // TODO(task-7/8): swap the executor mid-task; assert the event sequence for the task reads
    // monotonically and every prior attempt is still listed.
}

// Case 10: a child's rights are a subset of the parent's passed scope; a delegation that asks
; for more than the parent holds is refused at delegation time. Exercises: actors.t27 (scope
; subset law beside M_RESULT acceptance/rework tags), task_tree.t27 (task record).
test no_privilege_escalation_on_delegation {
    // TODO(task-7/8): request a child scope wider than the parent's; assert refusal; request an
    // equal or narrower scope; assert acceptance.
}

; --- 3. Integration scenario (real calls, after task-8) ----------------------------------------------

/// One real nested delegation end to end: parent delegates to a child with an explicit scope,
/// the child runs, returns a result, the parent accepts. This is the integration-evidence test;
/// it uses real calls only, never fixtures, and never in the same claim as section 2 fixtures.
test full_chain_delegation_returns_and_is_accepted {
