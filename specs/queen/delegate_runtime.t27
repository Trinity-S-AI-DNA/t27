; specs/queen/delegate_runtime.t27 -- the delegation engine over the task tree (task-8)
; The Queen delegates a task to a child actor; the child runs it under an explicit scope
; and budget granted from the parent's own mask, returns the result up the chain, and the
; parent accepts it or sends it back for rework. Cancellation reaches a running child;
; a restart starts a fresh attempt and preserves the history (the task id is stable, the
; attempt number grows -- task_tree.t27).
; Nothing of the actor model or the task tree is restated. Message tags M_RESULT/M_ACCEPT/
; M_REWORK, lanes, call chains and the attempt entity come from actors.t27 (used); the task
; state machine, attempt ids and scope rules come from task_tree.t27 (used); the event kinds
; come from events.t27 (used). Only what is new lives here: spawn admission against the
; parent's scope mask and the budget, the delivery path, the parent verdict, cancel of a
; running child, and restart-preserves-history.
; English only (LANG-EN). ASCII only (L3). Every section carries test or invariant (L4).

use queen::actors::M_RESULT;
use queen::actors::M_ACCEPT;
use queen::actors::M_REWORK;
use queen::actors::CALL_MAX_DEPTH;
use queen::task_tree::tt_scope_subset;
use queen::task_tree::tt_grant;
use queen::task_tree::tt_attempt_id;
use queen::task_tree::tt_attempt_task;
use queen::task_tree::tt_attempt_no;
use queen::task_tree::tt_attempt_fresh;
use queen::task_tree::tt_on_result_delivered;
use queen::task_tree::tt_on_accepted;
use queen::task_tree::tt_on_rework;
use queen::task_tree::tt_on_cancel;
use queen::task_tree::tt_transition_ok;
use queen::events::EV_RESULT;
use queen::events::EV_ACCEPTED;
use queen::events::EV_REWORK;
use queen::events::EV_CANCEL;

; --- 1. Budget and child admission -----------------------------------------------------------------

/// The budget a parent may spend on one delegation: memory words and a wall-clock cap.
/// Chosen, not measured; the kernel's measured lane memory replaces LANE_MB later (kernel.t27).
pub const DR_BUDGET_WORDS : u64 = 65536;
pub const DR_BUDGET_MS : u64 = 600000;
/// A parent holds at most this many live children at once (kernel delegation breadth).
pub const DR_MAX_CHILDREN : u32 = 4;
/// Delegation depth rides the call-chain cap; the chain law stays actors.t27's.
pub const DR_MAX_DEPTH : u32 = CALL_MAX_DEPTH;

/// A spawn request carries the parent's granted scope mask, the scope the child asks for,
/// and the parent's live-child count. Admission is one decision from four facts: the asked
/// scope must sit inside the parent's mask (no escalation, tt_scope_subset), the grant is
/// exactly what the parent gives of what was asked (tt_grant), the parent has a child slot,
/// and the budget asked fits the parent's own budget. Depth was already admitted by the
/// caller's call_admit before the spawn, so it is not re-checked here (actors.t27 owns it).
pub const DR_ADMIT_OK : u8 = 0;
pub const DR_ADMIT_SCOPE : u8 = 1;
pub const DR_ADMIT_FULL : u8 = 2;
pub const DR_ADMIT_BUDGET : u8 = 3;

pub fn dr_admit(child_scope: u64, parent_scope: u64, live_children: u32, budget_words: u64) -> u8 {
    if (tt_scope_subset(child_scope, parent_scope) == false) { return DR_ADMIT_SCOPE; }
    if (live_children >= DR_MAX_CHILDREN) { return DR_ADMIT_FULL; }
    if (budget_words > DR_BUDGET_WORDS) { return DR_ADMIT_BUDGET; }
    return DR_ADMIT_OK;
}

/// The mask the child actually receives: only what the parent grants of what was asked.
pub fn dr_grant(parent_scope: u64, requested: u64) -> u64 {
    return tt_grant(parent_scope, requested);
}

; --- 2. Result delivery up the chain ----------------------------------------------------------------

/// A child that finished its work moves EXEC_DONE -> RESULT_RETURNED and delivers M_RESULT
/// up the chain to its parent. Delivery succeeds only from a state that owns the result:
/// an already delivered result is dropped, not re-counted (idempotent redelivery, task_tree).
pub fn dr_deliver_ok(state: u8) -> bool {
    // The tree's tt_transition_ok admits self-loops and its helper moves RUNNING ->
    // EXEC_DONE, so a state that does not own the result would still "deliver"; the
    // engine refuses everything before delegating: exactly EXEC_DONE may deliver.
    if (state != 2) { return false; }
    const next : u8 = tt_on_result_delivered(state);
    return tt_transition_ok(state, next);
}

/// The tag a delivered result carries is M_RESULT; the event the chain records is EV_RESULT.
/// Both are the law's constants; the engine only pairs them.
pub fn dr_result_tag() -> u64 {
    return M_RESULT;
}

pub fn dr_result_event() -> u8 {
    return EV_RESULT;
}

/// A late duplicate of a result whose attempt already returned (or is past returning) is
/// refused: the attempt completed once, so a redelivery never creates a second completion.
pub fn dr_redelivery_refused(arriving_state: u8) -> bool {
    if (arriving_state >= 3) { return true; }   // result_returned or later: already owned
    return false;
}

; --- 3. Parent accept / rework ---------------------------------------------------------------------

/// The parent's verdict on a returned result. ACCEPT closes the task; REWORK opens a fresh
/// attempt of the same task id (history keeps every earlier attempt).
pub const DR_VERDICT_ACCEPT : u8 = 0;
pub const DR_VERDICT_REWORK : u8 = 1;

/// The verdict is legal only on a result that has been delivered (RESULT_RETURNED). The tag
/// the parent sends back follows the verdict; the event follows it too.
pub fn dr_verdict_ok(state: u8, verdict: u8) -> bool {
    if (state != 3) { return false; }   // TT_RESULT_RETURNED, by value, no restate
    if (verdict == DR_VERDICT_ACCEPT) { return tt_transition_ok(state, tt_on_accepted(state)); }
    if (verdict == DR_VERDICT_REWORK) { return tt_transition_ok(state, tt_on_rework(state)); }
    return false;
}

pub fn dr_verdict_tag(verdict: u8) -> u64 {
    if (verdict == DR_VERDICT_ACCEPT) { return M_ACCEPT; }
    return M_REWORK;
}

pub fn dr_verdict_event(verdict: u8) -> u8 {
    if (verdict == DR_VERDICT_ACCEPT) { return EV_ACCEPTED; }
    return EV_REWORK;
}

/// Rework bounds: after the ceiling the parent must stop reworking -- escalate instead
/// (dispatch.t27's two send-backs then escalate is the same shape; the engine keeps its own
/// counted ceiling so a child cannot be reworked forever).
pub const DR_REWORK_CEILING : u32 = 2;

pub fn dr_rework_allowed(attempt_no: u32) -> bool {
    return attempt_no <= DR_REWORK_CEILING;
}

; --- 4. Cancel with a running child -----------------------------------------------------------------

/// Cancel reaches a child in CREATED or RUNNING. The attempt moves to CANCELED; anything the
/// child has finished but not delivered is dropped with it. Cancel of an ACCEPTED or CANCELED
/// attempt changes nothing (idempotent).
pub fn dr_cancel_ok(state: u8) -> bool {
    // Per this spec, cancel of ACCEPTED or CANCELED drops the request: it changes nothing.
    // The tree's transitions would move ACCEPTED -> CANCELED (and CANCELED loops), so the
    // engine refuses both states explicitly before delegating.
    if (state == 4 or state == 5) { return false; }
    const next : u8 = tt_on_cancel(state);
    return tt_transition_ok(state, next);
}

pub fn dr_cancel_event() -> u8 {
    return EV_CANCEL;
}

; --- 5. Restart preserves history --------------------------------------------------------------------

/// A restart of a failed task keeps the task id and grows the attempt number, so the
/// finished attempts stay in the history while the work itself starts fresh. The new
/// attempt id must be fresh against the last one (tt_attempt_fresh), and it must belong
/// to the same task (no restart across tasks).
pub fn dr_restart_ok(last_aid: u64, next_attempt: u32) -> bool {
    const next_aid : u64 = tt_attempt_id(tt_attempt_task(last_aid), next_attempt);
    if (tt_attempt_task(next_aid) != tt_attempt_task(last_aid)) { return false; }
    return tt_attempt_fresh(next_aid, last_aid);
}

/// A recovered error reuses the same attempt (the tree's recover move keeps the attempt);
/// a restart after rework or cancel opens the next attempt. The engine asks the state:
/// ERROR goes back into the same attempt number, every other restartable state moves on.
pub fn dr_restart_attempt(state: u8, attempt_no: u32) -> u32 {
    if (state == 6) { return attempt_no; }   // TT_ERROR: recover in place
    return attempt_no + 1;
}

; --- 6. Matrix tests ---------------------------------------------------------------------------------

/// The §6 matrix: every cell is one deliverable of task-8, crossed with the tree states
/// the engine must handle. Each test below is one row of the matrix.
///
///   action \ state     CREATED  RUNNING  EXEC_DONE  RESULT_RETURNED  ACCEPTED  CANCELED  ERROR
///   admit scope         yes      yes      no         no              no        no        no
///   deliver             no       no       yes        drop            no        no        no
///   accept/rework       no       no       no         yes             no        no        no
///   cancel              yes      yes      no         no              drop      drop      no
///   restart             no       no       no         after rework    no        yes       recover

test spawn_admits_only_inside_parent_scope {
    // A child may ask for any subset of the parent's mask, never a bit beyond it.
    assert dr_admit(0b0011, 0b0111, 0, DR_BUDGET_WORDS) == DR_ADMIT_OK;
    assert dr_admit(0b1000, 0b0111, 0, DR_BUDGET_WORDS) == DR_ADMIT_SCOPE;
    // The grant is the intersection, never the ask itself.
    assert dr_grant(0b0111, 0b1111) == 0b0111;
    assert dr_grant(0b0111, 0b0010) == 0b0010;
}

test spawn_refuses_full_parent_and_over_budget {
    // A parent at its child ceiling admits nobody.
    assert dr_admit(0b0001, 0b0001, DR_MAX_CHILDREN, DR_BUDGET_WORDS) == DR_ADMIT_FULL;
    // A budget past the engine's word cap is refused before any child exists.
    assert dr_admit(0, 0, 0, DR_BUDGET_WORDS + 1) == DR_ADMIT_BUDGET;
}

test result_delivers_once_and_drops_duplicates {
    // EXEC_DONE -> RESULT_RETURNED is the only delivery edge.
    assert dr_deliver_ok(2) == true;
    assert dr_deliver_ok(1) == false;
    assert dr_deliver_ok(3) == false;
    // A duplicate of a delivered result is refused; the completion is not counted twice.
    assert dr_redelivery_refused(3) == true;
    assert dr_redelivery_refused(4) == true;
    assert dr_redelivery_refused(2) == false;
    // The pair the chain sees is the law's tag and event.
    assert dr_result_tag() == M_RESULT;
    assert dr_result_event() == EV_RESULT;
}

test parent_accepts_or_reworks_a_returned_result {
    // The verdict is legal only on a delivered result.
    assert dr_verdict_ok(3, DR_VERDICT_ACCEPT) == true;
    assert dr_verdict_ok(3, DR_VERDICT_REWORK) == true;
    assert dr_verdict_ok(2, DR_VERDICT_ACCEPT) == false;
    assert dr_verdict_ok(4, DR_VERDICT_REWORK) == false;
    // Tags and events follow the verdict.
    assert dr_verdict_tag(DR_VERDICT_ACCEPT) == M_ACCEPT;
    assert dr_verdict_tag(DR_VERDICT_REWORK) == M_REWORK;
    assert dr_verdict_event(DR_VERDICT_ACCEPT) == EV_ACCEPTED;
    assert dr_verdict_event(DR_VERDICT_REWORK) == EV_REWORK;
    // The rework ceiling: attempt numbers 1 and 2 may be reworked, 3 may not.
    assert dr_rework_allowed(1) == true;
    assert dr_rework_allowed(2) == true;
    assert dr_rework_allowed(3) == false;
}

test cancel_reaches_a_running_child_and_is_idempotent {
    // CREATED and RUNNING cancel; ACCEPTED and CANCELED drop the request.
    assert dr_cancel_ok(0) == true;
    assert dr_cancel_ok(1) == true;
    assert dr_cancel_ok(4) == false;
    assert dr_cancel_ok(5) == false;
    // The chain records the cancel event.
    assert dr_cancel_event() == EV_CANCEL;
}

test restart_grows_the_attempt_and_keeps_the_task {
    // A restart of task 7 after attempt 3 opens attempt 4 of the same task.
    const last : u64 = tt_attempt_id(7, 3);
    assert dr_restart_ok(last, 4) == true;
    assert tt_attempt_task(tt_attempt_id(7, 4)) == 7;
    assert tt_attempt_no(tt_attempt_id(7, 4)) == 4;
    // The new attempt is fresh against the old one; the old history is untouched.
    assert tt_attempt_fresh(tt_attempt_id(7, 4), last) == true;
    // A recovered error stays on the same attempt; rework or cancel moves to the next.
    assert dr_restart_attempt(6, 3) == 3;
    assert dr_restart_attempt(5, 3) == 4;
}

; --- Invariants -------------------------------------------------------------------------------------

invariant delegation_never_escalates_scope {
    // Whatever the parent grants, the child's mask is a subset of the parent's mask.
    assert tt_scope_subset(dr_grant(0b0111, 0b1111), 0b0111) == true;
    assert tt_scope_subset(dr_grant(0, 0b1111), 0) == true;
}

invariant delegation_depth_is_the_law_depth {
    // The engine never raises the call-chain cap; it delegates within it.
    assert DR_MAX_DEPTH == CALL_MAX_DEPTH;
}

invariant the_rework_ceiling_is_counted {
    // A child cannot be reworked forever: the ceiling bounds the attempt growth.
    assert DR_REWORK_CEILING == 2;
    assert dr_rework_allowed(DR_REWORK_CEILING) == true;
    assert dr_rework_allowed(DR_REWORK_CEILING + 1) == false;
}

invariant one_completion_per_attempt {
    // Deliver-then-verdict, redelivery refused: an attempt completes once.
    assert dr_deliver_ok(2) == true;
    assert dr_verdict_ok(3, DR_VERDICT_ACCEPT) == true;
    assert dr_redelivery_refused(3) == true;
}

; --- 7. Tree view: the display of what the model already knows ---------------------------------------
; DISPLAY ONLY, STATE-MACHINE-ONLY. Everything in this section reads facts the model already
; holds -- task id, parent, root, attempt, state, the tags a return carries -- and derives the
; row a tree view shows. Nothing here launches a child, sends a message or touches the host:
; the real child launch stays the task-8 executable-call dependency, and no call here imitates
; execution.

use queen::task_tree::tt_link_ok;
use queen::task_tree::tt_root;
use queen::task_tree::STATE_NAMES;

/// One display row of the delegation tree: what the panel shows per known task.
/// State name comes from the tree's own STATE_NAMES; nothing is invented here.
///   is_root    whether this task is its own root (tt_root)
///   state      the attempt's tree state (TT_* of task_tree.t27)
///   aid        the attempt id this row displays (task*64+n, tt_attempt_id)
pub fn dr_row_task(aid: u64) -> u64 {
    return tt_attempt_task(aid);
}

pub fn dr_row_attempt(aid: u64) -> u32 {
    return tt_attempt_no(aid);
}

pub fn dr_row_root(is_root: bool, parent_root: u64, self_id: u64) -> u64 {
    return tt_root(is_root, parent_root, self_id);
}

/// A row is displayable only when the tree law holds for it: the link parent/child must be
/// legal, and the state must name a real tree state.
pub fn dr_row_ok(parent: u64, child: u64, state: u8) -> bool {
    if (tt_link_ok(parent, child) == false) { return false; }
    if (state >= 8) { return false; }   // TASK_TREE_STATES, by value
    return true;
}

/// The state label a row shows, straight from the tree's own table.
pub fn dr_row_state_name(state: u8) -> str {
    return STATE_NAMES[state];
}

/// A result return the panel can show: the row carries the tag the return used (M_RESULT)
/// and the event it recorded (EV_RESULT). A return is shown only for an attempt whose
/// state actually owns the result (RESULT_RETURNED, or past it for a settled row).
pub fn dr_row_shows_return(state: u8) -> bool {
    if (state == 3 or state == 4) { return true; }
    return false;
}

/// Indent of a row in the tree view: the chain depth from the root, derived from how many
/// times the parent chain must be followed. The display never guesses a missing parent:
/// an unknown parent shows as depth 0 with an unlinked marker.
pub const DR_ROW_UNLINKED : u8 = 255;

pub fn dr_row_depth(depth_known: bool, depth: u32) -> u8 {
    if (depth_known == false) { return DR_ROW_UNLINKED; }
    if (depth > 254) { return 254; }
    return depth as u8;
}

test tree_view_rows_read_only_known_facts {
    // Task and attempt come apart exactly as the law packs them.
    assert dr_row_task(tt_attempt_id(7, 3)) == 7;
    assert dr_row_attempt(tt_attempt_id(7, 3)) == 3;
    // A root task is its own root; a child inherits the parent's root.
    assert dr_row_root(true, 0, 7) == 7;
    assert dr_row_root(false, 2, 7) == 2;
    // The state label is the tree's own word, not a new one.
    assert dr_row_state_name(3) == "result_returned";
    assert dr_row_state_name(4) == "accepted";
}

test tree_view_result_return_display {
    // A return is shown for a delivered result and an accepted one, never earlier.
    assert dr_row_shows_return(2) == false;
    assert dr_row_shows_return(3) == true;
    assert dr_row_shows_return(4) == true;
    assert dr_row_shows_return(1) == false;
    // A legal row needs a legal link and a real state.
    assert dr_row_ok(2, 7, 1) == true;
    assert dr_row_ok(7, 7, 1) == false;
    assert dr_row_ok(2, 7, 8) == false;
}

test tree_view_depth_hides_unknown_parents {
    // A row whose parent is not known shows unlinked, not a guessed depth.
    assert dr_row_depth(false, 0) == DR_ROW_UNLINKED;
    assert dr_row_depth(true, 2) == 2;
    // The display saturates instead of overflowing a byte.
    assert dr_row_depth(true, 999) == 254;
}

invariant tree_view_is_display_only {
    // The view reads the law's own tables and names; it launches nothing.
    assert dr_row_shows_return(3) == true;
    assert DR_ROW_UNLINKED == 255;
}

invariant tree_view_labels_come_from_the_tree {
    // Every state the row can show is one of the tree's eight states, named by its table.
    assert dr_row_state_name(0) == "created";
    assert dr_row_state_name(5) == "canceled";
    assert dr_row_state_name(7) == "recovering";
}

; --- 8. Parent aggregation --------------------------------------------------------------------------
; A root task fans out to children; the parent aggregates their outcomes. The law here covers
; what checks-core's case 8 needs: one success beside one failure does not fail the root; a
; partial result may be accepted when the spawn said so; cancelling the root cancels every
; running child; a failed branch retries on its own attempt without touching a successful
; sibling; a late result of an OLD attempt never attaches to the new one; and the parent may
; close the root explicitly, cancelling whatever is still running.
; STATE-MACHINE-ONLY, like every section of this file: pure functions over known facts.

/// Aggregation strategies, chosen at spawn and stored with the delegation.
/// ANY: one successful child settles the root (the others may fail or still run).
/// ALL: every child must be settled and none failed.
pub const DR_AGG_ANY : u8 = 0;
pub const DR_AGG_ALL : u8 = 1;

/// What the aggregation says about the root: keep waiting, close as success, close as failed.
pub const DR_AGG_RUNNING : u8 = 0;
pub const DR_AGG_SUCCESS : u8 = 1;
pub const DR_AGG_FAILED : u8 = 2;

pub fn dr_aggregate(strategy: u8, succeeded: u32, failed: u32, running: u32) -> u8 {
    if (strategy == DR_AGG_ANY) {
        if (succeeded >= 1) { return DR_AGG_SUCCESS; }   // branch failure does not fail the root
        if (failed >= 1 and running == 0) { return DR_AGG_FAILED; }
        return DR_AGG_RUNNING;
    }
    if (strategy == DR_AGG_ALL) {
        if (running > 0) { return DR_AGG_RUNNING; }
        if (failed > 0) { return DR_AGG_FAILED; }
        if (succeeded >= 1) { return DR_AGG_SUCCESS; }
        return DR_AGG_RUNNING;   // nothing yet: keep waiting
    }
    return DR_AGG_RUNNING;
}

/// A partial result: the parent may close on the children that reported, accepting the
/// missing ones as absent -- but only when the spawn declared partials allowed.
pub fn dr_partial_ok(allow_partial: bool, delivered: u32, expected: u32) -> bool {
    if (allow_partial == false) { return delivered >= expected; }
    return delivered >= 1 and delivered <= expected;
}

/// Cancelling the root cancels every running child at once; settled children are untouched.
/// The count returned is how many children the cancel reaches.
pub fn dr_root_cancel_reaches(running: u32) -> u32 {
    return running;
}

/// A failed branch retries on a fresh attempt of its own task; a successful sibling keeps
/// its settled attempt and its result. The retry is legal exactly when the engine's own
/// restart rule says so (same task id, attempt number grows).
pub fn dr_branch_retry_ok(failed_aid: u64, next_attempt: u32) -> bool {
    return dr_restart_ok(failed_aid, next_attempt);
}

/// A late result arriving after a new attempt started must NOT attach to the new attempt:
/// it binds only when task AND attempt number both match the current attempt.
pub fn dr_late_binds(arriving_aid: u64, current_aid: u64) -> bool {
    return arriving_aid == current_aid;
}

/// The parent's explicit close: legal at any time; whatever is still running is cancelled
/// with the close (the children see dr_cancel_ok's rules, the root just ends).
pub fn dr_root_close_ok(open_children: u32) -> bool {
    if (open_children > DR_MAX_CHILDREN) { return false; }   // bookkeeping sanity only
    return true;
}

test aggregation_any_survives_branch_failure {
    // One child succeeded beside one that failed: the root closes as a success at once.
    assert dr_aggregate(DR_AGG_ANY, 1, 1, 0) == DR_AGG_SUCCESS;
    // The same while a third child still runs: already a success, no waiting.
    assert dr_aggregate(DR_AGG_ANY, 1, 1, 1) == DR_AGG_SUCCESS;
    // Failures alone never fail the root while a retry may still come.
    assert dr_aggregate(DR_AGG_ANY, 0, 1, 1) == DR_AGG_RUNNING;
    assert dr_aggregate(DR_AGG_ANY, 0, 1, 0) == DR_AGG_FAILED;
}

test aggregation_all_needs_every_child {
    // ALL waits while anything runs, fails on any failure, succeeds only when all settled.
    assert dr_aggregate(DR_AGG_ALL, 1, 0, 1) == DR_AGG_RUNNING;
    assert dr_aggregate(DR_AGG_ALL, 1, 1, 0) == DR_AGG_FAILED;
    assert dr_aggregate(DR_AGG_ALL, 2, 0, 0) == DR_AGG_SUCCESS;
}

test partial_result_only_when_declared {
    // Partials not declared: every child must have reported.
    assert dr_partial_ok(false, 2, 2) == true;
    assert dr_partial_ok(false, 1, 2) == false;
    // Partials declared: at least one report is enough, never more than exist.
    assert dr_partial_ok(true, 1, 2) == true;
    assert dr_partial_ok(true, 0, 2) == false;
    assert dr_partial_ok(true, 3, 2) == false;
}

test root_cancel_reaches_exactly_the_running {
    assert dr_root_cancel_reaches(2) == 2;
    assert dr_root_cancel_reaches(0) == 0;
    // The children the cancel reaches go through the engine's own cancel rules.
    assert dr_cancel_ok(1) == true;    // RUNNING cancels
    assert dr_cancel_ok(4) == false;   // a settled sibling is untouched
}

test branch_retry_leaves_siblings_alone {
    // A failed branch of task 9 retries as attempt 3; the sibling's attempt 2 stands.
    const failed : u64 = tt_attempt_id(9, 2);
    assert dr_branch_retry_ok(failed, 3) == true;
    assert dr_branch_retry_ok(failed, 2) == false;   // attempt numbers only grow
    // A retry never crosses tasks.
    assert dr_restart_ok(tt_attempt_id(9, 2), 3) == true;
}

test late_result_of_old_attempt_does_not_attach {
    // Task 5 reworked: attempt 1 was reworked into attempt 2. Attempt 1's result arriving
    // now must not attach to attempt 2.
    const old_aid : u64 = tt_attempt_id(5, 1);
    const current : u64 = tt_attempt_id(5, 2);
    assert dr_late_binds(old_aid, current) == false;
    // The current attempt's own result does bind.
    assert dr_late_binds(current, current) == true;
    // Even a redelivery of the OLD attempt's already-owned result stays refused twice
    // over: wrong attempt (above) and the attempt is already past RESULT_RETURNED.
    assert dr_redelivery_refused(3) == true;
}

test parent_closes_the_root_explicitly {
    // The parent's word closes the root with running children; the children cancel.
    assert dr_root_close_ok(2) == true;
    assert dr_root_close_ok(0) == true;
    assert dr_root_close_ok(DR_MAX_CHILDREN) == true;
    assert dr_root_close_ok(DR_MAX_CHILDREN + 1) == false;   // bookkeeping sanity
}

invariant aggregation_any_fails_only_when_nothing_can_succeed {
    // ANY closes failed only when every child is settled and none succeeded.
    assert dr_aggregate(DR_AGG_ANY, 0, 1, 0) == DR_AGG_FAILED;
    assert dr_aggregate(DR_AGG_ANY, 0, 0, 1) == DR_AGG_RUNNING;
}

invariant late_results_bind_to_their_own_attempt {
    // An attempt id carries its task and number; a result binds only to the exact id.
    assert dr_late_binds(tt_attempt_id(5, 1), tt_attempt_id(5, 2)) == false;
    assert dr_late_binds(tt_attempt_id(5, 2), tt_attempt_id(5, 2)) == true;
}

; --- 9. Spawn gate: design record (PREPARED, NOT APPLIED) --------------------------------------------
; Owner decision pending: nothing here is wired. The protected file stays untouched until
; the owner approves the exception request. What is recorded below is the mapping against
; the EXISTING pane spawn path -- the gate REUSES it with an adapter; no parallel
; "delegation spawn" path is created.
; MAP (owner order, checked before any diff was written):
;   - A spawn entry ALREADY EXISTS: specs/t27os/pty_server.t27 OP_SPAWN (and the T27OS_CTL
;     spawn verb over the same code). It parses agent + cwd from the payload
;     (pty_logic.t27 spawn_cwd_len), builds the argv with launch_command(agent, plan, sid,
;     model, home, cwd, out), forks with pty_sys.t27 sys_forkpty, execs with sys_execv,
;     and answers spawn_ok (pty_proto.t27). The pane side is term_pane.t27 -> pty_client.t27
;     client_spawn. Kill is OP_KILL; list is OP_LIST (pane ids, live flags).
;   - The one lifecycle chain is therefore already present end to end:
;     provider (agents.t27 AGENT_BINS + key) -> allowed workspace (cwd from the payload)
;     -> task/attempt (this spec's aid) -> launch (OP_SPAWN) -> messages/tools (the pane's
;     own stream) -> result (M_RESULT, section 2) -> parent accept (section 3).
;     Provider differences stay adapters on AGENT_BINS entries, exactly as the editor pane
;     already adapts T27OS_AGENT=9.
; PACKAGE (decision-grade, for the owner):
;   - Protected file: specs/t27os/pty_server.t27, base SHA 32040f0135 (master, last commit
;     touching it: "t27os: fail over on a 402 screen row...", parent 7fb6bc2391).
;   - Minimal diff: one adapter in the OP_SPAWN handler -- before launch(), call into the
;     delegation gate (delegate_runtime.t27 dr_admit + actors.t27 call_admit, generated
;     card, not hand-written) with the requested scope mask and budget carried in two new
;     optional fields of the spawn payload; on DR_ADMIT_OK proceed exactly as today; on
;     refusal answer a new pty_proto tag OP_SPAWN_REFUSED (no process is ever forked).
;     Everything else in the file is unchanged: same fork, same argv, same scrollback.
;   - Executable and argv: UNCHANGED -- pty_logic.t27 launch_command output for the
;     requested AGENT_BINS entry; no new binary, no new flags.
;   - Workspace and environment: UNCHANGED -- cwd from the spawn payload (spawn_cwd_len),
;     environment from the pane's profile exactly as the OP_SPAWN handler sets it today
;     (pty_server.t27 child-side profile variables, pty_logic launch_command).
;   - Gate checks IN ORDER, all before fork: (1) call_admit(chain, depth, callee_slot)
;     == CALL_PENDING -- actors.t27 owns the depth law; (2) dr_admit(child_scope,
;     parent_scope, live_children, budget_words) == DR_ADMIT_OK -- scope subset, child
;     ceiling, budget; (3) budget metering: the words are charged to the parent on spawn_ok
;     and released on OP_KILL or child exit; a charge past DR_BUDGET_WORDS refuses.
;   - Refusal / cancel / exit: refusal answers OP_SPAWN_REFUSED and charges nothing;
;     cancel is the existing OP_KILL plus dr_cancel_ok on the attempt (section 4); exit
;     follows the pane's existing exit handling and ends with a result via section 2's
;     delivery path.
;   - Binding to task/session/attempt: the spawn payload already carries the sid stream
;     (session_store sid, task_tree tt_sid_linked); the adapter adds aid = tt_attempt_id
;     (task, attempt) to the same payload, and the pane id returned by spawn_ok is stored
;     beside aid so every later message, kill and result names both.
;   - Proving tests (in this spec, before the diff lands): admission -- legal subset +
;     free slot + fitting budget admits (existing test spawn_admits_only_inside_parent_
;     scope); refusal -- out-of-scope bit, full parent, over-budget (existing test spawn_
;     refusals...); depth -- call_admit CALL_CYCLE/CALL_TOO_DEEP before dr_admit; late
;     result binding -- late_result_of_old_attempt_does_not_attach; cancel of a launched
;     child -- cancel_reaches_a_running_child_and_is_idempotent.
;   - What this record deliberately does NOT do: no code in this file calls the host, no
;     executable call exists anywhere here, and pty_server.t27 is not edited. The diff is
;     applied only on the owner's approval of the exception request.

; --- 10. Wall-timer budget ---------------------------------------------------------------------------
; A delegation spawn carries a wall-clock budget in seconds beside the memory budget. The
; law: a spawn without a wall is refused by default, unless the command is echo-grade --
; a trivial, side-effect-free probe (the /bin/echo class) that cannot hang a parent. Expiry
; of the wall cancels exactly the running child and releases its budget words and slot.
; STATE-MACHINE-ONLY: the functions below decide; the kill itself is the host's existing
; OP_KILL path (section 9 enforcement line), which nothing here calls.

/// Echo grade: a spawn may omit its wall only when it is trivial and side-effect-free.
pub const DR_ECHO_GRADE : u8 = 1;
pub const DR_AGENT_GRADE : u8 = 2;

pub const DR_ADMIT_WALL : u8 = 4;   // refused: no wall for a command that can hang

/// Admission with the wall field. The old dr_admit checks stand unchanged and first; the
/// wall is checked last: a non-echo-grade spawn with wall 0 is refused.
pub fn dr_admit_wall(grade: u8, child_scope: u64, parent_scope: u64, live_children: u32,
                     budget_words: u64, wall_s: u64) -> u8 {
    const a : u8 = dr_admit(child_scope, parent_scope, live_children, budget_words);
    if (a != DR_ADMIT_OK) { return a; }
    if (wall_s == 0 and grade != DR_ECHO_GRADE) { return DR_ADMIT_WALL; }
    return DR_ADMIT_OK;
}

/// The wall has expired when the child has run past its seconds. Only a RUNNING attempt
/// can expire; a settled attempt has nothing left to kill.
pub fn dr_wall_expired(state: u8, wall_s: u64, elapsed_s: u64) -> bool {
    if (state != 1) { return false; }   // TT_RUNNING, by value
    return elapsed_s > wall_s;
}

/// What expiry does: the same cancel the parent could have asked for, then the release.
/// The engine's cancel rules apply unchanged (only RUNNING cancels; settled untouched).
pub fn dr_expiry_cancels(state: u8) -> bool {
    return dr_cancel_ok(state);
}

/// Budget release: the words charged at spawn come back, capped at what was charged --
/// a release never mints budget.
pub const DR_BUDGET_RELEASED : u8 = 1;
pub const DR_BUDGET_NOT_HELD : u8 = 0;

pub fn dr_release(held_words: u64, charged_words: u64) -> u64 {
    if (held_words < charged_words) { return held_words; }
    return held_words - charged_words;
}

test wall_budget_default_refusal_and_echo_grade {
    // A real agent-grade spawn without a wall is refused.
    assert dr_admit_wall(DR_AGENT_GRADE, 0b0001, 0b0001, 0, DR_BUDGET_WORDS, 0) == DR_ADMIT_WALL;
    // Echo grade may omit the wall: a trivial probe cannot hang a parent.
    assert dr_admit_wall(DR_ECHO_GRADE, 0b0001, 0b0001, 0, DR_BUDGET_WORDS, 0) == DR_ADMIT_OK;
    // With a wall set, both grades admit on the same scope/slot/budget rules as before.
    assert dr_admit_wall(DR_AGENT_GRADE, 0b0001, 0b0001, 0, DR_BUDGET_WORDS, 60) == DR_ADMIT_OK;
    // The earlier refusals still win: the wall is checked after scope, slot and budget.
    assert dr_admit_wall(DR_AGENT_GRADE, 0b1000, 0b0001, 0, DR_BUDGET_WORDS, 0) == DR_ADMIT_SCOPE;
}

test wall_expiry_cancels_exactly_the_running_child {
    // Expiry is a RUNNING-only fact: past the wall, running expires, settled cannot.
    assert dr_wall_expired(1, 60, 61) == true;
    assert dr_wall_expired(1, 60, 60) == false;   // at the wall, not past it
    assert dr_wall_expired(4, 60, 999) == false;  // ACCEPTED: nothing left to kill
    // Expiry cancels through the engine's own rules: the running child, not a sibling.
    assert dr_expiry_cancels(1) == true;
    assert dr_expiry_cancels(4) == false;
    assert dr_expiry_cancels(5) == false;
}

test wall_release_frees_the_slot_budget {
    // The child's words come back; a release never exceeds the charge.
    assert dr_release(100, 40) == 60;
    assert dr_release(40, 100) == 40;   // cannot release more than was held
    // The freed slot is a plain counter: one expired child frees exactly one place.
    assert dr_root_cancel_reaches(1) == 1;
}

invariant the_wall_is_a_default_refusal {
    // An agent-grade spawn without a wall never admits; echo grade is the only exception.
    assert dr_admit_wall(DR_AGENT_GRADE, 0, 0, 0, DR_BUDGET_WORDS, 0) == DR_ADMIT_WALL;
    assert dr_admit_wall(DR_ECHO_GRADE, 0, 0, 0, DR_BUDGET_WORDS, 0) == DR_ADMIT_OK;
}

; --- 11. Network and secrets isolation (design law) --------------------------------------------------
; A delegation child is NOT the parent: it gets no provider credentials and no network
; unless the spawn request explicitly carries the net-allowed bit. Default DENIED. What
; .t27 can pin is stated as law here; what only the host can enforce is marked HOST-ONLY
; -- and stays in the pending protected diff (section 9) for the owner.
; PINNED AS LAW (this file, testable):
pub const DR_NET_ALLOWED : u8 = 1;   // the request bit, explicitly set
pub const DR_NET_DENIED : u8 = 0;    // the default for every delegation spawn

/// A spawn's network right is exactly the bit the request carried; absence means denied.
pub fn dr_net_right(requested_bit: u8) -> u8 {
    if (requested_bit == DR_NET_ALLOWED) { return DR_NET_ALLOWED; }
    return DR_NET_DENIED;
}

/// A denied child cannot receive provider credentials: the credential grant is legal
/// only for a net-allowed child, and only within the parent's own scope.
pub fn dr_credentials_ok(net: u8, child_scope: u64, parent_scope: u64) -> bool {
    if (net != DR_NET_ALLOWED) { return false; }
    return tt_scope_subset(child_scope, parent_scope);
}

/// HOST-ONLY (NOT enforceable in .t27, honest boundary): the actual environment scrub
/// -- which variables launch_command carries per AGENT_BINS entry at fork, and that
/// provider credential variables are ABSENT for a denied spawn -- happens only in the
/// host's env construction inside the protected OP_SPAWN diff. The law above pins the
/// decision (the bit, the refusal, the tests); the host pins the mechanism. A denied
/// child whose environment still carried a credential would be a HOST DEFECT, not a
/// law gap, and would be filed against the diff, not this spec.

test network_is_denied_by_default {
    // No bit, or any value but the allowed bit: denied.
    assert dr_net_right(DR_NET_DENIED) == DR_NET_DENIED;
    assert dr_net_right(7) == DR_NET_DENIED;
    assert dr_net_right(DR_NET_ALLOWED) == DR_NET_ALLOWED;
}

test credentials_reach_only_net_allowed_children {
    // A denied child can never be granted provider credentials.
    assert dr_credentials_ok(DR_NET_DENIED, 0b1111, 0b1111) == false;
    // An allowed child gets credentials only inside the parent's own scope.
    assert dr_credentials_ok(DR_NET_ALLOWED, 0b0011, 0b0111) == true;
    assert dr_credentials_ok(DR_NET_ALLOWED, 0b1000, 0b0111) == false;
}

invariant delegation_spawns_default_to_no_network {
    // The bit must be explicitly carried; everything else denies.
    assert dr_net_right(DR_NET_ALLOWED) == DR_NET_ALLOWED;
    assert dr_credentials_ok(dr_net_right(0), 0b1111, 0b1111) == false;
}

; --- 12. Host-boundary proof (owner refinement) -------------------------------------------------------
; The owner asked the package to SHOW, not declare, four things. What .t27 can pin is law
; below; the rest is stated plainly as a host boundary and stays in the pending diff.
; (1) WHO denies network and secret reads. Env scrub alone blocks nothing: an agent that
; ignores its environment would still open sockets. The named mechanism in the pending
; diff is the host fork path wrapping the child in a seatbelt profile (macOS sandbox-exec,
; (deny network*) plus (deny file-read* <credential paths>)) launched instead of the bare
; execv, so the KERNEL denies the socket and the file read, not a variable's absence.
; PLAINLY STATED: process-level network denial is NOT achievable inside .t27; if the host
; cannot enable the seatbelt wrap (sandbox-exec unavailable or profile install fails),
; the refusal-when-unenforceable rule applies and the spawn is REFUSED, never proceeded
; on the declarative bit alone. That rule is law here:
pub const DR_ENFORCE_SEATBELT : u8 = 1;   // the host reports the wrap is in place
pub const DR_ENFORCE_NONE : u8 = 0;       // the host cannot restrict the child

/// A net-allowed spawn is legal only when the host can actually enforce the denial of
/// nothing-less: an allowed spawn WITHOUT a working restriction wrapper is refused. A
/// fully denied spawn needs no wrapper (it gets no credentials to protect).
pub fn dr_spawn_allowed(net: u8, enforce: u8) -> bool {
    if (net == DR_NET_DENIED) { return true; }
    return enforce == DR_ENFORCE_SEATBELT;
}

test spawn_refuses_when_restriction_cannot_be_enabled {
    // Allowed to network with no working wrapper: REFUSED, the flag alone is not trust.
    assert dr_spawn_allowed(DR_NET_ALLOWED, DR_ENFORCE_NONE) == false;
    assert dr_spawn_allowed(DR_NET_ALLOWED, DR_ENFORCE_SEATBELT) == true;
    // A denied child is spawnable with or without the wrapper: it holds no credentials.
    assert dr_spawn_allowed(DR_NET_DENIED, DR_ENFORCE_NONE) == true;
    assert dr_spawn_allowed(DR_NET_DENIED, DR_ENFORCE_SEATBELT) == true;
}

invariant the_net_bit_alone_never_authorizes {
    // An allowed spawn with an unenforceable host is refused; declarative trust is no trust.
    assert dr_spawn_allowed(DR_NET_ALLOWED, DR_ENFORCE_NONE) == false;
    assert dr_credentials_ok(DR_NET_ALLOWED, 0b0011, 0b0111) == true;
}

; (2) is the refusal law above: dr_spawn_allowed refuses the net-allowed spawn when the
; restriction cannot be enabled.
; (3) WALL-TIMEOUT SCOPE, pinned: the expiry kill hits the WHOLE PROCESS GROUP owned by
; the attempt, not only the direct child -- a forkpty child is its own session leader
; (pty_sys.t27 sys_forkpty detaches the tty), so its descendants share its process group;
; the kill is the negative-pid form (kill -pgid) through the existing OP_KILL path, and
; OTHER processes are untouched: any pane whose process group is not the attempt's is not
; signalled, which the pane id binding (section 9) makes a one-compare check. Pinned as
; law so the host diff cannot widen it:
pub const DR_KILL_SCOPE_GROUP : u8 = 1;   // the attempt's process group only

/// The kill reaches a process exactly when it belongs to the attempt's own group.
pub fn dr_kill_hits(pgid: u64, attempt_pgid: u64) -> bool {
    return pgid == attempt_pgid;
}

test wall_kill_hits_the_attempt_group_only {
    // The attempt's group dies; a sibling pane's group is untouched.
    assert dr_kill_hits(4242, 4242) == true;
    assert dr_kill_hits(4243, 4242) == false;
    // The engine still cancels through its own rules: exactly the running child.
    assert dr_expiry_cancels(1) == true;
    assert dr_expiry_cancels(4) == false;
}

; (4) PROOF METHOD: the checks run in a permitted isolated environment -- t27b against
; this worktree's specs (behavior verdicts, never the shared runtime), plus the future
; live probe only inside a dedicated throwaway T27 OS pane owned by the test, never a
; shared or production pane. Nothing here runs until the owner re-approves the probe.
; ATTRIBUTION CORRECTION (recorded as ordered): the spawn-probe deferral stands on the
; OWNER'S EXPLICIT SELECTION in the confirmation request (spawn_probe_v1, verdict
; "close the gaps first") -- an owner order, not a coordinator choice.
