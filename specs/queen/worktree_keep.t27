// SPDX-License-Identifier: Apache-2.0
; specs/queen/worktree_keep.t27 -- when a bee worktree may be released, and when a failed request is retried
; gHashTag/trios#2005 (bee stability, 2026-10-14). Measured before this card (gHashTag/trios, agent-server):
; - docker-entrypoint.sh ran `rm -rf .worktrees/*` on every boot, on the reading that no bee runs at
;   that time. A worktree holds staged, unstaged, untracked and ignored files, local commits and its
;   admin record; the bundle stored at drain (queen-export.ts bundleOfBranch) carries commits only.
; - overload-retry-fetch.ts treated a TimeoutError as an abort the caller asked for, so a hung socket
;   ended the turn instead of using the existing retry budget.
; - queen-runner.ts claimed again through setImmediate when a claimed order could not start, which spun
;   on one refusal (a blocked resource).
; Rule of this card: the default is KEEP. A worktree is released only on positive proof of every
; condition; any unknown holds it. A retry is allowed only before a byte reached the caller.
; Standalone on purpose: no imports, so it builds to one unit with nothing to resolve.
; - the disk reaper counted a tree with only ignored files as clean (`git status --porcelain` omits them).
; - a request diagnostic would have echoed role, part type, model and error code strings from the request.
; Not here: the archive, the hashing, the process table, the fetch (the runtime, gHashTag/trios).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenWorktreeKeep;

; --- 1. Worktree verdicts -----------------------------------------------------------------------------

/// WT_KEEP: leave every byte where it is. WT_RELEASE: every condition below is proven.
pub const WT_KEEP : u8 = 0;
pub const WT_RELEASE : u8 = 1;

/// Facts are u8 states, never booleans, so that "not read" has a value of its own.
/// ST_NO: proven false. ST_YES: proven true. ST_UNKNOWN: not read, or the read failed.
pub const ST_NO : u8 = 0;
pub const ST_YES : u8 = 1;
pub const ST_UNKNOWN : u8 = 2;

/// A worktree may be released only when all of these hold at once:
/// - its owner is known (ST_YES) and no task lease on it is active (ST_NO);
/// - no live process has it as its working directory (ST_NO);
/// - its tree is clean, ignored files included, and no commit on it is missing elsewhere (ST_NO dirty);
/// - a byte-hash manifest of the source matched a manifest of the restored archive (ST_YES verified).
/// Anything else, an unknown above all, is WT_KEEP.
pub fn worktree_verdict(owner_known: u8, lease_active: u8, writer_alive: u8, dirty: u8, archive_verified: u8) -> u8 {
    if (owner_known != ST_YES) { return WT_KEEP; }
    if (lease_active != ST_NO) { return WT_KEEP; }
    if (writer_alive != ST_NO) { return WT_KEEP; }
    if (dirty != ST_NO) { return WT_KEEP; }
    if (archive_verified != ST_YES) { return WT_KEEP; }
    return WT_RELEASE;
}

/// What startup does with the worktrees of a previous container: nothing is released at boot, whatever
/// the facts say. Release is a separate, later act that asks worktree_verdict.
pub fn boot_releases(entries: u32) -> bool {
    return false;
}

; --- 2. Retry verdicts --------------------------------------------------------------------------------

/// The kinds of failure a request can end in.
/// EK_ABORT: an AbortError. EK_TIMEOUT: a TimeoutError from the transport. EK_OTHER: anything else thrown.
pub const EK_ABORT : u8 = 0;
pub const EK_TIMEOUT : u8 = 1;
pub const EK_OTHER : u8 = 2;

/// RV_RETHROW: the error goes to the caller now. RV_RETRY: the request is made again after its backoff.
pub const RV_RETHROW : u8 = 0;
pub const RV_RETRY : u8 = 1;

/// A failure is retried when the caller did not cancel, it was not an abort, no byte of the answer was
/// handed to the caller (a delivered byte may already have run a tool), and an attempt is left.
pub fn retry_verdict(caller_aborted: bool, kind: u8, delivered_bytes: u32, attempt: u32, max_attempts: u32) -> u8 {
    if (caller_aborted) { return RV_RETHROW; }
    if (kind == EK_ABORT) { return RV_RETHROW; }
    if (delivered_bytes > 0) { return RV_RETHROW; }
    if (attempt >= max_attempts) { return RV_RETHROW; }
    return RV_RETRY;
}

; --- 3. Claiming again --------------------------------------------------------------------------------

/// A runner that claimed an order and could not start it asks again at the next poll, not at once.
pub fn claims_again_at_once(started: bool) -> bool {
    return started;
}

; --- 4. The reaper under disk pressure ----------------------------------------------------------------

/// The disk reaper (queen-dispatch.ts reapWorktrees) may remove a tree only when the facts say it holds
/// nothing of anyone's: no bee runs in it, it is clean with IGNORED files counted (an ignored file is
/// still a user's file), no commit on it is missing elsewhere, and its state was read. Unknown holds.
/// When every tree is held the reaper stops and the disk guard cools down; it never wipes data.
pub fn reap_verdict(running: u8, dirty_with_ignored: u8, unpushed: u8, read_ok: u8) -> u8 {
    if (read_ok != ST_YES) { return WT_KEEP; }
    if (running != ST_NO) { return WT_KEEP; }
    if (dirty_with_ignored != ST_NO) { return WT_KEEP; }
    if (unpushed != ST_NO) { return WT_KEEP; }
    return WT_RELEASE;
}

; --- 5. What a diagnostic may say about a request -----------------------------------------------------

/// A diagnostic of a request names its parts from these closed sets and counts them under these bounds.
/// Whatever the request holds outside them is ROLE_UNKNOWN or PART_UNKNOWN: text from a request is never
/// copied into a log. The model name is not reported at all.
pub const ROLE_SYSTEM : u8 = 0;
pub const ROLE_USER : u8 = 1;
pub const ROLE_ASSISTANT : u8 = 2;
pub const ROLE_TOOL : u8 = 3;
pub const ROLE_UNKNOWN : u8 = 4;

pub const PART_TEXT : u8 = 0;
pub const PART_IMAGE : u8 = 1;
pub const PART_TOOL_CALL : u8 = 2;
pub const PART_TOOL_RESULT : u8 = 3;
pub const PART_REASONING : u8 = 4;
pub const PART_EMPTY : u8 = 5;
pub const PART_UNKNOWN : u8 = 6;

/// The most messages listed one by one, and the largest count reported.
pub const SHAPE_MAX_SEQUENCE : u32 = 200;
pub const SHAPE_MAX_COUNT : u32 = 100000;

/// The longest provider code reported. A code is digits only; anything else is not reported.
pub const CODE_MAX_LEN : u32 = 12;

pub fn shape_count(n: u32) -> u32 {
    if (n > SHAPE_MAX_COUNT) { return SHAPE_MAX_COUNT; }
    return n;
}

pub fn code_reportable(length: u32, all_digits: bool) -> bool {
    if (all_digits == false) { return false; }
    if (length == 0) { return false; }
    return length <= CODE_MAX_LEN;
}

; --- 6. The night loop's lane sweep (Trinity-S-AI-DNA/t27os#8) -----------------------------------------

/// The night loop sweeps its own lane worktrees each tick with the reaper's proofs plus one of its own:
/// no live swarm claim names the lane. "Merged into origin/master" is the night loop's form of "no commit
/// on it is missing elsewhere". Measured 2026-10-23: of 206 worktrees 3 were provably dead, 27 dirty.
/// A claim (refs/swarm/claims/<N>) older than CLAIM_STALE_S is presumed abandoned, as the tick law says.
pub const CLAIM_STALE_S : u32 = 7200;

/// The negation of a read fact; an unknown stays unknown.
pub fn st_not(s: u8) -> u8 {
    if (s == ST_YES) { return ST_NO; }
    if (s == ST_NO) { return ST_YES; }
    return ST_UNKNOWN;
}

/// Whether a claim holds its lane: none read (ST_NO), one younger than CLAIM_STALE_S (ST_YES), one older
/// (ST_NO, stale), or the claim refs could not be read (ST_UNKNOWN).
pub fn claim_live(exists: u8, age_s: u32) -> u8 {
    if (exists == ST_NO) { return ST_NO; }
    if (exists != ST_YES) { return ST_UNKNOWN; }
    if (age_s >= CLAIM_STALE_S) { return ST_NO; }
    return ST_YES;
}

/// A lane is released only when the reaper would release it with "merged" standing for "nothing
/// unpushed", and no live claim names it. Anything unknown keeps it.
pub fn lane_sweep_verdict(running: u8, dirty_with_ignored: u8, merged: u8, claim: u8, read_ok: u8) -> u8 {
    if (claim != ST_NO) { return WT_KEEP; }
    return reap_verdict(running, dirty_with_ignored, st_not(merged), read_ok);
}

/// Night tick 8, 2026-10-23: two actors shared one checkout and a commit landed on the other actor's
/// branch. A tick commits or pushes only when HEAD was read to be its own lane branch.
pub fn commit_allowed(head_is_lane: u8) -> bool {
    return head_is_lane == ST_YES;
}

; --- tests --------------------------------------------------------------------------------------------

test the_reaper_keeps_anything_unknown_running_dirty_or_unpushed {
    assert reap_verdict(ST_NO, ST_NO, ST_NO, ST_YES) == WT_RELEASE;
    assert reap_verdict(ST_YES, ST_NO, ST_NO, ST_YES) == WT_KEEP;
    assert reap_verdict(ST_UNKNOWN, ST_NO, ST_NO, ST_YES) == WT_KEEP;
    assert reap_verdict(ST_NO, ST_YES, ST_NO, ST_YES) == WT_KEEP;
    assert reap_verdict(ST_NO, ST_UNKNOWN, ST_NO, ST_YES) == WT_KEEP;
    assert reap_verdict(ST_NO, ST_NO, ST_YES, ST_YES) == WT_KEEP;
    assert reap_verdict(ST_NO, ST_NO, ST_UNKNOWN, ST_YES) == WT_KEEP;
    assert reap_verdict(ST_NO, ST_NO, ST_NO, ST_NO) == WT_KEEP;
    assert reap_verdict(ST_NO, ST_NO, ST_NO, ST_UNKNOWN) == WT_KEEP;
}

test a_diagnostic_is_bounded {
    assert shape_count(0) == 0;
    assert shape_count(100000) == 100000;
    assert shape_count(100001) == 100000;
    assert shape_count(4294967295) == 100000;
    assert code_reportable(4, true) == true;
    assert code_reportable(12, true) == true;
    assert code_reportable(13, true) == false;
    assert code_reportable(0, true) == false;
    assert code_reportable(4, false) == false;
}

test the_default_is_keep {
    assert worktree_verdict(ST_UNKNOWN, ST_NO, ST_NO, ST_NO, ST_YES) == WT_KEEP;
    assert worktree_verdict(ST_YES, ST_UNKNOWN, ST_NO, ST_NO, ST_YES) == WT_KEEP;
    assert worktree_verdict(ST_YES, ST_NO, ST_UNKNOWN, ST_NO, ST_YES) == WT_KEEP;
    assert worktree_verdict(ST_YES, ST_NO, ST_NO, ST_UNKNOWN, ST_YES) == WT_KEEP;
    assert worktree_verdict(ST_YES, ST_NO, ST_NO, ST_NO, ST_UNKNOWN) == WT_KEEP;
    assert worktree_verdict(ST_YES, ST_NO, ST_NO, ST_NO, ST_NO) == WT_KEEP;
}

test an_active_lease_a_live_writer_or_dirt_keeps {
    assert worktree_verdict(ST_YES, ST_YES, ST_NO, ST_NO, ST_YES) == WT_KEEP;
    assert worktree_verdict(ST_YES, ST_NO, ST_YES, ST_NO, ST_YES) == WT_KEEP;
    assert worktree_verdict(ST_YES, ST_NO, ST_NO, ST_YES, ST_YES) == WT_KEEP;
    assert worktree_verdict(ST_NO, ST_NO, ST_NO, ST_NO, ST_YES) == WT_KEEP;
}

test only_full_proof_releases {
    assert worktree_verdict(ST_YES, ST_NO, ST_NO, ST_NO, ST_YES) == WT_RELEASE;
}

test boot_never_releases {
    assert boot_releases(0) == false;
    assert boot_releases(1) == false;
    assert boot_releases(41) == false;
}

test a_transport_timeout_with_a_live_caller_is_retried {
    assert retry_verdict(false, EK_TIMEOUT, 0, 1, 7) == RV_RETRY;
    assert retry_verdict(false, EK_OTHER, 0, 6, 7) == RV_RETRY;
}

test a_caller_abort_is_thrown_at_once {
    assert retry_verdict(true, EK_TIMEOUT, 0, 1, 7) == RV_RETHROW;
    assert retry_verdict(true, EK_ABORT, 0, 1, 7) == RV_RETHROW;
    assert retry_verdict(false, EK_ABORT, 0, 1, 7) == RV_RETHROW;
}

test a_delivered_byte_is_never_retried {
    assert retry_verdict(false, EK_TIMEOUT, 1, 1, 7) == RV_RETHROW;
    assert retry_verdict(false, EK_OTHER, 4096, 1, 7) == RV_RETHROW;
}

test the_budget_ends_the_retries {
    assert retry_verdict(false, EK_TIMEOUT, 0, 7, 7) == RV_RETHROW;
    assert retry_verdict(false, EK_TIMEOUT, 0, 8, 7) == RV_RETHROW;
}

test an_order_that_did_not_start_waits_for_the_poll {
    assert claims_again_at_once(true) == true;
    assert claims_again_at_once(false) == false;
}

invariant the_states_and_verdicts_are_pinned {
    assert ST_NO == 0;
    assert ST_YES == 1;
    assert ST_UNKNOWN == 2;
    assert WT_KEEP == 0;
    assert WT_RELEASE == 1;
    assert EK_ABORT == 0;
    assert EK_TIMEOUT == 1;
    assert EK_OTHER == 2;
    assert RV_RETHROW == 0;
    assert RV_RETRY == 1;
}

invariant release_needs_all_five_proofs {
    assert worktree_verdict(ST_YES, ST_NO, ST_NO, ST_NO, ST_YES) == WT_RELEASE;
    assert worktree_verdict(ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN) == WT_KEEP;
}

invariant the_diagnostic_sets_are_pinned {
    assert ROLE_SYSTEM == 0;
    assert ROLE_UNKNOWN == 4;
    assert PART_TEXT == 0;
    assert PART_UNKNOWN == 6;
    assert SHAPE_MAX_SEQUENCE == 200;
    assert SHAPE_MAX_COUNT == 100000;
    assert CODE_MAX_LEN == 12;
}

invariant a_reaper_release_needs_four_proofs {
    assert reap_verdict(ST_NO, ST_NO, ST_NO, ST_YES) == WT_RELEASE;
    assert reap_verdict(ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN) == WT_KEEP;
}

invariant no_retry_after_delivery_or_cancel {
    assert retry_verdict(false, EK_TIMEOUT, 1, 1, 7) == RV_RETHROW;
    assert retry_verdict(true, EK_TIMEOUT, 0, 1, 7) == RV_RETHROW;
}

test a_merged_clean_unclaimed_lane_is_released {
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_YES, ST_NO, ST_YES) == WT_RELEASE;
}

test an_unmerged_dirty_claimed_or_unread_lane_is_kept {
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_NO, ST_NO, ST_YES) == WT_KEEP;
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_UNKNOWN, ST_NO, ST_YES) == WT_KEEP;
    assert lane_sweep_verdict(ST_NO, ST_YES, ST_YES, ST_NO, ST_YES) == WT_KEEP;
    assert lane_sweep_verdict(ST_YES, ST_NO, ST_YES, ST_NO, ST_YES) == WT_KEEP;
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_YES, ST_YES, ST_YES) == WT_KEEP;
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_YES, ST_UNKNOWN, ST_YES) == WT_KEEP;
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_YES, ST_NO, ST_UNKNOWN) == WT_KEEP;
}

test a_claim_older_than_two_hours_is_stale {
    assert claim_live(ST_NO, 0) == ST_NO;
    assert claim_live(ST_YES, 0) == ST_YES;
    assert claim_live(ST_YES, 7199) == ST_YES;
    assert claim_live(ST_YES, 7200) == ST_NO;
    assert claim_live(ST_UNKNOWN, 0) == ST_UNKNOWN;
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_YES, claim_live(ST_YES, 9000), ST_YES) == WT_RELEASE;
    assert lane_sweep_verdict(ST_NO, ST_NO, ST_YES, claim_live(ST_YES, 60), ST_YES) == WT_KEEP;
}

test negation_keeps_unknown {
    assert st_not(ST_YES) == ST_NO;
    assert st_not(ST_NO) == ST_YES;
    assert st_not(ST_UNKNOWN) == ST_UNKNOWN;
}

test a_tick_commits_only_on_its_own_branch {
    assert commit_allowed(ST_YES) == true;
    assert commit_allowed(ST_NO) == false;
    assert commit_allowed(ST_UNKNOWN) == false;
}

invariant a_lane_release_needs_the_reaper_and_no_claim {
    assert CLAIM_STALE_S == 7200;
    assert lane_sweep_verdict(ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN, ST_UNKNOWN) == WT_KEEP;
}
