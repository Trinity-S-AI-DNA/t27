// SPDX-License-Identifier: Apache-2.0
; specs/queen/self_health.t27 -- the Queen's doctor: a prescription for every file-conflict jam, and the
; tick-level anomaly that says she is starved by them. Closes gHashTag/t27#9094 (part of #9022).
; Owner, 2026-10-11 (translated): "is anyone treating this? we need a doctor bee! 214 tasks stand on file
; conflicts."
; Measured 2026-10-11T13:04Z at the live Queen (/queen/status): 19 of 70 lanes busy, and the round skipped
; fileConflict 214, claimed 99, missingBoundary 79. Every cause found that day was found by a person
; reading replays, not by the Queen:
; - a closed issue's dispatch still held bootstrap/src/compiler.rs and alone shut out 122 candidates
;   (t27#8660; holds.t27 now answers it, trios#1880);
; - seals and the t27b ledger counted as shared files (derived_data.t27 now classes them);
; - whole-file Boundaries on compiler.rs, 46,748 lines, where the edits name different functions.
; --
; The doctor reads one held path at a time: the holder's dispatch, the path, and how many candidates that
; holder alone shuts out on it. It decides nothing that another card already decides:
; - whether the holder still holds is queen/holds.t27 holds_files_now (closed issue, no Boundary, stage
;   and minutes);
; - whether the path is a derived record is ci/derived_data.t27 is_derived_path;
; - whether two regions meet, and whether a diff stays inside its regions, are queen/actors.t27 edits_meet
;   and the merge-side check of the region work (t27#9062). NARROW only names the treatment: the host
;   writes the `- path :: fn NAME` lines (policy/issue_shape.t27 resolves them), and admission stays in
;   the batch chooser.
; Its own rules are two: which treatment, and which jam first (the biggest one).
; Wiring is the Queen runtime's: every tick she runs prescribe() over her dispatch rows, applies RELEASE
; and DERIVED_FREE, writes NARROW Boundaries once the region check is live, and files SPLIT as an issue.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenSelfHealth;

use queen::holds;
use ci::derived_data;

; --- 1. Prescriptions --------------------------------------------------------------------------------

/// WAIT: nothing to treat; a true overlap, or a path too cold to be worth a change.
/// RELEASE: the holder no longer holds by holds.t27; the Queen must stop counting the hold.
/// DERIVED_FREE: the path is a derived record; it is never a conflict (golden_chain.t27 REGEN).
/// NARROW: turn whole-file Boundaries on this hot path into `:: fn` regions.
/// NARROW_WAITS_CHECK: NARROW would apply, but the merge-side region check is not live yet, so a
/// region Boundary would be trusted with nothing to verify it. Reported, not applied.
/// SPLIT: a hot path that no side can narrow; file a port of that file into .t27.
pub const RX_WAIT : u8 = 0;
pub const RX_RELEASE : u8 = 1;
pub const RX_DERIVED_FREE : u8 = 2;
pub const RX_NARROW : u8 = 3;
pub const RX_NARROW_WAITS_CHECK : u8 = 4;
pub const RX_SPLIT : u8 = 5;

/// A path is hot when its holder alone shuts out this many candidates. Chosen, not measured: one shut-out
/// candidate is ordinary queueing; three on one path is a pattern a Boundary change pays for.
pub const HOT_BLOCKED : u32 = 3;

/// The treatment for one held path.
/// `path`, `n`: the held path as the Boundary wrote it.
/// `known`, `issue_open`, `has_boundary`, `stage`, `minutes`: the holder, as holds_files_now reads it.
/// `holder_whole`: the holder's Boundary names the whole file, not a region.
/// `holder_fns`: functions of that file the holder's issue names that resolve to one definition.
/// `blocked`: candidates this holder alone shuts out on this path.
/// `blocked_nameable`: of those, candidates whose issues name resolvable functions of the file.
/// `region_check_live`: the merge-side check that a diff stays inside its regions is running.
pub fn prescribe(path: []const u8, n: usize, known: bool, issue_open: bool, has_boundary: bool, stage: u8, minutes: u32, holder_whole: bool, holder_fns: u32, blocked: u32, blocked_nameable: u32, region_check_live: bool) -> u8 {
    if (holds_files_now(known, issue_open, has_boundary, stage, minutes) == false) {
        return RX_RELEASE;
    }
    if (is_derived_path(path, n)) {
        return RX_DERIVED_FREE;
    }
    if (blocked < HOT_BLOCKED) {
        return RX_WAIT;
    }
    var narrowable : bool = (holder_whole and holder_fns > 0) or blocked_nameable > 0;
    if (narrowable) {
        if (region_check_live) {
            return RX_NARROW;
        }
        return RX_NARROW_WAITS_CHECK;
    }
    if (holder_whole) {
        return RX_SPLIT;
    }
    return RX_WAIT;
}

/// Whether a prescription changes anything now. NARROW_WAITS_CHECK and WAIT are reports.
pub fn acts_now(rx: u8) -> bool {
    return rx == RX_RELEASE or rx == RX_DERIVED_FREE or rx == RX_NARROW or rx == RX_SPLIT;
}

; --- 2. Which jam first ------------------------------------------------------------------------------

/// Treat a before b: the one that shuts out more candidates; on a tie, the smaller path hash, so two
/// doctors reading the same rows choose the same order.
pub fn treat_before(blocked_a: u32, hash_a: u64, blocked_b: u32, hash_b: u64) -> bool {
    if (blocked_a != blocked_b) {
        return blocked_a > blocked_b;
    }
    return hash_a < hash_b;
}

; --- 3. The tick-level anomaly -----------------------------------------------------------------------

/// Starved by conflicts: lanes are idle while more than one candidate in five is skipped as fileConflict.
/// #9022's rule. A Queen with no idle lane, or no candidates, is not starved.
pub fn conflict_starved(capacity: u32, active: u32, candidates: u32, file_conflict: u32) -> bool {
    if (active >= capacity) {
        return false;
    }
    if (candidates == 0) {
        return false;
    }
    return file_conflict * 5 > candidates;
}

; --- Tests ---------------------------------------------------------------------------------------------
; Paths: "bootstrap/src/compiler.rs" is 25 bytes; ".trinity/seals/queen_QueenHolds.json" is 36;
; "docs/reports/t27b_expectations.json" is 35.

test a_closed_issue_still_holding_is_released {
    assert prescribe("bootstrap/src/compiler.rs", 25, true, false, true, HS_WORKING, 0, true, 0, 122, 0, false) == RX_RELEASE;
}

test a_holder_whose_boundary_was_removed_is_released {
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, false, HS_WORKING, 0, true, 3, 9, 4, true) == RX_RELEASE;
}

test a_finished_holder_past_its_hold_is_released {
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, true, HS_AWAITING, AWAITING_HOLD_MINUTES + 1, true, 0, 40, 0, true) == RX_RELEASE;
}

test seals_and_the_ledger_are_never_a_conflict {
    assert prescribe(".trinity/seals/queen_QueenHolds.json", 36, true, true, true, HS_WORKING, 0, true, 0, 13, 0, false) == RX_DERIVED_FREE;
    assert prescribe("docs/reports/t27b_expectations.json", 35, true, true, true, HS_WORKING, 0, true, 0, 2, 0, false) == RX_DERIVED_FREE;
}

test a_hot_whole_file_with_named_functions_is_narrowed_once_the_check_is_live {
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, true, HS_WORKING, 0, true, 2, 121, 82, true) == RX_NARROW;
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, true, HS_WORKING, 0, true, 0, 121, 82, true) == RX_NARROW;
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, true, HS_WORKING, 0, true, 2, 5, 0, true) == RX_NARROW;
}

test negative_control_no_narrowing_before_the_region_check_is_live {
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, true, HS_WORKING, 0, true, 2, 121, 82, false) == RX_NARROW_WAITS_CHECK;
    assert acts_now(RX_NARROW_WAITS_CHECK) == false;
}

test a_hot_file_nobody_can_narrow_is_split {
    assert prescribe("scripts/tri_loop/t27b.py", 24, true, true, true, HS_WORKING, 0, true, 0, 23, 0, true) == RX_SPLIT;
    assert acts_now(RX_SPLIT);
}

test negative_control_a_cold_path_waits {
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, true, HS_WORKING, 0, true, 2, 2, 2, true) == RX_WAIT;
    assert acts_now(RX_WAIT) == false;
}

test negative_control_a_region_holder_with_nothing_nameable_waits {
    assert prescribe("bootstrap/src/compiler.rs", 25, true, true, true, HS_WORKING, 0, false, 0, 9, 0, true) == RX_WAIT;
}

test the_biggest_jam_is_treated_first_and_ties_are_stable {
    assert treat_before(122, 900, 13, 1);
    assert treat_before(13, 1, 122, 900) == false;
    assert treat_before(13, 1, 13, 2);
    assert treat_before(13, 2, 13, 1) == false;
}

test conflict_starvation_as_measured {
    assert conflict_starved(70, 19, 814, 214);
    assert conflict_starved(70, 19, 2000, 214) == false;
    assert conflict_starved(70, 70, 814, 214) == false;
    assert conflict_starved(70, 0, 0, 0) == false;
}

invariant release_and_derived_come_before_the_hot_rules {
    assert RX_RELEASE < RX_DERIVED_FREE;
    assert RX_DERIVED_FREE < RX_NARROW;
    assert RX_WAIT == 0;
}

invariant a_hot_path_needs_more_than_one_waiter {
    assert HOT_BLOCKED > 1;
}
