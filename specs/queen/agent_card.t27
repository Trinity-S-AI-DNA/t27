// SPDX-License-Identifier: Apache-2.0
; specs/queen/agent_card.t27 -- what an agent says it can do, and the contract it serves.
; gHashTag/t27#13310, order SWARM_BEST_PRACTICES (GODMODE epic #13260, actor epic #6971), 2026-11-08.
; Studied: Claude Code agent teams (a team config lists each member's name, agent id and agent type;
; teammates read it to find each other), subagent definitions (tools, disallowedTools, model), and
; ListAgents across sessions.
; Gap it closes: actors.t27 has no way for an actor to declare what it can do or which contract it
; serves, and its section 7 forbids a global name registry (GLOBAL_NAME_REGISTRY is false: the store is
; the only directory of who holds what). So a card is ONE STORE ROW keyed by pid, never a registry; a
; team's config file and ListAgents are views of those rows. A card is the project speaking about
; itself, so it is a t27 record, not an A2A JSON card: no A2A server stands behind it.
; This file edits nothing in actors.t27 or control.t27. Every decision function is on u8, u32, u64 and
; bool, so the supervisor can mirror it as it mirrors actors.t27; the two records are the store row and
; the edge row. The ring numbers are golden_chain.t27 section 7's (GC7_*, PR #13301): until that lands,
; a ring is a u8 checked against a ring count the caller passes, so no ring constant is copied here.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenAgentCard;

use queen::actors;

; --- 1. Capabilities: one bit each ------------------------------------------------------------------

/// Capability bits. Each one is a tool set an agent definition grants (Claude Code tools and
/// disallowedTools) or a resource the swarm grants (a master-built t27c, an off-Mac lab).
pub const CAP_READ : u64 = 0;
pub const CAP_EDIT : u64 = 1;
pub const CAP_RUN : u64 = 2;
pub const CAP_SUBAGENT : u64 = 3;
pub const CAP_LEAD : u64 = 4;
pub const CAP_PEER_MAIL : u64 = 5;
pub const CAP_TASKS : u64 = 6;
pub const CAP_WEB : u64 = 7;
pub const CAP_SEAL : u64 = 8;
pub const CAP_LAB : u64 = 9;
pub const CAP_COUNT : u64 = 10;

/// One capability as a mask. A typed local, as actors.t27 bit() does, so no backend widens a literal.
pub fn cap_bit(k: u64) -> u64 {
    var one : u64 = 1;
    if (k >= CAP_COUNT) { return 0; }
    return one << k;
}

/// Every known bit at once.
pub fn caps_all() -> u64 {
    var one : u64 = 1;
    return (one << CAP_COUNT) - one;
}

/// A reader drops a card that carries a bit it does not know, rather than guess what the bit grants.
pub fn caps_known(caps: u64) -> bool {
    return (caps & caps_all()) == caps;
}

/// Whether a card covers every bit a task needs.
pub fn can_serve(caps: u64, need: u64) -> bool {
    return (caps & need) == need;
}

; --- 2. Roles: solo, lead, mate -----------------------------------------------------------------

/// A solo agent is a session or a subagent outside any team. A lead is the one fixed team lead. A mate
/// is a teammate. Claude Code: one team per session, the lead never changes, teammates cannot spawn
/// teammates, and every teammate is given SendMessage and the task tools.
pub const ROLE_SOLO : u8 = 0;
pub const ROLE_LEAD : u8 = 1;
pub const ROLE_MATE : u8 = 2;
pub const ROLE_COUNT : u8 = 3;
pub const NO_TEAM : u32 = 0;

/// A card's role, team and bits agree:
/// - solo: no team (a solo agent may carry CAP_LEAD, which is the right to start a team);
/// - lead and mate: a team, and both CAP_PEER_MAIL and CAP_TASKS;
/// - lead: CAP_LEAD; mate: never CAP_LEAD (no nested teams).
pub fn card_valid(role: u8, team: u32, caps: u64) -> bool {
    if (role >= ROLE_COUNT) { return false; }
    if (caps_known(caps) == false) { return false; }
    if (role == ROLE_SOLO) { return team == NO_TEAM; }
    if (team == NO_TEAM) { return false; }
    var talk : u64 = cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS);
    if (can_serve(caps, talk) == false) { return false; }
    var lead : u64 = cap_bit(CAP_LEAD);
    if (role == ROLE_LEAD) { return can_serve(caps, lead); }
    return (caps & lead) == 0;
}

/// A card is re-published with a higher generation whenever it changes; a reader keeps the highest.
pub fn card_replaces(held_gen: u32, seen_gen: u32) -> bool {
    return seen_gen > held_gen;
}

/// A card names a pid; once that pid no longer reaches its slot's live pid (actors.t27 reaches), the
/// card is dead and a reader drops it. No second liveness rule: the pid's generation is the rule.
pub fn card_live(card_pid: u64, live_pid: u64) -> bool {
    return reaches(card_pid, live_pid);
}

; --- 3. Rings and their contracts ---------------------------------------------------------------

/// No ring: a card that serves no ring of the vertical stack.
pub const RING_NONE : u8 = 255;

pub fn ring_valid(ring: u8, ring_count: u8) -> bool {
    if (ring == RING_NONE) { return true; }
    return ring < ring_count;
}

/// Section 7 of golden_chain.t27 numbers edge e as the step from ring e to ring e + 1 (PC 0: physics
/// to compiler, ..., OK 3: orchestrator to knowledge). An edge row is valid only for that pair.
pub fn edge_joins(edge: u8, producer: u8, consumer: u8) -> bool {
    if (producer == RING_NONE) { return false; }
    if (consumer == RING_NONE) { return false; }
    if (producer != edge) { return false; }
    return consumer == producer + 1;
}

/// A contract is the low 64 bits of the seal hash of the spec a producer ring serves. The producer's
/// card carries the hash it serves now; the consumer holds the hash it last built against.
pub const NO_HASH : u64 = 0;
pub const CT_SAME : u8 = 0;
pub const CT_STALE : u8 = 1;
pub const CT_MISSING : u8 = 2;

pub fn contract_answer(served: u64, held: u64) -> u8 {
    if (served == NO_HASH) { return CT_MISSING; }
    if (held == NO_HASH) { return CT_MISSING; }
    if (served == held) { return CT_SAME; }
    return CT_STALE;
}

/// What gc7_chain_state takes for one edge: true only when the consumer built against what the
/// producer serves now. A stale edge is not a broken one; it is work for the consumer ring.
pub fn edge_holds(served: u64, held: u64) -> bool {
    return contract_answer(served, held) == CT_SAME;
}

; --- 4. The two records ---------------------------------------------------------------------------

/// The store row of one agent. Keyed by pid: there is no name index (actors.t27 section 7).
pub struct AgentCard {
    pid: u64,
    role: u8,
    team: u32,
    ring: u8,
    caps: u64,
    contract: u64,
    gen: u32,
}

/// The store row of one edge between two rings: what the producer serves and what the consumer holds.
pub struct RingContract {
    edge: u8,
    producer: u8,
    consumer: u8,
    served: u64,
    held: u64,
}

pub fn card(pid: u64, role: u8, team: u32, ring: u8, caps: u64, contract: u64, gen: u32) -> AgentCard {
    return AgentCard{.pid = pid, .role = role, .team = team, .ring = ring, .caps = caps,
        .contract = contract, .gen = gen};
}

pub fn ring_contract(edge: u8, served: u64, held: u64) -> RingContract {
    return RingContract{.edge = edge, .producer = edge, .consumer = edge + 1, .served = served,
        .held = held};
}

pub const CARD_IS_A_REGISTRY : bool = false;

; --- Invariants and tests -------------------------------------------------------------------------

invariant the_capabilities_fit_one_word { assert CAP_COUNT <= 64 and CAP_LAB + 1 == CAP_COUNT; }
invariant the_roles_are_contiguous { assert ROLE_LEAD == ROLE_SOLO + 1 and ROLE_MATE == ROLE_LEAD + 1 and ROLE_COUNT == ROLE_MATE + 1; }
invariant the_contract_answers_are_contiguous { assert CT_STALE == CT_SAME + 1 and CT_MISSING == CT_STALE + 1; }
invariant a_card_is_no_registry { assert CARD_IS_A_REGISTRY == false and GLOBAL_NAME_REGISTRY == false; }

test a_bit_past_the_known_ones_is_no_bit {
    assert cap_bit(CAP_READ) == 1;
    assert cap_bit(CAP_LAB) == 512;
    assert cap_bit(CAP_COUNT) == 0;
    assert caps_all() == 1023;
    assert caps_known(1023) == true;
    assert caps_known(1024) == false;
}

test a_card_serves_only_what_it_covers {
    var rw : u64 = cap_bit(CAP_READ) | cap_bit(CAP_EDIT);
    assert can_serve(rw, cap_bit(CAP_READ)) == true;
    assert can_serve(rw, rw) == true;
    assert can_serve(cap_bit(CAP_READ), rw) == false;
    assert can_serve(rw, 0) == true;
}

test a_mate_never_carries_the_lead_bit {
    var talk : u64 = cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS);
    var lead : u64 = talk | cap_bit(CAP_LEAD);
    assert card_valid(ROLE_MATE, 7, talk) == true;
    assert card_valid(ROLE_MATE, 7, lead) == false;
    assert card_valid(ROLE_LEAD, 7, lead) == true;
    assert card_valid(ROLE_LEAD, 7, talk) == false;
}

test a_team_card_needs_a_team_and_the_team_tools {
    var talk : u64 = cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS);
    assert card_valid(ROLE_MATE, NO_TEAM, talk) == false;
    assert card_valid(ROLE_MATE, 7, cap_bit(CAP_PEER_MAIL)) == false;
    assert card_valid(ROLE_SOLO, NO_TEAM, cap_bit(CAP_LEAD)) == true;
    assert card_valid(ROLE_SOLO, 7, 0) == false;
    assert card_valid(ROLE_COUNT, 7, talk) == false;
    assert card_valid(ROLE_MATE, 7, talk | 1024) == false;
}

test the_newest_card_wins_and_a_dead_pid_loses_it {
    assert card_replaces(3, 4) == true;
    assert card_replaces(4, 4) == false;
    assert card_replaces(5, 4) == false;
    assert card_live(42, 42) == true;
    assert card_live(42, 43) == false;
    assert card_live(NO_PID, NO_PID) == false;
}

test an_edge_joins_ring_e_to_ring_e_plus_one {
    assert edge_joins(0, 0, 1) == true;
    assert edge_joins(3, 3, 4) == true;
    assert edge_joins(1, 0, 1) == false;
    assert edge_joins(0, 0, 2) == false;
    assert edge_joins(0, RING_NONE, 1) == false;
    assert ring_valid(4, 5) == true;
    assert ring_valid(5, 5) == false;
    assert ring_valid(RING_NONE, 5) == true;
}

test a_contract_holds_only_when_both_hashes_agree {
    assert contract_answer(77, 77) == CT_SAME;
    assert contract_answer(77, 78) == CT_STALE;
    assert contract_answer(NO_HASH, 77) == CT_MISSING;
    assert contract_answer(77, NO_HASH) == CT_MISSING;
    assert edge_holds(77, 77) == true;
    assert edge_holds(77, 78) == false;
}

test the_records_keep_what_they_were_given {
    var c : AgentCard = card(42, ROLE_MATE, 7, 1, cap_bit(CAP_READ), 77, 2);
    assert c.pid == 42;
    assert c.role == ROLE_MATE;
    assert c.gen == 2;
    var e : RingContract = ring_contract(2, 77, 78);
    assert e.producer == 2;
    assert e.consumer == 3;
    assert edge_joins(e.edge, e.producer, e.consumer) == true;
    assert edge_holds(e.served, e.held) == false;
}

; --- 5. Capability contract for the pilot kinds (gHashTag/t27#13886) -------------------------------------
; A contract only: no agent is created, no capability is granted to a running process, no pilot node
; becomes runnable. Kinds, kind predicates and pilot ids are read from the registry by use and never
; restated here. Every decision takes and returns scalars, so t27b exports it, and the default branch of
; every decision is a denial. Only the emergency STOP ignores the version, the mask and the flags.

use queen::agent_registry::AN_KIND_HYPER;
use queen::agent_registry::AN_KIND_SUPERVISOR;
use queen::agent_registry::AN_KIND_SUBAGENT;
use queen::agent_registry::AN_KIND_COUNT;
use queen::agent_registry::AN_TREE_N;
use queen::agent_registry::AN_TREE_IDS;
use queen::agent_registry::an_kind_may_grant;
use queen::agent_registry::an_kind_may_stop_all;
use queen::agent_registry::an_kind_may_start_supervisor;
use queen::agent_registry::an_kind_may_assign;
use queen::agent_registry::an_kind_may_execute;
use queen::agent_registry::an_kind_may_own;
use queen::agent_registry::an_id_ok;
use t27os::t27l::tl_event_line;
use t27os::t27l::tl_validate_line;
use t27os::t27l::tl_action_id;
use t27os::t27l::TL_OK;

/// The one contract version. A request that carries another version is denied (STOP excepted).
pub const CC_VERSION : u32 = 1;

/// Operations of the order.
pub const CC_OP_GRANT : u8 = 0;
pub const CC_OP_SECRET : u8 = 1;
pub const CC_OP_DESTRUCTIVE : u8 = 2;
pub const CC_OP_NETWORK : u8 = 3;
pub const CC_OP_MERGE : u8 = 4;
pub const CC_OP_STOP : u8 = 5;
pub const CC_OP_COUNT : u8 = 6;

/// Request flags, one bit each.
pub const CC_FLAG_OWNER_APPROVAL : u64 = 0;
pub const CC_FLAG_NETWORK_POLICY : u64 = 1;
pub const CC_FLAG_REQUIRED_GREEN : u64 = 2;
pub const CC_FLAG_OWN_PR : u64 = 3;

/// Named answers. Each denial path has its own.
pub const CC_ALLOWED : u8 = 0;
pub const CC_DENIED_VERSION : u8 = 1;
pub const CC_DENIED_KIND : u8 = 2;
pub const CC_DENIED_OP : u8 = 3;
pub const CC_DENIED_GRANTER : u8 = 4;
pub const CC_DENIED_UNKNOWN_BIT : u8 = 5;
pub const CC_DENIED_CEILING : u8 = 6;
pub const CC_DENIED_SECRET : u8 = 7;
pub const CC_OWNER_APPROVAL_REQUIRED : u8 = 8;
pub const CC_DENIED_MISSING : u8 = 9;
pub const CC_DENIED_SUBAGENT : u8 = 10;
pub const CC_ANSWER_COUNT : u8 = 11;

/// One flag as a mask; 0 for a flag out of range.
pub fn cc_flag(k: u64) -> u64 {
    var one : u64 = 1;
    if (k > CC_FLAG_OWN_PR) { return 0; }
    return one << k;
}

pub fn cc_version_ok(v: u32) -> bool {
    return v == CC_VERSION;
}

pub fn cc_kind_valid(k: u8) -> bool {
    return k < AN_KIND_COUNT;
}

/// Ceiling mask of one kind; 0 for a kind out of range. Each bit follows from one registry predicate.
pub fn cc_ceiling(k: u8) -> u64 {
    var m : u64 = 0;
    if (k >= AN_KIND_COUNT) { return 0; }
    // read: every valid kind is a node of the tree an_kind_may_own describes, and may look
    m = m | cap_bit(CAP_READ);
    // lead: an_kind_may_start_supervisor (hyper) and an_kind_may_assign (supervisor) own a child kind
    if (an_kind_may_start_supervisor(k)) { m = m | cap_bit(CAP_LEAD); }
    if (an_kind_may_assign(k)) { m = m | cap_bit(CAP_LEAD); }
    // subagent bit: an_kind_may_assign only (a kind that may not assign never starts a subagent)
    if (an_kind_may_assign(k)) { m = m | cap_bit(CAP_SUBAGENT); }
    // peer mail and tasks: an_kind_may_grant (hyper policy), an_kind_may_assign (supervisor tasks)
    // and an_kind_may_execute (subagent reports its bounded task)
    if (an_kind_may_grant(k)) { m = m | cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS); }
    if (an_kind_may_assign(k)) { m = m | cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS); }
    if (an_kind_may_execute(k)) { m = m | cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS); }
    // edit and run: an_kind_may_execute only (bounded task execution, capability-scoped write)
    if (an_kind_may_execute(k)) { m = m | cap_bit(CAP_EDIT) | cap_bit(CAP_RUN); }
    // web: an_kind_may_execute (the network is reached only by a bounded task, under the policy flag)
    if (an_kind_may_execute(k)) { m = m | cap_bit(CAP_WEB); }
    return m;
}

/// Grant decision. The granter must pass an_kind_may_grant; the mask must be known and inside the ceiling.
pub fn cc_grant(version: u32, granter: u8, receiver: u8, mask: u64) -> u8 {
    if (cc_version_ok(version) == false) { return CC_DENIED_VERSION; }
    if (cc_kind_valid(granter) == false) { return CC_DENIED_KIND; }
    if (cc_kind_valid(receiver) == false) { return CC_DENIED_KIND; }
    if (an_kind_may_grant(granter) == false) { return CC_DENIED_GRANTER; }
    if (caps_known(mask) == false) { return CC_DENIED_UNKNOWN_BIT; }
    var ceiling : u64 = cc_ceiling(receiver);
    if ((mask & ceiling) != mask) { return CC_DENIED_CEILING; }
    return CC_ALLOWED;
}

/// Effective mask of a card: its bits that are also granted and inside the ceiling of its kind.
/// A self-declared bit that was never granted has no effect.
pub fn cc_effective(card_caps: u64, granted: u64, kind: u8) -> u64 {
    return card_caps & granted & cc_ceiling(kind);
}

/// Emergency STOP: allowed exactly for a kind that may stop all, whatever the version, mask or flags.
pub fn cc_stop_allowed(kind: u8) -> bool {
    if (kind >= AN_KIND_COUNT) { return false; }
    return an_kind_may_stop_all(kind);
}

/// Every valid kind obeys a STOP.
pub fn cc_stop_obeyed(kind: u8) -> bool {
    return kind < AN_KIND_COUNT;
}

/// The decision for every operation. mask is the effective mask (the requested mask for a grant);
/// receiver is read only by a grant. The mask of a destructive or network request is cut to the
/// ceiling of the kind before a bit is read.
pub fn cc_decide(version: u32, kind: u8, op: u8, mask: u64, flags: u64, receiver: u8) -> u8 {
    if (op == CC_OP_STOP) {
        if (cc_stop_allowed(kind)) { return CC_ALLOWED; }
        return CC_DENIED_KIND;
    }
    if (cc_version_ok(version) == false) { return CC_DENIED_VERSION; }
    if (cc_kind_valid(kind) == false) { return CC_DENIED_KIND; }
    if (op >= CC_OP_COUNT) { return CC_DENIED_OP; }
    if (op == CC_OP_GRANT) { return cc_grant(version, kind, receiver, mask); }
    if (op == CC_OP_SECRET) { return CC_DENIED_SECRET; }
    if (op == CC_OP_DESTRUCTIVE) {
        if (can_serve(flags, cc_flag(CC_FLAG_OWNER_APPROVAL)) == false) { return CC_OWNER_APPROVAL_REQUIRED; }
        if (an_kind_may_execute(kind) == false) { return CC_DENIED_KIND; }
        if (can_serve(cc_effective(mask, mask, kind), cap_bit(CAP_RUN)) == false) { return CC_DENIED_MISSING; }
        return CC_ALLOWED;
    }
    if (op == CC_OP_NETWORK) {
        if (can_serve(cc_effective(mask, mask, kind), cap_bit(CAP_WEB)) == false) { return CC_DENIED_MISSING; }
        if (can_serve(flags, cc_flag(CC_FLAG_NETWORK_POLICY)) == false) { return CC_DENIED_MISSING; }
        return CC_ALLOWED;
    }
    if (op == CC_OP_MERGE) {
        if (an_kind_may_execute(kind)) { return CC_DENIED_SUBAGENT; }
        var both : u64 = cc_flag(CC_FLAG_REQUIRED_GREEN) | cc_flag(CC_FLAG_OWN_PR);
        if (can_serve(flags, both) == false) { return CC_DENIED_MISSING; }
        return CC_ALLOWED;
    }
    return CC_DENIED_OP;
}

/// T27L action number of one answer (home: t27os/t27l.t27, pinned by test). An answer out of range maps
/// to access_denied.
pub fn cc_action(answer: u8) -> u8 {
    if (answer == CC_ALLOWED) { return 52; }
    if (answer == CC_DENIED_SECRET) { return 121; }
    if (answer == CC_OWNER_APPROVAL_REQUIRED) { return 165; }
    if (answer == CC_DENIED_MISSING) { return 127; }
    if (answer == CC_DENIED_SUBAGENT) { return 127; }
    return 53;
}

pub const CC_T_EV : str = "33333333-4444-4555-8666-777777777777";
pub const CC_T_TS : str = "2026-11-15T12:00:00Z";

/// One T27L line for an answer (actor 2 agent, surface 11 agent; level info when allowed, warn otherwise);
/// 0 when the envelope refuses the line.
pub fn cc_event(out: []u8, answer: u8, payload: []const u8) -> usize {
    var level : u8 = 3;
    if (answer == CC_ALLOWED) { level = 2; }
    return tl_event_line(out, CC_T_EV, CC_T_TS, "mac-1", "sess-1", 2, 11, cc_action(answer), level, "", "", "", payload, "");
}

invariant the_contract_has_one_version { assert CC_VERSION == 1; }
invariant the_operations_are_contiguous { assert CC_OP_SECRET == CC_OP_GRANT + 1 and CC_OP_DESTRUCTIVE == CC_OP_SECRET + 1 and CC_OP_NETWORK == CC_OP_DESTRUCTIVE + 1 and CC_OP_MERGE == CC_OP_NETWORK + 1 and CC_OP_STOP == CC_OP_MERGE + 1 and CC_OP_COUNT == CC_OP_STOP + 1; }
invariant the_answers_are_contiguous { assert CC_DENIED_VERSION == CC_ALLOWED + 1 and CC_DENIED_SUBAGENT == CC_DENIED_MISSING + 1 and CC_ANSWER_COUNT == CC_DENIED_SUBAGENT + 1; }
invariant the_contract_adds_no_capability_bit { assert CAP_COUNT == 10; }

// Not run on the Mac (hook mac-no-heavy): tests are not_run here; CI and the lab run them.

test fr001_another_version_is_denied_except_stop {
    var web : u64 = cap_bit(CAP_WEB);
    var net : u64 = cc_flag(CC_FLAG_NETWORK_POLICY);
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_NETWORK, web, net, 0) == CC_ALLOWED;
    assert cc_decide(CC_VERSION + 1, AN_KIND_SUBAGENT, CC_OP_NETWORK, web, net, 0) == CC_DENIED_VERSION;
    assert cc_decide(0, AN_KIND_SUBAGENT, CC_OP_NETWORK, web, net, 0) == CC_DENIED_VERSION;
    assert cc_grant(CC_VERSION + 1, AN_KIND_HYPER, AN_KIND_SUBAGENT, 1) == CC_DENIED_VERSION;
    assert cc_decide(CC_VERSION + 1, AN_KIND_HYPER, CC_OP_STOP, 0, 0, 0) == CC_ALLOWED;
}

test fr002_a_kind_out_of_range_is_denied_for_every_operation {
    var all : u64 = caps_all();
    var fl : u64 = 15;
    var op : u8 = 0;
    while (op < CC_OP_COUNT) {
        assert cc_decide(CC_VERSION, AN_KIND_COUNT, op, all, fl, 0) == CC_DENIED_KIND;
        assert cc_decide(CC_VERSION, 255, op, all, fl, 0) == CC_DENIED_KIND;
        op = op + 1;
    }
    assert cc_ceiling(AN_KIND_COUNT) == 0;
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_COUNT, 1) == CC_DENIED_KIND;
    assert cc_grant(CC_VERSION, AN_KIND_COUNT, AN_KIND_SUBAGENT, 1) == CC_DENIED_KIND;
    assert cc_kind_valid(AN_KIND_SUBAGENT) == true;
    assert cc_kind_valid(AN_KIND_COUNT) == false;
}

test fr002_the_pilot_ids_pass_the_registry_check {
    var i : usize = 0;
    while (i < AN_TREE_N) {
        assert an_id_ok(AN_TREE_IDS[i]) == true;
        i = i + 1;
    }
    assert an_kind_may_own(AN_KIND_HYPER, AN_KIND_SUPERVISOR) == true;
    assert an_kind_may_own(AN_KIND_SUPERVISOR, AN_KIND_SUBAGENT) == true;
}

test fr003_the_ceilings_follow_the_kind_predicates {
    var k : u8 = 0;
    var ex : u64 = cap_bit(CAP_EDIT) | cap_bit(CAP_RUN);
    while (k < AN_KIND_COUNT) {
        var c : u64 = cc_ceiling(k);
        assert caps_known(c) == true;
        assert can_serve(c, cap_bit(CAP_READ)) == true;
        if (an_kind_may_execute(k) == false) { assert (c & ex) == 0; }
        if (an_kind_may_assign(k) == false) { assert (c & cap_bit(CAP_SUBAGENT)) == 0; }
        k = k + 1;
    }
    assert (cc_ceiling(AN_KIND_SUBAGENT) & cap_bit(CAP_LEAD)) == 0;
    assert can_serve(cc_ceiling(AN_KIND_SUBAGENT), ex) == true;
    assert can_serve(cc_ceiling(AN_KIND_SUPERVISOR), cap_bit(CAP_SUBAGENT)) == true;
}

test fr004_a_grant_inside_the_ceiling_is_allowed {
    var m : u64 = cap_bit(CAP_READ) | cap_bit(CAP_EDIT) | cap_bit(CAP_RUN);
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_SUBAGENT, m) == CC_ALLOWED;
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_SUPERVISOR, cap_bit(CAP_SUBAGENT)) == CC_ALLOWED;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_GRANT, m, 0, AN_KIND_SUBAGENT) == CC_ALLOWED;
}

test fr004_only_the_grant_kind_may_grant {
    assert cc_grant(CC_VERSION, AN_KIND_SUPERVISOR, AN_KIND_SUBAGENT, 1) == CC_DENIED_GRANTER;
    assert cc_grant(CC_VERSION, AN_KIND_SUBAGENT, AN_KIND_SUBAGENT, 1) == CC_DENIED_GRANTER;
}

test fr004_an_unknown_bit_is_denied {
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_SUBAGENT, 1024) == CC_DENIED_UNKNOWN_BIT;
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_SUBAGENT, 1 | 2048) == CC_DENIED_UNKNOWN_BIT;
}

test fr004_a_bit_above_the_ceiling_is_denied {
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_SUBAGENT, cap_bit(CAP_LEAD)) == CC_DENIED_CEILING;
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_HYPER, cap_bit(CAP_RUN)) == CC_DENIED_CEILING;
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_SUPERVISOR, cap_bit(CAP_EDIT)) == CC_DENIED_CEILING;
    assert cc_grant(CC_VERSION, AN_KIND_HYPER, AN_KIND_SUBAGENT, cap_bit(CAP_SUBAGENT)) == CC_DENIED_CEILING;
}

test fr004_a_self_declared_bit_never_widens_a_grant {
    var declared : u64 = cap_bit(CAP_READ) | cap_bit(CAP_RUN) | cap_bit(CAP_LEAD);
    var granted : u64 = cap_bit(CAP_READ);
    assert cc_effective(declared, granted, AN_KIND_SUBAGENT) == cap_bit(CAP_READ);
    assert cc_effective(declared, declared, AN_KIND_SUBAGENT) == (cap_bit(CAP_READ) | cap_bit(CAP_RUN));
    assert cc_effective(declared, 0, AN_KIND_SUBAGENT) == 0;
    assert cc_effective(declared, declared, AN_KIND_COUNT) == 0;
}

test fr005_an_operation_out_of_range_is_denied {
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_COUNT, 1023, 15, 0) == CC_DENIED_OP;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, 255, 1023, 15, 0) == CC_DENIED_OP;
}

test fr006_secret_access_is_denied_for_every_kind {
    var k : u8 = 0;
    while (k < AN_KIND_COUNT) {
        assert cc_decide(CC_VERSION, k, CC_OP_SECRET, caps_all(), 15, 0) == CC_DENIED_SECRET;
        assert cc_decide(CC_VERSION, k, CC_OP_SECRET, 0, 0, 0) == CC_DENIED_SECRET;
        k = k + 1;
    }
}

test fr006_a_destructive_action_needs_the_owner_first {
    var run : u64 = cap_bit(CAP_RUN);
    var ok : u64 = cc_flag(CC_FLAG_OWNER_APPROVAL);
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_DESTRUCTIVE, run, 0, 0) == CC_OWNER_APPROVAL_REQUIRED;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_DESTRUCTIVE, run, 0, 0) == CC_OWNER_APPROVAL_REQUIRED;
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_DESTRUCTIVE, run, ok, 0) == CC_ALLOWED;
}

test fr006_a_destructive_action_needs_an_execute_kind {
    var run : u64 = cap_bit(CAP_RUN);
    var ok : u64 = cc_flag(CC_FLAG_OWNER_APPROVAL);
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_DESTRUCTIVE, run, ok, 0) == CC_DENIED_KIND;
    assert cc_decide(CC_VERSION, AN_KIND_SUPERVISOR, CC_OP_DESTRUCTIVE, run, ok, 0) == CC_DENIED_KIND;
}

test fr006_a_destructive_action_needs_the_run_bit {
    var ok : u64 = cc_flag(CC_FLAG_OWNER_APPROVAL);
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_DESTRUCTIVE, cap_bit(CAP_EDIT), ok, 0) == CC_DENIED_MISSING;
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_DESTRUCTIVE, 0, ok, 0) == CC_DENIED_MISSING;
}

test fr006_the_network_needs_the_web_bit_and_the_policy_flag {
    var web : u64 = cap_bit(CAP_WEB);
    var net : u64 = cc_flag(CC_FLAG_NETWORK_POLICY);
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_NETWORK, web, net, 0) == CC_ALLOWED;
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_NETWORK, 0, net, 0) == CC_DENIED_MISSING;
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_NETWORK, web, 0, 0) == CC_DENIED_MISSING;
    assert can_serve(cc_ceiling(AN_KIND_SUBAGENT), web) == true;
}

test fr006_a_bit_above_the_ceiling_of_the_kind_opens_nothing {
    var web : u64 = cap_bit(CAP_WEB);
    var net : u64 = cc_flag(CC_FLAG_NETWORK_POLICY);
    var own : u64 = cc_flag(CC_FLAG_OWNER_APPROVAL);
    assert can_serve(cc_ceiling(AN_KIND_HYPER), web) == false;
    assert can_serve(cc_ceiling(AN_KIND_SUPERVISOR), web) == false;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_NETWORK, caps_all(), net, 0) == CC_DENIED_MISSING;
    assert cc_decide(CC_VERSION, AN_KIND_SUPERVISOR, CC_OP_NETWORK, caps_all(), net, 0) == CC_DENIED_MISSING;
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_NETWORK, caps_all(), net, 0) == CC_ALLOWED;
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_DESTRUCTIVE, caps_all(), own, 0) == CC_ALLOWED;
}

test fr006_a_merge_is_denied_for_the_subagent_and_gated_for_the_others {
    var both : u64 = cc_flag(CC_FLAG_REQUIRED_GREEN) | cc_flag(CC_FLAG_OWN_PR);
    assert cc_decide(CC_VERSION, AN_KIND_SUBAGENT, CC_OP_MERGE, caps_all(), both, 0) == CC_DENIED_SUBAGENT;
    assert cc_decide(CC_VERSION, AN_KIND_SUPERVISOR, CC_OP_MERGE, 0, both, 0) == CC_ALLOWED;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_MERGE, 0, both, 0) == CC_ALLOWED;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_MERGE, 0, cc_flag(CC_FLAG_REQUIRED_GREEN), 0) == CC_DENIED_MISSING;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_MERGE, 0, cc_flag(CC_FLAG_OWN_PR), 0) == CC_DENIED_MISSING;
    assert cc_decide(CC_VERSION, AN_KIND_HYPER, CC_OP_MERGE, 0, 0, 0) == CC_DENIED_MISSING;
}

test fr007_stop_is_allowed_for_the_stop_kind_only_and_every_kind_obeys {
    assert cc_stop_allowed(AN_KIND_HYPER) == true;
    assert cc_stop_allowed(AN_KIND_SUPERVISOR) == false;
    assert cc_stop_allowed(AN_KIND_SUBAGENT) == false;
    assert cc_stop_allowed(AN_KIND_COUNT) == false;
    assert cc_decide(CC_VERSION + 7, AN_KIND_HYPER, CC_OP_STOP, 0, 0, 0) == CC_ALLOWED;
    assert cc_decide(CC_VERSION, AN_KIND_SUPERVISOR, CC_OP_STOP, caps_all(), 15, 0) == CC_DENIED_KIND;
    assert cc_decide(CC_VERSION, AN_KIND_COUNT, CC_OP_STOP, caps_all(), 15, 0) == CC_DENIED_KIND;
    assert cc_stop_obeyed(AN_KIND_HYPER) == true;
    assert cc_stop_obeyed(AN_KIND_SUPERVISOR) == true;
    assert cc_stop_obeyed(AN_KIND_SUBAGENT) == true;
    assert cc_stop_obeyed(AN_KIND_COUNT) == false;
}

test fr008_the_action_numbers_are_pinned_to_their_home {
    assert cc_action(CC_ALLOWED) == tl_action_id("access_approved");
    assert cc_action(CC_DENIED_VERSION) == tl_action_id("access_denied");
    assert cc_action(CC_DENIED_KIND) == tl_action_id("access_denied");
    assert cc_action(CC_DENIED_OP) == tl_action_id("access_denied");
    assert cc_action(CC_DENIED_GRANTER) == tl_action_id("access_denied");
    assert cc_action(CC_DENIED_UNKNOWN_BIT) == tl_action_id("access_denied");
    assert cc_action(CC_DENIED_CEILING) == tl_action_id("access_denied");
    assert cc_action(CC_DENIED_SECRET) == tl_action_id("secret_access_denied");
    assert cc_action(CC_OWNER_APPROVAL_REQUIRED) == tl_action_id("owner_approval_required");
    assert cc_action(CC_DENIED_MISSING) == tl_action_id("effect_denied");
    assert cc_action(CC_DENIED_SUBAGENT) == tl_action_id("effect_denied");
    assert cc_action(CC_ANSWER_COUNT) == tl_action_id("access_denied");
}

test fr008_an_approval_line_and_a_denial_line_validate {
    var ln : [2048]u8 = undefined;
    const n : usize = cc_event(ln[0..2048], CC_ALLOWED, "contract=1 op=network");
    assert n > 0;
    assert tl_validate_line(ln[0..n]) == TL_OK;
    var dn : [2048]u8 = undefined;
    const m : usize = cc_event(dn[0..2048], CC_DENIED_SECRET, "contract=1 op=secret");
    assert m > 0;
    assert tl_validate_line(dn[0..m]) == TL_OK;
    // negative control: an empty out buffer cannot hold a line
    var tiny : [4]u8 = undefined;
    assert cc_event(tiny[0..4], CC_ALLOWED, "x") == 0;
}
