// SPDX-License-Identifier: Apache-2.0
; specs/queen/agent_card.t27 -- what an agent says it can do, and the contract it serves.
; gHashTag/t27#13310, order SWARM_BEST_PRACTICES (GODMODE epic #13260, actor epic #6971), 2026-11-08.
; Studied: Claude Code agent teams (a team config lists each member's name, agent id and agent type;
; teammates read it to find each other), subagent definitions (tools, disallowedTools, model), and
; ListAgents across sessions.
; Gap it closes: actors.t27 has no way for an actor to declare what it can do or which contract it
; serves, and its section 7 forbids a global name registry (GLOBAL_NAME_REGISTRY is false: the store is
; the only directory of who holds what). So a card is ONE STORE ROW keyed by pid, never a registry; a
; team's config file and ListAgents are views of those rows. A card is the project speaking about
; itself, so it is a t27 record, not an A2A JSON card: no A2A server stands behind it.
; This file edits nothing in actors.t27 or control.t27. Every decision function is on u8, u32, u64 and
; bool, so the supervisor can mirror it as it mirrors actors.t27; the two records are the store row and
; the edge row. The ring numbers are golden_chain.t27 section 7's (GC7_*, PR #13301): until that lands,
; a ring is a u8 checked against a ring count the caller passes, so no ring constant is copied here.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenAgentCard;

use queen::actors;

; --- 1. Capabilities: one bit each ------------------------------------------------------------------

/// Capability bits. Each one is a tool set an agent definition grants (Claude Code tools and
/// disallowedTools) or a resource the swarm grants (a master-built t27c, an off-Mac lab).
pub const CAP_READ : u64 = 0;
pub const CAP_EDIT : u64 = 1;
pub const CAP_RUN : u64 = 2;
pub const CAP_SUBAGENT : u64 = 3;
pub const CAP_LEAD : u64 = 4;
pub const CAP_PEER_MAIL : u64 = 5;
pub const CAP_TASKS : u64 = 6;
pub const CAP_WEB : u64 = 7;
pub const CAP_SEAL : u64 = 8;
pub const CAP_LAB : u64 = 9;
pub const CAP_COUNT : u64 = 10;

/// One capability as a mask. A typed local, as actors.t27 bit() does, so no backend widens a literal.
pub fn cap_bit(k: u64) -> u64 {
    var one : u64 = 1;
    if (k >= CAP_COUNT) { return 0; }
    return one << k;
}

/// Every known bit at once.
pub fn caps_all() -> u64 {
    var one : u64 = 1;
    return (one << CAP_COUNT) - one;
}

/// A reader drops a card that carries a bit it does not know, rather than guess what the bit grants.
pub fn caps_known(caps: u64) -> bool {
    return (caps & caps_all()) == caps;
}

/// Whether a card covers every bit a task needs.
pub fn can_serve(caps: u64, need: u64) -> bool {
    return (caps & need) == need;
}

; --- 2. Roles: solo, lead, mate -----------------------------------------------------------------

/// A solo agent is a session or a subagent outside any team. A lead is the one fixed team lead. A mate
/// is a teammate. Claude Code: one team per session, the lead never changes, teammates cannot spawn
/// teammates, and every teammate is given SendMessage and the task tools.
pub const ROLE_SOLO : u8 = 0;
pub const ROLE_LEAD : u8 = 1;
pub const ROLE_MATE : u8 = 2;
pub const ROLE_COUNT : u8 = 3;
pub const NO_TEAM : u32 = 0;

/// A card's role, team and bits agree:
/// - solo: no team (a solo agent may carry CAP_LEAD, which is the right to start a team);
/// - lead and mate: a team, and both CAP_PEER_MAIL and CAP_TASKS;
/// - lead: CAP_LEAD; mate: never CAP_LEAD (no nested teams).
pub fn card_valid(role: u8, team: u32, caps: u64) -> bool {
    if (role >= ROLE_COUNT) { return false; }
    if (caps_known(caps) == false) { return false; }
    if (role == ROLE_SOLO) { return team == NO_TEAM; }
    if (team == NO_TEAM) { return false; }
    var talk : u64 = cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS);
    if (can_serve(caps, talk) == false) { return false; }
    var lead : u64 = cap_bit(CAP_LEAD);
    if (role == ROLE_LEAD) { return can_serve(caps, lead); }
    return (caps & lead) == 0;
}

/// A card is re-published with a higher generation whenever it changes; a reader keeps the highest.
pub fn card_replaces(held_gen: u32, seen_gen: u32) -> bool {
    return seen_gen > held_gen;
}

/// A card names a pid; once that pid no longer reaches its slot's live pid (actors.t27 reaches), the
/// card is dead and a reader drops it. No second liveness rule: the pid's generation is the rule.
pub fn card_live(card_pid: u64, live_pid: u64) -> bool {
    return reaches(card_pid, live_pid);
}

; --- 3. Rings and their contracts ---------------------------------------------------------------

/// No ring: a card that serves no ring of the vertical stack.
pub const RING_NONE : u8 = 255;

pub fn ring_valid(ring: u8, ring_count: u8) -> bool {
    if (ring == RING_NONE) { return true; }
    return ring < ring_count;
}

/// Section 7 of golden_chain.t27 numbers edge e as the step from ring e to ring e + 1 (PC 0: physics
/// to compiler, ..., OK 3: orchestrator to knowledge). An edge row is valid only for that pair.
pub fn edge_joins(edge: u8, producer: u8, consumer: u8) -> bool {
    if (producer == RING_NONE) { return false; }
    if (consumer == RING_NONE) { return false; }
    if (producer != edge) { return false; }
    return consumer == producer + 1;
}

/// A contract is the low 64 bits of the seal hash of the spec a producer ring serves. The producer's
/// card carries the hash it serves now; the consumer holds the hash it last built against.
pub const NO_HASH : u64 = 0;
pub const CT_SAME : u8 = 0;
pub const CT_STALE : u8 = 1;
pub const CT_MISSING : u8 = 2;

pub fn contract_answer(served: u64, held: u64) -> u8 {
    if (served == NO_HASH) { return CT_MISSING; }
    if (held == NO_HASH) { return CT_MISSING; }
    if (served == held) { return CT_SAME; }
    return CT_STALE;
}

/// What gc7_chain_state takes for one edge: true only when the consumer built against what the
/// producer serves now. A stale edge is not a broken one; it is work for the consumer ring.
pub fn edge_holds(served: u64, held: u64) -> bool {
    return contract_answer(served, held) == CT_SAME;
}

; --- 4. The two records ---------------------------------------------------------------------------

/// The store row of one agent. Keyed by pid: there is no name index (actors.t27 section 7).
pub struct AgentCard {
    pid: u64,
    role: u8,
    team: u32,
    ring: u8,
    caps: u64,
    contract: u64,
    gen: u32,
}

/// The store row of one edge between two rings: what the producer serves and what the consumer holds.
pub struct RingContract {
    edge: u8,
    producer: u8,
    consumer: u8,
    served: u64,
    held: u64,
}

pub fn card(pid: u64, role: u8, team: u32, ring: u8, caps: u64, contract: u64, gen: u32) -> AgentCard {
    return AgentCard{.pid = pid, .role = role, .team = team, .ring = ring, .caps = caps,
        .contract = contract, .gen = gen};
}

pub fn ring_contract(edge: u8, served: u64, held: u64) -> RingContract {
    return RingContract{.edge = edge, .producer = edge, .consumer = edge + 1, .served = served,
        .held = held};
}

pub const CARD_IS_A_REGISTRY : bool = false;

; --- Invariants and tests -------------------------------------------------------------------------

invariant the_capabilities_fit_one_word { assert CAP_COUNT <= 64 and CAP_LAB + 1 == CAP_COUNT; }
invariant the_roles_are_contiguous { assert ROLE_LEAD == ROLE_SOLO + 1 and ROLE_MATE == ROLE_LEAD + 1 and ROLE_COUNT == ROLE_MATE + 1; }
invariant the_contract_answers_are_contiguous { assert CT_STALE == CT_SAME + 1 and CT_MISSING == CT_STALE + 1; }
invariant a_card_is_no_registry { assert CARD_IS_A_REGISTRY == false and GLOBAL_NAME_REGISTRY == false; }

test a_bit_past_the_known_ones_is_no_bit {
    assert cap_bit(CAP_READ) == 1;
    assert cap_bit(CAP_LAB) == 512;
    assert cap_bit(CAP_COUNT) == 0;
    assert caps_all() == 1023;
    assert caps_known(1023) == true;
    assert caps_known(1024) == false;
}

test a_card_serves_only_what_it_covers {
    var rw : u64 = cap_bit(CAP_READ) | cap_bit(CAP_EDIT);
    assert can_serve(rw, cap_bit(CAP_READ)) == true;
    assert can_serve(rw, rw) == true;
    assert can_serve(cap_bit(CAP_READ), rw) == false;
    assert can_serve(rw, 0) == true;
}

test a_mate_never_carries_the_lead_bit {
    var talk : u64 = cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS);
    var lead : u64 = talk | cap_bit(CAP_LEAD);
    assert card_valid(ROLE_MATE, 7, talk) == true;
    assert card_valid(ROLE_MATE, 7, lead) == false;
    assert card_valid(ROLE_LEAD, 7, lead) == true;
    assert card_valid(ROLE_LEAD, 7, talk) == false;
}

test a_team_card_needs_a_team_and_the_team_tools {
    var talk : u64 = cap_bit(CAP_PEER_MAIL) | cap_bit(CAP_TASKS);
    assert card_valid(ROLE_MATE, NO_TEAM, talk) == false;
    assert card_valid(ROLE_MATE, 7, cap_bit(CAP_PEER_MAIL)) == false;
    assert card_valid(ROLE_SOLO, NO_TEAM, cap_bit(CAP_LEAD)) == true;
    assert card_valid(ROLE_SOLO, 7, 0) == false;
    assert card_valid(ROLE_COUNT, 7, talk) == false;
    assert card_valid(ROLE_MATE, 7, talk | 1024) == false;
}

test the_newest_card_wins_and_a_dead_pid_loses_it {
    assert card_replaces(3, 4) == true;
    assert card_replaces(4, 4) == false;
    assert card_replaces(5, 4) == false;
    assert card_live(42, 42) == true;
    assert card_live(42, 43) == false;
    assert card_live(NO_PID, NO_PID) == false;
}

test an_edge_joins_ring_e_to_ring_e_plus_one {
    assert edge_joins(0, 0, 1) == true;
    assert edge_joins(3, 3, 4) == true;
    assert edge_joins(1, 0, 1) == false;
    assert edge_joins(0, 0, 2) == false;
    assert edge_joins(0, RING_NONE, 1) == false;
    assert ring_valid(4, 5) == true;
    assert ring_valid(5, 5) == false;
    assert ring_valid(RING_NONE, 5) == true;
}

test a_contract_holds_only_when_both_hashes_agree {
    assert contract_answer(77, 77) == CT_SAME;
    assert contract_answer(77, 78) == CT_STALE;
    assert contract_answer(NO_HASH, 77) == CT_MISSING;
    assert contract_answer(77, NO_HASH) == CT_MISSING;
    assert edge_holds(77, 77) == true;
    assert edge_holds(77, 78) == false;
}

test the_records_keep_what_they_were_given {
    var c : AgentCard = card(42, ROLE_MATE, 7, 1, cap_bit(CAP_READ), 77, 2);
    assert c.pid == 42;
    assert c.role == ROLE_MATE;
    assert c.gen == 2;
    var e : RingContract = ring_contract(2, 77, 78);
    assert e.producer == 2;
    assert e.consumer == 3;
    assert edge_joins(e.edge, e.producer, e.consumer) == true;
    assert edge_holds(e.served, e.held) == false;
}
