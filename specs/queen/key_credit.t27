// SPDX-License-Identifier: Apache-2.0
; specs/queen/key_credit.t27 -- what a leased key earns its contributor: credit for .t27 that landed, and
; nothing for a request
; Owner, 2026-10-19 (translated): pay the TRI token as Proof of Compute, for $TRI in exchange for .t27.
; The unit is accepted .t27 work: a contributor's key earns when the bee or review turn it powered
; produced .t27 that passed review and landed. Not per request, not per token spent, not per key-hour.
; --
; What the reward is, and what it is not (gHashTag/golden-chain-international FACTS.md section 6 and
; FINANCE_AND_COMPLIANCE.md section 3 are the source; nothing here restates them as new facts):
; - $TRI is minted only by the founder, Dmitrii Vasilev, on TON (trinet/mint_authority.t27,
;   trinet/tri-bridge.t27 CHAIN_OF_RECORD). The Base Sepolia TriToken and its MiningPool are a retired
;   testnet experiment, not $TRI, and nothing here is a claim on that pool. Measured 2026-10-19 on
;   gHashTag/trinity-contracts src/MiningPool.sol: claim() takes an opaque proof_data it does not verify,
;   signed by any key ChipRegistry.registerChip admitted, and registerChip has no gate (audit
;   W-INTL-34). So a key turn could be put through it, and that would prove nothing: the pool is not a
;   verifier of work, and it is not $TRI.
; - A credit is a reward for verified work. It is not a payment for a key, not a price of a request,
;   and lending a key earns nothing by itself (automation/queen-contributor-keys.t27 CREDIT_WALLET
;   false). Credits are ledger rows, never moved (verified/payout.t27 CREDIT_TRANSFERABLE false); no
;   settlement exists (hosting/credit.t27 SETTLEMENT_ENABLED false, TOKEN_VALUE_CLAIMED false); the
;   value gate is counsel's (hosting/statement.t27 VALUE_GATE_OPEN false); the mint schedule's rate is
;   0 (mint_authority.t27 SCHEDULE_BASE_RATE). This card adds no release path.
; --
; The receipt: one row per lease that served a dispatch. It names the key by its id (KEY_ID_HEX_LEN hex
; of the SHA-256 of the key, verified/signed_receipt.t27), never by its value, and links:
;   lease -> key id -> owner -> dispatch -> PR (its head is the dispatch's branch) -> the .t27 files the
;   PR added or changed -> the merge commit on master -> the review that said ACCEPT on that head.
; The tokens the lease spent are recorded, and never priced: the unit is the landed PR.
; The facts a row carries are bits (R_*), as network/usage.t27 carries its U_* bits. The Queen measures
; them: the lease record (key_vault.t27), the dispatch state (queen/dispatch.t27), the PR and its merge
; (GitHub), the review gate (verified/review_gate.t27 G_POLICY: tests executed and passed, seals
; verified, policy clean).
; --
; The rules:
;   1. only a contributor's key earns. A Queen pool key (a Railway variable) has no one to credit; the
;      company crediting itself is not a reward for anyone's work (key_owner_earns);
;   2. a lease that was refused, overloaded or got no answer did no work: not eligible;
;   3. a receipt naming a key the lease record does not name is an identity mismatch;
;   4. a broken chain (the lease was not this dispatch's, the PR is not the dispatch's) is unverifiable,
;      and charges nothing;
;   5. a PR that adds or changes no .t27 file earns nothing; neither does one not merged, not closing
;      its task, or whose dispatch did not end in ACCEPT;
;   6. a contributor is credited once per PR, however many leases, keys or files served it: splitting a
;      change into more files, more requests or more keys earns nothing more;
;   7. a key owner is never slashed: a bee's wrong answer is the bee's, not the key's. So no row is
;      OUT_REJECTED_AND_SLASHED;
;   8. a credited row is paid only through payout(): the verdict must be verified and the row must name
;      it. A landed PR is reproduced by CI, not device-bound, so testnet credit is allowed and value flow
;      is not (payout.t27 attestation ladder).
; The amount: KEY_CREDIT_MTRI per credited row, the one rate the owner has set for accepted work
; (trinet/node-work-credit.t27 REWARD_PER_JOB_MTRI). A rate for a landed .t27 PR is the founder's to set;
; nothing here invents one.
; Not here: the wiring (trios: a receipt row per lease, the epoch statement leaf), and a revert after
; merge (a later issue: the row stays, and the revert is its own row).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenKeyCredit;

use verified::payout::OUT_CREDITED;
use verified::payout::OUT_REJECTED_AND_SLASHED;
use verified::payout::OUT_IDENTITY_MISMATCH;
use verified::payout::OUT_UNVERIFIABLE_NOT_CHARGED;
use verified::payout::OUT_NOT_ELIGIBLE;
use verified::payout::OUT_ALREADY_SETTLED_NOT_CHARGED;
use verified::payout::PAY_NONE;
use verified::payout::PAY_NORMAL;
use verified::payout::PAY_SLASH_ONLY;
use verified::payout::PROVIDER_FEE;
use verified::payout::CREDIT_TRANSFERABLE;
use verified::payout::payout;
use verified::payout::payment_kind_known;
use verified::payout::attestation_level;
use verified::payout::testnet_credit_allowed;
use verified::payout::value_flow_allowed;
use verified::signed_receipt::KEY_ID_HEX_LEN;
use trinet::node-work-credit::REWARD_PER_JOB_MTRI;
use queen::dispatch::S_ACCEPT;
use queen::dispatch::S_SENDBACK;
use queen::dispatch::S_EMPTY;
use queen::dispatch::S_REFUSED;

; --- 1. Whose key ---------------------------------------------------------------------------------------

/// A Queen pool key (a service variable) or a contributor's sealed key row.
pub const KO_QUEEN : u8 = 0;
pub const KO_CONTRIBUTOR : u8 = 1;

/// A contributor's GitHub account id; 0 is no account.
pub const NO_ACCOUNT : u64 = 0;

/// Only a contributor with a known account earns: a pool key has no one to credit.
pub fn key_owner_earns(owner_kind: u8, account: u64) -> bool {
    if (owner_kind != KO_CONTRIBUTOR) { return false; }
    return account != NO_ACCOUNT;
}

; --- 2. The receipt -------------------------------------------------------------------------------------

/// The message layout of a receipt row (verified/signed_receipt.t27: a domain line, then name=value).
/// `key` is the key id, never the key; `tokens` is recorded, never priced.
pub const RECEIPT_DOMAIN : str = "t27-key-credit-receipt-v1";
pub const RECEIPT_FIELDS : [14]str = ["lease", "key", "owner", "account", "dispatch", "state", "pr", "head", "merge", "t27_files", "review", "tokens", "outcome", "utc_unix"];
pub const RECEIPT_FIELD_COUNT : u8 = 14;

/// The facts of a row, one bit each.
pub const R_ANSWERED : u32 = 1;
pub const R_KEY_MATCHES : u32 = 2;
pub const R_LEASE_IN_DISPATCH : u32 = 4;
pub const R_PR_FROM_DISPATCH : u32 = 8;
pub const R_MERGED : u32 = 16;
pub const R_CLOSES_TASK : u32 = 32;
pub const R_CREDITED_BEFORE : u32 = 64;
pub const R_GATE_POLICY : u32 = 128;
pub const R_VERDICT_NAMED : u32 = 256;
pub const R_BITS : u32 = 9;

pub fn fact(facts: u32, bit: u32) -> bool {
    return (facts & bit) != 0;
}

/// A key id is KEY_ID_HEX_LEN hex digits. Anything longer may be a key's value, and is refused.
pub fn key_id_ok(hex_len: u32, all_hex: bool) -> bool {
    if (all_hex == false) { return false; }
    return hex_len == (KEY_ID_HEX_LEN as u32);
}

/// The ledger outcome of one receipt row, in payout.t27's codes. Never OUT_REJECTED_AND_SLASHED.
pub fn receipt_outcome(owner_kind: u8, account: u64, facts: u32, state: u32, t27_files: u32) -> u8 {
    if (key_owner_earns(owner_kind, account) == false) { return OUT_NOT_ELIGIBLE; }
    if (fact(facts, R_ANSWERED) == false) { return OUT_NOT_ELIGIBLE; }
    if (fact(facts, R_KEY_MATCHES) == false) { return OUT_IDENTITY_MISMATCH; }
    if (fact(facts, R_LEASE_IN_DISPATCH) == false) { return OUT_UNVERIFIABLE_NOT_CHARGED; }
    if (fact(facts, R_PR_FROM_DISPATCH) == false) { return OUT_UNVERIFIABLE_NOT_CHARGED; }
    if (state != S_ACCEPT) { return OUT_NOT_ELIGIBLE; }
    if (t27_files == 0) { return OUT_NOT_ELIGIBLE; }
    if (fact(facts, R_MERGED) == false) { return OUT_NOT_ELIGIBLE; }
    if (fact(facts, R_CLOSES_TASK) == false) { return OUT_NOT_ELIGIBLE; }
    if (fact(facts, R_CREDITED_BEFORE)) { return OUT_ALREADY_SETTLED_NOT_CHARGED; }
    return OUT_CREDITED;
}

/// The payment for one row: payout() of its outcome, verified when the review gate reached G_POLICY,
/// referenced when the row names that review.
pub fn receipt_pay(owner_kind: u8, account: u64, facts: u32, state: u32, t27_files: u32) -> u8 {
    let outcome : u8 = receipt_outcome(owner_kind, account, facts, state, t27_files);
    return payout(outcome, fact(facts, R_GATE_POLICY), fact(facts, R_VERDICT_NAMED));
}

; --- 3. The credit --------------------------------------------------------------------------------------

/// The kind every credited row is paid as: the key's owner provided the compute.
pub const KEY_CREDIT_KIND : u8 = 3;
/// mTRI per credited row: REWARD_PER_JOB_MTRI (an invariant holds them equal; gen-c cannot set a const
/// from an imported one).
pub const KEY_CREDIT_MTRI : u64 = 1;

/// A landed PR is reproduced by CI and signed by no device: testnet credit, no value flow.
pub fn key_attestation() -> u8 {
    return attestation_level(true, true, false);
}

/// The mTRI one row adds to its contributor's balance. That the attestation allows testnet credit is
/// the invariant nothing_moves_and_nothing_settles, proved at compile time, so no runtime guard here.
pub fn credit_mtri(owner_kind: u8, account: u64, facts: u32, state: u32, t27_files: u32) -> u64 {
    if (receipt_pay(owner_kind, account, facts, state, t27_files) != PAY_NORMAL) { return 0; }
    return KEY_CREDIT_MTRI;
}

; --- 4. Tests -------------------------------------------------------------------------------------------

/// Every fact that a credited row needs, and none it must not have.
pub const R_LANDED : u32 = 447;

invariant the_codes_and_bits_are_distinct {
    assert KO_QUEEN == 0 and KO_CONTRIBUTOR == 1;
    assert R_ANSWERED + R_KEY_MATCHES + R_LEASE_IN_DISPATCH + R_PR_FROM_DISPATCH + R_MERGED + R_CLOSES_TASK + R_CREDITED_BEFORE + R_GATE_POLICY + R_VERDICT_NAMED == 511;
    assert R_LANDED == 511 - R_CREDITED_BEFORE;
    assert R_BITS == 9;
    assert RECEIPT_FIELD_COUNT == 14;
}

invariant the_rate_is_the_owners_one_rate {
    assert KEY_CREDIT_MTRI == REWARD_PER_JOB_MTRI;
    assert KEY_CREDIT_KIND == PROVIDER_FEE and payment_kind_known(KEY_CREDIT_KIND);
}

invariant nothing_moves_and_nothing_settles {
    assert CREDIT_TRANSFERABLE == false;
    assert value_flow_allowed(key_attestation()) == false;
    assert testnet_credit_allowed(key_attestation());
}

test a_landed_reviewed_t27_pr_is_credited_once {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED, S_ACCEPT, 1) == OUT_CREDITED;
    assert receipt_pay(KO_CONTRIBUTOR, 42, R_LANDED, S_ACCEPT, 1) == PAY_NORMAL;
    assert credit_mtri(KO_CONTRIBUTOR, 42, R_LANDED, S_ACCEPT, 1) == KEY_CREDIT_MTRI;
    assert credit_mtri(KO_CONTRIBUTOR, 42, R_LANDED | R_CREDITED_BEFORE, S_ACCEPT, 1) == 0;
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED | R_CREDITED_BEFORE, S_ACCEPT, 1) == OUT_ALREADY_SETTLED_NOT_CHARGED;
}

test more_files_earn_nothing_more {
    assert credit_mtri(KO_CONTRIBUTOR, 42, R_LANDED, S_ACCEPT, 1) == credit_mtri(KO_CONTRIBUTOR, 42, R_LANDED, S_ACCEPT, 40);
}

test no_t27_file_no_credit {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED, S_ACCEPT, 0) == OUT_NOT_ELIGIBLE;
    assert credit_mtri(KO_CONTRIBUTOR, 42, R_LANDED, S_ACCEPT, 0) == 0;
}

test a_pool_key_or_an_unknown_account_earns_nothing {
    assert key_owner_earns(KO_QUEEN, 42) == false;
    assert key_owner_earns(KO_CONTRIBUTOR, NO_ACCOUNT) == false;
    assert key_owner_earns(KO_CONTRIBUTOR, 42);
    assert credit_mtri(KO_QUEEN, 42, R_LANDED, S_ACCEPT, 3) == 0;
    assert credit_mtri(KO_CONTRIBUTOR, NO_ACCOUNT, R_LANDED, S_ACCEPT, 3) == 0;
}

test a_refused_or_unanswered_lease_did_no_work {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED - R_ANSWERED, S_ACCEPT, 1) == OUT_NOT_ELIGIBLE;
}

test a_key_the_lease_does_not_name_is_an_identity_mismatch {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED - R_KEY_MATCHES, S_ACCEPT, 1) == OUT_IDENTITY_MISMATCH;
    assert receipt_pay(KO_CONTRIBUTOR, 42, R_LANDED - R_KEY_MATCHES, S_ACCEPT, 1) == PAY_NONE;
}

test a_broken_chain_is_unverifiable_and_charges_nothing {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED - R_LEASE_IN_DISPATCH, S_ACCEPT, 1) == OUT_UNVERIFIABLE_NOT_CHARGED;
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED - R_PR_FROM_DISPATCH, S_ACCEPT, 1) == OUT_UNVERIFIABLE_NOT_CHARGED;
}

test only_an_accepted_dispatch_earns {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED, S_SENDBACK, 1) == OUT_NOT_ELIGIBLE;
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED, S_EMPTY, 1) == OUT_NOT_ELIGIBLE;
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED, S_REFUSED, 1) == OUT_NOT_ELIGIBLE;
}

test unmerged_or_untraced_work_earns_nothing {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED - R_MERGED, S_ACCEPT, 1) == OUT_NOT_ELIGIBLE;
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED - R_CLOSES_TASK, S_ACCEPT, 1) == OUT_NOT_ELIGIBLE;
}

test a_credit_needs_a_verified_named_verdict {
    assert receipt_outcome(KO_CONTRIBUTOR, 42, R_LANDED - R_GATE_POLICY, S_ACCEPT, 1) == OUT_CREDITED;
    assert credit_mtri(KO_CONTRIBUTOR, 42, R_LANDED - R_GATE_POLICY, S_ACCEPT, 1) == 0;
    assert credit_mtri(KO_CONTRIBUTOR, 42, R_LANDED - R_VERDICT_NAMED, S_ACCEPT, 1) == 0;
}

// Every one of the 512 fact sets, for a contributor and a pool key, at each of a few dispatch states:
// credit only for exactly the landed set, a key owner is never slashed, and every refusal pays nothing.
test only_the_whole_chain_is_credited_and_no_key_is_slashed {
    let states : [4]u32 = [S_ACCEPT, S_SENDBACK, S_EMPTY, S_REFUSED];
    var f : u32 = 0;
    while (f < 512) {
        var s : u32 = 0;
        while (s < 4) {
            let st : u32 = states[s];
            let o : u8 = receipt_outcome(KO_CONTRIBUTOR, 42, f, st, 2);
            assert o != OUT_REJECTED_AND_SLASHED;
            assert receipt_pay(KO_CONTRIBUTOR, 42, f, st, 2) != PAY_SLASH_ONLY;
            let whole : bool = (f == R_LANDED) and (st == S_ACCEPT);
            assert (credit_mtri(KO_CONTRIBUTOR, 42, f, st, 2) == KEY_CREDIT_MTRI) == whole;
            assert credit_mtri(KO_QUEEN, 42, f, st, 2) == 0;
            s = s + 1;
        }
        f = f + 1;
    }
}

test a_key_is_named_by_its_id_never_its_value {
    assert key_id_ok(16, true);
    assert key_id_ok(16, false) == false;
    assert key_id_ok(15, true) == false;
    assert key_id_ok(64, true) == false;
    assert key_id_ok(49, true) == false;
}
