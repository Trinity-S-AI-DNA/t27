// SPDX-License-Identifier: Apache-2.0
; specs/queen/team_msg.t27 -- a team of agents and the mail between sessions, as actor messages.
; gHashTag/t27#13310, order SWARM_BEST_PRACTICES (GODMODE epic #13260, actor epic #6971), 2026-11-08.
; Studied: Claude Code agent teams (one fixed lead, teammates with their own context, a
; shared task list with dependencies and a lock on claim, plan approval, shutdown requests that a
; teammate may reject, idle notices, no nested teams) and cross-session messaging (ListAgents and
; SendMessage: plain text only, accept/hold/refuse on the receiving side, size, queue and repeat
; limits, and a message is never consent).
; This file reads the tags, lanes and supervisors of specs/queen/actors.t27 and the fenced claim of
; specs/queen/control.t27 and edits neither. Like claim_msg.t27 (16..18), key_rotation_msg.t27
; (19..21), lab_job_msg.t27 (22..24) and payout_evidence_msg.t27 (25..27), it sits on tags of its own,
; 28..35, under the 64 tags one control lane word holds. A team is NOT a new actor kind: it is a
; supervisor with the flags actors.t27 already has (section 6: "a one_for_all team under a lead task is
; where AUTO_ANY_SIGNIFICANT belongs"). The task list is NOT a second queue: a team task is claimed by
; control.t27 claim_lands, behind one new gate, its dependencies (dispatch.t27 DEPENDENCY_RULE: none
; read today). The numbers marked "docs" are read from the Claude Code docs on 2026-11-08, not measured.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenTeamMsg;

use queen::actors;
use queen::control::claim_lands;
use queen::control::NO_HOLDER;
use queen::agent_card::ROLE_SOLO;
use queen::agent_card::ROLE_LEAD;
use queen::agent_card::ROLE_MATE;

; --- 1. Tags and lanes ------------------------------------------------------------------------------

/// A mate's finding, to the lead or to another mate.
pub const TM_TAG_FINDING : u64 = 28;
/// A mate in plan mode asks the lead to approve its plan before it edits.
pub const TM_TAG_PLAN_ASK : u64 = 29;
/// The lead's answer to a plan.
pub const TM_TAG_PLAN_ANSWER : u64 = 30;
/// The lead asks a mate to stop.
pub const TM_TAG_STOP_ASK : u64 = 31;
/// The mate's answer: it may approve or reject.
pub const TM_TAG_STOP_ANSWER : u64 = 32;
/// A mate went idle or exited. One notice per watch: the control lane coalesces it.
pub const TM_TAG_IDLE : u64 = 33;
/// A card was re-published (agent_card.t27): the receiver re-reads the row, the message carries no card.
pub const TM_TAG_CARD : u64 = 34;
/// A plain-text note between sessions: the only tag that crosses a session boundary.
pub const TM_TAG_PEER : u64 = 35;
pub const TM_TAG_FIRST : u64 = 28;
pub const TM_TAG_LAST : u64 = 35;

pub fn tm_known_tag(tag: u64) -> bool {
    if (tag < TM_TAG_FIRST) { return false; }
    return tag <= TM_TAG_LAST;
}

/// Answers, a stop and an idle notice ride the control lane (taken first, one per kind); the rest are
/// data. The numbers are actors.t27's LANE_DATA and LANE_CONTROL.
pub fn tm_lane(tag: u64) -> u8 {
    if (tm_known_tag(tag) == false) { return LANE_NONE; }
    if (tag == TM_TAG_PLAN_ANSWER) { return LANE_CONTROL; }
    if (tag == TM_TAG_STOP_ASK) { return LANE_CONTROL; }
    if (tag == TM_TAG_STOP_ANSWER) { return LANE_CONTROL; }
    if (tag == TM_TAG_IDLE) { return LANE_CONTROL; }
    return LANE_DATA;
}

/// Who may send what. Across sessions only a plain-text note (docs: structured protocol messages stay
/// inside a team). Inside a team: the lead answers plans and asks stops; a mate asks plans, answers
/// stops and goes idle; either sends findings, notes and card notices.
pub fn tm_may_send(tag: u64, sender_role: u8, same_team: bool) -> bool {
    if (tm_known_tag(tag) == false) { return false; }
    if (tag == TM_TAG_PEER) { return true; }
    if (same_team == false) { return false; }
    if (sender_role == ROLE_SOLO) { return false; }
    if (tag == TM_TAG_PLAN_ANSWER) { return sender_role == ROLE_LEAD; }
    if (tag == TM_TAG_STOP_ASK) { return sender_role == ROLE_LEAD; }
    if (tag == TM_TAG_PLAN_ASK) { return sender_role == ROLE_MATE; }
    if (tag == TM_TAG_STOP_ANSWER) { return sender_role == ROLE_MATE; }
    if (tag == TM_TAG_IDLE) { return sender_role == ROLE_MATE; }
    return true;
}

; --- 2. A message is never consent ------------------------------------------------------------------

/// What a message could be taken to allow. GRANT_PLAN: a mate starts editing after its plan was
/// approved, a team's own workflow. GRANT_PERMISSION: anything a person approves -- a push, a merge, a
/// message outside, a payment, a settings change.
pub const GRANT_PLAN : u8 = 0;
pub const GRANT_PERMISSION : u8 = 1;
pub const PEER_MESSAGE_IS_CONSENT : bool = false;

pub fn mail_may_grant(tag: u64, act: u8) -> bool {
    if (act == GRANT_PERMISSION) { return PEER_MESSAGE_IS_CONSENT; }
    if (act == GRANT_PLAN) { return tag == TM_TAG_PLAN_ANSWER; }
    return false;
}

/// The plan gate: a mate that must plan first edits only after the lead approved.
pub fn edit_allowed(plan_required: bool, plan_approved: bool) -> bool {
    if (plan_required == false) { return true; }
    return plan_approved;
}

; --- 3. The receiving side of a cross-session note --------------------------------------------------

pub const IN_ACCEPT : u8 = 0;
pub const IN_HOLD : u8 = 1;
pub const IN_REFUSE : u8 = 2;
/// docs: at most 100 held notes, a hold dialog closes after 5 minutes, at most 50 queued, a body of
/// about one million characters.
pub const HOLD_CAP : u32 = 100;
pub const HOLD_EXPIRY_SECONDS : u32 = 300;
pub const QUEUE_CAP : u32 = 50;
pub const BODY_CAP_CHARS : u32 = 1000000;

/// One note in, one answer. `policy` is the receiver's setting (accept, hold or refuse); `repeat` is a
/// body identical to the sender's last; `rate_ok` is the per-sender limit. Limits come before policy:
/// a note too big, repeated or too fast is refused whatever the policy, so a loop of two agents stops
/// on its own.
pub fn inbound_answer(policy: u8, held: u32, queued: u32, body_len: u32, repeat: bool, rate_ok: bool) -> u8 {
    if (policy > IN_REFUSE) { return IN_REFUSE; }
    if (policy == IN_REFUSE) { return IN_REFUSE; }
    if (body_len > BODY_CAP_CHARS) { return IN_REFUSE; }
    if (repeat) { return IN_REFUSE; }
    if (rate_ok == false) { return IN_REFUSE; }
    if (queued >= QUEUE_CAP) { return IN_REFUSE; }
    if (policy == IN_HOLD) {
        if (held >= HOLD_CAP) { return IN_REFUSE; }
        return IN_HOLD;
    }
    return IN_ACCEPT;
}

/// A held note waits for a person. Whether the docs drop or deliver an expired hold is not
/// established; this spec reads it as dropped, the side that grants nothing.
pub fn hold_expired(age_seconds: u32) -> bool {
    return age_seconds >= HOLD_EXPIRY_SECONDS;
}

pub fn is_repeat(last_body_hash: u64, body_hash: u64) -> bool {
    if (last_body_hash == 0) { return false; }
    return last_body_hash == body_hash;
}

; --- 4. Idle notices and stops ----------------------------------------------------------------------

/// docs: a watch gives one notice when the watched agent goes idle or exits, and lapses after 12 hours.
pub const IDLE_WATCH_SECONDS : u32 = 43200;

pub fn idle_notice_due(watching: bool, sent: bool, went_idle: bool, exited: bool, watch_age_seconds: u32) -> bool {
    if (watching == false) { return false; }
    if (sent) { return false; }
    if (watch_age_seconds >= IDLE_WATCH_SECONDS) { return false; }
    if (went_idle) { return true; }
    return exited;
}

pub const STOP_APPROVE : u8 = 0;
pub const STOP_REJECT : u8 = 1;

/// A mate rejects a stop while it holds a live task lease (control.t27), and approves otherwise.
pub fn stop_answer(holds_live_lease: bool) -> u8 {
    if (holds_live_lease) { return STOP_REJECT; }
    return STOP_APPROVE;
}

/// An approved stop ends the mate with X_SHUTDOWN, which no restart type undoes. A rejected one leaves
/// it running (X_NONE); the lead's supervisor can still stop it the actors.t27 way, stop_signal.
pub fn stop_exit_reason(answer: u8) -> u8 {
    if (answer == STOP_APPROVE) { return X_SHUTDOWN; }
    return X_NONE;
}

; --- 5. A team is a supervisor --------------------------------------------------------------------

/// Child 0 is the lead: transient and significant, so its normal end ends the team (the docs' lead
/// cleans up the team) and its crash restarts it. Mates are temporary: a mate's crash touches nobody
/// (stopped_by_restart is false when the failed child is not restarted), and a lead's crash stops the
/// mates and restarts none of them (docs: in-process teammates are not resumed). The team supervisor
/// is temporary itself, so its own auto shutdown sticks (auto_shutdown_sticks).
pub const TEAM_STRATEGY : u8 = STRAT_ONE_FOR_ALL;
pub const TEAM_AUTO_SHUTDOWN : u8 = AUTO_ANY_SIGNIFICANT;
pub const LEAD_RESTART : u8 = RESTART_TRANSIENT;
pub const MATE_RESTART : u8 = RESTART_TEMPORARY;
pub const TEAM_SUP_RESTART : u8 = RESTART_TEMPORARY;
pub const LEAD_CHILD : u32 = 0;
/// docs' advice: 3 to 5 teammates, 5 or 6 tasks each. Chosen from it, not measured here.
pub const TEAM_MAX_MATES : u32 = 5;
pub const TEAM_TASKS_PER_MATE : u32 = 6;
/// One task list is one u64 word of done bits.
pub const TEAM_TASK_CAP : u32 = 64;

/// One more mate starts only under the cap, counted the actors.t27 way (a stopping child still counts).
pub fn team_may_start_mate(live: u32, stopping: u32) -> bool {
    return start_answer(live, stopping, TEAM_MAX_MATES) == START_OK;
}

/// No nested teams: only an agent outside a team may start one, and a session leads at most one.
pub fn may_start_team(role: u8, leads_now: u32) -> bool {
    if (role != ROLE_SOLO) { return false; }
    return leads_now == 0;
}

; --- 6. The shared task list: a dependency gate in front of the fenced claim ------------------------

/// Tasks of one team are numbered 0..63; `deps` and `done` are masks over them.
pub fn deps_ready(deps: u64, done: u64) -> bool {
    return (deps & done) == deps;
}

/// A task that names itself as a dependency can never start: refuse it when the list is written.
pub fn deps_without_self(task: u64, deps: u64) -> bool {
    if (task >= 64) { return false; }
    return (deps & bit(task)) == 0;
}

/// A claim lands when its dependencies are done AND the control.t27 fenced claim lands. The fence is
/// the docs' lock on claim; this file adds only the dependency gate.
pub fn team_claim_lands(deps: u64, done: u64, holder: u32, me: u32, expired: bool, fence: u64, fence_read: u64) -> bool {
    if (deps_ready(deps, done) == false) { return false; }
    return claim_lands(holder, me, expired, fence, fence_read);
}

; --- 6b. Team port piece 1 (gHashTag/t27#13894): member statuses and task-graph validation ----------
; Read from the DSH Team plugin (deepseek-harness packages/experimental/agent-team roster.ts and
; task-graph.ts, read-only): a member is provisioning until its child session settles, then active
; (shown as running or inactive by whether its agent runs) or failed; an active member never becomes
; failed (the source calls that edge impossible) and nothing returns to provisioning.

pub const MS_PROVISIONING : u8 = 0;
pub const MS_RUNNING : u8 = 1;
pub const MS_INACTIVE : u8 = 2;
pub const MS_FAILED : u8 = 3;

pub fn member_status_known(s: u8) -> bool {
    return s <= MS_FAILED;
}

/// Is a change of a member's status from `from` to `to` allowed? provisioning settles to running,
/// inactive or failed; running and inactive swap; failed is final; a repeat is not a change.
pub fn member_transition_allowed(from: u8, to: u8) -> bool {
    if (member_status_known(from) == false) { return false; }
    if (member_status_known(to) == false) { return false; }
    if (from == MS_PROVISIONING) { return to != MS_PROVISIONING; }
    if (from == MS_RUNNING) { return to == MS_INACTIVE; }
    if (from == MS_INACTIVE) { return to == MS_RUNNING; }
    return false;
}

/// Validation codes, in the order they are tried.
pub const DEP_OK : u8 = 0;
pub const DEP_MISSING : u8 = 1;
pub const DEP_DUPLICATE : u8 = 2;
pub const DEP_SELF : u8 = 3;
pub const DEP_CYCLE : u8 = 4;
/// "No offending task": one past the last task number.
pub const DEP_NO_TASK : u64 = 64;

pub struct DepCheck {
    code: u8,
    task: u64,
}

/// How many bits are set in a mask.
pub fn mask_count(m: u64) -> u32 {
    var n : u32 = 0;
    var k : u64 = 0;
    while (k < 64) {
        if (((m >> k) & 1) == 1) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

/// The lowest task number in a mask, or DEP_NO_TASK for an empty one.
pub fn mask_first(m: u64) -> u64 {
    var k : u64 = 0;
    while (k < 64) {
        if (((m >> k) & 1) == 1) { return k; }
        k = k + 1;
    }
    return DEP_NO_TASK;
}

/// Validate one task written with its blockers. `deps` is the blocker mask, `listed` the number of
/// blockers the author wrote (a repeat makes it larger than the mask's count), `exist` the tasks that
/// exist, `downstream` the tasks that already wait on `task`, directly or not (the caller keeps that
/// closure). Order: self, duplicate, missing, cycle. The offender is `task` for self and duplicate
/// (a mask cannot say which blocker repeated), the lowest absent blocker for missing, and the lowest
/// blocker that already waits on `task` for cycle.
pub fn dep_check(task: u64, deps: u64, listed: u32, exist: u64, downstream: u64) -> DepCheck {
    if (task >= 64) { return DepCheck{.code = DEP_MISSING, .task = task}; }
    if (deps_without_self(task, deps) == false) { return DepCheck{.code = DEP_SELF, .task = task}; }
    if (listed != mask_count(deps)) { return DepCheck{.code = DEP_DUPLICATE, .task = task}; }
    var absent : u64 = deps - (deps & exist);
    if (absent != 0) { return DepCheck{.code = DEP_MISSING, .task = mask_first(absent)}; }
    var loop : u64 = deps & downstream;
    if (loop != 0) { return DepCheck{.code = DEP_CYCLE, .task = mask_first(loop)}; }
    return DepCheck{.code = DEP_OK, .task = DEP_NO_TASK};
}

; --- 6c. Team port piece 2 (gHashTag/t27#13906): the task board -------------------------------------
; Read from the DSH Team plugin task-board (read-only): four statuses; a claim needs an unowned pending
; task whose blockers are all completed; release and complete need an in_progress task and its owner
; or the lead; reopen needs a completed task; delete is refused while a live task depends on it.
; Chosen here, not read: reopen and release both return the task to pending; a deleted blocker never
; counts as done, so its dependents stay blocked; the board window is 8 tasks (the array shape
; actor_view.t27 already uses), wider lists page by 8. Slot i is task number i.

pub const TS_PENDING : u8 = 0;
pub const TS_IN_PROGRESS : u8 = 1;
pub const TS_COMPLETED : u8 = 2;
pub const TS_DELETED : u8 = 3;
/// An unused slot on the board: it is no task and is never counted.
pub const TS_EMPTY : u8 = 255;
pub const BOARD_SLOTS : u32 = 8;
/// "No claimable task": one past the last slot.
pub const BOARD_NONE : u32 = 8;

/// Refusal codes, one per rule broken, in the order each rule tries them.
pub const BR_OK : u8 = 0;
pub const BR_UNKNOWN_STATUS : u8 = 1;
pub const BR_NOT_PENDING : u8 = 2;
pub const BR_OWNED : u8 = 3;
pub const BR_BLOCKED : u8 = 4;
pub const BR_NOT_IN_PROGRESS : u8 = 5;
pub const BR_NOT_OWNER : u8 = 6;
pub const BR_NOT_COMPLETED : u8 = 7;
pub const BR_ALREADY_DELETED : u8 = 8;
pub const BR_HAS_LIVE_DEPENDENT : u8 = 9;

pub fn task_status_known(s: u8) -> bool {
    return s <= TS_DELETED;
}

/// Allowed status changes: pending starts (claim) or is deleted; in_progress goes back (release),
/// finishes (complete) or is deleted; completed reopens to pending or is deleted; deleted is final;
/// a repeat is not a change.
pub fn task_transition_allowed(from: u8, to: u8) -> bool {
    if (task_status_known(from) == false) { return false; }
    if (task_status_known(to) == false) { return false; }
    if (from == TS_DELETED) { return false; }
    if (to == TS_DELETED) { return true; }
    if (from == TS_PENDING) { return to == TS_IN_PROGRESS; }
    if (from == TS_IN_PROGRESS) {
        if (to == TS_PENDING) { return true; }
        return to == TS_COMPLETED;
    }
    return to == TS_PENDING;
}

/// Claim: an unowned pending task whose blockers are all completed (`done` is the completed mask).
pub fn claim_refusal(status: u8, owner: u32, deps: u64, done: u64) -> u8 {
    if (task_status_known(status) == false) { return BR_UNKNOWN_STATUS; }
    if (status != TS_PENDING) { return BR_NOT_PENDING; }
    if (owner != NO_HOLDER) { return BR_OWNED; }
    if (deps_ready(deps, done) == false) { return BR_BLOCKED; }
    return BR_OK;
}

/// Release and complete share one rule: an in_progress task, and the caller is its owner or the lead.
pub fn holder_refusal(status: u8, owner: u32, me: u32, role: u8) -> u8 {
    if (task_status_known(status) == false) { return BR_UNKNOWN_STATUS; }
    if (status != TS_IN_PROGRESS) { return BR_NOT_IN_PROGRESS; }
    if (role == ROLE_LEAD) { return BR_OK; }
    if (me != NO_HOLDER and me == owner) { return BR_OK; }
    return BR_NOT_OWNER;
}

pub fn release_refusal(status: u8, owner: u32, me: u32, role: u8) -> u8 {
    return holder_refusal(status, owner, me, role);
}

pub fn complete_refusal(status: u8, owner: u32, me: u32, role: u8) -> u8 {
    return holder_refusal(status, owner, me, role);
}

/// Reopen: only a completed task.
pub fn reopen_refusal(status: u8) -> u8 {
    if (task_status_known(status) == false) { return BR_UNKNOWN_STATUS; }
    if (status != TS_COMPLETED) { return BR_NOT_COMPLETED; }
    return BR_OK;
}

/// Delete: refused while a live task depends on it. `live_deps` is the union of the blocker masks of
/// the live tasks (board_live_deps).
pub fn delete_refusal(status: u8, task: u64, live_deps: u64) -> u8 {
    if (task_status_known(status) == false) { return BR_UNKNOWN_STATUS; }
    if (status == TS_DELETED) { return BR_ALREADY_DELETED; }
    if (task >= 64) { return BR_UNKNOWN_STATUS; }
    if ((live_deps & bit(task)) != 0) { return BR_HAS_LIVE_DEPENDENT; }
    return BR_OK;
}

/// The completed tasks of a board, as a mask.
pub fn board_done(statuses: [8]u8) -> u64 {
    var m : u64 = 0;
    var i : u32 = 0;
    while (i < BOARD_SLOTS) {
        if (statuses[i] == TS_COMPLETED) { m = m | bit(i); }
        i = i + 1;
    }
    return m;
}

/// The union of the blocker masks of the live tasks (pending or in_progress).
pub fn board_live_deps(statuses: [8]u8, deps: [8]u64) -> u64 {
    var m : u64 = 0;
    var i : u32 = 0;
    while (i < BOARD_SLOTS) {
        if (statuses[i] == TS_PENDING) { m = m | deps[i]; }
        if (statuses[i] == TS_IN_PROGRESS) { m = m | deps[i]; }
        i = i + 1;
    }
    return m;
}

/// The next claimable task: the lowest slot that passes the claim rule, or BOARD_NONE.
pub fn next_claimable(statuses: [8]u8, owners: [8]u32, deps: [8]u64) -> u32 {
    var done : u64 = board_done(statuses);
    var i : u32 = 0;
    while (i < BOARD_SLOTS) {
        if (claim_refusal(statuses[i], owners[i], deps[i], done) == BR_OK) { return i; }
        i = i + 1;
    }
    return BOARD_NONE;
}

pub struct BoardSummary {
    pending: u32,
    in_progress: u32,
    completed: u32,
    deleted: u32,
    blocked: u32,
}

/// Count per status, and how many pending tasks wait on a blocker that is not completed.
pub fn board_summary(statuses: [8]u8, deps: [8]u64) -> BoardSummary {
    var done : u64 = board_done(statuses);
    var p : u32 = 0;
    var g : u32 = 0;
    var c : u32 = 0;
    var d : u32 = 0;
    var b : u32 = 0;
    var i : u32 = 0;
    while (i < BOARD_SLOTS) {
        if (statuses[i] == TS_PENDING) {
            p = p + 1;
            if (deps_ready(deps[i], done) == false) { b = b + 1; }
        }
        if (statuses[i] == TS_IN_PROGRESS) { g = g + 1; }
        if (statuses[i] == TS_COMPLETED) { c = c + 1; }
        if (statuses[i] == TS_DELETED) { d = d + 1; }
        i = i + 1;
    }
    return BoardSummary{.pending = p, .in_progress = g, .completed = c, .deleted = d, .blocked = b};
}

/// Fixture A: 0 completed, 1 pending (ready), 2 pending (blocked on 0 and 3), 3 in_progress by 7,
/// 4 deleted, 5..7 empty.
pub const TB_STATUS : [8]u8 = [2, 0, 0, 1, 3, 255, 255, 255];
pub const TB_OWNER : [8]u32 = [5, 0, 0, 7, 0, 0, 0, 0];
pub const TB_DEPS : [8]u64 = [0, 1, 9, 0, 0, 0, 0, 0];
/// Fixture B: 0 pending but owned, 1 pending blocked on 0, 2 pending free.
pub const TB2_STATUS : [8]u8 = [0, 0, 0, 255, 255, 255, 255, 255];
pub const TB2_OWNER : [8]u32 = [4, 0, 0, 0, 0, 0, 0, 0];
pub const TB2_DEPS : [8]u64 = [0, 1, 0, 0, 0, 0, 0, 0];
/// Fixture C: nothing to claim: 0 completed, 1 in_progress, 2 pending blocked on 1.
pub const TB3_STATUS : [8]u8 = [2, 1, 0, 255, 255, 255, 255, 255];
pub const TB3_OWNER : [8]u32 = [1, 2, 0, 0, 0, 0, 0, 0];
pub const TB3_DEPS : [8]u64 = [0, 0, 2, 0, 0, 0, 0, 0];

; --- 7. The record of a cross-session note ----------------------------------------------------------

/// The body itself is not in the row: only its hash and length, so the store keeps no free text
/// beyond the receiver's own transcript.
pub struct PeerNote {
    from: u64,
    to: u64,
    tag: u64,
    seq: u32,
    body_hash: u64,
    body_len: u32,
}

pub fn peer_note(from: u64, to: u64, seq: u32, body_hash: u64, body_len: u32) -> PeerNote {
    return PeerNote{.from = from, .to = to, .tag = TM_TAG_PEER, .seq = seq, .body_hash = body_hash,
        .body_len = body_len};
}

; --- Invariants and tests -------------------------------------------------------------------------

invariant the_team_tags_sit_above_every_other_protocol { assert TM_TAG_FIRST == 28 and TM_TAG_LAST == TM_TAG_PEER and TM_TAG_LAST < CTL_TAGS; }
invariant the_team_tags_are_contiguous { assert TM_TAG_PLAN_ASK == TM_TAG_FINDING + 1 and TM_TAG_PLAN_ANSWER == TM_TAG_PLAN_ASK + 1 and TM_TAG_STOP_ASK == TM_TAG_PLAN_ANSWER + 1 and TM_TAG_STOP_ANSWER == TM_TAG_STOP_ASK + 1 and TM_TAG_IDLE == TM_TAG_STOP_ANSWER + 1 and TM_TAG_CARD == TM_TAG_IDLE + 1 and TM_TAG_PEER == TM_TAG_CARD + 1; }
invariant a_message_is_never_consent { assert PEER_MESSAGE_IS_CONSENT == false; }
invariant the_team_shape_is_a_valid_supervisor { assert child_spec_valid(LEAD_RESTART, true, TEAM_AUTO_SHUTDOWN) and child_spec_valid(MATE_RESTART, false, TEAM_AUTO_SHUTDOWN) and auto_shutdown_sticks(TEAM_SUP_RESTART); }
invariant a_full_team_fits_one_task_word { assert TEAM_MAX_MATES * TEAM_TASKS_PER_MATE <= TEAM_TASK_CAP; }

test the_tags_ride_the_lanes_they_should {
    assert tm_lane(TM_TAG_FINDING) == LANE_DATA;
    assert tm_lane(TM_TAG_PEER) == LANE_DATA;
    assert tm_lane(TM_TAG_STOP_ASK) == LANE_CONTROL;
    assert tm_lane(TM_TAG_IDLE) == LANE_CONTROL;
    assert tm_lane(27) == LANE_NONE;
    assert tm_lane(36) == LANE_NONE;
}

test only_a_plain_note_crosses_a_session {
    assert tm_may_send(TM_TAG_PEER, ROLE_SOLO, false) == true;
    assert tm_may_send(TM_TAG_FINDING, ROLE_MATE, false) == false;
    assert tm_may_send(TM_TAG_PLAN_ANSWER, ROLE_LEAD, false) == false;
    assert tm_may_send(TM_TAG_FINDING, ROLE_MATE, true) == true;
}

test the_lead_answers_plans_and_the_mate_answers_stops {
    assert tm_may_send(TM_TAG_PLAN_ANSWER, ROLE_LEAD, true) == true;
    assert tm_may_send(TM_TAG_PLAN_ANSWER, ROLE_MATE, true) == false;
    assert tm_may_send(TM_TAG_STOP_ASK, ROLE_MATE, true) == false;
    assert tm_may_send(TM_TAG_STOP_ANSWER, ROLE_MATE, true) == true;
    assert tm_may_send(TM_TAG_IDLE, ROLE_LEAD, true) == false;
    assert tm_may_send(TM_TAG_FINDING, ROLE_SOLO, true) == false;
}

test no_message_grants_a_permission {
    assert mail_may_grant(TM_TAG_PLAN_ANSWER, GRANT_PERMISSION) == false;
    assert mail_may_grant(TM_TAG_PEER, GRANT_PERMISSION) == false;
    assert mail_may_grant(TM_TAG_PLAN_ANSWER, GRANT_PLAN) == true;
    assert mail_may_grant(TM_TAG_PEER, GRANT_PLAN) == false;
    assert edit_allowed(true, false) == false;
    assert edit_allowed(true, true) == true;
    assert edit_allowed(false, false) == true;
}

test limits_refuse_before_the_policy_is_read {
    assert inbound_answer(IN_ACCEPT, 0, 0, 10, false, true) == IN_ACCEPT;
    assert inbound_answer(IN_HOLD, 0, 0, 10, false, true) == IN_HOLD;
    assert inbound_answer(IN_REFUSE, 0, 0, 10, false, true) == IN_REFUSE;
    assert inbound_answer(IN_ACCEPT, 0, 0, 1000001, false, true) == IN_REFUSE;
    assert inbound_answer(IN_ACCEPT, 0, 0, 1000000, false, true) == IN_ACCEPT;
    assert inbound_answer(IN_ACCEPT, 0, 0, 10, true, true) == IN_REFUSE;
    assert inbound_answer(IN_ACCEPT, 0, 0, 10, false, false) == IN_REFUSE;
    assert inbound_answer(IN_ACCEPT, 0, 50, 10, false, true) == IN_REFUSE;
    assert inbound_answer(IN_ACCEPT, 0, 49, 10, false, true) == IN_ACCEPT;
    assert inbound_answer(IN_HOLD, 100, 0, 10, false, true) == IN_REFUSE;
    assert inbound_answer(IN_HOLD, 99, 0, 10, false, true) == IN_HOLD;
    assert inbound_answer(7, 0, 0, 10, false, true) == IN_REFUSE;
}

test a_hold_lapses_at_five_minutes_and_a_repeat_needs_a_last {
    assert hold_expired(299) == false;
    assert hold_expired(300) == true;
    assert is_repeat(0, 0) == false;
    assert is_repeat(9, 9) == true;
    assert is_repeat(9, 8) == false;
}

test one_idle_notice_per_watch_and_none_after_twelve_hours {
    assert idle_notice_due(true, false, true, false, 10) == true;
    assert idle_notice_due(true, false, false, true, 10) == true;
    assert idle_notice_due(true, true, true, false, 10) == false;
    assert idle_notice_due(false, false, true, false, 10) == false;
    assert idle_notice_due(true, false, true, false, 43200) == false;
    assert idle_notice_due(true, false, false, false, 10) == false;
}

test a_mate_mid_task_rejects_a_stop {
    assert stop_answer(true) == STOP_REJECT;
    assert stop_answer(false) == STOP_APPROVE;
    assert stop_exit_reason(STOP_APPROVE) == X_SHUTDOWN;
    assert stop_exit_reason(STOP_REJECT) == X_NONE;
    assert should_restart(MATE_RESTART, X_SHUTDOWN) == false;
    assert should_restart(LEAD_RESTART, X_SHUTDOWN) == false;
}

test a_mate_crash_touches_nobody_and_a_lead_crash_stops_the_mates {
    assert should_restart(MATE_RESTART, X_CRASH) == false;
    assert stopped_by_restart(TEAM_STRATEGY, 2, LEAD_CHILD, false) == false;
    assert stopped_by_restart(TEAM_STRATEGY, 2, 1, false) == false;
    assert should_restart(LEAD_RESTART, X_CRASH) == true;
    assert stopped_by_restart(TEAM_STRATEGY, LEAD_CHILD, 1, true) == true;
    assert restarted(TEAM_STRATEGY, LEAD_CHILD, 1, MATE_RESTART, true) == false;
}

test the_lead_ending_ends_the_team_and_a_mate_ending_does_not {
    assert auto_shutdown_after_exit(TEAM_AUTO_SHUTDOWN, true, LEAD_RESTART, X_NORMAL, false, 0) == true;
    assert auto_shutdown_after_exit(TEAM_AUTO_SHUTDOWN, true, LEAD_RESTART, X_CRASH, false, 1) == false;
    assert auto_shutdown_after_exit(TEAM_AUTO_SHUTDOWN, false, MATE_RESTART, X_NORMAL, false, 1) == false;
}

test the_cap_and_no_nesting {
    assert team_may_start_mate(4, 0) == true;
    assert team_may_start_mate(5, 0) == false;
    assert team_may_start_mate(4, 1) == false;
    assert may_start_team(ROLE_SOLO, 0) == true;
    assert may_start_team(ROLE_SOLO, 1) == false;
    assert may_start_team(ROLE_MATE, 0) == false;
    assert may_start_team(ROLE_LEAD, 0) == false;
}

test a_blocked_task_is_not_claimed_even_when_the_fence_agrees {
    assert deps_ready(6, 6) == true;
    assert deps_ready(6, 2) == false;
    assert deps_ready(0, 0) == true;
    assert team_claim_lands(6, 2, 0, 9, false, 5, 5) == false;
    assert team_claim_lands(6, 7, 0, 9, false, 5, 5) == true;
    assert team_claim_lands(6, 7, 0, 9, false, 5, 4) == false;
    assert team_claim_lands(6, 7, 3, 9, false, 5, 5) == false;
}

test a_task_cannot_wait_on_itself {
    assert deps_without_self(1, 6) == false;
    assert deps_without_self(0, 6) == true;
    assert deps_without_self(64, 0) == false;
}

test a_note_row_carries_no_body {
    var n : PeerNote = peer_note(11, 12, 3, 99, 40);
    assert n.tag == TM_TAG_PEER;
    assert n.seq == 3;
    assert n.body_len == 40;
    assert tm_may_send(n.tag, ROLE_SOLO, false) == true;
}

test member_status_transitions_follow_the_roster {
    assert member_transition_allowed(MS_PROVISIONING, MS_RUNNING) == true;
    assert member_transition_allowed(MS_PROVISIONING, MS_INACTIVE) == true;
    assert member_transition_allowed(MS_PROVISIONING, MS_FAILED) == true;
    assert member_transition_allowed(MS_RUNNING, MS_INACTIVE) == true;
    assert member_transition_allowed(MS_INACTIVE, MS_RUNNING) == true;
}

test a_refused_status_transition_stays_refused {
    assert member_transition_allowed(MS_RUNNING, MS_FAILED) == false;
    assert member_transition_allowed(MS_INACTIVE, MS_FAILED) == false;
    assert member_transition_allowed(MS_RUNNING, MS_PROVISIONING) == false;
    assert member_transition_allowed(MS_INACTIVE, MS_PROVISIONING) == false;
    assert member_transition_allowed(MS_FAILED, MS_RUNNING) == false;
    assert member_transition_allowed(MS_FAILED, MS_INACTIVE) == false;
    assert member_transition_allowed(MS_FAILED, MS_PROVISIONING) == false;
    assert member_transition_allowed(MS_PROVISIONING, MS_PROVISIONING) == false;
    assert member_transition_allowed(MS_RUNNING, MS_RUNNING) == false;
    assert member_transition_allowed(4, MS_RUNNING) == false;
    assert member_transition_allowed(MS_PROVISIONING, 4) == false;
}

test a_clean_task_list_entry_validates_ok {
    assert dep_check(3, 6, 2, 63, 0).code == DEP_OK;
    assert dep_check(3, 6, 2, 63, 0).task == DEP_NO_TASK;
    assert dep_check(3, 0, 0, 63, 0).code == DEP_OK;
    assert mask_count(6) == 2;
    assert mask_first(6) == 1;
    assert mask_first(0) == DEP_NO_TASK;
}

test a_missing_blocker_names_the_lowest_absent_task {
    assert dep_check(3, 6, 2, 2, 0).code == DEP_MISSING;
    assert dep_check(3, 6, 2, 2, 0).task == 2;
    assert dep_check(3, 6, 2, 4, 0).task == 1;
    assert dep_check(3, 6, 2, 6, 0).code == DEP_OK;
    assert dep_check(64, 0, 0, 63, 0).code == DEP_MISSING;
}

test a_repeated_blocker_is_a_duplicate {
    assert dep_check(3, 6, 3, 63, 0).code == DEP_DUPLICATE;
    assert dep_check(3, 6, 3, 63, 0).task == 3;
    assert dep_check(3, 6, 2, 63, 0).code == DEP_OK;
}

test a_task_that_blocks_itself_is_refused_as_self {
    assert dep_check(1, 6, 2, 63, 0).code == DEP_SELF;
    assert dep_check(1, 6, 2, 63, 0).task == 1;
    assert dep_check(0, 6, 2, 63, 0).code == DEP_OK;
}

test a_blocker_that_already_waits_on_the_task_is_a_cycle {
    assert dep_check(3, 6, 2, 63, 4).code == DEP_CYCLE;
    assert dep_check(3, 6, 2, 63, 4).task == 2;
    assert dep_check(3, 6, 2, 63, 8).code == DEP_OK;
    assert dep_check(3, 6, 2, 63, 2).task == 1;
}

test validation_codes_are_tried_in_order {
    assert dep_check(1, 6, 3, 0, 6).code == DEP_SELF;
    assert dep_check(3, 6, 3, 0, 6).code == DEP_DUPLICATE;
    assert dep_check(3, 6, 2, 0, 6).code == DEP_MISSING;
}

invariant the_task_statuses_are_contiguous { assert TS_IN_PROGRESS == TS_PENDING + 1 and TS_COMPLETED == TS_IN_PROGRESS + 1 and TS_DELETED == TS_COMPLETED + 1 and BOARD_NONE == BOARD_SLOTS; }

test task_status_transitions_follow_the_board {
    assert task_transition_allowed(TS_PENDING, TS_IN_PROGRESS) == true;
    assert task_transition_allowed(TS_IN_PROGRESS, TS_PENDING) == true;
    assert task_transition_allowed(TS_IN_PROGRESS, TS_COMPLETED) == true;
    assert task_transition_allowed(TS_COMPLETED, TS_PENDING) == true;
    assert task_transition_allowed(TS_PENDING, TS_DELETED) == true;
    assert task_transition_allowed(TS_IN_PROGRESS, TS_DELETED) == true;
    assert task_transition_allowed(TS_COMPLETED, TS_DELETED) == true;
}

test a_refused_task_transition_stays_refused {
    assert task_transition_allowed(TS_PENDING, TS_COMPLETED) == false;
    assert task_transition_allowed(TS_COMPLETED, TS_IN_PROGRESS) == false;
    assert task_transition_allowed(TS_DELETED, TS_PENDING) == false;
    assert task_transition_allowed(TS_DELETED, TS_DELETED) == false;
    assert task_transition_allowed(TS_PENDING, TS_PENDING) == false;
    assert task_transition_allowed(TS_COMPLETED, TS_COMPLETED) == false;
    assert task_transition_allowed(4, TS_PENDING) == false;
    assert task_transition_allowed(TS_PENDING, 4) == false;
}

test a_claim_needs_an_unowned_pending_task_with_done_blockers {
    assert claim_refusal(TS_PENDING, 0, 0, 0) == BR_OK;
    assert claim_refusal(TS_PENDING, 0, 3, 3) == BR_OK;
    assert claim_refusal(TS_IN_PROGRESS, 0, 0, 0) == BR_NOT_PENDING;
    assert claim_refusal(TS_COMPLETED, 0, 0, 0) == BR_NOT_PENDING;
    assert claim_refusal(TS_DELETED, 0, 0, 0) == BR_NOT_PENDING;
    assert claim_refusal(TS_PENDING, 5, 0, 0) == BR_OWNED;
    assert claim_refusal(TS_PENDING, 0, 9, 1) == BR_BLOCKED;
    assert claim_refusal(7, 0, 0, 0) == BR_UNKNOWN_STATUS;
}

test claim_refusals_are_tried_in_order {
    assert claim_refusal(TS_IN_PROGRESS, 5, 9, 0) == BR_NOT_PENDING;
    assert claim_refusal(TS_PENDING, 5, 9, 0) == BR_OWNED;
    assert claim_refusal(TS_PENDING, 0, 9, 0) == BR_BLOCKED;
    assert claim_refusal(TS_PENDING, 0, 9, 9) == BR_OK;
}

test release_and_complete_need_the_owner_or_the_lead {
    assert release_refusal(TS_IN_PROGRESS, 7, 7, ROLE_MATE) == BR_OK;
    assert complete_refusal(TS_IN_PROGRESS, 7, 7, ROLE_MATE) == BR_OK;
    assert release_refusal(TS_IN_PROGRESS, 7, 9, ROLE_LEAD) == BR_OK;
    assert complete_refusal(TS_IN_PROGRESS, 7, 9, ROLE_LEAD) == BR_OK;
    assert release_refusal(TS_IN_PROGRESS, 7, 9, ROLE_MATE) == BR_NOT_OWNER;
    assert complete_refusal(TS_IN_PROGRESS, 7, 9, ROLE_MATE) == BR_NOT_OWNER;
    assert complete_refusal(TS_IN_PROGRESS, 7, 0, ROLE_MATE) == BR_NOT_OWNER;
    assert release_refusal(TS_PENDING, 0, 7, ROLE_LEAD) == BR_NOT_IN_PROGRESS;
    assert complete_refusal(TS_COMPLETED, 7, 7, ROLE_MATE) == BR_NOT_IN_PROGRESS;
    assert complete_refusal(TS_DELETED, 7, 7, ROLE_LEAD) == BR_NOT_IN_PROGRESS;
    assert complete_refusal(9, 7, 7, ROLE_LEAD) == BR_UNKNOWN_STATUS;
}

test reopen_needs_a_completed_task {
    assert reopen_refusal(TS_COMPLETED) == BR_OK;
    assert reopen_refusal(TS_PENDING) == BR_NOT_COMPLETED;
    assert reopen_refusal(TS_IN_PROGRESS) == BR_NOT_COMPLETED;
    assert reopen_refusal(TS_DELETED) == BR_NOT_COMPLETED;
    assert reopen_refusal(9) == BR_UNKNOWN_STATUS;
}

test delete_is_refused_while_a_live_task_depends_on_it {
    assert board_live_deps(TB_STATUS, TB_DEPS) == 9;
    assert delete_refusal(TS_COMPLETED, 0, 9) == BR_HAS_LIVE_DEPENDENT;
    assert delete_refusal(TS_IN_PROGRESS, 3, 9) == BR_HAS_LIVE_DEPENDENT;
    assert delete_refusal(TS_PENDING, 1, 9) == BR_OK;
    assert delete_refusal(TS_PENDING, 2, 9) == BR_OK;
    assert delete_refusal(TS_DELETED, 4, 0) == BR_ALREADY_DELETED;
    assert delete_refusal(8, 4, 0) == BR_UNKNOWN_STATUS;
    assert delete_refusal(TS_PENDING, 64, 0) == BR_UNKNOWN_STATUS;
}

test a_finished_or_deleted_dependent_does_not_hold_a_delete {
    assert board_live_deps(TB3_STATUS, TB3_DEPS) == 2;
    assert board_done(TB_STATUS) == 1;
    assert board_done(TB3_STATUS) == 1;
    assert board_done(TB2_STATUS) == 0;
    assert delete_refusal(TS_COMPLETED, 0, 0) == BR_OK;
}

test the_next_claimable_task_is_the_lowest_that_passes_the_claim_rule {
    assert next_claimable(TB_STATUS, TB_OWNER, TB_DEPS) == 1;
    assert next_claimable(TB2_STATUS, TB2_OWNER, TB2_DEPS) == 2;
    assert next_claimable(TB3_STATUS, TB3_OWNER, TB3_DEPS) == BOARD_NONE;
}

test the_board_summary_counts_each_status_and_the_blocked {
    assert board_summary(TB_STATUS, TB_DEPS).pending == 2;
    assert board_summary(TB_STATUS, TB_DEPS).in_progress == 1;
    assert board_summary(TB_STATUS, TB_DEPS).completed == 1;
    assert board_summary(TB_STATUS, TB_DEPS).deleted == 1;
    assert board_summary(TB_STATUS, TB_DEPS).blocked == 1;
    assert board_summary(TB2_STATUS, TB2_DEPS).blocked == 1;
    assert board_summary(TB3_STATUS, TB3_DEPS).blocked == 1;
    assert board_summary(TB3_STATUS, TB3_DEPS).pending == 1;
}
