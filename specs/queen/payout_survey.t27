// SPDX-License-Identifier: Apache-2.0
; specs/queen/payout_survey.t27 -- a dated, sourced survey of systems that pay for verified useful
; work (gHashTag/t27#12632, P5 of epic #12490). It is DESIGN AND RESEARCH ONLY: it records what fourteen
; public pages state, what they leave out, and which refusal of the payout evidence layer each design
; would feed. It prices nothing, promises nothing and mints nothing; minting is the founder's alone
; (specs/trinet/mint_authority.t27). No row below is a recommendation to adopt a system or its token.

; Method. Every row was read with a page fetch on 2026-10-26 (the date read). A row whose page could not
; be fetched is marked UNVERIFIED, carries no URL and no number. A figure appears only when the fetched
; page itself states it, and a self-reported figure says so. The pages are the vendors' own, so every
; claim is theirs, not a measurement of ours. A critique known only from a search snippet is NOT recorded
; as a failure (the Bittensor weight-copying critique is such a case: UNVERIFIED, so row 1 has no failure).

; Rows (id, name, kind, URL, date read):
;  1 bittensor        market      https://bittensor.com/docs                                         2026-10-26
;                     (the Yuma Consensus page redirected away and was not read)
;  2 gensyn           market      https://docs.gensyn.ai/                                            2026-10-26
;  3 prime-intellect  market      https://docs.primeintellect.ai/                                    2026-10-26
;  4 akash            market      https://akash.network/docs/                                        2026-10-26
;  5 render           market      UNVERIFIED: the docs page answered HTTP 404, nothing was read      (not read)
;  6 io-net           market      https://io.net/docs                                                2026-10-26
;  7 golem            market      https://docs.golem.network/                                        2026-10-26
;  8 ezkl             verifiable  https://docs.ezkl.xyz/                                              2026-10-26
;  9 arbitrum-bold    verifiable  https://docs.arbitrum.io/how-arbitrum-works/bold/gentle-introduction  2026-10-26
; 10 ritual           verifiable  https://docs.ritualfoundation.org/                                  2026-10-26
; 11 truebit          verifiable  https://blocksec.com/blog/in-depth-analysis-the-truebit-incident    2026-10-26
;                     (the page is dated 2026-01-14; the exploit it analyses is dated 2026-01-08)
; 12 algora           bounty      https://algora.io/                                                  2026-10-26
; 13 immunefi         bounty      https://immunefi.com/                                               2026-10-26
; 14 gitcoin          bounty      https://gitcoin.co/                                                 2026-10-26

; What the fetched pages state, in one line each:
;  1 bittensor: validators score miners; the unit of work and the checker's independence are not stated.
;  2 gensyn: a reproducible execution environment emits receipts; the page says its legacy testnet
;    products are no longer maintained and no official swarms are running.
;  3 prime-intellect: hosted training, GPU rental and evals sold to customers; no worker payment shown.
;  4 akash: customers lease compute from providers; the unit is a lease, not a verified output.
;  6 io-net: customers rent pooled GPU clusters; no output verification described.
;  7 golem: providers earn crypto for shared compute; the unit of payment and the check are not defined.
;  8 ezkl: a zero-knowledge proof of a model run, checkable by anyone holding the verification key, so
;    prover and verifier are separate; it is tooling, not a payment system; the page says it runs mainly
;    on the user's machine, which limits large models and concurrent verifications.
;  9 arbitrum-bold: bonded validators assert state and lose the bond when wrong; anyone can challenge
;    by bonding a competing claim, so the challenger is independent of the asserter; the page says it
;    replaced fraud proofs limited to allowlisted validators. It states a 6.4-day window the DAO can
;    change and a two-day Security Council grace period; bond amounts are not stated.
; 10 ritual: contracts buy off-chain compute and pay in prepaid fees; executors run in trusted hardware
;    enclaves and sign attestations that block builders check, so trust rests on that hardware; no
;    redundant re-execution is described. Testnet figures stated: 18 decimals, about 350 ms blocks.
; 11 truebit: a pricing overflow in the token purchase contract (an old compiler without overflow
;    checks) let one buyer drain about 8,535 ETH (the page puts this near 26 million dollars) on
;    2026-01-08; the page says the verification service was not the system affected.
; 12 algora: a recruiting service that places engineers; no bounty payout appears on the page, so it
;    is NOT a system that pays for finished work. It stays in the survey as a negative finding.
; 13 immunefi: validated security reports paid by the projects; a triage service filters spam and
;    duplicates; "140 million dollars and more paid across 650 and more protocols" is the vendor's own
;    figure (self-reported); the triager's independence and the severity rules are not described.
; 14 gitcoin: a directory of funding rounds and collective funds (a $100M+ matching pool for one fund,
;    $220M+ for another, per the page); who decides a payout and how is not stated.

; Findings the tests below pin:
;  - 13 of 14 rows are verified; the one UNVERIFIED row (render) carries no URL and no number.
;  - Only three rows describe a checker that is not the worker (ezkl, arbitrum-bold, ritual); only two of
;    those also pay for an output (arbitrum-bold, ritual). Compute-rental rows (akash, io-net, golem) pay
;    for a lease, not for a checked output.
;  - GAP: no fetched page is a task marketplace that pays for finished agent work. The slot is empty.
;  - Failures on record on fetched pages: four (gensyn, ezkl, arbitrum-bold, truebit).

; Not here: a ranking, a price, a token, a partner name or a promise. This file takes ideas for the
; REFUSALS of specs/queen/payout_evidence_msg.t27 (the codes below mirror its PE_REFUSE_* numbers by
; literal tests, with no `use`): a checker that is not the worker feeds NOT_INDEPENDENT (5), a signed
; attestation that must match what was registered feeds SEAL_MISMATCH (4), a triage that drops spam and
; duplicates feeds VACUOUS (3). It refuses what the rows show going wrong: unguarded value arithmetic
; (truebit), a lease counted as work (akash, io-net, golem), a number without a source (bittensor, render).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenPayoutSurvey;

; --- 1. Rows, kinds, the date read ------------------------------------------------------------------

/// The number of rows. Row ids run 1 to PS_ROWS; 0 and anything above are not rows.
pub const PS_ROWS : u32 = 14;

/// The kind of a row: a compute or inference market, a verifiable-compute scheme, a bounty or funding
/// system, or a task marketplace that pays for finished agent work (no fetched page is one: the gap).
pub const PS_KIND_NONE : u8 = 0;
pub const PS_KIND_MARKET : u8 = 1;
pub const PS_KIND_VERIFIABLE : u8 = 2;
pub const PS_KIND_BOUNTY : u8 = 3;
pub const PS_KIND_TASK_MARKETPLACE : u8 = 4;

/// The date the pages were read, as YYYYMMDD. A row that was not read has date 0.
pub const PS_DATE_READ : u32 = 20261026;

/// Whether an id is a row of the survey.
pub fn ps_known_row(id : u32) -> bool {
    if (id < 1) { return false; }
    if (id > PS_ROWS) { return false; }
    return true;
}

/// The kind of a row: rows 1..7 are markets, 8..11 verifiable-compute schemes, 12..14 bounty systems.
pub fn ps_row_kind(id : u32) -> u8 {
    if (id >= 1) { if (id <= 7) { return PS_KIND_MARKET; } }
    if (id >= 8) { if (id <= 11) { return PS_KIND_VERIFIABLE; } }
    if (id >= 12) { if (id <= 14) { return PS_KIND_BOUNTY; } }
    return PS_KIND_NONE;
}

/// Whether a row has a URL that was fetched. Row 5 (render) answered HTTP 404, so it has none.
pub fn ps_row_has_url(id : u32) -> bool {
    if (ps_known_row(id) == false) { return false; }
    if (id == 5) { return false; }
    return true;
}

/// The date a row was read, YYYYMMDD, or 0 when it was not read.
pub fn ps_row_date(id : u32) -> u32 {
    if (ps_row_has_url(id) == false) { return 0; }
    return PS_DATE_READ;
}

/// The date the page itself shows, when it shows one. Only row 11 does (2026-01-14); the other pages show
/// no publication date, which is 0 here, never a guess.
pub fn ps_row_page_date(id : u32) -> u32 {
    if (id == 11) { return 20260114; }
    return 0;
}

/// A row is verified when it has a fetched URL and a date read. A row without both is UNVERIFIED.
pub fn ps_row_verified(id : u32) -> bool {
    if (ps_row_has_url(id) == false) { return false; }
    if (ps_row_date(id) == 0) { return false; }
    return true;
}

; --- 2. What is paid for, and who checks ------------------------------------------------------------

/// The unit a row pays for, as its fetched page states it. 0 means the page does not establish it.
pub const PS_PU_UNKNOWN : u8 = 0;
pub const PS_PU_LEASE : u8 = 1;
pub const PS_PU_EMISSION : u8 = 2;
pub const PS_PU_REPORT : u8 = 3;
pub const PS_PU_ASSERTION : u8 = 4;
pub const PS_PU_CALL_FEE : u8 = 5;
pub const PS_PU_FUNDING : u8 = 6;
pub const PS_PU_NONE : u8 = 7;
pub const PS_PU_PLACEMENT : u8 = 8;

pub fn ps_row_unit(id : u32) -> u8 {
    if (id == 1) { return PS_PU_EMISSION; }
    if (id == 3) { return PS_PU_NONE; }
    if (id == 4) { return PS_PU_LEASE; }
    if (id == 6) { return PS_PU_LEASE; }
    if (id == 8) { return PS_PU_NONE; }
    if (id == 9) { return PS_PU_ASSERTION; }
    if (id == 10) { return PS_PU_CALL_FEE; }
    if (id == 12) { return PS_PU_PLACEMENT; }
    if (id == 13) { return PS_PU_REPORT; }
    if (id == 14) { return PS_PU_FUNDING; }
    return PS_PU_UNKNOWN;
}

/// Whether the unit is an output that somebody checked or can check: an emission for scored work, a
/// validated report, a bonded assertion, or a fee for an attested call. A lease, a funding round, a
/// placement and "none" are not.
pub fn ps_unit_pays_output(unit : u8) -> bool {
    if (unit == PS_PU_EMISSION) { return true; }
    if (unit == PS_PU_REPORT) { return true; }
    if (unit == PS_PU_ASSERTION) { return true; }
    if (unit == PS_PU_CALL_FEE) { return true; }
    return false;
}

/// Whether the checker is a different party from the worker, as the page states it.
pub const PS_IND_NOT_ESTABLISHED : u8 = 0;
pub const PS_IND_YES : u8 = 1;
pub const PS_IND_NO : u8 = 2;
pub const PS_IND_UNCLEAR : u8 = 3;

pub fn ps_row_independent(id : u32) -> u8 {
    if (id == 8) { return PS_IND_YES; }
    if (id == 9) { return PS_IND_YES; }
    if (id == 10) { return PS_IND_YES; }
    if (id == 1) { return PS_IND_UNCLEAR; }
    if (id == 2) { return PS_IND_UNCLEAR; }
    if (id == 4) { return PS_IND_UNCLEAR; }
    if (id == 12) { return PS_IND_UNCLEAR; }
    if (id == 13) { return PS_IND_UNCLEAR; }
    return PS_IND_NOT_ESTABLISHED;
}

/// Whether a row pays for an output AND has a checker that is not the worker. Two rows qualify.
pub fn ps_row_pays_checked_output(id : u32) -> bool {
    if (ps_unit_pays_output(ps_row_unit(id)) == false) { return false; }
    if (ps_row_independent(id) != PS_IND_YES) { return false; }
    return true;
}

; --- 3. Failures and numbers on record --------------------------------------------------------------

/// Whether the FETCHED page documents a failure or a stated limit. Rows 2 (legacy testnet products no
/// longer maintained), 8 (runs mainly on the user's machine), 9 (the earlier allowlist design) and 11 (a
/// pricing overflow). The Bittensor critique is known from a search snippet only, so row 1 has none.
pub fn ps_row_failure_on_record(id : u32) -> bool {
    if (id == 2) { return true; }
    if (id == 8) { return true; }
    if (id == 9) { return true; }
    if (id == 11) { return true; }
    return false;
}

/// Whether the fetched page states a number we repeat in the comments above: a window, a figure of
/// testnet, an amount drained, a vendor total, a matching pool.
pub fn ps_row_has_number(id : u32) -> bool {
    if (id == 9) { return true; }
    if (id == 10) { return true; }
    if (id == 11) { return true; }
    if (id == 13) { return true; }
    if (id == 14) { return true; }
    return false;
}

/// Whether a figure is the vendor's own claim. Row 13 says so; the others are page statements.
pub fn ps_row_number_self_reported(id : u32) -> bool {
    if (id == 13) { return true; }
    return false;
}

/// The law of the survey: a number is allowed only on a verified row.
pub fn ps_number_is_sourced(id : u32) -> bool {
    if (ps_row_has_number(id) == false) { return true; }
    return ps_row_verified(id);
}

; --- 4. What t27 takes and what it refuses ----------------------------------------------------------

/// The refusal of the payout evidence layer a row's design would feed, with the numbers of
/// payout_evidence_msg.t27 (PE_REFUSE_VACUOUS 3, SEAL_MISMATCH 4, NOT_INDEPENDENT 5). 0 means the row
/// feeds none: it is an idea about WHO checks, not a new rule.
pub fn ps_row_takes(id : u32) -> u8 {
    if (id == 8) { return 5; }
    if (id == 9) { return 5; }
    if (id == 10) { return 4; }
    if (id == 13) { return 3; }
    return 0;
}

/// What the row shows going wrong, and so what t27 refuses: 1 unguarded value arithmetic in a message
/// or a contract (truebit), 2 a lease counted as verified work (akash, io-net, golem), 3 a number or a
/// critique without a fetched source (bittensor, render).
pub const PS_REFUSES_NOTHING : u8 = 0;
pub const PS_REFUSES_OPEN_VALUE_ARITHMETIC : u8 = 1;
pub const PS_REFUSES_LEASE_AS_WORK : u8 = 2;
pub const PS_REFUSES_UNSOURCED_NUMBER : u8 = 3;

pub fn ps_row_refuses(id : u32) -> u8 {
    if (id == 11) { return PS_REFUSES_OPEN_VALUE_ARITHMETIC; }
    if (id == 4) { return PS_REFUSES_LEASE_AS_WORK; }
    if (id == 6) { return PS_REFUSES_LEASE_AS_WORK; }
    if (id == 7) { return PS_REFUSES_LEASE_AS_WORK; }
    if (id == 1) { return PS_REFUSES_UNSOURCED_NUMBER; }
    if (id == 5) { return PS_REFUSES_UNSOURCED_NUMBER; }
    return PS_REFUSES_NOTHING;
}

/// Design only: the survey prices no row in TRI and changes no balance, for any input.
pub fn ps_prices_tri(id : u32) -> bool {
    return false;
}

pub fn ps_value_change(id : u32) -> u64 {
    return 0;
}

; --- 5. Counts over the rows ------------------------------------------------------------------------

pub fn ps_count_verified() -> u32 {
    var i : u32 = 1;
    var n : u32 = 0;
    while (i <= PS_ROWS) {
        if (ps_row_verified(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn ps_count_kind(kind : u8) -> u32 {
    var i : u32 = 1;
    var n : u32 = 0;
    while (i <= PS_ROWS) {
        if (ps_row_kind(i) == kind) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn ps_count_independent() -> u32 {
    var i : u32 = 1;
    var n : u32 = 0;
    while (i <= PS_ROWS) {
        if (ps_row_independent(i) == PS_IND_YES) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn ps_count_pays_checked_output() -> u32 {
    var i : u32 = 1;
    var n : u32 = 0;
    while (i <= PS_ROWS) {
        if (ps_row_pays_checked_output(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn ps_count_failures() -> u32 {
    var i : u32 = 1;
    var n : u32 = 0;
    while (i <= PS_ROWS) {
        if (ps_row_failure_on_record(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// Whether every row obeys the law of the survey (a number only on a verified row).
pub fn ps_all_numbers_sourced() -> bool {
    var i : u32 = 1;
    while (i <= PS_ROWS) {
        if (ps_number_is_sourced(i) == false) { return false; }
        i = i + 1;
    }
    return true;
}

; --- 6. Tests ---------------------------------------------------------------------------------------

test the_survey_has_fourteen_rows_and_no_more {
    assert ps_known_row(1) == true;
    assert ps_known_row(14) == true;
    assert ps_known_row(0) == false;
    assert ps_known_row(15) == false;
    assert ps_known_row(99) == false;
    assert ps_count_kind(1) + ps_count_kind(2) + ps_count_kind(3) == 14;
}

test rows_split_into_seven_markets_four_schemes_three_bounty_systems {
    assert ps_count_kind(1) == 7;
    assert ps_count_kind(2) == 4;
    assert ps_count_kind(3) == 3;
    assert ps_row_kind(1) == 1;
    assert ps_row_kind(7) == 1;
    assert ps_row_kind(8) == 2;
    assert ps_row_kind(11) == 2;
    assert ps_row_kind(12) == 3;
    assert ps_row_kind(14) == 3;
    assert ps_row_kind(0) == 0;
    assert ps_row_kind(15) == 0;
}

test the_gap_no_fetched_page_is_a_task_marketplace_for_finished_agent_work {
    assert ps_count_kind(4) == 0;
    assert ps_row_kind(12) != 4;
    assert ps_row_unit(12) == 8;
}

test thirteen_rows_are_verified_and_render_is_the_one_that_is_not {
    assert ps_count_verified() == 13;
    assert ps_row_verified(1) == true;
    assert ps_row_verified(14) == true;
    assert ps_row_verified(5) == false;
    assert ps_row_has_url(5) == false;
    assert ps_row_date(5) == 0;
    assert ps_row_verified(0) == false;
    assert ps_row_verified(15) == false;
}

test every_verified_row_carries_the_date_read {
    assert ps_row_date(1) == 20261026;
    assert ps_row_date(4) == 20261026;
    assert ps_row_date(9) == 20261026;
    assert ps_row_date(11) == 20261026;
    assert ps_row_date(14) == 20261026;
    assert ps_row_date(5) == 0;
}

test only_the_truebit_page_shows_its_own_date_and_it_is_older_than_the_date_read {
    assert ps_row_page_date(11) == 20260114;
    assert ps_row_page_date(1) == 0;
    assert ps_row_page_date(9) == 0;
    assert ps_row_page_date(11) < ps_row_date(11);
}

test no_number_stands_on_an_unverified_row {
    assert ps_all_numbers_sourced() == true;
    assert ps_number_is_sourced(5) == true;
    assert ps_row_has_number(5) == false;
    assert ps_row_has_number(9) == true;
    assert ps_number_is_sourced(9) == true;
    assert ps_number_is_sourced(11) == true;
    assert ps_number_is_sourced(14) == true;
}

test the_vendor_total_of_immunefi_is_marked_self_reported {
    assert ps_row_number_self_reported(13) == true;
    assert ps_row_number_self_reported(11) == false;
    assert ps_row_number_self_reported(9) == false;
    assert ps_row_has_number(13) == true;
}

test three_rows_describe_a_checker_that_is_not_the_worker {
    assert ps_count_independent() == 3;
    assert ps_row_independent(8) == 1;
    assert ps_row_independent(9) == 1;
    assert ps_row_independent(10) == 1;
    assert ps_row_independent(1) == 3;
    assert ps_row_independent(4) == 3;
    assert ps_row_independent(3) == 0;
    assert ps_row_independent(5) == 0;
}

test only_two_rows_pay_for_an_output_that_an_independent_checker_can_check {
    assert ps_count_pays_checked_output() == 2;
    assert ps_row_pays_checked_output(9) == true;
    assert ps_row_pays_checked_output(10) == true;
    assert ps_row_pays_checked_output(8) == false;
    assert ps_row_pays_checked_output(1) == false;
    assert ps_row_pays_checked_output(13) == false;
}

test a_lease_and_a_funding_round_and_a_placement_are_not_a_paid_output {
    assert ps_unit_pays_output(PS_PU_LEASE) == false;
    assert ps_unit_pays_output(PS_PU_FUNDING) == false;
    assert ps_unit_pays_output(PS_PU_PLACEMENT) == false;
    assert ps_unit_pays_output(PS_PU_NONE) == false;
    assert ps_unit_pays_output(PS_PU_UNKNOWN) == false;
    assert ps_unit_pays_output(PS_PU_ASSERTION) == true;
    assert ps_unit_pays_output(PS_PU_REPORT) == true;
    assert ps_unit_pays_output(PS_PU_CALL_FEE) == true;
    assert ps_unit_pays_output(PS_PU_EMISSION) == true;
}

test the_units_of_the_rows_match_what_the_pages_state {
    assert ps_row_unit(1) == 2;
    assert ps_row_unit(4) == 1;
    assert ps_row_unit(6) == 1;
    assert ps_row_unit(9) == 4;
    assert ps_row_unit(10) == 5;
    assert ps_row_unit(13) == 3;
    assert ps_row_unit(14) == 6;
    assert ps_row_unit(2) == 0;
    assert ps_row_unit(7) == 0;
    assert ps_row_unit(11) == 0;
}

test four_fetched_pages_document_a_failure_and_the_bittensor_critique_is_not_one {
    assert ps_count_failures() == 4;
    assert ps_row_failure_on_record(2) == true;
    assert ps_row_failure_on_record(8) == true;
    assert ps_row_failure_on_record(9) == true;
    assert ps_row_failure_on_record(11) == true;
    assert ps_row_failure_on_record(1) == false;
    assert ps_row_failure_on_record(5) == false;
}

test the_refusals_a_row_feeds_agree_with_the_payout_evidence_numbers {
    assert ps_row_takes(8) == 5;
    assert ps_row_takes(9) == 5;
    assert ps_row_takes(10) == 4;
    assert ps_row_takes(13) == 3;
    assert ps_row_takes(1) == 0;
    assert ps_row_takes(4) == 0;
    assert ps_row_takes(0) == 0;
    assert ps_row_takes(99) == 0;
}

test what_each_failing_row_teaches_t27_to_refuse {
    assert ps_row_refuses(11) == 1;
    assert ps_row_refuses(4) == 2;
    assert ps_row_refuses(6) == 2;
    assert ps_row_refuses(7) == 2;
    assert ps_row_refuses(1) == 3;
    assert ps_row_refuses(5) == 3;
    assert ps_row_refuses(8) == 0;
    assert ps_row_refuses(9) == 0;
    assert ps_row_refuses(99) == 0;
}

test the_survey_prices_nothing_and_changes_no_balance {
    assert ps_prices_tri(1) == false;
    assert ps_prices_tri(9) == false;
    assert ps_prices_tri(14) == false;
    assert ps_prices_tri(99) == false;
    assert ps_value_change(1) == 0;
    assert ps_value_change(11) == 0;
    assert ps_value_change(99) == 0;
}

test an_unknown_row_answers_the_neutral_value_for_every_question {
    assert ps_row_has_url(0) == false;
    assert ps_row_has_url(15) == false;
    assert ps_row_independent(0) == 0;
    assert ps_row_independent(15) == 0;
    assert ps_row_unit(0) == 0;
    assert ps_row_unit(15) == 0;
    assert ps_row_failure_on_record(0) == false;
    assert ps_row_has_number(15) == false;
    assert ps_row_takes(15) == 0;
}

invariant ps_the_render_row_is_unverified_and_carries_no_number { assert ps_row_verified(5) == false and ps_row_has_number(5) == false; }
invariant ps_the_survey_changes_no_balance { assert ps_value_change(1) == 0 and ps_prices_tri(1) == false; }
