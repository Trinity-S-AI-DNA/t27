// SPDX-License-Identifier: Apache-2.0
; specs/queen/queen_pipeline_events.t27 -- T27L events for Queen pipeline phase
; V3 Vertical Slice: T27L Event Surface
; Canonical ID: 0xQ@queen.t27 pipeline events
; T27A Registry: specs/queen/ — Queen pipeline event registry
; Surface: system (10) — already references queen/lab_job_msg.t27
; T27L Version: t27l/v1
; phi^2 + 1/phi^2 = 3 | TRINITY

module queen_pipeline_events;

/// T27L version prefix for all events in this spec.
pub const T27L_VERSION : str = "t27l/v1";

/// Event ID prefix.
pub const EVENT_ID_PREFIX : str = "qp_";

/// Actor id format: 0x<Role>@<slug>.t27
pub const ACTOR_PREFIX : str = "0x";
pub const ACTOR_SUFFIX : str = ".t27";

/// Queen pipeline surface. Reuses surface 10 "system" which already references queen.
/// This surface groups all Queen pipeline phase events.
pub const SF_QUEEN_PIPELINE : u8 = 10;
pub const SF_TEXT : str = "system";

/// Queen pipeline phase actions.
/// These track the lifecycle of a task through the Queen's pipeline.
pub const PP_PIPELINE_STARTED   : u8 = 0;
pub const PP_PHASE_TRANSITION   : u8 = 1;
pub const PP_TASK_DISPATCHED    : u8 = 2;
pub const PP_TASK_COMPLETED     : u8 = 3;
pub const PP_PHASE_ACK          : u8 = 4;
pub const PP_COUNT               : u8 = 5;

/// Test: surfaces are stable
test surfaces_stable {
    assert SF_QUEEN_PIPELINE == 10;
    assert SF_TEXT == "system";
    assert T27L_VERSION == "t27l/v1";
    assert EVENT_ID_PREFIX == "qp_";
    assert ACTOR_PREFIX == "0x";
    assert ACTOR_SUFFIX == ".t27";
}

/// Test: pipeline actions are stable
test pipeline_actions_stable {
    assert PP_PIPELINE_STARTED   == 0;
    assert PP_PHASE_TRANSITION   == 1;
    assert PP_TASK_DISPATCHED    == 2;
    assert PP_TASK_COMPLETED     == 3;
    assert PP_PHASE_ACK          == 4;
    assert PP_COUNT               == 5;
}

/// Invariant: surface count
invariant surface_count {
    assert SF_COUNT == 1;  // Only SF_QUEEN_PIPELINE in this spec
}

/// Invariant: version stable
invariant version_stable {
    assert T27L_VERSION == "t27l/v1";
}

/// Invactor: actor prefix/suffix format
invactor actor_format {
    assert ACTOR_PREFIX == "0x";
    assert ACTOR_SUFFIX == ".t27";
}