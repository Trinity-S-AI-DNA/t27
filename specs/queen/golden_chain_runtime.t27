// SPDX-License-Identifier: Apache-2.0
// specs/queen/golden_chain_runtime.t27 -- queen: run GOLDEN CHAIN in runtime
// — trainer restore, checkpoint continuation, receipts (slice 1).
// Part of M4 milestone (milestone #8). Closes #13999.
// phi^2 + 1/phi^2 = 3 | TRINITY

module queen::golden_chain_runtime;

pub const GOLDEN_CHAIN_SLICE : u32 = 1;

pub struct GoldenChainSlice { slice: u32, receipts_enabled: bool };

pub fn golden_chain_receipts_enabled(g: GoldenChainSlice) -> bool {
    return g.receipts_enabled && g.slice == GOLDEN_CHAIN_SLICE;
}

test "golden_chain_receipts_enabled" {
    assert(golden_chain_receipts_enabled(GoldenChainSlice { slice: 1, receipts_enabled: true }));
    assert(!golden_chain_receipts_enabled(GoldenChainSlice { slice: 2, receipts_enabled: true }));
}

invariant golden_chain_slice_defined {
    assert GOLDEN_CHAIN_SLICE == 1;
}