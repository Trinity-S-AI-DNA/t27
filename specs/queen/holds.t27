; specs/queen/holds.t27 -- when a task's files stop shutting other bees out
; Owner, 2026-10-08 (translated): "we improved the planner and made actors, so why are so few bees
; working? where are the blockers?" Measured at 15:24Z on the live Queen:
; - 32 of 70 lanes busy; the round ended "nothing to choose": no issue was eligible.
; - fileConflict 167. All 135 cards in BLOCKED had their files held by another task; 131 of those
;   holders were in REVIEW, and for 125 no bee was running on the file at all.
; - bootstrap/src/compiler.rs alone shut out 105 issues. Its holders: one escalated to a person,
;   one finished at 13:31 and waiting two hours for a verdict, one just sent back.
; - the Queen finished 47 tasks that hour and reviewed 23, so the queue of finished work (91) grew,
;   and every task in it held its files for up to 48 hours (QueenDelegation.reviewBoundaryHoldHours).
; A boundary exists so two bees never write one file at once. That holds while a bee may be writing.
; Once the work is finished, the only thing it shuts out is the next bee; a later conflict is a
; merge to resolve, which costs less than a lane standing idle for hours. The owner chose this
; trade on 2026-10-08 (escalations release at once, finished work after AWAITING_HOLD_MINUTES).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenHolds;

/// Where a task stands, for its files:
/// WORKING: queued or running, a bee may be writing now.
/// SEND_BACK: its verdict sent it back; the same work is expected back on these files.
/// AWAITING: finished, waiting for a verdict (a wait, an empty attempt, no verdict yet).
/// ESCALATED: waiting for a person. No person is in the loop (owner, 2026-10-05), so it holds nothing.
/// DONE: accepted, failed or cancelled.
pub const HS_WORKING : u8 = 0;
pub const HS_SEND_BACK : u8 = 1;
pub const HS_AWAITING : u8 = 2;
pub const HS_ESCALATED : u8 = 3;
pub const HS_DONE : u8 = 4;
pub const HOLD_STAGES : u8 = 5;

/// How long finished work keeps its files after it finished: long enough for a verdict that comes
/// within a round or two, short enough that a slow review never empties the swarm.
pub const AWAITING_HOLD_MINUTES : u32 = 30;

/// A send-back is usually taken again within a round; past this, it waits like any finished work.
pub const SEND_BACK_HOLD_MINUTES : u32 = 120;

/// Whether the task's files still shut other bees out, `minutes` after it finished (the bee's own
/// end, written once; a verdict's time is re-written every round a wait is re-read, so it cannot be
/// the clock). A stage this card does not know holds nothing.
pub fn holds_files(stage: u8, minutes: u32) -> bool {
    if (stage == HS_WORKING) { return true; }
    if (stage == HS_SEND_BACK) { return minutes < SEND_BACK_HOLD_MINUTES; }
    if (stage == HS_AWAITING) { return minutes < AWAITING_HOLD_MINUTES; }
    return false;
}

; --- A hold follows the issue as it stands now (t27#9021, 2026-10-11) ---------------------------------
; Measured 2026-10-11 10:57Z on the live Queen: 7 of 70 lanes busy, the round said "nothing to choose",
; fileConflict 231. 122 issues were shut out only by bootstrap/src/compiler.rs, held by the bee of
; #8660, an issue CLOSED at 10:56:59Z: the round reads every dispatch row of the last 7 days with no
; look at its issue, and a working stage always holds. A closed issue's work is never reviewed and
; never published (the review sweep reads open issues only), so its hold protects nothing.
; The same fault, smaller: a dispatch row keeps the paths its issue named WHEN IT WAS DISPATCHED.
; #8095 (an epic) lost its Boundary and #8721 narrowed `.trinity/seals/` to eleven seal files, and
; both kept shutting the old set out (11 and 13 issues) until their dispatches ended.
; So a hold is decided against the issue as the round read it this tick:
; - the issue is closed: it holds nothing;
; - its Boundary is gone (or names no path): it holds nothing;
; - a path it still names holds; a stored path the Boundary now names more narrowly holds only the
;   narrower path; a path the Boundary dropped holds nothing;
; - a path the Boundary ADDED holds nothing. The bee was briefed with the stored set and its writes
;   are judged against it (the boundary check of the review), so it cannot write the new path; holding
;   it would shut the next bee out for no bee at all. The stored set is the upper bound.
; When the round could not read the issue list whole, nothing is known about the issue, and the stage
; alone decides, as before.

/// Whether a dispatch's files still shut other bees out. `known`: the round read the full list of
/// open issues this tick. `issue_open`: the issue is on it. `has_boundary`: its body, as read now,
/// names at least one Boundary path. Unknown falls back to holds_files alone.
pub fn holds_files_now(known: bool, issue_open: bool, has_boundary: bool, stage: u8, minutes: u32) -> bool {
    if (known) {
        if (issue_open == false) { return false; }
        if (has_boundary == false) { return false; }
    }
    return holds_files(stage, minutes);
}

/// Which part of a stored path still holds against one path of the current Boundary.
/// APART: neither lies within the other. STORED: the stored path lies within the current one (or is
/// it), so the stored path holds. CURRENT: the current path lies within the stored one, so only the
/// narrower current path holds.
pub const HP_APART : u8 = 0;
pub const HP_STORED : u8 = 1;
pub const HP_CURRENT : u8 = 2;

/// Where a path starts: past spaces, `./` and `/`, as QueenBoundaryPaths.normalize reads it.
pub fn path_from(p: []const u8, n: usize) -> usize {
    var i : usize = 0;
    var moved : bool = true;
    while (moved) {
        moved = false;
        if (i < n and p[i] == ' ') { i += 1; moved = true; }
        if (i + 1 < n and p[i] == '.' and p[i + 1] == '/') { i += 2; moved = true; }
        if (i < n and p[i] == '/') { i += 1; moved = true; }
    }
    return i;
}

/// Where a path ends: before trailing spaces and `/`, so a directory written `docs/now/` and
/// `docs/now` is one directory.
pub fn path_to(p: []const u8, from: usize, n: usize) -> usize {
    var j : usize = n;
    while (j > from and (p[j - 1] == ' ' or p[j - 1] == '/')) { j -= 1; }
    return j;
}

/// Does inner[ia..ib] lie within outer[oa..ob]: the same path, or under it as a directory?
pub fn path_within(inner: []const u8, ia: usize, ib: usize, outer: []const u8, oa: usize, ob: usize) -> bool {
    if (ob <= oa) { return false; }
    if (ib - ia < ob - oa) { return false; }
    var k : usize = 0;
    while (k < ob - oa) {
        if (inner[ia + k] != outer[oa + k]) { return false; }
        k += 1;
    }
    if (ib - ia == ob - oa) { return true; }
    return inner[ia + (ob - oa)] == '/';
}

pub fn held_part(stored: []const u8, sn: usize, current: []const u8, cn: usize) -> u8 {
    var sa : usize = path_from(stored, sn);
    var sb : usize = path_to(stored, sa, sn);
    var ca : usize = path_from(current, cn);
    var cb : usize = path_to(current, ca, cn);
    if (sb <= sa or cb <= ca) { return HP_APART; }
    if (path_within(stored, sa, sb, current, ca, cb)) { return HP_STORED; }
    if (path_within(current, ca, cb, stored, sa, sb)) { return HP_CURRENT; }
    return HP_APART;
}

; --- A claim on the issue follows the work as it stands now (t27#9021 jam round, 2026-10-11) ----------
; The files a row holds are decided above. The ISSUE a row claims is decided by its state
; (QueenDelegationPolicy.claimOnIssue: running, queued, rejected and awaitingReview are live, accepted is
; done, failed and cancelled are free). Two of those claims outlive the work they stand for.
; Measured on the live Queen 2026-10-11 12:55Z, 89 open issues claimed (public tasks and drawers):
;   running 16 (all on runners with a live lease; ages 2-102 min), wait 47 (lane A, t27#9069),
;   empty 10 (0-24 min), sendBack 9 (6-55 min), escalate 5 (11-58 min), one app-registry task.
; - A SEND-BACK claims its issue as "the same bee is expected back on it". No bee comes back: a verdict
;   is written only on a finished row, a runner deletes the bee's session when its turn ends (runner logs
;   2026-10-11: "Agent disposed", "Session deleted" in the same millisecond as "turn finished"), and
;   nothing resumes a send-back (queen-tick.ts: "Nothing returns"). The runtime frees it as `failed` only
;   after an idle hour, and its files after two, so from minute 60 to 120 it shuts its own next attempt
;   out. 8 of the 9 send-backs were under the retry ceiling: each waited for nothing.
; - An ACCEPT claims its issue as done for as long as the row is in the 7-day window. Of the 374 issues
;   counted `completed` at 12:47Z, 2 had a pull request from queen-<issue> that was closed unmerged and
;   none open or merged (#4374, #6414): the work will never land, and the issue is never chosen again.
;   121 had an open pull request; closing a stale one would strand its issue the same way.
; - An accept with NO pull request at all (213) is not freed. All 213 have a queen-<issue> branch; 206
;   carry a head other than the one the Queen accepted, and that head is on no branch on GitHub: the
;   accepted commit is still in the Queen's export, which queen-export-push.yml has failed to reach on
;   every run since 2026-10-08 06:15Z ("The read operation timed out"). Freeing them would throw away
;   accepted work and spend a bee on each; the repair is the export, not the claim.

/// What a dispatch row claims on its issue. FREE: the issue may be chosen again. LIVE: someone has it or
/// it waits on a verdict. DONE: the work is accepted and may still land.
pub const CL_FREE : u8 = 0;
pub const CL_LIVE : u8 = 1;
pub const CL_DONE : u8 = 2;

/// What a send-back claims. Under the retry ceiling its issue is free at once: the next attempt is a new
/// bee, briefed with the review, starting from the branch it inherits (control.t27 attempt_start). At the
/// ceiling the claim stays live and the review valve decides, as before.
pub fn send_back_claim(send_backs: u32, ceiling: u32) -> u8 {
    if (send_backs < ceiling) { return CL_FREE; }
    return CL_LIVE;
}

/// What an accept claims, by the pull requests whose head is its branch, as read now. `read`: the list
/// was read (an unreadable list frees nothing). Merged or open: the work landed or may land, DONE. Only
/// closed unmerged: it never will, FREE. None at all: DONE, the work waits in the export (see above).
pub fn accept_claim(read: bool, open: u32, merged: u32, closed_unmerged: u32) -> u8 {
    if (read == false) { return CL_DONE; }
    if (merged > 0) { return CL_DONE; }
    if (open > 0) { return CL_DONE; }
    if (closed_unmerged > 0) { return CL_FREE; }
    return CL_DONE;
}

/// The stage a row holds files at, once its claim is known. A freed claim holds no files: the next
/// attempt on the issue is its own, and a hold against it would shut its own issue out.
pub fn held_stage(claim: u8, stage: u8) -> u8 {
    if (claim == CL_FREE) { return HS_DONE; }
    return stage;
}

test a_bee_at_work_holds_its_files {
    assert holds_files(HS_WORKING, 0) == true;
    assert holds_files(HS_WORKING, 4000000000) == true;
}

test finished_work_lets_go_after_a_while {
    assert holds_files(HS_AWAITING, 0) == true;
    assert holds_files(HS_AWAITING, AWAITING_HOLD_MINUTES - 1) == true;
    assert holds_files(HS_AWAITING, AWAITING_HOLD_MINUTES) == false;
    assert holds_files(HS_SEND_BACK, SEND_BACK_HOLD_MINUTES - 1) == true;
    assert holds_files(HS_SEND_BACK, SEND_BACK_HOLD_MINUTES) == false;
}

test a_person_and_a_verdict_hold_nothing {
    assert holds_files(HS_ESCALATED, 0) == false;
    assert holds_files(HS_DONE, 0) == false;
    assert holds_files(HOLD_STAGES, 0) == false;
}

test a_closed_issue_holds_no_files {
    // the #8660 case: a bee still at work on an issue closed under it
    assert holds_files_now(true, false, true, HS_WORKING, 0) == false;
    assert holds_files_now(true, false, true, HS_SEND_BACK, 0) == false;
    assert holds_files_now(true, false, true, HS_AWAITING, 0) == false;
    // the same bee on an open issue holds, as before
    assert holds_files_now(true, true, true, HS_WORKING, 0) == true;
    assert holds_files_now(true, true, true, HS_WORKING, 4000000000) == true;
}

test an_open_issue_keeps_the_stage_rule {
    assert holds_files_now(true, true, true, HS_AWAITING, 0) == true;
    assert holds_files_now(true, true, true, HS_AWAITING, AWAITING_HOLD_MINUTES - 1) == true;
    assert holds_files_now(true, true, true, HS_AWAITING, AWAITING_HOLD_MINUTES) == false;
    assert holds_files_now(true, true, true, HS_SEND_BACK, SEND_BACK_HOLD_MINUTES - 1) == true;
    assert holds_files_now(true, true, true, HS_ESCALATED, 0) == false;
    assert holds_files_now(true, true, true, HS_DONE, 0) == false;
}

test a_removed_boundary_holds_nothing {
    // the #8095 case: an epic whose Boundary was taken out while its dispatch ran
    assert holds_files_now(true, true, false, HS_WORKING, 0) == false;
    assert holds_files_now(true, true, false, HS_SEND_BACK, 0) == false;
}

test an_unread_issue_list_leaves_the_stage_to_decide {
    assert holds_files_now(false, false, false, HS_WORKING, 0) == true;
    assert holds_files_now(false, false, false, HS_AWAITING, 0) == true;
    assert holds_files_now(false, false, false, HS_AWAITING, AWAITING_HOLD_MINUTES) == false;
}

test a_narrowed_boundary_holds_the_narrower_path {
    // the #8721 case: `.trinity/seals/` narrowed to its seal files
    assert held_part(".trinity/seals/", 15, ".trinity/seals/Backend.json", 27) == HP_CURRENT;
    assert held_part(".trinity/seals", 14, ".trinity/seals/Backend.json", 27) == HP_CURRENT;
    assert held_part("/queen", 6, "queen/x.t27", 11) == HP_CURRENT;
}

test a_path_still_named_holds_as_stored {
    assert held_part("bootstrap/src/compiler.rs", 25, "bootstrap/src/compiler.rs", 25) == HP_STORED;
    assert held_part("./specs/x.t27", 13, "specs/x.t27", 11) == HP_STORED;
    assert held_part("docs/now/", 9, "docs/now", 8) == HP_STORED;
}

test a_widened_boundary_holds_no_more_than_was_stored {
    // the Boundary now names the whole directory; the bee was briefed with one file
    assert held_part("specs/queen/holds.t27", 21, "specs/queen", 11) == HP_STORED;
    assert held_part("specs/queen/holds.t27", 21, "specs/queen/", 12) == HP_STORED;
}

test a_dropped_path_holds_nothing {
    assert held_part("bootstrap/src/compiler.rs", 25, "specs/fpga/xc7_primitives.t27", 29) == HP_APART;
    // a common prefix is not a directory
    assert held_part("specs/a", 7, "specs/ab", 8) == HP_APART;
    assert held_part("specs/ab", 8, "specs/a", 7) == HP_APART;
    // an empty path holds nothing
    assert held_part("", 0, "specs/a", 7) == HP_APART;
    assert held_part("./", 2, "specs/a", 7) == HP_APART;
    // the length bounds the read
    assert held_part("specs/a.t27", 7, "specs/a", 7) == HP_STORED;
}

test a_send_back_under_the_ceiling_frees_its_issue {
    // 12:55Z: 8 of 9 send-backs had 0 or 1 counted, under a ceiling of 2
    assert send_back_claim(0, 2) == CL_FREE;
    assert send_back_claim(1, 2) == CL_FREE;
    // #8939 had spent its two: the review valve keeps it
    assert send_back_claim(2, 2) == CL_LIVE;
    assert send_back_claim(3, 2) == CL_LIVE;
    // a ceiling of none frees nothing
    assert send_back_claim(0, 0) == CL_LIVE;
}

test a_pull_request_closed_unmerged_frees_its_accept {
    // #4374 (PR #4565 closed) and #6414 (PR #6752 closed), nothing open or merged
    assert accept_claim(true, 0, 0, 1) == CL_FREE;
    assert accept_claim(true, 0, 0, 3) == CL_FREE;
}

test an_open_or_merged_pull_request_keeps_the_accept {
    // 121 issues with an open PR; #5074 and #6382 merged
    assert accept_claim(true, 1, 0, 0) == CL_DONE;
    assert accept_claim(true, 0, 1, 0) == CL_DONE;
    // #4372: an old PR closed and a newer one open
    assert accept_claim(true, 1, 0, 1) == CL_DONE;
    assert accept_claim(true, 0, 1, 2) == CL_DONE;
}

test no_pull_request_or_no_reading_keeps_the_accept {
    // the 213 that never reached a PR: the accepted head waits in the export
    assert accept_claim(true, 0, 0, 0) == CL_DONE;
    // GitHub could not be read: nothing is freed on a guess
    assert accept_claim(false, 0, 0, 1) == CL_DONE;
    assert accept_claim(false, 0, 0, 0) == CL_DONE;
}

test a_freed_claim_holds_no_files {
    assert held_stage(CL_FREE, HS_SEND_BACK) == HS_DONE;
    assert held_stage(CL_FREE, HS_WORKING) == HS_DONE;
    assert holds_files(held_stage(CL_FREE, HS_SEND_BACK), 0) == false;
    // a live or done claim keeps its stage, and the stage rule as before
    assert held_stage(CL_LIVE, HS_SEND_BACK) == HS_SEND_BACK;
    assert held_stage(CL_DONE, HS_DONE) == HS_DONE;
    assert holds_files(held_stage(CL_LIVE, HS_SEND_BACK), SEND_BACK_HOLD_MINUTES - 1) == true;
    assert holds_files(held_stage(CL_LIVE, HS_WORKING), 0) == true;
}

invariant the_claims_are_three {
    assert CL_FREE != CL_LIVE and CL_LIVE != CL_DONE and CL_FREE != CL_DONE;
}

invariant a_send_back_waits_longer_than_finished_work {
    assert SEND_BACK_HOLD_MINUTES > AWAITING_HOLD_MINUTES;
    assert AWAITING_HOLD_MINUTES > 0;
}
