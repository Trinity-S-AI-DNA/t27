// SPDX-License-Identifier: Apache-2.0
; specs/queen/payout_evidence_msg.t27 -- payout evidence as a supervised actor (gHashTag/t27#12617,
; P4 of epic #12490). Only the MESSAGE and SUPERVISION layer lives here, and it is DESIGN ONLY: three
; messages (CLAIM reports finished work, VERDICT carries the reference of a verdict decided elsewhere,
; DISPUTE contests a judged claim), five actor states, the named refusals for a missing evidence fact,
; two reply tables and the restart intensity of the supervised actor.
; The messages carry small codes and bools only: no function below takes or returns a string, a byte
; array, a path, a command, a hash or an amount, so none of those can ride a message by construction.
; No message of this layer changes any balance (pe_value_change is 0 for every input), no money word and
; no value claim appears, and minting is the founder's alone (specs/trinet/mint_authority.t27).
; This file restates no decision rule. Settlement and bounty_payable are the rules of
; specs/verified/payout.t27, the evidence chain is specs/verified/evidence_chain.t27, the independence
; of a verifier is specs/verified/independence.t27. The functions here take their OUTCOMES as inputs
; (bool, u8, u32) and map them to a state, a lane, a refusal or a reply. Nothing here calls those specs
; and nothing here uses actors.t27: the numbers it shares with them are checked by literal tests.
; Not here: the wiring, the mailbox and the ledger writes; this is a decision table with tests. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenPayoutEvidenceMsg;

; --- 1. Tags and lanes ------------------------------------------------------------------------------

/// The three message tags of the payout-evidence actor. They sit above the claim_msg.t27 tags (16..18),
/// the key_rotation_msg.t27 tags (19..21) and the lab_job tags (22..24), so a mailbox that carries
/// several protocols never confuses them, and all stay under the 64 tags one control lane word holds.
pub const PE_TAG_CLAIM : u64 = 25;
pub const PE_TAG_VERDICT : u64 = 26;
pub const PE_TAG_DISPUTE : u64 = 27;

/// Whether a tag is one of the three evidence tags. Anything else, including 0 and the tags of the
/// other protocols, is not: a receiver of this protocol drops what it does not know.
pub fn pe_known_tag(tag : u64) -> bool {
    if (tag == PE_TAG_CLAIM) { return true; }
    if (tag == PE_TAG_VERDICT) { return true; }
    if (tag == PE_TAG_DISPUTE) { return true; }
    return false;
}

/// The lane of a tag, with the numbers of actors.t27 (0 is the data lane, 1 the control lane). A CLAIM
/// is work and rides the data lane. A VERDICT and a DISPUTE ride the control lane: a full mailbox of
/// claims must not hide a verdict or a dispute, because one that arrives late leaves a judged claim
/// open or lets a contested one stand. Any other tag is data.
pub fn pe_lane_of(tag : u64) -> u8 {
    if (tag == PE_TAG_VERDICT) { return 1; }
    if (tag == PE_TAG_DISPUTE) { return 1; }
    return 0;
}

; --- 2. States of the evidence actor ----------------------------------------------------------------

/// The state of the evidence actor for one piece of work: nothing yet, claimed, judged (a verdict
/// reference arrived), disputed (a judged claim was contested), or parked (the supervisor gave the
/// actor up).
pub const PE_NONE : u8 = 0;
pub const PE_CLAIMED : u8 = 1;
pub const PE_JUDGED : u8 = 2;
pub const PE_DISPUTED : u8 = 3;
pub const PE_PARKED : u8 = 4;

/// The next state after one message. The inputs are outcomes already decided elsewhere:
/// verdict_referenced says that the VERDICT names a verdict reference of the evidence chain (a verdict
/// that names none is not a verdict), and intensity_gone is pe_gives_up of this file for the restarts
/// in the period.
/// - intensity_gone: PARKED from any state, whatever the tag.
/// - PARKED: absorbing for EVERY tag. There is no rest tag; only the supervisor restarting the actor,
///   which starts at NONE, clears it.
/// - NONE + CLAIM: CLAIMED.
/// - CLAIMED + VERDICT: JUDGED when verdict_referenced, else CLAIMED (nothing changes).
/// - JUDGED + DISPUTE: DISPUTED.
/// - DISPUTED + VERDICT: JUDGED when verdict_referenced, else DISPUTED.
/// - every other (state, tag) pair, unknown tags and a CLAIM in any state but NONE included: no change.
pub fn pe_next_state(state : u8, tag : u64, verdict_referenced : bool, intensity_gone : bool) -> u8 {
    if (intensity_gone) { return PE_PARKED; }
    if (state == PE_PARKED) { return PE_PARKED; }
    if (state == PE_NONE) {
        if (tag == PE_TAG_CLAIM) { return PE_CLAIMED; }
        return PE_NONE;
    }
    if (state == PE_CLAIMED) {
        if (tag == PE_TAG_VERDICT) {
            if (verdict_referenced) { return PE_JUDGED; }
            return PE_CLAIMED;
        }
        return PE_CLAIMED;
    }
    if (state == PE_JUDGED) {
        if (tag == PE_TAG_DISPUTE) { return PE_DISPUTED; }
        return PE_JUDGED;
    }
    if (state == PE_DISPUTED) {
        if (tag == PE_TAG_VERDICT) {
            if (verdict_referenced) { return PE_JUDGED; }
            return PE_DISPUTED;
        }
        return PE_DISPUTED;
    }
    return state;
}

; --- 3. Evidence facts and refusals -----------------------------------------------------------------

/// The refusal codes. PE_OK: every fact is present. The others name the FIRST missing fact in the
/// fixed order of pe_refusal: the change is not merged, the checks did not pass, a check passed
/// vacuously, the seal does not match, the verifier is not independent.
pub const PE_OK : u8 = 0;
pub const PE_REFUSE_NOT_MERGED : u8 = 1;
pub const PE_REFUSE_CHECKS_FAILED : u8 = 2;
pub const PE_REFUSE_VACUOUS : u8 = 3;
pub const PE_REFUSE_SEAL_MISMATCH : u8 = 4;
pub const PE_REFUSE_NOT_INDEPENDENT : u8 = 5;

/// The first missing evidence fact, or PE_OK. The five inputs are OUTCOMES decided elsewhere (merge
/// state, the checks, the vacuous-pass count, the seal comparison, the independence of the verifier);
/// this file restates no rule for any of them. The order is fixed: not merged, checks failed, vacuous
/// (vacuous_count > 0), seal mismatch, not independent. When two facts are missing the earlier one is
/// named.
pub fn pe_refusal(change_merged : bool, checks_passed : bool, vacuous_count : u32, seal_matched : bool, verifier_independent : bool) -> u8 {
    if (change_merged == false) { return PE_REFUSE_NOT_MERGED; }
    if (checks_passed == false) { return PE_REFUSE_CHECKS_FAILED; }
    if (vacuous_count > 0) { return PE_REFUSE_VACUOUS; }
    if (seal_matched == false) { return PE_REFUSE_SEAL_MISMATCH; }
    if (verifier_independent == false) { return PE_REFUSE_NOT_INDEPENDENT; }
    return PE_OK;
}

/// Whether a refusal code becomes a request to the ledger: only PE_OK does. Only a full set of facts
/// is sent on; any named refusal stops here.
pub fn pe_asks_ledger(refusal : u8) -> bool {
    return refusal == PE_OK;
}

/// Whether a refusal slashes. Always false: a missing fact is not a verdict. Slashing is decided only
/// by a referenced verdict in specs/verified/payout.t27, never by this layer.
pub fn pe_refusal_slashes(refusal : u8) -> bool {
    return false;
}

/// The change one message of this layer makes to any balance. Always 0: this layer is design only and
/// moves nothing. Both inputs are taken so that a caller cannot pass a value this way either.
pub fn pe_value_change(tag : u64, refusal : u8) -> u64 {
    return 0;
}

; --- 4. Replies -------------------------------------------------------------------------------------

/// The three replies to a CLAIM. ACCEPTED: the claim is taken. DUPLICATE: the work is already settled,
/// a second claim for it is refused (the same case as OUT_ALREADY_SETTLED_NOT_CHARGED = 6 in
/// payout.t27). UNKNOWN_WORK: no such work is known.
pub const PE_REPLY_ACCEPTED : u8 = 0;
pub const PE_REPLY_DUPLICATE : u8 = 1;
pub const PE_REPLY_UNKNOWN_WORK : u8 = 2;

/// The reply code of a CLAIM. Order: DUPLICATE first (already_settled), then UNKNOWN_WORK (not
/// work_known), then ACCEPTED. A second claim for settled work is a duplicate even when the work is
/// no longer known.
pub fn pe_claim_reply(already_settled : bool, work_known : bool) -> u8 {
    if (already_settled) { return PE_REPLY_DUPLICATE; }
    if (work_known == false) { return PE_REPLY_UNKNOWN_WORK; }
    return PE_REPLY_ACCEPTED;
}

/// The three replies to a VERDICT. NO_REFERENCE: the verdict names no verdict reference, nothing
/// happens. REFUSED: a named refusal stops it. REQUESTED: every fact is present and the request goes
/// to the ledger.
pub const PE_VREPLY_NO_REFERENCE : u8 = 0;
pub const PE_VREPLY_REFUSED : u8 = 1;
pub const PE_VREPLY_REQUESTED : u8 = 2;

/// The reply code of a VERDICT. Order: NO_REFERENCE first (not verdict_referenced), then REFUSED (a
/// named refusal, refusal != PE_OK), then REQUESTED (refusal == PE_OK).
pub fn pe_verdict_reply(verdict_referenced : bool, refusal : u8) -> u8 {
    if (verdict_referenced == false) { return PE_VREPLY_NO_REFERENCE; }
    if (refusal != PE_OK) { return PE_VREPLY_REFUSED; }
    return PE_VREPLY_REQUESTED;
}

; --- 5. Mapping to the settlement codes of payout.t27 -----------------------------------------------

/// The ledger Outcome a refusal stands for, by LITERAL numbers (a `use` of payout.t27 would splice a
/// whole spec). The numbers are those of specs/verified/payout.t27: OUT_CREDITED = 0 (line 30),
/// OUT_UNVERIFIABLE_NOT_CHARGED = 4 (line 34), OUT_NOT_ELIGIBLE = 5 (line 35).
/// - PE_OK: 0 (OUT_CREDITED = 0 in payout.t27).
/// - not merged, checks failed, vacuous, seal mismatch: 4 (OUT_UNVERIFIABLE_NOT_CHARGED = 4 in
///   payout.t27): the evidence cannot be checked, nobody is charged.
/// - not independent: 5 (OUT_NOT_ELIGIBLE = 5 in payout.t27).
/// - any other value: 5 (fail closed).
/// The result is never 1 (OUT_REJECTED_AND_SLASHED = 1 in payout.t27): a refusal alone never leads to
/// a slash.
pub fn pe_outcome_of(refusal : u8) -> u8 {
    if (refusal == PE_OK) { return 0; }
    if (refusal == PE_REFUSE_NOT_MERGED) { return 4; }
    if (refusal == PE_REFUSE_CHECKS_FAILED) { return 4; }
    if (refusal == PE_REFUSE_VACUOUS) { return 4; }
    if (refusal == PE_REFUSE_SEAL_MISMATCH) { return 4; }
    if (refusal == PE_REFUSE_NOT_INDEPENDENT) { return 5; }
    return 5;
}

; --- 6. Restart intensity ---------------------------------------------------------------------------

/// How many restarts in one period the supervisor allows the evidence actor. It equals
/// DOMAIN_MAX_RESTARTS of specs/queen/actors.t27 (line 635, value 3); the cross-check is the literal
/// test below, because a `use` of actors.t27 would splice that whole spec into this one.
pub const PE_MAX_RESTARTS : u32 = 3;

/// True when the restarts in the period, the latest included, exceed PE_MAX_RESTARTS: the same meaning
/// as intensity_exceeded in actors.t27 (strictly greater, so 3 restarts are allowed and the 4th gives
/// up). The result feeds the intensity_gone input of pe_next_state.
pub fn pe_gives_up(restarts_in_period : u32) -> bool {
    return restarts_in_period > PE_MAX_RESTARTS;
}

; --- 7. Tests ---------------------------------------------------------------------------------------

test only_the_three_evidence_tags_are_known {
    assert pe_known_tag(25) == true;
    assert pe_known_tag(26) == true;
    assert pe_known_tag(27) == true;
    assert pe_known_tag(0) == false;
    assert pe_known_tag(3) == false;
    assert pe_known_tag(28) == false;
    assert pe_known_tag(99) == false;
}

test no_evidence_tag_collides_with_the_other_protocols {
    assert pe_known_tag(16) == false;
    assert pe_known_tag(17) == false;
    assert pe_known_tag(18) == false;
    assert pe_known_tag(19) == false;
    assert pe_known_tag(20) == false;
    assert pe_known_tag(21) == false;
    assert pe_known_tag(22) == false;
    assert pe_known_tag(23) == false;
    assert pe_known_tag(24) == false;
}

test a_verdict_and_a_dispute_ride_the_control_lane_a_claim_rides_data {
    assert pe_lane_of(25) == 0;
    assert pe_lane_of(26) == 1;
    assert pe_lane_of(27) == 1;
    assert pe_lane_of(0) == 0;
    assert pe_lane_of(99) == 0;
}

test a_claim_in_none_starts_a_claim {
    assert pe_next_state(PE_NONE, 25, false, false) == PE_CLAIMED;
    assert pe_next_state(PE_NONE, 25, true, false) == PE_CLAIMED;
}

test a_referenced_verdict_judges_a_claimed_work {
    assert pe_next_state(PE_CLAIMED, 26, true, false) == PE_JUDGED;
}

test a_verdict_that_names_no_reference_changes_nothing {
    assert pe_next_state(PE_CLAIMED, 26, false, false) == PE_CLAIMED;
    assert pe_next_state(PE_DISPUTED, 26, false, false) == PE_DISPUTED;
}

test a_dispute_of_a_judged_claim_opens_a_dispute {
    assert pe_next_state(PE_JUDGED, 27, false, false) == PE_DISPUTED;
    assert pe_next_state(PE_JUDGED, 27, true, false) == PE_DISPUTED;
}

test a_referenced_verdict_settles_a_dispute_back_to_judged {
    assert pe_next_state(PE_DISPUTED, 26, true, false) == PE_JUDGED;
}

test messages_that_do_not_apply_leave_the_state_alone {
    assert pe_next_state(PE_NONE, 26, true, false) == PE_NONE;
    assert pe_next_state(PE_NONE, 27, true, false) == PE_NONE;
    assert pe_next_state(PE_NONE, 99, true, false) == PE_NONE;
    assert pe_next_state(PE_CLAIMED, 25, true, false) == PE_CLAIMED;
    assert pe_next_state(PE_CLAIMED, 27, true, false) == PE_CLAIMED;
    assert pe_next_state(PE_CLAIMED, 0, true, false) == PE_CLAIMED;
    assert pe_next_state(PE_JUDGED, 25, true, false) == PE_JUDGED;
    assert pe_next_state(PE_JUDGED, 26, true, false) == PE_JUDGED;
    assert pe_next_state(PE_JUDGED, 99, false, false) == PE_JUDGED;
    assert pe_next_state(PE_DISPUTED, 25, true, false) == PE_DISPUTED;
    assert pe_next_state(PE_DISPUTED, 27, true, false) == PE_DISPUTED;
    assert pe_next_state(PE_DISPUTED, 99, true, false) == PE_DISPUTED;
}

test a_parked_actor_stays_parked_for_every_tag {
    assert pe_next_state(PE_PARKED, 25, false, false) == PE_PARKED;
    assert pe_next_state(PE_PARKED, 26, true, false) == PE_PARKED;
    assert pe_next_state(PE_PARKED, 26, false, false) == PE_PARKED;
    assert pe_next_state(PE_PARKED, 27, true, false) == PE_PARKED;
    assert pe_next_state(PE_PARKED, 99, false, false) == PE_PARKED;
    assert pe_next_state(PE_PARKED, 0, true, false) == PE_PARKED;
}

test a_gone_intensity_parks_the_actor_from_every_state {
    assert pe_next_state(PE_NONE, 25, false, true) == PE_PARKED;
    assert pe_next_state(PE_CLAIMED, 26, true, true) == PE_PARKED;
    assert pe_next_state(PE_JUDGED, 27, false, true) == PE_PARKED;
    assert pe_next_state(PE_DISPUTED, 26, true, true) == PE_PARKED;
    assert pe_next_state(PE_PARKED, 25, true, true) == PE_PARKED;
    assert pe_next_state(PE_NONE, 99, false, true) == PE_PARKED;
}

test the_give_up_check_feeds_the_state_machine {
    assert pe_next_state(PE_NONE, 25, false, pe_gives_up(3)) == PE_CLAIMED;
    assert pe_next_state(PE_NONE, 25, false, pe_gives_up(4)) == PE_PARKED;
    assert pe_next_state(PE_CLAIMED, 26, true, pe_gives_up(3)) == PE_JUDGED;
    assert pe_next_state(PE_CLAIMED, 26, true, pe_gives_up(4)) == PE_PARKED;
}

test a_full_set_of_facts_has_no_refusal {
    assert pe_refusal(true, true, 0, true, true) == PE_OK;
}

test each_missing_fact_alone_is_named {
    assert pe_refusal(false, true, 0, true, true) == PE_REFUSE_NOT_MERGED;
    assert pe_refusal(true, false, 0, true, true) == PE_REFUSE_CHECKS_FAILED;
    assert pe_refusal(true, true, 1, true, true) == PE_REFUSE_VACUOUS;
    assert pe_refusal(true, true, 7, true, true) == PE_REFUSE_VACUOUS;
    assert pe_refusal(true, true, 0, false, true) == PE_REFUSE_SEAL_MISMATCH;
    assert pe_refusal(true, true, 0, true, false) == PE_REFUSE_NOT_INDEPENDENT;
}

test two_missing_facts_name_the_earlier_one_in_the_order {
    assert pe_refusal(false, false, 0, true, true) == PE_REFUSE_NOT_MERGED;
    assert pe_refusal(true, false, 2, true, true) == PE_REFUSE_CHECKS_FAILED;
    assert pe_refusal(true, true, 2, false, true) == PE_REFUSE_VACUOUS;
    assert pe_refusal(true, true, 0, false, false) == PE_REFUSE_SEAL_MISMATCH;
    assert pe_refusal(false, true, 0, true, false) == PE_REFUSE_NOT_MERGED;
    assert pe_refusal(false, false, 9, false, false) == PE_REFUSE_NOT_MERGED;
}

test only_a_full_set_of_facts_asks_the_ledger {
    assert pe_asks_ledger(0) == true;
    assert pe_asks_ledger(1) == false;
    assert pe_asks_ledger(2) == false;
    assert pe_asks_ledger(3) == false;
    assert pe_asks_ledger(4) == false;
    assert pe_asks_ledger(5) == false;
    assert pe_asks_ledger(99) == false;
    assert pe_asks_ledger(pe_refusal(true, true, 0, true, true)) == true;
    assert pe_asks_ledger(pe_refusal(true, true, 0, true, false)) == false;
}

test a_missing_fact_is_not_a_verdict_and_never_slashes {
    assert pe_refusal_slashes(0) == false;
    assert pe_refusal_slashes(1) == false;
    assert pe_refusal_slashes(2) == false;
    assert pe_refusal_slashes(3) == false;
    assert pe_refusal_slashes(4) == false;
    assert pe_refusal_slashes(5) == false;
    assert pe_refusal_slashes(99) == false;
}

test no_message_of_this_layer_changes_a_balance {
    assert pe_value_change(25, 0) == 0;
    assert pe_value_change(26, 1) == 0;
    assert pe_value_change(27, 2) == 0;
    assert pe_value_change(0, 3) == 0;
    assert pe_value_change(25, 4) == 0;
    assert pe_value_change(26, 5) == 0;
    assert pe_value_change(27, 0) == 0;
    assert pe_value_change(0, 5) == 0;
}

test a_second_claim_for_settled_work_is_a_duplicate_before_it_is_unknown {
    assert pe_claim_reply(true, true) == PE_REPLY_DUPLICATE;
    assert pe_claim_reply(true, false) == PE_REPLY_DUPLICATE;
}

test an_unsettled_claim_is_accepted_or_names_unknown_work {
    assert pe_claim_reply(false, true) == PE_REPLY_ACCEPTED;
    assert pe_claim_reply(false, false) == PE_REPLY_UNKNOWN_WORK;
}

test a_verdict_without_a_reference_is_named_before_any_refusal {
    assert pe_verdict_reply(false, 0) == PE_VREPLY_NO_REFERENCE;
    assert pe_verdict_reply(false, 1) == PE_VREPLY_NO_REFERENCE;
    assert pe_verdict_reply(false, 5) == PE_VREPLY_NO_REFERENCE;
}

test a_referenced_verdict_is_refused_by_name_or_requested {
    assert pe_verdict_reply(true, 1) == PE_VREPLY_REFUSED;
    assert pe_verdict_reply(true, 2) == PE_VREPLY_REFUSED;
    assert pe_verdict_reply(true, 5) == PE_VREPLY_REFUSED;
    assert pe_verdict_reply(true, 99) == PE_VREPLY_REFUSED;
    assert pe_verdict_reply(true, 0) == PE_VREPLY_REQUESTED;
}

test the_refusal_feeds_the_verdict_reply {
    assert pe_verdict_reply(true, pe_refusal(true, true, 0, true, true)) == PE_VREPLY_REQUESTED;
    assert pe_verdict_reply(true, pe_refusal(true, true, 0, false, true)) == PE_VREPLY_REFUSED;
}

test a_refusal_maps_to_the_settlement_codes_of_payout {
    assert pe_outcome_of(0) == 0;
    assert pe_outcome_of(1) == 4;
    assert pe_outcome_of(2) == 4;
    assert pe_outcome_of(3) == 4;
    assert pe_outcome_of(4) == 4;
    assert pe_outcome_of(5) == 5;
    assert pe_outcome_of(6) == 5;
    assert pe_outcome_of(99) == 5;
}

test a_refusal_alone_never_leads_to_a_slash {
    assert pe_outcome_of(0) != 1;
    assert pe_outcome_of(1) != 1;
    assert pe_outcome_of(2) != 1;
    assert pe_outcome_of(3) != 1;
    assert pe_outcome_of(4) != 1;
    assert pe_outcome_of(5) != 1;
    assert pe_outcome_of(6) != 1;
    assert pe_outcome_of(99) != 1;
}

test three_restarts_are_allowed_and_the_fourth_gives_up {
    assert pe_gives_up(0) == false;
    assert pe_gives_up(2) == false;
    assert pe_gives_up(3) == false;
    assert pe_gives_up(4) == true;
    assert pe_gives_up(100) == true;
}

test the_restart_bound_agrees_with_the_actors_domain_bound_of_three {
    assert pe_gives_up(3) == false;
    assert pe_gives_up(4) == true;
}

test a_claim_a_verdict_a_dispute_and_a_verdict_walk_the_states_in_order {
    assert pe_next_state(pe_next_state(pe_next_state(pe_next_state(PE_NONE, 25, false, false), 26, true, false), 27, false, false), 26, true, false) == PE_JUDGED;
    assert pe_next_state(pe_next_state(pe_next_state(PE_NONE, 25, false, false), 26, true, false), 27, false, false) == PE_DISPUTED;
}

; --- 8. Invariants ----------------------------------------------------------------------------------

invariant pe_tags_distinct_in_25_to_27_and_under_one_control_word { assert PE_TAG_CLAIM != PE_TAG_VERDICT and PE_TAG_VERDICT != PE_TAG_DISPUTE and PE_TAG_CLAIM != PE_TAG_DISPUTE and PE_TAG_CLAIM >= 25 and PE_TAG_VERDICT >= 25 and PE_TAG_DISPUTE >= 25 and PE_TAG_CLAIM <= 27 and PE_TAG_VERDICT <= 27 and PE_TAG_DISPUTE <= 27; }
invariant pe_a_refusal_of_any_kind_never_asks_the_ledger { assert pe_asks_ledger(PE_REFUSE_NOT_MERGED) == false and pe_asks_ledger(PE_REFUSE_CHECKS_FAILED) == false and pe_asks_ledger(PE_REFUSE_VACUOUS) == false and pe_asks_ledger(PE_REFUSE_SEAL_MISMATCH) == false and pe_asks_ledger(PE_REFUSE_NOT_INDEPENDENT) == false; }
