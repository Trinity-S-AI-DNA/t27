// SPDX-License-Identifier: Apache-2.0
; specs/queen/actors_hw_jtag.t27 -- the actor engine of specs/queen/actors_hw.t27 runs its own test vectors on
; the die and reports a verdict over JTAG USER1 (gHashTag/t27#8826, FPGA row of gHashTag/trios#1763). Owner,
; 2026-10-10 (translated): "use our t27b". This module and the engine are both written by t27b's Verilog
; path (specs/tri/t27b/verilog_plan.t27); specs/queen/actors_hw_top.t27 puts them under STARTUPE2, BUFG and
; BSCANE2.
; --
; What runs. The engine, QueenActorsHw, is an instance (its extern below restates the ports it has). The
; self-test drives it with exactly the operand sets of actors_hw.t27's test the_engine_decides_as_the_card:
; - x starts at 21, and each set takes y = x * LCG_MUL + LCG_ADD (mod 2^64), then a .. k2 as that test
;   derives them;
; - every operation 1 .. 76 runs on each set, in that test's order; children_after_exit runs only in its
;   domain (g >= 1 or k0), as there;
; - then x = y, for N_SETS sets.
; Each operation takes three clocks: drive (op and operands into the engine's input registers), wait (the
; engine registers its answer), fold (the answer of the operation's register class enters the signature,
; sig = rotl(sig, 1) ^ answer). The multiply of the LCG is serial, one bit of x a clock (Horner), so the die
; holds one 64-bit adder for it.
; The expected signature and count are constants. The test the_signature_is_the_cards computes both from the
; card (specs/queen/actors.t27) in the reference, with the same mapping from operation to card decision as
; the_engine_decides_as_the_card, so a wrong constant fails there first.
; --
; The verdict, read over USER1 as two 32-bit words, LSB first (drscan 32 twice), layout v3 of the bench tops
; in fpga/verilog: word 0 = {16'hA5A5, 4'd3, 6'd27, done, sig_ok, count_ok, live, beat, ok}, where
; - done: all N_SETS sets ran;
; - sig_ok: the signature is EXPECTED_SIG;
; - count_ok: EXPECTED_OPS answers were folded;
; - live: some answer was not 0, so the datapath reached the die and was not folded to constants;
; - beat: a counter's bit 23, which moves while the clock runs;
; - ok: done and sig_ok and count_ok and live.
; Word 1 is the signature's low 32 bits.
; JTAG is sampled in this module's clock domain, as specs/fpga/die_probe.t27 does: TCK through two flip-flops,
; SEL, CAPTURE, SHIFT and TDI through three; on a rising TCK with SEL, CAPTURE loads the words and SHIFT
; moves them one bit. TCK must stay high, and low, for at least four clocks of this module.
; Sequential (test) and nonblocking (hardware) semantics agree: every var is written at most once on each path,
; and every right-hand side reads values from before the edge.
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenActorsHwJtag;

use queen::actors;
use queen::actors_hw;

/// The engine's outputs this self-test reads.
pub struct EngineOut { eng_wide: u64, eng_word: u32, eng_half: u16, eng_byte: u8 }

/// QueenActorsHw, as t27b's Verilog path writes it from specs/queen/actors_hw.t27: an extern module. Its clk,
/// rst_n and en are written clk_, rst_n_ and en_, since this module declares its own (verilog_plan.t27).
pub fn QueenActorsHw(clk_: bool, rst_n_: bool, en_: bool, op: u8, a: u64, b: u64, c: u32, d: u32, e: u16, f: u16, g: u8, h: u8, k0: bool, k1: bool, k2: bool) -> EngineOut {}

/// This module's clock, reset and enable: the implicit ports, named so the engine can be given them.
const clk : bool = undefined;
const rst_n : bool = undefined;
const en : bool = undefined;

/// The engine, driven by the self-test's registers.
const engine : EngineOut = QueenActorsHw(clk, rst_n, en, st_op, st_a, st_b, st_c, st_d, st_e, st_f, st_g, st_h, st_k0, st_k1, st_k2);

pub const N_SETS : u32 = 1024;
pub const LCG_MUL : u64 = 6364136223846793005;
pub const LCG_ADD : u64 = 1442695040888963407;
pub const X_START : u64 = 21;
pub const OP_FIRST : u8 = 1;
pub const OP_LAST : u8 = 76;
pub const DESIGN_ID : u32 = 27;
/// Word 0 before its flags: 16'hA5A5, layout 4'd3, design 6'd27.
pub const VERDICT_BASE : u32 = 2779066048;
/// The signature and the answer count the card gives (the_signature_is_the_cards).
pub const EXPECTED_SIG : u64 = 9138242148249725361;
pub const EXPECTED_OPS : u32 = 77794;

pub const P_LCG : u8 = 0;
pub const P_DRIVE : u8 = 1;
pub const P_WAIT : u8 = 2;
pub const P_FOLD : u8 = 3;
pub const P_DONE : u8 = 4;

// The engine's input registers.
var st_op : u8 = 0;
var st_a : u64 = 0;
var st_b : u64 = 0;
var st_c : u32 = 0;
var st_d : u32 = 0;
var st_e : u16 = 0;
var st_f : u16 = 0;
var st_g : u8 = 0;
var st_h : u8 = 0;
var st_k0 : bool = false;
var st_k1 : bool = false;
var st_k2 : bool = false;
// The run.
var st_phase : u8 = 0;
var st_n : u32 = 0;
var st_k : u8 = 1;
var st_i : u8 = 0;
var st_x : u64 = X_START;
var st_y : u64 = 0;
var st_acc : u64 = 0;
var st_sig : u64 = 0;
var st_count : u32 = 0;
var st_live : bool = false;
var st_beat : u32 = 0;
// JTAG, sampled.
var jt_tck1 : bool = false;
var jt_tck2 : bool = false;
var jt_sel1 : bool = false;
var jt_sel2 : bool = false;
var jt_sel3 : bool = false;
var jt_cap1 : bool = false;
var jt_cap2 : bool = false;
var jt_cap3 : bool = false;
var jt_sh1 : bool = false;
var jt_sh2 : bool = false;
var jt_sh3 : bool = false;
var jt_tdi1 : bool = false;
var jt_tdi2 : bool = false;
var jt_tdi3 : bool = false;
var jt_s0 : u32 = 0;
var jt_s1 : u32 = 0;
pub var tdo : bool = false;

/// The operands of set n, from x and y = the LCG of x, as the_engine_decides_as_the_card derives them.
pub fn set_a(x: u64, n: u32) -> u64 {
    if ((n & 1) == 1) { return x & (x >> 9) & (x >> 23); }
    return x;
}

pub fn set_b(x: u64, y: u64, n: u32) -> u64 {
    if ((n & 6) == 0) { return set_a(x, n); }
    return y;
}

pub fn set_c(y: u64, n: u32) -> u32 {
    const c0 : u32 = y as u32;
    if ((n & 2) == 2) { return c0 & 1023; }
    return c0;
}

pub fn set_d(y: u64, n: u32) -> u32 {
    const d0 : u32 = (y >> 32) as u32;
    if ((n & 2) == 2) { return d0 & 1023; }
    return d0;
}

pub fn set_e(y: u64, n: u32) -> u16 {
    const e0 : u16 = ((y >> 13) & 65535) as u16;
    if ((n & 2) == 2) { return e0 & 1023; }
    return e0;
}

pub fn set_f(y: u64, n: u32) -> u16 {
    const f0 : u16 = ((y >> 29) & 65535) as u16;
    if ((n & 2) == 2) { return f0 & 1023; }
    return f0;
}

pub fn set_g(x: u64, n: u32) -> u8 {
    const g0 : u8 = ((x >> 40) & 255) as u8;
    if ((n & 2) == 2) { return g0 & 7; }
    return g0;
}

pub fn set_h(x: u64, n: u32) -> u8 {
    const h0 : u8 = ((x >> 48) & 255) as u8;
    if ((n & 2) == 2) { return h0 & 7; }
    return h0;
}

pub fn set_flag(n: u32, sh: u32) -> bool {
    return ((n >> sh) & 1) == 1;
}

/// Does operation k run on a set with these g and k0? children_after_exit only in its domain.
pub fn runs(k: u8, g: u8, k0: bool) -> bool {
    if (k == HW_OP_CHILDREN_AFTER_EXIT) { return g >= 1 or k0; }
    return true;
}

/// Which of the engine's four answer registers operation k writes: 0 wide, 1 word, 2 half, 3 byte.
pub fn answer_class(k: u8) -> u8 {
    if (k <= HW_OP_NODE_PID) { return 0; }
    if (k <= HW_OP_FILE_OWNER_SLOT) { return 1; }
    if (k <= HW_OP_NODE_OF) { return 2; }
    return 3;
}

/// The signature after one more answer: rotate left by one, then xor.
pub fn fold_in(sig: u64, answer: u64) -> u64 {
    return ((sig << 1) | (sig >> 63)) ^ answer;
}

/// Word 0 of the verdict.
pub fn verdict_word(done: bool, sig_ok: bool, count_ok: bool, live: bool, beat: bool) -> u32 {
    var w : u32 = VERDICT_BASE;
    if (done) { w = w | 32; }
    if (sig_ok) { w = w | 16; }
    if (count_ok) { w = w | 8; }
    if (live) { w = w | 4; }
    if (beat) { w = w | 2; }
    if (done and sig_ok and count_ok and live) { w = w | 1; }
    return w;
}

fn on_clock(tck: bool, sel: bool, capture: bool, shift: bool, tdi: bool, engine_eng_wide: u64, engine_eng_word: u32, engine_eng_half: u16, engine_eng_byte: u8) {
    // JTAG: the words leave LSB first, sampled controls of the edge before
    tdo = (jt_s0 & 1) == 1;
    if (jt_tck1 and !jt_tck2 and jt_sel3) {
        if (jt_cap3) {
            jt_s0 = verdict_word(st_phase == P_DONE, st_sig == EXPECTED_SIG, st_count == EXPECTED_OPS, st_live, ((st_beat >> 23) & 1) == 1);
            jt_s1 = (st_sig & 4294967295) as u32;
        } else if (jt_sh3) {
            jt_s0 = (jt_s0 >> 1) | ((jt_s1 & 1) << 31);
            if (jt_tdi3) { jt_s1 = (jt_s1 >> 1) | 2147483648; } else { jt_s1 = jt_s1 >> 1; }
        }
    }
    jt_tck2 = jt_tck1;
    jt_tck1 = tck;
    jt_sel3 = jt_sel2;
    jt_sel2 = jt_sel1;
    jt_sel1 = sel;
    jt_cap3 = jt_cap2;
    jt_cap2 = jt_cap1;
    jt_cap1 = capture;
    jt_sh3 = jt_sh2;
    jt_sh2 = jt_sh1;
    jt_sh1 = shift;
    jt_tdi3 = jt_tdi2;
    jt_tdi2 = jt_tdi1;
    jt_tdi1 = tdi;
    st_beat = st_beat +% 1;
    // the run
    if (st_phase == P_LCG) {
        // y = x * LCG_MUL by Horner, from x's top bit: one bit a clock, then + LCG_ADD
        var add : u64 = 0;
        if (((st_x >> (63 - st_i)) & 1) == 1) { add = LCG_MUL; }
        const next : u64 = (st_acc << 1) +% add;
        if (st_i == 63) {
            st_y = next +% LCG_ADD;
            st_acc = 0;
            st_i = 0;
            st_k = OP_FIRST;
            st_phase = P_DRIVE;
        } else {
            st_acc = next;
            st_i = st_i + 1;
        }
    } else if (st_phase == P_DRIVE) {
        const g : u8 = set_g(st_x, st_n);
        const k0 : bool = set_flag(st_n, 2);
        if (runs(st_k, g, k0)) {
            st_op = st_k;
            st_a = set_a(st_x, st_n);
            st_b = set_b(st_x, st_y, st_n);
            st_c = set_c(st_y, st_n);
            st_d = set_d(st_y, st_n);
            st_e = set_e(st_y, st_n);
            st_f = set_f(st_y, st_n);
            st_g = g;
            st_h = set_h(st_x, st_n);
            st_k0 = k0;
            st_k1 = set_flag(st_n, 3);
            st_k2 = set_flag(st_n, 4);
            st_phase = P_WAIT;
        } else {
            st_k = st_k + 1;
        }
    } else if (st_phase == P_WAIT) {
        st_op = 0;
        st_phase = P_FOLD;
    } else if (st_phase == P_FOLD) {
        var answer : u64 = engine_eng_byte as u64;
        const cls : u8 = answer_class(st_k);
        if (cls == 0) { answer = engine_eng_wide; }
        if (cls == 1) { answer = engine_eng_word as u64; }
        if (cls == 2) { answer = engine_eng_half as u64; }
        st_sig = fold_in(st_sig, answer);
        st_count = st_count + 1;
        if (answer != 0) { st_live = true; }
        if (st_k == OP_LAST) {
            // st_n is read before it is written, so the test's order and the edge agree
            if (st_n + 1 == N_SETS) { st_phase = P_DONE; } else { st_phase = P_LCG; }
            st_x = st_y;
            st_n = st_n + 1;
        } else {
            st_k = st_k + 1;
            st_phase = P_DRIVE;
        }
    }
}

/// The card's answer to operation op on these operands: the mapping of the_engine_decides_as_the_card, which
/// proves the engine equal to it on the same sets.
pub fn card_answer(op: u8, a: u64, b: u64, c: u32, d: u32, e: u16, f: u16, g: u8, h: u8, k0: bool, k1: bool, k2: bool) -> u64 {
    if (op == HW_OP_PID_OF) { return (pid_of(c, d)) as u64; }
    if (op == HW_OP_MBOX_PUSH) { return (mbox_push(a, g)) as u64; }
    if (op == HW_OP_MBOX_REMOVE) { return (mbox_remove(a, g)) as u64; }
    if (op == HW_OP_RECEIVE) { return (receive(a, g)) as u64; }
    if (op == HW_OP_CTL_POST) { return (ctl_post(a, g)) as u64; }
    if (op == HW_OP_CTL_TAKE) { return (ctl_take(a)) as u64; }
    if (op == HW_OP_LIVE_ALIAS) { return (live_alias(a, g)) as u64; }
    if (op == HW_OP_CHAIN_ADD) { return (chain_add(a, c)) as u64; }
    if (op == HW_OP_NODE_PID) { return (node_pid(e, c, d)) as u64; }
    if (op == HW_OP_SLOT_OF) { return (slot_of(a)) as u64; }
    if (op == HW_OP_GEN_OF) { return (gen_of(a)) as u64; }
    if (op == HW_OP_NEXT_GEN) { return (next_gen(c)) as u64; }
    if (op == HW_OP_QUEEN_SHUTDOWN_MS) { return (queen_shutdown_ms(g)) as u64; }
    if (op == HW_OP_LOCAL_OF) { return (local_of(a)) as u64; }
    if (op == HW_OP_FILE_OWNER_SLOT) { return (file_owner_slot(a)) as u64; }
    if (op == HW_OP_LINKS_AFTER_LINK) { return (links_after_link(k0, g)) as u64; }
    if (op == HW_OP_MONITORS_AFTER_MONITOR) { return (monitors_after_monitor(g)) as u64; }
    if (op == HW_OP_UNSTABLE_STREAK) { return (unstable_streak(g, e)) as u64; }
    if (op == HW_OP_BACKOFF_SECONDS) { return (backoff_seconds(g)) as u64; }
    if (op == HW_OP_ROOT_CHILDREN) { return (root_children(g)) as u64; }
    if (op == HW_OP_RECLAIM_WAIT_SECONDS) { return (reclaim_wait_seconds(g, e, f)) as u64; }
    if (op == HW_OP_NODE_OF) { return (node_of(a)) as u64; }
    if (op == HW_OP_REACHES) { return (hw_byte_of(reaches(a, b))) as u64; }
    if (op == HW_OP_DELIVER) { return (deliver(k0, e, f)) as u64; }
    if (op == HW_OP_ORDERED) { return (hw_byte_of(ordered(k0, k1))) as u64; }
    if (op == HW_OP_MBOX_TAG) { return (mbox_tag(a, g)) as u64; }
    if (op == HW_OP_MBOX_LEN) { return (mbox_len(a)) as u64; }
    if (op == HW_OP_MBOX_FIND) { return (mbox_find(a, g)) as u64; }
    if (op == HW_OP_RECEIVE_OUTCOME) { return (receive_outcome(k0, c, d)) as u64; }
    if (op == HW_OP_DELIVER_CONTROL) { return (deliver_control(k0, k1)) as u64; }
    if (op == HW_OP_IS_DEAD_LETTER) { return (hw_byte_of(is_dead_letter(g))) as u64; }
    if (op == HW_OP_NEXT_LANE) { return (next_lane(k0, k1)) as u64; }
    if (op == HW_OP_CTL_PENDING) { return (hw_byte_of(ctl_pending(a, g))) as u64; }
    if (op == HW_OP_CTL_NEXT) { return (ctl_next(a)) as u64; }
    if (op == HW_OP_CALL_OUTCOME) { return (call_outcome(k0, k1, c, d)) as u64; }
    if (op == HW_OP_CHAIN_HAS) { return (hw_byte_of(chain_has(a, c))) as u64; }
    if (op == HW_OP_CALL_ADMIT) { return (call_admit(a, g, c)) as u64; }
    if (op == HW_OP_ON_EXIT_SIGNAL) { return (on_exit_signal(g, k0)) as u64; }
    if (op == HW_OP_DEATH_REASON) { return (death_reason(g)) as u64; }
    if (op == HW_OP_ATTACH_ANSWER) { return (attach_answer(k0)) as u64; }
    if (op == HW_OP_DOWN_LEFT_AFTER_DEMONITOR) { return (hw_byte_of(down_left_after_demonitor(k0, k1))) as u64; }
    if (op == HW_OP_SHOULD_RESTART) { return (hw_byte_of(should_restart(g, h))) as u64; }
    if (op == HW_OP_AFFECTED) { return (hw_byte_of(affected(g, h, e & 255))) as u64; }
    if (op == HW_OP_STOPPED_BY_RESTART) { return (hw_byte_of(stopped_by_restart(g, h, e & 255, k0))) as u64; }
    if (op == HW_OP_RESTARTED) { return (hw_byte_of(restarted(g, h, e & 255, f as u8, k0))) as u64; }
    if (op == HW_OP_STOP_RANK) { return (stop_rank(g, h)) as u64; }
    if (op == HW_OP_IN_PERIOD) { return (hw_byte_of(in_period(e, f))) as u64; }
    if (op == HW_OP_INTENSITY_EXCEEDED) { return (hw_byte_of(intensity_exceeded(g, h))) as u64; }
    if (op == HW_OP_ON_CHILD_EXIT) { return (on_child_exit(g, h, e & 255, f & 255)) as u64; }
    if (op == HW_OP_WITH_BACKOFF) { return (with_backoff(g, h)) as u64; }
    if (op == HW_OP_STOP_SIGNAL) { return (stop_signal(c, d)) as u64; }
    if (op == HW_OP_CHILD_SPEC_VALID) { return (hw_byte_of(child_spec_valid(g, k0, h))) as u64; }
    if (op == HW_OP_AUTO_SHUTDOWN_AFTER_EXIT) { return (hw_byte_of(auto_shutdown_after_exit(g, k0, h, e as u8, k1, f & 255))) as u64; }
    if (op == HW_OP_AUTO_SHUTDOWN_STICKS) { return (hw_byte_of(auto_shutdown_sticks(g))) as u64; }
    if (op == HW_OP_START_ANSWER) { return (start_answer(g, h, e & 255)) as u64; }
    if (op == HW_OP_CHILDREN_AFTER_EXIT) { return (children_after_exit(g, k0)) as u64; }
    if (op == HW_OP_ROOT_CHILD_KIND) { return (root_child_kind(g, h)) as u64; }
    if (op == HW_OP_QUEEN_RESTART_TYPE) { return (queen_restart_type(g)) as u64; }
    if (op == HW_OP_STOPS_INSIDE_THE_LEASE) { return (hw_byte_of(stops_inside_the_lease(c, e))) as u64; }
    if (op == HW_OP_LANE_OF) { return (lane_of(g)) as u64; }
    if (op == HW_OP_HUNG_TURN_SIGNAL) { return (hung_turn_signal(e)) as u64; }
    if (op == HW_OP_TURN_SIGNAL) { return (turn_signal(e, f)) as u64; }
    if (op == HW_OP_SLICE_SPENT) { return (hw_byte_of(slice_spent(g, e))) as u64; }
    if (op == HW_OP_TURN_ISOLATION) { return (turn_isolation(k0, k1, k2)) as u64; }
    if (op == HW_OP_KILL_EFFECT) { return (kill_effect(g)) as u64; }
    if (op == HW_OP_HOLDS_AFTER_KILL) { return (hw_byte_of(holds_after_kill(g, k0))) as u64; }
    if (op == HW_OP_IS_REMOTE) { return (hw_byte_of(is_remote(a, e))) as u64; }
    if (op == HW_OP_NODE_UP) { return (hw_byte_of(node_up(e))) as u64; }
    if (op == HW_OP_SEND_REMOTE) { return (send_remote(k0)) as u64; }
    if (op == HW_OP_REMOTE_DOWN) { return (remote_down(k0, k1, g)) as u64; }
    if (op == HW_OP_PLACE_BEFORE) { return (hw_byte_of(place_before(c, e, d, f))) as u64; }
    if (op == HW_OP_EDITS_MEET) { return (hw_byte_of(edits_meet(g, c, d, h, a as u32, b as u32))) as u64; }
    if (op == HW_OP_FILE_ADMIT) { return (file_admit(k0, k1, a, e)) as u64; }
    if (op == HW_OP_REFUSAL_GIVES_UP) { return (hw_byte_of(refusal_gives_up(e))) as u64; }
    if (op == HW_OP_TAKES_A_LANE) { return (hw_byte_of(takes_a_lane(g))) as u64; }
    if (op == HW_OP_EDIT_STILL_HOLDS) { return (hw_byte_of(edit_still_holds(k0, k1, e))) as u64; }
    return 0;
}

test the_signature_is_the_cards {
    // the sets and the order of the self-test, the answers from the card
    var x : u64 = X_START;
    var y : u64 = 0;
    var n : u32 = 0;
    var k : u8 = 0;
    var g : u8 = 0;
    var k0 : bool = false;
    var sig : u64 = 0;
    var ops : u32 = 0;
    while (n < N_SETS) {
        y = (x *% LCG_MUL) +% LCG_ADD;
        g = set_g(x, n);
        k0 = set_flag(n, 2);
        k = OP_FIRST;
        while (k <= OP_LAST) {
            if (runs(k, g, k0)) {
                sig = fold_in(sig, card_answer(k, set_a(x, n), set_b(x, y, n), set_c(y, n), set_d(y, n), set_e(y, n), set_f(y, n), g, set_h(x, n), k0, set_flag(n, 3), set_flag(n, 4)));
                ops = ops + 1;
            }
            k = k + 1;
        }
        x = y;
        n = n + 1;
    }
    assert_eq(ops, EXPECTED_OPS);
    assert_eq(sig, EXPECTED_SIG);
}

test the_self_test_passes_on_the_cards_answers {
    // The engine, modelled by the card: at each edge its answer registers take the card's answer to the
    // operation the self-test drove before that edge. on_clock is given the registers as they are before the
    // edge; in the generated test bench those arguments are the engine's own outputs, and each is checked
    // against this model before the edge.
    var m_wide : u64 = 0;
    var m_word : u32 = 0;
    var m_half : u16 = 0;
    var m_byte : u8 = 0;
    var p_op : u8 = 0;
    var p_a : u64 = 0;
    var p_b : u64 = 0;
    var p_c : u32 = 0;
    var p_d : u32 = 0;
    var p_e : u16 = 0;
    var p_f : u16 = 0;
    var p_g : u8 = 0;
    var p_h : u8 = 0;
    var p_k0 : bool = false;
    var p_k1 : bool = false;
    var p_k2 : bool = false;
    var answer : u64 = 0;
    var cls : u8 = 0;
    var cycles : u32 = 0;
    while (st_phase != P_DONE and cycles < 400000) {
        p_op = st_op;
        p_a = st_a;
        p_b = st_b;
        p_c = st_c;
        p_d = st_d;
        p_e = st_e;
        p_f = st_f;
        p_g = st_g;
        p_h = st_h;
        p_k0 = st_k0;
        p_k1 = st_k1;
        p_k2 = st_k2;
        on_clock(false, false, false, false, false, m_wide, m_word, m_half, m_byte);
        if (p_op >= OP_FIRST and p_op <= OP_LAST) {
            answer = card_answer(p_op, p_a, p_b, p_c, p_d, p_e, p_f, p_g, p_h, p_k0, p_k1, p_k2);
            cls = answer_class(p_op);
            if (cls == 0) { m_wide = answer; }
            if (cls == 1) { m_word = answer as u32; }
            if (cls == 2) { m_half = answer as u16; }
            if (cls == 3) { m_byte = answer as u8; }
        }
        cycles = cycles + 1;
    }
    assert st_phase == P_DONE;
    assert_eq(st_count, EXPECTED_OPS);
    assert_eq(st_sig, EXPECTED_SIG);
    assert st_live;
    // The verdict over JTAG: CAPTURE on a rising TCK, then 64 bits, LSB first, each read with TCK low and moved
    // on a rising TCK; TCK holds each level for four clocks.
    var word0 : u32 = 0;
    var word1 : u32 = 0;
    var mask : u32 = 1;
    var bitn : u32 = 0;
    var i : u32 = 0;
    while (i < 4) {
        on_clock(false, true, true, false, false, m_wide, m_word, m_half, m_byte);
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        on_clock(true, true, true, false, false, m_wide, m_word, m_half, m_byte);
        i = i + 1;
    }
    while (bitn < 64) {
        i = 0;
        while (i < 4) {
            on_clock(false, true, false, true, false, m_wide, m_word, m_half, m_byte);
            i = i + 1;
        }
        if (tdo) {
            if (bitn < 32) { word0 = word0 | mask; } else { word1 = word1 | mask; }
        }
        if (bitn == 31) { mask = 1; } else { mask = mask << 1; }
        i = 0;
        while (i < 4) {
            on_clock(true, true, false, true, false, m_wide, m_word, m_half, m_byte);
            i = i + 1;
        }
        bitn = bitn + 1;
    }
    // every flag but beat: done 32, sig_ok 16, count_ok 8, live 4, ok 1
    assert_eq(word0 & 4294967293, VERDICT_BASE | 61);
    assert_eq(word1, (EXPECTED_SIG & 4294967295) as u32);
}
