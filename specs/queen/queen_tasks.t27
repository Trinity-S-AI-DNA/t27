// specs/queen/queen_tasks.t27 - Persistent Queen task model and GitHub integration
module queen::tasks {
    // Import GitHub types
    use github::issues::{Issue, ISSUE_STATE_OPEN};
    use github::comments::Comment;

    // Queen task status enumeration
    enum TaskStatus {
        OPEN,
        CLAIMED,
        IN_PROGRESS,
        COMPLETED,
        CANCELLED,
    }

    // Evidence entry for tracking task progress
    struct Evidence {
        id: u64,
        timestamp: str,
        content: str,
        source: str,  // "incident", "agent", "system", etc.
    }

    // Primary Queen task model
    struct QueenTask {
        id: u64,
        title: str,
        status: TaskStatus,
        owner: str,        // Agent or user identifier
        github_issue_id: u32,
        evidence: [Evidence],
        created_at: str,
        updated_at: str,
        incident_id: str,  // Link to original incident if created from one
    }

    // GitHub Issue mapping: one Queen task <-> one GitHub Issue
    struct TaskIssueMapping {
        task_id: u64,
        github_issue_number: u32,
        github_issue_url: str,
        claimed_at: str,
        claim_comment_id: u32,  // ID of TASK_CLAIMED comment
    }

    // Create a new Queen task from incident
    fn task_create_from_incident(
        title: str,
        incident_id: str,
        initial_evidence: [Evidence]
    ) -> QueenTask {
        var task: QueenTask = undefined;
        task.id = timestamp_ms();  // Generate unique ID
        task.title = title;
        task.status = TaskStatus.OPEN;
        task.owner = "";
        task.github_issue_id = 0;  // Will be set when issue is created
        task.evidence = initial_evidence;
        task.created_at = iso8601_now();
        task.updated_at = iso8601_now();
        task.incident_id = incident_id;
        return task;
    }

    // Create GitHub issue for Queen task
    fn task_create_github_issue(task: QueenTask) -> (u32, str) {
        var issue: Issue = undefined;
        issue.number = generate_issue_number();
        issue.title = task.title;
        issue.state = ISSUE_STATE_OPEN;
        
        // Create issue via GitHub API (implementation would be in generated code)
        var issue_id: u32 = github::issues::issue_create(issue);
        var issue_url: str = format!("https://github.com/owner/repo/issues/{}", issue.number);
        
        return (issue_id, issue_url);
    }

    // Atomically claim Queen task and associated GitHub issue
    fn task_claim(task: QueenTask, agent_id: str) -> bool {
        // Check if task is already claimed
        if task.status != TaskStatus.OPEN {
            return false;
        }

        // Update task status
        var updated_task = task;
        updated_task.status = TaskStatus.CLAIMED;
        updated_task.owner = agent_id;
        updated_task.updated_at = iso8601_now();

        // Add claim evidence
        var claim_evidence: Evidence = undefined;
        claim_evidence.id = timestamp_ms();
        claim_evidence.timestamp = iso8601_now();
        claim_evidence.content = format!("Task claimed by agent: {}", agent_id);
        claim_evidence.source = "claim";
        
        // Create TASK_CLAIMED comment on GitHub issue
        var comment_body: str = format!("TASK_CLAIMED\nAgent: {}\nTimestamp: {}", 
                                      agent_id, iso8601_now());
        var comment_id: u32 = github::comments::comment_create(task.github_issue_id, comment_body);
        
        // Update GitHub issue with claimed label
        github::issues::issue_add_label(task.github_issue_id, "claimed");
        
        // Store claim mapping
        var mapping: TaskIssueMapping = undefined;
        mapping.task_id = task.id;
        mapping.github_issue_number = get_issue_number_from_id(task.github_issue_id);
        mapping.github_issue_url = get_issue_url(task.github_issue_id);
        mapping.claimed_at = iso8601_now();
        mapping.claim_comment_id = comment_id;
        
        return true;
    }

    // Update task status and evidence
    fn task_update_status(task: QueenTask, new_status: TaskStatus, evidence: Evidence) -> QueenTask {
        var updated_task = task;
        updated_task.status = new_status;
        updated_task.updated_at = iso8601_now();
        
        // Add evidence
        var updated_evidence = task.evidence;
        updated_evidence.push(evidence);
        updated_task.evidence = updated_evidence;
        
        return updated_task;
    }

    // Get task status label for GitHub
    fn get_status_label(status: TaskStatus) -> str {
        match status {
            TaskStatus.OPEN => "open",
            TaskStatus.CLAIMED => "claimed", 
            TaskStatus.IN_PROGRESS => "in-progress",
            TaskStatus.COMPLETED => "completed",
            TaskStatus.CANCELLED => "cancelled",
        }
    }

    // Test: Task persistence across operations
    test "task_persistence" {
        var initial_evidence: [Evidence] = undefined;
        var task = task_create_from_incident(
            "Test Queen Task",
            "incident-123",
            initial_evidence
        );
        
        // Verify task creation
        assert(task.id > 0);
        assert(task.title == "Test Queen Task");
        assert(task.status == TaskStatus.OPEN);
        assert(task.owner == "");
        
        // Test status update
        var evidence: Evidence = undefined;
        evidence.id = timestamp_ms();
        evidence.timestamp = iso8601_now();
        evidence.content = "Initial evidence";
        evidence.source = "test";
        
        var updated_task = task_update_status(task, TaskStatus.IN_PROGRESS, evidence);
        assert(updated_task.status == TaskStatus.IN_PROGRESS);
        assert(updated_task.evidence.len == 1);
        assert(updated_task.evidence[0].content == "Initial evidence");
    }

    // Test: Issue linking works
    test "issue_linking" {
        var initial_evidence: [Evidence] = undefined;
        var task = task_create_from_incident(
            "GitHub Integration Test", 
            "incident-456",
            initial_evidence
        );
        
        // Mock GitHub issue creation
        var (issue_id, issue_url) = task_create_github_issue(task);
        
        assert(issue_id > 0);
        assert(issue_url.contains("github.com"));
        assert(task.github_issue_id == issue_id);
    }

    // Test: Atomic claim protocol
    test "atomic_claim" {
        var initial_evidence: [Evidence] = undefined;
        var task = task_create_from_incident(
            "Claim Protocol Test",
            "incident-789", 
            initial_evidence
        );
        
        // First claim should succeed
        var first_claim_success = task_claim(task, "agent-001");
        assert(first_claim_success == true);
        assert(task.status == TaskStatus.CLAIMED);
        assert(task.owner == "agent-001");
        
        // Second claim should fail
        var second_claim_success = task_claim(task, "agent-002");
        assert(second_claim_success == false);
        // Task should still be claimed by first agent
        assert(task.owner == "agent-001");
    }

    // Test: Status and evidence updates are visible
    test "visibility_updates" {
        var initial_evidence: [Evidence] = undefined;
        var task = task_create_from_incident(
            "Visibility Test",
            "incident-999",
            initial_evidence
        );
        
        // Add multiple evidence entries
        for (var i = 0; i < 3; i++) {
            var evidence: Evidence = undefined;
            evidence.id = timestamp_ms();
            evidence.timestamp = iso8601_now();
            evidence.content = format!("Evidence entry {}", i);
            evidence.source = "test";
            
            task = task_update_status(task, TaskStatus.IN_PROGRESS, evidence);
        }
        
        // Verify all evidence is preserved
        assert(task.evidence.len == 3);
        assert(task.status == TaskStatus.IN_PROGRESS);
        assert(task.updated_at > task.created_at);
    }

    // Helper functions (would be implemented in generated code)
    fn timestamp_ms() -> u64 {
        // Returns current timestamp in milliseconds
        return 1700000000000u64;  // Mock implementation
    }

    fn iso8601_now() -> str {
        // Returns current time in ISO 8601 format
        return "2024-01-01T00:00:00Z";
    }

    fn generate_issue_number() -> u32 {
        // Generates unique GitHub issue number
        return 1000u32;
    }

    fn get_issue_number_from_id(issue_id: u32) -> u32 {
        return issue_id;  // Simplified mapping
    }

    fn get_issue_url(issue_id: u32) -> str {
        return format!("https://github.com/owner/repo/issues/{}", issue_id);
    }
}