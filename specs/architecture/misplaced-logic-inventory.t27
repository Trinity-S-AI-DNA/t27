// specs/architecture/misplaced-logic-inventory.t27
// Inventory of Current Misplaced Business Logic
// phi^2 + 1/phi^2 = 3 | TRINITY

module architecture::misplaced_logic_inventory {
    use base::types;
    
    // Inventory entry structure
    struct MisplacedLogicEntry {
        file_path: str,
        language: str,
        issue_type: str,
        description: str,
        severity: str,
        migration_path: str,
        business_logic_categories: [str],
        lines_affected: u32,
        recommendation: str,
    }
    
    // Complete inventory of misplaced business logic
    const MISPLACED_LOGIC_INVENTORY: [MisplacedLogicEntry] = [
        // Agent Runner System - Business Logic in Python
        MisplacedLogicEntry {
            file_path = "contrib/backend/agent-runner/agent-runner.py",
            language = "python",
            issue_type = "agent_workflow_logic",
            description = "Agent loop logic, tool execution, and task management in Python instead of .t27",
            severity = "high",
            migration_path = "specs/automation/agent-workflow.t27",
            business_logic_categories = ["agent_workflow", "task_management", "tool_execution"],
            lines_affected = 280,
            recommendation = "Move agent loop logic, tool execution strategy, and task completion criteria to .t27 spec",
        },
        
        // Agent Runner Rust Implementation - Business Logic
        MisplacedLogicEntry {
            file_path = "contrib/backend/agent-runner/src/agent.rs", 
            language = "rust",
            issue_type = "agent_state_management",
            description = "Agent state tracking, turn management, and tool coordination in Rust instead of .t27",
            severity = "high", 
            migration_path = "specs/automation/agent-state.t27",
            business_logic_categories = ["agent_state", "turn_management", "tool_coordination"],
            lines_affected = 430,
            recommendation = "Move agent state machine and turn management logic to .t27 specification",
        },
        
        // NotebookLM Enrichment - Business Logic in Python
        MisplacedLogicEntry {
            file_path = "contrib/backend/notebooklm/enrich.py",
            language = "python",
            issue_type = "content_enrichment_policy",
            description = "Content topic matching, enrichment rules, and source selection logic in Python",
            severity = "medium",
            migration_path = "specs/automation/content-enrichment.t27",
            business_logic_categories = ["content_policy", "topic_matching", "source_selection"],
            lines_affected = 688,
            recommendation = "Move content enrichment policy, topic matching rules, and source selection logic to .t27",
        },
        
        // Content Registry - Business Logic in YAML
        MisplacedLogicEntry {
            file_path = "contrib/backend/notebooklm/content_registry.yaml",
            language = "yaml",
            issue_type = "content_classification_policy",
            description = "Topic-to-content mapping and classification rules in YAML",
            severity = "medium", 
            migration_path = "specs/policy/content-classification.t27",
            business_logic_categories = ["content_policy", "topic_mapping"],
            lines_affected = 182,
            recommendation = "Convert content classification policy to .t27 specification with data binding",
        },
        
        // NotebookLM Wrap-up - Business Logic in Python
        MisplacedLogicEntry {
            file_path = "contrib/backend/notebooklm/wrapup.py",
            language = "python",
            issue_type = "session_management",
            description = "Session context extraction, summary formatting, and notebook management logic",
            severity = "medium",
            migration_path = "specs/automation/session-handling.t27",
            business_logic_categories = ["session_management", "formatting_rules", "notebook_ops"],
            lines_affected = 163,
            recommendation = "Move session lifecycle and summary formatting logic to .t27 specification",
        },
        
        // TODO: Additional entries to be discovered by audit
        // - Doctor MVP logic in Python
        // - Pareto Agent scoring logic in TypeScript/Python
        // - TRI loop orchestration logic
        // - Provider retry logic
        // - Agent conversation management
        // - Handoff rules and policies
    ];
    
    // Categories of business logic that should be in T27
    const BUSINESS_LOGIC_CATEGORIES: [str] = [
        "agent_workflow",
        "task_management", 
        "tool_execution",
        "agent_state",
        "turn_management",
        "tool_coordination",
        "content_policy",
        "topic_matching",
        "source_selection",
        "content_classification",
        "session_management",
        "formatting_rules",
        "notebook_ops",
        "orchestration",
        "policy",
        "rules",
        "retry_logic",
        "verification_gates",
        "anomaly_recovery",
        "priority_routing"
    ];
    
    // Languages that should not contain business logic
    const BUSINESS_LOGIC_FORBIDDEN_LANGUAGES: [str] = [
        "python", "typescript", "javascript", "bash", "yaml", "json"
    ];
    
    // Migration paths for misplaced logic
    const MIGRATION_PATHS: [str] = [
        "specs/automation/",
        "specs/policy/",
        "specs/workflow/",
        "specs/rules/",
        "specs/orchestration/"
    ];
    
    // Severity levels
    const SEVERITY_LEVELS: [str] = ["low", "medium", "high", "critical"];
    
    // Analysis functions
    fn get_by_language(language: str) -> [MisplacedLogicEntry] {
        var result: [MisplacedLogicEntry] = [];
        for entry in MISPLACED_LOGIC_INVENTORY {
            if entry.language == language {
                result.append(entry);
            }
        }
        return result;
    }
    
    fn get_by_severity(severity: str) -> [MisplacedLogicEntry] {
        var result: [MisplacedLogicEntry] = [];
        for entry in MISPLACED_LOGIC_INVENTORY {
            if entry.severity == severity {
                result.append(entry);
            }
        }
        return result;
    }
    
    fn get_by_category(category: str) -> [MisplacedLogicEntry] {
        var result: [MisplacedLogicEntry] = [];
        for entry in MISPLACED_LOGIC_INVENTORY {
            for cat in entry.business_logic_categories {
                if cat == category {
                    result.append(entry);
                    break;
                }
            }
        }
        return result;
    }
    
    fn get_by_issue_type(issue_type: str) -> [MisplacedLogicEntry] {
        var result: [MisplacedLogicEntry] = [];
        for entry in MISPLACED_LOGIC_INVENTORY {
            if entry.issue_type == issue_type {
                result.append(entry);
            }
        }
        return result;
    }
    
    fn total_lines_affected() -> u32 {
        var total: u32 = 0;
        for entry in MISPLACED_LOGIC_INVENTORY {
            total += entry.lines_affected;
        }
        return total;
    }
    
    fn count_by_severity() -> map[str, u32] {
        var counts: map[str, u32] = {};
        for severity in SEVERITY_LEVELS {
            counts[severity] = 0;
        }
        
        for entry in MISPLACED_LOGIC_INVENTORY {
            counts[entry.severity] += 1;
        }
        
        return counts;
    }
    
    fn generate_migration_plan() -> [str] {
        var plan: [str] = [];
        
        // Group by migration path
        var grouped: map[str, [MisplacedLogicEntry]] = {};
        
        for entry in MISPLACED_LOGIC_INVENTORY {
            if grouped[entry.migration_path] == null {
                grouped[entry.migration_path] = [];
            }
            grouped[entry.migration_path].append(entry);
        }
        
        // Generate migration steps
        for path, entries in grouped {
            plan.append("Phase 1: Migrate " + entries.len + " entries to " + path);
            for entry in entries {
                plan.append("  - Move " + entry.file_path + " → " + entry.migration_path);
                plan.append("    (" + entry.business_logic_categories.join(", ") + ")");
            }
        }
        
        return plan;
    }
    
    fn validate_inventory_completeness() -> bool {
        // Check that all entries have valid severity levels
        for entry in MISPLACED_LOGIC_INVENTORY {
            if entry.severity not in SEVERITY_LEVELS {
                return false;
            }
        }
        
        // Check that all business logic categories are valid
        for entry in MISPLACED_LOGIC_INVENTORY {
            for category in entry.business_logic_categories {
                if category not in BUSINESS_LOGIC_CATEGORIES {
                    return false;
                }
            }
        }
        
        return true;
    }
    
    fn export_to_json() -> str {
        // Would implement JSON export
        return "{}";
    }
    
    fn import_from_json(json_str: str) -> bool {
        // Would implement JSON import
        return true;
    }
    
    // Test cases
    test "inventory_structure" {
        assert(MISPLACED_LOGIC_INVENTORY.len > 0);
        
        for entry in MISPLACED_LOGIC_INVENTORY {
            assert(entry.file_path.len > 0);
            assert(entry.language.len > 0);
            assert(entry.issue_type.len > 0);
            assert(entry.severity in SEVERITY_LEVELS);
            assert(entry.business_logic_categories.len > 0);
            assert(entry.lines_affected > 0);
            assert(entry.recommendation.len > 0);
        }
    }
    
    test "filtering_functions" {
        var python_entries = get_by_language("python");
        assert(python_entries.len >= 2);  // Should find at least agent-runner and wrapup
        
        var high_severity = get_by_severity("high");
        assert(high_severity.len >= 2);  // Should find agent-runner entries
        
        var workflow_entries = get_by_category("agent_workflow");
        assert(workflow_entries.len >= 1);
    }
    
    test "migration_plan_generation" {
        var plan = generate_migration_plan();
        assert(plan.len > 0);
        
        for step in plan {
            assert(step.len > 0);
        }
    }
    
    test "inventory_validation" {
        assert(validate_inventory_completeness() == true);
        assert(total_lines_affected() > 0);
        
        var counts = count_by_severity();
        for severity in SEVERITY_LEVELS {
            assert(counts[severity] >= 0);
        }
    }
    
    // Invariants
    invariant "all_entries_valid" {
        for entry in MISPLACED_LOGIC_INVENTORY {
            assert(entry.severity in SEVERITY_LEVELS);
            assert(entry.lines_affected > 0);
            assert(entry.business_logic_categories.len > 0);
        }
    }
    
    invariant "migration_paths_valid" {
        for entry in MISPLACED_LOGIC_INVENTORY {
            assert(entry.migration_path.len > 0);
            assert(entry.migration_path.starts_with("specs/"));
        }
    }
}