// specs/architecture/t27-first-audit.t27
// T27-First Architecture Audit Tool
// phi^2 + 1/phi^2 = 3 | TRINITY

module architecture::t27_first_audit {
    use base::types;
    use architecture::t27_first_rule;

    // Audit report structure
    struct AuditReport {
        total_files_scanned: u32,
        violations_found: u32,
        misplaced_business_logic: [str],
        adapter_boundaries: [AdapterBoundary],
        recommendations: [str],
        scan_timestamp: u64,
    }

    struct AdapterBoundary {
        file_path: str,
        language: str,
        purpose: str,
        is_compliant: bool,
        issues: [str],
    }

    // Audit configuration
    struct AuditConfig {
        scan_directories: [str],
        exclude_patterns: [str],
        business_logic_indicators: [str],
        adapter_patterns: [str],
    }

    // Audit scanner
    fn scan_for_misplaced_logic(config: AuditConfig) -> AuditReport {
        var report = AuditReport {
            total_files_scanned = 0,
            violations_found = 0,
            misplaced_business_logic = [],
            adapter_boundaries = [],
            recommendations = [],
            scan_timestamp = current_timestamp(),
        };

        for directory in config.scan_directories {
            var files = list_files_recursive(directory);
            report.total_files_scanned += files.len;
            
            for file in files {
                var (is_violation, issues, boundary_info) = analyze_file(file, config);
                
                if is_violation {
                    report.violations_found += 1;
                    report.misplaced_business_logic.append(file);
                }
                
                if boundary_info.purpose.len > 0 {
                    var boundary = AdapterBoundary {
                        file_path = file,
                        language = extract_language(file),
                        purpose = boundary_info.purpose,
                        is_compliant = boundary_info.is_compliant,
                        issues = issues,
                    };
                    report.adapter_boundaries.append(boundary);
                }
            }
        }

        // Generate recommendations
        report.recommendations = generate_recommendations(report);
        
        return report;
    }

    fn analyze_file(file_path: str, config: AuditConfig) -> (bool, [str], AdapterBoundary) {
        var issues: [str] = [];
        var is_violation = false;
        var boundary_purpose = "";
        var is_compliant = true;
        
        var file_ext = extract_file_extension(file_path);
        
        // Check for business logic in forbidden languages
        if is_business_logic_language(file_ext) {
            var contains_business = detect_business_logic(file_path, config);
            if contains_business {
                is_violation = true;
                issues.append("Business logic detected in forbidden language: " + file_ext);
            }
        }
        
        // Check adapter boundaries
        var adapter_info = classify_adapter(file_path, config);
        if adapter_info.purpose.len > 0 {
            boundary_purpose = adapter_info.purpose;
            is_compliant = adapter_info.is_compliant;
            
            if not adapter_info.is_compliant {
                issues.append("Adapter boundary violation: " + adapter_info.violation);
            }
        }
        
        return (is_violation, issues, AdapterBoundary {
            file_path = file_path,
            language = file_ext,
            purpose = boundary_purpose,
            is_compliant = is_compliant,
            issues = issues,
        });
    }

    fn is_business_logic_language(ext: str) -> bool {
        var forbidden = ["py", "ts", "js", "sh", "yaml", "json"];
        for f in forbidden {
            if ext == f {
                return true;
            }
        }
        return false;
    }

    fn detect_business_logic(file_path: str, config: AuditConfig) -> bool {
        // Heuristic detection of business logic in non-T27 files
        var content = read_file_content(file_path);
        var file_lower = content.lower();
        
        // Business logic indicators
        for indicator in config.business_logic_indicators {
            if find(file_lower, indicator) >= 0 {
                return true;
            }
        }
        
        // Check file location indicators
        var path_lower = file_path.lower();
        var business_locations = [
            "/agent/",
            "/automation/", 
            "/workflow/",
            "/policy/",
            "/rules/",
            "/orchestration/",
            "/tri/",
            "/trinity/"
        ];
        
        for loc in business_locations {
            if find(path_lower, loc) >= 0 {
                return true;
            }
        }
        
        return false;
    }

    fn classify_adapter(file_path: str, config: AuditConfig) -> AdapterBoundary {
        var file_ext = extract_file_extension(file_path);
        var file_path_lower = file_path.lower();
        
        // Adapter classification patterns
        var adapter_patterns = [
            ("adapter", "General adapter"),
            ("binding", "CLI binding"),
            ("client", "API client"),
            ("github_", "GitHub adapter"),
            ("filesystem_", "Filesystem adapter"),
            ("provider_", "Provider adapter"),
            ("test_runner", "Test runner adapter"),
            ("report_", "Report renderer"),
            ("render", "Report renderer"),
            ("_", "_")
        ];
        
        for (pattern, purpose) in adapter_patterns {
            if find(file_path_lower, pattern) >= 0 {
                var is_compliant = true;
                var violation = "";
                
                // Validate adapter compliance
                if file_ext not in config.adapter_patterns {
                    is_compliant = false;
                    violation = "Adapter language not in allowed list";
                }
                
                return AdapterBoundary {
                    file_path = file_path,
                    language = file_ext,
                    purpose = purpose,
                    is_compliant = is_compliant,
                    issues = [violation] if violation.len > 0 else [],
                };
            }
        }
        
        return AdapterBoundary {
            file_path = file_path,
            language = file_ext,
            purpose = "",
            is_compliant = true,
            issues = [],
        };
    }

    fn generate_recommendations(report: AuditReport) -> [str] {
        var recommendations: [str] = [];
        
        if report.violations_found > 0 {
            recommendations.append("Move " + report.violations_found + 
                                 " instances of misplaced business logic to .t27/t27b files");
        }
        
        var non_compliant_adapters = 0;
        for boundary in report.adapter_boundaries {
            if not boundary.is_compliant {
                non_compliant_adapters += 1;
            }
        }
        
        if non_compliant_adapters > 0 {
            recommendations.append("Fix " + non_compliant_adapters + 
                                 " non-compliant adapter boundaries");
        }
        
        if report.misplaced_business_logic.len > 0 {
            recommendations.append("Create migration plan for identified business logic");
        }
        
        recommendations.append("Establish automated T27-first architecture validation in CI");
        
        return recommendations;
    }

    // Helper functions
    fn extract_file_extension(file_path: str) -> str {
        var last_dot = find_last_char(file_path, '.');
        if last_dot >= 0 and last_dot < file_path.len - 1 {
            return file_path[last_dot + 1..];
        }
        return "";
    }

    fn find_last_char(s: str, c: char) -> i32 {
        for i = s.len - 1; i >= 0; i-- {
            if s[i] == c {
                return i;
            }
        }
        return -1;
    }

    fn find(s: str, substr: str) -> i32 {
        var len_s = s.len;
        var len_sub = substr.len;
        
        if len_sub > len_s {
            return -1;
        }
        
        for i = 0; i <= len_s - len_sub; i++ {
            var match = true;
            for j = 0; j < len_sub; j++ {
                if s[i + j] != substr[j] {
                    match = false;
                    break;
                }
            }
            if match {
                return i;
            }
        }
        return -1;
    }

    fn current_timestamp() -> u64 {
        // Returns current timestamp (would need implementation)
        return 0;
    }

    fn list_files_recursive(directory: str) -> [str] {
        // Would implement file system scanning
        return [];
    }

    fn read_file_content(file_path: str) -> str {
        // Would implement file reading
        return "";
    }

    fn extract_language(file_path: str) -> str {
        return extract_file_extension(file_path);
    }

    // Test cases
    test "audit_detection" {
        var config = AuditConfig {
            scan_directories = ["./contrib", "./specs"],
            exclude_patterns = ["*.test.*", "*/tests/*"],
            business_logic_indicators = ["rule", "policy", "workflow", "orchestration", "agent"],
            adapter_patterns = ["py", "ts", "rust"],
        };
        
        var report = scan_for_misplaced_logic(config);
        assert(report.total_files_scanned >= 0);
        assert(report.violations_found >= 0);
        assert(report.recommendations.len >= 0);
    }

    test "business_logic_detection" {
        var config = AuditConfig {
            scan_directories = ["./contrib"],
            exclude_patterns = [],
            business_logic_indicators = ["rule", "policy", "workflow"],
            adapter_patterns = ["py", "ts"],
        };
        
        var (is_violation, issues, boundary) = analyze_file(
            "./contrib/backend/agent-runner/agent-runner.py", 
            config
        );
        
        // This should detect business logic in the agent runner
        // assert(is_violation == true);  // Actual result depends on implementation
        assert(issues.len >= 0);
    }

    test "adapter_classification" {
        var config = AuditConfig {
            scan_directories = ["./contrib"],
            exclude_patterns = [],
            business_logic_indicators = [],
            adapter_patterns = ["py", "ts"],
        };
        
        var (is_violation, issues, boundary) = analyze_file(
            "./contrib/backend/github_adapter.py", 
            config
        );
        
        assert(boundary.purpose == "GitHub adapter" || boundary.purpose == "");
        assert(boundary.language == "py");
    }

    // Invariants
    invariant "audit_reports_violations" {
        var config = AuditConfig {
            scan_directories = ["./contrib"],
            exclude_patterns = [],
            business_logic_indicators = [],
            adapter_patterns = ["py", "ts"],
        };
        
        var report = scan_for_misplaced_logic(config);
        assert(report.violations_found <= report.total_files_scanned);
    }

    invariant "recommendations_provided" {
        var config = AuditConfig {
            scan_directories = ["./contrib"],
            exclude_patterns = [],
            business_logic_indicators = [],
            adapter_patterns = ["py", "ts"],
        };
        
        var report = scan_for_misplaced_logic(config);
        assert(report.recommendations.len >= 0);
    }
}