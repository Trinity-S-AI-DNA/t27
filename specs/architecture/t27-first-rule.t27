// specs/architecture/t27-first-rule.t27
// T27-First Architecture Enforcement Rule
// phi^2 + 1/phi^2 = 3 | TRINITY

module architecture::t27_first_rule {
    use base::types;
    use validation::policy;

    // Architecture enforcement constants
    const SCOPE_ALL_AGENT_AUTOMATION: str = "all_agent_and_automation_logic";
    
    // Rule configuration
    struct T27FirstConfig {
        scope: str,
        logic_definition_required: [str],
        implementation_language_allowed: [str],
        business_logic_forbidden: [str],
        adapter_languages_allowed: [str],
        violation_action: str,
        violation_reason: str,
    }

    // Rule instance
    struct T27FirstRule {
        id: str,
        name: str,
        description: str,
        config: T27FirstConfig,
        enabled: bool,
    }

    // Rule factory
    fn t27_first_rule_init() -> T27FirstRule {
        var config = T27FirstConfig {
            scope = SCOPE_ALL_AGENT_AUTOMATION,
            logic_definition_required = [".t27", "t27b"],
            implementation_language_allowed = [
                "cli_binding", 
                "filesystem_adapter", 
                "github_adapter", 
                "provider_adapter", 
                "test_runner_adapter", 
                "report_renderer"
            ],
            business_logic_forbidden = [
                "python",
                "typescript", 
                "javascript",
                "bash", 
                "yaml", 
                "json"
            ],
            adapter_languages_allowed = ["python", "typescript", "rust", "zig"],
            violation_action = "block_change",
            violation_reason = "Business logic must be defined in .t27 or t27b"
        };

        return T27FirstRule {
            id = "t27_first_rule_001",
            name = "T27-First Logic Architecture",
            description = "Enforce T27-first logic: business logic in .t27/t27b, adapters only in imperative languages",
            config = config,
            enabled = true,
        };
    }

    // Rule validation functions
    fn is_t27_spec_file(file_path: str) -> bool {
        return file_path.ends_with(".t27") or file_path.ends_with("t27b");
    }

    fn is_forbidden_language(file_path: str, config: T27FirstConfig) -> bool {
        var ext = extract_file_extension(file_path);
        
        for forbidden in config.business_logic_forbidden {
            if ext == forbidden {
                return true;
            }
        }
        return false;
    }

    fn is_adapter_language(file_path: str, config: T27FirstConfig) -> bool {
        var ext = extract_file_extension(file_path);
        
        for allowed in config.adapter_languages_allowed {
            if ext == allowed {
                return true;
            }
        }
        return false;
    }

    fn extract_file_extension(file_path: str) -> str {
        var last_dot = find_last_char(file_path, '.');
        if last_dot >= 0 and last_dot < file_path.len - 1 {
            return file_path[last_dot + 1..];
        }
        return "";
    }

    fn find_last_char(s: str, c: char) -> i32 {
        for i = s.len - 1; i >= 0; i-- {
            if s[i] == c {
                return i;
            }
        }
        return -1;
    }

    // Business logic detection
    fn contains_business_logic_content(file_path: str, config: T27FirstConfig) -> bool {
        // This function would need to parse file content to detect business logic patterns
        // For now, we'll use heuristics based on file location and naming
        
        // Check if file is in automation, agent, or policy directories
        var in_agent_dir = contains(file_path, "/agent/") or contains(file_path, "/agents/");
        var in_automation_dir = contains(file_path, "/automation/");
        var in_policy_dir = contains(file_path, "/policy/") or contains(file_path, "/policy/");
        var in_workflow_dir = contains(file_path, "/workflow/") or contains(file_path, "/orchestration/");
        var in_rules_dir = contains(file_path, "/rules/");
        
        if in_agent_dir or in_automation_dir or in_policy_dir or in_workflow_dir or in_rules_dir {
            return true;
        }
        
        return false;
    }

    fn contains(s: str, substr: str) -> bool {
        return find(s, substr) >= 0;
    }

    fn find(s: str, substr: str) -> i32 {
        var len_s = s.len;
        var len_sub = substr.len;
        
        if len_sub > len_s {
            return -1;
        }
        
        for i = 0; i <= len_s - len_sub; i++ {
            var match = true;
            for j = 0; j < len_sub; j++ {
                if s[i + j] != substr[j] {
                    match = false;
                    break;
                }
            }
            if match {
                return i;
            }
        }
        return -1;
    }

    // Rule enforcement
    fn validate_file_change(file_path: str, config: T27FirstConfig) -> (bool, str) {
        var is_t27_file = is_t27_spec_file(file_path);
        var is_forbidden = is_forbidden_language(file_path, config);
        var contains_business_logic = contains_business_logic_content(file_path, config);
        
        // T27 spec files are always allowed
        if is_t27_file {
            return (true, "T27 spec file is allowed");
        }
        
        // Check for business logic in forbidden languages
        if is_forbidden and contains_business_logic {
            return (false, config.violation_reason);
        }
        
        // Adapter code is allowed
        if is_adapter_language(file_path, config) {
            return (true, "Adapter code is allowed");
        }
        
        return (true, "File change allowed");
    }

    // Rule violation handler
    fn handle_violation(rule: T27FirstRule, file_path: str) -> void {
        if rule.enabled and rule.config.violation_action == "block_change" {
            log_error("VIOLATION: " + rule.config.violation_reason + " - File: " + file_path);
            // In a real implementation, this would reject the change
        }
    }

    // Test cases
    test "t27_spec_file_allowed" {
        var config = T27FirstConfig {
            scope = SCOPE_ALL_AGENT_AUTOMATION,
            logic_definition_required = [".t27", "t27b"],
            implementation_language_allowed = ["cli_binding", "filesystem_adapter"],
            business_logic_forbidden = ["python", "typescript"],
            adapter_languages_allowed = ["python", "typescript"],
            violation_action = "block_change",
            violation_reason = "Business logic must be defined in .t27 or t27b"
        };
        
        var (valid, reason) = validate_file_change("specs/server/agent-runner.t27", config);
        assert(valid == true);
        assert(reason == "T27 spec file is allowed");
    }

    test "business_logic_detection" {
        var config = T27FirstConfig {
            scope = SCOPE_ALL_AGENT_AUTOMATION,
            logic_definition_required = [".t27", "t27b"],
            implementation_language_allowed = ["cli_binding", "filesystem_adapter"],
            business_logic_forbidden = ["python", "typescript"],
            adapter_languages_allowed = ["python", "typescript"],
            violation_action = "block_change",
            violation_reason = "Business logic must be defined in .t27 or t27b"
        };
        
        // This should detect business logic in the agent runner
        var (valid, reason) = validate_file_change("contrib/backend/agent-runner/agent-runner.py", config);
        assert(valid == false);  // Should be blocked due to business logic in Python
        assert(reason == "Business logic must be defined in .t27 or t27b");
    }

    test "forbidden_business_logic_blocked" {
        var config = T27FirstConfig {
            scope = SCOPE_ALL_AGENT_AUTOMATION,
            logic_definition_required = [".t27", "t27b"],
            implementation_language_allowed = ["cli_binding", "filesystem_adapter"],
            business_logic_forbidden = ["python", "typescript"],
            adapter_languages_allowed = ["python", "typescript"],
            violation_action = "block_change",
            violation_reason = "Business logic must be defined in .t27 or t27b"
        };
        
        var (valid, reason) = validate_file_change("specs/agents/agent-business-logic.py", config);
        assert(valid == false);
        assert(reason == "Business logic must be defined in .t27 or t27b");
    }

    test "adapter_code_allowed" {
        var config = T27FirstConfig {
            scope = SCOPE_ALL_AGENT_AUTOMATION,
            logic_definition_required = [".t27", "t27b"],
            implementation_language_allowed = ["cli_binding", "filesystem_adapter"],
            business_logic_forbidden = ["python", "typescript"],
            adapter_languages_allowed = ["python", "typescript"],
            violation_action = "block_change",
            violation_reason = "Business logic must be defined in .t27 or t27b"
        };
        
        var (valid, reason) = validate_file_change("adapters/github_adapter.py", config);
        assert(valid == true);
        assert(reason == "Adapter code is allowed");
    }

    test "rule_initialization" {
        var rule = t27_first_rule_init();
        assert(rule.id == "t27_first_rule_001");
        assert(rule.name == "T27-First Logic Architecture");
        assert(rule.enabled == true);
        assert(rule.config.scope == SCOPE_ALL_AGENT_AUTOMATION);
    }

    // Invariants
    invariant "business_logic_requires_t27" {
        var rule = t27_first_rule_init();
        // All business logic must be in .t27 or t27b files
        for forbidden in rule.config.business_logic_forbidden {
            assert(find(SCOPE_ALL_AGENT_AUTOMATION, forbidden) < 0 || 
                   forbidden in rule.config.adapter_languages_allowed);
        }
    }

    invariant "adapter_languages_are_allowed" {
        var rule = t27_first_rule_init();
        // All adapter languages must be explicitly allowed
        for adapter in rule.config.adapter_languages_allowed {
            assert(adapter in rule.config.adapter_languages_allowed);
        }
    }
}