// SPDX-License-Identifier: Apache-2.0
// specs/conformance/gen_verilog_struct_local.t27 -- gen-verilog: a struct-typed
// local declared with an untyped const inside a nested block lowers to unbound
// field names. Defines expected conformance behavior.
// Part of M6 milestone (milestone #10). Closes #12277.
// phi^2 + 1/phi^2 = 3 | TRINITY

module conformance::gen_verilog_struct_local;

pub struct Point { x: i32, y: i32 };

pub struct NestedBlock { p: Point, bound: bool };

pub fn nested_block_bound(n: NestedBlock) -> bool {
    return n.bound;
}

test "nested_block_bound" {
    assert(nested_block_bound(NestedBlock { p: Point { x: 1, y: 2 }, bound: true }));
    assert(!nested_block_bound(NestedBlock { p: Point { x: 1, y: 2 }, bound: false }));
}

invariant point_has_two_fields {
    var p = Point { x: 0, y: 0 };
    assert p.x == 0;
    assert p.y == 0;
}