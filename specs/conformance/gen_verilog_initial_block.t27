// SPDX-License-Identifier: Apache-2.0
// specs/conformance/gen_verilog_initial_block.t27 -- gen-verilog: [0] ** 65536
// gets an empty initial block, so an unwritten byte reads X in iverilog and 0
// in Zig. Defines expected conformance behavior.
// Part of M6 milestone (milestone #10). Closes #12298.
// phi^2 + 1/phi^2 = 3 | TRINITY

module conformance::gen_verilog_initial_block;

pub const INIT_BLOCK_BYTES : u32 = 65536;

pub struct InitialBlock { size: u32, initialized: bool };

pub fn initial_block_initialized(b: InitialBlock) -> bool {
    return b.initialized && b.size == INIT_BLOCK_BYTES;
}

test "initial_block_initialized" {
    assert(initial_block_initialized(InitialBlock { size: 65536, initialized: true }));
    assert(!initial_block_initialized(InitialBlock { size: 100, initialized: true }));
    assert(!initial_block_initialized(InitialBlock { size: 65536, initialized: false }));
}

invariant init_block_bytes_defined {
    assert INIT_BLOCK_BYTES == 65536;
}