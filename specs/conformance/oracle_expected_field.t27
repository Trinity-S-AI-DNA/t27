// SPDX-License-Identifier: Apache-2.0
// specs/conformance/oracle_expected_field.t27 -- Oracle cluster: expected
// 'X' after field.
// Part of M1 (milestone #5). Closes #13450.
// phi^2 + 1/phi^2 = 3 | TRINITY

module conformance::oracle_expected_field;

pub struct FieldParse { expected: str, found: str };

pub fn field_parse_expected_match(p: FieldParse) -> bool {
    return p.expected == p.found;
}

test "field parse expected match" {
    assert(field_parse_expected_match(FieldParse { expected: "X", found: "X" }));
    assert(!field_parse_expected_match(FieldParse { expected: "X", found: "Y" }));
}