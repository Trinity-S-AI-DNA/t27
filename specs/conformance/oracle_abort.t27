// SPDX-License-Identifier: Apache-2.0
// specs/conformance/oracle_abort.t27 -- Oracle cluster: test command
// terminated with signal ABRT.
// Part of M1 (milestone #5). Closes #14075, #13449, #13126.
// phi^2 + 1/phi^2 = 3 | TRINITY

module conformance::oracle_abort;

pub const ORACLE_ABRT_EXIT_CODE : i32 = 134;

pub struct TestResult { exit_code: i32, aborted: bool };

pub fn test_result_aborted(r: TestResult) -> bool {
    return r.aborted && r.exit_code == ORACLE_ABRT_EXIT_CODE;
}

test "test result aborted" {
    assert(test_result_aborted(TestResult { exit_code: 134, aborted: true }));
    assert(!test_result_aborted(TestResult { exit_code: 0, aborted: false }));
}

invariant oracle_abrt_exit_code {
    assert ORACLE_ABRT_EXIT_CODE == 134;
}