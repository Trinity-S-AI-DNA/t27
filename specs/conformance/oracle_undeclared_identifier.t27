// SPDX-License-Identifier: Apache-2.0
// specs/conformance/oracle_undeclared_identifier.t27 -- Oracle cluster: use
// of undeclared identifier 'X'.
// Part of M1 (milestone #5). Closes #14074, #13448, #13125.
// phi^2 + 1/phi^2 = 3 | TRINITY

module conformance::oracle_undeclared_identifier;

pub struct Identifier { name: str, declared: bool };

pub fn identifier_declared(i: Identifier) -> bool {
    return i.declared;
}

test "identifier declared" {
    assert(identifier_declared(Identifier { name: "X", declared: true }));
    assert(!identifier_declared(Identifier { name: "X", declared: false }));
}