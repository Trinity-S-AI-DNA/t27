// SPDX-License-Identifier: Apache-2.0
// specs/conformance/oracle_array_init.t27 -- Oracle cluster: type 'X' does
// not support array initialization syntax.
// Part of M1 (milestone #5). Closes #14073.
// phi^2 + 1/phi^2 = 3 | TRINITY

module conformance::oracle_array_init;

pub struct TypeInfo { name: str, supports_array_init: bool };

pub fn type_supports_array_init(t: TypeInfo) -> bool {
    return t.supports_array_init;
}

test "type supports array init" {
    assert(type_supports_array_init(TypeInfo { name: "X", supports_array_init: true }));
    assert(!type_supports_array_init(TypeInfo { name: "X", supports_array_init: false }));
}