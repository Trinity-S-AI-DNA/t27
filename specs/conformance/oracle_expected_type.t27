// specs/conformance/oracle_expected_type.t27 -- Oracle cluster: expected
// type 'X', found 'X'.
// Part of M1 (milestone #5). Closes #13127.
// phi^2 + 1/phi^2 = 3 | TRINITY

module conformance::oracle_expected_type;

pub struct TypeMatch { expected: str, found: str };

pub fn type_match_expected(m: TypeMatch) -> bool {
    return m.expected == m.found;
}

test "type match expected" {
    assert(type_match_expected(TypeMatch { expected: "X", found: "X" }));
    assert(!type_match_expected(TypeMatch { expected: "X", found: "Y" }));
}