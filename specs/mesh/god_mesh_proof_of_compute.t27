// SPDX-License-Identifier: Apache-2.0
// specs/mesh/god_mesh_proof_of_compute.t27 -- the PROOF OF COMPUTE layer of GOD MESH (ORDER:
// HEALTHY_MESH_PROOF_OF_COMPUTE, scope 2). It decides whether a piece of compute the mesh ran is
// PROVEN, and only then does it name the payout outcome the settlement layer may run. DESIGN ONLY:
// a decision table with tests, in the style of specs/queen/payout_evidence_msg.t27.
//
// A PROOF IS NOT A LOG (the owner's boundary): poc_log_alone_proves is FALSE for every input. The
// T27L log carries provenance; a proof of compute additionally needs the change merged, the checks
// passed with zero vacuous tests, the seal matched, the artifact hash matched and a verifier that
// did not verify its own work (section 1). Any missing item refuses the proof, in a fixed order.
//
// NO FAKE PROOFS, FAIL CLOSED (section 2): a refused proof NEVER maps to a slashing or punishment
// outcome -- the outcomes here are CREDITED (0), UNVERIFIABLE_NOT_CHARGED (4) and NOT_ELIGIBLE (5),
// never OUT_REJECTED_AND_SLASHED (1). A replayed proof (a nonce seen before) is already settled and
// charged nothing (section 3). poc_hides_failure is FALSE for every input: no path of this layer
// papers over a failed verification, and an unknown refusal never invents an outcome.
//
// Cross-spec numbers are copied as LITERALS with literal tests and a comment naming the source:
// OUT_CREDITED = 0, OUT_UNVERIFIABLE_NOT_CHARGED = 4, OUT_ALREADY_SETTLED_NOT_CHARGED = 6 from
// specs/verified/payout.t27 (the OUT_* block, ledger.zig Outcome order). A `use` of another spec
// would splice that whole spec into this one.
// Not here: the verifier itself, the seal tool, the ledger and every amount; this is a decision
// table with tests. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module MeshProofOfCompute;

// --- 1. Proof refusal codes -------------------------------------------------------------------------

/// The proof codes. POC_OK: the compute is proven. The refusals name the FIRST failed item in the
/// fixed order of poc_refusal: the change is not merged, the checks did not pass, vacuous tests
/// exist, the seal does not match, the artifact hash does not match, the verifier is not
/// independent. GOLDEN-PIPELINE SHAPE: zero vacuous tests and an independent verifier are the same
/// bar the repo's own golden chain applies to a spec.
pub const POC_OK : u8 = 0;
pub const POC_REFUSE_NOT_MERGED : u8 = 1;
pub const POC_REFUSE_CHECKS_FAILED : u8 = 2;
pub const POC_REFUSE_VACUOUS : u8 = 3;
pub const POC_REFUSE_SEAL_MISMATCH : u8 = 4;
pub const POC_REFUSE_HASH_MISMATCH : u8 = 5;
pub const POC_REFUSE_NOT_INDEPENDENT : u8 = 6;

/// The first failed item of a proof of compute, or POC_OK. The order is fixed: merged, checks,
/// vacuous, seal, hash, independence. When two items fail the earlier one is named. A proof is
/// POC_OK only when ALL six items hold and the vacuous count is exactly 0: one vacuous test is
/// already a fake proof.
pub fn poc_refusal(change_merged : bool, checks_passed : bool, vacuous_count : u32, seal_matched : bool, hash_matches : bool, verifier_independent : bool) -> u8 {
    if (!change_merged) { return POC_REFUSE_NOT_MERGED; }
    if (!checks_passed) { return POC_REFUSE_CHECKS_FAILED; }
    if (vacuous_count != 0) { return POC_REFUSE_VACUOUS; }
    if (!seal_matched) { return POC_REFUSE_SEAL_MISMATCH; }
    if (!hash_matches) { return POC_REFUSE_HASH_MISMATCH; }
    if (!verifier_independent) { return POC_REFUSE_NOT_INDEPENDENT; }
    return POC_OK;
}

// --- 2. Outcomes ------------------------------------------------------------------------------------

/// The settlement outcomes this layer may name, copied as LITERALS from specs/verified/payout.t27
/// (the OUT_* block, the order of Outcome in the ledger): OUT_CREDITED = 0,
/// OUT_UNVERIFIABLE_NOT_CHARGED = 4, OUT_ALREADY_SETTLED_NOT_CHARGED = 6. The literal tests pin
/// them. OUT_REJECTED_AND_SLASHED = 1 is deliberately ABSENT from this layer: a proof failure is
/// never punished here, it is simply not paid.
pub const POC_OUT_CREDITED : u8 = 0;
pub const POC_OUT_UNVERIFIABLE_NOT_CHARGED : u8 = 4;
pub const POC_OUT_ALREADY_SETTLED : u8 = 6;
pub const POC_OUT_NEVER_SLASHED : u8 = 1;

/// The outcome of a refused proof, and only of a proof. POC_OK maps to OUT_CREDITED: proven
/// compute is what credit pays for. NOT_MERGED and NOT_INDEPENDENT map to OUT_NOT_ELIGIBLE: the
/// work is not in a state this layer may verify at all, so it is not eligible, not charged. Every
/// FAILED-VERIFICATION refusal (checks, vacuous, seal, hash) maps to
/// OUT_UNVERIFIABLE_NOT_CHARGED: the compute could not be verified, so it is not charged. The
/// outcome is NEVER OUT_REJECTED_AND_SLASHED: no input of this function can produce the literal 1.
pub fn poc_outcome_of(refusal : u8) -> u8 {
    if (refusal == POC_OK) { return POC_OUT_CREDITED; }
    if (refusal == POC_REFUSE_NOT_MERGED) { return 5; }
    if (refusal == POC_REFUSE_NOT_INDEPENDENT) { return 5; }
    return POC_OUT_UNVERIFIABLE_NOT_CHARGED;
}

// --- 3. Replay --------------------------------------------------------------------------------------

/// The outcome of a replayed proof: a nonce seen before is a work already settled, so the outcome
/// is OUT_ALREADY_SETTLED_NOT_CHARGED (literal 6) and the proof is not re-evaluated; a fresh nonce
/// is not a replay and this function defers to the full proof of section 1, which it answers as
/// POC_OK for the replay question alone. NO DOUBLE PAY also means no double evaluation.
pub fn poc_replay_outcome(nonce_seen_before : bool) -> u8 {
    if (nonce_seen_before) { return POC_OUT_ALREADY_SETTLED; }
    return POC_OK;
}

// --- 4. The log is not a proof ----------------------------------------------------------------------

/// Whether the T27L log ALONE proves compute: FALSE for every input. The log carries provenance
/// (who ran what, when, with which record); a proof of compute additionally needs the six items of
/// section 1. A log entry without the six items is an allegation, never a proof. This function has
/// one honest answer and the tests pin it for both inputs, so no caller can quietly substitute a
/// log for a proof.
pub fn poc_log_alone_proves(evidence_present : bool) -> bool {
    if (evidence_present) { return false; }
    return false;
}

/// Whether any path of this layer hides a failure: FALSE for every input. The layer fails closed:
/// every missing item refuses (section 1), every refused verification is not charged (section 2),
/// and an unknown refusal code also answers OUT_UNVERIFIABLE_NOT_CHARGED rather than inventing an
/// outcome. There is no retry loop, no fall-through and no default-success anywhere in this file.
pub fn poc_hides_failure(any_input : u8) -> bool {
    if (any_input == POC_OK) { return false; }
    if (any_input == POC_REFUSE_NOT_MERGED) { return false; }
    if (any_input == POC_REFUSE_CHECKS_FAILED) { return false; }
    if (any_input == POC_REFUSE_VACUOUS) { return false; }
    if (any_input == POC_REFUSE_SEAL_MISMATCH) { return false; }
    if (any_input == POC_REFUSE_HASH_MISMATCH) { return false; }
    if (any_input == POC_REFUSE_NOT_INDEPENDENT) { return false; }
    return false;
}

// --- 5. Literal pin tests ---------------------------------------------------------------------------

test the_proof_codes_are_seven_distinct_codes {
    assert POC_OK == 0;
    assert POC_REFUSE_NOT_MERGED == 1;
    assert POC_REFUSE_CHECKS_FAILED == 2;
    assert POC_REFUSE_VACUOUS == 3;
    assert POC_REFUSE_SEAL_MISMATCH == 4;
    assert POC_REFUSE_HASH_MISMATCH == 5;
    assert POC_REFUSE_NOT_INDEPENDENT == 6;
    assert POC_OK != POC_REFUSE_NOT_MERGED and POC_REFUSE_NOT_MERGED != POC_REFUSE_CHECKS_FAILED and POC_REFUSE_CHECKS_FAILED != POC_REFUSE_VACUOUS and POC_REFUSE_VACUOUS != POC_REFUSE_SEAL_MISMATCH and POC_REFUSE_SEAL_MISMATCH != POC_REFUSE_HASH_MISMATCH and POC_REFUSE_HASH_MISMATCH != POC_REFUSE_NOT_INDEPENDENT;
}

test the_copied_outcomes_match_the_payout_layer {
    assert POC_OUT_CREDITED == 0;
    assert POC_OUT_NEVER_SLASHED == 1;
    assert POC_OUT_UNVERIFIABLE_NOT_CHARGED == 4;
    assert POC_OUT_ALREADY_SETTLED == 6;
}

test a_complete_proof_is_ok_and_every_missing_item_alone_names_its_refusal {
    assert poc_refusal(true, true, 0, true, true, true) == POC_OK;
    assert poc_refusal(false, true, 0, true, true, true) == POC_REFUSE_NOT_MERGED;
    assert poc_refusal(true, false, 0, true, true, true) == POC_REFUSE_CHECKS_FAILED;
    assert poc_refusal(true, true, 1, true, true, true) == POC_REFUSE_VACUOUS;
    assert poc_refusal(true, true, 0, false, true, true) == POC_REFUSE_SEAL_MISMATCH;
    assert poc_refusal(true, true, 0, true, false, true) == POC_REFUSE_HASH_MISMATCH;
    assert poc_refusal(true, true, 0, true, true, false) == POC_REFUSE_NOT_INDEPENDENT;
}

test when_two_proof_items_fail_the_earlier_one_is_named {
    assert poc_refusal(false, false, 0, true, true, true) == POC_REFUSE_NOT_MERGED;
    assert poc_refusal(false, true, 5, true, true, true) == POC_REFUSE_NOT_MERGED;
    assert poc_refusal(true, false, 1, true, true, true) == POC_REFUSE_CHECKS_FAILED;
    assert poc_refusal(true, true, 2, false, false, true) == POC_REFUSE_VACUOUS;
    assert poc_refusal(true, true, 0, false, false, false) == POC_REFUSE_SEAL_MISMATCH;
    assert poc_refusal(true, true, 0, true, false, false) == POC_REFUSE_HASH_MISMATCH;
}

test one_vacuous_test_is_already_a_refusal_but_zero_is_not {
    assert poc_refusal(true, true, 1, true, true, true) == POC_REFUSE_VACUOUS;
    assert poc_refusal(true, true, 7, true, true, true) == POC_REFUSE_VACUOUS;
    assert poc_refusal(true, true, 0, true, true, true) == POC_OK;
}

test proven_compute_credits_and_failed_verification_is_not_charged {
    assert poc_outcome_of(POC_OK) == 0;
    assert poc_outcome_of(POC_REFUSE_CHECKS_FAILED) == 4;
    assert poc_outcome_of(POC_REFUSE_VACUOUS) == 4;
    assert poc_outcome_of(POC_REFUSE_SEAL_MISMATCH) == 4;
    assert poc_outcome_of(POC_REFUSE_HASH_MISMATCH) == 4;
    assert poc_outcome_of(POC_REFUSE_NOT_MERGED) == 5;
    assert poc_outcome_of(POC_REFUSE_NOT_INDEPENDENT) == 5;
    assert poc_outcome_of(99) == 4;
}

test no_proof_outcome_is_ever_the_slash_outcome {
    assert poc_outcome_of(POC_OK) != 1;
    assert poc_outcome_of(POC_REFUSE_NOT_MERGED) != 1;
    assert poc_outcome_of(POC_REFUSE_CHECKS_FAILED) != 1;
    assert poc_outcome_of(POC_REFUSE_VACUOUS) != 1;
    assert poc_outcome_of(POC_REFUSE_SEAL_MISMATCH) != 1;
    assert poc_outcome_of(POC_REFUSE_HASH_MISMATCH) != 1;
    assert poc_outcome_of(POC_REFUSE_NOT_INDEPENDENT) != 1;
    assert poc_outcome_of(99) != 1;
}

test a_replayed_proof_is_already_settled_and_a_fresh_one_is_not {
    assert poc_replay_outcome(true) == 6;
    assert poc_replay_outcome(false) == 0;
    assert poc_replay_outcome(true) != poc_replay_outcome(false);
}

test the_log_alone_never_proves_compute {
    assert !poc_log_alone_proves(true);
    assert !poc_log_alone_proves(false);
}

test no_input_of_this_layer_hides_a_failure {
    assert !poc_hides_failure(POC_OK);
    assert !poc_hides_failure(POC_REFUSE_NOT_MERGED);
    assert !poc_hides_failure(POC_REFUSE_CHECKS_FAILED);
    assert !poc_hides_failure(POC_REFUSE_VACUOUS);
    assert !poc_hides_failure(POC_REFUSE_SEAL_MISMATCH);
    assert !poc_hides_failure(POC_REFUSE_HASH_MISMATCH);
    assert !poc_hides_failure(POC_REFUSE_NOT_INDEPENDENT);
    assert !poc_hides_failure(99);
}

// --- 6. Invariants ----------------------------------------------------------------------------------

invariant poc_codes_are_distinct_and_count_from_one { assert POC_OK == 0 and POC_REFUSE_NOT_MERGED == 1 and POC_REFUSE_CHECKS_FAILED == 2 and POC_REFUSE_VACUOUS == 3 and POC_REFUSE_SEAL_MISMATCH == 4 and POC_REFUSE_HASH_MISMATCH == 5 and POC_REFUSE_NOT_INDEPENDENT == 6; }
invariant poc_never_slashes_and_only_a_full_proof_credits { assert poc_outcome_of(POC_OK) == 0 and poc_outcome_of(POC_REFUSE_CHECKS_FAILED) == 4 and poc_outcome_of(POC_REFUSE_NOT_MERGED) == 5 and poc_outcome_of(POC_REFUSE_NOT_INDEPENDENT) == 5 and poc_outcome_of(99) == 4 and poc_outcome_of(POC_OK) != 1; }
invariant poc_log_alone_proves_nothing_and_nothing_hides_a_failure { assert !poc_log_alone_proves(true) and !poc_log_alone_proves(false) and !poc_hides_failure(0) and !poc_hides_failure(99) and poc_replay_outcome(true) == 6; }
invariant poc_zero_vacuous_is_the_bar { assert poc_refusal(true, true, 0, true, true, true) == POC_OK and poc_refusal(true, true, 1, true, true, true) == POC_REFUSE_VACUOUS; }
