// SPDX-License-Identifier: Apache-2.0
// specs/mesh/god_mesh_work_record.t27 -- the WORK RECORD of GOD MESH (ORDER: GOD_MESH_TRI_TOKEN,
// scope 1+2: the T27L LOG -> mesh integration). It defines what an agent writes into the T27L log
// when it finishes work, and the conditions under which the mesh may act on a record. DESIGN ONLY:
// a decision table with tests, in the style of specs/queen/payout_evidence_msg.t27.
//
// Work kinds (section 1) are the payment table of GOD MESH: toolchain, build, test, report and copy
// (a copy reuses another agent's result). A record is logged on the T27L pipeline surface with the
// execution actions (section 2), carried by three message tags that continue the payout-evidence
// tags (section 3), and admitted by a fixed refusal order (section 4). THE CENTRAL RULE of this
// layer: A RECORD WITHOUT EVIDENCE IS NOT A WORK RECORD. The refusal WR_REFUSE_NO_EVIDENCE exists
// so that no agent can claim credit for work the log cannot prove.
//
// This layer moves no value and mints nothing. There is no amount anywhere in this file: no input
// carries one, no output returns one, no constant holds one. Token economics is gated elsewhere and
// needs the owner's approval; what is here is only WHO did WHAT with which evidence, and whether
// the mesh may act on it (section 5). The mesh boundary is "LOG connected": the mesh acts on logged
// records only, so a work without a WR_TAG_RECORD event in the T27L log is invisible to the mesh.
//
// Strings never ride a function: every function below takes or returns u8/u64/bool only. The two
// strings of this layer are display constants only (section 2): WR_T27L_VERSION names the log
// format the record speaks and WR_EVENT_ID_PREFIX the shape of a log event id; both are tested
// against literals and never passed through a function signature.
//
// Cross-spec numbers (t27l_surface.t27, payout_evidence_msg.t27, actors.t27) are copied as
// LITERALS with literal tests and a comment naming the source file and line: a `use` of another
// spec would splice that whole spec into this one.
// Not here: the log writer, the mailbox, the claim handler and every amount; this is a decision
// table with tests. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module MeshWorkRecord;

// --- 1. Work kinds ----------------------------------------------------------------------------------

/// The five work kinds, the payment table of GOD MESH. TOOLCHAIN: a binary or toolchain was
/// installed. BUILD: an artifact was built. TEST: checks were run. REPORT: a report was written.
/// COPY: no new work, another agent's result was reused; a copy earns at most what the payment
/// layer decides for copies, and this layer only makes it visible as a copy.
pub const WK_TOOLCHAIN : u8 = 0;
pub const WK_BUILD : u8 = 1;
pub const WK_TEST : u8 = 2;
pub const WK_REPORT : u8 = 3;
pub const WK_COPY : u8 = 4;
pub const WK_COUNT : u8 = 5;

/// Whether a kind is one of the five work kinds: kind < WK_COUNT. Any other number, including 5
/// (WK_COUNT itself) and 99, is not a work kind; a record of an unknown kind is refused (section 4)
/// and logs EA_FAILED (section 2).
pub fn wr_kind_known(kind : u8) -> bool {
    return kind < WK_COUNT;
}

// --- 2. T27L literals of the log event --------------------------------------------------------------

/// The surface and execution-action codes a WORK RECORD event uses, copied as LITERALS from
/// specs/t27mcp/t27l_surface.t27: SF_PIPELINE = 0 (line 12), EA_ASSIGNED = 0 (line 60),
/// EA_STARTED = 1 (line 61), EA_FINISHED = 2 (line 62), EA_FAILED = 3 (line 63). The literal tests
/// in section 7 pin them; a `use` of t27l_surface.t27 would splice that whole spec into this one.
pub const SF_PIPELINE : u8 = 0;
pub const EA_ASSIGNED : u8 = 0;
pub const EA_STARTED : u8 = 1;
pub const EA_FINISHED : u8 = 2;
pub const EA_FAILED : u8 = 3;

/// The log format the record speaks, and the shape of a log event id. Display constants only
/// (source: specs/t27mcp/t27l_surface.t27, T27L_VERSION at line 78, EVENT_ID_PREFIX at line 81).
/// They are asserted against literals in the tests and never ride a function.
pub const WR_T27L_VERSION : str = "t27l/v1";
pub const WR_EVENT_ID_PREFIX : str = "evt_";

/// The execution-surface action of the WORK RECORD event for a work kind. A known kind was
/// finished, so the record logs EA_FINISHED (literal 2); an unknown kind never happened as work,
/// so it logs EA_FAILED (literal 3) and is refused in section 4. The log event itself carries the
/// WR_TAG_RECORD tag of section 3.
pub fn wr_log_event(kind : u8) -> u8 {
    if (wr_kind_known(kind)) { return EA_FINISHED; }
    return EA_FAILED;
}

// --- 3. Message tags and lanes ----------------------------------------------------------------------

/// The three message tags of the mesh work-record protocol. They sit directly above the
/// payout-evidence tags PE_TAG_CLAIM = 25, PE_TAG_VERDICT = 26, PE_TAG_DISPUTE = 27 of
/// specs/queen/payout_evidence_msg.t27 (lines 26-28), so a mailbox that carries several protocols
/// never confuses them. RECORD reports a finished work; COPY reports a reused result; ADOPT
/// announces that one agent adopts another agent's record as its own.
pub const WR_TAG_RECORD : u64 = 28;
pub const WR_TAG_COPY : u64 = 29;
pub const WR_TAG_ADOPT : u64 = 30;

/// Whether a tag is one of the three mesh tags. Anything else, including 0, the payout tags 25..27
/// and 31, is not: a receiver of this protocol drops what it does not know.
pub fn wr_known_tag(tag : u64) -> bool {
    if (tag == WR_TAG_RECORD) { return true; }
    if (tag == WR_TAG_COPY) { return true; }
    if (tag == WR_TAG_ADOPT) { return true; }
    return false;
}

/// The lane of a tag, with the lane numbers of specs/queen/actors.t27 (0 is the data lane, 1 the
/// control lane). RECORD and COPY are work results and ride the data lane. ADOPT rides the control
/// lane: an adoption changes who benefits from a record, a control-plane fact that a full data
/// mailbox must not hide. Any other tag is data.
pub fn wr_lane_of(tag : u64) -> u8 {
    if (tag == WR_TAG_ADOPT) { return 1; }
    return 0;
}

// --- 4. Record validity, no fake work ---------------------------------------------------------------

/// The admission codes of a WORK RECORD. WR_OK: every fact is present. The others name the FIRST
/// missing fact in the fixed order of wr_refusal: the kind is unknown, the agent is unknown, the
/// artifact is not recorded, the evidence is not recorded. A RECORD WITHOUT EVIDENCE IS NOT A WORK
/// RECORD: a work whose evidence is missing is refused, never admitted half-true.
pub const WR_OK : u8 = 0;
pub const WR_REFUSE_UNKNOWN_KIND : u8 = 1;
pub const WR_REFUSE_UNKNOWN_AGENT : u8 = 2;
pub const WR_REFUSE_NO_ARTIFACT : u8 = 3;
pub const WR_REFUSE_NO_EVIDENCE : u8 = 4;

/// The first missing fact of a work record, or WR_OK. The four inputs are OUTCOMES decided
/// elsewhere (the kind by wr_kind_known of this file; the agent, the artifact and the evidence by
/// the log and the registry, which this file restates no rule for). The order is fixed: unknown
/// kind, unknown agent, missing artifact, missing evidence. When two facts are missing the earlier
/// one is named. WR_OK only when the kind is known AND the agent is known AND the artifact is
/// recorded AND the evidence is recorded.
pub fn wr_refusal(kind : u8, agent_known : bool, artifact_recorded : bool, evidence_recorded : bool) -> u8 {
    if (wr_kind_known(kind) == false) { return WR_REFUSE_UNKNOWN_KIND; }
    if (agent_known == false) { return WR_REFUSE_UNKNOWN_AGENT; }
    if (artifact_recorded == false) { return WR_REFUSE_NO_ARTIFACT; }
    if (evidence_recorded == false) { return WR_REFUSE_NO_EVIDENCE; }
    return WR_OK;
}

// --- 5. When the mesh may claim ---------------------------------------------------------------------

/// Whether the mesh may act on a work record: claim it for payment-shaped handling downstream, or
/// copy or adopt it, per the tag of the event. The boundary of GOD MESH is LOG connected: the mesh
/// sees only what the T27L log holds, so a work without a WR_TAG_RECORD event in the log is
/// invisible to the mesh and nothing may be claimed for it, however valid the record would be.
/// True iff logged AND refusal == WR_OK AND NOT already_claimed; any one failing fact is enough to
/// refuse. This function moves no value: what a granted claim is worth is decided elsewhere.
pub fn wr_mesh_may_claim(logged : bool, refusal : u8, already_claimed : bool) -> bool {
    if (logged == false) { return false; }
    if (refusal != WR_OK) { return false; }
    if (already_claimed) { return false; }
    return true;
}

// --- 6. Duplicate replies ---------------------------------------------------------------------------

/// The three replies to a claim on a work record, the same codes and the same order as the CLAIM
/// replies of specs/queen/payout_evidence_msg.t27 (PE_REPLY_ACCEPTED = 0 at line 149,
/// PE_REPLY_DUPLICATE = 1 at line 150, PE_REPLY_UNKNOWN_WORK = 2 at line 151). ACCEPTED: the claim
/// is taken. DUPLICATE: the work is already settled, a second claim for it is refused.
/// UNKNOWN_WORK: no such work is known.
pub const WR_REPLY_ACCEPTED : u8 = 0;
pub const WR_REPLY_DUPLICATE : u8 = 1;
pub const WR_REPLY_UNKNOWN_WORK : u8 = 2;

/// The reply code of a claim on a work record. Order: DUPLICATE first (already_settled), then
/// UNKNOWN_WORK (not work_known), then ACCEPTED. A second claim for settled work is a duplicate
/// even when the work is no longer known.
pub fn wr_duplicate_reply(already_settled : bool, work_known : bool) -> u8 {
    if (already_settled) { return WR_REPLY_DUPLICATE; }
    if (work_known == false) { return WR_REPLY_UNKNOWN_WORK; }
    return WR_REPLY_ACCEPTED;
}

// --- 7. Tests ---------------------------------------------------------------------------------------

test the_work_kinds_are_the_five_payment_kinds {
    assert WK_TOOLCHAIN == 0;
    assert WK_BUILD == 1;
    assert WK_TEST == 2;
    assert WK_REPORT == 3;
    assert WK_COPY == 4;
    assert WK_COUNT == 5;
}

test only_the_five_work_kinds_are_known {
    assert wr_kind_known(WK_TOOLCHAIN) == true;
    assert wr_kind_known(WK_BUILD) == true;
    assert wr_kind_known(WK_TEST) == true;
    assert wr_kind_known(WK_REPORT) == true;
    assert wr_kind_known(WK_COPY) == true;
    assert wr_kind_known(5) == false;
    assert wr_kind_known(99) == false;
}

test the_t27l_literals_are_copied_verbatim {
    assert SF_PIPELINE == 0;
    assert EA_ASSIGNED == 0;
    assert EA_STARTED == 1;
    assert EA_FINISHED == 2;
    assert EA_FAILED == 3;
}

test the_log_version_and_event_prefix_match_the_t27l_surface {
    assert WR_T27L_VERSION == "t27l/v1";
    assert WR_EVENT_ID_PREFIX == "evt_";
}

test a_known_work_kind_logs_finished_an_unknown_kind_logs_failed {
    assert wr_log_event(WK_TOOLCHAIN) == 2;
    assert wr_log_event(WK_BUILD) == 2;
    assert wr_log_event(WK_TEST) == 2;
    assert wr_log_event(WK_REPORT) == 2;
    assert wr_log_event(WK_COPY) == 2;
    assert wr_log_event(5) == 3;
    assert wr_log_event(99) == 3;
}

test only_the_three_mesh_tags_are_known {
    assert wr_known_tag(WR_TAG_RECORD) == true;
    assert wr_known_tag(WR_TAG_COPY) == true;
    assert wr_known_tag(WR_TAG_ADOPT) == true;
    assert wr_known_tag(0) == false;
    assert wr_known_tag(3) == false;
    assert wr_known_tag(27) == false;
    assert wr_known_tag(31) == false;
    assert wr_known_tag(99) == false;
}

test the_mesh_tags_continue_the_payout_evidence_tags {
    assert WR_TAG_RECORD == 28;
    assert WR_TAG_COPY == 29;
    assert WR_TAG_ADOPT == 30;
    assert wr_known_tag(25) == false;
    assert wr_known_tag(26) == false;
}

test a_record_and_a_copy_ride_data_an_adopt_rides_control {
    assert wr_lane_of(WR_TAG_RECORD) == 0;
    assert wr_lane_of(WR_TAG_COPY) == 0;
    assert wr_lane_of(WR_TAG_ADOPT) == 1;
    assert wr_lane_of(0) == 0;
    assert wr_lane_of(31) == 0;
    assert wr_lane_of(99) == 0;
}

test a_full_set_of_facts_has_no_refusal {
    assert wr_refusal(WK_BUILD, true, true, true) == WR_OK;
}

test each_missing_fact_alone_names_its_code {
    assert wr_refusal(5, true, true, true) == WR_REFUSE_UNKNOWN_KIND;
    assert wr_refusal(99, true, true, true) == WR_REFUSE_UNKNOWN_KIND;
    assert wr_refusal(WK_BUILD, false, true, true) == WR_REFUSE_UNKNOWN_AGENT;
    assert wr_refusal(WK_BUILD, true, false, true) == WR_REFUSE_NO_ARTIFACT;
    assert wr_refusal(WK_BUILD, true, true, false) == WR_REFUSE_NO_EVIDENCE;
}

test two_missing_facts_name_the_earlier_one_in_the_fixed_order {
    assert wr_refusal(5, false, true, true) == WR_REFUSE_UNKNOWN_KIND;
    assert wr_refusal(5, true, false, true) == WR_REFUSE_UNKNOWN_KIND;
    assert wr_refusal(5, true, true, false) == WR_REFUSE_UNKNOWN_KIND;
    assert wr_refusal(WK_BUILD, false, false, true) == WR_REFUSE_UNKNOWN_AGENT;
    assert wr_refusal(WK_BUILD, false, true, false) == WR_REFUSE_UNKNOWN_AGENT;
    assert wr_refusal(WK_BUILD, true, false, false) == WR_REFUSE_NO_ARTIFACT;
    assert wr_refusal(5, false, false, false) == WR_REFUSE_UNKNOWN_KIND;
}

test work_without_a_log_event_is_invisible_to_the_mesh {
    assert wr_mesh_may_claim(false, WR_OK, false) == false;
}

test a_refused_record_is_not_claimable_whatever_else_holds {
    assert wr_mesh_may_claim(true, WR_REFUSE_UNKNOWN_KIND, false) == false;
    assert wr_mesh_may_claim(true, WR_REFUSE_UNKNOWN_AGENT, false) == false;
    assert wr_mesh_may_claim(true, WR_REFUSE_NO_ARTIFACT, false) == false;
    assert wr_mesh_may_claim(true, WR_REFUSE_NO_EVIDENCE, false) == false;
    assert wr_mesh_may_claim(true, 99, false) == false;
}

test an_already_claimed_record_is_not_claimable_again {
    assert wr_mesh_may_claim(true, WR_OK, true) == false;
}

test a_logged_valid_unclaimed_record_is_claimable {
    assert wr_mesh_may_claim(true, WR_OK, false) == true;
}

test the_record_table_feeds_the_claim_table {
    assert wr_mesh_may_claim(true, wr_refusal(WK_TEST, true, true, true), false) == true;
    assert wr_mesh_may_claim(true, wr_refusal(WK_TEST, true, true, false), false) == false;
    assert wr_mesh_may_claim(wr_kind_known(WK_REPORT), wr_refusal(WK_REPORT, true, true, true), false) == true;
    assert wr_mesh_may_claim(wr_kind_known(99), wr_refusal(99, true, true, true), false) == false;
}

test the_reply_literals_match_the_payout_reply_literals {
    assert WR_REPLY_ACCEPTED == 0;
    assert WR_REPLY_DUPLICATE == 1;
    assert WR_REPLY_UNKNOWN_WORK == 2;
}

test a_second_claim_for_settled_work_is_a_duplicate_before_it_is_unknown {
    assert wr_duplicate_reply(true, true) == WR_REPLY_DUPLICATE;
    assert wr_duplicate_reply(true, false) == WR_REPLY_DUPLICATE;
}

test an_unsettled_copy_is_accepted_or_names_unknown_work {
    assert wr_duplicate_reply(false, true) == WR_REPLY_ACCEPTED;
    assert wr_duplicate_reply(false, false) == WR_REPLY_UNKNOWN_WORK;
}

test a_copy_of_a_logged_result_walks_claim_then_reply {
    assert wr_duplicate_reply(false, wr_mesh_may_claim(true, wr_refusal(WK_COPY, true, true, true), false)) == WR_REPLY_ACCEPTED;
    assert wr_duplicate_reply(false, wr_mesh_may_claim(false, wr_refusal(WK_COPY, true, true, true), false)) == WR_REPLY_UNKNOWN_WORK;
    assert wr_duplicate_reply(true, wr_mesh_may_claim(true, wr_refusal(WK_COPY, true, true, true), false)) == WR_REPLY_DUPLICATE;
}

// --- 8. Invariants ----------------------------------------------------------------------------------

invariant wr_work_kinds_are_distinct_and_under_the_count { assert WK_TOOLCHAIN < WK_COUNT and WK_BUILD < WK_COUNT and WK_TEST < WK_COUNT and WK_REPORT < WK_COUNT and WK_COPY < WK_COUNT and WK_TOOLCHAIN != WK_BUILD and WK_TOOLCHAIN != WK_TEST and WK_TOOLCHAIN != WK_REPORT and WK_TOOLCHAIN != WK_COPY and WK_BUILD != WK_TEST and WK_BUILD != WK_REPORT and WK_BUILD != WK_COPY and WK_TEST != WK_REPORT and WK_TEST != WK_COPY and WK_REPORT != WK_COPY; }
invariant wr_tags_are_distinct_in_28_to_30 { assert WR_TAG_RECORD == 28 and WR_TAG_COPY == 29 and WR_TAG_ADOPT == 30 and WR_TAG_RECORD != WR_TAG_COPY and WR_TAG_COPY != WR_TAG_ADOPT and WR_TAG_RECORD != WR_TAG_ADOPT; }
invariant wr_ok_is_zero_and_refusals_count_from_one { assert WR_OK == 0 and WR_REFUSE_UNKNOWN_KIND == 1 and WR_REFUSE_UNKNOWN_AGENT == 2 and WR_REFUSE_NO_ARTIFACT == 3 and WR_REFUSE_NO_EVIDENCE == 4; }
