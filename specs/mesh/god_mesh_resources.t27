// SPDX-License-Identifier: Apache-2.0
// specs/mesh/god_mesh_resources.t27 -- the RESOURCE MANAGER of GOD MESH (ORDER:
// HEALTHY_MESH_PROOF_OF_COMPUTE, scopes 3+4). It picks which node takes the next unit of work
// (section 1), decides when the fleet needs rebalancing (section 2), judges a USER'S config in the
// shape T27OS shows it (section 3), and gates dispatch on the health and proof layers (section 4).
// DESIGN ONLY: a decision table with tests, in the style of specs/queen/payout_evidence_msg.t27.
//
// NO SILENT CONFIG (section 3): a resource change applies only when its approval is recorded AND
// the config is logged; a user config is valid only when it names a real server, wants at least
// one resource, and carries NO secret (a key or token pasted into a config field is refused, never
// stored -- secrets live in the key master, not in a config form).
//
// HEALTH FIRST (section 4): dispatch is allowed only onto a HEALTHY target -- the literal 2 of
// specs/mesh/god_mesh_health.t27, MH_HEALTHY, copied as a LITERAL comment reference -- and only
// when the proof gate is open, so unproven compute never gets distributed. An empty queue
// dispatches nothing: no fake work.
//
// Cross-spec numbers are copied as LITERALS with literal tests and a comment naming the source:
// MH_HEALTHY = 2 from specs/mesh/god_mesh_health.t27 (section 1). A `use` of another spec would
// splice that whole spec into this one.
// Not here: the queue itself, the executor and every amount; this is a decision table with tests.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module MeshResources;

// --- 1. Target pick ---------------------------------------------------------------------------------

/// The three pick results. RM_TARGET_A / RM_TARGET_B: the named node takes the work. RM_TARGET_NONE:
/// no node may take it -- both unhealthy, or the fleet has no eligible node. NONE is a real answer,
/// not an error: the work stays queued until a target exists.
pub const RM_TARGET_NONE : u8 = 0;
pub const RM_TARGET_A : u8 = 1;
pub const RM_TARGET_B : u8 = 2;

/// Which of two nodes takes the next unit of work. A node that is not healthy is not a candidate,
/// whatever its load: the manager never queues onto the sick. Both unhealthy is RM_TARGET_NONE.
/// Both healthy: the LOWER load wins; an exact tie goes to A, so the pick is deterministic and two
/// managers with the same facts pick the same node. Only one healthy: that one, whatever its load.
pub fn rm_pick(load_a : u32, load_b : u32, healthy_a : bool, healthy_b : bool) -> u8 {
    if (healthy_a and healthy_b) {
        if (load_a <= load_b) { return RM_TARGET_A; }
        return RM_TARGET_B;
    }
    if (healthy_a) { return RM_TARGET_A; }
    if (healthy_b) { return RM_TARGET_B; }
    return RM_TARGET_NONE;
}

// --- 2. Rebalance -----------------------------------------------------------------------------------

/// Whether the fleet needs rebalancing: MORE THAN the threshold of nodes are busy AND at least one
/// node is idle. The idle condition is the honest one -- with no idle node there is nothing to
/// rebalance onto, and calling for a rebalance then would only churn. An equality at the threshold
/// (busy == threshold) is NOT over it: rebalancing is for real imbalance, not for noise.
pub fn rm_needs_rebalance(busy_nodes : u32, idle_nodes : u32, threshold : u32) -> bool {
    if (busy_nodes <= threshold) { return false; }
    if (idle_nodes == 0) { return false; }
    return true;
}

// --- 3. User config, T27OS shape --------------------------------------------------------------------

/// Whether a user's resource config is valid as it arrives from the T27OS form. A valid config
/// wants at least one resource (gpu or cpu: an empty config is refused, not silently accepted),
/// names a server for it to run on (names_a_server), and carries NO secret (carries_a_secret
/// refuses the whole config: a key or token pasted into a config field must never be stored --
/// secrets live in the key master; the form asks the user to remove it, it does not save around
/// the user).
pub fn rm_user_config_ok(wants_gpu : bool, wants_cpu : bool, names_a_server : bool, carries_a_secret : bool) -> bool {
    if (carries_a_secret) { return false; }
    if (!names_a_server) { return false; }
    if (!wants_gpu and !wants_cpu) { return false; }
    return true;
}

/// Whether a config CHANGE may apply. BOTH facts are required: the approval recorded (a change
/// without a recorded approval is a silent change) and the config logged (a change that leaves no
/// trace is a silent change). Missing either, the change does not apply: NO SILENT CONFIG.
pub fn rm_change_applies(approval_recorded : bool, config_logged : bool) -> bool {
    if (!approval_recorded) { return false; }
    if (!config_logged) { return false; }
    return true;
}

// --- 4. Dispatch gate -------------------------------------------------------------------------------

/// The health literal of specs/mesh/god_mesh_health.t27 (MH_HEALTHY = 2, section 1), copied as a
/// LITERAL because a `use` would splice that whole spec into this one. The literal test pins it.
pub const MH_HEALTHY : u8 = 2;

/// Whether the manager may dispatch the next queued unit of work to a target. Three gates, all
/// required: the queue is non-empty (an empty queue dispatches nothing: no fake work), the target
/// is HEALTHY (the literal 2; a degraded or down target never receives dispatch), and the proof
/// gate is open (the compute of this work will be verified by the proof-of-compute layer, so
/// unproven compute is not distributed). Fail closed on every gate.
pub fn rm_dispatch_allowed(queue_nonempty : bool, target_health : u8, proof_gate_open : bool) -> bool {
    if (!queue_nonempty) { return false; }
    if (target_health != MH_HEALTHY) { return false; }
    if (!proof_gate_open) { return false; }
    return true;
}

// --- 5. Literal pin tests ---------------------------------------------------------------------------

test the_pick_results_are_three_distinct_codes {
    assert RM_TARGET_NONE == 0;
    assert RM_TARGET_A == 1;
    assert RM_TARGET_B == 2;
    assert RM_TARGET_NONE != RM_TARGET_A and RM_TARGET_A != RM_TARGET_B and RM_TARGET_NONE != RM_TARGET_B;
}

test an_unhealthy_node_is_never_a_candidate {
    assert rm_pick(1, 2, true, true) == RM_TARGET_A;
    assert rm_pick(3, 2, true, true) == RM_TARGET_B;
    assert rm_pick(5, 5, true, true) == RM_TARGET_A;
    assert rm_pick(5, 1, true, false) == RM_TARGET_A;
    assert rm_pick(1, 1, false, true) == RM_TARGET_B;
    assert rm_pick(1, 1, false, false) == RM_TARGET_NONE;
}

test a_tie_goes_to_a_so_the_pick_is_deterministic {
    assert rm_pick(4, 4, true, true) == RM_TARGET_A;
    assert rm_pick(9, 9, true, true) == RM_TARGET_A;
}

test rebalance_needs_over_threshold_busy_and_at_least_one_idle {
    assert rm_needs_rebalance(6, 1, 5);
    assert rm_needs_rebalance(9, 2, 5);
    assert !rm_needs_rebalance(5, 1, 5);
    assert !rm_needs_rebalance(4, 3, 5);
    assert !rm_needs_rebalance(6, 0, 5);
    assert !rm_needs_rebalance(9, 0, 5);
    assert !rm_needs_rebalance(0, 0, 0);
}

test a_config_without_a_resource_without_a_server_or_with_a_secret_is_refused {
    assert rm_user_config_ok(true, false, true, false);
    assert rm_user_config_ok(false, true, true, false);
    assert rm_user_config_ok(true, true, true, false);
    assert !rm_user_config_ok(false, false, true, false);
    assert !rm_user_config_ok(true, false, false, false);
    assert !rm_user_config_ok(true, false, true, true);
    assert !rm_user_config_ok(false, false, false, true);
}

test a_change_applies_only_with_approval_and_log {
    assert rm_change_applies(true, true);
    assert !rm_change_applies(false, true);
    assert !rm_change_applies(true, false);
    assert !rm_change_applies(false, false);
}

test the_copied_health_literal_matches_the_health_layer {
    assert MH_HEALTHY == 2;
}

test dispatch_needs_a_queue_a_healthy_target_and_an_open_proof_gate {
    assert rm_dispatch_allowed(true, MH_HEALTHY, true);
    assert !rm_dispatch_allowed(false, MH_HEALTHY, true);
    assert !rm_dispatch_allowed(true, 1, true);
    assert !rm_dispatch_allowed(true, 0, true);
    assert !rm_dispatch_allowed(true, 99, true);
    assert !rm_dispatch_allowed(true, MH_HEALTHY, false);
    assert !rm_dispatch_allowed(false, 0, false);
}

test dispatch_never_lands_on_a_degraded_target {
    assert !rm_dispatch_allowed(true, 1, true);
    assert rm_dispatch_allowed(true, 2, true);
    assert rm_dispatch_allowed(true, 1, true) != rm_dispatch_allowed(true, 2, true);
}

// --- 6. Invariants ----------------------------------------------------------------------------------

invariant rm_pick_never_lands_on_an_unhealthy_node { assert rm_pick(1, 1, false, false) == RM_TARGET_NONE and rm_pick(1, 1, false, true) == RM_TARGET_B and rm_pick(1, 1, true, false) == RM_TARGET_A and rm_pick(4, 4, true, true) == RM_TARGET_A; }
invariant rm_rebalance_without_idle_is_refused_and_threshold_is_strict { assert rm_needs_rebalance(6, 0, 5) == false and rm_needs_rebalance(5, 5, 5) == false and rm_needs_rebalance(6, 1, 5) == true; }
invariant rm_no_silent_config_and_no_secret_in_a_config { assert rm_change_applies(true, true) and !rm_change_applies(false, true) and !rm_change_applies(true, false) and !rm_user_config_ok(true, true, true, true) and !rm_user_config_ok(false, false, true, false); }
invariant rm_dispatch_gates_all_hold_and_the_health_literal_is_two { assert MH_HEALTHY == 2 and rm_dispatch_allowed(true, 2, true) and !rm_dispatch_allowed(false, 2, true) and !rm_dispatch_allowed(true, 1, true) and !rm_dispatch_allowed(true, 2, false); }
