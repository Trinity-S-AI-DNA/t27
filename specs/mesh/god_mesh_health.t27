// SPDX-License-Identifier: Apache-2.0
// specs/mesh/god_mesh_health.t27 -- the HEALTH-FIRST layer of GOD MESH (ORDER:
// HEALTHY_MESH_PROOF_OF_COMPUTE, scopes 1+3, and the owner's word: the network's goal is to ALWAYS
// be healthy). It grades the health of one node from three facts (section 1), grades the network
// from the node count (section 2), and turns a grade into a self-heal action (section 3): reroute
// what a dead node carried, drain what a limping node carries. DESIGN ONLY: a decision table with
// tests, in the style of specs/queen/payout_evidence_msg.t27.
//
// HEALTH IS A GRADE, NOT A PROMISE (the owner's boundary): "the network is healthy" here means
// every node answers and nothing is degraded -- it does NOT mean failures never happen. Failures
// are expected; the layer's job is to SEE them (a stale heartbeat is DOWN immediately), to ACT on
// them (section 3), and to never route work onto a node that cannot carry it (section 4).
//
// THE LADDER IS LOOPBACK ONLY (section 4): the mesh accepts a peer on 127.0.0.1 and never on a
// public address, per the T27 Ladder law (section 8 of the GODMODE policy set, specs/godmode). The
// acceptance check fails closed: an address that is somehow both loopback and public-looking is refused.
//
// Empty network honesty (section 2): a network of zero nodes is DOWN, not healthy. There is no
// default-success anywhere in this file.
// Not here: the heartbeat protocol itself, the reroute execution and every amount; this is a
// decision table with tests. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module MeshHealth;

// --- 1. Node health ---------------------------------------------------------------------------------

/// The three node grades. MH_HEALTHY: the node answers, has error budget left and has capacity.
/// MH_DEGRADED: the node answers but is missing budget or capacity; it still speaks, so the mesh
/// can tell it to stop taking work. MH_DOWN: the node does not answer at all. The order matters for
/// mh_node_action: DOWN reroutes traffic away, DEGRADED drains new work off, HEALTHY stays.
pub const MH_DOWN : u8 = 0;
pub const MH_DEGRADED : u8 = 1;
pub const MH_HEALTHY : u8 = 2;

/// The grade of one node. THE HEARTBEAT IS LIVENESS: a stale heartbeat is DOWN, whatever the budget
/// and the capacity say -- a node that does not answer is down, not merely limping. A live node
/// with budget AND capacity is HEALTHY; a live node missing either is DEGRADED (fail visible, not
/// fail open: a missing fact lowers the grade, never raises it).
pub fn mh_node_health(heartbeat_fresh : bool, error_budget_left : bool, capacity_ok : bool) -> u8 {
    if (!heartbeat_fresh) { return MH_DOWN; }
    if (error_budget_left and capacity_ok) { return MH_HEALTHY; }
    return MH_DEGRADED;
}

// --- 2. Network health ------------------------------------------------------------------------------

/// The three network grades, the same scale as the node grades. NET_HEALTHY: every node is
/// healthy. NET_DEGRADED: some but not all. NET_DOWN: nobody, or nobody at all -- AN EMPTY NETWORK
/// IS DOWN, NOT HEALTHY.
pub const NET_DOWN : u8 = 0;
pub const NET_DEGRADED : u8 = 1;
pub const NET_HEALTHY : u8 = 2;

/// The grade of the network from its node count. nodes_total == 0 is NET_DOWN (an empty roster
/// must never read as a healthy network: no default success). nodes_healthy == 0 is NET_DOWN (the
/// nodes may answer and still carry nothing). All healthy is NET_HEALTHY; anything between is
/// NET_DEGRADED. The inputs are counts the roster already holds; this file restates no rule for
/// counting them.
pub fn mh_network_status(nodes_total : u32, nodes_healthy : u32) -> u8 {
    if (nodes_total == 0) { return NET_DOWN; }
    if (nodes_healthy == 0) { return NET_DOWN; }
    if (nodes_healthy == nodes_total) { return NET_HEALTHY; }
    return NET_DEGRADED;
}

// --- 3. Self-heal actions ---------------------------------------------------------------------------

/// The three actions a node grade turns into. MH_ACT_NONE: the node stays in rotation.
/// MH_ACT_REROUTE: the traffic the node carried goes to healthy nodes. MH_ACT_DRAIN: the node
/// keeps what it runs but takes no new work. The self-heal loop is: grade, act, re-grade.
pub const MH_ACT_NONE : u8 = 0;
pub const MH_ACT_REROUTE : u8 = 1;
pub const MH_ACT_DRAIN : u8 = 2;

/// The action for a node grade. HEALTHY does nothing (no churn on healthy nodes: healing is for
/// the sick, not a hobby for the well). DEGRADED drains: it still answers, so its running work is
/// left alone while new work goes elsewhere. DOWN reroutes: nothing there can finish anything, so
/// its work moves now, not after a retry policy has buried it.
pub fn mh_node_action(health : u8) -> u8 {
    if (health == MH_HEALTHY) { return MH_ACT_NONE; }
    if (health == MH_DEGRADED) { return MH_ACT_DRAIN; }
    return MH_ACT_REROUTE;
}

// --- 4. Reroute target and loopback peers -----------------------------------------------------------

/// Whether a node may RECEIVE rerouted work: only a HEALTHY target (the literal 2). A degraded
/// target would receive work the mesh just drained off another node, and a down one could not
/// answer at all: rerouting onto the sick merely moves the outage.
pub fn mh_reroute_ok(target_health : u8) -> bool {
    if (target_health == MH_HEALTHY) { return true; }
    return false;
}

/// Whether the mesh accepts a peer at the given address kind. THE LADDER IS LOOPBACK ONLY: a peer
/// is accepted when the address is loopback AND not public. A public address is always refused,
/// and an address that is somehow both is refused too: the check fails closed, it never guesses.
pub fn mh_peer_accepted(addr_is_loopback : bool, addr_is_public : bool) -> bool {
    if (addr_is_public) { return false; }
    if (!addr_is_loopback) { return false; }
    return true;
}

// --- 5. Literal pin tests ---------------------------------------------------------------------------

test the_node_grades_are_three_ordered_codes {
    assert MH_DOWN == 0;
    assert MH_DEGRADED == 1;
    assert MH_HEALTHY == 2;
    assert MH_DOWN != MH_DEGRADED and MH_DEGRADED != MH_HEALTHY and MH_DOWN != MH_HEALTHY;
    assert NET_DOWN == 0;
    assert NET_DEGRADED == 1;
    assert NET_HEALTHY == 2;
}

test a_stale_heartbeat_is_down_whatever_else_holds {
    assert mh_node_health(false, true, true) == MH_DOWN;
    assert mh_node_health(false, false, false) == MH_DOWN;
    assert mh_node_health(false, true, false) == MH_DOWN;
    assert mh_node_health(false, false, true) == MH_DOWN;
}

test a_live_node_needs_budget_and_capacity_to_be_healthy {
    assert mh_node_health(true, true, true) == MH_HEALTHY;
    assert mh_node_health(true, true, false) == MH_DEGRADED;
    assert mh_node_health(true, false, true) == MH_DEGRADED;
    assert mh_node_health(true, false, false) == MH_DEGRADED;
}

test an_empty_or_all_dead_network_is_down_not_healthy {
    assert mh_network_status(0, 0) == NET_DOWN;
    assert mh_network_status(5, 0) == NET_DOWN;
    assert mh_network_status(5, 5) == NET_HEALTHY;
    assert mh_network_status(5, 3) == NET_DEGRADED;
    assert mh_network_status(5, 4) == NET_DEGRADED;
}

test a_partly_healthy_network_is_never_reported_healthy {
    assert mh_network_status(27, 26) == NET_DEGRADED;
    assert mh_network_status(27, 1) == NET_DEGRADED;
    assert mh_network_status(1, 1) == NET_HEALTHY;
    assert mh_network_status(1, 0) == NET_DOWN;
}

test the_heal_actions_are_three_distinct_codes {
    assert MH_ACT_NONE == 0;
    assert MH_ACT_REROUTE == 1;
    assert MH_ACT_DRAIN == 2;
    assert MH_ACT_NONE != MH_ACT_REROUTE and MH_ACT_REROUTE != MH_ACT_DRAIN and MH_ACT_NONE != MH_ACT_DRAIN;
}

test healthy_does_nothing_degraded_drains_down_reroutes {
    assert mh_node_action(MH_HEALTHY) == MH_ACT_NONE;
    assert mh_node_action(MH_DEGRADED) == MH_ACT_DRAIN;
    assert mh_node_action(MH_DOWN) == MH_ACT_REROUTE;
    assert mh_node_action(99) == MH_ACT_REROUTE;
}

test only_a_healthy_target_receives_rerouted_work {
    assert mh_reroute_ok(MH_HEALTHY);
    assert !mh_reroute_ok(MH_DEGRADED);
    assert !mh_reroute_ok(MH_DOWN);
    assert !mh_reroute_ok(99);
}

test the_ladder_accepts_loopback_only_and_fails_closed {
    assert mh_peer_accepted(true, false);
    assert !mh_peer_accepted(false, false);
    assert !mh_peer_accepted(false, true);
    assert !mh_peer_accepted(true, true);
}

test the_self_heal_loop_walks_grade_then_action {
    assert mh_node_action(mh_node_health(true, true, true)) == MH_ACT_NONE;
    assert mh_node_action(mh_node_health(true, true, false)) == MH_ACT_DRAIN;
    assert mh_node_action(mh_node_health(false, true, true)) == MH_ACT_REROUTE;
    assert !mh_reroute_ok(mh_node_health(false, true, true));
    assert mh_reroute_ok(mh_node_health(true, true, true));
}

// --- 6. Invariants ----------------------------------------------------------------------------------

invariant mh_grades_are_distinct_and_ordered { assert MH_DOWN < MH_DEGRADED and MH_DEGRADED < MH_HEALTHY and NET_DOWN < NET_DEGRADED and NET_DEGRADED < NET_HEALTHY and MH_DOWN != MH_DEGRADED and MH_DEGRADED != MH_HEALTHY and NET_DOWN != NET_DEGRADED and NET_DEGRADED != NET_HEALTHY; }
invariant mh_missing_facts_lower_a_grade_never_raise_it { assert mh_node_health(false, true, true) == MH_DOWN and mh_node_health(true, false, true) == MH_DEGRADED and mh_node_health(true, true, false) == MH_DEGRADED and mh_node_health(true, true, true) == MH_HEALTHY; }
invariant mh_an_empty_network_is_down_and_never_healthy { assert mh_network_status(0, 0) == NET_DOWN and mh_network_status(7, 0) == NET_DOWN and mh_network_status(7, 7) == NET_HEALTHY; }
invariant mh_reroute_lands_only_on_healthy_and_peers_are_loopback_only { assert mh_reroute_ok(MH_HEALTHY) and !mh_reroute_ok(MH_DEGRADED) and !mh_reroute_ok(MH_DOWN) and mh_peer_accepted(true, false) and !mh_peer_accepted(true, true) and !mh_peer_accepted(false, false); }
