// SPDX-License-Identifier: Apache-2.0
// specs/mesh/god_mesh_useful_work.t27 -- the USEFUL WORK and $TRI CREDIT table of GOD MESH (ORDER:
// GOD_MESH_TRI_TOKEN, scope 3+5, and ORDER: HEALTHY_MESH_PROOF_OF_COMPUTE, scope 5). It classifies
// a logged work record as useful or not (section 1), admits or refuses the copying of another
// agent's result (section 2), and decides whether a $TRI CREDIT may be PREPARED for it (section 4).
// DESIGN ONLY: a decision table with tests, in the style of specs/queen/payout_evidence_msg.t27.
//
// THE OWNER GATE DOMINATES EVERYTHING (section 4): no decision in this file credits value unless
// the token-economics approval is already recorded. Until the owner approves the $TRI economics of
// GOD MESH, every decision lands on DEC_HOLD_OWNER_GATE and uw_value_change returns 0 for every
// outcome: this layer PREPARES credits, it moves NO value. Minting is the founder's alone
// (specs/trinet/mint_authority.t27); no function here mints, promises or prices $TRI, and no input
// or output carries an amount.
//
// NO DOUBLE PAY is a law of this file (section 3): a work credited once is never credited again,
// and a replay of the same claim returns the literal outcome 6 (OUT_ALREADY_SETTLED_NOT_CHARGED of
// specs/verified/payout.t27) without re-evaluating the work.
//
// Cross-spec numbers are copied as LITERALS with literal tests and a comment naming the source:
// WK_COPY = 4 and the UW_USELESS inputs come from specs/mesh/god_mesh_work_record.t27 (section 1),
// OUT_ALREADY_SETTLED_NOT_CHARGED = 6 from specs/verified/payout.t27 (OUT_* block). A `use` of
// another spec would splice that whole spec into this one.
// Not here: the ledger, the mint, the claim handler and every amount; this is a decision table
// with tests. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module MeshUsefulWork;

// --- 1. Usefulness classes --------------------------------------------------------------------------

/// The three usefulness classes of a logged work record. UW_USELESS: no evidence, or a kind the
/// work-record layer refuses, or a kind the payment table does not pay. UW_PRIMARY: useful work the
/// agent did itself. UW_ADOPTED: useful work that REUSES another agent's settled result; adoption
/// is honest only when the original is named (section 2).
pub const UW_USELESS : u8 = 0;
pub const UW_PRIMARY : u8 = 1;
pub const UW_ADOPTED : u8 = 2;
pub const UW_COUNT : u8 = 3;

/// The work kinds of specs/mesh/god_mesh_work_record.t27, copied as LITERALS (WK_TOOLCHAIN = 0
/// through WK_COPY = 4, WK_COUNT = 5, section 1 of that file). The literal tests pin them.
pub const WK_TOOLCHAIN : u8 = 0;
pub const WK_BUILD : u8 = 1;
pub const WK_TEST : u8 = 2;
pub const WK_REPORT : u8 = 3;
pub const WK_COPY : u8 = 4;
pub const WK_COUNT : u8 = 5;

/// The usefulness class of a work record. A record WITHOUT EVIDENCE IS USELESS whatever its kind:
/// classification never outruns the proof. An unknown kind is useless too. An adopted copy of a
/// known kind is UW_ADOPTED; every other known kind is UW_PRIMARY. kind decides nothing by itself.
pub fn uw_classify(kind : u8, evidence_ok : bool, adopted : bool) -> u8 {
    if (!evidence_ok) { return UW_USELESS; }
    if (kind >= WK_COUNT) { return UW_USELESS; }
    if (adopted) { return UW_ADOPTED; }
    return UW_PRIMARY;
}

// --- 2. Copy admission ------------------------------------------------------------------------------

/// The admission codes for copying another agent's result. CR_CREDIT_ADOPTION: the copy is honest
/// and may earn what the owner-approved payment table gives copies. The refusals name the FIRST
/// missing fact in the fixed order of uw_copy_reply: no provenance, original not settled, copy
/// never used. A copy with no provenance is not honest work.
pub const CR_CREDIT_ADOPTION : u8 = 0;
pub const CR_REFUSE_NO_PROVENANCE : u8 = 1;
pub const CR_REFUSE_ORIGINAL_UNSETTLED : u8 = 2;
pub const CR_REFUSE_COPY_UNUSED : u8 = 3;

/// The reply to a COPY record. The order is fixed: provenance first (WHOSE result this is), then
/// the original's settlement state (only a SETTLED original may be reused: an unsettled original is
/// not yet a result), then use (an unused copy did no work). When two facts are missing the earlier
/// one is named. All three facts present, the reply is CR_CREDIT_ADOPTION.
pub fn uw_copy_reply(original_settled : bool, provenance_recorded : bool, copy_used : bool) -> u8 {
    if (!provenance_recorded) { return CR_REFUSE_NO_PROVENANCE; }
    if (!original_settled) { return CR_REFUSE_ORIGINAL_UNSETTLED; }
    if (!copy_used) { return CR_REFUSE_COPY_UNUSED; }
    return CR_CREDIT_ADOPTION;
}

// --- 3. No double pay -------------------------------------------------------------------------------

/// The literal of OUT_ALREADY_SETTLED_NOT_CHARGED = 6 from specs/verified/payout.t27 (the OUT_*
/// block), copied as a LITERAL because a `use` would splice the whole payout spec into this one.
/// The literal test pins it.
pub const UW_OUT_ALREADY_SETTLED : u8 = 6;

/// Whether a work may be credited AGAIN. The law of this section: NEVER. A work credited once is
/// settled; every later claim on it returns UW_OUT_ALREADY_SETTLED and charges nothing, and no
/// decision path of section 4 may run twice over the same record.
pub fn uw_second_credit(already_credited : bool) -> bool {
    if (already_credited) { return false; }
    return true;
}

// --- 4. Credit decisions, owner-gated ---------------------------------------------------------------

/// The decision codes of a $TRI credit claim. DEC_CREDIT: everything holds, the credit is prepared.
/// The holds and refusals name the FIRST failed gate in the fixed order of uw_credit_decision: the
/// owner gate, the proof gate, usefulness, double credit. A hold is not a refusal: it waits.
pub const DEC_CREDIT : u8 = 0;
pub const DEC_HOLD_OWNER_GATE : u8 = 1;
pub const DEC_HOLD_NO_PROOF : u8 = 2;
pub const DEC_NOT_USEFUL : u8 = 3;
pub const DEC_ALREADY_CREDITED : u8 = 4;

/// The decision for a $TRI credit claim on one work record. THE OWNER GATE DOMINATES: while the
/// token-economics approval is not recorded, EVERY claim holds at DEC_HOLD_OWNER_GATE, whatever
/// else is true, and nothing downstream may read the other gates as consent. After the gate opens:
/// no proof holds (DEC_HOLD_NO_PROOF), useless work is refused (DEC_NOT_USEFUL), an already
/// credited work is refused (DEC_ALREADY_CREDITED), and only then the credit is prepared.
pub fn uw_credit_decision(economics_owner_approved : bool, proof_ok : bool, usefulness : u8, already_credited : bool) -> u8 {
    if (!economics_owner_approved) { return DEC_HOLD_OWNER_GATE; }
    if (!proof_ok) { return DEC_HOLD_NO_PROOF; }
    if (usefulness == UW_USELESS) { return DEC_NOT_USEFUL; }
    if (already_credited) { return DEC_ALREADY_CREDITED; }
    return DEC_CREDIT;
}

/// The value this layer moves, for EVERY decision: 0. No decision of this file pays, prices or
/// promises anything; a credit decision only names what may be prepared once the owner approves the
/// economics and the payment layer (specs/verified/payout.t27, specs/network/mvp.t27) runs. The
/// tests pin 0 for all five decisions: the zero is a gate, not an accident.
pub fn uw_value_change(decision : u8) -> u64 {
    if (decision == DEC_CREDIT) { return 0; }
    if (decision == DEC_HOLD_OWNER_GATE) { return 0; }
    if (decision == DEC_HOLD_NO_PROOF) { return 0; }
    if (decision == DEC_NOT_USEFUL) { return 0; }
    if (decision == DEC_ALREADY_CREDITED) { return 0; }
    return 0;
}

// --- 5. Period budget -------------------------------------------------------------------------------

/// Whether an ask fits the credit budget of one period, subtractively and without overflow: the
/// spent part is removed first, then the ask must fit the rest. A spent part larger than the budget
/// (a broken ledger) refuses everything: fail closed, never lend. An ask of 0 fits any sane period,
/// and fits nothing once the ledger is broken.
pub fn uw_period_fits(period_budget : u64, credited_so_far : u64, ask : u64) -> bool {
    if (credited_so_far > period_budget) { return false; }
    return ask <= period_budget - credited_so_far;
}

// --- 6. Literal pin tests ---------------------------------------------------------------------------

test the_usefulness_classes_are_three_distinct_codes {
    assert UW_USELESS == 0;
    assert UW_PRIMARY == 1;
    assert UW_ADOPTED == 2;
    assert UW_COUNT == 3;
    assert UW_USELESS != UW_PRIMARY and UW_PRIMARY != UW_ADOPTED and UW_USELESS != UW_ADOPTED;
}

test the_copied_work_kinds_match_the_work_record_layer {
    assert WK_TOOLCHAIN == 0;
    assert WK_BUILD == 1;
    assert WK_TEST == 2;
    assert WK_REPORT == 3;
    assert WK_COPY == 4;
    assert WK_COUNT == 5;
}

test no_evidence_makes_any_kind_useless {
    assert uw_classify(WK_BUILD, true, false) == UW_PRIMARY;
    assert uw_classify(WK_BUILD, false, false) == UW_USELESS;
    assert uw_classify(WK_COPY, true, true) == UW_ADOPTED;
    assert uw_classify(WK_COPY, false, true) == UW_USELESS;
    assert uw_classify(WK_TOOLCHAIN, true, false) == UW_PRIMARY;
    assert uw_classify(WK_TEST, true, false) == UW_PRIMARY;
    assert uw_classify(WK_REPORT, true, false) == UW_PRIMARY;
}

test an_unknown_kind_is_useless_even_with_evidence {
    assert uw_classify(WK_COUNT, true, false) == UW_USELESS;
    assert uw_classify(99, true, false) == UW_USELESS;
    assert uw_classify(99, true, true) == UW_USELESS;
}

test adoption_decides_between_primary_and_adopted {
    assert uw_classify(WK_BUILD, true, true) == UW_ADOPTED;
    assert uw_classify(WK_COPY, true, false) == UW_PRIMARY;
    assert uw_classify(WK_TEST, true, true) == UW_ADOPTED;
}

test copy_admission_names_the_first_missing_fact {
    assert uw_copy_reply(true, true, true) == CR_CREDIT_ADOPTION;
    assert uw_copy_reply(true, false, true) == CR_REFUSE_NO_PROVENANCE;
    assert uw_copy_reply(false, true, true) == CR_REFUSE_ORIGINAL_UNSETTLED;
    assert uw_copy_reply(true, true, false) == CR_REFUSE_COPY_UNUSED;
}

test when_two_copy_facts_are_missing_the_earlier_one_is_named {
    assert uw_copy_reply(false, false, true) == CR_REFUSE_NO_PROVENANCE;
    assert uw_copy_reply(false, true, false) == CR_REFUSE_ORIGINAL_UNSETTLED;
    assert uw_copy_reply(true, false, false) == CR_REFUSE_NO_PROVENANCE;
    assert uw_copy_reply(false, false, false) == CR_REFUSE_NO_PROVENANCE;
}

test the_already_settled_literal_matches_the_payout_layer {
    assert UW_OUT_ALREADY_SETTLED == 6;
}

test a_credited_work_is_never_credited_again {
    assert !uw_second_credit(true);
    assert uw_second_credit(false);
}

test the_owner_gate_dominates_every_claim {
    assert uw_credit_decision(false, true, UW_PRIMARY, false) == DEC_HOLD_OWNER_GATE;
    assert uw_credit_decision(false, false, UW_USELESS, true) == DEC_HOLD_OWNER_GATE;
    assert uw_credit_decision(false, true, UW_ADOPTED, true) == DEC_HOLD_OWNER_GATE;
}

test after_the_gate_the_other_gates_hold_in_order {
    assert uw_credit_decision(true, false, UW_PRIMARY, false) == DEC_HOLD_NO_PROOF;
    assert uw_credit_decision(true, false, UW_USELESS, true) == DEC_HOLD_NO_PROOF;
    assert uw_credit_decision(true, true, UW_USELESS, false) == DEC_NOT_USEFUL;
    assert uw_credit_decision(true, true, UW_PRIMARY, true) == DEC_ALREADY_CREDITED;
    assert uw_credit_decision(true, true, UW_ADOPTED, false) == DEC_CREDIT;
}

test no_decision_moves_value {
    assert uw_value_change(DEC_CREDIT) == 0;
    assert uw_value_change(DEC_HOLD_OWNER_GATE) == 0;
    assert uw_value_change(DEC_HOLD_NO_PROOF) == 0;
    assert uw_value_change(DEC_NOT_USEFUL) == 0;
    assert uw_value_change(DEC_ALREADY_CREDITED) == 0;
    assert uw_value_change(99) == 0;
}

test the_period_budget_is_subtractive_and_fails_closed {
    assert uw_period_fits(100, 40, 60);
    assert !uw_period_fits(100, 40, 61);
    assert uw_period_fits(100, 100, 0);
    assert !uw_period_fits(100, 100, 1);
    assert !uw_period_fits(50, 60, 0);
    assert !uw_period_fits(50, 60, 1);
}

// --- 7. Invariants ----------------------------------------------------------------------------------

invariant uw_classes_are_distinct_and_under_the_count { assert UW_USELESS < UW_COUNT and UW_PRIMARY < UW_COUNT and UW_ADOPTED < UW_COUNT and UW_USELESS != UW_PRIMARY and UW_PRIMARY != UW_ADOPTED and UW_USELESS != UW_ADOPTED; }
invariant uw_refusals_count_from_one_and_the_credit_is_zero { assert CR_CREDIT_ADOPTION == 0 and CR_REFUSE_NO_PROVENANCE == 1 and CR_REFUSE_ORIGINAL_UNSETTLED == 2 and CR_REFUSE_COPY_UNUSED == 3 and DEC_CREDIT == 0 and DEC_HOLD_OWNER_GATE == 1 and DEC_HOLD_NO_PROOF == 2 and DEC_NOT_USEFUL == 3 and DEC_ALREADY_CREDITED == 4; }
invariant uw_owner_gate_beats_every_other_gate { assert uw_credit_decision(false, true, UW_PRIMARY, false) == DEC_HOLD_OWNER_GATE and uw_credit_decision(false, false, UW_USELESS, true) == DEC_HOLD_OWNER_GATE and uw_value_change(DEC_HOLD_OWNER_GATE) == 0 and uw_value_change(DEC_CREDIT) == 0; }
invariant uw_never_credits_twice_and_the_settled_literal_is_six { assert !uw_second_credit(true) and uw_second_credit(false) and UW_OUT_ALREADY_SETTLED == 6; }
invariant uw_copy_without_provenance_is_never_credited { assert uw_copy_reply(false, false, true) == CR_REFUSE_NO_PROVENANCE and uw_copy_reply(false, false, false) == CR_REFUSE_NO_PROVENANCE and uw_copy_reply(true, false, true) == CR_REFUSE_NO_PROVENANCE; }
