// SPDX-License-Identifier: Apache-2.0
; specs/course/tma_home_main.t27 -- host program: t27ai_bot Mini App home flat-color render
; (companion to specs/course/tma_home.t27, Closes #13655, Refs #13251).
; Writes one P6 375x812 frame under target/course/tma/tma_home.ppm (15 header bytes, then 913500 RGB bytes).
; The frame is a flat fill with the TMA_K_HERO color. NOTHING HERE SAYS A FRAME LOOKS RIGHT.
; Build and run on the build server: t27c gen, then zig build-exe with -lc, then mkdir -p target/course/tma.
; An unopenable path or a short write exits 2. Module-level vars are never spliced by use, so the buffer lives here.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CourseTmaHomeMain;

use course::tma_home::TMA_W;
use course::tma_home::TMA_H;
use course::tma_home::TMA_K_HERO;
use course::tma_home::TMA_K_POPULAR;
use course::tma_home::tma_r;
use course::tma_home::tma_g;
use course::tma_home::tma_b;

pub var TMA_PPM : [913515]u8 = [0] ** 913515;

pub const TMA_BYTES : usize = 913515;
pub const TMA_MOD : u64 = 1000000007;

/// Paint a flat fill (r, g, b) into TMA_PPM as a P6 file: 15 header bytes, then one RGB triple per pixel. Returns bytes written.
pub fn tma_paint(r: u8, g: u8, b: u8) -> usize {
    let head : []const u8 = "P6\n375 812\n255\n";
    var i : usize = 0;
    while i < head.len {
        TMA_PPM[i] = head[i];
        i = i + 1;
    }
    var o : usize = head.len;
    var py : u32 = 0;
    while py < TMA_H {
        var px : u32 = 0;
        while px < TMA_W {
            TMA_PPM[o]     = r;
            TMA_PPM[o + 1] = g;
            TMA_PPM[o + 2] = b;
            o = o + 3;
            px = px + 1;
        }
        py = py + 1;
    }
    return o;
}

/// Fingerprint of TMA_PPM: h = (h * 31 + byte) mod TMA_MOD, header included.
pub fn tma_digest() -> u64 {
    var h : u64 = 0;
    var i : usize = 0;
    while i < TMA_BYTES {
        h = (h * 31 + (TMA_PPM[i] as u64)) % TMA_MOD;
        i = i + 1;
    }
    return h;
}

pub fn main() void {
    const n : usize = tma_paint(tma_r(TMA_K_HERO), tma_g(TMA_K_HERO), tma_b(TMA_K_HERO));
    const path : [*:0]const u8 = "target/course/tma/tma_home.ppm";
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("tma_home: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    const w : usize = std.c.fwrite(@ptrCast(&TMA_PPM), 1, n, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != TMA_BYTES) {
        std.debug.print("tma_home: short write to {s}: {d} of {d} bytes\n", .{ path, w, TMA_BYTES });
        std.c.exit(2);
    }
    std.debug.print("tma_home: wrote {s} ({d} bytes) hero r={d} g={d} b={d}\n", .{ path, w, tma_r(TMA_K_HERO), tma_g(TMA_K_HERO), tma_b(TMA_K_HERO) });
    std.debug.print("tma_home: flat token fill by node kind; nothing here says a frame looks right\n", .{});
}

test the_frame_is_15_header_bytes_plus_913500_rgb_bytes {
    assert tma_paint(tma_r(TMA_K_HERO), tma_g(TMA_K_HERO), tma_b(TMA_K_HERO)) == TMA_BYTES;
    let want : []const u8 = "P6\n375 812\n255\n";
    var i : usize = 0;
    while i < want.len {
        assert TMA_PPM[i] == want[i];
        i = i + 1;
    }
    assert want.len == 15;
    assert TMA_BYTES == 15 + 375 * 812 * 3;
}

test a_frame_repeats_byte_for_byte {
    assert tma_paint(tma_r(TMA_K_HERO), tma_g(TMA_K_HERO), tma_b(TMA_K_HERO)) == TMA_BYTES;
    let a : u64 = tma_digest();
    assert tma_paint(tma_r(TMA_K_HERO), tma_g(TMA_K_HERO), tma_b(TMA_K_HERO)) == TMA_BYTES;
    assert tma_digest() == a;
}

test first_pixel_matches_tma_hero_color {
    assert tma_paint(tma_r(TMA_K_HERO), tma_g(TMA_K_HERO), tma_b(TMA_K_HERO)) == TMA_BYTES;
    assert TMA_PPM[15] == tma_r(TMA_K_HERO);
    assert TMA_PPM[16] == tma_g(TMA_K_HERO);
    assert TMA_PPM[17] == tma_b(TMA_K_HERO);
}

test digest_changes_between_different_node_kinds {
    assert tma_paint(tma_r(TMA_K_HERO), tma_g(TMA_K_HERO), tma_b(TMA_K_HERO)) == TMA_BYTES;
    let a : u64 = tma_digest();
    assert tma_paint(tma_r(TMA_K_POPULAR), tma_g(TMA_K_POPULAR), tma_b(TMA_K_POPULAR)) == TMA_BYTES;
    let b : u64 = tma_digest();
    assert a != b;
}
