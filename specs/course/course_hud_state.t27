// SPDX-License-Identifier: Apache-2.0
; specs/course/course_hud_state.t27 -- the state machine of the interactive course HUD: four screens (lesson overview,
; one scene, the 27-petal menu, the progress data screen), eight events, and the transitions between them, all in
; plain integers (Refs gHashTag/t27#13251).
; It is the ONE state machine for the three targets: native frames call hud_step, the browser calls the same functions
; exported to WASM, and the FPGA takes on_comb, which works on the packed u64 form (hud_pack / hud_unpack) and lowers
; to Verilog with t27c gen-verilog. hud_step_core is pure; hit-testing lives in course_hud_nav and enters only
; through hud_step. Pointer events carry a card or control hit and a petal hit, computed from the same point.
; Loops appear in tests only, never in an invariant. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module CourseHudState;

use course::course_hud_nav::nav_hit;
use course::course_hud_nav::menu_hit;
use course::course_hud_nav::HIT_NONE;
use course::course_hud_nav::HIT_MENU;
use course::course_hud_nav::HIT_BACK;
use course::course_hud_nav::WORLD_UNIVERSITY;
use t27f::petal_menu::PETAL_NONE;
use t27f::petal_menu::PETAL_COUNT;
use t27f::petal_menu::STATE_HOME;

pub const SCR_OVERVIEW : u8 = 0;
pub const SCR_SCENE : u8 = 1;
pub const SCR_MENU : u8 = 2;
pub const SCR_PROGRESS : u8 = 3;
pub const SCR_COUNT : u8 = 4;

pub const EV_NONE : u8 = 0;
pub const EV_UP : u8 = 1;
pub const EV_DOWN : u8 = 2;
pub const EV_ENTER : u8 = 3;
pub const EV_BACK : u8 = 4;
pub const EV_TAP : u8 = 5;
pub const EV_MENU : u8 = 6;
pub const EV_TICK : u8 = 7;
pub const EV_COUNT : u8 = 8;

pub const SCENE_N : u8 = 7;

pub const F_SCREEN : u8 = 0;
pub const F_PREV : u8 = 1;
pub const F_SEL : u8 = 2;
pub const F_SCENE : u8 = 3;
pub const F_MENU : u8 = 4;
pub const F_HOVER : u8 = 5;
pub const F_VISITED : u8 = 6;
pub const F_TICK : u8 = 7;

pub struct HudState {
    screen: u8,
    prev: u8,
    sel: u8,
    scene: u8,
    menu: u32,
    hover: u8,
    visited: u8,
    tick: u32,
}

pub fn hud_init() -> HudState {
    return HudState {
        screen: SCR_OVERVIEW,
        prev: SCR_OVERVIEW,
        sel: 0,
        scene: 0,
        menu: STATE_HOME,
        hover: WORLD_UNIVERSITY as u8,
        visited: 0,
        tick: 0,
    };
}

fn scene_bit(n: u8) -> u8 {
    return ((1 as u32) << (n as u32)) as u8;
}

fn go_scene(s: HudState, n: u8) -> HudState {
    var r : HudState = s;
    r.screen = SCR_SCENE;
    r.scene = n;
    r.visited = s.visited | scene_bit(n);
    return r;
}

fn open_menu(s: HudState) -> HudState {
    var r : HudState = s;
    if (s.screen != SCR_MENU) {
        r.prev = s.screen;
    }
    r.screen = SCR_MENU;
    r.menu = STATE_HOME;
    return r;
}

fn to_overview(s: HudState, sel: u8) -> HudState {
    var r : HudState = s;
    r.screen = SCR_OVERVIEW;
    r.sel = sel;
    return r;
}

fn menu_back(s: HudState) -> HudState {
    var r : HudState = s;
    if (s.menu != STATE_HOME) {
        r.menu = STATE_HOME;
    } else {
        r.screen = s.prev;
    }
    return r;
}

fn menu_enter(s: HudState) -> HudState {
    var r : HudState = s;
    if ((s.hover as u32) == WORLD_UNIVERSITY) {
        r.screen = s.prev;
        r.menu = STATE_HOME;
    } else {
        r.menu = s.hover as u32;
    }
    return r;
}

fn step_overview(s: HudState, ev: u8, hit: u8) -> HudState {
    var r : HudState = s;
    if (ev == EV_UP) {
        if (s.sel > 0) {
            r.sel = s.sel - 1;
        }
        return r;
    }
    if (ev == EV_DOWN) {
        if (s.sel < SCENE_N - 1) {
            r.sel = s.sel + 1;
        }
        return r;
    }
    if (ev == EV_ENTER) {
        return go_scene(s, s.sel);
    }
    if (ev == EV_TAP) {
        if (hit < SCENE_N) {
            var t : HudState = go_scene(s, hit);
            t.sel = hit;
            return t;
        }
        if (hit == HIT_MENU) {
            return open_menu(s);
        }
    }
    return r;
}

fn step_scene(s: HudState, ev: u8, hit: u8) -> HudState {
    if (ev == EV_UP) {
        if (s.scene > 0) {
            return go_scene(s, s.scene - 1);
        }
        return s;
    }
    if (ev == EV_DOWN) {
        if (s.scene < SCENE_N - 1) {
            return go_scene(s, s.scene + 1);
        }
        return s;
    }
    if (ev == EV_ENTER) {
        if (s.scene < SCENE_N - 1) {
            return go_scene(s, s.scene + 1);
        }
        var r : HudState = s;
        r.screen = SCR_PROGRESS;
        r.prev = SCR_SCENE;
        return r;
    }
    if (ev == EV_BACK) {
        return to_overview(s, s.scene);
    }
    if (ev == EV_TAP) {
        if (hit == HIT_BACK) {
            return to_overview(s, s.scene);
        }
        if (hit == HIT_MENU) {
            return open_menu(s);
        }
    }
    return s;
}

fn step_menu(s: HudState, ev: u8, hit: u8, petal: u32) -> HudState {
    var r : HudState = s;
    if (ev == EV_UP) {
        if (s.hover == 0) {
            r.hover = (PETAL_COUNT - 1) as u8;
        } else {
            r.hover = s.hover - 1;
        }
        return r;
    }
    if (ev == EV_DOWN) {
        if ((s.hover as u32) + 1 >= PETAL_COUNT) {
            r.hover = 0;
        } else {
            r.hover = s.hover + 1;
        }
        return r;
    }
    if (ev == EV_ENTER) {
        return menu_enter(s);
    }
    if (ev == EV_BACK) {
        return menu_back(s);
    }
    if (ev == EV_TAP) {
        if (petal != PETAL_NONE) {
            if (petal < PETAL_COUNT) {
                r.hover = petal as u8;
                return menu_enter(r);
            }
            return s;
        }
        if (hit == HIT_BACK) {
            return menu_back(s);
        }
    }
    return s;
}

fn step_progress(s: HudState, ev: u8, hit: u8) -> HudState {
    if (ev == EV_BACK) {
        return to_overview(s, s.sel);
    }
    if (ev == EV_TAP) {
        if (hit == HIT_BACK) {
            return to_overview(s, s.sel);
        }
        if (hit == HIT_MENU) {
            return open_menu(s);
        }
    }
    return s;
}

pub fn hud_step_core(s: HudState, ev: u8, hit: u8, petal: u32) -> HudState {
    if (ev >= EV_COUNT) {
        return s;
    }
    if (ev == EV_NONE) {
        return s;
    }
    if (ev == EV_TICK) {
        var t : HudState = s;
        t.tick = s.tick + 1;
        return t;
    }
    if (ev == EV_MENU) {
        return open_menu(s);
    }
    if (s.screen == SCR_OVERVIEW) {
        return step_overview(s, ev, hit);
    }
    if (s.screen == SCR_SCENE) {
        return step_scene(s, ev, hit);
    }
    if (s.screen == SCR_MENU) {
        return step_menu(s, ev, hit, petal);
    }
    if (s.screen == SCR_PROGRESS) {
        return step_progress(s, ev, hit);
    }
    return s;
}

pub fn hud_step(s: HudState, ev: u8, x: i64, y: i64) -> HudState {
    return hud_step_core(s, ev, nav_hit(x, y), menu_hit(x, y) as u32);
}

pub fn hud_click_at(s: HudState, x: i64, y: i64) -> HudState {
    return hud_step(s, EV_TAP, x, y);
}

pub fn visited_count(s: HudState) -> u8 {
    var n : u8 = 0;
    var i : u8 = 0;
    while (i < SCENE_N) {
        if ((s.visited & scene_bit(i)) != 0) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn hud_pack(s: HudState) -> u64 {
    var v : u64 = 0;
    v = v | ((s.screen as u64) & 3);
    v = v | (((s.prev as u64) & 3) << 2);
    v = v | (((s.sel as u64) & 7) << 4);
    v = v | (((s.scene as u64) & 7) << 7);
    v = v | (((s.menu as u64) & 255) << 10);
    v = v | (((s.hover as u64) & 31) << 18);
    v = v | (((s.visited as u64) & 127) << 23);
    v = v | ((s.tick as u64) << 32);
    return v;
}

pub fn hud_unpack(v: u64) -> HudState {
    return HudState {
        screen: (v & 3) as u8,
        prev: ((v >> 2) & 3) as u8,
        sel: ((v >> 4) & 7) as u8,
        scene: ((v >> 7) & 7) as u8,
        menu: ((v >> 10) & 255) as u32,
        hover: ((v >> 18) & 31) as u8,
        visited: ((v >> 23) & 127) as u8,
        tick: ((v >> 32) & 4294967295) as u32,
    };
}

pub fn hud_init_packed() -> u64 {
    return hud_pack(hud_init());
}

pub fn hud_step_packed(v: u64, ev: u8, hit: u8, petal: u32) -> u64 {
    return hud_pack(hud_step_core(hud_unpack(v), ev, hit, petal));
}

pub fn hud_field(v: u64, f: u8) -> u32 {
    const s : HudState = hud_unpack(v);
    if (f == F_SCREEN) { return s.screen as u32; }
    if (f == F_PREV) { return s.prev as u32; }
    if (f == F_SEL) { return s.sel as u32; }
    if (f == F_SCENE) { return s.scene as u32; }
    if (f == F_MENU) { return s.menu; }
    if (f == F_HOVER) { return s.hover as u32; }
    if (f == F_VISITED) { return s.visited as u32; }
    if (f == F_TICK) { return s.tick; }
    return 0;
}

fn on_comb(v: u64, ev: u8, hit: u8, petal: u32) -> u64 {
    return hud_step_packed(v, ev, hit, petal);
}

fn step_n(s: HudState, ev: u8, n: u8) -> HudState {
    var r : HudState = s;
    var i : u8 = 0;
    while (i < n) {
        r = hud_step_core(r, ev, HIT_NONE, PETAL_NONE);
        i = i + 1;
    }
    return r;
}

fn ev0(s: HudState, ev: u8) -> HudState {
    return hud_step_core(s, ev, HIT_NONE, PETAL_NONE);
}

fn full_state() -> HudState {
    return HudState {
        screen: 3,
        prev: 2,
        sel: 5,
        scene: 6,
        menu: 255,
        hover: 26,
        visited: 127,
        tick: 123456789,
    };
}

test init_values {
    const s : HudState = hud_init();
    assert s.screen == SCR_OVERVIEW;
    assert s.prev == SCR_OVERVIEW;
    assert s.sel == 0;
    assert s.scene == 0;
    assert s.menu == STATE_HOME;
    assert (s.hover as u32) == WORLD_UNIVERSITY;
    assert s.visited == 0;
    assert s.tick == 0;
}

test down_seven_times_clamps_at_six {
    const s : HudState = step_n(hud_init(), EV_DOWN, 7);
    assert s.sel == 6;
    assert s.screen == SCR_OVERVIEW;
}

test up_at_zero_stays_zero {
    const s : HudState = ev0(hud_init(), EV_UP);
    assert s.sel == 0;
}

test enter_opens_scene_zero_and_marks_visited {
    const s : HudState = ev0(hud_init(), EV_ENTER);
    assert s.screen == SCR_SCENE;
    assert s.scene == 0;
    assert s.visited == 1;
}

test back_from_scene_returns_with_sel {
    var s : HudState = step_n(hud_init(), EV_DOWN, 2);
    s = ev0(s, EV_ENTER);
    assert s.scene == 2;
    s = ev0(s, EV_BACK);
    assert s.screen == SCR_OVERVIEW;
    assert s.sel == 2;
}

test tap_on_card_three_opens_scene_three {
    const s : HudState = hud_step_core(hud_init(), EV_TAP, 3, PETAL_NONE);
    assert s.screen == SCR_SCENE;
    assert s.scene == 3;
    assert s.sel == 3;
    assert s.visited == 8;
}

test menu_event_from_overview_remembers_prev {
    const s : HudState = ev0(hud_init(), EV_MENU);
    assert s.screen == SCR_MENU;
    assert s.prev == SCR_OVERVIEW;
    assert s.menu == STATE_HOME;
}

test menu_enter_on_university_returns_to_prev {
    var s : HudState = ev0(hud_init(), EV_MENU);
    s = ev0(s, EV_ENTER);
    assert s.screen == SCR_OVERVIEW;
    assert s.menu == STATE_HOME;
}

test menu_hover_wraps_both_ways {
    var s : HudState = ev0(hud_init(), EV_MENU);
    s.hover = 0;
    s = ev0(s, EV_UP);
    assert s.hover == 26;
    s = ev0(s, EV_DOWN);
    assert s.hover == 0;
}

test menu_tap_opens_petal_and_back_closes_in_steps {
    var s : HudState = ev0(hud_init(), EV_MENU);
    s = hud_step_core(s, EV_TAP, HIT_NONE, 5);
    assert s.menu == 5;
    assert s.screen == SCR_MENU;
    assert s.hover == 5;
    s = ev0(s, EV_BACK);
    assert s.menu == STATE_HOME;
    assert s.screen == SCR_MENU;
    s = ev0(s, EV_BACK);
    assert s.screen == SCR_OVERVIEW;
}

test scene_enter_at_last_scene_goes_to_progress {
    var s : HudState = hud_step_core(hud_init(), EV_TAP, 6, PETAL_NONE);
    s = ev0(s, EV_ENTER);
    assert s.screen == SCR_PROGRESS;
    assert s.prev == SCR_SCENE;
}

test progress_back_goes_to_overview {
    var s : HudState = hud_step_core(hud_init(), EV_TAP, 6, PETAL_NONE);
    s = ev0(s, EV_ENTER);
    s = ev0(s, EV_BACK);
    assert s.screen == SCR_OVERVIEW;
}

test tick_changes_only_tick {
    const a : HudState = hud_step_core(hud_init(), EV_TAP, 4, PETAL_NONE);
    const b : HudState = ev0(a, EV_TICK);
    assert b.tick == a.tick + 1;
    assert b.screen == a.screen;
    assert b.prev == a.prev;
    assert b.sel == a.sel;
    assert b.scene == a.scene;
    assert b.menu == a.menu;
    assert b.hover == a.hover;
    assert b.visited == a.visited;
}

test pack_unpack_round_trip {
    const s : HudState = full_state();
    const u : HudState = hud_unpack(hud_pack(s));
    assert u.screen == 3;
    assert u.prev == 2;
    assert u.sel == 5;
    assert u.scene == 6;
    assert u.menu == 255;
    assert u.hover == 26;
    assert u.visited == 127;
    assert u.tick == 123456789;
}

test packed_step_matches_core_step {
    const s : HudState = hud_init();
    const a : u64 = hud_step_packed(hud_pack(s), EV_ENTER, HIT_NONE, PETAL_NONE);
    const b : u64 = hud_pack(hud_step_core(s, EV_ENTER, HIT_NONE, PETAL_NONE));
    assert a == b;
    assert on_comb(hud_pack(s), EV_ENTER, HIT_NONE, PETAL_NONE) == b;
    assert hud_init_packed() == hud_pack(s);
}

test field_reads_back_every_field {
    const v : u64 = hud_pack(full_state());
    assert hud_field(v, F_SCREEN) == 3;
    assert hud_field(v, F_PREV) == 2;
    assert hud_field(v, F_SEL) == 5;
    assert hud_field(v, F_SCENE) == 6;
    assert hud_field(v, F_MENU) == 255;
    assert hud_field(v, F_HOVER) == 26;
    assert hud_field(v, F_VISITED) == 127;
    assert hud_field(v, F_TICK) == 123456789;
}

test invalid_event_leaves_state_unchanged {
    const s : HudState = full_state();
    const t : HudState = hud_step_core(s, EV_COUNT + 1, HIT_NONE, PETAL_NONE);
    assert hud_pack(t) == hud_pack(s);
}

test tap_on_nothing_changes_nothing {
    const s : HudState = hud_init();
    const t : HudState = hud_step_core(s, EV_TAP, HIT_NONE, PETAL_NONE);
    assert hud_pack(t) == hud_pack(s);
}

test visited_count_counts_distinct_scenes {
    var s : HudState = hud_step_core(hud_init(), EV_TAP, 0, PETAL_NONE);
    s = ev0(s, EV_BACK);
    s = hud_step_core(s, EV_TAP, 3, PETAL_NONE);
    s = ev0(s, EV_BACK);
    s = hud_step_core(s, EV_TAP, 6, PETAL_NONE);
    assert visited_count(s) == 3;
    assert s.visited == 73;
}
