; specs/course/lesson_01_theme_main.t27 -- host program: lesson 1 under the light and the dark theme
; (Refs #13251 ring 4, #13674). For every scene it prints one line: meaning lines changed, rectangles changed,
; pixels changed, and the labels that fail the contrast check per theme. It writes two P6 375x812 frames per
; scene under target/course/theme/ (15 header bytes, then 913500 RGB bytes).
; The frames are flat token fills by node kind, read from the rows of vf_theme. NOTHING HERE SAYS A FRAME LOOKS RIGHT.
; Build and run on the build server, never on the Mac: t27c gen, then zig build-exe with -lc, then mkdir -p target/course/theme.
; An unopenable path or a short write exits 2. Module-level vars are never spliced by use, so the buffer lives here.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CourseLesson01ThemeMain;

use t27f::ui_plan::THEME_LIGHT;
use t27f::ui_plan::THEME_DARK;
use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use course::lesson_01_fpga_intro::scene;
use course::lesson_01_fpga_intro::SCENE_COUNT;
use course::lesson_01_fpga_intro::SCENE_IDS;
use course::lesson_01_theme::l01t_with_theme;
use course::lesson_01_theme::l01t_color;
use course::lesson_01_theme::l01t_pixels_changed;
use course::lesson_01_theme::l01t_rects_changed;
use course::lesson_01_theme::l01t_meaning_changed;
use course::lesson_01_theme::l01t_contrast_fail;
use course::lesson_01_theme::L01T_W;
use course::lesson_01_theme::L01T_H;
; vf_meaning and vf_theme both declare a vf_gap; the splice of l01t_meaning_changed needs the vf_meaning one named here.
use t27f::vf_meaning::vf_gap;

pub var L01T_PPM : [913515]u8 = [0] ** 913515;

pub const L01T_BYTES : usize = 913515;
pub const L01T_MOD : u64 = 1000000007;

/// Paint g laid out as l under theme t into L01T_PPM as a P6 file: 15 header bytes, then one RGB triple per pixel. Returns the bytes written.
pub fn l01t_paint(g: VfGraph, l: VfLayout, t: u8) -> usize {
    let head : []const u8 = "P6\n375 812\n255\n";
    var i : usize = 0;
    while i < head.len {
        L01T_PPM[i] = head[i];
        i = i + 1;
    }
    var o : usize = head.len;
    var py : u32 = 0;
    while py < L01T_H {
        var px : u32 = 0;
        while px < L01T_W {
            let c : u32 = l01t_color(g, l, t, px, py);
            L01T_PPM[o] = ((c / 65536) % 256) as u8;
            L01T_PPM[o + 1] = ((c / 256) % 256) as u8;
            L01T_PPM[o + 2] = (c % 256) as u8;
            o = o + 3;
            px = px + 1;
        }
        py = py + 1;
    }
    return o;
}

/// A fingerprint of the whole P6 file in L01T_PPM: h = (h * 31 + byte) mod L01T_MOD, header included.
pub fn l01t_digest() -> u64 {
    var h : u64 = 0;
    var i : usize = 0;
    while i < L01T_BYTES {
        h = (h * 31 + (L01T_PPM[i] as u64)) % L01T_MOD;
        i = i + 1;
    }
    return h;
}

pub fn main() void {
    var s : u8 = 0;
    while (s < SCENE_COUNT) {
        const ga : VfGraph = l01t_with_theme(scene(s), THEME_LIGHT);
        const gb : VfGraph = l01t_with_theme(scene(s), THEME_DARK);
        const la : VfLayout = vf_layout(ga);
        const lb : VfLayout = vf_layout(gb);
        var t : u8 = 0;
        while (t < 2) {
            const k : u8 = s * 2 + t;
            var path : [*:0]const u8 = "target/course/theme/l01_0_hook_light.ppm";
            if (k == 1) { path = "target/course/theme/l01_0_hook_dark.ppm"; }
            if (k == 2) { path = "target/course/theme/l01_1_visual_light.ppm"; }
            if (k == 3) { path = "target/course/theme/l01_1_visual_dark.ppm"; }
            if (k == 4) { path = "target/course/theme/l01_2_predict_light.ppm"; }
            if (k == 5) { path = "target/course/theme/l01_2_predict_dark.ppm"; }
            if (k == 6) { path = "target/course/theme/l01_3_poke_light.ppm"; }
            if (k == 7) { path = "target/course/theme/l01_3_poke_dark.ppm"; }
            if (k == 8) { path = "target/course/theme/l01_4_explain_light.ppm"; }
            if (k == 9) { path = "target/course/theme/l01_4_explain_dark.ppm"; }
            if (k == 10) { path = "target/course/theme/l01_5_transfer_light.ppm"; }
            if (k == 11) { path = "target/course/theme/l01_5_transfer_dark.ppm"; }
            if (k == 12) { path = "target/course/theme/l01_6_prove_light.ppm"; }
            if (k == 13) { path = "target/course/theme/l01_6_prove_dark.ppm"; }
            const n : usize = l01t_paint(ga, la, t);
            const fp = std.c.fopen(path, "wb");
            if (fp == null) {
                std.debug.print("l01_theme: cannot open {s} for writing\n", .{path});
                std.c.exit(2);
            }
            const w : usize = std.c.fwrite(@ptrCast(&L01T_PPM), 1, n, fp.?);
            _ = std.c.fclose(fp.?);
            if (w != L01T_BYTES) {
                std.debug.print("l01_theme: short write to {s}: {d} of {d} bytes\n", .{ path, w, L01T_BYTES });
                std.c.exit(2);
            }
            t += 1;
        }
        std.debug.print("scene {d} {s}: meaning_changed {d} rects_changed {d} pixels_changed {d} of {d}\n", .{ s, SCENE_IDS[s], l01t_meaning_changed(ga, la, gb, lb), l01t_rects_changed(la, lb), l01t_pixels_changed(ga, la, THEME_LIGHT, THEME_DARK, L01T_W, L01T_H), L01T_W * L01T_H });
        std.debug.print("  contrast_fail light {d} dark {d}\n", .{ l01t_contrast_fail(ga, THEME_LIGHT), l01t_contrast_fail(gb, THEME_DARK) });
        s += 1;
    }
    std.debug.print("l01_theme: flat token fills by node kind; nothing here says a frame looks right\n", .{});
}

test the_frame_is_15_header_bytes_plus_913500_rgb_bytes {
    let g : VfGraph = scene(0);
    let l : VfLayout = vf_layout(g);
    assert l01t_paint(g, l, THEME_LIGHT) == L01T_BYTES;
    let want : []const u8 = "P6\n375 812\n255\n";
    var i : usize = 0;
    while i < want.len {
        assert L01T_PPM[i] == want[i];
        i = i + 1;
    }
    assert want.len == 15;
    assert L01T_BYTES == 15 + 375 * 812 * 3;
}

test the_light_and_the_dark_frame_differ_on_every_scene {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        let l : VfLayout = vf_layout(g);
        assert l01t_paint(g, l, THEME_LIGHT) == L01T_BYTES;
        let a : u64 = l01t_digest();
        assert l01t_paint(g, l, THEME_DARK) == L01T_BYTES;
        let b : u64 = l01t_digest();
        assert a != b;
        s = s + 1;
    }
}

test a_frame_repeats_byte_for_byte {
    let g : VfGraph = scene(0);
    let l : VfLayout = vf_layout(g);
    assert l01t_paint(g, l, THEME_DARK) == L01T_BYTES;
    let a : u64 = l01t_digest();
    assert l01t_paint(g, l, THEME_DARK) == L01T_BYTES;
    assert l01t_digest() == a;
}

test the_first_pixel_is_the_token_fill_of_its_node {
    let g : VfGraph = scene(0);
    let l : VfLayout = vf_layout(g);
    assert l01t_paint(g, l, THEME_LIGHT) == L01T_BYTES;
    let c : u32 = l01t_color(g, l, THEME_LIGHT, 0, 0);
    assert L01T_PPM[15] == ((c / 65536) % 256) as u8;
    assert L01T_PPM[16] == ((c / 256) % 256) as u8;
    assert L01T_PPM[17] == (c % 256) as u8;
}
