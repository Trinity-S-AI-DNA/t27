// SPDX-License-Identifier: Apache-2.0
; specs/course/lesson_01_frames_main.t27 -- host program: the seven scenes of lesson 1 as frames (Refs gHashTag/t27#13251,
; ring 5 of the graph-first UI engine; lesson 1 is t27#13238). Each scene graph of specs/course/lesson_01_fpga_intro.t27
; goes through vf_layout (T27F-003) and vf_render (T27F-005) at 375x812, the contract's default viewport, and is written as
; a binary PPM P6 (15 header bytes, then 913500 RGB bytes) to target/course/l01_<n>_<scene>.ppm. For every scene it prints
; to stderr: the frame digest, the meaning and spatial digests of vf_meaning (what the screen says, and how its boxes sit
; to each other, both without coordinates), the overlap and overflow counts of vf_pixel, and the meaning of every node (kind, depth,
; relation to the previous sibling, gap, rectangle, label) from vf_meaning. The first run is the baseline; a later ring
; compares its frames and meaning lines with these.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. The tests pin the header, the size, that the seven frames differ, that a render
; repeats byte for byte, and that a moved node changes the digest. They do not say a scene looks right; that starts only
; when somebody has opened the frames and read them next to the meaning lines.
; --
; BUILD AND RUN (a heavy build: in a T27 OS pane or on the lab, not on the Mac without the owner's word):
;   t27c gen specs/course/lesson_01_frames_main.t27 > l01_frames.zig
;   zig build-exe l01_frames.zig -lc
;   mkdir -p target/course
;   ./l01_frames 2> target/course/l01_meaning.txt
;   sips -s format png target/course/l01_0_hook.ppm --out target/course/l01_0_hook.png   (one per frame)
; Output paths sit under the working directory (target/ is gitignored), never /tmp. An unopenable path or a short write
; exits 2; a render refusal exits 1.
; --
; Module-level vars are never spliced by `use`, so the byte buffers live here and are passed to vf_render as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CourseLesson01FramesMain;

use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_overlap_count;
use t27f::vf_pixel::vf_overflow_count;
use t27f::vf_render::vf_render_ppm;
use t27f::vf_render::VF_R_OK;
use t27f::vf_meaning::vf_relation;
use t27f::vf_meaning::vf_gap;
use t27f::vf_meaning::vf_depth;
use t27f::vf_meaning::vf_kind_word;
use t27f::vf_meaning::vf_relation_word;
use t27f::vf_meaning::vf_primary_action;
use t27f::vf_meaning::vf_meaning_digest;
use t27f::vf_meaning::vf_spatial_digest;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::ALIGN_STRETCH;
use course::lesson_01_fpga_intro::scene;
use course::lesson_01_fpga_intro::SCENE_COUNT;
use course::lesson_01_fpga_intro::SCENE_IDS;

pub var L01_RGB : [913500]u8 = [0] ** 913500;
pub var L01_PPM : [913515]u8 = [0] ** 913515;
pub var L01_DIGEST : [7]u64 = [0] ** 7;

pub const L01_W : u32 = 375;
pub const L01_H : u32 = 812;
pub const L01_BYTES : usize = 913515;
pub const L01_MOD : u64 = 1000000007;

/// Render g laid out as l into L01_PPM; the vf_render result (0 is ok).
pub fn l01_render(g: VfGraph, l: VfLayout) -> u8 {
    return vf_render_ppm(g, l, &L01_RGB, &L01_PPM, L01_W, L01_H);
}

/// A fingerprint of the whole P6 file in L01_PPM: h = (h * 31 + byte) mod 1000000007, header included.
pub fn l01_digest() -> u64 {
    var h : u64 = 0;
    var i : usize = 0;
    while i < L01_BYTES {
        h = (h * 31 + (L01_PPM[i] as u64)) % L01_MOD;
        i = i + 1;
    }
    return h;
}

pub fn main() void {
    var s : u8 = 0;
    while (s < SCENE_COUNT) {
        const g : VfGraph = scene(s);
        const l : VfLayout = vf_layout(g);
        const rr : u8 = l01_render(g, l);
        if (rr != VF_R_OK) {
            std.debug.print("l01_frames: scene {d} render refused, code {d}\n", .{ s, rr });
            std.c.exit(1);
        }
        var path : [*:0]const u8 = "target/course/l01_0_hook.ppm";
        if (s == 1) { path = "target/course/l01_1_visual.ppm"; }
        if (s == 2) { path = "target/course/l01_2_predict.ppm"; }
        if (s == 3) { path = "target/course/l01_3_poke.ppm"; }
        if (s == 4) { path = "target/course/l01_4_explain.ppm"; }
        if (s == 5) { path = "target/course/l01_5_transfer.ppm"; }
        if (s == 6) { path = "target/course/l01_6_prove.ppm"; }
        const fp = std.c.fopen(path, "wb");
        if (fp == null) {
            std.debug.print("l01_frames: cannot open {s} for writing\n", .{path});
            std.c.exit(2);
        }
        const w : usize = std.c.fwrite(@ptrCast(&L01_PPM), 1, L01_BYTES, fp.?);
        _ = std.c.fclose(fp.?);
        if (w != L01_BYTES) {
            std.debug.print("l01_frames: short write to {s}: {d} of {d} bytes\n", .{ path, w, L01_BYTES });
            std.c.exit(2);
        }
        std.debug.print("scene {d} {s}: wrote {d} bytes to {s} ({d}x{d}, P6) digest {d}\n", .{ s, SCENE_IDS[s], L01_BYTES, path, L01_W, L01_H, l01_digest() });
        std.debug.print("  meaning_digest {d} spatial_digest {d}\n", .{ vf_meaning_digest(g), vf_spatial_digest(g, l) });
        std.debug.print("  nodes {d} overlap {d} overflow {d} primary action {d}\n", .{ l.node_count, vf_overlap_count(g, l), vf_overflow_count(g, l), vf_primary_action(g) });
        std.debug.print("  meaning: node kind depth relation gap x y w h text\n", .{});
        var i : u32 = 0;
        while (i < l.node_count) {
            std.debug.print("  {d} {s} depth {d} {s} gap {d} at {d},{d} size {d}x{d} [{s}]\n", .{ i, vf_kind_word(g, i), vf_depth(g, i), vf_relation_word(vf_relation(g, l, i)), vf_gap(g, l, i), l.x[i], l.y[i], l.w[i], l.h[i], g.text[i] });
            i += 1;
        }
        s += 1;
    }
    std.debug.print("l01_frames: byte-level frames; open them and compare with the lines above before saying they look right\n", .{});
}

test every_scene_lays_out_and_renders {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        let l : VfLayout = vf_layout(g);
        assert g.node_count > 0;
        assert l.node_count == g.node_count;
        assert l01_render(g, l) == VF_R_OK;
        s = s + 1;
    }
}

test the_frame_is_15_header_bytes_plus_913500_rgb_bytes {
    let g : VfGraph = scene(0);
    let l : VfLayout = vf_layout(g);
    assert l01_render(g, l) == VF_R_OK;
    let want : []const u8 = "P6\n375 812\n255\n";
    var i : usize = 0;
    while i < want.len {
        assert L01_PPM[i] == want[i];
        i = i + 1;
    }
    assert want.len == 15;
    assert L01_BYTES == 15 + 375 * 812 * 3;
}

test the_seven_frames_differ {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        let l : VfLayout = vf_layout(g);
        assert l01_render(g, l) == VF_R_OK;
        L01_DIGEST[s] = l01_digest();
        s = s + 1;
    }
    var a : u8 = 0;
    while a < SCENE_COUNT {
        var b : u8 = a + 1;
        while b < SCENE_COUNT {
            assert L01_DIGEST[a] != L01_DIGEST[b];
            b = b + 1;
        }
        a = a + 1;
    }
}

test a_render_repeats_byte_for_byte {
    let g : VfGraph = scene(3);
    let l : VfLayout = vf_layout(g);
    assert l01_render(g, l) == VF_R_OK;
    let first : u64 = l01_digest();
    assert l01_render(g, l) == VF_R_OK;
    assert l01_digest() == first;
}

test a_moved_node_changes_the_digest {
    // negative control: shift node 4 of the hook scene (the Start button, drawn on top) 40 px down, into the white below
    // the card; the digest must change. Until 2026-11-07 this shifted node 1, the body stack, 40 px right: since
    // vf_text_measure the stack and its three children are all 375 px wide and the children tile its height, so no pixel
    // shows the stack and a shift right only leaves the 375 raster. The digest stayed the same and the control failed.
    let g : VfGraph = scene(0);
    var l : VfLayout = vf_layout(g);
    assert l01_render(g, l) == VF_R_OK;
    let before : u64 = l01_digest();
    l.y[4] = l.y[4] + 40;
    assert l.y[4] + l.h[4] <= L01_H;
    assert l01_render(g, l) == VF_R_OK;
    assert l01_digest() != before;
}

test the_seven_scenes_have_seven_meaning_digests {
    var a : u8 = 0;
    while a < SCENE_COUNT {
        var b : u8 = a + 1;
        while b < SCENE_COUNT {
            assert vf_meaning_digest(scene(a)) != vf_meaning_digest(scene(b));
            b = b + 1;
        }
        a = a + 1;
    }
}

test a_relayout_keeps_the_meaning {
    // every node of every scene turned into a stretched column: geometry hints only, so the meaning digest stays
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        var r : VfGraph = scene(s);
        var i : u32 = 0;
        while i < r.node_count {
            r.direction[i] = DIR_COLUMN;
            r.align[i] = ALIGN_STRETCH;
            i = i + 1;
        }
        assert vf_meaning_digest(r) == vf_meaning_digest(g);
        s = s + 1;
    }
}
