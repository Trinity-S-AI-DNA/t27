// SPDX-License-Identifier: Apache-2.0
; specs/course/lesson_01_diff_main.t27 -- host program: the before/after/diff of the seven scenes of lesson 1 (Refs
; gHashTag/t27#13251, the cross-cutting diff of the graph-first UI engine; lesson 1 is t27#13238). For every scene it reads
; the before frame target/course/base/l01_<n>_<scene>.ppm and the after frame target/course/l01_<n>_<scene>.ppm, both P6
; 375x812 files of 913515 bytes (15 header bytes, then 913500 RGB bytes) as specs/course/lesson_01_frames_main.t27 writes
; them, and prints to stderr one line per scene, `scene <n> <id>: <count> pixels differ, bbox <x0>,<y0>-<x1>,<y1>` (or
; `0 pixels differ`), then a total. It writes target/course/l01_<n>_<scene>_diff.ppm: the same header and the vf_diff_frame
; body, a changed pixel red 0xFF0000 and an unchanged one a light grey of its brightness.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. A count says how many pixel bytes moved between two runs, not whether either frame
; looks right or whether the change was the intended one; that starts only when somebody opens the diff frames.
; --
; BUILD AND RUN (a heavy build: in a T27 OS pane or on the lab, not on the Mac without the owner's word):
;   copy the baseline frames of lesson_01_frames_main into target/course/base/, then rebuild and rerun that program
;   t27c gen specs/course/lesson_01_diff_main.t27 > l01_diff.zig
;   zig build-exe l01_diff.zig -lc
;   ./l01_diff 2> target/course/l01_diff.txt
;   sips -s format png target/course/l01_0_hook_diff.ppm --out target/course/l01_0_hook_diff.png   (one per frame)
; Paths sit under the working directory (target/ is gitignored), never /tmp. A missing file, a file of the wrong size, a
; header that is not `P6 375 812 255`, an unopenable output or a short write exits 2; a diff refusal exits 1.
; --
; Module-level vars are never spliced by `use`, so the byte buffers live here and are passed to vf_diff as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CourseLesson01DiffMain;

use t27f::vf_diff::VfDiffBox;
use t27f::vf_diff::vf_diff_count;
use t27f::vf_diff::vf_diff_bbox;
use t27f::vf_diff::vf_diff_frame;
use t27f::vf_diff::VF_D_OK;
use course::lesson_01_fpga_intro::SCENE_COUNT;
use course::lesson_01_fpga_intro::SCENE_IDS;

pub var L01D_HA : [15]u8 = [0] ** 15;
pub var L01D_HB : [15]u8 = [0] ** 15;
pub var L01D_A : [913500]u8 = [0] ** 913500;
pub var L01D_B : [913500]u8 = [0] ** 913500;
pub var L01D_D : [913500]u8 = [0] ** 913500;
pub var L01D_TAIL : [1]u8 = [0] ** 1;

pub const L01D_W : u32 = 375;
pub const L01D_H : u32 = 812;
pub const L01D_HDR : usize = 15;
pub const L01D_RGB : usize = 913500;
pub const L01D_BYTES : usize = 913515;
pub const L01D_P6 : []const u8 = "P6\n375 812\n255\n";

; results of a frame read: read, cannot open, under 913515 bytes, over 913515 bytes
pub const L01D_READ_OK : u8 = 0;
pub const L01D_NO_FILE : u8 = 1;
pub const L01D_SHORT : u8 = 2;
pub const L01D_LONG : u8 = 3;

/// The L01D_* result of a read that got nh header bytes, nb RGB bytes and nt bytes past the end. main opens and reads
/// the files itself, because t27b takes `[*:0]const u8` only as a local of main, not as a fn parameter.
pub fn l01d_counted(nh: usize, nb: usize, nt: usize) -> u8 {
    if (nh != L01D_HDR or nb != L01D_RGB) { return L01D_SHORT; }
    if (nt != 0) { return L01D_LONG; }
    return L01D_READ_OK;
}

/// Why a read failed, for the error line.
pub fn l01d_why(code: u8) -> str {
    if (code == L01D_NO_FILE) { return "cannot be opened"; }
    if (code == L01D_SHORT) { return "is shorter than 913515 bytes"; }
    if (code == L01D_LONG) { return "is longer than 913515 bytes"; }
    return "was read";
}

/// True when hdr holds exactly the 15 bytes `P6\n375 812\n255\n`.
pub fn l01d_is_p6(hdr: []const u8) -> bool {
    var i : usize = 0;
    while (i < L01D_HDR) {
        if (hdr[i] != L01D_P6[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn main() void {
    var total : u32 = 0;
    var s : u8 = 0;
    while (s < SCENE_COUNT) {
        var before : [*:0]const u8 = "target/course/base/l01_0_hook.ppm";
        var after : [*:0]const u8 = "target/course/l01_0_hook.ppm";
        var diff : [*:0]const u8 = "target/course/l01_0_hook_diff.ppm";
        if (s == 1) { before = "target/course/base/l01_1_visual.ppm"; after = "target/course/l01_1_visual.ppm"; diff = "target/course/l01_1_visual_diff.ppm"; }
        if (s == 2) { before = "target/course/base/l01_2_predict.ppm"; after = "target/course/l01_2_predict.ppm"; diff = "target/course/l01_2_predict_diff.ppm"; }
        if (s == 3) { before = "target/course/base/l01_3_poke.ppm"; after = "target/course/l01_3_poke.ppm"; diff = "target/course/l01_3_poke_diff.ppm"; }
        if (s == 4) { before = "target/course/base/l01_4_explain.ppm"; after = "target/course/l01_4_explain.ppm"; diff = "target/course/l01_4_explain_diff.ppm"; }
        if (s == 5) { before = "target/course/base/l01_5_transfer.ppm"; after = "target/course/l01_5_transfer.ppm"; diff = "target/course/l01_5_transfer_diff.ppm"; }
        if (s == 6) { before = "target/course/base/l01_6_prove.ppm"; after = "target/course/l01_6_prove.ppm"; diff = "target/course/l01_6_prove_diff.ppm"; }
        var ra : u8 = L01D_NO_FILE;
        const fa = std.c.fopen(before, "rb");
        if (fa != null) {
            const nha : usize = std.c.fread(@ptrCast(&L01D_HA), 1, L01D_HDR, fa.?);
            const nba : usize = std.c.fread(@ptrCast(&L01D_A), 1, L01D_RGB, fa.?);
            const nta : usize = std.c.fread(@ptrCast(&L01D_TAIL), 1, 1, fa.?);
            _ = std.c.fclose(fa.?);
            ra = l01d_counted(nha, nba, nta);
        }
        if (ra != L01D_READ_OK) {
            std.debug.print("l01_diff: scene {d}: before file {s} {s}\n", .{ s, before, l01d_why(ra) });
            std.c.exit(2);
        }
        var rb : u8 = L01D_NO_FILE;
        const fb = std.c.fopen(after, "rb");
        if (fb != null) {
            const nhb : usize = std.c.fread(@ptrCast(&L01D_HB), 1, L01D_HDR, fb.?);
            const nbb : usize = std.c.fread(@ptrCast(&L01D_B), 1, L01D_RGB, fb.?);
            const ntb : usize = std.c.fread(@ptrCast(&L01D_TAIL), 1, 1, fb.?);
            _ = std.c.fclose(fb.?);
            rb = l01d_counted(nhb, nbb, ntb);
        }
        if (rb != L01D_READ_OK) {
            std.debug.print("l01_diff: scene {d}: after file {s} {s}\n", .{ s, after, l01d_why(rb) });
            std.c.exit(2);
        }
        if (l01d_is_p6(&L01D_HA) == false) {
            std.debug.print("l01_diff: scene {d}: before file {s} has no P6 375 812 255 header\n", .{ s, before });
            std.c.exit(2);
        }
        if (l01d_is_p6(&L01D_HB) == false) {
            std.debug.print("l01_diff: scene {d}: after file {s} has no P6 375 812 255 header\n", .{ s, after });
            std.c.exit(2);
        }
        const n : u32 = vf_diff_count(&L01D_A, &L01D_B, L01D_W, L01D_H);
        const bx : VfDiffBox = vf_diff_bbox(&L01D_A, &L01D_B, L01D_W, L01D_H);
        const rd : u8 = vf_diff_frame(&L01D_A, &L01D_B, &L01D_D, L01D_W, L01D_H);
        if (rd != VF_D_OK) {
            std.debug.print("l01_diff: scene {d}: diff refused, code {d}\n", .{ s, rd });
            std.c.exit(1);
        }
        const fp = std.c.fopen(diff, "wb");
        if (fp == null) {
            std.debug.print("l01_diff: cannot open {s} for writing\n", .{diff});
            std.c.exit(2);
        }
        const wh : usize = std.c.fwrite(@ptrCast(&L01D_HA), 1, L01D_HDR, fp.?);
        const wb : usize = std.c.fwrite(@ptrCast(&L01D_D), 1, L01D_RGB, fp.?);
        _ = std.c.fclose(fp.?);
        if (wh + wb != L01D_BYTES) {
            std.debug.print("l01_diff: short write to {s}: {d} of {d} bytes\n", .{ diff, wh + wb, L01D_BYTES });
            std.c.exit(2);
        }
        if (bx.any) {
            std.debug.print("scene {d} {s}: {d} pixels differ, bbox {d},{d}-{d},{d}\n", .{ s, SCENE_IDS[s], n, bx.x0, bx.y0, bx.x1, bx.y1 });
        } else {
            std.debug.print("scene {d} {s}: 0 pixels differ\n", .{ s, SCENE_IDS[s] });
        }
        total += n;
        s += 1;
    }
    std.debug.print("l01_diff: {d} pixels differ across the {d} scenes; open the _diff frames before saying what changed\n", .{ total, SCENE_COUNT });
    std.c.exit(0);
}

; fill L01D_A with a pattern that is not all one value: byte i is i mod 251
fn l01d_pattern() -> void {
    var i : usize = 0;
    while i < L01D_RGB {
        L01D_A[i] = (i % 251) as u8;
        L01D_B[i] = (i % 251) as u8;
        i = i + 1;
    }
}

test a_frame_diffed_with_itself_gives_0 {
    l01d_pattern();
    assert vf_diff_count(&L01D_A, &L01D_A, L01D_W, L01D_H) == 0;
    assert vf_diff_count(&L01D_A, &L01D_B, L01D_W, L01D_H) == 0;
    assert vf_diff_bbox(&L01D_A, &L01D_B, L01D_W, L01D_H).any == false;
    assert vf_diff_frame(&L01D_A, &L01D_B, &L01D_D, L01D_W, L01D_H) == VF_D_OK;
}

test nc_one_byte_of_the_after_frame_shows {
    // negative control: the last byte of the after frame, pixel (374, 811); a diff that ignored the buffers would say 0
    l01d_pattern();
    L01D_B[913499] = L01D_B[913499] + 1;
    assert vf_diff_count(&L01D_A, &L01D_B, L01D_W, L01D_H) == 1;
    let bx : VfDiffBox = vf_diff_bbox(&L01D_A, &L01D_B, L01D_W, L01D_H);
    assert bx.any == true;
    assert bx.x0 == 374;
    assert bx.y0 == 811;
    assert vf_diff_frame(&L01D_A, &L01D_B, &L01D_D, L01D_W, L01D_H) == VF_D_OK;
    assert L01D_D[913497] == 255;
    assert L01D_D[913498] == 0;
    assert L01D_D[913499] == 0;
}

test the_header_check_takes_only_p6_375_812 {
    var i : usize = 0;
    while i < L01D_HDR {
        L01D_HA[i] = L01D_P6[i];
        i = i + 1;
    }
    assert l01d_is_p6(&L01D_HA) == true;
    assert L01D_BYTES == L01D_HDR + L01D_RGB;
    assert L01D_RGB == 375 * 812 * 3;
    // 812 375 is the same size and the wrong shape
    L01D_HA[3] = 56;
    assert l01d_is_p6(&L01D_HA) == false;
}

test the_byte_counts_say_read_short_or_long {
    assert l01d_counted(15, 913500, 0) == L01D_READ_OK;
    // negative controls: one header byte short, one RGB byte short, one byte past the end
    assert l01d_counted(14, 913500, 0) == L01D_SHORT;
    assert l01d_counted(15, 913499, 0) == L01D_SHORT;
    assert l01d_counted(15, 913500, 1) == L01D_LONG;
    assert l01d_why(L01D_LONG) == "is longer than 913515 bytes";
}
