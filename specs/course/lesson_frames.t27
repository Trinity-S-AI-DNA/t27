// SPDX-License-Identifier: Apache-2.0
// specs/course/lesson_frames.t27 -- which spec each lesson of the FPGA course opens.
//
// WHY. Each lesson of Course 1 ("From zero to a chip", gHashTag/trinity
// apps/website/specs/course/course.t27, LESSON_SPECS) opens one spec in the player: its
// frame. Five frames do not show the lesson's hardware (weak point W3 of
// specs/course/fpga_course_v2.t27; Trinity-S-AI-DNA/trinity#1478):
//   - lesson 1 frames specs/boards/wukong_v1.t27 and lesson 3 frames
//     specs/boards/xc7a100t_minimal.t27: two boards, neither the bench board, which is the
//     ALINX AX7203 of specs/boards/ax7203.t27 (PACKAGE "fbg484");
//   - lessons 4, 5 and 14 frame tutorial files about the language, not about hardware.
// This module is the law the next course edit follows, written before that edit.
//
// THE LAW, per lesson:
//   1. A lesson outside the two Course-0 overlap modules ("program", "compiler", lessons
//      7-12) never frames a specs/tutorial/ file. Those six lessons are exempt here: the
//      issue replaces the two modules as a whole, which is a separate task.
//   2. A lesson that frames a board spec (specs/boards/) frames the bench board.
// FRAME_NOW is course.t27 LESSON_SPECS as read on 2026-11-07; FRAME_NEXT is the table the
// course edit writes. The tests show the law fails on FRAME_NOW and holds on FRAME_NEXT.
//
// FRAME_NEXT follows the issue's table with one change: "a-build-receipt" frames
// specs/fpga/board_receipt.t27, because the proposed tools/trios/tri/x7-bench.t27 does not
// exist on master. Every FRAME_NEXT path that differs from FRAME_NOW exists on
// Trinity-S-AI-DNA/t27 master (checked 2026-11-07 with git cat-file); the course copies
// specs under public/t27/files/, and that copy is the course edit's work.
//
// NOT CLAIMED: that a lesson's text matches its new frame. The text is rewritten in the
// trinity course edit, which is blocked behind the course post route (trinity#1806).
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module course_lesson_frames;

use std::mem::bytes_eq;
use std::mem::bytes_starts_with;

pub const LESSON_COUNT : u32 = 27;
pub const BENCH_BOARD : str = "specs/boards/ax7203.t27";
pub const BOARD_DIR : str = "specs/boards/";
pub const TUTORIAL_DIR : str = "specs/tutorial/";

// Lessons 7-12 (indices 6-11): modules "program" and "compiler", which repeat Course 0.
pub const EXEMPT_FIRST : u32 = 6;
pub const EXEMPT_LAST : u32 = 11;

pub const FRAME_NOW : [27]str = [
    "specs/boards/wukong_v1.t27", "specs/tools/tri/fpga.t27", "specs/boards/xc7a100t_minimal.t27",
    "specs/tutorial/01_values_and_types.t27", "specs/tutorial/05_widths_and_casts.t27", "specs/fpga/stdlib.t27",
    "specs/tutorial/02_functions.t27", "specs/tutorial/07_tests_invariants_benches.t27", "specs/tutorial/03_operators.t27",
    "specs/tutorial/06_structs_enums_switch.t27", "specs/demos/hello_world.t27", "specs/tutorial/08_modules_and_arrays.t27",
    "specs/ternary/clocked_counter.t27", "specs/tutorial/04_control_flow.t27", "specs/ternary/ternary_full_adder.t27",
    "specs/fpga/crossopt.t27", "specs/fpga/dft.t27", "specs/fpga/partition.t27",
    "specs/fpga/placement.t27", "specs/fpga/timing.t27", "specs/fpga/cts.t27",
    "specs/tools/trios/tri/x7-fasm.t27", "specs/fpga/adapter.t27", "specs/tools/trios/tri/x7-writer.t27",
    "specs/tools/trios/tri/fpga-jtag.t27", "specs/tools/trios/tri/x7-board.t27", "specs/fpga/e2e_demo.t27"
];

pub const FRAME_NEXT : [27]str = [
    "specs/boards/ax7203.t27", "specs/tools/tri/fpga.t27", "specs/boards/ax7203.t27",
    "specs/ternary/packed_trit.t27", "specs/ternary/hybrid_arithmetic.t27", "specs/fpga/stdlib.t27",
    "specs/tutorial/02_functions.t27", "specs/tutorial/07_tests_invariants_benches.t27", "specs/tutorial/03_operators.t27",
    "specs/tutorial/06_structs_enums_switch.t27", "specs/demos/hello_world.t27", "specs/tutorial/08_modules_and_arrays.t27",
    "specs/ternary/clocked_counter.t27", "specs/ternary/ternary_full_adder.t27", "specs/ternary/ternary_full_adder.t27",
    "specs/fpga/crossopt.t27", "specs/fpga/uart.t27", "specs/fpga/partition.t27",
    "specs/fpga/placement.t27", "specs/fpga/timing.t27", "specs/fpga/timing.t27",
    "specs/tools/trios/tri/x7-fasm.t27", "specs/fpga/board_receipt.t27", "specs/tools/trios/tri/x7-writer.t27",
    "specs/tools/trios/tri/fpga-jtag.t27", "specs/tools/trios/tri/x7-board.t27", "specs/fpga/e2e_demo.t27"
];

pub fn exempt(lesson: u32) -> bool {
    return lesson >= EXEMPT_FIRST and lesson <= EXEMPT_LAST;
}

// Law 1 and law 2 for one lesson and one frame path.
pub fn frame_ok(lesson: u32, path: str) -> bool {
    var ok : bool = true;
    if !exempt(lesson) and bytes_starts_with(path, TUTORIAL_DIR) {
        ok = false;
    }
    if bytes_starts_with(path, BOARD_DIR) and !bytes_eq(path, BENCH_BOARD) {
        ok = false;
    }
    return ok;
}

// How many lessons break the law: in FRAME_NEXT when `next`, else in FRAME_NOW.
pub fn breaks(next: bool) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < LESSON_COUNT {
        var path : str = FRAME_NOW[i];
        if next {
            path = FRAME_NEXT[i];
        }
        if !frame_ok(i, path) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn changed() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < LESSON_COUNT {
        if !bytes_eq(FRAME_NOW[i], FRAME_NEXT[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

test the_law_reads_one_path {
    assert frame_ok(0, BENCH_BOARD);
    assert frame_ok(16, "specs/fpga/uart.t27");
    // Negative controls: a second board, and a tutorial file outside the exempt lessons.
    assert !frame_ok(0, "specs/boards/wukong_v1.t27");
    assert !frame_ok(2, "specs/boards/xc7a100t_minimal.t27");
    assert !frame_ok(3, "specs/tutorial/01_values_and_types.t27");
    // The exempt lessons may keep a tutorial frame; the edges of the range are exact.
    assert frame_ok(6, "specs/tutorial/02_functions.t27");
    assert frame_ok(11, "specs/tutorial/08_modules_and_arrays.t27");
    assert !frame_ok(5, "specs/tutorial/02_functions.t27");
    assert !frame_ok(12, "specs/tutorial/02_functions.t27");
}

test the_current_course_breaks_the_law_five_times {
    // Lessons 1, 3 (boards), 4, 5, 14 (tutorial files).
    assert breaks(false) == 5;
}

test the_next_table_keeps_the_law {
    assert breaks(true) == 0;
}

test the_edit_changes_eight_frames_and_no_exempt_one {
    assert changed() == 8;
    var i : u32 = EXEMPT_FIRST;
    while i <= EXEMPT_LAST {
        assert bytes_eq(FRAME_NOW[i], FRAME_NEXT[i]);
        i = i + 1;
    }
}

test both_board_lessons_frame_the_bench_board {
    assert bytes_eq(FRAME_NEXT[0], BENCH_BOARD);
    assert bytes_eq(FRAME_NEXT[2], BENCH_BOARD);
    assert !bytes_eq(FRAME_NOW[0], BENCH_BOARD);
}
