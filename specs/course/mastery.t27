// SPDX-License-Identifier: Apache-2.0
// specs/course/mastery.t27 -- when a t27.ai lesson counts as learned, and when it comes back.
//
// WHY. A lesson of the t27.ai courses is "done" when the reader presses "Mark as done"
// (gHashTag/trinity apps/website src/pages/Course.tsx, toggle()): the mark checks nothing,
// and a task is a question with no answer key. This module is the rule that replaces the
// self-mark, written before any page reads it, so the page has one law to follow.
//
// THE LOOP, per lesson: PREDICT -> POKE -> EXPLAIN -> TRANSFER -> PROVE -> MASTERED.
//   PREDICT   the reader commits to an answer before touching the widget. Right or wrong,
//             the loop moves on: a prediction is a commitment, not a gate.
//   POKE      the reader moves the widget and sees the outcome.
//   EXPLAIN   the lesson text says why the outcome is what it is.
//   TRANSFER  the same idea on a case the widget did not show. Wrong: back to POKE.
//   PROVE     the reader types a value read from the lesson's spec frame; it must equal the
//             lesson's answer key. Wrong: back to POKE.
// A lesson is MASTERED when PROVE passed and the reader's last two predictions in a row were
// right (STREAK_TO_MASTER). Only MASTERED counts toward the course progress.
//
// REVIEW: a mastered lesson comes back after 1, 3, 9 and 27 days, each interval three times
// the last (REVIEW_DAYS). A passed review moves one level up; after the fourth the lesson is
// retired. A failed review resets the level to 0 and sends the lesson back to POKE.
//
// Sources for the shape, not for any number: the Electronics 101 teardown
// (docs/nona-03-manifest/ELECTRONICS-101-TEARDOWN.md), which ends each lesson with a
// self-mark too; HDLBits, which grades a submission against a reference by simulation.
//
// NOT CLAIMED: that this loop teaches better. No learner has used it; the powers of three
// are a choice that fits a 27-lesson course, not a measured optimum. The page that reads
// this module is not written yet: Course.tsx is TypeScript and stays as it is until a
// generator carries this law to it.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module course_mastery;

pub const PREDICT : u8 = 0;
pub const POKE : u8 = 1;
pub const EXPLAIN : u8 = 2;
pub const TRANSFER : u8 = 3;
pub const PROVE : u8 = 4;
pub const MASTERED : u8 = 5;
pub const STEP_COUNT : u8 = 6;
pub const STEP_NAMES : [6]str = ["predict", "poke", "explain", "transfer", "prove", "mastered"];
pub const NO_STEP : u8 = 255;

pub const STREAK_TO_MASTER : u8 = 2;
pub const STREAK_CAP : u8 = 27;

pub const REVIEW_LEVELS : u8 = 4;
pub const REVIEW_DAYS : [4]u32 = [1, 3, 9, 27];
pub const RETIRED : u8 = 4;

// The step after `step`, given whether the reader got it right. A step out of range stays
// out of range, so a corrupt saved state is never read as progress.
pub fn next_step(step: u8, ok: bool) -> u8 {
    var v : u8 = NO_STEP;
    if step == PREDICT {
        v = POKE;
    } else if step == POKE {
        v = EXPLAIN;
    } else if step == EXPLAIN {
        v = TRANSFER;
    } else if step == TRANSFER {
        if ok {
            v = PROVE;
        } else {
            v = POKE;
        }
    } else if step == PROVE {
        if ok {
            v = MASTERED;
        } else {
            v = POKE;
        }
    } else if step == MASTERED {
        v = MASTERED;
    }
    return v;
}

// The prediction streak after one more prediction.
pub fn next_streak(streak: u8, correct: bool) -> u8 {
    var v : u8 = 0;
    if correct {
        v = streak;
        if v < STREAK_CAP {
            v = v + 1;
        }
    }
    return v;
}

// PROVE: the value the reader typed against the lesson's answer key.
pub fn prove_ok(answer: u32, key: u32) -> bool {
    return answer == key;
}

// The mastery rule. PROVE alone is not enough, and neither is a streak alone.
pub fn is_mastered(streak: u8, proved: bool) -> bool {
    return proved and streak >= STREAK_TO_MASTER;
}

// Only a mastered lesson counts toward "N of 27 done".
pub fn counts_as_done(step: u8) -> bool {
    return step == MASTERED;
}

// Days from the last pass to the next review at `level`; 0 once the lesson is retired.
pub fn review_interval(level: u8) -> u32 {
    var v : u32 = 0;
    if level < REVIEW_LEVELS {
        v = REVIEW_DAYS[level];
    }
    return v;
}

// The review level after a review.
pub fn next_level(level: u8, passed: bool) -> u8 {
    var v : u8 = 0;
    if passed {
        v = level;
        if v < RETIRED {
            v = v + 1;
        }
    }
    return v;
}

// Is a review due today? `last_pass_day` is the day of mastery or of the last passed review.
pub fn review_due(last_pass_day: u32, level: u8, today: u32) -> bool {
    var v : bool = false;
    if level < REVIEW_LEVELS {
        v = today >= last_pass_day + review_interval(level);
    }
    return v;
}

// Where a lesson goes after a review: back to POKE when it failed.
pub fn step_after_review(passed: bool) -> u8 {
    var v : u8 = MASTERED;
    if !passed {
        v = POKE;
    }
    return v;
}

// Total days from mastery to retirement when every review passes on its due day.
pub fn days_to_retire() -> u32 {
    var total : u32 = 0;
    var i : u8 = 0;
    while i < REVIEW_LEVELS {
        total = total + REVIEW_DAYS[i];
        i = i + 1;
    }
    return total;
}

test the_happy_path_reaches_mastered_in_five_steps {
    var s : u8 = PREDICT;
    s = next_step(s, true);
    assert s == POKE;
    s = next_step(s, true);
    assert s == EXPLAIN;
    s = next_step(s, true);
    assert s == TRANSFER;
    s = next_step(s, true);
    assert s == PROVE;
    s = next_step(s, true);
    assert s == MASTERED;
    assert STEP_NAMES[s] == "mastered";
}

test a_wrong_prediction_still_moves_on {
    assert next_step(PREDICT, false) == POKE;
}

test a_wrong_transfer_or_proof_goes_back_to_poke {
    assert next_step(TRANSFER, false) == POKE;
    assert next_step(PROVE, false) == POKE;
}

test no_step_but_prove_reaches_mastered {
    var s : u8 = 0;
    while s < PROVE {
        assert next_step(s, true) != MASTERED;
        s = s + 1;
    }
    assert next_step(77, true) == NO_STEP;
}

test mastery_needs_both_the_proof_and_the_streak {
    assert is_mastered(2, true);
    assert is_mastered(5, true);
    // Negative controls: one without the other is not mastery.
    assert !is_mastered(1, true);
    assert !is_mastered(27, false);
    assert !is_mastered(0, false);
}

test the_streak_breaks_on_a_miss {
    var k : u8 = 0;
    k = next_streak(k, true);
    k = next_streak(k, true);
    assert k == STREAK_TO_MASTER;
    k = next_streak(k, false);
    assert k == 0;
    assert next_streak(STREAK_CAP, true) == STREAK_CAP;
}

test prove_compares_with_the_key {
    // Lesson 1 of course 1 with ax7203.t27 as its frame: LUT6_TOTAL.
    assert prove_ok(134600, 134600);
    // Negative control: the logic-cell figure is the wrong answer.
    assert !prove_ok(215360, 134600);
}

test a_self_mark_is_not_done {
    assert counts_as_done(MASTERED);
    assert !counts_as_done(PROVE);
    assert !counts_as_done(PREDICT);
}

test reviews_come_back_after_powers_of_three {
    var i : u8 = 1;
    while i < REVIEW_LEVELS {
        assert REVIEW_DAYS[i] == 3 * REVIEW_DAYS[i - 1];
        i = i + 1;
    }
    assert REVIEW_DAYS[0] == 1;
    assert days_to_retire() == 40;
    assert review_interval(RETIRED) == 0;
}

test a_review_is_due_on_its_day_and_not_before {
    assert !review_due(10, 0, 10);
    assert review_due(10, 0, 11);
    assert !review_due(10, 2, 18);
    assert review_due(10, 2, 19);
    assert !review_due(10, RETIRED, 1000);
}

test a_failed_review_resets_and_sends_back {
    assert next_level(2, true) == 3;
    assert next_level(3, true) == RETIRED;
    assert next_level(RETIRED, true) == RETIRED;
    assert next_level(3, false) == 0;
    assert step_after_review(false) == POKE;
    assert step_after_review(true) == MASTERED;
}
