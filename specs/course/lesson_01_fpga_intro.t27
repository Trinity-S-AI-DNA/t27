pub const PROVE_REVIEW : str = "Comes back for review after 1, 3, 9 and 27 days.";

// ---------------------------------------------------------------- the answer keys

pub const LUT_INPUTS : u8 = 6;
pub const LUT_ROWS : u32 = 64;
pub const PREDICT_KEY : u32 = 64;
pub const TRANSFER_CELLS : u32 = 160_000;
pub const TRANSFER_KEY : u32 = 100_000;
pub const PROVE_KEY : u32 = 269_200;

// ---------------------------------------------------------------- the poke model: one LUT6

// The 64 stored bits of the poked LUT6, bit r = the output for input row r. A 6-input AND
// stores a 1 only in row 63, where all six inputs are 1.
pub const AND6_TABLE : u64 = 0x8000000000000000;

// The six inputs as a mask, input A = bit 0. A toggle flips one input.
pub fn toggle(pins: u32, k: u8) -> u32 {
    return pins ^ bit(k);
}

// The table row the inputs select.
pub fn lut_row(pins: u32) -> u32 {
    return pins & (LUT_ROWS - 1);
}

// The LUT6 output for a row: the stored bit, nothing computed.
pub fn lut_out(table: u64, row: u32) -> u32 {
    return ((table >> (row as u64)) & 1) as u32;
}

// ---------------------------------------------------------------- scene builders

// Layout rule (vf_layout reads `align` on the PARENT, for all of its children): the root
// card is a column and stretches its children across the card, and so do stacks and lists.
fn put_root_card(label: str, test_id: str) -> VfGraph {
    var g : VfGraph = vf_add(vf_blank_graph(), VF_CARD, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), test_id);
    g.label[0] = label;
    g.direction[0] = DIR_COLUMN;
    g.align[0] = ALIGN_STRETCH;
    return g;
}

fn put_stack(g: VfGraph, parent: u8, direction: u8, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_STACK, parent, bit(P_TEST_ID), test_id);
    n.direction[n.node_count - 1] = direction;
    n.align[n.node_count - 1] = ALIGN_STRETCH;
    return n;
}

fn put_list(g: VfGraph, parent: u8, label: str, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_LIST, parent, bit(P_LABEL) + bit(P_TEST_ID), test_id);
    n.label[n.node_count - 1] = label;
    n.direction[n.node_count - 1] = DIR_COLUMN;
    n.align[n.node_count - 1] = ALIGN_STRETCH;
    return n;
}

fn put_text(g: VfGraph, parent: u8, text: str, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_TEXT, parent, bit(P_TEXT) + bit(P_TEST_ID), test_id);
    n.text[n.node_count - 1] = text;
    return n;
}

fn put_note(g: VfGraph, parent: u8, text: str, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_TEXT, parent, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), test_id);
    n.text[n.node_count - 1] = text;
    n.variant[n.node_count - 1] = SECONDARY;
    return n;
}

fn put_badge(g: VfGraph, parent: u8, text: str, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_BADGE, parent, bit(P_TEXT) + bit(P_TEST_ID), test_id);
    n.text[n.node_count - 1] = text;
    return n;
}

// A primary action button: its text is its accessible name.
fn put_action(g: VfGraph, parent: u8, text: str, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_BUTTON, parent, bit(P_TEXT) + bit(P_VARIANT) + bit(P_STATE) + bit(P_TEST_ID), test_id);
    n.text[n.node_count - 1] = text;
    n.variant[n.node_count - 1] = PRIMARY;
    return n;
}

// A poke toggle: shows the input's value, named by its label.
fn put_toggle(g: VfGraph, parent: u8, label: str, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_BUTTON, parent, bit(P_TEXT) + bit(P_LABEL) + bit(P_STATE) + bit(P_TEST_ID), test_id);
    n.text[n.node_count - 1] = "0";
    n.label[n.node_count - 1] = label;
    return n;
}

// A number field, named by the text node `label_node`.
fn put_number(g: VfGraph, parent: u8, label_node: u8, test_id: str) -> VfGraph {
    var n : VfGraph = vf_add(g, VF_INPUT, parent, bit(P_LABEL_REF) + bit(P_STATE) + bit(P_TEST_ID), test_id);
    n.label_ref[n.node_count - 1] = label_node;
    return n;
}

fn with_focus(g: VfGraph, i: u32) -> VfGraph {
    var n : VfGraph = g;
    n.state[i] = FOCUS;
    return n;
}

pub fn scene_hook() -> VfGraph {
    var g : VfGraph = put_root_card(LESSON_TITLE, "l1-hook");
    g = put_stack(g, 0, DIR_COLUMN, "l1-hook-body");
    g = put_text(g, 1, HOOK_LINE, "l1-hook-line");
    g = put_text(g, 1, HOOK_QUESTION, "l1-hook-question");
    g = put_action(g, 1, "Start", "l1-hook-start");
    return with_focus(g, 4);
}

pub fn scene_visual() -> VfGraph {
    var g : VfGraph = put_root_card(VISUAL_TITLE, "l1-visual");
    g = put_list(g, 0, "Board facts", "l1-visual-board");
    g = put_text(g, 1, VISUAL_PART, "l1-visual-part");
    g = put_text(g, 1, VISUAL_PACKAGE, "l1-visual-package");
    g = put_text(g, 1, VISUAL_IDCODE, "l1-visual-idcode");
    g = put_list(g, 0, "XC7A200T fabric", "l1-visual-fabric");
    g = put_badge(g, 5, VISUAL_FABRIC[0], "l1-visual-slices");
    g = put_badge(g, 5, VISUAL_FABRIC[1], "l1-visual-lut6");
    g = put_badge(g, 5, VISUAL_FABRIC[2], "l1-visual-ff");
    g = put_badge(g, 5, VISUAL_FABRIC[3], "l1-visual-dsp");
    g = put_badge(g, 5, VISUAL_FABRIC[4], "l1-visual-bram");
    g = put_action(g, 0, "Next", "l1-visual-next");
    return with_focus(g, 11);
}

pub fn scene_predict() -> VfGraph {
    var g : VfGraph = put_root_card("Predict: what is a LUT?", "l1-predict");
    g = put_stack(g, 0, DIR_COLUMN, "l1-predict-body");
    g = put_text(g, 1, PREDICT_WHAT, "l1-predict-what");
    g = put_text(g, 1, PREDICT_QUESTION, "l1-predict-question");
    g = put_text(g, 1, "Your guess", "l1-predict-label");
    g = put_number(g, 1, 4, "l1-predict-input");
    g = put_action(g, 1, "Check", "l1-predict-check");
    return with_focus(g, 5);
}

pub fn scene_poke() -> VfGraph {
    var g : VfGraph = put_root_card("Poke: one LUT6", "l1-poke");
    g = put_text(g, 0, POKE_TABLE, "l1-poke-table");
    // Six 96 px toggles (576 px) do not fit 375 px: a column below md, a row from md up.
    g = put_stack(g, 0, DIR_COLUMN, "l1-poke-inputs");
    g.direction_md[2] = DIR_ROW;
    var k : u8 = 0;
    while k < LUT_INPUTS {
        g = put_toggle(g, 2, POKE_INPUTS[k], POKE_IDS[k]);
        k = k + 1;
    }
    g = put_badge(g, 0, "Row 0 of 64", "l1-poke-row");
    g = put_badge(g, 0, "Output: 0", "l1-poke-out");
    g = put_action(g, 0, "Next", "l1-poke-next");
    return with_focus(g, 3);
}

pub fn scene_explain() -> VfGraph {
    var g : VfGraph = put_root_card("Explain: LUT6 and logic cell", "l1-explain");
    g = put_stack(g, 0, DIR_COLUMN, "l1-explain-body");
    g = put_text(g, 1, EXPLAIN_LUT, "l1-explain-lut");
    g = put_text(g, 1, EXPLAIN_SLICES, "l1-explain-slices");
    g = put_text(g, 1, EXPLAIN_CELLS, "l1-explain-cells");
    g = put_action(g, 1, "Next", "l1-explain-next");
    return with_focus(g, 5);
}

pub fn scene_transfer() -> VfGraph {
    var g : VfGraph = put_root_card("Transfer: another FPGA", "l1-transfer");
    g = put_stack(g, 0, DIR_COLUMN, "l1-transfer-body");
    g = put_text(g, 1, TRANSFER_QUESTION, "l1-transfer-question");
    g = put_text(g, 1, "LUT6 count", "l1-transfer-label");
    g = put_number(g, 1, 3, "l1-transfer-input");
    g = put_action(g, 1, "Check", "l1-transfer-check");
    return with_focus(g, 4);
}

pub fn scene_prove() -> VfGraph {
    var g : VfGraph = put_root_card("Prove: read it from the spec", "l1-prove");
    g = put_stack(g, 0, DIR_COLUMN, "l1-prove-body");
    g = put_text(g, 1, PROVE_QUESTION, "l1-prove-question");
    g = put_text(g, 1, "Flip-flops", "l1-prove-label");
    g = put_number(g, 1, 3, "l1-prove-input");
    g = put_action(g, 1, "Submit", "l1-prove-submit");
    g = put_badge(g, 1, PROVE_RULE, "l1-prove-rule");
    g = put_note(g, 1, PROVE_REVIEW, "l1-prove-review");
    return with_focus(g, 4);
}

pub fn scene(s: u8) -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    if s == SCENE_HOOK {
        g = scene_hook();
    } else if s == SCENE_VISUAL {
        g = scene_visual();
    } else if s == SCENE_PREDICT {
        g = scene_predict();
    } else if s == SCENE_POKE {
        g = scene_poke();
    } else if s == SCENE_EXPLAIN {
        g = scene_explain();
    } else if s == SCENE_TRANSFER {
        g = scene_transfer();
    } else if s == SCENE_PROVE {
        g = scene_prove();
    }
    return g;
}

// The scene that carries a mastery step (SCENE_NONE for MASTERED and unknown steps).
pub fn scene_of_step(step: u8) -> u8 {
    var v : u8 = SCENE_NONE;
    var s : u8 = 0;
    while s < SCENE_COUNT {
        if SCENE_STEP[s] == step and step != NO_STEP {
            v = s;
        }
        s = s + 1;
    }
    return v;
}

// ---------------------------------------------------------------- focus and snapshot rows

// How many nodes are in the FOCUS state. A scene opens with exactly one.
pub fn focus_count(g: VfGraph) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < g.node_count {
        if g.state[i] == FOCUS {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// The node that holds focus when the scene opens; VF_MAX_NODES when none does.
pub fn initial_focus(g: VfGraph) -> u32 {
    var v : u32 = VF_MAX_NODES;
    var i : u32 = g.node_count;
    while i > 0 {
        i = i - 1;
        if g.state[i] == FOCUS {
            v = i;
        }
    }
    return v;
}

// Tab order: 0 for a node that takes no focus, else 1 + the focusable nodes before it.
pub fn focus_order(g: VfGraph, i: u32) -> u32 {
    var v : u32 = 0;
    if i < g.node_count and vf_is_interactive(g.kind[i]) {
        v = 1;
        var j : u32 = 0;
        while j < i {
            if vf_is_interactive(g.kind[j]) {
                v = v + 1;
            }
            j = j + 1;
        }
    }
    return v;
}

// One row of a story snapshot, field for field VF_SNAPSHOT_FIELDS.
pub struct SnapRow {
    index: u32,
    kind: u8,
    rect_known: bool,
    role: u8,
    name: str,
    focus: u32,
    test_id: str,
}

pub const SNAP_ROW_FIELDS : [7]str = ["index", "kind", "rect", "role", "name", "focus", "test_id"];

// snap_row does not call vf_layout, so a snapshot row carries no rect; the fit tests below call
// vf_layout only to bound the rects (the frames come from lesson_01_frames_main.t27).
pub const RECT_KNOWN : bool = false;

pub fn snap_row(g: VfGraph, i: u32) -> SnapRow {
    return SnapRow {
        index: i,
        kind: g.kind[i],
        rect_known: RECT_KNOWN,
        role: vf_role(g.kind[i]),
        name: vf_accessible_name(g, i),
        focus: focus_order(g, i),
        test_id: g.test_id[i],
    };
}

// ---------------------------------------------------------------- scene checks

// Every test id in scene `s` is its root id or starts with it.
pub fn ids_prefixed(g: VfGraph, s: u8) -> bool {
    var ok : bool = s < SCENE_COUNT;
    var i : u32 = 0;
    while ok and i < g.node_count {
        if !bytes_starts_with(g.test_id[i], SCENE_PREFIX[s]) {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

// Drift-rule breaks over every text and label in the scene (specs/tri/course/audit.t27).
pub fn text_drift(g: VfGraph) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < g.node_count {
        n = n + violations(g.text[i]) + violations(g.label[i]);
        i = i + 1;
    }
    return n;
}

// Every node a reader can reach has a non-empty name.
pub fn names_present(g: VfGraph) -> bool {
    var ok : bool = true;
    var i : u32 = 0;
    while i < g.node_count {
        if vf_is_interactive(g.kind[i]) and vf_accessible_name(g, i) == "" {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

// A scene is ready for a page when the contract passes, exactly one interactive node holds
// focus, its ids carry the scene prefix, it names every control and no string drifts.
pub fn scene_ok(g: VfGraph, s: u8) -> bool {
    var ok : bool = vf_validate(g) == VF_OK;
    if focus_count(g) != 1 {
        ok = false;
    } else {
        let f : u32 = initial_focus(g);
        if !vf_is_interactive(g.kind[f]) {
            ok = false;
        }
    }
    if !ids_prefixed(g, s) or !names_present(g) or text_drift(g) != 0 {
        ok = false;
    }
    return ok;
}

// The first number a scene string prints, thousands commas skipped: "33,650 slices" is
// 33650, "Package: FBG484, 484 balls" is 484. It ends at the first byte after a digit that
// is neither a digit nor a comma. 0 when the string prints no digit.
pub fn first_number(s: str) -> u32 {
    var v : u32 = 0;
    var seen : bool = false;
    var done : bool = false;
    var i : u32 = 0;
    while !done and i < s.len {
        const c : u8 = s[i];
        if c >= 48 and c <= 57 {
            v = v * 10 + ((c - 48) as u32);
            seen = true;
        } else if seen and c != 44 {
            done = true;
        }
        i = i + 1;
    }
    return v;
}

// ---------------------------------------------------------------- tests: every scene

test every_scene_passes_the_contract {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        assert vf_validate(scene(s)) == VF_OK;
        s = s + 1;
    }
}

test every_scene_is_ready {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        assert scene_ok(scene(s), s);
        s = s + 1;
    }
}

test scene_roots_carry_the_scene_ids {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        assert g.test_id[0] == SCENE_PREFIX[s];
        assert g.kind[0] == VF_CARD;
        s = s + 1;
    }
    assert SCENE_IDS[SCENE_COUNT - 1] == "prove";
    assert SCENE_PREFIX[SCENE_COUNT - 1] == "l1-prove";
}

test scene_sizes_fit_the_contract {
    assert scene_hook().node_count == 5;
    assert scene_visual().node_count == 12;
    assert scene_predict().node_count == 7;
    assert scene_poke().node_count == 12;
    assert scene_explain().node_count == 6;
    assert scene_transfer().node_count == 6;
    assert scene_prove().node_count == 8;
}

test focus_opens_on_the_scene_action {
    assert initial_focus(scene_hook()) == 4;
    assert initial_focus(scene_visual()) == 11;
    assert initial_focus(scene_predict()) == 5;
    assert initial_focus(scene_poke()) == 3;
    assert initial_focus(scene_explain()) == 5;
    assert initial_focus(scene_transfer()) == 4;
    assert initial_focus(scene_prove()) == 4;
}

test number_fields_are_named_textboxes {
    let p : VfGraph = scene_predict();
    assert vf_role(p.kind[5]) == TEXTBOX;
    assert vf_accessible_name(p, 5) == "Your guess";
    let t : VfGraph = scene_transfer();
    assert vf_accessible_name(t, 4) == "LUT6 count";
    let r : VfGraph = scene_prove();
    assert vf_accessible_name(r, 4) == "Flip-flops";
}

test poke_toggles_are_named_buttons_in_tab_order {
    let g : VfGraph = scene_poke();
    assert vf_role(g.kind[3]) == BUTTON;
    assert vf_accessible_name(g, 3) == "Input A";
    assert vf_accessible_name(g, 8) == "Input F";
    assert g.text[3] == "0";
    assert focus_order(g, 3) == 1;
    assert focus_order(g, 8) == 6;
    assert focus_order(g, 11) == 7;
    assert focus_order(g, 9) == 0;
}

test snapshot_rows_have_the_contract_fields {
    var f : u32 = 0;
    while f < 7 {
        assert SNAP_ROW_FIELDS[f] == VF_SNAPSHOT_FIELDS[f];
        f = f + 1;
    }
    let row : SnapRow = snap_row(scene_predict(), 5);
    assert row.index == 5;
    assert row.kind == VF_INPUT;
    assert row.role == TEXTBOX;
    assert row.name == "Your guess";
    assert row.focus == 1;
    assert row.test_id == "l1-predict-input";
    assert !row.rect_known;
}

// ---------------------------------------------------------------- tests: the numbers

test every_shown_board_number_is_the_board_constant {
    assert first_number(HOOK_LINE) == LUT6_TOTAL;
    assert contains(HOOK_LINE, "215,360") and first_number("215,360") == LOGIC_CELLS;
    assert first_number(VISUAL_FABRIC[0]) == SLICES;
    assert first_number(VISUAL_FABRIC[1]) == LUT6_TOTAL;
    assert first_number(VISUAL_FABRIC[2]) == FF_TOTAL;
    assert first_number(VISUAL_FABRIC[3]) == DSP48E1_TOTAL;
    assert first_number(VISUAL_FABRIC[4]) == BRAM36_TOTAL;
    assert first_number(VISUAL_PACKAGE) == PACKAGE_BALLS;
    assert contains(VISUAL_PACKAGE, " 484 balls");
    assert contains(VISUAL_PART, FPGA_PART);
    assert contains(VISUAL_IDCODE, "0x03636093") and JTAG_IDCODE == 0x03636093;
}

test explain_arithmetic_is_the_board_arithmetic {
    assert SLICES * LUTS_PER_SLICE == LUT6_TOTAL;
    assert logic_cells_of(LUT6_TOTAL) == LOGIC_CELLS;
    assert contains(EXPLAIN_SLICES, "33,650 x 4 = 134,600");
    assert contains(EXPLAIN_CELLS, "134,600 x 1.6 = 215,360");
    assert contains(EXPLAIN_CELLS, "logic cell");
}

test answer_keys_come_from_the_specs {
    assert PREDICT_KEY == bit(LUT_INPUTS);
    assert PREDICT_KEY == LUT_ROWS;
    assert logic_cells_of(TRANSFER_KEY) == TRANSFER_CELLS;
    assert first_number(TRANSFER_QUESTION) == TRANSFER_CELLS;
    assert PROVE_KEY == SLICES * FFS_PER_SLICE;
    assert PROVE_KEY == FF_TOTAL;
    assert SCENE_KEY[SCENE_PREDICT] == PREDICT_KEY;
    assert SCENE_KEY[SCENE_TRANSFER] == TRANSFER_KEY;
    assert SCENE_KEY[SCENE_PROVE] == PROVE_KEY;
    assert prove_ok(PROVE_KEY, SCENE_KEY[SCENE_PROVE]);
}

// ---------------------------------------------------------------- tests: the poke model

test the_and6_lut_stores_one_one {
    var ones : u32 = 0;
    var r : u32 = 0;
    while r < LUT_ROWS {
        ones = ones + lut_out(AND6_TABLE, r);
        r = r + 1;
    }
    assert ones == 1;
    assert lut_out(AND6_TABLE, 63) == 1;
}

test poking_the_inputs_moves_the_output {
    var pins : u32 = 0;
    assert lut_out(AND6_TABLE, lut_row(pins)) == 0;
    var k : u8 = 0;
    while k < LUT_INPUTS {
        pins = toggle(pins, k);
        k = k + 1;
    }
    assert lut_row(pins) == 63;
    assert lut_out(AND6_TABLE, lut_row(pins)) == 1;
    pins = toggle(pins, 0);
    assert lut_row(pins) == 62;
    assert lut_out(AND6_TABLE, lut_row(pins)) == 0;
}

// ---------------------------------------------------------------- tests: the loop

test scenes_follow_the_mastery_loop {
    assert SCENE_STEP[SCENE_HOOK] == NO_STEP;
    assert SCENE_STEP[SCENE_VISUAL] == NO_STEP;
    assert SCENE_STEP[SCENE_PREDICT] == PREDICT;
    assert SCENE_STEP[SCENE_POKE] == POKE;
    assert SCENE_STEP[SCENE_EXPLAIN] == EXPLAIN;
    assert SCENE_STEP[SCENE_TRANSFER] == TRANSFER;
    assert SCENE_STEP[SCENE_PROVE] == PROVE;
    var s : u8 = SCENE_PREDICT;
    while s < SCENE_PROVE {
        assert scene_of_step(next_step(SCENE_STEP[s], true)) == s + 1;
        s = s + 1;
    }
    assert next_step(SCENE_STEP[SCENE_PROVE], true) == MASTERED;
    assert scene_of_step(MASTERED) == SCENE_NONE;
}

test a_wrong_transfer_or_proof_goes_back_to_the_poke_scene {
    assert scene_of_step(next_step(TRANSFER, false)) == SCENE_POKE;
    assert scene_of_step(next_step(PROVE, false)) == SCENE_POKE;
}

test the_prove_scene_states_the_mastery_rule {
    assert contains(PROVE_RULE, "2 right predictions") and STREAK_TO_MASTER == 2;
    assert is_mastered(STREAK_TO_MASTER, true);
    assert !is_mastered(STREAK_TO_MASTER - 1, true);
    assert !is_mastered(STREAK_TO_MASTER, false);
    assert contains(PROVE_REVIEW, "1, 3, 9 and 27 days");
    assert REVIEW_DAYS[0] == 1 and REVIEW_DAYS[1] == 3 and REVIEW_DAYS[2] == 9 and REVIEW_DAYS[3] == 27;
}

// ---------------------------------------------------------------- fit at the 375 px viewport

// node_count is checked so a graph that vf_layout refuses (blank layout) cannot pass.
test every_scene_fits_the_375_viewport {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        let l : VfLayout = vf_layout(g);
        assert g.viewport_w == 375;
        assert l.node_count == g.node_count;
        assert vf_overflow_count(g, l) == 0;
        var i : u32 = 0;
        while i < l.node_count {
            assert l.x[i] + l.w[i] <= 375;
            assert l.w[i] > 0;
            i = i + 1;
        }
        s = s + 1;
    }
}

test every_root_card_is_a_column {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        assert g.direction[0] == DIR_COLUMN;
        assert g.align[0] == ALIGN_STRETCH;
        s = s + 1;
    }
}

// ---------------------------------------------------------------- negative controls

test nc_a_number_field_without_its_label_is_refused {
    var g : VfGraph = scene_predict();
    g.label_ref[5] = VF_NO_REF;
    assert vf_validate(g) == E_INPUT_LABEL;
    assert !scene_ok(g, SCENE_PREDICT);
}

test nc_a_toggle_without_a_name_is_refused {
    var g : VfGraph = scene_poke();
    g.label[3] = "";
    g.text[3] = "";
    assert vf_validate(g) == E_A11Y_NAME;
    assert !names_present(g);
}

test nc_two_focused_nodes_are_refused {
    var g : VfGraph = scene_hook();
    g = with_focus(g, 0);
    assert focus_count(g) == 2;
    assert !scene_ok(g, SCENE_HOOK);
}

test nc_a_foreign_test_id_is_refused {
    var g : VfGraph = scene_explain();
    g.test_id[2] = "l1-poke-lut";
    assert !ids_prefixed(g, SCENE_EXPLAIN);
    assert !scene_ok(g, SCENE_EXPLAIN);
}

test nc_a_drifting_sentence_is_refused {
    var g : VfGraph = scene_visual();
    g.text[3] = "Package: the bench chip has 676 balls";
    assert vf_validate(g) == VF_OK;
    assert text_drift(g) == 2;
    assert !scene_ok(g, SCENE_VISUAL);
}

test nc_a_wrong_number_does_not_match {
    assert first_number("134,601 LUT6") != LUT6_TOTAL;
    assert first_number("no digit here") == 0;
    assert first_number("FBG484, 484") == 484;
    assert !prove_ok(PROVE_KEY - 1, SCENE_KEY[SCENE_PROVE]);
    assert logic_cells_of(TRANSFER_KEY + 1) != TRANSFER_CELLS;
}

// With the toggles in a column a row root alone still fits (80 + 96 + 48 + 48 + 96 = 368 px),
// so the control puts both the root and the toggle stack back in a row, the graph of master,
// where shrinking leaves the stack 482 px wide and nodes 9-11 at x = 482.
test nc_a_row_root_overflows {
    var g : VfGraph = scene(SCENE_POKE);
    g.direction[0] = DIR_ROW;
    g.direction[2] = DIR_ROW;
    assert vf_validate(g) == VF_OK;
    assert vf_overflow_count(g, vf_layout(g)) > 0;
}
