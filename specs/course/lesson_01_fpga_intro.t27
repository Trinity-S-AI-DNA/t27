pub const PREDICT_WHAT : str = "A LUT6 is a small memory with 6 address inputs and 1 output: each input pattern picks one stored bit.";
pub const PREDICT_QUESTION : str = "How many input patterns can 6 inputs make? Commit to a number before you poke.";

pub const POKE_TABLE : str = "This LUT6 holds a 6-input AND: only the row with all six inputs at 1 stores a 1.";
pub const POKE_INPUTS : [6]str = ["Input A", "Input B", "Input C", "Input D", "Input E", "Input F"];
pub const POKE_IDS : [6]str = ["l1-poke-in-a", "l1-poke-in-b", "l1-poke-in-c", "l1-poke-in-d", "l1-poke-in-e", "l1-poke-in-f"];

pub const EXPLAIN_LUT : str = "A LUT6 stores 64 bits, one per input pattern, so it can hold any function of 6 inputs.";
pub const EXPLAIN_SLICES : str = "The XC7A200T has 33,650 slices with 4 LUT6 each: 33,650 x 4 = 134,600 LUT6.";
pub const EXPLAIN_CELLS : str = "A logic cell is a counting unit of AMD's data sheet, 1.6 per LUT6: 134,600 x 1.6 = 215,360 logic cells. It is not a LUT.";

pub const TRANSFER_QUESTION : str = "Another FPGA's data sheet says 160,000 logic cells, with the same 1.6 per LUT6. How many LUT6 does it have?";
pub const PROVE_QUESTION : str = "specs/boards/ax7203.t27 says SLICES = 33,650 and FFS_PER_SLICE = 8. How many flip-flops does the XC7A200T have?";
