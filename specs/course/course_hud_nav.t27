// SPDX-License-Identifier: Apache-2.0
; specs/course/course_hud_nav.t27 -- the pure integer geometry of the course HUD at its default 375x812 viewport.
; It places the two header buttons (back on the left, menu on the right), the seven scene cards under the header,
; and the 27-petal menu overlay that fills the area below the header, mapped to HUD pixels through
; specs/t27f/petal_menu.t27 (hit_px, fit_permille, to_box are called, never copied).
; Refs gHashTag/t27#13251. This file is geometry only: no state, no rendering, no strings but one constant.
; The state machine, the renderer and the wasm card import these names; keep them exactly.
; Integer-only: `/` truncates towards zero, so petal_px/petal_py are the inverse of hit_px up to one pixel,
; and the round-trip test pins that all 27 centres come back to their own petal.
; phi^2 + 1/phi^2 = 3 | TRINITY

module CourseHudNav;

use t27f::petal_menu::hit_px;
use t27f::petal_menu::fit_permille;
use t27f::petal_menu::centre_x;
use t27f::petal_menu::centre_y;
use t27f::petal_menu::BOX_CX;
use t27f::petal_menu::BOX_CY;
use t27f::petal_menu::PETAL_NONE;
use t27f::petal_menu::PETAL_COUNT;
use t27f::vf_uikit::UK_VIEW_W;
use t27f::vf_uikit::UK_VIEW_H;
use t27f::vf_uikit::UK_HDR_H;
use t27f::vf_uikit::UK_CARD_H;
use t27f::vf_style::MIN_TOUCH;

pub const HUD_W : u32 = @as(u32, UK_VIEW_W);
pub const HUD_H : u32 = @as(u32, UK_VIEW_H);
pub const HDR_H : u32 = @as(u32, UK_HDR_H);
pub const CARD_H : u32 = @as(u32, UK_CARD_H);
pub const CARD_N : u8 = 7;
pub const BTN_W : u32 = @as(u32, MIN_TOUCH);
pub const MENU_Y0 : u32 = 56;
pub const MENU_H : u32 = 756;
pub const PETAL_R : u32 = 14;
pub const WORLD_UNIVERSITY : u32 = 20;
pub const HIT_NONE : u8 = 255;
pub const HIT_MENU : u8 = 254;
pub const HIT_BACK : u8 = 253;
pub const UNIVERSITY_NAME : str = "UNIVERSITY";

/// Inclusive left/top, exclusive right/bottom.
pub fn in_rect(x: i64, y: i64, x0: u32, y0: u32, w: u32, h: u32) -> bool {
    const lx : i64 = @as(i64, x0);
    const ty : i64 = @as(i64, y0);
    if (x < lx or y < ty) { return false; }
    if (x >= lx + @as(i64, w)) { return false; }
    if (y >= ty + @as(i64, h)) { return false; }
    return true;
}

/// The HUD target under pixel (x, y): HIT_BACK, HIT_MENU, a card index 0..6, or HIT_NONE.
pub fn nav_hit(x: i64, y: i64) -> u8 {
    const w : i64 = @as(i64, HUD_W);
    const h : i64 = @as(i64, HUD_H);
    const hdr : i64 = @as(i64, HDR_H);
    const bw : i64 = @as(i64, BTN_W);
    if (x < 0 or y < 0 or x >= w or y >= h) { return HIT_NONE; }
    if (y < hdr) {
        if (x >= w - bw) { return HIT_MENU; }
        if (x < bw) { return HIT_BACK; }
        return HIT_NONE;
    }
    const idx : i64 = (y - hdr) / @as(i64, CARD_H);
    if (idx >= @as(i64, CARD_N)) { return HIT_NONE; }
    return @as(u8, @intCast(idx));
}

/// The petal under HUD pixel (x, y) when the menu overlay fills the area below the header.
pub fn menu_hit(x: i64, y: i64) -> u32 {
    const y0 : i64 = @as(i64, MENU_Y0);
    if (y < y0) { return PETAL_NONE; }
    return hit_px(x, y - y0, @as(i64, HUD_W), @as(i64, MENU_H));
}

/// Forward map box -> pixel, the inverse of to_box: px = origin + (b - centre) * scale / 1000000.
/// Origin is the viewport centre on that axis, scale is fit_permille(HUD_W, MENU_H).
pub fn petal_px(p: u32) -> i64 {
    if (p >= PETAL_COUNT) { return -1; }
    const s : i64 = fit_permille(@as(i64, HUD_W), @as(i64, MENU_H));
    return @as(i64, HUD_W) / 2 + (centre_x(p) - BOX_CX) * s / 1000000;
}

pub fn petal_py(p: u32) -> i64 {
    if (p >= PETAL_COUNT) { return -1; }
    const s : i64 = fit_permille(@as(i64, HUD_W), @as(i64, MENU_H));
    return @as(i64, MENU_Y0) + @as(i64, MENU_H) / 2 + (centre_y(p) - BOX_CY) * s / 1000000;
}

test header_buttons {
    assert nav_hit(10, 10) == HIT_BACK;
    assert nav_hit(360, 10) == HIT_MENU;
    assert nav_hit(187, 10) == HIT_NONE;
}

test card_rows {
    assert nav_hit(100, 56) == 0;
    assert nav_hit(100, 163) == 0;
    assert nav_hit(100, 164) == 1;
    assert nav_hit(100, 811) == 6;
}

test nav_outside_is_none {
    assert nav_hit(-1, 100) == HIT_NONE;
    assert nav_hit(375, 100) == HIT_NONE;
    assert nav_hit(100, 812) == HIT_NONE;
    assert nav_hit(100, -1) == HIT_NONE;
}

test button_edges {
    assert nav_hit(43, 55) == HIT_BACK;
    assert nav_hit(44, 55) == HIT_NONE;
    assert nav_hit(330, 55) == HIT_NONE;
    assert nav_hit(331, 55) == HIT_MENU;
}

test petal_round_trip {
    var p : u32 = 0;
    while (p < 27) {
        assert menu_hit(petal_px(p), petal_py(p)) == p;
        p = p + 1;
    }
}

test header_pixel_has_no_petal {
    assert menu_hit(187, 10) == PETAL_NONE;
    assert menu_hit(187, 55) == PETAL_NONE;
}

test petal_index_out_of_range {
    assert petal_px(27) == -1;
    assert petal_py(27) == -1;
}

// (0, MENU_Y0) is the top-left corner of the overlay, 187 px left of the triangle centre column
// and far outside the triangle (about 31 px per 100 box units), so no petal can be there.
test corner_has_no_petal {
    assert menu_hit(0, 56) == PETAL_NONE;
    assert menu_hit(374, 811) == PETAL_NONE;
}

test centres_inside_the_hud {
    var p : u32 = 0;
    while (p < 27) {
        assert petal_px(p) >= 0;
        assert petal_px(p) < 375;
        assert petal_py(p) >= 56;
        assert petal_py(p) < 812;
        p = p + 1;
    }
}

test in_rect_edges {
    assert in_rect(10, 20, 10, 20, 5, 5);
    assert in_rect(14, 24, 10, 20, 5, 5);
    assert in_rect(15, 24, 10, 20, 5, 5) == false;
    assert in_rect(14, 25, 10, 20, 5, 5) == false;
    assert in_rect(9, 20, 10, 20, 5, 5) == false;
    assert in_rect(10, 19, 10, 20, 5, 5) == false;
}

test constants_agree {
    assert HDR_H + MENU_H == HUD_H;
    assert MENU_Y0 == HDR_H;
    assert @as(u32, CARD_N) * CARD_H + HDR_H <= HUD_H;
}

test dims_come_from_the_kit {
    assert HUD_W == @as(u32, UK_VIEW_W);
    assert HUD_H == @as(u32, UK_VIEW_H);
    assert HDR_H == @as(u32, UK_HDR_H);
    assert CARD_H == @as(u32, UK_CARD_H);
    assert BTN_W == @as(u32, MIN_TOUCH);
    assert HUD_W == 375;
    assert BTN_W == 44;
}
