// SPDX-License-Identifier: Apache-2.0
; specs/course/lesson_01_style_main.t27 -- host program: the seven scenes of lesson 1 redrawn in OUR style at 375 (Refs
; Trinity-S-AI-DNA/t27#13251, ring 5; lesson 1 is t27#13238). LOCAL, not pushed: it builds only against the files of draft PR
; #13254 (T27F-007, another session, read only) as they stand in that session's local head 853db3e75b.
; --
; BEFORE is the frame of target/course/base/l01_<n>_<scene>.ppm: the 5x7 debug renderer of ring 5, rejected by the owner as
; "not our style", read back from disk byte for byte. AFTER is the same scene graph (specs/course/lesson_01_fpga_intro.t27,
; unchanged) with every number READ from Design Tokens v0.1 (the owner's pick, 2026-11-07) through vct_metrics of
; vf_card_tok; a status other than VTK_OK refuses and nothing is drawn. No number here is generated.
;   spacing (l1s_space), the mapping of vct_graph_with in vf_card_tok, which the lesson graphs follow:
;     the card: padding space.card.padding, gap space.field.group_gap;
;     a column stack or list: gap space.field.group_gap (the lesson has no label+input field stack, so its label sits a
;       group gap above its input, not space.field.label_gap: the same KNOWN gap as the task card specimen);
;     a row stack: gap space.action.gap.
;   widths: vcf_layout's own measure (vcf_overrides_w: the Outfit run of a text node plus the pen st.pad_x).
;   heights: a text node is at least its Outfit line box at the size vf_card paints it (OF_STRIP_H of OF_EM, rounded up),
;     never lower than the intrinsic VF_INTR_H; every other node keeps its intrinsic height.
;   paint: vc_render_s(vct_style(m)), theme TH_T27, the focused node of the scene drawn with the focus ring.
;   control.min_target is checked against the layout and reported, not applied, as vct_style says of it.
; KNOWN, reported per scene, not hidden:
;   vcf_overflow_count is a single-line metric (vf_card paints one line per node); l1s_wrap_text applies a post-render
;     Outfit word-wrap pass for multi-line nodes, clearing and redrawing via vt_draw_text; overflow counts reflect the
;     single-line layout, not the wrapped output;
;   badges and buttons are not measured by vcf_card_fit, so their text can run past their box (l1s_box_over);
;   a second home for the spacing mapping: the untracked task card specimen (vf_card_style_main.t27) has the same mapping in
;     vcs_apply. Both are local stand-ins for a token step over any graph that vf_card_tok does not have yet (requested from
;     the #13254 session); neither is pushed, and both go when that step lands.
; --
; THIS IS NOT A VISUAL-QUALITY CLAIM, and not "lesson 1 in the new style": the owner has not judged the task card frames,
; there are no 768/1280 frames, no second card type and no card-pair layout. The tests pin the tokens, the meaning, the
; frame shape, a repeatable render and a negative control. Whether AFTER is our style is the owner's verdict on the frames.
; --
; BUILD AND RUN (a heavy build: in a T27 OS pane, not on the Mac without the owner's word):
;   t27c gen specs/course/lesson_01_style_main.t27 > l1s.zig
;   zig build-exe l1s.zig -lc
;   mkdir -p target/course/ls
;   ./l1s 2> target/course/ls/sheet.txt
; Files: target/course/ls/l01_<n>_<scene>_{before,after,diff}.ppm (P6 375x812). A missing or short BEFORE file, an
; unopenable path or a short write exits 2; a token, render, PPM or diff refusal exits 1.
; Module-level vars are never spliced by `use`, so the byte buffers live here and are passed as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CourseLesson01StyleMain;

use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_LIST;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::DIR_ROW;
use t27f::visual_factory_contract::FOCUS;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout_m;
use t27f::vf_layout::vf_eff_direction;
use t27f::vf_layout::VF_INTR_H;
use t27f::vf_pixel::vf_overlap_count;
use t27f::vf_meaning::vf_kind_word;
use t27f::vf_meaning::vf_meaning_digest;
use t27f::vf_meaning::vf_spatial_digest;
use t27f::vf_diff::VfDiffBox;
use t27f::vf_diff::vf_diff_count;
use t27f::vf_diff::vf_diff_bbox;
use t27f::vf_diff::vf_diff_frame;
use t27f::vf_diff::VF_D_OK;
use t27f::frame_render::ppm_write_into;
use t27f::frame_render::FRAME_OK;
use t27f::vf_card::vc_render_s;
use t27f::vf_card::VcStyle;
use t27f::vf_card::VC_OK;
use t27f::vf_card::VC_NO_FOCUS;
use t27f::vf_card_fit::vcf_text_px;
use t27f::vf_card_fit::vcf_text_weight;
use t27f::vf_card_fit::vcf_overrides_w;
use t27f::vf_card_fit::vcf_overflow_count;
use t27f::vf_card_tok::VctMetrics;
use t27f::vf_card_tok::vct_metrics;
use t27f::vf_card_tok::vct_style;
use t27f::vf_tokens::VTK_OK;
use t27f::vf_theme::TH_T27;
use t27f::vf_type::vt_text_width_q8;
use t27f::vf_type::vt_draw_text;
use t27f::outfit_r_data::OF_EM;
use t27f::outfit_r_data::OF_STRIP_H;
use t27f::vf_card::vc_is_heading;
use t27f::vf_theme::TH_RGB_T27;
use t27f::vf_theme::TH_TEXT;
use t27f::vf_theme::TH_MUTED;
use t27f::vf_theme::TH_CAP_MILLI;
use course::lesson_01_fpga_intro::scene;
use course::lesson_01_fpga_intro::SCENE_COUNT;
use course::lesson_01_fpga_intro::SCENE_IDS;

pub var L1S_PPM_A : [913515]u8 = [0] ** 913515;
pub var L1S_RGB_A : [913500]u8 = [0] ** 913500;
pub var L1S_PPM_B : [913515]u8 = [0] ** 913515;
pub var L1S_RGB_B : [913500]u8 = [0] ** 913500;
pub var L1S_RGB_D : [913500]u8 = [0] ** 913500;

pub const L1S_W : u32 = 375;
pub const L1S_H : u32 = 812;
pub const L1S_PCT : u32 = 100;
pub const L1S_HDR : usize = 15;
pub const L1S_RGB : usize = 913500;
pub const L1S_BYTES : usize = 913515;
pub const L1S_MOD : u64 = 1000000007;

/// The spacing step: the Design Tokens by container kind, the mapping of vct_graph_with. Only padding and gap are set;
/// positions, sizes and every meaning field are never touched. A refused metrics changes nothing.
pub fn l1s_space(m: VctMetrics, g: VfGraph) -> VfGraph {
    var r : VfGraph = g;
    if m.status != VTK_OK {
        return r;
    }
    var i : u32 = 0;
    while i < r.node_count {
        if r.kind[i] == VF_CARD {
            r.padding[i] = m.padding;
            r.gap[i] = m.group_gap;
        }
        if r.kind[i] == VF_STACK or r.kind[i] == VF_LIST {
            if vf_eff_direction(r, i, 0) == DIR_ROW {
                r.gap[i] = m.action_gap;
            } else {
                r.gap[i] = m.group_gap;
            }
        }
        i = i + 1;
    }
    return r;
}

/// The Outfit line box at px design pixels: the glyph strip OF_STRIP_H of OF_EM, rounded up. A font metric, not a token.
pub fn l1s_line_h(px: u32) -> u32 {
    return (px * OF_STRIP_H + OF_EM - 1) / OF_EM;
}

/// Best-practice line height with leading: 1.4x for heading (px >= 20), 1.5x for body.
/// Multi-line block: l1s_line_h(px) + (n - 1) * l1s_line_height(px) for n wrapped lines.
pub fn l1s_line_height(px: u32) -> u32 {
    if px >= 20 {
        return (px * 14) / 10;
    }
    return (px * 15) / 10;
}

/// Wrapped line count for a text node: ceil(text_px_width / effective_width).
/// text_q8 is the Outfit advance in Q8 (vt_text_width_q8). content_w is the container width.
pub fn l1s_text_lines(text_q8: u32, content_w: u32, pad_x: u32) -> u32 {
    let eff : u32 = if content_w > pad_x + pad_x { content_w - pad_x - pad_x } else { 1 };
    let tw : u32 = (text_q8 + 255) / 256;
    if tw <= eff { return 1; }
    return (tw + eff - 1) / eff;
}

/// Fill a rectangle with black (0x000000) on the raster.
fn l1s_fill_black(rgb: []u8, vp_w: u32, vp_h: u32, x0: u32, y0: u32, x1: u32, y1: u32) -> void {
    var y : u32 = y0;
    while y < y1 and y < vp_h {
        var x : u32 = x0;
        while x < x1 and x < vp_w {
            let p : usize = (y * vp_w + x) * 3;
            rgb[p] = 0;
            rgb[p + 1] = 0;
            rgb[p + 2] = 0;
            x = x + 1;
        }
        y = y + 1;
    }
}

/// End (exclusive) of the longest Outfit run in s[start..] that fits max_q8 Q8 advance, breaking at a space.
/// When the rest fits, returns s.len. When no space fits, hard-breaks at the last fitting char.
fn l1s_outfit_break(s: str, start: u32, max_q8: u32, px: u32, weight: u32) -> u32 {
    let n : u32 = s.len as u32;
    if start >= n { return n; }
    if vt_text_width_q8(s[start..n], px, weight) <= max_q8 { return n; }
    var last_sp : u32 = n;
    var found : bool = false;
    var i : u32 = start + 1;
    while i <= n {
        if vt_text_width_q8(s[start..i], px, weight) > max_q8 { break; }
        if i < n and s[i] == 32 {
            last_sp = i;
            found = true;
        }
        i = i + 1;
    }
    if found { return last_sp; }
    if i <= start + 1 { return start + 1; }
    return i - 1;
}

/// Number of Outfit wrapped lines for s at px/weight in an effective width of eff pixels.
fn l1s_outfit_lines_cw(s: str, px: u32, weight: u32, eff: u32) -> u32 {
    let n : u32 = s.len as u32;
    if n == 0 or eff == 0 { return 1; }
    let max_q8 : u32 = eff * 256;
    var lines : u32 = 1;
    var start : u32 = 0;
    var going : bool = true;
    while going {
        let end : u32 = l1s_outfit_break(s, start, max_q8, px, weight);
        var next : u32 = end;
        while next < n and s[next] == 32 { next = next + 1; }
        if next >= n {
            going = false;
        } else {
            lines = lines + 1;
            start = next;
        }
    }
    return lines;
}

/// Baseline for the FIRST line of a text node at y0, as if the box were the single Outfit strip height.
/// Mirrors vc_baseline at pct=100, card_y=0, inset=TH_CARD_INSET.
fn l1s_first_baseline(y0: u32, px: u32) -> u32 {
    let single_h : u32 = l1s_line_h(px);
    let capm : u32 = px * TH_CAP_MILLI;
    let base : u32 = y0 + (single_h * 1000 + capm + 1000) / 2000;
    let cap_up : u32 = (capm + 999) / 1000;
    let lowest : u32 = 16 + cap_up;
    if base < lowest { return lowest; }
    return base;
}

/// Post-process: for each VF_TEXT node with more than one Outfit wrapped line, clear its area and
/// redraw all lines with vt_draw_text. Single-line nodes are already correct from vc_render_s.
fn l1s_wrap_text(g: VfGraph, l: VfLayout, rgb: []u8, st: VcStyle) -> void {
    var i : u32 = 0;
    while i < l.node_count {
        if g.kind[i] == VF_TEXT and g.text[i] != "" {
            let px : u32 = vcf_text_px(g, i, st);
            let weight : u32 = vcf_text_weight(g, i);
            let eff : u32 = if l.w[i] > st.pad_x + st.pad_x { l.w[i] - st.pad_x - st.pad_x } else { 0 };
            let lines : u32 = l1s_outfit_lines_cw(g.text[i], px, weight, eff);
            if lines > 1 {
                l1s_fill_black(rgb, L1S_W, L1S_H, l.x[i], l.y[i], l.x[i] + l.w[i], l.y[i] + l.h[i]);
                let color : u32 = if vc_is_heading(g, i) { TH_RGB_T27[TH_TEXT] } else { TH_RGB_T27[TH_MUTED] };
                let pen_px : u32 = l.x[i] + st.pad_x;
                let pen_q8 : u32 = if pen_px * 256 > st.inset * 256 { pen_px * 256 } else { st.inset * 256 };
                var base_y : u32 = l1s_first_baseline(l.y[i], px);
                let line_h : u32 = l1s_line_height(px);
                let max_q8 : u32 = eff * 256;
                let total : u32 = g.text[i].len as u32;
                var start : u32 = 0;
                var going : bool = true;
                while going {
                    let end : u32 = l1s_outfit_break(g.text[i], start, max_q8, px, weight);
                    _ = vt_draw_text(rgb, L1S_W, L1S_H, pen_q8, base_y, g.text[i][start..end], px, weight, color);
                    var next : u32 = end;
                    while next < total and g.text[i][next] == 32 { next = next + 1; }
                    if next >= total {
                        going = false;
                    } else {
                        start = next;
                        base_y = base_y + line_h;
                    }
                }
            }
        }
        i = i + 1;
    }
}

/// The height overrides for vf_layout_m: the Outfit multi-line height of every text node whose computed
/// height is taller than the intrinsic, 0 (keep the intrinsic) for every other node.
/// Effective width estimate: L1S_W - 2*inset - 2*pad_x (conservative, correct for card-level children at 375 px).
pub fn l1s_heights(g: VfGraph, st: VcStyle) -> [16]u32 {
    var oh : [16]u32 = [0; 16];
    let eff : u32 = if L1S_W > st.inset + st.inset + st.pad_x + st.pad_x {
        L1S_W - st.inset - st.inset - st.pad_x - st.pad_x
    } else { 0 };
    var i : u32 = 0;
    while i < g.node_count and i < 16 {
        if g.kind[i] == VF_TEXT and g.text[i] != "" {
            let px : u32 = vcf_text_px(g, i, st);
            let weight : u32 = vcf_text_weight(g, i);
            let lines : u32 = l1s_outfit_lines_cw(g.text[i], px, weight, eff);
            let lh : u32 = if lines <= 1 {
                l1s_line_h(px)
            } else {
                l1s_line_h(px) + (lines - 1) * l1s_line_height(px)
            };
            if lh > VF_INTR_H[VF_TEXT] {
                oh[i] = lh;
            }
        }
        i = i + 1;
    }
    return oh;
}

/// The AFTER layout of g: the spacing step, then vf_layout_m with vcf_card_fit's widths and the line-box heights.
pub fn l1s_layout(m: VctMetrics, g: VfGraph) -> VfLayout {
    let st : VcStyle = vct_style(m);
    return vf_layout_m(g, vcf_overrides_w(g, st), l1s_heights(g, st));
}

/// The node of g in the FOCUS state, VC_NO_FOCUS when there is none.
pub fn l1s_focus(g: VfGraph) -> u32 {
    var i : u32 = 0;
    while i < g.node_count {
        if g.state[i] == FOCUS {
            return i;
        }
        i = i + 1;
    }
    return VC_NO_FOCUS;
}

/// Lint: how many badges and buttons carry a text whose Outfit run plus the pen on both sides is wider than their box
/// (vcf_card_fit measures text nodes only).
pub fn l1s_box_over(g: VfGraph, l: VfLayout, st: VcStyle) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < l.node_count {
        if (g.kind[i] == VF_BADGE or g.kind[i] == VF_BUTTON) and g.text[i] != "" {
            let q8 : u32 = vt_text_width_q8(g.text[i], vcf_text_px(g, i, st), vcf_text_weight(g, i));
            if (q8 + 255) / 256 + st.pad_x + st.pad_x > l.w[i] {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

/// Lint: how many inputs and buttons are laid out lower than control.min_target.
pub fn l1s_under_target(g: VfGraph, l: VfLayout, m: VctMetrics) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < l.node_count {
        if (g.kind[i] == VF_BUTTON or g.kind[i] == VF_INPUT) and l.h[i] < m.min_target {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// Paint scene graph g (already spaced) into L1S_RGB_B and its P6 into L1S_PPM_B; VC_OK, or the refusal.
/// After vc_render_s draws each text node's first line, l1s_wrap_text clears and redraws multi-line nodes.
pub fn l1s_render(m: VctMetrics, g: VfGraph) -> u32 {
    let l : VfLayout = l1s_layout(m, g);
    let st : VcStyle = vct_style(m);
    let r : u32 = vc_render_s(g, l, &L1S_RGB_B, L1S_W, L1S_H, L1S_PCT, TH_T27, l1s_focus(g), st);
    if r != VC_OK {
        return r;
    }
    l1s_wrap_text(g, l, &L1S_RGB_B, st);
    if ppm_write_into(&L1S_PPM_B, &L1S_RGB_B, L1S_W, L1S_H) != FRAME_OK {
        return 1;
    }
    return VC_OK;
}

/// A fingerprint of the P6 file in L1S_PPM_B: h = (h * 31 + byte) mod 1000000007, header included.
pub fn l1s_digest() -> u64 {
    var h : u64 = 0;
    var i : usize = 0;
    while i < L1S_BYTES {
        h = (h * 31 + (L1S_PPM_B[i] as u64)) % L1S_MOD;
        i = i + 1;
    }
    return h;
}

pub fn main() void {
    const m : VctMetrics = vct_metrics();
    if (m.status != VTK_OK) {
        std.debug.print("l1s: Design Tokens refused, status {d}; nothing drawn\n", .{m.status});
        std.c.exit(1);
    }
    const st : VcStyle = vct_style(m);
    std.debug.print("lesson 1 in the vf_card painter at 375x812, Design Tokens v0.1 via vct_metrics (draft PR #13254, local head 853db3e75b)\n", .{});
    std.debug.print("tokens: padding {d} group_gap {d} action_gap {d} label_gap {d} head_px {d} body_px {d} min_target {d} border {d} pad_x {d} max_inline {d}\n", .{ m.padding, m.group_gap, m.action_gap, m.label_gap, m.head_px, m.body_px, m.min_target, m.border, st.pad_x, m.max_inline });
    var s : u8 = 0;
    while (s < SCENE_COUNT) {
        var pb : [*:0]const u8 = "target/course/base/l01_0_hook.ppm";
        var p0 : [*:0]const u8 = "target/course/ls/l01_0_hook_before.ppm";
        var p1 : [*:0]const u8 = "target/course/ls/l01_0_hook_after.ppm";
        var p2 : [*:0]const u8 = "target/course/ls/l01_0_hook_diff.ppm";
        if (s == 1) { pb = "target/course/base/l01_1_visual.ppm"; p0 = "target/course/ls/l01_1_visual_before.ppm"; p1 = "target/course/ls/l01_1_visual_after.ppm"; p2 = "target/course/ls/l01_1_visual_diff.ppm"; }
        if (s == 2) { pb = "target/course/base/l01_2_predict.ppm"; p0 = "target/course/ls/l01_2_predict_before.ppm"; p1 = "target/course/ls/l01_2_predict_after.ppm"; p2 = "target/course/ls/l01_2_predict_diff.ppm"; }
        if (s == 3) { pb = "target/course/base/l01_3_poke.ppm"; p0 = "target/course/ls/l01_3_poke_before.ppm"; p1 = "target/course/ls/l01_3_poke_after.ppm"; p2 = "target/course/ls/l01_3_poke_diff.ppm"; }
        if (s == 4) { pb = "target/course/base/l01_4_explain.ppm"; p0 = "target/course/ls/l01_4_explain_before.ppm"; p1 = "target/course/ls/l01_4_explain_after.ppm"; p2 = "target/course/ls/l01_4_explain_diff.ppm"; }
        if (s == 5) { pb = "target/course/base/l01_5_transfer.ppm"; p0 = "target/course/ls/l01_5_transfer_before.ppm"; p1 = "target/course/ls/l01_5_transfer_after.ppm"; p2 = "target/course/ls/l01_5_transfer_diff.ppm"; }
        if (s == 6) { pb = "target/course/base/l01_6_prove.ppm"; p0 = "target/course/ls/l01_6_prove_before.ppm"; p1 = "target/course/ls/l01_6_prove_after.ppm"; p2 = "target/course/ls/l01_6_prove_diff.ppm"; }

        const fb = std.c.fopen(pb, "rb");
        if (fb == null) {
            std.debug.print("l1s: cannot open BEFORE {s}\n", .{pb});
            std.c.exit(2);
        }
        const rn : usize = std.c.fread(@ptrCast(&L1S_PPM_A), 1, L1S_BYTES, fb.?);
        _ = std.c.fclose(fb.?);
        if (rn != L1S_BYTES) {
            std.debug.print("l1s: short read of {s}: {d} of {d} bytes\n", .{ pb, rn, L1S_BYTES });
            std.c.exit(2);
        }

        const g0 : VfGraph = scene(s);
        const g : VfGraph = l1s_space(m, g0);
        const l : VfLayout = l1s_layout(m, g);
        if (l1s_render(m, g) != VC_OK) {
            std.debug.print("l1s: scene {d} AFTER render refused\n", .{s});
            std.c.exit(1);
        }
        var k : usize = 0;
        var hdr_ok : bool = true;
        while (k < L1S_HDR) {
            if (L1S_PPM_A[k] != L1S_PPM_B[k]) { hdr_ok = false; }
            k += 1;
        }
        if (!hdr_ok) {
            std.debug.print("l1s: BEFORE {s} is not a P6 375x812 frame\n", .{pb});
            std.c.exit(2);
        }
        k = 0;
        while (k < L1S_RGB) {
            L1S_RGB_A[k] = L1S_PPM_A[k + L1S_HDR];
            k += 1;
        }
        if (vf_diff_frame(&L1S_RGB_A, &L1S_RGB_B, &L1S_RGB_D, L1S_W, L1S_H) != VF_D_OK) {
            std.debug.print("l1s: scene {d} diff refused\n", .{s});
            std.c.exit(1);
        }
        var f : u8 = 0;
        while (f < 3) {
            var path : [*:0]const u8 = p0;
            if (f == 1) { path = p1; }
            if (f == 2) { path = p2; }
            const fp = std.c.fopen(path, "wb");
            if (fp == null) {
                std.debug.print("l1s: cannot open {s} for writing\n", .{path});
                std.c.exit(2);
            }
            var wn : usize = 0;
            if (f == 0) { wn = std.c.fwrite(@ptrCast(&L1S_PPM_A), 1, L1S_BYTES, fp.?); }
            if (f == 1) { wn = std.c.fwrite(@ptrCast(&L1S_PPM_B), 1, L1S_BYTES, fp.?); }
            if (f == 2) {
                wn = std.c.fwrite(@ptrCast(&L1S_PPM_B), 1, L1S_HDR, fp.?);
                wn += std.c.fwrite(@ptrCast(&L1S_RGB_D), 1, L1S_RGB, fp.?);
            }
            _ = std.c.fclose(fp.?);
            if (wn != L1S_BYTES) {
                std.debug.print("l1s: short write to {s}: {d} of {d} bytes\n", .{ path, wn, L1S_BYTES });
                std.c.exit(2);
            }
            f += 1;
        }
        const bx : VfDiffBox = vf_diff_bbox(&L1S_RGB_A, &L1S_RGB_B, L1S_W, L1S_H);
        std.debug.print("scene {d} {s}: wrote before/after/diff to target/course/ls, after digest {d}\n", .{ s, SCENE_IDS[s], l1s_digest() });
        std.debug.print("  diff {d} pixels, bbox {d},{d}-{d},{d} (a count, not a quality score)\n", .{ vf_diff_count(&L1S_RGB_A, &L1S_RGB_B, L1S_W, L1S_H), bx.x0, bx.y0, bx.x1, bx.y1 });
        std.debug.print("  meaning {d} -> {d}; spatial after {d}; card {d}x{d}\n", .{ vf_meaning_digest(g0), vf_meaning_digest(g), vf_spatial_digest(g, l), l.w[0], l.h[0] });
        std.debug.print("  overlap {d}, text overflow {d}, badge/button text over {d}, controls under min_target {d}, focus node {d}\n", .{ vf_overlap_count(g, l), vcf_overflow_count(g, l, st), l1s_box_over(g, l, st), l1s_under_target(g, l, m), l1s_focus(g) });
        std.debug.print("  layout: node kind x,y wxh pad gap [text]\n", .{});
        var j : u32 = 0;
        while (j < l.node_count) {
            std.debug.print("    {d} {s} {d},{d} {d}x{d} pad {d} gap {d} [{s}]\n", .{ j, vf_kind_word(g, j), l.x[j], l.y[j], l.w[j], l.h[j], g.padding[j], g.gap[j], g.text[j] });
            j += 1;
        }
        s += 1;
    }
    std.debug.print("l1s: frames are unseen; the owner judges the style on before, after and diff; this sheet claims no visual quality\n", .{});
}

test the_design_tokens_resolve {
    let m : VctMetrics = vct_metrics();
    assert m.status == VTK_OK;
    assert m.padding == 16;
    assert m.group_gap == 16;
    assert m.action_gap == 10;
    assert m.head_px == 26;
    assert m.min_target == 24;
}

test the_spacing_step_sets_tokens_and_keeps_the_meaning {
    let m : VctMetrics = vct_metrics();
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g0 : VfGraph = scene(s);
        let g : VfGraph = l1s_space(m, g0);
        assert g.node_count == g0.node_count;
        assert g.padding[0] == m.padding;
        assert g.gap[0] == m.group_gap;
        assert vf_meaning_digest(g) == vf_meaning_digest(g0);
        s = s + 1;
    }
}

test a_row_stack_takes_the_action_gap {
    let m : VctMetrics = vct_metrics();
    var g : VfGraph = scene(0);
    g.direction[1] = DIR_ROW;
    let r : VfGraph = l1s_space(m, g);
    assert r.gap[1] == m.action_gap;
    let c : VfGraph = l1s_space(m, scene(0));
    assert c.gap[1] == m.group_gap;
}

test the_line_box_follows_the_outfit_strip {
    assert l1s_line_h(26) == 29;
    assert l1s_line_h(16) == 18;
    let m : VctMetrics = vct_metrics();
    let g : VfGraph = l1s_space(m, scene(0));
    let l : VfLayout = l1s_layout(m, g);
    // node 2 is the hook heading: 83 chars at 26 px bold do not fit one line at 375 px, so multi-line height > 29
    assert l.h[2] > l1s_line_h(26);
    // node 3 is hook body text (60 chars at 16 px): also wraps, height above the 20 px intrinsic
    assert l.h[3] > VF_INTR_H[VF_TEXT];
}

test every_scene_renders_in_the_card_painter {
    let m : VctMetrics = vct_metrics();
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = l1s_space(m, scene(s));
        assert l1s_render(m, g) == VC_OK;
        assert L1S_PPM_B[0] == 80;
        assert L1S_PPM_B[1] == 54;
        s = s + 1;
    }
}

test the_focus_is_the_scene_focus {
    assert l1s_focus(scene(0)) == 4;
    assert l1s_focus(scene(3)) == 3;
    var g : VfGraph = scene(0);
    g.state[4] = 0;
    assert l1s_focus(g) == VC_NO_FOCUS;
}

test a_render_repeats_byte_for_byte {
    let m : VctMetrics = vct_metrics();
    let g : VfGraph = l1s_space(m, scene(3));
    assert l1s_render(m, g) == VC_OK;
    let first : u64 = l1s_digest();
    assert l1s_render(m, g) == VC_OK;
    assert l1s_digest() == first;
}

test best_practice_line_heights_are_correct {
    assert l1s_line_height(26) == 36;
    assert l1s_line_height(16) == 24;
    assert l1s_line_height(22) == 30;
    assert l1s_line_height(14) == 21;
    assert l1s_line_height(20) == 28;
}

test heading_text_requires_multiple_wrapped_lines {
    // hook heading "This board's FPGA...": 83 chars at 26px bold, 331px effective width.
    // This test documents that wrapping is structurally required by the lesson text at 375px.
    let m : VctMetrics = vct_metrics();
    let g : VfGraph = l1s_space(m, scene(0));
    let st : VcStyle = vct_style(m);
    let cw : u32 = L1S_W - m.padding - m.padding;
    let q8 : u32 = vt_text_width_q8(g.text[2], vcf_text_px(g, 2, st), vcf_text_weight(g, 2));
    let n : u32 = l1s_text_lines(q8, cw, st.pad_x);
    assert n >= 2;
    assert l1s_text_lines(0, cw, st.pad_x) == 1;
}

test a_refused_metrics_changes_and_draws_nothing {
    // negative control: a metrics with a refusal status leaves the graph as it was, and the painter refuses its style
    var bad : VctMetrics = vct_metrics();
    bad.status = 1;
    let g0 : VfGraph = scene(0);
    let g : VfGraph = l1s_space(bad, g0);
    assert g.padding[0] == g0.padding[0];
    assert g.gap[0] == g0.gap[0];
    var zero : VctMetrics = vct_metrics();
    zero.head_px = 0;
    zero.body_px = 0;
    assert l1s_render(zero, l1s_space(zero, g0)) != VC_OK;
}

test the_tokens_move_the_first_child {
    // negative control for the spacing step: without it the body stack sits at the card edge, with it 16 px in
    let m : VctMetrics = vct_metrics();
    let g0 : VfGraph = scene(0);
    let a : VfLayout = l1s_layout(m, g0);
    let b : VfLayout = l1s_layout(m, l1s_space(m, g0));
    assert a.x[1] == 0;
    assert b.x[1] == m.padding;
    assert b.y[1] == m.padding;
}
