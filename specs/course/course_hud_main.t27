// SPDX-License-Identifier: Apache-2.0
// specs/course/course_hud_main.t27 -- host program: FPGA course HUD at 375x812.
//
// Shows the full course overview with Lesson 1 (7 scenes) PENDING_APPROVAL.
// Design: BW palette (#000 background, #FFF primary, #888 muted), Outfit font,
// Design Tokens v0.1 (pad=16, body_px=16, head_px=26).
//
// BUILD (heavy: in a T27 OS pane, not on this Mac):
//   t27c gen specs/course/course_hud_main.t27 > chm.zig
//   zig build-exe chm.zig -lc ...  (same closure as lesson_01_style_main.t27)
//   ./chm > target/course/hud/course_hud.ppm
//   sips -s format png target/course/hud/course_hud.ppm --out target/course/hud/course_hud.png
//
// CLOSURE (from draft PR #13254, 853db3e75b snapshot -- same as lesson_01_style_main.t27):
//   specs/t27f/vf_type.t27, specs/t27f/outfit_r_data.t27, specs/t27f/outfit_b_data.t27
//   (and the vf_card family, but only vf_type/outfit_r_data are imported here directly)
//
// Refs #13251. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module course_hud_main;

use t27f::vf_type::vt_draw_text;
use t27f::vf_type::vt_text_width_q8;
use t27f::outfit_r_data::OF_EM;
use t27f::outfit_r_data::OF_STRIP_H;
use t27f::frame_render::ppm_write_into;
use t27f::frame_render::FRAME_OK;

pub const HUD_W : u32 = 375;
pub const HUD_H : u32 = 812;

// Design Tokens v0.1
const PAD : u32 = 16;
const GAP : u32 = 10;
const HEAD_PX : u32 = 26;
const BODY_PX : u32 = 16;
const SMALL_PX : u32 = 12;
const W_REGULAR : u32 = 400;
const W_BOLD : u32 = 700;
const CAP_MILLI : u32 = 700;

// Colors (packed RGB u32)
const COL_WHITE : u32 = 0xFFFFFF;
const COL_MUTED : u32 = 0x888888;
const COL_LINE  : u32 = 0x333333;

// Layout constants (all pixel units)
const HEADER_Y    : u32 = 16;
const SUB_Y       : u32 = 55;
const DIV1_Y      : u32 = 73;
const SERIES_Y    : u32 = 83;
const TITLE_Y     : u32 = 103;
const PROG_Y      : u32 = 130;
const STATUS_Y    : u32 = 142;
const DIV2_Y      : u32 = 160;
const SCENE_START : u32 = 169;
const CARD_H      : u32 = 86;
const FOOTER_Y    : u32 = 783;

// PPM output buffer (ppm_len(375, 812) = 15 + 3*375*812 = 913515)
pub var HUD_PPM : [913515]u8 = [0; 913515];

// Scene count and scene data (from lesson_01_fpga_intro context)
const L1_SCENE_COUNT : u32 = 7;
const L1_IDS : [7]str = ["HOOK", "VISUAL", "PREDICT", "POKE", "EXPLAIN", "TRANSFER", "PROVE"];
const L1_DESC : [7]str = [
    "LUT count vs logic cells on the AX7203",
    "Board: ALINX AX7203, XC7A200T FBG484",
    "How many input patterns does a LUT6 have?",
    "Toggle 6 inputs on an AND gate in one LUT",
    "Slices, LUT6s, and logic cells: the math",
    "Count LUTs in an unseen design (1.6x ratio)",
    "Predict 269,200 from ax7203.t27 constants",
];

// strip height for a given font size (Outfit strip = OF_STRIP_H / OF_EM)
pub fn line_h(px: u32) -> u32 {
    return OF_STRIP_H * px / OF_EM;
}

// baseline offset from box top (centering cap height in the strip)
pub fn baseline_in_strip(px: u32) -> u32 {
    let h : u32 = line_h(px);
    let cap : u32 = px * CAP_MILLI;
    return (h * 1000 + cap + 1000) / 2000;
}

// fill a rectangle with a solid color
fn hud_fill(rgb: []u8, x0: u32, y0: u32, x1: u32, y1: u32, r: u8, g: u8, b: u8) -> void {
    var y : u32 = y0;
    while y < y1 and y < HUD_H {
        var x : u32 = x0;
        while x < x1 and x < HUD_W {
            let p : usize = (y * HUD_W + x) * 3;
            rgb[p]     = r;
            rgb[p + 1] = g;
            rgb[p + 2] = b;
            x = x + 1;
        }
        y = y + 1;
    }
}

// draw a 1 px horizontal divider line
fn hud_line(rgb: []u8, y: u32, x0: u32, x1: u32) -> void {
    hud_fill(rgb, x0, y, x1, y + 1, 51, 51, 51);
}

// draw text at pixel (x, y_box_top); baseline computed from px
fn hud_text(rgb: []u8, x: u32, y_top: u32, s: str, px: u32, wt: u32, col: u32) -> u32 {
    let base : u32 = y_top + baseline_in_strip(px);
    return vt_draw_text(rgb, HUD_W, HUD_H, x * 256, base, s, px, wt, col);
}

// draw a progress bar: filled_w of bar_w pixels
fn hud_bar(rgb: []u8, x: u32, y: u32, bar_w: u32, filled_w: u32) -> void {
    // unfilled track
    hud_fill(rgb, x, y, x + bar_w, y + 3, 51, 51, 51);
    // filled portion
    if filled_w > 0 {
        hud_fill(rgb, x, y, x + filled_w, y + 3, 255, 255, 255);
    }
}

pub fn hud_render(rgb: []u8) -> void {
    // black background (pre-filled by zero array, but explicit for clarity)
    hud_fill(rgb, 0, 0, HUD_W, HUD_H, 0, 0, 0);

    // header: "FPGA 101" (heading, white, bold)
    _ = hud_text(rgb, PAD, HEADER_Y, "FPGA 101", HEAD_PX, W_BOLD, COL_WHITE);

    // subtitle: "DISCOVER . BUILD . VERIFY"
    _ = hud_text(rgb, PAD, SUB_Y, "DISCOVER . BUILD . VERIFY", SMALL_PX, W_REGULAR, COL_MUTED);

    // divider
    hud_line(rgb, DIV1_Y, PAD, HUD_W - PAD);

    // series label: "SERIES 1 OF 1" (muted)
    _ = hud_text(rgb, PAD, SERIES_Y, "SERIES 1 OF 1", SMALL_PX, W_REGULAR, COL_MUTED);

    // lesson title: "What is an FPGA?" (body, bold, white)
    _ = hud_text(rgb, PAD, TITLE_Y, "What is an FPGA?", BODY_PX, W_BOLD, COL_WHITE);

    // progress bar: 0 of 7 scenes complete
    hud_bar(rgb, PAD, PROG_Y, HUD_W - PAD - PAD, 0);

    // status text
    _ = hud_text(rgb, PAD, STATUS_Y, "0 / 7  PENDING APPROVAL", SMALL_PX, W_REGULAR, COL_MUTED);

    // divider
    hud_line(rgb, DIV2_Y, PAD, HUD_W - PAD);

    // scene cards
    var i : u32 = 0;
    while i < L1_SCENE_COUNT {
        let card_top : u32 = SCENE_START + i * CARD_H;

        // scene number + scene ID: "1  HOOK" (body, bold, white)
        let num_w : u32 = vt_text_width_q8("0", BODY_PX, W_BOLD) / 256 + 8;
        let num_str : str = if i == 0 { "1" }
                       else if i == 1 { "2" }
                       else if i == 2 { "3" }
                       else if i == 3 { "4" }
                       else if i == 4 { "5" }
                       else if i == 5 { "6" }
                       else { "7" };
        _ = hud_text(rgb, PAD, card_top, num_str, BODY_PX, W_BOLD, COL_MUTED);
        _ = hud_text(rgb, PAD + num_w + 8, card_top, L1_IDS[i], BODY_PX, W_BOLD, COL_WHITE);

        // scene description (small, muted)
        _ = hud_text(rgb, PAD, card_top + 24, L1_DESC[i], SMALL_PX, W_REGULAR, COL_MUTED);

        // status dot: "o  pending" (small, muted)
        _ = hud_text(rgb, PAD, card_top + 44, "o  pending", SMALL_PX, W_REGULAR, COL_MUTED);

        // card divider (not drawn for last card)
        if i < L1_SCENE_COUNT - 1 {
            hud_line(rgb, card_top + CARD_H - 2, PAD, HUD_W - PAD);
        }

        i = i + 1;
    }

    // footer: PR + CI status
    hud_line(rgb, FOOTER_Y - 8, PAD, HUD_W - PAD);
    _ = hud_text(rgb, PAD, FOOTER_Y, "PR #13286  CI RUNNING", SMALL_PX, W_REGULAR, COL_MUTED);
}

pub fn main() -> void {
    var rgb : [375 * 812 * 3]u8 = [0; 375 * 812 * 3];
    hud_render(rgb);
    if ppm_write_into(&HUD_PPM, rgb, HUD_W, HUD_H) != FRAME_OK {
        std.c.exit(1);
    }
    const fp = std.c.fopen("/dev/stdout", "wb");
    if (fp == null) { std.c.exit(2); }
    const wn = std.c.fwrite(@ptrCast(&HUD_PPM), 1, 913515, fp.?);
    _ = std.c.fclose(fp.?);
    if (wn != 913515) { std.c.exit(2); }
}

// ---------------------------------------------------------------- tests

test hud_dimensions_are_375_812 {
    assert HUD_W == 375;
    assert HUD_H == 812;
}

test body_strip_height_is_17 {
    // 88 * 16 / 80 = 17 (integer)
    let h : u32 = line_h(BODY_PX);
    assert h == 17;
}

test head_strip_height_is_28 {
    // 88 * 26 / 80 = 28 (integer)
    let h : u32 = line_h(HEAD_PX);
    assert h == 28;
}

test body_baseline_is_14 {
    // (17 * 1000 + 16 * 700 + 1000) / 2000 = 29200 / 2000 = 14
    let b : u32 = baseline_in_strip(BODY_PX);
    assert b == 14;
}

test head_baseline_is_23 {
    // (28 * 1000 + 26 * 700 + 1000) / 2000 = 47200 / 2000 = 23
    let b : u32 = baseline_in_strip(HEAD_PX);
    assert b == 23;
}

test seven_scene_cards_fit_in_hud {
    let last_card_bottom : u32 = SCENE_START + L1_SCENE_COUNT * CARD_H;
    assert last_card_bottom <= FOOTER_Y;
}

test l1_scene_count_is_7 {
    assert L1_SCENE_COUNT == 7;
}

test card_h_gives_room_for_three_rows {
    // each card has: title (body=17), desc (small=13), status (small=13) + divider
    let content_h : u32 = line_h(BODY_PX) + 24 + line_h(SMALL_PX) + 20 + line_h(SMALL_PX);
    assert content_h <= CARD_H;
}
