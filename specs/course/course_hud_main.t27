// scene names and descriptions
const L1_IDS  : [7]str = ["HOOK", "VISUAL", "PREDICT", "POKE", "EXPLAIN", "TRANSFER", "PROVE"];
const L1_DESC : [7]str = [
    "LUT count vs logic cells",
    "AX7203 board overview",
    "LUT6 input patterns?",
    "Toggle 6 AND gate inputs",
    "Slices, LUT6s, the math",
    "Count LUTs from a design",
    "Predict 269,200 from spec",
];
const L1_NUMS : [7]str = ["1", "2", "3", "4", "5", "6", "7"];

// strip height for a given font size (Outfit: OF_STRIP_H / OF_EM per px)
pub fn strip_h(px: u32) -> u32 {
    return OF_STRIP_H * px / OF_EM;
}

// baseline from box top (cap height centred in strip, CAP_MILLI = 700)
pub fn baseline_in_strip(px: u32) -> u32 {
    let h   : u32 = strip_h(px);
    let cap : u32 = px * CAP_MILLI;
    return (h * 1000 + cap + 1000) / 2000;
}

// fill a rectangle with a packed RGB colour
fn fill(rgb: []u8, x0: u32, y0: u32, x1: u32, y1: u32, col: u32) -> void {
    let r : u8 = @as(u8, @intCast((col >> 16) & 255));
    let g : u8 = @as(u8, @intCast((col >>  8) & 255));
    let b : u8 = @as(u8, @intCast( col        & 255));
    var y : u32 = y0;
    while y < y1 and y < HUD_H {
        var x : u32 = x0;
        while x < x1 and x < HUD_W {
            let p : usize = (y * HUD_W + x) * 3;
            rgb[p]     = r;
            rgb[p + 1] = g;
            rgb[p + 2] = b;
            x = x + 1;
        }
        y = y + 1;
    }
}

// horizontal 1px rule
fn hline(rgb: []u8, y: u32, x0: u32, x1: u32, col: u32) -> void {
    fill(rgb, x0, y, x1, y + 1, col);
}

// draw text with baseline computed from box top
fn txt(rgb: []u8, x: u32, y_top: u32, s: str, px: u32, wt: u32, col: u32) -> u32 {
    let base : u32 = y_top + baseline_in_strip(px);
    return vt_draw_text(rgb, HUD_W, HUD_H, x * 256, base, s, px, wt, col);
}

// blit a 24x52 RGB thumbnail at 2x nearest-neighbour into (bx, by), clipped to THD_H rows
fn blit_thumb(rgb: []u8, pix: []const u8, bx: u32, by: u32) -> void {
    var sy : u32 = 0;
    while sy * 2 < THD_H and sy < TH_H {
        var sx : u32 = 0;
        while sx < TH_W {
            let pi  : usize = (sy * TH_W + sx) * 3;
            let r   : u8 = pix[pi];
            let g   : u8 = pix[pi + 1];
            let b   : u8 = pix[pi + 2];
            let ox0 : u32 = bx + sx * 2;
            let oy0 : u32 = by + sy * 2;
            let ox1 : u32 = ox0 + 1;
            let oy1 : u32 = oy0 + 1;
            let i00 : usize = (oy0 * HUD_W + ox0) * 3;
            let i01 : usize = (oy0 * HUD_W + ox1) * 3;
            let i10 : usize = (oy1 * HUD_W + ox0) * 3;
            let i11 : usize = (oy1 * HUD_W + ox1) * 3;
            rgb[i00]     = r;  rgb[i00 + 1] = g;  rgb[i00 + 2] = b;
            rgb[i01]     = r;  rgb[i01 + 1] = g;  rgb[i01 + 2] = b;
            rgb[i10]     = r;  rgb[i10 + 1] = g;  rgb[i10 + 2] = b;
            rgb[i11]     = r;  rgb[i11 + 1] = g;  rgb[i11 + 2] = b;
            sx = sx + 1;
        }
        sy = sy + 1;
    }
}

// thumbnail (or muted placeholder) of one scene at (tx, ty)
fn draw_thumb_at(rgb: []u8, scene: u32, tx: u32, ty: u32) -> void {
    if scene == 0 {
        blit_thumb(rgb, &HOOK_PIX, tx, ty);
    } else if scene == 4 {
        blit_thumb(rgb, &EXPLAIN_PIX, tx, ty);
    } else if scene == 6 {
        blit_thumb(rgb, &PROVE_PIX, tx, ty);
    } else {
        fill(rgb, tx, ty, tx + THD_W, ty + THD_H, C_PLH);
    }
}

// right-column of a card: real thumbnail for HOOK/EXPLAIN/PROVE, placeholder for others
fn draw_right(rgb: []u8, scene: u32, cy: u32) -> void {
    draw_thumb_at(rgb, scene, HUD_W - TK_PAD - THD_W, cy + TK_PAD);
}

// filled disc: every pixel of the bounding square with dx*dx + dy*dy <= r*r (clipped to the frame)
fn disc(rgb: []u8, cx: i64, cy: i64, r: i64, col: u32) -> void {
    var dy : i64 = 0 - r;
    while dy <= r {
        var dx : i64 = 0 - r;
        while dx <= r {
            if dx * dx + dy * dy <= r * r {
                let px : i64 = cx + dx;
                let py : i64 = cy + dy;
                if px >= 0 and py >= 0 and px < @as(i64, HUD_W) and py < @as(i64, HUD_H) {
                    let ux : u32 = @as(u32, @intCast(px));
                    let uy : u32 = @as(u32, @intCast(py));
                    fill(rgb, ux, uy, ux + 1, uy + 1, col);
                }
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

// draw text and return the x (pixels) where the next piece starts
fn put(rgb: []u8, x: u32, y_top: u32, s: str, px: u32, wt: u32, col: u32) -> u32 {
    let st : u32 = txt(rgb, x, y_top, s, px, wt, col);
    return x + vt_text_width_q8(s, px, wt) / 256;
}

// decimal figures of v, one glyph at a time; returns the x after the last figure
fn draw_u32(rgb: []u8, x: u32, y_top: u32, v: u32, px: u32, wt: u32, col: u32) -> u32 {
    var d : u32 = 1;
    while v / d >= 10 {
        d = d * 10;
    }
    var cx : u32 = x;
    while d > 0 {
        let dg : u32 = (v / d) % 10;
        cx = put(rgb, cx, y_top, DIGITS[dg], px, wt, col);
        d = d / 10;
    }
    return cx;
}

// the menu button: a touch-height kit button flush right, centred in the header (label width = BTN_W less both pads)
fn menu_btn() -> UiRect {
    return button_rect(@as(i32, HUD_W - BTN_W), (UK_HDR_H - MIN_TOUCH) / 2, MIN_TOUCH - 2 * PAD_ROW, true);
}

// menu glyph: white disc r8 centred in the 44x56 zone at the header's right end
fn menu_glyph(rgb: []u8) -> void {
    let b : UiRect = menu_btn();
    disc(rgb, @as(i64, b.x + b.w / 2), @as(i64, b.y + b.h / 2), 8, C_TXT);
}

// 1px frame of the rectangle [x0,x1) x [y0,y1)
fn frame_rect(rgb: []u8, x0: u32, y0: u32, x1: u32, y1: u32, col: u32) -> void {
    fill(rgb, x0, y0, x1, y0 + 1, col);
    fill(rgb, x0, y1 - 1, x1, y1, col);
    fill(rgb, x0, y0, x0 + 1, y1, col);
    fill(rgb, x1 - 1, y0, x1, y1, col);
}

// header of the inner screens: back chevron, title (heading), subtitle (caption), border
fn inner_header(rgb: []u8, title: str, sub: str) -> void {
    let sub_y : u32 = TK_LGAP + strip_h(TK_HEAD) + TK_LGAP;
    let tx : u32 = TK_PAD + TK_SP5;
    let st1 : u32 = txt(rgb, TK_PAD, TK_LGAP, "<", TK_HEAD, W_BOLD, C_TXT);
    let st2 : u32 = txt(rgb, tx, TK_LGAP, title, TK_HEAD, W_BOLD, C_TXT);
    let st3 : u32 = txt(rgb, tx, sub_y, sub, TK_CAPT, W_REG, C_MUT);
    hline(rgb, HDR_H - 1, 0, HUD_W, C_BRD);
}

fn draw_overview(rgb: []u8, s: HudState) -> void {
    // header accent bar (3px wide, TK_MIN tall)
    fill(rgb, TK_PAD, TK_LGAP, TK_PAD + 3, TK_LGAP + TK_MIN + TK_SP3, C_TXT);
    let st1 : u32 = txt(rgb, TK_PAD + TK_LGAP + TK_SP1, TK_LGAP, "FPGA 101", TK_HEAD, W_BOLD, C_TXT);
    let sub_y : u32 = TK_LGAP + strip_h(TK_HEAD) + TK_LGAP;
    let st2 : u32 = txt(rgb, TK_PAD + TK_LGAP + TK_SP1, sub_y, "Lesson 1: What is an FPGA?", TK_CAPT, W_REG, C_MUT);
    // visited counter, left of the menu glyph
    let vx : u32 = HUD_W - BTN_W - 40;
    let nx : u32 = draw_u32(rgb, vx, sub_y, @as(u32, visited_count(s)), TK_CAPT, W_REG, C_MUT);
    let nx2 : u32 = put(rgb, nx, sub_y, "/7", TK_CAPT, W_REG, C_MUT);
    menu_glyph(rgb);
    hline(rgb, HDR_H - 1, 0, HUD_W, C_BRD);

    var i : u32 = 0;
    while i < CARD_N {
        let cy : u32 = HDR_H + i * CARD_H;
        hline(rgb, cy, 0, HUD_W, C_BRD);
        // text inset: the kit card content box (PAD_CARD), not the row padding
        let ci : i32 = card_inner(card_rect(i as i32, HUD_W as i32)).x;
        let cx : u32 = ci as u32;
        let sn : u32 = txt(rgb, cx, cy + TK_PAD, L1_NUMS[i], TK_CAPT, W_REG, C_MUT);
        let name_y : u32 = cy + TK_PAD + strip_h(TK_CAPT) + TK_LGAP;
        let sm : u32 = txt(rgb, cx, name_y, L1_IDS[i], TK_HEAD, W_BOLD, C_TXT);
        let desc_y : u32 = name_y + strip_h(TK_HEAD) + TK_AGAP;
        let sd : u32 = txt(rgb, cx, desc_y, L1_DESC[i], TK_BODY, W_REG, C_MUT);
        draw_right(rgb, i, cy);
        // selected card: 1px white frame inset from the card edges
        if i == @as(u32, s.sel) {
            frame_rect(rgb, TK_INSET, cy + TK_INSET, HUD_W - TK_INSET, cy + CARD_H - TK_INSET, C_TXT);
        }
        // visited card: filled white disc r4 in the top-right corner
        if ((@as(u32, s.visited) >> i) & 1) == 1 {
            disc(rgb, @as(i64, HUD_W - TK_PAD - 4), @as(i64, cy + TK_PAD + 4), 4, C_TXT);
        }
        i = i + 1;
    }
}

fn draw_scene(rgb: []u8, s: HudState, l: Learner) -> void {
    var sc : u32 = @as(u32, s.scene);
    if sc >= CARD_N { sc = 0; }
    inner_header(rgb, L1_IDS[sc], L1_DESC[sc]);
    menu_glyph(rgb);
    let ty : u32 = HDR_H + TK_PAD;
    draw_thumb_at(rgb, sc, TK_PAD, ty);

    var y : u32 = ty + THD_H + TK_PAD;
    let rowh : u32 = strip_h(TK_BODY) + TK_SP3;
    var x : u32 = put(rgb, TK_PAD, y, "Step: ", TK_BODY, W_REG, C_MUT);
    let a1 : u32 = put(rgb, x, y, scene_step_name(s.scene), TK_BODY, W_REG, C_TXT);
    y = y + rowh;
    x = put(rgb, TK_PAD, y, "Mastery: ", TK_BODY, W_REG, C_MUT);
    let a2 : u32 = put(rgb, x, y, step_name(l), TK_BODY, W_REG, C_TXT);
    y = y + rowh;
    x = put(rgb, TK_PAD, y, "Streak: ", TK_BODY, W_REG, C_MUT);
    let a3 : u32 = draw_u32(rgb, x, y, @as(u32, l.streak), TK_BODY, W_REG, C_TXT);
    y = y + rowh;
    x = put(rgb, TK_PAD, y, "Score: ", TK_BODY, W_REG, C_MUT);
    let a4 : u32 = draw_u32(rgb, x, y, score(l), TK_BODY, W_REG, C_TXT);
    y = y + rowh;
    x = put(rgb, TK_PAD, y, "Visited: ", TK_BODY, W_REG, C_MUT);
    x = draw_u32(rgb, x, y, @as(u32, visited_count(s)), TK_BODY, W_REG, C_TXT);
    let a5 : u32 = put(rgb, x, y, "/7", TK_BODY, W_REG, C_TXT);

    let h : u32 = txt(rgb, TK_PAD, HUD_H - 40, "UP/DOWN scene  ENTER next  BACK list  M menu", TK_CAPT, W_REG, C_MUT);
}

// Letter path: the petal letter is drawn from a one-byte buffer passed to txt as a str
// (checker verdict recorded in the report of this change); the UNIVERSITY caption is drawn too.
fn draw_menu(rgb: []u8, s: HudState) -> void {
    inner_header(rgb, "WORLDS", "27 petals, U = UNIVERSITY");
    var p : u32 = 0;
    while p < PETAL_COUNT {
        var col : u32 = C_MUT;
        if p == @as(u32, s.hover) { col = C_TXT; }
        if s.menu != STATE_HOME and p == s.menu { col = C_TXT; }
        disc(rgb, petal_px(p), petal_py(p), @as(i64, PETAL_R), col);
        p = p + 1;
    }
    if s.menu < PETAL_COUNT {
        var lb : [1]u8 = [0; 1];
        lb[0] = petal_letter_byte(s.menu);
        let sl : u32 = txt(rgb, HUD_W - BTN_W, TK_LGAP, &lb, TK_HEAD, W_BOLD, C_TXT);
    }
    if s.menu == WORLD_UNIVERSITY or @as(u32, s.hover) == WORLD_UNIVERSITY {
        let su : u32 = txt(rgb, TK_PAD, HUD_H - 40, UNIVERSITY_NAME, TK_CAPT, W_REG, C_TXT);
    }
}

// label (muted body) then value text (white body); returns the next x
fn label_at(rgb: []u8, y: u32, label: str) -> u32 {
    return put(rgb, TK_PAD, y, label, TK_BODY, W_REG, C_MUT) + TK_SP3;
}

// progress bar: track, then white fill of permille/1000 of the inner width
fn bar_at(rgb: []u8, y: u32, permille: u32) -> void {
    let w : u32 = HUD_W - 2 * TK_PAD;
    fill(rgb, TK_PAD, y, TK_PAD + w, y + TK_SP1, C_BRD);
    let fw : i32 = bar_fill_w(w as i32, permille as i32);
    fill(rgb, TK_PAD, y, TK_PAD + fw as u32, y + TK_SP1, C_TXT);
}

fn draw_progress(rgb: []u8, s: HudState, l: Learner) -> void {
    inner_header(rgb, "PROGRESS", "Your course so far");
    menu_glyph(rgb);
    let rowh : u32 = strip_h(TK_BODY) + TK_SP5;
    var y : u32 = HDR_H + TK_PAD;
    var x : u32 = label_at(rgb, y, "Scenes visited");
    x = draw_u32(rgb, x, y, @as(u32, visited_count(s)), TK_BODY, W_REG, C_TXT);
    let b1 : u32 = put(rgb, x, y, "/7", TK_BODY, W_REG, C_TXT);
    bar_at(rgb, y + strip_h(TK_BODY) + TK_SP1, progress_permille(s.visited));
    y = y + rowh + TK_SP4;

    x = label_at(rgb, y, "Mastery");
    x = put(rgb, x, y, step_name(l), TK_BODY, W_REG, C_TXT);
    if mastered(l) {
        let b2 : u32 = put(rgb, x + TK_SP3, y, "mastered", TK_BODY, W_BOLD, C_TXT);
    }
    y = y + rowh;

    x = label_at(rgb, y, "Streak");
    let b3 : u32 = draw_u32(rgb, x, y, @as(u32, l.streak), TK_BODY, W_REG, C_TXT);
    y = y + rowh;

    x = label_at(rgb, y, "Score");
    let b4 : u32 = draw_u32(rgb, x, y, score(l), TK_BODY, W_REG, C_TXT);
    y = y + rowh;

    x = label_at(rgb, y, "Course tasks done");
    x = draw_u32(rgb, x, y, tasks_done(), TK_BODY, W_REG, C_TXT);
    x = put(rgb, x, y, "/", TK_BODY, W_REG, C_TXT);
    let b5 : u32 = draw_u32(rgb, x, y, tasks_total(), TK_BODY, W_REG, C_TXT);
    var pm : u32 = 0;
    if tasks_total() > 0 { pm = tasks_done() * 1000 / tasks_total(); }
    bar_at(rgb, y + strip_h(TK_BODY) + TK_SP1, pm);
    y = y + rowh + TK_SP4;

    x = label_at(rgb, y, "Lessons");
    let b6 : u32 = draw_u32(rgb, x, y, lessons_total(), TK_BODY, W_REG, C_TXT);
}

pub fn hud_render(s: HudState, l: Learner, rgb: []u8) -> void {
    fill(rgb, 0, 0, HUD_W, HUD_H, C_BG);
    if s.screen == SCR_SCENE {
        draw_scene(rgb, s, l);
    } else if s.screen == SCR_MENU {
        draw_menu(rgb, s);
    } else if s.screen == SCR_PROGRESS {
        draw_progress(rgb, s, l);
    } else {
        draw_overview(rgb, s);
    }
}

pub const HASH_MOD : u64 = 1000000007;

/// A fingerprint of the RGB bytes: h = (h * 131 + byte) mod 1000000007.
pub fn hud_digest(rgb: []u8) -> u64 {
    var h : u64 = 0;
    var i : usize = 0;
    while i < RGB_N {
        h = (h * 131 + (rgb[i] as u64)) % HASH_MOD;
        i = i + 1;
    }
    return h;
}

// scripted session: 12 steps (see the header)
const STEP_N : u32 = 12;
const SC_EV  : [12]u8  = [EV_TICK, EV_DOWN, EV_DOWN, EV_ENTER, EV_TICK, EV_DOWN, EV_BACK, EV_TAP, EV_TAP, EV_TAP, EV_ENTER, EV_ENTER];
// -1 at step 8 means: the centre of the UNIVERSITY petal, computed in main
const SC_X   : [12]i64 = [0, 0, 0, 0, 0, 0, 0, 360, -1, 180, 0, 0];
const SC_Y   : [12]i64 = [0, 0, 0, 0, 0, 0, 0, 20, -1, 700, 0, 0];
const SC_ANS : [12]u32 = [0, 0, 0, 0, 64, 0, 0, 0, 0, 0, 0, 0];

// write HUD_PPM as the frame of step k (k == STEP_N is the initial state)
fn emit(k: u32) -> void {
    var path : [*:0]const u8 = "target/course/hud/hud_init.ppm";
    if (k == 0) { path = "target/course/hud/hud_00.ppm"; }
    if (k == 1) { path = "target/course/hud/hud_01.ppm"; }
    if (k == 2) { path = "target/course/hud/hud_02.ppm"; }
    if (k == 3) { path = "target/course/hud/hud_03.ppm"; }
    if (k == 4) { path = "target/course/hud/hud_04.ppm"; }
    if (k == 5) { path = "target/course/hud/hud_05.ppm"; }
    if (k == 6) { path = "target/course/hud/hud_06.ppm"; }
    if (k == 7) { path = "target/course/hud/hud_07.ppm"; }
    if (k == 8) { path = "target/course/hud/hud_08.ppm"; }
    if (k == 9) { path = "target/course/hud/hud_09.ppm"; }
    if (k == 10) { path = "target/course/hud/hud_10.ppm"; }
    if (k == 11) { path = "target/course/hud/hud_11.ppm"; }
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("hud: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    const w : usize = std.c.fwrite(@ptrCast(&HUD_PPM), 1, 913515, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != 913515) {
        std.debug.print("hud: short write to {s}: {d} of 913515 bytes\n", .{ path, w });
        std.c.exit(2);
    }
}

pub fn main() -> void {
    var rgb : [RGB_N]u8 = [0; RGB_N];
    var s : HudState = hud_init();
    var l : Learner = learner_init();
    hud_render(s, l, rgb);
    if ppm_write_into(&HUD_PPM, rgb, HUD_W, HUD_H) != FRAME_OK {
        std.c.exit(1);
    }
    emit(STEP_N);
    var k : u32 = 0;
    while k < STEP_N {
        var x : i64 = SC_X[k];
        var y : i64 = SC_Y[k];
        if x == -1 {
            x = petal_px(WORLD_UNIVERSITY);
            y = petal_py(WORLD_UNIVERSITY);
        }
        s = hud_step(s, SC_EV[k], x, y);
        if SC_ANS[k] != 0 {
            l = learner_answer(l, s.scene, SC_ANS[k]);
        }
        hud_render(s, l, rgb);
        if ppm_write_into(&HUD_PPM, rgb, HUD_W, HUD_H) != FRAME_OK {
            std.c.exit(1);
        }
        emit(k);
        std.debug.print("hud step {d} ev {d} -> screen {d} sel {d} scene {d} menu {d} hover {d} visited {d} score {d} digest {d}\n", .{ k, SC_EV[k], s.screen, s.sel, s.scene, s.menu, s.hover, s.visited, score(l), hud_digest(rgb) });
        k = k + 1;
    }
}

// ---------------------------------------------------------------- tests

// fingerprint of one rendered state
fn fp_of(s: HudState, l: Learner) -> u64 {
    var rgb : [RGB_N]u8 = [0; RGB_N];
    hud_render(s, l, rgb);
    return hud_digest(rgb);
}

test hud_dimensions_are_375_812 {
    assert HUD_W == 375;
    assert HUD_H == 812;
}

test seven_cards_fit_exactly_in_hud {
    assert HDR_H + CARD_N * CARD_H == HUD_H;
}

test thumbnail_pixel_count_is_correct {
    assert TH_W * TH_H * 3 == TH_PIX;
}

test displayed_thumbnail_fits_card_height {
    assert THD_H == CARD_H - 2 * TK_PAD;
}

test displayed_thumbnail_fits_card_width {
    assert THD_W + 2 * TK_PAD <= HUD_W;
}

test design_tokens_match_manifest {
    assert TK_HEAD == 26;
    assert TK_BODY == 16;
    assert TK_CAPT == 13;
    assert TK_PAD  == 16;
    assert TK_AGAP == 10;
    assert TK_LGAP ==  6;
    assert TK_MIN  == 24;
    assert TK_BRD  ==  1;
    assert TK_INSET == 6;
    assert TK_MAXW == 560;
}

test strip_height_capt_is_14 {
    assert strip_h(TK_CAPT) == 14;
}

test strip_height_head_is_28 {
    assert strip_h(TK_HEAD) == 28;
}

test strip_height_body_is_17 {
    assert strip_h(TK_BODY) == 17;
}

test card_text_fits_vertically {
    let total : u32 = strip_h(TK_CAPT) + TK_LGAP + strip_h(TK_HEAD) + TK_AGAP + strip_h(TK_BODY);
    assert total <= CARD_H - 2 * TK_PAD;
}

test thumbnail_col_no_overflow {
    assert HUD_W - TK_PAD - THD_W + THD_W + TK_PAD == HUD_W;
}

test script_has_twelve_steps {
    assert STEP_N == 12;
    assert SC_EV[3] == EV_ENTER;
}

test four_screens_render_four_fingerprints {
    let l : Learner = learner_init();
    let a : HudState = hud_init();
    var b : HudState = hud_init();
    b.screen = SCR_SCENE;
    var c : HudState = hud_init();
    c.screen = SCR_MENU;
    var d : HudState = hud_init();
    d.screen = SCR_PROGRESS;
    let fa : u64 = fp_of(a, l);
    let fb : u64 = fp_of(b, l);
    let fc : u64 = fp_of(c, l);
    let fd : u64 = fp_of(d, l);
    assert fa != fb;
    assert fa != fc;
    assert fa != fd;
    assert fb != fc;
    assert fb != fd;
    assert fc != fd;
}

test render_repeats_byte_for_byte {
    let l : Learner = learner_init();
    let a : HudState = hud_init();
    assert fp_of(a, l) == fp_of(a, l);
}

test selected_card_changes_the_fingerprint {
    let l : Learner = learner_init();
    let a : HudState = hud_init();
    var b : HudState = hud_init();
    b.sel = 3;
    assert fp_of(a, l) != fp_of(b, l);
}

test visited_bit_changes_the_fingerprint {
    let l : Learner = learner_init();
    let a : HudState = hud_init();
    var b : HudState = hud_init();
    b.visited = 4;
    assert fp_of(a, l) != fp_of(b, l);
}

test menu_hover_university_differs_from_hover_zero {
    let l : Learner = learner_init();
    var a : HudState = hud_init();
    a.screen = SCR_MENU;
    a.hover = 20;
    var b : HudState = hud_init();
    b.screen = SCR_MENU;
    b.hover = 0;
    assert fp_of(a, l) != fp_of(b, l);
}

test menu_event_reaches_the_menu_screen {
    let a : HudState = hud_step(hud_init(), EV_MENU, 0, 0);
    assert a.screen == SCR_MENU;
}

test hud_geometry_is_the_kit_geometry {
    assert HDR_H == @as(u32, UK_HDR_H);
    assert CARD_H == @as(u32, UK_CARD_H);
    assert 7 * UK_CARD_H + UK_HDR_H == @as(i32, HUD_H);
}

test hud_tokens_are_the_style_guide {
    assert C_BG == STYLE_BG;
    assert C_TXT == STYLE_TEXT;
    assert C_MUT == STYLE_MUTED;
    assert TK_PAD == @as(u32, PAD_ROW);
    assert TK_MIN == @as(u32, MIN_POINTER);
    assert TK_BODY == @as(u32, TYPE_BODY);
}

test card_text_x_is_the_kit_inset {
    let r : UiRect = card_rect(3, @as(i32, HUD_W));
    assert card_inner(r).x == PAD_CARD;
    assert card_inner(r).x == 20;
    assert card_inner(r).y == UK_HDR_H + 3 * UK_CARD_H + PAD_CARD;
}

test menu_button_sits_in_the_header_zone {
    let b : UiRect = menu_btn();
    assert b.w == @as(i32, BTN_W);
    assert b.h == MIN_TOUCH;
    assert b.x == @as(i32, HUD_W - BTN_W);
    assert b.y + b.h / 2 == @as(i32, HDR_H / 2);
}

test bar_at_500_permille_is_half_the_track {
    let w : i32 = @as(i32, HUD_W - 2 * TK_PAD);
    assert bar_fill_w(w, 500) == w / 2;
    assert bar_fill_w(w, 0) == 0;
    assert bar_fill_w(w, 1000) == w;
}
