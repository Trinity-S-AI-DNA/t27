// SPDX-License-Identifier: Apache-2.0
// specs/course/course_hud_main.t27 -- native target of the interactive FPGA 101 course HUD, 375x812.
//
// hud_render draws any state of the HUD state machine (course_hud_state): the scene list (OVERVIEW),
// one scene (SCENE), the 27-petal worlds menu (MENU) and the PROGRESS page, from a HudState and a
// Learner (course_hud_data). main() runs a fixed 12-step scripted session: one event per step, one
// PPM frame per step (target/course/hud/hud_00.ppm .. hud_11.ppm, plus hud_init.ppm for the start
// state) and one trace line per step on stderr. This is a byte-level artifact set, NOT a claim that
// the frames look right: open them before saying so.
//
// All measurements from Design Tokens v0.1 (vf_tokens VTK_MANIFEST).
// BW palette: bg=#000000, text=#FFFFFF, muted=#808080 (vf_theme TH_T27).
// Scene thumbnails (HOOK/EXPLAIN/PROVE): 24x52 RGB, resized from target/course/ls/.
// Other scenes (VISUAL/PREDICT/POKE/TRANSFER): muted placeholder rectangle.
//
// BUILD (heavy: in a T27 OS pane, not on this Mac):
//   t27c gen specs/course/course_hud_main.t27 > chm.zig
//   zig build-exe chm.zig -lc ...  (same closure as lesson_01_style_main.t27)
//   ./chm   (writes target/course/hud/*.ppm relative to the working directory)
//
// CLOSURE: specs/t27f/vf_type.t27, outfit_r_data.t27, outfit_b_data.t27, petal_menu.t27,
//   specs/course/course_hud_state.t27, course_hud_nav.t27, course_hud_data.t27
//
// Refs gHashTag/t27#13251. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module course_hud_main;

