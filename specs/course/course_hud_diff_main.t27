// SPDX-License-Identifier: Apache-2.0
; specs/course/course_hud_diff_main.t27 -- host program: the before/after/diff of the 13 frames of the course HUD (Refs
; gHashTag/t27#13251, the cross-cutting diff of the graph-first UI engine). For the frames hud_init and hud_00 .. hud_11 it
; reads the before frame target/course/hud/base/<name>.ppm and the after frame target/course/hud/<name>.ppm, both P6 375x812
; files of 913515 bytes (15 header bytes, then 913500 RGB bytes) as specs/course/course_hud_main.t27 writes them, and prints
; to stderr one line per frame, `<name>: <count> pixels differ, bbox <x0>,<y0>-<x1>,<y1>` (or `0 pixels differ`), then a
; total. It writes target/course/hud/<name>_diff.ppm: the same header and the vf_diff_frame body, a changed pixel red
; 0xFF0000 and an unchanged one a light grey of its brightness.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. A count says how many pixel bytes moved between two runs, not whether either frame
; looks right or whether the change was the intended one; that starts only when somebody opens the diff frames.
; --
; BUILD AND RUN (a heavy build: in a T27 OS pane or on the lab, not on the Mac without the owner's word):
;   copy the baseline frames of course_hud_main into target/course/hud/base/, then rebuild and rerun that program
;   t27c gen specs/course/course_hud_diff_main.t27 > hud_diff.zig
;   zig build-exe hud_diff.zig -lc
;   ./hud_diff 2> target/course/hud/hud_diff.txt
;   sips -s format png target/course/hud/hud_00_diff.ppm --out target/course/hud/hud_00_diff.png   (one per frame)
; Paths sit under the working directory (target/ is gitignored), never /tmp. A missing file, a file of the wrong size, a
; header that is not `P6 375 812 255`, an unopenable output or a short write exits 2; a diff refusal exits 1.
; --
; Module-level vars are never spliced by `use`, so the byte buffers live here and are passed to vf_diff as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CourseHudDiffMain;

use t27f::vf_diff::VfDiffBox;
use t27f::vf_diff::vf_diff_count;
use t27f::vf_diff::vf_diff_bbox;
use t27f::vf_diff::vf_diff_frame;
use t27f::vf_diff::VF_D_OK;

pub var HUDD_HA : [15]u8 = [0] ** 15;
pub var HUDD_HB : [15]u8 = [0] ** 15;
pub var HUDD_A : [913500]u8 = [0] ** 913500;
pub var HUDD_B : [913500]u8 = [0] ** 913500;
pub var HUDD_D : [913500]u8 = [0] ** 913500;
pub var HUDD_TAIL : [1]u8 = [0] ** 1;

pub const HUDD_W : u32 = 375;
pub const HUDD_H : u32 = 812;
pub const HUDD_HDR : usize = 15;
pub const HUDD_RGB : usize = 913500;
pub const HUDD_BYTES : usize = 913515;
pub const HUDD_P6 : []const u8 = "P6\n375 812\n255\n";
pub const HUDD_COUNT : u8 = 13;
pub const HUDD_NAMES : [13]str = ["hud_init", "hud_00", "hud_01", "hud_02", "hud_03", "hud_04", "hud_05", "hud_06", "hud_07", "hud_08", "hud_09", "hud_10", "hud_11"];

; results of a frame read: read, cannot open, under 913515 bytes, over 913515 bytes
pub const HUDD_READ_OK : u8 = 0;
pub const HUDD_NO_FILE : u8 = 1;
pub const HUDD_SHORT : u8 = 2;
pub const HUDD_LONG : u8 = 3;

/// The HUDD_* result of a read that got nh header bytes, nb RGB bytes and nt bytes past the end. main opens and reads
/// the files itself, because t27b takes `[*:0]const u8` only as a local of main, not as a fn parameter.
pub fn hudd_counted(nh: usize, nb: usize, nt: usize) -> u8 {
    if (nh != HUDD_HDR or nb != HUDD_RGB) { return HUDD_SHORT; }
    if (nt != 0) { return HUDD_LONG; }
    return HUDD_READ_OK;
}

/// Why a read failed, for the error line.
pub fn hudd_why(code: u8) -> str {
    if (code == HUDD_NO_FILE) { return "cannot be opened"; }
    if (code == HUDD_SHORT) { return "is shorter than 913515 bytes"; }
    if (code == HUDD_LONG) { return "is longer than 913515 bytes"; }
    return "was read";
}

/// True when hdr holds exactly the 15 bytes `P6\n375 812\n255\n`.
pub fn hudd_is_p6(hdr: []const u8) -> bool {
    var i : usize = 0;
    while (i < HUDD_HDR) {
        if (hdr[i] != HUDD_P6[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn main() void {
    var total : u32 = 0;
    var s : u8 = 0;
    while (s < HUDD_COUNT) {
        var before : [*:0]const u8 = "target/course/hud/base/hud_init.ppm";
        var after : [*:0]const u8 = "target/course/hud/hud_init.ppm";
        var diff : [*:0]const u8 = "target/course/hud/hud_init_diff.ppm";
        if (s == 1) { before = "target/course/hud/base/hud_00.ppm"; after = "target/course/hud/hud_00.ppm"; diff = "target/course/hud/hud_00_diff.ppm"; }
        if (s == 2) { before = "target/course/hud/base/hud_01.ppm"; after = "target/course/hud/hud_01.ppm"; diff = "target/course/hud/hud_01_diff.ppm"; }
        if (s == 3) { before = "target/course/hud/base/hud_02.ppm"; after = "target/course/hud/hud_02.ppm"; diff = "target/course/hud/hud_02_diff.ppm"; }
        if (s == 4) { before = "target/course/hud/base/hud_03.ppm"; after = "target/course/hud/hud_03.ppm"; diff = "target/course/hud/hud_03_diff.ppm"; }
        if (s == 5) { before = "target/course/hud/base/hud_04.ppm"; after = "target/course/hud/hud_04.ppm"; diff = "target/course/hud/hud_04_diff.ppm"; }
        if (s == 6) { before = "target/course/hud/base/hud_05.ppm"; after = "target/course/hud/hud_05.ppm"; diff = "target/course/hud/hud_05_diff.ppm"; }
        if (s == 7) { before = "target/course/hud/base/hud_06.ppm"; after = "target/course/hud/hud_06.ppm"; diff = "target/course/hud/hud_06_diff.ppm"; }
        if (s == 8) { before = "target/course/hud/base/hud_07.ppm"; after = "target/course/hud/hud_07.ppm"; diff = "target/course/hud/hud_07_diff.ppm"; }
        if (s == 9) { before = "target/course/hud/base/hud_08.ppm"; after = "target/course/hud/hud_08.ppm"; diff = "target/course/hud/hud_08_diff.ppm"; }
        if (s == 10) { before = "target/course/hud/base/hud_09.ppm"; after = "target/course/hud/hud_09.ppm"; diff = "target/course/hud/hud_09_diff.ppm"; }
        if (s == 11) { before = "target/course/hud/base/hud_10.ppm"; after = "target/course/hud/hud_10.ppm"; diff = "target/course/hud/hud_10_diff.ppm"; }
        if (s == 12) { before = "target/course/hud/base/hud_11.ppm"; after = "target/course/hud/hud_11.ppm"; diff = "target/course/hud/hud_11_diff.ppm"; }
        var ra : u8 = HUDD_NO_FILE;
        const fa = std.c.fopen(before, "rb");
        if (fa != null) {
            const nha : usize = std.c.fread(@ptrCast(&HUDD_HA), 1, HUDD_HDR, fa.?);
            const nba : usize = std.c.fread(@ptrCast(&HUDD_A), 1, HUDD_RGB, fa.?);
            const nta : usize = std.c.fread(@ptrCast(&HUDD_TAIL), 1, 1, fa.?);
            _ = std.c.fclose(fa.?);
            ra = hudd_counted(nha, nba, nta);
        }
        if (ra != HUDD_READ_OK) {
            std.debug.print("hud_diff: {s}: before file {s} {s}\n", .{ HUDD_NAMES[s], before, hudd_why(ra) });
            std.c.exit(2);
        }
        var rb : u8 = HUDD_NO_FILE;
        const fb = std.c.fopen(after, "rb");
        if (fb != null) {
            const nhb : usize = std.c.fread(@ptrCast(&HUDD_HB), 1, HUDD_HDR, fb.?);
            const nbb : usize = std.c.fread(@ptrCast(&HUDD_B), 1, HUDD_RGB, fb.?);
            const ntb : usize = std.c.fread(@ptrCast(&HUDD_TAIL), 1, 1, fb.?);
            _ = std.c.fclose(fb.?);
            rb = hudd_counted(nhb, nbb, ntb);
        }
        if (rb != HUDD_READ_OK) {
            std.debug.print("hud_diff: {s}: after file {s} {s}\n", .{ HUDD_NAMES[s], after, hudd_why(rb) });
            std.c.exit(2);
        }
        if (hudd_is_p6(&HUDD_HA) == false) {
            std.debug.print("hud_diff: {s}: before file {s} has no P6 375 812 255 header\n", .{ HUDD_NAMES[s], before });
            std.c.exit(2);
        }
        if (hudd_is_p6(&HUDD_HB) == false) {
            std.debug.print("hud_diff: {s}: after file {s} has no P6 375 812 255 header\n", .{ HUDD_NAMES[s], after });
            std.c.exit(2);
        }
        const n : u32 = vf_diff_count(&HUDD_A, &HUDD_B, HUDD_W, HUDD_H);
        const bx : VfDiffBox = vf_diff_bbox(&HUDD_A, &HUDD_B, HUDD_W, HUDD_H);
        const rd : u8 = vf_diff_frame(&HUDD_A, &HUDD_B, &HUDD_D, HUDD_W, HUDD_H);
        if (rd != VF_D_OK) {
            std.debug.print("hud_diff: {s}: diff refused, code {d}\n", .{ HUDD_NAMES[s], rd });
            std.c.exit(1);
        }
        const fp = std.c.fopen(diff, "wb");
        if (fp == null) {
            std.debug.print("hud_diff: cannot open {s} for writing\n", .{diff});
            std.c.exit(2);
        }
        const wh : usize = std.c.fwrite(@ptrCast(&HUDD_HA), 1, HUDD_HDR, fp.?);
        const wb : usize = std.c.fwrite(@ptrCast(&HUDD_D), 1, HUDD_RGB, fp.?);
        _ = std.c.fclose(fp.?);
        if (wh + wb != HUDD_BYTES) {
            std.debug.print("hud_diff: short write to {s}: {d} of {d} bytes\n", .{ diff, wh + wb, HUDD_BYTES });
            std.c.exit(2);
        }
        if (bx.any) {
            std.debug.print("{s}: {d} pixels differ, bbox {d},{d}-{d},{d}\n", .{ HUDD_NAMES[s], n, bx.x0, bx.y0, bx.x1, bx.y1 });
        } else {
            std.debug.print("{s}: 0 pixels differ\n", .{HUDD_NAMES[s]});
        }
        total += n;
        s += 1;
    }
    std.debug.print("hud_diff: {d} pixels differ across the {d} frames; open the _diff frames before saying what changed\n", .{ total, HUDD_COUNT });
    std.c.exit(0);
}

; fill HUDD_A and HUDD_B with the same pattern that is not all one value: byte i is i mod 251
fn hudd_pattern() -> void {
    var i : usize = 0;
    while i < HUDD_RGB {
        HUDD_A[i] = (i % 251) as u8;
        HUDD_B[i] = (i % 251) as u8;
        i = i + 1;
    }
}

test a_frame_diffed_with_itself_gives_0 {
    hudd_pattern();
    assert vf_diff_count(&HUDD_A, &HUDD_A, HUDD_W, HUDD_H) == 0;
    assert vf_diff_count(&HUDD_A, &HUDD_B, HUDD_W, HUDD_H) == 0;
    assert vf_diff_bbox(&HUDD_A, &HUDD_B, HUDD_W, HUDD_H).any == false;
    assert vf_diff_frame(&HUDD_A, &HUDD_B, &HUDD_D, HUDD_W, HUDD_H) == VF_D_OK;
}

test nc_one_byte_of_the_after_frame_shows {
    // negative control: the last byte of the after frame, pixel (374, 811); a diff that ignored the buffers would say 0
    hudd_pattern();
    HUDD_B[913499] = HUDD_B[913499] + 1;
    assert vf_diff_count(&HUDD_A, &HUDD_B, HUDD_W, HUDD_H) == 1;
    let bx : VfDiffBox = vf_diff_bbox(&HUDD_A, &HUDD_B, HUDD_W, HUDD_H);
    assert bx.any == true;
    assert bx.x0 == 374;
    assert bx.y0 == 811;
    assert vf_diff_frame(&HUDD_A, &HUDD_B, &HUDD_D, HUDD_W, HUDD_H) == VF_D_OK;
    assert HUDD_D[913497] == 255;
    assert HUDD_D[913498] == 0;
    assert HUDD_D[913499] == 0;
}

test the_header_check_takes_only_p6_375_812 {
    var i : usize = 0;
    while i < HUDD_HDR {
        HUDD_HA[i] = HUDD_P6[i];
        i = i + 1;
    }
    assert hudd_is_p6(&HUDD_HA) == true;
    assert HUDD_BYTES == HUDD_HDR + HUDD_RGB;
    assert HUDD_RGB == 375 * 812 * 3;
    // 812 375 is the same size and the wrong shape
    HUDD_HA[3] = 56;
    assert hudd_is_p6(&HUDD_HA) == false;
}

test the_byte_counts_say_read_short_or_long {
    assert hudd_counted(15, 913500, 0) == HUDD_READ_OK;
    // negative controls: one header byte short, one RGB byte short, one byte past the end
    assert hudd_counted(14, 913500, 0) == HUDD_SHORT;
    assert hudd_counted(15, 913499, 0) == HUDD_SHORT;
    assert hudd_counted(15, 913500, 1) == HUDD_LONG;
    assert hudd_why(HUDD_LONG) == "is longer than 913515 bytes";
}

test the_name_table_has_13_frames {
    assert HUDD_COUNT == 13;
    assert HUDD_NAMES[0] == "hud_init";
    assert HUDD_NAMES[1] == "hud_00";
    assert HUDD_NAMES[12] == "hud_11";
}
