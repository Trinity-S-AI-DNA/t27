// The weak point a row of WEAK_IDS holds, or WEAK_COUNT when no row has that id.
pub fn weak_index(id: str) -> u32 {
    var found : u32 = WEAK_COUNT;
    var i : u32 = 0;
    while found == WEAK_COUNT and i < WEAK_COUNT {
        if bytes_eq(WEAK_IDS[i], id) {
            found = i;
        }
        i = i + 1;
    }
    return found;
}

pub fn impact_of_first(n: u32) -> u32 {
    var s : u32 = 0;
    var i : u32 = 0;
    while i < n and i < WEAK_COUNT {
        s = s + WEAK_IMPACT[i];
        i = i + 1;
    }
    return s;
}

pub fn cost_of_first(n: u32) -> u32 {
    var s : u32 = 0;
    var i : u32 = 0;
    while i < n and i < WEAK_COUNT {
        s = s + WEAK_COST[i];
        i = i + 1;
    }
    return s;
}

// The Pareto test of a cut of the first `n` rows.
pub fn cut_ok(n: u32) -> bool {
    var cost_share_ok : bool = cost_of_first(n) * 3 <= cost_of_first(WEAK_COUNT);
    var impact_share_ok : bool = impact_of_first(n) * 2 >= impact_of_first(WEAK_COUNT);
    return cost_share_ok and impact_share_ok;
}

test every_score_is_impact_over_cost {
    var i : u32 = 0;
    while i < WEAK_COUNT {
        assert WEAK_SCORE[i] == WEAK_IMPACT[i] * 100 / WEAK_COST[i];
        assert WEAK_IMPACT[i] >= 1 and WEAK_IMPACT[i] <= 9;
        assert WEAK_COST[i] >= 1 and WEAK_COST[i] <= 9;
        i = i + 1;
    }
}

test the_rows_are_sorted_by_score {
    var i : u32 = 1;
    while i < WEAK_COUNT {
        assert WEAK_SCORE[i] <= WEAK_SCORE[i - 1];
        i = i + 1;
    }
}

test the_cut_is_a_pareto_cut {
    assert impact_of_first(WEAK_COUNT) == 56;
    assert cost_of_first(WEAK_COUNT) == 37;
    assert impact_of_first(CUT) == 29;
    assert cost_of_first(CUT) == 12;
    assert cut_ok(CUT);
    // Negative controls: one row more costs more than a third; one row less is under half.
    assert !cut_ok(CUT + 1);
    assert !cut_ok(CUT - 2);
}

test every_task_names_a_real_issue_and_a_listed_weak_point {
    var i : u32 = 0;
    while i < TASK_COUNT {
        assert TASK_ISSUE[i] > 0;
        assert TASK_REPO[i] <= REPO_TRINITY;
        assert TASK_STATE[i] <= PARKED;
        assert weak_index(TASK_WEAK[i]) < WEAK_COUNT;
        i = i + 1;
    }
    assert weak_index("W9") == WEAK_COUNT;
}

test a_parked_task_names_its_blocker_and_no_other_does {
    var i : u32 = 0;
    while i < TASK_COUNT {
        if TASK_STATE[i] == PARKED {
            assert TASK_BLOCKER[i].len > 0;
        } else {
            assert TASK_BLOCKER[i].len == 0;
        }
        i = i + 1;
    }
}

test a_done_task_names_its_pr_and_an_open_task_names_none {
    var i : u32 = 0;
    while i < TASK_COUNT {
        if TASK_STATE[i] == DONE {
            assert TASK_PR[i] > 0;
        }
        if TASK_STATE[i] == OPEN {
            assert TASK_PR[i] == 0;
        }
        i = i + 1;
    }
}

test every_weak_point_in_the_cut_has_a_task_that_is_not_parked {
    var w : u32 = 0;
    while w < CUT {
        var live : bool = false;
        var t : u32 = 0;
        while t < TASK_COUNT {
            if bytes_eq(TASK_WEAK[t], WEAK_IDS[w]) and TASK_STATE[t] != PARKED {
                live = true;
            }
            t = t + 1;
        }
        assert live;
        w = w + 1;
    }
}

test every_competitor_line_points_at_a_weak_point {
    var c : u32 = 0;
    while c < COMP_COUNT {
        assert weak_index(COMP_FIXES[c]) < WEAK_COUNT;
        assert COMP_TAKE[c].len > 0;
        c = c + 1;
    }
}
