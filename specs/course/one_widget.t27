// specs/course/one_widget.t27 -- one course widget, the existing kit button.
// The graph is kit_button. This file does not draw it, does not write a picture,
// and does not open the OS window. The page that would show it is not written.
// phi^2 + 1/phi^2 = 3 | TRINITY

module course::one_widget {

    use t27f::ui_kit::UiKit;
    use t27f::ui_kit::kit_button;
    use t27f::ui_kit::kit_node_count;
    use t27f::ui_kit::kit_parents_first;
    use t27f::ui_kit::kit_variant_at;
    use t27f::ui_kit::kit_state_at;
    use t27f::ui_kit::KV_PRIMARY;
    use t27f::ui_kit::KS_DEFAULT;

    pub const BUTTON_NODES : u32 = 2;
    pub const PAGE_RENDERED : bool = false;
    pub const OBJECT_EMITTED : bool = false;
    pub const SHOT_TAKEN : bool = false;

    /// The first lesson widget is a primary button in the default state.
    /// Two nodes, parent before child. No object file and no screenshot.
    pub fn widget_graph_ok() -> bool {
        let k : UiKit = kit_button(KV_PRIMARY, KS_DEFAULT);
        if (kit_node_count(k) != BUTTON_NODES) { return false; }
        if (!kit_parents_first(k)) { return false; }
        if (kit_variant_at(k, 1) != KV_PRIMARY) { return false; }
        if (kit_state_at(k, 1) != KS_DEFAULT) { return false; }
        return !PAGE_RENDERED && !OBJECT_EMITTED && !SHOT_TAKEN;
    }

    test "one kit button is the course widget, and nothing is drawn" {
        assert(widget_graph_ok());
        assert(BUTTON_NODES == 2);
        assert(!PAGE_RENDERED);
        assert(!OBJECT_EMITTED);
        assert(!SHOT_TAKEN);
    }

    invariant the_page_is_not_drawn {
        assert PAGE_RENDERED == false;
        assert OBJECT_EMITTED == false;
        assert SHOT_TAKEN == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
