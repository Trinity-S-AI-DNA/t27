// SPDX-License-Identifier: Apache-2.0
; specs/course/course_hud_data.t27 -- the data binding of the course HUD to Ring 1 (Refs gHashTag/t27#13251).
; The HUD shows where a learner stands in lesson 1: the scene, the mastery step, the streak, the score, how much
; of the course is built. This module is the one place that turns those facts into numbers and words for a renderer.
; Nothing is copied from the source specs: scene ids, scene steps, answer keys, step names, task states and the
; lesson count are read through `use`; a change in lesson_01_fpga_intro, mastery, fpga_course_v2 or lesson_frames
; reaches the HUD without an edit here. dec_into and frac_into write decimal text into a byte buffer, so a
; renderer prints "3/7" without a second table. Loops live in tests only. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module CourseHudData;

use std::mem::bytes_eq;
use course::lesson_01_fpga_intro::SCENE_COUNT;
use course::lesson_01_fpga_intro::SCENE_IDS;
use course::lesson_01_fpga_intro::SCENE_STEP;
use course::lesson_01_fpga_intro::SCENE_KEY;
use course::lesson_01_fpga_intro::SCENE_PROVE;
use course::lesson_01_fpga_intro::LESSON_TITLE;
use course::mastery::PREDICT;
use course::mastery::STEP_NAMES;
use course::mastery::STEP_COUNT;
use course::mastery::NO_STEP;
use course::mastery::STREAK_TO_MASTER;
use course::mastery::next_step;
use course::mastery::next_streak;
use course::mastery::is_mastered;
use course::fpga_course_v2::DONE;
use course::fpga_course_v2::TASK_COUNT;
use course::fpga_course_v2::TASK_STATE;
use course::lesson_frames::LESSON_COUNT;

pub const SCORE_ANSWER : u32 = 100;
pub const SCORE_STREAK : u32 = 10;
pub const SCORE_PROVED : u32 = 500;

pub struct Learner {
    step: u8,
    streak: u8,
    proved: bool,
    answered: u8,
}

pub fn learner_init() -> Learner {
    return Learner { step: PREDICT, streak: 0, proved: false, answered: 0 };
}

pub fn scene_has_answer(scene: u8) -> bool {
    var v : bool = false;
    if scene < SCENE_COUNT {
        v = SCENE_KEY[scene] != 0;
    }
    return v;
}

pub fn learner_answer(l: Learner, scene: u8, answer: u32) -> Learner {
    if !scene_has_answer(scene) {
        return l;
    }
    const ok : bool = answer == SCENE_KEY[scene];
    var bits : u8 = l.answered;
    if ok {
        bits = bits | (((1 as u32) << (scene as u32)) as u8);
    }
    return Learner {
        step: next_step(l.step, ok),
        streak: next_streak(l.streak, ok),
        proved: l.proved or (ok and scene == SCENE_PROVE),
        answered: bits,
    };
}

pub fn mastered(l: Learner) -> bool {
    return is_mastered(l.streak, l.proved);
}

pub fn popcount7(bits: u8) -> u8 {
    var n : u8 = 0;
    if (bits & 1) != 0 { n = n + 1; }
    if (bits & 2) != 0 { n = n + 1; }
    if (bits & 4) != 0 { n = n + 1; }
    if (bits & 8) != 0 { n = n + 1; }
    if (bits & 16) != 0 { n = n + 1; }
    if (bits & 32) != 0 { n = n + 1; }
    if (bits & 64) != 0 { n = n + 1; }
    return n;
}

pub fn score(l: Learner) -> u32 {
    var s : u32 = (popcount7(l.answered) as u32) * SCORE_ANSWER + (l.streak as u32) * SCORE_STREAK;
    if l.proved {
        s = s + SCORE_PROVED;
    }
    return s;
}

pub fn progress_permille(visited: u8) -> u32 {
    return (popcount7(visited) as u32) * 1000 / (SCENE_COUNT as u32);
}

pub fn step_name(l: Learner) -> str {
    var v : str = "";
    if l.step != NO_STEP and l.step < STEP_COUNT {
        v = STEP_NAMES[l.step];
    }
    return v;
}

pub fn scene_id(scene: u8) -> str {
    var v : str = "";
    if scene < SCENE_COUNT {
        v = SCENE_IDS[scene];
    }
    return v;
}

pub fn scene_step_name(scene: u8) -> str {
    var v : str = "";
    if scene < SCENE_COUNT {
        const st : u8 = SCENE_STEP[scene];
        if st != NO_STEP and st < STEP_COUNT {
            v = STEP_NAMES[st];
        }
    }
    return v;
}

pub fn lesson_title() -> str {
    return LESSON_TITLE;
}

pub fn tasks_done() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < TASK_COUNT {
        if TASK_STATE[i] == DONE {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub fn tasks_total() -> u32 {
    return TASK_COUNT;
}

pub fn build_permille() -> u32 {
    return tasks_done() * 1000 / TASK_COUNT;
}

pub fn lessons_total() -> u32 {
    return LESSON_COUNT;
}

// Decimal digits of v written at buf[at..]; the index after the last digit. Stops, writing nothing
// more, when the buffer is full; at least one digit is written for 0.
pub fn dec_into(buf: []u8, at: usize, v: u32) -> usize {
    var div : u32 = 1000000000;
    var started : bool = false;
    var pos : usize = at;
    var rest : u32 = v;
    var k : u32 = 0;
    while k < 10 {
        const d : u32 = rest / div;
        rest = rest - d * div;
        if d != 0 or started or k == 9 {
            if pos < buf.len {
                buf[pos] = (48 + d) as u8;
                pos = pos + 1;
            }
            started = true;
        }
        div = div / 10;
        k = k + 1;
    }
    return pos;
}

// "a/b" written at buf[at..]; the index after it.
pub fn frac_into(buf: []u8, at: usize, a: u32, b: u32) -> usize {
    var pos : usize = dec_into(buf, at, a);
    if pos < buf.len {
        buf[pos] = 47;
        pos = pos + 1;
    }
    return dec_into(buf, pos, b);
}

test init_state {
    const l : Learner = learner_init();
    assert l.step == PREDICT;
    assert l.streak == 0;
    assert !l.proved;
    assert l.answered == 0;
    assert score(l) == 0;
    assert !mastered(l);
}

test right_predict_advances {
    const l : Learner = learner_answer(learner_init(), 2, 64);
    assert l.step != PREDICT;
    assert l.streak == 1;
    assert l.answered == 4;
    assert !l.proved;
}

test wrong_answer_is_a_negative_control {
    const a : Learner = learner_answer(learner_init(), 2, 64);
    const l : Learner = learner_answer(a, 2, 63);
    assert l.answered == 4;
    assert l.streak == 0;
    const f : Learner = learner_answer(learner_init(), 2, 63);
    assert f.answered == 0;
    assert f.streak == 0;
}

test scene_without_key_changes_nothing {
    const a : Learner = learner_answer(learner_init(), 2, 64);
    const l : Learner = learner_answer(a, 0, 64);
    assert l.step == a.step;
    assert l.streak == a.streak;
    assert l.proved == a.proved;
    assert l.answered == a.answered;
    assert !scene_has_answer(0);
    assert !scene_has_answer(7);
    assert scene_has_answer(6);
}

test two_right_answers_make_streak_two {
    const a : Learner = learner_answer(learner_init(), 2, 64);
    const l : Learner = learner_answer(a, 5, 100000);
    assert l.streak == 2;
    assert l.answered == 36;
}

test proved_only_after_scene_six {
    const a : Learner = learner_answer(learner_init(), 5, 100000);
    assert !a.proved;
    const b : Learner = learner_answer(a, 6, 269199);
    assert !b.proved;
    const c : Learner = learner_answer(b, 6, 269200);
    assert c.proved;
    assert (c.answered & 64) != 0;
}

test mastered_needs_streak_and_proof {
    var l : Learner = learner_init();
    l = learner_answer(l, 2, 64);
    assert !mastered(l);
    l = learner_answer(l, 5, 100000);
    assert l.streak >= STREAK_TO_MASTER;
    assert !mastered(l);
    l = learner_answer(l, 6, 269200);
    assert mastered(l);
}

test score_values {
    assert score(learner_init()) == 0;
    assert score(learner_answer(learner_init(), 2, 64)) == 110;
    var l : Learner = learner_init();
    l = learner_answer(l, 2, 64);
    l = learner_answer(l, 5, 100000);
    l = learner_answer(l, 6, 269200);
    assert score(l) == 3 * SCORE_ANSWER + 3 * SCORE_STREAK + SCORE_PROVED;
}

test popcount_and_progress {
    assert popcount7(0) == 0;
    assert popcount7(85) == 4;
    assert progress_permille(0) == 0;
    assert progress_permille(127) == 1000;
    assert progress_permille(7) == 428;
}

test build_ledger_counts {
    assert tasks_done() == 6;
    assert tasks_total() == 12;
    assert build_permille() == 500;
    assert lessons_total() == 27;
}

test scene_words {
    assert bytes_eq(scene_id(0), "hook");
    assert bytes_eq(scene_id(6), "prove");
    assert scene_id(7).len == 0;
    assert scene_step_name(0).len == 0;
    assert scene_step_name(1).len == 0;
    assert bytes_eq(scene_step_name(2), "predict");
    assert bytes_eq(scene_step_name(6), "prove");
    assert scene_step_name(9).len == 0;
    assert bytes_eq(step_name(learner_init()), "predict");
    assert bytes_eq(lesson_title(), LESSON_TITLE);
}

test step_name_out_of_range_is_empty {
    const bad : Learner = Learner { step: 255, streak: 0, proved: false, answered: 0 };
    assert step_name(bad).len == 0;
    const bad2 : Learner = Learner { step: 6, streak: 0, proved: false, answered: 0 };
    assert step_name(bad2).len == 0;
}

test dec_into_writes_digits {
    var buf : [12]u8 = [0] ** 12;
    assert dec_into(&buf, 0, 0) == 1;
    assert buf[0] == 48;
    assert dec_into(&buf, 2, 7) == 3;
    assert buf[2] == 55;
    assert dec_into(&buf, 3, 12) == 5;
    assert buf[3] == 49;
    assert buf[4] == 50;
    assert dec_into(&buf, 0, 269200) == 6;
    assert buf[0] == 50;
    assert buf[1] == 54;
    assert buf[2] == 57;
    assert buf[3] == 50;
    assert buf[4] == 48;
    assert buf[5] == 48;
}

test dec_into_full_buffer_writes_nothing {
    var buf : [4]u8 = [0] ** 4;
    assert dec_into(&buf, 4, 123) == 4;
    assert buf[0] == 0;
    assert buf[3] == 0;
    assert dec_into(&buf, 2, 12345) == 4;
    assert buf[2] == 49;
    assert buf[3] == 50;
}

test frac_into_writes_a_over_b {
    var buf : [12]u8 = [0] ** 12;
    assert frac_into(&buf, 0, 3, 7) == 3;
    assert buf[0] == 51;
    assert buf[1] == 47;
    assert buf[2] == 55;
    assert frac_into(&buf, 4, 12, 27) == 9;
    assert buf[4] == 49;
    assert buf[5] == 50;
    assert buf[6] == 47;
    assert buf[7] == 50;
    assert buf[8] == 55;
}
