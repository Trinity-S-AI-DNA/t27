; specs/course/lesson_01_theme.t27 -- lesson 1 under a theme swap (Refs #13251 ring 4, #13674).
; For one scene and two themes it counts three things: meaning lines changed, layout rectangles changed, and
; pixels of the 375x812 raster whose token fill changed. Colours come from the token rows of vf_theme only.
; The pixel count is over flat token fills by node kind (vf_paint_id + vf_fill), not over a styled renderer:
; vf_render takes no theme, and the themed vf_card::vc_render is not an input of #13674.
; It is a measurement, not a claim that a frame looks right.
; It also counts the text, button and badge nodes whose label colour fails the AERT check on its fill.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CourseLesson01Theme;

use t27f::ui_plan::THEME_LIGHT;
use t27f::ui_plan::THEME_DARK;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NONE;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_paint_id;
use t27f::vf_pixel::VF_PX_NONE;
use t27f::vf_theme::vf_fill;
use t27f::vf_theme::vf_label;
use t27f::vf_theme::vf_aert_ok;
use t27f::vf_meaning::vf_depth;
use t27f::vf_meaning::vf_relation;
use t27f::vf_meaning::vf_gap;
use t27f::vf_meaning::vf_count_kind;
use course::lesson_01_fpga_intro::scene;
use course::lesson_01_fpga_intro::SCENE_COUNT;
use std::mem::bytes_eq;

pub const L01T_W : u32 = 375;
pub const L01T_H : u32 = 812;

/// g with its theme field set to t.
pub fn l01t_with_theme(g: VfGraph, t: u8) -> VfGraph {
    var n : VfGraph = g;
    n.theme = t;
    return n;
}

/// The token fill of pixel (px, py) under theme t: the fill of the kind of the topmost node, or of kind none on bare background.
pub fn l01t_color(g: VfGraph, l: VfLayout, t: u8, px: u32, py: u32) -> u32 {
    let id : u32 = vf_paint_id(g, l, px, py);
    if id == VF_PX_NONE {
        return vf_fill(t, VF_NONE);
    } else {
        return vf_fill(t, g.kind[id]);
    }
}

/// Pixels of the w x h raster whose token fill differs between theme ta and theme tb.
pub fn l01t_pixels_changed(g: VfGraph, l: VfLayout, ta: u8, tb: u8, w: u32, h: u32) -> u32 {
    var n : u32 = 0;
    var py : u32 = 0;
    while py < h {
        var px : u32 = 0;
        while px < w {
            if l01t_color(g, l, ta, px, py) != l01t_color(g, l, tb, px, py) {
                n = n + 1;
            }
            px = px + 1;
        }
        py = py + 1;
    }
    return n;
}

/// Nodes whose rectangle differs between layout a and layout b; a node that only one of them has counts too.
pub fn l01t_rects_changed(a: VfLayout, b: VfLayout) -> u32 {
    var n : u32 = 0;
    var hi : u32 = a.node_count;
    if b.node_count > hi {
        hi = b.node_count;
    }
    var i : u32 = 0;
    while i < hi {
        if i >= a.node_count or i >= b.node_count {
            n = n + 1;
        } else {
            if a.x[i] != b.x[i] or a.y[i] != b.y[i] or a.w[i] != b.w[i] or a.h[i] != b.h[i] {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

/// Nodes whose meaning line (kind, depth, relation to the previous sibling, gap, text) differs between (ga, la) and (gb, lb).
pub fn l01t_meaning_changed(ga: VfGraph, la: VfLayout, gb: VfGraph, lb: VfLayout) -> u32 {
    var n : u32 = 0;
    var hi : u32 = ga.node_count;
    if gb.node_count > hi {
        hi = gb.node_count;
    }
    var i : u32 = 0;
    while i < hi {
        if i >= ga.node_count or i >= gb.node_count {
            n = n + 1;
        } else {
            var same : bool = true;
            if ga.kind[i] != gb.kind[i] {
                same = false;
            }
            if vf_depth(ga, i) != vf_depth(gb, i) {
                same = false;
            }
            if vf_relation(ga, la, i) != vf_relation(gb, lb, i) {
                same = false;
            }
            if vf_gap(ga, la, i) != vf_gap(gb, lb, i) {
                same = false;
            }
            if !bytes_eq(ga.text[i], gb.text[i]) {
                same = false;
            }
            if !same {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

/// Text, button and badge nodes of g whose label colour fails the AERT check on its fill under theme t.
pub fn l01t_contrast_fail(g: VfGraph, t: u8) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < g.node_count {
        let k : u8 = g.kind[i];
        if k == VF_TEXT or k == VF_BUTTON or k == VF_BADGE {
            if !vf_aert_ok(vf_label(t, k), vf_fill(t, k)) {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

test a_theme_swap_keeps_meaning_and_rectangles {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let ga : VfGraph = l01t_with_theme(scene(s), THEME_LIGHT);
        let gb : VfGraph = l01t_with_theme(scene(s), THEME_DARK);
        let la : VfLayout = vf_layout(ga);
        let lb : VfLayout = vf_layout(gb);
        assert la.node_count > 0;
        assert l01t_meaning_changed(ga, la, gb, lb) == 0;
        assert l01t_rects_changed(la, lb) == 0;
        s = s + 1;
    }
}

test a_theme_swap_changes_pixels_on_every_scene {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        let l : VfLayout = vf_layout(g);
        assert l01t_pixels_changed(g, l, THEME_LIGHT, THEME_DARK, L01T_W, L01T_H) > 0;
        s = s + 1;
    }
}

test a_theme_against_itself_changes_no_pixel {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        let l : VfLayout = vf_layout(g);
        assert l01t_pixels_changed(g, l, THEME_DARK, THEME_DARK, L01T_W, L01T_H) == 0;
        s = s + 1;
    }
}

test a_rectangle_moved_by_one_pixel_is_one_changed_rectangle {
    let l : VfLayout = vf_layout(scene(0));
    var m : VfLayout = vf_layout(scene(0));
    assert l01t_rects_changed(l, m) == 0;
    m.x[4] = m.x[4] + 1;
    assert l01t_rects_changed(l, m) == 1;
}

test a_changed_text_is_one_changed_meaning_line {
    let g : VfGraph = scene(0);
    let l : VfLayout = vf_layout(g);
    var r : VfGraph = scene(0);
    assert l01t_meaning_changed(g, l, r, l) == 0;
    r.text[2] = "another line";
    assert l01t_meaning_changed(g, l, r, l) == 1;
}

test a_missing_node_is_one_changed_rectangle {
    let l : VfLayout = vf_layout(scene(0));
    var m : VfLayout = vf_layout(scene(0));
    m.node_count = m.node_count - 1;
    assert l01t_rects_changed(l, m) == 1;
}

test dark_labels_pass_the_contrast_check {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        assert l01t_contrast_fail(scene(s), THEME_DARK) == 0;
        s = s + 1;
    }
}

test light_failures_are_at_most_the_buttons {
    var s : u8 = 0;
    while s < SCENE_COUNT {
        let g : VfGraph = scene(s);
        assert l01t_contrast_fail(g, THEME_LIGHT) <= vf_count_kind(g, VF_BUTTON as u32);
        s = s + 1;
    }
}

test a_colour_on_itself_fails_the_contrast_check {
    assert !vf_aert_ok(vf_fill(THEME_LIGHT, VF_NONE), vf_fill(THEME_LIGHT, VF_NONE));
    assert vf_aert_ok(vf_label(THEME_DARK, VF_BUTTON), vf_fill(THEME_DARK, VF_BUTTON));
}
