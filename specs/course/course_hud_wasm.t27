// SPDX-License-Identifier: Apache-2.0
; specs/course/course_hud_wasm.t27 -- WASM card for the interactive course HUD in the browser.
; Exports the HUD logic so the browser canvas is only the renderer. No JS is written by hand:
; gen-js / t27b wasm produce the module. Pattern: use-lines = WASM exports (petal_menu_wasm.t27).
; The raster contract (the host chooses nothing):
;   - the wasm module is linked from the generated pub fns plus one glue file, export.zig, which
;     holds one global HudState, one Learner and one raster, and wraps the pub fns as `export fn`.
;   - the raster is 375 x 812 x 3 bytes of RGB (FB_BYTES = 913500) inside the wasm `memory`.
;   - six exports: hud_reset(), hud_event(ev, x, y), hud_answer(a), hud_paint(), fb_ptr() -> usize,
;     hud_screen() -> u8 (SCR_OVERVIEW, SCR_SCENE, SCR_MENU, SCR_PROGRESS).
;   - the host sends events in (EV_UP, EV_DOWN, EV_ENTER, EV_BACK, EV_TAP with canvas x, y,
;     EV_MENU, EV_TICK) and does one putImageData of the raster per frame; nothing else.
;   - clear, fill_rect, draw_text and the other canvas primitives happen inside the wasm, in the
;     t27 painters; the state machine, hit tests and numbers are t27 as well.
; Refs gHashTag/t27#13251
; phi^2 + 1/phi^2 = 3 | TRINITY

module course_hud_wasm;

; --- state machine: packed u64 state, events, screens, field selectors ---
use course::course_hud_state::hud_init_packed;
use course::course_hud_state::hud_step_packed;
use course::course_hud_state::hud_field;
use course::course_hud_state::SCR_OVERVIEW;
use course::course_hud_state::SCR_SCENE;
use course::course_hud_state::SCR_MENU;
use course::course_hud_state::SCR_PROGRESS;
use course::course_hud_state::EV_UP;
use course::course_hud_state::EV_DOWN;
use course::course_hud_state::EV_ENTER;
use course::course_hud_state::EV_BACK;
use course::course_hud_state::EV_TAP;
use course::course_hud_state::EV_MENU;
use course::course_hud_state::EV_TICK;
use course::course_hud_state::F_SCREEN;
use course::course_hud_state::F_PREV;
use course::course_hud_state::F_SEL;
use course::course_hud_state::F_SCENE;
use course::course_hud_state::F_MENU;
use course::course_hud_state::F_HOVER;
use course::course_hud_state::F_VISITED;
use course::course_hud_state::F_TICK;

; --- navigation geometry: hit tests and petal pixel centres ---
use course::course_hud_nav::nav_hit;
use course::course_hud_nav::menu_hit;
use course::course_hud_nav::petal_px;
use course::course_hud_nav::petal_py;
use course::course_hud_nav::HUD_W;
use course::course_hud_nav::HUD_H;
use course::course_hud_nav::HDR_H;
use course::course_hud_nav::CARD_H;
use course::course_hud_nav::HIT_NONE;
use course::course_hud_nav::HIT_MENU;
use course::course_hud_nav::HIT_BACK;
use course::course_hud_nav::WORLD_UNIVERSITY;
use course::course_hud_nav::PETAL_R;

; --- progress numbers ---
use course::course_hud_data::progress_permille;
use course::course_hud_data::tasks_done;
use course::course_hud_data::tasks_total;
use course::course_hud_data::build_permille;
use course::course_hud_data::lessons_total;

; --- petal menu geometry and colours (0xAARRGGBB) ---
use t27f::petal_menu::vx;
use t27f::petal_menu::vy;
use t27f::petal_menu::fill;
use t27f::petal_menu::glow_alpha_permille;
use t27f::petal_menu::petal_letter_byte;
use t27f::petal_menu::centre_x;
use t27f::petal_menu::centre_y;
use t27f::petal_menu::PETAL_COUNT;
use t27f::petal_menu::BOX_W;
use t27f::petal_menu::BOX_H;

; --- raster size: 375 x 812 x 3 bytes of RGB ---
pub const FB_BYTES : u32 = 913500;

; --- tests: pin the exported surface; every test asserts a return value ---

test init_state_is_overview {
    assert hud_field(hud_init_packed(), F_SCREEN) == SCR_OVERVIEW;
}

test tap_transition_through_nav_hit {
    const s0 : u64 = hud_init_packed();
    const s1 : u64 = hud_step_packed(s0, EV_TAP, nav_hit(187, 100), 255);
    assert hud_field(s1, F_SCREEN) == SCR_SCENE;
    const s2 : u64 = hud_step_packed(s0, EV_TAP, nav_hit(360, 20), 255);
    assert hud_field(s2, F_SCREEN) == SCR_MENU;
}

test tick_keeps_overview {
    const s1 : u64 = hud_step_packed(hud_init_packed(), EV_TICK, 255, 255);
    assert hud_field(s1, F_SCREEN) == SCR_OVERVIEW;
}

test university_petal_inside_hud {
    assert petal_px(WORLD_UNIVERSITY) >= 0;
    assert petal_px(WORLD_UNIVERSITY) < HUD_W;
    assert petal_py(WORLD_UNIVERSITY) < HUD_H;
}

test all_visited_is_full_progress {
    assert progress_permille(127) == 1000;
}

test tasks_done_within_total {
    assert tasks_done() <= tasks_total();
}

test petal_menu_surface {
    assert PETAL_COUNT == 27;
    assert petal_letter_byte(0) == 65;
    // website look: idle and hover petals are both white, the hover cue is the glow
    assert fill(0, 0, 255) != fill(0, 255, 0);
    assert glow_alpha_permille(0, 255, 0) > glow_alpha_permille(0, 255, 255);
}

test raster_is_rgb_375_812 {
    assert FB_BYTES == HUD_W * HUD_H * 3;
}
