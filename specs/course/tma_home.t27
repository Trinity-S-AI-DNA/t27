module CourseTmaHome;

; t27ai_bot Mini App home — 375 × 812 px
; Palette: ground #000000  text #ffffff  accent #00ff88  gold #ffd700
; Sections: header, greeting, hero card, 3 quick actions, 4 popular rows, 4-tab bar

pub const TMA_W : u16 = 375;
pub const TMA_H : u16 = 812;

; node kinds
pub const TMA_K_GROUND   : u8 = 0;
pub const TMA_K_HEADER   : u8 = 1;
pub const TMA_K_GREETING : u8 = 2;
pub const TMA_K_HERO     : u8 = 3;
pub const TMA_K_ACTION   : u8 = 4;
pub const TMA_K_POPULAR  : u8 = 5;
pub const TMA_K_TAB      : u8 = 6;

; R channel of the flat token fill for each node kind
pub fn tma_r(kind: u8) -> u8 {
    if kind == TMA_K_GREETING { return 255; }
    if kind == TMA_K_ACTION   { return 255; }
    if kind == TMA_K_HERO     { return 0; }
    if kind == TMA_K_POPULAR  { return 255; }
    return 0;
}

; G channel
pub fn tma_g(kind: u8) -> u8 {
    if kind == TMA_K_GREETING { return 255; }
    if kind == TMA_K_ACTION   { return 255; }
    if kind == TMA_K_HERO     { return 255; }
    if kind == TMA_K_POPULAR  { return 215; }
    return 0;
}

; B channel
pub fn tma_b(kind: u8) -> u8 {
    if kind == TMA_K_GREETING { return 255; }
    if kind == TMA_K_ACTION   { return 255; }
    if kind == TMA_K_HERO     { return 136; }
    if kind == TMA_K_POPULAR  { return 0; }
    return 0;
}

test "frame is 375x812" {
    assert TMA_W == 375;
    assert TMA_H == 812;
}

test "ground is black" {
    assert tma_r(TMA_K_GROUND) == 0;
    assert tma_g(TMA_K_GROUND) == 0;
    assert tma_b(TMA_K_GROUND) == 0;
}

test "text is white" {
    assert tma_r(TMA_K_GREETING) == 255;
    assert tma_g(TMA_K_GREETING) == 255;
    assert tma_b(TMA_K_GREETING) == 255;
}

test "accent is 00ff88" {
    assert tma_r(TMA_K_HERO) == 0;
    assert tma_g(TMA_K_HERO) == 255;
    assert tma_b(TMA_K_HERO) == 136;
}

test "gold is ffd700" {
    assert tma_r(TMA_K_POPULAR) == 255;
    assert tma_g(TMA_K_POPULAR) == 215;
    assert tma_b(TMA_K_POPULAR) == 0;
}

test "accent and gold differ" {
    assert tma_r(TMA_K_HERO)    != tma_r(TMA_K_POPULAR);
    assert tma_b(TMA_K_POPULAR) != tma_b(TMA_K_HERO);
}
