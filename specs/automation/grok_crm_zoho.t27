// specs/automation/grok_crm_zoho.t27 -- grok crm: zoho mail decision.
// Part of M8 milestone (milestone #12). Closes #13459.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::grok_crm_zoho;

pub const GROK_CRM_ZOHO_MAIL_ENABLED : bool = false;

pub struct ZohoMailDecision { enabled: bool, approved: bool };

pub fn zoho_mail_decision_approved(d: ZohoMailDecision) -> bool {
    return d.enabled && d.approved;
}

test "zoho_mail_decision_approved" {
    assert(zoho_mail_decision_approved(ZohoMailDecision { enabled: true, approved: true }));
    assert(!zoho_mail_decision_approved(ZohoMailDecision { enabled: true, approved: false }));
    assert(!zoho_mail_decision_approved(ZohoMailDecision { enabled: false, approved: true }));
}

invariant grok_crm_zoho_mail_enabled_default {
    assert !GROK_CRM_ZOHO_MAIL_ENABLED;
}