// specs/automation/grok_crm_browser.t27 -- grok crm: browser commands.
// Part of M8 milestone (milestone #12). Closes #13458.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::grok_crm_browser;

pub const GROK_CRM_BROWSER_COMMANDS_MAX : u32 = 16;

pub struct BrowserCommand { name: str, executed: bool };

pub fn browser_command_executed(c: BrowserCommand) -> bool {
    return c.executed;
}

test "browser_command_executed" {
    assert(browser_command_executed(BrowserCommand { name: "open", executed: true }));
    assert(!browser_command_executed(BrowserCommand { name: "close", executed: false }));
}

invariant grok_crm_browser_commands_max_positive {
    assert GROK_CRM_BROWSER_COMMANDS_MAX > 0;
}