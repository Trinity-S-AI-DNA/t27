// SPDX-License-Identifier: Apache-2.0
// specs/automation/grok_crm.t27 -- one CRM contract for the Grok work bot and the Zoho inbox.
// Host: none. This module decides. BrowserOS neo reads the mailbox. T27L stores the line.
// It does not send, delete, close a deal, move money, or keep a second journal.
// Identity of a letter stays the enumeration message id, as specs/automation/mail-push.t27.
// The office CRM in specs/automation/bot-office-crm.t27 is a different contour and is not extended here.
// Audit lines are t27l/v1 on surface "agent" (id 11). The payload word is grok_crm. No new surface id.
// Actions reused: route_decision 26 (a classification), llm_call 25 (a draft), task_claimed 32 (a task).
// Measured 2026-11-09 on the signed-in dashboard (account hash accepted, plan label Super):
// weekly included usage 1 percent, resets Nov 16; included tokens Nov 1-9 were 44477703;
// credit usage $0; monthly extra limit not set. No instruction field exists that is not a
// Slack routing rule, so no rule was written and no integration was connected.
// The same day the Notification folder was already signed in. Message 1794237827646153000
// is a no-reply sign-in notice. Its one-time code was not stored. Decision: archive, no person.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::grok_crm {

    pub const KIND : str = "automation";
    pub const ID : str = "grok-crm";
    pub const VERSION : u8 = 1;

    // ---- session, measured 2026-11-09; the percents live in the header, not in a test ----
    pub const GROK_SESSION_LIVE : bool = true;
    pub const GROK_PLAN_SUPER : bool = true;
    pub const GROK_INSTRUCTION_FIELD : bool = false;
    pub const GROK_RULE_WRITTEN : bool = false;
    pub const PAID_MODEL_SWITCH : bool = false;
    pub const ZOHO_SESSION_LIVE : bool = true;
    pub const ZOHO_MFA_WALL : bool = false;
    pub const VIEW_LIMIT : u8 = 25;  // the mail-push window; this cycle classified one letter

    // ---- actors (canonical ids). Never copy one into a T27L payload: '@' is redacted there. ----
    pub const ACTOR_MAIL : str = "0xMailSteward@integration.t27";
    pub const ACTOR_CRM : str = "0xCRMSteward@product.t27";
    pub const ACTOR_GROK : str = "0xGrokAnalyst@research.t27";
    pub const ACTOR_GUARD : str = "0xApprovalGuard@governance.t27";
    pub const ACTOR_AUDIT : str = "0xAuditKeeper@telemetry.t27";

    // ---- entities: 1 person .. 14 audit event ----
    pub const ENT_PERSON : u8 = 1;
    pub const ENT_COMPANY : u8 = 2;
    pub const ENT_DEAL : u8 = 3;
    pub const ENT_TASK : u8 = 4;
    pub const ENT_THREAD : u8 = 5;
    pub const ENT_MESSAGE : u8 = 6;
    pub const ENT_ATTACHMENT : u8 = 7;
    pub const ENT_FOLLOWUP : u8 = 8;
    pub const ENT_NOTE : u8 = 9;
    pub const ENT_TAG : u8 = 10;
    pub const ENT_PIPELINE : u8 = 11;
    pub const ENT_ACTIVITY : u8 = 12;
    pub const ENT_APPROVAL : u8 = 13;
    pub const ENT_AUDIT : u8 = 14;

    // ---- contact / deal / task / mail states ----
    pub const C_NEW : u8 = 1;
    pub const C_QUALIFIED : u8 = 2;
    pub const C_ACTIVE : u8 = 3;
    pub const C_DORMANT : u8 = 4;
    pub const C_ARCHIVED : u8 = 5;

    pub const D_NEW : u8 = 1;
    pub const D_QUALIFIED : u8 = 2;
    pub const D_PROPOSAL : u8 = 3;
    pub const D_NEGOTIATION : u8 = 4;
    pub const D_WON : u8 = 5;
    pub const D_LOST : u8 = 6;
    pub const D_ARCHIVED : u8 = 7;

    pub const T_NEW : u8 = 1;
    pub const T_PROGRESS : u8 = 2;
    pub const T_WAITING : u8 = 3;
    pub const T_BLOCKED : u8 = 4;
    pub const T_DONE : u8 = 5;
    pub const T_CANCELLED : u8 = 6;

    pub const M_UNREAD : u8 = 1;
    pub const M_TRIAGED : u8 = 2;
    pub const M_AWAITING : u8 = 3;
    pub const M_REPLIED : u8 = 4;
    pub const M_ARCHIVED : u8 = 5;
    pub const M_SPAM : u8 = 6;
    pub const M_REVIEW : u8 = 7;

    // ---- intent -> one decision. 9 is a system notice (sign-in, no-reply): archive, no person. ----
    pub const INTENT_UNKNOWN : u8 = 0;
    pub const INTENT_LEAD : u8 = 1;
    pub const INTENT_CUSTOMER : u8 = 2;
    pub const INTENT_SUPPORT : u8 = 3;
    pub const INTENT_PARTNER : u8 = 4;
    pub const INTENT_INVOICE : u8 = 5;
    pub const INTENT_RECRUIT : u8 = 6;
    pub const INTENT_SPAM : u8 = 7;
    pub const INTENT_NEWSLETTER : u8 = 8;
    pub const INTENT_SYSTEM : u8 = 9;

    pub const DEC_REVIEW : u8 = 1;
    pub const DEC_LEAD : u8 = 2;
    pub const DEC_UPDATE : u8 = 3;
    pub const DEC_SUPPORT : u8 = 4;
    pub const DEC_PARTNER : u8 = 5;
    pub const DEC_FINANCE : u8 = 6;
    pub const DEC_RECRUIT : u8 = 7;
    pub const DEC_SPAM : u8 = 8;
    pub const DEC_ARCHIVE : u8 = 9;

    // ---- dedup ----
    pub const DEDUP_CREATE : u8 = 1;
    pub const DEDUP_UPDATE : u8 = 2;
    pub const DEDUP_REVIEW : u8 = 3;

    // ---- outcomes. There is no "sent". ----
    pub const OUT_CREATED : u8 = 1;
    pub const OUT_UPDATED : u8 = 2;
    pub const OUT_WAIT : u8 = 3;
    pub const OUT_BLOCKED : u8 = 4;

    // ---- approval kinds that cannot proceed alone ----
    pub const AP_REPLY : u8 = 1;
    pub const AP_FORWARD : u8 = 2;
    pub const AP_NEW_MAIL : u8 = 3;
    pub const AP_DELETE : u8 = 4;
    pub const AP_CLOSE : u8 = 5;
    pub const AP_FINANCE : u8 = 6;
    pub const AP_SHARE : u8 = 7;
    pub const AP_EXPORT : u8 = 8;

    // ---- grok commands 1..12, browser commands 1..8 ----
    pub const CMD_SCAN : u8 = 1;
    pub const CMD_TRIAGE : u8 = 2;
    pub const CMD_SUMMARY : u8 = 3;
    pub const CMD_CONTACT : u8 = 4;
    pub const CMD_DEAL : u8 = 5;
    pub const CMD_TASK : u8 = 6;
    pub const CMD_DRAFT : u8 = 7;
    pub const CMD_FOLLOWUP : u8 = 8;
    pub const CMD_PROPOSE : u8 = 9;
    pub const CMD_DEDUP : u8 = 10;
    pub const CMD_APPROVAL : u8 = 11;
    pub const CMD_AUDIT : u8 = 12;

    pub const BR_OPEN : u8 = 1;
    pub const BR_READ : u8 = 2;
    pub const BR_FILES : u8 = 3;
    pub const BR_DRAFT : u8 = 4;
    pub const BR_RECORD : u8 = 5;
    pub const BR_FIELD : u8 = 6;
    pub const BR_SHOT : u8 = 7;
    pub const BR_SAVE : u8 = 8;

    // ---- failure: stop. Never a paid model. ----
    pub const FAIL_MFA : u8 = 1;
    pub const FAIL_BROWSER : u8 = 2;
    pub const FAIL_RATE : u8 = 3;

    // ---- T27L projection (specs/t27os/t27l.t27) ----
    pub const TL_ACTOR_AGENT : u8 = 2;
    pub const TL_SURFACE_AGENT : u8 = 11;
    pub const TL_ACTION_ROUTE : u8 = 26;
    pub const TL_ACTION_LLM : u8 = 25;
    pub const TL_ACTION_TASK : u8 = 32;
    pub const TL_LEVEL_INFO : u8 = 2;

    // ---- screen panes. The window file is not edited in this cycle. ----
    pub const PANE_INBOX : u8 = 1;
    pub const PANE_CONTACTS : u8 = 2;
    pub const PANE_COMPANIES : u8 = 3;
    pub const PANE_DEALS : u8 = 4;
    pub const PANE_TASKS : u8 = 5;
    pub const PANE_FOLLOWUPS : u8 = 6;
    pub const PANE_APPROVALS : u8 = 7;
    pub const PANE_AUDIT : u8 = 8;
    pub const PANE_SEARCH : u8 = 9;

    // ---- first letter, 2026-11-09. No body, no code, no address. ----
    pub const FIRST_MESSAGE_ID : u64 = 1794237827646153000;
    pub const FIRST_INTENT : u8 = 9;
    pub const FIRST_URGENCY : u8 = 3;
    pub const FIRST_CONTACT_CREATED : bool = false;
    pub const FIRST_OTP_STORED : bool = false;
    pub const FIRST_BODY_STORED : bool = false;
    pub const FIRST_SENT : bool = false;
    pub const GROK_USAGE_SHOT : bool = true;
    pub const ZOHO_BODY_SHOT : bool = false;

    pub const GC_EVENT_ID : str = "b27c0e11-4b0a-4c27-8d11-0a27c0e11b27";
    pub const GC_EVENT_TS : str = "2026-11-09T15:37:00Z";

    use t27os::t27l::tl_event_line;
    use t27os::t27l::tl_validate_line;
    use t27os::t27l::TL_OK;
    use std::mem::bytes_eq;

    pub fn entity_known(e: u8) -> bool {
        return e >= ENT_PERSON && e <= ENT_AUDIT;
    }

    pub fn id_ok(s: []const u8) -> bool {
        if (s.len < 8) { return false; }
        if (s[0] != '0' || s[1] != 'x') { return false; }
        if (s[s.len - 4] != '.' || s[s.len - 3] != 't' || s[s.len - 2] != '2' || s[s.len - 1] != '7') {
            return false;
        }
        var at : u8 = 0;
        var i : usize = 0;
        while (i < s.len) {
            const c : u8 = s[i];
            if (c == ' ' || c == '/') { return false; }
            if (c == '@') {
                if (i < 3 || i + 6 >= s.len) { return false; }
                at = at + 1;
            }
            i = i + 1;
        }
        return at == 1;
    }

    pub fn same_canon(a: []const u8, b: []const u8) -> bool {
        return bytes_eq(a, b);
    }

    /// One intent, one decision. 0 means the letter is still unclassified, which is refused.
    pub fn mail_decision(intent: u8) -> u8 {
        if (intent == INTENT_LEAD) { return DEC_LEAD; }
        if (intent == INTENT_CUSTOMER) { return DEC_UPDATE; }
        if (intent == INTENT_SUPPORT) { return DEC_SUPPORT; }
        if (intent == INTENT_PARTNER) { return DEC_PARTNER; }
        if (intent == INTENT_INVOICE) { return DEC_FINANCE; }
        if (intent == INTENT_RECRUIT) { return DEC_RECRUIT; }
        if (intent == INTENT_SPAM) { return DEC_SPAM; }
        if (intent == INTENT_NEWSLETTER) { return DEC_ARCHIVE; }
        if (intent == INTENT_SYSTEM) { return DEC_ARCHIVE; }
        if (intent == INTENT_UNKNOWN) { return DEC_REVIEW; }
        return 0;
    }

    pub fn decision_makes_person(d: u8) -> bool {
        return d == DEC_LEAD || d == DEC_UPDATE || d == DEC_PARTNER;
    }

    /// Email, external id, or phone is a high match (update). Domain or name alone is a review.
    /// Nothing matched: create. Low confidence never auto-merges.
    pub fn dedup_verdict(email_hit: bool, domain_hit: bool, name_hit: bool, external_hit: bool, phone_hit: bool) -> u8 {
        if (email_hit || external_hit || phone_hit) { return DEDUP_UPDATE; }
        if (domain_hit || name_hit) { return DEDUP_REVIEW; }
        return DEDUP_CREATE;
    }

    pub fn approval_required(kind: u8) -> bool {
        return kind >= AP_REPLY && kind <= AP_EXPORT;
    }

    pub fn approval_record_ok(actor: bool, action: bool, target: bool, draft: bool, risk: bool, by: bool, at: bool, evidence: bool, outcome: bool) -> bool {
        return actor && action && target && draft && risk && by && at && evidence && outcome;
    }

    pub fn may_delete() -> bool { return false; }
    pub fn may_close_deal() -> bool { return false; }
    pub fn may_pay() -> bool { return false; }
    pub fn may_transmit() -> bool { return false; }

    /// A grok command produces an artifact or a proposal. A draft and a CRM write wait.
    /// The approved flag does not transmit: this module has no send.
    pub fn grok_command(id: u8, approved: bool) -> u8 {
        if (id < CMD_SCAN || id > CMD_AUDIT) { return OUT_BLOCKED; }
        if (id == CMD_DRAFT || id == CMD_PROPOSE || id == CMD_APPROVAL) { return OUT_WAIT; }
        if (approved) { return OUT_UPDATED; }
        return OUT_CREATED;
    }

    /// Browser commands stop without a session. A draft waits. A field write waits
    /// until approved. Nothing here transmits.
    pub fn browser_command(id: u8, authed: bool, approved: bool) -> u8 {
        if (id < BR_OPEN || id > BR_SAVE) { return OUT_BLOCKED; }
        if (!authed) { return OUT_BLOCKED; }
        if (id == BR_DRAFT) { return OUT_WAIT; }
        if (id == BR_FIELD && !approved) { return OUT_WAIT; }
        if (id == BR_FIELD) { return OUT_UPDATED; }
        return OUT_CREATED;
    }

    pub fn failure_mode(kind: u8) -> u8 {
        if (kind == FAIL_MFA || kind == FAIL_BROWSER || kind == FAIL_RATE) { return OUT_BLOCKED; }
        return 0;
    }

    pub fn failure_switches_model(kind: u8) -> bool {
        if (kind == FAIL_RATE) { return PAID_MODEL_SWITCH; }
        return false;
    }

    pub fn screen_pane_ok(p: u8) -> bool {
        return p >= PANE_INBOX && p <= PANE_SEARCH;
    }

    pub fn state_known(kind: u8, st: u8) -> bool {
        if (kind == ENT_PERSON) { return st >= C_NEW && st <= C_ARCHIVED; }
        if (kind == ENT_DEAL) { return st >= D_NEW && st <= D_ARCHIVED; }
        if (kind == ENT_TASK) { return st >= T_NEW && st <= T_CANCELLED; }
        if (kind == ENT_MESSAGE) { return st >= M_UNREAD && st <= M_REVIEW; }
        return false;
    }

    /// One T27L line. Payload must not carry an address or a secret. 0 when the action is not one of the three.
    pub fn gc_event(out: []u8, event_id: []const u8, ts: []const u8, device_id: []const u8, session_id: []const u8,
                    actor: u8, action: u8, level: u8, payload: []const u8, evidence_csv: []const u8) -> usize {
        if (action != TL_ACTION_ROUTE && action != TL_ACTION_LLM && action != TL_ACTION_TASK) { return 0; }
        return tl_event_line(out, event_id, ts, device_id, session_id, actor, TL_SURFACE_AGENT, action, level,
                             "", "", "", payload, evidence_csv);
    }

    test "canonical ids are unique and well formed" {
        assert(id_ok(ACTOR_MAIL));
        assert(id_ok(ACTOR_CRM));
        assert(id_ok(ACTOR_GROK));
        assert(id_ok(ACTOR_GUARD));
        assert(id_ok(ACTOR_AUDIT));
        assert(!same_canon(ACTOR_MAIL, ACTOR_CRM));
        assert(!same_canon(ACTOR_GROK, ACTOR_GUARD));
        assert(!id_ok("mail"));
        assert(!id_ok("0xMail@x"));
        assert(entity_known(ENT_PERSON));
        assert(entity_known(ENT_AUDIT));
        assert(!entity_known(0));
    }

    test "every intent yields exactly one decision" {
        assert(mail_decision(INTENT_LEAD) == DEC_LEAD);
        assert(mail_decision(INTENT_CUSTOMER) == DEC_UPDATE);
        assert(mail_decision(INTENT_SUPPORT) == DEC_SUPPORT);
        assert(mail_decision(INTENT_PARTNER) == DEC_PARTNER);
        assert(mail_decision(INTENT_INVOICE) == DEC_FINANCE);
        assert(mail_decision(INTENT_RECRUIT) == DEC_RECRUIT);
        assert(mail_decision(INTENT_SPAM) == DEC_SPAM);
        assert(mail_decision(INTENT_NEWSLETTER) == DEC_ARCHIVE);
        assert(mail_decision(INTENT_SYSTEM) == DEC_ARCHIVE);
        assert(mail_decision(INTENT_UNKNOWN) == DEC_REVIEW);
        assert(mail_decision(10) == 0);
        assert(decision_makes_person(DEC_LEAD));
        assert(!decision_makes_person(DEC_ARCHIVE));
        assert(!decision_makes_person(DEC_SPAM));
        assert(!decision_makes_person(DEC_REVIEW));
    }

    test "dedup updates only a high match" {
        assert(dedup_verdict(true, false, false, false, false) == DEDUP_UPDATE);
        assert(dedup_verdict(false, false, false, true, false) == DEDUP_UPDATE);
        assert(dedup_verdict(false, false, false, false, true) == DEDUP_UPDATE);
        assert(dedup_verdict(false, true, false, false, false) == DEDUP_REVIEW);
        assert(dedup_verdict(false, false, true, false, false) == DEDUP_REVIEW);
        assert(dedup_verdict(false, false, false, false, false) == DEDUP_CREATE);
        assert(dedup_verdict(true, true, true, false, false) == DEDUP_UPDATE);
    }

    test "outbound, deletion, closure and payment stay closed" {
        assert(approval_required(AP_REPLY));
        assert(approval_required(AP_FORWARD));
        assert(approval_required(AP_NEW_MAIL));
        assert(approval_required(AP_DELETE));
        assert(approval_required(AP_CLOSE));
        assert(approval_required(AP_FINANCE));
        assert(approval_required(AP_SHARE));
        assert(approval_required(AP_EXPORT));
        assert(!approval_required(0));
        assert(approval_record_ok(true, true, true, true, true, true, true, true, true));
        assert(!approval_record_ok(true, true, true, true, true, false, true, true, true));
        assert(!may_delete());
        assert(!may_close_deal());
        assert(!may_pay());
        assert(!may_transmit());
    }

    test "grok commands never send" {
        assert(grok_command(CMD_SCAN, false) == OUT_CREATED);
        assert(grok_command(CMD_TRIAGE, false) == OUT_CREATED);
        assert(grok_command(CMD_SUMMARY, false) == OUT_CREATED);
        assert(grok_command(CMD_CONTACT, false) == OUT_CREATED);
        assert(grok_command(CMD_DEAL, false) == OUT_CREATED);
        assert(grok_command(CMD_TASK, false) == OUT_CREATED);
        assert(grok_command(CMD_FOLLOWUP, false) == OUT_CREATED);
        assert(grok_command(CMD_DEDUP, false) == OUT_CREATED);
        assert(grok_command(CMD_AUDIT, false) == OUT_CREATED);
        assert(grok_command(CMD_DRAFT, true) == OUT_WAIT);
        assert(grok_command(CMD_PROPOSE, true) == OUT_WAIT);
        assert(grok_command(CMD_APPROVAL, false) == OUT_WAIT);
        assert(grok_command(0, true) == OUT_BLOCKED);
        assert(grok_command(13, true) == OUT_BLOCKED);
    }

    test "browser commands respect the session and do not send" {
        assert(browser_command(BR_OPEN, false, false) == OUT_BLOCKED);
        assert(browser_command(BR_READ, true, false) == OUT_CREATED);
        assert(browser_command(BR_FILES, true, false) == OUT_CREATED);
        assert(browser_command(BR_DRAFT, true, true) == OUT_WAIT);
        assert(browser_command(BR_RECORD, true, false) == OUT_CREATED);
        assert(browser_command(BR_FIELD, true, false) == OUT_WAIT);
        assert(browser_command(BR_FIELD, true, true) == OUT_UPDATED);
        assert(browser_command(BR_SHOT, true, false) == OUT_CREATED);
        assert(browser_command(BR_SAVE, true, false) == OUT_CREATED);
        assert(browser_command(0, true, true) == OUT_BLOCKED);
    }

    test "a failure stops and does not switch to a paid model" {
        assert(failure_mode(FAIL_MFA) == OUT_BLOCKED);
        assert(failure_mode(FAIL_BROWSER) == OUT_BLOCKED);
        assert(failure_mode(FAIL_RATE) == OUT_BLOCKED);
        assert(failure_mode(0) == 0);
        assert(!failure_switches_model(FAIL_RATE));
        assert(!failure_switches_model(FAIL_MFA));
        assert(!PAID_MODEL_SWITCH);
        assert(!GROK_RULE_WRITTEN);
    }

    test "nine panes, and the states stay inside their ranges" {
        assert(screen_pane_ok(PANE_INBOX));
        assert(screen_pane_ok(PANE_SEARCH));
        assert(!screen_pane_ok(0));
        assert(!screen_pane_ok(10));
        assert(state_known(ENT_PERSON, C_NEW));
        assert(state_known(ENT_PERSON, C_ARCHIVED));
        assert(!state_known(ENT_PERSON, 0));
        assert(state_known(ENT_DEAL, D_WON));
        assert(!state_known(ENT_DEAL, 8));
        assert(state_known(ENT_TASK, T_BLOCKED));
        assert(state_known(ENT_MESSAGE, M_REVIEW));
        assert(!state_known(ENT_NOTE, 1));
    }

    test "the first letter is archived without a person, a body, or a send" {
        assert(ZOHO_SESSION_LIVE);
        assert(!ZOHO_MFA_WALL);
        assert(GROK_SESSION_LIVE);
        assert(GROK_PLAN_SUPER);
        assert(FIRST_MESSAGE_ID == 1794237827646153000);
        assert(FIRST_INTENT == INTENT_SYSTEM);
        assert(mail_decision(FIRST_INTENT) == DEC_ARCHIVE);
        assert(FIRST_URGENCY == 3);
        assert(!FIRST_CONTACT_CREATED);
        assert(!decision_makes_person(mail_decision(FIRST_INTENT)));
        assert(!FIRST_OTP_STORED);
        assert(!FIRST_BODY_STORED);
        assert(!FIRST_SENT);
        assert(GROK_USAGE_SHOT);
        assert(!ZOHO_BODY_SHOT);
        assert(VIEW_LIMIT == 25);
    }

    test "the triage line is a valid T27L event and carries no address" {
        var ln : [2048]u8 = undefined;
        const n : usize = gc_event(ln[0..2048], GC_EVENT_ID, GC_EVENT_TS, "mac-1", "sess-1",
                                   TL_ACTOR_AGENT, TL_ACTION_ROUTE, TL_LEVEL_INFO,
                                   "grok_crm intent=9 urgency=3 decision=9", "");
        assert(n > 0);
        assert(tl_validate_line(ln[0..n]) == TL_OK);
        assert(gc_event(ln[0..2048], GC_EVENT_ID, GC_EVENT_TS, "mac-1", "sess-1",
                        TL_ACTOR_AGENT, 1, TL_LEVEL_INFO, "grok_crm", "") == 0);
    }

    invariant one_letter_one_decision {
        assert mail_decision(INTENT_UNKNOWN) != 0;
        assert mail_decision(INTENT_SYSTEM) == DEC_ARCHIVE;
        assert may_transmit() == false;
    }

    invariant no_silent_deletion {
        assert may_delete() == false;
        assert may_close_deal() == false;
        assert may_pay() == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
