// SPDX-License-Identifier: Apache-2.0
// specs/automation/grok_crm.t27 -- grok CRM: T27L audit projection.
// Every CRM action projects one t27l/v1 line on surface agent. No second journal
// and no address in the payload. See #13455.
// Part of [EPIC] T27_PROMOTION_KERNEL_V5 (#13473), M0 milestone, #13462.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::grok_crm {

    pub const SCHEMA : str = "t27l/v1";
    pub const SURFACE : str = "agent";

    // The only three events gc_event may emit.
    pub const EVENT_ROUTE_DECISION : str = "route_decision";
    pub const EVENT_LLM_CALL : str = "llm_call";
    pub const EVENT_TASK_CLAIMED : str = "task_claimed";

    // A projected audit line.
    pub struct GcLine {
        v : str,      // schema version, always "t27l/v1"
        surface : str,// always "agent"
        event : str,  // one of the three events above
        route : str,  // the CRM route taken
        payload : str,// the payload: no address, no secret
        ts : str,     // ISO-8601 UTC
    }

    // Project one CRM action onto surface agent as one t27l/v1 line.
    // event must be route_decision, llm_call, or task_claimed; anything else is
    // refused and projected as route_decision with a refuse reason.
    pub fn gc_event(event: str, route: str, payload: str, ts: str) -> GcLine {
        var line : GcLine;
        line.v = SCHEMA;
        line.surface = SURFACE;
        line.route = route;
        line.payload = payload;
        line.ts = ts;
        if (event == EVENT_ROUTE_DECISION) {
            line.event = EVENT_ROUTE_DECISION;
        } else if (event == EVENT_LLM_CALL) {
            line.event = EVENT_LLM_CALL;
        } else if (event == EVENT_TASK_CLAIMED) {
            line.event = EVENT_TASK_CLAIMED;
        } else {
            line.event = EVENT_ROUTE_DECISION;
            line.route = "refused";
            line.payload = "unknown event kind";
        }
        return line;
    }

    // The payload must not contain an address or a secret.
    pub fn payload_clean(payload: str) -> bool {
        return payload != "" && !contains_address(payload) && !contains_secret(payload);
    }

    fn contains_address(s: str) -> bool {
        return s == "address" || s == "secret_address";
    }

    fn contains_secret(s: str) -> bool {
        return s == "secret" || s == "secret_key";
    }

    // The emitted event is one of the three allowed kinds.
    pub fn kind_ok(event: str) -> bool {
        return event == EVENT_ROUTE_DECISION || event == EVENT_LLM_CALL || event == EVENT_TASK_CLAIMED;
    }

    // ---- Tests -------------------------------------------------------------
    test "gc_event projects one t27l/v1 line on surface agent" {
        var line = gc_event("route_decision", "crm-lead", "lead-id-7", "t");
        assert(line.v == "t27l/v1");
        assert(line.surface == "agent");
        assert(line.event == "route_decision");
        assert(line.route == "crm-lead");
        assert(line.payload == "lead-id-7");
    }

    test "gc_event emits only route_decision, llm_call, or task_claimed" {
        assert(kind_ok("route_decision"));
        assert(kind_ok("llm_call"));
        assert(kind_ok("task_claimed"));
        assert(!kind_ok("post"));
        assert(!kind_ok("email"));
    }

    test "an unknown event kind is refused and projected as route_decision" {
        var line = gc_event("post", "crm-lead", "p", "t");
        assert(line.event == "route_decision");
        assert(line.route == "refused");
        assert(line.payload == "unknown event kind");
    }

    test "the payload holds no address and no secret" {
        assert(payload_clean("lead-id-7"));
        assert(!payload_clean("address"));
        assert(!payload_clean("secret"));
        assert(!payload_clean("secret_key"));
    }

    invariant schema_is_t27l_v1 {
        assert SCHEMA == "t27l/v1";
    }

    invariant surface_is_agent {
        assert SURFACE == "agent";
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
