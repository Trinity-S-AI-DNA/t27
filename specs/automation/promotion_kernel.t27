// SPDX-License-Identifier: Apache-2.0
// specs/automation/promotion_kernel.t27 -- proof-to-demand gate for T27.
// A post is publishable only with a checked claim, an artifact, a path, a visual,
// one CTA and one metric. This module does not post, send mail, or spend tokens.
// Catalog counts are numeric::paper_claims (109 records, 13 clusters). The order's
// "84 formats" and "12 clusters" are not publishable as written.
// Mail law stays in specs/automation/grok_crm.t27. The course audit is
// specs/course/fpga_course_v2.t27: 27 lessons, widgets are not all compiled specs.
// X baseline measured 2026-11-09 on @t27_dev, plan Super, 7-day analytics.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::promotion_kernel {

    pub const KIND : str = "automation";
    pub const ID : str = "promotion-kernel";
    pub const VERSION : u8 = 1;

    use numeric::paper_claims::CATALOG_RECORDS;
    use numeric::paper_claims::CATALOG_CLUSTERS;
    use numeric::paper_claims::encode3;
    use numeric::paper_claims::F_BF16;
    use numeric::paper_claims::F_E4M3;
    use numeric::paper_claims::F_E5M2;
    use numeric::paper_claims::F_E2M1;
    use numeric::paper_claims::F_GF16;
    use numeric::paper_claims::F_E8M0;
    use numeric::paper_claims::NONE;
    use automation::grok_crm::may_transmit;
    use automation::grok_crm::PAID_MODEL_SWITCH;
    use t27os::t27l::tl_event_line;
    use t27os::t27l::tl_validate_line;
    use t27os::t27l::TL_OK;

    // ---- what the live catalog actually holds ----
    pub const PAPER_CLUSTER_PRINT : u64 = 12;
    pub const ORDER_FORMATS : u64 = 84;
    pub const PACKS_PAPER_SAYS : u8 = 6;
    // Anchor 3.0 only. SHA-256 pack files and the 21/21, 15/16 vector claims are not in the table.
    pub const PACK_ANCHORS_RECOMPUTED : bool = true;
    pub const PACK_SHA_VERIFIED : bool = false;
    pub const ML_DTYPES_VERIFIED : bool = false;
    // t27c catalog-gate, 2026-11-09, exit 1. 13 cluster lines sum to 109.
    pub const GATE_EXIT : u8 = 1;
    pub const GATE_RECORDS : u64 = 109;
    pub const GATE_GETTERS : u64 = 83;
    pub const GATE_CLUSTERS : u64 = 13;
    pub const GATE_FINDINGS : u8 = 3;
    pub const GATE_UNEXPECTED : u8 = 2;
    // Pixels restating that print. Not a photo of the terminal, and not a course widget.
    pub const GATE_SHOT : bool = true;
    pub const WIDGET_COMPILED : bool = false;
    pub const WIDGET_SHOT : bool = false;
    pub const VISUAL_REGRESSION : bool = false;
    // (1+bias)*2^m + 2^(m-1). BF16 m=7 bias=127 -> 16448. E4M3 m=3 bias=7 -> 68.
    pub const BF16_ANCHOR : u64 = 16448;
    pub const E4M3_ANCHOR : u64 = 68;
    pub const E5M2_ANCHOR : u64 = 66;
    pub const E2M1_ANCHOR : u64 = 5;
    pub const GF16_ANCHOR : u64 = 16640;
    pub const LESSONS : u8 = 27;
    pub const WIDGET_TYPES : u8 = 16;
    pub const COURSE_WIDGETS_COMPILED : bool = false;
    pub const DAYS : u8 = 10;
    pub const BANK_TARGET : u8 = 30;
    pub const BANK_ROWS : u8 = 10;

    // ---- X, measured 2026-11-09, 7-day view. Clicks were not on that screen. ----
    pub const X_PLAN_SUPER : bool = true;
    pub const X_USAGE_MULTIPLE : u8 = 15;
    pub const X_IMP_7D : u32 = 809;
    pub const X_ENG_PER_MILLE : u32 = 22;
    pub const X_ENGAGEMENTS : u32 = 18;
    pub const X_PROFILE_VISITS : u32 = 2;
    pub const X_REPLIES : u32 = 3;
    pub const X_LIKES : u32 = 8;
    pub const X_REPOSTS : u32 = 4;
    pub const X_BOOKMARKS : u32 = 1;
    pub const X_SHARES : u32 = 0;
    pub const X_FOLLOWERS : u32 = 231;
    pub const X_VERIFIED_FOLLOWERS : u32 = 36;
    pub const X_ACTIVE_24H : u32 = 166;
    pub const X_PRICE_NOW_THB : u32 = 1775;
    pub const X_PRICE_NEXT_THB : u32 = 3549;
    pub const GROK_WEEKLY_PCT : u8 = 1;
    pub const POSTED : bool = false;

    // ---- claim classes ----
    pub const C_REFUSED : u8 = 0;
    pub const C_FITS : u8 = 1;
    pub const C_MISFIT : u8 = 2;
    pub const C_GAP : u8 = 3;
    pub const C_UNCHECKED : u8 = 4;

    pub const CL_EIGHTY_FOUR : u8 = 0;
    pub const CL_RECORDS : u8 = 1;
    pub const CL_CLUSTERS_PAPER : u8 = 2;
    pub const CL_CLUSTERS_LIVE : u8 = 3;
    pub const CL_PACKS : u8 = 4;
    pub const CL_ML : u8 = 5;
    pub const CL_BF16 : u8 = 6;
    pub const CL_FP8 : u8 = 7;
    pub const CL_WIDGETS : u8 = 8;
    pub const CL_CHEAPER : u8 = 9;
    pub const CL_BUILD : u8 = 10;
    pub const CL_VIVADO : u8 = 11;
    pub const CL_SWARM : u8 = 12;
    pub const CL_LESSON : u8 = 13;
    pub const CL_NAN : u8 = 14;

    // ---- surfaces that are not live ----
    pub const FUNNEL_LIVE : bool = false;
    pub const PAID_LIVE : bool = false;
    pub const CHECKOUT_LIVE : bool = false;
    pub const CERT_LIVE : bool = false;
    pub const KIT_LIVE : bool = false;

    pub const TL_ACTOR : u8 = 2;
    pub const TL_SURFACE : u8 = 11;
    pub const TL_ACTION_ROUTE : u8 = 26;
    pub const TL_LEVEL_INFO : u8 = 2;
    pub const PK_EVENT_ID : str = "c27d1e22-5c1b-4d38-9e22-1b38c27d1e22";
    pub const PK_EVENT_TS : str = "2026-11-09T16:01:00Z";

    pub const A_STOP : u8 = 1;
    pub const A_UNCHECKED : u8 = 2;
    pub const A_NO_VISUAL : u8 = 3;
    pub const A_PAID : u8 = 4;

    /// 0 refused, 1 fits, 2 bare misfit, 3 misfit stated honestly, 4 not recomputed.
    pub fn claim_class(id: u8) -> u8 {
        if (id == CL_RECORDS) { return C_FITS; }
        if (id == CL_CLUSTERS_LIVE) { return C_GAP; }
        if (id == CL_CLUSTERS_PAPER) { return C_MISFIT; }
        if (id == CL_EIGHTY_FOUR || id == CL_WIDGETS || id == CL_SWARM || id == CL_LESSON) {
            return C_REFUSED;
        }
        if (id == CL_PACKS || id == CL_ML || id == CL_BF16 || id == CL_FP8) { return C_UNCHECKED; }
        if (id == CL_CHEAPER || id == CL_BUILD || id == CL_VIVADO || id == CL_NAN) { return C_UNCHECKED; }
        return C_REFUSED;
    }

    pub fn claim_text_ok(id: u8) -> bool {
        const k : u8 = claim_class(id);
        return k == C_FITS || k == C_GAP;
    }

    /// One claim, one artifact, one path, one visual, one CTA, one metric. All six, or it stays a draft.
    /// Readiness is not a post: may_post stays false. A person publishes.
    pub fn asset_ok(claim: u8, artifact: bool, path: bool, visual: bool, cta: bool, metric: bool) -> bool {
        return claim_text_ok(claim) && artifact && path && visual && cta && metric;
    }

    pub fn may_post() -> bool { return false; }

    /// The reconciliation draft has a gate print and a picture of that print.
    /// It is still not a post. The vector-suite claims and the course widget stay out.
    pub fn reconciliation_ready() -> bool {
        return GATE_SHOT && GATE_RECORDS == CATALOG_RECORDS && GATE_CLUSTERS == CATALOG_CLUSTERS
            && GATE_EXIT == 1 && !ML_DTYPES_VERIFIED && !WIDGET_COMPILED && !may_post();
    }

    /// Calendar day 1..10. None of the order's ten lines is publishable.
    pub fn day_claim(day: u8) -> u8 {
        if (day == 1) { return CL_FP8; }
        if (day == 2) { return CL_BF16; }
        if (day == 3) { return CL_CHEAPER; }
        if (day == 4) { return CL_BUILD; }
        if (day == 5) { return CL_VIVADO; }
        if (day == 6) { return CL_SWARM; }
        if (day == 7) { return CL_LESSON; }
        if (day == 8) { return CL_NAN; }
        if (day == 9) { return CL_WIDGETS; }
        if (day == 10) { return CL_EIGHTY_FOUR; }
        return CL_EIGHTY_FOUR;
    }

    pub fn day_publishable(day: u8, visual: bool) -> bool {
        if (day < 1 || day > DAYS) { return false; }
        return asset_ok(day_claim(day), true, true, visual, true, true);
    }

    pub fn lesson_ready(widget_compiled: bool, visual: bool) -> bool {
        return COURSE_WIDGETS_COMPILED && widget_compiled && visual && LESSONS == 27;
    }

    pub fn widget_type_ok(t: u8) -> bool {
        return t >= 1 && t <= WIDGET_TYPES;
    }

    /// Impressions are known. Clicks, course starts, GitHub visits and payments are not.
    pub fn metric_known(id: u8) -> bool {
        return id == 1;
    }

    pub fn funnel_step_one_cta(ctas: u8) -> bool {
        return ctas == 1;
    }

    pub fn paid_allowed() -> bool {
        return PAID_LIVE && !PAID_MODEL_SWITCH && CHECKOUT_LIVE;
    }

    /// An unchecked or refused claim stops the lane. A missing visual stops it. Paid use stops it.
    pub fn anomaly(claim: u8, visual: bool, paid_used: bool) -> u8 {
        if (paid_used || PAID_MODEL_SWITCH) { return A_PAID; }
        if (!claim_text_ok(claim)) { return A_UNCHECKED; }
        if (!visual) { return A_NO_VISUAL; }
        return 0;
    }

    pub fn repair_hides_failure() -> bool { return false; }

    pub fn pk_event(out: []u8, event_id: []const u8, ts: []const u8, payload: []const u8) -> usize {
        return tl_event_line(out, event_id, ts, "mac-1", "sess-1", TL_ACTOR, TL_SURFACE, TL_ACTION_ROUTE,
                             TL_LEVEL_INFO, "", "", "", payload, "");
    }

    test "the catalog count is the live one, and 84 is refused" {
        assert(CATALOG_RECORDS == 109);
        assert(CATALOG_CLUSTERS == 13);
        assert(PAPER_CLUSTER_PRINT == 12);
        assert(ORDER_FORMATS == 84);
        assert(claim_class(CL_RECORDS) == C_FITS);
        assert(claim_class(CL_CLUSTERS_LIVE) == C_GAP);
        assert(claim_class(CL_CLUSTERS_PAPER) == C_MISFIT);
        assert(claim_class(CL_EIGHTY_FOUR) == C_REFUSED);
        assert(!claim_text_ok(CL_EIGHTY_FOUR));
        assert(claim_text_ok(CL_RECORDS));
        assert(claim_text_ok(CL_CLUSTERS_LIVE));
        assert(PACK_ANCHORS_RECOMPUTED);
        assert(!PACK_SHA_VERIFIED);
        assert(!ML_DTYPES_VERIFIED);
        assert(claim_class(CL_PACKS) == C_UNCHECKED);
        assert(claim_class(CL_BF16) == C_UNCHECKED);
        assert(claim_class(CL_FP8) == C_UNCHECKED);
        assert(claim_class(CL_ML) == C_UNCHECKED);
    }

    test "an asset needs all six parts and still is not posted" {
        assert(!asset_ok(CL_RECORDS, true, true, false, true, true));
        assert(!asset_ok(CL_EIGHTY_FOUR, true, true, true, true, true));
        assert(!asset_ok(CL_RECORDS, false, true, true, true, true));
        assert(asset_ok(CL_CLUSTERS_LIVE, true, true, true, true, true));
        assert(!may_post());
        assert(!POSTED);
        assert(!may_transmit());
    }

    test "none of the ten calendar lines can ship" {
        assert(day_claim(2) == CL_BF16);
        assert(day_claim(10) == CL_EIGHTY_FOUR);
        assert(day_claim(7) == CL_LESSON);
        assert(!day_publishable(1, true));
        assert(!day_publishable(2, true));
        assert(!day_publishable(10, true));
        assert(!day_publishable(0, true));
        assert(BANK_ROWS == 10);
        assert(BANK_ROWS < BANK_TARGET);
        assert(!COURSE_WIDGETS_COMPILED);
        assert(!lesson_ready(true, true));
        assert(widget_type_ok(1));
        assert(widget_type_ok(WIDGET_TYPES));
        assert(!widget_type_ok(0));
        assert(LESSONS == 27);
    }

    test "only impressions are known, and nothing paid is live" {
        assert(metric_known(1));
        assert(!metric_known(2));
        assert(X_IMP_7D == 809);
        assert(X_PROFILE_VISITS == 2);
        assert(X_FOLLOWERS == 231);
        assert(X_VERIFIED_FOLLOWERS == 36);
        assert(X_PLAN_SUPER);
        assert(X_USAGE_MULTIPLE == 15);
        assert(X_PRICE_NOW_THB == 1775);
        assert(X_PRICE_NEXT_THB == 3549);
        assert(GROK_WEEKLY_PCT == 1);
        assert(!FUNNEL_LIVE);
        assert(!PAID_LIVE);
        assert(!CHECKOUT_LIVE);
        assert(!paid_allowed());
        assert(!PAID_MODEL_SWITCH);
        assert(funnel_step_one_cta(1));
        assert(!funnel_step_one_cta(2));
    }

    test "a bad claim or a missing picture stops the lane" {
        assert(anomaly(CL_EIGHTY_FOUR, true, false) == A_UNCHECKED);
        assert(anomaly(CL_BF16, true, false) == A_UNCHECKED);
        assert(anomaly(CL_RECORDS, false, false) == A_NO_VISUAL);
        assert(anomaly(CL_RECORDS, true, true) == A_PAID);
        assert(anomaly(CL_CLUSTERS_LIVE, true, false) == 0);
        assert(!repair_hides_failure());
    }

    test "the gate print and the six anchors, and nothing else is verified" {
        assert(GATE_RECORDS == 109);
        assert(GATE_GETTERS == 83);
        assert(GATE_CLUSTERS == 13);
        assert(GATE_FINDINGS == 3);
        assert(GATE_UNEXPECTED == 2);
        assert(GATE_EXIT == 1);
        assert(GATE_SHOT);
        assert(encode3(F_BF16) == BF16_ANCHOR);
        assert(encode3(F_E4M3) == E4M3_ANCHOR);
        assert(encode3(F_E5M2) == E5M2_ANCHOR);
        assert(encode3(F_E2M1) == E2M1_ANCHOR);
        assert(encode3(F_GF16) == GF16_ANCHOR);
        assert(encode3(F_E8M0) == NONE);
        assert(BF16_ANCHOR == 16448);
        assert(E4M3_ANCHOR == 68);
        assert(!WIDGET_COMPILED);
        assert(!WIDGET_SHOT);
        assert(!VISUAL_REGRESSION);
        assert(reconciliation_ready());
        assert(!may_post());
    }

    test "the gate line is a valid T27L event" {
        var ln : [2048]u8 = undefined;
        const n : usize = pk_event(ln[0..2048], PK_EVENT_ID, PK_EVENT_TS, "promotion claim=3 visual=0");
        assert(n > 0);
        assert(tl_validate_line(ln[0..n]) == TL_OK);
    }

    invariant no_unchecked_post {
        assert day_publishable(10, true) == false;
        assert POSTED == false;
        assert may_transmit() == false;
    }

    invariant catalog_beats_the_round_number {
        assert CATALOG_RECORDS == 109;
        assert CATALOG_CLUSTERS == 13;
        assert claim_class(CL_EIGHTY_FOUR) == C_REFUSED;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
