// SPDX-License-Identifier: Apache-2.0
// specs/automation/promotion_kernel.t27 -- the proof-to-demand gate for a
// promotional draft. It refuses an unchecked claim and it does not post,
// send mail, or spend a paid token. The catalog numbers come from
// specs/numeric/paper_claims.t27 (109 records, 13 measured clusters).
// The round "84 formats" line, "BF16 21/21" and "FP8 15/16" are not rows
// that spec marks as fitting, so this gate refuses them (#13466).
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::promotion_kernel {

    use numeric::paper_claims::V_FITS;
    use numeric::paper_claims::row_verdict;
    use numeric::paper_claims::row_recomputed;
    use numeric::paper_claims::CATALOG_CLUSTERS;
    use numeric::paper_claims::CATALOG_RECORDS;

    pub const KIND : str = "automation";
    pub const ID : str = "promotion-kernel";
    pub const VERSION : u8 = 1;

    // This contract never transmits. Readiness is not a post.
    pub const MAY_POST : bool = false;
    pub const SENDS_MAIL : bool = false;
    pub const PAID_CHECKOUT : bool = false;

    pub const CLASS_FIT : str = "fit";
    pub const CLASS_REFUSED : str = "refused";

    // Paper row 10 is "the catalog holds 109 formats" (K_RECORDS).
    // Paper row 11 is "the 109 formats span 12 clusters", which misfits:
    // the recomputed cluster count is 13.
    pub const ROW_109_RECORDS : u32 = 10;
    pub const ROW_12_CLUSTERS : u32 = 11;

    // Not paper rows. The epic listed them as patterns; #13466 and #13468
    // say they are not checked claims.
    pub const CLAIM_84_FORMATS : u32 = 84;
    pub const CLAIM_BF16_21 : u32 = 211;
    pub const CLAIM_FP8_15 : u32 = 151;
    pub const CLAIM_CLUSTER_GAP : u32 = 13;

    fn unchecked_round(id: u32) -> bool {
        if id == CLAIM_84_FORMATS {
            return true;
        }
        if id == CLAIM_BF16_21 {
            return true;
        }
        if id == CLAIM_FP8_15 {
            return true;
        }
        return false;
    }

    // fit, or refused. An unknown id is refused: an unchecked claim does not pass.
    fn claim_class(id: u32) -> str {
        if unchecked_round(id) {
            return CLASS_REFUSED;
        }
        if id == ROW_109_RECORDS {
            if row_verdict(ROW_109_RECORDS) == V_FITS {
                return CLASS_FIT;
            }
            return CLASS_REFUSED;
        }
        if id == ROW_12_CLUSTERS {
            return CLASS_REFUSED;
        }
        if id == CLAIM_CLUSTER_GAP {
            if row_recomputed(ROW_12_CLUSTERS) == CATALOG_CLUSTERS {
                return CLASS_FIT;
            }
            return CLASS_REFUSED;
        }
        return CLASS_REFUSED;
    }

    // Six parts, or the asset stays a draft. A fitting claim with no visual
    // is not ready. Ready is still not a post (#13467).
    fn asset_ok(claim: bool, artifact: bool, path: bool, visual: bool, cta: bool, metric: bool) -> bool {
        if !claim {
            return false;
        }
        if !artifact {
            return false;
        }
        if !path {
            return false;
        }
        if !visual {
            return false;
        }
        if !cta {
            return false;
        }
        return metric;
    }

    // Ten calendar days. Each day names a claim. None of the ten is
    // publishable, visual or not (#13468). Days 0..3 and 6..9 name
    // refused claims. Days 4 and 5 name claims the gate fits, and they
    // stay drafts anyway: a calendar line is not a post.
    pub const CALENDAR_DAYS : u8 = 10;

    fn day_claim(day: u8) -> u32 {
        if day == 0 {
            return CLAIM_84_FORMATS;
        }
        if day == 1 {
            return CLAIM_BF16_21;
        }
        if day == 2 {
            return CLAIM_FP8_15;
        }
        if day == 3 {
            return ROW_12_CLUSTERS;
        }
        if day == 4 {
            return ROW_109_RECORDS;
        }
        if day == 5 {
            return CLAIM_CLUSTER_GAP;
        }
        return CLAIM_84_FORMATS;
    }

    fn day_publishable(day: u8, has_visual: bool) -> bool {
        if day < CALENDAR_DAYS && has_visual {
            return false;
        }
        return false;
    }

    fn publishable_days() -> u8 {
        var day : u8 = 0;
        var n : u8 = 0;
        while day < CALENDAR_DAYS {
            if day_publishable(day, true) {
                n = n + 1;
            }
            day = day + 1;
        }
        return n;
    }

    // Only the 7-day impression count is a known metric (#13470).
    // The figure is the one #13465 recorded for @t27_dev on 2026-11-09.
    // This agent did not re-measure X. Clicks, course starts and payments
    // are not stored: an unknown metric is not zero.
    pub const METRIC_IMPRESSIONS : u8 = 1;
    pub const METRIC_CLICKS : u8 = 2;
    pub const METRIC_COURSE_STARTS : u8 = 3;
    pub const METRIC_PAYMENTS : u8 = 4;
    pub const X_IMPRESSIONS_7D : u32 = 809;
    pub const X_IMPRESSIONS_SOURCE : str = "issue #13465, @t27_dev, 7-day view, 2026-11-09";

    fn metric_known(which: u8) -> bool {
        return which == METRIC_IMPRESSIONS;
    }

    fn stores_unknown_as_zero() -> bool {
        return false;
    }

    test "84 formats is refused and the 109-record catalog fits" {
        assert(claim_class(CLAIM_84_FORMATS) == CLASS_REFUSED);
        assert(claim_class(CLAIM_BF16_21) == CLASS_REFUSED);
        assert(claim_class(CLAIM_FP8_15) == CLASS_REFUSED);
        assert(claim_class(ROW_12_CLUSTERS) == CLASS_REFUSED);
        assert(claim_class(ROW_109_RECORDS) == CLASS_FIT);
        assert(claim_class(CLAIM_CLUSTER_GAP) == CLASS_FIT);
        assert(claim_class(0) == CLASS_REFUSED);
        assert(CATALOG_RECORDS == 109);
        assert(CATALOG_CLUSTERS == 13);
        assert(row_verdict(ROW_109_RECORDS) == V_FITS);
        assert(row_recomputed(ROW_12_CLUSTERS) == 13);
    }

    test "the contract posts nothing" {
        assert(!MAY_POST);
        assert(!SENDS_MAIL);
        assert(!PAID_CHECKOUT);
    }

    test "six parts or the asset is not ready, and ready does not post" {
        assert(asset_ok(true, true, true, true, true, true));
        assert(!asset_ok(true, true, true, false, true, true));
        assert(!asset_ok(false, true, true, true, true, true));
        assert(!asset_ok(true, false, true, true, true, true));
        assert(!asset_ok(true, true, false, true, true, true));
        assert(!asset_ok(true, true, true, true, false, true));
        assert(!asset_ok(true, true, true, true, true, false));
        assert(!MAY_POST);
    }

    test "ten calendar days stay drafts even with a visual" {
        assert(CALENDAR_DAYS == 10);
        assert(day_claim(0) == CLAIM_84_FORMATS);
        assert(day_claim(1) == CLAIM_BF16_21);
        assert(day_claim(2) == CLAIM_FP8_15);
        assert(day_claim(3) == ROW_12_CLUSTERS);
        assert(claim_class(day_claim(0)) == CLASS_REFUSED);
        assert(day_claim(4) == ROW_109_RECORDS);
        assert(claim_class(day_claim(4)) == CLASS_FIT);
        assert(!day_publishable(4, true));
        assert(!day_publishable(9, true));
        assert(!day_publishable(9, false));
        assert(publishable_days() == 0);
        assert(!MAY_POST);
    }

    test "only impressions are known, and a click count is not invented" {
        assert(metric_known(METRIC_IMPRESSIONS));
        assert(!metric_known(METRIC_CLICKS));
        assert(!metric_known(METRIC_COURSE_STARTS));
        assert(!metric_known(METRIC_PAYMENTS));
        assert(X_IMPRESSIONS_7D == 809);
        assert(!stores_unknown_as_zero());
        assert(!PAID_CHECKOUT);
        assert(X_IMPRESSIONS_SOURCE != "");
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
