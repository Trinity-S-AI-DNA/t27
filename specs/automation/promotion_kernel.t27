// SPDX-License-Identifier: Apache-2.0
// specs/automation/promotion_kernel.t27 -- proof-to-demand contract for promotion.
// A draft needs one checked claim, one artifact, one path, one visual, one CTA and one
// metric. This module does not post, send mail, spend tokens, or arm a cron.
// Catalog law is numeric::paper_claims: 109 records, 13 clusters. "84 formats" is refused.
// "83 formats" is refused: 83 is the getter count, not the live catalog.
// No picture of that reconciliation is claimed here.
// Mail stays out of this file. #13481 and #13482 are not this contract.
// Course frames are course::lesson_frames. The course audit is specs/course/fpga_course_v2.t27.
// X numbers are the view recorded in #13465 for @t27_dev on 2026-11-09, 7-day, plan Super.
// This module did not re-read X. Unknown metrics are omitted, not stored as zero.
// Refs #13465 #13466 #13467 #13468 #13469 #13470 #13471 #13472
// Refs #13473 #13474 #13475 #13476 #13477 #13478 #13479 #13480 #13483 #13484 #13485
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::promotion_kernel {

    use numeric::paper_claims::CATALOG_RECORDS;
    use numeric::paper_claims::CATALOG_CLUSTERS;
    use numeric::paper_claims::V_FITS;
    use numeric::paper_claims::V_MISFIT;
    use numeric::paper_claims::V_UNCHECKED;
    use numeric::paper_claims::F_GF16;
    use numeric::paper_claims::row_verdict;
    use numeric::paper_claims::encode3;
    use course::lesson_frames::LESSON_COUNT;
    use course::lesson_frames::FRAME_NOW;
    use t27os::t27l::tl_event_line;
    use t27os::t27l::tl_validate_line;
    use t27os::t27l::tl_surface_name;
    use t27os::t27l::TL_OK;
    use std::mem::bytes_contains;
    use std::mem::bytes_eq;
    use std::mem::bytes_starts_with;
    use std::text::is_digit;

    pub const KIND : str = "automation";
    pub const ID : str = "promotion-kernel";
    pub const VERSION : u8 = 1;

    // Claim classes. Unknown text fails closed as refused.
    pub const CC_FIT : u32 = 1;
    pub const CC_MISFIT : u32 = 2;
    pub const CC_UNCHECKED : u32 = 3;
    pub const CC_REFUSED : u32 = 4;

    // Claim ids. paper_claims rows are the CL_TEXT indexes.
    pub const CID_CATALOG_109 : u32 = 1;
    pub const CID_CLUSTERS_12 : u32 = 2;
    pub const CID_FORMATS_84 : u32 = 3;
    pub const CID_ML_DTYPES : u32 = 4;
    pub const CID_BF16 : u32 = 5;
    pub const CID_FP8 : u32 = 6;
    pub const CID_GF16_ANCHOR : u32 = 7;
    pub const CID_GETTERS_AS_FORMATS : u32 = 8;
    pub const CID_CLUSTER_GAP : u32 = 9;
    pub const CID_SHA : u32 = 10;
    pub const CID_ABS : u32 = 11;
    pub const CID_CODEGEN : u32 = 12;
    pub const CID_VIVADO : u32 = 13;
    pub const CID_WIDGETS_ALL : u32 = 14;
    pub const CID_LAST : u32 = 14;

    pub const ROW_RECORDS : u32 = 10;
    pub const ROW_CLUSTERS : u32 = 11;
    pub const ROW_ML_DTYPES : u32 = 19;

    // specs/numeric/formats_catalog.t27, predicate of bootstrap/src/catalog_gate.rs
    // count_getters (trimmed line starts with "fn ", and contains "-> str" and "return").
    // Counted 2026-11-10 on this checkout: 83. // CATALOG: lines: 109. Distinct cluster=: 13.
    // Not a published reconciliation, and no visual proof file is claimed.
    pub const GETTER_COUNT : u64 = 83;

    pub const DAYS : u32 = 10;
    pub const WEEK_SLOTS : u32 = 7;
    pub const PILLAR_PROOF : u32 = 1;
    pub const PILLAR_COURSE : u32 = 2;
    pub const PILLAR_ARTIFACT : u32 = 3;
    pub const PILLAR_COUNT : u32 = 3;
    pub const WIDGET_TYPES : u32 = 16;
    pub const BANK_ROWS : u32 = 11;
    pub const FUNNEL_STEPS : u32 = 8;
    pub const LOOP_MAX : u32 = 1;

    // The course audit does not yet show a lesson widget as a compiled spec with a visual.
    pub const COURSE_WIDGETS_COMPILED : bool = false;
    pub const FUNNEL_LIVE : bool = false;
    pub const PAID_CHECKOUT : bool = false;
    pub const CONTRIBUTOR_PATH_LIVE : bool = false;
    pub const MONETIZATION_LIVE : bool = false;

    pub const WIDGET_NAME : [16]str = [
        "interactive number",
        "bit layout explorer",
        "encode/decode",
        "rounding",
        "overflow",
        "NaN",
        "block scale",
        "ternary adder",
        "ternary multiplier",
        "FPGA blink",
        "neural training loop",
        "loss curve",
        "before/after",
        "live build",
        "agent swarm view",
        "course progress"
    ];

    // One CTA per step. Steps 6..8 name paths this contract does not open.
    pub const FUNNEL_CTA : [8]str = [
        "open the artifact",
        "open the paper",
        "open the course",
        "open the widget",
        "open one issue",
        "contributor path is not live",
        "paid path is not live",
        "b2b path is not live"
    ];

    // Baseline ids. metric_known is true only for impressions (#13470).
    pub const B_IMP : u32 = 1;
    pub const B_VISITS : u32 = 2;
    pub const B_FOLLOWERS : u32 = 3;
    pub const B_CLICKS : u32 = 4;
    pub const B_STARTS : u32 = 5;
    pub const B_PAYMENTS : u32 = 6;
    pub const B_STARS : u32 = 7;
    pub const B_FORKS : u32 = 8;
    pub const B_OPEN_ISSUES : u32 = 9;
    pub const B_CONTRIBUTORS : u32 = 10;

    // Recorded in #13465. Not remeasured by this module.
    pub const X_MEASURED_ON : str = "2026-11-09";
    pub const X_IMP_7D : u32 = 809;
    pub const X_PROFILE_VISITS : u32 = 2;
    pub const X_FOLLOWERS : u32 = 231;
    pub const X_PLAN_SUPER : bool = true;

    pub const A_NONE : u32 = 0;
    pub const A_UNCHECKED : u32 = 1;
    pub const A_NO_VISUAL : u32 = 2;
    pub const A_PAID : u32 = 3;

    pub const ST_RUN : u32 = 1;
    pub const ST_WAIT : u32 = 2;
    pub const ST_STOP : u32 = 3;
    pub const NEXT_HOLD : u32 = 1;
    pub const NEXT_WAIT : u32 = 2;
    pub const NEXT_STOP : u32 = 3;

    // Schema name for #13483. The t27l wire surface is "agent" (#13472): t27l has no
    // promotion_kernel surface, and this contract does not add one.
    pub const SCHEMA_SURFACE : str = "promotion_kernel";
    pub const RATE_WAIT_NAME : str = "WAITING_RATE_LIMIT";
    pub const EV_DRAFT : u32 = 1;
    pub const EV_GATE : u32 = 2;
    pub const EV_APPROVED : u32 = 3;
    pub const EV_RATE_WAIT : u32 = 4;
    pub const EV_LAST : u32 = 4;

    pub const TL_ACTOR_AGENT : u8 = 2;
    pub const TL_SURFACE_AGENT : u8 = 11;
    pub const TL_ACTION_STEP : u8 = 5;
    pub const TL_LEVEL_INFO : u8 = 2;
    pub const PK_EVENT_ID : str = "c1346500-0000-4000-8000-000000001346";
    pub const PK_EVENT_TS : str = "2026-11-09T16:01:00Z";

    pub fn getter_count() -> u64 {
        return GETTER_COUNT;
    }

    pub fn claim_class(id: u32) -> u32 {
        if (id == CID_CATALOG_109) {
            if (row_verdict(ROW_RECORDS) == V_FITS && CATALOG_RECORDS == 109) { return CC_FIT; }
            return CC_MISFIT;
        }
        if (id == CID_CLUSTERS_12) {
            if (row_verdict(ROW_CLUSTERS) == V_MISFIT && CATALOG_CLUSTERS == 13) { return CC_MISFIT; }
            return CC_REFUSED;
        }
        if (id == CID_CLUSTER_GAP) {
            if (row_verdict(ROW_CLUSTERS) == V_MISFIT && CATALOG_CLUSTERS == 13 && CATALOG_RECORDS == 109) {
                return CC_FIT;
            }
            return CC_REFUSED;
        }
        if (id == CID_FORMATS_84 || id == CID_GETTERS_AS_FORMATS) { return CC_REFUSED; }
        if (id == CID_ML_DTYPES) {
            if (row_verdict(ROW_ML_DTYPES) == V_UNCHECKED) { return CC_UNCHECKED; }
            return CC_REFUSED;
        }
        if (id == CID_BF16 || id == CID_FP8 || id == CID_SHA || id == CID_ABS || id == CID_CODEGEN || id == CID_VIVADO) {
            return CC_UNCHECKED;
        }
        if (id == CID_GF16_ANCHOR) {
            if (encode3(F_GF16) == 16640) { return CC_FIT; }
            return CC_MISFIT;
        }
        if (id == CID_WIDGETS_ALL) {
            if (COURSE_WIDGETS_COMPILED) { return CC_FIT; }
            return CC_REFUSED;
        }
        return CC_REFUSED;
    }

    pub fn claim_publishable(id: u32) -> bool {
        return claim_class(id) == CC_FIT;
    }

    pub fn unchecked_publishable() -> u32 {
        var i : u32 = 1;
        var n : u32 = 0;
        while (i <= CID_LAST) {
            if (claim_class(i) == CC_UNCHECKED && claim_publishable(i)) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // A refused phrase wins. Text with no known phrase is refused.
    pub fn draft_class(text: str) -> u32 {
        if (bytes_contains(text, "84 formats") || bytes_contains(text, "83 formats") || bytes_contains(text, "21/21") || bytes_contains(text, "15/16")) {
            return CC_REFUSED;
        }
        if (bytes_contains(text, "ml_dtypes")) { return CC_UNCHECKED; }
        if (bytes_contains(text, "12 clusters")) { return CC_MISFIT; }
        if (bytes_contains(text, "109 records") || bytes_contains(text, "13 clusters") || bytes_contains(text, "0x4100")) {
            return CC_FIT;
        }
        return CC_REFUSED;
    }

    pub fn asset_ok(claim: u32, artifact: bool, path: bool, visual: bool, cta: bool, metric: bool) -> bool {
        return claim_publishable(claim) && artifact && path && visual && cta && metric;
    }

    pub fn may_post() -> bool { return false; }

    pub fn posts_sent() -> bool { return false; }

    pub fn transmits() -> bool { return false; }

    pub fn day_claim(day: u32) -> u32 {
        if (day == 1) { return CID_FP8; }
        if (day == 2) { return CID_BF16; }
        if (day == 3) { return CID_ML_DTYPES; }
        if (day == 4) { return CID_SHA; }
        if (day == 5) { return CID_ABS; }
        if (day == 6) { return CID_CODEGEN; }
        if (day == 7) { return CID_VIVADO; }
        if (day == 8) { return CID_WIDGETS_ALL; }
        if (day == 9) { return CID_CLUSTERS_12; }
        if (day == 10) { return CID_FORMATS_84; }
        return 0;
    }

    pub fn day_publishable(day: u32, visual: bool) -> bool {
        if (day < 1 || day > DAYS) { return false; }
        return asset_ok(day_claim(day), true, true, visual, true, true);
    }

    pub fn week_pillar(day: u32) -> u32 {
        if (day < 1 || day > WEEK_SLOTS) { return 0; }
        return ((day - 1) % PILLAR_COUNT) + 1;
    }

    pub fn week_publishable(day: u32) -> bool { return false; }

    pub fn pillar_name(id: u32) -> str {
        if (id == PILLAR_PROOF) { return "proof"; }
        if (id == PILLAR_COURSE) { return "course"; }
        if (id == PILLAR_ARTIFACT) { return "artifact"; }
        return "";
    }

    pub fn lesson_count() -> u32 { return LESSON_COUNT; }

    pub fn lesson_in_map(n: u32) -> bool {
        return n >= 1 && n <= lesson_count();
    }

    pub fn lesson_frame(n: u32) -> str {
        if (lesson_in_map(n) == false) { return ""; }
        return FRAME_NOW[n - 1];
    }

    // Idea text and a measurable lesson result are not in this repo. Unknown stays unknown.
    pub fn lesson_idea_known(n: u32) -> bool { return false; }

    pub fn lesson_result_known(n: u32) -> bool { return false; }

    pub fn lesson_ready(widget_compiled: bool, visual: bool) -> bool {
        return COURSE_WIDGETS_COMPILED && widget_compiled && visual && lesson_count() == 27;
    }

    pub fn lessons_marked_ready() -> u32 {
        var n : u32 = 0;
        var i : u32 = 1;
        while (i <= lesson_count()) {
            if (lesson_ready(true, true)) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    pub fn widget_type_count() -> u32 { return WIDGET_TYPES; }

    pub fn widget_type_ok(t: u32) -> bool {
        return t >= 1 && t <= widget_type_count();
    }

    pub fn widget_name(t: u32) -> str {
        if (widget_type_ok(t) == false) { return ""; }
        return WIDGET_NAME[t - 1];
    }

    pub fn widget_compiled(t: u32) -> bool { return false; }

    pub fn widget_has_visual(t: u32) -> bool { return false; }

    pub fn bank_claim(row: u32) -> u32 {
        if (row >= 1 && row <= DAYS) { return day_claim(row); }
        if (row == BANK_ROWS) { return CID_CATALOG_109; }
        return 0;
    }

    pub fn bank_publishable(row: u32) -> bool {
        return asset_ok(bank_claim(row), true, true, true, true, true) && may_post();
    }

    pub fn funnel_cta(step: u32) -> str {
        if (step < 1 || step > FUNNEL_STEPS) { return ""; }
        return FUNNEL_CTA[step - 1];
    }

    pub fn funnel_cta_count(step: u32) -> u32 {
        if (step < 1 || step > FUNNEL_STEPS) { return 0; }
        return 1;
    }

    pub fn funnel_publishable(step: u32) -> bool {
        return funnel_cta_count(step) == 1 && may_post();
    }

    pub fn metric_known(id: u32) -> bool {
        return id == B_IMP;
    }

    pub fn baseline_recorded(id: u32) -> bool {
        return id == B_IMP || id == B_VISITS || id == B_FOLLOWERS;
    }

    pub fn github_known(id: u32) -> bool { return false; }

    pub fn paid_allowed() -> bool { return false; }

    pub fn anomaly(claim: u32, visual: bool, paid_used: bool) -> u32 {
        if (paid_used) { return A_PAID; }
        if (claim_publishable(claim) == false) { return A_UNCHECKED; }
        if (visual == false) { return A_NO_VISUAL; }
        return A_NONE;
    }

    pub fn repair_hides_failure() -> bool { return false; }

    pub fn publish_ready(widget: bool, screenshot: bool, test_pass: bool, human: bool) -> bool {
        return widget && screenshot && test_pass && human;
    }

    pub fn publish_sends(widget: bool, screenshot: bool, test_pass: bool, human: bool) -> bool {
        return publish_ready(widget, screenshot, test_pass, human) && may_post();
    }

    pub fn loop_state(cycle: u32, rate_limited: bool, paid_requested: bool) -> u32 {
        if (paid_requested) { return ST_STOP; }
        if (rate_limited) { return ST_WAIT; }
        if (cycle >= LOOP_MAX) { return ST_STOP; }
        return ST_RUN;
    }

    pub fn paid_fallback() -> bool { return false; }

    pub fn next_action(rate_limited: bool, anomaly_code: u32) -> u32 {
        if (rate_limited) { return NEXT_WAIT; }
        if (anomaly_code != A_NONE) { return NEXT_STOP; }
        return NEXT_HOLD;
    }

    pub fn cron_enabled() -> bool { return false; }

    pub fn event_known(id: u32) -> bool {
        return id >= EV_DRAFT && id <= EV_LAST;
    }

    pub fn payload_has_address(p: str) -> bool {
        return bytes_contains(p, "@") || bytes_contains(p, "://") || bytes_contains(p, "http");
    }

    pub fn payload_is_claim(p: str) -> bool {
        if (bytes_starts_with(p, "claim=") == false) { return false; }
        if (p.len < 7 || p.len > 12) { return false; }
        if (payload_has_address(p)) { return false; }
        var i : usize = 6;
        while (i < p.len) {
            if (is_digit(p[i]) == false) { return false; }
            i = i + 1;
        }
        return true;
    }

    pub fn pk_event(out: []u8, event_id: []const u8, ts: []const u8, payload: []const u8) -> usize {
        if (payload_is_claim(payload) == false) { return 0; }
        return tl_event_line(out, event_id, ts, "pk-1", "sess-pk", TL_ACTOR_AGENT, TL_SURFACE_AGENT,
                              TL_ACTION_STEP, TL_LEVEL_INFO, "", "", "", payload, "");
    }

    test "eighty four formats are refused and the live catalog fits" {
        assert(CATALOG_RECORDS == 109);
        assert(CATALOG_CLUSTERS == 13);
        assert(getter_count() == 83);
        assert(getter_count() != CATALOG_RECORDS);
        assert(claim_class(CID_FORMATS_84) == CC_REFUSED);
        assert(claim_publishable(CID_FORMATS_84) == false);
        assert(claim_class(CID_GETTERS_AS_FORMATS) == CC_REFUSED);
        assert(claim_class(CID_CATALOG_109) == CC_FIT);
        assert(claim_publishable(CID_CATALOG_109));
        assert(claim_class(CID_CLUSTERS_12) == CC_MISFIT);
        assert(claim_publishable(CID_CLUSTERS_12) == false);
        assert(claim_class(CID_CLUSTER_GAP) == CC_FIT);
        assert(claim_class(CID_ML_DTYPES) == CC_UNCHECKED);
        assert(claim_class(CID_BF16) == CC_UNCHECKED);
        assert(claim_class(CID_FP8) == CC_UNCHECKED);
        assert(claim_publishable(CID_BF16) == false);
        assert(claim_publishable(CID_FP8) == false);
        assert(encode3(F_GF16) == 16640);
        assert(claim_class(CID_GF16_ANCHOR) == CC_FIT);
        assert(claim_class(CID_WIDGETS_ALL) == CC_REFUSED);
        assert(claim_class(0) == CC_REFUSED);
        assert(claim_class(CID_LAST + 1) == CC_REFUSED);
        assert(unchecked_publishable() == 0);
        assert(draft_class("84 formats in one catalog") == CC_REFUSED);
        assert(draft_class("83 formats") == CC_REFUSED);
        assert(draft_class("109 records") == CC_FIT);
        assert(draft_class("the paper says 12 clusters") == CC_MISFIT);
        assert(draft_class("13 clusters, the live gap") == CC_FIT);
        assert(draft_class("109 records but also 84 formats") == CC_REFUSED);
        assert(draft_class("BF16 21/21") == CC_REFUSED);
        assert(draft_class("FP8 15/16") == CC_REFUSED);
        assert(draft_class("cross-checked with ml_dtypes 0.5.4") == CC_UNCHECKED);
        assert(draft_class("") == CC_REFUSED);
        assert(draft_class("hello") == CC_REFUSED);
    }

    test "an asset needs all six parts and still is not posted" {
        assert(asset_ok(CID_CATALOG_109, true, true, false, true, true) == false);
        assert(asset_ok(CID_FORMATS_84, true, true, true, true, true) == false);
        assert(asset_ok(CID_CATALOG_109, false, true, true, true, true) == false);
        assert(asset_ok(CID_CATALOG_109, true, true, true, true, true));
        assert(may_post() == false);
        assert(posts_sent() == false);
        assert(transmits() == false);
    }

    test "none of the ten calendar days is publishable" {
        var d : u32 = 1;
        while (d <= DAYS) {
            assert(day_claim(d) != 0);
            assert(claim_publishable(day_claim(d)) == false);
            assert(day_publishable(d, true) == false);
            assert(day_publishable(d, false) == false);
            d = d + 1;
        }
        assert(day_claim(1) == CID_FP8);
        assert(day_claim(2) == CID_BF16);
        assert(day_claim(10) == CID_FORMATS_84);
        assert(day_publishable(0, true) == false);
        assert(day_publishable(DAYS + 1, true) == false);
        var w : u32 = 1;
        while (w <= WEEK_SLOTS) {
            assert(week_pillar(w) >= 1);
            assert(week_pillar(w) <= PILLAR_COUNT);
            assert(week_publishable(w) == false);
            w = w + 1;
        }
        assert(week_pillar(1) == PILLAR_PROOF);
        assert(week_pillar(4) == PILLAR_PROOF);
        assert(bytes_eq(pillar_name(PILLAR_COURSE), "course"));
        assert(week_publishable(0) == false);
    }

    test "twenty seven lessons and sixteen widget types are not ready" {
        assert(lesson_count() == 27);
        assert(lesson_count() == LESSON_COUNT);
        assert(lesson_in_map(1));
        assert(lesson_in_map(27));
        assert(lesson_in_map(0) == false);
        assert(bytes_eq(lesson_frame(1), FRAME_NOW[0]));
        assert(bytes_eq(lesson_frame(0), ""));
        assert(lesson_idea_known(1) == false);
        assert(lesson_result_known(27) == false);
        assert(lesson_ready(true, true) == false);
        assert(lesson_ready(false, false) == false);
        assert(lessons_marked_ready() == 0);
        assert(widget_type_count() == 16);
        var t : u32 = 1;
        while (t <= widget_type_count()) {
            assert(widget_type_ok(t));
            assert(widget_compiled(t) == false);
            assert(widget_has_visual(t) == false);
            t = t + 1;
        }
        assert(widget_type_ok(0) == false);
        assert(bytes_eq(widget_name(1), "interactive number"));
        assert(bytes_eq(widget_name(16), "course progress"));
        assert(COURSE_WIDGETS_COMPILED == false);
    }

    test "only impressions are a known metric and github is unknown" {
        assert(metric_known(B_IMP));
        assert(metric_known(B_VISITS) == false);
        assert(metric_known(B_FOLLOWERS) == false);
        assert(metric_known(B_CLICKS) == false);
        assert(metric_known(B_STARTS) == false);
        assert(metric_known(B_PAYMENTS) == false);
        assert(baseline_recorded(B_IMP));
        assert(baseline_recorded(B_VISITS));
        assert(baseline_recorded(B_FOLLOWERS));
        assert(baseline_recorded(B_CLICKS) == false);
        assert(baseline_recorded(B_STARS) == false);
        assert(github_known(B_STARS) == false);
        assert(github_known(B_FORKS) == false);
        assert(github_known(B_OPEN_ISSUES) == false);
        assert(github_known(B_CONTRIBUTORS) == false);
        assert(X_IMP_7D == 809);
        assert(X_PROFILE_VISITS == 2);
        assert(X_FOLLOWERS == 231);
        assert(X_PLAN_SUPER);
        assert(bytes_eq(X_MEASURED_ON, "2026-11-09"));
        assert(PAID_CHECKOUT == false);
        assert(paid_allowed() == false);
    }

    test "a bad claim a missing visual or paid use stops the lane" {
        assert(anomaly(CID_FORMATS_84, true, false) == A_UNCHECKED);
        assert(anomaly(CID_BF16, true, false) == A_UNCHECKED);
        assert(anomaly(CID_CLUSTERS_12, true, false) == A_UNCHECKED);
        assert(anomaly(CID_CATALOG_109, false, false) == A_NO_VISUAL);
        assert(anomaly(CID_CATALOG_109, true, true) == A_PAID);
        assert(anomaly(CID_CLUSTER_GAP, true, false) == A_NONE);
        assert(repair_hides_failure() == false);
    }

    test "pk_event is one t27l line on surface agent with a claim id" {
        assert(bytes_eq(SCHEMA_SURFACE, "promotion_kernel"));
        assert(bytes_eq(RATE_WAIT_NAME, "WAITING_RATE_LIMIT"));
        assert(bytes_eq(tl_surface_name(TL_SURFACE_AGENT), "agent"));
        assert(event_known(EV_DRAFT));
        assert(event_known(EV_GATE));
        assert(event_known(EV_APPROVED));
        assert(event_known(EV_RATE_WAIT));
        assert(event_known(0) == false);
        assert(payload_is_claim("claim=3"));
        assert(payload_is_claim("claim=") == false);
        assert(payload_has_address("a@b"));
        assert(payload_is_claim("user@host") == false);
        var ln : [2048]u8 = undefined;
        assert(pk_event(ln[0..2048], PK_EVENT_ID, PK_EVENT_TS, "user@host") == 0);
        assert(pk_event(ln[0..2048], PK_EVENT_ID, PK_EVENT_TS, "http://t27.ai") == 0);
        const n : usize = pk_event(ln[0..2048], PK_EVENT_ID, PK_EVENT_TS, "claim=3");
        assert(n > 0);
        assert(tl_validate_line(ln[0..n]) == TL_OK);
        assert(payload_has_address("claim=3") == false);
    }

    test "bank funnel and publish gate do not send" {
        var row : u32 = 1;
        while (row <= BANK_ROWS) {
            assert(bank_publishable(row) == false);
            row = row + 1;
        }
        assert(bank_claim(BANK_ROWS) == CID_CATALOG_109);
        assert(asset_ok(bank_claim(BANK_ROWS), true, true, true, true, true));
        var step : u32 = 1;
        while (step <= FUNNEL_STEPS) {
            assert(funnel_cta_count(step) == 1);
            assert(funnel_publishable(step) == false);
            step = step + 1;
        }
        assert(FUNNEL_LIVE == false);
        assert(bytes_eq(funnel_cta(1), "open the artifact"));
        assert(bytes_eq(funnel_cta(6), "contributor path is not live"));
        assert(bytes_eq(funnel_cta(8), "b2b path is not live"));
        assert(CONTRIBUTOR_PATH_LIVE == false);
        assert(MONETIZATION_LIVE == false);
        assert(publish_ready(true, true, true, false) == false);
        assert(publish_ready(true, true, false, true) == false);
        assert(publish_ready(true, false, true, true) == false);
        assert(publish_ready(false, true, true, true) == false);
        assert(publish_ready(true, true, true, true));
        assert(publish_sends(true, true, true, true) == false);
    }

    test "the loop is bounded and does not fall back to paid" {
        assert(loop_state(0, false, false) == ST_RUN);
        assert(loop_state(LOOP_MAX, false, false) == ST_STOP);
        assert(loop_state(0, true, false) == ST_WAIT);
        assert(loop_state(0, false, true) == ST_STOP);
        assert(paid_fallback() == false);
        assert(next_action(true, A_NONE) == NEXT_WAIT);
        assert(next_action(false, A_UNCHECKED) == NEXT_STOP);
        assert(next_action(false, A_NONE) == NEXT_HOLD);
        assert(cron_enabled() == false);
    }

    invariant nothing_here_posts {
        assert(may_post() == false);
        assert(posts_sent() == false);
        assert(transmits() == false);
        assert(unchecked_publishable() == 0);
        assert(lessons_marked_ready() == 0);
        assert(paid_allowed() == false);
        assert(paid_fallback() == false);
        assert(cron_enabled() == false);
        assert(repair_hides_failure() == false);
        assert(publish_sends(true, true, true, true) == false);
        assert(day_publishable(10, true) == false);
    }
}
