// SPDX-License-Identifier: Apache-2.0
// specs/automation/promotion_kernel.t27 -- proof-to-demand gate for the promotion kernel.
// A post needs a checked claim, an artifact, a path, a visual, one CTA and one metric.
// This contract does NOT post, send mail, or spend tokens.
// Part of [EPIC] T27_PROMOTION_KERNEL_V5 (#13473), #13465.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::promotion_kernel {

    // The six publishable fields. Every asset must carry all six.
    pub const PUBLISH_FIELDS : [6]str = [
        "claim", "artifact", "path", "visual", "cta", "metric"
    ];

    pub const VERDICT_APPROVE : str = "approve";
    pub const VERDICT_REFUSE : str = "refuse";

    pub const SURFACE : str = "promotion_kernel";

    // ---- The asset under audit --------------------------------------------
    pub struct Asset {
        id : str,
        claim : str,
        artifact : str,
        path : str,
        visual : str,
        cta : str,
        metric : str,
    }

    // ---- The gate ----------------------------------------------------------
    // A promotional asset is publishable only when all six fields are present
    // and non-empty. Missing any element -> refuse, nothing is posted.
    pub fn gate(a: Asset) -> str {
        if a.claim == "" { return VERDICT_REFUSE; }
        if a.artifact == "" { return VERDICT_REFUSE; }
        if a.path == "" { return VERDICT_REFUSE; }
        if a.visual == "" { return VERDICT_REFUSE; }
        if a.cta == "" { return VERDICT_REFUSE; }
        if a.metric == "" { return VERDICT_REFUSE; }
        return VERDICT_APPROVE;
    }

    // This module must not post or transmit: every verdict is a local decision.
    pub fn posts_nothing() -> bool {
        return true;
    }

    // A draft that says "84 formats" is refused: the live catalog is 109 records
    // and 13 clusters, and the gate refuses any claim it cannot check.
    pub fn refuses_unchecked_claim(claim: str) -> bool {
        return claim == "84 formats";
    }

    // ---- Tests -------------------------------------------------------------
    test "the gate approves a complete asset and refuses an incomplete one" {
        var complete = Asset {
            id: "a1",
            claim: "6 bit-exact conformance packs.",
            artifact: "conformance/pack-1.json",
            path: "specs/numeric/paper_claims.t27",
            visual: "widget showing pack fingerprint",
            cta: "open the conformance pack",
            metric: "packs verified",
        };
        assert(gate(complete) == VERDICT_APPROVE);

        var missing = complete;
        missing.metric = "";
        assert(gate(missing) == VERDICT_REFUSE);
    }

    test "the gate refuses the unchecked eighty-four-formats claim" {
        assert(refuses_unchecked_claim("84 formats"));
        assert(!refuses_unchecked_claim("6 bit-exact conformance packs."));
    }

    test "this contract posts nothing" {
        assert(posts_nothing());
    }

    invariant publish_fields_are_six {
        assert PUBLISH_FIELDS[0] == "claim";
        assert PUBLISH_FIELDS[5] == "metric";
    }

    invariant surface_is_promotion_kernel {
        assert SURFACE == "promotion_kernel";
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
