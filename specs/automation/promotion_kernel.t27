// SPDX-License-Identifier: Apache-2.0
// specs/automation/promotion_kernel.t27 -- the proof-to-demand gate for a
// promotional draft. It refuses an unchecked claim and it does not post,
// send mail, or spend a paid token. The catalog numbers come from
// specs/numeric/paper_claims.t27 (109 records, 13 measured clusters).
// The round "84 formats" line, "BF16 21/21" and "FP8 15/16" are not rows
// that spec marks as fitting, so this gate refuses them (#13466).
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::promotion_kernel {

    use numeric::paper_claims::V_FITS;
    use numeric::paper_claims::row_verdict;
    use numeric::paper_claims::row_recomputed;
    use numeric::paper_claims::CATALOG_CLUSTERS;
    use numeric::paper_claims::CATALOG_RECORDS;
    use course::lesson_frames::LESSON_COUNT;
    use t27os::t27l::tl_normalize;
    use t27os::t27l::tl_validate_line;
    use t27os::t27l::TL_OK;

    pub const KIND : str = "automation";
    pub const ID : str = "promotion-kernel";
    pub const VERSION : u8 = 1;

    // This contract never transmits. Readiness is not a post.
    pub const MAY_POST : bool = false;
    pub const SENDS_MAIL : bool = false;
    pub const PAID_CHECKOUT : bool = false;

    pub const CLASS_FIT : str = "fit";
    pub const CLASS_REFUSED : str = "refused";

    // Paper row 10 is "the catalog holds 109 formats" (K_RECORDS).
    // Paper row 11 is "the 109 formats span 12 clusters", which misfits:
    // the recomputed cluster count is 13.
    pub const ROW_109_RECORDS : u32 = 10;
    pub const ROW_12_CLUSTERS : u32 = 11;

    // Not paper rows. The epic listed them as patterns; #13466 and #13468
    // say they are not checked claims.
    pub const CLAIM_84_FORMATS : u32 = 84;
    pub const CLAIM_BF16_21 : u32 = 211;
    pub const CLAIM_FP8_15 : u32 = 151;
    pub const CLAIM_CLUSTER_GAP : u32 = 13;

    fn unchecked_round(id: u32) -> bool {
        if id == CLAIM_84_FORMATS {
            return true;
        }
        if id == CLAIM_BF16_21 {
            return true;
        }
        if id == CLAIM_FP8_15 {
            return true;
        }
        return false;
    }

    // fit, or refused. An unknown id is refused: an unchecked claim does not pass.
    fn claim_class(id: u32) -> str {
        if unchecked_round(id) {
            return CLASS_REFUSED;
        }
        if id == ROW_109_RECORDS {
            if row_verdict(ROW_109_RECORDS) == V_FITS {
                return CLASS_FIT;
            }
            return CLASS_REFUSED;
        }
        if id == ROW_12_CLUSTERS {
            return CLASS_REFUSED;
        }
        if id == CLAIM_CLUSTER_GAP {
            if row_recomputed(ROW_12_CLUSTERS) == CATALOG_CLUSTERS {
                return CLASS_FIT;
            }
            return CLASS_REFUSED;
        }
        return CLASS_REFUSED;
    }

    // Six parts, or the asset stays a draft. A fitting claim with no visual
    // is not ready. Ready is still not a post (#13467).
    fn asset_ok(claim: bool, artifact: bool, path: bool, visual: bool, cta: bool, metric: bool) -> bool {
        if !claim {
            return false;
        }
        if !artifact {
            return false;
        }
        if !path {
            return false;
        }
        if !visual {
            return false;
        }
        if !cta {
            return false;
        }
        return metric;
    }

    // Ten calendar days. Each day names a claim. None of the ten is
    // publishable, visual or not (#13468). Days 0..3 and 6..9 name
    // refused claims. Days 4 and 5 name claims the gate fits, and they
    // stay drafts anyway: a calendar line is not a post.
    pub const CALENDAR_DAYS : u8 = 10;

    fn day_claim(day: u8) -> u32 {
        if day == 0 {
            return CLAIM_84_FORMATS;
        }
        if day == 1 {
            return CLAIM_BF16_21;
        }
        if day == 2 {
            return CLAIM_FP8_15;
        }
        if day == 3 {
            return ROW_12_CLUSTERS;
        }
        if day == 4 {
            return ROW_109_RECORDS;
        }
        if day == 5 {
            return CLAIM_CLUSTER_GAP;
        }
        return CLAIM_84_FORMATS;
    }

    fn day_publishable(day: u8, has_visual: bool) -> bool {
        if day < CALENDAR_DAYS && has_visual {
            return false;
        }
        return false;
    }

    fn publishable_days() -> u8 {
        var day : u8 = 0;
        var n : u8 = 0;
        while day < CALENDAR_DAYS {
            if day_publishable(day, true) {
                n = n + 1;
            }
            day = day + 1;
        }
        return n;
    }

    // Only the 7-day impression count is a known metric (#13470).
    // The figure is the one #13465 recorded for @t27_dev on 2026-11-09.
    // This agent did not re-measure X. Clicks, course starts and payments
    // are not stored: an unknown metric is not zero.
    pub const METRIC_IMPRESSIONS : u8 = 1;
    pub const METRIC_CLICKS : u8 = 2;
    pub const METRIC_COURSE_STARTS : u8 = 3;
    pub const METRIC_PAYMENTS : u8 = 4;
    pub const X_IMPRESSIONS_7D : u32 = 809;
    pub const X_IMPRESSIONS_SOURCE : str = "issue #13465, @t27_dev, 7-day view, 2026-11-09";

    fn metric_known(which: u8) -> bool {
        return which == METRIC_IMPRESSIONS;
    }

    fn stores_unknown_as_zero() -> bool {
        return false;
    }

    // An unchecked claim, a missing visual, or a paid-token use stops the
    // lane. A repair does not hide that stop (#13471).
    fn anomaly(unchecked_claim: bool, missing_visual: bool, paid_use: bool) -> bool {
        if unchecked_claim {
            return true;
        }
        if missing_visual {
            return true;
        }
        return paid_use;
    }

    fn repair_hides_failure() -> bool {
        return false;
    }

    // Pillar tags for the 10-day cycle. Two days each: proof, artifact,
    // course, github, cta. The weekly cadence reviews the drafts and posts
    // nothing (#13477).
    pub const PILLAR_PROOF : u8 = 1;
    pub const PILLAR_ARTIFACT : u8 = 2;
    pub const PILLAR_COURSE : u8 = 3;
    pub const PILLAR_GITHUB : u8 = 4;
    pub const PILLAR_CTA : u8 = 5;
    pub const WEEKLY_POSTS : u8 = 0;

    fn day_pillar(day: u8) -> u8 {
        if day <= 1 {
            return PILLAR_PROOF;
        }
        if day <= 3 {
            return PILLAR_ARTIFACT;
        }
        if day <= 5 {
            return PILLAR_COURSE;
        }
        if day <= 7 {
            return PILLAR_GITHUB;
        }
        return PILLAR_CTA;
    }

    fn weekly_posts() -> u8 {
        return WEEKLY_POSTS;
    }

    // Two drafts, and only claims the gate marks fit. Neither is published.
    // Neither has a visual: the still was not drawn in this task, so the
    // field is absent on purpose (#13478).
    pub const BANK_DRAFTS : u8 = 2;

    fn bank_claim(i: u8) -> u32 {
        if i == 0 {
            return ROW_109_RECORDS;
        }
        if i == 1 {
            return CLAIM_CLUSTER_GAP;
        }
        return CLAIM_84_FORMATS;
    }

    fn bank_uses_fit_claim(i: u8) -> bool {
        if i >= BANK_DRAFTS {
            return false;
        }
        return claim_class(bank_claim(i)) == CLASS_FIT;
    }

    fn bank_published(i: u8) -> bool {
        return false;
    }

    fn bank_has_visual(i: u8) -> bool {
        if i >= BANK_DRAFTS {
            return false;
        }
        return false;
    }

    // The publish gate opens only when a widget, a screenshot, a passing
    // test and a human yes are all present. Opening the gate does not
    // transmit (#13485).
    fn publish_gate(widget: bool, screenshot: bool, tests_pass: bool, human: bool) -> bool {
        if !widget {
            return false;
        }
        if !screenshot {
            return false;
        }
        if !tests_pass {
            return false;
        }
        return human;
    }

    fn gate_transmits() -> bool {
        return false;
    }

    // Baseline read on 2026-11-10 Asia/Bangkok (2026-11-09 UTC) from the
    // commands named below. BASELINE_DATE is that Bangkok calendar day.
    // X figures are the citation in #13465 (2026-11-09), not a new read.
    // Course readiness is not measured. LESSON_COUNT is the planned frame
    // count in specs/course/lesson_frames.t27, not a count of ready lessons.
    //   gh api repos/Trinity-S-AI-DNA/t27 --jq stars, forks
    //   gh api search/issues?q=repo:Trinity-S-AI-DNA/t27+is:issue+is:open
    //   gh api repos/Trinity-S-AI-DNA/t27/contributors?per_page=100
    pub const BASELINE_DATE : u32 = 20261110;
    pub const GH_STARS : u32 = 5;
    pub const GH_FORKS : u32 = 4;
    pub const GH_OPEN_ISSUES : u32 = 2041;
    pub const GH_CONTRIBUTORS_NAMED : u32 = 6;
    pub const GH_CONTRIBUTORS_WITH_ANON : u32 = 31;
    pub const X_FOLLOWERS_CITED : u32 = 231;
    pub const X_PROFILE_VISITS_CITED : u32 = 2;
    pub const COURSE_READY_KNOWN : bool = false;

    fn baseline_course_lessons() -> u32 {
        return LESSON_COUNT;
    }

    // Weekly campaign report. The field names are the epic final-report
    // template (#13473). An unknown metric is left blank, never written as 0.
    pub const WEEKLY_FIELD : [16]str = [
        "EPIC_CREATED",
        "ISSUES_CREATED",
        "BASELINE_CAPTURED",
        "COURSE_MAP_CREATED",
        "WIDGET_INVENTORY_CREATED",
        "CONTENT_CALENDAR_CREATED",
        "CONTENT_BANK_CREATED",
        "FUNNEL_LIVE",
        "METRICS_TRACKED",
        "CONTRIBUTOR_PATH_LIVE",
        "MONETIZATION_LIVE",
        "SELF_IMPROVING_LOOP_LIVE",
        "REGRESSION_STATUS",
        "ANOMALIES_FOUND",
        "BLOCKERS",
        "NEXT_ACTION",
    ];

    fn weekly_field_count() -> u8 {
        return WEEKLY_FIELD.len as u8;
    }

    // One CTA per funnel step. Paid product and B2B are named and not
    // offered: PAID_CHECKOUT stays false, so those steps have a refusal
    // rather than a payment link (#13479).
    pub const FUNNEL_NAME : [8]str = [
        "X",
        "arxiv-github",
        "course",
        "widget",
        "good-first-issue",
        "contributor",
        "paid-product",
        "b2b",
    ];

    fn funnel_steps() -> u8 {
        return FUNNEL_NAME.len as u8;
    }

    fn funnel_ctas(step: u8) -> u8 {
        if step < funnel_steps() {
            return 1;
        }
        return 0;
    }

    // One t27l/v1 line on surface agent. The payload is a claim id, not an
    // address (#13472). The event id is a fixture, the same shape t27l's own
    // tests use, and it names no person and no host.
    pub const PK_LINE_SRC : str = "{\"schema\":\"t27l/v1\",\"event_id\":\"0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d\",\"ts\":\"2026-11-10T00:00:00Z\",\"device_id\":\"desk-1\",\"session_id\":\"prom-1\",\"actor\":\"agent\",\"surface\":\"agent\",\"action\":\"agent_step\",\"level\":\"info\",\"payload\":\"claim-109\"}";
    pub const PK_PAYLOAD : str = "claim-109";

    fn payload_has_address(p: []const u8) -> bool {
        var i : usize = 0;
        while i < p.len {
            if p[i] == '@' {
                return true;
            }
            if i + 2 < p.len {
                if p[i] == ':' && p[i + 1] == '/' && p[i + 2] == '/' {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    fn pk_event(out: []u8) -> usize {
        if payload_has_address(PK_PAYLOAD) {
            return 0;
        }
        return tl_normalize(PK_LINE_SRC, out);
    }

    test "84 formats is refused and the 109-record catalog fits" {
        assert(claim_class(CLAIM_84_FORMATS) == CLASS_REFUSED);
        assert(claim_class(CLAIM_BF16_21) == CLASS_REFUSED);
        assert(claim_class(CLAIM_FP8_15) == CLASS_REFUSED);
        assert(claim_class(ROW_12_CLUSTERS) == CLASS_REFUSED);
        assert(claim_class(ROW_109_RECORDS) == CLASS_FIT);
        assert(claim_class(CLAIM_CLUSTER_GAP) == CLASS_FIT);
        assert(claim_class(0) == CLASS_REFUSED);
        assert(CATALOG_RECORDS == 109);
        assert(CATALOG_CLUSTERS == 13);
        assert(row_verdict(ROW_109_RECORDS) == V_FITS);
        assert(row_recomputed(ROW_12_CLUSTERS) == 13);
    }

    test "the contract posts nothing" {
        assert(!MAY_POST);
        assert(!SENDS_MAIL);
        assert(!PAID_CHECKOUT);
    }

    test "six parts or the asset is not ready, and ready does not post" {
        assert(asset_ok(true, true, true, true, true, true));
        assert(!asset_ok(true, true, true, false, true, true));
        assert(!asset_ok(false, true, true, true, true, true));
        assert(!asset_ok(true, false, true, true, true, true));
        assert(!asset_ok(true, true, false, true, true, true));
        assert(!asset_ok(true, true, true, true, false, true));
        assert(!asset_ok(true, true, true, true, true, false));
        assert(!MAY_POST);
    }

    test "ten calendar days stay drafts even with a visual" {
        assert(CALENDAR_DAYS == 10);
        assert(day_claim(0) == CLAIM_84_FORMATS);
        assert(day_claim(1) == CLAIM_BF16_21);
        assert(day_claim(2) == CLAIM_FP8_15);
        assert(day_claim(3) == ROW_12_CLUSTERS);
        assert(claim_class(day_claim(0)) == CLASS_REFUSED);
        assert(day_claim(4) == ROW_109_RECORDS);
        assert(claim_class(day_claim(4)) == CLASS_FIT);
        assert(!day_publishable(4, true));
        assert(!day_publishable(9, true));
        assert(!day_publishable(9, false));
        assert(publishable_days() == 0);
        assert(!MAY_POST);
    }

    test "only impressions are known, and a click count is not invented" {
        assert(metric_known(METRIC_IMPRESSIONS));
        assert(!metric_known(METRIC_CLICKS));
        assert(!metric_known(METRIC_COURSE_STARTS));
        assert(!metric_known(METRIC_PAYMENTS));
        assert(X_IMPRESSIONS_7D == 809);
        assert(!stores_unknown_as_zero());
        assert(!PAID_CHECKOUT);
        assert(X_IMPRESSIONS_SOURCE != "");
    }

    test "an unchecked claim, a missing visual, or paid use stops the lane" {
        assert(anomaly(true, false, false));
        assert(anomaly(false, true, false));
        assert(anomaly(false, false, true));
        assert(!anomaly(false, false, false));
        assert(!repair_hides_failure());
    }

    test "pk_event is one t27l line whose payload is a claim id" {
        var out : [2048]u8 = undefined;
        var n : usize = pk_event(out[0..2048]);
        assert(n > 0);
        assert(tl_validate_line(out[0..n]) == TL_OK);
        assert(!payload_has_address(PK_PAYLOAD));
        assert(payload_has_address("https://x.com/t27"));
        assert(payload_has_address("owner@example.com"));
        assert(PK_PAYLOAD == "claim-109");
    }

    test "the ten-day cycle has pillar tags and the week posts nothing" {
        assert(day_pillar(0) == PILLAR_PROOF);
        assert(day_pillar(1) == PILLAR_PROOF);
        assert(day_pillar(2) == PILLAR_ARTIFACT);
        assert(day_pillar(3) == PILLAR_ARTIFACT);
        assert(day_pillar(4) == PILLAR_COURSE);
        assert(day_pillar(5) == PILLAR_COURSE);
        assert(day_pillar(6) == PILLAR_GITHUB);
        assert(day_pillar(7) == PILLAR_GITHUB);
        assert(day_pillar(8) == PILLAR_CTA);
        assert(day_pillar(9) == PILLAR_CTA);
        assert(weekly_posts() == 0);
        assert(publishable_days() == 0);
    }

    test "the content bank drafts use fitting claims and are not published" {
        assert(BANK_DRAFTS == 2);
        assert(bank_uses_fit_claim(0));
        assert(bank_uses_fit_claim(1));
        assert(!bank_uses_fit_claim(2));
        assert(bank_claim(2) == CLAIM_84_FORMATS);
        assert(claim_class(CLAIM_84_FORMATS) == CLASS_REFUSED);
        assert(!bank_published(0));
        assert(!bank_published(1));
        assert(!bank_has_visual(0));
        assert(!bank_has_visual(1));
        assert(!MAY_POST);
    }

    test "the publish gate needs a widget, a screenshot, a test and a human" {
        assert(!publish_gate(false, true, true, true));
        assert(!publish_gate(true, false, true, true));
        assert(!publish_gate(true, true, false, true));
        assert(!publish_gate(true, true, true, false));
        assert(publish_gate(true, true, true, true));
        assert(!gate_transmits());
        assert(!MAY_POST);
    }

    test "the baseline records measured GitHub counts and does not invent course readiness" {
        assert(BASELINE_DATE == 20261110);
        assert(GH_STARS == 5);
        assert(GH_FORKS == 4);
        assert(GH_OPEN_ISSUES == 2041);
        assert(GH_CONTRIBUTORS_NAMED == 6);
        assert(GH_CONTRIBUTORS_WITH_ANON == 31);
        assert(X_IMPRESSIONS_7D == 809);
        assert(X_FOLLOWERS_CITED == 231);
        assert(X_PROFILE_VISITS_CITED == 2);
        assert(baseline_course_lessons() == 27);
        assert(!COURSE_READY_KNOWN);
        assert(!metric_known(METRIC_CLICKS));
    }

    test "the weekly report has the epic's sixteen fields" {
        assert(weekly_field_count() == 16);
        assert(WEEKLY_FIELD[0] == "EPIC_CREATED");
        assert(WEEKLY_FIELD[2] == "BASELINE_CAPTURED");
        assert(WEEKLY_FIELD[7] == "FUNNEL_LIVE");
        assert(WEEKLY_FIELD[8] == "METRICS_TRACKED");
        assert(WEEKLY_FIELD[15] == "NEXT_ACTION");
        assert(metric_known(METRIC_IMPRESSIONS));
        assert(!metric_known(METRIC_CLICKS));
    }

    test "each funnel step has one CTA, and paid checkout stays off" {
        assert(funnel_steps() == 8);
        var step : u8 = 0;
        while step < funnel_steps() {
            assert(funnel_ctas(step) == 1);
            step = step + 1;
        }
        assert(funnel_ctas(8) == 0);
        assert(FUNNEL_NAME[0] == "X");
        assert(FUNNEL_NAME[6] == "paid-product");
        assert(FUNNEL_NAME[7] == "b2b");
        assert(!PAID_CHECKOUT);
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
