// SPDX-License-Identifier: Apache-2.0
// specs/automation/promotion_kernel.t27 -- claim gate for the promotion kernel.
// A draft is publishable only when its claim is a fit against the live catalog.
// This module does not post, send mail, or spend tokens.
// Refs #13465, #13466, #13473
// phi^2 + 1/phi^2 = 3 | TRINITY

module promotion_kernel;

use numeric::paper_claims::CATALOG_RECORDS;
use numeric::paper_claims::CATALOG_CLUSTERS;
use numeric::paper_claims::V_FITS;
use numeric::paper_claims::V_MISFIT;
use numeric::paper_claims::V_UNCHECKED;
use numeric::paper_claims::F_GF16;
use numeric::paper_claims::row_verdict;
use numeric::paper_claims::encode3;

// Classes. Unknown text fails closed as refused.
pub const CC_FIT : u32 = 1;
pub const CC_MISFIT : u32 = 2;
pub const CC_UNCHECKED : u32 = 3;
pub const CC_REFUSED : u32 = 4;

// Claim ids. The names are the claims; the numbers are what claim_class sees.
pub const CID_CATALOG_109 : u32 = 1;       // paper row 10, "109 formats", recomputed
pub const CID_CLUSTERS_12 : u32 = 2;       // paper row 11, "12 clusters", a misfit
pub const CID_FORMATS_84 : u32 = 3;        // "84 formats"
pub const CID_ML_DTYPES : u32 = 4;         // paper row 19, cross-validation, unchecked
pub const CID_BF16_21_OF_21 : u32 = 5;     // "BF16: 21/21 vectors match ml_dtypes"
pub const CID_FP8_15_OF_16 : u32 = 6;      // "FP8 E4M3: 15/16"
pub const CID_GF16_ANCHOR : u32 = 7;       // 3.0 in GF16 is 0x4100
pub const CID_GETTERS_AS_FORMATS : u32 = 8; // "83 formats" (83 is the getter count)
pub const CID_SIX_PACKS_ML : u32 = 9;      // six packs match ml_dtypes
pub const CID_WIDGET_ALL_PACK : u32 = 10;  // the widget checks every pack vector
pub const CID_LAST : u32 = 10;

// paper_claims rows, counted from CL_TEXT in specs/numeric/paper_claims.t27.
pub const ROW_RECORDS : u32 = 10;
pub const ROW_CLUSTERS : u32 = 11;
pub const ROW_ML_DTYPES : u32 = 19;

// Getter lines in specs/numeric/formats_catalog.t27, measured 2026-11-09.
// Command: a line counts when strip() starts with "fn ", and contains "-> str"
// and "return". That is bootstrap/src/catalog_gate.rs count_getters. Result: 83.
// CATALOG comment lines the same day: 109. Distinct cluster= values: 13.
pub const GETTER_COUNT : u64 = 83;

// gf16_conformance_v0.json, measured 2026-11-09: n_vectors 21 and len(vectors) 21.
// specs/widgets/gf16_calc.t27 K_CHECK_COUNT is 20. The page omits identity_sum
// (same bits as the vector named three). "20 of 20" is the page's own table.
pub const GF16_PACK_VECTORS : u32 = 21;
pub const GF16_WIDGET_CHECKS : u32 = 20;

pub fn widget_covers_pack() -> bool {
    return GF16_PACK_VECTORS == GF16_WIDGET_CHECKS;
}

pub fn claim_class(id: u32) -> u32 {
    if (id == CID_CATALOG_109) {
        if (row_verdict(ROW_RECORDS) == V_FITS and CATALOG_RECORDS == 109) { return CC_FIT; }
        return CC_MISFIT;
    }
    if (id == CID_CLUSTERS_12) {
        if (row_verdict(ROW_CLUSTERS) == V_MISFIT and CATALOG_CLUSTERS == 13) { return CC_MISFIT; }
        return CC_REFUSED;
    }
    if (id == CID_FORMATS_84) { return CC_REFUSED; }
    if (id == CID_ML_DTYPES) {
        if (row_verdict(ROW_ML_DTYPES) == V_UNCHECKED) { return CC_UNCHECKED; }
        return CC_REFUSED;
    }
    if (id == CID_BF16_21_OF_21) { return CC_UNCHECKED; }
    if (id == CID_FP8_15_OF_16) { return CC_UNCHECKED; }
    if (id == CID_GF16_ANCHOR) {
        if (encode3(F_GF16) == 16640) { return CC_FIT; }
        return CC_MISFIT;
    }
    if (id == CID_GETTERS_AS_FORMATS) { return CC_REFUSED; }
    if (id == CID_SIX_PACKS_ML) { return CC_UNCHECKED; }
    if (id == CID_WIDGET_ALL_PACK) {
        if (widget_covers_pack()) { return CC_FIT; }
        return CC_REFUSED;
    }
    return CC_REFUSED;
}

pub fn claim_publishable(id: u32) -> bool {
    return claim_class(id) == CC_FIT;
}

// How many unchecked ids this table marks publishable. The gate requires 0.
pub fn unchecked_publishable() -> u32 {
    var i : u32 = 1;
    var n : u32 = 0;
    while (i <= CID_LAST) {
        if (claim_class(i) == CC_UNCHECKED and claim_publishable(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn phrase_at(hay: str, at: u32, needle: str) -> bool {
    if (needle.len == 0 or at + needle.len > hay.len) { return false; }
    var i : u32 = 0;
    while (i < needle.len) {
        if (hay[at + i] != needle[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn has_phrase(hay: str, needle: str) -> bool {
    if (needle.len == 0 or needle.len > hay.len) { return false; }
    var i : u32 = 0;
    while (i + needle.len <= hay.len) {
        if (phrase_at(hay, i, needle)) { return true; }
        i = i + 1;
    }
    return false;
}

// Text form of the same gate. A refused phrase wins over every other class.
// Text with no known phrase is refused.
pub fn draft_class(text: str) -> u32 {
    if (has_phrase(text, "84 formats") or has_phrase(text, "83 formats") or has_phrase(text, "21/21") or has_phrase(text, "15/16")) {
        return CC_REFUSED;
    }
    if (has_phrase(text, "ml_dtypes")) { return CC_UNCHECKED; }
    if (has_phrase(text, "12 clusters")) { return CC_MISFIT; }
    if (has_phrase(text, "109 records") or has_phrase(text, "0x4100")) { return CC_FIT; }
    return CC_REFUSED;
}

test eighty_four_formats_is_refused {
    assert claim_class(CID_FORMATS_84) == CC_REFUSED;
    assert claim_publishable(CID_FORMATS_84) == false;
    assert CATALOG_RECORDS != 84;
    assert GETTER_COUNT != 84;
    assert CATALOG_RECORDS != GETTER_COUNT;
    assert draft_class("84 formats in one catalog") == CC_REFUSED;
}

test catalog_109_is_a_fit_and_12_clusters_is_not {
    assert claim_class(CID_CATALOG_109) == CC_FIT;
    assert claim_publishable(CID_CATALOG_109);
    assert claim_class(CID_CLUSTERS_12) == CC_MISFIT;
    assert claim_publishable(CID_CLUSTERS_12) == false;
    assert CATALOG_CLUSTERS == 13;
    assert draft_class("109 records") == CC_FIT;
    assert draft_class("the paper says 12 clusters") == CC_MISFIT;
}

test unchecked_match_ratios_are_not_publishable {
    assert claim_class(CID_ML_DTYPES) == CC_UNCHECKED;
    assert claim_class(CID_BF16_21_OF_21) == CC_UNCHECKED;
    assert claim_class(CID_FP8_15_OF_16) == CC_UNCHECKED;
    assert claim_class(CID_SIX_PACKS_ML) == CC_UNCHECKED;
    assert claim_publishable(CID_BF16_21_OF_21) == false;
    assert claim_publishable(CID_FP8_15_OF_16) == false;
    assert unchecked_publishable() == 0;
    assert draft_class("BF16: 21/21 vectors match ml_dtypes") == CC_REFUSED;
    assert draft_class("FP8 E4M3: 15/16 vectors match") == CC_REFUSED;
    assert draft_class("cross-checked with ml_dtypes 0.5.4") == CC_UNCHECKED;
}

test gf16_anchor_fits_and_getter_count_is_not_a_format_count {
    assert encode3(F_GF16) == 16640;
    assert claim_class(CID_GF16_ANCHOR) == CC_FIT;
    assert claim_class(CID_GETTERS_AS_FORMATS) == CC_REFUSED;
    assert GETTER_COUNT == 83;
    assert draft_class("3.0 in GF16 is 0x4100") == CC_FIT;
    assert draft_class("83 formats") == CC_REFUSED;
    assert draft_class("109 records but also 84 formats") == CC_REFUSED;
}

test widget_table_is_not_the_whole_pack {
    assert GF16_PACK_VECTORS == 21;
    assert GF16_WIDGET_CHECKS == 20;
    assert widget_covers_pack() == false;
    assert claim_class(CID_WIDGET_ALL_PACK) == CC_REFUSED;
}

test unknown_id_and_empty_text_are_refused {
    assert claim_class(0) == CC_REFUSED;
    assert claim_class(CID_LAST + 1) == CC_REFUSED;
    assert draft_class("") == CC_REFUSED;
    assert draft_class("hello") == CC_REFUSED;
    assert has_phrase("84 formats", "84 formats");
    assert has_phrase("xx", "84 formats") == false;
    assert has_phrase("84 formats", "") == false;
    assert phrase_at("84 formats", 0, "84");
    assert phrase_at("84 formats", 1, "84") == false;
    assert phrase_at("84 formats", 0, "") == false;
}

invariant no_unchecked_claim_is_publishable {
    assert unchecked_publishable() == 0;
    assert claim_publishable(CID_FORMATS_84) == false;
    assert claim_publishable(CID_ML_DTYPES) == false;
}
