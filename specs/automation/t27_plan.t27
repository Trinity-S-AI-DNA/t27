// SPDX-License-Identifier: Apache-2.0
// specs/automation/t27_plan.t27 -- shared work ledger for agents.
// Records goals, milestones, claims and leases. Does not draw a panel,
// does not rewrite the existing UI kit, and does not open the OS window spec.
// Part of [EPIC] T27_PLAN_V2 (#13486). Closes #13486.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::t27_plan {

    pub const MODULE : str = "t27_plan";
    pub const SURFACE : str = "plan";

    // ---- The ledger -------------------------------------------------------
    pub struct Goal {
        id : str,
        owner : str,
        milestone : str,
        order_slot : u32,
        state : str,   // "open" | "claimed" | "done" | "blocked"
    };

    pub struct Milestone {
        id : str,
        order_slot : u32,
        title : str,
        state : str,   // "open" | "done"
    };

    pub struct Claim {
        id : str,
        lane : str,
        holder : str,
        issued_at : str,
        released_at : str,
    };

    pub struct Lease {
        id : str,
        issue : str,
        agent : str,
        worktree : str,
        branch : str,
        scope : str,
        state : str,   // "claimed" | "started" | "done" | "blocked"
    };

    // ---- Rules ------------------------------------------------------------
    // Every goal MUST have an owner and every milestone MUST have an order slot.
    pub fn goal_well_formed(g: Goal) -> bool {
        return g.owner != "" && g.milestone != "" && g.order_slot > 0;
    }

    pub fn milestone_well_formed(m: Milestone) -> bool {
        return m.order_slot > 0 && m.title != "";
    }

    // A second claim on a held lane is blocked.
    pub fn claim_acquire(claims: [4]Claim, lane: str) -> bool {
        var i : u32 = 0;
        while (i < 4) {
            if (claims[i].lane == lane && claims[i].released_at == "") {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // A paid action and an outbound send MUST NOT proceed from this module.
    pub fn paid_action_allowed() -> bool {
        return false;
    }

    pub fn outbound_send_allowed() -> bool {
        return false;
    }

    // A lease must name its issue, agent, worktree, branch and scope.
    pub fn lease_well_formed(l: Lease) -> bool {
        return l.issue != "" && l.agent != "" && l.worktree != ""
            && l.branch != "" && l.scope != "";
    }

    // ---- Tests ------------------------------------------------------------
    test "every goal has an owner and every milestone has an order slot" {
        assert(goal_well_formed(Goal {
            id: "g1", owner: "agent-a", milestone: "m1", order_slot: 1, state: "open"
        }));
        assert(!goal_well_formed(Goal {
            id: "g2", owner: "", milestone: "m1", order_slot: 1, state: "open"
        }));
        assert(milestone_well_formed(Milestone {
            id: "m1", order_slot: 1, title: "M1", state: "open"
        }));
        assert(!milestone_well_formed(Milestone {
            id: "m2", order_slot: 0, title: "", state: "open"
        }));
    }

    test "a second claim on a held lane is blocked" {
        var claims : [4]Claim;
        claims[0] = Claim {
            id: "c1", lane: "lane-a", holder: "agent-a",
            issued_at: "t0", released_at: "",
        };
        assert(!claim_acquire(claims, "lane-a"));
        assert(claim_acquire(claims, "lane-b"));
    }

    test "no paid action or outbound send proceeds from this module" {
        assert(!paid_action_allowed());
        assert(!outbound_send_allowed());
    }

    test "a lease names issue, agent, worktree, branch and scope" {
        assert(lease_well_formed(Lease {
            id: "l1", issue: "#1", agent: "agent-a",
            worktree: "/lane/a", branch: "claude/a-1", scope: "specs/automation/t27_plan.t27",
            state: "claimed",
        }));
        assert(!lease_well_formed(Lease {
            id: "l2", issue: "", agent: "agent-a",
            worktree: "/lane/a", branch: "claude/a-1", scope: "specs/automation/t27_plan.t27",
            state: "claimed",
        }));
    }

    invariant no_paid_action_from_plan_module {
        assert paid_action_allowed() == false;
    }

    invariant no_outbound_send_from_plan_module {
        assert outbound_send_allowed() == false;
    }

    invariant every_milestone_has_order_slot {
        assert milestone_well_formed(Milestone {
            id: "m", order_slot: 1, title: "t", state: "open"
        });
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
