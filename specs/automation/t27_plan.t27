// SPDX-License-Identifier: Apache-2.0
// specs/automation/t27_plan.t27 -- the shared work ledger. It decides who may
// touch what. It does not draw a panel and it does not replace the UI kit.
// Kit: specs/t27f/ui_kit.t27 and specs/t27f/ui_plan.t27 already hold button,
// card, badge, input, text and container. This sprint does not rewrite them.
// glass_window.t27 stays closed until a replacement exists.
// Mail decisions stay in specs/automation/grok_crm.t27.
// Promotion claims stay in specs/automation/promotion_kernel.t27.
// A file lease here is a decision, not the Queen lease in specs/queen/dispatch.t27.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::t27_plan {

    pub const KIND : str = "automation";
    pub const ID : str = "t27-plan";
    pub const VERSION : u8 = 1;

    use automation::grok_crm::may_transmit;
    use automation::grok_crm::PAID_MODEL_SWITCH;
    use automation::promotion_kernel::may_post;
    use t27os::t27l::tl_event_line;
    use t27os::t27l::tl_validate_line;
    use t27os::t27l::TL_OK;

    // ---- objects 1..14 ----
    pub const OB_GOAL : u8 = 1;
    pub const OB_MILESTONE : u8 = 2;
    pub const OB_ISSUE : u8 = 3;
    pub const OB_LANE : u8 = 4;
    pub const OB_OWNER : u8 = 5;
    pub const OB_CLAIM : u8 = 6;
    pub const OB_LEASE : u8 = 7;
    pub const OB_ARTIFACT : u8 = 8;
    pub const OB_SHOT : u8 = 9;
    pub const OB_METRIC : u8 = 10;
    pub const OB_RISK : u8 = 11;
    pub const OB_ANOMALY : u8 = 12;
    pub const OB_APPROVAL : u8 = 13;
    pub const OB_AUDIT : u8 = 14;

    pub const GOALS : u8 = 7;
    pub const MILESTONES : u8 = 11;
    pub const COMMANDS : u8 = 19;

    // Due slots are an order, M0 = 1 .. M10 = 11. No calendar day is invented.
    pub const DUE_IS_ORDER : bool = true;
    pub const DUE_IS_CALENDAR : bool = false;

    // The kit already exists. This sprint records that and does not fork it.
    pub const KIT_PRESENT : bool = true;
    pub const KIT_REWRITTEN : bool = false;
    pub const GLASS_OPEN : bool = false;
    // A decision table is not a writer. No process saves a picture or diffs pixels.
    pub const SHOT_PIPELINE : bool = false;
    pub const VISUAL_REGRESSION : bool = false;
    pub const TRI_PLAN_BINARY : bool = false;
    pub const HOST_MOUNTED : bool = false;
    pub const LAB_RUNNER : bool = false;
    pub const PICTURE_WRITER : bool = false;
    pub const PIXEL_RUNNER : bool = false;
    // 0 nobody asked, 1 asked, 2 granted. Asked is not granted.
    pub const PERMIT_NONE : u8 = 0;
    pub const PERMIT_ASKED : u8 = 1;
    pub const PERMIT_GRANTED : u8 = 2;
    pub const PERMIT_HOST : u8 = 1;
    pub const PERMIT_WRITER : u8 = 1;
    pub const PERMIT_PIXEL : u8 = 1;
    pub const PERMIT_LAB : u8 = 1;
    pub const PERMIT_TEST : u8 = 1;
    pub const WIDGET_COMPILED : bool = false;
    pub const WIDGET_SHOT : bool = false;
    // A 2 by 2 P3 record. The host that would write those bytes does not exist.
    pub const PPM_W : u32 = 2;
    pub const PPM_H : u32 = 2;
    pub const PPM_MAX : u32 = 255;

    // ---- goal / milestone / issue / lane states ----
    pub const G_DRAFT : u8 = 1;
    pub const G_ACTIVE : u8 = 2;
    pub const G_BLOCKED : u8 = 3;
    pub const G_DONE : u8 = 4;
    pub const G_ARCHIVED : u8 = 5;

    pub const MS_PLANNED : u8 = 1;
    pub const MS_PROGRESS : u8 = 2;
    pub const MS_BLOCKED : u8 = 3;
    pub const MS_DONE : u8 = 4;

    pub const IS_NEW : u8 = 1;
    pub const IS_CLAIMED : u8 = 2;
    pub const IS_PROGRESS : u8 = 3;
    pub const IS_WAITING : u8 = 4;
    pub const IS_BLOCKED : u8 = 5;
    pub const IS_READY : u8 = 6;
    pub const IS_MERGED : u8 = 7;
    pub const IS_CLOSED : u8 = 8;

    pub const LN_IDLE : u8 = 1;
    pub const LN_CLAIMED : u8 = 2;
    pub const LN_RUNNING : u8 = 3;
    pub const LN_RATE : u8 = 4;
    pub const LN_BLOCKED : u8 = 5;
    pub const LN_DONE : u8 = 6;
    pub const LN_FAILED : u8 = 7;

    // ---- paths this sprint may name ----
    pub const PATH_PLAN : u8 = 1;
    pub const PATH_GLASS : u8 = 2;
    pub const PATH_KIT : u8 = 3;

    pub const OUT_OK : u8 = 1;
    pub const OUT_WAIT : u8 = 2;
    pub const OUT_BLOCKED : u8 = 3;

    pub const A_SCOPE : u8 = 1;
    pub const A_LEASE : u8 = 2;
    pub const A_PAID : u8 = 3;
    pub const A_ORPHAN : u8 = 4;

    // G1 kit, G2 course, G3 promotion, G4 crm, G5 contributors, G6 money, G7 loop.
    // G3 and G6 stay blocked: the promotion gate has not posted, and checkout is off.
    pub const GOAL_STATE : [7]u8 = [2, 3, 3, 2, 1, 3, 3];

    pub const TL_ACTOR : u8 = 2;
    pub const TL_SURFACE : u8 = 11;
    pub const TL_ACTION : u8 = 26;
    pub const TL_LEVEL : u8 = 2;
    pub const PL_EVENT_ID : str = "d38e2f33-6d2c-4e49-8f33-2c49d38e2f33";
    pub const PL_EVENT_TS : str = "2026-11-09T16:10:00Z";

    pub fn object_known(o: u8) -> bool {
        return o >= OB_GOAL && o <= OB_AUDIT;
    }

    pub fn goal_ok(id: u8, owner: u8) -> bool {
        return id >= 1 && id <= GOALS && owner >= 1 && owner <= GOALS;
    }

    /// A due slot is the milestone's place in line. Slot 0 is refused.
    pub fn milestone_ok(id: u8, due_slot: u8) -> bool {
        return id >= 1 && id <= MILESTONES && due_slot == id && DUE_IS_ORDER && !DUE_IS_CALENDAR;
    }

    pub fn issue_ok(owner: u8, goal: u8) -> bool {
        return owner >= 1 && owner <= GOALS && goal >= 1 && goal <= GOALS;
    }

    pub fn goal_state_ok(s: u8) -> bool { return s >= G_DRAFT && s <= G_ARCHIVED; }
    pub fn milestone_state_ok(s: u8) -> bool { return s >= MS_PLANNED && s <= MS_DONE; }
    pub fn issue_state_ok(s: u8) -> bool { return s >= IS_NEW && s <= IS_CLOSED; }
    pub fn lane_state_ok(s: u8) -> bool { return s >= LN_IDLE && s <= LN_FAILED; }

    /// One lane, one claim. A second claim on a held lane is blocked.
    pub fn claim_acquire(held: bool) -> u8 {
        if (held) { return OUT_BLOCKED; }
        return OUT_OK;
    }

    pub fn claim_release(held: bool) -> u8 {
        if (!held) { return OUT_BLOCKED; }
        return OUT_OK;
    }

    /// One path, one writer. The glass file and the kit are not taken by this sprint.
    pub fn lease_acquire(path: u8, held: bool) -> u8 {
        if (path == PATH_GLASS || path == PATH_KIT) { return OUT_BLOCKED; }
        if (path != PATH_PLAN) { return OUT_BLOCKED; }
        if (held) { return OUT_BLOCKED; }
        return OUT_OK;
    }

    pub fn lease_release(held: bool) -> u8 {
        if (!held) { return OUT_BLOCKED; }
        return OUT_OK;
    }

    pub fn artifact_ok(has_path: bool) -> bool { return has_path; }

    pub fn screenshot_ok(ui_change: bool, has_shot: bool) -> bool {
        if (!ui_change) { return true; }
        return has_shot;
    }

    /// Unknown metrics stay unknown. A missing measurement is not a zero.
    pub fn metric_record(known: bool) -> u8 {
        if (!known) { return OUT_BLOCKED; }
        return OUT_OK;
    }

    pub fn approval_needed(paid: bool, outbound: bool) -> bool {
        return paid || outbound;
    }

    pub fn anomaly(scope_glass: bool, lease_clash: bool, paid: bool, orphan: bool) -> u8 {
        if (paid || PAID_MODEL_SWITCH) { return A_PAID; }
        if (scope_glass || GLASS_OPEN) { return A_SCOPE; }
        if (lease_clash) { return A_LEASE; }
        if (orphan) { return A_ORPHAN; }
        return 0;
    }

    /// Commands 1..19. Anything that would post, send, pay, or open the glass file waits or blocks.
    pub fn plan_command(id: u8, paid: bool, outbound: bool) -> u8 {
        if (id < 1 || id > COMMANDS) { return OUT_BLOCKED; }
        if (paid || PAID_MODEL_SWITCH) { return OUT_BLOCKED; }
        if (outbound || may_transmit() || may_post()) { return OUT_WAIT; }
        if (id == 16) { return OUT_WAIT; }
        return OUT_OK;
    }

    /// The only next step this sprint allows: keep the plan file, leave the window alone.
    pub fn plan_next() -> u8 {
        if (GLASS_OPEN || KIT_REWRITTEN) { return OUT_BLOCKED; }
        return PATH_PLAN;
    }

    /// Nineteen verbs, one id each. Group is the noun, verb is the action.
    /// 1 init, 2 goal create, 3 milestone create, 4 issue create, 5 issue claim,
    /// 6 issue release, 7 lane spawn, 8 lane status, 9 lease acquire,
    /// 10 lease release, 11 artifact save, 12 screenshot save, 13 metric record,
    /// 14 risk add, 15 anomaly detect, 16 approval request, 17 audit write,
    /// 18 report, 19 next. Any other pair is refused.
    pub fn plan_verb(group: u8, verb: u8) -> u8 {
        if (group == 1 && verb == 1) { return 1; }
        if (group == 2 && verb == 1) { return 2; }
        if (group == 3 && verb == 1) { return 3; }
        if (group == 4 && verb == 1) { return 4; }
        if (group == 4 && verb == 2) { return 5; }
        if (group == 4 && verb == 3) { return 6; }
        if (group == 5 && verb == 1) { return 7; }
        if (group == 5 && verb == 2) { return 8; }
        if (group == 6 && verb == 1) { return 9; }
        if (group == 6 && verb == 2) { return 10; }
        if (group == 7 && verb == 1) { return 11; }
        if (group == 8 && verb == 1) { return 12; }
        if (group == 9 && verb == 1) { return 13; }
        if (group == 10 && verb == 1) { return 14; }
        if (group == 11 && verb == 1) { return 15; }
        if (group == 12 && verb == 1) { return 16; }
        if (group == 13 && verb == 1) { return 17; }
        if (group == 1 && verb == 2) { return 18; }
        if (group == 1 && verb == 3) { return 19; }
        return 0;
    }

    /// A picture record needs a path and at least one byte. This does not write a file.
    pub fn shot_save(has_path: bool, bytes: u32) -> u8 {
        if (!has_path || bytes == 0) { return OUT_BLOCKED; }
        return OUT_OK;
    }

    /// Two hashes agree only when a picture exists and the bytes match.
    /// Calling this is not a pixel run. VISUAL_REGRESSION stays false.
    pub fn regress(has_shot: bool, before: u32, after: u32) -> u8 {
        if (!has_shot) { return OUT_BLOCKED; }
        if (before == after) { return OUT_OK; }
        return OUT_BLOCKED;
    }

    /// The course page that would draw a kit graph is not written.
    pub fn course_widget() -> u8 {
        if (WIDGET_COMPILED) { return OUT_OK; }
        return OUT_BLOCKED;
    }

    /// The window shell stays shut even if someone asks for it by verb 0 on group 14.
    pub fn window_shell() -> u8 {
        return OUT_BLOCKED;
    }

    /// Pixel count of a picture record. A zero side is not a picture.
    pub fn ppm_pixels(w: u32, h: u32) -> u32 {
        if (w == 0 || h == 0) { return 0; }
        return w * h;
    }

    /// A record is acceptable when it has a size and enough bytes for one sample per pixel.
    /// Accepting a record does not write a file. PICTURE_WRITER stays false.
    pub fn ppm_record_ok(w: u32, h: u32, maxv: u32, nbytes: u32) -> bool {
        if (w == 0 || h == 0 || maxv == 0) { return false; }
        return nbytes >= ppm_pixels(w, h);
    }

    /// How many of four samples differ. This is the diff law. PIXEL_RUNNER stays false.
    pub fn pixel_diff4(a0: u8, a1: u8, a2: u8, a3: u8, b0: u8, b1: u8, b2: u8, b3: u8) -> u8 {
        var n : u8 = 0;
        if (a0 != b0) { n = n + 1; }
        if (a1 != b1) { n = n + 1; }
        if (a2 != b2) { n = n + 1; }
        if (a3 != b3) { n = n + 1; }
        return n;
    }

    pub fn permit_granted(p: u8) -> bool {
        return p == PERMIT_GRANTED;
    }

    /// The nineteen verbs are the host table. Nothing in this tree mounts them on a binary.
    /// A request is not a grant, so host_ready stays false while every permit is asked.
    pub fn host_ready() -> bool {
        if (!permit_granted(PERMIT_HOST) || !permit_granted(PERMIT_WRITER)) { return false; }
        if (!permit_granted(PERMIT_PIXEL) || !permit_granted(PERMIT_LAB)) { return false; }
        if (!permit_granted(PERMIT_TEST)) { return false; }
        return HOST_MOUNTED && TRI_PLAN_BINARY && LAB_RUNNER && PICTURE_WRITER && PIXEL_RUNNER;
    }

    pub fn pl_event(out: []u8, event_id: []const u8, ts: []const u8, payload: []const u8) -> usize {
        return tl_event_line(out, event_id, ts, "mac-1", "sess-1", TL_ACTOR, TL_SURFACE, TL_ACTION,
                             TL_LEVEL, "", "", "", payload, "");
    }

    test "seven goals and eleven ordered milestones, each with an owner or a slot" {
        assert(object_known(OB_GOAL));
        assert(object_known(OB_AUDIT));
        assert(!object_known(0));
        assert(goal_ok(1, 1));
        assert(goal_ok(7, 7));
        assert(!goal_ok(0, 1));
        assert(!goal_ok(1, 0));
        assert(milestone_ok(1, 1));
        assert(milestone_ok(11, 11));
        assert(!milestone_ok(1, 2));
        assert(!milestone_ok(1, 0));
        assert(DUE_IS_ORDER);
        assert(!DUE_IS_CALENDAR);
        assert(issue_ok(4, 4));
        assert(!issue_ok(0, 1));
        assert(GOAL_STATE[0] == G_ACTIVE);
        assert(GOAL_STATE[2] == G_BLOCKED);
        assert(GOAL_STATE[5] == G_BLOCKED);
        assert(goal_state_ok(G_ARCHIVED));
        assert(milestone_state_ok(MS_PLANNED));
        assert(issue_state_ok(IS_MERGED));
        assert(lane_state_ok(LN_RATE));
    }

    test "one claim and one lease, and the window stays shut" {
        assert(claim_acquire(false) == OUT_OK);
        assert(claim_acquire(true) == OUT_BLOCKED);
        assert(claim_release(true) == OUT_OK);
        assert(claim_release(false) == OUT_BLOCKED);
        assert(lease_acquire(PATH_PLAN, false) == OUT_OK);
        assert(lease_acquire(PATH_PLAN, true) == OUT_BLOCKED);
        assert(lease_acquire(PATH_GLASS, false) == OUT_BLOCKED);
        assert(lease_acquire(PATH_KIT, false) == OUT_BLOCKED);
        assert(lease_release(true) == OUT_OK);
        assert(!GLASS_OPEN);
        assert(KIT_PRESENT);
        assert(!KIT_REWRITTEN);
        assert(plan_next() == PATH_PLAN);
        assert(!TRI_PLAN_BINARY);
        assert(plan_verb(1, 1) == 1);
        assert(plan_verb(4, 2) == 5);
        assert(plan_verb(4, 3) == 6);
        assert(plan_verb(1, 3) == 19);
        assert(plan_verb(12, 1) == 16);
        assert(plan_verb(0, 1) == 0);
        assert(plan_verb(4, 9) == 0);
        assert(plan_command(plan_verb(1, 1), false, false) == OUT_OK);
        assert(plan_command(plan_verb(12, 1), false, false) == OUT_WAIT);
        assert(window_shell() == OUT_BLOCKED);
        assert(course_widget() == OUT_BLOCKED);
        assert(!WIDGET_COMPILED);
        assert(!WIDGET_SHOT);
        assert(!HOST_MOUNTED);
        assert(!LAB_RUNNER);
        assert(!PICTURE_WRITER);
        assert(!PIXEL_RUNNER);
        assert(PERMIT_HOST == PERMIT_ASKED);
        assert(PERMIT_WRITER == PERMIT_ASKED);
        assert(PERMIT_PIXEL == PERMIT_ASKED);
        assert(PERMIT_LAB == PERMIT_ASKED);
        assert(PERMIT_TEST == PERMIT_ASKED);
        assert(!permit_granted(PERMIT_HOST));
        assert(!permit_granted(PERMIT_WRITER));
        assert(!permit_granted(PERMIT_PIXEL));
        assert(!permit_granted(PERMIT_LAB));
        assert(!permit_granted(PERMIT_TEST));
        assert(!host_ready());
    }

    test "a UI change without a picture is refused, and unknowns are not zeros" {
        assert(artifact_ok(true));
        assert(!artifact_ok(false));
        assert(screenshot_ok(false, false));
        assert(!screenshot_ok(true, false));
        assert(screenshot_ok(true, true));
        assert(metric_record(true) == OUT_OK);
        assert(metric_record(false) == OUT_BLOCKED);
        assert(!SHOT_PIPELINE);
        assert(!VISUAL_REGRESSION);
        assert(shot_save(true, 12) == OUT_OK);
        assert(shot_save(true, 0) == OUT_BLOCKED);
        assert(shot_save(false, 12) == OUT_BLOCKED);
        assert(regress(false, 1, 1) == OUT_BLOCKED);
        assert(regress(true, 1, 1) == OUT_OK);
        assert(regress(true, 1, 2) == OUT_BLOCKED);
        assert(ppm_pixels(PPM_W, PPM_H) == 4);
        assert(ppm_pixels(0, 2) == 0);
        assert(ppm_record_ok(PPM_W, PPM_H, PPM_MAX, 4));
        assert(!ppm_record_ok(PPM_W, PPM_H, PPM_MAX, 3));
        assert(pixel_diff4(1, 2, 3, 4, 1, 2, 3, 4) == 0);
        assert(pixel_diff4(1, 2, 3, 4, 1, 9, 3, 8) == 2);
    }

    test "pay, post and send stay closed, and a clash is an anomaly" {
        assert(approval_needed(true, false));
        assert(approval_needed(false, true));
        assert(!approval_needed(false, false));
        assert(plan_command(1, false, false) == OUT_OK);
        assert(plan_command(16, false, false) == OUT_WAIT);
        assert(plan_command(1, true, false) == OUT_BLOCKED);
        assert(plan_command(0, false, false) == OUT_BLOCKED);
        assert(plan_command(20, false, false) == OUT_BLOCKED);
        assert(!may_transmit());
        assert(!may_post());
        assert(!PAID_MODEL_SWITCH);
        assert(anomaly(true, false, false, false) == A_SCOPE);
        assert(anomaly(false, true, false, false) == A_LEASE);
        assert(anomaly(false, false, true, false) == A_PAID);
        assert(anomaly(false, false, false, true) == A_ORPHAN);
        assert(anomaly(false, false, false, false) == 0);
    }

    test "the plan line is a valid T27L event" {
        var ln : [2048]u8 = undefined;
        const n : usize = pl_event(ln[0..2048], PL_EVENT_ID, PL_EVENT_TS, "plan sprint=1 glass=0");
        assert(n > 0);
        assert(tl_validate_line(ln[0..n]) == TL_OK);
    }

    invariant the_window_stays_closed {
        assert GLASS_OPEN == false;
        assert KIT_REWRITTEN == false;
        assert plan_next() == PATH_PLAN;
    }

    invariant one_writer {
        assert lease_acquire(PATH_PLAN, true) == OUT_BLOCKED;
        assert claim_acquire(true) == OUT_BLOCKED;
        assert may_post() == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
