// specs/automation/t27_plan.t27 -- T27OS orchestrator v1 plan.
// Six steps, all decisions in the t27os contracts. This plan does not open
// the window shell, and it does not copy those decisions.

module automation::t27_plan {
    use t27os::orchestrator::oc_allowed;
    use t27os::orchestrator::OC_ACT_WINDOW;
    use t27os::orchestrator::OC_ACT_STATUS;
    use t27os::orchestrator::OC_ACT_COMMIT;
    use t27os::orchestrator::OC_ACT_MERGE;
    use t27os::orchestrator::oc_commit_ok;
    use t27os::agent_network::an_window_stays_blocked;
    use t27os::agent_network::DOMAIN_COUNT;
    use t27os::agent_network::AN_REPLACES_LETTER_CARDS;
    use t27os::agent_network::AN_MIGRATED;

    pub const PLAN_STEPS : u32 = 6;
    pub const STEP_ORCHESTRATOR : u32 = 1;
    pub const STEP_DASHBOARD : u32 = 2;
    pub const STEP_QUEUE : u32 = 3;
    pub const STEP_BLOCKERS : u32 = 4;
    pub const STEP_REPORTS : u32 = 5;
    pub const STEP_WINDOW_STAYS_BLOCKED : u32 = 6;

    fn plan_keeps_window_blocked() -> bool {
        return an_window_stays_blocked();
    }

    test "the plan has the six ordered steps" {
        assert(STEP_ORCHESTRATOR == 1);
        assert(STEP_DASHBOARD == 2);
        assert(STEP_QUEUE == 3);
        assert(STEP_BLOCKERS == 4);
        assert(STEP_REPORTS == 5);
        assert(STEP_WINDOW_STAYS_BLOCKED == 6);
        assert(PLAN_STEPS == 6);
    }

    test "the plan leaves the window shell blocked and status allowed" {
        assert(plan_keeps_window_blocked());
        assert(oc_allowed(OC_ACT_STATUS));
        assert(!oc_allowed(OC_ACT_WINDOW));
    }

    test "a lane commit is the default and a merge still needs the owner" {
        assert(oc_allowed(OC_ACT_COMMIT));
        assert(oc_commit_ok(true, true, false));
        assert(!oc_commit_ok(true, true, true));
        assert(!oc_allowed(OC_ACT_MERGE));
        assert(plan_keeps_window_blocked());
    }

    test "the network layer has 27 domains and moves no command body" {
        assert(DOMAIN_COUNT == 27);
        assert(AN_REPLACES_LETTER_CARDS == 0);
        assert(AN_MIGRATED == 0);
        assert(plan_keeps_window_blocked());
    }
}
