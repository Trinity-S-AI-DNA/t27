// specs/automation/github_projects_v2.t27 -- infra: GitHub Projects v2 board
// T27 Delivery - automation, views, discussion triage.
// Part of M6 milestone (milestone #10). Closes #13593 and #13582.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::github_projects_v2;

pub const GITHUB_PROJECTS_V2_ROWS : u32 = 71;

pub struct ProjectBoard { rows: u32, automated: bool };

pub fn project_board_rows(p: ProjectBoard) -> u32 {
    return p.rows;
}

pub fn project_board_automated(p: ProjectBoard) -> bool {
    return p.automated;
}

test "project_board_rows" {
    assert(project_board_rows(ProjectBoard { rows: 71, automated: true }) == 71);
}

test "project_board_automated" {
    assert(project_board_automated(ProjectBoard { rows: 71, automated: true }));
    assert(!project_board_automated(ProjectBoard { rows: 71, automated: false }));
}

invariant github_projects_v2_rows_defined {
    assert GITHUB_PROJECTS_V2_ROWS == 71;
}