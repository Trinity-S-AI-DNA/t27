// specs/automation/grok_crm_schema.t27 -- grok crm: schema and canonical ids.
// Part of M8 milestone (milestone #12). Closes #13456.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::grok_crm_schema;

pub const GROK_CRM_SCHEMA_MAX_IDS : u32 = 256;

pub struct CanonicalId { id: str, canonical: bool };

pub fn canonical_id_canonical(c: CanonicalId) -> bool {
    return c.canonical;
}

test "canonical_id_canonical" {
    assert(canonical_id_canonical(CanonicalId { id: "id-1", canonical: true }));
    assert(!canonical_id_canonical(CanonicalId { id: "id-2", canonical: false }));
}

invariant grok_crm_schema_max_ids_positive {
    assert GROK_CRM_SCHEMA_MAX_IDS > 0;
}