// SPDX-License-Identifier: Apache-2.0
// specs/automation/blog-share.t27 -- the blog desk: one t27.ai article a day becomes a
// question to the owner, and it is posted on their networks only after a yes.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/blog-share.ts (the
//       tick: the open question first, then at most one new question a day; the
//       receipt and the published-somewhere rule) beside src/agent/blog-share-wiring.ts
//       (the real feed, the owner's approvals, their browser: the publish-button
//       search), driven by the interval in render-server.ts.
// Laws carried from the incidents of 2026-10-02:
//       - twelve rows were closed as "declined" while their approval row was still
//         pending -- nobody pressed no. A decline is real only when the approval was
//         decided; an expiry is silence, and the desk says so to the owner.
//       - the only allowed article of the month reported "button not found" on X and
//         LinkedIn: one look at six seconds on a cold browser. The desk looks again
//         every three seconds, eight looks in all.
//       - a press is not a post: only the page leaving its share address is a receipt.
//       - a receipt is not a post either: a page can leave the form for an error page.
//         After the receipt the owner's own profile is opened in the same browser and
//         the post's opening words are looked for; only a post seen there counts as
//         published. Pressed and not seen is "unconfirmed", never "posted".
// v3 (2026-10-04): the owner's queue comes first. The owner ranked the articles in
//       their Blogger agent's skill ("the blog starts with its successes"), and the
//       desk still asked about the newest article nobody was asked about: the ranking
//       reached the agent and not the desk. The next question is now the first queued
//       article that the feed carries and nobody was asked about; the newest such only
//       when no queued one is left. The queue lives in that one skill and the host
//       reads it there, so it has one home. And a network the owner switched off --
//       Reddit closed r/t27ai on 2026-10-03 -- is neither named in the question nor
//       posted to.
// v4 (2026-10-06): a fresh article goes before the queue. The queue was written once,
//       its first items from August; from 2026-10-04 to 10-06 it sent three August
//       articles to X @t27_dev on three days while the articles of 10-04 waited behind
//       seven more old ones -- a queue of August articles kept the fresh ones out of
//       X for a week. An offerable article published within FRESH_MS (seven days) now
//       goes first, the newest such first; then the queue; then the newest remaining.
// v5 (2026-10-09): releases. Owner, 2026-10-09 (translated): "set it up so that
//       releases are published on X". Asked how, they chose: at once, but with
//       their yes. A release of gHashTag/t27 is news the day it lands. Its pipeline
//       had to finish first: for t27c that means the crate is on the registry, since
//       the swarm's release job (specs/jobs/release_t27c.t27) makes the GitHub
//       release before the crate exists. The daily pace exists so that
//       articles are not pushed on the owner; it does not hold a release back. A
//       finished, young release of ours is asked about at once and goes before every
//       article. Only the newest release of each tool is offered: turned on with
//       three t27c releases inside the window, the desk would otherwise ask about
//       0.5.2, then 0.5.1, then 0.5.0 -- the old-release complaint of v4 again.
//       The yes, the receipt and the profile check stay as they are.
// v6 (2026-11-10): social distribution moves to Cursor cloud. This spec stays
//       the only publisher. Autopost selects one new article per tick under
//       AUTO_PER_DAY, and one backlog article per unused UTC slot under
//       BACKLOG_PER_DAY (the owner's queue, then the newest). Selection is not
//       a send. SEND_NEEDS_TAP stays true, the schedule is not armed, a card is
//       used once, and this run sends nothing. Telegram is a target and has no
//       connector; a Telegram receipt is a positive message_id. A network that
//       already carries the article is skipped. Releases still need the yes.
//       Autopost off is the v5 desk. The clean X republish is a draft only.
// UI words (the owner reads Russian) stay in the host; the spec holds the rules.
// Claim status: the desk is live behind BLOG_SHARE_ENABLED=1 on the render service,
//       and its posts are confirmed: on 2026-10-03 08:36 UTC it found its post of
//       one-regional-clock-twelve-pull-requests on the owner's X, LinkedIn and Reddit
//       profiles (blog_shares row, state "posted"); Facebook went by its API, Threads
//       was not signed in. The order of v4 is not yet measured on a live tick.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::blog_share {

    pub const KIND : str = "automation";
    pub const ID : str = "blog-share";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 6;

    // ---- Cursor cloud (v6). The legacy repo below is history, not the sender. ----
    pub const HOST : str = "cursor-cloud";
    pub const LEGACY_HOST : str = "999-multibots-telegraf";
    pub const DISTRIBUTION_MOVED : bool = true;
    pub const SEND_NEEDS_TAP : bool = true;  // the owner's tap is the only send
    pub const SENT_THIS_RUN : bool = false;  // this change transmits nothing
    pub const PUBLISHED : bool = false;
    pub const SCHEDULE_ARMED : bool = false; // slots are a rule; no timer is armed
    pub const AUTOPOST_DEFAULT : bool = false;
    pub const AUTO_PER_DAY : u8 = 1;
    pub const BACKLOG_PER_DAY : u8 = 1;
    pub const SLOT_A_UTC : u8 = 8;
    pub const SLOT_B_UTC : u8 = 14;
    pub const SLOT_C_UTC : u8 = 20;
    pub const CARD_SINGLE_USE : bool = true;
    pub const LINKS_RECORDED : u8 = 0;  // the owner has not connected a network here
    pub const X_REPUBLISH_DRAFT_ONLY : bool = true;
    pub const X_REPUBLISH_SLUG : str = "the-seed-moved-it-the-pins-moved-it-more";
    // Targets. Reddit stays in the list so a missing publisher is visible; v3
    // switched it off and reddit-desk does not publish the blog.
    pub const NET_X : u8 = 1;
    pub const NET_TELEGRAM : u8 = 2;
    pub const NET_THREADS : u8 = 3;
    pub const NET_FACEBOOK : u8 = 4;
    pub const NET_INSTAGRAM : u8 = 5;
    pub const NET_LINKEDIN : u8 = 6;
    pub const NET_REDDIT : u8 = 7;

    // ---- The pace -------------------------------------------------------------------
    pub const TICK_MS : u32 = 300000;  // render-server.ts: every five minutes; a
                                       // thirty-minute timer restarted by each deploy
                                       // often never fired at all
    pub const ASK_EVERY_MS : u32 = 72000000;  // 20 h: one question a day at most, a
                                              // little under 24 h so the hour drifts
                                              // earlier, never later
    pub const ANSWER_WAIT_MS : u32 = 86400000;  // 24 h: the approval's own lifetime; a
                                                // question nobody answered is let go
    pub const ASK_NEEDS_YES : bool = true;  // posting on someone's public accounts is
                                            // outward and cannot be taken back

    // ---- The publish button ---------------------------------------------------------
    pub const FIRST_SETTLE_MS : u16 = 6000;  // the share page draws before the first look
    pub const LOOK_EVERY_MS : u16 = 3000;  // a cold browser draws the composer late
    pub const LOOKS : u8 = 8;  // first look included: about half a minute in all
    pub const AFTER_CLICK_SETTLE_MS : u16 = 5000;  // then the address is read again

    // ---- The confirmation on the owner's own profile -------------------------------
    pub const PROFILE_SETTLE_MS : u16 = 5000;  // the profile draws before the first look
    pub const PROFILE_LOOK_EVERY_MS : u16 = 4000;  // a fresh post reaches the feed late
    pub const PROFILE_LOOKS : u8 = 4;  // first look included: under twenty seconds
    pub const MATCH_CHARS : u8 = 60;  // the post's opening words, normalized, are the
                                      // needle; every post starts with the title

    // ---- The order of the next question ---------------------------------------------
    pub const FRESH_MS : u32 = 604800000;  // 7 days: an article this young goes before
                                           // the owner's queue

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false; // the cursor-cloud host has not sent
    pub const LEGACY_PROFILE_SEEN : bool = true; // 2026-10-03, the old render host

    // An open question is still waited on while it is pending and younger than the
    // approval's lifetime.
    fn still_waiting(answer: str, age_ms: u32) -> bool {
        return answer == "pending" && age_ms < ANSWER_WAIT_MS;
    }

    // A new question is due when none was ever asked, or the last one is a pace old.
    fn may_ask(ever_asked: bool, since_last_ms: u32) -> bool {
        return !ever_asked || since_last_ms >= ASK_EVERY_MS;
    }

    // Only "allowed" posts. Everything else closes the question unposted.
    fn posts(answer: str) -> bool {
        return answer == "allowed";
    }

    // A decline is real only when a person decided it: "denied". An expiry -- or a
    // row still pending -- is silence, and the owner is told it went unanswered.
    fn decline_is_real(answer: str) -> bool {
        return answer == "denied";
    }

    // The receipt: both addresses read, and the page left the share form.
    fn left_the_form(before: str, after: str) -> bool {
        return before != "" && after != "" && before != after;
    }

    // A network counts as published only when the page left the form AND the post
    // was then seen on the owner's own profile.
    fn counted(left: bool, seen: bool) -> bool {
        return left && seen;
    }

    // Pressed, but not seen on the profile: unconfirmed, which is not published.
    fn unconfirmed(pressed: bool, seen: bool) -> bool {
        return pressed && !seen;
    }

    // Published somewhere: no run-wide error, and at least one network whose post
    // was seen on the owner's profile.
    fn published_somewhere(has_error: bool, seen: u8) -> bool {
        return !has_error && seen > 0;
    }

    // An article may be offered when the feed carries it and nobody was asked about it.
    fn offerable(in_feed: bool, asked_before: bool) -> bool {
        return in_feed && !asked_before;
    }

    // The owner's queue comes first: the newest offerable article goes next only when
    // no queued article is offerable any more.
    fn newest_goes_next(queued_offerable: u8) -> bool {
        return queued_offerable == 0;
    }

    // An article is fresh while its age is at most FRESH_MS, the edge included.
    fn is_fresh(age_ms: u32) -> bool {
        return age_ms <= FRESH_MS;
    }

    // Where the next question comes from: a fresh offerable article first, then the
    // owner's queue, then the newest offerable remaining; "none" when nothing is left.
    fn next_source(fresh_offerable: u8, queued_offerable: u8, offerable_left: u8) -> str {
        if fresh_offerable > 0 {
            return "fresh";
        }
        if queued_offerable > 0 {
            return "queue";
        }
        if offerable_left > 0 {
            return "newest";
        }
        return "none";
    }

    // A network the owner switched off is neither named in the question nor posted to.
    fn network_used(switched_off: bool) -> bool {
        return !switched_off;
    }

    // The last moment the profile is looked at, from its opening.
    fn last_profile_look_ms() -> u32 {
        return PROFILE_SETTLE_MS + (PROFILE_LOOKS - 1) * PROFILE_LOOK_EVERY_MS;
    }

    // The last moment the publish button is looked for, from the page's opening.
    fn last_look_ms() -> u32 {
        return FIRST_SETTLE_MS + (LOOKS - 1) * LOOK_EVERY_MS;
    }

    // ---- Releases (v5) ----------------------------------------------------------------
    pub const RELEASE_REPO : str = "gHashTag/t27";
    pub const RELEASE_FRESH_MS : u32 = 259200000;  // 3 days: an older release is history,
                                                   // and turning this on must not post
                                                   // every release ever made
    pub const RELEASE_SKIPS_PACE : bool = true;    // asked at once, not after ASK_EVERY_MS
    // A release is offered when:
    // - its tag is one of ours (`our_tag`, read by the host: t27c-v* or t27b-v*);
    // - it is neither a draft nor a pre-release;
    // - its pipeline finished;
    // - it is young;
    // - nobody was asked about it;
    // - and it is the newest published release of its tool (`newest_of_tool`): a
    //   newer one, finished or not, makes it history.
    fn release_offerable(our_tag: bool, draft: bool, prerelease: bool, pipeline_done: bool, age_ms: u32, asked_before: bool, newest_of_tool: bool) -> bool {
        return our_tag && !draft && !prerelease && pipeline_done && age_ms <= RELEASE_FRESH_MS && !asked_before && newest_of_tool;
    }
    // The pace holds articles back, not releases: a release is asked about whenever no
    // other question is open. One open question at a time still holds.
    fn may_ask_release(question_open: bool) -> bool {
        return RELEASE_SKIPS_PACE && !question_open;
    }
    // A release goes before every article: fresh, queued or newest.
    fn release_first(releases_offerable: u8) -> bool {
        return releases_offerable > 0;
    }

    // ---- v6: select, then wait for the tap. Nothing here transmits. ----------------
    fn active_host() -> str {
        if DISTRIBUTION_MOVED {
            return HOST;
        }
        return LEGACY_HOST;
    }

    // Autopost off is the v5 desk. Autopost on is v6 selection, still behind the tap.
    fn ruleset(autopost: bool) -> u8 {
        if autopost {
            return 6;
        }
        return 5;
    }

    // A send exists only when the gate constant is on and the owner tapped Allow.
    fn transmits(answer: str, tap: bool) -> bool {
        if !SEND_NEEDS_TAP {
            return false;
        }
        if !tap {
            return false;
        }
        return posts(answer);
    }

    // A release keeps the yes: the same tap, never an autopost bypass.
    fn release_transmits(answer: str, tap: bool) -> bool {
        return transmits(answer, tap);
    }

    // One card, one use. A second tap on the same card posts nothing.
    fn card_honoured(used_before: bool, answer: str, tap: bool) -> bool {
        if !CARD_SINGLE_USE {
            return false;
        }
        if used_before {
            return false;
        }
        return transmits(answer, tap);
    }

    // New means first seen strictly after the cutoff. The cutoff instant is backlog.
    fn article_is_new(first_seen_ms: u32, cutoff_ms: u32) -> bool {
        return first_seen_ms > cutoff_ms;
    }

    fn article_is_backlog(first_seen_ms: u32, cutoff_ms: u32) -> bool {
        return first_seen_ms <= cutoff_ms;
    }

    // The cutoff is written on the first autopost tick and kept after that.
    fn recorded_cutoff(had: bool, stored: u32, tick_ms: u32) -> u32 {
        if had {
            return stored;
        }
        return tick_ms;
    }

    // One new article per tick, and only while today's count is under the cap.
    fn auto_selected(autopost: bool, is_new: bool, auto_today: u8, taken_this_tick: bool) -> bool {
        if !autopost {
            return false;
        }
        if !is_new {
            return false;
        }
        if auto_today >= AUTO_PER_DAY {
            return false;
        }
        if taken_this_tick {
            return false;
        }
        return true;
    }

    // Selecting a new article does not send it.
    fn auto_fires(selected: bool, answer: str, tap: bool) -> bool {
        if !selected {
            return false;
        }
        return transmits(answer, tap);
    }

    fn on_slot(hour: u8) -> bool {
        if hour == SLOT_A_UTC {
            return true;
        }
        if hour == SLOT_B_UTC {
            return true;
        }
        if hour == SLOT_C_UTC {
            return true;
        }
        return false;
    }

    // A slot is one UTC hour: minute 0 is the start, minute 59 the end.
    fn backlog_due(autopost: bool, backlog: bool, backlog_today: u8, hour: u8, minute: u8, slot_used: bool) -> bool {
        if !autopost {
            return false;
        }
        if !backlog {
            return false;
        }
        if backlog_today >= BACKLOG_PER_DAY {
            return false;
        }
        if !on_slot(hour) {
            return false;
        }
        if minute > 59 {
            return false;
        }
        if slot_used {
            return false;
        }
        return true;
    }

    // The schedule rule can be due and still not fire: this move arms no timer.
    fn backlog_fires(due: bool, answer: str, tap: bool) -> bool {
        if !SCHEDULE_ARMED {
            return false;
        }
        if !due {
            return false;
        }
        return transmits(answer, tap);
    }

    // Backlog order: the owner's queue, then the newest. No third source.
    fn backlog_pick(queued: u8, newest: u8) -> str {
        if queued > 0 {
            return "queue";
        }
        if newest > 0 {
            return "newest";
        }
        return "none";
    }

    fn skip_carried(already: bool) -> bool {
        return already;
    }

    // The publish connector, or "none" when this repo has no publisher for it.
    fn connector_of(net: u8) -> str {
        if net == NET_X {
            return "social-api";
        }
        if net == NET_LINKEDIN {
            return "social-api";
        }
        if net == NET_THREADS {
            return "meta-connect";
        }
        if net == NET_FACEBOOK {
            return "meta-connect";
        }
        if net == NET_INSTAGRAM {
            return "meta-connect";
        }
        return "none";
    }

    fn missing_connector(net: u8) -> bool {
        return connector_of(net) == "none";
    }

    // Telegram counts only when the network returns a positive message id.
    fn telegram_receipt(message_id: u32) -> bool {
        return message_id > 0;
    }

    fn network_ready(net: u8, owner_connected: bool, switched_off: bool, already: bool, answer: str, tap: bool) -> bool {
        if missing_connector(net) {
            return false;
        }
        if !owner_connected {
            return false;
        }
        if !network_used(switched_off) {
            return false;
        }
        if skip_carried(already) {
            return false;
        }
        return transmits(answer, tap);
    }

    fn x_text_exact(chars_same: bool, breaks_same: bool) -> bool {
        return chars_same && breaks_same;
    }

    // Draft only: exact text is recorded, and the send stays closed.
    fn x_republish_sends(chars_same: bool, breaks_same: bool, tap: bool) -> bool {
        if X_REPUBLISH_DRAFT_ONLY {
            return false;
        }
        if !x_text_exact(chars_same, breaks_same) {
            return false;
        }
        return transmits("allowed", tap);
    }

    test "an open question is waited on for the approval's lifetime, then let go" {
        assert(still_waiting("pending", 0));
        assert(still_waiting("pending", 86399999));
        assert(!still_waiting("pending", 86400000));
        assert(!still_waiting("allowed", 0));
        assert(!still_waiting("expired", 0));
        assert(ANSWER_WAIT_MS == 86400000);
    }

    test "one question a day at most, on a five-minute tick" {
        assert(may_ask(false, 0));
        assert(!may_ask(true, 71999999));
        assert(may_ask(true, 72000000));
        assert(ASK_EVERY_MS < ANSWER_WAIT_MS + TICK_MS);
        assert(TICK_MS == 300000);
        assert(TICK_MS < ASK_EVERY_MS);
    }

    test "nothing is posted without a yes" {
        assert(posts("allowed"));
        assert(!posts("denied"));
        assert(!posts("expired"));
        assert(!posts("pending"));
        assert(ASK_NEEDS_YES);
    }

    test "a decline is real only if the approval was decided" {
        assert(decline_is_real("denied"));
        assert(!decline_is_real("expired"));
        assert(!decline_is_real("pending"));
        assert(!decline_is_real("allowed"));
    }

    test "the page leaving the form is the receipt" {
        assert(left_the_form("https://x.com/intent/post", "https://x.com/home"));
        assert(!left_the_form("https://x.com/intent/post", "https://x.com/intent/post"));
        assert(!left_the_form("", "https://x.com/home"));
        assert(!left_the_form("https://x.com/intent/post", ""));
    }

    test "a post counts only when the profile shows it" {
        assert(counted(true, true));
        assert(!counted(true, false));
        assert(!counted(false, true));
        assert(unconfirmed(true, false));
        assert(!unconfirmed(true, true));
        assert(!unconfirmed(false, false));
    }

    test "the profile is looked at under twenty seconds" {
        assert(PROFILE_SETTLE_MS == 5000);
        assert(PROFILE_LOOK_EVERY_MS == 4000);
        assert(PROFILE_LOOKS == 4);
        assert(last_profile_look_ms() == 17000);
        assert(last_profile_look_ms() < 20000);
        assert(MATCH_CHARS == 60);
    }

    test "published somewhere means a post seen on the profile, and no error" {
        assert(published_somewhere(false, 1));
        assert(published_somewhere(false, 4));
        assert(!published_somewhere(false, 0));
        assert(!published_somewhere(true, 1));
    }

    test "the publish button is looked for about half a minute" {
        assert(FIRST_SETTLE_MS == 6000);
        assert(LOOK_EVERY_MS == 3000);
        assert(LOOKS == 8);
        assert(AFTER_CLICK_SETTLE_MS == 5000);
        assert(last_look_ms() == 27000);
        assert(LOOKS > 1);
    }

    test "the owner's queue comes first, the newest only after it" {
        assert(offerable(true, false));
        assert(!offerable(true, true));
        assert(!offerable(false, false));
        assert(!newest_goes_next(1));
        assert(newest_goes_next(0));
    }

    test "a fresh article goes first, then the owner's queue, then the newest" {
        assert(FRESH_MS == 604800000);
        assert(is_fresh(0));
        assert(is_fresh(604800000));
        assert(!is_fresh(604800001));
        assert(next_source(1, 3, 9) == "fresh");
        assert(next_source(1, 0, 1) == "fresh");
        assert(next_source(0, 2, 9) == "queue");
        assert(next_source(0, 0, 4) == "newest");
        assert(next_source(0, 0, 0) == "none");
    }

    test "a network switched off is neither asked about nor posted to" {
        assert(network_used(false));
        assert(!network_used(true));
    }

    test "a finished release of ours is asked about at once, and still needs a yes" {
        assert(release_offerable(true, false, false, true, 0, false, true));
        assert(release_offerable(true, false, false, true, 259200000, false, true));
        assert(!release_offerable(true, false, false, true, 259200001, false, true));
        assert(!release_offerable(false, false, false, true, 0, false, true));
        assert(!release_offerable(true, true, false, true, 0, false, true));
        assert(!release_offerable(true, false, true, true, 0, false, true));
        assert(!release_offerable(true, false, false, false, 0, false, true));
        assert(!release_offerable(true, false, false, true, 0, true, true));
        assert(!release_offerable(true, false, false, true, 0, false, false));
        assert(may_ask_release(false));
        assert(!may_ask_release(true));
        assert(release_first(1));
        assert(!release_first(0));
        assert(RELEASE_FRESH_MS < ASK_EVERY_MS * 4);
        assert(ASK_NEEDS_YES);
        assert(!posts("pending"));
    }

    test "the legacy profile check stands, and the cursor host has not sent" {
        assert(!RUN_LIVE);
        assert(LEGACY_PROFILE_SEEN);
        assert(VERSION == 6);
        assert(!SENT_THIS_RUN);
        assert(!PUBLISHED);
    }

    test "distribution runs in cursor cloud and still needs the owner's tap" {
        assert(active_host() == "cursor-cloud");
        assert(DISTRIBUTION_MOVED);
        assert(LEGACY_HOST == "999-multibots-telegraf");
        assert(SEND_NEEDS_TAP);
        assert(transmits("allowed", true));
        assert(!transmits("allowed", false));
        assert(!transmits("pending", true));
        assert(!transmits("denied", true));
        assert(!release_transmits("allowed", false));
        assert(release_transmits("allowed", true));
        assert(ruleset(false) == 5);
        assert(ruleset(true) == 6);
        assert(!AUTOPOST_DEFAULT);
    }

    test "a card is used once" {
        assert(CARD_SINGLE_USE);
        assert(card_honoured(false, "allowed", true));
        assert(!card_honoured(true, "allowed", true));
        assert(!card_honoured(false, "allowed", false));
        assert(LINKS_RECORDED == 0);
    }

    test "a new article is after the cutoff, and the cutoff instant is backlog" {
        assert(!article_is_new(1000, 1000));
        assert(article_is_backlog(1000, 1000));
        assert(article_is_new(1001, 1000));
        assert(!article_is_backlog(1001, 1000));
        assert(article_is_backlog(999, 1000));
        assert(recorded_cutoff(false, 1, 50) == 50);
        assert(recorded_cutoff(true, 1, 50) == 1);
    }

    test "autopost takes one new article per tick under the day cap" {
        assert(AUTO_PER_DAY == 1);
        assert(auto_selected(true, true, 0, false));
        assert(!auto_selected(true, true, 1, false));
        assert(!auto_selected(true, true, 2, false));
        assert(!auto_selected(true, true, 0, true));
        assert(!auto_selected(false, true, 0, false));
        assert(!auto_selected(true, false, 0, false));
        assert(!auto_fires(true, "allowed", false));
        assert(!auto_fires(true, "pending", true));
        assert(auto_fires(true, "allowed", true));
        assert(!auto_fires(false, "allowed", true));
    }

    test "a backlog slot has a start, an end and a used bit, and is not armed" {
        assert(BACKLOG_PER_DAY == 1);
        assert(SLOT_A_UTC == 8);
        assert(SLOT_B_UTC == 14);
        assert(SLOT_C_UTC == 20);
        assert(backlog_due(true, true, 0, 8, 0, false));
        assert(backlog_due(true, true, 0, 8, 59, false));
        assert(!backlog_due(true, true, 0, 8, 60, false));
        assert(!backlog_due(true, true, 0, 9, 0, false));
        assert(!backlog_due(true, true, 0, 8, 0, true));
        assert(!backlog_due(true, true, 1, 8, 0, false));
        assert(!backlog_due(true, true, 2, 14, 0, false));
        assert(backlog_due(true, true, 0, 14, 0, false));
        assert(backlog_due(true, true, 0, 20, 30, false));
        assert(!backlog_due(false, true, 0, 8, 0, false));
        assert(!SCHEDULE_ARMED);
        assert(!backlog_fires(true, "allowed", true));
        assert(backlog_pick(2, 5) == "queue");
        assert(backlog_pick(0, 5) == "newest");
        assert(backlog_pick(0, 0) == "none");
    }

    test "telegram has no connector, and a receipt is a positive message id" {
        assert(connector_of(NET_X) == "social-api");
        assert(connector_of(NET_LINKEDIN) == "social-api");
        assert(connector_of(NET_THREADS) == "meta-connect");
        assert(connector_of(NET_FACEBOOK) == "meta-connect");
        assert(connector_of(NET_INSTAGRAM) == "meta-connect");
        assert(missing_connector(NET_TELEGRAM));
        assert(missing_connector(NET_REDDIT));
        assert(connector_of(NET_TELEGRAM) == "none");
        assert(!missing_connector(NET_X));
        assert(telegram_receipt(1));
        assert(!telegram_receipt(0));
        assert(skip_carried(true));
        assert(!skip_carried(false));
        assert(!network_ready(NET_TELEGRAM, true, false, false, "allowed", true));
        assert(!network_ready(NET_X, false, false, false, "allowed", true));
        assert(!network_ready(NET_X, true, true, false, "allowed", true));
        assert(!network_ready(NET_X, true, false, true, "allowed", true));
        assert(!network_ready(NET_X, true, false, false, "allowed", false));
        assert(network_ready(NET_X, true, false, false, "allowed", true));
    }

    test "the clean X republish is a draft and does not send" {
        assert(X_REPUBLISH_DRAFT_ONLY);
        assert(X_REPUBLISH_SLUG == "the-seed-moved-it-the-pins-moved-it-more");
        assert(x_text_exact(true, true));
        assert(!x_text_exact(true, false));
        assert(!x_text_exact(false, true));
        assert(!x_republish_sends(true, true, true));
        assert(!x_republish_sends(false, true, true));
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
