// SPDX-License-Identifier: Apache-2.0
// specs/automation/bee-report.t27 -- an hourly report of work done and of blockers,
// written to the owner's chat; delegated work goes through the hive because it is
// cheaper. The report's RULES are decided here (gHashTag/t27#8960); the host --
// gHashTag/999-multibots-telegraf src/inngest_app/functions/hive/beeReport.ts, an
// Inngest cron vendored per the t27-spec-first recipe -- only gathers facts and sends.
//
// FR-001 REPORT_CRON is hourly and off the :00 mark, so the report never fights
//        the top-of-hour crons for the queue and "7 past" reads as intentional.
// FR-002 should_send: send when something changed; when nothing changed, stay
//        quiet except a heartbeat every HEARTBEAT_EVERY_HOURS. Silence is cheaper
//        than an empty report, but a dead cron must still be visible.
// FR-003 is_blocker_stale: a claimed issue or an open PR with no activity for
//        BLOCKER_STALE_HOURS is a blocker.
// FR-004 queen_silent: no dispatch in QUEEN_SILENT_MIN is a blocker of its own.
//        See skill why-the-bees-are-silent: the silence is read from the
//        dispatch / worker-turn / reviewed lines of the log, NOT from chosen=null
//        (a null choice is a normal idle tick, not a death).
// FR-005 failing_ci_is_blocker: a failed check is a blocker at once; a queued one
//        becomes one after CI_QUEUED_BLOCKER_MIN.
// FR-006 MESSAGE_MAX_CHARS = 4000 (Telegram's 4096 minus margin) and parts_needed
//        to split a long report into Telegram-sized messages.
// FR-007 SECTION_ORDER: done since last report, in progress, blockers, waiting for
//        a person. The chat is the owner's, not the clients': no client names,
//        no secrets, ever.
// FR-008 every fn below has a test block with edge values and at least one
//        negative control per threshold.
// v1, 2026-10-11: first cut.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::bee_report {

    pub const KIND : str = "automation";
    pub const ID : str = "bee-report";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- FR-001: when the report fires -----------------------------------------------
    pub const REPORT_CRON : str = "7 * * * *";  // hourly, 7 past the hour

    // ---- FR-002: send, or stay quiet -------------------------------------------------
    pub const HEARTBEAT_EVERY_HOURS : u32 = 6;

    // ---- FR-003: stale work is a blocker ---------------------------------------------
    pub const BLOCKER_STALE_HOURS : u32 = 6;

    // ---- FR-004: a silent queen is a blocker of its own ------------------------------
    pub const QUEEN_SILENT_MIN : u32 = 90;

    // ---- FR-005: CI becomes a blocker ------------------------------------------------
    pub const CI_QUEUED_BLOCKER_MIN : u32 = 60;

    // ---- FR-006: message splitting ---------------------------------------------------
    pub const MESSAGE_MAX_CHARS : u32 = 4000;  // Telegram's 4096 minus margin

    // ---- FR-007: sections and redactions ---------------------------------------------
    pub const SECTION_ORDER : [4]str = ["done since last report", "in progress", "blockers", "waiting for a person"];
    pub const CLIENT_NAMES_IN_REPORT : bool = false;
    pub const SECRETS_IN_REPORT : bool = false;

    // FR-002: the only reason to stay quiet is an unchanged hive below the heartbeat
    // age. Any change sends at once; a still hive speaks once every HEARTBEAT_EVERY_HOURS.
    pub fn should_send(changed: bool, hours_since_last_sent: u32) -> bool {
        return changed || (hours_since_last_sent >= HEARTBEAT_EVERY_HOURS);
    }

    // FR-003: a claimed issue or an open PR whose last activity is this old is a blocker.
    pub fn is_blocker_stale(hours_since_activity: u32) -> bool {
        return hours_since_activity >= BLOCKER_STALE_HOURS;
    }

    // FR-004: no dispatch from the Queen inside this window is a blocker of its own.
    pub fn queen_silent(minutes_since_dispatch: u32) -> bool {
        return minutes_since_dispatch >= QUEEN_SILENT_MIN;
    }

    // FR-005: a failed conclusion is a blocker at once; a queued check becomes one
    // after it has waited CI_QUEUED_BLOCKER_MIN.
    pub fn failing_ci_is_blocker(conclusion_failed: bool, waited_minutes: u32) -> bool {
        return conclusion_failed || (waited_minutes >= CI_QUEUED_BLOCKER_MIN);
    }

    // FR-006: how many Telegram messages a report of this many characters needs.
    // Ceiling division by MESSAGE_MAX_CHARS; an empty report (0 chars) is never sent
    // (FR-002), so it needs zero parts.
    pub fn parts_needed(chars: u32) -> u32 {
        if chars == 0 {
            return 0;
        }
        let whole : u32 = chars / MESSAGE_MAX_CHARS;
        let rest : u32 = chars % MESSAGE_MAX_CHARS;
        if rest == 0 {
            return whole;
        }
        return whole + 1;
    }

    // ---- FR-008: tests ---------------------------------------------------------------

    // Edge values for should_send, with a negative control at the heartbeat threshold:
    // 5 hours is below HEARTBEAT_EVERY_HOURS (6) and must stay quiet.
    test should_send_sends_on_change_or_heartbeat {
        // work changed: send now, whatever the gap -- zero, below the heartbeat, huge.
        assert(should_send(true, 0) == true);
        assert(should_send(true, 5) == true);
        assert(should_send(true, 1000000) == true);
        // nothing changed, below the heartbeat age: quiet (negative control, 5 < 6).
        assert(should_send(false, 0) == false);
        assert(should_send(false, 5) == false);
        // nothing changed, at and above the heartbeat age: the heartbeat goes out.
        assert(should_send(false, 6) == true);
        assert(should_send(false, 7) == true);
        assert(should_send(false, 1000000) == true);
    }

    // Edge values for is_blocker_stale, with a negative control at the threshold:
    // 5 hours of silence is below BLOCKER_STALE_HOURS (6) and is not a blocker.
    test is_blocker_stale_at_and_below_threshold {
        // fresh work: not a blocker (negative control, 5 < 6).
        assert(is_blocker_stale(0) == false);
        assert(is_blocker_stale(5) == false);
        // at BLOCKER_STALE_HOURS the claimed issue or open PR turns into a blocker.
        assert(is_blocker_stale(6) == true);
        assert(is_blocker_stale(7) == true);
        assert(is_blocker_stale(1000000) == true);
    }

    // Edge values for queen_silent, with a negative control at the threshold:
    // 89 minutes is below QUEEN_SILENT_MIN (90) and is not a blocker.
    test queen_silent_at_and_below_threshold {
        // a dispatch this minute and 89 minutes ago: still alive (negative control, 89 < 90).
        assert(queen_silent(0) == false);
        assert(queen_silent(89) == false);
        // at and past QUEEN_SILENT_MIN the queen's silence is a blocker of its own.
        assert(queen_silent(90) == true);
        assert(queen_silent(91) == true);
        assert(queen_silent(1000000) == true);
    }

    // Edge values for failing_ci_is_blocker, with negative controls at the queued
    // threshold: 0 and 59 minutes are below CI_QUEUED_BLOCKER_MIN (60).
    test failing_ci_is_blocker_failed_now_queued_after_threshold {
        // a failed check is a blocker at once, whatever the wait.
        assert(failing_ci_is_blocker(true, 0) == true);
        assert(failing_ci_is_blocker(true, 59) == true);
        assert(failing_ci_is_blocker(true, 1000000) == true);
        // a queued check below CI_QUEUED_BLOCKER_MIN is not a blocker yet (negative controls).
        assert(failing_ci_is_blocker(false, 0) == false);
        assert(failing_ci_is_blocker(false, 59) == false);
        // a queued check at and past CI_QUEUED_BLOCKER_MIN is one.
        assert(failing_ci_is_blocker(false, 60) == true);
        assert(failing_ci_is_blocker(false, 61) == true);
        assert(failing_ci_is_blocker(false, 1000000) == true);
    }

    // Edge values for parts_needed, with a negative control at the split threshold:
    // exactly MESSAGE_MAX_CHARS (4000) is one part, not two.
    test parts_needed_splits_at_message_max {
        // an empty report is never sent (FR-002), so zero characters need zero parts.
        assert(parts_needed(0) == 0);
        // one part up to and including the limit (negative control: 4000 != 2 parts).
        assert(parts_needed(1) == 1);
        assert(parts_needed(3999) == 1);
        assert(parts_needed(4000) == 1);
        assert(parts_needed(4000) != 2);
        // every whole extra message adds one part.
        assert(parts_needed(4001) == 2);
        assert(parts_needed(8000) == 2);
        assert(parts_needed(8001) == 3);
        assert(parts_needed(12000) == 3);
        assert(parts_needed(12001) == 4);
        // exact multiples and the top of the u32 range.
        assert(parts_needed(1000000) == 250);
        assert(parts_needed(4294967295) == 1073742);
    }

    // FR-001: the cron fires hourly, 7 past the hour -- never on the :00 mark.
    test report_cron_is_hourly_off_the_hour {
        // "7 * * * *" is 9 characters: minute, hour, dom, mon, dow.
        assert(REPORT_CRON.len == 9);
        // the minute field is 7, off the :00 mark.
        assert(REPORT_CRON[0] == '7');
        assert(REPORT_CRON[1] == ' ');
        // the hour field is *, i.e. every hour.
        assert(REPORT_CRON[3] == ' ');
        assert(REPORT_CRON[4] == '*');
        // dom, mon and dow are *, i.e. every day.
        assert(REPORT_CRON[6] == '*');
        assert(REPORT_CRON[8] == '*');
    }

    // FR-007: the four sections, in the order the owner reads them, and the
    // redactions that never turn off.
    test section_order_and_redactions {
        assert(SECTION_ORDER.len == 4);
        assert(SECTION_ORDER[0] == "done since last report");
        assert(SECTION_ORDER[1] == "in progress");
        assert(SECTION_ORDER[2] == "blockers");
        assert(SECTION_ORDER[3] == "waiting for a person");
        // the chat is the owner's, not the clients': no names, no secrets, ever.
        assert(CLIENT_NAMES_IN_REPORT == false);
        assert(SECRETS_IN_REPORT == false);
    }

    // One hour of hive life, read through the rules together: the work changed so
    // the report goes out even below the heartbeat age; a claim has just crossed
    // the stale line; the queen dispatched 89 minutes ago so she is not the
    // blocker; a queued check has just crossed its line; the report is one
    // character over one message, so it splits in two.
    test an_hour_of_hive_life_reads_through_the_rules {
        assert(should_send(true, 1) == true);
        assert(is_blocker_stale(6) == true);
        assert(queen_silent(89) == false);
        assert(failing_ci_is_blocker(false, 60) == true);
        assert(parts_needed(4001) == 2);
        assert(SECTION_ORDER.len == 4);
    }
}
