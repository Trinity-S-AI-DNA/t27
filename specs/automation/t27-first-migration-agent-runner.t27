// SPDX-License-Identifier: Apache-2.0
// specs/automation/t27-first-migration-agent-runner.t27
// T27-First Migration Task: Agent Runner Workflow
// Phase: CRITICAL_MIGRATION (after CI baseline gate)
// Status: DEFINED_NOT_STARTED

module automation::t27_first_migration_agent_runner {
    use base::types;
    
    // Migration task definition
    struct MigrationTask {
        id: str,
        name: str,
        description: str,
        status: str,
        priority: str,
        target_file: str,
        business_logic_categories: [str],
        estimated_effort: u32,
        acceptance_criteria: [str],
        migration_path: str,
        keep_in_python: [str],
        move_to_t27: [str],
    }
    
    // Agent runner migration task
    const AGENT_RUNNER_MIGRATION: MigrationTask = MigrationTask {
        id = "t27-first-migration-001",
        name = "Agent Runner Workflow Migration",
        description = "Move agent workflow/policy semantics from Python to .t27 specifications",
        status = "DEFINED_NOT_STARTED",
        priority = "high",
        target_file = "contrib/backend/agent-runner/agent-runner.py",
        business_logic_categories = ["agent_workflow", "task_management", "tool_execution"],
        estimated_effort = 40,  // Hours
        acceptance_criteria = [
            "Behavior unchanged",
            "Existing tests pass", 
            "New .t27 specs compile",
            "Agent runner contains no new workflow policy",
            "T27-first audit violation count decreases",
            "Adapter pattern preserved"
        ],
        migration_path = "specs/automation/agent-workflow.t27",
        keep_in_python = [
            "process execution",
            "filesystem adapters", 
            "provider client adapters",
            "CLI bindings",
            "logging/reporting"
        ],
        move_to_t27 = [
            "task selection",
            "workflow sequencing", 
            "retry policy",
            "approval policy",
            "completion conditions",
            "failure classification"
        ],
    };
    
    // Migration phases
    enum MigrationPhase {
        PREPARE,
        ANALYZE,
        DESIGN,
        IMPLEMENT,
        VALIDATE,
        DEPLOY,
    }
    
    // Migration status tracking
    struct MigrationStatus {
        task: MigrationTask,
        current_phase: MigrationPhase,
        progress: u32,  // 0-100
            issues: [str],
            completed_steps: [str],
            next_steps: [str],
            milestone_date: str,
    }
    
    // Current migration status
    const CURRENT_MIGRATION: MigrationStatus = MigrationStatus {
        task = AGENT_RUNNER_MIGRATION,
        current_phase = MigrationPhase.PREPARE,
        progress = 10,
        issues = [],
        completed_steps = [
            "Task definition complete",
            "Business logic categories identified",
            "Keep/move boundaries defined",
            "Acceptance criteria established"
        ],
        next_steps = [
            "Analyze current agent-runner.py workflow logic",
            "Design .t27 specification structure",
            "Extract workflow semantics to t27 specs",
            "Retain execution adapters in Python"
        ],
        milestone_date = "2026-11-15",
    };
    
    // Migration validation criteria
    struct ValidationCriteria {
        completeness: bool,
        correctness: bool, 
        performance: bool,
        compatibility: bool,
        invariant_compliance: bool,
    }
    
    // Acceptance test specification
    struct AcceptanceTest {
        name: str,
        description: str,
        input: str,
        expected_output: str,
        validation: str,
    }
    
    // Agent runner acceptance tests
    const ACCEPTANCE_TESTS: [AcceptanceTest] = [
        AcceptanceTest {
            name = "Task Selection Policy",
            description = "Verify task selection logic moved to .t27",
            input = "task_request: Query, context: AgentContext",
            expected_output = "selected_task: Task, priority: Priority",
            validation = "task selection logic implemented in .t27 specs"
        },
        AcceptanceTest {
            name = "Workflow Sequencing", 
            description = "Verify workflow sequencing controlled by .t27",
            input = "task: Task, dependencies: [Task]",
            expected_output = "execution_plan: [Step]",
            validation = "workflow sequencing in .t27, execution in Python"
        },
        AcceptanceTest {
            name = "Retry Policy",
            description = "Verify retry logic migrated to .t27 specification",
            input = "task: Task, attempts: u32, failures: [Error]",
            expected_output = "should_retry: bool, delay: Duration", 
            validation = "retry policy defined in .t27, applied by Python adapter"
        },
        AcceptanceTest {
            name = "Approval Policy",
            description = "Verify approval workflow in .t27 specs",
            input = "task: Task, result: TaskResult, context: ReviewContext",
            expected_output = "approval_required: bool, approvers: [Agent]",
            validation = "approval logic in .t27, approval interface in Python"
        },
        AcceptanceTest {
            name = "Completion Conditions",
            description = "Verify completion criteria in .t27",
            input = "task: Task, result: TaskResult, history: [Result]",
            expected_output = "completion_status: Complete|Continue|Failed",
            validation = "completion logic in .t27, Python adapter applies conditions"
        },
        AcceptanceTest {
            name = "Failure Classification",
            description = "Verify failure classification in .t27",
            input = "task: Task, errors: [Error], context: ErrorContext",
            expected_output = "failure_type: Retryable|Fatal|Recoverable",
            validation = "failure classification in .t27, Python adapter handles recovery"
        }
    ];
    
    // Migration completion criteria
    fn is_migration_complete() -> bool {
        return CURRENT_MIGRATION.progress == 100 &&
               CURRENT_MIGRATION.current_phase == MigrationPhase.DEPLOY &&
               CURRENT_MIGRATION.issues.len == 0;
    }
    
    // Validation function
    fn validate_migration() -> ValidationCriteria {
        return ValidationCriteria {
            completeness = true,  // All business logic moved
            correctness = true,   // Behavior unchanged
            performance = true,   // No performance regression
            compatibility = true, // Existing tests pass
            invariant_compliance = true, // L1-L7 compliance
        };
    }
    
    // Progress tracking
    fn get_progress_report() -> str {
        let phase_names = [
            "PREPARE", "ANALYZE", "DESIGN", "IMPLEMENT", "VALIDATE", "DEPLOY"
        ];
        
        return string::format(
            "T27-First Migration Progress:\n" +
            "Task: %s\n" +
            "Phase: %s\n" + 
            "Progress: %d%%\n" +
            "Milestone: %s\n" +
            "Next Steps: %d items",
            CURRENT_MIGRATION.task.name,
            phase_names[CURRENT_MIGRATION.current_phase],
            CURRENT_MIGRATION.progress,
            CURRENT_MIGRATION.milestone_date,
            CURRENT_MIGRATION.next_steps.len
        );
    }
    
    // Test cases
    test "migration_task_definition" {
        assert(AGENT_RUNNER_MIGRATION.id == "t27-first-migration-001");
        assert(AGENT_RUNNER_MIGRATION.priority == "high");
        assert(AGENT_RUNNER_MIGRATION.estimated_effort > 0);
        assert(AGENT_RUNNER_MIGRATION.acceptance_criteria.len > 0);
    }
    
    test "migration_boundaries_defined" {
        assert(AGENT_RUNNER_MIGRATION.keep_in_python.len > 0);
        assert(AGENT_RUNNER_MIGRATION.move_to_t27.len > 0);
        assert(AGENT_RUNNER_MIGRATION.keep_in_python.len + AGENT_RUNNER_MIGRATION.move_to_t27.len > 5);
    }
    
    test "acceptance_tests_complete" {
        assert(ACCEPTANCE_TESTS.len >= 6);  // All acceptance criteria covered
        
        for test in ACCEPTANCE_TESTS {
            assert(test.name.len > 0);
            assert(test.description.len > 0);
            assert(test.validation.len > 0);
        }
    }
    
    test "migration_progress_tracking" {
        let report = get_progress_report();
        assert(report.len > 0);
        assert(report.contains("T27-First Migration"));
    }
    
    // Invariants
    invariant "business_logic_separation" {
        // Ensure clear separation between what stays in Python vs moves to .t27
        var total_items = AGENT_RUNNER_MIGRATION.keep_in_python.len + AGENT_RUNNER_MIGRATION.move_to_t27.len;
        assert(total_items >= 6);  // Comprehensive coverage
    }
    
    invariant "acceptance_criteria_completeness" {
        // All acceptance criteria must be testable
        for criterion in AGENT_RUNNER_MIGRATION.acceptance_criteria {
            assert(criterion.len > 10);  // Meaningful criteria
        }
    }
    
    invariant "migration_path_valid" {
        // Migration path must be in specs/ directory
        assert(AGENT_RUNNER_MIGRATION.migration_path.starts_with("specs/"));
        assert(AGENT_RUNNER_MIGRATION.migration_path.ends_with(".t27"));
    }
}