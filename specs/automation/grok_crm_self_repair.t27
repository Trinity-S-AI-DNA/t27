// specs/automation/grok_crm_self_repair.t27 -- grok crm: self-repair stops.
// Part of M8 milestone (milestone #12). Closes #13464.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::grok_crm_self_repair;

pub const GROK_CRM_SELF_REPAIR_MAX_ATTEMPTS : u32 = 3;

pub struct SelfRepair { attempt: u32, stopped: bool };

pub fn self_repair_stopped(s: SelfRepair) -> bool {
    return s.stopped || s.attempt >= GROK_CRM_SELF_REPAIR_MAX_ATTEMPTS;
}

test "self_repair_stopped" {
    assert(self_repair_stopped(SelfRepair { attempt: 1, stopped: true }));
    assert(self_repair_stopped(SelfRepair { attempt: 3, stopped: false }));
    assert(!self_repair_stopped(SelfRepair { attempt: 1, stopped: false }));
}

invariant grok_crm_self_repair_max_attempts_positive {
    assert GROK_CRM_SELF_REPAIR_MAX_ATTEMPTS > 0;
}