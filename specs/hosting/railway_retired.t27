; specs/hosting/railway_retired.t27 -- Railway is retired as the project's
; carrier (owner's word, 2026-10-27). Nothing new may name it as a
; dependency, a host, a gateway or a path; the existing mentions are debt
; that only shrinks, inventoried for the retirement epic. The receipts
; corridor and the t27b lab wait for their next carrier, to be decided by
; the owner -- until then they are WAITING, not RUNNING.

module HostingRailwayRetired;

pub const STATUS : str = "RETIRED";
pub const RETIRED_ON : u32 = 20261027;
pub const MENTION_FILES_MASTER : u32 = 384;

pub fn may_new_code_name_railway() -> bool {
    return false;
}

pub fn receipts_corridor_running() -> bool {
    return false;
}

test retirement_is_a_fact_and_a_gate {
    assert STATUS == "RETIRED";
    assert may_new_code_name_railway() == false;
    assert receipts_corridor_running() == false;
    assert RETIRED_ON == 20261027;
}
