; specs/hosting/host.t27 -- demonstrates t27b boundary interface for host function calls

module HostingHost;

; Declare the boundary for host functions
boundary HostFunctions {
    extern fn now_seconds() -> u32;
}

; Test the boundary interface with fake implementations during t27b test
test boundary_now_seconds_returns_42 {
    var time = HostFunctions.now_seconds();
    assert_eq(time, 42);
}