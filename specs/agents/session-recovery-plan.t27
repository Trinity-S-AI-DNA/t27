// specs/agents/session-recovery-plan.t27
// The Doctor's diagnosis: it classifies the failure and writes down the safe
// repair it intends to perform - before touching anything.
//
// Owner: T27_SESSION_NEVER_DIES (issue #1409), 2026-10-30.
//
// OWNS:
//   - the classification of a session failure into a repair class
//   - the requirement that a plan names the level, the action and the reason
//   - the READ-ONLY autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the recovery ladder levels and the per-failure policy:
//     specs/system/session-recovery-ladder.t27
//   - the Doctor lifecycle states: specs/system/session-doctor.t27
//   - the checkpoint contract: specs/system/session-continuity.t27
//   - the wire failure taxonomy:
//     specs/system/llm_request_provider_gate.t27

module session_recovery_plan;

// ─── Autonomy ──────────────────────────────────────────────────────────────

pub const AUTONOMY_READ_ONLY : u8 = 0;
pub const AUTONOMY_EVIDENCE : u8 = 1;
pub const AUTONOMY_BOUNDED : u8 = 2;
pub const AUTONOMY_WRITE : u8 = 3;
pub const AUTONOMY_APPROVAL_GATED : u8 = 4;

// ─── Repair classes ────────────────────────────────────────────────────────

pub const REPAIR_STREAM_TIMEOUT : u8 = 0;
pub const REPAIR_PROVIDER_UNFUNDED : u8 = 1;
pub const REPAIR_TOOL : u8 = 2;
pub const REPAIR_AGENT_STALL : u8 = 3;
pub const REPAIR_CONFIG_DRIFT : u8 = 4;
pub const REPAIR_COUNT : u32 = 5;

// ─── Plan completeness ─────────────────────────────────────────────────────

pub const PLAN_FIELD_LEVEL : u8 = 0;
pub const PLAN_FIELD_ACTION : u8 = 1;
pub const PLAN_FIELD_REASON : u8 = 2;
pub const PLAN_FIELD_CHECKPOINT : u8 = 3;
pub const PLAN_FIELD_COUNT : u32 = 4;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_autonomy() - the plan is read-only; it describes, it does not act.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_READ_ONLY;
}

// skill_mutates_state(autonomy) -> bool
pub fn skill_mutates_state(autonomy: u8) -> bool {
    if (autonomy == AUTONOMY_READ_ONLY) {
        return false;
    }
    if (autonomy == AUTONOMY_EVIDENCE) {
        return false;
    }
    return true;
}

// classify_failure(stream_timeout, provider_unfunded, tool_failed, agent_stalled, config_drift) -> u8
//
// Exactly one class fits. When more than one signal is present the funding
// class wins, because an unfunded route makes every other repair pointless.
pub fn classify_failure(stream_timeout: bool, provider_unfunded: bool, tool_failed: bool, agent_stalled: bool, config_drift: bool) -> u8 {
    if (provider_unfunded == true) {
        return REPAIR_PROVIDER_UNFUNDED;
    }
    if (stream_timeout == true) {
        return REPAIR_STREAM_TIMEOUT;
    }
    if (tool_failed == true) {
        return REPAIR_TOOL;
    }
    if (agent_stalled == true) {
        return REPAIR_AGENT_STALL;
    }
    if (config_drift == true) {
        return REPAIR_CONFIG_DRIFT;
    }
    return REPAIR_COUNT;
}

// repair_class_is_known(repair_class) -> bool
pub fn repair_class_is_known(repair_class: u8) -> bool {
    if (repair_class < REPAIR_COUNT) {
        return true;
    }
    return false;
}

// plan_is_complete(has_level, has_action, has_reason, has_checkpoint) -> bool
//
// A plan without a reason is an action without an explanation; a plan
// without a checkpoint reference is an action that can lose the work.
pub fn plan_is_complete(has_level: bool, has_action: bool, has_reason: bool, has_checkpoint: bool) -> bool {
    if (has_level == false) {
        return false;
    }
    if (has_action == false) {
        return false;
    }
    if (has_reason == false) {
        return false;
    }
    if (has_checkpoint == false) {
        return false;
    }
    return true;
}

// plan_requires_approval(repair_class) -> bool
// A provider switch and an unapproved config repair are sensitive: they wait
// for the owner.
pub fn plan_requires_approval(repair_class: u8) -> bool {
    if (repair_class == REPAIR_PROVIDER_UNFUNDED) {
        return true;
    }
    if (repair_class == REPAIR_CONFIG_DRIFT) {
        return true;
    }
    return false;
}

// plan_must_be_verified_before_continuing(plan_complete, verification_done) -> bool
// The repair is verified before the session continues. "Probably fine" is not
// a verification.
pub fn plan_must_be_verified_before_continuing(plan_complete: bool, verification_done: bool) -> bool {
    if (plan_complete == false) {
        return false;
    }
    return verification_done;
}

// unknown_failure_escalates(repair_class) -> bool
// An unclassified failure is handed over, never guessed at.
pub fn unknown_failure_escalates(repair_class: u8) -> bool {
    if (repair_class_is_known(repair_class) == false) {
        return true;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_plan_skill_is_read_only" {
    assert(skill_autonomy() == AUTONOMY_READ_ONLY);
    assert(skill_mutates_state(AUTONOMY_READ_ONLY) == false);
}

test "a_failure_is_classified_into_exactly_one_repair_class" {
    assert(classify_failure(true, false, false, false, false) == REPAIR_STREAM_TIMEOUT);
    assert(classify_failure(false, true, false, false, false) == REPAIR_PROVIDER_UNFUNDED);
    assert(classify_failure(false, false, true, false, false) == REPAIR_TOOL);
    assert(classify_failure(false, false, false, true, false) == REPAIR_AGENT_STALL);
    assert(classify_failure(false, false, false, false, true) == REPAIR_CONFIG_DRIFT);
}

test "the_funding_class_wins_over_every_other_signal" {
    assert(classify_failure(true, true, true, true, true) == REPAIR_PROVIDER_UNFUNDED);
}

test "an_unclassified_failure_is_not_guessed_at" {
    assert(classify_failure(false, false, false, false, false) == REPAIR_COUNT);
    assert(repair_class_is_known(REPAIR_COUNT) == false);
    assert(unknown_failure_escalates(REPAIR_COUNT) == true);
    assert(unknown_failure_escalates(REPAIR_TOOL) == false);
}

test "a_plan_names_the_level_the_action_the_reason_and_the_checkpoint" {
    assert(plan_is_complete(true, true, true, true) == true);
    assert(plan_is_complete(false, true, true, true) == false);
    assert(plan_is_complete(true, false, true, true) == false);
    assert(plan_is_complete(true, true, false, true) == false);
    assert(plan_is_complete(true, true, true, false) == false);
}

test "a_sensitive_repair_waits_for_the_owner" {
    assert(plan_requires_approval(REPAIR_PROVIDER_UNFUNDED) == true);
    assert(plan_requires_approval(REPAIR_CONFIG_DRIFT) == true);
    assert(plan_requires_approval(REPAIR_STREAM_TIMEOUT) == false);
    assert(plan_requires_approval(REPAIR_TOOL) == false);
}

test "the_repair_is_verified_before_the_session_continues" {
    assert(plan_must_be_verified_before_continuing(true, true) == true);
    assert(plan_must_be_verified_before_continuing(true, false) == false);
    assert(plan_must_be_verified_before_continuing(false, true) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant the_plan_never_mutates_the_session {
    skill_mutates_state(AUTONOMY_READ_ONLY) == false;
}

invariant an_unfunded_route_is_always_classified_as_such {
    classify_failure(true, true, false, false, false) == REPAIR_PROVIDER_UNFUNDED;
}

invariant an_unknown_failure_is_always_escalated {
    unknown_failure_escalates(REPAIR_COUNT) == true;
    unknown_failure_escalates(REPAIR_STREAM_TIMEOUT) == false;
}

invariant a_repair_is_never_continued_without_verification {
    plan_must_be_verified_before_continuing(true, false) == false;
    plan_must_be_verified_before_continuing(true, true) == true;
}
