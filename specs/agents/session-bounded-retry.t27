// specs/agents/session-bounded-retry.t27
// The Doctor's patience: three attempts, exponential backoff, and never on a
// side effect that would happen twice.
//
// Owner: T27_SESSION_NEVER_DIES (issue #1409), 2026-10-30.
//
// OWNS:
//   - the bounded retry budget of this skill
//   - the backoff schedule
//   - the idempotency guard that stands in front of every retry
//   - the BOUNDED autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the recovery ladder levels and the per-failure policy:
//     specs/system/session-recovery-ladder.t27
//   - the checkpoint contract and the idempotency rule:
//     specs/system/session-continuity.t27
//   - the Doctor lifecycle states: specs/system/session-doctor.t27

module session_bounded_retry;

// ─── Autonomy ──────────────────────────────────────────────────────────────

pub const AUTONOMY_READ_ONLY : u8 = 0;
pub const AUTONOMY_EVIDENCE : u8 = 1;
pub const AUTONOMY_BOUNDED : u8 = 2;
pub const AUTONOMY_WRITE : u8 = 3;
pub const AUTONOMY_APPROVAL_GATED : u8 = 4;

// ─── Retry budget ──────────────────────────────────────────────────────────

pub const MAX_ATTEMPTS : u32 = 3;
pub const BACKOFF_BASE_MS : u32 = 1000;

// ─── Retry decision ────────────────────────────────────────────────────────

pub const RETRY_ALLOWED : u8 = 0;
pub const RETRY_WAIT_BACKOFF : u8 = 1;
pub const RETRY_EXHAUSTED : u8 = 2;
pub const RETRY_DENIED_NOT_TRANSIENT : u8 = 3;
pub const RETRY_DENIED_NOT_IDEMPOTENT : u8 = 4;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_autonomy() - the retry is bounded: three attempts and no more.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_BOUNDED;
}

// skill_mutates_state(autonomy) -> bool
pub fn skill_mutates_state(autonomy: u8) -> bool {
    if (autonomy == AUTONOMY_READ_ONLY) {
        return false;
    }
    if (autonomy == AUTONOMY_EVIDENCE) {
        return false;
    }
    return true;
}

// is_transient_failure(failure_class) -> bool
// Only a transient failure is worth another attempt.
pub fn is_transient_failure(failure_class: u8) -> bool {
    if (failure_class == 0) {
        return true;
    }
    return false;
}

// backoff_delay_ms(attempt) - 1000ms, 2000ms, 4000ms.
pub fn backoff_delay_ms(attempt: u32) -> u32 {
    if (attempt == 0) {
        return BACKOFF_BASE_MS;
    }
    if (attempt == 1) {
        return BACKOFF_BASE_MS * 2;
    }
    if (attempt == 2) {
        return BACKOFF_BASE_MS * 4;
    }
    return BACKOFF_BASE_MS * 8;
}

// retry_decision(failure_class, attempts_made, idempotent) -> u8
//
// The order of the checks is the contract: a non-transient failure is denied
// before the budget is even looked at, and a non-idempotent action is denied
// before it can be repeated.
pub fn retry_decision(failure_class: u8, attempts_made: u32, idempotent: bool) -> u8 {
    if (is_transient_failure(failure_class) == false) {
        return RETRY_DENIED_NOT_TRANSIENT;
    }
    if (idempotent == false) {
        return RETRY_DENIED_NOT_IDEMPOTENT;
    }
    if (attempts_made >= MAX_ATTEMPTS) {
        return RETRY_EXHAUSTED;
    }
    if (attempts_made == 0) {
        return RETRY_ALLOWED;
    }
    return RETRY_WAIT_BACKOFF;
}

// retry_attempt_is_permitted(failure_class, attempts_made, idempotent) -> bool
pub fn retry_attempt_is_permitted(failure_class: u8, attempts_made: u32, idempotent: bool) -> bool {
    if (retry_decision(failure_class, attempts_made, idempotent) == RETRY_ALLOWED) {
        return true;
    }
    return false;
}

// retry_budget_is_exhausted(attempts_made) -> bool
pub fn retry_budget_is_exhausted(attempts_made: u32) -> bool {
    if (attempts_made >= MAX_ATTEMPTS) {
        return true;
    }
    return false;
}

// retry_must_be_visible(attempts_made, user_notified) -> bool
// Every retry is announced: the user sees "Doctor retrying - work preserved".
pub fn retry_must_be_visible(attempts_made: u32, user_notified: bool) -> bool {
    if (attempts_made == 0) {
        return true;
    }
    return user_notified;
}

// work_is_preserved_during_a_retry(checkpoint_written) -> bool
pub fn work_is_preserved_during_a_retry(checkpoint_written: bool) -> bool {
    return checkpoint_written;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_retry_skill_is_bounded" {
    assert(skill_autonomy() == AUTONOMY_BOUNDED);
    assert(MAX_ATTEMPTS == 3);
}

test "the_first_attempt_goes_out_immediately" {
    assert(retry_decision(0, 0, true) == RETRY_ALLOWED);
    assert(retry_attempt_is_permitted(0, 0, true) == true);
}

test "a_retry_waits_for_the_backoff" {
    assert(retry_decision(0, 1, true) == RETRY_WAIT_BACKOFF);
    assert(retry_decision(0, 2, true) == RETRY_WAIT_BACKOFF);
    assert(backoff_delay_ms(0) == 1000);
    assert(backoff_delay_ms(1) == 2000);
    assert(backoff_delay_ms(2) == 4000);
}

test "the_budget_runs_out_after_three_attempts" {
    assert(retry_decision(0, 3, true) == RETRY_EXHAUSTED);
    assert(retry_budget_is_exhausted(2) == false);
    assert(retry_budget_is_exhausted(3) == true);
}

test "a_non_transient_failure_is_never_retried" {
    assert(retry_decision(1, 0, true) == RETRY_DENIED_NOT_TRANSIENT);
    assert(retry_decision(2, 0, true) == RETRY_DENIED_NOT_TRANSIENT);
    assert(retry_decision(3, 0, true) == RETRY_DENIED_NOT_TRANSIENT);
    assert(retry_decision(4, 0, true) == RETRY_DENIED_NOT_TRANSIENT);
}

test "a_non_idempotent_action_is_never_repeated" {
    assert(retry_decision(0, 0, false) == RETRY_DENIED_NOT_IDEMPOTENT);
    assert(retry_attempt_is_permitted(0, 0, false) == false);
}

test "every_retry_is_announced_and_keeps_the_work" {
    assert(retry_must_be_visible(1, true) == true);
    assert(retry_must_be_visible(1, false) == false);
    assert(work_is_preserved_during_a_retry(true) == true);
    assert(work_is_preserved_during_a_retry(false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant the_retry_budget_is_never_unbounded {
    retry_budget_is_exhausted(MAX_ATTEMPTS) == true;
    retry_decision(0, MAX_ATTEMPTS, true) == RETRY_EXHAUSTED;
}

invariant a_non_transient_failure_is_never_retried {
    retry_decision(1, 0, true) == RETRY_DENIED_NOT_TRANSIENT;
    retry_attempt_is_permitted(1, 0, true) == false;
}

invariant a_non_idempotent_action_is_never_repeated {
    retry_decision(0, 0, false) == RETRY_DENIED_NOT_IDEMPOTENT;
    retry_attempt_is_permitted(0, 0, false) == false;
}

invariant every_retry_is_visible_to_the_user {
    retry_must_be_visible(1, false) == false;
    retry_must_be_visible(1, true) == true;
}

invariant the_work_survives_every_retry {
    work_is_preserved_during_a_retry(false) == false;
    work_is_preserved_during_a_retry(true) == true;
}
