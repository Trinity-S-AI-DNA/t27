spec dsh_incident_evidence_pack {
    incident_evidence_pack_skill {
        ; T27_DSH_INCIDENT_EVIDENCE_PACK:
        ; Collect commands, logs, exit codes, timeline as READ_ONLY skill
        ; Phase complete: Issue
        → Phase 2: Spec
        
        name: "dsh-incident-evidence-pack"
        purpose: "Collect commands, logs, exit codes, timeline"
        automation_level: "READ_ONLY"
        inputs: {
            incident_id: string
            time_range: time_range {
                start: datetime
                end: datetime
            }
            evidence_types: list<string> ["logs", "commands", "exit_codes", "timeline", "metrics", "snapshots"]
            include_sensitive_data: bool false
            compression_level: int 6
        }
        outputs: {
            evidence_package: incident_evidence {
                package_id: string
                incident_id: string
                collection_timestamp: datetime
                time_range: time_range {
                    start: datetime
                    end: datetime
                }
                evidence_bundles: list<evidence_bundle> [
                    {
                        bundle_type: "logs"
                        source_systems: list<string> ["agent", "provider", "runtime", "guard"]
                        files: list<evidence_file> [
                            {
                                file_name: string
                                file_path: string
                                file_size: int
                                checksum: string
                                compression_ratio: float
                                content_type: "text/plain|application/json|application/gzip"
                                redaction_applied: bool
                            }
                        ]
                        summary: string
                        key_findings: list<string>
                    },
                    {
                        bundle_type: "commands"
                        source_systems: list<string> ["agent", "cli", "api"]
                        files: list<evidence_file>
                        summary: string
                        key_findings: list<string>
                    },
                    {
                        bundle_type: "exit_codes"
                        source_systems: list<string> ["runtime", "process", "service"]
                        files: list<evidence_file>
                        summary: string
                        exit_code_distribution: map<int, int>
                        key_findings: list<string>
                    },
                    {
                        bundle_type: "timeline"
                        source_systems: list<string> ["system", "application", "agent"]
                        files: list<evidence_file>
                        summary: string
                        critical_events: list<timeline_event> [
                            {
                                timestamp: datetime
                                event_type: string
                                source: string
                                severity: "info|warning|error|critical"
                                description: string
                                affected_components: list<string>
                                data: any
                            }
                        ]
                        key_findings: list<string>
                    },
                    {
                        bundle_type: "metrics"
                        source_systems: list<string> ["monitoring", "health", "performance"]
                        files: list<evidence_file>
                        summary: string
                        metric_aggregations: map<string, metric_aggregation>
                        key_findings: list<string>
                    },
                    {
                        bundle_type: "snapshots"
                        source_systems: list<string> ["checkpoint", "memory", "state"]
                        files: list<evidence_file>
                        summary: string
                        snapshot_integrity: map<string, integrity_check>
                        key_findings: list<string>
                    }
                ]
                metadata: {
                    total_files: int
                    total_size: int
                    compressed_size: int
                    compression_ratio: float
                    redaction_applied: bool
                    sensitive_data_detected: bool
                    collection_duration: duration
                    collection_success_rate: float
                }
                integrity_report: {
                    package_checksum: string
                    file_checksums: map<string, string>
                    validation_status: "valid|invalid|partial"
                    validation_errors: list<string>
                }
                redaction_summary: {
                    redaction_rules_applied: list<string>
                    redaction_count: int
                    sensitive_data_types: list<string>
                }
                legal_compliance: {
                    regulations_complied: list<string> ["GDPR", "HIPAA", "SOC2"]
                    retention_policy: string
                    access_controls: list<string>
                    audit_trail_id: string
                }
            }
            exit_code: int
        }
        checks: [
            "evidence_complete",
            "timeline_consistent"
        ]
        remediation: "none"
    }

    test_skill incident_id_validation {
        ; Verify: Incident ID is validated
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { incident_id: "" })
        then executed.exit_code == 400
        then executed.outputs.evidence_package.package_id == ""
        then executed.outputs.evidence_package.metadata.total_files == 0
    }

    test_skill time_range_validation {
        ; Verify: Time range is validated
        given packer = create_incident_evidence_pack_skill()
        when invalid_range = create_invalid_time_range()
        when executed = execute_skill(packer, { 
            incident_id: "test_incident",
            time_range: invalid_range
        })
        then executed.exit_code == 400
        then executed.outputs.evidence_package.integrity_report.validation_status == "invalid"
    }

    test_skill evidence_collection {
        ; Verify: Evidence is collected completely
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "complete_incident",
            evidence_types: ["logs", "commands", "exit_codes", "timeline"]
        })
        then executed.exit_code == 200
        then len(executed.outputs.evidence_package.evidence_bundles) == 4
        then len(executed.outputs.evidence_package.metadata.total_files) > 0
        then executed.outputs.evidence_package.metadata.collection_success_rate > 0.8
    }

    test_skill log_bundle_collection {
        ; Verify: Log evidence bundle is collected
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "log_test_incident",
            evidence_types: ["logs"]
        })
        then executed.exit_code == 200
        then executed.outputs.evidence_package.evidence_bundles[0].bundle_type == "logs"
        then len(executed.outputs.evidence_package.evidence_bundles[0].files) > 0
        then executed.outputs.evidence_package.evidence_bundles[0].summary != ""
    }

    test_skill timeline_consistency {
        ; Verify: Timeline is consistent across sources
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "timeline_test_incident",
            evidence_types: ["timeline"]
        })
        then executed.exit_code == 200
        then len(executed.outputs.evidence_package.evidence_bundles[3].critical_events) > 0
        then timeline_events_ordered(executed.outputs.evidence_package.evidence_bundles[3].critical_events)
    }

    test_skill exit_code_analysis {
        ; Verify: Exit codes are analyzed correctly
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "exit_code_test_incident",
            evidence_types: ["exit_codes"]
        })
        then executed.exit_code == 200
        then len(executed.outputs.evidence_package.evidence_bundles[2].exit_code_distribution) > 0
        then executed.outputs.evidence_package.evidence_bundles[2].summary contains "exit code"
    }

    test_skill metrics_aggregation {
        ; Verify: Metrics are aggregated correctly
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "metrics_test_incident",
            evidence_types: ["metrics"]
        })
        then executed.exit_code == 200
        then len(executed.outputs.evidence_package.evidence_bundles[4].metric_aggregations) > 0
        then executed.outputs.evidence_package.evidence_bundles[4].summary contains "aggregated"
    }

    test_skill snapshot_integrity {
        ; Verify: Snapshot integrity is checked
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "snapshot_test_incident",
            evidence_types: ["snapshots"]
        })
        then executed.exit_code == 200
        then len(executed.outputs.evidence_package.evidence_bundles[5].snapshot_integrity) > 0
        then executed.outputs.evidence_package.evidence_bundles[5].summary contains "integrity"
    }

    test_skill data_compression {
        ; Verify: Data compression works
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "compression_test_incident",
            compression_level: 9
        })
        then executed.exit_code == 200
        then executed.outputs.evidence_package.metadata.compression_ratio > 1.0
        then executed.outputs.evidence_package.metadata.compressed_size < executed.outputs.evidence_package.metadata.total_size
    }

    test_skill sensitive_data_detection {
        ; Verify: Sensitive data is detected
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "sensitive_test_incident",
            include_sensitive_data: true
        })
        then executed.exit_code == 200
        then executed.outputs.evidence_package.redaction_summary.sensitive_data_detected == true
        then executed.outputs.evidence_package.redaction_summary.redaction_count > 0
    }

    test_skill integrity_validation {
        ; Verify: Package integrity is validated
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "integrity_test_incident"
        })
        then executed.exit_code == 200
        then executed.outputs.evidence_package.integrity_report.validation_status == "valid"
        then executed.outputs.evidence_package.integrity_report.package_checksum != ""
    }

    test_skill legal_compliance {
        ; Verify: Legal compliance information is included
        given packer = create_incident_evidence_pack_skill()
        when executed = execute_skill(packer, { 
            incident_id: "compliance_test_incident"
        })
        then executed.exit_code == 200
        then len(executed.outputs.evidence_package.legal_compliance.regulations_complied) > 0
        then executed.outputs.evidence_package.legal_compliance.audit_trail_id != ""
    }

    invariant evidence_schema_validity {
        ; Evidence package outputs must conform to schema
        assert forall package: incident_evidence,
            package.package_id != "" and
            package.incident_id != "" and
            package.collection_timestamp != "" and
            len(package.evidence_bundles) > 0 and
            package.metadata.total_files >= 0 and
            package.metadata.total_size >= 0 and
            package.metadata.compressed_size >= 0 and
            package.metadata.compression_ratio >= 1.0 and
            package.integrity_report.validation_status in ["valid", "invalid", "partial"]
    }

    invariant timeline_consistency_constraint {
        ; Timeline events must be time-ordered
        assert forall bundle: evidence_bundle,
            if bundle.bundle_type == "timeline" then
                forall events: timeline_event in bundle.critical_events,
                    events are timestamp_ordered_ascending
    }

    invariant file_checksum_consistency {
        ; File checksums must be consistent with metadata
        assert forall package: incident_evidence,
            package.integrity_report.file_checksums.size == package.metadata.total_files and
            forall file_checksum: file_checksum in package.integrity_report.file_checksums,
                file_checksum != ""
    }

    invariant compliance_enforcement {
        ; Legal compliance must be enforced
        assert forall package: incident_evidence,
            len(package.legal_compliance.regulations_complied) > 0 and
            package.legal_compliance.audit_trail_id != "" and
            package.legal_compliance.retention_policy != ""
    }

    ; Bench for incident evidence pack performance
    bench incident_evidence_pack_latency {
        ; Measure: Time to complete incident evidence collection
        target: < 10s on typical hardware
        iterations: 100
        setup: create_test_incident_environment()
        measure: execute_incident_evidence_pack_skill(setup)
    }
}