// SPDX-License-Identifier: Apache-2.0
// specs/agents/session-recovery-evidence.t27
// The Doctor's record: what broke, what was tried, what was repaired, and
// where the session resumed from. The evidence is what makes the repair
// auditable instead of a story.
//
// Owner: T27_SESSION_NEVER_DIES (issue #1409), 2026-10-30.
//
// OWNS:
//   - the evidence kinds a recovery record carries
//   - the completeness rule of an evidence bundle
//   - the link from the evidence to the checkpoint it describes
//   - the EVIDENCE autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the incident schema of the Doctor MVP: doctor/incident-schema.json
//   - the Doctor lifecycle states: specs/system/session-doctor.t27
//   - the recovery ladder levels: specs/system/session-recovery-ladder.t27
//   - the checkpoint contract: specs/system/session-continuity.t27

module session_recovery_evidence;

// ─── Autonomy ──────────────────────────────────────────────────────────────

pub const AUTONOMY_READ_ONLY : u8 = 0;
pub const AUTONOMY_EVIDENCE : u8 = 1;
pub const AUTONOMY_BOUNDED : u8 = 2;
pub const AUTONOMY_WRITE : u8 = 3;
pub const AUTONOMY_APPROVAL_GATED : u8 = 4;

// ─── Evidence kinds ────────────────────────────────────────────────────────

pub const EVIDENCE_INCIDENT : u8 = 0;
pub const EVIDENCE_CLASSIFICATION : u8 = 1;
pub const EVIDENCE_REPAIR_ATTEMPT : u8 = 2;
pub const EVIDENCE_RESUME_POINT : u8 = 3;
pub const EVIDENCE_OWNER_DECISION : u8 = 4;
pub const EVIDENCE_COUNT : u32 = 5;

// ─── Record outcome ────────────────────────────────────────────────────────

pub const RECORD_INCOMPLETE : u8 = 0;
pub const RECORD_COMPLETE : u8 = 1;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_autonomy() - the evidence skill records; it does not repair.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_EVIDENCE;
}

// skill_mutates_state(autonomy) -> bool
// An evidence skill writes the evidence file, not the session state.
pub fn skill_mutates_state(autonomy: u8) -> bool {
    if (autonomy == AUTONOMY_READ_ONLY) {
        return false;
    }
    if (autonomy == AUTONOMY_EVIDENCE) {
        return false;
    }
    return true;
}

// evidence_kind_is_valid(kind) -> bool
pub fn evidence_kind_is_valid(kind: u8) -> bool {
    if (kind < EVIDENCE_COUNT) {
        return true;
    }
    return false;
}

// evidence_bundle_is_complete(has_incident, has_classification, has_repair_attempt, has_resume_point, has_owner_decision) -> bool
//
// A recovery that produced no incident record is a recovery nobody can check.
pub fn evidence_bundle_is_complete(has_incident: bool, has_classification: bool, has_repair_attempt: bool, has_resume_point: bool, has_owner_decision: bool) -> bool {
    if (has_incident == false) {
        return false;
    }
    if (has_classification == false) {
        return false;
    }
    if (has_repair_attempt == false) {
        return false;
    }
    if (has_resume_point == false) {
        return false;
    }
    if (has_owner_decision == false) {
        return false;
    }
    return true;
}

// record_outcome(has_incident, has_classification, has_repair_attempt, has_resume_point, has_owner_decision) -> u8
pub fn record_outcome(has_incident: bool, has_classification: bool, has_repair_attempt: bool, has_resume_point: bool, has_owner_decision: bool) -> u8 {
    if (evidence_bundle_is_complete(has_incident, has_classification, has_repair_attempt, has_resume_point, has_owner_decision) == false) {
        return RECORD_INCOMPLETE;
    }
    return RECORD_COMPLETE;
}

// evidence_must_reference_a_checkpoint(has_checkpoint_link) -> bool
// The evidence points at the checkpoint it describes, so the two can be
// cross-checked later.
pub fn evidence_must_reference_a_checkpoint(has_checkpoint_link: bool) -> bool {
    return has_checkpoint_link;
}

// evidence_records_every_attempt(attempts_made, attempts_recorded) -> bool
// No attempt disappears from the record.
pub fn evidence_records_every_attempt(attempts_made: u32, attempts_recorded: u32) -> bool {
    if (attempts_recorded < attempts_made) {
        return false;
    }
    return true;
}

// evidence_is_never_silent(record_created, user_notified) -> bool
pub fn evidence_is_never_silent(record_created: bool, user_notified: bool) -> bool {
    if (record_created == false) {
        return true;
    }
    return user_notified;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_evidence_skill_does_not_touch_the_session" {
    assert(skill_autonomy() == AUTONOMY_EVIDENCE);
    assert(skill_mutates_state(AUTONOMY_EVIDENCE) == false);
    assert(skill_mutates_state(AUTONOMY_WRITE) == true);
}

test "the_bundle_carries_incident_classification_repair_resume_and_decision" {
    assert(evidence_bundle_is_complete(true, true, true, true, true) == true);
    assert(evidence_bundle_is_complete(false, true, true, true, true) == false);
    assert(evidence_bundle_is_complete(true, false, true, true, true) == false);
    assert(evidence_bundle_is_complete(true, true, false, true, true) == false);
    assert(evidence_bundle_is_complete(true, true, true, false, true) == false);
    assert(evidence_bundle_is_complete(true, true, true, true, false) == false);
}

test "an_incomplete_bundle_is_marked_incomplete" {
    assert(record_outcome(true, true, true, true, true) == RECORD_COMPLETE);
    assert(record_outcome(true, true, true, true, false) == RECORD_INCOMPLETE);
    assert(record_outcome(false, false, false, false, false) == RECORD_INCOMPLETE);
}

test "the_evidence_points_at_its_checkpoint" {
    assert(evidence_must_reference_a_checkpoint(true) == true);
    assert(evidence_must_reference_a_checkpoint(false) == false);
}

test "no_attempt_disappears_from_the_record" {
    assert(evidence_records_every_attempt(3, 3) == true);
    assert(evidence_records_every_attempt(3, 2) == false);
    assert(evidence_records_every_attempt(0, 0) == true);
}

test "the_record_is_never_silent" {
    assert(evidence_is_never_silent(true, false) == false);
    assert(evidence_is_never_silent(true, true) == true);
    assert(evidence_is_never_silent(false, false) == true);
}

test "the_five_evidence_kinds_are_the_declared_ones" {
    assert(EVIDENCE_COUNT == 5);
    assert(evidence_kind_is_valid(EVIDENCE_INCIDENT) == true);
    assert(evidence_kind_is_valid(EVIDENCE_RESUME_POINT) == true);
    assert(evidence_kind_is_valid(EVIDENCE_COUNT) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant a_recovery_always_leaves_a_complete_bundle {
    record_outcome(true, true, true, true, false) == RECORD_INCOMPLETE;
    record_outcome(true, true, true, true, true) == RECORD_COMPLETE;
}

invariant the_evidence_always_references_its_checkpoint {
    evidence_must_reference_a_checkpoint(false) == false;
    evidence_must_reference_a_checkpoint(true) == true;
}

invariant every_attempt_is_recorded {
    evidence_records_every_attempt(3, 2) == false;
    evidence_records_every_attempt(3, 3) == true;
}

invariant the_evidence_record_is_always_visible {
    evidence_is_never_silent(true, false) == false;
    evidence_is_never_silent(true, true) == true;
}
