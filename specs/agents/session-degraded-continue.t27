// specs/agents/session-degraded-continue.t27
// The Doctor's honest answer: keep going without the capability that broke,
// narrow the scope, and say so out loud.
//
// Owner: T27_SESSION_NEVER_DIES (issue #1409), 2026-10-30.
//
// OWNS:
//   - when a degraded continuation is admissible
//   - the narrowing of the scope
//   - the mandatory user notice and the listed unavailable capability
//   - the BOUNDED autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the degraded-mode rule of the checkpoint contract:
//     specs/system/session-continuity.t27
//   - the recovery ladder levels: specs/system/session-recovery-ladder.t27
//   - the Doctor lifecycle states and the status bar:
//     specs/system/session-doctor.t27

module session_degraded_continue;

// ─── Autonomy ──────────────────────────────────────────────────────────────

pub const AUTONOMY_READ_ONLY : u8 = 0;
pub const AUTONOMY_EVIDENCE : u8 = 1;
pub const AUTONOMY_BOUNDED : u8 = 2;
pub const AUTONOMY_WRITE : u8 = 3;
pub const AUTONOMY_APPROVAL_GATED : u8 = 4;

// ─── Degradation decision ──────────────────────────────────────────────────

pub const DEGRADE_ADMITTED : u8 = 0;
pub const DEGRADE_DENIED_NO_FUNDED_ROUTE : u8 = 1;
pub const DEGRADE_DENIED_NO_NOTICE : u8 = 2;
pub const DEGRADE_DENIED_NOTHING_TO_LOSE : u8 = 3;

// ─── Scope narrowing ───────────────────────────────────────────────────────

pub const SCOPE_FULL : u8 = 0;
pub const SCOPE_NARROWED : u8 = 1;
pub const SCOPE_COUNT : u32 = 2;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_autonomy() - the degraded continuation is bounded to what still works.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_BOUNDED;
}

// skill_mutates_state(autonomy) -> bool
pub fn skill_mutates_state(autonomy: u8) -> bool {
    if (autonomy == AUTONOMY_READ_ONLY) {
        return false;
    }
    if (autonomy == AUTONOMY_EVIDENCE) {
        return false;
    }
    return true;
}

// degrade_decision(funded_route_available, capability_available, notice_emitted, work_at_risk) -> u8
//
// A degraded session needs a route that can still answer, a notice the user
// actually sees, and something worth continuing.
pub fn degrade_decision(funded_route_available: bool, capability_available: bool, notice_emitted: bool, work_at_risk: bool) -> u8 {
    if (funded_route_available == false) {
        return DEGRADE_DENIED_NO_FUNDED_ROUTE;
    }
    if (capability_available == true) {
        return DEGRADE_DENIED_NOTHING_TO_LOSE;
    }
    if (notice_emitted == false) {
        return DEGRADE_DENIED_NO_NOTICE;
    }
    if (work_at_risk == true) {
        return DEGRADE_DENIED_NO_NOTICE;
    }
    return DEGRADE_ADMITTED;
}

// degrade_is_admitted(funded_route_available, capability_available, notice_emitted, work_at_risk) -> bool
pub fn degrade_is_admitted(funded_route_available: bool, capability_available: bool, notice_emitted: bool, work_at_risk: bool) -> bool {
    if (degrade_decision(funded_route_available, capability_available, notice_emitted, work_at_risk) == DEGRADE_ADMITTED) {
        return true;
    }
    return false;
}

// scope_after_degrade(capability_available) -> u8
// The scope narrows to what still works; it never stays full.
pub fn scope_after_degrade(capability_available: bool) -> u8 {
    if (capability_available == true) {
        return SCOPE_FULL;
    }
    return SCOPE_NARROWED;
}

// scope_must_narrow(capability_available, scope) -> bool
pub fn scope_must_narrow(capability_available: bool, scope: u8) -> bool {
    if (capability_available == false and scope == SCOPE_FULL) {
        return false;
    }
    return true;
}

// notice_must_name_the_unavailable_capability(notice_emitted, names_capability) -> bool
// "Continuing" without saying what is missing is the silent fallback the
// contract forbids.
pub fn notice_must_name_the_unavailable_capability(notice_emitted: bool, names_capability: bool) -> bool {
    if (notice_emitted == false) {
        return false;
    }
    return names_capability;
}

// degraded_work_is_still_preserved(checkpoint_written) -> bool
pub fn degraded_work_is_still_preserved(checkpoint_written: bool) -> bool {
    return checkpoint_written;
}

// degraded_result_is_marked_degraded(result_marked_degraded) -> bool
// The final answer carries the degradation with it, so nobody downstream
// mistakes a narrowed answer for a complete one.
pub fn degraded_result_is_marked_degraded(result_marked_degraded: bool) -> bool {
    return result_marked_degraded;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_degraded_skill_is_bounded" {
    assert(skill_autonomy() == AUTONOMY_BOUNDED);
    assert(skill_mutates_state(AUTONOMY_BOUNDED) == true);
}

test "a_degraded_continuation_needs_a_funded_route" {
    assert(degrade_decision(false, false, true, false) == DEGRADE_DENIED_NO_FUNDED_ROUTE);
    assert(degrade_is_admitted(false, false, true, false) == false);
}

test "a_degraded_continuation_needs_a_visible_notice" {
    assert(degrade_decision(true, false, false, false) == DEGRADE_DENIED_NO_NOTICE);
    assert(degrade_decision(true, false, true, false) == DEGRADE_ADMITTED);
    assert(degrade_is_admitted(true, false, true, false) == true);
}

test "there_is_nothing_to_degrade_when_the_capability_works" {
    assert(degrade_decision(true, true, true, false) == DEGRADE_DENIED_NOTHING_TO_LOSE);
}

test "the_scope_narrows_to_what_still_works" {
    assert(scope_after_degrade(false) == SCOPE_NARROWED);
    assert(scope_after_degrade(true) == SCOPE_FULL);
    assert(scope_must_narrow(false, SCOPE_FULL) == false);
    assert(scope_must_narrow(false, SCOPE_NARROWED) == true);
}

test "the_notice_names_the_unavailable_capability" {
    assert(notice_must_name_the_unavailable_capability(true, true) == true);
    assert(notice_must_name_the_unavailable_capability(true, false) == false);
    assert(notice_must_name_the_unavailable_capability(false, true) == false);
}

test "the_degraded_result_is_marked_and_the_work_is_kept" {
    assert(degraded_work_is_still_preserved(true) == true);
    assert(degraded_work_is_still_preserved(false) == false);
    assert(degraded_result_is_marked_degraded(true) == true);
    assert(degraded_result_is_marked_degraded(false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant a_degraded_session_always_has_a_route {
    degrade_decision(false, false, true, false) == DEGRADE_DENIED_NO_FUNDED_ROUTE;
    degrade_is_admitted(false, false, true, false) == false;
}

invariant a_degraded_session_is_never_silent {
    degrade_decision(true, false, false, false) == DEGRADE_DENIED_NO_NOTICE;
    degrade_is_admitted(true, false, false, false) == false;
}

invariant the_scope_always_narrows_when_a_capability_is_lost {
    scope_must_narrow(false, SCOPE_FULL) == false;
    scope_must_narrow(false, SCOPE_NARROWED) == true;
}

invariant a_degraded_result_is_always_marked {
    degraded_result_is_marked_degraded(false) == false;
    degraded_result_is_marked_degraded(true) == true;
}
