spec dsh_autonomy_policy {
    autonomy_policy {
        ; T27_AUTONOMY_POLICY:
        ; Defines autonomy levels with explicit approval requirements
        ; Phase complete: Issue
        → Phase 2: Spec
        
        levels: list<autonomy_level> [
            {
                name: "READ_ONLY"
                description: "health snapshot; config verify; evidence pack"
                allowed_actions: [
                    "collect_evidence",
                    "read_configuration",
                    "verify_integrity",
                    "create_snapshot"
                ]
                requires_approval: false
                approval_type: "none"
                risk_level: "low"
            },
            {
                name: "SAFE_BOUNDED"
                description: "checkpoint; quarantine route; restart noncritical helper"
                allowed_actions: [
                    "create_checkpoint",
                    "isolate_route",
                    "restart_helper",
                    "disable_automation"
                ]
                requires_approval: false
                approval_type: "passive"
                risk_level: "medium"
                max_impact: "single_component"
                max_duration: "5m"
            },
            {
                name: "SENSITIVE"
                description: "credential change; provider switch; full deployment; release approval"
                allowed_actions: [
                    "modify_credentials",
                    "switch_provider",
                    "deploy_to_production",
                    "approve_release"
                ]
                requires_approval: true
                approval_type: "active"
                risk_level: "high"
                requires_owner_signature: true
                requires_impact_assessment: true
            },
            {
                name: "UNKNOWN"
                description: "new failure signature; unclassified deviation"
                allowed_actions: []
                requires_approval: true
                approval_type: "active"
                risk_level: "unknown"
                action: "observe_classify_escalate"
            }
        ]
        
        agent_modes: list<agent_mode> [
            {
                name: "CREATOR"
                purpose: "Create specifications, skills, code"
                primary_risk: "scope_creep"
                autonomy_level: "SAFE_BOUNDED"
                required_controls: [
                    "scope_contract",
                    "acceptance_criteria"
                ]
            },
            {
                name: "GOAL_MANAGER"
                purpose: "Transform goal into verifiable plan"
                primary_risk: "goal_without_evidence"
                autonomy_level: "READ_ONLY"
                required_controls: [
                    "milestones",
                    "definition_of_done"
                ]
            },
            {
                name: "SYSTEM_HEALER"
                purpose: "Restore system health"
                primary_risk: "dangerous_auto_fixes"
                autonomy_level: "SAFE_BOUNDED"
                required_controls: [
                    "guardrails",
                    "rollback",
                    "approval_gates"
                ]
            },
            {
                name: "PROACTIVE_AUTOMATOR"
                purpose: "Prevent recurrence"
                primary_risk: "automation_unknown_failures"
                autonomy_level: "READ_ONLY"
                required_controls: [
                    "detection_first",
                    "bounded_remediation"
                ]
            }
        ]
    }

    test autonomy_level_validation {
        ; Verify: Autonomy levels are properly defined
        given policy = create_autonomy_policy()
        when validated = validate_autonomy_levels(policy.levels)
        then validated == true
        then all_levels_have_risk_assessment(validated.levels)
    }

    test agent_mode_assignment {
        ; Verify: Agent modes match appropriate autonomy levels
        given creator = create_agent("CREATOR")
        when assigned = assign_autonomy_level(creator)
        then assigned.level == "SAFE_BOUNDED"
        then assigned.required_controls == ["scope_contract", "acceptance_criteria"]
    }

    test approval_gate_enforcement {
        ; Verify: Approval gates are respected for sensitive actions
        given sensitive_action = create_sensitive_action()
        when attempted = attempt_action(sensitive_action)
        then attempted.requires_approval == true
        then attempted.blocked_without_approval == true
    }

    test risk_level_mapping {
        ; Verify: Risk levels are mapped correctly to actions
        given action = create_action()
        when assessed = assess_action_risk(action)
        then assessed.risk_level in ["low", "medium", "high", "unknown"]
        then assessed.approval_required == (assessed.risk_level in ["high", "unknown"])
    }

    test agent_mode_isolation {
        ; Verify: Agent modes have isolated responsibilities
        given modes = get_agent_modes()
        when checked = check_mode_isolation(modes)
        then checked.no_overlap == true
        then checked.all_risks_covered == true
    }

    autonomy_level_consistency {
        ; Autonomy levels must be ordered by risk
        assert forall levels: autonomy_levels,
            levels[0].risk_level <= levels[1].risk_level <= levels[2].risk_level
    }

    agent_mode_uniqueness {
        ; All agent modes must have unique purposes
        assert forall modes: agent_modes,
            unique(modes.purpose for modes in agent_modes)
    }

    rule approval_proportionality {
        ; Approval requirements must be proportional to risk
        expect forall action: autonomous_action,
            action.requires_approval == (action.risk_level > "medium")
    }

    autonomy_impact_bounds {
        ; Safe bounded actions must respect impact limits
        assert forall action: safe_bounded_action,
            action.max_impact in ["single_component", "service"] and
            action.max_duration <= "5m"
    }

    ; Bench for autonomy decision performance
    bench autonomy_decision_latency {
        ; Measure: Time to determine autonomy level for action
        target: < 5ms on typical hardware
        iterations: 1000
        setup: create_test_actions()
        measure: determine_autonomy_levels(setup)
    }
}