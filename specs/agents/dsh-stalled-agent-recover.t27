spec dsh_stalled_agent_recover {
    stalled_agent_recover_skill {
        ; T27_DSH_STALLED_AGENT_RECOVER:
        ; Detect stall, checkpoint, bounded restart as SAFE_BOUNDED skill
        ; Phase complete: Issue
        → Phase 2: Spec
        
        name: "dsh-stalled-agent-recover"
        purpose: "Detect stall, checkpoint, bounded restart"
        automation_level: "SAFE_BOUNDED"
        inputs: {
            agent_id: string
            stall_timeout: duration "5m"
            max_attempts: int 3
            checkpoint_path: string "/tmp/checkpoints/"
        }
        outputs: {
            recovery_result: agent_recovery {
                agent_id: string
                recovery_timestamp: datetime
                stall_detection: {
                    detected: bool
                    stall_duration: duration
                    stall_indicators: list<string> [
                        "tool_call_loop_exceeded",
                        "response_time_exceeded",
                        "task_stack_stagnant",
                        "memory_usage_unstable"
                    ]
                    stall_signature: string
                    confidence: float
                }
                checkpoint_created: {
                    success: bool
                    checkpoint_file: string
                    checkpoint_size: int
                    checksum: string
                    creation_time: datetime
                    validation_result: checkpoint_validation {
                        valid: bool
                        integrity_check: string
                        completeness_check: string
                    }
                }
                restart_attempted: {
                    attempted: bool
                    restart_time: datetime
                    restart_method: string "cold_restart|warm_restart|graceful_restart"
                    new_agent_id: string
                    status: "success|failed|partial"
                    error_details: string
                }
                recovery_metrics: {
                    total_time: duration
                    time_to_detect: duration
                    time_to_checkpoint: duration
                    time_to_restart: duration
                    attempts_made: int
                    final_status: "recovered|failed|manual_intervention"
                }
                evidence_collected: list<string> [
                    "pre_restart_logs.tar.gz",
                    "checkpoint_integrity_report.json",
                    "restart_execution_trace.jsonl"
                ]
                next_steps: list<string>
                rollback_info: {
                    available: bool
                    rollback_point: string
                    rollback_command: string
                }
            }
            exit_code: int
        }
        checks: [
            "stall_detected",
            "checkpoint_created",
            "restart_attempted"
        ]
        remediation: "internal_restart"
        max_attempts: 3
    }

    test_skill agent_id_validation {
        ; Verify: Agent ID is validated
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { agent_id: "" })
        then executed.exit_code == 400
        then executed.outputs.recovery_result.stall_detection.detected == false
        then executed.outputs.recovery_result.recovery_metrics.final_status == "failed"
    }

    test_skill stall_detection {
        ; Verify: Agent stall is detected correctly
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "stalled_agent_001",
            stall_timeout: "1m"
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.stall_detection.detected == true
        then executed.outputs.recovery_result.stall_detection.stall_duration > "0s"
        then executed.outputs.recovery_result.stall_detection.confidence > 0.5
    }

    test_skill checkpoint_creation {
        ; Verify: Checkpoint is created successfully
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "checkpoint_test_agent"
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.checkpoint_created.success == true
        then executed.outputs.recovery_result.checkpoint_created.checkpoint_file != ""
        then executed.outputs.recovery_result.checkpoint_created.validation_result.valid == true
    }

    test_skill bounded_restart {
        ; Verify: Bounded restart respects limits
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "restart_test_agent",
            max_attempts: 2
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.restart_attempted.attempted == true
        then executed.outputs.recovery_result.recovery_metrics.attempts_made <= 2
        then executed.outputs.recovery_result.recovery_metrics.final_status == "recovered"
    }

    test_skill timeout_handling {
        ; Verify: Timeout is respected during stall detection
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "slow_stall_agent",
            stall_timeout: "2s"
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.stall_detection.detected == true
        then executed.outputs.recovery_result.stall_detection.stall_duration < "5s"
    }

    test_skill checkpoint_validation {
        ; Verify: Checkpoint integrity is validated
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "checkpoint_validation_agent"
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.checkpoint_created.validation_result.valid == true
        then executed.outputs.recovery_result.checkpoint_created.validation_result.integrity_check contains "passed"
    }

    test_skill evidence_collection {
        ; Verify: Evidence is collected during recovery
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "evidence_collection_agent"
        })
        then executed.exit_code == 200
        then len(executed.outputs.recovery_result.evidence_collected) > 0
        then executed.outputs.recovery_result.evidence_collected[0] contains "logs"
        then len(executed.outputs.recovery_result.next_steps) > 0
    }

    test_skill rollback_availability {
        ; Verify: Rollback information is provided
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "rollback_test_agent"
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.rollback_info.available == true
        then executed.outputs.recovery_result.rollback_info.rollback_command != ""
    }

    test_skill max_attempts_enforcement {
        ; Verify: Max attempts are enforced
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "max_attempts_test_agent",
            max_attempts: 1
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.recovery_metrics.attempts_made == 1
        then executed.outputs.recovery_result.recovery_metrics.final_status in ["recovered", "failed"]
    }

    test_skill recovery_metrics_calculation {
        ; Verify: Recovery metrics are calculated correctly
        given recover = create_stalled_agent_recover_skill()
        when executed = execute_skill(recover, { 
            agent_id: "metrics_test_agent"
        })
        then executed.exit_code == 200
        then executed.outputs.recovery_result.recovery_metrics.total_time > "0s"
        then executed.outputs.recovery_result.recovery_metrics.time_to_detect > "0s"
        then executed.outputs.recovery_result.recovery_metrics.time_to_checkpoint > "0s"
        then executed.outputs.recovery_result.recovery_metrics.time_to_restart > "0s"
    }

    invariant recovery_schema_validity {
        ; Recovery result outputs must conform to schema
        assert forall recovery: agent_recovery,
            recovery.agent_id != "" and
            recovery.recovery_timestamp != "" and
            recovery.stall_detection.detected in [true, false] and
            recovery.checkpoint_created.success in [true, false] and
            recovery.restart_attempted.attempted in [true, false] and
            recovery.recovery_metrics.total_time > "0s" and
            recovery.recovery_metrics.final_status in ["recovered", "failed", "manual_intervention"]
    }

    invariant stall_detection_logic {
        ; Stall detection must be based on valid indicators
        assert forall detection: stall_detection,
            detection.detected implies (detection.stall_duration > "0s") and
            detection.confidence >= 0.0 and detection.confidence <= 1.0 and
            len(detection.stall_indicators) > 0
    }

    invariant checkpoint_integrity {
        ; Checkpoint creation must produce valid artifacts
        assert forall checkpoint: checkpoint_created,
            checkpoint.success implies (checkpoint.checkpoint_file != "" and
                                      checkpoint.checkpoint_size > 0 and
                                      checkpoint.checksum != "" and
                                      checkpoint.validation_result.valid == true)
    }

    invariant bounded_execution {
        ; Recovery must respect bounded execution constraints
        assert forall recovery: agent_recovery,
            recovery.recovery_metrics.attempts_made >= 0 and
            recovery.recovery_metrics.attempts_made <= 3 and
            recovery.recovery_metrics.total_time < "10m"
    }

    safety_constraint recovery_isolation {
        ; Recovery must not affect other agents
        assert forall recovery: agent_recovery,
            recovery.agent_id != "" and
            recovery.evidence_collected does not contain other_agents_data and
            recovery.restart_attempted.new_agent_id != recovery.agent_id or
            recovery.restart_attempted.status == "failed"
    }

    ; Bench for stalled agent recovery performance
    bench stalled_agent_recovery_latency {
        ; Measure: Time to complete stalled agent recovery
        target: < 30s on typical hardware
        iterations: 100
        setup: create_test_stalled_agent_environment()
        measure: execute_stalled_agent_recover_skill(setup)
    }
}