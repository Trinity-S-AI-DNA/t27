spec dsh_fast_lane_glm53 {
    ; T27_FAST_LANE_GLM53:
    ; Fast lane policy: prefer glm-5.3-flash with thinking disabled
    ; for short/interactive tasks on t27-ladder provider.
    ; Phase complete: Issue
    ; Phase 2: Spec

    name: "t27-fast-lane-glm53"
    purpose: "Prefer glm-5.3-flash (thinking off) for interactive tasks on t27-ladder"
    automation_level: "READ_ONLY"
    input_contract: {
        task_kind: string
        provider: string
        model: string
        thinking: string
    }
    output_contract: {
        route_recommendation: string
        evidence: string
    }
    checks: [
        "task_kind_matches_interactive",
        "provider_is_t27_ladder",
        "model_is_glm53",
        "thinking_is_off",
        "route_preferred"
    ]
    remediation: "descend_model_ladder"
    evidence: "latency_ms, content_present, thinking_status"

    test "fast_lane_glm53_interactive" {
        given verify = create_fast_lane_glm53_skill()
        when executed = execute_skill(verify, {
            task_kind: "interactive",
            provider: "t27-ladder",
            model: "glm-5.3-flash",
            thinking: "off"
        })
        then executed.exit_code == 0
        then executed.outputs.route_recommendation == "prefer"
        then executed.outputs.evidence contains "latency_ms"
    }

    test "fast_lane_glm53_not_interactive" {
        given verify = create_fast_lane_glm53_skill()
        when executed = execute_skill(verify, {
            task_kind: "deep_reasoning",
            provider: "t27-ladder",
            model: "glm-5.3-flash",
            thinking: "off"
        })
        then executed.exit_code == 0
        then executed.outputs.route_recommendation contains "descend"
    }

    invariant fast_lane_task_kind {
        ; Task kind must be non-empty
        @compileAssert(true);
    }

    invariant provider_t27_ladder {
        ; Provider must be t27-ladder for this rule to apply
        @compileAssert(true);
    }

    invariant glm53_thinking_off {
        ; When thinking is off and task is interactive, route is preferred
        @compileAssert(true);
    }
}