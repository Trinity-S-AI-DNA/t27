// specs/agents/session-handoff-create.t27
// The Doctor's last resort: the repair failed. The work is kept, a recovery
// task is created, and the owner is asked to decide.
//
// Owner: T27_SESSION_NEVER_DIES (issue #1409), 2026-10-30.
//
// OWNS:
//   - the completeness of a handoff (work, checkpoint, task, request)
//   - the rule that a handoff never drops the work
//   - the WRITE autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the recovery ladder levels and the handoff rung:
//     specs/system/session-recovery-ladder.t27
//   - the Doctor lifecycle states and the status bar:
//     specs/system/session-doctor.t27
//   - the checkpoint contract: specs/system/session-continuity.t27
//   - the follow-up task protocol of the provider gate:
//     specs/system/llm_request_provider_gate.t27

module session_handoff_create;

// ─── Autonomy ──────────────────────────────────────────────────────────────

pub const AUTONOMY_READ_ONLY : u8 = 0;
pub const AUTONOMY_EVIDENCE : u8 = 1;
pub const AUTONOMY_BOUNDED : u8 = 2;
pub const AUTONOMY_WRITE : u8 = 3;
pub const AUTONOMY_APPROVAL_GATED : u8 = 4;

// ─── Handoff completeness ──────────────────────────────────────────────────

pub const HANDOFF_WORK : u8 = 0;
pub const HANDOFF_CHECKPOINT : u8 = 1;
pub const HANDOFF_RECOVERY_TASK : u8 = 2;
pub const HANDOFF_OWNER_REQUEST : u8 = 3;
pub const HANDOFF_FIELD_COUNT : u32 = 4;

// ─── Owner decision ────────────────────────────────────────────────────────

pub const DECISION_PENDING : u8 = 0;
pub const DECISION_RESUME : u8 = 1;
pub const DECISION_ABANDON : u8 = 2;
pub const DECISION_COUNT : u32 = 3;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_autonomy() - the handoff writes a recovery task and a request.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_WRITE;
}

// skill_mutates_state(autonomy) -> bool
pub fn skill_mutates_state(autonomy: u8) -> bool {
    if (autonomy == AUTONOMY_READ_ONLY) {
        return false;
    }
    if (autonomy == AUTONOMY_EVIDENCE) {
        return false;
    }
    return true;
}

// handoff_is_complete(has_work, has_checkpoint, has_recovery_task, has_owner_request) -> bool
//
// A handoff without all four is a handoff that loses something.
pub fn handoff_is_complete(has_work: bool, has_checkpoint: bool, has_recovery_task: bool, has_owner_request: bool) -> bool {
    if (has_work == false) {
        return false;
    }
    if (has_checkpoint == false) {
        return false;
    }
    if (has_recovery_task == false) {
        return false;
    }
    if (has_owner_request == false) {
        return false;
    }
    return true;
}

// handoff_preserves_the_work(has_work) -> bool
pub fn handoff_preserves_the_work(has_work: bool) -> bool {
    return has_work;
}

// recovery_task_is_created(task_created) -> bool
pub fn recovery_task_is_created(task_created: bool) -> bool {
    return task_created;
}

// owner_decision_is_requested(requested) -> bool
// The owner is asked; the Doctor never decides the fate of the work itself.
pub fn owner_decision_is_requested(requested: bool) -> bool {
    return requested;
}

// handoff_resume_is_possible(has_checkpoint, decision) -> bool
// The work can only be resumed if the checkpoint survived and the owner said
// so.
pub fn handoff_resume_is_possible(has_checkpoint: bool, decision: u8) -> bool {
    if (has_checkpoint == false) {
        return false;
    }
    if (decision != DECISION_RESUME) {
        return false;
    }
    return true;
}

// handoff_is_never_silent(handoff_created, user_notified) -> bool
pub fn handoff_is_never_silent(handoff_created: bool, user_notified: bool) -> bool {
    if (handoff_created == false) {
        return true;
    }
    return user_notified;
}

// handoff_never_loses_the_evidence(has_evidence) -> bool
pub fn handoff_never_loses_the_evidence(has_evidence: bool) -> bool {
    return has_evidence;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_handoff_skill_writes_a_recovery_task" {
    assert(skill_autonomy() == AUTONOMY_WRITE);
    assert(skill_mutates_state(AUTONOMY_WRITE) == true);
}

test "a_handoff_carries_the_work_the_checkpoint_the_task_and_the_request" {
    assert(handoff_is_complete(true, true, true, true) == true);
    assert(handoff_is_complete(false, true, true, true) == false);
    assert(handoff_is_complete(true, false, true, true) == false);
    assert(handoff_is_complete(true, true, false, true) == false);
    assert(handoff_is_complete(true, true, true, false) == false);
}

test "a_handoff_never_drops_the_work" {
    assert(handoff_preserves_the_work(true) == true);
    assert(handoff_preserves_the_work(false) == false);
    assert(handoff_never_loses_the_evidence(false) == false);
}

test "the_recovery_task_is_created_and_the_owner_is_asked" {
    assert(recovery_task_is_created(true) == true);
    assert(owner_decision_is_requested(true) == true);
    assert(owner_decision_is_requested(false) == false);
}

test "the_resume_waits_for_the_owner_and_a_surviving_checkpoint" {
    assert(handoff_resume_is_possible(true, DECISION_RESUME) == true);
    assert(handoff_resume_is_possible(true, DECISION_PENDING) == false);
    assert(handoff_resume_is_possible(true, DECISION_ABANDON) == false);
    assert(handoff_resume_is_possible(false, DECISION_RESUME) == false);
}

test "a_handoff_is_never_silent" {
    assert(handoff_is_never_silent(true, false) == false);
    assert(handoff_is_never_silent(true, true) == true);
    assert(handoff_is_never_silent(false, false) == true);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant a_handoff_never_loses_the_work {
    handoff_preserves_the_work(false) == false;
    handoff_preserves_the_work(true) == true;
}

invariant a_handoff_always_asks_the_owner {
    owner_decision_is_requested(false) == false;
    owner_decision_is_requested(true) == true;
}

invariant a_resume_never_happens_without_a_checkpoint_and_a_decision {
    handoff_resume_is_possible(false, DECISION_RESUME) == false;
    handoff_resume_is_possible(true, DECISION_PENDING) == false;
    handoff_resume_is_possible(true, DECISION_RESUME) == true;
}

invariant a_handoff_is_always_visible {
    handoff_is_never_silent(true, false) == false;
    handoff_is_never_silent(true, true) == true;
}
