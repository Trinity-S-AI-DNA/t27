spec dsh_service_noise_1305 {
    ; T27_SERVICE_NOISE_1305:
    ; Classify glm-4.7-flash response 1305 as service noise,
    ; not presentable content. Follow-up: retry via ladder policy
    ; or descend model ladder.
    ; Phase complete: Issue
    ; Phase 2: Spec

    name: "t27-service-noise-1305"
    purpose: "Classify 1305 responses from glm-4.7-flash as service noise"
    automation_level: "READ_ONLY"
    input_contract: {
        provider: string
        model: string
        response_marker: string
        exit_code: i32
    }
    output_contract: {
        classification: string
        action: string
        follow_up: string
    }
    checks: [
        "provider_is_t27_ladder",
        "model_is_glm47",
        "response_marker_is_1305",
        "exit_code_matches_1305",
        "classification_valid"
    ]
    remediation: "retry_via_ladder_policy_or_descend"
    evidence: "exit_code, response_marker, classification_reason"

    test "service_noise_1305_detected" {
        given verify = create_service_noise_1305_skill()
        when executed = execute_skill(verify, {
            provider: "t27-ladder",
            model: "glm-4.7-flash",
            response_marker: "1305",
            exit_code: 1305
        })
        then executed.exit_code == 0
        then executed.outputs.classification == "service_noise"
        then executed.outputs.action == "do_not_present_as_content"
        then executed.outputs.follow_up == "retry_via_ladder_policy_or_descend"
    }

    test "service_noise_not_1305" {
        given verify = create_service_noise_1305_skill()
        when executed = execute_skill(verify, {
            provider: "t27-ladder",
            model: "glm-4.7-flash",
            response_marker: "200",
            exit_code: 200
        })
        then executed.exit_code == 0
        then executed.outputs.classification != "service_noise"
    }

    invariant provider_t27_ladder {
        ; Provider must be t27-ladder
        @compileAssert(true);
    }

    invariant glm47_marker_1305 {
        ; glm-4.7-flash with 1305 marker = service noise
        @compileAssert(true);
    }

    invariant exit_code_consistency {
        ; exit_code must match response_marker for classification
        @compileAssert(true);
    }
}