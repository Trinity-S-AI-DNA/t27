spec dsh_goal_contract {
    goal {
        ; T27_GOAL_CONTRACT:
        ; Defines a machine-checkable goal contract for DSH agent operations
        ; Phase complete: Issue
        → Phase 2: Spec
        
        stable_id: string "goal_001"
        objective: string "Implement Creator/Goal manager/System healer/Proactive automator operating model"
        scope: list<string> [
            "specs/agents/",
            "docs/agents/",
            "gen/agents/"
        ]
        non_goals: list<string> [
            "Implement full self-healing without approval gates",
            "Add new programming languages to critical path"
        ]
        success_criteria: list<string> [
            "Four distinct agent modes implemented",
            "Health SLOs defined and measurable",
            "Bounded autonomy with approval gates",
            "All recovery procedures as .t27 skills",
            "Proactive health loop operational"
        ]
        evidence_required: list<string> [
            "Generated code compiles",
            "Tests pass",
            "Health signals captured",
            "Rollback targets defined"
        ]
        rollback_target: string "main@2024-01-01"
        owner: string "lead"
        status: string "draft"
    }

    test goal_contract_validation {
        ; Verify: Goal contract has all required fields
        given contract = create_goal_contract(
            objective = "Test objective",
            scope = ["test/"],
            success_criteria = ["test passes"]
        )
        when validated = validate_goal_contract(contract)
        then validated == true
    }

    test goal_scope_enforcement {
        ; Verify: Scope is properly enforced
        given contract = create_goal_contract(
            objective = "Test objective",
            scope = ["test/"],
            success_criteria = ["test passes"]
        )
        when attempt = attempt_write_outside_scope(contract, "unauthorized/path/")
        then attempt.failed == true
    }

    test goal_status_transitions {
        ; Verify: Status transitions follow state machine
        given contract = create_goal_contract(
            objective = "Test objective",
            scope = ["test/"],
            success_criteria = ["test passes"]
        )
        when transitioned = transition_goal_status(contract, "active")
        then transitioned.status == "active"
        
        when verified = transition_goal_status(contract, "verification")
        then verified.status == "verification"
        
        when completed = transition_goal_status(contract, "complete")
        then completed.status == "complete"
    }

    invariant goal_id_stability {
        ; All goal IDs must be stable and immutable
        assert forall contract: goal_contract, 
            contract.stable_id != "" and 
            hash(contract.stable_id) == 32
    }

    invariant scope_non_empty {
        ; All goals must have non-empty scope definition
        assert forall contract: goal_contract, 
            len(contract.scope) > 0
    }

    rule objective_measurable {
        ; All objectives must be measurable outcomes
        expect forall contract: goal_contract,
            contains_measurable_verb(contract.objective)
    }

    ; Bench for goal contract performance
    bench goal_creation_latency {
        ; Measure: Time to create and validate goal contract
        target: < 100ms on typical hardware
        iterations: 100
        setup: create_random_objective()
        measure: create_and_validate_goal_contract(setup)
    }
}