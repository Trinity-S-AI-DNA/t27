spec dsh_evidence_collector {
    evidence_collector {
        ; T27_EVIDENCE_COLLECTOR:
        ; Collects, validates, and manages evidence for goal achievement
        ; Phase complete: Issue
        → Phase 2: Spec
        
        evidence_types: list<evidence_type> [
            {
                type_id: "EVIDENCE_TYPE_HEALTH_SIGNALS"
                name: "Health Signal Collection"
                description: "Collected health signals and metrics"
                schema: "dsh_health_signal_schema.t27"
                required_for: ["T27_DSH_HEALTH_01"]
                validation_method: "signal_validator"
                retention_policy: "until_phase_complete"
            },
            {
                type_id: "EVIDENCE_TYPE_ROUTE_VERIFICATION"
                name: "Route Verification Results"
                description: "Provider route verification outcomes"
                schema: "dsh_route_verification_schema.t27"
                required_for: ["T27_DSH_HEALTH_01"]
                validation_method: "route_validator"
                retention_policy: "until_phase_complete"
            },
            {
                type_id: "EVIDENCE_TYPE_ARTIFACTS"
                name: "Evidence Artifacts"
                description: "Generated evidence artifacts"
                schema: "dsh_evidence_artifact_schema.t27"
                required_for: ["T27_DSH_HEALTH_01"]
                validation_method: "artifact_validator"
                retention_policy: "permanent"
            },
            {
                type_id: "EVIDENCE_TYPE_TESTS"
                name: "Test Results"
                description: "Automated and manual test results"
                schema: "dsh_test_result_schema.t27"
                required_for: ["T27_DSH_HEALTH_01"]
                validation_method: "test_validator"
                retention_policy: "until_phase_complete"
            },
            {
                type_id: "EVIDENCE_TYPE_PERFORMANCE"
                name: "Performance Metrics"
                description: "Performance benchmark results"
                schema: "dsh_performance_schema.t27"
                required_for: ["T27_DSH_HEALTH_01"]
                validation_method: "performance_validator"
                retention_policy: "until_phase_complete"
            }
        ]
        
        evidence_registry: list<evidence_record> [
            {
                evidence_id: "EVIDENCE_001"
                type: "EVIDENCE_TYPE_HEALTH_SIGNALS"
                goal_id: "T27_DSH_HEALTH_01"
                milestone_id: "MILESTONE_01"
                collection_timestamp: string ""
                file_path: "evidence/health_signals_20261030.json"
                checksum: string ""
                status: string "pending"
                validation_status: string "not_validated"
                collector: string "dsh_health_signal_collector"
                metadata: {
                    signal_count: 0,
                    error_count: 0,
                    collection_duration: 0,
                    signals: []
                }
            },
            {
                evidence_id: "EVIDENCE_002"
                type: "EVIDENCE_TYPE_ROUTE_VERIFICATION"
                goal_id: "T27_DSH_HEALTH_01"
                milestone_id: "MILESTONE_02"
                collection_timestamp: string ""
                file_path: "evidence/route_verification_20261030.json"
                checksum: string ""
                status: string "pending"
                validation_status: string "not_validated"
                collector: string "dsh_route_verifier"
                metadata: {
                    route_count: 0,
                    verification_count: 0,
                    unfunded_count: 0,
                    verification_latency: 0
                }
            },
            {
                evidence_id: "EVIDENCE_003"
                type: "EVIDENCE_TYPE_ARTIFACTS"
                goal_id: "T27_DSH_HEALTH_01"
                milestone_id: "MILESTONE_03"
                collection_timestamp: string ""
                file_path: "evidence/artifacts_20261030.tar.gz"
                checksum: string ""
                status: string "pending"
                validation_status: string "not_validated"
                collector: string "dsh_artifact_generator"
                metadata: {
                    artifact_count: 0,
                    total_size: 0,
                    compression_ratio: 0,
                    artifact_types: []
                }
            }
        ]
        
        collection_pipeline: list<collection_step> [
            {
                step_id: "STEP_01"
                name: "Health Signal Collection"
                evidence_type: "EVIDENCE_TYPE_HEALTH_SIGNALS"
                enabled: true
                schedule: "cron */5 * * * *"
                retention_hours: 168
                validation_required: true
            },
            {
                step_id: "STEP_02"
                name: "Route Verification"
                evidence_type: "EVIDENCE_TYPE_ROUTE_VERIFICATION"
                enabled: true
                schedule: "cron */10 * * * *"
                retention_hours: 168
                validation_required: true
            },
            {
                step_id: "STEP_03"
                name: "Artifact Generation"
                evidence_type: "EVIDENCE_TYPE_ARTIFACTS"
                enabled: true
                schedule: "cron 0 2 * * *"
                retention_hours: 720
                validation_required: true
            }
        ]
        
        validation_rules: list<validation_rule> [
            {
                rule_id: "RULE_01"
                evidence_type: "EVIDENCE_TYPE_HEALTH_SIGNALS"
                criteria: [
                    {
                        criterion: "signal_completeness"
                        operator: "gte"
                        value: 95.0
                        unit: "percent"
                    },
                    {
                        criterion: "error_rate"
                        operator: "lte"
                        value: 0.0
                        unit: "percent"
                    }
                ]
            },
            {
                rule_id: "RULE_02"
                evidence_type: "EVIDENCE_TYPE_ROUTE_VERIFICATION"
                criteria: [
                    {
                        criterion: "verification_accuracy"
                        operator: "gte"
                        value: 100.0
                        unit: "percent"
                    },
                    {
                        criterion: "latency"
                        operator: "lte"
                        value: 100.0
                        unit: "milliseconds"
                    }
                ]
            },
            {
                rule_id: "RULE_03"
                evidence_type: "EVIDENCE_TYPE_ARTIFACTS"
                criteria: [
                    {
                        criterion: "artifact_completeness"
                        operator: "gte"
                        value: 100.0
                        unit: "percent"
                    },
                    {
                        criterion: "traceability"
                        operator: "eq"
                        value: true
                        unit: "boolean"
                    }
                ]
            }
        ]
    }

    test evidence_collection {
        ; Verify: Evidence collection works correctly
        given collector = create_evidence_collector()
        when evidence = collector.evidence_registry[0]
        then evidence.evidence_id == "EVIDENCE_001"
        then evidence.type == "EVIDENCE_TYPE_HEALTH_SIGNALS"
        then evidence.status == "pending"
    }

    test evidence_type_definition {
        ; Verify: Evidence types are properly defined
        given collector = create_evidence_collector()
        when type = collector.evidence_types[0]
        then type.type_id == "EVIDENCE_TYPE_HEALTH_SIGNALS"
        then len(type.schema) > 0
        then len(type.required_for) > 0
    }

    test collection_pipeline {
        ; Verify: Collection pipeline is correctly configured
        given collector = create_evidence_collector()
        when step = collector.collection_pipeline[0]
        then step.step_id == "STEP_01"
        then step.enabled == true
        then step.validation_required == true
    }

    test evidence_validation {
        ; Verify: Evidence validation works correctly
        given collector = create_evidence_collector()
        when rule = collector.validation_rules[0]
        when result = validate_evidence(rule, {
            "signal_completeness": 98.0,
            "error_rate": 0.0
        })
        then result.valid == true
        then result.score == 100.0
    }

    test evidence_checksum_verification {
        ; Verify: Evidence checksum verification works correctly
        given collector = create_evidence_collector()
        when evidence = collector.evidence_registry[0]
        when calculated = calculate_checksum(evidence.file_path)
        when verified = verify_checksum(evidence.checksum, calculated)
        then verified == true
    }

    test retention_policy_enforcement {
        ; Verify: Retention policies are enforced correctly
        given collector = create_evidence_collector()
        when evidence = collector.evidence_registry[0]
        when expired = is_expired(evidence, current_timestamp())
        then expired == false
        then evidence.status == "active"
    }

    test evidence_linking {
        ; Verify: Evidence can be linked to goals and milestones
        given collector = create_evidence_collector()
        when evidence = collector.evidence_registry[0]
        when linked = link_evidence_to_goal(evidence, "T27_DSH_HEALTH_01")
        then linked.goal_id == "T27_DSH_HEALTH_01"
        then linked.milestone_id != ""
    }

    test validation_rule_application {
        ; Verify: Validation rules are applied correctly
        given collector = create_evidence_collector()
        when rule = collector.validation_rules[0]
        when results = apply_validation_rule(rule, evidence_data)
        then len(results.criteria_results) == len(rule.criteria)
        then results.overall_valid == true
    }

    test evidence_integrity {
        ; Verify: Evidence integrity is maintained
        given collector = create_evidence_collector()
        when evidence = collector.evidence_registry[0]
        when tampered = detect_tampering(evidence)
        then tampered == false
        then evidence.status == "valid"
    }

    test collection_scheduling {
        ; Verify: Evidence collection scheduling works correctly
        given collector = create_evidence_collector()
        when step = collector.collection_pipeline[0]
        when scheduled = verify_scheduling(step)
        then scheduled == true
        then next_execution_time(step) != ""
    }

    invariant evidence_uniqueness {
        ; All evidence IDs must be unique
        assert forall evidence: evidence_record,
            unique(evidence.evidence_id for evidence in evidence_registry)
    }

    invariant type_schema_consistency {
        ; All evidence types must have valid schemas
        assert forall type: evidence_type,
            len(type.schema) > 0 and
            type.schema.endswith(".t27")
    }

    invariant validation_rule_completeness {
        ; All validation rules must cover all required criteria
        assert forall rule: validation_rule,
            len(rule.criteria) > 0 and
            all(criteria has required field for criteria in rule.criteria)
    }

    invariant evidence_status_validity {
        ; All evidence statuses must be valid
        assert forall evidence: evidence_record,
            evidence.status in ["pending", "collecting", "collected", "valid", "invalid", "expired"]
    }

    rule evidence_retention {
        ; Evidence must be retained according to policy
        expect forall evidence: evidence_record,
            if evidence.status == "expired" then
                evidence.age > evidence.retention_policy_hours
    }

    rule validation_completeness {
        ; All validation rules must be applicable to their evidence types
        expect forall rule: validation_rule,
            exists type: evidence_type where 
                type.type_id == rule.evidence_type and
                rule.criteria applicable to type.schema
    }

    rule collection_frequency {
        ; Evidence collection must follow configured schedules
        expect forall step: collection_step,
            step.schedule is valid cron expression and
            step.schedule matches required collection frequency
    }

    ; Bench for evidence collection performance
    bench evidence_collection_latency {
        ; Measure: Time to collect and store evidence
        target: < 100ms on typical hardware
        iterations: 1000
        setup: create_evidence_collection_scenarios()
        measure: collect_evidence(setup)
    }

    bench evidence_validation_latency {
        ; Measure: Time to validate evidence against rules
        target: < 50ms on typical hardware
        iterations: 1000
        setup: create_evidence_validation_scenarios()
        measure: validate_evidence_batch(setup)
    }
}