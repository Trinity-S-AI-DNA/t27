spec dsh_provider_route_verify {
    provider_route_verify_skill {
        ; T27_DSH_PROVIDER_ROUTE_VERIFY:
        ; Check route, credentials, funding, guard as READ_ONLY skill
        ; Phase complete: Issue
        → Phase 2: Spec
        
        name: "dsh-provider-route-verify"
        purpose: "Check route, credentials, funding, guard"
        automation_level: "READ_ONLY"
        inputs: {
            route_name: string
            expected_status: string "active|inactive|error"
        }
        outputs: {
            verification_result: route_verification {
                route_name: string
                timestamp: datetime
                checks: list<route_check> [
                    {
                        name: "route_exists"
                        status: "pass|fail|unknown"
                        details: string
                        latency: duration
                    },
                    {
                        name: "credentials_valid"
                        status: "pass|fail|unknown"
                        details: string
                        latency: duration
                    },
                    {
                        name: "funding_sufficient"
                        status: "pass|fail|unknown"
                        details: string
                        latency: duration
                    },
                    {
                        name: "guard_approved"
                        status: "pass|fail|unknown"
                        details: string
                        latency: duration
                    }
                ]
                overall_status: "pass|fail|unknown"
                funding_status: {
                    current: float
                    required: float
                    sufficient: bool
                    currency: string
                }
                error_details: list<route_error> [
                    {
                        type: string
                        message: string
                        severity: "low|medium|high|critical"
                        affected_component: string
                    }
                ]
                recommendation: string
            }
            exit_code: int
        }
        checks: [
            "route_exists",
            "credentials_valid", 
            "funding_sufficient",
            "guard_approved"
        ]
        remediation: "dsh-route-recovery"
    }

    test_skill route_name_validation {
        ; Verify: Route name is validated
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { route_name: "" })
        then executed.exit_code == 400
        then executed.outputs.verification_result.overall_status == "unknown"
        then executed.outputs.verification_result.recommendation contains "invalid route name"
    }

    test_skill route_existence_check {
        ; Verify: Route existence is detected correctly
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { 
            route_name: "nonexistent_route"
        })
        then executed.exit_code == 404
        then executed.outputs.verification_result.checks[0].status == "fail"
        then executed.outputs.verification_result.checks[0].details contains "not found"
    }

    test_skill credential_validation {
        ; Verify: Invalid credentials are detected
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { 
            route_name: "invalid_creds_route"
        })
        then executed.exit_code == 401
        then executed.outputs.verification_result.checks[1].status == "fail"
        then executed.outputs.verification_result.checks[1].details contains "invalid credentials"
    }

    test_skill funding_sufficiency {
        ; Verify: Funding status is calculated correctly
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { 
            route_name: "low_funding_route"
        })
        then executed.exit_code == 402
        then executed.outputs.verification_result.checks[2].status == "fail"
        then executed.outputs.verification_result.funding_status.sufficient == false
        then executed.outputs.verification_result.funding_status.current < executed.outputs.verification_result.funding_status.required
    }

    test_skill guard_approval {
        ; Verify: Guard violations are detected
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { 
            route_name: "guard_violation_route"
        })
        then executed.exit_code == 403
        then executed.outputs.verification_result.checks[3].status == "fail"
        then executed.outputs.verification_result.checks[3].details contains "guard rejection"
    }

    test_skill expected_status_matching {
        ; Verify: Expected status matching works
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { 
            route_name: "active_route",
            expected_status: "active"
        })
        then executed.exit_code == 0
        then executed.outputs.verification_result.overall_status == "pass"
        then executed.outputs.verification_result.recommendation contains "route is active as expected"
    }

    test_skill error_severity_classification {
        ; Verify: Error severity is classified correctly
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { 
            route_name: "critical_error_route"
        })
        then executed.exit_code == 500
        then len(executed.outputs.verification_result.error_details) > 0
        then executed.outputs.verification_result.error_details[0].severity == "critical"
        then executed.outputs.verification_result.overall_status == "fail"
    }

    test_skill detailed_error_reporting {
        ; Verify: Detailed error information is provided
        given verify = create_provider_route_verify_skill()
        when executed = execute_skill(verify, { 
            route_name: "multi_error_route"
        })
        then executed.exit_code == 400
        then len(executed.outputs.verification_result.error_details) >= 2
        then executed.outputs.verification_result.recommendation contains "review error details"
    }

    invariant verification_schema_validity {
        ; Route verification outputs must conform to schema
        assert forall verify_result: verification_result,
            verify_result.route_name != "" and
            verify_result.timestamp != "" and
            len(verify_result.checks) == 4 and
            verify_result.overall_status in ["pass", "fail", "unknown"] and
            verify_result.funding_status.exists and
            verify_result.funding_status.current >= 0 and
            verify_result.funding_status.required > 0
    }

    invariant check_status_consistency {
        ; Check status must be consistent with details
        assert forall check: route_check,
            check.status in ["pass", "fail", "unknown"] and
            (check.status == "pass" implies check.details contains "success") and
            (check.status == "fail" implies check.details contains "failed" or "error")
    }

    invariant error_severity_levels {
        ; Error severity must be valid
        assert forall error: route_error,
            error.severity in ["low", "medium", "high", "critical"] and
            error.type != "" and
            error.message != "" and
            error.affected_component != ""
    }

    invariant recommendation_logic {
        ; Recommendations must be based on verification results
        assert forall verify_result: verification_result,
            if verify_result.overall_status == "pass" then 
                verify_result.recommendation contains "route is healthy"
            else if verify_result.overall_status == "fail" then
                verify_result.recommendation contains "action required"
            else 
                verify_result.recommendation contains "investigate"
    }

    ; Bench for route verification performance
    bench route_verify_latency {
        ; Measure: Time to complete route verification
        target: < 50ms on typical hardware
        iterations: 1000
        setup: create_test_provider_environment()
        measure: execute_provider_route_verify_skill(setup)
    }
}