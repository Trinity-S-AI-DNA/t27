spec dsh_health_skills {
    health_skills {
        ; T27_HEALTH_SKILLS:
        ; Defines health check and recovery skills as .t27 specifications
        ; Phase complete: Issue
        → Phase 2: Spec
        
        skills: list<health_skill> [
            {
                name: "dsh-health-snapshot"
                purpose: "Collect provider/agent/session/guard health"
                automation_level: "READ_ONLY"
                inputs: {
                    session_id: string
                    dimensions: list<string>
                    timeout: duration
                }
                outputs: {
                    health_report: health_snapshot
                    exit_code: int
                }
                checks: [
                    "provider_routes_accessible",
                    "agent_tasks_active", 
                    "session_integrity",
                    "guard_violations_zero"
                ]
                remediation: "none"
            },
            {
                name: "dsh-provider-route-verify"
                purpose: "Check route, credentials, funding, guard"
                automation_level: "READ_ONLY"
                inputs: {
                    route_name: string
                    expected_status: string
                }
                outputs: {
                    verification_result: route_verification
                    exit_code: int
                }
                checks: [
                    "route_exists",
                    "credentials_valid", 
                    "funding_sufficient",
                    "guard_approved"
                ]
                remediation: "dsh-route-recovery"
            },
            {
                name: "dsh-session-recovery-verify"
                purpose: "Verify checkpoint/resume integrity"
                automation_level: "READ_ONLY"
                inputs: {
                    checkpoint_path: string
                    session_data: session_snapshot
                }
                outputs: {
                    recovery_status: session_recovery
                    exit_code: int
                }
                checks: [
                    "checkpoint_valid",
                    "resume_successful",
                    "state_consistent"
                ]
                remediation: "dsh-session-recovery"
            },
            {
                name: "dsh-release-gate-verify"
                purpose: "Check tests, invariants, artifact, rollback"
                automation_level: "READ_ONLY"
                inputs: {
                    release_candidate: string
                    baseline_artifact: string
                }
                outputs: {
                    gate_status: release_gate
                    exit_code: int
                }
                checks: [
                    "tests_pass",
                    "invariants_hold",
                    "artifact_checksum_match",
                    "rollback_target_available"
                ]
                remediation: "none"
            },
            {
                name: "dsh-stalled-agent-recover"
                purpose: "Detect stall, checkpoint, bounded restart"
                automation_level: "SAFE_BOUNDED"
                inputs: {
                    agent_id: string
                    stall_timeout: duration
                }
                outputs: {
                    recovery_result: agent_recovery
                    exit_code: int
                }
                checks: [
                    "stall_detected",
                    "checkpoint_created",
                    "restart_attempted"
                ]
                remediation: "internal_restart"
                max_attempts: 3
            },
            {
                name: "dsh-provider-unfunded-quarantine"
                purpose: "Isolate unfunded route, no retry"
                automation_level: "SAFE_BOUNDED"
                inputs: {
                    route_id: string
                    quarantine_reason: string
                }
                outputs: {
                    quarantine_status: route_quarantine
                    exit_code: int
                }
                checks: [
                    "route_funded",
                    "isolation_completed"
                ]
                remediation: "route_isolation"
                max_attempts: 1
            },
            {
                name: "dsh-config-drift-verify"
                purpose: "Compare effective config with declared baseline"
                automation_level: "READ_ONLY"
                inputs: {
                    effective_config: config_map
                    declared_baseline: config_map
                }
                outputs: {
                    drift_result: config_drift
                    exit_code: int
                }
                checks: [
                    "config_equals_baseline",
                    "no_unauthorized_changes"
                ]
                remediation: "config_revert"
            },
            {
                name: "dsh-incident-evidence-pack"
                purpose: "Collect commands, logs, exit codes, timeline"
                automation_level: "READ_ONLY"
                inputs: {
                    incident_id: string
                    time_range: time_range
                }
                outputs: {
                    evidence_package: incident_evidence
                    exit_code: int
                }
                checks: [
                    "evidence_complete",
                    "timeline_consistent"
                ]
                remediation: "none"
            }
        ]
    }

    test_skill skill_contract_validation {
        ; Verify: Health skills meet contract requirements
        given skills = create_health_skills()
        when validated = validate_skill_contracts(skills)
        then validated.all_contracts_valid == true
    }

    test_skill automation_level_enforcement {
        ; Verify: Automation levels are respected
        given skill = create_test_skill("READ_ONLY")
        when attempted = attempt_write_action(skill)
        then attempted.blocked == true
        then attempted.level_violation == true
    }

    test_skill exit_code_semantics {
        ; Verify: Exit codes follow contract semantics
        given skill = create_test_skill()
        when executed = execute_skill(skill)
        then (executed.exit_code == 0) == (executed.success == true)
    }

    test_skill idempotency_check {
        ; Verify: Skills are idempotent when safe
        given skill = create_idempotent_skill()
        when result1 = execute_skill(skill)
        when result2 = execute_skill(skill)
        then result1 == result2
    }

    test_skill bounded_retry {
        ; Verify: Bounded skills respect retry limits
        given skill = create_bounded_skill(3)
        when results = execute_multiple_times(skill, 5)
        then len(results) == 3
        then results[2].final_attempt == true
    }

    skill_contract_integrity {
        ; All skills must meet T27 skill contract
        assert forall skill: health_skill,
            skill.name != "" and
            skill.purpose != "" and
            skill.automation_level in ["READ_ONLY", "SAFE_BOUNDED", "SENSITIVE"] and
            len(skill.inputs) > 0 and
            skill.outputs.exit_code exists
    }

    skill_remediation_isolation {
        ; Remediation skills must be separate from detection
        assert forall skill: health_skill,
            if skill.remediation != "none" then
                exists separate_remediation_skill(skill.remediation)
    }

    skill_readonly_purity {
        ; READ_ONLY skills must have no side effects
        assert forall skill: health_skill,
            if skill.automation_level == "READ_ONLY" then
                skill.side_effects == []
    }

    ; Bench for skill execution performance
    bench skill_execution_latency {
        ; Measure: Time to execute health skills
        target: < 100ms on typical hardware
        iterations: 1000
        setup: create_test_skills()
        measure: execute_health_skills(setup)
    }
}