spec dsh_failure_drills {
    failure_drills {
        ; T27_FAILURE_DRILLS:
        ; Defines chaos engineering tests for DSH agent failure modes
        ; Phase complete: Issue
        → Phase 2: Spec
        
        drills: list<failure_drill> [
            {
                name: "provider_mismatch_drill"
                failure_mode: "Provider API returns unexpected format"
                trigger: "mock_provider_returns_invalid_json()"
                detection: "health_signal.route_error_rate > threshold"
                recovery: "provider_route_verification + quarantine"
                success_criteria: [
                    "error_rate_normalizes_within_5m",
                    "no_data_loss",
                    "graceful_degradation"
                ]
                blast_radius: "affected_routes_only"
                max_duration: "10m"
            },
            {
                name: "provider_unfunded_drill"
                failure_mode: "Provider funding exhausted"
                trigger: "mock_provider_funding_exhausted()"
                detection: "health_signal.funder_warnings > threshold"
                recovery: "route_quarantine + funding_alert"
                success_criteria: [
                    "no_unauthorized_retry",
                    "owner_notified_within_1m",
                    "alternative_providers_evaluated"
                ]
                blast_radius: "dependent_services"
                max_duration: "15m"
            },
            {
                name: "stream_idle_timeout_drill"
                failure_mode: "Stream connection times out"
                trigger: "mock_stream_timeout()"
                detection: "health_signal.stalled_streams > threshold"
                recovery: "stream_restart + checkpoint_restore"
                success_criteria: [
                    "stream_restored_within_30s",
                    "state_preserved",
                    "no_duplicate_processing"
                ]
                blast_radius: "single_session"
                max_duration: "2m"
            },
            {
                name: "stalled_agent_drill"
                failure_mode: "Agent enters infinite loop"
                trigger: "mock_agent_infinite_loop()"
                detection: "health_signal.tool_loop_count > limit"
                recovery: "agent_restart + task_reassignment"
                success_criteria: [
                    "agent_responsive_within_1m",
                    "no_task_loss",
                    "loop_detected_and_logged"
                ]
                blast_radius: "single_agent"
                max_duration: "5m"
            },
            {
                name: "checkpoint_corruption_drill"
                failure_mode: "Checkpoint file corrupted"
                trigger: "corrupt_checkpoint_file()"
                detection: "health_signal.checkpoint_validation_fails"
                recovery: "restore_from_previous + recreate_checkpoint"
                success_criteria: [
                    "session_restored",
                    "data_integrity_verified",
                    "failure_reported"
                ]
                blast_radius: "affected_session"
                max_duration: "3m"
            },
            {
                name: "config_drift_drill"
                failure_mode: "Configuration drift from baseline"
                trigger: "modify_config_file()"
                detection: "health_signal.config_drift_detected"
                recovery: "config_revert + alert_admin"
                success_criteria: [
                    "config_restored_within_1m",
                    "root_cause_identified",
                    "preventative_controls_added"
                ]
                blast_radius: "service_configuration"
                max_duration: "5m"
            },
            {
                name: "failed_remediation_drill"
                failure_mode: "Remediation action fails repeatedly"
                trigger: "mock_remediation_failure()"
                detection: "health_signal.remediation_attempts_exceeded"
                recovery: "escalate_to_human + preserve_evidence"
                success_criteria: [
                    "escalation_occurred",
                    "evidence_preserved",
                    "manual_intervention_triggered"
                ]
                blast_radius: "failed_component"
                max_duration: "10m"
            },
            {
                name: "rollback_after_bad_release_drill"
                failure_mode: "New release causes system degradation"
                trigger: "deploy_broken_release()"
                detection: "health_signal.release_health_drops"
                recovery: "rollback_to_previous_release"
                success_criteria: [
                    "rollback_successful_within_2m",
                    "service_restored",
                    "post_mortem_triggered"
                ]
                blast_radius: "released_service"
                max_duration: "5m"
            },
            {
                name: "prompt_injection_drill"
                failure_mode: "Prompt injection through tool result"
                trigger: "inject_prompt_in_tool_result()"
                detection: "health_signal.unexpected_output_patterns"
                recovery: "session_reset + input_validation"
                success_criteria: [
                    "injection_detected",
                    "session_cleaned",
                    "validation_added"
                ]
                blast_radius: "affected_sessions"
                max_duration: "1m"
            }
        ]
        
        drill_execution {
            schedule: "weekly"
            chaos_injection: "automated"
            success_threshold: 95%
            blast_radius_controls: "always_limited"
            rollback_guaranteed: true
            human_overwatch: true
        }
    }

    test drill_execution {
        ; Verify: Failure drills execute correctly
        given drill = select_drill("provider_mismatch_drill")
        when executed = execute_chaos_drill(drill)
        then executed.trigger_applied == true
        then executed.detection_occurred == true
        then executed.recovery_successful == true
        then executed.blast_radius_respected == true
    }

    test blast_radius_control {
        ; Verify: Blast radius is limited during drills
        given drill = select_drill("stalled_agent_drill")
        when executed = execute_drill_with_monitoring(drill)
        then affected_components = executed.affected_components
        then len(affected_components) == 1
        then affected_components[0] == "single_agent"
    }

    test recovery_verification {
        ; Verify: Recovery meets success criteria
        given drill = select_drill("rollback_after_bad_release_drill")
        when executed = execute_drill(drill)
        when criteria = check_success_criteria(executed)
        then criteria.all_met == true
        then criteria.within_duration == true
    }

    test detection_accuracy {
        ; Verify: Failures are detected correctly
        given drill = select_drill("config_drift_drill")
        when injected = inject_failure(drill)
        when detected = detect_failure(drill)
        then detected.success == true
        then detected.latency < "30s"
    }

    test graceful_degradation {
        ; Verify: System maintains functionality during drills
        given drill = select_drill("provider_unfunded_drill")
        when executed = execute_drill(drill)
        when service = measure_service_quality(executed)
        then service.available == true
        then service.performance_degraded < 50%
    }

    drill_completeness {
        ; All critical failure modes must have drills
        assert forall critical_mode: critical_failure_modes,
            exists drill in drills where drill.failure_mode == critical_mode
    }

    drill_isolation {
        ; Drills must not interfere with each other
        assert forall drill1, drill2: distinct_drills,
            execute(drill1) does not affect drill2
    }

    recovery_guarantee {
        ; All drills must have guaranteed recovery
        assert forall drill: failure_drill,
            drill.recovery != "" and
            drill.success_criteria.len > 0 and
            drill.max_duration > "0s"
    }

    chaos_safety {
        ; Chaos injection must be controlled and reversible
        assert forall drill: failure_drill,
            drill.blast_radius != "system" and
            drill.rollback_guaranteed == true
    }

    ; Bench for drill execution performance
    bench drill_execution_latency {
        ; Measure: Time to execute complete drill cycle
        target: < drill.max_duration on typical hardware
        iterations: 10
        setup: create_drill_environment()
        measure: execute_full_drill_cycle(setup)
    }
}