spec dsh_health_model {
    health_model {
        ; T27_HEALTH_MODEL:
        ; Defines measurable health dimensions for DSH agent operations
        ; Phase complete: Issue
        → Phase 2: Spec
        
        dimensions: list<health_dimension> [
            {
                name: "provider_health"
                signal: "error_rate, latency, unfunded_responses"
                healthy_criterion: "No unfunded route in critical path"
                slo: { target: 99.9, window: "1h" }
            },
            {
                name: "agent_health" 
                signal: "stalled_tasks, repeated_tool_calls, loop_count"
                healthy_criterion: "No reasoning/tool loop beyond limit"
                slo: { target: 99.5, window: "5m" }
            },
            {
                name: "session_health"
                signal: "checkpoint_success, recovery_success"
                healthy_criterion: "Resume restores valid state"
                slo: { target: 100, window: "1d" }
            },
            {
                name: "guard_health"
                signal: "blocked_violations, bypass_attempts"
                healthy_criterion: "Zero unauthorized network IO"
                slo: { target: 100, window: "1d" }
            },
            {
                name: "release_health"
                signal: "green_gates, artifact_checksum"
                healthy_criterion: "All release gates green"
                slo: { target: 100, window: "release" }
            },
            {
                name: "automation_health"
                signal: "remediation_success_rate, rollback_rate"
                healthy_criterion: "High success, low repeat failures"
                slo: { target: 95, window: "1w" }
            }
        ]
        
        collection_schema: {
            identity: string
            timestamps: list<int>
            run_ids: list<string>
            tool_calls: list<tool_call>
            permissions: list<permission>
            outputs: list<output>
            token_usage: token_metrics
            latency: latency_metrics
            errors: list<error>
            traces: list<trace>
        }
    }

    test health_dimension_validation {
        ; Verify: Health dimensions have required fields
        given dimensions = create_health_dimensions()
        when validated = validate_health_dimensions(dimensions)
        then validated == true
    }

    test signal_collection {
        ; Verify: Health signals are collected properly
        given collector = create_health_collector()
        when signals = collect_health_signals(collector, "provider_health")
        then len(signals) > 0
        then all_fields_present(signals)
    }

    test slo_compliance {
        ; Verify: SLO compliance is calculated correctly
        given metrics = collect_health_metrics("provider_health", "1h")
        when compliance = calculate_slo_compliance(metrics, 99.9)
        then compliance >= 99.9
    }

    test open_telemetry_conformance {
        ; Verify: Health signals conform to OpenTelemetry GenAI conventions
        given signals = collect_standardized_signals()
        when validated = validate_opentelemetry_schema(signals)
        then validated == true
    }

    invariant dimension_uniqueness {
        ; All dimension names must be unique
        assert forall dims: health_dimensions, 
            unique(dims.name for dims in dimensions)
    }

    invariant signal_validity {
        ; All signals must be valid and measurable
        assert forall dim: health_dimension,
            len(dim.signal) > 0 and
            contains_valid_metrics(dim.signal)
    }

    slo_threshold_safety {
        ; SLO targets must be realistic and achievable
        expect forall dim: health_dimension,
            dim.slo.target >= 90 and dim.slo.target <= 100
    }

    ; Bench for health signal collection performance
    bench signal_collection_latency {
        ; Measure: Time to collect all health signals
        target: < 50ms on typical hardware
        iterations: 1000
        setup: create_test_session()
        measure: collect_all_health_signals(setup)
    }
}