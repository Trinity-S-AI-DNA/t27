spec dsh_release_gate_verify {
    release_gate_verify_skill {
        ; T27_DSH_RELEASE_GATE_VERIFY:
        ; Check tests, invariants, artifact, rollback as READ_ONLY skill
        ; Phase complete: Issue
        → Phase 2: Spec
        
        name: "dsh-release-gate-verify"
        purpose: "Check tests, invariants, artifact, rollback"
        automation_level: "READ_ONLY"
        inputs: {
            release_candidate: string
            baseline_artifact: string
        }
        outputs: {
            gate_status: release_gate {
                release_candidate: string
                baseline_artifact: string
                timestamp: datetime
                gate_checks: list<gate_check> [
                    {
                        name: "tests_pass"
                        status: "pass|fail|unknown"
                        details: string
                        test_results: test_results {
                            total_tests: int
                            passed_tests: int
                            failed_tests: int
                            skipped_tests: int
                            test_duration: duration
                            test_summary: string
                            failed_test_details: list<test_failure> [
                                {
                                    test_name: string
                                    failure_message: string
                                    stack_trace: string
                                }
                            ]
                        }
                    },
                    {
                        name: "invariants_hold"
                        status: "pass|fail|unknown"
                        details: string
                        invariant_results: invariant_results {
                            total_invariants: int
                            passed_invariants: int
                            failed_invariants: int
                            invariant_summary: string
                            failed_invariant_details: list<invariant_failure> [
                                {
                                    invariant_name: string
                                    violation_description: string
                                    evidence: string
                                }
                            ]
                        }
                    },
                    {
                        name: "artifact_checksum_match"
                        status: "pass|fail|unknown"
                        details: string
                        checksum_results: checksum_results {
                            candidate_checksum: string
                            baseline_checksum: string
                            checksum_algorithm: string
                            match: bool
                            size_difference: int
                        }
                    },
                    {
                        name: "rollback_target_available"
                        status: "pass|fail|unknown"
                        details: string
                        rollback_results: rollback_results {
                            target_available: bool
                            target_version: string
                            target_artifact: string
                            target_checksum: string
                            rollback_command: string
                        }
                    }
                ]
                overall_status: "pass|fail|unknown"
                approval_summary: string
                blocking_issues: list<issue> [
                    {
                        type: string
                        severity: "blocker|critical|major|minor"
                        description: string
                        location: string
                        resolution_required: bool
                    }
                ]
                recommendation: string
                next_steps: list<string>
            }
            exit_code: int
        }
        checks: [
            "tests_pass",
            "invariants_hold",
            "artifact_checksum_match",
            "rollback_target_available"
        ]
        remediation: "none"
    }

    test_skill release_candidate_validation {
        ; Verify: Release candidate is validated
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 400
        then executed.outputs.gate_status.overall_status == "unknown"
        then executed.outputs.gate_status.approval_summary contains "invalid release candidate"
    }

    test_skill baseline_artifact_validation {
        ; Verify: Baseline artifact existence is checked
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "candidate_v1.0.0",
            baseline_artifact: "/nonexistent/baseline"
        })
        then executed.exit_code == 404
        then executed.outputs.gate_status.gate_checks[3].status == "fail"
        then executed.outputs.gate_status.gate_checks[3].details contains "baseline not found"
    }

    test_skill test_results_validation {
        ; Verify: Test results are validated correctly
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "failing_tests_candidate",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 400
        then executed.outputs.gate_status.gate_checks[0].status == "fail"
        then executed.outputs.gate_status.gate_checks[0].test_results.failed_tests > 0
        then executed.outputs.gate_status.blocking_issues contains "test failures"
    }

    test_skill invariant_validation {
        ; Verify: Invariants are validated correctly
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "invariant_violation_candidate",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 400
        then executed.outputs.gate_status.gate_checks[1].status == "fail"
        then executed.outputs.gate_status.gate_checks[1].invariant_results.failed_invariants > 0
    }

    test_skill checksum_verification {
        ; Verify: Artifact checksums are verified
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "checksum_mismatch_candidate",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 400
        then executed.outputs.gate_status.gate_checks[2].status == "fail"
        then executed.outputs.gate_status.gate_checks[2].checksum_results.match == false
    }

    test_skill rollback_availability {
        ; Verify: Rollback targets are checked
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "no_rollback_candidate",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 400
        then executed.outputs.gate_status.gate_checks[3].status == "fail"
        then executed.outputs.gate_status.gate_checks[3].rollback_results.target_available == false
    }

    test_skill successful_release_validation {
        ; Verify: Successful release validation
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "perfect_candidate",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 200
        then executed.outputs.gate_status.overall_status == "pass"
        then executed.outputs.gate_status.blocking_issues == []
        then executed.outputs.gate_status.recommendation contains "approved for release"
    }

    test_skill severity_classification {
        ; Verify: Issue severity is classified correctly
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "blocker_candidate",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 400
        then len(executed.outputs.gate_status.blocking_issues) > 0
        then executed.outputs.gate_status.blocking_issues[0].severity == "blocker"
        then executed.outputs.gate_status.blocking_issues[0].resolution_required == true
    }

    test_skill recommendation_generation {
        ; Verify: Recommendations are generated based on results
        given verify = create_release_gate_verify_skill()
        when executed = execute_skill(verify, { 
            release_candidate: "fixable_candidate",
            baseline_artifact: "baseline_v1.0.0"
        })
        then executed.exit_code == 400
        then executed.outputs.gate_status.recommendation contains "fix blocking issues"
        then len(executed.outputs.gate_status.next_steps) > 0
    }

    invariant gate_schema_validity {
        ; Release gate outputs must conform to schema
        assert forall gate: release_gate,
            gate.release_candidate != "" and
            gate.baseline_artifact != "" and
            gate.timestamp != "" and
            len(gate.gate_checks) == 4 and
            gate.overall_status in ["pass", "fail", "unknown"] and
            gate.approval_summary != ""
    }

    invariant test_results_consistency {
        ; Test results must be mathematically consistent
        assert forall test_results: test_results,
            test_results.total_tests == test_results.passed_tests + test_results.failed_tests + test_results.skipped_tests and
            test_results.total_tests >= 0 and
            test_results.passed_tests >= 0 and
            test_results.failed_tests >= 0 and
            test_results.skipped_tests >= 0
    }

    invariant invariant_results_consistency {
        ; Invariant results must be mathematically consistent
        assert forall invariant_results: invariant_results,
            invariant_results.total_invariants == invariant_results.passed_invariants + invariant_results.failed_invariants and
            invariant_results.total_invariants >= 0 and
            invariant_results.passed_invariants >= 0 and
            invariant_results.failed_invariants >= 0
    }

    invariant gate_status_logic {
        ; Overall gate status must be based on individual checks
        assert forall gate: release_gate,
            if gate.gate_checks[0].status == "pass" and 
               gate.gate_checks[1].status == "pass" and 
               gate.gate_checks[2].status == "pass" and 
               gate.gate_checks[3].status == "pass" then
                gate.overall_status == "pass"
            else if any gate_check.status == "fail" then
                gate.overall_status == "fail"
            else
                gate.overall_status == "unknown"
    }

    invariant blocking_issues_severity_order {
        ; Blocking issues must be ordered by severity
        assert forall gate: release_gate,
            all issues in gate.blocking_issues are ordered by severity descending and
            any issue with severity "blocker" must be resolved first
    }

    ; Bench for release gate verification performance
    bench release_gate_verify_latency {
        ; Measure: Time to complete release gate verification
        target: < 500ms on typical hardware
        iterations: 50
        setup: create_test_release_environment()
        measure: execute_release_gate_verify_skill(setup)
    }
}