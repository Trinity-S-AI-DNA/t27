// specs/agents/session-approved-fallback.t27
// The Doctor's route switch: only to a route that is already approved AND
// funded, always announced, never silent.
//
// Owner: T27_SESSION_NEVER_DIES (issue #1409), 2026-10-30.
//
// OWNS:
//   - the admissibility of a fallback route (approved AND funded)
//   - the visibility of the switch and the approval gate
//   - the APPROVAL-GATED autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the recovery ladder levels: specs/system/session-recovery-ladder.t27
//   - provider identity, funding and quarantine state:
//     specs/system/providers.t27
//   - rung order and rung-switch rules: specs/system/model-ladder.t27
//   - the Doctor lifecycle states and the status bar:
//     specs/system/session-doctor.t27

module session_approved_fallback;

// ─── Autonomy ──────────────────────────────────────────────────────────────

pub const AUTONOMY_READ_ONLY : u8 = 0;
pub const AUTONOMY_EVIDENCE : u8 = 1;
pub const AUTONOMY_BOUNDED : u8 = 2;
pub const AUTONOMY_WRITE : u8 = 3;
pub const AUTONOMY_APPROVAL_GATED : u8 = 4;

// ─── Switch decision ───────────────────────────────────────────────────────

pub const SWITCH_ADMITTED : u8 = 0;
pub const SWITCH_DENIED_NOT_APPROVED : u8 = 1;
pub const SWITCH_DENIED_NOT_FUNDED : u8 = 2;
pub const SWITCH_DENIED_SAME_ROUTE : u8 = 3;
pub const SWITCH_DENIED_NO_APPROVAL_EVENT : u8 = 4;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_autonomy() - the switch waits for the owner.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_APPROVAL_GATED;
}

// skill_mutates_state(autonomy) -> bool
pub fn skill_mutates_state(autonomy: u8) -> bool {
    if (autonomy == AUTONOMY_READ_ONLY) {
        return false;
    }
    if (autonomy == AUTONOMY_EVIDENCE) {
        return false;
    }
    return true;
}

// route_is_admissible(target_route, current_route, approved, funded) -> bool
//
// A route enters the session only when it is on the approved list AND it can
// actually pay. A route that is not funded is not an option, however
// approved it is.
pub fn route_is_admissible(target_route: u8, current_route: u8, approved: bool, funded: bool) -> bool {
    if (target_route == current_route) {
        return false;
    }
    if (approved == false) {
        return false;
    }
    if (funded == false) {
        return false;
    }
    return true;
}

// switch_decision(target_route, current_route, approved, funded, owner_approved, user_event_emitted) -> u8
pub fn switch_decision(target_route: u8, current_route: u8, approved: bool, funded: bool, owner_approved: bool, user_event_emitted: bool) -> u8 {
    if (target_route == current_route) {
        return SWITCH_DENIED_SAME_ROUTE;
    }
    if (approved == false) {
        return SWITCH_DENIED_NOT_APPROVED;
    }
    if (funded == false) {
        return SWITCH_DENIED_NOT_FUNDED;
    }
    if (owner_approved == false) {
        return SWITCH_DENIED_NO_APPROVAL_EVENT;
    }
    if (user_event_emitted == false) {
        return SWITCH_DENIED_NO_APPROVAL_EVENT;
    }
    return SWITCH_ADMITTED;
}

// switch_is_permitted(target_route, current_route, approved, funded, owner_approved, user_event_emitted) -> bool
pub fn switch_is_permitted(target_route: u8, current_route: u8, approved: bool, funded: bool, owner_approved: bool, user_event_emitted: bool) -> bool {
    if (switch_decision(target_route, current_route, approved, funded, owner_approved, user_event_emitted) == SWITCH_ADMITTED) {
        return true;
    }
    return false;
}

// switch_is_never_silent(switched, user_event_emitted) -> bool
pub fn switch_is_never_silent(switched: bool, user_event_emitted: bool) -> bool {
    if (switched == false) {
        return true;
    }
    return user_event_emitted;
}

// switch_preserves_the_work(checkpoint_written) -> bool
pub fn switch_preserves_the_work(checkpoint_written: bool) -> bool {
    return checkpoint_written;
}

// switch_records_the_new_route(route_before, route_after, recorded) -> bool
// The new route is written down, so the next reader knows who served the work.
pub fn switch_records_the_new_route(route_before: u8, route_after: u8, recorded: bool) -> bool {
    if (route_before == route_after) {
        return true;
    }
    return recorded;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_fallback_skill_is_approval_gated" {
    assert(skill_autonomy() == AUTONOMY_APPROVAL_GATED);
    assert(skill_mutates_state(AUTONOMY_APPROVAL_GATED) == true);
}

test "a_route_must_be_approved_and_funded_to_enter" {
    assert(route_is_admissible(1, 0, true, true) == true);
    assert(route_is_admissible(1, 0, false, true) == false);
    assert(route_is_admissible(1, 0, true, false) == false);
    assert(route_is_admissible(1, 0, false, false) == false);
}

test "a_switch_to_the_same_route_is_not_a_switch" {
    assert(route_is_admissible(0, 0, true, true) == false);
    assert(switch_decision(0, 0, true, true, true, true) == SWITCH_DENIED_SAME_ROUTE);
}

test "a_switch_waits_for_the_owner_and_for_the_visible_event" {
    assert(switch_decision(1, 0, true, true, false, true) == SWITCH_DENIED_NO_APPROVAL_EVENT);
    assert(switch_decision(1, 0, true, true, true, false) == SWITCH_DENIED_NO_APPROVAL_EVENT);
    assert(switch_decision(1, 0, true, true, true, true) == SWITCH_ADMITTED);
    assert(switch_is_permitted(1, 0, true, true, true, true) == true);
}

test "a_switch_is_never_silent" {
    assert(switch_is_never_silent(true, false) == false);
    assert(switch_is_never_silent(true, true) == true);
    assert(switch_is_never_silent(false, false) == true);
}

test "the_switch_keeps_the_work_and_records_the_route" {
    assert(switch_preserves_the_work(true) == true);
    assert(switch_preserves_the_work(false) == false);
    assert(switch_records_the_new_route(0, 1, true) == true);
    assert(switch_records_the_new_route(0, 1, false) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant an_unapproved_route_never_enters_the_session {
    route_is_admissible(1, 0, false, true) == false;
    switch_decision(1, 0, false, true, true, true) == SWITCH_DENIED_NOT_APPROVED;
}

invariant an_unfunded_route_never_enters_the_session {
    route_is_admissible(1, 0, true, false) == false;
    switch_decision(1, 0, true, false, true, true) == SWITCH_DENIED_NOT_FUNDED;
}

invariant a_switch_is_never_silent {
    switch_is_never_silent(true, false) == false;
    switch_is_never_silent(true, true) == true;
}

invariant a_switch_always_keeps_the_work {
    switch_preserves_the_work(false) == false;
    switch_preserves_the_work(true) == true;
}
