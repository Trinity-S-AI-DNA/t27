// specs/agents/session-health-watch.t27
// The Doctor's eyes: it watches the heartbeat, the provider, the tools and the
// agent for a stall, and escalates what it sees. It never changes anything.
//
// Owner: T27_SESSION_NEVER_DIES (issue #1409), 2026-10-30.
//
// OWNS:
//   - the health signals the Doctor watches
//   - the stall detection rule
//   - the decision to escalate a signal into a diagnosis
//   - the READ-ONLY autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the Doctor lifecycle states: specs/system/session-doctor.t27
//   - the recovery ladder and the per-failure policy:
//     specs/system/session-recovery-ladder.t27
//   - the checkpoint contract: specs/system/session-continuity.t27
//   - provider funding state: specs/system/providers.t27

module session_health_watch;

// ─── Autonomy ──────────────────────────────────────────────────────────────

pub const AUTONOMY_READ_ONLY : u8 = 0;
pub const AUTONOMY_EVIDENCE : u8 = 1;
pub const AUTONOMY_BOUNDED : u8 = 2;
pub const AUTONOMY_WRITE : u8 = 3;
pub const AUTONOMY_APPROVAL_GATED : u8 = 4;

// ─── Health signals ────────────────────────────────────────────────────────

pub const SIGNAL_NONE : u8 = 0;
pub const SIGNAL_HEARTBEAT_STALE : u8 = 1;
pub const SIGNAL_PROVIDER_UNHEALTHY : u8 = 2;
pub const SIGNAL_TOOL_FAILURE : u8 = 3;
pub const SIGNAL_AGENT_STALL : u8 = 4;
pub const SIGNAL_COUNT : u32 = 5;

// ─── Watch decision ────────────────────────────────────────────────────────

pub const WATCH_HEALTHY : u8 = 0;
pub const WATCH_ESCALATE : u8 = 1;
pub const WATCH_COUNT : u32 = 2;

// ─── Stall detection ───────────────────────────────────────────────────────

pub const DEFAULT_STALL_TIMEOUT_MS : u64 = 300000;   // 5 minutes
pub const DEFAULT_MAX_REPEATED_CALLS : u32 = 3;
pub const DEFAULT_MAX_IDLE_STEPS : u32 = 5;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_autonomy() - the Doctor watches; it does not touch the session.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_READ_ONLY;
}

// skill_mutates_state(autonomy) -> bool
// A read-only skill never writes session state.
pub fn skill_mutates_state(autonomy: u8) -> bool {
    if (autonomy == AUTONOMY_READ_ONLY) {
        return false;
    }
    if (autonomy == AUTONOMY_EVIDENCE) {
        return false;
    }
    return true;
}

// heartbeat_is_stale(now_ms, last_activity_ms, timeout_ms) -> bool
// A session that stopped reporting is a session that may have died. The
// Doctor notices the silence before the user does.
pub fn heartbeat_is_stale(now_ms: u64, last_activity_ms: u64, timeout_ms: u64) -> bool {
    if (now_ms < last_activity_ms) {
        return false;
    }
    if ((now_ms - last_activity_ms) >= timeout_ms) {
        return true;
    }
    return false;
}

// agent_is_stalled(repeated_tool_calls, idle_steps, max_repeated_calls, max_idle_steps) -> bool
// A stall is either the same call repeated or no progress for too many steps.
pub fn agent_is_stalled(repeated_tool_calls: u32, idle_steps: u32, max_repeated_calls: u32, max_idle_steps: u32) -> bool {
    if (repeated_tool_calls >= max_repeated_calls) {
        return true;
    }
    if (idle_steps >= max_idle_steps) {
        return true;
    }
    return false;
}

// health_signal_present(signal) -> bool
pub fn health_signal_present(signal: u8) -> bool {
    if (signal == SIGNAL_NONE) {
        return false;
    }
    if (signal < SIGNAL_COUNT) {
        return true;
    }
    return false;
}

// watch_decision(heartbeat_stale, provider_unhealthy, tool_failed, stalled) -> u8
// One unhealthy signal is enough to escalate: the Doctor explains, it does
// not wait for a second opinion from a dead session.
pub fn watch_decision(heartbeat_stale: bool, provider_unhealthy: bool, tool_failed: bool, stalled: bool) -> u8 {
    if (heartbeat_stale == true) {
        return WATCH_ESCALATE;
    }
    if (provider_unhealthy == true) {
        return WATCH_ESCALATE;
    }
    if (tool_failed == true) {
        return WATCH_ESCALATE;
    }
    if (stalled == true) {
        return WATCH_ESCALATE;
    }
    return WATCH_HEALTHY;
}

// watch_escalates_into_diagnosis(decision) -> bool
// The watch escalates into a diagnosis; it never repairs on its own.
pub fn watch_escalates_into_diagnosis(decision: u8) -> bool {
    if (decision == WATCH_ESCALATE) {
        return true;
    }
    return false;
}

// watch_never_repairs_directly(decision) -> bool
pub fn watch_never_repairs_directly(decision: u8) -> bool {
    if (decision == WATCH_ESCALATE) {
        return false;
    }
    return true;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_watch_skill_is_read_only" {
    assert(skill_autonomy() == AUTONOMY_READ_ONLY);
    assert(skill_mutates_state(AUTONOMY_READ_ONLY) == false);
    assert(skill_mutates_state(AUTONOMY_WRITE) == true);
}

test "a_silent_session_is_detected_before_the_user_notices" {
    assert(heartbeat_is_stale(400000, 0, DEFAULT_STALL_TIMEOUT_MS) == true);
    assert(heartbeat_is_stale(200000, 0, DEFAULT_STALL_TIMEOUT_MS) == false);
    assert(heartbeat_is_stale(0, 400000, DEFAULT_STALL_TIMEOUT_MS) == false);
}

test "a_stall_is_a_repeated_call_or_a_long_silence" {
    assert(agent_is_stalled(3, 0, DEFAULT_MAX_REPEATED_CALLS, DEFAULT_MAX_IDLE_STEPS) == true);
    assert(agent_is_stalled(0, 5, DEFAULT_MAX_REPEATED_CALLS, DEFAULT_MAX_IDLE_STEPS) == true);
    assert(agent_is_stalled(1, 1, DEFAULT_MAX_REPEATED_CALLS, DEFAULT_MAX_IDLE_STEPS) == false);
}

test "one_unhealthy_signal_is_enough_to_escalate" {
    assert(watch_decision(true, false, false, false) == WATCH_ESCALATE);
    assert(watch_decision(false, true, false, false) == WATCH_ESCALATE);
    assert(watch_decision(false, false, true, false) == WATCH_ESCALATE);
    assert(watch_decision(false, false, false, true) == WATCH_ESCALATE);
    assert(watch_decision(false, false, false, false) == WATCH_HEALTHY);
}

test "the_watch_escalates_but_never_repairs" {
    assert(watch_escalates_into_diagnosis(WATCH_ESCALATE) == true);
    assert(watch_escalates_into_diagnosis(WATCH_HEALTHY) == false);
    assert(watch_never_repairs_directly(WATCH_ESCALATE) == false);
}

test "the_watch_knows_exactly_four_signals" {
    assert(SIGNAL_COUNT == 5);
    assert(health_signal_present(SIGNAL_HEARTBEAT_STALE) == true);
    assert(health_signal_present(SIGNAL_PROVIDER_UNHEALTHY) == true);
    assert(health_signal_present(SIGNAL_TOOL_FAILURE) == true);
    assert(health_signal_present(SIGNAL_AGENT_STALL) == true);
    assert(health_signal_present(SIGNAL_NONE) == false);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant the_watch_never_writes_session_state {
    skill_mutates_state(AUTONOMY_READ_ONLY) == false;
    skill_mutates_state(AUTONOMY_EVIDENCE) == false;
}

invariant a_silent_session_is_always_escalated {
    watch_decision(true, false, false, false) == WATCH_ESCALATE;
    watch_decision(false, false, false, true) == WATCH_ESCALATE;
}

invariant the_watch_never_repairs_on_its_own {
    watch_never_repairs_directly(WATCH_ESCALATE) == false;
    watch_escalates_into_diagnosis(WATCH_ESCALATE) == true;
}
