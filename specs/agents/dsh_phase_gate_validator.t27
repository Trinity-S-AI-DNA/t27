spec dsh_phase_gate_validator {
    phase_gate_validator {
        ; T27_PHASE_GATE_VALIDATOR:
        ; Validates phase gate criteria before allowing progression to next phase
        ; Phase complete: Issue
        → Phase 2: Spec
        
        phase_gates: list<phase_gate_definition> [
            {
                gate_id: "GATE_T27_DSH_HEALTH_01"
                phase: "T27_DSH_HEALTH_01"
                gate_name: "Evidentiary Completeness"
                description: "Validate completeness of evidence collection and verification"
                criteria: list<gate_criterion> [
                    {
                        criterion_id: "CRITERION_01"
                        description: "All health signals collected without errors"
                        type: "binary"
                        required: true
                        validation_method: "automated_test"
                        target_value: 100.0
                        unit: "percent"
                        threshold_type: "minimum"
                    },
                    {
                        criterion_id: "CRITERION_02"
                        description: "Route verification 100% accurate"
                        type: "binary"
                        required: true
                        validation_method: "automated_test"
                        target_value: 100.0
                        unit: "percent"
                        threshold_type: "minimum"
                    },
                    {
                        criterion_id: "CRITERION_03"
                        description: "No false positives in signal detection"
                        type: "binary"
                        required: true
                        validation_method: "validation_test"
                        target_value: 0.0
                        unit: "count"
                        threshold_type: "maximum"
                    },
                    {
                        criterion_id: "CRITERION_04"
                        description: "Evidence artifacts complete and traceable"
                        type: "completeness"
                        required: true
                        validation_method: "artifact_validation"
                        target_value: 100.0
                        unit: "percent"
                        threshold_type: "minimum"
                    }
                ]
                approval_required: true
                auto_approve: false
                approval_authority: "lead"
                validation_script: "scripts/validate_phase_gate_T27_DSH_HEALTH_01.sh"
            }
        ]
        
        gate_execution_history: list<gate_execution_record> [
            {
                execution_id: "EXEC_001"
                gate_id: "GATE_T27_DSH_HEALTH_01"
                executed_at: string ""
                execution_status: string "not_executed"
                results: list<criterion_result> []
                approver: string ""
                approval_timestamp: string ""
                decision: string ""
                reasoning: string ""
            }
        ]
        
        validation_results: list<validation_result> [
            {
                result_id: "VAL_001"
                gate_id: "GATE_T27_DSH_HEALTH_01"
                milestone_id: "MILESTONE_04"
                validation_timestamp: string ""
                status: string "not_validated"
                criteria_results: list<criterion_result> []
                overall_score: number 0.0
                pass_fail: boolean false
                blocker: string ""
            }
        ]
    }

    test phase_gate_validation {
        ; Verify: Phase gate validation works correctly
        given validator = create_phase_gate_validator()
        when gate = validator.phase_gates[0]
        then gate.gate_id == "GATE_T27_DSH_HEALTH_01"
        then gate.phase == "T27_DSH_HEALTH_01"
        then len(gate.criteria) == 4
        then gate.approval_required == true
    }

    test criterion_validation {
        ; Verify: Individual criteria can be validated
        given validator = create_phase_gate_validator()
        when gate = validator.phase_gates[0]
        when result = validate_criterion(gate.criteria[0], current_value = 100.0)
        then result.passed == true
        then result.score == 100.0
        then result.status == "passed"
    }

    test gate_execution {
        ; Verify: Phase gate execution works correctly
        given validator = create_phase_gate_validator()
        when execution = execute_phase_gate("GATE_T27_DSH_HEALTH_01")
        then execution.execution_status == "completed"
        then len(execution.results) == 4
        then execution.overall_pass_fail == true
    }

    test approval_workflow {
        ; Verify: Approval workflow functions correctly
        given validator = create_phase_gate_validator()
        when execution = execute_phase_gate("GATE_T27_DSH_HEALTH_01")
        when approved = approve_gate_execution(execution.execution_id, "lead")
        then approved.status == "approved"
        then approved.approver == "lead"
        then approved.timestamp != ""
    }

    test validation_scoring {
        ; Verify: Validation scoring calculates correctly
        given validator = create_phase_gate_validator()
        when gate = validator.phase_gates[0]
        when results = validate_all_criteria(gate, {
            "CRITERION_01": 100.0,
            "CRITERION_02": 100.0,
            "CRITERION_03": 0.0,
            "CRITERION_04": 100.0
        })
        then results.overall_score == 100.0
        then results.pass_fail == true
        then len(results.criteria_results) == 4
    }

    test blocker_detection {
        ; Verify: Blockers are detected and reported
        given validator = create_phase_gate_validator()
        when gate = validator.phase_gates[0]
        when execution = execute_phase_gate("GATE_T27_DSH_HEALTH_01")
        when detected = detect_blockers(execution.results)
        then len(detected.blockers) >= 0
        then detected.overall_status == "blocked" or detected.overall_status == "passed"
    }

    test gate_history_tracking {
        ; Verify: Gate execution history is tracked correctly
        given validator = create_phase_gate_validator()
        when executed = execute_phase_gate("GATE_T27_DSH_HEALTH_01")
        when history = get_gate_execution_history("GATE_T27_DSH_HEALTH_01")
        then len(history) >= 1
        then history[0].execution_id == executed.execution_id
        then history[0].execution_timestamp != ""
    }

    test validation_reproducibility {
        ; Verify: Validation results are reproducible and consistent
        given validator = create_phase_gate_validator()
        when first_run = execute_phase_gate("GATE_T27_DSH_HEALTH_01")
        when second_run = execute_phase_gate("GATE_T27_DSH_HEALTH_01")
        then first_run.overall_pass_fail == second_run.overall_pass_fail
        then first_run.overall_score == second_run.overall_score
    }

    test approval_authorization {
        ; Verify: Approval authorization is enforced
        given validator = create_phase_gate_validator()
        when execution = execute_phase_gate("GATE_T27_DSH_HEALTH_01")
        when unauthorized_attempt = attempt_unauthorized_approval(execution.execution_id, "invalid_user")
        then unauthorized_attempt.failed == true
        then unauthorized_attempt.error == "UNAUTHORIZED_APPROVER"
    }

    invariant gate_uniqueness {
        ; All gate IDs must be unique
        assert forall gates: phase_gate_definition,
            unique(gates.gate_id for gates in phase_gates)
    }

    invariant criterion_consistency {
        ; All criteria must belong to valid gates
        assert forall criterion: gate_criterion,
            exists gate: phase_gate_definition where gate.gate_id == criterion.parent_gate_id
    }

    invariant execution_state_validity {
        ; All execution states must be valid
        assert forall execution: gate_execution_record,
            execution.execution_status in ["not_executed", "executing", "completed", "failed", "approved", "rejected"]
    }

    invariant approval_authority {
        ; Only authorized approvers can approve gates
        expect forall execution: gate_execution_record,
            if execution.approval_timestamp != "" then
                execution.approver in ["lead", "admin", "quality_assurance"]
    }

    rule threshold_logic {
        ; Threshold validation must follow mathematical rules
        expect forall criterion: gate_criterion,
            if criterion.threshold_type == "minimum" then
                criterion.validation_method(current_value) >= criterion.target_value
            if criterion.threshold_type == "maximum" then
                criterion.validation_method(current_value) <= criterion.target_value
    }

    rule gate_dependency_order {
        ; Gates must be executed in correct order based on phase dependencies
        expect forall gate: phase_gate_definition,
            if gate.phase == "T27_DSH_HEALTH_01" then
                not exists previous_gate: phase_gate_definition where 
                    previous_gate.phase != "T27_DSH_HEALTH_01" and
                    previous_gate.gate_id in prerequisite_gates
    }

    ; Bench for phase gate validation performance
    bench phase_gate_validation_latency {
        ; Measure: Time to validate a complete phase gate
        target: < 200ms on typical hardware
        iterations: 100
        setup: create_phase_gate_scenarios()
        measure: validate_phase_gate(setup)
    }

    bench criterion_validation_latency {
        ; Measure: Time to validate individual criteria
        target: < 50ms on typical hardware
        iterations: 1000
        setup: create_criterion_scenarios()
        measure: validate_criterion(setup)
    }
}