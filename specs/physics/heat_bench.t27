// SPDX-License-Identifier: Apache-2.0
; specs/physics/heat_bench.t27 -- the minimal research graph for heat conduction benchmarking
; Law: steady one-dimensional heat conduction in a rod with no internal generation
; Fourier flux: q = k * (T_hot - T_cold) / L
; Steady profile: T(x) = T_hot + (T_cold - T_hot) * x / L
; FTCS explicit: T_i' = T_i + r * (T_{i-1} - 2 T_i + T_{i+1}), r = alpha * dt / dx^2, stable for r <= 0.5
; --
; The research graph: law, parameters, conditions, observable, reference, verdict
; Node labels: one per node in the graph, from spec_graph vocabulary
; Observable: midpoint temperature and flux after N steps
; Reference: closed-form midpoint temperature (350 K)
; Verdict: verified when computed - reference <= 1e-6
; --
; Order: Trinity-S-AI-DNA/t27#13044 (slice 1 = #13045), 2026-11-01.
; phi^2 + 1/phi^2 = 3 | TRINITY

module HeatBench;

use t27f::spec_graph::LABEL_EXACT;
use t27f::spec_graph::LABEL_DERIVED;
use t27f::spec_graph::LABEL_SUGGESTED;
use t27f::spec_graph::LABEL_UNKNOWN;
use t27f::spec_graph::LABEL_KINDS;
use t27f::work_graph::NK_SPEC;
use t27f::work_graph::NK_TASK;
use t27f::work_graph::NK_ACTION;
use t27f::work_graph::NK_ARTIFACT;
use t27f::work_graph::NK_COUNT;
use t27f::work_graph::EK_READS;
use t27f::work_graph::EK_PERFORMS;
use t27f::work_graph::EK_PRODUCES;
use t27f::work_graph::EK_VERIFIES;
use t27f::work_graph::EK_BLOCKS;
use t27f::work_graph::EK_COUNT;

// Law: Fourier's law of heat conduction
pub const LAW_FOURIER_W_PER_M_K : f64 = 400.0; // Copper thermal conductivity (handbook value)

// Parameters
pub const RHO_KG_PER_M3 : f64 = 8960.0; // Copper density
pub const CP_J_PER_KG_K : f64 = 385.0; // Copper specific heat capacity
pub const L_M : f64 = 1.0; // Rod length (1 meter)
pub const N_CELLS : u32 = 10; // Number of spatial cells
pub const DX_M : f64 = L_M / 10.0; // Spatial step size
pub const DT_S : f64 = 40.0; // Time step size (stable)
pub const DT_UNSTABLE_S : f64 = 50.0; // Time step size (unstable)
pub const N_STEPS : u32 = 2000; // Number of FTCS steps

// Derived: thermal diffusivity
pub fn alpha_m2_per_s() -> f64 {
    return LAW_FOURIER_W_PER_M_K / (RHO_KG_PER_M3 * CP_J_PER_KG_K);
}

// Initial condition: uniform rod temperature
pub const T0_K : f64 = 300.0; // Initial temperature (uniform)

// Boundary conditions (Dirichlet, both ends)
pub const T_HOT_K : f64 = 400.0; // Hot end at x = 0
pub const T_COLD_K : f64 = 300.0; // Cold end at x = L

// Steady-state temperature profile (closed form)
pub fn t_steady_k(x_m: f64) -> f64 {
    return T_HOT_K + (T_COLD_K - T_HOT_K) * x_m / L_M;
}

// Fourier heat flux (constant in steady state)
pub fn flux_w_per_m2() -> f64 {
    return LAW_FOURIER_W_PER_M_K * (T_HOT_K - T_COLD_K) / L_M;
}

// Stability ratio for FTCS scheme
pub fn stability_ratio(dt_s: f64) -> f64 {
    let alpha = alpha_m2_per_s();
    return alpha * dt_s / (DX_M * DX_M);
}

// Check if FTCS is stable
pub fn stable(dt_s: f64) -> bool {
    return stability_ratio(dt_s) <= 0.5;
}

// FTCS explicit scheme: midpoint temperature after N steps
pub fn t_mid_ftcs_k(steps: u32) -> f64 {
    var t : [11]f64 = [0; 11]; // 11 nodes (0 to 10)
    var t_new : [11]f64 = [0; 11];

    // Initialize uniform temperature
    var i : u32 = 0;
    while (i < 11) {
        t[i] = T0_K;
        i = i + 1;
    }

    // Set boundary conditions
    t[0] = T_HOT_K;
    t[10] = T_COLD_K;

    // FTCS iterations
    var step : u32 = 0;
    while (step < steps) {
        // Update interior nodes
        i = 1;
        while (i < 10) {
            t_new[i] = t[i] + stability_ratio(DT_S) * (t[i-1] - 2 * t[i] + t[i+1]);
            i = i + 1;
        }

        // Apply boundary conditions
        t_new[0] = T_HOT_K;
        t_new[10] = T_COLD_K;

        // Copy back
        i = 0;
        while (i < 11) {
            t[i] = t_new[i];
            i = i + 1;
        }

        step = step + 1;
    }

    return t[5]; // Midpoint (node 5 of 10)
}

// Reference: closed-form midpoint temperature
pub fn t_mid_reference_k() -> f64 {
    return t_steady_k(L_M / 2.0);
}

// Verdict constants
pub const VERDICT_VERIFIED : u8 = 0;
pub const VERDICT_REFUTED : u8 = 1;
pub const VERDICT_UNKNOWN : u8 = 2;
pub const TOL_K : f64 = 1.0e-6; // Tolerance for verification

// Verdict function
pub fn verdict(computed_k: f64, reference_k: f64, tol_k: f64) -> u8 {
    if (tol_k < 0.0) {
        return VERDICT_UNKNOWN;
    }
    if (@abs(computed_k - reference_k) <= tol_k) {
        return VERDICT_VERIFIED;
    }
    return VERDICT_REFUTED;
}

// Research graph nodes
pub const NODE_COUNT : u32 = 10;
pub const NODE_NAMES : [10]str = ["law_fourier", "k_copper", "rho_cp", "alpha", "initial_uniform", "boundary_dirichlet", "observable_t_mid", "reference_closed_form", "verdict", "contact_resistance_ends"];
pub const NODE_LABELS : [10]u8 = [LABEL_EXACT, LABEL_SUGGESTED, LABEL_SUGGESTED, LABEL_DERIVED, LABEL_EXACT, LABEL_EXACT, LABEL_DERIVED, LABEL_DERIVED, LABEL_DERIVED, LABEL_UNKNOWN];

// View label function
pub fn view_label(node: u32) -> u8 {
    if (node >= NODE_COUNT) {
        return LABEL_UNKNOWN;
    }
    return NODE_LABELS[node];
}

// Work-graph kind of each bench node (t27f::work_graph vocabulary), same order as NODE_NAMES.
pub const NODE_KINDS : [10]u8 = [NK_SPEC, NK_ARTIFACT, NK_ARTIFACT, NK_ACTION, NK_SPEC, NK_SPEC, NK_ACTION, NK_ACTION, NK_ARTIFACT, NK_TASK];
pub const EDGE_COUNT : u32 = 10;
/// Bench edges, node indexes local to this file (0..9).
pub const EDGE_FROM : [10]u32 = [0, 1, 2, 3, 4, 5, 5, 6, 7, 9];
pub const EDGE_TO   : [10]u32 = [3, 3, 3, 6, 6, 6, 7, 8, 8, 8];
pub const EDGE_KINDS : [10]u8 = [EK_READS, EK_PRODUCES, EK_PRODUCES, EK_PERFORMS, EK_READS, EK_READS, EK_READS, EK_VERIFIES, EK_VERIFIES, EK_BLOCKS];
pub const EDGE_LABELS : [10]u8 = [LABEL_DERIVED, LABEL_DERIVED, LABEL_DERIVED, LABEL_DERIVED, LABEL_EXACT, LABEL_EXACT, LABEL_EXACT, LABEL_DERIVED, LABEL_DERIVED, LABEL_DERIVED];

// Tests
test the_ends_are_the_boundary_conditions {
    assert @abs(t_steady_k(0.0) - T_HOT_K) <= 1.0e-12;
    assert @abs(t_steady_k(L_M) - T_COLD_K) <= 1.0e-12;
}

test the_midpoint_of_the_closed_form_is_the_mean {
    assert @abs(t_mid_reference_k() - 350.0) <= 1.0e-12;
}

test the_flux_runs_from_hot_to_cold {
    assert flux_w_per_m2() > 0.0;
    assert @abs(flux_w_per_m2() - 40000.0) <= 1.0e-9;
}

test the_chosen_step_is_stable_and_the_larger_one_is_not {
    let alpha_val = alpha_m2_per_s();
    let stable_ratio = stability_ratio(DT_S);
    let unstable_ratio = stability_ratio(DT_UNSTABLE_S);

    assert stable_ratio <= 0.5;
    assert stable(DT_S) == true;
    assert unstable_ratio > 0.5;
    assert stable(DT_UNSTABLE_S) == false;
    assert @abs(alpha_val - 1.16e-4) / 1.16e-4 <= 0.01; // Within 1%
}

test the_explicit_scheme_reaches_the_closed_form_and_the_verdict_is_verified {
    let computed = t_mid_ftcs_k(N_STEPS);
    let reference = t_mid_reference_k();
    let v = verdict(computed, reference, TOL_K);
    assert v == VERDICT_VERIFIED;
}

test the_bench_view_is_a_small_connected_work_graph {
    var deg : [10]u32 = [0; 10];

    // Edge validity checks
    var i : u32 = 0;
    while (i < EDGE_COUNT) {
        assert EDGE_FROM[i] < NODE_COUNT;
        assert EDGE_TO[i] < NODE_COUNT;
        assert EDGE_FROM[i] != EDGE_TO[i];
        assert EDGE_KINDS[i] < EK_COUNT;
        assert EDGE_LABELS[i] < LABEL_KINDS;
        deg[EDGE_FROM[i] as usize] = deg[EDGE_FROM[i] as usize] + 1;
        deg[EDGE_TO[i] as usize] = deg[EDGE_TO[i] as usize] + 1;
        i = i + 1;
    }

    // Node validity checks
    i = 0;
    while (i < NODE_COUNT) {
        assert NODE_KINDS[i] < NK_COUNT;
        i = i + 1;
    }

    // Distinctness check
    var i1 : u32 = 0;
    while (i1 < EDGE_COUNT) {
        var i2 : u32 = i1 + 1;
        while (i2 < EDGE_COUNT) {
            // No duplicate edges (same from/to)
            if (EDGE_FROM[i1] == EDGE_FROM[i2]) {
                assert EDGE_TO[i1] != EDGE_TO[i2];
            }
            // No reversed edges
            if (EDGE_FROM[i1] == EDGE_TO[i2]) {
                assert EDGE_TO[i1] != EDGE_FROM[i2];
            }
            i2 = i2 + 1;
        }
        i1 = i1 + 1;
    }

    // Degree checks
    assert deg[3] == 4; // alpha
    assert deg[6] == 4; // observable_t_mid
    var total : u32 = 0;
    i = 0;
    while (i < NODE_COUNT) {
        assert deg[i] >= 1 and deg[i] <= 4;
        total = total + deg[i];
        i = i + 1;
    }
    assert total == 20; // 2 * EDGE_COUNT
}

test a_wrong_reference_is_refuted_and_a_negative_tolerance_is_unknown {
    let computed = t_mid_ftcs_k(N_STEPS);
    let reference = t_mid_reference_k() + 1.0;
    let v1 = verdict(computed, reference, TOL_K);
    assert v1 == VERDICT_REFUTED;

    let v2 = verdict(0.0, 0.0, -1.0);
    assert v2 == VERDICT_UNKNOWN;
}

test every_node_label_passes_through_the_view_unchanged_and_all_four_kinds_occur {
    var counts : [4]u32 = [0; 4]; // Exact, Derived, Suggested, Unknown
    var i : u32 = 0;

    while (i < NODE_COUNT) {
        let label = view_label(i);
        assert label == NODE_LABELS[i];
        assert label < LABEL_KINDS;
        counts[label] = counts[label] + 1;
        i = i + 1;
    }

    assert view_label(NODE_COUNT) == LABEL_UNKNOWN;
    assert counts[LABEL_EXACT] >= 1;
    assert counts[LABEL_DERIVED] >= 1;
    assert counts[LABEL_SUGGESTED] >= 1;
    assert counts[LABEL_UNKNOWN] >= 1;
}