// SPDX-License-Identifier: Apache-2.0
// specs/physics/formula_discovery.t27 -- the chimera formulas of formula_registry.t27, each tested
// against a MEASURED value and its uncertainty, and each labelled with its chance. (Closes #10297)
//
// WHAT CHANGED. This spec used to test S1_gamma against 0.23607 (that is phi^-3, the formula itself)
// and N1_alpha_s against 0.118034 (the formula's own value; PDG 2024 gives 0.1180 +- 0.0009). A test
// whose expected value comes from the formula under test proves nothing, and the old file did not
// compile (`ln`, `pow`, `powf` and `given/when/then` are not t27), so no test of it ever ran.
//
// THE RULE (specs/physics/sacred_lattice.t27): the lattice n * 3^k * pi^m * phi^p * e^q fits a random
// number within 0.1% six times out of ten at complexity 6, the same rate as the real constants. A fit
// is therefore worth its CHANCE, 1 - exp(-2 * err * rho), and not its agreement. Here `err` is the
// resolution of the test: the larger of the formula's relative distance from the measurement and the
// measurement's own relative uncertainty (a coarse measurement cannot tell a formula from chance).
// `rho` is the lattice density at the formula's own complexity C = |k| + |m| + |p| + |q|, scaled from
// sacred_lattice's lab value RHO_C6 = 483 by lattice size (checked against the lab at C = 4 and 8).
//
// LABELS (sacred_lattice): EXACT = an identity (phi^2 + phi^-2 = 3 is the only one here); MEASURED = a
// CODATA / PDG / lattice-QCD number with its uncertainty; SUGGESTED = a fit with chance * trials < 0.05;
// UNKNOWN = everything else. This file adds REFUTED: a formula more than 3 sigma from its measurement.
// No formula below is EXACT or SUGGESTED. A formula outside the grammar (a factor 1/7, a 360, a three-term
// sum) has no computable chance and is UNKNOWN. TRIALS = 19 is a LOWER bound: the registry holds 19
// formulas, and the search that produced them tried many more.
//
// WHAT THE MEASUREMENTS SAY (sigma = distance in standard deviations; all targets cited at the constants):
//   refuted (more than 3 sigma): CKM1 theta_C (sin 8.59 deg = 0.149 vs V_us 0.2243), CKM2 V_cb (7.5e-4 vs
//             0.0411), PMNS4 sin^2 th12 (2.9e-4 vs 0.307)
//   2 to 3 sigma off (kept, not refuted): P10 V_ud, P12 V_td
//   agree, but the measurement is too coarse to mean anything (chance near 1): N1 alpha_s, PMNS2 and P13
//             sin^2 th, PMNS3/P14 delta_CP, P11 V_cs, P15, P16, P17, P18
//   H1 m_H/m_Z agrees to 0.09% and is the sharpest agreement here, but 1/8 is outside the grammar, so its
//             chance is not computable and it stays UNKNOWN
//   S1_gamma has no measurement: the Barbero-Immirzi parameter is a theory input, and the published
//             counts (0.2375 vs 0.2740, specs/physics/gamma-conflict.t27) disagree with each other.
//   PM1b matches CODATA 2022 1/alpha within 1 sigma but is a three-term expression with integer
//             constants (360, 2, 3, 5) outside the lattice grammar: its chance is not computable.
// N1 = phi^-3 / 2 and S1 = phi^-3 are the same number up to a factor 2 (N1 = S1 / 2): one fit, twice.
// P10 and P11 are the same expression for two different quantities (V_ud and V_cs): at most one is right.
//
// Constants: CODATA 2022 (NIST), PDG 2024 (Phys. Rev. D 110, 030001), Planck 2018 (as in PDG 2024
// "Astrophysical constants and cosmological parameters"), HotQCD (Bazavov et al., Phys. Lett. B 795, 15).
// phi^2 + 1/phi^2 = 3 | TRINITY

module FormulaDiscovery {
    use physics::sacred_lattice;

    pub const PHI : f64 = 1.6180339887498948;
    pub const PI : f64 = 3.1415926535897932;
    pub const E : f64 = 2.7182818284590452;

    pub const VERDICT_REFUTED : u8 = 4;      // more than 3 sigma from its measurement
    pub const REFUTE_SIGMA : f64 = 3.0;
    pub const TRIALS : f64 = 19.0;           // lower bound on formulas tried (the registry's 19)

    // ===== Measured targets: central value, uncertainty below, uncertainty above =====

    // CODATA 2022: 1/alpha = 137.035 999 177 (21)
    pub const M_ALPHA_INV : f64 = 137.035999177;
    pub const S_ALPHA_INV : f64 = 0.000000021;
    // PDG 2024: alpha_s(mZ) = 0.1180 +- 0.0009
    pub const M_ALPHA_S : f64 = 0.1180;
    pub const S_ALPHA_S : f64 = 0.0009;
    // PDG 2024 CKM review: |V_us| = 0.22431 +- 0.00085, |V_cb| = (41.1 +- 1.2)e-3, |V_ud| = 0.97367 +- 0.00032,
    // |V_cs| = 0.975 +- 0.006, |V_td| = (8.6 +- 0.2)e-3
    pub const M_VUS : f64 = 0.22431;
    pub const S_VUS : f64 = 0.00085;
    pub const M_VCB : f64 = 0.0411;
    pub const S_VCB : f64 = 0.0012;
    pub const M_VUD : f64 = 0.97367;
    pub const S_VUD : f64 = 0.00032;
    pub const M_VCS : f64 = 0.975;
    pub const S_VCS : f64 = 0.006;
    pub const M_VTD : f64 = 0.0086;
    pub const S_VTD : f64 = 0.0002;
    // PDG 2024 neutrino mixing: sin^2 th12 = 0.307 +- 0.013; sin^2 th23 = 0.558 +0.015 -0.021 (normal
    // order); delta_CP = 1.19 +- 0.22 pi rad
    pub const M_S2T12 : f64 = 0.307;
    pub const S_S2T12 : f64 = 0.013;
    pub const M_S2T23 : f64 = 0.558;
    pub const S_S2T23_LO : f64 = 0.021;
    pub const S_S2T23_HI : f64 = 0.015;
    pub const M_DCP_PI : f64 = 1.19;
    pub const S_DCP_PI : f64 = 0.22;
    // PDG 2024: m_H = 125.20 +- 0.11 GeV, m_Z = 91.1880 +- 0.0020 GeV
    pub const M_MH : f64 = 125.20;
    pub const S_MH : f64 = 0.11;
    pub const M_MZ : f64 = 91.1880;
    pub const S_MZ : f64 = 0.0020;
    // PDG 2024: m_s = 93.5 +- 0.8 MeV (MSbar, 2 GeV); m_mu = 105.6583755 (23) MeV (CODATA 2022 / PDG)
    pub const M_MS : f64 = 93.5;
    pub const S_MS : f64 = 0.8;
    pub const M_MMU : f64 = 105.6583755;
    pub const S_MMU : f64 = 0.0000023;
    // PDG 2024: m_b(m_b) = 4.183 +- 0.007 GeV, m_t (direct) = 172.57 +- 0.29 GeV
    pub const M_MB : f64 = 4.183;
    pub const S_MB : f64 = 0.007;
    pub const M_MT : f64 = 172.57;
    pub const S_MT : f64 = 0.29;
    // Planck 2018 (PDG 2024): Omega_b h^2 = 0.02237 +- 0.00015, h = 0.674 +- 0.005, n_s = 0.965 +- 0.004
    pub const M_OBH2 : f64 = 0.02237;
    pub const S_OBH2 : f64 = 0.00015;
    pub const M_H : f64 = 0.674;
    pub const S_H : f64 = 0.005;
    pub const M_NS : f64 = 0.965;
    pub const S_NS : f64 = 0.004;
    // HotQCD (Bazavov et al., Phys. Lett. B 795, 15): chiral crossover T_pc = 156.5 +- 1.5 MeV
    // (a lattice-QCD computation, not an experiment).
    pub const M_TPC : f64 = 156.5;
    pub const S_TPC : f64 = 1.5;
    // The other published Barbero-Immirzi count (specs/physics/gamma-conflict.t27, GAMMA_1): a theory
    // value with no measurement behind it.
    pub const GAMMA_COUNT_1 : f64 = 0.237532958;

    // x^n for an integer n, by repeated multiplication (t27 has no @pow).
    fn ipw(x: f64, n: i64) -> f64 {
        var r : f64 = 1.0;
        var i : i64 = 0;
        var m : i64 = n;
        if (n < 0) {
            m = 0 - n;
        }
        while (i < m) {
            r = r * x;
            i = i + 1;
        }
        if (n < 0) {
            return 1.0 / r;
        }
        return r;
    }

    // ===== The formulas (formula_registry.t27) =====

    pub const S1_gamma : f64 = ipw(PHI, 0 - 3);
    pub const PM1b_alpha_inv : f64 = (360.0 / ipw(PHI, 2)) - 2.0 / ipw(PHI, 3) + 1.0 / ipw(3.0 * PHI, 5);
    pub const N1_alpha_s : f64 = 1.0 / (ipw(PHI, 4) + PHI);
    pub const N2_Tc : f64 = 156.5;
    pub const CKM1_theta_C : f64 = (360.0 / ipw(PHI, 2)) / 16.0;
    pub const CKM2_V_cb : f64 = 1.0 / (7.0 * ipw(PHI, 2) * ipw(PI, 2) * ipw(E, 2));
    pub const PMNS2_sin2th23 : f64 = 3.0 * ipw(PHI, 0 - 8) * PI * E;
    pub const PMNS3_delta_CP : f64 = 9.0 * ipw(PHI, 0 - 2) * 180.0 / PI;
    pub const PMNS4_sin2th12 : f64 = 4.0 / (ipw(PHI, 2) * ipw(PI, 4) * ipw(E, 4));
    pub const H1_mH_mZ : f64 = (1.0 / 8.0) * ipw(PHI, 2) * ipw(PI, 3) * ipw(E, 0 - 2);

    pub const P10_V_ud : f64 = 7.0 * ipw(PHI, 0 - 5) * ipw(PI, 3) * ipw(E, 0 - 3);
    pub const P11_V_cs : f64 = 7.0 * ipw(PHI, 0 - 5) * ipw(PI, 3) * ipw(E, 0 - 3);
    pub const P12_V_td : f64 = 2.0 * ipw(PHI, 0 - 4) * ipw(PI, 0 - 4) * E;
    pub const P13_sin2th12_chimera : f64 = 8.0 * ipw(PHI, 0 - 5) * PI * ipw(E, 0 - 2);
    pub const P14_delta_CP_rad : f64 = 9.0 * ipw(PHI, 0 - 2);
    pub const P15_ms_mmu : f64 = ipw(PHI, 0 - 2) / PI * ipw(E, 2);
    pub const P16_mb_mt : f64 = 4.0 * ipw(PHI, 0 - 2) / PI * ipw(E, 0 - 3);
    pub const P17_Omega_b : f64 = 4.0 * ipw(PHI, 0 - 2) * ipw(PI, 0 - 3);
    pub const P18_ns : f64 = 3.0 * ipw(PHI, 3) * ipw(PI, 0 - 4) * ipw(E, 2);

    // Lattice complexity C = |k| + |m| + |p| + |q| of each formula inside the grammar
    // n * 3^k * pi^m * phi^p * e^q (n in 1..9); a negative value means "outside the grammar".
    pub const CX_OUTSIDE : i64 = 0 - 1;
    pub const CX_PMNS2 : i64 = 10;     // 3 * phi^-8 * pi * e
    pub const CX_PMNS4 : i64 = 10;     // 4 * phi^-2 * pi^-4 * e^-4
    pub const CX_P10 : i64 = 11;       // 7 * phi^-5 * pi^3 * e^-3
    pub const CX_P12 : i64 = 9;        // 2 * phi^-4 * pi^-4 * e
    pub const CX_P13 : i64 = 8;        // 8 * phi^-5 * pi * e^-2
    pub const CX_P14 : i64 = 2;        // 9 * phi^-2
    pub const CX_P15 : i64 = 5;        // phi^-2 * pi^-1 * e^2
    pub const CX_P16 : i64 = 6;        // 4 * phi^-2 * pi^-1 * e^-3
    pub const CX_P17 : i64 = 5;        // 4 * phi^-2 * pi^-3
    pub const CX_P18 : i64 = 9;        // 3 * phi^3 * pi^-4 * e^2

    // ===== Judging a formula against a measurement =====

    // The uncertainty on the side of the measurement the formula lies on (asymmetric errors).
    fn side_sigma(f: f64, x: f64, s_lo: f64, s_hi: f64) -> f64 {
        if (f < x) {
            return s_lo;
        }
        return s_hi;
    }

    // Distance of the formula from the measurement, in standard deviations.
    fn sigma_dist(f: f64, x: f64, s_lo: f64, s_hi: f64) -> f64 {
        return @abs(f - x) / side_sigma(f, x, s_lo, s_hi);
    }

    // Resolution of the test: what the measurement can tell apart from chance.
    fn resolution(f: f64, x: f64, s_lo: f64, s_hi: f64) -> f64 {
        const dist = @abs(f - x) / x;
        const coarse = side_sigma(f, x, s_lo, s_hi) / x;
        if (dist > coarse) {
            return dist;
        }
        return coarse;
    }

    // Lattice density at complexity C (points per unit ln), scaled from the lab value at C = 6.
    fn rho_at(c: i64) -> f64 {
        return RHO_C6 * (lattice_size(c) as f64) / (lattice_size(6) as f64);
    }

    // Chance that a random number fits as well as the formula does; only inside the grammar.
    fn fit_chance(f: f64, x: f64, s_lo: f64, s_hi: f64, c: i64) -> f64 {
        return chance(resolution(f, x, s_lo, s_hi), rho_at(c));
    }

    // Refuted when more than 3 sigma away; otherwise the lattice label (never EXACT or MEASURED for a
    // fit), and UNKNOWN outright when the formula lies outside the grammar.
    fn verdict(f: f64, x: f64, s_lo: f64, s_hi: f64, c: i64) -> u8 {
        if (sigma_dist(f, x, s_lo, s_hi) > REFUTE_SIGMA) {
            return VERDICT_REFUTED;
        }
        if (c < 0) {
            return LABEL_UNKNOWN;
        }
        return label(resolution(f, x, s_lo, s_hi), rho_at(c), TRIALS);
    }

    // Relative uncertainty of a ratio a/b of two independent measurements.
    fn ratio_rel_sigma(a: f64, sa: f64, b: f64, sb: f64) -> f64 {
        return @sqrt((sa / a) * (sa / a) + (sb / b) * (sb / b));
    }

    // Measured Higgs-to-Z mass ratio and its uncertainty.
    fn meas_mh_mz() -> f64 {
        return M_MH / M_MZ;
    }

    fn sig_mh_mz() -> f64 {
        return meas_mh_mz() * ratio_rel_sigma(M_MH, S_MH, M_MZ, S_MZ);
    }

    fn meas_ms_mmu() -> f64 {
        return M_MS / M_MMU;
    }

    fn sig_ms_mmu() -> f64 {
        return meas_ms_mmu() * ratio_rel_sigma(M_MS, S_MS, M_MMU, S_MMU);
    }

    fn meas_mb_mt() -> f64 {
        return M_MB / M_MT;
    }

    fn sig_mb_mt() -> f64 {
        return meas_mb_mt() * ratio_rel_sigma(M_MB, S_MB, M_MT, S_MT);
    }

    // Omega_b = (Omega_b h^2) / h^2: the error of h counts twice.
    fn meas_omega_b() -> f64 {
        return M_OBH2 / (M_H * M_H);
    }

    fn sig_omega_b() -> f64 {
        return meas_omega_b() * @sqrt((S_OBH2 / M_OBH2) * (S_OBH2 / M_OBH2) + 4.0 * (S_H / M_H) * (S_H / M_H));
    }

    // delta_CP in radians.
    fn meas_dcp() -> f64 {
        return M_DCP_PI * PI;
    }

    fn sig_dcp() -> f64 {
        return S_DCP_PI * PI;
    }

    // The Cabibbo angle is judged through V_us = sin(theta_C): the measurement is V_us.
    fn ckm1_vus() -> f64 {
        return @sin(CKM1_theta_C * PI / 180.0);
    }

    // Relative gap between two numbers.
    fn rel_gap(a: f64, b: f64) -> f64 {
        return @abs(a - b) / b;
    }

    fn trinity(phi: f64) -> f64 {
        return phi * phi + 1.0 / (phi * phi);
    }

    // ===== Chimera search helpers =====

    /// Combine two formulas with arithmetic operations
    fn chimera_mul(a: f64, b: f64) -> f64 {
        return a * b;
    }

    fn chimera_div(a: f64, b: f64) -> f64 {
        if (@abs(b) < 1.0e-15) {
            return 0.0;
        }
        return a / b;
    }

    fn chimera_add(a: f64, b: f64) -> f64 {
        return a + b;
    }

    fn chimera_sub(a: f64, b: f64) -> f64 {
        return a - b;
    }

    fn chimera_sin(x: f64) -> f64 {
        return @sin(x);
    }

    fn chimera_cos(x: f64) -> f64 {
        return @cos(x);
    }

    fn chimera_ln(x: f64) -> f64 {
        if (x <= 0.0) {
            return 0.0;
        }
        return @log(x);
    }

    fn chimera_exp(x: f64) -> f64 {
        return @exp(x);
    }

    fn chimera_pow(x: f64, n: f64) -> f64 {
        return @exp(n * @log(x));
    }

    // ===== Pattern generation =====

    // One generated pattern phi^i * pi^j * e^k and its value. t27 has no heap vector and no string
    // formatting, so each label is kept as the three exponents that fully determine it, and the list
    // is a fixed-capacity array with a length.
    struct BasisEntry {
        i: i32;
        j: i32;
        k: i32;
        value: f64;
    }

    // Capacity of a Basis: (2 * max_pow + 1)^3 entries, sized for max_pow <= 6. 6 is the default
    // --max-pow of `formula chimera-search` (bootstrap/src/formula_eval.rs), which keeps all
    // (2*6+1)^3 = 2197 patterns.
    const BASIS_MAX_POW: i32 = 6;
    const BASIS_CAPACITY: u32 = 2197;

    struct Basis {
        entries: [BASIS_CAPACITY]BasisEntry;
        len: u32;
    }

    fn basis_entry_zero() -> BasisEntry {
        return BasisEntry{ i = 0, j = 0, k = 0, value = 0.0 };
    }

    /// Generate the phi^i * pi^j * e^k patterns
    fn generate_basis(max_pow: i32) -> Basis {
        var basis = Basis{
            entries = [basis_entry_zero(); BASIS_CAPACITY],
            len = 0,
        };
        var i : i32 = 0 - max_pow;
        while (i <= max_pow) {
            var j : i32 = 0 - max_pow;
            while (j <= max_pow) {
                var k : i32 = 0 - max_pow;
                while (k <= max_pow) {
                    const val = ipw(PHI, i as i64) * ipw(PI, j as i64) * ipw(E, k as i64);
                    // Fixed capacity: patterns past BASIS_CAPACITY, i.e. max_pow > BASIS_MAX_POW,
                    // are not stored.
                    if (basis.len < BASIS_CAPACITY) {
                        basis.entries[basis.len] = BasisEntry{ i = i, j = j, k = k, value = val };
                        basis.len = basis.len + 1;
                    }
                    k = k + 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return basis;
    }

    // ===== Tests: every expected value is a measurement, never the formula's own output =====

    test "the default basis holds all (2 * 6 + 1)^3 = 2197 patterns" {
        const b = generate_basis(BASIS_MAX_POW);
        assert(b.len == 2197);
        // the pattern with all exponents zero is the number 1
        assert(b.entries[1098].i == 0 && b.entries[1098].j == 0 && b.entries[1098].k == 0);
        assert(b.entries[1098].value == 1.0);
    }

    test "the trinity identity phi^2 + phi^-2 = 3 is exact" {
        assert(@abs(trinity(PHI) - 3.0) < 1.0e-15);
        assert(@abs(trinity((1.0 + @sqrt(5.0)) / 2.0) - 3.0) < 1.0e-15);
    }

    test "S1_gamma has no measurement; the other published count differs by 0.6 percent" {
        // GAMMA_COUNT_1 is a theory value (gamma-conflict.t27), not data: the formula cannot be tested
        // against it, only compared. The two disagree, so at most one is the Barbero-Immirzi parameter.
        const gap = rel_gap(S1_gamma, GAMMA_COUNT_1);
        assert(gap > 0.0060 && gap < 0.0063);
        assert(rel_gap(S1_gamma, 0.2360679775) < 1.0e-9);
    }

    test "PM1b matches CODATA 2022 1/alpha within 1 sigma but sits outside the lattice grammar" {
        assert(sigma_dist(PM1b_alpha_inv, M_ALPHA_INV, S_ALPHA_INV, S_ALPHA_INV) < 1.0);
        assert(verdict(PM1b_alpha_inv, M_ALPHA_INV, S_ALPHA_INV, S_ALPHA_INV, CX_OUTSIDE) == LABEL_UNKNOWN);
    }

    test "N1_alpha_s agrees with PDG 2024 alpha_s(mZ) but the measurement cannot tell it from chance" {
        const f = N1_alpha_s;
        assert(sigma_dist(f, M_ALPHA_S, S_ALPHA_S, S_ALPHA_S) < 0.1);
        assert(resolution(f, M_ALPHA_S, S_ALPHA_S, S_ALPHA_S) > 0.0075);
        assert(verdict(f, M_ALPHA_S, S_ALPHA_S, S_ALPHA_S, CX_OUTSIDE) == LABEL_UNKNOWN);
        // N1 is S1 / 2: the same fit twice, not two.
        assert(@abs(N1_alpha_s - S1_gamma / 2.0) < 1.0e-12);
    }

    test "N2_Tc is the HotQCD crossover temperature itself, a lattice computation and no formula" {
        assert(sigma_dist(N2_Tc, M_TPC, S_TPC, S_TPC) == 0.0);
        assert(resolution(N2_Tc, M_TPC, S_TPC, S_TPC) > 0.0095 && resolution(N2_Tc, M_TPC, S_TPC, S_TPC) < 0.0097);
    }

    test "CKM1 theta_C = 8.59 deg is refuted by the measured V_us" {
        const sd = sigma_dist(ckm1_vus(), M_VUS, S_VUS, S_VUS);
        assert(sd > 50.0);
        assert(verdict(ckm1_vus(), M_VUS, S_VUS, S_VUS, CX_OUTSIDE) == VERDICT_REFUTED);
    }

    test "CKM2 V_cb is refuted by the measured V_cb" {
        assert(sigma_dist(CKM2_V_cb, M_VCB, S_VCB, S_VCB) > 20.0);
        assert(verdict(CKM2_V_cb, M_VCB, S_VCB, S_VCB, CX_OUTSIDE) == VERDICT_REFUTED);
    }

    test "PMNS2 sin^2 th23 agrees with PDG 2024 within 1 sigma, at the chance rate" {
        const sd = sigma_dist(PMNS2_sin2th23, M_S2T23, S_S2T23_LO, S_S2T23_HI);
        assert(sd > 0.4 && sd < 1.0);
        assert(fit_chance(PMNS2_sin2th23, M_S2T23, S_S2T23_LO, S_S2T23_HI, CX_PMNS2) > 0.99);
        assert(verdict(PMNS2_sin2th23, M_S2T23, S_S2T23_LO, S_S2T23_HI, CX_PMNS2) == LABEL_UNKNOWN);
    }

    test "PMNS3 and P14 are one formula for delta_CP and agree with PDG 2024 at the chance rate" {
        // PMNS3 is P14 converted to degrees.
        assert(@abs(PMNS3_delta_CP * PI / 180.0 - P14_delta_CP_rad) < 1.0e-12);
        assert(sigma_dist(P14_delta_CP_rad, meas_dcp(), sig_dcp(), sig_dcp()) < 1.0);
        assert(fit_chance(P14_delta_CP_rad, meas_dcp(), sig_dcp(), sig_dcp(), CX_P14) > 0.99);
        assert(verdict(P14_delta_CP_rad, meas_dcp(), sig_dcp(), sig_dcp(), CX_P14) == LABEL_UNKNOWN);
    }

    test "PMNS4 sin^2 th12 = 2.9e-4 is refuted by the measured 0.307" {
        assert(sigma_dist(PMNS4_sin2th12, M_S2T12, S_S2T12, S_S2T12) > 20.0);
        assert(verdict(PMNS4_sin2th12, M_S2T12, S_S2T12, S_S2T12, CX_PMNS4) == VERDICT_REFUTED);
    }

    test "H1 m_H / m_Z is judged against the measured ratio of the two masses" {
        const sd = sigma_dist(H1_mH_mZ, meas_mh_mz(), sig_mh_mz(), sig_mh_mz());
        assert(sd < 1.0);
        assert(verdict(H1_mH_mZ, meas_mh_mz(), sig_mh_mz(), sig_mh_mz(), CX_OUTSIDE) == LABEL_UNKNOWN);
    }

    test "P10 V_ud is 2 to 3 sigma from the measured V_ud and sits at the chance rate" {
        const sd = sigma_dist(P10_V_ud, M_VUD, S_VUD, S_VUD);
        assert(sd > 2.0 && sd < 3.0);
        assert(fit_chance(P10_V_ud, M_VUD, S_VUD, S_VUD, CX_P10) > 0.99);
        assert(verdict(P10_V_ud, M_VUD, S_VUD, S_VUD, CX_P10) == LABEL_UNKNOWN);
    }

    test "P11 V_cs agrees with the measured V_cs only because that measurement is coarse" {
        assert(P11_V_cs == P10_V_ud);
        assert(sigma_dist(P11_V_cs, M_VCS, S_VCS, S_VCS) < 0.5);
        assert(verdict(P11_V_cs, M_VCS, S_VCS, S_VCS, CX_P10) == LABEL_UNKNOWN);
    }

    test "P12 V_td is 2 to 3 sigma from the measured V_td" {
        const sd = sigma_dist(P12_V_td, M_VTD, S_VTD, S_VTD);
        assert(sd > 2.0 && sd < 3.0);
        assert(verdict(P12_V_td, M_VTD, S_VTD, S_VTD, CX_P12) == LABEL_UNKNOWN);
    }

    test "P13 sin^2 th12 agrees with PDG 2024 at the chance rate" {
        assert(sigma_dist(P13_sin2th12_chimera, M_S2T12, S_S2T12, S_S2T12) < 0.5);
        assert(fit_chance(P13_sin2th12_chimera, M_S2T12, S_S2T12, S_S2T12, CX_P13) > 0.99);
        assert(verdict(P13_sin2th12_chimera, M_S2T12, S_S2T12, S_S2T12, CX_P13) == LABEL_UNKNOWN);
    }

    test "P15 m_s / m_mu is 1 to 3 sigma from the measured ratio, at the chance rate" {
        const sd = sigma_dist(P15_ms_mmu, meas_ms_mmu(), sig_ms_mmu(), sig_ms_mmu());
        assert(sd > 1.0 && sd < 3.0);
        assert(verdict(P15_ms_mmu, meas_ms_mmu(), sig_ms_mmu(), sig_ms_mmu(), CX_P15) == LABEL_UNKNOWN);
    }

    test "P16 m_b / m_t agrees with the measured ratio, at the chance rate" {
        assert(sigma_dist(P16_mb_mt, meas_mb_mt(), sig_mb_mt(), sig_mb_mt()) < 1.0);
        assert(fit_chance(P16_mb_mt, meas_mb_mt(), sig_mb_mt(), sig_mb_mt(), CX_P16) > 0.8);
        assert(verdict(P16_mb_mt, meas_mb_mt(), sig_mb_mt(), sig_mb_mt(), CX_P16) == LABEL_UNKNOWN);
    }

    test "P17 Omega_b agrees with Planck 2018 at the chance rate" {
        assert(sigma_dist(P17_Omega_b, meas_omega_b(), sig_omega_b(), sig_omega_b()) < 1.0);
        assert(verdict(P17_Omega_b, meas_omega_b(), sig_omega_b(), sig_omega_b(), CX_P17) == LABEL_UNKNOWN);
    }

    test "P18 n_s agrees with Planck 2018 at the chance rate" {
        assert(sigma_dist(P18_ns, M_NS, S_NS, S_NS) < 0.5);
        assert(fit_chance(P18_ns, M_NS, S_NS, S_NS, CX_P18) > 0.99);
        assert(verdict(P18_ns, M_NS, S_NS, S_NS, CX_P18) == LABEL_UNKNOWN);
    }

    test "the density scaling reproduces the lab null rates at C = 4 and C = 8" {
        // Lab, 200 000 log-uniform targets: P(err < 0.1%) = 22.5% at C = 4 and 93.6% at C = 8.
        assert(@abs(chance(0.001, rho_at(4)) - 0.225) < 0.03);
        assert(@abs(chance(0.001, rho_at(8)) - 0.936) < 0.02);
    }

    test "a sharp measurement would still tell a lattice fit from chance" {
        // Control: at a resolution of 1e-6 and C = 5 the chance is small, so the machinery can say
        // SUGGESTED; it is the coarse measurements that make every verdict above UNKNOWN.
        assert(chance(0.000001, rho_at(5)) < 0.05);
        assert(label(0.000001, rho_at(5), 1.0) == LABEL_SUGGESTED);
        assert(label(0.000001, rho_at(5), TRIALS) == LABEL_SUGGESTED);
    }

    // ===== Invariants =====

    test "no formula in this file is EXACT, MEASURED or SUGGESTED by fit" {
        assert(verdict(PM1b_alpha_inv, M_ALPHA_INV, S_ALPHA_INV, S_ALPHA_INV, CX_OUTSIDE) == LABEL_UNKNOWN);
        assert(verdict(N1_alpha_s, M_ALPHA_S, S_ALPHA_S, S_ALPHA_S, CX_OUTSIDE) == LABEL_UNKNOWN);
        assert(verdict(PMNS2_sin2th23, M_S2T23, S_S2T23_LO, S_S2T23_HI, CX_PMNS2) == LABEL_UNKNOWN);
        assert(verdict(P14_delta_CP_rad, meas_dcp(), sig_dcp(), sig_dcp(), CX_P14) == LABEL_UNKNOWN);
        assert(verdict(P10_V_ud, M_VUD, S_VUD, S_VUD, CX_P10) == LABEL_UNKNOWN);
        assert(verdict(P12_V_td, M_VTD, S_VTD, S_VTD, CX_P12) == LABEL_UNKNOWN);
        assert(verdict(P13_sin2th12_chimera, M_S2T12, S_S2T12, S_S2T12, CX_P13) == LABEL_UNKNOWN);
        assert(verdict(P15_ms_mmu, meas_ms_mmu(), sig_ms_mmu(), sig_ms_mmu(), CX_P15) == LABEL_UNKNOWN);
        assert(verdict(P16_mb_mt, meas_mb_mt(), sig_mb_mt(), sig_mb_mt(), CX_P16) == LABEL_UNKNOWN);
        assert(verdict(P17_Omega_b, meas_omega_b(), sig_omega_b(), sig_omega_b(), CX_P17) == LABEL_UNKNOWN);
        assert(verdict(P18_ns, M_NS, S_NS, S_NS, CX_P18) == LABEL_UNKNOWN);
        // the refuted ones: CKM1, CKM2, PMNS4
        assert(verdict(ckm1_vus(), M_VUS, S_VUS, S_VUS, CX_OUTSIDE) == VERDICT_REFUTED);
        assert(verdict(CKM2_V_cb, M_VCB, S_VCB, S_VCB, CX_OUTSIDE) == VERDICT_REFUTED);
        assert(verdict(PMNS4_sin2th12, M_S2T12, S_S2T12, S_S2T12, CX_PMNS4) == VERDICT_REFUTED);
    }

    invariant "the measured targets are not the formulas' values" {
        // Guard against the old failure: a target copied from the formula under test.
        assert(M_ALPHA_S != N1_alpha_s);
        assert(M_NS != P18_ns);
        assert(M_VUD != P10_V_ud);
    }
}
