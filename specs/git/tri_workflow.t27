// SPDX-License-Identifier: Apache-2.0
// specs/git/tri_workflow.t27 -- tri git commit / push / status behind the skill gate
// ADR-002 command formula from .claude/skills/tri/skill.md:
//   NO-COMMIT-WITHOUT-ISSUE, NO-MUTATION-WITHOUT-SKILL, Policy Matrix on push.
// phi^2 + 1/phi^2 = 3 | TRINITY

module git-tri-workflow;

// ============================================================================
// Exit codes
//
// Every tri git command speaks in exit codes: 0 pass; 1 no active skill;
// 2 no bound issue; 3 toxic verdict; 4 unsealed work; 5 policy matrix fail.
// ============================================================================

pub const EXIT_OK : u8 = 0;
pub const EXIT_NO_SKILL : u8 = 1;
pub const EXIT_NO_ISSUE : u8 = 2;
pub const EXIT_TOXIC : u8 = 3;
pub const EXIT_UNSEALED : u8 = 4;
pub const EXIT_POLICY : u8 = 5;

// ============================================================================
// Skill kinds (Policy Matrix)
// ============================================================================

pub const KIND_NORMAL : u8 = 0;
pub const KIND_HOTFIX : u8 = 1;
pub const KIND_RECOVERY : u8 = 2;

pub const HOTFIX_MIN_CHECKPOINTS : u8 = 1;
pub const RECOVERY_MIN_CHECKPOINTS : u8 = 3;

// ============================================================================
// L1 TRACEABILITY -- issue reference verbs
// ============================================================================

pub const REF_CLOSES : []const u8 = "Closes #";
pub const REF_FIXES : []const u8 = "Fixes #";
pub const REF_RESOLVES : []const u8 = "Resolves #";
pub const REF_REFERENCE : []const u8 = "Reference #";

// ============================================================================
// L1 scanner duty -- deliberately NOT a function in this spec.
//
// The raw byte scan over the commit message runs in the binding layer: string
// parameters do not survive the Verilog testbench lowering (the emitter maps
// `[]const u8` to `input [31:0]` and leaves `param.len` unbound -- measured
// here; same class as specs/tri/net/url.t27). The SSOT for WHAT to scan for
// stays here: the four REF_* verbs above. The spec owns how the four findings
// combine; the binding owns finding them, byte for byte, against these
// constants.
// ============================================================================

// ============================================================================
// tri git commit -- NO-COMMIT-WITHOUT-ISSUE
//
// The commit gate: an active skill with a bound, non-toxic issue is the only
// door to a commit. Everything else is refused before git is invoked.
// ============================================================================

pub fn commit_gate(skill_present: bool, issue_bound: bool, skill_toxic: bool) u8 {
    if (!skill_present) {
        return EXIT_NO_SKILL;
    }
    if (!issue_bound) {
        return EXIT_NO_ISSUE;
    }
    if (skill_toxic) {
        return EXIT_TOXIC;
    }
    return EXIT_OK;
}

// L1: the message passes when the scanner found ANY of the four verbs.
pub fn message_references_issue(has_closes: bool, has_fixes: bool, has_resolves: bool, has_reference: bool) bool {
    return has_closes or has_fixes or has_resolves or has_reference;
}

// Does the message need `Closes #N` appended (i.e. the scanner found nothing)?
pub fn needs_issue_suffix(has_reference: bool) bool {
    return !has_reference;
}

// ============================================================================
// tri git push -- Policy Matrix
//
// A push requires a sealed, non-toxic skill. On top of that the kind decides:
// recovery needs >= 3 checkpoints plus spec and docs artifacts; hotfix needs
// >= 1 checkpoint; normal has no artifact floor.
// ============================================================================

pub fn push_gate(active_cells: u8, sealed: bool, toxic: bool, kind: u8, checkpoints: u8, has_spec: bool, has_docs: bool) u8 {
    if (active_cells > 0) {
        return EXIT_UNSEALED;
    }
    if (!sealed) {
        return EXIT_UNSEALED;
    }
    if (toxic) {
        return EXIT_TOXIC;
    }
    if (kind == KIND_RECOVERY) {
        if (checkpoints < RECOVERY_MIN_CHECKPOINTS) {
            return EXIT_POLICY;
        }
        if (!has_spec or !has_docs) {
            return EXIT_POLICY;
        }
    }
    if (kind == KIND_HOTFIX) {
        if (checkpoints < HOTFIX_MIN_CHECKPOINTS) {
            return EXIT_POLICY;
        }
    }
    return EXIT_OK;
}

// ============================================================================
// tri git status -- porcelain summary counts
// ============================================================================

pub fn is_clean(modified: u32, added: u32, deleted: u32, untracked: u32) bool {
    return modified == 0 and added == 0 and deleted == 0 and untracked == 0;
}

pub fn changed_file_count(modified: u32, added: u32, deleted: u32, untracked: u32) u32 {
    return modified + added + deleted + untracked;
}

// ============================================================================
// TDD: TESTS
// ============================================================================

test "commit gate refuses an absent skill" {
    assert commit_gate(false, false, false) == EXIT_NO_SKILL;
}

test "commit gate refuses an unbound issue" {
    assert commit_gate(true, false, false) == EXIT_NO_ISSUE;
}

test "commit gate refuses a toxic verdict" {
    assert commit_gate(true, true, true) == EXIT_TOXIC;
}

test "commit gate opens for an active bound clean skill" {
    assert commit_gate(true, true, false) == EXIT_OK;
}

test "L1 accepts each reference verb alone" {
    assert message_references_issue(true, false, false, false);
    assert message_references_issue(false, true, false, false);
    assert message_references_issue(false, false, true, false);
    assert message_references_issue(false, false, false, true);
}

test "L1 rejects a message whose scanner found nothing" {
    assert !message_references_issue(false, false, false, false);
}

test "a message with no verb needs the issue suffix" {
    assert needs_issue_suffix(false);
    assert !needs_issue_suffix(true);
}

test "push is blocked by any active cell" {
    assert push_gate(1, true, false, KIND_NORMAL, 3, true, true) == EXIT_UNSEALED;
}

test "push is blocked by an unsealed skill" {
    assert push_gate(0, false, false, KIND_NORMAL, 0, false, false) == EXIT_UNSEALED;
}

test "push is blocked by a toxic verdict" {
    assert push_gate(0, true, true, KIND_NORMAL, 1, false, false) == EXIT_TOXIC;
}

test "recovery kind demands three checkpoints and both artifacts" {
    assert push_gate(0, true, false, KIND_RECOVERY, 2, true, true) == EXIT_POLICY;
    assert push_gate(0, true, false, KIND_RECOVERY, 3, true, false) == EXIT_POLICY;
    assert push_gate(0, true, false, KIND_RECOVERY, 3, false, true) == EXIT_POLICY;
    assert push_gate(0, true, false, KIND_RECOVERY, 3, true, true) == EXIT_OK;
}

test "hotfix kind demands one checkpoint but no artifacts" {
    assert push_gate(0, true, false, KIND_HOTFIX, 0, false, false) == EXIT_POLICY;
    assert push_gate(0, true, false, KIND_HOTFIX, 1, false, false) == EXIT_OK;
}

test "normal kind passes once sealed and clean" {
    assert push_gate(0, true, false, KIND_NORMAL, 0, false, false) == EXIT_OK;
}

test "status cleanliness and change counting" {
    assert is_clean(0, 0, 0, 0);
    assert !is_clean(1, 0, 0, 0);
    assert changed_file_count(1, 1, 1, 1) == 4;
}

// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant commit_gate_ok_only_with_full_binding
    assert commit_gate(true, true, false) == EXIT_OK

invariant toxic_beats_bound_issue
    assert commit_gate(true, true, true) == EXIT_TOXIC

invariant no_skill_beats_no_issue
    assert commit_gate(false, false, false) == EXIT_NO_SKILL

invariant exit_codes_are_pairwise_distinct
    assert EXIT_OK != EXIT_NO_SKILL and EXIT_NO_SKILL != EXIT_NO_ISSUE and EXIT_NO_ISSUE != EXIT_TOXIC and EXIT_TOXIC != EXIT_UNSEALED and EXIT_UNSEALED != EXIT_POLICY

invariant recovery_checkpoint_floor_is_three
    assert RECOVERY_MIN_CHECKPOINTS == 3

invariant hotfix_checkpoint_floor_is_one
    assert HOTFIX_MIN_CHECKPOINTS == 1

invariant every_issue_verb_carries_a_hash
    assert REF_CLOSES[REF_CLOSES.len - 1] == '#' and REF_FIXES[REF_FIXES.len - 1] == '#' and REF_RESOLVES[REF_RESOLVES.len - 1] == '#' and REF_REFERENCE[REF_REFERENCE.len - 1] == '#'

// ============================================================================
// TDD: BENCHES -- the hot path is the gate, called on every commit and push.
// ============================================================================

bench "commit_gate" {
    _ = commit_gate(true, true, false);
}

bench "push_gate_normal" {
    _ = push_gate(0, true, false, KIND_NORMAL, 1, false, false);
}

bench "message_references_issue" {
    _ = message_references_issue(true, false, false, false);
}

bench "needs_issue_suffix" {
    _ = needs_issue_suffix(true);
}
