// SPDX-License-Identifier: Apache-2.0
// specs/boards/ax7203.t27 -- ALINX AX7203 / XC7A200T-FBG484-2, the board on this bench.
//
// WHY THIS EXISTS. fpga/HARDWARE_SSOT.md, section 2026-10-08 (#7788), records that the
// board on the bench is an ALINX AX7203 with an xc7a200tfbg484-2: a camera read "ALINX"
// off the PCB and the AX7203 gf8 bitstream answered 512/512 over its UART. Before this
// file no spec described that board. specs/boards/wukong_v1.t27 still says "the board
// actually on this bench" about a QMTech Wukong in the 676-ball FGG676, and the t27.ai
// course reads its lesson 1 from it. That file is sealed and is left as it is; this one
// is the spec a lesson should point at.
//
// WHAT IT STATES: the part, the measured JTAG IDCODE, the package, and the fabric totals
// of the XC7A200T die. Three of the totals are the ones the widget specs already use
// (specs/widgets/fits_on.t27 K_CAPACITY, resource_bars.t27 K_TOTALS): 134,600 LUT6,
// 269,200 flip-flops, 740 DSP48E1. The tests tie them to the slice count, so a reader
// sees where each number comes from instead of trusting four separate literals.
//
// THE TRAP IT EXISTS TO NAME: AMD quotes "215,360 logic cells" for this die. A logic cell
// is a marketing unit, 1.6 per LUT6; it is not a LUT. wukong_v1.t27 stores 215,360 under
// the name LUT_TOTAL, and the course asks the reader to find that constant. The LUT count
// is LUT6_TOTAL below.
//
// SOURCES: part and IDCODE: fpga/HARDWARE_SSOT.md 2026-10-08 and 2026-10-20 (IDCODE
// 0x3636093 read at HS2 busdev 0:4). Fabric totals: AMD DS180 (7 Series FPGAs Data Sheet:
// Overview), XC7A200T row. Ball count: the package name, FBG484 = 484 balls.
//
// NOT CLAIMED: no pin map, no DDR3 size, no flash size. The AX7203 carries DDR3 and a
// QSPI flash, but neither size was measured on this bench, so neither is stated here.
// The DRAM rule of wukong_v1.t27 holds: no capacity is guessed from another board.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module boards_ax7203;

pub const BOARD_NAME : str = "ALINX AX7203";
pub const FPGA_PART : str = "xc7a200tfbg484-2";
pub const FPGA_FAMILY : str = "artix7";
pub const PACKAGE : str = "fbg484";
pub const PACKAGE_BALLS : u32 = 484;
pub const SPEED_GRADE : u8 = 2;

// Measured: HARDWARE_SSOT.md 2026-10-20, openFPGALoader --detect at busdev 0:4.
pub const JTAG_IDCODE : u32 = 0x03636093;
pub const IDCODE_MEASURED : bool = true;

// DS180, XC7A200T. A slice holds 4 LUT6 and 8 flip-flops.
pub const SLICES : u32 = 33_650;
pub const LUT6_TOTAL : u32 = 134_600;
pub const FF_TOTAL : u32 = 269_200;
pub const LOGIC_CELLS : u32 = 215_360;
pub const DSP48E1_TOTAL : u32 = 740;
pub const BRAM36_TOTAL : u32 = 365;

pub const LUTS_PER_SLICE : u32 = 4;
pub const FFS_PER_SLICE : u32 = 8;
// AMD's logic-cell ratio, 1.6, held as 16 / 10 so the arithmetic stays integral.
pub const CELLS_PER_LUT_NUM : u32 = 16;
pub const CELLS_PER_LUT_DEN : u32 = 10;

// The package the course's pin map draws (specs/widgets/pin_map.t27): the same die in
// the Wukong's FGG676. Kept so a test can say the two are not the same package.
pub const WUKONG_PACKAGE_BALLS : u32 = 676;

// The IDCODE fields of IEEE 1149.1: version [31:28], part [27:12], maker [11:1], bit 0 = 1.
pub fn idcode_part(id: u32) -> u32 {
    return (id >> 12) & 0xFFFF;
}

pub fn idcode_maker(id: u32) -> u32 {
    return (id >> 1) & 0x7FF;
}

// The logic-cell figure AMD would print for a die with this many LUT6.
pub fn logic_cells_of(lut6: u32) -> u32 {
    return lut6 * CELLS_PER_LUT_NUM / CELLS_PER_LUT_DEN;
}

test the_luts_are_four_per_slice {
    assert SLICES * LUTS_PER_SLICE == LUT6_TOTAL;
}

test the_flip_flops_are_eight_per_slice {
    assert SLICES * FFS_PER_SLICE == FF_TOTAL;
}

test a_logic_cell_is_not_a_lut {
    assert logic_cells_of(LUT6_TOTAL) == LOGIC_CELLS;
    // Negative control: the Wukong spec's LUT_TOTAL is the logic-cell figure.
    assert LOGIC_CELLS != LUT6_TOTAL;
    assert LOGIC_CELLS > LUT6_TOTAL;
}

test the_idcode_is_a_xilinx_200t {
    assert (JTAG_IDCODE & 1) == 1;
    assert idcode_part(JTAG_IDCODE) == 0x3636;
    assert idcode_maker(JTAG_IDCODE) == 0x049;
    // Negative control: the XC7A100T part field is 0x3631, not this die.
    assert idcode_part(0x13631093) != idcode_part(JTAG_IDCODE);
}

test this_package_is_not_the_one_the_pin_map_draws {
    assert PACKAGE_BALLS == 484;
    assert PACKAGE_BALLS != WUKONG_PACKAGE_BALLS;
    assert IDCODE_MEASURED;
}
