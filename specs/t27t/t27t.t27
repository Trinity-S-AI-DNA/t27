// SPDX-License-Identifier: Apache-2.0
; specs/t27t/t27t.t27 -- t27t, the t27 trainer: how a training run gets cheaper, measured, not promised.
; --
; What t27t is.
; - t27t is the name of the t27 training product. Its law is this file; its runner today is the
;   PyTorch trainer gHashTag/igla-coder-gpu (train.py, the tern-tc 9m / 100m / 500m models).
;   The runner does not change its language: t27t says what the runner must do and checks it.
; - Its first rule comes from one bench (gHashTag/t27#10360, RTX 4090, CUTLASS 3.5.1, 2026-10-18):
;   a training step gets cheaper when the FORWARD GEMMs run on int8 tensor cores (mma.sync s8,
;   reached from PyTorch by torch._int_mm) and the gradients stay in bf16. No t27c CUDA backend is
;   needed for that.
; - Its second rule is the papers check (specs/numeric/paper_claims.t27, `tri papers`): a number
;   t27t prints about its formats is one a spec can recompute. 45 printed numbers in three papers
;   were recomputed: 34 fit, 8 do not, 3 cannot be checked. Those counts live in that spec, not here.
; - Its second runner is t27's own: the HSLM trainer specs/ml/train_hslm.t27 compiled by t27c
;   --backend ml, on one CPU thread in f64 (gHashTag/t27#10850). Its profile says where a step goes:
;   94.2% in the three matmul kernels, 66.8% in the two backward ones, 42.4% in outer_add alone.
;   Four levers are bounded from that split and not built; two of them need t27c support that
;   --backend ml does not have.
; --
; The rules of this file.
; - Times are in units of 10^-4 ms (0.2254 ms is 2254). Speed ratios are in hundredths (2.93x is 293).
;   Savings are in tenths of a percent (21.8% is 218), which is also dimes saved on a $100 run.
; - Every ratio the bench comment printed is kept beside the times it came from, and a test
;   recomputes it from those times. The times were printed to four digits, so a recomputed ratio
;   may differ from the printed one by one hundredth (3.5456 from 0.8506 / 0.2399 against a printed
;   3.54); the tests allow exactly that and nothing more.
; - What was not measured is listed as not measured (NOT_MEASURED). Above all f, the share of a
;   real tern-tc-500m step spent in forward GEMMs, is an estimate: F_MEASURED is false.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27t;

pub const NAME : str = "t27t";
pub const RUNNER : str = "gHashTag/igla-coder-gpu train.py (PyTorch)";
pub const BENCH : str = "gHashTag/t27#10360: RTX 4090, CUTLASS 3.5.1, sm_89, CUDA 12.4, 2026-10-18";

; The runner's forward GEMM is not yet wired to torch._int_mm, and f has not been measured.
pub const RUNNER_USES_INT_MM : bool = false;
pub const F_MEASURED : bool = false;

// ---------------------------------------------------------------- the bench

pub const SHAPES : u32 = 5;

pub const SHAPE_NAME : [5]str = [
    "4096 x 3456 x 1280 (FFN up)",
    "4096 x 1280 x 3456 (FFN down)",
    "16384 x 3456 x 1280",
    "16384 x 1280 x 3456",
    "16384 x 1280 x 1280 (attn proj)"
];

pub const SHAPE_M : [5]u64 = [4096, 4096, 16384, 16384, 16384];
pub const SHAPE_N : [5]u64 = [3456, 1280, 3456, 1280, 1280];
pub const SHAPE_K : [5]u64 = [1280, 3456, 1280, 3456, 1280];

; Fastest CUTLASS kernel per shape and data type, 50 timed iterations after 10 warm-up.
pub const T_BF16 : [5]u64 = [2254, 2239, 8540, 8506, 3215];
pub const T_INT8_TC : [5]u64 = [770, 773, 2701, 2399, 1007];
pub const T_DP4A : [5]u64 = [2406, 2470, 9234, 9278, 3460];

; Ratios as the bench comment printed them.
pub const X_INT8_TC_PRINTED : [5]u64 = [293, 290, 316, 354, 319];
pub const X_DP4A_PRINTED : [5]u64 = [94, 91, 92, 92, 93];

; The datasheet promise for int8 over bf16 tensor cores on Ada, in hundredths.
pub const X_DATASHEET : u64 = 400;

; Speed of a path against bf16, rounded half up to hundredths.
pub fn ratio_e2(t_bf16: u64, t_path: u64) -> u64 {
    return (t_bf16 * 200 + t_path) / (2 * t_path);
}

pub fn within_one(a: u64, b: u64) -> bool {
    if (a > b) { return a - b <= 1; }
    return b - a <= 1;
}

pub fn x_int8_tc(i: u32) -> u64 {
    return ratio_e2(T_BF16[i], T_INT8_TC[i]);
}

pub fn x_dp4a(i: u32) -> u64 {
    return ratio_e2(T_BF16[i], T_DP4A[i]);
}

pub const COL_INT8_TC : u32 = 0;
pub const COL_DP4A : u32 = 1;

pub fn printed(col: u32, i: u32) -> u64 {
    if (col == COL_DP4A) { return X_DP4A_PRINTED[i]; }
    return X_INT8_TC_PRINTED[i];
}

pub fn min_printed(col: u32) -> u64 {
    var i : u32 = 1;
    var m : u64 = printed(col, 0);
    while (i < SHAPES) {
        if (printed(col, i) < m) { m = printed(col, i); }
        i = i + 1;
    }
    return m;
}

pub fn max_printed(col: u32) -> u64 {
    var i : u32 = 1;
    var m : u64 = printed(col, 0);
    while (i < SHAPES) {
        if (printed(col, i) > m) { m = printed(col, i); }
        i = i + 1;
    }
    return m;
}

/// How many shapes have a recomputed ratio within one hundredth of the printed one.
pub fn printed_ratios_that_hold() -> u32 {
    var i : u32 = 0;
    var c : u32 = 0;
    while (i < SHAPES) {
        if (within_one(x_int8_tc(i), X_INT8_TC_PRINTED[i]) and within_one(x_dp4a(i), X_DP4A_PRINTED[i])) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// How many shapes have the CUDA-core int8 path (dp4a) slower than bf16.
pub fn dp4a_slower_count() -> u32 {
    var i : u32 = 0;
    var c : u32 = 0;
    while (i < SHAPES) {
        if (T_DP4A[i] > T_BF16[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// ---------------------------------------------------------------- the saving law

; A run saves f x (1 - 1/s): f is the share of step time that moves to int8, s its speed-up.
; f = f_num / f_den, s = s_e2 / 100; the result is in tenths of a percent, rounded half up.
pub fn saving_e3(f_num: u64, f_den: u64, s_e2: u64) -> u64 {
    if (s_e2 <= 100) { return 0; }
    return (2 * f_num * 1000 * (s_e2 - 100) + f_den * s_e2) / (2 * f_den * s_e2);
}

; The two estimates of f the bench used: forward GEMMs are one of three matmuls per layer
; (forward, grad-input, grad-weight); with matmul at 75% of the step that becomes one quarter.
pub const F_ALL_MATMUL_NUM : u64 = 1;
pub const F_ALL_MATMUL_DEN : u64 = 3;
pub const F_MATMUL_75_NUM : u64 = 1;
pub const F_MATMUL_75_DEN : u64 = 4;

; The cost table of the bench comment, in tenths of a percent: rows f = 1/3 and 1/4, columns
; s = 2.9, 3.2, 3.5.
pub const S_COLUMNS : [3]u64 = [290, 320, 350];
pub const SAVING_THIRD_PRINTED : [3]u64 = [218, 229, 238];
pub const SAVING_QUARTER_PRINTED : [3]u64 = [164, 172, 179];

/// Dollars saved on a $100 run, rounded half up to whole dollars.
pub fn dollars_per_100(saving: u64) -> u64 {
    return (saving + 5) / 10;
}

// ---------------------------------------------------------------- which path a GEMM takes

pub const PASS_FORWARD : u32 = 0;
pub const PASS_BACKWARD : u32 = 1;

pub const PATH_BF16 : u32 = 0;
pub const PATH_INT8_TC : u32 = 1;
pub const PATH_DP4A : u32 = 2;
pub const PATH_GEN_CUDA : u32 = 3;

pub const PATHS : [4]str = [
    "bf16 tensor cores",
    "int8 tensor cores via torch._int_mm",
    "int8 dp4a on CUDA cores",
    "a t27c-generated CUDA kernel"
];

; A generated kernel replaces torch._int_mm only when it beats tuned CUTLASS s8 by 10% (RFC #10360).
pub const GEN_CUDA_BAR_E2 : u64 = 110;

/// The path t27t gives one GEMM.
/// pass: forward or backward. has_int8_tc: the device has int8 tensor cores.
/// gen_vs_cutlass_e2: a generated kernel's measured speed against CUTLASS s8 on this shape, in
/// hundredths, or 0 when none has been measured.
pub fn pick_path(pass: u32, has_int8_tc: bool, gen_vs_cutlass_e2: u64) -> u32 {
    // Gradients stay bf16: the saving is counted with them in bf16.
    if (pass == PASS_BACKWARD) { return PATH_BF16; }
    // Without int8 tensor cores the only int8 left is dp4a, measured slower than bf16 on every shape.
    if (!has_int8_tc) { return PATH_BF16; }
    if (gen_vs_cutlass_e2 >= GEN_CUDA_BAR_E2) { return PATH_GEN_CUDA; }
    return PATH_INT8_TC;
}

// ---------------------------------------------------------------- the second runner: t27c on a CPU

; The HSLM trainer specs/ml/train_hslm.t27, compiled by t27c --backend ml and Zig -O ReleaseFast,
; one thread, f64. Its profile (profile=1 or 2 in train.cfg, gHashTag/t27#10850) charges every
; interval between two clock reads to one of 13 parts. Measured on the Railway lab (48 cores, a
; shared host at load 56 to 86), 2026-10-19: 20 steps, speed 2, loss_positions 27, the tokens of
; /tmp/hslm. One step is 66 windows of 27 scored positions (1782 positions), and per position the
; model makes 19 matmul calls forward, 19 t_add and 19 outer_add calls backward.
; Times in this section are in ns, as the binary printed them. Shares are in tenths of a percent.
pub const CPU_RUNNER : str = "specs/ml/train_hslm.t27 via t27c --backend ml, Zig ReleaseFast, 1 thread, f64";
pub const CPU_BENCH : str = "gHashTag/t27#10850: Railway lab, 48 cores, 20 steps, speed 2, loss_positions 27, 2026-10-19";

pub const CPU_PARTS : u32 = 13;
pub const CP_FWD_MM : u32 = 0;
pub const CP_ATT_FWD : u32 = 1;
pub const CP_FWD_OTHER : u32 = 2;
pub const CP_BWD_TADD : u32 = 3;
pub const CP_BWD_OUTER : u32 = 4;
pub const CP_ATT_BWD : u32 = 5;
pub const CP_BWD_OTHER : u32 = 6;
pub const CP_LOSS : u32 = 7;
pub const CP_ZERO : u32 = 8;
pub const CP_GATHER_CLIP : u32 = 9;
pub const CP_LAMB : u32 = 10;
pub const CP_REQUANT : u32 = 11;
pub const CP_STEP_OTHER : u32 = 12;

pub const CPU_PART_NAME : [13]str = [
    "fwd_matmul", "attn_fwd_core", "fwd_other", "bwd_matmul_t", "bwd_outer", "attn_bwd_core",
    "bwd_other", "loss", "zero_grad", "gather_clip", "lamb", "requantize", "step_other"
];

; profile=2: the thread's CPU clock, so time the host takes away from the trainer is not charged.
pub const CPU_NS : [13]u64 = [
    34213431617, 1025430559, 2983795743, 30586403275, 52889511051, 1081772724,
    1186036579, 635887485, 68131696, 75441546, 348606165, 291810849, 21208
];
pub const CPU_MARKS : [13]u64 = [
    677160, 106920, 605880, 677160, 677160, 106920, 1283040, 35640, 20, 20, 20, 20, 40
];
pub const CPU_TOTAL_NS : u64 = 125386280497;
pub const CPU_TOTAL_MARKS : u64 = 4170000;
; One read of the clock, in ps, timed by the binary over 10^6 reads (a system call for this clock).
pub const CPU_PS_PER_READ : u64 = 217564;

; profile=1: the monotonic clock (a vDSO read), the wall-clock check of the same split.
pub const WALL_NS : [13]u64 = [
    37866972295, 1072649017, 3200415034, 34393137429, 53616601587, 1207263330,
    778546683, 707573861, 96326500, 83721472, 391453562, 372297308, 11248
];
pub const WALL_TOTAL_NS : u64 = 133786969326;
pub const WALL_PS_PER_READ : u64 = 20857;
; The same run's train_s, in hundredths of a second.
pub const WALL_TRAIN_S_E2 : u64 = 13379;

; s_per_step in units of 10^-4 s: profile 0, profile 2, profile 1. Each run is its own 20 steps
; on a shared host, so the three differ by the host's load as well as by the profile.
pub const S_PER_STEP_P0_E4 : u64 = 76935;
pub const S_PER_STEP_P2_E4 : u64 = 76970;
pub const S_PER_STEP_P1_E4 : u64 = 66895;
; profile 0: tok_per_s in tenths.
pub const TOK_PER_S_P0_E1 : u64 = 2316;
pub const CPU_STEPS : u64 = 20;
pub const WINDOWS : u64 = 66;
pub const SCORED_POSITIONS : u64 = 27;
pub const FWD_CALLS : u64 = 19;

pub const CLOCK_CPU : u32 = 0;
pub const CLOCK_WALL : u32 = 1;

pub fn raw_ns(clock: u32, i: u32) -> u64 {
    if (clock == CLOCK_WALL) { return WALL_NS[i]; }
    return CPU_NS[i];
}

/// A part's time less the clock reads charged to it (the marks are the same on both clocks).
pub fn net_ns(clock: u32, i: u32) -> u64 {
    var ps : u64 = CPU_PS_PER_READ;
    if (clock == CLOCK_WALL) { ps = WALL_PS_PER_READ; }
    return raw_ns(clock, i) - CPU_MARKS[i] * ps / 1000;
}

pub fn raw_sum(clock: u32) -> u64 {
    var i : u32 = 0;
    var s : u64 = 0;
    while (i < CPU_PARTS) {
        s = s + raw_ns(clock, i);
        i = i + 1;
    }
    return s;
}

pub fn marks_sum() -> u64 {
    var i : u32 = 0;
    var s : u64 = 0;
    while (i < CPU_PARTS) {
        s = s + CPU_MARKS[i];
        i = i + 1;
    }
    return s;
}

pub fn net_total(clock: u32) -> u64 {
    var i : u32 = 0;
    var s : u64 = 0;
    while (i < CPU_PARTS) {
        s = s + net_ns(clock, i);
        i = i + 1;
    }
    return s;
}

/// part / total in tenths of a percent, rounded half up.
pub fn share_of(part: u64, total: u64) -> u64 {
    return (2 * part * 1000 + total) / (2 * total);
}

pub fn share_e3(clock: u32, i: u32) -> u64 {
    return share_of(net_ns(clock, i), net_total(clock));
}

; The three matmul kernels of the step, and its serial tail: everything that runs once per step
; after the 66 windows (zero, gather and clip, LAMB, requantize, the rest).
pub fn matmul_ns(clock: u32) -> u64 {
    return net_ns(clock, CP_FWD_MM) + net_ns(clock, CP_BWD_TADD) + net_ns(clock, CP_BWD_OUTER);
}

pub fn bwd_matmul_ns(clock: u32) -> u64 {
    return net_ns(clock, CP_BWD_TADD) + net_ns(clock, CP_BWD_OUTER);
}

pub fn attention_ns(clock: u32) -> u64 {
    return net_ns(clock, CP_ATT_FWD) + net_ns(clock, CP_ATT_BWD);
}

pub fn serial_ns(clock: u32) -> u64 {
    return net_ns(clock, CP_ZERO) + net_ns(clock, CP_GATHER_CLIP) + net_ns(clock, CP_LAMB)
        + net_ns(clock, CP_REQUANT) + net_ns(clock, CP_STEP_OTHER);
}

pub fn window_ns(clock: u32) -> u64 {
    return net_total(clock) - serial_ns(clock);
}

/// The part with the most time.
pub fn biggest_part(clock: u32) -> u32 {
    var i : u32 = 1;
    var b : u32 = 0;
    while (i < CPU_PARTS) {
        if (net_ns(clock, i) > net_ns(clock, b)) { b = i; }
        i = i + 1;
    }
    return b;
}

// ---------------------------------------------------------------- four levers, bounded, not built

; Each bound is Amdahl's law on the CPU-clock split: a part of time f made x times faster leaves
; T - f + f / x. Bounds are speed-ups in hundredths, rounded half up. A bound is a ceiling the
; split allows, not a measured speed-up.
pub fn speedup_e2(total: u64, new_total: u64) -> u64 {
    return (total * 200 + new_total) / (2 * new_total);
}

pub fn amdahl_e2(f: u64, x_e2: u64) -> u64 {
    var t : u64 = net_total(CLOCK_CPU);
    return speedup_e2(t, t - f + f * 100 / x_e2);
}

/// The part f removed outright: the ceiling of any lever on it.
pub fn without_e2(f: u64) -> u64 {
    var t : u64 = net_total(CLOCK_CPU);
    return speedup_e2(t, t - f);
}

; (a) The 66 windows of a step on n threads, gradients summed in a fixed order: the windows take
; ceil(66 / n) rounds, the serial tail stays. The sum itself is not counted (NOT_MEASURED).
pub fn thread_bound_e2(n: u64) -> u64 {
    var rounds : u64 = (WINDOWS + n - 1) / n;
    var t : u64 = net_total(CLOCK_CPU);
    return speedup_e2(t, serial_ns(CLOCK_CPU) + rounds * window_ns(CLOCK_CPU) / WINDOWS);
}

/// The ceiling of (a) for any n: only the serial tail is left.
pub fn thread_limit_e2() -> u64 {
    return speedup_e2(net_total(CLOCK_CPU), serial_ns(CLOCK_CPU));
}

; (b) f32 instead of f64: half the bytes and twice the SIMD lanes, so at most 2x on the matmul
; kernels, whose inner loops are f64 arrays.
pub const F32_X_E2 : u64 = 200;
; (c) One GEMM over the 27 positions of a window instead of a GEMV per position: each weight
; matrix (and each gradient matrix of outer_add) is read once per window instead of 27 times.
; The bound takes the matmul kernels to be weight-traffic bound, which is not measured.
pub const GEMM_X_E2 : u64 = 2700;
; (d) int8 activations against packed trits, forward only: 1 byte against 8 per operand.
pub const INT8_X_E2 : u64 = 800;

pub const LEVERS : u32 = 4;
pub const LEVER_THREADS : u32 = 0;
pub const LEVER_F32 : u32 = 1;
pub const LEVER_GEMM : u32 = 2;
pub const LEVER_INT8 : u32 = 3;
; (a) is bounded at the lab's 48 cores.
pub const LAB_CORES : u64 = 48;

pub const LEVER_NAME : [4]str = [
    "(a) 66 windows on N threads, fixed-order gradient sum",
    "(b) f32 instead of f64",
    "(c) one GEMM over 27 positions instead of a GEMV per position",
    "(d) int8 activations against packed trits, forward"
];

; What t27c --backend ml lacks for a lever. (a) needs a thread primitive (spawn and join) and
; per-thread state; (d) needs packed-trit storage and an int8 SIMD dot product. (b) and (c) are
; spec work: t27 has f32, and a GEMM is loops over arrays.
pub fn lever_needs_backend(i: u32) -> bool {
    if (i == LEVER_THREADS) { return true; }
    if (i == LEVER_INT8) { return true; }
    return false;
}

pub fn lever_bound_e2(i: u32) -> u64 {
    if (i == LEVER_THREADS) { return thread_bound_e2(LAB_CORES); }
    if (i == LEVER_F32) { return amdahl_e2(matmul_ns(CLOCK_CPU), F32_X_E2); }
    if (i == LEVER_GEMM) { return amdahl_e2(matmul_ns(CLOCK_CPU), GEMM_X_E2); }
    return amdahl_e2(net_ns(CLOCK_CPU, CP_FWD_MM), INT8_X_E2);
}

/// The lever with the highest bound; with backend false, only among levers t27c can build today.
pub fn biggest_lever(allow_backend: bool) -> u32 {
    var i : u32 = 0;
    var b : u32 = LEVERS;
    while (i < LEVERS) {
        if (allow_backend or !lever_needs_backend(i)) {
            if (b == LEVERS) {
                b = i;
            } else {
                if (lever_bound_e2(i) > lever_bound_e2(b)) { b = i; }
            }
        }
        i = i + 1;
    }
    return b;
}

// ---------------------------------------------------------------- what is known and what is not

pub const NOT_MEASURED : [11]str = [
    "f, the share of a tern-tc-500m step spent in forward GEMMs",
    "cuBLAS itself; torch._int_mm is represented by the best CUTLASS s8 kernel",
    "activation quantization from bf16 to int8 and its kernel launch",
    "the runner wired to torch._int_mm, end to end",
    "the cost of the fixed-order gradient sum over N threads (lever a)",
    "memory bandwidth with N trainer threads at once (lever a)",
    "the speed of an f32 train_hslm (lever b)",
    "whether each matmul kernel is weight-traffic bound, and the compute roof of a 27-position GEMM (lever c)",
    "an int8 x packed-trit kernel, and the loss it gives (lever d)",
    "the split on an unloaded host; the lab host ran at load 56 to 86",
    "VSA and embedding time on its own: it is inside fwd_other"
];

// ---------------------------------------------------------------- tests

test "every printed ratio recomputes from its times" {
    assert x_int8_tc(0) == 293;
    assert x_int8_tc(1) == 290;
    assert x_int8_tc(2) == 316;
    assert x_int8_tc(3) == 355;
    assert x_int8_tc(4) == 319;
    assert x_dp4a(0) == 94;
    assert x_dp4a(1) == 91;
    assert x_dp4a(2) == 92;
    assert x_dp4a(3) == 92;
    assert x_dp4a(4) == 93;
    assert printed_ratios_that_hold() == 5;
}

test "int8 tensor cores: 2.9x to 3.5x, under the datasheet 4x" {
    assert min_printed(COL_INT8_TC) == 290;
    assert max_printed(COL_INT8_TC) == 354;
    assert max_printed(COL_INT8_TC) < X_DATASHEET;
}

test "dp4a on CUDA cores is slower than bf16 on every shape" {
    assert dp4a_slower_count() == SHAPES;
    assert max_printed(COL_DP4A) == 94;
    assert min_printed(COL_DP4A) == 91;
}

test "the cost table: 16 to 24 dollars on a 100 dollar run" {
    assert saving_e3(F_ALL_MATMUL_NUM, F_ALL_MATMUL_DEN, S_COLUMNS[0]) == SAVING_THIRD_PRINTED[0];
    assert saving_e3(F_ALL_MATMUL_NUM, F_ALL_MATMUL_DEN, S_COLUMNS[1]) == SAVING_THIRD_PRINTED[1];
    assert saving_e3(F_ALL_MATMUL_NUM, F_ALL_MATMUL_DEN, S_COLUMNS[2]) == SAVING_THIRD_PRINTED[2];
    assert saving_e3(F_MATMUL_75_NUM, F_MATMUL_75_DEN, S_COLUMNS[0]) == SAVING_QUARTER_PRINTED[0];
    assert saving_e3(F_MATMUL_75_NUM, F_MATMUL_75_DEN, S_COLUMNS[1]) == SAVING_QUARTER_PRINTED[1];
    assert saving_e3(F_MATMUL_75_NUM, F_MATMUL_75_DEN, S_COLUMNS[2]) == SAVING_QUARTER_PRINTED[2];
    assert dollars_per_100(SAVING_QUARTER_PRINTED[0]) == 16;
    assert dollars_per_100(SAVING_THIRD_PRINTED[2]) == 24;
}

test "no speed-up, no saving; a slower path is never a saving" {
    assert saving_e3(1, 3, 100) == 0;
    assert saving_e3(1, 3, 94) == 0;
    assert saving_e3(1, 1, 200) == 500;
}

test "the path rule" {
    assert pick_path(PASS_FORWARD, true, 0) == PATH_INT8_TC;
    assert pick_path(PASS_BACKWARD, true, 0) == PATH_BF16;
    assert pick_path(PASS_FORWARD, false, 0) == PATH_BF16;
    assert pick_path(PASS_FORWARD, true, 109) == PATH_INT8_TC;
    assert pick_path(PASS_FORWARD, true, 110) == PATH_GEN_CUDA;
    assert pick_path(PASS_BACKWARD, true, 150) == PATH_BF16;
    assert PATHS[PATH_INT8_TC] == "int8 tensor cores via torch._int_mm";
}

test "negative control: a ratio off by two is caught" {
    assert !within_one(x_int8_tc(3), 353);
    assert within_one(x_int8_tc(3), 354);
    assert saving_e3(1, 3, 290) != 219;
}

test "what is not known stays written down" {
    assert !F_MEASURED;
    assert !RUNNER_USES_INT_MM;
    assert NOT_MEASURED[0] == "f, the share of a tern-tc-500m step spent in forward GEMMs";
    assert NAME == "t27t";
}

test "the CPU profile adds up: parts to the printed total, marks to the call order" {
    assert raw_sum(CLOCK_CPU) == CPU_TOTAL_NS;
    assert raw_sum(CLOCK_WALL) == WALL_TOTAL_NS;
    assert marks_sum() == CPU_TOTAL_MARKS;
    // 66 windows x 27 positions a step, 19 kernel calls per position each way.
    assert WINDOWS * SCORED_POSITIONS == 1782;
    assert CPU_MARKS[CP_FWD_MM] == CPU_STEPS * 1782 * FWD_CALLS;
    assert CPU_MARKS[CP_BWD_TADD] == CPU_MARKS[CP_FWD_MM];
    assert CPU_MARKS[CP_BWD_OUTER] == CPU_MARKS[CP_FWD_MM];
    assert CPU_MARKS[CP_ATT_FWD] == CPU_STEPS * 1782 * 3;
    assert CPU_MARKS[CP_LOSS] == CPU_STEPS * 1782;
    assert CPU_MARKS[CP_LAMB] == CPU_STEPS;
    // profile 0 scored 1782 tokens a step.
    assert (TOK_PER_S_P0_E1 * S_PER_STEP_P0_E4 + 50000) / 100000 == 1782;
    assert CPU_PART_NAME[CP_BWD_OUTER] == "bwd_outer";
}

test "the wall clock closes on train_s, and the CPU-clock profile costs under 1%" {
    assert (WALL_TOTAL_NS + 5000000) / 10000000 == WALL_TRAIN_S_E2;
    assert S_PER_STEP_P2_E4 - S_PER_STEP_P0_E4 < S_PER_STEP_P0_E4 / 100;
    // The clock reads: 0.907 s of the CPU-clock total, 0.087 s of the wall total.
    assert CPU_TOTAL_NS - net_total(CLOCK_CPU) == 907241874;
    assert WALL_TOTAL_NS - net_total(CLOCK_WALL) == 86973687;
}

test "where a CPU step goes: 94.2% matmul, 66.8% backward matmul, 42.4% outer_add" {
    assert net_total(CLOCK_CPU) == 124479038623;
    assert share_e3(CLOCK_CPU, CP_FWD_MM) == 274;
    assert share_e3(CLOCK_CPU, CP_BWD_TADD) == 245;
    assert share_e3(CLOCK_CPU, CP_BWD_OUTER) == 424;
    assert share_of(bwd_matmul_ns(CLOCK_CPU), net_total(CLOCK_CPU)) == 668;
    assert share_of(matmul_ns(CLOCK_CPU), net_total(CLOCK_CPU)) == 942;
    assert share_of(attention_ns(CLOCK_CPU), net_total(CLOCK_CPU)) == 17;
    assert share_of(serial_ns(CLOCK_CPU), net_total(CLOCK_CPU)) == 6;
    assert share_e3(CLOCK_CPU, CP_LAMB) == 3;
    assert share_e3(CLOCK_CPU, CP_REQUANT) == 2;
    assert biggest_part(CLOCK_CPU) == CP_BWD_OUTER;
}

test "the wall clock gives the same matmul share and the same biggest part" {
    assert share_of(matmul_ns(CLOCK_WALL), net_total(CLOCK_WALL)) == 941;
    assert within_one(share_of(matmul_ns(CLOCK_WALL), net_total(CLOCK_WALL)), share_of(matmul_ns(CLOCK_CPU), net_total(CLOCK_CPU)));
    assert share_e3(CLOCK_WALL, CP_BWD_OUTER) == 401;
    assert biggest_part(CLOCK_WALL) == CP_BWD_OUTER;
}

test "lever a: threads, bounded by ceil(66 / n) rounds and the serial tail" {
    assert share_of(window_ns(CLOCK_CPU), net_total(CLOCK_CPU)) == 994;
    assert thread_bound_e2(1) == 100;
    assert thread_bound_e2(8) == 705;
    assert thread_bound_e2(16) == 1226;
    assert thread_bound_e2(48) == 2746;
    assert thread_bound_e2(66) == 4683;
    assert thread_limit_e2() == 15878;
    assert lever_needs_backend(LEVER_THREADS);
}

test "levers b, c, d: f32 1.89x, a 27-position GEMM 10.75x, forward int8 1.31x" {
    assert lever_bound_e2(LEVER_F32) == 189;
    assert lever_bound_e2(LEVER_GEMM) == 1075;
    assert amdahl_e2(net_ns(CLOCK_CPU, CP_BWD_OUTER), GEMM_X_E2) == 169;
    assert without_e2(matmul_ns(CLOCK_CPU)) == 1721;
    assert lever_bound_e2(LEVER_INT8) == 131;
    assert without_e2(net_ns(CLOCK_CPU, CP_FWD_MM)) == 138;
    assert !lever_needs_backend(LEVER_F32);
    assert !lever_needs_backend(LEVER_GEMM);
    assert lever_needs_backend(LEVER_INT8);
}

test "the biggest lever: threads with new backend support, the GEMM without" {
    assert lever_bound_e2(LEVER_THREADS) == 2746;
    assert biggest_lever(true) == LEVER_THREADS;
    assert biggest_lever(false) == LEVER_GEMM;
    assert LEVER_NAME[LEVER_GEMM] == "(c) one GEMM over 27 positions instead of a GEMV per position";
}

test "negative control: one CPU figure moved is caught" {
    // One more second of forward matmul moves its share from 27.4% to 27.9%.
    assert share_of(net_ns(CLOCK_CPU, CP_FWD_MM) + 1000000000, net_total(CLOCK_CPU) + 1000000000) == 279;
    assert share_of(net_ns(CLOCK_CPU, CP_FWD_MM) + 1000000000, net_total(CLOCK_CPU) + 1000000000) != share_e3(CLOCK_CPU, CP_FWD_MM);
    // The serial tail counted as parallel would lift the thread bound.
    assert speedup_e2(net_total(CLOCK_CPU), net_total(CLOCK_CPU) / WINDOWS) > thread_bound_e2(66);
    assert raw_sum(CLOCK_CPU) != CPU_TOTAL_NS + 1;
}

test "what the CPU profile did not measure stays written down" {
    assert NOT_MEASURED[4] == "the cost of the fixed-order gradient sum over N threads (lever a)";
    assert NOT_MEASURED[7] == "whether each matmul kernel is weight-traffic bound, and the compute roof of a 27-position GEMM (lever c)";
    assert NOT_MEASURED[10] == "VSA and embedding time on its own: it is inside fwd_other";
}

invariant threads_never_pass_the_serial_tail { thread_bound_e2(66) < thread_limit_e2() and thread_bound_e2(48) <= thread_bound_e2(66) }

invariant the_cpu_parts_sum_to_the_printed_total { raw_sum(CLOCK_CPU) == CPU_TOTAL_NS and raw_sum(CLOCK_WALL) == WALL_TOTAL_NS }

invariant dp4a_is_never_picked { pick_path(PASS_FORWARD, false, 0) != PATH_DP4A and pick_path(PASS_FORWARD, true, 0) != PATH_DP4A }

invariant gradients_stay_bf16 { pick_path(PASS_BACKWARD, true, 200) == PATH_BF16 }

invariant the_bench_has_five_shapes { SHAPE_M[0] == 4096 and SHAPE_N[1] == 1280 and SHAPE_K[3] == 3456 }
