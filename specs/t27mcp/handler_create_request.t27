// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/handler_create_request.t27 -- Handler spec for the t27_create_request MCP tool
; Validates a new request envelope and records a T27L event with provenance.
; Input must carry a non-empty request_id and description to be accepted.
; Returns HR_OK on success; never silently discards input or accepts invalid state.
; Wave E of ORDER: T27_MCP_HANDLER_TIER_1_V1 (gHashTag/t27#13560).
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpHandlerCreateRequest;

/// Handler result codes. Order is stable.
pub const HR_OK            : u8 = 0;  // request created and T27L event written
pub const HR_INVALID_INPUT : u8 = 1;  // request_id or description missing/empty
pub const HR_DUPLICATE     : u8 = 2;  // a request with this id already exists
pub const HR_INVALID_STATE : u8 = 3;  // server state does not allow request creation
pub const HR_COUNT         : u8 = 4;

pub const HR_TEXT : [4]str = [
    "OK",
    "INVALID_INPUT",
    "DUPLICATE",
    "INVALID_STATE",
];

/// T27L event kind emitted on a successful create_request.
/// The event preserves: request_id, description, timestamp, session provenance.
pub const TEK_REQUEST_CREATED : u8 = 10;

/// Minimum request_id length (1 character, non-empty).
pub const REQUEST_ID_MIN_LEN : u8 = 1;

/// Maximum request_id length (64 characters, ASCII).
pub const REQUEST_ID_MAX_LEN : u8 = 64;

/// Returns true when the handler result code indicates success.
pub fn is_ok(result: u8) -> bool {
    return result == HR_OK;
}

/// Returns true when input was rejected (not a server or state error).
pub fn is_input_error(result: u8) -> bool {
    if (result == HR_INVALID_INPUT) { return true; }
    if (result == HR_DUPLICATE)     { return true; }
    return false;
}

/// Returns true when the handler accepted the call (input + state both valid).
pub fn accepts(result: u8) -> bool {
    return result == HR_OK;
}

/// Returns true when the state error (not an input error) prevented the call.
pub fn state_refused(result: u8) -> bool {
    return result == HR_INVALID_STATE;
}

/// A create_request call writes a T27L event only on HR_OK.
/// Any other result means no event was written, preserving provenance integrity.
pub fn event_written(result: u8) -> bool {
    return result == HR_OK;
}

test handler_result_codes_stable {
    assert HR_OK            == 0;
    assert HR_INVALID_INPUT == 1;
    assert HR_DUPLICATE     == 2;
    assert HR_INVALID_STATE == 3;
    assert HR_COUNT         == 4;
    assert HR_TEXT[HR_OK]            == "OK";
    assert HR_TEXT[HR_INVALID_INPUT] == "INVALID_INPUT";
    assert HR_TEXT[HR_DUPLICATE]     == "DUPLICATE";
    assert HR_TEXT[HR_INVALID_STATE] == "INVALID_STATE";
}

test t27l_event_kind_stable {
    assert TEK_REQUEST_CREATED == 10;
}

test accepts_only_on_ok {
    assert accepts(HR_OK);
    assert accepts(HR_INVALID_INPUT) == false;
    assert accepts(HR_DUPLICATE)     == false;
    assert accepts(HR_INVALID_STATE) == false;
}

test input_errors_are_not_state_errors {
    assert is_input_error(HR_INVALID_INPUT);
    assert is_input_error(HR_DUPLICATE);
    assert is_input_error(HR_OK)            == false;
    assert is_input_error(HR_INVALID_STATE) == false;
    assert state_refused(HR_INVALID_STATE);
    assert state_refused(HR_OK)            == false;
    assert state_refused(HR_INVALID_INPUT) == false;
}

test event_written_only_on_ok {
    assert event_written(HR_OK);
    assert event_written(HR_INVALID_INPUT) == false;
    assert event_written(HR_DUPLICATE)     == false;
    assert event_written(HR_INVALID_STATE) == false;
}

test request_id_length_bounds {
    assert REQUEST_ID_MIN_LEN == 1;
    assert REQUEST_ID_MAX_LEN == 64;
    assert REQUEST_ID_MIN_LEN < REQUEST_ID_MAX_LEN;
}

invariant handler_result_count {
    assert HR_COUNT == 4;
}

invariant event_kind_in_range {
    assert TEK_REQUEST_CREATED >= 10;
}
