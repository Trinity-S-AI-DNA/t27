; specs/t27mcp/milestone_integrity.t27 -- invariants for milestone chain consistency
; An orphan milestone has 0 issues and no chain_id: it is a folder, not an artifact.
; A complete milestone has: nonzero number, chain_id, memory_record_id, >= 1 issue.
; Closes #13569 | phi^2 + 1/phi^2 = 3 | TRINITY

module MilestoneIntegrity;

; An orphan has 0 issues AND no chain_id. Having either disqualifies it.
pub fn is_orphan(issue_count: u8, has_chain_id: bool) -> bool {
    if (issue_count > 0) { return false; }
    if (has_chain_id) { return false; }
    return true;
}

; A milestone is chain-linked when both chain_id and memory_record_id are present.
pub fn is_chain_linked(has_chain_id: bool, has_memory_record_id: bool) -> bool {
    if (has_chain_id == false) { return false; }
    if (has_memory_record_id == false) { return false; }
    return true;
}

; A milestone is a control surface (not just a folder) when it is chain-linked and
; has at least one open or closed issue.
pub fn is_control_surface(has_chain_id: bool, has_memory_record_id: bool, issue_count: u8) -> bool {
    if (is_chain_linked(has_chain_id, has_memory_record_id) == false) { return false; }
    if (issue_count == 0) { return false; }
    return true;
}

; Wave 1 audit results: both existing milestones are orphans.
pub const AUDIT_MS1_ISSUES     : u8   = 20;   ; closed only
pub const AUDIT_MS1_OPEN       : u8   = 0;
pub const AUDIT_MS1_HAS_CHAIN  : bool = false;
pub const AUDIT_MS2_ISSUES     : u8   = 3;    ; closed only
pub const AUDIT_MS2_OPEN       : u8   = 0;
pub const AUDIT_MS2_HAS_CHAIN  : bool = false;

test orphan_requires_no_issues_and_no_chain {
    assert is_orphan(0, false);
    assert is_orphan(1, false) == false;
    assert is_orphan(0, true)  == false;
    assert is_orphan(1, true)  == false;
}

test chain_linked_requires_both_ids {
    assert is_chain_linked(true, true);
    assert is_chain_linked(true, false)  == false;
    assert is_chain_linked(false, true)  == false;
    assert is_chain_linked(false, false) == false;
}

test control_surface_requires_chain_and_issues {
    assert is_control_surface(true, true, 1);
    assert is_control_surface(true, true, 0)  == false;
    assert is_control_surface(true, false, 1) == false;
    assert is_control_surface(false, true, 1) == false;
}

test audit_ms1_epoch01_harden_has_issues_not_chain {
    assert AUDIT_MS1_OPEN == 0;
    assert AUDIT_MS1_ISSUES > 0;
    assert AUDIT_MS1_HAS_CHAIN == false;
    assert is_orphan(AUDIT_MS1_ISSUES, AUDIT_MS1_HAS_CHAIN) == false;
}

test audit_ms2_phase3_science_has_issues_not_chain {
    assert AUDIT_MS2_OPEN == 0;
    assert AUDIT_MS2_ISSUES > 0;
    assert AUDIT_MS2_HAS_CHAIN == false;
    assert is_orphan(AUDIT_MS2_ISSUES, AUDIT_MS2_HAS_CHAIN) == false;
}

test both_audit_milestones_not_control_surfaces {
    assert is_control_surface(AUDIT_MS1_HAS_CHAIN, false, AUDIT_MS1_ISSUES) == false;
    assert is_control_surface(AUDIT_MS2_HAS_CHAIN, false, AUDIT_MS2_ISSUES) == false;
}

invariant orphan_definition_consistent {
    assert is_orphan(0, false);
    assert is_orphan(0, true) == false;
}

invariant control_surface_requires_chain {
    assert is_control_surface(false, false, 10) == false;
}
