// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/request_envelope.t27 -- canonical request envelope for the t27 MCP MVP pipeline
; (Refs gHashTag/t27 ORDER: T27_MCP_MVP_V1). Every task graph, verdict, Queen decision and
; Golden Chain link traces back to one request_id. No implementation begins until this schema
; is frozen. Wave B of the ONE SHOT; schema and tests only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpRequestEnvelope;

/// Request lifecycle.
pub const RS_DRAFT    : u8 = 0;
pub const RS_ACTIVE   : u8 = 1;
pub const RS_COMPLETE : u8 = 2;
pub const RS_REJECTED : u8 = 3;
pub const RS_ARCHIVED : u8 = 4;
pub const RS_COUNT    : u8 = 5;

pub const RS_TEXT : [5]str = ["DRAFT", "ACTIVE", "COMPLETE", "REJECTED", "ARCHIVED"];

/// Risk tolerance: how much uncertainty an owner accepts at execution time.
pub const RT_LOW    : u8 = 0;
pub const RT_MEDIUM : u8 = 1;
pub const RT_HIGH   : u8 = 2;
pub const RT_COUNT  : u8 = 3;

pub const RT_TEXT : [3]str = ["LOW", "MEDIUM", "HIGH"];

/// Budget units tracked per request.
pub const BU_TOKENS : u8 = 0;
pub const BU_USD    : u8 = 1;
pub const BU_ENERGY : u8 = 2;
pub const BU_COUNT  : u8 = 3;

pub const BU_TEXT : [3]str = ["tokens", "usd", "energy_wh"];

/// Id bounds. Request ids begin with "req_" and are 8-64 characters.
pub const ID_PREFIX : str = "req_";
pub const ID_MIN    : u32 = 8;
pub const ID_MAX    : u32 = 64;

/// Title constraints.
pub const TITLE_MIN : u32 = 1;
pub const TITLE_MAX : u32 = 256;

/// Domain count: 26 letters A-Z plus the cross-cutting kernel T27#, indexed 0-26.
pub const DOMAIN_COUNT : u32 = 27;

/// Maximum allowed domains listed in a single request (0 = all domains).
pub const MAX_ALLOWED_DOMAINS : u32 = 27;

test status_codes_are_stable {
    assert RS_DRAFT    == 0;
    assert RS_ACTIVE   == 1;
    assert RS_COMPLETE == 2;
    assert RS_REJECTED == 3;
    assert RS_ARCHIVED == 4;
    assert RS_COUNT    == 5;
    assert RS_TEXT[RS_DRAFT]    == "DRAFT";
    assert RS_TEXT[RS_ARCHIVED] == "ARCHIVED";
}

test risk_tolerance_codes {
    assert RT_LOW    == 0;
    assert RT_MEDIUM == 1;
    assert RT_HIGH   == 2;
    assert RT_COUNT  == 3;
    assert RT_TEXT[RT_LOW]  == "LOW";
    assert RT_TEXT[RT_HIGH] == "HIGH";
}

test budget_units {
    assert BU_TOKENS == 0;
    assert BU_USD    == 1;
    assert BU_ENERGY == 2;
    assert BU_COUNT  == 3;
    assert BU_TEXT[BU_ENERGY] == "energy_wh";
}

test id_bounds {
    assert ID_MIN == 8;
    assert ID_MAX == 64;
    assert ID_MIN < ID_MAX;
    assert ID_PREFIX == "req_";
}

test domain_count_is_27 {
    assert DOMAIN_COUNT == 27;
    assert MAX_ALLOWED_DOMAINS == 27;
}

invariant status_count {
    assert RS_COUNT == 5;
}

invariant domain_count {
    assert DOMAIN_COUNT == 27;
}
