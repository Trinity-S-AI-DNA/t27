/// The laws of one step from the previous row to this one, in the same block. A first row is depth 0; a row
/// is at most one deeper than the row before, and only under a container; a row may climb out any distance.
pub fn step_ok(first: bool, prev_depth: u32, prev_kind: u32, depth: u32) -> bool {
    if (first) { return depth == 0; }
    if (depth == prev_depth + 1) { return prev_kind == K_ARRAY or prev_kind == K_TUPLE or prev_kind == K_OBJECT; }
    return depth <= prev_depth;
}

/// A child's name against its parent: an object's children are named properties; array items and tuple
/// positions are unnamed. A top-level row (parent 0, no container) is a named property of the tool's object.
pub fn name_ok(parent_kind: u32, named: bool) -> bool {
    if (parent_kind == K_ARRAY or parent_kind == K_TUPLE) { return named == false; }
    return named;
}

/// How many children a container may have: an array exactly one (its item schema), a tuple exactly lo = hi,
/// a scalar or an any none, an object any number (none means any object).
pub fn children_ok(kind: u32, lo: u32, hi: u32, children: u32) -> bool {
    if (kind == K_ARRAY) { return children == 1; }
    if (kind == K_TUPLE) { return lo == hi and children == lo and children > 0; }
    if (kind == K_OBJECT) { return true; }
    return children == 0;
}

/// lo and hi apply to strings, numbers, integers, arrays and tuples; when both are set, lo <= hi.
pub fn bounds_ok(kind: u32, lo: u32, hi: u32) -> bool {
    let bounded : bool = kind == K_STRING or kind == K_INTEGER or kind == K_NUMBER or kind == K_ARRAY or kind == K_TUPLE;
    if (bounded == false) { return lo == NB and hi == NB; }
    if (lo != NB and hi != NB) { return lo <= hi; }
    return true;
}

/// choices and pattern are string constraints only.
pub fn text_ok(kind: u32, has_choices: bool, has_pattern: bool) -> bool {
    if (kind == K_STRING) { return true; }
    return has_choices == false and has_pattern == false;
}

/// required means something only for a named property; nullable only on an output.
pub fn flags_ok(side: u32, named: bool, req: bool, nullable: bool) -> bool {
    if (req and named == false) { return false; }
    if (nullable and side == IN) { return false; }
    return true;
}

/// Index of the parent row of row i, or NB for a top-level row: the nearest earlier row of the same block
/// one level up. This is the walk the builder in the server does with a stack.
pub fn parent_of(i: u32) -> u32 {
    let f : Field = FIELDS[i];
    if (f.depth == 0) { return NB; }
    var j : u32 = i;
    while (j > 0) {
        j = j - 1;
        let p : Field = FIELDS[j];
        if (p.tool != f.tool or p.side != f.side) { return NB; }
        if (p.depth + 1 == f.depth) { return j; }
    }
    return NB;
}

/// Rows of row i's block one level below it.
pub fn child_count(i: u32) -> u32 {
    var n : u32 = 0;
    var j : u32 = i + 1;
    while (j < FIELD_COUNT) {
        let c : Field = FIELDS[j];
        if (c.tool != FIELDS[i].tool or c.side != FIELDS[i].side or c.depth <= FIELDS[i].depth) { return n; }
        if (c.depth == FIELDS[i].depth + 1) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

/// Rows of one tool and side.
pub fn rows_of(tool: u32, side: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < FIELD_COUNT) {
        if (FIELDS[i].tool == tool and FIELDS[i].side == side) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

test "the tables are the size they say, with 27 tools and their names" {
    assert TOOL_COUNT == 27;
    assert FIELD_COUNT == 270;
    assert TOOLS[T_STATUS].name == "t27_status";
    assert TOOLS[T_CHECK].name == "t27_check";
    assert TOOLS[T_VIEW].name == "t27f_view";
    assert TOOLS[T_PAPER_CLAIMS].name == "t27_paper_claims";
    assert TOOLS[T_TG_SCHEDULED].name == "tg_scheduled";
    assert KIND_JSON[K_INTEGER] == "integer";
    assert KIND_JSON[K_TUPLE] == "array";
    assert KIND_JSON[K_ANY].len == 0;
    assert PROTOCOL[PROFILE_INPUT] == "2024-11-05";
    assert PROTOCOL[PROFILE_OUTPUT] == "2025-06-18";
    assert DEFAULT_PROFILE == PROFILE_INPUT;
}

test "every tool name is unique and has a known prefix" {
    var i : u32 = 0;
    while (i < TOOL_COUNT) {
        let t : Tool = TOOLS[i];
        assert t.name.len > 3;
        let t27 : bool = t.name[0] == 't' and t.name[1] == '2' and t.name[2] == '7';
        let tg : bool = t.name[0] == 't' and t.name[1] == 'g' and t.name[2] == '_';
        assert t27 or tg;
        var j : u32 = i + 1;
        while (j < TOOL_COUNT) {
            assert (TOOLS[j].name == t.name) == false;
            j = j + 1;
        }
        i = i + 1;
    }
}

test "every field row belongs to a tool or to the spec filters, and each block is contiguous" {
    var i : u32 = 0;
    while (i < FIELD_COUNT) {
        let f : Field = FIELDS[i];
        assert f.tool < TOOL_COUNT or f.tool == G_SPEC_FILTERS;
        assert f.side == IN or f.side == OUT;
        assert f.kind >= K_STRING and f.kind < KIND_COUNT;
        if (i > 0) {
            let p : Field = FIELDS[i - 1];
            if (p.tool != f.tool or p.side != f.side) {
                // A new block: it must not have appeared before.
                var j : u32 = 0;
                while (j < i) {
                    assert (FIELDS[j].tool == f.tool and FIELDS[j].side == f.side) == false;
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
}

test "every row is well formed: depth steps, names, children, bounds, text constraints, flags" {
    var i : u32 = 0;
    while (i < FIELD_COUNT) {
        let f : Field = FIELDS[i];
        var first : bool = i == 0;
        var prev_depth : u32 = 0;
        var prev_kind : u32 = 0;
        if (i > 0) {
            first = FIELDS[i - 1].tool != f.tool or FIELDS[i - 1].side != f.side;
            prev_depth = FIELDS[i - 1].depth;
            prev_kind = FIELDS[i - 1].kind;
        }
        assert step_ok(first, prev_depth, prev_kind, f.depth);
        let p : u32 = parent_of(i);
        var parent_kind : u32 = K_OBJECT;
        if (p != NB) { parent_kind = FIELDS[p].kind; }
        assert (p == NB) == (f.depth == 0);
        assert name_ok(parent_kind, f.name.len > 0);
        assert children_ok(f.kind, f.lo, f.hi, child_count(i));
        assert bounds_ok(f.kind, f.lo, f.hi);
        assert text_ok(f.kind, f.choices.len > 0, f.pattern.len > 0);
        assert flags_ok(f.side, f.name.len > 0, f.req, f.nullable);
        i = i + 1;
    }
}

test "property names are unique within their object" {
    var i : u32 = 0;
    while (i < FIELD_COUNT) {
        if (FIELDS[i].name.len > 0) {
            let p : u32 = parent_of(i);
            var j : u32 = i + 1;
            while (j < FIELD_COUNT and FIELDS[j].tool == FIELDS[i].tool and FIELDS[j].side == FIELDS[i].side) {
                if (parent_of(j) == p and FIELDS[j].depth == FIELDS[i].depth) {
                    assert (FIELDS[j].name == FIELDS[i].name) == false;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

test "a text or any result declares no output rows; an object result does" {
    var t : u32 = 0;
    while (t < TOOL_COUNT) {
        if (TOOLS[t].out == OUT_OBJECT) {
            assert rows_of(t, OUT) > 0 or t == T_FORMAT;
        } else {
            assert rows_of(t, OUT) == 0;
        }
        t = t + 1;
    }
    assert rows_of(T_FORMAT, OUT) == 0;
    assert TOOLS[T_RAW].out == OUT_ANY;
    assert TOOLS[T_DASHBOARD].out == OUT_TEXT;
}

test "the spec filters: two tools take them, they are inputs only, and no tool repeats one" {
    assert TOOLS[T_SPECS].filters;
    assert TOOLS[T_GREP].filters;
    assert TOOLS[T_SPEC].filters == false;
    assert rows_of(G_SPEC_FILTERS, IN) == 10;
    assert rows_of(G_SPEC_FILTERS, OUT) == 0;
    var i : u32 = 0;
    while (i < FIELD_COUNT) {
        if (FIELDS[i].tool < TOOL_COUNT and TOOLS[FIELDS[i].tool].filters and FIELDS[i].side == IN) {
            var j : u32 = 0;
            while (j < FIELD_COUNT) {
                if (FIELDS[j].tool == G_SPEC_FILTERS) { assert (FIELDS[j].name == FIELDS[i].name) == false; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

test "inputs: the constraints a client used to miss are declared" {
    var i : u32 = 0;
    var ints : u32 = 0;
    var enums : u32 = 0;
    var patterns : u32 = 0;
    while (i < FIELD_COUNT) {
        let f : Field = FIELDS[i];
        if (f.side == IN) {
            assert f.kind != K_NUMBER;
            assert f.kind != K_ANY;
            if (f.kind == K_INTEGER) { ints = ints + 1; }
            if (f.choices.len > 0) { enums = enums + 1; }
            if (f.pattern.len > 0) { patterns = patterns + 1; }
        }
        i = i + 1;
    }
    assert ints == 23;
    assert enums == 6;
    assert patterns == 6;
}

test "the round trip fixtures: a tuple, arrays, a boolean, nested objects" {
    // t27_game rules.cycle is a five-step tuple; each position is one fixed word.
    var cycle : u32 = NB;
    var i : u32 = 0;
    while (i < FIELD_COUNT) {
        if (FIELDS[i].tool == T_GAME and FIELDS[i].name == "cycle") { cycle = i; }
        i = i + 1;
    }
    assert cycle != NB;
    assert FIELDS[cycle].kind == K_TUPLE;
    assert FIELDS[cycle].lo == 5 and FIELDS[cycle].hi == 5;
    assert child_count(cycle) == 5;
    assert FIELDS[cycle + 1].choices == "Issue";
    assert FIELDS[cycle + 5].choices == "Evidence";
    assert FIELDS[parent_of(cycle)].name == "rules";
    // t27_grep results[].hits[].line sits four levels down, under two arrays and two objects.
    var line : u32 = NB;
    i = 0;
    while (i < FIELD_COUNT) {
        if (FIELDS[i].tool == T_GREP and FIELDS[i].name == "line") { line = i; }
        i = i + 1;
    }
    assert line != NB;
    assert FIELDS[line].depth == 4;
    assert FIELDS[parent_of(parent_of(line))].name == "hits";
    assert FIELDS[parent_of(parent_of(parent_of(parent_of(line))))].name == "results";
    // t27_check ok is a required boolean output.
    var ok : u32 = NB;
    // t27f_view status is an array of at most 27 items, each an integer 0..255.
    var status : u32 = NB;
    i = 0;
    while (i < FIELD_COUNT) {
        if (FIELDS[i].tool == T_CHECK and FIELDS[i].side == OUT and FIELDS[i].name == "ok") { ok = i; }
        if (FIELDS[i].tool == T_VIEW and FIELDS[i].name == "status") { status = i; }
        i = i + 1;
    }
    assert ok != NB;
    assert FIELDS[ok].kind == K_BOOLEAN and FIELDS[ok].req;
    assert status != NB;
    assert FIELDS[status].kind == K_ARRAY and FIELDS[status].hi == 27 and FIELDS[status].req == false;
    assert child_count(status) == 1;
    assert FIELDS[status + 1].kind == K_INTEGER and FIELDS[status + 1].lo == 0 and FIELDS[status + 1].hi == 255;
}

test "negative control: a deeper step without a container, or a first row below the top" {
    assert step_ok(false, 0, K_STRING, 1) == false;
    assert step_ok(false, 0, K_BOOLEAN, 1) == false;
    assert step_ok(true, 0, K_OBJECT, 1) == false;
    assert step_ok(false, 1, K_OBJECT, 3) == false;
    assert step_ok(false, 3, K_STRING, 0);
}

test "negative control: an unnamed property, a named array item, a two-item array, a short tuple" {
    assert name_ok(K_OBJECT, false) == false;
    assert name_ok(K_ARRAY, true) == false;
    assert name_ok(K_TUPLE, true) == false;
    assert children_ok(K_ARRAY, NB, NB, 2) == false;
    assert children_ok(K_ARRAY, NB, NB, 0) == false;
    assert children_ok(K_TUPLE, 5, 5, 4) == false;
    assert children_ok(K_TUPLE, 0, 0, 0) == false;
    assert children_ok(K_STRING, NB, NB, 1) == false;
}

test "negative control: a bound on a boolean, an inverted range, an enum on an integer, a required item, a nullable input" {
    assert bounds_ok(K_BOOLEAN, 0, NB) == false;
    assert bounds_ok(K_OBJECT, NB, 3) == false;
    assert bounds_ok(K_INTEGER, 5, 4) == false;
    assert text_ok(K_INTEGER, true, false) == false;
    assert text_ok(K_ARRAY, false, true) == false;
    assert flags_ok(OUT, false, true, false) == false;
    assert flags_ok(IN, true, false, true) == false;
}
