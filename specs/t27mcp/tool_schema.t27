/// Descriptions more than one row shares.
pub const D_FRESH : str = "Bypass the 5-minute cache";
pub const D_REF : str = "Git ref to read; default master";
pub const D_PATH : str = "Exact corpus path, e.g. specs/tutorial/08_modules_and_arrays.t27";
pub const D_OUT_FILE : str = "Output file (default: the temp directory)";
pub const D_BRIEF : str = "The spec's brief record (specs/t27mcp/spec_brief.t27 owns its fields)";
/// A corpus path to a .t27 file, as server.mjs specPath() accepts it.
pub const P_T27_PATH : str = "^[A-Za-z0-9_./-]+[.]t27$";
/// The chat rule of telegram.t27: an optional minus and 1 to 20 digits, or an optional @ and 5 to 32 word characters.
pub const P_TG_CHAT : str = "^(-?[0-9]{1,20}|@?[A-Za-z0-9_]{5,32})$";
pub const D_TG_CHAT : str = "A chat id (digits, maybe a leading minus) or @username, as tg_dialogs prints it";
pub const D_TG_QUERY : str = "Words to find in message text";
pub const D_TG_LIMIT : str = "How many; default 25, at most 100";

