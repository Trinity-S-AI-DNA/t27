// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/tool_schema.t27 -- the input and output schema of every tool of the t27 MCP server
; (gHashTag/t27-mcp), as one table. The JSON Schema a client reads in tools/list is generated from it.
; --
; Why: until now each tool's inputSchema was written by hand in server.mjs, and no tool declared what it
; returns. A client could not tell an integer from a number (limit, maxSpecs, bits, minLines were all
; `number`), a closed set from free text (health, sort, state, status), or a bounded range from an open
; one (t27f_view scene 0..4, rows at most 4). MCP's schema is plumbing a client parses, so by our own rule
; it is generated from our own source, never hand-written. The idea comes from the morluto/rea 6.6.0 MCP
; contracts fix: advertise self-contained inputs, keep tuple, array, boolean and nested-object constraints
; in every schema profile, and put the output-schema profile into the catalog identity.
; --
; The table:
; - TOOLS has one row per tool: its name, whether it takes the shared spec filters, and what it returns.
; - FIELDS has one row per schema node, in depth-first order. A row's parent is the nearest earlier row of
;   the same tool and side whose depth is one less, so a row is never numbered by hand.
;   - An object's children are its properties (each has a name).
;   - An array has exactly one child, its item schema (no name).
;   - A tuple's children are its positions in order (no name); its length is lo = hi = the child count.
;   - A scalar has no children.
;   - lo and hi are minLength/maxLength on a string, minimum/maximum on an integer or a number, and
;     minItems/maxItems on an array or a tuple. NB means no bound.
;   - choices is an enum written "a|b|c"; pattern is an ECMA-262 regular expression. Strings only.
; - Inputs are self-contained: no $ref, no definitions; a top-level input object refuses unknown keys.
;   Outputs stay open (a reader must tolerate a new field), and an object with no children is any object:
;   its shape belongs to another spec (spec_brief.t27 owns the brief record), not to a second copy here.
; - A tool whose result is text (OUT_TEXT) or arbitrary JSON (OUT_ANY) declares no output schema. A
;   schema that claims a shape the result does not have is worse than no schema.
; --
; Profiles. PROFILE_INPUT advertises inputs only, under protocol 2024-11-05, which has no outputSchema.
; PROFILE_OUTPUT also advertises outputSchema and returns structuredContent, under 2025-06-18. A tuple
; is prefixItems plus minItems and maxItems, so its length holds in a draft-07 reader that ignores
; prefixItems and its positions hold in a 2020-12 reader. The catalog identity a client caches is
; "<spec_hash of this spec's seal>/p<profile>": a change to this table or to the profile changes it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27mcpToolSchema;

/// Schema kinds, as indices into KIND_JSON.
pub const K_STRING : u32 = 1;
pub const K_INTEGER : u32 = 2;
pub const K_NUMBER : u32 = 3;
pub const K_BOOLEAN : u32 = 4;
pub const K_ARRAY : u32 = 5;
pub const K_TUPLE : u32 = 6;
pub const K_OBJECT : u32 = 7;
pub const K_ANY : u32 = 8;
pub const KIND_COUNT : u32 = 9;
/// The JSON Schema `type` of each kind; "" is no type keyword (any value).
pub const KIND_JSON : [9]str = ["", "string", "integer", "number", "boolean", "array", "array", "object", ""];

/// Which side of a call a row describes.
pub const IN : u32 = 0;
pub const OUT : u32 = 1;

/// What a tool returns.
pub const OUT_OBJECT : u32 = 0;
pub const OUT_TEXT : u32 = 1;
pub const OUT_ANY : u32 = 2;

/// No bound.
pub const NB : u32 = 4294967295;

/// The tool column of the shared spec filters, which t27_specs and t27_grep both take.
pub const G_SPEC_FILTERS : u32 = 1000;

/// Profiles and the protocol version each one answers.
pub const PROFILE_INPUT : u32 = 0;
pub const PROFILE_OUTPUT : u32 = 1;
pub const PROFILE_COUNT : u32 = 2;
pub const DEFAULT_PROFILE : u32 = 0;
pub const PROFILE_ENV : str = "T27_MCP_OUTPUT_PROFILE";
pub const PROTOCOL : [2]str = ["2024-11-05", "2025-06-18"];
/// Where tools/list carries the catalog identity, and the vendored seal it reads spec_hash from.
pub const CATALOG_META_KEY : str = "t27/catalog";
pub const SEAL_FILE : str = "tool_schema.seal.json";
pub const SPEC_PATH : str = "specs/t27mcp/tool_schema.t27";

pub struct Tool {
    name: str,
    filters: bool,
    out: u32,
}

pub struct Field {
    tool: u32,
    side: u32,
    depth: u32,
    name: str,
    kind: u32,
    req: bool,
    nullable: bool,
    lo: u32,
    hi: u32,
    choices: str,
    pattern: str,
    desc: str,
}

/// Tools, as indices into TOOLS.
pub const T_STATUS : u32 = 0;
pub const T_FORMATS : u32 = 1;
pub const T_FORMAT : u32 = 2;
pub const T_SPECS : u32 = 3;
