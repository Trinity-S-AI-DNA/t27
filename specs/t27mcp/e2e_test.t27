// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/e2e_test.t27 -- E2E flow spec for the t27 MCP MVP minimum closed loop
; Traces one full request cycle: create_request -> decompose -> submit_verdict -> resolve_owner
; -> synthesize_queen -> append_golden_chain.
; Outcomes are PASS / BLOCKED / FAIL (never silent).
; A cycle PASSES only when every flow step reaches FS_CHAIN_APPEND and the chain is closed.
; Wave D of ORDER: T27_MCP_RUNTIME_E2E_V1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpE2eTest;

/// Flow steps in the minimum E2E cycle. Order is stable.
pub const FS_CREATE_REQUEST   : u8 = 0;
pub const FS_DECOMPOSE        : u8 = 1;
pub const FS_SUBMIT_VERDICT   : u8 = 2;
pub const FS_RESOLVE_OWNER    : u8 = 3;
pub const FS_SYNTHESIZE_QUEEN : u8 = 4;
pub const FS_CHAIN_APPEND     : u8 = 5;
pub const FS_COUNT            : u8 = 6;

pub const FS_TEXT : [6]str = [
    "create_request",
    "decompose",
    "submit_verdict",
    "resolve_owner",
    "synthesize_queen",
    "chain_append",
];

/// Test outcome per step or for the full flow.
pub const TO_PASS    : u8 = 0;  // step completed correctly
pub const TO_BLOCKED : u8 = 1;  // step could not proceed (missing input, quota, etc.)
pub const TO_FAIL    : u8 = 2;  // step completed incorrectly (invariant violated)
pub const TO_PENDING : u8 = 3;  // step not yet reached
pub const TO_COUNT   : u8 = 4;

pub const TO_TEXT : [4]str = ["PASS", "BLOCKED", "FAIL", "PENDING"];

/// Cycle completion markers.
/// A cycle is complete only when chain_append passes.
/// An incomplete cycle is BLOCKED or FAIL depending on the first non-PASS step.
pub const CYCLE_MIN_STEPS : u8 = 6;  // FS_COUNT: all steps must reach PASS

/// A flow passes when every step in the minimum cycle reached TO_PASS.
pub fn flow_passes(last_step_outcome: u8) -> bool {
    return last_step_outcome == TO_PASS;
}

/// A flow is terminal (no further retry makes sense) only on FAIL.
/// BLOCKED means the flow can be retried after the blocking resource is resolved.
pub fn flow_terminal(outcome: u8) -> bool {
    return outcome == TO_FAIL;
}

/// A flow is retryable when it was blocked (not when it failed).
pub fn flow_retryable(outcome: u8) -> bool {
    return outcome == TO_BLOCKED;
}

/// Step ordering invariant: chain_append is always the last step.
pub const CHAIN_APPEND_IS_LAST : u8 = FS_COUNT - 1;

test flow_step_codes_stable {
    assert FS_CREATE_REQUEST   == 0;
    assert FS_DECOMPOSE        == 1;
    assert FS_SUBMIT_VERDICT   == 2;
    assert FS_RESOLVE_OWNER    == 3;
    assert FS_SYNTHESIZE_QUEEN == 4;
    assert FS_CHAIN_APPEND     == 5;
    assert FS_COUNT            == 6;
    assert FS_TEXT[FS_CREATE_REQUEST] == "create_request";
    assert FS_TEXT[FS_CHAIN_APPEND]   == "chain_append";
}

test test_outcome_codes_stable {
    assert TO_PASS    == 0;
    assert TO_BLOCKED == 1;
    assert TO_FAIL    == 2;
    assert TO_PENDING == 3;
    assert TO_COUNT   == 4;
    assert TO_TEXT[TO_PASS]    == "PASS";
    assert TO_TEXT[TO_BLOCKED] == "BLOCKED";
    assert TO_TEXT[TO_FAIL]    == "FAIL";
}

test flow_pass_requires_all_steps {
    assert flow_passes(TO_PASS);
    assert flow_passes(TO_BLOCKED) == false;
    assert flow_passes(TO_FAIL)    == false;
    assert flow_passes(TO_PENDING) == false;
}

test blocked_is_retryable_fail_is_not {
    assert flow_retryable(TO_BLOCKED);
    assert flow_retryable(TO_FAIL)    == false;
    assert flow_retryable(TO_PASS)    == false;
    assert flow_retryable(TO_PENDING) == false;
    assert flow_terminal(TO_FAIL);
    assert flow_terminal(TO_BLOCKED) == false;
    assert flow_terminal(TO_PASS)    == false;
}

test chain_append_is_last_step {
    assert CHAIN_APPEND_IS_LAST == 5;
    assert FS_CHAIN_APPEND      == CHAIN_APPEND_IS_LAST;
}

test cycle_min_steps_matches_count {
    assert CYCLE_MIN_STEPS == FS_COUNT;
}

invariant flow_step_count {
    assert FS_COUNT == 6;
}

invariant test_outcome_count {
    assert TO_COUNT == 4;
}
