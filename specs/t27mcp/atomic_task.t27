// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/atomic_task.t27 -- atomic task schema for the t27 MCP MVP pipeline
; An atomic task is one node in the dependency graph derived from a request envelope
; (specs/t27mcp/request_envelope.t27). Its status machine is the only canonical record
; of what a node may do next. No implementation begins until this schema is frozen.
; Wave B of ORDER: T27_MCP_MVP_V1. Schema and tests only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpAtomicTask;

/// Task status machine. Transitions are enforced by the pipeline, not by the UI.
pub const TS_DRAFT     : u8 = 0;
pub const TS_SPECIFIED : u8 = 1;
pub const TS_READY     : u8 = 2;
pub const TS_RUNNING   : u8 = 3;
pub const TS_BLOCKED   : u8 = 4;
pub const TS_DONE      : u8 = 5;
pub const TS_FAILED    : u8 = 6;
pub const TS_COUNT     : u8 = 7;

pub const TS_TEXT : [7]str = [
    "DRAFT",
    "SPECIFIED",
    "READY",
    "RUNNING",
    "BLOCKED",
    "DONE",
    "FAILED",
];

/// A terminal status cannot advance further without owner action.
pub fn is_terminal(status: u8) -> bool {
    if (status == TS_DONE)   { return true; }
    if (status == TS_FAILED) { return true; }
    return false;
}

/// An active status means the task holds a lease or is on a worker.
pub fn is_active(status: u8) -> bool {
    if (status == TS_RUNNING) { return true; }
    if (status == TS_BLOCKED) { return true; }
    return false;
}

/// Task id prefix. Ids begin with "task_" and are 10-64 characters.
pub const TASK_ID_PREFIX : str = "task_";
pub const TASK_ID_MIN    : u32 = 10;
pub const TASK_ID_MAX    : u32 = 64;

/// Acceptance criterion kinds: what a task needs to reach TS_DONE.
pub const AC_FUNCTIONAL : u8 = 0;
pub const AC_INVARIANT  : u8 = 1;
pub const AC_BENCHMARK  : u8 = 2;
pub const AC_COUNT      : u8 = 3;

pub const AC_TEXT : [3]str = ["functional", "invariant", "benchmark"];

/// Benchmark requirement: either required or explicitly not applicable.
pub const BR_REQUIRED       : u8 = 0;
pub const BR_NOT_APPLICABLE : u8 = 1;
pub const BR_COUNT          : u8 = 2;

/// Maximum dependency depth: prevents cycle confusion and deep fan-out.
pub const MAX_DEPTH : u32 = 32;

/// Maximum tasks per atomic graph derived from one request.
pub const MAX_TASKS : u32 = 256;

test status_codes_are_stable {
    assert TS_DRAFT     == 0;
    assert TS_SPECIFIED == 1;
    assert TS_READY     == 2;
    assert TS_RUNNING   == 3;
    assert TS_BLOCKED   == 4;
    assert TS_DONE      == 5;
    assert TS_FAILED    == 6;
    assert TS_COUNT     == 7;
}

test status_text_covers_all {
    assert TS_TEXT[TS_DRAFT]     == "DRAFT";
    assert TS_TEXT[TS_SPECIFIED] == "SPECIFIED";
    assert TS_TEXT[TS_DONE]      == "DONE";
    assert TS_TEXT[TS_FAILED]    == "FAILED";
}

test terminal_statuses {
    assert is_terminal(TS_DONE);
    assert is_terminal(TS_FAILED);
    assert is_terminal(TS_DRAFT)     == false;
    assert is_terminal(TS_RUNNING)   == false;
    assert is_terminal(TS_BLOCKED)   == false;
    assert is_terminal(TS_SPECIFIED) == false;
    assert is_terminal(TS_READY)     == false;
}

test active_statuses {
    assert is_active(TS_RUNNING);
    assert is_active(TS_BLOCKED);
    assert is_active(TS_DRAFT)     == false;
    assert is_active(TS_SPECIFIED) == false;
    assert is_active(TS_DONE)      == false;
}

test acceptance_criterion_kinds {
    assert AC_FUNCTIONAL == 0;
    assert AC_INVARIANT  == 1;
    assert AC_BENCHMARK  == 2;
    assert AC_COUNT      == 3;
    assert AC_TEXT[AC_FUNCTIONAL] == "functional";
    assert AC_TEXT[AC_BENCHMARK]  == "benchmark";
}

test id_bounds {
    assert TASK_ID_MIN == 10;
    assert TASK_ID_MAX == 64;
    assert TASK_ID_MIN < TASK_ID_MAX;
    assert TASK_ID_PREFIX == "task_";
}

test depth_and_size_limits {
    assert MAX_DEPTH == 32;
    assert MAX_TASKS == 256;
}

invariant status_count {
    assert TS_COUNT == 7;
}

invariant acceptance_criterion_count {
    assert AC_COUNT == 3;
}
