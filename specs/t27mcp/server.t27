// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/server.t27 -- MCP server dispatch and state machine for the t27 MCP MVP
; The server advances pipeline state through the 17 MT_* tools (McpMvpToolRegistry).
; It never hand-writes handler logic -- handlers are Wave C..K work.
; This spec defines: server state, dispatch result, pipeline stage grouping, chain write-back.
; Wave D of ORDER: T27_MCP_RUNTIME_E2E_V1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpServer;

/// Server lifecycle states. Order is stable; a state never moves.
pub const SS_IDLE             : u8 = 0;  // no request in flight
pub const SS_IN_FLIGHT        : u8 = 1;  // tool call received, dispatching
pub const SS_AWAITING_VERDICT : u8 = 2;  // waiting for a domain verdict
pub const SS_CHAIN_CLOSED     : u8 = 3;  // golden chain appended; cycle complete
pub const SS_ERROR            : u8 = 4;  // unrecoverable dispatch error
pub const SS_COUNT            : u8 = 5;

pub const SS_TEXT : [5]str = [
    "IDLE",
    "IN_FLIGHT",
    "AWAITING_VERDICT",
    "CHAIN_CLOSED",
    "ERROR",
];

/// Dispatch results.
pub const DR_DISPATCHED   : u8 = 0;  // tool found and accepted
pub const DR_UNKNOWN_TOOL : u8 = 1;  // tool index out of range
pub const DR_REJECTED     : u8 = 2;  // tool known but not callable in this state
pub const DR_COUNT        : u8 = 3;

pub const DR_TEXT : [3]str = ["DISPATCHED", "UNKNOWN_TOOL", "REJECTED"];

/// Pipeline stage groups: tools are grouped by when in the pipeline they run.
/// Groups match the ORDER wave phases; stable ordinals.
pub const SG_AUTOMATION_READINESS : u8 = 0;  // Wave B: status only
pub const SG_REQUEST_INTAKE       : u8 = 1;  // Wave C: create, decompose, triage
pub const SG_OWNER_RESOLUTION     : u8 = 2;  // Wave B1: resolve owner
pub const SG_VERDICT_COLLECTION   : u8 = 3;  // Wave D: submit verdict, get missing
pub const SG_QUEEN_SYNTHESIS      : u8 = 4;  // Wave E-G: synthesize, Pareto, mega epic
pub const SG_SPEC_EXECUTION       : u8 = 5;  // Wave H-I: freeze, assign, record, verify
pub const SG_CHAIN_WRITEOUT       : u8 = 6;  // Wave K: append golden chain
pub const SG_MEMORY_QUERY         : u8 = 7;  // Wave H: query memory
pub const SG_COUNT                : u8 = 8;

/// Tool stage assignments: maps MT_* index -> SG_* group.
/// Must be consistent with TOOL_PHASE in tool_registry.t27.
pub const TOOL_STAGE : [17]u8 = [
    SG_REQUEST_INTAKE,       // MT_CREATE_REQUEST        0
    SG_REQUEST_INTAKE,       // MT_DECOMPOSE_REQUEST     1
    SG_REQUEST_INTAKE,       // MT_TRIAGE_REQUEST        2
    SG_VERDICT_COLLECTION,   // MT_SUBMIT_DOMAIN_VERDICT 3
    SG_VERDICT_COLLECTION,   // MT_GET_MISSING_VERDICTS  4
    SG_OWNER_RESOLUTION,     // MT_RESOLVE_OWNER         5
    SG_QUEEN_SYNTHESIS,      // MT_SYNTHESIZE_QUEEN      6
    SG_QUEEN_SYNTHESIS,      // MT_COMPUTE_PARETO        7
    SG_QUEEN_SYNTHESIS,      // MT_CREATE_MEGA_EPIC      8
    SG_QUEEN_SYNTHESIS,      // MT_GET_DOMAIN_EPICS      9
    SG_SPEC_EXECUTION,       // MT_FREEZE_SPECIFICATION  10
    SG_SPEC_EXECUTION,       // MT_ASSIGN_EXECUTION      11
    SG_SPEC_EXECUTION,       // MT_RECORD_EXECUTION      12
    SG_SPEC_EXECUTION,       // MT_VERIFY_ARTIFACT       13
    SG_CHAIN_WRITEOUT,       // MT_APPEND_GOLDEN_CHAIN   14
    SG_MEMORY_QUERY,         // MT_QUERY_MEMORY          15
    SG_AUTOMATION_READINESS, // MT_GET_AUTOMATION_STATUS 16
];

/// A dispatch succeeds when the tool index is in range.
pub fn dispatch_ok(tool_id: u32) -> bool {
    return tool_id < 17;
}

/// A dispatch result is accepted when the tool was found and queued.
pub fn dispatch_accepted(result: u8) -> bool {
    return result == DR_DISPATCHED;
}

/// Terminal states: no further state transition is expected.
pub fn state_is_terminal(state: u8) -> bool {
    if (state == SS_CHAIN_CLOSED) { return true; }
    if (state == SS_ERROR)        { return true; }
    return false;
}

/// The chain is closed when the golden chain tool completed successfully.
pub fn is_chain_closed(state: u8) -> bool {
    return state == SS_CHAIN_CLOSED;
}

/// The chain write-back is the LAST step in the pipeline.
/// A cycle is complete only after MT_APPEND_GOLDEN_CHAIN succeeds.
pub const CHAIN_WRITEOUT_TOOL : u32 = 14;  // MT_APPEND_GOLDEN_CHAIN

test server_state_codes_stable {
    assert SS_IDLE             == 0;
    assert SS_IN_FLIGHT        == 1;
    assert SS_AWAITING_VERDICT == 2;
    assert SS_CHAIN_CLOSED     == 3;
    assert SS_ERROR            == 4;
    assert SS_COUNT            == 5;
    assert SS_TEXT[SS_CHAIN_CLOSED] == "CHAIN_CLOSED";
    assert SS_TEXT[SS_ERROR]        == "ERROR";
}

test dispatch_result_codes_stable {
    assert DR_DISPATCHED   == 0;
    assert DR_UNKNOWN_TOOL == 1;
    assert DR_REJECTED     == 2;
    assert DR_COUNT        == 3;
}

test dispatch_ok_boundary {
    assert dispatch_ok(0);
    assert dispatch_ok(16);
    assert dispatch_ok(17) == false;
    assert dispatch_ok(255) == false;
}

test terminal_states {
    assert state_is_terminal(SS_CHAIN_CLOSED);
    assert state_is_terminal(SS_ERROR);
    assert state_is_terminal(SS_IDLE)             == false;
    assert state_is_terminal(SS_IN_FLIGHT)        == false;
    assert state_is_terminal(SS_AWAITING_VERDICT) == false;
}

test chain_writeout_tool_index {
    assert CHAIN_WRITEOUT_TOOL == 14;
    assert dispatch_ok(CHAIN_WRITEOUT_TOOL);
    assert TOOL_STAGE[CHAIN_WRITEOUT_TOOL] == SG_CHAIN_WRITEOUT;
}

test get_automation_status_is_readiness {
    assert TOOL_STAGE[16] == SG_AUTOMATION_READINESS;
}

test request_intake_tools_are_first_stage {
    assert TOOL_STAGE[0] == SG_REQUEST_INTAKE;
    assert TOOL_STAGE[1] == SG_REQUEST_INTAKE;
    assert TOOL_STAGE[2] == SG_REQUEST_INTAKE;
}

invariant server_state_count {
    assert SS_COUNT == 5;
}

invariant dispatch_result_count {
    assert DR_COUNT == 3;
}

invariant stage_count {
    assert SG_COUNT == 8;
}
