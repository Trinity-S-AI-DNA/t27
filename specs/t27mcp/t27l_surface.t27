// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/t27l_surface.t27 -- T27L surface and action constants for the t27 MCP MVP pipeline
; T27L is the control plane, not just an audit log. It records what happened AND who is authorized
; to act next. Rule: a T27L event does not substitute for policy/owner approval, CI checks or
; sandbox verification. It is proof and provenance only.
; Wave B of ORDER: T27_MCP_MVP_V1. Schema and tests only; no writer implementation.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpT27lSurface;

/// Top-level surfaces. Each surface groups a family of related events.
pub const SF_PIPELINE         : u8 = 0;
pub const SF_OWNER_RESOLUTION : u8 = 1;
pub const SF_CAPABILITY       : u8 = 2;
pub const SF_AUTOMATION       : u8 = 3;
pub const SF_EXECUTION        : u8 = 4;
pub const SF_VERIFICATION     : u8 = 5;
pub const SF_GOLDEN_CHAIN     : u8 = 6;
pub const SF_COUNT            : u8 = 7;

pub const SF_TEXT : [7]str = [
    "pipeline",
    "owner_resolution",
    "capability",
    "automation_control",
    "execution",
    "verification",
    "golden_chain",
];

/// pipeline surface actions.
pub const PA_REQUEST_CREATED   : u8 = 0;
pub const PA_TASK_GRAPH_BUILT  : u8 = 1;
pub const PA_VERDICT_SUBMITTED : u8 = 2;
pub const PA_QUEEN_DECIDED     : u8 = 3;
pub const PA_PARETO_COMPUTED   : u8 = 4;
pub const PA_SPEC_FROZEN       : u8 = 5;
pub const PA_COUNT             : u8 = 6;

/// owner_resolution surface actions.
pub const RA_RESOLVED          : u8 = 0;
pub const RA_CONFLICT_DETECTED : u8 = 1;
pub const RA_ORPHAN_DETECTED   : u8 = 2;
pub const RA_ESCALATED         : u8 = 3;
pub const RA_COUNT             : u8 = 4;

/// capability surface actions.
pub const CA_GRANTED : u8 = 0;
pub const CA_USED    : u8 = 1;
pub const CA_REVOKED : u8 = 2;
pub const CA_COUNT   : u8 = 3;

/// automation_control surface actions (what the pipeline discovered or changed).
pub const AA_DISCOVERED : u8 = 0;
pub const AA_CHANGED    : u8 = 1;
pub const AA_DISABLED   : u8 = 2;
pub const AA_COUNT      : u8 = 3;

/// execution surface actions.
pub const EA_ASSIGNED : u8 = 0;
pub const EA_STARTED  : u8 = 1;
pub const EA_FINISHED : u8 = 2;
pub const EA_FAILED   : u8 = 3;
pub const EA_COUNT    : u8 = 4;

/// verification surface actions.
pub const VA_PASSED    : u8 = 0;
pub const VA_FAILED    : u8 = 1;
pub const VA_ESCALATED : u8 = 2;
pub const VA_COUNT     : u8 = 3;

/// golden_chain surface actions.
pub const GA_LINK_ADDED    : u8 = 0;
pub const GA_CHAIN_SEALED  : u8 = 1;
pub const GA_COUNT         : u8 = 2;

/// Protocol version prefix for all T27L events in this spec.
pub const T27L_VERSION : str = "t27l/v1";

/// Event id prefix.
pub const EVENT_ID_PREFIX : str = "evt_";

/// Actor id format: 0x<Role>@<slug>.t27
pub const ACTOR_PREFIX : str = "0x";
pub const ACTOR_SUFFIX : str = ".t27";

test surfaces_stable {
    assert SF_PIPELINE         == 0;
    assert SF_OWNER_RESOLUTION == 1;
    assert SF_CAPABILITY       == 2;
    assert SF_AUTOMATION       == 3;
    assert SF_EXECUTION        == 4;
    assert SF_VERIFICATION     == 5;
    assert SF_GOLDEN_CHAIN     == 6;
    assert SF_COUNT            == 7;
    assert SF_TEXT[SF_PIPELINE]     == "pipeline";
    assert SF_TEXT[SF_GOLDEN_CHAIN] == "golden_chain";
    assert SF_TEXT[SF_AUTOMATION]   == "automation_control";
}

test pipeline_actions_stable {
    assert PA_REQUEST_CREATED   == 0;
    assert PA_TASK_GRAPH_BUILT  == 1;
    assert PA_VERDICT_SUBMITTED == 2;
    assert PA_QUEEN_DECIDED     == 3;
    assert PA_PARETO_COMPUTED   == 4;
    assert PA_SPEC_FROZEN       == 5;
    assert PA_COUNT             == 6;
}

test owner_resolution_actions_stable {
    assert RA_RESOLVED          == 0;
    assert RA_CONFLICT_DETECTED == 1;
    assert RA_ORPHAN_DETECTED   == 2;
    assert RA_ESCALATED         == 3;
    assert RA_COUNT             == 4;
}

test capability_actions_stable {
    assert CA_GRANTED == 0;
    assert CA_USED    == 1;
    assert CA_REVOKED == 2;
    assert CA_COUNT   == 3;
}

test t27l_is_proof_not_authorization {
    // T27L records events; it cannot substitute for policy or owner approval.
    assert T27L_VERSION   == "t27l/v1";
    assert ACTOR_PREFIX   == "0x";
    assert ACTOR_SUFFIX   == ".t27";
    assert EVENT_ID_PREFIX == "evt_";
}

test action_counts {
    assert PA_COUNT == 6;
    assert RA_COUNT == 4;
    assert CA_COUNT == 3;
    assert AA_COUNT == 3;
    assert EA_COUNT == 4;
    assert VA_COUNT == 3;
    assert GA_COUNT == 2;
}

invariant surface_count {
    assert SF_COUNT == 7;
}

invariant version_stable {
    assert T27L_VERSION == "t27l/v1";
}
