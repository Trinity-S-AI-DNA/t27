// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/chain_replay.t27 -- replay schema for independent Golden Chain verification
; A chain is verified when an independent checker replays its steps and reaches the same result.
; MATCH = deterministic. DIVERGED = non-determinism that must be explained or invalidated.
; INCOMPLETE = inputs missing; the chain cannot be verified until they are provided.
; Wave C of ORDER: T27_GOLDEN_CHAIN_CLOSE_LOOP_V1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpChainReplay;

/// Replay outcomes.
pub const RO_MATCH      : u8 = 0;
pub const RO_DIVERGED   : u8 = 1;
pub const RO_INCOMPLETE : u8 = 2;
pub const RO_PENDING    : u8 = 3;
pub const RO_COUNT      : u8 = 4;

pub const RO_TEXT : [4]str = ["MATCH", "DIVERGED", "INCOMPLETE", "PENDING"];

/// Step kinds: the parts of a chain that can be replayed independently.
pub const SK_VERDICT_RECORD : u8 = 0;
pub const SK_SPEC_FREEZE    : u8 = 1;
pub const SK_TEST_RUN       : u8 = 2;
pub const SK_VERIFICATION   : u8 = 3;
pub const SK_CHAIN_HASH     : u8 = 4;
pub const SK_MEMORY_RECORD  : u8 = 5;
pub const SK_COUNT          : u8 = 6;

pub const SK_TEXT : [6]str = [
    "verdict_record",
    "spec_freeze",
    "test_run",
    "verification",
    "chain_hash",
    "memory_record",
];

pub const REPLAY_ID_PREFIX : str = "rpl_";

/// A replay is successful only when every replayed step matches.
pub fn replay_succeeded(outcome: u8) -> bool {
    return outcome == RO_MATCH;
}

/// A diverged or incomplete replay must be investigated, not silently accepted.
pub fn requires_investigation(outcome: u8) -> bool {
    if (outcome == RO_DIVERGED)   { return true; }
    if (outcome == RO_INCOMPLETE) { return true; }
    return false;
}

test replay_outcome_codes_stable {
    assert RO_MATCH      == 0;
    assert RO_DIVERGED   == 1;
    assert RO_INCOMPLETE == 2;
    assert RO_PENDING    == 3;
    assert RO_COUNT      == 4;
    assert RO_TEXT[RO_MATCH]      == "MATCH";
    assert RO_TEXT[RO_DIVERGED]   == "DIVERGED";
    assert RO_TEXT[RO_INCOMPLETE] == "INCOMPLETE";
}

test step_kinds_stable {
    assert SK_VERDICT_RECORD == 0;
    assert SK_SPEC_FREEZE    == 1;
    assert SK_TEST_RUN       == 2;
    assert SK_VERIFICATION   == 3;
    assert SK_CHAIN_HASH     == 4;
    assert SK_MEMORY_RECORD  == 5;
    assert SK_COUNT          == 6;
    assert SK_TEXT[SK_TEST_RUN]      == "test_run";
    assert SK_TEXT[SK_CHAIN_HASH]    == "chain_hash";
    assert SK_TEXT[SK_MEMORY_RECORD] == "memory_record";
}

test succeeded_requires_match {
    assert replay_succeeded(RO_MATCH);
    assert replay_succeeded(RO_DIVERGED)   == false;
    assert replay_succeeded(RO_INCOMPLETE) == false;
    assert replay_succeeded(RO_PENDING)    == false;
}

test investigation_required_for_bad_outcomes {
    assert requires_investigation(RO_DIVERGED);
    assert requires_investigation(RO_INCOMPLETE);
    assert requires_investigation(RO_MATCH)   == false;
    assert requires_investigation(RO_PENDING) == false;
}

invariant replay_outcome_count {
    assert RO_COUNT == 4;
}

invariant step_kind_count {
    assert SK_COUNT == 6;
}
