// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/tool_registry.t27 -- the 17 MCP pipeline management tools for the t27 MCP MVP
; These tools form a NEW MCP server (t27-mcp pipeline server), separate from the read-only
; query server (tool_schema.t27). No tool here reads corpus data; each advances or queries
; the canonical pipeline state. Handlers are Wave I (Needle Coder) work; this spec is schema only.
; Tool names use t27_ prefix (service.t27 / T27_PREFIXES[0]) so t27 module owns every name.
; Wave B of ORDER: T27_MCP_MVP_V1. Registry only; no handler code.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpMvpToolRegistry;

/// Tool indices. Order is stable; a tool never moves once deployed.
pub const MT_CREATE_REQUEST        : u32 = 0;
pub const MT_DECOMPOSE_REQUEST     : u32 = 1;
pub const MT_TRIAGE_REQUEST        : u32 = 2;
pub const MT_SUBMIT_DOMAIN_VERDICT : u32 = 3;
pub const MT_GET_MISSING_VERDICTS  : u32 = 4;
pub const MT_RESOLVE_OWNER         : u32 = 5;
pub const MT_SYNTHESIZE_QUEEN      : u32 = 6;
pub const MT_COMPUTE_PARETO        : u32 = 7;
pub const MT_CREATE_MEGA_EPIC      : u32 = 8;
pub const MT_GET_DOMAIN_EPICS      : u32 = 9;
pub const MT_FREEZE_SPECIFICATION  : u32 = 10;
pub const MT_ASSIGN_EXECUTION      : u32 = 11;
pub const MT_RECORD_EXECUTION      : u32 = 12;
pub const MT_VERIFY_ARTIFACT       : u32 = 13;
pub const MT_APPEND_GOLDEN_CHAIN   : u32 = 14;
pub const MT_QUERY_MEMORY          : u32 = 15;
pub const MT_GET_AUTOMATION_STATUS : u32 = 16;
pub const MVP_TOOL_COUNT           : u32 = 17;

pub const MVP_TOOL_NAMES : [17]str = [
    "t27_create_request",
    "t27_decompose_request",
    "t27_triage_request",
    "t27_submit_domain_verdict",
    "t27_get_missing_verdicts",
    "t27_resolve_owner",
    "t27_synthesize_queen_decision",
    "t27_compute_pareto",
    "t27_create_mega_epic",
    "t27_get_domain_epics",
    "t27_freeze_specification",
    "t27_assign_execution",
    "t27_record_execution_result",
    "t27_verify_artifact",
    "t27_append_golden_chain",
    "t27_query_memory",
    "t27_get_automation_status",
];

/// Every MVP tool name uses the t27_ prefix (service.t27 T27_PREFIXES[0]).
pub const MVP_TOOL_PREFIX : str = "t27_";

/// Wave phase that implements each tool handler.
pub const PH_WAVE_B  : u8 = 1;
pub const PH_WAVE_B1 : u8 = 2;
pub const PH_WAVE_C  : u8 = 3;
pub const PH_WAVE_D  : u8 = 4;
pub const PH_WAVE_E  : u8 = 5;
pub const PH_WAVE_F  : u8 = 6;
pub const PH_WAVE_G  : u8 = 7;
pub const PH_WAVE_H  : u8 = 8;
pub const PH_WAVE_I  : u8 = 9;
pub const PH_WAVE_J  : u8 = 10;
pub const PH_WAVE_K  : u8 = 11;
pub const PH_COUNT   : u8 = 12;

pub const TOOL_PHASE : [17]u8 = [
    PH_WAVE_C,   // t27_create_request
    PH_WAVE_C,   // t27_decompose_request
    PH_WAVE_C,   // t27_triage_request
    PH_WAVE_D,   // t27_submit_domain_verdict
    PH_WAVE_D,   // t27_get_missing_verdicts
    PH_WAVE_B1,  // t27_resolve_owner
    PH_WAVE_E,   // t27_synthesize_queen_decision
    PH_WAVE_F,   // t27_compute_pareto
    PH_WAVE_G,   // t27_create_mega_epic
    PH_WAVE_G,   // t27_get_domain_epics
    PH_WAVE_H,   // t27_freeze_specification
    PH_WAVE_I,   // t27_assign_execution
    PH_WAVE_I,   // t27_record_execution_result
    PH_WAVE_I,   // t27_verify_artifact
    PH_WAVE_K,   // t27_append_golden_chain
    PH_WAVE_H,   // t27_query_memory
    PH_WAVE_B,   // t27_get_automation_status
];

test tool_count_is_17 {
    assert MVP_TOOL_COUNT == 17;
}

test tool_names_stable {
    assert MVP_TOOL_NAMES[MT_CREATE_REQUEST]        == "t27_create_request";
    assert MVP_TOOL_NAMES[MT_RESOLVE_OWNER]         == "t27_resolve_owner";
    assert MVP_TOOL_NAMES[MT_SYNTHESIZE_QUEEN]      == "t27_synthesize_queen_decision";
    assert MVP_TOOL_NAMES[MT_APPEND_GOLDEN_CHAIN]   == "t27_append_golden_chain";
    assert MVP_TOOL_NAMES[MT_GET_AUTOMATION_STATUS] == "t27_get_automation_status";
    assert MVP_TOOL_NAMES[MT_FREEZE_SPECIFICATION]  == "t27_freeze_specification";
}

test tool_indices_stable {
    assert MT_CREATE_REQUEST        == 0;
    assert MT_RESOLVE_OWNER         == 5;
    assert MT_SYNTHESIZE_QUEEN      == 6;
    assert MT_APPEND_GOLDEN_CHAIN   == 14;
    assert MT_GET_AUTOMATION_STATUS == 16;
    assert MVP_TOOL_COUNT           == 17;
}

test resolve_owner_is_wave_b1 {
    assert TOOL_PHASE[MT_RESOLVE_OWNER] == PH_WAVE_B1;
}

test get_automation_status_is_wave_b {
    // This is the first observable tool: it reports pipeline readiness from Wave B.
    assert TOOL_PHASE[MT_GET_AUTOMATION_STATUS] == PH_WAVE_B;
}

test golden_chain_is_last_wave {
    // append_golden_chain is Wave K, the final wave.
    assert TOOL_PHASE[MT_APPEND_GOLDEN_CHAIN] == PH_WAVE_K;
}

test needle_coder_tools_are_wave_i {
    assert TOOL_PHASE[MT_ASSIGN_EXECUTION]  == PH_WAVE_I;
    assert TOOL_PHASE[MT_RECORD_EXECUTION]  == PH_WAVE_I;
    assert TOOL_PHASE[MT_VERIFY_ARTIFACT]   == PH_WAVE_I;
}

invariant tool_count {
    assert MVP_TOOL_COUNT == 17;
}
