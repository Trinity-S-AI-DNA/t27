// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/handler_decompose_request.t27 -- Handler spec for the t27_decompose_request MCP tool
; Takes a valid request envelope and splits it into one or more atomic sub-tasks.
; Returns HR_OK with at least one sub-task; HR_EMPTY_TASKS when decomposition yields nothing.
; Never silently returns zero tasks; refuses missing or already-decomposed requests.
; Wave E of ORDER: T27_MCP_HANDLER_TIER_1_V1 (gHashTag/t27#13560).
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpHandlerDecomposeRequest;

/// Handler result codes. Order is stable.
pub const HR_OK            : u8 = 0;  // request decomposed into >= 1 sub-tasks
pub const HR_NOT_FOUND     : u8 = 1;  // request_id not found in the envelope store
pub const HR_INVALID_STATE : u8 = 2;  // request already decomposed or in wrong state
pub const HR_EMPTY_TASKS   : u8 = 3;  // decomposition yielded zero sub-tasks (spec error)
pub const HR_COUNT         : u8 = 4;

pub const HR_TEXT : [4]str = [
    "OK",
    "NOT_FOUND",
    "INVALID_STATE",
    "EMPTY_TASKS",
];

/// T27L event kind emitted on a successful decompose_request.
/// The event preserves: request_id, sub-task count, decompose timestamp, session provenance.
pub const TEK_REQUEST_DECOMPOSED : u8 = 11;

/// Minimum number of sub-tasks a valid decomposition must yield.
pub const MIN_SUBTASK_COUNT : u8 = 1;

/// Returns true when the handler produced at least one sub-task.
pub fn is_ok(result: u8) -> bool {
    return result == HR_OK;
}

/// Returns true when the handler accepted the call (found the request and decomposed it).
pub fn accepts(result: u8) -> bool {
    return result == HR_OK;
}

/// Returns true when the request was not found.
pub fn not_found(result: u8) -> bool {
    return result == HR_NOT_FOUND;
}

/// Returns true when state prevented decomposition (already done, wrong lifecycle stage).
pub fn state_refused(result: u8) -> bool {
    return result == HR_INVALID_STATE;
}

/// A decompose_request call writes a T27L event only on HR_OK.
/// HR_EMPTY_TASKS is a spec-level error: a decomposable request must always yield >= 1 task.
pub fn event_written(result: u8) -> bool {
    return result == HR_OK;
}

/// Returns true when the result means no sub-tasks were produced (regardless of reason).
pub fn produced_no_tasks(result: u8) -> bool {
    if (result == HR_EMPTY_TASKS)   { return true; }
    if (result == HR_NOT_FOUND)     { return true; }
    if (result == HR_INVALID_STATE) { return true; }
    return false;
}

test handler_result_codes_stable {
    assert HR_OK            == 0;
    assert HR_NOT_FOUND     == 1;
    assert HR_INVALID_STATE == 2;
    assert HR_EMPTY_TASKS   == 3;
    assert HR_COUNT         == 4;
    assert HR_TEXT[HR_OK]            == "OK";
    assert HR_TEXT[HR_NOT_FOUND]     == "NOT_FOUND";
    assert HR_TEXT[HR_INVALID_STATE] == "INVALID_STATE";
    assert HR_TEXT[HR_EMPTY_TASKS]   == "EMPTY_TASKS";
}

test t27l_event_kind_stable {
    assert TEK_REQUEST_DECOMPOSED == 11;
}

test accepts_only_on_ok {
    assert accepts(HR_OK);
    assert accepts(HR_NOT_FOUND)     == false;
    assert accepts(HR_INVALID_STATE) == false;
    assert accepts(HR_EMPTY_TASKS)   == false;
}

test produced_no_tasks_covers_all_non_ok {
    assert produced_no_tasks(HR_NOT_FOUND);
    assert produced_no_tasks(HR_INVALID_STATE);
    assert produced_no_tasks(HR_EMPTY_TASKS);
    assert produced_no_tasks(HR_OK) == false;
}

test event_written_only_on_ok {
    assert event_written(HR_OK);
    assert event_written(HR_NOT_FOUND)     == false;
    assert event_written(HR_INVALID_STATE) == false;
    assert event_written(HR_EMPTY_TASKS)   == false;
}

test min_subtask_count_positive {
    assert MIN_SUBTASK_COUNT == 1;
}

invariant handler_result_count {
    assert HR_COUNT == 4;
}

invariant decompose_event_distinct_from_create {
    assert TEK_REQUEST_DECOMPOSED != 10;
}
