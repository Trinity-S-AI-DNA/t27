// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/domain_verdict.t27 -- domain verdict schema for the t27 MCP MVP pipeline
; A verdict is a record, not a mandatory paid agent call. One of six types, produced by one
; of five sources. All 27 domains MUST have a verdict record (even NOT_APPLICABLE or
; INSUFFICIENT_EVIDENCE) before Queen synthesis may proceed.
; Key invariant: domain verdict != agent call. verdict_source records how it was produced.
; Wave B / Wave D of ORDER: T27_MCP_MVP_V1. Schema and tests only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpDomainVerdict;

/// The 27 domain codes. T27A through T27Z (0-25) plus T27# (26, cross-cutting kernel).
pub const D_T27A    : u8 = 0;
pub const D_T27B    : u8 = 1;
pub const D_T27C    : u8 = 2;
pub const D_T27D    : u8 = 3;
pub const D_T27E    : u8 = 4;
pub const D_T27F    : u8 = 5;
pub const D_T27G    : u8 = 6;
pub const D_T27H    : u8 = 7;
pub const D_T27I    : u8 = 8;
pub const D_T27J    : u8 = 9;
pub const D_T27K    : u8 = 10;
pub const D_T27L    : u8 = 11;
pub const D_T27M    : u8 = 12;
pub const D_T27N    : u8 = 13;
pub const D_T27O    : u8 = 14;
pub const D_T27P    : u8 = 15;
pub const D_T27Q    : u8 = 16;
pub const D_T27R    : u8 = 17;
pub const D_T27S    : u8 = 18;
pub const D_T27T    : u8 = 19;
pub const D_T27U    : u8 = 20;
pub const D_T27V    : u8 = 21;
pub const D_T27W    : u8 = 22;
pub const D_T27X    : u8 = 23;
pub const D_T27Y    : u8 = 24;
pub const D_T27Z    : u8 = 25;
pub const D_T27HASH : u8 = 26;
pub const DOMAIN_COUNT : u8 = 27;

/// Six verdict types. NOT_APPLICABLE and INSUFFICIENT_EVIDENCE are full verdicts, not errors.
pub const VT_SUPPORT               : u8 = 0;
pub const VT_OPPOSE                : u8 = 1;
pub const VT_CONDITIONAL           : u8 = 2;
pub const VT_INVESTIGATE           : u8 = 3;
pub const VT_NOT_APPLICABLE        : u8 = 4;
pub const VT_INSUFFICIENT_EVIDENCE : u8 = 5;
pub const VT_COUNT                 : u8 = 6;

pub const VT_TEXT : [6]str = [
    "SUPPORT",
    "OPPOSE",
    "CONDITIONAL",
    "INVESTIGATE",
    "NOT_APPLICABLE",
    "INSUFFICIENT_EVIDENCE",
];

/// Five verdict sources. The source records how much compute was consumed.
pub const VS_DETERMINISTIC : u8 = 0;
pub const VS_CACHED        : u8 = 1;
pub const VS_FREE_MODEL    : u8 = 2;
pub const VS_OWNER_AGENT   : u8 = 3;
pub const VS_DELEGATED     : u8 = 4;
pub const VS_COUNT         : u8 = 5;

pub const VS_TEXT : [5]str = [
    "DETERMINISTIC",
    "CACHED",
    "FREE_MODEL",
    "OWNER_AGENT",
    "DELEGATED",
];

/// Compute needs declared by a verdict: what it claims was or will be needed.
pub const CN_NONE           : u8 = 0;
pub const CN_LOCAL_CPU      : u8 = 1;
pub const CN_LOCAL_GPU      : u8 = 2;
pub const CN_DISTRIBUTED    : u8 = 3;
pub const CN_EXTERNAL_MODEL : u8 = 4;
pub const CN_COUNT          : u8 = 5;

/// Evidence quality. DISPUTED does not block synthesis; it is preserved as dissent.
pub const EQ_VERIFIED   : u8 = 0;
pub const EQ_UNVERIFIED : u8 = 1;
pub const EQ_DISPUTED   : u8 = 2;
pub const EQ_COUNT      : u8 = 3;

/// Verdict id prefix.
pub const VERDICT_ID_PREFIX : str = "vrd_";

/// A verdict is actionable when it is not NOT_APPLICABLE and not INSUFFICIENT_EVIDENCE.
pub fn is_actionable(vt: u8) -> bool {
    if (vt == VT_NOT_APPLICABLE)        { return false; }
    if (vt == VT_INSUFFICIENT_EVIDENCE) { return false; }
    return true;
}

/// A free source: produced without paid model calls.
pub fn is_free_source(vs: u8) -> bool {
    if (vs == VS_DETERMINISTIC) { return true; }
    if (vs == VS_CACHED)        { return true; }
    if (vs == VS_FREE_MODEL)    { return true; }
    return false;
}

/// A paid source: requires a paid or owner-approved model call.
pub fn is_paid_source(vs: u8) -> bool {
    if (vs == VS_OWNER_AGENT) { return true; }
    if (vs == VS_DELEGATED)   { return true; }
    return false;
}

test domain_codes_stable {
    assert D_T27A    == 0;
    assert D_T27Z    == 25;
    assert D_T27HASH == 26;
    assert DOMAIN_COUNT == 27;
}

test domain_range_covers_all_letters {
    // 26 letters A-Z plus the cross-cutting kernel T27# = 27
    assert D_T27Z - D_T27A + 2 == DOMAIN_COUNT;
}

test verdict_types_stable {
    assert VT_SUPPORT               == 0;
    assert VT_OPPOSE                == 1;
    assert VT_CONDITIONAL           == 2;
    assert VT_INVESTIGATE           == 3;
    assert VT_NOT_APPLICABLE        == 4;
    assert VT_INSUFFICIENT_EVIDENCE == 5;
    assert VT_COUNT                 == 6;
    assert VT_TEXT[VT_NOT_APPLICABLE]        == "NOT_APPLICABLE";
    assert VT_TEXT[VT_INSUFFICIENT_EVIDENCE] == "INSUFFICIENT_EVIDENCE";
}

test verdict_sources_stable {
    assert VS_DETERMINISTIC == 0;
    assert VS_CACHED        == 1;
    assert VS_FREE_MODEL    == 2;
    assert VS_OWNER_AGENT   == 3;
    assert VS_DELEGATED     == 4;
    assert VS_COUNT         == 5;
    assert VS_TEXT[VS_DETERMINISTIC] == "DETERMINISTIC";
    assert VS_TEXT[VS_DELEGATED]     == "DELEGATED";
}

test not_applicable_is_a_full_verdict_not_an_error {
    assert is_actionable(VT_SUPPORT);
    assert is_actionable(VT_OPPOSE);
    assert is_actionable(VT_CONDITIONAL);
    assert is_actionable(VT_INVESTIGATE);
    assert is_actionable(VT_NOT_APPLICABLE)        == false;
    assert is_actionable(VT_INSUFFICIENT_EVIDENCE) == false;
}

test free_and_paid_sources_are_disjoint {
    assert is_free_source(VS_DETERMINISTIC);
    assert is_free_source(VS_CACHED);
    assert is_free_source(VS_FREE_MODEL);
    assert is_free_source(VS_OWNER_AGENT) == false;
    assert is_free_source(VS_DELEGATED)   == false;
    assert is_paid_source(VS_OWNER_AGENT);
    assert is_paid_source(VS_DELEGATED);
    assert is_paid_source(VS_FREE_MODEL)    == false;
    assert is_paid_source(VS_DETERMINISTIC) == false;
}

invariant domain_count_is_27 {
    assert DOMAIN_COUNT == 27;
}

invariant verdict_types_cover_all_six {
    assert VT_COUNT == 6;
}

invariant verdict_sources_cover_all_five {
    assert VS_COUNT == 5;
}
