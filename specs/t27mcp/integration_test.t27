// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/integration_test.t27 -- Integration test: Tier 1 handler contracts fit together
; Verifies:
;   (1) T27L event kind ladder is ordered and non-overlapping (10 -> 11 -> 12 -> 13)
;   (2) Tier 1 tool indices map to the correct pipeline stages in server.t27
;   (3) Chain link LK_REQUEST_TO_DECOMPOSITION is reachable by the Tier 1 flow
;   (4) Automation status layer count matches the number of Tier 1 handler tiers
;   (5) Metric fields cover the 5 measurable dimensions of the minimum closed loop
;   (6) RSI is not signalled until NEW-task evidence exists (EL_SIGNAL threshold)
; Uses existing components only. No new handler specs.
; Wave 2 of ORDER: T27_MCP_RUNTIME_INTEGRATION_V1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpIntegrationTest;

/// T27L event kind ladder: Tier 1 events, mirroring the handler specs.
/// Must stay in sync with handler_create_request.t27, handler_decompose_request.t27,
/// handler_get_automation_status.t27, and handler_runtime_test.t27.
pub const TEK_REQUEST_CREATED       : u8 = 10;
pub const TEK_REQUEST_DECOMPOSED    : u8 = 11;
pub const TEK_STATUS_QUERIED        : u8 = 12;
pub const TEK_RUNTIME_TEST_COMPLETE : u8 = 13;
pub const TEK_TIER1_COUNT           : u8 = 4;

/// Tier 1 tool indices from server.t27 TOOL_STAGE.
pub const TI_CREATE_REQUEST    : u32 = 0;
pub const TI_DECOMPOSE_REQUEST : u32 = 1;
pub const TI_GET_AUTO_STATUS   : u32 = 16;

/// Layer presence count matching LP_COUNT in handler_get_automation_status.t27.
pub const LAYER_COUNT : u8 = 3;

/// Integration test outcomes.
pub const IT_PASS    : u8 = 0;
pub const IT_BLOCKED : u8 = 1;
pub const IT_FAIL    : u8 = 2;
pub const IT_COUNT   : u8 = 3;

pub const IT_TEXT : [3]str = ["PASS", "BLOCKED", "FAIL"];

/// Chain link index for request->decomposition from chain_link.t27 (LK_REQUEST_TO_DECOMPOSITION).
pub const TIER1_COVERED_LINK : u8 = 8;

/// Total chain link count from chain_link.t27 (LK_COUNT).
pub const CHAIN_LINK_COUNT : u8 = 9;

/// Metric field count from chain_metrics.t27 (MF_COUNT).
pub const METRIC_FIELD_COUNT : u8 = 5;

/// Evidence levels mirrored from chain_metrics.t27 for RSI threshold checks.
pub const EL_NONE        : u8 = 0;
pub const EL_ANECDOTAL   : u8 = 1;
pub const EL_PRELIMINARY : u8 = 2;
pub const EL_SIGNAL      : u8 = 3;
pub const EL_CONFIRMED   : u8 = 4;

/// Returns true when two adjacent T27L event kinds are strictly monotone (no gaps).
pub fn tek_ladder_monotone(a: u8, b: u8) -> bool {
    return b == a + 1;
}

/// Returns true when all three Tier 1 tool indices are within the server dispatch range.
pub fn tier1_tools_dispatchable() -> bool {
    if (TI_CREATE_REQUEST    >= 17) { return false; }
    if (TI_DECOMPOSE_REQUEST >= 17) { return false; }
    if (TI_GET_AUTO_STATUS   >= 17) { return false; }
    return true;
}

/// Returns true when layer_count matches the automation handler's LP_COUNT.
pub fn layer_count_matches(lp_count: u8) -> bool {
    return lp_count == LAYER_COUNT;
}

/// Returns true when the chain link index for request->decomposition is in range.
pub fn covered_link_in_range() -> bool {
    return TIER1_COVERED_LINK < CHAIN_LINK_COUNT;
}

test tek_ladder_is_ordered {
    assert TEK_REQUEST_CREATED       == 10;
    assert TEK_REQUEST_DECOMPOSED    == 11;
    assert TEK_STATUS_QUERIED        == 12;
    assert TEK_RUNTIME_TEST_COMPLETE == 13;
    assert tek_ladder_monotone(TEK_REQUEST_CREATED,    TEK_REQUEST_DECOMPOSED);
    assert tek_ladder_monotone(TEK_REQUEST_DECOMPOSED, TEK_STATUS_QUERIED);
    assert tek_ladder_monotone(TEK_STATUS_QUERIED,     TEK_RUNTIME_TEST_COMPLETE);
}

test tek_tier1_window_is_exactly_four {
    assert TEK_REQUEST_CREATED >= 10;
    assert TEK_TIER1_COUNT == 4;
    assert TEK_REQUEST_CREATED + TEK_TIER1_COUNT - 1 == TEK_RUNTIME_TEST_COMPLETE;
}

test tier1_tools_are_in_dispatch_range {
    assert tier1_tools_dispatchable();
    assert TI_CREATE_REQUEST    == 0;
    assert TI_DECOMPOSE_REQUEST == 1;
    assert TI_GET_AUTO_STATUS   == 16;
}

test automation_status_layer_count_matches_handler_spec {
    assert layer_count_matches(3);
    assert LAYER_COUNT == 3;
}

test chain_link_coverage_for_tier1_flow {
    assert covered_link_in_range();
    assert TIER1_COVERED_LINK == 8;
    assert CHAIN_LINK_COUNT   == 9;
}

test metric_fields_match_chain_metrics_spec {
    assert METRIC_FIELD_COUNT == 5;
}

test rsi_signal_requires_new_tasks {
    assert EL_SIGNAL > EL_PRELIMINARY;
    assert EL_CONFIRMED > EL_SIGNAL;
    assert EL_PRELIMINARY < EL_SIGNAL;
    assert EL_NONE < EL_ANECDOTAL;
}

test integration_outcome_codes_stable {
    assert IT_PASS    == 0;
    assert IT_BLOCKED == 1;
    assert IT_FAIL    == 2;
    assert IT_COUNT   == 3;
    assert IT_TEXT[IT_PASS]    == "PASS";
    assert IT_TEXT[IT_BLOCKED] == "BLOCKED";
    assert IT_TEXT[IT_FAIL]    == "FAIL";
}

invariant tek_tier1_starts_at_10 {
    assert TEK_REQUEST_CREATED == 10;
}

invariant tek_tier1_count {
    assert TEK_TIER1_COUNT == 4;
}

invariant tier1_tools_always_dispatchable {
    assert tier1_tools_dispatchable();
}

invariant layer_count_is_three {
    assert LAYER_COUNT == 3;
}

invariant request_to_decomposition_link_exists {
    assert covered_link_in_range();
}

invariant evidence_level_ordering {
    assert EL_NONE < EL_ANECDOTAL;
    assert EL_ANECDOTAL < EL_PRELIMINARY;
    assert EL_PRELIMINARY < EL_SIGNAL;
    assert EL_SIGNAL < EL_CONFIRMED;
}
