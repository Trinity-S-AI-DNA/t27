// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/chain_metrics.t27 -- metrics schema for Wave D minimum closed loop measurement
; The chain is closed when memory feedback improves the NEXT cycle. RSI is real only when the
; improved system performs better on NEW tasks at equal or lower budget. "Agent said it improved"
; is EL_ANECDOTAL. Measured improvement on new held-out tasks is EL_SIGNAL.
; Wave C / Wave D of ORDER: T27_GOLDEN_CHAIN_CLOSE_LOOP_V1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpChainMetrics;

/// Metric fields measured per task batch.
pub const MF_FAILURE_RATE       : u8 = 0;
pub const MF_RETRIES            : u8 = 1;
pub const MF_TIME_SECONDS       : u8 = 2;
pub const MF_COST_TOKENS        : u8 = 3;
pub const MF_FIRST_PASS_SUCCESS : u8 = 4;
pub const MF_COUNT              : u8 = 5;

pub const MF_TEXT : [5]str = [
    "failure_rate",
    "retries",
    "time_seconds",
    "cost_tokens",
    "first_pass_success",
];

/// RSI evidence levels. Strictly ordered: each level requires the previous.
pub const EL_NONE        : u8 = 0;  // no measurement taken
pub const EL_ANECDOTAL   : u8 = 1;  // one case; agent self-report only
pub const EL_PRELIMINARY : u8 = 2;  // improvement on old/known tasks (not sufficient)
pub const EL_SIGNAL      : u8 = 3;  // improvement on NEW tasks at equal or lower budget
pub const EL_CONFIRMED   : u8 = 4;  // reproducible across multiple new batches
pub const EL_COUNT       : u8 = 5;

pub const EL_TEXT : [5]str = [
    "NONE",
    "ANECDOTAL",
    "PRELIMINARY",
    "SIGNAL",
    "CONFIRMED",
];

/// RSI is real only at EL_SIGNAL or above (new tasks, equal/lower budget).
pub fn is_rsi_signal(level: u8) -> bool {
    if (level == EL_SIGNAL)    { return true; }
    if (level == EL_CONFIRMED) { return true; }
    return false;
}

/// An improvement that only worked on the case it was designed for is not generalizing.
/// A result generalizes when the evidence level is SIGNAL or CONFIRMED (same threshold as is_rsi_signal).
pub fn is_generalizing(level: u8) -> bool {
    return is_rsi_signal(level);
}

/// Named recurring defect classes (Wave D baseline subjects).
pub const DC_DISCARD_RETURN : u8 = 0;  // _ = f() in test: vacuous pass T730
pub const DC_CONST_FN_CALL  : u8 = 1;  // fn call in const array: passes t27c, fails t27b
pub const DC_UNDEFINED_NAME : u8 = 2;  // unimported fn passes t27_check, blocks spec-guards
pub const DC_COUNT          : u8 = 3;

pub const DC_TEXT : [3]str = [
    "discard_return_in_test",
    "fn_call_in_const_array",
    "undefined_name_passes_check",
];

/// Bounded improvement kinds for Wave D proposals.
pub const IK_REGRESSION_TEST : u8 = 0;
pub const IK_GUARD           : u8 = 1;
pub const IK_REUSABLE_SKILL  : u8 = 2;
pub const IK_TRIAGE_RULE     : u8 = 3;
pub const IK_COUNT           : u8 = 4;

pub const IK_TEXT : [4]str = [
    "regression_test",
    "guard",
    "reusable_skill",
    "triage_rule",
];

/// Batch comparison verdict after running held-out tasks.
pub const BC_BETTER  : u8 = 0;
pub const BC_SAME    : u8 = 1;
pub const BC_WORSE   : u8 = 2;
pub const BC_UNKNOWN : u8 = 3;
pub const BC_COUNT   : u8 = 4;

pub const BC_TEXT : [4]str = ["BETTER", "SAME", "WORSE", "UNKNOWN"];

test metric_field_codes_stable {
    assert MF_FAILURE_RATE       == 0;
    assert MF_RETRIES            == 1;
    assert MF_TIME_SECONDS       == 2;
    assert MF_COST_TOKENS        == 3;
    assert MF_FIRST_PASS_SUCCESS == 4;
    assert MF_COUNT              == 5;
}

test rsi_evidence_levels_stable {
    assert EL_NONE        == 0;
    assert EL_ANECDOTAL   == 1;
    assert EL_PRELIMINARY == 2;
    assert EL_SIGNAL      == 3;
    assert EL_CONFIRMED   == 4;
    assert EL_COUNT       == 5;
    assert EL_TEXT[EL_SIGNAL]      == "SIGNAL";
    assert EL_TEXT[EL_PRELIMINARY] == "PRELIMINARY";
    assert EL_TEXT[EL_ANECDOTAL]   == "ANECDOTAL";
}

test rsi_signal_threshold {
    assert is_rsi_signal(EL_SIGNAL);
    assert is_rsi_signal(EL_CONFIRMED);
    assert is_rsi_signal(EL_NONE)        == false;
    assert is_rsi_signal(EL_ANECDOTAL)   == false;
    assert is_rsi_signal(EL_PRELIMINARY) == false;
}

test agent_self_report_is_anecdotal_not_rsi {
    assert is_rsi_signal(EL_ANECDOTAL)   == false;
    assert is_generalizing(EL_ANECDOTAL) == false;
    assert is_generalizing(EL_PRELIMINARY) == false;
    assert is_generalizing(EL_SIGNAL);
}

test defect_class_codes_stable {
    assert DC_DISCARD_RETURN == 0;
    assert DC_CONST_FN_CALL  == 1;
    assert DC_UNDEFINED_NAME == 2;
    assert DC_COUNT          == 3;
    assert DC_TEXT[DC_DISCARD_RETURN] == "discard_return_in_test";
    assert DC_TEXT[DC_UNDEFINED_NAME] == "undefined_name_passes_check";
}

test improvement_kind_codes_stable {
    assert IK_REGRESSION_TEST == 0;
    assert IK_GUARD           == 1;
    assert IK_REUSABLE_SKILL  == 2;
    assert IK_TRIAGE_RULE     == 3;
    assert IK_COUNT           == 4;
}

invariant rsi_signal_requires_new_tasks {
    assert is_rsi_signal(EL_PRELIMINARY) == false;
    assert is_rsi_signal(EL_SIGNAL);
}

invariant defect_class_count {
    assert DC_COUNT == 3;
}

invariant improvement_kind_count {
    assert IK_COUNT == 4;
}
