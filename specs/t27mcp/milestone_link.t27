// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/milestone_link.t27 -- milestone chain record schema
; A milestone becomes part of the Golden Chain only when it carries a request_id,
; chain_id, and memory_record_id traceable to a closed execution loop.
; Wave 1 audit (2026-11-10): 2 milestones found, 0 linked to chain.
; Closes #13569 | phi^2 + 1/phi^2 = 3 | TRINITY

module MilestoneLink;

; Field indices for a MilestoneChainRecord (stored as parallel arrays).
pub const MCR_MILESTONE_NUMBER : u8 = 0;
pub const MCR_REQUEST_ID       : u8 = 1;
pub const MCR_CHAIN_ID         : u8 = 2;
pub const MCR_MEMORY_RECORD_ID : u8 = 3;
pub const MCR_FIELD_COUNT      : u8 = 4;

; Chain link status codes.
pub const CLS_UNLINKED  : u8 = 0;
pub const CLS_PARTIAL   : u8 = 1;
pub const CLS_COMPLETE  : u8 = 2;
pub const CLS_COUNT     : u8 = 3;

; Milestone numbers from Wave 1 audit (gHashTag/t27).
pub const MS_EPOCH01_HARDEN  : u8 = 1;
pub const MS_PHASE3_SCIENCE  : u8 = 2;
pub const MS_T27MCP_RUNTIME  : u8 = 3;

; Issue count for MS_T27MCP_RUNTIME (Waves BC, D, E, 2 -- four issues total).
pub const MS3_ISSUE_COUNT : u8 = 4;

; A chain record is complete when milestone is nonzero, has_chain_id is true,
; and at least one issue is linked.
pub fn chain_record_complete(ms: u8, has_chain_id: bool, issue_count: u8) -> bool {
    if (ms == 0) { return false; }
    if (has_chain_id == false) { return false; }
    if (issue_count == 0) { return false; }
    return true;
}

test field_indices_stable {
    assert MCR_MILESTONE_NUMBER == 0;
    assert MCR_REQUEST_ID       == 1;
    assert MCR_CHAIN_ID         == 2;
    assert MCR_MEMORY_RECORD_ID == 3;
    assert MCR_FIELD_COUNT      == 4;
}

test chain_link_status_codes_stable {
    assert CLS_UNLINKED == 0;
    assert CLS_PARTIAL  == 1;
    assert CLS_COMPLETE == 2;
    assert CLS_COUNT    == 3;
}

test audit_milestone_numbers_stable {
    assert MS_EPOCH01_HARDEN == 1;
    assert MS_PHASE3_SCIENCE == 2;
    assert MS_T27MCP_RUNTIME == 3;
}

test t27mcp_runtime_issue_count {
    assert MS3_ISSUE_COUNT == 4;
}

test chain_record_complete_accepts_valid {
    assert chain_record_complete(MS_T27MCP_RUNTIME, true, MS3_ISSUE_COUNT);
}

test chain_record_complete_rejects_zero_ms {
    assert chain_record_complete(0, true, 1) == false;
}

test chain_record_complete_rejects_missing_chain_id {
    assert chain_record_complete(1, false, 1) == false;
}

test chain_record_complete_rejects_no_issues {
    assert chain_record_complete(1, true, 0) == false;
}

invariant field_count_nonzero {
    assert MCR_FIELD_COUNT > 0;
}

invariant audit_found_two_milestones {
    assert MS_EPOCH01_HARDEN == 1;
    assert MS_PHASE3_SCIENCE == 2;
}
