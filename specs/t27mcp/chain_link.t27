// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/chain_link.t27 -- machine-checkable link schema for the Golden Chain
; A chain is closed when every pipeline stage has a verified link to the next.
; Without this the pipeline produces artifacts but cannot prove, replay or improve from them.
; Wave C of ORDER: T27_GOLDEN_CHAIN_CLOSE_LOOP_V1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpChainLink;

/// The 9 required machine-checkable connections. Order is stable; a kind never moves.
pub const LK_ARTIFACT_TO_SPEC         : u8 = 0;
pub const LK_SPEC_TO_OWNER            : u8 = 1;
pub const LK_OWNER_TO_CAPABILITY      : u8 = 2;
pub const LK_VERDICT_TO_EVIDENCE      : u8 = 3;
pub const LK_TEST_TO_BASELINE         : u8 = 4;
pub const LK_EXECUTION_TO_SCOPE       : u8 = 5;
pub const LK_VERIFICATION_TO_CHECKER  : u8 = 6;
pub const LK_MEMORY_TO_ARTIFACT       : u8 = 7;
pub const LK_REQUEST_TO_DECOMPOSITION : u8 = 8;
pub const LK_COUNT                    : u8 = 9;

pub const LK_TEXT : [9]str = [
    "artifact_to_spec",
    "spec_to_owner",
    "owner_to_capability",
    "verdict_to_evidence",
    "test_to_baseline",
    "execution_to_scope",
    "verification_to_checker",
    "memory_to_artifact",
    "request_to_decomposition",
];

/// Link statuses.
pub const LS_VALID   : u8 = 0;
pub const LS_ORPHAN  : u8 = 1;
pub const LS_BROKEN  : u8 = 2;
pub const LS_PENDING : u8 = 3;
pub const LS_COUNT   : u8 = 4;

pub const LS_TEXT : [4]str = ["VALID", "ORPHAN", "BROKEN", "PENDING"];

/// Link id prefix.
pub const LINK_ID_PREFIX : str = "lnk_";

/// A chain is closed when ALL 9 links are VALID.
pub fn is_closed(status: u8) -> bool {
    return status == LS_VALID;
}

/// A broken link (ORPHAN or BROKEN) must be repaired before the chain is accepted.
pub fn is_broken(status: u8) -> bool {
    if (status == LS_ORPHAN) { return true; }
    if (status == LS_BROKEN) { return true; }
    return false;
}

test link_kind_codes_stable {
    assert LK_ARTIFACT_TO_SPEC         == 0;
    assert LK_SPEC_TO_OWNER            == 1;
    assert LK_OWNER_TO_CAPABILITY      == 2;
    assert LK_VERDICT_TO_EVIDENCE      == 3;
    assert LK_TEST_TO_BASELINE         == 4;
    assert LK_EXECUTION_TO_SCOPE       == 5;
    assert LK_VERIFICATION_TO_CHECKER  == 6;
    assert LK_MEMORY_TO_ARTIFACT       == 7;
    assert LK_REQUEST_TO_DECOMPOSITION == 8;
    assert LK_COUNT                    == 9;
}

test link_status_codes_stable {
    assert LS_VALID   == 0;
    assert LS_ORPHAN  == 1;
    assert LS_BROKEN  == 2;
    assert LS_PENDING == 3;
    assert LS_COUNT   == 4;
    assert LS_TEXT[LS_VALID]  == "VALID";
    assert LS_TEXT[LS_ORPHAN] == "ORPHAN";
}

test closed_and_broken_are_disjoint {
    assert is_closed(LS_VALID);
    assert is_closed(LS_ORPHAN)  == false;
    assert is_closed(LS_BROKEN)  == false;
    assert is_closed(LS_PENDING) == false;
    assert is_broken(LS_ORPHAN);
    assert is_broken(LS_BROKEN);
    assert is_broken(LS_VALID)   == false;
    assert is_broken(LS_PENDING) == false;
}

test link_text_covers_all {
    assert LK_TEXT[LK_ARTIFACT_TO_SPEC]        == "artifact_to_spec";
    assert LK_TEXT[LK_MEMORY_TO_ARTIFACT]      == "memory_to_artifact";
    assert LK_TEXT[LK_REQUEST_TO_DECOMPOSITION] == "request_to_decomposition";
}

invariant link_kind_count {
    assert LK_COUNT == 9;
}

invariant link_status_count {
    assert LS_COUNT == 4;
}
