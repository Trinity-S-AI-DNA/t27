// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/chain_integrity.t27 -- 12 required integrity checks for a closed Golden Chain
; All 12 checks must pass before a chain is accepted. SKIPPED does not pass. The hardest check,
; IC_NO_UNVERIFIED_FACT, blocks any chain where an agent's self-report is the only evidence.
; Wave C of ORDER: T27_GOLDEN_CHAIN_CLOSE_LOOP_V1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpChainIntegrity;

/// The 12 required integrity checks. Order is stable; a check never moves.
pub const IC_ARTIFACT_HAS_PROVENANCE  : u8 = 0;
pub const IC_PROVENANCE_LINKS_TO_SPEC : u8 = 1;
pub const IC_SPEC_HAS_OWNER           : u8 = 2;
pub const IC_OWNER_HAS_CAPABILITY     : u8 = 3;
pub const IC_VERDICT_HAS_EVIDENCE     : u8 = 4;
pub const IC_TEST_HAS_BASELINE        : u8 = 5;
pub const IC_EXECUTION_HAS_SCOPE      : u8 = 6;
pub const IC_VERIFICATION_HAS_CHECKER : u8 = 7;
pub const IC_MEMORY_HAS_ARTIFACT      : u8 = 8;
pub const IC_NO_ORPHAN_LINKS          : u8 = 9;
pub const IC_NO_SILENT_TASK_LOSS      : u8 = 10;
pub const IC_NO_UNVERIFIED_FACT       : u8 = 11;
pub const IC_COUNT                    : u8 = 12;

pub const IC_TEXT : [12]str = [
    "artifact_has_provenance",
    "provenance_links_to_spec",
    "spec_has_owner",
    "owner_has_capability",
    "verdict_has_evidence",
    "test_has_baseline",
    "execution_has_scope",
    "verification_has_checker",
    "memory_has_artifact",
    "no_orphan_links",
    "no_silent_task_loss",
    "no_unverified_fact",
];

/// Check result. SKIPPED is not PASS.
pub const CR_PASS    : u8 = 0;
pub const CR_FAIL    : u8 = 1;
pub const CR_PENDING : u8 = 2;
pub const CR_SKIPPED : u8 = 3;
pub const CR_COUNT   : u8 = 4;

pub const CR_TEXT : [4]str = ["PASS", "FAIL", "PENDING", "SKIPPED"];

pub const CHECK_ID_PREFIX : str = "chk_";

/// A check passes only when it is PASS, not when it is SKIPPED.
pub fn check_passes(result: u8) -> bool {
    return result == CR_PASS;
}

/// IC_NO_UNVERIFIED_FACT is the terminal check: agent self-report is never sufficient.
pub const HARDEST_CHECK : u8 = IC_NO_UNVERIFIED_FACT;

test integrity_check_codes_stable {
    assert IC_ARTIFACT_HAS_PROVENANCE  == 0;
    assert IC_PROVENANCE_LINKS_TO_SPEC == 1;
    assert IC_SPEC_HAS_OWNER           == 2;
    assert IC_OWNER_HAS_CAPABILITY     == 3;
    assert IC_VERDICT_HAS_EVIDENCE     == 4;
    assert IC_TEST_HAS_BASELINE        == 5;
    assert IC_EXECUTION_HAS_SCOPE      == 6;
    assert IC_VERIFICATION_HAS_CHECKER == 7;
    assert IC_MEMORY_HAS_ARTIFACT      == 8;
    assert IC_NO_ORPHAN_LINKS          == 9;
    assert IC_NO_SILENT_TASK_LOSS      == 10;
    assert IC_NO_UNVERIFIED_FACT       == 11;
    assert IC_COUNT                    == 12;
}

test check_result_codes_stable {
    assert CR_PASS    == 0;
    assert CR_FAIL    == 1;
    assert CR_PENDING == 2;
    assert CR_SKIPPED == 3;
    assert CR_COUNT   == 4;
    assert CR_TEXT[CR_PASS]    == "PASS";
    assert CR_TEXT[CR_SKIPPED] == "SKIPPED";
}

test skipped_does_not_pass {
    assert check_passes(CR_PASS);
    assert check_passes(CR_FAIL)    == false;
    assert check_passes(CR_PENDING) == false;
    assert check_passes(CR_SKIPPED) == false;
}

test hardest_check_is_no_unverified_fact {
    assert HARDEST_CHECK == IC_NO_UNVERIFIED_FACT;
    assert HARDEST_CHECK == IC_COUNT - 1;
}

test text_covers_boundary_cases {
    assert IC_TEXT[IC_ARTIFACT_HAS_PROVENANCE] == "artifact_has_provenance";
    assert IC_TEXT[IC_NO_UNVERIFIED_FACT]      == "no_unverified_fact";
    assert IC_TEXT[IC_NO_SILENT_TASK_LOSS]     == "no_silent_task_loss";
    assert IC_TEXT[IC_MEMORY_HAS_ARTIFACT]     == "memory_has_artifact";
}

invariant integrity_check_count {
    assert IC_COUNT == 12;
}

invariant check_result_count {
    assert CR_COUNT == 4;
}
