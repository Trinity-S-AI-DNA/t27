// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/t27l_events.t27 -- canonical T27L event type constants for the t27 MCP runtime
;
; Design rule: T27L is a control plane, not a telemetry dump.
; An event type is core when it proves a property of the FIRST runtime slice:
;   request lifecycle, persistence, rejection, retry deduplication.
; An event type is chain when it proves artifact production, memory feedback, or Golden Chain closure.
; Chain events are added only after the core set is proven in practice.
;
; Backward-compatible: existing handler specs pin TEK_REQUEST_CREATED=10,
; TEK_REQUEST_DECOMPOSED=11, TEK_STATUS_QUERIED=12, TEK_RUNTIME_TEST_COMPLETE=13 --
; those values are locked here.
;
; Acceptance contract for #13571 (gen-rs --mcp-stdio). The spec is the ACCEPTANCE TEST:
; a generated binary that handles all core events proves gen-rs --mcp-stdio works.
; Refs #13571 | phi^2 + 1/phi^2 = 3 | TRINITY

module T27lEvents;

; ─── CORE EVENT TYPES (required for the first closed runtime) ─────────────────

pub const TEK_REQUEST_CREATED     : u8 = 10;  ; request object created and validated by schema
pub const TEK_REQUEST_VALIDATED   : u8 = 14;  ; input fields checked; tool call accepted
pub const TEK_REQUEST_DECOMPOSED  : u8 = 11;  ; tasks produced and linked to request_id
pub const TEK_STATUS_QUERIED      : u8 = 12;  ; automation status read from persisted state
pub const TEK_STATE_PERSISTED     : u8 = 15;  ; cell sealed and written to .trinity/
pub const TEK_STATE_READ_BACK     : u8 = 16;  ; state read by a fresh process (restart proof)
pub const TEK_TOOL_CALL_REJECTED  : u8 = 17;  ; tool call rejected (type error or duplicate)
pub const TEK_RETRY_ATTEMPTED     : u8 = 18;  ; same call retried after transient failure
pub const TEK_RETRY_DEDUPLICATED  : u8 = 19;  ; retry recognized as duplicate; no new work done
pub const TEK_CORE_COUNT          : u8 = 9;

; ─── CHAIN EVENT TYPES (added after core is proven) ──────────────────────────

pub const TEK_ARTIFACT_PRODUCED      : u8 = 20;  ; request produced a verifiable artifact
pub const TEK_ARTIFACT_VERIFIED      : u8 = 21;  ; artifact passes acceptance criteria
pub const TEK_MEMORY_RECORD_CREATED  : u8 = 22;  ; learning recorded in .trinity/ for next cycle
pub const TEK_MEMORY_REUSED          : u8 = 23;  ; next-cycle request benefited from prior memory
pub const TEK_CHAIN_LINKED           : u8 = 24;  ; milestone linked to request_id + chain_id
pub const TEK_CHAIN_SEALED           : u8 = 25;  ; SHA-256 seal written over all chain links
pub const TEK_CHAIN_COUNT            : u8 = 6;

; ─── LEGACY (locked, do not reorder) ─────────────────────────────────────────

pub const TEK_RUNTIME_TEST_COMPLETE  : u8 = 13;  ; Wave B runtime test passed (Tier 1)

; ─── CLASSIFIER FUNCTIONS ─────────────────────────────────────────────────────

; Returns true for the 9 event types required in the first runtime slice.
pub fn is_core_event(tek: u8) -> bool {
    if (tek == TEK_REQUEST_CREATED)    { return true; }
    if (tek == TEK_REQUEST_VALIDATED)  { return true; }
    if (tek == TEK_REQUEST_DECOMPOSED) { return true; }
    if (tek == TEK_STATUS_QUERIED)     { return true; }
    if (tek == TEK_STATE_PERSISTED)    { return true; }
    if (tek == TEK_STATE_READ_BACK)    { return true; }
    if (tek == TEK_TOOL_CALL_REJECTED) { return true; }
    if (tek == TEK_RETRY_ATTEMPTED)    { return true; }
    if (tek == TEK_RETRY_DEDUPLICATED) { return true; }
    return false;
}

; Returns true for the 6 Golden Chain event types (artifact + memory + chain).
pub fn is_chain_event(tek: u8) -> bool {
    if (tek == TEK_ARTIFACT_PRODUCED)     { return true; }
    if (tek == TEK_ARTIFACT_VERIFIED)     { return true; }
    if (tek == TEK_MEMORY_RECORD_CREATED) { return true; }
    if (tek == TEK_MEMORY_REUSED)         { return true; }
    if (tek == TEK_CHAIN_LINKED)          { return true; }
    if (tek == TEK_CHAIN_SEALED)          { return true; }
    return false;
}

; A core event is NOT a chain event and vice versa. The sets are disjoint.
pub fn is_disjoint(tek: u8) -> bool {
    if (is_core_event(tek) == false) { return true; }
    if (is_chain_event(tek)) { return false; }
    return true;
}

test core_event_ids_stable {
    assert TEK_REQUEST_CREATED     == 10;
    assert TEK_REQUEST_VALIDATED   == 14;
    assert TEK_REQUEST_DECOMPOSED  == 11;
    assert TEK_STATUS_QUERIED      == 12;
    assert TEK_STATE_PERSISTED     == 15;
    assert TEK_STATE_READ_BACK     == 16;
    assert TEK_TOOL_CALL_REJECTED  == 17;
    assert TEK_RETRY_ATTEMPTED     == 18;
    assert TEK_RETRY_DEDUPLICATED  == 19;
    assert TEK_CORE_COUNT          == 9;
}

test chain_event_ids_stable {
    assert TEK_ARTIFACT_PRODUCED     == 20;
    assert TEK_ARTIFACT_VERIFIED     == 21;
    assert TEK_MEMORY_RECORD_CREATED == 22;
    assert TEK_MEMORY_REUSED         == 23;
    assert TEK_CHAIN_LINKED          == 24;
    assert TEK_CHAIN_SEALED          == 25;
    assert TEK_CHAIN_COUNT           == 6;
}

test legacy_ids_locked {
    assert TEK_RUNTIME_TEST_COMPLETE == 13;
}

test is_core_event_accepts_all_core {
    assert is_core_event(TEK_REQUEST_CREATED);
    assert is_core_event(TEK_REQUEST_VALIDATED);
    assert is_core_event(TEK_REQUEST_DECOMPOSED);
    assert is_core_event(TEK_STATUS_QUERIED);
    assert is_core_event(TEK_STATE_PERSISTED);
    assert is_core_event(TEK_STATE_READ_BACK);
    assert is_core_event(TEK_TOOL_CALL_REJECTED);
    assert is_core_event(TEK_RETRY_ATTEMPTED);
    assert is_core_event(TEK_RETRY_DEDUPLICATED);
}

test is_core_event_rejects_chain {
    assert is_core_event(TEK_ARTIFACT_PRODUCED)     == false;
    assert is_core_event(TEK_CHAIN_SEALED)          == false;
    assert is_core_event(TEK_MEMORY_REUSED)         == false;
}

test is_chain_event_accepts_all_chain {
    assert is_chain_event(TEK_ARTIFACT_PRODUCED);
    assert is_chain_event(TEK_ARTIFACT_VERIFIED);
    assert is_chain_event(TEK_MEMORY_RECORD_CREATED);
    assert is_chain_event(TEK_MEMORY_REUSED);
    assert is_chain_event(TEK_CHAIN_LINKED);
    assert is_chain_event(TEK_CHAIN_SEALED);
}

test is_chain_event_rejects_core {
    assert is_chain_event(TEK_REQUEST_CREATED)    == false;
    assert is_chain_event(TEK_STATE_PERSISTED)    == false;
    assert is_chain_event(TEK_RETRY_DEDUPLICATED) == false;
}

test sets_are_disjoint {
    assert is_disjoint(TEK_REQUEST_CREATED);
    assert is_disjoint(TEK_CHAIN_SEALED);
    assert is_disjoint(TEK_RUNTIME_TEST_COMPLETE);
}

invariant core_count_is_nine {
    assert TEK_CORE_COUNT == 9;
}

invariant chain_count_is_six {
    assert TEK_CHAIN_COUNT == 6;
}

invariant legacy_anchor_locked {
    assert TEK_RUNTIME_TEST_COMPLETE == 13;
}

invariant core_and_chain_do_not_overlap {
    assert is_disjoint(TEK_REQUEST_CREATED);
    assert is_disjoint(TEK_ARTIFACT_PRODUCED);
}
