// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/spec_brief.t27 -- the brief spec row and the "why does it fail" decision of the t27 MCP server
; (gHashTag/t27-mcp). See the epic #10066.
; --
; t27_specs, t27_spec and t27_grep answer with a spec row. The whole manifest record is about 860 bytes (AST node
; kinds, emitted bytes per backend, tags, a summary), and a model that only wants "does it compile, and if not
; why" pays for all of it on every row. This spec holds the two decisions that were JavaScript in the server:
; - BRIEF_FIELDS / ONE_FIELDS: which manifest fields a brief row keeps. The server copies those keys and nothing
;   else; `fields: true` on the tool returns the whole record instead.
; - why_mask(): `health: "fail"` covers unrelated events. A spec that never parsed reports loss 0, tcErrors 0 and
;   no failed backend, not because it is clean but because nothing downstream of the parser ran. why_mask turns
;   the observable counters into a bit set; WHY_TEXT holds one template per bit, `{}` marks the number or list
;   the server fills in. A spec that is not "fail" gets no reasons at all.
; The mask adds no claim of its own: it reads the counters the manifest already records.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27mcpSpecBrief;

pub const BRIEF_FIELDS : [8]str = [
    "path",
    "repo",
    "name",
    "health",
    "lines",
    "loss",
    "tcErrors",
    "failedBackends"
];

/// t27_spec keeps the brief fields and what a reader asks next about one file.
pub const ONE_FIELDS : [14]str = [
    "path",
    "repo",
    "name",
    "health",
    "lines",
    "loss",
    "tcErrors",
    "failedBackends",
    "category",
    "bytes",
    "tokens",
    "nodes",
    "summary",
    "tags"
];

pub const W_NOT_PARSED : u32 = 1;
pub const W_BACKEND : u32 = 2;
pub const W_TYPECHECK : u32 = 4;
pub const W_LOSS : u32 = 8;
pub const W_UNKNOWN : u32 = 16;

/// One template per bit, in bit order. `{}` is the count or the backend list.
pub const WHY_TEXT : [5]str = [
    "not-parsed: the manifest records no AST, so no backend ran",
    "backend: {} returned nothing",
    "typecheck: {} error(s)",
    "round-trip loss: {}",
    "unknown: marked fail with no counter to explain it"
];

/// The reasons a spec fails, as a bit set. `is_fail` is 1 for health "fail"; the rest are the manifest counters
/// (nodes of the AST, number of failed backends, type-check errors, round-trip loss).
pub fn why_mask(is_fail: u32, nodes: u32, nfailed: u32, tc: u32, loss: u32) -> u32 {
    if (is_fail == 0) { return 0; }
    var m : u32 = 0;
    if (nodes == 0) { m = m + W_NOT_PARSED; }
    if (nfailed > 0) { m = m + W_BACKEND; }
    if (tc > 0) { m = m + W_TYPECHECK; }
    if (loss > 0) { m = m + W_LOSS; }
    if (m == 0) { m = W_UNKNOWN; }
    return m;
}

test "why_mask: a spec that is not failing has no reasons" {
    assert why_mask(0, 0, 0, 0, 0) == 0;
    assert why_mask(0, 120, 3, 2, 1) == 0;
}

test "why_mask: a spec that never parsed is not-parsed, not unexplained" {
    assert why_mask(1, 0, 0, 0, 0) == W_NOT_PARSED;
}

test "why_mask: each counter sets its own bit, and bits add" {
    assert why_mask(1, 50, 2, 0, 0) == W_BACKEND;
    assert why_mask(1, 50, 0, 3, 0) == W_TYPECHECK;
    assert why_mask(1, 50, 0, 0, 7) == W_LOSS;
    assert why_mask(1, 50, 1, 2, 0) == W_BACKEND + W_TYPECHECK;
    assert why_mask(1, 0, 1, 0, 1) == W_NOT_PARSED + W_BACKEND + W_LOSS;
}

test "negative control: a fail with no counter is W_UNKNOWN alone, never silent" {
    assert why_mask(1, 50, 0, 0, 0) == W_UNKNOWN;
    assert why_mask(1, 50, 0, 0, 0) != 0;
}

test "why_mask: all four counters at once leave W_UNKNOWN out" {
    assert why_mask(1, 0, 2, 3, 4) == W_NOT_PARSED + W_BACKEND + W_TYPECHECK + W_LOSS;
    assert why_mask(1, 0, 2, 3, 4) < W_UNKNOWN;
}
