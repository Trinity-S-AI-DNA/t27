// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/milestone_metrics.t27 -- coverage and completeness metrics for milestone chain
; Coverage metrics are integer percentages [0, 100].
; Wave 1 baseline (2026-11-10): 2 milestones, 0 chain-linked = 0% all metrics.
; Closes #13569 | phi^2 + 1/phi^2 = 3 | TRINITY

module MilestoneMetrics;

; Metric IDs.
pub const MM_COVERAGE          : u8 = 0;  ; linked_milestones / total_milestones
pub const MM_CHAIN_COMPLETENESS : u8 = 1;  ; milestones_with_all_chain_ids / total
pub const MM_MEMORY_REUSE      : u8 = 2;  ; milestones_with_memory_record_id / total
pub const MM_COUNT             : u8 = 3;

pub const MM_TEXT : [3]str = [
    "milestone_coverage",
    "chain_completeness",
    "memory_reuse",
];

; Coverage as integer percent. Returns 0 when total is 0 (no milestones).
pub fn coverage_pct(linked: u8, total: u8) -> u8 {
    if (total == 0) { return 0; }
    return (linked * 100) / total;
}

; Wave 1 audit baseline (2026-11-10).
pub const BASELINE_TOTAL    : u8 = 2;
pub const BASELINE_LINKED   : u8 = 0;
pub const BASELINE_COVERAGE : u8 = 0;  ; coverage_pct(0, 2) = 0

; Target after Wave 3 (link T27_MCP_RUNTIME_M0).
pub const TARGET_TOTAL    : u8 = 3;  ; add one new milestone
pub const TARGET_LINKED   : u8 = 1;  ; T27_MCP_RUNTIME_M0 linked
pub const TARGET_COVERAGE : u8 = 33; ; coverage_pct(1, 3) = 33

; A milestone set is improving when its coverage is strictly higher than the baseline.
pub fn is_improving(current_pct: u8, baseline_pct: u8) -> bool {
    if (current_pct > baseline_pct) { return true; }
    return false;
}

test metric_ids_stable {
    assert MM_COVERAGE           == 0;
    assert MM_CHAIN_COMPLETENESS == 1;
    assert MM_MEMORY_REUSE       == 2;
    assert MM_COUNT              == 3;
    assert MM_TEXT[MM_COVERAGE]  == "milestone_coverage";
    assert MM_TEXT[MM_MEMORY_REUSE] == "memory_reuse";
}

test coverage_pct_zero_total {
    assert coverage_pct(0, 0) == 0;
}

test coverage_pct_zero_linked {
    assert coverage_pct(0, 2) == 0;
}

test coverage_pct_all_linked {
    assert coverage_pct(2, 2) == 100;
}

test coverage_pct_one_of_three {
    assert coverage_pct(1, 3) == 33;
}

test baseline_is_zero_coverage {
    assert BASELINE_TOTAL  == 2;
    assert BASELINE_LINKED == 0;
    assert coverage_pct(BASELINE_LINKED, BASELINE_TOTAL) == BASELINE_COVERAGE;
    assert BASELINE_COVERAGE == 0;
}

test target_coverage_after_wave3 {
    assert TARGET_TOTAL   == 3;
    assert TARGET_LINKED  == 1;
    assert coverage_pct(TARGET_LINKED, TARGET_TOTAL) == TARGET_COVERAGE;
    assert TARGET_COVERAGE == 33;
}

test wave3_improves_on_baseline {
    assert is_improving(TARGET_COVERAGE, BASELINE_COVERAGE);
}

invariant coverage_range_valid {
    assert coverage_pct(0, 1) == 0;
    assert coverage_pct(1, 1) == 100;
}

invariant metric_count_stable {
    assert MM_COUNT == 3;
}
