// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/handler_get_automation_status.t27 -- Handler spec for the t27_get_automation_status MCP tool
; Returns the current readiness of the t27 MCP automation stack.
; Checks three contract layers: L0 (contract specs), L1 (chain linkage), L2 (schema types).
; Returns GAS_READY only when all three layers are present and consistent.
; Wave E of ORDER: T27_MCP_HANDLER_TIER_1_V1 (gHashTag/t27#13560).
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpHandlerGetAutomationStatus;

/// Automation status codes. Order is stable.
pub const GAS_READY     : u8 = 0;  // all contract layers present and consistent
pub const GAS_NOT_READY : u8 = 1;  // one or more required layers absent
pub const GAS_DEGRADED  : u8 = 2;  // layers present but inconsistent (mismatch or stale seal)
pub const GAS_COUNT     : u8 = 3;

pub const GAS_TEXT : [3]str = [
    "READY",
    "NOT_READY",
    "DEGRADED",
];

/// Contract layer presence codes. Each layer corresponds to one Wave of the t27mcp spec set.
pub const LP_L0_CONTRACT : u8 = 0;  // Wave B: atomic_task, domain_verdict, etc. (10 contract specs)
pub const LP_L1_LINKAGE  : u8 = 1;  // Wave B/C: chain_link, chain_integrity, chain_replay
pub const LP_L2_SCHEMA   : u8 = 2;  // Wave D: server.t27 + e2e_test.t27 (runtime schema)
pub const LP_COUNT       : u8 = 3;

pub const LP_TEXT : [3]str = [
    "L0_CONTRACT",
    "L1_LINKAGE",
    "L2_SCHEMA",
];

/// T27L event kind emitted on each get_automation_status call.
/// The event preserves: status, layer presence bitmask, query timestamp, session provenance.
pub const TEK_STATUS_QUERIED : u8 = 12;

/// Returns true when the automation stack is fully operational.
pub fn is_ready(status: u8) -> bool {
    return status == GAS_READY;
}

/// Returns true when at least one layer is absent (cannot proceed with automation).
pub fn is_not_ready(status: u8) -> bool {
    return status == GAS_NOT_READY;
}

/// Returns true when layers are present but report an inconsistency.
pub fn is_degraded(status: u8) -> bool {
    return status == GAS_DEGRADED;
}

/// Returns true when the status is actionable (not_ready or degraded -- requires intervention).
pub fn needs_intervention(status: u8) -> bool {
    if (status == GAS_NOT_READY) { return true; }
    if (status == GAS_DEGRADED)  { return true; }
    return false;
}

/// Returns true when the layer index is valid.
pub fn layer_valid(layer: u8) -> bool {
    return layer < LP_COUNT;
}

/// A get_automation_status call always writes a T27L event (even when NOT_READY).
/// This ensures status queries are traceable regardless of outcome.
pub fn event_written(status: u8) -> bool {
    return status < GAS_COUNT;
}

test status_codes_stable {
    assert GAS_READY     == 0;
    assert GAS_NOT_READY == 1;
    assert GAS_DEGRADED  == 2;
    assert GAS_COUNT     == 3;
    assert GAS_TEXT[GAS_READY]     == "READY";
    assert GAS_TEXT[GAS_NOT_READY] == "NOT_READY";
    assert GAS_TEXT[GAS_DEGRADED]  == "DEGRADED";
}

test layer_presence_codes_stable {
    assert LP_L0_CONTRACT == 0;
    assert LP_L1_LINKAGE  == 1;
    assert LP_L2_SCHEMA   == 2;
    assert LP_COUNT       == 3;
    assert LP_TEXT[LP_L0_CONTRACT] == "L0_CONTRACT";
    assert LP_TEXT[LP_L1_LINKAGE]  == "L1_LINKAGE";
    assert LP_TEXT[LP_L2_SCHEMA]   == "L2_SCHEMA";
}

test t27l_event_kind_stable {
    assert TEK_STATUS_QUERIED == 12;
}

test ready_means_no_intervention {
    assert is_ready(GAS_READY);
    assert is_ready(GAS_NOT_READY) == false;
    assert is_ready(GAS_DEGRADED)  == false;
    assert needs_intervention(GAS_NOT_READY);
    assert needs_intervention(GAS_DEGRADED);
    assert needs_intervention(GAS_READY) == false;
}

test layer_valid_boundary {
    assert layer_valid(LP_L0_CONTRACT);
    assert layer_valid(LP_L1_LINKAGE);
    assert layer_valid(LP_L2_SCHEMA);
    assert layer_valid(LP_COUNT) == false;
}

test event_written_for_all_valid_statuses {
    assert event_written(GAS_READY);
    assert event_written(GAS_NOT_READY);
    assert event_written(GAS_DEGRADED);
    assert event_written(GAS_COUNT) == false;
}

invariant status_count {
    assert GAS_COUNT == 3;
}

invariant layer_count {
    assert LP_COUNT == 3;
}
