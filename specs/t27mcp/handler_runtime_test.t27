// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/handler_runtime_test.t27 -- Runtime test spec for the t27 MCP handler layer
; Defines a 5-step runtime probe sequence that validates the full handler stack.
; Steps: probe contract layer, probe linkage, probe schema, probe server dispatch, probe E2E flow.
; Outcomes are PASS / BLOCKED / FAIL / PENDING (never silent).
; Wave E of ORDER: T27_MCP_HANDLER_TIER_1_V1 (gHashTag/t27#13560).
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpHandlerRuntimeTest;

/// Runtime test step codes. Order matches execution sequence.
pub const RTS_PROBE_CONTRACT : u8 = 0;  // verify L0 contract specs are accessible
pub const RTS_PROBE_LINKAGE  : u8 = 1;  // verify L1 chain linkage specs are accessible
pub const RTS_PROBE_SCHEMA   : u8 = 2;  // verify L2 runtime schema (server + e2e_test) accessible
pub const RTS_PROBE_SERVER   : u8 = 3;  // verify server dispatch table rejects out-of-range tool_id
pub const RTS_PROBE_E2E      : u8 = 4;  // verify E2E flow outcome codes are stable
pub const RTS_COUNT          : u8 = 5;

pub const RTS_TEXT : [5]str = [
    "PROBE_CONTRACT",
    "PROBE_LINKAGE",
    "PROBE_SCHEMA",
    "PROBE_SERVER",
    "PROBE_E2E",
];

/// Runtime test outcome codes. Shared with e2e_test.t27 convention.
pub const RTO_PASS    : u8 = 0;  // step completed and assertion held
pub const RTO_BLOCKED : u8 = 1;  // step could not proceed (missing spec, quota, etc.)
pub const RTO_FAIL    : u8 = 2;  // step completed but assertion violated
pub const RTO_PENDING : u8 = 3;  // step not yet reached in this run
pub const RTO_COUNT   : u8 = 4;

pub const RTO_TEXT : [4]str = ["PASS", "BLOCKED", "FAIL", "PENDING"];

/// T27L event kind emitted when the runtime test run completes.
/// The event preserves: step count, outcome per step, run timestamp, session provenance.
pub const TEK_RUNTIME_TEST_COMPLETE : u8 = 13;

/// The full runtime test passes only when every step reached RTO_PASS.
pub fn runtime_test_passes(last_step_outcome: u8) -> bool {
    return last_step_outcome == RTO_PASS;
}

/// A run is retryable when any step was blocked (not failed).
pub fn run_retryable(outcome: u8) -> bool {
    return outcome == RTO_BLOCKED;
}

/// A run is terminal (no retry makes sense) when any step failed.
pub fn run_terminal(outcome: u8) -> bool {
    return outcome == RTO_FAIL;
}

/// Returns true when the step index is in range.
pub fn step_valid(step: u8) -> bool {
    return step < RTS_COUNT;
}

/// Returns true when the outcome code is in range.
pub fn outcome_valid(outcome: u8) -> bool {
    return outcome < RTO_COUNT;
}

/// A runtime test run writes a T27L event when it completes (PASS or FAIL).
/// A BLOCKED run does not write (it did not complete).
pub fn event_written(outcome: u8) -> bool {
    if (outcome == RTO_PASS) { return true; }
    if (outcome == RTO_FAIL) { return true; }
    return false;
}

test step_codes_stable {
    assert RTS_PROBE_CONTRACT == 0;
    assert RTS_PROBE_LINKAGE  == 1;
    assert RTS_PROBE_SCHEMA   == 2;
    assert RTS_PROBE_SERVER   == 3;
    assert RTS_PROBE_E2E      == 4;
    assert RTS_COUNT          == 5;
    assert RTS_TEXT[RTS_PROBE_CONTRACT] == "PROBE_CONTRACT";
    assert RTS_TEXT[RTS_PROBE_E2E]      == "PROBE_E2E";
}

test outcome_codes_stable {
    assert RTO_PASS    == 0;
    assert RTO_BLOCKED == 1;
    assert RTO_FAIL    == 2;
    assert RTO_PENDING == 3;
    assert RTO_COUNT   == 4;
    assert RTO_TEXT[RTO_PASS]    == "PASS";
    assert RTO_TEXT[RTO_BLOCKED] == "BLOCKED";
    assert RTO_TEXT[RTO_FAIL]    == "FAIL";
    assert RTO_TEXT[RTO_PENDING] == "PENDING";
}

test t27l_event_kind_stable {
    assert TEK_RUNTIME_TEST_COMPLETE == 13;
}

test pass_requires_last_step_pass {
    assert runtime_test_passes(RTO_PASS);
    assert runtime_test_passes(RTO_BLOCKED) == false;
    assert runtime_test_passes(RTO_FAIL)    == false;
    assert runtime_test_passes(RTO_PENDING) == false;
}

test blocked_retryable_fail_terminal {
    assert run_retryable(RTO_BLOCKED);
    assert run_retryable(RTO_FAIL)    == false;
    assert run_retryable(RTO_PASS)    == false;
    assert run_terminal(RTO_FAIL);
    assert run_terminal(RTO_BLOCKED) == false;
    assert run_terminal(RTO_PASS)    == false;
}

test event_written_pass_or_fail_not_blocked {
    assert event_written(RTO_PASS);
    assert event_written(RTO_FAIL);
    assert event_written(RTO_BLOCKED) == false;
    assert event_written(RTO_PENDING) == false;
}

test step_and_outcome_validity_boundaries {
    assert step_valid(0);
    assert step_valid(4);
    assert step_valid(5) == false;
    assert outcome_valid(0);
    assert outcome_valid(3);
    assert outcome_valid(4) == false;
}

invariant step_count_at_least_five {
    assert RTS_COUNT >= 5;
}

invariant outcome_count {
    assert RTO_COUNT == 4;
}
