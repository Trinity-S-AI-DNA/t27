// SPDX-License-Identifier: Apache-2.0
; specs/t27mcp/owner_resolution.t27 -- owner resolution schema for the t27 MCP MVP pipeline
; Wave B1 of ORDER: T27_MCP_MVP_V1. Mandatory gate between Wave B (MCP skeleton) and Wave C
; (atomic graph). No task may proceed to execution without a resolved owner or an explicit
; ESCALATED status. CONFLICT and NO_OWNER both block execution.
; Schema and tests only; no server code, no tool handler.
; phi^2 + 1/phi^2 = 3 | TRINITY

module McpOwnerResolution;

/// Resolution statuses. Only RESOLVED and ESCALATED unblock execution.
pub const OR_RESOLVED           : u8 = 0;
pub const OR_PENDING            : u8 = 1;
pub const OR_CONFLICT           : u8 = 2;
pub const OR_NO_OWNER           : u8 = 3;
pub const OR_CAPABILITY_MISSING : u8 = 4;
pub const OR_LEASE_ACTIVE       : u8 = 5;
pub const OR_ESCALATED          : u8 = 6;
pub const OR_COUNT              : u8 = 7;

pub const OR_TEXT : [7]str = [
    "RESOLVED",
    "PENDING",
    "CONFLICT",
    "NO_OWNER",
    "CAPABILITY_MISSING",
    "LEASE_ACTIVE",
    "ESCALATED",
];

/// Resolution step indices for the T27L event payload. Steps run in this order.
pub const STEP_RESOLVE_DOMAIN   : u8 = 0;
pub const STEP_FIND_CANDIDATES  : u8 = 1;
pub const STEP_CHECK_CAPABILITY : u8 = 2;
pub const STEP_CHECK_LEASE      : u8 = 3;
pub const STEP_CHECK_SPEC       : u8 = 4;
pub const STEP_DETECT_CONFLICT  : u8 = 5;
pub const STEP_DETECT_ORPHAN    : u8 = 6;
pub const STEP_DETECT_SHARED    : u8 = 7;
pub const STEP_EMIT_T27L        : u8 = 8;
pub const STEP_COUNT            : u8 = 9;

/// Resolution id prefix.
pub const RESOL_ID_PREFIX : str = "res_";

/// A status that blocks execution. ESCALATED is not a blocker: it carries work forward.
pub fn blocks_execution(status: u8) -> bool {
    if (status == OR_CONFLICT)           { return true; }
    if (status == OR_NO_OWNER)           { return true; }
    if (status == OR_CAPABILITY_MISSING) { return true; }
    if (status == OR_LEASE_ACTIVE)       { return true; }
    if (status == OR_PENDING)            { return true; }
    return false;
}

/// Only RESOLVED and ESCALATED allow the pipeline to proceed.
pub fn allows_proceed(status: u8) -> bool {
    if (status == OR_RESOLVED)  { return true; }
    if (status == OR_ESCALATED) { return true; }
    return false;
}

test status_codes_stable {
    assert OR_RESOLVED           == 0;
    assert OR_PENDING            == 1;
    assert OR_CONFLICT           == 2;
    assert OR_NO_OWNER           == 3;
    assert OR_CAPABILITY_MISSING == 4;
    assert OR_LEASE_ACTIVE       == 5;
    assert OR_ESCALATED          == 6;
    assert OR_COUNT              == 7;
    assert OR_TEXT[OR_RESOLVED]  == "RESOLVED";
    assert OR_TEXT[OR_ESCALATED] == "ESCALATED";
}

test blocking_statuses {
    assert blocks_execution(OR_CONFLICT);
    assert blocks_execution(OR_NO_OWNER);
    assert blocks_execution(OR_CAPABILITY_MISSING);
    assert blocks_execution(OR_LEASE_ACTIVE);
    assert blocks_execution(OR_PENDING);
    assert blocks_execution(OR_RESOLVED)  == false;
    assert blocks_execution(OR_ESCALATED) == false;
}

test allows_proceed_only_resolved_or_escalated {
    assert allows_proceed(OR_RESOLVED);
    assert allows_proceed(OR_ESCALATED);
    assert allows_proceed(OR_PENDING)            == false;
    assert allows_proceed(OR_CONFLICT)           == false;
    assert allows_proceed(OR_NO_OWNER)           == false;
    assert allows_proceed(OR_CAPABILITY_MISSING) == false;
    assert allows_proceed(OR_LEASE_ACTIVE)       == false;
}

test blocking_and_allows_proceed_are_disjoint {
    // No status is both a blocker and a proceed: disjoint by design.
    assert blocks_execution(OR_RESOLVED)  == false;
    assert blocks_execution(OR_ESCALATED) == false;
    assert allows_proceed(OR_PENDING)   == false;
    assert allows_proceed(OR_CONFLICT)  == false;
    assert allows_proceed(OR_NO_OWNER)  == false;
}

test step_count_and_order {
    assert STEP_COUNT      == 9;
    assert STEP_EMIT_T27L  == 8;
    assert STEP_EMIT_T27L  == STEP_COUNT - 1;
    assert STEP_RESOLVE_DOMAIN < STEP_FIND_CANDIDATES;
    assert STEP_FIND_CANDIDATES < STEP_CHECK_CAPABILITY;
    assert STEP_DETECT_CONFLICT < STEP_EMIT_T27L;
}

invariant execution_gate {
    assert allows_proceed(OR_RESOLVED);
    assert allows_proceed(OR_ESCALATED);
    assert blocks_execution(OR_CONFLICT);
    assert blocks_execution(OR_NO_OWNER);
}

invariant status_count {
    assert OR_COUNT == 7;
}
