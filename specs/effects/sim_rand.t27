// SPDX-License-Identifier: Apache-2.0
; specs/effects/sim_rand.t27 -- a seeded PCG32 generator for deterministic simulation (#9010, epic #9008, for #9002).
; The pcg32 XSH RR variant of pcg-c-basic (M. E. O'Neill): 64 bits of state, 64 bits of increment, 32 bits out.
; All 64-bit arithmetic wraps mod 2^64, as the reference does (the t27 wrapping operators `*%` and `+%`).
; Reference vectors: seed 42, 54 gives a15c02b7 7b47f409 ba1d3330 83d2f293 bfa4784b cbed606e (the pcg32-demo output).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module EffectsSimRand;

pub const PCG32_MULT : u64 = 6364136223846793005;
pub const MASK32 : u64 = 4294967295;

pub struct Pcg32 {
    state: u64,
    inc: u64,
}

/// One step of the generator: the 32-bit output of the old state, the state moved on by the LCG.
pub fn pcg32_next(rng: *Pcg32) -> u32 {
    let old : u64 = rng.state;
    rng.state = old *% PCG32_MULT +% rng.inc;
    let xs : u64 = (((old >> 18) ^ old) >> 27) & MASK32;
    let rot : u64 = old >> 59;
    let left : u64 = (xs << ((32 - rot) & 31)) & MASK32;
    return ((xs >> rot) | left) as u32;
}

/// pcg32_srandom_r: state 0, the increment is odd (initseq shifted up, low bit set), one step, add the seed, one step.
pub fn pcg32_seed(initstate: u64, initseq: u64) -> Pcg32 {
    var rng : Pcg32 = Pcg32{ .state = 0, .inc = (initseq << 1) | 1 };
    let skip0 : u32 = pcg32_next(&rng);
    rng.state = rng.state +% initstate;
    let skip1 : u32 = pcg32_next(&rng);
    return rng;
}

test "pcg32_reference_vectors" {
    var rng : Pcg32 = pcg32_seed(42, 54);
    assert pcg32_next(&rng) == 0xa15c02b7;
    assert pcg32_next(&rng) == 0x7b47f409;
    assert pcg32_next(&rng) == 0xba1d3330;
    assert pcg32_next(&rng) == 0x83d2f293;
    assert pcg32_next(&rng) == 0xbfa4784b;
    assert pcg32_next(&rng) == 0xcbed606e;
}

test "pcg32_same_seed_same_stream" {
    var a : Pcg32 = pcg32_seed(7, 11);
    var b : Pcg32 = pcg32_seed(7, 11);
    var same : bool = true;
    var i : u32 = 0;
    while (i < 100) {
        if (pcg32_next(&a) != pcg32_next(&b)) { same = false; }
        i = i + 1;
    }
    assert same;
    var c : Pcg32 = pcg32_seed(7, 11);
    var d : Pcg32 = pcg32_seed(8, 11);
    assert pcg32_next(&c) != pcg32_next(&d);
}
