// ============================================================================
// PCG32 Random Number Generator Implementation
// Part of epic #9008 (effects at the edge); deterministic simulation primitives for #9002
// ============================================================================

/// PCG32 generator state (XSH RR variant of pcg-c-basic)
/// 
/// The PCG32 generator uses 128-bit state (split into state and increment fields)
/// and produces 32-bit random numbers with good statistical properties.
pub struct Pcg32 {
    state: u64,      // Current state value
    increment: u64,  // Increment value (must be odd)
}

/// PCG32 multiplier for the LCG
const PCG32_MULTIPLIER: u64 = 6364136223846793005;

/// Seed a PCG32 generator with initial state and sequence values
/// 
/// All arithmetic wraps mod 2^64, as the reference implementation does.
/// 
/// Args:
///   initstate: Initial state value (64-bit)
///   initseq: Initial sequence value (64-bit)
/// 
/// Returns:
///   Initialized Pcg32 generator
pub fn pcg32_seed(initstate: u64, initseq: u64) -> Pcg32 {
    // The increment must be odd - ensure this by setting the least significant bit
    var increment = initseq;
    increment = increment | 1;  // Ensure odd
    
    return Pcg32{
        .state = initstate,
        .increment = increment,
    };
}

/// Generate the next 32-bit random number from a PCG32 generator
/// 
/// Uses the PCG32 XSH RR (xorshift high, random rotate) algorithm.
/// All arithmetic wraps mod 2^64, as the reference implementation does.
/// 
/// Args:
///   rng: Pointer to the PCG32 generator state
/// 
/// Returns:
///   Next 32-bit random number
pub fn pcg32_next(rng: *Pcg32) -> u32 {
    // Advance the LCG: state = state * multiplier + increment
    rng.state = rng.state * PCG32_MULTIPLIER + rng.increment;
    
    // Extract the 32-bit output using XSH RR transformation
    const xorshifted = @intCast((@shrExact(rng.state, 18) ^ @shrExact(rng.state, 27)) & 0xFFFFFFFF);
    const rot = @intCast(@shrExact(rng.state, 59));
    
    // Apply rotate right operation
    return @bitCast(@rotateRight(u32, xorshifted, rot));
}

// ============================================================================
// Tests
// ============================================================================

/// Test PCG32 reference vectors from pcg32-demo
/// 
/// Seeds with initstate 42 and initseq 54, then asserts that the first six outputs
/// are exactly: 0xa15c02b7, 0x7b47f409, 0xba1d3330, 0x83d2f293, 0xbfa4784b, 0xcbed606e
test "pcg32_reference_vectors" {
    var rng = pcg32_seed(42, 54);
    
    // First six outputs must match the reference exactly
    assert pcg32_next(&rng) == 0xa15c02b7;
    assert pcg32_next(&rng) == 0x7b47f409;
    assert pcg32_next(&rng) == 0xba1d3330;
    assert pcg32_next(&rng) == 0x83d2f293;
    assert pcg32_next(&rng) == 0xbfa4784b;
    assert pcg32_next(&rng) == 0xcbed606e;
}

/// Test that same seeds produce identical streams and different seeds produce different outputs
/// 
/// Asserts that two generators with the same seed give the same 100 outputs, and
/// a different seed gives a different first output.
test "pcg32_same_seed_same_stream" {
    // Test same seed produces identical sequences
    var rng1 = pcg32_seed(12345, 67890);
    var rng2 = pcg32_seed(12345, 67890);
    
    var i: usize = 0;
    while (i < 100) {
        assert pcg32_next(&rng1) == pcg32_next(&rng2);
        i = i + 1;
    }
    
    // Test different seeds produce different first outputs
    var rng3 = pcg32_seed(54321, 67890);  // Different state
    var rng4 = pcg32_seed(12345, 98765);  // Different sequence
    
    assert pcg32_next(&rng3) != pcg32_next(&rng4);  // Should be different
}