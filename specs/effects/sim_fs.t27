// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Fixed-capacity in-memory file store | φ² + 1/φ² = 3 | TRINITY

module SimFs;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const FileEntry = struct {
        path : []const u8,
        data : []const u8,
    };

    pub const SimFs = struct {
        entries : []FileEntry,
        capacity : "usize",
        allocator : "std.mem.Allocator",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(allocator: std.mem.Allocator, capacity: usize) → SimFs
    fn init(allocator: std.mem.Allocator, capacity: usize) -> SimFs {
        var entries = allocator.alloc(FileEntry, 0);
        var store = SimFs{};
        store.entries = entries;
        store.capacity = capacity;
        store.allocator = allocator;
        return store;
    }

    // write(store: *SimFs, path: []const u8, data: []const u8) → bool
    fn write(store: *SimFs, path: []const u8, data: []const u8) -> bool {
        // Check if store is full
        if (store.entries.len >= store.capacity) {
            return false;
        }
        
        // Check if path already exists and update it
        for (i in 0..store.entries.len) {
            if (std.mem.eql(u8, store.entries[i].path, path)) {
                // Update existing entry
                const newEntries = store.entries.copy();
                store.allocator.free(newEntries[i].path);
                store.allocator.free(newEntries[i].data);
                newEntries[i] = FileEntry{
                    .path = std.mem.dupe(u8, store.allocator, path),
                    .data = std.mem.dupe(u8, store.allocator, data),
                };
                store.entries = newEntries;
                return true;
            }
        }
        
        // Add new entry
        const newEntries = store.entries.copy();
        const newEntry = FileEntry{
            .path = std.mem.dupe(u8, store.allocator, path),
            .data = std.mem.dupe(u8, store.allocator, data),
        };
        newEntries.push(newEntry);
        store.entries = newEntries;
        return true;
    }

    // read(store: SimFs, path: []const u8) → ?[]const u8
    fn read(store: SimFs, path: []const u8) -> ?[]const u8 {
        for (i in 0..store.entries.len) {
            if (std.mem.eql(u8, store.entries[i].path, path)) {
                // Return a copy of the data
                const dataCopy = std.mem.dupe(u8, store.allocator, store.entries[i].data);
                return dataCopy;
            }
        }
        return null;
    }

    // remove(store: *SimFs, path: []const u8) → bool
    fn remove(store: *SimFs, path: []const u8) -> bool {
        for (i in 0..store.entries.len) {
            if (std.mem.eql(u8, store.entries[i].path, path)) {
                // Remove the entry
                const newEntries = store.entries.copy();
                store.allocator.free(newEntries[i].path);
                store.allocator.free(newEntries[i].data);
                newEntries.delete(i);
                store.entries = newEntries;
                return true;
            }
        }
        return false;
    }

    // count(store: SimFs) → u32
    fn count(store: SimFs) -> u32 {
        return @as(u32, @intCast(store.entries.len));
    }

    // deinit(store: *SimFs) → void
    fn deinit(store: *SimFs) -> void {
        for (i in 0..store.entries.len) {
            store.allocator.free(store.entries[i].path);
            store.allocator.free(store.entries[i].data);
        }
        store.allocator.free(store.entries);
        // Reset the store state
        store.* = SimFs{
            .entries = undefined,
            .capacity = 0,
            .allocator = undefined,
        };
    }

    // ═══════════════════════════════════════════════════════════
    // 4. Tests
    // ═══════════════════════════════════════════════════════════

    test write_then_read_roundtrip {
        var store = init(std.testing.allocator, 10);
        defer deinit(&store);
        
        // Write two files
        const write1 = write(&store, "file1", "hello");
        const write2 = write(&store, "file2", "world");
        assert(write1 == true);
        assert(write2 == true);
        
        // Read them back
        const read1 = read(store, "file1");
        const read2 = read(store, "file2");
        assert(read1 != null);
        assert(read2 != null);
        assert(std.mem.eql(u8, read1.?, "hello"));
        assert(std.mem.eql(u8, read2.?, "world"));
        
        // Overwrite one file
        const overwrite = write(&store, "file1", "HELLO");
        assert(overwrite == true);
        
        // Read the new contents
        const newRead1 = read(store, "file1");
        assert(newRead1 != null);
        assert(std.mem.eql(u8, newRead1.?, "HELLO"));
        
        // Verify the other file is unchanged
        const unchangedRead2 = read(store, "file2");
        assert(unchangedRead2 != null);
        assert(std.mem.eql(u8, unchangedRead2.?, "world"));
    }

    test missing_and_removed_read_null {
        var store = init(std.testing.allocator, 10);
        defer deinit(&store);
        
        // Initially empty
        assert(count(store) == 0);
        
        // Read a path never written
        const neverWritten = read(store, "never_existed");
        assert(neverWritten == null);
        
        // Write a file
        const writeResult = write(&store, "test_file", "test_data");
        assert(writeResult == true);
        assert(count(store) == 1);
        
        // Read it back to verify it exists
        const writtenRead = read(store, "test_file");
        assert(writtenRead != null);
        assert(std.mem.eql(u8, writtenRead.?, "test_data"));
        
        // Remove the file
        const removeResult = remove(&store, "test_file");
        assert(removeResult == true);
        assert(count(store) == 0);
        
        // Read the removed path
        const removedRead = read(store, "test_file");
        assert(removedRead == null);
    }