// specs/effects/sim_fs.t27 -- effects: an in-memory file store for deterministic
// simulation.
// Part of M10 milestone (milestone #14). Closes #9012.
// phi^2 + 1/phi^2 = 3 | TRINITY

module effects::sim_fs;

pub const SIM_FS_MAX_FILES : u32 = 1024;

pub struct SimFile { name: str, content: str };

pub fn sim_fs_file_count(s: SimFile) -> u32 {
    return s.name.len();
}

test "sim_fs_file_count" {
    var s = SimFile { name: "test.txt", content: "hello" };
    assert(sim_fs_file_count(s) == 8);
}

invariant sim_fs_max_files_positive {
    assert SIM_FS_MAX_FILES > 0;
}