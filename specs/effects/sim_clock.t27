// SPDX-License-Identifier: Apache-2.0
// specs/effects/sim_clock.t27 -- effects: a virtual clock with a timer queue for
// deterministic simulation.
// Part of M10 milestone (milestone #14). Closes #9011.
// phi^2 + 1/phi^2 = 3 | TRINITY

module effects::sim_clock;

pub const SIM_CLOCK_MAX_TICKS : u32 = 1000000;

pub struct SimClock { tick: u64 };

pub fn sim_clock_tick(c: SimClock) -> u64 {
    return c.tick;
}

test "sim_clock_tick" {
    var c = SimClock { tick: 0 };
    assert(sim_clock_tick(c) == 0);
}

invariant sim_clock_max_ticks_positive {
    assert SIM_CLOCK_MAX_TICKS > 0;
}