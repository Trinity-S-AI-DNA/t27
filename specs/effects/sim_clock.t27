// SPDX-License-Identifier: Apache-2.0
; specs/effects/sim_clock.t27 -- deterministic simulation primitives for virtual clock and timer queue
; Part of epic #9008 (effects at the edge); deterministic simulation primitives for #9002.
; --
; A virtual clock tracks time starting from 0 and advancing monotonically. A fixed-capacity timer queue
; allows scheduling timers with deadlines and retrieving due timers in deadline order (ties broken by
; schedule order). This provides deterministic simulation for time-dependent effects.
; phi^2 + 1/phi^2 = 3 | TRINITY

module SimClock;

/// Virtual clock state: current time in nanoseconds
pub struct Clock {
    now_ns: u64,
}

/// Timer entry with deadline and ID
pub struct Timer {
    deadline_ns: u64,
    id: u32,
}

/// Timer queue with fixed capacity
pub struct TimerQueue {
    timers: [Timer; 8],  // Fixed capacity of 8 timers
    count: u32,
    next_id: u32,       // For generating unique IDs and preserving schedule order
}

/// Create a new clock starting at time 0
pub fn clock_new() -> Clock {
    return Clock{ now_ns: 0 };
}

/// Create a new empty timer queue with given capacity
pub fn timer_queue_new() -> TimerQueue {
    var queue: TimerQueue;
    queue.count = 0;
    queue.next_id = 1;  // Start IDs from 1
    return queue;
}

/// Get current time from clock
pub fn clock_now(clock: Clock) -> u64 {
    return clock.now_ns;
}

/// Advance clock time forward by dt_ns nanoseconds. Time never goes backwards.
/// Returns true if time was advanced, false if dt_ns is 0.
pub fn clock_advance(clock: Clock, dt_ns: u64) -> (Clock, bool) {
    if (dt_ns == 0) {
        return (clock, false);
    }
    var new_clock: Clock;
    new_clock.now_ns = clock.now_ns + dt_ns;
    return (new_clock, true);
}

/// Schedule a timer with given deadline and ID. Returns false if queue is full.
pub fn timer_queue_schedule(queue: TimerQueue, deadline_ns: u64, id: u32) -> (TimerQueue, bool) {
    if (queue.count >= 8) {  // Queue is full (capacity 8)
        return (queue, false);
    }
    
    var new_queue: TimerQueue;
    new_queue.count = queue.count + 1;
    new_queue.next_id = queue.next_id;
    
    // Find insertion position to maintain sorted order
    var i: u32 = 0;
    while (i < queue.count) {
        if (queue.timers[i].deadline_ns > deadline_ns or 
            (queue.timers[i].deadline_ns == deadline_ns and queue.timers[i].id > id)) {
            break;
        }
        i = i + 1;
    }
    
    // Shift timers to make room
    var j: u32 = queue.count;
    while (j > i) {
        new_queue.timers[j] = queue.timers[j - 1];
        j = j - 1;
    }
    
    // Insert new timer
    new_queue.timers[i] = Timer{ deadline_ns: deadline_ns, id: id };
    
    return (new_queue, true);
}

/// Generate next unique timer ID and increment counter
pub fn timer_queue_next_id(queue: TimerQueue) -> (TimerQueue, u32) {
    var new_queue: TimerQueue;
    new_queue = queue;
    new_queue.next_id = queue.next_id + 1;
    return (new_queue, queue.next_id);
}

/// Pop all timers due at or before current clock time. Returns array of timer IDs.
/// Returns empty array if no timers are due.
pub fn timer_queue_pop_due(queue: TimerQueue, clock: Clock) -> (TimerQueue, [u32; 8], u32) {
    var due_count: u32 = 0;
    var due_timers: [u32; 8];
    var i: u32 = 0;
    
    // Count due timers
    while (i < queue.count) {
        if (queue.timers[i].deadline_ns <= clock.now_ns) {
            due_timers[due_count] = queue.timers[i].id;
            due_count = due_count + 1;
        } else {
            break;  // Timers are sorted, so rest are not due
        }
        i = i + 1;
    }
    
    // Remove due timers from queue
    var new_queue: TimerQueue;
    new_queue.count = queue.count - due_count;
    new_queue.next_id = queue.next_id;
    
    // Shift remaining timers left
    var j: u32 = 0;
    while (i < queue.count) {
        new_queue.timers[j] = queue.timers[i];
        j = j + 1;
        i = i + 1;
    }
    
    return (new_queue, due_timers, due_count);
}

/// Test: timers fire in deadline order
test "timers_fire_in_deadline_order" {
    var clock: Clock = clock_new();
    var queue: TimerQueue = timer_queue_new();
    
    // Schedule timers with deadlines 30, 10, 20 (in that order)
    var result: (TimerQueue, bool) = timer_queue_schedule(queue, 30, 1);
    assert result.1 == true;  // Should succeed
    queue = result.0;
    
    result = timer_queue_schedule(queue, 10, 2);
    assert result.1 == true;  // Should succeed
    queue = result.0;
    
    result = timer_queue_schedule(queue, 20, 3);
    assert result.1 == true;  // Should succeed
    queue = result.0;
    
    // Advance clock to 25
    var advance_result: (Clock, bool) = clock_advance(clock, 25);
    assert advance_result.1 == true;  // Time should advance
    clock = advance_result.0;
    
    // Pop due timers - should get timer 2 (deadline 10) first, then timer 3 (deadline 20)
    var pop_result: (TimerQueue, [u32; 8], u32) = timer_queue_pop_due(queue, clock);
    queue = pop_result.0;
    var due_timers: [u32; 8] = pop_result.1;
    var count: u32 = pop_result.2;
    
    assert count == 2;  // Two timers should be due
    assert due_timers[0] == 2;  // Timer with deadline 10 should be first
    assert due_timers[1] == 3;  // Timer with deadline 20 should be second
    
    // No more timers should be due
    pop_result = timer_queue_pop_due(queue, clock);
    count = pop_result.2;
    assert count == 0;  // No more timers due
}

/// Test: clock is monotonic
test "clock_is_monotonic" {
    var clock: Clock = clock_new();
    
    // Advance by 0 should keep time unchanged
    var result: (Clock, bool) = clock_advance(clock, 0);
    assert result.1 == false;  // Time should not advance
    var unchanged_clock: Clock = result.0;
    assert unchanged_clock.now_ns == 0;  // Time should remain 0
    
    // Advance by positive amounts should only increase time
    result = clock_advance(unchanged_clock, 10);
    assert result.1 == true;  // Time should advance
    var clock_10: Clock = result.0;
    assert clock_10.now_ns == 10;
    
    result = clock_advance(clock_10, 5);
    assert result.1 == true;  // Time should advance
    var clock_15: Clock = result.0;
    assert clock_15.now_ns == 15;
    
    result = clock_advance(clock_15, 0);
    assert result.1 == false;  // Time should not advance
    var clock_15_again: Clock = result.0;
    assert clock_15_again.now_ns == 15;  // Time should remain 15
    
    result = clock_advance(clock_15_again, 3);
    assert result.1 == true;  // Time should advance
    var clock_18: Clock = result.0;
    assert clock_18.now_ns == 18;  // Time should be 18, not less than 15
}