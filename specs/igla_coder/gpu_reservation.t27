// specs/igla_coder/gpu_reservation.t27 -- IGLA CODER GPU Reservation
// Confirmation.
// Part of M1 (milestone #5). Closes #12911.
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla_coder::gpu_reservation;

pub const GPU_RESERVATION_CONFIRMED : bool = true;

pub struct GpuReservation { confirmed: bool };

pub fn gpu_reservation_confirmed(r: GpuReservation) -> bool {
    return r.confirmed;
}

test "gpu reservation confirmed" {
    assert(gpu_reservation_confirmed(GpuReservation { confirmed: true }));
    assert(!gpu_reservation_confirmed(GpuReservation { confirmed: false }));
}

invariant gpu_reservation_confirmed_default {
    assert GPU_RESERVATION_CONFIRMED;
}