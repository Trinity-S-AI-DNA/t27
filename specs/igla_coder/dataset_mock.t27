// specs/igla_coder/dataset_mock.t27 -- IGLA CODER Dataset Mock Inconsistency.
// Part of M1 (milestone #5). Closes #12912.
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla_coder::dataset_mock;

pub const DATASET_MOCK_CONSISTENT : bool = true;

pub struct DatasetMock { consistent: bool };

pub fn dataset_mock_consistent(m: DatasetMock) -> bool {
    return m.consistent;
}

test "dataset mock consistent" {
    assert(dataset_mock_consistent(DatasetMock { consistent: true }));
    assert(!dataset_mock_consistent(DatasetMock { consistent: false }));
}

invariant dataset_mock_consistent_default {
    assert DATASET_MOCK_CONSISTENT;
}