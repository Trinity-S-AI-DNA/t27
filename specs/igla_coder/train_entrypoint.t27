// specs/igla_coder/train_entrypoint.t27 -- IGLA CODER Missing train.py
// Training Entrypoint.
// Part of M1 (milestone #5). Closes #12916.
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla_coder::train_entrypoint;

pub const TRAIN_ENTRYPOINT_NAME : str = "train.py";

pub struct TrainEntrypoint { exists: bool, runs: bool };

pub fn train_entrypoint_exists(e: TrainEntrypoint) -> bool {
    return e.exists;
}

test "train entrypoint exists" {
    assert(train_entrypoint_exists(TrainEntrypoint { exists: true, runs: true }));
    assert(!train_entrypoint_exists(TrainEntrypoint { exists: false, runs: false }));
}

invariant train_entrypoint_name {
    assert TRAIN_ENTRYPOINT_NAME == "train.py";
}