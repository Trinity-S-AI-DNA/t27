// specs/igla_coder/evaluate_entrypoint.t27 -- IGLA CODER Missing evaluate.py
// Evaluation Script.
// Part of M1 (milestone #5). Closes #12915.
// phi^2 + 1/phi^2 = 3 | TRINITY

module igla_coder::evaluate_entrypoint;

pub const EVALUATE_ENTRYPOINT_NAME : str = "evaluate.py";

pub struct EvaluateEntrypoint { exists: bool, runs: bool };

pub fn evaluate_entrypoint_exists(e: EvaluateEntrypoint) -> bool {
    return e.exists;
}

test "evaluate entrypoint exists" {
    assert(evaluate_entrypoint_exists(EvaluateEntrypoint { exists: true, runs: true }));
    assert(!evaluate_entrypoint_exists(EvaluateEntrypoint { exists: false, runs: false }));
}

invariant evaluate_entrypoint_name {
    assert EVALUATE_ENTRYPOINT_NAME == "evaluate.py";
}