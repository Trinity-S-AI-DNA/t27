spec TRI_WORKTREE_MANIFEST_001

-- Phase 1: Worktree Manifest System
-- TDD Mandate: All specs must contain test/invariant/bench blocks
-- Invariant Laws: L1-7 Compliance

numericformat gf16 tf3

-- Trinity constants (L5 identity law)
pub const PHI f64 = 1.6180339887498948482
pub const TRINITY f64 = 3.0

-- Core Worktree Types (from architecture spec)
struct WorktreeManifest {
  issue i32: required
  title string: required
  agent string: required
  base string: required
  worktree string: required
  branch string: required
  write_scopes []string: required
  read_scopes []string: required
  forbidden []string: required
  verification []VerificationType: required
  definition_of_done []string: required
  created_ts string: required
  modified_ts string: optional
  status WorktreeStatus: required
  commit_hash string: optional
  merge_guard_status string: optional
}

pub const WorktreeStatus enum(string) {
  pending = "pending",
  active = "active", 
  checkpoint = "checkpoint",
  completed = "completed",
  failed = "failed"
}

pub const VerificationType enum(string) {
  syntax = "syntax",
  typecheck = "typecheck", 
  test = "test",
  anomaly_scan = "anomaly_scan",
  merge_guard = "merge_guard"
}

-- Manifest System Core Functions
pub fn create_manifest(issue i32, title string, agent string, base string, write_scopes []string) -> WorktreeManifest
pub fn load_manifest(issue i32) -> WorktreeManifest
pub fn save_manifest(manifest WorktreeManifest) -> bool
pub fn update_manifest_status(issue i32, status WorktreeStatus) -> bool
pub fn validate_manifest(manifest WorktreeManifest) -> ValidationResult
pub fn merge_manifests(base WorktreeManifest, update WorktreeManifest) -> WorktreeManifest
pub fn get_manifest_path(issue i32) -> string
pub fn list_manifests() -> []WorktreeManifest

-- Manifest Validation Functions
pub fn validate_manifest_structure(manifest WorktreeManifest) -> bool
pub fn validate_manifest_scopes(manifest WorktreeManifest) -> bool
pub fn validate_manifest_verification(manifest WorktreeManifest) -> bool
pub fn validate_manifest_compliance(manifest WorktreeManifest) -> bool

-- Manifest History Functions
pub fn get_manifest_history(issue i32) -> []WorktreeManifest
pub fn add_manifest_event(manifest WorktreeManifest, event_type string, message string) -> WorktreeManifest
pub fn create_manifest_snapshot(manifest WorktreeManifest) -> ManifestSnapshot

-- Result Types
struct ValidationResult {
  valid bool: required
  errors []string: required
  warnings []string: required
}

struct ManifestSnapshot {
  manifest WorktreeManifest: required
  timestamp string: required
  hash string: required
}

-- Tests (TDD Mandate)
.test create_manifest_complete
  given issue = 123
  given title = "Fix provider routing mismatch"
  given agent = "repair-agent"
  given base = "origin/main"
  given write_scopes = ["packages/llm/**/provider-routing/**"]
  when manifest = create_manifest(issue, title, agent, base, write_scopes)
  then manifest.issue == issue
  then manifest.title == title
  then manifest.agent == agent
  then manifest.base == base
  then manifest.status == WorktreeStatus.pending
  then len(manifest.verification) > 0
  then contains(manifest.write_scopes[0], "provider-routing")

.test load_manifest_consistency
  given original = create_manifest(123, "Test", "agent", "main", ["test/**"])
  when saved = save_manifest(original)
  when loaded = load_manifest(123)
  then saved == true
  then loaded.issue == original.issue
  then loaded.title == original.title
  then loaded.agent == original.agent

.test validate_manifest_structure_success
  given manifest = create_manifest(123, "Test", "agent", "main", ["test/**"])
  when validation = validate_manifest_structure(manifest)
  then validation.valid == true
  then len(validation.errors) == 0

.test validate_manifest_structure_failure
  given invalid_manifest = WorktreeManifest{
    issue: 0,  -- Invalid issue number
    title: "",  -- Empty title
    agent: "",  -- Empty agent
    base: "origin/main",
    worktree: "",
    branch: "",
    write_scopes: [],
    read_scopes: ["**"],
    forbidden: ["force-push"],
    verification: [],
    definition_of_done: [],
    created_ts: "",
    status: WorktreeStatus.pending
  }
  when validation = validate_manifest_structure(invalid_manifest)
  then validation.valid == false
  then len(validation.errors) > 0

.test validate_manifest_scopes_format
  given valid_manifest = create_manifest(123, "Test", "agent", "main", ["packages/llm/**", "tests/**"])
  given invalid_manifest = create_manifest(124, "Test", "agent", "main", ["invalid-scope", "packages/llm"])
  when valid_result = validate_manifest_scopes(valid_manifest)
  when invalid_result = validate_manifest_scopes(invalid_manifest)
  then valid_result == true
  then invalid_result == false

.test update_manifest_status_cycle
  given manifest = create_manifest(123, "Test", "agent", "main", ["test/**"])
  when updated1 = update_manifest_status(123, WorktreeStatus.active)
  when updated2 = update_manifest_status(123, WorktreeStatus.checkpoint)
  when updated3 = update_manifest_status(123, WorktreeStatus.completed)
  then updated1 == true
  then updated2 == true
  then updated3 == true
  then load_manifest(123).status == WorktreeStatus.completed

.test merge_manifests_preserves_data
  given base = create_manifest(123, "Base", "agent1", "main", ["base/**"])
  given update = create_manifest(123, "Updated", "agent2", "main", ["update/**"])
  when merged = merge_manifests(base, update)
  then merged.issue == 123
  then merged.title == "Updated"  -- Update takes precedence
  then len(merged.write_scopes) == 2  -- Both scopes preserved
  then contains(merged.write_scopes[0], "base")
  then contains(merged.write_scopes[1], "update")

.test get_manifest_path_format
  when path = get_manifest_path(123)
  then contains(path, "123")
  then ends_with(path, ".json")

.test list_manifests_returns_array
  when manifests = list_manifests()
  then type(manifests) == array
  then all manifest: manifests -> manifest.issue > 0

-- Benchmarks (Manifest Performance)
.bench manifest_creation_latency
  target: < 10ms
  measure:
    loop 100: create_manifest(123, "Benchmark", "agent", "main", ["test/**"])

.bench manifest_save_load_latency
  target: < 20ms (save + load)
  measure:
    manifest = create_manifest(123, "Benchmark", "agent", "main", ["test/**"])
    save_manifest(manifest)
    load_manifest(123)

.bench manifest_validation_throughput
  target: < 50ms for 100 manifests
  measure:
    create 100 manifests
    loop 100: validate_manifest(load_manifest(issue))
    cleanup 100 manifests

-- Invariants (Manifest Safety Guarantees)
invariant manifest_completeness {
  -- Every manifest has all required fields
  forall manifest: WorktreeManifest
  assert manifest.issue > 0
  assert manifest.title != ""
  assert manifest.agent != ""
  assert manifest.base != ""
  assert manifest.branch != ""
  assert len(manifest.write_scopes) > 0
  assert len(manifest.verification) > 0
  assert len(manifest.definition_of_done) > 0
}

invariant manifest_uniqueness {
  -- Each issue has exactly one active manifest
  forall issue1, issue2: i32
  when issue1 != issue2
  then load_manifest(issue1).issue != load_manifest(issue2).issue
}

invariant status_transition_validity {
  -- Valid status transitions only
  forall manifest: WorktreeManifest
  when current_status = manifest.status
  then update_manifest_status(manifest.issue, WorktreeStatus.pending) == false  -- Cannot go back to pending
}

invariant scope_isolation {
  -- Write and read scopes are properly isolated
  forall manifest: WorktreeManifest
  assert validate_manifest_scopes(manifest) == true
}

invariant traceability_enforcement {
  -- Every manifest links to an issue (L1 TRACEABILITY)
  forall manifest: WorktreeManifest
  assert manifest.issue > 0
}

invariant generation_compliance {
  -- Manifests are generated, not hand-edited (L2 GENERATION)
  forall manifest: WorktreeManifest
  assert manifest.created_ts != ""
  assert manifest.modified_ts == "" or manifest.created_ts <= manifest.modified_ts
}

invariant purity_compliance {
  -- All manifest identifiers are ASCII-only (L3 PURITY)
  forall manifest: WorktreeManifest
  assert ascii_only(manifest.title)
  assert ascii_only(manifest.agent)
  assert ascii_only(manifest.branch)
}

invariant testability_compliance {
  -- Manifest spec contains tests/invariants/benchmarks (L4 TESTABILITY)
  assert len(test_blocks) > 0 or len(invariant_blocks) > 0 or len(bench_blocks) > 0
}

invariant identity_compliance {
  -- Trinity identity holds in manifest constants (L5 IDENTITY)
  assert PHI * PHI + 1.0 / (PHI * PHI) == TRINITY
}

invariant ceiling_compliance {
  -- Manifests comply with GF16 format limits (L6 CEILING)
  forall manifest: WorktreeManifest
  assert manifest.issue < 16777216  -- 2^24 for GF16
  assert len(manifest.title) <= 256
  assert len(manifest.agent) <= 64
}

invariant unity_compliance {
  -- Manifest system uses tri/t27c, not shell scripts (L7 UNITY)
  forall cmd: string in ["create_manifest", "save_manifest", "validate_manifest"]
  assert not contains(cmd, ".sh")
}