spec TRI_WORKTREE_CORE_001

-- Phase 1: Core Worktree Implementation
-- TDD Mandate: All specs must contain test/invariant/bench blocks
-- Invariant Laws: L1-7 Compliance

numericformat gf16 tf3

-- Trinity constants (L5 identity law)
pub const PHI f64 = 1.6180339887498948482
pub const TRINITY f64 = 3.0

-- Core Worktree Types (from architecture spec)
struct WorktreeManifest {
  issue i32: required
  title string: required
  agent string: required
  base string: required
  worktree string: required
  branch string: required
  write_scopes []string: required
  read_scopes []string: required
  forbidden []string: required
  verification []VerificationType: required
  definition_of_done []string: required
  created_ts string: required
  modified_ts string: optional
  status WorktreeStatus: required
  commit_hash string: optional
  merge_guard_status string: optional
}

pub const WorktreeStatus enum(string) {
  pending = "pending",
  active = "active", 
  checkpoint = "checkpoint",
  completed = "completed",
  failed = "failed"
}

pub const VerificationType enum(string) {
  syntax = "syntax",
  typecheck = "typecheck", 
  test = "test",
  anomaly_scan = "anomaly_scan",
  merge_guard = "merge_guard"
}

-- Worktree Manager (Core Implementation)
struct WorktreeManager {
  root_path string: required
  active_worktrees map[i32]:WorktreeManifest: required
  worktree_history map[i32]:[]WorktreeManifest: required
  manifest_cache map[i32]:WorktreeManifest: required
}

-- Core Functions (Primary Implementation)
pub fn worktree_create(manager WorktreeManager, issue i32, title string, agent string, write_scopes []string) -> WorktreeManifest
pub fn worktree_list(manager WorktreeManager) -> []WorktreeManifest
pub fn worktree_verify(manager WorktreeManager, issue i32) -> VerificationResult
pub fn worktree_checkpoint(manager WorktreeManager, issue i32) -> WorktreeManifest
pub fn worktree_status(manager WorktreeManager, issue i32) -> WorktreeStatus

-- Manifest Storage Functions
pub fn load_manifest(manifest_path string) -> WorktreeManifest
pub fn save_manifest(manifest WorktreeManifest) -> bool
pub fn manifest_exists(issue i32) -> bool
pub fn get_manifest_path(issue i32) -> string

-- Worktree Lifecycle Functions
pub fn create_worktree_branch(base_branch string, issue i32, branch_name string) -> string
pub fn checkout_worktree(worktree_path string) -> bool
pub fn validate_write_scopes(scopes []string) -> bool
pub fn enforce_forbidden_operations(manifest WorktreeManifest, operation string) -> bool

-- Verification Functions
pub fn verify_syntax(worktree_path string) -> bool
pub fn verify_types(worktree_path string) -> bool
pub fn run_tests(worktree_path string) -> TestResult
pub fn run_anomaly_scan(worktree_path string) -> AnomalyResult
pub fn check_merge_guard(worktree_path string) -> GuardResult

-- Result Types
struct VerificationResult {
  issue i32: required
  passed bool: required
  details map[string]: required
  timestamp string: required
}

struct TestResult {
  passed bool: required
  total_tests i32: required
  passed_tests i32: required
  failures []string: required
  duration_ms i32: required
}

struct AnomalyResult {
  clean bool: required
  anomalies []Anomaly: required
  scan_duration_ms i32: required
}

struct Anomaly {
  severity string: required
  message string: required
  location string: required
  rule string: required
}

struct GuardResult {
  allowed bool: required
  blocking_rules []string: required
}

-- Tests (TDD Mandate)
.test worktree_create_manifest_generation
  given manager = WorktreeManager{root_path: ".trinity/worktrees"}
  given issue = 123
  given title = "Fix provider routing mismatch"
  given agent = "repair-agent"
  given write_scopes = ["packages/llm/**/provider-routing/**"]
  when manifest = worktree_create(manager, issue, title, agent, write_scopes)
  then manifest.issue == issue
  then manifest.title == title
  then manifest.agent == agent
  then manifest.status == WorktreeStatus.pending
  then manifest.created_ts != ""
  then contains(manifest.verification, VerificationType.test)
  then contains(manifest.verification, VerificationType.anomaly_scan)

.test worktree_list_active_only
  given manager = WorktreeManager{root_path: ".trinity/worktrees"}
  when manifests = worktree_list(manager)
  then len(manifests) >= 0
  then all manifest: manifests -> manifest.issue > 0

.test worktree_verify_syntax_pass
  given manager = WorktreeManager{root_path: ".trinity/worktrees"}
  given issue = 123
  when result = worktree_verify(manager, issue)
  then result.issue == issue
  then result.passed == true or result.passed == false
  then result.timestamp != ""

.test worktree_checkpoint_preserves_data
  given manager = WorktreeManager{root_path: ".trinity/worktrees"}
  given issue = 123
  when manifest = worktree_checkpoint(manager, issue)
  then manifest.status == WorktreeStatus.checkpoint
  then manifest.modified_ts != ""

.test load_save_manifest_consistency
  given manifest = WorktreeManifest{
    issue: 123,
    title: "Test Manifest",
    agent: "test-agent",
    base: "origin/main",
    worktree: "../tri-wt-123-test",
    branch: "tri/123-test",
    write_scopes: ["test/**"],
    read_scopes: ["**"],
    forbidden: ["force-push"],
    verification: [VerificationType.test],
    definition_of_done: ["test passes"],
    created_ts: "2026-10-30T00:00:00Z",
    status: WorktreeStatus.active
  }
  when saved = save_manifest(manifest)
  when loaded = load_manifest(".trinity/worktrees/123.json")
  then saved == true
  then loaded.issue == manifest.issue
  then loaded.title == manifest.title

.test validate_write_scopes_format
  given valid_scopes = ["packages/llm/**", "src/**", "tests/**"]
  given invalid_scopes = ["packages/llm", "invalid/path"]
  when valid_result = validate_write_scopes(valid_scopes)
  when invalid_result = validate_write_scopes(invalid_scopes)
  then valid_result == true
  then invalid_result == false

.test enforce_forbidden_operations
  given manifest = WorktreeManifest{
    forbidden: ["force-push", "primary-checkout-edit"]
  }
  when force_push_check = enforce_forbidden_operations(manifest, "force-push")
  when edit_check = enforce_forbidden_operations(manifest, "primary-checkout-edit")
  then force_push_check == false
  then edit_check == false

-- Benchmarks (Performance Requirements)
.bench worktree_create_performance
  target: < 500ms
  measure:
    loop 10: worktree_create(WorktreeManager{root_path: ".trinity/worktrees"}, 123, "Benchmark", "test-agent", ["test/**"])

.bench worktree_verify_performance
  target: < 2000ms
  measure:
    create_worktree_directory("test-worktree")
    write_test_files("test-worktree")
    when result = worktree_verify(WorktreeManager{root_path: ".trinity/worktrees"}, 123)
    cleanup_worktree_directory("test-worktree")

.bench manifest_cache_performance
  target: < 10ms cache hit
  measure:
    load_manifest(".trinity/worktrees/123.json")
    load_manifest(".trinity/worktrees/123.json")  -- Second read should be cached

-- Invariants (Safety Guarantees)
invariant manifest_uniqueness {
  -- Each issue has exactly one active manifest
  forall manager: WorktreeManager
  forall issue1, issue2: manager.active_worktrees.keys()
  when issue1 != issue2
  then manager.active_worktrees[issue1].issue != manager.active_worktrees[issue2].issue
}

invariant write_scope_safety {
  -- Write scopes are properly validated
  forall manifest: WorktreeManifest
  assert validate_write_scopes(manifest.write_scopes) == true
}

invariant forbidden_operation_prevention {
  -- Forbidden operations are blocked
  forall manifest: WorktreeManifest
  forall op: manifest.forbidden
  assert enforce_forbidden_operations(manifest, op) == false
}

invariant traceability_compliance {
  -- Every manifest links to an issue (L1 TRACEABILITY)
  forall manifest: WorktreeManifest
  assert manifest.issue > 0
}

invariant generation_compliance {
  -- All manifests are generated, not hand-edited (L2 GENERATION)
  forall manifest: WorktreeManifest
  assert manifest.created_ts != ""
  assert manifest.created_ts <= manifest.modified_ts or manifest.modified_ts == ""
}

invariant purity_compliance {
  -- All identifiers are ASCII-only (L3 PURITY)
  forall manifest: WorktreeManifest
  assert ascii_only(manifest.title)
  assert ascii_only(manifest.agent)
  assert ascii_only(manifest.branch)
}

invariant testability_compliance {
  -- Every spec has test/invariant/bench (L4 TESTABILITY)
  assert len(test_blocks) > 0 or len(invariant_blocks) > 0 or len(bench_blocks) > 0
}

invariant identity_compliance {
  -- Trinity identity holds (L5 IDENTITY)
  assert PHI * PHI + 1.0 / (PHI * PHI) == TRINITY
}

invariant ceiling_compliance {
  -- Format compliance with GF16 standard (L6 CEILING)
  forall manifest: WorktreeManifest
  assert manifest.issue < 16777216  -- 2^24 for GF16
  assert len(manifest.title) <= 256
  assert len(manifest.agent) <= 64
}

invariant unity_compliance {
  -- No shell scripts on critical path (L7 UNITY)
  forall cmd: string in ["worktree_create", "worktree_verify", "worktree_checkpoint"]
  assert not contains(cmd, ".sh")
}