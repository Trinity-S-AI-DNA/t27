spec TRI_WORKTREE_ARCHITECTURE_001

-- Phase 1: Worktree Core System (create/list/verify/checkpoint)
-- Invariant Laws: L1 TRACEABILITY, L2 GENERATION, L3 PURITY, L4 TESTABILITY, L5 IDENTITY, L6 CEILING, L7 UNITY
-- TDD Mandate: All specs must contain test/invariant/bench blocks

numericformat gf16 tf3

-- Trinity constants (L5 identity law)
pub const PHI f64 = 1.6180339887498948482
pub const TRINITY f64 = 3.0

-- Core Worktree Types
pub const WorktreeStatus enum(string) {
  pending = "pending",
  active = "active", 
  checkpoint = "checkpoint",
  completed = "completed",
  failed = "failed"
}

pub const VerificationType enum(string) {
  syntax = "syntax",
  typecheck = "typecheck",
  test = "test",
  anomaly_scan = "anomaly_scan",
  merge_guard = "merge_guard"
}

-- Worktree DNA Manifest Schema
struct WorktreeManifest {
  issue i32: required
  title string: required
  agent string: required
  base string: required
  worktree string: required
  branch string: required
  write_scopes []string: required
  read_scopes []string: required
  forbidden []string: required
  verification []VerificationType: required
  definition_of_done []string: required
  created_ts string: required
  modified_ts string: optional
  status WorktreeStatus: required
  commit_hash string: optional
  merge_guard_status string: optional
}

-- Core Worktree Commands (CLI interface)
pub fn tri_worktree_create(issue i32, title string, agent string, write_scopes []string) -> WorktreeManifest
pub fn tri_worktree_list() -> []WorktreeManifest  
pub fn tri_worktree_verify(issue i32) -> VerificationResult
pub fn tri_worktree_checkpoint(issue i27) -> WorktreeManifest
pub fn tri_worktree_status(issue i32) -> WorktreeStatus

pub fn tri_issue_claim(issue i32, agent string) -> WorktreeManifest
pub fn tri_issue_progress(issue i32, message string) -> ProgressEvent
pub fn tri_issue_complete(issue i32, evidence []string) -> CompletionEvent

pub fn tri_pr_prepare(issue i32) -> PRManifest
pub fn tri_pr_guard(pr i32) -> GuardResult
pub fn tri_pr_merge(pr i32, when_green bool) -> MergeResult

-- Result Types
struct VerificationResult {
  issue i32: required
  passed bool: required
  details map[string]: required
  timestamp string: required
}

struct ProgressEvent {
  issue i32: required
  agent string: required
  message string: required
  timestamp string: required
}

struct CompletionEvent {
  issue i32: required
  evidence []string: required
  completion_ts string: required
  manifest WorktreeManifest: required
}

struct PRManifest {
  issue i32: required
  pr i32: required
  branch string: required
  title string: required
  status string: required
  checks []string: required
}

struct GuardResult {
  pr i32: required
  allowed bool: required
  reasons []string: required
}

struct MergeResult {
  pr i32: required
  success bool: required
  commit_hash string: required
  error string: optional
}

-- 7 Invariant Laws Integration
invariant worktree_manifest_completeness {
  -- Every worktree must have complete manifest data
  forall manifest: WorktreeManifest
  assert manifest.issue > 0
  assert manifest.title != ""
  assert manifest.agent != ""
  assert manifest.base != ""
  assert manifest.branch != ""
  assert len(manifest.write_scopes) > 0
  assert len(manifest.verification) > 0
  assert len(manifest.definition_of_done) > 0
}

invariant scope_isolation {
  -- Write scopes must not overlap with forbidden operations
  forall manifest: WorktreeManifest
  forall forbidden: manifest.forbidden
  assert not contains(forbidden, "force-push") or not contains(forbidden, "primary-checkout-edit")
}

invariant traceability_enforcement {
  -- Every worktree must link to an issue (L1)
  forall manifest: WorktreeManifest
  assert manifest.issue > 0
}

-- Tests (TDD Mandate)
.test worktree_create_verify_isolation
  given issue = 123
  given title = "Fix provider routing mismatch"
  given agent = "repair-agent"
  given write_scopes = ["packages/llm/**/provider-routing/**"]
  when manifest = tri_worktree_create(issue, title, agent, write_scopes)
  then manifest.issue == issue
  then manifest.title == title
  then manifest.agent == agent
  then len(manifest.write_scopes) == 1
  then contains(manifest.write_scopes[0], "provider-routing")
  then manifest.status == WorktreeStatus.pending

.test worktree_list_returns_manifests
  when manifests = tri_worktree_list()
  then len(manifests) >= 0
  then all manifest: manifests -> manifest.issue > 0

.test worktree_verify_validation
  given issue = 123
  when result = tri_worktree_verify(issue)
  then result.issue == issue
  then result.passed == true or result.passed == false
  then len(result.details) > 0

.test worktree_checkpoint_preserves_data
  given issue = 123
  when manifest = tri_worktree_checkpoint(issue)
  then manifest.status == WorktreeStatus.checkpoint
  then manifest.modified_ts != ""

.test issue_claim_assignment
  given issue = 123
  given agent = "repair-agent"
  when manifest = tri_issue_claim(issue, agent)
  then manifest.issue == issue
  then manifest.agent == agent
  then manifest.status == WorktreeStatus.active

.test progress_event_recording
  given issue = 123
  given message = "Fixed provider routing logic"
  when event = tri_issue_progress(issue, message)
  then event.issue == issue
  then event.message == message
  then event.agent == "repair-agent"

.test pr_guard_validation
  given pr = 456
  when result = tri_pr_guard(pr)
  then result.pr == pr
  then result.allowed == true or result.allowed == false
  then len(result.reasons) >= 0

-- Benchmarks (Performance Requirements)
.bench worktree_create_latency
  target: < 1000ms
  measure:
    loop 10: tri_worktree_create(123, "Benchmark Test", "repair-agent", ["test/**"])

.bench worktree_list_throughput  
  target: < 50ms for 100 manifests
  measure:
    create 100 manifests with tri_worktree_create
    measure: tri_worktree_list()

-- Invariant: Scope Enforcement (Critical Safety)
invariant write_scope_isolation {
  -- No worktree can modify primary checkout
  forall manifest: WorktreeManifest
  assert not contains(manifest.write_scopes, "*") or not contains(manifest.forbidden, "primary-checkout-edit")
}

invariant no_force_push_protection {
  -- Force push protection is enforced
  forall manifest: WorktreeManifest
  assert contains(manifest.forbidden, "force-push")
}

-- Golden Format Compliance (L6 CEILING)
invariant golden_format_compliance {
  -- All manifests use GF16 formatting
  forall manifest: WorktreeManifest
  assert manifest.issue > 0 and manifest.issue < 16777216  -- 2^24 for GF16 range
  assert len(manifest.title) <= 256
  assert len(manifest.agent) <= 64
}

-- Unity Compliance (L7 NO-NEW-SHELL)
invariant shell_command_integration {
  -- All commands use tri/t27c, not shell scripts
  forall cmd: string in ["tri worktree create", "tri worktree list", "tri worktree verify"]
  assert not contains(cmd, "*.sh")
}