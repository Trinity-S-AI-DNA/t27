// t27/specs/worktree/worktree_manifest.t27
// Worktree manifest specification for TRI Worktree OS | φ² + 1/φ² = 3 | TRINITY

module WorktreeManifest;
    use base::types;
    use io::file;
    use json::parse;
    use hash::sha256;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const MANIFEST_VERSION : u32 = 1_0000; // 1.0.0
    const WORKTREE_PREFIX : []const u8 = "../tri-wt-";
    const BRANCH_PREFIX : []const u8 = "tri/";
    const MANIFEST_FILENAME : []const u8 = "worktree_manifest.json";
    const CHECKPOINT_DIR : []const u8 = ".wt/checkpoints";
    const EVIDENCE_DIR : []const u8 = ".wt/evidence";

    // ═══════════════════════════════════════════════════════════
    // 2. Core Types
    // ═══════════════════════════════════════════════════════════

    pub const WorktreeManifest = struct {
        manifest_version : u32,
        issue : u32,
        title : []const u8,
        agent : []const u8,
        base : []const u8,
        worktree_path : []const u8,
        branch : []const u8,
        write_scopes : []const u8,
        read_scopes : []const u8,
        forbidden_operations : []const u8,
        verification_commands : []const u8,
        definition_of_done : []const u8,
        created_at : []const u8,
        last_updated : []const u8,
        status : WorktreeStatus,
        hash : []const u8, // SHA256 of manifest content
        verification_history : []const VerificationRecord,
        last_checkpoint : []const Checkpoint,
    };

    pub const WorktreeStatus = enum {
        created,
        active,
        checkpointed,
        verified,
        pr_prepared,
        merged,
        cleanup,
        failed,
    };

    pub const Checkpoint = struct {
        checkpoint_id : []const u8,
        timestamp : []const u8,
        diff_summary : []const u8,
        test_status : TestStatus,
        open_questions : []const u8,
        resume_brief : []const u8,
        hash : []const u8,
        evidence_ids : []const u8,
        verification_results : []const VerificationResult,
    };

    pub const VerificationRecord = struct {
        verification_id : []const u8,
        timestamp : []const u8,
        command : []const u8,
        verdict : VerificationVerdict,
        evidence_collected : []const u8,
        issues_found : []const VerificationIssue,
        quality_gate_passed : bool,
    };

    pub const VerificationResult = struct {
        check_type : VerificationCheckType,
        status : VerificationStatus,
        details : []const u8,
        evidence_hash : []const u8,
    };

    pub const VerificationIssue = struct {
        severity : VerificationSeverity,
        category : VerificationCategory,
        description : []const u8,
        file_path : []const u8,
        line_number : u32,
        suggestion : []const u8,
    };

    pub const VerificationVerdict = enum {
        pass,
        warning,
        fail,
        blocked,
    };

    pub const VerificationStatus = enum {
        pending,
        running,
        passed,
        failed,
        skipped,
    };

    pub const VerificationSeverity = enum {
        info,
        warning,
        error,
        critical,
    };

    pub const VerificationCategory = enum {
        isolation,
        scope,
        evidence,
        quality,
        merge_safety,
        operation_safety,
    };

    pub const VerificationCheckType = enum {
        worktree_isolation,
        write_scope_enforcement,
        read_scope_validation,
        evidence_completeness,
        quality_gate_check,
        forbidden_operation_scan,
        merge_guard,
        checkpoint_integrity,
    };

    pub const TestStatus = struct {
        passed : u32,
        failed : u32,
        total : u32,
        is_green : bool,
    };

    pub const Evidence = struct {
        evidence_id : []const u8,
        type : EvidenceType,
        timestamp : []const u8,
        content : []const u8,
        verification_hash : []const u8,
    };

    pub const EvidenceType = enum {
        test_results,
        typecheck,
        anomaly_scan,
        merge_guard,
        completion_criteria,
        worktree_isolation,
        scope_enforcement,
        quality_gate,
        checkpoint,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Worktree Operations
    // ═══════════════════════════════════════════════════════════

    pub fn create_manifest(
        issue : u32,
        title : []const u8,
        agent : []const u8,
        base : []const u8,
        write_scopes : []const u8,
        read_scopes : []const u8,
        verification_commands : []const u8,
        definition_of_done : []const u8,
    ) !WorktreeManifest {
        const worktree_path = generate_worktree_path(issue, title);
        const branch = generate_branch(issue, title);
        const timestamp = get_timestamp();
        const hash = generate_hash(title);

        return WorktreeManifest{
            .manifest_version = MANIFEST_VERSION,
            .issue = issue,
            .title = title,
            .agent = agent,
            .base = base,
            .worktree_path = worktree_path,
            .branch = branch,
            .write_scopes = write_scopes,
            .read_scopes = read_scopes,
            .forbidden_operations = getDefaultForbiddenOperations(),
            .verification_commands = verification_commands,
            .definition_of_done = definition_of_done,
            .created_at = timestamp,
            .last_updated = timestamp,
            .status = .created,
            .hash = hash,
        };
    }

    pub fn save_manifest(manifest : *WorktreeManifest, worktree_dir : []const u8) !void {
        const manifest_path = std.fmt.allocPrint(allocator, "{s}/{s}", .{worktree_dir, MANIFEST_FILENAME}) catch return error.OutOfMemory;
        const json_content = serialize_manifest(manifest) catch return error.SerializationError;
        
        file.write(manifest_path, json_content) catch return error.FileWriteError;
    }

    pub fn load_manifest(worktree_dir : []const u8) !WorktreeManifest {
        const manifest_path = std.fmt.allocPrint(allocator, "{s}/{s}", .{worktree_dir, MANIFEST_FILENAME}) catch return error.OutOfMemory;
        const json_content = file.read(manifest_path) catch return error.FileReadError;
        
        const parsed = parse(json_content) catch return error.JsonParseError;
        return deserialize_manifest(parsed) catch return error.DeserializationError;
    }

    pub fn update_manifest_status(manifest : *WorktreeManifest, new_status : WorktreeStatus) !void {
        manifest.status = new_status;
        manifest.last_updated = get_timestamp();
        const hash = generate_manifest_hash(manifest);
        manifest.hash = hash;
    }

    // ═══════════════════════════════════════════════════════════
    // 4. Helper Functions
    // ═══════════════════════════════════════════════════════════

    fn generate_worktree_path(issue : u32, title : []const u8) []const u8 {
        const sanitized_title = sanitize_for_path(title);
        return std.fmt.allocPrint(allocator, "{s}{d}-{s}", .{WORKTREE_PREFIX, issue, sanitized_title}) catch unreachable;
    }

    fn generate_branch(issue : u32, title : []const u8) []const u8 {
        const sanitized_title = sanitize_for_path(title);
        return std.fmt.allocPrint(allocator, "{s}{d}-{s}", .{BRANCH_PREFIX, issue, sanitized_title}) catch unreachable;
    }

    fn getDefaultForbiddenOperations() []const u8 {
        return "force-push,primary-checkout-edit,shared-worktree,blind-merge";
    }

    fn generate_hash(content : []const u8) []const u8 {
        return sha256(content);
    }

    fn generate_manifest_hash(manifest : *WorktreeManifest) []const u8 {
        const serialized = serialize_manifest(manifest) catch unreachable;
        return sha256(serialized);
    }

    fn sanitize_for_path(title : []const u8) []const u8 {
        // Replace spaces and special chars with hyphens
        var sanitized = std.ArrayList(u8).init(allocator);
        defer sanitized.deinit();

        for (title) |c| {
            if (is_alphanumeric(c)) {
                sanitized.append(c) catch unreachable;
            } else {
                sanitized.append('-') catch unreachable;
            }
        }
        return sanitized.toOwnedSlice() catch unreachable;
    }

    fn get_timestamp() []const u8 {
        const now = std.time.timestamp();
        return std.fmt.allocPrint(allocator, "%d", .{now}) catch unreachable;
    }

    // ═══════════════════════════════════════════════════════════
    // 5. Validation Functions
    // ═══════════════════════════════════════════════════════════

    // ═══════════════════════════════════════════════════════════
    // 6. Verification Functions
    // ═══════════════════════════════════════════════════════════

    pub fn verify_worktree_isolation(manifest : *WorktreeManifest, current_branch : []const u8, current_dir : []const u8) VerificationResult {
        // Ensure worktree is not on primary checkout
        if (std.mem.eql(u8, current_branch, manifest.base)) {
            return VerificationResult{
                .check_type = .worktree_isolation,
                .status = .failed,
                .details = "Worktree is on primary checkout branch - unsafe operation detected",
                .evidence_hash = generate_hash("primary-checkout-error"),
            };
        }
        
        // Ensure worktree branch is correct
        if (!std.mem.eql(u8, current_branch, manifest.branch)) {
            return VerificationResult{
                .check_type = .worktree_isolation,
                .status = .failed,
                .details = std.fmt.allocPrint(allocator, "Wrong branch: expected {s}, got {s}", .{manifest.branch, current_branch}) catch unreachable,
                .evidence_hash = generate_hash("wrong-branch-error"),
            };
        }
        
        // Ensure current directory is within worktree path
        if (!std.mem.startsWith(u8, current_dir, manifest.worktree_path)) {
            return VerificationResult{
                .check_type = .worktree_isolation,
                .status = .failed,
                .details = std.fmt.allocPrint(allocator, "Not in worktree directory: expected {s}, got {s}", .{manifest.worktree_path, current_dir}) catch unreachable,
                .evidence_hash = generate_hash("wrong-directory-error"),
            };
        }
        
        return VerificationResult{
            .check_type = .worktree_isolation,
            .status = .passed,
            .details = "Worktree isolation verification passed",
            .evidence_hash = generate_hash("isolation-pass"),
        };
    }

    pub fn verify_write_scope(manifest : *WorktreeManifest, file_path : []const u8) VerificationResult {
        var matched_scope = []const u8{};
        
        for (manifest.write_scopes) |scope| {
            if (match_file_scope(file_path, scope)) {
                matched_scope = scope;
                break;
            }
        }
        
        if (matched_scope.len > 0) {
            return VerificationResult{
                .check_type = .write_scope_enforcement,
                .status = .passed,
                .details = std.fmt.allocPrint(allocator, "File {s} matches allowed scope {s}", .{file_path, matched_scope}) catch unreachable,
                .evidence_hash = generate_hash("scope-pass"),
            };
        } else {
            return VerificationResult{
                .check_type = .write_scope_enforcement,
                .status = .failed,
                .details = std.fmt.allocPrint(allocator, "File {s} not in allowed write scopes: {s}", .{file_path, std.mem.join(u8, ", ", manifest.write_scopes)}) catch unreachable,
                .evidence_hash = generate_hash("scope-fail"),
            };
        }
    }

    pub fn verify_read_scope(manifest : *WorktreeManifest, file_path : []const u8) VerificationResult {
        for (manifest.read_scopes) |scope| {
            if (match_file_scope(file_path, scope)) {
                return VerificationResult{
                    .check_type = .read_scope_validation,
                    .status = .passed,
                    .details = std.fmt.allocPrint(allocator, "File {s} matches allowed read scope {s}", .{file_path, scope}) catch unreachable,
                    .evidence_hash = generate_hash("read-scope-pass"),
                };
            }
        }
        
        return VerificationResult{
            .check_type = .read_scope_validation,
            .status = .failed,
            .details = std.fmt.allocPrint(allocator, "File {s} not in allowed read scopes", .{file_path}) catch unreachable,
            .evidence_hash = generate_hash("read-scope-fail"),
        };
    }

    pub fn verify_forbidden_operations(manifest : *WorktreeManifest, git_operations : []const u8) []const VerificationIssue {
        var issues = []const VerificationIssue{};
        
        for (manifest.forbidden_operations) |op| {
            if (std.mem.contains(u8, git_operations, op)) {
                const issue = VerificationIssue{
                    .severity = .error,
                    .category = .operation_safety,
                    .description = std.fmt.allocPrint(allocator, "Forbidden operation detected: {s}", .{op}) catch unreachable,
                    .file_path = "git operations",
                    .line_number = 0,
                    .suggestion = std.fmt.allocPrint(allocator, "Remove {s} from operations", .{op}) catch unreachable,
                };
                issues.append(issue) catch unreachable;
            }
        }
        
        return issues;
    }

    pub fn collect_verification_evidence(manifest : *WorktreeManifest, verification_id : []const u8) Evidence {
        const timestamp = get_timestamp();
        const evidence_content = serialize_verification_evidence(manifest) catch unreachable;
        
        return Evidence{
            .evidence_id = verification_id,
            .type = .worktree_isolation,
            .timestamp = timestamp,
            .content = evidence_content,
            .verification_hash = generate_hash(evidence_content),
        };
    }

    pub fn verify_evidence_completeness(manifest : *WorktreeManifest) VerificationResult {
        const required_evidence = []const EvidenceType{.test_results, .typecheck, .merge_guard};
        var missing_evidence = []const EvidenceType{};
        
        for (required_evidence) |req_type| {
            var found = false;
            for (manifest.verification_history) |record| {
                if (record.verdict == .pass or record.verdict == .warning) {
                    found = true;
                    break;
                }
            }
            if (!found) {
                missing_evidence.append(req_type) catch unreachable;
            }
        }
        
        if (missing_evidence.len == 0) {
            return VerificationResult{
                .check_type = .evidence_completeness,
                .status = .passed,
                .details = "All required evidence collected",
                .evidence_hash = generate_hash("evidence-complete"),
            };
        } else {
            const missing_list = std.mem.join(u8, ", ", missing_evidence) catch unreachable;
            return VerificationResult{
                .check_type = .evidence_completeness,
                .status = .failed,
                .details = std.fmt.allocPrint(allocator, "Missing evidence: {s}", .{missing_list}) catch unreachable,
                .evidence_hash = generate_hash("evidence-incomplete"),
            };
        }
    }

    fn serialize_verification_evidence(manifest : *WorktreeManifest) []const u8 {
        const evidence_data = std.json.stringify(.{
            .manifest = manifest,
            .timestamp = get_timestamp(),
            .verification_type = "worktree_isolation",
        }, .{}) catch unreachable;
        return evidence_data;
    }

    fn match_file_scope(file_path : []const u8, scope : []const u8) bool {
        // Implement glob-style matching
        // For now, simple prefix matching
        return std.mem.startsWith(u8, file_path, scope);
    }

    fn match_file_scope(file_path : []const u8, scope : []const u8) bool {
        // Implement glob-style matching
        // For now, simple prefix matching
        return std.mem.startsWith(u8, file_path, scope);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    .test
        ; test_create_manifest_basic
        ; Verify: Basic manifest creation works
        ; Setup: issue=123, title="Fix provider routing", agent="repair-agent"
        ; Expected: manifest created with correct fields

        const manifest = create_manifest(
            123,
            "Fix provider routing mismatch",
            "repair-agent",
            "origin/main",
            []const u8{"packages/llm/**/provider-routing/**"},
            []const u8{"**"},
            []const u8{"pnpm typecheck", "pnpm test", "tri anomaly scan"},
            []const u8{"routing test proves z.ai is primary", "no silent DeepSeek fallback", "CI green"},
        ) catch unreachable;

        assert manifest.issue == 123;
        assert std.mem.eql(u8, manifest.title, "Fix provider routing mismatch");
        assert std.mem.eql(u8, manifest.agent, "repair-agent");
        assert std.mem.eql(u8, manifest.base, "origin/main");
        assert manifest.status == .created;

    .test
        ; test_worktree_path_generation
        ; Verify: Worktree path generation sanitizes properly
        ; Setup: issue=123, title="Fix provider routing mismatch"
        ; Expected: path contains sanitized title

        const path = generate_worktree_path(123, "Fix provider routing mismatch");
        assert std.mem.eql(u8, path, "../tri-wt-123-fix-provider-routing-mismatch");

    .test
        ; test_branch_generation
        ; Verify: Branch generation sanitizes properly
        ; Setup: issue=123, title="Fix provider routing mismatch"
        ; Expected: branch contains sanitized title

        const branch = generate_branch(123, "Fix provider routing mismatch");
        assert std.mem.eql(u8, branch, "tri/123-fix-provider-routing-mismatch");

    .test
        ; test_write_scope_validation
        ; Verify: Write scope validation works
        ; Setup: manifest with packages/llm/** scope, test file_path
        ; Expected: correct scope matching

        const manifest = create_manifest(
            123,
            "Fix provider routing",
            "repair-agent", 
            "origin/main",
            []const u8{"packages/llm/**/provider-routing/**"},
            []const u8{"**"},
            []const u8{}, // Empty for test
            []const u8{}, // Empty for test
        ) catch unreachable;

        const valid_file = "packages/llm/api/provider-routing/test.ts";
        const invalid_file = "packages/backend/server.ts";
        
        assert validate_write_scope(&manifest, valid_file) == true;
        assert validate_write_scope(&manifest, invalid_file) == false;

    .test
        ; test_worktree_isolation_validation
        ; Verify: Worktree isolation prevents unsafe operations
        ; Setup: manifest with branch tri/123-test, current branch origin/main
        ; Expected: isolation validation passes correctly

        const manifest = create_manifest(
            123,
            "Test worktree",
            "repair-agent",
            "origin/main",
            []const u8{"**"},
            []const u8{"**"},
            []const u8{},
            []const u8{},
        ) catch unreachable;

        const safe_branch = "tri/123-test";
        const unsafe_branch = "origin/main";
        
        assert validate_worktree_isolation(&manifest, safe_branch, "/some/worktree/path") == true;
        assert validate_worktree_isolation(&manifest, unsafe_branch, "/some/worktree/path") == false;

    .invariant
        ; manifest_hash_consistency
        ; All manifests have valid SHA256 hashes
        ; Rationale: Ensures manifest integrity and prevents tampering

        invariant forall manifest: WorktreeManifest {
            !std.mem.eql(u8, manifest.hash, "") and
            validate_hash(manifest.hash)
        }

    .invariant
        ; worktree_path_safety
        ; Worktree paths don't contain dangerous characters
        ; Rationale: Prevents path injection attacks

        invariant forall manifest: WorktreeManifest {
            !contains_dangerous_chars(manifest.worktree_path) and
            !contains_dangerous_chars(manifest.branch)
        }

    .bench
        ; bench_manifest_serialization
        ; Measure: Time to serialize/deserialize 100 manifests
        ; Target: < 100ms on typical hardware
        ; Setup: Create 100 manifests with random data
        ; Operation: Serialize and deserialize each

        var manifests = [100]WorktreeManifest{};
        for (0..100) |i| {
            manifests[i] = create_manifest(
                @as(u32, i),
                "Test title",
                "test-agent",
                "origin/main",
                []const u8{"packages/**"},
                []const u8{"**"},
                []const u8{"pnpm test"},
                []const u8{"CI green"},
            ) catch unreachable;
        }

        const start = std.time.timestamp();
        for (manifests) |*manifest| {
            const serialized = serialize_manifest(manifest) catch unreachable;
            const _ = deserialize_manifest(parse(serialized) catch unreachable) catch unreachable;
        }
        const duration = @intCast(u64, std.time.timestamp() - start);
        assert duration < 100; // ms

    .test
        ; test_verification_worktree_isolation
        ; Verify: Worktree isolation verification works correctly
        ; Setup: manifest with branch tri/123-test, current branch origin/main
        ; Expected: isolation validation passes correctly

        const manifest = create_manifest(
            123,
            "Test worktree",
            "repair-agent",
            "origin/main",
            []const u8{"**"},
            []const u8{"**"},
            []const u8{},
            []const u8{},
        ) catch unreachable;

        const result = verify_worktree_isolation(
            &manifest, 
            "tri/123-test", 
            "/some/worktree/path"
        );
        
        assert result.status == .passed;
        assert std.mem.contains(u8, result.details, "passed");

    .test
        ; test_verification_write_scope
        ; Verify: Write scope verification works correctly
        ; Setup: manifest with packages/llm/** scope, test file_path
        ; Expected: scope validation passes for valid files, fails for invalid

        const manifest = create_manifest(
            123,
            "Fix provider routing",
            "repair-agent", 
            "origin/main",
            []const u8{"packages/llm/**/provider-routing/**"},
            []const u8{"**"},
            []const u8{}, // Empty for test
            []const u8{}, // Empty for test
        ) catch unreachable;

        const valid_result = verify_write_scope(&manifest, "packages/llm/api/provider-routing/test.ts");
        const invalid_result = verify_write_scope(&manifest, "packages/backend/server.ts");
        
        assert valid_result.status == .passed;
        assert invalid_result.status == .failed;

    .test
        ; test_verification_evidence_completeness
        ; Verify: Evidence completeness check works
        ; Setup: manifest with incomplete evidence history
        ; Expected: detects missing evidence correctly

        const manifest = create_manifest(
            123,
            "Evidence test",
            "repair-agent",
            "origin/main",
            []const u8{"**"},
            []const u8{"**"},
            []const u8{},
            []const u8{},
        ) catch unreachable;

        const result = verify_evidence_completeness(&manifest);
        // This should fail since we haven't added any verification history yet
        assert result.status == .failed;

    .invariant
        ; verification_result_consistency
        ; All verification results have valid status and evidence hashes
        ; Rationale: Ensures verification integrity and prevents tampering

        invariant forall result: VerificationResult {
            (result.status == .passed or result.status == .failed or 
             result.status == .skipped or result.status == .pending) and
            (result.evidence_hash.len > 0)
        }

    .invariant
        ; evidence_uniqueness
        ; Evidence IDs are unique and non-empty
        ; Rationale: Prevents evidence collision and ensures traceability

        invariant forall evidence: Evidence {
            evidence.evidence_id.len > 0 and
            validate_hash(evidence.verification_hash)
        }

    .bench
        ; bench_verification_isolation
        ; Measure: Time to run 1000 isolation checks
        ; Target: < 100ms on typical hardware
        ; Setup: Create manifest, run isolation validation 1000 times
        ; Operation: Verify isolation with same manifest

        const manifest = create_manifest(
            123,
            "Benchmark isolation",
            "test-agent",
            "origin/main",
            []const u8{"**"},
            []const u8{"**"},
            []const u8{},
            []const u8{},
        ) catch unreachable;

        const start = std.time.timestamp();
        for (0..1000) |i| {
            const result = verify_worktree_isolation(&manifest, "tri/123-test", "/test/path");
            _ = result; // Use result to prevent optimization
        }
        const duration = @intCast(u64, std.time.timestamp() - start);
        assert duration < 100; // ms

    .bench
        ; bench_scope_validation_large
        ; Measure: Time to validate 10000 file paths against scopes
        ; Target: < 200ms on typical hardware
        ; Setup: Create manifest with 20 scopes, 10000 file paths
        ; Operation: Validate each file path against scopes

        const manifest = create_manifest(
            123,
            "Large scope test",
            "test-agent",
            "origin/main",
            []const u8{"packages/llm/**", "packages/api/**", "packages/utils/**", "tests/**", "docs/**"},
            []const u8{"**"},
            []const u8{},
            []const u8{},
        ) catch unreachable;

        var file_paths = [10000][]const u8{};
        for (0..10000) |i| {
            file_paths[i] = std.fmt.allocPrint(allocator, "packages/test/file%d.ts", .{i}) catch unreachable;
        }

        const start = std.time.timestamp();
        for (file_paths) |path| {
            _ = verify_write_scope(&manifest, path);
        }
        const duration = @intCast(u64, std.time.timestamp() - start);
        assert duration < 200; // ms