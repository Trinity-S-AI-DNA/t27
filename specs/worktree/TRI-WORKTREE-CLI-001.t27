spec TRI_WORKTREE_CLI_001

-- Phase 1: CLI Command Interface
-- TDD Mandate: All specs must contain test/invariant/bench blocks
-- Invariant Laws: L1-7 Compliance

numericformat gf16 tf3

-- Trinity constants (L5 identity law)
pub const PHI f64 = 1.6180339887498948482
pub const TRINITY f64 = 3.0

-- CLI Command Definitions
struct CLICommand {
  name string: required
  args []string: required
  description string: required
  requires_issue bool: required
  requires_pr bool: required
  manager WorktreeManager: required
}

struct CLIResult {
  success bool: required
  output string: required
  error string: optional
  exit_code i32: required
}

-- CLI Command Implementations
pub fn tri_worktree_create(args []string) -> CLIResult
pub fn tri_worktree_enter(args []string) -> CLIResult
pub fn tri_worktree_status(args []string) -> CLIResult
pub fn tri_worktree_list(args []string) -> CLIResult
pub fn tri_worktree_verify(args []string) -> CLIResult
pub fn tri_worktree_checkpoint(args []string) -> CLIResult
pub fn tri_worktree_handoff(args []string) -> CLIResult
pub fn tri_worktree_cleanup(args []string) -> CLIResult

pub fn tri_issue_claim(args []string) -> CLIResult
pub fn tri_issue_progress(args []string) -> CLIResult
pub fn tri_issue_complete(args []string) -> CLIResult

pub fn tri_pr_prepare(args []string) -> CLIResult
pub fn tri_pr_guard(args []string) -> CLIResult
pub fn tri_pr_merge(args []string) -> CLIResult

-- CLI Helper Functions
pub fn parse_issue_args(args []string) -> (i32, bool)
pub fn parse_pr_args(args []string) -> (i32, bool)
pub fn validate_issue_number(issue i32) -> bool
pub fn validate_pr_number(pr i32) -> bool
pub fn format_manifest_output(manifest WorktreeManifest) -> string
pub fn format_verification_result(result VerificationResult) -> string

-- Result Types (from architecture spec)
struct WorktreeManifest {
  issue i32: required
  title string: required
  agent string: required
  base string: required
  worktree string: required
  branch string: required
  write_scopes []string: required
  read_scopes []string: required
  forbidden []string: required
  verification []VerificationType: required
  definition_of_done []string: required
  created_ts string: required
  modified_ts string: optional
  status WorktreeStatus: required
  commit_hash string: optional
  merge_guard_status string: optional
}

struct VerificationResult {
  issue i32: required
  passed bool: required
  details map[string]: required
  timestamp string: required
}

pub const WorktreeStatus enum(string) {
  pending = "pending",
  active = "active", 
  checkpoint = "checkpoint",
  completed = "completed",
  failed = "failed"
}

pub const VerificationType enum(string) {
  syntax = "syntax",
  typecheck = "typecheck", 
  test = "test",
  anomaly_scan = "anomaly_scan",
  merge_guard = "merge_guard"
}

-- Tests (TDD Mandate)
.test tri_worktree_create_parsing
  given args = ["--issue", "123", "--title", "Fix provider routing", "--agent", "repair-agent"]
  when result = tri_worktree_create(args)
  then result.success == true
  then result.exit_code == 0
  then contains(result.output, "tri/123-fix-provider-routing")

.test tri_worktree_list_output_format
  given args = []
  when result = tri_worktree_list(args)
  then result.success == true or result.success == false
  then result.exit_code == 0 or result.exit_code == 1

.test tri_worktree_status_issue_lookup
  given args = ["--issue", "123"]
  when result = tri_worktree_status(args)
  then result.success == true or result.success == false
  then contains(result.output, "123") or result.exit_code != 0

.test tri_issue_claim_parsing
  given args = ["--issue", "456", "--agent", "test-agent"]
  when result = tri_issue_claim(args)
  then result.success == true or result.success == false
  then result.exit_code == 0 or result.exit_code != 0

.test tri_pr_guard_validation
  given args = ["--pr", "789"]
  when result = tri_pr_guard(args)
  then result.success == true or result.success == false
  then result.exit_code == 0 or result.exit_code != 0

.test parse_issue_args_success
  given args = ["--issue", "123"]
  when (issue, valid) = parse_issue_args(args)
  then issue == 123
  then valid == true

.test parse_issue_args_failure
  given args = ["--issue", "invalid"]
  when (issue, valid) = parse_issue_args(args)
  then valid == false

.test validate_issue_number_range
  when valid1 = validate_issue_number(123)
  when valid2 = validate_issue_number(0)
  when valid3 = validate_issue_number(-1)
  then valid1 == true
  then valid2 == false
  then valid3 == false

.test format_manifest_output_structure
  given manifest = WorktreeManifest{
    issue: 123,
    title: "Test Title",
    agent: "test-agent",
    status: WorktreeStatus.active,
    branch: "tri/123-test"
  }
  when output = format_manifest_output(manifest)
  then contains(output, "123")
  then contains(output, "Test Title")
  then contains(output, "test-agent")
  then contains(output, "active")

-- Benchmarks (CLI Performance)
.bench cli_command_parsing_latency
  target: < 50ms
  measure:
    loop 100: parse_issue_args(["--issue", "123"])

.bench tri_worktree_list_throughput
  target: < 100ms for 10 worktrees
  measure:
    create 10 test manifests
    when result = tri_worktree_list([])
    cleanup 10 test manifests

-- Invariants (CLI Safety)
invariant argument_validation {
  -- All CLI arguments are properly validated
  forall args: []string
  forall cmd: CLICommand using args
  when cmd.requires_issue
  then parse_issue_args(args).valid == true
}

invariant traceability_enforcement {
  -- Every command that modifies state requires issue/pr (L1 TRACEABILITY)
  forall result: CLIResult
  when result.success == true and contains(result.output, "Created") or contains(result.output, "Updated")
  then contains(result.output, "issue") or contains(result.output, "pr")
}

invariant output_format_consistency {
  -- CLI outputs are consistently formatted
  forall manifest: WorktreeManifest
  when output = format_manifest_output(manifest)
  then contains(output, string(manifest.issue))
  then contains(output, manifest.status)
}

invariant command_isolation {
  -- Commands cannot interfere with each other
  forall cmd1, cmd2: CLICommand
  when cmd1.name != cmd2.name
  then cmd1.manager != cmd2.manager or cmd1.manager.root_path == cmd2.manager.root_path
}

-- Core Invariant Laws Compliance
invariant purity_compliance {
  -- All CLI identifiers and outputs are ASCII-only (L3 PURITY)
  forall manifest: WorktreeManifest
  assert ascii_only(format_manifest_output(manifest))
}

invariant testability_compliance {
  -- CLI spec contains tests/invariants/benchmarks (L4 TESTABILITY)
  assert len(test_blocks) > 0 or len(invariant_blocks) > 0 or len(bench_blocks) > 0
}

invariant identity_compliance {
  -- Trinity identity holds in CLI constants (L5 IDENTITY)
  assert PHI * PHI + 1.0 / (PHI * PHI) == TRINITY
}

invariant ceiling_compliance {
  -- CLI outputs respect GF16 format limits (L6 CEILING)
  forall manifest: WorktreeManifest
  assert manifest.issue < 16777216  -- 2^24 for GF16
  assert len(manifest.title) <= 256
  assert len(manifest.agent) <= 64
}

invariant unity_compliance {
  -- CLI uses tri/t27c, not shell scripts (L7 UNITY)
  forall cmd: CLICommand
  assert not contains(cmd.name, ".sh")
  assert not contains(cmd.description, "shell script")
}