// SPDX-License-Identifier: Apache-2.0
; specs/fpga/wasm_doom_fb_link.t27 -- the LINK from the wasm interpreter memory to the
; DOOM framebuffer, as one spec. The pieces exist apart: wasm_interp_doom.t27 executes
; the DOOM-critical branch and memory opcodes over a linear memory, and wasm_fb.t27
; owns the 320x200 palette framebuffer and its 2x raster band. Neither file can show
; that a wasm program actually PAINTS, because that needs both: a program that stores
; palette indices into its own memory, and a presenter that turns those bytes into
; framebuffer pixels. This file is that seam.
; ----
; WHAT IT PROVES. ID_FILL16 (a real wasm loop: block, loop, br_if, br, i32.store,
; i32.add) writes 16 palette indices into interpreter memory. present_row() copies
; them into framebuffer row 0 through fb_put. The palette entry is set to a known
; colour, so fb_pixel_at answers with that colour exactly where the program drew and
; black where it did not. A row the program did not write stays black, which is the
; negative control: it proves the paint came from the program memory and not from a
; blanket fill.
; ----
; WHAT IT DOES NOT CLAIM. This is one row, not a frame: DOOM draws 200 rows of 320
; columns, and the countdown loop shape proven here is what would blit each of them.
; The presenter is spec-level, not a hardware scanout; wasm_fb.t27 owns the band and
; the scaling, and this link only demonstrates the memory-to-framebuffer direction.

module WasmDoomFbLink;

use fpga::wasm_interp_doom;
use fpga::wasm_fb;

pub const ROW_W : u32 = 16;
pub const INK : u8 = 42;
pub const INK_RGB : u32 = 0x00C81E32;

// Copy the first ROW_W bytes of interpreter memory into framebuffer row 0.
// Returns how many pixels were presented.
pub fn present_row() u32 {
    var x : u32 = 0;
    while (x < ROW_W) {
        wasm_fb::fb_put(x, wasm_interp_doom::mem_at(x));
        x = x + 1;
    }
    return ROW_W;
}

test the_program_paints_its_row {
    wasm_fb::pal_put(INK as u32, 0xC8, 0x1E, 0x32);
    wasm_fb::fb_fill(0);
    // run the wasm loop: it stores INK sixteen times, starting at address 0
    assert wasm_interp_doom::run_prog(wasm_interp_doom::ID_FILL16, 0, 0) == 16;
    assert wasm_interp_doom::last_err() == wasm_interp_doom::ERR_NONE;
    assert present_row() == ROW_W;
    // the raster is 2x scaled and lives in rows 40..439: row 0 of the frame is
    // raster row 40, and column x of the frame is raster column 2x
    assert wasm_fb::fb_pixel_at(0, wasm_fb::BAND_TOP) == INK_RGB;
    assert wasm_fb::fb_pixel_at(2 * (ROW_W - 1), wasm_fb::BAND_TOP) == INK_RGB;
    // the negative control: the pixel just past the written row stays black
    assert wasm_fb::fb_pixel_at(2 * ROW_W, wasm_fb::BAND_TOP) == 0;
    // and the second frame row was never written
    assert wasm_fb::fb_pixel_at(0, wasm_fb::BAND_TOP + 2) == 0;
}

test an_empty_memory_paints_black {
    wasm_fb::pal_put(INK as u32, 0xC8, 0x1E, 0x32);
    wasm_fb::fb_fill(0);
    // without running the program the memory is zero, so the presenter writes
    // palette index 0: the row is black even though INK is a bright colour
    assert wasm_interp_doom::mem_at(0) == 0;
    assert present_row() == ROW_W;
    assert wasm_fb::fb_pixel_at(0, wasm_fb::BAND_TOP) == 0;
}
