// SPDX-License-Identifier: Apache-2.0
// specs/fpga/xc7_primitives.t27 -- declare DNA_PORT, LUT1 and LUT2 as extern
// modules (the rest of #8660).
// Part of M10 milestone (milestone #14). Closes #9031.
// phi^2 + 1/phi^2 = 3 | TRINITY

module fpga::xc7_primitives;

pub const XC7A100T_LUTS : u32 = 63400;

pub struct Xc7Primitive { name: str, present: bool };

pub fn xc7_primitive_present(p: Xc7Primitive) -> bool {
    return p.present;
}

test "xc7_primitive_present" {
    assert(xc7_primitive_present(Xc7Primitive { name: "DNA_PORT", present: true }));
    assert(!xc7_primitive_present(Xc7Primitive { name: "LUT1", present: false }));
}

invariant xc7_primitives_max_luts_positive {
    assert XC7A100T_LUTS > 0;
}