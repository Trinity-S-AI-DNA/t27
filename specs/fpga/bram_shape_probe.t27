// SPDX-License-Identifier: Apache-2.0
; specs/fpga/bram_shape_probe.t27 -- the smallest cell that has the block-RAM shape (issue #12297)
; WHY. gen-verilog used to emit a 64 KiB `var x : [N]u8` as `reg [7:0] x[0:65535]` read and
; written inside the reset always block; yosys 0.67 answered "Replacing memory \x with list of
; registers" and spent over ten minutes in read_verilog. This probe is the shape the pass in
; specs/compiler/verilog_bram_shape.t27 recognises: one array of 64 KiB bytes, one read site
; (`rd = mem[addr]`), one write site (`mem[addr] = ...`), both addressed by a register, neither in
; a loop, the read value used a step later. The pass gives the array its own clocked process and
; yosys reads it as one memory. This is the FR-003 corpus case: `fpga-build --smoke` generates
; this file with the rest of specs/fpga, and the elaboration ratchet holds its row at 0.
; HOW TO READ IT. Command go=1 stores the low byte of v at address a, go=2 loads the byte at a.
; A store takes two steps (request, then the array write), a load takes three (request, array
; read, copy to `out`). A byte nobody wrote reads 0.
; ASCII only, English only.

module bram_shape_probe;

pub const KIND : str = "fpga-probe";
pub const ID : str = "fpga/bram_shape_probe";
pub const EPIC : str = "gHashTag/t27#12297";
pub const MEM_BYTES : u32 = 65536;

var phase : u8 = 0
var addr : u32 = 0
var val : u32 = 0
var rd : u8 = 0
var out : u8 = 0
var mem : [MEM_BYTES]u8 = [0] ** MEM_BYTES

fn step_all(go : u8, a : u32, v : u32) {
    if (phase == 0) {
        if (go == 1) {
            addr = a;
            val = v;
            phase = 1;
        }
        if (go == 2) {
            addr = a;
            phase = 2;
        }
    } else {
        if (phase == 1) {
            mem[addr] = (val & 255) as u8;
            phase = 0;
        } else {
            if (phase == 2) {
                rd = mem[addr];
                phase = 3;
            } else {
                out = rd;
                phase = 0;
            }
        }
    }
}

fn on_clock(go : u8, a : u32, v : u32) {
    step_all(go, a, v);
}

test a_stored_byte_reads_back {
    step_all(1, 100, 90);
    step_all(0, 0, 0);
    assert mem[100] == 90;
    step_all(2, 100, 0);
    step_all(0, 0, 0);
    step_all(0, 0, 0);
    assert out == 90;
    assert phase == 0;
}

test a_byte_nobody_wrote_reads_zero {
    step_all(2, 4000, 0);
    step_all(0, 0, 0);
    step_all(0, 0, 0);
    assert out == 0;
    assert mem[4000] == 0;
}

test the_store_keeps_only_the_low_byte {
    step_all(1, 7, 0x1234);
    step_all(0, 0, 0);
    assert mem[7] == 0x34;
    assert mem[8] == 0;
}

test the_last_byte_of_the_page_is_reachable {
    step_all(1, 65535, 0xAB);
    step_all(0, 0, 0);
    step_all(2, 65535, 0);
    step_all(0, 0, 0);
    step_all(0, 0, 0);
    assert out == 0xAB;
}
