                    fn_off[scrap_k] = body[20];
                    fn_np[scrap_k] = body[21];
                    fn_nl[scrap_k] = body[22];
                    fn_ty[scrap_k] = body[23];
                    res = scrap_k + 1;
                    ok_rsp();
