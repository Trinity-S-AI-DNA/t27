    r = host_run_user(6, UP_DIV0, 61, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 61;
    assert err == ERR_DIV;
    r = host_run_user(8, UP_LEB6, 62, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 62;
    assert err == ERR_LEB;
    assert frames - f0 == 23;
