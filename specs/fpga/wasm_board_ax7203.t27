}

test p2_roundtrip_errors {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_load(4);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 4;
    assert err == ERR_PROG;
    r = host_run_user(16, 120, 63, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 63;
    assert err == ERR_PROG;
    assert frames - f0 == 0;
}


; P3 behavioral (the fleet's two programs, over the wire like p2_roundtrip, with
; save/restore of page 0 so every other test sees the default image):
;   42 B1 D1 F9 D6 03 0B  = i64.const 987654321; end   (the t27b emitter's exact bytes)
;   42 7B 0B              = i64.const -5; end
; the alias law first, as runtime facts
test p3_i64_wire_programs {
    assert OP_I64_CONST == 0x42;
    assert OP_I32_CONST == 0x41;
    var save : [12]u8 = undefined;
    var i : u32 = 0;
    while (i < 12) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_I64_CONST;
    uprog[1] = 0xB1;
    uprog[2] = 0xD1;
    uprog[3] = 0xF9;
    uprog[4] = 0xD6;
    uprog[5] = 0x03;
    uprog[6] = OP_END;
    uprog[7] = OP_I64_CONST;
    uprog[8] = 0x7B;
    uprog[9] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(7, 0, 64, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 64;
    assert cap[2] == 0xB1;
    assert cap[3] == 0x68;
    assert cap[4] == 0xDE;
    r = host_run_user(3, 7, 65, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 65;
    assert cap[2] == 0xFB;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    i = 0;
    while (i < 12) { uprog[i] = save[i]; i = i + 1; }
}

; P4 behavioral (the fleet's last named refusal, over the wire like p3, with
; save/restore of page 0 so every other test sees the default image):
;   43 00 00 20 40 0B                      = f32.const 2.5; end  (word 0x40200000)
;   44 00 00 00 00 00 00 04 40 0B          = f64.const 2.5; end  (low32 0x00000000)
;   44 18 2D 44 54 FB 21 09 40 0B          = f64.const pi; end  (0x400921FB54442D18,
;                                           low32 0x54442D18 -- a nonzero low half, so
;                                           the low-32 law is witnessed, not just a zero)
; the raw-bit law first, as runtime facts
test p4_f32_wire_programs {
    assert OP_F32_CONST == 0x43;
    assert OP_F64_CONST == 0x44;
    var save : [26]u8 = undefined;
    var i : u32 = 0;
    while (i < 26) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_F32_CONST;
    uprog[1] = 0x00;
    uprog[2] = 0x00;
    uprog[3] = 0x20;
    uprog[4] = 0x40;
    uprog[5] = OP_END;
    uprog[6] = OP_F64_CONST;
    uprog[7] = 0x00;
    uprog[8] = 0x00;
    uprog[9] = 0x00;
    uprog[10] = 0x00;
    uprog[11] = 0x00;
    uprog[12] = 0x00;
    uprog[13] = 0x04;
    uprog[14] = 0x40;
    uprog[15] = OP_END;
    uprog[16] = OP_F64_CONST;
    uprog[17] = 0x18;
    uprog[18] = 0x2D;
    uprog[19] = 0x44;
    uprog[20] = 0x54;
    uprog[21] = 0xFB;
    uprog[22] = 0x21;
    uprog[23] = 0x09;
    uprog[24] = 0x40;
    uprog[25] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(6, 0, 66, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 66;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x20;
    r = host_run_user(10, 6, 67, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 67;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x00;
    r = host_run_user(10, 16, 68, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 68;
    assert cap[2] == 0x18;
    assert cap[3] == 0x2D;
    assert cap[4] == 0x44;
    i = 0;
    while (i < 26) { uprog[i] = save[i]; i = i + 1; }
}

; P5 behavioral (the float floor, over the wire like p3/p4, with save/restore
; of the first three pages so every other test sees the default image):
;   43 00 00 20 40 43 00 00 C0 3F 92 0B  = f32.const 2.5; f32.const 1.5; f32.add; end
;                                         (4.0 = 0x40800000, low24 00 00 80)
;   43 00 00 20 40 43 00 00 C0 3F 93 0B  = 2.5 - 1.5 = 1.0 (low24 00 00 80)
;   43 00 00 80 3F 43 00 00 20 40 93 0B  = 1.0 - 2.5 = -1.5 (low24 00 00 C0)
;   43 00 00 00 40 43 00 00 00 40 94 0B  = 2.0 * 2.0 = 4.0 (the 24-clock
;                                         significand machine, low24 00 00 80)
;   43 00 00 C0 3F 43 00 00 00 40 94 0B  = 1.5 * 2.0 = 3.0 (low24 00 00 40)
;   43 01 00 00 00 43 00 00 00 40 94 0B  = denorm 2^-149 * 2.0 = 2^-148
;                                         (denormal input and output, 02 00 00)
;   43 01 00 00 00 43 01 00 00 00 92 0B  = 2^-149 + 2^-149 = 2^-148 (02 00 00)
;   92 0B                                 = f32.add on an empty stack: RESP_BADOP
; the exact-word laws first, as runtime facts (the wire carries only 24 bits,
; so full 32-bit exactness is pinned here). The 48-bit products are built with
; shifts, not wide hex literals: the toolchain truncates a hex literal wider
; than 32 bits, a fact measured by this test's first draft (0x90000000000
; assigned and re-compared equal at 0, while the shifted build carried the bits)
test p5_f32_arith_programs {
    assert OP_F32_ADD == 0x92;
    assert OP_F32_SUB == 0x93;
    assert OP_F32_MUL == 0x94;
    assert f32_add(0x40200000, 0x3FC00000) == 0x40800000;
    assert f32_add(0x3F800000, 0x3F800000) == 0x40000000;
    assert f32_add(0x3F800000, 0xBF800000) == 0x00000000;
    assert f32_add(0x40200000, 0xBFC00000) == 0x3F800000;
    assert f32_add(0x3FC00000, 0xBF800000) == 0x3F000000;
    assert f32_add(0x00000001, 0x00000001) == 0x00000002;
    assert f32_add(0x00800000, 0x00000001) == 0x00800001;
    assert f32_add(0x00800000, 0x80000001) == 0x007FFFFF;
    assert f32_add(0x7F7FFFFF, 0x7F7FFFFF) == 0x7F800000;
    assert f32_add(0x7F800000, 0xFF800000) == 0x7FC00000;
    assert f32_add(0x3F800001, 0x33800000) == 0x3F800001;
    assert f32_add(0x40200000, f32_neg(0x3FC00000)) == 0x3F800000;
    fa_acc = (0x90000 as u64) << 28;
    fa_e = 254;
    fa_s = 0;
    assert f32_mul_pack() == 0x40100000;
    fa_acc = 0x800000;
    fa_e = 129;
    fa_s = 0;
    assert f32_mul_pack() == 0x00000002;
    fa_acc = ((0xFFFFFC as u64) << 24) + 1;
    fa_e = 508;
    fa_s = 1;
    assert f32_mul_pack() == 0xFF800000;
    fa_run = 0;
    var save : [96]u8 = undefined;
    var i : u32 = 0;
    while (i < 96) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_F32_CONST;
    uprog[1] = 0x00;
    uprog[2] = 0x00;
    uprog[3] = 0x20;
    uprog[4] = 0x40;
    uprog[5] = OP_F32_CONST;
    uprog[6] = 0x00;
    uprog[7] = 0x00;
    uprog[8] = 0xC0;
    uprog[9] = 0x3F;
    uprog[10] = OP_F32_ADD;
    uprog[11] = OP_END;
    uprog[12] = OP_F32_CONST;
    uprog[13] = 0x00;
    uprog[14] = 0x00;
    uprog[15] = 0x20;
    uprog[16] = 0x40;
    uprog[17] = OP_F32_CONST;
    uprog[18] = 0x00;
    uprog[19] = 0x00;
    uprog[20] = 0xC0;
    uprog[21] = 0x3F;
    uprog[22] = OP_F32_SUB;
    uprog[23] = OP_END;
    uprog[24] = OP_F32_CONST;
    uprog[25] = 0x00;
    uprog[26] = 0x00;
    uprog[27] = 0x80;
    uprog[28] = 0x3F;
    uprog[29] = OP_F32_CONST;
    uprog[30] = 0x00;
    uprog[31] = 0x00;
    uprog[32] = 0x20;
    uprog[33] = 0x40;
    uprog[34] = OP_F32_SUB;
    uprog[35] = OP_END;
    uprog[36] = OP_F32_CONST;
    uprog[37] = 0x00;
    uprog[38] = 0x00;
    uprog[39] = 0x00;
    uprog[40] = 0x40;
    uprog[41] = OP_F32_CONST;
    uprog[42] = 0x00;
    uprog[43] = 0x00;
    uprog[44] = 0x00;
    uprog[45] = 0x40;
    uprog[46] = OP_F32_MUL;
    uprog[47] = OP_END;
    uprog[48] = OP_F32_CONST;
    uprog[49] = 0x00;
    uprog[50] = 0x00;
    uprog[51] = 0xC0;
    uprog[52] = 0x3F;
    uprog[53] = OP_F32_CONST;
    uprog[54] = 0x00;
    uprog[55] = 0x00;
    uprog[56] = 0x00;
    uprog[57] = 0x40;
    uprog[58] = OP_F32_MUL;
    uprog[59] = OP_END;
    uprog[60] = OP_F32_CONST;
    uprog[61] = 0x01;
    uprog[62] = 0x00;
    uprog[63] = 0x00;
    uprog[64] = 0x00;
    uprog[65] = OP_F32_CONST;
    uprog[66] = 0x00;
    uprog[67] = 0x00;
    uprog[68] = 0x00;
    uprog[69] = 0x40;
    uprog[70] = OP_F32_MUL;
    uprog[71] = OP_END;
    uprog[72] = OP_F32_CONST;
    uprog[73] = 0x01;
    uprog[74] = 0x00;
    uprog[75] = 0x00;
    uprog[76] = 0x00;
    uprog[77] = OP_F32_CONST;
    uprog[78] = 0x01;
    uprog[79] = 0x00;
    uprog[80] = 0x00;
    uprog[81] = 0x00;
    uprog[82] = OP_F32_ADD;
    uprog[83] = OP_END;
    uprog[84] = OP_F32_ADD;
    uprog[85] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_load(1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_load(2);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(12, 0, 71, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 71;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x80;
    r = host_run_user(12, 12, 72, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 72;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x80;
    r = host_run_user(12, 24, 73, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 73;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0xC0;
    r = host_run_user(12, 36, 74, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 74;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x80;
    r = host_run_user(12, 48, 75, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 75;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x40;
    r = host_run_user(12, 60, 76, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 76;
    assert cap[2] == 0x02;
    assert cap[3] == 0x00;
    assert cap[4] == 0x00;
    r = host_run_user(12, 72, 77, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 77;
    assert cap[2] == 0x02;
    assert cap[3] == 0x00;
    assert cap[4] == 0x00;
    r = host_run_user(2, 84, 78, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 78;
    assert err == ERR_STACK;
    i = 0;
    while (i < 96) { uprog[i] = save[i]; i = i + 1; }
}
