pub const OP_I32_SHR_U : u8 = 0x76;
pub const OP_I32_ROTL : u8 = 0x77;
pub const OP_I32_ROTR : u8 = 0x78;
; P6 design floor (2026-10-25): the byte i64.add will dispatch on when the datapath
; lands -- 0x7C, pinned by the t27b emitter's law (specs/tri/t27b/wasm.t27, the i64
; stack floor), NOT yet in the executed set. The compute law is the three helpers
; add64_lo / add64_c / add64_hi below: two adds and one carry, tested in simulation by
; p6_i64_add_carry_law and p6_i64_add_carry_negative_control.
pub const OP_I64_ADD : u8 = 0x7C;

