}

test p2_roundtrip_errors {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_load(4);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 4;
    assert err == ERR_PROG;
    r = host_run_user(16, 120, 63, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 63;
    assert err == ERR_PROG;
    assert frames - f0 == 0;
}

; P3 behavioral (the fleet's two programs, over the wire like p2_roundtrip, with
; save/restore of page 0 so every other test sees the default image):
;   42 B1 D1 F9 D6 03 0B  = i64.const 987654321; end   (the t27b emitter's exact bytes)
;   42 7B 0B              = i64.const -5; end
; the alias law first, as runtime facts
test p3_i64_wire_programs {
    assert OP_I64_CONST == 0x42;
    assert OP_I32_CONST == 0x41;
    var save : [12]u8 = undefined;
    var i : u32 = 0;
    while (i < 12) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_I64_CONST;
    uprog[1] = 0xB1;
    uprog[2] = 0xD1;
    uprog[3] = 0xF9;
    uprog[4] = 0xD6;
    uprog[5] = 0x03;
    uprog[6] = OP_END;
    uprog[7] = OP_I64_CONST;
    uprog[8] = 0x7B;
    uprog[9] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(7, 0, 64, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 64;
    assert cap[2] == 0xB1;
    assert cap[3] == 0x68;
    assert cap[4] == 0xDE;
    r = host_run_user(3, 7, 65, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 65;
    assert cap[2] == 0xFB;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    i = 0;
    while (i < 12) { uprog[i] = save[i]; i = i + 1; }
}

; P4 behavioral (the fleet's last named refusal, over the wire like p3, with
; save/restore of page 0 so every other test sees the default image):
;   43 00 00 20 40 0B                      = f32.const 2.5; end  (word 0x40200000)
;   44 00 00 00 00 00 00 04 40 0B          = f64.const 2.5; end  (low32 0x00000000)
;   44 18 2D 44 54 FB 21 09 40 0B          = f64.const pi; end  (0x400921FB54442D18,
;                                           low32 0x54442D18 -- a nonzero low half, so
;                                           the low-32 law is witnessed, not just a zero)
; the raw-bit law first, as runtime facts
test p4_f32_wire_programs {
    assert OP_F32_CONST == 0x43;
    assert OP_F64_CONST == 0x44;
    var save : [26]u8 = undefined;
    var i : u32 = 0;
    while (i < 26) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_F32_CONST;
    uprog[1] = 0x00;
    uprog[2] = 0x00;
    uprog[3] = 0x20;
    uprog[4] = 0x40;
    uprog[5] = OP_END;
    uprog[6] = OP_F64_CONST;
    uprog[7] = 0x00;
    uprog[8] = 0x00;
    uprog[9] = 0x00;
    uprog[10] = 0x00;
    uprog[11] = 0x00;
    uprog[12] = 0x00;
    uprog[13] = 0x04;
    uprog[14] = 0x40;
    uprog[15] = OP_END;
    uprog[16] = OP_F64_CONST;
    uprog[17] = 0x18;
    uprog[18] = 0x2D;
    uprog[19] = 0x44;
    uprog[20] = 0x54;
    uprog[21] = 0xFB;
    uprog[22] = 0x21;
    uprog[23] = 0x09;
    uprog[24] = 0x40;
    uprog[25] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(6, 0, 66, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 66;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x20;
    r = host_run_user(10, 6, 67, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 67;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x00;
    r = host_run_user(10, 16, 68, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 68;
    assert cap[2] == 0x18;
    assert cap[3] == 0x2D;
    assert cap[4] == 0x44;
    i = 0;
    while (i < 26) { uprog[i] = save[i]; i = i + 1; }
}

; --- issue #12011: the single-clock ALU is one function pair; these tests are its proof ----
; The oracle is pinned by literals first, so a wrong closed form cannot hide behind a
; matching wrong cell.
test alu_oracle_goldens {
    var a : u32 = 0;
    a = ref_alu(OP_I32_SUB, 0, 1);
    assert a == 0xFFFFFFFF;
    a = ref_alu(OP_I32_ADD, 0xFFFFFFFF, 1);
    assert a == 0;
    a = ref_alu(OP_I32_SHL, 1, 33);
    assert a == 2;
    a = ref_alu(OP_I32_SHL, 0x80000001, 1);
    assert a == 2;
    a = ref_alu(OP_I32_SHR_S, 0x80000000, 1);
    assert a == 0xC0000000;
    a = ref_alu(OP_I32_SHR_S, 0xFFFFFFFF, 31);
    assert a == 0xFFFFFFFF;
    a = ref_alu(OP_I32_SHR_S, 0x80000000, 32);
    assert a == 0x80000000;
    a = ref_alu(OP_I32_SHR_U, 0x80000000, 31);
    assert a == 1;
    a = ref_alu(OP_I32_ROTL, 0x80000001, 1);
    assert a == 3;
    a = ref_alu(OP_I32_ROTR, 1, 1);
    assert a == 0x80000000;
    a = ref_alu(OP_I32_ROTL, 0xDEADBEEF, 0);
    assert a == 0xDEADBEEF;
    a = ref_alu(OP_I32_ROTR, 0xDEADBEEF, 32);
    assert a == 0xDEADBEEF;
    a = ref_alu(OP_I32_CLZ, 0, 0);
    assert a == 32;
    a = ref_alu(OP_I32_CLZ, 1, 0);
    assert a == 31;
    a = ref_alu(OP_I32_CLZ, 0x80000000, 0);
    assert a == 0;
    a = ref_alu(OP_I32_CTZ, 0, 0);
    assert a == 32;
    a = ref_alu(OP_I32_CTZ, 0x80000000, 0);
    assert a == 31;
    a = ref_alu(OP_I32_POPCNT, 0xFFFFFFFF, 0);
    assert a == 32;
    a = ref_alu(OP_I32_POPCNT, 0xDEADBEEF, 0);
    assert a == 24;
    a = ref_alu(OP_I32_LT_S, 0xFFFFFFFF, 0);
    assert a == 1;
    a = ref_alu(OP_I32_LT_U, 0xFFFFFFFF, 0);
    assert a == 0;
    a = ref_alu(OP_I32_GE_S, 0x80000000, 1);
    assert a == 0;
    a = ref_alu(OP_I32_GT_S, 1, 0x80000000);
    assert a == 1;
    a = ref_alu(OP_I32_AND, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0xF000F000;
    a = ref_alu(OP_I32_OR, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0xFFF0FFF0;
    a = ref_alu(OP_I32_XOR, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0x0FF00FF0;
    a = ref_alu(OP_I32_EQZ, 0, 7);
    assert a == 1;
    a = ref_alu(OP_I32_EQZ, 5, 0);
    assert a == 0;
    a = ref_alu(OP_I32_EQ, 3, 3);
    assert a == 1;
    a = ref_alu(OP_I32_NE, 3, 3);
    assert a == 0;
}

; alu_arity accepts exactly the 24 single-clock ALU bytes, names the right arity for each,
; and the 24 swept indices cover those bytes once each.
test alu_arity_pins {
    var b : u32 = 0;
    var a : u32 = 0;
    var want : u32 = 0;
    var bad : u32 = 0;
    var accepted : u32 = 0;
    var sum : u32 = 0;
    var i : u32 = 0;
    var cnt : u32 = 0;
    var cover : u32 = 0;
    while (b < 256) {
        a = alu_arity(b as u8);
        want = 0;
        if (ref_is_alu(b) == 1) {
            want = 2;
            if (ref_unary(b as u8) == 1) { want = 1; }
        }
        if (a != want) { bad = bad + 1; }
        if (a != 0) {
            accepted = accepted + 1;
            sum = sum + a;
            cnt = 0;
            i = 0;
            while (i < 24) {
                if ((alu_op_at(i) as u32) == b) { cnt = cnt + 1; }
                i = i + 1;
            }
            if (cnt != 1) { cover = cover + 1; }
        }
        b = b + 1;
    }
    assert bad == 0;
    assert accepted == 24;
    assert sum == 44;
    assert cover == 0;
    a = alu_arity(OP_I32_MUL);
    assert a == 0;
    a = alu_arity(OP_I32_DIV_S);
    assert a == 0;
    a = alu_arity(OP_I32_DIV_U);
    assert a == 0;
    a = alu_arity(OP_I32_REM_S);
    assert a == 0;
    a = alu_arity(OP_I32_REM_U);
    assert a == 0;
    a = alu_arity(OP_I32_CONST);
    assert a == 0;
    a = alu_arity(OP_LOCAL_GET);
    assert a == 0;
    a = alu_arity(OP_END);
    assert a == 0;
    a = alu_arity(OP_SELECT);
    assert a == 0;
}

; 24 opcodes x 16 operand pairs = 384 cells run through the wire; the full 32-bit result of
; each is compared with the closed form above.
test alu_sweep_closed_forms {
    var f0 : u32 = frames;
    var i : u32 = 0;
    var p : u32 = 0;
    var cmp : u32 = 0;
    var bad : u32 = 0;
    var op : u8 = 0;
    var x : u32 = 0;
    var y : u32 = 0;
    var s : u32 = 0;
    var v : u32 = 0;
    var want : u32 = 0;
    while (i < 24) {
        op = alu_op_at(i);
        p = 0;
        while (p < 16) {
            x = sw_x(p);
            y = sw_y(p);
            s = run_alu(op, x, y, (cmp & 255) as u8);
            v = res;
            want = ref_alu(op, x, y);
            if (s != 0) { bad = bad + 1; }
            if (v != want) { bad = bad + 1; }
            cmp = cmp + 1;
            p = p + 1;
        }
        i = i + 1;
    }
    assert cmp == 384;
    assert bad == 0;
    assert frames - f0 == 384;
}

; Negative control: the same sweep against the signed/unsigned PARTNER's closed form must
; disagree for every one of the ten twin opcodes, or the sweep cannot tell signedness apart.
test alu_sweep_signedness_negative_control {
    var j : u32 = 0;
    var p : u32 = 0;
    var op : u8 = 0;
    var x : u32 = 0;
    var y : u32 = 0;
    var s : u32 = 0;
    var v : u32 = 0;
    var want : u32 = 0;
    var per : u32 = 0;
    var total : u32 = 0;
    var weak : u32 = 0;
    var sbad : u32 = 0;
    while (j < 10) {
        op = pair_op_at(j);
        per = 0;
        p = 0;
        while (p < 16) {
            x = sw_x(p);
            y = sw_y(p);
            s = run_alu(op, x, y, (p + 100) as u8);
            v = res;
            want = ref_alu(pair_partner(op), x, y);
            if (s != 0) { sbad = sbad + 1; }
            if (v != want) { per = per + 1; }
            p = p + 1;
        }
        if (per == 0) { weak = weak + 1; }
        total = total + per;
        j = j + 1;
    }
    assert sbad == 0;
    assert weak == 0;
    assert total >= 5;
}

; The bytes the cell executes (40: 24 ALU, mul and the four div/rem, the four const bytes
; 0x41-0x44, local.get/set/tee, return, end, drop, select) are independent of the ALU pair:
; every other byte of the opcode space -- 0x28 i32.load among them, a generated byte of the
; table the cell does not run -- answers RESP_BADOP with ERR_OPCODE, as before the refactor.
fn cell_runs(b : u32) -> u32 {
    if (ref_is_alu(b) == 1) { return 1; }
    if (b >= 0x6C && b <= 0x70) { return 1; }
    if (b >= 0x20 && b <= 0x22) { return 1; }
    if (b >= 0x41 && b <= 0x44) { return 1; }
    if (b == 0x0B || b == 0x0F || b == 0x1A || b == 0x1B) { return 1; }
    return 0;
}

test alu_unexecuted_bytes_are_opcode_errors {
    var f0 : u32 = frames;
    var b : u32 = 0;
    var runs : u32 = 0;
    var tried : u32 = 0;
    var bad : u32 = 0;
    var r : u32 = 0;
    var c : u32 = 0;
    while (b < 256) {
        c = cell_runs(b);
        if (c == 1) {
            runs = runs + 1;
        } else {
            code[104] = b as u8;
            code[105] = 0x0B;
            r = host_run_user(2, 104, (tried & 255) as u8, 5, 6);
            if (r != 0) { bad = bad + 1; }
            if (cap[0] != RESP_BADOP) { bad = bad + 1; }
            if (cap[1] != (tried & 255) as u8) { bad = bad + 1; }
            if (err != ERR_OPCODE) { bad = bad + 1; }
            tried = tried + 1;
        }
        b = b + 1;
    }
    c = cell_runs(0x28);
    assert c == 0;
    assert runs == 40;
    assert tried == 216;
    assert bad == 0;
    assert frames - f0 == 216;
}
