pub const I32_MASK : u64 = 0xFFFFFFFF;

; --- control flow (issue #12010): a label stack of LABEL_MAX frames, one LEB byte per label,
; FUEL_MAX fetches per run so a looping program cannot hang the link
pub const OP_BLOCK : u8 = 0x02;
pub const OP_LOOP : u8 = 0x03;
pub const OP_BR : u8 = 0x0C;
pub const OP_BR_IF : u8 = 0x0D;
pub const OP_BR_TABLE : u8 = 0x0E;
pub const BT_VOID : u8 = 0x40;
pub const BT_I32 : u8 = 0x7F;
pub const LABEL_MAX : u32 = 8;
pub const FUEL_MAX : u32 = 65536;

; --- opcodes, WebAssembly MVP final bytes (pinned by test opcode_bytes_are_real_wasm) ----
pub const OP_END : u8 = 0x0B;
pub const OP_RETURN : u8 = 0x0F;
pub const OP_DROP : u8 = 0x1A;
pub const OP_SELECT : u8 = 0x1B;
pub const OP_LOCAL_GET : u8 = 0x20;
pub const OP_LOCAL_SET : u8 = 0x21;
pub const OP_LOCAL_TEE : u8 = 0x22;
pub const OP_I32_CONST : u8 = 0x41;
; P3 (2026-10-24): i64.const joins as the LOW-32 floor. OP_I64_CONST decodes the
; same five-byte SLEB128 submachine as OP_I32_CONST and pushes the same u32 word:
; for every i64 whose low 32 bits are what the answer contract expresses, a
; canonical SLEB of five bytes or fewer exists (the fleet's 987654321 and -5 both
; fit); a longer continuation at imm_cnt == 4 refuses with ERR_LEB, the same honest
; boundary as i32. The 64-bit datapath itself stays a separate increment.
pub const OP_I64_CONST : u8 = 0x42;
; P4 (2026-10-24): the float consts join as RAW-BIT words -- no LEB at all. A real
; wasm f32.const carries its four IEEE-754 bytes little-endian right after the
; opcode, f64.const its eight; the floor pushes those bits as the u32 stack word:
; f32 wholesale, f64 as the low 32 (its first four bytes), the same honest floor
; as i64.const. Float arithmetic and the f64 high half stay a separate increment.
pub const OP_F32_CONST : u8 = 0x43;
pub const OP_F64_CONST : u8 = 0x44;
pub const OP_I32_EQZ : u8 = 0x45;
pub const OP_I32_EQ : u8 = 0x46;
pub const OP_I32_NE : u8 = 0x47;
