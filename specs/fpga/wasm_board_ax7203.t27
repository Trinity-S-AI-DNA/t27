            pc = 0;
            sp = 0;
            err = ERR_NONE;
            mul_run = 0;
            imm_run = 0;
            dv_run = 0;
            fa_run = 0;
            br_run = 0;
            sc_run = 0;
            mem_run = 0;
            mul_wide = 0;
            imm_wide = 0;
            lsp = 0;
            csp = 0;
            lbase = 0;
            lbl = 0;
            lcnt = LOCALS;
            sc_mode = 0;
            fuel = 0;
            loc[0] =(body[X_OFF] as u32) | ((body[X_OFF + 1] as u32) << 8) | ((body[X_OFF + 2] as u32) << 16) | ((body[X_OFF + 3] as u32) << 24);
            loc[1] = (body[Y_OFF] as u32) | ((body[Y_OFF + 1] as u32) << 8) | ((body[Y_OFF + 2] as u32) << 16) | ((body[Y_OFF + 3] as u32) << 24);
