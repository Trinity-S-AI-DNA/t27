; The control-flow suite (issue #12010), host-side only like uprog. The tests poke these
; bytes into the free tail of the code store (the two longest over the last baked bytes,
; restored by cf_restore afterwards) and run them with OP_RUN_USER; on the board the same
; bytes arrive through OP_LOAD_PAGE page 3. One program per line, the WAT in the comment.
pub const CF_SUM : u8 = 0x00;
pub const CF_TAB : u8 = 0x1E;
pub const CF_NEST : u8 = 0x38;
pub const CF_FUEL : u8 = 0x59;
pub const CF_IMM : u8 = 0x5E;
pub const CF_VAL : u8 = 0x6D;
pub const CF_END : u8 = 0x7C;
pub const CF_SUM_LEN : u32 = 30;
pub const CF_TAB_LEN : u32 = 26;
pub const CF_NEST_LEN : u32 = 33;
pub const CF_FUEL_LEN : u32 = 5;
pub const CF_IMM_LEN : u32 = 15;
pub const CF_VAL_LEN : u32 = 15;
; CF_SUM  block loop (x==0 -> br_if 1) y += x; x -= 1; br 0 end end; y      = y + x(x+1)/2
; CF_TAB  block block block x br_table 0 1 2 0 end 10 ret end 20 ret end 30  = 10 20 30 | 10
; CF_NEST block loop (x==0 -> br_if 1) x -= 1; y += 1; loop br 1 end end end; y = y + x
; CF_FUEL loop br 0 end                                                     = ERR_FUEL
; CF_IMM  block(i32) 5 br 0 [i32.const 11; br_if 11] end; x; add            = 5 + x
; CF_VAL  40 block(i32) 1 2 3 br 0 end add                                  = 43 (5 if the
;         branch did not unwind the stack to the block's height)
var cfprog : [CODE_PAD]u8 = [
    0x02, 0x40, 0x03, 0x40, 0x20, 0x00, 0x45, 0x0D, 0x01, 0x20, 0x01, 0x20, 0x00, 0x6A, 0x21, 0x01,
    0x20, 0x00, 0x41, 0x01, 0x6B, 0x21, 0x00, 0x0C, 0x00, 0x0B, 0x0B, 0x20, 0x01, 0x0B,
    0x02, 0x40, 0x02, 0x40, 0x02, 0x40, 0x20, 0x00, 0x0E, 0x03, 0x00, 0x01, 0x02, 0x00, 0x0B,
    0x41, 0x0A, 0x0F, 0x0B, 0x41, 0x14, 0x0F, 0x0B, 0x41, 0x1E, 0x0B,
    0x02, 0x40, 0x03, 0x40, 0x20, 0x00, 0x45, 0x0D, 0x01, 0x20, 0x00, 0x41, 0x01, 0x6B, 0x21, 0x00,
    0x20, 0x01, 0x41, 0x01, 0x6A, 0x21, 0x01, 0x03, 0x40, 0x0C, 0x01, 0x0B, 0x0B, 0x0B, 0x20, 0x01, 0x0B,
    0x03, 0x40, 0x0C, 0x00, 0x0B,
    0x02, 0x7F, 0x41, 0x05, 0x0C, 0x00, 0x41, 0x0B, 0x0D, 0x0B, 0x0B, 0x20, 0x00, 0x6A, 0x0B,
    0x41, 0x28, 0x02, 0x7F, 0x41, 0x01, 0x41, 0x02, 0x41, 0x03, 0x0C, 0x00, 0x0B, 0x6A, 0x0B,
    0, 0, 0, 0];

; --- program table (flat if-chains: they lower, a runtime-indexed const array is unproven)
fn prog_off(p : u8) -> u32 {
    if (p == 0) { return 0; }
    if (p == 1) { return 9; }
    if (p == 2) { return 12; }
    if (p == 3) { return 21; }
    if (p == 4) { return 33; }
    if (p == 5) { return 42; }
    if (p == 6) { return 48; }
    if (p == 7) { return 54; }
    if (p == 8) { return 60; }
    if (p == 9) { return 66; }
    if (p == 10) { return 70; }
    if (p == 11) { return 76; }
    if (p == 12) { return 89; }
    return 97;
}

fn prog_len(p : u8) -> u32 {
    if (p == 0) { return 9; }
    if (p == 1) { return 3; }
    if (p == 2) { return 9; }
    if (p == 3) { return 12; }
    if (p == 4) { return 9; }
    if (p == 5) { return 6; }
    if (p == 6) { return 6; }
    if (p == 7) { return 6; }
    if (p == 8) { return 6; }
    if (p == 9) { return 4; }
    if (p == 10) { return 6; }
    if (p == 11) { return 13; }
    if (p == 12) { return 8; }
    return 4;
}

; --- i32 helpers (the MVP semantics; every result widened, computed, masked back)
fn wrap32(v : u64) -> u32 {
    return (v & I32_MASK) as u32;
}

fn lt_s32(x : u32, y : u32) -> u32 {
    if ((x ^ 0x80000000) < (y ^ 0x80000000)) {
        return 1;
    }
    return 0;
}

fn shl32(x : u32, n : u32) -> u32 {
    return wrap32((x as u64) << (n & 31));
}

fn sar32(x : u32, n : u32) -> u32 {
    if ((n & 31) == 0) {
        return x;
    }
    var r : u32 = x >> (n & 31);
    if ((x & 0x80000000) != 0) {
        r = r | (0xFFFFFFFF << (32 - (n & 31)));
    }
    return r;
}

; one-byte signed LEB128, the fast path of i32.const: values -64..63, bit 6
; sign-extended. P2 adds the multi-byte path as an operand-fetch submachine in
; the tick; a continuation bit here just means the submachine starts.
fn sleb8(b : u8) -> u32 {
    if ((b & 0x40) != 0) {
        return (b as u32) | 0xFFFFFF80;
    }
    return b as u32;
}

; --- P2 helpers (same discipline: widen, compute, mask back; no operator the tick
; --- body cannot lower -- multiplication is a microsequence, never a `*` here)
fn neg32(x : u32) -> u32 {
    return wrap32(4294967296 - (x as u64));
}

fn abs32(x : u32) -> u32 {
    if ((x & 0x80000000) != 0) {
        return neg32(x);
    }
    return x;
}

fn shr_u32(x : u32, n : u32) -> u32 {
    return x >> (n & 31);
}

fn rotl32(x : u32, n : u32) -> u32 {
    var k : u32 = n & 31;
    return wrap32(((x as u64) << k) | ((x as u64) >> (32 - k)));
}

fn rotr32(x : u32, n : u32) -> u32 {
    var k : u32 = n & 31;
    return wrap32(((x as u64) >> k) | ((x as u64) << (32 - k)));
}

; five fixed probes, no loop. The probes sum to 31 when every one fires, so
; the WASM edge x == 0 -- which must answer 32, not 31 -- is its own case.
fn clz32(x : u32) -> u32 {
    if (x == 0) {
        return 32;
    }
    var n : u32 = 0;
    var v : u32 = x;
    if ((v & 0xFFFF0000) == 0) { n = n + 16; v = v << 16; }
    if ((v & 0xFF000000) == 0) { n = n + 8; v = v << 8; }
    if ((v & 0xF0000000) == 0) { n = n + 4; v = v << 4; }
    if ((v & 0xC0000000) == 0) { n = n + 2; v = v << 2; }
    if ((v & 0x80000000) == 0) { n = n + 1; }
    return n;
}

fn ctz32(x : u32) -> u32 {
    if (x == 0) {
        return 32;
    }
    var n : u32 = 0;
    var v : u32 = x;
    if ((v & 0x0000FFFF) == 0) { n = n + 16; v = v >> 16; }
    if ((v & 0x000000FF) == 0) { n = n + 8; v = v >> 8; }
    if ((v & 0x0000000F) == 0) { n = n + 4; v = v >> 4; }
    if ((v & 0x00000003) == 0) { n = n + 2; v = v >> 2; }
    if ((v & 0x00000001) == 0) { n = n + 1; }
    return n;
}

; SWAR nibble sums then a byte-fold; the multiply-based fold is avoided on purpose
fn popcnt32(x : u32) -> u32 {
    var v : u32 = x;
    v = v - ((v >> 1) & 0x55555555);
    v = (v & 0x33333333) + ((v >> 2) & 0x33333333);
    v = (v + (v >> 4)) & 0x0F0F0F0F;
    return (v + (v >> 8) + (v >> 16) + (v >> 24)) & 0x3F;
}

; --- the single-clock i32 ALU: ONE home for 24 opcodes (issue #12011). The tick body
; --- makes one call per instruction: alu_arity(op) says how many operands the opcode
; --- pops (0 = not a single-clock ALU opcode, the tick's other arms take it), and
; --- alu_eval(op, a, b) is the value pushed back. A unary opcode is called with a == b
; --- == the top of the stack. wasm_opcodes.t27 `use`s this cell so its eval_byte() runs
; --- these very bodies: the oracle and the cell cannot differ. Flat if-chains, no loop
; --- and no `||`, so the whole pair lowers; mul, div and rem are microsequences and
; --- stay in the tick.
fn alu_arity(op : u8) -> u32 {
    if (op == OP_I32_EQZ) { return 1; }
    if (op == OP_I32_CLZ) { return 1; }
    if (op == OP_I32_CTZ) { return 1; }
    if (op == OP_I32_POPCNT) { return 1; }
    if (op >= OP_I32_EQ && op <= OP_I32_GE_U) { return 2; }
    if (op == OP_I32_ADD) { return 2; }
    if (op == OP_I32_SUB) { return 2; }
    if (op >= OP_I32_AND && op <= OP_I32_ROTR) { return 2; }
    return 0;
}

fn alu_eval(op : u8, a : u32, b : u32) -> u32 {
    if (op == OP_I32_EQZ) {
        if (a == 0) { return 1; }
        return 0;
    }
    if (op == OP_I32_EQ) {
        if (a == b) { return 1; }
        return 0;
    }
    if (op == OP_I32_NE) {
        if (a != b) { return 1; }
        return 0;
    }
    if (op == OP_I32_LT_S) {
        return lt_s32(a, b);
    }
    if (op == OP_I32_GT_S) {
        return lt_s32(b, a);
    }
    if (op == OP_I32_LE_S) {
        if (lt_s32(b, a) == 0) { return 1; }
        return 0;
    }
    if (op == OP_I32_GE_S) {
        if (lt_s32(a, b) == 0) { return 1; }
        return 0;
    }
    if (op == OP_I32_LT_U) {
        if (a < b) { return 1; }
        return 0;
    }
    if (op == OP_I32_GT_U) {
        if (a > b) { return 1; }
        return 0;
    }
    if (op == OP_I32_LE_U) {
        if (a <= b) { return 1; }
        return 0;
    }
    if (op == OP_I32_GE_U) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (op == OP_I32_CLZ) { return clz32(a); }
    if (op == OP_I32_CTZ) { return ctz32(a); }
    if (op == OP_I32_POPCNT) { return popcnt32(a); }
    if (op == OP_I32_ADD) { return wrap32((a as u64) + (b as u64)); }
    if (op == OP_I32_SUB) { return wrap32((a as u64) + (4294967296 - (b as u64))); }
    if (op == OP_I32_AND) { return a & b; }
    if (op == OP_I32_OR) { return a | b; }
    if (op == OP_I32_XOR) { return a ^ b; }
    if (op == OP_I32_SHL) { return shl32(a, b); }
    if (op == OP_I32_SHR_S) { return sar32(a, b); }
    if (op == OP_I32_SHR_U) { return shr_u32(a, b); }
    if (op == OP_I32_ROTL) { return rotl32(a, b); }
    if (op == OP_I32_ROTR) { return rotr32(a, b); }
    return 0;
}

; --- P5 helpers (issue #12202): written once here, used by the tick, the scan and the tests.
; Width in bytes of a load or store byte, 0 for every other byte.
fn mem_width(op : u8) -> u32 {
    if (op == OP_I32_LOAD || op == OP_I32_STORE) { return 4; }
    if (op == OP_I32_LOAD16_S || op == OP_I32_LOAD16_U || op == OP_I32_STORE16) { return 2; }
    if (op == OP_I32_LOAD8_S || op == OP_I32_LOAD8_U || op == OP_I32_STORE8) { return 1; }
    return 0;
}

; Operands a load or store pops: the base address for a load, the value above it for a store.
fn mem_pops(op : u8) -> u32 {
    if (op == OP_I32_STORE || op == OP_I32_STORE8 || op == OP_I32_STORE16) { return 2; }
    if (mem_width(op) != 0) { return 1; }
    return 0;
}

; Where a LEB128 byte of index i lands in the 32-bit value it builds.
fn mem_leb_shift(i : u32) -> u32 {
    if (i == 1) { return 7; }
    if (i == 2) { return 14; }
    if (i == 3) { return 21; }
    if (i == 4) { return 28; }
    return 0;
}

; 1 when an access of w bytes at base + off stays inside the page. No 64-bit sum here: the
; first form, `(base as u64) + (off as u64) + (w as u64) > MEM_BYTES`, passed the Zig run and
; failed the Verilog run, because gen-verilog keeps the casts as 32-bit adds, so 0xFFFFFFFF + 1
; wrapped to a legal address and the trap test lost its three wrap cases (vvp 41 of 42). Two
; 32-bit compares that cannot overflow say the same thing in both: base + off <= lim holds
; exactly when base <= lim and off <= lim - base, with lim = MEM_BYTES - w (w is at most 4).
fn mem_fits(base : u32, off : u32, w : u32) -> u32 {
    var lim : u32 = MEM_BYTES - w;
    if (base > lim) { return 0; }
    if (off > lim - base) { return 0; }
    return 1;
}

; The effective address once mem_fits said yes, so base + off is below 65536 and cannot overflow.
fn mem_ea(base : u32, off : u32) -> u32 {
    return base + off;
}

; The loaded value. The accumulator holds the bytes at the top of the word (each new byte
; enters at bit 24 and the rest slide down), so the sign of an 8- or 16-bit load is bit 31 and
; the zero-extending form is one logical shift by 32 - 8w.
fn mem_extend(op : u8, acc : u32) -> u32 {
    if (op == OP_I32_LOAD8_U) { return acc >> 24; }
    if (op == OP_I32_LOAD16_U) { return acc >> 16; }
    if (op == OP_I32_LOAD8_S) {
        if ((acc & 0x80000000) != 0) { return (acc >> 24) | 0xFFFFFF00; }
        return acc >> 24;
    }
    if (op == OP_I32_LOAD16_S) {
        if ((acc & 0x80000000) != 0) { return (acc >> 16) | 0xFFFF0000; }
        return acc >> 16;
    }
    return acc;
}

; How the forward scan (issue #12010) steps over byte b when a branch skips it: 0 one byte
; and no immediate, 1 one LEB immediate (also the reserved byte of memory.size and
; memory.grow), 2 block or loop (one block-type byte, opens a nested label), 3 end, 4
; br_table (a count, then count + 1 label bytes), 6 a load or store (a memarg: two LEB
; immediates, align then offset), 5 a byte this cell does not run -- the scan is as strict as
; the fetch, and answers ERR_OPCODE.
fn scan_class(b : u8) -> u8 {
    if (alu_arity(b) != 0) { return 0; }
    if (b >= OP_I32_MUL && b <= OP_I32_REM_U) { return 0; }
    if (b == OP_DROP || b == OP_SELECT || b == OP_RETURN) { return 0; }
    if (b >= OP_LOCAL_GET && b <= OP_LOCAL_TEE) { return 1; }
    if (b == OP_I32_CONST || b == OP_BR || b == OP_BR_IF) { return 1; }
    if (b == OP_BLOCK || b == OP_LOOP) { return 2; }
    if (b == OP_END) { return 3; }
    if (b == OP_BR_TABLE) { return 4; }
    if (mem_width(b) != 0) { return 6; }
    if (b == OP_MEMORY_SIZE || b == OP_MEMORY_GROW) { return 1; }
    return 5;
}

; --- responses
fn fail_rsp(e : u8) {
    err = e;
    txq[0] = RESP_BADOP;
    txq[1] = seqq;
    txq[2] = 0;
    txq[3] = 0;
    txq[4] = 0;
    responding = 1;
    txidx = 0;
    ms = 0;
    mul_run = 0;
    imm_run = 0;
    dv_run = 0;
    br_run = 0;
    sc_run = 0;
    mem_run = 0;
}

fn ok_rsp() {
    txq[0] = RESP_OK;
    txq[1] = seqq;
    txq[2] = (res & 255) as u8;
    txq[3] = ((res >> 8) & 255) as u8;
    txq[4] = ((res >> 16) & 255) as u8;
    responding = 1;
    txidx = 0;
    ms = 0;
}

; --- the tick. Section order is the pipeline: transmitter (consumes responding and txq from
; a previous tick), engine (consumes frame_go from a previous tick, one opcode, except
; i32.mul which runs a 32-clock shift-add sequence), framing
; (consumes rxnew from a previous tick, fills body and raises frame_go), receiver (consumes
; the synchronized rx bit, produces rxnew). Every strobe lives exactly one tick.
; Why the mul microsequence: t27c lowers every `*` in a spec to a 64-iteration
; shift-add function in the generated Verilog, and a one-clock i32.mul puts that
; whole function in the clocked path -- 18.57 MHz on xc7a200t against the 68.7 MHz
; CFGMCLK bar BAUD_DIV=60 needs. One conditional 32-bit add per clock is shallow
; and the engine has thousands of ticks of slack between frames.
; Why the phase gate: P2 widens the same clocked cone with a runtime fetch over the
; 128-byte writable store, 37-way decode, two rotate barrels and the divide family --
; nextpnr estimated 50.61 MHz against the 68.7 MHz CFGMCLK BAUD_DIV=60 runs at. The
; engine section therefore works every second CFGMCLK edge (`phase`), which hands every
; engine path two clock periods -- a 34.3 MHz bar -- while the receiver, framing and
; transmitter keep their per-edge timing and the wire baud stays 1144744. Strobes are
; untouched: frame_go lives one edge and is consumed by the ms==0 dispatch, which is
; not gated; ms is a level, so the engine only runs slower, never skips a step.
; Measured after the gate (nextpnr estimates, xc7a200t-2): 53.71 MHz for the whole design
; against the 34.3 MHz engine bar, and 165.15 MHz for a build with the engine cut so only
; the ungated per-edge cone remains, against the 68.7 MHz bar. 6 runs x 29 P2 requests on
; silicon: 174/174 exact.
; P2 arms inside the tick, prose kept out of the body: OP_LOAD_PAGE takes the page
; number from body[1] (the SEQ slot, echoed by the response) and writes body[4..35]
; into code[page*32 .. +31] as flat constant-index stores -- no multiply in an index,
; the store lowers as RAM either way, and `frames` does not move because a load never
; runs the engine. OP_RUN_USER takes the program length from body[2] and its offset
; from body[3]; a length of zero or a window that leaves the 128-byte store answers
; ERR_PROG before the first fetch. The divide family runs a restoring divider, one
; bit per clock -- (rem:q) shifts left, the trial subtract either restores or sets
; the quotient bit, 32 clocks, the same shape as the mul microsequence; the signed
; kinds go in as abs32 and negate the quotient or remainder on the way out.
; i32.const with a continuation byte starts an operand-fetch submachine: a
; continuation at imm_cnt == 4 would be the sixth byte of an i32 immediate and
; answers ERR_LEB; the final byte assembles through shl32 (widen, shift, mask) and
; sign-extends by byte count, with five bytes needing no fill.
; Control flow (issue #12010), prose kept out of the body as well. block and loop push a
; frame (kind, stack height, target = the byte after the blocktype, arity 1 only for a block
; typed i32) and cost one fetch; end with a frame open pops it, end with none is the
; function end as before. br, br_if taken and br_table set br_run with the label, and the
; next engine step resolves it: frame lsp-1-label is the target, the stack unwinds to its
; height plus its arity (the top value carried down for arity 1); a loop target sets pc to
; its start and keeps the frame, a block target drops the frame and starts the scan. The
; scan (sc_run 1..4) walks forward one byte per engine step counting block/loop up and end
; down from label+1 to zero, stepping over LEB immediates (mode 2), a br_table count and
; its labels (modes 3, 4), a blocktype byte, the two LEB immediates of a load or store memarg
; and the reserved byte of memory.size/grow (issue #12202), so an 0x0B inside an immediate is
; never an end; a byte the cell does not run stops the scan with ERR_OPCODE, the program end
; with ERR_PC. Every fetch spends one unit of fuel; the fetch at FUEL_MAX answers ERR_FUEL.
; Linear memory (issue #12202): one page, `mem`, MEM_BYTES = 65536 bytes, little-endian. A load or
; store fetch pops its operands into mem_base and mem_val and starts mem_run, which reads the
; two memarg LEBs (align ignored, offset kept), checks base + offset as a 33-bit sum against
; 65536 - width before any byte moves (ERR_MEM, no wrap), then moves one byte per engine step
; through one read site and one write site, both addressed by the register mem_addr. The extra
; steps spend no fuel. memory.size pushes 1; memory.grow pops its delta and pushes -1.
fn step_all(rxd : u8) {
    phase = (phase ^ 1) as u8;
    txd = (tsr & 1) as u8;
    if (tcnt == 0) {
        tcnt = BAUD_DIV - 1;
        if (tbi == 9) {
            tbi = 0;
            if (responding == 1) {
                tsr = 512 + ((txq[(txidx as u32)] as u16) << 1);
                if (txidx == RESP_BYTES - 1) {
                    responding = 0;
                }
                txidx = txidx + 1;
            } else {
                tsr = 1023;
            }
        } else {
            tbi = tbi + 1;
            tsr = (tsr >> 1) | 512;
        }
    } else {
        tcnt = tcnt - 1;
    }
    if (frame_go == 1 && ms == 0 && responding == 0) {
        if (opq == OP_LOAD_PAGE) {
            if ((body[1] as u32) < CODE_PAGES) {
                if (body[1] == 0) {
                    code[0] = body[4]
                    code[1] = body[5]
                    code[2] = body[6]
                    code[3] = body[7];
                    code[4] = body[8]
                    code[5] = body[9]
                    code[6] = body[10]
                    code[7] = body[11];
                    code[8] = body[12]
                    code[9] = body[13]
                    code[10] = body[14]
                    code[11] = body[15];
                    code[12] = body[16]
                    code[13] = body[17]
                    code[14] = body[18]
                    code[15] = body[19];
                    code[16] = body[20]
                    code[17] = body[21]
                    code[18] = body[22]
                    code[19] = body[23];
                    code[20] = body[24]
                    code[21] = body[25]
                    code[22] = body[26]
                    code[23] = body[27];
                    code[24] = body[28]
                    code[25] = body[29]
                    code[26] = body[30]
                    code[27] = body[31];
                    code[28] = body[32]
                    code[29] = body[33]
                    code[30] = body[34]
                    code[31] = body[35];
                } else {
                if (body[1] == 1) {
                    code[32] = body[4]
                    code[33] = body[5]
                    code[34] = body[6]
                    code[35] = body[7];
                    code[36] = body[8]
                    code[37] = body[9]
                    code[38] = body[10]
                    code[39] = body[11];
                    code[40] = body[12]
                    code[41] = body[13]
                    code[42] = body[14]
                    code[43] = body[15];
                    code[44] = body[16]
                    code[45] = body[17]
                    code[46] = body[18]
                    code[47] = body[19];
                    code[48] = body[20]
                    code[49] = body[21]
                    code[50] = body[22]
                    code[51] = body[23];
                    code[52] = body[24]
                    code[53] = body[25]
                    code[54] = body[26]
                    code[55] = body[27];
                    code[56] = body[28]
                    code[57] = body[29]
                    code[58] = body[30]
                    code[59] = body[31];
                    code[60] = body[32]
                    code[61] = body[33]
                    code[62] = body[34]
                    code[63] = body[35];
                } else {
                if (body[1] == 2) {
                    code[64] = body[4]
                    code[65] = body[5]
                    code[66] = body[6]
                    code[67] = body[7];
                    code[68] = body[8]
                    code[69] = body[9]
                    code[70] = body[10]
                    code[71] = body[11];
                    code[72] = body[12]
                    code[73] = body[13]
                    code[74] = body[14]
                    code[75] = body[15];
                    code[76] = body[16]
                    code[77] = body[17]
                    code[78] = body[18]
                    code[79] = body[19];
                    code[80] = body[20]
                    code[81] = body[21]
                    code[82] = body[22]
                    code[83] = body[23];
                    code[84] = body[24]
                    code[85] = body[25]
                    code[86] = body[26]
                    code[87] = body[27];
                    code[88] = body[28]
                    code[89] = body[29]
                    code[90] = body[30]
                    code[91] = body[31];
                    code[92] = body[32]
                    code[93] = body[33]
                    code[94] = body[34]
                    code[95] = body[35];
                } else {
                    code[96] = body[4]
                    code[97] = body[5]
                    code[98] = body[6]
                    code[99] = body[7];
                    code[100] = body[8]
                    code[101] = body[9]
                    code[102] = body[10]
                    code[103] = body[11];
                    code[104] = body[12]
                    code[105] = body[13]
                    code[106] = body[14]
                    code[107] = body[15];
                    code[108] = body[16]
                    code[109] = body[17]
                    code[110] = body[18]
                    code[111] = body[19];
                    code[112] = body[20]
                    code[113] = body[21]
                    code[114] = body[22]
                    code[115] = body[23];
                    code[116] = body[24]
                    code[117] = body[25]
                    code[118] = body[26]
                    code[119] = body[27];
                    code[120] = body[28]
                    code[121] = body[29]
                    code[122] = body[30]
                    code[123] = body[31];
                    code[124] = body[32]
                    code[125] = body[33]
                    code[126] = body[34]
                    code[127] = body[35];
                }
                }
                }
                loads = loads + 1;
                res = (body[1] as u32) + 1;
                ok_rsp();
            } else {
                fail_rsp(ERR_PROG);
            }
        } else {
        if (opq == OP_RUN_USER) {
            if ((body[2] as u32) >= 1 && (body[3] as u32) + (body[2] as u32) <= CODE_PAD) {
                run_base = body[3] as u32;
                run_len = body[2] as u32;
                ms = 1;
                pc = 0;
                sp = 0;
                err = ERR_NONE;
                mul_run = 0;
                imm_run = 0;
                dv_run = 0;
                br_run = 0;
                sc_run = 0;
                mem_run = 0;
                lsp = 0;
                fuel = 0;
                loc[0] =(body[X_OFF] as u32) | ((body[X_OFF + 1] as u32) << 8) | ((body[X_OFF + 2] as u32) << 16) | ((body[X_OFF + 3] as u32) << 24);
                loc[1] = (body[Y_OFF] as u32) | ((body[Y_OFF + 1] as u32) << 8) | ((body[Y_OFF + 2] as u32) << 16) | ((body[Y_OFF + 3] as u32) << 24);
                frames = frames + 1;
            } else {
                fail_rsp(ERR_PROG);
            }
        } else {
        if ((opq as u32) < (PROGS as u32)) {
            run_base = prog_off(opq);
            run_len = prog_len(opq);
            ms = 1;
            pc = 0;
            sp = 0;
            err = ERR_NONE;
            mul_run = 0;
            imm_run = 0;
            dv_run = 0;
            br_run = 0;
            sc_run = 0;
            mem_run = 0;
            lsp = 0;
            fuel = 0;
            loc[0] =(body[X_OFF] as u32) | ((body[X_OFF + 1] as u32) << 8) | ((body[X_OFF + 2] as u32) << 16) | ((body[X_OFF + 3] as u32) << 24);
            loc[1] = (body[Y_OFF] as u32) | ((body[Y_OFF + 1] as u32) << 8) | ((body[Y_OFF + 2] as u32) << 16) | ((body[Y_OFF + 3] as u32) << 24);
            frames = frames + 1;
        } else {
            fail_rsp(ERR_PROG);
        }
        }
        }
    } else {
        if (frame_go == 1) {
            drops = drops + 1;
        }
        if (ms == 1 && phase == 1) {
            if (mul_run > 0) {
                if ((mul_b & 1) == 1) {
                    mul_acc = wrap32((mul_acc as u64) + (mul_a as u64));
                }
                mul_a = shl32(mul_a, 1);
                mul_b = mul_b >> 1;
                mul_run = mul_run - 1;
                if (mul_run == 0) {
                    st[sp - 1] = mul_acc;
                    pc = pc + 1;
                }
            } else {
            if (dv_run > 0) {
                dv_rem = (dv_rem << 1) | (dv_q >> 31);
                dv_q = dv_q << 1;
                if (dv_rem >= dv_b) {
                    dv_rem = dv_rem - dv_b;
                    dv_q = dv_q | 1;
                }
                dv_run = dv_run - 1;
                if (dv_run == 0) {
                    if (dv_kind == 0) {
                        st[sp - 1] = dv_q;
                    } else {
                    if (dv_kind == 1) {
                        st[sp - 1] = dv_rem;
                    } else {
                    if (dv_kind == 2) {
                        if (dv_negq != 0) {
                            st[sp - 1] = neg32(dv_q);
                        } else {
                            st[sp - 1] = dv_q;
                        }
                    } else {
                        if (dv_negr != 0) {
                            st[sp - 1] = neg32(dv_rem);
                        } else {
                            st[sp - 1] = dv_rem;
                        }
                    }
                    }
                    }
                    pc = pc + 1;
                }
            } else {
            if (imm_run > 0) {
                scrap_imm = code[run_base + pc];
                if ((scrap_imm & 0x80) != 0) {
                    if (imm_cnt == 4) {
                        fail_rsp(ERR_LEB);
                    } else {
                    if (imm_cnt == 1) {
                        imm_acc = imm_acc | shl32((scrap_imm & 0x7F) as u32, 7);
                    } else {
                    if (imm_cnt == 2) {
                        imm_acc = imm_acc | shl32((scrap_imm & 0x7F) as u32, 14);
                    } else {
                        imm_acc = imm_acc | shl32((scrap_imm & 0x7F) as u32, 21);
                    }
                    }
                    }
                    imm_cnt = imm_cnt + 1;
                    pc = pc + 1;
                } else {
                    if (imm_cnt == 1) {
                        imm_acc = imm_acc | shl32((scrap_imm & 0x7F) as u32, 7);
                        if ((imm_acc & 0x2000) != 0) {
                            imm_acc = imm_acc | 0xFFFFC000;
                        }
                    } else {
                    if (imm_cnt == 2) {
                        imm_acc = imm_acc | shl32((scrap_imm & 0x7F) as u32, 14);
                        if ((imm_acc & 0x100000) != 0) {
                            imm_acc = imm_acc | 0xFFE00000;
                        }
                    } else {
                    if (imm_cnt == 3) {
                        imm_acc = imm_acc | shl32((scrap_imm & 0x7F) as u32, 21);
                        if ((imm_acc & 0x800000) != 0) {
                            imm_acc = imm_acc | 0xF8000000;
                        }
                    } else {
                        imm_acc = imm_acc | shl32((scrap_imm & 0x7F) as u32, 28);
                    }
                    }
                    }
                    st[sp] = imm_acc;
                    sp = sp + 1;
                    imm_run = 0;
                    pc = pc + 1;
                }
            } else {
            if (sc_run > 0) {
                if (pc >= run_len) {
                    fail_rsp(ERR_PC);
                } else {
                    scrap_imm = code[run_base + pc];
                    if (sc_run == 1) {
                        scrap_cls = scan_class(scrap_imm);
                        if (scrap_cls == 5) {
                            fail_rsp(ERR_OPCODE);
                        } else {
                            pc = pc + 1;
                            if (scrap_cls == 1) {
                                sc_k = 1;
                                sc_run = 2;
                            }
                            if (scrap_cls == 6) {
                                sc_k = 2;
                                sc_run = 2;
                            }
                            if (scrap_cls == 2) {
                                sc_n = sc_n + 1;
                                sc_k = 1;
                                sc_run = 4;
                            }
                            if (scrap_cls == 3) {
                                sc_n = sc_n - 1;
                                if (sc_n == 0) {
                                    sc_run = 0;
                                }
                            }
                            if (scrap_cls == 4) {
                                sc_run = 3;
                            }
                        }
                    } else {
                    if (sc_run == 2) {
                        pc = pc + 1;
                        if ((scrap_imm & 0x80) == 0) {
                            sc_k = sc_k - 1;
                            if (sc_k == 0) {
                                sc_run = 1;
                            }
                        }
                    } else {
                    if (sc_run == 3) {
                        if ((scrap_imm & 0x80) != 0) {
                            fail_rsp(ERR_LEB);
                        } else {
                            sc_k = (scrap_imm as u32) + 1;
                            sc_run = 4;
                            pc = pc + 1;
                        }
                    } else {
                        pc = pc + 1;
                        sc_k = sc_k - 1;
                        if (sc_k == 0) {
                            sc_run = 1;
                        }
                    }
                    }
                    }
                }
            } else {
            if (br_run > 0) {
                if (br_l >= lsp) {
                    fail_rsp(ERR_LABEL);
                } else {
                    scrap_k = lsp - 1 - br_l;
                    scrap_h = lab_h[scrap_k] as u32;
                    scrap_a = lab_ar[scrap_k] as u32;
                    if (sp < scrap_h + scrap_a) {
                        fail_rsp(ERR_STACK);
                    } else {
                        if (scrap_a != 0) {
                            st[scrap_h] = st[sp - 1];
                        }
                        sp = scrap_h + scrap_a;
                        br_run = 0;
                        if (lab_kind[scrap_k] == OP_LOOP) {
                            lsp = scrap_k + 1;
                            pc = lab_tgt[scrap_k] as u32;
                        } else {
                            lsp = scrap_k;
                            sc_n = br_l + 1;
                            sc_run = 1;
                        }
                    }
                }
            } else {
            if (mem_run > 0) {
                if (mem_run <= 2) {
                    if (pc >= run_len) {
                        fail_rsp(ERR_PC);
                    } else {
                        scrap_imm = code[run_base + pc];
                        if (mem_sh == 4 && ((scrap_imm & 0x80) != 0 || (mem_run == 2 && (scrap_imm & 0x70) != 0))) {
                            fail_rsp(ERR_LEB);
                        } else {
                            pc = pc + 1;
                            if (mem_run == 1) {
                                if ((scrap_imm & 0x80) != 0) {
                                    mem_sh = mem_sh + 1;
                                } else {
                                    mem_sh = 0;
                                    mem_acc = 0;
                                    mem_run = 2;
                                }
                            } else {
                                mem_acc = mem_acc | shl32((scrap_imm & 0x7F) as u32, mem_leb_shift(mem_sh));
                                if ((scrap_imm & 0x80) != 0) {
                                    mem_sh = mem_sh + 1;
                                } else {
                                    if (mem_fits(mem_base, mem_acc, mem_w) == 0) {
                                        fail_rsp(ERR_MEM);
                                    } else {
                                        mem_addr = mem_ea(mem_base, mem_acc);
                                        mem_acc = 0;
                                        mem_cnt = 0;
                                        if (mem_pops(mem_op) == 2) {
                                            mem_run = 5;
                                        } else {
                                            mem_run = 3;
                                        }
                                    }
                                }
                            }
                        }
                    }
                } else {
                if (mem_run == 3) {
                    mem_rd = mem[mem_addr];
                    mem_run = 4;
                } else {
                if (mem_run == 4) {
                    mem_acc = (mem_acc >> 8) | ((mem_rd as u32) << 24);
                    mem_cnt = mem_cnt + 1;
                    mem_addr = mem_addr + 1;
                    if (mem_cnt == mem_w) {
                        st[sp] = mem_extend(mem_op, mem_acc);
                        sp = sp + 1;
                        mem_run = 0;
                    } else {
                        mem_run = 3;
                    }
                } else {
                    mem[mem_addr] = (mem_val & 255) as u8;
                    mem_val = mem_val >> 8;
                    mem_cnt = mem_cnt + 1;
                    mem_addr = mem_addr + 1;
                    if (mem_cnt == mem_w) {
                        mem_run = 0;
                    }
                }
                }
                }
            } else {
            if (pc >= run_len || fuel >= FUEL_MAX) {
                if (pc >= run_len) {
                    fail_rsp(ERR_PC);
                } else {
                    fail_rsp(ERR_FUEL);
                }
            } else {
                fuel = fuel + 1;
                scrap_op = code[run_base + pc];
                scrap_n = alu_arity(scrap_op);
                if (scrap_n != 0) {
                    if (sp >= scrap_n) {
                        st[sp - scrap_n] = alu_eval(scrap_op, st[sp - scrap_n], st[sp - 1]);
                        sp = sp + 1 - scrap_n;
                        pc = pc + 1;
                    } else {
                        fail_rsp(ERR_STACK);
                    }
                } else {
                if (scrap_op == OP_BLOCK || scrap_op == OP_LOOP) {
                    scrap_imm = code[run_base + pc + 1];
                    if (scrap_imm != BT_VOID && scrap_imm != BT_I32) {
                        fail_rsp(ERR_OPCODE);
                    } else {
                        if (lsp >= LABEL_MAX) {
                            fail_rsp(ERR_LABEL);
                        } else {
                            lab_kind[lsp] = scrap_op;
                            lab_h[lsp] = sp as u8;
                            lab_tgt[lsp] = (pc + 2) as u8;
                            if (scrap_op == OP_BLOCK && scrap_imm == BT_I32) {
                                lab_ar[lsp] = 1;
                            } else {
                                lab_ar[lsp] = 0;
                            }
                            lsp = lsp + 1;
                            pc = pc + 2;
                        }
                    }
                } else {
                if (scrap_op == OP_BR) {
                    scrap_imm = code[run_base + pc + 1];
                    if ((scrap_imm & 0x80) != 0) {
                        fail_rsp(ERR_LEB);
                    } else {
                        br_l = scrap_imm as u32;
                        br_run = 1;
                    }
                } else {
                if (scrap_op == OP_BR_IF) {
                    scrap_imm = code[run_base + pc + 1];
                    if ((scrap_imm & 0x80) != 0) {
                        fail_rsp(ERR_LEB);
                    } else {
                        if (sp > 0) {
                            if (st[sp - 1] != 0) {
                                br_l = scrap_imm as u32;
                                br_run = 1;
                            } else {
                                pc = pc + 2;
                            }
                            sp = sp - 1;
                        } else {
                            fail_rsp(ERR_STACK);
                        }
                    }
                } else {
                if (scrap_op == OP_BR_TABLE) {
                    scrap_imm = code[run_base + pc + 1];
                    if ((scrap_imm & 0x80) != 0) {
                        fail_rsp(ERR_LEB);
                    } else {
                        if (sp > 0) {
                            scrap_k = st[sp - 1];
                            if (scrap_k > (scrap_imm as u32)) {
                                scrap_k = scrap_imm as u32;
                            }
                            if (pc + 2 + scrap_k >= run_len) {
                                fail_rsp(ERR_PC);
                            } else {
                                scrap_imm = code[run_base + pc + 2 + scrap_k];
                                if ((scrap_imm & 0x80) != 0) {
                                    fail_rsp(ERR_LEB);
                                } else {
                                    br_l = scrap_imm as u32;
                                    br_run = 1;
                                    sp = sp - 1;
                                }
                            }
                        } else {
                            fail_rsp(ERR_STACK);
                        }
                    }
                } else {
                    if (scrap_op == OP_LOCAL_GET) {
                        scrap_imm = code[run_base + pc + 1];
                        if ((scrap_imm as u32) < LOCALS && sp < STACK_MAX) {
                            st[sp] = loc[(scrap_imm as u32)];
                            sp = sp + 1;
                            pc = pc + 2;
                        } else {
                            fail_rsp(ERR_LOCAL);
                        }
                    } else {
                        if (scrap_op == OP_LOCAL_SET) {
                            scrap_imm = code[run_base + pc + 1];
                            if ((scrap_imm as u32) < LOCALS && sp > 0) {
                                loc[(scrap_imm as u32)] = st[sp - 1];
                                sp = sp - 1;
                                pc = pc + 2;
                            } else {
                                fail_rsp(ERR_LOCAL);
                            }
                        } else {
                            if (scrap_op == OP_LOCAL_TEE) {
                                scrap_imm = code[run_base + pc + 1];
                                if ((scrap_imm as u32) < LOCALS && sp > 0) {
                                    loc[(scrap_imm as u32)] = st[sp - 1];
                                    pc = pc + 2;
                                } else {
                                    fail_rsp(ERR_LOCAL);
                                }
                            } else {
                                if (scrap_op == OP_I32_CONST or scrap_op == OP_I64_CONST) {
                                    scrap_imm = code[run_base + pc + 1];
                                    if ((scrap_imm & 0x80) != 0) {
                                        if (sp < STACK_MAX) {
                                            imm_acc = (scrap_imm & 0x7F) as u32;
                                            imm_cnt = 1;
                                            imm_run = 1;
                                            pc = pc + 2;
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    } else {
                                        if (sp < STACK_MAX) {
                                            st[sp] = sleb8(scrap_imm);
                                            sp = sp + 1;
                                            pc = pc + 2;
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    }
                                } else {
                                if (scrap_op == OP_F32_CONST or scrap_op == OP_F64_CONST) {
                                    if (sp < STACK_MAX) {
                                        st[sp] = (code[run_base + pc + 1] as u32);
                                        st[sp] = st[sp] | shl32((code[run_base + pc + 2] as u32), 8);
                                        st[sp] = st[sp] | shl32((code[run_base + pc + 3] as u32), 16);
                                        st[sp] = st[sp] | shl32((code[run_base + pc + 4] as u32), 24);
                                        sp = sp + 1;
                                        if (scrap_op == OP_F32_CONST) {
                                            pc = pc + 5;
                                        } else {
                                            pc = pc + 9;
                                        }
                                    } else {
                                        fail_rsp(ERR_STACK);
                                    }
                                } else {
                                    if (scrap_op == OP_I32_MUL) {
                                        if (sp >= 2) {
                                            mul_a = st[sp - 2];
                                            mul_b = st[sp - 1];
                                            mul_acc = 0;
                                            mul_run = 32;
                                            sp = sp - 1;
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    } else {
                                        if (scrap_op == OP_RETURN) {
                                            if (sp > 0) {
                                                res = st[sp - 1];
                                            } else {
                                                res = 0;
                                            }
                                            ok_rsp();
                                        } else {
                                            if (scrap_op == OP_END) {
                                                if (lsp > 0) {
                                                    lsp = lsp - 1;
                                                    pc = pc + 1;
                                                } else {
                                                    if (sp > 0) {
                                                        res = st[sp - 1];
                                                    } else {
                                                        res = 0;
                                                    }
                                                    ok_rsp();
                                                }
                                            } else {
                                                if (scrap_op == OP_DROP) {
                                                    if (sp > 0) {
                                                        sp = sp - 1;
                                                        pc = pc + 1;
                                                    } else {
                                                        fail_rsp(ERR_STACK);
                                                    }
                                                } else {
                                                    if (scrap_op == OP_SELECT) {
                                                        if (sp >= 3) {
                                                            if (st[sp - 1] == 0) {
                                                                st[sp - 3] = st[sp - 2];
                                                            }
                                                            sp = sp - 2;
                                                            pc = pc + 1;
                                                        } else {
                                                            fail_rsp(ERR_STACK);
                                                        }
                                                    } else {
                                                        if (scrap_op == OP_I32_DIV_U) {
                                                            if (sp >= 2) {
                                                                if (st[sp - 1] == 0) {
                                                                    fail_rsp(ERR_DIV);
                                                                } else {
                                                                    dv_q = st[sp - 2];
                                                                    dv_b = st[sp - 1];
                                                                    dv_negq = 0;
                                                                    dv_negr = 0;
                                                                    dv_rem = 0;
                                                                    dv_run = 32;
                                                                    dv_kind = 0;
                                                                    sp = sp - 1;
                                                                }
                                                            } else {
                                                                fail_rsp(ERR_STACK);
                                                            }
                                                        } else {
                                                            if (scrap_op == OP_I32_DIV_S) {
                                                                if (sp >= 2) {
                                                                    if (st[sp - 1] == 0) {
                                                                        fail_rsp(ERR_DIV);
                                                                    } else {
                                                                        dv_q = abs32(st[sp - 2]);
                                                                        dv_b = abs32(st[sp - 1]);
                                                                        dv_negq = ((st[sp - 2] ^ st[sp - 1]) >> 31) as u8;
                                                                        dv_negr = 0;
                                                                        dv_rem = 0;
                                                                        dv_run = 32;
                                                                        dv_kind = 2;
                                                                        sp = sp - 1;
                                                                    }
                                                                } else {
                                                                    fail_rsp(ERR_STACK);
                                                                }
                                                            } else {
                                                                if (scrap_op == OP_I32_REM_U) {
                                                                    if (sp >= 2) {
                                                                        if (st[sp - 1] == 0) {
                                                                            fail_rsp(ERR_DIV);
                                                                        } else {
                                                                            dv_q = st[sp - 2];
                                                                            dv_b = st[sp - 1];
                                                                            dv_negq = 0;
                                                                            dv_negr = 0;
                                                                            dv_rem = 0;
                                                                            dv_run = 32;
                                                                            dv_kind = 1;
                                                                            sp = sp - 1;
                                                                        }
                                                                    } else {
                                                                        fail_rsp(ERR_STACK);
                                                                    }
                                                                } else {
                                                                    if (scrap_op == OP_I32_REM_S) {
                                                                        if (sp >= 2) {
                                                                            if (st[sp - 1] == 0) {
                                                                                fail_rsp(ERR_DIV);
                                                                            } else {
                                                                                dv_q = abs32(st[sp - 2]);
                                                                                dv_b = abs32(st[sp - 1]);
                                                                                dv_negq = 0;
                                                                                dv_negr = (st[sp - 2] >> 31) as u8;
                                                                                dv_rem = 0;
                                                                                dv_run = 32;
                                                                                dv_kind = 3;
                                                                                sp = sp - 1;
                                                                            }
                                                                        } else {
                                                                            fail_rsp(ERR_STACK);
                                                                        }
                                                                    } else {
                                                                        if (mem_width(scrap_op) != 0) {
                                                                            scrap_n = mem_pops(scrap_op);
                                                                            if (sp >= scrap_n) {
                                                                                mem_op = scrap_op;
                                                                                mem_w = mem_width(scrap_op);
                                                                                mem_base = st[sp - scrap_n];
                                                                                mem_val = st[sp - 1];
                                                                                sp = sp - scrap_n;
                                                                                mem_cnt = 0;
                                                                                mem_sh = 0;
                                                                                mem_acc = 0;
                                                                                mem_run = 1;
                                                                                pc = pc + 1;
                                                                            } else {
                                                                                fail_rsp(ERR_STACK);
                                                                            }
                                                                        } else {
                                                                        if (scrap_op == OP_MEMORY_SIZE || scrap_op == OP_MEMORY_GROW) {
                                                                            if (pc + 1 >= run_len) {
                                                                                fail_rsp(ERR_PC);
                                                                            } else {
                                                                                if (code[run_base + pc + 1] != 0) {
                                                                                    fail_rsp(ERR_MEM);
                                                                                } else {
                                                                                    if (scrap_op == OP_MEMORY_SIZE) {
                                                                                        if (sp < STACK_MAX) {
                                                                                            st[sp] = 1;
                                                                                            sp = sp + 1;
                                                                                            pc = pc + 2;
                                                                                        } else {
                                                                                            fail_rsp(ERR_STACK);
                                                                                        }
                                                                                    } else {
                                                                                        if (sp > 0) {
                                                                                            st[sp - 1] = 0xFFFFFFFF;
                                                                                            pc = pc + 2;
                                                                                        } else {
                                                                                            fail_rsp(ERR_STACK);
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        } else {
                                                                            fail_rsp(ERR_OPCODE);
                                                                        }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                }
                            }
                        }
                    }
                }
                }
                }
                }
                }
            }
            }
            }
            }
            }
            }
            }
        }
    }
    frame_go = 0;
    if (rxnew == 1) {
        if (fstate == 0) {
            if (rxbyte == SYNC0) {
                fstate = 1;
            }
        } else {
            if (fstate == 1) {
                if (rxbyte == SYNC1) {
                    fstate = 2;
                    bidx = 0;
                } else {
                    if (rxbyte == SYNC0) {
                        fstate = 1;
                    } else {
                        fstate = 0;
                    }
                }
            } else {
                body[bidx] = rxbyte;
                if (bidx == 0) {
                    opq = rxbyte;
                }
                if (bidx == 1) {
                    seqq = rxbyte;
                }
                if (bidx == BODY_BYTES - 1) {
                    frame_go = 1;
                    fstate = 0;
                    bidx = 0;
                } else {
                    bidx = bidx + 1;
                }
            }
        }
    }
    rxnew = 0;
    rs2 = rs1;
    rs1 = rs0;
    rs0 = rxd;
    if (rxst == 0) {
        if (rs2 == 0) {
            rxst = 1;
            rxcnt = BAUD_DIV + (BAUD_DIV / 2) - 1;
            rbi = 0;
            rxsr = 0;
        }
    } else {
        if (rxcnt == 0) {
            if (rxst == 1) {
                rxsr = (rxsr >> 1) | ((rs2 as u32) * 128);
                if (rbi == 7) {
                    rxst = 2;
                    rxcnt = BAUD_DIV - 1;
                } else {
                    rbi = rbi + 1;
                    rxcnt = BAUD_DIV - 1;
                }
            } else {
                rxbyte = (rxsr & 255) as u8;
                rxnew = 1;
                rxst = 0;
            }
        } else {
            rxcnt = rxcnt - 1;
        }
    }
}

fn on_clock(rxd : u8) {
    step_all(rxd);
    ticks = ticks + 1;
}

; --- host-side drivers (test-only; loops live here, never in the tick body)
fn req_byte(op : u8, seq : u8, x : u32, y : u32, k : u32) -> u8 {
    if (k == 0) { return SYNC0; }
    if (k == 1) { return SYNC1; }
    if (k == 2) { return op; }
    if (k == 3) { return seq; }
    if (k == 4) { return 0; }
    if (k == 5) { return 0; }
    if (k < 10) { return ((x >> ((k - 6) * 8)) & 255) as u8; }
    if (k < 22) { return 0; }
    if (k < 26) { return ((y >> ((k - 22) * 8)) & 255) as u8; }
    return 0;
}

fn frame_bit(op : u8, seq : u8, x : u32, y : u32, j : u32) -> u8 {
    var pos : u32 = j % 10;
    var byt : u8 = req_byte(op, seq, x, y, j / 10);
    if (pos == 0) { return 0; }
    if (pos == 9) { return 1; }
    return ((byt >> (pos - 1)) & 1) as u8;
}

; Send one request: every wire bit held BAUD_DIV ticks, start low, stop high.
fn host_send(op : u8, seq : u8, x : u32, y : u32) {
    var j : u32 = 0;
    while (j < 10 * REQ_BYTES) {
        var n : u32 = 0;
        var b : u8 = frame_bit(op, seq, x, y, j);
        while (n < BAUD_DIV) {
            step_all(b);
            n = n + 1;
        }
        j = j + 1;
    }
}

; Receive one response into cap[0..4]. Per byte: wait for the falling start edge on
; txd, step 1.5 bit-times to the middle of data bit 0, sample 8 data bits one bit-time
; apart (little-endian within the byte). The last sample leaves the sampler at the
; stop bit middle; the next wait-start loop consumes the rest of the stop bit and any
; idle gap, so the next falling edge is a real start, never a sampled data bit. Returns
; 0 on success, 1 on silence past the timeout.
fn host_recv() -> u32 {
    var t : u32 = 0;
    var bi : u32 = 0;
    var bit : u32 = 0;
    var acc : u32 = 0;
    var n : u32 = 0;
    while (bi < (RESP_BYTES as u32)) {
        t = 0;
        while ((txd & 1) == 1) {
            step_all(1);
            t = t + 1;
            if (t > 30000) {
                return 1;
            }
        }
        n = 0;
        while (n < BAUD_DIV + (BAUD_DIV / 2)) {
            step_all(1);
            n = n + 1;
        }
        acc = 0;
        bit = 0;
        while (bit < 8) {
            if ((txd & 1) == 1) {
                acc = acc | ((1 as u32) << bit);
            }
            n = 0;
            while (n < BAUD_DIV) {
                step_all(1);
                n = n + 1;
            }
            bit = bit + 1;
        }
        cap[bi] = acc as u8;
        bi = bi + 1;
    }
    return 0;
}

; One full exchange; returns the host_recv status.
fn host_xchg(op : u8, seq : u8, x : u32, y : u32) -> u32 {
    host_send(op, seq, x, y);
    return host_recv();
}

; --- P2 wire loaders and the run-user exchange ---------------------------------------------
; OP 0xFE LOAD_PAGE: the page number rides the SEQ slot, body[4..35] carries 32 code
; bytes straight out of uprog -- host-side indexing may use *, these functions are
; interpreter-only and never reach the Verilog (the cap[8]u8 precedent). OP 0xFD
; RUN_USER: len and off ride body[2..3], operands keep the k=6.. x/y placement.
fn load_byte(page : u8, k : u32) -> u8 {
    if (k == 0) { return SYNC0; }
    if (k == 1) { return SYNC1; }
    if (k == 2) { return OP_LOAD_PAGE; }
    if (k == 3) { return page; }
    if (k < 6) { return 0; }
    if ((page as u32) < CODE_PAGES && k < 6 + PAGE_BYTES) {
        return uprog[((page as u32) * PAGE_BYTES) + (k - 6)];
    }
    return 0;
}

fn load_bit(page : u8, j : u32) -> u8 {
    var pos : u32 = j % 10;
    var byt : u8 = load_byte(page, j / 10);
    if (pos == 0) { return 0; }
    if (pos == 9) { return 1; }
    return ((byt >> (pos - 1)) & 1) as u8;
}

; Push one 32-byte page over the wire; returns the host_recv status.
fn host_load(page : u8) -> u32 {
    var j : u32 = 0;
    while (j < 10 * REQ_BYTES) {
        var n : u32 = 0;
        var b : u8 = load_bit(page, j);
        while (n < BAUD_DIV) {
            step_all(b);
            n = n + 1;
        }
        j = j + 1;
    }
    return host_recv();
}

fn user_byte(len : u8, off : u8, seq : u8, x : u32, y : u32, k : u32) -> u8 {
    if (k == 0) { return SYNC0; }
    if (k == 1) { return SYNC1; }
    if (k == 2) { return OP_RUN_USER; }
    if (k == 3) { return seq; }
    if (k == 4) { return len; }
    if (k == 5) { return off; }
    return req_byte(0, 0, x, y, k);
}

fn user_bit(len : u8, off : u8, seq : u8, x : u32, y : u32, j : u32) -> u8 {
    var pos : u32 = j % 10;
    var byt : u8 = user_byte(len, off, seq, x, y, j / 10);
    if (pos == 0) { return 0; }
    if (pos == 9) { return 1; }
    return ((byt >> (pos - 1)) & 1) as u8;
}

; Host side: step the clock until the cell starts answering or bound steps pass. A run that
; finished inside the request's last byte (every straight-line program) adds no steps; a
; looping program runs here, not against host_recv's 30000-step silence bound. 8 * FUEL_MAX
; covers every run in this file (a fetch is two clocks under the phase gate, a branch two
; engine steps); a run of 65536 mul sequences would outlast it and read as silence -- that is
; the host runner's bound, not the cell's.
fn host_await(bound : u32) {
    var t : u32 = 0;
    while (responding == 0 && t < bound) {
        step_all(1);
        t = t + 1;
    }
}

; Run len bytes of the loaded image at offset off; returns the host_recv status.
fn host_run_user(len : u8, off : u8, seq : u8, x : u32, y : u32) -> u32 {
    var j : u32 = 0;
    while (j < 10 * REQ_BYTES) {
        var n : u32 = 0;
        var b : u8 = user_bit(len, off, seq, x, y, j);
        while (n < BAUD_DIV) {
            step_all(b);
            n = n + 1;
        }
        j = j + 1;
    }
    host_await(8 * FUEL_MAX);
    return host_recv();
}

; --- the ALU sweep (issue #12011): closed forms written here, never read from alu_eval ----
; Every function below is host-side only (loops, `*` and `%` are fine; none is called from
; step_all, so none reaches the Verilog -- the host_run_user precedent). The expected value
; of every swept opcode is rebuilt from arithmetic on u64 and from single bits, so the
; shared alu_eval is never its own oracle.
fn ref_pow2(k : u32) -> u64 {
    var r : u64 = 1;
    var i : u32 = 0;
    while (i < k) {
        r = r + r;
        i = i + 1;
    }
    return r;
}

fn ref_bit(v : u32, i : u32) -> u32 {
    var q : u64 = (v as u64) / ref_pow2(i);
    return (q % 2) as u32;
}

; signed less-than from the two sign bits, not from the bias trick lt_s32 uses
fn ref_lt_s(x : u32, y : u32) -> u32 {
    var sx : u32 = ref_bit(x, 31);
    var sy : u32 = ref_bit(y, 31);
    if (sx != sy) { return sx; }
    if (x < y) { return 1; }
    return 0;
}

fn ref_bits_op(kind : u32, x : u32, y : u32) -> u32 {
    var r : u64 = 0;
    var i : u32 = 0;
    var bx : u32 = 0;
    var by : u32 = 0;
    var bz : u32 = 0;
    while (i < 32) {
        bx = ref_bit(x, i);
        by = ref_bit(y, i);
        if (kind == 0) { bz = bx * by; }
        if (kind == 1) { bz = bx + by - (bx * by); }
        if (kind == 2) { bz = (bx + by) % 2; }
        r = r + ((bz as u64) * ref_pow2(i));
        i = i + 1;
    }
    return r as u32;
}

; 1 for the opcodes that read one operand (eqz, clz, ctz, popcnt), 0 for the binary ones
fn ref_unary(op : u8) -> u32 {
    if (op == 0x45) { return 1; }
    if (op >= 0x67 && op <= 0x69) { return 1; }
    return 0;
}

; 1 exactly for the 24 single-clock i32 ALU bytes: eqz, the ten compares, clz ctz popcnt,
; add, sub, and the eight bitwise/shift/rotate bytes
fn ref_is_alu(b : u32) -> u32 {
    if (b >= 0x45 && b <= 0x4F) { return 1; }
    if (b >= 0x67 && b <= 0x6B) { return 1; }
    if (b >= 0x71 && b <= 0x78) { return 1; }
    return 0;
}

fn ref_alu(op : u8, x : u32, y : u32) -> u32 {
    var k : u32 = y % 32;
    var m : u64 = 4294967296;
    var xw : u64 = x as u64;
    var yw : u64 = y as u64;
    var i : u32 = 0;
    var n : u32 = 0;
    if (op == OP_I32_EQZ) { if (x == 0) { return 1; } return 0; }
    if (op == OP_I32_EQ) { if (x == y) { return 1; } return 0; }
    if (op == OP_I32_NE) { if (x != y) { return 1; } return 0; }
    if (op == OP_I32_LT_S) { return ref_lt_s(x, y); }
    if (op == OP_I32_GT_S) { return ref_lt_s(y, x); }
    if (op == OP_I32_LE_S) { return 1 - ref_lt_s(y, x); }
    if (op == OP_I32_GE_S) { return 1 - ref_lt_s(x, y); }
    if (op == OP_I32_LT_U) { if (x < y) { return 1; } return 0; }
    if (op == OP_I32_GT_U) { if (x > y) { return 1; } return 0; }
    if (op == OP_I32_LE_U) { if (x <= y) { return 1; } return 0; }
    if (op == OP_I32_GE_U) { if (x >= y) { return 1; } return 0; }
    if (op == OP_I32_CLZ) {
        while (i < 32) {
            if (ref_bit(x, 31 - i) == 1) { return i; }
            i = i + 1;
        }
        return 32;
    }
    if (op == OP_I32_CTZ) {
        while (i < 32) {
            if (ref_bit(x, i) == 1) { return i; }
            i = i + 1;
        }
        return 32;
    }
    if (op == OP_I32_POPCNT) {
        while (i < 32) {
            n = n + ref_bit(x, i);
            i = i + 1;
        }
        return n;
    }
    if (op == OP_I32_ADD) { return ((xw + yw) % m) as u32; }
    if (op == OP_I32_SUB) {
        if (x >= y) { return x - y; }
        return ((xw + m) - yw) as u32;
    }
    if (op == OP_I32_AND) { return ref_bits_op(0, x, y); }
    if (op == OP_I32_OR) { return ref_bits_op(1, x, y); }
    if (op == OP_I32_XOR) { return ref_bits_op(2, x, y); }
    if (op == OP_I32_SHL) { return ((xw * ref_pow2(k)) % m) as u32; }
    if (op == OP_I32_SHR_U) { return (xw / ref_pow2(k)) as u32; }
    if (op == OP_I32_SHR_S) {
        var q : u64 = xw / ref_pow2(k);
        if (k > 0 && ref_bit(x, 31) == 1) {
            q = q + (m - ref_pow2(32 - k));
        }
        return q as u32;
    }
    if (op == OP_I32_ROTL) {
        return (((xw * ref_pow2(k)) % m) + (xw / ref_pow2(32 - k))) as u32;
    }
    if (op == OP_I32_ROTR) {
        return ((xw / ref_pow2(k)) + ((xw % ref_pow2(k)) * ref_pow2(32 - k))) as u32;
    }
    return 0;
}

; the 24 swept opcodes by index: eqz, clz ctz popcnt, the ten compares, add, sub, then the
; eight bitwise/shift/rotate bytes; the arity test pins that these 24 are exactly what
; alu_arity accepts
fn alu_op_at(i : u32) -> u8 {
    if (i == 0) { return 0x45; }
    if (i < 4) { return (0x67 + (i - 1)) as u8; }
    if (i < 14) { return (0x46 + (i - 4)) as u8; }
    if (i == 14) { return 0x6A; }
    if (i == 15) { return 0x6B; }
    return (0x71 + (i - 16)) as u8;
}

; the ten opcodes that have a signed/unsigned twin: lt gt le ge (signed byte first) and shr
fn pair_op_at(j : u32) -> u8 {
    if (j < 8) { return (0x48 + j) as u8; }
    if (j == 8) { return 0x75; }
    return 0x76;
}

fn pair_partner(op : u8) -> u8 {
    if (op == 0x75) { return 0x76; }
    if (op == 0x76) { return 0x75; }
    if (op == 0x48 || op == 0x4A || op == 0x4C || op == 0x4E) { return op + 1; }
    return op - 1;
}

; sixteen operand pairs: the edges 0 1 31 32 0x7FFFFFFF 0x80000000 0xFFFFFFFF in both
; positions that matter, a shift count past 32, and one unstructured word
fn sw_x(p : u32) -> u32 {
    if (p == 0) { return 0; }
    if (p == 1) { return 1; }
    if (p == 2) { return 0; }
    if (p == 3) { return 1; }
    if (p == 4) { return 31; }
    if (p == 5) { return 32; }
    if (p == 6) { return 1; }
    if (p == 7) { return 1; }
    if (p == 8) { return 0x7FFFFFFF; }
    if (p == 9) { return 0x80000000; }
    if (p == 10) { return 0xFFFFFFFF; }
    if (p == 11) { return 0x80000000; }
    if (p == 12) { return 0xFFFFFFFF; }
    if (p == 13) { return 0x7FFFFFFF; }
    if (p == 14) { return 0x80000001; }
    return 0xDEADBEEF;
}

fn sw_y(p : u32) -> u32 {
    if (p == 0) { return 0; }
    if (p == 1) { return 0; }
    if (p == 2) { return 1; }
    if (p == 3) { return 1; }
    if (p == 4) { return 1; }
    if (p == 5) { return 1; }
    if (p == 6) { return 31; }
    if (p == 7) { return 32; }
    if (p == 8) { return 1; }
    if (p == 9) { return 1; }
    if (p == 10) { return 1; }
    if (p == 11) { return 0xFFFFFFFF; }
    if (p == 12) { return 0x80000000; }
    if (p == 13) { return 0x80000000; }
    if (p == 14) { return 33; }
    return 0xFFFFFFFF;
}

; Poke the smallest program for op into the code store at 104 (`local.get 0 [local.get 1]
; op end`), run it with x and y as the two locals; returns 0 when the answer was RESP_OK
; with the echoed seq, 1 otherwise. The full 32-bit result is left in `res`.
fn run_alu(op : u8, x : u32, y : u32, seq : u8) -> u32 {
    var len : u8 = 6;
    code[104] = 0x20;
    code[105] = 0x00;
    if (ref_unary(op) == 1) {
        code[106] = op;
        code[107] = 0x0B;
        len = 4;
    } else {
        code[106] = 0x20;
        code[107] = 0x01;
        code[108] = op;
        code[109] = 0x0B;
    }
    var r : u32 = host_run_user(len, 104, seq, x, y);
    if (r != 0) { return 1; }
    if (cap[0] != RESP_OK) { return 1; }
    if (cap[1] != seq) { return 1; }
    return 0;
}

; --- vectors, per program ----------------------------------------------------------------
; Pinned: two per program, chosen to cross the signed boundary and the constant path.
; Random: eight per program, splitmix64 from RANDOM_SEED, operands full u32; the golden
; for every vector is the host interpreter over the same ROM bytes. Errors: the illegal
; opcode body and an unknown OP. Wrap: two vectors whose full result leaves 24 bits.
pub const RANDOM_SEED : u32 = 20261012;
pub const PINNED_PER_PROG : u8 = 2;
pub const RANDOM_PER_PROG : u8 = 8;
pub const ERROR_VECS : u8 = 2;
pub const WRAP_VECS : u8 = 2;
pub const WIRE_PROGS : u8 = 13;
; P2 over the wire: four page loads, twenty-one user-program runs, four errors --
; a bad page, a run past the image, a divide by zero and a six-byte LEB.
pub const P2_VECS : u32 = 29;
pub const TOTAL_REQUESTS : u32 = 163;

; --- cost, pre-registered before any synthesis -------------------------------------------
; The engine is a 55-byte decode (24 ALU bytes through the shared alu_arity/alu_eval pair
; since #12011, 18 other arms -- the const arm takes i32.const and i64.const, the float arm
; f32.const and f64.const, since P3/P4; block and loop share one arm, br, br_if and br_table
; have their own, since #12010 -- and 10 memory bytes through two arms since P5 #12202), a
; 16-deep 32-bit stack, a 4-deep local file, a 32-clock restoring divider, two rotators, a
; loadable 128-byte code RAM and, since P5, one 64 KiB memory page; the UART is
; counters and shifters. Measured: yosys logic cells of the generated module alone.
; Predicted: under PREDICT_LUT_MAX; a larger count refutes it.
; REFUTED on synthesis: 10425 yosys LUTs for the module alone (10814 SLICE_LUTX in
; nextpnr with the bring-up top). The loadable store costs more than the ROM it
; replaced -- 128 writable bytes (1024 bits) with a runtime-indexed fetch mux and flat page
; stores -- and the rotators lower as 64-bit barrels. Both bounds below are the
; measured numbers; the pre-registration stands as the refuted original.
pub const PREDICT_LUT_MAX : u32 = 7000;
pub const MEASURED_LUT_CORE : u32 = 10425;
pub const MEASURED_LUT_PNR : u32 = 10814;

; --- run and pass rule --------------------------------------------------------------------
pub const RUN_NAME : str = "wasm_board_ax7203";
pub const RUN_LIMIT_S : u16 = 600;
pub const PASS_LINE : str = "WASM BOARD RESULT: 163/163 responses exact (fails=0, lost=0)";
pub const SIM_PASS_LINE : str = "WASM BOARD SIM: 21/21 checks green";

test opcode_bytes_are_real_wasm {
    assert OP_END == 0x0B;
    assert OP_RETURN == 0x0F;
    assert OP_LOCAL_GET == 0x20;
    assert OP_LOCAL_SET == 0x21;
    assert OP_LOCAL_TEE == 0x22;
    assert OP_I32_CONST == 0x41;
    assert OP_I32_EQZ == 0x45;
    assert OP_I32_EQ == 0x46;
    assert OP_I32_NE == 0x47;
    assert OP_I32_LT_S == 0x48;
    assert OP_I32_GT_S == 0x4A;
    assert OP_I32_LE_S == 0x4C;
    assert OP_I32_GE_S == 0x4E;
    assert OP_I32_ADD == 0x6A;
    assert OP_I32_SUB == 0x6B;
    assert OP_I32_MUL == 0x6C;
    assert OP_I32_AND == 0x71;
    assert OP_I32_OR == 0x72;
    assert OP_I32_XOR == 0x73;
    assert OP_I32_SHL == 0x74;
    assert OP_I32_SHR_S == 0x75;
    assert WIRE_PROGS + 1 == PROGS;
    assert sp == 0;
    assert ms == 0;
}

; add_double is the body of trinity-fpga src/b2t/test_add.wat, byte for byte:
; local.get 0, local.get 1, i32.add, i32.const 2, i32.mul, end. Call results are
; bound to a local before any assert: a call as a direct assert operand
; mis-evaluates in the test backend.
test first_bytes_match_the_wat {
    var o : u32 = 0;
    var l : u32 = 0;
    assert code[0] == 0x20;
    assert code[1] == 0x00;
    assert code[2] == 0x20;
    assert code[3] == 0x01;
    assert code[4] == 0x6A;
    assert code[5] == 0x41;
    assert code[6] == 0x02;
    assert code[7] == 0x6C;
    assert code[8] == 0x0B;
    o = prog_off(ID_ADD_DOUBLE);
    assert o == 0;
    l = prog_len(ID_ADD_DOUBLE);
    assert l == 9;
    o = prog_off(ID_ANSWER);
    assert code[o] == 0x41;
    assert code[o + 1] == 0x2A;
    o = prog_off(ID_XMUL_NOT);
    assert code[o + 6] == 0x7F;
    o = prog_off(ID_BAD);
    assert code[o + 2] == 0xFF;
}

test prog_table_fits_the_rom {
    var p : u32 = 0;
    var tail : u32 = 0;
    while (p < PROGS as u32) {
        tail = prog_off(p as u8) + prog_len(p as u8);
        assert prog_off(p as u8) < tail;
        assert tail <= CODE_BYTES;
        if (p + 1 < PROGS as u32) {
            assert prog_off((p + 1) as u8) == tail;
        }
        p = p + 1;
    }
    assert tail == CODE_BYTES;
    assert CODE_BYTES <= CODE_PAD;
    assert code[CODE_BYTES] == 0;
    assert code[CODE_PAD - 1] == 0;
}

test wire_is_the_node_link {
    assert WIRE_BAUD == CP2102N_REF_HZ / CP2102N_N;
    assert WIRE_BAUD * BAUD_DIV >= CFGMCLK_MIN_HZ;
    assert WIRE_BAUD * BAUD_DIV <= CFGMCLK_MAX_HZ;
    assert HOST_BAUD > WIRE_BAUD;
    assert REQ_BYTES == 2 + BODY_BYTES;
    assert REQ_BYTES == 6 + 16 + 16;
    assert RESP_BYTES == 2 + 3;
    assert WORD_BITS == 24;
    assert SYNC0 == 170;
    assert SYNC1 == 85;
    assert RESP_OK == 165;
    assert RESP_BADOP == 229;
    assert X_OFF == 4;
    assert Y_OFF == 20;
    assert LABEL_MAX == 8;
    assert FUEL_MAX == 65536;
    assert ERR_LABEL == 8;
    assert ERR_FUEL == 9;
    assert ERR_MEM == 10;
    assert TOTAL_REQUESTS * (REQ_BYTES + (RESP_BYTES as u32)) * 10 < (RUN_LIMIT_S as u32) * WIRE_BAUD;
    assert tcnt == BAUD_DIV - 1;
}

test one_response_never_overruns {
    assert (RESP_BYTES as u32) * 10 + 10 < REQ_BYTES * 10;
    assert TOTAL_REQUESTS == (WIRE_PROGS as u32) * (((PINNED_PER_PROG + RANDOM_PER_PROG) as u32)) + (ERROR_VECS as u32) + (WRAP_VECS as u32) + P2_VECS;
    assert txidx == 0;
}

test machine_consts {
    assert STACK_MAX == 16;
    assert LOCALS == 4;
    assert MEM_BYTES == 65536;
    assert ERR_MEM == 10;
    assert (ID_SET_GET as u32) < PROGS as u32;
    assert (ID_TEE_DUP as u32) < PROGS as u32;
    assert (ID_BAD as u32) < PROGS as u32;
    assert responding == 0;
}

test leb_and_signed_helpers {
    assert sleb8(0x2A) == 42;
    assert sleb8(0x7F) == 0xFFFFFFFF;
    assert sleb8(0x40) == 0xFFFFFFC0;
    assert sleb8(0x3F) == 63;
    assert wrap32(0x100000000) == 0;
    assert wrap32(4294967295) == 4294967295;
    assert lt_s32(0xFFFFFFFF, 1) == 1;
    assert lt_s32(1, 0xFFFFFFFF) == 0;
    assert lt_s32(5, 5) == 0;
    assert shl32(1, 4) == 16;
    assert shl32(1, 33) == 2;
    assert sar32(0xFFFFFFF8, 1) == 0xFFFFFFFC;
    assert sar32(0xFFFFFFF8, 0) == 0xFFFFFFF8;
    assert sar32(8, 2) == 2;
}

; add_double(20, 22) = (20 + 22) * 2 = 84; SEQ 7 is echoed; the word is 84.
; Frame counts use a per-block delta, so the block is correct whether tests share
; module state or start fresh.
test roundtrip_add_double {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_xchg(ID_ADD_DOUBLE, 7, 20, 22);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 7;
    assert cap[2] == 84;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert err == 0;
    assert frames - f0 == 1;
    assert drops == 0;
}

; One pinned vector per remaining program, through the whole wire.
test roundtrip_thirteen_programs {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_xchg(ID_ANSWER, 1, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 1;
    assert cap[2] == 42;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_XMUL_NOT, 2, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 2;
    assert cap[2] == 0xF5;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_xchg(ID_SUB_AND_OR, 3, 12, 10);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 3;
    assert cap[2] == 10;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_SHL_SAR, 4, 3, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 4;
    assert cap[2] == 12;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_EQ, 5, 7, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 5;
    assert cap[2] == 1;
    r = host_xchg(ID_NE, 6, 7, 8);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 6;
    assert cap[2] == 1;
    r = host_xchg(ID_LE_S, 7, 5, 9);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 7;
    assert cap[2] == 1;
    r = host_xchg(ID_GE_S, 8, 0xFFFFFFFB, 0xFFFFFFF7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 8;
    assert cap[2] == 1;
    r = host_xchg(ID_EQZ, 9, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 9;
    assert cap[2] == 1;
    r = host_xchg(ID_GT_S, 10, 3, 9);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 10;
    assert cap[2] == 0;
    r = host_xchg(ID_SET_GET, 11, 4, 5);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 11;
    assert cap[2] == 17;
    r = host_xchg(ID_TEE_DUP, 12, 21, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 12;
    assert cap[2] == 42;
    assert frames - f0 == 12;
    assert drops == 0;
}

test roundtrip_errors {
    var r : u32 = 0;
    r = host_xchg(ID_BAD, 20, 1, 2);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 20;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert err == ERR_OPCODE;
    r = host_xchg(99, 21, 1, 2);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 21;
    assert cap[2] == 0;
    assert err == ERR_PROG;
}

; Two vectors whose full result leaves the 24-bit word: the add_double wrap to zero and
; the negative -2. The wire shows the low 24 bits; the full u32 is pinned by the MVP.
test roundtrip_wrap {
    var r : u32 = 0;
    r = host_xchg(ID_ADD_DOUBLE, 30, 0x7FFFFFFF, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 30;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_SUB_AND_OR, 31, 0, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 31;
    assert cap[2] == 0xFF;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
}

; --- issue #12011: the single-clock ALU is one function pair; these tests are its proof ----
; The oracle is pinned by literals first, so a wrong closed form cannot hide behind a
; matching wrong cell.
test alu_oracle_goldens {
    var a : u32 = 0;
    a = ref_alu(OP_I32_SUB, 0, 1);
    assert a == 0xFFFFFFFF;
    a = ref_alu(OP_I32_ADD, 0xFFFFFFFF, 1);
    assert a == 0;
    a = ref_alu(OP_I32_SHL, 1, 33);
    assert a == 2;
    a = ref_alu(OP_I32_SHL, 0x80000001, 1);
    assert a == 2;
    a = ref_alu(OP_I32_SHR_S, 0x80000000, 1);
    assert a == 0xC0000000;
    a = ref_alu(OP_I32_SHR_S, 0xFFFFFFFF, 31);
    assert a == 0xFFFFFFFF;
    a = ref_alu(OP_I32_SHR_S, 0x80000000, 32);
    assert a == 0x80000000;
    a = ref_alu(OP_I32_SHR_U, 0x80000000, 31);
    assert a == 1;
    a = ref_alu(OP_I32_ROTL, 0x80000001, 1);
    assert a == 3;
    a = ref_alu(OP_I32_ROTR, 1, 1);
    assert a == 0x80000000;
    a = ref_alu(OP_I32_ROTL, 0xDEADBEEF, 0);
    assert a == 0xDEADBEEF;
    a = ref_alu(OP_I32_ROTR, 0xDEADBEEF, 32);
    assert a == 0xDEADBEEF;
    a = ref_alu(OP_I32_CLZ, 0, 0);
    assert a == 32;
    a = ref_alu(OP_I32_CLZ, 1, 0);
    assert a == 31;
    a = ref_alu(OP_I32_CLZ, 0x80000000, 0);
    assert a == 0;
    a = ref_alu(OP_I32_CTZ, 0, 0);
    assert a == 32;
    a = ref_alu(OP_I32_CTZ, 0x80000000, 0);
    assert a == 31;
    a = ref_alu(OP_I32_POPCNT, 0xFFFFFFFF, 0);
    assert a == 32;
    a = ref_alu(OP_I32_POPCNT, 0xDEADBEEF, 0);
    assert a == 24;
    a = ref_alu(OP_I32_LT_S, 0xFFFFFFFF, 0);
    assert a == 1;
    a = ref_alu(OP_I32_LT_U, 0xFFFFFFFF, 0);
    assert a == 0;
    a = ref_alu(OP_I32_GE_S, 0x80000000, 1);
    assert a == 0;
    a = ref_alu(OP_I32_GT_S, 1, 0x80000000);
    assert a == 1;
    a = ref_alu(OP_I32_AND, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0xF000F000;
    a = ref_alu(OP_I32_OR, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0xFFF0FFF0;
    a = ref_alu(OP_I32_XOR, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0x0FF00FF0;
    a = ref_alu(OP_I32_EQZ, 0, 7);
    assert a == 1;
    a = ref_alu(OP_I32_EQZ, 5, 0);
    assert a == 0;
    a = ref_alu(OP_I32_EQ, 3, 3);
    assert a == 1;
    a = ref_alu(OP_I32_NE, 3, 3);
    assert a == 0;
}

; alu_arity accepts exactly the 24 single-clock ALU bytes, names the right arity for each,
; and the 24 swept indices cover those bytes once each.
test alu_arity_pins {
    var b : u32 = 0;
    var a : u32 = 0;
    var want : u32 = 0;
    var bad : u32 = 0;
    var accepted : u32 = 0;
    var sum : u32 = 0;
    var i : u32 = 0;
    var cnt : u32 = 0;
    var cover : u32 = 0;
    while (b < 256) {
        a = alu_arity(b as u8);
        want = 0;
        if (ref_is_alu(b) == 1) {
            want = 2;
            if (ref_unary(b as u8) == 1) { want = 1; }
        }
        if (a != want) { bad = bad + 1; }
        if (a != 0) {
            accepted = accepted + 1;
            sum = sum + a;
            cnt = 0;
            i = 0;
            while (i < 24) {
                if ((alu_op_at(i) as u32) == b) { cnt = cnt + 1; }
                i = i + 1;
            }
            if (cnt != 1) { cover = cover + 1; }
        }
        b = b + 1;
    }
    assert bad == 0;
    assert accepted == 24;
    assert sum == 44;
    assert cover == 0;
    a = alu_arity(OP_I32_MUL);
    assert a == 0;
    a = alu_arity(OP_I32_DIV_S);
    assert a == 0;
    a = alu_arity(OP_I32_DIV_U);
    assert a == 0;
    a = alu_arity(OP_I32_REM_S);
    assert a == 0;
    a = alu_arity(OP_I32_REM_U);
    assert a == 0;
    a = alu_arity(OP_I32_CONST);
    assert a == 0;
    a = alu_arity(OP_LOCAL_GET);
    assert a == 0;
    a = alu_arity(OP_END);
    assert a == 0;
    a = alu_arity(OP_SELECT);
    assert a == 0;
}

; 24 opcodes x 16 operand pairs = 384 cells run through the wire; the full 32-bit result of
; each is compared with the closed form above.
test alu_sweep_closed_forms {
    var f0 : u32 = frames;
    var i : u32 = 0;
    var p : u32 = 0;
    var cmp : u32 = 0;
    var bad : u32 = 0;
    var op : u8 = 0;
    var x : u32 = 0;
    var y : u32 = 0;
    var s : u32 = 0;
    var v : u32 = 0;
    var want : u32 = 0;
    while (i < 24) {
        op = alu_op_at(i);
        p = 0;
        while (p < 16) {
            x = sw_x(p);
            y = sw_y(p);
            s = run_alu(op, x, y, (cmp & 255) as u8);
            v = res;
            want = ref_alu(op, x, y);
            if (s != 0) { bad = bad + 1; }
            if (v != want) { bad = bad + 1; }
            cmp = cmp + 1;
            p = p + 1;
        }
        i = i + 1;
    }
    assert cmp == 384;
    assert bad == 0;
    assert frames - f0 == 384;
}

; Negative control: the same sweep against the signed/unsigned PARTNER's closed form must
; disagree for every one of the ten twin opcodes, or the sweep cannot tell signedness apart.
test alu_sweep_signedness_negative_control {
    var j : u32 = 0;
    var p : u32 = 0;
    var op : u8 = 0;
    var x : u32 = 0;
    var y : u32 = 0;
    var s : u32 = 0;
    var v : u32 = 0;
    var want : u32 = 0;
    var per : u32 = 0;
    var total : u32 = 0;
    var weak : u32 = 0;
    var sbad : u32 = 0;
    while (j < 10) {
        op = pair_op_at(j);
        per = 0;
        p = 0;
        while (p < 16) {
            x = sw_x(p);
            y = sw_y(p);
            s = run_alu(op, x, y, (p + 100) as u8);
            v = res;
            want = ref_alu(pair_partner(op), x, y);
            if (s != 0) { sbad = sbad + 1; }
            if (v != want) { per = per + 1; }
            p = p + 1;
        }
        if (per == 0) { weak = weak + 1; }
        total = total + per;
        j = j + 1;
    }
    assert sbad == 0;
    assert weak == 0;
    assert total >= 5;
}

; The bytes the cell executes (55: the 40 of #12011 and P3/P4 -- 24 ALU, mul and the four
; div/rem, the four const bytes 0x41-0x44, local.get/set/tee, return, end, drop, select --
; plus block, loop, br, br_if, br_table of #12010, plus the ten memory bytes of P5 #12202:
; i32.load, the four 8/16-bit loads, i32.store, store8, store16, memory.size, memory.grow)
; are independent of the ALU pair: every other byte of the opcode space -- 0x29 i64.load
; among them, a generated byte of the table the cell does not run -- answers RESP_BADOP with
; ERR_OPCODE, as before the refactor.
fn cell_runs(b : u32) -> u32 {
    if (ref_is_alu(b) == 1) { return 1; }
    if (b >= 0x6C && b <= 0x70) { return 1; }
    if (b >= 0x20 && b <= 0x22) { return 1; }
    if (b >= 0x41 && b <= 0x44) { return 1; }
    if (b == 0x0B || b == 0x0F || b == 0x1A || b == 0x1B) { return 1; }
    if (b == 0x02 || b == 0x03 || b == 0x0C || b == 0x0D || b == 0x0E) { return 1; }
    if (b == 0x28 || (b >= 0x2C && b <= 0x2F)) { return 1; }
    if (b == 0x36 || b == 0x3A || b == 0x3B || b == 0x3F || b == 0x40) { return 1; }
    return 0;
}

test alu_unexecuted_bytes_are_opcode_errors {
    var f0 : u32 = frames;
    var b : u32 = 0;
    var runs : u32 = 0;
    var tried : u32 = 0;
    var bad : u32 = 0;
    var r : u32 = 0;
    var c : u32 = 0;
    while (b < 256) {
        c = cell_runs(b);
        if (c == 1) {
            runs = runs + 1;
        } else {
            code[104] = b as u8;
            code[105] = 0x0B;
            r = host_run_user(2, 104, (tried & 255) as u8, 5, 6);
            if (r != 0) { bad = bad + 1; }
            if (cap[0] != RESP_BADOP) { bad = bad + 1; }
            if (cap[1] != (tried & 255) as u8) { bad = bad + 1; }
            if (err != ERR_OPCODE) { bad = bad + 1; }
            tried = tried + 1;
        }
        b = b + 1;
    }
    c = cell_runs(0x28);
    assert c == 1;
    c = cell_runs(0x29);
    assert c == 0;
    assert runs == 55;
    assert tried == 201;
    assert bad == 0;
    assert frames - f0 == 201;
}

; --- control flow (issue #12010) ----------------------------------------------------------
; Host side: copy n bytes of the cfprog ROM from src into the code store at base, the same
; bytes OP_LOAD_PAGE page 3 carries on the board; cf_restore puts back the last six baked
; bytes (the tail of ID_TEE_DUP and all of ID_BAD) after a program that overwrote them, and
; cf_restore_keeps_the_baked_programs at the end proves the restore.
fn cf_poke(src : u32, base : u32, n : u32) {
    var i : u32 = 0;
    while (i < n) {
        code[base + i] = cfprog[src + i];
        i = i + 1;
    }
}

fn cf_restore() {
    code[95] = 0x6A;
    code[96] = 0x0B;
    code[97] = 0x20;
    code[98] = 0x00;
    code[99] = 0xFF;
    code[100] = 0x0B;
}

; The 24-bit word of the last response, little-endian, as host_recv captured it.
fn cf_word() -> u32 {
    return (cap[2] as u32) + ((cap[3] as u32) << 8) + ((cap[4] as u32) << 16);
}

; Closed form of CF_SUM and CF_NEST, in u64 so x = 5000 does not wrap on the way.
fn cf_sum_golden(x : u32, y : u32) -> u32 {
    var s : u64 = ((x as u64) * ((x as u64) + 1)) / 2;
    return (((y as u64) + s) & I32_MASK) as u32;
}

test cf_rom_layout {
    assert (CF_SUM as u32) + CF_SUM_LEN == (CF_TAB as u32);
    assert (CF_TAB as u32) + CF_TAB_LEN == (CF_NEST as u32);
    assert (CF_NEST as u32) + CF_NEST_LEN == (CF_FUEL as u32);
    assert (CF_FUEL as u32) + CF_FUEL_LEN == (CF_IMM as u32);
    assert (CF_IMM as u32) + CF_IMM_LEN == (CF_VAL as u32);
    assert (CF_VAL as u32) + CF_VAL_LEN == (CF_END as u32);
    assert (CF_END as u32) <= CODE_PAD;
    assert cfprog[CF_SUM as u32] == OP_BLOCK;
    assert cfprog[(CF_SUM as u32) + 2] == OP_LOOP;
    assert cfprog[(CF_TAB as u32) + 8] == OP_BR_TABLE;
    assert cfprog[(CF_NEST as u32) + 25] == OP_BR;
    assert cfprog[(CF_FUEL as u32) + 2] == OP_BR;
    assert cfprog[(CF_IMM as u32) + 8] == OP_BR_IF;
    assert cfprog[(CF_VAL as u32) + 3] == BT_I32;
    assert cfprog[CF_END as u32] == 0;
    var k : u32 = 0;
    var ends : u32 = 0;
    while (k < (CF_END as u32)) {
        if (cfprog[k] == OP_END) { ends = ends + 1; }
        k = k + 1;
    }
    assert ends == 18;
}

; Law (FR-001, FR-003, FR-004, FR-006, FR-010 of #12010): CF_SUM at the free tail of the store
; sums x down to 0 into y through a loop inside a block -- br_if 1 out of both when x hits
; zero, br 0 back to the loop. The golden is the closed form y + x(x+1)/2, never the
; program. x = 5000 is the deepest run under FUEL_MAX (2 + 12 x 5000 + 5 = 60007 fetches);
; x = 6000 needs 72007 and is the fuel negative control on the same program.
test cf_loop_sum {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    var g : u32 = 0;
    cf_poke(CF_SUM as u32, 98, CF_SUM_LEN);
    r = host_run_user(CF_SUM_LEN as u8, 98, 1, 100, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 1;
    assert w == 5050;
    assert err == ERR_NONE;
    assert lsp == 0;
    r = host_run_user(CF_SUM_LEN as u8, 98, 2, 0, 7);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 7;
    r = host_run_user(CF_SUM_LEN as u8, 98, 3, 1, 1);
    w = cf_word();
    assert r == 0;
    assert w == 2;
    r = host_run_user(CF_SUM_LEN as u8, 98, 4, 1000, 12);
    w = cf_word();
    g = cf_sum_golden(1000, 12);
    assert r == 0;
    assert w == g;
    assert g == 500512;
    r = host_run_user(CF_SUM_LEN as u8, 98, 5, 5000, 0);
    w = cf_word();
    g = cf_sum_golden(5000, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == g;
    assert g == 12502500;
    assert fuel == 60007;
    r = host_run_user(CF_SUM_LEN as u8, 98, 6, 6000, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 6;
    assert err == ERR_FUEL;
    assert fuel == FUEL_MAX;
    cf_restore();
    assert frames - f0 == 6;
}

; Law (FR-005, FR-010): CF_TAB picks one of three blocks by br_table; an index past the table
; (7, and the all-ones word) takes the default label.
test cf_br_table {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    cf_poke(CF_TAB as u32, 101, CF_TAB_LEN);
    r = host_run_user(CF_TAB_LEN as u8, 101, 10, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 10;
    assert w == 10;
    r = host_run_user(CF_TAB_LEN as u8, 101, 11, 1, 0);
    w = cf_word();
    assert r == 0;
    assert w == 20;
    r = host_run_user(CF_TAB_LEN as u8, 101, 12, 2, 0);
    w = cf_word();
    assert r == 0;
    assert w == 30;
    assert lsp == 0;
    r = host_run_user(CF_TAB_LEN as u8, 101, 13, 7, 0);
    w = cf_word();
    assert r == 0;
    assert w == 10;
    r = host_run_user(CF_TAB_LEN as u8, 101, 14, 0xFFFFFFFF, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 10;
    assert err == ERR_NONE;
    assert frames - f0 == 5;
}

; Law (FR-010, nested loops): CF_NEST counts x down and y up, and the step back to the outer
; loop is a br 1 from inside an inner loop -- the label stack goes 3 -> 2, not 3 -> 0.
test cf_nested_loop_br_1 {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    cf_poke(CF_NEST as u32, 95, CF_NEST_LEN);
    r = host_run_user(CF_NEST_LEN as u8, 95, 20, 3, 10);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 20;
    assert w == 13;
    r = host_run_user(CF_NEST_LEN as u8, 95, 21, 0, 0);
    w = cf_word();
    assert r == 0;
    assert w == 0;
    r = host_run_user(CF_NEST_LEN as u8, 95, 22, 40, 2);
    w = cf_word();
    assert r == 0;
    assert w == 42;
    assert lsp == 0;
    assert err == ERR_NONE;
    cf_restore();
    assert frames - f0 == 3;
}

; Law (FR-007): an endless loop ends at FUEL_MAX fetches with ERR_FUEL, the engine stops, and
; the next request on the same link answers as if nothing happened.
test cf_fuel_then_link_alive {
    var f0 : u32 = frames;
    var r : u32 = 0;
    cf_poke(CF_FUEL as u32, 101, CF_FUEL_LEN);
    r = host_run_user(CF_FUEL_LEN as u8, 101, 30, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 30;
    assert cap[2] == 0;
    assert err == ERR_FUEL;
    assert fuel == FUEL_MAX;
    assert ms == 0;
    assert br_run == 0;
    assert sc_run == 0;
    r = host_xchg(ID_ANSWER, 31, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 31;
    assert cap[2] == 42;
    assert err == ERR_NONE;
    assert frames - f0 == 2;
}

; Law (FR-002, FR-010): eight nested blocks run (the label stack at its limit), the ninth
; answers ERR_LABEL; a br with no frame open and a br past the open frames answer ERR_LABEL.
test cf_labels_at_the_limit {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var i : u32 = 0;
    while (i < 8) {
        code[101 + 2 * i] = OP_BLOCK;
        code[102 + 2 * i] = BT_VOID;
        code[117 + i] = OP_END;
        i = i + 1;
    }
    code[125] = OP_END;
    r = host_run_user(25, 101, 40, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 40;
    assert err == ERR_NONE;
    assert lsp == 0;
    i = 0;
    while (i < 9) {
        code[101 + 2 * i] = OP_BLOCK;
        code[102 + 2 * i] = BT_VOID;
        i = i + 1;
    }
    code[119] = OP_END;
    r = host_run_user(19, 101, 41, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LABEL;
    assert lsp == LABEL_MAX;
    code[101] = OP_BR;
    code[102] = 0x00;
    code[103] = OP_END;
    r = host_run_user(3, 101, 42, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LABEL;
    code[101] = OP_BLOCK;
    code[102] = BT_VOID;
    code[103] = OP_BR;
    code[104] = 0x02;
    code[105] = OP_END;
    code[106] = OP_END;
    r = host_run_user(6, 101, 43, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LABEL;
    assert frames - f0 == 4;
}

; Law (FR-008, FR-010): a branch out of a block carries the block's value and unwinds the
; stack to the block's height (CF_VAL: 43, and 5 if it did not unwind); the scan over the
; skipped bytes steps over immediates, so the 0x0B inside `i32.const 11` and the 0x0B label
; of `br_if 11` in CF_IMM are not ends (a scan that read them as ends would run `br_if 11`
; and answer ERR_LABEL, not 5 + x).
test cf_branch_values_and_immediates {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    cf_poke(CF_IMM as u32, 101, CF_IMM_LEN);
    r = host_run_user(CF_IMM_LEN as u8, 101, 50, 1, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 50;
    assert w == 6;
    r = host_run_user(CF_IMM_LEN as u8, 101, 51, 100, 0);
    w = cf_word();
    assert r == 0;
    assert w == 105;
    cf_poke(CF_VAL as u32, 101, CF_VAL_LEN);
    r = host_run_user(CF_VAL_LEN as u8, 101, 52, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 43;
    assert err == ERR_NONE;
    assert frames - f0 == 3;
}

; Law (FR-010, one negative control per opcode): the refusals, each on a program of a few
; bytes at 101, and the two positive controls they pair with (a block that falls through
; with its value; br_if taken and not taken on the same bytes).
test cf_negative_controls {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_BLOCK;
    code[102] = 0x7E;
    code[103] = OP_END;
    r = host_run_user(3, 101, 60, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_OPCODE;
    code[101] = OP_LOOP;
    r = host_run_user(3, 101, 61, 0, 0);
    assert r == 0;
    assert err == ERR_OPCODE;
    code[101] = OP_BLOCK;
    code[102] = BT_VOID;
    code[103] = OP_BR;
    code[104] = 0x80;
    code[105] = OP_END;
    code[106] = OP_END;
    r = host_run_user(6, 101, 62, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[103] = OP_BR_IF;
    code[104] = 0x00;
    r = host_run_user(6, 101, 63, 0, 0);
    assert r == 0;
    assert err == ERR_STACK;
    code[103] = OP_I32_CONST;
    code[104] = 0x01;
    code[105] = OP_BR_IF;
    code[106] = 0x81;
    code[107] = OP_END;
    code[108] = OP_END;
    r = host_run_user(8, 101, 64, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[103] = OP_BR_TABLE;
    code[104] = 0x00;
    code[105] = 0x00;
    code[106] = OP_END;
    code[107] = OP_END;
    r = host_run_user(7, 101, 65, 0, 0);
    assert r == 0;
    assert err == ERR_STACK;
    code[103] = OP_I32_CONST;
    code[104] = 0x00;
    code[105] = OP_BR_TABLE;
    code[106] = 0x80;
    code[107] = 0x00;
    code[108] = OP_END;
    code[109] = OP_END;
    r = host_run_user(9, 101, 66, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[106] = 0x00;
    code[107] = 0x80;
    r = host_run_user(9, 101, 67, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[104] = 0x05;
    code[106] = 0x09;
    r = host_run_user(6, 101, 68, 0, 0);
    assert r == 0;
    assert err == ERR_PC;
    code[103] = OP_BR;
    code[104] = 0x00;
    code[105] = 0x29;
    code[106] = OP_END;
    code[107] = OP_END;
    r = host_run_user(7, 101, 69, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_OPCODE;
    r = host_run_user(4, 101, 70, 0, 0);
    assert r == 0;
    assert err == ERR_PC;
    code[102] = BT_I32;
    code[103] = OP_I32_CONST;
    code[104] = 0x07;
    code[105] = OP_END;
    code[106] = OP_END;
    r = host_run_user(6, 101, 71, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 7;
    assert lsp == 0;
    code[102] = BT_VOID;
    code[103] = OP_I32_CONST;
    code[104] = 0x01;
    code[105] = OP_BR_IF;
    code[106] = 0x00;
    code[107] = OP_I32_CONST;
    code[108] = 0x09;
    code[109] = OP_RETURN;
    code[110] = OP_END;
    code[111] = OP_I32_CONST;
    code[112] = 0x02;
    code[113] = OP_END;
    r = host_run_user(13, 101, 72, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 2;
    code[104] = 0x00;
    r = host_run_user(13, 101, 73, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 9;
    assert frames - f0 == 14;
}

; The baked bytes CF_SUM and CF_NEST overwrote are back: ID_TEE_DUP doubles, ID_BAD refuses.
test cf_restore_keeps_the_baked_programs {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_xchg(ID_TEE_DUP, 80, 21, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 80;
    assert cap[2] == 42;
    assert cap[3] == 0;
    r = host_xchg(ID_BAD, 81, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_OPCODE;
    assert frames - f0 == 2;
}

; --- linear memory (issue #12202): program builders and the ten tests ---------------------------
; Host side only (loops are fine; none is called from step_all, so none reaches the Verilog --
; the host_run_user precedent). mem_poke writes the program
;     local.get 0 ; [local.get 1 ;] op align=2 offset=off ; end
; at code[101..], the offset as an unsigned LEB128 built here from `off` and never read back
; from the cell's decoder; a store takes its base from x and its value from y, a load its base
; from x. It returns the program length. The page is X in a Verilog run until a byte is
; written, so every test stores before it loads and reads only bytes it wrote.
fn mem_poke(op : u8, off : u32) -> u32 {
    var k : u32 = 101;
    var v : u32 = off;
    var more : u32 = 1;
    code[k] = OP_LOCAL_GET;
    code[k + 1] = 0;
    k = k + 2;
    if (op == OP_I32_STORE || op == OP_I32_STORE8 || op == OP_I32_STORE16) {
        code[k] = OP_LOCAL_GET;
        code[k + 1] = 1;
        k = k + 2;
    }
    code[k] = op;
    code[k + 1] = 2;
    k = k + 2;
    while (more == 1) {
        var b : u32 = v & 127;
        v = v >> 7;
        if (v != 0) {
            code[k] = (b | 128) as u8;
        } else {
            code[k] = b as u8;
            more = 0;
        }
        k = k + 1;
    }
    code[k] = OP_END;
    k = k + 1;
    return k - 101;
}

fn mem_go(op : u8, off : u32, seq : u8, x : u32, y : u32) -> u32 {
    var len : u32 = mem_poke(op, off);
    return host_run_user(len as u8, 101, seq, x, y);
}

; Law (FR-001, FR-006): little-endian, one fuel unit per fetch. i32.const 0x11223344 is the
; five-byte signed LEB 41 C4 E6 88 89 01; stored at 16 and read back by i32.load, the page holds
; 44 33 22 11 and the result is the whole word (the wire carries its low 24 bits).
test mem_store_load_round_trip {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_I32_CONST;
    code[102] = 0x10;
    code[103] = OP_I32_CONST;
    code[104] = 0xC4;
    code[105] = 0xE6;
    code[106] = 0x88;
    code[107] = 0x89;
    code[108] = 0x01;
    code[109] = OP_I32_STORE;
    code[110] = 0x02;
    code[111] = 0x00;
    code[112] = OP_I32_CONST;
    code[113] = 0x10;
    code[114] = OP_I32_LOAD;
    code[115] = 0x02;
    code[116] = 0x00;
    code[117] = OP_END;
    r = host_run_user(17, 101, 100, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 100;
    assert err == ERR_NONE;
    assert res == 0x11223344;
    assert w == 0x223344;
    assert mem[16] == 0x44;
    assert mem[17] == 0x33;
    assert mem[18] == 0x22;
    assert mem[19] == 0x11;
    assert fuel == 6;
    assert sp == 1;
    assert frames - f0 == 1;
}

; Law (FR-001, FR-004): i32.load8_u reads one byte of the stored word, zero-extended: +0 is
; 0x44, +1 is 0x33, +3 is 0x11, and base 34 with offset 0 reaches the same byte as base 32
; with offset 2.
test mem_load8_u_picks_each_byte {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 101, 32, 0x11223344);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 0;
    assert mem[32] == 0x44;
    assert mem[33] == 0x33;
    assert mem[34] == 0x22;
    assert mem[35] == 0x11;
    assert fuel == 4;
    r = mem_go(OP_I32_LOAD8_U, 0, 102, 32, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 102;
    assert res == 0x44;
    assert fuel == 3;
    r = mem_go(OP_I32_LOAD8_U, 1, 103, 32, 0);
    assert r == 0;
    assert res == 0x33;
    r = mem_go(OP_I32_LOAD8_U, 0, 104, 34, 0);
    assert r == 0;
    assert res == 0x22;
    r = mem_go(OP_I32_LOAD8_U, 3, 105, 32, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0x11;
    assert frames - f0 == 5;
}

; Law (FR-004): i32.load8_s sign-extends bit 7 -- 0xFF is -1, 0x80 is 0xFFFFFF80, 0x7F stays
; 0x7F -- while i32.load8_u of the same byte does not. i32.store8 keeps only the low byte of
; the value (0x123456FF stores 0xFF).
test mem_load8_s_sign_extends {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE8, 0, 110, 48, 0x123456FF);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[48] == 0xFF;
    r = mem_go(OP_I32_LOAD8_S, 0, 111, 48, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFFFFFF;
    assert w == 0xFFFFFF;
    r = mem_go(OP_I32_LOAD8_U, 0, 112, 48, 0);
    assert r == 0;
    assert res == 0xFF;
    r = mem_go(OP_I32_STORE8, 0, 113, 48, 0x7F);
    assert r == 0;
    assert mem[48] == 0x7F;
    r = mem_go(OP_I32_LOAD8_S, 0, 114, 48, 0);
    assert r == 0;
    assert res == 0x7F;
    r = mem_go(OP_I32_STORE8, 0, 115, 48, 0x80);
    assert r == 0;
    r = mem_go(OP_I32_LOAD8_S, 0, 116, 48, 0);
    assert r == 0;
    assert res == 0xFFFFFF80;
    r = mem_go(OP_I32_LOAD8_U, 0, 117, 48, 0);
    assert r == 0;
    assert res == 0x80;
    assert frames - f0 == 8;
}

; Law (FR-004): i32.load16_s of 0x8000 is 0xFFFF8000 (-32768) and i32.load16_u is 0x8000; 0x7FFF
; is the same under both; i32.store16 keeps only the low two bytes (0xABCD8001 stores 01 80).
test mem_load16_s_and_u {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE16, 0, 120, 56, 0x8000);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[56] == 0x00;
    assert mem[57] == 0x80;
    r = mem_go(OP_I32_LOAD16_S, 0, 121, 56, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFF8000;
    assert w == 0xFF8000;
    r = mem_go(OP_I32_LOAD16_U, 0, 122, 56, 0);
    assert r == 0;
    assert res == 0x8000;
    r = mem_go(OP_I32_STORE16, 0, 123, 56, 0x7FFF);
    assert r == 0;
    r = mem_go(OP_I32_LOAD16_S, 0, 124, 56, 0);
    assert r == 0;
    assert res == 0x7FFF;
    r = mem_go(OP_I32_LOAD16_U, 0, 125, 56, 0);
    assert r == 0;
    assert res == 0x7FFF;
    r = mem_go(OP_I32_STORE16, 0, 126, 56, 0xABCD8001);
    assert r == 0;
    assert mem[56] == 0x01;
    assert mem[57] == 0x80;
    r = mem_go(OP_I32_LOAD16_S, 0, 127, 56, 0);
    assert r == 0;
    assert res == 0xFFFF8001;
    r = mem_go(OP_I32_LOAD16_U, 0, 128, 56, 0);
    assert r == 0;
    assert res == 0x8001;
    assert frames - f0 == 9;
}

; Law (FR-004): store8 and store16 write exactly their width. Eight bytes are written first
; (DD CC BB AA at 24, 66 77 88 99 at 28); store8 at 25 changes one byte, store16 at 26 changes
; two, and the bytes on both sides of each, which this test wrote, are untouched.
test mem_store8_and_store16_leave_the_neighbours {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 130, 24, 0xAABBCCDD);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = mem_go(OP_I32_STORE, 0, 131, 28, 0x99887766);
    assert r == 0;
    assert mem[24] == 0xDD;
    assert mem[25] == 0xCC;
    assert mem[26] == 0xBB;
    assert mem[27] == 0xAA;
    assert mem[28] == 0x66;
    assert mem[29] == 0x77;
    assert mem[30] == 0x88;
    assert mem[31] == 0x99;
    r = mem_go(OP_I32_STORE8, 0, 132, 25, 0xFFFFFF11);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[24] == 0xDD;
    assert mem[25] == 0x11;
    assert mem[26] == 0xBB;
    assert mem[27] == 0xAA;
    r = mem_go(OP_I32_STORE16, 0, 133, 26, 0xFFFF2233);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert fuel == 4;
    assert mem[24] == 0xDD;
    assert mem[25] == 0x11;
    assert mem[26] == 0x33;
    assert mem[27] == 0x22;
    assert mem[28] == 0x66;
    assert mem[29] == 0x77;
    assert mem[30] == 0x88;
    assert mem[31] == 0x99;
    r = mem_go(OP_I32_LOAD, 0, 134, 24, 0);
    assert r == 0;
    assert res == 0x223311DD;
    r = mem_go(OP_I32_LOAD, 0, 135, 28, 0);
    assert r == 0;
    assert res == 0x99887766;
    assert frames - f0 == 6;
}

; Law (FR-002): the effective address is base + offset, for a one-, two- and three-byte offset
; LEB; the align field is read and ignored, even as a padded two-byte LEB (80 00); a fifth
; continuation byte in either field answers ERR_LEB, and a memarg cut off by the program end
; answers ERR_PC.
test mem_offset_immediate_adds {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = mem_go(OP_I32_STORE, 40, 140, 2, 0xA1B2C3D4);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[42] == 0xD4;
    assert mem[43] == 0xC3;
    assert mem[44] == 0xB2;
    assert mem[45] == 0xA1;
    r = mem_go(OP_I32_LOAD, 2, 141, 40, 0);
    assert r == 0;
    assert res == 0xA1B2C3D4;
    r = mem_go(OP_I32_LOAD8_U, 45, 142, 0, 0);
    assert r == 0;
    assert res == 0xA1;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_I32_LOAD;
    code[104] = 0x80;
    code[105] = 0x00;
    code[106] = 0x02;
    code[107] = OP_END;
    r = host_run_user(7, 101, 143, 40, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xA1B2C3D4;
    r = mem_go(OP_I32_STORE, 256, 144, 44, 0x0F0E0D0C);
    assert r == 0;
    assert mem[300] == 0x0C;
    assert mem[301] == 0x0D;
    assert mem[302] == 0x0E;
    assert mem[303] == 0x0F;
    r = mem_go(OP_I32_LOAD, 200, 145, 100, 0);
    assert r == 0;
    assert res == 0x0F0E0D0C;
    r = mem_go(OP_I32_STORE8, 16384, 146, 5, 0x5A);
    assert r == 0;
    assert mem[16389] == 0x5A;
    r = mem_go(OP_I32_LOAD8_U, 0, 147, 16389, 0);
    assert r == 0;
    assert res == 0x5A;
    r = mem_go(OP_I32_STORE, 65532, 148, 0, 0x0A0B0C0D);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = mem_go(OP_I32_LOAD, 65532, 149, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0x0A0B0C0D;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_I32_LOAD;
    code[104] = 0x02;
    code[105] = 0x80;
    code[106] = 0x80;
    code[107] = 0x80;
    code[108] = 0x80;
    code[109] = 0x80;
    code[110] = OP_END;
    r = host_run_user(10, 101, 150, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LEB;
    code[104] = 0x80;
    code[105] = 0x80;
    code[106] = 0x80;
    code[107] = 0x80;
    code[108] = 0x80;
    code[109] = 0x00;
    r = host_run_user(10, 101, 151, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LEB;
    code[104] = 0x02;
    r = host_run_user(4, 101, 152, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PC;
    assert frames - f0 == 13;
}

; Law (FR-003): an access of width w traps when base + offset > 65536 - w, as a 33-bit sum.
; The last access of each width fits (i32.load at 65532, load16 at 65534, load8 at 65535, load8
; with base 65000 and offset 535); one byte further traps with RESP_BADOP and ERR_MEM, ms 0 and
; the wire word 0, after two fetches of fuel (the local.get and the access). A base of 0xFFFFFFFF
; plus offset 1, a five-byte offset of 0xFFFFFFFF and 0xFFFF0000 plus 0x10000 would each wrap to
; a legal 32-bit address and must still trap. A trapping store writes no byte: the page keeps
; BE BA FE CA at 65532 and 5C at 0. The next request runs.
test mem_access_past_the_page_traps {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 160, 65532, 0xCAFEBABE);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert mem[65532] == 0xBE;
    assert mem[65533] == 0xBA;
    assert mem[65534] == 0xFE;
    assert mem[65535] == 0xCA;
    r = mem_go(OP_I32_LOAD, 0, 161, 65532, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xCAFEBABE;
    r = mem_go(OP_I32_LOAD16_U, 0, 162, 65534, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xCAFE;
    r = mem_go(OP_I32_LOAD8_U, 0, 163, 65535, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xCA;
    r = mem_go(OP_I32_STORE8, 0, 164, 0, 0x5C);
    assert r == 0;
    assert mem[0] == 0x5C;
    r = mem_go(OP_I32_LOAD, 0, 165, 65533, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 165;
    assert w == 0;
    assert err == ERR_MEM;
    assert ms == 0;
    assert mem_run == 0;
    assert fuel == 2;
    r = mem_go(OP_I32_LOAD16_S, 0, 166, 65535, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_S, 0, 167, 65536, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_U, 535, 168, 65000, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 0xCA;
    r = mem_go(OP_I32_LOAD8_U, 536, 169, 65000, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_U, 1, 170, 0xFFFFFFFF, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_U, 0xFFFFFFFF, 171, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD, 0x10000, 172, 0xFFFF0000, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_STORE, 0, 173, 65533, 0x01020304);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert mem[65532] == 0xBE;
    assert mem[65533] == 0xBA;
    assert mem[65534] == 0xFE;
    assert mem[65535] == 0xCA;
    r = mem_go(OP_I32_STORE16, 0, 174, 65535, 0x0102);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert mem[65535] == 0xCA;
    r = mem_go(OP_I32_STORE8, 1, 175, 0xFFFFFFFF, 0x77);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert mem[0] == 0x5C;
    r = mem_go(OP_I32_LOAD8_U, 0, 176, 65535, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 176;
    assert err == ERR_NONE;
    assert res == 0xCA;
    assert frames - f0 == 17;
}

; Law (FR-005): memory.size is 0x3F with a reserved 0x00 and pushes 1 (one page); it composes
; on the stack (1 + 1 is 2, 5 + 1 is 6). A reserved byte other than 0 answers ERR_MEM, a
; memory.size cut off by the program end ERR_PC. The scan steps over the reserved byte: a
; skipped `3F 0B` is not an end, so the br_if lands after the real end and returns 7.
test mem_size_is_one_page {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_MEMORY_SIZE;
    code[102] = 0x00;
    code[103] = OP_END;
    r = host_run_user(3, 101, 180, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 180;
    assert err == ERR_NONE;
    assert res == 1;
    assert w == 1;
    assert fuel == 2;
    assert sp == 1;
    code[103] = OP_MEMORY_SIZE;
    code[104] = 0x00;
    code[105] = OP_I32_ADD;
    code[106] = OP_END;
    r = host_run_user(6, 101, 181, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 2;
    code[101] = OP_I32_CONST;
    code[102] = 0x05;
    r = host_run_user(6, 101, 182, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 6;
    code[101] = OP_MEMORY_SIZE;
    code[102] = 0x01;
    code[103] = OP_END;
    r = host_run_user(3, 101, 183, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = host_run_user(1, 101, 184, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PC;
    code[101] = OP_BLOCK;
    code[102] = BT_VOID;
    code[103] = OP_I32_CONST;
    code[104] = 0x01;
    code[105] = OP_BR_IF;
    code[106] = 0x00;
    code[107] = OP_MEMORY_SIZE;
    code[108] = 0x0B;
    code[109] = OP_END;
    code[110] = OP_I32_CONST;
    code[111] = 0x07;
    code[112] = OP_END;
    r = host_run_user(12, 101, 185, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 7;
    assert frames - f0 == 6;
}

; Law (FR-005): memory.grow pops its delta and pushes 0xFFFFFFFF (-1), grows nothing, for every
; delta including 0 (a deviation from the WASM spec, which returns the old size for 0); the
; size stays 1 afterwards. An empty stack answers ERR_STACK, a reserved byte other than 0
; ERR_MEM.
test mem_grow_refuses {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_MEMORY_GROW;
    code[104] = 0x00;
    code[105] = OP_END;
    r = host_run_user(5, 101, 190, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 190;
    assert err == ERR_NONE;
    assert res == 0xFFFFFFFF;
    assert w == 0xFFFFFF;
    assert fuel == 3;
    assert sp == 1;
    r = host_run_user(5, 101, 191, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFFFFFF;
    r = host_run_user(5, 101, 192, 0xFFFFFFFF, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFFFFFF;
    code[105] = OP_DROP;
    code[106] = OP_MEMORY_SIZE;
    code[107] = 0x00;
    code[108] = OP_END;
    r = host_run_user(8, 101, 193, 3, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 1;
    code[101] = OP_MEMORY_GROW;
    code[102] = 0x00;
    code[103] = OP_END;
    r = host_run_user(3, 101, 194, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_STACK;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_MEMORY_GROW;
    code[104] = 0x01;
    code[105] = OP_END;
    r = host_run_user(5, 101, 195, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert frames - f0 == 6;
}

; Law (FR-002, FR-010 of #12202): a taken br_if skips a load whose offset is a two-byte LEB
; that ends in 0x0B (80 0B, offset 1408): a scan that did not know the memarg would read that
; byte as the block's end. y = 1 skips it and returns the 7 the block carried (5 fetches); y = 0
; falls through, drops the 7, loads the word stored at 4 + 1408 and returns it (9 fetches).
test mem_br_if_skips_a_load_with_a_two_byte_offset {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 200, 1412, 0x0D0C0B0A);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[1412] == 0x0A;
    assert mem[1415] == 0x0D;
    code[101] = OP_BLOCK;
    code[102] = BT_I32;
    code[103] = OP_I32_CONST;
    code[104] = 0x07;
    code[105] = OP_LOCAL_GET;
    code[106] = 0x01;
    code[107] = OP_BR_IF;
    code[108] = 0x00;
    code[109] = OP_DROP;
    code[110] = OP_LOCAL_GET;
    code[111] = 0x00;
    code[112] = OP_I32_LOAD;
    code[113] = 0x02;
    code[114] = 0x80;
    code[115] = 0x0B;
    code[116] = OP_END;
    code[117] = OP_END;
    r = host_run_user(17, 101, 201, 4, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 201;
    assert err == ERR_NONE;
    assert res == 7;
    assert fuel == 5;
    assert lsp == 0;
    r = host_run_user(17, 101, 202, 4, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 0x0D0C0B0A;
    assert w == 0x0C0B0A;
    assert fuel == 9;
    assert frames - f0 == 3;
}

; --- P2 blocks: the loaded image -------------------------------------------------------------
; These stay last: a LOAD_PAGE frame overwrites code[0..127], where every built-in
; program lives, so after the first load the ROM suite is gone. Facts first, then
; four page fills, twenty-one runs (seqs 40..60), then the four P2 errors: a divide
; by zero and a six-byte LEB that need the image, plus a bad page and a run window
; past the store that do not. New tests go ABOVE this section: in the Verilog run every
; test block shares one code[], and the cf_ suite once sat below P4 and lost ID_ANSWER (#12010).
test p2_opcode_bytes {
    assert OP_DROP == 0x1A;
    assert OP_SELECT == 0x1B;
    assert OP_I32_LT_U == 0x49;
    assert OP_I32_GT_U == 0x4B;
    assert OP_I32_LE_U == 0x4D;
    assert OP_I32_GE_U == 0x4F;
    assert OP_I32_CLZ == 0x67;
    assert OP_I32_CTZ == 0x68;
    assert OP_I32_POPCNT == 0x69;
    assert OP_I32_DIV_S == 0x6D;
    assert OP_I32_DIV_U == 0x6E;
    assert OP_I32_REM_S == 0x6F;
    assert OP_I32_REM_U == 0x70;
    assert OP_I32_SHR_U == 0x76;
    assert OP_I32_ROTL == 0x77;
    assert OP_I32_ROTR == 0x78;
    assert OP_LOAD_PAGE == 0xFE;
    assert OP_RUN_USER == 0xFD;
    assert ERR_DIV == 4;
    assert ERR_LEB == 6;
    assert ERR_PROG == 7;
    assert CODE_PAGES == 4;
    assert P2_VECS == 29;
    assert uprog[UP_DIV_U + 4] == OP_I32_DIV_U;
    assert uprog[UP_REM_U + 4] == OP_I32_REM_U;
    assert uprog[UP_ROTL + 4] == OP_I32_ROTL;
    assert uprog[UP_ROTR + 4] == OP_I32_ROTR;
    assert uprog[UP_SHR_U + 4] == OP_I32_SHR_U;
    assert uprog[UP_POPCNT + 2] == OP_I32_POPCNT;
    assert uprog[UP_CLZ + 2] == OP_I32_CLZ;
    assert uprog[UP_CTZ + 2] == OP_I32_CTZ;
}

test p2_helpers {
    assert neg32(5) == 0xFFFFFFFB;
    assert neg32(0x80000000) == 0x80000000;
    assert abs32(0xFFFFFF9C) == 100;
    assert abs32(0x80000000) == 0x80000000;
    assert rotl32(0x12345678, 4) == 0x23456781;
    assert rotr32(0x12345678, 4) == 0x81234567;
    assert rotl32(0x12345678, 0) == 0x12345678;
    assert rotl32(0x12345678, 36) == rotl32(0x12345678, 4);
    assert shr_u32(0x12345678, 8) == 0x123456;
    assert clz32(0x12345678) == 3;
    assert clz32(0) == 32;
    assert ctz32(0x12345678) == 3;
    assert ctz32(0x10) == 4;
    assert ctz32(0) == 32;
    assert popcnt32(0x12345678) == 13;
    assert popcnt32(0xFFFFFFFF) == 32;
    assert popcnt32(0) == 0;
}

test p2_uprog_layout {
    assert uprog[UP_LEB3] == 0x41;
    assert uprog[UP_LEB3 + 1] == 0xE5;
    assert uprog[UP_LEB3 + 2] == 0x8E;
    assert uprog[UP_LEB3 + 3] == 0x26;
    assert uprog[UP_LEB3 + 7] == 0x0B;
    assert uprog[UP_DIV_U + 4] == 0x6E;
    assert uprog[UP_ROTL + 4] == 0x77;
    assert uprog[UP_SHR_U + 3] == 0x08;
    assert uprog[UP_LEB5 + 1] == 0xF8;
    assert uprog[UP_LEB5 + 5] == 0x01;
    assert uprog[UP_LEB6 + 5] == 0x80;
    assert uprog[UP_LEB2 + 1] == 0xC0;
    assert uprog[UP_END] == 0;
    assert (UP_END as u32) + 11 == CODE_PAD;
}

test p2_roundtrip_user {
    var l0 : u32 = loads;
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 0;
    assert cap[2] == 1;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_load(1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 1;
    assert cap[2] == 2;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_load(2);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 2;
    assert cap[2] == 3;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_load(3);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 3;
    assert cap[2] == 4;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert loads - l0 == 4;
    assert frames - f0 == 0;

    r = host_run_user(8, UP_LEB3, 40, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 40;
    assert cap[2] == 0x66;
    assert cap[3] == 0x87;
    assert cap[4] == 0x09;
    r = host_run_user(6, UP_DIV_U, 41, 100, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 41;
    assert cap[2] == 0x0E;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_REM_U, 42, 100, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 42;
    assert cap[2] == 0x02;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_DIV_S, 43, 0xFFFFFF9C, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 43;
    assert cap[2] == 0xF2;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_run_user(6, UP_REM_S, 44, 0xFFFFFF9C, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 44;
    assert cap[2] == 0xFE;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_run_user(6, UP_ROTL, 45, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 45;
    assert cap[2] == 0x81;
    assert cap[3] == 0x67;
    assert cap[4] == 0x45;
    r = host_run_user(6, UP_ROTR, 46, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 46;
    assert cap[2] == 0x67;
    assert cap[3] == 0x45;
    assert cap[4] == 0x23;
    r = host_run_user(6, UP_SHR_U, 47, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 47;
    assert cap[2] == 0x56;
    assert cap[3] == 0x34;
    assert cap[4] == 0x12;
    r = host_run_user(4, UP_POPCNT, 48, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 48;
    assert cap[2] == 0x0D;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CLZ, 49, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 49;
    assert cap[2] == 0x03;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CTZ, 50, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 50;
    assert cap[2] == 0x03;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_LT_U, 51, 0x80000000, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 51;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_GT_U, 52, 0x80000000, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 52;
    assert cap[2] == 1;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_LE_U, 53, 1, 0x80000000);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 53;
    assert cap[2] == 1;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_GE_U, 54, 1, 0x80000000);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 54;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(10, UP_LEB5, 55, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 55;
    assert cap[2] == 0x79;
    assert cap[3] == 0x56;
    assert cap[4] == 0x34;
    r = host_run_user(7, UP_LEB2, 56, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 56;
    assert cap[2] == 0xC1;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_run_user(6, UP_DIV_S, 57, 0x80000000, 0xFFFFFFFF);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 57;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_REM_S, 58, 0x80000000, 0xFFFFFFFF);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 58;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CLZ, 59, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 59;
    assert cap[2] == 0x20;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CTZ, 60, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 60;
    assert cap[2] == 0x20;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert frames - f0 == 21;
    assert drops == 0;
    assert err == 0;

    r = host_run_user(6, UP_DIV0, 61, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 61;
    assert err == ERR_DIV;
    r = host_run_user(8, UP_LEB6, 62, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 62;
    assert err == ERR_LEB;
    assert frames - f0 == 23;
    assert loads - l0 == 4;
}

test p2_roundtrip_errors {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_load(4);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 4;
    assert err == ERR_PROG;
    r = host_run_user(16, 120, 63, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 63;
    assert err == ERR_PROG;
    assert frames - f0 == 0;
}

; P3 behavioral (the fleet's two programs, over the wire like p2_roundtrip, with
; save/restore of page 0 so every other test sees the default image):
;   42 B1 D1 F9 D6 03 0B  = i64.const 987654321; end   (the t27b emitter's exact bytes)
;   42 7B 0B              = i64.const -5; end
; the alias law first, as runtime facts
test p3_i64_wire_programs {
    assert OP_I64_CONST == 0x42;
    assert OP_I32_CONST == 0x41;
    var save : [12]u8 = undefined;
    var i : u32 = 0;
    while (i < 12) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_I64_CONST;
    uprog[1] = 0xB1;
    uprog[2] = 0xD1;
    uprog[3] = 0xF9;
    uprog[4] = 0xD6;
    uprog[5] = 0x03;
    uprog[6] = OP_END;
    uprog[7] = OP_I64_CONST;
    uprog[8] = 0x7B;
    uprog[9] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(7, 0, 64, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 64;
    assert cap[2] == 0xB1;
    assert cap[3] == 0x68;
    assert cap[4] == 0xDE;
    r = host_run_user(3, 7, 65, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 65;
    assert cap[2] == 0xFB;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    i = 0;
    while (i < 12) { uprog[i] = save[i]; i = i + 1; }
}

; P4 behavioral (the fleet's last named refusal, over the wire like p3, with
; save/restore of page 0 so every other test sees the default image):
;   43 00 00 20 40 0B                      = f32.const 2.5; end  (word 0x40200000)
;   44 00 00 00 00 00 00 04 40 0B          = f64.const 2.5; end  (low32 0x00000000)
;   44 18 2D 44 54 FB 21 09 40 0B          = f64.const pi; end  (0x400921FB54442D18,
;                                           low32 0x54442D18 -- a nonzero low half, so
;                                           the low-32 law is witnessed, not just a zero)
; the raw-bit law first, as runtime facts
test p4_f32_wire_programs {
    assert OP_F32_CONST == 0x43;
    assert OP_F64_CONST == 0x44;
    var save : [26]u8 = undefined;
    var i : u32 = 0;
    while (i < 26) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_F32_CONST;
    uprog[1] = 0x00;
    uprog[2] = 0x00;
    uprog[3] = 0x20;
    uprog[4] = 0x40;
    uprog[5] = OP_END;
    uprog[6] = OP_F64_CONST;
    uprog[7] = 0x00;
    uprog[8] = 0x00;
    uprog[9] = 0x00;
    uprog[10] = 0x00;
    uprog[11] = 0x00;
    uprog[12] = 0x00;
    uprog[13] = 0x04;
    uprog[14] = 0x40;
    uprog[15] = OP_END;
    uprog[16] = OP_F64_CONST;
    uprog[17] = 0x18;
    uprog[18] = 0x2D;
    uprog[19] = 0x44;
    uprog[20] = 0x54;
    uprog[21] = 0xFB;
    uprog[22] = 0x21;
    uprog[23] = 0x09;
    uprog[24] = 0x40;
    uprog[25] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(6, 0, 66, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 66;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x20;
    r = host_run_user(10, 6, 67, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 67;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x00;
    r = host_run_user(10, 16, 68, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 68;
    assert cap[2] == 0x18;
    assert cap[3] == 0x2D;
    assert cap[4] == 0x44;
    i = 0;
    while (i < 26) { uprog[i] = save[i]; i = i + 1; }
}
