pub const OP_I32_GE_U : u8 = 0x4F;
pub const OP_I32_GE_S : u8 = 0x4E;
pub const OP_I32_CLZ : u8 = 0x67;
pub const OP_I32_CTZ : u8 = 0x68;
pub const OP_I32_POPCNT : u8 = 0x69;
