                            st[sp - 3] = i64_shl_lo(st[sp - 3], st[sp - 1] & 63);
                            sp = sp - 2;
                            pc = pc + 1;
                        } else {
                            fail_rsp(ERR_STACK);
                        }
                    }
                    if (scrap_op == OP_I64_SHR_U) {
                        if (sp >= 4) {
                            st[sp - 3] = i64_shru_lo(st[sp - 4], st[sp - 3], st[sp - 1] & 63);
                            st[sp - 4] = i64_shru_hi(st[sp - 4], st[sp - 1] & 63);
                            sp = sp - 2;
                            pc = pc + 1;
                        } else {
                            fail_rsp(ERR_STACK);
                        }
                    }
                    if (scrap_op == OP_I64_SHR_S) {
                        if (sp >= 4) {
                            st[sp - 3] = i64_shrs_lo(st[sp - 4], st[sp - 3], st[sp - 1] & 63);
                            st[sp - 4] = i64_shrs_hi(st[sp - 4], st[sp - 1] & 63);
                            sp = sp - 2;
                            pc = pc + 1;
                        } else {
                            fail_rsp(ERR_STACK);
                        }
                    }
                } else {
                if (scrap_op == OP_BLOCK || scrap_op == OP_LOOP) {
                    scrap_imm = code[run_base + pc + 1];
                    if (scrap_imm != BT_VOID && scrap_imm != BT_I32) {
                        fail_rsp(ERR_OPCODE);
                    } else {
                        if (lsp >= LABEL_MAX) {
                            fail_rsp(ERR_LABEL);
                        } else {
                            lab_kind[lsp] = scrap_op;
                            lab_h[lsp] = sp as u8;
                            lab_tgt[lsp] = (pc + 2) as u8;
                            if (scrap_op == OP_BLOCK && scrap_imm == BT_I32) {
                                lab_ar[lsp] = 1;
                            } else {
                                lab_ar[lsp] = 0;
                            }
                            lsp = lsp + 1;
                            pc = pc + 2;
                        }
                    }
                } else {
                if (scrap_op == OP_BR) {
                    scrap_imm = code[run_base + pc + 1];
                    if ((scrap_imm & 0x80) != 0) {
                        fail_rsp(ERR_LEB);
                    } else {
                        br_l = scrap_imm as u32;
                        br_run = 1;
                    }
                } else {
                if (scrap_op == OP_BR_IF) {
                    scrap_imm = code[run_base + pc + 1];
                    if ((scrap_imm & 0x80) != 0) {
                        fail_rsp(ERR_LEB);
                    } else {
                        if (sp > 0) {
                            if (st[sp - 1] != 0) {
                                br_l = scrap_imm as u32;
                                br_run = 1;
                            } else {
                                pc = pc + 2;
                            }
                            sp = sp - 1;
                        } else {
                            fail_rsp(ERR_STACK);
                        }
                    }
                } else {
                if (scrap_op == OP_BR_TABLE) {
                    scrap_imm = code[run_base + pc + 1];
                    if ((scrap_imm & 0x80) != 0) {
                        fail_rsp(ERR_LEB);
                    } else {
                        if (sp > 0) {
                            scrap_k = st[sp - 1];
                            if (scrap_k > (scrap_imm as u32)) {
                                scrap_k = scrap_imm as u32;
                            }
                            if (pc + 2 + scrap_k >= run_len) {
                                fail_rsp(ERR_PC);
                            } else {
                                scrap_imm = code[run_base + pc + 2 + scrap_k];
                                if ((scrap_imm & 0x80) != 0) {
                                    fail_rsp(ERR_LEB);
                                } else {
                                    br_l = scrap_imm as u32;
                                    br_run = 1;
                                    sp = sp - 1;
                                }
                            }
                        } else {
                            fail_rsp(ERR_STACK);
                        }
                    }
                } else {
                    if (scrap_op == OP_LOCAL_GET) {
                        scrap_imm = code[run_base + pc + 1];
                        if ((scrap_imm as u32) < lcnt && sp < STACK_MAX) {
                            st[sp] = loc[lbase + (scrap_imm as u32)];
                            sp = sp + 1;
                            pc = pc + 2;
                        } else {
                            fail_rsp(ERR_LOCAL);
                        }
                    } else {
                        if (scrap_op == OP_LOCAL_SET) {
                            scrap_imm = code[run_base + pc + 1];
                            if ((scrap_imm as u32) < lcnt && sp > 0) {
                                loc[lbase + (scrap_imm as u32)] = st[sp - 1];
                                sp = sp - 1;
                                pc = pc + 2;
                            } else {
                                fail_rsp(ERR_LOCAL);
                            }
                        } else {
                            if (scrap_op == OP_LOCAL_TEE) {
                                scrap_imm = code[run_base + pc + 1];
                                if ((scrap_imm as u32) < lcnt && sp > 0) {
                                    loc[lbase + (scrap_imm as u32)] = st[sp - 1];
                                    pc = pc + 2;
                                } else {
                                    fail_rsp(ERR_LOCAL);
                                }
                            } else {
                                if (scrap_op == OP_I32_CONST) {
                                    scrap_imm = code[run_base + pc + 1];
                                    if ((scrap_imm & 0x80) != 0) {
                                        if (sp < STACK_MAX) {
                                            imm_acc = (scrap_imm & 0x7F) as u32;
                                            imm_cnt = 1;
                                            imm_wide = 0;
                                            imm_run = 1;
                                            pc = pc + 2;
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    } else {
                                        if (sp < STACK_MAX) {
                                            st[sp] = sleb8(scrap_imm);
                                            sp = sp + 1;
                                            pc = pc + 2;
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    }
                                } else {
                                if (scrap_op == OP_F32_CONST or scrap_op == OP_F64_CONST) {
                                    if (sp < STACK_MAX) {
                                        st[sp] = (code[run_base + pc + 1] as u32);
                                        st[sp] = st[sp] | shl32((code[run_base + pc + 2] as u32), 8);
                                        st[sp] = st[sp] | shl32((code[run_base + pc + 3] as u32), 16);
                                        st[sp] = st[sp] | shl32((code[run_base + pc + 4] as u32), 24);
                                        sp = sp + 1;
                                        if (scrap_op == OP_F32_CONST) {
                                            pc = pc + 5;
                                        } else {
                                            pc = pc + 9;
                                        }
                                    } else {
                                        fail_rsp(ERR_STACK);
                                    }
                                } else {
                                    if (scrap_op == OP_F32_ADD or scrap_op == OP_F32_SUB) {
                                        if (sp >= 2) {
                                            if (scrap_op == OP_F32_ADD) {
                                                st[sp - 2] = f32_add(st[sp - 2], st[sp - 1]);
                                            } else {
                                                st[sp - 2] = f32_add(st[sp - 2], f32_neg(st[sp - 1]));
                                            }
                                            sp = sp - 1;
                                            pc = pc + 1;
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    } else {
                                    if (scrap_op == OP_F32_MUL) {
                                        if (sp >= 2) {
                                            if (f32_mul_setup(st[sp - 2], st[sp - 1]) == 1) {
                                                sp = sp - 1;
                                            } else {
                                                st[sp - 2] = fa_res;
                                                sp = sp - 1;
                                                pc = pc + 1;
                                            }
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    } else {
                                    if (scrap_op == OP_I32_MUL) {
                                        if (sp >= 2) {
                                            mul_a = st[sp - 2];
                                            mul_b = st[sp - 1];
                                            mul_acc = 0;
                                            mul_run = 32;
                                            sp = sp - 1;
                                        } else {
                                            fail_rsp(ERR_STACK);
                                        }
                                    } else {
                                        if (scrap_op == OP_RETURN || scrap_op == OP_END) {
                                            if (scrap_op == OP_END && lsp > lbl) {
                                                lsp = lsp - 1;
                                                pc = pc + 1;
                                            } else {
                                                if (csp == 0) {
                                                    if (sp > 0) {
                                                        res = st[sp - 1];
                                                    } else {
                                                        res = 0;
                                                    }
                                                    ok_rsp();
                                                } else {
                                                    scrap_k = csp - 1;
                                                    scrap_h = cl_sp[scrap_k];
                                                    if (sp > scrap_h) {
                                                        st[scrap_h] = st[sp - 1];
                                                        sp = scrap_h + 1;
                                                    } else {
                                                        sp = scrap_h;
                                                    }
                                                    lsp = cl_lsp[scrap_k];
                                                    run_base = cl_rb[scrap_k];
                                                    run_len = cl_rl[scrap_k];
                                                    pc = cl_pc[scrap_k];
                                                    lcnt = cl_lc[scrap_k];
                                                    lbase = lbase - LOCALS;
                                                    csp = scrap_k;
                                                    if (scrap_k > 0) {
                                                        lbl = cl_lsp[scrap_k - 1];
                                                    } else {
                                                        lbl = 0;
                                                    }
                                                }
                                            }
                                        } else {
                                                if (scrap_op == OP_DROP) {
                                                    if (sp > 0) {
                                                        sp = sp - 1;
                                                        pc = pc + 1;
                                                    } else {
                                                        fail_rsp(ERR_STACK);
                                                    }
                                                } else {
                                                    if (scrap_op == OP_SELECT) {
                                                        if (sp >= 3) {
                                                            if (st[sp - 1] == 0) {
                                                                st[sp - 3] = st[sp - 2];
                                                            }
                                                            sp = sp - 2;
                                                            pc = pc + 1;
                                                        } else {
                                                            fail_rsp(ERR_STACK);
                                                        }
                                                    } else {
                                                        if (scrap_op == OP_I32_DIV_U) {
                                                            if (sp >= 2) {
                                                                if (st[sp - 1] == 0) {
                                                                    fail_rsp(ERR_DIV);
                                                                } else {
                                                                    dv_q = st[sp - 2];
                                                                    dv_b = st[sp - 1];
                                                                    dv_negq = 0;
                                                                    dv_negr = 0;
                                                                    dv_rem = 0;
                                                                    dv_run = 32;
                                                                    dv_kind = 0;
                                                                    sp = sp - 1;
                                                                }
                                                            } else {
                                                                fail_rsp(ERR_STACK);
                                                            }
                                                        } else {
                                                            if (scrap_op == OP_I32_DIV_S) {
                                                                if (sp >= 2) {
                                                                    if (st[sp - 1] == 0) {
                                                                        fail_rsp(ERR_DIV);
                                                                    } else {
                                                                        dv_q = abs32(st[sp - 2]);
                                                                        dv_b = abs32(st[sp - 1]);
                                                                        dv_negq = ((st[sp - 2] ^ st[sp - 1]) >> 31) as u8;
                                                                        dv_negr = 0;
                                                                        dv_rem = 0;
                                                                        dv_run = 32;
                                                                        dv_kind = 2;
                                                                        sp = sp - 1;
                                                                    }
                                                                } else {
                                                                    fail_rsp(ERR_STACK);
                                                                }
                                                            } else {
                                                                if (scrap_op == OP_I32_REM_U) {
                                                                    if (sp >= 2) {
                                                                        if (st[sp - 1] == 0) {
                                                                            fail_rsp(ERR_DIV);
                                                                        } else {
                                                                            dv_q = st[sp - 2];
                                                                            dv_b = st[sp - 1];
                                                                            dv_negq = 0;
                                                                            dv_negr = 0;
                                                                            dv_rem = 0;
                                                                            dv_run = 32;
                                                                            dv_kind = 1;
                                                                            sp = sp - 1;
                                                                        }
                                                                    } else {
                                                                        fail_rsp(ERR_STACK);
                                                                    }
                                                                } else {
                                                                    if (scrap_op == OP_I32_REM_S) {
                                                                        if (sp >= 2) {
                                                                            if (st[sp - 1] == 0) {
                                                                                fail_rsp(ERR_DIV);
                                                                            } else {
                                                                                dv_q = abs32(st[sp - 2]);
                                                                                dv_b = abs32(st[sp - 1]);
                                                                                dv_negq = 0;
                                                                                dv_negr = (st[sp - 2] >> 31) as u8;
                                                                                dv_rem = 0;
                                                                                dv_run = 32;
                                                                                dv_kind = 3;
                                                                                sp = sp - 1;
                                                                            }
                                                                        } else {
                                                                            fail_rsp(ERR_STACK);
                                                                        }
                                                                    } else {
                                                                        if (mem_width(scrap_op) != 0) {
                                                                            scrap_n = mem_pops(scrap_op);
                                                                            if (sp >= scrap_n) {
                                                                                mem_op = scrap_op;
                                                                                mem_w = mem_width(scrap_op);
                                                                                mem_base = st[sp - scrap_n];
                                                                                mem_val = st[sp - 1];
                                                                                sp = sp - scrap_n;
                                                                                mem_cnt = 0;
                                                                                mem_sh = 0;
                                                                                mem_acc = 0;
                                                                                mem_run = 1;
                                                                                pc = pc + 1;
                                                                            } else {
                                                                                fail_rsp(ERR_STACK);
                                                                            }
                                                                        } else {
                                                                        if (scrap_op == OP_MEMORY_SIZE || scrap_op == OP_MEMORY_GROW) {
                                                                            if (pc + 1 >= run_len) {
                                                                                fail_rsp(ERR_PC);
                                                                            } else {
                                                                                if (code[run_base + pc + 1] != 0) {
                                                                                    fail_rsp(ERR_MEM);
                                                                                } else {
                                                                                    if (scrap_op == OP_MEMORY_SIZE) {
                                                                                        if (sp < STACK_MAX) {
                                                                                            st[sp] = 1;
                                                                                            sp = sp + 1;
                                                                                            pc = pc + 2;
                                                                                        } else {
                                                                                            fail_rsp(ERR_STACK);
                                                                                        }
                                                                                    } else {
                                                                                        if (sp > 0) {
                                                                                            st[sp - 1] = 0xFFFFFFFF;
                                                                                            pc = pc + 2;
                                                                                        } else {
                                                                                            fail_rsp(ERR_STACK);
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        } else {
                                                                            fail_rsp(ERR_OPCODE);
                                                                        }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
                }
                }
                }
                }
                }
            }
            }
            }
            }
            }
            }
            }
            }
            }
        }
    }
    frame_go = 0;
    if (rxnew == 1) {
        if (fstate == 0) {
            if (rxbyte == SYNC0) {
                fstate = 1;
            }
        } else {
            if (fstate == 1) {
                if (rxbyte == SYNC1) {
                    fstate = 2;
                    bidx = 0;
                } else {
                    if (rxbyte == SYNC0) {
                        fstate = 1;
                    } else {
                        fstate = 0;
                    }
                }
            } else {
                body[bidx] = rxbyte;
                if (bidx == 0) {
                    opq = rxbyte;
                }
                if (bidx == 1) {
                    seqq = rxbyte;
                }
                if (bidx == BODY_BYTES - 1) {
                    frame_go = 1;
                    fstate = 0;
                    bidx = 0;
                } else {
                    bidx = bidx + 1;
                }
            }
        }
    }
    rxnew = 0;
    rs2 = rs1;
    rs1 = rs0;
    rs0 = rxd;
    if (rxst == 0) {
        if (rs2 == 0) {
            rxst = 1;
            rxcnt = BAUD_DIV + (BAUD_DIV / 2) - 1;
            rbi = 0;
            rxsr = 0;
        }
    } else {
        if (rxcnt == 0) {
            if (rxst == 1) {
                rxsr = (rxsr >> 1) | ((rs2 as u32) * 128);
                if (rbi == 7) {
                    rxst = 2;
                    rxcnt = BAUD_DIV - 1;
                } else {
                    rbi = rbi + 1;
                    rxcnt = BAUD_DIV - 1;
                }
            } else {
                rxbyte = (rxsr & 255) as u8;
                rxnew = 1;
                rxst = 0;
            }
        } else {
            rxcnt = rxcnt - 1;
        }
    }
}

fn on_clock(rxd : u8) {
    step_all(rxd);
    ticks = ticks + 1;
}

; --- host-side drivers (test-only; loops live here, never in the tick body)
fn req_byte(op : u8, seq : u8, x : u32, y : u32, k : u32) -> u8 {
    if (k == 0) { return SYNC0; }
    if (k == 1) { return SYNC1; }
    if (k == 2) { return op; }
    if (k == 3) { return seq; }
    if (k == 4) { return 0; }
    if (k == 5) { return 0; }
    if (k < 10) { return ((x >> ((k - 6) * 8)) & 255) as u8; }
    if (k < 22) { return 0; }
    if (k < 26) { return ((y >> ((k - 22) * 8)) & 255) as u8; }
    return 0;
}

fn frame_bit(op : u8, seq : u8, x : u32, y : u32, j : u32) -> u8 {
    var pos : u32 = j % 10;
    var byt : u8 = req_byte(op, seq, x, y, j / 10);
    if (pos == 0) { return 0; }
    if (pos == 9) { return 1; }
    return ((byt >> (pos - 1)) & 1) as u8;
}

; Send one request: every wire bit held BAUD_DIV ticks, start low, stop high.
fn host_send(op : u8, seq : u8, x : u32, y : u32) {
    var j : u32 = 0;
    while (j < 10 * REQ_BYTES) {
        var n : u32 = 0;
        var b : u8 = frame_bit(op, seq, x, y, j);
        while (n < BAUD_DIV) {
            step_all(b);
            n = n + 1;
        }
        j = j + 1;
    }
}

; Receive one response into cap[0..4]. Per byte: wait for the falling start edge on
; txd, step 1.5 bit-times to the middle of data bit 0, sample 8 data bits one bit-time
; apart (little-endian within the byte). The last sample leaves the sampler at the
; stop bit middle; the next wait-start loop consumes the rest of the stop bit and any
; idle gap, so the next falling edge is a real start, never a sampled data bit. Returns
; 0 on success, 1 on silence past the timeout.
fn host_recv() -> u32 {
    var t : u32 = 0;
    var bi : u32 = 0;
    var bit : u32 = 0;
    var acc : u32 = 0;
    var n : u32 = 0;
    while (bi < (RESP_BYTES as u32)) {
        t = 0;
        while ((txd & 1) == 1) {
            step_all(1);
            t = t + 1;
            if (t > 30000) {
                return 1;
            }
        }
        n = 0;
        while (n < BAUD_DIV + (BAUD_DIV / 2)) {
            step_all(1);
            n = n + 1;
        }
        acc = 0;
        bit = 0;
        while (bit < 8) {
            if ((txd & 1) == 1) {
                acc = acc | ((1 as u32) << bit);
            }
            n = 0;
            while (n < BAUD_DIV) {
                step_all(1);
                n = n + 1;
            }
            bit = bit + 1;
        }
        cap[bi] = acc as u8;
        bi = bi + 1;
    }
    return 0;
}

; One full exchange; returns the host_recv status.
fn host_xchg(op : u8, seq : u8, x : u32, y : u32) -> u32 {
    host_send(op, seq, x, y);
    return host_recv();
}

; --- P6 table loaders (issue #12323) ------------------------------------------------------
; OP 0xFC LOAD_TABLES rides the generic frame: kind is x byte 0, the slot index is x byte 1,
; and the value is y (little-endian). Kind 0 is a function row packed off | np<<8 | nl<<16 |
; ty<<24, kind 1 is an element (the function index in y byte 0), kind 2 is a global (all of
; y). The cell answers RESP_OK with slot + 1, or RESP_BADOP when a slot or a row is out of
; range. Each helper returns the host_recv status.
fn host_table(kind : u32, idx : u32, val : u32) -> u32 {
    return host_xchg(OP_LOAD_TABLES, 0, kind | (idx << 8), val);
}

fn host_fn(f : u32, off : u32, np : u32, nl : u32, ty : u32) -> u32 {
    return host_table(0, f, off | (np << 8) | (nl << 16) | (ty << 24));
}

; --- P2 wire loaders and the run-user exchange ---------------------------------------------
; OP 0xFE LOAD_PAGE: the page number rides the SEQ slot, body[4..35] carries 32 code
; bytes straight out of uprog -- host-side indexing may use *, these functions are
; interpreter-only and never reach the Verilog (the cap[8]u8 precedent). OP 0xFD
; RUN_USER: len and off ride body[2..3], operands keep the k=6.. x/y placement.
fn load_byte(page : u8, k : u32) -> u8 {
    if (k == 0) { return SYNC0; }
    if (k == 1) { return SYNC1; }
    if (k == 2) { return OP_LOAD_PAGE; }
    if (k == 3) { return page; }
    if (k < 6) { return 0; }
    if ((page as u32) < CODE_PAGES && k < 6 + PAGE_BYTES) {
        return uprog[((page as u32) * PAGE_BYTES) + (k - 6)];
    }
    return 0;
}

fn load_bit(page : u8, j : u32) -> u8 {
    var pos : u32 = j % 10;
    var byt : u8 = load_byte(page, j / 10);
    if (pos == 0) { return 0; }
    if (pos == 9) { return 1; }
    return ((byt >> (pos - 1)) & 1) as u8;
}

; Push one 32-byte page over the wire; returns the host_recv status.
fn host_load(page : u8) -> u32 {
    var j : u32 = 0;
    while (j < 10 * REQ_BYTES) {
        var n : u32 = 0;
        var b : u8 = load_bit(page, j);
        while (n < BAUD_DIV) {
            step_all(b);
            n = n + 1;
        }
        j = j + 1;
    }
    return host_recv();
}

fn user_byte(len : u8, off : u8, seq : u8, x : u32, y : u32, k : u32) -> u8 {
    if (k == 0) { return SYNC0; }
    if (k == 1) { return SYNC1; }
    if (k == 2) { return OP_RUN_USER; }
    if (k == 3) { return seq; }
    if (k == 4) { return len; }
    if (k == 5) { return off; }
    return req_byte(0, 0, x, y, k);
}

fn user_bit(len : u8, off : u8, seq : u8, x : u32, y : u32, j : u32) -> u8 {
    var pos : u32 = j % 10;
    var byt : u8 = user_byte(len, off, seq, x, y, j / 10);
    if (pos == 0) { return 0; }
    if (pos == 9) { return 1; }
    return ((byt >> (pos - 1)) & 1) as u8;
}

; Host side: step the clock until the cell starts answering or bound steps pass. A run that
; finished inside the request's last byte (every straight-line program) adds no steps; a
; looping program runs here, not against host_recv's 30000-step silence bound. 8 * FUEL_MAX
; covers every run in this file (a fetch is two clocks under the phase gate, a branch two
; engine steps); a run of 65536 mul sequences would outlast it and read as silence -- that is
; the host runner's bound, not the cell's.
fn host_await(bound : u32) {
    var t : u32 = 0;
    while (responding == 0 && t < bound) {
        step_all(1);
        t = t + 1;
    }
}

; Run len bytes of the loaded image at offset off; returns the host_recv status.
fn host_run_user(len : u8, off : u8, seq : u8, x : u32, y : u32) -> u32 {
    var j : u32 = 0;
    while (j < 10 * REQ_BYTES) {
        var n : u32 = 0;
        var b : u8 = user_bit(len, off, seq, x, y, j);
        while (n < BAUD_DIV) {
            step_all(b);
            n = n + 1;
        }
        j = j + 1;
    }
    host_await(8 * FUEL_MAX);
    return host_recv();
}

; --- the ALU sweep (issue #12011): closed forms written here, never read from alu_eval ----
; Every function below is host-side only (loops, `*` and `%` are fine; none is called from
; step_all, so none reaches the Verilog -- the host_run_user precedent). The expected value
; of every swept opcode is rebuilt from arithmetic on u64 and from single bits, so the
; shared alu_eval is never its own oracle.
fn ref_pow2(k : u32) -> u64 {
    var r : u64 = 1;
    var i : u32 = 0;
    while (i < k) {
        r = r + r;
        i = i + 1;
    }
    return r;
}

fn ref_bit(v : u32, i : u32) -> u32 {
    var q : u64 = (v as u64) / ref_pow2(i);
    return (q % 2) as u32;
}

; signed less-than from the two sign bits, not from the bias trick lt_s32 uses
fn ref_lt_s(x : u32, y : u32) -> u32 {
    var sx : u32 = ref_bit(x, 31);
    var sy : u32 = ref_bit(y, 31);
    if (sx != sy) { return sx; }
    if (x < y) { return 1; }
    return 0;
}

fn ref_bits_op(kind : u32, x : u32, y : u32) -> u32 {
    var r : u64 = 0;
    var i : u32 = 0;
    var bx : u32 = 0;
    var by : u32 = 0;
    var bz : u32 = 0;
    while (i < 32) {
        bx = ref_bit(x, i);
        by = ref_bit(y, i);
        if (kind == 0) { bz = bx * by; }
        if (kind == 1) { bz = bx + by - (bx * by); }
        if (kind == 2) { bz = (bx + by) % 2; }
        r = r + ((bz as u64) * ref_pow2(i));
        i = i + 1;
    }
    return r as u32;
}

; 1 for the opcodes that read one operand (eqz, clz, ctz, popcnt), 0 for the binary ones
fn ref_unary(op : u8) -> u32 {
    if (op == 0x45) { return 1; }
    if (op >= 0x67 && op <= 0x69) { return 1; }
    return 0;
}

; 1 exactly for the 24 single-clock i32 ALU bytes: eqz, the ten compares, clz ctz popcnt,
; add, sub, and the eight bitwise/shift/rotate bytes
fn ref_is_alu(b : u32) -> u32 {
    if (b >= 0x45 && b <= 0x4F) { return 1; }
    if (b >= 0x67 && b <= 0x6B) { return 1; }
    if (b >= 0x71 && b <= 0x78) { return 1; }
    return 0;
}

fn ref_alu(op : u8, x : u32, y : u32) -> u32 {
    var k : u32 = y % 32;
    var m : u64 = 4294967296;
    var xw : u64 = x as u64;
    var yw : u64 = y as u64;
    var i : u32 = 0;
    var n : u32 = 0;
    if (op == OP_I32_EQZ) { if (x == 0) { return 1; } return 0; }
    if (op == OP_I32_EQ) { if (x == y) { return 1; } return 0; }
    if (op == OP_I32_NE) { if (x != y) { return 1; } return 0; }
    if (op == OP_I32_LT_S) { return ref_lt_s(x, y); }
    if (op == OP_I32_GT_S) { return ref_lt_s(y, x); }
    if (op == OP_I32_LE_S) { return 1 - ref_lt_s(y, x); }
    if (op == OP_I32_GE_S) { return 1 - ref_lt_s(x, y); }
    if (op == OP_I32_LT_U) { if (x < y) { return 1; } return 0; }
    if (op == OP_I32_GT_U) { if (x > y) { return 1; } return 0; }
    if (op == OP_I32_LE_U) { if (x <= y) { return 1; } return 0; }
    if (op == OP_I32_GE_U) { if (x >= y) { return 1; } return 0; }
    if (op == OP_I32_CLZ) {
        while (i < 32) {
            if (ref_bit(x, 31 - i) == 1) { return i; }
            i = i + 1;
        }
        return 32;
    }
    if (op == OP_I32_CTZ) {
        while (i < 32) {
            if (ref_bit(x, i) == 1) { return i; }
            i = i + 1;
        }
        return 32;
    }
    if (op == OP_I32_POPCNT) {
        while (i < 32) {
            n = n + ref_bit(x, i);
            i = i + 1;
        }
        return n;
    }
    if (op == OP_I32_ADD) { return ((xw + yw) % m) as u32; }
    if (op == OP_I32_SUB) {
        if (x >= y) { return x - y; }
        return ((xw + m) - yw) as u32;
    }
    if (op == OP_I32_AND) { return ref_bits_op(0, x, y); }
    if (op == OP_I32_OR) { return ref_bits_op(1, x, y); }
    if (op == OP_I32_XOR) { return ref_bits_op(2, x, y); }
    if (op == OP_I32_SHL) { return ((xw * ref_pow2(k)) % m) as u32; }
    if (op == OP_I32_SHR_U) { return (xw / ref_pow2(k)) as u32; }
    if (op == OP_I32_SHR_S) {
        var q : u64 = xw / ref_pow2(k);
        if (k > 0 && ref_bit(x, 31) == 1) {
            q = q + (m - ref_pow2(32 - k));
        }
        return q as u32;
    }
    if (op == OP_I32_ROTL) {
        return (((xw * ref_pow2(k)) % m) + (xw / ref_pow2(32 - k))) as u32;
    }
    if (op == OP_I32_ROTR) {
        return ((xw / ref_pow2(k)) + ((xw % ref_pow2(k)) * ref_pow2(32 - k))) as u32;
    }
    return 0;
}

; the 24 swept opcodes by index: eqz, clz ctz popcnt, the ten compares, add, sub, then the
; eight bitwise/shift/rotate bytes; the arity test pins that these 24 are exactly what
; alu_arity accepts
fn alu_op_at(i : u32) -> u8 {
    if (i == 0) { return 0x45; }
    if (i < 4) { return (0x67 + (i - 1)) as u8; }
    if (i < 14) { return (0x46 + (i - 4)) as u8; }
    if (i == 14) { return 0x6A; }
    if (i == 15) { return 0x6B; }
    return (0x71 + (i - 16)) as u8;
}

; the ten opcodes that have a signed/unsigned twin: lt gt le ge (signed byte first) and shr
fn pair_op_at(j : u32) -> u8 {
    if (j < 8) { return (0x48 + j) as u8; }
    if (j == 8) { return 0x75; }
    return 0x76;
}

fn pair_partner(op : u8) -> u8 {
    if (op == 0x75) { return 0x76; }
    if (op == 0x76) { return 0x75; }
    if (op == 0x48 || op == 0x4A || op == 0x4C || op == 0x4E) { return op + 1; }
    return op - 1;
}

; sixteen operand pairs: the edges 0 1 31 32 0x7FFFFFFF 0x80000000 0xFFFFFFFF in both
; positions that matter, a shift count past 32, and one unstructured word
fn sw_x(p : u32) -> u32 {
    if (p == 0) { return 0; }
    if (p == 1) { return 1; }
    if (p == 2) { return 0; }
    if (p == 3) { return 1; }
    if (p == 4) { return 31; }
    if (p == 5) { return 32; }
    if (p == 6) { return 1; }
    if (p == 7) { return 1; }
    if (p == 8) { return 0x7FFFFFFF; }
    if (p == 9) { return 0x80000000; }
    if (p == 10) { return 0xFFFFFFFF; }
    if (p == 11) { return 0x80000000; }
    if (p == 12) { return 0xFFFFFFFF; }
    if (p == 13) { return 0x7FFFFFFF; }
    if (p == 14) { return 0x80000001; }
    return 0xDEADBEEF;
}

fn sw_y(p : u32) -> u32 {
    if (p == 0) { return 0; }
    if (p == 1) { return 0; }
    if (p == 2) { return 1; }
    if (p == 3) { return 1; }
    if (p == 4) { return 1; }
    if (p == 5) { return 1; }
    if (p == 6) { return 31; }
    if (p == 7) { return 32; }
    if (p == 8) { return 1; }
    if (p == 9) { return 1; }
    if (p == 10) { return 1; }
    if (p == 11) { return 0xFFFFFFFF; }
    if (p == 12) { return 0x80000000; }
    if (p == 13) { return 0x80000000; }
    if (p == 14) { return 33; }
    return 0xFFFFFFFF;
}

; Poke the smallest program for op into the code store at 104 (`local.get 0 [local.get 1]
; op end`), run it with x and y as the two locals; returns 0 when the answer was RESP_OK
; with the echoed seq, 1 otherwise. The full 32-bit result is left in `res`.
fn run_alu(op : u8, x : u32, y : u32, seq : u8) -> u32 {
    var len : u8 = 6;
    code[104] = 0x20;
    code[105] = 0x00;
    if (ref_unary(op) == 1) {
        code[106] = op;
        code[107] = 0x0B;
        len = 4;
    } else {
        code[106] = 0x20;
        code[107] = 0x01;
        code[108] = op;
        code[109] = 0x0B;
    }
    var r : u32 = host_run_user(len, 104, seq, x, y);
    if (r != 0) { return 1; }
    if (cap[0] != RESP_OK) { return 1; }
    if (cap[1] != seq) { return 1; }
    return 0;
}

; --- vectors, per program ----------------------------------------------------------------
; Pinned: two per program, chosen to cross the signed boundary and the constant path.
; Random: eight per program, splitmix64 from RANDOM_SEED, operands full u32; the golden
; for every vector is the host interpreter over the same ROM bytes. Errors: the illegal
; opcode body and an unknown OP. Wrap: two vectors whose full result leaves 24 bits.
pub const RANDOM_SEED : u32 = 20261012;
pub const PINNED_PER_PROG : u8 = 2;
pub const RANDOM_PER_PROG : u8 = 8;
pub const ERROR_VECS : u8 = 2;
pub const WRAP_VECS : u8 = 2;
pub const WIRE_PROGS : u8 = 13;
; P2 over the wire: four page loads, twenty-one user-program runs, four errors --
; a bad page, a run past the image, a divide by zero and a six-byte LEB.
pub const P2_VECS : u32 = 29;
pub const TOTAL_REQUESTS : u32 = 163;

; --- cost, pre-registered before any synthesis -------------------------------------------
; The engine is a 70-byte decode (24 ALU bytes through the shared alu_arity/alu_eval pair
; since #12011, 18 other arms -- the const arm took i32.const and i64.const until P7 moved
; i64.const behind the is_p7_op gate, the float arm f32.const and f64.const, since P3/P4;
; block and loop share one arm, br, br_if and br_table
; have their own, since #12010 -- 10 memory bytes through two arms since P5 #12202, and the six
; bytes of P6 #12323: if, else, call, call_indirect, global.get and global.set, behind one
; is_p6_op gate, and the nine bytes of P7 #12371: i32.wrap_i64, the two i64 extends, i64.add,
; sub, mul and the three i64 shifts, behind one is_p7_op gate -- i64.const now decodes up to
; ten LEB bytes into a two-slot pair; return and end share the frame-aware arm), a 16-deep
; 32-bit stack, a 20-entry local file (CALL_MAX + 1 windows of LOCALS), a 4-frame call stack,
; a 32-clock restoring divider, a 64-clock i64 shift-add multiplier sequence, two rotators,
; a loadable 128-byte code RAM and, since P5, one 64 KiB memory page; the UART is counters
; and shifters. The P6 and P7 costs are unmeasured: nothing was synthesised. Measured: yosys
; logic cells of the generated module alone.
; Predicted: under PREDICT_LUT_MAX; a larger count refutes it.
; REFUTED on synthesis: 10425 yosys LUTs for the module alone (10814 SLICE_LUTX in
; nextpnr with the bring-up top). The loadable store costs more than the ROM it
; replaced -- 128 writable bytes (1024 bits) with a runtime-indexed fetch mux and flat page
; stores -- and the rotators lower as 64-bit barrels. Both bounds below are the
; measured numbers; the pre-registration stands as the refuted original.
pub const PREDICT_LUT_MAX : u32 = 7000;
pub const MEASURED_LUT_CORE : u32 = 10425;
pub const MEASURED_LUT_PNR : u32 = 10814;

; --- run and pass rule --------------------------------------------------------------------
pub const RUN_NAME : str = "wasm_board_ax7203";
pub const RUN_LIMIT_S : u16 = 600;
pub const PASS_LINE : str = "WASM BOARD RESULT: 163/163 responses exact (fails=0, lost=0)";
pub const SIM_PASS_LINE : str = "WASM BOARD SIM: 21/21 checks green";

test opcode_bytes_are_real_wasm {
    assert OP_END == 0x0B;
    assert OP_RETURN == 0x0F;
    assert OP_LOCAL_GET == 0x20;
    assert OP_LOCAL_SET == 0x21;
    assert OP_LOCAL_TEE == 0x22;
    assert OP_I32_CONST == 0x41;
    assert OP_I32_EQZ == 0x45;
    assert OP_I32_EQ == 0x46;
    assert OP_I32_NE == 0x47;
    assert OP_I32_LT_S == 0x48;
    assert OP_I32_GT_S == 0x4A;
    assert OP_I32_LE_S == 0x4C;
    assert OP_I32_GE_S == 0x4E;
    assert OP_I32_ADD == 0x6A;
    assert OP_I32_SUB == 0x6B;
    assert OP_I32_MUL == 0x6C;
    assert OP_I32_AND == 0x71;
    assert OP_I32_OR == 0x72;
    assert OP_I32_XOR == 0x73;
    assert OP_I32_SHL == 0x74;
    assert OP_I32_SHR_S == 0x75;
    assert OP_IF == 0x04;
    assert OP_ELSE == 0x05;
    assert OP_CALL == 0x10;
    assert OP_CALL_INDIRECT == 0x11;
    assert OP_GLOBAL_GET == 0x23;
    assert OP_GLOBAL_SET == 0x24;
    assert WIRE_PROGS + 1 == PROGS;
    assert sp == 0;
    assert ms == 0;
}

; add_double is the body of trinity-fpga src/b2t/test_add.wat, byte for byte:
; local.get 0, local.get 1, i32.add, i32.const 2, i32.mul, end. Call results are
; bound to a local before any assert: a call as a direct assert operand
; mis-evaluates in the test backend.
test first_bytes_match_the_wat {
    var o : u32 = 0;
    var l : u32 = 0;
    assert code[0] == 0x20;
    assert code[1] == 0x00;
    assert code[2] == 0x20;
    assert code[3] == 0x01;
    assert code[4] == 0x6A;
    assert code[5] == 0x41;
    assert code[6] == 0x02;
    assert code[7] == 0x6C;
    assert code[8] == 0x0B;
    o = prog_off(ID_ADD_DOUBLE);
    assert o == 0;
    l = prog_len(ID_ADD_DOUBLE);
    assert l == 9;
    o = prog_off(ID_ANSWER);
    assert code[o] == 0x41;
    assert code[o + 1] == 0x2A;
    o = prog_off(ID_XMUL_NOT);
    assert code[o + 6] == 0x7F;
    o = prog_off(ID_BAD);
    assert code[o + 2] == 0xFF;
}

test prog_table_fits_the_rom {
    var p : u32 = 0;
    var tail : u32 = 0;
    while (p < PROGS as u32) {
        tail = prog_off(p as u8) + prog_len(p as u8);
        assert prog_off(p as u8) < tail;
        assert tail <= CODE_BYTES;
        if (p + 1 < PROGS as u32) {
            assert prog_off((p + 1) as u8) == tail;
        }
        p = p + 1;
    }
    assert tail == CODE_BYTES;
    assert CODE_BYTES <= CODE_PAD;
    assert code[CODE_BYTES] == 0;
    assert code[CODE_PAD - 1] == 0;
}

test wire_is_the_node_link {
    assert WIRE_BAUD == CP2102N_REF_HZ / CP2102N_N;
    assert WIRE_BAUD * BAUD_DIV >= CFGMCLK_MIN_HZ;
    assert WIRE_BAUD * BAUD_DIV <= CFGMCLK_MAX_HZ;
    assert HOST_BAUD > WIRE_BAUD;
    assert REQ_BYTES == 2 + BODY_BYTES;
    assert REQ_BYTES == 6 + 16 + 16;
    assert RESP_BYTES == 2 + 3;
    assert WORD_BITS == 24;
    assert SYNC0 == 170;
    assert SYNC1 == 85;
    assert RESP_OK == 165;
    assert RESP_BADOP == 229;
    assert X_OFF == 4;
    assert Y_OFF == 20;
    assert LABEL_MAX == 8;
    assert FUEL_MAX == 65536;
    assert ERR_LABEL == 8;
    assert ERR_FUEL == 9;
    assert ERR_MEM == 10;
    assert ERR_CALL == 11;
    assert ERR_FUNC == 12;
    assert ERR_TYPE == 13;
    assert ERR_GLOBAL == 14;
    assert OP_LOAD_TABLES == 0xFC;
    assert TOTAL_REQUESTS * (REQ_BYTES + (RESP_BYTES as u32)) * 10 < (RUN_LIMIT_S as u32) * WIRE_BAUD;
    assert tcnt == BAUD_DIV - 1;
}

test one_response_never_overruns {
    assert (RESP_BYTES as u32) * 10 + 10 < REQ_BYTES * 10;
    assert TOTAL_REQUESTS == (WIRE_PROGS as u32) * (((PINNED_PER_PROG + RANDOM_PER_PROG) as u32)) + (ERROR_VECS as u32) + (WRAP_VECS as u32) + P2_VECS;
    assert txidx == 0;
}

test machine_consts {
    assert STACK_MAX == 16;
    assert LOCALS == 4;
    assert MEM_BYTES == 65536;
    assert ERR_MEM == 10;
    assert CALL_MAX == 4;
    assert LOCALS_TOTAL == 20;
    assert LOCALS_TOTAL == (CALL_MAX + 1) * LOCALS;
    assert FUNC_MAX == 8;
    assert ELEM_MAX == 4;
    assert GLOBAL_MAX == 4;
    assert NO_FUNC == 255;
    assert csp == 0;
    assert (ID_SET_GET as u32) < PROGS as u32;
    assert (ID_TEE_DUP as u32) < PROGS as u32;
    assert (ID_BAD as u32) < PROGS as u32;
    assert responding == 0;
}

test leb_and_signed_helpers {
    assert sleb8(0x2A) == 42;
    assert sleb8(0x7F) == 0xFFFFFFFF;
    assert sleb8(0x40) == 0xFFFFFFC0;
    assert sleb8(0x3F) == 63;
    assert wrap32(0x100000000) == 0;
    assert wrap32(4294967295) == 4294967295;
    assert lt_s32(0xFFFFFFFF, 1) == 1;
    assert lt_s32(1, 0xFFFFFFFF) == 0;
    assert lt_s32(5, 5) == 0;
    assert shl32(1, 4) == 16;
    assert shl32(1, 33) == 2;
    assert sar32(0xFFFFFFF8, 1) == 0xFFFFFFFC;
    assert sar32(0xFFFFFFF8, 0) == 0xFFFFFFF8;
    assert sar32(8, 2) == 2;
}

; Issue #12395: a 4-byte SLEB128 carries 28 payload bits, so its sign bit is bit 27 (0x8000000)
; and the fill is bits 28..31 (0xF0000000), the same shape as the 2-byte arm (0x2000 /
; 0xFFFFC000) and the 3-byte arm (0x100000 / 0xFFE00000). The final-byte arm of the i32.const
; sub-machine used to test bit 23 and fill 0xF8000000. Three programs, each i32.const ; end,
; run through the live interpreter (host_run_user), the final byte shifted left by 21:
;   41 80 80 80 04 0B   0x04 << 21 = 0x00800000, bit 27 clear, so 8388608 (the old arm gave
;                       0xF8800000, a negative number)
;   41 80 80 80 78 0B   0x78 << 21 = 0x0F000000, bit 27 set, fill gives 0xFF000000 = -16777216
;                       (the old arm gave 0x0F000000, a positive number)
;   41 80 80 80 7C 0B   0x7C << 21 = 0x0F800000, bit 27 set, fill gives 0xFF800000 = -8388608
;                       (negative control: the old arm already gave this, it must not move)
; Each run is 2 fetches (the const is one fetch whatever its length, the root end the second),
; leaves one slot, and answers the low 24 bits of the value on the wire. Eleven asserts per
; vector, 33 in all.
test i32_const_four_byte_sleb_sign {
    var r : u32 = 0;
    code[101] = OP_I32_CONST;
    code[102] = 0x80;
    code[103] = 0x80;
    code[104] = 0x80;
    code[105] = 0x04;
    code[106] = OP_END;
    r = host_run_user(6, 101, 140, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 140;
    assert err == ERR_NONE;
    assert sp == 1;
    assert st[0] == 0x00800000;
    assert res == 0x00800000;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x80;
    assert fuel == 2;
    code[105] = 0x78;
    r = host_run_user(6, 101, 141, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 141;
    assert err == ERR_NONE;
    assert sp == 1;
    assert st[0] == 0xFF000000;
    assert res == 0xFF000000;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x00;
    assert fuel == 2;
    code[105] = 0x7C;
    r = host_run_user(6, 101, 142, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 142;
    assert err == ERR_NONE;
    assert sp == 1;
    assert st[0] == 0xFF800000;
    assert res == 0xFF800000;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x80;
    assert fuel == 2;
}

; add_double(20, 22) = (20 + 22) * 2 = 84; SEQ 7 is echoed; the word is 84.
; Frame counts use a per-block delta, so the block is correct whether tests share
; module state or start fresh.
test roundtrip_add_double {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_xchg(ID_ADD_DOUBLE, 7, 20, 22);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 7;
    assert cap[2] == 84;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert err == 0;
    assert frames - f0 == 1;
    assert drops == 0;
}

; One pinned vector per remaining program, through the whole wire.
test roundtrip_thirteen_programs {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_xchg(ID_ANSWER, 1, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 1;
    assert cap[2] == 42;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_XMUL_NOT, 2, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 2;
    assert cap[2] == 0xF5;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_xchg(ID_SUB_AND_OR, 3, 12, 10);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 3;
    assert cap[2] == 10;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_SHL_SAR, 4, 3, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 4;
    assert cap[2] == 12;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_EQ, 5, 7, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 5;
    assert cap[2] == 1;
    r = host_xchg(ID_NE, 6, 7, 8);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 6;
    assert cap[2] == 1;
    r = host_xchg(ID_LE_S, 7, 5, 9);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 7;
    assert cap[2] == 1;
    r = host_xchg(ID_GE_S, 8, 0xFFFFFFFB, 0xFFFFFFF7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 8;
    assert cap[2] == 1;
    r = host_xchg(ID_EQZ, 9, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 9;
    assert cap[2] == 1;
    r = host_xchg(ID_GT_S, 10, 3, 9);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 10;
    assert cap[2] == 0;
    r = host_xchg(ID_SET_GET, 11, 4, 5);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 11;
    assert cap[2] == 17;
    r = host_xchg(ID_TEE_DUP, 12, 21, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 12;
    assert cap[2] == 42;
    assert frames - f0 == 12;
    assert drops == 0;
}

test roundtrip_errors {
    var r : u32 = 0;
    r = host_xchg(ID_BAD, 20, 1, 2);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 20;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert err == ERR_OPCODE;
    r = host_xchg(99, 21, 1, 2);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 21;
    assert cap[2] == 0;
    assert err == ERR_PROG;
}

; Two vectors whose full result leaves the 24-bit word: the add_double wrap to zero and
; the negative -2. The wire shows the low 24 bits; the full u32 is pinned by the MVP.
test roundtrip_wrap {
    var r : u32 = 0;
    r = host_xchg(ID_ADD_DOUBLE, 30, 0x7FFFFFFF, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 30;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_xchg(ID_SUB_AND_OR, 31, 0, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 31;
    assert cap[2] == 0xFF;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
}

; --- issue #12011: the single-clock ALU is one function pair; these tests are its proof ----
; The oracle is pinned by literals first, so a wrong closed form cannot hide behind a
; matching wrong cell.
test alu_oracle_goldens {
    var a : u32 = 0;
    a = ref_alu(OP_I32_SUB, 0, 1);
    assert a == 0xFFFFFFFF;
    a = ref_alu(OP_I32_ADD, 0xFFFFFFFF, 1);
    assert a == 0;
    a = ref_alu(OP_I32_SHL, 1, 33);
    assert a == 2;
    a = ref_alu(OP_I32_SHL, 0x80000001, 1);
    assert a == 2;
    a = ref_alu(OP_I32_SHR_S, 0x80000000, 1);
    assert a == 0xC0000000;
    a = ref_alu(OP_I32_SHR_S, 0xFFFFFFFF, 31);
    assert a == 0xFFFFFFFF;
    a = ref_alu(OP_I32_SHR_S, 0x80000000, 32);
    assert a == 0x80000000;
    a = ref_alu(OP_I32_SHR_U, 0x80000000, 31);
    assert a == 1;
    a = ref_alu(OP_I32_ROTL, 0x80000001, 1);
    assert a == 3;
    a = ref_alu(OP_I32_ROTR, 1, 1);
    assert a == 0x80000000;
    a = ref_alu(OP_I32_ROTL, 0xDEADBEEF, 0);
    assert a == 0xDEADBEEF;
    a = ref_alu(OP_I32_ROTR, 0xDEADBEEF, 32);
    assert a == 0xDEADBEEF;
    a = ref_alu(OP_I32_CLZ, 0, 0);
    assert a == 32;
    a = ref_alu(OP_I32_CLZ, 1, 0);
    assert a == 31;
    a = ref_alu(OP_I32_CLZ, 0x80000000, 0);
    assert a == 0;
    a = ref_alu(OP_I32_CTZ, 0, 0);
    assert a == 32;
    a = ref_alu(OP_I32_CTZ, 0x80000000, 0);
    assert a == 31;
    a = ref_alu(OP_I32_POPCNT, 0xFFFFFFFF, 0);
    assert a == 32;
    a = ref_alu(OP_I32_POPCNT, 0xDEADBEEF, 0);
    assert a == 24;
    a = ref_alu(OP_I32_LT_S, 0xFFFFFFFF, 0);
    assert a == 1;
    a = ref_alu(OP_I32_LT_U, 0xFFFFFFFF, 0);
    assert a == 0;
    a = ref_alu(OP_I32_GE_S, 0x80000000, 1);
    assert a == 0;
    a = ref_alu(OP_I32_GT_S, 1, 0x80000000);
    assert a == 1;
    a = ref_alu(OP_I32_AND, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0xF000F000;
    a = ref_alu(OP_I32_OR, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0xFFF0FFF0;
    a = ref_alu(OP_I32_XOR, 0xF0F0F0F0, 0xFF00FF00);
    assert a == 0x0FF00FF0;
    a = ref_alu(OP_I32_EQZ, 0, 7);
    assert a == 1;
    a = ref_alu(OP_I32_EQZ, 5, 0);
    assert a == 0;
    a = ref_alu(OP_I32_EQ, 3, 3);
    assert a == 1;
    a = ref_alu(OP_I32_NE, 3, 3);
    assert a == 0;
}

; alu_arity accepts exactly the 24 single-clock ALU bytes, names the right arity for each,
; and the 24 swept indices cover those bytes once each.
test alu_arity_pins {
    var b : u32 = 0;
    var a : u32 = 0;
    var want : u32 = 0;
    var bad : u32 = 0;
    var accepted : u32 = 0;
    var sum : u32 = 0;
    var i : u32 = 0;
    var cnt : u32 = 0;
    var cover : u32 = 0;
    while (b < 256) {
        a = alu_arity(b as u8);
        want = 0;
        if (ref_is_alu(b) == 1) {
            want = 2;
            if (ref_unary(b as u8) == 1) { want = 1; }
        }
        if (a != want) { bad = bad + 1; }
        if (a != 0) {
            accepted = accepted + 1;
            sum = sum + a;
            cnt = 0;
            i = 0;
            while (i < 24) {
                if ((alu_op_at(i) as u32) == b) { cnt = cnt + 1; }
                i = i + 1;
            }
            if (cnt != 1) { cover = cover + 1; }
        }
        b = b + 1;
    }
    assert bad == 0;
    assert accepted == 24;
    assert sum == 44;
    assert cover == 0;
    a = alu_arity(OP_I32_MUL);
    assert a == 0;
    a = alu_arity(OP_I32_DIV_S);
    assert a == 0;
    a = alu_arity(OP_I32_DIV_U);
    assert a == 0;
    a = alu_arity(OP_I32_REM_S);
    assert a == 0;
    a = alu_arity(OP_I32_REM_U);
    assert a == 0;
    a = alu_arity(OP_I32_CONST);
    assert a == 0;
    a = alu_arity(OP_LOCAL_GET);
    assert a == 0;
    a = alu_arity(OP_END);
    assert a == 0;
    a = alu_arity(OP_SELECT);
    assert a == 0;
}

; 24 opcodes x 16 operand pairs = 384 cells run through the wire; the full 32-bit result of
; each is compared with the closed form above.
test alu_sweep_closed_forms {
    var f0 : u32 = frames;
    var i : u32 = 0;
    var p : u32 = 0;
    var cmp : u32 = 0;
    var bad : u32 = 0;
    var op : u8 = 0;
    var x : u32 = 0;
    var y : u32 = 0;
    var s : u32 = 0;
    var v : u32 = 0;
    var want : u32 = 0;
    while (i < 24) {
        op = alu_op_at(i);
        p = 0;
        while (p < 16) {
            x = sw_x(p);
            y = sw_y(p);
            s = run_alu(op, x, y, (cmp & 255) as u8);
            v = res;
            want = ref_alu(op, x, y);
            if (s != 0) { bad = bad + 1; }
            if (v != want) { bad = bad + 1; }
            cmp = cmp + 1;
            p = p + 1;
        }
        i = i + 1;
    }
    assert cmp == 384;
    assert bad == 0;
    assert frames - f0 == 384;
}

; Negative control: the same sweep against the signed/unsigned PARTNER's closed form must
; disagree for every one of the ten twin opcodes, or the sweep cannot tell signedness apart.
test alu_sweep_signedness_negative_control {
    var j : u32 = 0;
    var p : u32 = 0;
    var op : u8 = 0;
    var x : u32 = 0;
    var y : u32 = 0;
    var s : u32 = 0;
    var v : u32 = 0;
    var want : u32 = 0;
    var per : u32 = 0;
    var total : u32 = 0;
    var weak : u32 = 0;
    var sbad : u32 = 0;
    while (j < 10) {
        op = pair_op_at(j);
        per = 0;
        p = 0;
        while (p < 16) {
            x = sw_x(p);
            y = sw_y(p);
            s = run_alu(op, x, y, (p + 100) as u8);
            v = res;
            want = ref_alu(pair_partner(op), x, y);
            if (s != 0) { sbad = sbad + 1; }
            if (v != want) { per = per + 1; }
            p = p + 1;
        }
        if (per == 0) { weak = weak + 1; }
        total = total + per;
        j = j + 1;
    }
    assert sbad == 0;
    assert weak == 0;
    assert total >= 5;
}

; The bytes the cell executes (70: the 40 of #12011 and P3/P4 -- 24 ALU, mul and the four
; div/rem, the four const bytes 0x41-0x44, local.get/set/tee, return, end, drop, select --
; plus block, loop, br, br_if, br_table of #12010, plus the ten memory bytes of P5 #12202:
; i32.load, the four 8/16-bit loads, i32.store, store8, store16, memory.size, memory.grow,
; plus the six of P6 #12323: if, else, call, call_indirect, global.get, global.set, plus the
; nine of P7 #12371: i32.wrap_i64, the two extends, i64.add, sub, mul, shl, shr_s, shr_u)
; are independent of the ALU pair: every other byte of the opcode space -- 0x29 i64.load
; among them, a generated byte of the table the cell does not run -- answers RESP_BADOP with
; ERR_OPCODE, as before the refactor.
fn cell_runs(b : u32) -> u32 {
    if (ref_is_alu(b) == 1) { return 1; }
    if (b >= 0x6C && b <= 0x70) { return 1; }
    if (b >= 0x20 && b <= 0x24) { return 1; }
    if (b >= 0x41 && b <= 0x44) { return 1; }
    if (b == 0x0B || b == 0x0F || b == 0x1A || b == 0x1B) { return 1; }
    if (b == 0x04 || b == 0x05 || b == 0x10 || b == 0x11) { return 1; }
    if (b == 0x02 || b == 0x03 || b == 0x0C || b == 0x0D || b == 0x0E) { return 1; }
    if (b == 0x28 || (b >= 0x2C && b <= 0x2F)) { return 1; }
    if (b == 0x36 || b == 0x3A || b == 0x3B || b == 0x3F || b == 0x40) { return 1; }
    if (b == 0x7C || b == 0x7D || b == 0x7E || (b >= 0x86 && b <= 0x88)) { return 1; }
    if (b == 0xA7 || b == 0xAC || b == 0xAD) { return 1; }
    if (b == 0x92 || b == 0x93 || b == 0x94) { return 1; }
    return 0;
}

test alu_unexecuted_bytes_are_opcode_errors {
    var f0 : u32 = frames;
    var b : u32 = 0;
    var runs : u32 = 0;
    var tried : u32 = 0;
    var bad : u32 = 0;
    var r : u32 = 0;
    var c : u32 = 0;
    while (b < 256) {
        c = cell_runs(b);
        if (c == 1) {
            runs = runs + 1;
        } else {
            code[104] = b as u8;
            code[105] = 0x0B;
            r = host_run_user(2, 104, (tried & 255) as u8, 5, 6);
            if (r != 0) { bad = bad + 1; }
            if (cap[0] != RESP_BADOP) { bad = bad + 1; }
            if (cap[1] != (tried & 255) as u8) { bad = bad + 1; }
            if (err != ERR_OPCODE) { bad = bad + 1; }
            tried = tried + 1;
        }
        b = b + 1;
    }
    c = cell_runs(0x28);
    assert c == 1;
    c = cell_runs(0x29);
    assert c == 0;
    assert runs == 73;
    assert tried == 183;
    assert bad == 0;
    assert frames - f0 == 183;
}

; --- control flow (issue #12010) ----------------------------------------------------------
; Host side: copy n bytes of the cfprog ROM from src into the code store at base, the same
; bytes OP_LOAD_PAGE page 3 carries on the board; cf_restore puts back the last six baked
; bytes (the tail of ID_TEE_DUP and all of ID_BAD) after a program that overwrote them, and
; cf_restore_keeps_the_baked_programs at the end proves the restore.
fn cf_poke(src : u32, base : u32, n : u32) {
    var i : u32 = 0;
    while (i < n) {
        code[base + i] = cfprog[src + i];
        i = i + 1;
    }
}

fn cf_restore() {
    code[95] = 0x6A;
    code[96] = 0x0B;
    code[97] = 0x20;
    code[98] = 0x00;
    code[99] = 0xFF;
    code[100] = 0x0B;
}

; The 24-bit word of the last response, little-endian, as host_recv captured it.
fn cf_word() -> u32 {
    return (cap[2] as u32) + ((cap[3] as u32) << 8) + ((cap[4] as u32) << 16);
}

; Closed form of CF_SUM and CF_NEST, in u64 so x = 5000 does not wrap on the way.
fn cf_sum_golden(x : u32, y : u32) -> u32 {
    var s : u64 = ((x as u64) * ((x as u64) + 1)) / 2;
    return (((y as u64) + s) & I32_MASK) as u32;
}

test cf_rom_layout {
    assert (CF_SUM as u32) + CF_SUM_LEN == (CF_TAB as u32);
    assert (CF_TAB as u32) + CF_TAB_LEN == (CF_NEST as u32);
    assert (CF_NEST as u32) + CF_NEST_LEN == (CF_FUEL as u32);
    assert (CF_FUEL as u32) + CF_FUEL_LEN == (CF_IMM as u32);
    assert (CF_IMM as u32) + CF_IMM_LEN == (CF_VAL as u32);
    assert (CF_VAL as u32) + CF_VAL_LEN == (CF_END as u32);
    assert (CF_END as u32) <= CODE_PAD;
    assert cfprog[CF_SUM as u32] == OP_BLOCK;
    assert cfprog[(CF_SUM as u32) + 2] == OP_LOOP;
    assert cfprog[(CF_TAB as u32) + 8] == OP_BR_TABLE;
    assert cfprog[(CF_NEST as u32) + 25] == OP_BR;
    assert cfprog[(CF_FUEL as u32) + 2] == OP_BR;
    assert cfprog[(CF_IMM as u32) + 8] == OP_BR_IF;
    assert cfprog[(CF_VAL as u32) + 3] == BT_I32;
    assert cfprog[CF_END as u32] == 0;
    var k : u32 = 0;
    var ends : u32 = 0;
    while (k < (CF_END as u32)) {
        if (cfprog[k] == OP_END) { ends = ends + 1; }
        k = k + 1;
    }
    assert ends == 18;
}

; Law (FR-001, FR-003, FR-004, FR-006, FR-010 of #12010): CF_SUM at the free tail of the store
; sums x down to 0 into y through a loop inside a block -- br_if 1 out of both when x hits
; zero, br 0 back to the loop. The golden is the closed form y + x(x+1)/2, never the
; program. x = 5000 is the deepest run under FUEL_MAX (2 + 12 x 5000 + 5 = 60007 fetches);
; x = 6000 needs 72007 and is the fuel negative control on the same program.
test cf_loop_sum {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    var g : u32 = 0;
    cf_poke(CF_SUM as u32, 98, CF_SUM_LEN);
    r = host_run_user(CF_SUM_LEN as u8, 98, 1, 100, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 1;
    assert w == 5050;
    assert err == ERR_NONE;
    assert lsp == 0;
    r = host_run_user(CF_SUM_LEN as u8, 98, 2, 0, 7);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 7;
    r = host_run_user(CF_SUM_LEN as u8, 98, 3, 1, 1);
    w = cf_word();
    assert r == 0;
    assert w == 2;
    r = host_run_user(CF_SUM_LEN as u8, 98, 4, 1000, 12);
    w = cf_word();
    g = cf_sum_golden(1000, 12);
    assert r == 0;
    assert w == g;
    assert g == 500512;
    r = host_run_user(CF_SUM_LEN as u8, 98, 5, 5000, 0);
    w = cf_word();
    g = cf_sum_golden(5000, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == g;
    assert g == 12502500;
    assert fuel == 60007;
    r = host_run_user(CF_SUM_LEN as u8, 98, 6, 6000, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 6;
    assert err == ERR_FUEL;
    assert fuel == FUEL_MAX;
    cf_restore();
    assert frames - f0 == 6;
}

; Law (FR-005, FR-010): CF_TAB picks one of three blocks by br_table; an index past the table
; (7, and the all-ones word) takes the default label.
test cf_br_table {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    cf_poke(CF_TAB as u32, 101, CF_TAB_LEN);
    r = host_run_user(CF_TAB_LEN as u8, 101, 10, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 10;
    assert w == 10;
    r = host_run_user(CF_TAB_LEN as u8, 101, 11, 1, 0);
    w = cf_word();
    assert r == 0;
    assert w == 20;
    r = host_run_user(CF_TAB_LEN as u8, 101, 12, 2, 0);
    w = cf_word();
    assert r == 0;
    assert w == 30;
    assert lsp == 0;
    r = host_run_user(CF_TAB_LEN as u8, 101, 13, 7, 0);
    w = cf_word();
    assert r == 0;
    assert w == 10;
    r = host_run_user(CF_TAB_LEN as u8, 101, 14, 0xFFFFFFFF, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 10;
    assert err == ERR_NONE;
    assert frames - f0 == 5;
}

; Law (FR-010, nested loops): CF_NEST counts x down and y up, and the step back to the outer
; loop is a br 1 from inside an inner loop -- the label stack goes 3 -> 2, not 3 -> 0.
test cf_nested_loop_br_1 {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    cf_poke(CF_NEST as u32, 95, CF_NEST_LEN);
    r = host_run_user(CF_NEST_LEN as u8, 95, 20, 3, 10);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 20;
    assert w == 13;
    r = host_run_user(CF_NEST_LEN as u8, 95, 21, 0, 0);
    w = cf_word();
    assert r == 0;
    assert w == 0;
    r = host_run_user(CF_NEST_LEN as u8, 95, 22, 40, 2);
    w = cf_word();
    assert r == 0;
    assert w == 42;
    assert lsp == 0;
    assert err == ERR_NONE;
    cf_restore();
    assert frames - f0 == 3;
}

; Law (FR-007): an endless loop ends at FUEL_MAX fetches with ERR_FUEL, the engine stops, and
; the next request on the same link answers as if nothing happened.
test cf_fuel_then_link_alive {
    var f0 : u32 = frames;
    var r : u32 = 0;
    cf_poke(CF_FUEL as u32, 101, CF_FUEL_LEN);
    r = host_run_user(CF_FUEL_LEN as u8, 101, 30, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 30;
    assert cap[2] == 0;
    assert err == ERR_FUEL;
    assert fuel == FUEL_MAX;
    assert ms == 0;
    assert br_run == 0;
    assert sc_run == 0;
    r = host_xchg(ID_ANSWER, 31, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 31;
    assert cap[2] == 42;
    assert err == ERR_NONE;
    assert frames - f0 == 2;
}

; Law (FR-002, FR-010): eight nested blocks run (the label stack at its limit), the ninth
; answers ERR_LABEL; a br with no frame open and a br past the open frames answer ERR_LABEL.
test cf_labels_at_the_limit {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var i : u32 = 0;
    while (i < 8) {
        code[101 + 2 * i] = OP_BLOCK;
        code[102 + 2 * i] = BT_VOID;
        code[117 + i] = OP_END;
        i = i + 1;
    }
    code[125] = OP_END;
    r = host_run_user(25, 101, 40, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 40;
    assert err == ERR_NONE;
    assert lsp == 0;
    i = 0;
    while (i < 9) {
        code[101 + 2 * i] = OP_BLOCK;
        code[102 + 2 * i] = BT_VOID;
        i = i + 1;
    }
    code[119] = OP_END;
    r = host_run_user(19, 101, 41, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LABEL;
    assert lsp == LABEL_MAX;
    code[101] = OP_BR;
    code[102] = 0x00;
    code[103] = OP_END;
    r = host_run_user(3, 101, 42, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LABEL;
    code[101] = OP_BLOCK;
    code[102] = BT_VOID;
    code[103] = OP_BR;
    code[104] = 0x02;
    code[105] = OP_END;
    code[106] = OP_END;
    r = host_run_user(6, 101, 43, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LABEL;
    assert frames - f0 == 4;
}

; Law (FR-008, FR-010): a branch out of a block carries the block's value and unwinds the
; stack to the block's height (CF_VAL: 43, and 5 if it did not unwind); the scan over the
; skipped bytes steps over immediates, so the 0x0B inside `i32.const 11` and the 0x0B label
; of `br_if 11` in CF_IMM are not ends (a scan that read them as ends would run `br_if 11`
; and answer ERR_LABEL, not 5 + x).
test cf_branch_values_and_immediates {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    cf_poke(CF_IMM as u32, 101, CF_IMM_LEN);
    r = host_run_user(CF_IMM_LEN as u8, 101, 50, 1, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 50;
    assert w == 6;
    r = host_run_user(CF_IMM_LEN as u8, 101, 51, 100, 0);
    w = cf_word();
    assert r == 0;
    assert w == 105;
    cf_poke(CF_VAL as u32, 101, CF_VAL_LEN);
    r = host_run_user(CF_VAL_LEN as u8, 101, 52, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 43;
    assert err == ERR_NONE;
    assert frames - f0 == 3;
}

; Law (FR-010, one negative control per opcode): the refusals, each on a program of a few
; bytes at 101, and the two positive controls they pair with (a block that falls through
; with its value; br_if taken and not taken on the same bytes).
test cf_negative_controls {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_BLOCK;
    code[102] = 0x7E;
    code[103] = OP_END;
    r = host_run_user(3, 101, 60, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_OPCODE;
    code[101] = OP_LOOP;
    r = host_run_user(3, 101, 61, 0, 0);
    assert r == 0;
    assert err == ERR_OPCODE;
    code[101] = OP_BLOCK;
    code[102] = BT_VOID;
    code[103] = OP_BR;
    code[104] = 0x80;
    code[105] = OP_END;
    code[106] = OP_END;
    r = host_run_user(6, 101, 62, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[103] = OP_BR_IF;
    code[104] = 0x00;
    r = host_run_user(6, 101, 63, 0, 0);
    assert r == 0;
    assert err == ERR_STACK;
    code[103] = OP_I32_CONST;
    code[104] = 0x01;
    code[105] = OP_BR_IF;
    code[106] = 0x81;
    code[107] = OP_END;
    code[108] = OP_END;
    r = host_run_user(8, 101, 64, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[103] = OP_BR_TABLE;
    code[104] = 0x00;
    code[105] = 0x00;
    code[106] = OP_END;
    code[107] = OP_END;
    r = host_run_user(7, 101, 65, 0, 0);
    assert r == 0;
    assert err == ERR_STACK;
    code[103] = OP_I32_CONST;
    code[104] = 0x00;
    code[105] = OP_BR_TABLE;
    code[106] = 0x80;
    code[107] = 0x00;
    code[108] = OP_END;
    code[109] = OP_END;
    r = host_run_user(9, 101, 66, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[106] = 0x00;
    code[107] = 0x80;
    r = host_run_user(9, 101, 67, 0, 0);
    assert r == 0;
    assert err == ERR_LEB;
    code[104] = 0x05;
    code[106] = 0x09;
    r = host_run_user(6, 101, 68, 0, 0);
    assert r == 0;
    assert err == ERR_PC;
    code[103] = OP_BR;
    code[104] = 0x00;
    code[105] = 0x29;
    code[106] = OP_END;
    code[107] = OP_END;
    r = host_run_user(7, 101, 69, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_OPCODE;
    r = host_run_user(4, 101, 70, 0, 0);
    assert r == 0;
    assert err == ERR_PC;
    code[102] = BT_I32;
    code[103] = OP_I32_CONST;
    code[104] = 0x07;
    code[105] = OP_END;
    code[106] = OP_END;
    r = host_run_user(6, 101, 71, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 7;
    assert lsp == 0;
    code[102] = BT_VOID;
    code[103] = OP_I32_CONST;
    code[104] = 0x01;
    code[105] = OP_BR_IF;
    code[106] = 0x00;
    code[107] = OP_I32_CONST;
    code[108] = 0x09;
    code[109] = OP_RETURN;
    code[110] = OP_END;
    code[111] = OP_I32_CONST;
    code[112] = 0x02;
    code[113] = OP_END;
    r = host_run_user(13, 101, 72, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 2;
    code[104] = 0x00;
    r = host_run_user(13, 101, 73, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert w == 9;
    assert frames - f0 == 14;
}

; The baked bytes CF_SUM and CF_NEST overwrote are back: ID_TEE_DUP doubles, ID_BAD refuses.
test cf_restore_keeps_the_baked_programs {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_xchg(ID_TEE_DUP, 80, 21, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 80;
    assert cap[2] == 42;
    assert cap[3] == 0;
    r = host_xchg(ID_BAD, 81, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_OPCODE;
    assert frames - f0 == 2;
}

; --- linear memory (issue #12202): program builders and the ten tests ---------------------------
; Host side only (loops are fine; none is called from step_all, so none reaches the Verilog --
; the host_run_user precedent). mem_poke writes the program
;     local.get 0 ; [local.get 1 ;] op align=2 offset=off ; end
; at code[101..], the offset as an unsigned LEB128 built here from `off` and never read back
; from the cell's decoder; a store takes its base from x and its value from y, a load its base
; from x. It returns the program length. The page is X in a Verilog run until a byte is
; written, so every test stores before it loads and reads only bytes it wrote.
fn mem_poke(op : u8, off : u32) -> u32 {
    var k : u32 = 101;
    var v : u32 = off;
    var more : u32 = 1;
    code[k] = OP_LOCAL_GET;
    code[k + 1] = 0;
    k = k + 2;
    if (op == OP_I32_STORE || op == OP_I32_STORE8 || op == OP_I32_STORE16) {
        code[k] = OP_LOCAL_GET;
        code[k + 1] = 1;
        k = k + 2;
    }
    code[k] = op;
    code[k + 1] = 2;
    k = k + 2;
    while (more == 1) {
        var b : u32 = v & 127;
        v = v >> 7;
        if (v != 0) {
            code[k] = (b | 128) as u8;
        } else {
            code[k] = b as u8;
            more = 0;
        }
        k = k + 1;
    }
    code[k] = OP_END;
    k = k + 1;
    return k - 101;
}

fn mem_go(op : u8, off : u32, seq : u8, x : u32, y : u32) -> u32 {
    var len : u32 = mem_poke(op, off);
    return host_run_user(len as u8, 101, seq, x, y);
}

; Law (FR-001, FR-006): little-endian, one fuel unit per fetch. i32.const 0x11223344 is the
; five-byte signed LEB 41 C4 E6 88 89 01; stored at 16 and read back by i32.load, the page holds
; 44 33 22 11 and the result is the whole word (the wire carries its low 24 bits).
test mem_store_load_round_trip {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_I32_CONST;
    code[102] = 0x10;
    code[103] = OP_I32_CONST;
    code[104] = 0xC4;
    code[105] = 0xE6;
    code[106] = 0x88;
    code[107] = 0x89;
    code[108] = 0x01;
    code[109] = OP_I32_STORE;
    code[110] = 0x02;
    code[111] = 0x00;
    code[112] = OP_I32_CONST;
    code[113] = 0x10;
    code[114] = OP_I32_LOAD;
    code[115] = 0x02;
    code[116] = 0x00;
    code[117] = OP_END;
    r = host_run_user(17, 101, 100, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 100;
    assert err == ERR_NONE;
    assert res == 0x11223344;
    assert w == 0x223344;
    assert mem[16] == 0x44;
    assert mem[17] == 0x33;
    assert mem[18] == 0x22;
    assert mem[19] == 0x11;
    assert fuel == 6;
    assert sp == 1;
    assert frames - f0 == 1;
}

; Law (FR-001, FR-004): i32.load8_u reads one byte of the stored word, zero-extended: +0 is
; 0x44, +1 is 0x33, +3 is 0x11, and base 34 with offset 0 reaches the same byte as base 32
; with offset 2.
test mem_load8_u_picks_each_byte {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 101, 32, 0x11223344);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 0;
    assert mem[32] == 0x44;
    assert mem[33] == 0x33;
    assert mem[34] == 0x22;
    assert mem[35] == 0x11;
    assert fuel == 4;
    r = mem_go(OP_I32_LOAD8_U, 0, 102, 32, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 102;
    assert res == 0x44;
    assert fuel == 3;
    r = mem_go(OP_I32_LOAD8_U, 1, 103, 32, 0);
    assert r == 0;
    assert res == 0x33;
    r = mem_go(OP_I32_LOAD8_U, 0, 104, 34, 0);
    assert r == 0;
    assert res == 0x22;
    r = mem_go(OP_I32_LOAD8_U, 3, 105, 32, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0x11;
    assert frames - f0 == 5;
}

; Law (FR-004): i32.load8_s sign-extends bit 7 -- 0xFF is -1, 0x80 is 0xFFFFFF80, 0x7F stays
; 0x7F -- while i32.load8_u of the same byte does not. i32.store8 keeps only the low byte of
; the value (0x123456FF stores 0xFF).
test mem_load8_s_sign_extends {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE8, 0, 110, 48, 0x123456FF);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[48] == 0xFF;
    r = mem_go(OP_I32_LOAD8_S, 0, 111, 48, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFFFFFF;
    assert w == 0xFFFFFF;
    r = mem_go(OP_I32_LOAD8_U, 0, 112, 48, 0);
    assert r == 0;
    assert res == 0xFF;
    r = mem_go(OP_I32_STORE8, 0, 113, 48, 0x7F);
    assert r == 0;
    assert mem[48] == 0x7F;
    r = mem_go(OP_I32_LOAD8_S, 0, 114, 48, 0);
    assert r == 0;
    assert res == 0x7F;
    r = mem_go(OP_I32_STORE8, 0, 115, 48, 0x80);
    assert r == 0;
    r = mem_go(OP_I32_LOAD8_S, 0, 116, 48, 0);
    assert r == 0;
    assert res == 0xFFFFFF80;
    r = mem_go(OP_I32_LOAD8_U, 0, 117, 48, 0);
    assert r == 0;
    assert res == 0x80;
    assert frames - f0 == 8;
}

; Law (FR-004): i32.load16_s of 0x8000 is 0xFFFF8000 (-32768) and i32.load16_u is 0x8000; 0x7FFF
; is the same under both; i32.store16 keeps only the low two bytes (0xABCD8001 stores 01 80).
test mem_load16_s_and_u {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE16, 0, 120, 56, 0x8000);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[56] == 0x00;
    assert mem[57] == 0x80;
    r = mem_go(OP_I32_LOAD16_S, 0, 121, 56, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFF8000;
    assert w == 0xFF8000;
    r = mem_go(OP_I32_LOAD16_U, 0, 122, 56, 0);
    assert r == 0;
    assert res == 0x8000;
    r = mem_go(OP_I32_STORE16, 0, 123, 56, 0x7FFF);
    assert r == 0;
    r = mem_go(OP_I32_LOAD16_S, 0, 124, 56, 0);
    assert r == 0;
    assert res == 0x7FFF;
    r = mem_go(OP_I32_LOAD16_U, 0, 125, 56, 0);
    assert r == 0;
    assert res == 0x7FFF;
    r = mem_go(OP_I32_STORE16, 0, 126, 56, 0xABCD8001);
    assert r == 0;
    assert mem[56] == 0x01;
    assert mem[57] == 0x80;
    r = mem_go(OP_I32_LOAD16_S, 0, 127, 56, 0);
    assert r == 0;
    assert res == 0xFFFF8001;
    r = mem_go(OP_I32_LOAD16_U, 0, 128, 56, 0);
    assert r == 0;
    assert res == 0x8001;
    assert frames - f0 == 9;
}

; Law (FR-004): store8 and store16 write exactly their width. Eight bytes are written first
; (DD CC BB AA at 24, 66 77 88 99 at 28); store8 at 25 changes one byte, store16 at 26 changes
; two, and the bytes on both sides of each, which this test wrote, are untouched.
test mem_store8_and_store16_leave_the_neighbours {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 130, 24, 0xAABBCCDD);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = mem_go(OP_I32_STORE, 0, 131, 28, 0x99887766);
    assert r == 0;
    assert mem[24] == 0xDD;
    assert mem[25] == 0xCC;
    assert mem[26] == 0xBB;
    assert mem[27] == 0xAA;
    assert mem[28] == 0x66;
    assert mem[29] == 0x77;
    assert mem[30] == 0x88;
    assert mem[31] == 0x99;
    r = mem_go(OP_I32_STORE8, 0, 132, 25, 0xFFFFFF11);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[24] == 0xDD;
    assert mem[25] == 0x11;
    assert mem[26] == 0xBB;
    assert mem[27] == 0xAA;
    r = mem_go(OP_I32_STORE16, 0, 133, 26, 0xFFFF2233);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert fuel == 4;
    assert mem[24] == 0xDD;
    assert mem[25] == 0x11;
    assert mem[26] == 0x33;
    assert mem[27] == 0x22;
    assert mem[28] == 0x66;
    assert mem[29] == 0x77;
    assert mem[30] == 0x88;
    assert mem[31] == 0x99;
    r = mem_go(OP_I32_LOAD, 0, 134, 24, 0);
    assert r == 0;
    assert res == 0x223311DD;
    r = mem_go(OP_I32_LOAD, 0, 135, 28, 0);
    assert r == 0;
    assert res == 0x99887766;
    assert frames - f0 == 6;
}

; Law (FR-002): the effective address is base + offset, for a one-, two- and three-byte offset
; LEB; the align field is read and ignored, even as a padded two-byte LEB (80 00); a fifth
; continuation byte in either field answers ERR_LEB, and a memarg cut off by the program end
; answers ERR_PC.
test mem_offset_immediate_adds {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = mem_go(OP_I32_STORE, 40, 140, 2, 0xA1B2C3D4);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[42] == 0xD4;
    assert mem[43] == 0xC3;
    assert mem[44] == 0xB2;
    assert mem[45] == 0xA1;
    r = mem_go(OP_I32_LOAD, 2, 141, 40, 0);
    assert r == 0;
    assert res == 0xA1B2C3D4;
    r = mem_go(OP_I32_LOAD8_U, 45, 142, 0, 0);
    assert r == 0;
    assert res == 0xA1;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_I32_LOAD;
    code[104] = 0x80;
    code[105] = 0x00;
    code[106] = 0x02;
    code[107] = OP_END;
    r = host_run_user(7, 101, 143, 40, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xA1B2C3D4;
    r = mem_go(OP_I32_STORE, 256, 144, 44, 0x0F0E0D0C);
    assert r == 0;
    assert mem[300] == 0x0C;
    assert mem[301] == 0x0D;
    assert mem[302] == 0x0E;
    assert mem[303] == 0x0F;
    r = mem_go(OP_I32_LOAD, 200, 145, 100, 0);
    assert r == 0;
    assert res == 0x0F0E0D0C;
    r = mem_go(OP_I32_STORE8, 16384, 146, 5, 0x5A);
    assert r == 0;
    assert mem[16389] == 0x5A;
    r = mem_go(OP_I32_LOAD8_U, 0, 147, 16389, 0);
    assert r == 0;
    assert res == 0x5A;
    r = mem_go(OP_I32_STORE, 65532, 148, 0, 0x0A0B0C0D);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = mem_go(OP_I32_LOAD, 65532, 149, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0x0A0B0C0D;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_I32_LOAD;
    code[104] = 0x02;
    code[105] = 0x80;
    code[106] = 0x80;
    code[107] = 0x80;
    code[108] = 0x80;
    code[109] = 0x80;
    code[110] = OP_END;
    r = host_run_user(10, 101, 150, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LEB;
    code[104] = 0x80;
    code[105] = 0x80;
    code[106] = 0x80;
    code[107] = 0x80;
    code[108] = 0x80;
    code[109] = 0x00;
    r = host_run_user(10, 101, 151, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LEB;
    code[104] = 0x02;
    r = host_run_user(4, 101, 152, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PC;
    assert frames - f0 == 13;
}

; Law (FR-003): an access of width w traps when base + offset > 65536 - w, as a 33-bit sum.
; The last access of each width fits (i32.load at 65532, load16 at 65534, load8 at 65535, load8
; with base 65000 and offset 535); one byte further traps with RESP_BADOP and ERR_MEM, ms 0 and
; the wire word 0, after two fetches of fuel (the local.get and the access). A base of 0xFFFFFFFF
; plus offset 1, a five-byte offset of 0xFFFFFFFF and 0xFFFF0000 plus 0x10000 would each wrap to
; a legal 32-bit address and must still trap. A trapping store writes no byte: the page keeps
; BE BA FE CA at 65532 and 5C at 0. The next request runs.
test mem_access_past_the_page_traps {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 160, 65532, 0xCAFEBABE);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert mem[65532] == 0xBE;
    assert mem[65533] == 0xBA;
    assert mem[65534] == 0xFE;
    assert mem[65535] == 0xCA;
    r = mem_go(OP_I32_LOAD, 0, 161, 65532, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xCAFEBABE;
    r = mem_go(OP_I32_LOAD16_U, 0, 162, 65534, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xCAFE;
    r = mem_go(OP_I32_LOAD8_U, 0, 163, 65535, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xCA;
    r = mem_go(OP_I32_STORE8, 0, 164, 0, 0x5C);
    assert r == 0;
    assert mem[0] == 0x5C;
    r = mem_go(OP_I32_LOAD, 0, 165, 65533, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 165;
    assert w == 0;
    assert err == ERR_MEM;
    assert ms == 0;
    assert mem_run == 0;
    assert fuel == 2;
    r = mem_go(OP_I32_LOAD16_S, 0, 166, 65535, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_S, 0, 167, 65536, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_U, 535, 168, 65000, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 0xCA;
    r = mem_go(OP_I32_LOAD8_U, 536, 169, 65000, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_U, 1, 170, 0xFFFFFFFF, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD8_U, 0xFFFFFFFF, 171, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_LOAD, 0x10000, 172, 0xFFFF0000, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = mem_go(OP_I32_STORE, 0, 173, 65533, 0x01020304);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert mem[65532] == 0xBE;
    assert mem[65533] == 0xBA;
    assert mem[65534] == 0xFE;
    assert mem[65535] == 0xCA;
    r = mem_go(OP_I32_STORE16, 0, 174, 65535, 0x0102);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert mem[65535] == 0xCA;
    r = mem_go(OP_I32_STORE8, 1, 175, 0xFFFFFFFF, 0x77);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert mem[0] == 0x5C;
    r = mem_go(OP_I32_LOAD8_U, 0, 176, 65535, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 176;
    assert err == ERR_NONE;
    assert res == 0xCA;
    assert frames - f0 == 17;
}

; Law (FR-005): memory.size is 0x3F with a reserved 0x00 and pushes 1 (one page); it composes
; on the stack (1 + 1 is 2, 5 + 1 is 6). A reserved byte other than 0 answers ERR_MEM, a
; memory.size cut off by the program end ERR_PC. The scan steps over the reserved byte: a
; skipped `3F 0B` is not an end, so the br_if lands after the real end and returns 7.
test mem_size_is_one_page {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_MEMORY_SIZE;
    code[102] = 0x00;
    code[103] = OP_END;
    r = host_run_user(3, 101, 180, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 180;
    assert err == ERR_NONE;
    assert res == 1;
    assert w == 1;
    assert fuel == 2;
    assert sp == 1;
    code[103] = OP_MEMORY_SIZE;
    code[104] = 0x00;
    code[105] = OP_I32_ADD;
    code[106] = OP_END;
    r = host_run_user(6, 101, 181, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 2;
    code[101] = OP_I32_CONST;
    code[102] = 0x05;
    r = host_run_user(6, 101, 182, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 6;
    code[101] = OP_MEMORY_SIZE;
    code[102] = 0x01;
    code[103] = OP_END;
    r = host_run_user(3, 101, 183, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    r = host_run_user(1, 101, 184, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PC;
    code[101] = OP_BLOCK;
    code[102] = BT_VOID;
    code[103] = OP_I32_CONST;
    code[104] = 0x01;
    code[105] = OP_BR_IF;
    code[106] = 0x00;
    code[107] = OP_MEMORY_SIZE;
    code[108] = 0x0B;
    code[109] = OP_END;
    code[110] = OP_I32_CONST;
    code[111] = 0x07;
    code[112] = OP_END;
    r = host_run_user(12, 101, 185, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 7;
    assert frames - f0 == 6;
}

; Law (FR-005): memory.grow pops its delta and pushes 0xFFFFFFFF (-1), grows nothing, for every
; delta including 0 (a deviation from the WASM spec, which returns the old size for 0); the
; size stays 1 afterwards. An empty stack answers ERR_STACK, a reserved byte other than 0
; ERR_MEM.
test mem_grow_refuses {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_MEMORY_GROW;
    code[104] = 0x00;
    code[105] = OP_END;
    r = host_run_user(5, 101, 190, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 190;
    assert err == ERR_NONE;
    assert res == 0xFFFFFFFF;
    assert w == 0xFFFFFF;
    assert fuel == 3;
    assert sp == 1;
    r = host_run_user(5, 101, 191, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFFFFFF;
    r = host_run_user(5, 101, 192, 0xFFFFFFFF, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 0xFFFFFFFF;
    code[105] = OP_DROP;
    code[106] = OP_MEMORY_SIZE;
    code[107] = 0x00;
    code[108] = OP_END;
    r = host_run_user(8, 101, 193, 3, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 1;
    code[101] = OP_MEMORY_GROW;
    code[102] = 0x00;
    code[103] = OP_END;
    r = host_run_user(3, 101, 194, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_STACK;
    code[101] = OP_LOCAL_GET;
    code[102] = 0x00;
    code[103] = OP_MEMORY_GROW;
    code[104] = 0x01;
    code[105] = OP_END;
    r = host_run_user(5, 101, 195, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_MEM;
    assert frames - f0 == 6;
}

; Law (FR-002, FR-010 of #12202): a taken br_if skips a load whose offset is a two-byte LEB
; that ends in 0x0B (80 0B, offset 1408): a scan that did not know the memarg would read that
; byte as the block's end. y = 1 skips it and returns the 7 the block carried (5 fetches); y = 0
; falls through, drops the 7, loads the word stored at 4 + 1408 and returns it (9 fetches).
test mem_br_if_skips_a_load_with_a_two_byte_offset {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    r = mem_go(OP_I32_STORE, 0, 200, 1412, 0x0D0C0B0A);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert mem[1412] == 0x0A;
    assert mem[1415] == 0x0D;
    code[101] = OP_BLOCK;
    code[102] = BT_I32;
    code[103] = OP_I32_CONST;
    code[104] = 0x07;
    code[105] = OP_LOCAL_GET;
    code[106] = 0x01;
    code[107] = OP_BR_IF;
    code[108] = 0x00;
    code[109] = OP_DROP;
    code[110] = OP_LOCAL_GET;
    code[111] = 0x00;
    code[112] = OP_I32_LOAD;
    code[113] = 0x02;
    code[114] = 0x80;
    code[115] = 0x0B;
    code[116] = OP_END;
    code[117] = OP_END;
    r = host_run_user(17, 101, 201, 4, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 201;
    assert err == ERR_NONE;
    assert res == 7;
    assert fuel == 5;
    assert lsp == 0;
    r = host_run_user(17, 101, 202, 4, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 0x0D0C0B0A;
    assert w == 0x0C0B0A;
    assert fuel == 9;
    assert frames - f0 == 3;
}

; --- P6 control flow, calls and globals (issue #12323): builders, oracles and the tests -------
; Host side only: none of these functions is called from step_all, so none reaches the Verilog
; (the mem_poke precedent). cl_put writes one program byte at code[at] and returns the next
; position, so a program is a chain  k = cl_put(k, byte);  that reads like its hex dump. Every
; test loads the function rows, elements and globals it needs over the wire (OP 0xFC, see
; host_fn and host_table), writes the bytes of the root program and of each callee into the tail
; code[101..127], and compares against a golden written here, never read back from the cell.
; Function row 7 is never loaded anywhere in this file: it is the empty row ERR_FUNC names.
; Fuel counts fetches only; the forward scan of a skipped arm is free.
fn cl_put(at : u32, b : u8) -> u32 {
    code[at] = b;
    return at + 1;
}

fn cl_put2(at : u32, b0 : u8, b1 : u8) -> u32 {
    code[at] = b0;
    code[at + 1] = b1;
    return at + 2;
}

; IFE, 14 bytes at code[101..114]:
;     local.get 0 ; if (result i32) ; i32.const 10 ; else ; i32.const 15 ; i32.const 6 ;
;     i32.add ; end ; end
fn cl_emit_ife() -> u32 {
    var k : u32 = 101;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_IF, BT_I32);
    k = cl_put2(k, OP_I32_CONST, 0x0A);
    k = cl_put(k, OP_ELSE);
    k = cl_put2(k, OP_I32_CONST, 0x0F);
    k = cl_put2(k, OP_I32_CONST, 0x06);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put(k, OP_END);
    k = cl_put(k, OP_END);
    return k - 101;
}

; LOOPIF, 30 bytes at code[98..127] (the tail of the baked ROM is overwritten; cf_restore puts
; it back): a do-while that counts x down to 0 and bumps local 1 on every odd counter value.
;     loop ; local.get 0 ; i32.const 1 ; i32.and ; if ; local.get 1 ; i32.const 1 ; i32.add ;
;     local.set 1 ; end ; local.get 0 ; i32.const 1 ; i32.sub ; local.tee 0 ; br_if 0 ; end ;
;     local.get 1 ; end
fn cl_emit_loopif() -> u32 {
    var k : u32 = 98;
    k = cl_put2(k, OP_LOOP, BT_VOID);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put(k, OP_I32_AND);
    k = cl_put2(k, OP_IF, BT_VOID);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put2(k, OP_LOCAL_SET, 0x01);
    k = cl_put(k, OP_END);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put(k, OP_I32_SUB);
    k = cl_put2(k, OP_LOCAL_TEE, 0x00);
    k = cl_put2(k, OP_BR_IF, 0x00);
    k = cl_put(k, OP_END);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put(k, OP_END);
    return k - 98;
}

; Closed forms of LOOPIF for x >= 1 (a do-while runs its body once even for 0, so x = 0 is
; not swept): the counter takes the values x, x-1, ..., 1; the odd ones among them number
; (x + 1) / 2 and each adds 1 to y. The loop opcode, its end, the final local.get and the
; function end cost 4 fetches; an odd iteration costs 14 (the if arm runs), an even one 9.
fn cl_loop_ret(x : u32, y : u32) -> u32 {
    return y + ((x + 1) / 2);
}

fn cl_loop_fuel(x : u32) -> u32 {
    return 4 + (14 * ((x + 1) / 2)) + (9 * (x / 2));
}

; FACT, 20 bytes at code[101..120]: the recursive factorial, plus its caller at code[121..125].
;     local.get 0 ; i32.eqz ; if (result i32) ; i32.const 1 ; else ; local.get 0 ; local.get 0 ;
;     i32.const 1 ; i32.sub ; call 0 ; i32.mul ; end ; end          (function row 0, 1 param)
;     local.get 0 ; call 0 ; end                                      (the root, run at 121)
fn cl_emit_fact() -> u32 {
    var k : u32 = 101;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I32_EQZ);
    k = cl_put2(k, OP_IF, BT_I32);
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put(k, OP_ELSE);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put(k, OP_I32_SUB);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_I32_MUL);
    k = cl_put(k, OP_END);
    k = cl_put(k, OP_END);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_END);
    return k - 101;
}

; The factorial modulo 2^32, by repeated multiplication in u64 (n! for n <= 12 fits in 32 bits).
fn ref_fact(n : u32) -> u32 {
    var r : u64 = 1;
    var i : u32 = 2;
    while (i <= n) {
        r = (r * (i as u64)) & I32_MASK;
        i = i + 1;
    }
    return wrap32(r);
}

; CI, 8 bytes at code[101..108], the type immediate in code[106]:
;     local.get 0 ; local.get 1 ; call_indirect ty 0 ; end
; with two callees of one parameter: f0 = x + 10 at code[109..114] and f1 = x - 1 at
; code[115..120]. The popped element index is y, the argument is x.
fn cl_emit_ci(ty : u8) -> u32 {
    var k : u32 = 101;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put2(k, OP_CALL_INDIRECT, ty);
    k = cl_put(k, 0x00);
    k = cl_put(k, OP_END);
    k = 109;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_I32_CONST, 0x0A);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put(k, OP_END);
    k = 115;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put(k, OP_I32_SUB);
    k = cl_put(k, OP_END);
    return 8;
}

; The tables CI runs against: rows 0 and 1 of type ty, elements [1, 0, 1, (untouched)]. Returns
; the sum of the host_recv statuses (0 when every frame was answered).
fn cl_setup_ci(ty : u32) -> u32 {
    var s : u32 = 0;
    s = s + host_fn(0, 109, 1, 0, ty);
    s = s + host_fn(1, 115, 1, 0, ty);
    s = s + host_table(1, 0, 1);
    s = s + host_table(1, 1, 0);
    s = s + host_table(1, 2, 1);
    return s;
}

; Law (FR-001, FR-003): `if` pops the condition and, when it is non-zero, runs the then-arm;
; the `else` reached by falling through that arm skips to the matching `end` (a forward scan,
; whose steps are not fetches). IFE with x = 1 and with x = 0x80000000 (non-zero with a zero low
; byte: the condition is the whole word) answers 10 in 5 fetches: local.get, if, const, else,
; function end.
test cl_if_takes_then_arm {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var len : u32 = 0;
    len = cl_emit_ife();
    assert len == 14;
    r = host_run_user(len as u8, 101, 10, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 10;
    assert err == ERR_NONE;
    assert res == 10;
    assert fuel == 5;
    assert sp == 1;
    assert lsp == 0;
    assert csp == 0;
    r = host_run_user(len as u8, 101, 11, 0x80000000, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 10;
    assert fuel == 5;
    assert lsp == 0;
    assert frames - f0 == 2;
}

; Law (FR-001, FR-003): a false condition skips to the byte after the matching `else` and the
; else-arm runs up to the `end` of the if. IFE with x = 0 answers 15 + 6 = 21 in 7 fetches.
; Hand trace (IFE at code[101..114]; the skipped bytes are scan steps, not fetches):
;   pc 0   20 00  local.get 0     push x = 0                                        fuel 1
;   pc 2   04 7F  if (result i32) pop 0 = false, push the if label (lsp 1), scan on  fuel 2
;   scan   41 0A  i32.const 10    two bytes skipped (one-LEB class)                  free
;   scan   05     else            depth 1 and a false condition: stop after it       free
;   pc 7   41 0F  i32.const 15    push 15                                            fuel 3
;   pc 9   41 06  i32.const 6     push 6                                             fuel 4
;   pc 11  6A     i32.add         15 + 6 = 21                                        fuel 5
;   pc 12  0B     end             closes the if: pop its label (lsp 0)               fuel 6
;   pc 13  0B     end             function level, no frame open: res = 21, run over  fuel 7
test cl_if_takes_else_arm {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    var len : u32 = 0;
    len = cl_emit_ife();
    r = host_run_user(len as u8, 101, 20, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 20;
    assert err == ERR_NONE;
    assert res == 21;
    assert w == 21;
    assert fuel == 7;
    assert sp == 1;
    assert lsp == 0;
    assert csp == 0;
    assert frames - f0 == 1;
}

; Law (FR-003): an `if` without `else` and a false condition skips to the byte after its `end`
; and pops the label. Program (12 bytes): local.get 0 ; if ; i32.const 7 ; local.set 1 ; end ;
; local.get 1 ; end. With x = 0 the arm is skipped and y = 100 comes back (4 fetches); with
; x = 1 the arm sets local 1 to 7 and the program returns it (7 fetches).
test cl_if_without_else_skips {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_IF, BT_VOID);
    k = cl_put2(k, OP_I32_CONST, 0x07);
    k = cl_put2(k, OP_LOCAL_SET, 0x01);
    k = cl_put(k, OP_END);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put(k, OP_END);
    assert k == 113;
    r = host_run_user(12, 101, 30, 0, 100);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 100;
    assert fuel == 4;
    assert lsp == 0;
    r = host_run_user(12, 101, 31, 1, 100);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 7;
    assert fuel == 7;
    assert lsp == 0;
    assert frames - f0 == 2;
}

; Law (FR-003): the forward scan reads whole instructions, so a 0x05 or 0x0B that is the
; immediate of an i32.const is never an `else` or an `end`, and an inner if is a depth, not a
; delimiter. Program (19 bytes), the two immediates written with the opcode constants:
;     local.get 0 ; if (result i32) ; local.get 1 ; if (result i32) ; i32.const OP_ELSE (5) ;
;     else ; i32.const OP_END (11) ; end ; else ; i32.const 3 ; end ; end
; x = 0 skips the whole outer then-arm, inner if and both immediates included, and answers 3
; (5 fetches); x = 1, y = 1 answers 5 (8 fetches); x = 1, y = 0 skips the inner then-arm over
; the `41 05` and answers 11 (8 fetches).
test cl_nested_if_in_immediate_is_not_a_delimiter {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_IF, BT_I32);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put2(k, OP_IF, BT_I32);
    k = cl_put2(k, OP_I32_CONST, OP_ELSE);
    k = cl_put(k, OP_ELSE);
    k = cl_put2(k, OP_I32_CONST, OP_END);
    k = cl_put(k, OP_END);
    k = cl_put(k, OP_ELSE);
    k = cl_put2(k, OP_I32_CONST, 0x03);
    k = cl_put(k, OP_END);
    k = cl_put(k, OP_END);
    assert k == 120;
    assert OP_ELSE == 5;
    assert OP_END == 11;
    r = host_run_user(19, 101, 40, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 3;
    assert fuel == 5;
    assert lsp == 0;
    r = host_run_user(19, 101, 41, 1, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 5;
    assert fuel == 8;
    assert lsp == 0;
    r = host_run_user(19, 101, 42, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 11;
    assert fuel == 8;
    assert lsp == 0;
    assert frames - f0 == 3;
}

; Law (FR-006, FR-003): an if-arm inside a loop. LOOPIF counts x down and adds 1 to y on every
; odd counter value; the result and the fuel come from cl_loop_ret and cl_loop_fuel, closed
; forms written above (x = 5, y = 10: counters 5 4 3 2 1, three odd, result 13; 4 + 14 * 3 +
; 9 * 2 = 64 fetches). x = 1 and x = 2 are the shortest odd and even tails; x = 6 ends on an
; even counter.
test cl_if_inside_loop_counts {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var len : u32 = 0;
    var want : u32 = 0;
    var wf : u32 = 0;
    len = cl_emit_loopif();
    assert len == 30;
    want = cl_loop_ret(5, 10);
    wf = cl_loop_fuel(5);
    assert want == 13;
    assert wf == 64;
    r = host_run_user(len as u8, 98, 50, 5, 10);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == want;
    assert fuel == wf;
    assert lsp == 0;
    want = cl_loop_ret(1, 10);
    wf = cl_loop_fuel(1);
    assert want == 11;
    assert wf == 18;
    r = host_run_user(len as u8, 98, 51, 1, 10);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == want;
    assert fuel == wf;
    want = cl_loop_ret(2, 10);
    wf = cl_loop_fuel(2);
    assert want == 11;
    assert wf == 27;
    r = host_run_user(len as u8, 98, 52, 2, 10);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == want;
    assert fuel == wf;
    want = cl_loop_ret(6, 10);
    wf = cl_loop_fuel(6);
    assert want == 13;
    assert wf == 73;
    r = host_run_user(len as u8, 98, 53, 6, 10);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == want;
    assert fuel == wf;
    assert frames - f0 == 4;
    cf_restore();
}

; Law (FR-003): `br` out of an if-arm lands after the `end` of the label it names. Program A
; (15 bytes): block (result i32) ; local.get 0 ; if ; i32.const 42 ; br 1 ; end ; i32.const 7 ;
; end ; end. br 1 leaves the if and the block carrying 42; with x = 0 the arm is skipped and the
; block falls through to 7. Program B (18 bytes): local.get 0 ; if ; i32.const 1 ; local.set 1 ;
; br 0 ; i32.const 2 ; local.set 1 ; end ; local.get 1 ; end. br 0 leaves the if, so the
; second local.set never runs: y = 1 for x != 0, the untouched y = 100 for x = 0.
test cl_br_out_of_if_arm {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    k = cl_put2(k, OP_BLOCK, BT_I32);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_IF, BT_VOID);
    k = cl_put2(k, OP_I32_CONST, 0x2A);
    k = cl_put2(k, OP_BR, 0x01);
    k = cl_put(k, OP_END);
    k = cl_put2(k, OP_I32_CONST, 0x07);
    k = cl_put(k, OP_END);
    k = cl_put(k, OP_END);
    assert k == 116;
    r = host_run_user(15, 101, 60, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 42;
    assert fuel == 6;
    assert lsp == 0;
    r = host_run_user(15, 101, 61, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 7;
    assert fuel == 6;
    assert lsp == 0;
    k = 101;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_IF, BT_VOID);
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put2(k, OP_LOCAL_SET, 0x01);
    k = cl_put2(k, OP_BR, 0x00);
    k = cl_put2(k, OP_I32_CONST, 0x02);
    k = cl_put2(k, OP_LOCAL_SET, 0x01);
    k = cl_put(k, OP_END);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put(k, OP_END);
    assert k == 119;
    r = host_run_user(18, 101, 62, 1, 100);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 1;
    assert fuel == 7;
    assert lsp == 0;
    r = host_run_user(18, 101, 63, 0, 100);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 100;
    assert fuel == 4;
    assert lsp == 0;
    assert frames - f0 == 4;
}

; Law (FR-001, FR-002): `call` moves the parameters into the callee's fresh locals in push order
; (the first pushed is local 0). Root: local.get 0 ; local.get 1 ; call 0 ; end (7 bytes at 101).
; f0 (row 0, two parameters, code[108..113]): local.get 0 ; local.get 1 ; i32.sub ; end. The
; subtraction is not commutative: x = 50, y = 8 answers 42 and x = 8, y = 50 answers -42
; (0xFFFFFFD6), each in 8 fetches (root 4, callee 4).
test cl_call_adds_two_params {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    var want : u32 = 0;
    r = host_fn(0, 108, 2, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert fn_np[0] == 2;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_END);
    assert k == 108;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put(k, OP_I32_SUB);
    k = cl_put(k, OP_END);
    assert k == 114;
    r = host_run_user(7, 101, 70, 50, 8);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 70;
    assert err == ERR_NONE;
    assert res == 42;
    assert fuel == 8;
    assert csp == 0;
    want = wrap32((8 as u64) + 4294967296 - (50 as u64));
    assert want == 0xFFFFFFD6;
    r = host_run_user(7, 101, 71, 8, 50);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == want;
    assert fuel == 8;
    assert csp == 0;
    assert frames - f0 == 2;
}

; Law (FR-001, FR-002): a function that leaves nothing above its frame height is void and the
; caller's stack comes back exactly as it was below the arguments. Root: i32.const 9 ;
; local.get 0 ; call 0 ; end (7 bytes at 101). f0 (row 0, one parameter, code[108..111]):
; local.get 0 ; drop ; end. The 9 is still on the stack after the call, so the run answers 9
; with sp = 1, in 7 fetches (root 4, callee 3), for x = 77 and for x = 0.
test cl_call_void_function_leaves_stack {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    r = host_fn(0, 108, 1, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    k = cl_put2(k, OP_I32_CONST, 0x09);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_END);
    assert k == 108;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_DROP);
    k = cl_put(k, OP_END);
    assert k == 112;
    r = host_run_user(7, 101, 80, 77, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 9;
    assert sp == 1;
    assert fuel == 7;
    assert csp == 0;
    r = host_run_user(7, 101, 81, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 9;
    assert sp == 1;
    assert fuel == 7;
    assert frames - f0 == 2;
}

; Law (FR-002): locals are per frame. Root (11 bytes at 101): local.get 0 ; call 0 ; local.get 0 ;
; i32.add ; local.get 1 ; i32.add ; end. f0 (row 0, one parameter and one local, code[112..125]):
; local.get 1 ; local.get 0 ; i32.add ; i32.const 7 ; local.set 1 ; i32.const 50 ; local.set 0 ;
; end. The callee returns x + its fresh local 1 (zero) and then writes 7 and 50 into its own
; locals; the root's own local 0 is still x, so the result is x + x + y: 23 for (10, 3). The
; second run (20, 1) answers 41 only if the callee's local 1 was zeroed again: a leftover 7
; would make it 48. 15 fetches each.
test cl_call_locals_are_per_frame {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    r = host_fn(0, 112, 1, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert fn_nl[0] == 1;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put(k, OP_END);
    assert k == 112;
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put2(k, OP_I32_CONST, 0x07);
    k = cl_put2(k, OP_LOCAL_SET, 0x01);
    k = cl_put2(k, OP_I32_CONST, 0x32);
    k = cl_put2(k, OP_LOCAL_SET, 0x00);
    k = cl_put(k, OP_END);
    assert k == 126;
    r = host_run_user(11, 101, 90, 10, 3);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 23;
    assert fuel == 15;
    assert csp == 0;
    r = host_run_user(11, 101, 91, 20, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 41;
    assert fuel == 15;
    assert frames - f0 == 2;
}

; Law (FR-002, FR-004): the callee's locals are bounded by its own row (parameters + locals), not
; by the root's four. Root (5 bytes at 101): i32.const 5 ; call 0 ; end. f0 (code[106..111]):
; local.get 2 ; i32.const 7 ; i32.add ; end. With one parameter and one local the callee has
; two locals, so local.get 2 is ERR_LOCAL on its first fetch (3 fetches in all); with one
; parameter and two locals the same bytes answer 0 + 7 = 7 in 7 fetches.
test cl_call_callee_locals_are_bounded {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    k = cl_put2(k, OP_I32_CONST, 0x05);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_END);
    assert k == 106;
    k = cl_put2(k, OP_LOCAL_GET, 0x02);
    k = cl_put2(k, OP_I32_CONST, 0x07);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put(k, OP_END);
    assert k == 112;
    r = host_fn(0, 106, 1, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(5, 101, 100, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 100;
    assert err == ERR_LOCAL;
    assert fuel == 3;
    r = host_fn(0, 106, 1, 2, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(5, 101, 101, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 7;
    assert fuel == 7;
    assert csp == 0;
    assert frames - f0 == 2;
}

; Law (FR-002, FR-005, FR-006): a recursive body runs to the depth of the call stack. FACT
; (cl_emit_fact) is row 0 with one parameter; the root at code[121..125] calls it with x = n.
; The golden is ref_fact (repeated multiplication); the fuel is a closed form: F(0) = 6 fetches
; (local.get, eqz, if, const, else, function end), F(n) = 11 + F(n - 1) (the other arm: local.get,
; eqz, if, local.get, local.get, const, sub, call, mul, end, function end, plus the callee), and
; the root adds 3, so 9 + 11 n. n = 0..3 reach csp 1..4 and answer 1, 1, 2, 6 in 9, 20, 31, 42
; fetches. n = 4 needs a fifth frame: ERR_CALL on the call fetch of F(1), csp = CALL_MAX,
; 2 + 8 * 4 = 34 fetches, and the next request (n = 2) answers 2 again.
; Hand trace of n = 1 (res 1, fuel 20; the root is in the window 121..125, FACT at 101..120):
;   root pc 0  20 00  local.get 0    push 1                                       fuel 1
;   root pc 2  10 00  call 0         np 1: 1 -> callee local 0; frame 0 keeps pc 4, sp 0   fuel 2
;   F(1)  pc 0  20 00  local.get 0   push 1                                       fuel 3
;   F(1)  pc 2  45     i32.eqz       1 -> 0                                       fuel 4
;   F(1)  pc 3  04 7F  if            pop 0 = false: label, scan to just after else  fuel 5
;   F(1)  pc 8  20 00  local.get 0   push 1                                       fuel 6
;   F(1)  pc 10 20 00  local.get 0   push 1                                       fuel 7
;   F(1)  pc 12 41 01  i32.const 1   push 1                                       fuel 8
;   F(1)  pc 14 6B     i32.sub       1 - 1 = 0                                    fuel 9
;   F(1)  pc 15 10 00  call 0        np 1: 0 -> local 0; frame 1 keeps pc 17, sp 1  fuel 10
;   F(0)  pc 0  20 00  local.get 0   push 0                                       fuel 11
;   F(0)  pc 2  45     i32.eqz       0 -> 1                                       fuel 12
;   F(0)  pc 3  04 7F  if            pop 1 = true: label, no scan                 fuel 13
;   F(0)  pc 5  41 01  i32.const 1   push 1                                       fuel 14
;   F(0)  pc 7  05     else          falls through the then-arm: scan to the end, pop label  fuel 15
;   F(0)  pc 19 0B     end           function level: return to frame 1, result 1 kept  fuel 16
;   F(1)  pc 17 6C     i32.mul       1 * 1 = 1                                    fuel 17
;   F(1)  pc 18 0B     end           closes the if                                fuel 18
;   F(1)  pc 19 0B     end           function level: return to frame 0, result 1  fuel 19
;   root  pc 4  0B     end           no frame open: res = 1                       fuel 20
test cl_call_recursive_fact_to_depth {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var len : u32 = 0;
    var g0 : u32 = 0;
    var g1 : u32 = 0;
    var g2 : u32 = 0;
    var g3 : u32 = 0;
    r = host_fn(0, 101, 1, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    len = cl_emit_fact();
    assert len == 25;
    g0 = ref_fact(0);
    g1 = ref_fact(1);
    g2 = ref_fact(2);
    g3 = ref_fact(3);
    assert g0 == 1;
    assert g1 == 1;
    assert g2 == 2;
    assert g3 == 6;
    r = host_run_user(5, 121, 110, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 110;
    assert err == ERR_NONE;
    assert res == g0;
    assert fuel == 9;
    assert csp == 0;
    r = host_run_user(5, 121, 111, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == g1;
    assert fuel == 20;
    assert csp == 0;
    r = host_run_user(5, 121, 112, 2, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == g2;
    assert fuel == 31;
    assert csp == 0;
    r = host_run_user(5, 121, 113, 3, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == g3;
    assert fuel == 42;
    assert csp == 0;
    assert lsp == 0;
    r = host_run_user(5, 121, 114, 4, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 114;
    assert err == ERR_CALL;
    assert csp == CALL_MAX;
    assert fuel == 34;
    r = host_run_user(5, 121, 115, 2, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 115;
    assert err == ERR_NONE;
    assert res == g2;
    assert fuel == 31;
    assert csp == 0;
    assert frames - f0 == 6;
}

; Law (FR-001, FR-002): `return` unwinds every open label of the current function and the
; frame, and keeps the top of the stack as the result. Root (8 bytes at 101): i32.const 1 ;
; local.get 0 ; call 0 ; i32.add ; end. f0 (row 0, one parameter, code[109..122], 14 bytes):
; block ; local.get 0 ; if ; i32.const 5 ; return ; end ; end ; i32.const 9 ; end.
; x = 1 returns 5 from two levels down: 1 + 5 = 6 in 10 fetches, lsp 0 and csp 0 afterwards;
; x = 0 skips the arm, leaves the block and returns the 9 by the function end: 1 + 9 = 10 in
; 11 fetches.
; Hand trace, x = 1:
;   root pc 0  41 01  i32.const 1     stack [1]                                     fuel 1
;   root pc 2  20 00  local.get 0     stack [1 1]                                   fuel 2
;   root pc 4  10 00  call 0          np 1: the top 1 -> f0 local 0; stack [1]; frame 0
;                                     keeps pc 6, sp 1, lsp 0; csp 1                fuel 3
;   f0   pc 0  02 40  block           label (lsp 1)                                 fuel 4
;   f0   pc 2  20 00  local.get 0     stack [1 1]                                   fuel 5
;   f0   pc 4  04 40  if              pop 1 = true: label (lsp 2); stack [1]        fuel 6
;   f0   pc 6  41 05  i32.const 5     stack [1 5]                                   fuel 7
;   f0   pc 8  0F     return          height 2 > frame sp 1: the 5 is the result;
;                                     lsp 2 -> 0, back to root pc 6, csp 0          fuel 8
;   root pc 6  6A     i32.add         1 + 5 = 6                                     fuel 9
;   root pc 7  0B     end             no frame open: res = 6                        fuel 10
; With x = 0 the if scan skips pc 6..9 (and pops its label); fetches: root 3, block 4,
; local.get 5, if 6, end of the block (pc 10) 7, i32.const 9 8, function end (lsp equals the
; label height at entry, so it returns) 9, root add 10, root end 11.
test cl_return_unwinds_labels_and_frame {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    r = host_fn(0, 109, 1, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    k = cl_put2(k, OP_I32_CONST, 0x01);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put(k, OP_END);
    assert k == 109;
    k = cl_put2(k, OP_BLOCK, BT_VOID);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_IF, BT_VOID);
    k = cl_put2(k, OP_I32_CONST, 0x05);
    k = cl_put(k, OP_RETURN);
    k = cl_put(k, OP_END);
    k = cl_put(k, OP_END);
    k = cl_put2(k, OP_I32_CONST, 0x09);
    k = cl_put(k, OP_END);
    assert k == 123;
    r = host_run_user(8, 101, 120, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 120;
    assert err == ERR_NONE;
    assert res == 6;
    assert fuel == 10;
    assert lsp == 0;
    assert csp == 0;
    r = host_run_user(8, 101, 121, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 10;
    assert fuel == 11;
    assert lsp == 0;
    assert csp == 0;
    assert frames - f0 == 2;
}

; Law (FR-001): with no frame open `return` ends the run with the top of the stack, as `end`
; does, and the bytes after it are never fetched. Program (6 bytes): i32.const 42 ; return ;
; i32.const 7 ; end. 42 in 2 fetches.
test cl_return_at_root_ends_the_run {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    k = cl_put2(k, OP_I32_CONST, 0x2A);
    k = cl_put(k, OP_RETURN);
    k = cl_put2(k, OP_I32_CONST, 0x07);
    k = cl_put(k, OP_END);
    assert k == 107;
    r = host_run_user(6, 101, 125, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 125;
    assert err == ERR_NONE;
    assert res == 42;
    assert fuel == 2;
    assert csp == 0;
    assert frames - f0 == 1;
}

; Law (FR-002, FR-005): ERR_CALL. A function that calls itself with no base case is stopped at
; the depth limit, not by the fuel: root and f0 are both  call 0 ; end  (3 bytes at 101, row 0
; with no parameters). The root's call makes frame 1 of CALL_MAX = 4, f0 makes 2, 3 and 4, and
; the fifth call fetch (fuel 5) answers ERR_CALL with csp = CALL_MAX. The next request, a
; plain i32.const 42 ; end, answers 42 and csp is back to 0.
test cl_call_depth_overflow_traps {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    r = host_fn(0, 101, 0, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_END);
    assert k == 104;
    r = host_run_user(3, 101, 130, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 130;
    assert err == ERR_CALL;
    assert csp == CALL_MAX;
    assert fuel == 5;
    k = cl_put2(101, OP_I32_CONST, 0x2A);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 131, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 131;
    assert err == ERR_NONE;
    assert res == 42;
    assert csp == 0;
    assert frames - f0 == 2;
}

; Law (FR-002): ERR_FUNC. `call 7` names the row that is never loaded in this file and `call 8`
; is past FUNC_MAX; both answer ERR_FUNC on the call fetch (fuel 1). A function index that is a
; continuation byte (0x80, the start of a multi-byte LEB) is ERR_LEB: the cell takes one-byte
; function indexes. With row 0 loaded (i32.const 42 ; end at code[104..106]) `call 0` answers
; 42 in 4 fetches, so the three refusals are about the index and not about the program.
test cl_call_bad_index_traps {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    k = cl_put2(k, OP_CALL, 0x07);
    k = cl_put(k, OP_END);
    assert k == 104;
    assert fn_off[7] == NO_FUNC;
    r = host_run_user(3, 101, 140, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 140;
    assert err == ERR_FUNC;
    assert fuel == 1;
    code[102] = 0x08;
    r = host_run_user(3, 101, 141, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_FUNC;
    assert fuel == 1;
    code[102] = 0x80;
    r = host_run_user(3, 101, 142, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_LEB;
    assert fuel == 1;
    code[102] = 0x00;
    k = 104;
    k = cl_put2(k, OP_I32_CONST, 0x2A);
    k = cl_put(k, OP_END);
    r = host_fn(0, 104, 0, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(3, 101, 143, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 42;
    assert fuel == 4;
    assert frames - f0 == 4;
}

; Law (FR-001, FR-004): call_indirect pops the element index (the top of the stack), reads the
; function index from the element table and calls it. CI (cl_emit_ci) runs f0 = x + 10 and
; f1 = x - 1 (both type 1) through elements [1, 0, 1]: with x = 100, y = 0 picks f1 and
; answers 99, y = 1 picks f0 and answers 110, y = 2 picks f1 again. 8 fetches each (root 4,
; callee 4).
test cl_call_indirect_selects_by_element {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var s : u32 = 0;
    var len : u32 = 0;
    s = cl_setup_ci(1);
    len = cl_emit_ci(1);
    assert s == 0;
    assert len == 8;
    assert fn_off[0] == 109;
    assert fn_off[1] == 115;
    assert fn_ty[0] == 1;
    assert fn_ty[1] == 1;
    assert elem[0] == 1;
    assert elem[1] == 0;
    assert elem[2] == 1;
    r = host_run_user(len as u8, 101, 150, 100, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 150;
    assert err == ERR_NONE;
    assert res == 99;
    assert fuel == 8;
    assert csp == 0;
    r = host_run_user(len as u8, 101, 151, 100, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 110;
    assert fuel == 8;
    r = host_run_user(len as u8, 101, 152, 100, 2);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 99;
    assert fuel == 8;
    assert frames - f0 == 3;
}

; Law (FR-002): a null element, an element index past ELEM_MAX and an element that names an
; empty function row are refused. Elements [1, 0, 1, null]: y = 3 (null, 255), y = 4 (ELEM_MAX)
; and y = 0xFFFFFFFF answer ERR_TYPE on the call_indirect fetch (fuel 3); element 2 pointed at
; the never-loaded row 7 answers ERR_FUNC. Pointing element 3 at row 1 afterwards makes y = 3
; answer 99, so the null entry was the cause of the first refusal.
test cl_call_indirect_null_and_range_trap {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var s : u32 = 0;
    var len : u32 = 0;
    s = cl_setup_ci(1);
    len = cl_emit_ci(1);
    s = s + host_table(1, 3, 255);
    assert s == 0;
    assert elem[3] == NO_FUNC;
    r = host_run_user(len as u8, 101, 160, 100, 3);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 160;
    assert err == ERR_TYPE;
    assert fuel == 3;
    r = host_run_user(len as u8, 101, 161, 100, 4);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_TYPE;
    assert fuel == 3;
    r = host_run_user(len as u8, 101, 162, 100, 0xFFFFFFFF);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_TYPE;
    assert fuel == 3;
    s = host_table(1, 2, 7);
    assert elem[2] == 7;
    r = host_run_user(len as u8, 101, 163, 100, 2);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_FUNC;
    assert fuel == 3;
    s = host_table(1, 3, 1);
    assert elem[3] == 1;
    r = host_run_user(len as u8, 101, 164, 100, 3);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 99;
    assert fuel == 8;
    assert frames - f0 == 5;
}

; Law (FR-002): a callee whose type index differs from the call_indirect immediate is ERR_TYPE.
; Both rows are type 2 and CI says type 1: refused on the call_indirect fetch (fuel 3). The same
; run with the immediate patched to 2 (code[106]) answers 99, so only the type differed.
test cl_call_indirect_type_mismatch_traps {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var s : u32 = 0;
    var len : u32 = 0;
    s = cl_setup_ci(2);
    len = cl_emit_ci(1);
    assert s == 0;
    assert fn_ty[1] == 2;
    assert code[106] == 1;
    r = host_run_user(len as u8, 101, 170, 100, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 170;
    assert err == ERR_TYPE;
    assert fuel == 3;
    code[106] = 2;
    r = host_run_user(len as u8, 101, 171, 100, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 99;
    assert fuel == 8;
    assert frames - f0 == 2;
}

; Law (FR-002): the byte after the type immediate of call_indirect is the reserved table index
; and must be 0; any other value is ERR_LEB on the call_indirect fetch (fuel 3), before the
; element index is popped.
test cl_call_indirect_reserved_byte_must_be_zero {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var s : u32 = 0;
    var len : u32 = 0;
    s = cl_setup_ci(1);
    len = cl_emit_ci(1);
    assert s == 0;
    assert code[107] == 0;
    code[107] = 1;
    r = host_run_user(len as u8, 101, 175, 100, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 175;
    assert err == ERR_LEB;
    assert fuel == 3;
    code[107] = 0;
    r = host_run_user(len as u8, 101, 176, 100, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert res == 99;
    assert frames - f0 == 2;
}

; Law (FR-001, FR-004): globals persist across runs, and the run start does not reset them.
; GS (10 bytes): global.get 0 ; local.get 0 ; i32.add ; global.set 0 ; global.get 0 ; end.
; Global 0 is loaded with 100: x = 5 answers 105 and leaves 105 in global 0; the next run with
; x = 7 starts from 105 and answers 112. 6 fetches each. Global 1, loaded with 0xAABBCCDD, is
; read back whole by  global.get 1 ; end  (the wire carries its low 24 bits, 0xBBCCDD).
test cl_global_get_set_persists_across_runs {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var w : u32 = 0;
    var k : u32 = 101;
    r = host_table(2, 0, 100);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert glob[0] == 100;
    k = cl_put2(k, OP_GLOBAL_GET, 0x00);
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I32_ADD);
    k = cl_put2(k, OP_GLOBAL_SET, 0x00);
    k = cl_put2(k, OP_GLOBAL_GET, 0x00);
    k = cl_put(k, OP_END);
    assert k == 111;
    r = host_run_user(10, 101, 180, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 105;
    assert fuel == 6;
    assert glob[0] == 105;
    r = host_run_user(10, 101, 181, 7, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 112;
    assert fuel == 6;
    assert glob[0] == 112;
    r = host_table(2, 1, 0xAABBCCDD);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert glob[1] == 0xAABBCCDD;
    k = cl_put2(101, OP_GLOBAL_GET, 0x01);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 182, 0, 0);
    w = cf_word();
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 0xAABBCCDD;
    assert w == 0xBBCCDD;
    assert fuel == 2;
    assert frames - f0 == 3;
}

; Law (FR-002): ERR_GLOBAL. global.get 4 and global.set 4 (one past GLOBAL_MAX) and global.get
; 100 answer ERR_GLOBAL on the global fetch; global.get 3, the last global (loaded with 77),
; answers 77, so the refusals are about the index. 2 fetches for get, 2 for set (i32.const,
; global.set).
test cl_global_bad_index_traps {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var k : u32 = 101;
    r = host_table(2, 3, 77);
    assert r == 0;
    assert cap[0] == RESP_OK;
    k = cl_put2(k, OP_GLOBAL_GET, 0x04);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 190, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 190;
    assert err == ERR_GLOBAL;
    assert fuel == 1;
    k = cl_put2(101, OP_I32_CONST, 0x01);
    k = cl_put2(k, OP_GLOBAL_SET, 0x04);
    k = cl_put(k, OP_END);
    r = host_run_user(5, 101, 191, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_GLOBAL;
    assert fuel == 2;
    k = cl_put2(101, OP_GLOBAL_GET, 0x64);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 192, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_GLOBAL;
    assert fuel == 1;
    k = cl_put2(101, OP_GLOBAL_GET, 0x03);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 193, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert err == ERR_NONE;
    assert res == 77;
    assert fuel == 2;
    assert frames - f0 == 4;
}

; Law (FR-004): the three tables load over the wire. OP 0xFC LOAD_TABLES carries the kind in x
; byte 0 (0 function row, 1 element, 2 global), the slot in x byte 1 and the value in y; the
; cell answers RESP_OK with slot + 1 and the arrays hold the value. A row is the packed word
; off | np << 8 | nl << 16 | ty << 24; row 6 takes (33, 2, 1, 5) and then the extreme row
; (127, 2, 2, 0). Refused with RESP_BADOP and ERR_PROG, and touching nothing: function row 8
; (FUNC_MAX), body offset 128 (CODE_PAD), np + nl = 5 (more than the four locals of a frame),
; element 4 (ELEM_MAX), global 4 (GLOBAL_MAX) and an unknown kind 3. Row 7 is left empty.
test cl_load_tables_over_the_wire {
    var r : u32 = 0;
    var o5 : u32 = 0;
    var n5 : u32 = 0;
    o5 = fn_off[5] as u32;
    r = host_fn(6, 33, 2, 1, 5);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 0;
    assert cap[2] == 7;
    assert fn_off[6] == 33;
    assert fn_np[6] == 2;
    assert fn_nl[6] == 1;
    assert fn_ty[6] == 5;
    r = host_fn(6, 127, 2, 2, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[2] == 7;
    assert fn_off[6] == 127;
    assert fn_np[6] == 2;
    assert fn_nl[6] == 2;
    assert fn_ty[6] == 0;
    r = host_table(1, 3, 6);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[2] == 4;
    assert elem[3] == 6;
    r = host_table(2, 2, 0xDEADBEEF);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[2] == 3;
    assert glob[2] == 0xDEADBEEF;
    r = host_fn(8, 33, 2, 1, 5);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PROG;
    r = host_fn(5, 128, 0, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PROG;
    r = host_fn(5, 33, 3, 2, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PROG;
    r = host_table(1, 4, 1);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PROG;
    r = host_table(2, 4, 1);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PROG;
    r = host_table(3, 0, 1);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert err == ERR_PROG;
    n5 = fn_off[5] as u32;
    assert n5 == o5;
    assert fn_off[6] == 127;
    assert elem[3] == 6;
    assert glob[2] == 0xDEADBEEF;
    assert fn_off[7] == NO_FUNC;
}

; --- P7 i64 pairs (issue #12371): builders, oracles and the tests ---------------------------------
; Host side only (the cl_ precedent): none of these functions is called from step_all, so none
; reaches the Verilog. An i64 is two stack slots, the HIGH word deeper at st[sp - 2] and the LOW
; word on top at st[sp - 1]. The root end answers the LOW word and leaves sp and st alone, so after
; host_run_user returns, st[0] is the high word and st[1] the low word of a one-pair run (the P3
; contract: the answer of an i64 program is its low 32 bits). Every helper that checks a run
; returns 0 when all is as expected and a distinct code otherwise: no assert lives inside a
; function, and a test binds the code to a local before it asserts. Nothing here forms a u64
; beyond 32 bits (#12296): every expected value is a u32 word, the oracle works on 8-bit limbs
; whose column sums stay below 2^20, and a program never exceeds the 27 bytes of code[101..127].

; The SLEB128 encoder of an i64.const: the opcode, then the 7-bit groups of hi:lo from the low end,
; each group taken from the low 7 bits of a 64-bit pair that is shifted right 7 per round with the
; sign kept (sar on the high word). The last byte is the one after which the rest of the pair is
; all zeros with bit 6 of that byte clear, or all ones with bit 6 set; every earlier byte carries
; the continuation bit 0x80. At most ten rounds (a 64-bit value needs ten groups at most).
fn i64_put_const(at : u32, hi : u32, lo : u32) -> u32 {
    var k : u32 = cl_put(at, OP_I64_CONST);
    var h : u32 = hi;
    var l : u32 = lo;
    var b : u32 = 0;
    var n : u32 = 0;
    var last : u32 = 0;
    while (n < 10 && last == 0) {
        b = l & 0x7F;
        l = shr_u32(l, 7) | shl32(h, 25);
        h = sar32(h, 7);
        if (h == 0 && l == 0 && (b & 0x40) == 0) { last = 1; }
        if (h == 0xFFFFFFFF && l == 0xFFFFFFFF && (b & 0x40) != 0) { last = 1; }
        if (last == 0) { b = b | 0x80; }
        k = cl_put(k, b as u8);
        n = n + 1;
    }
    return k;
}

; n copies of byte b at code[at..]; returns the next position
fn i64_fill(at : u32, b : u8, n : u32) -> u32 {
    var k : u32 = at;
    var i : u32 = 0;
    while (i < n) {
        k = cl_put(k, b);
        i = i + 1;
    }
    return k;
}

; a run that ended with one i64 on the stack: RESP_OK, the echoed seq, no error, sp 2, st[0] the
; high word, st[1] the low word, res and the 24-bit answer word the low word, fu fetches
fn i64_chk(s : u8, hi : u32, lo : u32, fu : u32) -> u32 {
    var w : u32 = cf_word();
    if (cap[0] != RESP_OK) { return 1; }
    if (cap[1] != s) { return 2; }
    if (err != ERR_NONE) { return 3; }
    if (sp != 2) { return 4; }
    if (st[0] != hi) { return 5; }
    if (st[1] != lo) { return 6; }
    if (res != lo) { return 7; }
    if (w != (lo & 0xFFFFFF)) { return 8; }
    if (fuel != fu) { return 9; }
    return 0;
}

; a run that ended with exactly one i32 (or the low word of a wrapped i64) on the stack
fn i64_chk1(s : u8, v : u32, fu : u32) -> u32 {
    var w : u32 = cf_word();
    if (cap[0] != RESP_OK) { return 1; }
    if (cap[1] != s) { return 2; }
    if (err != ERR_NONE) { return 3; }
    if (sp != 1) { return 4; }
    if (st[0] != v) { return 5; }
    if (res != v) { return 7; }
    if (w != (v & 0xFFFFFF)) { return 8; }
    if (fuel != fu) { return 9; }
    return 0;
}

; a run that ended with an empty stack: the root end answers 0
fn i64_chk0(s : u8, fu : u32) -> u32 {
    var w : u32 = cf_word();
    if (cap[0] != RESP_OK) { return 1; }
    if (cap[1] != s) { return 2; }
    if (err != ERR_NONE) { return 3; }
    if (sp != 0) { return 4; }
    if (res != 0) { return 7; }
    if (w != 0) { return 8; }
    if (fuel != fu) { return 9; }
    return 0;
}

; a refused run: RESP_BADOP, the echoed seq, error e, fu fetches including the failing one
fn i64_chk_err(s : u8, e : u8, fu : u32) -> u32 {
    if (cap[0] != RESP_BADOP) { return 1; }
    if (cap[1] != s) { return 2; }
    if (err != e) { return 3; }
    if (fuel != fu) { return 9; }
    return 0;
}

; i64.const a ; i64.const b ; op ; end at code[101..]: at most 11 + 11 + 2 = 24 bytes, 4 fetches
; whatever the LEB lengths. Runs it and checks the pair (hi, lo) it leaves.
fn i64_bin(s : u8, op : u8, ahi : u32, alo : u32, bhi : u32, blo : u32, hi : u32, lo : u32) -> u32 {
    var k : u32 = i64_put_const(101, ahi, alo);
    var r : u32 = 0;
    k = i64_put_const(k, bhi, blo);
    k = cl_put(k, op);
    k = cl_put(k, OP_END);
    if (k > 128) { return 20; }
    r = host_run_user((k - 101) as u8, 101, s, 0, 0);
    if (r != 0) { return 21; }
    return i64_chk(s, hi, lo, 4);
}

; i64.const (hi, lo) ; end: the encoder must produce nbytes LEB bytes, and the cell must read the
; pair back (2 fetches)
fn i64_const_case(s : u8, hi : u32, lo : u32, nbytes : u32) -> u32 {
    var k : u32 = i64_put_const(101, hi, lo);
    var r : u32 = 0;
    if (k - 101 != nbytes + 1) { return 30; }
    k = cl_put(k, OP_END);
    r = host_run_user((k - 101) as u8, 101, s, 0, 0);
    if (r != 0) { return 31; }
    return i64_chk(s, hi, lo, 2);
}

; the 12-byte FixedMul chain of DOOM, written at code[at..]: local.get 0 ; i64.extend_i32_s ;
; local.get 1 ; i64.extend_i32_s ; i64.mul ; i64.const 16 ; i64.shr_s ; i32.wrap_i64 ; end.
; 9 fetches; it leaves one i32 slot, bits 16..47 of the signed 64-bit product.
fn i64_put_fixedmul(at : u32) -> u32 {
    var k : u32 = at;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I64_EXTEND_I32_S);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put(k, OP_I64_EXTEND_I32_S);
    k = cl_put(k, OP_I64_MUL);
    k = cl_put2(k, OP_I64_CONST, 0x10);
    k = cl_put(k, OP_I64_SHR_S);
    k = cl_put(k, OP_I32_WRAP_I64);
    k = cl_put(k, OP_END);
    return k;
}

fn i64_fm_case(s : u8, x : u32, y : u32, want : u32) -> u32 {
    var k : u32 = i64_put_fixedmul(101);
    var r : u32 = 0;
    r = host_run_user((k - 101) as u8, 101, s, x, y);
    if (r != 0) { return 40; }
    return i64_chk1(s, want, 9);
}

; how many bytes b of lo..hi the tick's P7 gate takes
fn p7_count(lo : u32, hi : u32) -> u32 {
    var b : u32 = lo;
    var n : u32 = 0;
    while (b <= hi) {
        if (is_p7_op(b as u8) == 1) { n = n + 1; }
        b = b + 1;
    }
    return n;
}

; the sum of the forward-scan classes of lo..hi
fn p7_scan_sum(lo : u32, hi : u32) -> u32 {
    var b : u32 = lo;
    var s : u32 = 0;
    var cl : u8 = 0;
    while (b <= hi) {
        cl = scan_class(b as u8);
        s = s + (cl as u32);
        b = b + 1;
    }
    return s;
}

; --- the 64-bit product oracle, on 8-bit limbs: never a u64, never the cell's own helpers -------
; Limb i (0..7) of the pair hi:lo is byte i of the 64-bit value, little-endian.
fn ref_limb(hi : u32, lo : u32, i : u32) -> u32 {
    if (i < 4) { return shr_u32(lo, 8 * i) & 255; }
    return shr_u32(hi, 8 * (i - 4)) & 255;
}

; column n of the schoolbook product: the sum of limb(a, i) * limb(b, n - i) for i = 0..n; at most
; 8 products of 255 * 255 = 65025, so the sum is below 520200
fn ref_col(ahi : u32, alo : u32, bhi : u32, blo : u32, n : u32) -> u32 {
    var s : u32 = 0;
    var i : u32 = 0;
    while (i <= n) {
        s = s + (ref_limb(ahi, alo, i) * ref_limb(bhi, blo, n - i));
        i = i + 1;
    }
    return s;
}

; byte n (0..7) of the low 64 bits of a * b: columns 0..n with the carry of each divided by 256
fn ref_mul64_byte(ahi : u32, alo : u32, bhi : u32, blo : u32, n : u32) -> u32 {
    var carry : u32 = 0;
    var t : u32 = 0;
    var m : u32 = 0;
    while (m <= n) {
        t = ref_col(ahi, alo, bhi, blo, m) + carry;
        carry = t / 256;
        m = m + 1;
    }
    return t % 256;
}

fn ref_mul64_lo(ahi : u32, alo : u32, bhi : u32, blo : u32) -> u32 {
    var b0 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 0);
    var b1 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 1);
    var b2 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 2);
    var b3 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

fn ref_mul64_hi(ahi : u32, alo : u32, bhi : u32, blo : u32) -> u32 {
    var b4 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 4);
    var b5 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 5);
    var b6 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 6);
    var b7 : u32 = ref_mul64_byte(ahi, alo, bhi, blo, 7);
    return b4 | (b5 << 8) | (b6 << 16) | (b7 << 24);
}

; the magnitude of an i32 (0x80000000 keeps its value: its magnitude is 2^31)
fn ref_mag(x : u32) -> u32 {
    var t : u32 = 0xFFFFFFFF - x;
    if (x >= 0x80000000) { return wrap32((t as u64) + 1); }
    return x;
}

; two-word negation of the pair hi:lo: the low word is ~lo + 1; the high word is ~hi, plus one
; exactly when the low word is zero (the +1 carried out of it)
fn ref_neg_lo(lo : u32) -> u32 {
    var t : u32 = 0xFFFFFFFF - lo;
    return wrap32((t as u64) + 1);
}

fn ref_neg_hi(hi : u32, lo : u32) -> u32 {
    var t : u32 = 0xFFFFFFFF - hi;
    if (lo == 0) { return wrap32((t as u64) + 1); }
    return t;
}

; DOOM's FixedMul from magnitudes: |a| * |b| as an unsigned 64-bit product, two-word negation
; when exactly one operand is negative, then bits 16..47 of the two's-complement result
fn ref_fixedmul(a : u32, b : u32) -> u32 {
    var ma : u32 = ref_mag(a);
    var mb : u32 = ref_mag(b);
    var neg : u32 = 0;
    var phi : u32 = ref_mul64_hi(0, ma, 0, mb);
    var plo : u32 = ref_mul64_lo(0, ma, 0, mb);
    var nhi : u32 = 0;
    var nlo : u32 = 0;
    if (a >= 0x80000000 && b < 0x80000000) { neg = 1; }
    if (a < 0x80000000 && b >= 0x80000000) { neg = 1; }
    if (neg == 1) {
        nhi = ref_neg_hi(phi, plo);
        nlo = ref_neg_lo(plo);
        phi = nhi;
        plo = nlo;
    }
    return (plo >> 16) | (phi << 16);
}

; the eight values of the product sweep: 0, 1, -1, 2^32 - 1, -2^63, 2^63 - 1, a mixed word pair,
; 2^31 + 1 -- zero, one, both signs, a full low word, and a carry out of the low word
fn sw64_hi(i : u32) -> u32 {
    if (i == 2) { return 0xFFFFFFFF; }
    if (i == 4) { return 0x80000000; }
    if (i == 5) { return 0x7FFFFFFF; }
    if (i == 6) { return 0x12345678; }
    return 0;
}

fn sw64_lo(i : u32) -> u32 {
    if (i == 1) { return 1; }
    if (i == 2) { return 0xFFFFFFFF; }
    if (i == 3) { return 0xFFFFFFFF; }
    if (i == 5) { return 0xFFFFFFFF; }
    if (i == 6) { return 0x9ABCDEF0; }
    if (i == 7) { return 0x80000001; }
    return 0;
}

; --- P7 tests ------------------------------------------------------------------------------------

; Law (FR-001): the nine new bytes have the WASM values, and the places that name them agree.
; p7_count counts is_p7_op (the gate the tick takes) over a window of bytes: 3 in [0x7C..0x7E],
; 3 in [0x86..0x88], 1 at 0xA7, 2 in [0xAC..0xAD], 9 over all 256 bytes, and 0 at 0x42 (i64.const
; has its own immediate decode, not this gate). scan_class (the forward scan of a skipped arm)
; gives i64.const class 1 and the nine others class 0; the bytes just outside the windows stay
; class 5 -- the scan is as strict as the fetch: 0x7B 5, 0x7F..0x85 is 7 x 5 = 35, 0x89 5, 0xA6 5,
; 0xA8..0xAB is 4 x 5 = 20, 0xAE 5.
test i64_opcode_consts {
    var n : u32 = 0;
    var s : u32 = 0;
    var c : u8 = 0;
    assert (OP_I64_CONST as u32) == 0x42;
    assert (OP_I32_WRAP_I64 as u32) == 0xA7;
    assert (OP_I64_EXTEND_I32_S as u32) == 0xAC;
    assert (OP_I64_EXTEND_I32_U as u32) == 0xAD;
    assert (OP_I64_ADD as u32) == 0x7C;
    assert (OP_I64_SUB as u32) == 0x7D;
    assert (OP_I64_MUL as u32) == 0x7E;
    assert (OP_I64_SHL as u32) == 0x86;
    assert (OP_I64_SHR_S as u32) == 0x87;
    assert (OP_I64_SHR_U as u32) == 0x88;
    n = p7_count(0x7C, 0x7E);
    assert n == 3;
    n = p7_count(0x86, 0x88);
    assert n == 3;
    n = p7_count(0xA7, 0xA7);
    assert n == 1;
    n = p7_count(0xAC, 0xAD);
    assert n == 2;
    n = p7_count(0, 255);
    assert n == 9;
    n = p7_count(0x42, 0x42);
    assert n == 0;
    c = scan_class(0x42);
    assert c == 1;
    s = p7_scan_sum(0x7C, 0x7E);
    assert s == 0;
    s = p7_scan_sum(0x86, 0x88);
    assert s == 0;
    s = p7_scan_sum(0xA7, 0xA7);
    assert s == 0;
    s = p7_scan_sum(0xAC, 0xAD);
    assert s == 0;
    s = p7_scan_sum(0x7B, 0x7B);
    assert s == 5;
    s = p7_scan_sum(0x7F, 0x85);
    assert s == 35;
    s = p7_scan_sum(0x89, 0x89);
    assert s == 5;
    s = p7_scan_sum(0xA6, 0xA6);
    assert s == 5;
    s = p7_scan_sum(0xA8, 0xAB);
    assert s == 20;
    s = p7_scan_sum(0xAE, 0xAE);
    assert s == 5;
}

; Law (FR-003): the test-side SLEB128 encoder is itself pinned to hand-written bytes before any
; run trusts it. (0, 16) is 42 10. All ones is 42 7F (the pair is -1: the first group is 0x7F with
; bit 6 set and the rest all ones). (0, 0x3ADE68B1) is 42 B1 D1 F9 D6 03: the groups from the low
; end are 0x31, 0x51, 0x79, 0x56, 0x03 (0x3ADE68B1 = 0x03 << 28 | 0x56 << 21 | 0x79 << 14 |
; 0x51 << 7 | 0x31), each but the last with the continuation bit: B1 D1 F9 D6 03. (1, 0) is 2^32:
; four zero groups and a fifth of 0x10, so 42 80 80 80 80 10. (0x40000000, 0) is 2^62: eight zero
; groups, then 0x40 (group 8, which needs a continuation because bit 6 is set but the value is
; positive) and 0x00: 42, eight 80, C0, 00 -- ten LEB bytes, 11 with the opcode.
test i64_const_encoder_matches_hand_bytes {
    var k : u32 = 0;
    k = i64_put_const(101, 0, 16);
    assert k == 103;
    assert code[101] == 0x42;
    assert code[102] == 0x10;
    k = i64_put_const(101, 0xFFFFFFFF, 0xFFFFFFFF);
    assert k == 103;
    assert code[101] == 0x42;
    assert code[102] == 0x7F;
    k = i64_put_const(101, 0, 0x3ADE68B1);
    assert k == 107;
    assert code[101] == 0x42;
    assert code[102] == 0xB1;
    assert code[103] == 0xD1;
    assert code[104] == 0xF9;
    assert code[105] == 0xD6;
    assert code[106] == 0x03;
    k = i64_put_const(101, 1, 0);
    assert k == 107;
    assert code[101] == 0x42;
    assert code[102] == 0x80;
    assert code[103] == 0x80;
    assert code[104] == 0x80;
    assert code[105] == 0x80;
    assert code[106] == 0x10;
    k = i64_put_const(101, 0x40000000, 0);
    assert k == 112;
    assert code[101] == 0x42;
    assert code[102] == 0x80;
    assert code[109] == 0x80;
    assert code[110] == 0xC0;
    assert code[111] == 0x00;
}

; Law (FR-003): i64.const pushes a pair, HIGH word deeper, from a one- or five-byte LEB; the
; bytes below are written by hand, not by the encoder. 42 10 0B: (0, 16) in 2 fetches (the
; const counts as one fetch however long its LEB, and the root end is the second). Dropping the
; LOW word leaves the high word: 42 10 1A 0B answers 0 with sp 1 (3 fetches), and 42 7F 1A 0B
; answers 0xFFFFFFFF with sp 1. 42 7F is -1 (all ones), 42 40 is -64 (hi 0xFFFFFFFF, lo
; 0xFFFFFFC0: the one-byte sign extension of 0x40), 42 3F is 63 (0, 0x3F). The five-byte
; B1 D1 F9 D6 03 is (0, 0x3ADE68B1): the answer word is its low 24 bits 0xDE68B1.
test i64_const_pair_small_and_minus_one {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var c : u32 = 0;
    var k : u32 = 101;
    k = cl_put2(k, OP_I64_CONST, 0x10);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 210, 0, 0);
    assert r == 0;
    c = i64_chk(210, 0, 16, 2);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x10);
    k = cl_put(k, OP_DROP);
    k = cl_put(k, OP_END);
    r = host_run_user(4, 101, 211, 0, 0);
    assert r == 0;
    c = i64_chk1(211, 0, 3);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x7F);
    k = cl_put(k, OP_DROP);
    k = cl_put(k, OP_END);
    r = host_run_user(4, 101, 212, 0, 0);
    assert r == 0;
    c = i64_chk1(212, 0xFFFFFFFF, 3);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x7F);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 213, 0, 0);
    assert r == 0;
    c = i64_chk(213, 0xFFFFFFFF, 0xFFFFFFFF, 2);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x40);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 214, 0, 0);
    assert r == 0;
    c = i64_chk(214, 0xFFFFFFFF, 0xFFFFFFC0, 2);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x3F);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 215, 0, 0);
    assert r == 0;
    c = i64_chk(215, 0, 0x3F, 2);
    assert c == 0;
    k = cl_put(101, OP_I64_CONST);
    k = cl_put2(k, 0xB1, 0xD1);
    k = cl_put2(k, 0xF9, 0xD6);
    k = cl_put2(k, 0x03, OP_END);
    assert k == 108;
    r = host_run_user(7, 101, 216, 0, 0);
    assert r == 0;
    c = i64_chk(216, 0, 0x3ADE68B1, 2);
    assert c == 0;
    assert cf_word() == 0xDE68B1;
    assert frames - f0 == 7;
}

; Law (FR-004): the wide LEB, spelled out. 42 80 80 80 80 10 is 2^32 = (1, 0): group 4 is 0x10,
; whose low four bits (0) go to the top of the low word and whose bits 4..6 (1) to the low bits
; of the high word. 42, eight 80, C0, 00 is 2^62 = (0x40000000, 0): group 8 is 0x40, and group 8
; lands at high-word bits 24..30. 42, nine FF, 7F is -1: groups 0..9 are all 0x7F and the last
; group's bit 0 is bit 63. 42, nine 80, 7F is -2^63 = (0x80000000, 0): only group 9 (0x7F) has a
; bit in the value, bit 63 of the pair. 42 and TEN FF bytes (the tenth still carrying the
; continuation bit) is an overlong LEB: ERR_LEB on the const, 1 fetch -- and the next program
; runs clean, the half-built immediate gone. The last program is i64.const 2^32 ; i32.const
; 0x3ADE68B1 ; end: the stack is [1, 0, 0x3ADE68B1], sp 3, 3 fetches -- an i32 beside an i64.
test i64_const_ten_byte_hand_bytes {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var c : u32 = 0;
    var k : u32 = 0;
    k = cl_put(101, OP_I64_CONST);
    k = i64_fill(k, 0x80, 4);
    k = cl_put2(k, 0x10, OP_END);
    assert k == 108;
    r = host_run_user(7, 101, 217, 0, 0);
    assert r == 0;
    c = i64_chk(217, 1, 0, 2);
    assert c == 0;
    k = cl_put(101, OP_I64_CONST);
    k = i64_fill(k, 0x80, 8);
    k = cl_put2(k, 0xC0, 0x00);
    k = cl_put(k, OP_END);
    assert k == 113;
    r = host_run_user(12, 101, 218, 0, 0);
    assert r == 0;
    c = i64_chk(218, 0x40000000, 0, 2);
    assert c == 0;
    k = cl_put(101, OP_I64_CONST);
    k = i64_fill(k, 0xFF, 9);
    k = cl_put2(k, 0x7F, OP_END);
    assert k == 113;
    r = host_run_user(12, 101, 219, 0, 0);
    assert r == 0;
    c = i64_chk(219, 0xFFFFFFFF, 0xFFFFFFFF, 2);
    assert c == 0;
    k = cl_put(101, OP_I64_CONST);
    k = i64_fill(k, 0x80, 9);
    k = cl_put2(k, 0x7F, OP_END);
    assert k == 113;
    r = host_run_user(12, 101, 220, 0, 0);
    assert r == 0;
    c = i64_chk(220, 0x80000000, 0, 2);
    assert c == 0;
    k = cl_put(101, OP_I64_CONST);
    k = i64_fill(k, 0xFF, 10);
    k = cl_put(k, OP_END);
    assert k == 113;
    r = host_run_user(12, 101, 221, 0, 0);
    assert r == 0;
    c = i64_chk_err(221, ERR_LEB, 1);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x10);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 222, 0, 0);
    assert r == 0;
    c = i64_chk(222, 0, 16, 2);
    assert c == 0;
    k = cl_put(101, OP_I64_CONST);
    k = i64_fill(k, 0x80, 4);
    k = cl_put(k, 0x10);
    k = cl_put2(k, OP_I32_CONST, 0xB1);
    k = cl_put2(k, 0xD1, 0xF9);
    k = cl_put2(k, 0xD6, 0x03);
    k = cl_put(k, OP_END);
    assert k == 114;
    r = host_run_user(13, 101, 223, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 223;
    assert err == ERR_NONE;
    assert sp == 3;
    assert st[0] == 1;
    assert st[1] == 0;
    assert st[2] == 0x3ADE68B1;
    assert res == 0x3ADE68B1;
    assert fuel == 3;
    assert frames - f0 == 7;
}

; Law (FR-004): every LEB length from 2 to 10 bytes, through the encoder (pinned to hand bytes
; above) and back through the cell, 2 fetches each. The length is the shortest SLEB128 of the
; value, n bytes covering [-2^(7n-1), 2^(7n-1)):
;   100 (0x64) 2 bytes (E4 00)           -100 (0xFFFFFF9C) 2 bytes (9C 7F)
;   0x2000 = 2^13 3 bytes                0x100000 = 2^20 4 bytes
;   0x3ADE68B1, 0xFFFFFFFF (FF FF FF FF 0F), 2^32 (hi 1), 2^31 (80 80 80 80 08) and
;   -2^31 (hi 0xFFFFFFFF, lo 0x80000000: 80 80 80 80 78) all 5 bytes
;   hi 0x100 = 2^40 6 bytes (80 x5 20)   hi 0xFFFF0000 = -2^48 7 bytes (80 x6 40)
;   hi 0x10000 = 2^48 8 bytes            hi 0x800000 = 2^55 9 bytes
;   hi 0x40000000 = 2^62, 2^63 - 1 (FF x9 00) and -2^63 (80 x9 7F) all 10 bytes
test i64_const_wide_leb_every_length {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_const_case(230, 0, 0x64, 2);
    assert c == 0;
    c = i64_const_case(231, 0xFFFFFFFF, 0xFFFFFF9C, 2);
    assert c == 0;
    c = i64_const_case(232, 0, 0x2000, 3);
    assert c == 0;
    c = i64_const_case(233, 0, 0x100000, 4);
    assert c == 0;
    c = i64_const_case(234, 0, 0x3ADE68B1, 5);
    assert c == 0;
    c = i64_const_case(235, 0, 0xFFFFFFFF, 5);
    assert c == 0;
    c = i64_const_case(236, 1, 0, 5);
    assert c == 0;
    c = i64_const_case(237, 0, 0x80000000, 5);
    assert c == 0;
    c = i64_const_case(238, 0xFFFFFFFF, 0x80000000, 5);
    assert c == 0;
    c = i64_const_case(239, 0x100, 0, 6);
    assert c == 0;
    c = i64_const_case(240, 0xFFFF0000, 0, 7);
    assert c == 0;
    c = i64_const_case(241, 0x10000, 0, 8);
    assert c == 0;
    c = i64_const_case(242, 0x800000, 0, 9);
    assert c == 0;
    c = i64_const_case(243, 0x40000000, 0, 10);
    assert c == 0;
    c = i64_const_case(244, 0x7FFFFFFF, 0xFFFFFFFF, 10);
    assert c == 0;
    c = i64_const_case(245, 0x80000000, 0, 10);
    assert c == 0;
    assert frames - f0 == 16;
}

; Law (FR-002): i64.extend_i32_s turns the i32 on top into a pair whose HIGH word is the sign
; (0xFFFFFFFF when bit 31 is set, else 0) and whose LOW word is the value. local.get 0 ;
; i64.extend_i32_s ; end is 3 fetches. x = 0x80000000 gives (0xFFFFFFFF, 0x80000000), x = 5 gives
; (0, 5), x = 0xFFFFFFFF gives (0xFFFFFFFF, 0xFFFFFFFF). With a drop before the end (4 fetches)
; the LOW word goes and the sign word is what is left: sp 1.
test i64_extend_s_pushes_sign_pair {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var c : u32 = 0;
    var k : u32 = 0;
    k = cl_put2(101, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I64_EXTEND_I32_S);
    k = cl_put(k, OP_END);
    r = host_run_user(4, 101, 16, 0x80000000, 0);
    assert r == 0;
    c = i64_chk(16, 0xFFFFFFFF, 0x80000000, 3);
    assert c == 0;
    r = host_run_user(4, 101, 17, 5, 0);
    assert r == 0;
    c = i64_chk(17, 0, 5, 3);
    assert c == 0;
    r = host_run_user(4, 101, 18, 0xFFFFFFFF, 0);
    assert r == 0;
    c = i64_chk(18, 0xFFFFFFFF, 0xFFFFFFFF, 3);
    assert c == 0;
    k = cl_put2(101, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I64_EXTEND_I32_S);
    k = cl_put(k, OP_DROP);
    k = cl_put(k, OP_END);
    r = host_run_user(5, 101, 19, 0x80000000, 0);
    assert r == 0;
    c = i64_chk1(19, 0xFFFFFFFF, 4);
    assert c == 0;
    r = host_run_user(5, 101, 20, 5, 0);
    assert r == 0;
    c = i64_chk1(20, 0, 4);
    assert c == 0;
    assert frames - f0 == 5;
}

; Law (FR-002): i64.extend_i32_u zero-extends: the HIGH word is always 0. x = 0x80000000 gives
; (0, 0x80000000), x = 5 gives (0, 5), x = 0xFFFFFFFF gives (0, 0xFFFFFFFF); with a drop
; the zero high word is what is left.
test i64_extend_u_pushes_zero_pair {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var c : u32 = 0;
    var k : u32 = 0;
    k = cl_put2(101, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I64_EXTEND_I32_U);
    k = cl_put(k, OP_END);
    r = host_run_user(4, 101, 32, 0x80000000, 0);
    assert r == 0;
    c = i64_chk(32, 0, 0x80000000, 3);
    assert c == 0;
    r = host_run_user(4, 101, 33, 5, 0);
    assert r == 0;
    c = i64_chk(33, 0, 5, 3);
    assert c == 0;
    r = host_run_user(4, 101, 34, 0xFFFFFFFF, 0);
    assert r == 0;
    c = i64_chk(34, 0, 0xFFFFFFFF, 3);
    assert c == 0;
    k = cl_put2(101, OP_LOCAL_GET, 0x00);
    k = cl_put(k, OP_I64_EXTEND_I32_U);
    k = cl_put(k, OP_DROP);
    k = cl_put(k, OP_END);
    r = host_run_user(5, 101, 35, 0xFFFFFFFF, 0);
    assert r == 0;
    c = i64_chk1(35, 0, 4);
    assert c == 0;
    assert frames - f0 == 4;
}

; Law (FR-002): i32.wrap_i64 drops the HIGH word and keeps the LOW one: 42 7F A7 0B (-1, wrapped)
; leaves one slot 0xFFFFFFFF, answer word 0xFFFFFF, 3 fetches. 42 B1 D1 F9 D6 03 A7 0B wraps
; (0, 0x3ADE68B1) to 0x3ADE68B1. 42 7F A7 1A 0B drops the wrapped slot and leaves nothing: sp 0,
; the root end answers 0, 4 fetches. One more drop (42 7F A7 1A 1A 0B) hits the empty stack:
; ERR_STACK on the fifth byte's fetch, 4 fetches counted.
test i64_wrap_drops_high_word {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var c : u32 = 0;
    var k : u32 = 0;
    k = cl_put2(101, OP_I64_CONST, 0x7F);
    k = cl_put(k, OP_I32_WRAP_I64);
    k = cl_put(k, OP_END);
    r = host_run_user(4, 101, 48, 0, 0);
    assert r == 0;
    c = i64_chk1(48, 0xFFFFFFFF, 3);
    assert c == 0;
    k = cl_put(101, OP_I64_CONST);
    k = cl_put2(k, 0xB1, 0xD1);
    k = cl_put2(k, 0xF9, 0xD6);
    k = cl_put2(k, 0x03, OP_I32_WRAP_I64);
    k = cl_put(k, OP_END);
    assert k == 109;
    r = host_run_user(8, 101, 49, 0, 0);
    assert r == 0;
    c = i64_chk1(49, 0x3ADE68B1, 3);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x7F);
    k = cl_put2(k, OP_I32_WRAP_I64, OP_DROP);
    k = cl_put(k, OP_END);
    r = host_run_user(5, 101, 50, 0, 0);
    assert r == 0;
    c = i64_chk0(50, 4);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x7F);
    k = cl_put2(k, OP_I32_WRAP_I64, OP_DROP);
    k = cl_put2(k, OP_DROP, OP_END);
    r = host_run_user(6, 101, 51, 0, 0);
    assert r == 0;
    c = i64_chk_err(51, ERR_STACK, 4);
    assert c == 0;
    assert frames - f0 == 4;
}

; Law (FR-002): i64.add adds the two pairs, the carry out of the low words going into the high
; word. Each program is i64.const a ; i64.const b ; i64.add ; end: 4 fetches.
;   (0, FFFFFFFF) + (0, 1): low 0x100000000 wraps to 0, carry 1, high 0 + 0 + 1 = (1, 0)
;   -1 + 1: low 0 with carry, high 0xFFFFFFFF + 0 + 1 wraps to 0 = (0, 0)
;   5 + 7 = (0, 0xC)
;   (1, 0x80000000) + (2, 0x80000000): low wraps to 0, carry 1, high 1 + 2 + 1 = (4, 0)
;   (0x7FFFFFFF, FFFFFFFF) + 1: low 0 carry 1, high 0x80000000 = (0x80000000, 0)
;   -1 + -1 = -2: low 0xFFFFFFFE with carry, high 0xFFFFFFFF + 0xFFFFFFFF + 1 = 0x1FFFFFFFF
;   wraps to (0xFFFFFFFF, 0xFFFFFFFE)
;   (3, 5) + (4, 6) = (7, 0xB)
;   (0, 0x7FFFFFFF) + (0, 0x80000000) = 0xFFFFFFFF: no carry, (0, 0xFFFFFFFF)
test i64_add_carries_across_words {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_bin(64, OP_I64_ADD, 0, 0xFFFFFFFF, 0, 1, 1, 0);
    assert c == 0;
    c = i64_bin(65, OP_I64_ADD, 0xFFFFFFFF, 0xFFFFFFFF, 0, 1, 0, 0);
    assert c == 0;
    c = i64_bin(66, OP_I64_ADD, 0, 5, 0, 7, 0, 0xC);
    assert c == 0;
    c = i64_bin(67, OP_I64_ADD, 1, 0x80000000, 2, 0x80000000, 4, 0);
    assert c == 0;
    c = i64_bin(68, OP_I64_ADD, 0x7FFFFFFF, 0xFFFFFFFF, 0, 1, 0x80000000, 0);
    assert c == 0;
    c = i64_bin(69, OP_I64_ADD, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE);
    assert c == 0;
    c = i64_bin(70, OP_I64_ADD, 3, 5, 4, 6, 7, 0xB);
    assert c == 0;
    c = i64_bin(71, OP_I64_ADD, 0, 0x7FFFFFFF, 0, 0x80000000, 0, 0xFFFFFFFF);
    assert c == 0;
    assert frames - f0 == 8;
}

; Law (FR-002): i64.sub subtracts b (the top pair) from a, a borrow out of the low words taking
; one from the high word. Each program is i64.const a ; i64.const b ; i64.sub ; end: 4 fetches.
;   0 - 1: low 0 - 1 wraps to 0xFFFFFFFF, borrow, high 0 - 0 - 1 = (0xFFFFFFFF, 0xFFFFFFFF)
;   (1, 0) - (0, 1): low 0xFFFFFFFF with borrow, high 1 - 0 - 1 = (0, 0xFFFFFFFF)
;   10 - 3 = (0, 7)
;   3 - 10 = -7: low 0xFFFFFFF9, borrow, high 0xFFFFFFFF = (0xFFFFFFFF, 0xFFFFFFF9)
;   (0x80000000, 0) - 1: low 0xFFFFFFFF, borrow, high 0x80000000 - 1 = (0x7FFFFFFF, 0xFFFFFFFF)
;   x - x = (0, 0) for x = (0x12345678, 0x9ABCDEF0)
;   (2, 7) - (1, 9): low 7 - 9 = 0xFFFFFFFE with borrow, high 2 - 1 - 1 = (0, 0xFFFFFFFE)
;   (9, 8) - (3, 5) = (6, 3)
test i64_sub_borrows_across_words {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_bin(80, OP_I64_SUB, 0, 0, 0, 1, 0xFFFFFFFF, 0xFFFFFFFF);
    assert c == 0;
    c = i64_bin(81, OP_I64_SUB, 1, 0, 0, 1, 0, 0xFFFFFFFF);
    assert c == 0;
    c = i64_bin(82, OP_I64_SUB, 0, 10, 0, 3, 0, 7);
    assert c == 0;
    c = i64_bin(83, OP_I64_SUB, 0, 3, 0, 10, 0xFFFFFFFF, 0xFFFFFFF9);
    assert c == 0;
    c = i64_bin(84, OP_I64_SUB, 0x80000000, 0, 0, 1, 0x7FFFFFFF, 0xFFFFFFFF);
    assert c == 0;
    c = i64_bin(85, OP_I64_SUB, 0x12345678, 0x9ABCDEF0, 0x12345678, 0x9ABCDEF0, 0, 0);
    assert c == 0;
    c = i64_bin(86, OP_I64_SUB, 2, 7, 1, 9, 0, 0xFFFFFFFE);
    assert c == 0;
    c = i64_bin(87, OP_I64_SUB, 9, 8, 3, 5, 6, 3);
    assert c == 0;
    assert frames - f0 == 8;
}

; Law (FR-002, FR-006): i64.mul keeps the low 64 bits of the product, a 64-clock shift-add
; microsequence (no `*` in the tick). Each program is i64.const a ; i64.const b ; i64.mul ;
; end: 4 fetches, the 64 steps are not fetches. Hand arithmetic (2^32 = 4294967296):
;   0x10000 * 0x10000 = 2^32 = (1, 0)
;   -1 * -1 = 1 = (0, 1)
;   (2^32 - 1)^2 = 2^64 - 2^33 + 1 = 0xFFFFFFFE00000001 mod 2^64 = (0xFFFFFFFE, 1)
;   3 * -7 = -21 = (0xFFFFFFFF, 0xFFFFFFEB)
;   x * 1 = x and x * 0 = 0 for x = (0x12345678, 0x9ABCDEF0)
;   (2^32 + 2) * (3 * 2^32 + 4) = 3 * 2^64 + 10 * 2^32 + 8 = (0xA, 8) mod 2^64
;   2^31 * 4 = 2^33 = (2, 0)
;   (2^32 - 1) * 0x10001 = 2^48 + 2^32 - 2^16 - 1 = 0x00010000FFFEFFFF = (0x10000, 0xFFFEFFFF)
;   -2 * 3 = -6 = (0xFFFFFFFF, 0xFFFFFFFA)
;   2^32 * 2^32 = 2^64 = (0, 0) mod 2^64
;   (2^32 + 2^32 - 1) * 2 = (2^33 - 1) * 2 = 2^34 - 2 = 0x3FFFFFFFE = (3, 0xFFFFFFFE)
;   3 * 2^63 = 2^64 + 2^63 = (0x80000000, 0) mod 2^64
test i64_mul_low_64_bits {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_bin(96, OP_I64_MUL, 0, 0x10000, 0, 0x10000, 1, 0);
    assert c == 0;
    c = i64_bin(97, OP_I64_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0, 1);
    assert c == 0;
    c = i64_bin(98, OP_I64_MUL, 0, 0xFFFFFFFF, 0, 0xFFFFFFFF, 0xFFFFFFFE, 1);
    assert c == 0;
    c = i64_bin(99, OP_I64_MUL, 0, 3, 0xFFFFFFFF, 0xFFFFFFF9, 0xFFFFFFFF, 0xFFFFFFEB);
    assert c == 0;
    c = i64_bin(100, OP_I64_MUL, 0x12345678, 0x9ABCDEF0, 0, 1, 0x12345678, 0x9ABCDEF0);
    assert c == 0;
    c = i64_bin(101, OP_I64_MUL, 0x12345678, 0x9ABCDEF0, 0, 0, 0, 0);
    assert c == 0;
    c = i64_bin(102, OP_I64_MUL, 1, 2, 3, 4, 0xA, 8);
    assert c == 0;
    c = i64_bin(103, OP_I64_MUL, 0, 0x80000000, 0, 4, 2, 0);
    assert c == 0;
    c = i64_bin(104, OP_I64_MUL, 0, 0xFFFFFFFF, 0, 0x10001, 0x10000, 0xFFFEFFFF);
    assert c == 0;
    c = i64_bin(105, OP_I64_MUL, 0xFFFFFFFF, 0xFFFFFFFE, 0, 3, 0xFFFFFFFF, 0xFFFFFFFA);
    assert c == 0;
    c = i64_bin(106, OP_I64_MUL, 1, 0, 1, 0, 0, 0);
    assert c == 0;
    c = i64_bin(107, OP_I64_MUL, 1, 0xFFFFFFFF, 0, 2, 3, 0xFFFFFFFE);
    assert c == 0;
    c = i64_bin(108, OP_I64_MUL, 0, 3, 0x80000000, 0, 0x80000000, 0);
    assert c == 0;
    assert frames - f0 == 13;
}

; Law (FR-002): i64.shl takes the count from the LOW word of the top pair, & 63; the count's
; high word is ignored. A count of 32 or more moves the low word up; a count of 0 or 64 (64 & 63
; = 0) leaves the pair. Each program is i64.const a ; i64.const count ; i64.shl ; end: 4 fetches.
;   (0, 1) << 32 = (1, 0)
;   (0, 0x80000000) << 1 = 2^32 = (1, 0)
;   (0x12345678, 0x9ABCDEF0) << 0 and << 64 are unchanged
;   count word (5, 4): the 5 is ignored; (0, 1) << 4 = (0, 0x10)
;   (1, 0xF0000000) << 4 = 0x1F0000000 << 4 = 0x1F00000000 = (0x1F, 0)
;   (0, 1) << 63 = (0x80000000, 0)
;   (0, 3) << 31 = 3 * 2^31 = 0x180000000 = (1, 0x80000000)
;   (0, 0x40000001) << 33: the low word moves up one: (0x80000002, 0)
test i64_shl_across_words {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_bin(112, OP_I64_SHL, 0, 1, 0, 32, 1, 0);
    assert c == 0;
    c = i64_bin(113, OP_I64_SHL, 0, 0x80000000, 0, 1, 1, 0);
    assert c == 0;
    c = i64_bin(114, OP_I64_SHL, 0x12345678, 0x9ABCDEF0, 0, 0, 0x12345678, 0x9ABCDEF0);
    assert c == 0;
    c = i64_bin(115, OP_I64_SHL, 0x12345678, 0x9ABCDEF0, 0, 64, 0x12345678, 0x9ABCDEF0);
    assert c == 0;
    c = i64_bin(116, OP_I64_SHL, 0, 1, 5, 4, 0, 0x10);
    assert c == 0;
    c = i64_bin(117, OP_I64_SHL, 1, 0xF0000000, 0, 4, 0x1F, 0);
    assert c == 0;
    c = i64_bin(118, OP_I64_SHL, 0, 1, 0, 63, 0x80000000, 0);
    assert c == 0;
    c = i64_bin(119, OP_I64_SHL, 0, 3, 0, 31, 1, 0x80000000);
    assert c == 0;
    c = i64_bin(120, OP_I64_SHL, 0, 0x40000001, 0, 33, 0x80000002, 0);
    assert c == 0;
    assert frames - f0 == 9;
}

; Law (FR-002): i64.shr_u shifts right, zeros filling in; a count of 32 or more moves the high
; word down and clears it. Each program is i64.const a ; i64.const count ; i64.shr_u ; end.
;   (1, 0) >> 32 = (0, 1)
;   (1, 0) >> 1 = 2^31 = (0, 0x80000000)
;   all ones >> 63 = 1 = (0, 1)
;   (0x12345678, 0x9ABCDEF0) >> 0 and >> 64 are unchanged
;   (0x80000000, 0) >> 4 = (0x08000000, 0)
;   (0x12345678, 0x9ABCDEF0) >> 8: high 0x00123456, low 0x9ABCDEF0 >> 8 = 0x009ABCDE with the
;   dropped high byte 0x78 entering at the top: (0x00123456, 0x789ABCDE)
;   the same >> 40 = high word >> 8: (0, 0x00123456)
test i64_shr_u_across_words {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_bin(128, OP_I64_SHR_U, 1, 0, 0, 32, 0, 1);
    assert c == 0;
    c = i64_bin(129, OP_I64_SHR_U, 1, 0, 0, 1, 0, 0x80000000);
    assert c == 0;
    c = i64_bin(130, OP_I64_SHR_U, 0xFFFFFFFF, 0xFFFFFFFF, 0, 63, 0, 1);
    assert c == 0;
    c = i64_bin(131, OP_I64_SHR_U, 0x12345678, 0x9ABCDEF0, 0, 0, 0x12345678, 0x9ABCDEF0);
    assert c == 0;
    c = i64_bin(132, OP_I64_SHR_U, 0x12345678, 0x9ABCDEF0, 0, 64, 0x12345678, 0x9ABCDEF0);
    assert c == 0;
    c = i64_bin(133, OP_I64_SHR_U, 0x80000000, 0, 0, 4, 0x08000000, 0);
    assert c == 0;
    c = i64_bin(134, OP_I64_SHR_U, 0x12345678, 0x9ABCDEF0, 0, 8, 0x00123456, 0x789ABCDE);
    assert c == 0;
    c = i64_bin(135, OP_I64_SHR_U, 0x12345678, 0x9ABCDEF0, 0, 40, 0, 0x00123456);
    assert c == 0;
    assert frames - f0 == 8;
}

; Law (FR-002): i64.shr_s shifts right with the sign filling in. Each program is i64.const a ;
; i64.const count ; i64.shr_s ; end.
;   -1 >> 63 = -1 = all ones
;   (0x80000000, 0) >> 32 = (0xFFFFFFFF, 0x80000000)
;   (0x80000000, 0) >> 1 = (0xC0000000, 0)
;   (0, 0x80000000) >> 4 = (0, 0x08000000): a non-negative pair, zeros fill in
;   (0x7FFFFFFF, 0) >> 32 = (0, 0x7FFFFFFF)
;   (0xF0000000, 0xF) >> 36: the high word is negative so the high result is 0xFFFFFFFF, the low
;   result is the high word >> 4 arithmetic = 0xFF000000
;   (0xC0000000, 1) >> 31: v = -(2^62 - 1), v / 2^31 floors to -2^31 = (0xFFFFFFFF, 0x80000000)
;   (0xF1234567, 0x89ABCDEF) >> 0 and >> 64 are unchanged
test i64_shr_s_across_words {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_bin(144, OP_I64_SHR_S, 0xFFFFFFFF, 0xFFFFFFFF, 0, 63, 0xFFFFFFFF, 0xFFFFFFFF);
    assert c == 0;
    c = i64_bin(145, OP_I64_SHR_S, 0x80000000, 0, 0, 32, 0xFFFFFFFF, 0x80000000);
    assert c == 0;
    c = i64_bin(146, OP_I64_SHR_S, 0x80000000, 0, 0, 1, 0xC0000000, 0);
    assert c == 0;
    c = i64_bin(147, OP_I64_SHR_S, 0, 0x80000000, 0, 4, 0, 0x08000000);
    assert c == 0;
    c = i64_bin(148, OP_I64_SHR_S, 0x7FFFFFFF, 0, 0, 32, 0, 0x7FFFFFFF);
    assert c == 0;
    c = i64_bin(149, OP_I64_SHR_S, 0xF0000000, 0xF, 0, 36, 0xFFFFFFFF, 0xFF000000);
    assert c == 0;
    c = i64_bin(150, OP_I64_SHR_S, 0xC0000000, 1, 0, 31, 0xFFFFFFFF, 0x80000000);
    assert c == 0;
    c = i64_bin(151, OP_I64_SHR_S, 0xF1234567, 0x89ABCDEF, 0, 0, 0xF1234567, 0x89ABCDEF);
    assert c == 0;
    c = i64_bin(152, OP_I64_SHR_S, 0xF1234567, 0x89ABCDEF, 0, 64, 0xF1234567, 0x89ABCDEF);
    assert c == 0;
    assert frames - f0 == 9;
}

; Law (FR-005): DOOM's FixedMul as one program, local.get 0 ; i64.extend_i32_s ; local.get 1 ;
; i64.extend_i32_s ; i64.mul ; i64.const 16 ; i64.shr_s ; i32.wrap_i64 ; end (12 bytes, 9
; fetches): bits 16..47 of the signed product, one i32 slot. Hand arithmetic, products as
; 64-bit two's complement:
;   0x10000 * 0x10000 = 2^32, >> 16 = 0x10000
;   0x20000 * 0x18000 = 2^17 * 3 * 2^15 = 3 * 2^32, >> 16 = 0x30000
;   0xFFFF0000 (-2^16) * 0x10000 = -2^32 = 0xFFFFFFFF00000000, >> 16 = 0xFFFF0000
;   (-2^16) * (-2^16) = 2^32, >> 16 = 0x10000
;   0 * 0x7FFFFFFF = 0
;   -1 * -1 = 1, >> 16 = 0
;   0x8000 * 0x8000 = 2^30, >> 16 = 0x4000
;   0x7FFF0000 * 0x20000 = 0x7FFF * 2^33 = 0xFFFE * 2^32, >> 16 = 0xFFFE0000
;   -2^31 * 2^16 = -2^47 = 0xFFFF800000000000, >> 16 = 0xFFFFFFFF80000000, wrapped 0x80000000
;   0x7FFFFFFF^2 = 2^62 - 2^32 + 1 = 0x3FFFFFFF00000001, >> 16 = 0x00003FFFFFFF0000, wrapped
;   0xFFFF0000
test i64_fixedmul_vectors {
    var f0 : u32 = frames;
    var c : u32 = 0;
    c = i64_fm_case(160, 0x10000, 0x10000, 0x10000);
    assert c == 0;
    c = i64_fm_case(161, 0x20000, 0x18000, 0x30000);
    assert c == 0;
    c = i64_fm_case(162, 0xFFFF0000, 0x10000, 0xFFFF0000);
    assert c == 0;
    c = i64_fm_case(163, 0xFFFF0000, 0xFFFF0000, 0x10000);
    assert c == 0;
    c = i64_fm_case(164, 0, 0x7FFFFFFF, 0);
    assert c == 0;
    c = i64_fm_case(165, 0xFFFFFFFF, 0xFFFFFFFF, 0);
    assert c == 0;
    c = i64_fm_case(166, 0x8000, 0x8000, 0x4000);
    assert c == 0;
    c = i64_fm_case(167, 0x7FFF0000, 0x20000, 0xFFFE0000);
    assert c == 0;
    c = i64_fm_case(168, 0x80000000, 0x10000, 0x80000000);
    assert c == 0;
    c = i64_fm_case(169, 0x7FFFFFFF, 0x7FFFFFFF, 0xFFFF0000);
    assert c == 0;
    assert frames - f0 == 10;
}

; Law (FR-005): the same FixedMul chain inside a called function. A callee's end copies only the
; top slot above its frame, so the callee's own wrap_i64 has already made the result one i32.
; Row 0 is loaded here (np 2, body at code[108]): root local.get 0 ; local.get 1 ; call 0 ; end
; (7 bytes at 101), the 12-byte chain at 108..119. 4 + 9 = 13 fetches. 0x10000 * 0x10000 answers
; 0x10000, 0xFFFF0000 * 0x10000 answers 0xFFFF0000 (the arithmetic of the vectors above); the
; frame is gone afterwards: csp 0, one slot on the stack.
test i64_fixedmul_inside_a_call {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var c : u32 = 0;
    var k : u32 = 101;
    r = host_fn(0, 108, 2, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    k = cl_put2(k, OP_LOCAL_GET, 0x00);
    k = cl_put2(k, OP_LOCAL_GET, 0x01);
    k = cl_put2(k, OP_CALL, 0x00);
    k = cl_put(k, OP_END);
    assert k == 108;
    k = i64_put_fixedmul(k);
    assert k == 120;
    r = host_run_user(7, 101, 176, 0x10000, 0x10000);
    assert r == 0;
    c = i64_chk1(176, 0x10000, 13);
    assert c == 0;
    assert csp == 0;
    r = host_run_user(7, 101, 177, 0xFFFF0000, 0x10000);
    assert r == 0;
    c = i64_chk1(177, 0xFFFF0000, 13);
    assert c == 0;
    assert csp == 0;
    assert frames - f0 == 2;
}

; Law (FR-007): the operand stack bounds hold for pairs, and nothing is left half-done. i64.add
; on an empty stack (7C 0B), i64.mul with one pair only (42 01 7E 0B), i32.wrap_i64 with one slot
; (41 01 A7 0B) and i64.extend_i32_s on an empty stack (AC 0B) are ERR_STACK on the op's fetch
; (1, 2, 2, 1 fetches). Eight pairs fill the 16-slot stack, so a ninth i64.const (nine 42 00
; and an end) is ERR_STACK on the ninth fetch, and an extend on the full stack (eight 42 00 and
; AC) is ERR_STACK on the ninth fetch. i64.shl with a pair and an i32 (42 01 41 02 86 0B, sp 3)
; is ERR_STACK on the third fetch. Then 42 10 0B still answers (0, 16).
test i64_pair_stack_underflow_and_overflow_trap {
    var f0 : u32 = frames;
    var r : u32 = 0;
    var c : u32 = 0;
    var k : u32 = 0;
    k = cl_put2(101, OP_I64_ADD, OP_END);
    r = host_run_user(2, 101, 192, 0, 0);
    assert r == 0;
    c = i64_chk_err(192, ERR_STACK, 1);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x01);
    k = cl_put2(k, OP_I64_MUL, OP_END);
    r = host_run_user(4, 101, 193, 0, 0);
    assert r == 0;
    c = i64_chk_err(193, ERR_STACK, 2);
    assert c == 0;
    k = cl_put2(101, OP_I32_CONST, 0x01);
    k = cl_put2(k, OP_I32_WRAP_I64, OP_END);
    r = host_run_user(4, 101, 194, 0, 0);
    assert r == 0;
    c = i64_chk_err(194, ERR_STACK, 2);
    assert c == 0;
    k = cl_put2(101, OP_I64_EXTEND_I32_S, OP_END);
    r = host_run_user(2, 101, 195, 0, 0);
    assert r == 0;
    c = i64_chk_err(195, ERR_STACK, 1);
    assert c == 0;
    k = 101;
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put(k, OP_END);
    assert k == 120;
    r = host_run_user(19, 101, 196, 0, 0);
    assert r == 0;
    c = i64_chk_err(196, ERR_STACK, 9);
    assert c == 0;
    k = 101;
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_CONST, 0x00);
    k = cl_put2(k, OP_I64_EXTEND_I32_S, OP_END);
    assert k == 119;
    r = host_run_user(18, 101, 197, 0, 0);
    assert r == 0;
    c = i64_chk_err(197, ERR_STACK, 9);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x01);
    k = cl_put2(k, OP_I32_CONST, 0x02);
    k = cl_put2(k, OP_I64_SHL, OP_END);
    r = host_run_user(6, 101, 198, 0, 0);
    assert r == 0;
    c = i64_chk_err(198, ERR_STACK, 3);
    assert c == 0;
    k = cl_put2(101, OP_I64_CONST, 0x10);
    k = cl_put(k, OP_END);
    r = host_run_user(3, 101, 199, 0, 0);
    assert r == 0;
    c = i64_chk(199, 0, 16, 2);
    assert c == 0;
    assert frames - f0 == 8;
}

; The product oracle is checked against literals before the sweep trusts it, so the sweep is not
; one formula compared with itself. ref_fixedmul rebuilds the ten vectors of
; i64_fixedmul_vectors from magnitudes and a two-word negation; the limb product gives
; (0xFFFFFFFF)^2 = (0xFFFFFFFE, 1) -- limb columns 65025, 130050, 195075, 260100, 195075,
; 130050, 65025 with carries give the bytes 01 00 00 00 FE FF FF FF -- and (1, 2) * (3, 4) =
; (10, 8) (columns 8 at limb 0 and 2 * 3 + 1 * 4 = 10 at limb 4).
test i64_oracle_limbs_agree_with_literals {
    var v : u32 = 0;
    v = ref_fixedmul(0x10000, 0x10000);
    assert v == 0x10000;
    v = ref_fixedmul(0x20000, 0x18000);
    assert v == 0x30000;
    v = ref_fixedmul(0xFFFF0000, 0x10000);
    assert v == 0xFFFF0000;
    v = ref_fixedmul(0xFFFF0000, 0xFFFF0000);
    assert v == 0x10000;
    v = ref_fixedmul(0, 0x7FFFFFFF);
    assert v == 0;
    v = ref_fixedmul(0xFFFFFFFF, 0xFFFFFFFF);
    assert v == 0;
    v = ref_fixedmul(0x8000, 0x8000);
    assert v == 0x4000;
    v = ref_fixedmul(0x7FFF0000, 0x20000);
    assert v == 0xFFFE0000;
    v = ref_fixedmul(0x80000000, 0x10000);
    assert v == 0x80000000;
    v = ref_fixedmul(0x7FFFFFFF, 0x7FFFFFFF);
    assert v == 0xFFFF0000;
    v = ref_mul64_hi(0, 0xFFFFFFFF, 0, 0xFFFFFFFF);
    assert v == 0xFFFFFFFE;
    v = ref_mul64_lo(0, 0xFFFFFFFF, 0, 0xFFFFFFFF);
    assert v == 1;
    v = ref_mul64_hi(1, 2, 3, 4);
    assert v == 10;
    v = ref_mul64_lo(1, 2, 3, 4);
    assert v == 8;
}

; Law (FR-006): i64.mul against the limb oracle over all 64 ordered pairs of eight values (see
; sw64_hi and sw64_lo: 0, 1, -1, 2^32 - 1, -2^63, 2^63 - 1, a mixed pair and 2^31 + 1). The
; expected pair of each run is the oracle's, built from 8-bit limbs and never from the cell's
; shift-add. 64 runs, 4 fetches each.
test i64_mul_sweep_agrees_with_the_limb_oracle {
    var f0 : u32 = frames;
    var i : u32 = 0;
    var j : u32 = 0;
    var n : u32 = 0;
    var bad : u32 = 0;
    var c : u32 = 0;
    var ahi : u32 = 0;
    var alo : u32 = 0;
    var bhi : u32 = 0;
    var blo : u32 = 0;
    var whi : u32 = 0;
    var wlo : u32 = 0;
    while (i < 8) {
        j = 0;
        while (j < 8) {
            ahi = sw64_hi(i);
            alo = sw64_lo(i);
            bhi = sw64_hi(j);
            blo = sw64_lo(j);
            whi = ref_mul64_hi(ahi, alo, bhi, blo);
            wlo = ref_mul64_lo(ahi, alo, bhi, blo);
            c = i64_bin((n & 255) as u8, OP_I64_MUL, ahi, alo, bhi, blo, whi, wlo);
            if (c != 0) { bad = bad + 1; }
            n = n + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    assert bad == 0;
    assert n == 64;
    assert frames - f0 == 64;
}

; --- P2 blocks: the loaded image -------------------------------------------------------------
; These stay last: a LOAD_PAGE frame overwrites code[0..127], where every built-in
; program lives, so after the first load the ROM suite is gone. Facts first, then
; four page fills, twenty-one runs (seqs 40..60), then the four P2 errors: a divide
; by zero and a six-byte LEB that need the image, plus a bad page and a run window
; past the store that do not. New tests go ABOVE this section: in the Verilog run every
; test block shares one code[], and the cf_ suite once sat below P4 and lost ID_ANSWER (#12010).
test p2_opcode_bytes {
    assert OP_DROP == 0x1A;
    assert OP_SELECT == 0x1B;
    assert OP_I32_LT_U == 0x49;
    assert OP_I32_GT_U == 0x4B;
    assert OP_I32_LE_U == 0x4D;
    assert OP_I32_GE_U == 0x4F;
    assert OP_I32_CLZ == 0x67;
    assert OP_I32_CTZ == 0x68;
    assert OP_I32_POPCNT == 0x69;
    assert OP_I32_DIV_S == 0x6D;
    assert OP_I32_DIV_U == 0x6E;
    assert OP_I32_REM_S == 0x6F;
    assert OP_I32_REM_U == 0x70;
    assert OP_I32_SHR_U == 0x76;
    assert OP_I32_ROTL == 0x77;
    assert OP_I32_ROTR == 0x78;
    assert OP_LOAD_PAGE == 0xFE;
    assert OP_RUN_USER == 0xFD;
    assert ERR_DIV == 4;
    assert ERR_LEB == 6;
    assert ERR_PROG == 7;
    assert CODE_PAGES == 4;
    assert P2_VECS == 29;
    assert uprog[UP_DIV_U + 4] == OP_I32_DIV_U;
    assert uprog[UP_REM_U + 4] == OP_I32_REM_U;
    assert uprog[UP_ROTL + 4] == OP_I32_ROTL;
    assert uprog[UP_ROTR + 4] == OP_I32_ROTR;
    assert uprog[UP_SHR_U + 4] == OP_I32_SHR_U;
    assert uprog[UP_POPCNT + 2] == OP_I32_POPCNT;
    assert uprog[UP_CLZ + 2] == OP_I32_CLZ;
    assert uprog[UP_CTZ + 2] == OP_I32_CTZ;
}

test p2_helpers {
    assert neg32(5) == 0xFFFFFFFB;
    assert neg32(0x80000000) == 0x80000000;
    assert abs32(0xFFFFFF9C) == 100;
    assert abs32(0x80000000) == 0x80000000;
    assert rotl32(0x12345678, 4) == 0x23456781;
    assert rotr32(0x12345678, 4) == 0x81234567;
    assert rotl32(0x12345678, 0) == 0x12345678;
    assert rotl32(0x12345678, 36) == rotl32(0x12345678, 4);
    assert shr_u32(0x12345678, 8) == 0x123456;
    assert clz32(0x12345678) == 3;
    assert clz32(0) == 32;
    assert ctz32(0x12345678) == 3;
    assert ctz32(0x10) == 4;
    assert ctz32(0) == 32;
    assert popcnt32(0x12345678) == 13;
    assert popcnt32(0xFFFFFFFF) == 32;
    assert popcnt32(0) == 0;
}

test p2_uprog_layout {
    assert uprog[UP_LEB3] == 0x41;
    assert uprog[UP_LEB3 + 1] == 0xE5;
    assert uprog[UP_LEB3 + 2] == 0x8E;
    assert uprog[UP_LEB3 + 3] == 0x26;
    assert uprog[UP_LEB3 + 7] == 0x0B;
    assert uprog[UP_DIV_U + 4] == 0x6E;
    assert uprog[UP_ROTL + 4] == 0x77;
    assert uprog[UP_SHR_U + 3] == 0x08;
    assert uprog[UP_LEB5 + 1] == 0xF8;
    assert uprog[UP_LEB5 + 5] == 0x01;
    assert uprog[UP_LEB6 + 5] == 0x80;
    assert uprog[UP_LEB2 + 1] == 0xC0;
    assert uprog[UP_END] == 0;
    assert (UP_END as u32) + 11 == CODE_PAD;
}

test p2_roundtrip_user {
    var l0 : u32 = loads;
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 0;
    assert cap[2] == 1;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_load(1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 1;
    assert cap[2] == 2;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_load(2);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 2;
    assert cap[2] == 3;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_load(3);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 3;
    assert cap[2] == 4;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert loads - l0 == 4;
    assert frames - f0 == 0;

    r = host_run_user(8, UP_LEB3, 40, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 40;
    assert cap[2] == 0x66;
    assert cap[3] == 0x87;
    assert cap[4] == 0x09;
    r = host_run_user(6, UP_DIV_U, 41, 100, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 41;
    assert cap[2] == 0x0E;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_REM_U, 42, 100, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 42;
    assert cap[2] == 0x02;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_DIV_S, 43, 0xFFFFFF9C, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 43;
    assert cap[2] == 0xF2;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_run_user(6, UP_REM_S, 44, 0xFFFFFF9C, 7);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 44;
    assert cap[2] == 0xFE;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_run_user(6, UP_ROTL, 45, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 45;
    assert cap[2] == 0x81;
    assert cap[3] == 0x67;
    assert cap[4] == 0x45;
    r = host_run_user(6, UP_ROTR, 46, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 46;
    assert cap[2] == 0x67;
    assert cap[3] == 0x45;
    assert cap[4] == 0x23;
    r = host_run_user(6, UP_SHR_U, 47, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 47;
    assert cap[2] == 0x56;
    assert cap[3] == 0x34;
    assert cap[4] == 0x12;
    r = host_run_user(4, UP_POPCNT, 48, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 48;
    assert cap[2] == 0x0D;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CLZ, 49, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 49;
    assert cap[2] == 0x03;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CTZ, 50, 0x12345678, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 50;
    assert cap[2] == 0x03;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_LT_U, 51, 0x80000000, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 51;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_GT_U, 52, 0x80000000, 1);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 52;
    assert cap[2] == 1;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_LE_U, 53, 1, 0x80000000);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 53;
    assert cap[2] == 1;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_GE_U, 54, 1, 0x80000000);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 54;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(10, UP_LEB5, 55, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 55;
    assert cap[2] == 0x79;
    assert cap[3] == 0x56;
    assert cap[4] == 0x34;
    r = host_run_user(7, UP_LEB2, 56, 1, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 56;
    assert cap[2] == 0xC1;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    r = host_run_user(6, UP_DIV_S, 57, 0x80000000, 0xFFFFFFFF);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 57;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(6, UP_REM_S, 58, 0x80000000, 0xFFFFFFFF);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 58;
    assert cap[2] == 0;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CLZ, 59, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 59;
    assert cap[2] == 0x20;
    assert cap[3] == 0;
    assert cap[4] == 0;
    r = host_run_user(4, UP_CTZ, 60, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 60;
    assert cap[2] == 0x20;
    assert cap[3] == 0;
    assert cap[4] == 0;
    assert frames - f0 == 21;
    assert drops == 0;
    assert err == 0;

    r = host_run_user(6, UP_DIV0, 61, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 61;
    assert err == ERR_DIV;
    r = host_run_user(8, UP_LEB6, 62, 5, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 62;
    assert err == ERR_LEB;
    assert frames - f0 == 23;
    assert loads - l0 == 4;
}

test p2_roundtrip_errors {
    var f0 : u32 = frames;
    var r : u32 = 0;
    r = host_load(4);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 4;
    assert err == ERR_PROG;
    r = host_run_user(16, 120, 63, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_BADOP;
    assert cap[1] == 63;
    assert err == ERR_PROG;
    assert frames - f0 == 0;
}

; P3 behavioral (the fleet's two programs, over the wire like p2_roundtrip, with
; save/restore of page 0 so every other test sees the default image):
;   42 B1 D1 F9 D6 03 0B  = i64.const 987654321; end   (the t27b emitter's exact bytes)
;   42 7B 0B              = i64.const -5; end
; the alias law first, as runtime facts
test p3_i64_wire_programs {
    assert OP_I64_CONST == 0x42;
    assert OP_I32_CONST == 0x41;
    var save : [12]u8 = undefined;
    var i : u32 = 0;
    while (i < 12) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_I64_CONST;
    uprog[1] = 0xB1;
    uprog[2] = 0xD1;
    uprog[3] = 0xF9;
    uprog[4] = 0xD6;
    uprog[5] = 0x03;
    uprog[6] = OP_END;
    uprog[7] = OP_I64_CONST;
    uprog[8] = 0x7B;
    uprog[9] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(7, 0, 64, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 64;
    assert cap[2] == 0xB1;
    assert cap[3] == 0x68;
    assert cap[4] == 0xDE;
    r = host_run_user(3, 7, 65, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 65;
    assert cap[2] == 0xFB;
    assert cap[3] == 0xFF;
    assert cap[4] == 0xFF;
    i = 0;
    while (i < 12) { uprog[i] = save[i]; i = i + 1; }
}

; P4 behavioral (the fleet's last named refusal, over the wire like p3, with
; save/restore of page 0 so every other test sees the default image):
;   43 00 00 20 40 0B                      = f32.const 2.5; end  (word 0x40200000)
;   44 00 00 00 00 00 00 04 40 0B          = f64.const 2.5; end  (low32 0x00000000)
;   44 18 2D 44 54 FB 21 09 40 0B          = f64.const pi; end  (0x400921FB54442D18,
;                                           low32 0x54442D18 -- a nonzero low half, so
;                                           the low-32 law is witnessed, not just a zero)
; the raw-bit law first, as runtime facts
test p4_f32_wire_programs {
    assert OP_F32_CONST == 0x43;
    assert OP_F64_CONST == 0x44;
    var save : [26]u8 = undefined;
    var i : u32 = 0;
    while (i < 26) { save[i] = uprog[i]; i = i + 1; }
    uprog[0] = OP_F32_CONST;
    uprog[1] = 0x00;
    uprog[2] = 0x00;
    uprog[3] = 0x20;
    uprog[4] = 0x40;
    uprog[5] = OP_END;
    uprog[6] = OP_F64_CONST;
    uprog[7] = 0x00;
    uprog[8] = 0x00;
    uprog[9] = 0x00;
    uprog[10] = 0x00;
    uprog[11] = 0x00;
    uprog[12] = 0x00;
    uprog[13] = 0x04;
    uprog[14] = 0x40;
    uprog[15] = OP_END;
    uprog[16] = OP_F64_CONST;
    uprog[17] = 0x18;
    uprog[18] = 0x2D;
    uprog[19] = 0x44;
    uprog[20] = 0x54;
    uprog[21] = 0xFB;
    uprog[22] = 0x21;
    uprog[23] = 0x09;
    uprog[24] = 0x40;
    uprog[25] = OP_END;
    var r : u32 = host_load(0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    r = host_run_user(6, 0, 66, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 66;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x20;
    r = host_run_user(10, 6, 67, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 67;
    assert cap[2] == 0x00;
    assert cap[3] == 0x00;
    assert cap[4] == 0x00;
    r = host_run_user(10, 16, 68, 0, 0);
    assert r == 0;
    assert cap[0] == RESP_OK;
    assert cap[1] == 68;
    assert cap[2] == 0x18;
    assert cap[3] == 0x2D;
    assert cap[4] == 0x44;
    i = 0;
    while (i < 26) { uprog[i] = save[i]; i = i + 1; }
}
