// SPDX-License-Identifier: Apache-2.0
module fpga_jtag_status;
; specs/fpga/jtag_status.t27 -- JTAG status word for board-level verification
; Provides a 64-bit status word readable via JTAG USER3 containing EthRx and EthReply
; counters for board-level verification and debugging.
;
; JTAG Interface (USER3 chain):
;   IR: 0x22 (USER3 instruction)
;   DR: 64-bit status word
;   Chain: 3 (USER3)
;
; Status Word Layout (64 bits):
;   [63:48]: EthRx frame counter (16 bits, MSB first)
;   [47:32]: EthRx error counter (16 bits)
;   [31:16]: EthReply frame counter (16 bits)
;   [15:0]:  Reserved for future use (16 bits)
;
; Interface:
;   jtag_capture: JTAG capture signal (from BSCANE2)
;   jtag_shift: JTAG shift signal (from BSCANE2)
;   jtag_tdi: JTAG data input (from BSCANE2)
;   jtag_tdo: JTAG data output (to BSCANE2)
;   eth_rx_ok: EthRx frame accepted
;   eth_rx_err: EthRx frame dropped
;   eth_reply_sent: EthReply frame sent
;
; Reference values computed independently:
;   JTAG USER3 IR value: 0x22 (34 decimal)
;   Shift register width: 64 bits
;   Counter width: 16 bits each (max 65535 frames)
;   Update timing: When jtag_capture=1, counters update on rising edge

; JTAG USER3 instruction
const USER3_IR : u8 = 34;  ; 0x22 in hex

; Status word bit positions and widths
const ETH_RX_OK_POS : u32 = 48;   ; EthRx frame counter starts at bit 48
const ETH_RX_ERR_POS : u32 = 32;  ; EthRx error counter starts at bit 32
const ETH_REPLY_SENT_POS : u32 = 16; ; EthReply frame counter starts at bit 16
const COUNTER_WIDTH : u32 = 16;   ; Each counter is 16 bits

; Counter limits
const MAX_COUNTER_VALUE : u32 = 65535;  ; 2^16 - 1

; JTAG state machine
enum JtagState {
    IDLE,
    CAPTURE,
    SHIFT,
    UPDATE,
    PAUSE
}

; JTAG status interface structure
pub struct JtagStatusOut {
    pub jtag_tdo : bool,
    pub status_word : u64,
    pub eth_rx_ok_count : u32,
    pub eth_rx_err_count : u32,
    pub eth_reply_sent_count : u32,
    pub jtag_busy : bool,
    pub jtag_error : bool
}

; JTAG status interface structure (inputs)
pub struct JtagStatusIn {
    pub jtag_capture : bool,
    pub jtag_shift : bool,
    pub jtag_tdi : bool,
    pub eth_rx_ok : bool,
    pub eth_rx_err : bool,
    pub eth_reply_sent : bool,
    pub jtag_reset : bool
}

; Create JTAG status output structure
pub fn create_jtag_status_out() -> JtagStatusOut {
    return {
        jtag_tdo: false,
        status_word: 0,
        eth_rx_ok_count: 0,
        eth_rx_err_count: 0,
        eth_reply_sent_count: 0,
        jtag_busy: false,
        jtag_error: false
    };
}

; Create JTAG status input structure
pub fn create_jtag_status_in() -> JtagStatusIn {
    return {
        jtag_capture: false,
        jtag_shift: false,
        jtag_tdi: false,
        eth_rx_ok: false,
        eth_rx_err: false,
        eth_reply_sent: false,
        jtag_reset: false
    };
}

; Build 64-bit status word from counters
fn build_status_word(rx_ok : u32, rx_err : u32, reply_sent : u32) -> u64 {
    var word : u64 = 0;
    
    ; EthRx frame counter (bits 63:48)
    word = word | ((rx_ok as u64) << ETH_RX_OK_POS);
    
    ; EthRx error counter (bits 47:32)
    word = word | ((rx_err as u64) << ETH_RX_ERR_POS);
    
    ; EthReply frame counter (bits 31:16)
    word = word | ((reply_sent as u64) << ETH_REPLY_SENT_POS);
    
    return word;
}

; Extract counter value from status word
fn get_counter_from_word(word : u64, pos : u32, width : u32) -> u32 {
    return ((word >> pos) & ((1 << width) - 1)) as u32;
}

; Update counters with new values
fn update_counters(rx_ok : u32, rx_err : u32, reply_sent : u32, 
                   current_rx_ok : u32, current_rx_err : u32, current_reply_sent : u32) -> (u32, u32, u32) {
    var new_rx_ok : u32 = current_rx_ok;
    var new_rx_err : u32 = current_rx_err;
    var new_reply_sent : u32 = current_reply_sent;
    
    ; Update EthRx frame counter
    if (rx_ok > current_rx_ok) {
        new_rx_ok = rx_ok;
    }
    
    ; Update EthRx error counter
    if (rx_err > current_rx_err) {
        new_rx_err = rx_err;
    }
    
    ; Update EthReply frame counter
    if (reply_sent > current_reply_sent) {
        new_reply_sent = reply_sent;
    }
    
    ; Check for counter overflow
    if (new_rx_ok > MAX_COUNTER_VALUE) {
        new_rx_ok = MAX_COUNTER_VALUE;
    }
    if (new_rx_err > MAX_COUNTER_VALUE) {
        new_rx_err = MAX_COUNTER_VALUE;
    }
    if (new_reply_sent > MAX_COUNTER_VALUE) {
        new_reply_sent = MAX_COUNTER_VALUE;
    }
    
    return (new_rx_ok, new_rx_err, new_reply_sent);
}

; Process JTAG shift operation
fn process_jtag_shift(shift_reg : u64, tdi : bool, bit_pos : u32) -> (u64, bool) {
    var new_shift_reg : u64 = shift_reg;
    var tdo_bit : bool = false;
    
    ; Shift in TDI bit, shift out TDO bit
    if (bit_pos < 64) {
        tdo_bit = ((shift_reg >> (63 - bit_pos)) & 1) == 1;
        new_shift_reg = (shift_reg << 1) | (if (tdi) { 1 } else { 0 });
    }
    
    return (new_shift_reg, tdo_bit);
}

; Main JTAG status processing function
pub fn on_clock(jtag_in : JtagStatusIn) -> JtagStatusOut {
    var jtag_out : JtagStatusOut = create_jtag_status_out();
    
    ; Handle reset
    if (jtag_in.jtag_reset) {
        jtag_out.eth_rx_ok_count = 0;
        jtag_out.eth_rx_err_count = 0;
        jtag_out.eth_reply_sent_count = 0;
        jtag_out.status_word = 0;
        return jtag_out;
    }
    
    ; Update counters based on input signals
    var (new_rx_ok, new_rx_err, new_reply_sent) = update_counters(
        if (jtag_in.eth_rx_ok) { jtag_out.eth_rx_ok_count + 1 } else { jtag_out.eth_rx_ok_count },
        if (jtag_in.eth_rx_err) { jtag_out.eth_rx_err_count + 1 } else { jtag_out.eth_rx_err_count },
        if (jtag_in.eth_reply_sent) { jtag_out.eth_reply_sent_count + 1 } else { jtag_out.eth_reply_sent_count },
        jtag_out.eth_rx_ok_count,
        jtag_out.eth_rx_err_count,
        jtag_out.eth_reply_sent_count
    );
    
    jtag_out.eth_rx_ok_count = new_rx_ok;
    jtag_out.eth_rx_err_count = new_rx_err;
    jtag_out.eth_reply_sent_count = new_reply_sent;
    
    ; Build status word
    jtag_out.status_word = build_status_word(jtag_out.eth_rx_ok_count, jtag_out.eth_rx_err_count, jtag_out.eth_reply_sent_count);
    
    ; Handle JTAG operations
    if (jtag_in.jtag_capture) {
        ; Capture state: load status word into shift register
        jtag_out.jtag_busy = true;
    } else if (jtag_in.jtag_shift) {
        ; Shift state: shift out bits one by one
        jtag_out.jtag_busy = true;
        jtag_out.jtag_tdo = ((jtag_out.status_word >> 63) & 1) == 1;
        
        ; Note: In a real implementation, this would be done over multiple cycles
        ; Here we simulate the first bit being shifted out
    } else {
        ; Idle state
        jtag_out.jtag_busy = false;
        jtag_out.jtag_tdo = false;
    }
    
    return jtag_out;
}

; High-level interface function for integration
pub fn update_jtag_status(eth_rx_ok : bool, eth_rx_err : bool, eth_reply_sent : bool, 
                         jtag_capture : bool, jtag_shift : bool, jtag_tdi : bool, 
                         jtag_reset : bool) -> JtagStatusOut {
    var jtag_in : JtagStatusIn = create_jtag_status_in();
    var jtag_out : JtagStatusOut;
    
    jtag_in.eth_rx_ok = eth_rx_ok;
    jtag_in.eth_rx_err = eth_rx_err;
    jtag_in.eth_reply_sent = eth_reply_sent;
    jtag_in.jtag_capture = jtag_capture;
    jtag_in.jtag_shift = jtag_shift;
    jtag_in.jtag_tdi = jtag_tdi;
    jtag_in.jtag_reset = jtag_reset;
    
    jtag_out = on_clock(jtag_in);
    
    return jtag_out;
}

; Test: Status word construction
test status_word_construction {
    var rx_ok : u32 = 100;
    var rx_err : u32 = 5;
    var reply_sent : u32 = 98;
    
    var word : u64 = build_status_word(rx_ok, rx_err, reply_sent);
    
    ; Verify EthRx frame counter (bits 63:48)
    assert get_counter_from_word(word, ETH_RX_OK_POS, COUNTER_WIDTH) == rx_ok;
    
    ; Verify EthRx error counter (bits 47:32)
    assert get_counter_from_word(word, ETH_RX_ERR_POS, COUNTER_WIDTH) == rx_err;
    
    ; Verify EthReply frame counter (bits 31:16)
    assert get_counter_from_word(word, ETH_REPLY_SENT_POS, COUNTER_WIDTH) == reply_sent;
}

; Test: Counter updates
test counter_updates {
    var jtag_in : JtagStatusIn = create_jtag_status_in();
    var jtag_out : JtagStatusOut;
    
    ; Initial state
    jtag_out = on_clock(jtag_in);
    assert jtag_out.eth_rx_ok_count == 0;
    assert jtag_out.eth_rx_err_count == 0;
    assert jtag_out.eth_reply_sent_count == 0;
    
    ; Update EthRx frame counter
    jtag_in.eth_rx_ok = true;
    jtag_out = on_clock(jtag_in);
    assert jtag_out.eth_rx_ok_count == 1;
    
    ; Update EthRx error counter
    jtag_in.eth_rx_ok = false;
    jtag_in.eth_rx_err = true;
    jtag_out = on_clock(jtag_in);
    assert jtag_out.eth_rx_err_count == 1;
    
    ; Update EthReply frame counter
    jtag_in.eth_rx_err = false;
    jtag_in.eth_reply_sent = true;
    jtag_out = on_clock(jtag_in);
    assert jtag_out.eth_reply_sent_count == 1;
}

; Test: JTAG capture operation
test jtag_capture {
    var jtag_in : JtagStatusIn = create_jtag_status_in();
    var jtag_out : JtagStatusOut;
    
    ; Set up some counter values
    jtag_in.eth_rx_ok = true;
    jtag_out = on_clock(jtag_in);
    jtag_in.eth_rx_ok = false;
    
    ; Simulate JTAG capture
    jtag_in.jtag_capture = true;
    jtag_out = on_clock(jtag_in);
    
    assert jtag_out.jtag_busy == true;
    assert jtag_out.status_word != 0;
}

; Test: JTAG shift operation
test jtag_shift {
    var jtag_in : JtagStatusIn = create_jtag_status_in();
    var jtag_out : JtagStatusOut;
    
    ; Set up status word
    jtag_in.eth_rx_ok = true;
    jtag_out = on_clock(jtag_in);
    
    ; Simulate JTAG shift
    jtag_in.jtag_capture = false;
    jtag_in.jtag_shift = true;
    jtag_in.jtag_tdi = false;
    jtag_out = on_clock(jtag_in);
    
    assert jtag_out.jtag_busy == true;
    ; TDO should be MSB of status word
    assert jtag_out.jtag_tdo == ((jtag_out.status_word >> 63) & 1) == 1;
}

; Test: Counter overflow protection
test counter_overflow {
    var jtag_in : JtagStatusIn = create_jtag_status_in();
    var jtag_out : JtagStatusOut;
    
    ; Set counter to maximum value
    jtag_out.eth_rx_ok_count = MAX_COUNTER_VALUE;
    jtag_in.eth_rx_ok = true;
    jtag_out = on_clock(jtag_in);
    
    ; Counter should not overflow
    assert jtag_out.eth_rx_ok_count == MAX_COUNTER_VALUE;
}

; Test: Reset functionality
test jtag_reset {
    var jtag_in : JtagStatusIn = create_jtag_status_in();
    var jtag_out : JtagStatusOut;
    
    ; Set up some counter values
    jtag_in.eth_rx_ok = true;
    jtag_in.eth_rx_err = true;
    jtag_in.eth_reply_sent = true;
    jtag_out = on_clock(jtag_in);
    
    ; Reset all counters
    jtag_in.eth_rx_ok = false;
    jtag_in.eth_rx_err = false;
    jtag_in.eth_reply_sent = false;
    jtag_in.jtag_reset = true;
    jtag_out = on_clock(jtag_in);
    
    assert jtag_out.eth_rx_ok_count == 0;
    assert jtag_out.eth_rx_err_count == 0;
    assert jtag_out.eth_reply_sent_count == 0;
    assert jtag_out.status_word == 0;
}

; Test: Status word format consistency
test status_word_format {
    var word : u64 = build_status_word(0x1234, 0x5678, 0x9ABC);
    
    ; Verify all counters are in correct positions
    assert get_counter_from_word(word, ETH_RX_OK_POS, COUNTER_WIDTH) == 0x1234;
    assert get_counter_from_word(word, ETH_RX_ERR_POS, COUNTER_WIDTH) == 0x5678;
    assert get_counter_from_word(word, ETH_REPLY_SENT_POS, COUNTER_WIDTH) == 0x9ABC;
    
    ; Verify no overlap between counters
    assert get_counter_from_word(word, ETH_RX_OK_POS, COUNTER_WIDTH) != get_counter_from_word(word, ETH_RX_ERR_POS, COUNTER_WIDTH);
    assert get_counter_from_word(word, ETH_RX_ERR_POS, COUNTER_WIDTH) != get_counter_from_word(word, ETH_REPLY_SENT_POS, COUNTER_WIDTH);
}

invariant status_word_width {
    ; Status word should be exactly 64 bits
    var word : u64 = build_status_word(0, 0, 0);
    assert word < (1 << 64);
    assert word >= 0;
}

invariant counter_bounds {
    ; All counters should be within valid range
    var jtag_out : JtagStatusOut = create_jtag_status_out();
    assert jtag_out.eth_rx_ok_count <= MAX_COUNTER_VALUE;
    assert jtag_out.eth_rx_err_count <= MAX_COUNTER_VALUE;
    assert jtag_out.eth_reply_sent_count <= MAX_COUNTER_VALUE;
}

invariant jtag_ir_value {
    ; USER3 IR value should be correct
    assert USER3_IR == 34;  ; 0x22
}