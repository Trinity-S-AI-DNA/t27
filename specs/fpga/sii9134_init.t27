// SPDX-License-Identifier: Apache-2.0
; specs/fpga/sii9134_init.t27 -- the SiI9134 HDMI transmitter init table and the sequencer that writes it (#11026).
; Source of the table: the feasibility note docs/fpga/T27OS_ON_FPGA_FEASIBILITY.md section 5b, item 2, which read
; ALINX's demo 11_1_hdmi_out (lut_hdmi.v) as a fact source on 2026-10-19: six entries (8-bit write address, register,
; value): 72:08=35, 7A:2F=00, 60:05=10, 60:08=05, 60:09=01, 60:05=04. The 0x72 write address is the SiI9134 (7-bit
; 0x39); 0x7A and 0x60 are two more devices the demo writes. NOT established: whether these six writes are right for
; 640x480 at 25 MHz (the demo runs 1920x1080); the register meanings are in the chip reference. Unproven on silicon.
; The sequencer waits for the caller to release the transmitter reset (hdmi_nreset high), then runs the table through
; the I2C master in table order. A NACK stops the run and reports the index of the table entry that failed.
; No pin numbers here. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaSii9134Init;

use fpga::i2c_master::I2cM;
use fpga::i2c_master::I2cMon;
use fpga::i2c_master::i2c_begin;
use fpga::i2c_master::i2c_tick;
use fpga::i2c_master::i2c_slave;
use fpga::i2c_master::i2c_bus;
use fpga::i2c_master::i2c_mon_new;
use fpga::i2c_master::i2c_mon_step;

pub const SII_ENTRIES : u32 = 6;

/// Write address of entry i (8-bit form, the R/W bit is 0).
pub fn sii_addr(i: u32) -> u32 {
    if (i == 0) { return 114; }
    if (i == 1) { return 122; }
    return 96;
}

/// Register of entry i.
pub fn sii_reg(i: u32) -> u32 {
    if (i == 0) { return 8; }
    if (i == 1) { return 47; }
    if (i == 2) { return 5; }
    if (i == 3) { return 8; }
    if (i == 4) { return 9; }
    return 5;
}

/// Value of entry i.
pub fn sii_val(i: u32) -> u32 {
    if (i == 0) { return 53; }
    if (i == 1) { return 0; }
    if (i == 2) { return 16; }
    if (i == 3) { return 5; }
    if (i == 4) { return 1; }
    return 4;
}

/// Entry i packed as address, register, value (24 bits), the shape the bus monitor rebuilds.
pub fn sii_packed(i: u32) -> u32 {
    return (sii_addr(i) << 16) | (sii_reg(i) << 8) | sii_val(i);
}

pub struct SiiInit {
    i: u32,
    started: u32,
    done: u32,
    err: u32,
    err_entry: u32,
    writes: u32,
    m: I2cM,
}

pub fn sii_new() -> SiiInit {
    return SiiInit{ .i = 0, .started = 0, .done = 0, .err = 0, .err_entry = 0, .writes = 0, .m = i2c_begin(0, 0, 0) };
}

/// One quarter-tick of the sequencer. nreset_up is 1 once the transmitter reset has been released. Returns 1 when
/// the run is over (all entries written, or a NACK).
pub fn sii_tick(s: *SiiInit, nreset_up: u32, sda_in: u32) -> u32 {
    if (s.done == 1) { return 1; }
    if (nreset_up == 0) { return 0; }
    if (s.started == 0) {
        s.m = i2c_begin(sii_addr(s.i), sii_reg(s.i), sii_val(s.i));
        s.started = 1;
        return 0;
    }
    var mm : I2cM = s.m;
    let fin : u32 = i2c_tick(&mm, sda_in);
    s.m = mm;
    if (fin == 1) {
        if (mm.err == 1) {
            s.err = 1;
            s.err_entry = s.i;
            s.done = 1;
            return 1;
        }
        s.writes = s.writes + 1;
        s.i = s.i + 1;
        s.started = 0;
        if (s.i >= SII_ENTRIES) {
            s.done = 1;
            return 1;
        }
    }
    return 0;
}

test "the_table_holds_the_six_entries_in_demo_order" {
    assert sii_packed(0) == 0x720835;
    assert sii_packed(1) == 0x7A2F00;
    assert sii_packed(2) == 0x600510;
    assert sii_packed(3) == 0x600805;
    assert sii_packed(4) == 0x600901;
    assert sii_packed(5) == 0x600504;
}

test "the_sequencer_emits_every_write_in_table_order" {
    var s : SiiInit = sii_new();
    var mon : I2cMon = i2c_mon_new();
    var ticks : u32 = 0;
    var next : u32 = 0;
    var ok : bool = true;
    var seen : u32 = 0;
    while (s.done == 0 and ticks < 2000) {
        var mm : I2cM = s.m;
        let sl : u32 = i2c_slave(&mm, 99);
        let bus : u32 = i2c_bus(&mm, sl);
        let d : u32 = sii_tick(&s, 1, bus);
        var m2 : I2cM = s.m;
        let b2 : u32 = i2c_bus(&m2, sl);
        let before : u32 = mon.stops;
        let skip : u32 = i2c_mon_step(&mon, m2.scl, b2);
        if (mon.stops > before) {
            if (mon.last3 != sii_packed(seen)) { ok = false; }
            seen = seen + 1;
        }
        ticks = ticks + 1;
    }
    assert ok;
    assert seen == 6;
    assert s.writes == 6;
    assert s.err == 0;
    assert s.done == 1;
}

test "a_nack_on_entry_two_stops_the_run_and_names_it" {
    var s : SiiInit = sii_new();
    var ticks : u32 = 0;
    while (s.done == 0 and ticks < 2000) {
        var mm : I2cM = s.m;
        var sl : u32 = i2c_slave(&mm, 99);
        if (s.i == 2) { sl = i2c_slave(&mm, 1); }
        let bus : u32 = i2c_bus(&mm, sl);
        let d : u32 = sii_tick(&s, 1, bus);
        ticks = ticks + 1;
    }
    assert s.err == 1;
    assert s.err_entry == 2;
    assert s.writes == 2;
}

test "nothing_is_written_while_the_transmitter_is_in_reset" {
    var s : SiiInit = sii_new();
    var ticks : u32 = 0;
    while (ticks < 300) {
        let d : u32 = sii_tick(&s, 0, 1);
        ticks = ticks + 1;
    }
    assert s.started == 0;
    assert s.writes == 0;
    assert s.done == 0;
}
