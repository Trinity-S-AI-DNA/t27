// SPDX-License-Identifier: Apache-2.0
; specs/fpga/ddr3_ternary_matvec.t27 -- a ternary mat-vec on the AX7203 over real weights held in its DDR3
; Cell 26 of specs/igla/own_model.t27 ("Full model on FPGA, DDR3"), epic gHashTag/t27#10024, issue
; gHashTag/t27#10461. specs/fpga/ddr3_head_bandwidth.t27 measured the read path (#10248); this file is the
; compute step on top of it: weights in DDR3, a product computed from them, a receipt that can be checked.
; -
; THE WEIGHTS. blocks.0.attn.k.weight of tern-tc-9m: 64 rows of 320 trits, one int8 in {-1, 0, +1} each,
; 20,480 bytes at offset 10,589,476 of c_infer/model.bin (Hugging Face playra/tern-tc-9m, 16,953,800 bytes,
; sha256 3102abdf35057924e077a86db4fdac726e4fe1f6574df47f39a638ba99a3ce9c). Its head (wte) is tied and f32,
; not ternary, so the first ternary projection of the same checkpoint is the tensor used. The bytes, as
; 2,560 little-endian u64 words, and the tests that compute S_EXPECT and Y_EXPECT from them, are
; specs/fpga/tern9m_l0_k_weights.t27. The per-tensor scale (0.07064503) is not applied: y is the integer
; product, as a ternary layer computes it before its one multiply.
; -
; THE RUN. Wait for the core's init_done. Receive the 20,480 bytes on the UART (115200 baud, 8N1, P20), pack
; them low byte first into 640 beats of 32 bytes (row r is beats 10r .. 10r+9) and write beat i to address i
; of the native port. The write checksum S folds each beat as it is packed. Then read the 640 beats back
; from DDR3, one at a time: fold each into the read checksum C, and step through its 32 trits one per clock,
; y_r = sum over c of w_rc * x_c in wrapping 32-bit arithmetic, where x_c is the int8 (37 c + 11) mod 256
; read as two's complement (XV0, XSTEP). At the end of each row y_r is folded into Y. A byte that is not
; 00, 01 or FF counts in E (and adds 0); a UART frame whose stop bit is low counts in F.
; PASS is: 640 beats, S = S_EXPECT, C = S, Y = Y_EXPECT, E = 0 and F = 0. Anything else is FAIL.
; -
; THE RECEIPT. 115200 baud on N15, one line, sent again and again once the run is over:
;   T27 TERN N=<16 hex> S=<16 hex> C=<16 hex> Y=<16 hex> E=<16 hex> F=<16 hex> L=<16 hex> PASS
; N beats computed, S write checksum, C read checksum, Y output checksum, E bad trits, F bad frames, L the
; line's number. Until the run is over the UART is the core's BIOS, which prints its calibration; the
; core's own RX is tied idle, so the upload reaches only this design.
; LEDs (active low): B13 init_done, C13 init_error, D14 PASS, D15 a heartbeat of the 100 MHz clock.
; The button T6 (active low) resets the core and so starts the run again.
; -
; THE HOST. Plain commands only: `stty -f <port> 115200 cs8 -cstopb -parenb raw`, then `dd if=model.bin
; bs=20480 skip=10589476 count=1 iflag=skip_bytes` (or `bs=1 skip=10589476 count=20480`) into the port, and
; `cat` of the port for the receipt.
; -
; WHAT A PASS SAYS. These 20,480 bytes of a published checkpoint went into this board's DDR3, came back out
; unchanged, and the board's own ternary datapath computed from them the same 64 outputs the spec's test
; computes, checksum for checksum. WHAT IT DOES NOT SAY. Nothing about the full model: one projection of one
; layer, an input vector that is a fixed pattern and not an activation, no scale, no attention, no rate.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaDdr3TernaryMatvec;

use fpga::board_receipt;

pub const KIND : str = "board-cell";
pub const ID : str = "fpga/ddr3_ternary_matvec";
pub const EPIC : str = "gHashTag/t27#10024";
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";

; --- the run ------------------------------------------------------------------------------------
pub const W_FILE_SHA256 : str = "3102abdf35057924e077a86db4fdac726e4fe1f6574df47f39a638ba99a3ce9c";
pub const W_TENSOR : str = "blocks.0.attn.k.weight";
pub const W_OFFSET : u64 = 10589476;
pub const W_BYTES : u64 = 20480;
pub const W_ROWS : u32 = 64;
pub const W_COLS : u32 = 320;
pub const BEAT_BYTES : u64 = 32;
pub const W_BEATS : u32 = 640;
pub const BEATS_PER_ROW : u32 = 10;
/// x_c = (XSTEP * c + XV0) mod 256, read as an int8.
pub const XV0 : u8 = 11;
pub const XSTEP : u8 = 37;
/// What the board must report. Both were read off the failing assert_eq of specs/fpga/tern9m_l0_k_weights.t27
/// run with 0 here (t27c test-report on the Railway lab, 2026-10-18), and that spec's tests now hold them: S is
/// s_of over the pinned bytes, Y is y_of over them. The receipt prints them as S=4B58160720ABB863 and
/// Y=9A50D884522C233D.
pub const S_EXPECT : u64 = 0x4B58160720ABB863;
pub const Y_EXPECT : u64 = 0x9A50D884522C233D;

pub const V_PASS : u8 = 0;
pub const V_FAIL : u8 = 3;

pub const ST_WAIT : u8 = 0;
pub const ST_LOAD : u8 = 1;
pub const ST_READ : u8 = 2;
pub const ST_JUDGE : u8 = 3;
pub const ST_REPORT : u8 = 4;

pub const BAUD_DIV : u16 = 868;
pub const LINE_SEGS : u8 = 9;

; --- the arithmetic -----------------------------------------------------------------------------
; fold_beat (the beat checksum, the one specs/fpga/ddr3_head_bandwidth.t27 prints), hex_digit and pass_fail_char
; come from specs/fpga/board_receipt.t27, which every AX7203 board spec uses.

/// An int8, held as its u8 bits, sign-extended to 32 bits.
pub fn sext8(v: u8) -> u32 {
    if (v >= 128) { return (v as u32) | 0xFFFFFF00; }
    return v as u32;
}

/// What a weight byte adds to a row sum, for the input x held as the u8 bits xv: +x for 01, -x for FF, 0 for
/// 00 and for any byte that is not a trit.
pub fn trit_term(b: u8, xv: u8) -> u32 {
    if (b == 1) { return sext8(xv); }
    if (b == 255) { return (0xFFFFFFFF - sext8(xv)) +% 1; }
    return 0;
}

/// Is the byte one of the three trits 00, 01, FF.
pub fn is_trit(b: u8) -> bool {
    return b == 0 or b == 1 or b == 255;
}

/// The verdict of the run.
pub fn verdict_of(n: u32, s: u64, c: u64, y: u64, e: u32, f: u32, s_want: u64, y_want: u64, n_want: u32) -> u8 {
    if (n == n_want and s == s_want and c == s and y == y_want and e == 0 and f == 0) { return V_PASS; }
    return V_FAIL;
}

/// How many clocks the receiver waits before its next sample: half a bit before the start bit's middle,
/// a whole bit before every later one.
pub fn rx_wait(bit: u8, div: u16) -> u16 {
    if (bit == 0) { return div >> 1; }
    return div;
}

/// The level of bit k (0 start, 1..8 data low bit first, 9 stop) of the UART frame of `b`.
pub fn frame_bit(b: u8, k: u32) -> bool {
    if (k == 0) { return false; }
    if (k >= 9) { return true; }
    var v : u8 = b;
    var j : u32 = 1;
    while (j < k) {
        v = v >> 1;
        j = j + 1;
    }
    return (v & 1) == 1;
}

; --- the receipt --------------------------------------------------------------------------------

/// The key letter of field s (1..7): N S C Y E F L.
pub fn key_of(s: u8) -> u8 {
    if (s == 1) { return 78; }
    if (s == 2) { return 83; }
    if (s == 3) { return 67; }
    if (s == 4) { return 89; }
    if (s == 5) { return 69; }
    if (s == 6) { return 70; }
    return 76;
}

/// Character p of "T27 TERN".
pub fn prefix_char(p: u8) -> u8 {
    if (p == 0) { return 84; }
    if (p == 1) { return 50; }
    if (p == 2) { return 55; }
    if (p == 3) { return 32; }
    if (p == 4) { return 84; }
    if (p == 5) { return 69; }
    if (p == 6) { return 82; }
    return 78;
}

/// The character at segment s, position p; `fsr` holds the field being written, its next nibble on top.
pub fn line_char(s: u8, p: u8, fsr: u64, v: u8) -> u8 {
    if (s == 0) { return prefix_char(p); }
    if (s == LINE_SEGS - 1) { return pass_fail_char(v, p); }
    if (p == 0) { return 32; }
    if (p == 1) { return key_of(s); }
    if (p == 2) { return 61; }
    return hex_digit((fsr >> 60) as u8);
}

/// The last position of segment s.
pub fn seg_last(s: u8) -> u8 {
    if (s == 0) { return 7; }
    if (s == LINE_SEGS - 1) { return 6; }
    return 18;
}

/// A UART frame, sent low bit first: a start bit 0, the 8 data bits, a stop bit 1.
pub fn frame(ch: u8) -> u16 {
    return ((ch as u16) << 1) | 512;
}

/// A byte of the test stream: trits in an uneven order, and a 02 where `bad` says so.
pub fn test_byte(k: u32, bad: u32) -> u8 {
    if (k == bad) { return 2; }
    const m : u32 = (k * 7 + k / 5) % 3;
    if (m == 0) { return 0; }
    if (m == 1) { return 1; }
    return 255;
}

; --- the board ----------------------------------------------------------------------------------

/// A differential input buffer (the 200 MHz oscillator on R4/T4).
pub struct IbufdsOut { O: bool }
pub fn IBUFDS(I: bool, IB: bool) -> IbufdsOut {}

/// The outputs of the LiteDRAM core, as named in its generated Verilog.
pub struct LitedramOut { ddram_a__0: bool, ddram_a__1: bool, ddram_a__2: bool, ddram_a__3: bool, ddram_a__4: bool, ddram_a__5: bool, ddram_a__6: bool, ddram_a__7: bool, ddram_a__8: bool, ddram_a__9: bool, ddram_a__10: bool, ddram_a__11: bool, ddram_a__12: bool, ddram_a__13: bool, ddram_a__14: bool, ddram_ba__0: bool, ddram_ba__1: bool, ddram_ba__2: bool, ddram_dm__0: bool, ddram_dm__1: bool, ddram_dm__2: bool, ddram_dm__3: bool, ddram_cas_n: bool, ddram_cke: bool, ddram_clk_n: bool, ddram_clk_p: bool, ddram_cs_n: bool, ddram_odt: bool, ddram_ras_n: bool, ddram_reset_n: bool, ddram_we_n: bool, init_done: bool, init_error: bool, pll_locked: bool, uart_tx: bool, user_clk: bool, user_port_native_0_cmd_ready: bool, user_port_native_0_rdata_data__0: u64, user_port_native_0_rdata_data__1: u64, user_port_native_0_rdata_data__2: u64, user_port_native_0_rdata_data__3: u64, user_port_native_0_rdata_valid: bool, user_port_native_0_wdata_ready: bool, user_rst: bool }

/// The LiteDRAM core: a DDR3 controller with its PHY and PLL, a 256-bit native user port, and a BIOS on the UART
/// that calibrates the PHY before it raises init_done.
pub fn litedram_core(clk_: bool, rst: bool, uart_rx_: bool, user_port_native_0_cmd_addr: u25, user_port_native_0_cmd_valid: bool, user_port_native_0_cmd_we: bool, user_port_native_0_rdata_ready: bool, user_port_native_0_wdata_data__0: u64, user_port_native_0_wdata_data__1: u64, user_port_native_0_wdata_data__2: u64, user_port_native_0_wdata_data__3: u64, user_port_native_0_wdata_valid: bool, user_port_native_0_wdata_we: u32, ddram_dq__0: bool, ddram_dq__1: bool, ddram_dq__2: bool, ddram_dq__3: bool, ddram_dq__4: bool, ddram_dq__5: bool, ddram_dq__6: bool, ddram_dq__7: bool, ddram_dq__8: bool, ddram_dq__9: bool, ddram_dq__10: bool, ddram_dq__11: bool, ddram_dq__12: bool, ddram_dq__13: bool, ddram_dq__14: bool, ddram_dq__15: bool, ddram_dq__16: bool, ddram_dq__17: bool, ddram_dq__18: bool, ddram_dq__19: bool, ddram_dq__20: bool, ddram_dq__21: bool, ddram_dq__22: bool, ddram_dq__23: bool, ddram_dq__24: bool, ddram_dq__25: bool, ddram_dq__26: bool, ddram_dq__27: bool, ddram_dq__28: bool, ddram_dq__29: bool, ddram_dq__30: bool, ddram_dq__31: bool, ddram_dqs_n__0: bool, ddram_dqs_n__1: bool, ddram_dqs_n__2: bool, ddram_dqs_n__3: bool, ddram_dqs_p__0: bool, ddram_dqs_p__1: bool, ddram_dqs_p__2: bool, ddram_dqs_p__3: bool) -> LitedramOut {}

