; --- the registers ------------------------------------------------------------------------------
var st : u8 = 0;
var n_beats : u32 = 640;
; the values the board judges against. Reset values, so they hold on the board: the first build reset
; them to 0, the tests set them before each run, and the board printed the right S and Y with FAIL.
var s_want : u64 = S_EXPECT;
var y_want : u64 = Y_EXPECT;
; the native port: address, command, write data
var ca : u32 = 0;
var cv : bool = false;
var cwe : bool = false;
var wv : bool = false;
var wb0 : u64 = 0;
var wb1 : u64 = 0;
var wb2 : u64 = 0;
var wb3 : u64 = 0;
; the load: write phase, beats written, bytes in the beat being packed, a packed beat waiting
var wph : u8 = 0;
var wi : u32 = 0;
var nb : u8 = 0;
var bfull : bool = false;
var wsum : u64 = 0;
; the read and the product: read phase, beats done, the beat being stepped through, its trit, the column
var rph : u8 = 0;
var ri : u32 = 0;
var rb0 : u64 = 0;
var rb1 : u64 = 0;
var rb2 : u64 = 0;
var rb3 : u64 = 0;
var tk : u8 = 0;
var col : u32 = 0;
var xv : u8 = 11;
var acc : u32 = 0;
var ysum : u64 = 0;
var csum : u64 = 0;
var bad : u32 = 0;
var ferr : u32 = 0;
var verdict : u8 = 3;
; the receiver: two flops of synchronizer, then a frame counter
var rx_s1 : bool = true;
var rx_s2 : bool = true;
var rx_busy : bool = false;
var rx_cnt : u16 = 0;
var rx_bit : u8 = 0;
var rx_sh : u8 = 0;
var rx_got : bool = false;
var rx_byte : u8 = 0;
var rx_div : u16 = 868;
; the transmitter
var baud_div : u16 = 868;
var tx_cnt : u16 = 0;
var tx_sh : u16 = 1023;
var tx_left : u8 = 0;
var seg : u8 = 0;
var pos : u8 = 0;
var fsr : u64 = 0;
var lines : u32 = 0;
var hb : u32 = 0;

/// The value of receipt field s (1..7), N S C Y E F L.
pub fn field(s: u8, n: u32, ws: u64, cs: u64, y: u64, e: u32, f: u32, l: u32) -> u64 {
    if (s == 1) { return n as u64; }
    if (s == 2) { return ws; }
    if (s == 3) { return cs; }
    if (s == 4) { return y; }
    if (s == 5) { return e as u64; }
    if (s == 6) { return f as u64; }
    return l as u64;
}

/// Lane k of beat i of the test stream, low byte first (the reference for the packer and the memory the
/// tests stand in for).
pub fn test_lane(i: u32, k: u32, bad: u32) -> u64 {
    var w : u64 = 0;
    var j : u32 = 8;
    while (j > 0) {
        j = j - 1;
        w = (w << 8) | (test_byte(i * 32 + k * 8 + j, bad) as u64);
    }
    return w;
}

// Every var is read before it is written, so the test's order and the clock edge agree.
fn on_clock(core_init_done: bool, core_init_error: bool, core_user_port_native_0_cmd_ready: bool, core_user_port_native_0_wdata_ready: bool, core_user_port_native_0_rdata_valid: bool, core_user_port_native_0_rdata_data__0: u64, core_user_port_native_0_rdata_data__1: u64, core_user_port_native_0_rdata_data__2: u64, core_user_port_native_0_rdata_data__3: u64, core_uart_tx: bool, uart_rx: bool) {
    uart_tx = (st == ST_REPORT and (tx_sh & 1) == 1) or (st != ST_REPORT and core_uart_tx);
    led_2 = !(st == ST_REPORT and verdict == V_PASS);
    led_3 = ((hb >> 26) & 1) == 1;
    hb = hb +% 1;
    if (st == ST_WAIT) {
        if (core_init_error) {
            verdict = V_FAIL;
            st = ST_REPORT;
        } else if (core_init_done) {
            st = ST_LOAD;
        }
    } else if (st == ST_LOAD) {
        if (wph == 0) {
            if (wi == n_beats) {
                st = ST_READ;
                ca = 0;
                cv = true;
                cwe = false;
                rph = 0;
            } else if (bfull) {
                bfull = false;
                ca = wi;
                cv = true;
                cwe = true;
                wph = 1;
            }
        } else if (wph == 1) {
            if (core_user_port_native_0_cmd_ready) {
                cv = false;
                wv = true;
                wph = 2;
            }
        } else {
            if (core_user_port_native_0_wdata_ready) {
                wv = false;
                wph = 0;
                wi = wi + 1;
            }
        }
        if (rx_got) {
            if (nb == 31) {
                wsum = fold_beat(wsum, (wb0 >> 8) | (wb1 << 56), (wb1 >> 8) | (wb2 << 56), (wb2 >> 8) | (wb3 << 56), (wb3 >> 8) | ((rx_byte as u64) << 56));
                bfull = true;
                nb = 0;
            } else {
                nb = nb + 1;
            }
            wb0 = (wb0 >> 8) | (wb1 << 56);
            wb1 = (wb1 >> 8) | (wb2 << 56);
            wb2 = (wb2 >> 8) | (wb3 << 56);
            wb3 = (wb3 >> 8) | ((rx_byte as u64) << 56);
        }
    } else if (st == ST_READ) {
        if (rph == 0) {
            if (core_user_port_native_0_cmd_ready) {
                cv = false;
                rph = 1;
            }
        } else if (rph == 1) {
            if (core_user_port_native_0_rdata_valid) {
                csum = fold_beat(csum, core_user_port_native_0_rdata_data__0, core_user_port_native_0_rdata_data__1, core_user_port_native_0_rdata_data__2, core_user_port_native_0_rdata_data__3);
                rb0 = core_user_port_native_0_rdata_data__0;
                rb1 = core_user_port_native_0_rdata_data__1;
                rb2 = core_user_port_native_0_rdata_data__2;
                rb3 = core_user_port_native_0_rdata_data__3;
                tk = 0;
                rph = 2;
            }
        } else if (rph == 2) {
            acc = acc +% trit_term((rb0 & 255) as u8, xv);
            if (!is_trit((rb0 & 255) as u8)) { bad = bad + 1; }
            xv = xv +% XSTEP;
            col = col + 1;
            rb0 = (rb0 >> 8) | (rb1 << 56);
            rb1 = (rb1 >> 8) | (rb2 << 56);
            rb2 = (rb2 >> 8) | (rb3 << 56);
            rb3 = rb3 >> 8;
            if (tk == 31) {
                rph = 3;
            } else {
                tk = tk + 1;
            }
        } else {
            if (col == W_COLS) {
                ysum = fold_beat(ysum, acc as u64, 0, 0, 0);
                acc = 0;
                col = 0;
                xv = XV0;
            }
            if (ri + 1 == n_beats) {
                st = ST_JUDGE;
            } else {
                ca = ri + 1;
                cv = true;
                rph = 0;
            }
            ri = ri + 1;
        }
    } else if (st == ST_JUDGE) {
        verdict = verdict_of(ri, wsum, csum, ysum, bad, ferr, s_want, y_want, n_beats);
        st = ST_REPORT;
    } else {
        if (tx_cnt + 1 < baud_div) {
            tx_cnt = tx_cnt + 1;
        } else {
            tx_cnt = 0;
            if (tx_left != 0) {
                tx_sh = (tx_sh >> 1) | 512;
                tx_left = tx_left - 1;
            } else {
                tx_sh = frame(line_char(seg, pos, fsr, verdict));
                tx_left = 9;
                if (pos == seg_last(seg)) {
                    fsr = field(seg + 1, ri, wsum, csum, ysum, bad, ferr, lines);
                    pos = 0;
                    if (seg == LINE_SEGS - 1) {
                        seg = 0;
                        lines = lines + 1;
                    } else {
                        seg = seg + 1;
                    }
                } else {
                    if (seg != 0 and seg != LINE_SEGS - 1 and pos >= 3) { fsr = fsr << 4; }
                    pos = pos + 1;
                }
            }
        }
    }
    if (rx_busy) {
        if (rx_cnt + 1 < rx_wait(rx_bit, rx_div)) {
            rx_cnt = rx_cnt + 1;
            rx_got = false;
        } else {
            rx_cnt = 0;
            if (rx_bit == 0) {
                if (rx_s2) {
                    rx_busy = false;
                } else {
                    rx_bit = 1;
                }
                rx_got = false;
            } else if (rx_bit < 9) {
                if (rx_s2) {
                    rx_sh = (rx_sh >> 1) | 128;
                } else {
                    rx_sh = rx_sh >> 1;
                }
                rx_bit = rx_bit + 1;
                rx_got = false;
            } else {
                rx_busy = false;
                rx_bit = 0;
                if (rx_s2) {
                    rx_byte = rx_sh;
                    rx_got = true;
                } else {
                    ferr = ferr + 1;
                    rx_got = false;
                }
            }
        }
    } else {
        rx_got = false;
        if (!rx_s2) {
            rx_busy = true;
            rx_cnt = 0;
            rx_bit = 0;
        }
    }
    rx_s2 = rx_s1;
    rx_s1 = uart_rx;
}

; --- the tests ----------------------------------------------------------------------------------

// First, before any test sets them; the tests that do restore them. A board out of reset judges with
// these values and no others.
test out_of_reset_the_board_judges_against_the_pinned_values {
    assert_eq(n_beats, 640);
    assert_eq(s_want, S_EXPECT);
    assert_eq(y_want, Y_EXPECT);
    assert_eq(verdict_of(640, S_EXPECT, S_EXPECT, Y_EXPECT, 0, 0, s_want, y_want, n_beats), V_PASS);
    assert_eq(verdict_of(640, S_EXPECT, S_EXPECT, Y_EXPECT, 0, 0, 0, 0, n_beats), V_FAIL);
}

test the_tensor_is_640_beats_of_32_trits {
    var beats : u32 = 0;
    var bytes : u64 = 0;
    var r : u32 = 0;
    while (r < W_ROWS) {
        beats = beats + BEATS_PER_ROW;
        bytes = bytes + (W_COLS as u64);
        r = r + 1;
    }
    assert_eq(beats, W_BEATS);
    assert_eq(bytes, W_BYTES);
    assert_eq((beats as u64) * BEAT_BYTES, bytes);
    assert_eq((BEATS_PER_ROW as u64) * BEAT_BYTES, W_COLS as u64);
    assert_eq(W_OFFSET, 10589476);
}

test a_trit_adds_plus_x_minus_x_or_nothing {
    assert_eq(sext8(11), 11);
    assert_eq(sext8(127), 127);
    assert_eq(sext8(128), 0xFFFFFF80);
    assert_eq(sext8(255), 0xFFFFFFFF);
    assert_eq(trit_term(1, 11), 11);
    assert_eq(trit_term(255, 11), 0xFFFFFFF5);
    assert_eq(trit_term(0, 11), 0);
    assert_eq(trit_term(2, 11), 0);
    assert_eq(trit_term(1, 200), 0xFFFFFFC8);
    assert_eq(trit_term(255, 200), 56);
    assert_eq(trit_term(255, 0), 0);
    assert_eq(trit_term(1, 11) +% trit_term(255, 11), 0);
    assert is_trit(0) and is_trit(1) and is_trit(255);
    assert !is_trit(2) and !is_trit(254) and !is_trit(128);
}

test the_input_is_37c_plus_11_as_an_int8 {
    var x : u8 = XV0;
    var c : u32 = 0;
    var zero_at : u32 = 9999;
    while (c < W_COLS) {
        assert_eq(x as u32, (37 * c + 11) % 256);
        if (x == 0) { zero_at = c; }
        x = x +% XSTEP;
        c = c + 1;
    }
    assert_eq(zero_at, 145);
}

test the_receiver_takes_a_frame_at_mid_bit_and_counts_a_bad_stop {
    st = ST_WAIT;
    rx_div = 4;
    rx_s1 = true;
    rx_s2 = true;
    rx_busy = false;
    rx_got = false;
    rx_byte = 0;
    ferr = 0;
    var got : u32 = 0;
    var t : u32 = 0;
    while (t < 60) {
        on_clock(false, false, false, false, false, 0, 0, 0, 0, true, frame_bit(0xA5, t / 4));
        if (rx_got) { got = got + 1; }
        t = t + 1;
    }
    assert_eq(got, 1);
    assert_eq(rx_byte, 0xA5);
    assert_eq(ferr, 0);
    t = 0;
    while (t < 60) {
        on_clock(false, false, false, false, false, 0, 0, 0, 0, true, t / 4 < 9 and frame_bit(0x3C, t / 4));
        if (rx_got) { got = got + 1; }
        t = t + 1;
    }
    assert_eq(got, 1);
    assert_eq(ferr, 1);
    rx_div = 868;
}

test two_rows_go_in_come_back_and_are_multiplied {
    var sref : u64 = 0;
    var i : u32 = 0;
    while (i < 20) {
        sref = fold_beat(sref, test_lane(i, 0, 99999), test_lane(i, 1, 99999), test_lane(i, 2, 99999), test_lane(i, 3, 99999));
        i = i + 1;
    }
    var yref : u64 = 0;
    var r : u32 = 0;
    while (r < 2) {
        var a : u32 = 0;
        var x : u8 = XV0;
        var c : u32 = 0;
        while (c < W_COLS) {
            a = a +% trit_term(test_byte(r * W_COLS + c, 99999), x);
            x = x +% XSTEP;
            c = c + 1;
        }
        yref = fold_beat(yref, a as u64, 0, 0, 0);
        r = r + 1;
    }
    st = ST_LOAD;
    n_beats = 20;
    s_want = sref;
    y_want = yref;
    ca = 0;
    cv = false;
    cwe = false;
    wv = false;
    wb0 = 0;
    wb1 = 0;
    wb2 = 0;
    wb3 = 0;
    wph = 0;
    wi = 0;
    nb = 0;
    bfull = false;
    wsum = 0;
    rph = 0;
    ri = 0;
    tk = 0;
    col = 0;
    xv = XV0;
    acc = 0;
    ysum = 0;
    csum = 0;
    bad = 0;
    ferr = 0;
    verdict = V_FAIL;
    rx_s1 = true;
    rx_s2 = true;
    rx_busy = false;
    rx_got = false;
    rx_div = 4;
    var wrote : u32 = 0;
    var t : u32 = 0;
    while (t < 40000 and st != ST_REPORT) {
        if (st == ST_LOAD and wph == 2) {
            assert wb0 == test_lane(ca, 0, 99999) and wb1 == test_lane(ca, 1, 99999) and wb2 == test_lane(ca, 2, 99999) and wb3 == test_lane(ca, 3, 99999);
            assert cwe;
            wrote = wrote + 1;
        }
        on_clock(true, false, true, true, st == ST_READ and rph == 1, test_lane(ca, 0, 99999), test_lane(ca, 1, 99999), test_lane(ca, 2, 99999), test_lane(ca, 3, 99999), true, t / 48 >= 640 or frame_bit(test_byte(t / 48, 99999), (t % 48) / 4));
        t = t + 1;
    }
    assert_eq(st, ST_REPORT);
    assert_eq(wrote, 20);
    assert_eq(ri, 20);
    assert_eq(wsum, sref);
    assert_eq(csum, wsum);
    assert_eq(ysum, yref);
    assert_eq(bad, 0);
    assert_eq(ferr, 0);
    assert_eq(verdict, V_PASS);
    assert_eq(col, 0);
    rx_div = 868;
    n_beats = 640;
    s_want = S_EXPECT;
    y_want = Y_EXPECT;
}

test a_byte_that_is_no_trit_is_counted_and_fails {
    var sref : u64 = 0;
    var i : u32 = 0;
    while (i < 10) {
        sref = fold_beat(sref, test_lane(i, 0, 17), test_lane(i, 1, 17), test_lane(i, 2, 17), test_lane(i, 3, 17));
        i = i + 1;
    }
    var a : u32 = 0;
    var x : u8 = XV0;
    var c : u32 = 0;
    while (c < W_COLS) {
        a = a +% trit_term(test_byte(c, 17), x);
        x = x +% XSTEP;
        c = c + 1;
    }
    st = ST_LOAD;
    n_beats = 10;
    s_want = sref;
    y_want = fold_beat(0, a as u64, 0, 0, 0);
    ca = 0;
    cv = false;
    wv = false;
    wph = 0;
    wi = 0;
    nb = 0;
    bfull = false;
    wsum = 0;
    rph = 0;
    ri = 0;
    col = 0;
    xv = XV0;
    acc = 0;
    ysum = 0;
    csum = 0;
    bad = 0;
    ferr = 0;
    verdict = V_PASS;
    rx_s1 = true;
    rx_s2 = true;
    rx_busy = false;
    rx_got = false;
    rx_div = 4;
    var t : u32 = 0;
    while (t < 20000 and st != ST_REPORT) {
        on_clock(true, false, true, true, st == ST_READ and rph == 1, test_lane(ca, 0, 17), test_lane(ca, 1, 17), test_lane(ca, 2, 17), test_lane(ca, 3, 17), true, t / 48 >= 320 or frame_bit(test_byte(t / 48, 17), (t % 48) / 4));
        t = t + 1;
    }
    assert_eq(st, ST_REPORT);
    assert_eq(ri, 10);
    assert_eq(wsum, sref);
    assert_eq(csum, wsum);
    assert_eq(ysum, y_want);
    assert_eq(bad, 1);
    assert_eq(verdict, V_FAIL);
    assert_eq(verdict_of(ri, wsum, csum, ysum, 0, 0, s_want, y_want, 10), V_PASS);
    assert_eq(verdict_of(ri, wsum, csum ^ 1, ysum, 0, 0, s_want, y_want, 10), V_FAIL);
    assert_eq(verdict_of(ri, wsum, csum, ysum ^ 1, 0, 0, s_want, y_want, 10), V_FAIL);
    assert_eq(verdict_of(ri, wsum, csum, ysum, 0, 1, s_want, y_want, 10), V_FAIL);
    assert_eq(verdict_of(9, wsum, csum, ysum, 0, 0, s_want, y_want, 10), V_FAIL);
    rx_div = 868;
    n_beats = 640;
    s_want = S_EXPECT;
    y_want = Y_EXPECT;
}

test a_failed_calibration_reports_fail {
    st = ST_WAIT;
    verdict = V_PASS;
    on_clock(false, true, false, false, false, 0, 0, 0, 0, true, true);
    assert_eq(st, ST_REPORT);
    assert_eq(verdict, V_FAIL);
}

test the_receipt_line_says_what_was_computed {
    st = ST_REPORT;
    ri = 640;
    wsum = 0x0123456789ABCDEF;
    csum = 0x0123456789ABCDEF;
    ysum = 0xFEDCBA9876543210;
    bad = 0;
    ferr = 0;
    lines = 0;
    verdict = V_PASS;
    baud_div = 1;
    tx_cnt = 0;
    tx_sh = 1023;
    tx_left = 0;
    seg = 0;
    pos = 0;
    var got : u32 = 0;
    var bits : u32 = 0;
    var ch : u8 = 0;
    var line : u32 = 0;
    while (line < 2) {
        on_clock(true, false, false, false, false, 0, 0, 0, 0, true, true);
        bits = bits + 1;
        if (tx_left == 9) {
            assert_eq(tx_sh & 1, 0);
            assert_eq(tx_sh >> 9, 1);
            ch = ((tx_sh >> 1) & 255) as u8;
            if (got == 0) { assert_eq(ch, 84); }
            if (got == 4) { assert_eq(ch, 84); }
            if (got == 7) { assert_eq(ch, 78); }
            if (got == 9) { assert_eq(ch, 78); }
            if (got == 10) { assert_eq(ch, 61); }
            if (got == 24) { assert_eq(ch, 50); }
            if (got == 25) { assert_eq(ch, 56); }
            if (got == 26) { assert_eq(ch, 48); }
            if (got == 28) { assert_eq(ch, 83); }
            if (got == 31) { assert_eq(ch, 49); }
            if (got == 45) { assert_eq(ch, 70); }
            if (got == 47) { assert_eq(ch, 67); }
            if (got == 66) { assert_eq(ch, 89); }
            if (got == 68) { assert_eq(ch, 70); }
            if (got == 83) { assert_eq(ch, 48); }
            if (got == 85) { assert_eq(ch, 69); }
            if (got == 104) { assert_eq(ch, 70); }
            if (got == 123) { assert_eq(ch, 76); }
            if (line == 0 and got == 140) { assert_eq(ch, 48); }
            if (line == 1 and got == 140) { assert_eq(ch, 49); }
            if (got == 142) { assert_eq(ch, 80); }
            if (got == 145) { assert_eq(ch, 83); }
            if (got == 146) { assert_eq(ch, 13); }
            if (ch == 10) {
                assert_eq(got, 147);
                got = 0;
                line = line + 1;
            } else {
                got = got + 1;
            }
        }
    }
    assert_eq(lines, 2);
    assert_eq(bits, (2 * 148 - 1) * 10 + 1);
    baud_div = 868;
}

test the_pins_that_read_the_run_are_set_from_its_state {
    baud_div = 868;
    tx_cnt = 0;
    tx_left = 0;
    st = ST_WAIT;
    verdict = V_PASS;
    hb = 0;
    tx_sh = 1023;
    on_clock(false, false, false, false, false, 0, 0, 0, 0, false, true);
    assert_eq(uart_tx, false);
    assert_eq(led_2, true);
    assert_eq(led_3, false);
    on_clock(false, false, false, false, false, 0, 0, 0, 0, true, true);
    assert_eq(uart_tx, true);
    st = ST_REPORT;
    tx_sh = 1022;
    hb = 67108864;
    on_clock(false, false, false, false, false, 0, 0, 0, 0, true, true);
    assert_eq(uart_tx, false);
    assert_eq(led_2, false);
    assert_eq(led_3, true);
    tx_sh = 1023;
    on_clock(false, false, false, false, false, 0, 0, 0, 0, false, true);
    assert_eq(uart_tx, true);
}
