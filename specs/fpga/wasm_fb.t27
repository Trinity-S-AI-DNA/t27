// SPDX-License-Identifier: Apache-2.0
; specs/fpga/wasm_fb.t27 -- a 320x200 palette framebuffer in the T27 OS video raster (Refs gHashTag/t27#12203).
; DOOM draws 320x200 pixels of one byte each (a palette index) through a 256-entry palette (PLAYPAL, 0x00RRGGBB).
; The video core specs/fpga/vga_text_core.t27 has a 640x480 raster of one-bit text pixels and no framebuffer; this
; cell is the framebuffer and the pixel source for that raster, with its own write port (fb_put, pal_put). Linear
; memory is where the DOOM pixels come from later; nothing here reads it.
; -
; THE LAYOUT. The 320x200 frame is scaled 2x into a 640x400 band at raster rows 40..439: 40 black rows above it and
; 40 below, nothing at x >= 640. Screen pixel (x, y) in the band reads framebuffer index ((y - 40) / 2) * 320 + x / 2.
; Pixel (0,40) is index 0; pixel (639,439) is index 63999. FB is 64000 bytes, PAL is 256 words of 0x00RRGGBB.
; -
; THE PALETTE. pal_default() is a stand-in ramp, NOT PLAYPAL: hi = i / 16, lo = i % 16, brightness v = lo * 16 + 15
; (halved for hi >= 8) on the channels picked by hi % 8 (bit 0 red, bit 1 green, bit 2 blue, 0 means all three).
; Entry 15 is white, entry 31 is red, entry 143 is half grey (0x7F7F7F).
; -
; THE TEST PATTERN. fb_test_pattern() loads pal_default() and fills the frame: rows 0..191 are a 16x16 grid of blocks
; 20 columns by 12 rows, block (bx, by) at column 20 * bx and row 12 * by holding entry by * 16 + bx; rows 192..199
; are a gradient, entry x * 256 / 320 at column x.
; -
; THE ONE SOURCE PICKER. frame_pixel_at(x, y, fb_on) is the only place that chooses between the framebuffer and the
; text raster. pixel_at comes from vga_text_core by `use` and has this one call site; it is not copied. gen-verilog
; binds no `use`d name, so that call site is the one known line of the elab ratchet row (tools/elab_baseline.txt).
; -
; WHAT A PASS SAYS: the layout, the 2x scale, the letterbox, the palette ramp and the test pattern are what the
; lines above say, on the vectors in the tests. WHAT IT DOES NOT SAY: nothing here has met a monitor or a board;
; the board is the job of hdmi_grab. No char literal and no std.c name is used (t27#12171). ASCII only (L3).
module fpga_wasm_fb;

use fpga::vga_text_core::pixel_at;

pub const FB_W : u32 = 320;
pub const FB_H : u32 = 200;
pub const FB_SIZE : u32 = 64000;
pub const PAL_SIZE : u32 = 256;
pub const SCREEN_W : u32 = 640;
pub const BAND_TOP : u32 = 40;
pub const BAND_END : u32 = 440;
pub const RGB_WHITE : u32 = 0x00FFFFFF;

pub var FB : [64000]u8 = [0] ** 64000;
pub var PAL : [256]u32 = [0] ** 256;

/// Write palette index v at framebuffer index i; an i at or past 64000 is ignored.
pub fn fb_put(i : u32, v : u8) {
    if (i < FB_SIZE) {
        FB[i] = v;
    }
}

/// Store palette entry i as 0x00RRGGBB (r in bits 16..23); an i at or past 256 is ignored.
pub fn pal_put(i : u32, r : u32, g : u32, b : u32) {
    if (i < PAL_SIZE) {
        PAL[i] = ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
    }
}

/// Set every framebuffer byte to v.
pub fn fb_fill(v : u8) {
    var i : u32 = 0;
    while (i < FB_SIZE) {
        FB[i] = v;
        i = i + 1;
    }
}

/// Set every palette entry to the colour (r, g, b).
pub fn pal_fill(r : u32, g : u32, b : u32) {
    var i : u32 = 0;
    while (i < PAL_SIZE) {
        pal_put(i, r, g, b);
        i = i + 1;
    }
}

/// The stand-in ramp: not PLAYPAL. See THE PALETTE above.
pub fn pal_default() {
    var i : u32 = 0;
    while (i < PAL_SIZE) {
        var hi : u32 = i >> 4;
        var lo : u32 = i & 15;
        var v : u32 = lo * 16 + 15;
        if (hi >= 8) {
            v = v >> 1;
        }
        var sel : u32 = hi & 7;
        var r : u32 = 0;
        var g : u32 = 0;
        var b : u32 = 0;
        if (sel == 0) {
            r = v;
            g = v;
            b = v;
        } else {
            if ((sel & 1) != 0) { r = v; }
            if ((sel & 2) != 0) { g = v; }
            if ((sel & 4) != 0) { b = v; }
        }
        pal_put(i, r, g, b);
        i = i + 1;
    }
}

/// The palette ramp and the frame: a 16x16 grid of the 256 entries over rows 0..191, a gradient on rows 192..199.
pub fn fb_test_pattern() {
    pal_default();
    var y : u32 = 0;
    while (y < FB_H) {
        var x : u32 = 0;
        while (x < FB_W) {
            var v : u32 = 0;
            if (y < 192) {
                v = (y / 12) * 16 + (x / 20);
            } else {
                v = (x * 256) / 320;
            }
            fb_put(y * FB_W + x, v as u8);
            x = x + 1;
        }
        y = y + 1;
    }
}

/// The 0x00RRGGBB of raster pixel (x, y) when the framebuffer is the source: the 2x scaled frame in rows 40..439, black elsewhere.
pub fn fb_pixel_at(x : u32, y : u32) u32 {
    if (y < BAND_TOP) { return 0; }
    if (y >= BAND_END) { return 0; }
    if (x >= SCREEN_W) { return 0; }
    var idx : u32 = ((y - BAND_TOP) >> 1) * FB_W + (x >> 1);
    var p : u32 = FB[idx] as u32;
    return PAL[p];
}

/// The raster pixel (x, y): the framebuffer when fb_on, else white where the text raster is lit and black where it is not.
pub fn frame_pixel_at(x : u32, y : u32, fb_on : bool) u32 {
    if (fb_on) { return fb_pixel_at(x, y); }
    if (pixel_at(x, y)) { return RGB_WHITE; }
    return 0;
}

test the_letterbox_rows_and_columns_are_black_with_the_whole_palette_white {
    pal_fill(255, 255, 255);
    fb_fill(7);
    // positive controls: the band itself is white, so the black below is the letterbox and not an empty palette
    assert fb_pixel_at(5, 40) == 0x00FFFFFF;
    assert fb_pixel_at(5, 439) == 0x00FFFFFF;
    assert fb_pixel_at(639, 100) == 0x00FFFFFF;
    // 40 black rows above, 40 below, nothing past x = 639
    assert fb_pixel_at(5, 39) == 0;
    assert fb_pixel_at(5, 0) == 0;
    assert fb_pixel_at(5, 440) == 0;
    assert fb_pixel_at(5, 479) == 0;
    assert fb_pixel_at(640, 100) == 0;
}

test pixel_0_40_reads_framebuffer_index_0 {
    pal_fill(2, 2, 2);
    pal_put(9, 9, 9, 9);
    fb_fill(2);
    fb_put(0, 9);
    assert FB[0] == 9;
    assert FB[1] == 2;
    assert fb_pixel_at(0, 40) == 0x00090909;
    assert fb_pixel_at(2, 40) == 0x00020202;
}

test pixel_639_439_reads_index_63999_and_a_put_past_the_end_changes_nothing {
    pal_fill(2, 2, 2);
    pal_put(9, 9, 9, 9);
    fb_fill(2);
    fb_put(63999, 9);
    assert fb_pixel_at(639, 439) == 0x00090909;
    assert fb_pixel_at(638, 438) == 0x00090909;
    assert fb_pixel_at(637, 439) == 0x00020202;
    fb_put(64000, 5);
    fb_put(4294967295, 5);
    assert FB[0] == 2;
    assert FB[63998] == 2;
    assert FB[63999] == 9;
}

test every_framebuffer_pixel_is_a_2x2_block_of_the_raster {
    pal_fill(2, 2, 2);
    pal_put(9, 9, 9, 9);
    pal_put(8, 8, 8, 8);
    fb_fill(2);
    fb_put(0, 9);
    fb_put(1, 8);
    assert fb_pixel_at(0, 40) == 0x00090909;
    assert fb_pixel_at(1, 40) == 0x00090909;
    assert fb_pixel_at(0, 41) == 0x00090909;
    assert fb_pixel_at(1, 41) == 0x00090909;
    assert fb_pixel_at(2, 40) == 0x00080808;
    assert fb_pixel_at(3, 41) == 0x00080808;
    // the next frame row is raster row 42, index 320, still the fill
    assert fb_pixel_at(0, 42) == 0x00020202;
}

test the_pattern_puts_block_by_times_16_plus_bx_in_each_20_by_12_block_and_a_gradient_below {
    fb_fill(0);
    fb_test_pattern();
    assert FB[3860] == 17;
    assert FB[7399] == 17;
    assert FB[3880] == 18;
    assert FB[63999] == 255;
    // block (0,0) is entry 0 up to column 19, then block (1,0) is entry 1
    assert FB[19] == 0;
    assert FB[20] == 1;
    // block (0,1) starts at row 12, the last block row 191 ends at 61439 with block (15,15)
    assert FB[3840] == 16;
    assert FB[61439] == 255;
    // the gradient: row 192 starts at 61440, column 160 is 160 * 256 / 320 = 128
    assert FB[61440] == 0;
    assert FB[61600] == 128;
}

test pal_put_17_after_the_pattern_shows_on_the_screen_pixel_of_block_1_1 {
    fb_fill(0);
    fb_test_pattern();
    pal_put(17, 1, 2, 3);
    assert PAL[17] == 0x00010203;
    assert fb_pixel_at(40, 64) == 0x00010203;
    // block (2,1) is entry 18 = 2 * 16 + 15 = 47 on red
    assert fb_pixel_at(80, 64) == 0x002F0000;
}

test frame_pixel_at_is_the_text_raster_when_fb_is_off_and_the_framebuffer_when_it_is_on {
    // text source over the first 16 rows and 64 columns: only white or black, and exactly the 108 lit pixels of
    // the title glyphs T 18, 2 22, 7 18, O 28, S 22 (vga_text_core G_*), all of them on rows 0..7
    var white : u32 = 0;
    var other : u32 = 0;
    var low_rows : u32 = 0;
    var y : u32 = 0;
    while (y < 16) {
        var x : u32 = 0;
        while (x < 64) {
            var c : u32 = frame_pixel_at(x, y, false);
            if (c == RGB_WHITE) {
                white = white + 1;
                if (y >= 8) { low_rows = low_rows + 1; }
            } else {
                if (c != 0) { other = other + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    assert white == 108;
    assert other == 0;
    assert low_rows == 0;
    // the bar of T, the top of 2, and the dark gaps between
    assert frame_pixel_at(0, 0, false) == 0;
    assert frame_pixel_at(1, 0, false) == 0x00FFFFFF;
    assert frame_pixel_at(6, 0, false) == 0x00FFFFFF;
    assert frame_pixel_at(7, 0, false) == 0;
    assert frame_pixel_at(3, 3, false) == 0x00FFFFFF;
    assert frame_pixel_at(2, 3, false) == 0;
    assert frame_pixel_at(9, 0, false) == 0;
    assert frame_pixel_at(10, 0, false) == 0x00FFFFFF;
    assert frame_pixel_at(14, 0, false) == 0;
    // framebuffer source: equal to fb_pixel_at over the letterbox and the first band rows
    fb_fill(0);
    fb_test_pattern();
    var diff : u32 = 0;
    y = 0;
    while (y < 112) {
        var x2 : u32 = 0;
        while (x2 < 64) {
            if (frame_pixel_at(x2, y, true) != fb_pixel_at(x2, y)) { diff = diff + 1; }
            x2 = x2 + 1;
        }
        y = y + 1;
    }
    assert diff == 0;
    // the two sources differ: the T bar is white as text and black above the band; block (1,1) is red as frame
    assert frame_pixel_at(1, 0, true) == 0;
    assert frame_pixel_at(40, 64, true) == 0x001F0000;
    assert frame_pixel_at(40, 64, false) == 0;
}

test pal_default_makes_15_white_31_red_143_half_grey {
    pal_fill(0, 0, 0);
    pal_default();
    assert PAL[15] == 0x00FFFFFF;
    assert PAL[31] == 0x00FF0000;
    assert PAL[143] == 0x007F7F7F;
    // the other corners of the ramp: entry 0 is dark grey, 16 dark red, 48 red plus green, 64 dark blue, 255 half grey
    assert PAL[0] == 0x000F0F0F;
    assert PAL[16] == 0x000F0000;
    assert PAL[48] == 0x000F0F00;
    assert PAL[64] == 0x0000000F;
    assert PAL[255] == 0x007F7F7F;
    // a put past the end of the palette changes nothing
    pal_put(256, 255, 255, 255);
    assert PAL[255] == 0x007F7F7F;
    assert PAL[0] == 0x000F0F0F;
}
