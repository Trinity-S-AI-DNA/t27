// SPDX-License-Identifier: Apache-2.0
; specs/fpga/probe_ports.t27 -- a throwaway probe, deleted once the board spec shape is known.
; Answers three questions the interpreter spec could not, because it has no on_clock:
;   1. do on_clock parameters become input ports and mutable scalars output ports?
;   2. does an indexed array write inside the per-tick body lower to Verilog?
;   3. can the tests drive the tick through a plain step_all fn (a task in the
;      generated Verilog) while on_clock wraps it for the ports? A direct test
;      call of on_clock cannot work: on_clock lowers to the always block, not a
;      task, so iverilog reports "unknown task" (eth_rx and ro_race hit this
;      today).
; Write discipline: every read happens before any write of the same var, so the
; blocking task semantics the tests see match the nonblocking RTL semantics.
; ASCII only, English only.

module fpga_probe_ports;

var mem : [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
var k : u32 = 0
var y : u8 = 0
var ticks : u32 = 0

fn sel8(s : u8, nv : u8, v : u8) -> u8 {
    if (s == 1) { return nv; }
    return v;
}

fn sel32(s : u8, nv : u32, v : u32) -> u32 {
    if (s == 1) { return nv; }
    return v;
}

fn step_all(go : u8, d : u8, i : u32) {
    y = sel8(go, d, mem[i]);
    mem[i] = sel8(go, d, mem[i]);
    k = sel32(go, k + 1, k);
}

fn on_clock(go : u8, d : u8, i : u32) {
    ; The step_all call must not be the last statement: a trailing bare call is
    ; lowered as the implicit return of the fn (`on_clock <= step_all(...)`, the
    ; empty-vs-void spelling gap, W705 family). The tick counter after it is
    ; also a live-core diagnostic for the board run.
    step_all(go, d, i);
    ticks = ticks + 1;
}

test probe_step_write {
    step_all(1, 7, 3);
    assert mem[3] == 7;
    assert k == 1;
    assert y == 7;
    step_all(0, 9, 3);
    assert mem[3] == 7;
    assert k == 1;
    assert y == 7;
    step_all(1, 9, 3);
    assert mem[3] == 9;
    assert k == 2;
    assert y == 9;
}
