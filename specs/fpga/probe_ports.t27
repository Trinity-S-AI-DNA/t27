; specs/fpga/probe_ports.t27 -- a throwaway probe, deleted once the board spec shape is known.
; Answers two questions the interpreter spec could not, because it has no on_clock:
;   1. do on_clock parameters become input ports and mutable scalars output ports?
;   2. does an indexed array write inside on_clock lower to Verilog?
; ASCII only, English only.

module fpga_probe_ports;

var mem : [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
var k : u32 = 0
var y : u8 = 0

fn sel8(s : u8, nv : u8, v : u8) -> u8 {
    if (s == 1) { return nv; }
    return v;
}

fn sel32(s : u8, nv : u32, v : u32) -> u32 {
    if (s == 1) { return nv; }
    return v;
}

fn on_clock(go : u8, d : u8, i : u32) {
    mem[i] = sel8(go, d, mem[i]);
    k = sel32(go, k + 1, k);
    y = sel8(go, mem[i], y);
}

test probe_step_write {
    on_clock(1, 7, 3);
    assert mem[3] == 7;
    assert k == 1;
    assert y == 7;
    on_clock(0, 9, 3);
    assert mem[3] == 7;
    assert k == 1;
    on_clock(1, 9, 3);
    assert mem[3] == 9;
    assert k == 2;
}
