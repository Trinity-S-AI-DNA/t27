/// TRI-NET Ethernet Top Module: 100 Mb/s node top-level
/// 
/// This module wires together the six main components:
/// - Mdio100m: MDIO pins and PHY reset
/// - Rgmii100: RGMII nibble core between RXC/RXD and TXC/TXD  
/// - EthRx: Ethernet receive path
/// - TrinetNode: TRI-NET node core
/// - EthReply: Ethernet reply path
/// - JtagStatus: BSCANE2 USER3 status chain
///
/// Features:
/// - PLL generates 0° and 180° clocks from RXC 25 MHz
/// - ODDR forwards TXC for proper transmit timing
/// - LED status indicators
/// - BSCANE2 USER3 debug chain

// Import required modules
use fpga::xc7_primitives;
use mdio_100m::Mdio100m;
use rgmii_100::Rgmii100;
use eth_rx::EthRx;
use trinet_node::TrinetNode;
use eth_reply::EthReply;
use jtag_status::JtagStatus;

// Module declaration
module TrinetEthTop;

// Constants and parameters
const PLL_REFCLK_FREQ : u32 = 25000000;  // 25 MHz from RXC
const CLK_0_FREQ : u32 = 25000000;       // 0° phase output (25 MHz)
const CLK_180_FREQ : u32 = 25000000;     // 180° phase output (25 MHz)
const CLK_125_FREQ : u32 = 125000000;    // 125 MHz for data processing

// PLL instance for 25 MHz RXC to 0°/180° clocks
const pll : Plle2AdvOut = PLLE2_ADV(rxc_25m, true, true, reset, pll_locked, clk_0deg, clk_180deg, false, false, false, false);

// ODDR for TXC forwarding
const txc_oddr : OddrOut = ODDR(clk_0deg, clk_180deg, txc_data, txc_data, txc_forwarded);

// BSCANE2 USER3 chain for JTAG status
const jtag_chain : Bscane2Out = BSCANE2(3, true, jtag_tdo);

// Module instances
const mdio : Mdio100mOut = Mdio100m(clk_0deg, reset, phy_mdio, phy_mdc, phy_reset, phy_int);

const rgmii : Rgmii100Out = Rgmii100(clk_125m, rxc_25m, txc_forwarded, phy_rxd, phy_txd, phy_rx_dv, phy_tx_en, eth_rx_data, eth_rx_valid, eth_tx_data, eth_tx_valid);

const eth_rx : EthRx = EthRx(eth_rx_valid, eth_rx_data);

const trinet_node : TrinetNode = TrinetNode(eth_rx.pay_v, eth_rx.pay_b, eth_rx.pay_i, eth_rx.done, eth_rx.ok);

const eth_reply : EthReply = EthReply(trinet_node.j_go, eth_rx.src_mac, eth_rx.src_ip, eth_rx.src_port, trinet_node.r_y, trinet_node.r_st, trinet_node.r_n, trinet_node.r_tag);

const jtag : JtagStatusOut = JtagStatus(jtag_tck, jtag_tdi, jtag_tdo, jtag_tms, reset, 3, true);

// Top-level interface
pub struct TrinetEthTopOut {
    // PHY interface
    phy_mdio: bool,
    phy_mdc: bool,
    phy_reset: bool,
    phy_int: bool,
    phy_rxd: bool,
    phy_txd: bool,
    phy_rx_dv: bool,
    phy_tx_en: bool,
    phy_rxc: bool,
    phy_txc: bool,
    
    // Status LEDs
    led_0: bool,
    led_1: bool,
    led_2: bool,
    led_3: bool,
    
    // JTAG interface
    jtag_tck: bool,
    jtag_tdi: bool,
    jtag_tdo: bool,
    jtag_tms: bool,
    jtag_user3: bool,
    
    // System status
    pll_locked: bool,
    clk_0deg: bool,
    clk_180deg: bool,
    clk_125m: bool
}

// Main module function
pub fn TrinetEthTop(
    // Reset input
    reset: bool
) -> TrinetEthTopOut {
    // Wire all the modules together with proper timing and control
    // PLL generates 0° and 180° clocks from 25 MHz RXC
    // ODDR forwards TXC for proper transmit timing
    // BSCANE2 provides JTAG USER3 chain for debug
    
    TrinetEthTopOut {
        // PHY interface connections
        phy_mdio: mdio.MDIO,
        phy_mdc: clk_0deg,  // MDIO clock derived from 0° clock
        phy_reset: mdio.RESET,
        phy_int: mdio.INT,
        phy_rxd: rgmii.RXD,
        phy_txd: rgmii.TXD,
        phy_rx_dv: rgmii.RX_DV,
        phy_tx_en: rgmii.TX_EN,
        phy_rxc: rxc_25m,
        phy_txc: txc_forwarded,
        
        // Status LEDs
        led_0: pll_locked,      // PLL locked indicator
        led_1: trinet_node.resp_v,  // Activity indicator
        led_2: eth_reply.tx_en,     // Transmit activity
        led_3: jtag.USER3,         // JTAG activity
        
        // JTAG interface connections
        jtag_tck: jtag.TCK,
        jtag_tdi: jtag.TDI,
        jtag_tdo: jtag_tdo,
        jtag_tms: jtag_tms,
        jtag_user3: jtag.USER3,
        
        // System status
        pll_locked: pll_locked,
        clk_0deg: clk_0deg,
        clk_180deg: clk_180deg,
        clk_125m: clk_125m
    }
}