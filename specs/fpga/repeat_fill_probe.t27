// SPDX-License-Identifier: Apache-2.0
; specs/fpga/repeat_fill_probe.t27 -- module arrays whose start values are a repeat literal (issue #12298)
; WHY. gen-verilog used to emit `var mem : [65536]u8 = [0] ** 65536;` as `reg [7:0] mem[0:65535];`
; followed by an empty `initial begin end`: the repeat was neither a list of elements nor anything else the
; initialiser knew, so no line was written. A synthesizer takes that as "power-up zero" (right for a block
; RAM) but a simulator reads `x` in every byte, so "a byte nobody wrote is 0" could not be true under vvp.
; specs/compiler/literal_text.t27 now writes the start values: one loop from FILL_LOOP_MIN (16) elements
; on, one line per element below it. This probe holds one array of each kind: `big` (loop, the count is a
; named constant), `seven` (per-element lines, a value that is not 0) and `ones` (loop, a hex value that
; Verilog needs in decimal), and `pair` (a pattern of two values, not covered: it stays unwritten). This is the FR-003 corpus case: `fpga-build --smoke` generates this file with
; the rest of specs/fpga, and the elaboration ratchet holds its row at 0.
; ASCII only, English only.

module repeat_fill_probe;

pub const KIND : str = "fpga-probe";
pub const ID : str = "fpga/repeat_fill_probe";
pub const EPIC : str = "gHashTag/t27#12298";
pub const BIG_BYTES : u32 = 4096;

var big : [BIG_BYTES]u8 = [0] ** BIG_BYTES
var seven : [8]u8 = [7] ** 8
var ones : [32]u8 = [0xFF] ** 32
var pair : [64]u8 = [1, 2] ** 32

fn poke_big(a : u32, v : u32) {
    big[a] = (v & 255) as u8;
}

fn on_clock(a : u32, v : u32) {
    poke_big(a, v);
}

; Why the checks below go through an `if`. gen-verilog-for-simulation writes `assert A == 0` as
; `if (!((A == 0))) fail`; for an unwritten byte A is `x`, so `x == 0` is `x`, the `if` is not taken and
; the test PASSES on `x`. An `if A == 0 { z = 1; }` takes its else branch on `x`, z stays 0 and the
; assert on z fails, so these tests are red on a binary that leaves the array unwritten.
test a_byte_nobody_wrote_reads_zero {
    var z0 : u32 = 0;
    var z1 : u32 = 0;
    var z2 : u32 = 0;
    var z3 : u32 = 0;
    if big[0] == 0 { z0 = 1; }
    if big[1] == 0 { z1 = 1; }
    if big[4095] == 0 { z2 = 1; }
    if big[2048] == 0 { z3 = 1; }
    assert z0 == 1;
    assert z1 == 1;
    assert z2 == 1;
    assert z3 == 1;
}

test a_stored_byte_reads_back_and_its_neighbours_stay_zero {
    var lo : u32 = 0;
    var hi : u32 = 0;
    poke_big(100, 90);
    assert big[100] == 90;
    if big[99] == 0 { lo = 1; }
    if big[101] == 0 { hi = 1; }
    assert lo == 1;
    assert hi == 1;
}

test a_short_repeat_fills_every_element {
    var a : u32 = 0;
    var b : u32 = 0;
    var c : u32 = 0;
    if seven[0] == 7 { a = 1; }
    if seven[3] == 7 { b = 1; }
    if seven[7] == 7 { c = 1; }
    assert a == 1;
    assert b == 1;
    assert c == 1;
}

; A pattern that lists two values is not covered (literal_text.t27 says so): it writes no start value. What it
; must never do is write the FIRST value into every element. Odd elements hold 2 (Zig, the test runner) or
; `x` (the simulator): neither is 1, so `hit` stays 0; a fill with 1 would make it 1 and fail the assert.
test a_two_value_pattern_is_not_filled_with_its_first_value {
    var hit : u32 = 0;
    if pair[1] == 1 { hit = 1; }
    if pair[5] == 1 { hit = 1; }
    if pair[63] == 1 { hit = 1; }
    assert hit == 0;
}

test a_hex_value_is_written_in_decimal {
    var a : u32 = 0;
    var b : u32 = 0;
    var c : u32 = 0;
    if ones[0] == 255 { a = 1; }
    if ones[16] == 255 { b = 1; }
    if ones[31] == 255 { c = 1; }
    assert a == 1;
    assert b == 1;
    assert c == 1;
}
