    pub const MAC_OPEN_4B_LCS : usize = 11
    pub const MAC_OPEN_4B_FFS : usize = 16
    pub const MAC_OPEN_8B_LCS : usize = 35
    pub const MAC_OPEN_8B_FFS : usize = 24
    pub const MAC_OPEN_16B_LCS : usize = 79
    pub const MAC_OPEN_16B_FFS : usize = 36
    pub const MAC_OPEN_32B_LCS : usize = 139
    pub const MAC_OPEN_32B_FFS : usize = 48

