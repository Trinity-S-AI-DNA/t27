;  =========================================================================
;  JOINT SWEEP (evidence/attention_joint/)
;  =========================================================================

    pub const ATTN_JOINT_HEAD_DIM : usize = 8
    pub const ATTN_JOINT_KV_LEN : usize = 16
    pub const ATTN_JOINT_QUANT_W_LIST : [3]usize = [4, 6, 8]
    pub const ATTN_JOINT_ACT_BITS_LIST : [3]usize = [4, 6, 8]
