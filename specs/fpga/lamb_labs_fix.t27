// SPDX-License-Identifier: Apache-2.0
; specs/fpga/lamb_labs.t27 — lamb-labs "и все остаrement" co-design portfolio spec
; Specification-first description of the ALINX AX7203 / xc7a200tfbg484-2 ternary transformer inference portfolio.
; Every number is labelled MEASURED/ESTIMATED/TARGET/SUSPECT; every measured number has a hashed artifact.
; This spec IS the single source of truth; generated JSON and per-param tables are DERIVED.
;
; PHYSICAL CONSTRAINTS (no board connected locally):
;   - CFGMCLK MEASURED at 67.16 MHz (σ 1.33, n=9); R4/T4 SUSPECT (398.3 MHz withdrawn claim;
;     measurement disclaims publication per r4t4_measurement.log); 200 MHz documented record stays below.
;   - openXC7 cannot route the attention design (LUT6 packing + carry-chain splitting).
;   - XADC has no current sensor — J/token is a KNOWN GAP (requires external meter).
;   - Zero-DSP invariant: all measured MAC configurations must have dsp48e1 = 0.
; phi^2 + 1/phi^2 = 3 | TRINITY

module LambLabsPortfolio {

;  =========================================================================
;  DEVICE DEFINITION (from HARDWARE_SSOT.md and measured evidence)
;  =========================================================================

    pub struct Board {
        name : &str,
        part : &str,
        luts : usize,
        ff : usize,
        bram_36k : usize,
        dsp48e1 : usize,
    }

    pub const BOARD : Board = {
        .name = "ALINX AX7203",
        .part = "xc7a200tfbg484-2",
        .luts = 134600,
        .ff = 269200,
        .bram_36k = 365,
        .dsp48e1 = 740,
    }

;  =========================================================================
;  MEASURED BOARD CLOCKS (evidence/clock_probe/)
;  =========================================================================

    pub struct ClockResult {
        measured_mhz : f64,
        median_mhz : f64,
        stddev_mhz : f64,
        n : usize,
    }

    pub const CFGMCLK : ClockResult = {
        .measured_mhz = 67.16,
        .median_mhz = 67.39,
        .stddev_mhz = 1.33,
        .n = 9,
    }

;  R4/T4 oscillator: SUSPECT (398.3 MHz withdrawn claim, measurement disclaims publication)
    pub const R4T4 : ClockResult = {
        .measured_mhz = 398.3,
        .median_mhz = 0.0,
        .stddev_mhz = 0.0,
        .n = 0,
    }
;  200 MHz documented record below; cause UNKNOWN; about 2× 200 MHz; Johnson divide ratio 256 CONFIRMED

;  =========================================================================
;  TERNARY MAC ACCUMULATOR SWEEP (evidence/codesign/)
;  =========================================================================

    pub struct MacConfig {
        acc_bits : usize,
        topology : &str,  // "open" or "closed"
    }

    pub const MAC_ACC_BITS_LIST : [4]usize = [4, 8, 16, 32]
    pub const MAC_LOOP_TOPOLOGIES : [2]&str = ["open", "closed"]

