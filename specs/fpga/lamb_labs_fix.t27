    pub const MAC_CLOSED_32B_FFS : usize = 56

;  =========================================================================
;  COMBINATIONAL ATTENTION (REJECTED - evidence/attention/)
;  =========================================================================

;  HEAD_DIM=8, KV_LEN=16, QUANT_W=8: 28,619 LCs = 21.3% of fabric → REJECTED
    pub const ATTN_COMB_REJECTED_LCS : usize = 28619
    pub const ATTN_COMB_REJECTED_PCT : f64 = 21.3
    pub const ATTN_COMB_STATUS : &str = "REJECTED"

;  =========================================================================
;  SEQUENTIAL ATTENTION KV CACHE (evidence/attention_fix/)
;  =========================================================================

    pub struct AttnSeqKVCache {
        distram_lcs : usize,
