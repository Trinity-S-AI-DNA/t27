    OpRow{ .name = "i32.load16", .byte = 0x2E, .gen = 2, .width = W_I32, .family = FAM_MEM, .op = OK_NA, .sgn = SG_PAIR, .interp_ok = false, .doom = true },
    OpRow{ .name = "i64.load8", .byte = 0x30, .gen = 2, .width = W_I64, .family = FAM_MEM, .op = OK_NA, .sgn = SG_PAIR, .interp_ok = false, .doom = true },
    OpRow{ .name = "i64.load16", .byte = 0x32, .gen = 2, .width = W_I64, .family = FAM_MEM, .op = OK_NA, .sgn = SG_PAIR, .interp_ok = false, .doom = true },
    OpRow{ .name = "i64.load32", .byte = 0x34, .gen = 2, .width = W_I64, .family = FAM_MEM, .op = OK_NA, .sgn = SG_PAIR, .interp_ok = false, .doom = true },
    OpRow{ .name = "i32.store", .byte = 0x36, .gen = 1, .width = W_I32, .family = FAM_MEM, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = true },
