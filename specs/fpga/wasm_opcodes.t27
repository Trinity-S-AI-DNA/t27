// SPDX-License-Identifier: Apache-2.0
; specs/fpga/wasm_opcodes.t27 -- THE SEMANTIC TABLE LAW of the WASM MVP opcode set,
; as one spec. This file answers one question: can the whole opcode surface of a
; real binary ISA live in ONE table, from which every consumer is GENERATED and
; whose completeness is PROVEN by a coverage law, inside executable t27? Nothing
; here is hand-written per opcode: the rows below are the single source of truth,
; and the three consumers -- the interpreter's dispatch, the decoder's byte map
; and the Verilog ALU case list -- are pure functions over those rows, checked by
; the tests at the bottom. Companion to specs/fpga/wasm_interp.t27, which is the
; executor this table serves.
; ----
; WHY. The opcodes are generated, never hand-written; one table, three consumers;
; the coverage law pins completeness. A hand-maintained opcode list drifts: the
; interpreter learns an op and the decoder forgets it, or the Verilog ALU grows a
; case the decoder never maps. This table makes that drift a FAILING TEST instead
; of a silent gap. Every consumer reads the same rows, so a row added once
; appears in all three places or the count law catches the miss. The rows for the
; interpreter's live subset cross-check byte for byte against wasm_interp.t27's
; own OP_ constants, imported here through `use` -- the two-table cross-check
; pattern that file uses for its pinned bytes, applied across two files.
; ----
; THE SHAPE OF A ROW. One row per DISTINCT semantic point, parameterized:
;   name        the WASM text name of the semantic point
;   byte        the FIRST MVP binary opcode byte the row generates (base)
;   gen         how many opcode bytes it generates: 1, or 2 for an SG_PAIR row
;   width       W_NONE (no operand width: control, locals), W_I32, W_I64, W_F32, W_F64
;   family      control, parametric, variable, memory, const, relational,
;               bitcount, arithmetic, bitwise, shift, conversion
;   op          the semantic operation (OK_*), the field the ALU consumer lowers
;   sgn         SG_NONE, SG_SIGNED, SG_UNSIGNED, or SG_PAIR
;   interp_ok   true exactly for the opcodes the LIVE interpreter implements
;   doom        true for the opcodes a DOOM-class port needs on its critical path
; An SG_PAIR row is one semantic point with a signedness parameter whose two
; readings the MVP encodes as adjacent bytes: i32.lt is ONE point, signed first,
; generating 0x48 (lt_s) and 0x49 (lt_u) from base and base+1. The signed member
; is always the base byte, and the interpreter serves exactly the signed member
; of every pair it implements (lt_s, gt_s, le_s, ge_s, shr_s -- never the
; unsigned twin); the table turns that fact into a law the dispatch test checks.
; ----
; THE COUNTS, derived from the table and pinned here -- never quoted from memory:
;   rows                     149
;   SG_PAIR rows              28   (each generates one extra byte)
;   generated opcodes        177   = 149 + 28
;   interp-supported rows     23   (the ACTUAL handled set of wasm_interp.t27:
;                               its 23 pub OP_ constants; note the founding
;                               task said "~20", the live file says 23, and
;                               the table matches the file, not the guess)
;   supported-row opcodes     28   (the 23 dispatch bytes PLUS the 5 unsigned
;                               twins of the supported pairs -- lt_u gt_u
;                               le_u ge_u shr_u -- which the interpreter
;                               does NOT execute: one semantic point, two
;                               bytes, one of them future)
;   FUTURE rows              126   (149 - 23)
;   FUTURE-row opcodes       149   (177 - 28; opcodes generated by FUTURE rows)
;   dispatch-less opcodes    154   (177 - 23: every byte with no dispatch case)
;   float-width rows          54   (W_F32/W_F64; all FUTURE; counted SEPARATELY;
;                               includes the six conversions whose RESULT width
;                               is float: convert x2, demote, promote, plus the
;                               two float reinterprets; 0xBE/0xBF stay
;                               integer-width by result width)
;   float-width opcodes       58   (54 rows + the four convert s/u pairs)
;   decoder mapped bytes     177   (every generated byte, claimed exactly once)
;   decoder reserved bytes    79   (256 - 177; the holes are pinned by test)
;   Verilog ALU cases         58   (i32+i64 rows of the five ALU families)
;   DOOM-critical FUTURE      23 rows / 28 bytes (the named set, asserted by name)
; ----
; THE PROVENANCE OF THE BYTES. WebAssembly 1.0 core instruction table, final
; encodings: control 0x00-0x11, parametric 0x1A-0x1B, variable 0x20-0x24, memory
; 0x28-0x40, const 0x41-0x44, i32 relations 0x45-0x4F, i64 relations 0x50-0x5A,
; f32 relations 0x5B-0x60, f64 relations 0x61-0x66, i32 numeric 0x67-0x78, i64
; numeric 0x79-0x8A, f32 numeric 0x8B-0x98, f64 numeric 0x99-0xA6, conversions
; 0xA7-0xBF, and the sign-extension window 0xC0-0xC4 (extend8/16/32: allocated
; inside the original MVP opcode map by the sign-extension proposal; the decoder
; must not hand those bytes to the reserved pool, so the law counts them).
; Unassigned in Wasm 1.0 and pinned as reserved: 0x06-0x0A, 0x12-0x19, 0x1C-0x1F,
; 0x25-0x27, 0xC5-0xFB. The bytes 0xFC-0xFE are PREFIX bytes of post-MVP spaces
; (0xFC saturating truncations, 0xFD SIMD, 0xFE atomics) and 0xFF is unassigned;
; none of them decodes in the MVP and all four are pinned unmapped.
; ----
; THE THREE CONSUMERS, each one pure function over ROWS:
;   interp_dispatch_cases()  the dispatch cases the interpreter's dispatch loop
;                            must carry: the base byte of every interp_ok row,
;                            in table (byte) order -- asserted equal, byte for
;                            byte, to wasm_interp.t27's 23 OP_ constants.
;   decoder_entries()        the full 256-byte map: byte -> generating row,
;                            0 = reserved. Completeness is the law: mapped +
;                            reserved = 256, no third state, no byte claimed
;                            twice, every mapped byte inside its row's range.
;   verilog_alu_cases()      the ALU case list for the Verilog lowering: one
;                            case per generated opcode of the five ALU families
;                            (relational, bitcount, arithmetic, bitwise, shift)
;                            at i32/i64 width, each carrying byte, width, op and
;                            the signedness reading that byte selects. Every case
;                            round-trips through the decoder map back to its row.
;   future_doom_critical()   the audit and the roadmap: the FUTURE rows marked
;                            doom, ordered by implementation rank (branches,
;                            then memory, then call, then wrap), straight out of
;                            the same rows -- the ordered path from the current
;                            23-opcode interpreter to a DOOM-class subset.
; ----
; THE ALU SEMANTICS HAVE ONE HOME, AND IT IS THE BOARD CELL (issue #12011). For the
; pure ALU points this file ships an evaluator, eval_byte(), and it holds no ALU
; algorithm of its own: it calls alu_arity() and alu_eval() of
; specs/fpga/wasm_board_ax7203.t27 -- the very bodies that cell's tick executes -- so
; the oracle and the cell cannot differ. Why the cell and not this file: t27c
; gen-verilog imports only enums and structs from a `use`d module, never a function
; body, while the test runners splice the bodies of a `use`d module; the bodies the
; hardware needs therefore live in the spec that generates the hardware, and this
; file `use`s that spec. The interpreter's own oracle vectors are replayed
; through it, and the signedness law is pinned on the pairs: the two bytes of one
; row give DIFFERENT answers on the same bits (-1 <s 0 holds, -1 <u 0 fails;
;  0x80000000 >>s 1 fills ones, >>u 1 clears them). Tests pin that every byte the
; cell executes as a single-clock ALU opcode (24 of its 45) is a generated byte of
; a row of the same operation kind. i32.mul keeps its closed form here (the cell
; runs it as a 32-clock sequence). FUTURE rows that are not
; pure ALU (div/rem, every float and conversion row, every i64 row) are pinned by
; classification only: byte, width, family, signedness -- their arithmetic is their
; consumer's, and this file claims no executable semantics for them.
; ----
; NOT CLAIMED. No f32/f64 execution -- the 48 float-width rows are FUTURE and
; counted separately, exactly because the interpreter has no float datapath. No
; memory model -- load/store rows carry no addresses, no bounds, no endianness;
; the memory SEMANTICS are the board epic's, not this table's. No block/loop/br
; execution, no call frames -- the rows are pinned, the label and frame stacks
; are the roadmap's work. No DOOM -- "doom_relevant" is an honest reading of
; what a WASM-4/DOOM-class port needs on its spine (memory, calls, branches,
; wraps), not a claim that any of this runs DOOM. No synthesis, no speed, no
; board: this file is a table law, and wasm_interp.t27 remains the only executor.
; ASCII only, English only.

module fpga_wasm_opcodes;

; --- the live interpreter, cross-checked at run time (two-table cross-check):
; its 23 OP_ constants, its loader lengths and two program ids. Imported WHOLE and
; read through the qualifier (wasm_interp::prog_len, ...): the board cell below declares
; a prog_len, a PROGS and an ID_ADD_DOUBLE of its own, and a bare name that two imported
; modules declare differently is refused by the resolver. The OP_ constants are the same
; line in both modules, so those stay bare.
use fpga::wasm_interp;

; --- the board cell: the one home of the single-clock i32 ALU bodies (issue #12011).
; eval_byte() calls its alu_arity() and alu_eval(); the cell's own tick calls the same two.
use fpga::wasm_board_ax7203;

; --- width codes
pub const W_NONE : u8 = 0;
pub const W_I32 : u8 = 1;
pub const W_I64 : u8 = 2;
pub const W_F32 : u8 = 3;
pub const W_F64 : u8 = 4;

; --- family codes
pub const FAM_CTRL : u8 = 0;
pub const FAM_PARAM : u8 = 1;
pub const FAM_VAR : u8 = 2;
pub const FAM_MEM : u8 = 3;
pub const FAM_CONST : u8 = 4;
pub const FAM_REL : u8 = 5;
pub const FAM_COUNT : u8 = 6;
pub const FAM_ARITH : u8 = 7;
pub const FAM_BITS : u8 = 8;
pub const FAM_SHIFT : u8 = 9;
pub const FAM_CONV : u8 = 10;

; --- signedness codes. SG_PAIR: the row generates the signed base byte AND the
; unsigned twin at base+1; one semantic point, two encodings.
pub const SG_NONE : u8 = 0;
pub const SG_SIGNED : u8 = 1;
pub const SG_UNSIGNED : u8 = 2;
pub const SG_PAIR : u8 = 3;

; --- semantic operation codes (the field the ALU consumer lowers)
pub const OK_NA : u8 = 0;
pub const OK_EQZ : u8 = 1;
pub const OK_EQ : u8 = 2;
pub const OK_NE : u8 = 3;
pub const OK_LT : u8 = 4;
pub const OK_GT : u8 = 5;
pub const OK_LE : u8 = 6;
pub const OK_GE : u8 = 7;
pub const OK_ADD : u8 = 8;
pub const OK_SUB : u8 = 9;
pub const OK_MUL : u8 = 10;
pub const OK_DIV : u8 = 11;
pub const OK_REM : u8 = 12;
pub const OK_AND : u8 = 13;
pub const OK_OR : u8 = 14;
pub const OK_XOR : u8 = 15;
pub const OK_SHL : u8 = 16;
pub const OK_SHR : u8 = 17;
pub const OK_ROTL : u8 = 18;
pub const OK_ROTR : u8 = 19;
pub const OK_CLZ : u8 = 20;
pub const OK_CTZ : u8 = 21;
pub const OK_POPCNT : u8 = 22;
pub const OK_ABS : u8 = 23;
pub const OK_NEG : u8 = 24;
pub const OK_CEIL : u8 = 25;
pub const OK_FLOOR : u8 = 26;
pub const OK_FTRUNC : u8 = 27;
pub const OK_NEAREST : u8 = 28;
pub const OK_SQRT : u8 = 29;
pub const OK_MIN : u8 = 30;
pub const OK_MAX : u8 = 31;
pub const OK_COPYSIGN : u8 = 32;

; --- THE TABLE. 149 rows, byte order, the MVP core instruction set.
pub struct OpRow {
    name : &str,
    byte : u8,
    gen : u8,
    width : u8,
    family : u8,
    op : u8,
    sgn : u8,
    interp_ok : bool,
    doom : bool,
}

pub const ROW_N : u32 = 149;

pub const ROWS : [ROW_N]OpRow = [
    OpRow{ .name = "unreachable", .byte = 0x00, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "nop", .byte = 0x01, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "block", .byte = 0x02, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "loop", .byte = 0x03, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = true },
    OpRow{ .name = "if", .byte = 0x04, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = true, .doom = true },
    OpRow{ .name = "else", .byte = 0x05, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = true, .doom = true },
    OpRow{ .name = "end", .byte = 0x0B, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = true, .doom = true },
    OpRow{ .name = "br", .byte = 0x0C, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = true },
    OpRow{ .name = "br_if", .byte = 0x0D, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = true },
    OpRow{ .name = "br_table", .byte = 0x0E, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "return", .byte = 0x0F, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = true, .doom = true },
    OpRow{ .name = "call", .byte = 0x10, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = true },
    OpRow{ .name = "call_indirect", .byte = 0x11, .gen = 1, .width = W_NONE, .family = FAM_CTRL, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "drop", .byte = 0x1A, .gen = 1, .width = W_NONE, .family = FAM_PARAM, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "select", .byte = 0x1B, .gen = 1, .width = W_NONE, .family = FAM_PARAM, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "local.get", .byte = 0x20, .gen = 1, .width = W_NONE, .family = FAM_VAR, .op = OK_NA, .sgn = SG_NONE, .interp_ok = true, .doom = true },
    OpRow{ .name = "local.set", .byte = 0x21, .gen = 1, .width = W_NONE, .family = FAM_VAR, .op = OK_NA, .sgn = SG_NONE, .interp_ok = true, .doom = true },
    OpRow{ .name = "local.tee", .byte = 0x22, .gen = 1, .width = W_NONE, .family = FAM_VAR, .op = OK_NA, .sgn = SG_NONE, .interp_ok = true, .doom = true },
    OpRow{ .name = "global.get", .byte = 0x23, .gen = 1, .width = W_NONE, .family = FAM_VAR, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "global.set", .byte = 0x24, .gen = 1, .width = W_NONE, .family = FAM_VAR, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = false },
    OpRow{ .name = "i32.load", .byte = 0x28, .gen = 1, .width = W_I32, .family = FAM_MEM, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = true },
    OpRow{ .name = "i64.load", .byte = 0x29, .gen = 1, .width = W_I64, .family = FAM_MEM, .op = OK_NA, .sgn = SG_NONE, .interp_ok = false, .doom = true },
