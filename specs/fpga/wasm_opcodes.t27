    OpRow{ .name = "i64.le", .byte = 0x57, .gen = 2, .width = W_I64, .family = FAM_REL, .op = OK_LE, .sgn = SG_PAIR, .interp_ok = false, .doom = false },
    OpRow{ .name = "i64.ge", .byte = 0x59, .gen = 2, .width = W_I64, .family = FAM_REL, .op = OK_GE, .sgn = SG_PAIR, .interp_ok = false, .doom = false },
    OpRow{ .name = "f32.eq", .byte = 0x5B, .gen = 1, .width = W_F32, .family = FAM_REL, .op = OK_EQ, .sgn = SG_NONE, .interp_ok = false, .doom = false },
