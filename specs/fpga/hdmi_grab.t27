// SPDX-License-Identifier: Apache-2.0
; specs/fpga/hdmi_grab.t27 -- the ffmpeg command line that grabs one frame of the AX7203 HDMI out (#11033, epic #10782).
; The board's HDMI is wired to this Mac through a USB capture dongle. The grab itself is an existing tool (ffmpeg with
; the avfoundation input); this spec is the pure function that decides what to run: from the text of ffmpeg's device
; list (ffmpeg -f avfoundation -list_devices true -i "") plus the size and frame rate, it yields the command line and
; the output file name, or the named result "no device" and no command.
; Device pick: in the "AVFoundation video devices" section, the first device whose name has none of FaceTime, OBS
; Virtual, Capture screen, iPhone. The audio section is never read. Nothing else lives here: ffmpeg is plumbing.
; NOT established: that the dongle is a UVC capture device (macOS listed none on 2026-10-19). ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaHdmiGrab;

pub const R_OK : u32 = 0;
pub const R_NO_DEVICE : u32 = 1;

pub const OUT_FILE : []const u8 = "/tmp/hdmi_grab.png";

pub fn hg_is_digit(c: u8) -> bool {
    return c >= '0' and c <= '9';
}

/// Does s[a..b] contain the fixed text nd.
pub fn hg_has(s: []const u8, a: usize, b: usize, nd: []const u8) -> bool {
    const k : usize = nd.len;
    if (k == 0 or b < a + k) { return false; }
    var i : usize = a;
    while (i + k <= b) {
        var j : usize = 0;
        var same : bool = true;
        while (j < k) {
            if (s[i + j] != nd[j]) { same = false; }
            j += 1;
        }
        if (same) { return true; }
        i += 1;
    }
    return false;
}

/// The ']' that closes the last "[digits]" in the line s[a..b]; b when the line has none.
pub fn hg_br_end(s: []const u8, a: usize, b: usize) -> usize {
    var last : usize = b;
    var i : usize = a;
    while (i < b) {
        if (s[i] == '[') {
            var j : usize = i + 1;
            while (j < b and hg_is_digit(s[j])) { j += 1; }
            if (j > i + 1 and j < b and s[j] == ']') { last = j; }
        }
        i += 1;
    }
    return last;
}

/// The number inside the "[digits]" that ends at e.
pub fn hg_br_val(s: []const u8, a: usize, e: usize) -> i32 {
    var v : i32 = 0;
    var m : i32 = 1;
    var j : usize = e;
    while (j > a and hg_is_digit(s[j - 1])) {
        v = v + m * @as(i32, @intCast(s[j - 1] - '0'));
        m = m * 10;
        j -= 1;
    }
    return v;
}

/// A name that is never the board's capture device.
pub fn hg_excluded(s: []const u8, a: usize, b: usize) -> bool {
    if (hg_has(s, a, b, "FaceTime")) { return true; }
    if (hg_has(s, a, b, "OBS Virtual")) { return true; }
    if (hg_has(s, a, b, "Capture screen")) { return true; }
    if (hg_has(s, a, b, "iPhone")) { return true; }
    return false;
}

/// The index of the first video device that is not excluded in the list s[0..len]; -1 when there is none.
pub fn hg_pick(s: []const u8, len: usize) -> i32 {
    var in_video : bool = false;
    var ls : usize = 0;
    var i : usize = 0;
    while (i <= len) {
        if (i == len or s[i] == '\n') {
            if (hg_has(s, ls, i, "AVFoundation video devices")) {
                in_video = true;
            } else if (hg_has(s, ls, i, "AVFoundation audio devices")) {
                in_video = false;
            } else if (in_video) {
                const e : usize = hg_br_end(s, ls, i);
                if (e < i and hg_excluded(s, e + 1, i) == false) { return hg_br_val(s, ls, e); }
            }
            ls = i + 1;
        }
        i += 1;
    }
    return -1;
}

/// The result: R_OK when a capture device is listed, R_NO_DEVICE otherwise.
pub fn hg_result(s: []const u8, len: usize) -> u32 {
    if (hg_pick(s, len) < 0) { return R_NO_DEVICE; }
    return R_OK;
}

/// Copy the fixed text s into out at w; the new write position.
pub fn hg_cat(out: []u8, w: usize, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len) {
        out[w + i] = s[i];
        i += 1;
    }
    return w + s.len;
}

/// Write the decimal digits of v into out at p; the new write position.
pub fn hg_put_num(out: []u8, p: usize, v: usize) -> usize {
    var digits : usize = 1;
    var t : usize = v;
    while (t >= 10) {
        digits += 1;
        t = t / 10;
    }
    var k : usize = digits;
    t = v;
    while (k > 0) {
        out[p + k - 1] = @as(u8, @intCast(t % 10)) + '0';
        t = t / 10;
        k -= 1;
    }
    return p + digits;
}

/// The command line for one frame, written into out; its length. 0 when no capture device is listed (no command).
pub fn hg_cmd(out: []u8, s: []const u8, len: usize, w: usize, h: usize, fps: usize) -> usize {
    const dev : i32 = hg_pick(s, len);
    if (dev < 0) { return 0; }
    var p : usize = hg_cat(out, 0, "ffmpeg -y -f avfoundation -framerate ");
    p = hg_put_num(out, p, fps);
    p = hg_cat(out, p, " -video_size ");
    p = hg_put_num(out, p, w);
    p = hg_cat(out, p, "x");
    p = hg_put_num(out, p, h);
    p = hg_cat(out, p, " -i ");
    p = hg_put_num(out, p, @as(usize, @intCast(dev)));
    p = hg_cat(out, p, ":none -frames:v 1 ");
    p = hg_cat(out, p, OUT_FILE);
    return p;
}

/// Do out[0..n] hold exactly the text want.
pub fn hg_same(out: []const u8, n: usize, want: []const u8) -> bool {
    if (n != want.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (out[i] != want[i]) { return false; }
        i += 1;
    }
    return true;
}

test "a_listed_dongle_yields_one_frame_command" {
    const list : []const u8 = "[AVFoundation indev @ 0x1] AVFoundation video devices:\n[AVFoundation indev @ 0x1] [0] FaceTime HD Camera\n[AVFoundation indev @ 0x1] [1] USB3.0 Capture\n[AVFoundation indev @ 0x1] [2] Capture screen 0\n[AVFoundation indev @ 0x1] AVFoundation audio devices:\n[AVFoundation indev @ 0x1] [0] USB3.0 Audio\n";
    var out : [256]u8 = undefined;
    const n : usize = hg_cmd(out[0..], list, list.len, 640, 480, 30);
    assert hg_pick(list, list.len) == 1;
    assert hg_result(list, list.len) == R_OK;
    assert hg_same(out[0..], n, "ffmpeg -y -f avfoundation -framerate 30 -video_size 640x480 -i 1:none -frames:v 1 /tmp/hdmi_grab.png");
}

test "no_capture_device_yields_the_named_result_and_no_command" {
    const list : []const u8 = "[AVFoundation indev @ 0x1] AVFoundation video devices:\n[AVFoundation indev @ 0x1] [0] FaceTime HD Camera\n[AVFoundation indev @ 0x1] [1] OBS Virtual Camera\n[AVFoundation indev @ 0x1] [2] Capture screen 0\n[AVFoundation indev @ 0x1] AVFoundation audio devices:\n[AVFoundation indev @ 0x1] [0] MacBook Pro Microphone\n";
    var out : [256]u8 = undefined;
    assert hg_pick(list, list.len) == 0 - 1;
    assert hg_result(list, list.len) == R_NO_DEVICE;
    assert hg_cmd(out[0..], list, list.len, 640, 480, 30) == 0;
}

test "the_audio_section_is_never_read" {
    const list : []const u8 = "AVFoundation video devices:\n[0] FaceTime HD Camera\nAVFoundation audio devices:\n[0] USB3.0 Audio\n";
    assert hg_pick(list, list.len) == 0 - 1;
    assert hg_result("", 0) == R_NO_DEVICE;
}

test "size_and_rate_reach_the_command_line" {
    const list : []const u8 = "AVFoundation video devices:\n[12] Dongle\n";
    var out : [256]u8 = undefined;
    const n : usize = hg_cmd(out[0..], list, list.len, 1920, 1080, 60);
    assert hg_same(out[0..], n, "ffmpeg -y -f avfoundation -framerate 60 -video_size 1920x1080 -i 12:none -frames:v 1 /tmp/hdmi_grab.png");
}
