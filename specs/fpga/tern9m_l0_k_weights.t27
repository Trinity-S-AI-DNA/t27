/// Word i of the tensor with byte `flip` (counted over the whole tensor) read as `to`.
pub fn word_with(i: u32, flip: u32, to: u8) -> u64 {
    var w : u64 = W[i];
    var out : u64 = 0;
    var j : u32 = 0;
    while (j < 8) {
        var b : u64 = w & 255;
        if (i * 8 + j == flip) { b = to as u64; }
        out = (out >> 8) | (b << 56);
        w = w >> 8;
        j = j + 1;
    }
    return out;
}

/// The write checksum S the board folds while it packs the upload.
pub fn s_of(flip: u32, to: u8) -> u64 {
    var s : u64 = 0;
    var i : u32 = 0;
    while (i < W_BEATS) {
        s = fold_beat(s, word_with(4 * i, flip, to), word_with(4 * i + 1, flip, to), word_with(4 * i + 2, flip, to), word_with(4 * i + 3, flip, to));
        i = i + 1;
    }
    return s;
}

/// The output checksum Y: each row's wrapping sum of trit_term over its 320 columns, folded row by row.
/// `ff_plus` computes instead what the mutant board computes, which reads the trit FF as +1.
pub fn y_of(ff_plus: bool, flip: u32, to: u8) -> u64 {
    var y : u64 = 0;
    var acc : u32 = 0;
    var xv : u8 = XV0;
    var col : u32 = 0;
    var i : u32 = 0;
    while (i < W_WORDS) {
        var w : u64 = word_with(i, flip, to);
        var j : u32 = 0;
        while (j < 8) {
            const b : u8 = (w & 255) as u8;
            if (ff_plus and b == 255) {
                acc = acc +% sext8(xv);
            } else {
                acc = acc +% trit_term(b, xv);
            }
            xv = xv +% XSTEP;
            col = col + 1;
            if (col == W_COLS) {
                y = fold_beat(y, acc as u64, 0, 0, 0);
                acc = 0;
                col = 0;
                xv = XV0;
            }
            w = w >> 8;
            j = j + 1;
        }
        i = i + 1;
    }
    return y;
}

test the_words_are_the_tensor_and_every_byte_is_a_trit {
    assert_eq((W_WORDS as u64) * 8, W_BYTES);
    assert_eq(W_WORDS, 4 * W_BEATS);
    assert_eq(W[0], 0x00010001ffff00ff);
    var zeros : u32 = 0;
    var ones : u32 = 0;
    var minus : u32 = 0;
    var other : u32 = 0;
    var i : u32 = 0;
    while (i < W_WORDS) {
        var w : u64 = W[i];
        var j : u32 = 0;
        while (j < 8) {
            const b : u64 = w & 255;
            if (b == 0) {
                zeros = zeros + 1;
            } else if (b == 1) {
                ones = ones + 1;
            } else if (b == 255) {
                minus = minus + 1;
            } else {
                other = other + 1;
            }
            w = w >> 8;
            j = j + 1;
        }
        i = i + 1;
    }
    assert_eq(zeros, 8461);
    assert_eq(ones, 5983);
    assert_eq(minus, 6036);
    assert_eq(other, 0);
}

test s_expect_is_the_fold_of_the_640_pinned_beats {
    assert_eq(word_with(0, NO_FLIP, 0), W[0]);
    assert_eq(word_with(0, 0, 1), 0x00010001ffff0001);
    assert_eq(s_of(NO_FLIP, 0), S_EXPECT);
}

test y_expect_is_the_product_of_the_pinned_rows {
    assert_eq(y_of(false, NO_FLIP, 0), Y_EXPECT);
}

test the_mutant_that_reads_ff_as_plus_one_misses_y {
    assert y_of(true, NO_FLIP, 0) != Y_EXPECT;
    assert_eq(y_of(true, NO_FLIP, 0), Y_MUT_FF);
}

test one_changed_byte_changes_s_and_y {
    assert s_of(0, 1) != S_EXPECT;
    assert y_of(false, 0, 1) != Y_EXPECT;
    assert_eq(s_of(0, 1), S_FLIP0);
    assert_eq(y_of(false, 0, 1), Y_FLIP0);
    assert_eq(s_of(0, 255), S_EXPECT);
    assert_eq(y_of(false, 0, 255), Y_EXPECT);
}
