// SPDX-License-Identifier: Apache-2.0
; specs/fpga/tern9m_l0_k_weights.t27 -- the weights of cell 26: blocks.0.attn.k.weight of tern-tc-9m
; The data of specs/fpga/ddr3_ternary_matvec.t27 (issue gHashTag/t27#10461, epic gHashTag/t27#10024), and the
; tests that compute from it the two values the board must report, with the board spec's own functions.
; -
; SOURCE. c_infer/model.bin of Hugging Face playra/tern-tc-9m, 16,953,800 bytes, sha256
; 3102abdf35057924e077a86db4fdac726e4fe1f6574df47f39a638ba99a3ce9c. The tensor is 64 rows of 320 int8 trits,
; row-major, 20,480 bytes at offset 10,589,476; the f32 scale after it is not used.
; MADE WITH. `od -An -v -tx8 -j 10589476 -N 20480 model.bin`, one 32-byte beat per line, each word little-endian
; (byte 0 of the beat is the low byte of its first word). Nothing here was typed in by hand.
; THE UPLOAD. The same bytes, in the same order, are what the host sends to the board:
; `dd if=model.bin bs=1 skip=10589476 count=20480`.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaTern9mL0KWeights;

use fpga::ddr3_ternary_matvec;
use fpga::board_receipt;

pub const W_WORDS : u32 = 2560;
/// No byte changed (an index past the 20,480 bytes).
pub const NO_FLIP : u32 = 99999999;
/// The two FAIL receipts the negative controls must print, read off this spec's own failing `assert_eq`
/// run with 0 in their place (as S_EXPECT and Y_EXPECT were), not copied from the board. S_FLIP0 and Y_FLIP0
/// were read before their board run; Y_MUT_FF after the mutant board had printed it, and it equals that receipt.
/// Y of the mutant board (FF read as +1) on the real bytes; its S is S_EXPECT.
pub const Y_MUT_FF : u64 = 0x3E5E6C8ED51DF5C8;
/// S and Y of the real board on the bytes with byte 0 changed from FF to 01.
pub const S_FLIP0 : u64 = 0x4B58160720ABB81C;
pub const Y_FLIP0 : u64 = 0x9A50D884522C2320;

