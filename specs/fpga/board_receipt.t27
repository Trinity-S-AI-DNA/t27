// SPDX-License-Identifier: Apache-2.0
; specs/fpga/board_receipt.t27 -- the pieces of a board's UART receipt that every AX7203 board spec shares
; The board specs specs/fpga/rc_filter_ax7203.t27, specs/fpga/ddr3_head_bandwidth.t27 and
; specs/fpga/ddr3_ternary_matvec.t27 each print one receipt line on the UART; the two DDR3 ones also fold
; 256-bit beats into a checksum. These are the bodies they had each written for themselves
; (tools/dupe_scan.py): one home, used by each.
; -
; Pure functions only: no pins, no `pub var`, no on_clock, and no name a board spec also defines, so a `use`
; of this module adds nothing to a board's netlist but the functions it calls (`t27b verilog` emits them
; after the board's own; checked against the netlists from before the move).
; A verdict of 0 is PASS in every board spec (each one's V_PASS); any other verdict that reaches
; pass_fail_char prints FAIL. ddr3_head_bandwidth's SLOW and KILL lines keep their own verdict_char.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaBoardReceipt;

/// The checksum after one more 256-bit beat: rotate the sum left by one, then xor in the four lanes, lane
/// k rotated left by 16 * k.
pub fn fold(sum: u64, l0: u64, l1: u64, l2: u64, l3: u64) -> u64 {
    return ((sum << 1) | (sum >> 63)) ^ l0 ^ ((l1 << 16) | (l1 >> 48)) ^ ((l2 << 32) | (l2 >> 32)) ^ ((l3 << 48) | (l3 >> 16));
}

/// The ASCII digit of a nibble, 0-9 A-F.
pub fn hex_digit(n: u8) -> u8 {
    if ((n & 15) < 10) { return 48 + (n & 15); }
    return 55 + (n & 15);
}

/// Character p of " PASS\r\n" (verdict 0) or " FAIL\r\n" (any other verdict).
pub fn pass_fail_char(v: u8, p: u8) -> u8 {
    if (p == 0) { return 32; }
    if (p == 5) { return 13; }
    if (p == 6) { return 10; }
    if (v == 0) {
        if (p == 1) { return 80; }
        if (p == 2) { return 65; }
        return 83;
    }
    if (p == 1) { return 70; }
    if (p == 2) { return 65; }
    if (p == 3) { return 73; }
    return 76;
}

test hex_digit_covers_all_sixteen_nibbles_and_ignores_the_high_ones {
    assert_eq(hex_digit(0), 48);
    assert_eq(hex_digit(9), 57);
    assert_eq(hex_digit(10), 65);
    assert_eq(hex_digit(15), 70);
    assert_eq(hex_digit(0xA7), 55);
}

test pass_fail_char_spells_pass_and_fail {
    assert_eq(pass_fail_char(0, 0), 32);
    assert_eq(pass_fail_char(0, 1), 80);
    assert_eq(pass_fail_char(0, 2), 65);
    assert_eq(pass_fail_char(0, 3), 83);
    assert_eq(pass_fail_char(0, 4), 83);
    assert_eq(pass_fail_char(0, 5), 13);
    assert_eq(pass_fail_char(0, 6), 10);
    assert_eq(pass_fail_char(3, 1), 70);
    assert_eq(pass_fail_char(3, 2), 65);
    assert_eq(pass_fail_char(3, 3), 73);
    assert_eq(pass_fail_char(3, 4), 76);
    assert_eq(pass_fail_char(1, 1), 70);
}

test fold_rotates_the_sum_and_each_lane {
    assert_eq(fold(0, 0, 0, 0, 0), 0);
    assert_eq(fold(1, 0, 0, 0, 0), 2);
    assert_eq(fold(0x8000000000000000, 0, 0, 0, 0), 1);
    assert_eq(fold(0, 1, 0, 0, 0), 1);
    assert_eq(fold(0, 0, 1, 0, 0), 0x10000);
    assert_eq(fold(0, 0, 0, 1, 0), 0x100000000);
    assert_eq(fold(0, 0, 0, 0, 1), 0x1000000000000);
    assert_eq(fold(0, 0, 0x8000000000000000, 0, 0), 0x8000);
}

test a_fold_that_dropped_a_lane_would_be_seen {
    const a : u64 = fold(0x0123456789ABCDEF, 0x1111, 0x2222, 0x3333, 0x4444);
    const b : u64 = fold(0x0123456789ABCDEF, 0x1111, 0x2222, 0x3333, 0);
    assert(a != b);
}
