// SPDX-License-Identifier: Apache-2.0
; specs/fpga/vga_text_core.t27 -- 640x480@60 VGA timing and an 8x8 text-mode scanout, with no board pins
; Owner, 2026-10-19: a VGA monitor is available for the AX7203, to show the T27 OS screen. HOW VGA REACHES THE
; BOARD IS NOT ESTABLISHED in this repository (fpga/HARDWARE_SSOT.md and every .xdc here carry no VGA, HDMI or
; DVI pin), so this cell has no pins and no top: it is the part that does not depend on the connector. A board
; top will add the pin attributes once the owner confirms the connector and its schematic pin table.
; -
; THE TIMING (pixel clock 25.175 MHz nominal, 25 MHz is close enough; one on_clock = one pixel):
;   horizontal: 640 visible, 16 front porch, 96 sync (low), 48 back porch = 800
;   vertical:   480 visible, 10 front porch,  2 sync (low), 33 back porch = 525
; THE TEXT: 8x8 glyphs, 80 columns by 60 rows. The text comes from cell_char(col, row); the glyphs from
; glyph_bits(ch), eight row bytes packed into a u64, first row first, bit 7 the leftmost pixel. Only the glyphs
; of the demo line are drawn; the font grows glyph by glyph and everything else is blank.
; -
; WHAT A PASS SAYS: the tests step on_clock for whole frames and count: 96 low hsync ticks a line, 800 ticks a
; line, 2 low vsync lines, 525 lines, 307200 visible pixels, and the first glyph row of "T" on the stream.
; WHAT IT DOES NOT SAY: nothing here has met a monitor. Sync polarity, pixel clock accuracy and the color wiring
; are only proved by the screen.
module FpgaVgaTextCore;

pub const H_VISIBLE : u32 = 640;
pub const H_SYNC_START : u32 = 656;
pub const H_SYNC_END : u32 = 752;
pub const H_TOTAL : u32 = 800;
pub const V_VISIBLE : u32 = 480;
pub const V_SYNC_START : u32 = 490;
pub const V_SYNC_END : u32 = 492;
pub const V_TOTAL : u32 = 525;

// "T27 OS  " packed 8 to a word, first character first.
pub const TITLE : u64 = 0x543237204f532020;

pub const G_T : u64 = 0x7e18181818181800;
pub const G_2 : u64 = 0x3c66060c18307e00;
pub const G_7 : u64 = 0x7e060c1818181800;
pub const G_O : u64 = 0x3c66666666663c00;
pub const G_S : u64 = 0x3c6630180c663c00;

/// Byte i (0..7) of a packed word, first byte first.
pub fn pk(w: u64, i: u8) -> u8 {
    return ((w >> ((7 - (i & 7)) * 8)) & 255) as u8;
}

/// The glyph of ch: eight row bytes, first row first. Blank for every character not drawn yet.
pub fn glyph_bits(ch: u8) -> u64 {
    if (ch == 84) { return G_T; }
    if (ch == 50) { return G_2; }
    if (ch == 55) { return G_7; }
    if (ch == 79) { return G_O; }
    if (ch == 83) { return G_S; }
    return 0;
}

/// The character in text cell (col, row): the demo title on row 0, blanks elsewhere.
pub fn cell_char(col: u32, row: u32) -> u8 {
    if (row == 0) {
        if (col < 8) { return pk(TITLE, col as u8); }
    }
    return 32;
}

/// The pixel at (x, y) of the visible area: true is white.
pub fn pixel_at(x: u32, y: u32) -> bool {
    var ch : u8 = cell_char(x >> 3, y >> 3);
    var bits : u64 = glyph_bits(ch);
    var rowb : u8 = pk(bits, (y & 7) as u8);
    var sh : u32 = 7 - (x & 7);
    return ((rowb >> sh) & 1) == 1;
}

pub var hc : u32 = 0;
pub var vc : u32 = 0;
pub var hsync : bool = true;
pub var vsync : bool = true;
pub var de : bool = false;
pub var pix : bool = false;

// One pixel clock. The outputs are registered: after the tick for (hc, vc) they describe that pixel, and the
// counters already point at the next one.
fn on_clock() {
    var h : u32 = hc;
    var v : u32 = vc;
    var vis : bool = (h < H_VISIBLE) and (v < V_VISIBLE);
    de = vis;
    hsync = !((h >= H_SYNC_START) and (h < H_SYNC_END));
    vsync = !((v >= V_SYNC_START) and (v < V_SYNC_END));
    pix = vis and pixel_at(h, v);
    if (h == H_TOTAL - 1) {
        hc = 0;
        if (v == V_TOTAL - 1) {
            vc = 0;
        } else {
            vc = v + 1;
        }
    } else {
        hc = h + 1;
    }
}

test the_font_draws_a_T_with_a_bar_and_a_stem {
    // row 0 of T is 0x7e: pixels 1..6 on, 0 and 7 off; row 3 is the stem 0x18: pixels 3 and 4
    assert pixel_at(0, 0) == false;
    assert pixel_at(1, 0) == true;
    assert pixel_at(6, 0) == true;
    assert pixel_at(7, 0) == false;
    assert pixel_at(2, 3) == false;
    assert pixel_at(3, 3) == true;
    assert pixel_at(4, 3) == true;
    assert pixel_at(5, 3) == false;
    // the last glyph row (7) is blank, and so is every cell after the title
    assert pixel_at(3, 7) == false;
    assert pixel_at(70, 0) == false;
    assert pixel_at(3, 8) == false;
}

test the_title_is_t_2_7_blank_o_s {
    assert cell_char(0, 0) == 84;
    assert cell_char(1, 0) == 50;
    assert cell_char(2, 0) == 55;
    assert cell_char(3, 0) == 32;
    assert cell_char(4, 0) == 79;
    assert cell_char(5, 0) == 83;
    assert cell_char(0, 1) == 32;
}

test the_line_is_800_pixels_with_a_96_pixel_low_hsync_and_640_visible {
    hc = 0;
    vc = 0;
    var lo : u32 = 0;
    var vis : u32 = 0;
    var i : u32 = 0;
    while (i < H_TOTAL) {
        on_clock();
        if (hsync == false) { lo = lo + 1; }
        if (de) { vis = vis + 1; }
        i = i + 1;
    }
    assert_eq(lo, 96);
    assert_eq(vis, 640);
    // the counter wrapped to the start of line 1
    assert_eq(hc, 0);
    assert_eq(vc, 1);
}

test the_frame_is_525_lines_with_2_low_vsync_lines_and_307200_visible_pixels {
    hc = 0;
    vc = 0;
    var lo : u32 = 0;
    var vis : u32 = 0;
    var i : u32 = 0;
    while (i < H_TOTAL * V_TOTAL) {
        on_clock();
        if (vsync == false) { lo = lo + 1; }
        if (de) { vis = vis + 1; }
        i = i + 1;
    }
    assert_eq(lo, 2 * H_TOTAL);
    assert_eq(vis, 307200);
    assert_eq(hc, 0);
    assert_eq(vc, 0);
}

test the_stream_of_the_first_glyph_row_is_the_T_bar {
    hc = 0;
    vc = 0;
    // pixels 0..7 of line 0: 0 1 1 1 1 1 1 0
    on_clock();
    assert pix == false;
    on_clock();
    assert pix == true;
    on_clock();
    assert pix == true;
    on_clock();
    assert pix == true;
    on_clock();
    assert pix == true;
    on_clock();
    assert pix == true;
    on_clock();
    assert pix == true;
    on_clock();
    assert pix == false;
}

test the_stream_equals_pixel_at_on_the_first_eight_lines {
    hc = 0;
    vc = 0;
    var bad : u32 = 0;
    var n : u32 = 0;
    while (n < 8 * H_TOTAL) {
        var x : u32 = hc;
        var y : u32 = vc;
        on_clock();
        var want : bool = (x < H_VISIBLE) and pixel_at(x, y);
        if (pix != want) { bad = bad + 1; }
        n = n + 1;
    }
    assert_eq(bad, 0);
}

test the_blanking_is_black {
    hc = H_VISIBLE;
    vc = 0;
    on_clock();
    assert de == false;
    assert pix == false;
    hc = 0;
    vc = V_VISIBLE;
    on_clock();
    assert de == false;
    assert pix == false;
}
