// specs/fpga/synth_spec_pipeline.t27 -- fpga: synth_spec_pipeline spec and
// Verilog elaboration fixes.
// Part of M6 milestone (milestone #10). Closes #13821 and #13817.
// phi^2 + 1/phi^2 = 3 | TRINITY

module fpga::synth_spec_pipeline;

pub const SYNTH_SPEC_PIPELINE_STAGES : u32 = 4;

pub struct SynthSpecPipeline { stage: u32, elaborated: bool };

pub fn synth_spec_pipeline_elaborated(s: SynthSpecPipeline) -> bool {
    return s.elaborated && s.stage < SYNTH_SPEC_PIPELINE_STAGES;
}

test "synth_spec_pipeline_elaborated" {
    assert(synth_spec_pipeline_elaborated(SynthSpecPipeline { stage: 0, elaborated: true }));
    assert(!synth_spec_pipeline_elaborated(SynthSpecPipeline { stage: 4, elaborated: true }));
    assert(!synth_spec_pipeline_elaborated(SynthSpecPipeline { stage: 0, elaborated: false }));
}

test "synth_spec_pipeline_stages" {
    assert(SYNTH_SPEC_PIPELINE_STAGES == 4);
}

invariant synth_spec_pipeline_stages_positive {
    assert SYNTH_SPEC_PIPELINE_STAGES > 0;
}