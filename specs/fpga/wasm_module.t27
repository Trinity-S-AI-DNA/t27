// SPDX-License-Identifier: Apache-2.0
// specs/fpga/wasm_module.t27 -- the law of the WebAssembly module binary format (MVP):
// the LEB128 number encodings, the magic+version header, the section walk. One format,
// two directions: wasm_interp.t27's loader READS these bytes, the future emitter WRITES
// them -- the round-trip on the same structures is the law. The companion table law
// (specs/fpga/wasm_opcodes.t27) owns the opcodes; this file owns the CONTAINER.
//
// The test vectors are the WebAssembly spec appendix's own LEB examples plus a
// hand-built minimal module; nothing is transcribed from an existing implementation.
//
// The loader (t27#12201) is the layer above the walk: one module already sitting in a
// [SRC_MAX]u8 array, with an explicit src_len, is walked once and returned as a ModuleDesc
// (per-function code ranges, import count, exports, data triples, memory/table limits, the
// start function) with a named error code. No function of the loader takes a slice.
//
// NOT CLAIMED: validation of instruction sequences (the opcodes stay the law of
// specs/fpga/wasm_opcodes.t27, the loader trusts each declared body size), resolving
// imports (only the function import count is kept), the global and element payload
// grammars (count and payload range only), function types beyond their count, modules
// larger than SRC_MAX bytes, more than one memory or table, passive or multi-memory data
// segments, the name custom section's substructure, threads/SIMD/bulk-memory extensions.
// phi^2 + 1/phi^2 = 3 | TRINITY

module fpga_wasm_module;

pub const MAGIC : [4]u8 = [0x00, 0x61, 0x73, 0x6d];
pub const VERSION : u32 = 1;

pub const SEC_CUSTOM : u8 = 0;
pub const SEC_TYPE : u8 = 1;
pub const SEC_IMPORT : u8 = 2;
pub const SEC_FUNCTION : u8 = 3;
pub const SEC_TABLE : u8 = 4;
pub const SEC_MEMORY : u8 = 5;
pub const SEC_GLOBAL : u8 = 6;
pub const SEC_EXPORT : u8 = 7;
pub const SEC_START : u8 = 8;
pub const SEC_ELEMENT : u8 = 9;
pub const SEC_CODE : u8 = 10;
pub const SEC_DATA : u8 = 11;
pub const SEC_DATACOUNT : u8 = 12;
pub const SEC_KINDS : u8 = 13;

/// The result of one LEB128 unsigned read: the value and the bytes consumed.
pub const UlebRead = struct {
    value: u64,
    n: u32,
};

/// The result of one signed LEB128 read.
pub const SlebRead = struct {
    value: i32,
    n: u32,
};

/// The result of one section-walk step: the id, the payload size, the payload offset.
pub const SectionRef = struct {
    id: u8,
    size: u32,
    payload: u32,
};

/// LEB128 unsigned length in bytes for a u64 value.
pub fn uleb_len(x: u64) -> u32 {
    var n : u32 = 1;
    var v = x;
    v = v >> 7;
    while (v > 0) : (v = v >> 7) { n = n + 1; }
    return n;
}

/// Write x as LEB128 unsigned into dst; returns the bytes written. Seven bits per byte,
/// little-endian groups, the high bit marks a continuation.
pub fn uleb_write(dst: []u8, x: u64) -> u32 {
    var n : u32 = 0;
    var v = x;
    while (true) {
        var b : u8 = (v & 0x7f) as u8;
        v = v >> 7;
        if (v != 0) { b = b | 0x80; }
        dst[n] = b;
        n = n + 1;
        if (v == 0) { return n; }
    }
}

/// Read one LEB128 unsigned at src[at..]; the corpus style: a result struct, no out-params.
pub fn uleb_read(src: []const u8, at: u32) UlebRead {
    var result : u64 = 0;
    var shift : u32 = 0;
    var i = at;
    while (i < src.len) {
        const b = src[i];
        result = result + (((b & 0x7f) as u64) << shift);
        i = i + 1;
        if ((b & 0x80) == 0) {
            return UlebRead { .value = result, .n = i - at };
        }
        shift = shift + 7;
        if (shift > 63) { break; }
    }
    return UlebRead { .value = result, .n = i - at };
}

/// Signed LEB128 for the i32 range: accumulate in i64, then the low 32 bits ARE the i32.
pub fn sleb32_read(src: []const u8, at: u32) SlebRead {
    var result : i64 = 0;
    var shift : u32 = 0;
    var i = at;
    var b : u8 = 0;
    while (i < src.len) {
        b = src[i];
        result = result + (((b & 0x7f) as i64) << shift);
        shift = shift + 7;
        i = i + 1;
        if ((b & 0x80) == 0) { break; }
        if (shift >= 64) { break; }
    }
    // the sign extends from the last group's high bits (the WASM spec's own rule)
    if (shift < 64 and (b & 0x40) != 0) {
        result = result | ((-1 as i64) << shift);
    }
    return SlebRead { .value = result as i32, .n = i - at };
}

/// The module header: the magic and the version, the first eight bytes of every module.
pub fn header_ok(src: []const u8) bool {
    if (src.len < 8) { return false; }
    var i : u32 = 0;
    while (i < 4) : (i = i + 1) {
        if (src[i] != MAGIC[i]) { return false; }
    }
    return src[4] == 1 and src[5] == 0 and src[6] == 0 and src[7] == 0;
}

/// The section walk: the section at src[at..] as (id, size, payload offset). A size past
/// the source end returns the end sentinel (id 0xff, size 0, payload src.len).
pub fn next_section(src: []const u8, at: u32) SectionRef {
    if (at >= src.len) { return SectionRef { .id = 0xff, .size = 0, .payload = src.len as u32 }; }
    const idv = src[at];
    const r = uleb_read(src, at + 1);
    const payload = at + 1 + r.n;
    if (payload > src.len or r.value > src.len - payload) {
        return SectionRef { .id = 0xff, .size = 0, .payload = src.len as u32 };
    }
    return SectionRef { .id = idv, .size = r.value as u32, .payload = payload };
}

// ---------------------------------------------------------------------------------------
// The loader. Capacities are decimal literals on purpose: gen-verilog substitutes a [NAME]
// array dimension in a struct field only when NAME is a bare decimal integer const.
// ---------------------------------------------------------------------------------------

/// The module image capacity in bytes; an image is a [SRC_MAX]u8 array plus its src_len.
pub const SRC_MAX : u32 = 256;
/// Capacity of the defined-function tables (a DOOM-class wasm has about 1000 functions).
pub const FUNC_MAX : u32 = 1024;
pub const EXPORT_MAX : u32 = 64;
pub const DATA_MAX : u32 = 64;
/// Capacity of the name array handed to export_find.
pub const NAME_MAX : u32 = 32;

/// Error codes of the loader; OK = 0.
pub const OK : u32 = 0;
pub const ERR_BAD_MAGIC : u32 = 1;
pub const ERR_BAD_VERSION : u32 = 2;
pub const ERR_TRUNCATED : u32 = 3;
/// A count above a capacity (also an src_len above SRC_MAX); never clipped silently.
pub const ERR_TOO_MANY : u32 = 4;
pub const ERR_MALFORMED : u32 = 5;
pub const ERR_UNSUPPORTED : u32 = 6;

/// export_find answers this when no function export carries the name.
pub const NOT_FOUND : u32 = 0xFFFFFFFF;

/// The import and export kinds (the same four numbers in both sections).
pub const KIND_FUNC : u32 = 0;
pub const KIND_TABLE : u32 = 1;
pub const KIND_MEMORY : u32 = 2;
pub const KIND_GLOBAL : u32 = 3;

/// The two bytes of a data segment's offset expression: i32.const N end.
pub const OP_I32_CONST_BYTE : u8 = 0x41;
pub const OP_END_BYTE : u8 = 0x0B;

/// func_lookup answers: the index names an import, a defined function, or nothing.
pub const FUNC_IMPORT : u32 = 0;
pub const FUNC_DEFINED : u32 = 1;
pub const FUNC_NONE : u32 = 2;

/// One LEB128 u32 read; n = 0 means the read failed (past byte 5, bits above bit 31, or
/// past the end of the array).
pub const LebU32 = struct {
    value: u32,
    n: u32,
};

pub const LebS32 = struct {
    value: i32,
    n: u32,
};

/// The s33 form is the block-type encoding.
pub const LebS33 = struct {
    value: i64,
    n: u32,
};

/// One limits read: err (OK or a code), the bytes consumed, min and the optional max.
pub const LimitsRead = struct {
    err: u32,
    n: u32,
    has_max: bool,
    min: u32,
    max: u32,
};

/// One section header read: err, the id, the payload size and the payload offset.
pub const SecWalk = struct {
    err: u32,
    id: u8,
    size: u32,
    payload: u32,
};

/// A function index resolved: kind is FUNC_IMPORT, FUNC_DEFINED or FUNC_NONE; pos is the
/// position among the imports, or among the defined functions.
pub const FuncRef = struct {
    kind: u32,
    pos: u32,
};

/// The descriptor of one loaded module. The tables are parallel arrays indexed by the
/// defined-function position, the export position or the data-segment position. Names
/// and bytes stay in the image: only offsets and lengths are stored.
pub const ModuleDesc = struct {
    err: u32,
    nimport_func: u32,
    nfunc: u32,
    ncode: u32,
    func_type: [FUNC_MAX]u32,
    func_body_len: [FUNC_MAX]u32,
    func_loc_groups: [FUNC_MAX]u32,
    func_loc_total: [FUNC_MAX]u32,
    func_loc_off: [FUNC_MAX]u32,
    func_code_off: [FUNC_MAX]u32,
    func_code_len: [FUNC_MAX]u32,
    nexport: u32,
    exp_name_off: [EXPORT_MAX]u32,
    exp_name_len: [EXPORT_MAX]u32,
    exp_kind: [EXPORT_MAX]u32,
    exp_index: [EXPORT_MAX]u32,
    ndata: u32,
    seg_dest: [DATA_MAX]u32,
    seg_src: [DATA_MAX]u32,
    seg_len: [DATA_MAX]u32,
    has_mem: bool,
    mem_min: u32,
    has_mem_max: bool,
    mem_max: u32,
    has_table: bool,
    tab_min: u32,
    has_tab_max: bool,
    tab_max: u32,
    has_start: bool,
    start_idx: u32,
    nglobal: u32,
    glob_off: u32,
    glob_len: u32,
    nelem: u32,
    elem_off: u32,
    elem_len: u32,
};

/// An empty descriptor: every count 0, every table zeroed, err = OK.
pub fn desc_empty() -> ModuleDesc {
    return ModuleDesc {
        .err = 0,
        .nimport_func = 0,
        .nfunc = 0,
        .ncode = 0,
        .func_type = [0] ** FUNC_MAX,
        .func_body_len = [0] ** FUNC_MAX,
        .func_loc_groups = [0] ** FUNC_MAX,
        .func_loc_total = [0] ** FUNC_MAX,
        .func_loc_off = [0] ** FUNC_MAX,
        .func_code_off = [0] ** FUNC_MAX,
        .func_code_len = [0] ** FUNC_MAX,
        .nexport = 0,
        .exp_name_off = [0] ** EXPORT_MAX,
        .exp_name_len = [0] ** EXPORT_MAX,
        .exp_kind = [0] ** EXPORT_MAX,
        .exp_index = [0] ** EXPORT_MAX,
        .ndata = 0,
        .seg_dest = [0] ** DATA_MAX,
        .seg_src = [0] ** DATA_MAX,
        .seg_len = [0] ** DATA_MAX,
        .has_mem = false,
        .mem_min = 0,
        .has_mem_max = false,
        .mem_max = 0,
        .has_table = false,
        .tab_min = 0,
        .has_tab_max = false,
        .tab_max = 0,
        .has_start = false,
        .start_idx = 0,
        .nglobal = 0,
        .glob_off = 0,
        .glob_len = 0,
        .nelem = 0,
        .elem_off = 0,
        .elem_len = 0,
    };
}

/// The readable end of an image: len, but never past the array.
pub fn img_end(len: u32) -> u32 {
    if (len > SRC_MAX) { return SRC_MAX; }
    return len;
}

/// LEB128 unsigned, 32 bits, from src[at..len]. n = 0 on a continuation past byte 5, a
/// fifth byte with bits above bit 31 set, or a read that runs past the end.
pub fn leb_u32(src: [SRC_MAX]u8, len: u32, at: u32) -> LebU32 {
    const lim = img_end(len);
    var result : u64 = 0;
    var shift : u32 = 0;
    var i : u32 = 0;
    while (i < 5) : (i = i + 1) {
        if (at + i >= lim) { return LebU32 { .value = 0, .n = 0 }; }
        const b = src[at + i];
        if (i == 4 and (b & 0xf0) != 0) { return LebU32 { .value = 0, .n = 0 }; }
        result = result + (((b & 0x7f) as u64) << shift);
        shift = shift + 7;
        if ((b & 0x80) == 0) { return LebU32 { .value = result as u32, .n = i + 1 }; }
    }
    return LebU32 { .value = 0, .n = 0 };
}

/// LEB128 signed, 33 bits (the block-type form), under the same 5-byte limit. The value
/// is sign-extended from the last group and must fit 33 bits.
pub fn leb_s33(src: [SRC_MAX]u8, len: u32, at: u32) -> LebS33 {
    const lim = img_end(len);
    var result : i64 = 0;
    var shift : u32 = 0;
    var i : u32 = 0;
    while (i < 5) : (i = i + 1) {
        if (at + i >= lim) { return LebS33 { .value = 0, .n = 0 }; }
        const b = src[at + i];
        result = result + (((b & 0x7f) as i64) << shift);
        shift = shift + 7;
        if ((b & 0x80) == 0) {
            if ((b & 0x40) != 0) { result = result | ((-1 as i64) << shift); }
            if (result > 4294967295 or result < -4294967296) { return LebS33 { .value = 0, .n = 0 }; }
            return LebS33 { .value = result, .n = i + 1 };
        }
    }
    return LebS33 { .value = 0, .n = 0 };
}

/// LEB128 signed, 32 bits: the s33 read, refused when the value leaves the i32 range.
pub fn leb_s32(src: [SRC_MAX]u8, len: u32, at: u32) -> LebS32 {
    const r = leb_s33(src, len, at);
    if (r.n == 0 or r.value > 2147483647 or r.value < -2147483648) {
        return LebS32 { .value = 0, .n = 0 };
    }
    return LebS32 { .value = r.value as i32, .n = r.n };
}

/// Why a LEB read at `at` failed at a section header: fewer than 5 bytes left means the
/// array ended inside the number, otherwise the number itself is bad.
pub fn leb_fail(len: u32, at: u32) -> u32 {
    if (at + 5 > img_end(len)) { return ERR_TRUNCATED; }
    return ERR_MALFORMED;
}

/// The section header at src[at..]: id, size, payload offset. A size past src_len is
/// ERR_TRUNCATED, so the caller can step by size and never index past the image.
pub fn section_at(src: [SRC_MAX]u8, len: u32, at: u32) -> SecWalk {
    const id = src[at];
    const r = leb_u32(src, len, at + 1);
    if (r.n == 0) {
        return SecWalk { .err = leb_fail(len, at + 1), .id = id, .size = 0, .payload = at };
    }
    const payload = at + 1 + r.n;
    if (r.value > len - payload) {
        return SecWalk { .err = ERR_TRUNCATED, .id = id, .size = 0, .payload = payload };
    }
    return SecWalk { .err = OK, .id = id, .size = r.value, .payload = payload };
}

/// A limits entry at src[at..pend]: a flag (0 min only, 1 min and max), then the numbers.
pub fn limits_read(src: [SRC_MAX]u8, pend: u32, at: u32) -> LimitsRead {
    var out : LimitsRead = LimitsRead { .err = OK, .n = 0, .has_max = false, .min = 0, .max = 0 };
    var hi : LebU32 = LebU32 { .value = 0, .n = 0 };
    if (at >= pend) { out.err = ERR_MALFORMED; return out; }
    const flag = src[at];
    if (flag > 1) { out.err = ERR_UNSUPPORTED; return out; }
    var p = at + 1;
    const lo = leb_u32(src, pend, p);
    if (lo.n == 0) { out.err = ERR_MALFORMED; return out; }
    p = p + lo.n;
    out.min = lo.value;
    if (flag == 1) {
        hi = leb_u32(src, pend, p);
        if (hi.n == 0) { out.err = ERR_MALFORMED; return out; }
        p = p + hi.n;
        out.max = hi.value;
        out.has_max = true;
    }
    out.n = p - at;
    return out;
}

/// Record a memory limits entry (is_table false) or a table limits entry (is_table true).
pub fn desc_set_limits(d: ModuleDesc, lim: LimitsRead, is_table: bool) -> ModuleDesc {
    var m : ModuleDesc = d;
    if (is_table) {
        m.has_table = true;
        m.tab_min = lim.min;
        m.has_tab_max = lim.has_max;
        m.tab_max = lim.max;
    } else {
        m.has_mem = true;
        m.mem_min = lim.min;
        m.has_mem_max = lim.has_max;
        m.mem_max = lim.max;
    }
    return m;
}

/// The function section: a count, then one type index per defined function.
pub fn sec_function(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32) -> ModuleDesc {
    var m : ModuleDesc = d;
    var p = p0;
    var t : LebU32 = LebU32 { .value = 0, .n = 0 };
    const c = leb_u32(src, pend, p);
    if (c.n == 0) { m.err = ERR_MALFORMED; return m; }
    if (c.value > FUNC_MAX) { m.err = ERR_TOO_MANY; return m; }
    p = p + c.n;
    var i : u32 = 0;
    while (i < c.value) : (i = i + 1) {
        t = leb_u32(src, pend, p);
        if (t.n == 0) { m.err = ERR_MALFORMED; return m; }
        m.func_type[i] = t.value;
        p = p + t.n;
    }
    m.nfunc = c.value;
    return m;
}

/// The import section, entry by entry: two names skipped by length, the kind, and the
/// descriptor skipped by grammar. A function import counts; a table or memory import
/// records its limits as a defined one does.
pub fn sec_import(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32) -> ModuleDesc {
    var m : ModuleDesc = d;
    var p = p0;
    var l : LebU32 = LebU32 { .value = 0, .n = 0 };
    var t : LebU32 = LebU32 { .value = 0, .n = 0 };
    var lim : LimitsRead = LimitsRead { .err = OK, .n = 0, .has_max = false, .min = 0, .max = 0 };
    const c = leb_u32(src, pend, p);
    if (c.n == 0) { m.err = ERR_MALFORMED; return m; }
    p = p + c.n;
    var i : u32 = 0;
    while (i < c.value) : (i = i + 1) {
        var k : u32 = 0;
        while (k < 2) : (k = k + 1) {
            l = leb_u32(src, pend, p);
            if (l.n == 0) { m.err = ERR_MALFORMED; return m; }
            p = p + l.n;
            if (l.value > pend - p) { m.err = ERR_MALFORMED; return m; }
            p = p + l.value;
        }
        if (p >= pend) { m.err = ERR_MALFORMED; return m; }
        const kind : u32 = src[p] as u32;
        p = p + 1;
        if (kind > KIND_GLOBAL) { m.err = ERR_MALFORMED; return m; }
        if (kind == KIND_FUNC) {
            t = leb_u32(src, pend, p);
            if (t.n == 0) { m.err = ERR_MALFORMED; return m; }
            p = p + t.n;
            m.nimport_func = m.nimport_func + 1;
        }
        if (kind == KIND_TABLE or kind == KIND_MEMORY) {
            if (kind == KIND_TABLE) {
                if (p >= pend) { m.err = ERR_MALFORMED; return m; }
                p = p + 1;
            }
            lim = limits_read(src, pend, p);
            if (lim.err != OK) { m.err = lim.err; return m; }
            p = p + lim.n;
            m = desc_set_limits(m, lim, kind == KIND_TABLE);
        }
        if (kind == KIND_GLOBAL) {
            if (pend - p < 2) { m.err = ERR_MALFORMED; return m; }
            p = p + 2;
        }
    }
    return m;
}

/// The table section (is_table true) or the memory section: at most one entry.
pub fn sec_limits(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32, is_table: bool) -> ModuleDesc {
    var m : ModuleDesc = d;
    var p = p0;
    var lim : LimitsRead = LimitsRead { .err = OK, .n = 0, .has_max = false, .min = 0, .max = 0 };
    const c = leb_u32(src, pend, p);
    if (c.n == 0) { m.err = ERR_MALFORMED; return m; }
    p = p + c.n;
    if (c.value > 1) { m.err = ERR_UNSUPPORTED; return m; }
    if (c.value == 1) {
        if (is_table) {
            if (p >= pend) { m.err = ERR_MALFORMED; return m; }
            p = p + 1;
        }
        lim = limits_read(src, pend, p);
        if (lim.err != OK) { m.err = lim.err; return m; }
        m = desc_set_limits(m, lim, is_table);
    }
    return m;
}

/// The global section (is_global true) or the element section: the count and the payload
/// range only.
pub fn sec_counted(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32, is_global: bool) -> ModuleDesc {
    var m : ModuleDesc = d;
    const c = leb_u32(src, pend, p0);
    if (c.n == 0) { m.err = ERR_MALFORMED; return m; }
    if (is_global) {
        m.nglobal = c.value;
        m.glob_off = p0;
        m.glob_len = pend - p0;
    } else {
        m.nelem = c.value;
        m.elem_off = p0;
        m.elem_len = pend - p0;
    }
    return m;
}

/// The start section: one function index.
pub fn sec_start(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32) -> ModuleDesc {
    var m : ModuleDesc = d;
    const s = leb_u32(src, pend, p0);
    if (s.n == 0) { m.err = ERR_MALFORMED; return m; }
    m.has_start = true;
    m.start_idx = s.value;
    return m;
}

/// The export section: (name_off, name_len, kind, index) per entry, the name staying in
/// the image.
pub fn sec_export(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32) -> ModuleDesc {
    var m : ModuleDesc = d;
    var p = p0;
    var nl : LebU32 = LebU32 { .value = 0, .n = 0 };
    var ix : LebU32 = LebU32 { .value = 0, .n = 0 };
    const c = leb_u32(src, pend, p);
    if (c.n == 0) { m.err = ERR_MALFORMED; return m; }
    if (c.value > EXPORT_MAX) { m.err = ERR_TOO_MANY; return m; }
    p = p + c.n;
    var i : u32 = 0;
    while (i < c.value) : (i = i + 1) {
        nl = leb_u32(src, pend, p);
        if (nl.n == 0) { m.err = ERR_MALFORMED; return m; }
        p = p + nl.n;
        if (nl.value > pend - p) { m.err = ERR_MALFORMED; return m; }
        m.exp_name_off[i] = p;
        m.exp_name_len[i] = nl.value;
        p = p + nl.value;
        if (p >= pend) { m.err = ERR_MALFORMED; return m; }
        m.exp_kind[i] = src[p] as u32;
        p = p + 1;
        ix = leb_u32(src, pend, p);
        if (ix.n == 0) { m.err = ERR_MALFORMED; return m; }
        m.exp_index[i] = ix.value;
        p = p + ix.n;
    }
    m.nexport = c.value;
    return m;
}

/// The code section: per body the declared size, the locals vector (groups, total, offset)
/// and the instruction range up to and including the final end byte. The entry count must
/// equal the function section's.
pub fn sec_code(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32) -> ModuleDesc {
    var m : ModuleDesc = d;
    var p = p0;
    var bs : LebU32 = LebU32 { .value = 0, .n = 0 };
    var g : LebU32 = LebU32 { .value = 0, .n = 0 };
    var lc : LebU32 = LebU32 { .value = 0, .n = 0 };
    const c = leb_u32(src, pend, p);
    if (c.n == 0) { m.err = ERR_MALFORMED; return m; }
    if (c.value > FUNC_MAX) { m.err = ERR_TOO_MANY; return m; }
    if (c.value != m.nfunc) { m.err = ERR_MALFORMED; return m; }
    p = p + c.n;
    var i : u32 = 0;
    while (i < c.value) : (i = i + 1) {
        bs = leb_u32(src, pend, p);
        if (bs.n == 0) { m.err = ERR_MALFORMED; return m; }
        p = p + bs.n;
        if (bs.value == 0 or bs.value > pend - p) { m.err = ERR_MALFORMED; return m; }
        const body_start = p;
        const body_end = p + bs.value;
        g = leb_u32(src, body_end, p);
        if (g.n == 0) { m.err = ERR_MALFORMED; return m; }
        p = p + g.n;
        var total : u32 = 0;
        var k : u32 = 0;
        while (k < g.value) : (k = k + 1) {
            lc = leb_u32(src, body_end, p);
            if (lc.n == 0) { m.err = ERR_MALFORMED; return m; }
            p = p + lc.n;
            if (p >= body_end) { m.err = ERR_MALFORMED; return m; }
            p = p + 1;
            if (lc.value > 0xFFFFFFFF - total) { m.err = ERR_MALFORMED; return m; }
            total = total + lc.value;
        }
        if (p >= body_end) { m.err = ERR_MALFORMED; return m; }
        if (src[body_end - 1] != OP_END_BYTE) { m.err = ERR_MALFORMED; return m; }
        m.func_body_len[i] = bs.value;
        m.func_loc_groups[i] = g.value;
        m.func_loc_total[i] = total;
        m.func_loc_off[i] = body_start;
        m.func_code_off[i] = p;
        m.func_code_len[i] = body_end - p;
        p = body_end;
    }
    m.ncode = c.value;
    return m;
}

/// The data section: active segments of memory 0 (flag 0) with the offset expression
/// i32.const N end, stored as (destination N, source offset, length).
pub fn sec_data(src: [SRC_MAX]u8, d: ModuleDesc, p0: u32, pend: u32) -> ModuleDesc {
    var m : ModuleDesc = d;
    var p = p0;
    var fl : LebU32 = LebU32 { .value = 0, .n = 0 };
    var dst : LebS32 = LebS32 { .value = 0, .n = 0 };
    var ln : LebU32 = LebU32 { .value = 0, .n = 0 };
    const c = leb_u32(src, pend, p);
    if (c.n == 0) { m.err = ERR_MALFORMED; return m; }
    if (c.value > DATA_MAX) { m.err = ERR_TOO_MANY; return m; }
    p = p + c.n;
    var i : u32 = 0;
    while (i < c.value) : (i = i + 1) {
        fl = leb_u32(src, pend, p);
        if (fl.n == 0) { m.err = ERR_MALFORMED; return m; }
        p = p + fl.n;
        if (fl.value != 0) { m.err = ERR_UNSUPPORTED; return m; }
        if (p >= pend) { m.err = ERR_MALFORMED; return m; }
        if (src[p] != OP_I32_CONST_BYTE) { m.err = ERR_UNSUPPORTED; return m; }
        p = p + 1;
        dst = leb_s32(src, pend, p);
        if (dst.n == 0) { m.err = ERR_MALFORMED; return m; }
        if (dst.value < 0) { m.err = ERR_UNSUPPORTED; return m; }
        p = p + dst.n;
        if (p >= pend) { m.err = ERR_MALFORMED; return m; }
        if (src[p] != OP_END_BYTE) { m.err = ERR_UNSUPPORTED; return m; }
        p = p + 1;
        ln = leb_u32(src, pend, p);
        if (ln.n == 0) { m.err = ERR_MALFORMED; return m; }
        p = p + ln.n;
        if (ln.value > pend - p) { m.err = ERR_MALFORMED; return m; }
        m.seg_dest[i] = dst.value as u32;
        m.seg_src[i] = p;
        m.seg_len[i] = ln.value;
        p = p + ln.value;
    }
    m.ndata = c.value;
    return m;
}

/// One section by id. The type section (1), custom sections (0), the data count section
/// (12) and unknown ids fall through: the caller steps over them by size.
pub fn load_section(src: [SRC_MAX]u8, d: ModuleDesc, id: u8, p0: u32, pend: u32) -> ModuleDesc {
    var m : ModuleDesc = d;
    if (id == SEC_IMPORT) { m = sec_import(src, m, p0, pend); }
    if (id == SEC_FUNCTION) { m = sec_function(src, m, p0, pend); }
    if (id == SEC_TABLE) { m = sec_limits(src, m, p0, pend, true); }
    if (id == SEC_MEMORY) { m = sec_limits(src, m, p0, pend, false); }
    if (id == SEC_GLOBAL) { m = sec_counted(src, m, p0, pend, true); }
    if (id == SEC_EXPORT) { m = sec_export(src, m, p0, pend); }
    if (id == SEC_START) { m = sec_start(src, m, p0, pend); }
    if (id == SEC_ELEMENT) { m = sec_counted(src, m, p0, pend, false); }
    if (id == SEC_CODE) { m = sec_code(src, m, p0, pend); }
    if (id == SEC_DATA) { m = sec_data(src, m, p0, pend); }
    return m;
}

/// Load a module: the header in the order truncated, magic, version; then every section
/// from offset 8, always advancing by the declared size. Never indexes past the image.
pub fn load(src: [SRC_MAX]u8, src_len: u32) -> ModuleDesc {
    var d : ModuleDesc = desc_empty();
    if (src_len > SRC_MAX) { d.err = ERR_TOO_MANY; return d; }
    if (src_len < 8) { d.err = ERR_TRUNCATED; return d; }
    var i : u32 = 0;
    while (i < 4) : (i = i + 1) {
        if (src[i] != MAGIC[i]) { d.err = ERR_BAD_MAGIC; return d; }
    }
    const ver : u32 = (src[4] as u32) | ((src[5] as u32) << 8) | ((src[6] as u32) << 16) | ((src[7] as u32) << 24);
    if (ver != VERSION) { d.err = ERR_BAD_VERSION; return d; }
    var at : u32 = 8;
    var sec : SecWalk = SecWalk { .err = OK, .id = 0, .size = 0, .payload = 0 };
    while (at < src_len) {
        sec = section_at(src, src_len, at);
        if (sec.err != OK) { d.err = sec.err; return d; }
        const pend = sec.payload + sec.size;
        d = load_section(src, d, sec.id, sec.payload, pend);
        if (d.err != OK) { return d; }
        at = pend;
    }
    if (d.nfunc != d.ncode) { d.err = ERR_MALFORMED; return d; }
    return d;
}

/// A function index resolved: imports come first in the index space.
pub fn func_lookup(d: ModuleDesc, index: u32) -> FuncRef {
    if (index < d.nimport_func) { return FuncRef { .kind = FUNC_IMPORT, .pos = index }; }
    const pos = index - d.nimport_func;
    if (pos >= d.nfunc) { return FuncRef { .kind = FUNC_NONE, .pos = 0 }; }
    return FuncRef { .kind = FUNC_DEFINED, .pos = pos };
}

/// The function index of the function-kind export called `name` (name_len bytes of the
/// name array), else NOT_FOUND. The export names are compared in place in the image.
pub fn export_find(src: [SRC_MAX]u8, d: ModuleDesc, name: [NAME_MAX]u8, name_len: u32) -> u32 {
    if (name_len > NAME_MAX) { return NOT_FOUND; }
    var i : u32 = 0;
    while (i < d.nexport) : (i = i + 1) {
        if (d.exp_kind[i] == KIND_FUNC and d.exp_name_len[i] == name_len) {
            var same : bool = true;
            var k : u32 = 0;
            while (k < name_len) : (k = k + 1) {
                if (src[d.exp_name_off[i] + k] != name[k]) { same = false; }
            }
            if (same) { return d.exp_index[i]; }
        }
    }
    return NOT_FOUND;
}

test the_magic_and_version_are_the_wasm_header {
    const mod : [8]u8 = [0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00];
    assert header_ok(&mod);
    var bad : [8]u8 = mod;
    bad[1] = 0x00;
    assert header_ok(&bad) == false;
    var short : [7]u8 = [0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00];
    assert header_ok(&short) == false;
}

test uleb_matches_the_spec_appendix_vectors {
    var dst : [5]u8 = [0] ** 5;
    const w1 = uleb_write(dst[0..5], 0);
    assert w1 == 1 and dst[0] == 0x00;
    const w2 = uleb_write(dst[0..5], 1);
    assert w2 == 1 and dst[0] == 0x01;
    const w3 = uleb_write(dst[0..5], 127);
    assert w3 == 1 and dst[0] == 0x7f;
    const w4 = uleb_write(dst[0..5], 128);
    assert w4 == 2 and dst[0] == 0x80 and dst[1] == 0x01;
    const w5 = uleb_write(dst[0..5], 624485);
    assert w5 == 3 and dst[0] == 0xe5 and dst[1] == 0x8e and dst[2] == 0x26;
    const r = uleb_read(dst[0..3], 0);
    assert r.value == 624485 and r.n == 3;
}

test uleb_boundaries_round_trip {
    var dst : [10]u8 = [0] ** 10;
    const bounds : [6]u64 = [0, 1, 127, 128, 16383, 4294967295];
    var i : u32 = 0;
    while (i < 6) : (i = i + 1) {
        const n = uleb_write(dst[0..10], bounds[i]);
        const r = uleb_read(dst[0..10], 0);
        assert r.value == bounds[i];
        assert r.n == n;
        assert n == uleb_len(bounds[i]);
    }
}

test sleb32_carries_the_i32_const_immediate {
    // the spec appendix: 64 encodes as C0 00; -64 as 40; -123456 as C0 BB 78
    var dst : [3]u8 = [0] ** 3;
    var n : u32 = 0;
    dst[0] = 0xc0; dst[1] = 0x00;
    var r = sleb32_read(dst[0..2], 0);
    assert r.value == 64 and r.n == 2;
    dst[0] = 0x40;
    r = sleb32_read(dst[0..1], 0);
    assert r.value == -64 and r.n == 1;
    dst[0] = 0xc0; dst[1] = 0xbb; dst[2] = 0x78;
    r = sleb32_read(dst[0..3], 0);
    assert r.value == -123456 and r.n == 3;
}

test the_section_walk_crosses_two_sections {
    // a hand-built module body: type section (id 1) with a () -> () func type,
    // then function section (id 3) naming it
    var mod : [18]u8 = [0] ** 18;
    mod[0] = 0x00; mod[1] = 0x61; mod[2] = 0x73; mod[3] = 0x6d;
    mod[4] = 0x01; mod[5] = 0x00; mod[6] = 0x00; mod[7] = 0x00;
    mod[8] = 0x01; mod[9] = 0x04; mod[10] = 0x01; mod[11] = 0x60; mod[12] = 0x00; mod[13] = 0x00;
    mod[14] = 0x03; mod[15] = 0x02; mod[16] = 0x01; mod[17] = 0x00;
    assert header_ok(&mod);
    var sec = next_section(&mod, 8);
    assert sec.id == 1 and sec.size == 4 and sec.payload == 10;
    assert mod[sec.payload] == 0x01;
    sec = next_section(&mod, sec.payload + sec.size);
    assert sec.id == 3 and sec.size == 2;
}

test a_truncated_section_size_refuses_the_walk {
    var mod : [10]u8 = [0] ** 10;
    mod[0] = 0x00; mod[1] = 0x61; mod[2] = 0x73; mod[3] = 0x6d;
    mod[4] = 0x01; mod[5] = 0x00; mod[6] = 0x00; mod[7] = 0x00;
    mod[8] = 0x01; mod[9] = 0x7f;
    // a size of 127 past a 1-byte source end is the truncation: the walk refuses with
    // the end sentinel (id 0xff, size 0, payload = the source end)
    const sec = next_section(&mod, 8);
    assert sec.id == 0xff and sec.size == 0 and sec.payload == 10;
    const past = next_section(&mod, 8 + sec.size);
    assert past.id == 0xff and past.size == 0 and past.payload == 10;
}

// ---------------------------------------------------------------------------------------
// The loader's modules, hand-encoded. Offsets in the tests below are counted by hand from
// these bytes (header 0..7, then section id, size, payload).
// ---------------------------------------------------------------------------------------

/// (func (export "main") (result i32) i32.const 42), 37 bytes.
pub const MOD_MIN_LEN : u32 = 37;
pub const MOD_MIN : [37]u8 = [
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,
    0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7f,
    0x03, 0x02, 0x01, 0x00,
    0x07, 0x08, 0x01, 0x04, 0x6d, 0x61, 0x69, 0x6e, 0x00, 0x00,
    0x0a, 0x06, 0x01, 0x04, 0x00, 0x41, 0x2a, 0x0b
];

/// A memory section (1 page, no max) and one active data segment writing "hello" at 16.
pub const MOD_DATA_LEN : u32 = 26;
pub const MOD_DATA : [26]u8 = [
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,
    0x05, 0x03, 0x01, 0x00, 0x01,
    0x0b, 0x0b, 0x01, 0x00, 0x41, 0x10, 0x0b, 0x05, 0x68, 0x65, 0x6c, 0x6c, 0x6f
];

/// (import "env" "f" (func)), then one defined function exported as "g" (index 1).
pub const MOD_IMPORT_LEN : u32 = 42;
pub const MOD_IMPORT : [42]u8 = [
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,
    0x01, 0x04, 0x01, 0x60, 0x00, 0x00,
    0x02, 0x09, 0x01, 0x03, 0x65, 0x6e, 0x76, 0x01, 0x66, 0x00, 0x00,
    0x03, 0x02, 0x01, 0x00,
    0x07, 0x05, 0x01, 0x01, 0x67, 0x00, 0x01,
    0x0a, 0x04, 0x01, 0x02, 0x00, 0x0b
];

/// Two functions (the second has one local group of 2), a table (min 2), a memory (min 1,
/// max 3) and the start function 1.
pub const MOD_LIMITS_LEN : u32 = 45;
pub const MOD_LIMITS : [45]u8 = [
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,
    0x01, 0x04, 0x01, 0x60, 0x00, 0x00,
    0x03, 0x03, 0x02, 0x00, 0x00,
    0x04, 0x04, 0x01, 0x70, 0x00, 0x02,
    0x05, 0x04, 0x01, 0x01, 0x01, 0x03,
    0x08, 0x01, 0x01,
    0x0a, 0x09, 0x02, 0x02, 0x00, 0x0b, 0x04, 0x01, 0x02, 0x7f, 0x0b
];

test leb_u32_0x7f_is_127_in_1_byte {
    var u1img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    u1img[0] = 0x7f;
    const r = leb_u32(u1img, 1, 0);
    assert r.value == 127 and r.n == 1;
}

test leb_u32_0x80_0x01_is_128_in_2_bytes {
    var u2img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    u2img[0] = 0x80;
    u2img[1] = 0x01;
    const r = leb_u32(u2img, 2, 0);
    assert r.value == 128 and r.n == 2;
    // the same two bytes with the array cut after the first: the read runs past the end
    const cut = leb_u32(u2img, 1, 0);
    assert cut.n == 0;
}

test leb_u32_five_byte_max_is_0xffffffff {
    var u3img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    u3img[0] = 0xff; u3img[1] = 0xff; u3img[2] = 0xff; u3img[3] = 0xff; u3img[4] = 0x0f;
    const r = leb_u32(u3img, 5, 0);
    assert r.value == 0xFFFFFFFF and r.n == 5;
    // a fifth byte with a bit above bit 31 set is refused
    u3img[4] = 0x1f;
    const high = leb_u32(u3img, 5, 0);
    assert high.n == 0;
    // a continuation past byte 5 is refused
    u3img[4] = 0x8f;
    const more = leb_u32(u3img, 6, 0);
    assert more.n == 0;
}

test leb_s32_0x7f_is_minus_1 {
    var s1img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    s1img[0] = 0x7f;
    const r = leb_s32(s1img, 1, 0);
    assert r.value == -1 and r.n == 1;
    // the i32 minimum takes all five bytes: 80 80 80 80 78
    s1img[0] = 0x80; s1img[1] = 0x80; s1img[2] = 0x80; s1img[3] = 0x80; s1img[4] = 0x78;
    const lo = leb_s32(s1img, 5, 0);
    assert lo.value == -2147483648 and lo.n == 5;
    // 4294967295 fits s33 but not s32: the s32 reader refuses it
    s1img[0] = 0xff; s1img[1] = 0xff; s1img[2] = 0xff; s1img[3] = 0xff; s1img[4] = 0x0f;
    const big = leb_s32(s1img, 5, 0);
    assert big.n == 0;
}

test leb_s32_0x40_is_minus_64 {
    var s2img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    s2img[0] = 0x40;
    const r = leb_s32(s2img, 1, 0);
    assert r.value == -64 and r.n == 1;
}

test leb_s33_0x40_is_minus_64 {
    var s3img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    s3img[0] = 0x40;
    const r = leb_s33(s3img, 1, 0);
    assert r.value == -64 and r.n == 1;
    s3img[0] = 0xff; s3img[1] = 0xff; s3img[2] = 0xff; s3img[3] = 0xff; s3img[4] = 0x0f;
    const big = leb_s33(s3img, 5, 0);
    assert big.value == 4294967295 and big.n == 5;
}

test minimal_module_has_one_function_and_export_main_is_0 {
    var m1img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_MIN_LEN) : (i = i + 1) { m1img[i] = MOD_MIN[i]; }
    const d = load(m1img, MOD_MIN_LEN);
    assert d.err == OK;
    assert d.nfunc == 1 and d.ncode == 1 and d.nimport_func == 0;
    assert d.nexport == 1;
    // the export entry: the name "main" at offset 23, length 4, a function export, index 0
    assert d.exp_name_off[0] == 23 and d.exp_name_len[0] == 4;
    assert d.exp_kind[0] == KIND_FUNC and d.exp_index[0] == 0;
    var nm : [NAME_MAX]u8 = [0] ** NAME_MAX;
    nm[0] = 0x6d; nm[1] = 0x61; nm[2] = 0x69; nm[3] = 0x6e;
    assert export_find(m1img, d, nm, 4) == 0;
    assert export_find(m1img, d, nm, 3) == NOT_FOUND;
    nm[3] = 0x6f;
    assert export_find(m1img, d, nm, 4) == NOT_FOUND;
}

test minimal_module_body_offset_is_0x41_and_body_length_is_4 {
    var m2img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_MIN_LEN) : (i = i + 1) { m2img[i] = MOD_MIN[i]; }
    const d = load(m2img, MOD_MIN_LEN);
    assert d.err == OK;
    assert d.func_code_off[0] == 34;
    assert m2img[34] == OP_I32_CONST_BYTE;
    assert d.func_body_len[0] == 4 and d.func_code_len[0] == 3;
    assert m2img[36] == OP_END_BYTE;
    // the locals vector is one byte (0 groups) at offset 33, just before the code
    assert d.func_loc_groups[0] == 0 and d.func_loc_total[0] == 0 and d.func_loc_off[0] == 33;
    assert d.func_type[0] == 0;
    const f0 = func_lookup(d, 0);
    assert f0.kind == FUNC_DEFINED and f0.pos == 0;
    const f1 = func_lookup(d, 1);
    assert f1.kind == FUNC_NONE;
}

test data_segment_module_gives_one_triple {
    var dimg : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_DATA_LEN) : (i = i + 1) { dimg[i] = MOD_DATA[i]; }
    const d = load(dimg, MOD_DATA_LEN);
    assert d.err == OK;
    assert d.ndata == 1;
    assert d.seg_dest[0] == 16 and d.seg_src[0] == 21 and d.seg_len[0] == 5;
    assert dimg[21] == 0x68 and dimg[25] == 0x6f;
    assert d.has_mem and d.mem_min == 1 and d.has_mem_max == false;
    assert d.has_table == false and d.has_start == false;
    assert d.nfunc == 0 and d.nexport == 0;
}

test import_module_makes_function_0_an_import {
    var iimg : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_IMPORT_LEN) : (i = i + 1) { iimg[i] = MOD_IMPORT[i]; }
    const d = load(iimg, MOD_IMPORT_LEN);
    assert d.err == OK;
    assert d.nimport_func == 1 and d.nfunc == 1;
    const f0 = func_lookup(d, 0);
    assert f0.kind == FUNC_IMPORT;
    const f1 = func_lookup(d, 1);
    assert f1.kind == FUNC_DEFINED and f1.pos == 0;
    const f2 = func_lookup(d, 2);
    assert f2.kind == FUNC_NONE;
    // the export "g" points at index 1, which resolves to the defined body
    var nm : [NAME_MAX]u8 = [0] ** NAME_MAX;
    nm[0] = 0x67;
    const ix = export_find(iimg, d, nm, 1);
    assert ix == 1;
    const body = func_lookup(d, ix);
    assert body.kind == FUNC_DEFINED;
    assert d.func_code_off[body.pos] == 41 and d.func_code_len[body.pos] == 1;
    assert d.func_body_len[body.pos] == 2;
    assert iimg[41] == OP_END_BYTE;
}

test limits_and_start_are_recorded {
    var limg : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_LIMITS_LEN) : (i = i + 1) { limg[i] = MOD_LIMITS[i]; }
    const d = load(limg, MOD_LIMITS_LEN);
    assert d.err == OK;
    assert d.has_table and d.tab_min == 2 and d.has_tab_max == false;
    assert d.has_mem and d.mem_min == 1 and d.has_mem_max and d.mem_max == 3;
    assert d.has_start and d.start_idx == 1;
    // two defined functions: the second carries one local group of 2
    assert d.nfunc == 2 and d.ncode == 2;
    assert d.func_code_off[0] == 39 and d.func_code_len[0] == 1 and d.func_body_len[0] == 2;
    assert d.func_loc_groups[0] == 0 and d.func_loc_total[0] == 0 and d.func_loc_off[0] == 38;
    assert d.func_code_off[1] == 44 and d.func_code_len[1] == 1 and d.func_body_len[1] == 4;
    assert d.func_loc_groups[1] == 1 and d.func_loc_total[1] == 2 and d.func_loc_off[1] == 41;
}

test bad_magic_gives_the_bad_magic_code {
    var b1img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_MIN_LEN) : (i = i + 1) { b1img[i] = MOD_MIN[i]; }
    b1img[0] = 0x01;
    const d = load(b1img, MOD_MIN_LEN);
    assert d.err == ERR_BAD_MAGIC;
    assert d.nfunc == 0 and d.nexport == 0;
}

test bad_version_gives_the_bad_version_code {
    var b2img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_MIN_LEN) : (i = i + 1) { b2img[i] = MOD_MIN[i]; }
    b2img[4] = 0x02;
    const d = load(b2img, MOD_MIN_LEN);
    assert d.err == ERR_BAD_VERSION;
}

test too_many_functions_gives_the_too_many_code {
    // header, then a function section (id 3, size 5) whose count is 0x7FFFFFFF
    var t1img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    t1img[1] = 0x61; t1img[2] = 0x73; t1img[3] = 0x6d; t1img[4] = 0x01;
    t1img[8] = 0x03; t1img[9] = 0x05;
    t1img[10] = 0xff; t1img[11] = 0xff; t1img[12] = 0xff; t1img[13] = 0xff; t1img[14] = 0x07;
    const d = load(t1img, 15);
    assert d.err == ERR_TOO_MANY;
    assert d.nfunc == 0;
}

test file_cut_after_the_section_size_gives_truncated {
    var c1img : [SRC_MAX]u8 = [0] ** SRC_MAX;
    var i : u32 = 0;
    while (i < MOD_MIN_LEN) : (i = i + 1) { c1img[i] = MOD_MIN[i]; }
    // the first 10 bytes: the header, the type section id 1 and its size 5, no payload
    const d = load(c1img, 10);
    assert d.err == ERR_TRUNCATED;
    // the array ends right after the section id: the size number itself is cut
    const e = load(c1img, 9);
    assert e.err == ERR_TRUNCATED;
    // fewer than 8 bytes cannot hold the header
    const h = load(c1img, 7);
    assert h.err == ERR_TRUNCATED;
    // an src_len above the array is refused, never clipped
    const big = load(c1img, 300);
    assert big.err == ERR_TOO_MANY;
}
