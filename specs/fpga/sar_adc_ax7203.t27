/// The Vout charge-transfer ratio of plate j (j = 0 is Bit_1) of the fitted DAC (bridge 1 unit, Cp 0.63 units): model_k(UNITS, 1.0, CP_FIT)[2 j + 1].
pub fn rom_k(j: u8) -> u32 {
    if (j == 0) { return 16083; }
    if (j == 1) { return 32166; }
    if (j == 2) { return 64332; }
    if (j == 3) { return 128665; }
    if (j == 4) { return 257329; }
    if (j == 5) { return 514658; }
    if (j == 6) { return 1029317; }
    if (j == 7) { return 2058633; }
    if (j == 8) { return 4117266; }
    return 8234532;
}

; --- the receipt: M0's line, with the fields of a conversion ---------------------------------------------
; hex_digit and pass_fail_char (board_receipt), frame, prefix_char (M0) are shared; the segments are these:
;   0 "T27 SAR"   1 " K=" + 2 hex   2 " C=" + 3 hex   3 " E=" + 3 hex   4 " N=" + 3 hex   5 " S=" + 16 hex   6 " L=" + 4 hex   7 " PASS\r\n"

pub const SAR_SEGS : u8 = 8;

/// The key letter of field s (1..6): K C E N S L.
pub fn sar_key(s: u8) -> u8 {
    if (s == 1) { return 75; }
    if (s == 2) { return 67; }
    if (s == 3) { return 69; }
    if (s == 4) { return 78; }
    if (s == 5) { return 83; }
    return 76;
}

/// The hex digits of field s (1..6).
pub fn sar_width(s: u8) -> u8 {
    if (s == 1) { return 2; }
    if (s == 5) { return 16; }
    if (s == 6) { return 4; }
    return 3;
}

/// The last position of segment s: the prefix and the verdict have 7 characters, a field has " X=" and its digits.
pub fn sar_seg_last(s: u8) -> u8 {
    if (s == 0) { return 6; }
    if (s == SAR_SEGS - 1) { return 6; }
    return 2 + sar_width(s);
}

/// Character p of "T27 SAR": M0's "T27 " and the name.
pub fn sar_prefix(p: u8) -> u8 {
    if (p < 4) { return prefix_char(p); }
    if (p == 4) { return 83; }
    if (p == 5) { return 65; }
    return 82;
}

/// The character at segment s, position p; `fsr` holds the field being written, its next nibble on top.
pub fn sar_char(s: u8, p: u8, fsr: u64, v: u8) -> u8 {
    if (s == 0) { return sar_prefix(p); }
    if (s == SAR_SEGS - 1) { return pass_fail_char(v, p); }
    if (p == 0) { return 32; }
    if (p == 1) { return sar_key(s); }
    if (p == 2) { return 61; }
    return hex_digit((fsr >> 60) as u8);
}

/// Field s (1..6) placed at the top of the 64-bit register, so that its first digit is nibble 15: 4 * (16 - width) bits up.
pub fn sar_top(s: u8, k: u8, c: u32, e: u32, n: u32, sum: u64, l: u32) -> u64 {
    if (s == 1) { return (k as u64) << 56; }
    if (s == 2) { return (c as u64) << 52; }
    if (s == 3) { return (e as u64) << 52; }
    if (s == 4) { return (n as u64) << 52; }
    if (s == 5) { return sum; }
    return (l as u64) << 48;
}

; --- the board ----------------------------------------------------------------------------------

/// A differential input buffer (the 200 MHz oscillator on R4/T4).
pub struct IbufdsOut { O: bool }
pub fn IBUFDS(I: bool, IB: bool) -> IbufdsOut {}

; --- the pins in --------------------------------------------------------------------------------
const clk200_p : bool = undefined;
const clk200_p_LOC : str = "R4";
const clk200_p_IOSTANDARD : str = "DIFF_SSTL15";
const clk200_n : bool = undefined;
const clk200_n_LOC : str = "T4";
const clk200_n_IOSTANDARD : str = "DIFF_SSTL15";
const cpu_reset_n : bool = undefined;
const cpu_reset_n_LOC : str = "T6";
const cpu_reset_n_IOSTANDARD : str = "LVCMOS15";

; --- the clock and the reset: M0's, unchanged ---------------------------------------------------
const clkbuf : IbufdsOut = IBUFDS(clk200_p, clk200_n);
const clkbuf_O_PERIOD_PS : u32 = 5000;
const pll : PllOut = PLLE2_ADV(clkbuf.O, pll.CLKFBOUT, false, false, 5.0, 0.01, 8, 1, 16, 0, "FALSE");
const gclk : BufgOut = BUFG(pll.CLKOUT0);
const gclk_O_PERIOD_PS : u32 = 10000;

const btn : IbufOut = IBUF(cpu_reset_n);

// No asynchronous reset (M0, M1b): the button and LOCKED pass two registers, they set the restart request, and on the next
// edge on_clock puts the machine back at its start.
const clk : bool = gclk.O;
const rst_n : bool = true;
const en : bool = true;

; --- the registers ------------------------------------------------------------------------------
var st : u8 = 0;
var ph : u8 = 0;
var cv : u8 = 0;
var dc : u8 = 0;
var xp : u32 = 0;
var xn : u32 = 0;
var xnn : u32 = 0;
var td : u32 = 0;
var dd : u32 = 0;
var bt : bool = false;
var code : u32 = 0;
var ex : u32 = 0;
var ng : u32 = 0;
var mc : u64 = 0;
var pacc : u64 = 0;
var rnd : u32 = 0;
var cs : u64 = 0;
var verdict : u8 = 1;
var baud_div : u16 = 868;
var tx_cnt : u16 = 0;
var tx_sh : u16 = 1023;
var tx_left : u8 = 0;
var seg : u8 = 0;
var upos : u8 = 0;
var fsr : u64 = 0;
var lines : u32 = 0;
var last : bool = false;
var hard : bool = false;
var fin : bool = false;
var hb : u32 = 0;
var go0 : bool = false;
var go1 : bool = false;

; --- the pins out: registers, set from the state one clock later (a pub var is an output reg) ----
pub var uart_tx : bool = true;
const uart_tx_LOC : str = "N15";
const uart_tx_IOSTANDARD : str = "LVCMOS33";
pub var led_0 : bool = true;
const led_0_LOC : str = "B13";
const led_0_IOSTANDARD : str = "LVCMOS33";
pub var led_1 : bool = true;
const led_1_LOC : str = "C13";
const led_1_IOSTANDARD : str = "LVCMOS33";
pub var led_2 : bool = true;
const led_2_LOC : str = "D14";
const led_2_IOSTANDARD : str = "LVCMOS33";
pub var led_3 : bool = false;
const led_3_LOC : str = "D15";
const led_3_IOSTANDARD : str = "LVCMOS33";

// Every var is read before it is written, so the test's order and the clock edge agree.
fn on_clock(pll_LOCKED: bool, btn_O: bool) {
    uart_tx = st != ST_REPORT or (tx_sh & 1) == 1;
    led_0 = st != ST_REPORT;
    led_1 = !(st == ST_REPORT and verdict == V_FAIL);
    led_2 = !(st == ST_REPORT and verdict == V_PASS);
    led_3 = ((hb >> 27) & 1) == 1;
    hb = hb + 1;
    if (fin) {
        if (hard) {
            cv = 0;
            lines = 0;
            cs = 0;
            hard = false;
        } else {
            if (cv == CONVS - 1) { cs = 0; }
            cv = next_cv(cv);
        }
        st = ST_RUN;
        ph = P_SMP;
        dc = 0;
        code = 0;
        verdict = V_FAIL;
        tx_cnt = 0;
        tx_sh = 1023;
        tx_left = 0;
        seg = 0;
        upos = 0;
        fsr = 0;
        last = false;
        fin = false;
    } else if (st == ST_RUN) {
        if (ph == P_SMP) {
            xp = rom_vp(cv);
            xn = rom_vn(cv);
            ex = rom_exp(cv);
            ng = rom_ng(cv);
            ph = P_NEG;
        } else if (ph == P_NEG) {
            xnn = neg_word(xn);
            ph = P_DIFF;
        } else if (ph == P_DIFF) {
            td = add_sm(xp, xnn);
            ph = P_DEC;
        } else if (ph == P_DEC) {
            dd = add_sm(td, OFF_WORD);
            ph = P_BIT;
        } else if (ph == P_BIT) {
            bt = is_above(dd);
            if (is_above(dd)) {
                code = (code << 1) | 1;
            } else {
                code = code << 1;
            }
            if (dc == DEC_LAST) {
                st = ST_JUDGE;
            } else {
                mc = rom_k(PLATE_LAST - dc) as u64;
                ph = P_MUL;
            }
        } else if (ph == P_MUL) {
            pacc = (mc << 23) + (mc << 22);
            ph = P_RND;
        } else if (ph == P_RND) {
            rnd = round_back(pacc);
            ph = P_APP;
        } else {
            xp = add_sm(xp, pack(rnd, bt));
            xn = add_sm(xn, pack(rnd, !bt));
            dc = dc + 1;
            ph = P_NEG;
        }
    } else if (st == ST_JUDGE) {
        verdict = sar_verdict(code, ex);
        cs = fold(cs, code);
        st = ST_REPORT;
    } else {
        if (tx_cnt != 0) {
            tx_cnt = tx_cnt - 1;
        } else {
            tx_cnt = baud_div - 1;
            if (tx_left != 0) {
                if (last and tx_left == 1) { fin = true; }
                tx_sh = (tx_sh >> 1) | 512;
                tx_left = tx_left - 1;
            } else {
                tx_sh = frame(sar_char(seg, upos, fsr, verdict));
                tx_left = 9;
                if (upos == sar_seg_last(seg)) {
                    fsr = sar_top(seg + 1, cv, code, ex, ng, cs, lines);
                    upos = 0;
                    if (seg == SAR_SEGS - 1) {
                        seg = 0;
                        lines = lines + 1;
                        last = true;
                    } else {
                        seg = seg + 1;
                    }
                } else {
                    if (seg != 0 and seg != SAR_SEGS - 1 and upos >= 3) { fsr = fsr << 4; }
                    upos = upos + 1;
                }
            }
        }
    }
    if (!go1) {
        fin = true;
        hard = true;
    }
    go1 = go0;
    go0 = pll_LOCKED and btn_O;
}

; --- test-only helpers (the hardware does not reach them) ----------------------------------------------

/// The machine as the button leaves it, then conversion `first` selected (the start of a conversion).
fn boot(first: u8) {
    go0 = true;
    go1 = false;
    on_clock(true, true);
    on_clock(true, true);
    cv = first;
}

/// Runs conversion i from reset to its verdict state; the clocks it took, P_SMP to ST_JUDGE.
fn run_conv(i: u8) -> u32 {
    boot(i);
    var n : u32 = 0;
    while (st == ST_RUN and n < 1000) {
        on_clock(true, true);
        n = n + 1;
    }
    return n;
}

/// Runs the machine on conversion i from reset, beside the spec's own sequence on the ratio words kk with both nodes of both halves
/// (M4a's events, the comparator word `off`), and counts the disagreements: Vout of each half before every decision, the code so far
/// before every decision, and the final code. The machine is left in ST_JUDGE.
fn board_vs_spec(i: u8, kk: []const u32, off: u32) -> u32 {
    boot(i);
    const s0 : u32 = q_sm(S_VP[i as usize]);
    const s1 : u32 = q_sm(S_VN[i as usize]);
    var rp : [2]u32 = [s0, s0];
    var rn : [2]u32 = [s1, s1];
    var qp : [2]u32 = [0, 0];
    var qn : [2]u32 = [0, 0];
    var bad : u32 = 0;
    var want : u32 = 0;
    var d : usize = 0;
    while (d < DECISIONS) {
        while (st == ST_RUN and !(ph == P_NEG and (dc as usize) == d)) { on_clock(true, true); }
        if (xp != rp[1]) { bad = bad + 1; }
        if (xn != rn[1]) { bad = bad + 1; }
        if (code != want) { bad = bad + 1; }
        const b : bool = decide(rp[1], rn[1], off);
        want = want * 2;
        if (b) { want = want + 1; }
        if (d < PLATES) {
            const j : usize = PLATES - 1 - d;
            event_k(kk, j, plate_step(!b), &rp, &qp);
            event_k(kk, j, plate_step(b), &rn, &qn);
            rp[0] = qp[0];
            rp[1] = qp[1];
            rn[0] = qn[0];
            rn[1] = qn[1];
        }
        d = d + 1;
    }
    while (st == ST_RUN) { on_clock(true, true); }
    if (code != want) { bad = bad + 1; }
    return bad;
}

/// The value of the n hex digits of buf from position at.
fn hex_at(buf: []const u8, at: usize, n: usize) -> u64 {
    var v : u64 = 0;
    var k : usize = 0;
    while (k < n) {
        const c : u8 = buf[at + k];
        if (c >= 65) {
            v = (v << 4) | ((c - 55) as u64);
        } else {
            v = (v << 4) | ((c - 48) as u64);
        }
        k = k + 1;
    }
    return v;
}

/// The characters a line has: M0's prefix and verdict (7 each), a segment per field.
pub const LINE_LEN : usize = 63;

; --- the tests ----------------------------------------------------------------------------------

test the_roms_are_the_specs_tables_word_for_word {
    var i : usize = 0;
    var same : u32 = 0;
    while (i < N_CONV) {
        assert_eq(rom_vp(i as u8), q_sm(S_VP[i]));
        assert_eq(rom_vn(i as u8), q_sm(S_VN[i]));
        assert_eq(rom_exp(i as u8), FIT_CODE[i]);
        assert_eq(rom_ng(i as u8), NG_CODE[i]);
        if (FIT_CODE[i] == NG_CODE[i]) { same = same + 1; }
        i = i + 1;
    }
    // the spec's fitted codes are 30 of the 31 ngspice ones; the one miss is conversion 25
    assert_eq(same, 30);
    assert(FIT_CODE[25] != NG_CODE[25]);
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    var j : usize = 0;
    while (j < PLATES) {
        assert_eq(rom_k(j as u8), kf[2 * j + 1]);
        j = j + 1;
    }
    assert_eq(OFF_WORD, q_sm(OFF_FIT_V));
    assert_eq(CONVS as usize, N_CONV);
    assert_eq(DECS as usize, DECISIONS);
    assert_eq((DEC_LAST as usize) + 1, DECISIONS);
    assert_eq((PLATE_LAST as usize) + 1, PLATES);
    assert_eq(next_cv(CONVS - 1), 0);
    assert_eq(next_cv(0), 1);
    assert_eq(next_cv(29), 30);
    // VCM is two shifted adds: 0.75 V = 2^23 + 2^22 in units of 2^-24 V
    const one : u64 = 1;
    assert_eq((one << 23) + (one << 22), VCM as u64);
    // a word of any table changed by one LSB is seen by the comparison above
    assert(rom_k(3) + 1 != kf[7]);
    assert(rom_vp(8) + 1 != q_sm(S_VP[8]));
}

test a_plate_step_is_the_specs_dac_event_for_every_plate {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    var j : usize = 0;
    while (j < PLATES) {
        const m : u64 = rom_k(j as u8) as u64;
        const a : u64 = (m << 23) + (m << 22);
        assert_eq(a, prod(rom_k(j as u8), VCM));
        var x : [2]u32 = [0, 0];
        var y : [2]u32 = [0, 0];
        event_k(&kf, j, plate_step(true), &x, &y);
        assert_eq(y[1], pack(round_back(a), false));
        event_k(&kf, j, plate_step(false), &x, &y);
        assert_eq(y[1], pack(round_back(a), true));
        j = j + 1;
    }
}

test the_three_clock_decision_is_the_specs_decide {
    var vs : [10]u32 = [0, 1, 5, NEG | 1, NEG | 5, OFF_WORD, NEG | OFF_WORD, OFF_WORD - 1, OFF_WORD + 1, 12582912];
    var i : usize = 0;
    var j : usize = 0;
    var above : u32 = 0;
    while (i < 10) {
        j = 0;
        while (j < 10) {
            const p : u32 = vs[i];
            const n : u32 = vs[j];
            assert_eq(is_above(add_sm(add_sm(p, neg_word(n)), OFF_WORD)), decide(p, n, OFF_WORD));
            if (decide(p, n, OFF_WORD)) { above = above + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    // some pairs decide above and some do not, so the comparison above is not about one answer
    assert(above > 20);
    assert(above < 80);
    var k : usize = 0;
    while (k < N_CONV) {
        const p : u32 = rom_vp(k as u8);
        const n : u32 = rom_vn(k as u8);
        assert_eq(is_above(add_sm(add_sm(p, neg_word(n)), OFF_WORD)), decide(p, n, OFF_WORD));
        assert_eq(is_above(add_sm(add_sm(n, neg_word(p)), OFF_WORD)), decide(n, p, OFF_WORD));
        k = k + 1;
    }
    assert(!is_above(0));
    assert(!is_above(NEG | 5));
    assert(is_above(1));
    assert(is_above(MAG));
    assert_eq(sar_verdict(5, 5), V_PASS);
    assert_eq(sar_verdict(5, 6), V_FAIL);
}

test the_machine_gives_the_specs_code_for_all_31_conversions {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    const off : u32 = q_sm(OFF_FIT_V);
    var i : usize = 0;
    var ngmatch : u32 = 0;
    while (i < N_CONV) {
        assert_eq(board_vs_spec(i as u8, &kf, off), 0);
        assert_eq(st, ST_JUDGE);
        assert_eq(code, convert_sar(&kf, q_sm(S_VP[i]), q_sm(S_VN[i]), off));
        assert_eq(code, FIT_CODE[i]);
        assert_eq(ex, FIT_CODE[i]);
        assert_eq(ng, NG_CODE[i]);
        on_clock(true, true);
        assert_eq(st, ST_REPORT);
        assert_eq(verdict, V_PASS);
        if (code == NG_CODE[i]) { ngmatch = ngmatch + 1; }
        i = i + 1;
    }
    assert_eq(ngmatch, 30);
}

test a_conversion_takes_the_same_clocks_for_every_sample {
    var i : usize = 0;
    while (i < N_CONV) {
        assert_eq(run_conv(i as u8), CONV_CLOCKS);
        assert_eq(st, ST_JUDGE);
        assert_eq(dc, DEC_LAST);
        i = i + 1;
    }
    // the clocks are 1 (P_SMP) + 10 decisions of 7 + the last decision's 4
    assert_eq(CONV_CLOCKS, 1 + 10 * 7 + 4);
    // the code is eleven bits: it never reaches 2048
    assert(code < 2048);
}

test one_more_unit_on_the_lsb_plate_fails_exactly_where_predicted {
    const kf : [20]u32 = model_k(&UNITS, 1.0, CP_FIT);
    const off : u32 = q_sm(OFF_FIT_V);
    var kb : [20]u32 = kf;
    kb[2 * (FAULT_J as usize) + 1] = FAULT_WORD;
    assert_eq(FAULT_WORD, 2 * rom_k(FAULT_J));
    assert(FAULT_WORD != rom_k(FAULT_J));
    // the spec's converter on the changed table: the pinned codes, and FAIL on the pinned conversions
    var mask : u32 = 0;
    var fails : u32 = 0;
    var bitv : u32 = 1;
    var i : usize = 0;
    while (i < N_CONV) {
        const c : u32 = convert_sar(&kb, q_sm(S_VP[i]), q_sm(S_VN[i]), off);
        assert_eq(c, FAULT_CODE[i]);
        if (sar_verdict(c, FIT_CODE[i]) == V_FAIL) {
            mask = mask | bitv;
            fails = fails + 1;
        }
        bitv = bitv << 1;
        i = i + 1;
    }
    assert_eq(mask, FAULT_MASK);
    assert_eq(fails, FAULT_FAILS);
    // 16 FAIL and 15 PASS: the verdict is per conversion, not one answer for the run
    assert_eq(fails + 15, 31);
    // the machine with the right ROM disagrees with the changed table's converter on exactly those conversions
    var dis : u32 = 0;
    var dmask : u32 = 0;
    bitv = 1;
    i = 0;
    while (i < N_CONV) {
        run_conv(i as u8);
        if (code != convert_sar(&kb, q_sm(S_VP[i]), q_sm(S_VN[i]), off)) {
            dis = dis + 1;
            dmask = dmask | bitv;
        }
        bitv = bitv << 1;
        i = i + 1;
    }
    assert_eq(dis, FAULT_FAILS);
    assert_eq(dmask, FAULT_MASK);
}

test the_specs_own_two_controls_fail_every_line {
    const off : u32 = q_sm(OFF_FIT_V);
    // the bridge of 2 units, and Bit_8 with 3 units, each as the spec derives its whole table
    const kb : [20]u32 = model_k(&UNITS, 2.0, CP_FIT);
    var bad : [10]u32 = UNITS;
    bad[7] = 3;
    const ku : [20]u32 = model_k(&bad, 1.0, CP_FIT);
    var i : usize = 0;
    var failb : u32 = 0;
    var failu : u32 = 0;
    while (i < N_CONV) {
        if (sar_verdict(convert_sar(&kb, q_sm(S_VP[i]), q_sm(S_VN[i]), off), FIT_CODE[i]) == V_FAIL) { failb = failb + 1; }
        if (sar_verdict(convert_sar(&ku, q_sm(S_VP[i]), q_sm(S_VN[i]), off), FIT_CODE[i]) == V_FAIL) { failu = failu + 1; }
        i = i + 1;
    }
    assert_eq(failb, 31);
    assert_eq(failu, 31);
}

test the_run_starts_after_lock_and_button_and_restarts_on_the_button {
    go0 = false;
    go1 = false;
    st = ST_REPORT;
    lines = 5;
    cv = 17;
    cs = 99;
    on_clock(false, true);
    on_clock(true, false);
    on_clock(false, false);
    assert_eq(st, ST_RUN);
    assert_eq(ph, P_SMP);
    assert_eq(lines, 0);
    assert_eq(cv, 0);
    assert_eq(cs, 0);
    on_clock(true, true);
    assert_eq(ph, P_SMP);
    on_clock(true, true);
    assert_eq(ph, P_SMP);
    on_clock(true, true);
    assert_eq(ph, P_SMP);
    on_clock(true, true);
    assert_eq(ph, P_NEG);
    assert_eq(xp, rom_vp(0));
    assert_eq(xn, rom_vn(0));
    assert_eq(ex, rom_exp(0));
    assert_eq(ng, rom_ng(0));
    var k : u32 = 0;
    while (st == ST_RUN) {
        on_clock(true, true);
        k = k + 1;
    }
    assert_eq(k, CONV_CLOCKS - 1);
    assert_eq(code, FIT_CODE[0]);
    on_clock(true, true);
    assert_eq(st, ST_REPORT);
    assert_eq(verdict, V_PASS);
    assert_eq(cs, FIT_CODE[0] as u64);
    // the button again: back to conversion 0, line 0, the fold cleared
    cv = 9;
    lines = 3;
    on_clock(true, false);
    on_clock(true, true);
    on_clock(true, true);
    assert_eq(st, ST_REPORT);
    on_clock(true, true);
    assert_eq(st, ST_RUN);
    assert_eq(cv, 0);
    assert_eq(lines, 0);
    assert_eq(cs, 0);
    assert_eq(verdict, V_FAIL);
}

test the_pins_show_the_state_one_clock_later {
    go0 = true;
    go1 = true;
    last = false;
    fin = false;
    st = ST_REPORT;
    verdict = V_PASS;
    tx_sh = 1022;
    tx_cnt = 5;
    hb = 0x08000000;
    on_clock(true, true);
    assert(!uart_tx);
    assert(!led_0);
    assert(led_1);
    assert(!led_2);
    assert(led_3);
    verdict = V_FAIL;
    tx_sh = 1023;
    on_clock(true, true);
    assert(uart_tx);
    assert(!led_1);
    assert(led_2);
    st = ST_JUDGE;
    on_clock(true, true);
    assert(uart_tx);
    assert(led_0);
    assert(led_1);
}

test the_receipt_segments_add_up_to_a_63_character_line {
    var n : usize = 0;
    var s : u8 = 0;
    while (s < SAR_SEGS) {
        n = n + (sar_seg_last(s) as usize) + 1;
        s = s + 1;
    }
    assert_eq(n, LINE_LEN);
    // the fields: widths, and the keys K C E N S L
    assert_eq(sar_width(1), 2);
    assert_eq(sar_width(2), 3);
    assert_eq(sar_width(5), 16);
    assert_eq(sar_width(6), 4);
    assert_eq(sar_key(1), 75);
    assert_eq(sar_key(6), 76);
    // every field sits at the top of the register: its first digit is nibble 15
    assert_eq(sar_top(1, 30, 0, 0, 0, 0, 0) >> 56, 30);
    assert_eq(sar_top(2, 0, 2047, 0, 0, 0, 0) >> 52, 2047);
    assert_eq(sar_top(3, 0, 0, 1000, 0, 0, 0) >> 52, 1000);
    assert_eq(sar_top(4, 0, 0, 0, 1862, 0, 0) >> 52, 1862);
    assert_eq(sar_top(5, 0, 0, 0, 0, 0x0123456789ABCDEF, 0), 0x0123456789ABCDEF);
    assert_eq(sar_top(6, 0, 0, 0, 0, 0, 0xABCD) >> 48, 0xABCD);
    assert_eq(ROUND_FOLD, 0xADF99975C7);
    var f : u64 = 0;
    var i : usize = 0;
    while (i < N_CONV) {
        f = fold(f, FIT_CODE[i]);
        i = i + 1;
    }
    assert_eq(f, ROUND_FOLD);
}

test the_board_prints_31_passing_lines_then_goes_round_again {
    boot(0);
    baud_div = 1;
    var buf : [64]u8 = [0] ** 64;
    var got : usize = 0;
    var line : u32 = 0;
    var ch : u8 = 0;
    var ticks : u32 = 0;
    var want : u64 = 0;
    var kk : usize = 0;
    var passes : u32 = 0;
    while (line < 63 and ticks < 3000000) {
        on_clock(true, true);
        ticks = ticks + 1;
        if (st == ST_REPORT and tx_left == 9) {
            ch = ((tx_sh >> 1) & 255) as u8;
            buf[got] = ch;
            got = got + 1;
            if (ch == 10) {
                assert_eq(got, LINE_LEN);
                kk = (line % 31) as usize;
                if (kk == 0) { want = 0; }
                want = fold(want, FIT_CODE[kk]);
                // "T27 SAR"
                assert_eq(buf[0], 84);
                assert_eq(buf[1], 50);
                assert_eq(buf[2], 55);
                assert_eq(buf[3], 32);
                assert_eq(buf[4], 83);
                assert_eq(buf[5], 65);
                assert_eq(buf[6], 82);
                // " K=", " C=", " E=", " N=", " S=", " L=": a space, the key, an equals sign, then the digits
                assert_eq(buf[7], 32);
                assert_eq(buf[8], 75);
                assert_eq(buf[9], 61);
                assert_eq(buf[12], 32);
                assert_eq(buf[13], 67);
                assert_eq(buf[14], 61);
                assert_eq(buf[18], 32);
                assert_eq(buf[19], 69);
                assert_eq(buf[20], 61);
                assert_eq(buf[24], 32);
                assert_eq(buf[25], 78);
                assert_eq(buf[26], 61);
                assert_eq(buf[30], 32);
                assert_eq(buf[31], 83);
                assert_eq(buf[32], 61);
                assert_eq(buf[49], 32);
                assert_eq(buf[50], 76);
                assert_eq(buf[51], 61);
                assert_eq(hex_at(&buf, 10, 2), kk as u64);
                assert_eq(hex_at(&buf, 15, 3), FIT_CODE[kk] as u64);
                assert_eq(hex_at(&buf, 21, 3), FIT_CODE[kk] as u64);
                assert_eq(hex_at(&buf, 27, 3), NG_CODE[kk] as u64);
                assert_eq(hex_at(&buf, 33, 16), want);
                assert_eq(hex_at(&buf, 52, 4), line as u64);
                // " PASS\r\n"
                assert_eq(buf[56], 32);
                assert_eq(buf[57], 80);
                assert_eq(buf[58], 65);
                assert_eq(buf[59], 83);
                assert_eq(buf[60], 83);
                assert_eq(buf[61], 13);
                assert_eq(buf[62], 10);
                passes = passes + 1;
                if (kk == 30) { assert_eq(want, ROUND_FOLD); }
                got = 0;
                line = line + 1;
            }
        }
    }
    assert_eq(line, 63);
    assert_eq(lines, 63);
    assert_eq(passes, 63);
    baud_div = BAUD_DIV;
}

test a_wrong_code_prints_fail_and_the_leds_follow {
    boot(25);
    baud_div = 1;
    var buf : [64]u8 = [0] ** 64;
    var got : usize = 0;
    var ch : u8 = 0;
    var ticks : u32 = 0;
    var seen : u32 = 0;
    while (st == ST_RUN) { on_clock(true, true); }
    // the machine has the right code; E is changed by one before the verdict, as if the board had misconverted
    ex = ex + 1;
    while (seen == 0 and ticks < 100000) {
        on_clock(true, true);
        ticks = ticks + 1;
        if (st == ST_REPORT and tx_left == 9) {
            ch = ((tx_sh >> 1) & 255) as u8;
            buf[got] = ch;
            got = got + 1;
            if (ch == 10) { seen = 1; }
        }
    }
    assert_eq(seen, 1);
    assert_eq(got, LINE_LEN);
    // K=19 is conversion 25: C is the board's 1841, E the changed 1842 (which is also what ngspice gave), N 1842
    assert_eq(hex_at(&buf, 10, 2), 25);
    assert_eq(hex_at(&buf, 15, 3), 1841);
    assert_eq(hex_at(&buf, 21, 3), 1842);
    assert_eq(hex_at(&buf, 27, 3), 1842);
    assert_eq(buf[56], 32);
    assert_eq(buf[57], 70);
    assert_eq(buf[58], 65);
    assert_eq(buf[59], 73);
    assert_eq(buf[60], 76);
    baud_div = BAUD_DIV;
}
