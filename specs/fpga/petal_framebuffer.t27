// SPDX-License-Identifier: Apache-2.0
; specs/fpga/petal_framebuffer.t27 -- the rasteriser of T27 OS's home for video scan-out (M5, epic gHashTag/t27#10782).
; The home of T27 OS is the 27-petal triangle of specs/t27f/petal_menu.t27 (M1 spec, icarus-lowerable since
; #10786). This spec draws it as pixels: petal_at(x, y) names the petal under a VGA pixel and pixel_color(x, y,
; petal_open) gives the palette index of that pixel at rest or open. Nothing here guesses: the geometry is
; petal_menu's through `use` (the ray-cast hit test on the 27 quads, the fit and the viewport mapping included),
; the 640x480 raster is fpga::vga_text_core's, and the palette's RGB words are petal_menu's REALM_RGB order.
; This spec adds NO timing constant, NO board pin and NO top module (fpga/HARDWARE_SSOT.md: the connector and its
; pin table are still not established, and no bitstream from this file has met the bench -- the bench-side
; synthesis and the die readback are M6's work, not this spec's).
; -
; THE RASTER. FB_W x FB_H = vga_text_core's H_VISIBLE x V_VISIBLE (640 x 480 visible pixels). petal_at answers
; exactly what petal_menu.hit_px answers for that viewport as one: the petal id 0..26, or petal_menu.PETAL_NONE
; (255) for the background. The background value is petal_menu's own protocol, carried not remapped: a scan-out
; only reads pixel_color, which turns it into BG.
; -
; THE INDEXES. pixel_color returns a palette index; pal_rgb gives every index its RGB word:
;   0 = BG         -- outside every petal quad: black, the colour the material rule gives the window.
;   1..3 = realms  -- a petal's interior at rest: its realm's colour, RAZUM and MATERIYA and DUKH in
;                     petal_menu's REALM_RGB order (the same RGB triplet petal_menu's OPEN fill carries; the
;                     trios glass resolves its alpha over the black window, a scan-out carries the colour).
;   4 = OPEN       -- the petal petal_open names: white, the RGB_WHITE of petal_menu's whole outline family.
; -
; WHAT A PASS SAYS: petal_at is pure and total (every pixel inside the visible raster answers SOME petal or the
; background), the pixel whose box point is every petal's vertex-mean centre hits that petal exactly through the
; same fit petal_menu computes, and every index's RGB word equals the triplet petal_menu's fills carry.
; WHAT IT DOES NOT SAY: the glass backdrop of the trios home (petal_glass, f64, not lowered), the 1 px outline
; stroke (M6), the card menus of an open petal (L7's panel composition is host-side), and any connector, timing
; or board top. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaPetalFramebuffer;

use fpga::vga_text_core;
use t27f::petal_menu;

pub const FB_W : u32 = vga_text_core.H_VISIBLE;
pub const FB_H : u32 = vga_text_core.V_VISIBLE;
pub const HOME_PETALS : u32 = petal_menu.PETAL_COUNT;

pub const BG : u32 = 0;
pub const RAZUM_PX : u32 = 1;
pub const MATERIYA_PX : u32 = 2;
pub const DUKH_PX : u32 = 3;
pub const OPEN_PX : u32 = 4;

; The petal under the visible VGA pixel (x, y), or petal_menu's PETAL_NONE for the background.
pub fn petal_at(x : u32, y : u32) -> u32 {
    return petal_menu.hit_px(x, y, FB_W, FB_H);
}

; The palette index of the pixel (x, y) in the home at the state petal_open (STATE_HOME is the rest state).
pub fn pixel_color(x : u32, y : u32, petal_open : u32) -> u32 {
    const p : u32 = petal_at(x, y);
    if (p == petal_menu.PETAL_NONE) {
        return BG;
    }
    if (p == petal_open) {
        return OPEN_PX;
    }
    return 1 + petal_menu.realm(p);
}

; The RGB word of palette index i, from petal_menu's own colour constants; an unknown index falls to black.
pub fn pal_rgb(i : u32) -> u32 {
    if (i == OPEN_PX) {
        return petal_menu.RGB_WHITE;
    }
    if (i >= RAZUM_PX and i <= DUKH_PX) {
        return petal_menu.REALM_RGB[i - RAZUM_PX];
    }
    return 0;
}

; TEST FIXTURES (private, not lowered as the pixel path): the inverse of petal_menu.to_box at the fit of this
; viewport, so the test vectors carry no hand-typed coordinates. The fit is computed through petal_menu's own
; fit_permille, the origin is the raster centre, the scale petal_menu's own.
fn fit_here() -> i64 {
    return petal_menu.fit_permille(FB_W, FB_H);
}

fn centre_pixel_x(p : u32) -> i64 {
    const off : i64 = petal_menu.centre_x(p) - petal_menu.BOX_CX;
    return FB_W / 2 + off * fit_here() / 1000000;
}

fn centre_pixel_y(p : u32) -> i64 {
    const off : i64 = petal_menu.centre_y(p) - petal_menu.BOX_CY;
    return FB_H / 2 + off * fit_here() / 1000000;
}

test the_corners_of_the_raster_are_background {
    assert petal_at(0, 0) == petal_menu.PETAL_NONE;
    assert petal_at(FB_W - 1, FB_H - 1) == petal_menu.PETAL_NONE;
    assert pixel_color(0, 0, petal_menu.STATE_HOME) == BG;
    assert pal_rgb(BG) == 0;
}

test the_centre_of_every_petal_is_that_petal_on_the_home {
    // the pixel whose box point is the petal's vertex-mean centre lands at most 1 px away from it, and the
    // centres sit well inside the quads, so the hit names exactly petal_menu's own hit answer for the centre.
    var p : u32 = 0;
    while (p < HOME_PETALS) {
        const px : i64 = centre_pixel_x(p);
        const py : i64 = centre_pixel_y(p);
        assert px >= 0;
        assert px < FB_W;
        assert py >= 0;
        assert py < FB_H;
        assert petal_at(@as(u32, @intCast(px)), @as(u32, @intCast(py))) == p;
        p = p + 1;
    }
}

test the_rest_state_shows_the_realm_colours_in_petal_menu_order {
    assert pal_rgb(RAZUM_PX) == petal_menu.REALM_RGB[0];
    assert pal_rgb(MATERIYA_PX) == petal_menu.REALM_RGB[1];
    assert pal_rgb(DUKH_PX) == petal_menu.REALM_RGB[2];
    assert pal_rgb(OPEN_PX) == petal_menu.RGB_WHITE;
}

test an_open_petal_turns_white_and_the_rest_keep_their_realm {
    const open : u32 = 5;
    // petal 5's own centre pixel: the inverse again, so the vectors need no hand-typed coordinates
    const px : i64 = centre_pixel_x(5);
    const py : i64 = centre_pixel_y(5);
    const pxu : u32 = @as(u32, @intCast(px));
    const pyu : u32 = @as(u32, @intCast(py));
    assert petal_at(pxu, pyu) == 5;
    assert pixel_color(pxu, pyu, open) == OPEN_PX;
    assert pal_rgb(pixel_color(pxu, pyu, open)) == petal_menu.RGB_WHITE;
    assert pixel_color(pxu, pyu, petal_menu.STATE_HOME) == 1 + petal_menu.realm(5);
    assert pal_rgb(pixel_color(pxu, pyu, petal_menu.STATE_HOME)) == petal_menu.REALM_RGB[0];
}

invariant petal_count_is_petal_menu_count {
    assert HOME_PETALS == 27;
    assert petal_menu.petal_ok(0);
    assert petal_menu.petal_ok(petal_menu.PETAL_NONE) == false;
}
