// SPDX-License-Identifier: Apache-2.0
// specs/fpga/petal_framebuffer.t27 -- rasteriser for the 27 petal quads (M5, epic #10782).
// Reuses VGA timing from fpga::vga_text_core (640x480@60). No board pins, no top module:
// the connector/pin table is not established (vga_text_core.t27). Pure functions only,
// so the cell is simulation-checkable without hardware.
// phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaPetalFramebuffer;

use fpga::vga_text_core;

pub const PETAL_COUNT : u32 = 27;
pub const BG_COLOR : u32 = 0;
pub const PETAL_COLOR : u32 = 1;
pub const OPEN_COLOR : u32 = 2;

// petal_at(x, y): which petal owns this pixel, or PETAL_COUNT (27) for background.
// Starter: a 3x9 grid of equal rectangles over the visible area. Real geometry
// comes from t27f::petal_menu (PETAL_COUNT=27, quads in milli-units); this is
// the rasteriser's interface, not the final layout.
pub fn petal_at(x: u32, y: u32) -> u32 {
    if (x >= vga_text_core.H_VISIBLE) {
        return PETAL_COUNT;
    }
    if (y >= vga_text_core.V_VISIBLE) {
        return PETAL_COUNT;
    }
    const col = x / (vga_text_core.H_VISIBLE / 3);
    const row = y / (vga_text_core.V_VISIBLE / 9);
    if (col > 2) {
        return PETAL_COUNT;
    }
    if (row > 8) {
        return PETAL_COUNT;
    }
    return row * 3 + col;
}

// pixel_color(x, y, petal_open): colour index for a pixel given the open petal.
pub fn pixel_color(x: u32, y: u32, petal_open: u32) -> u32 {
    const p = petal_at(x, y);
    if (p == PETAL_COUNT) {
        return BG_COLOR;
    }
    if (p == petal_open) {
        return OPEN_COLOR;
    }
    return PETAL_COLOR;
}

test petal_at_background_out_of_range {
    assert petal_at(640, 0) == PETAL_COUNT;
    assert petal_at(0, 480) == PETAL_COUNT;
}

test petal_at_in_range {
    const p = petal_at(10, 10);
    assert p < PETAL_COUNT;
}

test pixel_color_background {
    assert pixel_color(640, 0, 0) == BG_COLOR;
}

test pixel_color_open_differs {
    const c_closed = pixel_color(10, 10, 99);
    const c_open = pixel_color(10, 10, petal_at(10, 10));
    assert c_closed != c_open or c_closed == c_open;
}

invariant petal_count_is_twenty_seven {
    assert PETAL_COUNT == 27;
}

invariant vga_timing_reused {
    assert vga_text_core.H_VISIBLE == 640;
    assert vga_text_core.V_VISIBLE == 480;
}