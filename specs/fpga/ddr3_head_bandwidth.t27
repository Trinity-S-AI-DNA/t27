const core : LitedramOut = litedram_core(clkbuf.O, !cpu_reset_n, uart_rx, ci as u25, (st == ST_WRITE or st == ST_READ) and ci < n_beats, st == ST_WRITE, true, lane_word(di, 0), lane_word(di, 1), lane_word(di, 2), lane_word(di, 3), st == ST_WRITE and di < n_beats, 0xFFFFFFFF, ddram_dq_0, ddram_dq_1, ddram_dq_2, ddram_dq_3, ddram_dq_4, ddram_dq_5, ddram_dq_6, ddram_dq_7, ddram_dq_8, ddram_dq_9, ddram_dq_10, ddram_dq_11, ddram_dq_12, ddram_dq_13, ddram_dq_14, ddram_dq_15, ddram_dq_16, ddram_dq_17, ddram_dq_18, ddram_dq_19, ddram_dq_20, ddram_dq_21, ddram_dq_22, ddram_dq_23, ddram_dq_24, ddram_dq_25, ddram_dq_26, ddram_dq_27, ddram_dq_28, ddram_dq_29, ddram_dq_30, ddram_dq_31, ddram_dqs_n_0, ddram_dqs_n_1, ddram_dqs_n_2, ddram_dqs_n_3, ddram_dqs_p_0, ddram_dqs_p_1, ddram_dqs_p_2, ddram_dqs_p_3);
