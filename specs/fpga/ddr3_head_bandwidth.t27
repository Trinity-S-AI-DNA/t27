// SPDX-License-Identifier: Apache-2.0
; specs/fpga/ddr3_head_bandwidth.t27 -- how fast the AX7203's DDR3 gives back the head of the model
; Cell 26 of specs/igla/own_model.t27 ("Full model on FPGA, DDR3"), epic gHashTag/t27#10024, route (A) of
; gHashTag/t27#10170. The gate is a read of the head at 2.0 GB/s or more; below 1.5 GB/s the head moves to
; DSP48E1 and this route is killed.
; -
; WHAT THIS IS. A board top, written in t27 and lowered by `t27b verilog`, around a LiteDRAM core
; (litedram_core, generated by litedram_gen for A7DDRPHY, MT41J256M16, sys_clk 100 MHz). The core is the
; DDR3 controller and its calibrating BIOS; everything around it is this file: the pins, the traffic, the
; clock count, the checksum and the receipt on the UART. No constraint file and no Verilog are written by
; hand: every pin's placement and I/O standard is a PIN ATTRIBUTE below (specs/tri/t27b/verilog_plan.t27).
; -
; THE RUN. Wait for the core's init_done. Write the head, HEAD_BEATS beats of 32 bytes at addresses 0 ..
; HEAD_BEATS-1 of the native port, each beat four 64-bit lanes of a pattern no two beats or lanes share
; (lane_word). Then read it back at full rate, one command per clock when the core takes it, and count the
; clocks from the first read command to the last beat in. Every beat read is compared with the pattern
; (err) and folded into a checksum (rsum) in arrival order; the write pass folds the same sum (wsum). A
; 32-step divider turns the clock count into MB/s, and the verdict follows.
; -
; THE ARITHMETIC. The native port is 256 bits = 32 bytes per clock at 100 MHz: a peak of 3.2 GB/s
; (PEAK_MBPS). The head is 2.6M fp32 = 10,400,000 bytes = 325,000 beats. A pass of B bytes in C clocks of
; 10 ns is B * 100 / C MB/s. PASS is B * 100 >= 2000 * C (2.0 GB/s, 62.5 percent of peak); KILL is
; B * 100 < 1500 * C; between the two is SLOW; any beat read back wrong is FAIL, whatever the rate.
; GB here is 10^9 bytes.
; -
; THE RECEIPT. 115200 baud on N15, one line, sent again and again once the run is over:
;   T27 DDR3 N=<16 hex> W=<16 hex> R=<16 hex> M=<16 hex> S=<16 hex> C=<16 hex> E=<16 hex> L=<16 hex> PASS
; N beats, W write clocks, R read clocks, M MB/s, S write checksum, C read checksum, E bad beats, L the
; line's number; the verdict word is PASS, SLOW, KILL or FAIL. Until the run is over the UART is the
; core's BIOS, which prints its calibration.
; LEDs (active low): B13 init_done, C13 init_error, D14 PASS, D15 a heartbeat of the 100 MHz clock.
; The button T6 (active low) resets the core and so starts the run again.
; -
; PINS. The DDR3 pinout is litex-boards litex_boards/platforms/alinx_ax7203.py (it cites the ALINX AX7203
; user manual); clk200 R4/T4 and the UART N15/P20 are the pins fpga/HARDWARE_SSOT.md measured on the board
; (#7788), the LEDs are that file's. Each pin is a 1-bit port of its own, because a placement names one pin.
; -
; WHAT A PASS SAYS. This bitstream read 10,400,000 bytes it had just written to this board's DDR3, all of
; them correct, at the measured rate. WHAT IT DOES NOT SAY. Nothing about a model running: no weight is
; computed on, and the bytes are a pattern, not the head's values. Nothing about any rate but sequential
; reads of one 10.4 MB region after a sequential write of it.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaDdr3HeadBandwidth;

use fpga::board_receipt;

pub const KIND : str = "board-cell";
pub const ID : str = "fpga/ddr3_head_bandwidth";
pub const EPIC : str = "gHashTag/t27#10024";
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";

; --- the run ------------------------------------------------------------------------------------
pub const HEAD_BYTES : u64 = 10400000;
pub const BEAT_BYTES : u64 = 32;
pub const HEAD_BEATS : u32 = 325000;
pub const SYS_MHZ : u64 = 100;
pub const PEAK_MBPS : u64 = 3200;
pub const GATE_MBPS : u64 = 2000;
pub const KILL_MBPS : u64 = 1500;
pub const LANE_SALT : u64 = 0x9E3779B97F4A7C15;
/// What one beat adds to B * 100, the divider's numerator: BEAT_BYTES * SYS_MHZ.
pub const BEAT_X_MHZ : u32 = 3200;

pub const V_PASS : u8 = 0;
pub const V_SLOW : u8 = 1;
pub const V_KILL : u8 = 2;
pub const V_FAIL : u8 = 3;

pub const ST_WAIT : u8 = 0;
pub const ST_WRITE : u8 = 1;
pub const ST_READ : u8 = 2;
pub const ST_DIV : u8 = 3;
pub const ST_REPORT : u8 = 4;

pub const DIV_STEPS : u8 = 32;
pub const BAUD_DIV : u16 = 868;
pub const LINE_SEGS : u8 = 10;

; --- the arithmetic -----------------------------------------------------------------------------

/// Lane k (0..3) of beat i: (i << 2 | k) spread by two shifts and salted, so no two beats or lanes agree.
pub fn lane_word(i: u32, k: u32) -> u64 {
    const w : u64 = ((i as u64) << 2) | ((k & 3) as u64);
    return w ^ (w << 21) ^ (w << 42) ^ LANE_SALT;
}

; fold, the beat checksum, is specs/fpga/board_receipt.t27's, as hex_digit is: one body for every
; board spec. Its lane rotations matter: the four lanes of a beat of this pattern xor to zero (the salt
; four times, and (i << 2 | k) for k = 0..3 under every shift), so a plain xor of the lanes adds nothing
; and every sum is 0. The first bitstream on the board reported exactly that, S=0 C=0.

/// The beat's four lanes are the pattern of beat i.
pub fn beat_ok(i: u32, l0: u64, l1: u64, l2: u64, l3: u64) -> bool {
    return l0 == lane_word(i, 0) and l1 == lane_word(i, 1) and l2 == lane_word(i, 2) and l3 == lane_word(i, 3);
}

/// MB/s of `bytes` moved in `cycles` clocks of 10 ns, rounded down (the reference for the divider).
pub fn mbps_of(bytes: u64, cycles: u64) -> u64 {
    return (bytes * SYS_MHZ) / cycles;
}

/// The verdict of a read pass: FAIL on any bad beat, else by the rate against 2.0 and 1.5 GB/s.
pub fn verdict_of(bytes: u64, cycles: u64, bad: u32) -> u8 {
    if (bad != 0) { return V_FAIL; }
    if (bytes * SYS_MHZ >= GATE_MBPS * cycles) { return V_PASS; }
    if (bytes * SYS_MHZ < KILL_MBPS * cycles) { return V_KILL; }
    return V_SLOW;
}

/// The same verdict from the divider's quotient, which is what the board computes: no multiplier on the
/// clock count. B*100 >= 2000*C holds exactly when floor(B*100/C) >= 2000, and B*100 < 1500*C exactly when
/// floor(B*100/C) < 1500, because 2000 and 1500 are whole numbers.
pub fn verdict_by_rate(m: u32, bad: u32) -> u8 {
    if (bad != 0) { return V_FAIL; }
    if ((m as u64) >= GATE_MBPS) { return V_PASS; }
    if ((m as u64) < KILL_MBPS) { return V_KILL; }
    return V_SLOW;
}

/// One step of the restoring divider: the remainder after bringing down the top bit of `num`.
pub fn div_rem(rem: u64, num: u32, den: u32) -> u64 {
    const r : u64 = (rem << 1) | ((num >> 31) as u64);
    if (r >= (den as u64)) { return r - (den as u64); }
    return r;
}

/// The quotient after the same step.
pub fn div_q(q: u32, rem: u64, num: u32, den: u32) -> u32 {
    const r : u64 = (rem << 1) | ((num >> 31) as u64);
    if (r >= (den as u64)) { return (q << 1) | 1; }
    return q << 1;
}

; --- the receipt --------------------------------------------------------------------------------

/// The key letter of field s (1..8): N W R M S C E L.
pub fn key_of(s: u8) -> u8 {
    if (s == 1) { return 78; }
    if (s == 2) { return 87; }
    if (s == 3) { return 82; }
    if (s == 4) { return 77; }
    if (s == 5) { return 83; }
    if (s == 6) { return 67; }
    if (s == 7) { return 69; }
    return 76;
}

/// Character p of "T27 DDR3".
pub fn prefix_char(p: u8) -> u8 {
    if (p == 0) { return 84; }
    if (p == 1) { return 50; }
    if (p == 2) { return 55; }
    if (p == 3) { return 32; }
    if (p == 4 or p == 5) { return 68; }
    if (p == 6) { return 82; }
    return 51;
}

/// Character p of " <VERDICT>\r\n".
pub fn verdict_char(v: u8, p: u8) -> u8 {
    if (p == 0) { return 32; }
    if (p == 5) { return 13; }
    if (p == 6) { return 10; }
    if (v == V_PASS) {
        if (p == 1) { return 80; }
        if (p == 2) { return 65; }
        return 83;
    }
    if (v == V_SLOW) {
        if (p == 1) { return 83; }
        if (p == 2) { return 76; }
        if (p == 3) { return 79; }
        return 87;
    }
    if (v == V_KILL) {
        if (p == 1) { return 75; }
        if (p == 2) { return 73; }
        return 76;
    }
    if (p == 1) { return 70; }
    if (p == 2) { return 65; }
    if (p == 3) { return 73; }
    return 76;
}

/// The character at segment s, position p; `fsr` holds the field being written, its next nibble on top.
pub fn line_char(s: u8, p: u8, fsr: u64, v: u8) -> u8 {
    if (s == 0) { return prefix_char(p); }
    if (s == 9) { return verdict_char(v, p); }
    if (p == 0) { return 32; }
    if (p == 1) { return key_of(s); }
    if (p == 2) { return 61; }
    return hex_digit((fsr >> 60) as u8);
}

/// The last position of segment s.
pub fn seg_last(s: u8) -> u8 {
    if (s == 0) { return 7; }
    if (s == 9) { return 6; }
    return 18;
}

/// A UART frame, sent low bit first: a start bit 0, the 8 data bits, a stop bit 1.
pub fn frame(ch: u8) -> u16 {
    return ((ch as u16) << 1) | 512;
}

; --- the board ----------------------------------------------------------------------------------

/// A differential input buffer (the 200 MHz oscillator on R4/T4).
pub struct IbufdsOut { O: bool }
pub fn IBUFDS(I: bool, IB: bool) -> IbufdsOut {}

/// The outputs of the LiteDRAM core, as named in its generated Verilog.
pub struct LitedramOut { ddram_a__0: bool, ddram_a__1: bool, ddram_a__2: bool, ddram_a__3: bool, ddram_a__4: bool, ddram_a__5: bool, ddram_a__6: bool, ddram_a__7: bool, ddram_a__8: bool, ddram_a__9: bool, ddram_a__10: bool, ddram_a__11: bool, ddram_a__12: bool, ddram_a__13: bool, ddram_a__14: bool, ddram_ba__0: bool, ddram_ba__1: bool, ddram_ba__2: bool, ddram_dm__0: bool, ddram_dm__1: bool, ddram_dm__2: bool, ddram_dm__3: bool, ddram_cas_n: bool, ddram_cke: bool, ddram_clk_n: bool, ddram_clk_p: bool, ddram_cs_n: bool, ddram_odt: bool, ddram_ras_n: bool, ddram_reset_n: bool, ddram_we_n: bool, init_done: bool, init_error: bool, pll_locked: bool, uart_tx: bool, user_clk: bool, user_port_native_0_cmd_ready: bool, user_port_native_0_rdata_data__0: u64, user_port_native_0_rdata_data__1: u64, user_port_native_0_rdata_data__2: u64, user_port_native_0_rdata_data__3: u64, user_port_native_0_rdata_valid: bool, user_port_native_0_wdata_ready: bool, user_rst: bool }

/// The LiteDRAM core: a DDR3 controller with its PHY and PLL, a 256-bit native user port, and a BIOS on the UART
/// that calibrates the PHY before it raises init_done.
pub fn litedram_core(clk_: bool, rst: bool, uart_rx_: bool, user_port_native_0_cmd_addr: u25, user_port_native_0_cmd_valid: bool, user_port_native_0_cmd_we: bool, user_port_native_0_rdata_ready: bool, user_port_native_0_wdata_data__0: u64, user_port_native_0_wdata_data__1: u64, user_port_native_0_wdata_data__2: u64, user_port_native_0_wdata_data__3: u64, user_port_native_0_wdata_valid: bool, user_port_native_0_wdata_we: u32, ddram_dq__0: bool, ddram_dq__1: bool, ddram_dq__2: bool, ddram_dq__3: bool, ddram_dq__4: bool, ddram_dq__5: bool, ddram_dq__6: bool, ddram_dq__7: bool, ddram_dq__8: bool, ddram_dq__9: bool, ddram_dq__10: bool, ddram_dq__11: bool, ddram_dq__12: bool, ddram_dq__13: bool, ddram_dq__14: bool, ddram_dq__15: bool, ddram_dq__16: bool, ddram_dq__17: bool, ddram_dq__18: bool, ddram_dq__19: bool, ddram_dq__20: bool, ddram_dq__21: bool, ddram_dq__22: bool, ddram_dq__23: bool, ddram_dq__24: bool, ddram_dq__25: bool, ddram_dq__26: bool, ddram_dq__27: bool, ddram_dq__28: bool, ddram_dq__29: bool, ddram_dq__30: bool, ddram_dq__31: bool, ddram_dqs_n__0: bool, ddram_dqs_n__1: bool, ddram_dqs_n__2: bool, ddram_dqs_n__3: bool, ddram_dqs_p__0: bool, ddram_dqs_p__1: bool, ddram_dqs_p__2: bool, ddram_dqs_p__3: bool) -> LitedramOut {}

