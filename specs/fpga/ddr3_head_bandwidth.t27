; --- the registers ------------------------------------------------------------------------------
var st : u8 = 0;
var n_beats : u32 = 325000;
var ci : u32 = 0;
var di : u32 = 0;
var ri : u32 = 0;
var wcyc : u32 = 0;
var rcyc : u32 = 0;
var wsum : u64 = 0;
var rsum : u64 = 0;
var err : u32 = 0;
/// The beat the core gave on the last clock, checked on this one: the read data reach the compare and the
/// checksum from a register, not straight from the PHY (the first route put that path at 70 MHz).
var rv : bool = false;
var rb0 : u64 = 0;
var rb1 : u64 = 0;
var rb2 : u64 = 0;
var rb3 : u64 = 0;
var mbps : u32 = 0;
var verdict : u8 = 3;
var dnum : u32 = 0;
var drem : u64 = 0;
var dq : u32 = 0;
var dstep : u8 = 0;
var baud_div : u16 = 868;
var tx_cnt : u16 = 0;
var tx_sh : u16 = 1023;
var tx_left : u8 = 0;
var seg : u8 = 0;
var pos : u8 = 0;
var fsr : u64 = 0;
var lines : u32 = 0;
var hb : u32 = 0;

/// The value of receipt field s (1..8), N W R M S C E L.
pub fn field(s: u8, n: u32, w: u32, r: u32, m: u32, ws: u64, rs: u64, e: u32, l: u32) -> u64 {
    if (s == 1) { return n as u64; }
    if (s == 2) { return w as u64; }
    if (s == 3) { return r as u64; }
    if (s == 4) { return m as u64; }
    if (s == 5) { return ws; }
    if (s == 6) { return rs; }
    if (s == 7) { return e as u64; }
    return l as u64;
}

// Every var is read before it is written, so the test's order and the clock edge agree.
fn on_clock(core_init_done: bool, core_init_error: bool, core_user_port_native_0_cmd_ready: bool, core_user_port_native_0_wdata_ready: bool, core_user_port_native_0_rdata_valid: bool, core_user_port_native_0_rdata_data__0: u64, core_user_port_native_0_rdata_data__1: u64, core_user_port_native_0_rdata_data__2: u64, core_user_port_native_0_rdata_data__3: u64, core_uart_tx: bool) {
    uart_tx = (st == ST_REPORT and (tx_sh & 1) == 1) or (st != ST_REPORT and core_uart_tx);
    led_2 = !(st == ST_REPORT and verdict == V_PASS);
    led_3 = ((hb >> 26) & 1) == 1;
    hb = hb +% 1;
    if (st == ST_WAIT) {
        if (core_init_error) {
            verdict = V_FAIL;
            st = ST_REPORT;
        } else if (core_init_done) {
            st = ST_WRITE;
        }
    } else if (st == ST_WRITE) {
        if (ci == n_beats and di == n_beats) {
            st = ST_READ;
            ci = 0;
        } else {
            wcyc = wcyc + 1;
            if (core_user_port_native_0_cmd_ready and ci < n_beats) { ci = ci + 1; }
            if (core_user_port_native_0_wdata_ready and di < n_beats) {
                wsum = fold(wsum, lane_word(di, 0), lane_word(di, 1), lane_word(di, 2), lane_word(di, 3));
                di = di + 1;
            }
        }
    } else if (st == ST_READ) {
        if (ri == n_beats) {
            st = ST_DIV;
            drem = 0;
            dq = 0;
            dstep = 0;
        } else {
            rcyc = rcyc + 1;
            if (core_user_port_native_0_cmd_ready and ci < n_beats) { ci = ci + 1; }
            if (rv) {
                if (!beat_ok(ri, rb0, rb1, rb2, rb3)) { err = err + 1; }
                rsum = fold(rsum, rb0, rb1, rb2, rb3);
                dnum = dnum + BEAT_X_MHZ;
                ri = ri + 1;
            }
            rv = core_user_port_native_0_rdata_valid;
            rb0 = core_user_port_native_0_rdata_data__0;
            rb1 = core_user_port_native_0_rdata_data__1;
            rb2 = core_user_port_native_0_rdata_data__2;
            rb3 = core_user_port_native_0_rdata_data__3;
        }
    } else if (st == ST_DIV) {
        if (dstep == DIV_STEPS) {
            mbps = dq;
            verdict = verdict_by_rate(dq, err);
            st = ST_REPORT;
        } else {
            dq = div_q(dq, drem, dnum, rcyc);
            drem = div_rem(drem, dnum, rcyc);
            dnum = dnum << 1;
            dstep = dstep + 1;
        }
    } else {
        if (tx_cnt + 1 < baud_div) {
            tx_cnt = tx_cnt + 1;
        } else {
            tx_cnt = 0;
            if (tx_left != 0) {
                tx_sh = (tx_sh >> 1) | 512;
                tx_left = tx_left - 1;
            } else {
                tx_sh = frame(line_char(seg, pos, fsr, verdict));
                tx_left = 9;
                if (pos == seg_last(seg)) {
                    fsr = field(seg + 1, n_beats, wcyc, rcyc, mbps, wsum, rsum, err, lines);
                    pos = 0;
                    if (seg == LINE_SEGS - 1) {
                        seg = 0;
                        lines = lines + 1;
                    } else {
                        seg = seg + 1;
                    }
                } else {
                    if (seg != 0 and seg != LINE_SEGS - 1 and pos >= 3) { fsr = fsr << 4; }
                    pos = pos + 1;
                }
            }
        }
    }
}

; --- the tests ----------------------------------------------------------------------------------

test the_head_is_325000_beats_of_32_bytes {
    assert_eq((HEAD_BEATS as u64) * BEAT_BYTES, HEAD_BYTES);
    assert_eq(BEAT_BYTES * 8, 256);
    assert_eq(BEAT_BYTES * SYS_MHZ, PEAK_MBPS);
    assert_eq(BEAT_X_MHZ as u64, PEAK_MBPS);
    assert_eq(mbps_of(HEAD_BYTES, 325000), PEAK_MBPS);
    assert_eq(mbps_of(HEAD_BYTES, 520000), GATE_MBPS);
}

test the_gate_is_2_gb_s_and_the_kill_1_5 {
    assert_eq(verdict_of(HEAD_BYTES, 325000, 0), V_PASS);
    assert_eq(verdict_of(HEAD_BYTES, 520000, 0), V_PASS);
    assert_eq(verdict_of(HEAD_BYTES, 520001, 0), V_SLOW);
    assert_eq(verdict_of(HEAD_BYTES, 693333, 0), V_SLOW);
    assert_eq(verdict_of(HEAD_BYTES, 693334, 0), V_KILL);
    assert_eq(verdict_of(HEAD_BYTES, 325000, 1), V_FAIL);
    assert_eq(verdict_of(HEAD_BYTES, 693334, 7), V_FAIL);
    assert_eq(verdict_by_rate(mbps_of(HEAD_BYTES, 325000) as u32, 0), V_PASS);
    assert_eq(verdict_by_rate(mbps_of(HEAD_BYTES, 520000) as u32, 0), V_PASS);
    assert_eq(verdict_by_rate(mbps_of(HEAD_BYTES, 520001) as u32, 0), V_SLOW);
    assert_eq(verdict_by_rate(mbps_of(HEAD_BYTES, 693333) as u32, 0), V_SLOW);
    assert_eq(verdict_by_rate(mbps_of(HEAD_BYTES, 693334) as u32, 0), V_KILL);
    assert_eq(verdict_by_rate(mbps_of(HEAD_BYTES, 325000) as u32, 1), V_FAIL);
    assert_eq(verdict_by_rate(1999, 0), V_SLOW);
    assert_eq(verdict_by_rate(1500, 0), V_SLOW);
    assert_eq(verdict_by_rate(1499, 0), V_KILL);
}

test the_serial_divider_is_the_quotient {
    var num : u32 = 1040000000;
    var den : u32 = 520000;
    var q : u32 = 0;
    var r : u64 = 0;
    var step : u8 = 0;
    while (step < DIV_STEPS) {
        q = div_q(q, r, num, den);
        r = div_rem(r, num, den);
        num = num << 1;
        step = step + 1;
    }
    assert_eq(q, 2000);
    num = 1040000000;
    den = 693334;
    q = 0;
    r = 0;
    step = 0;
    while (step < DIV_STEPS) {
        q = div_q(q, r, num, den);
        r = div_rem(r, num, den);
        num = num << 1;
        step = step + 1;
    }
    assert_eq(q, 1499);
    assert_eq(r, 1040000000 - 1499 * 693334);
    num = 4294967295;
    den = 7;
    q = 0;
    r = 0;
    step = 0;
    while (step < DIV_STEPS) {
        q = div_q(q, r, num, den);
        r = div_rem(r, num, den);
        num = num << 1;
        step = step + 1;
    }
    assert_eq(q, 613566756);
    assert_eq(r, 3);
}

test no_two_beats_or_lanes_share_a_word {
    assert lane_word(0, 0) != lane_word(0, 1);
    assert lane_word(0, 3) != lane_word(1, 0);
    assert lane_word(1, 0) != lane_word(0, 0);
    assert lane_word(324999, 3) != lane_word(324999, 2);
    assert lane_word(0, 0) == LANE_SALT;
    assert beat_ok(7, lane_word(7, 0), lane_word(7, 1), lane_word(7, 2), lane_word(7, 3));
    assert !beat_ok(7, lane_word(7, 0), lane_word(7, 1), lane_word(7, 2) ^ 1, lane_word(7, 3));
    assert !beat_ok(7, lane_word(7, 1), lane_word(7, 0), lane_word(7, 2), lane_word(7, 3));
    assert !beat_ok(8, lane_word(7, 0), lane_word(7, 1), lane_word(7, 2), lane_word(7, 3));
}

test the_checksum_knows_the_order_of_the_beats {
    const a : u64 = fold(fold(0, 1, 2, 4, 8), 16, 32, 64, 128);
    const b : u64 = fold(fold(0, 16, 32, 64, 128), 1, 2, 4, 8);
    assert a != b;
    assert_eq(fold(0, 1, 2, 4, 8), 2251816993685505);
    assert_eq(fold(9223372036854775808, 0, 0, 0, 0), 1);
    assert_eq(lane_word(5, 0) ^ lane_word(5, 1) ^ lane_word(5, 2) ^ lane_word(5, 3), 0);
    assert_eq(fold(0, lane_word(0, 0), lane_word(0, 1), lane_word(0, 2), lane_word(0, 3)), 16182248147329805489);
}

test the_head_folds_to_a_sum_the_board_must_report {
    var sum : u64 = 0;
    var i : u32 = 0;
    while (i < HEAD_BEATS) {
        sum = fold(sum, lane_word(i, 0), lane_word(i, 1), lane_word(i, 2), lane_word(i, 3));
        i = i + 1;
    }
    assert_eq(sum, 0xFFB7236C398EE555);
}

test a_run_of_three_beats_reads_back_what_it_wrote {
    st = ST_WAIT;
    n_beats = 3;
    ci = 0;
    di = 0;
    ri = 0;
    wcyc = 0;
    rcyc = 0;
    wsum = 0;
    rsum = 0;
    err = 0;
    dnum = 0;
    rv = false;
    on_clock(false, false, true, true, false, 0, 0, 0, 0, true);
    assert_eq(st, ST_WAIT);
    on_clock(true, false, true, true, false, 0, 0, 0, 0, true);
    assert_eq(st, ST_WRITE);
    on_clock(true, false, true, false, false, 0, 0, 0, 0, true);
    assert_eq(ci, 1);
    assert_eq(di, 0);
    on_clock(true, false, true, true, false, 0, 0, 0, 0, true);
    on_clock(true, false, true, true, false, 0, 0, 0, 0, true);
    on_clock(true, false, false, true, false, 0, 0, 0, 0, true);
    assert_eq(ci, 3);
    assert_eq(di, 3);
    assert_eq(wcyc, 4);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    assert_eq(st, ST_READ);
    assert_eq(ci, 0);
    on_clock(true, false, true, false, true, lane_word(0, 0), lane_word(0, 1), lane_word(0, 2), lane_word(0, 3), true);
    assert_eq(ri, 0);
    on_clock(true, false, true, false, true, lane_word(1, 0), lane_word(1, 1), lane_word(1, 2), lane_word(1, 3), true);
    assert_eq(ri, 1);
    on_clock(true, false, true, false, true, lane_word(2, 0), lane_word(2, 1), lane_word(2, 2), lane_word(2, 3), true);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    assert_eq(ci, 3);
    assert_eq(ri, 3);
    assert_eq(rcyc, 4);
    assert_eq(dnum, 3 * BEAT_X_MHZ);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    assert_eq(st, ST_DIV);
    var k : u8 = 0;
    while (k < 33) {
        on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
        k = k + 1;
    }
    assert_eq(st, ST_REPORT);
    assert_eq(err, 0);
    assert_eq(rsum, wsum);
    assert_eq(mbps, 2400);
    assert_eq(verdict, V_PASS);
}

test a_beat_read_back_wrong_is_a_fail_at_any_rate {
    st = ST_READ;
    n_beats = 2;
    ci = 2;
    ri = 0;
    rcyc = 0;
    rsum = 0;
    err = 0;
    dnum = 0;
    rv = false;
    wsum = fold(fold(0, lane_word(0, 0), lane_word(0, 1), lane_word(0, 2), lane_word(0, 3)), lane_word(1, 0), lane_word(1, 1), lane_word(1, 2), lane_word(1, 3));
    on_clock(true, false, false, false, true, lane_word(0, 0), lane_word(0, 1), lane_word(0, 2), lane_word(0, 3), true);
    on_clock(true, false, false, false, true, lane_word(1, 0), lane_word(1, 1), lane_word(1, 2) ^ 4, lane_word(1, 3), true);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    assert_eq(rcyc, 3);
    var k : u8 = 0;
    while (k < 33) {
        on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
        k = k + 1;
    }
    assert_eq(st, ST_REPORT);
    assert_eq(err, 1);
    assert rsum != wsum;
    assert_eq(mbps, 2133);
    assert_eq(verdict, V_FAIL);
}

test a_slow_read_is_slow_and_a_slower_one_killed {
    st = ST_READ;
    n_beats = 3;
    ci = 3;
    ri = 0;
    rcyc = 0;
    err = 0;
    dnum = 0;
    rv = false;
    on_clock(true, false, false, false, true, lane_word(0, 0), lane_word(0, 1), lane_word(0, 2), lane_word(0, 3), true);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    on_clock(true, false, false, false, true, lane_word(1, 0), lane_word(1, 1), lane_word(1, 2), lane_word(1, 3), true);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    on_clock(true, false, false, false, true, lane_word(2, 0), lane_word(2, 1), lane_word(2, 2), lane_word(2, 3), true);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    var k : u8 = 0;
    while (k < 34) {
        on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
        k = k + 1;
    }
    assert_eq(rcyc, 6);
    assert_eq(mbps, 1600);
    assert_eq(verdict, V_SLOW);
    st = ST_READ;
    ri = 0;
    rcyc = 3;
    dnum = 0;
    rv = false;
    on_clock(true, false, false, false, true, lane_word(0, 0), lane_word(0, 1), lane_word(0, 2), lane_word(0, 3), true);
    on_clock(true, false, false, false, true, lane_word(1, 0), lane_word(1, 1), lane_word(1, 2), lane_word(1, 3), true);
    on_clock(true, false, false, false, true, lane_word(2, 0), lane_word(2, 1), lane_word(2, 2), lane_word(2, 3), true);
    on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
    k = 0;
    while (k < 34) {
        on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
        k = k + 1;
    }
    assert_eq(rcyc, 7);
    assert_eq(mbps, 1371);
    assert_eq(verdict, V_KILL);
}

test a_failed_calibration_reports_fail {
    st = ST_WAIT;
    verdict = V_PASS;
    on_clock(false, true, false, false, false, 0, 0, 0, 0, true);
    assert_eq(st, ST_REPORT);
    assert_eq(verdict, V_FAIL);
}

test the_receipt_line_says_what_was_measured {
    st = ST_REPORT;
    n_beats = 3;
    wcyc = 4;
    rcyc = 4;
    mbps = 3200;
    wsum = 18364758544493064720;
    rsum = 18364758544493064720;
    err = 0;
    lines = 0;
    verdict = V_PASS;
    baud_div = 1;
    tx_cnt = 0;
    tx_sh = 1023;
    tx_left = 0;
    seg = 0;
    pos = 0;
    var got : u32 = 0;
    var bits : u32 = 0;
    var ch : u8 = 0;
    var line : u32 = 0;
    while (line < 2) {
        on_clock(true, false, false, false, false, 0, 0, 0, 0, true);
        bits = bits + 1;
        if (tx_left == 9) {
            assert_eq(tx_sh & 1, 0);
            assert_eq(tx_sh >> 9, 1);
            ch = ((tx_sh >> 1) & 255) as u8;
            if (line == 0 and got == 0) { assert_eq(ch, 84); }
            if (line == 0 and got == 3) { assert_eq(ch, 32); }
            if (line == 0 and got == 7) { assert_eq(ch, 51); }
            if (line == 0 and got == 9) { assert_eq(ch, 78); }
            if (line == 0 and got == 10) { assert_eq(ch, 61); }
            if (line == 0 and got == 11) { assert_eq(ch, 48); }
            if (line == 0 and got == 26) { assert_eq(ch, 51); }
            if (line == 0 and got == 28) { assert_eq(ch, 87); }
            if (line == 0 and got == 66) { assert_eq(ch, 77); }
            if (line == 0 and got == 81) { assert_eq(ch, 67); }
            if (line == 0 and got == 82) { assert_eq(ch, 56); }
            if (line == 0 and got == 83) { assert_eq(ch, 48); }
            if (line == 0 and got == 87) { assert_eq(ch, 70); }
            if (line == 0 and got == 102) { assert_eq(ch, 48); }
            if (line == 0 and got == 123) { assert_eq(ch, 69); }
            if (line == 0 and got == 159) { assert_eq(ch, 48); }
            if (line == 1 and got == 159) { assert_eq(ch, 49); }
            if (got == 161) { assert_eq(ch, 80); }
            if (got == 164) { assert_eq(ch, 83); }
            if (got == 165) { assert_eq(ch, 13); }
            if (ch == 10) {
                assert_eq(got, 166);
                got = 0;
                line = line + 1;
            } else {
                got = got + 1;
            }
        }
    }
    assert_eq(lines, 2);
    assert_eq(bits, (2 * 167 - 1) * 10 + 1);
}

test the_pins_that_read_the_run_are_set_from_its_state {
    baud_div = 868;
    tx_cnt = 0;
    tx_left = 0;
    st = ST_WAIT;
    verdict = V_PASS;
    hb = 0;
    tx_sh = 1023;
    on_clock(false, false, false, false, false, 0, 0, 0, 0, false);
    assert_eq(uart_tx, false);
    assert_eq(led_2, true);
    assert_eq(led_3, false);
    on_clock(false, false, false, false, false, 0, 0, 0, 0, true);
    assert_eq(uart_tx, true);
    st = ST_REPORT;
    tx_sh = 1022;
    hb = 67108864;
    on_clock(false, false, false, false, false, 0, 0, 0, 0, true);
    assert_eq(uart_tx, false);
    assert_eq(led_2, false);
    assert_eq(led_3, true);
    tx_sh = 1023;
    on_clock(false, false, false, false, false, 0, 0, 0, 0, false);
    assert_eq(uart_tx, true);
}
