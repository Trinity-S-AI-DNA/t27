var r_t01 : u32 = 0;
var r_t10 : u32 = 0;
var r_t11 : u32 = 0;
var r_qlo : u64 = 0;
var r_qhi : u64 = 0;
var r_qrise : u64 = 0;
// the charge accumulators of the table being read (w) and of the drain table (d): the value at (x, y), (x, 0), (0, y) and the four slopes
var r_w1 : u64 = 0;
var r_w2 : u64 = 0;
var r_w3 : u64 = 0;
var r_wsa : u64 = 0;
var r_wsb : u64 = 0;
var r_wsc : u64 = 0;
var r_wsd : u64 = 0;
