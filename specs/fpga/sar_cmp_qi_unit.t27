// SPDX-License-Identifier: Apache-2.0
; specs/fpga/sar_cmp_qi_unit.t27 -- one evaluator unit of the 27 C comparator on the ALINX AX7203: the evaluation of ONE device, `qi_eval` of specs/analog/sar_comparator_qi.t27, as a machine
; M3f of the analog emulation epic (#10486, issue #11380), PHASE 2 (FR-003). The board top (specs/fpga/sar_cmp_qi_ax7203.t27) instantiates several of these side by side; each works on its own
; device at the same time as the others. What is written here is the machine, its stamp words and the tests that run it against the spec's own functions.
; -
; WHAT A UNIT DOES. The top hands it a device number e, whether the Jacobian is wanted, the eight node voltages, the clock and the two inputs, and starts it. The unit reads only what it is given and
; its own table words, and writes nothing but its own registers, so any number of units can run at once (that is the independence the tests of sar_comparator_qi.t27 check for the spec). When it is
; done it holds the device's record of sar_comparator_qi.t27 (the current, the slopes of the current, the three terminal charges, the six slopes of the charges) and the two channel ends hi and lo,
; and serves the STAMPS of that record one at a time: the word that goes into the Newton system at the stamp `sel` (0 .. 19, see STAMPS below), which the top adds to the matrix.
; -
; THE ARITHMETIC IS THE SPEC'S, TWO PRODUCTS A CLOCK. sar_comparator_qi.t27 reads a table with 64-bit products (`blend`, `blend_w`, `blend1`, `blend1_w`) and the exponentials of the current with
; a 129-word table (`exp2neg`). Here every product of those functions goes through ONE multiply-add of two products, `r_ws = a * wa + b * wb` (two DSP48 multipliers in the fabric of the unit),
; loaded by a phase and read two phases later; a bilinear read is three of them and a linear one is one. Every other operation is a shift, an add, a compare or a table lookup, as in the spec.
; The tables are NOT in this module: a table is a ROM instance beside the unit (specs/fpga/sar_cmp_qi_tab_n.t27 for an NMOS device, sar_cmp_qi_tab_p.t27 for a PMOS), which answers the address `o_taddr`
; with, one clock after the address register and registered, the word of every table at that address; the unit sees it two calls after it asked.
; -
; THE PROGRAM. A device is a list of reads. Slots 0 .. 3 are the current reads of `qi_eval` (the current, and the three differences that give its slopes), slots 4 .. 16 the charge reads of the drain
; table, 17 .. 29 the same for the gate table (the six value reads with their extensions past the edges of the tables, and the four slope reads of the Jacobian); a slot that the state of the device
; does not need is skipped. After the reads, the finish makes the record words (the charge unit times the charge words). The cell of the 49-wide log tables takes 8 clocks to fetch and about 60 to
; blend; a charge read 6 and about 25; a device is a few thousand clocks, whatever the state.
; -
; STAMPS. The Newton system is the 8 x 9 matrix [J | -G] of sar_comparator.t27. A device adds twenty words to it, and `o_rword` is the word that goes with `i_sel`, a function of the record:
;   0 (hi, rhs)  -cur   1 (lo, rhs)  +cur                            the channel's current leaves hi and enters lo
;   2 (hi, hi)   3 (lo, hi)   4 (hi, g)   5 (lo, g)   6 (hi, lo)   7 (lo, lo)      the partials of the current (b, a, -(a + b + cb) for an NMOS; a + b + cb, -a, -b for a PMOS), rows hi and lo
;   8 (nd, rhs) 9 (g, rhs) 10 (ns, rhs)                              minus the three terminal charges
;   11 .. 13 row nd, 14 .. 16 row g, 17 .. 19 row ns, in the columns (g, hi, lo)      the slopes of the charges (sq_jq)
; nd is hi and ns is lo for an NMOS, the other way round for a PMOS. The terminal ids hi and lo are `o_hi` and `o_lo`; a row or column of 8 or more (a rail, the clock, an input) has no place in the
; matrix, and the top skips it. The sum of these words over the fifteen devices, with the lumped capacitors and the previous step's charge, IS the system of `sq_stamp` (the top's test checks it).
; -
; THE TESTS run the machine one clock at a time with the table ROM beside it (`tick`), a read of the tables of the right device kind answering the address the unit held. They compare, at the level
; of each read: the current `sq_i` and the slopes `sq_fd`, the charge reads `sq_qt` and `sq_slope`, and the whole record of `qi_eval` for every device at the states of the +2 mV run, word for word.
; WHAT IT DOES NOT SAY. Nothing about speed. Nothing about the tables or the model: those are the spec's. ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaSarCmpQiUnit;

use analog::mos_table::{VDD, CELL, EXP2NEG, LG_GBITS, LG_DBITS, LG_NG, LG_ND, LG_VBITS, LG_NV, LG_R_OFF, lim, cell_w, cell_of, frac_of, dpos, blend, blend1, blend_w, blend1_w, exp2neg, exp2_lam, vds_factor, id_of, lg_lam, lg_rv, lg_cur, lg_vsb_cell, lg_vsb_frac};
use analog::mos_psp103_data::{TT_LG_N, TT_LG_P, TT_QD_N, TT_QG_N, TT_QD_P, TT_QG_P};
use analog::mos_psp103_vsb_data::{VSB_N1, VSB_N2, VSB_N3, VSB_N4, VSB_N5, VSB_N6, VSB_P1, VSB_P2, VSB_P3, VSB_P4, VSB_P5, VSB_P6, vsb_tab, vsb_fine};
use analog::sar_comparator::{SC_NN, SC_T_VDD, SC_T_GND, SC_T_CLK, SC_T_VDP, SC_T_VDN, SC_DV_KIND, SC_DV_D, SC_DV_G, SC_DV_S, SC_DV_M, SC_VCM, sc_pack, sc_neg, sc_mag, sc_sadd, sc_flip};
use analog::sar_comparator_q::{SQ_OFF, SQ_VDD, SQ_QS, SQ_DV, SQ_QOFF, SQ_K, SQ_NS, sq_i, sq_fd, sq_qt, sq_slope, sq_qsrc, sq_mul, sq_qw, sq_qd_tab, sq_qg_tab, sq_cur_tab, sq_term_v, sq_run, sq_clk_at};
use analog::sar_comparator_qi::{qi_qt_ext, QI_ORD_NAT, QI_REC, QI_R_HI, QI_R_LO, QI_R_CUR, QI_R_A, QI_R_B, QI_R_CB, QI_R_QD, QI_R_QG, QI_R_QS, QI_R_DXD, QI_R_DYD, QI_R_DXG, QI_R_DYG, QI_R_SXS, QI_R_SYS, qi_eval, qi_charges, qi_stamp};

pub const KIND : str = "board-cell";
pub const ID : str = "fpga/sar_cmp_qi_unit";
pub const REFERENCE : str = "specs/analog/sar_comparator_qi.t27 (qi_eval), specs/analog/sar_comparator_q.t27, specs/analog/mos_table.t27";
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";

; --- the machine's constants -------------------------------------------------------------------------------------
/// The widths of the two products' operands: the a-side up to 48 bits (the largest is the blend's first sum, 44 bits), the weight side up to 32 bits.
pub const MA_MASK : u64 = 0xFFFFFFFFFFFF;
pub const MW_MASK : u64 = 0xFFFFFFFF;
/// The rounding halves of the shifts of the reads.
pub const H_LAM : u64 = 68719476736;
pub const H_Q : u64 = 549755813888;
pub const H_Z : u64 = 2097152;
pub const H_R : u64 = 131072;
pub const H_S : u64 = 524288;
/// Two to the weights: Vgs 2^18, Vds 2^19, Vsb 2^22, a charge cell 2^20.
pub const W_G : u64 = 262144;
pub const W_D : u64 = 524288;
pub const W_Z : u64 = 4194304;
pub const W_C : u64 = 1048576;
/// The stamps of a device (see STAMPS) and the slots of its program.
pub const NSTAMP : u8 = 20;
pub const SLOT_CHG0 : u8 = 4;
pub const SLOT_PER : u8 = 13;
pub const SLOT_FIN : u8 = 31;

; --- the phases ----------------------------------------------------------------------------------------------------
pub const P_IDLE : u8 = 0;
pub const P_SET1 : u8 = 1;
pub const P_SET2 : u8 = 2;
pub const P_SET3 : u8 = 3;
pub const P_SET4 : u8 = 4;
