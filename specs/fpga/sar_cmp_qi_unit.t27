const rst_n : bool = true;
const en : bool = true;
var r_ph : u8 = 0;
var r_ret : u8 = 0;
var r_ret2 : u8 = 0;
var r_cret : u8 = 0;
var r_e : u8 = 0;
var r_jac : bool = false;
var r_nochg : bool = false;
var r_kind : u32 = 0;
var r_d : u32 = 0;
var r_g : u32 = 0;
var r_s : u32 = 0;
var r_m : u64 = 0;
var r_mq : u64 = 0;
var r_vd : u32 = 0;
var r_vg : u32 = 0;
var r_vs : u32 = 0;
var r_hi : u32 = 0;
var r_lo : u32 = 0;
var r_vhi : u32 = 0;
var r_vlo : u32 = 0;
