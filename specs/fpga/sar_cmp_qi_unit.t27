pub const P_SER1 : u8 = 43;
pub const P_SER2 : u8 = 44;
pub const P_EXP0 : u8 = 45;
pub const P_EXP1 : u8 = 46;
pub const P_EXP2 : u8 = 47;
pub const P_Q0 : u8 = 50;
pub const P_QF : u8 = 51;
pub const P_QI1 : u8 = 52;
pub const P_QI2 : u8 = 53;
pub const P_QI3 : u8 = 54;
pub const P_QI4 : u8 = 55;
pub const P_QS1 : u8 = 56;
pub const P_QS2 : u8 = 57;
pub const P_QS3 : u8 = 58;

; --- facts: terminals, slots, stamps (pure) -----------------------------------------------------------------------
/// The voltage on terminal tm: a node, the supply, ground, the clock or an input (`sq_term_v` with the nodes as eight scalars).
pub fn term_v(tm: u32, n0: u32, n1: u32, n2: u32, n3: u32, n4: u32, n5: u32, n6: u32, n7: u32, clkv: u32, vdp: u32, vdn: u32) -> u32 {
    if (tm == 0) { return n0; }
    if (tm == 1) { return n1; }
    if (tm == 2) { return n2; }
    if (tm == 3) { return n3; }
    if (tm == 4) { return n4; }
    if (tm == 5) { return n5; }
    if (tm == 6) { return n6; }
    if (tm == 7) { return n7; }
    if (tm == SC_T_VDD) { return SQ_VDD; }
    if (tm == SC_T_GND) { return SQ_OFF; }
    if (tm == SC_T_CLK) { return clkv; }
    if (tm == SC_T_VDP) { return vdp; }
    return vdn;
}

/// The word of the slice j of seven the ROM answers with.
pub fn pick7(j: u32, w0: u32, w1: u32, w2: u32, w3: u32, w4: u32, w5: u32, w6: u32) -> u32 {
    if (j == 0) { return w0; }
    if (j == 1) { return w1; }
    if (j == 2) { return w2; }
    if (j == 3) { return w3; }
    if (j == 4) { return w4; }
    if (j == 5) { return w5; }
    return w6;
}

/// The address of node (cx, cy) of a log table: the tag word, then 49 nodes along Vds.
pub fn lg_addr(cx: u32, cy: u32) -> u16 {
    return (1 + (cx << 5) + (cx << 4) + cx + cy) as u16;
}

/// The address of node (cx, cy) of a charge table: 25 cx + cy.
pub fn q_addr(cx: u32, cy: u32) -> u16 {
    return ((cx << 4) + (cx << 3) + cx + cy) as u16;
}

/// Is current slot sk (0: the current, 1: along the gate drive, 2: along Vds, 3: along the source-to-bulk voltage) needed.
pub fn cur_active(sk: u8, jac: bool, xn: u32, fwd: bool) -> bool {
    if (!jac) { return false; }
    if (sk == 1) { return xn == 0; }
    if (sk == 3) { return !fwd; }
    return true;
}

/// The arguments of the current read of slot sk: the gate drive, Vds and the source-to-bulk voltage `sq_fd` reads at.
pub fn cur_x(sk: u8, x: u32, y: u32, vsb: u32) -> u32 {
    if (sk == 1) {
        if (x + SQ_DV <= VDD) { return x + SQ_DV; }
        return x - SQ_DV;
    }
    return x;
}

pub fn cur_y(sk: u8, x: u32, y: u32, vsb: u32) -> u32 {
    if (sk == 2) {
        if (y + SQ_DV <= VDD) { return y + SQ_DV; }
        return y - SQ_DV;
    }
    return y;
}

pub fn cur_v(sk: u8, x: u32, y: u32, vsb: u32) -> u32 {
    if (sk == 3) {
        if (vsb + SQ_DV <= VDD) { return vsb + SQ_DV; }
        return vsb - SQ_DV;
    }
    return vsb;
}

/// The difference of a slope slot is dpos(read, i0) when this is true, dpos(i0, read) otherwise (`sq_fd`: forward along the gate and Vds, backward at the edge; along Vsb the other way round).
pub fn cur_up(sk: u8, x: u32, y: u32, vsb: u32) -> bool {
    if (sk == 1) { return x + SQ_DV <= VDD; }
    if (sk == 2) { return y + SQ_DV <= VDD; }
    return !(vsb + SQ_DV <= VDD);
}

/// Charge slot k of one table (0 .. 12): is it needed. 0 .. 3 are the value read at (x, y) with its three extensions, 4 .. 6 the value at (x, 0) with two, 7 and 8 the value at (0, y) with one, 9 .. 12 the
/// four slopes of the Jacobian.
pub fn q_active(k: u8, jac: bool, xn: u32, x: u32, y: u32) -> bool {
    if (k == 1 or k == 5) { return xn > 0; }
    if (k == 2 or k == 6) { return x > VDD; }
    if (k == 3 or k == 8) { return y > VDD; }
    if (k >= 9) { return jac; }
    return true;
}

/// What charge slot k reads: 0 the value (`id_of`), 1 the slope along the gate drive, 2 along Vds.
pub fn q_op(k: u8) -> u8 {
    if (k == 0 or k == 4 or k == 7) { return 0; }
    if (k == 1 or k == 2 or k == 5 or k == 6 or k == 9 or k == 11) { return 1; }
    return 2;
}

pub fn q_vg(k: u8, x: u32) -> u32 {
    if (k == 0 or k == 3 or k == 4 or k == 9 or k == 10 or k == 11) { return x; }
    if (k == 2 or k == 6) { return VDD; }
    return 0;
}

pub fn q_vd(k: u8, y: u32) -> u32 {
    if (k == 0 or k == 1 or k == 2 or k == 7 or k == 9 or k == 10 or k == 12) { return y; }
    if (k == 3 or k == 8) { return VDD; }
    return 0;
}

/// The extension terms of the charge reads (slots 1 .. 3, 5, 6, 8): the multiplier of the slope, in units, and whether the term follows the sign of the slope or its opposite.
pub fn q_ext_mult(k: u8, xn: u32, x: u32, y: u32) -> u32 {
    if (k == 1 or k == 5) { return xn; }
    if (k == 2 or k == 6) { return x - VDD; }
    return y - VDD;
}

pub fn q_ext_flip(k: u8) -> bool {
    return k == 1 or k == 5;
}

/// The signed charge word of a table word, relative to the table's origin (`sq_qw`).
pub fn qw_of(w: u32, pmos: bool) -> u64 {
    if (w >= SQ_QOFF) { return sc_pack((w - SQ_QOFF) as u64, pmos); }
    return sc_pack((SQ_QOFF - w) as u64, !pmos);
}

/// The word that goes into the Newton system at stamp sel (see STAMPS), from the record of a device of kind kd (0 NMOS, 1 PMOS).
pub fn stamp_val(sel: u8, kd: u32, cur: u64, a: u64, b: u64, cb: u64, qd: u64, qg: u64, qs: u64, dxd: u64, dyd: u64, dxg: u64, dyg: u64, sxs: u64, sys: u64) -> u64 {
    const sm : u64 = a + b + cb;
    if (sel == 0) { return sc_pack(cur, true); }
    if (sel == 1) { return sc_pack(cur, false); }
    if (sel == 2) {
        if (kd == 0) { return sc_pack(b, false); }
        return sc_pack(sm, false);
    }
    if (sel == 3) {
        if (kd == 0) { return sc_pack(b, true); }
        return sc_pack(sm, true);
    }
    if (sel == 4) { return sc_pack(a, kd == 1); }
    if (sel == 5) { return sc_pack(a, kd == 0); }
    if (sel == 6) {
        if (kd == 0) { return sc_pack(sm, true); }
        return sc_pack(b, true);
    }
    if (sel == 7) {
        if (kd == 0) { return sc_pack(sm, false); }
        return sc_pack(b, false);
    }
    if (sel == 8) { return sc_flip(qd); }
    if (sel == 9) { return sc_flip(qg); }
    if (sel == 10) { return sc_flip(qs); }
    var sx : u64 = dxd;
    var sy : u64 = dyd;
    if (sel >= 14 and sel <= 16) {
        sx = dxg;
        sy = dyg;
    }
    if (sel >= 17) {
        sx = sxs;
        sy = sys;
    }
    var c : u8 = (sel - 11) % 3;
    if (sel >= 14) { c = (sel - 14) % 3; }
    if (sel >= 17) { c = (sel - 17) % 3; }
    if (kd == 0) {
        if (c == 0) { return sx; }
        if (c == 1) { return sy; }
        return sc_flip(sc_sadd(sx, sy));
    }
    if (c == 0) { return sc_flip(sx); }
    if (c == 1) { return sc_sadd(sx, sy); }
    return sc_flip(sy);
}

/// Two products and their sum, every operand cut to the width the machine gives it (the sum is formed mod 2^64, the largest real value is under 2^63).
pub fn ws_prod(a: u64, wa: u64, b: u64, wb: u64) -> u64 {
    return ((a & MA_MASK) *% (wa & MW_MASK)) +% ((b & MA_MASK) *% (wb & MW_MASK));
}

; --- the unit's registers ----------------------------------------------------------------------------------------------
