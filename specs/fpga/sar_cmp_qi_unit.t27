fn on_clock(i_go: bool, i_e: u8, i_jac: bool, i_nochg: bool, i_n0: u32, i_n1: u32, i_n2: u32, i_n3: u32, i_n4: u32, i_n5: u32, i_n6: u32, i_n7: u32, i_clk: u32, i_vdp: u32, i_vdn: u32, i_tw0: u32, i_tw1: u32, i_tw2: u32, i_tw3: u32, i_tw4: u32, i_tw5: u32, i_tw6: u32, i_tqd: u32, i_tqg: u32, i_sel: u8) {
    r_ws = ws_prod(r_ma, r_wa, r_mb, r_wb);
    o_rword = stamp_val(i_sel, r_kind, r_cur, r_ia, r_ib, r_icb, r_rqd, r_rqg, r_rqs, r_rdxd, r_rdyd, r_rdxg, r_rdyg, r_rsxs, r_rsys);
    o_hi = r_hi;
    o_lo = r_lo;
    if (r_ph == P_IDLE) {
        if (i_go) {
            r_e = i_e;
            r_jac = i_jac;
            r_nochg = i_nochg;
            o_done = false;
            r_cur = 0;
            r_ia = 0;
            r_ib = 0;
            r_icb = 0;
            r_rqd = 0;
            r_rqg = 0;
            r_rqs = 0;
            r_rdxd = 0;
            r_rdyd = 0;
            r_rdxg = 0;
            r_rdyg = 0;
            r_rsxs = 0;
            r_rsys = 0;
            r_ph = P_SET1;
        }
    } else if (r_ph == P_SET1) {
        r_kind = SC_DV_KIND[r_e as usize];
        r_d = SC_DV_D[r_e as usize];
        r_g = SC_DV_G[r_e as usize];
        r_s = SC_DV_S[r_e as usize];
        r_m = (SC_DV_M[r_e as usize]) as u64;
        r_ph = P_SET2;
    } else if (r_ph == P_SET2) {
        r_vd = term_v(r_d, i_n0, i_n1, i_n2, i_n3, i_n4, i_n5, i_n6, i_n7, i_clk, i_vdp, i_vdn);
        r_vg = term_v(r_g, i_n0, i_n1, i_n2, i_n3, i_n4, i_n5, i_n6, i_n7, i_clk, i_vdp, i_vdn);
        r_vs = term_v(r_s, i_n0, i_n1, i_n2, i_n3, i_n4, i_n5, i_n6, i_n7, i_clk, i_vdp, i_vdn);
        r_mq = r_m * SQ_QS;
        r_ph = P_SET3;
    } else if (r_ph == P_SET3) {
        if (r_vd < r_vs) {
            r_hi = r_s;
            r_lo = r_d;
            r_vhi = r_vs;
            r_vlo = r_vd;
        } else {
            r_hi = r_d;
            r_lo = r_s;
            r_vhi = r_vd;
            r_vlo = r_vs;
        }
        r_ph = P_SET4;
    } else if (r_ph == P_SET4) {
        r_x = 0;
        r_xn = 0;
        r_vsb = 0;
        r_fwd = false;
        if (r_kind == 0) {
            if (r_vg > r_vlo) { r_x = r_vg - r_vlo; } else { r_xn = r_vlo - r_vg; }
            if (r_vlo > SQ_OFF) { r_vsb = r_vlo - SQ_OFF; } else { r_fwd = true; }
        } else {
            if (r_vhi > r_vg) { r_x = r_vhi - r_vg; } else { r_xn = r_vg - r_vhi; }
            if (r_vhi < SQ_VDD) { r_vsb = SQ_VDD - r_vhi; } else { r_fwd = true; }
        }
        r_y = r_vhi - r_vlo;
        r_sk = 0;
        r_w1 = 0;
        r_w2 = 0;
        r_w3 = 0;
        r_wsa = 0;
        r_wsb = 0;
        r_wsc = 0;
        r_wsd = 0;
        r_d1 = 0;
        r_d2 = 0;
        r_d3 = 0;
        r_dsa = 0;
        r_dsb = 0;
        r_dsc = 0;
        r_dsd = 0;
        r_ph = P_PROG;
    } else if (r_ph == P_WS) {
        r_ph = r_ret;
    } else if (r_ph == P_PROG) {
        // the program: the current slots, then the charge slots of the drain table and of the gate table, then the finish
        if (r_sk >= SLOT_FIN) {
            r_fk = 0;
            r_ph = P_FIN0;
        } else if (r_sk < SLOT_CHG0) {
            if (cur_active(r_sk, r_jac, r_xn, r_fwd)) {
                r_ux = cur_x(r_sk, r_x, r_y, r_vsb);
                r_uy = cur_y(r_sk, r_x, r_y, r_vsb);
                r_uv = cur_v(r_sk, r_x, r_y, r_vsb);
                r_cret = P_CURR;
                r_ph = P_CU0;
            } else {
                r_sk = r_sk + 1;
            }
        } else {
            // slots 4 .. 16 are the charge slots 0 .. 12 of the drain table, slot 17 moves its accumulators to the d bank, slots 18 .. 30 are the charge slots 0 .. 12 of the gate table
            if (r_nochg) {
                r_sk = SLOT_FIN;
            } else if (r_sk == SLOT_CHG0 + SLOT_PER) {
                r_d1 = r_w1;
                r_d2 = r_w2;
                r_d3 = r_w3;
                r_dsa = r_wsa;
                r_dsb = r_wsb;
                r_dsc = r_wsc;
                r_dsd = r_wsd;
                r_w1 = 0;
                r_w2 = 0;
                r_w3 = 0;
                r_wsa = 0;
                r_wsb = 0;
                r_wsc = 0;
                r_wsd = 0;
                r_sk = r_sk + 1;
            } else {
                if (r_sk < SLOT_CHG0 + SLOT_PER) {
                    r_qt = 0;
                    r_fk = r_sk - SLOT_CHG0;
                } else {
                    r_qt = 1;
                    r_fk = r_sk - SLOT_CHG0 - SLOT_PER - 1;
                }
                if (q_active(r_fk, r_jac, r_xn, r_x, r_y)) {
                    r_qop = q_op(r_fk);
                    r_qvg = q_vg(r_fk, r_x);
                    r_qvd = q_vd(r_fk, r_y);
                    r_ph = P_Q0;
                } else {
                    r_sk = r_sk + 1;
                }
            }
        }
    } else if (r_ph == P_CURR) {
        // a current read is back: r_cres. Slot 0 is the current itself, slots 1 .. 3 are the three differences whose product with m is a slope.
        if (r_sk == 0) {
            r_i0 = r_cres;
            r_ma = r_cres;
            r_wa = r_m;
            r_mb = 0;
            r_wb = 0;
            r_ret = P_CURS;
            r_ph = P_WS;
        } else {
            if (cur_up(r_sk, r_x, r_y, r_vsb)) { r_ma = dpos(r_cres, r_i0); } else { r_ma = dpos(r_i0, r_cres); }
            r_wa = r_m;
            r_mb = 0;
            r_wb = 0;
            r_ret = P_CURS;
            r_ph = P_WS;
        }
    } else if (r_ph == P_CURS) {
        if (r_sk == 0) { r_cur = (r_ws + 32) >> 6; }
        if (r_sk == 1) { r_ia = r_ws; }
        if (r_sk == 2) { r_ib = r_ws; }
        if (r_sk == 3) { r_icb = r_ws; }
        r_sk = r_sk + 1;
        r_ph = P_PROG;
    } else if (r_ph == P_CU0) {
        // the current at (r_ux, r_uy, r_uv): sq_i = vsb_fine = lg_fine_vsb of the two slices around the source-to-bulk voltage
        r_gv = lim(r_ux);
        r_dv = lim(r_uy);
        r_vz = lim(r_uv);
        r_ph = P_CU1;
    } else if (r_ph == P_CU1) {
        r_j = cell_w(r_vz, LG_VBITS, LG_NV);
        r_fz = r_vz - (cell_w(r_vz, LG_VBITS, LG_NV) << LG_VBITS);
        r_fx = r_gv - (cell_w(r_gv, LG_GBITS, LG_NG) << LG_GBITS);
        r_fy = r_dv - (cell_w(r_dv, LG_DBITS, LG_ND) << LG_DBITS);
        r_a00 = lg_addr(cell_w(r_gv, LG_GBITS, LG_NG), cell_w(r_dv, LG_DBITS, LG_ND));
        r_rva = ((LG_R_OFF as u32) + cell_w(r_gv, LG_GBITS, LG_NG)) as u16;
        r_fc = 0;
        r_ph = P_CUF;
    } else if (r_ph == P_CUF) {
        // the four nodes of the cell in the two slices, and the two rv words: an address a call, the word of an address two calls later
        if (r_fc == 0) { o_taddr = r_a00; }
        if (r_fc == 1) { o_taddr = r_a00 + 1; }
        if (r_fc == 2) { o_taddr = r_a00 + 49; }
        if (r_fc == 3) { o_taddr = r_a00 + 50; }
        if (r_fc == 4) { o_taddr = r_rva; }
        if (r_fc == 5) { o_taddr = r_rva + 1; }
        if (r_fc == 2) {
            r_ta00 = pick7(r_j, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
            r_tb00 = pick7(r_j + 1, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
        }
        if (r_fc == 3) {
            r_ta01 = pick7(r_j, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
            r_tb01 = pick7(r_j + 1, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
        }
        if (r_fc == 4) {
            r_ta10 = pick7(r_j, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
            r_tb10 = pick7(r_j + 1, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
        }
        if (r_fc == 5) {
            r_ta11 = pick7(r_j, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
            r_tb11 = pick7(r_j + 1, i_tw0, i_tw1, i_tw2, i_tw3, i_tw4, i_tw5, i_tw6);
        }
        if (r_fc == 6) { r_rv0 = i_tw0; }
        if (r_fc == 7) {
            r_rv1 = i_tw0;
            r_ph = P_CL1;
        }
        r_fc = r_fc + 1;
    } else if (r_ph == P_CL1) {
        // lam of the slice a: lo = t00 (2^18 - fx) + t10 fx
        r_ma = r_ta00 as u64;
        r_mb = r_ta10 as u64;
        r_wa = W_G - (r_fx as u64);
        r_wb = r_fx as u64;
        r_ret = P_CL2;
        r_ph = P_WS;
    } else if (r_ph == P_CL2) {
        r_lo1 = r_ws;
        r_ma = r_ta01 as u64;
        r_mb = r_ta11 as u64;
        r_wa = W_G - (r_fx as u64);
        r_wb = r_fx as u64;
        r_ret = P_CL3;
        r_ph = P_WS;
    } else if (r_ph == P_CL3) {
        r_hi1 = r_ws;
        r_ma = r_lo1;
        r_mb = r_ws;
        r_wa = W_D - (r_fy as u64);
        r_wb = r_fy as u64;
        r_ret = P_CL4;
        r_ph = P_WS;
    } else if (r_ph == P_CL4) {
        r_la = (r_ws + H_LAM) >> 37;
        r_ma = r_tb00 as u64;
        r_mb = r_tb10 as u64;
        r_wa = W_G - (r_fx as u64);
        r_wb = r_fx as u64;
        r_ret = P_CL5;
        r_ph = P_WS;
    } else if (r_ph == P_CL5) {
        r_lo1 = r_ws;
        r_ma = r_tb01 as u64;
        r_mb = r_tb11 as u64;
        r_wa = W_G - (r_fx as u64);
        r_wb = r_fx as u64;
        r_ret = P_CL6;
        r_ph = P_WS;
    } else if (r_ph == P_CL6) {
        r_hi1 = r_ws;
        r_ma = r_lo1;
        r_mb = r_ws;
        r_wa = W_D - (r_fy as u64);
        r_wb = r_fy as u64;
        r_ret = P_CL7;
        r_ph = P_WS;
    } else if (r_ph == P_CL7) {
        r_lb = (r_ws + H_LAM) >> 37;
        r_ma = r_la;
        r_mb = (r_ws + H_LAM) >> 37;
        r_wa = W_Z - (r_fz as u64);
        r_wb = r_fz as u64;
        r_ret = P_CL8;
        r_ph = P_WS;
    } else if (r_ph == P_CL8) {
        // the log word between the two slices, then rv: the blend along Vgs of the two rv words
        r_lam = (r_ws + H_Z) >> 22;
        r_ma = r_rv0 as u64;
        r_mb = r_rv1 as u64;
        r_wa = W_G - (r_fx as u64);
        r_wb = r_fx as u64;
        r_ret = P_CL9;
        r_ph = P_WS;
    } else if (r_ph == P_CL9) {
        r_rv = (r_ws + H_R) >> 18;
        r_ma = r_dv as u64;
        r_mb = 0;
        r_wa = (r_ws + H_R) >> 18;
        r_wb = 0;
        r_ret = P_CL10;
        r_ph = P_WS;
    } else if (r_ph == P_CL10) {
        // x24 = (dv rv + 2048) >> 12; then E = 2^(lam / 2^16): 2^f = 2 * 2^-(1 - f) from the table of 2^-(i/128), shifted by the integer part
        r_x24 = (r_ws + 2048) >> 12;
        r_eg = (((65536 - (r_lam & 65535))) as u64) << 8;
        r_ret2 = P_CL11;
        r_ph = P_E2N0;
    } else if (r_ph == P_CL11) {
        r_e2 = ((((r_ev * 2)) << (r_lam >> 16)) + 8388608) >> 24;
        if (r_x24 < 1048576) { r_ph = P_SER0; } else { r_ph = P_EXP0; }
    } else if (r_ph == P_CL12) {
        // F * E rounded: the current in IUNIT
        r_ma = r_e2;
        r_mb = 0;
        r_wa = r_f2;
        r_wb = 0;
        r_ret = P_CL13;
        r_ph = P_WS;
    } else if (r_ph == P_CL13) {
        r_cres = (r_ws + 8388608) >> 24;
        r_ph = r_cret;
    } else if (r_ph == P_E2N0) {
        // 2^-g for g in [0, 1] in Q24 from the table, linear between its entries: a - (((a - b) j + 65536) >> 17)
        if ((r_eg >> 17) >= 128) {
            r_ev = (EXP2NEG[128]) as u64;
            r_ph = r_ret2;
        } else {
            r_ea = (EXP2NEG[(r_eg >> 17) as usize]) as u64;
            r_ma = ((EXP2NEG[(r_eg >> 17) as usize]) as u64) - ((EXP2NEG[((r_eg >> 17) + 1) as usize]) as u64);
            r_wa = r_eg & 131071;
            r_mb = 0;
            r_wb = 0;
            r_ret = P_E2N1;
            r_ph = P_WS;
        }
    } else if (r_ph == P_E2N1) {
        r_ev = r_ea - ((r_ws + 65536) >> 17);
        r_ph = r_ret2;
    } else if (r_ph == P_SER0) {
        // F below x = 1/16: x - x^2 / 2 + x^3 / 6
        r_ma = r_x24;
        r_wa = r_x24;
        r_mb = 0;
        r_wb = 0;
        r_ret = P_SER1;
        r_ph = P_WS;
    } else if (r_ph == P_SER1) {
        r_x2 = (r_ws + 8388608) >> 24;
        r_ma = (r_ws + 8388608) >> 24;
        r_wa = r_x24;
        r_mb = 0;
        r_wb = 0;
        r_ret = P_SER2;
        r_ph = P_WS;
    } else if (r_ph == P_SER2) {
        r_f2 = r_x24 - (r_x2 >> 1) + ((((r_ws + 8388608) >> 24) as u16) / 6) as u64;
        r_ph = P_CL12;
    } else if (r_ph == P_EXP0) {
        // above it: 1 - 2^-(x log2 e), the exponent y24 = (x24 * 94548 + 32768) >> 16, exactly 1 once its integer part reaches 25
        r_ma = r_x24;
        r_wa = 94548;
        r_mb = 0;
        r_wb = 0;
        r_ret = P_EXP1;
        r_ph = P_WS;
    } else if (r_ph == P_EXP1) {
        r_k2 = ((r_ws + 32768) >> 16) >> 24;
        if (((r_ws + 32768) >> 40) >= 25) {
            r_f2 = 16777216;
            r_ph = P_CL12;
        } else {
            r_eg = ((r_ws + 32768) >> 16) & 16777215;
            r_ret2 = P_EXP2;
            r_ph = P_E2N0;
        }
    } else if (r_ph == P_EXP2) {
        r_f2 = 16777216 - (r_ev >> r_k2);
        r_ph = P_CL12;
    } else if (r_ph == P_Q0) {
        // a charge read of table r_qt (0 drain, 1 gate) at (r_qvg, r_qvd): the cell of the 625-word table and the position in it
        r_gv = lim(r_qvg);
        r_dv = lim(r_qvd);
        r_ph = P_QF;
        r_fc = 0;
    } else if (r_ph == P_QF) {
        if (r_fc == 0) {
            r_fx = r_gv - (cell_of(r_gv) << 20);
            r_fy = r_dv - (cell_of(r_dv) << 20);
            r_a00 = q_addr(cell_of(r_gv), cell_of(r_dv));
        }
        if (r_fc == 1) { o_taddr = r_a00; }
        if (r_fc == 2) { o_taddr = r_a00 + 1; }
        if (r_fc == 3) { o_taddr = r_a00 + 25; }
        if (r_fc == 4) { o_taddr = r_a00 + 26; }
        if (r_fc == 3) {
            if (r_qt == 0) { r_t00 = i_tqd; } else { r_t00 = i_tqg; }
        }
        if (r_fc == 4) {
            if (r_qt == 0) { r_t01 = i_tqd; } else { r_t01 = i_tqg; }
        }
        if (r_fc == 5) {
            if (r_qt == 0) { r_t10 = i_tqd; } else { r_t10 = i_tqg; }
        }
        if (r_fc == 6) {
            if (r_qt == 0) { r_t11 = i_tqd; } else { r_t11 = i_tqg; }
            if (r_qop == 0) {
                r_ph = P_QI1;
            } else {
                r_ph = P_QS1;
            }
        }
        r_fc = r_fc + 1;
    } else if (r_ph == P_QI1) {
        // id_of: lo = t00 (2^20 - fx) + t10 fx, hi = t01 (2^20 - fx) + t11 fx, id = (lo (2^20 - fy) + hi fy + 2^39) >> 40
        r_ma = r_t00 as u64;
        r_mb = r_t10 as u64;
        r_wa = W_C - (r_fx as u64);
        r_wb = r_fx as u64;
        r_ret = P_QI2;
        r_ph = P_WS;
    } else if (r_ph == P_QI2) {
        r_qlo = r_ws;
        r_ma = r_t01 as u64;
        r_mb = r_t11 as u64;
        r_wa = W_C - (r_fx as u64);
        r_wb = r_fx as u64;
        r_ret = P_QI3;
        r_ph = P_WS;
    } else if (r_ph == P_QI3) {
        r_ma = r_qlo;
        r_mb = r_ws;
        r_wa = W_C - (r_fy as u64);
        r_wb = r_fy as u64;
        r_ret = P_QI4;
        r_ph = P_WS;
    } else if (r_ph == P_QI4) {
        r_qres = qw_of(((r_ws + H_Q) >> 40) as u32, r_kind == 1);
        r_ph = P_QR;
    } else if (r_ph == P_QS1) {
        // the slope along an axis, its rising part and its falling part, in words per cell, blended along the other axis (`sq_tslope`): axis 0 differences along cx, weight fy; axis 1 along cy, weight fx
        if (r_qop == 1) {
            r_ma = dpos(r_t10 as u64, r_t00 as u64);
            r_mb = dpos(r_t11 as u64, r_t01 as u64);
            r_wa = W_C - (r_fy as u64);
            r_wb = r_fy as u64;
        } else {
            r_ma = dpos(r_t01 as u64, r_t00 as u64);
            r_mb = dpos(r_t11 as u64, r_t10 as u64);
            r_wa = W_C - (r_fx as u64);
            r_wb = r_fx as u64;
        }
        r_ret = P_QS2;
        r_ph = P_WS;
    } else if (r_ph == P_QS2) {
        r_qrise = (r_ws + H_S) >> 20;
        if (r_qop == 1) {
            r_ma = dpos(r_t00 as u64, r_t10 as u64);
            r_mb = dpos(r_t01 as u64, r_t11 as u64);
            r_wa = W_C - (r_fy as u64);
            r_wb = r_fy as u64;
        } else {
            r_ma = dpos(r_t00 as u64, r_t01 as u64);
            r_mb = dpos(r_t10 as u64, r_t11 as u64);
            r_wa = W_C - (r_fx as u64);
            r_wb = r_fx as u64;
        }
        r_ret = P_QS3;
        r_ph = P_WS;
    } else if (r_ph == P_QS3) {
        r_qres = sc_sadd(sc_pack(r_qrise, r_kind == 1), sc_pack((r_ws + H_S) >> 20, r_kind != 1));
        r_ph = P_QR;
    } else if (r_ph == P_QR) {
        // a charge read is back: r_qres. Slots 0, 4, 7 and 9 .. 12 keep it; the others are extension terms (the slope times how far past the edge), added in after the product.
        if (r_fk == 0 or r_fk == 4 or r_fk == 7 or r_fk >= 9) {
            if (r_fk == 0) { r_w1 = r_qres; }
            if (r_fk == 4) { r_w2 = r_qres; }
            if (r_fk == 7) { r_w3 = r_qres; }
            if (r_fk == 9) { r_wsa = r_qres; }
            if (r_fk == 10) { r_wsb = r_qres; }
            if (r_fk == 11) { r_wsc = r_qres; }
            if (r_fk == 12) { r_wsd = r_qres; }
            r_sk = r_sk + 1;
            r_ph = P_PROG;
        } else {
            r_ma = sc_mag(r_qres);
            r_wa = q_ext_mult(r_fk, r_xn, r_x, r_y) as u64;
            r_mb = 0;
            r_wb = 0;
            r_ret = P_QR2;
            r_ph = P_WS;
        }
    } else if (r_ph == P_QR2) {
        if (r_fk == 1 or r_fk == 2 or r_fk == 3) { r_w1 = sc_sadd(r_w1, sc_pack(r_ws >> 20, sc_neg(r_qres) != q_ext_flip(r_fk))); }
        if (r_fk == 5 or r_fk == 6) { r_w2 = sc_sadd(r_w2, sc_pack(r_ws >> 20, sc_neg(r_qres) != q_ext_flip(r_fk))); }
        if (r_fk == 8) { r_w3 = sc_sadd(r_w3, sc_pack(r_ws >> 20, sc_neg(r_qres) != q_ext_flip(r_fk))); }
        r_sk = r_sk + 1;
        r_ph = P_PROG;
    } else if (r_ph == P_FIN0) {
        // the finish: the drain bank is the table 0, the working bank the table 1. fk selects the word of the record: 0 qd, 1 qg, 2 qs, 3 dxd, 4 dyd, 5 dxg, 6 dyg, 7 sxs, 8 sys
        if (r_nochg or (!r_jac and r_fk > 2) or r_fk > 8) {
            r_ph = P_DONE;
        } else {
            if (r_fk == 0) { r_fsrc = r_d1; }
            if (r_fk == 1) { r_fsrc = r_w1; }
            if (r_fk == 2) { r_fsrc = sq_qsrc(r_d1, r_w1, r_d2, r_w2, r_d3, r_w3); }
            if (r_fk == 3) { r_fsrc = r_dsa; }
            if (r_fk == 4) { r_fsrc = r_dsb; }
            if (r_fk == 5) { r_fsrc = r_wsa; }
            if (r_fk == 6) { r_fsrc = r_wsb; }
            if (r_fk == 7) { r_fsrc = sq_qsrc(r_dsa, r_wsa, r_dsc, r_wsc, 0, 0); }
            if (r_fk == 8) { r_fsrc = sq_qsrc(r_dsb, r_wsb, 0, 0, r_dsd, r_wsd); }
            r_ph = P_FIN1;
        }
    } else if (r_ph == P_FIN1) {
        r_ma = sc_mag(r_fsrc);
        r_wa = r_mq;
        r_mb = 0;
        r_wb = 0;
        r_ret = P_FIN2;
        r_ph = P_WS;
    } else if (r_ph == P_FIN2) {
        if (r_fk == 0) { r_rqd = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 1) { r_rqg = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 2) { r_rqs = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 3) { r_rdxd = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 4) { r_rdyd = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 5) { r_rdxg = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 6) { r_rdyg = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 7) { r_rsxs = sc_pack(r_ws, sc_neg(r_fsrc)); }
        if (r_fk == 8) { r_rsys = sc_pack(r_ws, sc_neg(r_fsrc)); }
        r_fk = r_fk + 1;
        r_ph = P_FIN0;
    } else {
        // P_DONE
        o_done = true;
        r_ph = P_IDLE;
    }
}

; --- the tests (WIP: the machine's own phases are not yet run against the spec; this one checks the program's slot tables) -----------------------------------------
; Variables, not constants, carry the data of the asserts: an assert on a constant is folded by the compiler and counts as no assert at all.

test the_slots_of_the_program_count_the_extension_reads_of_the_spec {
    // the active charge slots that are extension reads are the spec's `qi_qt_ext` count (for one table), over a lattice of (x, xn, y) that covers every combination of the three conditions
    var xs : [4]u32 = [0, 5000000, 25165824, 30000000];
    var xns : [2]u32 = [0, 700000];
    var ys : [3]u32 = [0, 12000000, 27000000];
    var checked : u32 = 0;
    var bad : u32 = 0;
    var i : usize = 0;
    while (i < 4) {
        var j : usize = 0;
        while (j < 2) {
            var k : usize = 0;
            while (k < 3) {
                const x : u32 = xs[i];
                const xn : u32 = xns[j];
                const y : u32 = ys[k];
                // a gate drive and a gate beyond the source do not occur together: x is 0 when xn is not
                if (xn == 0 or x == 0) {
                    var ext : u32 = 0;
                    var s : u8 = 0;
                    while (s < 13) {
                        if (q_active(s, false, xn, x, y) and s != 0 and s != 4 and s != 7) { ext = ext + 1; }
                        s = s + 1;
                    }
                    const want : u32 = qi_qt_ext(x, xn, y) + qi_qt_ext(x, xn, 0) + qi_qt_ext(0, 0, y);
                    if (ext != want) { bad = bad + 1; }
                    checked = checked + 1;
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    assert_eq(bad, 0);
    assert checked > 10;
    var slots : u32 = (SLOT_CHG0 as u32) + 2 * (SLOT_PER as u32) + 1;
    assert_eq(slots, SLOT_FIN as u32);
    var jacs : u8 = 0;
    var s2 : u8 = 0;
    while (s2 < 13) {
        if (q_active(s2, true, 0, 0, 0)) { jacs = jacs + 1; }
        s2 = s2 + 1;
    }
    // with the Jacobian and no extension there are 3 value reads and 4 slope reads
    assert_eq(jacs, 7);
}
