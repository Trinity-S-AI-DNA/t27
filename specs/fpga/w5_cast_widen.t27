// SPDX-License-Identifier: Apache-2.0
; specs/fpga/w5_cast_widen.t27 -- a cast to a wider integer must widen the Verilog expression
; Regression witness for gHashTag/t27#12296 (Refs #9367). The emitter used to print the operand
; of `x as u64` verbatim. Verilog sizes an expression to its widest operand, so
; `(a as u64) + (b as u64)` over two u32 stayed a 32-bit add and wrapped: the interpreter
; (test-report runs zig) said "bounds check fails", the generated hardware said "in bounds".
; Found on the WASM cell wasm_board_ax7203, whose linear-memory bounds check is exactly this sum.
; -
; The wrap inputs below (0xFFFFFFFF + 1, 0xFFFF0000 + 0x10000) are the ones that wrap in 32 bits.
; The vvp run of this module must print the interpreter's answers for them. This file is picked
; up by the icarus corpus (stem starts with w5), baseline .trinity/icarus-baselines/specs/fpga.

module w5_cast_widen;
use base::types;

fn sum_gt(a : u32, b : u32, lim : u32) -> u32 {
    if ((a as u64) + (b as u64) > (lim as u64)) {
        return 1;
    }
    return 0;
}

fn sum3_gt(a : u32, b : u32, c : u32, lim : u32) -> u32 {
    if ((a as u64) + (b as u64) + (c as u64) > (lim as u64)) {
        return 1;
    }
    return 0;
}

fn ssum_gt(a : i32, b : i32, lim : i32) -> u32 {
    if ((a as i64) + (b as i64) > (lim as i64)) {
        return 1;
    }
    return 0;
}

test cast_widen_unsigned_sum_wraps_in_32_bits {
    assert sum_gt(0xFFFFFFFF, 1, 0x10000) == 1;
    assert sum_gt(0xFFFF0000, 0x10000, 0x10000) == 1;
    assert sum_gt(0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF) == 1;
}

test cast_widen_unsigned_sum_boundary {
    assert sum_gt(1, 2, 0x10000) == 0;
    assert sum_gt(0xFFFF, 1, 0x10000) == 0;
    assert sum_gt(0xFFFF, 2, 0x10000) == 1;
}

test cast_widen_three_term_bounds_check {
    assert sum3_gt(0xFFFFFFFF, 1, 4, 0x10000) == 1;
    assert sum3_gt(0xFFFF0000, 0x10000, 1, 0x10000) == 1;
    assert sum3_gt(0x1000, 0x2000, 4, 0x10000) == 0;
    assert sum3_gt(0xFFF0, 8, 8, 0x10000) == 0;
    assert sum3_gt(0xFFF0, 8, 9, 0x10000) == 1;
}

test cast_widen_signed_sum_wraps_in_32_bits {
    assert ssum_gt(0x7FFFFFFF, 1, 0x7FFFFFFF) == 1;
    assert ssum_gt(-3, 1, -5) == 1;
    assert ssum_gt(-3, -4, -5) == 0;
    assert ssum_gt(-1, 1, 0) == 0;
}

endmodule
