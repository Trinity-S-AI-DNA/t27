; specs/fpga/lamb_labs_uart.t27 - UART control plane for lamb_labs
; Provides command parsing and status/result encoding for the 16×16 matmul
; phi^2 + 1/phi² = 3 | TRINITY

module LambLabsUART {

    pub const UART_CLOCK_HZ : u64 = 67_160_000  // MEASURED CFGMCLK
    pub const UART_BAUD_RATE : u64 = 115_200

    pub struct CommandPacket {
        cmd : u8,           // Command type
        param : u8,         // Parameter byte
        checksum : u8,      // Simple checksum
    }

    pub struct StatusPacket {
        status : u8,        // Status code
        result_lo : u8,     // Lower 8 bits of 32-bit result
        result_mid : u8,    // Middle 8 bits
        result_hi : u8,     // Upper 8 bits
        checksum : u8,      // Status checksum
    }

    ; Command opcodes
    pub const CMD_START : u8 = 0x80
    pub const CMD_READ_STATUS : u8 = 0x81
    pub const CMD_READ_RESULT : u8 = 0x82
    pub const CMD_RESET : u8 = 0x83

    ; Status codes
    pub const STATUS_IDLE : u8 = 0x00
    pub const STATUS_BUSY : u8 = 0x01
    pub const STATUS_DONE : u8 = 0x02
    pub const STATUS_ERROR : u8 = 0xFF

    ; Simple checksum calculation (XOR)
    pub fn checksum(data : [2]u8) -> u8 {
        data[0] ^ data[1]
    }

    ; Command parser - validates and extracts command from 2-byte packet
    pub fn parse_command(packet : [2]u8) -> Result<CommandPacket, u8> {
        let computed_checksum = checksum(packet[0..2])
        
        if computed_checksum == packet[2] {
            Ok(CommandPacket {
                cmd: packet[0],
                param: packet[1], 
                checksum: packet[2]
            })
        } else {
            Err(0xFE)  ; Checksum error
        }
    }

    ; Status encoder - creates 5-byte status packet
    pub fn encode_status(status : u8, result : u32) -> StatusPacket {
        StatusPacket {
            status: status,
            result_lo: (result & 0xFF) as u8,
            result_mid: ((result >> 8) & 0xFF) as u8,
            result_hi: ((result >> 16) & 0xFF) as u8,
            checksum: 0  ; Will be computed before transmission
        }
    }

    ; Main command dispatcher - maps commands to control signals
    pub fn dispatch_command(cmd : CommandPacket) -> (bool, u8, u8) {
        match cmd.cmd {
            CMD_START => {
                ; Start the matmul computation
                (true, 1, 0)  ; (start_pulse, param1, param2)
            },
            
            CMD_RESET => {
                ; Reset the system
                (true, 0, 0)  ; (reset_pulse, param1, param2)
            },
            
            CMD_READ_STATUS => {
                ; Return current status
                (false, cmd.cmd, 0)
            },
            
            CMD_READ_RESULT => {
                ; Return current result
                (false, cmd.cmd, 0)
            },
            
            _ => {
                ; Unknown command
                (false, 0, STATUS_ERROR)
            }
        }
    }

    ; UART receiver state machine
    pub enum UARTState {
        IDLE,
        WAIT_START,
        WAIT_DATA,
        WAIT_CHECKSUM,
        PROCESSING
    }

    ; Combined TX/RX interface for lamb_labs control
    pub fn uart_control_interface(
        rx_data : u8,      ; Incoming data byte
        rx_valid : bool,   ; Data is valid
        tx_ready : bool,   ; Transmitter ready for new data
        current_state : UARTState,
        last_command : CommandPacket
    ) -> (UARTState, u8, bool, bool) {
        
        let mut next_state = current_state
        let mut tx_data = 0u8
        let mut tx_valid = false
        let mut status = STATUS_IDLE

        match current_state {
            IDLE => {
                if rx_valid {
                    next_state = WAIT_START
                }
            },

            WAIT_START => {
                if rx_valid {
                    ; First byte should be command
                    let cmd_packet = [rx_data, 0u8, checksum([rx_data, 0u8])]
                    match parse_command(cmd_packet) {
                        Ok(cmd) => {
                            next_state = WAIT_DATA
                            last_command = cmd
                        },
                        Err(_) => {
                            ; Checksum error, stay in IDLE
                            next_state = IDLE
                        }
                    }
                }
            },

            WAIT_DATA => {
                if rx_valid {
                    ; Second byte should be parameter
                    let cmd_packet = [last_command.cmd, rx_data, checksum([last_command.cmd, rx_data])]
                    match parse_command(cmd_packet) {
                        Ok(cmd) => {
                            let (start_pulse, _, _) = dispatch_command(cmd)
                            next_state = PROCESSING
                            tx_valid = tx_ready
                            status = if start_pulse { STATUS_BUSY } else { STATUS_IDLE }
                        },
                        Err(_) => {
                            next_state = IDLE
                        }
                    }
                }
            },

            PROCESSING => {
                ; Wait for computation to complete
                next_state = IDLE
                status = STATUS_DONE
            },

            IDLE => {
                ; Stay in IDLE until new data
            }
        }

        (next_state, tx_data, tx_valid, status)
    }

    ; Test vectors for command parsing
    pub test command_parse_valid {
        let test_packet = [CMD_START, 0x00, checksum([CMD_START, 0x00])]
        let result = parse_command(test_packet)
        match result {
            Ok(cmd) => assert(cmd.cmd == CMD_START && cmd.param == 0x00),
            Err(_) => assert(false)
        }
    }

    pub test command_parse_checksum_error {
        let bad_packet = [CMD_START, 0x00, 0xFF]  ; Wrong checksum
        let result = parse_command(bad_packet)
        match result {
            Ok(_) => assert(false),
            Err(_) => assert(true)
        }
    }

    pub test status_encoding {
        let test_result = 0x00000400u32  ; Expected matmul result
        let status = encode_status(STATUS_DONE, test_result)
        assert(status.result_lo == 0x00 && status.result_mid == 0x04 && status.result_hi == 0x00)
    }

    pub test dispatch_start_command {
        let cmd = CommandPacket { cmd: CMD_START, param: 0x00, checksum: 0 }
        let (start_pulse, _, _) = dispatch_command(cmd)
        assert(start_pulse == true)
    }
}