// SPDX-License-Identifier: Apache-2.0
; specs/fpga/i2c_master.t27 -- a pure I2C master for one three-byte register write (#11026, epic #10782, board AX7203).
; The master is a state machine stepped once per quarter of an SCL period. One transaction is: START, byte 0 (the
; write address), ACK, byte 1 (the register), ACK, byte 2 (the value), ACK, STOP. Bytes go out MSB first. SCL and SDA
; are the levels the master drives: 1 means released (the pull-up holds the line high), 0 means pulled low. The caller
; passes in what the device does to SDA (0 while it pulls the line low to ACK, 1 when it leaves it alone); the bus
; level is the AND of both. A device that does not pull SDA low in the ACK slot is a NACK: the master stops at once
; and keeps the index of the byte that was refused (0 address, 1 register, 2 value).
; An open-drain pad (the IOBUF cell) is outside this spec: it maps a released level to high-Z. No pin numbers here.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaI2cMaster;

pub const P_IDLE : u32 = 0;
pub const P_START : u32 = 1;
pub const P_BYTE : u32 = 2;
pub const P_ACK : u32 = 3;
pub const P_STOP : u32 = 4;
pub const P_DONE : u32 = 5;

/// Quarter-ticks of one whole write: START 4, three bytes of 8 bits x 4 plus an ACK slot of 4, STOP 4.
pub const I2C_TICKS_PER_WRITE : u32 = 116;

pub struct I2cM {
    phase: u32,
    q: u32,
    bitn: u32,
    idx: u32,
    scl: u32,
    sda: u32,
    err: u32,
    err_idx: u32,
    done: u32,
    b0: u32,
    b1: u32,
    b2: u32,
}

/// A master set up to write the three bytes, with START as the next phase.
pub fn i2c_begin(b0: u32, b1: u32, b2: u32) -> I2cM {
    return I2cM{ .phase = P_START, .q = 0, .bitn = 0, .idx = 0, .scl = 1, .sda = 1, .err = 0, .err_idx = 0, .done = 0, .b0 = b0, .b1 = b1, .b2 = b2 };
}

/// The byte being sent now.
pub fn i2c_byte(m: *I2cM) -> u32 {
    if (m.idx == 0) { return m.b0; }
    if (m.idx == 1) { return m.b1; }
    return m.b2;
}

/// What a device that ACKs every byte except number nack_at does to SDA: it pulls low in the ACK slot.
pub fn i2c_slave(m: *I2cM, nack_at: u32) -> u32 {
    if (m.phase == P_ACK and m.idx != nack_at) { return 0; }
    return 1;
}

/// The bus level of SDA: wired AND of the master and the device.
pub fn i2c_bus(m: *I2cM, slave: u32) -> u32 {
    return m.sda & slave;
}

/// One quarter-tick. sda_in is the bus level of SDA the master reads. Returns 1 once the transaction is over.
pub fn i2c_tick(m: *I2cM, sda_in: u32) -> u32 {
    if (m.phase == P_IDLE or m.phase == P_DONE) {
        m.scl = 1;
        m.sda = 1;
        return m.done;
    }
    if (m.phase == P_START) {
        if (m.q == 0) { m.scl = 1; m.sda = 1; }
        if (m.q == 1) { m.scl = 1; m.sda = 0; }
        if (m.q >= 2) { m.scl = 0; m.sda = 0; }
        if (m.q == 3) {
            m.phase = P_BYTE;
            m.q = 0;
            m.bitn = 0;
        } else {
            m.q = m.q + 1;
        }
        return 0;
    }
    if (m.phase == P_BYTE) {
        if (m.q == 0) {
            m.scl = 0;
            m.sda = (i2c_byte(m) >> (7 - m.bitn)) & 1;
        }
        if (m.q == 1 or m.q == 2) { m.scl = 1; }
        if (m.q == 3) { m.scl = 0; }
        if (m.q == 3) {
            m.q = 0;
            m.bitn = m.bitn + 1;
            if (m.bitn == 8) {
                m.phase = P_ACK;
                m.bitn = 0;
            }
        } else {
            m.q = m.q + 1;
        }
        return 0;
    }
    if (m.phase == P_ACK) {
        if (m.q == 0) { m.scl = 0; m.sda = 1; }
        if (m.q == 1) { m.scl = 1; }
        if (m.q == 2) {
            m.scl = 1;
            if (sda_in != 0) {
                m.err = 1;
                m.err_idx = m.idx;
            }
        }
        if (m.q == 3) { m.scl = 0; }
        if (m.q == 3) {
            m.q = 0;
            if (m.err == 1 or m.idx == 2) {
                m.phase = P_STOP;
            } else {
                m.idx = m.idx + 1;
                m.phase = P_BYTE;
            }
        } else {
            m.q = m.q + 1;
        }
        return 0;
    }
    // P_STOP: SDA low while SCL rises, then SDA rises while SCL is high.
    if (m.q == 0) { m.scl = 0; m.sda = 0; }
    if (m.q == 1) { m.scl = 1; m.sda = 0; }
    if (m.q >= 2) { m.scl = 1; m.sda = 1; }
    if (m.q == 3) {
        m.phase = P_DONE;
        m.done = 1;
        return 1;
    }
    m.q = m.q + 1;
    return 0;
}

/// A bus monitor: watches the SCL and SDA levels and rebuilds START, STOP and the bytes as a device would see them.
pub struct I2cMon {
    scl: u32,
    sda: u32,
    cap: u32,
    nb: u32,
    bytes: u32,
    last3: u32,
    starts: u32,
    stops: u32,
    nacks: u32,
}

pub fn i2c_mon_new() -> I2cMon {
    return I2cMon{ .scl = 1, .sda = 1, .cap = 0, .nb = 0, .bytes = 0, .last3 = 0, .starts = 0, .stops = 0, .nacks = 0 };
}

/// Feed one sample of the bus levels. last3 holds the last three whole bytes, oldest in the high bits.
pub fn i2c_mon_step(mon: *I2cMon, scl: u32, sda: u32) -> u32 {
    if (scl == 1 and mon.scl == 1 and mon.sda == 1 and sda == 0) {
        mon.starts = mon.starts + 1;
        mon.nb = 0;
        mon.cap = 0;
    }
    if (scl == 1 and mon.scl == 1 and mon.sda == 0 and sda == 1) {
        mon.stops = mon.stops + 1;
    }
    if (scl == 1 and mon.scl == 0) {
        mon.cap = (mon.cap << 1) | sda;
        mon.nb = mon.nb + 1;
        if (mon.nb == 9) {
            if ((mon.cap & 1) == 1) { mon.nacks = mon.nacks + 1; }
            mon.last3 = ((mon.last3 << 8) | ((mon.cap >> 1) & 255)) & 16777215;
            mon.bytes = mon.bytes + 1;
            mon.nb = 0;
            mon.cap = 0;
        }
    }
    mon.scl = scl;
    mon.sda = sda;
    return mon.bytes;
}

test "a_write_clocks_address_register_value_msb_first" {
    var m : I2cM = i2c_begin(114, 8, 53);
    var mon : I2cMon = i2c_mon_new();
    var ticks : u32 = 0;
    while (m.done == 0 and ticks < 500) {
        let s : u32 = i2c_slave(&m, 99);
        let d : u32 = i2c_tick(&m, i2c_bus(&m, s));
        let skip : u32 = i2c_mon_step(&mon, m.scl, i2c_bus(&m, s));
        ticks = ticks + 1;
    }
    assert mon.last3 == 7473205;
    assert mon.bytes == 3;
    assert mon.nacks == 0;
    assert m.err == 0;
}

test "one_start_and_one_stop_frame_the_write" {
    var m : I2cM = i2c_begin(114, 8, 53);
    var mon : I2cMon = i2c_mon_new();
    var ticks : u32 = 0;
    while (m.done == 0 and ticks < 500) {
        let s : u32 = i2c_slave(&m, 99);
        let d : u32 = i2c_tick(&m, i2c_bus(&m, s));
        let skip : u32 = i2c_mon_step(&mon, m.scl, i2c_bus(&m, s));
        ticks = ticks + 1;
    }
    assert mon.starts == 1;
    assert mon.stops == 1;
    assert ticks == I2C_TICKS_PER_WRITE;
}

test "a_nack_stops_the_master_and_names_the_byte" {
    var m : I2cM = i2c_begin(114, 8, 53);
    var mon : I2cMon = i2c_mon_new();
    var ticks : u32 = 0;
    while (m.done == 0 and ticks < 500) {
        let s : u32 = i2c_slave(&m, 1);
        let d : u32 = i2c_tick(&m, i2c_bus(&m, s));
        let skip : u32 = i2c_mon_step(&mon, m.scl, i2c_bus(&m, s));
        ticks = ticks + 1;
    }
    assert m.err == 1;
    assert m.err_idx == 1;
    assert mon.bytes == 2;
    assert mon.nacks == 1;
    assert mon.stops == 1;
}

test "a_refused_address_ends_after_one_byte" {
    var m : I2cM = i2c_begin(114, 8, 53);
    var mon : I2cMon = i2c_mon_new();
    var ticks : u32 = 0;
    while (m.done == 0 and ticks < 500) {
        let s : u32 = i2c_slave(&m, 0);
        let d : u32 = i2c_tick(&m, i2c_bus(&m, s));
        let skip : u32 = i2c_mon_step(&mon, m.scl, i2c_bus(&m, s));
        ticks = ticks + 1;
    }
    assert m.err_idx == 0;
    assert mon.bytes == 1;
    assert m.done == 1;
}

test "an_idle_master_leaves_both_lines_high" {
    var m : I2cM = i2c_begin(1, 2, 3);
    m.phase = P_IDLE;
    m.scl = 0;
    m.sda = 0;
    let d : u32 = i2c_tick(&m, 1);
    assert m.scl == 1;
    assert m.sda == 1;
    assert d == 0;
}
