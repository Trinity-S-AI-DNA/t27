// SPDX-License-Identifier: Apache-2.0
; specs/fpga/hdmi_timing_640x480.t27 -- VGA 640x480 at 60 Hz video timing for the AX7203 HDMI out (#11034, epic #10782).
; Two counters run on the pixel clock (25.175 MHz nominal): h counts 0..799 along a line, v counts 0..524 down a frame.
; Active video is h < 640 and v < 480. Both syncs are active low. Every figure below is the VESA 640x480@60 mode.
; No pin numbers here (they come from the schematic). ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaHdmiTiming640x480;

pub const PIXEL_CLOCK_HZ : u32 = 25175000;
pub const H_ACTIVE : u32 = 640;
pub const H_FRONT : u32 = 16;
pub const H_SYNC : u32 = 96;
pub const H_BACK : u32 = 48;
pub const H_TOTAL : u32 = 800;
pub const V_ACTIVE : u32 = 480;
pub const V_FRONT : u32 = 10;
pub const V_SYNC : u32 = 2;
pub const V_BACK : u32 = 33;
pub const V_TOTAL : u32 = 525;

/// Next horizontal counter: wraps at H_TOTAL.
pub fn hdmi_h_next(h: u32) -> u32 {
    if (h + 1 >= H_TOTAL) { return 0; }
    return h + 1;
}

/// Next vertical counter: moves on only when the line ends, wraps at V_TOTAL.
pub fn hdmi_v_next(h: u32, v: u32) -> u32 {
    if (h + 1 < H_TOTAL) { return v; }
    if (v + 1 >= V_TOTAL) { return 0; }
    return v + 1;
}

/// True inside the visible picture.
pub fn hdmi_active(h: u32, v: u32) -> bool {
    return h < H_ACTIVE and v < V_ACTIVE;
}

/// True during blanking (everything that is not active).
pub fn hdmi_blank(h: u32, v: u32) -> bool {
    return hdmi_active(h, v) == false;
}

/// Horizontal sync level: low during the sync pulse.
pub fn hdmi_hsync(h: u32) -> bool {
    const start : u32 = H_ACTIVE + H_FRONT;
    return (h >= start and h < start + H_SYNC) == false;
}

/// Vertical sync level: low during the sync pulse.
pub fn hdmi_vsync(v: u32) -> bool {
    const start : u32 = V_ACTIVE + V_FRONT;
    return (v >= start and v < start + V_SYNC) == false;
}

/// Frames a second at the nominal pixel clock (whole frames).
pub fn hdmi_frames_per_s() -> u32 {
    return PIXEL_CLOCK_HZ / (H_TOTAL * V_TOTAL);
}

/// Line length from the four parts; must equal H_TOTAL.
pub fn hdmi_h_sum() -> u32 {
    return H_ACTIVE + H_FRONT + H_SYNC + H_BACK;
}

/// Frame height from the four parts; must equal V_TOTAL.
pub fn hdmi_v_sum() -> u32 {
    return V_ACTIVE + V_FRONT + V_SYNC + V_BACK;
}

test the_totals_add_up {
    assert hdmi_h_sum() == H_TOTAL;
    assert hdmi_v_sum() == V_TOTAL;
    assert hdmi_frames_per_s() == 59;
}

test a_line_is_800_clocks_with_a_96_clock_low_sync {
    var h : u32 = 0;
    var n : u32 = 0;
    var low : u32 = 0;
    var act : u32 = 0;
    while (n < H_TOTAL) {
        if (hdmi_hsync(h) == false) { low = low + 1; }
        if (hdmi_active(h, 0)) { act = act + 1; }
        h = hdmi_h_next(h);
        n = n + 1;
    }
    assert h == 0;
    assert low == 96;
    assert act == 640;
}

test a_frame_is_525_lines_with_a_2_line_low_sync {
    var v : u32 = 0;
    var n : u32 = 0;
    var low : u32 = 0;
    var act : u32 = 0;
    while (n < V_TOTAL) {
        if (hdmi_vsync(v) == false) { low = low + 1; }
        if (hdmi_active(0, v)) { act = act + 1; }
        v = hdmi_v_next(H_TOTAL - 1, v);
        n = n + 1;
    }
    assert v == 0;
    assert low == 2;
    assert act == 480;
}

test the_edges_of_each_region {
    assert hdmi_hsync(655);
    assert hdmi_hsync(656) == false;
    assert hdmi_hsync(751) == false;
    assert hdmi_hsync(752);
    assert hdmi_vsync(489);
    assert hdmi_vsync(490) == false;
    assert hdmi_vsync(491) == false;
    assert hdmi_vsync(492);
    assert hdmi_active(639, 479);
    assert hdmi_blank(640, 0);
    assert hdmi_blank(0, 480);
}

test the_vertical_counter_holds_until_the_line_ends {
    assert hdmi_v_next(5, 7) == 7;
    assert hdmi_v_next(799, 7) == 8;
    assert hdmi_v_next(799, 524) == 0;
    assert hdmi_h_next(799) == 0;
    assert hdmi_h_next(0) == 1;
}
