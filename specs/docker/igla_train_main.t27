// SPDX-License-Identifier: Apache-2.0
// docker/igla_train_main: the program that emits the igla-train Dockerfile to stdout
// (Trinity-S-AI-DNA/t27#13007). The text and its tests live in specs/docker/igla_train.t27; this file
// only moves the bytes, in the shape of specs/t27os/plist_main.t27: a t27b-built `main` that calls the
// pure text function and writes the buffer through the `write` import of specs/t27os/pty_sys.t27. It
// holds @extern through that import; t27c typechecks it and runs the one test below, since the import is
// linked by t27b and never called from a test. `t27c test-report specs/docker/igla_train.t27` covers the
// text itself.
//
// Build and run, from the repository root, as run on 2026-10-31:
//   t27b build specs/docker/igla_train_main.t27 -o dm.o --macho
//   ld -lSystem -syslibroot $(xcrun --show-sdk-path) -e _main -o dm dm.o
//   ./dm > gen/docker/igla-train.Dockerfile
// The output lands under gen/, which is gitignored, and stays a build product: igla_train.t27 says why
// no copy is committed. Exit 0 with the whole text on stdout; exit 2 when the text would not fit the
// buffer (nothing written).
module DockerIglaTrainMain;
use docker::igla_train::dockerfile;
use docker::igla_train::DOCKERFILE_LEN;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_exit;

pub fn main() -> void {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(out[0..16384], 16384);
    if (n > 16384) { sys_exit(2); }
    sys_write(1, out[0..16384], @as(u64, @intCast(n)));
    sys_exit(0);
}

test the_program_writes_the_whole_dockerfile_without_clipping {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(out[0..16384], 16384);
    assert n == DOCKERFILE_LEN;
    assert n < 16384;
    assert out[0] == '#';
}
