pub const D_README_B : str = "  --gpus all \\\\\\n\\\n  -p 6006:6006 \\\\\\n\\\n  -v $(pwd)/logs:/workspace/igla-coder/logs \\\\\\n\\\n  igla-coder-train:latest \\\\\\n\\\n  tensorboard --logdir=logs --port=6006 --host=0.0.0.0\\n\\\n```\\n\\\n\\n\\\n## Configuration\\n\\\nSee `configs/default.yaml` for default training configuration.\\n\\\n\\n\\\n## Validation\\n\\\nRun environment validation:\\n\\\n```bash\\ndocker run --rm igla-coder-train:latest /workspace/validate_env.sh\\n\\\n```\\n\\\n\\n\\\n## Troubleshooting\\n\\\n\\n\\\n### CUDA/ROCm Detection Issues\\n\\\n1. Check `validate_env.sh` output\\n\\\n2. Verify GPU is visible to container\\n\\\n3. Check cluster ROCm/NVIDIA driver version compatibility\\n\\\n\\n\\\n### Memory Issues\\n\\\n- Reduce `batch_size` in config\\n\\\n- Increase `gradient_accumulation_steps`\\n\\\n- Use mixed precision training (FP16/BF16)\\n\\\n\\n\\\n### Performance Issues\\n\\\n- Verify GPU is not in exclusive mode\\n\\\n- Check PCIe bandwidth utilization\\n\\\n- Monitor GPU temperature and power draw\\n\\\n\\n\\\n## References\\n\\\n- AMD ROCm 6.2: https://www.amd.com/en/technologies/rocm\\n\\\n- PyTorch CUDA Documentation: https://pytorch.org/docs/stable/notes/cuda.html\\n\\\n- Docker GPU Support: https://docs.docker.com/engine/guides/containers/dockerfiles/\\n\\\n\\n\\\n## License\\n\\\nApache-2.0\\n\\\n\\n\\\n## Copyright\\n\\\n2026 Trinity S3AI\\n\\\nphi^2 + 1/phi^2 = 3 | TRINITY\\n' > /workspace/igla-coder/CONTAINER_README.md\n\n";
pub const D_README_B_LEN : usize = 1321;
pub const D_TAIL : str = "# ============================================================================\n# End of Dockerfile\n# phi^2 + 1/phi^2 = 3 | TRINITY\n# ============================================================================";
pub const D_TAIL_LEN : usize = 209;

/// Byte length of the whole Dockerfile: the sum of the 22 piece lengths above, pinned so a text
/// edit that forgets a _LEN fails here before it reaches the committed file.
// The source Dockerfile ends without a trailing newline, so the emitted bytes do too.
pub const DOCKERFILE_LEN : usize = 10724;

/// Writes the Dockerfile into `out` (at most `cap` bytes) and returns the byte count of the whole
/// text, clipped or not, so a caller can size the buffer from the return value.
pub fn dockerfile(out : []u8, cap : usize) -> usize {
    var w : usize = 0;
    w = put_str(out, cap, w, D_HEAD, D_HEAD_LEN);
    w = put_str(out, cap, w, D_ENV, D_ENV_LEN);
    w = put_str(out, cap, w, D_APT, D_APT_LEN);
    w = put_str(out, cap, w, D_PIP, D_PIP_LEN);
    w = put_str(out, cap, w, D_WORKDIR, D_WORKDIR_LEN);
    w = put_str(out, cap, w, D_USER_SETUP, D_USER_SETUP_LEN);
    w = put_str(out, cap, w, D_COPY_REPO, D_COPY_REPO_LEN);
    w = put_str(out, cap, w, D_SWITCH_USER, D_SWITCH_USER_LEN);
    w = put_str(out, cap, w, D_OUTPUT_DIRS, D_OUTPUT_DIRS_LEN);
    w = put_str(out, cap, w, D_PORTS, D_PORTS_LEN);
    w = put_str(out, cap, w, D_HEALTH, D_HEALTH_LEN);
    w = put_str(out, cap, w, D_CMD, D_CMD_LEN);
    w = put_str(out, cap, w, D_GPU_NOTES, D_GPU_NOTES_LEN);
    w = put_str(out, cap, w, D_VALIDATE, D_VALIDATE_LEN);
    w = put_str(out, cap, w, D_ENTRYPOINT, D_ENTRYPOINT_LEN);
    w = put_str(out, cap, w, D_TRAIN_FILES, D_TRAIN_FILES_LEN);
    w = put_str(out, cap, w, D_COMPOSE, D_COMPOSE_LEN);
    w = put_str(out, cap, w, D_SIZE, D_SIZE_LEN);
    w = put_str(out, cap, w, D_LOGGING, D_LOGGING_LEN);
    w = put_str(out, cap, w, D_README_A, D_README_A_LEN);
    w = put_str(out, cap, w, D_README_B, D_README_B_LEN);
    w = put_str(out, cap, w, D_TAIL, D_TAIL_LEN);
    return w;
}

/// Offset of the first occurrence of `needle` in `buf`, or `buf_len` when it does not occur. The
/// position lets a test pin where a line sits, where buf_has only says that it sits somewhere.
pub fn first_at(buf : []const u8, buf_len : usize, needle : str, needle_len : usize) -> usize {
    if (needle_len > buf_len) { return buf_len; }
    var start : usize = 0;
    while (start + needle_len <= buf_len) {
        var k : usize = 0;
        var same : usize = 0;
        while (k < needle_len) {
            if (buf[start + k] == needle[k]) { same += 1; }
            k += 1;
        }
        if (same == needle_len) { return start; }
        start += 1;
    }
    return buf_len;
}

/// How many times `needle` occurs in `buf`, overlapping occurrences counted once each per start.
pub fn count_of(buf : []const u8, buf_len : usize, needle : str, needle_len : usize) -> usize {
    var found : usize = 0;
    if (needle_len > buf_len) { return found; }
    var start : usize = 0;
    while (start + needle_len <= buf_len) {
        var k : usize = 0;
        var same : usize = 0;
        while (k < needle_len) {
            if (buf[start + k] == needle[k]) { same += 1; }
            k += 1;
        }
        if (same == needle_len) { found += 1; }
        start += 1;
    }
    return found;
}

/// Bytes of `buf` that are neither a newline nor printable ASCII (32..126): the L3 PURITY count.
pub fn non_ascii_count(buf : []const u8, buf_len : usize) -> usize {
    var bad : usize = 0;
    var i : usize = 0;
    while (i < buf_len) {
        if (buf[i] != '\n') {
            if (buf[i] < 32) { bad += 1; }
            if (buf[i] > 126) { bad += 1; }
        }
        i += 1;
    }
    return bad;
}

test every_piece_ends_where_its_length_says {
    var i : usize = 0;
    i = D_HEAD_LEN - 1;
    assert D_HEAD[i] == '\n';
    i = D_ENV_LEN - 1;
    assert D_ENV[i] == '\n';
    i = D_APT_LEN - 1;
    assert D_APT[i] == '\n';
    i = D_PIP_LEN - 1;
    assert D_PIP[i] == '\n';
    i = D_WORKDIR_LEN - 1;
    assert D_WORKDIR[i] == '\n';
    i = D_USER_SETUP_LEN - 1;
    assert D_USER_SETUP[i] == '\n';
    i = D_COPY_REPO_LEN - 1;
    assert D_COPY_REPO[i] == '\n';
    i = D_SWITCH_USER_LEN - 1;
    assert D_SWITCH_USER[i] == '\n';
    i = D_OUTPUT_DIRS_LEN - 1;
    assert D_OUTPUT_DIRS[i] == '\n';
    i = D_PORTS_LEN - 1;
    assert D_PORTS[i] == '\n';
    i = D_HEALTH_LEN - 1;
    assert D_HEALTH[i] == '\n';
    i = D_CMD_LEN - 1;
    assert D_CMD[i] == '\n';
    i = D_GPU_NOTES_LEN - 1;
    assert D_GPU_NOTES[i] == '\n';
    i = D_VALIDATE_LEN - 1;
    assert D_VALIDATE[i] == '\n';
    i = D_ENTRYPOINT_LEN - 1;
    assert D_ENTRYPOINT[i] == '\n';
    i = D_TRAIN_FILES_LEN - 1;
    assert D_TRAIN_FILES[i] == '\n';
    i = D_COMPOSE_LEN - 1;
    assert D_COMPOSE[i] == '\n';
    i = D_SIZE_LEN - 1;
    assert D_SIZE[i] == '\n';
    i = D_LOGGING_LEN - 1;
    assert D_LOGGING[i] == '\n';
    i = D_README_A_LEN - 1;
    assert D_README_A[i] == '\n';
    i = D_README_B_LEN - 1;
    assert D_README_B[i] == '\n';
    i = D_TAIL_LEN - 1;
    assert D_TAIL[i] == '=';
}

test the_dockerfile_is_whole_and_pinned {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(&out, 16384);
    assert n == DOCKERFILE_LEN;
    assert out[0] == '#';
    assert out[n - 1] == '=';
    assert first_at(&out, n, "# SPDX-License-Identifier: Apache-2.0\n", 38) == 0;
    assert first_at(&out, n, "FROM ubuntu:22.04\n", 18) == 188;
    assert first_at(&out, n, "# End of Dockerfile\n", 20) == 10594;
}

test every_byte_is_printable_ascii_and_the_identity_is_spelled_out {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(&out, 16384);
    assert non_ascii_count(&out, n) == 0;
    assert count_of(&out, n, "phi^2 + 1/phi^2 = 3", 19) == 3;
}

test the_workspace_is_owned_before_the_user_switch {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(&out, 16384);
    const chown_at : usize = first_at(&out, n, "chown -R appuser:appuser /workspace\n", 36);
    const copy_at : usize = first_at(&out, n, "COPY --chown=appuser:appuser . /workspace/igla-coder/\n", 54);
    const user_at : usize = first_at(&out, n, "\nUSER appuser\n", 14);
    assert chown_at == 1648;
    assert copy_at == 1728;
    assert user_at == 1808;
    assert chown_at < copy_at;
    assert copy_at < user_at;
    assert count_of(&out, n, "chown -R appuser:appuser /workspace\n", 36) == 1;
    assert count_of(&out, n, "\nUSER appuser\n", 14) == 1;
}

test the_ports_and_command_are_the_known_ones {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(&out, 16384);
    assert buf_has(&out, n, "EXPOSE 6006 8080 8888\n", 22) == true;
    assert buf_has(&out, n, "CMD [\"/bin/bash\"]\n", 18) == true;
    assert buf_has(&out, n, "WORKDIR /workspace/igla-coder\n", 30) == true;
}

test no_home_path_leaks_into_the_image {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(&out, 16384);
    assert buf_has(&out, n, "/Users/", 7) == false;
    assert buf_has(&out, n, "t27-lanes", 9) == false;
}

test the_helpers_answer_absence_too {
    var out : [16384]u8 = undefined;
    const n : usize = dockerfile(&out, 16384);
    assert first_at(&out, n, "FROM alpine", 11) == n;
    assert count_of(&out, n, "FROM alpine", 11) == 0;
    assert first_at(&out, 4, "FROM ubuntu:22.04\n", 18) == 4;
}

test a_short_buffer_is_clipped_but_counted {
    var small : [8]u8 = undefined;
    const m : usize = dockerfile(&small, 8);
    assert m == DOCKERFILE_LEN;
    assert buf_has(&small, 8, "# SPDX-L", 8) == true;
}
