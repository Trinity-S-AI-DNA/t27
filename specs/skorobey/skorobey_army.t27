pub const ID : str = "0xskorobey@army.t27";
pub const DOMAIN : str = "skorobey";
pub const ARCHETYPE : str = "Warrior - battle leader, primary force";
pub const LAYER : str = "Physical";
pub const REGISTER : str = "R26";
