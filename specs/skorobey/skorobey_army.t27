test skorobey_army_constants {
    assert KIND == "army";
    assert ID == "0xskorobey@army.t27";
    assert DOMAIN == "skorobey";
    assert ARCHETYPE == "Warrior - battle leader, primary force";
    assert LAYER == "Physical";
    assert REGISTER == "R26";
    assert SUMMARY_EN == "Skorobey army domain: military organization and pipeline phases for t27 Trinity S³AI project.";
}

; Pipeline phase count
pub const PIPELINE_PHASE_COUNT : u8 = 6;

; Phase order
pub fn pipeline_phase_name(i: u8) -> str {
    if i == 0 { return PHASE_DRAFT; }
    if i == 1 { return PHASE_REGISTER; }
    if i == 2 { return PHASE_ARCHETYPE; }
    if i == 3 { return PHASE_LAYER; }
    if i == 4 { return PHASE_REGISTER_FORMAL; }
    if i == 5 { return PHASE_SUMMARY; }
    return "";
}

; Validate phase count
test skorobey_army_pipeline_phase_count {
    assert PIPELINE_PHASE_COUNT == 6;
    assert pipeline_phase_name(0) == PHASE_DRAFT;
    assert pipeline_phase_name(1) == PHASE_REGISTER;
    assert pipeline_phase_name(2) == PHASE_ARCHETYPE;
    assert pipeline_phase_name(3) == PHASE_LAYER;
    assert pipeline_phase_name(4) == PHASE_REGISTER_FORMAL;
    assert pipeline_phase_name(5) == PHASE_SUMMARY;
}
// phi^2 + 1/phi^2 = 3 | TRINITY