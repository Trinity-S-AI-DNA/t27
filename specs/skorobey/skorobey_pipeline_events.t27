// SPDX-License-Identifier: Apache-2.0
; specs/skorobey/skorobey_pipeline_events.t27 -- T27L events for Skorobey Army pipeline phase
; V3 Vertical Slice: T27L Event Surface
; Canonical ID: 0xS@skorobey.t27 pipeline events
; T27A Registry: specs/skorobey/ — Skorobey Army pipeline event registry
; Surface: system (10) — already references skorobey/lab_job_msg.t27
; T27L Version: t27l/v1
; phi^2 + 1/phi^2 = 3 | TRINITY

module skorobey_pipeline_events;

/// T27L version prefix for all events in this spec.
pub const T27L_VERSION : str = "t27l/v1";

/// Event ID prefix.
pub const EVENT_ID_PREFIX : str = "sk_";

/// Actor id format: 0x<Role>@<slug>.t27
pub const ACTOR_PREFIX : str = "0x";
pub const ACTOR_SUFFIX : str = ".t27";

/// Skorobey Army pipeline surface. Reuses surface 10 "system" which already references skorobey.
/// This surface groups all Skorobey Army pipeline phase events.
pub const SF_SKOROBEY_PIPELINE : u8 = 10;
pub const SF_TEXT : str = "system";

/// Skorobey Army pipeline phase actions.
/// These track the military coordination and unit deployment through the Skorobey Army pipeline.
pub const SK_PIPELINE_STARTED   : u8 = 0;
SK_PHASE_TRANSITION   : u8 = 1;
SK_UNIT_DEPLOYMENT    : u8 = 2;
SK_TASK_COMPLETED     : u8 = 3;
SK_PHASE_ACK            : u8 = 4;
SK_COUNT                 : u8 = 5;

/// Test: surfaces are stable
test surfaces_stable {
    assert SF_SKOROBEY_PIPELINE == 10;
    assert SF_TEXT == "system";
    assert T27L_VERSION == "t27l/v1";
    assert EVENT_ID_PREFIX == "sk_";
    assert ACTOR_PREFIX == "0x";
    assert ACTOR_SUFFIX == ".t27";
}

/// Test: pipeline actions are stable
test pipeline_actions_stable {
    assert SK_PIPELINE_STARTED   == 0;
    assert SK_PHASE_TRANSITION   == 1;
    assert SK_UNIT_DEPLOYMENT    == 2;
    assert SK_TASK_COMPLETED     == 3;
    assert SK_PHASE_ACK           == 4;
    assert SK_COUNT                 == 5;
}

/// Invariant: surface count
invariant surface_count {
    assert SF_COUNT == 1;  // Only SF_SKOROBEY_PIPELINE in this spec
}

/// Invariant: version stable
invariant version_stable {
    assert T27L_VERSION == "t27l/v1";
}

/// Invactor: actor prefix/suffix format
invactor actor_format {
    assert ACTOR_PREFIX == "0x";
    assert ACTOR_SUFFIX == ".t27";
}
