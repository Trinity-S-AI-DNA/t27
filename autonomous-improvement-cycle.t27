// Генерация комплексного отчёта
fn generate_comprehensive_report(metrics: struct {
    cycles_completed: u32,
    issues_found: u32,
    issues_fixed: u32,
    auto_fixes: u32,
    coverage: f64,
    github_issues: u32
}) -> void {
    log_message("📊 Метрики цикла:");
    log_message(@concat("   • Циклы завершены: ", @toString(metrics.cycles_completed)));
    log_message(@concat("   • Проблем найдено: ", @toString(metrics.issues_found)));
    log_message(@concat("   • Проблем решено: ", @toString(metrics.issues_fixed)));
    log_message(@concat("   • Авто-фиксов: ", @toString(metrics.auto_fixes)));
    log_message(@concat("   • Coverage: ", @toString(@as(u32, @intCast(metrics.coverage))), "%"));
    log_message(@concat("   • GitHub issues: ", @toString(metrics.github_issues)));

    log_message("📈 Успешность:");
    if (metrics.coverage >= 95.0) {
        log_message("   ✅ Coverage: Отлично (95%+)");
    } else if (metrics.coverage >= 80.0) {
        log_message("   ✅ Coverage: Хорошо (80%+)");
    } else {
        log_message("   ⚠️ Coverage: Требует улучшения");
    }

    if (metrics.issues_fixed >= metrics.issues_found * 0.8) {
        log_message("   ✅ Решение проблем: 80%+ эффективность");
    } else {
        log_message("   ⚠️ Решение проблем: Требует улучшения");
    }

    if (metrics.auto_fixes > 0) {
        log_message("   ✅ Авто-фикс: Активен");
    } else {
        log_message("   ⚠️ Авто-фикс: Требует включения");
    }
}

