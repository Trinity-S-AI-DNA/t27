// SPDX-License-Identifier: Apache-2.0
module DnaRead;
// Reads DNA_PORT: READ for one cycle, then sample DOUT and pulse SHIFT, 57 times; the first
// bit out is the most significant. dout is DNA_PORT.DOUT; dna_read and dna_shift drive READ
// and SHIFT; the wrapper ties DIN to 0 and clocks DNA_PORT and this module from one BUFG.
const LAST_BIT : u8 = 56
var step : u8 = 0
var bits : u8 = 0
var dna : u64 = 0
var dna_read : bool = false
var dna_shift : bool = false
var done : bool = false
fn bit64(b: bool) -> u64 { if (b) { return 1; } return 0; }
fn on_clock(dout: bool) {
    if (done == false) {
        if (step == 0) { dna_read = true; step = 1; } else {
            if (step == 1) { dna_read = false; step = 2; } else {
                if ((step & 1) == 0) {
                    dna = (dna << 1) | bit64(dout);
                    if (bits == LAST_BIT) { done = true; } else { dna_shift = true; }
                    bits = bits + 1;
                } else { dna_shift = false; }
                step = step + 1;
            }
        }
    }
}
test a_model_dna_port_reads_back_msb_first {
    step = 0; bits = 0; dna = 0; dna_read = false; dna_shift = false; done = false;
    var want : u64 = 26014484963072084;
    var reg : u64 = 0;
    var dout : bool = false;
    var i : u32 = 0;
    while (i < 200) {
        var r : bool = dna_read;
        var s : bool = dna_shift;
        on_clock(dout);
        if (r) { reg = want; } else { if (s) { reg = (reg << 1) % 144115188075855872; } }
        dout = ((reg >> 56) & 1) == 1;
        i = i + 1;
    }
    assert_eq(dna, want);
    assert_eq(done, true);
}