module PiAiTimeoutVerify {

    use base::types;
    
    // Constants
    const EXPECTED_STREAM_TIMEOUT_MS = 3600000
    const EXPECTED_HTTP_TIMEOUT_MS = 3600000
    const MAX_TEST_DURATION_MS = 3700000
    
    // Evidence record structure
    type EvidenceRecord {
        test_id : string
        timestamp : string
        configuration_effective : bool
        stream_timeout_effective : bool
        http_timeout_effective : bool
        active_provider : string
        long_stream_completed : bool
        timeout_error_detected : bool
