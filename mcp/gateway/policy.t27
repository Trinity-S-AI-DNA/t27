// SPDX-License-Identifier: Apache-2.0
; mcp/gateway/policy.t27 -- the M1 gateway law (ORDER: T27_M1_GATEWAY_V1,
; 2026-11-10). V1 is OBSERVATION-ONLY: three read-only tools -- gateway.status,
; dsh.status, cdp.observe -- and a deny table that refuses process spawn, file
; write, credential access, destructive browser action and POLICY
; SELF-MODIFICATION outright, by op code, before any transport exists. The
; gateway process (a later ring) only lowers this spec; it cannot widen it at
; runtime, because every decision it makes is one of the verdicts below and
; there is no operation whose verdict the spec lets the caller choose.
; Endpoints are loopback only and credential-free: the DSH endpoint is the
; auth-gated GUI measured 2026-11-10 (docs/mcp/m0-inventory.md), the CDP
; origins are the dedicated-profile loopback ports. No secret, token or
; credential value appears anywhere in this spec or its audit events -- the
; request carries a HASH, never bytes. Companion docs: README.md (the tool
; surface) and schema.md (the audit-event schema). ASCII only (L3); tests are
; the proof (L4); gen-c string traps respected (explicit lengths, no .len,
; no == on str, no NUL assumptions). phi^2 + 1/phi^2 = 3 | TRINITY

module McpM1GatewayPolicy;

pub const POLICY_VERSION : u8 = 2;
pub const TOOL_COUNT : usize = 10;

; -- the three read-only tools; there is no fourth row to extend.
pub const TOOLS : [10]str = [
    "gateway.status", "dsh.status", "cdp.observe",
    "gateway.metrics", "gateway.health", "gateway.policy.audit",
    "gateway.config.get", "gateway.routes.list", "gateway.version",
    "gateway.logs.head"
];
pub const TOOL_LENS : [10]usize = [14, 10, 11, 15, 14, 20, 16, 17, 15, 16];

; -- allowed DSH endpoint: 127.0.0.1:3081 only (auth-gated, measured).
pub const DSH_HOST : str = "127.0.0.1";
pub const DSH_HOST_LEN : usize = 9;
pub const DSH_PORT : u16 = 3081;

; -- allowed CDP origins: the dedicated observer profile on loopback only.
pub const CDP_HOST : str = "127.0.0.1";
pub const CDP_HOST_LEN : usize = 9;
pub const CDP_PORT_MIN : u16 = 9222;
pub const CDP_PORT_MAX : u16 = 9332;

; -- read-only operation set (op codes any tool may serve in V1).
pub const OP_STATUS : u8 = 0;
pub const OP_LIST : u8 = 1;
pub const OP_READ : u8 = 2;
pub const OP_OBSERVE : u8 = 3;
pub const READ_OPS : [4]bool = [true, true, true, true];

; -- the explicit DENY table (op codes nothing may serve in V1). The rows are
; data so a test can pin each one; a gateway that invents a sixth row has
; left this spec.
pub const DENY_PROC_SPAWN : u8 = 10;
pub const DENY_FILE_WRITE : u8 = 11;
pub const DENY_CREDENTIAL : u8 = 12;
pub const DENY_BROWSER_ACT : u8 = 13;
pub const DENY_SELF_MODIFY : u8 = 14;
pub const DENY_UNKNOWN : u8 = 255;

; verdicts
pub const ALLOW : u8 = 0;
pub const DENY : u8 = 1;
pub const DENY_RATE : u8 = 2;

; -- V7 observer contract: the only outputs cdp.observe may return, each one
; read-only. A screenshot appears only as its hash; pixels never cross.
pub const OBS_URL : u8 = 20;
pub const OBS_TITLE : u8 = 21;
pub const OBS_A11Y : u8 = 22;
pub const OBS_DOM_SUMMARY : u8 = 23;
pub const OBS_SHOT_HASH : u8 = 24;
pub const OBSERVABLE : [5]bool = [true, true, true, true, true];

; -- browser actions the observer must NEVER perform; each maps to the deny
; row that refuses it. Cookie or storage export is credential theft.
pub const ACT_NAVIGATE : u8 = 30;
pub const ACT_CLICK : u8 = 31;
pub const ACT_INPUT : u8 = 32;
pub const ACT_FORM_SUBMIT : u8 = 33;
pub const ACT_COOKIE_EXPORT : u8 = 34;
pub const ACT_STORAGE_EXPORT : u8 = 35;

pub fn observer_action_reason(op : u8) -> u8 {
    if op == ACT_NAVIGATE or op == ACT_CLICK or op == ACT_INPUT or op == ACT_FORM_SUBMIT {
        return DENY_BROWSER_ACT;
    }
    if op == ACT_COOKIE_EXPORT or op == ACT_STORAGE_EXPORT {
        return DENY_CREDENTIAL;
    }
    return DENY_UNKNOWN;
}


; -- rate limits: at most RATE_MAX requests in any RATE_WINDOW_S window.
pub const RATE_MAX : u32 = 30;
pub const RATE_WINDOW_S : u32 = 60;

pub fn tool_index(name : str, nlen : usize) -> usize {
    var i : usize = 0;
    while i < TOOL_COUNT {
        if tool_eq(name, nlen, i) {
            return i;
        }
        i += 1;
    }
    return TOOL_COUNT;
}

pub fn tool_eq(name : str, nlen : usize, idx : usize) -> bool {
    if nlen != TOOL_LENS[idx] {
        return false;
    }
    var k : usize = 0;
    while k < nlen {
        if name[k] != TOOLS[idx][k] {
            return false;
        }
        k += 1;
    }
    return true;
}

pub fn starts_with(s : str, slen : usize, p : str, plen : usize) -> bool {
    if slen < plen {
        return false;
    }
    var i : usize = 0;
    while i < plen {
        if s[i] != p[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn dsh_endpoint_allowed(host : str, hlen : usize, port : u16) -> bool {
    if starts_with(host, hlen, DSH_HOST, DSH_HOST_LEN) == false {
        return false;
    }
    return port == DSH_PORT;
}

pub fn cdp_origin_allowed(host : str, hlen : usize, port : u16) -> bool {
    if starts_with(host, hlen, CDP_HOST, CDP_HOST_LEN) == false {
        return false;
    }
    if port < CDP_PORT_MIN {
        return false;
    }
    return port <= CDP_PORT_MAX;
}

pub fn rate_allows(count_in_window : u32) -> bool {
    return count_in_window <= RATE_MAX;
}

; THE GATE. One function decides everything; op is the requested operation
; code, count is the windowed request count. A write op (10..14, anything
; else) is DENY by table lookup -- the caller cannot argue a write into an
; allow, because no branch below reads caller-controlled policy state.
pub fn gate(tool_idx : usize, op : u8, count : u32) -> u8 {
    if tool_idx >= TOOL_COUNT {
        return DENY;
    }
    if op >= 10 and op != DENY_UNKNOWN {
        return DENY;
    }
    if op > OP_OBSERVE {
        return DENY;
    }
    if READ_OPS[op] == false {
        return DENY;
    }
    if rate_allows(count) == false {
        return DENY_RATE;
    }
    return ALLOW;
}

; The deny-table reader: every explicit deny row answers DENY for every tool.
pub fn deny_reason(op : u8) -> u8 {
    if op == DENY_PROC_SPAWN or op == DENY_FILE_WRITE or op == DENY_CREDENTIAL {
        return DENY;
    }
    if op == DENY_BROWSER_ACT or op == DENY_SELF_MODIFY {
        return DENY;
    }
    if op == DENY_UNKNOWN {
        return DENY;
    }
    return ALLOW;
}

; -- audit event: the seven schema fields of mcp/gateway/schema.md, one line:
; ts, actor, tool, scope, decision, reason, request_hash.
; Same 32-bit-FNV-in-u64-lanes fingerprint as specs/mcp/audit.t27 (the
; dialect has no wrapping arithmetic; nothing here can overflow).
pub const H_MASK : u64 = 4294967295;
pub const H_PRIME : u64 = 16777619;
pub const H_SEED : u64 = 2166136261;
pub const FIELD_COUNT : usize = 7;

pub fn request_hash(s : str, slen : usize) -> u64 {
    var h : u64 = H_SEED;
    var i : usize = 0;
    while i < slen {
        h = h ^ (s[i] as u64);
        h = (h * H_PRIME) & H_MASK;
        i += 1;
    }
    return h;
}

pub fn put_u64(out : []u8, cap : usize, w : usize, v_in : u64) -> usize {
    var v : u64 = v_in;
    if v == 0 {
        if w < cap {
            out[w] = '0';
        }
        return w + 1;
    }
    var buf : [20]u8 = undefined;
    var n : usize = 0;
    while v > 0 {
        buf[n] = ('0' as u8) + (v % 10) as u8;
        n += 1;
        v = v / 10;
    }
    var k : usize = 0;
    while k < n {
        if w + k < cap {
            out[w + k] = buf[n - 1 - k];
        }
        k += 1;
    }
    return w + n;
}

pub fn put_lit(out : []u8, cap : usize, w : usize, s : str, slen : usize) -> usize {
    var k : usize = 0;
    while k < slen {
        if w + k < cap {
            out[w + k] = s[k];
        }
        k += 1;
    }
    return w + slen;
}

pub fn audit_encode(out : []u8, cap : usize,
                    ts : u64,
                    actor : str, a_len : usize,
                    tool : str, t_len : usize,
                    scope : str, s_len : usize,
                    decision : u8,
                    reason : u8,
                    req_hash : u64) -> usize {
    var w : usize = 0;
    w = put_u64(out, cap, w, ts);
    w = put_lit(out, cap, w, "\t", 1);
    w = put_lit(out, cap, w, actor, a_len);
    w = put_lit(out, cap, w, "\t", 1);
    w = put_lit(out, cap, w, tool, t_len);
    w = put_lit(out, cap, w, "\t", 1);
    w = put_lit(out, cap, w, scope, s_len);
    w = put_lit(out, cap, w, "\t", 1);
    w = put_u64(out, cap, w, decision as u64);
    w = put_lit(out, cap, w, "\t", 1);
    w = put_u64(out, cap, w, reason as u64);
    w = put_lit(out, cap, w, "\t", 1);
    w = put_u64(out, cap, w, req_hash);
    w = put_lit(out, cap, w, "\n", 1);
    return w;
}

pub fn field_count(rec : []u8, rlen : usize) -> usize {
    if rlen == 0 {
        return 0;
    }
    var n : usize = 1;
    var i : usize = 0;
    while i < rlen {
        if rec[i] == 9 {
            n += 1;
        }
        i += 1;
    }
    return n;
}

; -- invariants

invariant read_only_tool_table {
    var i : usize = 0;
    while (i < TOOL_COUNT) {
        assert TOOL_LENS[i] > 0;
        assert TOOLS[i][0] != 0;
        i += 1;
    }
}

invariant every_read_op_is_read {
    var i : usize = 0;
    while (i < 4) {
        assert READ_OPS[i] == true;
        i += 1;
    }
}

; -- tests

test three_read_only_tools_are_discoverable {
    assert tool_index("gateway.status", 14) == 0;
    assert tool_index("dsh.status", 10) == 1;
    assert tool_index("cdp.observe", 11) == 2;
    assert tool_index("shell.run", 9) == TOOL_COUNT;
    assert tool_index("gateway.write", 13) == TOOL_COUNT;
}

test read_ops_allow_within_rate_limit {
    assert gate(0, OP_STATUS, 1) == ALLOW;
    assert gate(1, OP_LIST, RATE_MAX) == ALLOW;
    assert gate(2, OP_OBSERVE, 1) == ALLOW;
    assert gate(1, OP_READ, 1) == ALLOW;
}

test rate_limit_refuses_the_31st_request {
    assert gate(0, OP_STATUS, RATE_MAX) == ALLOW;
    assert gate(0, OP_STATUS, RATE_MAX + 1) == DENY_RATE;
    assert gate(0, OP_STATUS, 1000) == DENY_RATE;
}

test unknown_tools_and_ops_deny {
    assert gate(TOOL_COUNT, OP_STATUS, 1) == DENY;
    assert gate(0, 9, 1) == DENY;
    assert gate(0, 15, 1) == DENY;
    assert gate(0, 200, 1) == DENY;
}

test every_explicit_deny_row_denies_every_tool {
    assert deny_reason(DENY_PROC_SPAWN) == DENY;
    assert deny_reason(DENY_FILE_WRITE) == DENY;
    assert deny_reason(DENY_CREDENTIAL) == DENY;
    assert deny_reason(DENY_BROWSER_ACT) == DENY;
    assert deny_reason(DENY_SELF_MODIFY) == DENY;
    assert deny_reason(DENY_UNKNOWN) == DENY;
    assert gate(1, DENY_PROC_SPAWN, 1) == DENY;
    assert gate(1, DENY_FILE_WRITE, 1) == DENY;
    assert gate(1, DENY_CREDENTIAL, 1) == DENY;
    assert gate(1, DENY_BROWSER_ACT, 1) == DENY;
    assert gate(1, DENY_SELF_MODIFY, 1) == DENY;
}

test dsh_and_cdp_endpoints_are_loopback_only {
    assert dsh_endpoint_allowed("127.0.0.1", 9, 3081) == true;
    assert dsh_endpoint_allowed("127.0.0.1", 9, 8080) == false;
    assert dsh_endpoint_allowed("api.t27.ai", 9, 3081) == false;
    assert dsh_endpoint_allowed("localhost", 9, 3081) == false;
    assert cdp_origin_allowed("127.0.0.1", 9, 9222) == true;
    assert cdp_origin_allowed("127.0.0.1", 9, 9332) == true;
    assert cdp_origin_allowed("127.0.0.1", 9, 9333) == false;
    assert cdp_origin_allowed("192.168.1.5", 11, 9222) == false;
}

test cdp_observer_contract_is_read_only {
    var i : usize = 0;
    while i < 5 {
        assert OBSERVABLE[i] == true;
        i += 1;
    }
    assert observer_action_reason(ACT_NAVIGATE) == DENY_BROWSER_ACT;
    assert observer_action_reason(ACT_CLICK) == DENY_BROWSER_ACT;
    assert observer_action_reason(ACT_INPUT) == DENY_BROWSER_ACT;
    assert observer_action_reason(ACT_FORM_SUBMIT) == DENY_BROWSER_ACT;
    assert observer_action_reason(ACT_COOKIE_EXPORT) == DENY_CREDENTIAL;
    assert observer_action_reason(ACT_STORAGE_EXPORT) == DENY_CREDENTIAL;
    assert observer_action_reason(0) == DENY_UNKNOWN;
    assert observer_action_reason(OP_OBSERVE) == DENY_UNKNOWN;
}

test audit_event_has_seven_fields_and_no_secret_bytes {
    var out : [256]u8 = undefined;
    const n : usize = audit_encode(&out, 256,
        1762798000, "queen", 5, "cdp.observe", 11, "9222", 4,
        ALLOW, 0, request_hash("GET /json/list", 14));
    assert field_count(&out, n) == FIELD_COUNT;
    assert out[n - 1] == 10;
    var i : usize = 0;
    var leaked : bool = false;
    while i < n {
        if out[i] == 103 and out[i + 1] == 104 and out[i + 2] == 111 and out[i + 3] == 95 {
            leaked = true;
        }
        i += 1;
    }
    assert leaked == false;
}
; ---- V2 (ORDER: DSH_MCP_GATEWAY_T27_NATIVE_V2): the gateway LAW grows to
; cover the whole MCP surface. Method dispatch, per-tool scope validation,
; JSON-RPC error codes and the response decision envelope live HERE, in
; .t27; the host adapter (cli/tri-mcp) only frames stdin/stdout and calls the
; generated functions. It cannot decide anything: every branch it may take is
; one of the verdicts below.

; -- MCP method dispatch. Codes: 0 initialize, 1 tools/list, 2 tools/call,
; 3 notifications (skip, no response), 4 unknown (DENY -32601).
pub const METHOD_UNKNOWN : u8 = 4;
pub const MCP_INIT : u8 = 0;
pub const MCP_LIST : u8 = 1;
pub const MCP_CALL : u8 = 2;
pub const MCP_NOTIFY : u8 = 3;
pub const ERR_METHOD_NOT_FOUND : i64 = -32601;
pub const ERR_INVALID_PARAMS : i64 = -32602;
pub const ERR_POLICY_DENY : i64 = -32603;

pub fn mcp_dispatch(method : str, mlen : usize) -> u8 {
    if starts_with(method, mlen, "initialize", 10) and mlen == 10 {
        return MCP_INIT;
    }
    if starts_with(method, mlen, "tools/list", 10) and mlen == 10 {
        return MCP_LIST;
    }
    if starts_with(method, mlen, "tools/call", 10) and mlen == 10 {
        return MCP_CALL;
    }
    if starts_with(method, mlen, "notifications/", 14) {
        return MCP_NOTIFY;
    }
    return METHOD_UNKNOWN;
}

; -- per-tool scope validation: the only endpoint a tool may touch.
; gateway.status scopes to loopback itself; dsh.status to the measured DSH
; port; cdp.observe to the dedicated observer profile range.
pub fn scope_allowed(tool_idx : usize, host : str, hlen : usize, port : u16) -> bool {
    if tool_idx >= TOOL_COUNT {
        return false;
    }
    if tool_idx == 0 or tool_idx >= 3 {
        return dsh_endpoint_allowed(host, hlen, port) or cdp_origin_allowed(host, hlen, port);
    }
    if tool_idx == 1 {
        return dsh_endpoint_allowed(host, hlen, port);
    }
    return cdp_origin_allowed(host, hlen, port);
}

; -- the one decision entry point the host is allowed to call: method, tool,
; scope, request count in. Decision, reason and request hash out (via the
; caller, which audits with audit_encode). Everything else is framing.
pub fn gateway_gate(method_code : u8, tool_idx : usize,
                    host : str, hlen : usize, port : u16,
                    count : u32) -> u8 {
    if method_code == METHOD_UNKNOWN {
        return DENY;
    }
    if method_code == MCP_NOTIFY {
        return DENY;
    }
    if method_code == MCP_LIST or method_code == MCP_INIT {
        return ALLOW;
    }
    if tool_idx >= TOOL_COUNT {
        return DENY;
    }
    if scope_allowed(tool_idx, host, hlen, port) == false {
        return DENY;
    }
    return gate(tool_idx, OP_STATUS, count);
}

; -- response decision envelope: the host wraps it in JSON-RPC framing
; (transport is the host's only job). Fixed shape:
; {"decision":<code>,"reason":<code>,"request_hash":<hash>}
pub fn response_decision(out : []u8, cap : usize, decision : u8, reason : u8,
                         req_hash : u64) -> usize {
    var w : usize = 0;
    w = put_lit(out, cap, w, "{\"decision\":", 12);
    w = put_u64(out, cap, w, decision as u64);
    w = put_lit(out, cap, w, ",\"reason\":", 10);
    w = put_u64(out, cap, w, reason as u64);
    w = put_lit(out, cap, w, ",\"request_hash\":", 16);
    w = put_u64(out, cap, w, req_hash);
    w = put_lit(out, cap, w, "}", 1);
    return w;
}

; -- tests (V2)

/// V12: static observation payloads, emitted BY THE LAW so the host frames
/// instead of deciding. Dynamic parts (counters, probe, audit tail) are
/// appended by the adapter around these skeletons.
pub fn observation_response(tool_idx : usize, out : []u8, cap : usize) -> usize {
    var w : usize = 0;
    w = put_lit(out, cap, w, "{\"policy\":", 10);
    w = put_u64(out, cap, w, POLICY_VERSION as u64);
    w = put_lit(out, cap, w, ",\"tools\":", 9);
    w = put_u64(out, cap, w, TOOL_COUNT as u64);
    w = put_lit(out, cap, w, ",\"observation_only\":true,\"routes\":{\"dsh\":\"127.0.0.1:3081\",\"cdp\":\"127.0.0.1:9222..9332\"}}", 88);
    return w;
}

test mcp_dispatch_routes_the_three_methods_and_denies_unknown {
    assert mcp_dispatch("initialize", 10) == MCP_INIT;
    assert mcp_dispatch("tools/list", 10) == MCP_LIST;
    assert mcp_dispatch("tools/call", 10) == MCP_CALL;
    assert mcp_dispatch("notifications/exit", 17) == MCP_NOTIFY;
    assert mcp_dispatch("resources/list", 14) == METHOD_UNKNOWN;
    assert mcp_dispatch("tools/callx", 11) == METHOD_UNKNOWN;
    assert mcp_dispatch("", 0) == METHOD_UNKNOWN;
}

test scope_is_loopback_only_per_tool {
    assert scope_allowed(0, "127.0.0.1", 9, 3081) == true;
    assert scope_allowed(1, "127.0.0.1", 9, 3081) == true;
    assert scope_allowed(1, "127.0.0.1", 9, 9222) == false;
    assert scope_allowed(2, "127.0.0.1", 9, 9222) == true;
    assert scope_allowed(2, "127.0.0.1", 9, 3081) == false;
    assert scope_allowed(3, "127.0.0.1", 9, 9222) == true;
    assert scope_allowed(TOOL_COUNT, "127.0.0.1", 9, 9222) == false;
    assert scope_allowed(0, "10.0.0.5", 8, 3081) == false;
}

test gateway_gate_decides_everything_from_the_tables {
    assert gateway_gate(MCP_LIST, 0, "127.0.0.1", 9, 3081, 1) == ALLOW;
    assert gateway_gate(MCP_INIT, 0, "127.0.0.1", 9, 3081, 1) == ALLOW;
    assert gateway_gate(METHOD_UNKNOWN, 0, "127.0.0.1", 9, 3081, 1) == DENY;
    assert gateway_gate(MCP_NOTIFY, 0, "127.0.0.1", 9, 3081, 1) == DENY;
    assert gateway_gate(MCP_CALL, 1, "127.0.0.1", 9, 3081, 1) == ALLOW;
    assert gateway_gate(MCP_CALL, 1, "10.0.0.5", 8, 3081, 1) == DENY;
    assert gateway_gate(MCP_CALL, 2, "127.0.0.1", 9, 9222, RATE_MAX) == ALLOW;
    assert gateway_gate(MCP_CALL, 2, "127.0.0.1", 9, 9222, RATE_MAX + 1) == DENY_RATE;
    assert gateway_gate(MCP_CALL, 9, "127.0.0.1", 9, 9222, 1) == ALLOW;
    assert gateway_gate(MCP_CALL, TOOL_COUNT, "127.0.0.1", 9, 9222, 1) == DENY;
}

test response_envelope_is_exact_and_carry_only_codes {
    var out : [128]u8 = undefined;
    const n : usize = response_decision(&out, 128, ALLOW, 0, request_hash("x", 1));
    assert n == 51;
    assert out[0] == 123 and out[n - 1] == 125;
    var i : usize = 0;
    var letters : usize = 0;
    while i < n {
        if out[i] >= 97 and out[i] <= 122 {
            letters += 1;
        }
        i += 1;
    }
    assert letters > 20;
}

}


; ---- V12 introspection tools (ORDER: GATEWAY_PLUGIN_ENHANCE_V12) ----

test v12_introspection_tools_are_discoverable_and_scoped {
    assert tool_index("gateway.metrics", 15) == 3;
    assert tool_index("gateway.health", 14) == 4;
    assert tool_index("gateway.policy.audit", 20) == 5;
    assert tool_index("gateway.config.get", 16) == 6;
    assert tool_index("gateway.routes.list", 17) == 7;
    assert tool_index("gateway.version", 15) == 8;
    assert tool_index("gateway.logs.head", 16) == 9;
    assert gate(3, OP_STATUS, 1) == ALLOW;
    assert gate(9, OP_STATUS, 1) == ALLOW;
    assert scope_allowed(3, "127.0.0.1", 9, 3081) == true;
    assert scope_allowed(5, "evil.example", 12, 3081) == false;
    assert gate(3, OP_STATUS, RATE_MAX + 1) == DENY_RATE;
}

test observation_payload_is_static_law_output {
    var out : [256]u8 = undefined;
    const n : usize = observation_response(6, &out, 256);
    assert n == 110;
    assert out[0] == 123 and out[n - 1] == 125;
    var i : usize = 0;
    var oo : bool = false;
    while (i + 17 <= n) {
        if (out[i] == 111 and out[i+1] == 98 and out[i+2] == 115 and out[i+3] == 101 and out[i+4] == 114 and out[i+5] == 118 and out[i+6] == 97 and out[i+7] == 116 and out[i+8] == 105 and out[i+9] == 111 and out[i+10] == 110 and out[i+11] == 95 and out[i+12] == 111 and out[i+13] == 110 and out[i+14] == 108 and out[i+15] == 121) {
            oo = true;
        }
        i += 1;
    }
    assert oo;
}
