// SPDX-License-Identifier: Apache-2.0
; mcp/gateway/log_contract.t27 -- the unified log-event law of the T27
; gateway observability layer (ORDER: T27_LOG_OBSERVABILITY_V1, EPIC 1,
; variant A). Everything the gateway may record, redact, accept and keep
; about a log event is decided HERE; the adapter only frames.
; Event schema (11 fields, tab-free JSON in flight):
;   timestamp (epoch seconds), host, source, component, level (0..3),
;   trace_id, request_id, status, duration_ms, message,
;   redacted-metadata (keys only; values never carried).
; Redaction is MANDATORY and mechanical: any ingestion line containing one
; of the REDACT patterns has the match replaced by the literal [REDACTED]
; before it can become an event. Redaction can never be disabled by the
; caller; there is no bypass parameter.
; Sources and hosts are allowlists: an event whose source or host is not in
; its table is refused at ingestion, fail-closed. Levels outside 0..3 are
; refused. Retention bounds each source to RETENTION_MAX_LINES events; the
; ingest rate bound is RATE_MAX_PER_MIN events per source per minute.
; Capabilities this law grants: NONE beyond reading the gateway's own audit
; artefact. No process spawn, no file write, no credential access, no
; browser mutation, no policy self-modification is expressible here -- the
; capability denials live in mcp/gateway/policy.t27 and are not re-listed.
; DRY note: the byte helpers below mirror the ones in policy.t27 because
; t27c 0.5.2 cross-module import is broken in this checkout (ledger
; addendum 16, #5980/#11777); when import resolves, replace them with
; imports from the gateway package. ASCII only (L3); tests prove the law
; (L4); gen-c string traps respected (explicit lengths, no .len, no == on
; str, no NUL assumptions). phi^2 + 1/phi^2 = 3 | TRINITY

module McpGatewayLogContract;

pub const CONTRACT_VERSION : u8 = 1;

; -- levels
pub const LEVEL_DEBUG : u8 = 0;
pub const LEVEL_INFO : u8 = 1;
pub const LEVEL_WARN : u8 = 2;
pub const LEVEL_ERROR : u8 = 3;
pub const LEVEL_MAX_VALID : u8 = 3;

; -- sources (allowlist; anything else is refused at ingestion)
pub const SOURCE_COUNT : usize = 6;
pub const SOURCES : [6]str = ["gateway-audit", "dsh-web", "dsh-ladder", "caddy", "tri-mcp", "agent-runs"];
pub const SOURCE_LENS : [6]usize = [13, 7, 10, 5, 7, 10];

; -- hosts (explicit labels; local and VPS never merge)
pub const HOST_COUNT : usize = 2;
pub const HOSTS : [2]str = ["local", "vps"];
pub const HOST_LENS : [2]usize = [5, 3];

; -- bounds
pub const RETENTION_MAX_LINES : u32 = 4096;
pub const RATE_MAX_PER_MIN : u32 = 100;

; -- redaction patterns: any occurrence is replaced by [REDACTED].
pub const REDACT_MARK : str = "[REDACTED]";
pub const REDACT_MARK_LEN : usize = 10;
pub const PATTERN_MAX : usize = 14;
pub const PATTERN_COUNT : usize = 7;
pub const PATTERNS : [98]u8 = [
    'p','a','s','s','w','o','r','d','=','_','_','_','_','_',
    't','o','k','e','n','=','_','_','_','_','_','_','_','_',
    'B','e','a','r','e','r',' ','_','_','_','_','_','_','_',
    's','k','-','_','_','_','_','_','_','_','_','_','_','_',
    'g','h','p','_','_','_','_','_','_','_','_','_','_','_',
    'g','h','o','_','_','_','_','_','_','_','_','_','_','_',
    'A','u','t','h','o','r','i','z','a','t','i','o','n',':'
];
pub const PATTERN_LENS : [7]usize = [9, 6, 7, 3, 4, 4, 14];

; -- byte helpers ---------------------------------------------------------
pub fn pattern_byte(row : usize, k : usize) -> u8 {
    return PATTERNS[row * PATTERN_MAX + k];
}

pub fn put_lit(out : []u8, cap : usize, w : usize, s : str, slen : usize) -> usize {
    var k : usize = 0;
    while (k < slen) {
        if (w + k < cap) { out[w + k] = s[k]; }
        k += 1;
    }
    return w + slen;
}

pub fn put_u64(out : []u8, cap : usize, w : usize, v_in : u64) -> usize {
    var v : u64 = v_in;
    if (v == 0) {
        if (w < cap) { out[w] = '0'; }
        return w + 1;
    }
    var buf : [20]u8 = undefined;
    var n : usize = 0;
    while (v > 0) {
        buf[n] = ('0' as u8) + (v % 10) as u8;
        n += 1;
        v = v / 10;
    }
    var k : usize = 0;
    while (k < n) {
        if (w + k < cap) { out[w + k] = buf[n - 1 - k]; }
        k += 1;
    }
    return w + n;
}

pub fn starts_with(s : []u8, slen : usize, p : str, plen : usize) -> bool {
    if (slen < plen) { return false; }
    var i : usize = 0;
    while (i < plen) {
        if (s[i] != p[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn contains_bytes(s : []u8, slen : usize, p : str, plen : usize) -> bool {
    if (slen < plen) { return false; }
    var i : usize = 0;
    while (i + plen <= slen) {
        var j : usize = 0;
        var hit : bool = true;
        while (j < plen) {
            if (s[i + j] != p[j]) { hit = false; }
            j += 1;
        }
        if (hit) { return true; }
        i += 1;
    }
    return false;
}

; -- allowlist checks -----------------------------------------------------
pub fn source_allowed(source : []u8, slen : usize) -> bool {
    var i : usize = 0;
    while (i < SOURCE_COUNT) {
        if (slen == SOURCE_LENS[i]) {
            var j : usize = 0;
            var ok : bool = true;
            while (j < slen) {
                if (source[j] != SOURCES[i][j]) { ok = false; }
                j += 1;
            }
            if (ok) { return true; }
        }
        i += 1;
    }
    return false;
}

pub fn host_allowed(host : []u8, hlen : usize) -> bool {
    var i : usize = 0;
    while (i < HOST_COUNT) {
        if (hlen == HOST_LENS[i]) {
            var j : usize = 0;
            var ok : bool = true;
            while (j < hlen) {
                if (host[j] != HOSTS[i][j]) { ok = false; }
                j += 1;
            }
            if (ok) { return true; }
        }
        i += 1;
    }
    return false;
}

pub fn level_valid(level : u8) -> bool {
    return level <= LEVEL_MAX_VALID;
}

pub fn rate_allows(count_in_window : u32) -> bool {
    return count_in_window <= RATE_MAX_PER_MIN;
}

pub fn retention_allows(lines_stored : u32) -> bool {
    return lines_stored <= RETENTION_MAX_LINES;
}

; -- REDACTION (mandatory, no bypass) -------------------------------------
; Copy s[0..slen] into out, replacing every redact-pattern occurrence with
/// the [REDACTED] mark. Returns the produced length (always <= slen is NOT
/// guaranteed for escaped marks longer than the match; cap guards writes).
pub fn redact_line(s : []u8, slen : usize, out : []u8, cap : usize) -> usize {
    var w : usize = 0;
    var i : usize = 0;
    while (i < slen) {
        var m : usize = 0;
        var k : usize = 0;
        while (k < PATTERN_COUNT and m == 0) {
            const pl : usize = PATTERN_LENS[k];
            if (i + pl <= slen) {
                var j : usize = 0;
                var ok : bool = true;
                while (j < pl) {
                    if (s[i + j] != pattern_byte(k, j)) { ok = false; }
                    j += 1;
                }
                if (ok) { m = pl; }
            }
            k += 1;
        }
        if (m > 0) {
            w = put_lit(out, cap, w, REDACT_MARK, REDACT_MARK_LEN);
            i += m;
            // consume the VALUE run too: the marker alone would leave the
            // secret visible (measured defect, EPIC 1 contract test).
            while (i < slen and s[i] != 32 and s[i] != 9) { i += 1; }
        } else {
            if (w < cap) { out[w] = s[i]; }
            w += 1;
            i += 1;
        }
    }
    return w;
}

; -- audit-line parse: one gateway audit record (7 tab fields) becomes an
; event JSON object with the schema's field names. Fewer than 7 fields is
; a malformed line: this law answers 0 (no event) for it, fail-closed.
pub fn audit_line_to_event(line : []u8, llen : usize, out : []u8, cap : usize) -> usize {
    var f : [7]usize = undefined;
    var fl : [7]usize = undefined;
    var nf : usize = 0;
    var s : usize = 0;
    while (s < llen and nf < 7) {
        var e : usize = s;
        while (e < llen and line[e] != 9) { e += 1; }
        f[nf] = s;
        fl[nf] = e - s;
        nf += 1;
        s = e + 1;
    }
    if (nf < 7) { return 0; }
    var w : usize = 0;
    w = put_lit(out, cap, w, "{\"timestamp\":", 13);
    w = put_u64(out, cap, w, digits_to_u64(line, f[0], fl[0]));
    w = put_lit(out, cap, w, ",\"component\":\"", 14);
    w = put_span(out, cap, w, line, f[1], fl[1]);
    w = put_lit(out, cap, w, "\",\"tool\":\"", 10);
    w = put_span(out, cap, w, line, f[2], fl[2]);
    w = put_lit(out, cap, w, "\",\"scope\":\"", 11);
    w = put_span(out, cap, w, line, f[3], fl[3]);
    w = put_lit(out, cap, w, "\",\"status\":", 11);
    w = put_span(out, cap, w, line, f[4], fl[4]);
    w = put_lit(out, cap, w, ",\"reason\":", 10);
    w = put_span(out, cap, w, line, f[5], fl[5]);
    w = put_lit(out, cap, w, ",\"request_hash\":", 16);
    w = put_span(out, cap, w, line, f[6], fl[6]);
    w = put_lit(out, cap, w, "}", 1);
    return w;
}

fn put_span(out : []u8, cap : usize, w : usize, s : []u8, from : usize, len : usize) -> usize {
    var k : usize = 0;
    while (k < len) {
        if (w + k < cap) { out[w + k] = s[from + k]; }
        k += 1;
    }
    return w + len;
}

fn digits_to_u64(s : []u8, from : usize, len : usize) -> u64 {
    var v : u64 = 0;
    var i : usize = 0;
    while (i < len) {
        v = v * 10 + (s[from + i] - '0') as u64;
        i += 1;
    }
    return v;
}

; ---- contract tests (EPIC 1 acceptance) ----

test redaction_replaces_token_and_bearer {
    var out : [256]u8 = undefined;
    var inp : [40]u8 = undefined;
    const raw : str = "user token=abc123 via Bearer eyJa spa";
    var i : usize = 0;
    while (i < 37) { inp[i] = raw[i]; i += 1; }
    const n : usize = redact_line(&inp, 37, &out, 256);
    assert contains_bytes(&out, n, REDACT_MARK, REDACT_MARK_LEN);
    assert contains_bytes(&out, n, "abc123", 6) == false;
    assert contains_bytes(&out, n, "eyJa", 4) == false;
}

test redaction_passes_clean_text_unchanged {
    var out : [256]u8 = undefined;
    var inp : [40]u8 = undefined;
    const raw : str = "gateway.status answered in 12ms";
    var i : usize = 0;
    while (i < 31) { inp[i] = raw[i]; i += 1; }
    const n : usize = redact_line(&inp, 31, &out, 256);
    assert n == 31;
    assert contains_bytes(&out, n, "gateway.status answered in 12ms", 31);
}

test source_allowlist_holds_fail_closed {
    var g : [16]u8 = undefined;
    var r : [8]u8 = undefined;
    var x : [8]u8 = undefined;
    var i : usize = 0;
    while (i < 13) { g[i] = "gateway-audit"[i]; i += 1; }
    i = 0;
    while (i < 3) { r[i] = "vps"[i]; i += 1; }
    i = 0;
    while (i < 6) { x[i] = "random"[i]; i += 1; }
    assert source_allowed(&g, 13) == true;
    assert source_allowed(&r, 3) == false;
    assert source_allowed(&x, 6) == false;
}

test host_allowlist_and_level_bounds {
    var l : [6]u8 = undefined;
    var i : usize = 0;
    while (i < 5) { l[i] = "local"[i]; i += 1; }
    assert host_allowed(&l, 5) == true;
    var v : [4]u8 = undefined;
    i = 0;
    while (i < 3) { v[i] = "vps"[i]; i += 1; }
    assert host_allowed(&v, 3) == true;
    var z : [8]u8 = undefined;
    i = 0;
    while (i < 8) { z[i] = "unknownh"[i]; i += 1; }
    assert host_allowed(&z, 8) == false;
    assert level_valid(LEVEL_DEBUG) and level_valid(LEVEL_ERROR);
    assert level_valid(4) == false;
}

test retention_and_rate_bounds_are_pinned {
    assert RETENTION_MAX_LINES == 4096;
    assert RATE_MAX_PER_MIN == 100;
    assert retention_allows(RETENTION_MAX_LINES);
    assert retention_allows(RETENTION_MAX_LINES + 1) == false;
    assert rate_allows(RATE_MAX_PER_MIN);
    assert rate_allows(RATE_MAX_PER_MIN + 1) == false;
}

test audit_line_parse_produces_schema_event {
    var out : [512]u8 = undefined;
    var line : [80]u8 = undefined;
    const raw : str = "1794336737\tdsh-session\tdsh.status\t10.9.9.9:3081\t1\t0\t3132692428";
    var i : usize = 0;
    while (i < 62) { line[i] = raw[i]; i += 1; }
    const n : usize = audit_line_to_event(&line, 62, &out, 512);
    assert n > 60;
    assert contains_bytes(&out, n, "\"timestamp\":1794336737", 22);
    assert contains_bytes(&out, n, "\"tool\":\"dsh.status\"", 19);
    assert contains_bytes(&out, n, "\"status\":1", 10);
}

test malformed_audit_line_fails_closed {
    var out : [256]u8 = undefined;
    var line : [16]u8 = undefined;
    var i : usize = 0;
    while (i < 16) { line[i] = "no-tabs-here----"[i]; i += 1; }
    assert audit_line_to_event(&line, 16, &out, 256) == 0;
}
