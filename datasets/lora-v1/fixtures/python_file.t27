#!/usr/bin/env python3
"""A small but real Python module: an LRU cache and a tokenizer."""

import re
import json
from collections import OrderedDict
from dataclasses import dataclass, field
from typing import Iterator, Optional


TOKEN_RE = re.compile(r"[A-Za-z_][A-Za-z_0-9]*|\d+|\S")


@dataclass
class Token:
    kind: str
    text: str
    pos: int = 0
    meta: dict = field(default_factory=dict)

    def is_ident(self) -> bool:
        return self.kind == "ident"


class LRUCache:
    def __init__(self, capacity: int = 128):
        if capacity <= 0:
            raise ValueError("capacity must be positive")
        self.capacity = capacity
        self._data: "OrderedDict[str, object]" = OrderedDict()
        self.hits = 0
        self.misses = 0

    def get(self, key: str, default=None):
        if key in self._data:
            self._data.move_to_end(key)
            self.hits += 1
            return self._data[key]
        self.misses += 1
        return default

    def put(self, key: str, value) -> None:
        if key in self._data:
            self._data.move_to_end(key)
        self._data[key] = value
        while len(self._data) > self.capacity:
            self._data.popitem(last=False)

    def stats(self) -> dict:
        total = self.hits + self.misses
        return {
            "hits": self.hits,
            "misses": self.misses,
            "ratio": (self.hits / total) if total else 0.0,
        }


def classify(text: str) -> str:
    if text.isdigit():
        return "number"
    if text[0].isalpha() or text[0] == "_":
        return "ident"
    return "punct"


def tokenize(source: str) -> Iterator[Token]:
    for m in TOKEN_RE.finditer(source):
        yield Token(kind=classify(m.group(0)), text=m.group(0), pos=m.start())


def main(argv: Optional[list] = None) -> int:
    src = "x = foo(12) + bar_baz * 3"
    toks = list(tokenize(src))
    cache = LRUCache(4)
    for t in toks:
        cache.put(t.text, t.pos)
    print(json.dumps({"tokens": len(toks), "cache": cache.stats()}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
