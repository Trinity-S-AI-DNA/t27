{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "T27",
  "scopeName": "source.t27",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#members" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.t27",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments-block-nested" }]
        },
        {
          "name": "comment.line.documentation.t27",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.t27",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.t27",
          "match": "#.*$"
        },
        {
          "name": "comment.line.semicolon.t27",
          "match": "^;[ \\t].*$"
        }
      ]
    },
    "comments-block-nested": {
      "name": "comment.block.t27",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#comments-block-nested" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.t27",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.t27",
          "begin": "'",
          "end": "'|$",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.t27",
      "match": "\\\\(?:x[0-9a-fA-F]{2}|.)"
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.modifier.annotation.t27",
          "match": "@extern\\b"
        },
        {
          "name": "support.function.builtin.t27",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.module.t27" },
            "2": { "name": "entity.name.namespace.t27" }
          }
        },
        {
          "match": "\\b(use|using)\\s+([A-Za-z_][A-Za-z0-9_:.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.t27" },
            "2": { "name": "entity.name.namespace.t27" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.t27" },
            "2": { "name": "entity.name.function.t27" }
          }
        },
        {
          "match": "\\b(struct|enum|union|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.t27" },
            "2": { "name": "entity.name.type.t27" }
          }
        },
        {
          "match": "\\b(test|invariant|bench)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.test.t27" },
            "2": { "name": "entity.name.function.test.t27" }
          }
        },
        {
          "match": "\\b(const|let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.const.t27" },
            "2": { "name": "variable.other.constant.t27" }
          }
        },
        {
          "match": "\\b(var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.var.t27" },
            "2": { "name": "variable.other.readwrite.t27" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.t27",
          "match": "\\b(if|else|for|while|switch|return|try|break|continue|in)\\b"
        },
        {
          "name": "keyword.operator.word.t27",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "storage.modifier.t27",
          "match": "\\b(pub|extern)\\b"
        },
        {
          "name": "keyword.declaration.t27",
          "match": "\\b(module|fn|struct|enum|union|type|const|let|var|test|invariant|bench|use|using|pragma)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.t27",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.t27",
          "match": "\\b(null|undefined)\\b"
        },
        {
          "name": "constant.other.t27",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.t27",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.t27",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.t27",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.t27",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?(?:f16|f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.float.t27",
          "match": "\\b\\d[\\d_]*[eE][+-]?\\d+(?:f16|f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.t27",
          "match": "\\b\\d[\\d_]*(?:[iu](?:8|16|32|64|128|size)|f16|f32|f64)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.t27",
          "match": "\\b(?:[iuIU](?:8|16|32|64|128)|usize|isize|[fF](?:16|32|64|128)|bool|Bool|str|String|char|void|Trit)\\b"
        },
        {
          "name": "entity.name.type.t27",
          "match": "\\b[A-Z][A-Za-z0-9]*[a-z][A-Za-z0-9]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.t27",
          "match": "\\bassert[A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.t27",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(?<=[\\w)\\]])(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.t27" },
            "2": { "name": "entity.name.function.call.t27" }
          }
        },
        {
          "match": "(?<=[\\w)\\]])(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.t27" },
            "2": { "name": "variable.other.property.t27" }
          }
        },
        {
          "name": "constant.other.enum-member.t27",
          "match": "(?<![\\w)\\]\"'.])\\.[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.t27",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.t27",
          "match": "\\*\\*|<<=?|>>=?|<=|>=|==|!=|\\+\\+|\\+=|-=|\\*=|/=|%=|&&|\\|\\||\\.\\.\\.?|[-+*/%=<>!&|^~?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.t27",
          "match": ";"
        },
        {
          "name": "punctuation.separator.t27",
          "match": ",|::|:"
        }
      ]
    }
  }
}
