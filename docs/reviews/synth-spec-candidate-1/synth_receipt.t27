module SynthReceipt;
// Contract for the `tri fpga synth-spec` build receipt (owner direction
// 2026-11-02, section 3). Purpose: pin the field names and the admission
// rules BEFORE the host glue in cli/tri/src/fpga.rs is written, so the
// receipt cannot silently copy the existing conflation of seal identity
// with the Verilog input hash (bootstrap/src/service.rs:3809 identifies a
// seal by gen_hash_verilog equality -- that shortcut is forbidden here).
//
// Field model (names align with existing types in .trinity/seals/*.json and
// bootstrap/src/main.rs compute_seal_hashes):
//   source:          path, source_sha256            (sha256 of the .t27 text)
//   seal:            spec_hash, gen_hash_zig, gen_hash_verilog, gen_hash_c,
//                    gen_hash_rust, seal_check_status, sealed_by
//   verilog:         seal_gen_hash_verilog  (hash the seal recorded),
//                    input_verilog_sha256   (hash of the exact bytes fed to yosys),
//                    verilog_match          (u8 code, see below)
//   recipe:          part, package, seed, tool_versions, constraint_paths,
//                    cache_key              (reuse service.rs bitstream cache key
//                                            only after its input digest set is audited)
//   stages:          one record per stage: status(u8), exit_code, duration_ms,
//                    log_path, output_artifact_sha256
//
// Status codes (u8, string rendering is a presentation concern):
//   verilog_match: 0 = none (no comparison possible), 1 = match,
//                  2 = mismatch (build must refuse), 3 = seal_absent
//   seal_check_status: 0 = unverified, 1 = verified_current,
//                  2 = stale_drift, 3 = typecheck_refusal
//   stage status: 0 = not_run, 1 = ok, 2 = failed
//
// Outcome (owner direction 2026-11-02, turn after the stub tests): the
// receipt separates ADMISSION from BUILD RESULT. `admitted` means only
// "inputs/seal/hashes passed and downstream tools were allowed to start";
// the final verdict lives in `outcome`:
//   0 = admission_rejected   (admitted = false)
//   1 = stage_failed         (admitted = true, failed_stage names the stage)
//   2 = bitstream_produced   (admitted = true, fresh non-empty .bit this run)
// `hardware_verified` is a separate receipt field and is ALWAYS false in
// this command: DONE=HIGH or a .bit never proves board functionality.
//
// Two hard rules, both invariant-enforced:
//   R1 "none is a refusal": gen_hash_verilog == "none" (typecheck refusal)
//      means NO build and NO receipt-with-success -- it is a failure state,
//      not a valid identity value.
//   R2 "match is not proof": verilog_match == 1 only asserts that the bytes
//      entering yosys are the ones the seal certified. It does NOT assert
//      functional equivalence of the resulting bitstream and never may be
//      reported as such.

pub fn verilog_match_of(gen_hash_none: u8, seal_present: u8, hash_equal: u8) -> u8 {
    if (gen_hash_none == 1) { return 0; }
    if (seal_present == 0) { return 3; }
    if (hash_equal == 1) { return 1; }
    return 2;
}

pub fn build_admitted(gen_hash_none: u8, verilog_match: u8, stage_synth: u8) -> u8 {
    // R1: a typecheck refusal (gen_hash_verilog == "none") refuses the build.
    if (gen_hash_none == 1) { return 0; }
    // A mismatch between the sealed Verilog hash and the actual input bytes
    // refuses the build; the operator re-seals explicitly.
    if (verilog_match == 2) { return 0; }
    if (verilog_match == 3) { return 0; }
    // The synthesis stage itself failed.
    if (stage_synth == 2) { return 0; }
    return 1;
}

// R2 as data: a successful build may only be described as bitstream_produced,
// never as functionality_proven.
pub fn proven_claim(verilog_match: u8, stage_frames_bit: u8, functionality_check_run: u8) -> u8 {
    if (verilog_match == 1) {
        if (stage_frames_bit == 1) {
            if (functionality_check_run == 1) { return 2; } // behavior checked on target
            return 1;                                       // bitstream_produced only
        }
    }
    return 0;
}

// Outcome codes (receipt "outcome" field; see the header table above).
pub const OUTCOME_ADMISSION_REJECTED : u8 = 0;
pub const OUTCOME_STAGE_FAILED : u8 = 1;
pub const OUTCOME_BITSTREAM_PRODUCED : u8 = 2;

// The single place that maps admission + build result to the receipt's
// outcome verdict. Admission and build success are DIFFERENT facts.
pub fn build_outcome(admission_ok: u8, any_stage_failed: u8, bit_ok: u8) -> u8 {
    if (admission_ok == 0) { return OUTCOME_ADMISSION_REJECTED; }
    if (any_stage_failed == 1) { return OUTCOME_STAGE_FAILED; }
    if (bit_ok == 1) { return OUTCOME_BITSTREAM_PRODUCED; }
    return OUTCOME_STAGE_FAILED;
}

test r1_none_refuses {
    assert_eq(verilog_match_of(1, 1, 1), 0);
    assert_eq(build_admitted(1, 0, 1), 0);
}

test r2_match_is_not_proof {
    // bitstream built, no functionality check => claim stays "produced" (1)
    assert_eq(proven_claim(1, 1, 0), 1);
    // functionality actually checked => 2
    assert_eq(proven_claim(1, 1, 1), 2);
    // no bitstream => 0
    assert_eq(proven_claim(1, 0, 1), 0);
}

test match_codes {
    assert_eq(verilog_match_of(0, 1, 1), 1);
    assert_eq(verilog_match_of(0, 1, 0), 2);
    assert_eq(verilog_match_of(0, 0, 0), 3);
    assert_eq(build_admitted(0, 2, 1), 0);
    assert_eq(build_admitted(0, 1, 1), 1);
    assert_eq(build_admitted(0, 1, 2), 0);
}

invariant mismatch_never_admitted {
    assert build_admitted(0, 2, 1) == 0;
}

test outcome_semantics {
    // Admission rejected: outcome 0 regardless of anything else.
    assert_eq(build_outcome(0, 0, 0), OUTCOME_ADMISSION_REJECTED);
    assert_eq(build_outcome(0, 1, 1), OUTCOME_ADMISSION_REJECTED);
    // Admission passed, a stage failed: outcome stage_failed.
    assert_eq(build_outcome(1, 1, 0), OUTCOME_STAGE_FAILED);
    // Admission passed, all stages ok, fresh .bit: produced.
    assert_eq(build_outcome(1, 0, 1), OUTCOME_BITSTREAM_PRODUCED);
}

invariant admitted_does_not_imply_produced {
    // A yosys failure with admission passed must never claim produced.
    assert build_outcome(1, 1, 0) == OUTCOME_STAGE_FAILED;
}
endmodule
