--- a/server.mjs
+++ b/server.mjs
@@ (imports, top)
+import { spawnFileSync } from './browser-read.mjs';
@@ (tools array; one new entry, ~35 lines; validation: url must be https:// and end as given;
+    deadline: 15 s kill; stdout parsed as the browser_read contract JSON; refusal codes passed
+    through; no shell: child_process.spawnFile with args = [], parameters via env only)
+  {
+    name: 't27_browser_read',
+    description:
+      'Bounded read-only page text through the local CDP reader (existing tab only, no tab ' +
+      'creation/closing/navigation, no caller JavaScript). Returns the structured reader ' +
+      'contract: source_len_chars, decoded_bytes, page_chars, limits, truncated, text, refusal.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        url: { type: 'string', description: 'Exact page URL, e.g. https://t27.ai/#/' },
+        page_chars: { type: 'number', description: '1..=4000, default 4000' },
+      },
+      required: ['url'],
+    },
+    handler: ({ url, page_chars }) => {
+      if (typeof url !== 'string' || !url.startsWith('https://')) throw new Error('url must be an https:// URL');
+      if (page_chars !== undefined && (!Number.isInteger(page_chars) || page_chars < 1 || page_chars > 4000))
+        throw new Error('page_chars must be an integer in 1..=4000');
+      const env = { ...process.env, BROWSER_READ_URL: url };
+      if (page_chars !== undefined) env.BROWSER_READ_PAGE_CHARS = String(page_chars);
+      const exe = '/Users/playra/t27/target/t27os/browser-read'; // identity: sha256 recorded per run
+      const r = spawnFileSync(exe, [], { env, timeoutMs: 15000, maxStdout: 1 << 20, maxStderr: 1 << 14 });
+      const line = (r.stdout.split('\n').find((l) => l.startsWith('browser_read: ')) || '').slice('browser_read: '.length);
+      let parsed; try { parsed = JSON.parse(line); } catch { throw new Error('reader produced no machine line (exit ' + r.code + ')'); }
+      return { contract: 'browser_read/1', ...parsed, reader_sha256: r.exeSha256 };
+    },
+  },

-- ADAPTER NOTES (approval/policy, per the integrator order) --
- Endpoint scope: hardwired 127.0.0.1:<port>; the port may only point at the local test peer or
  the policy-default neo 9115. No caller-chosen hosts.
- URL scope: https:// only, matched exactly against an existing tab; never opened, closed or navigated.
- spawnFile is NOT an existing Node.js API: use child_process.spawnSync(exe, [], {env, timeout})
  (nodejs.org/api/child_process.html) -- no shell, argv empty, parameters via env only.
- Returned data: the reader contract JSON (request_id, source_len_chars, decoded_bytes, page_chars,
  limits, truncated, text of ONE public page). Nothing else is logged; stderr is capped and discarded.
- Input validation: url https:// + exact match; page_chars integer 1..=4000; anything else -> refusal 8.
- Output/time limits: 15 s child timeout (killed), 1 MiB stdout cap.
- Deny behaviour: reader refusal codes pass through unchanged; no partial text on refusal.
- Approval: this tool follows the host's permission system; no self-granted approval exemption.
