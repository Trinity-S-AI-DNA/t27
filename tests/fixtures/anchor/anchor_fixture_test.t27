// SPDX-License-Identifier: Apache-2.0
; anchor_fixture_test.t27 -- DOCUMENT_INTEGRITY harness (#8603).
; Run by t27b with --fixture DOC=<file>: hashes the PASSED bytes at test time and
; compares against the recorded baseline digest of the live AGENTS.md
; (e9890c28cd4ee7f1eefdbf241101c3dc04370e6edb5cac83a0f748dd5ee8b5b1,
; measured 2026-11-22 via shasum -a 256 AGENTS.md, 54337 bytes).
; Not under specs/: the const names exist only under --fixture, so corpus
; walkers that compile every spec untouched must not see this file.

module AnchorFixtureTest;

use golden_chain::anchor::digest_matches;

pub const AGENTS_MD_BASELINE : [8]u32 = [3918072872, 3444500465, 4009606948, 285328348, 70717038, 3680283779, 2700560605, 1592309169];

test live_document_matches_recorded_baseline {
    assert FIXTURE_DOC_LEN == 54337;
    assert digest_matches(FIXTURE_DOC[0..FIXTURE_DOC_LEN], FIXTURE_DOC_LEN, AGENTS_MD_BASELINE);
}

test mutated_bytes_are_refused {
    // DOC_MUT carries a one-byte mutation of the document; the recorded baseline
    // digest must NOT verify against it.
    assert digest_matches(FIXTURE_DOC_MUT[0..FIXTURE_DOC_MUT_LEN], FIXTURE_DOC_MUT_LEN, AGENTS_MD_BASELINE) == false;
}

test empty_input_is_explicitly_refused {
    // An empty fixture is a refusal, never a pass.
    assert FIXTURE_DOC_EMPTY_LEN == 0;
    assert digest_matches(FIXTURE_DOC_EMPTY[0..1], 0, AGENTS_MD_BASELINE) == false;
}
