    // ---- Helper functions ------------------------------------------------------------
    
    fn is_live_course(number: u8) -> bool {
        if number == 1 || number == 2 || number == 3 || number == 4 || 
           number == 5 || number == 6 || number == 7 || number == 8 || 
           number == 9 {
            return true;
        }
        return false;
    }
    
    fn is_queue_course(number: u8) -> bool {
        if number == 10 || number == 11 || number == 12 || number == 13 {
            return true;
        }
        return false;
    }
    
    fn get_course_id(number: u8) -> str {
        if number == 1 { return COURSE_1_ID; }
        if number == 2 { return COURSE_2_ID; }
        if number == 3 { return COURSE_3_ID; }
        if number == 4 { return COURSE_4_ID; }
        if number == 5 { return COURSE_5_ID; }
        if number == 6 { return COURSE_6_ID; }
        if number == 7 { return COURSE_7_ID; }
        if number == 8 { return COURSE_8_ID; }
        if number == 9 { return COURSE_9_ID; }
        if number == 10 { return COURSE_10_ID; }
        if number == 11 { return COURSE_11_ID; }
        if number == 12 { return COURSE_12_ID; }
        if number == 13 { return COURSE_13_ID; }
        return "";
    }
    
    fn get_course_title_en(number: u8) -> str {
        if number == 1 { return COURSE_1_TITLE_EN; }
        if number == 2 { return COURSE_2_TITLE_EN; }
        if number == 3 { return COURSE_3_TITLE_EN; }
        if number == 4 { return COURSE_4_TITLE_EN; }
        if number == 5 { return COURSE_5_TITLE_EN; }
        if number == 6 { return COURSE_6_TITLE_EN; }
        if number == 7 { return COURSE_7_TITLE_EN; }
        if number == 8 { return COURSE_8_TITLE_EN; }
        if number == 9 { return COURSE_9_TITLE_EN; }
        if number == 10 { return COURSE_10_TITLE_EN; }
        if number == 11 { return COURSE_11_TITLE_EN; }
        if number == 12 { return COURSE_12_TITLE_EN; }
        if number == 13 { return COURSE_13_TITLE_EN; }
        return "";
    }
    
    fn get_course_title_ru(number: u8) -> str {
        if number == 1 { return COURSE_1_TITLE_RU; }
        if number == 2 { return COURSE_2_TITLE_RU; }
        if number == 3 { return COURSE_3_TITLE_RU; }
        if number == 4 { return COURSE_4_TITLE_RU; }
        if number == 5 { return COURSE_5_TITLE_RU; }
        if number == 6 { return COURSE_6_TITLE_RU; }
        if number == 7 { return COURSE_7_TITLE_RU; }
        if number == 8 { return COURSE_8_TITLE_RU; }
        if number == 9 { return COURSE_9_TITLE_RU; }
        if number == 10 { return COURSE_10_TITLE_RU; }
        if number == 11 { return COURSE_11_TITLE_RU; }
        if number == 12 { return COURSE_12_TITLE_RU; }
        if number == 13 { return COURSE_13_TITLE_RU; }
        return "";
    }
    
    fn get_course_spec(number: u8) -> str {
        if number == 1 { return COURSE_1_SPEC; }
        if number == 2 { return COURSE_2_SPEC; }
        if number == 3 { return COURSE_3_SPEC; }
        if number == 4 { return COURSE_4_SPEC; }
        if number == 5 { return COURSE_5_SPEC; }
        if number == 6 { return COURSE_6_SPEC; }
        if number == 7 { return COURSE_7_SPEC; }
        if number == 8 { return COURSE_8_SPEC; }
        if number == 9 { return COURSE_9_SPEC; }
        if number == 10 { return COURSE_10_SPEC; }
        if number == 11 { return COURSE_11_SPEC; }
        if number == 12 { return COURSE_12_SPEC; }
        if number == 13 { return COURSE_13_SPEC; }
        return "";
    }
    
    fn get_course_story(number: u8) -> str {
        if number == 1 { return COURSE_1_STORY; }
        if number == 2 { return COURSE_2_STORY; }
        if number == 3 { return COURSE_3_STORY; }
        if number == 4 { return COURSE_4_STORY; }
        if number == 5 { return COURSE_5_STORY; }
        if number == 6 { return COURSE_6_STORY; }
        if number == 7 { return COURSE_7_STORY; }
        if number == 8 { return COURSE_8_STORY; }
        if number == 9 { return COURSE_9_STORY; }
        if number == 10 { return COURSE_10_STORY; }
        if number == 11 { return COURSE_11_STORY; }
        if number == 12 { return COURSE_12_STORY; }
        if number == 13 { return COURSE_13_STORY; }
        return "";
    }
    
    fn get_course_status(number: u8) -> str {
        if number <= 9 { return STATUS_LIVE; }
        if number >= 10 && number <= 13 { return STATUS_QUEUE; }
        return "";
    }
    
    // ---- Tests ----------------------------------------------------------------------
    
    test "catalog has correct total count" {
        assert(TOTAL_COURSES_COUNT == 13);
    }
    
    test "live courses count matches" {
        assert(LIVE_COURSES_COUNT == 9);
    }
    
    test "queue courses count matches" {
        assert(QUEUE_COURSES_COUNT == 4);
    }
    
    test "live course identification works" {
        assert(is_live_course(1) == true);
        assert(is_live_course(9) == true);
        assert(is_live_course(10) == false);
        assert(is_live_course(13) == false);
        assert(is_live_course(0) == false);
        assert(is_live_course(14) == false);
    }
    
    test "queue course identification works" {
        assert(is_queue_course(10) == true);
        assert(is_queue_course(13) == true);
        assert(is_queue_course(9) == false);
        assert(is_queue_course(14) == false);
        assert(is_queue_course(0) == false);
    }
    
    test "course id retrieval works" {
        assert(get_course_id(1) == COURSE_1_ID);
        assert(get_course_id(8) == COURSE_8_ID);
        assert(get_course_id(13) == COURSE_13_ID);
        assert(get_course_id(0) == "");
        assert(get_course_id(14) == "");
    }
    
    test "course title retrieval works for EN" {
        assert(get_course_title_en(1) == COURSE_1_TITLE_EN);
        assert(get_course_title_en(9) == COURSE_9_TITLE_EN);
        assert(get_course_title_en(13) == COURSE_13_TITLE_EN);
        assert(get_course_title_en(0) == "");
    }
    
    test "course title retrieval works for RU" {
        assert(get_course_title_ru(1) == COURSE_1_TITLE_RU);
        assert(get_course_title_ru(9) == COURSE_9_TITLE_RU);
        assert(get_course_title_ru(13) == COURSE_13_TITLE_RU);
        assert(get_course_title_ru(0) == "");
    }
    
    test "course spec retrieval works" {
        assert(get_course_spec(1) == COURSE_1_SPEC);
        assert(get_course_spec(8) == COURSE_8_SPEC);
        assert(get_course_spec(13) == COURSE_13_SPEC);
        assert(get_course_spec(0) == "");
    }
    
    test "course story retrieval works" {
        assert(get_course_story(1) == COURSE_1_STORY);
        assert(get_course_story(9) == COURSE_9_STORY);
        assert(get_course_story(13) == COURSE_13_STORY);
        assert(get_course_story(0) == "");
    }
    
    test "course status retrieval works" {
        assert(get_course_status(1) == STATUS_LIVE);
        assert(get_course_status(9) == STATUS_LIVE);
        assert(get_course_status(10) == STATUS_QUEUE);
        assert(get_course_status(13) == STATUS_QUEUE);
        assert(get_course_status(0) == "");
        assert(get_course_status(14) == "");
    }
    
    test "all live courses have correct properties" {
        for i in 1..9 {
            assert(is_live_course(i) == true);
            assert(is_queue_course(i) == false);
            assert(get_course_status(i) == STATUS_LIVE);
            assert(get_course_id(i) != "");
            assert(get_course_title_en(i) != "");
            assert(get_course_title_ru(i) != "");
            assert(get_course_spec(i) != "");
            assert(get_course_story(i) != "");
        }
    }
    
    test "all queue courses have correct properties" {
        for i in 10..13 {
            assert(is_live_course(i) == false);
            assert(is_queue_course(i) == true);
            assert(get_course_status(i) == STATUS_QUEUE);
            assert(get_course_id(i) != "");
            assert(get_course_title_en(i) != "");
            assert(get_course_title_ru(i) != "");
            assert(get_course_spec(i) != "");
            assert(get_course_story(i) != "");
        }
    }
    
    test "course numbers are unique and sequential" {
        // Test that all courses from 1-13 are defined
        for i in 1..13 {
            var id = get_course_id(i);
            assert(id != "");
            // Each ID should be unique (simple check - no obvious duplicates)
            if i < 13 {
                assert(id != get_course_id(i + 1));
            }
        }
    }
}