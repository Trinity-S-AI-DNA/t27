// SPDX-License-Identifier: Apache-2.0
// apps/website/specs/course/courses.t27 -- the course catalog for t27.ai/learn/,
// listing all live courses and the queue of upcoming ones. Each course has 27
// lessons, one widget per lesson, and tells part of the t27 project story.
// Host: gHashTag/trinity apps/website/src/pages/Courses.tsx draws this catalog.
// Why: owner, 2026-10-11 -- "the Queen keeps making new t27.ai courses, one after 
// another. Every course tells part of this project's story: t27, Trinity, the 
// ternary machine, the FPGA work, and the hive."
// The queue follows the order in the EPIC; the Queen may reorder only with a 
// reason written in the round report.
// Claim status: written to match the live catalog and the EPIC queue.
// phi^2 + 1/phi^2 = 3 | TRINITY

module website::course_catalog {

    pub const KIND : str = "website";
    pub const ID : str = "courses";
    pub const REPO : str = "trinity";
    pub const VERSION : u8 = 1;

    // ---- Course status ---------------------------------------------------------------
    pub const STATUS_LIVE : str = "live";
    pub const STATUS_QUEUE : str = "queue";
    
    // ---- Course counting -------------------------------------------------------------
    pub const LESSONS_PER_COURSE : u8 = 27;
    pub const WIDGETS_PER_LESSON : u8 = 1;
    pub const LIVE_COURSES_COUNT : u8 = 9;
    pub const QUEUE_COURSES_COUNT : u8 = 4;
    pub const TOTAL_COURSES_COUNT : u8 = 13;
    
