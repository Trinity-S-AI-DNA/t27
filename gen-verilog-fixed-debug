#!/bin/bash

# Debug version of the wrapper script for t27c gen-verilog

# Run the original gen-verilog command
output=$(t27c gen-verilog "$@" 2>&1)
exit_code=$?

echo "=== DEBUG: gen-verilog output ===" >&2
echo "$output" >&2
echo "=== DEBUG: Exit code: $exit_code ===" >&2

# Check if the output contains function calls without definitions
echo "=== DEBUG: Checking for function calls ===" >&2

if echo "$output" | grep -q "out<=" && echo "$output" | grep -q "twice("; then
    echo "=== DEBUG: Found out<= and twice( in output ===" >&2
    
    # Check if there's no function definition for 'twice'
    if ! echo "$output" | grep -q "function.*twice"; then
        echo "=== DEBUG: No function definition for 'twice' found ===" >&2
        echo "ERROR: gen-verilog cannot lower imported function 'twice'" >&2
        echo "The generated Verilog calls 'twice' but does not define it." >&2
        echo "This will cause yosys to fail. Issue #8769." >&2
        exit 1
    else
        echo "=== DEBUG: Function definition for 'twice' found ===" >&2
    fi
else
    echo "=== DEBUG: Did not find both out<= and twice( in output ===" >&2
fi

# Check for any other function calls that might not be defined
echo "=== DEBUG: Checking for other function calls ===" >&2
if echo "$output" | grep -q "out<=" && echo "$output" | grep -q "[a-zA-Z][a-zA-Z0-9_]*("; then
    # Extract function calls from the output
    function_calls=$(echo "$output" | grep -o "[a-zA-Z][a-zA-Z0-9_]*(" | sed 's/($//' | sort -u)
    
    echo "=== DEBUG: Found function calls: $function_calls ===" >&2
    
    for func in $function_calls; do
        echo "=== DEBUG: Checking function: $func ===" >&2
        # Skip known built-in functions
        case "$func" in
            __mul_noop|assign|always|if|else|begin|end|for|while|case|default|input|output|inout|wire|reg|function|endfunction|initial)
                echo "=== DEBUG: Skipping built-in function: $func ===" >&2
                continue
                ;;
        esac
        
        # Check if this function is defined in the output
        if ! echo "$output" | grep -q "function.*$func\|$func.*function"; then
            echo "=== DEBUG: Function $func is not defined ===" >&2
            # Check if it's in the original spec (might be imported)
            if ! echo "$output" | grep -q "Generated from t27 spec.*$func"; then
                echo "ERROR: gen-verilog cannot lower function '$func'" >&2
                echo "The generated Verilog calls '$func' but does not define it." >&2
                echo "This might be an imported function. Issue #8769." >&2
                exit 1
            else
                echo "=== DEBUG: Function $func is in original spec ===" >&2
            fi
        else
            echo "=== DEBUG: Function $func is defined ===" >&2
        fi
    done
else
    echo "=== DEBUG: Did not find both out<= and function calls in output ===" >&2
fi

# If we get here, output the result and exit with the original code
echo "=== DEBUG: Outputting result with exit code $exit_code ===" >&2
echo "$output"
exit $exit_code