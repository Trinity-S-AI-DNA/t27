// Customization options
pub fn customize_enhancements() -> void {
    log_message("🎨 Customization options");

    log_message("Available customizations:");
    log_message("   1. Cursor color: green (default) / blue / red / yellow");
    log_message("   2. Cursor width: 2px / 3px / 4px (default) / 5px");
    log_message("   3. Background: dark gray (default) / black / blue");
    log_message("   4. Text color: white (default) / light gray / yellow");
    log_message("   5. Font size: 14px / 16px (default) / 18px / 20px");
    log_message("   6. Line height: 1.4x / 1.6x (default) / 1.8x");

    log_message("To customize, edit the settings in this file");
    log_message("and run the script again with your preferred settings.");
}

// Apply specific enhancement theme
pub fn apply_theme(theme: str) -> void {
    log_message(@concat("🎨 Applying theme: ", theme));

    if (theme == "high-contrast") {
        apply_high_contrast_theme();
    } else if (theme == "dark-mode") {
        apply_dark_mode_theme();
    } else if (theme == "minimal") {
        apply_minimal_theme();
    } else {
        log_message("Unknown theme. Using default.");
        apply_improvements();
    }
}

fn apply_high_contrast_theme() -> void {
    log_message("   Applying high-contrast theme");
    log_message("   • Bright yellow text on black");
    log_message("   • Thick white cursor");
    log_message("   • Maximum contrast ratio");
}

fn apply_dark_mode_theme() -> void {
    log_message("   Applying dark mode theme");
    log_message("   • Light gray text on dark blue");
    log_message("   • Green cursor");
    log_message("   • Blue light reduction");
}

fn apply_minimal_theme() -> void {
    log_message("   Applying minimal theme");
    log_message("   • Black text on white");
    log_message("   • Thin black cursor");
    log_message("   • No animations");
}