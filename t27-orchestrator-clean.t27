// Calculate next cycle time
fn calculate_next_cycle_time() -> str {
    const interval_minutes : u32 = 30;
    return @concat("Next cycle in ", @toString(interval_minutes), " minutes");
}

// Remove from improvement queue
fn remove_from_improvement_queue(improvement: str) -> void {
    for (var i: u32 = 0; i < improvement_queue.length; i += 1) {
        if (improvement_queue[i] == improvement) {
            improvement_queue[i] = "";
            break;
        }
    }
}

// Remove from collaboration queue
fn remove_from_collaboration_queue(task: str) -> void {
    for (var i: u32 = 0; i < collaboration_queue.length; i += 1) {
        if (collaboration_queue[i] == task) {
            collaboration_queue[i] = "";
            break;
        }
    }
}

