#!/bin/sh
# Thin shim; logic in bootstrap/src/hooks.rs. Enable with: t27c install-hooks
#
# This shim used to `exit 0` when t27c was missing, with the word "skipping".
# That is the same defect one layer down from the one this gate exists to catch:
# a check that turns itself off when it cannot run reports nothing and reads as
# a pass. It now refuses the commit and says how to fix it.
root=$(git rev-parse --show-toplevel)
t27c="$root/target/release/t27c"
if [ ! -x "$t27c" ]; then
    echo "commit-msg: L1 TRACEABILITY cannot run -- no binary at $t27c" >&2
    echo "  Build it:  cargo build --release -p t27c" >&2
    echo "  This commit is refused rather than passed unchecked." >&2
    echo "  Deliberate override:  git commit --no-verify" >&2
    exit 1
fi
exec "$t27c" hook-commit-msg "$1" --repo-root "$root"
