#!/bin/sh
# Thin shim. All gate logic lives in bootstrap/src/hooks.rs so there is one
# implementation, testable and versioned. Enable with: t27c install-hooks
#
# A missing binary refuses the commit rather than skipping the gates: see the
# note in .githooks/commit-msg.
root=$(git rev-parse --show-toplevel)
t27c="$root/target/release/t27c"
if [ ! -x "$t27c" ]; then
    echo "pre-commit: gates cannot run -- no binary at $t27c" >&2
    echo "  Build it:  cargo build --release -p t27c" >&2
    echo "  This commit is refused rather than passed unchecked." >&2
    echo "  Deliberate override:  git commit --no-verify" >&2
    exit 1
fi
exec "$t27c" hook-pre-commit --repo-root "$root"
