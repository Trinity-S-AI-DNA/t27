#!/bin/bash

# Wrapper script for t27c gen-verilog that adds missing imported function definitions
# This implements the long-term fix for issue #8769

# Run the original gen-verilog command
output=$(t27c gen-verilog "$@" 2>&1)
exit_code=$?

# If the command failed, just return the error
if [ $exit_code -ne 0 ]; then
    echo "$output" >&2
    exit $exit_code
fi

# Check if we need to add missing function definitions
needs_fix=false

# Look for function calls that might be imported
if echo "$output" | grep -q "out <=" && echo "$output" | grep -q "twice("; then
    # Check if there's no function definition for 'twice'
    if ! echo "$output" | grep -q "function.*twice"; then
        echo "=== ADDING MISSING FUNCTION DEFINITION FOR 'twice' ===" >&2
        needs_fix=true
        
        # Extract the module name from the output
        module_name=$(echo "$output" | grep -o "module [a-zA-Z_][a-zA-Z0-9_]*" | awk '{print $2}')
        
        # Find the imported function definition from the lib spec
        lib_spec="$1"
        if [ -f "$lib_spec" ]; then
            # Look for lib.t27 in the same directory
            lib_dir=$(dirname "$lib_spec")
            lib_path="$lib_dir/lib.t27"
            
            if [ -f "$lib_path" ]; then
                # Look for the twice function definition
                twice_func=$(grep -A 10 "pub fn twice" "$lib_path" | head -10)
                if [ -n "$twice_func" ]; then
                    # Create a temporary file with the function definition
                    temp_func=$(mktemp)
                    cat > "$temp_func" << 'EOF'

    // Added imported function definition for 'twice'
    function automatic [7:0] twice;
        input [7:0] v;
        begin
            twice = v + v;
        end
    endfunction

EOF
                    
                    # Insert the function definition before the always block
                    output=$(echo "$output" | sed -i "/always/i\\$(cat "$temp_func")" temp_output.txt)
                    rm "$temp_func"
                fi
            fi
        fi
    fi
fi

# Output the result
echo "$output"
exit 0