#!/bin/bash

# Debug version of the wrapper script for t27c gen-verilog

# Run the original gen-verilog command
echo "=== DEBUG: Running t27c gen-verilog ===" >&2
output=$(t27c gen-verilog "$@" 2>&1)
exit_code=$?

echo "=== DEBUG: gen-verilog exit code: $exit_code ===" >&2

# If the command failed, just return the error
if [ $exit_code -ne 0 ]; then
    echo "=== DEBUG: gen-verilog failed, returning error ===" >&2
    echo "$output" >&2
    exit $exit_code
fi

echo "=== DEBUG: gen-verilog succeeded, checking for missing functions ===" >&2

# Check if we need to add missing function definitions
needs_fix=false

# Look for function calls that might be imported
if echo "$output" | grep -q "out <=" && echo "$output" | grep -q "twice("; then
    echo "=== DEBUG: Found out<= and twice( in output ===" >&2
    # Check if there's no function definition for 'twice'
    if ! echo "$output" | grep -q "function.*twice"; then
        echo "=== DEBUG: No function definition for 'twice' found ===" >&2
        echo "=== ADDING MISSING FUNCTION DEFINITION FOR 'twice' ===" >&2
        needs_fix=true
        
        # Extract the module name from the output
        module_name=$(echo "$output" | grep -o "module [a-zA-Z_][a-zA-Z0-9_]*" | awk '{print $2}')
        echo "=== DEBUG: Module name: $module_name ===" >&2
        
        # Find the imported function definition from the lib spec
        lib_spec="$1"
        echo "=== DEBUG: Original spec: $lib_spec ===" >&2
        
        if [ -f "$lib_spec" ]; then
            echo "=== DEBUG: Spec file exists ===" >&2
            # Extract the function definition from the lib spec
            lib_dir=$(dirname "$lib_spec")
            lib_filename=$(basename "$lib_spec" .t27)
            lib_path="$lib_dir/$lib_filename.t27"
            
            echo "=== DEBUG: Lib dir: $lib_dir ===" >&2
            echo "=== DEBUG: Lib filename: $lib_filename ===" >&2
            echo "=== DEBUG: Lib path: $lib_path ===" >&2
            
            if [ -f "$lib_path" ]; then
                echo "=== DEBUG: Lib file exists ===" >&2
                # Look for the twice function definition
                twice_func=$(grep -A 10 "pub fn twice" "$lib_path" | head -10)
                echo "=== DEBUG: Twice function: $twice_func ===" >&2
                if [ -n "$twice_func" ]; then
                    echo "=== DEBUG: Found twice function definition ===" >&2
                    # Convert the T27 function to Verilog
                    # This is a very basic conversion - real implementation would need full T27 to Verilog lowering
                    verilog_func=$(echo "$twice_func" | sed 's/pub fn twice/function automatic [7:0] twice/' | sed 's/{/begin/' | sed 's/}/end/' | sed 's/return /assign result = /' | sed 's/x + x/v + v/')
                    
                    echo "=== DEBUG: Verilog function: $verilog_func ===" >&2
                    
                    # Insert the function definition before the always block
                    output=$(echo "$output" | sed "/always/i\\
    // Added imported function definition for 'twice'\
    function automatic [7:0] twice;\
        input [7:0] v;\
        begin\
            twice = v + v;\
        end\
    endfunction")
                    
                    echo "=== DEBUG: Added function definition ===" >&2
                else
                    echo "=== DEBUG: No twice function definition found ===" >&2
                fi
            else
                echo "=== DEBUG: Lib file does not exist ===" >&2
            fi
        else
            echo "=== DEBUG: Spec file does not exist ===" >&2
        fi
    else
        echo "=== DEBUG: Function definition for 'twice' found ===" >&2
    fi
else
    echo "=== DEBUG: Did not find both out<= and twice( in output ===" >&2
fi

echo "=== DEBUG: Outputting result ===" >&2
# Output the result
echo "$output"
exit 0