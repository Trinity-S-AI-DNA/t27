    log_message(@concat("   Build: ", BUILD_NUMBER));
    log_message(@concat("   Date: ", BUILD_DATE));
    log_message("   Autonomous Mode: true");

    if (args.verbose) {
        log_message("   Detailed Information:");
        log_message(@concat("   Python Version: ", @to_string(@python_version())));
        log_message(@concat("   Platform: ", @to_string(@platform())));
        log_message(@concat("   Build Time: ", @to_string(@time())));
