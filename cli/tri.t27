// CLI test
pub test cli_test {
    // Test CLI initialization
    log_message("Testing CLI initialization");

    // Test version constants
    assert @strcmp(VERSION, "2.0.0") == 0;
    assert @strcmp(BUILD_NUMBER, "20261021-1") == 0;

    // Test command enum
    const test_command : CommandType = CommandType.Deploy;
    assert @enum_value(test_command) == @enum_value(CommandType.Deploy);

    log_message("✅ CLI test completed");
}

