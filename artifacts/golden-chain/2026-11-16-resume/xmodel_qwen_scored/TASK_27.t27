module coding_eval_gen;

pub fn tri_sign(a: i32) i32 {
    if a < 0 {
        return -5;
    } else if a > 0 {
        return 5;
    } else {
        return 0;
    }
}
test tri_sign_works { assert tri_sign(-100) == -5; assert tri_sign(7) == 5; assert tri_sign(0) == 0; }
