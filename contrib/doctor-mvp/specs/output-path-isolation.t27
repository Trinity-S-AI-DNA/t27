#!/usr/bin/env python3
"""
Doctor MVP Output Path Specification
.t27 specification for output path validation and isolation
"""

# Format: t27-spec-001
# Language: T27
# Purpose: Output path isolation and validation
# Status: ACTIVE

spec "doctor_output_isolation" {
    # Configuration for output path isolation
    output_root = "./audit-output/doctor-mvp/"
    path_base = "repository_root"
    cwd_based_paths = "deny"
    
    # Forbidden patterns that indicate path traversal or nesting issues
    forbidden_output_pattern = "**/contrib/doctor-mvp/contrib/doctor-mvp/**"
    path_escape_pattern = "**/*../**"
    
    # Validation requirements
    require_output_under_root = true
    require_output_manifest = true
    require_absolute_path_validation = true
    
    # Test suite for output path isolation
    test "output_path_never_nests_contrib" {
        given {
            repository_root = Path(__file__).resolve().parents[2]
            input_file = "contrib/doctor-mvp/fixtures/sample-chat-export.json"
            output_directory = "output"
        }
        
        when {
            scanner = IncidentScanner(config)
            result = scanner.scan_file(input_file, output_directory)
        }
        
        then {
            # Output must be under audit-output/doctor-mvp/
            output_path.is_relative_to(Path("audit-output/doctor-mvp/"))
            
            # Must not contain nested contrib/doctor-mvp
            output_path.as_posix() !~ "**/contrib/doctor-mvp/contrib/doctor-mvp/**"
            
            # No files created in nested contrib directories
            Path("contrib/doctor-mvp/contrib/doctor-mvp/").exists() == false
            
            # Output must be manifest-controlled
            Path("audit-output/doctor-mvp/manifest.json").exists()
        }
        
        invariant {
            for output_file in output_directory.glob("**/*.json"):
                path = output_file.resolve()
                if path.as_posix().contains("contrib/doctor-mvp"):
                    assert path.as_posix().count("contrib/doctor-mvp") == 1
        }
    }
    
    test "cli_from_nested_cwd_does_not_nest" {
        given {
            # Simulate running from nested directory
            working_directory = "contrib/doctor-mvp/"
            input_file = "../fixtures/sample-chat-export.json"
            output_path = "scan-results"
        }
        
        when {
            # Change to nested directory
            os.chdir(working_directory)
            cli = DoctorCLI()
            result = cli.scan([input_file], output_path)
        }
        
        then {
            # Output should still resolve to correct location
            actual_output = cli._resolve_output_path(output_path + "/incidents.json")
            expected_output = Path("audit-output/doctor-mvp/scan-results/incidents.json")
            
            actual_output == expected_output
            
            # No nested directory should be created
            not Path("contrib/doctor-mvp/contrib/doctor-mvp").exists()
        }
    }
    
    test "path_validation_blocks_traversal" {
        given {
            output_root = "./audit-output/doctor-mvp/"
        }
        
        when {
            # Attempt to create path that escapes output root
            invalid_paths = [
                "../../etc/passwd",
                "../outside.json",
                "contrib/doctor-mvp/traversal.json"
            ]
        }
        
        then {
            for path in invalid_paths:
                assert cli._resolve_output_path(path).raises(ValueError)
        }
    }
    
    # Benchmark performance of path validation
    bench "output_path_resolution_performance" {
        iterations = 1000
        operations = [
            "_resolve_output_path('incidents/scan-001.json')",
            "_resolve_output_path('reports/daily-summary.json')", 
            "_resolve_output_path('alerts/critical-001.json')"
        ]
        
        assert max_duration < 0.001  # Must complete in under 1ms per operation
    }
}

# Guardrail configuration for path isolation
guardrail "doctor_output_path_isolation" {
    enabled = true
    severity = "critical"
    
    rule "no_cwd_based_paths" {
        pattern = "os.path.join(os.getcwd(),.*)"
        message = "Output paths must use repository root, not current working directory"
        action = "block_write"
    }
    
    rule "no_nested_contrib_pattern" {
        pattern = "**/contrib/doctor-mvp/contrib/doctor-mvp/**"
        message = "Forbidden nested output pattern detected"
        action = "block_write"
    }
    
    rule "output_root_validation" {
        pattern = "output_root.*="
        message = "Output root must be defined and validated"
        action = "require_review"
    }
    
    on_violation {
        classification = "PATH_ISOLATION_VIOLATION"
        severity = "critical"
        action = "block_operation"
        require_approval = false  # Critical violations auto-block
    }
}

# Manifest validation for output directory
manifest "doctor_output_manifest" {
    output_directory = "audit-output/doctor-mvp/"
    
    allowed_patterns = [
        "incidents/**/*.json",
        "reports/**/*.md",
        "alerts/**/*.json",
        "temp/*.tmp"  # Temporary files allowed
    ]
    
    required_files = [
        "manifest.json",  # Contains list of expected outputs
        "schema.json"     # Output format validation
    ]
    
    cleanup_rules {
        max_age_days = 30
        extensions = [".tmp", ".log"]
        pattern = "**/temp/*"
    }
}

# Configuration for Doctor CLI
config "doctor_output_settings" {
    # Default output directory
    default_output_root = "./audit-output/doctor-mvp/"
    
    # Path resolution mode
    resolution_mode = "repository_root"  # Options: repository_root, relative, absolute
    
    # Validation settings
    enable_path_validation = true
    enable_manifest_validation = true
    enable_cleanup = true
    
    # Logging
    log_output_operations = true
    log_path_validation_errors = true
    
    # Performance
    cache_output_paths = true
    path_resolution_cache_size = 100
}

# Integration with main Doctor system
integration "doctor_output_isolation" {
    import "doctor_cli"
    
    # Apply output path isolation to all CLI operations
    modify_method "doctor_cli.scan" {
        before {
            output_dir = output_path_validator.validate(output_dir)
        }
    }
    
    modify_method "doctor_cli.triage" {
        before {
            output_dir = output_path_validator.validate(output_dir)
        }
    }
    
    modify_method "doctor_cli.handoff" {
        before {
            output_dir = output_path_validator.validate(output_dir)
        }
    }
    
    # Add output path validation to all CLI commands
    for command in ["scan", "triage", "handoff", "verify", "report"] {
        before_command command {
            if output_dir is not None:
                output_path_validator.validate(output_dir)
        }
    }
}

# End of specification