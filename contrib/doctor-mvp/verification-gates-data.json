{
  "incident_types": {
    "BUILD_FAILURE": {
      "verification_steps": [
        {
          "step_id": "check_build_dir",
          "description": "Verify build directory exists",
          "type": "directory_check",
          "target": "target/",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "ABORT"
        },
        {
          "step_id": "check_cargo_toml",
          "description": "Verify Cargo.toml exists",
          "type": "file_exists",
          "target": "Cargo.toml",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "ABORT"
        },
        {
          "step_id": "check_build_artifact",
          "description": "Verify build artifact exists",
          "type": "file_exists",
          "target": "target/release/main",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "REPAIR"
        },
        {
          "step_id": "test_compilation",
          "description": "Test compilation",
          "type": "command_success",
          "target": "cargo check",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "REPAIR"
        }
      ],
      "success_criteria": ["check_build_dir", "check_cargo_toml", "test_compilation"],
      "optional_criteria": ["check_build_artifact"],
      "time_limit_seconds": 300
    },
    "TEST_FAILURE": {
      "verification_steps": [
        {
          "step_id": "check_test_file",
          "description": "Verify test files exist",
          "type": "directory_check",
          "target": "tests/",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "ABORT"
        },
        {
          "step_id": "run_tests",
          "description": "Run tests to verify fix",
          "type": "command_success",
          "target": "cargo test",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "REPAIR"
        },
        {
          "step_id": "check_test_coverage",
          "description": "Verify test coverage is maintained",
          "type": "metrics_threshold",
          "target": "test_coverage_percentage",
          "threshold": {
            "min": 80,
            "max": 100
          },
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "ALLOW_CONTINUE"
        }
      ],
      "success_criteria": ["check_test_file", "run_tests"],
      "optional_criteria": ["check_test_coverage"],
      "time_limit_seconds": 180
    },
    "DISK_PRESSURE": {
      "verification_steps": [
        {
          "step_id": "check_disk_space",
          "description": "Verify disk space is above threshold",
          "type": "metrics_threshold",
          "target": "available_gb",
          "threshold": {
            "min": 5,
            "max": null
          },
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "REPAIR"
        },
        {
          "step_id": "clean_temp_files",
          "description": "Verify temporary files were cleaned",
          "type": "directory_check",
          "target": "/tmp",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "ALLOW_CONTINUE"
        },
        {
          "step_id": "check_cleanup_success",
          "description": "Verify disk space increased after cleanup",
          "type": "metrics_threshold",
          "target": "disk_usage_percentage",
          "threshold": {
            "min": null,
            "max": 90
          },
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "REPAIR"
        }
      ],
      "success_criteria": ["check_disk_space"],
      "optional_criteria": ["clean_temp_files", "check_cleanup_success"],
      "time_limit_seconds": 600
    },
    "PROVIDER_UNFUNDED": {
      "verification_steps": [
        {
          "step_id": "check_provider_status",
          "description": "Verify provider status is active",
          "type": "command_success",
          "target": "doctor status",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "ABORT"
        },
        {
          "step_id": "check_funding_status",
          "description": "Verify funding is available",
          "type": "command_success",
          "target": "doctor funding status",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "MANUAL_INTERVENTION"
        },
        {
          "step_id": "check_service_availability",
          "description": "Verify service is available",
          "type": "command_success",
          "target": "doctor service check",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "ALLOW_CONTINUE"
        }
      ],
      "success_criteria": ["check_provider_status", "check_funding_status"],
      "optional_criteria": ["check_service_availability"],
      "time_limit_seconds": 120
    },
    "WRONG_WORKSPACE": {
      "verification_steps": [
        {
          "step_id": "check_current_directory",
          "description": "Verify correct workspace",
          "type": "directory_check",
          "target": ".git",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "REPAIR"
        },
        {
          "step_id": "verify_repository_root",
          "description": "Verify repository root",
          "type": "file_exists",
          "target": "Cargo.toml",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "ALLOW_CONTINUE"
        },
        {
          "step_id": "check_working_directory",
          "description": "Verify working directory state",
          "type": "command_success",
          "target": "pwd",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "ALLOW_CONTINUE"
        }
      ],
      "success_criteria": ["check_current_directory"],
      "optional_criteria": ["verify_repository_root", "check_working_directory"],
      "time_limit_seconds": 30
    },
    "GIT_PUSH_BLOCKED": {
      "verification_steps": [
        {
          "step_id": "check_git_status",
          "description": "Verify git status is clean",
          "type": "command_success",
          "target": "git status",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "ABORT"
        },
        {
          "step_id": "check_remote_status",
          "description": "Verify remote status",
          "type": "command_success",
          "target": "git remote -v",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "REPAIR"
        },
        {
          "step_id": "test_push",
          "description": "Test push operation",
          "type": "command_success",
          "target": "git push --dry-run",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "REPAIR"
        }
      ],
      "success_criteria": ["check_git_status", "check_remote_status"],
      "optional_criteria": ["test_push"],
      "time_limit_seconds": 120
    },
    "PROTECTED_STATE_RISK": {
      "verification_steps": [
        {
          "step_id": "check_protected_files",
          "description": "Verify protected files exist",
          "type": "file_exists",
          "target": "config/settings.json",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "ABORT"
        },
        {
          "step_id": "check_file_integrity",
          "description": "Verify file integrity",
          "type": "command_success",
          "target": "sha256sum config/settings.json",
          "expected_value": true,
          "failure_impact": "BLOCK_REPAIR",
          "on_failure": "MANUAL_INTERVENTION"
        },
        {
          "step_id": "check_backup_exists",
          "description": "Verify backup exists",
          "type": "file_exists",
          "target": "backup/settings.json.bak",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "ALLOW_CONTINUE"
        }
      ],
      "success_criteria": ["check_protected_files", "check_file_integrity"],
      "optional_criteria": ["check_backup_exists"],
      "time_limit_seconds": 60
    },
    "UNKNOWN": {
      "verification_steps": [
        {
          "step_id": "check_incident_log",
          "description": "Verify incident was logged",
          "type": "file_exists",
          "target": "incidents.log",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "ALLOW_CONTINUE"
        },
        {
          "step_id": "check_manual_review",
          "description": "Check if manual review required",
          "type": "command_success",
          "target": "doctor classify manual",
          "expected_value": true,
          "failure_impact": "WARN_CONTINUE",
          "on_failure": "MANUAL_INTERVENTION"
        }
      ],
      "success_criteria": ["check_incident_log"],
      "optional_criteria": ["check_manual_review"],
      "time_limit_seconds": 60
    }
  }
}