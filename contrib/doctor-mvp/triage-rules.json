{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doctor Triage Rules",
  "description": "Rules for classifying incidents based on error messages and context",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "incident_type": {
            "type": "string",
            "enum": ["BUILD_FAILURE", "TEST_FAILURE", "DISK_PRESSURE", "PROVIDER_UNFUNDED", "WRONG_WORKSPACE", "GIT_PUSH_BLOCKED", "PROTECTED_STATE_RISK", "UNKNOWN"]
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "priority": {
            "type": "integer",
            "description": "Lower numbers indicate higher priority (1-100)"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Field to check (error_message, context.*, etc.)"
                },
                "pattern": {
                  "type": "string",
                  "description": "Regex pattern to match"
                },
                "case_sensitive": {
                  "type": "boolean",
                  "default": false
                },
                "match_type": {
                  "type": "string",
                  "enum": ["contains", "exact", "starts_with", "ends_with", "regex"],
                  "default": "contains"
                }
              },
              "required": ["field", "pattern"]
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                },
                "case_sensitive": {
                  "type": "boolean",
                  "default": false
                },
                "match_type": {
                  "type": "string",
                  "enum": ["contains", "exact", "starts_with", "ends_with", "regex"],
                  "default": "contains"
                }
              },
              "required": ["field", "pattern"]
            },
            "description": "Conditions that would exclude this rule from matching"
          }
        },
        "required": ["incident_type", "severity", "priority", "conditions"]
      }
    }
  },
  "required": ["rules"]
}