{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doctor Repair Brief Template",
  "description": "Template for creating repair chat briefs",
  "type": "object",
  "properties": {
    "brief_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the repair brief"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the repair brief was created"
    },
    "incident_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the incident being repaired"
    },
    "incident_type": {
      "type": "string",
      "enum": ["BUILD_FAILURE", "TEST_FAILURE", "DISK_PRESSURE", "PROVIDER_UNFUNDED", "WRONG_WORKSPACE", "GIT_PUSH_BLOCKED", "PROTECTED_STATE_RISK", "UNKNOWN"],
      "description": "Type of incident to repair"
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Severity level of the incident"
    },
    "priority": {
      "type": "integer",
      "description": "Priority level (1-100, lower is higher priority)"
    },
    "repair_context": {
      "type": "object",
      "properties": {
        "repository_root": {
          "type": "string",
          "description": "Root directory of the repository"
        },
        "working_directory": {
          "type": "string",
          "description": "Current working directory"
        },
        "session_id": {
          "type": "string",
          "description": "Session ID where incident occurred"
        },
        "user_id": {
          "type": "string",
          "description": "User ID associated with the session"
        }
      },
      "additionalProperties": true
    },
    "incident_summary": {
      "type": "string",
      "description": "Summary of the incident that occurred"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "root_cause": {
          "type": "string",
          "description": "Root cause analysis of the incident"
        },
        "affected_components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Components affected by the incident"
        },
        "impact_assessment": {
          "type": "string",
          "description": "Assessment of the impact"
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "expected_result": {
                "type": "string"
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "time_estimate_minutes": {
                "type": "integer"
              }
            },
            "required": ["action_id", "description", "command", "expected_result"]
          }
        }
      },
      "required": ["root_cause", "recommended_actions"]
    },
    "repair_guidelines": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Constraints that must be followed during repair"
        },
        "verification_steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Steps to verify the repair was successful"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Conditions that must be true before starting repair"
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Conditions that must be true after repair"
        }
      },
      "required": ["constraints", "verification_steps", "preconditions", "postconditions"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["log_entry", "error_trace", "command_output", "file_content", "system_metrics"]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "source_file": {
            "type": "string"
          }
        },
        "required": ["type", "content", "timestamp"]
      }
    },
    "estimated_duration_minutes": {
      "type": "integer",
      "description": "Estimated time to complete the repair"
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Risk level of the repair operation"
    }
  },
  "required": ["brief_id", "created_at", "incident_id", "incident_type", "severity", "priority", "repair_context", "incident_summary", "analysis", "repair_guidelines", "risk_level"]
}