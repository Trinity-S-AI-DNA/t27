{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doctor Verification Gates",
  "description": "Verification criteria for each incident type",
  "type": "object",
  "properties": {
    "incident_types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verification_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "type": "string",
                  "description": "Unique identifier for the verification step"
                },
                "description": {
                  "type": "string",
                  "description": "Description of what this step verifies"
                },
                "type": {
                  "type": "string",
                  "enum": ["file_exists", "command_success", "regex_match", "json_validate", "metrics_threshold", "directory_check"],
                  "description": "Type of verification"
                },
                "target": {
                  "type": "string",
                  "description": "Target of verification (file path, command, pattern, etc.)"
                },
                "expected_value": {
                  "description": "Expected value for the verification"
                },
                "threshold": {
                  "type": "object",
                  "properties": {
                    "min": {"type": "number"},
                    "max": {"type": "number"}
                  },
                  "description": "Threshold range for numeric verifications"
                },
                "failure_impact": {
                  "type": "string",
                  "enum": ["BLOCK_REPAIR", "WARN_CONTINUE", "ALLOW_CONTINUE"],
                  "description": "Impact if verification fails"
                },
                "on_failure": {
                  "type": "string",
                  "enum": ["REPAIR", "ABORT", "MANUAL_INTERVENTION"],
                  "description": "Action to take on verification failure"
                }
              },
              "required": ["step_id", "description", "type", "target", "expected_value", "failure_impact"]
            }
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "ID of verification steps that must succeed"
            }
          },
          "optional_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "ID of verification steps that are optional"
            }
          },
          "time_limit_seconds": {
            "type": "integer",
            "description": "Time limit for verification (0 = no limit)"
          }
        },
        "required": ["verification_steps", "success_criteria"]
      }
    }
  },
  "required": ["incident_types"]
}