{
  "rules": [
    {
      "incident_type": "BUILD_FAILURE",
      "severity": "HIGH",
      "priority": 10,
      "conditions": [
        {
          "field": "error_message",
          "pattern": "failed to compile",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "build error",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "cargo build failed",
          "match_type": "contains"
        }
      ],
      "exclusions": [
        {
          "field": "context.build_system",
          "pattern": "unknown",
          "match_type": "exact"
        }
      ]
    },
    {
      "incident_type": "TEST_FAILURE",
      "severity": "MEDIUM",
      "priority": 20,
      "conditions": [
        {
          "field": "error_message",
          "pattern": "test failed",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "assertion failed",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "pytest: failed",
          "match_type": "contains"
        }
      ]
    },
    {
      "incident_type": "DISK_PRESSURE",
      "severity": "CRITICAL",
      "priority": 5,
      "conditions": [
        {
          "field": "error_message",
          "pattern": "disk full",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "no space left",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "disk quota exceeded",
          "match_type": "contains"
        }
      ],
      "exclusions": [
        {
          "field": "context.disk_usage",
          "pattern": null,
          "match_type": "exact"
        }
      ]
    },
    {
      "incident_type": "PROVIDER_UNFUNDED",
      "severity": "HIGH",
      "priority": 15,
      "conditions": [
        {
          "field": "error_message",
          "pattern": "provider funding",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "payment required",
          "match_type": "contains"
        },
        {
          "field": "error_code",
          "pattern": "402",
          "match_type": "exact"
        },
        {
          "field": "error_code",
          "pattern": "403",
          "match_type": "exact"
        }
      ]
    },
    {
      "incident_type": "WRONG_WORKSPACE",
      "severity": "MEDIUM",
      "priority": 25,
      "conditions": [
        {
          "field": "error_message",
          "pattern": "wrong directory",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "not in repository",
          "match_type": "contains"
        },
        {
          "field": "context.working_directory",
          "pattern": null,
          "match_type": "exact"
        }
      ]
    },
    {
      "incident_type": "GIT_PUSH_BLOCKED",
      "severity": "HIGH",
      "priority": 12,
      "conditions": [
        {
          "field": "error_message",
          "pattern": "git push",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "blocked",
          "match_type": "contains"
        },
        {
          "field": "context.git_remote",
          "pattern": null,
          "match_type": "not_null"
        }
      ]
    },
    {
      "incident_type": "PROTECTED_STATE_RISK",
      "severity": "CRITICAL",
      "priority": 8,
      "conditions": [
        {
          "field": "error_message",
          "pattern": "protected file",
          "match_type": "contains"
        },
        {
          "field": "error_message",
          "pattern": "state risk",
          "match_type": "contains"
        },
        {
          "field": "context.protected_files",
          "pattern": null,
          "match_type": "not_null"
        }
      ]
    },
    {
      "incident_type": "UNKNOWN",
      "severity": "MEDIUM",
      "priority": 100,
      "conditions": [
        {
          "field": "incident_type",
          "pattern": "UNKNOWN",
          "match_type": "exact"
        }
      ]
    }
  ]
}