{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/stop-hook-guard.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allowedCommands": [
      "cargo",
      "tri",
      "t27c",
      "zig",
      "git",
      "cat",
      "ls",
      "grep",
      "find",
      "head",
      "tail",
      "sed",
      "awk",
      "cut",
      "sort",
      "uniq",
      "wc",
      "jq",
      "node",
      "pnpm",
      "npm",
      "python3",
      "python"
    ],
    "allowedTools": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash"
    ]
  }
}
