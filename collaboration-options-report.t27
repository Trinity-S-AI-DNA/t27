// Collaboration option structure
pub const CollaborationOption : struct {
    id: u32,
    name: str,
    type: str,
    commitment: str,
    duration: str,
    resources: str,
    investment: str,
    benefits: [5]str,
    challenges: [3]str,
    roi_timeline: str,
    risk_level: str,
    ideal_for: [3]str,
    implementation_roadmap: [4]str
};

